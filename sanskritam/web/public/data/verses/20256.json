[{"id": 7000256000, "chapter_id": 20256, "verse_number": "१-१०-१", "content_sanskrit": "पुलस्त्य उवाच ।\nएकोद्दिष्टं ततो वक्ष्ये यदुक्तं ब्रह्मणा पुरा ।\nमृते पुत्रैर्यथाकार्यमाशौचं च पितुर्यदि ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000256001, "chapter_id": 20256, "verse_number": "१-१०-२", "content_sanskrit": "दशाहं शावमाशौचं ब्राह्मणस्य विधीयते ।\nक्षत्रियेषु दश द्वे च पक्षं वैश्येषु चैव हि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000256002, "chapter_id": 20256, "verse_number": "१-१०-३", "content_sanskrit": "शूद्रेषु मासमाशौचं सपिंडेषु विधीयते ।\nनैशमाचूडमाशौचं त्रिरात्रं परतः स्मृतम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000256003, "chapter_id": 20256, "verse_number": "१-१०-४", "content_sanskrit": "जननेप्येवमेव स्यात्सर्ववर्णेषु सर्वदा ।\nअस्थिसंचयनादूर्ध्वमङ्गस्पर्शो विधीयते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000256004, "chapter_id": 20256, "verse_number": "१-१०-५", "content_sanskrit": "प्रेताय पिंडदानं तु द्वादशाहं समाचरेत् ।\nपाथेयं तस्य तत्प्रोक्तं यतः प्रीतिकरं महत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000256005, "chapter_id": 20256, "verse_number": "१-१०-६", "content_sanskrit": "यस्मात्प्रेतपुरं प्रेतो द्वादशाहेन नीयते ।\nगृहे पुत्रकलत्रं च द्वादशाहं प्रपश्यति ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000256006, "chapter_id": 20256, "verse_number": "१-१०-७", "content_sanskrit": "तस्मान्निधेयमाकाशे दशरात्रं पयस्तथा ।\nसर्वदाहोपशांत्यर्थमध्वश्रमविनाशनम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000256007, "chapter_id": 20256, "verse_number": "१-१०-८", "content_sanskrit": "ततस्त्वेकादशाहेपि द्विजानेकादशैव तु ।\nगोत्रादिसूतकांते च भोजयेन्मनुजो द्विजान् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000256008, "chapter_id": 20256, "verse_number": "१-१०-९", "content_sanskrit": "द्वितीयेह्नि पुनस्तद्वदेकोद्दिष्टं समाचरेत् ।\nनावाहनाग्नौकरणं दैवहीनं विधानतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000256009, "chapter_id": 20256, "verse_number": "१-१०-१०", "content_sanskrit": "एकं पवित्रमेकोर्घ एकः पिंडो विधीयते ।\nउपतिष्ठतामिति वदेद्देयं पश्चात्तिलोदकं ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000256010, "chapter_id": 20256, "verse_number": "१-१०-११", "content_sanskrit": "स्वास्ति ब्रूयाद्विप्रकरे विसर्गे चाभिरम्यताम् ।\nशेषं पूर्ववदत्रापि कार्यं वेदविदो विदुः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000256011, "chapter_id": 20256, "verse_number": "१-१०-१२", "content_sanskrit": "अनेन विधिना सर्वमनुमासं समाचरेत् ।\nसूतकांते द्वितीयेह्नि शय्यां दद्याद्विलक्षणाम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000256012, "chapter_id": 20256, "verse_number": "१-१०-१३", "content_sanskrit": "कांचनं पुरुषं तद्वत्फलवस्त्रसमन्वितम् ।\nप्रपूज्य द्विजदांपत्यं नानाभरणभूषितम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000256013, "chapter_id": 20256, "verse_number": "१-१०-१४", "content_sanskrit": "उपवेश्य तु शय्यायां मधुपर्कं ततो ददेत् ।\nरजतस्य तु पात्रेण दधिदुग्धसमन्वितम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000256014, "chapter_id": 20256, "verse_number": "१-१०-१५", "content_sanskrit": "अस्थिलालाटिकं गृह्य सूक्ष्मं कृत्वा विमिश्रयेत् ।\nपाययेदिद्वजदांपत्यं पितृभक्त्या समन्वितः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000256015, "chapter_id": 20256, "verse_number": "१-१०-१६", "content_sanskrit": "एष एव विधिर्दृष्टः पार्वतीयैर्द्विजोतमैः ।\nतेन दुष्टा तु सा शय्या न ग्राह्या द्विजसत्तमैः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000256016, "chapter_id": 20256, "verse_number": "१-१०-१७", "content_sanskrit": "गृहीतायां तु तस्यां हि पुनः संस्कारमर्हति ।\nवेदे चैव पुराणे च शय्या सर्वत्र गर्हिता ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000256017, "chapter_id": 20256, "verse_number": "१-१०-१८", "content_sanskrit": "ग्रहीतारस्तु जायन्ते सर्वे नरकगामिनः ।\nग्रथितां वसुजालेन शय्यां दांपत्यसेविताम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000256018, "chapter_id": 20256, "verse_number": "१-१०-१९", "content_sanskrit": "ये स्पृशंति न जानंतः सर्वे नरकगामिनः ।\nनवश्राद्धेन भोक्तव्यं भुक्त्वा चांद्रायणं चरेत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000256019, "chapter_id": 20256, "verse_number": "१-१०-२०", "content_sanskrit": "पितृभक्त्या तु पुत्राणां कार्यमेव सदा भवेत् ।\nवृषोत्सर्गं च कुर्वीत देया च कपिला शुभा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000256020, "chapter_id": 20256, "verse_number": "१-१०-२१", "content_sanskrit": "उदकुंभश्च दातव्यो भक्ष्यभोज्यफलान्वितः ।\nयावदब्दं नरश्रेष्ठ सतिलोदकपूर्वकम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000256021, "chapter_id": 20256, "verse_number": "१-१०-२२", "content_sanskrit": "ततः संवत्सरे पूर्णे सपिंडीकरणं भवेत् ।\nसपिंडीकरणादूर्द्ध्वं प्रेतः पार्वणभुग्यतः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000256022, "chapter_id": 20256, "verse_number": "१-१०-२३", "content_sanskrit": "वृद्धिपूर्वेषु कार्येषु गृहस्थस्य भवेत्ततः ।\nसपिंडीकरणं श्राद्धं देवपूर्वं नियोजयेत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000256023, "chapter_id": 20256, "verse_number": "१-१०-२४", "content_sanskrit": "पितॄनावाहयेत्तत्र पृथक्प्रेतं विनिर्दिशेत् ।\nगंधोदकतिलैर्युक्तं कुर्यात्पात्रचतुष्टयम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000256024, "chapter_id": 20256, "verse_number": "१-१०-२५", "content_sanskrit": "अर्घ्यार्थं पितृपात्रेषु प्रेतपात्रं प्रसेचयेत् ।\nतद्वत्संकल्प्य चतुरः पिंडान्पितृपरस्तदा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000256025, "chapter_id": 20256, "verse_number": "१-१०-२६", "content_sanskrit": "ये समाना इति द्वाभ्यामन्नं तु विभजेत्त्रिधा ।\nअनेन विधिना चार्घ्यं पूर्वमेव प्रदापयेत् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000256026, "chapter_id": 20256, "verse_number": "१-१०-२७", "content_sanskrit": "ततः पितृत्वमापन्नस्स चतुर्थस्तदा त्वनु ।\nअग्निष्वात्तादि मध्ये तु प्राप्नोत्यमृतमुत्तमम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000256027, "chapter_id": 20256, "verse_number": "१-१०-२८", "content_sanskrit": "सपिण्डीकरणादूर्ध्वं पृथक्तस्मै न दीयते ।\nपितृष्वेव च दातव्यं तत्पिंडं येषु संस्थितम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000256028, "chapter_id": 20256, "verse_number": "१-१०-२९", "content_sanskrit": "ततः प्रभृति संक्रान्तावुपरागादि पर्वसु ।\nत्रिपिंडमाचरेच्छ्राद्धमेकोद्दिष्टं मृतेहनि ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000256029, "chapter_id": 20256, "verse_number": "१-१०-३०", "content_sanskrit": "एकोद्दिष्टं परित्यज्य मृताहे यः समाचरेत् ।\nस दैवं पितृहा स स्यात्तथा भ्रातृविनाशकः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000256030, "chapter_id": 20256, "verse_number": "१-१०-३१", "content_sanskrit": "मृताहे पार्वणं कुर्वन्नधो याति स मानवः ।\nसंपृक्ते स्वर्गती भावे प्रेतमोक्षो यतो भवेत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000256031, "chapter_id": 20256, "verse_number": "१-१०-३२", "content_sanskrit": "आमश्राद्धं तदा कुर्याद्विधिज्ञः श्राद्धदस्ततः ।\nतेनाग्नौकरणं कुर्यात्पिंडांस्तेनैव निर्वपेत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000256032, "chapter_id": 20256, "verse_number": "१-१०-३३", "content_sanskrit": "त्रिभिः सपिंडीकरणं मासैक्ये त्रितये तथा ।\nयदा प्राप्स्यति कालेन तदा मुच्येत बंधनात् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000256033, "chapter_id": 20256, "verse_number": "१-१०-३४", "content_sanskrit": "मुक्तोपि लेपभागित्वं प्राप्नोति कुशमार्जनात् ।\nलेपभाजश्चतुर्थाद्यास्त्रयः स्युः पिंडभागिनः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000256034, "chapter_id": 20256, "verse_number": "१-१०-३५", "content_sanskrit": "पिण्डदः सप्तमस्तेषां सपिंडाः सप्तपूरुषाः ।\nभीष्म उवाच ।\nकथं हव्यानि देयानि कव्यानि च जनैरिह ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000256035, "chapter_id": 20256, "verse_number": "१-१०-३६", "content_sanskrit": "गृह्णंति पितृलोके वा प्रायः के कैर्निगद्यते ।\nयदि मर्त्ये द्विजो भुंक्ते हूयते यदि वानले ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000256036, "chapter_id": 20256, "verse_number": "१-१०-३७", "content_sanskrit": "शुभाशुभात्मकाः प्रेतास्तदन्नं भुंजते कथम् ।\nपुलस्त्य उवाच ।\nवसुस्वरूपाः पितरो रुद्राश्चैव पितामहाः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000256037, "chapter_id": 20256, "verse_number": "१-१०-३८", "content_sanskrit": "प्रपितामहास्तथादित्या इत्येषा वैदिकी श्रुतिः ।\nनामगोत्रं पितॄणां तु प्रापकं हव्यकव्ययोः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000256038, "chapter_id": 20256, "verse_number": "१-१०-३९", "content_sanskrit": "श्राद्धस्य मन्त्रतस्तत्वमुपलभ्येत भक्तितः ।\nअग्निष्वात्तादयस्तेषामाधिपत्ये व्यवस्थिताः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000256039, "chapter_id": 20256, "verse_number": "१-१०-४०", "content_sanskrit": "नामगोत्रास्तदा देशा भवंत्युद्भवतामपि ।\nप्राणिनः प्रीणयत्येतदर्हणं समुपागतं ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000256040, "chapter_id": 20256, "verse_number": "१-१०-४१", "content_sanskrit": "दिव्यो यदि पिता माता गुरुः कर्मानुयोगतः ।\nतस्यान्नममृतं भूत्वा दिव्यत्त्वेप्यनुगच्छति ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000256041, "chapter_id": 20256, "verse_number": "१-१०-४२", "content_sanskrit": "दैत्यत्वे भोगरूपेण पशुत्वेपि तृणं भवेत् ।\nश्राद्धान्नं वायुरूपेण नागत्वेप्युपतिष्ठति ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000256042, "chapter_id": 20256, "verse_number": "१-१०-४३", "content_sanskrit": "पानं भवति यक्षत्वे राक्षसत्वे तथामिषं ।\nदानवत्वे तथा पानं प्रेतत्वे रुधिरोदकम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000256043, "chapter_id": 20256, "verse_number": "१-१०-४४", "content_sanskrit": "मनुष्यत्वेन्नपानादि नानाभोगवतां भवेत् ।\nरतिशक्तिस्त्रियः कान्तेऽन्येषां भोजनशक्तिता ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000256044, "chapter_id": 20256, "verse_number": "१-१०-४५", "content_sanskrit": "दानशक्तिः स विभवा रूपमारोग्यमेव च ।\nश्राद्धपुष्पमिदं प्रोक्तं फलं ब्रह्मसमागमः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000256045, "chapter_id": 20256, "verse_number": "१-१०-४६", "content_sanskrit": "आयुः पुत्रान्धनं विद्यां स्वर्गं मोक्षं सुखानि च ।\nप्रयच्छन्ति तथा राज्यं प्रीताः पितृगणा नृप ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000256046, "chapter_id": 20256, "verse_number": "१-१०-४७", "content_sanskrit": "श्रूयते च पुरा मोक्षं प्राप्ताः कौशिकसूनवः ।\nपंचभिर्जन्मसंबंधैः प्राप्ता ब्रह्मपरं पदम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000256047, "chapter_id": 20256, "verse_number": "१-१०-४८", "content_sanskrit": "भीष्म उवाच ।\nकथं कौशिकदायादाः प्राप्ता योगमनुत्तमम् ।\nपंचभिर्जन्मसंबन्धैः कथं कर्मक्षयो भवेत् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000256048, "chapter_id": 20256, "verse_number": "१-१०-४९", "content_sanskrit": "पुलस्त्य उवाच ।\nकौशिको नाम धर्मात्मा कुरुक्षेत्रे महानृषिः ।\nनामतः कर्मतस्तस्य पुत्राणां तन्निबोध मे ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000256049, "chapter_id": 20256, "verse_number": "१-१०-५०", "content_sanskrit": "स्वसृपः क्रोधनो हिंस्रः पिशुनः कविरेव च ।\nवाग्दुष्टः पितृवर्ती च गर्गशिष्यास्तदाभवन् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000256050, "chapter_id": 20256, "verse_number": "१-१०-५१", "content_sanskrit": "पितर्युपरते तेषामभूद्दुर्भिक्षमुल्बणं ।\nअनावृष्टिश्च महती सर्वलोकभयंकरी ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000256051, "chapter_id": 20256, "verse_number": "१-१०-५२", "content_sanskrit": "गर्गादेशाद्वने दोग्ध्रीं रक्षंति च तपोधनाः ।\nखादामः कपिलामेतां वयं क्षुत्पीडिता भृशं ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000256052, "chapter_id": 20256, "verse_number": "१-१०-५३", "content_sanskrit": "इति चिंतयतां पापं लघुः प्राह तदानुजः ।\nयद्यवश्यमियं वध्या श्राद्धरूपेण योज्यतां ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000256053, "chapter_id": 20256, "verse_number": "१-१०-५४", "content_sanskrit": "श्राद्धे नियोज्यमानायां पापं नश्यति नो ध्रुवं ।\nएवं कुर्वित्यनुज्ञातः पितृवर्ती तदानुजैः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000256054, "chapter_id": 20256, "verse_number": "१-१०-५५", "content_sanskrit": "चक्रे समाहितः श्राद्धमुपयुज्याथ तां पुनः ।\nद्वौ दैवे भ्रातरो कृत्वा पित्र्ये त्रींश्चापरान्क्रमात् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000256055, "chapter_id": 20256, "verse_number": "१-१०-५६", "content_sanskrit": "तथैकमतिथिं कृत्वा श्राद्धदः स्वयमेव तु ।\nचकार मंत्रवच्छ्राद्धं स्मरन्पितृपरायणः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000256056, "chapter_id": 20256, "verse_number": "१-१०-५७", "content_sanskrit": "तदा गत्वा विशंकास्ते गुरवे च न्यवेदयन् ।\nव्याघ्रेण निहता धेनुर्वत्सोयं प्रतिगृह्यतां ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000256057, "chapter_id": 20256, "verse_number": "१-१०-५८", "content_sanskrit": "एवं सा भक्षिता धेनुः सप्तभिस्तैस्तपोधनैः ।\nवैदिकं बलमाश्रित्य क्रूरे कर्मणि निर्भयाः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000256058, "chapter_id": 20256, "verse_number": "१-१०-५९", "content_sanskrit": "ततः काले प्रणष्टास्ते व्याधा दश पुरेभवन् ।\nजातिस्मरत्वं प्राप्तास्ते पितृभावेन भाविताः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000256059, "chapter_id": 20256, "verse_number": "१-१०-६०", "content_sanskrit": "तत्र विज्ञाय वैराग्यं प्राणानुत्सृज्य धर्मतः ।\nलोकैरवीक्ष्यमाणास्ते तीर्थांतेनशनेन तु ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000256060, "chapter_id": 20256, "verse_number": "१-१०-६१", "content_sanskrit": "संजाता मृगरूपास्ते सप्त कालंजरे गिरौ ।\nप्राप्तविज्ञानयोगास्ते तत्यजुस्तां निजां तनुम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000256061, "chapter_id": 20256, "verse_number": "१-१०-६२", "content_sanskrit": "मम्रुः प्रपतनेनाथ जातवैराग्यमानसाः ।\nमानसे चक्रव्राकास्ते संजाताः सप्तयोगिनः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000256062, "chapter_id": 20256, "verse_number": "१-१०-६३", "content_sanskrit": "नामतः कर्मतः सर्वे सुमनाः कुसुमोवसुः ।\nचित्तदर्शी सुदर्शी च ज्ञाता ज्ञानस्य पारगः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000256063, "chapter_id": 20256, "verse_number": "१-१०-६४", "content_sanskrit": "ज्येष्ठानुरक्ताः श्रेष्ठास्ते सप्तैते योगपावनाः ।\nयोगभ्रष्टास्त्रयस्तेषां बभूवुश्चलचेतसः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000256064, "chapter_id": 20256, "verse_number": "१-१०-६५", "content_sanskrit": "दृष्ट्वा विभ्राजमानं तमणुहं स्त्रीभिरन्वितम् ।\nक्रीडंतं विविधैर्भोगैर्महाबलपराक्रमम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000256065, "chapter_id": 20256, "verse_number": "१-१०-६६", "content_sanskrit": "पञ्चालान्वयसंभूतं प्रभूतबलवाहनम् ।\nराज्यकामोभवत्त्वेकस्तेषां मध्ये जलौकसाम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000256066, "chapter_id": 20256, "verse_number": "१-१०-६७", "content_sanskrit": "पितृवर्ती च यो विप्रः श्राद्धकृत्पितृवत्सलः ।\nअपरौ मंत्रिणौ दृष्ट्वा प्रभूतबलवाहनौ ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000256067, "chapter_id": 20256, "verse_number": "१-१०-६८", "content_sanskrit": "मंत्रित्वे चक्रतुश्चेच्छामस्मिन्मर्त्यौ द्विजोत्तमौ ।\nविभ्राजपुत्रस्त्वेकोभूद्ब्रह्मदत्त इति स्मृतः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000256068, "chapter_id": 20256, "verse_number": "१-१०-६९", "content_sanskrit": "मंत्रिपुत्रौ तथा चैव पुंडरीकसुबालकौ ।\nब्रह्मदत्तोभिषिक्तस्तु कांपिल्ये नगरोत्तमे ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000256069, "chapter_id": 20256, "verse_number": "१-१०-७०", "content_sanskrit": "पंचालराजो विक्रांतः श्राद्धकृत्पितृवत्सलः ।\nयोगवित्सर्वजंतूनां चित्तवेत्ताभवत्तदा ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000256070, "chapter_id": 20256, "verse_number": "१-१०-७१", "content_sanskrit": "तस्य राज्ञोभवद्भार्या सुदेवस्यात्मजा तदा ।\nसन्नतिर्नाम विख्याता कपिलायाभवत्पुरा ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000256071, "chapter_id": 20256, "verse_number": "१-१०-७२", "content_sanskrit": "पितृकार्ये नियुक्तत्वादभवद्ब्रह्मवादिनी ।\nतया चकार सहितः स राज्यं राजनंदनः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000256072, "chapter_id": 20256, "verse_number": "१-१०-७३", "content_sanskrit": "कदाचिद्गतौद्यानं तया सह स पार्थिवः ।\nददर्श कीटमिथुनमनंगकलहान्वितम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000256073, "chapter_id": 20256, "verse_number": "१-१०-७४", "content_sanskrit": "पिपीलिकामधोवक्त्रां पुरतः कीटकामुकः ।\nपंचबाणाभितप्तांगः सगद्गदमुवाच ह ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000256074, "chapter_id": 20256, "verse_number": "१-१०-७५", "content_sanskrit": "न त्वया सदृशी लोके कामिनी विद्यते क्वचित् ।\nमध्ये क्षीणातिजघना बृहद्वक्त्रातिगामिनी ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000256075, "chapter_id": 20256, "verse_number": "१-१०-७६", "content_sanskrit": "सुवर्णवर्णसदृशी सद्वक्त्रा चारुहासिनी ।\nआलक्ष्यते च वदनं गुडशर्करवत्सलं ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000256076, "chapter_id": 20256, "verse_number": "१-१०-७७", "content_sanskrit": "भोक्ष्यसे मयि भुक्ते त्वं स्नासि स्नाते तथा मयि ।\nप्रोषिते मयि दीना त्वं क्रुद्धे च भयचंचला ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000256077, "chapter_id": 20256, "verse_number": "१-१०-७८", "content_sanskrit": "किमर्थं वद कल्याणि सदाधोवदनास्थिता ।\nसा तमाह ज्वलत्कोपा किमालपसि रे शठ ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000256078, "chapter_id": 20256, "verse_number": "१-१०-७९", "content_sanskrit": "त्वया मोदकचूर्णं तु मां विहायापि भक्षितम् ।\nप्रादास्त्वं तदतिक्रम्य मामन्यस्यै समन्मथः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000256079, "chapter_id": 20256, "verse_number": "१-१०-८०", "content_sanskrit": "पिपीलक उवाच ।\nत्वत्सादृश्यान्मया दत्तमन्यस्यै वरवर्णिनि ।\nतदेकमपराधं मे क्षंतुमर्हसि भामिनि ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000256080, "chapter_id": 20256, "verse_number": "१-१०-८१", "content_sanskrit": "नैवं पुनः करिष्यामि त्यज कोपं च सुस्तनि ।\nस्पृशामि पादौ सत्येन प्रणतस्य प्रसीद मे ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000256081, "chapter_id": 20256, "verse_number": "१-१०-८२", "content_sanskrit": "रुष्टायां त्वयि सुश्रोणि मृत्युर्मे पुरतो भवेत् ।\nतुष्टायां त्वयि वामोरु पूर्णाः सर्वमनोरथाः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000256082, "chapter_id": 20256, "verse_number": "१-१०-८३", "content_sanskrit": "पूर्णचंद्रोपमं वक्त्रं स्वादेमृतरसोपमम् ।\nनिर्भरं पिब सुश्रोणि कामासक्तस्य मे सदा ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000256083, "chapter_id": 20256, "verse_number": "१-१०-८४", "content_sanskrit": "एतन्मत्वा शुभे कार्या सर्वदा तु कृपा मयि ।\nइति सा वचनं श्रुत्वा प्रसन्ना चाभवत्ततः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000256084, "chapter_id": 20256, "verse_number": "१-१०-८५", "content_sanskrit": "आत्मानमर्पयामास मोहनाय पिपीलिका ।\nब्रह्मदत्तोपि तत्सर्वं ज्ञात्वा सस्मयमाहसत् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000256085, "chapter_id": 20256, "verse_number": "१-१०-८६", "content_sanskrit": "सर्वसत्वरुतज्ञानी प्रभावात्पूर्वकर्मणः ।\nभीष्म उवाच ।\nकथं सर्वरुतज्ञोभूद्ब्रह्मदत्तो नराधिपः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000256086, "chapter_id": 20256, "verse_number": "१-१०-८७", "content_sanskrit": "तच्चापि चाभवत्कुत्र चक्रवाकचतुष्टयं ।\nतन्मे कथय सर्वज्ञ कुले कस्य च सुव्रतम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000256087, "chapter_id": 20256, "verse_number": "१-१०-८८", "content_sanskrit": "पुलस्त्य उवाच ।\nतस्मिन्नेव पुरे जाताश्चक्रवाका अथो नृप ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000256088, "chapter_id": 20256, "verse_number": "१-१०-८९", "content_sanskrit": "वृद्धद्विजस्य दायादा विप्रा जातिस्मरा बुधाः ।\nधृतिमांस्तत्त्वदर्शी च विद्यावर्णस्तपोधिकः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000256089, "chapter_id": 20256, "verse_number": "१-१०-९०", "content_sanskrit": "नामतः कर्मतश्चैव सुदरिद्रस्य ते सुताः ।\nतपसे बुद्धिरभवत्तेषां वै द्विजजन्मनां ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000256090, "chapter_id": 20256, "verse_number": "१-१०-९१", "content_sanskrit": "यास्यामः परमां सिद्धिमूचुस्ते द्विजसत्तमाः ।\nतत्तेषां वचनं श्रुत्वा सुदरिद्रो महातपाः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000256091, "chapter_id": 20256, "verse_number": "१-१०-९२", "content_sanskrit": "उवाच दीनया वाचा किमेतदिति पुत्रकाः ।\nअधर्म एष वः पुत्रा पिता तानित्युवाच ह ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000256092, "chapter_id": 20256, "verse_number": "१-१०-९३", "content_sanskrit": "वृद्धं पितरमुत्सृज्य दरिद्रं वनवासिनम् ।\nक्व नु धर्मोत्र भविता मां त्यक्त्वा गतिमेव च ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000256093, "chapter_id": 20256, "verse_number": "१-१०-९४", "content_sanskrit": "ऊचुस्ते कल्पिता वृत्तिस्तव तात वचश्शृणु ।\nव्रतमेतत्पुरा राज्ञः स ते दास्यति पुष्कलं ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000256094, "chapter_id": 20256, "verse_number": "१-१०-९५", "content_sanskrit": "धनं ग्राम सहस्राणि प्रभाते पठतस्तव ।\nकुरुक्षेत्रे तु ये विप्रा व्याधा दशपुरे तु ये ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000256095, "chapter_id": 20256, "verse_number": "१-१०-९६", "content_sanskrit": "कालंजरे मृगा भूताश्चक्रवाकास्तु मानसे ।\nइत्युक्त्वा पितरं जग्मुस्ते वनं तपसे पुनः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000256096, "chapter_id": 20256, "verse_number": "१-१०-९७", "content_sanskrit": "वृद्धोपि स द्विजो राजन्जगाम स्वार्थसिद्धये ।\nअणुहो नाम वैभ्राजः पञ्चालाधिपतिः पुरा ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000256097, "chapter_id": 20256, "verse_number": "१-१०-९८", "content_sanskrit": "पुत्रार्थी देवदेवेशं पद्मयोनिं पितामहम् ।\nआराधयामास विभुं तीव्रव्रतपरायणः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000256098, "chapter_id": 20256, "verse_number": "१-१०-९९", "content_sanskrit": "ततः कालेन महता तुष्टस्तस्य पितामहः ।\nवरं वरय भद्रं ते हृदयेभीप्सितं नृप ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000256099, "chapter_id": 20256, "verse_number": "१-१०-१००", "content_sanskrit": "अणुह उवाच ।\nपुत्रं मे देहि देवेश महाबलपराक्रमम् ।\nपारगं सर्वविद्यानां धार्मिकं योगिनां वरम् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000256100, "chapter_id": 20256, "verse_number": "१-१०-१०१", "content_sanskrit": "सर्वसत्वरुतज्ञं मे देहि योगिनमात्मजम् ।\nएवमस्त्विति विश्वात्मा तमाह परमेश्वरः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000256101, "chapter_id": 20256, "verse_number": "१-१०-१०२", "content_sanskrit": "पश्यतां सर्वभूतानां तत्रैवांतरधीयत ।\nततः स तस्य पुत्रोभूद्ब्रह्मदत्तः प्रतापवान् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000256102, "chapter_id": 20256, "verse_number": "१-१०-१०३", "content_sanskrit": "सर्वसत्वानुकंपी च सर्वसत्वबलाधिकः ।\nसर्वसत्वरुतज्ञश्च सर्वसत्वेश्वरेश्वरः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000256103, "chapter_id": 20256, "verse_number": "१-१०-१०४", "content_sanskrit": "अथ सत्वेन योगात्मा स पिपीलकमागतः ।\nयत्र तत्कीटमिथुनं रममाणमवस्थितम् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000256104, "chapter_id": 20256, "verse_number": "१-१०-१०५", "content_sanskrit": "ततः सा सन्नतिर्दृष्ट्वा प्रहसंतं सुविस्मितं ।\nकिमप्याशंकमाना सा तमपृच्छन्नरेश्वरम् ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000256105, "chapter_id": 20256, "verse_number": "१-१०-१०६", "content_sanskrit": "सन्नतिरुवाच ।\nअकस्मादतिहासोयं किमर्थमभवन्नृप ।\nहास्यहेतुं न जानामि यदकाले कृतं त्वया ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000256106, "chapter_id": 20256, "verse_number": "१-१०-१०७", "content_sanskrit": "अवदद्राजपुत्रोसौ तं पिपीलिकभाषितम् ।\nरागवद्विरसोत्पन्नमेतद्धास्यं वरानने ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7000256107, "chapter_id": 20256, "verse_number": "१-१०-१०८", "content_sanskrit": "न चान्यत्कारणं किंचिद्धास्यहेतुः शुचिस्मिते ।\nन सामन्यततं देवी प्राहालीकमिदं तव ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7000256108, "chapter_id": 20256, "verse_number": "१-१०-१०९", "content_sanskrit": "अहमेवेह हसिता न जीविष्ये त्वयाधुना ।\nकथं पिपीलिकालापं मर्त्यो वेत्ति सुरादृते ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7000256109, "chapter_id": 20256, "verse_number": "१-१०-११०", "content_sanskrit": "तस्मात्त्वयाहमेवाद्य हसिता किमतः परम् ।\nततो निरुत्तरो राजा जिज्ञासुस्तद्वचो हरेः ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7000256110, "chapter_id": 20256, "verse_number": "१-१०-१११", "content_sanskrit": "आस्थाय नियमं तस्थौ सप्तरात्रमकल्मषः ।\nस्वप्नान्ते प्राह तं ब्रह्मा प्रभाते पर्यटन्पुरम् ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7000256111, "chapter_id": 20256, "verse_number": "१-१०-११२", "content_sanskrit": "वृद्धद्विजोत्तमाद्वाक्यं सर्वं ज्ञास्यति ते प्रिया ।\nइत्युक्त्वांतर्दधे ब्रह्मा प्रभाते च नृपः पुरात् ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7000256112, "chapter_id": 20256, "verse_number": "१-१०-११३", "content_sanskrit": "निर्गच्छन्मन्त्रिसहितः सभार्यो वृद्धमग्रतः ।\nगदंतं विप्रमायांतं वृद्धं च स ददर्श ह ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7000256113, "chapter_id": 20256, "verse_number": "१-१०-११४", "content_sanskrit": "ब्राह्मण उवाच ।\nये विप्रमुख्याः कुरुजांगलेषु दाशास्तथा दाशपुरे मृगाश्च ।\nकालंजरे सप्त च चक्रवाका ये मानसे तेत्र वसंति सिद्धाः ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7000256114, "chapter_id": 20256, "verse_number": "१-१०-११५", "content_sanskrit": "इत्याकर्ण्य वचस्तस्य स पपात शुचान्वितः ।\nजातिस्मरत्वमगमत्तौ च मंत्रिवरात्मजौ ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7000256115, "chapter_id": 20256, "verse_number": "१-१०-११६", "content_sanskrit": "कामशास्त्रप्रणेता तु बाभ्रव्यः स तु बालकः ।\nपंचाल इति लोकेषु विश्रुतः सर्वशास्त्रवित् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7000256116, "chapter_id": 20256, "verse_number": "१-१०-११७", "content_sanskrit": "पुंडरीकोपि धर्मात्मा वेदशास्त्रप्रवर्तकः ।\nभूत्वा जातिस्मरौ शोकात्पतितावग्रतस्तथा ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7000256117, "chapter_id": 20256, "verse_number": "१-१०-११८", "content_sanskrit": "हा वयं कर्मविभ्रष्टाः कामतः कर्मबंधनात् ।\nएवं विलप्य बहुशस्त्रयस्ते योगपारगाः ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7000256118, "chapter_id": 20256, "verse_number": "१-१०-११९", "content_sanskrit": "विस्मयाच्छ्राद्धमाहाम्यमभिनंद्य पुनः पुनः ।\nस तु तस्मै धनं दत्त्वा प्रभूतग्रामसंयुतम् ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7000256119, "chapter_id": 20256, "verse_number": "१-१०-१२०", "content_sanskrit": "विसृज्य ब्राह्मणं तं च वृद्धं धनमदान्वितम् ।\nआत्मीयं नृपतिः पुत्रं नृपलक्षणसंयुतम् ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7000256120, "chapter_id": 20256, "verse_number": "१-१०-१२१", "content_sanskrit": "विष्वक्सेनाभिधानं च राजाराज्येभ्यषेचयत् ।\nमानसे सलिले सर्वे ततस्ते योगिनां वराः ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7000256121, "chapter_id": 20256, "verse_number": "१-१०-१२२", "content_sanskrit": "ब्रह्मदत्तादयस्तस्मिन्पितृभक्ता विमत्सराः ।\nसन्नतिश्चाभवद्धृष्टा मयैव तव दर्शितम् ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7000256122, "chapter_id": 20256, "verse_number": "१-१०-१२३", "content_sanskrit": "राजन्योगफलं सर्वं यदेतदभिलक्ष्यते ।\nतथेति प्राह राजापि पुरस्तादभिनंदयन् ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7000256123, "chapter_id": 20256, "verse_number": "१-१०-१२४", "content_sanskrit": "त्वत्प्रसादादिदं सर्वं मयैवं प्राप्यते फलम् ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7000256124, "chapter_id": 20256, "verse_number": "१-१०-१२५", "content_sanskrit": "ततस्ते योगमास्थाय सर्व एव वनौकसः ।\nब्रह्मरंध्रेण परमं पदमापुस्तपोबलात् ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7000256125, "chapter_id": 20256, "verse_number": "१-१०-१२६", "content_sanskrit": "एवमायुर्धनं विद्यां स्वर्गमोक्षसुखानि च ।\nप्रयच्छंति सुतं राज्यं नृणां तुष्टाः पितामहाः ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7000256126, "chapter_id": 20256, "verse_number": "१-१०-१२७", "content_sanskrit": "इदं च पितृमाहात्म्यं ब्रह्मदत्तस्य वै नृप ।\nद्विजेभ्यः श्रावयेद्विद्वान्शृणोति पठतेपि वा ।\nकल्पकोटिशतं साग्रं ब्रह्मलोके महीयते ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}]