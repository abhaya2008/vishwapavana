[{"id": 2190037, "chapter_id": 5043, "verse_number": "", "content_sanskrit": "स्थाणुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2190038, "chapter_id": 5043, "verse_number": "१", "content_sanskrit": "प्रजासर्गनिमित्तं मे कार्यवत्तामिमां प्रभो ।\nविद्धि सृष्टास्त्वया हीमा मा क्रुध्यासां पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2190039, "chapter_id": 5043, "verse_number": "२", "content_sanskrit": "तव तेजोग्निना देव प्रजा दह्यन्ति सर्वशः ।\nता दृष्ट्वा मम कारुण्यं मा क्रुध्यासां जगत्प्रभो\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2190040, "chapter_id": 5043, "verse_number": "", "content_sanskrit": "प्रजापतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2190041, "chapter_id": 5043, "verse_number": "३", "content_sanskrit": "न कुप्ये न च मे कामो न भवेरन् प्रजा इति ।\nलाघवार्थं धरण्यास्तु ततः संहार इष्यते\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2190042, "chapter_id": 5043, "verse_number": "४", "content_sanskrit": "इयं हि मां सदा देवी भारार्ता समचोदयत् ।\nसंहारार्थं महादेव भारेणाप्सु निमज्जति\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2190043, "chapter_id": 5043, "verse_number": "५", "content_sanskrit": "यदाहं नाधिगच्छामि बुद्ध्या बहु विचारयन् ।\nसंहारमासां वृद्धानां ततो मां क्रोध आविशत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2190044, "chapter_id": 5043, "verse_number": "", "content_sanskrit": "स्थाणुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2190045, "chapter_id": 5043, "verse_number": "६", "content_sanskrit": "संहारान्तं प्रसीदस्व मा क्रुधस्त्रिदशेश्वर ।\nमा प्रजाः स्थावरं वैच जङ्गमं च विनीनशः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2190046, "chapter_id": 5043, "verse_number": "७", "content_sanskrit": "पल्वलानि च सर्वाणि सर्वं चैव तृणोलपम् ।\nस्थावरं जङ्गमं चैव भूतग्रामं चतुर्विधम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2190047, "chapter_id": 5043, "verse_number": "८", "content_sanskrit": "तदेतद् भस्मसाद्भूतं जगत् सर्वमुपप्लुतम् ।\nप्रसीद भगवन् साधो वर एष वृतो मया\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2190048, "chapter_id": 5043, "verse_number": "९", "content_sanskrit": "नष्टा न पुनरेष्यन्ति प्रजा ह्येताः कथञ्चन ।\nतस्मान्निवर्त्यतामेतत्तेजः स्वेनैव तेजसा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2190049, "chapter_id": 5043, "verse_number": "१०", "content_sanskrit": "उपायमन्यं सम्पश्य प्रजानां हितकाम्यया ।\nयथेमे जन्तवः सर्वे निवर्तेरन् परन्तप\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2190050, "chapter_id": 5043, "verse_number": "११", "content_sanskrit": "अभावमभिगच्छेयुरुत्सन्नप्रजनाः प्रजाः ।\nअधिदैवनियुक्तोऽस्मि त्वया लोकेष्विहेश्वर\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2190051, "chapter_id": 5043, "verse_number": "१२", "content_sanskrit": "त्वद्भवं हि जगन्नाथ जगत् स्थावरजङ्गमम् ।\nप्रसाद्य त्वां महादेव याचाम्यावृत्तिजाः प्रजाः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2190052, "chapter_id": 5043, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2190053, "chapter_id": 5043, "verse_number": "१३", "content_sanskrit": "श्रुत्वा तु वचनं देवः स्थाणोर्नियतवाङ्मनाः ।\nतेजस्तत्स्वं निजग्राह पुनरेवान्तरात्मना\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2190054, "chapter_id": 5043, "verse_number": "१४", "content_sanskrit": "ततोऽग्निमुपसङ्गृह्य भगवाँल्लोकपूजितः ।\nप्रवृत्तिं च निवृत्तिं च कल्पयामास वै प्रभुः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2190055, "chapter_id": 5043, "verse_number": "१५", "content_sanskrit": "उपसंहरतस्तस्य तमग्निं रोषजं तदा ।\nप्रादुर्बभूव विश्वेभ्यः खेभ्यो नारी महात्मनः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2190056, "chapter_id": 5043, "verse_number": "१६", "content_sanskrit": "कृष्णा रक्ताम्बरधरा रक्तनेत्रतलान्तरा ।\nदिव्यकुण्डलसम्पन्ना दिव्याभरणभूषिता\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2190057, "chapter_id": 5043, "verse_number": "१७", "content_sanskrit": "सा विनिःसृत्य वै खेभ्यो दक्षिणामाश्रिता दिशम् ।\nददृशातेऽथ तौ कन्यां देवौ विश्वेश्वरावुभौ\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2190058, "chapter_id": 5043, "verse_number": "१८", "content_sanskrit": "तामाहूय तदा देवो लोकानामादिरीश्वरः ।\nमृत्यो इति महीपाल जहि चेमाः प्रजा इति\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2190059, "chapter_id": 5043, "verse_number": "१९", "content_sanskrit": "त्वं हि संहारबुद्ध्या मे चिन्तिता रुषितेन च ।\nतस्मात् संहर सर्वास्त्वं प्रजाः सजडपण्डिताः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2190060, "chapter_id": 5043, "verse_number": "२०", "content_sanskrit": "अविशेषेण चैव त्वं प्रजाः संहर भामिनि ।\nमम त्वं हि नियोगेन श्रेयः परमवाप्स्यसि\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2190061, "chapter_id": 5043, "verse_number": "२१", "content_sanskrit": "एवमुक्ता तु सा देवी मृत्युः कमलमालिनी ।\nप्रदध्यौ दुःखिता बाला साश्रुपातमतीव हि\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2190062, "chapter_id": 5043, "verse_number": "२२", "content_sanskrit": "पाणिभ्यां चैव जग्राह तान्यश्रूणि जनेश्वरः ।\nमानवानां हितार्थाय ययाचे पुनरेव च\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2190063, "chapter_id": 5043, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे द्विनवतितमोऽध्यायः ॥९२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]