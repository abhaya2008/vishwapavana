[{"id": 2022095, "chapter_id": 1460, "verse_number": "३-९८-०x", "content_sanskrit": "[लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2022096, "chapter_id": 1460, "verse_number": "३-९८-१", "content_sanskrit": "युधिष्ठिर निबोधेदं त्रिषु लोकेषु विश्रुतम्।\nभृगोस्तीर्थं महाराज महर्षिगणसेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2022097, "chapter_id": 1460, "verse_number": "३-९८-२", "content_sanskrit": "यत्रोपस्पृष्टवान्रामो हृतंतेजस्तदाप्तवान्।\nअत्र त्वंभ्रातृभिः सार्धं कृष्णया चैव पाण्डव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2022098, "chapter_id": 1460, "verse_number": "३-९८-३", "content_sanskrit": "दुर्योधनहृतंतेजः पुनरादातुमर्हसि।\nकृतवैरेण रामेण यथा कचोपहृतं पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2022099, "chapter_id": 1460, "verse_number": "३-९८-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2022100, "chapter_id": 1460, "verse_number": "३-९८-४", "content_sanskrit": "स तत्रभ्रातृभिश्चैव कृष्णया चैव पाण्डवः।\nस्नात्वा देवान्पितॄंश्चैव तर्पयामास भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2022101, "chapter_id": 1460, "verse_number": "३-९८-५", "content_sanskrit": "तस्य तीर्थस्य रूपं वै दीप्ताद्दीप्ततरं बभौ।\nअप्रवृष्यतरश्चासीच्छात्रवाणां नरर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2022102, "chapter_id": 1460, "verse_number": "३-९८-६", "content_sanskrit": "अपृच्छच्चैव राजेन्द्र लोमशं पाण्डुनन्दनः।\nभगवन्किमर्थं रामस्य हृतमासीद्वपुः प्रभो।\nकथं प्रत्याहृतंचैव एतदाचक्ष्व पृच्छतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2022103, "chapter_id": 1460, "verse_number": "३-९८-७x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2022104, "chapter_id": 1460, "verse_number": "३-९८-७", "content_sanskrit": "शृणु रामस्य राजेन्द्र भार्गवस्य च धीमतः।\nजातो दशरथस्यासीत्पुत्रो रामो महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2022105, "chapter_id": 1460, "verse_number": "३-९८-८", "content_sanskrit": "विष्णुः स्वेन शरीरेण रावणस्य वधाय वै।\nपश्यामस्तमयोध्यायां जातं दाशरथिं ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2022106, "chapter_id": 1460, "verse_number": "३-९८-९", "content_sanskrit": "ऋचीकनन्दनो राभो भार्गवो रेणुकासुतः।\nतस् दाशरथेः श्रुत्वा ररामस्याक्लिष्टकर्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2022107, "chapter_id": 1460, "verse_number": "३-९८-१०", "content_sanskrit": "कौतूहलान्वितो रामस्त्वयोध्यामगमत्पुनः।\nजिज्ञासमानो रामस्य वीर्यं दाशरथेस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2022108, "chapter_id": 1460, "verse_number": "३-९८-११", "content_sanskrit": "तं वै दशरथः श्रुत्वा वियान्तमुपागतम्।\nप्रेषयामास रामस्य रामं पुत्रं पुरस्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2022109, "chapter_id": 1460, "verse_number": "३-९८-१२", "content_sanskrit": "स तमभ्यागतं दृष्ट्वा उद्यतास्त्रमवस्थितम्।\nप्रहसन्निव कोन्तेय रामो वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2022110, "chapter_id": 1460, "verse_number": "३-९८-१३", "content_sanskrit": "कृतकालं हि राजेन्द्र धनुरेतन्मया विभो।\nसमारोपय यत्नेन यदि शक्नोषि पार्तिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2022111, "chapter_id": 1460, "verse_number": "३-९८-१४", "content_sanskrit": "इत्युक्तस्त्वाह भगवंस्त्वं नाधिक्षेप्तुमर्हसि।\nनाहमप्यधमो धर्मे क्षत्रियाणां द्विजातिषु।\nइश्र्वाकूणां विशेषेण बाहुवीर्ये न कत्थनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2022112, "chapter_id": 1460, "verse_number": "३-९८-१५", "content_sanskrit": "तमेवं वादिनं तत्र रामो वचनमब्रवीत्।\nअलं वै व्यपदेशेन धनुरायच्छ राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2022113, "chapter_id": 1460, "verse_number": "३-९८-१६", "content_sanskrit": "ततो जग्राह रोषेण क्षत्रियर्षभमूदनम्।\nरामो दाशरथिर्दिव्यं हस्ताद्रामस्य कार्मुकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2022114, "chapter_id": 1460, "verse_number": "३-९८-१७", "content_sanskrit": "धनुरारोपयामास सलील इव भारत।\nज्याशब्दमकरोच्चैव स्मयमानः स वीर्यवान्।\nतस्य शब्दस् भूतानि वित्रसन्त्यशनेरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2022115, "chapter_id": 1460, "verse_number": "३-९८-१८", "content_sanskrit": "अथाब्रवीत्तदा रामो रामं दाशरथिस्तदा।\nइदमारोपितं ब्र्हमन्किमन्यत्करवाणि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2022116, "chapter_id": 1460, "verse_number": "३-९८-१९", "content_sanskrit": "तस्य रामो ददौ दिव्यं जामदग्न्यो महात्मनः।\nशरमाकर्णदेशान्तमयमाकृष्यतामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2022117, "chapter_id": 1460, "verse_number": "३-९८-२०x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2022118, "chapter_id": 1460, "verse_number": "३-९८-२०", "content_sanskrit": "एतच्छ्रुत्वाऽब्रवीद्रामः प्रदीप्त इव मन्युना।\nश्रूयते क्षम्यते चैव दर्पपूर्णोसि भार्गव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2022119, "chapter_id": 1460, "verse_number": "३-९८-२१", "content_sanskrit": "त्वया ह्यधिगतं तेजः क्षत्रियेभ्यो विशेषतः।\nपितामहप्रसादेन तेन मां क्षिपसि ध्रुवम्।\nपश्य मां स्वेन रूपेण चक्षुस्ते वितराम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2022120, "chapter_id": 1460, "verse_number": "३-९८-२२", "content_sanskrit": "ततो रामशरीरे वै रामः पश्यति भार्गवः।\nआदित्यान्सवसून्रुद्रान्साध्यांश्च समरुद्गणान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2022121, "chapter_id": 1460, "verse_number": "३-९८-२३", "content_sanskrit": "पितरो हुताशनश्चैव नक्षत्राणि ग्रहास्तथा।\nगन्धर्वा राक्षसा यक्षा नद्यस्तीर्थानि यानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2022122, "chapter_id": 1460, "verse_number": "३-९८-२४", "content_sanskrit": "ऋषयो वालखिल्याश्च ब्र्हमभूताः सनातनाः।\nदेवर्षयश्च कार्त्स्न्येन समुद्राः पर्वतास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2022123, "chapter_id": 1460, "verse_number": "३-९८-२५", "content_sanskrit": "वेदाश्च सोपनिषदो वषट्कारैः सहाध्वरैः।\nचेतोमन्ति च सामानि धनुर्वेदश्च भारत।\nमेघवृन्दानि वर्षाणि विद्युतश्च युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2022124, "chapter_id": 1460, "verse_number": "३-९८-२६", "content_sanskrit": "ततः स भगवान्विष्णुस्तं वै बाणं मुमोच ह।\nशुष्काशनिसमाकीर्णं महोल्काभिश्च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2022125, "chapter_id": 1460, "verse_number": "३-९८-२७", "content_sanskrit": "पांसुवर्षेण महता मेघवर्षैश्च भूतलम्।\nभूमिकम्पैश्च निर्घातैर्नादैश्च विपुलैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2022126, "chapter_id": 1460, "verse_number": "३-९८-२८", "content_sanskrit": "स रामं विह्वलं कृत्वा तेजश्चाक्षिप्य केवलम्।\nआगच्छज्ज्वलितो बाणो रामबाहुप्रचोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2022127, "chapter_id": 1460, "verse_number": "३-९८-२९", "content_sanskrit": "स तु विह्वलतां गत्वा प्रतिलभ्य च चेतनाम्।\nरामः प्रत्यागतप्राणः प्राणमद्विष्णुतेजसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2022128, "chapter_id": 1460, "verse_number": "३-९८-३०", "content_sanskrit": "विष्णुना सोभ्यनुज्ञातो महेन्द्रमगमत्पुनः।\nभीतस्तु तत्रन्यवसद्ब्रीडितस्तु महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2022129, "chapter_id": 1460, "verse_number": "३-९८-३१", "content_sanskrit": "ततः संवत्सरेऽतीते हृतौजसमवस्थितम्।\nनिर्मदं दुःखितं दृष्ट्वा पितरो राममब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2022130, "chapter_id": 1460, "verse_number": "३-९८-३२", "content_sanskrit": "न वै सम्यगिदं पुत्र विष्णुमासाद्य वैकृतम्।\nस हि पूज्यश्च मान्यश्च त्रिषु लोकेषु सर्वदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2022131, "chapter_id": 1460, "verse_number": "३-९८-३३", "content_sanskrit": "गच्छ पुत्रनदीं पुण्यां वधूसरकृताह्वयाम्।\nतत्रोपस्पृश्य तीर्थेषु पुनर्वपुरवाप्स्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2022132, "chapter_id": 1460, "verse_number": "३-९८-३४", "content_sanskrit": "दीप्तोदं नाम तत्तीर्थं यत्रते प्रतितामहः।\nभृगुर्देवयुगे राम तप्तवानुत्तमं तपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2022133, "chapter_id": 1460, "verse_number": "३-९८-३५", "content_sanskrit": "तत्तथा कृतवान्रामः कौन्तेय वचनात्पितुः।\nप्राप्तवांश्च पुनस्तेजस्तीर्थेऽस्मिन्पाण्डुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2022134, "chapter_id": 1460, "verse_number": "३-९८-३६", "content_sanskrit": "एतदीदृशकं तात रामेणाक्लिष्टकर्मणा।\nप्राप्तमासीन्महाराज विष्णुमासाद्य वै पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2022135, "chapter_id": 1460, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि अष्टनवतितमोऽध्यायः ॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]