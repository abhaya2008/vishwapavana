[{"id": 2026452, "chapter_id": 1566, "verse_number": "३-२०४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2026453, "chapter_id": 1566, "verse_number": "३-२०४-१", "content_sanskrit": "[श्रुत्वा तु राजा राजर्षेरिन्द्रद्युम्नस्य तत्तथा।\nमार्कण्डेयान्महाभागात्स्वर्गस्य प्रतिपादनम् ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2026454, "chapter_id": 1566, "verse_number": "३-२०४-२", "content_sanskrit": "युधिष्ठिरो महाराज पप्रच्छ भरतर्षभ।\nमार्कण्डेयं तपोवृद्धं दीर्घायुषमकल्मषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2026455, "chapter_id": 1566, "verse_number": "३-२०४-३", "content_sanskrit": "विदितास्तव धर्मज्ञ देवदानवरक्षसाम्।\nराजवंशाश्च विविधा ऋषिवंशाश्च शाश्वताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2026456, "chapter_id": 1566, "verse_number": "३-२०४-४", "content_sanskrit": "न तेऽस्त्यविदितं किंचिदस्मिँल्लोके द्विजोत्तम।\nअथ वेत्सि मुने वंशान्मनुष्योरगरक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2026457, "chapter_id": 1566, "verse_number": "३-२०४-५", "content_sanskrit": "देवगन्धर्वयक्षाणां किन्नराप्सरसां तथा।\nइदमिच्छाम्यहं श्रोतुं तत्त्वे द्विजसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2026458, "chapter_id": 1566, "verse_number": "३-२०४-६", "content_sanskrit": "कुवलाश्व इति ख्यात इक्ष्वाकुकुलसंभवः।\nकथं नाम विपर्यासाद्धुन्धुमारत्वमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2026459, "chapter_id": 1566, "verse_number": "३-२०४-७", "content_sanskrit": "एतदिच्छामि तत्त्वेन ज्ञातुं भार्गवसत्तम।\nविपर्यस्तं यथा नाम कुवलाश्वस् धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2026460, "chapter_id": 1566, "verse_number": "३-२०४-८x", "content_sanskrit": "[वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2026461, "chapter_id": 1566, "verse_number": "३-२०४-८", "content_sanskrit": "युधिष्ठिरेणैवमुक्तो मार्कण्डेयो महामुनिः।\nधौन्धुमारमुपाख्यानं कथयामास भारत ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2026462, "chapter_id": 1566, "verse_number": "३-२०४-९x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2026463, "chapter_id": 1566, "verse_number": "३-२०४-९", "content_sanskrit": "हन्त ते कथयिष्यामि शृणु राजन्युधिष्ठिर।\nधर्मिष्ठमिदमाख्यानं धुन्धुमारस्य तच्छृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2026464, "chapter_id": 1566, "verse_number": "३-२०४-१०", "content_sanskrit": "यथा स राजा ऐक्ष्वाकः कुवलाश्वो महीपतिः।\nधुन्धुमारत्वमगमत्तच्छृणुष्व महीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2026465, "chapter_id": 1566, "verse_number": "३-२०४-११", "content_sanskrit": "महर्षिर्विश्रुतस्तात उदङ्क इति भारत।\nमरुधन्वसु रम्येषु आश्रमस्तस्य कौरव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2026466, "chapter_id": 1566, "verse_number": "३-२०४-१२", "content_sanskrit": "उदङ्कस्तु महाराज तपोतप्यत्सुदुश्चरम्।\nआरिराधयिषुर्विष्णुं बहून्वर्षगणान्विभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2026467, "chapter_id": 1566, "verse_number": "३-२०४-१३", "content_sanskrit": "तस्य प्रीतः स भगवान्साक्षाद्दर्शनमेयिवान्।\nदृष्ट्वा महर्षिस्तद्ब्रह्म तुष्टाव विविधैः स्तवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2026468, "chapter_id": 1566, "verse_number": "३-२०४-१४x", "content_sanskrit": "उदङ्क उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2026469, "chapter_id": 1566, "verse_number": "३-२०४-१४", "content_sanskrit": "त्वया देव प्रजाः सर्वाः ससुरासुरमानवाः।\nस्थावराणि च भूतानि जङ्गमानि तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2026470, "chapter_id": 1566, "verse_number": "३-२०४-१५", "content_sanskrit": "ब्रह्म वेदाश्च वेद्यं च त्वया सृष्टं महाद्युते।\nशिरस्ते गगनं देव नेत्रे शशिदिवाकरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2026471, "chapter_id": 1566, "verse_number": "३-२०४-१६", "content_sanskrit": "निःश्वासः पवनश्चापि तेजोऽग्निश्च तवाच्युत।\nबाहवस्ते दिशः सर्वाः कुक्षिश्चापि महार्णवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2026472, "chapter_id": 1566, "verse_number": "३-२०४-१७", "content_sanskrit": "ऊरू ते पर्वता देव स्वं नाभिर्मधुसूदन।\nपादौ ते पृथिवी चैव रोमाण्योषधयस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2026473, "chapter_id": 1566, "verse_number": "३-२०४-१८", "content_sanskrit": "इन्द्रसोमाग्निवरुणा देवासुरमहोरगाः।\nप्रह्वास्त्वामुपतिष्ठन्ति स्तुवन्तो विविधैः स्तवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2026474, "chapter_id": 1566, "verse_number": "३-२०४-१९", "content_sanskrit": "त्वया व्याप्तानि सर्वाणि भूतानि भुवनेश्वर।\nयोगिनः सुमहावीर्याः स्तुवन्ति त्वां महर्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2026475, "chapter_id": 1566, "verse_number": "३-२०४-२०", "content_sanskrit": "त्वयि तुष्टे जगच्छान्तं त्वयि क्रुद्धे महद्भयम्।\nभयानामपनेतासि त्वमेकः पुरुषोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2026476, "chapter_id": 1566, "verse_number": "३-२०४-२१", "content_sanskrit": "देवानां मानुषाणां च सर्वभूतसुखावहः।\nत्रिभिर्विक्रमणैर्देव त्रयो लोकास्त्वया वृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2026477, "chapter_id": 1566, "verse_number": "३-२०४-२२", "content_sanskrit": "असुराणां समृद्धानां विनाशश्च त्वया कृतः।\nतव विक्रमणैर्देवा निर्वाणमगमन्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2026478, "chapter_id": 1566, "verse_number": "३-२०४-२३", "content_sanskrit": "पराभवं च दैत्येन्द्रास्त्वयि क्रुद्धे महाद्युते।\nत्वं हि कर्ता विकर्ता च भूतानामिह सर्वशः।\nआराधयित्वा त्वां देवाः सुखमेधन्ति नित्यशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2026479, "chapter_id": 1566, "verse_number": "३-२०४-२४", "content_sanskrit": "एवं स्तुतो हृषीकेश उदङ्केन महात्मना।\nउदङ्कमब्रवीद्विष्णुः प्रीतस्तेऽहं वरं वृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2026480, "chapter_id": 1566, "verse_number": "३-२०४-२५x", "content_sanskrit": "उदङ्क उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2026481, "chapter_id": 1566, "verse_number": "३-२०४-२५", "content_sanskrit": "पर्याप्तो मे वरो ह्येष यदहं दृष्टवान्हरिम्।\nपुरुषं शाश्वतं दिव्यं स्रष्टारं जगतः प्रभुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2026482, "chapter_id": 1566, "verse_number": "३-२०४-२६x", "content_sanskrit": "विष्णुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2026483, "chapter_id": 1566, "verse_number": "३-२०४-२६", "content_sanskrit": "प्रीतस्तेऽहमलौल्येन भक्त्या तव च सत्तम।\nअवश्यं हि त्वया ब्रह्मन्मत्तो ग्राह्यो वरो द्विज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2026484, "chapter_id": 1566, "verse_number": "३-२०४-२७", "content_sanskrit": "एवं स च्छन्द्यमानस्तु वरेण हरिणा तदा।\nउदङ्कः प्राञ्जलिर्वव्रे वरं भरतसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2026485, "chapter_id": 1566, "verse_number": "३-२०४-२८", "content_sanskrit": "यदि मे भगवन्प्रीतः पुण्डरीकनिभेक्षण।\nधर्मे सत्ये दमे चैव बुद्धिर्भवतु मे सदा।\nअभ्यासश्च भवेद्भक्त्या त्वयि नित्यं ममेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2026486, "chapter_id": 1566, "verse_number": "३-२०४-२९x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2026487, "chapter_id": 1566, "verse_number": "३-२०४-२९", "content_sanskrit": "सर्वमेतद्धि भविता मत्प्रसादात्तव द्विज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2026488, "chapter_id": 1566, "verse_number": "३-२०४-३०", "content_sanskrit": "प्रतिभास्यति योगश्च येन युक्तो दिवौकसाम्।\nत्रयाणामपि लोकानां महत्कार्यं करिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2026489, "chapter_id": 1566, "verse_number": "३-२०४-३१", "content_sanskrit": "उत्सादनार्थं लोकानां धुन्धुर्नाम महासुरः।\nतपस्यति तपो घोरं शृणु यस्तं हनिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2026490, "chapter_id": 1566, "verse_number": "३-२०४-३२", "content_sanskrit": "[राजा हि वीर्यवांस्तात इक्ष्वाकुरपराजितः]\nबृहदश्व इति ख्यातो भविष्यति महीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2026491, "chapter_id": 1566, "verse_number": "३-२०४-३३", "content_sanskrit": "तस्य पुत्रः शुचिर्दान्तः कुवलाश्व इति श्रतः।\nस योगबलामास्थाय मामकं पार्तिवोत्तमः।\nशासनात्तव विप्रर्षे धुन्धुमारो भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2026492, "chapter_id": 1566, "verse_number": "३-२०४-३४", "content_sanskrit": "उदङ्कमेवमुक्त्वा तु विष्णुरन्तरधीयत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2026493, "chapter_id": 1566, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि चतुरधिकद्विशततमोऽध्यायः ॥ २०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]