[{"id": 40014737, "chapter_id": 9207, "verse_number": "1", "content_sanskrit": "राघवेणाभयेदत्तेसन्नतोरावणानुजः । विभीषणोमहाप्राज्ञोभूमिंसमवलोकयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40014738, "chapter_id": 9207, "verse_number": "2", "content_sanskrit": "खात्पपातावनींहृष्टोभक्तेरनुचरैस्सह । सतरामस्यपरमात्मानिपपातविभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40014739, "chapter_id": 9207, "verse_number": "3", "content_sanskrit": "पादयोश्शरणान्वेषीचतुर्भिस्सहराक्षसैः । अब्रवीच्चतदावाक्यंरामंप्रतिविभीषणः ॥ धर्मयुक्तंचयुक्तंचसाम्प्रतंसम्प्रहर्षणम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40014740, "chapter_id": 9207, "verse_number": "4", "content_sanskrit": "अनुजोरावणस्याहंतेनचाप्यवमानितः । भवन्तंसर्वभूतानांशरण्यंशरणागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40014741, "chapter_id": 9207, "verse_number": "5", "content_sanskrit": "परित्यक्तामयालङ्कमित्राणिचधनानिच । भवद्गतंहिमेराज्यंजीवितंचसुखानिच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40014742, "chapter_id": 9207, "verse_number": "6", "content_sanskrit": "तथ्यतद्वचनंश्रुत्वारामोवचनमब्रवीत् ॥ वचसासान्त्वयित्वैनंलोचनाभ्यांपिबन्निव । आख्याहिममतत्त्वेनराक्षसानांबलाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40014743, "chapter_id": 9207, "verse_number": "7", "content_sanskrit": "तथ्यतद्वचनंश्रुत्वारामोवचनमब्रवीत् ॥ वचसासान्त्वयित्वैनंलोचनाभ्यांपिबन्निव । आख्याहिममतत्त्वेनराक्षसानांबलाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "