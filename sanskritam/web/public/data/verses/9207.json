[{"id": 5000207000, "chapter_id": 9207, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे एकादशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000207001, "chapter_id": 9207, "verse_number": "३-११-१", "content_sanskrit": "अग्रतः प्रययौ रामः सीता मध्ये सुशोभना।\nपृष्ठतस्तु धनुष्पाणिर्लक्ष्मणोऽनुजगाम ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000207002, "chapter_id": 9207, "verse_number": "३-११-२", "content_sanskrit": "तौ पश्यमानौ विविधान् शैलप्रस्थान् वनानि च।\nनदीश्च विविधा रम्या जग्मतुः सह सीतया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000207003, "chapter_id": 9207, "verse_number": "३-११-३", "content_sanskrit": "सारसांश्चक्रवाकांश्च नदीपुलिनचारिणः।\nसरांसि च सपद्मानि युतानि जलजैः खगैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000207004, "chapter_id": 9207, "verse_number": "३-११-४", "content_sanskrit": "यूथबद्धांश्च पृषतान् मदोन्मत्तान् विषाणिनः।\nमहिषांश्च वराहांश्च गजांश्च द्रुमवैरिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000207005, "chapter_id": 9207, "verse_number": "३-११-५", "content_sanskrit": "ते गत्वा दूरमध्वानं लम्बमाने दिवाकरे।\nददृशुः सहिता रम्यं तटाकं योजनायुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000207006, "chapter_id": 9207, "verse_number": "३-११-६", "content_sanskrit": "पद्मपुष्करसम्बाधं गजयूथैरलंकृतम्।\nसारसैर्हंसकादम्बैः संकुलं जलजातिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000207007, "chapter_id": 9207, "verse_number": "३-११-७", "content_sanskrit": "प्रसन्नसलिले रम्ये तस्मिन् सरसि शुश्रुवे।\nगीतवादित्रनिर्घोषो न तु कश्चन दृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000207008, "chapter_id": 9207, "verse_number": "३-११-८", "content_sanskrit": "ततः कौतूहलाद् रामो लक्ष्मणश्च महारथः।\nमुनिं धर्मभृतं नाम प्रष्टुं समुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000207009, "chapter_id": 9207, "verse_number": "३-११-९", "content_sanskrit": "इदमत्यद्भुतं श्रुत्वा सर्वेषां नो महामुने।\nकौतूहलं महज्जातं किमिदं साधु कथ्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000207010, "chapter_id": 9207, "verse_number": "३-११-१०", "content_sanskrit": "तेनैवमुक्तो धर्मात्मा राघवेण मुनिस्तदा।\nप्रभावं सरसः क्षिप्रमाख्यातुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000207011, "chapter_id": 9207, "verse_number": "३-११-११", "content_sanskrit": "इदं पञ्चाप्सरो नाम तटाकं सार्वकालिकम्।\nनिर्मितं तपसा राम मुनिना माण्डकर्णिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000207012, "chapter_id": 9207, "verse_number": "३-११-१२", "content_sanskrit": "स हि तेपे तपस्तीव्रं माण्डकर्णिर्महामुनिः।\nदशवर्षसहस्राणि वायुभक्षो जलाशये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000207013, "chapter_id": 9207, "verse_number": "३-११-१३", "content_sanskrit": "ततः प्रव्यथिताः सर्वे देवाः साग्निपुरोगमाः।\nअब्रुवन् वचनं सर्वे परस्परसमागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000207014, "chapter_id": 9207, "verse_number": "३-११-१४", "content_sanskrit": "अस्माकं कस्यचित् स्थानमेष प्रार्थयते मुनिः।\nइति संविग्नमनसः सर्वे तत्र दिवौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000207015, "chapter_id": 9207, "verse_number": "३-११-१५", "content_sanskrit": "ततः कर्तुं तपोविघ्नं सर्वदेवैर्नियोजिताः।\nप्रधानाप्सरसः पञ्च विद्युच्चलितवर्चसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000207016, "chapter_id": 9207, "verse_number": "३-११-१६", "content_sanskrit": "अप्सरोभिस्ततस्ताभिर्मुनिर्दृष्टपरावरः।\nनीतो मदनवश्यत्वं देवानां कार्यसिद्धये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000207017, "chapter_id": 9207, "verse_number": "३-११-१७", "content_sanskrit": "ताश्चैवाप्सरसः पञ्च मुनेः पत्नीत्वमागताः।\nतटाके निर्मितं तासां तस्मिन्नन्तर्हितं गृहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000207018, "chapter_id": 9207, "verse_number": "३-११-१८", "content_sanskrit": "तत्रैवाप्सरसः पञ्च निवसन्त्यो यथासुखम्।\nरमयन्ति तपोयोगान्मुनिं यौवनमास्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000207019, "chapter_id": 9207, "verse_number": "३-११-१९", "content_sanskrit": "तासां संक्रीडमानानामेष वादित्रनिःस्वनः।\nश्रूयते भूषणोन्मिश्रो गीतशब्दो मनोहरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000207020, "chapter_id": 9207, "verse_number": "३-११-२०", "content_sanskrit": "आश्चर्यमिति तस्यैतद् वचनं भावितात्मनः।\nराघवः प्रतिजग्राह सह भ्रात्रा महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000207021, "chapter_id": 9207, "verse_number": "३-११-२१", "content_sanskrit": "एवं कथयमानः स ददर्शाश्रममण्डलम्।\nकुशचीरपरिक्षिप्तं ब्राह्म्या लक्ष्म्या समावृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000207022, "chapter_id": 9207, "verse_number": "३-११-२२", "content_sanskrit": "प्रविश्य सह वैदेह्या लक्ष्मणेन च राघवः।\nतदा तस्मिन् स काकुत्स्थः श्रीमत्याश्रममण्डले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000207023, "chapter_id": 9207, "verse_number": "३-११-२३", "content_sanskrit": "उषित्वा स सुखं तत्र पूज्यमानो महर्षिभिः।\nजगाम चाश्रमांस्तेषां पर्यायेण तपस्विनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000207024, "chapter_id": 9207, "verse_number": "३-११-२४", "content_sanskrit": "येषामुषितवान् पूर्वं सकाशे स महास्त्रवित् ।\nक्वचित् परिदशान् मासानेकसंवत्सरं क्वचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000207025, "chapter_id": 9207, "verse_number": "३-११-२५", "content_sanskrit": "क्वचिच्च चतुरो मासान् पञ्च षट् च परान् क्वचित्।\nअपरत्राधिकान् मासानध्यर्धमधिकं क्वचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000207026, "chapter_id": 9207, "verse_number": "३-११-२६", "content_sanskrit": "त्रीन् मासानष्टमासांश्च राघवो न्यवसत् सुखम्।\nतत्र संवसतस्तस्य मुनीनामाश्रमेषु वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000207027, "chapter_id": 9207, "verse_number": "३-११-२७", "content_sanskrit": "रमतश्चानुकूल्येन ययुः संवत्सरा दश।\nपरिसृत्य च धर्मज्ञो राघवः सह सीतया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000207028, "chapter_id": 9207, "verse_number": "३-११-२८", "content_sanskrit": "सुतीक्ष्णस्याश्रमपदं पुनरेवाजगाम ह।\nस तमाश्रममागम्य मुनिभिः परिपूजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000207029, "chapter_id": 9207, "verse_number": "३-११-२९", "content_sanskrit": "तत्रापि न्यवसद् रामः किंचित् कालमरिंदमः।\nअथाश्रमस्थो विनयात् कदाचित् तं महामुनिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000207030, "chapter_id": 9207, "verse_number": "३-११-३०", "content_sanskrit": "उपासीनः स काकुत्स्थः सुतीक्ष्णमिदमब्रवीत्।\nअस्मिन्नरण्ये भगवन्नगस्त्यो मुनिसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000207031, "chapter_id": 9207, "verse_number": "३-११-३१", "content_sanskrit": "वसतीति मया नित्यं कथाः कथयतां श्रुतम्।\nन तु जानामि तं देशं वनस्यास्य महत्तया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000207032, "chapter_id": 9207, "verse_number": "३-११-३२", "content_sanskrit": "कुत्राश्रमपदं रम्यं महर्षेस्तस्य धीमतः।\nप्रसादार्थं भगवतः सानुजः सह सीतया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000207033, "chapter_id": 9207, "verse_number": "३-११-३३", "content_sanskrit": "अगस्त्यमधिगच्छेयमभिवादयितुं मुनिम्।\nमनोरथो महानेष हृदि सम्परिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000207034, "chapter_id": 9207, "verse_number": "३-११-३४", "content_sanskrit": "यदहं तं मुनिवरं शुश्रूषेयमपि स्वयम्।\nइति रामस्य स मुनिः श्रुत्वा धर्मात्मनो वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000207035, "chapter_id": 9207, "verse_number": "३-११-३५", "content_sanskrit": "सुतीक्ष्णः प्रत्युवाचेदं प्रीतो दशरथात्मजम्।\nअहमप्येतदेव त्वां वक्तुकामः सलक्ष्मणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000207036, "chapter_id": 9207, "verse_number": "३-११-३६", "content_sanskrit": "अगस्त्यमभिगच्छेति सीतया सह राघव।\nदिष्ट्या त्विदानीमर्थेऽस्मिन् स्वयमेव ब्रवीषि माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000207037, "chapter_id": 9207, "verse_number": "३-११-३७", "content_sanskrit": "अयमाख्यामि ते राम यत्रागस्त्यो महामुनिः।\nयोजनान्याश्रमात् तात याहि चत्वारि वै ततः।\nदक्षिणेन महान् श्रीमानगस्त्यभ्रातुराश्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000207038, "chapter_id": 9207, "verse_number": "३-११-३८", "content_sanskrit": "स्थलीप्रायवनोद्देशे पिप्पलीवनशोभिते।\nबहुपुष्पफले रम्ये नानाविहगनादिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000207039, "chapter_id": 9207, "verse_number": "३-११-३९", "content_sanskrit": "पद्मिन्यो विविधास्तत्र प्रसन्नसलिलाशयाः।\nहंसकारण्डवाकीर्णाश्चक्रवाकोपशोभिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000207040, "chapter_id": 9207, "verse_number": "३-११-४०", "content_sanskrit": "तत्रैकां रजनीं व्युष्य प्रभाते राम गम्यताम्।\nदक्षिणां दिशमास्थाय वनखण्डस्य पार्श्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000207041, "chapter_id": 9207, "verse_number": "३-११-४१", "content_sanskrit": "तत्रागस्त्याश्रमपदं गत्वा योजनमन्तरम्।\nरमणीये वनोद्देशे बहुपादपशोभिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000207042, "chapter_id": 9207, "verse_number": "३-११-४२", "content_sanskrit": "रंस्यते तत्र वैदेही लक्ष्मणश्च त्वया सह।\nस हि रम्यो वनोद्देशो बहुपादपसंयुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000207043, "chapter_id": 9207, "verse_number": "३-११-४३", "content_sanskrit": "यदि बुद्धिः कृता द्रष्टुमगस्त्यं तं महामुनिम्।\nअद्यैव गमने बुद्धिं रोचयस्व महामते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000207044, "chapter_id": 9207, "verse_number": "३-११-४४", "content_sanskrit": "इति रामो मुनेः श्रुत्वा सह भ्रात्राभिवाद्य च।\nप्रतस्थेऽगस्त्यमुद्दिश्य सानुगः सह सीतया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000207045, "chapter_id": 9207, "verse_number": "३-११-४५", "content_sanskrit": "पश्यन् वनानि चित्राणि पर्वतांश्चाभ्रसंनिभान्।\nसरांसि सरितश्चैव पथि मार्गवशानुगान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000207046, "chapter_id": 9207, "verse_number": "३-११-४६", "content_sanskrit": "सुतीक्ष्णेनोपदिष्टेन गत्वा तेन पथा सुखम्।\nइदं परमसंहृष्टो वाक्यं लक्ष्मणमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000207047, "chapter_id": 9207, "verse_number": "३-११-४७", "content_sanskrit": "एतदेवाश्रमपदं नूनं तस्य महात्मनः।\nअगस्त्यस्य मुनेर्भ्रातुर्दृश्यते पुण्यकर्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000207048, "chapter_id": 9207, "verse_number": "३-११-४८", "content_sanskrit": "यथा हीमे वनस्यास्य ज्ञाताः पथि सहस्रशः।\nसंनताः फलभारेण पुष्पभारेण च द्रुमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000207049, "chapter_id": 9207, "verse_number": "३-११-४९", "content_sanskrit": "पिप्पलीनां च पक्वानां वनादस्मादुपागतः।\nगन्धोऽयं पवनोत्क्षिप्तः सहसा कटुकोदयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000207050, "chapter_id": 9207, "verse_number": "३-११-५०", "content_sanskrit": "तत्र तत्र च दृश्यन्ते संक्षिप्ताः काष्ठसंचयाः।\nलूनाश्च परिदृश्यन्ते दर्भा वैदूर्यवर्चसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000207051, "chapter_id": 9207, "verse_number": "३-११-५१", "content_sanskrit": "एतच्च वनमध्यस्थं कृष्णाभ्रशिखरोपमम्।\nपावकस्याश्रमस्थस्य धूमाग्रं सम्प्रदृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000207052, "chapter_id": 9207, "verse_number": "३-११-५२", "content_sanskrit": "विविक्तेषु च तीर्थेषु कृतस्नाना द्विजातयः।\nपुष्पोपहारं कुर्वन्ति कुसुमैः स्वयमर्जितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000207053, "chapter_id": 9207, "verse_number": "३-११-५३", "content_sanskrit": "ततः सुतीक्ष्णवचनं यथा सौम्य मया श्रुतम्।\nअगस्त्यस्याश्रमो भ्रातुर्नूनमेष भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000207054, "chapter_id": 9207, "verse_number": "३-११-५४", "content_sanskrit": "निगृह्य तरसा मृत्युं लोकानां हितकाम्यया।\nयस्य भ्रात्रा कृतेयं दिक्शरण्या पुण्यकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000207055, "chapter_id": 9207, "verse_number": "३-११-५५", "content_sanskrit": "इहैकदा किल क्रूरो वातापिरपि चेल्वलः।\nभ्रातरौ सहितावास्तां ब्राह्मणघ्नौ महासुरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000207056, "chapter_id": 9207, "verse_number": "३-११-५६", "content_sanskrit": "धारयन् ब्राह्मणं रूपमिल्वलः संस्कृतं वदन्।\nआमन्त्रयति विप्रान् स श्राद्धमुद्दिश्य निर्घृणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000207057, "chapter_id": 9207, "verse_number": "३-११-५७", "content_sanskrit": "भ्रातरं संस्कृतं कृत्वा ततस्तं मेषरूपिणम्।\nतान् द्विजान् भोजयामास श्राद्धदृष्टेन कर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000207058, "chapter_id": 9207, "verse_number": "३-११-५८", "content_sanskrit": "ततो भुक्तवतां तेषां विप्राणामिल्वलोऽब्रवीत्।\nवातापे निष्क्रमस्वेति स्वरेण महता वदन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000207059, "chapter_id": 9207, "verse_number": "३-११-५९", "content_sanskrit": "ततो भ्रातुर्वचः श्रुत्वा वातापिर्मेषवन्नदन्।\nभित्त्वा भित्त्वा शरीराणि ब्राह्मणानां विनिष्पतत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000207060, "chapter_id": 9207, "verse_number": "३-११-६०", "content_sanskrit": "ब्राह्मणानां सहस्राणि तैरेवं कामरूपिभिः।\nविनाशितानि संहत्य नित्यशः पिशिताशनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000207061, "chapter_id": 9207, "verse_number": "३-११-६१", "content_sanskrit": "अगस्त्येन तदा देवैः प्रार्थितेन महर्षिणा।\nअनुभूय किल श्राद्धे भक्षितः स महासुरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000207062, "chapter_id": 9207, "verse_number": "३-११-६२", "content_sanskrit": "ततः सम्पन्नमित्युक्त्वा दत्त्वा हस्तेऽवनेजनम्।\nभ्रातरं निष्क्रमस्वेति चेल्वलः समभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000207063, "chapter_id": 9207, "verse_number": "३-११-६३", "content_sanskrit": "स तदा भाषमाणं तु भ्रातरं विप्रघातिनम्।\nअब्रवीत् प्रहसन् धीमानगस्त्यो मुनिसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000207064, "chapter_id": 9207, "verse_number": "३-११-६४", "content_sanskrit": "कुतो निष्क्रमितुं शक्तिर्मया जीर्णस्य रक्षसः।\nभ्रातुस्तु मेषरूपस्य गतस्य यमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000207065, "chapter_id": 9207, "verse_number": "३-११-६५", "content_sanskrit": "अथ तस्य वचः श्रुत्वा भ्रातुर्निधनसंश्रितम्।\nप्रधर्षयितुमारेभे मुनिं क्रोधान्निशाचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000207066, "chapter_id": 9207, "verse_number": "३-११-६६", "content_sanskrit": "सोऽभ्यद्रवद् द्विजेन्द्रं तं मुनिना दीप्ततेजसा।\nचक्षुषानलकल्पेन निर्दग्धो निधनं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000207067, "chapter_id": 9207, "verse_number": "३-११-६७", "content_sanskrit": "तस्यायमाश्रमो भ्रातुस्तटाकवनशोभितः।\nविप्रानुकम्पया येन कर्मेदं दुष्करं कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 5000207068, "chapter_id": 9207, "verse_number": "३-११-६८", "content_sanskrit": "एवं कथयमानस्य तस्य सौमित्रिणा सह।\nरामस्यास्तं गतः सूर्यः संध्याकालोऽभ्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 5000207069, "chapter_id": 9207, "verse_number": "३-११-६९", "content_sanskrit": "उपास्य पश्चिमां संध्यां सह भ्रात्रा यथाविधि।\nप्रविवेशाश्रमपदं तमृषिं चाभ्यवादयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 5000207070, "chapter_id": 9207, "verse_number": "३-११-७०", "content_sanskrit": "सम्यक्प्रतिगृहीतस्तु मुनिना तेन राघवः।\nन्यवसत् तां निशामेकां प्राश्य मूलफलानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 5000207071, "chapter_id": 9207, "verse_number": "३-११-७१", "content_sanskrit": "तस्यां रात्र्यां व्यतीतायामुदिते रविमण्डले।\nभ्रातरं तमगस्त्यस्य आमन्त्रयत राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 5000207072, "chapter_id": 9207, "verse_number": "३-११-७२", "content_sanskrit": "अभिवादये त्वां भगवन् सुखमस्म्युषितो निशाम्।\nआमन्त्रये त्वां गच्छामि गुरुं ते द्रष्टुमग्रजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 5000207073, "chapter_id": 9207, "verse_number": "३-११-७३", "content_sanskrit": "गम्यतामिति तेनोक्तो जगाम रघुनन्दनः।\nयथोद्दिष्टेन मार्गेण वनं तच्चावलोकयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 5000207074, "chapter_id": 9207, "verse_number": "३-११-७४", "content_sanskrit": "नीवारान् पनसान् सालान् वञ्जुलांस्तिनिशांस्तथा।\nचिरिबिल्वान् मधूकांश्च बिल्वानथ च तिन्दुकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 5000207075, "chapter_id": 9207, "verse_number": "३-११-७५", "content_sanskrit": "पुष्पितान् पुष्पिताग्राभिर्लताभिरुपशोभितान्।\nददर्श रामः शतशस्तत्र कान्तारपादपान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 5000207076, "chapter_id": 9207, "verse_number": "३-११-७६", "content_sanskrit": "हस्तिहस्तैर्विमृदितान् वानरैरुपशोभितान्।\nमत्तैः शकुनिसङ्घैश्च शतशः प्रतिनादितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 5000207077, "chapter_id": 9207, "verse_number": "३-११-७७", "content_sanskrit": "ततोऽब्रवीत् समीपस्थं रामो राजीवलोचनः।\nपृष्ठतोऽनुगतं वीरं लक्ष्मणं लक्ष्मिवर्धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 5000207078, "chapter_id": 9207, "verse_number": "३-११-७८", "content_sanskrit": "स्निग्धपत्रा यथा वृक्षा यथा क्षान्ता मृगद्विजाः।\nआश्रमो नातिदूरस्थो महर्षेर्भावितात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 5000207079, "chapter_id": 9207, "verse_number": "३-११-७९", "content_sanskrit": "अगस्त्य इति विख्यातो लोके स्वेनैव कर्मणा।\nआश्रमो दृश्यते तस्य परिश्रान्तश्रमापहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 5000207080, "chapter_id": 9207, "verse_number": "३-११-८०", "content_sanskrit": "प्राज्यधूमाकुलवनश्चीरमालापरिष्कृतः।\nप्रशान्तमृगयूथश्च नानाशकुनिनादितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 5000207081, "chapter_id": 9207, "verse_number": "३-११-८१", "content_sanskrit": "निगृह्य तरसा मृत्युं लोकानां हितकाम्यया।\nदक्षिणा दिक् कृता येन शरण्या पुण्यकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 5000207082, "chapter_id": 9207, "verse_number": "३-११-८२", "content_sanskrit": "तस्येदमाश्रमपदं प्रभावाद् यस्य राक्षसैः।\nदिगियं दक्षिणा त्रासाद् दृश्यते नोपभुज्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 5000207083, "chapter_id": 9207, "verse_number": "३-११-८३", "content_sanskrit": "यदाप्रभृति चाक्रान्ता दिगियं पुण्यकर्मणा।\nतदाप्रभृति निर्वैराः प्रशान्ता रजनीचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 5000207084, "chapter_id": 9207, "verse_number": "३-११-८४", "content_sanskrit": "नाम्ना चेयं भगवतो दक्षिणा दिक्प्रदक्षिणा।\nप्रथिता त्रिषु लोकेषु दुर्धर्षा क्रूरकर्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 5000207085, "chapter_id": 9207, "verse_number": "३-११-८५", "content_sanskrit": "मार्गं निरोद्धुं सततं भास्करस्याचलोत्तमः।\nसंदेशं पालयंस्तस्य विन्ध्यशैलो न वर्धते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 5000207086, "chapter_id": 9207, "verse_number": "३-११-८६", "content_sanskrit": "अयं दीर्घायुषस्तस्य लोके विश्रुतकर्मणः।\nअगस्त्यस्याश्रमः श्रीमान् विनीतमृगसेवितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 5000207087, "chapter_id": 9207, "verse_number": "३-११-८७", "content_sanskrit": "एष लोकार्चितः साधुर्हिते नित्यं रतः सताम्।\nअस्मानधिगतानेष श्रेयसा योजयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 5000207088, "chapter_id": 9207, "verse_number": "३-११-८८", "content_sanskrit": "आराधयिष्याम्यत्राहमगस्त्यं तं महामुनिम्।\nशेषं च वनवासस्य सौम्य वत्स्याम्यहं प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 5000207089, "chapter_id": 9207, "verse_number": "३-११-८९", "content_sanskrit": "अत्र देवाः सगन्धर्वाः सिद्धाश्च परमर्षयः।\nअगस्त्यं नियताहाराः सततं पर्युपासते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 5000207090, "chapter_id": 9207, "verse_number": "३-११-९०", "content_sanskrit": "नात्र जीवेन्मृषावादी क्रूरो वा यदि वा शठः।\nनृशंसः पापवृत्तो वा मुनिरेष तथाविधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 5000207091, "chapter_id": 9207, "verse_number": "३-११-९१", "content_sanskrit": "अत्र देवाश्च यक्षाश्च नागाश्च पतगैः सह।\nवसन्ति नियताहारा धर्ममाराधयिष्णवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 5000207092, "chapter_id": 9207, "verse_number": "३-११-९२", "content_sanskrit": "अत्र सिद्धा महात्मानो विमानैः सूर्यसंनिभैः।\nत्यक्त्वा देहान् नवैर्देहैः स्वर्याताः परमर्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 5000207093, "chapter_id": 9207, "verse_number": "३-११-९३", "content_sanskrit": "यक्षत्वममरत्वं च राज्यानि विविधानि च।\nअत्र देवाः प्रयच्छन्ति भूतैराराधिताः शुभैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 5000207094, "chapter_id": 9207, "verse_number": "३-११-९४", "content_sanskrit": "आगताः स्माश्रमपदं सौमित्रे प्रविशाग्रतः।\nनिवेदयेह मां प्राप्तमृषये सह सीतया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 5000207095, "chapter_id": 9207, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्येअरण्यकाण्डे एकादशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}]