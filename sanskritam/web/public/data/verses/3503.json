[{"id": 2116290, "chapter_id": 3503, "verse_number": "", "content_sanskrit": "ब्राह्मणी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2116291, "chapter_id": 3503, "verse_number": "१", "content_sanskrit": "नाहं मुष्णामि वस्ताता दृष्टिं नास्मि रुषाऽन्विता ।\nअयं तु भार्गवो नाम ऊरुजः कुपितो ध्रुवम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2116292, "chapter_id": 3503, "verse_number": "२", "content_sanskrit": "तेन चक्षूंषि वस्ताता कुपितेन महात्मना ।\nस्मरता निहतान् बन्धूनार्तानिह कथञ्चन \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2116293, "chapter_id": 3503, "verse_number": "३", "content_sanskrit": "गर्भानपि यदा यूयं भृगूणां हत पूर्वकान् ।\nतदाऽयमूरुणा गर्भो मया वर्षशतं धृतः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2116294, "chapter_id": 3503, "verse_number": "४", "content_sanskrit": "षडङ्गश्चाखिलो वेद इमं गर्भस्थमेव च ।\nविवेश भृगुवंशस्य भूयः प्रियचिकीर्षया \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2116295, "chapter_id": 3503, "verse_number": "५", "content_sanskrit": "सोऽयं पितृवधान्नूनं क्रोधाद् वो हन्तुमिच्छति ।\nतेजसा यस्य दिव्येन चक्षूंषि मुषितानि वः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2116296, "chapter_id": 3503, "verse_number": "६", "content_sanskrit": "तमेव यूयं याचध्वमौर्वं मम सुतोपमम् ।\nअयं वः प्रणिपातेन दृष्टिं तुष्टः प्रदास्यति \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2116297, "chapter_id": 3503, "verse_number": "", "content_sanskrit": "गन्धर्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2116298, "chapter_id": 3503, "verse_number": "७", "content_sanskrit": "एवमुक्तास्ततः सर्वे राजानस्ते तमूरुजम् ।\nऊचुः प्रसीदेति तदा प्रसादं च चकार सः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2116299, "chapter_id": 3503, "verse_number": "८", "content_sanskrit": "एतेनैव तु विख्यातो नाम्ना लोकेषु सत्तमः ।\nस और्व इति विख्यात ऊरुं भित्त्वा विनिस्सृतः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2116300, "chapter_id": 3503, "verse_number": "९", "content_sanskrit": "चक्षूंषि प्रतिलभ्याथ प्रतिजग्मुस्ततो नृपाः ।\nभार्गवस्तु मुनिर्नूनं मेने लोके पराभवम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2116301, "chapter_id": 3503, "verse_number": "१०", "content_sanskrit": "स चक्रे तत्र लोकानां विनाशाय मनस्तदा ।\nसर्वेषामेव कार्त्स्न्येन मनप्रवणमात्मनः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2116302, "chapter_id": 3503, "verse_number": "११", "content_sanskrit": "इच्छन्नपचितिं कर्तुं भृगूणां भृगुसत्तमः ।\nसर्वलोकविनाशाय तेपे तूग्रतरं तपः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2116303, "chapter_id": 3503, "verse_number": "१२", "content_sanskrit": "तापयामास ताँल्लोकान् ससुरासुरमानवान् ।\nतपसोग्रेण महता मानयिष्यन् पितामहान् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2116304, "chapter_id": 3503, "verse_number": "१३", "content_sanskrit": "ततस्तं पितरस्तात विज्ञाय भृगुसत्तमम् ।\nपितृलोकादिहागत्य सर्व ऊचुरिदं वचः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2116305, "chapter_id": 3503, "verse_number": "", "content_sanskrit": "पितरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2116306, "chapter_id": 3503, "verse_number": "१४", "content_sanskrit": "और्व दृष्टः प्रभावस्ते तपसोग्रस्य पुत्रक ।\nप्रसादं कुरु लोकानां नियच्छ क्रोधमात्मनः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2116307, "chapter_id": 3503, "verse_number": "१५", "content_sanskrit": "नानीशैर्हि तदा तात भृगुभिर्भावितात्मभिः ।\nवधोऽप्युपेक्षितः सर्वैः क्षत्रियाणां विहिंसताम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2116308, "chapter_id": 3503, "verse_number": "१६", "content_sanskrit": "आयुषा हि प्रकृष्टेन यदा नः खेद आविशत् ।\nतदाऽस्माभिर्वधो घोरः क्षत्रियैरीप्सितः स्वयम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2116309, "chapter_id": 3503, "verse_number": "१७", "content_sanskrit": "निखातं तद्धि वै वित्तं कस्मिंश्चिद् भृगुवेश्मनि ।\nवैरायैव ततो न्यस्तं क्षत्रियान् कोपयिष्णुभिः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2116310, "chapter_id": 3503, "verse_number": "१८", "content_sanskrit": "किं हि वित्तेन नः कार्यं स्वर्गेप्सूनां द्विजर्षभ ।\nयदा हि मृत्युरायाति न शक्नोति च सर्वशः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2116311, "chapter_id": 3503, "verse_number": "१९", "content_sanskrit": "तदाऽस्माभिरयं दृष्ट उपायस्तात धर्मतः ।\nआत्महा च पुनस्तात न लोकाँल्लभते शुभान् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2116312, "chapter_id": 3503, "verse_number": "२०", "content_sanskrit": "ततोऽस्माभिः समीक्ष्यैवमात्मनाऽऽत्मा विनाशितः ।\nन चैतन्नः प्रियं तात यदिदं कर्तुमिच्छसि\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2116313, "chapter_id": 3503, "verse_number": "२१", "content_sanskrit": "नियच्छेदं मनः पापात् सर्वलोकपराभवात् ।\nन हि निःक्षत्रियाः केचिल्लोकाः सन्ति सुपुत्रक ।\nदूषयन्ति च नस्तेजः क्रोधमुत्पतितं जहि\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2116314, "chapter_id": 3503, "verse_number": "", "content_sanskrit": "और्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2116315, "chapter_id": 3503, "verse_number": "२२", "content_sanskrit": "उक्तवानस्मि यां क्रोधात् प्रतिज्ञां पितरस्तथा ।\nसर्वलोकविनाशाय न सा मे वितथा भवेत् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2116316, "chapter_id": 3503, "verse_number": "२३", "content_sanskrit": "वृथारोषप्रतिज्ञोऽहं न तु जीवितुमुत्सहे ।\nअनिस्तीर्णो हि मे रोषो दहेदग्निरिवारणिम् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2116317, "chapter_id": 3503, "verse_number": "२४", "content_sanskrit": "देशकालेन सञ्जातं क्रोधं यः क्षन्तुमर्हति ।\nनालं स मनुजः सम्यक् त्रिवर्गं परिरक्षितुम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2116318, "chapter_id": 3503, "verse_number": "२५", "content_sanskrit": "स्थाने रोषः प्रयुक्तः स्यान्नृपैः स्वर्गजिगीषुभिः ।\nअश्रौषमहमूरुस्थो गर्भशय्यागतस्तदा \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2116319, "chapter_id": 3503, "verse_number": "२६", "content_sanskrit": "आरावं तु भृशं तत्र भृगूणां क्षत्रियैर्वधे ।\nसामर्षैर्हि तदा लोके भृगूणां क्षत्रियाधमैः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2116320, "chapter_id": 3503, "verse_number": "२७", "content_sanskrit": "आगर्भोत्सादनं जातं तदा मां मन्युराविशत् ।\nप्रकीर्णकेशाः किल मे मातरः पितरस्तथा \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2116321, "chapter_id": 3503, "verse_number": "२८", "content_sanskrit": "भयात् सर्वेषु लोकेषु नाधिजग्मुः परायणम् ।\nतान् भृगूणां परान् दारान् कश्चिन्नाभ्युपपद्यत \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2116322, "chapter_id": 3503, "verse_number": "२९", "content_sanskrit": "माता तदा दधारेयमूरुणैकेन मां शुभा ।\nप्रतिषेद्धा हि पापस्य यदा लोके न विद्यते \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2116323, "chapter_id": 3503, "verse_number": "३०", "content_sanskrit": "तदा सर्वेषु लोकेषु पापकृन्नोपशाम्यति ।\nयदा तु प्रतिषेद्धारं पापं न लभते क्वचित्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2116324, "chapter_id": 3503, "verse_number": "३१", "content_sanskrit": "तिष्ठन्ति बहवो लोकास्तदा पापेषु कर्मसु ।\nजानन्नपि च यः पापं शक्तिमान्न नियच्छति \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2116325, "chapter_id": 3503, "verse_number": "३२", "content_sanskrit": "ईशः स चापि तेनैव कर्मणा सम्प्रयुज्यते ।\nराजभिश्चेतरैश्चैव यदि वै पितरो मम \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2116326, "chapter_id": 3503, "verse_number": "३३", "content_sanskrit": "शक्तैर्न शङ्कितास्त्रातुमिष्टमद्येह जीवितम् ।\nअत एषामहं क्रुद्धो लोकानामीश्वरोऽद्य सन् \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2116327, "chapter_id": 3503, "verse_number": "३४", "content_sanskrit": "भवतां च वचो नाहमलं समतिवर्तितुम् ।\nमम चापि भवेदेवमीश्वरस्य सतो महत् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2116328, "chapter_id": 3503, "verse_number": "३५", "content_sanskrit": "उपेक्षमाणस्य पुनर्लोकानां किल्बिषं भयम् ।\nयश्चायं मन्युना मेऽग्निर्लोकानादातुमिच्छति \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2116329, "chapter_id": 3503, "verse_number": "३६", "content_sanskrit": "दहेदेव च मामेष निगृहीतः स्वतेजसा ।\nभवतां च विजानामि सर्वलोकहितेप्सुताम् ।\nतस्माद् विदध्वं यच्छ्रेयो लोकानां मम चेप्सथ\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2116330, "chapter_id": 3503, "verse_number": "", "content_sanskrit": "पितरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2116331, "chapter_id": 3503, "verse_number": "३७", "content_sanskrit": "य एष मन्युजस्तेऽग्निर्लोकानादातुमिच्छति ।\nअप्सु तं मुञ्च भद्रं ते लोका ह्यप्सु प्रतिष्ठिताः \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2116332, "chapter_id": 3503, "verse_number": "३८", "content_sanskrit": "तस्मादप्सु प्रमुञ्चेदं क्रोधाग्निं द्विजसत्तम ।\nअयं तिष्ठतु ते विप्र यदीच्छसि महोदधौ \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2116333, "chapter_id": 3503, "verse_number": "३९", "content_sanskrit": "मन्युजोऽग्निर्दहन्नापो लोकाश्चैवाम्मयाः स्मृताः ।\nएवं प्रतिज्ञा सत्येयं भविष्यति तवानघ ।\nन चैव सामरा लोका भविष्यन्ति पराभवम् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2116334, "chapter_id": 3503, "verse_number": "", "content_sanskrit": "वसिष्ठः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2116335, "chapter_id": 3503, "verse_number": "४०", "content_sanskrit": "ततस्तं क्रोधजं तात और्वोऽग्निं वरुणालये ।\nउत्ससर्ज स चैवाप उपयुङ्क्ते महोदधौ \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2116336, "chapter_id": 3503, "verse_number": "४१", "content_sanskrit": "महद्धयशिरो भूत्वा यत्तद् वेदविदो विदुः ।\nतमग्निमुद्गिरन् वक्त्रात् पिबत्यापो महोदधौ \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2116337, "chapter_id": 3503, "verse_number": "४२", "content_sanskrit": "तस्मात् त्वमपि भद्रं ते न लोकान् हन्तुमर्हसि ।\nपराशर परं धर्मं ज्ञात्वा ज्ञानविदां वर \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2116338, "chapter_id": 3503, "verse_number": "", "content_sanskrit": "गन्धर्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2116339, "chapter_id": 3503, "verse_number": "४३", "content_sanskrit": "एवमुक्तः स विप्रर्षिर्वसिष्ठेन महात्मना ।\nनियच्छदात्मनः क्रोधं सर्वलोकपराभवात्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2116340, "chapter_id": 3503, "verse_number": "४४", "content_sanskrit": "ईजे च स महातेजाः सर्ववेदविदां वरः ।\nऋषी राक्षससत्रेण शाक्तेयोऽथ पराशरः \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2116341, "chapter_id": 3503, "verse_number": "४५", "content_sanskrit": "ततो वृद्धांश्च बालांश्च राक्षसान् स महामतिः ।\nददाह विततं सत्रे शक्तेर्वधमनुस्मरन् \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2116342, "chapter_id": 3503, "verse_number": "४६", "content_sanskrit": "न हि तं वारयामास वसिष्ठो रक्षसां वधात् ।\nद्वितीयामस्य मा जघ्ने प्रतिज्ञामिति चिन्तयन् \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2116343, "chapter_id": 3503, "verse_number": "४७", "content_sanskrit": "त्रयाणां पावकानां स सत्रे तस्मिन् महामुनिः ।\nआसीत् पुरस्तद् देवानां चतुर्थ इव पावकः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2116344, "chapter_id": 3503, "verse_number": "४८", "content_sanskrit": "तेन यज्ञेन शुद्धेन हूयमानेन युक्तितः ।\nतद् विदीपितमाकाशं सूर्येणेव घनात्यये \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2116345, "chapter_id": 3503, "verse_number": "४९", "content_sanskrit": "तं वसिष्ठादयः सर्वे मुनयस्त्वेव मेनिरे ।\nतेजसा दीप्यमानं तु द्वितीयमिव भास्करम् \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2116346, "chapter_id": 3503, "verse_number": "५०", "content_sanskrit": "ततः परमदुष्प्रापमन्यैर्ऋषिरुदारधीः ।\nसमापिपयिषुः सत्रं तमत्रिः समुपागमत् \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2116347, "chapter_id": 3503, "verse_number": "५१", "content_sanskrit": "तं निवारयिषुः सत्रं निर्ऋतेः प्रियकाम्यया ।\nततः पुलस्त्यः पुलहः क्रतुश्चैव महातपाः \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2116348, "chapter_id": 3503, "verse_number": "५२", "content_sanskrit": "तदाऽऽजग्मुरमित्रघ्न रक्षसां जीवितेप्सया ।\nपुलस्त्यस्तु वधात् तेषां रक्षसां भरतर्षभ \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2116349, "chapter_id": 3503, "verse_number": "५३", "content_sanskrit": "उवाचेदं वचः पार्थ पराशरमरिन्दमम् ।\nकच्चित् तपस्यविघ्नं ते कच्चिन्नन्दसि पुत्रक \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2116350, "chapter_id": 3503, "verse_number": "५४", "content_sanskrit": "अजानतामदोषाणां सर्वेषां रक्षसां वधात् ।\nप्रजोच्छेदमिमं मह्यं मा कार्षीस्तापसोत्तम \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2116351, "chapter_id": 3503, "verse_number": "५५", "content_sanskrit": "अधर्मिष्ठं वरिष्ठः सन् कुरुषे त्वं पराशर ।\nशक्तिनं चापि धर्मज्ञं नातिक्रान्तुमिहार्हसि \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2116352, "chapter_id": 3503, "verse_number": "५६", "content_sanskrit": "प्रजानां च ममोच्छेदं न वै कर्तुं त्वमर्हसि ।\nशापाद्धि शक्तेर्वासिष्ठ तदा तदुपपादितम् \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2116353, "chapter_id": 3503, "verse_number": "५७", "content_sanskrit": "आत्मजेन स दोषेण शक्तिर्नीत इतो दिवम् ।\nन हि तं राक्षसः कश्चिच्छक्तो भक्षयितुं मुने \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2116354, "chapter_id": 3503, "verse_number": "५८", "content_sanskrit": "वासिष्ठा भक्षिताश्चासन् कौशिकोत्सृष्टरक्षसा ।\nशापं न कुर्वन्ति तदा वागस्त्रा नरवारणाः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2116355, "chapter_id": 3503, "verse_number": "५९", "content_sanskrit": "क्षमावन्तं दहेद् देहमहम्मन्युं ध्रुवं त्विति ।\nआत्मनैवात्मतस्तेन ततो मृत्युस्तदाऽभवत् \t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2116356, "chapter_id": 3503, "verse_number": "६०", "content_sanskrit": "निमित्तभूतस्तत्रासीद् विश्वामित्रः पराशर ।\nराजा कल्माषपादस्तु दिवमारोढुमिच्छति \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2116357, "chapter_id": 3503, "verse_number": "६१", "content_sanskrit": "ये च शक्त्यवराः पुत्रा वसिष्ठस्य महामुने ।\nते च सर्वे मुदा युक्ता मोदन्ते सहिताः सुरैः \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2116358, "chapter_id": 3503, "verse_number": "६२", "content_sanskrit": "सर्वमेतद् वसिष्ठस्य विदितं वै महात्मनः ।\nरक्षसां च समुच्छेद एष तात तपस्विनाम् \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2116359, "chapter_id": 3503, "verse_number": "६३", "content_sanskrit": "निमित्तभूतस्त्वं चात्र क्रतौ वासिष्ठनन्दन ।\nस सत्रं मुञ्च भद्रं ते समाप्तमिदमस्तु ते \t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2116360, "chapter_id": 3503, "verse_number": "", "content_sanskrit": "गन्धर्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2116361, "chapter_id": 3503, "verse_number": "६४", "content_sanskrit": "एवमुक्तः पुलस्त्येन वसिष्ठेन च धीमता ।\nतदा समापयामास सत्रं शान्तः पराशरः \t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2116362, "chapter_id": 3503, "verse_number": "६५", "content_sanskrit": "सर्वराक्षससत्राय सम्भूतं पावकं मुनिः ।\nउत्तरे हिमवत्पार्श्वे उत्ससर्ज महावने \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2116363, "chapter_id": 3503, "verse_number": "६६", "content_sanskrit": "स तत्राद्यापि रक्षांसि वृक्षानश्मन एव च ।\nभक्षयन् दृश्यते वह्निः सदा पर्वणिपर्वणि \t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2116364, "chapter_id": 3503, "verse_number": "१८२", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nद्व्यशीत्यधिकशततमोऽध्यायः ॥१८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2116365, "chapter_id": 3503, "verse_number": "१५", "content_sanskrit": "॥ इति चैत्ररथपर्वणि पञ्चदशोऽध्यायः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2116366, "chapter_id": 3503, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}]