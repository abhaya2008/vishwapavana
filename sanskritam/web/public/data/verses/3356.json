[{"id": 2108694, "chapter_id": 3356, "verse_number": "", "content_sanskrit": "शौनकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2108695, "chapter_id": 3356, "verse_number": "१", "content_sanskrit": "जरत्कारुरिति प्रोक्तो यस्त्वया सूतनन्दन ।\nइच्छाम्येतदहं तस्य ऋषेः श्रोतुं महात्मनः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2108696, "chapter_id": 3356, "verse_number": "२", "content_sanskrit": "किं कारणं जरत्कारोर्नामैतत् प्रथितं भुवि ।\nजरत्कारुनिरुक्तं त्वं यथावद् वक्तुमर्हसि \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2108697, "chapter_id": 3356, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2108698, "chapter_id": 3356, "verse_number": "३", "content_sanskrit": "जरेति क्षयमाहुर्वै दारुणं कारुसञ्ज्ञितम् ।\nशरीरं कारु तस्यासीत् तत् स धीमान् शनैः शनैः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2108699, "chapter_id": 3356, "verse_number": "४", "content_sanskrit": "क्षपयामास तीव्रेण तपस्येत्येवमुच्यते ।\nजरत्कारुरिति ब्रह्मन् वासुकेर्भगिनीपतिः\t ॥ ४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2108700, "chapter_id": 3356, "verse_number": "५", "content_sanskrit": "एवमुक्तस्तु धर्मात्मा शौनकः प्राह तं तदा ।\nउग्रश्रवसमामन्त्र्य उपपन्नमिति ब्रुवन् ।\nउक्तं तात त्वया यं त्वामर्थं सम्पृष्ठवानहम्\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2108701, "chapter_id": 3356, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2108702, "chapter_id": 3356, "verse_number": "६", "content_sanskrit": "अथ कालस्य महतः स मुनिः संशितव्रतः ।\nतपस्यभिरतो धीमान् न दारानभ्यकाङ्क्षत \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2108703, "chapter_id": 3356, "verse_number": "७", "content_sanskrit": "स ह्यूर्ध्वरेतास्तपसि प्रवृत्तः\nस्वाध्यायवान् वीतभयक्लमश्च ।\nचचार सर्वां पृथिवीं महात्मा\nन चापि दारान् मनसाऽभ्यकाङ्क्षत्\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2108704, "chapter_id": 3356, "verse_number": "८", "content_sanskrit": "ततः परस्मिन् सम्प्राप्ते काले कस्मिंश्चिदेव तु\nपरीक्षिदिति विख्यातो राजा कौरववंशभृत् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2108705, "chapter_id": 3356, "verse_number": "९", "content_sanskrit": "यथा पाण्डुर्महाबाहुर्धनुर्धरवरो युधि ।\nपाण्डुस्तु मृगयाशीलः पुरास्य प्रपितामहः\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2108706, "chapter_id": 3356, "verse_number": "१०", "content_sanskrit": "मृगान् विध्यन् वराहांश्च तरक्षून् महिषांस्तदा ।\nअन्यांश्च विविधान् वन्यान् जघान पृथिवीपतिः\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2108707, "chapter_id": 3356, "verse_number": "११", "content_sanskrit": "स कदाचिन्मृगान् विद्ध्वा बाणेन नतपर्वणा ।\nपृष्ठतो धनुरादाय ससार गहने वने \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2108708, "chapter_id": 3356, "verse_number": "१२", "content_sanskrit": "यथा हि भगवान् रुद्रो विद्ध्वा यज्ञमृगं दिवि ।\nअन्वगच्छद् धनुष्पाणिः पर्यटन् वेषवांस्ततः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2108709, "chapter_id": 3356, "verse_number": "१३", "content_sanskrit": "न हि तेन मृगो विद्धो जीवन् गच्छति वै वनम् ।\nअपूर्वरूपं तत्रासीद् राज्ञः स्वर्गगतिं प्रति \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2108710, "chapter_id": 3356, "verse_number": "१४", "content_sanskrit": "पाण्डवेयस्य राजर्षेः विद्धो यन्नष्टवान् मृगः ।\nदूरं चापहृतस्तेन मृगेण स महीपतिः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2108711, "chapter_id": 3356, "verse_number": "१५", "content_sanskrit": "परिश्रान्तः पिपासार्त आससाद मुनिं वने ।\nगवां प्रचारेष्वासीनं वत्सानां मुखनिस्सृतम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2108712, "chapter_id": 3356, "verse_number": "१६", "content_sanskrit": "भूयिष्ठमुपयुञ्जानं फेनं वै पिबतां पयः ।\nतमभिद्रुत्य वेगेन स राजा संशितव्रतः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2108713, "chapter_id": 3356, "verse_number": "१७", "content_sanskrit": "अपृच्छद् धनुरुद्यम्य तं मृगं क्षुच्छ्रमान्वितः ।\nभो भो ब्रह्मन्नहं राजा परीक्षिदभिमन्युजः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2108714, "chapter_id": 3356, "verse_number": "१८", "content_sanskrit": "मया विद्धो मृगो नष्टः कच्चित् त्वं दृष्टवानसि ।\nस मुनिस्तस्य नोवाच किञ्चिन्मौनव्रते स्थितः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2108715, "chapter_id": 3356, "verse_number": "१९", "content_sanskrit": "तस्य स्कन्धे मृतं सर्पं क्रुद्धो राजा समासृजत् ।\nधनुष्टकोट्या समुत्क्षिप्य स चैनं समुदैक्षत\t ॥ १९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2108716, "chapter_id": 3356, "verse_number": "२१", "content_sanskrit": "न च किञ्चिदुवाचैनं शुभं वा यदि वाऽशुभम् ।\nस राजा क्रोधमुत्सृज्य व्यथितस्तं तथागतम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2108717, "chapter_id": 3356, "verse_number": "२२", "content_sanskrit": "दृष्ट्वा जगाम नगरीम् ऋषिस्त्वास्ते तथैव सः ।\nतरुणस्तस्य पुत्रोऽभूत् तिग्मतेजा महातपाः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2108718, "chapter_id": 3356, "verse_number": "२३", "content_sanskrit": "शृङ्गी नाम महाक्रोधो दुष्प्रसादो महाव्रतः ।\nस देववरमीशानं सर्वभूतहिते रतः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2108719, "chapter_id": 3356, "verse_number": "२४", "content_sanskrit": "ब्राह्मणमुपतस्थे वै काले काले सुसंयतः ।\nस तेन समनुज्ञातो ब्रह्मणा गृहमेयिवान्\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2108720, "chapter_id": 3356, "verse_number": "२५", "content_sanskrit": "सख्योक्तः क्रीडमानेन स तत्र हसता किल ।\nसंरब्धः कोपनोऽतीव विषकल्पो मुनेः सुतः ।\nऋषिपुत्रेण चर्मार्थं कृशेन द्विजसत्तम \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2108721, "chapter_id": 3356, "verse_number": "", "content_sanskrit": "कृशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2108722, "chapter_id": 3356, "verse_number": "२६", "content_sanskrit": "तेजस्विनस्तव पिता तथैव च तपस्विनः ।\nशवं स्कन्धेन वहति मा शृङ्गिन् गर्वितो भव\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2108723, "chapter_id": 3356, "verse_number": "२७", "content_sanskrit": "व्याहरत्स्वृषिपुत्रेषु माऽत्र किञ्चिद्वचो वदीः ।\nअस्मद्विधेषु सिद्धेषु ब्रह्मवित्सु तपस्विषु \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2108724, "chapter_id": 3356, "verse_number": "२८", "content_sanskrit": "क्व ते पुरुषमानित्वं क्व ते वाचस्तथाविधाः ।\nदर्पजाः पितरं द्रष्टा यस्त्वं शवधरं तथा \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2108725, "chapter_id": 3356, "verse_number": "३५", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि पञ्चत्रिंशोऽध्यायः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2108726, "chapter_id": 3356, "verse_number": "२३", "content_sanskrit": "॥ आस्तीकपर्वणि त्रयोविंशोऽध्यायः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]