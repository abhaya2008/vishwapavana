[{"id": 7000428000, "chapter_id": 20428, "verse_number": "२-१००-१", "content_sanskrit": "विष्णुरुवाच ।\nनर्मदायास्तटे रम्ये वटे तिष्ठति वै पिता ।\nविज्वलोऽपि समायातः पितरं प्रणिपत्य सः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000428001, "chapter_id": 20428, "verse_number": "२-१००-२", "content_sanskrit": "वासुदेवाभिधानस्य स्तोत्रस्यापि महामतिः ।\nसमाचष्टे स धर्मात्मा महिमानं पितुः पुरः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000428002, "chapter_id": 20428, "verse_number": "२-१००-३", "content_sanskrit": "यथा विष्णुः समागत्य ददौ तस्मै वरं शुभम् ।\nतत्सर्वं कथयामास सुप्रसन्नेन चेतसा॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000428003, "chapter_id": 20428, "verse_number": "२-१००-४", "content_sanskrit": "कुंजलोपि च वृत्तांतं समाकर्ण्य स भूपतेः ।\nहर्षेण महताविष्टः पुत्रमालिंग्य विज्वलम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000428004, "chapter_id": 20428, "verse_number": "२-१००-५", "content_sanskrit": "आह पुण्यं कृतं वत्स त्वया राज्ञे महात्मने ।\nउपकारं महापुण्यं वासुदेवस्य कीर्तनात्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000428005, "chapter_id": 20428, "verse_number": "२-१००-६", "content_sanskrit": "एवमाभाष्य तं पुत्रमाशीर्भिरभिनंद्य च ।\nपुत्रं देवसमोपेतं स्तुत्वा चैव पुनः पुनः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000428006, "chapter_id": 20428, "verse_number": "२-१००-७", "content_sanskrit": "स्थितः सरित्तटे रम्ये च्यवनस्योपपश्यतः ।\nएतत्ते सर्वमाख्यातं तेषां वृत्तं महात्मनाम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000428007, "chapter_id": 20428, "verse_number": "२-१००-८", "content_sanskrit": "वैष्णवानां महाराज अन्यत्किं ते वदाम्यहम् ।\nवेन उवाच ।\nअमृतं शंखपात्रेण पानार्थं मम चार्पितम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000428008, "chapter_id": 20428, "verse_number": "२-१००-९", "content_sanskrit": "तस्मात्कस्य न च श्रद्धा पातुं मर्त्यस्य भूतले ।\nउत्तमं वैष्णवं ज्ञानं पानानामिह सर्वदा॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000428009, "chapter_id": 20428, "verse_number": "२-१००-१०", "content_sanskrit": "त्वयैवं कथ्यमानस्य पाने तृप्तिर्न जायते ।\nश्रोतुं हि देवदेवेश मम श्रद्धा विवर्द्धते॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000428010, "chapter_id": 20428, "verse_number": "२-१००-११", "content_sanskrit": "कथयस्व प्रसादान्मे कुंजलस्यापि चेष्टितम् ।\nमहात्मना किमुक्तं च चतुर्थं तनयं प्रति॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000428011, "chapter_id": 20428, "verse_number": "२-१००-१२", "content_sanskrit": "तत्त्वं सुविस्तरादेव कृपया कथयस्व मे ।\nश्रीभगवानुवाच ।\nश्रूयतामभिधास्यामि चरित्रं कुंजलस्य च॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000428012, "chapter_id": 20428, "verse_number": "२-१००-१३", "content_sanskrit": "बहुश्रेयः समायुक्तं चरित्रं च्यवनस्य च ।\nइदं पुण्यं नरश्रेष्ठ आख्यानं पापनाशनम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000428013, "chapter_id": 20428, "verse_number": "२-१००-१४", "content_sanskrit": "यः शृणोति नरो भक्त्या गोसहस्रफलं लभेत्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]