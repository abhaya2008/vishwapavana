[{"id": 2015509, "chapter_id": 1327, "verse_number": "२-६८-१", "content_sanskrit": "वैशम्पायन उवाच॥\nवचः श्रुत्वैव भीष्मस्य चेदिराडुरुविक्रमः।\nयुयुत्सुर्वासुदेवेन वासुदेवमुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2015510, "chapter_id": 1327, "verse_number": "२-६८-२", "content_sanskrit": "आह्वये त्वां रणं गच्छ मया सार्धं जनार्दन।\nयावदद्य निहन्मि त्वां सहितं सर्वपाण्डवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2015511, "chapter_id": 1327, "verse_number": "२-६८-३", "content_sanskrit": "सह त्वया हि मे वध्याः सर्वथा कृष्ण पाण्डवाः।\nनृपतीन्समतिक्रम्य यैरराजा त्वमर्चितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2015512, "chapter_id": 1327, "verse_number": "२-६८-४", "content_sanskrit": "ये त्वां दासमराजानं बाल्यादर्चन्ति दुर्मतिम्।\nअनर्हमर्हवत्कृष्ण वध्यास्त इति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2015513, "chapter_id": 1327, "verse_number": "२-६८-५", "content_sanskrit": "इत्युक्त्वा राजशार्दूल शार्दूल इव नादयन्।\nपश्यतां सर्वभूतानां शिशुपालः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2015514, "chapter_id": 1327, "verse_number": "२-६८-६", "content_sanskrit": "स रणायैव सङ्क्रुद्धः सन्नद्धः सर्वराजभिः।\nसुनीथः प्रययौ क्षिप्रं पार्थयज्ञजिघांसया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2015515, "chapter_id": 1327, "verse_number": "२-६८-७", "content_sanskrit": "ततश्चक्रगदापाणिः केशवः केशिहा हरिः।\nसध्वजं रथमास्थाय दारुकेण सुसत्कृतम्।\nभीष्मेण दत्तहस्तोऽसावारुहोह रथोत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2015516, "chapter_id": 1327, "verse_number": "२-६८-८", "content_sanskrit": "तेन पापस्वभावेन कोपितान्सर्वपार्थिवान्।\nआससाद रणे कृष्णः सज्जितैकरथः स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2015517, "chapter_id": 1327, "verse_number": "२-६८-९", "content_sanskrit": "ततः पुष्करपत्राक्षं तार्क्ष्यध्वजरथे स्थितम्।\nदिवाकरमिवोद्यन्तं ददृशुः सर्वपार्थिवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2015518, "chapter_id": 1327, "verse_number": "२-६८-१०", "content_sanskrit": "आरोपयन्तं ज्यां कृष्णं प्रतपन्तमिवौजसा।\nस्थितं पुष्परथे दिव्ये पुष्पकेतुमिवापरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2015519, "chapter_id": 1327, "verse_number": "२-६८-११", "content_sanskrit": "दृष्ट्वा कृष्णं तथा यान्तं प्रतपन्तमिवौजसा।\nयथार्हं केशवे वृत्तिमवशाः प्रतिपेदिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2015520, "chapter_id": 1327, "verse_number": "२-६८-१२", "content_sanskrit": "तानुवाच महाबाहुर्महाऽसुरनिबर्हणः।\nवृष्णिवीरस्तदा राजन्सान्त्वयन्परवीरहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2015521, "chapter_id": 1327, "verse_number": "२-६८-१३x", "content_sanskrit": "श्रीभगवानुवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2015522, "chapter_id": 1327, "verse_number": "२-६८-१३", "content_sanskrit": "अपेत सबलाः सर्व आस्वस्ता मम शासनात्।\nमा दृष्टो दूषयेत्पाप एष वः सर्वपार्थिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2015523, "chapter_id": 1327, "verse_number": "२-६८-१४", "content_sanskrit": "एष नः शत्रुरत्यन्तमेष वृष्णिविमर्दनः।\nसात्वतां सात्वतीपुत्रो वैरं चरति शाश्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2015524, "chapter_id": 1327, "verse_number": "२-६८-१५", "content_sanskrit": "प्राग्ज्योतिषपुरं यातानस्माञ्ज्ञात्वा नृशंसकृत्।\nअदहद्द्वारकामेष स्वस्त्रीयः सन्नराधिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2015525, "chapter_id": 1327, "verse_number": "२-६८-१६", "content_sanskrit": "क्रीडतो भोजराजस्य एव रैवतके गिरौ।\nहत्वा बध्वा च तान्सार्वानुपायात्स्वपुरं पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2015526, "chapter_id": 1327, "verse_number": "२-६८-१७", "content_sanskrit": "अश्वमेधे हयं मेध्यमुत्सृष्टं रक्षिभिर्वृतम्।\nपितुर्मे यज्ञविघ्नार्थमहरत्पापनिश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2015527, "chapter_id": 1327, "verse_number": "२-६८-१८", "content_sanskrit": "सौवीरान्प्रतियातां च बभ्रोरेष तपस्विनः।\nभार्यामभ्यहरन्मोहादकामां तामितो गताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2015528, "chapter_id": 1327, "verse_number": "२-६८-१९", "content_sanskrit": "एष मायाप्रतिच्छन्नः कारूशार्थे तपस्विनीम्।\nजहार भद्रां वैशालीं मातुलस्य नृशंसकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2015529, "chapter_id": 1327, "verse_number": "२-६८-२०", "content_sanskrit": "वृष्णिदारान्विलाप्यैव हत्वा च कुकुरान्धकान्।\nपापाबुद्धिरुपातिष्ठत्स प्रविश्य ससम्भ्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2015530, "chapter_id": 1327, "verse_number": "२-६८-२१", "content_sanskrit": "विशालराज्ञो दुहितां मम पित्रा वृतां सतीम्।\nअनेन कृत्वा सन्धानं करूशेन जिगीषया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2015531, "chapter_id": 1327, "verse_number": "२-६८-२२", "content_sanskrit": "जरासन्धं समाश्रित्य कृतवान्विप्रियाणि मे।\nतानि सर्वाणि सङ्ख्यातुं न शक्नोमि नराधिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2015532, "chapter_id": 1327, "verse_number": "२-६८-२३", "content_sanskrit": "एवमेतदपर्यन्तमेष वृष्णिषु किल्बिषी।\nअस्माकमयमारम्भांश्चकार परभानृजुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2015533, "chapter_id": 1327, "verse_number": "२-६८-२४", "content_sanskrit": "शतं क्षन्तव्यमस्माभिर्वधार्हाणां किलागसाम्।\nबद्धोऽस्मि समयैर्घोरैर्मातुरस्यैव सङ्गरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2015534, "chapter_id": 1327, "verse_number": "२-६८-२५", "content_sanskrit": "तत्तथा शतमस्माकं क्षान्तं क्षयकरं मया।\nद्वौ तु मे वधकालेऽस्मिन्न क्षन्तव्यौ कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2015535, "chapter_id": 1327, "verse_number": "२-६८-२६", "content_sanskrit": "यज्ञविघ्नकरं हन्यां पाण्डवानां च दुर्हृदम्।\nइति मे वर्तते भावस्तमतीयां कथं न्वहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2015536, "chapter_id": 1327, "verse_number": "२-६८-२७", "content_sanskrit": "पितृष्वसुः कृते दुःखं सुमहन्मर्षयाम्यहम्।\nदिष्ट्या हीदं सर्वराज्ञां सन्निधावद्य वर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2015537, "chapter_id": 1327, "verse_number": "२-६८-२८", "content_sanskrit": "पश्यन्ति हि भवन्तोऽद्य मय्यतीव व्यतिक्रमम्।\nकृतानि तु परोक्षं मे यानि तानि निबोधत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2015538, "chapter_id": 1327, "verse_number": "२-६८-२९", "content_sanskrit": "इमं त्वस्य न शक्ष्यामि क्षन्तुमद्य व्यतिक्रमम्।\nअवलेपाद्वधार्हस्य समग्रे राजमण्डले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2015539, "chapter_id": 1327, "verse_number": "२-६८-३०", "content_sanskrit": "रुक्मिण्यामस्य मूढस्य प्रार्थनाऽऽसीन्मुमूर्षतः।\nन च तां प्राप्तवान्मूढः शूद्रो वेदश्रुतीमिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2015540, "chapter_id": 1327, "verse_number": "२-६८-३१x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2015541, "chapter_id": 1327, "verse_number": "२-६८-३१", "content_sanskrit": "एवमादि ततः सर्वे सहितास्ते नराधिपाः।\nगर्हणं शिशुपालस्य वासुदेवेन विश्रुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2015542, "chapter_id": 1327, "verse_number": "२-६८-३२", "content_sanskrit": "वासुदेववचः श्रुत्वा चेदिराजं व्यगर्हयन्।\nरथोपस्थे धनुष्मन्तं शरान्सन्दधतं रुषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2015543, "chapter_id": 1327, "verse_number": "२-६८-३३", "content_sanskrit": "श्रुत्वाऽपि च विलोक्याशु दुद्रुवुः सर्वपार्थिवाः।\nविहाय परमोद्विग्नाश्चेदिराजं चमूमुखे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2015544, "chapter_id": 1327, "verse_number": "२-६८-३४", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा शिशुपालः प्रतापवान्।\nजहास स्वनवद्धासं वाक्यं चेदमुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2015545, "chapter_id": 1327, "verse_number": "२-६८-३५", "content_sanskrit": "मत्पूर्वां रुक्मिणीं कृष्ण संसत्सु परिकीर्तयन्।\nविशेषतः पार्थिवेषु व्रीडां न कुरुषे कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2015546, "chapter_id": 1327, "verse_number": "२-६८-३६", "content_sanskrit": "मन्यमानो हि कः सत्सु पुरुषः परिकीर्तयेत्।\nअन्यपूर्वा स्त्रियं जातु त्वदन्यो मधूसूदन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2015547, "chapter_id": 1327, "verse_number": "२-६८-३७", "content_sanskrit": "क्षमा वा यदि ते श्रद्धा मा वा कृष्ण मम क्षम।\nक्रुद्धाद्वापि प्रसन्नाद्वा किं मे त्वत्तो भविष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2015548, "chapter_id": 1327, "verse_number": "२-६८-३८x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2015549, "chapter_id": 1327, "verse_number": "२-६८-३८", "content_sanskrit": "स तांस्तु विद्रुतान्सर्वान्साश्वपत्तिरथद्विपान्।\nकृष्णतेजोहतान्सर्वान्समीक्ष्य वसुधाधिपान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2015550, "chapter_id": 1327, "verse_number": "२-६८-३९", "content_sanskrit": "शिशुपालो रथेनैकः प्रत्युपायात्स केशवम्।\nरुषा ताम्रेक्षणो राजञ्छलभः पावकं यथा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2015551, "chapter_id": 1327, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि शिशुपालवधपर्वणि अष्टषष्टितमोऽध्यायः॥ ६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]