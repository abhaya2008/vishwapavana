[{"id": 7003940000, "chapter_id": 23940, "verse_number": "३-१-३-१", "content_sanskrit": "ऋषय ऊचुः ।\nचतुर्विंशतितीर्थानि यान्युक्तानि त्वया मुने ।\nतेषां प्रधानतीर्थानां सेतौ पापविनाशने॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003940001, "chapter_id": 23940, "verse_number": "३-१-३-२", "content_sanskrit": "आदिमस्य तु तीर्थस्य चक्रतीर्थमिति प्रथा ।\nकथं समागता सूत वदास्माकं हि पृच्छताम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003940002, "chapter_id": 23940, "verse_number": "३-१-३-३", "content_sanskrit": "श्रीसूत उवाच ।\nचतुर्विंशतितीर्थानां प्रधानानां द्विजोत्तमाः ।\nयदुक्तमादिमं तीर्थं सर्वलोकेषु विश्रुतम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003940003, "chapter_id": 23940, "verse_number": "३-१-३-४", "content_sanskrit": "स्मरणात्तस्य तीर्थस्य गर्भवासो न विद्यते ।\nविलयं यांति पापानि लक्षजन्मकृतान्यपि॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003940004, "chapter_id": 23940, "verse_number": "३-१-३-५", "content_sanskrit": "तस्मिंस्तीर्थे सकृत्स्नाना त्स्मरणात्कीर्तनादपि ।\nलोके ततोधिकं तीर्थं तत्तुल्यं वा द्विजोत्तमाः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003940005, "chapter_id": 23940, "verse_number": "३-१-३-६", "content_sanskrit": "न विद्यते मुनिश्रेष्ठाः सत्यमुक्तमिदं मया ।\nगंगा सरस्वती रेवा पंपा गोदावरी नदी॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003940006, "chapter_id": 23940, "verse_number": "३-१-३-७", "content_sanskrit": "कालिंदी चैव कावेरी नर्मदा मणिकर्णिका ।\nअन्यानि यानि तीर्थानि नद्यः पुण्या महीतले॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003940007, "chapter_id": 23940, "verse_number": "३-१-३-८", "content_sanskrit": "अस्य तीर्थस्य विप्रेंद्राः कोट्यंशेनापि नो समाः ।\nधर्मतीर्थमिति प्राहुस्तत्तीर्थं हि पुराविदः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003940008, "chapter_id": 23940, "verse_number": "३-१-३-९", "content_sanskrit": "यथा समागता तस्य चक्रतीर्थमिति प्रथा ।\nतदिदानीं प्रवक्ष्यामि शृणुध्वं मुनिपुंगवाः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003940009, "chapter_id": 23940, "verse_number": "३-१-३-१०", "content_sanskrit": "सेतुमूलं हि तत्प्रोक्तं तद्दर्भशयनं मतम् ।\nतत्रैव चक्रतीर्थं तु महापातकमर्द्दनम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003940010, "chapter_id": 23940, "verse_number": "३-१-३-११", "content_sanskrit": "पुरा हि गालवोनाम मुनिर्विष्णुपरायणः ।\nदक्षिणांभोनिधेस्तीरे हालास्यादविदूरतः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003940011, "chapter_id": 23940, "verse_number": "३-१-३-१२", "content_sanskrit": "फुल्लग्रामसमीपे च तथा क्षीरसरोंतिके ।\nधर्म पुष्करिणीतीरे सोऽतप्यत महत्तपः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003940012, "chapter_id": 23940, "verse_number": "३-१-३-१३", "content_sanskrit": "युगानामयुतं ब्रह्म गृणन्विप्राः सनातनम् ।\nदयायुक्तो निराहारः सत्यवान्विजितेंद्रियः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003940013, "chapter_id": 23940, "verse_number": "३-१-३-१४", "content_sanskrit": "आत्मवत्सर्वभूतानि पश्यन्विषयनिःस्पृहः ।\nसर्वभूतहितो दांतः सर्वद्वंद्वविवर्जितः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003940014, "chapter_id": 23940, "verse_number": "३-१-३-१५", "content_sanskrit": "वर्षाणि कतिचित्सोऽयं जीर्णपर्णाशनोऽभवत ।\nकिंचित्कालं जलाहारो वायुभक्षः कियत्समाः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003940015, "chapter_id": 23940, "verse_number": "३-१-३-१६", "content_sanskrit": "एवं पंचसहस्राणि वर्षाणि स महामुनिः ।\nअतप्यत तपो घोरं देवैरपि सुदुष्करम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003940016, "chapter_id": 23940, "verse_number": "३-१-३-१७", "content_sanskrit": "ततः पंचसहस्राणि वर्षाणि मुनिपुंगवः ।\nनिराहारो निरालोको निरुच्छ्वासो निरास्पदः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003940017, "chapter_id": 23940, "verse_number": "३-१-३-१८", "content_sanskrit": "वर्षास्वासारसहनं हेमंतेषु जलेशयः ।\nग्रीष्मे पंचाग्निमध्यस्थो विष्णुध्यानपरायणः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003940018, "chapter_id": 23940, "verse_number": "३-१-३-१९", "content_sanskrit": "जपन्नष्टाक्षरं मंत्रं ध्यायन्हृदि जनार्दनम् ।\nतताप सुमहातेजा गालवो मुनिपुंगवः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003940019, "chapter_id": 23940, "verse_number": "३-१-३-२०", "content_sanskrit": "एवं त्वयुतव वर्षाणि स समतीतानि वै मुनेः ।\nअथ तत्तपसा तुष्टो भगवान्कमलापतिः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003940020, "chapter_id": 23940, "verse_number": "३-१-३-२१", "content_sanskrit": "प्रत्यक्षतामगात्तस्य शंखचक्रगदाधरः ।\nविकचांबुजपत्राक्षः सूर्यकोटिसमप्रभः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003940021, "chapter_id": 23940, "verse_number": "३-१-३-२२", "content_sanskrit": "विनतानंदनारूढश्छत्रचामरशोभितः ।\nहारकेयूरमुकुटकटकादिविभूषितः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003940022, "chapter_id": 23940, "verse_number": "३-१-३-२३", "content_sanskrit": "विष्वक्सेनसुनंदादिकिंकरैः परिवारितः ।\nवीणावेणुमृदंगादिवादकैर्नारदादिभिः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003940023, "chapter_id": 23940, "verse_number": "३-१-३-२४", "content_sanskrit": "उपगीयमानविजयः पीतांबरविराजितः ।\nलक्ष्मीविराजितोरस्को नीलमेघसमच्छविः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003940024, "chapter_id": 23940, "verse_number": "३-१-३-२५", "content_sanskrit": "धुनानः पद्ममेकेन पाणिना मधुसूदनः ।\nसनकादिमहायोगिसेवितः पार्श्वयोर्द्वयोः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003940025, "chapter_id": 23940, "verse_number": "३-१-३-२६", "content_sanskrit": "मंदस्मितेन सकलं मोहयन्भुवनत्रयम् ।\nस्वभासा भासयन्सर्वान्दिशो दश च भूसुराः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003940026, "chapter_id": 23940, "verse_number": "३-१-३-२७", "content_sanskrit": "कंठलग्रेन मणिना कौस्तुभेन च शोभितः ।\nसुवर्णवेत्रहस्तैश्च सौविदल्लैरनेकशः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003940027, "chapter_id": 23940, "verse_number": "३-१-३-२८", "content_sanskrit": "अनन्यदुर्लभाचिंत्यगीयमाननिजाद्भुतः ।\nसुभक्तसुलभो देवो लक्ष्मीकांतो हरिः स्वयम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003940028, "chapter_id": 23940, "verse_number": "३-१-३-२९", "content_sanskrit": "सन्न्यधत्त पुरस्तस्य गालवस्य महामुनेः ।\nआविर्भूतं तदा दृष्ट्वा श्रीवत्सांकितवक्षसम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003940029, "chapter_id": 23940, "verse_number": "३-१-३-३०", "content_sanskrit": "पीतांबरधरं देवं तुष्टिं प्राप महामुनिः ।\nभक्त्या परमया युक्तस्तुष्टाव जगदीश्वरम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003940030, "chapter_id": 23940, "verse_number": "३-१-३-३१", "content_sanskrit": "गालव उवाच ।\nनमो देवादिदेवाय शंखचक्रगदाभृते ।\nनमो नित्याय शुद्धाय सच्चिदानंदरूपिणे॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003940031, "chapter_id": 23940, "verse_number": "३-१-३-३२", "content_sanskrit": "नमो भक्तार्ति हंत्रे ते हव्यकव्यस्वरूपिणे ।\nनमस्त्रिमूर्तये तुभ्यं सृष्टिस्थित्यंतकारिणे॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003940032, "chapter_id": 23940, "verse_number": "३-१-३-३३", "content_sanskrit": "नमः परेशाय नमो विभूम्ने नमोस्तु लक्ष्मीपतये विधात्रे ।\nनमोस्तु सूर्येंदुविलोचनाय नमो विरिंच्याद्यभिवंदिताय॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003940033, "chapter_id": 23940, "verse_number": "३-१-३-३४", "content_sanskrit": "यो नामजात्यादिविकल्पहीनः समस्तदोषैरपि वर्जितो यः ।\nस्रमस्तसंसारभयापहारिणे तस्मै नमो दैत्यविनाशनाय॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003940034, "chapter_id": 23940, "verse_number": "३-१-३-३५", "content_sanskrit": "वेदांतवेद्याय रमेश्वराय वैकुण्ठवासाय विधातृपित्रे ।\nनमोनमः सत्यजनार्तिहारिणे नारायणायामितविक्रमाय॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003940035, "chapter_id": 23940, "verse_number": "३-१-३-३६", "content_sanskrit": "नमस्तुभ्यं भग वते वासुदेवाय शार्ङ्गिणे ।\nभूयोभूयो नमस्तुभ्यं शेषपर्यंकशायिने॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003940036, "chapter_id": 23940, "verse_number": "३-१-३-३७", "content_sanskrit": "इति स्तुत्वा हरिं विप्रास्तूष्णीमास्ते स गालवः ।\nश्रुत्वा स्तुतिं श्रुति सुखां हरिस्तस्यमहात्मनः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003940037, "chapter_id": 23940, "verse_number": "३-१-३-३८", "content_sanskrit": "अवाप परमं तोषं शंखचक्रगदाधरः ।\nअथालिंग्य मुनिं शौरिश्चतुर्भिर्बाहुभिस्तदा॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003940038, "chapter_id": 23940, "verse_number": "३-१-३-३९", "content_sanskrit": "बभाषे प्रीतिसं युक्तो वरो वै व्रियतामिति ।\nतुष्टोऽस्मि तपसा तेऽद्य स्तोत्रेणापि च गालव॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003940039, "chapter_id": 23940, "verse_number": "३-१-३-४०", "content_sanskrit": "नमस्कारेण च प्रीतो वरदोऽहं तवागतः ।\nगालव उवाच ।\nनारायण रमानाथ पीतांबर जगन्मय॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003940040, "chapter_id": 23940, "verse_number": "३-१-३-४१", "content_sanskrit": "जनार्दन जगद्धामन्गोविंद नरकांतक ।\nत्वद्दर्शनात्कृतार्थोऽस्मि सर्वस्मादधिकस्तथा॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003940041, "chapter_id": 23940, "verse_number": "३-१-३-४२", "content_sanskrit": "त्वां न पश्यंत्यधर्मिष्ठा यतस्त्वं धर्मपालकः ।\nयन्न वेत्ति भवो ब्रह्मा यन्न वेत्ति त्रयी तथा॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003940042, "chapter_id": 23940, "verse_number": "३-१-३-४३", "content_sanskrit": "तं वेद्मि परमात्मानं किमस्मा दधिकं वरम् ।\nयोगिनो यं न पश्यन्ति यं न पश्यंति कर्मठाः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003940043, "chapter_id": 23940, "verse_number": "३-१-३-४४", "content_sanskrit": "तं पश्यामि परात्मानं किमस्मादधिकं वरम् ।\nएतेन च कृतार्थोऽस्मि जनार्दन जगत्पते॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003940044, "chapter_id": 23940, "verse_number": "३-१-३-४५", "content_sanskrit": "यन्नामस्मृतिमात्रेण महापातकिनोऽपिच ।\nमुक्तिं प्रयांति मुनयस्तं पश्यामि जनार्दनम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003940045, "chapter_id": 23940, "verse_number": "३-१-३-४६", "content_sanskrit": "त्वत्पादपद्मयुगले निश्चला भक्तिरस्तुमे ।\nहरिरुवाच ।\nमयि भक्तिर्दृढा तेऽस्तु निष्कामा गालवाधुना॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003940046, "chapter_id": 23940, "verse_number": "३-१-३-४७", "content_sanskrit": "शृणु चाप्यपरं वाक्यमुच्यमानं मया मुने ।\nमदर्थं कर्म कुर्वाणो मद्ध्यानो मत्परायणः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003940047, "chapter_id": 23940, "verse_number": "३-१-३-४८", "content_sanskrit": "एतत्प्रारब्धदेहांते मत्स्वरूपमवाप्स्यसि ।\nअस्मिन्नेवाश्रमे वासं कुरुष्व मुनिपुंगव॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003940048, "chapter_id": 23940, "verse_number": "३-१-३-४९", "content_sanskrit": "धर्मपुष्करिणी चेयं पुण्या पापविनाशिनी ।\nअस्यास्तीरे तपः कुर्वंस्तपःसिद्धिमवाप्नुयात्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003940049, "chapter_id": 23940, "verse_number": "३-१-३-५०", "content_sanskrit": "धर्मः पुरा समागत्य दक्षिणस्योदधेस्तटे ।\nतपस्तेपे महादेवं चिंतयन्मनसा तदा॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003940050, "chapter_id": 23940, "verse_number": "३-१-३-५१", "content_sanskrit": "स्नानार्थमेकं तीर्थं च चक्रे धर्मो महामुने ।\nधर्मपुष्करिणी तेन प्रसिद्धा तत्कृता यतः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003940051, "chapter_id": 23940, "verse_number": "३-१-३-५२", "content_sanskrit": "त्वया यथा तपस्तप्तमिदानीं मुनिसत्तम ।\nतथा तप्तं तपस्तेन धर्मेण हरसेविना॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003940052, "chapter_id": 23940, "verse_number": "३-१-३-५३", "content_sanskrit": "तपसा तस्य तुष्टः सञ्छूलपाणिर्महेश्वरः ।\nप्रादुरासीस्त्वया दीप्त्या दिशोदशविभासयन्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003940053, "chapter_id": 23940, "verse_number": "३-१-३-५४", "content_sanskrit": "अथाश्रममनुप्राप्तं महादेवं कृपानिधिम् ।\nधर्मः परमसन्तुष्टस्तुष्टाव परमेश्वरम्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003940054, "chapter_id": 23940, "verse_number": "३-१-३-५५", "content_sanskrit": "धर्म उवाच ।\nप्रणमामि जगन्नाथमीशानं प्रणवात्मकम् ।\nसमस्तदेवतारूपमादिमध्यांतवर्जितम्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003940055, "chapter_id": 23940, "verse_number": "३-१-३-५६", "content_sanskrit": "ऊर्ध्वरेतं विरूपाक्षं विश्वरूपं नमाम्य हम् ।\nसमस्तजगदाधारमनन्तमजमव्ययम्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003940056, "chapter_id": 23940, "verse_number": "३-१-३-५७", "content_sanskrit": "यमामनन्ति योगीन्द्रास्तं वन्दे पुष्टिवर्धनम् ।\nनमो लोकाधिनाथाय वंचते परिवंचते॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003940057, "chapter_id": 23940, "verse_number": "३-१-३-५८", "content_sanskrit": "नमोऽस्तु नीलकण्ठाय पशूनां पतये नमः ।\nनमः कल्मषनाशाय नमो मीढुष्टमाय च॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003940058, "chapter_id": 23940, "verse_number": "३-१-३-५९", "content_sanskrit": "नमो रुद्राय देवाय कद्रुद्राय प्रचेतसे ।\nनमः पिनाकहस्ताय शूलहस्ताय ते नमः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003940059, "chapter_id": 23940, "verse_number": "३-१-३-६०", "content_sanskrit": "नमश्चैतन्यरूपाय पुष्टीनां पतये नमः ।\nनमः पंचास्यदेवाय क्षेत्राणां पतये नमः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003940060, "chapter_id": 23940, "verse_number": "३-१-३-६१", "content_sanskrit": "इति स्तुतो महादेवः शंकरोलोकशंकरः ।\nधर्मस्य परमां तुष्टिमापन्नस्तमुवाच वै॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003940061, "chapter_id": 23940, "verse_number": "३-१-३-६२", "content_sanskrit": "महेश्वर उवाच ।\nप्रीतोस्म्यनेन स्तोत्रेण तव धर्म महामते ।\nवरं मत्तो वृणीष्व त्वं मा विलंबं कुरुष्व वै॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003940062, "chapter_id": 23940, "verse_number": "३-१-३-६३", "content_sanskrit": "ईश्वरेणैवमुक्तस्तु धर्मो देवमथाब्रवीत् ।\nवाहनं ते भविष्यामि सदाहं पार्वतीपते॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003940063, "chapter_id": 23940, "verse_number": "३-१-३-६४", "content_sanskrit": "अयमेव वरो मह्यं दातव्यस्त्रिपुरांतक ।\nतवोद्वहनमात्रेण कृतार्थोऽहं भवामि भोः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003940064, "chapter_id": 23940, "verse_number": "३-१-३-६५", "content_sanskrit": "इत्थं धर्मेण कथितो देवो धर्ममथाब्रवीत् ।\nईश्वर उवाच ।\nवाहनं भव मे धर्म सर्वदा लोकपूजितः॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003940065, "chapter_id": 23940, "verse_number": "३-१-३-६६", "content_sanskrit": "मम चोद्वहने शक्तिरमोघा ते भविष्यति ।\nत्वत्सेविनां सदा भक्तिर्मयि स्यान्नात्र संशयः॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003940066, "chapter_id": 23940, "verse_number": "३-१-३-६७", "content_sanskrit": "इत्युक्ते शंकरेणाथ धर्मोपि वृषरूपधृक् ।\nउवाह परमेशानं तदाप्रभृति गालव॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003940067, "chapter_id": 23940, "verse_number": "३-१-३-६८", "content_sanskrit": "महादेवस्तमारुह्य धर्मं वै वृषरूपिणम् ।\nशोभमानो भृशं धर्ममुवाच परमामृतम्॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003940068, "chapter_id": 23940, "verse_number": "३-१-३-६९", "content_sanskrit": "ईश्वर उवाच ।\nत्वया कृतं हि यत्तीर्थं दक्षिणस्योदधेस्तटे ।\nधर्मपुष्करिणीत्येषा लोके ख्याता भविष्यति॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003940069, "chapter_id": 23940, "verse_number": "३-१-३-७०", "content_sanskrit": "अस्यास्तीरे जपोहोमो दानं स्वाध्याय एव च ।\nअन्ये च धर्मनिवहाः क्रियमाणा नरैर्मुदा॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003940070, "chapter_id": 23940, "verse_number": "३-१-३-७१", "content_sanskrit": "अनंतफलदा ज्ञेया नात्र कार्या विचारणा ।\nइति दत्त्वा वरं तस्मै धर्मतीर्थाय शंकरः॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003940071, "chapter_id": 23940, "verse_number": "३-१-३-७२", "content_sanskrit": "आरुह्य वृषभं धर्मं कैलासं पर्वतं ययौ ।\nधर्मपुष्करिणीतीरे गालव त्वमतोधुना॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003940072, "chapter_id": 23940, "verse_number": "३-१-३-७३", "content_sanskrit": "शरीरपातपर्यंतं तपः कुर्वन्समाहितः ।\nवस त्वं मुनि शार्दूल पश्चान्मामाप्स्यसे ध्रुवम्॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003940073, "chapter_id": 23940, "verse_number": "३-१-३-७४", "content_sanskrit": "यदा ते जायते भीतिस्तदा तां नाशयाम्यहम् ।\nममायुधेन चक्रेण प्रेरितेन मया क्षणात्॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003940074, "chapter_id": 23940, "verse_number": "३-१-३-७५", "content_sanskrit": "इत्युक्त्वा भगवान्विष्णुस्तत्रैवांतरधीयत ।\nश्रीसूत उवाच ।\nतस्मिन्नंतर्हिते विष्णौ गालवो मुनिपुंगवः॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003940075, "chapter_id": 23940, "verse_number": "३-१-३-७६", "content_sanskrit": "धर्मपुष्करिणीतीरे विष्णुध्यानपरायणः ।\nत्रिकालमर्चयन्विष्णुं शालग्रामे विमुक्तिदे॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003940076, "chapter_id": 23940, "verse_number": "३-१-३-७७", "content_sanskrit": "उवास मतिमान्धीरो विरक्तो विजितेंद्रियः ।\nकदाचिन्माघमासे तु शुक्लपक्षे हरेर्दिने॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003940077, "chapter_id": 23940, "verse_number": "३-१-३-७८", "content_sanskrit": "उपोष्य जागरं कृत्वा रात्रौ विष्णुमपूजयत् ।\nस्नात्वा परेद्युर्द्वादश्यां धर्मपुष्करिणीजले॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003940078, "chapter_id": 23940, "verse_number": "३-१-३-७९", "content_sanskrit": "संध्यावन्दनपूर्वाणि नित्यकर्माणि चाकरोत्॥  ।\nततः पूजां विधातुं स हरेः समुपचक्रमे॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003940079, "chapter_id": 23940, "verse_number": "३-१-३-८०", "content_sanskrit": "तुलस्यादीनि पुष्पाणि समाहृत्य च गालवः ।\nविधाय पूजां कृष्णस्य स्तोत्रमेतदुदैरयत्॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003940080, "chapter_id": 23940, "verse_number": "३-१-३-८१", "content_sanskrit": "गालव उवाच ।\nसहस्रशिरसं विष्णुं मत्स्यरूपधरं हरिम् ।\nनमस्यामि हृषीकेशं कूर्मवाराहरूपिणम्॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003940081, "chapter_id": 23940, "verse_number": "३-१-३-८२", "content_sanskrit": "नारसिंहं वामनाख्यं जाम दग्न्यं च राघवम् ।\nबलभद्रं च कृष्णं च कल्किं विष्णुं नमाम्यहम्॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003940082, "chapter_id": 23940, "verse_number": "३-१-३-८३", "content_sanskrit": "वासुदेवमनाधारं प्रणतार्तिविनाशनम् ।\nआधारं सर्वभूतानां प्रणमामि जनार्दनम्॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003940083, "chapter_id": 23940, "verse_number": "३-१-३-८४", "content_sanskrit": "सर्वज्ञं सर्वकर्तारं सच्चिदानंदविग्रहम् ।\nअप्रतर्क्यमनिर्देश्यं प्रणतोऽस्मि जनार्दनम्॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003940084, "chapter_id": 23940, "verse_number": "३-१-३-८५", "content_sanskrit": "एवं स्तुवन्महा योगी गालवो मुनिपुंगवः ।\nधर्मपुष्करिणीतीरे तस्थौ ध्यानपरायणः॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003940085, "chapter_id": 23940, "verse_number": "३-१-३-८६", "content_sanskrit": "एतस्मिन्नंतरे कश्चिद्राक्षसो गालवं मुनिम् ।\nआययौ भक्षितुं घोरः क्षुधया पीडितो भृशम्॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003940086, "chapter_id": 23940, "verse_number": "३-१-३-८७", "content_sanskrit": "गालवं तरसा सोऽयं राक्षसो जगृहे तदा ।\nगृहीतस्तरसा तेन गालवो नैऋतेन सः॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003940087, "chapter_id": 23940, "verse_number": "३-१-३-८८", "content_sanskrit": "प्रचुक्रोश दयां भोधिमापन्नानां परायणम् ।\nनारायणं चक्रपाणिं रक्षरक्षेति वै मुहुः॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003940088, "chapter_id": 23940, "verse_number": "३-१-३-८९", "content_sanskrit": "परेश परमानंद शरणागतपालक ।\nत्राहि मां करुणासिंधो रक्षोवशे मुपागतम्॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003940089, "chapter_id": 23940, "verse_number": "३-१-३-९०", "content_sanskrit": "लक्ष्मीकांत हरे विष्णो वैकुंठ गरुडध्वज ।\nमां रक्ष रक्षसाक्रांतं ग्राहाक्रांतं गजं यथा॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003940090, "chapter_id": 23940, "verse_number": "३-१-३-९१", "content_sanskrit": "दामोदर जगन्नाथ हिरण्यासुर मर्द्दन ।\nप्रह्रादमिव मां रक्ष राक्षसेनातिपीडितम्॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003940091, "chapter_id": 23940, "verse_number": "३-१-३-९२", "content_sanskrit": "इत्येवं स्तुवतस्तस्य गालवस्य द्विजोत्तमाः ।\nस्वभक्तस्य भयं ज्ञात्वा चक्रपाणिवृषा कपिः॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003940092, "chapter_id": 23940, "verse_number": "३-१-३-९३", "content_sanskrit": "स्वचक्रं प्रेषयामास भक्तरक्षणकारणात् ।\nप्रेरितं विष्णुचक्रं तद्विष्णुना प्रभविष्णुना॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003940093, "chapter_id": 23940, "verse_number": "३-१-३-९४", "content_sanskrit": "आजगामाथ वेगेन धर्मपुष्करिणी तटम् ।\nअनंतादित्यसंकाशमनंताग्निसमप्रभम्॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003940094, "chapter_id": 23940, "verse_number": "३-१-३-९५", "content_sanskrit": "महाज्वालं महानादं महासुरविमर्दनम् ।\nदृष्ट्वा सुदर्शनं विष्णो राक्षसोऽथ प्रदुद्रुवे॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003940095, "chapter_id": 23940, "verse_number": "३-१-३-९६", "content_sanskrit": "द्रवमाणस्य तस्याशु राक्षसस्य सुदर्शनम् ।\nशिरश्चकर्त सहसा ज्वालामालादुरासदम्॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003940096, "chapter_id": 23940, "verse_number": "३-१-३-९७", "content_sanskrit": "ततस्तु गालवो दृष्ट्वा राक्षसं पतितं भुवि ।\nमुदा परमया युक्तस्तुष्टाव च सुदर्शनम्॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003940097, "chapter_id": 23940, "verse_number": "३-१-३-९८", "content_sanskrit": "गालव उवाच ।\nविष्णुचक्रं नमस्तेस्तु विश्वरक्षणदीक्षित ।\nनारायणकरांभोजभूषणाय नमोऽस्तु ते॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003940098, "chapter_id": 23940, "verse_number": "३-१-३-९९", "content_sanskrit": "युद्धेष्वसुरसंहारकुशलाय महारव ।\nसुदर्शन नमस्तुभ्यं भक्तानामार्तिनाशिने॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003940099, "chapter_id": 23940, "verse_number": "३-१-३-१००", "content_sanskrit": "रक्ष मां भयसंविग्नं सर्वस्मादपि कल्मषात् ।\nस्वामिन्सुदर्शन विभो धर्मर्तीर्थे सदा भवान्॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003940100, "chapter_id": 23940, "verse_number": "३-१-३-१०१", "content_sanskrit": "संनिधेहि हिताय त्वं जगतो मुक्तिकांक्षिणः ।\nगालवेनैवमुक्तं तद्विष्णुचक्रं मुनीश्वराः ।\nतं प्राह गालवमुनिं प्रीणयन्निव सौहृदात्॥ १०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003940101, "chapter_id": 23940, "verse_number": "३-१-३-१०२", "content_sanskrit": "सुदर्शन उवाच ।\nगालवैतन्महापुण्यं धर्मतोर्थमनुत्तमम्॥ १०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003940102, "chapter_id": 23940, "verse_number": "३-१-३-१०३", "content_sanskrit": "अस्मिन्वसामि सततं लोकानां हितकाम्यया ।\nत्वत्पीडां परिचिंत्याह राक्षसेन दुरात्मना॥ १०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003940103, "chapter_id": 23940, "verse_number": "३-१-३-१०४", "content_sanskrit": "प्रेरितो विष्णुना विप्र त्वरया समुपागतः ।\nत्वत्पीडकोथ निहतो मयायं राक्षसाधमः॥ १०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003940104, "chapter_id": 23940, "verse_number": "३-१-३-१०५", "content_sanskrit": "मोचितस्त्वं भयादस्मात्त्वं हि भक्तो हरेः सदा ।\nपुष्करिण्यामहं त्वस्यां धर्मस्य मुनिपुंगव॥ १०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003940105, "chapter_id": 23940, "verse_number": "३-१-३-१०६", "content_sanskrit": "सततं लोकरक्षार्थं संनिधानं करोमि वै ।\nअस्यां मत्संनिधानात्ते तथान्येषामपि द्विज॥ १०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003940106, "chapter_id": 23940, "verse_number": "३-१-३-१०७", "content_sanskrit": "इतः परं न पीडा स्याद्भूतराक्षससंभवा ।\nधर्मपुष्करिणी ह्येषा सर्वपापविनाशिनी॥ १०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003940107, "chapter_id": 23940, "verse_number": "३-१-३-१०८", "content_sanskrit": "देवीपट्टणपर्यंता कृता धर्मेण वै पुरा ।\nअत्र सर्वत्र वत्स्यामि सर्वदा मुनिपुंगव॥ १०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003940108, "chapter_id": 23940, "verse_number": "३-१-३-१०९", "content_sanskrit": "अस्या मत्संनिधा नात्स्याच्चक्रतीर्थमिति प्रथा ।\nस्नानं येऽत्र प्रकुर्वंति चक्रतीर्थे विमुक्तिदे॥ १०९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003940109, "chapter_id": 23940, "verse_number": "३-१-३-११०", "content_sanskrit": "तेषां पुत्राश्च पौत्राश्च वंशजाः सर्व एव हि ।\nविधूतपापा यास्यंति तद्विष्णोः परमं पदम्॥ ११० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003940110, "chapter_id": 23940, "verse_number": "३-१-३-१११", "content_sanskrit": "पितॄनुद्दिश्य पिंडानां दातारो येऽत्र गालव ।\nस्वर्गं प्रयांति ते सर्वे पितरश्चापि तर्प्पिताः॥ १११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003940111, "chapter_id": 23940, "verse_number": "३-१-३-११२", "content_sanskrit": "इत्युक्त्वा विष्णुचक्रं तद्गालवस्यापि पश्यतः ।\nअन्येषामपि विप्राणां पश्यतां सहसा द्विजाः॥ ११२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003940112, "chapter_id": 23940, "verse_number": "३-१-३-११३", "content_sanskrit": "धर्मापुष्कारिणीं तां तु प्राविशत्पापनाशिनीम् ।\nश्रीसूत उवाच ।\nधर्मतीर्थस्य विप्रंद्राश्चक्रतीर्थमिति प्रथा॥ ११३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003940113, "chapter_id": 23940, "verse_number": "३-१-३-११४", "content_sanskrit": "प्राप्ता यथा तत्कथितं युष्माकं हि मया मुदा ।\nचक्रतीर्थसमं तीर्थं न भूतं न भविष्यति॥ ११४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003940114, "chapter_id": 23940, "verse_number": "३-१-३-११५", "content_sanskrit": "अत्र स्नाता नरा विप्रा मोक्षभाजो न संशयः ।\nकीर्तयेदिममध्यायं शृणुयाद्वा समाहितः ।\nचक्र तीर्थाभिषेकस्य प्राप्नोति फलमुत्तमम् ।\nइह लोके सुखं प्राप्य परत्रापिसुखं लभेत्॥ ११६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003940115, "chapter_id": 23940, "verse_number": "३-१-३-११६", "content_sanskrit": "यो धर्मतीर्थं च तथैव गालवं कुर्वाणगत्युग्रसमाधियो गम् ।\nसुदर्शनं राक्षसनाशनं च स्मरेत्सकृद्वा न स पापभाग्जनः॥ ११७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}]