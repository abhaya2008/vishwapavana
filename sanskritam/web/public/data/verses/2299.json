[{"id": 2060681, "chapter_id": 2299, "verse_number": "८-२०-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2060682, "chapter_id": 2299, "verse_number": "८-२०-१", "content_sanskrit": "अतितीव्राणि दुःखानि दुःसहानि बहूनि च।\nत्वत्तोऽहं सञ्जयाश्रौषं पुत्राणां चैव सङ्क्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2060683, "chapter_id": 2299, "verse_number": "८-२०-२", "content_sanskrit": "यथा त्वं मे कथयसे यथा युद्वमवर्तत।\nन सन्ति सूत कौरव्या इति मे निश्चिता मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2060684, "chapter_id": 2299, "verse_number": "८-२०-३", "content_sanskrit": "दुर्योधनश्च विरथः कृतस्तत्र महारथः।\nधर्मपुत्रः कथं चक्रे तस्य वा नृपतिः कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2060685, "chapter_id": 2299, "verse_number": "८-२०-४", "content_sanskrit": "अपराह्णे कथं युद्वमभवद्रोमहर्षणम्।\nतन्ममाचक्ष्व तत्त्वेन कुशलो ह्यसि सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2060686, "chapter_id": 2299, "verse_number": "८-२०-५x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2060687, "chapter_id": 2299, "verse_number": "८-२०-५", "content_sanskrit": "संसक्तेषु तु सैन्येषु वध्यमानेषु भागशः।\nरथमन्यं समास्थाय पुत्रस्तव विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2060688, "chapter_id": 2299, "verse_number": "८-२०-६", "content_sanskrit": "क्रोधेन महता युक्तः सविषो भुजगो यथा।\nदुर्योधनः समालक्ष्य धर्मराजं युधिष्ठिरम्।\nप्रोवाच सूतं त्वरितो याहियाहीति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2060689, "chapter_id": 2299, "verse_number": "८-२०-७", "content_sanskrit": "तत्र मां प्रापय क्षिप्रं सारथे यत्र पाण्डवः।\nध्रियमाणातप्रतेण राजा राजति दंशितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2060690, "chapter_id": 2299, "verse_number": "८-२०-८", "content_sanskrit": "स सूतश्चोदितो राज्ञा राज्ञः स्यन्दनमुत्तमम्।\nयुधिष्ठिरस्याभिमुखं प्रेषयामास संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2060691, "chapter_id": 2299, "verse_number": "८-२०-९", "content_sanskrit": "ततो युधिष्ठिरः क्रुद्वः प्रभिन्न इव कुञ्जरः।\nसारथिं चोदयामास याहि यत्र सुयोधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2060692, "chapter_id": 2299, "verse_number": "८-२०-१०", "content_sanskrit": "तौ समाजग्मतुर्वीरौ भ्रातरौ रथसत्तमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2060693, "chapter_id": 2299, "verse_number": "८-२०-११", "content_sanskrit": "समेत्य च महावीरौ संरब्धौ युद्वदुर्मदौ।\nववर्षतुर्महेष्वासौ शरैरन्योन्यमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2060694, "chapter_id": 2299, "verse_number": "८-२०-१२", "content_sanskrit": "ततो दुर्योधनो राजा धर्मशीलस्य मारिष।\nशिलाशितेन भल्लेन धनुश्चिच्छेद संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2060695, "chapter_id": 2299, "verse_number": "८-२०-१३", "content_sanskrit": "तं नामृष्यत सङ्क्रुद्धो ह्यवमानं युधिष्ठिरः।\nअपविध्य धनुश्छिन्नं क्रोधसंरक्तलोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2060696, "chapter_id": 2299, "verse_number": "८-२०-१४", "content_sanskrit": "अन्यत्कार्मुकमादाय धर्मपुत्रश्चमूमुखे।\nदुर्योधनस्य चिच्छेद ध्वजं कार्मुकमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2060697, "chapter_id": 2299, "verse_number": "८-२०-१५", "content_sanskrit": "अथान्यद्वनुरादाय पुत्रस्ते भरतर्षभ।\n`युधिष्ठिरस्य चिक्षेप शरान्कनकभूषणान्।\nरुक्मपुङ्खान्प्रसन्नाग्रान्सविषानिव पन्नगान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2060698, "chapter_id": 2299, "verse_number": "८-२०-१६", "content_sanskrit": "तावन्योन्यं सुसङ्क्रुद्धौ शस्त्रवर्षाण्यमुञ्चताम्।\nसिंहाविव सुसंरब्धौ परस्परजिगीषया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2060699, "chapter_id": 2299, "verse_number": "८-२०-१७", "content_sanskrit": "जघ्नतुस्तौ रणेऽन्योन्यं नर्दमानौ वृषाविव।\nअन्तरं मार्गमाणौ च चेरतुस्तौ महारथौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2060700, "chapter_id": 2299, "verse_number": "८-२०-१८", "content_sanskrit": "ततः पूर्णायतोत्सृष्टैः शरैस्तौ तु कृतव्रणौ।\nविरेजतुर्महाराज किंशुकाविव पुष्पितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2060701, "chapter_id": 2299, "verse_number": "८-२०-१९", "content_sanskrit": "ततो राजन्विमुञ्चन्तौ सिंहनादान्मुहुर्मुहुः।\nतलयोश्च तथा शब्दान्धनुषश्च महाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2060702, "chapter_id": 2299, "verse_number": "८-२०-२०", "content_sanskrit": "शङ्खशब्दवरांश्चैव चक्रतुस्तौ नरेश्वरौ।\nअन्योन्यं तौ महाराज पीडयांचक्रतुर्भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2060703, "chapter_id": 2299, "verse_number": "८-२०-२१", "content_sanskrit": "ततो युधिष्ठिरो राजा पुत्रं तव शरैस्त्रिभिः।\nआजघानोरसि क्रुद्धो वज्रवेगैर्दुरासदैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2060704, "chapter_id": 2299, "verse_number": "८-२०-२२", "content_sanskrit": "प्रतिविव्याध तं तूर्णं तव पुत्रो महीपतिः।\nपञ्चभिर्निशितैर्बाणैः स्वर्णपुङ्खैः शिलाशितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2060705, "chapter_id": 2299, "verse_number": "८-२०-२३", "content_sanskrit": "ततो दुर्योधनो राजा शक्तिं चिक्षेप भारत।\nसर्वपारशवीं तीक्ष्णां महोल्काप्रतिमां तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2060706, "chapter_id": 2299, "verse_number": "८-२०-२४", "content_sanskrit": "तामापतन्तीं सहसा धर्मराजः शितैः शरैः।\nत्रिभिश्चिच्छेद सहसा तं च विव्याध पञ्चभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2060707, "chapter_id": 2299, "verse_number": "८-२०-२५", "content_sanskrit": "निपपात ततः साऽथ स्वर्णदण्डा महास्वना।\nनिपतन्ती महोल्केव व्यराजच्छिखिसन्निभा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2060708, "chapter_id": 2299, "verse_number": "८-२०-२६", "content_sanskrit": "शक्तिं विनिहतां दृष्ट्वा पुत्रस्तव विशाम्पते।\nनवभिर्निशितैर्भल्लैर्निजघान युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2060709, "chapter_id": 2299, "verse_number": "८-२०-२७", "content_sanskrit": "सोऽतिविद्वो बलवता शत्रुणआ शत्रुतापनः।\nदुर्योधनं समुद्दिश्य बाणं जग्राह सत्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2060710, "chapter_id": 2299, "verse_number": "८-२०-२८", "content_sanskrit": "समाधत्त च तं बाणं धनुर्मध्ये महाबलः।\nचिक्षेप च महाराज ततः क्रुद्वः पराक्रमी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2060711, "chapter_id": 2299, "verse_number": "८-२०-२९", "content_sanskrit": "स तु बाणः समासाद्य तव पुत्रं महारथम्।\nव्यामोहयत राजानं धरणीं च ददार ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2060712, "chapter_id": 2299, "verse_number": "८-२०-३०", "content_sanskrit": "ततो दुर्योधनः क्रुद्धो गदामुद्यम्य वेगितः।\nविधित्सुः कलहस्यान्तं धर्मराजमुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2060713, "chapter_id": 2299, "verse_number": "८-२०-३१", "content_sanskrit": "तमुद्यतगदं दृष्ट्वा दण्डहस्तमिवान्तकम्।\nधर्मराजो महाशक्तिं प्राहिणोत्तव सूनवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2060714, "chapter_id": 2299, "verse_number": "८-२०-३२", "content_sanskrit": "दीप्यमानां महावेगां महोल्कां ज्वलितामिव।\nयमदण्डनिभां घोरां कालरात्रिमिवापराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2060715, "chapter_id": 2299, "verse_number": "८-२०-३३", "content_sanskrit": "रथस्थः स तया विद्वो वर्म भित्त्वा स्तनान्तरे।\nभृशं संविग्नहृदयः पपात च मुमोह च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2060716, "chapter_id": 2299, "verse_number": "८-२०-३४", "content_sanskrit": "नभस्तमाह च ततः प्रतिज्ञामनुपालय।\nनायं वध्यस्तव नृप इत्युक्तः स न्यवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2060717, "chapter_id": 2299, "verse_number": "८-२०-३५", "content_sanskrit": "ततस्त्वरितमागम्य कृतवर्मा तवात्मजम्।\nप्रत्यपद्यत राजानं निम्नं व्यसनार्णवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2060718, "chapter_id": 2299, "verse_number": "८-२०-३६", "content_sanskrit": "गदामादाय भीमोऽपि हेमपट्टपरिष्कृताम्।\nअभिदुद्राव वेगेन कृतवर्माणमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2060719, "chapter_id": 2299, "verse_number": "८-२०-३७", "content_sanskrit": "एवं तदभवद्युद्धं त्वदीयानां परैः सह।\nअपराह्णे महाराज काङ्क्षतां विजयं युधि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2060720, "chapter_id": 2299, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि षोडशदिवसयुद्धे विंशोऽध्यायः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]