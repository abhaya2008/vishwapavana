[{"id": 40021877, "chapter_id": 9371, "verse_number": "1", "content_sanskrit": "तत्र तां रजनीमुष्य केशिन्यां रघुनन्दनः । प्रभाते पुनरुत्थाय लक्ष्मणः प्रययौ तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40021878, "chapter_id": 9371, "verse_number": "2", "content_sanskrit": "ततो ऽर्धदिवसे प्राप्ते प्रविवेश महारथः । अयोध्यां रत्नसम्पूर्णां हृष्टपुष्टजनावृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40021879, "chapter_id": 9371, "verse_number": "3", "content_sanskrit": "सौमित्रिस्तु परं दैन्यं जगाम सुमहामतिः । रामपादौ समासाद्य वक्ष्यामि किमहं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40021880, "chapter_id": 9371, "verse_number": "4", "content_sanskrit": "तस्यैवं चिन्तयानस्य भवनं शशिसन्निभम् । रामस्य परमोदारं पुरस्तान्समदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40021881, "chapter_id": 9371, "verse_number": "5", "content_sanskrit": "राज्ञस्तु भवनद्वारि सो ऽवतीर्य रथोत्तमात् । अवाङ्मुखो दीनमनाः प्रविवेशानिवारितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40021882, "chapter_id": 9371, "verse_number": "6", "content_sanskrit": "स दृष्ट्वा राघवं दीनमासीनं परमासने । नेत्राभ्यामश्रुपूर्णाभ्यां ददर्शाग्रजमग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40021883, "chapter_id": 9371, "verse_number": "7", "content_sanskrit": "जग्राह चरणौ तस्य लक्ष्मणो दीनचेतनः । उवाच दीनया वाचा प्राञ्जलिः सुसमाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40021884, "chapter_id": 9371, "verse_number": "8", "content_sanskrit": "आर्यस्याज्ञां पुरस्कृत्य विसृज्य जनकात्मजाम् । गङ्गातीरे यथोद्दिष्टे वाल्मीकेराश्रमे शुचौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40021885, "chapter_id": 9371, "verse_number": "9", "content_sanskrit": "तत्र तां च शुभाचारामाश्रमान्ते यशस्विनीम् । पुनरप्यागतो वीर पादमूलमुपासितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40021886, "chapter_id": 9371, "verse_number": "10", "content_sanskrit": "मा शुचः पुरुषव्याघ्र कालस्य गतिरीदृशी । त्वद्विधा न हि शोचन्ति बुद्धिमन्तो मनस्विनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40021887, "chapter_id": 9371, "verse_number": "11", "content_sanskrit": "सर्वे क्षयान्ता निचयाः पतनान्ताः समुच्छ्रयाः । संयोगा विप्रयोगान्ता मरणान्तं च जीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40021888, "chapter_id": 9371, "verse_number": "12", "content_sanskrit": "तस्मात्पुत्रेषु दारेषु मित्रेषु च धनेषु च । नातिप्रसङ्गः कर्तव्यो विप्रयोगो हि तैर्ध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40021889, "chapter_id": 9371, "verse_number": "13", "content_sanskrit": "शक्तस्त्वमात्मना ऽ ऽत्मानं विनेतुं मनसैव हि । लोकान्सर्वांश्च काकुत्स्थ किं पुनः शोकमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40021890, "chapter_id": 9371, "verse_number": "14", "content_sanskrit": "नेदृशेषु विमुह्यन्ति त्वद्विधाः पुरुषर्षभाः । अपवादः स किल ते पुनरेष्यति राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40021891, "chapter_id": 9371, "verse_number": "15", "content_sanskrit": "यदर्थं मैथिली त्यक्ता अपवादभयान्नृप । सो ऽपवादः पुरे राजन्भविष्यति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40021892, "chapter_id": 9371, "verse_number": "16", "content_sanskrit": "स त्वं पुरुषशार्दूल धैर्येण सुसमाहितः । त्यजैनां दुर्बलां बुद्धिं सन्तापं मा कुरुष्व ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40021893, "chapter_id": 9371, "verse_number": "17", "content_sanskrit": "एवमुक्तः स काकुत्स्थो लक्ष्मणेन महात्मना । उवाच परया प्रीत्या सौमित्रिं मित्रवत्सलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40021894, "chapter_id": 9371, "verse_number": "18", "content_sanskrit": "एवमेतन्नरश्रेष्ठ यथा वदसि लक्ष्मण । परितोषश्च मे वीर मम कार्यानुशासने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40021895, "chapter_id": 9371, "verse_number": "19", "content_sanskrit": "निवृत्तिश्चागता सौम्य सन्तापश्च निराकृतः । भवद्वाक्यैः सुरुचिरैरनुनीतो ऽस्मि लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]