[{"id": 6000009000, "chapter_id": 10009, "verse_number": null, "content_sanskrit": "अथ नवमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000009001, "chapter_id": 10009, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.001.m4a", "display_order": 2}, {"id": 6000009002, "chapter_id": 10009, "verse_number": "१-९-१", "content_sanskrit": "व्यासाद्यैरीश्‍वरेहाज्ञैः कृष्णेनाद्भुतकर्मणा।\nप्रबोधितोऽपीतिहासैः नाबुध्यत शुचाऽर्पितः॥ १/९/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.002.m4a", "display_order": 3, "topics": [{"text": "बन्धुवधहेतुकपापशङ्कया युधिष्‍ठिरेण परिशोचनम्", "range": "१–७"}]}, {"id": 6000009003, "chapter_id": 10009, "verse_number": "१-९-२", "content_sanskrit": "आह राजा धर्मसुतश्चिन्तयन् सुहृदां वधम्।\nप्राकृतेनात्मना विप्राः स्नेहमोहवशं गतः॥ १/९/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.003.m4a", "display_order": 4}, {"id": 6000009004, "chapter_id": 10009, "verse_number": "१-९-३", "content_sanskrit": "अहो मे पश्यताज्ञानं हृदि रूढं दुरात्मनः।\nपारक्यस्यैव देहस्य बह्व्यो मेऽक्षौहिणीर्हताः॥ १/९/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.004.m4a", "display_order": 5}, {"id": 6000009005, "chapter_id": 10009, "verse_number": "१-९-४", "content_sanskrit": "न मे स्यान्निरयान्मोक्षो ह्यपि वर्षायुतायुतैः।\nबालद्विजसुहृन्मित्रपितृभ्रातृगुरुद्रुहः॥ १/९/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.005.m4a", "display_order": 6}, {"id": 6000009006, "chapter_id": 10009, "verse_number": "१-९-५", "content_sanskrit": "नैनो राज्ञः प्रजाभर्तुर्धर्मो युद्धे वधो द्विषाम्।\nइति मे न तु बोधाय कल्पते शाश्‍वतं वचः॥ १/९/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.006.m4a", "display_order": 7}, {"id": 6000009007, "chapter_id": 10009, "verse_number": "१-९-६", "content_sanskrit": "स्‍त्रीणां मद्धतबन्धूनां द्रोहो योऽसाविहान्वितः।\nकर्मभिर्हयमेधीयैर्नाहं कल्यो व्यपोहितुम्॥ १/९/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.007.m4a", "display_order": 8}, {"id": 6000009008, "chapter_id": 10009, "verse_number": "१-९-७", "content_sanskrit": "यथा पङ्केन पङ्काम्भः सुरया वा सुरा कृतम्।\nभूतहत्यां तथैवैतां न यज्ञो मार्ष्‍टुमर्हति॥ १/९/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.008.m4a", "display_order": 9}, {"id": 6000009009, "chapter_id": 10009, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.009.m4a", "display_order": 10}, {"id": 6000009010, "chapter_id": 10009, "verse_number": "१-९-८", "content_sanskrit": "इति भीतः प्रजाद्रोहात्सर्वधर्मविवित्सया।\nततो विशसनं प्रायाद्यत्र देवव्रतोऽपतत्॥ १/९/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.010.m4a", "display_order": 11, "topics": [{"text": "श्रीकृष्णादिभिः सहितेन युधिष्‍ठिरेण भीष्मसमीपगमनम्", "range": "८–१८"}]}, {"id": 6000009011, "chapter_id": 10009, "verse_number": "१-९-९", "content_sanskrit": "तदा तद्भ्रातरः सर्वे सदश्‍वैस्स्वर्णभूषितैः।\nअन्वगच्छन्रथैर्विप्राः व्यासधौम्यादयस्तथा॥ १/९/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.011.m4a", "display_order": 12}, {"id": 6000009012, "chapter_id": 10009, "verse_number": "१-९-१०", "content_sanskrit": "भगवानपि विप्रर्षे रथेन सधनञ्जयः।\nस तैर्व्यरोचत नृपः कुबेर इव गुह्यकैः॥ १/९/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.012.m4a", "display_order": 13}, {"id": 6000009013, "chapter_id": 10009, "verse_number": "१-९-११", "content_sanskrit": "दृष्‍ट्वा निपतितं भूमौ दिवश्‍च्युतमिवामरम्।\nप्रणेमुः पाण्डवाः भीष्मं सानुगाः सहचक्रिणः॥ १/९/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.013.m4a", "display_order": 14}, {"id": 6000009014, "chapter_id": 10009, "verse_number": "१-९-१२", "content_sanskrit": "तत्र ब्रह्मर्षयः सर्वे देवर्षयश्‍च सत्तम।\nराजर्षयश्‍च तत्रासन्द्रष्‍टुं भरतपुङ्गवम्॥ १/९/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.014.m4a", "display_order": 15}, {"id": 6000009015, "chapter_id": 10009, "verse_number": "१-९-१३", "content_sanskrit": "पर्वतो नारदो धौम्यः भगवान्बादरायणः।\nबृहदश्‍वो भरद्वाजः सशिष्यो रेणुकासुतः॥ १/९/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.015.m4a", "display_order": 16}, {"id": 6000009016, "chapter_id": 10009, "verse_number": "१-९-१४", "content_sanskrit": "वसिष्‍ठ इन्द्रप्रमदस्‍त्रितो गृत्समदोऽसितः।\nकक्षीवान् गौतमोऽत्रिश्‍च कौशिकोऽथ सुदर्शनः॥ १/९/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.016.m4a", "display_order": 17}, {"id": 6000009017, "chapter_id": 10009, "verse_number": "१-९-१५", "content_sanskrit": "अन्ये च मुनयो ब्रह्मन्ब्रह्मरातादयोऽमलाः।\nशिष्यैरुपेता आजग्मुः कश्यपाङ्गिरसादयः॥ १/९/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.017.m4a", "display_order": 18}, {"id": 6000009018, "chapter_id": 10009, "verse_number": "१-९-१६", "content_sanskrit": "तान् समेतान् महाभाग उपलभ्य वसूत्तमः।\nपूजयामास धर्मज्ञो देशकालविभागवित्॥ १/९/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.018.m4a", "display_order": 19}, {"id": 6000009019, "chapter_id": 10009, "verse_number": "१-९-१७", "content_sanskrit": "कृष्णं ‍च तत्प्रभावज्ञ आसीनं जगदीश्‍वरम्।\nहृदिस्थं पूजयामास माययोपात्तविग्रहम्॥ १/९/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.019.m4a", "display_order": 20}, {"id": 6000009020, "chapter_id": 10009, "verse_number": "१-९-१८", "content_sanskrit": "पाण्डुपुत्रान् उपासीनान् प्रश्रयप्रेमसन्नतान्।\nअभ्याचष्‍टानुरागास्रैरन्धीभूतेन चक्षुषा॥ १/९/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.020.m4a", "display_order": 21}, {"id": 6000009021, "chapter_id": 10009, "verse_number": null, "content_sanskrit": "भीष्म उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.021.m4a", "display_order": 22}, {"id": 6000009022, "chapter_id": 10009, "verse_number": "१-९-१९", "content_sanskrit": "अहो कष्‍टमहोऽन्याय्यं यद्यूयं धर्मनन्दन।\nजीवितुं नार्हथ क्लिष्‍टं विप्रधर्माच्युताश्रयाः॥ १/९/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.022.m4a", "display_order": 23, "topics": [{"text": "भीष्मेण युधिष्‍ठिरादीन् प्रति नानाविधधर्मोपदेशः", "range": "१९–३८"}]}, {"id": 6000009023, "chapter_id": 10009, "verse_number": "१-९-२०", "content_sanskrit": "संस्थितेऽतिरथे पाण्डौ पृथा बालप्रजावधूः।\nयुष्मत्कृते बहून्क्लेशान्प्राप्‍ता तोकवती यथा॥ १/९/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.023.m4a", "display_order": 24}, {"id": 6000009024, "chapter_id": 10009, "verse_number": "१-९-२१", "content_sanskrit": "सर्वं कालकृतं मन्ये भवताञ्च यदप्रियम्।\nस कालो यद्वशे लोको वायोरिव घनावलिः॥ १/९/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.024.m4a", "display_order": 25}, {"id": 6000009025, "chapter_id": 10009, "verse_number": "१-९-२२", "content_sanskrit": "यत्र धर्मसुतो राजा गदापाणिर्वृकोदरः।\nकृष्णोऽस्‍त्री गाण्डिवं चापं सुहृत्कृष्णस्ततो विपत्॥ १/९/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.025.m4a", "display_order": 26}, {"id": 6000009026, "chapter_id": 10009, "verse_number": "१-९-२३", "content_sanskrit": "न ह्यस्य कर्हिचिद्राजन्पुमान्वेद विधित्सितम्।\nयद्विजिज्ञासया युक्‍ताः मुह्यन्ति कवयोऽपि हि॥ १/९/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.026.m4a", "display_order": 27}, {"id": 6000009027, "chapter_id": 10009, "verse_number": "१-९-२४", "content_sanskrit": "तस्माज्जगद्दैवतन्त्रं व्यवस्य भरतर्षभ।\nतस्यानुविहितोऽनाथा नाथ पाहि प्रजाः प्रभो॥ १/९/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.027.m4a", "display_order": 28}, {"id": 6000009028, "chapter_id": 10009, "verse_number": "१-९-२५", "content_sanskrit": "एष वै भगवान्साक्षादाद्यो नारायणः पुमान्।\nमोहयन्मायया लोकं गूढश्‍चरति वृष्णिषु॥ १/९/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.028.m4a", "display_order": 29}, {"id": 6000009029, "chapter_id": 10009, "verse_number": "१-९-२६", "content_sanskrit": "अस्यानुभावं भगवान्वेद गुह्यतमं शिवः।\nदेवर्षिर्नारदः साक्षाद्भगवान् कपिलो नृप॥ १/९/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.029.m4a", "display_order": 30}, {"id": 6000009030, "chapter_id": 10009, "verse_number": "१-९-२७", "content_sanskrit": "यं मन्यसे मातुलेयं प्रियं मित्रं सुहृत्तमम्।\nअकरोः सचिवं दूतं सौहृदादथ सारथिम्॥ १/९/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.030.m4a", "display_order": 31}, {"id": 6000009031, "chapter_id": 10009, "verse_number": "१-९-२८", "content_sanskrit": "सर्वात्मनः समदृशो ह्यद्वयस्यानहङ्कृतेः।\nतत्कृतं मतिवैषम्यं निरवद्यस्य न क्‍वचित्॥ १/९/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.031.m4a", "display_order": 32}, {"id": 6000009032, "chapter_id": 10009, "verse_number": "१-९-२९", "content_sanskrit": "तथाऽप्येकान्तभक्‍तेषु पश्य भूपानुकम्पितम्।\nयन्मेऽसूंस्त्यजतः साक्षात्कृष्णो दर्शनमागतः॥ १/९/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.032.m4a", "display_order": 33}, {"id": 6000009033, "chapter_id": 10009, "verse_number": "१-९-३०", "content_sanskrit": "भक्‍त्याऽऽवेश्य मनो यस्मिन् वाचा यन्नाम कीर्तयन्।\nत्यजन्कलेवरं योगी मुच्यते कामकर्मभिः॥ १/९/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.033.m4a", "display_order": 34}, {"id": 6000009034, "chapter_id": 10009, "verse_number": "१-९-३१", "content_sanskrit": "स देवदेवो भगवान्प्रतीक्षतां कलेवरं यावदिदं हिनोम्यहम्।\nप्रसन्नहासारुणलोचनोल्‍लसन्मुखाम्बुजो ध्यानपथश्‍चतुर्भुजः॥ १/९/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.034.m4a", "display_order": 35}, {"id": 6000009035, "chapter_id": 10009, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.035.m4a", "display_order": 36}, {"id": 6000009036, "chapter_id": 10009, "verse_number": "१-९-३२", "content_sanskrit": "युधिष्‍ठिरस्तदाकर्ण्य शयानं शरपञ्जरे।\nअपृच्छद्विविधान् धर्मान् ऋषीणामनुशृण्वताम्॥ १/९/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.036.m4a", "display_order": 37}, {"id": 6000009037, "chapter_id": 10009, "verse_number": "१-९-३३", "content_sanskrit": "पुरुषस्वभावविहितान्यथावर्णं यथाश्रमम्।\nवैराग्यरागोपाधिभ्यामाम्नातोभयलक्षणान्॥ १/९/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.037.m4a", "display_order": 38}, {"id": 6000009038, "chapter_id": 10009, "verse_number": "१-९-३४", "content_sanskrit": "दानधर्मान्राजधर्मान्मोक्षधर्मान्विभागशः।\nस्‍त्रीधर्मान्भगवद्धर्मान्समासव्यासयोगतः॥ १/९/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.038.m4a", "display_order": 39}, {"id": 6000009039, "chapter_id": 10009, "verse_number": "१-९-३५", "content_sanskrit": "धर्मार्थकाममोक्षांश्‍च सहोपायान्यथा मुने।\nनानाख्यानेतिहासेषु वर्णयामास तत्त्ववित्॥ १/९/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.039.m4a", "display_order": 40}, {"id": 6000009040, "chapter_id": 10009, "verse_number": "१-९-३६", "content_sanskrit": "धर्मान्प्रवदतस्तस्य स कालः प्रत्युपस्थितः।\nयो योगिनः छन्दमृत्योर्वाञ्छितस्तूत्तरायणः॥ १/९/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.040.m4a", "display_order": 41}, {"id": 6000009041, "chapter_id": 10009, "verse_number": "१-९-३७", "content_sanskrit": "तदोपसंहृत्य गिरं सहस्रणीर्विमुक्‍तसङ्गं मन आदिपूरुषे।\nकृष्णे लसत्पीतपटे चतुर्भुजे पुरःस्थितेऽमीलितदृग्व्यधारयन्॥ १/९/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.041.m4a", "display_order": 42}, {"id": 6000009042, "chapter_id": 10009, "verse_number": "१-९-३८", "content_sanskrit": "विशुद्धया धारणया धुताशुभस्तदीक्षयैवाशु गतायुधव्यथः।\nनिवृत्तसर्वेन्द्रियवृत्तिविभ्रमः तुष्‍टाव जल्पं विसृजञ्जनार्दनम्॥ १/९/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.042.m4a", "display_order": 43}, {"id": 6000009043, "chapter_id": 10009, "verse_number": null, "content_sanskrit": "भीष्म उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.043.m4a", "display_order": 44}, {"id": 6000009044, "chapter_id": 10009, "verse_number": "१-९-३९", "content_sanskrit": "इति मतिरुपकल्पिता वितृष्णा भगवति सात्वतपुङ्गवे विभूम्नि।\nस्वसुख उपगते क्‍वचिद्विहर्तुं प्रकृतिमुपेयुषि यद्भवप्रवाहः॥ १/९/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.044.m4a", "display_order": 45, "topics": [{"text": "श्रीकृष्णस्तवनपूर्वकं निजशरीरत्यागश्‍च", "range": "३९–५०"}]}, {"id": 6000009045, "chapter_id": 10009, "verse_number": "१-९-४०", "content_sanskrit": "त्रिभुवनकमनं तमालवर्णं रविकरगौरवराम्बरं दधाने।\nवपुरलककुलावृताननाब्जं विजयसखे रतिरस्तु मेऽनवद्या॥ १/९/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.045.m4a", "display_order": 46}, {"id": 6000009046, "chapter_id": 10009, "verse_number": "१-९-४१", "content_sanskrit": "युधि तुरगरजोविधूम्रविध्यत्कचलुलितश्रमवार्यलंकृतास्ये।\nमम निशितशरैर्विभिद्यमानत्वचि विलसत्कवचेऽस्तु कृष्ण आत्मा॥ १/९/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.046.m4a", "display_order": 47}, {"id": 6000009047, "chapter_id": 10009, "verse_number": "१-९-४२", "content_sanskrit": "सपदि सखिवचो निशम्य मध्ये निजपरयोर्बलयो रथं निवेश्य।\nस्थितवति परसैनिकायुरक्ष्णा हृतवति पार्थसखे रतिर्ममास्तु॥ १/९/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.047.m4a", "display_order": 48}, {"id": 6000009048, "chapter_id": 10009, "verse_number": "१-९-४३", "content_sanskrit": "व्यवसितपृतनामुखं निरीक्ष्य स्वजनवधाद्विमुखस्य दोषबुद्ध्या।\nकुमतिमहरदात्मविद्यया यश्‍चरणरतिः परमस्य तस्य मेऽस्तु॥ १/९/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.048.m4a", "display_order": 49}, {"id": 6000009049, "chapter_id": 10009, "verse_number": "१-९-४४", "content_sanskrit": "स्वनियममपहाय मत्प्रतिज्ञामृतमधिकर्तुमवप्लुतो रथस्थः।\nधृतरथचरणोऽभ्ययाद् बलाग्रे हरिरिव हन्तुमिभं गतोत्तरीयः॥ १/९/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.049.m4a", "display_order": 50}, {"id": 6000009050, "chapter_id": 10009, "verse_number": "१-९-४५", "content_sanskrit": "शितविशिखहतो विशीर्णदंसः क्षतजपरिप्लुत आततायिनो मे।\nप्रसभमभिससार मद्वधार्थं स भवतु मे भगवान् मुदे मुकुन्दः॥ १/९/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.050.m4a", "display_order": 51}, {"id": 6000009051, "chapter_id": 10009, "verse_number": "१-९-४६", "content_sanskrit": "विजयरथकुटुम्ब आत्ततोत्रे धृतहयरश्मिजितश्रमेक्षणीये।\nभगवति रतिरस्तु मे मुमूर्षोर्यमिह निरीक्ष्य हता गताः स्वरूपम्॥ १/९/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.051.m4a", "display_order": 52}, {"id": 6000009052, "chapter_id": 10009, "verse_number": "१-९-४७", "content_sanskrit": "ललितगतिविलासवल्गुहासप्रणयनिरीक्षणकल्पितोरुमानाः।\nकृतमनुकृतवत्य उन्मदान्धाः प्रकृतिमगुः किल यस्य गोपवध्वः॥ १/९/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.052.m4a", "display_order": 53}, {"id": 6000009053, "chapter_id": 10009, "verse_number": "१-९-४८", "content_sanskrit": "मुनिगणनृपवर्यसंकुलेऽन्तःसदसि युधिष्‍ठिरराजसूय एषाम्।\nअर्हणमभिपेद ईक्षणीयो मम दृशिगोचर एष आविरात्मा॥ १/९/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.053.m4a", "display_order": 54}, {"id": 6000009054, "chapter_id": 10009, "verse_number": "१-९-४९", "content_sanskrit": "तमिममहमजं शरीरभाजां हृदि हृदि विष्‍ठितमात्मकल्पितानाम्।\nप्रतिदृशमिव नैकधाऽर्कमेकं समधिगतोऽस्मि विधूतभेदमोहः॥ १/९/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.054.m4a", "display_order": 55}, {"id": 6000009055, "chapter_id": 10009, "verse_number": "१-९-५०", "content_sanskrit": "क्षितिभरमवरोपितुं कुरूणां श्‍वसन इवासृजदक्षवंशवह्निम्।\nतमिममजमनुव्रतार्तिहाङ्घ्रिं हृदि परिरभ्य जहामि मर्त्यनीडम्॥ १/९/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.055.m4a", "display_order": 56}, {"id": 6000009056, "chapter_id": 10009, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.056.m4a", "display_order": 57}, {"id": 6000009057, "chapter_id": 10009, "verse_number": "१-९-५१", "content_sanskrit": "कृष्ण एवं भगवति मनोवाग्दृष्‍टिवृत्तिभिः।\nआत्मन्यात्मानमावेश्य सोऽन्तःश्‍वास उपारमत्॥ १/९/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.057.m4a", "display_order": 58, "topics": [{"text": "भीष्मं संस्कृत्य नगरमागतेन युधिष्‍ठिरेण श्रीकृष्णधृतराष्‍ट्रानुमत्या नीत्या प्रजापालनम्", "range": "५१–५७"}]}, {"id": 6000009058, "chapter_id": 10009, "verse_number": "१-९-५२", "content_sanskrit": "संपद्यमानमाज्ञाय भीष्मं ब्रह्मणि निष्कले।\nसर्वे बभूवुस्ते तूष्णीं वयांसीव दिनात्यये॥ १/९/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.058.m4a", "display_order": 59}, {"id": 6000009059, "chapter_id": 10009, "verse_number": "१-९-५३", "content_sanskrit": "तत्र दुन्दुभयो नेदुः देवगन्धर्वनादिताः।\nशशंसुः साधवो ब्रह्मन् खात्पेतुः पुष्पवृष्‍टयः॥ १/९/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.059.m4a", "display_order": 60}, {"id": 6000009060, "chapter_id": 10009, "verse_number": "१-९-५४", "content_sanskrit": "तस्य निर्हरणादीनि संपरेतस्य भार्गव।\nयुधिष्‍ठिरः कारयित्वा मुहूर्तं दुःखितोऽभवत्॥ १/९/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.060.m4a", "display_order": 61}, {"id": 6000009061, "chapter_id": 10009, "verse_number": "१-९-५५", "content_sanskrit": "तुष्‍टुवुर्मुनयो हृष्‍टाः कृष्णं तद्गुह्यनामभिः।\nततस्ते कृष्णहृदयाः स्वाश्रमान्प्रययुः पुनः॥ १/९/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.061.m4a", "display_order": 62}, {"id": 6000009062, "chapter_id": 10009, "verse_number": "१-९-५६", "content_sanskrit": "ततो युधिष्‍ठिरो गत्वा सकृष्णो गजसाह्वयम्।\nपितरं सान्त्वयामास गान्धारीं ‍च तपस्विनीम्॥ १/९/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.062.m4a", "display_order": 63}, {"id": 6000009063, "chapter_id": 10009, "verse_number": "१-९-५७", "content_sanskrit": "पित्रा चानुमतो राजा वासुदेवानुमोदितः।\nचकार राज्यं धर्मेण पितृपैतामहं विभुः॥ १/९/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_009/BhP_01.009.063.m4a", "display_order": 64}, {"id": 6000009064, "chapter_id": 10009, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां प्रथमस्कन्धे नवमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]