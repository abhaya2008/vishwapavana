[{"id": 7000622000, "chapter_id": 20622, "verse_number": "५-८१-१", "content_sanskrit": "ऋषय ऊचु ।\nसूत जीव चिरं साधो श्रीकृष्णचरितामृतम् ।\nत्वया प्रकाशितं सर्वं भक्तानां भवतारणम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000622001, "chapter_id": 20622, "verse_number": "५-८१-२", "content_sanskrit": "श्रीकृष्णलीलां निखिलां ब्रूहि दैनंदिनीं प्रभो ।\nययाकर्णितया साधो कृष्णे भक्तिर्विवर्द्धते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000622002, "chapter_id": 20622, "verse_number": "५-८१-३", "content_sanskrit": "गुरोः शिष्यस्य मंत्रस्य विधानं लक्षणं पृथक् ।\nवदास्माकं महाभाग त्वं हि नः परमः सुहृत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000622003, "chapter_id": 20622, "verse_number": "५-८१-४", "content_sanskrit": "सूत उवाच ।\nएकदा यमुनातीरे समासीनं जगद्गुरुम् ।\nनारदः प्रणिपत्याह देवदेवं सदाशिवम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000622004, "chapter_id": 20622, "verse_number": "५-८१-५", "content_sanskrit": "नारद उवाच ।\nदेवदेव महादेव सर्वज्ञ जगदीश्वर ।\nभगवद्धर्मतत्त्वज्ञ कृष्णमंत्रविदां वर ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000622005, "chapter_id": 20622, "verse_number": "५-८१-६", "content_sanskrit": "कृष्णमंत्रा मया लब्धास्त्वत्तो ये च पितुः परे ।\nते सर्वे साधितास्तत्वान्मंत्रराजादयो मया ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000622006, "chapter_id": 20622, "verse_number": "५-८१-७", "content_sanskrit": "बहुवर्षसहस्रैस्तु शाकमूलफलाशिना ।\nशुष्कपर्णांबुवाय्वादि भोजिना च निराशिना ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000622007, "chapter_id": 20622, "verse_number": "५-८१-८", "content_sanskrit": "स्त्रीणां संदर्शनालापवर्जिना भूमिशायिना ।\nकामादिषड्गुणं जित्वा बाह्येंद्रियनियम्यता ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000622008, "chapter_id": 20622, "verse_number": "५-८१-९", "content_sanskrit": "एवंकृतेऽपि नैवात्मा संतुष्टो मम शंकर ।\nतद्ब्रूहि यत्प्रसिध्येत संस्काराद्यैर्विना प्रभो ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000622009, "chapter_id": 20622, "verse_number": "५-८१-१०", "content_sanskrit": "सकृदुच्चारणादेव ददाति फलमुत्तमम् ।\nयदि योग्योऽस्मि देवेश तदा मे कृपया वद ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000622010, "chapter_id": 20622, "verse_number": "५-८१-११", "content_sanskrit": "शिव उवाच ।\nसाधु पृष्टं महाभाग त्वया लोकहितैषिणा ।\nसुगोप्यमपि वक्ष्यामि मंत्रचिंतामणिं तव ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000622011, "chapter_id": 20622, "verse_number": "५-८१-१२", "content_sanskrit": "रहस्यानां रहस्यं यद्गुह्यानां गुह्यमुत्तमम् ।\nन मया कथितं देव्यै नाग्रजेभ्यः पुरा तव ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000622012, "chapter_id": 20622, "verse_number": "५-८१-१३", "content_sanskrit": "वक्ष्यामि युगलं तुभ्यं कृष्णमंत्रमनुत्तमम् ।\nमंत्रचिंतामणिर्नाम युगलं द्वयमेव च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000622013, "chapter_id": 20622, "verse_number": "५-८१-१४", "content_sanskrit": "पर्याया अस्य मंत्रस्य तथा पंचपदीति च ।\nगोपीजनपदं वल्लभां तं तु चरणानिति ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000622014, "chapter_id": 20622, "verse_number": "५-८१-१५", "content_sanskrit": "शरणं च प्रपद्ये च एष पंचपदात्मकः ।\nमंत्रचिंतामणिः प्रोक्तः षोडशार्णो महामनुः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000622015, "chapter_id": 20622, "verse_number": "५-८१-१६", "content_sanskrit": "नमो गोपीजनेत्युक्त्वा वल्लभाभ्यां वदेत्ततः ।\nपदद्वयात्मको मंत्रो दशार्णः खलु कथ्यते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000622016, "chapter_id": 20622, "verse_number": "५-८१-१७", "content_sanskrit": "एतां पंचपदीं जप्त्वा श्रद्धयाश्रद्धया सकृत् ।\nकृष्णप्रियाणां सान्निध्यं गच्छत्येव न संशयः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000622017, "chapter_id": 20622, "verse_number": "५-८१-१८", "content_sanskrit": "न पुरश्चरणप्रेक्षा नास्य न्यासविधिक्रमः ।\nन देशकालनियमो नारिमित्रादिशोधनम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000622018, "chapter_id": 20622, "verse_number": "५-८१-१९", "content_sanskrit": "सर्वेऽधिकारिणश्चात्र चंडालांता मुनीश्वर ।\nस्त्रियः शूद्रादयश्चापि जडमूकादि पंगवः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000622019, "chapter_id": 20622, "verse_number": "५-८१-२०", "content_sanskrit": "अन्ये हूणाः किराताश्च पुलिंदाः पुष्कसास्तथा ।\nआभीराय वनाः कंकाः खसाद्याः पापयोनयः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000622020, "chapter_id": 20622, "verse_number": "५-८१-२१", "content_sanskrit": "दंभाहंकारपरमाः पापाः पैशुन्यतत्पराः ।\nगोब्राह्मणादि हंतारो महोपपातकान्विताः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000622021, "chapter_id": 20622, "verse_number": "५-८१-२२", "content_sanskrit": "ज्ञानवैराग्यरहिताः श्रवणादिविवर्जिताः ।\nएते चान्ये च सर्वे स्युर्मनोरस्याधिकारिणः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000622022, "chapter_id": 20622, "verse_number": "५-८१-२३", "content_sanskrit": "यदि भक्तिर्भवेदेषां कृष्णे सर्वेश्वरेश्वरे ।\nतदाधिकारिणः सर्वे नान्यथा मुनिसत्तम ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000622023, "chapter_id": 20622, "verse_number": "५-८१-२४", "content_sanskrit": "याज्ञिको दाननिरतः सर्वतंत्रोपसेवकः ।\nसत्यवादी यतिर्वापि वेदवेदांगपारगः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000622024, "chapter_id": 20622, "verse_number": "५-८१-२५", "content_sanskrit": "ब्रह्मनिष्ठः कुलीनो वा तपस्वी व्रततत्परः ।\nअत्राधिकारी न भवेत्कृष्णभक्तिविवर्जितः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000622025, "chapter_id": 20622, "verse_number": "५-८१-२६", "content_sanskrit": "तस्मादकृष्णभक्ताय कृतघ्नाय न मानिने ।\nन च श्रद्धाविहीनाय वक्तव्यं नास्तिकाय च ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000622026, "chapter_id": 20622, "verse_number": "५-८१-२७", "content_sanskrit": "न चाशुश्रूषवे वाच्यं नासंवत्सरसेविने ।\nश्रीकृष्णेऽनन्यभक्ताय दंभलोभविवर्जिने ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000622027, "chapter_id": 20622, "verse_number": "५-८१-२८", "content_sanskrit": "कामक्रोधविमुक्ताय देयमेतत्प्रयत्नतः ।\nऋषिश्चैवाहमेतस्य गायत्रीछंद उच्यते ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000622028, "chapter_id": 20622, "verse_number": "५-८१-२९", "content_sanskrit": "देवता बल्लवीकांतो मंत्रस्य परिकीर्तितः ।\nसप्रियस्य हरेर्दास्ये विनियोग उदाहृतः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000622029, "chapter_id": 20622, "verse_number": "५-८१-३०", "content_sanskrit": "आचक्राद्यैस्तथा मंत्रैः पंचांगानि प्रकल्पयेत् ।\nअथवापि स्वबीजेन करांगन्यासकौ चरेत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000622030, "chapter_id": 20622, "verse_number": "५-८१-३१", "content_sanskrit": "मंत्रस्य प्रथमो वर्णो बिंदुना मूर्ध्निभूषितः ।\nगमित्येवं भवेद्बीजं नमः शक्तिरिहोदिता ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000622031, "chapter_id": 20622, "verse_number": "५-८१-३२", "content_sanskrit": "अंतिमार्णैर्दशांगानि तैरेव च तथार्चनम् ।\nगंधपुष्पादिभिस्तच्च जलैरेवाप्यसंभवे ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000622032, "chapter_id": 20622, "verse_number": "५-८१-३३", "content_sanskrit": "न्यासपूर्वविधानेन कर्तव्यं हरितुष्टये ।\nअतएवास्य मंत्रस्य न्यासाद्यन्ये वदंति च ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000622033, "chapter_id": 20622, "verse_number": "५-८१-३४", "content_sanskrit": "सकृदुच्चारणादेव कृतकृत्यत्वदायिनः ।\nतथापि दशधा नित्यं जपाद्यर्थं प्रविन्यसेत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000622034, "chapter_id": 20622, "verse_number": "५-८१-३५", "content_sanskrit": "अथ ध्यानं प्रवक्ष्यामि मंत्रस्यास्य द्विजोत्तम ।\nपीतांबरं घनश्यामं द्विभुजं वनमालिनम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000622035, "chapter_id": 20622, "verse_number": "५-८१-३६", "content_sanskrit": "बर्हिबर्हकृतोत्तंसं शशिकोटिनिभाननम् ।\nघूर्णायमाननयनं कर्णिकारावतंसिनम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000622036, "chapter_id": 20622, "verse_number": "५-८१-३७", "content_sanskrit": "अभितश्चंदनेनाथ मध्ये कुंकुमबिंदुना ।\nरचितं तिलकं भाले बिभ्रतं मंडलाकृतिम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000622037, "chapter_id": 20622, "verse_number": "५-८१-३८", "content_sanskrit": "तरुणादित्यसंकाशं कुंडलाभ्यां विराजितम् ।\nघर्माम्बुकणिकाराजद्दर्पणाभकपोलकम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000622038, "chapter_id": 20622, "verse_number": "५-८१-३९", "content_sanskrit": "प्रियास्य न्यस्तनयनं लीलापांगोन्नतभ्रुवम् ।\nअग्रभागन्यस्तमुक्ता विस्फुरत्प्रोच्चनासिकम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000622039, "chapter_id": 20622, "verse_number": "५-८१-४०", "content_sanskrit": "दशनज्योत्स्नया राजत्पक्वबिंबफलाधरम् ।\nकेयूरांगदसद्रत्नमुद्रिकाभिर्लसत्करम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000622040, "chapter_id": 20622, "verse_number": "५-८१-४१", "content_sanskrit": "बिभ्रतं मुरलद्यं वामे पाणौ पद्मं तथैव च ।\nकांचीदामस्फुरन्मध्यं नूपुराभ्यां लसत्पदम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000622041, "chapter_id": 20622, "verse_number": "५-८१-४२", "content_sanskrit": "रतिकेलिरसावेश चपलं चपलेक्षणम् ।\nहसंतं प्रियया सार्द्धं हासयंतं च तां मुहुः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000622042, "chapter_id": 20622, "verse_number": "५-८१-४३", "content_sanskrit": "इत्थं कल्पतरोर्मूले रत्नसिंहासनोपरि ।\nवृंदारण्ये स्मरेत्कृष्णं संस्थितं प्रियया सह ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000622043, "chapter_id": 20622, "verse_number": "५-८१-४४", "content_sanskrit": "वामपार्श्वे स्थितां तस्य राधिकां च स्मरेत्ततः ।\nनीलचोलकसंवीतां तप्तहेमसमप्रभाम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000622044, "chapter_id": 20622, "verse_number": "५-८१-४५", "content_sanskrit": "पट्टांचलेनावृतार्द्ध सुस्मेराननपंकजाम् ।\nकांतवक्त्रे न्यस्तनेत्रां चकोरी चंचलेक्षणाम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000622045, "chapter_id": 20622, "verse_number": "५-८१-४६", "content_sanskrit": "अंगुष्ठतर्जनीभ्यां च निजकांतमुखांबुजे ।\nअर्पयंतीं पूगफलं पर्णचूर्णसमन्वितम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000622046, "chapter_id": 20622, "verse_number": "५-८१-४७", "content_sanskrit": "मुक्ताहारस्फुरच्चारु पीनोन्नतपयोधराम् ।\nक्षीणमध्यां पृथुश्रोणीं किंकिणीजालमंडिताम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000622047, "chapter_id": 20622, "verse_number": "५-८१-४८", "content_sanskrit": "रत्नताटंककेयूरमुद्रा वलयधारिणीम् ।\nरणत्कटकमंजीर रत्नपादांगुलीयकाम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000622048, "chapter_id": 20622, "verse_number": "५-८१-४९", "content_sanskrit": "लावण्यसारमुग्धांगीं सर्वावयवसुंदरीम् ।\nआनंदरससंमग्नां प्रसन्नां नवयौवनाम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000622049, "chapter_id": 20622, "verse_number": "५-८१-५०", "content_sanskrit": "सख्यश्च तस्या विप्रेंद्र तत्समानवयोगुणाः ।\nतत्सेवनपराभाव्याश्चामरव्यजनादिभिः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000622050, "chapter_id": 20622, "verse_number": "५-८१-५१", "content_sanskrit": "अथ तुभ्यं प्रवक्ष्यामि मंत्रार्थं शृणु नारद ।\nबहिरंगैः प्रपंचस्य स्वांशैर्मायादि शक्तिभिः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000622051, "chapter_id": 20622, "verse_number": "५-८१-५२", "content_sanskrit": "अंतरंगैस्तथा नित्यविभूतैस्तैश्चिदादिभिः ।\nगोपनादुच्यते गोपी राधिका कृष्णवल्लभा ।\nदेवी कृष्णमयी प्रोक्ता राधिका परदेवता ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000622052, "chapter_id": 20622, "verse_number": "५-८१-५३", "content_sanskrit": "सर्वलक्ष्मीस्वरूपा सा कृष्णाह्लादस्वरूपिणी ।\nततः सा प्रोच्यते विप्र ह्लादिनीति मनीषिभिः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000622053, "chapter_id": 20622, "verse_number": "५-८१-५४", "content_sanskrit": "तत्कलाकोटिकोट्यंश दुर्गाद्यास्त्रिगुणात्मिकाः ।\nसा तु साक्षान्महालक्ष्मीः कृष्णो नारायणः प्रभुः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000622054, "chapter_id": 20622, "verse_number": "५-८१-५५", "content_sanskrit": "नैतयोर्विद्यते भेदः स्वल्पोऽपि मुनिसत्तम ।\nइयं दुर्गा हरी रुद्रः कृष्णः शक्र इयं शची ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000622055, "chapter_id": 20622, "verse_number": "५-८१-५६", "content_sanskrit": "सावित्रीयं हरिर्ब्रह्मा धूमोर्णासौ यमो हरिः ।\nबहुना किं मुनिश्रेष्ठ विना ताभ्यां न किंचन ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000622056, "chapter_id": 20622, "verse_number": "५-८१-५७", "content_sanskrit": "चिदचिल्लक्षणं सर्वं राधाकृष्णमयं जगत् ।\nइत्थं सर्वं तयोरेव विभूतिं विद्धि नारद ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000622057, "chapter_id": 20622, "verse_number": "५-८१-५८", "content_sanskrit": "न शक्यते मया वक्तुं वर्षकोटिशतैरपि ।\nत्रैलोक्ये पृथिवी मान्या जंबूद्वीपं ततोवरम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000622058, "chapter_id": 20622, "verse_number": "५-८१-५९", "content_sanskrit": "तत्रापि भारतं वर्षं तत्रापि मथुरापुरी ।\nतत्र वृंदावनं नाम तत्र गोपीकदंबकम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000622059, "chapter_id": 20622, "verse_number": "५-८१-६०", "content_sanskrit": "तत्र राधासखीवर्गस्तत्रापि राधिका वरा ।\nसांनिध्याधिक्यतस्तस्या आधिक्यं स्याद्यथोत्तरम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000622060, "chapter_id": 20622, "verse_number": "५-८१-६१", "content_sanskrit": "पृथिवी प्रभृतीनां तु नान्यत्किंचिदिहोदितम् ।\nसैषा हि राधिका गोपी जनस्तस्याः सखीगणः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000622061, "chapter_id": 20622, "verse_number": "५-८१-६२", "content_sanskrit": "तस्याः सखीसमूहस्य वल्लभौ प्राणनायकौ ।\nराधाकृष्णौ तयोः पादाः शरणं स्यादिहाश्रये ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000622062, "chapter_id": 20622, "verse_number": "५-८१-६३", "content_sanskrit": "प्रपद्ये गतवानस्मि जीवोऽहं भृशदुःखितः ।\nसोऽहं यः शरणं प्राप्तो मम तस्य यदस्ति च ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000622063, "chapter_id": 20622, "verse_number": "५-८१-६४", "content_sanskrit": "सर्वं ताभ्यां तदर्थं हि तद्भोग्यं न ह्यहं मम ।\nइत्यसौ कथितो विप्र मंत्रस्यार्थः समासतः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000622064, "chapter_id": 20622, "verse_number": "५-८१-६५", "content_sanskrit": "युगलार्थस्तथा न्यासः प्रपत्तिः शरणागतिः ।\nआत्मार्पणमिमे पंच पर्यायास्ते मयोदिताः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000622065, "chapter_id": 20622, "verse_number": "५-८१-६६", "content_sanskrit": "अयमेव चिंतनीयो दिवानक्तमतंद्रितैः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]