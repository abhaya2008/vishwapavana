[{"id": 7003515000, "chapter_id": 23515, "verse_number": "१५५-१", "content_sanskrit": "अथाऽक्रूरतीर्थप्रभावः ।\nश्रीवराह उवाच ।\nपुनरन्यत्प्रवक्ष्यामि मर्त्त्यलोके सुदुर्लभम् ।\nअनन्तं विदितं तीर्थमचलं ध्रुवमव्ययम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003515001, "chapter_id": 23515, "verse_number": "१५५-२", "content_sanskrit": "तत्र .नित्यं स्थितो देवि लोकानां हितकाम्यया ।\nमां दृष्ट्वा मनुजा देवि मुक्तिभाजो भवन्ति ते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003515002, "chapter_id": 23515, "verse_number": "१५५-३", "content_sanskrit": "अयने विषुवे चैव तथा विष्णुपदीषु च ।\nअनन्तं तं समासाद्य मुच्यते सर्वपातकैः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003515003, "chapter_id": 23515, "verse_number": "१५५-४", "content_sanskrit": "अक्रूरेति च विख्यातं मम क्षेत्रं वसुन्धरे ।\nतत्र स्नात्वा महाभागे राहुग्रस्ते दिवाकरे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003515004, "chapter_id": 23515, "verse_number": "१५५-५", "content_sanskrit": "राजसूयाश्वमेधाभ्यां फलं प्राप्नोति मानवः ।\nतीर्थराजं हि चाक्रूरं गुह्यानां गुह्यमुत्तमम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003515005, "chapter_id": 23515, "verse_number": "१५५-६", "content_sanskrit": "तत्स्नानात्फलमाप्नोति प्रयागस्नानजं फलम् ।\nअस्मिंस्तीर्थे पुरावृत्तं तच्छृणुष्व वसुन्धरे ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003515006, "chapter_id": 23515, "verse_number": "१५५-७", "content_sanskrit": "नाम्ना तु सुधनो नाम मम भक्तः सदैव हि ।\nधनधान्यसमायुक्तः सुतयुक्तः सदैव हि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003515007, "chapter_id": 23515, "verse_number": "१५५-८", "content_sanskrit": "बन्धुपुत्रकलत्रैश्च गृहे प्रीतिरनुत्तमा ।\nपुत्रदारसमेतस्य मयि भक्तिर्वसुन्धरे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003515008, "chapter_id": 23515, "verse_number": "१५५-९", "content_sanskrit": "गच्छन्ति दिवसास्तस्य मासाः संवत्सरास्तथा ।\nकरोति गृहकृत्यानि धनोपायेन नित्यशः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003515009, "chapter_id": 23515, "verse_number": "१५५-१०", "content_sanskrit": "मानकूटं तुलाकूटं न करोति स कर्हिचित् ।\nएवं च वसतस्तस्य बहवो वत्सरा गताः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003515010, "chapter_id": 23515, "verse_number": "१५५-११", "content_sanskrit": "नित्यं कालं च कुरुते हरिपूजनमुत्तमम् ।\nपुष्पदीपप्रदानेन चन्दनेन सुगन्धिना ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003515011, "chapter_id": 23515, "verse_number": "१५५-१२", "content_sanskrit": "उपहारेण दिव्येन धूपेन च सुगन्धिना ।\nएकादश्यां तु कुरुते पक्षयोरुभयोरपि ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003515012, "chapter_id": 23515, "verse_number": "१५५-१३", "content_sanskrit": "उपवासं तु कुरुते रात्रौ जागरणं तथा ।\nस गच्छति यथाकालमक्रूरं तीर्थमुत्तमम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003515013, "chapter_id": 23515, "verse_number": "१५५-१४", "content_sanskrit": "तत्रागत्य ममाग्रेऽसौ नृत्यते शुभदर्शनः ।\nसुधनस्तु वणिक्श्रेष्ठः कदाचिद्रात्रिजागरे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003515014, "chapter_id": 23515, "verse_number": "१५५-१५", "content_sanskrit": "चलमानो गृहीतस्तु चरणे ब्रह्मरक्षसा ।\nकृष्णवर्णी महाकाय ऊर्ध्वकेशो भयंकरः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003515015, "chapter_id": 23515, "verse_number": "१५५-१६", "content_sanskrit": "पादे गृहीत्वा वसुधे इदं वचनमब्रवीत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003515016, "chapter_id": 23515, "verse_number": "१५५-१७", "content_sanskrit": "राक्षसोऽहं वणिक्श्रेष्ठ वसामि वनमाश्रितः ।\nत्वामद्य भक्षयिष्यामि तृप्तिं यास्यामि शाश्वतीम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003515017, "chapter_id": 23515, "verse_number": "१५५-१८", "content_sanskrit": "सुधन उवाच ।\nप्रतीक्षस्व क्षणं मेऽद्य दास्यामि तव पुष्कलम् ।\nभक्षयिष्यसि मे गात्रं मिष्टान्नपरिपोषितम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003515018, "chapter_id": 23515, "verse_number": "१५५-१९", "content_sanskrit": "जागरं देवदेवस्य कर्तुमिच्छामि राक्षस ।\nमम व्रतं सार्वकालं यज्जागर्मि हरेः पुरः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003515019, "chapter_id": 23515, "verse_number": "१५५-२०", "content_sanskrit": "तत्र जागरणं कृत्वा प्रभाते तव सन्निधौ ।\nआगमिष्याम्यहं शीघ्रमादित्योदयनं प्रति ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003515020, "chapter_id": 23515, "verse_number": "१५५-२१", "content_sanskrit": "ततः खादिष्यसे गात्रं विनिवृत्तस्य जागरात् ।\nविष्णुतुष्ट्यै व्रतमिदमारब्धं सर्वकामदम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003515021, "chapter_id": 23515, "verse_number": "१५५-२२", "content_sanskrit": "मा कुरु व्रतभङ्गं मे रक्षो नारायणस्य हि ।\nजागरे विनिवृत्ते तु मां भक्षय यथेप्सितम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003515022, "chapter_id": 23515, "verse_number": "१५५-२३", "content_sanskrit": "सुधनस्य वचः श्रुत्वा ब्रह्मरक्षः क्षुधार्दितः ।\nउवाच मधुरं वाक्यं वणिजं प्रति सादरम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003515023, "chapter_id": 23515, "verse_number": "१५५-२४", "content_sanskrit": "मिथ्या प्रभाषसे साधो त्वं पुनः कथमेष्यसि।\nको हि रक्षोमुखाद्भ्रष्टो मानुषो यो निवर्त्तते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003515024, "chapter_id": 23515, "verse_number": "१५५-२५", "content_sanskrit": "राक्षसस्य वचः श्रुत्वा स वणिग्वाक्यमब्रवीत्।\nसत्यमूलं जगत्सर्वं सर्वं सत्ये प्रतिष्ठितम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003515025, "chapter_id": 23515, "verse_number": "१५५-२६", "content_sanskrit": "सिद्धिं लभन्ते सत्येन ऋषयो वेदपारगाः ।\nयद्यहं च वणिक् पूर्वं कर्मणा न हि दूषितः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003515026, "chapter_id": 23515, "verse_number": "१५५-२७", "content_sanskrit": "प्राप्तश्च मानुषो भावो विहितेनान्तरात्मना ।\nशृणु मत्समयं रक्षो येनाहं पुनरागमम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003515027, "chapter_id": 23515, "verse_number": "१५५-२८", "content_sanskrit": "कृत्वा जागरणं तत्र नृत्यं कृत्वा यथासुखम्।\nपुनरेष्याम्यहं रक्षो नासत्यं विद्यते मयि ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003515028, "chapter_id": 23515, "verse_number": "१५५-२९", "content_sanskrit": "सत्येन दीयते कन्या सत्यं जल्पन्ति ब्राह्मणाः ।\nसत्योत्तीर्णा हि राजानः सत्येन वसुधा धृता ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003515029, "chapter_id": 23515, "verse_number": "१५५-३०", "content_sanskrit": "स्वर्गमिच्छन्ति सत्येन मोक्षः सत्येन लभ्यते।\nसत्येन सूर्यस्तपति सोमः सत्येन राजते ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003515030, "chapter_id": 23515, "verse_number": "१५५-३१", "content_sanskrit": "यमः सत्येन हरति सत्यादिन्द्रो विराजते।\nतत्सत्यं मम नश्येत यद्यहं नागमे पुनः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003515031, "chapter_id": 23515, "verse_number": "१५५-३२", "content_sanskrit": "परदारांस्तु यो गच्छेत्काममोहप्रपीडितः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003515032, "chapter_id": 23515, "verse_number": "१५५-३३", "content_sanskrit": "तस्य पापेन लिप्येऽहं यदि नायामि ते पुरः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003515033, "chapter_id": 23515, "verse_number": "१५५-३४", "content_sanskrit": "दत्त्वा च भूमिदानं यो ह्यपकारं करोति च ।\nतेन पापेन लिप्येऽहं यद्यहं नागमे पुनः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003515034, "chapter_id": 23515, "verse_number": "१५५-३५", "content_sanskrit": "पूर्वं भुक्त्वा स्त्रियं यस्तु सुखमाप्य विहृत्य च ।\nद्वेषात्तां यदि चेज्जह्यात्तस्यायं मे भवत्वलम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003515035, "chapter_id": 23515, "verse_number": "१५५-३६", "content_sanskrit": "पङ्क्तिभेदं तु यः कुर्यादेकपंक्त्याशिनां धुवम् ।\nतस्य पापेन लिप्येऽहं नागन्ता यदि ते पुरः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003515036, "chapter_id": 23515, "verse_number": "१५५-३७", "content_sanskrit": "अमावस्यां महारक्षः श्राद्धं कृत्वा स्त्रियं व्रजेत् ।\nतेन पापेन लिप्येऽहं यद्यहं नागमे पुनः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003515037, "chapter_id": 23515, "verse_number": "१५५-३८", "content_sanskrit": "अष्टाष्टमी त्वमावास्या उभे पक्षे चतुर्दशी ।\nअस्नातानां गतिं यास्याम्यहं वै नागमे पुनः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003515038, "chapter_id": 23515, "verse_number": "१५५-३९", "content_sanskrit": "गुरोर्भ्रातुः सुतस्यापि सख्युर्वै मातुलस्य च ।\nव्यवस्यति च यन्नारी यो मोहेन विमोहितः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003515039, "chapter_id": 23515, "verse_number": "१५५-४०", "content_sanskrit": "अभिगच्छति मन्दात्मा तत्पापं मे भवेत्तदा ।\nराजपत्नीं ब्रह्मपत्नीं विधवां योऽभिगच्छति ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003515040, "chapter_id": 23515, "verse_number": "१५५-४१", "content_sanskrit": "तस्य पापेन लिप्येऽहं यद्यहं नागमे पुनः ।\nयस्तु कन्यां सकृद्दत्त्वा अन्यस्मै चेत्पुनर्ददेत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003515041, "chapter_id": 23515, "verse_number": "१५५-४२", "content_sanskrit": "तेन पापेन लिप्येऽहं यद्यहं नागमे पुनः ।\nराजयाजकयाज्याश्च ये च वै ग्रामयाजकाः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003515042, "chapter_id": 23515, "verse_number": "१५५-४३", "content_sanskrit": "तेषां पापेन लिप्येऽहं यद्यहं नागमे पुनः ।\nब्रह्मघ्ने च सुरापे च चौरे भग्नव्रते शठे ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003515043, "chapter_id": 23515, "verse_number": "१५५-४४", "content_sanskrit": "या गतिस्तां प्रपद्येऽहं यद्यहं नागमे पुनः ।\nश्रीवराह उवाच।\nसुधनस्य वचः श्रुत्वा सन्तुष्टो ब्रह्मराक्षसः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003515044, "chapter_id": 23515, "verse_number": "१५५-४५", "content_sanskrit": "उवाच मधुरं वाक्यं गच्छ शीघ्रं नमोऽस्तु ते।\nब्रह्मराक्षसमुक्तोऽसौ वणिक् तु दृढनिश्चयः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003515045, "chapter_id": 23515, "verse_number": "१५५-४६", "content_sanskrit": "पुनर्नृत्यति चैवाग्रे मम भक्तो व्यवस्थितः ।\nअथ प्रभातसमये नृत्यचित्तोऽति कोविदः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003515046, "chapter_id": 23515, "verse_number": "१५५-४७", "content_sanskrit": "पुनः पुनर्वै उच्चार्य नमो नारायणाय च ।\nनिवृत्ते जागरे सोऽथ कालिन्दीसलिलाप्लुतः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003515047, "chapter_id": 23515, "verse_number": "१५५-४८", "content_sanskrit": "दृष्ट्वा मां दिव्यरूपं तु गतोऽसौ मथुरां पुरीम्।\nदृष्टश्चाग्रे त्वहं तेन पुरुषो दिव्यरूपवान् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003515048, "chapter_id": 23515, "verse_number": "१५५-४९", "content_sanskrit": "स च पृष्टो मया देवि क्व भवान्प्रस्थितो द्रुतम् ।\nपुरुषस्य वचः श्रुत्वा सुधनो वाक्यमब्रवीत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003515049, "chapter_id": 23515, "verse_number": "१५५-५०", "content_sanskrit": "अहं गच्छामि त्वरितो ब्रह्मराक्षससन्निधौ ।\nनिवारयामास तदा न गंतव्यं त्वयानघ ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003515050, "chapter_id": 23515, "verse_number": "१५५-५१", "content_sanskrit": "जीवतो धर्ममाहात्म्यं मृते धर्मः कुतो यशः ।\nपुरुषस्य वचः श्रुत्वा स वणिग्वाक्यमब्रवीत् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003515051, "chapter_id": 23515, "verse_number": "१५५-५२", "content_sanskrit": "तत्र सत्यं वदिष्यामि यास्ये राक्षससन्निधौ ।\nआगतोऽहं महाभाग नर्त्तयित्वा यथासुखम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003515052, "chapter_id": 23515, "verse_number": "१५५-५३", "content_sanskrit": "विष्णवे लोकनाथाय चागतो हरिजागरात् ।\nइदं शरीरं मे रक्षो भक्षयस्व यथेप्सितम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003515053, "chapter_id": 23515, "verse_number": "१५५-५४", "content_sanskrit": "यथान्यायं विधानेन यथा वा तव रोचते ।\nनोक्तपूर्वं मयाऽसत्यं कदाचिदपि राक्षस ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003515054, "chapter_id": 23515, "verse_number": "१५५-५५", "content_sanskrit": "तेन सत्येन मां भुङ्क्ष्व ब्रह्मराक्षस दारुण ।\nवणिजस्तु वचः श्रुत्वा ततोऽसौ ब्रह्मराक्षसः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003515055, "chapter_id": 23515, "verse_number": "१५५-५६", "content_sanskrit": "उवाच मधुरं वाक्यं सुधनं तदनन्तरम् ।\nसाधु तुष्टोऽस्मि भद्रं ते सत्यं धर्मश्च पालितः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003515056, "chapter_id": 23515, "verse_number": "१५५-५७", "content_sanskrit": "वणिक् त्वं चातिविज्ञस्तु यस्य ते गतिरीदृशी ।\nजागरस्य समस्तस्य मम पुण्यं प्रयच्छ वै ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003515057, "chapter_id": 23515, "verse_number": "१५५-५८", "content_sanskrit": "सत्यपुण्यप्रभावेण यथाहं मुक्तिमाप्नुयाम् ।\nसुधन उवाच ।\nनाहं दास्यामि  ते पुण्यं नृत्यस्य नरभोजन ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003515058, "chapter_id": 23515, "verse_number": "१५५-५९", "content_sanskrit": "अर्द्धं वाथ समस्तं वा प्रहरं चार्द्धमेव वा ।\nसुधनस्य वचः श्रुत्वा अब्रवीद्ब्रह्मराक्षसः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003515059, "chapter_id": 23515, "verse_number": "१५५-६०", "content_sanskrit": "एकनृत्यस्य मे पुण्यं दद त्वं वणिगुत्तम ।\nसुधन उवाच ।\nनाऽहं दास्यामि ते पुण्यं यथोक्तं च समाचर ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003515060, "chapter_id": 23515, "verse_number": "१५५-६१", "content_sanskrit": "केन त्वं कर्मदोषेण राक्षसत्वमुपागतः ।\nयत्ते गुह्यं महाभाग सर्वं तत्कथयस्व मे ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003515061, "chapter_id": 23515, "verse_number": "१५५-६२", "content_sanskrit": "सुधनस्य वचः श्रुत्वा विहसित्वाह राक्षसः ।\nकिं त्वं मां च विजानासि प्रतिवासि ह्यहं तव ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003515062, "chapter_id": 23515, "verse_number": "१५५-६३", "content_sanskrit": "अग्निदत्तस्तु वै नाम छान्दसो ब्राह्मणोत्तमः ।\nइष्टकांस्तु हरन्नित्यं परकीयांश्च सर्वदा ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003515063, "chapter_id": 23515, "verse_number": "१५५-६४", "content_sanskrit": "मृतस्सुगृहकामेन राक्षसत्वमुपागतः ।\nमया त्वं हि यथा प्राप्त उपकारं कुरुष्व मे ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003515064, "chapter_id": 23515, "verse_number": "१५५-६५", "content_sanskrit": "एकविश्रामपुण्यं मे देहि त्वं वणिगुत्तम ।\nकृपया तु समायुक्तो वणिग्वचनमब्रवीत् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003515065, "chapter_id": 23515, "verse_number": "१५५-६६", "content_sanskrit": "साधु राक्षस दत्तं ते एकनृत्यं मया तव ।\nएकनृत्यप्रभावेण राक्षसो मुक्तिमागतः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003515066, "chapter_id": 23515, "verse_number": "१५५-६७", "content_sanskrit": "श्रीवराह उवाच ।\nसुधनस्तु ततो देवि विश्वरूपं जनार्दनम् ।\nअग्रतस्तु स्थितं देवं दृष्ट्वाऽसौ धरणीं गतः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003515067, "chapter_id": 23515, "verse_number": "१५५-६८", "content_sanskrit": "उवाच मधुरं वाक्यं देवदेवो जनार्दनः ।\nचतुर्भुजो दिव्यतनुः शंखचक्रगदाधरः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003515068, "chapter_id": 23515, "verse_number": "१५५-६९", "content_sanskrit": "विमानवरमारुह्य मम लोकं व्रजस्व च ।\nइत्युक्त्वा माधवो देवस्तत्रैवान्तरधीयत ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003515069, "chapter_id": 23515, "verse_number": "१५५-७०", "content_sanskrit": "सुधनः सशरीरोऽपि सकुटुंबो दिवं ययौ ।\nविमानवरमारुह्य विष्णोर्लोकं जगाम ह ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003515070, "chapter_id": 23515, "verse_number": "१५५-७१", "content_sanskrit": "एष तीर्थप्रभावो वै कथितस्ते वसुन्धरे ।\nअक्रूराच्च परं तीर्थं न भूतं न भविष्यति ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003515071, "chapter_id": 23515, "verse_number": "१५५-७२", "content_sanskrit": "तस्य तीर्थप्रभावेण सुधनो मुक्तिमाप्तवान् ।\nद्वादशी शुक्लपक्षे तु कुमुदस्य च वा भवेत् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003515072, "chapter_id": 23515, "verse_number": "१५५-७३", "content_sanskrit": "तस्मिन्स्नातस्य वसुधे राजसूयफलं भवेत् ।\nकार्त्तिकीं समनुप्राप्य तत्तीर्थे तु वसुन्धरे ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003515073, "chapter_id": 23515, "verse_number": "१५५-७४", "content_sanskrit": "वृषोत्सर्गं नरः कुर्वंस्तारयेत्सकुलोद्भवान् ।\nश्राद्धं यः कुरुते सुभ्रु कार्तिक्यां प्रयतो नरः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003515074, "chapter_id": 23515, "verse_number": "१५५-७५", "content_sanskrit": "पितरस्तारितास्तेन सदैव प्रपितामहाः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}]