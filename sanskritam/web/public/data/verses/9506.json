[{"id": 5000506000, "chapter_id": 9506, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे एकोनशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000506001, "chapter_id": 9506, "verse_number": "६-९९-१", "content_sanskrit": "महोदरमहापार्श्वौ हतौ दृष्ट्वा स रावणः।\nतस्मिंश्च निहते वीरे विरूपाक्षे महाबले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000506002, "chapter_id": 9506, "verse_number": "६-९९-२", "content_sanskrit": "आविवेश महान् क्रोधो रावणं तु महामृधे।\nसूतं संचोदयामास वाक्यं चेदमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000506003, "chapter_id": 9506, "verse_number": "६-९९-३", "content_sanskrit": "निहतानाममात्यानां रुद्धस्य नगरस्य च।\nदुःखमेवापनेष्यामि हत्वा तौ रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000506004, "chapter_id": 9506, "verse_number": "६-९९-४", "content_sanskrit": "रामवृक्षं रणे हन्मि सीतापुष्पफलप्रदम्।\nप्रशाखा यस्य सुग्रीवो जाम्बवान् कुमुदो नलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000506005, "chapter_id": 9506, "verse_number": "६-९९-५", "content_sanskrit": "द्विविदश्चैव मैन्दश्च अङ्गदो गन्धमादनः।\nहनूमांश्च सुषेणश्च सर्वे च हरियूथपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000506006, "chapter_id": 9506, "verse_number": "६-९९-६", "content_sanskrit": "स दिशो दश घोषेण रथस्यातिरथो महान्।\nनादयन् प्रययौ तूर्णं राघवं चाभ्यधावत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000506007, "chapter_id": 9506, "verse_number": "६-९९-७", "content_sanskrit": "पूरिता तेन शब्देन सनदीगिरिकानना।\nसंचचाल मही सर्वा त्रस्तसिंहमृगद्विजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000506008, "chapter_id": 9506, "verse_number": "६-९९-८", "content_sanskrit": "तामसं सुमहाघोरं चकारास्त्रं सुदारुणम्।\nनिर्ददाह कपीन् सर्वांस्ते प्रपेतुः समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000506009, "chapter_id": 9506, "verse_number": "६-९९-९", "content_sanskrit": "उत्पपात रजो भूमौ तैर्भग्नैः सम्प्रधावितैः।\nनहि तत् सहितुं शेकुर्ब्रह्मणा निर्मितं स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000506010, "chapter_id": 9506, "verse_number": "६-९९-१०", "content_sanskrit": "तान्यनीकान्यनेकानि रावणस्य शरोत्तमैः।\nदृष्ट्वा भग्नानि शतशो राघवः पर्यवस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000506011, "chapter_id": 9506, "verse_number": "६-९९-११", "content_sanskrit": "ततो राक्षसशार्दूलो विद्राव्य हरिवाहिनीम्।\nस ददर्श ततो रामं तिष्ठन्तमपराजितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000506012, "chapter_id": 9506, "verse_number": "६-९९-१२", "content_sanskrit": "लक्ष्मणेन सह भ्रात्रा विष्णुना वासवं यथा।\nआलिखन्तमिवाकाशमवष्टभ्य महद् धनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000506013, "chapter_id": 9506, "verse_number": "६-९९-१३", "content_sanskrit": "पद्मपत्रविशालाक्षं दीर्घबाहुमरिंदमम्।\nततो रामो महातेजाः सौमित्रिसहितो बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000506014, "chapter_id": 9506, "verse_number": "६-९९-१४", "content_sanskrit": "वानरांश्च रणे भग्नानापतन्तं च रावणम्।\nसमीक्ष्य राघवो हृष्टो मध्ये जग्राह कार्मुकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000506015, "chapter_id": 9506, "verse_number": "६-९९-१५", "content_sanskrit": "विस्फारयितुमारेभे ततः स धनुरुत्तमम्।\nमहावेगं महानादं निर्भिन्दन्निव मेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000506016, "chapter_id": 9506, "verse_number": "६-९९-१६", "content_sanskrit": "रावणस्य च बाणौघै रामविस्फारितेन च।\nशब्देन राक्षसास्तेन पेतुश्च शतशस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000506017, "chapter_id": 9506, "verse_number": "६-९९-१७", "content_sanskrit": "तयोः शरपथं प्राप्य रावणो राजपुत्रयोः।\nस बभौ च यथा राहुः समीपे शशिसूर्ययोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000506018, "chapter_id": 9506, "verse_number": "६-९९-१८", "content_sanskrit": "तमिच्छन् प्रथमं योद्धुं लक्ष्मणो निशितैः शरैः।\nमुमोच धनुरायम्य शरानग्निशिखोपमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000506019, "chapter_id": 9506, "verse_number": "६-९९-१९", "content_sanskrit": "तान् मुक्तमात्रानाकाशे लक्ष्मणेन धनुष्मता।\nबाणान् बाणैर्महातेजा रावणः प्रत्यवारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000506020, "chapter_id": 9506, "verse_number": "६-९९-२०", "content_sanskrit": "एकमेकेन बाणेन त्रिभिस्त्रीन् दशभिर्दश।\nलक्ष्मणस्य प्रचिच्छेद दर्शयन् पाणिलाघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000506021, "chapter_id": 9506, "verse_number": "६-९९-२१", "content_sanskrit": "अभ्यतिक्रम्य सौमित्रिं रावणः समितिंजयः।\nआससाद रणे रामं स्थितं शैलमिवापरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000506022, "chapter_id": 9506, "verse_number": "६-९९-२२", "content_sanskrit": "स राघवं समासाद्य क्रोधसंरक्तलोचनः।\nव्यसृजच्छरवर्षाणि रावणो राक्षसेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000506023, "chapter_id": 9506, "verse_number": "६-९९-२३", "content_sanskrit": "शरधारास्ततो रामो रावणस्य धनुश्च्युताः।\nदृष्ट्वैवापतिताः शीघ्रं भल्लाञ्जग्राह सत्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000506024, "chapter_id": 9506, "verse_number": "६-९९-२४", "content_sanskrit": "ताञ्छरौघांस्ततो भल्लैस्तीक्ष्णैश्चिच्छेद राघवः।\nदीप्यमानान् महाघोराञ्छरानाशीविषोपमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000506025, "chapter_id": 9506, "verse_number": "६-९९-२५", "content_sanskrit": "राघवो रावणं तूर्णं रावणो राघवं तथा।\nअन्योन्यं विविधैस्तीक्ष्णैः शरवर्षैर्ववर्षतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000506026, "chapter_id": 9506, "verse_number": "६-९९-२६", "content_sanskrit": "चेरतुश्च चिरं चित्रं मण्डलं सव्यदक्षिणम्।\nबाणवेगात् समुत्क्षिप्तावन्योन्यमपराजितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000506027, "chapter_id": 9506, "verse_number": "६-९९-२७", "content_sanskrit": "तयोर्भूतानि वित्रेसुर्युगपत् सम्प्रयुध्यतोः।\nरौद्रयोः सायकमुचोर्यमान्तकनिकाशयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000506028, "chapter_id": 9506, "verse_number": "६-९९-२८", "content_sanskrit": "सततं विविधैर्बाणैर्बभूव गगनं तदा।\nघनैरिवातपापाये विद्युन्मालासमाकुलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000506029, "chapter_id": 9506, "verse_number": "६-९९-२९", "content_sanskrit": "गवाक्षितमिवाकाशं बभूव शरवृष्टिभिः।\nमहावेगैः सुतीक्ष्णाग्रैर्गृध्रपत्रैः सुवाजितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000506030, "chapter_id": 9506, "verse_number": "६-९९-३०", "content_sanskrit": "शरान्धकारमाकाशं चक्रतुः परमं तदा।\nगतेऽस्तं तपने चापि महामेघाविवोत्थितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000506031, "chapter_id": 9506, "verse_number": "६-९९-३१", "content_sanskrit": "तयोरभून्महायुद्धमन्योन्यवधकांक्षिणोः।\nअनासाद्यमचिन्त्यं च वृत्रवासवयोरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000506032, "chapter_id": 9506, "verse_number": "६-९९-३२", "content_sanskrit": "उभौ हि परमेष्वासावुभौ युद्धविशारदौ।\nउभावस्त्रविदां मुख्यावुभौ युद्धे विचेरतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000506033, "chapter_id": 9506, "verse_number": "६-९९-३३", "content_sanskrit": "उभौ हि येन व्रजतस्तेन तेन शरोर्मयः।\nऊर्मयो वायुना विद्धा जग्मुः सागरयोरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000506034, "chapter_id": 9506, "verse_number": "६-९९-३४", "content_sanskrit": "ततः संसक्तहस्तस्तु रावणो लोकरावणः।\nनाराचमालां रामस्य ललाटे प्रत्यमुञ्चत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000506035, "chapter_id": 9506, "verse_number": "६-९९-३५", "content_sanskrit": "रौद्रचापप्रयुक्तां तां नीलोत्पलदलप्रभाम्।\nशिरसाधारयद् रामो न व्यथामभ्यपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000506036, "chapter_id": 9506, "verse_number": "६-९९-३६", "content_sanskrit": "अथ मन्त्रानपि जपन् रौद्रमस्त्रमुदीरयन्।\nशरान् भूयः समादाय रामः क्रोधसमन्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000506037, "chapter_id": 9506, "verse_number": "६-९९-३७", "content_sanskrit": "मुमोच च महातेजाश्चापमायम्य वीर्यवान्।\nतान् शरान् राक्षसेन्द्राय चिक्षेपाच्छिन्नसायकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000506038, "chapter_id": 9506, "verse_number": "६-९९-३८", "content_sanskrit": "ते महामेघसंकाशे कवचे पतिताः शराः।\nअवध्ये राक्षसेन्द्रस्य न व्यथां जनयंस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000506039, "chapter_id": 9506, "verse_number": "६-९९-३९", "content_sanskrit": "पुनरेवाथ तं रामो रथस्थं राक्षसाधिपम्।\nललाटे परमास्त्रेण सर्वास्त्रकुशलोऽभिनत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000506040, "chapter_id": 9506, "verse_number": "६-९९-४०", "content_sanskrit": "ते भित्त्वा बाणरूपाणि पञ्चशीर्षा इवोरगाः।\nश्वसन्तो विविशुर्भूमिं रावणप्रतिकूलिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000506041, "chapter_id": 9506, "verse_number": "६-९९-४१", "content_sanskrit": "निहत्य राघवस्यास्त्रं रावणः क्रोधमूर्च्छितः।\nआसुरं सुमहाघोरमस्त्रं प्रादुश्चकार सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000506042, "chapter_id": 9506, "verse_number": "६-९९-४२", "content_sanskrit": "सिंहव्याघ्रमुखांश्चापि कङ्ककोकमुखानपि।\nगृध्रश्येनमुखांश्चापि शृगालवदनांस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000506043, "chapter_id": 9506, "verse_number": "६-९९-४३", "content_sanskrit": "ईहामृगमुखांश्चापि व्यादितास्यान् भयावहान्।\nपञ्चास्याँल्लेलिहानांश्च ससर्ज निशितान् शरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000506044, "chapter_id": 9506, "verse_number": "६-९९-४४", "content_sanskrit": "शरान् खरमुखांश्चान्यान् वराहमुखसंश्रितान्।\nश्वानकुक्कुटवक्त्रांश्च मकराशीविषाननान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000506045, "chapter_id": 9506, "verse_number": "६-९९-४५", "content_sanskrit": "एतांश्चान्यांश्च मायाभिः ससर्ज निशिताञ्छरान्।\nरामं प्रति महातेजाः क्रुद्धः सर्प इव श्वसन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000506046, "chapter_id": 9506, "verse_number": "६-९९-४६", "content_sanskrit": "आसुरेण समाविष्टः सोऽस्त्रेण रघुपुङ्गवः।\nससर्जास्त्रं महोत्साहं पावकं पावकोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000506047, "chapter_id": 9506, "verse_number": "६-९९-४७", "content_sanskrit": "अग्निदीप्तमुखान् बाणांस्तत्र सूर्यमुखानपि।\nचन्द्रार्धचन्द्रवक्त्रांश्च धूमकेतुमुखानपि।\nग्रहनक्षत्रवर्णांश्च महोल्कामुखसंस्थितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000506048, "chapter_id": 9506, "verse_number": "६-९९-४८", "content_sanskrit": "विद्युज्जिह्वोपमांश्चापि ससर्ज विविधाञ्छरान्।\nते रावणशरा घोरा राघवास्त्रसमाहताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000506049, "chapter_id": 9506, "verse_number": "६-९९-४९", "content_sanskrit": "विलयं जग्मुराकाशे जघ्नुश्चैव सहस्रशः।\nतदस्त्रं निहतं दृष्ट्वा रामेणाक्लिष्टकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000506050, "chapter_id": 9506, "verse_number": "६-९९-५०", "content_sanskrit": "हृष्टा नेदुस्ततः सर्वे कपयः कामरूपिणः।\nसुग्रीवाभिमुखा वीराः सम्परिक्षिप्य राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000506051, "chapter_id": 9506, "verse_number": "६-९९-५१", "content_sanskrit": "ततस्तदस्त्रं विनिहत्य राघवः\nप्रसह्य तद् रावणबाहुनिःसृतम्।\nमुदान्वितो दाशरथिर्महात्मा\nविनेदुरुच्चैर्मुदिताः कपीश्वराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000506052, "chapter_id": 9506, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे एकोनशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]