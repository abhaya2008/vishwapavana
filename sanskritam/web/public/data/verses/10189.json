[{"id": 6000189000, "chapter_id": 10189, "verse_number": null, "content_sanskrit": "अथ चतुर्दशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000189001, "chapter_id": 10189, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.001.m4a", "display_order": 2}, {"id": 6000189002, "chapter_id": 10189, "verse_number": "९-१४-१", "content_sanskrit": "पित्रोपशिक्षितो रामस्तथेति कुरुनन्दन।\nसंवत्सरं तीर्थचर्यां चरित्वाऽऽश्रममाव्रजत्॥ ९/१४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.002.m4a", "display_order": 3, "topics": [{"text": "परशुरामेण पित्राज्ञया मातू रेणुकायाः ज्येष्ठभ्रातॄणां च वधः", "range": "१–५"}]}, {"id": 6000189003, "chapter_id": 10189, "verse_number": "९-१४-२", "content_sanskrit": "कदाचिद् रेणुका याता गङ्गायां पद्ममालिनम्।\nगन्धर्वराजं क्रीडन्तमप्सरोभिरपश्यत॥ ९/१४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.003.m4a", "display_order": 4}, {"id": 6000189004, "chapter_id": 10189, "verse_number": "९-१४-३", "content_sanskrit": "विलोकयन्ती क्रीडन्तमुदकार्थं नदीं गता।\nहोमवेलां न सस्मार किञ्चिच्चित्ररथस्पृहा॥ ९/१४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.004.m4a", "display_order": 5}, {"id": 6000189005, "chapter_id": 10189, "verse_number": "९-१४-४", "content_sanskrit": "कालात्ययं तं विलोक्य मुनेः शापविशङ्किता।\nआगत्य कलशं तस्थौ पुरोधाय कृताञ्जलिः॥ ९/१४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.005.m4a", "display_order": 6}, {"id": 6000189006, "chapter_id": 10189, "verse_number": "९-१४-५", "content_sanskrit": "व्यभिचारं मुनिर्ज्ञात्वा पत्न्याः प्रकुपितोऽब्रवीत्।\nघ्नतैनां पुत्रकाः पापामित्युक्तास्तां न चक्रिरे॥ ९/१४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.006.m4a", "display_order": 7}, {"id": 6000189007, "chapter_id": 10189, "verse_number": "९-१४-६", "content_sanskrit": "रामः संचोदितः पित्रा भ्रातॄन् मात्रा सहावधीत्।\nप्रभावज्ञो मुनेः सम्यक् समाधेस्तपसश्च सः॥ ९/१४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.007.m4a", "display_order": 8, "topics": [{"text": "परशुरामेण प्रसादितस्य जमदग्नेरनुग्रहेण मृतानां पुनरुज्जीवनम्", "range": "६–८"}]}, {"id": 6000189008, "chapter_id": 10189, "verse_number": "९-१४-७", "content_sanskrit": "वरेण च्छन्दयामास प्रीतः सत्यवतीसुतः।\nवव्रे हतानां रामोऽपि जीवितं चास्मृतिं वधे॥ ९/१४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.008.m4a", "display_order": 9}, {"id": 6000189009, "chapter_id": 10189, "verse_number": "९-१४-८", "content_sanskrit": "उत्तस्थुस्ते कुशलिनो निद्रापाय इवाञ्जसा।\nपितुर्विद्वांस्तपोवीर्यं रामश्चक्रे सुहृद्वधम्॥ ९/१४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.009.m4a", "display_order": 10}, {"id": 6000189010, "chapter_id": 10189, "verse_number": "९-१४-९", "content_sanskrit": "येऽर्जुनस्य सुता राजन् स्मरन्तः स्म पितुर्वधम्।\nरामवीर्यपराभूता लेभिरे शर्म न क्‍वचित्॥ ९/१४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.010.m4a", "display_order": 11, "topics": [{"text": "कार्तवीर्यार्जुनसुतै रामासन्निधाने जमदग्नेर्वधः", "range": "९–१२"}]}, {"id": 6000189011, "chapter_id": 10189, "verse_number": "९-१४-१०", "content_sanskrit": "एकदाऽऽश्रमतो रामे सभ्रातरि वनं गते।\nवैरं सिषाधयिषवो लब्धच्छिद्रा उपागमन्॥ ९/१४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.011.m4a", "display_order": 12}, {"id": 6000189012, "chapter_id": 10189, "verse_number": "९-१४-११", "content_sanskrit": "दृष्ट्वाऽग्न्यागार आसीनमावेशितधियं मुनिम्।\nभगवत्युत्तमश्लोके जघ्नुस्ते पापनिश्चयाः॥ ९/१४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.012.m4a", "display_order": 13}, {"id": 6000189013, "chapter_id": 10189, "verse_number": "९-१४-१२", "content_sanskrit": "याचमानाः कृपणया राममात्राऽतिदारुणाः।\nप्रसह्य शिर उत्कृत्य जग्मुस्ते क्षत्रबन्धवः॥ ९/१४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.013.m4a", "display_order": 14}, {"id": 6000189014, "chapter_id": 10189, "verse_number": "९-१४-१३", "content_sanskrit": "रेणुका दुःखशोकार्ता निघ्नन्त्यात्मानमात्मना।\nराम रामेति तातेति विचुक्रोशोच्चकैः सती॥ ९/१४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.014.m4a", "display_order": 15, "topics": [{"text": "रामेण माहिष्मतीं गत्वा स्वपितृवधं व्याजीकृत्य दुष्टानां क्षत्रियाणां एकविंशतिकृत्वो वधः", "range": "१३–१९"}]}, {"id": 6000189015, "chapter_id": 10189, "verse_number": "९-१४-१४", "content_sanskrit": "तदुपश्रुत्य दूरस्था हा रामेत्यार्तवत्स्वरम्।\nत्वरयाऽऽश्रममासाद्य ददृशुः पितरं हतम्॥ ९/१४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.015.m4a", "display_order": 16}, {"id": 6000189016, "chapter_id": 10189, "verse_number": "९-१४-१५", "content_sanskrit": "ते दुःखरोषामर्षार्तिशोकवेगविमोहिताः।\nहा तात साधो धर्मिष्ठ त्यक्त्वाऽस्मान् स्वर्गतो भवान्॥ ९/१४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.016.m4a", "display_order": 17}, {"id": 6000189017, "chapter_id": 10189, "verse_number": "९-१४-१६", "content_sanskrit": "विलप्यैवं पितुर्देहं निधाय भ्रातृषु स्वयम्।\nप्रगृह्य परशुं रामः क्षत्रान्ताय मनो दधे॥ ९/१४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.017.m4a", "display_order": 18}, {"id": 6000189018, "chapter_id": 10189, "verse_number": "९-१४-१७", "content_sanskrit": "गत्वा माहिष्मतीं रामो ब्रह्मघ्नविहतश्रियम्।\nतस्यां स शीर्षभी राज्ञां मध्ये चक्रे महागिरिम्॥ ९/१४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.018.m4a", "display_order": 19}, {"id": 6000189019, "chapter_id": 10189, "verse_number": "९-१४-१८", "content_sanskrit": "तद्रक्तेन नदीं घोरामब्रह्मण्यभयावहाम्।\nहेतुं कृत्वा पितृवधं क्षत्रेऽमङ्गलकारिणि॥ ९/१४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.019.m4a", "display_order": 20}, {"id": 6000189020, "chapter_id": 10189, "verse_number": "९-१४-१९", "content_sanskrit": "त्रिः सप्तकृत्वः पृथिवीं कृत्वा निःक्षत्रियां विभुः।\nस्यमन्तपञ्चके चक्रे शोणितोदान् ह्रदान् नव॥ ९/१४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.020.m4a", "display_order": 21}, {"id": 6000189021, "chapter_id": 10189, "verse_number": "९-१४-२०", "content_sanskrit": "पितुः कायेन सन्धाय शिर आधाय बर्हिषि।\nसर्वदेवमयं देवमात्मनमयजन्मखैः॥ ९/१४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.021.m4a", "display_order": 22, "topics": [{"text": "परशुरामकृतमखादिनिरूपणम्", "range": "२०–२७"}]}, {"id": 6000189022, "chapter_id": 10189, "verse_number": "९-१४-२१", "content_sanskrit": "ददौ प्राचीं दिशं होत्रे ब्रह्मणे दक्षिणां दिशम्।\nअध्वर्यवे प्रतीचीं वा उद्गात्र उत्तरां दिशम्॥ ९/१४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.022.m4a", "display_order": 23}, {"id": 6000189023, "chapter_id": 10189, "verse_number": "९-१४-२२", "content_sanskrit": "अन्येभ्योऽवान्तरदिशः काश्यपाय च मध्यतः।\nआर्यावर्तमुपद्रष्ट्रे सदस्येभ्यस्ततः परम्॥ ९/१४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.023.m4a", "display_order": 24}, {"id": 6000189024, "chapter_id": 10189, "verse_number": "९-१४-२३", "content_sanskrit": "ततश्चावभृथस्नानविधूताशेषकिल्बिषः।\nसरस्वत्यां ब्रह्मनद्यां रेजे व्यभ्र इवांशुमान्॥ ९/१४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.024.m4a", "display_order": 25}, {"id": 6000189025, "chapter_id": 10189, "verse_number": "९-१४-२४", "content_sanskrit": "स्वदेहं जमदग्निस्तु लब्ध्वा संज्ञानलक्षणम्।\nऋषीणां मण्डले सोऽभूत् सप्तमो रामपूजितः॥ ९/१४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.025.m4a", "display_order": 26}, {"id": 6000189026, "chapter_id": 10189, "verse_number": "९-१४-२५", "content_sanskrit": "जामदग्न्योऽपि भगवान् रामः कमललोचनः।\nआगामिन्यन्तरे राजन् वर्तयिष्यति वै बृहत्॥ ९/१४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.026.m4a", "display_order": 27}, {"id": 6000189027, "chapter_id": 10189, "verse_number": "९-१४-२६", "content_sanskrit": "आस्तेऽद्यापि महेन्द्राद्रौ न्यस्तदण्डः प्रशान्तधीः।\nउपगीयमानचरितः सिद्धगन्धर्वचारणैः॥ ९/१४/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.027.m4a", "display_order": 28}, {"id": 6000189028, "chapter_id": 10189, "verse_number": "९-१४-२७", "content_sanskrit": "एवं भृगुषु विश्वात्मा भगवान् हरिरीश्वरः।\nअवतीर्य परं भारं भुवोऽहन् बहुशो नृपान्॥ ९/१४/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.028.m4a", "display_order": 29}, {"id": 6000189029, "chapter_id": 10189, "verse_number": "९-१४-२८", "content_sanskrit": "गाधेरभून्महातेजाः समिद्ध इव पावकः।\nतपसा क्षात्रमुत्सृज्य यो लेभे ब्रह्मवर्चसम्॥ ९/१४/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.029.m4a", "display_order": 30, "topics": [{"text": "गाधिराजस्य विश्वामित्रनामकपुत्रोत्पत्तिकथाकथनम्। तस्य तपसा ब्राह्मण्यप्राप्तिकथनम्", "range": "२८"}]}, {"id": 6000189030, "chapter_id": 10189, "verse_number": "९-१४-२९", "content_sanskrit": "विश्वामित्रस्य चैवासन् पुत्रा एकशतं नृप।\nमध्यमस्तु मधुच्छन्दा माधुच्छन्दस एव ते॥ ९/१४/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.030.m4a", "display_order": 31, "topics": [{"text": "विश्वामित्रस्य वंशकथनम्", "range": "२९–५५"}]}, {"id": 6000189031, "chapter_id": 10189, "verse_number": "९-१४-३०", "content_sanskrit": "पुत्रं कृत्वा शुनःशेपं देवरातं च भार्गवम्।\nआजीगर्तं सुतानाह ज्येष्ठ एष प्रकल्प्यताम्॥ ९/१४/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.031.m4a", "display_order": 32}, {"id": 6000189032, "chapter_id": 10189, "verse_number": "९-१४-३१", "content_sanskrit": "यो वै हरिश्चन्द्रमखे विक्रीतः पुरुषः पशुः।\nस्तुत्वा देवान् प्रजेशादीन् मुमुचे पाशबन्धनात्॥ ९/१४/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.032.m4a", "display_order": 33}, {"id": 6000189033, "chapter_id": 10189, "verse_number": "९-१४-३२", "content_sanskrit": "यो रातो देवयजने देवैर्गाधिसुताय सः।\nदेवरात इति ख्यातः शुनःशेपस्तु भार्गवः॥ ९/१४/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.033.m4a", "display_order": 34}, {"id": 6000189034, "chapter_id": 10189, "verse_number": "९-१४-३३", "content_sanskrit": "ये मधुच्छन्दसो ज्येष्ठाः कुशलं मेनिरे न तत्।\nअशपत् तान् मुनिः क्रुद्धो म्लेञ्छा भवत दुर्जनाः॥ ९/१४/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.034.m4a", "display_order": 35}, {"id": 6000189035, "chapter_id": 10189, "verse_number": "९-१४-३४", "content_sanskrit": "स होवाच मधुच्छन्दाः सार्धं पञ्चाशता ततः।\nयन्नो भवान् सञ्जानीते तस्मिंस्तिष्ठामहे वयम्॥ ९/१४/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.035.m4a", "display_order": 36}, {"id": 6000189036, "chapter_id": 10189, "verse_number": "९-१४-३५", "content_sanskrit": "ज्येष्ठं मन्त्रदृशं चक्रुः त्वामन्वञ्चो वयं स्म हि।\nविश्वामित्रः सुतानाह वीरवन्तो भविष्यथ॥ ९/१४/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.036.m4a", "display_order": 37}, {"id": 6000189037, "chapter_id": 10189, "verse_number": "९-१४-३६", "content_sanskrit": "ये मानं मेऽनुगृह्णन्तो वीरवन्तमकर्त मा।\nएष वः कौशिका वीरो देवरातस्तमन्वित॥ ९/१४/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.037.m4a", "display_order": 38}, {"id": 6000189038, "chapter_id": 10189, "verse_number": "९-१४-३७", "content_sanskrit": "अन्ये चाष्टकहारीता जयक्रतुमदादयः। एवं कौशिकगोत्रं तद् वैश्वामित्रैः पृथग्विधम्।\nप्रवरान्तरमापन्नं तद्धीत्येवं प्रकल्पितम्॥ ९/१४/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.038.m4a", "display_order": 39}, {"id": 6000189039, "chapter_id": 10189, "verse_number": "९-१४-३८", "content_sanskrit": "यः पुरूरवसः पुत्र आयुस्तस्याभवन् सुताः। नहुषः क्षत्रवृद्धश्च रजी रामश्च वीर्यवान्।\nअनेना इति राजेन्द्र क्षत्रवृद्धान्वयं शृणु॥ ९/१४/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.039.m4a", "display_order": 40}, {"id": 6000189040, "chapter_id": 10189, "verse_number": "९-१४-३९", "content_sanskrit": "क्षत्रवृद्धसुतस्यासन् सुहोत्रस्यात्मजास्‍त्रयः।\nकाश्यः कुशो गृत्समद इति गृत्समदादभूत्॥ ९/१४/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.040.m4a", "display_order": 41}, {"id": 6000189041, "chapter_id": 10189, "verse_number": "९-१४-४०", "content_sanskrit": "शुनकः शौनको यस्य बह्वृचप्रवरो मुनिः।\nकाश्यस्य काशिस्तत्पुत्रः सुराष्ट्रो दीर्घतमःपिता॥ ९/१४/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.041.m4a", "display_order": 42}, {"id": 6000189042, "chapter_id": 10189, "verse_number": "९-१४-४१", "content_sanskrit": "धन्वन्तरिर्दीर्घतमस आयुर्वेदप्रवर्तकः।\nयज्ञभुग् वासुदेवांशः स्मृतिमात्रार्तिनाशनः॥ ९/१४/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.042.m4a", "display_order": 43}, {"id": 6000189043, "chapter_id": 10189, "verse_number": "९-१४-४२", "content_sanskrit": "तत्पुत्रः केतुमान् यस्य जज्ञे भीमरथस्ततः।\nदिवोदासो द्युमांस्तस्मात् प्रतर्दन इति स्मृतः॥ ९/१४/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.043.m4a", "display_order": 44}, {"id": 6000189044, "chapter_id": 10189, "verse_number": "९-१४-४३", "content_sanskrit": "स एव शत्रुजिद्वत्सो ऋतध्वज इतीरितः।\nतथा कुवलयाश्वेति प्रोक्तोऽलर्कादयस्ततः॥ ९/१४/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.044.m4a", "display_order": 45}, {"id": 6000189045, "chapter_id": 10189, "verse_number": "९-१४-४४", "content_sanskrit": "षष्ठिवर्षसहस्‍त्राणि षष्ठिवर्षशतानि च।\nनालर्कादपरो राजा बुभुजे मेदिनीं युवा॥ ९/१४/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.045.m4a", "display_order": 46}, {"id": 6000189046, "chapter_id": 10189, "verse_number": "९-१४-४५", "content_sanskrit": "अलर्कात् सन्ततिस्तस्मात् सुनीथोऽथ सुकेतनः।\nधर्मकेतुः सुतस्तस्मात् सत्यकेतुरजायत॥ ९/१४/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.046.m4a", "display_order": 47}, {"id": 6000189047, "chapter_id": 10189, "verse_number": "९-१४-४६", "content_sanskrit": "धृष्टकेतुस्ततस्तस्मात् सुकुमारः क्षितीश्वरः।\nवीतिहोत्रोऽस्य भर्गोऽतो भार्गभूमिरभून्नृपः॥ ९/१४/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.047.m4a", "display_order": 48}, {"id": 6000189048, "chapter_id": 10189, "verse_number": "९-१४-४७", "content_sanskrit": "इतीमे काश्यजा भूपाः क्षत्रवृद्धान्ववायिनः।\nरम्भस्य रभसः पुत्रो गम्भीरश्चक्रकस्ततः॥ ९/१४/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.048.m4a", "display_order": 49}, {"id": 6000189049, "chapter_id": 10189, "verse_number": "९-१४-४८", "content_sanskrit": "तस्य क्षेत्रे ब्रह्म जज्ञे शृणु वंशमनेनसः।\nशुद्धस्ततः शुचिस्तस्मात् त्रिककुद् धर्मसारथिः॥ ९/१४/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.049.m4a", "display_order": 50}, {"id": 6000189050, "chapter_id": 10189, "verse_number": "९-१४-४९", "content_sanskrit": "ततः शान्तरया जज्ञे कृतकृत्यः स आत्मवान्।\nरजेः पञ्चशतान्यासन् पुत्राणाममितौजसाम्॥ ९/१४/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.050.m4a", "display_order": 51}, {"id": 6000189051, "chapter_id": 10189, "verse_number": "९-१४-५०", "content_sanskrit": "देवैरभ्यर्थितो दैत्यान् हत्वेन्द्रायाददाद् दिवम्।\nइन्द्रस्तस्मै पुनर्दत्त्वा गृहीत्वा चरणौ रजेः॥ ९/१४/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.051.m4a", "display_order": 52}, {"id": 6000189052, "chapter_id": 10189, "verse_number": "९-१४-५१", "content_sanskrit": "आत्मानमर्थयामास प्रह्लादात् परिशङ्कितः।\nपितर्युपरते पुत्रा याचमानाय नो ददुः॥ ९/१४/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.052.m4a", "display_order": 53}, {"id": 6000189053, "chapter_id": 10189, "verse_number": "९-१४-५२", "content_sanskrit": "त्रिविष्टपं महेन्द्राय यज्ञभागान् समाददुः।\nगुरुणा हूयमानेऽग्नौ बलभित् तनयान् रजेः॥ ९/१४/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.053.m4a", "display_order": 54}, {"id": 6000189054, "chapter_id": 10189, "verse_number": "९-१४-५३", "content_sanskrit": "अवधीद् भ्रांशितान् मार्गान्न कश्चिदवशेषितः।\nप्रतिक्षत्रः क्षत्रवृद्धात् सञ्जयस्तत्सुतो जयः॥ ९/१४/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.054.m4a", "display_order": 55}, {"id": 6000189055, "chapter_id": 10189, "verse_number": "९-१४-५४", "content_sanskrit": "ततः कृतः कृतस्यापि जज्ञे वीर्यधनस्ततः।\nसहदेवस्ततोऽहीनो जयत्सेनस्तु तत्सुतः॥ ९/१४/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.055.m4a", "display_order": 56}, {"id": 6000189056, "chapter_id": 10189, "verse_number": "९-१४-५५", "content_sanskrit": "सङ्कृतिस्तस्य च जयः क्षत्रधर्मा महारथः।\nक्षत्रवृद्धान्वया भूपा इमे शृण्वथ नाहुषान्॥ ९/१४/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_014/BhP_09.014.056.m4a", "display_order": 57}, {"id": 6000189057, "chapter_id": 10189, "verse_number": null, "content_sanskrit": "इति श्रीमद्भागवते वैयासिक्यां संहितायां नवमस्कन्धे चतुर्दशाध्यायः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]