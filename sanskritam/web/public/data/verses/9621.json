[{"id": 5000621000, "chapter_id": 9621, "verse_number": "७-८६-१", "content_sanskrit": "तदा वृत्रवधं सर्वमखिलेन स लक्ष्मणः ।\nकथयित्वा नरश्रेष्ठः कथाशेषं प्रचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000621001, "chapter_id": 9621, "verse_number": "७-८६-२", "content_sanskrit": "ततो हते महावीर्ये वृत्रे देवभयङ्करे ।\nब्रह्महत्यावृतः शक्रः सञ्ज्ञां लेभे न वृत्रहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000621002, "chapter_id": 9621, "verse_number": "७-८६-३", "content_sanskrit": "सो ऽन्तमाश्रित्य लोकानां नष्टसञ्ज्ञो विचेतनः ।\nकालं तत्रावसत्कञ्चिद्वेष्टमान इवोरगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000621003, "chapter_id": 9621, "verse_number": "७-८६-४", "content_sanskrit": "अथ नष्टे सहस्राक्षे उद्विग्नमभवज्जगत् ।\nभूमिश्च ध्वस्तसङ्काशा निःस्नेहा शुष्ककानना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000621004, "chapter_id": 9621, "verse_number": "७-८६-५", "content_sanskrit": "निःस्रोतसश्च ते सर्वे तु ह्रदाश्च सरितस्तथा ।\nसङ्क्षोभश्चैव सत्त्वानामनावृष्टिकृतो ऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000621005, "chapter_id": 9621, "verse_number": "७-८६-६", "content_sanskrit": "क्षीयमाणे तु लोके ऽस्मिन्सम्भ्रान्तमनसः सुराः ।\nयदुक्तं विष्णुना पूर्वं तं यज्ञं समुपानयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000621006, "chapter_id": 9621, "verse_number": "७-८६-७", "content_sanskrit": "ततः सर्वे सुरगणाः सोपाध्यायाः सहर्षिभिः ।\nतं देशं समुपाजग्मुर्यत्रेन्द्रो भयमोहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000621007, "chapter_id": 9621, "verse_number": "७-८६-८", "content_sanskrit": "ते तु दृष्ट्वा सहस्राक्षमावृतं ब्रह्महत्यया ।\nतं पुरस्कृत्य देवेशमश्वमेधमुपाक्रमन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000621008, "chapter_id": 9621, "verse_number": "७-८६-९", "content_sanskrit": "ततो ऽश्वमेधः सुमहान्महेन्द्रस्य महात्मनः ।\nववृधे ब्रह्महत्ययाः पावनार्थं नरेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000621009, "chapter_id": 9621, "verse_number": "७-८६-१०", "content_sanskrit": "ततो यज्ञे समाप्ते तु ब्रह्महत्या महात्मनः ।\nअभिगम्याब्रवीद्वाक्यं क्व मे स्थानं विधास्यथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000621010, "chapter_id": 9621, "verse_number": "७-८६-११", "content_sanskrit": "ते तामूचुस्तदा देवास्तुष्टाः प्रीतिसमन्विताः ।\nचतुर्धा विभजात्मानमात्मनैव दुरासदे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000621011, "chapter_id": 9621, "verse_number": "७-८६-१२", "content_sanskrit": "देवानां भाषितं श्रुत्वा ब्रह्महत्या महात्मनाम् ।\nसन्निधौ स्थानमन्यत्र वरयामास दुर्वसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000621012, "chapter_id": 9621, "verse_number": "७-८६-१३", "content_sanskrit": "एकेनांशेन वत्स्यामि पूर्णोदासु नदीषु वै ।\nचतुरो वार्षिकान्मासान्दर्पघ्नी कामवारिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000621013, "chapter_id": 9621, "verse_number": "७-८६-१४", "content_sanskrit": "भूम्यामहं सर्वकालमेकेनांशेन सर्वदा ।\nवसिष्यामि न सन्देहः सत्येनैतद्ब्रवीमि वः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000621014, "chapter_id": 9621, "verse_number": "७-८६-१५", "content_sanskrit": "यो ऽयमंशस्तृतीयो मे स्त्रीषु यौवनशालिषु ।\nत्रिरात्रं दर्पपूर्णासु वशिष्ये दर्पघातिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000621015, "chapter_id": 9621, "verse_number": "७-८६-१६", "content_sanskrit": "हन्तारो ब्राह्मणान्ये तु मृषापूर्वमदूषकान् ।\nतांश्चतुर्थेन भागेन संश्रयिष्ये सुरर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000621016, "chapter_id": 9621, "verse_number": "७-८६-१७", "content_sanskrit": "प्रत्यूचुस्तां ततो देवा यथा वदसि दुर्वसे ।\nतथा भवतु तत्सर्वं साधयस्व यदीप्सितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000621017, "chapter_id": 9621, "verse_number": "७-८६-१८", "content_sanskrit": "ततः प्रीत्या ऽन्विता देवाः सहस्राक्षं ववन्दिरे ।\nविज्वरः स च पूतात्मा वासवः समपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000621018, "chapter_id": 9621, "verse_number": "७-८६-१९", "content_sanskrit": "प्रशान्तं च जगत्सर्वं सहस्राक्षे प्रतिष्ठिते ।\nयज्ञं चाद्भुतसङ्काशं तदा शक्रो ऽभ्यपूजयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000621019, "chapter_id": 9621, "verse_number": "७-८६-२०", "content_sanskrit": "ईदृशो ह्यश्वमेधस्य प्रसादो रघुनन्दन ।\nयजस्व सुमहाभाग हयमेधेन पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000621020, "chapter_id": 9621, "verse_number": "७-८६-२१", "content_sanskrit": "इति लक्ष्मणवाक्यमुत्तमं नृपतिरतीव मनोहरं महात्मा ।\nपरितोषमवाप हृष्टचेता निशमय्येन्द्रसमानविक्रमौजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000621021, "chapter_id": 9621, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे षडशीतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]