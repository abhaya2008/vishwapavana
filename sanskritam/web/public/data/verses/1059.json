[{"id": 2002654, "chapter_id": 1059, "verse_number": "१-६०-०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2002655, "chapter_id": 1059, "verse_number": "१-६०-१", "content_sanskrit": "श्रुत्वा तु सर्पसत्राय दीक्षितं जनमेजयम्।\nअभ्यगच्छदृषिर्विद्वान्कृष्णद्वैपायनस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2002656, "chapter_id": 1059, "verse_number": "१-६०-२", "content_sanskrit": "जनयामास यं काली शक्तेः पुत्रात्पराशरात्।\nकन्यैव यमुनाद्वीपे पाण्डवानां पितामहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2002657, "chapter_id": 1059, "verse_number": "१-६०-३", "content_sanskrit": "जातमात्रश्च यः सद्य इष्ट्या देहमवीवृधत्।\nवेदांश्चाधिजगे साङ्गन्सेतिहासान्महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2002658, "chapter_id": 1059, "verse_number": "१-६०-४", "content_sanskrit": "यं नाति तपसा कश्चिन्न वेदाध्ययनेन च।\nन व्रतैर्नोपवासैश्च न प्रसूत्या न मन्युना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2002659, "chapter_id": 1059, "verse_number": "१-६०-५", "content_sanskrit": "विव्यासैकं चतुर्धा यो वेदं वेदविदां वरः।\nपरावरज्ञो ब्रह्मर्षिः कविः सत्यव्रतः शुचिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2002660, "chapter_id": 1059, "verse_number": "१-६०-६", "content_sanskrit": "यः पाण्डुं धृतराष्ट्रं च विदुरं चाप्यजीजनत्।\nशन्तनोः संततिं तन्वन्पुण्यकीर्तिर्महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2002661, "chapter_id": 1059, "verse_number": "१-६०-७", "content_sanskrit": "जनमेजयस्य राजर्षेः स महात्मा सदस्तथा।\nविवेश सहितः शिष्यैर्वेदवेदाङ्गपारगैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2002662, "chapter_id": 1059, "verse_number": "१-६०-८", "content_sanskrit": "तत्र राजानमासीनं ददर्श जनमेजयम्।\nवृतं सदस्यैर्बहुभिर्देवैरिव पुरन्दरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2002663, "chapter_id": 1059, "verse_number": "१-६०-९", "content_sanskrit": "तथा मूर्धाभिषिक्तैश्च नानाजनपदेश्वरैः।\nऋत्विग्भिर्ब्रह्मकल्पैश्च कुशलैर्यज्ञसंस्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2002664, "chapter_id": 1059, "verse_number": "१-६०-१०", "content_sanskrit": "जनमेजयस्तु राजर्षिर्दृष्ट्वा तमृषिमागतम्।\nसगणोऽभ्युद्ययौ तूर्णं प्रीत्या भरतसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2002665, "chapter_id": 1059, "verse_number": "१-६०-११", "content_sanskrit": "काञ्चनं विष्टरं तस्मै सदस्यानुमतः प्रभुः।\nआसनं कल्पयामास यथा शक्रो बृहस्पतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2002666, "chapter_id": 1059, "verse_number": "१-६०-१२", "content_sanskrit": "तत्रोपविष्टं वरदं देवर्षिगणपूजितम्।\nपूजयामास राजेन्द्रः शास्त्रदृष्टेन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2002667, "chapter_id": 1059, "verse_number": "१-६०-१३", "content_sanskrit": "पाद्यमाचमनीयं च अर्घ्यं गां च विधानतः।\nपितामहाय कृष्णाय तदर्हाय न्यवेदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2002668, "chapter_id": 1059, "verse_number": "१-६०-१४", "content_sanskrit": "प्रतिगृह्य तु तां पूजां पाम्डवाज्जनमेजयात्।\nगां चैव समनुज्ञाय व्यासः प्रीतोऽभवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2002669, "chapter_id": 1059, "verse_number": "१-६०-१५", "content_sanskrit": "तथा च पूजयित्वा तं प्रणयात्प्रतितामहम्।\nउपोपविश्य प्रीतात्मा पर्यपृच्छदनामयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2002670, "chapter_id": 1059, "verse_number": "१-६०-१६", "content_sanskrit": "भगवानापि तं दृष्ट्वा कुशलं प्रतिवेद्य च।\nसदस्यैः पूजितः सर्वैः सदस्यान्प्रत्यपूजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2002671, "chapter_id": 1059, "verse_number": "१-६०-१७", "content_sanskrit": "ततस्तु सहितः सर्वैः सदस्यैर्जनमेजयः।\nइदं पश्चाद्द्विजश्रेष्ठं पर्यपृच्छत्कृताञ्जलिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2002672, "chapter_id": 1059, "verse_number": "१-६०-१८x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2002673, "chapter_id": 1059, "verse_number": "१-६०-१८", "content_sanskrit": "कुरूणां पाण्डवानां च भवान्प्रत्यक्षदर्शिवान्।\nतेषां चरितमिच्छामि कथ्यमानं त्वया द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2002674, "chapter_id": 1059, "verse_number": "१-६०-१९", "content_sanskrit": "कथं समभवद्भेदस्तेषामक्लिष्टकर्मणाम्।\nतच्च युद्धं कथं वृत्तं भूतान्तकरणं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2002675, "chapter_id": 1059, "verse_number": "१-६०-२०", "content_sanskrit": "पितामहानां सर्वेषां दैवेनाविष्टचेतसाम्।\nकार्त्स्न्येनैतन्ममाचक्ष्व यथा वृत्तं द्विजोत्तम।\nइच्छामि तत्त्वतः श्रोतुं भगवन्कुशलो ह्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2002676, "chapter_id": 1059, "verse_number": "१-६०-२१x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2002677, "chapter_id": 1059, "verse_number": "१-६०-२१", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा कृष्णद्वैपायनस्तदा।\nशशास शिष्यमासीनं वैशम्पायनमन्तिके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2002678, "chapter_id": 1059, "verse_number": "१-६०-२२x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2002679, "chapter_id": 1059, "verse_number": "१-६०-२२", "content_sanskrit": "कुरूणां पाण्डवानां च यथा भेदोऽभवत्पुरा।\nतदस्मै सर्वमाचक्ष्व यन्मत्तः श्रुतवानसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2002680, "chapter_id": 1059, "verse_number": "१-६०-२३", "content_sanskrit": "गुरोर्वचनमाज्ञाय स तु विप्रर्षभस्तदा।\nआचचक्षे ततः सर्वमितिहासं पुरातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2002681, "chapter_id": 1059, "verse_number": "१-६०-२४", "content_sanskrit": "राज्ञे तस्मै सदस्येभ्यः पार्थिवेभ्यश्च सर्वशः।\nभेदं सर्वविनाशं च कुरुपाण्डवयोस्तदा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2002682, "chapter_id": 1059, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि अंशावतरणपर्वणि षष्टितमोऽध्यायः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]