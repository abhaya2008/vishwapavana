[{"id": 900001140, "chapter_id": 8218, "verse_number": "7.1", "content_sanskrit": "अथ हैनं सुकेशा भारद्वाजः पप्रच्छ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900001141, "chapter_id": 8218, "verse_number": "7.2", "content_sanskrit": "तस्मै स होवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900001142, "chapter_id": 8218, "verse_number": "7.3", "content_sanskrit": "स यथेमा नद्यः स्यान्दमानाः समुद्रायणाः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900001143, "chapter_id": 8218, "verse_number": "7.4", "content_sanskrit": "तदेष श्लोकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900001144, "chapter_id": 8218, "verse_number": "7.5", "content_sanskrit": "नमो नमोऽस्तु हरये प्रेष्ठप्रेष्ठतमाय ते । परमानन्दसन्दोहसान्द्रानन्दवपुष्मते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}]