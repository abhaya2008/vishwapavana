[{"id": 40018853, "chapter_id": 9297, "verse_number": "1", "content_sanskrit": "ततःप्रवृत्तंसुक्रूरंरामरावणयोस्तदा । सुमहदद्वैरथंयुद्धंसर्वलोकभयावहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40018854, "chapter_id": 9297, "verse_number": "2", "content_sanskrit": "ततोराक्षससैन्यं च हरीणां च महद्बलम् । प्रगृहीतप्रहरणंनिश्चेष्टंसमवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40018855, "chapter_id": 9297, "verse_number": "3", "content_sanskrit": "सम्प्रयुद्धेतुतौदृष्टवाबलवन्नरराक्षसौ । व्याक्षिप्तहदृयास्सर्वेपरंविस्मयमागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40018856, "chapter_id": 9297, "verse_number": "4", "content_sanskrit": "नाप्रहरणैर्व्यग्रैर्भुजैर्विस्मितबुद्धयः । तस्थुःप्रेक्षय च सर्वेतेनाभिजग्मुःपरस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40018857, "chapter_id": 9297, "verse_number": "5", "content_sanskrit": "रक्षसांरावणंचापिवानराणां च राघवम् । पश्यतांविस्मिताक्षाणांसैन्यंचित्रमिवाबभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40018858, "chapter_id": 9297, "verse_number": "6", "content_sanskrit": "तौतुतत्रनिमित्तानिदृष्टवाराघवरावणौ । कृतबुद्धीस्थिरामर्षौयुयुधातेह्यभीतवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40018859, "chapter_id": 9297, "verse_number": "7", "content_sanskrit": "जेतव्यमितिकाकुत्स्थोमर्तव्यमितिरावणः । धृतौस्ववीर्यसर्वस्वंयुद्धेऽदर्शयतांतदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40018860, "chapter_id": 9297, "verse_number": "8", "content_sanskrit": "ततःक्रोधाद्धशग्रीवश्शरान्सन्धायवीर्यवान् । मुमोचध्वजमुद्धिस्यराघवस्यरथेस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40018861, "chapter_id": 9297, "verse_number": "9", "content_sanskrit": "तेशरास्तमनासाद्यपुरन्दररथध्वजम् । रथशक्तिंपरामृश्यनिपेतुर्धरणीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40018862, "chapter_id": 9297, "verse_number": "10", "content_sanskrit": "ततोरामोऽपिसङ्क्रुद्धश्चपमाकृष्यवीर्यवान् । कृतप्रतिकृतंकर्तुंमनसस्सम्प्रचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40018863, "chapter_id": 9297, "verse_number": "11", "content_sanskrit": "रावणध्वजमुद्दिस्यमुमोचनिशितंशरम् । महासर्पमिवासह्यंज्वलन्तंस्वेनतेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40018864, "chapter_id": 9297, "verse_number": "12", "content_sanskrit": "रामश्चिक्षेपतेजस्वीकेतुमुद्धिश्यसायकम् । जगाम स महींछित्त्वादशग्रीवध्वजंशरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40018865, "chapter_id": 9297, "verse_number": "13", "content_sanskrit": "स निकृत्तोऽपतद्भूमौरावणस्यन्दनध्वजः । ध्वजस्योन्मथनंदृष्टवारावणस्समहाबलः ॥ सम्प्रदीप्तोऽभवत्क्रोधादमर्षात्प्रहसन्निव । स रोषवशमापन्नश्शरवर्षंववर्ष ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40018866, "chapter_id": 9297, "verse_number": "14", "content_sanskrit": "स निकृत्तोऽपतद्भूमौरावणस्यन्दनध्वजः । ध्वजस्योन्मथनंदृष्टवारावणस्समहाबलः ॥ सम्प्रदीप्तोऽभवत्क्रोधादमर्षात्प्रहसन्निव । स रोषवशमापन्नश्शरवर्षंववर्ष ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40018867, "chapter_id": 9297, "verse_number": "15", "content_sanskrit": "रामस्यतुरगान्दीप्तै: शरैर्विव्याथरावणः । तेदिव्याहरयस्तत्रनास्खलन्नापिबभ्रमुः ॥ बभूवुःस्वस्थहृदयाःपद्मनालैरिवाहताः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40018868, "chapter_id": 9297, "verse_number": "16", "content_sanskrit": "तेषामसम्भ्रमंदृष्टवावाजिनांरावणस्तदा ॥ भूयएवसुसङ्क्रुद्धश्शरवर्षंमुमोच ह ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40018869, "chapter_id": 9297, "verse_number": "17", "content_sanskrit": "गदाश्चपरिघांश्चैवचक्राणिमुसलानि च ॥ गिरिशृङ्गाणिवृक्षांश्चतथाशूलपरश्वधान् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40018870, "chapter_id": 9297, "verse_number": "18", "content_sanskrit": "मायाविहितमेतत्तुशस्त्रवर्षमपातयत् ॥ सहस्रशस्तदाबाणानश्रान्तहृदयोद्यमः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40018871, "chapter_id": 9297, "verse_number": "19", "content_sanskrit": "तुमुलंत्रासजननंभीमंभीमप्रतिस्वनम् ॥ तद्वर्षमभवद्युद्धेनैकशस्त्रमयंमहत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40018872, "chapter_id": 9297, "verse_number": "20", "content_sanskrit": "राघवरथंसमन्ताद्वानरेबले ॥ सायकैरन्तरिक्षं च चकारसुनिरन्तरम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40018873, "chapter_id": 9297, "verse_number": "21", "content_sanskrit": "मुमोच ह दशग्रीवोनिःसङ्गेनान्तरात्मना ॥ व्यायच्छमानंतंदृष्टवासत्वरमरावणंरणे । प्रहसन्निवकाकुत्स्थसन्दधेनिशितान्शरान् ॥ स मुमो च ततोबाणान्शतशोऽथसहस्रशः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40018874, "chapter_id": 9297, "verse_number": "22", "content_sanskrit": "मुमोच ह दशग्रीवोनिःसङ्गेनान्तरात्मना ॥ व्यायच्छमानंतंदृष्टवासत्वरमरावणंरणे । प्रहसन्निवकाकुत्स्थसन्दधेनिशितान्शरान् ॥ स मुमो च ततोबाणान्शतशोऽथसहस्रशः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40018875, "chapter_id": 9297, "verse_number": "23", "content_sanskrit": "तान् दृष्टवारावणश्चक्रेस्वशरैःखंनिरन्तरम् ॥ ततस्थाभ्यांप्रमुक्तेनशरवर्षेणभास्वता । शरबद्धमिवाभातिद्वितीयंभास्वदम्भरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40018876, "chapter_id": 9297, "verse_number": "24", "content_sanskrit": "तान् दृष्टवारावणश्चक्रेस्वशरैःखंनिरन्तरम् ॥ ततस्थाभ्यांप्रमुक्तेनशरवर्षेणभास्वता । शरबद्धमिवाभातिद्वितीयंभास्वदम्भरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40018877, "chapter_id": 9297, "verse_number": "25", "content_sanskrit": "नानिमित्तोऽभवद्भाणोनानिर्भेत्ता न निष्फलः । अन्योन्यमभिसम्हत्यनिपेतुर्धरणीतले ॥ तथाविसृजतोर्भाणान् रामरावणयोर्मृथे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40018878, "chapter_id": 9297, "verse_number": "26", "content_sanskrit": "प्रायुध्येतामविच्छिन्नमस्यन्तौसव्यदक्षिणम् ॥ चक्रतुश्चशरैर्घोरैर्निरुच्छवासमिवाम्बरम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40018879, "chapter_id": 9297, "verse_number": "27", "content_sanskrit": "रावणस्यहयान्रामोहयान्रामस्यरावणः ॥ जघ्नतुस्तौतदान्योन्यंकृतानुकृतकारिणौ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40018880, "chapter_id": 9297, "verse_number": "28", "content_sanskrit": "एवंतुतौसुसङ्क्रुद्धौचक्रतुर्युद्धमुत्तमम् ॥ मुहूर्तमभवद्युद्धंतुमुलंरोमहर्षणम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]