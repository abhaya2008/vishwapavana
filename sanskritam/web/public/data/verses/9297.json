[{"id": 5000297000, "chapter_id": 9297, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे पञ्चविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000297001, "chapter_id": 9297, "verse_number": "४-२५-१", "content_sanskrit": "स सुग्रीवं च तारां च साङ्गदां सहलक्ष्मणः।\nसमानशोकः काकुत्स्थः सान्त्वयन्निदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000297002, "chapter_id": 9297, "verse_number": "४-२५-२", "content_sanskrit": "न शोकपरितापेन श्रेयसा युज्यते मृतः।\nयदत्रानन्तरं कार्यं तत् समाधातुमर्हथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000297003, "chapter_id": 9297, "verse_number": "४-२५-३", "content_sanskrit": "लोकवृत्तमनुष्ठेयं कृतं वो बाष्पमोक्षणम्।\nन कालादुत्तरं किंचित् कर्मशक्यमुपासितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000297004, "chapter_id": 9297, "verse_number": "४-२५-४", "content_sanskrit": "नियतिः कारणं लोके नियतिः कर्मसाधनम्।\nनियतिः सर्वभूतानां नियोगेष्विह कारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000297005, "chapter_id": 9297, "verse_number": "४-२५-५", "content_sanskrit": "न कर्ता कस्यचित् कश्चिन्नियोगे नापि चेश्वरः।\nस्वभावे वर्तते लोकस्तस्य कालः परायणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000297006, "chapter_id": 9297, "verse_number": "४-२५-६", "content_sanskrit": "न कालः कालमत्येति न कालः परिहीयते।\nस्वभावं च समासाद्य न कश्चिदतिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000297007, "chapter_id": 9297, "verse_number": "४-२५-७", "content_sanskrit": "न कालस्यास्ति बन्धुत्वं न हेतुर्न पराक्रमः।\nन मित्रज्ञातिसम्बन्धः कारणं नात्मनो वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000297008, "chapter_id": 9297, "verse_number": "४-२५-८", "content_sanskrit": "किं तु कालपरीणामो द्रष्टव्यः साधु पश्यता।\nधर्मश्चार्थश्च कामश्च कालक्रमसमाहिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000297009, "chapter_id": 9297, "verse_number": "४-२५-९", "content_sanskrit": "इतः स्वां प्रकृतिं वाली गतः प्राप्तः क्रियाफलम्।\nसामदानार्थसंयोगैः पवित्रं प्लवगेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000297010, "chapter_id": 9297, "verse_number": "४-२५-१०", "content_sanskrit": "स्वधर्मस्य च संयोगाज्जितस्तेन महात्मना।\nस्वर्गः परिगृहीतश्च प्राणानपरिरक्षता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000297011, "chapter_id": 9297, "verse_number": "४-२५-११", "content_sanskrit": "एषा वै नियतिः श्रेष्ठा यां गतो हरियूथपः।\nतदलं परितापेन प्राप्तकालमुपास्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000297012, "chapter_id": 9297, "verse_number": "४-२५-१२", "content_sanskrit": "वचनान्ते तु रामस्य लक्ष्मणः परवीरहा।\nअवदत् प्रश्रितं वाक्यं सुग्रीवं गतचेतसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000297013, "chapter_id": 9297, "verse_number": "४-२५-१३", "content_sanskrit": "कुरु त्वमस्य सुग्रीव प्रेतकार्यमनन्तरम्।\nताराङ्गदाभ्यां सहितो वालिनो दहनं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000297014, "chapter_id": 9297, "verse_number": "४-२५-१४", "content_sanskrit": "समाज्ञापय काष्ठानि शुष्काणि च बहूनि च।\nचन्दनानि च दिव्यानि वालिसंस्कारकारणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000297015, "chapter_id": 9297, "verse_number": "४-२५-१५", "content_sanskrit": "समाश्वासय दीनं त्वमङ्गदं दीनचेतसम्।\nमा भूर्बालिशबुद्धिस्त्वं त्वदधीनमिदं पुरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000297016, "chapter_id": 9297, "verse_number": "४-२५-१६", "content_sanskrit": "अङ्गदस्त्वानयेन्माल्यं वस्त्राणि विविधानि च।\nघृतं तैलमथो गन्धान् यच्चात्र समनन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000297017, "chapter_id": 9297, "verse_number": "४-२५-१७", "content_sanskrit": "त्वं तार शिबिकां शीघ्रमादायागच्छ सम्भ्रमात्।\nत्वरा गुणवती युक्ता ह्यस्मिन् काले विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000297018, "chapter_id": 9297, "verse_number": "४-२५-१८", "content_sanskrit": "सज्जीभवन्तु प्लवगाः शिबिकावाहनोचिताः।\nसमर्था बलिनश्चैव निर्हरिष्यन्ति वालिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000297019, "chapter_id": 9297, "verse_number": "४-२५-१९", "content_sanskrit": "एवमुक्त्वा तु सुग्रीवं सुमित्रानन्दवर्धनः।\nतस्थौ भ्रातृसमीपस्थो लक्ष्मणः परवीरहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000297020, "chapter_id": 9297, "verse_number": "४-२५-२०", "content_sanskrit": "लक्ष्मणस्य वचः श्रुत्वा तारः सम्भ्रान्तमानसः।\nप्रविवेश गुहां शीघ्रं शिबिकासक्तमानसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000297021, "chapter_id": 9297, "verse_number": "४-२५-२१", "content_sanskrit": "आदाय शिबिकां तारः स तु पर्यापतत् पुनः।\nवानरैरुह्यमानां तां शूरैरुद्वहनोचितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000297022, "chapter_id": 9297, "verse_number": "४-२५-२२", "content_sanskrit": "दिव्यां भद्रासनयुतां शिबिकां स्यन्दनोपमाम्।\nपक्षिकर्मभिराचित्रां द्रुमकर्मविभूषिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000297023, "chapter_id": 9297, "verse_number": "४-२५-२३", "content_sanskrit": "आचितां चित्रपत्तीभिः सुनिविष्टां समन्ततः।\nविमानमिव सिद्धानां जालवातायनायुताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000297024, "chapter_id": 9297, "verse_number": "४-२५-२४", "content_sanskrit": "सुनियुक्तां विशालां च सुकृतां शिल्पिभिः कृताम्।\nदारुपर्वतकोपेतां चारुकर्मपरिष्कृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000297025, "chapter_id": 9297, "verse_number": "४-२५-२५", "content_sanskrit": "वराभरणहारैश्च चित्रमाल्योपशोभिताम्।\nगुहागहनसंछन्नां रक्तचन्दनभूषिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000297026, "chapter_id": 9297, "verse_number": "४-२५-२६", "content_sanskrit": "पुष्पौघैः समभिच्छन्नां पद्ममालाभिरेव च।\nतरुणादित्यवर्णाभिर्भ्राजमानाभिरावृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000297027, "chapter_id": 9297, "verse_number": "४-२५-२७", "content_sanskrit": "ईदृशीं शिबिकां दृष्ट्वा रामो लक्ष्मणमब्रवीत्।\nक्षिप्रं विनीयतां वाली प्रेतकार्यं विधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000297028, "chapter_id": 9297, "verse_number": "४-२५-२८", "content_sanskrit": "ततो वालिनमुद्यम्य सुग्रीवः शिबिकां तदा।\nआरोपयत विक्रोशन्नङ्गदेन सहैव तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000297029, "chapter_id": 9297, "verse_number": "४-२५-२९", "content_sanskrit": "आरोप्य शिबिकां चैव वालिनं गतजीवितम्।\nअलंकारैश्च विविधैर्माल्यैर्वस्त्रैश्च भूषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000297030, "chapter_id": 9297, "verse_number": "४-२५-३०", "content_sanskrit": "आज्ञापयत् तदा राजा सुग्रीवः प्लवगेश्वरः।\nऔर्ध्वदेहिकमार्यस्य क्रियतामनुकूलतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000297031, "chapter_id": 9297, "verse_number": "४-२५-३१", "content_sanskrit": "विश्राणयन्तो रत्नानि विविधानि बहूनि च।\nअग्रतः प्लवगा यान्तु शिबिका तदनन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000297032, "chapter_id": 9297, "verse_number": "४-२५-३२", "content_sanskrit": "राज्ञामृद्धिविशेषा हि दृश्यन्ते भुवि यादृशाः।\nतादृशैरिह कुर्वन्तु वानरा भर्तृसत्क्रियाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000297033, "chapter_id": 9297, "verse_number": "४-२५-३३", "content_sanskrit": "तादृशं वालिनः क्षिप्रं प्राकुर्वन्नौर्ध्वदेहिकम्।\nअङ्गदं परिरभ्याशु तारप्रभृतयस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000297034, "chapter_id": 9297, "verse_number": "४-२५-३४", "content_sanskrit": "क्रोशन्तः प्रययुः सर्वे वानरा हतबान्धवाः।\nततः प्रणिहिताः सर्वा वानर्योऽस्य वशानुगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000297035, "chapter_id": 9297, "verse_number": "४-२५-३५", "content_sanskrit": "चुक्रुशुर्वीरवीरेति भूयः क्रोशन्ति ताः प्रियम्।\nताराप्रभृतयः सर्वा वानर्यो हतबान्धवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000297036, "chapter_id": 9297, "verse_number": "४-२५-३६", "content_sanskrit": "अनुजग्मुश्च भर्तारं क्रोशन्त्यः करुणस्वनाः।\nतासां रुदितशब्देन वानरीणां वनान्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000297037, "chapter_id": 9297, "verse_number": "४-२५-३७", "content_sanskrit": "वनानि गिरयश्चैव विक्रोशन्तीव सर्वतः।\nपुलिने गिरिनद्यास्तु विविक्ते जलसंवृते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000297038, "chapter_id": 9297, "verse_number": "४-२५-३८", "content_sanskrit": "चितां चक्रुः सुबहवो वानरा वनचारिणः।\nअवरोप्य ततः स्कन्धाच्छिबिकां वानरोत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000297039, "chapter_id": 9297, "verse_number": "४-२५-३९", "content_sanskrit": "तस्थुरेकान्तमाश्रित्य सर्वे शोकपरायणाः।\nततस्तारा पतिं दृष्ट्वा शिबिकातलशायिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000297040, "chapter_id": 9297, "verse_number": "४-२५-४०", "content_sanskrit": "आरोप्याङ्के शिरस्तस्य विललाप सुदुःखिता।\nहा वानरमहाराज हा नाथ मम वत्सल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000297041, "chapter_id": 9297, "verse_number": "४-२५-४१", "content_sanskrit": "हा महार्ह महाबाहो हा मम प्रिय पश्य माम्।\nजनं न पश्यसीमं त्वं कस्माच्छोकाभिपीडितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000297042, "chapter_id": 9297, "verse_number": "४-२५-४२", "content_sanskrit": "प्रहृष्टमिह ते वक्त्रं गतासोरपि मानद।\nअस्तार्कसमवर्णं च दृश्यते जीवतो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000297043, "chapter_id": 9297, "verse_number": "४-२५-४३", "content_sanskrit": "एष त्वां रामरूपेण कालः कर्षति वानर।\nयेन स्म विधवाः सर्वाः कृता एकेषुणा रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000297044, "chapter_id": 9297, "verse_number": "४-२५-४४", "content_sanskrit": "इमास्तास्तव राजेन्द्र वानर्योऽप्लवगास्तव।\nपादैर्विकृष्टमध्वानमागताः किं न बुध्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000297045, "chapter_id": 9297, "verse_number": "४-२५-४५", "content_sanskrit": "तवेष्टा ननु चैवेमा भार्याश्चन्द्रनिभाननाः।\nइदानीं नेक्षसे कस्मात् सुग्रीवं प्लवगेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000297046, "chapter_id": 9297, "verse_number": "४-२५-४६", "content_sanskrit": "एते हि सचिवा राजंस्तारप्रभृतयस्तव।\nपुरवासिजनश्चायं परिवार्य विषीदति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000297047, "chapter_id": 9297, "verse_number": "४-२५-४७", "content_sanskrit": "विसर्जयैनान् सचिवान् यथापुरमरिंदम।\nततः क्रीडामहे सर्वा वनेषु मदनोत्कटाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000297048, "chapter_id": 9297, "verse_number": "४-२५-४८", "content_sanskrit": "एवं विलपतीं तारां पतिशोकपरीवृताम्।\nउत्थापयन्ति स्म तदा वानर्यः शोककर्शिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000297049, "chapter_id": 9297, "verse_number": "४-२५-४९", "content_sanskrit": "सुग्रीवेण ततः सार्धं सोऽङ्गदः पितरं रुदन्।\nचितामारोपयामास शोकेनाभिप्लुतेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000297050, "chapter_id": 9297, "verse_number": "४-२५-५०", "content_sanskrit": "ततोऽग्निं विधिवद् दत्त्वा सोऽपसव्यं चकार ह।\nपितरं दीर्घमध्वानं प्रस्थितं व्याकुलेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000297051, "chapter_id": 9297, "verse_number": "४-२५-५१", "content_sanskrit": "संस्कृत्य वालिनं तं तु विधिवत् प्लवगर्षभाः।\nआजग्मुरुदकं कर्तुं नदीं शुभजलां शिवाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000297052, "chapter_id": 9297, "verse_number": "४-२५-५२", "content_sanskrit": "ततस्ते सहितास्तत्र ह्यङ्गदं स्थाप्य चाग्रतः।\nसुग्रीवतारासहिताः सिषिचुर्वालिने जलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000297053, "chapter_id": 9297, "verse_number": "४-२५-५३", "content_sanskrit": "सुग्रीवेणैव दीनेन दीनो भूत्वा महाबलः।\nसमानशोकः काकुत्स्थः प्रेतकार्याण्यकारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000297054, "chapter_id": 9297, "verse_number": "४-२५-५४", "content_sanskrit": "ततोऽथ तं वालिनमग्र्यपौरुषं\nप्रकाशमिक्ष्वाकुवरेषुणा हतम्।\nप्रदीप्य दीप्ताग्निसमौजसं तदा\nसलक्ष्मणं राममुपेयिवान् हरिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000297055, "chapter_id": 9297, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे पञ्चविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]