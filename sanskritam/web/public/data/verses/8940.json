[{"id": 40005266, "chapter_id": 8940, "verse_number": "1", "content_sanskrit": "ततो नान्दीमुखीं रात्रिं भरतं सूतमागधाः। तुष्टुवुर्वाग्विशेषज्ञास्स्तवैर्मङ्गलसंहितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40005267, "chapter_id": 8940, "verse_number": "2", "content_sanskrit": "सुवर्णकोणाभिहतः प्राणदद्यामदुन्दुभिः। दध्मुश्शङ्खांश्च शतशो नादांश्चोच्चावचस्वरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40005268, "chapter_id": 8940, "verse_number": "3", "content_sanskrit": "स तूर्यघोष स्सुमहान्दिवमापूरयन्निव। भरतं शोकसन्तप्तं भूयश्शोकैररन्ध्रयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40005269, "chapter_id": 8940, "verse_number": "4", "content_sanskrit": "ततः प्रबुद्धो भरतस्तं घोषं सन्निवर्त्य च। नाहं राजेति चाप्युक्त्वा शत्रुघ्नमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40005270, "chapter_id": 8940, "verse_number": "5", "content_sanskrit": "पश्य शत्रुघ्न कैकेय्या लोकस्यापकृतं महत्। विसृज्य मयि दुःखानि राजा दशरथो गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40005271, "chapter_id": 8940, "verse_number": "6", "content_sanskrit": "तस्यैषा धर्मराजस्य धर्ममूला महात्मनः। परिभ्रमति राज्य श्रीर्नौरिवाकर्णिका जले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40005272, "chapter_id": 8940, "verse_number": "7", "content_sanskrit": "यो हि न स्सुमहान्नाथस्सोऽपि प्रव्राजितो वनम्। अनया धर्ममुत्सृज्य मात्रा मे राघवस्स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40005273, "chapter_id": 8940, "verse_number": "8", "content_sanskrit": "इत्येवं भरतं प्रेक्ष्य विलपन्तं विचेतनम्। कृपणं रुरुदुस्सर्वास्सस्वरं योषित स्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40005274, "chapter_id": 8940, "verse_number": "9", "content_sanskrit": "तथा तस्मिन्विलपति वसिष्ठो राजधर्मवित्। सभामिक्ष्वाकुनाथस्य प्रविवेश महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40005275, "chapter_id": 8940, "verse_number": "10", "content_sanskrit": "शातकुम्भमयीं रम्यां मणिरत्नसमाकुलाम्। सुधर्मामिव धर्मात्मा सगणः प्रत्यपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40005276, "chapter_id": 8940, "verse_number": "11", "content_sanskrit": "स काञ्चनमयं पीठं सुखास्तरणसंवृतम्। अध्यास्त सर्ववेदज्ञो दूताननुशशास च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40005277, "chapter_id": 8940, "verse_number": "12", "content_sanskrit": "ब्राह्मणान् क्षत्रियान्वैश्यनमात्यान्गणवल्लभान्। क्षिप्रमानयताऽव्यग्राः कृत्यमात्ययिकं हि नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40005278, "chapter_id": 8940, "verse_number": "13", "content_sanskrit": "सराजभृत्यं शत्रुघ्नं भरतं च यशस्विनम्। युधाजितं सुमन्त्रं च ये च तत्र हिता जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40005279, "chapter_id": 8940, "verse_number": "14", "content_sanskrit": "ततो हलहलाशब्दस्सुमहान्समपद्यत। रथैरश्वैर्गजैश्चापि जनानामुपगच्छताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40005280, "chapter_id": 8940, "verse_number": "15", "content_sanskrit": "ततो भरतमायान्तं शतक्रतुमिवामराः। प्रत्यनन्दन्प्रकृतयो यथा दशरथं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40005281, "chapter_id": 8940, "verse_number": "16", "content_sanskrit": "ह्रद इव तिमिनागसंवृतः स्तिमितजलो मणिशङ्खशर्करः। दशरथसुतशोभिता सभा सदशरथेव बभौ यथा पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]