[{"id": 7002565000, "chapter_id": 22565, "verse_number": "२-११-१", "content_sanskrit": "सूत उवाच ।\nअथ तंत्रविधिं वक्ष्ये पुराणेष्वपि गीयते ।\nतन्त्रे चैव प्रतिष्ठां च कुर्यात्पुण्यतमेऽहनि ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002565001, "chapter_id": 22565, "verse_number": "२-११-२", "content_sanskrit": "शतवृक्षक्षुद्रवृक्षे दशद्वादश वृक्षके ।\nदृष्टिमात्रांतरे सेतौ कूपयागे समुत्सृजेत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002565002, "chapter_id": 22565, "verse_number": "२-११-३", "content_sanskrit": "न कूपमुत्सृजेज्जातु वृक्षयागे कथंचन ।\nतुलसीवनयागे तु न चान्यं यागमाचरेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002565003, "chapter_id": 22565, "verse_number": "२-११-४", "content_sanskrit": "तडागयागे सेत्वादीन्न चारामे कदाचन ।\nन सेतुं देवयागे तु तडागं न समुत्सृजेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002565004, "chapter_id": 22565, "verse_number": "२-११-५", "content_sanskrit": "तंत्रे श्राद्धं पृथङ्नास्ति कर्तुर्भेदे पृथग्भवेत् ।\nशिवलिंगस्थापनायां न चान्यद्देवस्थापनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002565005, "chapter_id": 22565, "verse_number": "२-११-६", "content_sanskrit": "स्वदेशे वर्जयेत्तं तं स्वतन्त्रेण विधीयते ।\nविपरीते कृते चापि आयुःक्षय इति स्मृतिः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002565006, "chapter_id": 22565, "verse_number": "२-११-७", "content_sanskrit": "तडागे पुष्करिण्या वा आरामेऽपि द्विजोत्तमाः ।\nमानहीने मानपूर्णे दशहस्ते न दूषणम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002565007, "chapter_id": 22565, "verse_number": "२-११-८", "content_sanskrit": "द्विसहस्राधिकं यत्र तत्प्रतिष्ठां समाचरेत् ।\nदश द्वादशवृक्षे च आरामे पूर्ववद्द्विजाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002565008, "chapter_id": 22565, "verse_number": "२-११-९", "content_sanskrit": "प्रतिष्ठां बिल्ववृक्षे च अन्यथा कर्णवेधनम् ।\nकुर्याद्दोहददानं च तत्र निर्मंथनादिकम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002565009, "chapter_id": 22565, "verse_number": "२-११-१०", "content_sanskrit": "अनंतरं प्रदातव्या लाजा मूर्ध्न्यक्षतादिकम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]