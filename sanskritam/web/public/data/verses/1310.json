[{"id": 2014873, "chapter_id": 1310, "verse_number": "२-५१-१", "content_sanskrit": "वैशम्पायन उवाच॥\nएवमुक्ते तु कौन्तेयस्ततः कौरवनन्दनः।\nआबभाषे पुनर्भीष्णे धर्मराजो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2014874, "chapter_id": 1310, "verse_number": "२-५१-२", "content_sanskrit": "भूय एव मनुष्येन्द्र उपेन्द्रस्य यशस्विनः।\nजन्म वृष्णिषु विज्ञातुमिच्छामि वदतां वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2014875, "chapter_id": 1310, "verse_number": "२-५१-३", "content_sanskrit": "यथैव भगवाञ्जातः क्षिताविह जनार्दनः।\nमाधवेषु महाबुद्धिस्तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2014876, "chapter_id": 1310, "verse_number": "२-५१-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2014877, "chapter_id": 1310, "verse_number": "२-५१-४", "content_sanskrit": "एवमुक्तस्ततो भीष्मः केशवस्य महात्मनः।\nमाधवेषु तथा जन्म कथयामास वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2014878, "chapter_id": 1310, "verse_number": "२-५१-५", "content_sanskrit": "हन्त ते कथयिष्यामि युधिष्ठिर यथातथम्।\nयतो नारायणस्येह जन्म वृष्णिषु कौरव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2014879, "chapter_id": 1310, "verse_number": "२-५१-६", "content_sanskrit": "पुरा लोके महाराज वर्तमाने कृते युगे।\nआसीत्रैलोक्यविख्यातः सङ्ग्रामस्तारकामयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2014880, "chapter_id": 1310, "verse_number": "२-५१-७", "content_sanskrit": "विरोचनो मयस्तारो वराहः श्वेत एव च।\nविप्रचित्तिः प्रलम्बश्च वृत्रजम्भबलादयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2014881, "chapter_id": 1310, "verse_number": "२-५१-८", "content_sanskrit": "नमुचिः कालनेमिश्च प्रह्लाद इति विश्रुतः।\nलम्बः किशोरः स्वर्भानुररिष्टो राक्षसेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2014882, "chapter_id": 1310, "verse_number": "२-५१-९", "content_sanskrit": "एते चान्ये च बहवो दैत्यसङ्घाः सहस्रशः।\nनानाशस्त्रधरा राजन्नानाभूषणवाहनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2014883, "chapter_id": 1310, "verse_number": "२-५१-१०", "content_sanskrit": "देवतानामभिमुखास्तस्थुर्दैतेयदानवाः।\nदेवास्तु युध्यमानास्ते दानवानभ्ययू रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2014884, "chapter_id": 1310, "verse_number": "२-५१-११", "content_sanskrit": "आदित्या वसवो रुद्राः साध्या विश्वे मरुद्गणाः।\nइन्द्रो यमश्च वरुणश्चन्द्रश्चैव धनेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2014885, "chapter_id": 1310, "verse_number": "२-५१-१२", "content_sanskrit": "अश्विनौ च महावीर्यौ ये चान्ये देवतागणाः।\nचक्रुर्युद्धं महाघोरं दानवैश्च यथाक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2014886, "chapter_id": 1310, "verse_number": "२-५१-१३", "content_sanskrit": "युध्यमानाः समेयुश्च देवा दैतेयदानवैः।\nतद्युद्धमभवद्घोरं देवदानवसङ्कुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2014887, "chapter_id": 1310, "verse_number": "२-५१-१४", "content_sanskrit": "ताभ्यां बलाभ्यां सञ्जज्ञे तुमुलो विग्रहस्तदा।\nतीक्ष्णशस्त्रैः किरन्तोऽथ अभ्ययुर्देवदानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2014888, "chapter_id": 1310, "verse_number": "२-५१-१५", "content_sanskrit": "घ्रन्ति देवान्सगन्धर्वान्सयक्षोरगचारणान्।\nते वध्यमाना दैतेयैर्देवसङ्घास्तदा रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2014889, "chapter_id": 1310, "verse_number": "२-५१-१६", "content_sanskrit": "त्रातारं मनसा जग्मुर्देवं नारायमं प्रभुम्।\nएतस्मिन्नन्तरे तत्र जगाम हरिरीश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2014890, "chapter_id": 1310, "verse_number": "२-५१-१७", "content_sanskrit": "दीपयञ्ज्योतिषा भूमिं शङ्खचक्रगदाधरः।\nतमागतं सुपर्णस्थं विष्णुं लोकनमस्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2014891, "chapter_id": 1310, "verse_number": "२-५१-१८", "content_sanskrit": "दृष्ट्वा मुदा युताः सर्वे भयं त्यक्त्वा रमे सुराः।\nचक्रुर्युद्धं पुनः सर्वे देवा दैतेयदानवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2014892, "chapter_id": 1310, "verse_number": "२-५१-१९", "content_sanskrit": "तद्युद्धमभवद्घोरमचिन्त्यं रोमहर्षणम्।\nजघ्रुर्दैत्यान्त्रणे घोराः सर्वे शक्रपुरोगमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2014893, "chapter_id": 1310, "verse_number": "२-५१-२०", "content_sanskrit": "ते बाध्यमाना बिबुधैर्दुद्रुवुदैत्यदानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2014894, "chapter_id": 1310, "verse_number": "२-५१-२१", "content_sanskrit": "विद्रुतान्दानवान्दृष्ट्वा तदा भारत संयुगे।\nकालनेमिरिति ख्यातो दानवः प्रत्यदृश्यता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2014895, "chapter_id": 1310, "verse_number": "२-५१-२२", "content_sanskrit": "शत्रुप्रहरणे घोरः शतबाहुः शताननः।\nशतशीर्षः स्थितः श्रीमाञ्छतशृङ्गं इवाचलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2014896, "chapter_id": 1310, "verse_number": "२-५१-२३", "content_sanskrit": "भास्कराकारमुकुटः शिञ्जिताभरणाङ्गदः।\nधूम्रकेतुर्हरिश्मश्रुर्निर्दष्टोष्ठपुटाननः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2014897, "chapter_id": 1310, "verse_number": "२-५१-२४", "content_sanskrit": "त्रैलोक्यान्तरविस्तारं धारयन्विपुलं वपुः।\nतर्जयन्वै रणे देवाञ्छादयन्वै दिशो दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2014898, "chapter_id": 1310, "verse_number": "२-५१-२५", "content_sanskrit": "अभ्यधावत्सुसङ्क्रुद्धो व्यादितास्य इवान्तकः।\nतत्र शस्त्रप्रतानैश्च देवान्धर्षितवान्त्रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2014899, "chapter_id": 1310, "verse_number": "२-५१-२६", "content_sanskrit": "अभ्याययुः सुरान्सर्वान्पुनस्ते दैत्यदानवाः।\nआपीडयन्त्रणे क्रुद्धास्ततो देवान्युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2014900, "chapter_id": 1310, "verse_number": "२-५१-२७", "content_sanskrit": "ते वध्यमाना विबुधाः समरे कालनेमिना।\nदैत्यैश्चैव महाराज दुद्रुवुस्ते दिशो दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2014901, "chapter_id": 1310, "verse_number": "२-५१-२८", "content_sanskrit": "विबुधान्विद्रुतान्दृष्ट्वा कालनेमिर्महा।ञसुरः।\nइन्द्रं यमं च वरुणं वायुं च धनदं रविम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2014902, "chapter_id": 1310, "verse_number": "२-५१-२९", "content_sanskrit": "एतांश्चान्यान्बलाञ्जित्वा तेषां कार्याण्यवाप सः।\nतान्सर्वान्सहसा जित्वा कालनेमिर्महासुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2014903, "chapter_id": 1310, "verse_number": "२-५१-३०", "content_sanskrit": "ददर्श गगने विष्णुं सुपर्णस्थं महाद्युतिम्।\nतं दृष्ट्वा क्रोधताम्राक्षस्तर्जयन्नभ्ययात्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2014904, "chapter_id": 1310, "verse_number": "२-५१-३१", "content_sanskrit": "स बाहुशतमुद्यम्य सर्वास्त्रग्रहणं रणे।\nरोषाद्भारत दैत्येन्द्रो विष्णोरुरसि पातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2014905, "chapter_id": 1310, "verse_number": "२-५१-३२", "content_sanskrit": "दैत्याश्च दानवाश्चैव सर्वे मयपुरोगमाः।\nस्वान्यायुधानि सङ्गृह्य सर्वे विष्णुमुपाद्रवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2014906, "chapter_id": 1310, "verse_number": "२-५१-३३", "content_sanskrit": "स ताड्यमानो।ञतिबलैर्दैत्यैः सर्वायुघोद्यतैः।\nन चचाल हरिर्युद्धेऽकम्पमान इवाचलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2014907, "chapter_id": 1310, "verse_number": "२-५१-३४", "content_sanskrit": "पुनरुद्यम्य सङ्क्रुद्धः कालनेमिर्दृढां गदाम्।\nजघान गदया राजंस्तं विष्णुं गरुडं च वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2014908, "chapter_id": 1310, "verse_number": "२-५१-३५", "content_sanskrit": "तं दृष्ट्वा गुरडं श्रान्तं चक्रमुद्यस्य वै हरिः।\nशतं शिरांसि बाहूंश्च सोच्छिनत्कालनेमिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2014909, "chapter_id": 1310, "verse_number": "२-५१-३६", "content_sanskrit": "जघानान्यांस्च तान्सर्वान्समरे दैत्यदानवान्।\nविबुधानामृषीणां च स्वानि स्थानानि वै ददौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2014910, "chapter_id": 1310, "verse_number": "२-५१-३७", "content_sanskrit": "दत्त्वा सुराणां सुग्रीतो योग्यकर्माणि भारत।\nजगाम ब्रह्मणा सार्धं ब्रह्मलोकं तदा हरिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2014911, "chapter_id": 1310, "verse_number": "२-५१-३८", "content_sanskrit": "ब्रह्मलोकं प्रविश्याश्च प्राप्य नारायणः प्रभुः।\nपौराणं ब्रह्मसदनं दिव्यं नारायणाश्रयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2014912, "chapter_id": 1310, "verse_number": "२-५१-३९", "content_sanskrit": "स प्रविश्य तदा देवः स्तूयमानो महर्षिभिः।\nसहस्रशीर्षा भूत्वा च शयनायोपचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2014913, "chapter_id": 1310, "verse_number": "२-५१-४०", "content_sanskrit": "आदिदेवः पुराणात्मा निद्रावशमुपागतः।\nशेते सुखं सदा विष्णुर्मोहयञ्जगदव्ययः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2014914, "chapter_id": 1310, "verse_number": "२-५१-४१", "content_sanskrit": "जग्मुस्तस्याथ वर्षाणि शयानस्य महात्मनः।\nषट्त्रिंशच्छतसाहस्रं मानुषेणेह सङ्ख्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2014915, "chapter_id": 1310, "verse_number": "२-५१-४२", "content_sanskrit": "जग्मुः कृतयुगत्रेताद्वापरान्ते बुबोध ह।\nब्रह्मादिभिः स्तूयमानः सुरैश्चापि सहर्षिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2014916, "chapter_id": 1310, "verse_number": "२-५१-४३", "content_sanskrit": "उत्पत्य शयनाद्विष्णुर्ब्रह्मणा विबुधैः सह।\nदेवानां च हितार्थाय ययौ देवसभां प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2014917, "chapter_id": 1310, "verse_number": "२-५१-४४", "content_sanskrit": "मेरोः शिरसि विन्यस्तां ज्वलन्तीं तां शुभां सभाम्।\nविविशुस्ते सुराः सर्वे ब्रह्मणा सह भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2014918, "chapter_id": 1310, "verse_number": "२-५१-४५", "content_sanskrit": "जग्मुस्तत्र निषेदुस्ते सा निःशब्दा ह्यभूत्तदा।\nतत्र भूमिरुवाचाथ खेदात्करुणभाषिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2014919, "chapter_id": 1310, "verse_number": "२-५१-४६", "content_sanskrit": "राज्ञां बलैर्बलवतां खिन्नास्मि भृशपीडिता।\nनित्यं भारपरिश्रान्ता दुःखं जीवाम्यहं सुराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2014920, "chapter_id": 1310, "verse_number": "२-५१-४७", "content_sanskrit": "पुरे पुरे च नृपतिः कोटिसङ्ख्यैर्बलैर्वृतः।\nराष्ट्रे राष्ट्रे च शतशो ग्रामाः कुलसहस्रिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2014921, "chapter_id": 1310, "verse_number": "२-५१-४८", "content_sanskrit": "भूमिपानां सहस्रैश्च तेषां च बिलनां बलैः।\nग्रामायुतैः पुरै राष्ट्रैरहं निर्विवरीकृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2014922, "chapter_id": 1310, "verse_number": "२-५१-४९", "content_sanskrit": "तस्माद्धारयितुं शक्त्या न क्षमासि जनानहम्।\nदैत्यैश्च बाध्यमानास्ताः प्राज नित्यं दुरात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2014923, "chapter_id": 1310, "verse_number": "२-५१-५०x", "content_sanskrit": "भीष्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2014924, "chapter_id": 1310, "verse_number": "२-५१-५०", "content_sanskrit": "भूमेस्तु वचनं श्रुत्वा देवो नारायणस्तदा।\nव्यादिश्य तान्सुरान्सर्वान्क्षितौ वस्तुं मनो दधे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2014925, "chapter_id": 1310, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि अर्घाहरणपर्वणि एकपञ्चाशोऽध्यायः॥ ५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]