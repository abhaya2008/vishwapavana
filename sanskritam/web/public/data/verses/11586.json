[{"id": 50016810, "chapter_id": 11586, "verse_number": "1", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50016811, "chapter_id": 11586, "verse_number": "2", "content_sanskrit": "गोवर्धने धृते शैले आसाराद् रक्षिते व्रजे। गोलोकादाव्रजत् कृष्णं सुरभिः शक्र एव च॥ १०/२५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50016812, "chapter_id": 11586, "verse_number": "3", "content_sanskrit": "विविक्त उपसङ्गम्य व्रीळितः कृतहेळनः। पस्पर्श पादयोरेनं किरीटेनार्कवर्चसा॥ १०/२५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50016813, "chapter_id": 11586, "verse_number": "4", "content_sanskrit": "दृष्टश्रुतानुभावोऽस्य कृष्णस्यामिततेजसः। नष्टत्रिलोकेशमद इदमाह कृताञ्जलिः॥ १०/२५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50016814, "chapter_id": 11586, "verse_number": "5", "content_sanskrit": "विशुद्धसत्त्वं तव धाम शान्तं तपोमयं ध्वस्तरजस्तमस्कम्। मायामयोऽयं गुणसम्प्रवाहो न विद्यते तेऽग्रहणानुबन्धः॥ १०/२५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50016815, "chapter_id": 11586, "verse_number": "6", "content_sanskrit": "कुतो नु तद्धेतव ईश मन्युलोभादयो येऽबुधलिङ्गभावाः। अथापि दण्डं भगवान् बिभर्ति धर्मस्य गुप्त्यै खलनिग्रहाय॥ १०/२५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50016816, "chapter_id": 11586, "verse_number": "7", "content_sanskrit": "पिता गुरुस्त्वं जगतामधीशो दुरत्ययः काल उपात्तदण्डः। हिताय चेच्छातनुभिः समीहते मानं विधुन्वन् जगदीशमानिनाम्॥ १०/२५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50016817, "chapter_id": 11586, "verse_number": "8", "content_sanskrit": "ये मद्विधाः स्युर्जगदीश मानिनस्त्वां वीक्ष्य कालेऽभयमाशु तं मदम्। हित्वाऽऽर्यमार्गं प्रभजन्त्यपस्मया ईहा खलानामपि तेऽनुशासनम्॥ १०/२५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50016818, "chapter_id": 11586, "verse_number": "9", "content_sanskrit": "स त्वं ममैश्वर्यमदप्लुतस्य कृतागसस्तेऽविदुषः प्रभावम्। क्षन्तुं प्रभोऽथार्हसि मूढचेतसो मैवं पुनर्भून्मतिरीश मेऽसती॥ १०/२५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50016819, "chapter_id": 11586, "verse_number": "10", "content_sanskrit": "तवावतारोऽयमधोक्षजेह भुवो भराणामुरुभारजन्मनाम्। चमूपतीनामभवाय देव भवाय युष्मच्चरणानुवर्तिनाम्॥ १०/२५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50016820, "chapter_id": 11586, "verse_number": "11", "content_sanskrit": "नमस्तुभ्यं भगवते पुरुषाय महात्मने। वासुदेवाय कृष्णाय सात्वतां पतये नमः॥ १०/२५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50016821, "chapter_id": 11586, "verse_number": "12", "content_sanskrit": "स्वच्छन्देनात्तदेहाय विशुद्धज्ञानमूर्तये। सर्वस्मै सर्वबीजाय सर्वभूतात्मने नमः॥ १०/२५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50016822, "chapter_id": 11586, "verse_number": "13", "content_sanskrit": "मयेदं भगवन् गोष्ठनाशायासारवायुभिः। चेष्टितं विहते यज्ञे मानिना तीव्रमन्युना॥ १०/२५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50016823, "chapter_id": 11586, "verse_number": "14", "content_sanskrit": "त्वयेशानुगृहीतोऽस्मि ध्वस्तस्तम्भो वृथोद्यमः। ईश्वरं गुरुमात्मानं त्वामहं शरणं गतः॥ १०/२५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50016824, "chapter_id": 11586, "verse_number": "15", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50016825, "chapter_id": 11586, "verse_number": "16", "content_sanskrit": "एवं सङ्कीर्तितः कृष्णो मघोना भगवानमुम्। मेघगम्भीरया वाचा प्रहसन्निदमब्रवीत्॥ १०/२५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50016826, "chapter_id": 11586, "verse_number": "17", "content_sanskrit": "श्रीभगवानुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50016827, "chapter_id": 11586, "verse_number": "18", "content_sanskrit": "मया तेऽकारि मघवन् मखभङ्गोऽनुगृह्णता। मदनुस्मृतये नित्यं मत्तस्येन्द्रश्रिया भृशम्॥ १०/२५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50016828, "chapter_id": 11586, "verse_number": "19", "content_sanskrit": "मामैश्वर्यश्रीमदान्धो दण्डपाणिं न पश्यति। तं भ्रंशयामि सम्पद्भ्यो यस्य चेच्छाम्यनुग्रहम्॥ १०/२५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50016829, "chapter_id": 11586, "verse_number": "20", "content_sanskrit": "गम्यतां शक्र भद्रं ते क्रियतां मेऽनुशासनम्। स्थीयतां स्वाधिकारेषु युक्तैर्विस्रम्भवर्जितैः॥ १०/२५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50016830, "chapter_id": 11586, "verse_number": "21", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50016831, "chapter_id": 11586, "verse_number": "22", "content_sanskrit": "अथाह सुरभिः कृष्णमभिवन्द्य मनस्विनी। स्वसन्तानैरुपामन्त्र्य गोपरूपिरणमीश्वरम्॥ १०/२५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50016832, "chapter_id": 11586, "verse_number": "23", "content_sanskrit": "सुरभिरुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50016833, "chapter_id": 11586, "verse_number": "24", "content_sanskrit": "कृष्णकृष्ण महायोगिन् विश्वात्मन् विश्वसम्भव। भवता लोकनाथेन सनाथा वयमच्युत॥ १०/२५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50016834, "chapter_id": 11586, "verse_number": "25", "content_sanskrit": "त्वं नः परमकं दैवं त्वं न इन्द्रो जगत्पते। भवाय भव गोविप्रदेवानां ये च साधवः॥ १०/२५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50016835, "chapter_id": 11586, "verse_number": "26", "content_sanskrit": "इन्द्रं नस्त्वाभिषेक्ष्यामो ब्रह्मणा चोदिता वयम्। अवतीर्णोऽसि विश्वात्मन् भूमेर्भारापनुत्तये॥ १०/२५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50016836, "chapter_id": 11586, "verse_number": "27", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50016837, "chapter_id": 11586, "verse_number": "28", "content_sanskrit": "एवं कृष्णमुपामन्त्र्य सुरभिः पयसाऽऽत्मनः। जलैश्चाकाशगङ्गाया ऐरावतकरोद्धृतैः॥ १०/२५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50016838, "chapter_id": 11586, "verse_number": "29", "content_sanskrit": "इन्द्रः सुरर्षिभिः साकं चोदितो देवमातृभिः। अभ्यषिञ्चत दाशार्हं गोविन्द इति चाभ्यधात्॥ १०/२५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50016839, "chapter_id": 11586, "verse_number": "30", "content_sanskrit": "तत्रागतास्तुम्बुरुनारदादयो गन्धर्वविद्याधरसिद्धचारणाः। जगुर्यशो लोकमलापहं हरेः सुराङ्गनाः सन्ननृतुर्मुदाऽन्विताः॥ १०/२५/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50016840, "chapter_id": 11586, "verse_number": "31", "content_sanskrit": "तं तुष्टुवुर्देवनिकायकेतवो व्यवाकिरंश्चाद्भुतपुष्पवृष्टिभिः। लोकाः परां निर्वृतिमाप्नुवंस्त्रयो गावस्तदा गामनयन् पयोद्रुताम्॥ १०/२५/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50016841, "chapter_id": 11586, "verse_number": "32", "content_sanskrit": "नानारसौघाः सरितो वृक्षा आसन् मधुस्रवाः। अकृष्टपच्यौषधयो गिरयोऽबिभ्रदुन्मणीन्॥ १०/२५/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50016842, "chapter_id": 11586, "verse_number": "33", "content_sanskrit": "कृष्णेऽभिषिक्त एतानि सर्वाणि कुरुनन्दन। निर्वैराण्यभवंस्तात क्रूराण्यपि निसर्गतः॥ १०/२५/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50016843, "chapter_id": 11586, "verse_number": "34", "content_sanskrit": "इति गोगोकुलपतिं गोविन्दमभिषिच्य सः। अनुज्ञातो ययौ शक्रो वृतो देवादिभिर्दिवम्॥ १०/२५/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50016844, "chapter_id": 11586, "verse_number": "35", "content_sanskrit": "इति श्रीमद्भागवते दशमस्कन्धे पञ्चविंशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]