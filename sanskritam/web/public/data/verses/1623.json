[{"id": 2028648, "chapter_id": 1623, "verse_number": "३-२६१-०x", "content_sanskrit": "युदिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2028649, "chapter_id": 1623, "verse_number": "३-२६१-१", "content_sanskrit": "व्रीहिद्रोणः परित्यक्तः कथं तेन महात्मना।\nकस्मै दत्तश्च भगवन्विधिना केन चात्थ मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2028650, "chapter_id": 1623, "verse_number": "३-२६१-२", "content_sanskrit": "प्रत्यक्षधर्मा भगवान्यस् तुष्टो हि कर्मभिः।\nसफलं तस्य जन्माहं मन्ये सद्धर्मचारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2028651, "chapter_id": 1623, "verse_number": "३-२६१-३x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2028652, "chapter_id": 1623, "verse_number": "३-२६१-३", "content_sanskrit": "शिलोञ्छवृत्तिर्धर्मात्मा मुद्गलः संयतेन्द्रियः।\nआसीद्राजन्कुरुक्षेत्रे सत्यवागनसूयकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2028653, "chapter_id": 1623, "verse_number": "३-२६१-४", "content_sanskrit": "अतिथिव्रती क्रियावांश्च कापोतीं वृत्तिमास्थितः।\nसत्रमिष्टीकृतंनाम समुपास्ते महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2028654, "chapter_id": 1623, "verse_number": "३-२६१-५", "content_sanskrit": "सपुत्रदारो हि मुनिः पक्षाहारो बभूव ह।\nकपोतवृत्त्या पक्षेण व्रीहिद्रोयणमुपार्जयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2028655, "chapter_id": 1623, "verse_number": "३-२६१-६", "content_sanskrit": "दर्शं च पौर्णमासं च कुर्वन्विगतमन्सरः।\nदेवतातिथिशेषेण कुरुते देहयापनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2028656, "chapter_id": 1623, "verse_number": "३-२६१-७", "content_sanskrit": "तत्रेन्द्रः सहितो देवैः साक्षात्रिभुवनेश्वरः।\nप्रत्यृह्णान्महाराज भागं पर्वणिपर्वणि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2028657, "chapter_id": 1623, "verse_number": "३-२६१-८", "content_sanskrit": "स पर्वकाल्यं कृत्वा तु मुनिवृत्त्या समन्वितः।\nअतिथिभ्यो ददावन्नं प्रहृष्टेनान्तरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2028658, "chapter_id": 1623, "verse_number": "३-२६१-९", "content_sanskrit": "व्रीहिद्रोणस्य तत्प्रीत्या ददतोऽन्नं महात्मनः।\nऋषेर्मात्सर्यहीनस् वर्धत्यतिथिदर्शनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2028659, "chapter_id": 1623, "verse_number": "३-२६१-१०", "content_sanskrit": "तच्छतान्यपि भुञ्जन्ति ब्राह्मणानां मनीषिणाम्।\nमुनेस्त्यागविशुद्ध्या तु तदन्नं वृद्धिमृच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2028660, "chapter_id": 1623, "verse_number": "३-२६१-११", "content_sanskrit": "तं तु रशुश्राव धर्मिष्ठं मुद्गलं संशितव्रतम्।\nदुर्वासा नृप दिग्वासास्तमथाभ्याजगाम ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2028661, "chapter_id": 1623, "verse_number": "३-२६१-१२", "content_sanskrit": "विभ्रच्चानियतं वेषमुन्मत्त इव पाण्डव।\nविकचः परुषा वाचो व्याहरन्विविधा मुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2028662, "chapter_id": 1623, "verse_number": "३-२६१-१३", "content_sanskrit": "अभिगम्याथ तं विप्रमुवाच मुनिसत्तमः।\nअन्नार्थिनमनुप्राप्तं विद्धि मां मुनिसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2028663, "chapter_id": 1623, "verse_number": "३-२६१-१४", "content_sanskrit": "स्वागतं तेऽस्त्विति मुनिं मुद्गलः प्रत्यभाषत।\nपाद्यमाचमनीयं च प्रतिवेद्यान्नमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2028664, "chapter_id": 1623, "verse_number": "३-२६१-१५", "content_sanskrit": "प्रादात्स तपसोपात्तं क्षुधितायातिथिप्रियः।\nउन्मत्ताय परां श्रद्धामास्थाय स धृतव्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2028665, "chapter_id": 1623, "verse_number": "३-२६१-१६", "content_sanskrit": "ततस्तदन्नं रसवत्स एव क्षुधयाऽन्वितः।\nबुभुजे कृत्स्नमुन्मत्तः प्रादात्तस्मै च मुद्गलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2028666, "chapter_id": 1623, "verse_number": "३-२६१-१७", "content_sanskrit": "भुक्त्वा चान्नं ततः सर्वमुच्छिष्टेनात्मनस्ततः।\nअथाङ्गं लिलिपेऽन्नेन यथागतमगाच्च सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2028667, "chapter_id": 1623, "verse_number": "३-२६१-१८", "content_sanskrit": "`तेनैवात्मानमालिप्य हसन्गायन्प्रधावति।\nनृत्यते धावते चैव बुद्ध्या तत्क्रोशते तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2028668, "chapter_id": 1623, "verse_number": "३-२६१-१९", "content_sanskrit": "एवं द्वितीये संप्राप्ते पर्वकाले मनीषिणः।\nआगम्य बुभुजे सर्वमन्नपुञ्छोपजीविनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2028669, "chapter_id": 1623, "verse_number": "३-२६१-२०", "content_sanskrit": "निराहारस्तु स मुनिरुञ्छमार्जये पुनः।\nन चैनं विक्रियां नेतुमशकन्मुद्गलं क्षुधा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2028670, "chapter_id": 1623, "verse_number": "३-२६१-२१", "content_sanskrit": "न क्रोधो न च मात्सर्यं नावमानो न संभ्रमः।\nसपुत्रदारमुञ्छन्तमाविवेश द्विजोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2028671, "chapter_id": 1623, "verse_number": "३-२६१-२२", "content_sanskrit": "तथा तमुञ्छधर्माणं दुर्वासा मुनिसत्तमम्।\nउपतस्थे यथाकालं षट्कृत्वः कृतनिश्चयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2028672, "chapter_id": 1623, "verse_number": "३-२६१-२३", "content_sanskrit": "न चास् मनसः कश्चिद्विकारो दृश्यते मुनेः।\nशुद्धसत्वस्य शुद्धं स ददृशे निर्मलं मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2028673, "chapter_id": 1623, "verse_number": "३-२६१-२४", "content_sanskrit": "तमुवाच ततः प्रीतः स मुनिर्मुद्गलं तदा।\nत्वत्समो नास्ति लोकेऽस्मिन्दाता मात्सर्यवर्जितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2028674, "chapter_id": 1623, "verse_number": "३-२६१-२५", "content_sanskrit": "क्षुद्धर्मसंज्ञां प्रणुदत्यादत्ते धैर्यमेव च।\nविषयानुसारिणी जिह्वा कर्षत्येव रसान्प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2028675, "chapter_id": 1623, "verse_number": "३-२६१-२६", "content_sanskrit": "आहारप्रभवाः प्राणा मनो दुर्निग्रहं चलम्।\nमनसश्चेन्द्रियाणां चाप्यैकाग्र्यं निश्चितं तपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2028676, "chapter_id": 1623, "verse_number": "३-२६१-२७", "content_sanskrit": "श्रमेणोपार्जितं त्यक्तं न च दुःखेन चेतसा।\nतत्सर्वं भवता साधो यथावदुपपादितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2028677, "chapter_id": 1623, "verse_number": "३-२६१-२८", "content_sanskrit": "प्रीताः स्मोऽनुगृहीताश्च समेत्य भवता सह।\nइन्द्रियाभिजयो धैर्यं संविभागो दमः शमः।\nदया सत्यं च धर्मश्च त्वयि सर्वं प्रतिष्ठितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2028678, "chapter_id": 1623, "verse_number": "३-२६१-२९", "content_sanskrit": "`लोकाः समस्ता धर्मेण धार्यन्ते सचराचराः।\nधर्मोपि धार्यते येन धृतियुक्त त्वयाऽऽत्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2028679, "chapter_id": 1623, "verse_number": "३-२६१-३०", "content_sanskrit": "विशुद्धसत्वसंपन्नो न त्वदन्योस्ति कश्चन।\nजितास्ते कर्मभिर्लोकाः प्राप्तोसि परमां गतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2028680, "chapter_id": 1623, "verse_number": "३-२६१-३१", "content_sanskrit": "अहो दानं विघुष्टं ते सुमहत्स्वर्गवासिभिः।\nसशरीरो भवान्गन्ता स्वर्गं सुचरितव्रत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2028681, "chapter_id": 1623, "verse_number": "३-२६१-३२", "content_sanskrit": "इत्येवं वदतस्तस्य तदा दुर्वाससो मुनेः।\nदेवदूतो विमानेन मुद्गलं प्रत्युपस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2028682, "chapter_id": 1623, "verse_number": "३-२६१-३३", "content_sanskrit": "हंससारसयुक्तेन किङ्किणीजालमालिना।\nकामगेन विचित्रेण दिव्यगन्धवता तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2028683, "chapter_id": 1623, "verse_number": "३-२६१-३४", "content_sanskrit": "उवाच चैनं विप्रर्षिं विमानं कर्मभिर्जितम्।\nसमुपारोह संसिद्धिं प्राप्तोसि परमां मुने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2028684, "chapter_id": 1623, "verse_number": "३-२६१-३५", "content_sanskrit": "तमेवंवादिनमृषिर्देवदूतमुवाच ह।\nइच्छामि भवता प्रोक्तान्गुणान्स्वर्गनिवासिनां ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2028685, "chapter_id": 1623, "verse_number": "३-२६१-३६", "content_sanskrit": "के गुणास्तत्रवसतां किं तपः कश्च निश्चयः।\nस्वर्गे तत्रसुखं किं च दोषो वा देवदूतक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2028686, "chapter_id": 1623, "verse_number": "३-२६१-३७", "content_sanskrit": "सतां साप्तपदं मित्रमाहुः सन्तः कुलोचिताः।\nमित्रतां च पुरस्कृत्य पृच्छामि त्वामहं विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2028687, "chapter_id": 1623, "verse_number": "३-२६१-३८", "content_sanskrit": "यदत्र तथ्यं पथ्यं च तद्ब्रवीह्यविचारयन्।\nश्रुत्वा तथा करिष्यामि व्यवसायं गिरा तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2028688, "chapter_id": 1623, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि व्रीहिद्रौणिकपर्वणि एकषष्ट्यधिकद्विशततमोऽध्यायः ॥ २६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]