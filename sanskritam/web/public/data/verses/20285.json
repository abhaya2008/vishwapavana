[{"id": 7000285000, "chapter_id": 20285, "verse_number": "१-३९-१", "content_sanskrit": "भीष्म उवाच ।\nकथितं वामनस्यैव माहात्म्यं विस्तरेण वै ।\nपुनस्तस्यैव माहात्म्यमन्यद्विष्णोरतो वद ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000285001, "chapter_id": 20285, "verse_number": "१-३९-२", "content_sanskrit": "पद्मं कथमभूद्देव नाभौ येनाभवज्जगत् ।\nकथं च वैष्णवी सृष्टिः पद्ममध्येऽभवत्पुरा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000285002, "chapter_id": 20285, "verse_number": "१-३९-३", "content_sanskrit": "कथं पाद्मे महाकल्पेऽभवत्पद्ममयं जगत् ।\nजलार्णवगतस्येह नाभौ जातं जलानुगं ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000285003, "chapter_id": 20285, "verse_number": "१-३९-४", "content_sanskrit": "प्रभावं पद्मनाभस्य स्वपतः सागरांभसि ।\nपुष्करे तु कथं जाता देवा ॠषिगणाः पुरा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000285004, "chapter_id": 20285, "verse_number": "१-३९-५", "content_sanskrit": "एतदाख्याहि निखिलं योगं योगविदां पते ।\nकथं निर्मितवांस्तत्र चैतं लोकं सनातनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000285005, "chapter_id": 20285, "verse_number": "१-३९-६", "content_sanskrit": "कथमेकार्णवे शून्ये नष्टे स्थावरजंगमे ।\nभूगोलके प्रदग्धे तु प्रणष्टोरगराक्षसे ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000285006, "chapter_id": 20285, "verse_number": "१-३९-७", "content_sanskrit": "नष्टानलानिलाकाशे नष्टधर्मे महीतले ।\nकेवले गह्वरीभूते महाभूतविपर्यये ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000285007, "chapter_id": 20285, "verse_number": "१-३९-८", "content_sanskrit": "किं नु विश्वपतिः साक्षान्महातेजा महाद्युतिः ।\nआस्ते यथाध्याननिष्ठो विधिमास्थाय योगवित् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000285008, "chapter_id": 20285, "verse_number": "१-३९-९", "content_sanskrit": "शृण्वतः परया भक्त्या ब्रह्मन्नेतदशेषतः ।\nवक्तुमर्हसि धर्मज्ञ यशो नारायणात्मकम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000285009, "chapter_id": 20285, "verse_number": "१-३९-१०", "content_sanskrit": "श्रद्धिनः सूपविष्टस्य भगवन्वक्तुमर्हसि ।\nपुलस्त्य उवाच ।\nनारायणस्य यशसः श्रवणे या तव स्पृहा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000285010, "chapter_id": 20285, "verse_number": "१-३९-११", "content_sanskrit": "सद्वंशान्वयपूतस्य न्याय्यं कुरुकुलोद्वह ।\nशृणुष्वादिपुराणेषु देवेभ्यश्च यथा श्रुति ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000285011, "chapter_id": 20285, "verse_number": "१-३९-१२", "content_sanskrit": "ब्राह्मणानां च वदतां श्रुत्वा वै सुमहात्मनाम् ।\nयथा च तपसा दृष्ट्वा बृहस्पति समद्युतिः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000285012, "chapter_id": 20285, "verse_number": "१-३९-१३", "content_sanskrit": "पराशरसुतः श्रीमान्गुरुर्द्वैपायनोऽब्रवीत् ।\nतत्तेऽहं कथयिष्यामि यथाभक्ति यथाश्रुति ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000285013, "chapter_id": 20285, "verse_number": "१-३९-१४", "content_sanskrit": "यद्विज्ञातं मया सम्यगृषिमार्गेण सत्तम ।\nकः समुत्सहते ज्ञातुं परं नारायणात्मकम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000285014, "chapter_id": 20285, "verse_number": "१-३९-१५", "content_sanskrit": "विश्वावितारं ब्रह्मायं न वेदयति तत्वतः ।\nतत्कर्मविश्वदेवा न तद्रहस्यं महर्षिषु ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000285015, "chapter_id": 20285, "verse_number": "१-३९-१६", "content_sanskrit": "स इज्यस्सर्वयज्ञानां स तत्त्वं तत्त्वदर्शिनाम् ।\nअध्यात्ममध्यात्मविदां नरकं च विकर्मिणाम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000285016, "chapter_id": 20285, "verse_number": "१-३९-१७", "content_sanskrit": "अधिदैवं च तद्दैवमधिदैवतसंज्ञितम् ।\nअधिभूतं च तद्भूतं परं च परमार्थिनाम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000285017, "chapter_id": 20285, "verse_number": "१-३९-१८", "content_sanskrit": "स यज्ञो वेदनिर्दिष्टस्तत्तपः कवयो विदुः ।\nयः कर्त्ता कारको बुद्धिर्यतः क्षेत्रज्ञ एव च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000285018, "chapter_id": 20285, "verse_number": "१-३९-१९", "content_sanskrit": "प्रणवः पुरुषः शास्ता एकश्चेति विभाव्यते ।\nप्राणः पंचविधश्चैव ध्रुवमक्षरमेव च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000285019, "chapter_id": 20285, "verse_number": "१-३९-२०", "content_sanskrit": "कालः पाकश्च यज्ञश्च यष्टा चाधीतमेव च ।\nउच्यते विविधैर्भावैः स एवायं तु तत्परम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000285020, "chapter_id": 20285, "verse_number": "१-३९-२१", "content_sanskrit": "स एव भगवान्सर्वं करोति न करोति च ।\nसोस्मिन्कारयते सर्वं स्थानिनां च कृतिः कृता ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000285021, "chapter_id": 20285, "verse_number": "१-३९-२२", "content_sanskrit": "यजामहे तमेवाद्यं स एवोत्थाननिर्वृतः ।\nयो वक्ता यच्च वक्तव्यं यश्चाहं तद्ब्रवीमि ते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000285022, "chapter_id": 20285, "verse_number": "१-३९-२३", "content_sanskrit": "श्रूयते यच्च वै श्राव्यं यच्चान्यत्परिजल्पितम् ।\nया कथायाश्च श्रुतयो यो धर्मी धर्मतत्परः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000285023, "chapter_id": 20285, "verse_number": "१-३९-२४", "content_sanskrit": "विश्वं विश्वपतिर्यश्च स तु नारायणः स्मृतः ।\nयत्सत्यं यदनृतमादिमध्यभूतं यच्चांत्यं निरवधिकं च यद्भविष्यम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000285024, "chapter_id": 20285, "verse_number": "१-३९-२५", "content_sanskrit": "यत्किंचिच्चरमचरं यदस्ति चान्यत्सर्वं तत्पुरुषवरः प्रधानभूतः ।\nचत्वार्य्याहुः सहस्राणि वर्षाणां तत्कृतं युगम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000285025, "chapter_id": 20285, "verse_number": "१-३९-२६", "content_sanskrit": "तस्य तावच्छती संध्या द्विगुणा कुरुनंदन ।\nयत्र धर्मश्चतुष्पादस्त्वधर्मः पादविग्रहः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000285026, "chapter_id": 20285, "verse_number": "१-३९-२७", "content_sanskrit": "स्वधर्मनिरताः शांता जायंते यत्र मानवाः ।\nविप्रा स्थिता धर्मपरा राजवृत्तिस्थिता नृपाः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000285027, "chapter_id": 20285, "verse_number": "१-३९-२८", "content_sanskrit": "कृष्यामभिरता वैश्याः शूद्रा शुःश्रूषवस्तथा ।\nतदा सत्यं च सत्वं च धर्मश्चैव विवर्धते ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000285028, "chapter_id": 20285, "verse_number": "१-३९-२९", "content_sanskrit": "सद्भिराचरितो धर्मो येन लोकः प्रवर्त्तते ।\nएतत्कृतयुगे वृत्तं सर्वेषामेव पार्थिव ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000285029, "chapter_id": 20285, "verse_number": "१-३९-३०", "content_sanskrit": "प्राणिनां धर्मसंज्ञानां नराणां नीचजन्मनाम् ।\nत्रीणिवर्षसहस्राणि त्रेतायुगमिहोच्यते ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000285030, "chapter_id": 20285, "verse_number": "१-३९-३१", "content_sanskrit": "तस्य तावच्छती संध्या द्विगुणा परिकीर्तिता ।\nद्वाभ्यामधर्मः पादाभ्यां त्रिभिर्धर्मो व्यवस्थितः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000285031, "chapter_id": 20285, "verse_number": "१-३९-३२", "content_sanskrit": "यत्र सत्यं च सत्वं च क्रिया धर्मो विधीयते ।\nत्रेतायां विकृतिं यांति वर्णा लोभेन संयुताः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000285032, "chapter_id": 20285, "verse_number": "१-३९-३३", "content_sanskrit": "चातुर्वर्ण्यस्य वै कृत्यं क्षांतिर्दौर्बल्यमेव च ।\nएषा त्रेतायुगगतिर्विचित्रा देवनिर्मिता ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000285033, "chapter_id": 20285, "verse_number": "१-३९-३४", "content_sanskrit": "द्वापरं द्विसहस्रं तु वर्षाणां कुरुनन्दन ।\nतस्य तावच्छती सन्ध्या द्विगुणं युगमुच्यते ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000285034, "chapter_id": 20285, "verse_number": "१-३९-३५", "content_sanskrit": "तत्राप्यतीवार्थपराः प्राणिनो रजसा हताः ।\nशठा नैष्कृतिकाः क्षुद्रा जायन्ते कुरुनन्दन ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000285035, "chapter_id": 20285, "verse_number": "१-३९-३६", "content_sanskrit": "द्वाभ्यां धर्मः स्थितः पद्भ्यामधर्मस्त्रिभिरुत्थितः ।\nविपर्ययशतैर्धर्मः क्षयमेति कलौ युगे ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000285036, "chapter_id": 20285, "verse_number": "१-३९-३७", "content_sanskrit": "ब्रह्मण्यभावश्च्यवते तथास्तिक्यं विवर्ज्यते ।\nव्रतोपवासास्त्यज्यंते कलौ वै युगपर्यये ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000285037, "chapter_id": 20285, "verse_number": "१-३९-३८", "content_sanskrit": "तदा वर्षसहस्रं तु वर्षाणां द्वे शते तथा ।\nयत्राधर्मश्चतुष्पादो धर्मः पादपरिग्रहः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000285038, "chapter_id": 20285, "verse_number": "१-३९-३९", "content_sanskrit": "कामिनस्तापसाः क्षुद्रा जायंते यत्र मानवाः ।\nन चावसायिकः कश्चिन्न साधुर्न च सत्यवाक् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000285039, "chapter_id": 20285, "verse_number": "१-३९-४०", "content_sanskrit": "नास्तिका ब्राह्मणा भक्ता ज्ञायंते तत्र मानवाः ।\nअहंकारगृहीताश्च प्रक्षीणस्नेहबंधनाः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000285040, "chapter_id": 20285, "verse_number": "१-३९-४१", "content_sanskrit": "विप्राः शूद्रसमाचारास्संति सर्वे कलौ युगे ।\nआश्रमाणां विपर्यासः कलौ संप्रति वर्तते ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000285041, "chapter_id": 20285, "verse_number": "१-३९-४२", "content_sanskrit": "वर्णानां चैव संदेहो युगांते कुरुनंदन ।\nएषा द्वादशसाहस्री युगाख्या पूर्वनिर्मिता ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000285042, "chapter_id": 20285, "verse_number": "१-३९-४३", "content_sanskrit": "सहस्रयुगपर्यंतं तदहर्ब्राह्ममुच्यते ।\nततो ह निगते तस्मिन्सर्वेषामेव जीविनाम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000285043, "chapter_id": 20285, "verse_number": "१-३९-४४", "content_sanskrit": "शरीरनिर्वृतिं दृष्ट्वा कालः संहारबुद्धिमान् ।\nदेवतानां च सर्वेषां ब्राह्मणानां महीपते ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000285044, "chapter_id": 20285, "verse_number": "१-३९-४५", "content_sanskrit": "दैत्यानां दानवानां च यक्षराक्षसपक्षिणाम् ।\nगंधर्वाणामप्सरसां भुजंगानां च पार्थिव ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000285045, "chapter_id": 20285, "verse_number": "१-३९-४६", "content_sanskrit": "पर्वतानां नदीनां च पशूनां चैव सत्तम ।\nतिर्यग्योनिगतानां च क्रिमीणां दंशिनां तथा ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000285046, "chapter_id": 20285, "verse_number": "१-३९-४७", "content_sanskrit": "सर्वभूतपतिः पंच भूत्वा भूतानि भूतकृत् ।\nजगत्संहरणार्थाय कुरुते वैशसं महत् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000285047, "chapter_id": 20285, "verse_number": "१-३९-४८", "content_sanskrit": "भूत्वा सूर्यश्चक्षुषी आददानो भूत्वा वायुः प्राणिनां प्राणिजातम् ।\nभूत्वा वह्निर्निर्दहन्सर्वलोकान्भूत्वा मेघो भूय उग्रोऽभ्यवर्षत् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000285048, "chapter_id": 20285, "verse_number": "१-३९-४९", "content_sanskrit": "भूत्वा नारायणो योगी सर्वमूर्ति विभावसुः ।\nगभस्तिभिः प्रदीप्ताभिः संशोषयति सागरान् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000285049, "chapter_id": 20285, "verse_number": "१-३९-५०", "content_sanskrit": "ततः पीत्वार्णवान्सर्वान्नदीकूपांश्च सर्वतः ।\nपर्वतानां च सलिलं सर्वमादाय योगवित् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000285050, "chapter_id": 20285, "verse_number": "१-३९-५१", "content_sanskrit": "भूत्वा चैव स हस्तार्चिर्महीं भित्वा रसातले ।\nरमते जलमादाय पिबन्रसमनुत्तमं ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000285051, "chapter_id": 20285, "verse_number": "१-३९-५२", "content_sanskrit": "मूर्त्तामूर्त्ते तदन्यच्च यदस्ति प्राणिषु ध्रुवं ।\nतत्सर्वमरविंदाक्ष आदत्ते पुरुषोत्तमः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000285052, "chapter_id": 20285, "verse_number": "१-३९-५३", "content_sanskrit": "वायुश्च बलवान्भूत्वा विधुन्वानोऽखिलं जगत् ।\nप्राणापानं समासाद्य वायुना क्रमते हरिः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000285053, "chapter_id": 20285, "verse_number": "१-३९-५४", "content_sanskrit": "ततो देवगणानां च सर्वेषां चैव देहिनाम् ।\nपंचेंद्रियगुणास्सर्वे भूतान्येव च यानि च ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000285054, "chapter_id": 20285, "verse_number": "१-३९-५५", "content_sanskrit": "घ्रेयं घ्राणं शरीरं च पृथिवीसंश्रिता गुणाः ।\nलोकयात्रा भगवता मुहूर्तेन विनाशिता ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000285055, "chapter_id": 20285, "verse_number": "१-३९-५६", "content_sanskrit": "जिह्वारसश्च स्नेहश्च संश्रिताः सलिले गुणाः ।\nरूपं चक्षुर्विभागश्च नेत्र ज्योतिः श्रिता गुणाः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000285056, "chapter_id": 20285, "verse_number": "१-३९-५७", "content_sanskrit": "स्पर्शः प्राणश्च चेष्टा च पवनं संश्रिता गुणाः ।\nशब्दः श्रोत्रे च श्रवणं गगनं संश्रिता गुणाः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000285057, "chapter_id": 20285, "verse_number": "१-३९-५८", "content_sanskrit": "मनो बुद्धिश्च चित्तं च क्षेत्रज्ञं चेति संश्रिताः ।\nपरेण परमेष्ठी च हृषीकेशमुपाश्रिताः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000285058, "chapter_id": 20285, "verse_number": "१-३९-५९", "content_sanskrit": "ततो भगवतस्तस्य रश्मिभिः परिवारिताः ।\nवायुना परिनुन्नाश्च भूमिशाखामुपाश्रिताः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000285059, "chapter_id": 20285, "verse_number": "१-३९-६०", "content_sanskrit": "तेषां संहरणोद्भूतः पावकः शतधा ज्वलन् ।\nप्रदहन्नखिलं विश्वं वृत्तः संवर्त्तकोऽनलः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000285060, "chapter_id": 20285, "verse_number": "१-३९-६१", "content_sanskrit": "सपर्वतद्रुमान्गुल्मान्लतावल्लीस्तृणानि च ।\nविमानानि च दिव्यानि पुराणि विविधानि च ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000285061, "chapter_id": 20285, "verse_number": "१-३९-६२", "content_sanskrit": "यानि चाश्रयणीयानि सर्वाण्यप्यदहद्भृशम् ।\nभस्मीकृत्य तु तान्सर्वांल्लोकान्ल्लोकगुरोर्गुरुः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000285062, "chapter_id": 20285, "verse_number": "१-३९-६३", "content_sanskrit": "स भूतिं धारयामास युगांते लोकसंभवाम् ।\nसहस्रवृष्टिः शतधा भूत्वा कृष्णो महाघनः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000285063, "chapter_id": 20285, "verse_number": "१-३९-६४", "content_sanskrit": "दिव्यतोयेन हविषा तर्पयामास मेदिनीं ।\nततः क्षीरनिकाशेन स्वादुना परमांभसा ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000285064, "chapter_id": 20285, "verse_number": "१-३९-६५", "content_sanskrit": "शिशिरेण च पुण्येन महीनिर्वाणमागमत् ।\nतेन तोयेन संपृक्ता पयस्साधर्म्यतो धरा ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000285065, "chapter_id": 20285, "verse_number": "१-३९-६६", "content_sanskrit": "एकार्णावजलीभूता सर्वसत्वविवर्जिता ।\nमहासत्वान्यपि विभुं प्रविष्टान्यमितौजसं ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000285066, "chapter_id": 20285, "verse_number": "१-३९-६७", "content_sanskrit": "नष्टार्कपवनाकाशे सूक्ष्मे जगति संवृते ।\nसंशोषमात्मना कृत्वा समुद्राणां च देहिनः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000285067, "chapter_id": 20285, "verse_number": "१-३९-६८", "content_sanskrit": "दग्ध्वा संकोच्य च तथा स्वपित्येकः सनातनः ।\nपौराणं रूपमास्थाय स्वपित्यमितविक्रमः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000285068, "chapter_id": 20285, "verse_number": "१-३९-६९", "content_sanskrit": "एकार्णवजलेयायी योगी योगमुपासितः ।\nअनेकानि सहस्राणि युगान्येकार्णवांभसि ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000285069, "chapter_id": 20285, "verse_number": "१-३९-७०", "content_sanskrit": "न चैव कश्चिदव्यक्तं व्यक्तो वेदितुमर्हति ।\nकश्चैष पुरुषो नाम किं योगः कश्च योगवान् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000285070, "chapter_id": 20285, "verse_number": "१-३९-७१", "content_sanskrit": "न पृष्ठे नैवमभितो नैव पार्श्वे न चाग्रतः ।\nकश्चिद्विज्ञायते तस्य दृश्यते देवसत्तमः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000285071, "chapter_id": 20285, "verse_number": "१-३९-७२", "content_sanskrit": "नभः क्षितिं पवनमपः प्रकाशनं प्रजापतिं भुवनधरं सुरेश्वरम् ।\nपितामहं श्रुतिनिलयं मुनिं प्रभुं समापयञ्छयनमरोचयत्प्रभुः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000285072, "chapter_id": 20285, "verse_number": "१-३९-७३", "content_sanskrit": "एवमेकार्णवीभूते शेते लोके महाद्युतिः ।\nप्रच्छाद्य सलिलेनोर्वीं हंसो नारायणाय ते ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000285073, "chapter_id": 20285, "verse_number": "१-३९-७४", "content_sanskrit": "महतो रजसो मध्ये महार्णवसमस्य वै ।\nवारिजाक्षो महाबाहुरक्षयं ब्रह्म यद्विदुः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000285074, "chapter_id": 20285, "verse_number": "१-३९-७५", "content_sanskrit": "आत्मरूपसरूपेण तमसा संवृतः प्रभुः ।\nमनः सात्विकमादाय यत्र तत्सत्वमाहितं ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000285075, "chapter_id": 20285, "verse_number": "१-३९-७६", "content_sanskrit": "यथातथ्यं परं ज्ञानं भूताय ब्रह्मणे ततः ।\nरहस्यं च तथोद्दिष्टं यथोपनिषदां स्मृतम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000285076, "chapter_id": 20285, "verse_number": "१-३९-७७", "content_sanskrit": "पुरुषो यज्ञ इत्येतत्परमं परिकीर्तितम् ।\nयश्चान्यः पुरुषाख्यः स्यात्स एव पुरुषोत्तमः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000285077, "chapter_id": 20285, "verse_number": "१-३९-७८", "content_sanskrit": "ये च यज्ञकरा विप्रा ये ॠत्विज इति स्मृताः ।\nअस्मादेव पुरा भूता वक्त्रेभ्यः श्रूयते तथा ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000285078, "chapter_id": 20285, "verse_number": "१-३९-७९", "content_sanskrit": "ब्रह्माणं प्रथमं वक्त्रादुद्गातारं च सामगं ।\nहोतारं च तथाद्ध्वर्युं बाहुभ्यामसृजत्प्रभुः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000285079, "chapter_id": 20285, "verse_number": "१-३९-८०", "content_sanskrit": "ब्रह्माणं ब्राह्माणाच्छंसि स्तोतारौ चैव सर्वशः ।\nमेढ्राच्च मैत्रावरुणं प्रतिष्ठातारमेव च ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000285080, "chapter_id": 20285, "verse_number": "१-३९-८१", "content_sanskrit": "उदरात्प्रतिहर्तारं पोतारं चैव पार्थिव ।\nपाणिभ्यामथ चाग्नीध्रमुन्नेतारं च याजुषम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000285081, "chapter_id": 20285, "verse_number": "१-३९-८२", "content_sanskrit": "अच्छावाकमथोरुभ्यां सुब्रह्मण्यं च सामगम् ।\nएवमेवं स भगवान्षोडशैतान्जगत्पतिः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000285082, "chapter_id": 20285, "verse_number": "१-३९-८३", "content_sanskrit": "स्वयंभूः सर्वयज्ञानामृत्विजोऽसृजदुत्तमान् ।\nतदा चैष महायोगी पुरुषो यज्ञसंज्ञितः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000285083, "chapter_id": 20285, "verse_number": "१-३९-८४", "content_sanskrit": "वेदाश्चैव तथा सर्वे सहांगोपनिषत्क्रियाः ।\nस्वपित्येकार्णवे चैव यदाश्चर्यमभूत्पुरा ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000285084, "chapter_id": 20285, "verse_number": "१-३९-८५", "content_sanskrit": "श्रूयतां तु तदा विप्रो मार्कंडेयः कुतूहलात् ।\nगीर्णो भगवता तेन कुक्षावासीन्महामुनिः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000285085, "chapter_id": 20285, "verse_number": "१-३९-८६", "content_sanskrit": "बहुवर्षसहस्रायुस्तस्यैव वरतेजसः ।\nअटंस्तीर्थप्रसंगेन पृथिवीतीर्थगोचरः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000285086, "chapter_id": 20285, "verse_number": "१-३९-८७", "content_sanskrit": "आश्रमाणि च पुण्यानि देवतायतनानि च ।\nदेशाद्राष्ट्राणि चित्राणि पुराणि विविधानि च ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000285087, "chapter_id": 20285, "verse_number": "१-३९-८८", "content_sanskrit": "जपहोमपराः शांतास्तपोभिरमलाः स्मृताः ।\nमार्कंडेयस्ततस्तस्य शनैर्वक्त्राद्विनिर्गतः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000285088, "chapter_id": 20285, "verse_number": "१-३९-८९", "content_sanskrit": "निष्क्रामन्तं न चात्मानं जानीते देवमायया ।\nनिष्क्रम्य तस्य उदरादेकार्णवमथो जगत् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000285089, "chapter_id": 20285, "verse_number": "१-३९-९०", "content_sanskrit": "सर्वतस्तमसाछन्नं मार्कंडेयोन्ववैक्षत ।\nतस्योत्पन्नं भयं तीव्रं व्यत्ययं चात्मजीवितम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000285090, "chapter_id": 20285, "verse_number": "१-३९-९१", "content_sanskrit": "देवदर्शनसंहृष्टो विस्मयं परमं गतः ।\nसोऽचिंतयदमोघात्मा मार्कंडेयोथ शंकितः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000285091, "chapter_id": 20285, "verse_number": "१-३९-९२", "content_sanskrit": "किं नु स्याच्चित्तसंमोहः किं नु स्वप्नोनुभूयते ।\nव्यक्तमन्यतरो भाव एतयोर्भविता मम ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000285092, "chapter_id": 20285, "verse_number": "१-३९-९३", "content_sanskrit": "न हि स्वप्नो ह्ययं सत्ययुक्तं यत्सत्यमर्हति ।\nनष्टचंद्रार्कपवनो नष्टपर्वतभूतलः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000285093, "chapter_id": 20285, "verse_number": "१-३९-९४", "content_sanskrit": "कतमः स्यादयं लोक इति शोकमुपागतः ।\nददर्श चापि पुरुषं स्वपंतं पर्वतोपमम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000285094, "chapter_id": 20285, "verse_number": "१-३९-९५", "content_sanskrit": "सलिलेऽधमथो मग्नं जीमूतमिव सागरे ।\nतपंतमिव तेजोभिरामुक्तशशिभास्करम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000285095, "chapter_id": 20285, "verse_number": "१-३९-९६", "content_sanskrit": "गांभीर्यात्सागरमिव भासमानम्मवौजसा ।\nदेवं द्रष्टुमिहायातः को भवानिति विस्मयात् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000285096, "chapter_id": 20285, "verse_number": "१-३९-९७", "content_sanskrit": "तथैव च मुनिः कुक्षिं पुनरेव प्रवेशितः ।\nसंप्रविष्टः पुनः कुक्षिं मार्कंडेयः सविस्मयम् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000285097, "chapter_id": 20285, "verse_number": "१-३९-९८", "content_sanskrit": "तथैव च पुनर्भूयो विजानन्स्वप्नदर्शनम् ।\nस तथैव यथापूर्वं पृथिवीमटते वनम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000285098, "chapter_id": 20285, "verse_number": "१-३९-९९", "content_sanskrit": "पुण्यतीर्थजलोपेतं विविधान्याश्रमाणि च ।\nक्रतुभिर्यजमानांश्च समाप्तगुरुदक्षिणैः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000285099, "chapter_id": 20285, "verse_number": "१-३९-१००", "content_sanskrit": "अपश्यद्देवकुक्षिस्थान्यज्ञस्थान्शतशो द्विजान् ।\nसद्वृत्तमाश्रिताः सर्वे वर्णा ब्राह्मणपूर्वकाः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000285100, "chapter_id": 20285, "verse_number": "१-३९-१०१", "content_sanskrit": "चत्वार आश्रमाः सम्यग्यथापूर्वं विलोकिता ।\nएवं वर्षशतं साग्रं मार्कंडेयेन धीमता ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000285101, "chapter_id": 20285, "verse_number": "१-३९-१०२", "content_sanskrit": "चरता पृथिवी सर्वा तत्कुक्षौ हि समीक्ष्यते ।\nततः कदाचिदथ वै पुनः कुक्षेर्विनिर्गतः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000285102, "chapter_id": 20285, "verse_number": "१-३९-१०३", "content_sanskrit": "सुप्तंन्यग्रोधशाखायांबालमेकंनिरीक्ष्यच ।\nतथैवैकार्णवजले नीहारेणावृतांतरे ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000285103, "chapter_id": 20285, "verse_number": "१-३९-१०४", "content_sanskrit": "अव्यक्तक्रीडिते लोके सर्वभूतविवर्जिते ।\nस मुनिर्विस्मयाविष्टः कौतूहलसमन्वितः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000285104, "chapter_id": 20285, "verse_number": "१-३९-१०५", "content_sanskrit": "बालमादित्यसंकाशं न शक्नोत्यभिवीक्षितुम् ।\nसोप्यचिंतयदेकांते स्थित्वा सलिलसन्निधौ ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000285105, "chapter_id": 20285, "verse_number": "१-३९-१०६", "content_sanskrit": "पूर्वदृष्टमिदं मेने शंकितो देवमायया ।\nअगाधे सलिले शेते मार्कंडेयः सविस्मयः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000285106, "chapter_id": 20285, "verse_number": "१-३९-१०७", "content_sanskrit": "पूर्ववत्तमथो द्रष्टुमव्रजत्त्रस्तलोचनः ।\nस तस्मै भगवानाह स्वागतो बाल भो इति ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7000285107, "chapter_id": 20285, "verse_number": "१-३९-१०८", "content_sanskrit": "बभाषे मेघतुल्येन स्वरेण पुरुषोत्तमः ।\nमार्कंडेय न भेतव्यमागच्छस्व ममांतिकम् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7000285108, "chapter_id": 20285, "verse_number": "१-३९-१०९", "content_sanskrit": "मार्कंडेय उवाच ।\nको नाम्ना कीर्तयति मां कुर्वन्परिभवं मम ।\nदिव्यवर्षसहस्राख्यं धर्षयंश्चैव मे वयः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7000285109, "chapter_id": 20285, "verse_number": "१-३९-११०", "content_sanskrit": "न ह्येष च सदाचारो देवेष्वपि ममोचितः ।\nमां ब्रह्मापि हि सस्नेहो दीर्घायुरिति भाषते ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7000285110, "chapter_id": 20285, "verse_number": "१-३९-१११", "content_sanskrit": "कस्तपोघोरमासाद्य ममाद्य त्यक्तजीवितः ।\nमार्कंडेयेति मामुक्त्वा मृत्युमीक्षितुमर्हसि ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7000285111, "chapter_id": 20285, "verse_number": "१-३९-११२", "content_sanskrit": "एवं प्रक्षुभितः क्रोधान्मार्कंडेयो महामुनिः ।\nतदैनं भगवान्भूयो बभाषे मधुसूदनः ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7000285112, "chapter_id": 20285, "verse_number": "१-३९-११३", "content_sanskrit": "श्रीभगवानुवाच ।\nअहं ते जनको वत्स हृषीकेशः पिता गुरुः ।\nआयुः प्रदाता पौराणः किं मां त्वं नोपसर्पसि ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7000285113, "chapter_id": 20285, "verse_number": "१-३९-११४", "content_sanskrit": "मां पुत्रकामः प्रथमं त्वत्पितांगिरसो मुनिः ।\nपूर्वमाराधयामास तपस्तीव्रं समाश्रितः ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7000285114, "chapter_id": 20285, "verse_number": "१-३९-११५", "content_sanskrit": "तं दृष्ट्वा घोरतपसं त्रिदशोत्तमतेजसम् ।\nदत्तवांस्त्वामहं पुत्रं महर्षिममितौजसम् ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7000285115, "chapter_id": 20285, "verse_number": "१-३९-११६", "content_sanskrit": "कस्समुत्सहते चान्यो योगिभूतात्मगात्मकम् ।\nद्रष्टुमेकार्णवगतं क्रीडंतं योगमायया ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7000285116, "chapter_id": 20285, "verse_number": "१-३९-११७", "content_sanskrit": "ततः प्रहृष्टहृदयो विस्मयोत्फुल्ललोचनः ।\nमूर्ध्नि बद्धांजलिपुटो मार्कंडेयो माहातपाः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7000285117, "chapter_id": 20285, "verse_number": "१-३९-११८", "content_sanskrit": "नामगोत्रे तु संप्रोच्य दीर्घायुर्लोकपूजितः ।\nतस्मै भगवते भक्त्या नमस्कारमथाकरोत् ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7000285118, "chapter_id": 20285, "verse_number": "१-३९-११९", "content_sanskrit": "मार्कंडेय उवाच ।\nइच्छामि तत्त्वतो ज्ञातुमिमां मायां तवानघ ।\nयदेकार्णवमध्यस्थः शेषे त्वं बालरूपवान् ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7000285119, "chapter_id": 20285, "verse_number": "१-३९-१२०", "content_sanskrit": "किं संज्ञश्चैव भगवान्लोके विज्ञायसे प्रभो ।\nतर्कयेहं महात्मानं को ह्यन्यः स्थातुमर्हसि ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7000285120, "chapter_id": 20285, "verse_number": "१-३९-१२१", "content_sanskrit": "श्रीभगवानुवाच ।\nअहं नारायणो ब्रह्मन्सर्वभूतविनाशनः ।\nअहं सहस्रशीर्षास्यः सहस्रपदसंयुतः ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7000285121, "chapter_id": 20285, "verse_number": "१-३९-१२२", "content_sanskrit": "आदित्यवर्णः पुरुषो मुखे ब्रह्ममयो ह्यहम् ।\nअहमग्निर्हव्यवहः सप्तसप्तिभिरन्वितः ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7000285122, "chapter_id": 20285, "verse_number": "१-३९-१२३", "content_sanskrit": "अहमिंद्रपदः शक्र ॠतूनां परिवत्सरः ।\nअहं योगिषु सांख्याख्यो युगांतावर्त एव च ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7000285123, "chapter_id": 20285, "verse_number": "१-३९-१२४", "content_sanskrit": "अहं सर्वाणि सत्वानि दैवतान्यखिलानि च ।\nभुजगानामहं शेषस्तार्क्ष्योऽहं सर्वपक्षिणाम् ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7000285124, "chapter_id": 20285, "verse_number": "१-३९-१२५", "content_sanskrit": "कृतांतः सर्वभूतानां विज्ञेयः कालसंज्ञितः ।\nअहं धर्मस्तपश्चाहं सर्वाश्रमनिवासिनाम् ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7000285125, "chapter_id": 20285, "verse_number": "१-३९-१२६", "content_sanskrit": "अहं दया परोधर्मः क्षीरोदोहं महार्णवः ।\nयत्सत्यं तत्परं त्वेक अहमेव प्रजापतिः ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7000285126, "chapter_id": 20285, "verse_number": "१-३९-१२७", "content_sanskrit": "अहं सांख्यमहं योगो ह्यहं तत्परमं पदम् ।\nअहमिज्या क्रिया चाहमहं विद्याधिपः स्मृतः ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7000285127, "chapter_id": 20285, "verse_number": "१-३९-१२८", "content_sanskrit": "अहं ज्योतिरहं वायुरहं भूमिरहं जलम् ।\nआकाशोहं समुद्राश्च नक्षत्राणि दिशो दश ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7000285128, "chapter_id": 20285, "verse_number": "१-३९-१२९", "content_sanskrit": "अहं वर्षमहं सोमः पर्जन्योहमहं रविः ।\nअहं पुराणं परमं तथैवाहं परायणम् ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7000285129, "chapter_id": 20285, "verse_number": "१-३९-१३०", "content_sanskrit": "भविष्ये चापि सर्वत्र भविष्यत्सर्वसंग्रहः ।\nयत्किंचित्पश्यसे विप्र यच्छृणोषि च किंचन ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7000285130, "chapter_id": 20285, "verse_number": "१-३९-१३१", "content_sanskrit": "यच्चानुभवसे लोके तत्सर्वं मामनुस्मर ।\nविश्वं सृष्टं मया पूर्वं सृजेद्यापि च पश्य माम् ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7000285131, "chapter_id": 20285, "verse_number": "१-३९-१३२", "content_sanskrit": "युगे युगे च रक्षामि मार्कंडेयाखिलं जगत् ।\nतदेतत्कथितं सर्वं मार्कंडेयावधारय ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7000285132, "chapter_id": 20285, "verse_number": "१-३९-१३३", "content_sanskrit": "शुश्रूषुरपि धर्मेषु कुक्षौ चरसुखं मम ।\nमम ब्रह्मा शरीरस्थो देवाश्च ॠषिभिः सह ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7000285133, "chapter_id": 20285, "verse_number": "१-३९-१३४", "content_sanskrit": "व्यक्तमव्यक्तयोगं मामवगच्छ मुरद्विषम् ।\nअहमेकाक्षरो मंत्रस्त्र्यक्षरश्च पितामहः ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7000285134, "chapter_id": 20285, "verse_number": "१-३९-१३५", "content_sanskrit": "परस्त्रिवर्गओंकारः परमात्मप्रदर्शनः ।\nएवमादिपुराणं च वदतेमां महामते ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7000285135, "chapter_id": 20285, "verse_number": "१-३९-१३६", "content_sanskrit": "वक्त्रं यातो भगवतो मार्कंडेयो महामुनिः ।\nततो भगवतः कुक्षिं प्रविष्टो मुनिसत्तमः ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7000285136, "chapter_id": 20285, "verse_number": "१-३९-१३७", "content_sanskrit": "तस्यासम्मुखमेकान्ते शुश्रूषुर्हंसमव्ययम् ।\nयदक्षयं विविधमुपाश्रितं तु तन्महार्णवे व्यपगतचंद्रभास्करे ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7000285137, "chapter_id": 20285, "verse_number": "१-३९-१३८", "content_sanskrit": "शनैश्चरन्प्रभुरथ हंससंज्ञितः सृजन्जगद्विहरति कालपर्यये ।\nअथ चैवं शुचिर्भूत्वा वरयामास वै तपः ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7000285138, "chapter_id": 20285, "verse_number": "१-३९-१३९", "content_sanskrit": "छादयित्वात्मनो देहं पयसांबुजसंभवः ।\nततो महात्मातिबलो मर्त्यलोकविसर्जने ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7000285139, "chapter_id": 20285, "verse_number": "१-३९-१४०", "content_sanskrit": "महतां चैव भूतानां विश्वो विश्वमचिंतयत् ।\nतस्य चिंतयमानस्य नियते संस्थितेर्णवे ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7000285140, "chapter_id": 20285, "verse_number": "१-३९-१४१", "content_sanskrit": "निराकाशे तोयमये सूक्ष्मे जगति संक्षये ।\nईशः संक्षोभयामास सोर्णवं सलिलं गतः ॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7000285141, "chapter_id": 20285, "verse_number": "१-३९-१४२", "content_sanskrit": "अथांतरादपां सूक्ष्ममथ च्छिद्रमभूत्पुरा ।\nशब्दं प्रति ततो भूतो मारुतश्छिद्रसंभवः ॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7000285142, "chapter_id": 20285, "verse_number": "१-३९-१४३", "content_sanskrit": "संलब्ध्वांतरसंक्षोभं व्यवर्धत समीरणः ।\nनभस्वता बलवता वेगाद्विक्षोभितोर्णवः ॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7000285143, "chapter_id": 20285, "verse_number": "१-३९-१४४", "content_sanskrit": "तस्यार्णवस्य क्षुब्धस्य तस्मिन्नंभसि मथ्यतः ।\nकृष्णवर्त्मा समभवत्प्रभुर्वैश्वानरो महान् ॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 7000285144, "chapter_id": 20285, "verse_number": "१-३९-१४५", "content_sanskrit": "ततः संशोषयामास पावकः सलिलं बहु ।\nसमस्तजलधिश्छिद्रमभवद्विसृतं नभः ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 7000285145, "chapter_id": 20285, "verse_number": "१-३९-१४६", "content_sanskrit": "आत्मतेजोभवाः पुण्या आपोमृतरसोपमाः ।\nआकाशं छिद्रसंभूतं वायुराकाशसंभवः ॥१४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 7000285146, "chapter_id": 20285, "verse_number": "१-३९-१४७", "content_sanskrit": "अथ संघर्षसम्भूतं पावकं चास्य संभवम् ।\nदृष्ट्वा पितामहो देवो महाभूतविभावनः ॥१४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 7000285147, "chapter_id": 20285, "verse_number": "१-३९-१४८", "content_sanskrit": "दृष्ट्वा भूतानि भगवान्लोकसृष्ट्यर्थमुत्तमम् ।\nब्रह्मणो जन्मसहितं बहुरूपो ह्यचिंतयत् ॥१४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 7000285148, "chapter_id": 20285, "verse_number": "१-३९-१४९", "content_sanskrit": "चतुर्युगानां संख्यातं सहस्रं युगपर्यये ।\nयत्पृथिव्यां द्विजेंद्राणां तपसा भावितात्मनाम् ॥१४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 7000285149, "chapter_id": 20285, "verse_number": "१-३९-१५०", "content_sanskrit": "बहुजन्मविशुद्धात्मा ब्रह्मणो हरिरुच्यते ।\nज्ञानं दृष्ट्वा तु विश्वात्मा योगिनां याति योग्यताम् ॥१५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 7000285150, "chapter_id": 20285, "verse_number": "१-३९-१५१", "content_sanskrit": "तं योगवंतं विज्ञाय संपूर्णैश्वर्यमुत्तमम् ।\nपदे ब्रह्मणि विश्वस्य न्ययोजयत योगवित् ॥१५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}, {"id": 7000285151, "chapter_id": 20285, "verse_number": "१-३९-१५२", "content_sanskrit": "ततस्तस्मिन्महातोये महेशो हरिरच्युतः ।\nजलक्रीडां च विधिवत्स चक्रे सर्वलोककृत् ॥१५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 152}, {"id": 7000285152, "chapter_id": 20285, "verse_number": "१-३९-१५३", "content_sanskrit": "पद्मं नाभ्युद्भवं चैकं समुत्पादितवांस्ततः ।\nसहस्त्रवर्णं विरजं भास्कराभं हिरण्मयम् ॥१५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 153}, {"id": 7000285153, "chapter_id": 20285, "verse_number": "१-३९-१५४", "content_sanskrit": "हुताशनज्वलितशिखोज्जवलप्रभं समुत्थितं शरदमलार्कतेजसम् ।\nविराजते कमलमुदारवर्चसं महात्मनस्तनुरुह चारुशैवलम् ॥१५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 154}]