[{"id": 5000612000, "chapter_id": 9612, "verse_number": "७-७७-१", "content_sanskrit": "पुरा त्रेतायुगे राम बभूव बहुविस्तरम् ।\nसमन्ताद्योजनशतं विमृगं पक्षिवर्जितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000612001, "chapter_id": 9612, "verse_number": "७-७७-२", "content_sanskrit": "तस्मिन्निर्मानुषे ऽरण्ये कुर्वाणस्तप उत्तमम् ।\nअहमाक्रमितुं सौम्य तदरण्यमुपागमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000612002, "chapter_id": 9612, "verse_number": "७-७७-३", "content_sanskrit": "तस्य रूपमरण्यस्य निर्देष्टुं न शशाक ह ।\nफलमूलैः सुखास्वादैर्बहुरूपैश्च पादपैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000612003, "chapter_id": 9612, "verse_number": "७-७७-४", "content_sanskrit": "तस्यारण्यस्य मध्ये तु सरो योजनमायतम् ।\nहंसकारण्डवाकीर्णं चक्रवाकोपशोभितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000612004, "chapter_id": 9612, "verse_number": "७-७७-५", "content_sanskrit": "पद्मोत्पलसमाकीर्णं समतिक्रान्तशैवलम् ।\nतदाश्चर्यमिवात्यर्थं सुखास्वादमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000612005, "chapter_id": 9612, "verse_number": "७-७७-६", "content_sanskrit": "अरजस्कं तथा ऽक्षोभ्यं श्रीमत्पक्षिगणायुतम् ।\nसमीपे तस्य सरसो महदद्भुतमाश्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000612006, "chapter_id": 9612, "verse_number": "७-७७-७", "content_sanskrit": "पुराणं पुण्यमत्यर्थं तपस्विजनवर्जितम् ।\nतत्राहमवसं रात्रिं नैदाघीं पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000612007, "chapter_id": 9612, "verse_number": "७-७७-८", "content_sanskrit": "प्रभाते काल्यमुत्थाय सरस्तदुपचक्रमे ।\nअथापश्यं शवं तत्र सुपुष्टमजरं क्वचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000612008, "chapter_id": 9612, "verse_number": "७-७७-९", "content_sanskrit": "पङ्किभेदेन पुष्टाङ्गं समाश्रितसरोवरम् ।\nतिष्ठन्तं परया लक्ष्म्या तस्मिंस्तोयाशये नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000612009, "chapter_id": 9612, "verse_number": "७-७७-१०", "content_sanskrit": "तमर्थं चिन्तयानो ऽहं मुहूर्तं तत्र राघव ।\nउषितो ऽस्मि सरस्तीरे किन्न्विदं स्यादिति प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000612010, "chapter_id": 9612, "verse_number": "७-७७-११", "content_sanskrit": "अथापश्यं मुहूर्तेन दिव्यमद्भुतदर्शनम् ।\nविमानं परमोदारं हंसयुक्तं मनोजवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000612011, "chapter_id": 9612, "verse_number": "७-७७-१२", "content_sanskrit": "अत्यर्थं स्वर्गिणं त विमाने रघुनन्दन ।\nउपास्ते ऽप्सरसां वीर सहस्रं दिव्यभूषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000612012, "chapter_id": 9612, "verse_number": "७-७७-१३", "content_sanskrit": "गायन्ति दिव्यगेयानि वादयन्ति तथा ऽपराः ।\nक्ष्वेलयन्ति तथा चान्या नृत्यन्ति च तथा ऽपराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000612013, "chapter_id": 9612, "verse_number": "७-७७-१४", "content_sanskrit": "अपराश्चन्द्ररश्म्याभैर्हेमदण्डैश्च चामरैः ।\nदोधूयुर्वदनं तस्य पुण्डरीकनिभेक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000612014, "chapter_id": 9612, "verse_number": "७-७७-१५", "content_sanskrit": "ततः सिंहासनं त्यक्त्वा मेरुकूटमिवांशुमान् ।\nपश्यतो मे तदा राम विमानादवरुह्य च ।\nतं शवं भक्षयामास स स्वर्गी रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000612015, "chapter_id": 9612, "verse_number": "७-७७-१६", "content_sanskrit": "तथा भुक्त्वा यथाकामं मांसं बहु सुपीवरम् ।\nअवतीर्य सरः स्वर्गी संस्प्रष्टुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000612016, "chapter_id": 9612, "verse_number": "७-७७-१७", "content_sanskrit": "उपस्पृश्य यथान्यायं स स्वर्गी रघुपुङ्गव ।\nआरोढुमुपचक्राम विमानवरमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000612017, "chapter_id": 9612, "verse_number": "७-७७-१८", "content_sanskrit": "तमहं देवसङ्काशमारोहन्तमुदीक्ष्य वै ।\nअथाहमब्रुवं वाक्यं स्वर्गिणं पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000612018, "chapter_id": 9612, "verse_number": "७-७७-१९", "content_sanskrit": "को भवान्देवसङ्काश आहारश्च विगर्हितः ।\nत्वयेदं भुज्यते सौम्य किमर्थं वक्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000612019, "chapter_id": 9612, "verse_number": "७-७७-२०", "content_sanskrit": "कस्य स्यादीदृशो भाव आहारो देवसम्मतः ।\nआश्चर्यं वर्तते सौम्य श्रोतुमिच्छामि तत्त्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000612020, "chapter_id": 9612, "verse_number": "७-७७-२१", "content_sanskrit": "नाहमौपयिकं मन्ये तव भक्ष्यमिदं शवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000612021, "chapter_id": 9612, "verse_number": "७-७७-२२", "content_sanskrit": "इत्येवमुक्तः स नरेन्द्र नाकी कौतूहलात्सूनृतया गिरा च ।\nश्रुत्वा च वाक्यं मम सर्वमेतत्सर्वं तथा चाकथयन्ममेति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000612022, "chapter_id": 9612, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे सप्तसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]