[{"id": 2038953, "chapter_id": 1851, "verse_number": "५-९६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2038954, "chapter_id": 1851, "verse_number": "५-९६-१", "content_sanskrit": "तस्मिन्नभिहिते वाक्ये केशवेन महात्मना।\nस्तिमिता हृष्टरोमाण आसन्सर्वे सभासदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2038955, "chapter_id": 1851, "verse_number": "५-९६-२", "content_sanskrit": "कस्स्विदुत्तरमेतेषां वक्तुमुत्सहते पुमान्।\nइति सर्वे मनोभिस्ते चिन्तयन्ति स्म पार्थिवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2038956, "chapter_id": 1851, "verse_number": "५-९६-३", "content_sanskrit": "तथा तेषु च सर्वेषु तूष्णींभूतेषु राजसु ।\nजामदग्न्य इदं वाक्यमब्रवीत्कुरुसंसदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2038957, "chapter_id": 1851, "verse_number": "५-९६-४", "content_sanskrit": "इमां मे सोपमां वाचं श्रृणु सत्यामशङ्कितः ।\nतां श्रुत्वा श्रेय आदत्स्व यदि साध्विति मन्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2038958, "chapter_id": 1851, "verse_number": "५-९६-५", "content_sanskrit": "राजा दम्भोद्भवो नाम सार्वभौमः पुराऽभवत्।\nअखिलां बुभुजे सर्वां पृथिवीमिति नः श्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2038959, "chapter_id": 1851, "verse_number": "५-९६-६", "content_sanskrit": "स स्म नित्यं निशापाये प्रातरुत्थाय वीर्यवान् ।\nब्राह्मणान्क्षत्रियान्वैश्यान्पृच्छन्नास्ते महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2038960, "chapter_id": 1851, "verse_number": "५-९६-७", "content_sanskrit": "अस्ति कश्चिद्विशिष्टो वा मद्विधो वा भवेद्युधि ।\nशूद्रो वैश्यः क्षत्रियो वा ब्राह्मणो वाऽपि शस्त्रभृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2038961, "chapter_id": 1851, "verse_number": "५-९६-८", "content_sanskrit": "इति ब्रुवन्नन्वचरत्स राजा पृथिवीमिमाम्।\nदर्पेण महता मत्तः कञ्चिदन्यमचिन्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2038962, "chapter_id": 1851, "verse_number": "५-९६-९", "content_sanskrit": "तं च वैद्या अकृपणा ब्राह्मणाः सर्वतोऽभयाः।\nप्रत्यषेधन्त राजानं श्लाघमानं पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2038963, "chapter_id": 1851, "verse_number": "५-९६-१०", "content_sanskrit": "निषिध्यमानोऽप्यसकृत्पृच्छत्येव स वै द्विजान् ।\nअतिमानं श्रिया मत्तं तमूचुर्ब्राह्मणास्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2038964, "chapter_id": 1851, "verse_number": "५-९६-११", "content_sanskrit": "तपस्विनो महात्मानो वेदप्रत्ययदर्शिनः ।\nउदीर्यमाणं राजानं क्रोधदीप्ता द्विजातयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2038965, "chapter_id": 1851, "verse_number": "५-९६-१२", "content_sanskrit": "अनेकजयिनौ शङ्ख्ये यौ वै पुरुषसत्तमौ ।\nतयोस्त्वं न समो राजन्भवितासि कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2038966, "chapter_id": 1851, "verse_number": "५-९६-१३", "content_sanskrit": "एवमुक्तः स राजा तु पुनः पप्रच्छ तान्द्विजान्।\nक्व तौ वीरौ क्वजन्मानौ किंकर्माणौ च कौ च तौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2038967, "chapter_id": 1851, "verse_number": "५-९६-१४x", "content_sanskrit": "ब्राह्मणा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2038968, "chapter_id": 1851, "verse_number": "५-९६-१४", "content_sanskrit": "नरो नारायणश्चैव तापसाविति नः श्रुतम्।\nआयातौ मानुषे लोके ताभ्यां युद्ध्यस्व पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2038969, "chapter_id": 1851, "verse_number": "५-९६-१५", "content_sanskrit": "श्रूयेते तौ महात्मानौ नरनारायणावुभौ ।\nतपो घोरमनिर्देश्यं तप्येते गन्धमादने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2038970, "chapter_id": 1851, "verse_number": "५-९६-१६", "content_sanskrit": "स राजा महतीं सेनां योजयित्वा षडङ्गिनीम् ।\nअमृष्यमाणः संप्रायाद्यत्र तावपराजितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2038971, "chapter_id": 1851, "verse_number": "५-९६-१७", "content_sanskrit": "स गत्वा विषमं घोरं पर्वतं गन्धमादनम्।\nमार्गमाणोऽन्वगच्छत्तौ तापसौ वनमाश्रितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2038972, "chapter_id": 1851, "verse_number": "५-९६-१८", "content_sanskrit": "तौ दृष्ट्वा क्षुत्पिपासाभ्यां कृशौ धमनिसन्ततौ ।\nशीतवातातपैश्चैव कर्शितौ पुरुषोत्तमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2038973, "chapter_id": 1851, "verse_number": "५-९६-१९", "content_sanskrit": "अभिगम्योपसङ्गृह्य पर्यपृच्छदनामयम्।\nतमर्चित्वा मूलफलैरासनेनोदकेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2038974, "chapter_id": 1851, "verse_number": "५-९६-२०", "content_sanskrit": "न्यमन्त्रयेतां राजानं किं कार्यं क्रियतामिति।\nततस्तामानुपूर्वी स पुनरेवान्वकीर्तयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2038975, "chapter_id": 1851, "verse_number": "५-९६-२१", "content_sanskrit": "बाहुभ्यां मे जिता भूमिर्निहताः सर्वशत्रवः।\nभवद्भ्यां युद्धमाकाङ्क्षन्नुपयातोऽस्मि पर्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2038976, "chapter_id": 1851, "verse_number": "५-९६-२२", "content_sanskrit": "आतिथ्यं दीयतामेतत्काङ्क्षितं मे चिरं प्रति।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2038977, "chapter_id": 1851, "verse_number": "५-९६-२२x", "content_sanskrit": "नरनारायणावूचतुः।\nअपेतक्रोधलोभोऽयमाश्रमो राजसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2038978, "chapter_id": 1851, "verse_number": "५-९६-२३", "content_sanskrit": "न ह्यस्मिन्नाश्रमे युद्धं कुतः शस्त्रं कुतोऽनृजुः ।\nअन्यत्र युद्धमाकाङ्क्ष बहवः क्षत्रियाः क्षितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2038979, "chapter_id": 1851, "verse_number": "५-९६-२४x", "content_sanskrit": "राम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2038980, "chapter_id": 1851, "verse_number": "५-९६-२४", "content_sanskrit": "उच्यमानस्तथाऽपि स्म भूय एवाभ्यभाषत।\nपुनः पुनः क्षाम्यमाणः सान्त्व्यमानश्च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2038981, "chapter_id": 1851, "verse_number": "५-९६-२५", "content_sanskrit": "दम्भोद्भवो युद्धमिच्छन्नाह्वयत्येव तापसौ ।\nततो नरस्त्विषीकाणां मुष्टिमादाय भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2038982, "chapter_id": 1851, "verse_number": "५-९६-२६", "content_sanskrit": "अब्रवीदेहि युद्ध्यस्व युद्धकामुक क्षत्रिय।\nसर्वशस्त्राणि चादत्स्व योजयस्व च वाहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2038983, "chapter_id": 1851, "verse_number": "५-९६-२७", "content_sanskrit": "अहं हि ते विनेष्यामि युद्धश्रद्धामितः परम् ।\n`यदाह्वयसि दर्पेण ब्राह्मणप्रमुखाञ्जनान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2038984, "chapter_id": 1851, "verse_number": "५-२९-१८x", "content_sanskrit": "दम्भोद्भव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2038985, "chapter_id": 1851, "verse_number": "५-९६-२८", "content_sanskrit": "यद्येतदस्त्रमस्मासु युक्तं तापस मन्यसे।\nएतेनापि त्वया योत्स्ये युद्धार्थी ह्यहमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2038986, "chapter_id": 1851, "verse_number": "५-९६-२९x", "content_sanskrit": "राम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2038987, "chapter_id": 1851, "verse_number": "५-९६-२९", "content_sanskrit": "इत्युक्त्वा शरवर्षेण सर्वतः समवाकिरत् ।\nदम्भोद्भवस्तापसं तं जिवांसुः सहसैनिकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2038988, "chapter_id": 1851, "verse_number": "५-९६-३०", "content_sanskrit": "तस्य तानस्यतो घोरानिषून्परतनुच्छिदः।\nकदर्थीकृत्य स मुनिरिषीकाभिः समार्पयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2038989, "chapter_id": 1851, "verse_number": "५-९६-३१", "content_sanskrit": "ततोऽस्मौ प्रासृजद्धोरमैषीकमपराजितः।\nअस्त्रमप्रतिसन्धेयं तदुद्भुतमिवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2038990, "chapter_id": 1851, "verse_number": "५-९६-३२", "content_sanskrit": "तेषामक्षीणि कर्णांश्च नासिकाश्चैव मायया ।\nनिमित्तवेधी स मुनिरीषीकाभिः समार्पयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2038991, "chapter_id": 1851, "verse_number": "५-९६-३३", "content_sanskrit": "स दृष्ट्वा श्वेतमाकाशमिषीकाभिः समाचितम् ।\nपादयोर्न्यपतद्राजा स्वस्ति मेस्त्विति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2038992, "chapter_id": 1851, "verse_number": "५-९६-३४", "content_sanskrit": "तमब्रवीन्नरो राजञ्शरण्यः शरणैषिणाम् ।\nब्रह्मण्यो भव धर्मात्मा मा च स्मैवं पुनः कृथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2038993, "chapter_id": 1851, "verse_number": "५-९६-३५", "content_sanskrit": "नैतादृक्पुरुषो राजन्क्षत्रधर्ममनुस्मरन्।\nमनसा नृपशार्दूल भवेत्परपुरञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2038994, "chapter_id": 1851, "verse_number": "५-९६-३६", "content_sanskrit": "मा च दर्पसमाविष्टः वा तत्ते राजन्समाहितम् ॥\nकृतप्रज्ञो वीतलोभो निरहङ्कार आत्मवान् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2038995, "chapter_id": 1851, "verse_number": "५-९६-३७", "content_sanskrit": "दान्तः क्षान्तो मृदुः सौम्य प्रजाः पालय पार्थिव ॥\nमास्म भूयः क्षिपेः कंचिदविदित्वा बलाबलम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2038996, "chapter_id": 1851, "verse_number": "५-९६-३८", "content_sanskrit": "अनुज्ञातः स्वस्ति गच्च मैवं भूयः समाचरेः ।\nकुशलं ब्राह्मणान्पृच्छेरावयोर्वचनाद्भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2038997, "chapter_id": 1851, "verse_number": "५-९६-३९", "content_sanskrit": "ततो राजा तयोः पादावभिवाद्य महात्मनोः ।\nप्रत्याजगाम स्वपुरं धर्मं चैवाचरद्भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2038998, "chapter_id": 1851, "verse_number": "५-९६-४०", "content_sanskrit": "सुमहच्चापि तत्कर्म यन्नरेण कृतं पुरा ।\nततो गुणैः सुबहुभिः श्रेष्ठो नारायणोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2038999, "chapter_id": 1851, "verse_number": "५-९६-४१", "content_sanskrit": "तस्माद्यावद्धनुःश्रेष्ठे गाण्डीवेऽस्त्रं न युज्यते।\nतावत्त्वं मानमुत्सृज्य गच्छ राजन्धनञ्जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2039000, "chapter_id": 1851, "verse_number": "५-९६-४२", "content_sanskrit": "काकुदीकं शुकं नाकमक्षिसन्तर्जनं तथा।\nसन्तानं नर्तकं घोरमास्यमोदकमष्टमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2039001, "chapter_id": 1851, "verse_number": "५-९६-४३", "content_sanskrit": "एतैर्विद्धाः सर्व एव मरणं यान्ति मानवाः ।\nउन्मत्ताश्च विचेष्टन्ते नष्टसंज्ञा विचेतसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2039002, "chapter_id": 1851, "verse_number": "५-९६-४४", "content_sanskrit": "` स्वपन्ति च प्लवन्ते च च्छर्दयन्ति च मानवाः ।\nमूत्रयन्ते च सततं रुदन्ति च हसन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2039003, "chapter_id": 1851, "verse_number": "५-९६-४५", "content_sanskrit": "कामक्रोधौ लोभमोहौ मदमानौ तथैव च।\nमात्सर्याहङ्कुती चैव क्रमादेत उदाहृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2039004, "chapter_id": 1851, "verse_number": "५-९६-४६", "content_sanskrit": "निर्माता सर्वलोकानामीश्वरः सर्वकर्मवित्।\nयस्य नारायणो बन्धुरर्जुनो दुःसहो युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2039005, "chapter_id": 1851, "verse_number": "५-९६-४७", "content_sanskrit": "कस्तमुत्सहते जेतुं त्रिषु लोकेषु भारत।\nवीरं कपिध्वजं जिष्णुं यस्य नास्ति समो युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2039006, "chapter_id": 1851, "verse_number": "५-९६-४८", "content_sanskrit": "असङ्ख्येया गुणाः पार्थे तद्विशिष्टो जनार्दनः।\nत्वमेव भूयो जानासि कुन्तीपुत्रं धनञ्जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2039007, "chapter_id": 1851, "verse_number": "५-९६-४९", "content_sanskrit": "नरनारायणौ यौ तौ तावेवार्जुनकेशवौ ।\nविजानीहि महाराज प्रवीरौ पुरुषोत्तमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2039008, "chapter_id": 1851, "verse_number": "५-९६-५०", "content_sanskrit": "यद्येतदेवं जानासि न च मामभिशङ्कसे ।\nआर्यां मतिं समास्थाय शाम्य भारत पाण्डवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2039009, "chapter_id": 1851, "verse_number": "५-९६-५१", "content_sanskrit": "अथ चेन्मन्यसे श्रेयो न मे भेदो भवेदिति ।\nप्रशाम्य भरतश्रेष्ठ मा च युद्धे मनः कृथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2039010, "chapter_id": 1851, "verse_number": "५-९६-५२", "content_sanskrit": "भवतां च कुरुश्रेष्ठ कुलं बहुमतं भुवि ।\nतत्तथैवास्तु भद्रं ते स्वार्थमेवोपचिन्तय ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2039011, "chapter_id": 1851, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि षण्णवतितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]