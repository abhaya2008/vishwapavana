[{"id": 2003137, "chapter_id": 1065, "verse_number": "१-६६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2003138, "chapter_id": 1065, "verse_number": "१-६६-१", "content_sanskrit": "अथ नारायणेनेन्द्रश्चकार सह संविदम्।\nअवतर्तुं महीं स्वर्गादंशतः महितः सुरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2003139, "chapter_id": 1065, "verse_number": "१-६६-२", "content_sanskrit": "आदिश्य च स्वयं शक्रः सर्वानेव दिवौकसः।\nनिर्जगाम पुनस्तस्मात्क्षयान्नारायणस्य ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2003140, "chapter_id": 1065, "verse_number": "१-६६-३", "content_sanskrit": "तेऽमरारिविनाशाय सर्वलोकहिताय च।\nअवतेरुः क्रमेणैव महीं स्वर्गाद्दिवौकसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2003141, "chapter_id": 1065, "verse_number": "१-६६-४", "content_sanskrit": "ततो ब्रह्मर्षिवंशेषु पार्थिवर्षिकुलेषु च।\nजज्ञिरे राजशार्दूल यथाकामं दिवौकसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2003142, "chapter_id": 1065, "verse_number": "१-६६-५", "content_sanskrit": "दानवान्राक्षसांश्चैव गन्धर्वान्पन्नगांस्तथा।\nपुरुषादानि चान्यानि जघ्नुः सत्वान्यनेकशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2003143, "chapter_id": 1065, "verse_number": "१-६६-६", "content_sanskrit": "दानवा राक्षसाश्चैव गन्धर्वाः पन्नगास्तथा।\nन तान्बलस्थान्बाल्येऽपि जघ्नुर्भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2003144, "chapter_id": 1065, "verse_number": "१-६६-७x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2003145, "chapter_id": 1065, "verse_number": "१-६६-७", "content_sanskrit": "देवदानवसङ्घानां गन्धर्वाप्सरसां तथा।\nमानवानां च सर्वेषां तथा वै यक्षरक्षसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2003146, "chapter_id": 1065, "verse_number": "१-६६-८", "content_sanskrit": "श्रोतुमिच्छामि तत्त्वेन संभवं कृत्स्नमादितः।\nप्राणिनां चैव सर्वेषां संभवं वक्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2003147, "chapter_id": 1065, "verse_number": "१-६६-९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2003148, "chapter_id": 1065, "verse_number": "१-६६-९", "content_sanskrit": "हन्त ते कथयिष्यामि नमस्कृत्य स्वयंभुवे।\nसुरादीनामहं सम्यग्लोकानां प्रभवाप्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2003149, "chapter_id": 1065, "verse_number": "१-६६-१०", "content_sanskrit": "ब्रह्मणो मानसाः पुत्रा विदिताः षण्महर्षयः।\nमरीचिरत्र्यह्गिरसौ पुलस्त्यः पुलहः क्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2003150, "chapter_id": 1065, "verse_number": "१-६६-११", "content_sanskrit": "मरीचेः कश्यपः पुत्रः कश्यपात्तु इमाः प्रजाः।\nप्रजज्ञिरे महाभागा दक्षकन्यास्त्रयोदश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2003151, "chapter_id": 1065, "verse_number": "१-६६-१२", "content_sanskrit": "अदितिर्दितिर्दनुः काला दनायुः सिंहिका तथा।\nक्रोधा प्राधा च विश्वा च विनता कपिला मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2003152, "chapter_id": 1065, "verse_number": "१-६६-१३", "content_sanskrit": "कद्रूश्च मनुजव्याघ्र दक्षकन्यैव भारत।\nएतासां वीर्यसंपन्नं पुत्रपौत्रमनन्तकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2003153, "chapter_id": 1065, "verse_number": "१-६६-१४", "content_sanskrit": "अदित्यां द्वादशादित्याः संभूता भुवनेश्वराः।\nये राजन्नामतस्तांस्ते कीर्तयिष्यामि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2003154, "chapter_id": 1065, "verse_number": "१-६६-१५", "content_sanskrit": "धाता मित्रोऽर्यमा शक्रो वरुणस्त्वंश एव च।\nभगो विवस्वान्पूषा च सविता दशमस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2003155, "chapter_id": 1065, "verse_number": "१-६६-१६", "content_sanskrit": "एकादशस्तथा त्वष्टा द्वादशो विष्णुरुच्यते।\nजघन्यजस्तु सर्वेषामादित्यानां गुणाधिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2003156, "chapter_id": 1065, "verse_number": "१-६६-१७", "content_sanskrit": "एक एव दितेः पुत्रो हिरण्यकशिपुः स्मृतः।\nनाम्ना ख्यातास्तु तस्येमे पञ्च पुत्रा महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2003157, "chapter_id": 1065, "verse_number": "१-६६-१८", "content_sanskrit": "प्रह्लादः पूर्वजस्तेषां संह्लादस्तदनन्तरम्।\nअनुह्लादस्तृतीयोऽभूत्तस्माच्च शिबिबाष्कलौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2003158, "chapter_id": 1065, "verse_number": "१-६६-१९", "content_sanskrit": "प्रह्लादस्य त्रयः पुत्राः ख्याताः सर्वत्र भारत।\nविरोचनश्च कुम्भश्च निकुम्भश्चेति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2003159, "chapter_id": 1065, "verse_number": "१-६६-२०", "content_sanskrit": "विरोचनस्य पुत्रोऽभूद्बलिरेकः प्रतापवान्।\nबलेश्च प्रथितः पुत्रो बाणो नाम महासुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2003160, "chapter_id": 1065, "verse_number": "१-६६-२१", "content_sanskrit": "रुद्रस्यानुचरः श्रीमान्महाकालेति यं विदुः।\nचत्वारिंशद्दनोः पुत्राः ख्याताः सर्वत्र भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2003161, "chapter_id": 1065, "verse_number": "१-६६-२२", "content_sanskrit": "तेषां प्रथमजो राजा विप्रचित्तिर्महायशाः।\nशम्बरो नमुचिश्चैव पुलोमा चेति विश्रुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2003162, "chapter_id": 1065, "verse_number": "१-६६-२३", "content_sanskrit": "असिलोमा च केशी च दुर्जयश्चैव दानवः।\nअयःशिरा अश्वशिरा अश्वशह्कुश्च वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2003163, "chapter_id": 1065, "verse_number": "१-६६-२४", "content_sanskrit": "तथा गगनमूर्धा च वेगवान्केतुमांश्च सः।\nस्वर्भानुरश्वोऽश्वपतिर्वृषपर्वाऽजकस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2003164, "chapter_id": 1065, "verse_number": "१-६६-२५", "content_sanskrit": "अश्वग्रीवश्च सूक्ष्मश्च तुहुण्डश्च महाबलः।\nइषुपादेकचक्रश्च विरूपाक्षहराहरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2003165, "chapter_id": 1065, "verse_number": "१-६६-२६", "content_sanskrit": "निचन्द्रश्च निकुम्भश्च कुपटः कपटस्तथा।\nशरभः शलभश्चैव सूर्याचन्द्रमसौ तथा।\nएते ख्याता दनोर्वंशे दानवाः परिकीर्तिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2003166, "chapter_id": 1065, "verse_number": "१-६६-२७", "content_sanskrit": "अन्यौ तु खलु देवानां सूर्याचन्द्रमसौ स्मृतौ।\nअन्यौ दानवमुख्यानां सूर्याचन्द्रमसौ तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2003167, "chapter_id": 1065, "verse_number": "१-६६-२८", "content_sanskrit": "इमे च वंशाः प्रथिताः सत्ववन्तो महाबलाः।\nदनुपुत्रा महाराज दश दानववंशजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2003168, "chapter_id": 1065, "verse_number": "१-६६-२९", "content_sanskrit": "एकाक्षो मृतपो वीरः प्रलम्बनरकावपि।\nवातापिः शत्रुतपनः शठश्चैव महासुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2003169, "chapter_id": 1065, "verse_number": "१-६६-३०", "content_sanskrit": "गविष्ठश्च वनायुश्च दीर्घजिह्वश्च दानवः।\nअसङ्ख्येयाः स्मृतास्तेषां पुत्राः पौत्राश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2003170, "chapter_id": 1065, "verse_number": "१-६६-३१", "content_sanskrit": "सिंहिका सुषुवे पुत्रं राहुं चन्द्रार्कमर्दनम्।\nसुचन्द्रं चन्द्रहर्तारं तथा चन्द्रप्रमर्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2003171, "chapter_id": 1065, "verse_number": "१-६६-३२", "content_sanskrit": "क्रूरस्वभावं क्रूरायाः पुत्रपौत्रमनन्तकम्।\nगणः क्रोधवशो नाम क्रूरकर्माऽरिमर्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2003172, "chapter_id": 1065, "verse_number": "१-६६-३३", "content_sanskrit": "दनायुषः पुनः पुत्राश्चत्वारोऽसुरपुंगवाः।\nविक्षरो बलवीरौ च वृत्रश्चैव महासुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2003173, "chapter_id": 1065, "verse_number": "१-६६-३४", "content_sanskrit": "कालायाः प्रथिताः पुत्राः कालकल्पाः प्रहारिणः।\nप्रविख्याता महावीर्या दानवेषु परन्तपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2003174, "chapter_id": 1065, "verse_number": "१-६६-३५", "content_sanskrit": "विनाशनश्च क्रोधश्च क्रोधहन्ता तथैव च।\nक्रोधशत्रुस्तथैवान्ये कालकेया इति श्रुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2003175, "chapter_id": 1065, "verse_number": "१-६६-३६", "content_sanskrit": "असुराणामुपाध्यायः शक्रस्त्वषिसुतोऽभवत्।\nख्याताश्चोशनसः पुत्राश्चत्वारोऽसुरयाजकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2003176, "chapter_id": 1065, "verse_number": "१-६६-३७", "content_sanskrit": "त्वष्टा धरस्तथात्रिश्च द्वावन्यौ रौद्रकर्मिणौ।\nतेजसा सूर्यसंकाशा ब्रह्मलोकपरायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2003177, "chapter_id": 1065, "verse_number": "१-६६-३८", "content_sanskrit": "इत्येष वंशप्रभवः कथितस्ते तरस्विनाम्।\nअसुराणां सुराणां च पुराणे संश्रुतो मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2003178, "chapter_id": 1065, "verse_number": "१-६६-३९", "content_sanskrit": "एतेषां यदपत्यं तु न शक्यं तदशेषतः॥\nप्रसंख्यातुं महीपाल गुणभूतमनन्तकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2003179, "chapter_id": 1065, "verse_number": "१-६६-४०", "content_sanskrit": "तार्क्ष्यश्चारिष्टनेमिश्च तथैव गरुडारुणौ।\nआरुणिर्वारुणिश्चैव वैनतेयाः प्रकीर्तिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2003180, "chapter_id": 1065, "verse_number": "१-६६-४१", "content_sanskrit": "शेषोऽनन्तो वासुकिश्च तक्षकश्च भुजङ्गमः।\nकूर्मश्च कुलिकश्चैव काद्रवेयाः प्रकीर्तिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2003181, "chapter_id": 1065, "verse_number": "१-६६-४२", "content_sanskrit": "भीमसेनोग्रसेनौ च सुपर्णो वरुणस्तथा।\nगोपतिर्धृतराष्ट्रश्च सूर्यवर्चाश्च सप्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2003182, "chapter_id": 1065, "verse_number": "१-६६-४३", "content_sanskrit": "सत्यवागर्कपर्णश्च प्रयुतश्चापि विश्रुतः।\nभीमश्चित्ररथश्चैव विख्यातः सर्वविद्वशी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2003183, "chapter_id": 1065, "verse_number": "१-६६-४४", "content_sanskrit": "तथा शालिशिरा राजन्पर्जन्यश्च चतुर्दशः।\nकलिः पञ्चदशस्तेषां नारदश्चैव षोडशः॥\nइत्येते देवगन्धर्वा मौनेयाः परिकीर्तिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2003184, "chapter_id": 1065, "verse_number": "१-६६-४५", "content_sanskrit": "अथ प्रभूतान्यन्यानि कीर्तयिष्यामि भारत।\nअनवद्यां मनुं वंशामसुरां मार्गणप्रियाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2003185, "chapter_id": 1065, "verse_number": "१-६६-४६", "content_sanskrit": "अरूपां सुभगां भासीमिति प्राधा व्यजायत।\nसिद्धः पूर्णश्च बर्हिश्च पूर्णायुश्च महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2003186, "chapter_id": 1065, "verse_number": "१-६६-४७", "content_sanskrit": "ब्रह्मचारी रतिगुणः सुपर्णश्चैव सप्तमः।\nविश्वावसुश्च भानुश्च सुचन्द्रो दशमस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2003187, "chapter_id": 1065, "verse_number": "१-६६-४८", "content_sanskrit": "इत्येते देवगन्धर्वाः प्राधेयाः परिकीर्तिताः।\nइमं त्वप्सरसां वंशं विदितं पुण्यलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2003188, "chapter_id": 1065, "verse_number": "१-६६-४९", "content_sanskrit": "अरिष्टाऽसूत सुभगा देवी देवर्षितः पुरा।\nअलम्बुषा मिश्रकेशी विद्युत्पर्णा तिलोत्तमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2003189, "chapter_id": 1065, "verse_number": "१-६६-५०", "content_sanskrit": "अरुणा रक्षिता चैव रम्बा तद्वन्मनोरमा।\nकेशिनी च सुबाहुश्च सुरता सुरजा तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2003190, "chapter_id": 1065, "verse_number": "१-६६-५१", "content_sanskrit": "सुप्रिया चातिबाहुश्च विख्यातौ च हाहा हूहूः।\nतुम्बुरुश्चेति चत्वारः स्मृता गन्धर्वसत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2003191, "chapter_id": 1065, "verse_number": "१-६६-५२", "content_sanskrit": "अमृतं ब्राह्मणा गावो गन्धर्वाप्सरसस्तथा।\nअपत्यं कपिलायास्तु पुराणे परिकीर्तितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2003192, "chapter_id": 1065, "verse_number": "१-६६-५३", "content_sanskrit": "इति ते सर्वभूतानां संभवः कथितो मया।\nयथावत्संपरिख्यातो गन्धर्वाप्सरसां तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2003193, "chapter_id": 1065, "verse_number": "१-६६-५४", "content_sanskrit": "भुजंगानां सुपर्णानां रुद्राणां मरुतां तथा।\nगवां च ब्राह्मणानां च श्रीमतां पुण्यकर्मणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2003194, "chapter_id": 1065, "verse_number": "१-६६-५५", "content_sanskrit": "आयुष्यश्चैव पुण्यश्च धन्यः श्रुतिसुखावहः।\nश्रोतव्यश्चैव सततं श्राव्यश्चैवानसूयता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2003195, "chapter_id": 1065, "verse_number": "१-६६-५६", "content_sanskrit": "इमं तु वंशं नियमेन यः पठे-\nन्महात्मनां ब्राह्मणदेवसन्निधौ।\nअपत्यलाभं लभते स पुष्कलं\nश्रियं यशः प्रेत्य च शोभनां गतिम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2003196, "chapter_id": 1065, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि षट्षष्टितमोऽध्यायः॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]