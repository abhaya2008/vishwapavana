[{"id": 7001289000, "chapter_id": 21289, "verse_number": "३-२१-१", "content_sanskrit": "॥नन्दीश्वर उवाच  ।\nअथ प्रीत्या शृणु मुनेऽवतारं परमं प्रभोः ।\nशंकरस्यात्मभूपुत्र शृण्वतां सर्वकामदम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001289001, "chapter_id": 21289, "verse_number": "३-२१-२", "content_sanskrit": "एकदा मुनिशार्दूल गिरिजाशंकरावुभौ ।\nविहर्तुकामौ संजातौ स्वेच्छया परमेश्वरौ॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001289002, "chapter_id": 21289, "verse_number": "३-२१-३", "content_sanskrit": "भैरवं द्वारपालं च कृत्वाभ्यन्तरमागतौ ।\nनानासखिगणैः प्रीत्या सेवितौ नरशीलितौ॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001289003, "chapter_id": 21289, "verse_number": "३-२१-४", "content_sanskrit": "चिरं विहृत्य तत्र द्वौ स्वतन्त्रौ परमेश्वरौ ।\nबभूवतुः प्रसन्नो तौ नानालीलाकरौ मुने॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001289004, "chapter_id": 21289, "verse_number": "३-२१-५", "content_sanskrit": "अथोन्मत्ताकृतिर्देवी स्वतन्त्रा लीलया शिवा ।\nआगता द्वारि तद्रूपा प्रभोराज्ञामवाप सा॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001289005, "chapter_id": 21289, "verse_number": "३-२१-६", "content_sanskrit": "तां देवीं भैरवस्सोथ नारीदृष्ट्या विलोक्य च ।\nनिषिषेध बहिर्गन्तुं तद्रूपेण विमोहितः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001289006, "chapter_id": 21289, "verse_number": "३-२१-७", "content_sanskrit": "नारीदृष्ट्या सुदृष्टा सा भैरवेण यदा मुने ।\nकुद्धाऽभवच्छिवा देवी तं शशाप तदांबिका॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001289007, "chapter_id": 21289, "verse_number": "३-२१-८", "content_sanskrit": "॥ शिवोवाच  ।\nनारीदृष्ट्या पश्यसि त्वं यतो मां पुरुषाधम ।\nअतो भव धरायां हि मानुषस्त्वं च भैरव॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001289008, "chapter_id": 21289, "verse_number": "३-२१-९", "content_sanskrit": "नन्दीश्वर उवाच ।\nइत्थं यदाऽभवच्छप्तो भैरवश्शिवया मुने ।\nहाहाकारो महानासीद्दुःखमाप स लीलया॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001289009, "chapter_id": 21289, "verse_number": "३-२१-१०", "content_sanskrit": "ततश्च शंकरः शीघ्रं तमागत्य मुनीश्वर ।\nअश्वासयद्भैरवं हि नानाऽनुनयकोविदः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001289010, "chapter_id": 21289, "verse_number": "३-२१-११", "content_sanskrit": "तच्छापाद्भैरवस्सोथ क्षिताववतरन्मुने ।\nमनुष्ययोन्यां वैतालसंज्ञकश्शंकरेच्छया॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001289011, "chapter_id": 21289, "verse_number": "३-२१-१२", "content_sanskrit": "तत्स्नेहतः शिवः सोपि क्षिताववतरद्विभुः ।\nशिवया सह सल्लीलो लौकिकीङ्गतिमाश्रितः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001289012, "chapter_id": 21289, "verse_number": "३-२१-१३", "content_sanskrit": "महेशाह्वः शिवश्चासीच्छारदा गिरिजा मुने ।\nसुलीलां चक्रतुः प्रीत्या नाना लीला विशारदौ॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001289013, "chapter_id": 21289, "verse_number": "३-२१-१४", "content_sanskrit": "इति ते कथितं तात महेशचरितं वरम् ।\nधन्यं यशस्यमायुष्यं सर्वकामफलप्रदम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001289014, "chapter_id": 21289, "verse_number": "३-२१-१५", "content_sanskrit": "य इदं शृणुयाद्भक्त्या श्रावयेद्वा समाहितः ।\nस भुक्त्वेहाखिलान्भोगानन्ते मोक्षमवाप्नुयात्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]