[{"id": 5000438000, "chapter_id": 9438, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे एकत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000438001, "chapter_id": 9438, "verse_number": "६-३१-१", "content_sanskrit": "ततस्तमक्षोभ्यबलं लङ्कायां नृपतेश्चराः।\nसुवेले राघवं शैले निविष्टं प्रत्यवेदयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000438002, "chapter_id": 9438, "verse_number": "६-३१-२", "content_sanskrit": "चाराणां रावणः श्रुत्वा प्राप्तं रामं महाबलम्।\nजातोद्वेगोऽभवत् किंचित् सचिवानिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000438003, "chapter_id": 9438, "verse_number": "६-३१-३", "content_sanskrit": "मन्त्रिणः शीघ्रमायान्तु सर्वे वै सुसमाहिताः।\nअयं नो मन्त्रकालो हि सम्प्राप्त इति राक्षसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000438004, "chapter_id": 9438, "verse_number": "६-३१-४", "content_sanskrit": "तस्य तच्छासनं श्रुत्वा मन्त्रिणोऽभ्यागमन् द्रुतम्।\nततः स मन्त्रयामास राक्षसैः सचिवैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000438005, "chapter_id": 9438, "verse_number": "६-३१-५", "content_sanskrit": "मन्त्रयित्वा तु दुर्धर्षः क्षमं यत् तदनन्तरम्।\nविसर्जयित्वा सचिवान् प्रविवेश स्वमालयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000438006, "chapter_id": 9438, "verse_number": "६-३१-६", "content_sanskrit": "ततो राक्षसमादाय विद्युज्जिह्वं महाबलम्।\nमायाविनं महामायं प्राविशद् यत्र मैथिली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000438007, "chapter_id": 9438, "verse_number": "६-३१-७", "content_sanskrit": "विद्युज्जिह्वं च मायाज्ञमब्रवीद् राक्षसाधिपः।\nमोहयिष्यावहे सीतां मायया जनकात्मजाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000438008, "chapter_id": 9438, "verse_number": "६-३१-८", "content_sanskrit": "शिरो मायामयं गृह्य राघवस्य निशाचर।\nमां त्वं समुपतिष्ठस्व महच्च सशरं धनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000438009, "chapter_id": 9438, "verse_number": "६-३१-९", "content_sanskrit": "एवमुक्तस्तथेत्याह विद्युज्जिह्वो निशाचरः।\nदर्शयामास तां मायां सुप्रयुक्तां स रावणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000438010, "chapter_id": 9438, "verse_number": "६-३१-१०", "content_sanskrit": "तस्य तुष्टोऽभवद् राजा प्रददौ च विभूषणम्।\nअशोकवनिकायां च सीतादर्शनलालसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000438011, "chapter_id": 9438, "verse_number": "६-३१-११", "content_sanskrit": "नैर्ऋतानामधिपतिः संविवेश महाबलः।\nततो दीनामदैन्यार्हां ददर्श धनदानुजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000438012, "chapter_id": 9438, "verse_number": "६-३१-१२", "content_sanskrit": "अधोमुखीं शोकपरामुपविष्टां महीतले।\nभर्तारं समनुध्यान्तीमशोकवनिकां गताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000438013, "chapter_id": 9438, "verse_number": "६-३१-१३", "content_sanskrit": "उपास्यमानां घोराभी राक्षसीभिरदूरतः।\nउपसृत्य ततः सीतां प्रहर्षं नाम कीर्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000438014, "chapter_id": 9438, "verse_number": "६-३१-१४", "content_sanskrit": "इदं च वचनं धृष्टमुवाच जनकात्मजाम्।\nसान्त्व्यमाना मया भद्रे यमाश्रित्य विमन्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000438015, "chapter_id": 9438, "verse_number": "६-३१-१५", "content_sanskrit": "खरहन्ता स ते भर्ता राघवः समरे हतः।\nछिन्नं ते सर्वथा मूलं दर्पश्च निहतो मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000438016, "chapter_id": 9438, "verse_number": "६-३१-१६", "content_sanskrit": "व्यसनेनात्मनः सीते मम भार्या भविष्यसि।\nविसृजैतां मतिं मूढे किं मृतेन करिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000438017, "chapter_id": 9438, "verse_number": "६-३१-१७", "content_sanskrit": "भवस्व भद्रे भार्याणां सर्वासामीश्वरी मम।\nअल्पपुण्ये निवृत्तार्थे मूढे पण्डितमानिनि।\nशृणु भर्तृवधं सीते घोरं वृत्रवधं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000438018, "chapter_id": 9438, "verse_number": "६-३१-१८", "content_sanskrit": "समायातः समुद्रान्तं हन्तुं मां किल राघवः।\nवानरेन्द्रप्रणीतेन बलेन महता वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000438019, "chapter_id": 9438, "verse_number": "६-३१-१९", "content_sanskrit": "संनिविष्टः समुद्रस्य पीड्य तीरमथोत्तरम्।\nबलेन महता रामो व्रजत्यस्तं दिवाकरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000438020, "chapter_id": 9438, "verse_number": "६-३१-२०", "content_sanskrit": "अथाध्वनि परिश्रान्तमर्धरात्रे स्थितं बलम्।\nसुखसुप्तं समासाद्य चरितं प्रथमं चरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000438021, "chapter_id": 9438, "verse_number": "६-३१-२१", "content_sanskrit": "तत्प्रहस्तप्रणीतेन बलेन महता मम।\nबलमस्य हतं रात्रौ यत्र रामः सलक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000438022, "chapter_id": 9438, "verse_number": "६-३१-२२", "content_sanskrit": "पट्टिशान् परिघांश्चक्रानृष्टीन् दण्डान् महायुधान्।\nबाणजालानि शूलानि भास्वरान् कूटमुद‍्गरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000438023, "chapter_id": 9438, "verse_number": "६-३१-२३", "content_sanskrit": "यष्टीश्च तोमरान् प्रासांश्चक्राणि मुसलानि च।\nउद्यम्योद्यम्य रक्षोभिर्वानरेषु निपातिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000438024, "chapter_id": 9438, "verse_number": "६-३१-२४", "content_sanskrit": "अथ सुप्तस्य रामस्य प्रहस्तेन प्रमाथिना।\nअसक्तं कृतहस्तेन शिरश्छिन्नं महासिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000438025, "chapter_id": 9438, "verse_number": "६-३१-२५", "content_sanskrit": "विभीषणः समुत्पत्य निगृहीतो यदृच्छया।\nदिशः प्रव्राजितः सैन्यैर्लक्ष्मणः प्लवगैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000438026, "chapter_id": 9438, "verse_number": "६-३१-२६", "content_sanskrit": "सुग्रीवो ग्रीवया सीते भग्नया प्लवगाधिपः।\nनिरस्तहनुकः सीते हनूमान् राक्षसैर्हतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000438027, "chapter_id": 9438, "verse_number": "६-३१-२७", "content_sanskrit": "जाम्बवानथ जानुभ्यामुत्पतन् निहतो युधि।\nपट्टिशैर्बहुभिश्छिन्नो निकृत्तः पादपो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000438028, "chapter_id": 9438, "verse_number": "६-३१-२८", "content_sanskrit": "मैन्दश्च द्विविदश्चोभौ तौ वानरवरर्षभौ।\nनिःश्वसन्तौ रुदन्तौ च रुधिरेण परिप्लुतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000438029, "chapter_id": 9438, "verse_number": "६-३१-२९", "content_sanskrit": "असिना व्यायतौ छिन्नौ मध्ये ह्यरिनिषूदनौ।\nअनुश्वसिति मेदिन्यां पनसः पनसो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000438030, "chapter_id": 9438, "verse_number": "६-३१-३०", "content_sanskrit": "नाराचैर्बहुभिश्छिन्नः शेते दर्यां दरीमुखः।\nकुमुदस्तु महातेजा निष्कूजन् सायकैर्हतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000438031, "chapter_id": 9438, "verse_number": "६-३१-३१", "content_sanskrit": "अङ्गदो बहुभिश्छिन्नः शरैरासाद्य राक्षसैः।\nपरितो रुधिरोद‍्गारी क्षितौ निपतितोऽङ्गदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000438032, "chapter_id": 9438, "verse_number": "६-३१-३२", "content_sanskrit": "हरयो मथिता नागै रथजालैस्तथापरे।\nशयाना मृदितास्तत्र वायुवेगैरिवाम्बुदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000438033, "chapter_id": 9438, "verse_number": "६-३१-३३", "content_sanskrit": "प्रसृताश्च परे त्रस्ता हन्यमाना जघन्यतः।\nअनुद्रुतास्तु रक्षोभिः सिंहैरिव महाद्विपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000438034, "chapter_id": 9438, "verse_number": "६-३१-३४", "content_sanskrit": "सागरे पतिताः केचित् केचिद् गगनमाश्रिताः।\nऋक्षा वृक्षानुपारूढा वानरीं वृत्तिमाश्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000438035, "chapter_id": 9438, "verse_number": "६-३१-३५", "content_sanskrit": "सागरस्य च तीरेषु शैलेषु च वनेषु च।\nपिङ्गलास्ते विरूपाक्षै राक्षसैर्बहवो हताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000438036, "chapter_id": 9438, "verse_number": "६-३१-३६", "content_sanskrit": "एवं तव हतो भर्ता ससैन्यो मम सेनया।\nक्षतजार्द्रं रजोध्वस्तमिदं चास्याहृतं शिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000438037, "chapter_id": 9438, "verse_number": "६-३१-३७", "content_sanskrit": "ततः परमदुर्धर्षो रावणो राक्षसेश्वरः।\nसीतायामुपशृण्वन्त्यां राक्षसीमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000438038, "chapter_id": 9438, "verse_number": "६-३१-३८", "content_sanskrit": "राक्षसं क्रूरकर्माणं विद्युज्जिह्वं समानय।\nयेन तद्राघवशिरः संग्रामात् स्वयमाहृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000438039, "chapter_id": 9438, "verse_number": "६-३१-३९", "content_sanskrit": "विद्युज्जिह्वस्तदा गृह्य शिरस्तत्सशरासनम्।\nप्रणामं शिरसा कृत्वा रावणस्याग्रतः स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000438040, "chapter_id": 9438, "verse_number": "६-३१-४०", "content_sanskrit": "तमब्रवीत् ततो राजा रावणो राक्षसं स्थितम्।\nविद्युज्जिह्वं महाजिह्वं समीपपरिवर्तिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000438041, "chapter_id": 9438, "verse_number": "६-३१-४१", "content_sanskrit": "अग्रतः कुरु सीतायाः शीघ्रं दाशरथेः शिरः।\nअवस्थां पश्चिमां भर्तुः कृपणा साधु पश्यतु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000438042, "chapter_id": 9438, "verse_number": "६-३१-४२", "content_sanskrit": "एवमुक्तं तु तद् रक्षः शिरस्तत् प्रियदर्शनम्।\nउपनिक्षिप्य सीतायाः क्षिप्रमन्तरधीयत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000438043, "chapter_id": 9438, "verse_number": "६-३१-४३", "content_sanskrit": "रावणश्चापि चिक्षेप भास्वरं कार्मुकं महत्।\nत्रिषु लोकेषु विख्यातं रामस्यैतदिति ब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000438044, "chapter_id": 9438, "verse_number": "६-३१-४४", "content_sanskrit": "इदं तत् तव रामस्य कार्मुकं ज्यासमावृतम्।\nइह प्रहस्तेनानीतं तं हत्वा निशि मानुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000438045, "chapter_id": 9438, "verse_number": "६-३१-४५", "content_sanskrit": "स विद्युज्जिह्वेन सहैव तच्छिरो\nधनुश्च भूमौ विनिकीर्यमाणः।\nविदेहराजस्य सुतां यशस्विनीं\nततोऽब्रवीत् तां भव मे वशानुगा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000438046, "chapter_id": 9438, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे एकत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]