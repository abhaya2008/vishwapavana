[{"id": 2135224, "chapter_id": 3928, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2135225, "chapter_id": 3928, "verse_number": "१", "content_sanskrit": "ततस्तु शिल्पिनः सर्वे तेऽमात्यप्रवराश्च ह ।\nविदुरश्च महाप्राज्ञो धार्तराष्ट्रे न्यवेदयन् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2135226, "chapter_id": 3928, "verse_number": "२", "content_sanskrit": "सज्जं क्रतुवरं राजन् प्राप्तकालं च भारत ।\nसौवर्णं च कृतं सर्वं लाङ्गलं च महाधनम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2135227, "chapter_id": 3928, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2135228, "chapter_id": 3928, "verse_number": "३", "content_sanskrit": "एतच्छ्रुत्वा नृपश्रेष्ठो धार्तराष्ट्रो विशाम्पते ।\nभीष्मो द्रोणः कृपः कर्णो गान्धारी च यशस्विनी ।\nआज्ञापयामास नृपं क्रतुराजप्रवर्तने \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2135229, "chapter_id": 3928, "verse_number": "४", "content_sanskrit": "ततः प्रववृते यज्ञः प्रभूतान्नः सुसंस्कृतः ।\nदीक्षितश्चापि गान्धारिर्यथाशास्त्रं यथाक्रमम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2135230, "chapter_id": 3928, "verse_number": "५", "content_sanskrit": "प्रहृष्टो धृतराष्ट्रोऽभूत् विदुरश्च महामनाः ।\nभीष्मो द्रोणः कृपः कर्णो गान्धारी च यशस्विनी \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2135231, "chapter_id": 3928, "verse_number": "६", "content_sanskrit": "निमन्त्रणार्थं दूतांश्च प्रेषयामास शीघ्रगान् ।\nपार्थिवानां च राजेन्द्र ब्राह्मणानां तथैव च \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2135232, "chapter_id": 3928, "verse_number": "७", "content_sanskrit": "ते प्रयाता यथोद्दिष्टा दूतास्त्वरितवाहनाः ।\nतत्र कञ्चित् प्रयातं तु दूतं दुःशासनोऽब्रवीत् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2135233, "chapter_id": 3928, "verse_number": "", "content_sanskrit": "गच्छ द्वैतवनं क्षिप्रं पाण्डवान् पापपूरुषान् ।\nनिमन्त्रय यथान्यायं विप्रांस्तस्मिन् वने तदा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2135234, "chapter_id": 3928, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2135235, "chapter_id": 3928, "verse_number": "८", "content_sanskrit": "स गत्वा पाण्डवान् सर्वानुवाचाभिप्रणम्य च \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2135236, "chapter_id": 3928, "verse_number": "९", "content_sanskrit": "दुर्योधनो महाराज यजते नृपसत्तमः ।\nस्ववीर्यार्जितमर्थौघमवाप्य कुरुसत्तमः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2135237, "chapter_id": 3928, "verse_number": "१०", "content_sanskrit": "तत्र गच्छन्ति राजानो ब्राह्मणाश्च ततस्ततः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2135238, "chapter_id": 3928, "verse_number": "११", "content_sanskrit": "अहं तु प्रेषितो राजन् कौरवेण महात्मना ।\nआमन्त्रयति वो राजा धार्तराष्ट्रो जनेश्वरः ।\nमनोऽभिलषितं राज्ञस्तं क्रतुं द्रष्दुमर्हथ \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2135239, "chapter_id": 3928, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2135240, "chapter_id": 3928, "verse_number": "१२", "content_sanskrit": "ततो युधिष्ठिरो राजा तच्छ्रुत्वा दूतभाषितम् ।\nअब्रवीन्नृपशार्दूलो दिष्ट्या राजा सुयोधनः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2135241, "chapter_id": 3928, "verse_number": "१३", "content_sanskrit": "यजते क्रतुमुख्येन सर्वेषां प्रीतिवर्धनः ।\nवयमप्युपयास्यामो न त्विदानीं कथञ्चन ।\nसमयः परिपाल्यो नो यावद् वर्षं त्रयोदशम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2135242, "chapter_id": 3928, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2135243, "chapter_id": 3928, "verse_number": "१४", "content_sanskrit": "श्रुत्वैतद् धर्मराजस्य भीमो वचनमब्रवीत् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2135244, "chapter_id": 3928, "verse_number": "१५", "content_sanskrit": "तदा तु नृपतिर्गन्ता धर्मराजो युधिष्ठिरः ।\nअस्त्रशस्त्रप्रदीप्तेऽग्नौ यदा तं पातयिष्यति \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2135245, "chapter_id": 3928, "verse_number": "१६", "content_sanskrit": "वर्षात् त्रयोदशादूर्ध्वं रणसत्रे नराधिपम् ।\nयदा क्रोधहविर्मोक्ता धार्तराष्ट्रेषु पाण्डवः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2135246, "chapter_id": 3928, "verse_number": "१७", "content_sanskrit": "आगन्ताहं तदास्मीति वाच्य एवं सुयोधनः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2135247, "chapter_id": 3928, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2135248, "chapter_id": 3928, "verse_number": "१८", "content_sanskrit": "शेषास्तु पाण्डवा राजन् नैवोचुः किञ्चिदप्रियम् ।\nदूतश्चापि यथावृत्तं धार्तराष्ट्रे न्यवेदयत् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2135249, "chapter_id": 3928, "verse_number": "१९", "content_sanskrit": "अथ जग्मुर्नृपश्रेष्ठं नानाजनपदेश्वराः ।\nब्राह्मणाश्च महाभाग धार्तराष्ट्रपुरं प्रति \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2135250, "chapter_id": 3928, "verse_number": "२०", "content_sanskrit": "ते त्वर्चिता यथाशास्त्रं यथाविधि यथाक्रमम् ।\nमुदा परमया युक्ताः प्रीताश्चापि नरेश्वराः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2135251, "chapter_id": 3928, "verse_number": "२१", "content_sanskrit": "धृतराष्ट्रोऽपि कौरव्य संवृतः सर्वकौरवैः ।\nहर्षेण महता युक्तो विदुरं प्रत्यभाषत \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2135252, "chapter_id": 3928, "verse_number": "२२", "content_sanskrit": "यथा सुखी जनः सर्वः क्षत्तः स्यादन्नसंयुतः ।\nतुष्येत् तु यज्ञसदने तथा क्षिप्रं विधीयताम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2135253, "chapter_id": 3928, "verse_number": "२३", "content_sanskrit": "विदुरस्तु तदाज्ञाय सर्ववर्णानरिन्दम ।\nयथा प्रमाणतो विद्वान् पूजयामास धर्मवित् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2135254, "chapter_id": 3928, "verse_number": "२४", "content_sanskrit": "भक्ष्यपेयान्नपानेन माल्यैश्चापि सुगन्धिभिः ।\nवासोभिर्विविधैश्चैव योजयामास हृष्टवत् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2135255, "chapter_id": 3928, "verse_number": "२५", "content_sanskrit": "कृत्वा ह्यावसथान् वीरो यथाशास्त्रं यथाक्रमम् ।\nसान्त्वयित्वा च राजेन्द्रो दत्त्वा च विविधं वसु ।\nविसर्जयामास नृपान् ब्राह्मणांश्च सहस्रशः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2135256, "chapter_id": 3928, "verse_number": "२६", "content_sanskrit": "स्नातश्चावभृथो राजा धार्तराष्ट्रो महामनाः ।\nविसृज्य च नृपान् सर्वान् भ्रातृभिः परिवारितः ।\nविवेश हस्तिनपुरं सहितः कर्णसौबलैः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2135257, "chapter_id": 3928, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि पञ्चचत्वारिंशदधिकद्विशततमोऽध्यायः ॥२४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2135258, "chapter_id": 3928, "verse_number": "", "content_sanskrit": "प्रायोपवेशपर्वणि दुर्योधनयज्ञो नाम दशमोऽध्यायः ॥१०॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]