[{"id": 40006268, "chapter_id": 8972, "verse_number": "1", "content_sanskrit": "तत श्शिरसि कृत्वा तु पादुके भरतस्तदा। आरुरोह रथं हृष्टः शत्रुघ्नेन समन्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40006269, "chapter_id": 8972, "verse_number": "2", "content_sanskrit": "वसिष्ठो वामदेवश्च जाबालिश्च दृढव्रतः। अग्रतः प्रययु स्सर्वे मन्त्रिणो मन्त्रपूजिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40006270, "chapter_id": 8972, "verse_number": "3", "content_sanskrit": "मन्दाकिनीं नदीं रम्यां प्राङ्मुखास्ते ययुस्तदा। प्रदक्षिणं च कुर्वाणाश्चित्रकूटं महागिरिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40006271, "chapter_id": 8972, "verse_number": "4", "content_sanskrit": "पश्यन्धातुसहस्राणि रम्याणि विविधानि च। प्रययौ तस्य पार्श्वेन ससैन्यो भरतस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40006272, "chapter_id": 8972, "verse_number": "5", "content_sanskrit": "अदूराच्चित्रकूटस्य ददर्श भरतस्तदा। आश्रमं यत्र स मुनिर्भरद्वाजः कृतालयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40006273, "chapter_id": 8972, "verse_number": "6", "content_sanskrit": "स तमाश्रममागम्य भरद्वाजस्य बुद्धिमान्। अवतीर्य रथात्पादौ ववन्दे भरतस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40006274, "chapter_id": 8972, "verse_number": "7", "content_sanskrit": "ततो हृष्टो भरद्वाजो भरतं वाक्यमब्रवीत्। अपि कृत्यं कृतं तात रामेण च समागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40006275, "chapter_id": 8972, "verse_number": "8", "content_sanskrit": "एवमुक्त स्स तु ततो भरद्वाजेन धीमता। प्रत्युवाच भरद्वाजं भरतो धर्मवत्सलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40006276, "chapter_id": 8972, "verse_number": "9", "content_sanskrit": "स याच्यमानो गुरुणा मया च दृढविक्रमः। राघवः परमप्रीतो वसिष्ठं वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40006277, "chapter_id": 8972, "verse_number": "10", "content_sanskrit": "पितुः प्रतिज्ञां तामेव पालयिष्यामि तत्त्वतः। चतुर्दश हि वर्षाणि या प्रतिज्ञा पितुर्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40006278, "chapter_id": 8972, "verse_number": "11", "content_sanskrit": "एवमुक्तो महाप्राज्ञो वसिष्ठः प्रत्युवाच ह। वाक्यज्ञो वाक्यकुशलं राघवं वचनं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40006279, "chapter_id": 8972, "verse_number": "12", "content_sanskrit": "एते प्रयच्छ संहृष्टः पादुके हेमभूषिते। अयोध्यायां महाप्राज्ञ योगक्षेमकरे तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40006280, "chapter_id": 8972, "verse_number": "13", "content_sanskrit": "एवमुक्तो वसिष्ठेन राघवः प्राङ्मुखः स्थितः। पादुके ह्यधिरुह्यैते मम राज्याय वै ददौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40006281, "chapter_id": 8972, "verse_number": "14", "content_sanskrit": "निवृत्तोऽहमनुज्ञातो रामेण सुमहात्मना। अयोध्यामेव गच्छामि गृहीत्वा पादुके शुभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40006282, "chapter_id": 8972, "verse_number": "15", "content_sanskrit": "एतच्छ्रुत्वा शुभं वाक्यं भरतस्य महात्मनः। भरद्वाजश्शुभतरं मुनिर्वाक्यमुवाच तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40006283, "chapter_id": 8972, "verse_number": "16", "content_sanskrit": "नैतच्चित्रं नरव्याघ्र शीलवृत्तवतां वर। यदार्यं त्वयि तिष्ठेत्तु निम्ने सृष्टमिवोदकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40006284, "chapter_id": 8972, "verse_number": "17", "content_sanskrit": "अमृत स्समहाबाहुः पिता दशरथस्तव। यस्य त्वमीदृश: पुत्रो धर्मज्ञो धर्मवत्सलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40006285, "chapter_id": 8972, "verse_number": "18", "content_sanskrit": "तमृषिं तु महात्मानमुक्तवाक्यं कृताञ्जलिः। आमन्त्रयितुमारेभे चरणावुपगृह्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40006286, "chapter_id": 8972, "verse_number": "19", "content_sanskrit": "ततः प्रदक्षिणं कृत्वा भरद्वाजं पुनः पुनः। भरतस्तु ययौ श्रीमानयोध्यां सह मन्त्रिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40006287, "chapter_id": 8972, "verse_number": "20", "content_sanskrit": "यानैश्च शकटैश्चैव हयैर्नागैश्च सा चमूः। पुनर्निवृत्ता विस्तीर्णा भरतस्यानुयायिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40006288, "chapter_id": 8972, "verse_number": "21", "content_sanskrit": "ततस्ते यमुनां दिव्यां नदीं तीर्त्वोर्मिमालिनीम्। ददृशुस्तां पुन स्सर्वे गङ्गां शुभजलां नदीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40006289, "chapter_id": 8972, "verse_number": "22", "content_sanskrit": "तां रम्यजलसंपूर्णां सन्तीर्य सहबान्धवः शृङ्गिबेरपुरं रम्यं प्रविवेश ससैनिकः। शृङ्गिबेरपुराद्भूय स्त्वयोध्यां सन्ददर्श ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40006290, "chapter_id": 8972, "verse_number": "23", "content_sanskrit": "अयोध्यां च ततो दृष्ट्वा पित्रा भ्रात्रा विवर्जिताम्। भरतो दुःख सन्तप्त स्सारथिं चेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40006291, "chapter_id": 8972, "verse_number": "24", "content_sanskrit": "सारथे पश्य विध्वस्ता साऽयोध्या न प्रकाशते। निराकारा निरानन्दा दीना प्रतिहतस्वरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]