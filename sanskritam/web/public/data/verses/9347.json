[{"id": 40021022, "chapter_id": 9347, "verse_number": "1", "content_sanskrit": "सुमालिनं हतं दृष्ट्वा वसुना भस्मसात्कृतम् । स्वसैन्यं विद्रुतं चापि लक्षयित्वा ऽर्दितं सुरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40021023, "chapter_id": 9347, "verse_number": "2", "content_sanskrit": "ततः स बलवान्क्रुद्धो रावणस्य सुतस्तदा । निवर्त्य राक्षसान्सर्वान्मेघनादो व्यवस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40021024, "chapter_id": 9347, "verse_number": "3", "content_sanskrit": "सुरथेनाग्निवर्णेन कामगेन महारथः । अभिदुद्राव सेनां तां वनान्यग्निरिव ज्वलन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40021025, "chapter_id": 9347, "verse_number": "4", "content_sanskrit": "ततः प्रविशतस्तस्य विविधायुधधारिणः । विदुद्रुवुर्दिशः सर्वा दर्शनादेव देवताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40021026, "chapter_id": 9347, "verse_number": "5", "content_sanskrit": "न बभूव तदा कश्चिद्युयुत्सोरस्य सम्मुखे । सर्वानाविद्ध्य वित्रस्तांस्ततः शक्रो ऽब्रवीत्सुरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40021027, "chapter_id": 9347, "verse_number": "6", "content_sanskrit": "न भेतव्यं न गन्तव्यं निवर्तध्वं रणे सुराः । एष गच्छति पुत्रो मे युद्धार्थमपराजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40021028, "chapter_id": 9347, "verse_number": "7", "content_sanskrit": "ततः शक्रसुतो देवो जयन्त इति विश्रुतः । रथेनाद्भुतकल्पेन सङ्ग्रामे सो ऽभ्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40021029, "chapter_id": 9347, "verse_number": "8", "content_sanskrit": "ततस्ते त्रिदशाः सर्वे परिवार्य शचीसुतम् । रावणस्य सुतं युद्धे समासाद्य प्रजघ्निरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40021030, "chapter_id": 9347, "verse_number": "9", "content_sanskrit": "तेषां युद्धं समभवत्सदृशं देवरक्षसाम् । महेन्द्रस्य च पुत्रस्य राक्षसेन्द्रसुतस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40021031, "chapter_id": 9347, "verse_number": "10", "content_sanskrit": "ततो मातलिपुत्रे तु गोमुखे राक्षसात्मजः । सारथौ पातयामास शरान्कनकभूषणान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40021032, "chapter_id": 9347, "verse_number": "11", "content_sanskrit": "शचीसुतश्चापि तथा जयन्तस्तस्य सारथिम् । तं चापि रावणिः क्रुद्धः समन्तात्प्रत्यविध्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40021033, "chapter_id": 9347, "verse_number": "12", "content_sanskrit": "स हि क्रोधसमाविष्टो बली विस्फारितेक्षणः । रावणिः शक्रतनयं शरवर्षैरवाकिरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40021034, "chapter_id": 9347, "verse_number": "13", "content_sanskrit": "ततो नानाप्रहरणाञ्छितधारान्सहस्रशः । पातयामास सङ्क्रुद्धः सुरसैन्येषु रावणिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40021035, "chapter_id": 9347, "verse_number": "14", "content_sanskrit": "शतघ्नीमुसलप्रासगदाखड्गपरश्वधान् । महान्ति गिरिशृङ्गाणि पातयामास रावणिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40021036, "chapter_id": 9347, "verse_number": "15", "content_sanskrit": "ततः प्रव्यथिता लोकाः सञ्जज्ञे च तमो ऽभवत् । तस्य रावणपुत्रस्य शत्रुसैन्यानि निघ्नतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40021037, "chapter_id": 9347, "verse_number": "16", "content_sanskrit": "ततस्तद्दैवतबलं समन्तात्तं शचीसुतम् । बहुप्रकारमस्वस्थमभवच्छरपीडितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40021038, "chapter_id": 9347, "verse_number": "17", "content_sanskrit": "नाभ्यजानन्त चान्योन्यं रक्षो वा देवता ऽथवा । तत्र तत्र विपर्यस्तं समन्तात्परिधावति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40021039, "chapter_id": 9347, "verse_number": "18", "content_sanskrit": "देवा देवान्निजघ्नुस्ते राक्षसान्राक्षसास्तथा । सम्मूढास्तमसाच्छन्ना व्यद्रवन्नपरे तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40021040, "chapter_id": 9347, "verse_number": "19", "content_sanskrit": "एतस्मिन्नन्तरे वीरः पुलोमा नाम वीर्यवान् । दैत्येन्द्रस्तेन सङ्गृह्य शचीपुत्रो ऽपवाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40021041, "chapter_id": 9347, "verse_number": "20", "content_sanskrit": "सङ्गृह्य तं तु दौहित्रं प्रविष्टः सागरं तदा । आर्यकः स हि तस्यासीत्पुलोमा येन सा शची ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40021042, "chapter_id": 9347, "verse_number": "21", "content_sanskrit": "ज्ञात्वा प्रणाशं तु तदा जयन्तस्याथ देवताः । अप्रहृष्टास्ततः सर्वा व्यथिताः सम्प्रदुद्रुवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40021043, "chapter_id": 9347, "verse_number": "22", "content_sanskrit": "रावणिस्त्वथ सङ्क्रुद्धो बलैः परिवृतः स्वकैः । अभ्यधावत देवांस्तान्मुमोच च महास्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40021044, "chapter_id": 9347, "verse_number": "23", "content_sanskrit": "दृष्ट्वा प्रणाशं पुत्रस्य दैवतेषु च विद्रुतम् । मातलिं चाह देवेशो रथः समुपनीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40021045, "chapter_id": 9347, "verse_number": "24", "content_sanskrit": "स तु दिव्यो महाभीमः सज्ज एव महारथः । उपस्थितो मातलिना वाह्यमानो महाजवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40021046, "chapter_id": 9347, "verse_number": "25", "content_sanskrit": "ततो मेघा रथे तस्मिंस्तडित्त्वन्तो महाबलाः । अग्रतो वायुचपला नेदुः परमनिःस्वनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40021047, "chapter_id": 9347, "verse_number": "26", "content_sanskrit": "नानावाद्यानि वाद्यन्त गन्धर्वाश्च समाहिताः । ननृतुश्चाप्सरःसङ्घा निर्याते त्रिदशेश्वरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40021048, "chapter_id": 9347, "verse_number": "27", "content_sanskrit": "रुद्रैर्वसुभिरादित्यैस्साध्यैश्च समरुद्गणैः । वृतो नानाप्रहरणैर्निर्ययौ त्रिदशाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40021049, "chapter_id": 9347, "verse_number": "28", "content_sanskrit": "निर्गच्छतस्तु शक्रस्य परुषं पवनो ववौ । भास्करो निष्प्रभश्चासीन्महोल्काश्च प्रपेदिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40021050, "chapter_id": 9347, "verse_number": "29", "content_sanskrit": "एतस्मिन्नन्तरे शूरो दशग्रीवः प्रतापवान् । आरुरोह रथं दिव्यं निर्मितं विश्वकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40021051, "chapter_id": 9347, "verse_number": "30", "content_sanskrit": "पन्नगैः सुमहाकार्यैर्वेष्टितं रोमहर्षणैः । तेषां निःश्वासवातेन प्रदीप्तमिव संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40021052, "chapter_id": 9347, "verse_number": "31", "content_sanskrit": "दैत्यैर्निशाचरैश्चैव स रथः परिवारितः । समराभिमुखो दैत्यो महेन्द्रं सो ऽभ्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40021053, "chapter_id": 9347, "verse_number": "32", "content_sanskrit": "पुत्रं तं वारयित्वा तु स्वयमेव व्यवस्थितः । सो ऽपि युद्धाद्विनिष्क्रम्य रावणिः समुपाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40021054, "chapter_id": 9347, "verse_number": "33", "content_sanskrit": "ततो युद्धं प्रवृत्तं तु सुराणां राक्षसैः सह । शस्त्राणि वर्षतां घोरं मेघानामिव संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40021055, "chapter_id": 9347, "verse_number": "34", "content_sanskrit": "कुम्भकर्णस्तु दुष्टात्मा नानाप्रहरणोद्यतः । नाज्ञायत तदा युद्धे सह केनाप्ययुध्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40021056, "chapter_id": 9347, "verse_number": "35", "content_sanskrit": "दन्तैः भुजाभ्यां पद्मां च शक्तितोमरसायकैः । येन केनैव संरब्धस्ताडयामास वै सुरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40021057, "chapter_id": 9347, "verse_number": "36", "content_sanskrit": "ततो रुद्रैर्महाघोरैः सङ्गम्याथ निशाचरः । प्रयुद्धस्तैश्च सङ्ग्रामे क्षतः शस्त्रैर्निरन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40021058, "chapter_id": 9347, "verse_number": "37", "content_sanskrit": "बभौ शस्त्राचिततनुः कुम्भकर्णः क्षरन्नसृक् । विद्युत्स्तनितनिर्घोषो धारवानिव तोयदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40021059, "chapter_id": 9347, "verse_number": "38", "content_sanskrit": "ततस्तद्राक्षसं सैन्यं प्रयुद्धं समरुद्गणैः । रणे विद्रावितं सर्वं नानाप्रहरणैः शितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40021060, "chapter_id": 9347, "verse_number": "39", "content_sanskrit": "केचिद्विनिहताः कृत्ताश्चेष्टन्ति स्म महीतले । वाहनेष्ववसक्ताश्च स्थिता एवापरे रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40021061, "chapter_id": 9347, "verse_number": "40", "content_sanskrit": "रथान्नागान्खरानुष्ट्रान्पन्नगांस्तुरगान् रणे । शिंशुमारान्वराहांश्च पिशाचवदनान्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40021062, "chapter_id": 9347, "verse_number": "41", "content_sanskrit": "तान्समालिङ्ग्य बाहुभ्यां विष्टब्धाः केचिदुच्छ्रुताः । देवैस्तु शस्त्रसम्भिन्ना मम्रिरे च निशाचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40021063, "chapter_id": 9347, "verse_number": "42", "content_sanskrit": "चित्रकर्म इवाभाति स तेषां रणसम्प्लवः । निहतानां प्रमत्तानां राक्षसानां महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40021064, "chapter_id": 9347, "verse_number": "43", "content_sanskrit": "शोणितोदकनिष्पन्दकङ्कगृध्रसमाकुला । प्रवृत्ता संयुगमुखे शस्त्रग्राहवती नदी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40021065, "chapter_id": 9347, "verse_number": "44", "content_sanskrit": "एतस्मिन्नन्तरे क्रुद्धो दशग्रीवः प्रतापवान् । निरीक्ष्य तद्बलं कृत्स्नं दैवतैर्विनिपातितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40021066, "chapter_id": 9347, "verse_number": "45", "content_sanskrit": "स तं प्रति विगाह्याशु प्रवृद्धं सैन्यसागरम् । त्रिदशान्समरे निघ्नञ्छक्रमेवाभ्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 40021067, "chapter_id": 9347, "verse_number": "46", "content_sanskrit": "आगाच्छक्रो महच्चापं विस्फार्य सुमहास्वनम् । यस्य विस्फारघोषेण स्तनन्ति स्म दिशो दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 40021068, "chapter_id": 9347, "verse_number": "47", "content_sanskrit": "तद्विकृष्य महच्चापमिन्द्रो रावणमूर्धनि । निपातयामास शरान्पावकादित्यवर्चसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 40021069, "chapter_id": 9347, "verse_number": "48", "content_sanskrit": "तथैव च महाबाहुर्दशग्रीवो व्यवस्थितः । शक्रं कार्मुकविभ्रष्टैः शरवर्षैरवाकिरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 40021070, "chapter_id": 9347, "verse_number": "49", "content_sanskrit": "प्रयुध्यतोरथ तयोर्बाणवर्षैः समन्ततः । न ज्ञायते तदा किञ्चित्सर्वं हि तमसा वृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]