[{"id": 5000347000, "chapter_id": 9347, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे अष्टमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000347001, "chapter_id": 9347, "verse_number": "५-८-१", "content_sanskrit": "स तस्य मध्ये भवनस्य संस्थितो\nमहद्विमानं मणिरत्नचित्रितम्।\nप्रतप्तजाम्बूनदजालकृत्रिमं\nददर्श धीमान् पवनात्मजः कपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000347002, "chapter_id": 9347, "verse_number": "५-८-२", "content_sanskrit": "तदप्रमेयप्रतिकारकृत्रिमं\nकृतं स्वयं साध्विति विश्वकर्मणा।\nदिवं गते वायुपथे प्रतिष्ठितं\nव्यराजतादित्यपथस्य लक्ष्म तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000347003, "chapter_id": 9347, "verse_number": "५-८-३", "content_sanskrit": "न तत्र किंचिन्न कृतं प्रयत्नतो\nन तत्र किंचिन्न महार्घरत्नवत्।\nन ते विशेषा नियताः सुरेष्वपि\nन तत्र किंचिन्न महाविशेषवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000347004, "chapter_id": 9347, "verse_number": "५-८-४", "content_sanskrit": "तपः समाधानपराक्रमार्जितं\nमनःसमाधानविचारचारिणम्।\nअनेकसंस्थानविशेषनिर्मितं\nततस्ततस्तुल्यविशेषनिर्मितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000347005, "chapter_id": 9347, "verse_number": "५-८-५", "content_sanskrit": "मनः समाधाय तु शीघ्रगामिनं\nदुरासदं मारुततुल्यगामिनम्।\nमहात्मनां पुण्यकृतां महर्द्धिनां\nयशस्विनामग्ऱ्यमुदामिवालयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000347006, "chapter_id": 9347, "verse_number": "५-८-६", "content_sanskrit": "विशेषमालम्ब्य विशेषसंस्थितं\nविचित्रकूटं बहुकूटमण्डितम्।\nमनोऽभिरामं शरदिन्दुनिर्मलं\nविचित्रकूटं शिखरं गिरेर्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000347007, "chapter_id": 9347, "verse_number": "५-८-७", "content_sanskrit": "वहन्ति यत्कुण्डलशोभितानना\nमहाशना व्योमचरानिशाचराः।\nविवृत्तविध्वस्तविशाललोचना\nमहाजवा भूतगणाः सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000347008, "chapter_id": 9347, "verse_number": "५-८-८", "content_sanskrit": "वसन्तपुष्पोत्करचारुदर्शनं\nवसन्तमासादपि चारुदर्शनम्।\nस पुष्पकं तत्र विमानमुत्तमं\nददर्श तद् वानरवीरसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000347009, "chapter_id": 9347, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे अष्टमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]