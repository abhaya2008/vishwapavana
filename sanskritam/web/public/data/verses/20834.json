[{"id": 7000834000, "chapter_id": 20834, "verse_number": "६-१७७-१", "content_sanskrit": "श्रीभगवानुवाच ।\nजनस्थाने जडो नाम द्विजन्मा कौशिकान्वयी ।\nहित्वा जात्युचितं धर्मं वणिग्वृत्त्यां मनो दधे॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000834001, "chapter_id": 20834, "verse_number": "६-१७७-२", "content_sanskrit": "व्यसनी परदारेषु दीव्यन्नक्षैः पिबन्मधु ।\nमृगया निरतो नित्यं कालमेवं निनाय सः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000834002, "chapter_id": 20834, "verse_number": "६-१७७-३", "content_sanskrit": "क्षीणे वित्ते ततो रात्रौ चौर्यामारब्धवांस्ततः ।\nप्रतिपेदे धनं तेन यज्वनां यष्टुमर्थिनाम्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000834003, "chapter_id": 20834, "verse_number": "६-१७७-४", "content_sanskrit": "स दूरमगमत्तेन वाणिज्यायोत्तरां दिशम् ।\nकस्तूरिमगुरुं कृष्णं चामरांश्चंद्रिकोज्ज्वलान्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000834004, "chapter_id": 20834, "verse_number": "६-१७७-५", "content_sanskrit": "गृहीत्वा वृत्य चानिन्ये पंचषादध्वयोजनात् ।\nअथापरस्मिन्नहनि प्रियादर्शनदोहनि॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000834005, "chapter_id": 20834, "verse_number": "६-१७७-६", "content_sanskrit": "दूरमध्वानमुल्लंघ्य रवावस्तमिते सति ।\nध्वांते प्रसर्पति स्वैरं दिशो दश तरोस्तले॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000834006, "chapter_id": 20834, "verse_number": "६-१७७-७", "content_sanskrit": "गतो वशं सदस्यूनां निजघ्ने तैश्च सत्वरम् ।\nधर्मलोपादसौ जज्ञे घोरश्चोग्रतरो ग्रहः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000834007, "chapter_id": 20834, "verse_number": "६-१७७-८", "content_sanskrit": "पिपासितो बुभुक्षार्तो लेलिहानश्च सृक्किणी ।\nउर्ध्वकेशोऽतिजंघालुः पृष्टलग्नोदरो महत्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000834008, "chapter_id": 20834, "verse_number": "६-१७७-९", "content_sanskrit": "अस्थिमात्रशरीरोऽभूद्दुर्वृत्तनयनो भृशम् ।\nअत्रांतरे सुतस्तस्य धर्मात्मा वेदकोविदः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000834009, "chapter_id": 20834, "verse_number": "६-१७७-१०", "content_sanskrit": "पर्यपालयदत्यर्थं दिदृक्षुस्तं तदागमत् ।\nनित्यमन्वेषयन्वार्त्तां पांथेभ्यो नोपलब्धवान्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000834010, "chapter_id": 20834, "verse_number": "६-१७७-११", "content_sanskrit": "ततः कदाचिदायाते सहायिनि च मानवे ।\nतस्माद्विदितवृत्तांतः शुशोच पितरं बहु॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000834011, "chapter_id": 20834, "verse_number": "६-१७७-१२", "content_sanskrit": "ततो विमृश्य मेधावी चिकीर्षुः पारलौकिकम् ।\nवाराणसीं ससंभारः स गंतुमुपचक्रमे॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000834012, "chapter_id": 20834, "verse_number": "६-१७७-१३", "content_sanskrit": "मार्गे निवासान्सप्ताष्टौ नीत्वा तस्य तरोस्तले ।\nसंध्यां प्रचक्रमे कर्तुं यत्रास्य निहतः पिता॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000834013, "chapter_id": 20834, "verse_number": "६-१७७-१४", "content_sanskrit": "तत्राध्यायं स गीतानां तृतीयं संजजाप ह ।\nततो घोरस्वरस्तत्र व्योममध्ये परामृशत्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000834014, "chapter_id": 20834, "verse_number": "६-१७७-१५", "content_sanskrit": "ददर्श घोरमाकाशात्पतंतं पितरं ततः ।\nविस्मयेन भयेनापि विकलीकृतचेतनः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000834015, "chapter_id": 20834, "verse_number": "६-१७७-१६", "content_sanskrit": "तेजसा भूयसा व्याप्तमालुलोके पुरोऽम्बरे ।\nकिंकिणीकोटिसंकीर्णं तेजसा व्याप्तदिङ्मुखम्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000834016, "chapter_id": 20834, "verse_number": "६-१७७-१७", "content_sanskrit": "विमानमग्रतोऽपश्यद्दिव्यमध्यग्रचेतनः ।\nतत्रापश्यत्समारूढं दिव्याभिः स्त्रीभिरावृतम्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000834017, "chapter_id": 20834, "verse_number": "६-१७७-१८", "content_sanskrit": "संस्तूयमानं मुनिभिः पितरं पीतवाससम् ।\nप्रणतस्तं समालोक्य युयुजे तेन चाशिषा॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000834018, "chapter_id": 20834, "verse_number": "६-१७७-१९", "content_sanskrit": "ततोऽपृच्छदिदं वृत्तं स च तस्मै न्यवेदयत् ।\nदुस्त्यजात्कर्मणो वत्स वपुषो पुण्यकारणात्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000834019, "chapter_id": 20834, "verse_number": "६-१७७-२०", "content_sanskrit": "मोचितोऽस्मि त्वया दैवादध्यायं जपतांतिके ।\nतन्निवर्त्तस्व जपतः सांप्रतं त्वामुपस्थितम्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000834020, "chapter_id": 20834, "verse_number": "६-१७७-२१", "content_sanskrit": "वाराणसीं यदर्थं यत्तदनुष्ठितमात्मनः ।\nश्रीभगवानुवाच ।\nएवमुक्तः स च प्राह पितरं दीप्ततेजसम्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000834021, "chapter_id": 20834, "verse_number": "६-१७७-२२", "content_sanskrit": "सुत उवाच ।\nहितं ममानुशाधि त्वं कार्यमन्यन्मयानु किम् ।\nश्रीभगवानुवाच ।\nततः प्राह पिता पुत्रं कार्यमेतत्त्वयानघ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000834022, "chapter_id": 20834, "verse_number": "६-१७७-२३", "content_sanskrit": "यन्मयाचरितं कर्म भ्रात्रा मम तु तत्कृतम् ।\nस यातो नरकं घोरं तं मोचयितुमर्हसि॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000834023, "chapter_id": 20834, "verse_number": "६-१७७-२४", "content_sanskrit": "अन्ये मदन्वये ये वै निरयं प्रतिपेदिरे ।\nते च मोचयितव्यास्ते इति मेऽस्ति मनोरथः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000834024, "chapter_id": 20834, "verse_number": "६-१७७-२५", "content_sanskrit": "इत्येवमुक्तः पुत्रस्तं पुनः प्राह कृतांजलि ।\nकर्मणा केन तान्सर्वान्मोचयामि तदादिश॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000834025, "chapter_id": 20834, "verse_number": "६-१७७-२६", "content_sanskrit": "एवं निवेदितो वाक्यं पिता सुतमुवाच ह ।\nपितोवाच ।\nयेनाहं मोचितो वत्स तदनुष्ठातुमर्हसि॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000834026, "chapter_id": 20834, "verse_number": "६-१७७-२७", "content_sanskrit": "अनुष्ठाय तदुत्पन्नं तेभ्यः पुण्यं समुत्सृज ।\nततोऽहमिव ते सर्वे पूर्वे संत्यज्य यातनाम्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000834027, "chapter_id": 20834, "verse_number": "६-१७७-२८", "content_sanskrit": "गमिष्यंत्यचिरेणैव तद्विष्णोः परमं पदम् ।\nस संदिष्टोवदत्पुत्रो यद्येवं तात नारकान्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000834028, "chapter_id": 20834, "verse_number": "६-१७७-२९", "content_sanskrit": "सर्वानपि विमोक्ष्यामि यदि ते रोचते वचः ।\nएवमस्तु शिवं भूयादुपपन्नं महत्प्रियम्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000834029, "chapter_id": 20834, "verse_number": "६-१७७-३०", "content_sanskrit": "इत्यादिश्य पिता पुत्रं ययौ विष्णोः परं पदम् ।\nसोऽपि तस्मात्परावृत्त्य जनस्थानं प्रपद्य च॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000834030, "chapter_id": 20834, "verse_number": "६-१७७-३१", "content_sanskrit": "सुंदरस्य पुरः शौरेश्चालये कालमभ्यगात् ।\nस कुर्वाणोःसमादीनि पित्रा च यदुदीरितम्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000834031, "chapter_id": 20834, "verse_number": "६-१७७-३२", "content_sanskrit": "उत्ससर्ज कृतं पुण्यं मोचयिष्यन्स नारकान् ।\nअत्रांतरे पदे विष्णोर्यातनापदमीयुषः॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000834032, "chapter_id": 20834, "verse_number": "६-१७७-३३", "content_sanskrit": "नारकान्मोचयिष्यंतः किंकरा यममभ्ययुः ।\nतेन ते पूजिताः सर्वे सत्क्रियाभिरनेकधा॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000834033, "chapter_id": 20834, "verse_number": "६-१७७-३४", "content_sanskrit": "कुशलं परिपृष्टास्ते सर्वतः सुखमूचिरे ।\nएमं सत्कृत्य मेधावी पितृलोक महेश्वरः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000834034, "chapter_id": 20834, "verse_number": "६-१७७-३५", "content_sanskrit": "हेतुमागमने पृच्छत्ते च तस्मै न्यवेदयन् ।\nविद्धि कीनाशनाथ त्वं शेषपर्यंकशायिना॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000834035, "chapter_id": 20834, "verse_number": "६-१७७-३६", "content_sanskrit": "शौरिणा प्रहितानस्मान्समादेष्टुं त्वदंतिके ।\nअस्मन्मुखेन देवस्त्वां कुशलं परिपृच्छति॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000834036, "chapter_id": 20834, "verse_number": "६-१७७-३७", "content_sanskrit": "नारकान्प्राणिनः सर्वान्विमोक्तुं च नियच्छति ।\nइत्याकर्ण्य समादिष्टं विष्णोरमिततेजसः॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000834037, "chapter_id": 20834, "verse_number": "६-१७७-३८", "content_sanskrit": "न तेन मूर्ध्ना संभाव्य दध्यौ किंचन चेतसा ।\nविमुक्तान्निरयात्सर्वांस्तान्विलोक्य मदोत्कटान्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000834038, "chapter_id": 20834, "verse_number": "६-१७७-३९", "content_sanskrit": "स तैरनुगतः सर्वैर्विष्णोरायतनं ततः ।\nययौ स वरयानेन यत्रास्ते दुग्धवारिधिः॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000834039, "chapter_id": 20834, "verse_number": "६-१७७-४०", "content_sanskrit": "तदंत उदितानेकसूर्यकोटिसमप्रभम् ।\nइंदीवरदलश्याममालुलोक जगद्गुरुम्॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000834040, "chapter_id": 20834, "verse_number": "६-१७७-४१", "content_sanskrit": "शय्याफणिफणारत्नमरीच्यामिश्रतेजसम् ।\nविलोक्यमानमानंदनिर्भरं प्रीतमानसम्॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000834041, "chapter_id": 20834, "verse_number": "६-१७७-४२", "content_sanskrit": "भावानुगैर्दृगालीकैः श्रिया प्रेम्णेक्षितं मुहुः ।\nयोगिभिः परितो जुष्टं ध्याननिष्पंदतारकैः॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000834042, "chapter_id": 20834, "verse_number": "६-१७७-४३", "content_sanskrit": "स्तूयमानं महेंद्रेण पराजेतुं विरोधिनः ।\nआम्नायवचसामंते ब्रह्मणो निःसृतैर्मुखात्॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000834043, "chapter_id": 20834, "verse_number": "६-१७७-४४", "content_sanskrit": "मूर्तिमद्भिर्वचोभिश्च गीयमानं गुणोत्करम् ।\nसंप्रीतं चाप्युदासीनमपि सर्वासु योनिषु॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000834044, "chapter_id": 20834, "verse_number": "६-१७७-४५", "content_sanskrit": "योगसंचितपुण्यानां यौगपद्येन जंतुषु ।\nविलोकमानमात्मानमखिलं सचराचरम्॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000834045, "chapter_id": 20834, "verse_number": "६-१७७-४६", "content_sanskrit": "आमोद्यन्नमालोकैरात्मानं दीप्तिपूरितैः ।\nआबिभ्राणं वपुर्व्यापि द्योतितं भोगिनस्विषा॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000834046, "chapter_id": 20834, "verse_number": "६-१७७-४७", "content_sanskrit": "इंदीवरदलश्यामं ज्योत्स्नयेव नभस्तलम् ।\nविलोक्य तं स तुष्टाव धिया बहुलयानतः॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000834047, "chapter_id": 20834, "verse_number": "६-१७७-४८", "content_sanskrit": "यम उवाच ।\nनमः समस्तनिर्माणनिर्मलीभूतचेतसे ।\nवद नोद्गीर्णवेदाय विश्वरूपाय वेधसे॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000834048, "chapter_id": 20834, "verse_number": "६-१७७-४९", "content_sanskrit": "बलवेगसुदुर्द्धर्ष दानवेंद्र मदद्रुहे ।\nनमः स्थितौ च सत्वाय विश्वाधाराय विष्णवे॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000834049, "chapter_id": 20834, "verse_number": "६-१७७-५०", "content_sanskrit": "नमः पातकसंघात जिष्णवेऽखिलदेहिनाम् ।\nईषदुन्मीलल्लालाटनेत्राग्निप्रभवार्चिषे॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000834050, "chapter_id": 20834, "verse_number": "६-१७७-५१", "content_sanskrit": "त्वं हि सर्वस्य लोकस्य गुरुरात्मा महेश्वरः ।\nविसृज्य वैष्णवान्सर्वानतस्त्वमनुकंपसे॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000834051, "chapter_id": 20834, "verse_number": "६-१७७-५२", "content_sanskrit": "व्यापयन्नखिलं लोकं मायया परिबृंहितम् ।\nन तया परिभूतोऽसि न च तत्प्रभवैर्गुणैः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000834052, "chapter_id": 20834, "verse_number": "६-१७७-५३", "content_sanskrit": "अंतरावर्तमानोऽपि न ताभ्यामभिभूयसे ।\nदृशा विषयवर्तिन्या निग्रहीतमना अपि॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000834053, "chapter_id": 20834, "verse_number": "६-१७७-५४", "content_sanskrit": "तया फलाभिगामिन्या आत्मन्येवाभिलीयसे ।\nन तवास्ति महिम्नोंतो यथा निरवधिः स्वयम्॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000834054, "chapter_id": 20834, "verse_number": "६-१७७-५५", "content_sanskrit": "मौनमेवात्रयुक्तं मे विषयोऽसि कथं गिराम् ।\nइति स्तुत्वा ततो वाक्यमिदमाह कृतांजलि॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000834055, "chapter_id": 20834, "verse_number": "६-१७७-५६", "content_sanskrit": "विनियोगादमी युक्ता देहिनो निर्गुणा मया ।\nसमादिश यदन्यन्मे कार्यमस्ति जगद्गुरो॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000834056, "chapter_id": 20834, "verse_number": "६-१७७-५७", "content_sanskrit": "इति विज्ञापितस्तेन तमाह मधुसूदनः ।\nमेघगंभीरया वाचा सिंचन्निव सुधारसैः॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000834057, "chapter_id": 20834, "verse_number": "६-१७७-५८", "content_sanskrit": "पापादुद्धार्य ते लोको मया समयवर्तिना ।\nत्वयि विन्यस्तभारोऽहं नानुशोचामि देहिनः॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000834058, "chapter_id": 20834, "verse_number": "६-१७७-५९", "content_sanskrit": "तदाचर निजं कर्म प्रयाहि स्वं निकेतनम् ।\nश्रीभगवानुवाच ।\nइत्युक्त्वांतर्दधे देवः सोऽपि स्वपुरमाययौ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000834059, "chapter_id": 20834, "verse_number": "६-१७७-६०", "content_sanskrit": "सोऽपि स्वजातिजान्सर्वान्निरयस्थाननेकशः ।\nउद्धृत्य वरयानेन विष्णुलोकं ययौ स्वयम्॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]