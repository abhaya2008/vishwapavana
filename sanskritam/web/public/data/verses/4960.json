[{"id": 2186489, "chapter_id": 4960, "verse_number": "", "content_sanskrit": "भरद्वाजः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2186490, "chapter_id": 4960, "verse_number": "१", "content_sanskrit": "प्रजाविसर्गं विविधं कथं स सृजते प्रभुः ।\nमेरुमध्ये स्थितो ब्रह्मा तद्ब्रूहि द्विजसत्तम\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2186491, "chapter_id": 4960, "verse_number": "", "content_sanskrit": "भृगुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2186492, "chapter_id": 4960, "verse_number": "२", "content_sanskrit": "प्रजाविसर्गं विविधं मानसो मनसासृजत् ।\nसन्धुक्षणार्थं भूतानां सृष्टं प्रथमतो जलम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2186493, "chapter_id": 4960, "verse_number": "३", "content_sanskrit": "यत्प्राणाः सर्वभूतानां वर्धन्ते येन च प्रजाः ।\nपरित्यक्ताश्च नश्यन्ति तेनेदं सर्वमावृतम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2186494, "chapter_id": 4960, "verse_number": "४", "content_sanskrit": "पृथिवी पर्वता मेघा मूर्तिमन्तश्च ये परे ।\nसर्वं तद्वारुणं ज्ञेयमापस्तस्तम्भिरे पुनः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2186495, "chapter_id": 4960, "verse_number": "", "content_sanskrit": "भरद्वाजः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2186496, "chapter_id": 4960, "verse_number": "५", "content_sanskrit": "कथं सलिलमुत्पन्नं कथं चैवाग्निमारुतौ ।\nकथं च मेदिनी सृष्टेत्यत्र मे संशयो महान्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2186497, "chapter_id": 4960, "verse_number": "", "content_sanskrit": "भृगुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2186498, "chapter_id": 4960, "verse_number": "६", "content_sanskrit": "ब्रह्मकल्पे पुरा ब्रह्मन् ब्रह्मर्षीणां समागमे ।\nलोकसम्भवसंदेहः समुत्पन्नो महात्मनाम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2186499, "chapter_id": 4960, "verse_number": "७", "content_sanskrit": "तेऽतिष्ठन्ध्यानमालम्ब्य मौनमास्थाय निश्चलाः ।\nत्यक्ताहाराः पवनपा दिव्यं वर्षशतं द्विजाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2186500, "chapter_id": 4960, "verse_number": "८", "content_sanskrit": "तेषां धर्ममयी वाणी सर्वेषां श्रोत्रमागमत् ।\nदिव्या सरस्वती तत्र सम्बभूव नभस्तलात्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2186501, "chapter_id": 4960, "verse_number": "९", "content_sanskrit": "पुरा स्तिमितनिःशब्दमाकाशमचलोपमम् ।\nनष्टचन्द्रार्कपवनं प्रसुप्तमिव सम्बभौ\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2186502, "chapter_id": 4960, "verse_number": "१०", "content_sanskrit": "ततः सलिलमुत्पन्नं तमसीवापरं तमः ।\nतस्माच्च सलिलोत्पीडादुदतिष्ठत मारुतः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2186503, "chapter_id": 4960, "verse_number": "११", "content_sanskrit": "यथा भाजनमच्छिद्रं निःशब्दमिव लक्ष्यते ।\nतच्चाम्भसा पूर्यमाणं सशब्दं कुरुतेऽनिलः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2186504, "chapter_id": 4960, "verse_number": "१२", "content_sanskrit": "तथा सलिलसंरुद्धे नभसोऽन्ते निरन्तरे ।\nभित्त्वार्णवतलं वायुः समुत्पतति घोषवान्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2186505, "chapter_id": 4960, "verse_number": "१३", "content_sanskrit": "स एष चरते वायुरर्णवोत्पीडसम्भवः ।\nआकाशस्थानमासाद्य प्रशान्तिं नाधिगच्छति\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2186506, "chapter_id": 4960, "verse_number": "१४", "content_sanskrit": "तस्मिन्वाय्वम्बुसङ्घर्षे दीप्ततेजा महाबलः ।\nप्रादुर्भवत्यूर्ध्वशिखः कृत्वा वितिमिरं नभः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2186507, "chapter_id": 4960, "verse_number": "१५", "content_sanskrit": "अग्निः पवनसंयुक्तः खात् समुत्पतते जलम् ।\nसोऽग्निर्मारुतसंयोगाद् धनत्वमुपपद्यते\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2186508, "chapter_id": 4960, "verse_number": "१६", "content_sanskrit": "तस्याकाशे निपतितः स्नेहस्तिष्ठति योऽपरः ।\nस सङ्घातत्वमापन्नो भूमित्वमुपगच्छति\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2186509, "chapter_id": 4960, "verse_number": "१७", "content_sanskrit": "रसानां सर्वगन्धानां स्नेहानां प्राणिनां तथा ।\nभूमिर्योनिरिह ज्ञेया यस्यां सर्वं प्रसूयते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2186510, "chapter_id": 4960, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे नवमोऽध्यायः ॥ ९ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]