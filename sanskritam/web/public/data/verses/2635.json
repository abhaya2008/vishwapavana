[{"id": 2077168, "chapter_id": 2635, "verse_number": "१२-१४०-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2077169, "chapter_id": 2635, "verse_number": "१२-१४०-१", "content_sanskrit": "युगक्षयात्परिक्षीणे धर्मे लोके च भारत।\nदस्युभिः पीड्यमाने च कथं स्थेयं पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2077170, "chapter_id": 2635, "verse_number": "१२-१४०-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2077171, "chapter_id": 2635, "verse_number": "१२-१४०-२", "content_sanskrit": "हन्त ते वर्तयिष्यामि नीतिमापत्सु भारत।\nउत्सृज्यापि घृणां काले यथा वर्तेत भूमिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2077172, "chapter_id": 2635, "verse_number": "१२-१४०-३", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nभारद्वाजस्य संवादं राज्ञः शत्रुंतपस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2077173, "chapter_id": 2635, "verse_number": "१२-१४०-४", "content_sanskrit": "राजात्शत्रुंतपो नाम सौवीरेषु महारथः।\nभारद्वाजमुपागम्य पप्रच्छार्थविनिश्चयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2077174, "chapter_id": 2635, "verse_number": "१२-१४०-५", "content_sanskrit": "अलब्धस्य कथं लिप्सा लब्धं केन विवर्धते।\nवधितं पाल्यते केन पालितं प्रणयेत्कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2077175, "chapter_id": 2635, "verse_number": "१२-१४०-६", "content_sanskrit": "तस्मै विनिश्चितार्थाय परिपृष्टोऽर्थिश्चयम्।\nउवाच मतिमान्वाक्यमिदं हेतुमदुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2077176, "chapter_id": 2635, "verse_number": "१२-१४०-७", "content_sanskrit": "नित्यमुद्यतदण्डः स्यान्नित्यं विवृतपौरुषः।\nअच्छिद्रश्छिद्रदर्शी च परेषां विवरानुगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2077177, "chapter_id": 2635, "verse_number": "१२-१४०-८", "content_sanskrit": "नित्यमुद्यतदण्डस्य भृशमुद्विजते नरः।\nतस्मात्सर्वाणि भूतानि दण्डेनैव प्रसाधयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2077178, "chapter_id": 2635, "verse_number": "१२-१४०-९", "content_sanskrit": "एवमेव प्रशंसन्ति बुधा ये तत्त्वदर्शिनः।\nतस्माच्चतुष्टये तस्मिन्प्रधानो दण्ड उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2077179, "chapter_id": 2635, "verse_number": "१२-१४०-१०", "content_sanskrit": "छिन्नमूले त्वधिष्ठाने सर्वे तज्जीविनो हताः।\nकथं हि शाखास्तिष्ठेयुश्छिन्नमूले वनस्पतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2077180, "chapter_id": 2635, "verse_number": "१२-१४०-११", "content_sanskrit": "मूलमेवादितश्छिन्द्यादरिपक्षस्य पण्डितः।\nततः सहायान्पक्षं च सर्वमेवानुशातयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2077181, "chapter_id": 2635, "verse_number": "१२-१४०-१२", "content_sanskrit": "सुमन्त्रितं सुविक्रान्तं सुयुद्धं सुपलायितम्।\nआपदागमकाले तु कुर्वीत न विचारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2077182, "chapter_id": 2635, "verse_number": "१२-१४०-१३", "content_sanskrit": "वाङ्भात्रेण विनीतः स्याद्धृदयेन यथा क्षुरः।\nश्लक्ष्णपूर्वाभिभाषी च कामक्रोधौ विवर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2077183, "chapter_id": 2635, "verse_number": "१२-१४०-१४", "content_sanskrit": "सपत्नसहितो राज्ये कृत्वा सन्धिं न विश्वसेत्।\nउपक्रामेत्ततः शीघ्रं कृतकार्यो विचक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2077184, "chapter_id": 2635, "verse_number": "१२-१४०-१५", "content_sanskrit": "शत्रुं च मित्रं पूर्वेण सान्त्वेनैवानुसान्त्वयेत्।\nनित्यशश्चोद्विजेत्तस्मात्सर्पाद्वेश्मगतादिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2077185, "chapter_id": 2635, "verse_number": "१२-१४०-१६", "content_sanskrit": "यस्य बुद्धिं परिभवेत्तमतीतेन सान्त्वयेत्।\nअनागतेन दुष्प्रज्ञं प्रत्युत्पन्नेन पण्डितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2077186, "chapter_id": 2635, "verse_number": "१२-१४०-१७", "content_sanskrit": "अञ्जलिं शपथं सान्त्वं शिरसा पादवन्दनम्।\nअश्रुप्रपातनं चैव कर्तव्यं भूतिमिच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2077187, "chapter_id": 2635, "verse_number": "१२-१४०-१८", "content_sanskrit": "वहेदमित्रं स्कन्धेन यावदर्थस्य लम्भनम्।\nअथैनमागते काले भिन्द्याद्धटमिवाश्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2077188, "chapter_id": 2635, "verse_number": "१२-१४०-१९", "content_sanskrit": "मुहूर्तमपि राजेन्द्र तिन्दुकालातवज्ज्वलेत्।\nमा तुषाग्निरिवानर्चिर्धूमायेत चिरं नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2077189, "chapter_id": 2635, "verse_number": "१२-१४०-२०", "content_sanskrit": "नानार्थिकोऽर्थसंबन्धं कृतघ्ने न समाचरेत्।\nअर्थी तु शक्यते भोक्तुं कृतकार्योऽवमन्यते।\nतस्मात्सर्वाणि कार्याणि सावशेषाणि कारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2077190, "chapter_id": 2635, "verse_number": "१२-१४०-२१", "content_sanskrit": "कोकिलस्य वराहस्य मेरोः शून्यस्य वेस्मनः।\nव्यालस्य भक्तचित्तस्य यच्छ्रेयस्तत्समाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2077191, "chapter_id": 2635, "verse_number": "१२-१४०-२२", "content_sanskrit": "उत्थायोत्थाय गच्छेच्च नित्ययुक्तो रिपोर्गृहम्।\nकुशलं चास्य पृच्छेत यद्यप्यकुशलं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2077192, "chapter_id": 2635, "verse_number": "१२-१४०-२३", "content_sanskrit": "नालसाः प्राप्नुवन्त्यर्थान्न क्लीबा नातिमानिनः।\nन च लोकरवाद्भीता न वै शश्वत्प्रतीक्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2077193, "chapter_id": 2635, "verse_number": "१२-१४०-२४", "content_sanskrit": "नास्य च्छिद्रं परो विद्याद्विद्याच्छिद्रं परस्य तु।\nगूहेत्कूर्म इवाङ्गानि रक्षेद्विवरमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2077194, "chapter_id": 2635, "verse_number": "१२-१४०-२५", "content_sanskrit": "बकवच्चिन्तयेदर्थान्सिंहवच्च पराक्रमेत्।\nवृकवच्चावलुम्पेत शरवच्च विनिष्पतेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2077195, "chapter_id": 2635, "verse_number": "१२-१४०-२६", "content_sanskrit": "पानमक्षास्तथा नार्यो मृगया गीतवादितम्।\nएतानि युक्त्या सेवेत प्रसङ्गो ह्यत्र दोषवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2077196, "chapter_id": 2635, "verse_number": "१२-१४०-२७", "content_sanskrit": "कुर्यात्तृणमयं चापं शयीत मृगशायिकाम्।\nअन्धः स्यादन्धवेलायां बाधिर्यमपि संश्रयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2077197, "chapter_id": 2635, "verse_number": "१२-१४०-२८", "content_sanskrit": "देशकालं समासाद्य विक्रमेत विचक्षणः।\nदेशकालव्यतीतो हि विक्रमो निष्फलो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2077198, "chapter_id": 2635, "verse_number": "१२-१४०-२९", "content_sanskrit": "कालाकालौ संप्रधार्य बलाबलमथात्मनः।\nपरस्य च बलं ज्ञात्वा तथाऽऽत्मानं नियोजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2077199, "chapter_id": 2635, "verse_number": "१२-१४०-३०", "content_sanskrit": "दण्डेनोपनतं शत्रुं यो राजा न नियच्छति।\nस मृत्युमुपगूहेत् गर्भमश्वतरी यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2077200, "chapter_id": 2635, "verse_number": "१२-१४०-३१", "content_sanskrit": "सुपुष्पितः स्यादफलः फलवान्स्याद्दुरारुहः।\nआमः स्यात्पक्वसंकाशो न च शीर्येत कस्यचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2077201, "chapter_id": 2635, "verse_number": "१२-१४०-३२", "content_sanskrit": "आशां कालवतीं कुर्यात्तां च विघ्नेन योजयेत्।\nविघ्नं निमित्ततो ब्रूयान्निमित्तं चापि हेतुमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2077202, "chapter_id": 2635, "verse_number": "१२-१४०-३३", "content_sanskrit": "भीतवत्संविधातव्यं यावद्भयमनागतम्।\nआगतं तु भयं दृष्ट्वा प्रहर्तव्यमभीतवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2077203, "chapter_id": 2635, "verse_number": "१२-१४०-३४", "content_sanskrit": "न साहसमनारुह्य नरो भद्राणि पश्यति।\nसंशयं पुनरारुह्य यदि जीवति पश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2077204, "chapter_id": 2635, "verse_number": "१२-१४०-३५", "content_sanskrit": "अनागतं विजानीयात्त्यजेद्भयमुपस्थितम्।\nपुनर्बुद्धिक्षयात्किंचिदनिवृत्तिं निशामयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2077205, "chapter_id": 2635, "verse_number": "१२-१४०-३६", "content_sanskrit": "प्रत्युपस्थितकालस्य सुखस्य परिवर्जनम्।\nअनागतसुखाशा च नैव बुद्धिमतां नयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2077206, "chapter_id": 2635, "verse_number": "१२-१४०-३७", "content_sanskrit": "योऽरिणा सह संधाय विश्वस्तः स्वपते सुखम्।\nस वृक्षाग्रे प्रसुप्तो वा पतितः प्रतिबुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2077207, "chapter_id": 2635, "verse_number": "१२-१४०-३८", "content_sanskrit": "कर्मणा येन केनेह मृदुना दारुणेन वा।\nउद्धरेद्दीनमात्मानं समर्थो धर्ममाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2077208, "chapter_id": 2635, "verse_number": "१२-१४०-३९", "content_sanskrit": "ये सपत्नाः सपत्नानां सर्वांस्ताननुवर्तयेत्।\nआत्मनश्चापि बोद्धव्याश्चाराः सुमहिताः परैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2077209, "chapter_id": 2635, "verse_number": "१२-१४०-४०", "content_sanskrit": "चारः सुविहितः कार्य आत्मनोऽथ परस्य च।\nपाषण़्डांस्तापसादींश्च परराष्ट्रे प्रवेशयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2077210, "chapter_id": 2635, "verse_number": "१२-१४०-४१", "content_sanskrit": "उद्यानेषु विहारेषु प्रपास्वावसथेषु च।\nपानागारे प्रवेशेषु तीर्थेषु च सभासु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2077211, "chapter_id": 2635, "verse_number": "१२-१४०-४२", "content_sanskrit": "धर्माभिचारिणः पापाश्चौरा लोकस्य कण्टकाः।\nसमागच्छन्ति तान्बुद्ध्वा नियच्छेच्छमयीत च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2077212, "chapter_id": 2635, "verse_number": "१२-१४०-४३", "content_sanskrit": "न विश्वसेदविश्वस्ते विश्वस्ते नातिविश्वसेत्।\nविश्वासाद्भयमभ्येति नापरीक्ष्य च विश्वसेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2077213, "chapter_id": 2635, "verse_number": "१२-१४०-४४", "content_sanskrit": "विश्वासयित्वा तु परं तत्त्वभूतेन हेतुना।\nअथास्य प्रहरेत्काले किंचिद्विचलिते पदे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2077214, "chapter_id": 2635, "verse_number": "१२-१४०-४५", "content_sanskrit": "अशङ्क्यमपि शङ्केत नित्यं शङ्केत शङ्कितान।\nभयं ह्यशङ्किताज्जातं समूलमपि कृन्तति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2077215, "chapter_id": 2635, "verse_number": "१२-१४०-४६", "content_sanskrit": "अवधानेन मौनेन काषायेण जटाजिनैः।\nविश्वासयित्वा द्वेष्टारमवलुम्पेद्यथा वृकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2077216, "chapter_id": 2635, "verse_number": "१२-१४०-४७", "content_sanskrit": "पुत्रो वा यदि वा भ्राता पिता वा यदि वा सुहृद।\nअर्थस्य विघ्नं कुर्वाणा हन्तव्या भूतिमिच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2077217, "chapter_id": 2635, "verse_number": "१२-१४०-४८", "content_sanskrit": "गुरोरप्यवलिप्तस्य कार्याकार्यमजानतः।\nउत्पथं प्रतिपन्नस्य कार्यं भवति शासनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2077218, "chapter_id": 2635, "verse_number": "१२-१४०-४९", "content_sanskrit": "प्रत्युत्थानाभिवादाभ्यां संप्रदानेन केनचित्।\nप्रपूजयन्निघाती स्यात्तीक्ष्णतुण्ड इव द्विजः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2077219, "chapter_id": 2635, "verse_number": "१२-१४०-५०", "content_sanskrit": "नाच्छित्त्वा परमर्माणि नाकृत्वा कर्म दारुणम्।\nनाहत्वा मत्स्यघातीव प्राप्नोति परमां श्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2077220, "chapter_id": 2635, "verse_number": "१२-१४०-५१", "content_sanskrit": "नास्ति जात्या रिपुर्नाम मित्रं वाऽपि न विद्यते।\nसामर्थ्ययोगाज्जायन्ते मित्राणि रिपवस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2077221, "chapter_id": 2635, "verse_number": "१२-१४०-५२", "content_sanskrit": "न प्रमुञ्चेत दायादं वदन्तं करुणं बहु।\nदुःखं तत्र न कर्तव्यं हन्यात्पूर्वापकारिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2077222, "chapter_id": 2635, "verse_number": "१२-१४०-५३", "content_sanskrit": "संग्रहानुग्रहे यत्नः सदा कार्योऽनसूयता।\nनिग्रहश्चापि यत्नेन कर्तव्यो हितमिच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2077223, "chapter_id": 2635, "verse_number": "१२-१४०-५४", "content_sanskrit": "प्रहरिष्यन्प्रियं ब्रूयात्प्रहृत्यापि प्रियोत्तरम्।\nअसिनाऽपि शिरश्छित्त्वा शोचेत च रुदेत च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2077224, "chapter_id": 2635, "verse_number": "१२-१४०-५५", "content_sanskrit": "निमन्त्रयीत सान्त्वेन संमानेन तितिक्षया।\nआशाकरणमित्येतत्कर्तव्यं भूतिमिच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2077225, "chapter_id": 2635, "verse_number": "१२-१४०-५६", "content_sanskrit": "न शुष्कवैरं कुर्वीत बाहुभ्यां न नदीं तरेत्।\nअनर्थकमनायुष्यं गोविषाणस्य भक्षणम्।\nदन्ताश्च परिमृद्यन्ते रसश्चापि न लभ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2077226, "chapter_id": 2635, "verse_number": "१२-१४०-५७", "content_sanskrit": "त्रिवर्गे त्रिविधा पीडा अनुबन्धस्तथैव च।\nअनुबन्धं तथा ज्ञात्वा पीडां च परिवर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2077227, "chapter_id": 2635, "verse_number": "१२-१४०-५८", "content_sanskrit": "ऋणशेषं चाग्निशेषं शत्रुशेषं तथैव च।\nपुनः पुनः प्रवर्धन्ते तस्माच्छेषं न कारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2077228, "chapter_id": 2635, "verse_number": "१२-१४०-५९", "content_sanskrit": "ऋणशेषां विवर्धन्ते परिभूताश्च शत्रवः।\nआवहन्त्यनयं तीव्रं व्याधयश्चाप्युपेक्षिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2077229, "chapter_id": 2635, "verse_number": "१२-१४०-६०", "content_sanskrit": "नाम---क्कृत्यकारी स्यादप्रमत्तः सदा भवेत्।\nकष्यकोपि हि दुश्छिन्नो विकारं कुरुते चिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2077230, "chapter_id": 2635, "verse_number": "१२-१४०-६१", "content_sanskrit": "वधेम च मनुष्याणां मार्गाणां दूषणेन च।\nआकाराणां विनाशैश्च परराष्ट्रं विनाशयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2077231, "chapter_id": 2635, "verse_number": "१२-१४०-६२", "content_sanskrit": "गृध्रदृष्टिर्बकालीनः श्वचेष्टः सिंहविक्रमः।\nअनुद्विग्रः काकशङ्की भुजङ्गचरितं चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2077232, "chapter_id": 2635, "verse_number": "१२-१४०-६३", "content_sanskrit": "शूरमञ्जलिपातेन भीरुं भेदेन भेदयेत्।\nलुब्धमर्थप्रदानेन समं तुल्येन विग्रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2077233, "chapter_id": 2635, "verse_number": "१२-१४०-६४", "content_sanskrit": "श्रेणीमुख्योपजापेषु वल्लभानुनयेषु च।\nअमात्यान्परिरक्षेत भेदसंघातयोरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2077234, "chapter_id": 2635, "verse_number": "१२-१४०-६५", "content_sanskrit": "मृदुरित्यवजानन्ति तीक्ष्ण इत्युद्विजन्ति च।\nतीक्ष्णकाले भवेत्तीक्ष्णो मृदुकाले मृदुर्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2077235, "chapter_id": 2635, "verse_number": "१२-१४०-६६", "content_sanskrit": "मृदुनैव मृदुं हन्ति मृदुना हन्ति दारुणम्।\nनासाध्यं मृदुना किंचित्तस्मात्तीक्ष्णतरो मृदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2077236, "chapter_id": 2635, "verse_number": "१२-१४०-६७", "content_sanskrit": "काले मृदुर्यो भवति काले भवति दारुणः।\nस साधयति कृत्यानि शत्रुं चाप्यधितिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2077237, "chapter_id": 2635, "verse_number": "१२-१४०-६८", "content_sanskrit": "पण्डितेन विरुद्धस्तु दूरस्थोऽस्मीति नाश्वसेत्।\nदीर्घौ बुद्धिमतो बाहू याभ्यां हिंसति हिंसितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2077238, "chapter_id": 2635, "verse_number": "१२-१४०-६९", "content_sanskrit": "न तत्तरेद्यस्य न पारमुत्तरे\nन्न तद्धरेद्यत्पुनराहरेत्परः।\nन तत्खनेद्यस्य न मूलमुद्धरे\nन्न तं हन्याद्यस्य शिरो न पातयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2077239, "chapter_id": 2635, "verse_number": "१२-१४०-७०", "content_sanskrit": "इतीदमुक्तं वृजिनाभिसंहितं\nन चैतदेवं पुरुषः समाचरेत्।\nपरप्रयुक्तस्तु कथं विभावये\nदतो मयोक्तं भवतो हितार्थिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2077240, "chapter_id": 2635, "verse_number": "१२-१४०-७१x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2077241, "chapter_id": 2635, "verse_number": "१२-१४०-७१", "content_sanskrit": "यथावदुक्तं वचनं हितार्थिना\nनिशम्य विप्रेण सुवीरराष्ट्रपः।\nतथाऽकरोद्वाक्यमदीनचेतनः\nश्रियं च दीप्तां बुभुजे सबान्धवः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2077242, "chapter_id": 2635, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि चत्वारिंशदधिकशततमोऽध्यायः॥ १४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}]