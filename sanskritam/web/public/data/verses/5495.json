[{"id": 2210113, "chapter_id": 5495, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2210114, "chapter_id": 5495, "verse_number": "१", "content_sanskrit": "श्रुतं प्रियमिदं कृष्ण यत् त्वया मम भाषितम् ।\nतन्मेऽमृतरसप्रख्यं मनो ह्लादयते विभो ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2210115, "chapter_id": 5495, "verse_number": "२", "content_sanskrit": "बहूनि किल युद्धानि विजयस्य नराधिपैः ।\nपुनरासन् हृषीकेश तत्र तत्र मया श्रुतम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2210116, "chapter_id": 5495, "verse_number": "३", "content_sanskrit": "मन्निमित्तं हि स तदा पार्थः सुखविवर्जितः ।\nअतीव विजयो धीमान् इति मे दूयते मनः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2210117, "chapter_id": 5495, "verse_number": "४", "content_sanskrit": "सञ्चिन्तयामि वार्ष्णेय सदा कुन्तीसुतं रहः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2210118, "chapter_id": 5495, "verse_number": "५", "content_sanskrit": "किं नु तस्य शरीरेऽस्ति सर्वलक्षणपूजिते ।\nअनिष्टं लक्षणं कृष्ण येन दुःखान्युपाश्नुते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2210119, "chapter_id": 5495, "verse_number": "६", "content_sanskrit": "अतीव दुःखभागी स सततं कुन्तिनन्दनः ।\nन च पश्यामि बीभत्सोर्निन्द्यं गात्रेषु किञ्चन ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2210120, "chapter_id": 5495, "verse_number": "७", "content_sanskrit": "श्रोतव्यं चेन्मयैतद् वै तन्मे व्याख्यातुमर्हसि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2210121, "chapter_id": 5495, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2210122, "chapter_id": 5495, "verse_number": "८", "content_sanskrit": "इत्युक्तः स हृषीकेशो ध्यात्वा सुमहदन्तरम् ।\nराजानं भोजराजन्यवर्धनो विष्णुरब्रवीत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2210123, "chapter_id": 5495, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2210124, "chapter_id": 5495, "verse_number": "९", "content_sanskrit": "न ह्यस्य नृपते किञ्चिद् अनिष्टमुपलक्षये ।\nऋते पुरुषसिंहस्य पिण्डिकेऽस्याधिके यतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2210125, "chapter_id": 5495, "verse_number": "१०", "content_sanskrit": "ताभ्यां स पुरुषव्याघ्रो नित्यमध्वसु युज्यते ।\nन ह्यन्यमनुपश्यामि येनासौ दुःखभाग् जयः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2210126, "chapter_id": 5495, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2210127, "chapter_id": 5495, "verse_number": "११", "content_sanskrit": "इत्युक्तः स कुरुश्रेष्ठः सत्यं कृष्णेन धीमता ।\nप्रोवाच वृष्णिशार्दूलमेवमेतदिति प्रभुः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2210128, "chapter_id": 5495, "verse_number": "१२", "content_sanskrit": "कृष्णा तु द्रौपदी कृष्णं तिर्यक् सासूयमैक्षत ।\nप्रतिजग्राह तस्यास्तं प्रणयं चापि केशिहा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2210129, "chapter_id": 5495, "verse_number": "१३", "content_sanskrit": "सख्युः सखा हृषीकेशः साक्षादिव धनञ्जयः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2210130, "chapter_id": 5495, "verse_number": "१४", "content_sanskrit": "तत्र भीमादयस्ते तु कुरवो यादवास्तदा ।\nविचित्रा रेमिरे श्रुत्वा धनञ्जयकथां विभो ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2210131, "chapter_id": 5495, "verse_number": "१५", "content_sanskrit": "तथा कथयतामेव तेषामर्जुनसङ्कथाः ।\nउपायाद् वचनान्मर्त्यो विजयस्य महात्मनः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2210132, "chapter_id": 5495, "verse_number": "१६", "content_sanskrit": "सोऽभिगम्य कुरुश्रेष्ठं नमस्कृत्य च बुद्धिमान् ।\nउपायातं नरव्याघ्रमर्जुनं प्रत्यवेदयत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2210133, "chapter_id": 5495, "verse_number": "१७", "content_sanskrit": "तच्छ्रुत्वा नृपतिस्तस्मै हर्षबाष्पाकुलेक्षणः ।\nप्रियाख्याननिमित्तं वै ददौ बहुधनं तदा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2210134, "chapter_id": 5495, "verse_number": "१८", "content_sanskrit": "ततो द्वितीये दिवसे महान् शब्दोऽभ्यवर्तत ।\nआयाति पुरुषव्याघ्रे पाण्डवानां धुरन्धरे ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2210135, "chapter_id": 5495, "verse_number": "१९", "content_sanskrit": "ततो रेणुः समुद्भूतो विबभौ तस्य वाजिनः ।\nअभितो वर्तमानस्य यथोच्चैःश्रवसस्तथा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2210136, "chapter_id": 5495, "verse_number": "२०", "content_sanskrit": "तत्र हर्षकला वाचो नराणां शुश्रुवेऽर्जुनः ।\nदिष्ट्या हि पार्थः कुशली धन्यो राजा युधिष्ठिरः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2210137, "chapter_id": 5495, "verse_number": "२१", "content_sanskrit": "कोऽन्यो हि पृथिवीं कृत्स्नात् अभिजित्य सपार्थिवाम् ।\nचारयित्वा हयश्रेष्ठमुपेयादर्जुनादृते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2210138, "chapter_id": 5495, "verse_number": "२२", "content_sanskrit": "ये व्यतीता महात्मानो राजानः सगरादयः ।\nतेषामपीदृशं कर्म न किञ्चिदपि शुश्रुमः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2210139, "chapter_id": 5495, "verse_number": "२३", "content_sanskrit": "नैतदन्ये करिष्यन्ति भविष्यन्तो नराधिपाः ।\nयत् त्वं कुरुकुलश्रेष्ठ दुष्करं कृतवानिह ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2210140, "chapter_id": 5495, "verse_number": "२४", "content_sanskrit": "इत्येवं वदतां नॄणां तेषां श्रुतिसुखावहाः ।\nशृण्वन् विवेश धर्मात्मा फल्गुनो यज्ञसंस्तरम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2210141, "chapter_id": 5495, "verse_number": "२५", "content_sanskrit": "ततो राजा सहामात्यः कृष्णश्च यदुनन्दनः ।\nधृतराष्ट्रं पुरस्कृत्य ते तं प्रत्युद्ययुस्तदा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2210142, "chapter_id": 5495, "verse_number": "२६", "content_sanskrit": "सोऽभिवाद्य पितुः पादौ धर्मराजस्य धीमतः ।\nभीमादींश्चापि सम्पूज्य पर्यष्वजत केशवम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2210143, "chapter_id": 5495, "verse_number": "२७", "content_sanskrit": "तैः समेत्यार्चितस्तान् स प्रत्यर्च्याथ यथाविधि ।\nविशश्राम स धर्मात्मा तीरं लब्ध्वेव पारगः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2210144, "chapter_id": 5495, "verse_number": "२८", "content_sanskrit": "एतस्मिन्नेव काले तु स राजा बभ्रुवाहनः ।\nमातृभ्यां सहितो धीमान् कुरूनभ्याजगाम ह ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2210145, "chapter_id": 5495, "verse_number": "२९", "content_sanskrit": "स समेत्य कुरून् सर्वान् सर्वैस्तैरभिनन्दितः ।\nप्रविवेश पितामह्याः कुन्त्या भवनमुत्तमम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2210146, "chapter_id": 5495, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि अर्जुनागमनं नाम एकोननवतितमोऽध्यायः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]