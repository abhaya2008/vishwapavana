[{"id": 2177980, "chapter_id": 4760, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2177981, "chapter_id": 4760, "verse_number": "१", "content_sanskrit": "कथं संसारगहनं विज्ञेयं वदतां वर ।\nएतदिच्छाम्यहं श्रोतुं तत्त्वमाख्याहि पृच्छते\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2177982, "chapter_id": 4760, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2177983, "chapter_id": 4760, "verse_number": "२", "content_sanskrit": "जन्मप्रभृति भूतानां क्रियाः सर्वास्तु लक्षयेत् ।\nपूर्वमेवेह कलिले वसते किञ्चिदनन्तरम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2177984, "chapter_id": 4760, "verse_number": "३", "content_sanskrit": "ततः स पञ्चमेऽतीते मांसे श्वासमकल्पयत् ।\nततः सर्वाङ्गसम्पूर्णो गर्भो मासे च जायते\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2177985, "chapter_id": 4760, "verse_number": "४", "content_sanskrit": "अमेध्यमध्ये वसति मांसशोणितलेपने ।\nततस्तु वायुवेगेन ह्यूर्ध्वपादो ह्यधोमुखः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2177986, "chapter_id": 4760, "verse_number": "५", "content_sanskrit": "योनिद्वारमुपागम्य बहून् क्लेशान् समृच्छति ।\nयोनिसम्पीडनाच्चैव पूर्वकर्मपदानुगः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2177987, "chapter_id": 4760, "verse_number": "६", "content_sanskrit": "तस्मान्मुक्तः स संसारादन्यान् पश्यत्युपद्रवान् ।\nग्रहास्तमुपसर्पन्ति सारमेया इवामिषम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2177988, "chapter_id": 4760, "verse_number": "७", "content_sanskrit": "ततः कालान्तरे प्राप्ते व्याधयश्चापि तं तथा ।\nउपसर्पन्ति जीवन्तं बध्यमानं स्वकर्मभिः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2177989, "chapter_id": 4760, "verse_number": "८", "content_sanskrit": "बद्धमिन्द्रियपाशैस्तं सङ्गकामुकमातुरम् ।\nव्यसनान्यनुवर्तन्ते विविधानि नराधिप\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2177990, "chapter_id": 4760, "verse_number": "९", "content_sanskrit": "मथ्यमानश्च तैर्भूयो नैव तृप्तिमुपैति सः ।\nअयं न बुद्ध्यते तावद् यमलोकादिहागमम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2177991, "chapter_id": 4760, "verse_number": "१०", "content_sanskrit": "(यमदूतैर्विकृष्टश्च मृत्युं कालेन गच्छति\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2177992, "chapter_id": 4760, "verse_number": "", "content_sanskrit": "वाग्घीनस्य च या मात्रा इष्टानिष्टकृताऽस्य वै ।\nभूय एवात्मनाऽऽत्मानं बध्यमानमुपैति सः\t॥११)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2177993, "chapter_id": 4760, "verse_number": "१२", "content_sanskrit": "तत्रैनं परिपश्यन्ति ये ध्यानपरिनिष्ठिताः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2177994, "chapter_id": 4760, "verse_number": "१३", "content_sanskrit": "अहो विनिकृतो लोको लोभेन च वशीकृतः ।\nलोभक्रोधमदोन्मत्तो नात्मानमवबुद्ध्यते\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2177995, "chapter_id": 4760, "verse_number": "१४", "content_sanskrit": "कुलीनत्वे च रमते दुष्कुलीनान् विकुत्सयन् ।\nधनदर्पेण दृप्तश्च दारिद्र्यं परिकुत्सयन्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2177996, "chapter_id": 4760, "verse_number": "१५", "content_sanskrit": "मूर्खानिति परानाह नात्मानं समवेक्षते ।\nदोषान् क्षिपति चान्येषां नात्मानं शास्तुमर्हति\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2177997, "chapter_id": 4760, "verse_number": "१६", "content_sanskrit": "यथा प्राज्ञाश्च मूढाश्च धनवन्तोऽथ निर्धनाः ।\nकुलीनाश्चाकुलीनाश्च मानिनोऽथाप्यमानिनः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2177998, "chapter_id": 4760, "verse_number": "१७", "content_sanskrit": "सर्वे पितृवनं प्राप्ताः स्वपन्ति विगतत्वचः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2177999, "chapter_id": 4760, "verse_number": "१८", "content_sanskrit": "निर्मांसैरस्थिभूयिष्ठैः गात्रैश्च स्नायुबन्धनैः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2178000, "chapter_id": 4760, "verse_number": "१९", "content_sanskrit": "किं विशेषं प्रपश्यन्ति तत्र तेषां परे जनाः ।\nयेन प्रत्यवगच्छेयुः कुलरूपविशेषणम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2178001, "chapter_id": 4760, "verse_number": "२०", "content_sanskrit": "यदा सर्वे समं न्यस्ताः स्वपन्ति धरणीतळे ।\nतस्मादन्योन्यमिच्छन्ति विप्रलब्धुमिहाबुधाः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2178002, "chapter_id": 4760, "verse_number": "२१", "content_sanskrit": "प्रत्यक्षं च परोक्षं च यो निशाम्य श्रुतिं त्विमाम् ।\nजन्मप्रभृति वर्तेत प्राप्नुयात् परमां गतिम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2178003, "chapter_id": 4760, "verse_number": "२२", "content_sanskrit": "एवं सर्वं विदित्वा वै यस्तत्त्वमनुवर्तते ।\nस वै मोक्षयते चैव पन्थानं मनुजाधिप\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2178004, "chapter_id": 4760, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां स्त्रीपर्वणि\nधृतराष्ट्रविशोके चतुर्थोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2178005, "chapter_id": 4760, "verse_number": "", "content_sanskrit": "जलप्रदानपर्वणि चतुर्थोऽध्यायः ॥४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]