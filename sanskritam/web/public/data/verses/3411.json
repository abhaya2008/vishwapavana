[{"id": 2111468, "chapter_id": 3411, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2111469, "chapter_id": 3411, "verse_number": "१", "content_sanskrit": "प्रतिज्ञाय तु दुष्षन्ते प्रतियाते शकुन्तलाम् ।\nगर्भश्च ववृधे तस्या राज्ञः पत्न्या महात्मनः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2111470, "chapter_id": 3411, "verse_number": "२", "content_sanskrit": "शकुन्तला चिन्तयन्ती राजानं कार्यगौरवात् ।\nराजप्रेषणिका विप्राः चतुरङ्गबलैः सह \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2111471, "chapter_id": 3411, "verse_number": "३", "content_sanskrit": "अद्य श्वो वा परश्वो वा समायान्तीति निश्चिता ।\nदिवसान् पक्षानृतून् मासानयनानि च सर्वशः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2111472, "chapter_id": 3411, "verse_number": "४", "content_sanskrit": "गण्यमानेषु वर्षेषु व्यतीयुस्त्रीणि भारत ।\nत्रिषु वर्षेषु पूर्णेषु ऋषेर्वचनगौरवान् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2111473, "chapter_id": 3411, "verse_number": "५", "content_sanskrit": "ऋपिपत्न्यः सुबहवो हेतुमद्वाक्यमब्रुवन् ।\nशृणु भद्रे लोकवृत्तं श्रुत्वा यद् रोचते तव \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2111474, "chapter_id": 3411, "verse_number": "६", "content_sanskrit": "तत् कुरुष्व हितं देवि नावमान्यं गुरोर्वचः ।\nदेवानां दैवतं विष्णुर्विप्राणामग्निदैवतम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2111475, "chapter_id": 3411, "verse_number": "७", "content_sanskrit": "नारीणां दैवतं भर्ता लोकानां ब्राह्मणं विदुः ।\nसूतिकाले प्रसूयेति भगवांस्ते पिताऽब्रवीत् ।\nकरिष्यामीति कर्तव्यं तथा ते सुकृतं भवेत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2111476, "chapter_id": 3411, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2111477, "chapter_id": 3411, "verse_number": "८", "content_sanskrit": "पत्नीनां वचनं श्रुत्वा साधु साध्वित्यचिन्तयत् ।\nगर्भं सुषाव वामोरूः कुमारममितौजसम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2111478, "chapter_id": 3411, "verse_number": "९", "content_sanskrit": "त्रिषु वर्षेषु पूर्णेषु प्राजायत शकुन्तला ।\nरूपौदार्यगुणोपेतं दौष्षन्तिं जनमेजय \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2111479, "chapter_id": 3411, "verse_number": "१०", "content_sanskrit": "तस्मिंस्तदाऽन्तरिक्षात् तु पुष्पवृष्टिः पपात ह ।\nदेवदुन्दुभयो नेदुर्ननृतुश्चाप्सरोगणाः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2111480, "chapter_id": 3411, "verse_number": "११", "content_sanskrit": "गायन्तो मधुरं तत्र देवैः शक्रोऽभ्युवाच ह ।\nशकुन्तले तव सुतश्चक्रवर्ती भविष्यति \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2111481, "chapter_id": 3411, "verse_number": "११", "content_sanskrit": "बलं तेजश्च रूपं च न समं भुवि केनचित् ।\nआहर्ता वाजिमेधस्य शतसङ्ख्यस्य पौरवः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2111482, "chapter_id": 3411, "verse_number": "१२", "content_sanskrit": "अनेकैरिहसाहस्रैः राजसूयादिभिर्मखैः ।\nस्वार्थं ब्राह्मणसात् कृत्वा दक्षिणाममितां ददत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2111483, "chapter_id": 3411, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2111484, "chapter_id": 3411, "verse_number": "१३", "content_sanskrit": "देवतानां वचः श्रुत्वा कण्वाश्रमनिवासिनः ।\nसभाजयन्त कण्वस्य सुतां सर्वे महर्षयः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2111485, "chapter_id": 3411, "verse_number": "१४", "content_sanskrit": "शकुन्तला च तच्छ्रुत्वा परं हर्षमवाप सा ।\nद्विजानाहूय मुनिभिः सत्कृत्य च महायशाः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2111486, "chapter_id": 3411, "verse_number": "१५", "content_sanskrit": "जातकर्मादिसंस्कारं कण्वः पुण्यवतां वरः ।\nतयास्य कारयामास वर्धमानस्य चासकृत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2111487, "chapter_id": 3411, "verse_number": "१६", "content_sanskrit": "यथाविधि यथान्यायं क्रियाः सर्वास्त्वकारयत् ।\nदन्तैः शुभ्रैः शिखरिभिः सिंहसंहननो युवा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2111488, "chapter_id": 3411, "verse_number": "१७", "content_sanskrit": "चक्राङ्कितकरः श्रीमान् स्वयं विष्णुरिवापरः ।\nचतुष्किष्कुश्च किष्कुश्च महामूर्धा महाबलः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2111489, "chapter_id": 3411, "verse_number": "१८", "content_sanskrit": "कुमारो देवगर्भाभः स तत्राशु व्यवर्धत ।\nऋषेर्भयात् तु दुष्षन्तः स्मरन्नपि नचास्मरत् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2111490, "chapter_id": 3411, "verse_number": "१९", "content_sanskrit": "गते काले तु महति न सस्मार तपोधनाम् ।\nषड्वर्षेषु ततो बालः कण्वाश्रमपदं प्रति\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2111491, "chapter_id": 3411, "verse_number": "२०", "content_sanskrit": "व्याघ्रान् सिंहान् वराहांश्च वृकांश्च महिषांस्तथा ।\nऋक्षांश्चापि द्विजानन्यान् पद्भ्यामाश्रमपीडकान् ॥ २०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2111492, "chapter_id": 3411, "verse_number": "२१", "content_sanskrit": "बलाद् भुजाभ्यां सङ्गृह्य बलवान् सन्नियम्य च ।\nबद्ध्वा वृक्षेषु दौष्षन्तिराश्रमस्य समीपतः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2111493, "chapter_id": 3411, "verse_number": "२२", "content_sanskrit": "आरोहद् दमयंश्चैव क्रीडन् स्म परिधावति ।\nवनं च लोडयामास सिंहव्याघ्रगणैर्वृतम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2111494, "chapter_id": 3411, "verse_number": "२३", "content_sanskrit": "ततो राक्षससङ्घांश्च पिशाचांश्च रिपून् रणे ।\nमुष्टियुद्धेन निर्जित्य ऋषीनाराधयत् तदा \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2111495, "chapter_id": 3411, "verse_number": "२४", "content_sanskrit": "कश्चिद् दितिसुतस्तं तु हन्तुकामो महाबलः ।\nवध्यमानांस्तु दैतेयानमर्षी तं समभ्ययात् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2111496, "chapter_id": 3411, "verse_number": "२५", "content_sanskrit": "तमागतं प्रहस्यैव बाहुभ्यां परिगृह्य च ।\nदृढं चाबध्य बाहुभ्यां पीडयामास तं तदा\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2111497, "chapter_id": 3411, "verse_number": "२६", "content_sanskrit": "मर्दितो न शशाकास्य मोक्षितुं बलवत्तया ।\nप्राक्रोशद् भैरवं तत्र द्वारेभ्यो निःसृतं त्वसृक्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2111498, "chapter_id": 3411, "verse_number": "२७", "content_sanskrit": "तेन शब्देन वित्रस्ता मृगाः सिंहादयो गणाः ।\nसुस्रुवुश्च शकृन्मूत्रम् आश्रमस्थाश्च सुस्रुवुः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2111499, "chapter_id": 3411, "verse_number": "२८", "content_sanskrit": "निरसुर्जानुना भूमौ पपात भुवि पीडितः ।\nतं दृष्ट्वा विस्मयं जग्मुः कुमारस्य विचेष्टितम् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2111500, "chapter_id": 3411, "verse_number": "२९", "content_sanskrit": "नित्यकालं वध्यमाना दैतेया राक्षसैः सह ।\nकुमारस्य भयादेव नैव जग्मुस्तदाश्रमम् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2111501, "chapter_id": 3411, "verse_number": "३०", "content_sanskrit": "ततोऽस्य नाम चक्रुस्ते कण्वाश्रमनिवासिनः ।\nकण्वेन सहिताः सर्वे दृष्ट्वा कर्मातिमानुषम् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2111502, "chapter_id": 3411, "verse_number": "३१", "content_sanskrit": "अस्त्वयं सर्वदमनः सर्वं हि दमयत्यसौ ।\nस सर्वदमनो नाम कुमारः समपद्यत \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2111503, "chapter_id": 3411, "verse_number": "३२", "content_sanskrit": "विक्रमेणौजसा चैव बलेन च समन्वितः ।\nअप्रेषयति दुष्षन्ते महिष्यानयनस्य च\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2111504, "chapter_id": 3411, "verse_number": "३३", "content_sanskrit": "पाण्डुभावपरीताङ्गीं चिन्तयाऽभिपरिप्लुताम् ।\nलम्बालकां कृशां दीनां तथा मलिनवाससम् \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2111505, "chapter_id": 3411, "verse_number": "३४", "content_sanskrit": "शकुन्तलां च सम्प्रेक्ष्य प्रदध्यौ स मुनिस्तदा ।\nशास्त्राणि सर्ववेदाश्च द्वादशाब्दस्य चाभवन् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2111506, "chapter_id": 3411, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2111507, "chapter_id": 3411, "verse_number": "३५", "content_sanskrit": "तं कुमारमृषिर्दृष्ट्वा कर्म चास्यामानुषम् ।\nसमयो यौवराज्याय इत्यनुध्याय स द्विजः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2111508, "chapter_id": 3411, "verse_number": "३६", "content_sanskrit": "शकुन्तलां समाहूय कण्वो वचनमब्रवीत् ।\nपितृभ्रातृसुतानां च दम्पतीनां विशेषतः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2111509, "chapter_id": 3411, "verse_number": "३७", "content_sanskrit": "दर्शनं द्वादशादब्दादन्तः कार्यमिति द्विजः ।\nतन्मानवेन स्मृतिना ध्यात्वा प्रोक्तमिति प्रभुः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2111510, "chapter_id": 3411, "verse_number": "", "content_sanskrit": "कण्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2111511, "chapter_id": 3411, "verse_number": "३८", "content_sanskrit": "शृणु भद्रे मम सुते मम वाक्यं शुचिस्मिते ।\nपतिव्रतानां नारीणां विशिष्टमिति चोच्यते \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2111512, "chapter_id": 3411, "verse_number": "३९", "content_sanskrit": "पतिशुश्रूषणं पूर्वं मनोवाक्कायचेष्टितैः ।\nअनुज्ञाता मया पूज्यं पूजयैतद् व्र्रतं शुभम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2111513, "chapter_id": 3411, "verse_number": "४०", "content_sanskrit": "एतेनैव च वृत्तेन पुण्यान् लोकानवाप्स्यसि ।\nतस्यान्ते मानुषे लोके विशिष्टां लप्स्यसे श्रियम् \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2111514, "chapter_id": 3411, "verse_number": "४१", "content_sanskrit": "तस्माद् भद्रे प्रयातव्यं समीपं पौरवस्य ह ।\nस्वयं नायाति मत्वा ते गतः कालः शुचिस्मिते \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2111515, "chapter_id": 3411, "verse_number": "४२", "content_sanskrit": "गत्वाऽऽराधय राजानं दुष्षन्तं हितकाम्यया ।\nदौष्षन्तिं यौवराज्यस्थं दृष्ट्वा प्रीतिमवाप्स्यसि \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2111516, "chapter_id": 3411, "verse_number": "४३", "content_sanskrit": "देवतानां गुरूणां च क्षत्रियाणां च भामिनि ।\nभर्तॄणां च विशेषेण हितं सङ्गमनं सताम् \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2111517, "chapter_id": 3411, "verse_number": "४४", "content_sanskrit": "तस्मात् पुत्रि कुमारेण गन्तव्यं मत्प्रियेप्सया ।\nप्रतिवाक्यं न दद्यास्त्वं शापिता मम पादयोः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2111518, "chapter_id": 3411, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2111519, "chapter_id": 3411, "verse_number": "४५", "content_sanskrit": "एवमुक्त्वा सुतां तत्र पौत्रं कण्वोऽभ्यभाषत ।\nपरिष्वज्य च बाहुभ्यां मूर्ध्न्युपाघ्राय पौरवम् \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2111520, "chapter_id": 3411, "verse_number": "४६", "content_sanskrit": "सोमवंशोद्भवो राजा दुष्षन्तो नाम विश्रुतः ।\nतस्याग्रमहिषी चैषा तव माता शुचिस्मिता\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2111521, "chapter_id": 3411, "verse_number": "४७", "content_sanskrit": "गन्तुकामा भर्तृपार्श्वं त्वया सह सुमध्यमा ।\nगत्वाऽभीवाद्य राजानं यौवराज्यमवाप्स्यसि\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2111522, "chapter_id": 3411, "verse_number": "४८", "content_sanskrit": "स पिता तव राजेन्द्रः तस्य त्वं वशगो भव ।\nपितृपैतामहं राज्यमनुतिष्ठस्व भावतः ।\nतस्मिन् काले स्वराज्यस्थो मामनुस्मर पुत्रक\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2111523, "chapter_id": 3411, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2111524, "chapter_id": 3411, "verse_number": "४९", "content_sanskrit": "अभिवाद्य मुनेः पादौ पौरवो वाक्यमब्रवीत् ।\nत्वं पिता मम विप्रर्षे त्वं माता त्वं गतिश्च मे \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2111525, "chapter_id": 3411, "verse_number": "५०", "content_sanskrit": "न चान्यं पितरं मन्ये त्वामृते तु महातपाः ।\nतव शुश्रूषणं नित्यमिह लोके परत्र च\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2111526, "chapter_id": 3411, "verse_number": "५१", "content_sanskrit": "शकुन्तला भर्तृकामा स्वयं यातु यथेष्टतः ।\nअहं शुश्रूषणपरः पादमूले वसाम्यहम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2111527, "chapter_id": 3411, "verse_number": "५२", "content_sanskrit": "क्रीडां व्यालमृगैः सार्धं करिष्ये न पुरा यथा ।\nत्वच्छासनपरो नित्यं स्वाध्यायं सुकरोम्यहम् \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2111528, "chapter_id": 3411, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2111529, "chapter_id": 3411, "verse_number": "५३", "content_sanskrit": "एवमुक्त्वा तु संश्लिष्य पादौ कण्वस्य तिष्ठति ।\nतस्य तद्वचनं श्रुत्वा प्ररुरोद शकुन्तला \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2111530, "chapter_id": 3411, "verse_number": "५४", "content_sanskrit": "स्नेहात् पितुश्च पुत्रस्य हर्षशोकसमन्विता ।\nनिशाम्य रोदनं मातुर्दौष्षन्तिर्वाक्यमब्रवीत् \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2111531, "chapter_id": 3411, "verse_number": "५५", "content_sanskrit": "श्रुत्वा भगवतो वाक्यं किं रोदिषि शकुन्तले ।\nगन्तव्यं काल्य उत्थाय भर्तृप्रीतिस्तवास्ति चेत्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2111532, "chapter_id": 3411, "verse_number": "", "content_sanskrit": "शकुन्तला", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2111533, "chapter_id": 3411, "verse_number": "५६", "content_sanskrit": "एकस्तु कुरुते पापं फलं भुङ्क्ते महाजनः ।\nभोक्तारस्तत्र मुच्यन्ते कर्ता दोषेण लिप्यते\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2111534, "chapter_id": 3411, "verse_number": "५७", "content_sanskrit": "मया निवारितो नित्यं न करोषि वचो मम ।\nनस्योतान् कुञ्जरान् नित्यं बाहुभ्यां सम्प्रमथ्य वै \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2111535, "chapter_id": 3411, "verse_number": "५८", "content_sanskrit": "वनं च लोडयन् नित्यं सिंहव्याघ्रनिषेवितम् ।\nएवंविधानि चान्यानि कृत्वा वै पुरुनन्दन \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2111536, "chapter_id": 3411, "verse_number": "५९", "content_sanskrit": "रुषितो भगवांस्तात तस्मादावां विवासितौ ।\nअहं न गच्छे दुष्षन्तं नास्मि पुत्र हितैषिणी ।\nपादमूले वसिष्यामि महर्षेर्भावितात्मनः \t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2111537, "chapter_id": 3411, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2111538, "chapter_id": 3411, "verse_number": "६०", "content_sanskrit": "एवमुक्त्वा तु रुदती पपात मुनिपादयोः ।\nएवं विलपतीं कण्वश्चानुनीय च हेतुभिः ।\nपुनः प्रोवाच भगवानानृशंस्याद्धितं वचः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2111539, "chapter_id": 3411, "verse_number": "", "content_sanskrit": "कण्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2111540, "chapter_id": 3411, "verse_number": "६१", "content_sanskrit": "शकुन्तले शृणुष्वेदं हितं तथ्यं च भामिनि ।\nपतिव्रताभावगुणान् हित्वा साध्यं न किंचन\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2111541, "chapter_id": 3411, "verse_number": "६२", "content_sanskrit": "पतिव्रतानां देवा वै तुष्टाः सर्ववरप्रदाः ।\nप्रसादं च करिष्यन्ति ह्यापदो मोचयन्ति च\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2111542, "chapter_id": 3411, "verse_number": "६३", "content_sanskrit": "पतिप्रसादात् पुण्यगतिं प्राप्नुवन्ति न चाशुभम् ।\nतस्माद् गत्वा तु राजानमाराधय शुचिस्मिते\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2111543, "chapter_id": 3411, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2111544, "chapter_id": 3411, "verse_number": "६४", "content_sanskrit": "शकुन्तलां तथोक्त्वा वै शाकुन्तलमथाब्रवीत् ।\nदौहित्रो मम पौत्रस्त्वमिलिलस्य महात्मनः \t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2111545, "chapter_id": 3411, "verse_number": "६५", "content_sanskrit": "शृणुष्व वचनं सत्यं प्रब्रवीमि तवानघ ।\nमनसा भर्तृकामा वै वाग्भिरुक्त्वा पृथग्विधम् \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2111546, "chapter_id": 3411, "verse_number": "६६", "content_sanskrit": "गन्तुं नेच्छति कल्याणी तस्मात् तात वहस्व वै ।\nशक्तस्त्वं सह गन्तुं च मुनिभिः सह पौरव\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2111547, "chapter_id": 3411, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2111548, "chapter_id": 3411, "verse_number": "६७", "content_sanskrit": "इत्युक्त्वा सर्वदमनं कण्वः शिष्यानथाब्रवीत् ।\nशकुन्तलामिमां शीघ्रं सपुत्रामाश्रमादितः \t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2111549, "chapter_id": 3411, "verse_number": "६८", "content_sanskrit": "भर्तुः प्रापयतागारं सर्वलक्षणपूजितम् ।\nनारीणां चिरवासो हि बान्धवेषु न रोचते ।\nकीर्तिचारित्रपुण्यघ्नं तस्मान्नयत माचिरम् \t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2111550, "chapter_id": 3411, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2111551, "chapter_id": 3411, "verse_number": "६९", "content_sanskrit": "धर्माभिपूजनं पुत्रं काश्यपेन निशाम्य तु ।\nकाश्यपात् प्राप्य चानुज्ञां मुमुदे च शकुन्तला\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2111552, "chapter_id": 3411, "verse_number": "७०", "content_sanskrit": "कण्वस्य वचनं श्रुत्वा प्रतिगच्छेति चासकृत् ।\nतथेत्युक्त्वा तु कण्वं च मातरं पौरवोऽब्रवीत् \t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2111553, "chapter_id": 3411, "verse_number": "७१", "content_sanskrit": "किं चिरायसि भद्रे त्वं गमिष्यावो नृपालयम् ।\nएवमुक्त्वा तु तां देवीं दुष्षन्तस्य महात्मनः \t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2111554, "chapter_id": 3411, "verse_number": "७२", "content_sanskrit": "अभिवाद्य मुनेः पादौ गन्तुमैच्छत् स पौरवः ।\nशकुन्तला च पितरमभिवाद्य कृताञ्जलिः \t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2111555, "chapter_id": 3411, "verse_number": "७३", "content_sanskrit": "प्रदक्षिणीकृत्य तदा पितरं वाक्यमब्रवीत् ।\nअज्ञानान्मे पिता चेति यदुक्तं वापि चानृतम् \t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2111556, "chapter_id": 3411, "verse_number": "७४", "content_sanskrit": "अकार्यं वाप्यनिष्टं वा क्षन्तुमर्हसि काश्यप ।\nएवमुक्तो नतशिरा मुनिर्नोवाच किञ्चन \t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2111557, "chapter_id": 3411, "verse_number": "७५", "content_sanskrit": "मनुष्यभावात् कण्वोऽपि मुनिरश्रूण्यवर्तयत् ।\nअब्भक्षान् वायुभक्षांश्च शीर्णपर्णाशनान् मुनीन्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2111558, "chapter_id": 3411, "verse_number": "७६", "content_sanskrit": "फलमूलाशिनो दान्तान् वल्कलाजिनवाससः ।\nसमाहूय मुनीन् कण्वः कारुण्याद् वाक्यमब्रवीत्\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2111559, "chapter_id": 3411, "verse_number": "७७", "content_sanskrit": "मया तु लालिता नित्यं मम पुत्री यशस्विनी ।\nवने जाता विवृद्धा च न च जानाति किंचन \t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2111560, "chapter_id": 3411, "verse_number": "७८", "content_sanskrit": "अश्रमेण पथा सर्वैर्नीयतां क्षत्रियालयम् ।\nद्वतीययोजने विप्राः प्रतिष्ठानं प्रतिष्ठितम् \t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2111561, "chapter_id": 3411, "verse_number": "७९", "content_sanskrit": "प्रतिष्ठाने पुरे राजा शाकुन्तलपितामहः ।\nअध्युवास चिरं कालमुर्वश्या सहितः पुरा\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2111562, "chapter_id": 3411, "verse_number": "८०", "content_sanskrit": "अनूपजाङ्गलयुतं धनधान्यसमाकुलम् ।\nप्रतिष्ठितं पुरवरं गङ्गायमुनसङ्गमे \t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2111563, "chapter_id": 3411, "verse_number": "८१", "content_sanskrit": "तत्र सङ्गममासाद्य स्नात्वा हुतहुताशनाः ।\nशाकमूलफलाहारा निवर्तध्वं तपोधनाः ।\nअन्यथा तु भवेद् विप्रा अध्वनो गमने श्रमः\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2111564, "chapter_id": 3411, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2111565, "chapter_id": 3411, "verse_number": "८४", "content_sanskrit": "तथेत्युक्त्वा च ते शिष्याः प्रातिष्ठन्नमितौजसः ।\nशकुन्तलां पुरस्कृत्य दुष्षन्तनगरं प्रति\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2111566, "chapter_id": 3411, "verse_number": "८५", "content_sanskrit": "गृहित्वा चामरप्रख्यं पुत्रं कमललोचनम् ।\nआजग्मुश्च पुरं शुभ्रं दुष्षन्ताध्युषितं वनात् \t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2111567, "chapter_id": 3411, "verse_number": "८६", "content_sanskrit": "शकुन्तलां समादाय मुनयो धर्मवत्सलाः ।\nते वनानि नदीः शैलान् गिरिप्रस्रवणानि च \t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2111568, "chapter_id": 3411, "verse_number": "८७", "content_sanskrit": "कन्दराणि नितम्बांश्च राष्ट्राणि नगराणि च ।\nआश्रमाणि च पुण्यानि गत्वा चैव गतश्रमाः\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2111569, "chapter_id": 3411, "verse_number": "८८", "content_sanskrit": "शनैर्मध्याह्नवेलायां प्रतिष्ठानं समागताः ।\nतां पुरीं पुरुहूतेन ह्यैलस्यार्थे विनिर्मिताम् \t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2111570, "chapter_id": 3411, "verse_number": "८९", "content_sanskrit": "परिघावप्रपुरगैरुपतल्पश्तैरपि ।\nशतघ्नीभिश्चक्रयन्त्रैः गुप्तामन्यैर्दुरासदाम् \t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2111571, "chapter_id": 3411, "verse_number": "९०", "content_sanskrit": "हर्म्यप्रासादसम्बाधां नानापण्यविभूषिताम् ।\nमण्टपैः ससभै रम्यैः प्रपाभिश्च समावृताम् \t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2111572, "chapter_id": 3411, "verse_number": "९१", "content_sanskrit": "राजमार्गेण महता सुविभक्तेन शोभिताम् ।\nकैलासशिखराकारैर्गोपुरैः समलङ्कृताम् \t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2111573, "chapter_id": 3411, "verse_number": "९२", "content_sanskrit": "द्वारतोरणनिर्व्यूहैर्मङ्गलैरुपशोभिताम् ।\nउद्यानाम्रवणोपेतां महतीं सालमेखलाम् \t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2111574, "chapter_id": 3411, "verse_number": "९३", "content_sanskrit": "सर्वतः पुष्करिण्यैश्च उद्यानैरुपशोभिताम् ।\nवर्णाश्रमैः स्वधर्मस्थैर्नित्योत्सवसमाहितैः \t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2111575, "chapter_id": 3411, "verse_number": "९४", "content_sanskrit": "धनधान्यसमृद्धैश्च सन्तुष्टै रत्नपूजितैः ।\nक्रतुयुक्तैश्च विद्वद्भिरग्निहोत्रपरैः सदा\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2111576, "chapter_id": 3411, "verse_number": "९५", "content_sanskrit": "अकार्यवर्जितैश्चैव दानशीलैर्दयापरैः ।\nअधर्मभीरुभिः पूर्णामिन्द्रस्येवामरावतीम्\t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2111577, "chapter_id": 3411, "verse_number": "९६", "content_sanskrit": "तस्मिन् नगरमध्ये तु राजवेश्म प्रतिष्ठितम् ।\nइन्द्रसद्मप्रतीकाशं सम्पूर्णं वित्तसंचयैः\t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2111578, "chapter_id": 3411, "verse_number": "९७", "content_sanskrit": "तस्य मध्ये सभा दिव्या नानारत्नविभूषिता ।\nतस्यां सभायां राजर्षिः सर्वालङ्कारभूषितः\t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2111579, "chapter_id": 3411, "verse_number": "९८", "content_sanskrit": "ब्राह्मणैः क्षत्रियैर्वैश्यैर्मन्त्रिभिश्चापि संवृतः ।\nकार्यार्थिभिः समभ्येत्य कृत्वा कार्यं गतेषु सः \t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2111580, "chapter_id": 3411, "verse_number": "९९", "content_sanskrit": "संस्तूयमानो राजेन्द्रः सूतमागधवन्दिभिः ।\nसुखासीनोऽभवद् राजा तस्मिन् काले महर्षयः\t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2111581, "chapter_id": 3411, "verse_number": "१००", "content_sanskrit": "शकुन्तानां स्वनं श्रुत्वा निमित्तज्ञा महर्षयः ।\nशकुन्तलामिदं प्रीता हर्षयन्तोऽब्रुवन् वचः \t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2111582, "chapter_id": 3411, "verse_number": "१०१", "content_sanskrit": "शकुन्तले निमित्तानि शोभनानि भवन्ति नः ।\nकार्यसिद्धिं वदन्त्यद्य ध्रुवं राज्ञी भविष्यसि ।\nअस्मिन्नेव दिने पुत्रो युवराजो भविष्यति\t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2111583, "chapter_id": 3411, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2111584, "chapter_id": 3411, "verse_number": "१०२", "content_sanskrit": "उक्त्वैवं राजभवनं तूर्यघोषनिनादितम् ।\nशकुन्तलां पुरस्कृत्य विविशुस्ते महर्षयः \t॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2111585, "chapter_id": 3411, "verse_number": "१०३", "content_sanskrit": "प्रविशन्तं नृपसुतं प्रशशंसुश्च प्रेक्षकाः ।\nवर्धमानपुरद्वारं प्रविशन्नेव पौरवः \t॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2111586, "chapter_id": 3411, "verse_number": "१०४", "content_sanskrit": "इन्द्रलोकस्थमात्मानं मेने हर्षसमन्वितः ।\nततो वै नागराः सर्वे समाहूय परस्परम् ।\nद्रष्टुकामा नृपसुतं समपद्यन्त भारत\t॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2111587, "chapter_id": 3411, "verse_number": "", "content_sanskrit": "नागराः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2111588, "chapter_id": 3411, "verse_number": "१०५", "content_sanskrit": "देवतेव जनस्याग्रे भ्राजते श्रीरिवापरा ।\nजयन्तेनेव पौलोमी इन्द्रलोकादिहागता\t॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2111589, "chapter_id": 3411, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2111590, "chapter_id": 3411, "verse_number": "समाप्तिः", "content_sanskrit": "इति ब्रुवन्तस्ते सर्वे महर्षीनिदमब्रुवन् ।\nअद्य नः सफलं जन्म कृतार्थाश्च कृता वयम्\t॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2111591, "chapter_id": 3411, "verse_number": "१०७", "content_sanskrit": "ये स्वनेत्रैः प्रपश्यामो महर्षीन् सूर्यवर्चसः ।\nअभिवादयाम सहिता महर्षीन् देववर्चसः\t॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2111592, "chapter_id": 3411, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2111593, "chapter_id": 3411, "verse_number": "१०८", "content_sanskrit": "इत्युक्त्वा सहिताः केचिदन्वगच्छन्त पौरवम् ।\nहैमवत्याः सुतमिव कुमारं पुष्करेक्षणम् \t॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2111594, "chapter_id": 3411, "verse_number": "१०९", "content_sanskrit": "ये केचिदब्रुवन् मूढाः शाकुन्तलदिदृक्षवः ।\nकृष्णाजिनेन सञ्छन्नान् द्रष्टुं नेच्छन्ति तापसान्\t॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2111595, "chapter_id": 3411, "verse_number": "११०", "content_sanskrit": "पिशाचा इव दृश्यन्ते नागराणां विरूपिणः ।\nविना सन्ध्यां पिशाचास्ते प्रविशन्ति पुरोत्तमम् \t॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2111596, "chapter_id": 3411, "verse_number": "१११", "content_sanskrit": "क्षुत्पिपासार्दिंतान् क्षान्तान् वल्कलाजिनवाससः ।\nत्वगस्थिभूतान् निर्मांसान् धमनीसन्ततानपि\t॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2111597, "chapter_id": 3411, "verse_number": "११२", "content_sanskrit": "पिङ्गलाक्षान् पिङ्गजटान् दीर्घदन्तान् निरूदरान् ।\nविशीर्षकानूर्ध्वहस्तान् दृष्ट्वा हास्यन्ति नागराः\t॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2111598, "chapter_id": 3411, "verse_number": "११३", "content_sanskrit": "एवं कथयतां तेषां गिरं श्रुत्वा महर्षयः ।\nअन्योन्यं ते समाहूय इदं वचनमब्रुवन् \t॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2111599, "chapter_id": 3411, "verse_number": "११४", "content_sanskrit": "उक्तं भगवता पूर्वं न कृतं सत्यवादिना ।\nनगरं न प्रवेष्टव्यं भवद्भिरिति शासनम् \t॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2111600, "chapter_id": 3411, "verse_number": "११५", "content_sanskrit": "किङ्कारणं प्रवेक्ष्यामो नगरं दुर्जनैर्वृतम् ।\nत्यक्तसङ्गस्य च मुनेर्नगरे किं प्रयोजनम् \t॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2111601, "chapter_id": 3411, "verse_number": "११६", "content_sanskrit": "तस्माद् गमिष्याम वयं गङ्गायमुनसङ्गमम् ।\nएवमुक्त्वा मुनिगणाः प्रतिजग्मुर्यथागतम् \t॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2111602, "chapter_id": 3411, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nनवतितमोऽध्यायः ॥९०॥ ॥ इति सम्भवपर्वणि अष्टत्रिंशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2111603, "chapter_id": 3411, "verse_number": "", "content_sanskrit": "* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}]