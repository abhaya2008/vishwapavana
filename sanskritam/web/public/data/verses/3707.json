[{"id": 2126370, "chapter_id": 3707, "verse_number": "", "content_sanskrit": "बृहदश्व", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2126371, "chapter_id": 3707, "verse_number": "१", "content_sanskrit": "अथ काले शुभे प्राप्ते तिथौ पुण्ये क्षणे तथा ।\nआजुहाव महीपालान् भीमो राजा स्वयंवरे \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2126372, "chapter_id": 3707, "verse_number": "२", "content_sanskrit": "तच्छ्रुत्वा पृथिवीपालाः सर्वे हृच्छयपीडिताः ।\nत्वरिताः समुपाजग्मुर्दमयन्तीमभीप्सवः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2126373, "chapter_id": 3707, "verse_number": "३", "content_sanskrit": "कनकस्तम्भरुचिरं तोरणेन विराजितम् ।\nविविशुस्ते महारङ्गं नृपाः सिंहा इवाचलम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2126374, "chapter_id": 3707, "verse_number": "४", "content_sanskrit": "तत्रासनेषु विविधेष्वासीनाः पृथिवीक्षितः ।\nसुरभिस्रग्धराः सर्वे प्रमृष्टमणिकुण्डलाः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2126375, "chapter_id": 3707, "verse_number": "५", "content_sanskrit": "तां राजसमितिं पूर्णां नागैर्भोगवतीमिव ।\nसम्पूर्णामृषभस्कन्धैर्व्याघ्रैर्गिरिगुहामिव\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2126376, "chapter_id": 3707, "verse_number": "६", "content_sanskrit": "तत्र स्म पीना दृश्यन्ते बाहवः परिघोपमाः ।\nआकारवर्णसुश्लक्ष्णाः पञ्चशीर्षा इवोरगाः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2126377, "chapter_id": 3707, "verse_number": "७", "content_sanskrit": "सुकेशान्तानि चारूणि सुनासानि शुभानि च ।\nमुखानि राज्ञां शोभन्ते नक्षत्राणि यथा दिवि\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2126378, "chapter_id": 3707, "verse_number": "८", "content_sanskrit": "दमयन्ती ततो रङ्गं प्रविवेश शुभानना ।\nमुष्णन्ती प्रभया राज्ञां चक्षूंषि च मनांसि च\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2126379, "chapter_id": 3707, "verse_number": "९", "content_sanskrit": "तस्या गात्रेषु पतिता तेषां दृष्टिर्महात्मनाम् ।\nतत्र तत्रैव सक्ताऽभून् न चचाल च पश्यताम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2126380, "chapter_id": 3707, "verse_number": "१०", "content_sanskrit": "ततः सङ्कीर्त्यमानेषु राज्ञां नामसु भारत ।\nददर्श भैमी पुरुषान् पञ्च तुल्याकृतीनिह\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2126381, "chapter_id": 3707, "verse_number": "११", "content_sanskrit": "तान् संलक्ष्य ततः सर्वान् निर्विशेषाकृतीनिव ।\nसन्देहादथ वैदर्भी नाभ्यजानान्नळं नृपम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2126382, "chapter_id": 3707, "verse_number": "१२", "content_sanskrit": "निर्विशेषवयोरूपान् निर्विशेषान् शुभानना ।\nयं यं हि ददृशे तेषां तं तं मेने नळं नृपम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2126383, "chapter_id": 3707, "verse_number": "१३", "content_sanskrit": "सा चिन्तयन्ती बुद्ध्याऽथ तर्कयामास भामिनी ।\nकथं नु देवान् जानीयां कथं विद्यामहं नळम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2126384, "chapter_id": 3707, "verse_number": "१४", "content_sanskrit": "एवं सञ्चिन्तयन्ती सा वैदर्भी भृशदुःखिता ।\nश्रुतानि देवलिङ्गानि चिन्तयामास भारत\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2126385, "chapter_id": 3707, "verse_number": "१५", "content_sanskrit": "देवानां यानि लिङ्गानि स्थविरेभ्यः श्रुतानि मे ।\nतानीह तिष्ठतां भूमावेकस्यापि न लक्षये \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2126386, "chapter_id": 3707, "verse_number": "१६", "content_sanskrit": "एवं विचिन्त्य बहुधा विचार्य च पुनः पुनः ।\nशरणं प्रति देवानां प्राप्तकालममन्यत \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2126387, "chapter_id": 3707, "verse_number": "१७", "content_sanskrit": "वाचा च मनसा चैव नमस्कारं प्रयुज्य सा ।\nदेवेभ्यः प्राञ्जलिर्भूत्वा वेपमानेदमब्रवीत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2126388, "chapter_id": 3707, "verse_number": "१८", "content_sanskrit": "हंसानां वचनं श्रुत्वा यथा मे नैषधो वृतः ।\nपतित्वे तेन सत्येन देवास्तं प्रदिशन्तु मे\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2126389, "chapter_id": 3707, "verse_number": "१९", "content_sanskrit": "मनसा वचसा चैव यथा नातिचराम्यहम् ।\nतेन सत्येन विबुधास्तमेव प्रदिशन्तु मे\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2126390, "chapter_id": 3707, "verse_number": "२०", "content_sanskrit": "यथा देवैः स मे भर्ता विहितो निषधाधिपः ।\nतेन सत्येन मे देवास्तमेव प्रदिशन्तु मे\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2126391, "chapter_id": 3707, "verse_number": "२१", "content_sanskrit": "स्वं चैव रूपं पुष्यन्तु लोकपाला महेश्वराः ।\nयथाऽहमभिजानीयां पुण्यश्लोकं नराधिपम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2126392, "chapter_id": 3707, "verse_number": "", "content_sanskrit": "बृहदश्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2126393, "chapter_id": 3707, "verse_number": "२२", "content_sanskrit": "निशम्य दमयन्त्यास्तत् करुणं परिदेवितम् ।\nनिश्चयं परमं तस्या अनुरागं च नैषधे\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2126394, "chapter_id": 3707, "verse_number": "२३", "content_sanskrit": "मनो विशुद्धां बुद्धिं च भक्तिं रागं च भारत ।\nयथोक्तं चक्रिरे देवाः समस्तं लिङ्गधारणम् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2126395, "chapter_id": 3707, "verse_number": "२४", "content_sanskrit": "साऽपश्यद् विबुधान् सर्वानस्वेदान् स्तब्धलोचनान् ।\nहृषितस्रग्रजोहीनान् स्थितानस्पृशतः क्षितिम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2126396, "chapter_id": 3707, "verse_number": "२५", "content_sanskrit": "छायाद्वितीयो म्लानस्रग्रजस्स्वेदसमन्वितः ।\nभूमिष्ठो नैषधश्चैव निमेषेणैव सूचितः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2126397, "chapter_id": 3707, "verse_number": "२६", "content_sanskrit": "सा समीक्ष्य ततो देवान् पुण्यश्लोकं च भामिनी ।\nनैषधं वरयामास भैमी धर्मेण भारत\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2126398, "chapter_id": 3707, "verse_number": "२७", "content_sanskrit": "विलज्जमाना वस्त्रान्ते जग्राहायतलोचना ।\nस्कन्धदेशे स्रजं चास्य निक्षिप्य वरवर्णिनी \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2126399, "chapter_id": 3707, "verse_number": "२८", "content_sanskrit": "वरयामास चैवैनं पतित्वे वरवर्णिनी ।\nततो हाहेति सञ्जज्ञे शब्दो मुक्तो नराधिपैः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2126400, "chapter_id": 3707, "verse_number": "२९", "content_sanskrit": "देवैर्महर्षिभिश्चैव साधुसाध्विति भारत ।\nविस्मितैरीरितः शब्दः प्रशंसद्भिर्नळं नृपम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2126401, "chapter_id": 3707, "verse_number": "३०", "content_sanskrit": "वृते तु नैषधे भैम्या लोकपाला महौजसः ।\nप्रहृष्टमनसः सर्वे नळायाष्टौ वरान् ददुः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2126402, "chapter_id": 3707, "verse_number": "३१", "content_sanskrit": "प्रत्यक्षदर्शनं यज्ञे गतिं चानुत्तमां शुभाम् ।\nनैषधाय ददौ शक्रः प्रीयमाणः शचीपतिः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2126403, "chapter_id": 3707, "verse_number": "३२", "content_sanskrit": "अग्निरात्मभवं प्रादाद् यत्र वाञ्छति नैषधः ।\nलोकानत्मभवांश्चैव ददौ तस्मै हुताशनः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2126404, "chapter_id": 3707, "verse_number": "३३", "content_sanskrit": "यमस्त्वन्नरसं प्रादाद् धर्मे च परमां स्थितिम् ।\nअपाम्पतिरपां भावं यत्र वाञ्छति नैषधः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2126405, "chapter_id": 3707, "verse_number": "३४", "content_sanskrit": "स्रजश्चोत्तमगन्धाढ्याः सर्वे च मिथुनं ददुः ।\nवरानेवं प्रदायास्य देवास्ते त्रिदिवं ययुः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2126406, "chapter_id": 3707, "verse_number": "३५", "content_sanskrit": "एतत् सर्वं नळोऽपश्यद् दमयन्ती च भारत ।\nयथा स्वप्नं महाराज तथैव ददृशुर्जनाः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2126407, "chapter_id": 3707, "verse_number": "३६", "content_sanskrit": "ततः स्वयंवरे चक्रे भीमो राजाऽतिमानुषम् ।\nसमागतेषु सर्वेषु भूपालेषु विशांपते \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2126408, "chapter_id": 3707, "verse_number": "३७", "content_sanskrit": "दमयन्त्यपि तत्रैषा राजमण्डलमृद्धिमत् ।\nअन्वीक्ष्य नैषधं वव्रे भैमी धर्मेण भारत\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2126409, "chapter_id": 3707, "verse_number": "३८", "content_sanskrit": "वृते च नैषधे भैम्या निवृत्ते च स्वयंवरे ।\nसर्व एव महीपालाः प्रतिजग्मुर्यथागतम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2126410, "chapter_id": 3707, "verse_number": "३९", "content_sanskrit": "गतेषु पार्थिवेन्द्रेषु भीमः प्रीतो महामनाः ।\nविवाहं कारयामास दमयन्त्या नळस्य च\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2126411, "chapter_id": 3707, "verse_number": "४०", "content_sanskrit": "अवाप्य नारीरत्नं तु पुण्यश्लोकोऽपि पार्थिवः ।\nरेमे सह तया राजन् शच्येव बलवृत्रहा\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2126412, "chapter_id": 3707, "verse_number": "४१", "content_sanskrit": "अतीव मुदितो राजा भ्राजमानोंऽशुमानिव ।\nरञ्जयन् वसुधां वीरो धर्मेण परिपालयन्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2126413, "chapter_id": 3707, "verse_number": "४२", "content_sanskrit": "ईजे चाप्यश्वमेधेन ययातिरिव नाहुषः ।\nअन्यैश्च बहुभिः श्रीमान् क्रतुभिश्चाप्तदक्षिणैः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2126414, "chapter_id": 3707, "verse_number": "४३", "content_sanskrit": "पुनश्च रमणीयेषु वनेषूपवनेषु च ।\nदमयन्त्या सह नळो विजहारामरोपमः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2126415, "chapter_id": 3707, "verse_number": "४४", "content_sanskrit": "जनयामास च नळो दमयन्त्यां महामनाः ।\nइन्द्रसेनं कुमारञ्च इन्द्रसेनीं कुमारिकाम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2126416, "chapter_id": 3707, "verse_number": "४५", "content_sanskrit": "एवं स यजमानश्च विहरंश्च नराधिपः ।\nररक्ष वसुसम्पूर्णां वसुधां वसुधाधिपः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2126417, "chapter_id": 3707, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nवनपर्वणि एकोनपञ्चाशोऽध्यायः॥४९॥\n॥ तीर्थयात्रापर्वणि पञ्चमोऽध्यायः ॥५॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]