[{"id": 7001491000, "chapter_id": 21491, "verse_number": "७-२-२९-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nभगवंस्त्वन्मुखादेव श्रुतं श्रुतिसमं मया ।\nस्वाश्रितानां शिवप्रोक्तं नित्यनैमित्तिकं तथा॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001491001, "chapter_id": 21491, "verse_number": "७-२-२९-२", "content_sanskrit": "इदानीं श्रोतुमिच्छामि शिवधर्माधिकारिणाम् ।\nकाम्यमप्यस्ति चेत्कर्म वक्तुमर्हसि साम्प्रतम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001491002, "chapter_id": 21491, "verse_number": "७-२-२९-३", "content_sanskrit": "उपमन्युरुवाच ।\nअस्त्यैहिकफलं किञ्चिदामुष्मिकफलं तथा ।\nऐहिकामुष्मिकञ्चापि तच्च पञ्चविधं पुनः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001491003, "chapter_id": 21491, "verse_number": "७-२-२९-४", "content_sanskrit": "किंचित्क्रियामयं कर्म किंचित्कर्म तपो मयम् ।\nजपध्यानमयं किंचित्किंचित्सर्वमयं तथा॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001491004, "chapter_id": 21491, "verse_number": "७-२-२९-५", "content_sanskrit": "क्रियामयं तथा भिन्नं होमदानार्चनक्रमात् ।\nसर्वशक्तिमतामेव नान्येषां सफलं भवेत्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001491005, "chapter_id": 21491, "verse_number": "७-२-२९-६", "content_sanskrit": "शक्तिश्चाज्ञा मदेशस्य शिवस्य परमात्मनः ।\nतस्मात्काम्यानि कर्माणि कुर्यादाज्ञाधरोद्विजः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001491006, "chapter_id": 21491, "verse_number": "७-२-२९-७", "content_sanskrit": "अथ वक्ष्यामि काम्यं हि चेहामुत्र फलप्रदम् ।\nशैवैर्माहेश्वरैश्चैव कार्यमंतर्बहिः क्रमात्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001491007, "chapter_id": 21491, "verse_number": "७-२-२९-८", "content_sanskrit": "शिवो महेश्वरश्चेति नात्यंतमिह भिद्यते ।\nयथा तथा न भिद्यंते शैवा माहेश्वरा अपि॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001491008, "chapter_id": 21491, "verse_number": "७-२-२९-९", "content_sanskrit": "शिवाश्रिता हि ते शैवा ज्ञानयज्ञरता नराः ।\nमाहेश्वरास्समाख्याता कर्मयज्ञरता भुवि॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001491009, "chapter_id": 21491, "verse_number": "७-२-२९-१०", "content_sanskrit": "तस्मादाभ्यन्तरे कुर्युः शैवा माहेश्वरा वहिः ।\nन तु प्रयोगो भिद्येत वक्ष्यमाणस्य कर्मणः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001491010, "chapter_id": 21491, "verse_number": "७-२-२९-११", "content_sanskrit": "परीक्ष्य भूमिं विधिवद्गंधवर्णरसादिभिः ।\nमनोभिलषिते तत्र वितानविततांबरे॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001491011, "chapter_id": 21491, "verse_number": "७-२-२९-१२", "content_sanskrit": "सुप्रलिप्ते महीपृष्ठे दर्पणोदरसंनिभे ।\nप्राचीमुत्पादयेत्पूर्वं शास्त्रदृष्टेन वर्त्मना॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001491012, "chapter_id": 21491, "verse_number": "७-२-२९-१३", "content_sanskrit": "एकहस्तं द्विहस्तं वा मण्डलं परिकल्पयेत् ।\nआलिखेद्विमलं पद्ममष्टपत्रं सकर्णिकम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001491013, "chapter_id": 21491, "verse_number": "७-२-२९-१४", "content_sanskrit": "रत्नहेमादिभिश्चूर्णैर्यथासंभवसंभृतैः ।\nपञ्चावरणसंयुक्तं बहुशोभासमन्वितम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001491014, "chapter_id": 21491, "verse_number": "७-२-२९-१५", "content_sanskrit": "दलेषु सिद्धयः कल्प्याः केसरेषु सशक्तिकाः ।\nरुद्रा वामादयस्त्वष्टौ पूर्वादिदलतः क्रमात्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001491015, "chapter_id": 21491, "verse_number": "७-२-२९-१६", "content_sanskrit": "कर्णिकायां च वैराग्यं बीजेषु नव शक्तयः ।\nस्कन्दे शिवात्मको धर्मो नाले ज्ञानं शिवाश्रयम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001491016, "chapter_id": 21491, "verse_number": "७-२-२९-१७", "content_sanskrit": "कर्णिकोपरि चाग्नेयं मंडलं सौरमैन्दवम् ।\nशिवविद्यात्मतत्त्वाख्यं तत्त्वत्रयमतः परम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001491017, "chapter_id": 21491, "verse_number": "७-२-२९-१८", "content_sanskrit": "सर्वासनोपरि सुखं विचित्रकुसुमान्वितम् ।\nपञ्चावरणसंयुक्तं पूजयेदंबया सह॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001491018, "chapter_id": 21491, "verse_number": "७-२-२९-१९", "content_sanskrit": "शुद्धस्फटिकसंकाशं प्रसन्नं शीतलद्युतिम् ।\nविद्युद्वलयसंकाशजटामुकुटभूषितम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001491019, "chapter_id": 21491, "verse_number": "७-२-२९-२०", "content_sanskrit": "शार्दूलचर्मवसनं किञ्चित्स्मितमुखांबुजम् ।\nरक्तपद्मदलप्रख्यपादपाणितलाधरम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001491020, "chapter_id": 21491, "verse_number": "७-२-२९-२१", "content_sanskrit": "सर्वलक्षणसंपन्नं सर्वाभरणभूषितम् ।\nदिव्यायुधवरैर्युक्तं दिव्यगंधानुलेपनम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001491021, "chapter_id": 21491, "verse_number": "७-२-२९-२२", "content_sanskrit": "पञ्चवक्त्रं दशभुजं चन्द्रखण्डशिखामणिम् ।\nअस्य पूर्वमुखं सौम्यं बालार्कसदृशप्रभम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001491022, "chapter_id": 21491, "verse_number": "७-२-२९-२३", "content_sanskrit": "त्रिलोचनारविंदाढ्यं कृतबालेंदुशेखरम् ।\nदक्षिणं नीलजीमूतसमानरुचिरप्रभम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001491023, "chapter_id": 21491, "verse_number": "७-२-२९-२४", "content_sanskrit": "भ्रुकुटीकुटिलं घोरं रक्तवृत्तेक्षणत्रयम् ।\nदंष्ट्राकरालं दुर्धर्षं स्फुरिताधरपल्लवम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001491024, "chapter_id": 21491, "verse_number": "७-२-२९-२५", "content_sanskrit": "उत्तरं विद्रुमप्रख्यं नीलालकविभूषितम् ।\nसविलासं त्रिनयनं चन्द्राभरणशेखरम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001491025, "chapter_id": 21491, "verse_number": "७-२-२९-२६", "content_sanskrit": "पश्चिमं पूर्णचन्द्राभं लोचनत्रितयोज्ज्वलम् ।\nचन्द्ररेखाधरं सौम्यं मंदस्मितमनोहरम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001491026, "chapter_id": 21491, "verse_number": "७-२-२९-२७", "content_sanskrit": "पञ्चमं स्फटिकप्रख्यमिंदुरेखासमुज्ज्वलम् ।\nअतीव सौम्यमुत्फुल्ललोचनत्रितयोज्ज्वलम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001491027, "chapter_id": 21491, "verse_number": "७-२-२९-२८", "content_sanskrit": "दक्षिणे शूलपरशुवज्रखड्गानलोज्ज्वलम् ।\nसव्ये च नागनाराचघण्टापाशांकुशोज्ज्वलम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001491028, "chapter_id": 21491, "verse_number": "७-२-२९-२९", "content_sanskrit": "निवृत्त्याजानुसंबद्धमानाभेश्च प्रतिष्ठया ।\nआकंठं विद्यया तद्वदाललाटं तु शांतया॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001491029, "chapter_id": 21491, "verse_number": "७-२-२९-३०", "content_sanskrit": "तदूर्ध्वं शांत्यतीताख्यकलया परया तथा ।\nपञ्चाध्वव्यापिनं साक्षात्कलापञ्चकविग्रहम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001491030, "chapter_id": 21491, "verse_number": "७-२-२९-३१", "content_sanskrit": "ईशानमुकुटं देवं पुरुषाख्यं पुरातनम् ।\nअघोरहृदयं तद्वद्वामगुह्यं महेश्वरम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001491031, "chapter_id": 21491, "verse_number": "७-२-२९-३२", "content_sanskrit": "सद्यपादं च तन्मूर्तिमष्टत्रिंशत्कलामयम् ।\nमातृकामयमीशानं पञ्चब्रह्ममयं तथा॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001491032, "chapter_id": 21491, "verse_number": "७-२-२९-३३", "content_sanskrit": "ओंकाराख्यमयं चैव हंसशक्त्या समन्वितम् ।\nतथेच्छात्मिकया शक्त्या समारूढांकमंडलम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001491033, "chapter_id": 21491, "verse_number": "७-२-२९-३४", "content_sanskrit": "ज्ञानाख्यया दक्षिणतो वामतश्च क्रियाख्यया ।\nतत्त्वत्रयमयं साक्षाद्विद्यामूर्तिं सदाशिवम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001491034, "chapter_id": 21491, "verse_number": "७-२-२९-३५", "content_sanskrit": "मूर्तिमूलेन संकल्प्य सकलीकृत्य च क्रमात् ।\nसंपूज्य च यथान्यायमर्घान्तं मूलविद्यया॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001491035, "chapter_id": 21491, "verse_number": "७-२-२९-३६", "content_sanskrit": "मूर्तिमन्तं शिवं साक्षाच्छक्त्या परमया सह ।\nतत्रावाह्य महादेवं सदसद्व्यक्तिवर्जितम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001491036, "chapter_id": 21491, "verse_number": "७-२-२९-३७", "content_sanskrit": "पञ्चोपकरणं कृत्वा पूजयेत्परमेश्वरम् ।\nब्रह्मभिश्च षडङ्गैश्च ततो मातृकया सह॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001491037, "chapter_id": 21491, "verse_number": "७-२-२९-३८", "content_sanskrit": "प्रणवेन शिवेनैव शक्तियुक्तेन च क्रमात् ।\nशांतेन वा तथान्यैश्च वेदमन्त्रैश्च कृत्स्नशः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001491038, "chapter_id": 21491, "verse_number": "७-२-२९-३९", "content_sanskrit": "पूजयेत्परमं देवं केवलेन शिवेन वा ।\nपाद्यादिमुखवासांतं कृत्वा प्रस्थापनं विना॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001491039, "chapter_id": 21491, "verse_number": "७-२-२९-४०", "content_sanskrit": "पञ्चावरणपूजां तु ह्यारभेत यथाक्रमम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]