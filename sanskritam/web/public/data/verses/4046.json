[{"id": 2141122, "chapter_id": 4046, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2141123, "chapter_id": 4046, "verse_number": "१", "content_sanskrit": "तमदूरमुपायान्तं दृष्ट्वा पाण्डवमर्जुनम् ।\nनारयः प्रेक्षितुं शेकुस्तपन्तं हि यथा रविम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2141124, "chapter_id": 4046, "verse_number": "२", "content_sanskrit": "तं दृष्ट्वा तु रथानीकं पार्थः सारथिमब्रवीत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2141125, "chapter_id": 4046, "verse_number": "३", "content_sanskrit": "इषुपातमात्रे सेनायाः स्थापयाश्वानरिन्दम ।\nयावत् समीक्षे सैन्येऽस्मिन् मम शत्रुं सुयोधनम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2141126, "chapter_id": 4046, "verse_number": "४", "content_sanskrit": "रत्नवैडूर्यविकृतं मणिप्रवरभूषितम् ।\nपरिजानाम्यहं तस्य ध्वजं दूरात् समुच्छ्रितम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2141127, "chapter_id": 4046, "verse_number": "५", "content_sanskrit": "यद्येनमिह पश्यामि दुर्बुद्धिमतिमानिनम् ।\nयमाय प्रेषयिष्यामि सहायः स्याद् यदीश्वरः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2141128, "chapter_id": 4046, "verse_number": "६", "content_sanskrit": "सर्वानन्याननादृत्य दृष्ट्वा तमतिमानिनम् ।\nसिंहः क्षुद्रमृगस्येव पतिष्ये तस्य मूर्धनि\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2141129, "chapter_id": 4046, "verse_number": "७", "content_sanskrit": "हनिष्येद्य तदैवाशु शरैर्गाण्डीवनिःसृतैः ।\nतस्मिन् हते भविष्यन्ति सर्व एव पराजिताः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2141130, "chapter_id": 4046, "verse_number": "८", "content_sanskrit": "शरैः समर्पयिष्यामि धार्तराष्ट्रं सुयोधनम् ।\nअसभ्यानां च भर्तारं कुरूणां किल किल्बिषम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2141131, "chapter_id": 4046, "verse_number": "९", "content_sanskrit": "राजानं नेह पश्यामि निरामिषमिदं बलम् ।\nअभिद्रवेऽहं राजानं व्यक्तं तत्र हि निर्भयम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2141132, "chapter_id": 4046, "verse_number": "१०", "content_sanskrit": "आस्थितो मध्यमाचार्यो ह्यश्वत्थामा ह्यनन्तरम् ।\nकृपकर्णौ पुरस्तात् तु महेष्वासौ व्यवस्थितौ\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2141133, "chapter_id": 4046, "verse_number": "११", "content_sanskrit": "भूरिश्रवाः सोमदत्तो बाह्लीकश्च जयद्रथः ।\nदक्षिणं पक्षमाश्रित्य स्थिता युद्धार्थिनः सदा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2141134, "chapter_id": 4046, "verse_number": "१२", "content_sanskrit": "साल्वराजो द्युमत्सेनो वृषसेनश्च सौबलः ।\nदशार्णश्चैव काळिङ्गो वामं पक्षं समाश्रिताः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2141135, "chapter_id": 4046, "verse_number": "१३", "content_sanskrit": "पृष्ठतः कुरुमुख्यस्तु भीष्मस्तिष्ठति दंसितः ।\nसोऽर्धसैन्येन बलवान् सर्वेषां नः पितामहः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2141136, "chapter_id": 4046, "verse_number": "१४", "content_sanskrit": "दुर्योधनं न पश्यामि क्व नु राजा स गच्छति ।\nउत्सृज्यैतद् रथानीकं याहि यत्र सुयोधनः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2141137, "chapter_id": 4046, "verse_number": "१५", "content_sanskrit": "तं हत्वा तु निवर्तिष्ये गाः स आदाय गच्छति ।\nगवाग्रमभितो याहि यत्र राजा भविष्यति\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2141138, "chapter_id": 4046, "verse_number": "१६", "content_sanskrit": "इत्युक्त्वा समरे पार्थो वैराटिमपराजितः ।\nसंस्पृशानो धनुर्दिव्यं त्वरमाणोऽगमत् तदा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2141139, "chapter_id": 4046, "verse_number": "१७", "content_sanskrit": "ततो भीष्मोऽब्रवीद् वाक्यं कुरुमध्ये परन्तपः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2141140, "chapter_id": 4046, "verse_number": "१८", "content_sanskrit": "चिरं दृष्टोऽयमस्माभिर्धर्मज्ञो बान्धवप्रियः ।\nअतीव ज्वलते लक्ष्म्या पाकशासनिरच्युतः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2141141, "chapter_id": 4046, "verse_number": "१९", "content_sanskrit": "एष दुर्योधनं पार्थो मार्गति निकृतीः स्मरन् ।\nसेनापतिं समालोक्य त्वरते ग्रहणेऽस्य च\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2141142, "chapter_id": 4046, "verse_number": "२०", "content_sanskrit": "मृगं सिंह इवादातुमीक्षते पाकशासनिः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2141143, "chapter_id": 4046, "verse_number": "२१", "content_sanskrit": "उत्सृज्य रथवृन्दं तु प्रयातः श्वेतवाहनः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2141144, "chapter_id": 4046, "verse_number": "२२", "content_sanskrit": "नैषोऽन्तरेण राजानं बीभत्सुः स्थातुमर्हति ।\nतस्य पार्ष्णिं ग्रहीष्यामो जवेनाभिप्रयास्यतः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2141145, "chapter_id": 4046, "verse_number": "२३", "content_sanskrit": "न ह्येनमिह सङ्क्रुद्धमेको युद्ध्येत संयुगे ।\nअन्यो देवान्महादेवात् कृष्णाद्वा देवकीसुतात्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2141146, "chapter_id": 4046, "verse_number": "२४", "content_sanskrit": "आचार्याच्च सपुत्राद्वा भारद्वाजान्महारथात्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2141147, "chapter_id": 4046, "verse_number": "२५", "content_sanskrit": "किं नो गावः करिष्यन्ति धनं वा विपुलं तथा ।\nदुर्योधनः पार्थमगात् पुरा प्राणान् विमुञ्चति\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2141148, "chapter_id": 4046, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2141149, "chapter_id": 4046, "verse_number": "२६", "content_sanskrit": "इत्युक्त्वा समरे भीष्मः सेनया सह कौरवः ।\nअन्वधावत् तदा पार्थं धार्तराष्ट्रं हि रक्षितुम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2141150, "chapter_id": 4046, "verse_number": "२७", "content_sanskrit": "त्रिक्रोशमात्रं यात्वा तु पार्थो वैराटिमब्रवीत्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2141151, "chapter_id": 4046, "verse_number": "२८", "content_sanskrit": "इषुपातमात्रे सेनायाः स्थापयाश्वानरिन्दम ।\nएतदग्रं गवां दृष्टं मन्दं वाहय सारथे\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2141152, "chapter_id": 4046, "verse_number": "२९", "content_sanskrit": "याह्युत्तरेण सेनाया गाश्चैव प्रविभज्य च ।\nपरिक्षिप्य गवां यूथमत्र योत्स्ये सुयोधनम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2141153, "chapter_id": 4046, "verse_number": "३०", "content_sanskrit": "गच्छन्ति सत्वरं गावः सगोपाः परिमोचय\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2141154, "chapter_id": 4046, "verse_number": "३१", "content_sanskrit": "तत्र गत्वा पशून् वीर सगोपान् परिमोचय ।\nअन्तरेण च सेनायाः प्राङ्मुखो गच्छ चोत्तर\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2141155, "chapter_id": 4046, "verse_number": "३२", "content_sanskrit": "इमे त्वतिरथाः सर्वे मम वीर्यपराक्रमम् ।\nपश्यन्तु कुरवो युद्धे महेन्द्रस्येव दानवाः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2141156, "chapter_id": 4046, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2141157, "chapter_id": 4046, "verse_number": "३३", "content_sanskrit": "ततः स रथिनां श्रेष्ठो नाम विश्राव्य चात्मनः ।\nनिशिताग्रान् शरांस्तीक्ष्णान् मुमोचान्तकसन्निभान्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2141158, "chapter_id": 4046, "verse_number": "३४", "content_sanskrit": "शलभैरिव चाकाशं धाराभिरिव पर्वतम् ।\nनिरावकाशमभवत् शरैः क्षिप्रं किरीटिना\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2141159, "chapter_id": 4046, "verse_number": "३५", "content_sanskrit": "विदीर्यमाणास्तु शरैस्ते योधाः धार्तराष्ट्रकाः ।\nगाश्चैव हि न पश्यन्ति पार्थमुक्तैरजिह्मगैः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2141160, "chapter_id": 4046, "verse_number": "३६", "content_sanskrit": "सा चापि बहुला सेना पार्थबाणाभिपीडिता ।\nनापश्यद् विवृतां भूमिं नान्तरिक्षं दिशोऽपि वा\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2141161, "chapter_id": 4046, "verse_number": "३७", "content_sanskrit": "गाश्चैव ते न पश्यन्ति पार्थमुक्तैरजिह्मगैः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2141162, "chapter_id": 4046, "verse_number": "३८", "content_sanskrit": "अर्जुनस्तु तदा हृष्टो दर्शयन् वीर्यमात्मनः ।\nपीडयामास सैन्यानि गाण्डीवप्रसृतैः शरैः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2141163, "chapter_id": 4046, "verse_number": "३९", "content_sanskrit": "तेषां नैवाभियाने च नाभियानेऽभवन्मतिः ।\nशीघ्रतामेव पार्थस्य पूजयन्ति स्म विस्मिताः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2141164, "chapter_id": 4046, "verse_number": "४०", "content_sanskrit": "चन्द्रावदातं सामुद्रं कुरुसैन्यभयङ्करम् ।\nततः शङ्खमुपाध्मासीद् द्विषतां रोमहर्षणम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2141165, "chapter_id": 4046, "verse_number": "४१", "content_sanskrit": "विष्फार्य च धनुःश्रेष्ठं ध्वजे भूतान्यचोदयत्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2141166, "chapter_id": 4046, "verse_number": "४२", "content_sanskrit": "ज्याघोषं तळघोषं च कृत्वा भूतान्यमोहयत्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2141167, "chapter_id": 4046, "verse_number": "४३", "content_sanskrit": "तस्य शङ्खस्य शब्देन धनुषो निस्वनेन च ।\nशब्देनामानुषाणां च भूतानां ध्वजवासिनाम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2141168, "chapter_id": 4046, "verse_number": "४४", "content_sanskrit": "वियद्गतानां देवानां राक्षसानां रवेण च ।\nऊर्ध्वं पुच्छं विधून्वाना रेभमाणाः समन्ततः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2141169, "chapter_id": 4046, "verse_number": "४५", "content_sanskrit": "गावः सवत्साः सन्त्रस्ता निवृत्ता दक्षिणां दिशम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2141170, "chapter_id": 4046, "verse_number": "४६", "content_sanskrit": "ततः स समरे शूरो बीभत्सुः शत्रुपूगहा ।\nगोपालांश्चोदयामास गावश्चोदयतेति ह\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2141171, "chapter_id": 4046, "verse_number": "४७", "content_sanskrit": "उत्तरं चाह बीभत्सुर्हर्षयन् पाण्डुनन्दनः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2141172, "chapter_id": 4046, "verse_number": "४८", "content_sanskrit": "गवामग्रं समीक्षस्व गाश्चैवाशु निवर्तय ।\nयावदेते निवर्तन्ते कुरवो जवमास्थिताः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2141173, "chapter_id": 4046, "verse_number": "४९", "content_sanskrit": "याह्युत्तरेण गाश्चैताः सैन्यानां च नृपात्मज ।\nपश्यन्तु कुरवः सर्वे मम वीर्यपराक्रमम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2141174, "chapter_id": 4046, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2141175, "chapter_id": 4046, "verse_number": "५०", "content_sanskrit": "ते लाभमिव मन्वानाः कुरवोऽर्जुनमाहवे ।\nदृष्ट्वा यान्तमदूरस्थं क्षिप्रमभ्यपतन् रथैः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2141176, "chapter_id": 4046, "verse_number": "५१", "content_sanskrit": "हस्त्यश्वपरिवारेण महताऽभिविराजता ।\nयोधैः प्रासासिहस्तैश्च चापबाणोद्यतायुधैः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2141177, "chapter_id": 4046, "verse_number": "५२", "content_sanskrit": "तान्यनीकान्यशोभन्त कुरूणामाततायिनाम् ।\nसंसर्पन्त इवाकाशे विद्युत्वन्तो बलाहकाः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2141178, "chapter_id": 4046, "verse_number": "५३", "content_sanskrit": "तानि दृष्ट्वाऽप्यनीकानि निवृत्तानि महामनाः ।\nपार्थोऽपि वायुवद् घोरं सैन्याग्रं व्यधुनोच्छरैः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2141179, "chapter_id": 4046, "verse_number": "५४", "content_sanskrit": "तां शत्रुसेनां तरसा प्रणुद्य\nगाश्चापि जित्वाऽथ धनुर्धराग्र्यः ।\nदुर्योधनायाभिमुखं प्रयान्तं\nकुरुप्रवीराः सहसाऽभ्यगच्छन्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2141180, "chapter_id": 4046, "verse_number": "५५", "content_sanskrit": "गोषु प्रयातासु जवेन मत्स्याः\nकिरीटिनं प्रीतियुतं च दृष्ट्वा ।\nपशून् समादाय ततो निवृत्ता\nगोपालकाः सम्प्रययुश्च राष्ट्रम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2141181, "chapter_id": 4046, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि चतुःपञ्चाशोऽध्यायः ॥५४॥\nगोग्रहणपर्वणि सप्तविंशोऽध्यायः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]