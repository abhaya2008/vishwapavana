[{"id": 2022838, "chapter_id": 1485, "verse_number": "३-१२३-०x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2022839, "chapter_id": 1485, "verse_number": "३-१२३-१", "content_sanskrit": "भृगोर्महर्षेः पुत्रोऽभूच्चयवनो नाम भारत।\nसमीपे सरसस्तस्य तपस्तेपे महाद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2022840, "chapter_id": 1485, "verse_number": "३-१२३-२", "content_sanskrit": "स्थाणुभूतो महातेजा वीरस्थानेन पाण्डव।\nअतिष्ठत चिरं कालमेकदेशे विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2022841, "chapter_id": 1485, "verse_number": "३-१२३-३", "content_sanskrit": "सवल्मीकोऽभवदृषिर्लताभिरिव संवृतः।\nकालेन महता राजन्समाकीर्णः पिपीलिकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2022842, "chapter_id": 1485, "verse_number": "३-१२३-४", "content_sanskrit": "तथा स संवृतो धीमान्मृत्पिण्ड इव सर्वशः।\nतप्यते स्म तपो घोरं वल्मीकेन समावृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2022843, "chapter_id": 1485, "verse_number": "३-१२३-५", "content_sanskrit": "अथ दीर्घस्य कालस्य शर्यातिर्नाम पार्थिवः।\nआजगाम सरो रम्यं विहर्तुमिदमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2022844, "chapter_id": 1485, "verse_number": "३-१२३-६", "content_sanskrit": "तस्य स्त्रीणां सहस्राणि चत्वार्यासन्परिग्रहः।\nएकैव च सुता सुभ्रूः सुकन्या नाम भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2022845, "chapter_id": 1485, "verse_number": "३-१२३-७", "content_sanskrit": "सा सखीभिः परिवृता दिव्याभरणभूषिता।\nचङ्क्रम्यमाणा वल्मीकं भार्गवस्य समासदत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2022846, "chapter_id": 1485, "verse_number": "३-१२३-८", "content_sanskrit": "सा वै वसुमतीं तत्र पश्यन्ती सुमनोरमाम्।\nवनस्पतीन्प्रचिन्वन्ती विजहार सखीवृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2022847, "chapter_id": 1485, "verse_number": "३-१२३-९", "content_sanskrit": "रूपेण वयसा चैव भदनेन मदेन च।\nबभञ्ज वनवृक्षाणां शाखाः परमपुष्पिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2022848, "chapter_id": 1485, "verse_number": "३-१२३-१०", "content_sanskrit": "तां सखीरहितामेकामेकवस्त्रामलंकृताम्।\nददर्श भार्गवो धमांश्चरन्तीमिव विद्युतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2022849, "chapter_id": 1485, "verse_number": "३-१२३-११", "content_sanskrit": "तां पश्यमानो विजने स रेमे परमद्युतिः।\nक्षामकण्ठश्च विप्रर्षिस्तपोबलसमन्वितः।\nतामाबभाषेकल्याणीं सा चास्य न शृणोति वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2022850, "chapter_id": 1485, "verse_number": "३-१२३-१२", "content_sanskrit": "ततः सुकन्या वल्मीके दृष्ट्वा भार्गवचक्षुषी।\nकौतूहलात्कण्टकेन बुद्धिमोहबलात्कृता।\nकिंनु खल्विदमित्युक्त्वा निर्बिभेदास्य लोचने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2022851, "chapter_id": 1485, "verse_number": "३-१२३-१३", "content_sanskrit": "अक्रुद्ध्यत्स तथा विद्धे नेत्रे परममन्युमान्।\nततः शर्यातिसैन्यस्य शकृन्मूत्रे समावृणोत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2022852, "chapter_id": 1485, "verse_number": "३-१२३-१४", "content_sanskrit": "ततो रुद्धे शकृन्मूत्रे सैन्यमासीत्सुदुःखितम्।\nतथागतमभिप्रेक्ष्य पर्यपृच्छत्स पार्थिवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2022853, "chapter_id": 1485, "verse_number": "३-१२३-१५", "content_sanskrit": "तपोनित्यस्य वृद्धस्य रोषणस्य विशेषतः।\nकेनापकृतमद्येह भार्गवस्य महात्मनः।\nज्ञातं वा यदि वाऽज्ञातं तद्द्रुतं ब्रूत माचिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2022854, "chapter_id": 1485, "verse_number": "३-१२३-१६", "content_sanskrit": "तमूचुः सैनिकाः सर्वे न विद्मोऽपकृतं वयम्।\nसर्वोपायैर्यथाकामं भवांस्तदधिगच्छतु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2022855, "chapter_id": 1485, "verse_number": "३-१२३-१७", "content_sanskrit": "ततः स पृथिवीपालः साम्ना चोग्रेण च स्वयम्।\nपर्यपृच्छत्सुहृद्वर्गं पर्यजानन्न चैव ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2022856, "chapter_id": 1485, "verse_number": "३-१२३-१८", "content_sanskrit": "आनाहार्तं ततो दृष्ट्वा तत्सैन्यमनुखार्दितम्।\nपितरं दुःखितं दृष्ट्वा सुकन्येदमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2022857, "chapter_id": 1485, "verse_number": "३-१२३-१९", "content_sanskrit": "मयाऽटन्त्येह वल्मीके दृष्टं सत्वमभिज्वलत्।\nखद्योतवदभिज्ञातं तन्मया विद्धमन्तिकात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2022858, "chapter_id": 1485, "verse_number": "३-१२३-२०", "content_sanskrit": "एतच्छ्रुत्वा तु वल्मीकं शर्यातिस्तूर्णमभ्ययात्।\nतत्रापशय्त्तपोवृद्धं चन्द्रादित्यसमप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2022859, "chapter_id": 1485, "verse_number": "३-१२३-२१", "content_sanskrit": "अयाचदथ सैन्यार्थं प्राञ्जलिः पृथिवीपतिः।\nअज्ञानाद्बालया यत्ते कृतं तत्क्षन्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2022860, "chapter_id": 1485, "verse_number": "३-१२३-२२", "content_sanskrit": "ततोऽब्रवीन्महीपालं च्यवनो भार्गवस्तदा।\nअपमानादहं विद्धो ह्यनया दर्पपूर्णया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2022861, "chapter_id": 1485, "verse_number": "३-१२३-२३", "content_sanskrit": "रूपौदार्यसमायुक्तां लोभमोहबलात्कृताम्।\nतामेव प्रतिगृह्याहं राजन्दुहितरं तव।\nक्षंस्यामीति महीपाल सत्यमेतद्ब्रवीमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2022862, "chapter_id": 1485, "verse_number": "३-१२३-२४x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2022863, "chapter_id": 1485, "verse_number": "३-१२३-२४", "content_sanskrit": "ऋषेर्वचनमाज्ञाय शर्यातिरविचारयन्।\nददौ दुहितरं तस्मै च्यवनाय महात्मने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2022864, "chapter_id": 1485, "verse_number": "३-१२३-२५", "content_sanskrit": "प्रतिगृह्य च तां कन्यां भगवान्प्रससाद ह।\nप्राप्तप्रसादौ राजा वै ससैन्यः पुरमाव्रजत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2022865, "chapter_id": 1485, "verse_number": "३-१२३-२६", "content_sanskrit": "सुकन्याऽपि पतिं लब्ध्वा तपस्विनमनिन्दिता।\nनित्यं पर्यचरत्प्रीत्या तपसा नियमेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2022866, "chapter_id": 1485, "verse_number": "३-१२३-२७", "content_sanskrit": "अग्नीनामतीथीनां च शुश्रूषुनसूयिका।\nसमाराधयत क्षिप्रं च्यवनं सा शुभानना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2022867, "chapter_id": 1485, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि त्रयोविंशत्यधिकशततमोऽध्यायः ॥ १२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]