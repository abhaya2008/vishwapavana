[{"id": 2141513, "chapter_id": 4052, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2141514, "chapter_id": 4052, "verse_number": "१", "content_sanskrit": "एतस्मिन्नन्तरे तत्र महावीर्यपराक्रमः ।\nआजगाम महावीर्यः कृपः शस्त्रभृतां वरः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2141515, "chapter_id": 4052, "verse_number": "२", "content_sanskrit": "अर्जुनं प्रतियोद्धुं वै युद्धकामी महारथः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2141516, "chapter_id": 4052, "verse_number": "३", "content_sanskrit": "अथ द्रौणे रथं त्यक्त्वा कृपस्य रथमुत्तमम् ।\nआजगामार्जुनस्तूर्णं सूर्यवैश्वानरप्रभम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2141517, "chapter_id": 4052, "verse_number": "४", "content_sanskrit": "तौ वीरौ सूर्यसङ्काशौ योत्स्यमानौ महारथौ ।\nवार्षिकाविव जीमूतौ व्यरोचेतां व्यवस्थितौ\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2141518, "chapter_id": 4052, "verse_number": "५", "content_sanskrit": "प्रगृह्य गाण्डिवं लोके विश्रुतं पुनरर्जुनः ।\nअभ्ययाद् भरतश्रेष्ठो विनिघ्नन् शरमालया\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2141519, "chapter_id": 4052, "verse_number": "६", "content_sanskrit": "कृपश्च धनुरादाय तथैवार्जुनमभ्ययात्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2141520, "chapter_id": 4052, "verse_number": "७", "content_sanskrit": "प्रगृह्य बलवच्चापं नाराचान् रक्तभोजनान् ।\nकृपश्चिक्षेप पार्थाय शतशोऽथ सहस्रशः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2141521, "chapter_id": 4052, "verse_number": "८", "content_sanskrit": "जीमूत इव घर्मान्ते शरवर्षममुञ्चत ।\nनन्दयन् सुहृदः सर्वान् प्रत्ययुध्यत फल्गुनम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2141522, "chapter_id": 4052, "verse_number": "९", "content_sanskrit": "विकृष्य सशरं चापं पाण्डवोऽमितविक्रमः ।\nचचार समरे पार्थः चित्रान् मार्गान् विदर्शयन्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2141523, "chapter_id": 4052, "verse_number": "१०", "content_sanskrit": "सर्वाश्चैव दिशो बाणैः प्रदिशश्च महारथः ।\nएकच्छायामिवाकाशं सर्वतः कृतवान् प्रभुः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2141524, "chapter_id": 4052, "verse_number": "११", "content_sanskrit": "प्राच्छादयदमेयात्मा पार्थः शरशतैः कृपम् ।\nउद्गतः समये मेघो धाराभिरिव पर्वतम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2141525, "chapter_id": 4052, "verse_number": "१२", "content_sanskrit": "स शरैरर्पितः क्रुद्धः शितैरग्निशिखोपमैः ।\nकृपो बभूव समरे विधूमोऽग्निरिव ज्वलन्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2141526, "chapter_id": 4052, "verse_number": "१३", "content_sanskrit": "ततः शरसहस्रेण पार्थमप्रतिमौजसम् ।\nअर्पयित्वा महानादमकरोत् समरे कृपः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2141527, "chapter_id": 4052, "verse_number": "१४", "content_sanskrit": "ततः कनकपुङ्खेन शरेण नतपर्वणा ।\nबिभेद समरे पार्थः कृपस्य ध्वजमुत्तमम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2141528, "chapter_id": 4052, "verse_number": "१५", "content_sanskrit": "ततः पश्चान्महातेजा नाराचान् सूर्यसन्निभान् ।\nजग्राह समरे पार्थो भूयो बहुशिलीमुखान्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2141529, "chapter_id": 4052, "verse_number": "१६", "content_sanskrit": "तैस्तदानीं महाबाहुः कृपस्य रथरक्षिणः ।\nजघान क्षत्रियश्रेष्ठान् युध्यमानान् महारथान्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2141530, "chapter_id": 4052, "verse_number": "१७", "content_sanskrit": "चन्द्रकेतुः सुकेतुश्च चित्राश्वो मणिमांस्तथा ।\nमुञ्जमौलिश्च विक्रान्तो हेमवर्मा महारथः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2141531, "chapter_id": 4052, "verse_number": "१८", "content_sanskrit": "सुरथोऽतिरथश्चैव सुषेणोऽरिष्ट एव च ।\nनृकेतुश्च सहानीकास्ते निपेतुर्गतासवः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2141532, "chapter_id": 4052, "verse_number": "१९", "content_sanskrit": "तान् निहत्य ततः पार्थो निमेषादिव भारत ।\nपुनरन्यान् समादत्त त्रयोदश शिलीमुखान्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2141533, "chapter_id": 4052, "verse_number": "२०", "content_sanskrit": "अथास्य युगमेकेन चतुर्भिश्चतुरो हयान् ।\nषष्ठेन तु शिरः सङ्खे शरेण कृपसारथेः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2141534, "chapter_id": 4052, "verse_number": "२१", "content_sanskrit": "त्रिभिस्त्रिवेणुं बलवान् द्वाभ्यामक्षं महाबलः ।\nद्वादशेन तु भल्लेन कृपस्य सशरं धनुः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2141535, "chapter_id": 4052, "verse_number": "२२", "content_sanskrit": "छित्त्वा वज्रनिकाशेन फल्गुनः प्रहसन्निव ।\nत्रयोदशेनेन्द्रसमः प्रत्यविध्यत् स्तनान्तरे\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2141536, "chapter_id": 4052, "verse_number": "२३", "content_sanskrit": "स छिन्नधन्वा विरथो हताश्वो हतसारथिः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2141537, "chapter_id": 4052, "verse_number": "२४", "content_sanskrit": "अथ शक्तिं परामृश्य सूर्यवैश्वानरप्रभाम् ।\nचिक्षेप सहसा क्रुद्धः पार्थायाद्भुतकर्मणे\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2141538, "chapter_id": 4052, "verse_number": "२५", "content_sanskrit": "तामर्जुनस्तथारूपां शक्तिं हेमपरिष्कृताम् ।\nआपतन्तीं महोल्काभां चिच्छेद दशभिः शरैः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2141539, "chapter_id": 4052, "verse_number": "२६", "content_sanskrit": "साऽपतद् दशधा भूमौ पार्थेन निहता शरैः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2141540, "chapter_id": 4052, "verse_number": "२७", "content_sanskrit": "शक्त्यां तु विनिकृत्तायां विरथः शरपीडितः ।\nगदापाणिरवप्लुत्य रथात् तूर्णममित्रहा\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2141541, "chapter_id": 4052, "verse_number": "२८", "content_sanskrit": "गदां चिक्षेप सहसा पाण्डवायामितौजसे\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2141542, "chapter_id": 4052, "verse_number": "२९", "content_sanskrit": "सा तु मुक्ता गदा गुर्वी कृपेण सुपरिष्कृता ।\nअर्जुनस्य शरैर्नुन्ना प्रतिमार्गं जगाम सा\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2141543, "chapter_id": 4052, "verse_number": "३०", "content_sanskrit": "अथ खड्गं समुद्धृत्य शतचन्द्रं च भानुमत् ।\nइयेष पाण्डवं हन्तुं कृपो लघुपराक्रमः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2141544, "chapter_id": 4052, "verse_number": "३१", "content_sanskrit": "स शरद्वत्सुतस्तूर्णं महाचार्यः सुशिक्षितः ।\nचचार खेचर इव क्रमाच्चर्मासिधृग् भुवि\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2141545, "chapter_id": 4052, "verse_number": "३२", "content_sanskrit": "ततः क्षुराग्रैः कौन्तेयो दशभिः खड्गचर्मणी ।\nनिमेषादिव चिच्छेद तदद्भुतमिवाभवत्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2141546, "chapter_id": 4052, "verse_number": "३३", "content_sanskrit": "विषण्णवदनस्तत्र युद्धादपगतोद्यमः ।\nअश्वत्थाम्नस्तु स रथं कृपः समभिपुप्लुवे\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2141547, "chapter_id": 4052, "verse_number": "३४", "content_sanskrit": "स्वस्रीयस्य महातेजा जग्राह च धनुः पुनः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2141548, "chapter_id": 4052, "verse_number": "३५", "content_sanskrit": "एतस्मिन्नन्तरे क्रुद्धो भीष्मो द्रोणमथाब्रवीत् ।\nदृष्ट्वा कृपं फल्गुनेन पीडितं चोर्जितं च तम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2141549, "chapter_id": 4052, "verse_number": "३६", "content_sanskrit": "एकैकमस्मान् सङ्ग्रामे पराजयति फल्गुनः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2141550, "chapter_id": 4052, "verse_number": "३७", "content_sanskrit": "अहं द्रोणश्च कर्णश्च द्रौर्णिर्गौतम एव च ।\nअन्ये च बहवः शूरा वयं जेष्याम वासविम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2141551, "chapter_id": 4052, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2141552, "chapter_id": 4052, "verse_number": "३८", "content_sanskrit": "समागम्य तु ते सर्वे भीष्मद्रोणमुखा रथाः ।\nअर्जुनं सहिता यत्ताः प्रत्ययुध्यन्त भारत\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2141553, "chapter_id": 4052, "verse_number": "३९", "content_sanskrit": "स सायकमयैर्जालैः सर्वतस्तान् महारथान् ।\nप्राच्छादयच्छरौघैस्तान् नीहार इव पर्वतान्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2141554, "chapter_id": 4052, "verse_number": "४०", "content_sanskrit": "नदद्भिश्च महानागैर्हेषमाणैश्च वाजिभिः ।\nभेरीशङ्खनिनादैश्च स शब्दस्तुमुलोऽभवत्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2141555, "chapter_id": 4052, "verse_number": "४१", "content_sanskrit": "नराश्वकायान् निर्भिद्य लौहानि कवचानि च ।\nछिद्यमानास्ततस्तेन न्यपतन् शतशः क्षितौ\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2141556, "chapter_id": 4052, "verse_number": "४२", "content_sanskrit": "त्वरमाणः शरानस्यन् पाण्डवः स्म प्रकाशते ।\nमध्यन्दिनगतोऽर्चिष्मान् शरदीव दिवकारः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2141557, "chapter_id": 4052, "verse_number": "४३", "content_sanskrit": "अविषँह्य शरान् सर्वे पार्थचापच्युतान् रणे ।\nउदक्प्रयान्ति वित्रस्ता रथेभ्यो रथिनस्तदा\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2141558, "chapter_id": 4052, "verse_number": "४४", "content_sanskrit": "सादिनश्चाश्वपृष्ठेभ्यो भूमौ चापि पदातयः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2141559, "chapter_id": 4052, "verse_number": "४५", "content_sanskrit": "शरैस्तु ताड्यमानानां कवचानां महात्मनाम् ।\nताम्रराजतलोहानां समपद्यन्त राशयः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2141560, "chapter_id": 4052, "verse_number": "४६", "content_sanskrit": "छन्नमायोधनं जज्ञे शरीरैर्गतचेतसाम् ।\nश्रान्त्या गळितशस्त्राणां पततामश्वसादिनाम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2141561, "chapter_id": 4052, "verse_number": "४७", "content_sanskrit": "शून्यान् कुर्वन् रथोपस्थान् मानवैरास्तृणोन्महीम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2141562, "chapter_id": 4052, "verse_number": "४८", "content_sanskrit": "प्रनृत्यन्निव सङ्ग्रामे चापहस्तो धनञ्जयः ।\nशिरांस्यपातयत् सङ्खे क्षत्रियाणां नरर्षभ\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2141563, "chapter_id": 4052, "verse_number": "४९", "content_sanskrit": "श्रुत्वा गाण्डीवनिर्घोषं विष्फूर्जितमिवाशनेः ।\nत्रस्तानि सर्वसैन्यानि व्यचलीयन्त भागशः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2141564, "chapter_id": 4052, "verse_number": "५०", "content_sanskrit": "कुण्डलोष्णीषधारीणि जातरूपस्रजानि च ।\nपतितानि स्म दृश्यन्ते शिरांसि रणमूर्धनि\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2141565, "chapter_id": 4052, "verse_number": "५१", "content_sanskrit": "विशिखोन्मथितैर्गात्रैर्बाहुभिश्च सकार्मुकैः ।\nसहयैर्वारणैश्छिन्नैः प्रच्छन्ना भाति मेदिनी\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2141566, "chapter_id": 4052, "verse_number": "५२", "content_sanskrit": "शिरसां पात्यमानानां समरे निशितैः शरैः ।\nअश्मवृष्टिरिवाकाशाद् अभवद् भरतर्षभ\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2141567, "chapter_id": 4052, "verse_number": "५३", "content_sanskrit": "दर्शयित्वा तथाऽऽत्मानं रौद्रमुग्रपराक्रमः ।\nजघान समरे योधान् शतशोऽथ सहस्रशः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2141568, "chapter_id": 4052, "verse_number": "५४", "content_sanskrit": "तथाऽवरुद्धश्चारण्ये दश वर्षाणि त्रीणि च ।\nक्रोधाग्निमुत्ससर्जाजौ धार्तराष्ट्रेषु पाण्डवः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2141569, "chapter_id": 4052, "verse_number": "५५", "content_sanskrit": "तस्य तद् दहतः सैन्यं दृष्ट्वा चास्य पराक्रमम् ।\nसर्वे शान्तिपरा योधा धार्तराष्ट्रस्य भारत\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2141570, "chapter_id": 4052, "verse_number": "५६", "content_sanskrit": "यथा नलवनं नागः प्रभिन्नः षष्टिहायनः ।\nएवं सर्वानपामृद्नादर्जुनः शस्त्रतेजसा\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2141571, "chapter_id": 4052, "verse_number": "५७", "content_sanskrit": "विद्राव्य पतितं सैन्यं त्रासयित्वा महारथान् ।\nअर्जुनो जयतां श्रेष्ठः पर्यावर्तत भारत\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2141572, "chapter_id": 4052, "verse_number": "५८", "content_sanskrit": "तस्य मार्गान् विचरतो निघ्नतश्च रणाजिरे ।\nप्रावर्तत नदी घोरा शोणितान्त्रतरङ्गिणी\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2141573, "chapter_id": 4052, "verse_number": "५९", "content_sanskrit": "अस्थिशैवालसम्बाधा सङ्ग्रामे पार्थनिर्मिता ।\nशरचापप्लवा घोरा मांसशोणितकर्दमा\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2141574, "chapter_id": 4052, "verse_number": "६०", "content_sanskrit": "करवालविपाठीना चामरोष्णीषफेनिला\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2141575, "chapter_id": 4052, "verse_number": "६१", "content_sanskrit": "अश्वग्रीवामहावर्ता कबन्धजलमानुषा ।\nकाककङ्करुता तीव्रा सारसक्रौञ्चनादिता\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2141576, "chapter_id": 4052, "verse_number": "६२", "content_sanskrit": "सिंहनादमहानादा शङ्खकम्बुकसङ्कुला ।\nवीरोत्तमाङ्गपद्माढ्या शरचापमहानला\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2141577, "chapter_id": 4052, "verse_number": "६३", "content_sanskrit": "पदातिमत्स्यकलुषा गजशीर्षककच्छपा ।\nगोमायुवृकसङ्घुष्टा मांसमज्जास्थिवालुका\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2141578, "chapter_id": 4052, "verse_number": "६४", "content_sanskrit": "प्रावर्तयन्नदीं घोरां पिशाचगणसेविताम्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2141579, "chapter_id": 4052, "verse_number": "६५", "content_sanskrit": "अपारामनवारां च रक्तोदां सर्वतो वृत्ताम् ।\nअभीक्ष्णमकरोत् पार्थो नदीमुत्तमशोणिताम्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2141580, "chapter_id": 4052, "verse_number": "६६", "content_sanskrit": "अस्याददानस्य शरान् सन्धाय च विमुञ्चतः ।\nविकर्षतश्च गाण्डीवं न किञ्चिद् ददृशेऽन्तरम्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2141581, "chapter_id": 4052, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि षष्टितमोऽध्यायः ॥६०॥ गोग्रहणपर्वणि त्रयस्त्रिंशोऽध्यायः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]