[{"id": 2037104, "chapter_id": 1802, "verse_number": "५-४७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2037105, "chapter_id": 1802, "verse_number": "५-४७-१", "content_sanskrit": "एवं सनत्सुजातेन विदुरेण च धीमता।\nसार्धं कथयतो राज्ञः सा व्यतीयय सर्वरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2037106, "chapter_id": 1802, "verse_number": "५-४७-२", "content_sanskrit": "तस्यां रजन्यां व्युष्टायां राजानः सर्व एव ते।\nसभामाविविशुर्हृष्टाःक सूतस्योपदिदृक्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2037107, "chapter_id": 1802, "verse_number": "५-४७-३", "content_sanskrit": "शुश्रूषमाणाः पार्थानां वाचो धर्मार्थसंहिताः ।\nधृतराष्ट्रमुखाः सर्वे ययू राजन्सभां शुभाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2037108, "chapter_id": 1802, "verse_number": "५-४७-४", "content_sanskrit": "सुधावदातां विस्तीर्णां कनकाजिरभूषिताम् ।\nचन्द्रप्रभां सुरुचिरां सिक्तां चिन्दनवारिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2037109, "chapter_id": 1802, "verse_number": "५-४७-५", "content_sanskrit": "रुचिरैरासनैः स्तीर्णां काञ्चनैर्दारवैरपि।\nअश्मसारमयैर्दान्तैःक स्वास्तीर्णैः सोत्तरच्छदैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2037110, "chapter_id": 1802, "verse_number": "५-४७-६", "content_sanskrit": "भीष्मो द्रोणः कृपः शल्यः कृतवर्मा जयद्रथः ।\nअश्वत्थामा विकर्णश्च सोमदत्तश्च बाह्लिकः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2037111, "chapter_id": 1802, "verse_number": "५-४७-७", "content_sanskrit": "विदुरश्च महाप्राज्ञो युयुत्सुश्च महारथः।\nसर्वे च सहिताः शूराः पार्थिवा भरतर्षभ ।\nधृतराष्ट्रं पुरस्कृत्य विविशुस्तां सभां शुभाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2037112, "chapter_id": 1802, "verse_number": "५-४७-८", "content_sanskrit": "दुःशासनश्चित्रसेनः शकुनिश्चापि सौबलः।\nदुर्मुखो दुःसहः कर्ण उलूकोऽथ विविंशतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2037113, "chapter_id": 1802, "verse_number": "५-४७-९", "content_sanskrit": "कुरुराजं पुरस्कृत्य दुर्योधनममर्षणम्।\nविविशुस्तां सभां राजन्सुराः शक्रसदो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2037114, "chapter_id": 1802, "verse_number": "५-४७-१०", "content_sanskrit": "आविशद्भिस्तदा राजञ्शूरैः परिघबाहुभिः ।\nशुशुभे सा सभा रजन्सिंहैरिव गिरेर्गुहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2037115, "chapter_id": 1802, "verse_number": "५-४७-११", "content_sanskrit": "ते प्रविश्य महेष्वासाः सभां सर्वे महौजसः ।\nआसनानि विचित्राणि भेजिरे सूर्यवर्चसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2037116, "chapter_id": 1802, "verse_number": "५-४७-१२", "content_sanskrit": "आसनस्थेषु सर्वेषु तेषु राजसु भारत।\nद्वाःस्थो निवेदयामास सूतपुत्रमुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2037117, "chapter_id": 1802, "verse_number": "५-४७-१३", "content_sanskrit": "अयं सरथ आयाति योऽयासीत्पाण्डवान्प्रति।\nदूतो नस्तूर्णमायाति सैन्धवैः साधुवाहिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2037118, "chapter_id": 1802, "verse_number": "५-४७-१४", "content_sanskrit": "..पेयाय स तु क्षिप्रं रथात्प्रस्कन्द्य कुण्डली।\nप्रविवेश सभां पूर्णां महीपालैर्महात्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2037119, "chapter_id": 1802, "verse_number": "५-४७-१५x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2037120, "chapter_id": 1802, "verse_number": "५-४७-१५", "content_sanskrit": "प्राप्तोऽस्मि पाण्डवान्गत्वा तं विजानीत कौरवाः।\nयथावयः कुरून्सर्वान्प्रतिनन्दन्ति पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2037121, "chapter_id": 1802, "verse_number": "५-४७-१६", "content_sanskrit": "अभिवादयन्ति वृद्धांश्च वयस्यांश्च वयस्यवत्।\nपुनश्चाभ्यवदन्पार्थाः प्रतिपूज्य यथावयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2037122, "chapter_id": 1802, "verse_number": "५-४७-१७", "content_sanskrit": "यथाहं धृतराष्ट्रेण शिष्टः पूर्वमितो गतः।\nअब्रवं पाण्डवान्गत्वा नात्र किञ्चन हापितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2037123, "chapter_id": 1802, "verse_number": "५-४७-१८x", "content_sanskrit": "` धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2037124, "chapter_id": 1802, "verse_number": "५-४७-१८", "content_sanskrit": "पृच्छामि त्वां सञ्जय राजमध्ये\nयदब्रवीद्वाक्यमदीनसत्वः।\nजनार्दनस्तात युधां प्रणेता\nदुरात्मनां जीवितच्छिन्महात्मा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2037125, "chapter_id": 1802, "verse_number": "५-४७-१९x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2037126, "chapter_id": 1802, "verse_number": "५-४७-१९", "content_sanskrit": "आगुल्फेभ्योऽभिसंवीतः प्रयतोऽहं कृताञ्जलिः।\nशुद्धान्तं प्राविशं राजन्नाख्यातो नरसिंहयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2037127, "chapter_id": 1802, "verse_number": "५-४७-२०", "content_sanskrit": "न चाभिमन्युर्न यमौ तं देशमभिजग्मतुः ।\nयत्र कृष्णौ च कृष्णा च सत्यभामा च भामिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2037128, "chapter_id": 1802, "verse_number": "५-४७-२१", "content_sanskrit": "उभौ मध्वासवक्षीबौ वरचन्दनरूषितौ ।\nस्त्रग्विणौ वरवस्त्राङ्गौ वराभरणभूषितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2037129, "chapter_id": 1802, "verse_number": "५-४७-२२", "content_sanskrit": "नैकरत्नविचित्रं च काञ्चनं च वरासनम्।\nनानास्तरणसंस्तीर्णं यत्रासाते नरर्षभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2037130, "chapter_id": 1802, "verse_number": "५-४७-२३", "content_sanskrit": "सत्याङ्कमुपधानं तु कृत्वा शेते जनार्दनः।\nअर्जुनाङ्कगतौ पादौ केशवस्योपलक्षये।\nअर्जुनस्य च कृष्णायाः शुभायाश्चाङ्कगावुभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2037131, "chapter_id": 1802, "verse_number": "५-४७-२४", "content_sanskrit": "काञ्चनं पादपीठं तु पार्थो वै प्रादिशन्मुदा।\nदासीभ्यामाहृतं मह्यं स्पृष्ट्वा भूमावुपाविशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2037132, "chapter_id": 1802, "verse_number": "५-४७-२५", "content_sanskrit": "ऊर्ध्वरेखाङ्कितौ पादौ पार्थस्य शुभलक्षणौ।\nपादपीठादपहृतौ धारयेतां वरस्त्रियौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2037133, "chapter_id": 1802, "verse_number": "५-४७-२६", "content_sanskrit": "न नूनं कल्मषं किञ्चिन्मम कर्मसु विद्यते।\nस्त्रीरत्नाभ्यां समेतौ यन्मिथो मामभ्यभाषताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2037134, "chapter_id": 1802, "verse_number": "५-४७-२७", "content_sanskrit": "विस्मयो मे महानासीदास्त्रं मे बहुसङ्गतम्।\nहृष्टानि चैव रोमाणि दृष्ट्वा तौ सहितावुभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2037135, "chapter_id": 1802, "verse_number": "५-४७-२८", "content_sanskrit": "श्यामौ बृहन्तौ तरुणौ नागाविव समुच्छ्रितौ ।\nएकशय्यागतौ दृष्ट्वा भयं मे महदाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2037136, "chapter_id": 1802, "verse_number": "५-४७-२९", "content_sanskrit": "ततोऽभ्यचिन्तयं तत्र दृष्ट्वा तौ पुरुषर्षभौ ।\nसङ्कल्पो धर्मराजस्य नानवाप्योऽस्ति कश्चन।\nनिदेशगाविमौ यस्य नरनारायणावुभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2037137, "chapter_id": 1802, "verse_number": "५-४७-३०", "content_sanskrit": "सत्कृतश्चान्नपानाभ्यामाच्छन्नो लब्धसत्क्रियः ।\nअञ्जलिं मूर्ध्नि सन्धाय सन्देशं चाभ्यचोदयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2037138, "chapter_id": 1802, "verse_number": "५-४७-३१", "content_sanskrit": "धनुर्धरोचितेनाथ पाणिनैकं सलक्षणम्।\nपादमानाययत्पार्थः केशवस्य यशस्विनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2037139, "chapter_id": 1802, "verse_number": "५-४७-३२", "content_sanskrit": "इन्द्रकेतुरिवोत्थाय दिव्याभरणभूषितः।\nइन्द्रवीर्योपमः कृष्णः संविष्टो माऽभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2037140, "chapter_id": 1802, "verse_number": "५-४७-३३", "content_sanskrit": "स वाचं वदतां श्रेष्ठ आददे वचनक्षमाम्।\nदीपनीं धार्तराष्ट्राणां मृदुपूर्वां सुदारुणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2037141, "chapter_id": 1802, "verse_number": "५-४७-३४", "content_sanskrit": "बहिश्चरस्य प्राणस्य प्रियस्य प्रियकारिणः।\nमतिमान्मतिमास्थाय केशवः सन्दधे वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2037142, "chapter_id": 1802, "verse_number": "५-४७-३५", "content_sanskrit": "वचनं वचनज्ञस्य शिक्षाक्षरसमन्वितम्।\nमनःप्रह्लादनं श्रेष्ठं पश्चाद्धृदयतापनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2037143, "chapter_id": 1802, "verse_number": "५-४७-३६x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2037144, "chapter_id": 1802, "verse_number": "५-४७-३६", "content_sanskrit": "सञ्जयैतद्वचो ब्रूयाः प्राप्य क्षत्रियसंसदम्।\nश्रृण्वतः कुरुवृद्धस्य आचार्यस्य च धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2037145, "chapter_id": 1802, "verse_number": "५-४७-३७", "content_sanskrit": "अर्थांस्त्यजत पार्थेषु सुखमाप्नुत कामजम्।\nप्रियं प्रियेभ्यश्चरत राजा हि त्वरते जये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2037146, "chapter_id": 1802, "verse_number": "५-४७-३८", "content_sanskrit": "यजध्वं विविधैर्यज्ञैर्दक्षिणाश्च प्रयच्छत।\nपुत्रेर्दारैश्च मोदध्वमागतं वो महद्भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2037147, "chapter_id": 1802, "verse_number": "५-४७-३९", "content_sanskrit": "ऋणं प्रवृद्धमिव मे हृदयान्नापसर्पति।\nगोविन्देति यदाक्रन्दत्कृष्णा मां दूरवासिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2037148, "chapter_id": 1802, "verse_number": "५-४७-४०", "content_sanskrit": "तेजोमयं दुराधर्पं बिभ्रता गाण्डिवं धनुः।\nमद्द्वितीयेन पार्थेन वैरं वः प्रत्युपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2037149, "chapter_id": 1802, "verse_number": "५-४७-४१", "content_sanskrit": "कृष्णस्यैतद्वचः श्रुत्वा महन्मे भयमाविशत्।\nतव पुत्रस्य लोभं च वर्धमानं प्रपश्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2037150, "chapter_id": 1802, "verse_number": "५-४७-४२", "content_sanskrit": "सोमेन्द्रसदृशौ वीरौ तौ मन्दो नावबुध्यते।\nभीष्मद्रोणाश्रयाच्चैव कर्णस्य च विकत्थनात् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2037151, "chapter_id": 1802, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि यानसन्धिपर्वणि सप्तचत्वारिंशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]