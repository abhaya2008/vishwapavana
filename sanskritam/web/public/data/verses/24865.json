[{"id": 7004865000, "chapter_id": 24865, "verse_number": "७-१-४८-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेन्महादेवि लिंगं शुक्रप्रतिष्ठितम् ।\nसर्वपापहरं देवि विभूतीश्वरपश्चिमे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004865001, "chapter_id": 24865, "verse_number": "७-१-४८-२", "content_sanskrit": "नातिदूरे स्थितं तत्र स्वयं शुक्रेण निर्मितम् ।\nयत्र संजीवनीं प्राप्तो विद्यां रुद्रप्रभावतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004865002, "chapter_id": 24865, "verse_number": "७-१-४८-३", "content_sanskrit": "संतप्य तु महाघोरं तपोवर्षसहस्रकम् ।\nसंप्रसाद्य विरूपाक्षं योऽवाप ग्रहतां सुधीः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004865003, "chapter_id": 24865, "verse_number": "७-१-४८-४", "content_sanskrit": "ग्रस्तेन शंभुना येन देवकार्यार्थसिद्धये ।\nतत्रोदरगतेनैव तपस्तप्तं सुदुष्करम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004865004, "chapter_id": 24865, "verse_number": "७-१-४८-५", "content_sanskrit": "वर्षाणामयुतं साग्रं तुष्टिं नीतो महेश्वरः ।\nनिष्कासितस्ततः शीघ्रं शुक्र मार्गेण शंभुना ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004865005, "chapter_id": 24865, "verse_number": "७-१-४८-६", "content_sanskrit": "ततः शुक्रेति नामाभूद्भार्गवस्य महात्मनः ।\nतदाराधयते लिंगं यः कृत्वा निश्चलं मनः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004865006, "chapter_id": 24865, "verse_number": "७-१-४८-७", "content_sanskrit": "मृत्युंजयं जपेल्लक्षं स समीहितमाप्नुयात् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004865007, "chapter_id": 24865, "verse_number": "७-१-४८-८", "content_sanskrit": "तं दृष्ट्वा त्वथवा स्पृष्ट्वा जन्मादिमरणान्तकात् ।\nमुच्यते पातकान्मृत्योः प्रसादात्तस्य भामिनि ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004865008, "chapter_id": 24865, "verse_number": "७-१-४८-९", "content_sanskrit": "मृतसंजीवनार्थं यदैश्वर्यमणिमादिकम् ।\nप्राप्नुयान्नात्र संदेहो यस्य भक्तिः सुनिश्चला ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004865009, "chapter_id": 24865, "verse_number": "७-१-४८-१०", "content_sanskrit": "पंचामृतेन संस्नाप्य देवं शुकप्रतिष्ठितम् ।\nसुगन्धपुष्पैः संपूज्य शौक्रीं पीडां स नाप्नुयात् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004865010, "chapter_id": 24865, "verse_number": "७-१-४८-११", "content_sanskrit": "इति सर्वं समासेन माहात्म्यं शुक्रदैवतम् ।\nकथितं तव सुश्रोणि श्रुतं पापभयापहम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004865011, "chapter_id": 24865, "verse_number": "७-१-४८-१२", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभासखण्डे प्रथमे प्रभासक्षेत्रमाहात्म्ये शुक्रेश्वरमाहात्म्यवर्णनंनामाष्टचत्वारिंशोध्यायः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}]