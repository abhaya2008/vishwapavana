[{"id": 7003354000, "chapter_id": 23354, "verse_number": "२-४९-१", "content_sanskrit": "ऋषय ऊचुः    ।\nअघोरेशस्य महात्म्यं भवता कथितं पुरा ।\nपूजां प्रतिष्ठां देवस्य भगवन्वक्तुमर्हसि ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003354001, "chapter_id": 23354, "verse_number": "२-४९-२", "content_sanskrit": "सूत उवाच  ।\nअघोरेणांग युक्तेन विधिवच्च विशेषतः ।\nप्रतिष्ठालिंगविधिना नान्यता मुनिपुंगवाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003354002, "chapter_id": 23354, "verse_number": "२-४९-३", "content_sanskrit": "तथाग्निपूजां वै कुर्याद्यथा पूजा तथैव च ।\nसहस्रं वा तदर्धं वा शतमष्टोत्तरं तु वा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003354003, "chapter_id": 23354, "verse_number": "२-४९-४", "content_sanskrit": "तिलैर्होमः प्रकर्तव्यो दधिमध्वाज्यसंयुतैः ।\nघृतसक्तुमदूनां च सर्वदुःखप्रमार्जनम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003354004, "chapter_id": 23354, "verse_number": "२-४९-५", "content_sanskrit": "व्याधीनां नाशनं चैव तिलहोमस्तु भूतिदः ।\nसहस्रेण महाभूतिः शतेन व्याधिनाशनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003354005, "chapter_id": 23354, "verse_number": "२-४९-६", "content_sanskrit": "सर्वदुःखविनिर्मुक्तो जपेन च न संशयः ।\nअष्टोत्तरशतेनैव त्रिकाले च यथाविधि ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003354006, "chapter_id": 23354, "verse_number": "२-४९-७", "content_sanskrit": "अष्टोत्तरसहस्रेण षण्मासाज्जायते ध्रुवम् ।\nसिद्धयो नैव संदेहो राज्यमंडालिनामपि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003354007, "chapter_id": 23354, "verse_number": "२-४९-८", "content_sanskrit": "सहस्रेण ज्वरो याति क्षीरेण च जुहोति यम् ।\nत्रिकालं मासमेकं तु सहस्रं जुहुयात्पयः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003354008, "chapter_id": 23354, "verse_number": "२-४९-९", "content_sanskrit": "मासेन सिद्ध्यते तस्य महासौभाग्यमुत्तमम् ।\nसिद्ध्यते चाब्दहोमेन क्षौद्राज्यदधिसंयुतम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003354009, "chapter_id": 23354, "verse_number": "२-४९-१०", "content_sanskrit": "यवक्षीराज्यहोमेन जातितंडुलकेन वा ।\nप्रीयेत भगवानीशो ह्यघोरः परमेश्वरः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003354010, "chapter_id": 23354, "verse_number": "२-४९-११", "content_sanskrit": "दध्ना पुष्टिर्नृपाणां च क्षीरहोमेन शांतिकम् ।\nषण्मासं तु घृतं हुत्वा सर्वव्याधिविनाशनम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003354011, "chapter_id": 23354, "verse_number": "२-४९-१२", "content_sanskrit": "राजयक्ष्मा तिलैर्होमान्नश्यते वत्सरेण तु ।\nयवहोमेन चायुष्यं घृतेन च जयस्तदा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003354012, "chapter_id": 23354, "verse_number": "२-४९-१३", "content_sanskrit": "सर्वकुष्ठक्षयार्थं च मधुनाक्तैश्च तंडुलैः ।\nजुहुयादयुतं नित्यं षण्मासान्नियतः सदा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003354013, "chapter_id": 23354, "verse_number": "२-४९-१४", "content_sanskrit": "आज्यंक्षीरं मधुश्चैव मधुरत्रयमुच्यते ।\nसमस्तं तुष्यते तस्य नाशयेद्वै भगंदरम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003354014, "chapter_id": 23354, "verse_number": "२-४९-१५", "content_sanskrit": "केवलं घृतहोमेन सर्वरोगक्षयः स्मृतः ।\nसर्वव्याधि हरं ध्यानं स्थापनं विधिनार्चनम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003354015, "chapter_id": 23354, "verse_number": "२-४९-१६", "content_sanskrit": "एवं संक्षेपतः प्रोक्तमघोरस्य महात्मनः ।\nप्रतिष्ठा यजनं सर्वं नंदिना कथितं पुरा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003354016, "chapter_id": 23354, "verse_number": "२-४९-१७", "content_sanskrit": "ब्रह्मपुत्राय शिष्याय तेन व्यासाय सुव्रताः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003354017, "chapter_id": 23354, "verse_number": "२-४९-१८", "content_sanskrit": "श्रीलींगमहापुराणे उत्तरभागे एकोनपंचाशत्तमोऽध्यायः।। ४९", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]