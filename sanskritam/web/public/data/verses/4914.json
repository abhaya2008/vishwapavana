[{"id": 2184371, "chapter_id": 4914, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2184372, "chapter_id": 4914, "verse_number": "१", "content_sanskrit": "हीने परमके धर्मे सर्वलोकातिलङ्घिनि ।\nसर्वस्मिन् दस्युसाद्भूते पृथिव्यामुपजीवने\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2184373, "chapter_id": 4914, "verse_number": "२", "content_sanskrit": "केनस्वित् ब्राह्मणो जीवेज्जघन्ये काल आगते ।\nअसन्त्यजन् पुत्रपौत्राननुक्रोशात् पितामह\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2184374, "chapter_id": 4914, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2184375, "chapter_id": 4914, "verse_number": "३", "content_sanskrit": "विज्ञानबलमास्थाय जीवितव्यं तथागते ।\nसर्वं साध्वर्थमेवेदमसाध्वर्थं न किञ्चन\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2184376, "chapter_id": 4914, "verse_number": "४", "content_sanskrit": "असाधुभ्यो निरादाय साधुभ्यो यः प्रयच्छति ।\nआत्मानं सङ्क्रमं कृत्वा कृत्स्नधर्मविदेव सः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2184377, "chapter_id": 4914, "verse_number": "५", "content_sanskrit": "आरोपेणात्मना राजन् राज्ये स्थितिमकोपयन् ।\nअदत्तमप्याददीत भ्रातृवित्तं ममेति वा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2184378, "chapter_id": 4914, "verse_number": "६", "content_sanskrit": "विज्ञानबलपूतो यो वर्तते निन्दितेष्वपि ।\nवृत्तविज्ञानवान् धीरः कस्तं किं वक्तुमर्हति\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2184379, "chapter_id": 4914, "verse_number": "७", "content_sanskrit": "येषां बहुकृता बुद्धिर्नैषामन्याभिरोचते ।\nतेजसाभिप्रवर्धन्ते बलवन्तो युधिष्ठिर\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2184380, "chapter_id": 4914, "verse_number": "८", "content_sanskrit": "यदेव प्रकृतं शास्त्र अविशेषेण वर्तते ।\nतदेव मध्याः सेवन्ते मेधावी चाप्यथोत्तरम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2184381, "chapter_id": 4914, "verse_number": "९", "content_sanskrit": "ऋत्विक्पुरोहिताचार्यान् सत्कृतैरभिपूजितान् ।\nन ब्राह्मणान्यातयेत दोषान् प्राप्नोति यातयन्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2184382, "chapter_id": 4914, "verse_number": "१०", "content_sanskrit": "एतत् प्रमाणं लोकस्य चक्षुरेतत् सनातनम् ।\nतत्प्रमाणेनावगाहेत तेन तत् साध्वसाधु वा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2184383, "chapter_id": 4914, "verse_number": "११", "content_sanskrit": "बहूनि ग्रामवास्तव्या रोषाद् ब्रूयुः परस्परम् ।\nन तेषां वचनाद् राजा सत्कुर्याद् यातयेत वा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2184384, "chapter_id": 4914, "verse_number": "१२", "content_sanskrit": "न वाच्यः परिवादो वै न श्रोतव्यः कथञ्चन ।\nकर्णावेव पिधातव्यौ प्रस्थेयं वा ततोऽन्यतः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2184385, "chapter_id": 4914, "verse_number": "१३", "content_sanskrit": "न वै सतां वृत्तमेतत् करिष्यद् योऽपि पैशुनम् ।\nगुणानामेव वक्तारः सन्तः सत्सु युधिष्ठिर\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2184386, "chapter_id": 4914, "verse_number": "१४", "content_sanskrit": "यथा सुमधुरौ दम्यौ सुधां वा साधुवाहिनीम् ।\nधुरमुद्यम्य वहतस्तथा वर्तेत वै नृपः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2184387, "chapter_id": 4914, "verse_number": "१५", "content_sanskrit": "यथा यथास्य वहतः सहायाः स्युस्तथापरे ।\nआचारमेव मन्यन्ते गरीयो धर्मलक्षणम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2184388, "chapter_id": 4914, "verse_number": "१६", "content_sanskrit": "अपरे नैवमिच्छन्ति ये शङ्खलिखितप्रियाः ।\nअर्थे क्षीणेऽथवा लुब्धाः ते ब्रूयुर्वाक्यमीदृशम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2184389, "chapter_id": 4914, "verse_number": "१७", "content_sanskrit": "आर्षमप्यत्र पश्यन्ति विकर्मस्थस्य पातनम् ।\nन चार्षात् सदृशं किञ्चित् प्रमाणं विद्यते क्वचित्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2184390, "chapter_id": 4914, "verse_number": "१८", "content_sanskrit": "देवा अपि विकर्मस्थं यातयन्ति नराधमम् ।\nव्याजेन विन्दन्वित्तं हि धर्मात्तु परिहीयते\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2184391, "chapter_id": 4914, "verse_number": "१९", "content_sanskrit": "सर्वतः सत्कृतः सद्भिर्भूतिप्रभवकारणैः ।\nहृदयेनाभ्यनुज्ञातो यो धर्मस्तस्य वस्यते\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2184392, "chapter_id": 4914, "verse_number": "२०", "content_sanskrit": "यश्चतुर्गुणसम्पन्नो धर्मवेदस्य मर्मवित् ।\nहरेरिव हि धर्मस्य पदं दुःखं गवेषितुम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2184393, "chapter_id": 4914, "verse_number": "२१", "content_sanskrit": "यथा मृगस्य विद्धस्य मृगव्याधः पदं नयेत् ।\nकक्षे रुधिरपातेन तथा धर्मपदं नयेत्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2184394, "chapter_id": 4914, "verse_number": "२२", "content_sanskrit": "एवं सद्भिर्विनीतेन पथा गन्तव्यमच्युत ।\nराजर्षीणां वृत्तमेतदवगच्छ युधिष्ठिर\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2184395, "chapter_id": 4914, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि आपद्धर्मे द्वितीयोऽध्यायः ॥ २ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]