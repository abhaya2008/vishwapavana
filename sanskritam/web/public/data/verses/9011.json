[{"id": 5000011000, "chapter_id": 9011, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे एकादशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000011001, "chapter_id": 9011, "verse_number": "१-११-१", "content_sanskrit": "भूय एव हि राजेन्द्र शृणु मे वचनं हितम् ।\nयथा स देवप्रवरः कथयामास बुद्धिमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000011002, "chapter_id": 9011, "verse_number": "१-११-२", "content_sanskrit": "इक्ष्वाकूणां कुले जातो भविष्यति सुधार्मिकः ।\nनाम्ना दशरथो राजा श्रीमान् सत्यप्रतिश्रवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000011003, "chapter_id": 9011, "verse_number": "१-११-३", "content_sanskrit": "अङ्गराजेन सख्यं च तस्य राज्ञो भविष्यति ।\nकन्या चास्य महाभागा शान्ता नाम भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000011004, "chapter_id": 9011, "verse_number": "१-११-४", "content_sanskrit": "पुत्रस्त्वङ्गस्य राज्ञस्तु रोमपाद इति श्रुतः ।\nतं स राजा दशरथो गमिष्यति महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000011005, "chapter_id": 9011, "verse_number": "१-११-५", "content_sanskrit": "अनपत्योऽस्मि धर्मात्मञ्छान्ताभर्ता मम क्रतुम् ।\nआहरेत त्वयाज्ञप्तः संतानार्थं कुलस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000011006, "chapter_id": 9011, "verse_number": "१-११-६", "content_sanskrit": "श्रुत्वा राज्ञोऽथ तद् वाक्यं मनसा स विचिन्त्य च ।\nप्रदास्यते पुत्रवन्तं शान्ता भर्तारमात्मवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000011007, "chapter_id": 9011, "verse_number": "१-११-७", "content_sanskrit": "प्रतिगृह्य च तं विप्रं स राजा विगतज्वरः ।\nआहरिष्यति तं यज्ञं प्रहृष्टेनान्तरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000011008, "chapter_id": 9011, "verse_number": "१-११-८", "content_sanskrit": "तं च राजा दशरथो यशस्कामः कृताञ्जलिः ।\nऋष्यशृङ्गं द्विजश्रेष्ठं वरयिष्यति धर्मवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000011009, "chapter_id": 9011, "verse_number": "१-११-९", "content_sanskrit": "यज्ञार्थं प्रसवार्थं च स्वर्गार्थं च नरेश्वरः ।\nलभते च स तं कामं द्विजमुख्याद् विशाम्पतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000011010, "chapter_id": 9011, "verse_number": "१-११-१०", "content_sanskrit": "पुत्राश्चास्य भविष्यन्ति चत्वारोऽमितविक्रमाः ।\nवंशप्रतिष्ठानकराः सर्वभूतेषु विश्रुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000011011, "chapter_id": 9011, "verse_number": "१-११-११", "content_sanskrit": "एवं स देवप्रवरः पूर्वं कथितवान् कथाम् ।\nसनत्कुमारो भगवान् पुरा देवयुगे प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000011012, "chapter_id": 9011, "verse_number": "१-११-१२", "content_sanskrit": "स त्वं पुरुषशार्दूल समानय सुसत्कृतम् ।\nस्वयमेव महाराज गत्वा सबलवाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000011013, "chapter_id": 9011, "verse_number": "१-११-१३", "content_sanskrit": "सुमन्त्रस्य वचः श्रुत्वा हृष्टो दशरथोऽभवत् ।\nअनुमान्य वसिष्ठं च सूतवाक्यं निशाम्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000011014, "chapter_id": 9011, "verse_number": "१-११-१४", "content_sanskrit": "सान्तःपुरः सहामात्यः प्रययौ यत्र स द्विजः ।\nवनानि सरितश्चैव व्यतिक्रम्य शनैः शनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000011015, "chapter_id": 9011, "verse_number": "१-११-१५", "content_sanskrit": "अभिचक्राम तं देशं यत्र वै मुनिपुङ्गवः ।\nआसाद्य तं द्विजश्रेष्ठं रोमपादसमीपगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000011016, "chapter_id": 9011, "verse_number": "१-११-१६", "content_sanskrit": "ऋषिपुत्रं ददर्शाथो दीप्यमानमिवानलम् ।\nततो राजा यथायोग्यं पूजां चक्रे विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000011017, "chapter_id": 9011, "verse_number": "१-११-१७", "content_sanskrit": "सखित्वात्तस्य वै राज्ञः प्रहृष्टेनान्तरात्मना ।\nरोमपादेन चाख्यातमृषिपुत्राय धीमते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000011018, "chapter_id": 9011, "verse_number": "१-११-१८", "content_sanskrit": "सख्यं सम्बन्धकं चैव तदा तं प्रत्यपूजयत् ।\nएवं सुसत्कृतस्तेन सहोषित्वा नरर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000011019, "chapter_id": 9011, "verse_number": "१-११-१९", "content_sanskrit": "सप्ताष्टदिवसान् राजा राजानमिदमब्रवीत् ।\nशान्ता तव सुता राजन् सह भर्त्रा विशाम्पते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000011020, "chapter_id": 9011, "verse_number": "१-११-२०", "content_sanskrit": "मदीयं नगरं यातु कार्यं हि महदुद्यतम् ।\nतथेति राजा संश्रुत्य गमनं तस्य धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000011021, "chapter_id": 9011, "verse_number": "१-११-२१", "content_sanskrit": "उवाच वचनं विप्रं गच्छ त्वं सह भार्यया ।\nऋषिपुत्रः प्रतिश्रुत्य तथेत्याह नृपं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000011022, "chapter_id": 9011, "verse_number": "१-११-२२", "content_sanskrit": "स नृपेणाभ्यनुज्ञातः प्रययौ सह भार्यया ।\nतावन्योन्याञ्जलिं कृत्वा स्नेहात्संश्लिष्य चोरसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000011023, "chapter_id": 9011, "verse_number": "१-११-२३", "content_sanskrit": "ननन्दतुर्दशरथो रोमपादश्च वीर्यवान् ।\nततः सुहृदमापृच्छ्य प्रस्थितो रघुनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000011024, "chapter_id": 9011, "verse_number": "१-११-२४", "content_sanskrit": "पौरेषु प्रेषयामास दूतान् वै शीघ्रगामिनः ।\nक्रियतां नगरं सर्वं क्षिप्रमेव स्वलंकृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000011025, "chapter_id": 9011, "verse_number": "१-११-२५", "content_sanskrit": "धूपितं सिक्तसम्मृष्टं पताकाभिरलंकृतम् ।\nततः प्रहृष्टाः पौरास्ते श्रुत्वा राजानमागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000011026, "chapter_id": 9011, "verse_number": "१-११-२६", "content_sanskrit": "तथा चक्रुश्च तत् सर्वं राज्ञा यत् प्रेषितं तदा ।\nततः स्वलंकृतं राजा नगरं प्रविवेश ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000011027, "chapter_id": 9011, "verse_number": "१-११-२७", "content_sanskrit": "शङ्खदुन्दुभिनिर्ह्रादैः पुरस्कृत्वा द्विजर्षभम् ।\nततः प्रमुदिताः सर्वे दृष्ट्वा वै नागरा द्विजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000011028, "chapter_id": 9011, "verse_number": "१-११-२८", "content_sanskrit": "प्रवेश्यमानं सत्कृत्य नरेन्द्रेणेन्द्रकर्मणा ।\nयथा दिवि सुरेन्द्रेण सहस्राक्षेण काश्यपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000011029, "chapter_id": 9011, "verse_number": "१-११-२९", "content_sanskrit": "अन्तःपुरं प्रवेश्यैनं पूजां कृत्वा तु शास्त्रतः ।\nकृतकृत्यं तदात्मानं मेने तस्योपवाहनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000011030, "chapter_id": 9011, "verse_number": "१-११-३०", "content_sanskrit": "अन्तःपुराणि सर्वाणि शान्तां दृष्ट्वा तथागताम् ।\nसह भर्त्रा विशालाक्षीं प्रीत्यानन्दमुपागमन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000011031, "chapter_id": 9011, "verse_number": "१-११-३१", "content_sanskrit": "पूज्यमाना तु ताभिः सा राज्ञा चैव विशेषतः ।\nउवास तत्र सुखिता कञ्चित् कालं सहद्विजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000011032, "chapter_id": 9011, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे एकादशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]