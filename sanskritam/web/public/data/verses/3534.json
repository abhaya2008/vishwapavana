[{"id": 2117713, "chapter_id": 3534, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2117714, "chapter_id": 3534, "verse_number": "१", "content_sanskrit": "ततो देवर्षयः सर्वे ते चैव परमर्षयः ।\nजग्मुस्तदा परामार्तिं दृष्ट्वा तत्कदनं महत् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2117715, "chapter_id": 3534, "verse_number": "२", "content_sanskrit": "तेऽभिजग्मुर्जितक्रोधा जितात्मानो जितेन्द्रियाः ।\nपितामहस्य भवनं जगतस्ते कृपया तदा \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2117716, "chapter_id": 3534, "verse_number": "३", "content_sanskrit": "ततो ददृशुरासीनं सह देवैः पितामहम् ।\nसिद्धैर्ब्रह्मर्षिभिश्चैव समन्तात् परिवारितम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2117717, "chapter_id": 3534, "verse_number": "४", "content_sanskrit": "तत्र जिष्णुर्महादेवस्तत्राग्निर्वायुना सह ।\nचन्द्रादित्यौ च धर्मश्च परमेष्ठी तथा बुधः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2117718, "chapter_id": 3534, "verse_number": "५", "content_sanskrit": "वैखानसा वालखिल्याः सोमपाश्च मरीचिपाः ।\nअजश्चैवाजमीढाश्च तेजोमीढास्तपस्विनः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2117719, "chapter_id": 3534, "verse_number": "६", "content_sanskrit": "ऋषयः सर्व एवैते पितामहमुपासते ।\nततोऽभिगम्य सहिताः सर्व एव महर्षयः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2117720, "chapter_id": 3534, "verse_number": "७", "content_sanskrit": "सुन्दोपसुन्दयोः कर्म सर्वमेव शशंसिरे ।\nयथाकृतं यथाचेष्टं कृतं येन क्रमेण च \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2117721, "chapter_id": 3534, "verse_number": "८", "content_sanskrit": "न्यवेदयंस्ततः सर्वमखिलेन पितामहम् ।\nततो देवाश्च ते सर्वे ते चैव परमर्षयः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2117722, "chapter_id": 3534, "verse_number": "९", "content_sanskrit": "तमेवार्थं पुरस्कृत्य पितामहमचोदयन् ।\nततः पितामहः श्रुत्वा सर्वेषां तद् वचस्तदा \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2117723, "chapter_id": 3534, "verse_number": "१०", "content_sanskrit": "मुहूर्तमिव सञ्चिन्त्य कर्तव्यस्य विनिश्चयम् ।\nतयोर्वधं समुद्दिश्य विश्वकर्माणमाह्वयत् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2117724, "chapter_id": 3534, "verse_number": "११", "content_sanskrit": "दृष्ट्वा च विश्वकर्माणं व्यादिदेश पितामहः ।\nसृज्यतां प्रार्थनीयेन रूपेण स्त्रीत्यथाब्रवीत् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2117725, "chapter_id": 3534, "verse_number": "१२", "content_sanskrit": "पितामहं नमस्कृत्य तद्वाक्यमभिनन्द्य वै ।\nनिर्ममे स च तां दिव्यां चिन्तयित्वा प्रयत्नतः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2117726, "chapter_id": 3534, "verse_number": "१३", "content_sanskrit": "त्रिषु लोकेषु यत् किञ्चिद्भूतं स्थावरजङ्गमम् ।\nसमानयद् दर्शनीयं तत्तद् यत्नात् ततस्ततः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2117727, "chapter_id": 3534, "verse_number": "१४", "content_sanskrit": "कोटिशश्चैव रत्नानि तस्या गात्रे न्यवेशयत् ।\nतां रत्नसङ्घातमयीमसृजद् देवरूपिणीम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2117728, "chapter_id": 3534, "verse_number": "१५", "content_sanskrit": "सा प्रयत्नेन महता निर्मिता विश्वकर्मणा ।\nत्रिषु लोकेषु नारीणां रूपेणाप्रतिमा भुवि \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2117729, "chapter_id": 3534, "verse_number": "१६", "content_sanskrit": "न तस्याः सूक्ष्ममप्यस्ति यद् गात्रे रूपसम्पदा ।\nरहितं सर्वगात्रेषु यत्र दृष्टिर्न सज्जते \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2117730, "chapter_id": 3534, "verse_number": "१७", "content_sanskrit": "सा विग्रहवतीव श्रीः कान्तरूपा वपुष्मती ।\nपितामहमुपातिष्ठत् किं करोमीति चाब्रवीत् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2117731, "chapter_id": 3534, "verse_number": "१८", "content_sanskrit": "प्रीतो भूत्वा स दृष्ट्वैव प्रीत्या चास्यै वरं ददौ ।\nकान्तित्वं सर्वभूतानां स्वश्रियाऽनुपमं वपुः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2117732, "chapter_id": 3534, "verse_number": "१९", "content_sanskrit": "सा तेन वरदानेन कर्तुश्च क्रियया तदा ।\nजहार सर्वभूतानां चक्षूंषि च मनांसि च \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2117733, "chapter_id": 3534, "verse_number": "२०", "content_sanskrit": "तिलं तिलं समादाय रत्नानां यद् विनिर्मिता ।\nतिलोत्तमेत्यतस्तस्या नाम चक्रे पितामहः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2117734, "chapter_id": 3534, "verse_number": "", "content_sanskrit": "पितामहः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2117735, "chapter_id": 3534, "verse_number": "२१", "content_sanskrit": "गच्छ सुन्दोपसुन्दाभ्यामसुराभ्यां तिलोत्तमे ।\nप्रार्थनीयेन रूपेण कुरु भद्रे प्रलोभनम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2117736, "chapter_id": 3534, "verse_number": "२२", "content_sanskrit": "त्वत्कृते दर्शनादेव रूपसम्पत्कृते च वै ।\nविरोधः स्याद् यथा ताभ्यामन्योन्यं तु तथा कुरु \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2117737, "chapter_id": 3534, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2117738, "chapter_id": 3534, "verse_number": "२३", "content_sanskrit": "सा तथेति प्रतिज्ञाय नमस्कृत्वा पितामहम् ।\nचकार मण्डलं सा वै विबुधानां प्रदक्षिणम् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2117739, "chapter_id": 3534, "verse_number": "२४", "content_sanskrit": "प्राङ्मुखो भगवानास्ते दक्षिणेन महेश्वरः ।\nदेवाश्चैवोत्तरेणासन् सर्वतस्त्वृषयोऽभवन् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2117740, "chapter_id": 3534, "verse_number": "२५", "content_sanskrit": "कुर्वन्त्यां तु तदा तस्यां मण्डलं तु प्रदक्षिणम् ।\nब्रह्मा विष्णुश्च भगवान् तृणीकृत्यावतिष्ठते \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2117741, "chapter_id": 3534, "verse_number": "२६", "content_sanskrit": "इन्द्रः स्थाणुश्च भगवान् धैर्यं कृत्वा प्रतिष्ठितौ ।\nद्रष्टुकामस्य चात्यर्थं गतायां पार्श्वतस्ततः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2117742, "chapter_id": 3534, "verse_number": "२७", "content_sanskrit": "अन्यदञ्चितपद्माक्षं पश्चिमं निःसृतं मुखम् ।\nगतायाश्चोत्तरं पार्श्वं चोत्तरं विवृतं मुखम् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2117743, "chapter_id": 3534, "verse_number": "२८", "content_sanskrit": "पृष्ठतः परिवर्तन्त्या दक्षिणं निःसृतं मुखम् ।\nमहेन्द्रस्यापि नेत्राणां पार्श्वतः पृष्ठतोऽग्रतः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2117744, "chapter_id": 3534, "verse_number": "२९", "content_sanskrit": "रक्तानां च विशालानां सहस्रं सर्वतोऽभवत् ।\nएवं चतुर्मुखः स्थाणुर्महादेवोऽभवत् पुरा \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2117745, "chapter_id": 3534, "verse_number": "३०", "content_sanskrit": "तथा सहस्रनेत्रश्च बभूव बलसूदनः ।\nतथा देवनिकायानामृषीणां चापि सर्वशः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2117746, "chapter_id": 3534, "verse_number": "३१", "content_sanskrit": "मुखान्यभिप्रवर्तन्ते येन याति तिलोत्तमा ।\nतस्या गात्रे निपतिता दृष्टिस्तेषां महात्मनाम् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2117747, "chapter_id": 3534, "verse_number": "३२", "content_sanskrit": "सर्वेषामेव भूयिष्ठमृते देवं पितामहम् ।\nगच्छन्त्था च तया देवाः सर्वे च परमर्षयः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2117748, "chapter_id": 3534, "verse_number": "३३", "content_sanskrit": "कृतमित्येव तत् कार्यं मेनिरे रूपसम्पदा ।\nतिलोत्तमायां तु तदा गतायां लोकभावनः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2117749, "chapter_id": 3534, "verse_number": "३४", "content_sanskrit": "कृतं कार्यमिति श्रीमान् व्याजहार पितामहः ।\nसर्वान् विसर्जयामास देवानृषिगणांश्च तान् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2117750, "chapter_id": 3534, "verse_number": "२१३", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nत्रयोदशाधिकद्विशततमोऽध्यायः ॥२१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2117751, "chapter_id": 3534, "verse_number": "", "content_sanskrit": "॥ इति राज्यलाभपर्वणि पञ्चमोऽध्यायः ॥५॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]