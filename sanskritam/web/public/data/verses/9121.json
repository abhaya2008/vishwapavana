[{"id": 5000121000, "chapter_id": 9121, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे चतुश्चत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000121001, "chapter_id": 9121, "verse_number": "२-४४-१", "content_sanskrit": "विलपन्तीं तथा तां तु कौसल्यां प्रमदोत्तमाम्।\nइदं धर्मे स्थिता धर्म्यं सुमित्रा वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000121002, "chapter_id": 9121, "verse_number": "२-४४-२", "content_sanskrit": "तवार्ये सद्‍गुणैर्युक्तः स पुत्रः पुरुषोत्तमः।\nकिं ते विलपितेनैवं कृपणं रुदितेन वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000121003, "chapter_id": 9121, "verse_number": "२-४४-३", "content_sanskrit": "यस्तवार्ये गतः पुत्रस्त्यक्त्वा राज्यं महाबलः।\nसाधु कुर्वन् महात्मानं पितरं सत्यवादिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000121004, "chapter_id": 9121, "verse_number": "२-४४-४", "content_sanskrit": "शिष्टैराचरिते सम्यक‍्शश्वत् प्रेत्य फलोदये।\nरामो धर्मे स्थितः श्रेष्ठो न स शोच्यः कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000121005, "chapter_id": 9121, "verse_number": "२-४४-५", "content_sanskrit": "वर्तते चोत्तमां वृत्तिं लक्ष्मणोऽस्मिन् सदानघः।\nदयावान् सर्वभूतेषु लाभस्तस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000121006, "chapter_id": 9121, "verse_number": "२-४४-६", "content_sanskrit": "अरण्यवासे यद् दुःखं जानन्त्येव सुखोचिता।\nअनुगच्छति वैदेही धर्मात्मानं तवात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000121007, "chapter_id": 9121, "verse_number": "२-४४-७", "content_sanskrit": "कीर्तिभूतां पताकां यो लोके भ्रमयति प्रभुः।\nधर्मः सत्यव्रतपरः किं न प्राप्तस्तवात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000121008, "chapter_id": 9121, "verse_number": "२-४४-८", "content_sanskrit": "व्यक्तं रामस्य विज्ञाय शौचं माहात्म्यमुत्तमम्।\nन गात्रमंशुभिः सूर्यः संतापयितुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000121009, "chapter_id": 9121, "verse_number": "२-४४-९", "content_sanskrit": "शिवः सर्वेषु कालेषु काननेभ्यो विनिःसृतः।\nराघवं युक्तशीतोष्णः सेविष्यति सुखोऽनिलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000121010, "chapter_id": 9121, "verse_number": "२-४४-१०", "content_sanskrit": "शयानमनघं रात्रौ पितेवाभिपरिष्वजन्।\nघर्मघ्नः संस्पृशन् शीतश्चन्द्रमा ह्लादयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000121011, "chapter_id": 9121, "verse_number": "२-४४-११", "content_sanskrit": "ददौ चास्त्राणि दिव्यानि यस्मै ब्रह्मा महौजसे।\nदानवेन्द्रं हतं दृष्ट्वा तिमिध्वजसुतं रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000121012, "chapter_id": 9121, "verse_number": "२-४४-१२", "content_sanskrit": "स शूरः पुरुषव्याघ्रः स्वबाहुबलमाश्रितः।\nअसंत्रस्तो ह्यरण्येऽसौ वेश्मनीव निवत्स्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000121013, "chapter_id": 9121, "verse_number": "२-४४-१३", "content_sanskrit": "यस्येषुपथमासाद्य विनाशं यान्ति शत्रवः।\nकथं न पृथिवी तस्य शासने स्थातुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000121014, "chapter_id": 9121, "verse_number": "२-४४-१४", "content_sanskrit": "या श्रीः शौर्यं च रामस्य या च कल्याणसत्त्वता।\nनिवृत्तारण्यवासः स्वं क्षिप्रं राज्यमवाप्स्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000121015, "chapter_id": 9121, "verse_number": "२-४४-१५", "content_sanskrit": "सूर्यस्यापि भवेत् सूर्यो ह्यग्नेरग्नः प्रभोः प्रभुः।\nश्रियाः श्रीश्च भवेदग्र्या कीर्त्याः कीर्तिः क्षमाक्षमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000121016, "chapter_id": 9121, "verse_number": "२-४४-१६", "content_sanskrit": "दैवतं देवतानां च भूतानां भूतसत्तमः।\nतस्य के ह्यगुणा देवि वने वाप्यथवा पुरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000121017, "chapter_id": 9121, "verse_number": "२-४४-१७", "content_sanskrit": "पृथिव्या सह वैदेह्या श्रिया च पुरुषर्षभः।\nक्षिप्रं तिसृभिरेताभिः सह रामोऽभिषेक्ष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000121018, "chapter_id": 9121, "verse_number": "२-४४-१८", "content_sanskrit": "दुःखजं विसृजत्यश्रु निष्क्रामन्तमुदीक्ष्य यम्।\nअयोध्यायां जनः सर्वः शोकवेगसमाहतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000121019, "chapter_id": 9121, "verse_number": "२-४४-१९", "content_sanskrit": "कुशचीरधरं वीरं गच्छन्तमपराजितम्।\nसीतेवानुगता लक्ष्मीस्तस्य किं नाम दुर्लभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000121020, "chapter_id": 9121, "verse_number": "२-४४-२०", "content_sanskrit": "धनुर्ग्रहवरो यस्य बाणखड्गास्त्रभृत् स्वयम्।\nलक्ष्मणो व्रजति ह्यग्रे तस्य किं नाम दुर्लभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000121021, "chapter_id": 9121, "verse_number": "२-४४-२१", "content_sanskrit": "निवृत्तवनवासं तं द्रष्टासि पुनरागतम्।\nजहि शोकं च मोहं च देवि सत्यं ब्रवीमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000121022, "chapter_id": 9121, "verse_number": "२-४४-२२", "content_sanskrit": "शिरसा चरणावेतौ वन्दमानमनिन्दिते।\nपुनर्द्रक्ष्यसि कल्याणि पुत्रं चन्द्रमिवोदितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000121023, "chapter_id": 9121, "verse_number": "२-४४-२३", "content_sanskrit": "पुनः प्रविष्टं दृष्ट्वा तमभिषिक्तं महाश्रियम्।\nसमुत्स्रक्ष्यसि नेत्राभ्यां शीघ्रमानन्दजं जलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000121024, "chapter_id": 9121, "verse_number": "२-४४-२४", "content_sanskrit": "मा शोको देवि दुःखं वा न रामे दृष्यतेऽशिवम्।\nक्षिप्रं द्रक्ष्यसि पुत्रं त्वं ससीतं सहलक्ष्मणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000121025, "chapter_id": 9121, "verse_number": "२-४४-२५", "content_sanskrit": "त्वयाऽशेषो जनश्चायं समाश्वास्यो यतोऽनघे।\nकमिदानीमिदं देवि करोषि हृदि विक्लवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000121026, "chapter_id": 9121, "verse_number": "२-४४-२६", "content_sanskrit": "नार्हा त्वं शोचितुं देवि यस्यास्ते राघवः सुतः।\nनहि रामात् परो लोके विद्यते सत्पथे स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000121027, "chapter_id": 9121, "verse_number": "२-४४-२७", "content_sanskrit": "अभिवादयमानं तं दृष्ट्वा ससुहृदं सुतम्।\nमुदाश्रु मोक्ष्यसे क्षिप्रं मेघरेखेव वार्षिकी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000121028, "chapter_id": 9121, "verse_number": "२-४४-२८", "content_sanskrit": "पुत्रस्ते वरदः क्षिप्रमयोध्यां पुनरागतः।\nकराभ्यां मृदुपीनाभ्यां चरणौ पीडयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000121029, "chapter_id": 9121, "verse_number": "२-४४-२९", "content_sanskrit": "अभिवाद्य नमस्यन्तं शूरं ससुहृदं सुतम्।\nमुदास्रैः प्रोक्षसे पुत्रं मेघराजिरिवाचलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000121030, "chapter_id": 9121, "verse_number": "२-४४-३०", "content_sanskrit": "आश्वासयन्ती विविधैश्च वाक्यै-\nर्वाक्योपचारे कुशलानवद्या।\nरामस्य तां मातरमेवमुक्त्वा\nदेवी सुमित्रा विरराम रामा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000121031, "chapter_id": 9121, "verse_number": "२-४४-३१", "content_sanskrit": "निशम्य तल्लक्ष्मणमातृवाक्यं\nरामस्य मातुर्नरदेवपत्न्याः।\nसद्यः शरीरे विननाश शोकः\nशरद्‍गतो मेघ इवाल्पतोयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000121032, "chapter_id": 9121, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे चतुश्चत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]