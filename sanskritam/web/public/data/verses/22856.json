[{"id": 7002856000, "chapter_id": 22856, "verse_number": "९-१४१-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nकथयस्व महाभाग सर्वज्ञो ह्यसि यादव ।\nसर्वकामाप्तये कृत्यं कथं शांतिकपौष्टिकम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002856001, "chapter_id": 22856, "verse_number": "९-१४१-२", "content_sanskrit": "श्रीकृष्ण उवाच ।\nश्रीकामः शान्तिकामो वा ग्रहयज्ञं समारभेत् ।\nदृष्ट्यायुः पुष्टिकामो वा तथैवाभिचरन्पुनः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002856002, "chapter_id": 22856, "verse_number": "९-१४१-३", "content_sanskrit": "सर्वशास्त्राण्यनुक्रम्य संक्षिप्य ग्रन्थविस्तरम् ।\nग्रहशांतिं प्रवक्ष्यामि पुराणश्रुतिभाषिताम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002856003, "chapter_id": 22856, "verse_number": "९-१४१-४", "content_sanskrit": "पुण्येऽह्नि विप्रकथिते कृत्वा ब्राह्मणवाचनम् ।\nग्रहान्ग्रहाधिदेवांश्च स्थाप्य होमं समारभेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002856004, "chapter_id": 22856, "verse_number": "९-१४१-५", "content_sanskrit": "ग्रहयज्ञस्त्रिधा प्रोक्तः पुराणश्रुतिकोविदैः ।\nप्रथमोऽयुतहोमः स्याल्लक्षहोमस्ततः परम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002856005, "chapter_id": 22856, "verse_number": "९-१४१-६", "content_sanskrit": "तृतीयः कोटिहोमस्तु सर्वकामफलप्रदः ।\nअयुतेनाहुतीनां च नवग्रहमखः स्मृतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002856006, "chapter_id": 22856, "verse_number": "९-१४१-७", "content_sanskrit": "तस्य तावद्विधिं वक्ष्ये पुराणश्रुतिभाषितम् ।\nगर्तस्योत्तरपूर्वेण वितस्तिद्वयविस्तृताम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002856007, "chapter_id": 22856, "verse_number": "९-१४१-८", "content_sanskrit": "कुर्याद्विधानतो वेदिं वितस्त्युच्छ्रयसंयुताम् ।\nसंस्थापनाय देवानां चतुरस्रामुदक्प्लवाम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002856008, "chapter_id": 22856, "verse_number": "९-१४१-९", "content_sanskrit": "अग्निप्रणयनं कृत्वा तस्यामावाहयेत्सुरान् ।\nदेवानां तत्र संस्थाप्या विंशतिर्द्वादशाधिका ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002856009, "chapter_id": 22856, "verse_number": "९-१४१-१०", "content_sanskrit": "सूर्यः सोमो महीपुत्रो बुधो जीवः सितोर्कजः ।\nराहुः केतुरिति प्रोक्ता ग्रहालोकहितावहाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002856010, "chapter_id": 22856, "verse_number": "९-१४१-११", "content_sanskrit": "ताम्रकात्स्फटिकाद्रक्तचन्दनात्स्वर्णजावुभौ ।\nरजतादायसाच्चैव ग्रहाः कार्याः क्रमादमी ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002856011, "chapter_id": 22856, "verse_number": "९-१४१-१२", "content_sanskrit": "मध्ये तु भास्करं विद्याल्लोहितं दक्षिणेन तु ।\nउत्तरेण गुरुं विद्याद्बुधं पूर्वोत्तरेण तु ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002856012, "chapter_id": 22856, "verse_number": "९-१४१-१३", "content_sanskrit": "पूर्वेण भार्गवं विद्यात्सोमं दक्षिणपूर्वके ।\nपश्चिमोत्तरतः केतुं स्थापयेच्छुक्लतंडुलैः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002856013, "chapter_id": 22856, "verse_number": "९-१४१-१४", "content_sanskrit": "राजामात्यान्महाराज तंडुलैः स्थापयेदथ ।\nभास्करस्येश्वरं विद्यादुमां च शशिनस्तथा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002856014, "chapter_id": 22856, "verse_number": "९-१४१-१५", "content_sanskrit": "स्कन्दमङ्गारकस्यापि बुधस्य च तथा हरिम् ।\nब्रह्माणं च गुरोर्विद्याच्छुक्रस्यापि शचीपतिम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002856015, "chapter_id": 22856, "verse_number": "९-१४१-१६", "content_sanskrit": "शनैश्चरस्य तु यमं राहोः कालं तथैव च ।\nकेतोस्तु चित्रगुप्तं तु सर्वेषामेव देवताः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002856016, "chapter_id": 22856, "verse_number": "९-१४१-१७", "content_sanskrit": "अग्निरापः क्षितिर्विष्णुरिन्द्रः सौवर्णदेवताः ।\nप्रजापतिश्च सूर्यश्च ब्रह्मा प्रत्यधिदेवताः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002856017, "chapter_id": 22856, "verse_number": "९-१४१-१८", "content_sanskrit": "विनायकं तथा दुर्गां वायुमाकाशमेव च ।\nसावित्रीं च तथा लक्ष्मीमुमां च सहभर्तृकाम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002856018, "chapter_id": 22856, "verse_number": "९-१४१-१९", "content_sanskrit": "आवाहयेद्व्याहृतिभिस्तथैवाश्विकुमारकौ ।\nसंस्मरेद्रक्तमादित्यमंगारकसमन्वितम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002856019, "chapter_id": 22856, "verse_number": "९-१४१-२०", "content_sanskrit": "सोमशुक्रौ यथाश्वेतौ बुधजीवौ च पिङ्ग लौ ।\nमंदराहू तथा कृष्णौ धूम्रं केतुगुणं विदुः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002856020, "chapter_id": 22856, "verse_number": "९-१४१-२१", "content_sanskrit": "ग्रहवर्णानि देयानि वासांसि कुसुमानि च ।\nगंधाश्च बलयश्चैव धूपा गुग्गुलपूर्वकाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002856021, "chapter_id": 22856, "verse_number": "९-१४१-२२", "content_sanskrit": "गुडौदनं रवेर्दद्यात्सोमाय घृतपायसम् ।\nअंगारकाय संयावं बुधाय क्षीरषष्टिकम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002856022, "chapter_id": 22856, "verse_number": "९-१४१-२३", "content_sanskrit": "दध्यन्नं गुरवे दद्याच्छक्राय तु घृतौदनम् ।\nशनैश्चराय कृशरं मेषमांसं तु राहवे ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002856023, "chapter_id": 22856, "verse_number": "९-१४१-२४", "content_sanskrit": "चित्रौदनं केतवे च सर्वान्भक्ष्यैरथार्चयेत् ।\nप्रागुत्तरेण तस्माच्च दध्यक्षतविभूषितम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002856024, "chapter_id": 22856, "verse_number": "९-१४१-२५", "content_sanskrit": "चूत पल्लवसंपन्नं फलवस्त्रयुगान्वितम् ।\nपञ्चरत्नसमायुक्तं पञ्चभंगयुतं तथा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002856025, "chapter_id": 22856, "verse_number": "९-१४१-२६", "content_sanskrit": "स्थापयेदव्रणं कुंभं वरुणं तत्र विन्यसेत् ।\nगंगायाः सरितः सर्वाः समुद्राश्च सरांसि च ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002856026, "chapter_id": 22856, "verse_number": "९-१४१-२७", "content_sanskrit": "गजाश्वरथ्यावल्मीकात्संगमाद्धृदगोकुलात् ।\nमृदमानीय राजेन्द्र सर्वौषधिजलान्विताम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002856027, "chapter_id": 22856, "verse_number": "९-१४१-२८", "content_sanskrit": "स्नानार्थं विन्यसेत्तत्र यजमानस्य धर्मवित् ।\nसर्वे समुद्राः सरितः सरः प्रस्रवणानि च ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002856028, "chapter_id": 22856, "verse_number": "९-१४१-२९", "content_sanskrit": "आयांतु यजमानस्य दुरितक्षयकारकाः ।\nएवमावाहयित्वा तान्सर्वान्नृपतिसत्तम ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002856029, "chapter_id": 22856, "verse_number": "९-१४१-३०", "content_sanskrit": "होमं समारभेत्सर्पिर्यवव्रीहितिलादिना ।\nअर्कः पलाशखदिरौ ह्यपामार्गोऽथ पिप्पलः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002856030, "chapter_id": 22856, "verse_number": "९-१४१-३१", "content_sanskrit": "उदुंबर शमीदूर्वाकुशाश्च समिधः क्रमात् ।\nएकैकस्य चाष्टशतमष्टाविंशति वा पुनः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002856031, "chapter_id": 22856, "verse_number": "९-१४१-३२", "content_sanskrit": "होतव्या मधुसर्पिभ्यां दध्ना वा पायसेन वा ।\nप्रादेशमात्रा ऋजवो विशाखा विफलाः शुभाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002856032, "chapter_id": 22856, "verse_number": "९-१४१-३३", "content_sanskrit": "कल्प्यंते समिधः प्राज्ञैः सर्वकर्मसु सर्वदा ।\nदेवानामपि सर्वेषामुपांशु परमार्थवित् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002856033, "chapter_id": 22856, "verse_number": "९-१४१-३४", "content_sanskrit": "स्वेन स्वेनैव मंत्रेण होतव्याः समिधः पृथक् ।\nआकृष्णेन इमं देवा अग्निर्मूर्द्धा दिवः क्रमात् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002856034, "chapter_id": 22856, "verse_number": "९-१४१-३५", "content_sanskrit": "उद्बुध्यस्वेति बोध्यश्च यथासंख्यमुदाहृताः ।\nबृहस्पते अतियदस्तथैवान्नात्परिसुतः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002856035, "chapter_id": 22856, "verse_number": "९-१४१-३६", "content_sanskrit": "शन्नोदेवीति च कया केतुं कृण्वन्नितीति च ।\nहोतव्यं यद्वदाज्यं चरुं भक्ष्याणि वा पुनः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002856036, "chapter_id": 22856, "verse_number": "९-१४१-३७", "content_sanskrit": "मंत्रैर्दशाहुतीर्दत्त्वा होमो व्याहृतिभिस्ततः ।\nउदङ्मुखाः प्राङ्मुखाश्च कुर्युर्ब्राह्मणपुंगवाः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002856037, "chapter_id": 22856, "verse_number": "९-१४१-३८", "content_sanskrit": "मंत्रवंतस्तु कर्तव्याश्चरवः प्रतिदैवतम् ।\nअपो राजेति रुद्रस्य बलिहोमं समारभेत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002856038, "chapter_id": 22856, "verse_number": "९-१४१-३९", "content_sanskrit": "आपो हिष्टेत्युमायास्तु श्येनेति स्वामिनस्तथा ।\nविष्णोरिदं विष्णुरिति स्वमिच्छेति स्वयंभुवः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002856039, "chapter_id": 22856, "verse_number": "९-१४१-४०", "content_sanskrit": "इन्द्रादिदेवतानां तु इन्द्राय जुहुयात्पुनः ।\nनवा यमस्यायं गौश्चेत्येवं होमः प्रकीर्तितः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002856040, "chapter_id": 22856, "verse_number": "९-१४१-४१", "content_sanskrit": "कालस्य ब्रह्मजज्ञानमिति मंत्रः प्रशस्यते ।\nचित्रगुप्तस्य वा जात पौराणिका विदुर्बुधाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002856041, "chapter_id": 22856, "verse_number": "९-१४१-४२", "content_sanskrit": "अग्निं दूतं वृणीमहे इति वह्नेरुदाहृतः ।\nइंद्रं यमं वरुणमित्ययं मंत्रः प्रकीर्तितः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002856042, "chapter_id": 22856, "verse_number": "९-१४१-४३", "content_sanskrit": "भूमेः पृथिव्यंतरिक्षमिति वेदेषु पठ्यते ।\nसहस्रशीर्षा पुरुष इति विष्णोरुदाहृतः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002856043, "chapter_id": 22856, "verse_number": "९-१४१-४४", "content_sanskrit": "वरुणः पवनश्चैव धनाध्यक्षस्तथा शिवः ।\nब्रह्मणा सहितः शेषो दिक्पालाः पातु ते सदा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002856044, "chapter_id": 22856, "verse_number": "९-१४१-४५", "content_sanskrit": "कीर्तिर्लक्ष्मीर्धृतिर्मेधाः पुष्टिः श्रद्धा क्रिया मतिः ।\nबुद्धिर्लज्जा शांतिपुष्टी कांतिस्तुष्टिश्च मातरः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002856045, "chapter_id": 22856, "verse_number": "९-१४१-४६", "content_sanskrit": "एतास्त्वामभिषिंचंतु धर्मपत्न्यः समागताः ।\nआदित्यश्चन्द्रमा भौमो बुधजीवसितार्कजाः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002856046, "chapter_id": 22856, "verse_number": "९-१४१-४७", "content_sanskrit": "ग्रहास्त्वामभिषिंचंतु राहुः केतुश्च तर्पिताः ।\nदेवदानवगंधर्वा यक्षराक्षसपन्नगाः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002856047, "chapter_id": 22856, "verse_number": "९-१४१-४८", "content_sanskrit": "ऋषयो मनवो गावो देवमातर एव च ।\nदेवपत्न्यो द्रुमा नागा दैत्याश्चाप्सरसां गणाः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002856048, "chapter_id": 22856, "verse_number": "९-१४१-४९", "content_sanskrit": "अस्त्राणि सर्वशस्त्राणि राजानो वाहनानि च ।\nऔषधानि च रत्नानि कालस्यावयवाश्च ये ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002856049, "chapter_id": 22856, "verse_number": "९-१४१-५०", "content_sanskrit": "सरितः सागराः शैलास्तीर्थानि जलदा नदाः ।\nएते त्वामभिषिंचंतु सर्वकामार्थसिद्धये ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002856050, "chapter_id": 22856, "verse_number": "९-१४१-५१", "content_sanskrit": "ततः शुक्लांबरधरः शुक्लगन्धानुलेपनः ।\nसर्वगन्धसमायुक्तः स्नातः श्रद्धासमन्वितः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002856051, "chapter_id": 22856, "verse_number": "९-१४१-५२", "content_sanskrit": "यजमानः सपत्नीकान्सिद्धिदांस्तान्समाहितान् ।\nदक्षिणाभिः प्रयत्नेन पूजयेद्गतविस्मयः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002856052, "chapter_id": 22856, "verse_number": "९-१४१-५३", "content_sanskrit": "सूर्याय कपिलां धेनुं दद्याच्छंखं तथेन्दवे ।\nरक्तं धुरंधरं दद्याद्भौमाय ककुदाधिकम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002856053, "chapter_id": 22856, "verse_number": "९-१४१-५४", "content_sanskrit": "बुधाय जातरूपं च गुरवे पीतवाससी ।\nश्वेताश्वं दैत्यगुरवे कृष्णांगामर्कसूनवे ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002856054, "chapter_id": 22856, "verse_number": "९-१४१-५५", "content_sanskrit": "आयसं राहवे दद्यात्केतवे च्छागमुत्तमम् ।\nसुवर्णेन समा कार्या यजमानेन दक्षिणा ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002856055, "chapter_id": 22856, "verse_number": "९-१४१-५६", "content_sanskrit": "सर्वेषामथवा दद्याद्गुरुर्वा येन तुष्यति ।\nसुमंत्रेण प्रदातव्याः सर्वाः सर्वार्थदक्षिणाः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002856056, "chapter_id": 22856, "verse_number": "९-१४१-५७", "content_sanskrit": "कपिले सर्वदेवानां पूजनीयासि रोहिणी ।\nतीर्थदेवमयी यस्मादतः शांतिं प्रयच्छ मे ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002856057, "chapter_id": 22856, "verse_number": "९-१४१-५८", "content_sanskrit": "पुण्यस्त्वं शंख पुण्यानां मङ्गलानां च मंगलम् ।\nविष्णुना विधृतो नित्यमतः शांतिं प्रयच्छ मे ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002856058, "chapter_id": 22856, "verse_number": "९-१४१-५९", "content_sanskrit": "धर्म त्वं वृषरूपेण जगदानन्दकारकः ।\nअष्टमूर्तेरधिष्ठानमतः शांतिं प्रयच्छ मे ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002856059, "chapter_id": 22856, "verse_number": "९-१४१-६०", "content_sanskrit": "हिरण्यगर्भगर्भस्थं हेम बीजं विभावसोः ।\nअनन्तपुण्यफलदमतः शांतिं प्रयच्छ मे ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002856060, "chapter_id": 22856, "verse_number": "९-१४१-६१", "content_sanskrit": "पीतवस्त्रयुगं दद्याद्वासुदेवस्य वल्लभम् ।\nप्रदानात्तस्य मे विष्णुरतः शांतिं प्रयच्छतु ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002856061, "chapter_id": 22856, "verse_number": "९-१४१-६२", "content_sanskrit": "कपिलस्त्वश्वरूपेण यस्मादमृतसम्भवः ।\nचन्द्रार्कवाहनो नित्यमतः शांतिं प्रयच्छ मे ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002856062, "chapter_id": 22856, "verse_number": "९-१४१-६३", "content_sanskrit": "यस्मात्त्वं पृथिवी सर्वा धेनो वै कृष्णसंज्ञिता ।\nसर्वपापहरा नित्यमतः शांतिं प्रयच्छ मे ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002856063, "chapter_id": 22856, "verse_number": "९-१४१-६४", "content_sanskrit": "यस्मादायस कर्माणि तवाधीनानि सर्वदा ।\nलांगलान्यायुधादीनि तस्माच्छांतिं प्रयच्छ मे ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002856064, "chapter_id": 22856, "verse_number": "९-१४१-६५", "content_sanskrit": "यस्मात्त्वं छाग यज्ञानामंगत्वेन व्यवस्थितः ।\nयोनिर्विभावसोर्नित्यमतः शांतिं प्रयच्छ मे ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002856065, "chapter_id": 22856, "verse_number": "९-१४१-६६", "content_sanskrit": "गवामंगेषु तिष्ठंति भुवनानि चतुर्दश ।\nयस्मात्तस्माच्छिवं मे स्यादिह लोके परत्र च ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002856066, "chapter_id": 22856, "verse_number": "९-१४१-६७", "content_sanskrit": "यस्मादशून्यं शयनं केशवस्य शिवस्य च ।\nशय्या ममाप्यशून्यास्तु तथा जन्मनि जन्मनि ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002856067, "chapter_id": 22856, "verse_number": "९-१४१-६८", "content_sanskrit": "यथा रत्नेषु सर्वेषु सर्वे देवा व्यवस्थिताः ।\nतथा शांतिं प्रयच्छंतु रत्नदानेन मे सुराः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7002856068, "chapter_id": 22856, "verse_number": "९-१४१-६९", "content_sanskrit": "यथा भूमिप्रदानस्य कलां नार्हंति षोडशीम् ।\nदानान्यन्यानि मे शांतिं भूमि दानाद्भवत्यपि ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7002856069, "chapter_id": 22856, "verse_number": "९-१४१-७०", "content_sanskrit": "एवं संपूजयेद्भक्त्या वित्तशाठ्यविवर्जितः ।\nवस्त्रकाञ्चनरत्नौघैर्माल्यगंधानुलेपनैः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7002856070, "chapter_id": 22856, "verse_number": "९-१४१-७१", "content_sanskrit": "ग्रहस्वरूपमतुलं कथ्यमानं निबोध मे ।\nभक्तिभावप्रपन्नस्य कथ्यमानं विराजते ।\nपद्मासनः पद्मकरः पद्मगर्भसमद्युतिः ।\nसप्ताश्वः सप्तरज्जुश्च द्विभुजः स्यात्सदा रविः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7002856071, "chapter_id": 22856, "verse_number": "९-१४१-७२", "content_sanskrit": "श्वेतः श्वेतांबरधरो दशाश्वः श्वेतभूषणः ।\nगदापाणिर्द्विबाहुश्च कर्तव्यो वरदः शशी ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7002856072, "chapter_id": 22856, "verse_number": "९-१४१-७३", "content_sanskrit": "रक्तमाल्यांबरधरः कर्णिकारसमंद्युतिः ।\nखड्गचर्मगदापाणिर्विधेयो भूमिनंदनः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7002856073, "chapter_id": 22856, "verse_number": "९-१४१-७४", "content_sanskrit": "पीतमाल्यांबरधरः पीतगंधानुलेपनः ।\nकांचने च रथे दिव्ये शोभमानो बुधः सदा ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7002856074, "chapter_id": 22856, "verse_number": "९-१४१-७५", "content_sanskrit": "देवदैत्यगुरू तद्वत्पीतश्वेतौ चतुर्भुजौ ।\nदंडिनौ वरदौ कार्यौ साक्षसूत्रकमडलू ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7002856075, "chapter_id": 22856, "verse_number": "९-१४१-७६", "content_sanskrit": "इन्द्रनीलद्युतिः शूली वरदो गृध्रवाहनः ।\nबाणबाणासनधरः कर्तव्योऽर्कसुतः सदा ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7002856076, "chapter_id": 22856, "verse_number": "९-१४१-७७", "content_sanskrit": "शार्दूलवदनः खड्गी वर्मी शूली वरप्रदः ।\nनीलसिंहासनस्थश्च राहुरत्र प्रशस्यते ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7002856077, "chapter_id": 22856, "verse_number": "९-१४१-७८", "content_sanskrit": "धूम्रा द्विबाहवः सर्वे गदिनो विकृताननाः ।\nगृध्रासनरता नित्यं केतवः स्युर्वरप्रदाः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7002856078, "chapter_id": 22856, "verse_number": "९-१४१-७९", "content_sanskrit": "सर्वे किरीटिनः कार्या ग्रहा लोकहितावहाः ।\nस्वांगुलेनोच्छ्रिताः सर्वे शतमष्टोत्तरं तदा ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7002856079, "chapter_id": 22856, "verse_number": "९-१४१-८०", "content_sanskrit": "ग्रहस्वरूपमेतत्ते व्याख्यातं पांडुनन्दन ।\nएतज्ज्ञात्वा प्रयत्नेन पूजा कार्या विचक्षणैः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7002856080, "chapter_id": 22856, "verse_number": "९-१४१-८१", "content_sanskrit": "विधिना ग्रहपूजां योनेन त्वारभते नरः ।\nसर्वान्कामानवाप्नोति प्रेत्य स्वर्गे महीयते ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7002856081, "chapter_id": 22856, "verse_number": "९-१४१-८२", "content_sanskrit": "यस्तु पीडाकरो नित्यं माल्यवित्तस्य वा ग्रहः ।\nतं तु यत्नेन संपूज्य शेषानप्यर्चयेद्बुधः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7002856082, "chapter_id": 22856, "verse_number": "९-१४१-८३", "content_sanskrit": "ग्रहा गावो नरेन्द्राश्च ब्राह्मणाश्च विशेषतः ।\nपूजिताः पूजयंत्येते निर्दहंत्यवमानिताः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7002856083, "chapter_id": 22856, "verse_number": "९-१४१-८४", "content_sanskrit": "तस्मान्न दक्षिणाहीनं कर्तव्यं भूतिमिच्छता ।\nसंपूर्णायां दक्षिणायां यस्मादेकोऽपि तुष्यति ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7002856084, "chapter_id": 22856, "verse_number": "९-१४१-८५", "content_sanskrit": "सदैवाऽयुतहोमोऽयं नवग्रहमखः स्मृतः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7002856085, "chapter_id": 22856, "verse_number": "९-१४१-८६", "content_sanskrit": "विवाहोत्सवयज्ञेषु प्रतिष्ठादिषु कर्मसु ।\nनिर्विघ्नार्थं महाराज तथोद्वेगाद्भुतेषु च ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7002856086, "chapter_id": 22856, "verse_number": "९-१४१-८७", "content_sanskrit": "कथितोऽयुतहोमोऽयं लक्षहोममतः शृणु ।\nसर्वकामाप्तये यस्माल्लक्ष होमं विदुर्बुधाः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7002856087, "chapter_id": 22856, "verse_number": "९-१४१-८८", "content_sanskrit": "पितॄणां वल्लभो यस्माद्भुक्तिमुक्तिफलप्रदः ।\nग्रहताराबलं लब्ध्वा कृत्वा ब्राह्मणवाचनम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7002856088, "chapter_id": 22856, "verse_number": "९-१४१-८९", "content_sanskrit": "गृहस्योत्तरपूर्वेण मण्डपं कारयेद्बुधः ।\nरुद्रायतनभूमौ वा चतुरस्रमुदङ्मुखम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7002856089, "chapter_id": 22856, "verse_number": "९-१४१-९०", "content_sanskrit": "दशहस्तमथाष्टौ वा हस्तान्कुर्याद्विधानतः ।\nप्रागुदक्प्रवणां भूमिं कारयेद्यत्नतो नरः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7002856090, "chapter_id": 22856, "verse_number": "९-१४१-९१", "content_sanskrit": "प्रागुत्तरं समासाद्य प्रदेशं मंडपस्य तु ।\nशोभनं कारयेत्कुण्डं यथावल्लक्षणान्वितम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7002856091, "chapter_id": 22856, "verse_number": "९-१४१-९२", "content_sanskrit": "मानहीनं चाप्रशस्तमनेकभयदं भवेत् ।\nयस्मात्तस्मात्सुसंपूर्णं शांतिकुंडं विधीयते ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7002856092, "chapter_id": 22856, "verse_number": "९-१४१-९३", "content_sanskrit": "अस्माद्दशगुणः प्रोक्तो लक्षहोमे स्वयंभुवा ।\nआहुतिभिः प्रयत्नेन दक्षिणाभिस्तथैव च ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7002856093, "chapter_id": 22856, "verse_number": "९-१४१-९४", "content_sanskrit": "द्विहस्तविस्तृतं तद्वच्चतुर्हस्तायतं पुनः ।\nलक्षहोमे भवेत्कुण्डं योनिवक्त्रं त्रिमेखलम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7002856094, "chapter_id": 22856, "verse_number": "९-१४१-९५", "content_sanskrit": "संस्थापनाय देवानां वप्रत्रयसमावृतम् ।\nद्विरंगुलोच्छ्रितो वप्रः प्रथमः समुदाहृतः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7002856095, "chapter_id": 22856, "verse_number": "९-१४१-९६", "content_sanskrit": "अंगुलोच्छ्रयसंयुक्तं वप्रद्वयमथोपरि ।\nद्व्यङ्गुलस्तत्र विस्तारः सर्वेषां कथ्यते बुधैः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7002856096, "chapter_id": 22856, "verse_number": "९-१४१-९७", "content_sanskrit": "दशांगुलोच्छ्रिता भित्तिः स्थंडिलस्य तथोपरि ।\nतस्मिन्नावाहयेद्देवान्पूर्ववत्पुष्पतण्डुलैः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7002856097, "chapter_id": 22856, "verse_number": "९-१४१-९८", "content_sanskrit": "आदित्याभिमुखाः सर्वाः स्थाप्याः प्रत्यधिदेवताः ।\nस्थापनीया मुनिश्रेष्ठा नांतरेण पराङ्मुखाः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7002856098, "chapter_id": 22856, "verse_number": "९-१४१-९९", "content_sanskrit": "गरुत्मानधिकस्तत्र संपूज्यः श्रियमिच्छता ।\nसमपीनशरीरस्तु वाहनं परमेष्ठिनः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7002856099, "chapter_id": 22856, "verse_number": "९-१४१-१००", "content_sanskrit": "विषपापहरो नित्यमतः शांतिं प्रयच्छ मे ।\nपूर्ववत्कुंभमामंत्र्य तद्वद्धोमं समाचरेत् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7002856100, "chapter_id": 22856, "verse_number": "९-१४१-१०१", "content_sanskrit": "सहस्राणां शतं हुत्वा समित्संख्यादिकं पुनः ।\nऔदुम्बरीमथार्द्रां च वक्रकोटरवर्जिताम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7002856101, "chapter_id": 22856, "verse_number": "९-१४१-१०२", "content_sanskrit": "बाहुमात्रां स्रुचं कृत्वा ततः स्तंभद्वयोपरि ।\nघृतधारां तथा सम्यगग्नेरुपरि पातयेत् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7002856102, "chapter_id": 22856, "verse_number": "९-१४१-१०३", "content_sanskrit": "पाठयेत्सूक्तमाग्नेयं वैष्णवं रौद्रमैंदवम् ।\nमहावैश्वानरं साम ज्येष्ठसाम च पाठयेत् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7002856103, "chapter_id": 22856, "verse_number": "९-१४१-१०४", "content_sanskrit": "स्नानं तु यजमानस्य पूर्ववन्मन्त्रवाचनम् ।\nदातव्या यजमानेन पूर्ववद्दक्षिणा पृथक् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7002856104, "chapter_id": 22856, "verse_number": "९-१४१-१०५", "content_sanskrit": "कामक्रोधविहीनेन ऋत्विग्भ्यः शांतचेतसः ।\nनवग्रह मखे विप्राश्चत्वारो वेदवेदिनः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7002856105, "chapter_id": 22856, "verse_number": "९-१४१-१०६", "content_sanskrit": "अथ वा ऋत्विजौ शांतौ द्वावेव त्वतिकोविदौ ।\nकार्यावयुतहोमे तु न प्रसज्येत विस्तरे ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7002856106, "chapter_id": 22856, "verse_number": "९-१४१-१०७", "content_sanskrit": "तद्वच्च दश चाष्टौ वा लक्षहोमेऽपि ऋत्विजः ।\nकर्तव्याः शक्तितस्तद्वच्चत्वारो वा विमत्सराः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7002856107, "chapter_id": 22856, "verse_number": "९-१४१-१०८", "content_sanskrit": "नवग्रहमखे सर्वं लक्षहोमे दशोत्तरम् ।\nदद्याच्च पांडवश्रेष्ठ भूषणान्यपि शक्तितः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7002856108, "chapter_id": 22856, "verse_number": "९-१४१-१०९", "content_sanskrit": "शयनानि च वस्त्राणि हैमानि कटकानि च ।\nकर्णांगुलीपवित्राणि भक्तिमान्प्रतिपादयेत् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7002856109, "chapter_id": 22856, "verse_number": "९-१४१-११०", "content_sanskrit": "न कुर्याद्दक्षिणाहीनं वित्तशाठ्येन मानवः ।\nअददल्लोभमोहाभ्यां कुलक्षयमवाप्नुयात् ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7002856110, "chapter_id": 22856, "verse_number": "९-१४१-१११", "content_sanskrit": "अन्नदानं यथा शक्त्या दातव्यं भूतिमिच्छता ।\nअन्नहीनं व्रतं यस्माद्दुर्भिक्षफलदं भवेत् ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7002856111, "chapter_id": 22856, "verse_number": "९-१४१-११२", "content_sanskrit": "राष्ट्रं हन्यादंगहीनो मंत्रहीनस्तु ऋत्विजः ।\nअदक्षिणो यजमानं नास्ति यज्ञसमो रिपुः ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7002856112, "chapter_id": 22856, "verse_number": "९-१४१-११३", "content_sanskrit": "न चाप्यल्पधनः कुर्याल्लक्षहोमं नरः क्वचित् ।\nतस्मात्पीडाकरो नित्यं य एव भवति ग्रहः ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7002856113, "chapter_id": 22856, "verse_number": "९-१४१-११४", "content_sanskrit": "तमेव पूजयेद्भक्त्या द्वौ वा त्रीन्वा यथाविधि ।\nएकमप्यर्चयेद्भक्त्या ब्राह्मणं वेद पारगम् ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7002856114, "chapter_id": 22856, "verse_number": "९-१४१-११५", "content_sanskrit": "दक्षिणाभिः प्रयत्नेन बहू्न्वा बहुवित्तवान् ।\nलक्षहोमस्तु कर्तव्यो यदि वित्तं गृहे गृहे ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7002856115, "chapter_id": 22856, "verse_number": "९-१४१-११६", "content_sanskrit": "यतः सर्वानवाप्नोति कुर्वन्कामान्विधानतः ।\nपूज्यते शिवलोके च वस्वादित्यमरुद्गणैः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7002856116, "chapter_id": 22856, "verse_number": "९-१४१-११७", "content_sanskrit": "यावत्कल्पशतान्यष्टावथ मोक्षमवाप्नुयात् ।\nसकामो यस्त्विमं कुर्याल्लक्षहोमं यथाविधि ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7002856117, "chapter_id": 22856, "verse_number": "९-१४१-११८", "content_sanskrit": "स तं काममवाप्नोति पदं चानंत्यमश्नुते ।\nपुत्रार्थी लभते पुत्रं धनार्थी लभते धनम् ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7002856118, "chapter_id": 22856, "verse_number": "९-१४१-११९", "content_sanskrit": "भार्यार्थी शोभनां भार्यां कुमारी च शुभं पतिम् ।\nभ्रष्टराज्यस्तथा राज्यं श्रीकामः श्रियमाप्नुयात् ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7002856119, "chapter_id": 22856, "verse_number": "९-१४१-१२०", "content_sanskrit": "यं यं प्रार्थयते कामं तं तमाप्नोति पुष्कलम् ।\nनिष्कामः कुरुते यस्तु परं ब्रह्म स गच्छति ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7002856120, "chapter_id": 22856, "verse_number": "९-१४१-१२१", "content_sanskrit": "शांतिं नवग्रहमयीं दुरितोपशांतिं राजन्करोति बहुना विधिवद्द्विजेन्द्रैः ।\nक्षेमं सुभिक्षमतुलं कुलवृद्धिसंपत्तत्रास्ति यत्र कुरुते बत लक्षहोमम् ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}]