[{"id": 7002547000, "chapter_id": 22547, "verse_number": "१-२०९-१", "content_sanskrit": "सुमन्तुरुवाच ।\nयः क्षिपेद्गोमयाहारः शुक्ला द्वादश सप्तमीः ।\nअथवा यावकाहारः शीर्णपर्णाशनोऽपि वा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002547001, "chapter_id": 22547, "verse_number": "१-२०९-२", "content_sanskrit": "क्षीराशी चैकभक्तो वा भिक्षाहारोथ वा पुनः ।\nजलाहारोपि वा विद्वान्पूजयित्वा दिवाकरम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002547002, "chapter_id": 22547, "verse_number": "१-२०९-३", "content_sanskrit": "पुष्पोपहारैर्विविधैः पद्मसौगन्धिकोत्पलैः ।\nनानाप्रकारैर्गंधैश्च धूपैर्गुग्गुलुचंदनैः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002547003, "chapter_id": 22547, "verse_number": "१-२०९-४", "content_sanskrit": "कृष्णगंधपायसाद्यैर्विचित्रैः सुविभूषणैः ।\nअर्चयित्वा द्विजाञ्च्छ्रेष्ठान्हिरण्यान्नादिभिर्नरः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002547004, "chapter_id": 22547, "verse_number": "१-२०९-५", "content_sanskrit": "स तत्फलमवाप्नोति क्रतुभिर्भूरिदक्षिणैः ।\nयदेह तप्यते वीर प्राप्यते केवलं रवेः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002547005, "chapter_id": 22547, "verse_number": "१-२०९-६", "content_sanskrit": "विमानवरमारूढः सूर्यलोके महीयते ।\nततः पुण्यक्षयाद्राजन्कुले महति जायते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002547006, "chapter_id": 22547, "verse_number": "१-२०९-७", "content_sanskrit": "एवं भक्त्या विवस्वंतं प्रतिमासं समाहितः ।\nपूजयेद्विधिवद्भक्त्या नामानि परिकीर्तयेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002547007, "chapter_id": 22547, "verse_number": "१-२०९-८", "content_sanskrit": "चैत्रिके मासि विष्णुश्च माधवे ह्यर्यमेति वै ।\nशुक्रे विवस्वा न्मासे तु शुचौ मासे दिवाकरः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002547008, "chapter_id": 22547, "verse_number": "१-२०९-९", "content_sanskrit": "पर्जन्यः श्रावणे मासि नभस्ये वरुणस्तथा ।\nमार्तंडेति च विज्ञेयः कार्तिके भार्गवः पुनः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002547009, "chapter_id": 22547, "verse_number": "१-२०९-१०", "content_sanskrit": "मार्गशीर्षेपि मित्रस्तु कीर्तितः सततं बुधैः ।\nपूषा पौषे तु वै मासे पूजनीयः प्रयत्नतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002547010, "chapter_id": 22547, "verse_number": "१-२०९-११", "content_sanskrit": "माघे भगेति विज्ञेयस्त्वष्टा चैवाथ फाल्गुने ।\nएवं क्रमेण नामानि कीर्तयेत्प्रीतये रवेः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002547011, "chapter_id": 22547, "verse_number": "१-२०९-१२", "content_sanskrit": "धूपार्चनविधिमिमं सप्तम्यां सुसमाहितः ।\nयः करोति नरो भक्त्या स याति परमां गतिम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002547012, "chapter_id": 22547, "verse_number": "१-२०९-१३", "content_sanskrit": "ततस्ते सर्वमाख्यातं यथागुह्यतमं विभोः ।\nनैव देयमशिष्याय नाभक्ताय कदाचन ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002547013, "chapter_id": 22547, "verse_number": "१-२०९-१४", "content_sanskrit": "न च पापकृते देयं न देयं नास्तिकाय वा ।\nकृतघ्ने नास्तिके वीर न देयं क्रूरकर्मणि ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002547014, "chapter_id": 22547, "verse_number": "१-२०९-१५", "content_sanskrit": "य इदं शृणुयान्नित्यं सप्तमीव्रतमुत्तमम् ।\nपठेद्यश्चापि नियतः श्रद्धया परयान्वितः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002547015, "chapter_id": 22547, "verse_number": "१-२०९-१६", "content_sanskrit": "इह लोके सुखं प्राप्य सूर्यलोके महीयते ।\nपुण्यक्षयादिहागत्य राजा भवति भूतले ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]