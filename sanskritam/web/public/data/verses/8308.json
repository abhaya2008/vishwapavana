[{"id": 900003843, "chapter_id": 8308, "verse_number": "4.1", "content_sanskrit": "मनोस्तु शतरूपायां तिस्रः कन्याश्च जज्ञिरे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900003844, "chapter_id": 8308, "verse_number": "4.2", "content_sanskrit": "भवे शीलवतां श्रेष्ठे दक्षो दुहितृवत्सलः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900003845, "chapter_id": 8308, "verse_number": "4.3", "content_sanskrit": "सदा विद्विषतोरेवं कालो विवदमानयोः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900003846, "chapter_id": 8308, "verse_number": "4.4", "content_sanskrit": "एतावदुक्त्वा विरराम शङ्करः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900003847, "chapter_id": 8308, "verse_number": "4.5", "content_sanskrit": "इत्यध्वरे दक्षमनूद्य शत्रुहन्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900003848, "chapter_id": 8308, "verse_number": "4.6", "content_sanskrit": "भवो भवान्या निधनं प्रजापतेरसत्कृताया ह्यवगम्य नारदात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900003849, "chapter_id": 8308, "verse_number": "4.7", "content_sanskrit": "अथ देवगणाः सर्वे रुद्रानीकैः पराजिताः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900003850, "chapter_id": 8308, "verse_number": "4.8", "content_sanskrit": "इत्यजेनानुनीतेन भवेन परितुष्यता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900003851, "chapter_id": 8308, "verse_number": "4.9", "content_sanskrit": "सनकाद्या नारदश्च ऋभुर्हंसोऽरुणिर्यतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900003852, "chapter_id": 8308, "verse_number": "4.10", "content_sanskrit": "त एवमुत्सन्नभया उरुक्रमे कृतप्रणामाः प्रययुस्त्रिविष्टपम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900003853, "chapter_id": 8308, "verse_number": "4.11", "content_sanskrit": "प्रजापतेर्दुहितरं शिंशुमारस्य वै ध्रुवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900003854, "chapter_id": 8308, "verse_number": "4.12", "content_sanskrit": "ध्रुवं निवृत्तं प्रतिबुध्य वैशसादपेतमन्युर्भगवान् धनेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900003855, "chapter_id": 8308, "verse_number": "4.13", "content_sanskrit": "निशम्य कोषारविणोपवर्णितं ध्रुवस्य वैकुण्ठपदाधिरोहणम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900003856, "chapter_id": 8308, "verse_number": "4.14", "content_sanskrit": "भृग्वादयस्ते मुनयो लोकानां क्षेमदर्शिनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900003857, "chapter_id": 8308, "verse_number": "4.15", "content_sanskrit": "अत्र तु प्रथमो राज्ञां पुमान् प्रथयिता यशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900003858, "chapter_id": 8308, "verse_number": "4.16", "content_sanskrit": "इति ब्रुवाणं नृपतिं गायका मुनिचोदिताः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900003859, "chapter_id": 8308, "verse_number": "4.17", "content_sanskrit": "एवं स भगवान् वैन्यः ख्यापितो गुणकर्मभिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900003860, "chapter_id": 8308, "verse_number": "4.18", "content_sanskrit": "इत्थं पृथुमभिष्टूय रुषा प्रस्फुरिताधरम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900003861, "chapter_id": 8308, "verse_number": "4.19", "content_sanskrit": "अथादीक्षत राजर्षिर्हयमेधशतेन सः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900003862, "chapter_id": 8308, "verse_number": "4.20", "content_sanskrit": "भगवांश्चापि वैकुण्ठः साकं मघवता विभुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900003863, "chapter_id": 8308, "verse_number": "4.21", "content_sanskrit": "मौक्तिकैः कुसुमस्रग्भिर्दुकूलैः स्वर्णतोरणैः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900003864, "chapter_id": 8308, "verse_number": "4.22", "content_sanskrit": "जनेषु प्रगृणत्स्वेवं पृथुं पृथुलविक्रमम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900003865, "chapter_id": 8308, "verse_number": "4.23", "content_sanskrit": "दृष्ट्वाऽऽत्मानं प्रवयसमेकदा वैन्य आत्मवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900003866, "chapter_id": 8308, "verse_number": "4.24", "content_sanskrit": "विजिताश्वोऽथ राजाऽऽसीत् पृथुपुत्रः पृथुश्रवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900003867, "chapter_id": 8308, "verse_number": "4.25", "content_sanskrit": "इति संदिश्य भगवान् बार्हिषदैरभिपूजितः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900003868, "chapter_id": 8308, "verse_number": "4.26", "content_sanskrit": "स एकदा महेश्वासो रथं पञ्चाश्वमाशुगम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900003869, "chapter_id": 8308, "verse_number": "4.27", "content_sanskrit": "इत्थं पुरञ्जनं सध्य्रग् वशमानीय विभ्रमैः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900003870, "chapter_id": 8308, "verse_number": "4.28", "content_sanskrit": "सैनिका भयनाम्नो ये बर्हिष्मन् दिष्टकारिणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 900003871, "chapter_id": 8308, "verse_number": "4.29", "content_sanskrit": "भगवंस्ते वचोऽस्माभिर्न सम्यगवगम्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 900003872, "chapter_id": 8308, "verse_number": "4.30", "content_sanskrit": "ये त्वयाऽभिहिता ब्रह्मन् सुताः प्राचीनबर्हिषः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 900003873, "chapter_id": 8308, "verse_number": "4.31", "content_sanskrit": "तत उत्पन्नविज्ञाना आश्वधोक्षजभाषितम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]