[{"id": 2073191, "chapter_id": 2545, "verse_number": "१२-५०-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2073192, "chapter_id": 2545, "verse_number": "१२-५०-१", "content_sanskrit": "श्रुत्वा तु वचनं भीष्मो वासुदेवस्य धीमतः।\nकिंचिदुन्नाम्य वदनं प्राञ्जलिर्वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2073193, "chapter_id": 2545, "verse_number": "१२-५०-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2073194, "chapter_id": 2545, "verse_number": "१२-५०-२", "content_sanskrit": "नमस्ते भगवन्कृष्ण लोकानां प्रभवाप्यय।\nत्वं हि कर्ता हृषीकेश संहर्ता चापराजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2073195, "chapter_id": 2545, "verse_number": "१२-५०-३", "content_sanskrit": "विश्वकर्मन्नमस्तेऽस्तु विश्वात्मन्विश्वसंभव।\nअपवर्गस्थ भूतानां पञ्चानां परतः स्थित॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2073196, "chapter_id": 2545, "verse_number": "१२-५०-४", "content_sanskrit": "नमस्ते त्रिषु लोकेषु नमस्ते परतस्त्रिषु।\nयोगेश्वर नमस्तेऽस्तु त्वं हि सर्वपरायणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2073197, "chapter_id": 2545, "verse_number": "१२-५०-५", "content_sanskrit": "मत्संश्रितं यदात्थ त्वं वचः पुरुषसत्तम।\nतेन पश्यामि ते दिव्यान्भावांस्त्रिषु च वर्त्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2073198, "chapter_id": 2545, "verse_number": "१२-५०-६", "content_sanskrit": "तच्च पश्यामि तत्वेन यत्ते रूपं सनातनम्।\nसप्त मार्गा निरुद्धास्ते वायोरमिततेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2073199, "chapter_id": 2545, "verse_number": "१२-५०-७", "content_sanskrit": "दिवं ते शिरसा व्याप्तं पभ्द्यां देवी वसुंधरा।\nदिशो भुजा रविश्चक्षुर्वीर्ये शुक्रः प्रतिष्ठितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2073200, "chapter_id": 2545, "verse_number": "१२-५०-८", "content_sanskrit": "अतसीपुष्पसंकाशं पीतवाससमच्युतम्।\nवपुर्ह्यनुमिमीमस्ते मेघस्येव सविद्युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2073201, "chapter_id": 2545, "verse_number": "१२-५०-९", "content_sanskrit": "त्वां प्रपन्नाय भक्ताय गतिमिष्टां जिगीषवे।\nयच्छ्रेयः पुण्डरीकाक्ष तद्ध्यायस्व सुरोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2073202, "chapter_id": 2545, "verse_number": "१२-५०-१०x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2073203, "chapter_id": 2545, "verse_number": "१२-५०-१०", "content_sanskrit": "यतः खलु परा भक्तिर्मयि ते पुरुषर्षभ।\nततो मया वपुर्दिव्यं तव राजन्प्रदर्शितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2073204, "chapter_id": 2545, "verse_number": "१२-५०-११", "content_sanskrit": "न ह्यभक्ताय राजेन्द्र भक्तायानृजवे न च।\nदर्शयाम्यहमात्मानं न चादान्ताय भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2073205, "chapter_id": 2545, "verse_number": "१२-५०-१२", "content_sanskrit": "भवांस्तु मम भक्तश्च नित्यं चार्जवमास्थितः।\nदमे तपसि सत्ये च दाने च निरतः शुचिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2073206, "chapter_id": 2545, "verse_number": "१२-५०-१३", "content_sanskrit": "अर्हस्त्वं भीष्म मां द्रष्टुं तपसा स्वेन पार्थिव।\nतव ह्युपस्थिता लोका येभ्यो नावर्तते पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2073207, "chapter_id": 2545, "verse_number": "१२-५०-१४", "content_sanskrit": "पञ्चाशतं षट् च कुरुप्रवीर\nशेषं दिनानां तव जीवितस्य।\nततः शुभैः कर्मफलोदयैस्त्वं\nसमेष्यसे भीष्म विमुच्य देहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2073208, "chapter_id": 2545, "verse_number": "१२-५०-१५", "content_sanskrit": "एते हि देवा वसवो विमाना\nन्यास्थाय सर्वे ज्वलिताग्निकल्पाः।\nअन्तर्हितास्त्वां प्रतिपालयन्ति\nकाष्ठां प्रपद्यन्तमुदक्पतङ्गाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2073209, "chapter_id": 2545, "verse_number": "१२-५०-१६", "content_sanskrit": "व्यावृत्तमात्रे भगवत्युदीचीं\nसूर्ये जगत्कालवशं प्रपन्ने।\nगन्तासि लोकान्पुरुषप्रवीर\nनावर्तते यानुपलभ्य विद्वान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2073210, "chapter_id": 2545, "verse_number": "१२-५०-१७", "content_sanskrit": "अमुं च लोकं त्वयि भीष्म याते\nज्ञानानि सर्वाणि पराभविष्यन्।\nअतस्तु सर्वे तव सन्निकर्षं\nसमागता धर्मविवेचनाय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2073211, "chapter_id": 2545, "verse_number": "१२-५०-१८", "content_sanskrit": "तज्ज्ञातिशोकोपहतश्रुताय\nसत्याभिसन्धाय युधिष्ठिराय।\nप्रब्रूषि धर्मार्थसमाधियुक्तं\nसत्यं वचोऽस्यापनुदेच्छुचं यत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2073212, "chapter_id": 2545, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि पञ्चाशोऽध्यायः॥ ५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]