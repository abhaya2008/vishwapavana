[{"id": 6000144000, "chapter_id": 10144, "verse_number": null, "content_sanskrit": "अथ षष्ठाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "topics": [{"text": "‘अन्तःपुरस्थस्य तव ज्ञानप्राप्तिः कथम्?’ इति असुरबालकैः", "range": null}]}, {"id": 6000144001, "chapter_id": 10144, "verse_number": null, "content_sanskrit": "प्रह्लाद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.001.m4a", "display_order": 2}, {"id": 6000144002, "chapter_id": 10144, "verse_number": "७-६-१", "content_sanskrit": "हन्तार्भका मे शृृणुत वचो वः सर्वतः शिवम्।\nवयस्यान् पश्यत मृतान् क्रीडान्धा मा प्रमाद्यथ॥ ७/६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.002.m4a", "display_order": 3, "topics": [{"text": "प्रह्लादेनासुरबालकेभ्यः परतत्त्वोपदेशः", "range": "१–३३"}]}, {"id": 6000144003, "chapter_id": 10144, "verse_number": "७-६-२", "content_sanskrit": "नेतः पुरातना बाला आत्मनोऽर्थे प्रियैषिणः।\nगुरूक्तमपि न ग्राह्यं यदनर्थेऽर्थकल्पनम्॥ ७/६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.003.m4a", "display_order": 4}, {"id": 6000144004, "chapter_id": 10144, "verse_number": "७-६-३", "content_sanskrit": "यदुक्त्या न प्रबुध्येत सुप्तस्त्वज्ञाननिद्रया।\nन श्रद्दध्यान्मतं तस्य यथाऽन्धो ह्यन्धनायकः॥ ७/६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.004.m4a", "display_order": 5}, {"id": 6000144005, "chapter_id": 10144, "verse_number": "७-६-४", "content_sanskrit": "कः शत्रुः क उदासीनः किं मित्रं चेह आत्मनः।\nभवत्स्वपि नयैः किं स्याद् दैवं सम्पद्विपत्पदम्॥ ७/६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.005.m4a", "display_order": 6}, {"id": 6000144006, "chapter_id": 10144, "verse_number": "७-६-५", "content_sanskrit": "यो न हिंस्याद् धर्मकाममात्मानं स्वजनेऽवशः।\nपुनः श्रीलोकयोर्हेतुः स मुक्तान्ध्योऽतिदुर्लभः॥ ७/६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.006.m4a", "display_order": 7}, {"id": 6000144007, "chapter_id": 10144, "verse_number": null, "content_sanskrit": "प्रह्लाद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.007.m4a", "display_order": 8}, {"id": 6000144008, "chapter_id": 10144, "verse_number": "७-६-६", "content_sanskrit": "कौमार आचरेत् प्राज्ञो धर्मान् भागवतानिह।\nदुर्लभं मानुषं जन्म तदप्यध्रुवमर्थदम्॥ ७/६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.008.m4a", "display_order": 9}, {"id": 6000144009, "chapter_id": 10144, "verse_number": "७-६-७", "content_sanskrit": "यदा हि पुरुषस्येह विष्णोः पादोपसर्पणम्।\nयदेष सर्वभूतानां प्रिय आत्मेश्वरः सुहृत्॥ ७/६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.009.m4a", "display_order": 10}, {"id": 6000144010, "chapter_id": 10144, "verse_number": "७-६-८", "content_sanskrit": "सुखमैन्द्रियकं दैत्या देहयोगेन देहिनाम्।\nसर्वत्र लभ्यते दैवाद् यथा दुःखमयत्नतः॥ ७/६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.010.m4a", "display_order": 11}, {"id": 6000144011, "chapter_id": 10144, "verse_number": "७-६-९", "content_sanskrit": "तत् प्रयासो न कर्तव्यो यत आयुर्व्ययः परम्।\nन तथा विन्दते क्षेमं मुकुन्दचरणाम्बुजम्॥ ७/६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.011.m4a", "display_order": 12}, {"id": 6000144012, "chapter_id": 10144, "verse_number": "७-६-१०", "content_sanskrit": "ततो यतेत कुशलः क्षेमाय च यमाश्रितः।\nशरीरं पौरुषं यावन्न विपद्येत पुष्कलम्॥ ७/६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.012.m4a", "display_order": 13}, {"id": 6000144013, "chapter_id": 10144, "verse_number": "७-६-११", "content_sanskrit": "पुंसां वर्षशतं ह्यायुः तदर्धं चाजितात्मनः।\nनिष्फलं यदसौ रात्र्यां शेतेऽन्धं प्रापितस्तमः॥ ७/६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.013.m4a", "display_order": 14}, {"id": 6000144014, "chapter_id": 10144, "verse_number": "७-६-१२", "content_sanskrit": "मुग्धस्य बाल्यकौमारैः क्रीडतो याति विंशतिः।\nजरया ग्रस्तदेहस्य यात्यकल्पस्य विंशतिः॥ ७/६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.014.m4a", "display_order": 15}, {"id": 6000144015, "chapter_id": 10144, "verse_number": "७-६-१३", "content_sanskrit": "दुरापूरेण कामेन मोहेन च बलीयसा।\nशेषं गृहेषु सक्तस्य प्रमत्तस्यापयाति हि॥ ७/६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.015.m4a", "display_order": 16}, {"id": 6000144016, "chapter_id": 10144, "verse_number": "७-६-१४", "content_sanskrit": "पश्यध्वं मतिवैषम्यंज्ञातीनां नः कुटुम्बिनाम्।\nश्रेयोविघातादायासादीहतामनु संसृतिम्॥ ७/६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.016.m4a", "display_order": 17}, {"id": 6000144017, "chapter_id": 10144, "verse_number": "७-६-१५", "content_sanskrit": "को गृहेषु पुमान् सक्तमात्मानमजितेन्द्रियः।\nस्नेहपाशैर्दृढं बद्धमुत्सहेत विमोचितुम्॥ ७/६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.017.m4a", "display_order": 18}, {"id": 6000144018, "chapter_id": 10144, "verse_number": "७-६-१६", "content_sanskrit": "को न्वर्थतृष्णां विसृजेत् प्राणेभ्योऽपि य ईप्सितः।\nयं क्रीणात्यसुभिः प्रेष्ठैस्तस्करः सेवको वणिक्॥ ७/६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.018.m4a", "display_order": 19}, {"id": 6000144019, "chapter_id": 10144, "verse_number": "७-६-१७", "content_sanskrit": "कथं प्रियाया अनुकम्पितायाः सङ्गं रहस्यं रुचिरांश्च मन्त्रान्।\nसुहृत्सुतस्नेहवशः शिशूनां कलाक्षराणामनुरक्तचित्तः॥ ७/६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.019.m4a", "display_order": 20}, {"id": 6000144020, "chapter_id": 10144, "verse_number": "७-६-१८", "content_sanskrit": "प्रत्ताः स्मरंस्ता दुहितॄर्हृदय्या भ्रातॄन् स्वसॄर्वा पितरौ च दीनौ।\nगृहान् मनोज्ञान् रुचिरच्छदांश्च वृत्तीश्च कुल्याः पशुभृत्यवर्गान्॥ ७/६/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.020.m4a", "display_order": 21}, {"id": 6000144021, "chapter_id": 10144, "verse_number": "७-६-१९", "content_sanskrit": "त्यजेत कोशस्थ इवेहमानः कर्माणि लोभादवितृप्तकामः।\nऔपस्थ्यजैह्व्यं बहुमन्यमानः कथं विरज्येत दुरन्तमोहः॥ ७/६/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.021.m4a", "display_order": 22}, {"id": 6000144022, "chapter_id": 10144, "verse_number": "७-६-२०", "content_sanskrit": "कुटुम्बपोषाय च यन्निजायुर्न बुध्यतेऽर्थं विहितं प्रमत्तः।\nसर्वत्र तापत्रयदुःखितात्मा निर्विद्यते न स्वकुटुम्बरामः॥ ७/६/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.022.m4a", "display_order": 23}, {"id": 6000144023, "chapter_id": 10144, "verse_number": "७-६-२१", "content_sanskrit": "वित्तेषु नित्याभिनिविष्टचेता विद्वांश्च दोषं परवित्तहर्तुः।\nप्रेत्येह वाऽथाप्यजितेन्द्रियस्तदशान्तकामो हरते कुटुम्बी॥ ७/६/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.023.m4a", "display_order": 24}, {"id": 6000144024, "chapter_id": 10144, "verse_number": "७-६-२२", "content_sanskrit": "विद्वानपीत्थं दनुजाः कुटुम्बं पुष्णन् स्वलोकाय न कल्पते वै।\nयः स्वीयपारक्यविभिन्नभावस्तमः प्रपद्येत यथा विमूढः॥ ७/६/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.024.m4a", "display_order": 25}, {"id": 6000144025, "chapter_id": 10144, "verse_number": "७-६-२३", "content_sanskrit": "यतो न कश्चित्क्‍वच कुत्र विद्वान् दीनं स्वमात्मानमलं समर्थः।\nविमोचितुं वामदृशां विहारक्रीडामृगो यन्निगडोऽक्षिसर्गः॥ ७/६/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.025.m4a", "display_order": 26}, {"id": 6000144026, "chapter_id": 10144, "verse_number": "७-६-२४", "content_sanskrit": "ततो विदूरात् परिहृत्य दैत्या दैत्येषु सङ्गं विषयात्मकेषु।\nउपेत नारायणमादिदेवं स मुक्तसङ्गैरिषितोऽपवर्गः॥ ७/६/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.026.m4a", "display_order": 27}, {"id": 6000144027, "chapter_id": 10144, "verse_number": "७-६-२५", "content_sanskrit": "न ह्यच्युतं प्रीणयतो बह्वायासोऽसुरात्मजाः।\nआत्मत्वात् सर्वभूतानां सिद्धत्वादिह सर्वतः॥ ७/६/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.027.m4a", "display_order": 28}, {"id": 6000144028, "chapter_id": 10144, "verse_number": "७-६-२६", "content_sanskrit": "परावरेषु भूतेषु ब्रह्मान्तस्थावरादिषु।\nभौतिकेषु विकारेषु भूतेष्वथ महत्सु च॥ ७/६/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.028.m4a", "display_order": 29}, {"id": 6000144029, "chapter_id": 10144, "verse_number": "७-६-२७", "content_sanskrit": "गुणेषु गुणसाम्ये च गुणव्यतिकरे तथा।\nएक एव परो ह्यात्मा भगवानीश्वरोऽव्ययः॥ ७/६/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.029.m4a", "display_order": 30}, {"id": 6000144030, "chapter_id": 10144, "verse_number": "७-६-२८", "content_sanskrit": "प्रत्यगात्मस्वरूपेण कालरूपेण च स्वयम्।\nव्याप्यव्यापकनिर्देश्यो ह्यनिर्देश्यो विकल्पितः॥ ७/६/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.030.m4a", "display_order": 31}, {"id": 6000144031, "chapter_id": 10144, "verse_number": "७-६-२९", "content_sanskrit": "केवलानुभवानन्दस्वरूपः परमेश्वरः।\nमाययान्तर्हितैश्वर्य ईयते गुणसर्गया॥ ७/६/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.031.m4a", "display_order": 32}, {"id": 6000144032, "chapter_id": 10144, "verse_number": "७-६-३०", "content_sanskrit": "तस्मात् सर्वेषु भूतेषु दयां कुरुत सौहृदम्।\nभावमासुरमुन्मुच्य तया तुष्यत्यधोक्षजः॥ ७/६/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.032.m4a", "display_order": 33}, {"id": 6000144033, "chapter_id": 10144, "verse_number": "७-६-३१", "content_sanskrit": "तुष्टे चतत्र किमलभ्यमनन्त ईशे किं तैर्गुणव्यतिकरैरिह येऽनुसिद्धाः।\nधर्मादिभिः किमगुणेन च काङ्क्षितेन सारंजुषां चरणयोरुपगायतां नः॥ ७/६/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.033.m4a", "display_order": 34}, {"id": 6000144034, "chapter_id": 10144, "verse_number": "७-६-३२", "content_sanskrit": "धर्मार्थकाम इति यो विहितस्‍त्रिवर्ग ईक्षा त्रयी नयदमौ विविधा च वार्ता।\nमन्ये तदेतदखिलं निगमस्य सत्यं स्वात्मार्पणं स्वसुह्रदः परमस्य पुंसः॥ ७/६/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.034.m4a", "display_order": 35}, {"id": 6000144035, "chapter_id": 10144, "verse_number": "७-६-३३", "content_sanskrit": "ज्ञानं तदेतदमलं दुरवापमाह नारायणो नरसखः किल नारदाय।\nएकान्तिनां भगवतस्तदकिञ्चनानां पादारविन्दरजसाऽऽप्लुतदेहिनां स्यात्॥ ७/६/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.035.m4a", "display_order": 36}, {"id": 6000144036, "chapter_id": 10144, "verse_number": "७-६-३४", "content_sanskrit": "श्रुतमेतन्मया पूर्वं ज्ञानं विज्ञानसंयुतम्।\nधर्मं भागवतं शुद्धं नारदाद् देवदर्शनात्॥ ७/६/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.036.m4a", "display_order": 37, "topics": [{"text": "प्रह्लादं प्रति प्रश्नः", "range": "३४–३६"}]}, {"id": 6000144037, "chapter_id": 10144, "verse_number": null, "content_sanskrit": "दैत्यपुत्रा ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.037.m4a", "display_order": 38}, {"id": 6000144038, "chapter_id": 10144, "verse_number": "७-६-३५", "content_sanskrit": "प्रह्लाद त्वं वयं चापि नर्तेऽन्यं विद्महे गुरुम्।\nएताभ्यां गुरुपुत्राभ्यां बालानामपि हीश्वरः॥ ७/६/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.038.m4a", "display_order": 39}, {"id": 6000144039, "chapter_id": 10144, "verse_number": "७-६-३६", "content_sanskrit": "बालस्यान्तःपुरस्थस्य महत्सङ्गो दुरन्वयः।\nछिन्धि नः संशयं सौम्य स्याच्चेद् विस्रम्भकारणम्॥ ७/६/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_006/BhP_07.006.039.m4a", "display_order": 40}, {"id": 6000144040, "chapter_id": 10144, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां सप्तमस्कन्धे षष्ठाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]