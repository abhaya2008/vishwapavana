[{"id": 2209250, "chapter_id": 5470, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2209251, "chapter_id": 5470, "verse_number": "१", "content_sanskrit": "ततस्ते प्रययुर्हृष्टाः सबलाः सहवाहनाः ।\nरथघोषेण महता पूरयन्तो वसुन्धराम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2209252, "chapter_id": 5470, "verse_number": "२", "content_sanskrit": "संस्तूयमानाः स्तुतिभिः सूतमागधवन्दिभिः ।\nस्वेन सैन्येन सहिता यथाऽऽदित्याः स्वरश्मिभिः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2209253, "chapter_id": 5470, "verse_number": "३", "content_sanskrit": "पाण्डुरेणातपत्रेण ध्रियमाणेन मूर्धनि ।\nबभौ युधिष्ठिरस्तत्र पौर्णमास्यामिवोडुराट् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2209254, "chapter_id": 5470, "verse_number": "४", "content_sanskrit": "जयाशिषः प्रहृष्टास्ते नराणां पथि पार्थिवाः ।\nप्रत्यगृह्णत् यथान्यायं यथावद् भरतर्षभ ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2209255, "chapter_id": 5470, "verse_number": "५", "content_sanskrit": "तथैव सैनिका राजन् राजानमनुयान्ति ये ।\nतेषां हलहलाशब्दो दिगन्तं व्याप्य तिष्ठत ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2209256, "chapter_id": 5470, "verse_number": "६", "content_sanskrit": "स सरांसि नदीश्चैव वनान्युपवनानि च ।\nअत्यक्रामन्महाराजो गिरिं चाप्यन्वपद्यत ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2209257, "chapter_id": 5470, "verse_number": "७", "content_sanskrit": "तस्मिन् देशे च राजेन्द्र यत्र तद् द्रव्यमुत्तमम् ।\nचक्रे निवेशनं राजा पाण्डवः सहसैनिकैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2209258, "chapter_id": 5470, "verse_number": "८", "content_sanskrit": "शिवे देशे समे चैव तदा भरतसत्तम ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2209259, "chapter_id": 5470, "verse_number": "९", "content_sanskrit": "अग्रतो ब्राह्मणान् कृत्वा तपोविद्यादमान्वितान् ।\nपुरोहितं च कौरव्य वेदवेदाङ्गपारगम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2209260, "chapter_id": 5470, "verse_number": "१०", "content_sanskrit": "प्राङ्निवेशात्तु राजानं ब्राह्मणाः सपुरोहिताः ।\nकृत्वा शान्तिं यथान्यायं सर्वतः पर्यवारयन् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2209261, "chapter_id": 5470, "verse_number": "११", "content_sanskrit": "कृत्वा मध्ये च राजानममात्यांश्च यथाविधि ।\nषट्पदं नवसंस्थानं निवेशं चक्रिरे जनाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2209262, "chapter_id": 5470, "verse_number": "१२", "content_sanskrit": "मत्तानां वारणेन्द्राणां निवेशं च यथाविधि ।\nकारयित्वा स राजेन्द्रो ब्राह्मणानिदमब्रवीत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2209263, "chapter_id": 5470, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2209264, "chapter_id": 5470, "verse_number": "१३", "content_sanskrit": "अस्मिन् कार्ये द्विजश्रेष्ठा नक्षत्रे दिवसे शुभे ।\nयथा भवन्तो मन्यन्ते कर्तुमर्हन्ति तद्विदः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2209265, "chapter_id": 5470, "verse_number": "१४", "content_sanskrit": "न नः कालात्ययो वै स्याद् इहैव परितिष्ठताम् ।\nइति निश्चित्य विप्रेन्द्राः क्रियतां यदनन्तरम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2209266, "chapter_id": 5470, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2209267, "chapter_id": 5470, "verse_number": "१५", "content_sanskrit": "श्रुत्वैतद् वचनं राज्ञो ब्राह्मणाः सपुरोधसः ।\nइदमूचुर्वचो हृष्टा धर्मराजप्रियेप्सवः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2209268, "chapter_id": 5470, "verse_number": "", "content_sanskrit": "ब्राह्मणाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2209269, "chapter_id": 5470, "verse_number": "१६", "content_sanskrit": "अद्यैव नक्षत्रमहश्च पुण्यं\nयतामहे श्रेष्ठतमं क्रियासु ।\nतपोभिरद्येह वसाम राजन्\nउपोष्यतां चापि भवद्भिरद्य ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2209270, "chapter_id": 5470, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2209271, "chapter_id": 5470, "verse_number": "१७", "content_sanskrit": "श्रुत्वा तु तेषां द्विजसत्तमानां\nकृतोपवासा रजनीं नरेन्द्राः ।\nऊषुः प्रतीताः कुशसंस्तरेषु\nयथाऽध्वरेषूज्ज्वलिता हव्यवाहाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2209272, "chapter_id": 5470, "verse_number": "१८", "content_sanskrit": "ततो निशा सा व्यगमन्महात्मनां\nसंशृण्वतां विप्रसमीरिता गिरः ।\nततः प्रभाते विमले द्विजर्षभा\nवचोऽब्रुवन् धर्मसुतं नराधिपम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2209273, "chapter_id": 5470, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि द्रव्यानयने देहशुद्धिकथनं नाम चतुःषष्टितमोऽध्यायः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]