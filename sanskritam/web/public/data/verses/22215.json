[{"id": 7002215000, "chapter_id": 22215, "verse_number": "२६०-१", "content_sanskrit": "पुष्कर उवाच ।\nयजुर्विधानं वक्ष्यामि भुक्तिमुक्तिप्रदं श्रृणु ।\nओंकारपूर्व्विका राम महाव्याहृतयो मता ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002215001, "chapter_id": 22215, "verse_number": "२६०-२", "content_sanskrit": "सर्व्वकल्मषनाशिन्यः सर्व्वकामप्रदास्तथा ।\nआज्यहुतिसहस्रेण देवानाराधयेद्बुधः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002215002, "chapter_id": 22215, "verse_number": "२६०-३", "content_sanskrit": "मनसः काङ्क्षितं राम मनसेप्सितकामदं ।\nशान्तिकामो यवैः कुर्य्यात्तिलैः पापापनुत्तये ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002215003, "chapter_id": 22215, "verse_number": "२६०-४", "content_sanskrit": "धान्यैः सिद्धार्थकैश्चैव सर्व्वकामकरैस्तथा ।\nऔदुम्बरीभिरिध्मामिः पशुकामस्य शस्यते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002215004, "chapter_id": 22215, "verse_number": "२६०-५", "content_sanskrit": "दध्ना चैवान्नकामस्य पथसा शान्तिमिच्छतः ।\nअपामार्गसमिद्भिस्तु कामयन् कनकं बहु ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002215005, "chapter_id": 22215, "verse_number": "२६०-६", "content_sanskrit": "कन्याकामो घृताक्तानि युग्मशो ग्रथितानि तु ।\nजातीपुष्पाणि जुहुयाद्ग्रामार्थी तिलतण्डुलान् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002215006, "chapter_id": 22215, "verse_number": "२६०-७", "content_sanskrit": "वश्यकर्मणि शाखोटवासापामार्गमेव च ।\nविषासृङ्मिश्रसमिधो व्याधिघातस्य भार्गव ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002215007, "chapter_id": 22215, "verse_number": "२६०-८", "content_sanskrit": "क्रुद्धस्तु जुहुयात्सम्यक् शत्रूणां वधकाम्यया ।\nसर्व्वव्रीहिमयीं कृत्वा राज्ञः प्रतिकृतिं द्विज ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002215008, "chapter_id": 22215, "verse_number": "२६०-९", "content_sanskrit": "सहस्नशस्तु जुहुयाद्राजा वशगतो भवेत् ।\nवस्त्रकामस्य पुष्पाणि दूर्व्वा व्याधिविनाशिनी ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002215009, "chapter_id": 22215, "verse_number": "२६०-१०", "content_sanskrit": "ब्रह्मवर्च्चसकामस्य वासोग्रञ्च विधीयते ।\nप्रत्यङ्गिरेषु जुहुयात्तुषकण्टकभस्मभिः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002215010, "chapter_id": 22215, "verse_number": "२६०-११", "content_sanskrit": "विद्वेषणे च पक्ष्माणि काककौशिकयोस्तथा ।\nकापिलञ्च घृतं हुत्वा तथा चन्द्रग्रहे द्विज ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002215011, "chapter_id": 22215, "verse_number": "२६०-१२", "content_sanskrit": "वचाचूर्णेन सम्पातात्समानीय च तां वचां ।\nसहस्रमन्त्रितां भुक्त्वा मेधावी जायते नरः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002215012, "chapter_id": 22215, "verse_number": "२६०-१३", "content_sanskrit": "एकादशाङ्गुलं शङ्कु लौहं खादिरमेव च ।\nद्विषतो वधोसीति जपन्निखनेद्रिपुवेश्मनि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002215013, "chapter_id": 22215, "verse_number": "२६०-१४", "content_sanskrit": "उच्चाटनमिदं कर्म शत्रूणां कथितं तव ।\nचक्षुष्पा इति जप्त्वा च विनष्टञ्चक्षुराप्नुयात् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002215014, "chapter_id": 22215, "verse_number": "२६०-१५", "content_sanskrit": "उपयुञ्जत इत्येतदनुवाकन्तथान्नदं ।\nतनूपाग्ने सदिति दूर्व्वां हुत्वार्त्तिवर्ज्जितः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002215015, "chapter_id": 22215, "verse_number": "२६०-१६", "content_sanskrit": "भेषजमसीति दध्याज्यैर्होमः पशूपसर्गनुत् ।\nत्रियम्बकं यजामहे होमः सौभाग्यवर्द्धनः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002215016, "chapter_id": 22215, "verse_number": "२६०-१७", "content_sanskrit": "कन्यानाम गृहीत्वा तु कन्यालाभकरः परः ।\nभयेषु तु जपेन्नित्यं भयेभ्यो विप्रमुच्यते ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002215017, "chapter_id": 22215, "verse_number": "२६०-१८", "content_sanskrit": "धुस्तूरपुष्पं सघृतं हुत्वा स्यात् सर्वकामभाक् ।\nहुत्वा तु गुग्गुलं राम स्वप्ने पश्यति शङ्करं ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002215018, "chapter_id": 22215, "verse_number": "२६०-१९", "content_sanskrit": "युञ्चते मनोऽनुवाकं जप्त्वा दीर्घायुराप्नुयात् ।\nविष्णोरराटमित्येतत् सर्वबाधाविनाशनं ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002215019, "chapter_id": 22215, "verse_number": "२६०-२०", "content_sanskrit": "रक्षोघ्नञ्च यशस्यञ्च तथैव विजयप्रदं ।\nअयन्नो अग्निरित्येतत् संग्रामे विजयप्रदं ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002215020, "chapter_id": 22215, "verse_number": "२६०-२१", "content_sanskrit": "इदमापः प्रवहत स्नाने पापापनोदनं ।\nविश्वकर्मन्नु हविषा सूचीं लौहीन्दशाङ्गुलाम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002215021, "chapter_id": 22215, "verse_number": "२६०-२२", "content_sanskrit": "कन्याया निखनेद् द्वारि साऽन्यस्मै न प्रदीयते ।\nदेव सवितरेतेन हुतेनैतेन चान्नवान् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002215022, "chapter_id": 22215, "verse_number": "२६०-२३", "content_sanskrit": "अग्नौ स्वाहेति जुहुयाद्बलकामो द्विजोत्तम ।\nतिलैर्यवैश्च धर्मज्ञ तथापामार्गतण्डुलैः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002215023, "chapter_id": 22215, "verse_number": "२६०-२४", "content_sanskrit": "सहस्रमन्त्रितां कृत्वातथा गोरोचनां द्विज ।\nतिलकञ्च तथा कृत्वा जनस्यप्रियकामियात् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002215024, "chapter_id": 22215, "verse_number": "२६०-२५", "content_sanskrit": "रुद्राणाञ्च तथा जप्यं सर्व्वाघविनिसूदनं ।\nसर्व्वकर्मकरो होमस्तथा सर्व्वत्र शान्तिदः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002215025, "chapter_id": 22215, "verse_number": "२६०-२६", "content_sanskrit": "अजाविकानामश्वानां कुञ्जराणां तथा गवां ।\nमनुष्याणान्नरेन्द्राणां बालानां योषितामपि ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002215026, "chapter_id": 22215, "verse_number": "२६०-२७", "content_sanskrit": "ग्रामाणां नगराणाञ्च देशानामपि भार्गव ।\nउपद्रुतानां धर्मज्ञ व्याधितानां तथैव च ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002215027, "chapter_id": 22215, "verse_number": "२६०-२८", "content_sanskrit": "मरके समनुप्राप्ते रिपुजे च तथा भये ।\nरुद्रहोमः परा शान्तिः पायसेन घृतेन च ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002215028, "chapter_id": 22215, "verse_number": "२६०-२९", "content_sanskrit": "कुष्माण्डघृतहोमेन सर्व्वान् पापान् व्यपोहति ।\nशक्तुयावकभैक्षाशी नक्तं मनुजसत्तम ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002215029, "chapter_id": 22215, "verse_number": "२६०-३०", "content_sanskrit": "बहिःस्नानरतो मासान्मुच्यते ब्रह्यहत्यया ।\nमधुवातेति मन्त्रेण होमादितोऽखिलं लभेत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002215030, "chapter_id": 22215, "verse_number": "२६०-३१", "content_sanskrit": "दधिक्राव्णेति हुत्वा तु पुत्रान् प्राप्नोत्यसंशयं ।\nतथा घृतवतीत्येतदायुष्यं स्यात् घृतेन तु ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002215031, "chapter_id": 22215, "verse_number": "२६०-३२", "content_sanskrit": "स्वस्ति न इन्द्र इत्येतत्सर्व्वबाधाविनाशनं ।\nइह गावः प्रजायध्वमिति पुष्टिविवर्धनम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002215032, "chapter_id": 22215, "verse_number": "२६०-३३", "content_sanskrit": "घृताहुतिसहस्रेण तथाऽलक्ष्मीविनाशनं ।\nस्रुवेण देवस्य त्वेति हुत्वापामार्गतण्डुलं ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002215033, "chapter_id": 22215, "verse_number": "२६०-३४", "content_sanskrit": "मुच्यते विकृताच्छीघ्रमभिचारान्न संशयः ।\nरुद्र पातु पलाशस्य समिद्भिः कनकं लभेत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002215034, "chapter_id": 22215, "verse_number": "२६०-३५", "content_sanskrit": "शिवो भवेत्यग्न्युत्पाते व्रीहिभिर्जुहुयान्नरः ।\nयाः सेना इति चैतच्च तस्करेभ्यो भयापहम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002215035, "chapter_id": 22215, "verse_number": "२६०-३६", "content_sanskrit": "यो अस्मभ्यमरातीयाद्धुत्वा कृष्णतिलान्नरः ।\nसहस्रशोऽभिचारच्च मुच्यते विकृताद् द्विज ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002215036, "chapter_id": 22215, "verse_number": "२६०-३७", "content_sanskrit": "अन्नेनान्नपतेत्येवं हुत्वा चान्नमवाप्नुयात् ।\nहंसः शुचिः सदित्येतज्जप्तन्तोयेऽघनाशनं ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002215037, "chapter_id": 22215, "verse_number": "२६०-३८", "content_sanskrit": "चत्वारि शृङ्गेत्येतत्तु सर्व्वपापहरं जले ।\nदेवा यज्ञेति जप्त्वा तु ब्रह्मलोके महीयते ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002215038, "chapter_id": 22215, "verse_number": "२६०-३९", "content_sanskrit": "वसन्तेति च हुत्वाज्यं आदित्याद्वरमाप्नुयात् ।\nसुपर्णोसीति चेत्यस्य कर्मव्याहृतिवद्भवेत् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002215039, "chapter_id": 22215, "verse_number": "२६०-४०", "content_sanskrit": "नमः स्वाहेति त्रिर्ज्जप्त्वा बन्धनान्मोक्षमाप्नुयात् ।\nअन्तर्ज्जले त्रिरावर्त्य द्रुपदा सर्व्वपापमुक् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002215040, "chapter_id": 22215, "verse_number": "२६०-४१", "content_sanskrit": "इह गावः प्रजायध्वं मन्त्रोयं बुद्धिवर्द्धनः ।\nहुतन्तु सर्पिषा दध्ना पयसा पायसेन वा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002215041, "chapter_id": 22215, "verse_number": "२६०-४२", "content_sanskrit": "शतं य इति चैतेन हुत्वा पर्णफलानि च ।\nआरोग्यं श्रियमाप्नोति जीवतञ्च चिरन्तथा ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002215042, "chapter_id": 22215, "verse_number": "२६०-४३", "content_sanskrit": "ओषधीः प्रतिमोदध्वं वपने लवनेऽर्थकृत् ।\nअश्वावती पायसेन होमाच्छान्तिमवाप्नुयात् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002215043, "chapter_id": 22215, "verse_number": "२६०-४४", "content_sanskrit": "तस्मा इति च मन्त्रेण बन्धनस्थो विमुच्यते ।\nयुवा सुवासा इत्येव वासांस्याप्नोति चोत्तमम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002215044, "chapter_id": 22215, "verse_number": "२६०-४५", "content_sanskrit": "मुञ्चन्तु मा शपथ्यानि सर्व्वान्तकविनाशनम् ।\nमा मा हिंसीस्तिलाज्येन हुतं रिपुविनाशनं ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002215045, "chapter_id": 22215, "verse_number": "२६०-४६", "content_sanskrit": "नमोऽस्तु सर्व्वसर्पेभ्यो घृतेन पायसेन तु ।\nकृणुध्वं पाज इत्येतदभिचारविनाशनं ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002215046, "chapter_id": 22215, "verse_number": "२६०-४७", "content_sanskrit": "दूर्व्वाकाण्डायुतं हुत्वा काण्डात् काण्डेति मानवः ।\nग्रामे जनपदे वापि मरकन्तु शमन्नयेत् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002215047, "chapter_id": 22215, "verse_number": "२६०-४८", "content_sanskrit": "रोगार्त्तो मुच्यते रोगात् तथा दुःखात्तु दुःखितः ।\nऔडुम्बरीश्च समिधो मधुमान्नो वनस्पतिः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002215048, "chapter_id": 22215, "verse_number": "२६०-४९", "content_sanskrit": "हुत्वा सहस्रशो राम धनमाप्नोति मानवः ।\nसौभाग्यं महदाप्नोति व्यवहारे तथा जयम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002215049, "chapter_id": 22215, "verse_number": "२६०-५०", "content_sanskrit": "अपां गर्भमिति हुत्वा देवं वर्षापयेद्ध्रुवम् ।\nअपः पिबेति च तथा हुत्वा दधि घृतं मधु ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002215050, "chapter_id": 22215, "verse_number": "२६०-५१", "content_sanskrit": "प्रवर्त्तयति धर्मज्ञ महावृष्टिमनन्तरं ।\nनमस्ते रुद्र इत्येतत् सर्व्वोपद्रवनाशनं ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002215051, "chapter_id": 22215, "verse_number": "२६०-५२", "content_sanskrit": "सर्व्वशान्तिकरं प्रोक्तं महापातकनाशनं ।\nअध्यवोचदित्यनेन रक्षणं व्याधितस्य तु ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002215052, "chapter_id": 22215, "verse_number": "२६०-५३", "content_sanskrit": "रिपूणां भयदं युद्धे नात्र कार्य्या विचारणा ।\nमानो महान्त इत्येवं बालानां शान्तिकारकं ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002215053, "chapter_id": 22215, "verse_number": "२६०-५४", "content_sanskrit": "असौ यस्ताम्र इत्येतत् पठन्नित्यं दिवाकरं ।\nउपतिष्ठेत धर्मज्ञ सायं प्रातरतन्द्रितः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002215054, "chapter_id": 22215, "verse_number": "२६०-५५", "content_sanskrit": "अन्नमक्षयमाप्नोति दीर्घमायुश्च विन्दति ।\nप्रमुञ्च धन्वन्नित्येतत् षड्भिरायुधमन्त्रणं ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002215055, "chapter_id": 22215, "verse_number": "२६०-५६", "content_sanskrit": "रिपूणां भयदं युद्धे नात्र कार्य्या विचारणा ।\nमानो महान्त इत्येवं बालानां शान्तिकारकं ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002215056, "chapter_id": 22215, "verse_number": "२६०-५७", "content_sanskrit": "नमो हिरण्यबाहवे इत्यनुवाकसप्तकम् ।\nराजिकां कटुतैलाक्तां जुहुयाच्छत्रुनाशनीं ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002215057, "chapter_id": 22215, "verse_number": "२६०-५८", "content_sanskrit": "नमो वः किरिकेभ्यश्च पद्मलक्षाहुतैर्न्नरः ।\nराज्यलक्ष्मीमवाप्नोति तथा बिल्वैः सुवर्णकम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002215058, "chapter_id": 22215, "verse_number": "२६०-५९", "content_sanskrit": "इमा रुद्रायेति तिलैर्होमाच्च धनमाप्यते ।\nदूर्वाहोमेन चान्येन सर्वव्याधिविवर्ज्जितः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002215059, "chapter_id": 22215, "verse_number": "२६०-६०", "content_sanskrit": "आशुः शिशान इत्येतदायुधानाञ्च रक्षणे ।\nसंग्रामे कथितं राम सर्वशत्रुनिबर्हणं ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002215060, "chapter_id": 22215, "verse_number": "२६०-६१", "content_sanskrit": "राजसामेति जुहुयात् सहस्रं पञ्चभिर्द्विज ।\nआज्याहुतीनां धर्मज्ञ चक्षूरोगाद्विमुच्यते ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002215061, "chapter_id": 22215, "verse_number": "२६०-६२", "content_sanskrit": "शन्नो वनस्पते गेहे होमः स्याद्वास्तुदोषनुत् ।\nअग्न आयूंषि हुत्वाज्यं द्वेषं नाप्नोति केनचित् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002215062, "chapter_id": 22215, "verse_number": "२६०-६३", "content_sanskrit": "अपां फेनेति लाजाभिर्हुत्वा जयमवाप्नुयात् ।\nभद्रा इतीन्द्रियैर्हीनो जपन् स्यात् सकलेन्द्रियः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002215063, "chapter_id": 22215, "verse_number": "२६०-६४", "content_sanskrit": "अग्निश्च पृथिवी चेति वशीकरणमुत्तमम् ।\nअध्वनेति जपन् मन्त्रं व्यवहारे जयी भवेत् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002215064, "chapter_id": 22215, "verse_number": "२६०-६५", "content_sanskrit": "ब्रह्म राजन्यमिति च कर्मारम्भे तु सिद्धिकृत् ।\nसंवत्सरोसीति धृतैलक्षहोमादरोगवान् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002215065, "chapter_id": 22215, "verse_number": "२६०-६६", "content_sanskrit": "केतुं कृण्वन्नितीत्येतत् संग्रामे जयवर्द्धनम् ।\nइन्द्रोग्निर्धर्म इत्येतद्रणे धर्मनिबन्धनम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002215066, "chapter_id": 22215, "verse_number": "२६०-६७", "content_sanskrit": "धन्वनागेति मन्त्रश्च धनुर्ग्राहणिकः परः ।\nयुञ्जीतेति तथा मन्त्रो विज्ञेयो ह्यभिमन्त्रणे ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002215067, "chapter_id": 22215, "verse_number": "२६०-६८", "content_sanskrit": "मन्त्रश्चाहिरथेत्येतच्छराणां मन्त्रणे भवेत् ।\nवह्नीनां पितरित्येरत्तूणमन्त्रः प्रकीर्त्तितः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7002215068, "chapter_id": 22215, "verse_number": "२६०-६९", "content_sanskrit": "युञ्जन्तीति तथाश्वानां योजने मन्त्र उच्यते ।\nआशुः शिशान इत्येतद्यात्रारम्भणमुच्यते ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7002215069, "chapter_id": 22215, "verse_number": "२६०-७०", "content_sanskrit": "विष्णोः क्रमेति मन्त्रश्च रथारोहणिकः परः ।\nआजङ्घेतीति चाश्वानां ताडनीयमुदाहृतं ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7002215070, "chapter_id": 22215, "verse_number": "२६०-७१", "content_sanskrit": "याः सेना अभित्वरीति परसैन्यमुखे भवेत् ।\nयमेन दत्तमित्यस्य कोटिहोमाद्विचक्षणः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7002215071, "chapter_id": 22215, "verse_number": "२६०-७२", "content_sanskrit": "एतैः पूर्वहुतैर्मन्त्रैः कृत्वैव विजयी भवेत् ।\nयमेन दत्तमित्यस्य कोटिहोमाद्विचक्षणः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7002215072, "chapter_id": 22215, "verse_number": "२६०-७३", "content_sanskrit": "रथमुत्पादयेच्छीघ्रं संग्रामे विजयप्रदम् ।\nआ कृष्णेति तथैतस्य कर्मव्याहृतिवद्भवेत् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7002215073, "chapter_id": 22215, "verse_number": "२६०-७४", "content_sanskrit": "शिवसंकल्पजापेन समाधिं मनसो लभेत् ।\nपञ्चनद्यः पञ्चलक्षं हुत्वा लक्ष्मीमवाप्नुयात् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7002215074, "chapter_id": 22215, "verse_number": "२६०-७५", "content_sanskrit": "यदा बध्नन्दाक्षायणां मन्त्रेणानेन मन्त्रितम् ।\nसहस्रकृत्वः कनकं धारयेद्रिपुवारणं ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7002215075, "chapter_id": 22215, "verse_number": "२६०-७६", "content_sanskrit": "इमं जीवेभ्य इति च शिलां लोष्ट्रञ्चतुर्द्दिशं ।\nक्षिपेद्गृहे तदा तस्य न स्याच्चौरभयं निशि ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7002215076, "chapter_id": 22215, "verse_number": "२६०-७७", "content_sanskrit": "परि मे गामनेनेति वशीकरणमुत्तमं ।\nहन्तुमभ्यागतस्तत्र वशी भवति मानवः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7002215077, "chapter_id": 22215, "verse_number": "२६०-७८", "content_sanskrit": "भक्ष्यताम्बूलपुष्पाद्यं मन्त्रितन्तु प्रयच्छति ।\nयस्य धर्मज्ञ वशगः सोस्य शीघ्रं भविष्यति ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7002215078, "chapter_id": 22215, "verse_number": "२६०-७९", "content_sanskrit": "शन्नो मित्र इतीत्येतत् सदा सर्व्वत्र शान्तिदं ।\nगणानां त्वा गणपतिं कृत्वा होमञ्चतुष्पथे ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7002215079, "chapter_id": 22215, "verse_number": "२६०-८०", "content_sanskrit": "वशीकुर्य्याज्जगत्सर्वं सर्वधान्यैरसंशयम् ।\nहिरण्यवर्णाः शुचयो मन्त्रोयमभिषेचने ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7002215080, "chapter_id": 22215, "verse_number": "२६०-८१", "content_sanskrit": "शन्नो देवीरभिष्टये तथा शान्तिकारः परः ।\nएकचक्रेति मन्त्रेण हुतेनाज्येन भागशः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7002215081, "chapter_id": 22215, "verse_number": "२६०-८२", "content_sanskrit": "ग्रहेभ्यः शान्तिमाप्नोति प्रसादं न च संशयः ।\nगावो भग इति द्वाभ्यां हुत्वाज्यं गा अवाप्नुयात् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7002215082, "chapter_id": 22215, "verse_number": "२६०-८३", "content_sanskrit": "प्रवादांषः सोपदिति गृहयज्ञे विधीयते ।\nदेवेभ्यो वनस्पत इति द्रुमयज्ञे विधीयते ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7002215083, "chapter_id": 22215, "verse_number": "२६०-८४", "content_sanskrit": "गायत्री वैष्णवी ज्ञेया तद्विष्णोः परमम्पदं ।\nसर्व्वपापप्रशमनं सर्व्वकामकरन्तथा ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}]