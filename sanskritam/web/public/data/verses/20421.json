[{"id": 7000421000, "chapter_id": 20421, "verse_number": "२-९३-१", "content_sanskrit": "कुंजल उवाच ।\nकिं विज्वल त्वया दृष्टमपूर्वं भ्रमता महीम् ।\nआश्चर्येण समायुक्तं तन्मे कथय सुव्रत॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000421001, "chapter_id": 20421, "verse_number": "२-९३-२", "content_sanskrit": "इतः प्रयासि कं देशमाहारार्थं तु सोद्यमी ।\nयद्य दृष्टं त्वया चित्रं समाख्याहि सुतोत्तम॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000421002, "chapter_id": 20421, "verse_number": "२-९३-३", "content_sanskrit": "विज्वल उवाच ।\nअस्ति मेरुगिरेः पृष्ठे आनंदं नाम काननम् ।\nदिव्यवृक्षैः समाकीर्णंफ लपुष्पमयैः सदा॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000421003, "chapter_id": 20421, "verse_number": "२-९३-४", "content_sanskrit": "देववृंदैः समाकीर्णं मुनिसिद्धसमन्वितम् ।\nअप्सरोभिः सुरूपाभिर्गंधर्वैः किन्नरोरगैः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000421004, "chapter_id": 20421, "verse_number": "२-९३-५", "content_sanskrit": "वापीकूपतडागैश्च नदीप्रस्रवणैस्तथा ।\nआनंदकाननं पुण्यं दिव्यभावैः प्रभासते॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000421005, "chapter_id": 20421, "verse_number": "२-९३-६", "content_sanskrit": "विमानैः कोटिसंख्याभिर्हंसकुंदेंदुसन्निभैः ।\nगीतकोलाहलैः रम्यैर्मेघध्वनिनिनादितम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000421006, "chapter_id": 20421, "verse_number": "२-९३-७", "content_sanskrit": "षट्पदानां निनादेन सर्वत्र मधुरायते ।\nचंदनैश्चूतवृक्षैश्च चंपकैः पुष्पितैर्वृतम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000421007, "chapter_id": 20421, "verse_number": "२-९३-८", "content_sanskrit": "नानावृक्षैः प्रभात्येवमानंदवनमुत्तमम् ।\nनानापक्षिनिनादेन बहुकोलाहलान्वितम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000421008, "chapter_id": 20421, "verse_number": "२-९३-९", "content_sanskrit": "एवमानंदनं दृष्टं मया तत्र सुशोभनम् ।\nविमलं च सरस्तात शोभते सागरोपमम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000421009, "chapter_id": 20421, "verse_number": "२-९३-१०", "content_sanskrit": "संपूर्णं पुण्यतोयेन पद्मसौगंधिकैः शुभैः ।\nजलजैस्तु समाकीर्णं हंसकारंडवान्वितम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000421010, "chapter_id": 20421, "verse_number": "२-९३-११", "content_sanskrit": "एवमासीत्सरस्तस्य सुमध्ये काननस्य हि ।\nदेवगंधर्वसंबाधैर्मुनिवृंदैरलंकृतम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000421011, "chapter_id": 20421, "verse_number": "२-९३-१२", "content_sanskrit": "किंनरोरगगंधर्वैश्चारणैश्च सुशोभते ।\nतत्राश्चर्यं मया दृष्टं वक्तुं तात न शक्यते॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000421012, "chapter_id": 20421, "verse_number": "२-९३-१३", "content_sanskrit": "विमानेनापि दिव्येन कलशैरुपशोभते ।\nछत्रदंडपताकाभीराजमानेन सत्तम॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000421013, "chapter_id": 20421, "verse_number": "२-९३-१४", "content_sanskrit": "सर्वभोगाविलेनापि गीयमानेथ किन्नरैः ।\nगंधर्वैरप्सरोभिश्च शोभमानोथ सुव्रत॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000421014, "chapter_id": 20421, "verse_number": "२-९३-१५", "content_sanskrit": "स्तूयमानो महासिद्धऋषिभिस्तत्त्ववेदिभिः ।\nरूपेणाप्रतिमो लोके न दृष्टस्तादृशः क्वचित्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000421015, "chapter_id": 20421, "verse_number": "२-९३-१६", "content_sanskrit": "सर्वाभरणशोभांगो दिव्यमालाविशोभितः ।\nमहारत्नकृतामाला यस्योरसि विराजते॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000421016, "chapter_id": 20421, "verse_number": "२-९३-१७", "content_sanskrit": "तत्समीपे स्थिता चैका नारी दृष्टा वरानना ।\nहेमहारैश्च मुक्तानां वलयैः कंकणैर्युता॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000421017, "chapter_id": 20421, "verse_number": "२-९३-१८", "content_sanskrit": "दिव्यवस्त्रैश्च गंधैश्च चंदनैश्चारुलेपनैः ।\nस्तूयमानो गीयमानः पुरुषस्तत्र चागतः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000421018, "chapter_id": 20421, "verse_number": "२-९३-१९", "content_sanskrit": "रतिरूपा वरारोहा पीनश्रोणिपयोधरा ।\nसर्वाभरणशोभांगी तादृशी रूपसंपदा॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000421019, "chapter_id": 20421, "verse_number": "२-९३-२०", "content_sanskrit": "द्वावेतौ तौ मया दृष्टौ विमानेनापि चागतौ ।\nरूपलावण्यमाधुर्यौ सर्वशोभासमाविलौ॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000421020, "chapter_id": 20421, "verse_number": "२-९३-२१", "content_sanskrit": "समुत्तीर्णौ विमानात्तावागतौ सरसोन्तिके ।\nस्नातौ तात महात्मानौ स्त्रीपुंसौ कमलेक्षणौ॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000421021, "chapter_id": 20421, "verse_number": "२-९३-२२", "content_sanskrit": "प्रगृह्य तौ महाशस्त्रौ दंपती तु परस्परम् ।\nतादृशौ च शवौ तत्र पतितौ सरसस्तटे॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000421022, "chapter_id": 20421, "verse_number": "२-९३-२३", "content_sanskrit": "प्रभासे ते तदा तौ तु स्त्रीपुंसौ कमलेक्षणौ ।\nरूपेणापि महाभाग तादृशावेव तौ शवौ॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000421023, "chapter_id": 20421, "verse_number": "२-९३-२४", "content_sanskrit": "देवरूपोपमस्तात यथा पुंसस्तथा शवः ।\nयथारूपं हि तस्यापि तादृशस्तत्र दृश्यते॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000421024, "chapter_id": 20421, "verse_number": "२-९३-२५", "content_sanskrit": "यथारूपं तु भार्यायास्तथा शवो द्वितीयकः ।\nस्त्रीशवस्य तु यन्मांसं शस्त्रेणोत्कृत्य सा ततः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000421025, "chapter_id": 20421, "verse_number": "२-९३-२६", "content_sanskrit": "भक्षते तस्य मांसानि रक्ताप्लुतानि तानि तु ।\nपुरुषो भक्षते तद्वच्छवमांसं समातुरः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000421026, "chapter_id": 20421, "verse_number": "२-९३-२७", "content_sanskrit": "क्षुधया पीड्यमानौ तौ भक्षेते पिशितं तयोः ।\nयावत्तृप्तिं समायातौ तावन्मांसं प्रभक्षितम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000421027, "chapter_id": 20421, "verse_number": "२-९३-२८", "content_sanskrit": "सरस्यथ जलं पीत्वा संजातौ सुखितौ पितः ।\nकियत्कालं स्थितौ तत्र विमानेन गतौ पुनः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000421028, "chapter_id": 20421, "verse_number": "२-९३-२९", "content_sanskrit": "अन्ये द्वे तु स्त्रियौ तात मया दृष्टे च तत्र वै ।\nरूपसौभाग्यसंपन्ने ते स्त्रियौ चारुलक्षणे॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000421029, "chapter_id": 20421, "verse_number": "२-९३-३०", "content_sanskrit": "ताभ्यां प्रभक्षितं मांसं यदा तात महावने ।\nप्रहसेते तदा ते द्वे हास्यैरट्टाट्टकैःपुनः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000421030, "chapter_id": 20421, "verse_number": "२-९३-३१", "content_sanskrit": "भक्षते च स्वमांसानि तावेतौ परिनित्यशः ।\nकृत्वा स्नानादिकं मांसं पश्यतो मम तत्र हि॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000421031, "chapter_id": 20421, "verse_number": "२-९३-३२", "content_sanskrit": "अन्ये स्त्रियौ महाभाग रौद्रा कारसमन्विते ।\nदंष्ट्राकरालवदने तत्रैवाति विभीषणे॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000421032, "chapter_id": 20421, "verse_number": "२-९३-३३", "content_sanskrit": "ऊचतुस्तौ तदा ते तु देहिदेहीति वै पुनः ।\nएवं दृष्टं मया तात वसता वनसंनिधौ॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000421033, "chapter_id": 20421, "verse_number": "२-९३-३४", "content_sanskrit": "नित्यमुत्कीर्य भक्ष्येते तौ द्वौ तु मांसमेव च ।\nजायेते च सुसंपूर्णौ कायौ च शवयोः पुनः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000421034, "chapter_id": 20421, "verse_number": "२-९३-३५", "content_sanskrit": "नित्यमुत्तीर्य तावेवं ते चाप्यन्ये च वै पितः ।\nकुर्वंति सदृशीं चेष्टां पूर्वोक्तां मम पश्यतः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000421035, "chapter_id": 20421, "verse_number": "२-९३-३६", "content_sanskrit": "एतदाश्चर्य संजातं दृष्टं तात मया तदा ।\nभवता पृच्छितं तात दृष्टमाश्चर्यमेव च॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000421036, "chapter_id": 20421, "verse_number": "२-९३-३७", "content_sanskrit": "मया ख्यातं तवाग्रे वै सर्वसंदेहकारणम् ।\nकथयस्व प्रसादाच्च प्रीयमाणेन चेतसा॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000421037, "chapter_id": 20421, "verse_number": "२-९३-३८", "content_sanskrit": "विमानेनागतो योसौ स्त्रिया सार्द्धं द्विजोत्तम ।\nदिव्यरूपधरो यस्तु स कस्तु कमलेक्षणः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000421038, "chapter_id": 20421, "verse_number": "२-९३-३९", "content_sanskrit": "का च नारी महाभाग महामांसं प्रभक्षति ।\nस कश्चाप्यागतस्तात सा चैवाभ्येत्य भक्षति॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000421039, "chapter_id": 20421, "verse_number": "२-९३-४०", "content_sanskrit": "प्रहसेते तदा ते द्वे स्त्रियौ तात वदस्व नः ।\nऊचतुस्तौ तथा चान्ये देहिदेहीति वा पुनः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000421040, "chapter_id": 20421, "verse_number": "२-९३-४१", "content_sanskrit": "तेद्वेत्वं मे समाचक्ष्व महाभीषणके स्त्रियौ ।\nएतन्मे संशयं तात छेत्तुमर्हसि सुव्रत॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000421041, "chapter_id": 20421, "verse_number": "२-९३-४२", "content_sanskrit": "एवमुक्त्वा महाराज विरराम स चांडजः ।\nएवं पृष्टस्तृतीयेन विज्वलेनात्मजेन सः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000421042, "chapter_id": 20421, "verse_number": "२-९३-४३", "content_sanskrit": "प्रोवाच सर्वं वृत्तांतं च्यवनस्यापि शृण्वतः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]