[{"id": 7003061000, "chapter_id": 23061, "verse_number": "३-४१-१", "content_sanskrit": "नारायण उवाच ।\nहरेश्च कवचं धृत्वा कृत्वा निः क्षत्रियां महीम् ।\nरामो जगाम कैलासं नमस्कर्तुं शिवं गुरुम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003061001, "chapter_id": 23061, "verse_number": "३-४१-२", "content_sanskrit": "गुरुपत्नीं शिवामम्बां द्रष्टुं गुरुसुतौ च तौ ।\nगुणैर्नारायणसमौ कार्त्तिकेयगणेश्वरौ ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003061002, "chapter_id": 23061, "verse_number": "३-४१-३", "content_sanskrit": "मनोयायी महात्मा स भृगुस्संप्राप्य तत्क्षणम् ।\nददर्श पर्वतं रम्यमतीव सुमनोहरम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003061003, "chapter_id": 23061, "verse_number": "३-४१-४", "content_sanskrit": "शुद्धस्फटिकसङ्काशैर्मणिभिः सुमनोहरैः ।\nसुवर्णभूमिसदृशै राजमार्गैर्विराजितम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003061004, "chapter_id": 23061, "verse_number": "३-४१-५", "content_sanskrit": "सिन्दूरारुणवर्णैश्च वेष्टितं मणिवेदिभिः ।\nसंयुक्तं मुक्तानिकरैः पूरितं मणिमण्डपैः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003061005, "chapter_id": 23061, "verse_number": "३-४१-६", "content_sanskrit": "यक्षाणामालयैर्दिव्यैः संयुक्तं शतकोटिभिः ।\nकपाटस्तम्भसोपानैः शोभितैर्मणिनिर्मितैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003061006, "chapter_id": 23061, "verse_number": "३-४१-७", "content_sanskrit": "सुवर्णकलशैर्दिव्यै राजतैः श्वेतचामरैः ।\nरत्नकाञ्चनपूर्णैश्च यक्षेन्द्रगणवेष्टितैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003061007, "chapter_id": 23061, "verse_number": "३-४१-८", "content_sanskrit": "रत्नभूषणभूषाढ्यैर्दीपितैः सुन्दरीगणैः ।\nबालिकाभिर्बालकैश्च चित्रपुत्तलिकाकरैः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003061008, "chapter_id": 23061, "verse_number": "३-४१-९", "content_sanskrit": "क्रीडद्भिः सस्मितैः शश्वत्स्वच्छन्दं च विराजितैः ।\nपारिजातद्रुमगणैः स्वर्णदीतीरनीरजैः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003061009, "chapter_id": 23061, "verse_number": "३-४१-१०", "content_sanskrit": "आकीर्णं पुष्पजालैश्च पुष्पितैश्च सुगन्धिभिः ।\nकल्पवृक्षाश्रितैः सिद्धैः कामधेनुपुरस्कृतैः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003061010, "chapter_id": 23061, "verse_number": "३-४१-११", "content_sanskrit": "सिद्धविद्यासु निपुणैः पुण्यवद्भिर्निषेवितम् ।\nत्रिलक्षयोजनाच्छायैर्वटवृक्षैरथाक्षयैः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003061011, "chapter_id": 23061, "verse_number": "३-४१-१२", "content_sanskrit": "शतयोजनविस्तीर्णैः शतस्कन्धसमन्वितैः ।\nअसंख्यशाखानि करैरसंख्यफलसंयुतैः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003061012, "chapter_id": 23061, "verse_number": "३-४१-१३", "content_sanskrit": "नानापक्षिगणाकीर्णैः सुमनोहरशब्दितैः ।\nकम्पितैः शीतवातेन मण्डितं च सुगन्धिना ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003061013, "chapter_id": 23061, "verse_number": "३-४१-१४", "content_sanskrit": "पुष्पोद्यानसहस्रेण सरसां च शतेन च ।\nसिद्धेन्द्रालयलक्षैश्च मणिरत्नविकारजैः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003061014, "chapter_id": 23061, "verse_number": "३-४१-१५", "content_sanskrit": "रामश्च दृष्ट्वा नगरमतिसंहृष्टमानसः ।\nददर्श पुरतो रम्यं श्रीयुक्तं शंकरालयम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003061015, "chapter_id": 23061, "verse_number": "३-४१-१६", "content_sanskrit": "सुवर्णमूल्यशतकैर्मणिभिः स्वर्णवर्णकैः ।\nखचितं रत्नसारैश्च रचितं विश्वकर्मणा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003061016, "chapter_id": 23061, "verse_number": "३-४१-१७", "content_sanskrit": "त्रिपञ्चयोजनोच्छ्रायं चतुर्योजनविस्तृतम् ।\nचतुरस्रं चतुष्कोणं प्राकारं सुमनोहरम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003061017, "chapter_id": 23061, "verse_number": "३-४१-१८", "content_sanskrit": "द्वारं रत्नकपाटेन नाना चित्रान्वितेन च ।\nमणीन्द्रवेदिभिर्युक्तं मणिस्तम्भविराजितैः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003061018, "chapter_id": 23061, "verse_number": "३-४१-१९", "content_sanskrit": "तद्दक्षिणे वृषेन्द्रं च वामे सिंहं च नारद ।\nनन्दीश्वरं महाकालं पिङ्गलाक्षं भयंकरम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003061019, "chapter_id": 23061, "verse_number": "३-४१-२०", "content_sanskrit": "विशालाक्षं च बाणं च विरूपाक्षं महाबलम् ।\nविकटाक्षं भास्कराक्षं रक्ताक्षं विकटोदरम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003061020, "chapter_id": 23061, "verse_number": "३-४१-२१", "content_sanskrit": "संहारभैरवं कालभैरवं च भयङ्करम् ।\nरुरुभैरवमीशाभं महाभैरवमेव च ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003061021, "chapter_id": 23061, "verse_number": "३-४१-२२", "content_sanskrit": "कृष्णाङ्गभैरवं चैव क्रोधभैरवमुल्बणम् ।\nकपालभैरवं चैव रुद्रभैरवमेव च ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003061022, "chapter_id": 23061, "verse_number": "३-४१-२३", "content_sanskrit": "सिद्धेंद्रादीन्रुद्रगणान्विद्याधरसुगुह्यकान् ।\nभूतान्प्रेतान्पिशाचांश्च कूष्माण्डान्ब्रह्मराक्षसान् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003061023, "chapter_id": 23061, "verse_number": "३-४१-२४", "content_sanskrit": "वेतालान्दानवांश्चैव योगीन्द्रांश्च जटाधरान् ।\nयक्षान्किम्पुरुषांश्चैव किन्नरांश्च ददर्श ह ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003061024, "chapter_id": 23061, "verse_number": "३-४१-२५", "content_sanskrit": "तान्दृष्ट्वा नन्दिकेशाज्ञां गृहीत्वा भृगुनन्दनः ।\nतान्सम्भाष्याभ्यन्तरं च जगामानन्दसंप्लुतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003061025, "chapter_id": 23061, "verse_number": "३-४१-२६", "content_sanskrit": "रत्नेन्द्रसारखचितं ददर्श शतमन्दिरम् ।\nअमूल्यरत्नकलशैर्ज्वलद्भिश्च विराजितम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003061026, "chapter_id": 23061, "verse_number": "३-४१-२७", "content_sanskrit": "अमूल्यरत्नरचितैर्मुक्तानिर्म्मलदर्पणैः ।\nहीरसारविकारैश्च कपाटैश्च विराजितम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003061027, "chapter_id": 23061, "verse_number": "३-४१-२८", "content_sanskrit": "गोरोचनाभिर्मणिभिर्युतं स्तम्भसहस्रकैः ।\nमणिसारविकारैश्च सोपानैः परिशोभितम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003061028, "chapter_id": 23061, "verse_number": "३-४१-२९", "content_sanskrit": "ददर्शाभ्यन्तरं द्वारं नानाचित्रैश्च चित्रितम् ।\nमाणिक्यमुक्ताग्रथितैर्मालाजालैर्विराजितम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003061029, "chapter_id": 23061, "verse_number": "३-४१-३०", "content_sanskrit": "ददर्श कार्त्तिकेयं च वामे दक्षे गणेश्वरम् ।\nवीरभद्रं महाकायं शिवतुल्यपराक्रमम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003061030, "chapter_id": 23061, "verse_number": "३-४१-३१", "content_sanskrit": "प्रधानपार्षदगणान्क्षेत्रपालांश्च नारद ।\nरत्नसिंहासनस्थांश्च रत्नभूषणभूषितान्॥ ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003061031, "chapter_id": 23061, "verse_number": "३-४१-३२", "content_sanskrit": "तान्सम्भाष्य भृगुः शीघ्रं महाबलपराक्रमः ।\nपर्शुहस्तस्स परशुरामो गन्तुं समुद्यतः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003061032, "chapter_id": 23061, "verse_number": "३-४१-३३", "content_sanskrit": "गच्छन्तं तं गणेशश्च क्षणं तिष्ठेत्युवाच ह ।\nनिद्रितो निद्रया युक्तो महादेवोऽधुनेति च ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003061033, "chapter_id": 23061, "verse_number": "३-४१-३४", "content_sanskrit": "ईश्वराज्ञां गृहीत्वाऽहमत्रागत्य क्षणान्तरे ।\nत्वया सार्द्धं गमिष्यामि भ्रातस्तिष्ठात्र साम्प्रतम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003061034, "chapter_id": 23061, "verse_number": "३-४१-३५", "content_sanskrit": "गणेशवाक्यं परशुरामश्श्रुत्वा महाबलः ।\nबृहस्पतिसमो वक्ता प्रवक्तुमुपचक्रमे॥ ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]