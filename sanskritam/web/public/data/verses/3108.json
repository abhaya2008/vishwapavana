[{"id": 2098534, "chapter_id": 3108, "verse_number": "१३-२३८-१", "content_sanskrit": "उमोवाच।\nपितृमेधः कथं देव तन्मे शंसितुमर्हसि।\nसर्वेषां पितरः पूज्याः सर्वसम्पत्प्रदायिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2098535, "chapter_id": 3108, "verse_number": "१३-२३८-२x", "content_sanskrit": "महेश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2098536, "chapter_id": 3108, "verse_number": "१३-२३८-२", "content_sanskrit": "पितृमेधं प्रवक्ष्यामि यथावत्तन्मना शृणु।\nदेशकालौ विधानं च तत्क्रियायाः शुभाशुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2098537, "chapter_id": 3108, "verse_number": "१३-२३८-३", "content_sanskrit": "लोकेषु पितरः पूज्या देवतानां च देवताः।\nशुचयो निर्मलाः पुण्या दक्षिणां दिशमाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2098538, "chapter_id": 3108, "verse_number": "१३-२३८-४", "content_sanskrit": "यथा वृष्टिं प्रतीक्षन्ते भूमिष्ठाः सर्वजन्तवः।\nपितरश्च तथा लोके पितृमेधं शुभेक्षणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2098539, "chapter_id": 3108, "verse_number": "१३-२३८-५", "content_sanskrit": "तस्य देशाः कुरुक्षेत्रं गया गङ्गा सरस्वती।\nप्रभासं पुष्करं चेति तेषु दत्तं महाफलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2098540, "chapter_id": 3108, "verse_number": "१३-२३८-६", "content_sanskrit": "तीर्थानि सरितः पुण्या विविक्तानि वनानि च।\nनदीनां पुलिनानीति देशाः श्राद्धस्य पूजिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2098541, "chapter_id": 3108, "verse_number": "१३-२३८-७", "content_sanskrit": "माघप्रोष्ठपदौ मासौ श्राद्धकर्मणि पूजितौ।\nपक्षयोः कृष्णपक्षश्च पूर्वपक्षात्प्रशस्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2098542, "chapter_id": 3108, "verse_number": "१३-२३८-८", "content_sanskrit": "अमावास्यां त्रयोदश्यां नवम्यां प्रतिपत्सु च।\nतिथिष्वेतासु तुष्यन्ति दत्तेनेह पितामहाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2098543, "chapter_id": 3108, "verse_number": "१३-२३८-९", "content_sanskrit": "पूर्वाह्णे शुक्लपक्षे च रात्रौ जन्मदिनेषु वा।\nयुग्मेष्वहस्सु च श्राद्धं न च कुर्वीत पण्डितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2098544, "chapter_id": 3108, "verse_number": "१३-२३८-१०", "content_sanskrit": "एष कालो मया प्रोक्तः पितृमेधस्य पूजितः।\nयस्मिंश्च ब्राह्म्णं पात्रं पश्येत्कालः स च स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2098545, "chapter_id": 3108, "verse_number": "१३-२३८-११", "content_sanskrit": "अपाङ्क्तेया द्विजा वर्ज्या ग्राह्यास्ते पङ्क्तिपावनाः।\nभोजयेद्यदि पापिष्ठाञ्श्राद्धेषु नरकं व्रजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2098546, "chapter_id": 3108, "verse_number": "१३-२३८-१२", "content_sanskrit": "वृत्तश्रुतकुलोपेतान्सकलत्रान्गुणान्वितान्।\nतदर्हाञ्श्रोत्रियान्विद्धि ब्राह्मणानयुजः शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2098547, "chapter_id": 3108, "verse_number": "१३-२३८-१३", "content_sanskrit": "एतान्निमन्त्रयोद्विद्वान्पूर्वेद्युः प्रातरेव वा।\nतत्र श्राद्धक्रियां पश्चादारभेत यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2098548, "chapter_id": 3108, "verse_number": "१३-२३८-१४", "content_sanskrit": "त्रीणि श्राद्धे पवित्राणि दौहित्रः कुतपस्तिलाः।\nत्रीणि चात्र प्रशंसन्ति शौचमक्रोधमत्वरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2098549, "chapter_id": 3108, "verse_number": "१३-२३८-१५", "content_sanskrit": "कुतपः खङ्गपात्रं च कुशा दर्भास्तिला मधु।\nकालशाकं गजच्छाया पवित्रं श्राद्धकर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2098550, "chapter_id": 3108, "verse_number": "१३-२३८-१६", "content_sanskrit": "तिलानवकिरेत्तत्र नानावर्णान्समन्ततः।\nअशुद्धं पितृयज्ञश्च तिलैः शुध्यति शोभने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2098551, "chapter_id": 3108, "verse_number": "१३-२३८-१७", "content_sanskrit": "नीलकाषायवस्त्रं च भिन्नवर्णं नवव्रणम्।\nहीनाङ्गमशुचिं वाऽपि वर्जयेत्तत्र दूरतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2098552, "chapter_id": 3108, "verse_number": "१३-२३८-१८", "content_sanskrit": "कुक्कुटांश्च वराहांश्च नग्नं क्लीबं रजस्वलाम्।\nआयसं त्रपुसीसं च श्राद्धकर्मणि वर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2098553, "chapter_id": 3108, "verse_number": "१३-२३८-१९", "content_sanskrit": "मांसैः प्रीणन्ति पितरो मुद्गमाषयवैरिह।\nशशरौरवमांसेन षण्मासं तृप्तिरिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2098554, "chapter_id": 3108, "verse_number": "१३-२३८-२०", "content_sanskrit": "संवत्सरं च गव्येन हविषा पायसेन च।\nवार्ध्रीणसस्य मांसेन तृप्तिर्द्वादशवार्षिकी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2098555, "chapter_id": 3108, "verse_number": "१३-२३८-२१", "content_sanskrit": "आनन्त्याय भवेद्दत्तं खङ्गमांसं पितृक्षये।\nपायसं सतिलं क्षौद्रं खङ्गमांसेन सम्मितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2098556, "chapter_id": 3108, "verse_number": "१३-२३८-२२", "content_sanskrit": "महाशकलिनो मस्याश्छागो वा सर्वलोहितः।\nकालशाकमितीत्येव तदानन्त्याय कल्पितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2098557, "chapter_id": 3108, "verse_number": "१३-२३८-२३", "content_sanskrit": "सापूपं सामिषं स्निग्धमाहारमुपकल्पयेत्।\nउपकल्प्य तदाहारं ब्राह्मणानर्चयेत्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2098558, "chapter_id": 3108, "verse_number": "१३-२३८-२४", "content_sanskrit": "श्मश्रुकर्मशिरः स्नातान्समारोप्यासनं क्रमात्।\nसुगन्धमाल्याभरणैः स्नग्भिरेतान्विभूषयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2098559, "chapter_id": 3108, "verse_number": "१३-२३८-२५", "content_sanskrit": "अलङ्कृत्योपविष्टांस्तान्पिण्डावापं निवेदयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2098560, "chapter_id": 3108, "verse_number": "१३-२३८-२६", "content_sanskrit": "ततः प्रस्तीर्य दर्भाणां प्रस्तरं दक्षिणामुखम्।\nतत्समीपेऽग्निमिद्ध्वा च स्वधां च जुहुयात्ततः।\nसमीपे त्वग्नीषोमाभ्यां पितृभ्यो जुहुयात्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2098561, "chapter_id": 3108, "verse_number": "१३-२३८-२७", "content_sanskrit": "तथा दर्भेषु पिण्डांस्त्रीन्निर्वपेद्दक्षिणामुखः।\nअपसव्यमपाङ्गुष्ठं नामधेयपुरस्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2098562, "chapter_id": 3108, "verse_number": "१३-२३८-२८", "content_sanskrit": "एतेन विधिना दत्तं पितॄणामक्षयं भवेत्।\nततो विप्रान्यथाशक्ति पूजयेन्नियतः शुचिः।\nसदक्षिणं ससम्भारं यथा तुष्यन्ति ते द्विजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2098563, "chapter_id": 3108, "verse_number": "१३-२३८-२९", "content_sanskrit": "यत्र तत्क्रियते तत्र न जल्पन्न जपेन्मिथः।\nनियम्य वाच्यं देहं च श्राद्धकर्म समारभेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2098564, "chapter_id": 3108, "verse_number": "१३-२३८-३०", "content_sanskrit": "ततो निर्वपने वृत्ते तान्पिण्डांस्तदनन्तरम्।\nब्राह्मणोऽग्निरजो गौर्वा भक्षयेदप्सु वा क्षिपेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2098565, "chapter_id": 3108, "verse_number": "१३-२३८-३१", "content_sanskrit": "पत्नीं वा मध्यमं पिण्डं पुत्रकामो हि प्राशयेत्।\nआधत्त पितरो गर्भं कुमारं पुष्करस्रजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2098566, "chapter_id": 3108, "verse_number": "१३-२३८-३२", "content_sanskrit": "तृप्तानुत्थाप्य तान्विप्रानन्नशेषं निवेदयेत्।\nतच्छेषं बहुभिः पश्चात्सभृत्यो भक्षयेन्नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2098567, "chapter_id": 3108, "verse_number": "१३-२३८-३३", "content_sanskrit": "एष प्रोक्तः समासेन पितृयज्ञः सनातनः।\nपितरस्तेन तुष्यन्ति कर्ता च फलमाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2098568, "chapter_id": 3108, "verse_number": "१३-२३८-३४", "content_sanskrit": "अहन्यहनि वा कुर्यान्मासेमासेऽथवा पुनः।\nसंवत्सरं द्विः कुर्याच्च चतुर्वाऽपि स्वशक्तितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2098569, "chapter_id": 3108, "verse_number": "१३-२३८-३५", "content_sanskrit": "दीर्घायुश्च भवेत्स्वस्थः पितृमेधेन वा पुनः।\nसपुत्रो बहुभृत्यश्च प्रभूतधनधान्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2098570, "chapter_id": 3108, "verse_number": "१३-२३८-३६", "content_sanskrit": "श्राद्धदः स्वर्गमाप्नोति निर्मलं विविधात्मकम्।\nअप्सरोगणसंघुष्टं विरजस्कमनन्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2098571, "chapter_id": 3108, "verse_number": "१३-२३८-३७", "content_sanskrit": "श्राद्धानि पुष्टिकामा वै ये प्रकुर्वन्ति पण्डिताः।\nतेषां पुष्टिं प्रजां चैव दास्यन्ति पितरः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2098572, "chapter_id": 3108, "verse_number": "१३-२३८-३८", "content_sanskrit": "धन्यं यशस्यमायुष्यं स्वर्ग्यं शत्रुविनाशनम्।\nकुलसन्धारकं चेति श्राद्धमाहुर्मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2098573, "chapter_id": 3108, "verse_number": "१३-२३८-३९x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2098574, "chapter_id": 3108, "verse_number": "१३-२३८-३९", "content_sanskrit": "भगवन्देवदेवेश मृतास्ते भुवि जन्तवः।\nनानाजातिषु जायन्ते शीघ्रं कर्मवशात्पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2098575, "chapter_id": 3108, "verse_number": "१३-२३८-४०", "content_sanskrit": "पितरः स्वस्ति ते तत्र कथं तिष्ठन्ति देववत्।\nपितॄणां कतमो देशः पिण्डानश्नन्ति वै कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2098576, "chapter_id": 3108, "verse_number": "१३-२३८-४१", "content_sanskrit": "अन्ने दत्ते मृतानां तु कथमाप्यायनं भवेत्।\nएवं मया संशयितं भगवन्वक्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2098577, "chapter_id": 3108, "verse_number": "१३-२३८-४२x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2098578, "chapter_id": 3108, "verse_number": "१३-२३८-४२", "content_sanskrit": "एतद्विरुद्धं पृच्छन्त्यां रुद्राण्यां परिषद्भृशम्।\nबभूव सर्वा मुदिता श्रोतुं हि परमं हितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2098579, "chapter_id": 3108, "verse_number": "१३-२३८-४३x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2098580, "chapter_id": 3108, "verse_number": "१३-२३८-४३", "content_sanskrit": "स्थाने संशयितं देवि शृणु कल्याणि तत्वतः।\nगुह्यानां परमं गुह्यं हितानां परमं हितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2098581, "chapter_id": 3108, "verse_number": "१३-२३८-४४", "content_sanskrit": "यथा देवगणा देवि तथा पितृगणाः प्रिये।\nदक्षिणस्यां दिशि शुभे सर्वे पितृगणाः स्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2098582, "chapter_id": 3108, "verse_number": "१३-२३८-४५", "content_sanskrit": "प्रेतानुद्दिश्य या पूजा क्रियते मानुषैरिह।\nतेन तुष्यन्ति पितरो न प्रेताः पितरः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2098583, "chapter_id": 3108, "verse_number": "१३-२३८-४६", "content_sanskrit": "उत्तरस्यां यथा देवा रमन्ते यज्ञकर्मभिः।\nदक्षिणस्यां तथा देवि तुष्यन्ति विविधैर्मखैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2098584, "chapter_id": 3108, "verse_number": "१३-२३८-४७", "content_sanskrit": "द्विविधं क्रियते कर्म हव्यकव्यसमाश्रितम्।\nतयोर्हव्यक्रिया देवान्कव्यमाप्यायते पितॄन्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2098585, "chapter_id": 3108, "verse_number": "१३-२३८-४८", "content_sanskrit": "प्रसव्यं मङ्गलैर्द्रव्यैर्हव्यकर्म विधीयते।\nअपसव्यममङ्गल्यैः कव्यं चापि विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2098586, "chapter_id": 3108, "verse_number": "१३-२३८-४९", "content_sanskrit": "सदेवासुरगन्धर्वाः पितॄनभ्यर्चयन्ति च।\nआप्यायन्ते च ते श्राद्धैः पुनराप्याययन्ति तान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2098587, "chapter_id": 3108, "verse_number": "१३-२३८-५०", "content_sanskrit": "अनिष्टा च पितॄन्पूर्वं यः क्रियां प्रकरोति चेत्।\nरक्षांसि च पिशाचाश्च फलं भोक्ष्यन्ति तस्य तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2098588, "chapter_id": 3108, "verse_number": "१३-२३८-५१", "content_sanskrit": "हव्यकव्यक्रियास्तस्मात्कर्तव्या भुवि मानुषैः।\nकर्मक्षेत्रं हि मानुष्यं तदन्यत्र न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2098589, "chapter_id": 3108, "verse_number": "१३-२३८-५२", "content_sanskrit": "कव्येन सन्ततिर्दृष्टा हव्ये भूतिः पृथग्विधाः।\nइति ते कथितं देवि देवगुह्यं सनातनम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2098590, "chapter_id": 3108, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि अष्टत्रिंशदधिकद्विशततमोऽध्यायः॥ २३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]