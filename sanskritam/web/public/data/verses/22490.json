[{"id": 7002490000, "chapter_id": 22490, "verse_number": "१-१५२-१", "content_sanskrit": "सुमन्तुरुवाच ।\nसूरे च दुर्लभा भक्तिर्दुर्लभं सुरपूजनम् ।\nसूराय दुर्लभं दानं सूरहोमश्च दुर्लभः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002490001, "chapter_id": 22490, "verse_number": "१-१५२-२", "content_sanskrit": "सुदुर्लभं रवेर्ज्ञानं तदभ्यासोऽपि दुर्लभ ।\nसुदुर्लभतरं ज्ञेयं खषोल्कज्ञानमुत्तमम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002490002, "chapter_id": 22490, "verse_number": "१-१५२-३", "content_sanskrit": "सुदुर्लभतरं ज्ञानं सदा वै भास्करस्य तु ।\nप्रदक्षिणां चक्रतुर्वै पादौ भक्त्याऽर्कमन्दिरे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002490003, "chapter_id": 22490, "verse_number": "१-१५२-४", "content_sanskrit": "तौ करौ श्लाघ्यतां प्राप्तौ यौ पूजां चक्रतू रवेः ।\nसैवैका रसना धन्या स्तोत्रं या कुरुते रवेः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002490004, "chapter_id": 22490, "verse_number": "१-१५२-५", "content_sanskrit": "तन्मनः पुण्यतां प्राप्तं यद्धित्वा विषयं नृप ।\nनिश्चला च रवेर्लीला निर्भीका क्रोधवर्जिता ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002490005, "chapter_id": 22490, "verse_number": "१-१५२-६", "content_sanskrit": "शतानीक उवाच ।\nसूर्यार्चनविधिं कुर्वञ्छ्रोतुमिच्छामि तत्त्वतः ।\nत्वत्प्रसादाद्द्विजश्रेष्ठ कौतूहलमतीव मे ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002490006, "chapter_id": 22490, "verse_number": "१-१५२-७", "content_sanskrit": "यत्पुण्यं स्थापिते सूर्ये कृते सूर्यालये च यत् ।\nसम्मार्जने च यत्पुण्यं यत्पुण्यमुपलेपने ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002490007, "chapter_id": 22490, "verse_number": "१-१५२-८", "content_sanskrit": "स्थाने कृते च यत्पुण्यं तथा नीराजने कृते ।\nनीलौषधिप्रवापेन नृत्यमङ्गलवादितैः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002490008, "chapter_id": 22490, "verse_number": "१-१५२-९", "content_sanskrit": "अर्घ्यदानेन यत्पुण्यं तोयस्नानेन यद्भवेत् ।\nपञ्चामृतमयस्नाने दधिस्नाने च यत्फलम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002490009, "chapter_id": 22490, "verse_number": "१-१५२-१०", "content_sanskrit": "चक्राभ्यङ्गे च यत्प्रोक्तं वज्रस्नाने च यत्फलम् ।\nमधुस्नाने पयःस्नाने स्नान इक्षुरसस्य तु ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002490010, "chapter_id": 22490, "verse_number": "१-१५२-११", "content_sanskrit": "उद्वर्तनं शुचिस्थाने कुशपुष्पोदकेन तु ।\nसुवर्णरत्नतोयैश्च गन्धचन्दनवारिभिः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002490011, "chapter_id": 22490, "verse_number": "१-१५२-१२", "content_sanskrit": "कर्पूरागुरुतोयेन स्वच्छतो येन यत्फलम् ।\nविलेपनैश्च गन्धाढ्यैर्विलेपनफलं लभेत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002490012, "chapter_id": 22490, "verse_number": "१-१५२-१३", "content_sanskrit": "तालपत्रप्रदाने तु प्रदाने चामरस्य तु ।\nरक्तपुष्पार्चने यच्च दामभिः पूजनेन च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002490013, "chapter_id": 22490, "verse_number": "१-१५२-१४", "content_sanskrit": "सुमानां मण्डपे यच्च पुष्पमालावलम्बनात् ।\nपूजाभक्तिविशेषैश्च गृहमालावलम्बने ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002490014, "chapter_id": 22490, "verse_number": "१-१५२-१५", "content_sanskrit": "पुष्पदानविशेषेण धूपदीपैश्च यत्फलम् ।\nवस्त्रालङ्कारदाने तु पुण्यश्रवणकीर्तने ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002490015, "chapter_id": 22490, "verse_number": "१-१५२-१६", "content_sanskrit": "ब्रह्मश्रवस्य दाने तु अव्यङ्गस्य च गोपते ।\nमगानां मत्प्रसादेन अभिवादनपूजने ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002490016, "chapter_id": 22490, "verse_number": "१-१५२-१७", "content_sanskrit": "व्योमपूजाफलं यच्च अरुणस्य च पूजनम् ।\nतथान्यदपि यत्प्रोक्तमज्ञानाद्ब्राह्मणोत्तम ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002490017, "chapter_id": 22490, "verse_number": "१-१५२-१८", "content_sanskrit": "तत्सर्वं ब्रूहि मे ब्रह्मन्भक्तानामनुकम्पया ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]