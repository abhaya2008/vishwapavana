[{"id": 2134599, "chapter_id": 3907, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2134600, "chapter_id": 3907, "verse_number": "१", "content_sanskrit": "कर्णस्य वचनं श्रुत्वा राजा दुर्योधनस्ततः ।\nहृष्टो भूत्वा पुनर्दीन इदं वचनमब्रवीत् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2134601, "chapter_id": 3907, "verse_number": "२", "content_sanskrit": "ब्रवीषि यदिदं कर्ण सर्वं तद् हृदये स्थितम् ।\nन त्वभ्यनुज्ञां लप्स्यामि गमने यत्र पाण्डवाः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2134602, "chapter_id": 3907, "verse_number": "३", "content_sanskrit": "परिदेवति तान् वीरान् धृतराष्ट्रो महीपतिः ।\nमन्यतेऽभ्यधिकांश्चापि तपोयोगेन पाण्डवान् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2134603, "chapter_id": 3907, "verse_number": "४", "content_sanskrit": "अथवाऽप्यनुबुध्येत नृपोऽस्माकं चिकीर्षितम्।\nएतामप्यायतिं रक्षन्नाभ्यनुज्ञातुमर्हति \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2134604, "chapter_id": 3907, "verse_number": "५", "content_sanskrit": "न हि द्वैतवने किञ्चिद् विद्यतेऽन्यत् प्रयोजनम् ।\nउत्सादनमृते तेषां वनस्थानां महाद्युते \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2134605, "chapter_id": 3907, "verse_number": "६", "content_sanskrit": "जानासि हि यथा क्षत्ता द्यूतकाल उपस्थिते ।\nअब्रवीद् यच्च मां त्वां च सौबलं वचनं तदा \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2134606, "chapter_id": 3907, "verse_number": "७", "content_sanskrit": "तानि सर्वाणि वाक्यानि यच्चान्यत् परिदेवितम् ।\nविचिन्त्य नाधिगच्छामि गमनायेतराय वा \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2134607, "chapter_id": 3907, "verse_number": "८", "content_sanskrit": "ममापि हि महान् हर्षो यदहं भीमफल्गुनौ ।\nक्लिष्टावरण्ये पश्येयं कृष्णया सहिताविति\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2134608, "chapter_id": 3907, "verse_number": "९", "content_sanskrit": "न तथा ह्याप्नुयां प्रीतिमवाप्य वसुधामिमाम् ।\nदृष्ट्वा यथा पाण्डुसुतान् वल्कलाजिनवाससः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2134609, "chapter_id": 3907, "verse_number": "१०", "content_sanskrit": "किं नु स्यादधिकं तस्माद् यदहं द्रुपदात्मजाम् ।\nद्रौपदीं कर्ण पश्येयं काषायवसनां वने \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2134610, "chapter_id": 3907, "verse_number": "११", "content_sanskrit": "यदि मां धर्मराजश्च भीमसेनश्च पाण्डवः ।\nयुक्तं परमया लक्ष्म्या पश्येतां जीवितं भवेत् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2134611, "chapter_id": 3907, "verse_number": "१२", "content_sanskrit": "उपायं तु न पश्यामि येन गच्छेम तद्वनम् ।\nयथा चाभ्यनुजानीयाद् गच्छन्तं मां महीपतिः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2134612, "chapter_id": 3907, "verse_number": "१३", "content_sanskrit": "स सौबलेन सहितस्तथा दुःशासनेन च ।\nउपायं पश्य निपुणं येन गच्छेम तद्वनम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2134613, "chapter_id": 3907, "verse_number": "१४", "content_sanskrit": "अहमप्यद्य निश्चित्य गमनायेतराय वा ।\nकल्यमेव गमिष्यामः समीपं पार्थिवस्य ह \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2134614, "chapter_id": 3907, "verse_number": "१५", "content_sanskrit": "मयि तत्रोपविष्टे तु भीष्मे च कुरुसत्तमे ।\nउपायो यो भवेद् दृष्टस्तं ब्रूयाः सहसौबलः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2134615, "chapter_id": 3907, "verse_number": "१६", "content_sanskrit": "वचो भीष्मस्य राज्ञश्च निशम्य गमनं प्रति ।\nव्यवसायं करिष्येऽहमनुनीय पितामहम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2134616, "chapter_id": 3907, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2134617, "chapter_id": 3907, "verse_number": "१७", "content_sanskrit": "तथेत्युक्त्वा तु तं सर्वे जग्मुरावसथान् प्रति ।\nव्युषितायां रजन्यां तु कर्णो राजानमभ्ययात् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2134618, "chapter_id": 3907, "verse_number": "१८", "content_sanskrit": "ततो दुर्योधनं कर्णः प्रहसन्निदमब्रवीत् ।\nउपायः परिदृष्टोऽयं तं निबोध जनेश्वर \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2134619, "chapter_id": 3907, "verse_number": "१९", "content_sanskrit": "घोषा द्वैतवने सर्वे त्वत्प्रतीक्षा नराधिप ।\nघोषयात्रापदेशेन गमिष्यामो न संशयः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2134620, "chapter_id": 3907, "verse_number": "२०", "content_sanskrit": "उचितं हि सदा गन्तुं घोषयात्रां विशाम्पते।\nएवं च त्वां पिता राजन् समनुज्ञातुमर्हति \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2134621, "chapter_id": 3907, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2134622, "chapter_id": 3907, "verse_number": "२१", "content_sanskrit": "तथा कथयमानौ तौ घोषयात्राविनिश्चयम् ।\nगान्धारराजः शकुनिः प्रत्युवाच हसन्निव \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2134623, "chapter_id": 3907, "verse_number": "२२", "content_sanskrit": "उपायोऽयं मया दृष्टो गमनाय निरामयः ।\nअनुज्ञास्यति नो राजा बोधयिष्यति चाप्युत \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2134624, "chapter_id": 3907, "verse_number": "२३", "content_sanskrit": "घोषा द्वैतवने सर्वे त्वत्प्रतीक्षा नराधिप ।\nघोषयात्रापदेशेन गमिष्यामः सरः प्रति \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2134625, "chapter_id": 3907, "verse_number": "२४", "content_sanskrit": "ततः प्रहसिताः सर्वे तेऽन्योन्यस्य तळान् ददुः ।\nतदेव च विनिश्चित्य ददृशुः कुरुसत्तमम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2134626, "chapter_id": 3907, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि घोषयात्रापर्वणि घोषयात्रामन्त्रणे सप्तविंशत्यधिकद्विशततमोऽध्यायः ॥२२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2134627, "chapter_id": 3907, "verse_number": "", "content_sanskrit": "॥ घोषयात्रापर्वणि तृतीयोऽध्यायः ॥३॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]