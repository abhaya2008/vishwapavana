[{"id": 2060499, "chapter_id": 2295, "verse_number": "८-१६-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2060500, "chapter_id": 2295, "verse_number": "८-१६-१", "content_sanskrit": "युयुत्सं तव पुत्रस्य द्रावयन्तं बलं महत्।\nउलूको न्यपतत्तूर्णं तिष्ठतिष्ठेति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2060501, "chapter_id": 2295, "verse_number": "८-१६-२", "content_sanskrit": "युयुत्सुश्च ततो राजञ्शितधारेण पत्रिणा।\nउलूकं ताडयामास वज्रेणेव महाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2060502, "chapter_id": 2295, "verse_number": "८-१६-३", "content_sanskrit": "उलूकस्तु ततः क्रुद्धस्तव पुत्रस्य संयुगे।\nक्षुरप्रेण धनुश्छित्त्वा ताडयामास कर्णिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2060503, "chapter_id": 2295, "verse_number": "८-१६-४", "content_sanskrit": "तदपास्य धनुश्छिन्नं युयुत्सर्वेगवत्तरम्।\nअन्यदादत्त सुमहच्चापं संरक्तलोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2060504, "chapter_id": 2295, "verse_number": "८-१६-५", "content_sanskrit": "शाकुनिं तु ततः षष्ट्या विव्याध भरतर्षभ।\nसारथिं त्रिभिरानर्च्छत्तं च भूयो व्यविध्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2060505, "chapter_id": 2295, "verse_number": "८-१६-६", "content_sanskrit": "उलूकस्तं तु विंशत्या विद्व्वा स्वर्णविभूषितैः।\nअथास्य समरे क्रुद्धो ध्वजं चिच्छेद काञ्चनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2060506, "chapter_id": 2295, "verse_number": "८-१६-७", "content_sanskrit": "स च्छिन्नयष्टिः सुमहाञ्शीर्यमाणो महाध्वजः।\nपपात प्रमुखे राजन्युयुत्सोः काञ्चनध्वजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2060507, "chapter_id": 2295, "verse_number": "८-१६-८", "content_sanskrit": "ध्वजमुन्मथितं दृष्ट्वा युयुत्सुः क्रोधमूर्च्छितः।\nउलूकं पञ्चभिर्बाणैराजघान स्तनान्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2060508, "chapter_id": 2295, "verse_number": "८-१६-९", "content_sanskrit": "उलूकस्तस्य समरे तैलधौतेन मारिष।\nशिरश्चिच्छेद भल्लेन यन्तुर्भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2060509, "chapter_id": 2295, "verse_number": "८-१६-१०", "content_sanskrit": "तच्छिन्नमपतद्भूमौ युयुत्सोः सारथेस्तदा।\nतारारूपं यथा चित्रं निपपात महीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2060510, "chapter_id": 2295, "verse_number": "८-१६-११", "content_sanskrit": "जघान चतुरोऽश्वांश्च तं च विव्याध पञ्चभिः।\nसोऽतिविद्वो बलवता प्रत्यपायाद्रथान्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2060511, "chapter_id": 2295, "verse_number": "८-१६-१२", "content_sanskrit": "तं निर्जित्य रणे राजन्नुलूकस्त्वरितो ययौ।\nपाञ्चालान्सृञ्जयांश्चैव विनिघ्नन्निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2060512, "chapter_id": 2295, "verse_number": "८-१६-१३", "content_sanskrit": "शतानीकं महाराज श्रुतकर्मा सुतस्तव।\nव्यश्वसूतरथं चक्रे निमेषार्धादसम्भ्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2060513, "chapter_id": 2295, "verse_number": "८-१६-१४", "content_sanskrit": "हताश्वे तु रथे तिष्ठञ्शतानीको महारथः।\nगदां चिक्षेप सङ्क्रुद्धस्तव पुत्रस्य मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2060514, "chapter_id": 2295, "verse_number": "८-१६-१५", "content_sanskrit": "सा कृत्वा स्यन्दनं भस्म हयांश्चैव ससारथीन्।\nपपात धरणीं तूर्णं दारयन्तीव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2060515, "chapter_id": 2295, "verse_number": "८-१६-१६", "content_sanskrit": "तावुभौ विरथौ वीरौ कुरूणां कीर्तिवर्धनौ।\nव्यपाक्रमेतां युद्वात्तु प्रेक्षमाणौ परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2060516, "chapter_id": 2295, "verse_number": "८-१६-१७", "content_sanskrit": "पुत्रस्तु तव सम्भ्रान्तो विविंशो रथमारुहत्।\nशतानीकोऽपि त्वरितः प्रतिविन्ध्यरथं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2060517, "chapter_id": 2295, "verse_number": "८-१६-१८", "content_sanskrit": "सुतमोमं तु शकुनिर्विद्व्वा तु निशितैः शरैः।\nनाकम्पयत सङ्क्रुद्वो वार्योघ इव पर्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2060518, "chapter_id": 2295, "verse_number": "८-१६-१९", "content_sanskrit": "सुतसोमस्तु तं दृष्ट्वा पितुरत्यन्तवैरिणम्।\nशरैरनेकसाहस्रैश्छादयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2060519, "chapter_id": 2295, "verse_number": "८-१६-२०", "content_sanskrit": "ताञ्शराञ्शकुनिस्तूर्णं चिच्छेदान्यैः पतत्रिभिः।\nलघ्वस्त्रश्चित्रयोधी च जितकाशी च संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2060520, "chapter_id": 2295, "verse_number": "८-१६-२१", "content_sanskrit": "निवार्य समरे चापि शरांस्तान्निशितैः शरैः।\nआजघान सुसङ्क्रुद्धः सुतसोमं त्रिभिः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2060521, "chapter_id": 2295, "verse_number": "८-१६-२२", "content_sanskrit": "`नाकम्पयत सङ्क्रुद्धो वार्योघ इव पर्वतम्।\nतस्याश्वान्केतनं सूतं तिलशो व्यधमच्छरैः।\nश्यालस्तव महाराज तत उच्चुक्रुशुर्जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2060522, "chapter_id": 2295, "verse_number": "८-१६-२३", "content_sanskrit": "हताश्वो विरथश्चैव छिन्नकेतुश्च मारिष।\nधन्वी धनुर्वरं गृह्य रथाद्भूमावतिष्ठत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2060523, "chapter_id": 2295, "verse_number": "८-१६-२४", "content_sanskrit": "व्यसृजत्सायकांश्चैव स्वर्णपुङ्खाञ्शिलाशितान्।\nछादयामासुरथ ते तव श्यालस्य तं रथम्।\nशळभानामिव व्राताः शरव्राता महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2060524, "chapter_id": 2295, "verse_number": "८-१६-२५", "content_sanskrit": "सञ्छाद्यमानोऽपि दृढं विव्यथे नैव सौबलः।\nप्रममाथ शरांस्तस्य शरव्रातैर्महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2060525, "chapter_id": 2295, "verse_number": "८-१६-२६", "content_sanskrit": "तत्रातुष्यन्त योधाश्च सिद्वाश्चापि दिवि स्थिताः।\nसुतसोमस्य तत्कर्म दृष्ट्वाऽश्रद्वेयमद्भुतम्।\nरथस्थं शकुनिं यत्तु पदातिः समयोधयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2060526, "chapter_id": 2295, "verse_number": "८-१६-२७", "content_sanskrit": "तस्य तीक्ष्णैर्महावेगैर्भल्लैः सन्नतपर्वभिः।\nव्यहनत्कारामुकं राजंस्तूणीरांश्चैव सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2060527, "chapter_id": 2295, "verse_number": "८-१६-२८", "content_sanskrit": "स च्छिन्नधन्वा विरथः खङ्गमुद्यम्य चानदत्।\nवैदूर्योत्पलवर्णाभं दन्तिदन्तमयत्सरुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2060528, "chapter_id": 2295, "verse_number": "८-१६-२९", "content_sanskrit": "भ्राम्यमाणं ततस्तं तु विमलाम्बरवर्चसम्।\nकालदण्डोपमं मेने सुतसोमस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2060529, "chapter_id": 2295, "verse_number": "८-१६-३०", "content_sanskrit": "सोऽचरत्सहसा खङ्गी मण्डलानि सहस्रशः।\nचतुर्दश महाराज शिक्षाबलसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2060530, "chapter_id": 2295, "verse_number": "८-१६-३१", "content_sanskrit": "भ्रान्तमुद्धान्तमाविद्धमाप्लुतं विप्लुतं सृतम्।\nसम्पातसमुदीर्णे च दर्शयामास संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2060531, "chapter_id": 2295, "verse_number": "८-१६-३२", "content_sanskrit": "सौबलस्तु ततस्तस्य शरांश्चिक्षेप वीर्यवान्।\nतानापतत एवाशु चिच्छेद परमासिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2060532, "chapter_id": 2295, "verse_number": "८-१६-३३", "content_sanskrit": "ततः क्रुद्धो महाराज सौबलः परवीरहा।\nप्राहिणोत्सुतसोमाय शरानाशीविषोपमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2060533, "chapter_id": 2295, "verse_number": "८-१६-३४", "content_sanskrit": "चिच्छेद तांस्तु खङ्गेन शिक्षया च बलेन च।\nदर्शयँल्लाघवं युद्धे तार्क्ष्यतुल्यपराक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2060534, "chapter_id": 2295, "verse_number": "८-१६-३५", "content_sanskrit": "तस्य सञ्चरतो राजन्मण्डलावर्तने तदा।\nक्षुरप्रेण सुतीक्ष्णेन खङ्गं चिच्छेद सुप्रभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2060535, "chapter_id": 2295, "verse_number": "८-१६-३६", "content_sanskrit": "स च्छिन्नः सहसा भूमौ निपपात महानसिः।\nअधर्मस्य स्थितं हस्ते सुत्सरोस्तत्र भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2060536, "chapter_id": 2295, "verse_number": "८-१६-३७", "content_sanskrit": "छिन्नमाज्ञाय निस्त्रिंशमवप्लुत्य पदानि षट्।\nप्राविध्यत ततः शेषं सुतसोमो महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2060537, "chapter_id": 2295, "verse_number": "८-१६-३८", "content_sanskrit": "तच्छित्त्वा सगुणं चापं रणे तस्य महात्मनः।\nपपात धरणीं तूर्णं स्वर्णवज्रविभूषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2060538, "chapter_id": 2295, "verse_number": "८-१६-३९", "content_sanskrit": "सुतसोमस्ततोऽगच्छच्छ्रुतकीर्तेर्महारथम्।\nसौबलोऽपि धनुर्गृह्य घोरमन्यत्सुदुर्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2060539, "chapter_id": 2295, "verse_number": "८-१६-४०", "content_sanskrit": "अभ्ययात्पाण्डवानीकं निघ्नञ्शत्रुगणान्बहून्।\nतत्र नादो महानासीत्पाण्डवानां विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2060540, "chapter_id": 2295, "verse_number": "८-१६-४१", "content_sanskrit": "सौबलं समरे दृष्ट्वा विचरन्तमभीतवत्।\nतान्यनीकानि दृप्तानि शस्त्रवन्ति महान्ति च।\nद्राव्यमाणान्यदृश्यन्त सौबलेन महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2060541, "chapter_id": 2295, "verse_number": "८-१६-४२", "content_sanskrit": "यथा दैत्यचमूं राजन्देवराजो ममर्द ह।\nतथैव पाण़्वीं सेनां सौबलेयो व्यनाशयत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2060542, "chapter_id": 2295, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि षोडशदिवसयुद्धे षोडशोऽध्यायः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]