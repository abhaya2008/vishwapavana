[{"id": 2198313, "chapter_id": 5217, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2198314, "chapter_id": 5217, "verse_number": "१", "content_sanskrit": "स्त्रीणां स्वभावमिच्छामि श्रोतुं भरतसत्तम ।\nस्त्रियो हि मूलं दोषाणां लघुचित्ताः पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2198315, "chapter_id": 5217, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2198316, "chapter_id": 5217, "verse_number": "२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nनारदस्य च संवादं पुंश्चल्या पञ्चचूडया\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2198317, "chapter_id": 5217, "verse_number": "३", "content_sanskrit": "लोकाननुचरन् धीमान् देवर्षिर्नारदः पुरा ।\nददर्शाप्सरसं ब्राह्मीं पञ्चचूडामनिन्दिताम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2198318, "chapter_id": 5217, "verse_number": "४", "content_sanskrit": "तां दृष्ट्वा चारुसर्वाङ्गीं पप्रच्छाप्सरसं मुनिः ।\nसंशयो हृदि मे कश्चित् तन्मे ब्रूहि सुमध्यमे\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2198319, "chapter_id": 5217, "verse_number": "५", "content_sanskrit": "एवमुक्ता तु सा विप्रं प्रत्युवाचाथ नारदम् ।\nविषये सति वक्ष्यामि समर्थां मन्यसे च माम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2198320, "chapter_id": 5217, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2198321, "chapter_id": 5217, "verse_number": "६", "content_sanskrit": "न त्वामविषये भद्रे नियोक्ष्यामि कथञ्चन ।\nस्त्रीणां स्वभावमिच्छामि त्वत्तः श्रोतुं वरानने\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2198322, "chapter_id": 5217, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2198323, "chapter_id": 5217, "verse_number": "७", "content_sanskrit": "एतच्छ्रुत्वा वचस्तस्य देवर्षेरप्सरोत्तमा ।\nप्रत्युवाच न शक्ष्यामि स्त्री सती निन्दितुं स्त्रियः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2198324, "chapter_id": 5217, "verse_number": "८", "content_sanskrit": "विदितास्ते स्त्रियो याश्च यादृशाश्च स्वभावतः ।\nन मामर्हसि देवर्षे नियोक्तुं प्रश्न ईदृशे\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2198325, "chapter_id": 5217, "verse_number": "९", "content_sanskrit": "तामुवाच स देवर्षिः सत्यं वद सुमध्यमे ।\nमृषावादे भवेद् दोषः सत्ये दोषो न विद्यते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2198326, "chapter_id": 5217, "verse_number": "१०", "content_sanskrit": "इत्युक्ता सा कृतमतिरभवच्चारुहासिनी ।\nस्त्रीदोषान् शाश्वतान् सत्यान् भाषितुं सम्प्रचक्रमे\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2198327, "chapter_id": 5217, "verse_number": "", "content_sanskrit": "पञ्चचूडा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2198328, "chapter_id": 5217, "verse_number": "११", "content_sanskrit": "कुलीना रूपवत्यश्च नाथवत्यश्च योषितः ।\nमर्यादासु न तिष्ठन्ति स दोषः स्त्रीषु नारद\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2198329, "chapter_id": 5217, "verse_number": "१२", "content_sanskrit": "न स्त्रीभ्यः किञ्चिदन्यद् वै पापीयस्तरमस्ति वै ।\nस्त्रियो हि मूलं दोषाणां तथा त्वमपि वेत्थ ह\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2198330, "chapter_id": 5217, "verse_number": "१३", "content_sanskrit": "समाज्ञातानृद्धिमतः प्रतिरूपान् वशे स्थितान् ।\nपतीनन्तरमासाद्य नालं नार्यः प्रतीक्षितुम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2198331, "chapter_id": 5217, "verse_number": "१४", "content_sanskrit": "असद्धर्मस्त्वयं स्त्रीणामस्माकं भवति प्रभो ।\nपापीयसो नरान् यद् वै लज्जां त्यक्त्वा भजामहे\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2198332, "chapter_id": 5217, "verse_number": "१५", "content_sanskrit": "स्त्रियं हि यः प्रार्थयते सन्निकर्षं च गच्छति ।\nईषच्च कुरुते सेवां तमेवेच्छन्ति योषितः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2198333, "chapter_id": 5217, "verse_number": "१६", "content_sanskrit": "अनर्थित्वान्मनुष्याणां भयात् परिजनस्य च ।\nमर्यादायाममर्यादाः स्त्रियस्तिष्ठन्ति भर्तृषु\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2198334, "chapter_id": 5217, "verse_number": "१७", "content_sanskrit": "नासां कश्चिदगम्योऽस्ति नासां वयसि संस्थितिः ।\nविरूपं रूपवन्तं वा पुमानित्येव भुञ्जते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2198335, "chapter_id": 5217, "verse_number": "१८", "content_sanskrit": "न भयान्नाप्यनुक्रोशान्नार्थहेतोः कथञ्चन ।\nन ज्ञातिकुलसम्बन्धात् स्त्रियस्तिष्ठन्ति भर्तृषु\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2198336, "chapter_id": 5217, "verse_number": "१९", "content_sanskrit": "यौवने वर्तमानानां मृष्टाभरणवाससाम् ।\nनारीणां स्वैरवृत्तानां स्पृहयन्ति कुलस्त्रियः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2198337, "chapter_id": 5217, "verse_number": "२०", "content_sanskrit": "याश्च शश्वद् बहुमता रक्ष्यन्ते दयिताः स्त्रियः ।\nअपि ताः सम्प्रसज्जन्ते कुब्जान्धजडवामनैः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2198338, "chapter_id": 5217, "verse_number": "२१", "content_sanskrit": "पङ्गुष्वपि च देवर्षे ये चान्ये कुत्सिता नराः ।\nस्त्रीणामगम्यो लोकेऽस्मिन्नास्ति कश्चिन्महामुने\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2198339, "chapter_id": 5217, "verse_number": "२२", "content_sanskrit": "यदि पुंसां गतिर्ब्रह्मन् कथञ्चिन्नोपपद्यते ।\nअप्यन्योन्यं प्रवर्तन्ते न हि तिष्ठन्ति भर्तृषु\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2198340, "chapter_id": 5217, "verse_number": "२३", "content_sanskrit": "दुष्टाचाराः पापरता असत्या मायया वृताः ।\nअदृष्टबुद्धिबहुलाः प्रायेणेत्यवगम्यताम् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2198341, "chapter_id": 5217, "verse_number": "२४", "content_sanskrit": "अलाभात् पुरुषाणां हि भयात् परिजनस्य च ।\nवधबन्धभयाच्चापि स्वयं गुप्ता भवन्ति ताः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2198342, "chapter_id": 5217, "verse_number": "२५", "content_sanskrit": "चलस्वभावा दुःसेव्या दुर्ग्राह्या भावतस्तथा ।\nप्राज्ञस्य पुरुषस्येह यथा वाचस्तथा स्त्रियः ।\nसुहृद्यवद्यहृद्यास्ता वैरकोपालया स्मृताः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2198343, "chapter_id": 5217, "verse_number": "२६", "content_sanskrit": "नाग्निस्तृप्यति काष्ठानां नापगानां महोदधिः ।\nनान्तकः सर्वभूतानां न पुंसां वामलोचनाः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2198344, "chapter_id": 5217, "verse_number": "२७", "content_sanskrit": "इदमन्यच्च देवर्षे रहस्यं सर्वयोषिताम् ।\nदृष्ट्वैव पुरुषं हृद्यं योनिः प्रक्लिद्यते स्त्रियः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2198345, "chapter_id": 5217, "verse_number": "२८", "content_sanskrit": "कामानामपि दातारं कर्तारं मानसान्त्वयोः ।\nरक्षितारं न मृष्यन्ति भर्तारं परमं स्त्रियः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2198346, "chapter_id": 5217, "verse_number": "२९", "content_sanskrit": "न कामभोगान् बहुलान् नालङ्कारार्थसञ्चयान् ।\nतथैव बहु मन्यन्ते यथा रत्यामनुग्रहम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2198347, "chapter_id": 5217, "verse_number": "३०", "content_sanskrit": "अन्तकः शमनो मृत्युः पाताळं वडवामुखम् ।\nक्षुरधारा विषं सर्पो वह्निरित्येकतः स्त्रियः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2198348, "chapter_id": 5217, "verse_number": "३१", "content_sanskrit": "यतश्च भूतानि महान्ति पञ्च\nयतश्च लोका विहिता विधात्रा ।\nयतः पुमांसः प्रमदाश्च निर्मिता-\nस्तदैव दोषाः प्रमदासु नारद \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2198349, "chapter_id": 5217, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे नारदपञ्चचूषासंवादे स्त्रीणां स्वभाववर्णनं नाम अष्टषष्टितमोऽध्यायः ॥६८॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]