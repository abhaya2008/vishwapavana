[{"id": 2088088, "chapter_id": 2873, "verse_number": "१३-३-१", "content_sanskrit": "युधिष्ठिर उवाच।\nप्रज्ञाश्रुताभ्यां वृत्तेन शीलेन च यथा भवान्।\nगुणैश्च विविधैः सर्वैर्वयसा च समन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2088089, "chapter_id": 2873, "verse_number": "१३-३-२", "content_sanskrit": "भवान्विशिष्टो बुद्ध्या च प्रज्ञया तपसा तथा।\n`सर्वेषामेव जातानां सतामेतन्न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2088090, "chapter_id": 2873, "verse_number": "१३-३-३", "content_sanskrit": "तस्माद्भवन्तं पृच्छामि धर्मं धर्मभृतांवर।\nनान्यस्त्वदन्यो लोकेषु प्रष्टव्योस्ति नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2088091, "chapter_id": 2873, "verse_number": "१३-३-४", "content_sanskrit": "क्षत्रियो यदि वा वैश्यः शूद्रो वा राजसत्तम।\nब्राह्मण्यं प्राप्नुयाद्येन तन्मे व्याख्यातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2088092, "chapter_id": 2873, "verse_number": "१३-३-५", "content_sanskrit": "`ब्राह्मण्यं यदि दुष्प्रापं त्रिभिर्वर्णैर्नराधिप।\nतपसा वा सुमहता कर्मणा वा श्रुतेन वा।\nब्राह्मण्यमथ चेदिच्छेत्कथं शक्यं पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2088093, "chapter_id": 2873, "verse_number": "१३-३-६x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2088094, "chapter_id": 2873, "verse_number": "१३-३-६", "content_sanskrit": "ब्राह्मण्यमतिदुष्प्राप्यं वर्णैः क्षत्रादिभिस्त्रिभिः।\nपरं हि सर्वभूतानां स्थानमेतद्युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2088095, "chapter_id": 2873, "verse_number": "१३-३-७", "content_sanskrit": "बह्विस्तु संसरन्योनीर्जायमानः पुनःपनः।\nपर्याये तात कस्मिंश्चिद्ब्राह्मणो नाम जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2088096, "chapter_id": 2873, "verse_number": "१३-३-८", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nमतङ्गस्य च संवादं गर्दभ्याश्च युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2088097, "chapter_id": 2873, "verse_number": "१३-३-९", "content_sanskrit": "द्विजातेः कस्यचित्तात तुल्यवर्णः सुतस्त्वभूत्।\nमतङ्गो नाम नाम्नाऽऽसीत्सर्वैः समुदितो गुणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2088098, "chapter_id": 2873, "verse_number": "१३-३-१०", "content_sanskrit": "स यज्ञकारः कौन्तेय पित्रोत्सृष्टः परंतप।\nप्रायाद्गर्दभयुक्तेन रथेनाप्याशुगामिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2088099, "chapter_id": 2873, "verse_number": "१३-३-११", "content_sanskrit": "स बालं गर्दभं राजन्वहन्तं मातुरन्तिके।\nनिरविध्यत्प्रतोदेन नासिकायां पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2088100, "chapter_id": 2873, "verse_number": "१३-३-१२", "content_sanskrit": "तं दृश्य नसि निर्भिन्नं गर्दभी पुत्रगृद्धिनी।\nउवाच मा शुचः पुत्र चण्डालस्त्वाभिविध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2088101, "chapter_id": 2873, "verse_number": "१३-३-१३", "content_sanskrit": "ब्राह्मणो दारुणो नास्ति मैत्रो ब्राह्मण उच्यते।\nआचार्यः सर्वभूतानां शास्ता किं प्रहरिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2088102, "chapter_id": 2873, "verse_number": "१३-३-१४", "content_sanskrit": "अयं तु पापप्रकृतिर्बाले न कुरुते दयाम्।\nस्वयोनिं मानयत्येष भावो भावं नियच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2088103, "chapter_id": 2873, "verse_number": "१३-३-१५", "content_sanskrit": "एतच्छ्रुत्वा मतङ्गस्तु दारुणं रासभीवचः।\nअवतीर्य रथात्तूर्णं रासभीं प्रत्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2088104, "chapter_id": 2873, "verse_number": "१३-३-१६", "content_sanskrit": "ब्रूहि रासभि कल्याणि माता मे येन दूषिता।\nकेन मां वेत्सि चण्डालं ब्राह्मण्यं केन मेऽनशत्।\nतत्त्वेनैतन्महाप्राज्ञे ब्रूहि सर्वमशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2088105, "chapter_id": 2873, "verse_number": "१३-३-१७x", "content_sanskrit": "गर्दभ्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2088106, "chapter_id": 2873, "verse_number": "१३-३-१७", "content_sanskrit": "ब्राह्मण्यां वृषलेन त्वं मत्तायां नापितेन ह।\nजातस्त्वमसि चण्डालो ब्राह्मण्यं तेन तेऽनशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2088107, "chapter_id": 2873, "verse_number": "१३-३-१८", "content_sanskrit": "एवमुक्तो मतङ्गस्तु प्रतिप्रायाद्गृहं पुनः।\nतमागतमभिप्रेक्ष्य पिता वाक्यमथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2088108, "chapter_id": 2873, "verse_number": "१३-३-१९", "content_sanskrit": "यस्त्वं यज्ञार्थसंसिद्धौ नियुक्तो गुरुकर्मणि।\nकस्मात्प्रतिनिवृत्तोसि कच्चिन्न कुशलं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2088109, "chapter_id": 2873, "verse_number": "१३-३-२०x", "content_sanskrit": "मतङ्ग उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2088110, "chapter_id": 2873, "verse_number": "१३-३-२०", "content_sanskrit": "अन्त्ययोनिरयोनिर्वा कथं स कुशली भवेत्।\nकुशलं तु कुतस्तस्य यस्येयं जननी पितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2088111, "chapter_id": 2873, "verse_number": "१३-३-२१", "content_sanskrit": "ब्राह्मण्यां वृषलाञ्जातं पितर्वेदयते हि माम्।\nअमानुषी गर्दभीयं तस्मात्तप्स्ये तपो महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2088112, "chapter_id": 2873, "verse_number": "१३-३-२२", "content_sanskrit": "एवमुक्त्वा स पितरं प्रतस्थे कृतनिश्चयः।\nततो गत्वा महारण्यमतपत्सुमहत्तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2088113, "chapter_id": 2873, "verse_number": "१३-३-२३", "content_sanskrit": "ततः स तापयामास विबुधांस्तपसाऽन्वितः।\nमतङ्गः सुसुखं प्रेप्सुः स्थानं सुचरितादपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2088114, "chapter_id": 2873, "verse_number": "१३-३-२४", "content_sanskrit": "तं तथा तपसा युक्तमुवाच हरिवाहनः।\nमतङ्ग तप्स्यसे किं त्वं भोगानुत्सृज्य मानुषान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2088115, "chapter_id": 2873, "verse_number": "१३-३-२५", "content_sanskrit": "वरं ददामि ते हन्त वृणीष्व त्वं यदिच्छसि।\nयच्चाप्यवाप्यं हृदि ते सर्वं तद्ब्रूहि मा चिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2088116, "chapter_id": 2873, "verse_number": "१३-३-२६x", "content_sanskrit": "मतङ्ग उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2088117, "chapter_id": 2873, "verse_number": "१३-३-२६", "content_sanskrit": "ब्राह्मण्यं कामयानोऽहमिदमारब्धवांस्तपः।\nगच्छेयं तदवाप्येह वर एष वृतो मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2088118, "chapter_id": 2873, "verse_number": "१३-३-२७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2088119, "chapter_id": 2873, "verse_number": "१३-३-२७", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं तमुवाच पुरदरः।\nमतङ्ग दुर्लभमिदं विप्रत्वं प्रार्थ्यते त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2088120, "chapter_id": 2873, "verse_number": "१३-३-२८", "content_sanskrit": "ब्राह्मण्यं प्रार्थयानस्त्वमप्राप्यमकृतात्मभिः।\nविनशिष्यसि दुर्बुद्धे तदुपारम मा चिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2088121, "chapter_id": 2873, "verse_number": "१३-३-२९", "content_sanskrit": "श्रेष्ठं यत्सर्वभूतेषु तपो यदतिवर्तते।\nतदग्र्यं प्रार्थयानस्त्वमचिराद्विनशिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2088122, "chapter_id": 2873, "verse_number": "१३-३-३०", "content_sanskrit": "देवतासुरमर्त्येषु यत्पवित्रं परं स्मृतम्।\nचण्डालयोनौ जातेन न तत्प्राप्यं कथञ्चन॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2088123, "chapter_id": 2873, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि तृतीयोऽध्यायः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]