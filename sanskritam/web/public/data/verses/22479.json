[{"id": 7002479000, "chapter_id": 22479, "verse_number": "१-१४१-१", "content_sanskrit": "साम्ब उवाच ।\nभोजकानां यत्त्वयोक्तमव्यङ्गो देहशोधकः ।\nव्रतबन्धस्त्वसौ प्रोक्तस्तेषां जातिश्च का स्मृता ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002479001, "chapter_id": 22479, "verse_number": "१-१४१-२", "content_sanskrit": "व्यास उवाच ।\nते पृष्टा भवता सर्वे भोजकानां कुमारकाः ।\nकिमाख्यातं ततस्तैस्तु तदेवाचक्ष्व कृत्स्नशः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002479002, "chapter_id": 22479, "verse_number": "१-१४१-३", "content_sanskrit": "साम्ब उवाच ।\nसन्निवेषा मया प्रोक्ता भोजकानां समन्ततः ।\nममैव ब्रूत तत्त्वं तद्वर्णः कोऽत्र कथं स्थितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002479003, "chapter_id": 22479, "verse_number": "१-१४१-४", "content_sanskrit": "ततस्तु भगवान्प्राह वाक्यं वाक्यविशारदः ।\nये त्वयोक्ता श्रुताः साम्ब भोजकानां कुमारकाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002479004, "chapter_id": 22479, "verse_number": "१-१४१-५", "content_sanskrit": "ममैवैते मगा ज्ञेया अष्टौ शूद्रा मदङ्गजाः ।\nएतद्बुद्ध्वा तु वचनं प्रणम्य शिरसा रविम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002479005, "chapter_id": 22479, "verse_number": "१-१४१-६", "content_sanskrit": "दत्ता भोजकुलोत्पन्ना दशभ्यो दशकन्यकाः ।\nततस्तु मन्दकेभ्योऽपि दत्ताश्चाष्टौ हि कन्यकाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002479006, "chapter_id": 22479, "verse_number": "१-१४१-७", "content_sanskrit": "ततो निवेशितं तेषां मया साम्ब पुरं स्मर ।\nदासकन्यास्तु याश्चाष्टौ भोजकन्याश्च या दश ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002479007, "chapter_id": 22479, "verse_number": "१-१४१-८", "content_sanskrit": "एतास्तेषां कुमाराणां ज्ञेयास्ता दश चाष्ट च ।\nतत्र ते भोजकन्यासु द्विजैरुत्पादिताः सुताः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002479008, "chapter_id": 22479, "verse_number": "१-१४१-९", "content_sanskrit": "भोजकास्तान्गणान्प्राहुर्ब्राह्मणान्दिव्यसंज्ञितान् ।\nदासकन्यासु ये जाता मन्दगैरन्त्यसंज्ञितैः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002479009, "chapter_id": 22479, "verse_number": "१-१४१-१०", "content_sanskrit": "मदङ्गा नाम ते ज्ञेयाः सवितुः परिचारकाः ।\nते च विप्रपुरे तस्मिन्पुत्रदारशुभैर्वृताः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002479010, "chapter_id": 22479, "verse_number": "१-१४१-११", "content_sanskrit": "स्वधर्मैर्यष्टुमारब्धैः शाकद्वीपेऽर्चितो रविः ।\nनानाविधैर्वैदिकैस्तु मन्त्रैर्मुनिवरोत्तमाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002479011, "chapter_id": 22479, "verse_number": "१-१४१-१२", "content_sanskrit": "अव्यङ्गधारिणो मर्त्याः पूजयन्ते दिवस्पतिम् ।\nदृष्ट्वा व्यङ्गं तु वै तेषां कौतूहलसमन्वितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002479012, "chapter_id": 22479, "verse_number": "१-१४१-१३", "content_sanskrit": "साम्बः प्राह नमस्कृत्य भूयः सत्यवतीसुतम् ।\nकथं वरोऽयमव्यङ्गः कथितो मुनिसत्तम ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002479013, "chapter_id": 22479, "verse_number": "१-१४१-१४", "content_sanskrit": "कुत एष समुत्पन्नः कस्माच्च स शुचिः स्मृतः ।\nबन्धनीयः कदा चायं किमर्थं चैव धार्यते ।\nकिं प्रमाणं च भगवन्व्यङ्गश्चायं किमुच्यते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002479014, "chapter_id": 22479, "verse_number": "१-१४१-१५", "content_sanskrit": "सुमन्तुरुवाच ।\nश्रुत्वैवं वचनं व्यासो जाम्बवत्याः सुतस्य च ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002479015, "chapter_id": 22479, "verse_number": "१-१४१-१६", "content_sanskrit": "उवाच कुरुशार्दूल साम्बं कालीसुतः स तु ।\nव्यास उवाच ।\nएतच्च मे यथोक्तस्त्वं जातिरेषां न संशयः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002479016, "chapter_id": 22479, "verse_number": "१-१४१-१७", "content_sanskrit": "अव्यङ्गस्यापि ते वच्मि लक्षणं गदतः शृणु ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]