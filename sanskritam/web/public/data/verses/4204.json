[{"id": 2148123, "chapter_id": 4204, "verse_number": "", "content_sanskrit": "माता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2148124, "chapter_id": 4204, "verse_number": "१", "content_sanskrit": "नैव राज्ञा दरः कार्यो जातु कस्याञ्चिदापदि ।\nअथ चेदपि दीर्णः स्यान्नैव वर्तेत दीर्णवत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2148125, "chapter_id": 4204, "verse_number": "२", "content_sanskrit": "दीर्णं हि दृष्ट्वा राजानं सर्वमेवानुदीर्यते ।\nराष्ट्रं बलममात्याश्च पृथक् कुर्वन्ति ते मतिम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2148126, "chapter_id": 4204, "verse_number": "३", "content_sanskrit": "शत्रूनेके प्रपद्यन्ते प्रजहत्यपरे पुनः ।\nअन्ये तु प्रजिहीर्षन्ति ये पुरस्ताद् विमानिताः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2148127, "chapter_id": 4204, "verse_number": "४", "content_sanskrit": "य एवात्यन्तसुहृदः त एनं पर्युपासते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2148128, "chapter_id": 4204, "verse_number": "५", "content_sanskrit": "अशक्ता ये स्वस्तिकामा बद्धवत्सा जला इव ।\nशोचन्तमनुशोचन्ति प्रमीतानिव बान्धवान्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2148129, "chapter_id": 4204, "verse_number": "६", "content_sanskrit": "अपि ते पूजिताः पूर्वमपि ते सुहृदो मताः ।\nये राष्ट्रमभिपद्यन्ते राज्ञि व्यसनमीयुषि\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2148130, "chapter_id": 4204, "verse_number": "७", "content_sanskrit": "मा दीदरस्त्वं सुहृदो मा त्वां दीर्णं प्रहासिषुः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2148131, "chapter_id": 4204, "verse_number": "८", "content_sanskrit": "प्रभावं पौरुषं बुद्धिं जिज्ञासन्त्या मया तव ।\nविदधत्या समाश्वासमुक्तं तेजोविवृद्धये\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2148132, "chapter_id": 4204, "verse_number": "९", "content_sanskrit": "यद्येतत् संविजानासि यदि सम्यग् ब्रवीम्यहम् ।\nकृत्वा सौम्यमिवात्मानं जयायोत्तिष्ठ सृञ्जय\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2148133, "chapter_id": 4204, "verse_number": "१०", "content_sanskrit": "अस्ति नः कोशनिचयो महानविदितस्तव ।\nतदहं वेद नान्यस्तमुपसम्पादयामि ते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2148134, "chapter_id": 4204, "verse_number": "११", "content_sanskrit": "सन्ति नैकशता भूयः सुहृदस्तव सृञ्जय ।\nसुखदुःखसहा वीर प्रियार्हा ह्यनिवर्तिनः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2148135, "chapter_id": 4204, "verse_number": "१२", "content_sanskrit": "तादृशा हि सहायाश्चेत् पुरुषस्य बुभूषतः ।\nइष्टं न दुष्करं किञ्चित् सचिवैः शत्रुकर्शन\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2148136, "chapter_id": 4204, "verse_number": "", "content_sanskrit": "पुत्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2148137, "chapter_id": 4204, "verse_number": "१३", "content_sanskrit": "कस्य त्वीदृशकं वाक्यं श्रुत्वाऽपि स्वल्पचेतसः ।\nतमो न व्यपहन्येत विचित्रार्थपदाक्षरम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2148138, "chapter_id": 4204, "verse_number": "१४", "content_sanskrit": "उदके धूरियं धार्या सर्तव्यं प्रवणे मया ।\nयस्य मे भवती नेत्री भविष्यद्भूतदर्शिनी\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2148139, "chapter_id": 4204, "verse_number": "१५", "content_sanskrit": "अहं हि वचनं त्वत्तः शुश्रूषुरपरापरम् ।\nकिञ्चित् किञ्चित् प्रतिवदन् तूष्णीमासं मुहुर्मुहुः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2148140, "chapter_id": 4204, "verse_number": "१६", "content_sanskrit": "अतृप्यन्नमृतस्येव कृच्छ्राल्लब्धस्य बान्धवात् ।\nउद्यच्छाम्येष शत्रूणां नियमार्थं जयाय च\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2148141, "chapter_id": 4204, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2148142, "chapter_id": 4204, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रुत्वा वचो मातुः सृञ्जयः शत्रुभिः सह ।\nकृतवान् संयुगं कृष्ण जयं च प्राप्तवान् ध्रुवम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2148143, "chapter_id": 4204, "verse_number": "१८", "content_sanskrit": "सदश्व इव स क्षिप्रं प्रणुन्नो वाक्यसायकैः ।\nतच्चकार तथा सर्वं यथावदनुशासनम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2148144, "chapter_id": 4204, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2148145, "chapter_id": 4204, "verse_number": "१९", "content_sanskrit": "इदमुद्धर्षणं भीमं तेजोवर्धनमुत्तमम् ।\nराजानं श्रावयेन्मन्त्री सीदन्तं शत्रुपीडितम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2148146, "chapter_id": 4204, "verse_number": "२०", "content_sanskrit": "जयो नामेतिहासोऽयं श्रोतव्यो विजिगीषुणा ।\nमहीं विजयते क्षिप्रं श्रुत्वा शत्रून् प्रमर्दति\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2148147, "chapter_id": 4204, "verse_number": "२१", "content_sanskrit": "इदं पुंसवनं चैव वीरसञ्जननं तथा ।\nअभीक्ष्णं गर्भिणी श्रुत्वा ध्रुवं वीरं प्रजायते\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2148148, "chapter_id": 4204, "verse_number": "२२", "content_sanskrit": "विद्याशूरं तपःशूरं दमशूरं तपस्विनम् ।\nब्राह्म्या श्रिया दीप्यमानं साधुवादेन सम्मतम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2148149, "chapter_id": 4204, "verse_number": "२३", "content_sanskrit": "स्वर्चिष्मन्तं बलोपेतं महाभागं महारथम् ।\nधृतिमन्तमनाधृष्यं जेतारमपराजितम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2148150, "chapter_id": 4204, "verse_number": "२४", "content_sanskrit": "नियन्तारमसाधूनां गोप्तारं धर्मचारिणाम् ।\nईदृशं क्षत्रिया सूते वीरं सत्यपराक्रमम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2148151, "chapter_id": 4204, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि पञ्चत्रिंशोत्तरशततमोऽध्यायः ॥१३५॥\nभगवद्यानपर्वणि षट्षष्टितमोऽध्यायः ॥६६॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]