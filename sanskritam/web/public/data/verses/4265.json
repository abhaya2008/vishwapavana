[{"id": 2150525, "chapter_id": 4265, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2150526, "chapter_id": 4265, "verse_number": "१", "content_sanskrit": "एतच्छ्रुत्वा तु कौन्तेयः सर्वान् भ्रातॄनुपह्वरे ।\nआहूय भरतश्रेष्ठः इदं वचनमब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2150527, "chapter_id": 4265, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2150528, "chapter_id": 4265, "verse_number": "२", "content_sanskrit": "धार्तराष्ट्रस्य सैन्येषु ये चारपुरुषा मम ।\nते प्रवृत्तिं प्रयच्छन्ति ममेमां व्युषितां निशाम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2150529, "chapter_id": 4265, "verse_number": "३", "content_sanskrit": "दुर्योधनः किलापृच्छदापगेयं महाव्रतम् ।\nकेन कालेन पाण्डूनां हन्ता सेनामिति प्रभो\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2150530, "chapter_id": 4265, "verse_number": "४", "content_sanskrit": "मासेनेति च तेनोक्तो धार्तराष्ट्रः सुदुर्मतिः ।\nतावता चापि कालेन द्रोणोऽपि प्रतिजज्ञिवान्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2150531, "chapter_id": 4265, "verse_number": "५", "content_sanskrit": "गौतमो द्विगुणं कालमुक्तवानिति नः श्रुतम् ।\nद्रौणिस्तु दशरात्रेण प्रतिजज्ञे महास्त्रवित्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2150532, "chapter_id": 4265, "verse_number": "६", "content_sanskrit": "तथा दिव्यास्त्रवित् कर्णः सम्पृष्टः कुरुसंसदि ।\nपञ्चभिर्दिवसैर्हन्तुं ससैन्यं प्रत्यजानत\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2150533, "chapter_id": 4265, "verse_number": "७", "content_sanskrit": "तस्मादहमपीच्छामि श्रोतुमर्जुन तत्त्वतः ।\nकालेन कियता शत्रून् क्षपयेरिति संयुगे\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2150534, "chapter_id": 4265, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2150535, "chapter_id": 4265, "verse_number": "८", "content_sanskrit": "एवमुक्तो गुडाकेशः पार्थिवेन धनञ्जयः ।\nवासुदेवं समीक्ष्येदं वचनं प्रत्यभाषत\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2150536, "chapter_id": 4265, "verse_number": "९", "content_sanskrit": "सर्व एते महात्मानः कृतास्त्राश्चित्रयोधिनः ।\nअसंशयं महाराज हन्युरेव बलं तव\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2150537, "chapter_id": 4265, "verse_number": "१०", "content_sanskrit": "अपैतु ते मनस्तापो यथा सत्यं ब्रवीम्यहम् ।\nहन्यामेकरथेनैव वासुदेवसहायवान्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2150538, "chapter_id": 4265, "verse_number": "११", "content_sanskrit": "सामरानपि लोकांस्त्रीन् सर्वान् स्थावरजङ्गमान् ।\nभूतं भव्यं भविष्यच्च निमेषादिति मे मतिः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2150539, "chapter_id": 4265, "verse_number": "१२", "content_sanskrit": "यत्तद् घोरं पशुपतिः प्रादादस्त्रं महन्मम ।\nकैराते द्वन्द्वयुद्धे तु तदिदं मयि वर्तते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2150540, "chapter_id": 4265, "verse_number": "१३", "content_sanskrit": "यद् युगान्ते पशुपतिः सर्वभूतानि संहरन् ।\nप्रयुङ्क्ते पुरुषव्याघ्र तदिदं मयि वर्तते\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2150541, "chapter_id": 4265, "verse_number": "१४", "content_sanskrit": "तन्न जानाति गाङ्गेयो न द्रोणो न च गौतमः ।\nन तु द्रोणसुतो राजन् कुत एव तु सूतजः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2150542, "chapter_id": 4265, "verse_number": "१५", "content_sanskrit": "न तु युक्तं रणे जेतुं दिव्यैरस्त्रैः पृथग्जनम् ।\nआर्जवेनैव युद्धेन विजेष्यामो वयं परान्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2150543, "chapter_id": 4265, "verse_number": "१६", "content_sanskrit": "तथेमे पुरुषव्याघ्राः समस्तास्तव पार्थिव ।\nसर्वे दिव्यास्त्रविद्वांसः सर्वे युद्धाभिनन्दिनः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2150544, "chapter_id": 4265, "verse_number": "१७", "content_sanskrit": "वेदान्तावभृथस्नाताः सर्व एतेऽपराजिताः ।\nनिहन्युः समरे सेनां देवानामपि पाण्डव\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2150545, "chapter_id": 4265, "verse_number": "१८", "content_sanskrit": "शिखण्डी युयुधानश्च धृष्टद्युम्नश्च पार्षतः ।\nभीमसेनो यमौ चोभौ युधामन्यूत्तमौजसौ\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2150546, "chapter_id": 4265, "verse_number": "१९", "content_sanskrit": "विराटद्रुपदौ चोभौ भीष्मद्रोणसमौ युधि ।\nशङ्खश्चैव महाबाहुर्हैडिम्बश्च महाबलः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2150547, "chapter_id": 4265, "verse_number": "२०", "content_sanskrit": "पुत्रोऽस्याञ्जनपर्वा तु महाबलपराक्रमः ।\nशैनेयश्च महाबाहुः सहायो रणकोविदः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2150548, "chapter_id": 4265, "verse_number": "२१", "content_sanskrit": "अभिमन्युश्च बलवान् द्रौपद्याः पञ्च चात्मजाः ।\nस्वयं चापि समर्थोऽसि त्रैलोक्योत्सादनेऽपि च\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2150549, "chapter_id": 4265, "verse_number": "२२", "content_sanskrit": "क्रोधाद् यं पुरुषं पश्येस्तथा शक्रसमद्युते ।\nस क्षिप्रं न भवेद् व्यक्तमिति त्वां वेद्मि कौरव\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2150550, "chapter_id": 4265, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि षण्णवत्युत्तरशततमोऽध्यायः ॥१९६॥\nअम्बोपाख्यानपर्वणि षड्विंशोऽध्यायः ॥२६॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]