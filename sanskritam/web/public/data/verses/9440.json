[{"id": 5000440000, "chapter_id": 9440, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे त्रयस्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000440001, "chapter_id": 9440, "verse_number": "६-३३-१", "content_sanskrit": "सीतां तु मोहितां दृष्ट्वा सरमा नाम राक्षसी।\nआससादाथ वैदेहीं प्रियां प्रणयिनी सखीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000440002, "chapter_id": 9440, "verse_number": "६-३३-२", "content_sanskrit": "मोहितां राक्षसेन्द्रेण सीतां परमदुःखिताम्।\nआश्वासयामास तदा सरमा मृदुभाषिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000440003, "chapter_id": 9440, "verse_number": "६-३३-३", "content_sanskrit": "सा हि तत्र कृता मित्रं सीतया रक्ष्यमाणया।\nरक्षन्ती रावणादिष्टा सानुक्रोशा दृढव्रता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000440004, "chapter_id": 9440, "verse_number": "६-३३-४", "content_sanskrit": "सा ददर्श सखी सीतां सरमा नष्टचेतनाम्।\nउपावृत्योत्थितां ध्वस्तां वडवामिव पांसुषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000440005, "chapter_id": 9440, "verse_number": "६-३३-५", "content_sanskrit": "तां समाश्वासयामास सखीस्नेहेन सुव्रताम्।\nसमाश्वसिहि वैदेहि मा भूत् ते मनसो व्यथा।\nउक्ता यद् रावणेन त्वं प्रयुक्तश्च स्वयं त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000440006, "chapter_id": 9440, "verse_number": "६-३३-६", "content_sanskrit": "सखीस्नेहेन तद् भीरु मया सर्वं प्रतिश्रुतम्।\nलीनया गहने शून्ये भयमुत्सृज्य रावणात्।\nतव हेतोर्विशालाक्षि नहि मे रावणाद् भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000440007, "chapter_id": 9440, "verse_number": "६-३३-७", "content_sanskrit": "स सम्भ्रान्तश्च निष्क्रान्तो यत्कृते राक्षसेश्वरः।\nतत्र मे विदितं सर्वमभिनिष्क्रम्य मैथिलि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000440008, "chapter_id": 9440, "verse_number": "६-३३-८", "content_sanskrit": "न शक्यं सौप्तिकं कर्तुं रामस्य विदितात्मनः।\nवधश्च पुरुषव्याघ्रे तस्मिन् नैवोपपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000440009, "chapter_id": 9440, "verse_number": "६-३३-९", "content_sanskrit": "न त्वेवं वानरा हन्तुं शक्याः पादपयोधिनः।\nसुरा देवर्षभेणेव रामेण हि सुरक्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000440010, "chapter_id": 9440, "verse_number": "६-३३-१०", "content_sanskrit": "दीर्घवृत्तभुजः श्रीमान् महोरस्कः प्रतापवान्।\nधन्वी संनहनोपेतो धर्मात्मा भुवि विश्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000440011, "chapter_id": 9440, "verse_number": "६-३३-११", "content_sanskrit": "विक्रान्तो रक्षिता नित्यमात्मनश्च परस्य च।\nलक्ष्मणेन सह भ्रात्रा कुलीनो नयशास्त्रवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000440012, "chapter_id": 9440, "verse_number": "६-३३-१२", "content_sanskrit": "हन्ता परबलौघानामचिन्त्यबलपौरुषः।\nन हतो राघवः श्रीमान् सीते शत्रुनिबर्हणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000440013, "chapter_id": 9440, "verse_number": "६-३३-१३", "content_sanskrit": "अयुक्तबुद्धिकृत्येन सर्वभूतविरोधिना।\nएवं प्रयुक्ता रौद्रेण माया मायाविना त्वयि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000440014, "chapter_id": 9440, "verse_number": "६-३३-१४", "content_sanskrit": "शोकस्ते विगतः सर्वकल्याणं त्वामुपस्थितम्।\nध्रुवं त्वां भजते लक्ष्मीः प्रियं ते भवति शृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000440015, "chapter_id": 9440, "verse_number": "६-३३-१५", "content_sanskrit": "उत्तीर्य सागरं रामः सह वानरसेनया।\nसंनिविष्टः समुद्रस्य तीरमासाद्य दक्षिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000440016, "chapter_id": 9440, "verse_number": "६-३३-१६", "content_sanskrit": "दृष्टो मे परिपूर्णार्थः काकुत्स्थः सहलक्ष्मणः।\nसहितैः सागरान्तस्थैर्बलैस्तिष्ठति रक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000440017, "chapter_id": 9440, "verse_number": "६-३३-१७", "content_sanskrit": "अनेन प्रेषिता ये च राक्षसा लघुविक्रमाः।\nराघवस्तीर्ण इत्येवं प्रवृत्तिस्तैरिहाहृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000440018, "chapter_id": 9440, "verse_number": "६-३३-१८", "content_sanskrit": "स तां श्रुत्वा विशालाक्षि प्रवृत्तिं राक्षसाधिपः।\nएष मन्त्रयते सर्वैः सचिवैः सह रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000440019, "chapter_id": 9440, "verse_number": "६-३३-१९", "content_sanskrit": "इति ब्रुवाणा सरमा राक्षसी सीतया सह।\nसर्वोद्योगेन सैन्यानां शब्दं शुश्राव भैरवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000440020, "chapter_id": 9440, "verse_number": "६-३३-२०", "content_sanskrit": "दण्डनिर्घातवादिन्याः श्रुत्वा भेर्या महास्वनम्।\nउवाच सरमा सीतामिदं मधुरभाषिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000440021, "chapter_id": 9440, "verse_number": "६-३३-२१", "content_sanskrit": "संनाहजननी ह्येषा भैरवा भीरु भेरिका।\nभेरीनादं च गम्भीरं शृणु तोयदनिःस्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000440022, "chapter_id": 9440, "verse_number": "६-३३-२२", "content_sanskrit": "कल्प्यन्ते मत्तमातङ्गा युज्यन्ते रथवाजिनः।\nदृश्यन्ते तुरगारूढाः प्रासहस्ताः सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000440023, "chapter_id": 9440, "verse_number": "६-३३-२३", "content_sanskrit": "तत्र तत्र च संनद्धाः सम्पतन्ति सहस्रशः।\nआपूर्यन्ते राजमार्गाः सैन्यैरद्भुतदर्शनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000440024, "chapter_id": 9440, "verse_number": "६-३३-२४", "content_sanskrit": "वेगवद्भिर्नदद्भिश्च तोयौघैरिव सागरः।\nशस्त्राणां च प्रसन्नानां चर्मणां वर्मणां तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000440025, "chapter_id": 9440, "verse_number": "६-३३-२५", "content_sanskrit": "रथवाजिगजानां च राक्षसेन्द्रानुयायिनाम्।\nसम्भ्रमो रक्षसामेष हृषितानां तरस्विनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000440026, "chapter_id": 9440, "verse_number": "६-३३-२६", "content_sanskrit": "प्रभां विसृजतां पश्य नानावर्णसमुत्थिताम्।\nवनं निर्दहतो घर्मे यथा रूपं विभावसोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000440027, "chapter_id": 9440, "verse_number": "६-३३-२७", "content_sanskrit": "घण्टानां शृणु निर्घोषं रथानां शृणु निःस्वनम्।\nहयानां हेषमाणानां शृणु तूर्यध्वनिं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000440028, "chapter_id": 9440, "verse_number": "६-३३-२८", "content_sanskrit": "उद्यतायुधहस्तानां राक्षसेन्द्रानुयायिनाम्।\nसम्भ्रमो रक्षसामेष तुमुलो लोमहर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000440029, "chapter_id": 9440, "verse_number": "६-३३-२९", "content_sanskrit": "श्रीस्त्वां भजति शोकघ्नी रक्षसां भयमागतम्।\nरामः कमलपत्राक्षो दैत्यानामिव वासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000440030, "chapter_id": 9440, "verse_number": "६-३३-३०", "content_sanskrit": "अवजित्य जितक्रोधस्तमचिन्त्यपराक्रमः।\nरावणं समरे हत्वा भर्ता त्वाधिगमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000440031, "chapter_id": 9440, "verse_number": "६-३३-३१", "content_sanskrit": "विक्रमिष्यति रक्षःसु भर्ता ते सहलक्ष्मणः।\nयथा शत्रुषु शत्रुघ्नो विष्णुना सह वासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000440032, "chapter_id": 9440, "verse_number": "६-३३-३२", "content_sanskrit": "आगतस्य हि रामस्य क्षिप्रमङ्कागतां सतीम्।\nअहं द्रक्ष्यामि सिद्धार्थां त्वां शत्रौ विनिपातिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000440033, "chapter_id": 9440, "verse_number": "६-३३-३३", "content_sanskrit": "अस्राण्यानन्दजानि त्वं वर्तयिष्यसि जानकि।\nसमागम्य परिष्वक्ता तस्योरसि महोरसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000440034, "chapter_id": 9440, "verse_number": "६-३३-३४", "content_sanskrit": "अचिरान्मोक्ष्यते सीते देवि ते जघनं गताम्।\nधृतामेकां बहून् मासान् वेणीं रामो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000440035, "chapter_id": 9440, "verse_number": "६-३३-३५", "content_sanskrit": "तस्य दृष्ट्वा मुखं देवि पूर्णचन्द्रमिवोदितम्।\nमोक्ष्यसे शोकजं वारि निर्मोकमिव पन्नगी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000440036, "chapter_id": 9440, "verse_number": "६-३३-३६", "content_sanskrit": "रावणं समरे हत्वा नचिरादेव मैथिलि।\nत्वया समग्रः प्रियया सुखार्हो लप्स्यते सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000440037, "chapter_id": 9440, "verse_number": "६-३३-३७", "content_sanskrit": "सभाजिता त्वं रामेण मोदिष्यसि महात्मना।\nसुवर्षेण समायुक्ता यथा सस्येन मेदिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000440038, "chapter_id": 9440, "verse_number": "६-३३-३८", "content_sanskrit": "गिरिवरमभितो विवर्तमानो\nहय इव मण्डलमाशु यः करोति।\nतमिह शरणमभ्युपैहि देवि\nदिवसकरं प्रभवो ह्ययं प्रजानाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000440039, "chapter_id": 9440, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे त्रयस्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]