[
  {
    "id": 16761001,
    "chapter_id": 6161,
    "verse_number": "13.1",
    "content_sanskrit": "श्रीभगवानुवाच —",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "base_unit_id": "BG_C13_V01"
  },
  {
    "id": 16761002,
    "chapter_id": 6161,
    "verse_number": "13.2",
    "content_sanskrit": "क्षेत्रज्ञं चापि मां विद्धि सर्वक्षेत्रेषु भारत ।\nक्षेत्रक्षेत्रज्ञयोर्ज्ञानं यत्तज्ज्ञानं मतं मम ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "base_unit_id": "BG_C13_V02"
  },
  {
    "id": 16761003,
    "chapter_id": 6161,
    "verse_number": "13.3",
    "content_sanskrit": "तत्क्षेत्रं यच्च यादृक्च यद्विकारि यतश्च यत् ।\nस च यो यत्प्रभावश्च तत्समासेन मे शृणु ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "base_unit_id": "BG_C13_V03"
  },
  {
    "id": 16761004,
    "chapter_id": 6161,
    "verse_number": "13.4",
    "content_sanskrit": "ऋषिभिर्बहुधा गीतं छन्दोभिर्विविधैः पृथक् ।\nब्रह्मसूत्रपदैश्चैव हेतुमद्भिर्विनिश्चितैः ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "base_unit_id": "BG_C13_V04"
  },
  {
    "id": 16761005,
    "chapter_id": 6161,
    "verse_number": "13.5",
    "content_sanskrit": "महाभूतान्यहङ्कारो बुद्धिरव्यक्तमेव च ।\nइन्द्रियाणि दशैकं च पञ्च चेन्द्रियगोचराः ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "base_unit_id": "BG_C13_V05"
  },
  {
    "id": 16761006,
    "chapter_id": 6161,
    "verse_number": "13.6",
    "content_sanskrit": "इच्छा द्वेषः सुखं दुःखं सङ्घातश्चेतना धृतिः ।\nएतत्क्षेत्रं समासेन सविकारमुदाहृतम् ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "base_unit_id": "BG_C13_V06"
  },
  {
    "id": 16761007,
    "chapter_id": 6161,
    "verse_number": "13.7",
    "content_sanskrit": "अमानित्वमदम्भित्वमहिंसा क्षान्तिरार्जवम् ।\nआचार्योपासनं शौचं स्थैर्यमात्मविनिग्रहः ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "base_unit_id": "BG_C13_V07"
  },
  {
    "id": 16761008,
    "chapter_id": 6161,
    "verse_number": "13.8",
    "content_sanskrit": "इन्द्रियार्थेषु वैराग्यमनहङ्कार एव च ।\nजन्ममृत्युजराव्याधिदुःखदोषानुदर्शनम् ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "base_unit_id": "BG_C13_V08"
  },
  {
    "id": 16761009,
    "chapter_id": 6161,
    "verse_number": "13.9",
    "content_sanskrit": "असक्तिरनभिष्वङ्गः पुत्रदारगृहादिषु ।\nनित्यं च समचित्तत्वमिष्टानिष्टोपपत्तिषु ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "base_unit_id": "BG_C13_V09"
  },
  {
    "id": 16761010,
    "chapter_id": 6161,
    "verse_number": "13.10",
    "content_sanskrit": "मयि चानन्ययोगेन भक्तिरव्यभिचारिणी ।\nविविक्तदेशसेवित्वमरतिर्जनसंसदि ॥ १० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "base_unit_id": "BG_C13_V10"
  },
  {
    "id": 16761011,
    "chapter_id": 6161,
    "verse_number": "13.11",
    "content_sanskrit": "अध्यात्मज्ञाननित्यत्वं तत्त्वज्ञानार्थदर्शनम् ।\nएतज्ज्ञानमिति प्रोक्तमज्ञानं यदतोऽन्यथा ॥ ११ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "base_unit_id": "BG_C13_V11"
  },
  {
    "id": 16761012,
    "chapter_id": 6161,
    "verse_number": "13.12",
    "content_sanskrit": "ज्ञेयं यत्तत्प्रवक्ष्यामि यज्ज्ञात्वामृतमश्नुते ।\nअनादिमत्परं ब्रह्म न सत्तन्नासदुच्यते ॥ १२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "base_unit_id": "BG_C13_V12"
  },
  {
    "id": 16761013,
    "chapter_id": 6161,
    "verse_number": "13.13",
    "content_sanskrit": "सर्वतःपाणिपादं तत्सर्वतोक्षिशिरोमुखम् ।\nसर्वतःश्रुतिमल्लोके सर्वमावृत्य तिष्ठति ॥ १३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "base_unit_id": "BG_C13_V13"
  },
  {
    "id": 16761014,
    "chapter_id": 6161,
    "verse_number": "13.14",
    "content_sanskrit": "सर्वेन्द्रियगुणाभासं सर्वेन्द्रियविवर्जितम् ।\nअसक्तं सर्वभृच्चैव निर्गुणं गुणभोक्तृ च ॥ १४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "base_unit_id": "BG_C13_V14"
  },
  {
    "id": 16761015,
    "chapter_id": 6161,
    "verse_number": "13.15",
    "content_sanskrit": "बहिरन्तश्च भूतानामचरं चरमेव च ।\nसूक्ष्मत्वात्तदविज्ञेयं दूरस्थं चान्तिके च तत् ॥ १५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "base_unit_id": "BG_C13_V15"
  },
  {
    "id": 16761016,
    "chapter_id": 6161,
    "verse_number": "13.16",
    "content_sanskrit": "अविभक्तं च भूतेषु विभक्तमिव च स्थितम् ।\nभूतभर्तृ च तज्ज्ञेयं ग्रसिष्णु प्रभविष्णु च ॥ १६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "base_unit_id": "BG_C13_V16"
  },
  {
    "id": 16761017,
    "chapter_id": 6161,
    "verse_number": "13.17",
    "content_sanskrit": "ज्योतिषामपि तज्ज्योतिस्तमसः परमुच्यते ।\nज्ञानं ज्ञेयं ज्ञानगम्यं हृदि सर्वस्य विष्ठितम् ॥ १७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "base_unit_id": "BG_C13_V17"
  },
  {
    "id": 16761018,
    "chapter_id": 6161,
    "verse_number": "13.18",
    "content_sanskrit": "इति क्षेत्रं तथा ज्ञानं ज्ञेयं चोक्तं समासतः ।\nमद्भक्त एतद्विज्ञाय मद्भावायोपपद्यते ॥ १८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "base_unit_id": "BG_C13_V18"
  },
  {
    "id": 16761019,
    "chapter_id": 6161,
    "verse_number": "13.19",
    "content_sanskrit": "प्रकृतिं पुरुषं चैव विद्ध्यनादी उभावपि ।\nविकारांश्च गुणांश्चैव विद्धि प्रकृतिसम्भवान् ॥ १९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "base_unit_id": "BG_C13_V19"
  },
  {
    "id": 16761020,
    "chapter_id": 6161,
    "verse_number": "13.20",
    "content_sanskrit": "कार्यकरणकर्तृत्वे हेतुः प्रकृतिरुच्यते ।\nपुरुषः सुखदुःखानां भोक्तृत्वे हेतुरुच्यते ॥ २० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "base_unit_id": "BG_C13_V20"
  },
  {
    "id": 16761021,
    "chapter_id": 6161,
    "verse_number": "13.21",
    "content_sanskrit": "पुरुषः प्रकृतिस्थो हि भुङ्क्ते प्रकृतिजान्गुणान् ।\nकारणं गुणसङ्गोऽस्य सदसद्योनिजन्मसु ॥ २१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "base_unit_id": "BG_C13_V21"
  },
  {
    "id": 16761022,
    "chapter_id": 6161,
    "verse_number": "13.22",
    "content_sanskrit": "उपद्रष्टानुमन्ता च भर्ता भोक्ता महेश्वरः ।\nपरमात्मेति चाप्युक्तो देहेऽस्मिन्पुरुषः परः ॥ २२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "base_unit_id": "BG_C13_V22"
  },
  {
    "id": 16761023,
    "chapter_id": 6161,
    "verse_number": "13.23",
    "content_sanskrit": "य एवं वेत्ति पुरुषं प्रकृतिं च गुणैः सह ।\nसर्वथा वर्तमानोऽपि न स भूयोऽभिजायते ॥ २३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "base_unit_id": "BG_C13_V23"
  },
  {
    "id": 16761024,
    "chapter_id": 6161,
    "verse_number": "13.24",
    "content_sanskrit": "ध्यानेनात्मनि पश्यन्ति केचिदात्मानमात्मना ।\nअन्ये साङ्ख्येन योगेन कर्मयोगेन चापरे ॥ २४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "base_unit_id": "BG_C13_V24"
  },
  {
    "id": 16761025,
    "chapter_id": 6161,
    "verse_number": "13.25",
    "content_sanskrit": "अन्ये त्वेवमजानन्तः श्रुत्वान्येभ्य उपासते ।\nतेऽपि चातितरन्त्येव मृत्युं श्रुतिपरायणाः ॥ २५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "base_unit_id": "BG_C13_V25"
  },
  {
    "id": 16761026,
    "chapter_id": 6161,
    "verse_number": "13.26",
    "content_sanskrit": "यावत्सञ्जायते किञ्चित्सत्त्वं स्थावरजङ्गमम् ।\nक्षेत्रक्षेत्रज्ञसंयोगात्तद्विद्धि भरतर्षभ ॥ २६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "base_unit_id": "BG_C13_V26"
  },
  {
    "id": 16761027,
    "chapter_id": 6161,
    "verse_number": "13.27",
    "content_sanskrit": "समं सर्वेषु भूतेषु तिष्ठन्तं परमेश्वरम् ।\nविनश्यत्स्वविनश्यन्तं यः पश्यति स पश्यति ॥ २७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "base_unit_id": "BG_C13_V27"
  },
  {
    "id": 16761028,
    "chapter_id": 6161,
    "verse_number": "13.28",
    "content_sanskrit": "समं पश्यन्हि सर्वत्र\nसमवस्थितमीश्वरम् ।\nन हिनस्त्यात्मनात्मानं\nततो याति परां गतिम् ॥ २८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "base_unit_id": "BG_C13_V28"
  },
  {
    "id": 16761029,
    "chapter_id": 6161,
    "verse_number": "13.29",
    "content_sanskrit": "प्रकृत्यैव च कर्माणि क्रियमाणानि सर्वशः ।\nयः पश्यति तथात्मानमकर्तारं स पश्यति ॥ २९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "base_unit_id": "BG_C13_V29"
  },
  {
    "id": 16761030,
    "chapter_id": 6161,
    "verse_number": "13.30",
    "content_sanskrit": "यदा भूतपृथग्भावमेकस्थमनुपश्यति ।\nतत एव च विस्तारं ब्रह्म सम्पद्यते तदा ॥ ३० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "base_unit_id": "BG_C13_V30"
  },
  {
    "id": 16761031,
    "chapter_id": 6161,
    "verse_number": "13.31",
    "content_sanskrit": "अनादित्वान्निर्गुणत्वात्परमात्मायमव्ययः ।\nशरीरस्थोऽपि कौन्तेय न करोति न लिप्यते ॥ ३१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "base_unit_id": "BG_C13_V31"
  },
  {
    "id": 16761032,
    "chapter_id": 6161,
    "verse_number": "13.32",
    "content_sanskrit": "यथा सर्वगतं सौक्ष्म्यादाकाशं नोपलिप्यते ।\nसर्वत्रावस्थितो देहे तथात्मा नोपलिप्यते ॥ ३२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "base_unit_id": "BG_C13_V32"
  },
  {
    "id": 16761033,
    "chapter_id": 6161,
    "verse_number": "13.33",
    "content_sanskrit": "यथा प्रकाशयत्येकः कृत्स्नं लोकमिमं रविः ।\nक्षेत्रं क्षेत्री तथा कृत्स्नं प्रकाशयति भारत ॥ ३३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "base_unit_id": "BG_C13_V33"
  },
  {
    "id": 16761034,
    "chapter_id": 6161,
    "verse_number": "13.34",
    "content_sanskrit": "क्षेत्रक्षेत्रज्ञयोरेवमन्तरं ज्ञानचक्षुषा ।\nभूतप्रकृतिमोक्षं च ये विदुर्यान्ति ते परम् ॥ ३४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "base_unit_id": "BG_C13_V34"
  }
]