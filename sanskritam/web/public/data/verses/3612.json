[{"id": 2121819, "chapter_id": 3612, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2121820, "chapter_id": 3612, "verse_number": "१", "content_sanskrit": "ततः सर्वदशार्हाणमाहुकस्य च याः स्त्रियः ।\nनन्दगोपस्य महिषी यशोदा लोकविश्रुता ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2121821, "chapter_id": 3612, "verse_number": "२", "content_sanskrit": "रेवती च महाभागा रुग्मिणी च पतिव्रता ।\nसत्या जाम्बवती चोभे गान्धारी शिशुमाऽपि या ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2121822, "chapter_id": 3612, "verse_number": "३", "content_sanskrit": "विशोका लक्षणा चापि सुमित्रा केतुमा तथा ।\nवासुदेवमहिष्योऽन्याः श्रिया सार्धं ययुस्तदा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2121823, "chapter_id": 3612, "verse_number": "४", "content_sanskrit": "विभूतिं द्रष्टुमनसः केशवस्य महात्मनः ।\nप्रीयमाणाः सभां जग्मुरालोकयितुमच्युतम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2121824, "chapter_id": 3612, "verse_number": "५", "content_sanskrit": "देवकी सप्तदेवीनां रोहिणी च पुरस्कृता ।\nददृशुर्देवमासीनं कृष्णं हलभृता सह ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2121825, "chapter_id": 3612, "verse_number": "६", "content_sanskrit": "तौ तु पूर्वमतिक्रम्य रोहिणीमभिवाद्य च ।\nअभिवादयतां देवौ देवकीं रामकेशवौ ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2121826, "chapter_id": 3612, "verse_number": "७", "content_sanskrit": "रोहिणीं सप्तदेवीनां यथाश्रेष्ठं च मातरः ।\nववन्दे सह रामेण भगवान् वासवानुजः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2121827, "chapter_id": 3612, "verse_number": "८", "content_sanskrit": "अथासनवरं प्राप्य वृष्णिदारपुरस्कृता ।\nउभावङ्कगतौ चक्रे देवकी रामकेशवौ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2121828, "chapter_id": 3612, "verse_number": "९", "content_sanskrit": "सा ताभ्यामृषभाक्षाभ्यां पुत्राभ्यां शुशुभेऽधिकम् ।\nदेवकी देवमातेव मित्रेण वरुणेन च ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2121829, "chapter_id": 3612, "verse_number": "१०", "content_sanskrit": "ततः प्राप्ता यशोदाया दुहिता वै क्षणेन हि ।\nजाज्वल्यमाना वपुषा प्रभयाऽतीव भारत ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2121830, "chapter_id": 3612, "verse_number": "११", "content_sanskrit": "एकानङ्गेति यामाहुः कन्यां तां कामरूपिणीम् ।\nयत्कृते सगणं कंसं जघान पुरुषोत्तमः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2121831, "chapter_id": 3612, "verse_number": "१२", "content_sanskrit": "ततः स भगवान् रामस्तामुपाक्रम्य भामिनीम् ।\nमूर्ध्न्युपाघ्राय सव्येन परिजग्राह पाणिना ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2121832, "chapter_id": 3612, "verse_number": "१३", "content_sanskrit": "तां च तत्रोपचङ्क्रम्य प्रियामिव सखीं समाम् ।\nदक्षिणेन कराग्रेण परिजग्राह माधवः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2121833, "chapter_id": 3612, "verse_number": "१४", "content_sanskrit": "ददृशुस्तां सभामध्ये भगिनीं रामकृष्णयोः ।\nरुग्मपद्मशयां पद्मां श्रीमिवोत्तमनागयोः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2121834, "chapter_id": 3612, "verse_number": "१५", "content_sanskrit": "अथाक्षतमहावृष्ट्या लाजपुष्पघृतैरपि ।\nवृष्णयोऽवाकिरन् प्रीताः सङ्कर्षणजनार्दनौ ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2121835, "chapter_id": 3612, "verse_number": "१६", "content_sanskrit": "सबालाः सहवृद्धाश्च ये ज्ञातिकुलबान्धवाः ।\nउपोपविविशुः प्रीता वृष्णयो मधुसूदनम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2121836, "chapter_id": 3612, "verse_number": "१७", "content_sanskrit": "पूज्यमानो महाबाहुः पौराणां रतिवर्धनः ।\nविवेश पुरुषव्याघ्रः स्ववेश्म मधुसूदनः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2121837, "chapter_id": 3612, "verse_number": "१८", "content_sanskrit": "रुग्मिण्या सहितो देव्या प्रमुमोद सुखी सुखम् ।\nअनन्तरं च सत्याया जाम्बवत्याश्च भारत ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2121838, "chapter_id": 3612, "verse_number": "१९", "content_sanskrit": "सर्वासां च यदुश्रेष्ठः सर्वकालविहारवान् ।\nजगाम च हृषीकेशो रुग्मिण्या स निवेशनम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2121839, "chapter_id": 3612, "verse_number": "२०", "content_sanskrit": "एष तात महाबाहो विजयः शार्ङ्गधन्वनः ।\nएतदर्थं च जन्माहुर्मानुषेषु महात्मनः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2121840, "chapter_id": 3612, "verse_number": "२३", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि चतुःपञ्चाशोऽध्यायः ॥५४॥\n॥ अर्घाभिहरणपर्वणि त्रयोविंशोऽध्यायः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]