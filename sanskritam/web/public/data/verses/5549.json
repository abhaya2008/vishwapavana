[{"id": 2213154, "chapter_id": 5549, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2213155, "chapter_id": 5549, "verse_number": "१", "content_sanskrit": "ततस्तस्मिन् मुनिश्रेष्ठा राजानं द्रष्टुमभ्ययुः ।\nनारदः पर्वतश्चैव देवलश्च महातपाः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2213156, "chapter_id": 5549, "verse_number": "२", "content_sanskrit": "द्वैपायनः सशिष्यश्च सिद्धाश्चान्ये महर्षयः ।\nशतयूपश्च राजर्षिर्वृद्धः परमधार्मिकः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2213157, "chapter_id": 5549, "verse_number": "३", "content_sanskrit": "तेषां कुन्ती महाराज पूजां चक्रे यथाविधि ।\nतस्यास्ते तुष्टुवुः सर्वे तापसाः परिचर्यया\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2213158, "chapter_id": 5549, "verse_number": "४", "content_sanskrit": "तत्र धर्म्याः कथास्तात चक्रुस्ते परमर्षयः ।\nरमयन्तो महात्मानं धृतराष्ट्रं जनाधिपम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2213159, "chapter_id": 5549, "verse_number": "५", "content_sanskrit": "कथान्तरे तु कस्मिंश्चिद् देवर्षिर्नारदस्तदा ।\nकथामिमामकथयत् सर्वप्रत्यक्षदर्शिवान्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2213160, "chapter_id": 5549, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2213161, "chapter_id": 5549, "verse_number": "६", "content_sanskrit": "पुरा प्रजापतिसमो राजाऽऽसीदकुतोभयः ।\nसहस्रचित्य इत्युक्तः शतयूपपितामहः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2213162, "chapter_id": 5549, "verse_number": "७", "content_sanskrit": "स पुत्रे राज्यमासज्ज्य ज्येष्ठे परमधार्मिके ।\nवनं विवेश धर्मात्मा शतचित्यो महीपतिः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2213163, "chapter_id": 5549, "verse_number": "८", "content_sanskrit": "स गत्वा तपसः पारं दीप्तः स पृथिवीपतिः ।\nपुरन्दरस्य संस्थानं प्रतिपेदे महामनाः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2213164, "chapter_id": 5549, "verse_number": "९", "content_sanskrit": "दृष्टपूर्वः स बहुशो राजा सम्पतता मया ।\nमहेन्द्रसदने राजा तपसा दग्धकिल्बिषः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2213165, "chapter_id": 5549, "verse_number": "१०", "content_sanskrit": "तथा शैलालयो राजा भगदत्तपितामहः ।\nतपोबलेनैव नृपो महेन्द्रसदनं गतः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2213166, "chapter_id": 5549, "verse_number": "११", "content_sanskrit": "तथा पृषध्रो नामासीद् राजा वज्रधरोपमः ।\nस चापि तपसा लेभे नाकपृष्ठमितो गतः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2213167, "chapter_id": 5549, "verse_number": "१२", "content_sanskrit": "अस्मिन्नरण्ये नृपतिः मान्धातुरनघात्मजः ।\nपुरुकुत्सस्तपः सिद्धिं महतीं समवाप्तवान्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2213168, "chapter_id": 5549, "verse_number": "१३", "content_sanskrit": "भार्या समभवद्यस्य नर्मदा सरितां वरा ।\nसोऽस्मिन्नरण्ये नृपतिस्तपस्तप्त्वा दिवं गतः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2213169, "chapter_id": 5549, "verse_number": "१४", "content_sanskrit": "शशलोमा च राजाऽऽसीद् राजन् परमधार्मिकः ।\nस चाप्यस्मिन् वने तप्त्वा ततो दिवमवाप्तवान्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2213170, "chapter_id": 5549, "verse_number": "१५", "content_sanskrit": "द्वैपायनप्रसादाच्च त्वमपीदं तपोवनम् ।\nराजन्नवाप्य दुष्प्रापां सिद्धिमग्र्यां गमिष्यसि\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2213171, "chapter_id": 5549, "verse_number": "१६", "content_sanskrit": "त्वं चापि राजेन्द्र तथा तपसोऽन्ते श्रिया वृतः ।\nगान्धारीसहितो गन्ता गतिं तेषां महात्मनाम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2213172, "chapter_id": 5549, "verse_number": "१७", "content_sanskrit": "पाण्डुः स्मरति नित्यं च बलहन्तुः समीपतः ।\nत्वां सदैव महीपालः स त्वा श्रेयसि योक्ष्यते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2213173, "chapter_id": 5549, "verse_number": "१८", "content_sanskrit": "तव शुश्रूषया चैव गान्धार्याश्च यशस्विनी ।\nभर्तुः सलोकतां कुन्ती गमिष्यति वधूस्तव\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2213174, "chapter_id": 5549, "verse_number": "१९", "content_sanskrit": "युधिष्ठिरस्य जननी स हि धर्मः सनातनः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2213175, "chapter_id": 5549, "verse_number": "२०", "content_sanskrit": "वयमेवं प्रपश्यामो नृपते दिव्यचक्षुषा\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2213176, "chapter_id": 5549, "verse_number": "२१", "content_sanskrit": "प्रवेक्ष्यति स्वमात्मानं विदुरस्तु युधिष्ठिरम् ।\nसञ्जयस्तदनुध्यानात् पूतः स्वर्गमवाप्स्यति\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2213177, "chapter_id": 5549, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2213178, "chapter_id": 5549, "verse_number": "२२", "content_sanskrit": "एतच्छ्रुत्वा कौरवेन्द्रो महात्मा\nसहैव पत्न्या प्रीतिमान् प्रत्यगृह्णात् ।\nविद्वान् वाक्यं नारदस्य प्रशस्य\nचक्रे पूजां चातुलां नारदाय\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2213179, "chapter_id": 5549, "verse_number": "२३", "content_sanskrit": "तदा सर्वे नारदं विप्रसङ्घाः\nसम्पूजयामासुरतीव राजन् ।\nराज्ञः प्रीता धृतराष्ट्रस्य ते वै\nपुनः पुनः सम्प्रहृष्टास्तदानीम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2213180, "chapter_id": 5549, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nआश्रमवासिकपर्वणि नारदवचनं नाम पञ्चविंशोऽध्यायः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2213181, "chapter_id": 5549, "verse_number": "", "content_sanskrit": "आश्रमवासपर्वणि पञ्चविंशोऽध्यायः ॥२५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]