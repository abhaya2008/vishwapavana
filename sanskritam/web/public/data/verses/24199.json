[{"id": 7004199000, "chapter_id": 24199, "verse_number": "५-१-४८-१", "content_sanskrit": "सनत्कुमार उवाच ।\nशृणुष्वावहितो व्यास स्थितिमेकाग्रमानसः ।\nमया व्यासमुखात्प्राप्ता कल्पभेदे कथा शुभा॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004199001, "chapter_id": 24199, "verse_number": "५-१-४८-२", "content_sanskrit": "गुह्याद्गुह्यतरा श्रेष्ठा न देया यस्य कस्यचित् ।\nनास्तिकाय कृतघ्नाय नाशिष्याय कदाचन॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004199002, "chapter_id": 24199, "verse_number": "५-१-४८-३", "content_sanskrit": "एषा पुण्यतमा व्यास कथा पापहरा परा ।\nयस्याः श्रवणमात्रेण कल्पदोषो न बाधते॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004199003, "chapter_id": 24199, "verse_number": "५-१-४८-४", "content_sanskrit": "प्रमाणं कल्पपर्यंतं ब्रह्मणः परमेष्ठिनः ।\nमन्वंतरेषु सर्वेषु कल्पकल्पांतरेषु च॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004199004, "chapter_id": 24199, "verse_number": "५-१-४८-५", "content_sanskrit": "यावत्संख्या परिमिता तावती शृणु सत्तम ।\nअहोरात्रं च भजते सूर्यो मानुषदैवतम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004199005, "chapter_id": 24199, "verse_number": "५-१-४८-६", "content_sanskrit": "तामुपादाय गणनां शृणु संख्या द्विजोत्तम ।\nनिमेषैः पंचदशभिः काष्ठा त्रिंशत्तु ताः कला॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004199006, "chapter_id": 24199, "verse_number": "५-१-४८-७", "content_sanskrit": "त्रिंशत्कला मुहूर्तस्तु त्रिंशता तैर्मनीषिणः ।\nअहोरात्र मिति प्राहुश्चंद्रादित्यगतिस्तदा॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004199007, "chapter_id": 24199, "verse_number": "५-१-४८-८", "content_sanskrit": "रविर्गतिविशेषेण सन्ध्यायां याति नित्यशः ।\nतदहस्तु मनुष्याणां रात्रिश्चैव तु तादृशी॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004199008, "chapter_id": 24199, "verse_number": "५-१-४८-९", "content_sanskrit": "पक्षौ मासा ऋतुश्चाब्दमयने च प्रकीर्तिते ।\nपितॄणां चैव देवानां ब्रह्मणश्च यथातथम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004199009, "chapter_id": 24199, "verse_number": "५-१-४८-१०", "content_sanskrit": "यावत्संख्या समाख्याता आयुरंतश्च तादृशः ।\nअहोरात्राः पंचदश पक्ष इत्यभिशब्दितः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004199010, "chapter_id": 24199, "verse_number": "५-१-४८-११", "content_sanskrit": "पक्षौ द्वौ तौ कृतौ मासौ मासौ द्वावृतुरुच्यते ।\nअयनं चर्तुभिस्त्रिभिरब्दं द्वे अयने स्मृतम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004199011, "chapter_id": 24199, "verse_number": "५-१-४८-१२", "content_sanskrit": "दक्षिणं चोत्तरं चैव संख्यातत्त्वविशारदैः ।\nमानेनानेन यो मासः पक्षद्वयसमन्वितः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004199012, "chapter_id": 24199, "verse_number": "५-१-४८-१३", "content_sanskrit": "पितॄणां तदहोरात्रमिति कालविदो विदुः ।\nशुक्ल पक्षस्त्वहस्तेषां कृष्णपक्षस्तु शर्वरी॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004199013, "chapter_id": 24199, "verse_number": "५-१-४८-१४", "content_sanskrit": "कृष्णपक्षे त्विह श्राद्धं पितॄणां वर्तते द्विज ।\nमानुषेण तु मानेन यो वै संवत्सरः स्मृतः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004199014, "chapter_id": 24199, "verse_number": "५-१-४८-१५", "content_sanskrit": "देवानां तदहोरात्रं दिवा चैवोत्तरायणम् ।\nदक्षिणायनं स्मृता रात्रिः प्राज्ञैस्तत्त्वार्थकोविदैः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004199015, "chapter_id": 24199, "verse_number": "५-१-४८-१६", "content_sanskrit": "दिव्यमब्दं शतगुणं दिव्यमब्दसहस्रकम् ।\nमुनिभिश्चैव तत्त्वज्ञैरहोरात्रं मनोः स्मृतम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004199016, "chapter_id": 24199, "verse_number": "५-१-४८-१७", "content_sanskrit": "अहोरात्रं दशगुणं मानवः पक्ष उच्यते ।\nपक्षाद्दशगुणो मासो मासा द्वादशभिर्गुणैः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004199017, "chapter_id": 24199, "verse_number": "५-१-४८-१८", "content_sanskrit": "ऋतुर्मनूनां संप्रोक्तः प्राज्ञैस्तत्त्वार्थदर्शिभिः ।\nषड्भिस्तैर्वर्षं संप्रोक्तं तेन संख्या निबध्यते॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004199018, "chapter_id": 24199, "verse_number": "५-१-४८-१९", "content_sanskrit": "चत्वार्येव सहस्राणि वर्षाणां तु कृतं युगम् ।\nतावती तु भवेत्संध्या संध्यांशश्च तथाविधः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004199019, "chapter_id": 24199, "verse_number": "५-१-४८-२०", "content_sanskrit": "त्रीणि वर्षसहस्राणि त्रेता तत्परिमाणतः ।\nतस्याश्च त्रिशती संध्या संध्यांशश्च तथा परः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004199020, "chapter_id": 24199, "verse_number": "५-१-४८-२१", "content_sanskrit": "तथा वर्षसहस्रे द्वे द्वापरं परिकीर्तितम् ।\nतस्य च द्विशती संध्या संध्यांशश्च तथा ।\nपरः ॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004199021, "chapter_id": 24199, "verse_number": "५-१-४८-२२", "content_sanskrit": "कलिर्वर्षसहस्रं तु संख्या चोक्ता मनीषिभिः ।\nतस्य चैकशती संध्या संध्यांशश्च तथाविधः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004199022, "chapter_id": 24199, "verse_number": "५-१-४८-२३", "content_sanskrit": "एषा द्वादशसाहस्री युगसंख्या प्रकीर्तिता ।\nदिव्येनानेन मानेन युगसंख्यां निबोध मे॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004199023, "chapter_id": 24199, "verse_number": "५-१-४८-२४", "content_sanskrit": "ससर्ज स पुनस्तात जगत्सर्वमिदं ततः ।\nकृतं त्रेता द्वापरं च कलिश्चैव चतुर्युगम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004199024, "chapter_id": 24199, "verse_number": "५-१-४८-२५", "content_sanskrit": "युगं तदेकसप्तत्या गुणितं द्विजसत्तम ।\nमन्वंतरमिति प्रोक्तं संख्यानार्थविशारदैः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004199025, "chapter_id": 24199, "verse_number": "५-१-४८-२६", "content_sanskrit": "अयनं चापि तत्प्रोक्तं द्वेऽयने दक्षिणोत्तरे ।\nमनुः प्रलीयते ह्यत्र संप्राप्ते जगतः प्रभौ॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004199026, "chapter_id": 24199, "verse_number": "५-१-४८-२७", "content_sanskrit": "ततोऽपरो मनुः कालमेतावन्तं भवेत्पुनः ।\nसमतीते तु राजेंद्र प्रोक्तः संवत्सरस्य वै॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004199027, "chapter_id": 24199, "verse_number": "५-१-४८-२८", "content_sanskrit": "तदैव चायनं प्रोक्तं मुनिना तत्त्वदर्शिना ।\nब्रह्मणस्तदहः प्रोक्तं कल्प श्चेति स उच्यते॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004199028, "chapter_id": 24199, "verse_number": "५-१-४८-२९", "content_sanskrit": "सहस्रयुगपर्यंतं सा निशा प्रोच्यते बुधैः ।\nनिमज्जत्यत्र चोर्वी सा सशैलवनकानना॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004199029, "chapter_id": 24199, "verse_number": "५-१-४८-३०", "content_sanskrit": "तस्मिन्युगसहस्रे तु पूर्णे वै द्विजसत्तम ।\nब्राह्मे दिवसपर्यंते कल्पो निःशेष उच्यते॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004199030, "chapter_id": 24199, "verse_number": "५-१-४८-३१", "content_sanskrit": "युगानि सप्ततिं तानि साग्राणि कथितानि ते ।\nकृतत्रेतादियुक्तानि मनोरंतर मुच्यते॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004199031, "chapter_id": 24199, "verse_number": "५-१-४८-३२", "content_sanskrit": "चतुर्दशैते मनवः कथिताः कीर्तिवर्धनाः ।\nवेदेषु सपुराणेषु सर्वेषु प्रभविष्णवः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004199032, "chapter_id": 24199, "verse_number": "५-१-४८-३३", "content_sanskrit": "प्रजानां पतयो व्यास धन्यमेषां प्रकीर्त नम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004199033, "chapter_id": 24199, "verse_number": "५-१-४८-३४", "content_sanskrit": "मन्वंतरेषु संहाराः संहारांतेषु संभवाः ।\nन शक्यमंतस्तेषां वै वक्तुं वर्षशतैरपि॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004199034, "chapter_id": 24199, "verse_number": "५-१-४८-३५", "content_sanskrit": "विसर्गश्च प्रजानां वै संहारस्य च भारत॥  ।\nमन्वंतरेषु संहारः श्रूयते भरतर्षभ॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004199035, "chapter_id": 24199, "verse_number": "५-१-४८-३६", "content_sanskrit": "यत्र तिष्ठंति वै देवाः सर्वे सप्तर्षिभिः सह ।\nतपसा ब्रह्मचर्येण श्रुतेन च समन्विताः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004199036, "chapter_id": 24199, "verse_number": "५-१-४८-३७", "content_sanskrit": "पूर्णे युगसहस्रे तु कल्पो निःशेष उच्यते ।\nतत्र सर्वाणि भूतानि दग्धान्यादित्यरश्मिभिः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004199037, "chapter_id": 24199, "verse_number": "५-१-४८-३८", "content_sanskrit": "ब्रह्माणमग्रतः कृत्वा सहादित्यैर्गणैर्द्विज ।\nप्रविशंति सुरश्रेष्ठं हरिं नारायणं प्रभुम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004199038, "chapter_id": 24199, "verse_number": "५-१-४८-३९", "content_sanskrit": "स स्रष्टा सर्वभूतानां कल्पांते तु पुनःपुनः ।\nअव्यक्तः शाश्वतो देवस्तस्य सर्वमिदं जगत्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004199039, "chapter_id": 24199, "verse_number": "५-१-४८-४०", "content_sanskrit": "स एव विद्यते व्यास महेशा सह संयुतः ।\nमहाकालवने वासं चकार जगदीश्वरः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004199040, "chapter_id": 24199, "verse_number": "५-१-४८-४१", "content_sanskrit": "प्रलयो न बाधते व्यास महाकालवनोत्तमे ।\nकल्पे कल्पे च वै रम्या पुरी ह्येषा कुशस्थली॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004199041, "chapter_id": 24199, "verse_number": "५-१-४८-४२", "content_sanskrit": "निरामया निरातंका निर्विकारा युगेयुगे ।\nमार्कण्डेयोपदिष्टानि कल्पानि संभवंति च॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004199042, "chapter_id": 24199, "verse_number": "५-१-४८-४३", "content_sanskrit": "अत्रैव च वने रम्ये ब्रह्मा लोकपितामहः ।\nप्रजानां पतयो ये ते दक्षः प्राचेतसस्तथा॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004199043, "chapter_id": 24199, "verse_number": "५-१-४८-४४", "content_sanskrit": "मरीचिः कश्यपो रुद्रो येऽन्ये भृग्वादयस्तथा ।\nकल्पादौ ससृजे लोकांश्चराचरान्यथा तथा॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004199044, "chapter_id": 24199, "verse_number": "५-१-४८-४५", "content_sanskrit": "एवमादौ पुरा व्यास कल्पं कल्पायते तदा ।\nवाराहवामनविष्णुपितॄणां वै तथैव च॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004199045, "chapter_id": 24199, "verse_number": "५-१-४८-४६", "content_sanskrit": "कल्पभेदाः समाख्याता महाकालवने शुभे ।\nचतुराशीतिकल्पानि संजातानि द्विजोत्तम॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004199046, "chapter_id": 24199, "verse_number": "५-१-४८-४७", "content_sanskrit": "तावंति योगलिंगानि वने तिष्ठन्ति सत्तम ।\nपुनर्जाता पुनः र्नष्टा महीसागरपर्वताः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004199047, "chapter_id": 24199, "verse_number": "५-१-४८-४८", "content_sanskrit": "पुनःपुनर्भविष्यंति पुरी ह्येषाऽचला स्मृता ।\nतस्मात्सर्वेषु कालेषु सर्वलोकेषु गीयते॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004199048, "chapter_id": 24199, "verse_number": "५-१-४८-४९", "content_sanskrit": "प्रतिकल्पेति विख्याता भुवि व्यास भविष्यति ।\nयेऽस्यां वै मानवा दांताः स्नानदानादिकं तथा॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004199049, "chapter_id": 24199, "verse_number": "५-१-४८-५०", "content_sanskrit": "जपं होमं तथा श्राद्धं पितॄनुद्दिश्य देवताः ।\nन तेषां पुनरा वृत्तिः कोटिकल्पशतैरपि॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004199050, "chapter_id": 24199, "verse_number": "५-१-४८-५१", "content_sanskrit": "प्रतिकल्पामनुप्राप्य दृष्ट्वा देवं महेश्वरम् ।\nवैशाखे पौर्णमास्यां वै स्नापयंत्येकवासरम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004199051, "chapter_id": 24199, "verse_number": "५-१-४८-५२", "content_sanskrit": "प्रसंगतो रजः क्लांतः शिप्रांभसि च मानवाः ।\nन तेषां दुष्कृतं किंचिद्विष्णुलोके वसंति ते॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004199052, "chapter_id": 24199, "verse_number": "५-१-४८-५३", "content_sanskrit": "मन्वंतरसहस्रेषु काशिवासेषु यत्फलम् ।\nतत्फलं प्राप्नुयाज्जंतुः प्रतिकल्पं क्षणादपि॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004199053, "chapter_id": 24199, "verse_number": "५-१-४८-५४", "content_sanskrit": "प्रतिकल्पे च कल्पांते सैवासीच्च पुरी शुभा ।\nतस्मात्सर्वजनैः ख्याता प्रतिकल्पा द्विजोत्तम॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004199054, "chapter_id": 24199, "verse_number": "५-१-४८-५५", "content_sanskrit": "ये चैतस्य महाभागाः प्रीतिं कुर्वंति मानवाः ।\nन तेषां कल्पभेदोऽयं स्वप्नवज्जायते क्षणात्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004199055, "chapter_id": 24199, "verse_number": "५-१-४८-५६", "content_sanskrit": "यः शृणोति कथां पुण्यां प्रतिकल्पोद्भवां शुभाम् ।\nश्रावयेद्वा प्रयत्नेन ब्रह्महत्यां व्यपोहति॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]