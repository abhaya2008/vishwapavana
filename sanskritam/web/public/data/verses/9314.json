[{"id": 40019467, "chapter_id": 9314, "verse_number": "1", "content_sanskrit": "अनुज्ञातंतुरामेणतद्विमानमनुत्तमम् । हंसयुक्तंमहानादमुत्पपातविहायसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40019468, "chapter_id": 9314, "verse_number": "2", "content_sanskrit": "पातयित्वाततश्चक्षुस्सर्वतोरघुनन्दनः । अब्रवीन्मैथिलींसीतांरामश्शशिनिभाननाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40019469, "chapter_id": 9314, "verse_number": "3", "content_sanskrit": "कैलासशिखराकारेत्रिकूटशिखरेस्थिताम् । लङ्कामीक्षस्ववैदेहीनिर्मितांविश्वकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40019470, "chapter_id": 9314, "verse_number": "4", "content_sanskrit": "एतदायोधनंपश्यमांसशोणितकर्दमम् । हरीणांराक्षसानां च सीते विशसनंमहत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40019471, "chapter_id": 9314, "verse_number": "5", "content_sanskrit": "अत्रदत्तवरश्शेतेप्रमाथीराक्षसेश्वरः । तवहेतोर्विशालाक्षीनिहतोरावणोमया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40019472, "chapter_id": 9314, "verse_number": "6", "content_sanskrit": "कुम्भकर्णोऽऽत्रनिहतःप्रहस्तश्चनिशाचरः । धूम्राक्षश्चात्रनिहतोवानरेणहनूमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40019473, "chapter_id": 9314, "verse_number": "7", "content_sanskrit": "विद्युन्मालीहतश्चात्रसुषेणेनमहात्मना । लक्ष्मणेनेन्द्राजिच्चात्ररावणिर्निहितोरणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40019474, "chapter_id": 9314, "verse_number": "8", "content_sansk