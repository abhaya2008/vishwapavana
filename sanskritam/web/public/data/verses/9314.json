number": "14", "content_sanskrit": "अत्रमन्दोदरीनामभार्यातंपर्यदेवयत् ॥ सपत्नीनांसहस्रेणसाग्रेणपरिवारिता ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40019481, "chapter_id": 9314, "verse_number": "15", "content_sanskrit": "तत्तुदृश्यतेतीर्थंसमुद्रस्यवरानने ॥ यत्रसागरमुत्तीर्यतांरात्रिमुषितावयम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40019482, "chapter_id": 9314, "verse_number": "16", "content_sanskrit": "एषसेतुर्मयाबद्धस्सागरेसलिलार्णवे ॥ तवहेतोर्विशालाक्षिनलसेतुःसुदुष्करः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40019483, "chapter_id": 9314, "verse_number": "17", "content_sanskrit": "पश्यसागरमक्षोभ्यंवैदेहिवरुणालयम् ॥ अपारमभिगर्जन्तंशङ्खशुक्तिसमाकुलम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40019484, "chapter_id": 9314, "verse_number": "18", "content_sanskrit": "हिरण्यनाभंशैलेन्द्रंकाञ्चनंपश्यमैथिलि ॥ विश्रमार्थंहनुमतोभित्त्वासागरमुत्थितम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40019485, "chapter_id": 9314, "verse_number": "19", "content_sanskrit": "एततत्कुक्षौसमुद्रस्यस्कन्धावारनिवेशनम् ॥ अत्रपूर्वंमहादेवःप्रसादमकरोत्प्रभुः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40019486, "chapter_id": 9314, "verse_number": "20", "content_sanskrit": "एतत्तुदृश्यतेतीर्थंसागरस्यमहात्मनः ॥ सेतुबन्दइतिख्यातंत्रैलोक्येन च पूजितम् । एतत्पवित्रंपरमंमहापातकनाशनम् ॥ अत्रराक्षसराजोऽऽयमाजगामविभीषणः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40019487, "chapter_id": 9314, "v