[{"id": 5000314000, "chapter_id": 9314, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे द्विचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000314001, "chapter_id": 9314, "verse_number": "४-४२-१", "content_sanskrit": "अथ प्रस्थाप्य स हरीन् सुग्रीवो दक्षिणां दिशम्।\nअब्रवीन्मेघसंकाशं सुषेणं नाम वानरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000314002, "chapter_id": 9314, "verse_number": "४-४२-२", "content_sanskrit": "तारायाः पितरं राजा श्वशुरं भीमविक्रमम्।\nअब्रवीत् प्राञ्जलिर्वाक्यमभिगम्य प्रणम्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000314003, "chapter_id": 9314, "verse_number": "४-४२-३", "content_sanskrit": "महर्षिपुत्रं मारीचमर्चिष्मन्तं महाकपिम्।\nवृतं कपिवरैः शूरैर्महेन्द्रसदृशद्युतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000314004, "chapter_id": 9314, "verse_number": "४-४२-४", "content_sanskrit": "बुद्धिविक्रमसम्पन्नं वैनतेयसमद्युतिम्।\nमरीचिपुत्रान् मारीचानर्चिर्माल्यान् महाबलान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000314005, "chapter_id": 9314, "verse_number": "४-४२-५", "content_sanskrit": "ऋषिपुत्रांश्च तान् सर्वान् प्रतीचीमादिशद् दिशम्।\nद्वाभ्यां शतसहस्राभ्यां कपीनां कपिसत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000314006, "chapter_id": 9314, "verse_number": "४-४२-६", "content_sanskrit": "सुषेणप्रमुखा यूयं वैदेहीं परिमार्गथ।\nसौराष्ट्रान् सहबाह्लीकांश्चन्द्रचित्रांस्तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000314007, "chapter_id": 9314, "verse_number": "४-४२-७", "content_sanskrit": "स्फीताञ्जनपदान् रम्यान् विपुलानि पुराणि च।\nपुंनागगहनं कुक्षिं बकुलोद्दालकाकुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000314008, "chapter_id": 9314, "verse_number": "४-४२-८", "content_sanskrit": "तथा केतकषण्डांश्च मार्गध्वं हरिपुङ्गवाः।\nप्रत्यक्स्रोतोवहाश्चैव नद्यः शीतजलाः शिवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000314009, "chapter_id": 9314, "verse_number": "४-४२-९", "content_sanskrit": "तापसानामरण्यानि कान्तारगिरयश्च ये।\nतत्र स्थलीर्मरुप्राया अत्युच्चशिशिराः शिलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000314010, "chapter_id": 9314, "verse_number": "४-४२-१०", "content_sanskrit": "गिरिजालावृतां दुर्गां मार्गित्वा पश्चिमां दिशम्।\nततः पश्चिममागम्य समुद्रं द्रष्टुमर्हथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000314011, "chapter_id": 9314, "verse_number": "४-४२-११", "content_sanskrit": "तिमिनक्राकुलजलं गत्वा द्रक्ष्यथ वानराः।\nततः केतकषण्डेषु तमालगहनेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000314012, "chapter_id": 9314, "verse_number": "४-४२-१२", "content_sanskrit": "कपयो विहरिष्यन्ति नारिकेलवनेषु च।\nतत्र सीतां च मार्गध्वं निलयं रावणस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000314013, "chapter_id": 9314, "verse_number": "४-४२-१३", "content_sanskrit": "वेलातलनिविष्टेषु पर्वतेषु वनेषु च।\nमुरवीपत्तनं चैव रम्यं चैव जटापुरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000314014, "chapter_id": 9314, "verse_number": "४-४२-१४", "content_sanskrit": "अवन्तीमङ्गलेपां च तथा चालक्षितं वनम्।\nराष्ट्राणि च विशालानि पत्तनानि ततस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000314015, "chapter_id": 9314, "verse_number": "४-४२-१५", "content_sanskrit": "सिन्धुसागरयोश्चैव संगमे तत्र पर्वतः।\nमहान् सोमगिरिर्नाम शतशृङ्गो महाद्रुमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000314016, "chapter_id": 9314, "verse_number": "४-४२-१६", "content_sanskrit": "तत्र प्रस्थेषु रम्येषु सिंहाः पक्षगमाः स्थिताः।\nतिमिमत्स्यगजांश्चैव नीडान्यारोपयन्ति ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000314017, "chapter_id": 9314, "verse_number": "४-४२-१७", "content_sanskrit": "तानि नीडानि सिंहानां गिरिशृङ्गगताश्च ये।\nदृप्तास्तृप्ताश्च मातङ्गास्तोयदस्वननिःस्वनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000314018, "chapter_id": 9314, "verse_number": "४-४२-१८", "content_sanskrit": "विचरन्ति विशालेऽस्मिंस्तोयपूर्णे समन्ततः।\nतस्य शृङ्गं दिवस्पर्शं काञ्चनं चित्रपादपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000314019, "chapter_id": 9314, "verse_number": "४-४२-१९", "content_sanskrit": "सर्वमाशु विचेतव्यं कपिभिः कामरूपिभिः।\nकोटिं तत्र समुद्रस्य काञ्चनीं शतयोजनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000314020, "chapter_id": 9314, "verse_number": "४-४२-२०", "content_sanskrit": "दुर्दर्शां पारियात्रस्य गत्वा द्रक्ष्यथ वानराः।\nकोट्यस्तत्र चतुर्विंशद् गन्धर्वाणां तरस्विनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000314021, "chapter_id": 9314, "verse_number": "४-४२-२१", "content_sanskrit": "वसन्त्यग्निनिकाशानां घोराणां कामरूपिणाम्।\nपावकार्चिःप्रतीकाशाः समवेताः समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000314022, "chapter_id": 9314, "verse_number": "४-४२-२२", "content_sanskrit": "नात्यासादयितव्यास्ते वानरैर्भीमविक्रमैः।\nनादेयं च फलं तस्माद् देशात् किंचित् प्लवङ्गमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000314023, "chapter_id": 9314, "verse_number": "४-४२-२३", "content_sanskrit": "दुरासदा हि ते वीराः सत्त्ववन्तो महाबलाः।\nफलमूलानि ते तत्र रक्षन्ते भीमविक्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000314024, "chapter_id": 9314, "verse_number": "४-४२-२४", "content_sanskrit": "तत्र यत्नश्च कर्तव्यो मार्गितव्या च जानकी।\nनहि तेभ्यो भयं किंचित् कपित्वमनुवर्तताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000314025, "chapter_id": 9314, "verse_number": "४-४२-२५", "content_sanskrit": "तत्र वैदूर्यवर्णाभो वज्रसंस्थानसंस्थितः।\nनानाद्रुमलताकीर्णो वज्रो नाम महागिरिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000314026, "chapter_id": 9314, "verse_number": "४-४२-२६", "content_sanskrit": "श्रीमान् समुदितस्तत्र योजनानां शतं समम्।\nगुहास्तत्र विचेतव्याः प्रयत्नेन प्लवङ्गमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000314027, "chapter_id": 9314, "verse_number": "४-४२-२७", "content_sanskrit": "चतुर्भागे समुद्रस्य चक्रवान् नाम पर्वतः।\nतत्र चक्रं सहस्रारं निर्मितं विश्वकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000314028, "chapter_id": 9314, "verse_number": "४-४२-२८", "content_sanskrit": "तत्र पञ्चजनं हत्वा हयग्रीवं च दानवम्।\nआजहार ततश्चक्रं शङ्खं च पुरुषोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000314029, "chapter_id": 9314, "verse_number": "४-४२-२९", "content_sanskrit": "तस्य सानुषु रम्येषु विशालासु गुहासु च।\nरावणः सह वैदेह्या मार्गितव्यस्ततस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000314030, "chapter_id": 9314, "verse_number": "४-४२-३०", "content_sanskrit": "योजनानि चतुःषष्टिर्वराहो नाम पर्वतः।\nसुवर्णशृङ्गः सुमहानगाधे वरुणालये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000314031, "chapter_id": 9314, "verse_number": "४-४२-३१", "content_sanskrit": "तत्र प्राग्ज्योतिषं नाम जातरूपमयं पुरम्।\nयस्मिन् वसति दुष्टात्मा नरको नाम दानवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000314032, "chapter_id": 9314, "verse_number": "४-४२-३२", "content_sanskrit": "तत्र सानुषु रम्येषु विशालासु गुहासु च।\nरावणः सह वैदेह्या मार्गितव्यस्ततस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000314033, "chapter_id": 9314, "verse_number": "४-४२-३३", "content_sanskrit": "तमतिक्रम्य शैलेन्द्रं काञ्चनान्तरदर्शनम्।\nपर्वतः सर्वसौवर्णो धाराप्रस्रवणायुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000314034, "chapter_id": 9314, "verse_number": "४-४२-३४", "content_sanskrit": "तं गजाश्च वराहाश्च सिंहा व्याघ्राश्च सर्वतः।\nअभिगर्जन्ति सततं तेन शब्देन दर्पिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000314035, "chapter_id": 9314, "verse_number": "४-४२-३५", "content_sanskrit": "यस्मिन् हरिहयः श्रीमान् महेन्द्रः पाकशासनः।\nअभिषिक्तः सुरै राजा मेघो नाम स पर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000314036, "chapter_id": 9314, "verse_number": "४-४२-३६", "content_sanskrit": "तमतिक्रम्य शैलेन्द्रं महेन्द्रपरिपालितम्।\nषष्टिं गिरिसहस्राणि काञ्चनानि गमिष्यथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000314037, "chapter_id": 9314, "verse_number": "४-४२-३७", "content_sanskrit": "तरुणादित्यवर्णानि भ्राजमानानि सर्वतः।\nजातरूपमयैर्वृक्षैः शोभितानि सुपुष्पितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000314038, "chapter_id": 9314, "verse_number": "४-४२-३८", "content_sanskrit": "तेषां मध्ये स्थितो राजा मेरुरुत्तमपर्वतः।\nआदित्येन प्रसन्नेन शैलो दत्तवरः पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000314039, "chapter_id": 9314, "verse_number": "४-४२-३९", "content_sanskrit": "तेनैवमुक्तः शैलेन्द्रः सर्व एव त्वदाश्रयाः।\nमत्प्रसादाद् भविष्यन्ति दिवा रात्रौ च काञ्चनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000314040, "chapter_id": 9314, "verse_number": "४-४२-४०", "content_sanskrit": "त्वयि ये चापि वत्स्यन्ति देवगन्धर्वदानवाः।\nते भविष्यन्ति भक्ताश्च प्रभया काञ्चनप्रभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000314041, "chapter_id": 9314, "verse_number": "४-४२-४१", "content_sanskrit": "विश्वेदेवाश्च वसवो मरुतश्च दिवौकसः।\nआगत्य पश्चिमां संध्यां मेरुमुत्तमपर्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000314042, "chapter_id": 9314, "verse_number": "४-४२-४२", "content_sanskrit": "आदित्यमुपतिष्ठन्ति तैश्च सूर्योऽभिपूजितः।\nअदृश्यः सर्वभूतानामस्तं गच्छति पर्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000314043, "chapter_id": 9314, "verse_number": "४-४२-४३", "content_sanskrit": "योजनानां सहस्राणि दश तानि दिवाकरः।\nमुहूर्तार्धेन तं शीघ्रमभियाति शिलोच्चयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000314044, "chapter_id": 9314, "verse_number": "४-४२-४४", "content_sanskrit": "शृङ्गे तस्य महद्दिव्यं भवनं सूर्यसंनिभम्।\nप्रासादगणसम्बाधं विहितं विश्वकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000314045, "chapter_id": 9314, "verse_number": "४-४२-४५", "content_sanskrit": "शोभितं तरुभिश्चित्रैर्नानापक्षिसमाकुलैः।\nनिकेतं पाशहस्तस्य वरुणस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000314046, "chapter_id": 9314, "verse_number": "४-४२-४६", "content_sanskrit": "अन्तरा मेरुमस्तं च तालो दशशिरा महान्।\nजातरूपमयः श्रीमान् भ्राजते चित्रवेदिकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000314047, "chapter_id": 9314, "verse_number": "४-४२-४७", "content_sanskrit": "तेषु सर्वेषु दुर्गेषु सरस्सु च सरित्सु च।\nरावणः सह वैदेह्या मार्गितव्यस्ततस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000314048, "chapter_id": 9314, "verse_number": "४-४२-४८", "content_sanskrit": "यत्र तिष्ठति धर्मज्ञस्तपसा स्वेन भावितः।\nमेरुसावर्णिरित्येष ख्यातो वै ब्रह्मणा समः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000314049, "chapter_id": 9314, "verse_number": "४-४२-४९", "content_sanskrit": "प्रष्टव्यो मेरुसावर्णिर्महर्षिः सूर्यसंनिभः।\nप्रणम्य शिरसा भूमौ प्रवृत्तिं मैथिलीं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000314050, "chapter_id": 9314, "verse_number": "४-४२-५०", "content_sanskrit": "एतावज्जीवलोकस्य भास्करो रजनीक्षये।\nकृत्वा वितिमिरं सर्वमस्तं गच्छति पर्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000314051, "chapter_id": 9314, "verse_number": "४-४२-५१", "content_sanskrit": "एतावद् वानरैः शक्यं गन्तुं वानरपुङ्गवाः।\nअभास्करममर्यादं न जानीमस्ततः परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000314052, "chapter_id": 9314, "verse_number": "४-४२-५२", "content_sanskrit": "अवगम्य तु वैदेहीं निलयं रावणस्य च।\nअस्तं पर्वतमासाद्य पूर्णे मासे निवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000314053, "chapter_id": 9314, "verse_number": "४-४२-५३", "content_sanskrit": "ऊर्ध्वं मासान्न वस्तव्यं वसन् वध्यो भवेन्मम।\nसहैव शूरो युष्माभिः श्वशुरो मे गमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000314054, "chapter_id": 9314, "verse_number": "४-४२-५४", "content_sanskrit": "श्रोतव्यं सर्वमेतस्य भवद्भिर्दिष्टकारिभिः।\nगुरुरेष महाबाहुः श्वशुरो मे महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000314055, "chapter_id": 9314, "verse_number": "४-४२-५५", "content_sanskrit": "भवन्तश्चापि विक्रान्ताः प्रमाणं सर्व एव हि।\nप्रमाणमेनं संस्थाप्य पश्यध्वं पश्चिमां दिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000314056, "chapter_id": 9314, "verse_number": "४-४२-५६", "content_sanskrit": "दृष्टायां तु नरेन्द्रस्य पत्न्याममिततेजसः।\nकृतकृत्या भविष्यामः कृतस्य प्रतिकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000314057, "chapter_id": 9314, "verse_number": "४-४२-५७", "content_sanskrit": "अतोऽन्यदपि यत्कार्यं कार्यस्यास्य प्रियं भवेत्।\nसम्प्रधार्य भवद्भिश्च देशकालार्थसंहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000314058, "chapter_id": 9314, "verse_number": "४-४२-५८", "content_sanskrit": "ततः सुषेणप्रमुखाः प्लवङ्गाः\nसुग्रीववाक्यं निपुणं निशम्य।\nआमन्त्र्य सर्वे प्लवगाधिपं ते\nजग्मुर्दिशं तां वरुणाभिगुप्ताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000314059, "chapter_id": 9314, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे द्विचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]