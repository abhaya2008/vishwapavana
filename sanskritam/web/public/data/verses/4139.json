[{"id": 2145669, "chapter_id": 4139, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2145670, "chapter_id": 4139, "verse_number": "१", "content_sanskrit": "प्रयाते सञ्जये साधो कौरवान् प्रति वै तदा ।\nकिं चक्रुः पाण्डवास्तत्र मम पूर्वपितामहाः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2145671, "chapter_id": 4139, "verse_number": "२", "content_sanskrit": "एतत्सर्वं द्विजश्रेष्ठ विस्तरं मम सत्तम ।\nकथयस्व प्रयत्नेन श्रोतुमिच्छामि पण्डित\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2145672, "chapter_id": 4139, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2145673, "chapter_id": 4139, "verse_number": "३", "content_sanskrit": "सञ्जये प्रतियाते तु धर्मराजो युधिष्ठिरः ।\nअर्जुनं भीमसेनं च माद्रीपुत्रौ च भ्रातरौ\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2145674, "chapter_id": 4139, "verse_number": "४", "content_sanskrit": "विराटद्रुपदौ चैव केकयानां महारथान् ।\nअब्रवीदुपसङ्गम्य शङ्खचक्रगदाधरम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2145675, "chapter_id": 4139, "verse_number": "५", "content_sanskrit": "अभियाचामहे गत्वा प्रयातुं कुरुसंसदम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2145676, "chapter_id": 4139, "verse_number": "६", "content_sanskrit": "तथा भीष्मेण द्रोणेन बाह्लिकेन च धीमता ।\nअन्यैश्च कुरुभिः सार्धं न युध्येमहि संयुगे\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2145677, "chapter_id": 4139, "verse_number": "७", "content_sanskrit": "एषः नः प्रथमः कल्प एतन्नः श्रेय उत्तमम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2145678, "chapter_id": 4139, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2145679, "chapter_id": 4139, "verse_number": "८", "content_sanskrit": "एवमुक्ताः सुमनसः तेऽभिजग्मुर्जनार्दनम् ।\nपाण्डवैः सह राजानो मरुत्वन्तमिवामराः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2145680, "chapter_id": 4139, "verse_number": "९", "content_sanskrit": "तथा च दुःसहाः सर्वैः सदस्यास्ते नरर्षभ\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2145681, "chapter_id": 4139, "verse_number": "१०", "content_sanskrit": "जनार्दनं समासाद्य कुन्तीपुत्रो युधिष्ठिरः ।\nअभ्यभाषत दाशार्हम् ऋषभं सर्वसात्त्वताम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2145682, "chapter_id": 4139, "verse_number": "११", "content_sanskrit": "अयं स कालः सम्प्राप्तो मित्रार्थे हि जनार्दन ।\nन च त्वदन्यं पश्यामि यो न आपत्सु तारयेत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2145683, "chapter_id": 4139, "verse_number": "१२", "content_sanskrit": "त्वां हि माधव संश्रित्य निर्भया मोहदर्पितम् ।\nधार्तराष्ट्रं सहामात्यं स्वमंशमनुयुङ्क्ष्महे\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2145684, "chapter_id": 4139, "verse_number": "१३", "content_sanskrit": "यथा हि सर्वास्वापत्सु पासि वृष्णीनरिन्दम ।\nतथा ते पाण्डवा रक्ष्याः पाह्यस्मान् महतो भयात्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2145685, "chapter_id": 4139, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2145686, "chapter_id": 4139, "verse_number": "१४", "content_sanskrit": "अहमस्मि महाबाहो ब्रूहि यत् ते विवक्षितम् ।\nकरिष्यामि हि तत् सर्वं यत् त्वं वक्ष्यसि भारत\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2145687, "chapter_id": 4139, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2145688, "chapter_id": 4139, "verse_number": "१५", "content_sanskrit": "श्रुतं ते धृतराष्ट्रस्य सपुत्रस्य चिकीर्षितम् ।\nएतद्धि सकलं कृष्ण सञ्जयो मां यदब्रवीत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2145689, "chapter_id": 4139, "verse_number": "१६", "content_sanskrit": "मृदुपूर्वं साममिश्रं सान्त्वमुग्रं च माधव ।\nन तु तन्न्यायमास्थाय गर्हिताश्च ततो वयम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2145690, "chapter_id": 4139, "verse_number": "१७", "content_sanskrit": "तन्मतं धृतराष्ट्रस्य सोऽन्यात्मा विवृतान्तरः ।\nयथोक्तं दूत आचष्टे वध्यः स्यादन्यथा ब्रुवन्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2145691, "chapter_id": 4139, "verse_number": "१८", "content_sanskrit": "अप्रदानेन राज्यस्य शान्तिमस्मासु मार्गते ।\nलुब्धः पापेन मनसा चरन्नसममात्मनः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2145692, "chapter_id": 4139, "verse_number": "१९", "content_sanskrit": "यत् तद् द्वादशवर्षाणि वनेष्वध्युषिता वयम् ।\nछद्मना शरदं चैकां धृतराष्ट्रस्य शासनात्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2145693, "chapter_id": 4139, "verse_number": "२०", "content_sanskrit": "स्थाता नः समये तस्मिन् धृतराष्ट्र इति प्रभो ।\nनाहास्म समयं कृष्ण तद्धि नो ब्राह्मणा विदुः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2145694, "chapter_id": 4139, "verse_number": "२१", "content_sanskrit": "वृद्धो राजा धृतराष्ट्रः स्वधर्मं नानुपश्यति ।\nपश्यन् वा पुत्रगृध्नुत्वान्मन्दस्यान्वेति शासनम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2145695, "chapter_id": 4139, "verse_number": "२२", "content_sanskrit": "सुयोधनमते तिष्ठन् राजाऽस्मासु जनार्दन ।\nमिथ्या चरति लुब्धः सन् चरन् हि प्रियमात्मनः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2145696, "chapter_id": 4139, "verse_number": "२३", "content_sanskrit": "इतो दुःखतरं किं नु यदहं मातरं ततः ।\nसंविधातुं न शक्नोमि मित्राणां वा जनार्दन\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2145697, "chapter_id": 4139, "verse_number": "२४", "content_sanskrit": "काशिभिश्चेदिपाञ्चालैर्मत्स्यैश्च मधुसूदन ।\nभवता चैव नाथेन पञ्च ग्रामा वृता मया\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2145698, "chapter_id": 4139, "verse_number": "२५", "content_sanskrit": "कुशस्थलं वृकस्थलं वासन्तीं वारणावतम् ।\nअवसानं च गोविन्द किञ्चिदेव च पञ्चमम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2145699, "chapter_id": 4139, "verse_number": "२६", "content_sanskrit": "पञ्च नस्तात दीयन्तां ग्रामा वा नगराणि वा ।\nवसेम सहिता येषु मा च नो भरता नशन्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2145700, "chapter_id": 4139, "verse_number": "२७", "content_sanskrit": "न च तानपि दुष्टात्मा धार्तराष्ट्रोऽनुमन्यते ।\nस्वाम्यमात्मनि मत्वा स ततो दुःखतरं नु किम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2145701, "chapter_id": 4139, "verse_number": "२८", "content_sanskrit": "कुले जातस्य वृद्धस्य परवित्तेषु गृद्ध्यतः ।\nलोभः प्रज्ञानमाहन्ति प्रज्ञा हन्ति हता ह्रियम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2145702, "chapter_id": 4139, "verse_number": "२९", "content_sanskrit": "ह्रीर्हता बाधते धर्मं धर्मो हन्ति हतः श्रियम् ।\nश्रीर्हता पुरुषं हन्ति पुरुषश्च हतः स्वताम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2145703, "chapter_id": 4139, "verse_number": "३०", "content_sanskrit": "अस्वतो विनिवर्तन्ते ज्ञातयः सुहृदो द्विजाः ।\nअपुष्पादफलाद् वृक्षाद् यथा कृष्ण पतत्त्रिणः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2145704, "chapter_id": 4139, "verse_number": "३१", "content_sanskrit": "एतच्च मरणं तात यदस्मात् पतितादिव ।\nज्ञातयो विनिवर्तन्ते प्रेतसत्वादिवासवः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2145705, "chapter_id": 4139, "verse_number": "३२", "content_sanskrit": "नातः पापीयसीं काञ्चिदवस्थां शम्बरोऽब्रवीत् ।\nयच्च नैवोद्यतः प्रातर्भोजनं प्रतिदृश्यते\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2145706, "chapter_id": 4139, "verse_number": "३३", "content_sanskrit": "धनमाहुः परं धर्मं धने सर्वं प्रतिष्ठितम् ।\nजीवन्ति धनिनो लोके मृता ये त्वधना नराः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2145707, "chapter_id": 4139, "verse_number": "३४", "content_sanskrit": "ये धनादपकर्षन्ति नरं स्वबलमाश्रितः ।\nते धर्ममर्थं कामं च प्रमथ्नन्ति नरं च तम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2145708, "chapter_id": 4139, "verse_number": "३५", "content_sanskrit": "एतामवस्थां प्राप्यैके मरणं वव्रिरे जनाः ।\nग्रामानेके वनायैके नाशायैव प्रवव्रजुः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2145709, "chapter_id": 4139, "verse_number": "३६", "content_sanskrit": "आत्मानमेके त्यक्ष्यन्ति यान्त्यन्ये द्विषतां वशम् ।\nदास्यमेके च गच्छन्ति परेषामर्थहेतवे\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2145710, "chapter_id": 4139, "verse_number": "३७", "content_sanskrit": "आपदेवास्य मरणात् पुरुषस्य गरीयसी ।\nयया विनाश्यते चास्य निमित्तं धर्मकामयोः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2145711, "chapter_id": 4139, "verse_number": "३८", "content_sanskrit": "यदस्य धर्म्यं मरणं शाश्वतं लोकवर्त्म तत् ।\nसमन्तात् सर्वभूतानां न तदत्येति कश्चन\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2145712, "chapter_id": 4139, "verse_number": "३९", "content_sanskrit": "न तथा बाध्यते कृष्ण प्रकृत्या निर्धनो जनः ।\nयथा भद्रां श्रियं प्राप्य तया हीनः सुखैधितः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2145713, "chapter_id": 4139, "verse_number": "४०", "content_sanskrit": "स तदाऽऽत्मापराधेन सम्प्राप्तो व्यसनं महत् ।\nसेन्द्रान् गर्हयते देवान् आत्मानं न कथञ्चन\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2145714, "chapter_id": 4139, "verse_number": "४१", "content_sanskrit": "न चास्य सर्वशास्त्राणि प्रतरन्ति निगर्हणात् ।\nसोऽभिक्रुद्ध्यति भृत्यानां सुहृदश्चाभ्यसूयति\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2145715, "chapter_id": 4139, "verse_number": "४२", "content_sanskrit": "तं तदा मन्युरेवैति स भूयः सम्प्रमुह्यति ।\nस मोहवशमापन्नः क्रूरं कर्म निषेवते\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2145716, "chapter_id": 4139, "verse_number": "४३", "content_sanskrit": "पापकर्मतया देव सङ्करं तेन पुष्यति ।\nसङ्करो नरकायैव सा काष्ठा पापकर्मणाम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2145717, "chapter_id": 4139, "verse_number": "४४", "content_sanskrit": "न चेत् प्रबुध्यते कृष्ण नरकायैव गच्छति ।\nतस्य प्रबोधः प्रज्ञैव प्रज्ञाचक्षुर्न रिष्यति\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2145718, "chapter_id": 4139, "verse_number": "४५", "content_sanskrit": "प्रज्ञालाभे हि पुरुषः शास्त्राण्येवान्ववेक्षते ।\nशास्त्रनिष्ठः पुनर्धर्मं तस्य ह्रीरङ्गमुत्तमम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2145719, "chapter_id": 4139, "verse_number": "४६", "content_sanskrit": "ह्रीमान् हि पापं प्रद्वेष्टि तस्य श्रीरभिवर्धते ।\nश्रीमान् स यावद् भवति तावद् भवति पूरुषः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2145720, "chapter_id": 4139, "verse_number": "४७", "content_sanskrit": "धर्मनित्यः प्रशान्तात्मा कार्ययोगवहः सदा ।\nनाधर्मे कुरुते बुद्धिं न च पापे प्रवर्तते\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2145721, "chapter_id": 4139, "verse_number": "४८", "content_sanskrit": "अह्रीको वाऽपि मूढो वा नैव स्त्री न पुनः पुमान् ।\nनास्याधिकारो धर्मेऽस्ति यथा शूद्रस्तथैव सः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2145722, "chapter_id": 4139, "verse_number": "४९", "content_sanskrit": "ह्रीमानुपैति देवांश्च पितॄनात्मानमेव च ।\nतेनामृतत्वं व्रजति सा काष्ठा पुण्यकर्मणाम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2145723, "chapter_id": 4139, "verse_number": "५०", "content_sanskrit": "तदिदं मयि ते दृष्टं प्रत्यक्षं मधुसूदन ।\nयथा राज्यात् परिभ्रष्टो वसामि वसतीरिमाः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2145724, "chapter_id": 4139, "verse_number": "५१", "content_sanskrit": "ते वयं न श्रियं हातुमलं न्यायेन केनचित् ।\nअत्र नो यतमानानां वधश्चेदपि साधु तत्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2145725, "chapter_id": 4139, "verse_number": "५२", "content_sanskrit": "तत्र नः प्रथमः कल्पो यद् वयं ते च माधव ।\nप्रशान्ताः समभूताश्च श्रियं तामश्नुवीमहि\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2145726, "chapter_id": 4139, "verse_number": "५३", "content_sanskrit": "तत्रैषा परमा काष्ठा रौद्रकर्मक्षयोदया ।\nयद् वयं कौरवान् हत्वा तानि शास्त्राण्यधीमहि\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2145727, "chapter_id": 4139, "verse_number": "५४", "content_sanskrit": "ये पुनः स्युरसम्बद्धा अनार्याः कृष्ण शत्रवः ।\nतेषामप्यवधः कार्यः किम्पुनर्ये स्युरीदृशाः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2145728, "chapter_id": 4139, "verse_number": "५५", "content_sanskrit": "ज्ञातयश्चैव भूयिष्ठाः सहाया गुरवश्च नः ।\nतेषां वधोऽतिपापीयान् किं नु युद्धेऽस्ति शोभनम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2145729, "chapter_id": 4139, "verse_number": "५६", "content_sanskrit": "पापः क्षत्रियधर्मोऽयं वयं च क्षत्रबन्धवः ।\nस नः स्वधर्मोऽधर्मो वा वृत्तिरन्या विगर्हिता\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2145730, "chapter_id": 4139, "verse_number": "५७", "content_sanskrit": "शूद्रः करोति शुश्रूषां वैश्या वाणिज्यजीविनः ।\nवयं वधेन जीवामः कार्पण्यं ब्राह्मणैर्वृतम्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2145731, "chapter_id": 4139, "verse_number": "५८", "content_sanskrit": "क्षत्रियः क्षत्रियं हन्ति मत्स्यो मत्स्येन जीवति ।\nश्वा श्वानं हन्ति दाशार्ह पश्य धर्मो यथा गतः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2145732, "chapter_id": 4139, "verse_number": "५९", "content_sanskrit": "युद्धे कृष्ण कलिर्नित्यं प्राणाः सीदन्ति संयुगे ।\nबलं तु नीतिमास्थाय भवे जयपराजयौ\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2145733, "chapter_id": 4139, "verse_number": "६०", "content_sanskrit": "नात्मच्छन्देन भूतानां जीवितं मरणं तथा ।\nनाप्यकाले सुखं प्राप्यं दुःखं चाऽपि यदूत्तम\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2145734, "chapter_id": 4139, "verse_number": "६१", "content_sanskrit": "एको ह्यपि बहून् हन्ति घ्नन्त्येकं बहवोऽप्युत ।\nशूरं कापुरुषो हन्ति अयशस्वी यशस्विनम्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2145735, "chapter_id": 4139, "verse_number": "६२", "content_sanskrit": "जयो नैवोभयोर्दृष्टो नोभयोश्च पराजयः ।\nतथैवापचयो दृष्टो व्यपयाने व्ययाव्ययौ\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2145736, "chapter_id": 4139, "verse_number": "६३", "content_sanskrit": "सर्वथा व्रजिनं युद्धं को घ्नन् न प्रतिहन्यते ।\nहतस्य च हृषीकेश समौ जयपराजयौ\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2145737, "chapter_id": 4139, "verse_number": "६४", "content_sanskrit": "पराजयश्च मरणान्मन्ये नैव विशिष्यते\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2145738, "chapter_id": 4139, "verse_number": "६५", "content_sanskrit": "यस्य स्याद् विजयः कृष्ण तस्याप्यपजयो ध्रुवम् ।\nअन्ततो दयितं घ्नन्ति केचिदप्यपराजिताः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2145739, "chapter_id": 4139, "verse_number": "६६", "content_sanskrit": "तस्याङ्गबलहीनस्य पुत्रान् भ्रातॄनपश्यतः ।\nनिर्वेदो जीविते कृष्ण सर्वतश्चोपजायते\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2145740, "chapter_id": 4139, "verse_number": "६७", "content_sanskrit": "ये ह्येव धीरा ह्रीमन्त आर्याः करुणवेदिनः ।\nत एव युद्धे हन्यन्ते यवीयान् मुच्यते जनः\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2145741, "chapter_id": 4139, "verse_number": "६८", "content_sanskrit": "हत्वाऽप्यनुशयो नित्यं परानपि जनार्दन ।\nअनुबन्धप्रलापश्च शेषश्चाप्यवशिष्यते\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2145742, "chapter_id": 4139, "verse_number": "६९", "content_sanskrit": "शेषो हि बलमासाद्य न शेषमवशेषयेत् ।\nसर्वोच्छेदे च यतते वैरस्यान्तविधित्सया\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2145743, "chapter_id": 4139, "verse_number": "७०", "content_sanskrit": "जयो वैरं प्रसृजति दुःखमास्ते पराजितः ।\nसुखं प्रशान्तः स्वपिति हित्वा जयपराजयौ\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2145744, "chapter_id": 4139, "verse_number": "७१", "content_sanskrit": "जातवैरश्च पुरुषो दुःखं स्वपिति नित्यदा ।\nअनिर्वृत्तेन मनसा ससर्प इव वेश्मनि\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2145745, "chapter_id": 4139, "verse_number": "७२", "content_sanskrit": "उत्सादयति यः सर्वं यशसा स विमुच्यते ।\nअकीर्तिं सर्वभूतेषु शाश्वतीं स निगच्छति\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2145746, "chapter_id": 4139, "verse_number": "७३", "content_sanskrit": "न हि वैराणि शाम्यन्ति दीर्घकालकृतान्यपि ।\nआख्यातारश्च विद्यन्ते पुमांश्चेद् विद्यते कुले\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2145747, "chapter_id": 4139, "verse_number": "७४", "content_sanskrit": "न चापि वैरं वैरेण केशव प्रतिशाम्यति ।\nहविषाऽग्निर्यथा कृष्ण भूय एवाभिवर्धते\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2145748, "chapter_id": 4139, "verse_number": "७५", "content_sanskrit": "अतोऽन्यथा नास्ति शान्तिर्नित्यमन्तरमन्ततः ।\nअन्तरं लिप्समानानाम् अयं दोषो निरन्तरः\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2145749, "chapter_id": 4139, "verse_number": "७६", "content_sanskrit": "पौरुषे यो हि बलवान् आधिर्हृदयतापनः ।\nतस्य त्यागेन वा शान्तिर्मरणेनापि वा भवेत्\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2145750, "chapter_id": 4139, "verse_number": "७७", "content_sanskrit": "अथवा मूलघातेन द्विषतां मधुसूदन ।\nफलं निवृत्तिरर्थस्य तन्नृशंसतरं भवेत्\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2145751, "chapter_id": 4139, "verse_number": "७८", "content_sanskrit": "या तु त्यागेन शान्तिः स्यात् तदृते वध एव सः ।\nसंशयाच्च समुच्छेदाद् द्विषतामात्मनस्तथा\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2145752, "chapter_id": 4139, "verse_number": "७९", "content_sanskrit": "न च त्यक्तुं तदिच्छामो न चेच्छामः कुलक्षयम् ।\nअत्र या प्रणिपातेन शान्तिः सैव गरीयसी\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2145753, "chapter_id": 4139, "verse_number": "८०", "content_sanskrit": "सर्वथा यतमानानाम् अयुद्धमभिकाङ्क्षताम् ।\nसान्त्वे प्रतिहते युद्धं प्रसिद्धं नापराक्रमः\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2145754, "chapter_id": 4139, "verse_number": "८१", "content_sanskrit": "प्रतिघातेन सान्त्वस्य दारुणं सम्प्रवर्तते ।\nतच्छुनामिव गोपाते पण्डितैरुपलक्षितम्\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2145755, "chapter_id": 4139, "verse_number": "८२", "content_sanskrit": "लाङ्गूलचालनं क्ष्वेला प्रतिरावो निवर्तनम् ।\nदन्तदर्शनमारावस्ततो युद्धं प्रवर्तते\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2145756, "chapter_id": 4139, "verse_number": "८३", "content_sanskrit": "तत्र यो बलवान् कृष्ण जित्वा सोऽत्ति तदामिषम् ।\nएवमेव मनुष्येषु विशेषो नास्ति कश्चन\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2145757, "chapter_id": 4139, "verse_number": "८४", "content_sanskrit": "सर्वथा त्वेतदुचितं दुर्बलेषु बलीयसाम् ।\nअनादरो विरोधस्य प्रणिपाती हि दुर्बलः\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2145758, "chapter_id": 4139, "verse_number": "८५", "content_sanskrit": "पिता राजा च वृद्धश्च सर्वथा मानमर्हति ।\nतस्मान्मान्यश्च पूज्यश्च धृतराष्ट्रो जनेश्वरः\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2145759, "chapter_id": 4139, "verse_number": "८६", "content_sanskrit": "पुत्रस्नेहश्च बलवान् धृतराष्ट्रस्य माधव ।\nस पुत्रवशमापन्नः प्रणिपातं प्रहास्यति\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2145760, "chapter_id": 4139, "verse_number": "८७", "content_sanskrit": "तत्र किं मन्यसे कृष्ण प्राप्तकालमनन्तरम् ।\nकथमर्थाच्च धर्माच्च न हीयेमहि माधव\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2145761, "chapter_id": 4139, "verse_number": "८८", "content_sanskrit": "ईदृशेऽह्यर्थकृच्छ्रेऽस्मिन् कमन्यं मधुसूदन ।\nउपसम्प्रष्टुमर्हामि त्वामृते पुरुषोत्तम\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2145762, "chapter_id": 4139, "verse_number": "८९", "content_sanskrit": "प्रियश्च प्रियकामश्च गतिज्ञः सर्वकर्मणाम् ।\nको हि कृष्णास्ति नस्त्वादृक् सर्वनिश्चयवित् सुहृत्\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2145763, "chapter_id": 4139, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि सप्ततितमोऽध्यायः ॥७०॥\nभगवद्यानपर्वणि प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}]