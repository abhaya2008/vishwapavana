[{"id": 900007710, "chapter_id": 8581, "verse_number": "162.1", "content_sanskrit": "इत्यभिप्रायतः प्रायो ज्ञानमेव विमुक्तये वदन्ति श्रुतयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900007711, "chapter_id": 8581, "verse_number": "162.2", "content_sanskrit": "सोऽयं विशेषोऽपि ह्युदीर्यते भक्तिर्ज्ञानमिति क्वापि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900007712, "chapter_id": 8581, "verse_number": "162.3", "content_sanskrit": "न हि द्वेषयुता दृशिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900007713, "chapter_id": 8581, "verse_number": "162.4", "content_sanskrit": "चेतनस्य द्वयं भोग्यं संसारो मुक्तिरेव च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900007714, "chapter_id": 8581, "verse_number": "162.5", "content_sanskrit": "असन्मुक्तेः कारणं च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900007715, "chapter_id": 8581, "verse_number": "162.6", "content_sanskrit": "द्वेषतोऽपि विमुक्तिश्चेन्महातात्पर्यरोधनम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900007716, "chapter_id": 8581, "verse_number": "162.7", "content_sanskrit": "यदि द्वेषेण मुक्तिः स्याद्वक्तव्यो दोषसञ्चयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900007717, "chapter_id": 8581, "verse_number": "162.8", "content_sanskrit": "यथा क्रुद्धः पिता पुत्रं मरेत्याक्षेपपूर्वकम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900007718, "chapter_id": 8581, "verse_number": "162.9", "content_sanskrit": "श्रुतिविरोधेन स्वविरोधेन चाञ्जसा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900007719, "chapter_id": 8581, "verse_number": "162.10", "content_sanskrit": "तमो द्वेषेण संयान्ति भक्त्या मुक्तिं तथैव च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900007720, "chapter_id": 8581, "verse_number": "162.11", "content_sanskrit": "महातात्पर्यरोधेन कथं वाक्यं प्रमाणताम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900007721, "chapter_id": 8581, "verse_number": "162.12", "content_sanskrit": "वाचकत्वं हि तात्पर्यं", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900007722, "chapter_id": 8581, "verse_number": "162.13", "content_sanskrit": "अतो विज्ञानभक्तिभ्यां पुरुषार्थः परो भवेत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900007723, "chapter_id": 8581, "verse_number": "162.14", "content_sanskrit": "यस्य देवे परा भक्तिर्यथा देवे तथा गुरौ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900007724, "chapter_id": 8581, "verse_number": "162.15", "content_sanskrit": "न च प्रसादमाप्नोति द्वेषाद्भक्त्या तमाप्नुयात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900007725, "chapter_id": 8581, "verse_number": "162.16", "content_sanskrit": "ये पृथग्विहिता विष्णोर्गुणा वेदेन सादरम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900007726, "chapter_id": 8581, "verse_number": "162.17", "content_sanskrit": "तारतम्येन तद्भक्तेष्वपि भक्तिर्विनिश्चयात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900007727, "chapter_id": 8581, "verse_number": "162.18", "content_sanskrit": "यो हि भक्तः प्रधाने स्यात्तदीयेष्वपि भक्तिमान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900007728, "chapter_id": 8581, "verse_number": "162.19", "content_sanskrit": "तारतम्येन तेष्वद्धा भक्तिर्दृष्टानुसारतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900007729, "chapter_id": 8581, "verse_number": "162.20", "content_sanskrit": "लक्ष्मीविरिञ्चवाणीशगिरिजेन्दा गिरां पतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900007730, "chapter_id": 8581, "verse_number": "162.21", "content_sanskrit": "हरिद्वेषो न शुभदः सद्द्वेषत्वाद्यथा गुरोः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]