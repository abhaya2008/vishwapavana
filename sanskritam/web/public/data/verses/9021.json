[{"id": 5000021000, "chapter_id": 9021, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे एकविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000021001, "chapter_id": 9021, "verse_number": "१-२१-१", "content_sanskrit": "तच्छ्रुत्वा वचनं तस्य स्नेहपर्याकुलाक्षरम् ।\nसमन्युः कौशिको वाक्यं प्रत्युवाच महीपतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000021002, "chapter_id": 9021, "verse_number": "१-२१-२", "content_sanskrit": "पूर्वमर्थं प्रतिश्रुत्य प्रतिज्ञां हातुमिच्छसि ।\nराघवाणामयुक्तोऽयं कुलस्यास्य विपर्ययः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000021003, "chapter_id": 9021, "verse_number": "१-२१-३", "content_sanskrit": "यदीदं ते क्षमं राजन् गमिष्यामि यथागतम् ।\nमिथ्याप्रतिज्ञः काकुत्स्थ सुखी भव सुह्द्वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000021004, "chapter_id": 9021, "verse_number": "१-२१-४", "content_sanskrit": "तस्य रोषपरीतस्य विश्वामित्रस्य धीमतः ।\nचचाल वसुधा कृत्स्ना देवानां च भयं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000021005, "chapter_id": 9021, "verse_number": "१-२१-५", "content_sanskrit": "त्रस्तरूपं तु विज्ञाय जगत्सर्वं महानृषिः ।\nनृपतिं सुव्रतो धीरो वसिष्ठो वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000021006, "chapter_id": 9021, "verse_number": "१-२१-६", "content_sanskrit": "इक्ष्वाकूणां कुले जातः साक्षाद् धर्म इवापरः ।\nधृतिमान् सुव्रतः श्रीमान् न धर्मं हातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000021007, "chapter_id": 9021, "verse_number": "१-२१-७", "content_sanskrit": "त्रिषु लोकेषु विख्यातो धर्मात्मा इति राघवः ।\nस्वधर्मं प्रतिपद्यस्व नाधर्मं वोढुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000021008, "chapter_id": 9021, "verse_number": "१-२१-८", "content_sanskrit": "प्रतिश्रुत्य करिष्येति उक्तं वाक्यमकुर्वतः ।\nइष्टापूर्तवधो भूयात् तस्माद् रामं विसर्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000021009, "chapter_id": 9021, "verse_number": "१-२१-९", "content_sanskrit": "कृतास्त्रमकृतास्त्रं वा नैनं शक्ष्यन्ति राक्षसाः ।\nगुप्तं कुशिकपुत्रेण ज्वलनेनामृतं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000021010, "chapter_id": 9021, "verse_number": "१-२१-१०", "content_sanskrit": "एष विग्रहवान् धर्म एष वीर्यवतां वरः ।\nएष विद्याधिको लोके तपसश्च परायणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000021011, "chapter_id": 9021, "verse_number": "१-२१-११", "content_sanskrit": "एषोऽस्त्रान् विविधान् वेत्ति त्रैलोक्ये सचराचरे ।\nनैनमन्यः पुमान् वेत्ति न च वेत्स्यन्ति केचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000021012, "chapter_id": 9021, "verse_number": "१-२१-१२", "content_sanskrit": "न देवा नर्षयः केचिन्नामरा न च राक्षसाः ।\nगन्धर्वयक्षप्रवराः सकिन्नरमहोरगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000021013, "chapter_id": 9021, "verse_number": "१-२१-१३", "content_sanskrit": "सर्वास्त्राणि कृशाश्वस्य पुत्राः परमधार्मिकाः ।\nकौशिकाय पुरा दत्ता यदा राज्यं प्रशासति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000021014, "chapter_id": 9021, "verse_number": "१-२१-१४", "content_sanskrit": "तेऽपि पुत्राः कृशाश्वस्य प्रजापतिसुतासुताः ।\nनैकरूपा महावीर्या दीप्तिमन्तो जयावहाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000021015, "chapter_id": 9021, "verse_number": "१-२१-१५", "content_sanskrit": "जया च सुप्रभा चैव दक्षकन्ये सुमध्यमे ।\nते सुवातेऽस्त्रशस्त्राणि शतं परमभास्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000021016, "chapter_id": 9021, "verse_number": "१-२१-१६", "content_sanskrit": "पञ्चाशतं सुताँल्लेभे जया लब्धवरा वरान् ।\nवधायासुरसैन्यानामप्रमेयानुरूपिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000021017, "chapter_id": 9021, "verse_number": "१-२१-१७", "content_sanskrit": "सुप्रभाजनयच्चापि पुत्रान् पञ्चाशतं पुनः ।\nसंहारान् नाम दुर्धर्षान् दुराक्रामान् बलीयसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000021018, "chapter_id": 9021, "verse_number": "१-२१-१८", "content_sanskrit": "तानि चास्त्राणि वेत्त्येष यथावत् कुशिकात्मजः ।\nअपूर्वाणां च जनने शक्तो भूयश्च धर्मवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000021019, "chapter_id": 9021, "verse_number": "१-२१-१९", "content_sanskrit": "तेनास्य मुनिमुख्यस्य धर्मज्ञस्य महात्मनः ।\nन किञ्चिदस्त्यविदितं भूतं भव्यम् च राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000021020, "chapter_id": 9021, "verse_number": "१-२१-२०", "content_sanskrit": "एवंवीर्यो महातेजा विश्वामित्रो महायशाः ।\nन रामगमने राजन् संशयं गन्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000021021, "chapter_id": 9021, "verse_number": "१-२१-२१", "content_sanskrit": "तेषां निग्रहणे शक्तः स्वयं च कुशिकात्मजः ।\nतव पुत्रहितार्थाय त्वामुपेत्याभियाचते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000021022, "chapter_id": 9021, "verse_number": "१-२१-२२", "content_sanskrit": "इति मुनिवचनात् प्रसन्नचित्तो\n:::रघुवृषभः च मुमोद पार्थिवाग्र्यः ।\nगमनमभिरुरोच राघवस्य\n:::प्रथितयशाः कुशिकात्मजाय बुद्ध्या ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000021023, "chapter_id": 9021, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदि्काव्ये बालकाण्डे एकविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]