[{"id": 7004538000, "chapter_id": 24538, "verse_number": "५-३-२३२-१", "content_sanskrit": "सूत उवाच ।\nइति वः कथितं विप्रा रेवामाहात्म्यमुत्तमम् ।\nयथोपदिष्टं पार्थाय मार्कण्डेयेन वै पुरा॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004538001, "chapter_id": 24538, "verse_number": "५-३-२३२-२", "content_sanskrit": "तथा तीर्थकदम्बाश्च तेषु तीर्थविशेषतः ।\nप्राधान्येन मया ख्याता यथासङ्ख्यं यथाक्रमम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004538002, "chapter_id": 24538, "verse_number": "५-३-२३२-३", "content_sanskrit": "एतत्पवित्रमतुलं ह्येतत्पापहरं परम् ।\nनर्मदाचरितं पुण्यं माहात्म्यं मुनिभाषितम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004538003, "chapter_id": 24538, "verse_number": "५-३-२३२-४", "content_sanskrit": "सप्तकल्पानुगो विप्रो नर्मदायां मुनीश्वराः ।\nमृकण्डतनयो धीमान्परमार्थविदुत्तमः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004538004, "chapter_id": 24538, "verse_number": "५-३-२३२-५", "content_sanskrit": "संसेव्य सर्वतीर्थानि नदीः सर्वाश्च वै पुरा ।\nबहुकल्पस्मरां रेवामालक्ष्य शिवदेहजाम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004538005, "chapter_id": 24538, "verse_number": "५-३-२३२-६", "content_sanskrit": "मे कलेति च शर्वोक्तां शरणं शर्वजां ययौ ।\nअजराममरां देवीं दैत्यध्वंसकरीं पराम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004538006, "chapter_id": 24538, "verse_number": "५-३-२३२-७", "content_sanskrit": "महाविभवसंयुक्तां भवघ्नीं भवजाह्नवीम् ।\nतस्यामाबध्य सत्प्रेम जातः सोऽप्यजरामरः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004538007, "chapter_id": 24538, "verse_number": "५-३-२३२-८", "content_sanskrit": "षष्टितीर्थसहस्राणि षष्टिकोट्यश्च सत्तमाः ।\nव्यवस्थितानि रेवायास्तीरयुग्मे पदे पदे॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004538008, "chapter_id": 24538, "verse_number": "५-३-२३२-९", "content_sanskrit": "सारितः परितः सन्ति सतीर्थास्तु सहस्रशः ।\nन तुलां यान्ति रेवायास्ताश्च मन्ये मुनीश्वराः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004538009, "chapter_id": 24538, "verse_number": "५-३-२३२-१०", "content_sanskrit": "एतद्वः कथितं सर्वं यत्पृष्टमखिलं द्विजाः ।\nयन्महेशमुखाच्छ्रुत्वा वायुराह ऋषीन्प्रति॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004538010, "chapter_id": 24538, "verse_number": "५-३-२३२-११", "content_sanskrit": "तद्वन्मृकण्डतनयोऽप्यनुभूयाखिलां नदीम् ।\nसतीर्थां पदशः प्राह पाण्डुपुत्राय पावनीम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004538011, "chapter_id": 24538, "verse_number": "५-३-२३२-१२", "content_sanskrit": "एतच्च कथितं सर्वं संक्षेपेण द्विजोत्तमाः ।\nनर्मदाचरितं पुण्यं त्रिषु लोकेषु दुर्लभम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004538012, "chapter_id": 24538, "verse_number": "५-३-२३२-१३", "content_sanskrit": "किमन्यैः सरितां तोयैः सेवितैस्तु सहस्रशः ।\nयदि संसेव्यते तोयं रेवायाः पापनाशनम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004538013, "chapter_id": 24538, "verse_number": "५-३-२३२-१४", "content_sanskrit": "मेकलाजलसंसेवी मुक्तिमाप्नोति शाश्वतीम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004538014, "chapter_id": 24538, "verse_number": "५-३-२३२-१५", "content_sanskrit": "यथा यथा भजेन्मर्त्यो यद्यदिच्छति तीर्थगः ।\nतत्तदाप्नोति नियतं श्रद्धयाश्रद्धयापि च॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004538015, "chapter_id": 24538, "verse_number": "५-३-२३२-१६", "content_sanskrit": "इदं ब्रह्मा हरिरिदमिदं साक्षात्परो हरः ।\nइदं ब्रह्म निराकारं कैवल्यं नर्मदाजलम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004538016, "chapter_id": 24538, "verse_number": "५-३-२३२-१७", "content_sanskrit": "तावद्गर्जन्ति तीर्थानि नद्यो हृदयफलप्रदाः ।\nयावन्न स्मर्यते रेवा सेवाहेवा कलौ नरैः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004538017, "chapter_id": 24538, "verse_number": "५-३-२३२-१८", "content_sanskrit": "ध्रुवं लोके हितार्थाय शिवेन स्वशरीरतः ।\nशक्तिः कापि सरिद्रूपा रेवेयमवतारिता॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004538018, "chapter_id": 24538, "verse_number": "५-३-२३२-१९", "content_sanskrit": "तावद्गर्जन्ति यज्ञाश्च वनक्षेत्रादयो भृशम् ।\nयावन्न नर्मदानामकीर्तनं क्रियते कलौ॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004538019, "chapter_id": 24538, "verse_number": "५-३-२३२-२०", "content_sanskrit": "गरिमा गाण्यते तावत्तपोदानव्रतादिषु ।\nनरैर्वा प्राप्यते यावद्भुवि भर्गभवा धुनी॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004538020, "chapter_id": 24538, "verse_number": "५-३-२३२-२१", "content_sanskrit": "ये वसन्त्युत्तरे कूले रुद्रस्यानुचरा हि ते ।\nवसन्ति याम्यतीरे ये लोकं ते यान्ति वैष्णवम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004538021, "chapter_id": 24538, "verse_number": "५-३-२३२-२२", "content_sanskrit": "धन्यास्ते देशवर्यास्ते येषु देशेषु नर्मदा ।\nनरकान्तकरी शश्वत्संश्रिता शर्वनिर्मिता॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004538022, "chapter_id": 24538, "verse_number": "५-३-२३२-२३", "content_sanskrit": "कृतपुण्याश्च ते लोकाः शोकाय न भवन्ति ते ।\nये पिबन्ति जलं पुण्यं पार्वतीपतिसिन्धुजम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004538023, "chapter_id": 24538, "verse_number": "५-३-२३२-२४", "content_sanskrit": "इदं पवित्रमतुलं रेवायाश्चरितं द्विजाः ।\nशृणोति यः कीर्तयते मुच्यते सर्वपातकः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004538024, "chapter_id": 24538, "verse_number": "५-३-२३२-२५", "content_sanskrit": "यत्फलं सर्ववेदैश्च सषडङ्गपदक्रमैः ।\nश्रुतैश्च पठितैस्तस्मात्फलमष्टगुणं भवेत्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004538025, "chapter_id": 24538, "verse_number": "५-३-२३२-२६", "content_sanskrit": "सत्रयाजी फलं यच्च लभते द्वादशाब्दिकम् ।\nश्रुत्वा सकृच्च रेवायाश्चरितं तत्फलं लभेत्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004538026, "chapter_id": 24538, "verse_number": "५-३-२३२-२७", "content_sanskrit": "सर्वतीर्थावगाहाच्च यत्फलं सागरादिषु ।\nसकृच्छ्रुत्वा च माहात्म्यं रेवायास्तत्फलं लभेत्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004538027, "chapter_id": 24538, "verse_number": "५-३-२३२-२८", "content_sanskrit": "एतद्धर्म्यमुपाख्यानं सर्वशास्त्रेष्वनुत्तमम् ।\nदेशे वा मण्डले वापि नगरे ग्राममध्यतः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004538028, "chapter_id": 24538, "verse_number": "५-३-२३२-२९", "content_sanskrit": "गृहे वा तिष्ठते यस्य लिखितं सार्ववार्णिकम् ।\nस ब्रह्मा स शिवः साक्षात्स च देवो जनार्दनः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004538029, "chapter_id": 24538, "verse_number": "५-३-२३२-३०", "content_sanskrit": "धर्मार्थकाममोक्षाणां मार्गेऽयं देवसेवितः ।\nगुरूणां च गुरुः शास्त्रं परमं सिद्धिकारणम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004538030, "chapter_id": 24538, "verse_number": "५-३-२३२-३१", "content_sanskrit": "यश्चेदं शृणुयान्नित्यं पुराणं देवभाषितम् ।\nब्राह्मणो वेदवान्भूयात्क्षत्रियो विजयी भवेत्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004538031, "chapter_id": 24538, "verse_number": "५-३-२३२-३२", "content_sanskrit": "धनाढ्यो जायते वैश्यः शूद्रो वै धर्मभाग्भवेत्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004538032, "chapter_id": 24538, "verse_number": "५-३-२३२-३३", "content_sanskrit": "सौभाग्यसन्ततिं नारी श्रुत्वैतत्समवाप्नुयात् ।\nश्रियं सौख्यं स्वर्गवासं जन्म चैवोत्तमे कुले॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004538033, "chapter_id": 24538, "verse_number": "५-३-२३२-३४", "content_sanskrit": "रसभेदी कृतघ्नश्च स्वामिध्रुङ्मित्रवञ्चकः ।\nगोघ्नश्च गरदश्चैव कन्याविक्रयकारकः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004538034, "chapter_id": 24538, "verse_number": "५-३-२३२-३५", "content_sanskrit": "ब्रह्मघ्नश्च सुरापी च स्तेयी च गुरुतल्पगः ।\nनर्मदाचरितं शृण्वंस्तामब्दं योऽभिषेवते॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004538035, "chapter_id": 24538, "verse_number": "५-३-२३२-३६", "content_sanskrit": "सर्वपापविनिर्मुक्तो जायते नात्र संशयः ।\nपाकभेदी वृथापाकी देवब्राह्मणनिन्दकः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004538036, "chapter_id": 24538, "verse_number": "५-३-२३२-३७", "content_sanskrit": "परीवादी गुरोः पित्रोः साधूनां नृपतेस्तथा ।\nतेऽपि श्रुत्वा च पापेभ्यो मुच्यन्ते नात्र संशयः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004538037, "chapter_id": 24538, "verse_number": "५-३-२३२-३८", "content_sanskrit": "ये पुनर्भावितात्मानः शस्त्रं शृण्वन्ति नित्यशः ।\nपूजयन्ति च तच्छास्त्रं नार्मदं वस्त्रभूषणैः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004538038, "chapter_id": 24538, "verse_number": "५-३-२३२-३९", "content_sanskrit": "पुष्पैः फलैश्चन्दनाद्यैर्भोजनैर्विविधैरपि ।\nशास्त्रेऽस्मिन्पूजिते देवाः पूजिता गुरवस्तथा॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004538039, "chapter_id": 24538, "verse_number": "५-३-२३२-४०", "content_sanskrit": "इह लोके परे चैव नात्र कार्या विचारणा ।\nतस्मात्सर्वप्रयत्नेन गन्धवस्त्रादिभूषणैः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004538040, "chapter_id": 24538, "verse_number": "५-३-२३२-४१", "content_sanskrit": "पूजयेत्परया भक्त्या वाचकं शास्त्रमेव च ।\nवेदपाठैश्च यत्पुण्यमग्निहोत्रैश्च पालितैः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004538041, "chapter_id": 24538, "verse_number": "५-३-२३२-४२", "content_sanskrit": "तत्फलं समवाप्नोति नर्मदाचरिते शुभे ।\nकुरुक्षेत्रे च यत्पुण्यं प्रभासे पुष्करे तथा॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004538042, "chapter_id": 24538, "verse_number": "५-३-२३२-४३", "content_sanskrit": "रुद्रावर्ते गयायां च वाराणस्यां विशेषतः ।\nगङ्गाद्वारे प्रयागे च गङ्गासागरसङ्गमे॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004538043, "chapter_id": 24538, "verse_number": "५-३-२३२-४४", "content_sanskrit": "एवमादिषु तीर्थेषु यत्पुण्यं जायते नृणाम् ।\nनर्मदाचरितं श्रुत्वा तत्पुण्यं सकलं लभेत्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004538044, "chapter_id": 24538, "verse_number": "५-३-२३२-४५", "content_sanskrit": "आदिमध्यावसानेषु नर्मदाचरितं शुभम् ।\nयः शृणोति नरो भक्त्या शृणुध्वं तत्फलं महत्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004538045, "chapter_id": 24538, "verse_number": "५-३-२३२-४६", "content_sanskrit": "समाप्य शिवसंस्थानं देवकन्यासमावृतः ।\nरुद्रस्यानुचरो भूत्वा शिवेन सह मोदते॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004538046, "chapter_id": 24538, "verse_number": "५-३-२३२-४७", "content_sanskrit": "धर्माख्यानमिदं पुण्यं सर्वाख्यानेष्वनुत्तमम् ।\nगृहेऽपि पठ्यते यस्य चतुर्वर्णस्य सत्तमाः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004538047, "chapter_id": 24538, "verse_number": "५-३-२३२-४८", "content_sanskrit": "धन्यं तस्य गृहं मन्ये गृहस्थं चापि तत्कुलम् ।\nपुस्तकं पूजयेद्यस्तु नर्मदाचरितस्य तु॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004538048, "chapter_id": 24538, "verse_number": "५-३-२३२-४९", "content_sanskrit": "नर्मदा पूजिता तेन भगवांश्च महेश्वरः ।\nवाचके पूजिते तद्वद्देवाश्च ऋषयोऽर्चिताः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004538049, "chapter_id": 24538, "verse_number": "५-३-२३२-५०", "content_sanskrit": "लेखयित्वा च सकलं रेवाचरितमुत्तमम् ।\nभूषणं सर्वशास्त्राणां यो ददाति द्विजन्मने॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004538050, "chapter_id": 24538, "verse_number": "५-३-२३२-५१", "content_sanskrit": "नर्मदासर्वतीर्थेषु स्नानदानेन यत्फलम् ।\nतत्फलं समवाप्नोति स नरो नात्र संशयः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004538051, "chapter_id": 24538, "verse_number": "५-३-२३२-५२", "content_sanskrit": "एतत्पुराणं रुद्रोक्तं महापुण्यफलप्रदम् ।\nस्वर्गदं पुत्रदं धन्यं यशस्यं कीर्त्तिवर्धनम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004538052, "chapter_id": 24538, "verse_number": "५-३-२३२-५३", "content_sanskrit": "धर्म्यमायुष्यमतुलं दुःखदुःस्वप्ननाशनम् ।\nपठतां शृण्वतां चापि सर्वकामार्थसिद्धिदम्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004538053, "chapter_id": 24538, "verse_number": "५-३-२३२-५४", "content_sanskrit": "यत्प्रदत्तमिदं पुण्यं पुराणं वाच्यते द्विजैः ।\nशिवलोके स्थितिस्तस्य पुराणाक्षरवत्सरी॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]