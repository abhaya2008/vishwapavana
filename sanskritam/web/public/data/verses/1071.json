[{"id": 2003647, "chapter_id": 1071, "verse_number": "१-७२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2003648, "chapter_id": 1071, "verse_number": "१-७२-१", "content_sanskrit": "कृतविद्ये कचे प्राप्ते हृष्टरूपा दिवौकसः।\nकचादधीत्य तां विद्यां कृतार्था भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2003649, "chapter_id": 1071, "verse_number": "१-७२-२", "content_sanskrit": "सर्व एव समागम्य शतक्रतुमथाब्रुवन्।\nकालस्ते विक्रमस्याद्य जहि शत्रून्पुरन्दर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2003650, "chapter_id": 1071, "verse_number": "१-७२-३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2003651, "chapter_id": 1071, "verse_number": "१-७२-३", "content_sanskrit": "एवमुक्तस्तु सहितैस्त्रिदशैर्मघवांस्तदा।\nतथेत्युक्त्वा प्रचक्राम सोऽपश्यत वने स्त्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2003652, "chapter_id": 1071, "verse_number": "१-७२-४", "content_sanskrit": "क्रीडन्तीनां तु कन्यानां वने चैत्ररथोपमे।\nवायुभूतः स वस्त्राणि सर्वाण्येव व्यमिश्रयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2003653, "chapter_id": 1071, "verse_number": "१-७२-५", "content_sanskrit": "ततो जलात्समुत्तीर्य कन्यास्ताः सहितास्तदा।\nवस्त्राणि जगृहुस्तानि यथाऽऽसन्नान्यनेकशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2003654, "chapter_id": 1071, "verse_number": "१-७२-६", "content_sanskrit": "तत्र वासो देवयानयाः शर्मिष्ठा जगृहे तदा।\nव्यतिमिश्रमजानन्ती दुहिता वृषपर्वणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2003655, "chapter_id": 1071, "verse_number": "१-७२-७", "content_sanskrit": "ततस्तयोर्मिथस्तत्र विरोधः समजायत।\nदेवयान्याश्च राजेन्द्र शर्मिष्ठायाश्च तत्कृते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2003656, "chapter_id": 1071, "verse_number": "१-७२-८x", "content_sanskrit": "देवयान्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2003657, "chapter_id": 1071, "verse_number": "१-७२-८", "content_sanskrit": "कस्माद्गृह्णासि मे वस्त्रं शिष्या भूत्वा ममासुरि।\nसमुदाचारहीनाया न ते साधु भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2003658, "chapter_id": 1071, "verse_number": "१-७२-९x", "content_sanskrit": "सर्मिष्ठोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2003659, "chapter_id": 1071, "verse_number": "१-७२-९", "content_sanskrit": "आसीनं च शयानं च पिता ते पितरं मम।\nस्तौतिबन्दीव चाभीक्ष्णं नीचैः स्थित्वा विनीतवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2003660, "chapter_id": 1071, "verse_number": "१-७२-१०", "content_sanskrit": "याचतस्त्वं हि दुहिता स्तुवतः प्रतिगृह्णतः।\nसुताहं स्तूयमानस्य ददतोऽप्रतिगृह्णतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2003661, "chapter_id": 1071, "verse_number": "१-७२-११", "content_sanskrit": "आदुन्वस्व विदुन्वस्व द्रुह्य कुप्यस्व याचकि।\nअनायुधा सायुधाया रिक्ता क्षुभ्यसि भिक्षुकि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2003662, "chapter_id": 1071, "verse_number": "१-७२-१२", "content_sanskrit": "लप्स्यसे प्रतियोद्धारं न हि त्वां गणयाम्यहम्।\nप्रतिकूलं वदसि चेदितःप्रभृति याचकि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2003663, "chapter_id": 1071, "verse_number": "१-७२-१३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2003664, "chapter_id": 1071, "verse_number": "१-७२-१३", "content_sanskrit": "समुच्छ्रयं देवयानीं गतां सक्तां च वाससि।\nशर्मिष्ठा प्राक्षिपत्कूपे ततः स्वपुरमागमत्।\nहतेयमिति विज्ञाय शर्मिष्ठा पापनिश्चया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2003665, "chapter_id": 1071, "verse_number": "१-७२-१४", "content_sanskrit": "अनवेक्ष्य ययौ वेश्म क्रोधवेगपरायणा।\nप्रविश्य स्वगृहं स्वस्था धर्ममासुरमास्थिता।\nअथ तं देशमभ्यागाद्ययातिर्नहुषात्मजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2003666, "chapter_id": 1071, "verse_number": "१-७२-१५", "content_sanskrit": "श्रान्तयुग्यः श्रान्तहयो मृगलिप्सुः पिपासितः।\nस नाहुषः प्रेक्षमाण उदपानं गतोदकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2003667, "chapter_id": 1071, "verse_number": "१-७२-१६", "content_sanskrit": "ददर्श राजा तां तत्र कन्यामग्निशिखामिव।\nतामपृच्छत्स दृष्ट्वैव कन्याममरवर्णिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2003668, "chapter_id": 1071, "verse_number": "१-७२-१७", "content_sanskrit": "सान्त्वयित्वा नृपश्रेष्ठः साम्ना परमवल्गुना।\nका त्वं ताम्रनखी श्यामा सुमृष्टमणिकुण्डला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2003669, "chapter_id": 1071, "verse_number": "१-७२-१८", "content_sanskrit": "दीर्घं ध्यायसि चात्यर्थं कस्माच्छ्वसिषि चातुरा।\nकथं च पतिताऽस्यस्मिन्कूपे वीरुत्तृणावृते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2003670, "chapter_id": 1071, "verse_number": "१-७२-१९", "content_sanskrit": "दुहिता चैव कस्य त्वं वद सत्यं सुमध्यमे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2003671, "chapter_id": 1071, "verse_number": "१-७२-२०x", "content_sanskrit": "देवयान्युवाच।\nयोऽसौ देवैर्हतान्दैत्यानुत्थापयति विद्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2003672, "chapter_id": 1071, "verse_number": "१-७२-२०", "content_sanskrit": "तस्य शुक्रस्य कन्याहं स मां नूनं न बुध्यते।\nएष मे दक्षिणो राजन्पाणिस्ताम्रनखाङ्गुलिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2003673, "chapter_id": 1071, "verse_number": "१-७२-२१", "content_sanskrit": "समुद्धर गृहीत्वा मां कुलीनस्त्वं हि मे मतः।\nजानामि हि त्वां संशान्तं वीर्यवन्तं यशस्विनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2003674, "chapter_id": 1071, "verse_number": "१-७२-२२", "content_sanskrit": "तस्मान्मां पतितामस्मात्कूपादुद्धर्तुमर्हसि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2003675, "chapter_id": 1071, "verse_number": "१-७२-२२x", "content_sanskrit": "वैशम्पायन उवाच।\nतामथो ब्राह्मणीं कन्यां विज्ञायनहुषात्मजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2003676, "chapter_id": 1071, "verse_number": "१-७२-२३", "content_sanskrit": "गृहीत्वा दक्षिणे पाणावुज्जहार ततोऽवटात्।\nउद्धृत्य चैनां तरसा तस्मात्कूपान्नराधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2003677, "chapter_id": 1071, "verse_number": "१-७२-२४x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2003678, "chapter_id": 1071, "verse_number": "१-७२-२४", "content_sanskrit": "गच्छ भद्रे यथाकामं न भयं विद्यते तव।\nइत्युच्यमाना नृपतिं देवयानीदमुत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2003679, "chapter_id": 1071, "verse_number": "१-७२-२५", "content_sanskrit": "उवाच मामुपादाय गच्छ शीघ्रं प्रियो हि मे।\nगृहीताहं त्वया पाणौ तस्माद्भर्ता भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2003680, "chapter_id": 1071, "verse_number": "१-७२-२६", "content_sanskrit": "इत्येवमुक्तो नृपतिराह क्षत्रकुलोद्भवः।\nत्वं भद्रे ब्राह्मणी तस्मान्मया नार्हसि सङ्गमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2003681, "chapter_id": 1071, "verse_number": "१-७२-२७", "content_sanskrit": "सर्वलोकगुरुः काव्यस्त्वं तस्य दुहिता शुभे।\nतस्मादपि भयं मेऽद्य ततः कल्याणि नार्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2003682, "chapter_id": 1071, "verse_number": "१-७२-२८x", "content_sanskrit": "देवयान्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2003683, "chapter_id": 1071, "verse_number": "१-७२-२८", "content_sanskrit": "यदि मद्वचनान्नाद्य मां नेच्छसि नराधिप।\nत्वामेव वरये पित्रा तस्माल्लप्स्यसि गच्छ हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2003684, "chapter_id": 1071, "verse_number": "१-७२-२९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2003685, "chapter_id": 1071, "verse_number": "१-७२-२९", "content_sanskrit": "आमन्त्रयित्वा सुश्रोणीं ययातिः स्वपुरं ययौ।\nगते तु नाहुषे तस्मिन्देवयान्यप्यनिन्दिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2003686, "chapter_id": 1071, "verse_number": "१-७२-३०", "content_sanskrit": "क्वचिद्गत्वा च रुदती वृक्षमाश्रित्य धिष्ठिता।\nततश्चिरायमाणायां दुहितर्यथ भार्गवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2003687, "chapter_id": 1071, "verse_number": "१-७२-३१", "content_sanskrit": "संस्मृत्योवाच धात्रीं तां दुहितुः स्नेहविक्लवः।\nधात्रि त्वमानय क्षिप्रं देवयानीं समुध्यमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2003688, "chapter_id": 1071, "verse_number": "१-७२-३२", "content_sanskrit": "इत्युक्तमात्रे सा धात्री त्वरिताऽऽनयितुं गता।\nयत्रयत्र सशीभिः सा गता पदममार्गत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2003689, "chapter_id": 1071, "verse_number": "१-७२-३३", "content_sanskrit": "सा ददर्श तथा दीनां श्रमार्तां रुदतीं स्थिताम्।\nवृत्तान्तं किमिदं भद्रे शीघ्रं वद पिताह्वयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2003690, "chapter_id": 1071, "verse_number": "१-७२-३४", "content_sanskrit": "एवमुक्ताह धात्रीं तां शर्मिष्ठावृजिनं कृतम्।\nउवाच शोकसंतप्ता घूर्णिकामागतां पुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2003691, "chapter_id": 1071, "verse_number": "१-७२-३५x", "content_sanskrit": "देवयान्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2003692, "chapter_id": 1071, "verse_number": "१-७२-३५", "content_sanskrit": "त्वरितं घूर्णिके गच्छ शीघ्रमाचक्ष्व मे पितुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2003693, "chapter_id": 1071, "verse_number": "१-७२-३६", "content_sanskrit": "नेदानीं संप्रवेक्ष्यामि नगरं वृषपर्वणः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2003694, "chapter_id": 1071, "verse_number": "१-७२-३६x", "content_sanskrit": "वैशम्पायन उवाच।\nसा तत्र त्वरितं गत्वा घूर्णिकाऽसुरमन्दिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2003695, "chapter_id": 1071, "verse_number": "१-७२-३७", "content_sanskrit": "दृष्ट्वा काव्यमुवाचेदं संभ्रमाविष्टचेतना।\nआचचक्षे महाप्राज्ञं देवयानीं वने हताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2003696, "chapter_id": 1071, "verse_number": "१-७२-३८", "content_sanskrit": "शर्मिष्ठया महाभाग दुहित्रा वृषपर्वणः।\nश्रुत्वा दुहितरं काव्यस्तत्र शर्मिष्ठया हताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2003697, "chapter_id": 1071, "verse_number": "१-७२-३९", "content_sanskrit": "त्वरया निर्ययौ दुःखान्मार्गमाणः सुतां वने।\nदृष्ट्वा दुहितरं काव्यो देवयानीं ततो वने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2003698, "chapter_id": 1071, "verse_number": "१-७२-४०", "content_sanskrit": "बाहुभ्यां संपरिष्वज्य दुःखितो वाक्यमब्रवीत्।\nआत्मदोषैर्नियच्छन्ति सर्वे दुःखसुखे जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2003699, "chapter_id": 1071, "verse_number": "१-७२-४१", "content_sanskrit": "मन्ये दुश्चरितं तेऽस्ति यस्येयं निष्कृतिः कृता।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2003700, "chapter_id": 1071, "verse_number": "१-७२-४१x", "content_sanskrit": "देवयान्युवाच।\nनिष्कृतिर्मेऽस्तु वा मास्तु शृणुष्वावहितो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2003701, "chapter_id": 1071, "verse_number": "१-७२-४२", "content_sanskrit": "शर्मिष्ठया यदुक्ताऽस्मि दुहित्रा वृषपर्वणः॥\nसत्यं किलैतत्सा प्राह दैत्यानामसि गायनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2003702, "chapter_id": 1071, "verse_number": "१-७२-४३", "content_sanskrit": "एवं हि मे कथयति शर्मिष्ठा वार्षपर्वणी।\nवचनं तीक्ष्णपरुषं क्रोधरक्तेक्षणा भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2003703, "chapter_id": 1071, "verse_number": "१-७२-४४", "content_sanskrit": "स्तुवतो दुहिता नित्यं याचतः प्रतिगृह्णतः।\nअहं तु स्तूयमानस्य ददतोऽप्रतिगृह्णतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2003704, "chapter_id": 1071, "verse_number": "१-७२-४५", "content_sanskrit": "इदं मामाह शर्मिष्ठा दुहिता वृषपर्वणः।\nक्रोधसंरक्तनयना दर्पपूर्णा पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2003705, "chapter_id": 1071, "verse_number": "१-७२-४६", "content_sanskrit": "यद्यह स्तुवतस्तात दुहिता प्रतिगृह्णतः।\nप्रसादयिष्ये शर्मिष्ठामित्युक्ता तु सखी मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2003706, "chapter_id": 1071, "verse_number": "१-७२-४७", "content_sanskrit": "उक्ताप्येवं भृशं मां सा निगृह्य विजने वने।\nकूपे प्रक्षेपयामास प्रक्षिप्य गृहमागमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2003707, "chapter_id": 1071, "verse_number": "१-७२-४८x", "content_sanskrit": "शुक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2003708, "chapter_id": 1071, "verse_number": "१-७२-४८", "content_sanskrit": "स्तुवतो दुहिता न त्वं याचतः प्रतिगृह्णतः।\nअस्तोतुः स्तूयमानस्य दुहिता देवयान्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2003709, "chapter_id": 1071, "verse_number": "१-७२-४९", "content_sanskrit": "वृषपर्वैव तद्वेद शक्रो राजा च नाहुषः।\nअचिन्त्यं ब्रह्म निर्द्वन्द्वमैश्वरं हि बलं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2003710, "chapter_id": 1071, "verse_number": "१-७२-५०", "content_sanskrit": "जानामि जीविनीं विद्यां लोकेस्मिञ्शाश्वतीं ध्रुवम्।\nमृतः संजीवते जन्तुर्यया कमललोचने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2003711, "chapter_id": 1071, "verse_number": "१-७२-५१", "content_sanskrit": "कत्थनं स्वगुणानां च कृत्वा तप्यति सज्जनः।\nततो वक्तुमशक्तोऽस्मित्वं मे जानासि यद्बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2003712, "chapter_id": 1071, "verse_number": "१-७२-५२", "content_sanskrit": "तसमादुत्तिष्ठ गच्छामः स्वगृहं कुलनन्दिनि।\nक्षमां कृत्वा विशालाक्षि क्षमासारा हि साधवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2003713, "chapter_id": 1071, "verse_number": "१-७२-५३", "content_sanskrit": "यच्च किंचित्सर्वगतं भूमौ वा यदि वा दिवि।\nतस्याहमीश्वरो नित्यं तुष्टेनोक्तः स्वयंभुवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2003714, "chapter_id": 1071, "verse_number": "१-७२-५४", "content_sanskrit": "अहं जलं विमुञ्चामि प्रजानां हितकाम्यया।\nपुष्णाम्यौषधयः सर्वा इति सत्यं ब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2003715, "chapter_id": 1071, "verse_number": "१-७२-५५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2003716, "chapter_id": 1071, "verse_number": "१-७२-५५", "content_sanskrit": "एवं विषादमापन्नां मन्युना संप्रपीडिताम्।\nवचनैर्मधुरैः श्लक्ष्णैः सान्त्वयामास तां पिता॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2003717, "chapter_id": 1071, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि द्विसप्ततितमोऽध्यायः॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]