[{"id": 2093320, "chapter_id": 2991, "verse_number": "१३-१२१-१", "content_sanskrit": "भीष्म उवाच।\nकदाचित्कामरूपिण्यो गावः स्त्रीवेषमाश्रिताः।\nह्रदे क्रीडन्ति संहृष्टा गायन्त्यः पुण्यलक्षणाः॥?", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2093321, "chapter_id": 2991, "verse_number": "१३-१२१-२", "content_sanskrit": "ददृशुस्तस्य गावो वै विस्मयोत्फुल्ललोचनाः।\nऊचुश्च का यूयमिति स्त्रियो मानुषया गिरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2093322, "chapter_id": 2991, "verse_number": "१३-१२१-३x", "content_sanskrit": "स्त्रिय ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2093323, "chapter_id": 2991, "verse_number": "१३-१२१-३", "content_sanskrit": "गाव एव वयं सर्वकर्मभिः शोभनैर्युताः।\nसर्वाः स्त्रीवेषधारिण्यो यथाकामं चरामेहे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2093324, "chapter_id": 2991, "verse_number": "१३-१२१-४x", "content_sanskrit": "गाव ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2093325, "chapter_id": 2991, "verse_number": "१३-१२१-४", "content_sanskrit": "गवां गावः परं दैवं गवां गावः परा गतिः।\nकथयध्वमिहास्माकं केन वः सुकृतां गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2093326, "chapter_id": 2991, "verse_number": "१३-१२१-५x", "content_sanskrit": "स्त्रिय ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2093327, "chapter_id": 2991, "verse_number": "१३-१२१-५", "content_sanskrit": "अस्माकं हविषा देवा ब्राह्मणास्तर्पितास्तथा।\nकव्येन पितरश्चैव हव्येनाग्निश्च तर्पितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2093328, "chapter_id": 2991, "verse_number": "१३-१२१-६", "content_sanskrit": "प्रजया च तथाऽस्माकं कृषिरभ्युद्धृता सदा।\nशकटैश्चापि संयुक्ता दशवाहशतेन वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2093329, "chapter_id": 2991, "verse_number": "१३-१२१-७", "content_sanskrit": "तदेतैः सुकृतैः स्फीतैर्वयं याश्चैव नः प्रजाः।\nगोलोकमनुसम्प्राप्ता यः परं कामगोचरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2093330, "chapter_id": 2991, "verse_number": "१३-१२१-८", "content_sanskrit": "यूयं तु सर्वा रोहिण्यः सप्रजाः सहपुङ्गवाः।\nअधोगामिन्य इत्येव पश्यामो दिव्यचक्षुषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2093331, "chapter_id": 2991, "verse_number": "१३-१२१-९x", "content_sanskrit": "गाव ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2093332, "chapter_id": 2991, "verse_number": "१३-१२१-९", "content_sanskrit": "एवं गवां परं दैवं गाव एव परायणम्।\nस्वपक्ष्यास्तारणीया वः शरणाय गता वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2093333, "chapter_id": 2991, "verse_number": "१३-१२१-१०", "content_sanskrit": "किमस्माभिः करणीयं वर्तितव्यं कथञ्चन।\nप्राप्नुयाम च गोलोकं भवाम न च गर्हिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2093334, "chapter_id": 2991, "verse_number": "१३-१२१-११x", "content_sanskrit": "स्त्रिय ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2093335, "chapter_id": 2991, "verse_number": "१३-१२१-११", "content_sanskrit": "वर्तते रन्तिदेवस्य सत्रं वर्षसहस्रकम्।\nतत्र तस्य नृपस्याशु पशुत्वमुपगच्छतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2093336, "chapter_id": 2991, "verse_number": "१३-१२१-१२", "content_sanskrit": "ततस्तस्योपयोगेन पशुत्वे यज्ञसंस्कृताः।\nगोलोकान्प्राप्स्यथ शुभांस्तेन पुण्येन संयुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2093337, "chapter_id": 2991, "verse_number": "१३-१२१-१३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2093338, "chapter_id": 2991, "verse_number": "१३-१२१-१३", "content_sanskrit": "एतत्तासां वचः श्रुत्वा गवां संहृष्टमानसाः।\nगमनाय मनश्चक्रुरौत्सुक्यं चागमन्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2093339, "chapter_id": 2991, "verse_number": "१३-१२१-१४", "content_sanskrit": "न हि नो भार्गवो दाता पशुत्वेनोपयोजनम्।\nयज्ञस्तस्य नरेन्द्रस्य वर्तते धर्मतस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2093340, "chapter_id": 2991, "verse_number": "१३-१२१-१५", "content_sanskrit": "वयं न चाननुज्ञाताः शक्ता गन्तुं कथञ्चन।\nअवोचन्नथ तत्रत्या भार्गवो वध्यतामयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2093341, "chapter_id": 2991, "verse_number": "१३-१२१-१६", "content_sanskrit": "एतत्सर्वा रोचयत न हि शक्यमतोऽन्यथा।\nलोकान्प्राप्तुं सहास्माभिर्निश्चयः क्रियतामयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2093342, "chapter_id": 2991, "verse_number": "१३-१२१-१७", "content_sanskrit": "न तु तासां समेतानां काचिद्धोरेण चक्षुषा।\nशक्नोति भार्गवं द्रष्टुं सत्कृतेनोपसंयुता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2093343, "chapter_id": 2991, "verse_number": "१३-१२१-१८", "content_sanskrit": "अथ पद्मसवर्णाभा भास्करांशुसमप्रभाः।\nजपालोहितताम्राक्ष्यो निर्मांसकठिनाननाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2093344, "chapter_id": 2991, "verse_number": "१३-१२१-१९", "content_sanskrit": "रोहिण्यः कपिलाः प्राहुः सर्वासां वै समक्षतः।\nमेघस्तनितनिर्घोषास्तेजोभिरभिरञ्चिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2093345, "chapter_id": 2991, "verse_number": "१३-१२१-२०", "content_sanskrit": "वयं हि तं वधिष्यामः सुमित्रं नात्रं संशयः।\nसुकृतं पृष्ठतः कृत्वा किं नः श्रेयो विधास्यथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2093346, "chapter_id": 2991, "verse_number": "१३-१२१-२१x", "content_sanskrit": "गाव ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2093347, "chapter_id": 2991, "verse_number": "१३-१२१-२१", "content_sanskrit": "कपिलाः सर्ववर्णेषु प्रधानत्वमवाप्स्यथ।\nगवां शतफला चैकां दत्त्वा फलमवाप्स्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2093348, "chapter_id": 2991, "verse_number": "१३-१२१-२२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2093349, "chapter_id": 2991, "verse_number": "१३-१२१-२२", "content_sanskrit": "एतद्गवां वचः श्रुत्वा कपिला हृष्टमानसाः।\nचक्रुः सर्वा भार्गवस्य सुमित्रस्य वधे मतिम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2093350, "chapter_id": 2991, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकविंशत्यधिकशततमोऽध्यायः॥ १२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]