[{"id": 2082386, "chapter_id": 2750, "verse_number": "१२-२५५-०x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2082387, "chapter_id": 2750, "verse_number": "१२-२५५-१", "content_sanskrit": "सृजते त्रिगुणान्सत्वं क्षेत्रज्ञस्त्वधितिष्ठति।\nगुणान्विक्रियते सर्वानुदासीनवदीश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2082388, "chapter_id": 2750, "verse_number": "१२-२५५-२", "content_sanskrit": "स्वभावयुक्तं तत्सत्वं यदिमान्सृजते गुणान्।\nऊर्णनाभिर्यथा सूत्रं सृजते तन्तुवद्गुणान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2082389, "chapter_id": 2750, "verse_number": "१२-२५५-३", "content_sanskrit": "प्रध्वस्ता न निवर्तन्ते प्रवृत्तिर्नोपलभ्यते।\nएवमेके व्यवस्यन्ति निवृत्तिरिति चापरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2082390, "chapter_id": 2750, "verse_number": "१२-२५५-४", "content_sanskrit": "उभयं संप्रधार्यैतदध्यवस्येद्यथामति।\nअनेनैव विधानेन भवेद्गर्भशयो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2082391, "chapter_id": 2750, "verse_number": "१२-२५५-५", "content_sanskrit": "अनादिनिधनं नित्यं तं बुद्ध्वा विचरेन्नरः।\nअक्रुध्यन्नप्रहृष्यंश्च नित्यं विगतमत्सरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2082392, "chapter_id": 2750, "verse_number": "१२-२५५-६", "content_sanskrit": "इत्येवं हृदयग्रन्थिं बुद्धिचिन्तामयं दृढम्।\nअतीत्य सुखमासीत अशोचंश्छिन्नसंशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2082393, "chapter_id": 2750, "verse_number": "१२-२५५-७", "content_sanskrit": "ताम्येयुः प्रच्युताः पृथ्व्यां यथा पूर्णां नदीं नराः।\nअवगाढा ह्यविद्वांसो विद्धि लोकमिमं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2082394, "chapter_id": 2750, "verse_number": "१२-२५५-८", "content_sanskrit": "न तु ताम्यति वै विद्वान्स्थले चरति तत्त्ववित्।\nएवं यो विन्दतेऽऽत्मानं केवलं ज्ञानमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2082395, "chapter_id": 2750, "verse_number": "१२-२५५-९", "content_sanskrit": "एवं बुद्ध्वा नरः सर्वं भूतानामागतिं गतिम्।\nसमवेक्ष्य च वैषम्यं लभते शममुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2082396, "chapter_id": 2750, "verse_number": "१२-२५५-१०", "content_sanskrit": "एतद्वै जन्मसामर्थ्यं ब्राह्मणस्य विशेषतः।\nआत्मज्ञानं शमश्चैव पर्याप्तं तत्परायणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2082397, "chapter_id": 2750, "verse_number": "१२-२५५-११", "content_sanskrit": "एतद्बुद्ध्वा भवेद्बुद्धः किमन्यद्बुद्धलक्षणम्।\nविज्ञायैतद्विमुच्यन्ते कृतकृत्या मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2082398, "chapter_id": 2750, "verse_number": "१२-२५५-१२", "content_sanskrit": "न भवति विदुषां महद्भयं\nयदविदुषां सुमहद्भयं परत्र।\nन हि गतिरधिकाऽस्ति कस्यचि\nद्भवति हि या विदुषः सनातनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2082399, "chapter_id": 2750, "verse_number": "१२-२५५-१३", "content_sanskrit": "लोकमातुरमसूयते जन\nस्तत्तदेव च निरीक्ष्य शोचते।\nतत्र पश्य कुशलानशोचतो\nये विदुस्तदुभयं कृताकृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2082400, "chapter_id": 2750, "verse_number": "१२-२५५-१४", "content_sanskrit": "यत्करोत्यनभिसन्धिपूर्वकं\nतच्च निर्णुदति ---\nन प्रियं तदुभयं न चाप्रिय\nतस्य तज्जनयतीह कुर्वतः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2082401, "chapter_id": 2750, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि पञ्चपञ्चाशदधिकद्विशततमोऽध्यायः॥ २५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]