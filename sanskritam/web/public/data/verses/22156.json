[{"id": 7002156000, "chapter_id": 22156, "verse_number": "२०१-१", "content_sanskrit": "अग्निरुवाच ।\nनवव्यूहार्चनं वक्ष्ये नारदाय हरीरितं ।\nमण्डलेऽब्जेऽर्चयेन्मध्ये अवीजं वासुदेवकं ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002156001, "chapter_id": 22156, "verse_number": "२०१-२", "content_sanskrit": "आवीजञ्च सङ्कर्षणं प्रद्युम्नं च दक्षिणे ।\nअः अनुरुद्धं नैऋते ॐ नारायणमप्सु च ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002156002, "chapter_id": 22156, "verse_number": "२०१-३", "content_sanskrit": "तत्सद्ब्रह्माणमनिले हुं विष्णुं क्षौं नृसिंहकं ।\nउत्तरे भूर्वराहञ्च ईशे द्वारि च पश्चिमे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002156003, "chapter_id": 22156, "verse_number": "२०१-४", "content_sanskrit": "कं टं सं शं गरुत्मन्तं पूर्ववक्त्रञ्च दक्षिणे ।\nखं छं वं हुं फडिति च खं ठं फं शं गदां विधौ ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002156004, "chapter_id": 22156, "verse_number": "२०१-५", "content_sanskrit": "बं णं मं क्षं कोणेशञ्च घं दं भं हं श्रियं यजेत् ।\nदक्षिणे चोत्तरे पुष्टिं गं डं बं शं स्ववीजकं ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002156005, "chapter_id": 22156, "verse_number": "२०१-६", "content_sanskrit": "पीठस्य पश्चिमे धं वं वनमालाञ्च पश्चिमे ।\nश्रीवत्सं चैव सं हं लं छं तं यं कौस्तुभं जले ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002156006, "chapter_id": 22156, "verse_number": "२०१-७", "content_sanskrit": "दशमाङ्गक्रमाद्विष्णोर्नमोऽनन्तमधोऽर्चयेत् ।\nदशाङ्गादिमहेन्द्रादीन् पूर्वादौ चतुरो घटान् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002156007, "chapter_id": 22156, "verse_number": "२०१-८", "content_sanskrit": "तोरणानि वितानं च अग्न्यनिलेन्दुवीजकैः ।\nमण्डलानि क्रमाद्ध्यात्वा तनुं वन्द्य ततः प्लवेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002156008, "chapter_id": 22156, "verse_number": "२०१-९", "content_sanskrit": "अम्वरस्थं ततो ध्यात्वा सूक्ष्मरूपमथात्मनः ।\nसितामृते निमग्नञ्च चन्द्रविम्वात्स्रुतेन च ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002156009, "chapter_id": 22156, "verse_number": "२०१-१०", "content_sanskrit": "तदेव चात्मनो वीजममृतं प्लवसंस्कृतं ।\nउत्पाद्यमानं पुरुषमात्मानमुपकल्पयेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002156010, "chapter_id": 22156, "verse_number": "२०१-११", "content_sanskrit": "उत्पन्नोऽस्मि स्वयं विष्णुर्वीजं द्वादशकं न्यसेत् ।\nहृच्छिरस्तु शिखा चैव कवचं चास्त्रमेव च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002156011, "chapter_id": 22156, "verse_number": "२०१-१२", "content_sanskrit": "वक्षोमूर्धशिखापृष्ठलोचनेषु न्यसेत पुनः ।\nअस्त्रं करद्वये न्यस्य ततो दिव्यतनुर्भवेत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002156012, "chapter_id": 22156, "verse_number": "२०१-१३", "content_sanskrit": "यथात्मनि तथा देवे शिष्यदेहे न्यसेत्तथा ।\nअनिर्माल्या स्मृता पूजा यद्धरेः पूजनं हृदि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002156013, "chapter_id": 22156, "verse_number": "२०१-१४", "content_sanskrit": "सनिर्माल्या मण्डलादौ बद्धनेत्राश्च शिष्यकाः ।\nपुष्पं क्षिपेयुर्यन्मूर्तौ तस्य तन्नाम कारयेत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002156014, "chapter_id": 22156, "verse_number": "२०१-१५", "content_sanskrit": "निवेश्य वामतः शिष्यांस्तिलव्रीहिघृतं हुनेत् ।\nशतमष्टोत्तरं हुत्वा सहस्रं कायशुद्धये ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002156015, "chapter_id": 22156, "verse_number": "२०१-१६", "content_sanskrit": "नवव्यूहस्य मूर्तीनामङ्गानां च शताधिकं ।\nपूऋणान्दत्त्वा दीक्षयेत्तान् गुरुः पूज्यश्च तैर्धनैः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]