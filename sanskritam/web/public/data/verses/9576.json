[{"id": 5000576000, "chapter_id": 9576, "verse_number": "७-४१-१", "content_sanskrit": "विसृज्य च महाबाहुर्ऋक्षवानरराक्षसान् ।\nभ्रातृभिः सहितो रामः प्रमुमोद सुखं सुखी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000576001, "chapter_id": 9576, "verse_number": "७-४१-२", "content_sanskrit": "अथापराह्णसमये भ्रातृभिः सह राघवः ।\nशुश्राव मधुरां वाणीमन्तरिक्षात् प्रभाषिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000576002, "chapter_id": 9576, "verse_number": "७-४१-३", "content_sanskrit": "सौम्य राम निरीक्षस्व सौम्येन वदनेन माम् ।\nकुबेरभवनात्प्राप्तं विद्धि मां पुष्पकं प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000576003, "chapter_id": 9576, "verse_number": "७-४१-४", "content_sanskrit": "तव शासनमाज्ञाय गतो ऽस्मि भवनं प्रति ।\nउपस्थातुं नरश्रेष्ठ स च मां प्रत्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000576004, "chapter_id": 9576, "verse_number": "७-४१-५", "content_sanskrit": "निर्जितस्त्वं नरेन्द्रेण राघवेण महात्मना ।\nनिहत्य युधि दुर्धर्षं रावणं राक्षसेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000576005, "chapter_id": 9576, "verse_number": "७-४१-६", "content_sanskrit": "ममापि परमा प्रीतर्हते तस्मिन्दुरात्मनि ।\nरावणे सगणे चैव सपुत्रे सहबान्धवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000576006, "chapter_id": 9576, "verse_number": "७-४१-७", "content_sanskrit": "स त्वं रामेण लङ्कायां निर्जितः परमात्मना ।\nवह सौम्य तमेव त्वमहमाज्ञापयामि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000576007, "chapter_id": 9576, "verse_number": "७-४१-८", "content_sanskrit": "परमो ह्येष मे कामो यत्त्वं राघवनन्दनम् ।\nवहेर्लोकस्य संयानं गच्छस्व विगतज्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000576008, "chapter_id": 9576, "verse_number": "७-४१-९", "content_sanskrit": "सो ऽहं शासनमाज्ञाय धनदस्य महात्मनः ।\nत्वत्सकाशमनुप्राप्तो निर्विशङ्कः प्रतीक्ष माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000576009, "chapter_id": 9576, "verse_number": "७-४१-१०", "content_sanskrit": "अदृष्यः सर्वभूतानां सर्वेषां धनदाज्ञया ।\nचराम्यहं प्रभावेण तवाज्ञां परिपालयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000576010, "chapter_id": 9576, "verse_number": "७-४१-११", "content_sanskrit": "एवमुक्तस्तदा रामः पुष्पकेण महाबलः ।\nउवाच पुष्पकं दृष्ट्वा विमानं पुनरागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000576011, "chapter_id": 9576, "verse_number": "७-४१-१२", "content_sanskrit": "यद्येवं स्वागतं ते ऽस्तु विमानवर पुष्पक ।\nआनुकूल्याद्धनेशस्य वृत्तदोषो न नो भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000576012, "chapter_id": 9576, "verse_number": "७-४१-१३", "content_sanskrit": "लाजैश्चैव तथा पुष्पैर्धूपैश्चैव सुगन्धिभिः ।\nपूजयित्वा महाबाहू राघवः पुष्पकं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000576013, "chapter_id": 9576, "verse_number": "७-४१-१४", "content_sanskrit": "गम्यतामिति चोवाच आगच्छ त्वं स्मरे यदा ।\nसिद्धानां च गतौ सौम्य मा विषादेन योजय ।\nप्रतिघातश्च ते मा भूद्यथेष्टं गच्छतो दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000576014, "chapter_id": 9576, "verse_number": "७-४१-१५", "content_sanskrit": "एवमस्त्विति रामेण पूजयित्वा विसर्जितम् ।\nअभिप्रेतां दिशं तस्मात्प्रायात्तत्पुष्पकं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000576015, "chapter_id": 9576, "verse_number": "७-४१-१६", "content_sanskrit": "एवमन्तर्हिते तस्मिन्पुष्पके सुकृतात्मनि ।\nभरतः प्राञ्जलिर्वाक्यमुवाच रघुनन्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000576016, "chapter_id": 9576, "verse_number": "७-४१-१७", "content_sanskrit": "विविधात्मनि दृश्यन्ते त्वयि वीर प्रशासति ।\nअमानुषाणां सत्त्वानां व्याहृतानि मुहुर्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000576017, "chapter_id": 9576, "verse_number": "७-४१-१८", "content_sanskrit": "अनामयश्च सत्वानां साग्रो मासो गतो ह्ययम् ।\nजीर्णानामपि सत्त्वानां मृत्युर्नायाति राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000576018, "chapter_id": 9576, "verse_number": "७-४१-१९", "content_sanskrit": "अरोगप्रसवा नार्यो वपुष्मन्तो हि मानवाः ।\nहर्षश्चाभ्यधिको राजञ्जनस्य पुरवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000576019, "chapter_id": 9576, "verse_number": "७-४१-२०", "content_sanskrit": "काले वर्षति पर्जन्यः पातयन्नमृतं पयः ।\nवाताश्चापि प्रवान्त्येते स्पर्शयुक्ताः सुखाः शिवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000576020, "chapter_id": 9576, "verse_number": "७-४१-२१", "content_sanskrit": "ईदृशो ऽनश्वरो राजा भवेदिति नरेश्वरः ।\nकथयन्ति पुरे राजन्पौरजानपदास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000576021, "chapter_id": 9576, "verse_number": "७-४१-२२", "content_sanskrit": "एता वाचः सुमधुरा भरतेन समीरिताः ।\nश्रुत्वा रामो मुदा युक्तो बभूव नृपसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000576022, "chapter_id": 9576, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे एकचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]