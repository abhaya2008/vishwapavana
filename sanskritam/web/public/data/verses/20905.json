[{"id": 7000905000, "chapter_id": 20905, "verse_number": "६-२४८-१", "content_sanskrit": "रुद्र उवाच ।\nअथ कृष्णस्तु रामेण रुक्मिण्या दारुकेण च ।\nदिव्यं स्यंदनमारुह्य ययौ तूर्णं स्वमालयम् ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000905001, "chapter_id": 20905, "verse_number": "६-२४८-२", "content_sanskrit": "ततः प्रविश्य नगरीं द्वारकां देवकीसुतः ।\nशुभेह्रि शुभलग्ने वै वेदोक्तविधिना हरिः ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000905002, "chapter_id": 20905, "verse_number": "६-२४८-३", "content_sanskrit": "उपयेमे नृपसुतां रुक्मिणीं रुक्मभूषिताम् ।\nतस्मिन्नुद्वाहसमये देवदुंदुभयो दिवि ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000905003, "chapter_id": 20905, "verse_number": "६-२४८-४", "content_sanskrit": "विनेदुः पुष्पवर्षाणि ववृषुः सुरसत्तमाः ।\nवसुदेवोग्रसेनौ च तथाक्रूरो यदूत्तमः ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000905004, "chapter_id": 20905, "verse_number": "६-२४८-५", "content_sanskrit": "बलभद्रो महातेजा ये चान्ये यदुपुंगवाः ।\nचक्रुः कृष्णस्य रुक्मिण्या विवाहं सुसुखं यथा ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000905005, "chapter_id": 20905, "verse_number": "६-२४८-६", "content_sanskrit": "नंदगोपोथ गोपालैर्गोपवृंदैः समागतः ।\nस्वलंकृताभिर्योषाभिर्यशोदा च समागता ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000905006, "chapter_id": 20905, "verse_number": "६-२४८-७", "content_sanskrit": "वसुदेवस्त्रियः सर्वा देवकीप्रमुखास्तथा ।\nरेवती रोहिणी देवी याश्चान्याः पुरयोषितः ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000905007, "chapter_id": 20905, "verse_number": "६-२४८-८", "content_sanskrit": "सर्वाण्युद्वाहकर्माणि चक्रुर्हर्षसमन्विताः ।\nसुराणामर्चनं प्रीत्या कर्त्तव्यं तत्र देवकी ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000905008, "chapter_id": 20905, "verse_number": "६-२४८-९", "content_sanskrit": "वृद्धाभिर्नृपयोषिद्भिश्चकार विधिना तदा ।\nसर्वमौद्वाहिकं कर्म उत्सवं हि द्विजोत्तमैः ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000905009, "chapter_id": 20905, "verse_number": "६-२४८-१०", "content_sanskrit": "ब्राह्मणान्भोजयामास वस्त्रैराभरणैः शुभैः ।\nउग्रसेनादयस्तत्र राजानश्च सुपूजिताः ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000905010, "chapter_id": 20905, "verse_number": "६-२४८-११", "content_sanskrit": "नंदगोपादयो गोपा यशोदाद्याश्च योषितः ।\nबहुभिः स्वर्णरत्नाद्यैर्वासोभिः सविभूषणैः ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000905011, "chapter_id": 20905, "verse_number": "६-२४८-१२", "content_sanskrit": "पूजिताः संप्रहृष्टास्ते तद्विवाहमहोत्सवे ।\nतौ दंपती समाश्लिष्य प्रणतौ जातवेदसम् ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000905012, "chapter_id": 20905, "verse_number": "६-२४८-१३", "content_sanskrit": "वेदविद्भिर्विप्रमुख्यैराशीर्भिरभिनंदितौ ।\nतस्यां विवाहवेद्यां तु शुशुभाते वधूवरौ ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000905013, "chapter_id": 20905, "verse_number": "६-२४८-१४", "content_sanskrit": "ब्राह्मणेभ्योऽथ वृद्धेभ्यो राजन्यः सह भार्य्यया ।\nववंदे देवकीपुत्रो ज्येष्ठस्य भ्रातुरेव च ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000905014, "chapter_id": 20905, "verse_number": "६-२४८-१५", "content_sanskrit": "एवमौद्वाहिकं सर्वं निर्वर्त्य मधुसूदनः ।\nव्यसर्जयन्नृपान्सर्वान्ये च तत्र समागताः ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000905015, "chapter_id": 20905, "verse_number": "६-२४८-१६", "content_sanskrit": "प्रस्थिता हरिणा तत्र पूजिता नृपपुंगवाः ।\nब्राह्मणाः सुमहात्मानो निर्ययुः स्वकमालयम् ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000905016, "chapter_id": 20905, "verse_number": "६-२४८-१७", "content_sanskrit": "रुक्मिण्या सह धर्मात्मा देवकीनंदनोऽव्ययः ।\nउवास सुसुखेनैव दिव्यहर्म्यतले शुभे ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000905017, "chapter_id": 20905, "verse_number": "६-२४८-१८", "content_sanskrit": "तया वै रमयामास नारायण इव श्रिया ।\nसंस्तूयमानो मुनिभिर्दिवि देवगणैरपि ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000905018, "chapter_id": 20905, "verse_number": "६-२४८-१९", "content_sanskrit": "अहन्यहनि हृष्टात्मा सुखेनैव जनार्दनः ।\nअथोवास सुशोभायां द्वारवत्यां सनातनः ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]