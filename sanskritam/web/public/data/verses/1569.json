[{"id": 2026573, "chapter_id": 1569, "verse_number": "३-२०७-०x", "content_sanskrit": "मर्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2026574, "chapter_id": 1569, "verse_number": "३-२०७-१", "content_sanskrit": "धुन्धुर्नाम महाराज तयोः पुत्रो महाद्युतिः।\nस तपोऽतप्यत महन्महावीर्यपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2026575, "chapter_id": 1569, "verse_number": "३-२०७-२", "content_sanskrit": "अतिष्ठदेकपादेन कृशो धमनिसंततः।\nतस्मै ब्रह्मा ददौ प्रीतो वरं वव्रे स च प्रभुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2026576, "chapter_id": 1569, "verse_number": "३-२०७-३", "content_sanskrit": "देवदानवयक्षाणां सर्पगन्धर्वरक्षसाम्।\nअवध्योऽहं भवेयं वै वर एष वृतो मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2026577, "chapter_id": 1569, "verse_number": "३-२०७-४", "content_sanskrit": "एवं भवतु गच्छेति तमुवाच पितामहः।\nस एवमुक्तस्तत्पादौ मूर्ध्ना स्पृष्ट्वा जगाम ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2026578, "chapter_id": 1569, "verse_number": "३-२०७-५", "content_sanskrit": "सतु धुन्धुर्वरं लब्ध्वा महवीर्यपराक्रमः।\nअनुस्मरन्पितृवधं द्रुतं विष्णुमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2026579, "chapter_id": 1569, "verse_number": "३-२०७-६", "content_sanskrit": "सतु देवान्सगन्धर्वाञ्जित्वा धुन्धुरमर्षणः।\nबबाध सर्वानसकृद्विष्णुं देवांश्च वै भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2026580, "chapter_id": 1569, "verse_number": "३-२०७-७", "content_sanskrit": "समुद्रवालुकापूर्णे उज्जानक इति स्मृते।\nआगम्य च स दुष्टात्मा तं देशं भरतर्षभ।\nबाधतेस्म परं शक्त्या तमुदङ्काश्रमं विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2026581, "chapter_id": 1569, "verse_number": "३-२०७-८", "content_sanskrit": "अन्तर्भूमिगतस्तत्र वालुकान्तर्हितस्तथा।\nमधुकैटभयोः पुत्रो धुन्धुर्भीमपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2026582, "chapter_id": 1569, "verse_number": "३-२०७-९", "content_sanskrit": "शेते लोकविनाशाय तपोबलमुपाश्रितः।\nउदङ्कस्याश्रमाभ्याशे निःश्वसन्पावकार्चिषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2026583, "chapter_id": 1569, "verse_number": "३-२०७-१०", "content_sanskrit": "एतस्मिन्नेव काले तु राजा सबलवाहनः।\nकुवलाश्वो नरपतिरन्वितो बलशालिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2026584, "chapter_id": 1569, "verse_number": "३-२०७-११", "content_sanskrit": "सहस्रैरेकविंशत्या पुत्राणामरिमर्दनः।\nप्रायादुदङ्कसहितो धुन्धोस्तस्य वधाय वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2026585, "chapter_id": 1569, "verse_number": "३-२०७-१२", "content_sanskrit": "तमाविशत्ततो विष्णुर्भगवांस्तेजसा प्रभुः।\nउदङ्कस् नियोगेन लोकानां हितकाम्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2026586, "chapter_id": 1569, "verse_number": "३-२०७-१३", "content_sanskrit": "तस्मिन्प्रयाते दुर्धर्षे दिवि शब्दो महानभूत्।\nएष श्रीमान्नृपसुतो धुन्धुमारो भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2026587, "chapter_id": 1569, "verse_number": "३-२०७-१४", "content_sanskrit": "दिव्यैश्च पुष्पैस्तं देवाः समन्तात्पर्यवाकिरन्।\nदेवदुन्दुभयश्चापि नेदुः स्वयमनीरिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2026588, "chapter_id": 1569, "verse_number": "३-२०७-१५", "content_sanskrit": "शीतश्च वायुः प्रववौ प्रयाणे तस्य धीमतः।\nविपांसुलां महीं कुर्वन्ववर्ष च सुरेश्वरः।\n`प्रदक्षिणाश्चाप्यभवन्वन्यास्तं समृगद्विजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2026589, "chapter_id": 1569, "verse_number": "३-२०७-१६", "content_sanskrit": "अन्तरिक्षे विमानानि देवतानां युधिष्ठिर।\nतत्रैव समदृश्यन्त धुन्धुर्यत्र महासुरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2026590, "chapter_id": 1569, "verse_number": "३-२०७-१७", "content_sanskrit": "कुवलाश्वस्य धुन्योश्च युद्धकौतूहलान्विताः।\nदेवगन्धर्वसहिताः समवैक्षन्महर्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2026591, "chapter_id": 1569, "verse_number": "३-२०७-१८", "content_sanskrit": "नारायणेन कौरव्य तेजसाऽऽप्यायितस्तदा।\nस गतो नृपतिः क्षिप्रं पुत्रैस्तैः सर्वतो दिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2026592, "chapter_id": 1569, "verse_number": "३-२०७-१९", "content_sanskrit": "अर्णवं स्वानयामास कुवलाश्वो महीपतिः।\n`हितार्तं सर्वलोकानामुदङ्कस्य वशे स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2026593, "chapter_id": 1569, "verse_number": "३-२०७-२०", "content_sanskrit": "कुवलाश्वस् पुत्रैश्च तस्मिन्वै वालुकार्णवे।\nसप्तभिर्दिवसैः स्वात्वा दृष्टो धुन्धुर्महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2026594, "chapter_id": 1569, "verse_number": "३-२०७-२१", "content_sanskrit": "आसीद्धोरं वपुस्तस्य वालुकान्तर्हितं महत्।\nदीप्यमानं यथा सूर्यस्तेजसा भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2026595, "chapter_id": 1569, "verse_number": "३-२०७-२२", "content_sanskrit": "ततो धुन्धुर्महाराज दिशमावृत्य पश्चिमाम्।\nसुप्तोऽभूद्राजशार्दूल कालानलसमद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2026596, "chapter_id": 1569, "verse_number": "३-२०७-२३", "content_sanskrit": "कुवलाश्वस्य पुत्रैस्तु सर्वतः परिवारितः।\nअभिद्रुतः शरैस्तीक्ष्णैर्गदाभिर्मुसलैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2026597, "chapter_id": 1569, "verse_number": "३-२०७-२४", "content_sanskrit": "प्टसैः परिधैः प्रासैः खङ्गैश् विमलैः शितैः।\nसवध्यमानः संक्रुद्धः समुत्तस्थौ महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2026598, "chapter_id": 1569, "verse_number": "३-२०७-२५", "content_sanskrit": "क्रुद्धश्चाभक्षयत्तेषां शस्त्राणि विविधानि च।\nआस्याद्वमन्पावकं स संवर्तकसमं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2026599, "chapter_id": 1569, "verse_number": "३-२०७-२६", "content_sanskrit": "तान्सर्वान्नृपतेः पुत्रानदहत्स्वेन तेजसा।\nमुखजेनाग्निना क्रुद्धो लोकानुद्वर्तयन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2026600, "chapter_id": 1569, "verse_number": "३-२०७-२७", "content_sanskrit": "क्षणेन राजशार्दूल पुरेव कपिलः प्रभुः।\nसगरस्यात्मजान्क्रुद्धस्तदद्भुतमिवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2026601, "chapter_id": 1569, "verse_number": "३-२०७-२८", "content_sanskrit": "तेषु क्रोधाग्निदग्धेषु तदा भरतसत्तम।\nतं प्रबुद्धं महात्मानं कुम्भकर्णमिवापरम्।\nआससाद महातेजाः कुवलाश्वो महीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2026602, "chapter_id": 1569, "verse_number": "३-२०७-२९", "content_sanskrit": "तस्य वारिमहाराज सुस्राव बहु देहतः।\nतत्तदापीयतेतेजो राज्ञा वारिमयं नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2026603, "chapter_id": 1569, "verse_number": "३-२०७-३०", "content_sanskrit": "योगी योगेन सृष्टं स समयित्वा च वारिणा।\nब्रह्मास्त्रेण ततो राजा दैत्यंक्रूरपराक्रमम्।\nददाह भरतश्रेष्ठ सर्वलोकभवाय वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2026604, "chapter_id": 1569, "verse_number": "३-२०७-३१", "content_sanskrit": "सोऽस्त्रेण दग्ध्वा राजर्षिः कुवलाश्वो महासुरम्।\nसुरशत्रुममित्रघ्नस्त्रैलोक्येश इवापरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2026605, "chapter_id": 1569, "verse_number": "३-२०७-३२", "content_sanskrit": "धुन्धोर्वधात्तदा राजा कुवलाश्वो महामनाः।\nधुन्धुमार इतिख्यातो नाम्ना समभवत्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2026606, "chapter_id": 1569, "verse_number": "३-२०७-३३", "content_sanskrit": "प्रीतैश्च त्रेदशैः सर्वैर्महर्षिमसितैस्तदा।\nपरं वृणीष्वत्युक्तः स प्राञ्जलिः प्रणतस्तदा।\nअतीव मुदितो राजन्निदंवचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2026607, "chapter_id": 1569, "verse_number": "३-२०७-३४", "content_sanskrit": "दद्यां वित्तं द्विजाग्र्येभ्यः शत्रूणां चापि दुर्जयः।\nसख्यं च विष्णुना मे स्याद्भूतेष्वद्रोह एव च।\nधर्मे रतिश् सततं स्वर्गे वासस्तथाऽक्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2026608, "chapter_id": 1569, "verse_number": "३-२०७-३५", "content_sanskrit": "तथाऽस्त्विति ततो देवैः प्रीतैरुक्तः स पार्थिवः।\nऋषिभिश्च सगन्धर्वैरुदङ्केन च धीमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2026609, "chapter_id": 1569, "verse_number": "३-२०७-३६", "content_sanskrit": "संभाष्य चैनं विविधैराशीर्वादैस्ततो नृषम्।\nदेवा महर्षयश्चापि स्वानि स्तानानि भेजिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2026610, "chapter_id": 1569, "verse_number": "३-२०७-३७", "content_sanskrit": "तस्य पुत्रास्त्रयः शिष्टा युधिष्ठिर तदाऽभवन्।\nदृढाश्वः कपिलाश्वश्च भद्राश्वश्चैव भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2026611, "chapter_id": 1569, "verse_number": "३-२०७-३८", "content_sanskrit": "तेभ्यः परम्परा राजन्निक्ष्वाकूणां महात्मनाम्।\n[वंशस्य सुमहाभाग राज्ञाममिततेजसाम्] ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2026612, "chapter_id": 1569, "verse_number": "३-२०७-३९", "content_sanskrit": "एवंसं निहतस्तेन कुवलाश्वेन सत्तम।\nधुन्धुर्नाम महादैत्यो मधुकैटभयोः सुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2026613, "chapter_id": 1569, "verse_number": "३-२०७-४०", "content_sanskrit": "कुवलाश्वश्च नृपतिर्धुन्धुमार इति स्मृतः।\nनाम्ना च गुणयुक्तेन तदाप्रभृति सोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2026614, "chapter_id": 1569, "verse_number": "३-२०७-४१", "content_sanskrit": "एतत्ते सर्वमाख्यातं यन्मां त्वं परिपृच्छसि।\nधौन्धुमारमुपाख्यानं प्रथितं यस्य कर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2026615, "chapter_id": 1569, "verse_number": "३-२०७-४२", "content_sanskrit": "इदं तु पुण्यमाख्यानं विष्णोः समनुकीर्तनम्।\nशृणुयाद्यः स धर्मात्मा पुत्रवांश्च भवेन्नरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2026616, "chapter_id": 1569, "verse_number": "३-२०७-४३", "content_sanskrit": "आयुष्मान्भूतिमांश्चैव श्रुत्वा भवति पर्वसु।\nन च व्याधिभंयकिंचित्प्राप्नोति विगतज्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2026617, "chapter_id": 1569, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि गार्कण्डेयसमास्यापर्वणि सप्ताधिकद्विशततमोऽध्यायः ॥ २०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]