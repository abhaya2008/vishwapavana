[{"id": 2076704, "chapter_id": 2628, "verse_number": "१२-१३३-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2076705, "chapter_id": 2628, "verse_number": "१२-१३३-१", "content_sanskrit": "स्वराष्ट्रात्परराष्ट्राच्च कोशं संजनयेन्नृपः।\nकोशाद्धि धर्मः कौन्तेय राज्यमूलं प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2076706, "chapter_id": 2628, "verse_number": "१२-१३३-२", "content_sanskrit": "तस्मात्संजनयेत्कोशं सत्कृत्य परिपालयेत्।\nपरिपाल्यानुगृह्णीयादेव धर्मः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2076707, "chapter_id": 2628, "verse_number": "१२-१३३-३", "content_sanskrit": "स कोशः शुद्धभावेन न नृशंसेन जायते।\nमध्यमं पदमास्थाय कोशसंग्रहणं चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2076708, "chapter_id": 2628, "verse_number": "१२-१३३-४", "content_sanskrit": "अबलस्य कुतः कोशो ह्यकोशस्य कुतो बलम्।\nअबलस्य कुतो राज्यमराज्ये श्रीर्भवेत्कुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2076709, "chapter_id": 2628, "verse_number": "१२-१३३-५", "content_sanskrit": "उच्चैर्वृत्तेः श्रियो हानिर्यथैव मरणं तथा।\nतस्मात्कोशं बलं मित्रमथ राजा विवर्धयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2076710, "chapter_id": 2628, "verse_number": "१२-१३३-६", "content_sanskrit": "हीनकोशं हि राजानमवमन्यन्ति शत्रवः।\nन चास्याल्पे तुष्यन्ति कर्मणाऽप्युत्सहन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2076711, "chapter_id": 2628, "verse_number": "१२-१३३-७", "content_sanskrit": "श्रियो हि कारणाद्राजा सत्क्रियां लभते पराम्।\nसाऽस्य गूहति पापानि वासो गुह्यमिव स्त्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2076712, "chapter_id": 2628, "verse_number": "१२-१३३-८", "content_sanskrit": "ऋद्धिमस्यानुतप्यन्ते पुरा विप्रकृता नराः।\nसालावृका इवाजस्नं जिघांसूनेव विन्दति।\nईदृशस्य कुतो राज्यं सुखं भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2076713, "chapter_id": 2628, "verse_number": "१२-१३३-९", "content_sanskrit": "उद्यच्छेदेव न ग्लायेदुद्यमो ह्येव पौरुषम्।\nअप्यपर्वणि भज्येत न नमेतेह कस्यचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2076714, "chapter_id": 2628, "verse_number": "१२-१३३-१०", "content_sanskrit": "अप्यरण्यं समाश्रित्य चरेन्मृगगणैः सह।\nन त्वेवोद्रिक्तमर्यादैर्दस्युभिः सहितश्चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2076715, "chapter_id": 2628, "verse_number": "१२-१३३-११", "content_sanskrit": "दस्यूनां सुलभा सेना रौद्रकर्मसु भारत।\nएकान्ततो ह्यमर्यादात्सर्वोऽप्युद्विजते जनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2076716, "chapter_id": 2628, "verse_number": "१२-१३३-१२", "content_sanskrit": "दस्यवोऽप्यभिशङ्कन्ते निरनुक्रोशकारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2076717, "chapter_id": 2628, "verse_number": "१२-१३३-१३", "content_sanskrit": "स्थापयेदेव मर्यादां जनचित्तप्रसादिनीम्।\nअल्पाप्यर्थेषु मर्यादा लोके भवति पूजिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2076718, "chapter_id": 2628, "verse_number": "१२-१३३-१४", "content_sanskrit": "नायं लोकोऽस्ति न पर इति व्यवसितो जनः।\nनालं गन्तुमिहाश्वासं नास्तिक्यभयशङ्कितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2076719, "chapter_id": 2628, "verse_number": "१२-१३३-१५", "content_sanskrit": "यथा सद्भिः परादानमहिंसा दस्युभिस्तथा।\nअनुरज्यन्ति भूतानि समर्यादेषु दस्युषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2076720, "chapter_id": 2628, "verse_number": "१२-१३३-१६", "content_sanskrit": "अयुध्यमानस्यादानं दारामर्शः कृतघ्नता।\nब्रह्मवित्तस्य चादानं निःशेषकरणं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2076721, "chapter_id": 2628, "verse_number": "१२-१३३-१७", "content_sanskrit": "स्त्रिया मोषः पथिस्थानं साधुष्वेव विगर्हितम्।\nसदोष एव भवति दस्युरेतानि वर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2076722, "chapter_id": 2628, "verse_number": "१२-१३३-१८", "content_sanskrit": "अभिसंदधते ये च विनाशायास्य भारत।\nसशेषमेवोपलभ्य कुर्वन्तीति विनिश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2076723, "chapter_id": 2628, "verse_number": "१२-१३३-१९", "content_sanskrit": "तस्मात्सशेषं कर्तव्यं स्वाधीनमपि दस्युभिः।\nन बलस्थोऽहमस्मीति नृशंसानि समाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2076724, "chapter_id": 2628, "verse_number": "१२-१३३-२०", "content_sanskrit": "सशेषकारिणस्तत्र शेषं पश्यन्ति सर्वशः।\nनिःशेषकारिणो नित्यं निःशेषकरणाद्भयम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2076725, "chapter_id": 2628, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि त्रयस्त्रिंशदधिकशततमोऽध्यायः॥ १३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]