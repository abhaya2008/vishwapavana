[{"id": 2212721, "chapter_id": 5534, "verse_number": "", "content_sanskrit": "व", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2212722, "chapter_id": 5534, "verse_number": "१", "content_sanskrit": "व्यवहाराश्च ते तात नित्यमाप्तैरनुष्ठिताः ।\nयोज्यास्तुष्टैर्भृतै राजन् नित्यं चारैरनुष्ठितैः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2212723, "chapter_id": 5534, "verse_number": "२", "content_sanskrit": "परिमाणं विदित्वा च दण्डं दण्ड्येषु भारत ।\nप्रणयेयुर्यथान्यायं पुरुषास्ते युधिष्ठिर\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2212724, "chapter_id": 5534, "verse_number": "३", "content_sanskrit": "आदानरुचयश्चैव चरा ये भीमदर्शनाः ।\nउग्रदण्डप्रधानाश्च मिथ्याव्याहारिणस्तथा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2212725, "chapter_id": 5534, "verse_number": "४", "content_sanskrit": "क्रोष्टारश्चैव लुब्धाश्च हन्तारः साहसप्रियाः ।\nहिंसाविहारभोक्तारो वर्णानां च प्रदूषकाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2212726, "chapter_id": 5534, "verse_number": "५", "content_sanskrit": "हिरण्यदण्ड्या वध्या वा कर्तव्या देशकालतः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2212727, "chapter_id": 5534, "verse_number": "६", "content_sanskrit": "(अवरोधभूमौ भृत्यैश्च पानं सह विवर्जयेत् ।\nआक्रोशन्त्यनुमत्तास्ते कलत्रं वाऽपि गृह्णते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2212728, "chapter_id": 5534, "verse_number": "७", "content_sanskrit": "जिघांसन्त्यपि शस्त्रेण नष्टाः क्रीडन्ति चोत्कटाः ।\nनानाक्षेपा व्याहरन्ति गम्यागम्यं न जानते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2212729, "chapter_id": 5534, "verse_number": "८", "content_sanskrit": "अतिपानेन राजाऽपि सर्वं कोशं विनाशयेत् ।\nवितरेद् गायकेभ्यश्च प्रधानद्रव्यसञ्चयम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2212730, "chapter_id": 5534, "verse_number": "९", "content_sanskrit": "शब्दमात्मनि दोषांश्च पिबेदेकः स्वजायया ।\nयुक्त्या प्रकाशमयति सुवीर्यस्य विवृद्धये\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2212731, "chapter_id": 5534, "verse_number": "१०", "content_sanskrit": "प्रातरन्यांश्च पश्येथा ये कुर्युः प्रियकर्म ते ।)\nअलङ्कारमथो भोज्यमत ऊर्ध्वं समाचर\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2212732, "chapter_id": 5534, "verse_number": "११", "content_sanskrit": "पश्येथाश्च ततो योधान् सततं परिहर्षयन् ।\nदूतानां च चराणां च प्रदोषस्ते सदा भवेत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2212733, "chapter_id": 5534, "verse_number": "१२", "content_sanskrit": "सदा चापररात्रान्ते भवेत् कार्यविनिर्णयः ।\nमध्यरात्रे विहारस्ते मध्याह्ने च सदा भवेत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2212734, "chapter_id": 5534, "verse_number": "१३", "content_sanskrit": "सर्वे त्वात्ययिके काले कार्याणां भरतर्षभ ।\nतथैव चाचरन् काले तिष्ठेथा भूरिदक्षिणः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2212735, "chapter_id": 5534, "verse_number": "१४", "content_sanskrit": "चक्रवत् कर्मणां तात पर्यायो ह्येष नित्यशः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2212736, "chapter_id": 5534, "verse_number": "१५", "content_sanskrit": "कोशस्य सञ्चये यत्नं कुर्वीथा न्यायतः सदा ।\nद्विविधस्य महाराज विपरीतं विवर्जयेः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2212737, "chapter_id": 5534, "verse_number": "१६", "content_sanskrit": "चारैर्विदित्वा शत्रूंश्च ये ते राज्यान्तरायिणः ।\nतानाप्तैः पुरुषैर्दूराद् घातयेथाः परस्परम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2212738, "chapter_id": 5534, "verse_number": "१७", "content_sanskrit": "कर्म दृष्ट्वा ततोऽमात्यान् सङ्गृह्णीयाः कुरूद्वह ।\nकारयेथाश्च कर्माणि युक्तायुक्तैरनुष्ठितैः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2212739, "chapter_id": 5534, "verse_number": "१८", "content_sanskrit": "सेनाप्रणेता च भवेत् तव तात दृढव्रतः ।\nशूरः क्लेशसहश्चैव प्रियश्च तव मानवः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2212740, "chapter_id": 5534, "verse_number": "१९", "content_sanskrit": "सर्वे जनपदाश्चैव तव कर्माणि पाण्डव ।\nपौरोगवाश्च सभ्याश्च कुर्युर्यानविहारिणः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2212741, "chapter_id": 5534, "verse_number": "२०", "content_sanskrit": "स्वरन्ध्रं पररन्ध्रं च स्वेषु चैव परेषु च ।\nउपलक्षयितव्यं ते नित्यमेव युधिष्ठिर\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2212742, "chapter_id": 5534, "verse_number": "२१", "content_sanskrit": "देशान्तरस्थाश्च नरा विक्रान्ताः सर्वकर्मसु ।\nमात्राभिरनुरूपाभिरनुग्राह्या हितास्त्वया\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2212743, "chapter_id": 5534, "verse_number": "२२", "content_sanskrit": "गुणानुसम्मतं कार्यं विदुषां राजसत्तम ।\nअविचाल्यश्च देशः स्याद् यथा मेरुर्महागिरिः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2212744, "chapter_id": 5534, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nआश्रमवासिकपर्वणि राजवृत्तोपदेशो नाम दशमोऽध्यायः ॥१०॥\nआश्रमवासपर्वणि दशमोऽध्यायः ॥१०॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]