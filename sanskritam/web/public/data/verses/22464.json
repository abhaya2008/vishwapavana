[{"id": 7002464000, "chapter_id": 22464, "verse_number": "१-१२६-१", "content_sanskrit": "सुमन्तुरुवाच ।\nआकाशं खं दिशो व्योम अन्तरिक्षं नभोऽम्बरम् ।\nपुष्करं गगनं मेरुर्विपुलं च बिलं तथा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002464001, "chapter_id": 22464, "verse_number": "१-१२६-२", "content_sanskrit": "आपोछिद्रं तथा शून्यं तमो वै रोदसी तथा ।\nनामान्येतानि ते व्योम्नः कीर्तितानि महीपते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002464002, "chapter_id": 22464, "verse_number": "१-१२६-३", "content_sanskrit": "लवणक्षीरदध्यम्लघृतमध्विक्षवस्तथा ।\nस्वादूदकश्च सप्तैते समुद्राः परिकीर्तिताः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002464003, "chapter_id": 22464, "verse_number": "१-१२६-४", "content_sanskrit": "हिमवान्हेमकूटश्च निषधो नील एव च ।\nश्वेतश्च शृङ्गवांश्चैव षडेते वर्षपर्वताः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002464004, "chapter_id": 22464, "verse_number": "१-१२६-५", "content_sanskrit": "मध्यसंस्थस्तथैतेषां महाराजतपर्वतः ।\nमाहेन्द्री चाप्यथाग्नेयी याम्या च नैरृती तथा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002464005, "chapter_id": 22464, "verse_number": "१-१२६-६", "content_sanskrit": "वारुणी चाथ वायव्या सौम्यैशानी तथैव च ।\nएताः पुर्यस्तु देवानां तथोपरि समाश्रिताः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002464006, "chapter_id": 22464, "verse_number": "१-१२६-७", "content_sanskrit": "पृथिव्यां तु स्थितो वीर लोकालोकस्तु पर्वतः ।\nततश्चण्डकपालं तु तस्मात्तत्परतस्तु यः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002464007, "chapter_id": 22464, "verse_number": "१-१२६-८", "content_sanskrit": "ततोऽग्निर्वायुराकाशं ततो भूतादिरुच्यते ।\nततो महानहङ्कारः प्रकृतिः पुरुषस्ततः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002464008, "chapter_id": 22464, "verse_number": "१-१२६-९", "content_sanskrit": "पुरुषादीश्वरो श्रेय ईश्वरेणाव्रृतं जगत् ।\nईश्वरो भगवन्भानुस्तेनेदं पूरितं जगत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002464009, "chapter_id": 22464, "verse_number": "१-१२६-१०", "content_sanskrit": "सहस्रांशुर्महातेजाश्चतुर्बाहुर्महाबलः ।\nऊर्ध्वमप्यथ लोकास्तु प्राङ्मया ये प्रकीर्तिताः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002464010, "chapter_id": 22464, "verse_number": "१-१२६-११", "content_sanskrit": "भूयस्तान्सम्प्रवक्ष्यामि अण्डावरणकारकान् ।\nभूर्लोकस्तुभुवर्लोकस्तृतीयः परिकीर्तितः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002464011, "chapter_id": 22464, "verse_number": "१-१२६-१२", "content_sanskrit": "महर्जनस्तपः सत्यः सप्तलोकाः प्रकीर्तिताः ।\nततस्तवंडकपालं तु तस्माच्च परस्तपः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002464012, "chapter_id": 22464, "verse_number": "१-१२६-१३", "content_sanskrit": "ततोऽग्निर्वायुराकाशं ततो भूतादिरुच्यते ।\nततो महान्प्रधानश्च प्रकृतिपुरुषस्ततः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002464013, "chapter_id": 22464, "verse_number": "१-१२६-१४", "content_sanskrit": "पुरुषादीश्वरो ज्ञेय ईश्वरेणावृतं जगत् ।\nभूमेरधस्तात्सप्तैव लोकानभिमताञ्छृणु ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002464014, "chapter_id": 22464, "verse_number": "१-१२६-१५", "content_sanskrit": "तलं सुतलपाताले तलातलं तथातलम् ।\nवितलं च कुरुश्रेष्ठ सप्तमं च रसातलम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002464015, "chapter_id": 22464, "verse_number": "१-१२६-१६", "content_sanskrit": "ततोऽग्निर्वायुराकाशं ततो भूतादिरुच्यते ।\nततो महान्प्रधानश्च प्रकृतिः पुरुषस्ततः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002464016, "chapter_id": 22464, "verse_number": "१-१२६-१७", "content_sanskrit": "पुरुषादीश्वरो ज्ञेय ईश्वरेणावृतं जगत् ।\nएवं मेरोः प्रमाणं तु सर्वमेतत्प्रकीर्तितम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002464017, "chapter_id": 22464, "verse_number": "१-१२६-१८", "content_sanskrit": "चतुरस्रश्चतुः शृंगः स मेरुः काञ्चनः शुभः ।\nपृथिव्यां संस्थितो मध्ये सिद्धगन्धर्वसेवितः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002464018, "chapter_id": 22464, "verse_number": "१-१२६-१९", "content_sanskrit": "चतुर्भिः काञ्चनैः शृंगैर्दिव्यैर्दिवमिवोल्लिखन् ।\nयोजनानां सहस्राणि चतुराशीतिरुच्छ्रितः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002464019, "chapter_id": 22464, "verse_number": "१-१२६-२०", "content_sanskrit": "प्रविष्टः षोडशाधस्तादष्टविंशतिविस्तृतः ।\nविस्तारस्त्रिगुणश्चास्य परिणाहस्ततः स्मृतः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002464020, "chapter_id": 22464, "verse_number": "१-१२६-२१", "content_sanskrit": "तस्य सौमनसं नाम शृंगमेकं तु काञ्चनम् ।\nद्वितीयं पद्मरागाभं ज्योतिष्कं नाम नामतः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002464021, "chapter_id": 22464, "verse_number": "१-१२६-२२", "content_sanskrit": "तृतीयं नामतश्चित्रं सर्वदेवमयं शुभम् ।\nचतुर्थं राजतं शुक्लं चन्द्रौजस्कमिति स्मृतम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002464022, "chapter_id": 22464, "verse_number": "१-१२६-२३", "content_sanskrit": "यत्तु सौमनसं नाम शृंगं गाङ्गेयमुच्यते ।\nतदेव चोदयो नाम्ना यत्रोद्यन्दृश्यते रविः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002464023, "chapter_id": 22464, "verse_number": "१-१२६-२४", "content_sanskrit": "उत्तरेण परिक्रम्य जम्बूद्वीपं दिवाकरः ।\nदृश्यो भवति भूतानां शिखरं च समास्थितः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002464024, "chapter_id": 22464, "verse_number": "१-१२६-२५", "content_sanskrit": "काञ्चनस्य च शैलस्य तेजसार्कस्य चाहृते ।\nउभे सन्ध्ये प्रकाशेते आताम्रे पूर्वपश्चिमे ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002464025, "chapter_id": 22464, "verse_number": "१-१२६-२६", "content_sanskrit": "शृंगे सौमनसे सूर्य उत्तिष्ठत्युत्तरायणे ।\nज्योतिषे दक्षिणे चापि विषुवे मध्यतस्तयोः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002464026, "chapter_id": 22464, "verse_number": "१-१२६-२७", "content_sanskrit": "ईशेन्द्रोद्रिश्च ऐशान्यां तत्राग्निः पूर्वदक्षिणे ।\nनैरृतेऽपि ततो ज्ञेयो वायव्ये मरुतस्तथा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002464027, "chapter_id": 22464, "verse_number": "१-१२६-२८", "content_sanskrit": "मध्ये तु कंजजः साक्षाद्ग्रहा ज्योतींषि चैव हि ।\nआदित्यस्तेन रूपेण तस्मिन्व्योम्नि प्रतिष्ठितः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002464028, "chapter_id": 22464, "verse_number": "१-१२६-२९", "content_sanskrit": "इदं देवमयं व्योम तथा लोकमयं स्मृतम् ।\nपूर्वकोणस्थिते शृंगे स्थितः शुक्रो महीपते ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002464029, "chapter_id": 22464, "verse_number": "१-१२६-३०", "content_sanskrit": "हेलिजश्चापरे ज्ञेयो धननाथस्तथापरे ।\nसोमश्चापि चतुर्थे तु स्थितः शृंगे जनाधिप ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002464030, "chapter_id": 22464, "verse_number": "१-१२६-३१", "content_sanskrit": "मध्ये केशास्थितो राजन्हुङ्कारश्च पिनाकिनः ।\nशृंगे पूर्वोत्तरे राजन्स्थितो देवो विधुक्षये१ ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002464031, "chapter_id": 22464, "verse_number": "१-१२६-३२", "content_sanskrit": "ततः स्थितो महादेवो गोपतिर्लोकपूजितः ।\nपूर्वाग्नेयीस्थिते शृंगे स्थितो वै शाण्डिलः सुतः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002464032, "chapter_id": 22464, "verse_number": "१-१२६-३३", "content_sanskrit": "ततः स्थितो महातेजाः कीनाशो हेलिनन्दनः ।\nस्थितो वै नैरृते शृंगे विरूपाक्षो महाबलः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002464033, "chapter_id": 22464, "verse_number": "१-१२६-३४", "content_sanskrit": "तस्मादनन्तरो देवः स्थितो वै यादसां पतिः ।\nततः स्थितो महातेजा वीर मित्रो महाबलः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002464034, "chapter_id": 22464, "verse_number": "१-१२६-३५", "content_sanskrit": "वायव्यं शृंगमाश्रित्य सर्वदेवनमस्कृतम् ।\nततः स्थितो दशबलो नरमारुह्य भारत ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002464035, "chapter_id": 22464, "verse_number": "१-१२६-३६", "content_sanskrit": "ब्रह्मा मध्ये स्थितो देवो ह्यनन्तश्चाध एव हि ।\nउपेन्द्रशङ्करौ देवौ ब्रह्मणोऽन्ते समास्थितौ ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002464036, "chapter_id": 22464, "verse_number": "१-१२६-३७", "content_sanskrit": "एष मेरुस्तथा व्योम एष धर्मश्च पठ्यते ।\nसर्वदेवमयश्चायं मेरुर्व्योम इति स्मृतः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002464037, "chapter_id": 22464, "verse_number": "१-१२६-३८", "content_sanskrit": "तथा वेदमयश्चापि पठ्यते नात्र संशयः ।\nशृंगाणि वेदाश्चत्वारः पूर्वशृंगादयो विदुः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]