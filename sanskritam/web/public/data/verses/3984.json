[{"id": 2137582, "chapter_id": 3984, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2137583, "chapter_id": 3984, "verse_number": "१", "content_sanskrit": "देवराजमनुप्राप्तं ब्राह्मणच्छद्मना वृतम् ।\nदृष्ट्वा स्वागतमित्याह न बुबोधास्य मानसम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2137584, "chapter_id": 3984, "verse_number": "२", "content_sanskrit": "हिरण्यकण्ठीः प्रमदा ग्रामान् वा बहुगोकुलान् ।\nकिं ददानीति तं विप्रमुवाचाधिरथिस्ततः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2137585, "chapter_id": 3984, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2137586, "chapter_id": 3984, "verse_number": "३", "content_sanskrit": "हिरण्यकण्ठ्यः प्रमदा यच्चान्यत् प्रीतिवर्धनम् ।\nनाहं दत्तमिहेच्छामि तदर्थिभ्यः प्रदीयताम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2137587, "chapter_id": 3984, "verse_number": "४", "content_sanskrit": "यदेतत् सहजं वर्म कुण्डले च तवानघ ।\nएतदुत्कृत्य मे देहि यदि सत्यव्रतो भवान् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2137588, "chapter_id": 3984, "verse_number": "५", "content_sanskrit": "एतदिच्छाम्यहं क्षिप्रं त्वया दत्तं परन्तप ।\nएष मे सर्वलाभानां लाभः परमको मतः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2137589, "chapter_id": 3984, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2137590, "chapter_id": 3984, "verse_number": "६", "content_sanskrit": "अवनिं प्रमदा गाश्च निर्वापं बहुवार्षिकीम् ।\nतत् ते विप्र प्रदास्यामि न तु वर्म सकुण्डलम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2137591, "chapter_id": 3984, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2137592, "chapter_id": 3984, "verse_number": "७", "content_sanskrit": "एवं बहुविधैर्वाक्यैर्याच्यमानः स तु द्विजः ।\nकर्णेन भरतश्रेष्ठ नान्यं वरमयाचत \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2137593, "chapter_id": 3984, "verse_number": "८", "content_sanskrit": "सान्त्वितश्च यथाशक्ति पूजितश्च यथाविधि ।\nन चान्यं स द्विजश्रेष्ठः कामयामास वै वरम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2137594, "chapter_id": 3984, "verse_number": "९", "content_sanskrit": "यदा नान्यं प्रवृणुते वरं वै द्विजसत्तमः ।\nतदैनमब्रवीत् भूयो राधेयः प्रहसन्निव \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2137595, "chapter_id": 3984, "verse_number": "१०", "content_sanskrit": "तदैनमब्रवीत् कर्णः सहजं कवचं हि मे ।\nसहजं वर्म मे विप्र कुण्डले चामृतोद्भवे ।\nतेनावध्योऽस्मि लोकेषु ततो नैतज्जहाम्यहम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2137596, "chapter_id": 3984, "verse_number": "११", "content_sanskrit": "विशालं पृथिवीराज्यं क्षेमं निहतकण्टकम् ।\nप्रतिगृह्णीष्व मत्तस्त्वं साधु ब्राह्मणपुङ्गव\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2137597, "chapter_id": 3984, "verse_number": "१२", "content_sanskrit": "कुण्डलाभ्यां विमुक्तोऽहं वर्मणा सहजेन च ।\nगमनीयो भविष्यामि शत्रूणां द्विजसत्तम \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2137598, "chapter_id": 3984, "verse_number": "", "content_sanskrit": "वैशम्पयानः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2137599, "chapter_id": 3984, "verse_number": "१३", "content_sanskrit": "यदान्यं न वरं वव्रे भगवान् पाकशासनः ।\nततः प्रहस्य कर्णस्तं पुनरित्यब्रवीद् वचः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2137600, "chapter_id": 3984, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2137601, "chapter_id": 3984, "verse_number": "१४", "content_sanskrit": "विदितो देवदेवेश प्रागेवासि मम प्रभो ।\nन तु न्याय्यं मया दातुं तव शक्र वृथा वरम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2137602, "chapter_id": 3984, "verse_number": "१५", "content_sanskrit": "त्वं हि देवेश्वरः साक्षात् त्वया देयो वरो मम ।\nअन्येषां चैवभूतानामीश्वरो ह्यसि भूतकृत् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2137603, "chapter_id": 3984, "verse_number": "१६", "content_sanskrit": "यदि दास्यामि ते देव कुण्डले कवचं तथा ।\nवध्यतामुपयास्यामि त्वं च शक्रावहास्यताम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2137604, "chapter_id": 3984, "verse_number": "१७", "content_sanskrit": "तस्माद् विनिमयं कृत्वा कुण्डले वर्म चोत्तमम् ।\nहरस्व शक्र कामं मे न दद्यामहमन्यथा \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2137605, "chapter_id": 3984, "verse_number": "", "content_sanskrit": "शक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2137606, "chapter_id": 3984, "verse_number": "१८", "content_sanskrit": "विदितोऽहं रवेः पूर्वमायान् देवस्तवान्तिकम् ।\nतेन ते सर्वमाख्यातमेवमेतन्न संशयः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2137607, "chapter_id": 3984, "verse_number": "१९", "content_sanskrit": "काममस्तु तथा तात तव कर्ण यथेच्छसि ।\nवर्जयित्वा तु मे वज्रं प्रवृणीष्व यथेच्छसि \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2137608, "chapter_id": 3984, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2137609, "chapter_id": 3984, "verse_number": "२०", "content_sanskrit": "ततः कर्णः प्रहृष्टस्तु उपसङ्गम्य वासवम् ।\nअमोघां शक्तिमभ्येत्य वव्रे सम्पूर्णमानसः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2137610, "chapter_id": 3984, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2137611, "chapter_id": 3984, "verse_number": "२१", "content_sanskrit": "वर्मणा कुण्डलाभ्यां च शक्तिं मे देहि वासव ।\nअमोघां शत्रुसङ्घानां घातिनीं पृतनामुखे \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2137612, "chapter_id": 3984, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2137613, "chapter_id": 3984, "verse_number": "२२", "content_sanskrit": "ततः सञ्चिन्त्य मनसा मुहूर्तमिव वासवः ।\nशक्त्यर्थं पृथिवीपाल कर्णं वाक्यमथाब्रवीत् \t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2137614, "chapter_id": 3984, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2137615, "chapter_id": 3984, "verse_number": "२३", "content_sanskrit": "कुण्डले मे प्रयच्छस्व वर्म चैव शरीरजम् ।\nगृहाण कर्ण शक्तिं त्वमनेन समयेन च \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2137616, "chapter_id": 3984, "verse_number": "२४", "content_sanskrit": "अमोघा हन्ति शतशः शत्रून्मम करच्युता ।\nपुनश्च पाणिमभ्येति मम दैत्यान् विनिघ्नतः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2137617, "chapter_id": 3984, "verse_number": "२५", "content_sanskrit": "सेयं तव करप्राप्ता हत्वैकं रिपुमूर्जितम् ।\nगर्जन्तं प्रतपन्तं च मामेवैष्यति सूतज \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2137618, "chapter_id": 3984, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2137619, "chapter_id": 3984, "verse_number": "२६", "content_sanskrit": "एकमेवाहमिच्छामि रिपुं हन्तुं महाहवे ।\nगर्जन्तं प्रतपन्तं च यतो मम भयं भवेत् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2137620, "chapter_id": 3984, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2137621, "chapter_id": 3984, "verse_number": "२७", "content_sanskrit": "एकं हनिष्यसि रिपुं गर्जन्तं बलिनं रणे ।\nत्वं तु यं प्रार्थयस्येकं रक्ष्यते स महात्मना \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2137622, "chapter_id": 3984, "verse_number": "२८", "content_sanskrit": "यमाहुर्वेदविद्वांसो वरार्हमपराजितम् ।\nनारायणमचिन्त्यं च तेन कृष्णेन रक्ष्यते \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2137623, "chapter_id": 3984, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2137624, "chapter_id": 3984, "verse_number": "२९", "content_sanskrit": "एवमप्यस्तु भगवन्नेकवीरवधे मम ।\nअमोघां देहि मे शक्तिं यथा हन्यां प्रतापिनम् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2137625, "chapter_id": 3984, "verse_number": "३०", "content_sanskrit": "एवमेतद् यथा त्वं च दानवानां निषूदन ।\nवधिष्यामि रणे शत्रुं यो मे स्थाता पुरःसरः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2137626, "chapter_id": 3984, "verse_number": "३१", "content_sanskrit": "उत्कृत्य तु प्रदास्यामि कुण्डले कवचं च ते ।\nनिकृत्तेषु तु गात्रेषु न मे बीभत्सता भवेत् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2137627, "chapter_id": 3984, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2137628, "chapter_id": 3984, "verse_number": "३२", "content_sanskrit": "न ते बीभत्सता कर्ण भविष्यति कथञ्चन ।\nव्रणश्चैव न गात्रेषु यस्त्वं नानृतमिच्छसि \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2137629, "chapter_id": 3984, "verse_number": "३३", "content_sanskrit": "यादृशस्ते पितुर्वर्णस्तेजश्च वदतां वर ।\nतादृशेनैव वर्णेन त्वं कर्ण भविता पुनः \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2137630, "chapter_id": 3984, "verse_number": "३४", "content_sanskrit": "विद्यमानेषु शस्त्रेषु यद्यमोघामसंशये ।\nप्रमत्तो मोक्ष्यसे चापि त्वय्येवैषा पतिष्यति \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2137631, "chapter_id": 3984, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2137632, "chapter_id": 3984, "verse_number": "३५", "content_sanskrit": "संशयं परमं प्राप्य विमोक्ष्ये वासवीमिमाम् ।\nयथा मामात्थ शक्र त्वं सत्यमेतद् ब्रवीमि ते \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2137633, "chapter_id": 3984, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2137634, "chapter_id": 3984, "verse_number": "३६", "content_sanskrit": "ततः शक्तिं प्रज्वलितां प्रतिगृह्य विशाम्पते ।\nशस्त्रं गृहीत्वा निशितं सर्वगात्राण्यकृन्तत \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2137635, "chapter_id": 3984, "verse_number": "३७", "content_sanskrit": "ततो देवा मानवा दानवाश्च\nनिकृन्तन्तं कर्णमात्मानमेवम् ।\nदृष्ट्वा सर्वे सिंहनादान् प्रणेदुर्न\nह्यस्यासीन्मुखजो वै विकारः \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2137636, "chapter_id": 3984, "verse_number": "३८", "content_sanskrit": "ततो दिव्या दुन्दुभयः प्रणेदुः\nपपातोच्चैः पुष्पवर्षं च दिव्यम् ।\nदृष्ट्वा कर्णं शस्त्रसङ्कृत्तगात्रं\nमुहुश्चापि स्मयमानं नृवीरम् \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2137637, "chapter_id": 3984, "verse_number": "३९", "content_sanskrit": "ततश्छित्त्वा कवचं दिव्यमङ्गात्\nतथैवार्द्रं प्रददौ वासवाय ।\nतथोत्कृत्य प्रददौ कुण्डले च\nकर्णात् तस्मात् कर्मणा तेन कर्णः \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2137638, "chapter_id": 3984, "verse_number": "४०", "content_sanskrit": "ततो देवो मुदितो वज्रपाणिः\nदृष्ट्वा कर्णं शस्त्रनिकृत्तगात्रम् ।\nततः शक्रः प्रहसन् वञ्चयित्वा\nकर्णं लोके यशसा योजयित्वा \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2137639, "chapter_id": 3984, "verse_number": "४१", "content_sanskrit": "कृतं कार्यं पाण्डवानां हि मेने\nततः पश्चाद्दिवमेवोत्पपात \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2137640, "chapter_id": 3984, "verse_number": "४२", "content_sanskrit": "श्रुत्वा कर्णं मुषितं धार्तराष्ट्राः\nदीनाः सर्वे भग्नदर्पा इवासन् ।\nतां चावस्थां गमितं सूतपुत्रं\nश्रुत्वा पार्था जहृषुः काननस्थाः \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2137641, "chapter_id": 3984, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2137642, "chapter_id": 3984, "verse_number": "४३", "content_sanskrit": "क्वस्था वीराः पाण्डवास्ते बभूवुः\nकुतश्चैव श्रुतवन्तः प्रियं तत् ।\nकिं वाकार्षुर्द्वादशेऽब्दे व्यतीते\nतन्मे सर्वं भगवन् व्याकरोतु \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2137643, "chapter_id": 3984, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2137644, "chapter_id": 3984, "verse_number": "४४", "content_sanskrit": "लब्ध्वा कृष्णां सैन्धवं द्रावयित्वा\nविप्रैः सार्धं काम्यकादाश्रमात् ते ।\nमार्कण्डेयाच्छ्रुतवन्तः पुराणं\nदेवर्षीणां चरितं विस्तरेण \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2137645, "chapter_id": 3984, "verse_number": "४४", "content_sanskrit": "प्रत्याजग्मुः सरथाः सानुयात्राः\nसर्वैः सार्धं सूतपौरोगवैस्ते ।\nततो पुष्यं द्वै(ययुर्द्वै)तवने नृवीरा\nनिस्तीर्योग्रं(र्यैवं) वनवासं समग्रम् \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2137646, "chapter_id": 3984, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि एकोनत्रिशततमोऽध्यायः ॥२९९॥\nकुण्डलाहरणपर्वणि एकादशोऽध्यायः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2137647, "chapter_id": 3984, "verse_number": "", "content_sanskrit": "॥ समाप्तं कुण्डलाहरणपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2137648, "chapter_id": 3984, "verse_number": "", "content_sanskrit": "––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}]