[{"id": 7006345000, "chapter_id": 26345, "verse_number": "१-५५-१", "content_sanskrit": "वैशम्पायन उवाच नारदस्य वचः श्रुत्वा सस्मितं मधुसूदनः ।\nप्रत्युवाच शुभं वाक्यं वरेण्यः प्रभुरीश्वरः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006345001, "chapter_id": 26345, "verse_number": "१-५५-२", "content_sanskrit": "त्रैलोक्यस्य हितार्थाय यन्मां वदसि नारद ।\nतस्य सम्यक्प्रवृत्तस्य श्रूयतामुत्तरं वचः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006345002, "chapter_id": 26345, "verse_number": "१-५५-३", "content_sanskrit": "विदिता देहिनो जाता मयैते भुवि दानवाः ।\nयां च यस्तनुमादाय दैत्यः पुष्यति विग्रहम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006345003, "chapter_id": 26345, "verse_number": "१-५५-४", "content_sanskrit": "जानामि कंसं सम्भूतमुग्रसेनसुतं भुवि ।\nकेशिनं चापि जानामि दैत्यं तुरगविग्रहम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006345004, "chapter_id": 26345, "verse_number": "१-५५-५", "content_sanskrit": "नागं कुवलयापीडं मल्लौ चाणूरमुष्टिकौ ।\nअरिष्टं चापि जानामि दैत्यं वृषभरूपिणम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006345005, "chapter_id": 26345, "verse_number": "१-५५-६", "content_sanskrit": "विदितो मे खरश्चैव प्रलम्बश्च महासुरः ।\nसा च मे विदिता विप्र पूतना दुहिता बलेः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006345006, "chapter_id": 26345, "verse_number": "१-५५-७", "content_sanskrit": "कालियं चापि जानामि यमुनाह्रदगोचरम् ।\nवैनतेयभयाद् यस्तु यमुनाह्रदमाविशत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006345007, "chapter_id": 26345, "verse_number": "१-५५-८", "content_sanskrit": "विदितो मे जरासंधः स्थितो मूर्ध्नि महीक्षिताम् ।\nप्राग्ज्योतिषपुरे वापि नरकं साधु तर्कये ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006345008, "chapter_id": 26345, "verse_number": "१-५५-९", "content_sanskrit": "मानुषे पार्थिवे लोके मानुषत्वमुपागतम् ।\nबाणं च शोणितपुरे गुहप्रतिमतेजसम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006345009, "chapter_id": 26345, "verse_number": "१-५५-१०", "content_sanskrit": "दृप्तं बाहुसहस्रेण देवैरपि सुदुर्जयम ।\nमय्यासक्तां च जानामि भारतीं महतीं धुरम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006345010, "chapter_id": 26345, "verse_number": "१-५५-११", "content_sanskrit": "सर्वं तच्च विजानामि यथा योत्स्यन्ति ते नृपाः ।\nक्षयो भुवि मया दृष्टः शक्रलोके च सत्क्रिया ।\nएषां पुरुषदेहानामपरावृत्तदेहिनाम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006345011, "chapter_id": 26345, "verse_number": "१-५५-१२", "content_sanskrit": "सम्प्रवेक्ष्याम्यहं योगमात्मनश्च परस्य च ।\nसम्प्राप्य पार्थिवं लोकं मानुषत्वमुपागतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006345012, "chapter_id": 26345, "verse_number": "१-५५-१३", "content_sanskrit": "कंसादींश्चापि तान्सर्वान् वधिष्यामि महासुरान् ।\nतेन तेन विधानेन येन यः शान्तिमेष्यति ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006345013, "chapter_id": 26345, "verse_number": "१-५५-१४", "content_sanskrit": "अनुप्रविश्य योगेन तास्ता हि गतयो मया ।\nअमीषां हि सुरेन्द्राणां हन्तव्या रिपवो युधि ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006345014, "chapter_id": 26345, "verse_number": "१-५५-१५", "content_sanskrit": "जगत्यर्थे कृतो योऽयमंशोत्सर्गो दिवौकसैः ।\nसुरदेवर्षिगन्धर्वैरितश्चानुमते मम ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006345015, "chapter_id": 26345, "verse_number": "१-५५-१६", "content_sanskrit": "विनिश्चयो प्रागेव नारदायं कृतो मया ।\nनिवासं ननु मे ब्रह्मन् विदधातु पितामहः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006345016, "chapter_id": 26345, "verse_number": "१-५५-१७", "content_sanskrit": "यत्र देशे यथा जातो येन वेषेण वा वसन् ।\nतानहं समरे हन्यां तन्मे ब्रूहि पितामह ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006345017, "chapter_id": 26345, "verse_number": "१-५५-१८", "content_sanskrit": "ब्रह्मोवाच नारायणेमं सिद्धार्थमुपायं शृणु मे विभो ।\nभुवि यस्ते जनयिता जननी च भविष्यति ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006345018, "chapter_id": 26345, "verse_number": "१-५५-१९", "content_sanskrit": "यत्र त्वं च महाबाहो जातः कुलकरो भुवि ।\nयादवानां महद् वंशमखिलं धारयिष्यसि ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006345019, "chapter_id": 26345, "verse_number": "१-५५-२०", "content_sanskrit": "तांश्चासुरान्समुत्पाट्य वंशं कृत्वाऽऽत्मनो महत् ।\nस्थापयिष्यसि मर्यादां नृणां तन्मे निशामय ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006345020, "chapter_id": 26345, "verse_number": "१-५५-२१", "content_sanskrit": "पुरा हि कश्यपो विष्णो वरुणस्य महात्मनः ।\nजहार यज्ञिया गा वै पयोदास्तु महामखे ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006345021, "chapter_id": 26345, "verse_number": "१-५५-२२", "content_sanskrit": "अदितिः सुरभिश्चैते द्वे भार्ये कश्यपस्य तु ।\nप्रदीयमाना गास्तास्तु नैच्छतां वरुणस्य वै ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006345022, "chapter_id": 26345, "verse_number": "१-५५-२३", "content_sanskrit": "ततो मां वरुणोऽभ्येत्य प्रणम्य शिरसा ततः ।\nउवाच भगवन् गावो गुरुणा मे हृता इति ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006345023, "chapter_id": 26345, "verse_number": "१-५५-२४", "content_sanskrit": "कृतकार्यो हि गास्तास्तु नानुजानाति मे गुरुः ।\nअन्ववर्तत भार्ये द्वे अदितिं सुरभिं तथा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006345024, "chapter_id": 26345, "verse_number": "१-५५-२५", "content_sanskrit": "&nbsp;मम ता ह्यक्षया गावो दिव्याः कामदुहः प्रभो ।\nचरन्ति सागरान् सर्वान्रक्षिताः स्वेन तेजसा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006345025, "chapter_id": 26345, "verse_number": "१-५५-२६", "content_sanskrit": "कस्ता धर्षयितुं शक्तो मम गाः कश्यपादृते ।\nअक्षयं वा क्षरन्त्यग्र्यं पयो देवामृतोपमम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006345026, "chapter_id": 26345, "verse_number": "१-५५-२७", "content_sanskrit": "प्रभुर्वा व्युत्थितो ब्रह्मन् गुरुर्वा यदि वेतरः ।\nत्वया नियम्याः सर्वे वै त्वं हि नः परमा गतिः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006345027, "chapter_id": 26345, "verse_number": "१-५५-२८", "content_sanskrit": "यदि प्रभवतां दण्डो लोके कार्यमजानताम्  ।\nन विद्यते लोकगुरो न स्युर्वै लोकसेतवः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006345028, "chapter_id": 26345, "verse_number": "१-५५-२९", "content_sanskrit": "यथा वास्तु तथा वास्तु कर्तव्ये भगवान् प्रभुः ।\nमम गावः प्रदीयन्तां ततो गन्तास्मि सागरम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006345029, "chapter_id": 26345, "verse_number": "१-५५-३०", "content_sanskrit": "या आत्मदेवता गावो या गावः सत्त्वमव्ययम् ।\nलोकानां त्वत्प्रवृत्तानामेकं गोब्राह्मणं स्मृतम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006345030, "chapter_id": 26345, "verse_number": "१-५५-३१", "content_sanskrit": "त्रातव्याः प्रथमं गावस्त्रातास्त्रायन्ति ता द्विजान् ।\nगोब्राह्मणपरित्राणे परित्रातं जगद् भवेत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006345031, "chapter_id": 26345, "verse_number": "१-५५-३२", "content_sanskrit": "इत्यम्बुपतिना प्रोक्तो वरुणेनाहमच्युत ।\nगवां कारणतत्त्वज्ञः कश्यपे शापमुत्सृजम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006345032, "chapter_id": 26345, "verse_number": "१-५५-३३", "content_sanskrit": "येनांशेन हृता गावः कश्यपेन महर्षिणा ।\nस तेनांशेन जगतीं गत्वा गोपत्वमेष्यति ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006345033, "chapter_id": 26345, "verse_number": "१-५५-३४", "content_sanskrit": "या च सा सुरभिर्नाम अदितिश्च सुरारणिः ।\nतेऽप्युभे तस्य भार्ये वै तेनैव सह यास्यतः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006345034, "chapter_id": 26345, "verse_number": "१-५५-३५", "content_sanskrit": "ताभ्यां च सह गोपत्वे कश्यपो भुवि रंस्यते ।\nस तस्य कश्यपस्यांशस्तेजसा कश्यपोपमः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006345035, "chapter_id": 26345, "verse_number": "१-५५-३६", "content_sanskrit": "वसुदेव इति ख्यातो गोषु तिष्ठति भूतले ।\nगिरिर्गोवर्धनो नाम मथुरायास्त्वदूरतः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006345036, "chapter_id": 26345, "verse_number": "१-५५-३७", "content_sanskrit": "तत्रासौ गोषु निरतः कंसस्य करदायकः ।\nतस्य भार्याद्वयं जातमदितिः सुरभिश्च ते ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006345037, "chapter_id": 26345, "verse_number": "१-५५-३८", "content_sanskrit": "देवकी रोहिणी चेमे वसुदेवस्य धीमतः ।\nसुरभी रोहिणी देवी चादितिर्देवकी त्वभूत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006345038, "chapter_id": 26345, "verse_number": "१-५५-३९", "content_sanskrit": "तत्र त्वं शिशुरेवाङ्कौ गोपालकृतलक्षणः ।\nवर्धयस्व मूहाबाहो पुरा त्रैविक्रमे यथा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006345039, "chapter_id": 26345, "verse_number": "१-५५-४०", "content_sanskrit": "छादयित्वाऽऽत्मनाऽऽत्मानं मायया योगरूपया ।\nतत्रावतर लोकानां भवाय मधुसूदन ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006345040, "chapter_id": 26345, "verse_number": "१-५५-४१", "content_sanskrit": "जयाशीर्वचनैस्त्वेते वर्धयन्ति दिवौकसः ।\nआत्मानमात्मना हि त्वमवतार्य महीतले ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006345041, "chapter_id": 26345, "verse_number": "१-५५-४२", "content_sanskrit": "देवकीं रोहिणीं चैव गर्भाभ्यां परितोषय ।\nगोपकन्यासहस्राणि रमयंश्चर मेदिनीम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006345042, "chapter_id": 26345, "verse_number": "१-५५-४३", "content_sanskrit": "गाश्च ते रक्षतो विष्णो वनानि परिधावतः ।\nवनमालापरिक्षिप्तं  धन्या द्रक्ष्यन्ति ते वपुः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006345043, "chapter_id": 26345, "verse_number": "१-५५-४४", "content_sanskrit": "विष्णौ पद्मपलाशाक्षे गोपालवसतिं गते ।\nबाले त्वयि महाबाहो लोको बालत्वमेष्यति ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006345044, "chapter_id": 26345, "verse_number": "१-५५-४५", "content_sanskrit": "त्वद्भक्ताः पुण्डरीकाक्ष तव चित्तवशानुगाः ।\nगोषु गोपा भविष्यन्ति सहायाः सततं तव ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006345045, "chapter_id": 26345, "verse_number": "१-५५-४६", "content_sanskrit": "वने चारयतो गाश्च गोष्ठेषु परिधावतः ।\nमज्जतो यमुनायां च रतिं प्राप्स्यन्ति ते त्वयि ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006345046, "chapter_id": 26345, "verse_number": "१-५५-४७", "content_sanskrit": "जीवितं वसुदेवस्य भविष्यति सुजीवितम् ।\nयस्त्वया तात इत्युक्तः स पुत्र इति वक्ष्यति ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006345047, "chapter_id": 26345, "verse_number": "१-५५-४८", "content_sanskrit": "अथवा कस्य पुत्रत्वं गच्छेथाः कश्यपादृते ।\nका च धारयितुं शक्ता त्वां विष्णो अदितिं विना ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006345048, "chapter_id": 26345, "verse_number": "१-५५-४९", "content_sanskrit": "योगेनात्मसमुत्थेन गच्छ त्वं विजयाय वै ।\nवयमप्यालयान्स्वान्स्वान्गच्छामो मधुसूदन॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006345049, "chapter_id": 26345, "verse_number": "१-५५-५०", "content_sanskrit": "वैशम्पायन उवाच स देवानभ्यनुज्ञाय विविक्ते त्रिदिवालये ।\nजगाम विष्णुः स्वं देशं क्षीरोदस्योत्तरां दिशम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006345050, "chapter_id": 26345, "verse_number": "१-५५-५१", "content_sanskrit": "तत्र वै पार्वती नाम गुहा मेरोः सुदुर्गमा ।\nत्रिभिस्तस्यैव विक्रान्तैर्नित्यं पर्वसु पूजिता ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006345051, "chapter_id": 26345, "verse_number": "१-५५-५२", "content_sanskrit": "पुराणं तत्र विन्यस्य देहं हरिरुदारधीः ।\nआत्मानं योजयामास वसुदेवगृहे प्रभुः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]