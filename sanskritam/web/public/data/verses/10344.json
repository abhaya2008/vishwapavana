[{"id": 6000344000, "chapter_id": 10344, "verse_number": null, "content_sanskrit": "अथ द्वादशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000344001, "chapter_id": 10344, "verse_number": null, "content_sanskrit": "सूत उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.001.m4a", "display_order": 2}, {"id": 6000344002, "chapter_id": 10344, "verse_number": "१२-१२-१", "content_sanskrit": "नमो धर्माय महते नमः कृष्णाय वेधसे।\nब्राह्मणेभ्यो नमस्कृत्य धर्मान् वक्ष्ये सनातनान्॥ १२/१२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.002.m4a", "display_order": 3, "topics": [{"text": "भागवतोक्तसर्वार्थानुक्रमः", "range": "१–४५"}]}, {"id": 6000344003, "chapter_id": 10344, "verse_number": "१२-१२-२", "content_sanskrit": "एतद् वः कथितं विप्रा विष्णोश्चरितमद्भुतम्।\nभवद्भिर्यदहं पृष्टो नराणां पुरुषोचितम्॥ १२/१२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.003.m4a", "display_order": 4}, {"id": 6000344004, "chapter_id": 10344, "verse_number": "१२-१२-३", "content_sanskrit": "अत्र संकीर्त्यते साक्षात् सर्वपापहरो हरिः।\nनारायणो हृषीकेशो भगवान् सात्वतां पतिः॥ १२/१२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.004.m4a", "display_order": 5}, {"id": 6000344005, "chapter_id": 10344, "verse_number": "१२-१२-४", "content_sanskrit": "यत् तद् ब्रह्म परं गुह्यं जगतः प्रभवाप्ययम्।\nज्ञानं च सदुपाख्यानं प्रोक्तं विज्ञानसंयुतम्॥ १२/१२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.005.m4a", "display_order": 6}, {"id": 6000344006, "chapter_id": 10344, "verse_number": "१२-१२-५", "content_sanskrit": "भक्तियोगश्च व्याख्यातो वैराग्यं च तदाश्रयम्।\nपारीक्षितमुपाख्यानं नारदाख्यानमेव च॥ १२/१२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.006.m4a", "display_order": 7}, {"id": 6000344007, "chapter_id": 10344, "verse_number": "१२-१२-६", "content_sanskrit": "प्रायोपवेशो राजर्षेर्विप्रशापात् परीक्षितः।\nशुकस्य ब्रह्मर्षभस्य संवादश्च परीक्षितः॥ १२/१२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.007.m4a", "display_order": 8}, {"id": 6000344008, "chapter_id": 10344, "verse_number": "१२-१२-७", "content_sanskrit": "योगधारणयोत्क्रान्तिः संवादो नारदाजयोः।\nअवतारानुगीतं च सर्गः प्राधानिकोऽग्रतः॥ १२/१२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.008.m4a", "display_order": 9}, {"id": 6000344009, "chapter_id": 10344, "verse_number": "१२-१२-८", "content_sanskrit": "विदुरोद्धवसंवादः क्षत्तृमैत्रेययोस्ततः।\nपुराणसंहिताप्रश्नो महापुरुषसंस्थितिः॥ १२/१२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.009.m4a", "display_order": 10}, {"id": 6000344010, "chapter_id": 10344, "verse_number": "१२-१२-९", "content_sanskrit": "ततः प्राकृतिकः सर्गः सप्त वैकृतिकास्तथा।\nततो ब्रह्माण्डसम्भूतिर्वैराजः पुरुषो यतः॥ १२/१२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.010.m4a", "display_order": 11}, {"id": 6000344011, "chapter_id": 10344, "verse_number": "१२-१२-१०", "content_sanskrit": "कालस्य स्थूलसूक्ष्मस्य गतिः पद्मसमुद्भवः।\nभुव उद्धरणाऽम्भोधेर्हिरण्याक्षवधो यतः॥ १२/१२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.011.m4a", "display_order": 12}, {"id": 6000344012, "chapter_id": 10344, "verse_number": "१२-१२-११", "content_sanskrit": "ऊर्ध्वतिर्यगधः सर्गो रुद्रसर्गस्तथैव च।\nअर्धनारीनरस्याथ यथा स्वायम्भुवो मनुः॥ १२/१२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.012.m4a", "display_order": 13}, {"id": 6000344013, "chapter_id": 10344, "verse_number": "१२-१२-१२", "content_sanskrit": "शतरूपा च या स्त्रीणामाद्या प्रकृतिरुत्तमा।\nसन्तानो धर्मपत्नीनां कर्दमस्य प्रजापतेः॥ १२/१२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.013.m4a", "display_order": 14}, {"id": 6000344014, "chapter_id": 10344, "verse_number": "१२-१२-१३", "content_sanskrit": "अवतारो भगवतः कपिलस्य महात्मनः।\nदेवहूत्याश्च संवादः कपिलेन च धीमता॥ १२/१२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.014.m4a", "display_order": 15}, {"id": 6000344015, "chapter_id": 10344, "verse_number": "१२-१२-१४", "content_sanskrit": "नवब्रह्मसमुत्पत्तिर्दक्षयज्ञविनाशनम्।\nध्रुवस्य चरितं पश्चात् पृथोः प्राचीनबर्हिषः॥ १२/१२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.015.m4a", "display_order": 16}, {"id": 6000344016, "chapter_id": 10344, "verse_number": "१२-१२-१५", "content_sanskrit": "नारदस्य च संवादस्ततः प्रैयव्रतं द्विजाः। नाभेस्ततोऽनुचरितमृषभस्य भरतस्य च\n(सप्तद्वीपसमुद्राद्रिवर्षनद्युपवर्णनम्)॥ १२/१२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.016.m4a", "display_order": 17}, {"id": 6000344017, "chapter_id": 10344, "verse_number": "१२-१२-१६", "content_sanskrit": "ज्योतिश्चक्रस्य संस्थानं पातालनरकस्थितिः। (अजामिळस्य चरितं सर्वपापप्रणाशनम्।)\nदक्षजन्म प्रचेतोभ्यस्तत्पुत्रीणां च सन्ततिः॥ १२/१२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.017.m4a", "display_order": 18}, {"id": 6000344018, "chapter_id": 10344, "verse_number": "१२-१२-१७", "content_sanskrit": "यतो देवासुरनरास्तिर्यङ्नगखगादयः।\nत्वाष्ट्रस्य जन्म निधनं पुत्रयोश्च दितेर्द्विजाः॥ १२/१२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.018.m4a", "display_order": 19}, {"id": 6000344019, "chapter_id": 10344, "verse_number": "१२-१२-१८", "content_sanskrit": "दैत्येश्वरस्य चरितं प्रह्लादस्य महात्मनः।\nमन्वन्तरानुचरितं गजेन्द्रस्य विमोक्षणम्॥ १२/१२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.019.m4a", "display_order": 20}, {"id": 6000344020, "chapter_id": 10344, "verse_number": "१२-१२-१९", "content_sanskrit": "मन्वन्तरावताराश्च विष्णोर्हयशिरादयः।\nकौर्मं मात्स्यं नारसिंहं वामनं च जगत्पतेः॥ १२/१२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.020.m4a", "display_order": 21}, {"id": 6000344021, "chapter_id": 10344, "verse_number": "१२-१२-२०", "content_sanskrit": "क्षीरोदमथनं तद्वदमृतार्थं दिवौकसाम्।\nदेवासुरमहायुद्धं राजवंशानुकीर्तनम्॥ १२/१२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.021.m4a", "display_order": 22}, {"id": 6000344022, "chapter_id": 10344, "verse_number": "१२-१२-२१", "content_sanskrit": "इक्ष्वाकुजन्म तद्वंशः सुद्युम्नस्य महात्मनः।\nइलोपाख्यानमत्रोक्तं तारोपाख्यानमेव च॥ १२/१२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.022.m4a", "display_order": 23}, {"id": 6000344023, "chapter_id": 10344, "verse_number": "१२-१२-२२", "content_sanskrit": "सूर्यवंशानुकथनं शशादाद्या नृपादयः।\nसौकन्यमथ शार्यातं ककुत्स्थस्य च धीमतः॥ १२/१२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.023.m4a", "display_order": 24}, {"id": 6000344024, "chapter_id": 10344, "verse_number": "१२-१२-२३", "content_sanskrit": "खट्वाङ्गस्य च मान्धातुः सौभरेः सगरस्य च।\nकोसलेन्द्रस्य चरितमद्भुतं किल्बिषापहम्॥ १२/१२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.024.m4a", "display_order": 25}, {"id": 6000344025, "chapter_id": 10344, "verse_number": "१२-१२-२४", "content_sanskrit": "निमेरङ्गपरित्यागो जनकानां च सम्भवः।\nरामस्य भार्गवेन्द्रस्य निःक्षत्रीकरणं भुवः॥ १२/१२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.025.m4a", "display_order": 26}, {"id": 6000344026, "chapter_id": 10344, "verse_number": "१२-१२-२५", "content_sanskrit": "ऐलस्य सोमवंशस्य ययातेर्नहुषस्य च।\nदौःषन्तेर्भरतस्यापि शन्तनोस्तत्सुतस्य च॥ १२/१२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.026.m4a", "display_order": 27}, {"id": 6000344027, "chapter_id": 10344, "verse_number": "१२-१२-२६", "content_sanskrit": "ययातेर्ज्येष्ठपुत्रस्य यदोर्वंशोऽनुकीर्तितः।\nयत्रावतीर्णो भगवान् कृष्णाख्यो जगदीश्वरः॥ १२/१२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.027.m4a", "display_order": 28}, {"id": 6000344028, "chapter_id": 10344, "verse_number": "१२-१२-२७", "content_sanskrit": "वसुदेवगृहे जन्म तस्य वृद्धिश्च गोकुले।\nतस्य कर्माण्यपाराणि कीर्तितान्यसुरद्विषः॥ १२/१२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.028.m4a", "display_order": 29}, {"id": 6000344029, "chapter_id": 10344, "verse_number": "१२-१२-२८", "content_sanskrit": "पूतनासुपयःपानं शकटोच्चाटनं शिशोः।\nतृणावर्तस्य निष्पेषस्तथैव बकवत्सयोः॥ १२/१२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.029.m4a", "display_order": 30}, {"id": 6000344030, "chapter_id": 10344, "verse_number": "१२-१२-२९", "content_sanskrit": "धेनुकस्य सह भ्रातुः प्रलम्बस्य च संक्षयः।\nगोपानां च परित्राणं दावाग्नेः परिसर्पतः॥ १२/१२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.030.m4a", "display_order": 31}, {"id": 6000344031, "chapter_id": 10344, "verse_number": "१२-१२-३०", "content_sanskrit": "दमनं कालियस्याहेर्महाहेर्नन्दमोक्षणम्।\nव्रतचर्या च कन्यानां यत्र तुष्टो व्रतैः प्रभुः॥ १२/१२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.031.m4a", "display_order": 32}, {"id": 6000344032, "chapter_id": 10344, "verse_number": "१२-१२-३१", "content_sanskrit": "प्रसादो यज्ञपत्नीभ्यो विप्राणां चानुतापनम्।\nगोवर्द्धनोद्धारणं च शक्रस्य सुरभेरथ॥ १२/१२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.032.m4a", "display_order": 33}, {"id": 6000344033, "chapter_id": 10344, "verse_number": "१२-१२-३२", "content_sanskrit": "यज्ञाभिषेकः कृष्णस्य स्त्रीभिः क्रीडा च रात्रिषु।\nशङ्खचूडस्य दुर्बुद्धेर्वधोऽरिष्टस्य केशिनः॥ १२/१२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.033.m4a", "display_order": 34}, {"id": 6000344034, "chapter_id": 10344, "verse_number": "१२-१२-३३", "content_sanskrit": "अक्रूरागमनं पश्चात् प्रस्थानं रामकृष्णयोः।\nव्रजस्त्रीणां विलापश्च मधुरालोकनं ततः॥ १२/१२/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.034.m4a", "display_order": 35}, {"id": 6000344035, "chapter_id": 10344, "verse_number": "१२-१२-३४", "content_sanskrit": "गजमुष्टिकचाणूरकंसादीनां तथा वधः।\nमृतस्यानयनं सूनोः पुनः सान्दीपनेर्गुरोः॥ १२/१२/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.035.m4a", "display_order": 36}, {"id": 6000344036, "chapter_id": 10344, "verse_number": "१२-१२-३५", "content_sanskrit": "मधुरायां निवसता यदुचक्रस्य यत् प्रियम्।\nकृतमुद्धवरामाभ्यां युतेन हरिणा द्विजाः॥ १२/१२/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.036.m4a", "display_order": 37}, {"id": 6000344037, "chapter_id": 10344, "verse_number": "१२-१२-३६", "content_sanskrit": "जरासन्धसमानीतसैन्यस्य बहुशो वधः।\nघातनं यवनेन्द्रस्य कुशस्थल्या निवेशनम्॥ १२/१२/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.037.m4a", "display_order": 38}, {"id": 6000344038, "chapter_id": 10344, "verse_number": "१२-१२-३७", "content_sanskrit": "आदानं पारिजातस्य सुधर्मायाः सुरालयात्।\nरुग्मिण्या हरणं युद्धे प्रमथ्य द्विषतो हरेः॥ १२/१२/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.038.m4a", "display_order": 39}, {"id": 6000344039, "chapter_id": 10344, "verse_number": "१२-१२-३८", "content_sanskrit": "हरस्य जृम्भृणं युद्धे बाणस्य भुजकृन्तनम्।\nप्राग्ज्योतिषपतिं हत्वा कन्यानां हरणं च यत्॥ १२/१२/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.039.m4a", "display_order": 40}, {"id": 6000344040, "chapter_id": 10344, "verse_number": "१२-१२-३९", "content_sanskrit": "चैद्यपौण्ड्रकसाल्वानां दन्तवक्रस्य दुर्मतेः।\nशम्बरो द्विविधः पीठो मुरः पञ्चजनादयः॥ १२/१२/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.040.m4a", "display_order": 41}, {"id": 6000344041, "chapter_id": 10344, "verse_number": "१२-१२-४०", "content_sanskrit": "माहात्म्यं च वधस्तेषां वाराणस्याश्च दाहनम्।\nभारावतरणं भूमेर्निमित्तीकृत्य पाण्डवान्॥ १२/१२/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.041.m4a", "display_order": 42}, {"id": 6000344042, "chapter_id": 10344, "verse_number": "१२-१२-४१", "content_sanskrit": "विप्रशापापदेशेन संहारः स्वकुलस्य च।\nवसुदेवस्य संवादो नारदेन सुरर्षिणा॥ १२/१२/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.042.m4a", "display_order": 43}, {"id": 6000344043, "chapter_id": 10344, "verse_number": "१२-१२-४२", "content_sanskrit": "उद्धवस्य च संवादो वासुदेवस्य चाद्भुतः। यत्रात्मविद्या ह्यखिलाः प्रोक्ता धर्मविनिर्णयाः।\nततो मर्त्यपरित्याग आत्मयोगानुभावतः॥ १२/१२/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.043.m4a", "display_order": 44}, {"id": 6000344044, "chapter_id": 10344, "verse_number": "१२-१२-४३", "content_sanskrit": "युगलक्षणवृत्तिश्च कलौ नॄणामुपप्लवः।\nचतुर्विधश्च प्रलय उत्पत्तिस्त्रिविधा तथा॥ १२/१२/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.044.m4a", "display_order": 45}, {"id": 6000344045, "chapter_id": 10344, "verse_number": "१२-१२-४४", "content_sanskrit": "देहत्यागश्च राजर्षेर्विष्णुदत्तस्य धीमतः।\nशाखाप्रणयनमृषेर्मार्कण्डेयस्य सत्कथाः॥ १२/१२/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.045.m4a", "display_order": 46}, {"id": 6000344046, "chapter_id": 10344, "verse_number": "१२-१२-४५", "content_sanskrit": "महापुरुषविन्यासः सूर्यस्य जगदात्मनः।\nइति चोक्तं द्विजश्रेष्ठा यत्पृष्टोऽहमिहास्मि वः॥ १२/१२/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.046.m4a", "display_order": 47}, {"id": 6000344047, "chapter_id": 10344, "verse_number": "१२-१२-४६", "content_sanskrit": "लीलावतारकर्माणि कीर्तितानीह सर्वशः। पतितः स्खलितो वाऽर्तः क्षुत्वा वा विवशो ब्रुवन्।\nहरये नम इत्युच्चैर्मुच्यते सर्वपातकात्॥ १२/१२/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.047.m4a", "display_order": 48, "topics": [{"text": "भागवतश्रवणफलम्", "range": "४६–६८"}]}, {"id": 6000344048, "chapter_id": 10344, "verse_number": "१२-१२-४७", "content_sanskrit": "संकीर्त्यमानो भगवाननन्तः श्रुतानुभावो व्यसनं हि पुंसाम्।\nप्रविश्य चित्तं विधुनोत्यशेषं यथा तमोऽर्कोऽभ्रमिवातिवातः॥ १२/१२/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.048.m4a", "display_order": 49}, {"id": 6000344049, "chapter_id": 10344, "verse_number": "१२-१२-४८", "content_sanskrit": "मृषा गिरस्ता ह्यसतीरसत्कथा न कथ्यते यद् भगवानधोक्षजः।\nतदेव सत्यं तदु हैव मङ्गलं तदेव पुण्यं भगवद्गुणोदयम्॥ १२/१२/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.049.m4a", "display_order": 50}, {"id": 6000344050, "chapter_id": 10344, "verse_number": "१२-१२-४९", "content_sanskrit": "तदेव पुण्यं रुचिरं नवं नवं तदेव शश्वन्मनसो महोत्सवम्।\nतदेव शोकार्णवशोषणं नृणां यत्रोत्तमश्लोकयशोऽनुगीयते॥ १२/१२/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.050.m4a", "display_order": 51}, {"id": 6000344051, "chapter_id": 10344, "verse_number": "१२-१२-५०", "content_sanskrit": "न यद्वचश्चित्रपदं हरेर्यशो जगत्पवित्रं यदि कर्हिचिद् वदेत्।\nतद् ध्वाङ्क्षतीर्थं न तु हंससेवितं यत्राच्युतस्तत्र हि साधवोऽमलाः॥ १२/१२/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.051.m4a", "display_order": 52}, {"id": 6000344052, "chapter_id": 10344, "verse_number": "१२-१२-५१", "content_sanskrit": "स वाग्विसर्गो जनताघविप्लवो यस्मिन् प्रतिश्लोकमबद्धवत्यपि।\nनामान्यनन्तस्य यशोऽङ्कितानि यच्छृण्वन्ति गायन्ति गृणन्ति साधवः॥ १२/१२/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.052.m4a", "display_order": 53}, {"id": 6000344053, "chapter_id": 10344, "verse_number": "१२-१२-५२", "content_sanskrit": "नैष्कर्म्यमप्यच्युतभाववर्जितं न शोभते ज्ञानमलं निरञ्जनम्।\nकुतः पुनः शश्वदभद्रमीश्वरे न चार्पितं कर्म यदप्यकारणम्॥ १२/१२/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.053.m4a", "display_order": 54}, {"id": 6000344054, "chapter_id": 10344, "verse_number": "१२-१२-५३", "content_sanskrit": "यशःश्रियामेव परिश्रमः परो वर्णाश्रमाचारतपःश्रुतादिषु।\nअविस्मृतिः श्रीधरपादपद्मयोर्गुणानुवादश्रवणादिभिर्हरेः॥ १२/१२/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.054.m4a", "display_order": 55}, {"id": 6000344055, "chapter_id": 10344, "verse_number": "१२-१२-५४", "content_sanskrit": "अविस्मृतिः कृष्णपदारविन्दयोः क्षिणोत्यभद्राणि शमं तनोति च।\nसत्त्वस्य शुद्धिं परमां च भक्तिं ज्ञानं च विज्ञानविरागयुक्तम्॥ १२/१२/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.055.m4a", "display_order": 56}, {"id": 6000344056, "chapter_id": 10344, "verse_number": "१२-१२-५५", "content_sanskrit": "यूयं द्विजाग्य्रा बत भूरिभागा यच्छश्वदात्मन्यखिलात्मभूतम्।\nनारायणं देवमदेवमीशमबाह्यभावा भजताधिवेश्य॥ १२/१२/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.056.m4a", "display_order": 57}, {"id": 6000344057, "chapter_id": 10344, "verse_number": "१२-१२-५६", "content_sanskrit": "अहं च संस्मारित आत्मतत्वं श्रुतं पुराणं परमर्षिवक्त्रात्।\nप्रायोपवेशे नृपतेः परीक्षितः सदस्यृषीणां महतां च शृण्वताम्॥ १२/१२/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.057.m4a", "display_order": 58}, {"id": 6000344058, "chapter_id": 10344, "verse_number": "१२-१२-५७", "content_sanskrit": "एतद् वः कथितं विप्राः कथनीयोरुकर्मणः।\nमाहात्म्यं वासुदेवस्य सर्वाशुभविनाशनम्॥ १२/१२/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.058.m4a", "display_order": 59}, {"id": 6000344059, "chapter_id": 10344, "verse_number": "१२-१२-५८", "content_sanskrit": "यश्च संश्रावयेन्नित्यं यामं क्षणमनन्यधीः।\nश्रद्धावान् यश्च शृणुयात् पुनात्यात्मानमेव सः॥ १२/१२/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.059.m4a", "display_order": 60}, {"id": 6000344060, "chapter_id": 10344, "verse_number": "१२-१२-५९", "content_sanskrit": "द्वादश्यामेकदश्यां वा शृण्वन्नायुष्यवान् भवेत्।\nपठन्ननश्नन् प्रयतः पूतो भवति पातकी॥ १२/१२/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.060.m4a", "display_order": 61}, {"id": 6000344061, "chapter_id": 10344, "verse_number": "१२-१२-६०", "content_sanskrit": "पुष्करे मधुरायां च द्वारवत्यां यतात्मवान्।\nउपोष्य संहितामेतां पठित्वा मुच्यते भयात्॥ १२/१२/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.061.m4a", "display_order": 62}, {"id": 6000344062, "chapter_id": 10344, "verse_number": "१२-१२-६१", "content_sanskrit": "देवता मुनयः सिद्धाः पितरो मनवो नृपाः।\nयच्छन्ति कामान् बहुलान् शृण्वतो येऽत्र कीर्तिताः॥ १२/१२/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.062.m4a", "display_order": 63}, {"id": 6000344063, "chapter_id": 10344, "verse_number": "१२-१२-६२", "content_sanskrit": "ऋचो यजूंषि सामानि द्विजोऽधीत्यानुविन्दते।\nमधुकुल्याः पयःकुल्या घृतकुल्याश्च तत्फलम्॥ १२/१२/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.063.m4a", "display_order": 64}, {"id": 6000344064, "chapter_id": 10344, "verse_number": "१२-१२-६३", "content_sanskrit": "पुराणसंहितामेतामधीत्य प्रयतो द्विजः।\nप्रोक्तं भगवता विष्णोस्तत्पदं परमं व्रजेत्॥ १२/१२/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.064.m4a", "display_order": 65}, {"id": 6000344065, "chapter_id": 10344, "verse_number": "१२-१२-६४", "content_sanskrit": "विप्रोऽधीत्याप्नुयात् प्रज्ञां राजन्योऽम्बुधिमेखलाम्।\nवैश्यो निधिपतित्वं च शूद्रः शुद्ध्येत पातकात्॥ १२/१२/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.065.m4a", "display_order": 66}, {"id": 6000344066, "chapter_id": 10344, "verse_number": "१२-१२-६५", "content_sanskrit": "कलिमलसंसृतिकालनोऽखिलेशो हरिरितरत्र न गीयते ह्यभीक्ष्णम्।\nइह तु पुनर्भगवानशेषमूर्तिः परिपठितोऽनुपदं कथाप्रसङ्गैः॥ १२/१२/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.066.m4a", "display_order": 67}, {"id": 6000344067, "chapter_id": 10344, "verse_number": "१२-१२-६६", "content_sanskrit": "स्वसुखनिभृतचेतास्तद्व्युदस्तान्यभावोऽप्यजितरुचिरलीलाकृष्टसारस्तदीयम्।\nव्यतनुत कृपया यस्तत्वदीपं पुराणं तमखिलवृजिनघ्नं व्याससूनुं नतोऽस्मि॥ १२/१२/६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.067.m4a", "display_order": 68}, {"id": 6000344068, "chapter_id": 10344, "verse_number": "१२-१२-६७", "content_sanskrit": "तमहमजमनन्तमात्मतन्त्रं जगदुदयस्थितिसंयमात्मशक्तिम्।\nद्युपतिभिरजशक्रशङ्कराद्यैर्दुरवसितस्तवमच्युतं नतोऽस्मि॥ १२/१२/६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.068.m4a", "display_order": 69}, {"id": 6000344069, "chapter_id": 10344, "verse_number": "१२-१२-६८", "content_sanskrit": "उपचितनवशक्तिभिः स्व आत्मन्युपरचितस्थिरजङ्गमपालनाय।\nभगवत उपलब्धिमात्रधाम्ने सुरऋषभाय नमः सनातनाय॥ १२/१२/६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_012/BhP_12.012.069.m4a", "display_order": 70}, {"id": 6000344070, "chapter_id": 10344, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां द्वादशस्कन्धे द्वादशाध्यायः॥\n॥ इति समाप्तं श्रीमद्भागवतम् ॥\n॥ समाप्तोऽयं ग्रन्थः॥\n॥श्रीकृष्णार्पणमस्तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]