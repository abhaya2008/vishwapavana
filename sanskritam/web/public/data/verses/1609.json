[{"id": 2028199, "chapter_id": 1609, "verse_number": "३-२४७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2028200, "chapter_id": 1609, "verse_number": "३-२४७-१", "content_sanskrit": "ततोऽर्जुनश्चित्रसेनं प्रहसन्निदमब्रवीत्।\nमध्ये गन्धर्वसैन्यानां महेष्वासो महाद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2028201, "chapter_id": 1609, "verse_number": "३-२४७-२", "content_sanskrit": "किं ते व्यवसितं वीर कौरवाणां विनिग्रहे।\nकिमर्थं च सदारोऽयं निगृहीतः सुयोधनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2028202, "chapter_id": 1609, "verse_number": "३-२४७-३x", "content_sanskrit": "चित्रसेन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2028203, "chapter_id": 1609, "verse_number": "३-२४७-३", "content_sanskrit": "विदितोऽयमभिप्रायस्तत्रस्थेन दुरात्मनः।\nइन्द्रेण धार्तराष्ट्रस्य सकर्णस्य धनंजय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2028204, "chapter_id": 1609, "verse_number": "३-२४७-४", "content_sanskrit": "वनस्थान्भवतो ज्ञात्वा क्लिश्यमानाननर्हवत्।\nसमस्थो विषमस्थांस्तान्द्रक्ष्यामीत्यनवस्थितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2028205, "chapter_id": 1609, "verse_number": "३-२४७-५", "content_sanskrit": "इमेऽवहसितुं प्राप्ता द्रौपदीं च यशस्विनीम्।\nज्ञात्वा चिकीर्षितं चैषां मामुवाच सुरेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2028206, "chapter_id": 1609, "verse_number": "३-२४७-६", "content_sanskrit": "गच्छ दुर्योधनं बद्ध्वा सहामात्यमिहानय।\nधनंजयश्च ते रक्ष्यः रसह भ्रातृभिराहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2028207, "chapter_id": 1609, "verse_number": "३-२४७-७", "content_sanskrit": "स च प्रियः सखा तुभ्यं शिष्यश् तव पाण्डवः।\nवचनाद्देवराजस् ततोऽस्मीहागतो द्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2028208, "chapter_id": 1609, "verse_number": "३-२४७-८", "content_sanskrit": "अयं दुरात्मा बद्धश्च गमिष्यामि सुरालयम्।\nनेष्याम्येनं कदुरात्मानं पाकशासनशासनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2028209, "chapter_id": 1609, "verse_number": "३-२४७-९x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2028210, "chapter_id": 1609, "verse_number": "३-२४७-९", "content_sanskrit": "उत्सृज्यतां चित्रसेन भ्राताऽस्माकं सुयोधनः।\nधर्मराजस्य संदेशान्मम चेदिच्छसि प्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2028211, "chapter_id": 1609, "verse_number": "३-२४७-१०x", "content_sanskrit": "चित्रसेन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2028212, "chapter_id": 1609, "verse_number": "३-२४७-१०", "content_sanskrit": "पापोऽयं नित्यसंदुष्टो न विमोक्षणमर्हति।\nप्रलब्धा धर्मराजस्य कृष्णायाश्च धनंजय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2028213, "chapter_id": 1609, "verse_number": "३-२४७-११", "content_sanskrit": "नेदं चिकीर्षितं तस् कुन्तीपुत्रो युधिष्ठिरः।\nजानाति धर्मराजो हि श्रुत्वा कुरु यथेच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2028214, "chapter_id": 1609, "verse_number": "३-२४७-१२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2028215, "chapter_id": 1609, "verse_number": "३-२४७-१२", "content_sanskrit": "ते सर्व एव राजनमभिजग्मुर्युधिष्ठिरम्।\nअभिगम्य च तत्सर्वं शशंसुस्तस्य चेष्टितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2028216, "chapter_id": 1609, "verse_number": "३-२४७-१३", "content_sanskrit": "अजातशत्रुस्तच्छ्रुत्वा गन्धर्वस्य वचस्तदा।\nमोक्षयामास तान्सर्वान्गन्धर्वान्प्रशशंस च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2028217, "chapter_id": 1609, "verse_number": "३-२४७-१४", "content_sanskrit": "`चित्रसेनस्तदा वाक्यमुवाच प्रौढया गिरा।\nमुञ्चध्वंसानुजामात्यं सदारं च सुयोधनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2028218, "chapter_id": 1609, "verse_number": "३-२४७-१५", "content_sanskrit": "गन्धर्वास्तु वचः श्रुत्वा चित्रसेनस्य वै द्रुतम्।\nराजानं मोचयामासुर्बद्धं निगडबन्धनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2028219, "chapter_id": 1609, "verse_number": "३-२४७-१६", "content_sanskrit": "सदारं सानुगामात्यं बालजालमयेन ये।\nलुछन्तश्चापि ते सर्वे युधिष्ठिरसमीपतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2028220, "chapter_id": 1609, "verse_number": "३-२४७-१७", "content_sanskrit": "पतिता लज्जिताश्चैव तस्थुश्चाधोमुखास्तदा।\nयुधिष्ठिरोपि दयया तान्समीक्ष्य तथागतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2028221, "chapter_id": 1609, "verse_number": "३-२४७-१८", "content_sanskrit": "दिष्ट्या भवद्भिर्बलिभिः शक्तैः सर्वैर्न हिंसितः।\nदुर्वृत्तो धार्तराष्ट्रोऽयं सामात्यज्ञातिबान्धवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2028222, "chapter_id": 1609, "verse_number": "३-२४७-१९", "content_sanskrit": "उपकारो मसांस्तात कृतोऽयं मम खेचर।\nकुलं न परिभूतं मे मोक्षेणास्य दुरात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2028223, "chapter_id": 1609, "verse_number": "३-२४७-२०", "content_sanskrit": "आज्ञापयध्वमिष्टानि प्रीतं मां दर्शनेन वः।\nप्राप्य सर्वानभिप्रायांस्ततो व्रजत मा चिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2028224, "chapter_id": 1609, "verse_number": "३-२४७-२१", "content_sanskrit": "अनुज्ञातास्तु गन्धर्वाः पाण्डुपुत्रेण धीमता।\nसहाप्सरोभिः संहृष्टाश्चित्रसेनमुखा ययुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2028225, "chapter_id": 1609, "verse_number": "३-२४७-२२", "content_sanskrit": "`देवलोकं ततो गत्वा गन्धर्वैः सहितस्तदा।\nन्यवेदयच्च तत्सर्वं चित्रसेनः शतक्रतोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2028226, "chapter_id": 1609, "verse_number": "३-२४७-२३", "content_sanskrit": "देवराडपि गन्धर्वान्मृतांस्तान्समजीवयत्।\nदिव्येनामृतवर्षेण ये हताः कौरवैर्युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2028227, "chapter_id": 1609, "verse_number": "३-२४७-२४", "content_sanskrit": "ज्ञातींस्तानवमुच्याथ राजदारांश्च सर्वशः।\nकृत्वा च रदुष्करं कर्म प्रीतियुक्ताश्च पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2028228, "chapter_id": 1609, "verse_number": "३-२४७-२५", "content_sanskrit": "सस्त्रीकुमारैः कुरुभिः पूज्यमाना महारथाः।\nबभ्राजिरे महात्मानः क्रतुमध्ये यथाऽग्नयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2028229, "chapter_id": 1609, "verse_number": "३-२४७-२६", "content_sanskrit": "ततो दुर्योधनं मुक्तं भ्रातृभिः सहितस्तदा।\nयुधिष्ठिरस्तु प्रणयादिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2028230, "chapter_id": 1609, "verse_number": "३-२४७-२७", "content_sanskrit": "रमा स्म तात पुनः कार्षीरीदृशं साहसं क्वचित्।\nन हि साहसकर्तारः सुखमेघन्ति भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2028231, "chapter_id": 1609, "verse_number": "३-२४७-२८", "content_sanskrit": "स्वस्तिमान्सहितः सर्वैर्ब्रातृभिः कुरुनन्दन।\nगृहान्व्रज यथाकामं वैमनस्यं च मा कृथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2028232, "chapter_id": 1609, "verse_number": "३-२४७-२९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2028233, "chapter_id": 1609, "verse_number": "३-२४७-२९", "content_sanskrit": "पाण्डवेनाभ्यनुज्ञानो राजा दुर्योधनस्तदा।\nअभिवाद्य धर्मपुत्रं गतेन्द्रिय इवातुरः।\nविदीर्यमाणो व्रीडावाञ्जगाम नगरं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2028234, "chapter_id": 1609, "verse_number": "३-२४७-३०", "content_sanskrit": "तस्मिन्गते कौरवेये कुन्तीपुत्रो युधिष्ठिरः।\nभ्रातृभिः सहितो वीरः पूज्यमानो द्विजातिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2028235, "chapter_id": 1609, "verse_number": "३-२४७-३१", "content_sanskrit": "तपोधनैश्च तैः सर्वैर्वृतः शक्र इवामरैः।\nतथा द्वैतवने तस्मिन्विजहार मुदा युतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2028236, "chapter_id": 1609, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि घोषयात्रापर्वणि सप्तचत्वारिंशदधिकद्विशततमोऽध्यायः ॥ २४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]