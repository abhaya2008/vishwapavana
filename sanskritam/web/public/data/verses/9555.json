[{"id": 5000555000, "chapter_id": 9555, "verse_number": "७-२०-१", "content_sanskrit": "ततो वित्रासयन्मर्त्यान्पृथिव्यां राक्षसाधिपः ।\nआससाद घने तस्मिन्नारदं मुनिपुङ्गवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000555001, "chapter_id": 9555, "verse_number": "७-२०-२", "content_sanskrit": "तस्याभिवादनं कृत्वा दशग्रीवो निशाचरः ।\nअब्रवीत्कुशलं पृष्ट्वा हेतुमागमनस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000555002, "chapter_id": 9555, "verse_number": "७-२०-३", "content_sanskrit": "नारदस्तु महातेजा देवर्षिरमितप्रभः ।\nअब्रवीन्मेघपृष्ठस्थो रावणं पुष्पके स्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000555003, "chapter_id": 9555, "verse_number": "७-२०-४", "content_sanskrit": "राक्षसाधिपते सौम्य तिष्ठ विश्रवसः सुत ।\nप्रीतो ऽस्म्यभिजनोपेतविक्रमैरूर्जितैस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000555004, "chapter_id": 9555, "verse_number": "७-२०-५", "content_sanskrit": "विष्णुना दैत्यघातैश्च गन्धर्वोरगधर्षणैः ।\nत्वया समं विमर्दैश्च भृशं हि परितोषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000555005, "chapter_id": 9555, "verse_number": "७-२०-६", "content_sanskrit": "किंचिद्वक्ष्यामि तावत्ते श्रोतव्यं श्रोष्यसे यदि ।\nश्रुत्वा चानन्तरं कार्यं त्वया राक्षससत्तम ।\nतन्मे निगदतस्तात समाधिं श्रवणे कुरु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000555006, "chapter_id": 9555, "verse_number": "७-२०-७", "content_sanskrit": "किमयं वध्यते तात त्वया ऽवध्येन दैवतैः ।\nहत एव ह्ययं लोको यदा मृत्युवशं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000555007, "chapter_id": 9555, "verse_number": "७-२०-८", "content_sanskrit": "्तम ।\nदेवदानवदैत्यानां यक्षगन्धर्वरक्षसाम् ।\nअवध्येन त्वया लोकः क्लेष्टुं युक्तो न मानुषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000555008, "chapter_id": 9555, "verse_number": "७-२०-९", "content_sanskrit": "नित्यं श्रेयसि सम्मूढं महद्भिर्व्यसनैर्वृतम् ।\nहन्यात्कस्तादृशं लोकं जराव्याधिशतैर्युतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000555009, "chapter_id": 9555, "verse_number": "७-२०-१०", "content_sanskrit": "तैस्तैरनिष्टोपगमैरजस्रं यत्र कुत्र कः ।\nमतिमान्मानुषे लोके युद्धेन प्रणयी भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000555010, "chapter_id": 9555, "verse_number": "७-२०-११", "content_sanskrit": "क्षीयमाणं दैवहतं श्रुत्पिपासाजरादिभिः ।\nविषादशोकसम्मूढं लोकं त्वं क्षपयस्व मा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000555011, "chapter_id": 9555, "verse_number": "७-२०-१२", "content_sanskrit": "पश्य तावन्महाबाहो राक्षसेश्वर मानुषम् ।\nमूढमेवं विचित्रार्थं यस्य न ज्ञायते गतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000555012, "chapter_id": 9555, "verse_number": "७-२०-१३", "content_sanskrit": "क्वचिद्वादित्रनृत्यादि सेव्यते मुदितैर्जनैः ।\nरुद्यते चापरैरार्तैर्धाराश्रुनयनाननैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000555013, "chapter_id": 9555, "verse_number": "७-२०-१४", "content_sanskrit": "मातापितृसुतस्नेहैर्भार्याबन्धुमनोरमैः ।\nमोहितो ऽयं जनो ध्वस्तः क्लेशं स्वं नावबुध्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000555014, "chapter_id": 9555, "verse_number": "७-२०-१५", "content_sanskrit": "अलमेनं परिक्लिश्य लोकं मोहनिराकृतम् ।\nजित एव त्वया सौम्य मर्त्यलोको न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000555015, "chapter_id": 9555, "verse_number": "७-२०-१६", "content_sanskrit": "अवश्यमेभिः सर्वैश्च गन्तव्यं यमसादनम् ।\nतन्निगृह्णीष्व पौलस्त्य यमं परपुरञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000555016, "chapter_id": 9555, "verse_number": "७-२०-१७", "content_sanskrit": "तस्मिञ्जिते जितं सर्वं भवत्येव न संशयः ।\nएवमुक्तस्तु लङ्केशो दीप्यमानं स्वतेजसा ।\nअब्रवीन्नारदं तत्र सम्प्रहस्याभिवाद्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000555017, "chapter_id": 9555, "verse_number": "७-२०-१८", "content_sanskrit": "महर्षे देवगन्धर्वविहार समरप्रिय ।\nअहं समुद्यतो गन्तुं विजयार्थं रसातलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000555018, "chapter_id": 9555, "verse_number": "७-२०-१९", "content_sanskrit": "ततो लोकत्रयं जित्वा स्थाप्य नागान्सुरान्वशे ।\nसमुद्रममृतार्थं च मथिष्यामि रसालयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000555019, "chapter_id": 9555, "verse_number": "७-२०-२०", "content_sanskrit": "अथाब्रवीदृशग्रीवं नारदो भगवानृषिः ।\nक्व खल्विदानीं मार्गेण त्वया ह्यन्येन गम्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000555020, "chapter_id": 9555, "verse_number": "७-२०-२१", "content_sanskrit": "अयं खलु सुदुर्गम्यः प्रेतराजपुरं प्रति ।\nमार्गो गच्छति दुर्धर्षो यमस्यामित्रकर्शन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000555021, "chapter_id": 9555, "verse_number": "७-२०-२२", "content_sanskrit": "स तु शारदमेघाभं हासं मुक्त्वा दशाननः ।\nउवाच कृतमित्येव वचनं चेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000555022, "chapter_id": 9555, "verse_number": "७-२०-२३", "content_sanskrit": "तस्मादेवमहं ब्रह्मन् वैवस्वतवधोद्यतः ।\nगच्छामि दक्षिणामाशां यत्र सूर्यात्मजो नृपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000555023, "chapter_id": 9555, "verse_number": "७-२०-२४", "content_sanskrit": "मया हि भगवन्क्रोधात्प्रतिज्ञातं रणार्थिना ।\nअवजेष्यामि चतुरो लोकपालानिति प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000555024, "chapter_id": 9555, "verse_number": "७-२०-२५", "content_sanskrit": "तदिह प्रस्थितो ऽहं वै प्रेतराजपुरं प्रति ।\nप्राणिसङ्क्लेशकर्तारं योजयिष्यामि मृत्युना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000555025, "chapter_id": 9555, "verse_number": "७-२०-२६", "content_sanskrit": "एवमुक्त्वा दशग्रीवो मुनिं तमभिवाद्य च ।\nप्रययौ दक्षिणामाशां प्रविष्टः सह मन्त्रिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000555026, "chapter_id": 9555, "verse_number": "७-२०-२७", "content_sanskrit": "नारदस्तु महातेजा मुहूर्तं ध्यानमास्थितः ।\nचिन्तयामास विप्रेन्द्रो विधूम इव पावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000555027, "chapter_id": 9555, "verse_number": "७-२०-२८", "content_sanskrit": "येन लोकास्त्रयः सेन्द्राः क्लिश्यन्ते सचराचराः ।\nक्षीणे चायुषि धर्मेण स कालो जेष्यते कथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000555028, "chapter_id": 9555, "verse_number": "७-२०-२९", "content_sanskrit": "स्वदत्तकृतसाक्षी यो द्वितीय इव पावकः ।\nलब्धसञ्ज्ञा विजेष्यन्ते लोका यस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000555029, "chapter_id": 9555, "verse_number": "७-२०-३०", "content_sanskrit": "यस्य नित्यं त्रयो लोका विद्रवन्ति भयार्दिताः ।\nतं कथं राक्षसेन्द्रो ऽसौ स्वयमेव गमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000555030, "chapter_id": 9555, "verse_number": "७-२०-३१", "content_sanskrit": "यो विधाता च धाता च सुकृतं दुष्कृतं तथा ।\nत्रैलोक्यं विजितं येन तं कथं विजयिष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000555031, "chapter_id": 9555, "verse_number": "७-२०-३२", "content_sanskrit": "अपरं किन्तु कृत्वायं विधानं संविधास्यति ।\nकौतूहलसमुत्पन्नो यास्यामि यमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000555032, "chapter_id": 9555, "verse_number": "७-२०-३३", "content_sanskrit": "विमर्दं द्रष्टुमनयोर्यमराक्षसयोः स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000555033, "chapter_id": 9555, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे विंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]