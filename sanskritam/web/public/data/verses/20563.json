[{"id": 7000563000, "chapter_id": 20563, "verse_number": "५-२२-१", "content_sanskrit": "सुमतिरुवाच ।\nअथ सर्वं दिनं नीत्वा हरिस्मरणकीर्तनैः ।\nरात्रौ सुष्वाप गंगाया रोधस्युरुफलप्रदे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000563001, "chapter_id": 20563, "verse_number": "५-२२-२", "content_sanskrit": "ददर्श स्वप्नमध्ये तु स स्वात्मानं चतुर्भुजम् ।\nशंखचक्रगदापद्मशार्ङ्गकोदंडधारिणम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000563002, "chapter_id": 20563, "verse_number": "५-२२-३", "content_sanskrit": "नृत्यंतं पुरुषोत्तमस्य पुरतः शर्वादि देवैः सह ।\nश्रीमद्भिः स्वतनूयुतैररिगदांबूत्थाब्जहेत्यादिभिः ।\nविष्वक्सेनवरैर्गणैः सुतनुभिः श्रीशंसदोपासितं ।\nदृष्ट्वा विस्मयमाप लोकविषयं हर्षं तथात्यद्भुतम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000563003, "chapter_id": 20563, "verse_number": "५-२२-४", "content_sanskrit": "ददतं मनसोऽभीष्टं पुरुषोत्तमसंज्ञितम् ।\nआत्मानं च कृपापात्रममन्यत महामतिः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000563004, "chapter_id": 20563, "verse_number": "५-२२-५", "content_sanskrit": "इत्येवं स्वप्नविषये ददर्श नृपसत्तमः ।\nप्रातः प्रबुद्धो विप्राय जगाद स्वप्नमीक्षितम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000563005, "chapter_id": 20563, "verse_number": "५-२२-६", "content_sanskrit": "तच्छ्रुत्वा वाडवो धीमान्कथयामास विस्मितः ।\nराजंस्त्वयासौ दृष्टो यः पुरुषोत्तमसंज्ञितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000563006, "chapter_id": 20563, "verse_number": "५-२२-७", "content_sanskrit": "दास्यते शंखचक्रादिचिह्नितां स्वतनुं हरिः ।\nइति श्रुत्वा तु तद्वाक्यं रत्नग्रीवो महामनाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000563007, "chapter_id": 20563, "verse_number": "५-२२-८", "content_sanskrit": "दापयामास दानानि दीनानां मानसोचितम् ।\nस्नात्वा गंगाब्धिसंयोगे तर्पयित्वा पितॄन्सुरान् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000563008, "chapter_id": 20563, "verse_number": "५-२२-९", "content_sanskrit": "गायन्हरिगुणग्रामं प्रत्यैक्षत च दर्शनम् ।\nततो मध्याह्नसमये दिविदुंदुभयो मुहुः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000563009, "chapter_id": 20563, "verse_number": "५-२२-१०", "content_sanskrit": "जघ्नुः सुरकराघात बहुशब्दसुशब्दिताः ।\nअकस्मात्पुष्पवृष्टिश्च बभूव नृपमस्तके ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000563010, "chapter_id": 20563, "verse_number": "५-२२-११", "content_sanskrit": "धन्योसि नृपवर्यस्त्वं नीलं पश्याक्षिगोचरम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000563011, "chapter_id": 20563, "verse_number": "५-२२-१२", "content_sanskrit": "शृणोतीति यदा वाक्यं नृपो देवप्रणोदितम् ।\nतदा स सूर्यकोटीनामधिकांति धरोद्भुतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000563012, "chapter_id": 20563, "verse_number": "५-२२-१३", "content_sanskrit": "राज्ञोऽक्षिगोचरो जातो नीलनामा महागिरिः ।\nराजतैः कानकैः शृंगैः समंतात्परिराजितः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000563013, "chapter_id": 20563, "verse_number": "५-२२-१४", "content_sanskrit": "किमग्निः प्रज्वलत्येष द्वितीयः किमु भास्करः ।\nकिमयं वैद्युतः पुंजो ह्यकस्मात्स्थिरकांतिधृक् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000563014, "chapter_id": 20563, "verse_number": "५-२२-१५", "content_sanskrit": "तापस ब्राह्मणो दृष्ट्वा नीलप्रस्थं सुशोभितम् ।\nराज्ञे निवेदयामास एष पुण्यो महागिरिः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000563015, "chapter_id": 20563, "verse_number": "५-२२-१६", "content_sanskrit": "तच्छ्रुत्वा नृपतिश्रेष्ठः शिरसा प्रणनाम ह ।\nधन्योऽस्मि कृतकृत्योऽस्मि नीलो मे दृष्टिगोचरः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000563016, "chapter_id": 20563, "verse_number": "५-२२-१७", "content_sanskrit": "अमात्यो राजपत्नी च करम्बस्तंतुवायकः ।\nनीलदर्शनसंहृष्टा बभूवुः पुरुषर्षभ ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000563017, "chapter_id": 20563, "verse_number": "५-२२-१८", "content_sanskrit": "पंचैते विजये काले नीलपर्वतमारुहन् ।\nमहादुंदुभिनिर्घोषाञ्च्छृण्वन्तो ह्यमरैः कृतान् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000563018, "chapter_id": 20563, "verse_number": "५-२२-१९", "content_sanskrit": "तस्योपरितने शृंगे चित्रपादपराजिते ।\nददर्श हाटकाबद्धं देवालयमनुत्तमम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000563019, "chapter_id": 20563, "verse_number": "५-२२-२०", "content_sanskrit": "ब्रह्मागत्य सदा पूजां करोति परमेष्ठिनः ।\nनैवेद्यं कुरुते यत्र हरिसंतोषकारकम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000563020, "chapter_id": 20563, "verse_number": "५-२२-२१", "content_sanskrit": "दृष्ट्वाथ तत्र विमलं देवायतनमुत्तमम् ।\nप्रविवेश परीवारैः पंचभिः सह संवृतः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000563021, "chapter_id": 20563, "verse_number": "५-२२-२२", "content_sanskrit": "तत्र दृष्ट्वा जातरूपे महामणिविचित्रिते ।\nसिंहासने विराजंतं चतुर्भुजमनोहरम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000563022, "chapter_id": 20563, "verse_number": "५-२२-२३", "content_sanskrit": "चंड प्रचंड विजय जयादिभिरुपासितम् ।\nप्रणनाम सपत्नीको राजा सेवकसंयुतः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000563023, "chapter_id": 20563, "verse_number": "५-२२-२४", "content_sanskrit": "प्रणम्य परमात्मानं महाराजः सुरोत्तमम् ।\nस्नापयामास विधिवद्वेदोक्तैः स्नानमंत्रकैः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000563024, "chapter_id": 20563, "verse_number": "५-२२-२५", "content_sanskrit": "अर्घ्यपाद्यादिकं चक्रे प्रीतेन मनसा नृपः ।\nचंदनेन विलिप्यैनं सुवस्त्रे विनिवेद्य च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000563025, "chapter_id": 20563, "verse_number": "५-२२-२६", "content_sanskrit": "धूपमारार्तिकं कृत्वा सर्वस्वादुमनोहरम् ।\nनैवेद्यं भगवन्मूर्त्यै न्यवेदयदथो नृपः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000563026, "chapter_id": 20563, "verse_number": "५-२२-२७", "content_sanskrit": "प्रणम्य च स्तुतिं चक्रे तापसब्राह्मणेन च ।\nयथामतिगुणग्रामगुंफितस्तोत्रसंचयैः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000563027, "chapter_id": 20563, "verse_number": "५-२२-२८", "content_sanskrit": "राजोवाच ।\nएकस्त्वं पुरुषः साक्षाद्भगवान्प्रकृतेः परः ।\nकार्यकारणतो भिन्नो महत्तत्त्वादिपूजितः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000563028, "chapter_id": 20563, "verse_number": "५-२२-२९", "content_sanskrit": "त्वन्नाभिकमलाज्जज्ञे ब्रह्मा सृष्टिविचक्षणः ।\nतथा संहारकर्ता च रुद्रस्त्वन्नेत्रसंभवः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000563029, "chapter_id": 20563, "verse_number": "५-२२-३०", "content_sanskrit": "त्वयाज्ञप्तः करोत्यस्य विश्वस्य परिचेष्टितम् ।\nत्वत्तो जातं पुराणाद्यज्जगत्स्थास्नु चरिष्णु च ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000563030, "chapter_id": 20563, "verse_number": "५-२२-३१", "content_sanskrit": "चेतनाशक्तिमाविश्य त्वमेनं चेतयस्यहो ।\nतव जन्म तु नास्त्येव नांतस्तव जगत्पते ।\nवृद्धिक्षयपरीणामास्त्वयि संत्येव नो विभो ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000563031, "chapter_id": 20563, "verse_number": "५-२२-३२", "content_sanskrit": "तथापि भक्तरक्षार्थं धर्मस्थापनहेतवे ।\nकरोषि जन्मकर्माणि ह्यनुरूपगुणानि च ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000563032, "chapter_id": 20563, "verse_number": "५-२२-३३", "content_sanskrit": "त्वया मात्स्यं वपुर्धृत्वा शंखस्तु निहतोसुरः ।\nवेदाः सुरक्षिता ब्रह्मन्महापुरुषपूर्वज ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000563033, "chapter_id": 20563, "verse_number": "५-२२-३४", "content_sanskrit": "शेषो न वेत्ति महि ते भारत्यपि महेश्वरी ।\nकिमुतान्ये महाविष्णो मादृशास्तु कुबुद्धयः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000563034, "chapter_id": 20563, "verse_number": "५-२२-३५", "content_sanskrit": "मनसा त्वां न चाप्नोति वागियं परमेश्वरी ।\nतस्मादहं कथं त्वां वै स्तोतुं स्यामीश्वरः प्रभो ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000563035, "chapter_id": 20563, "verse_number": "५-२२-३६", "content_sanskrit": "इति स्तुत्वा स शिरसा प्रणाममकरोन्मुहुः ।\nगद्गदस्वरसंयुक्तो रोमहर्षांकितांगकः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000563036, "chapter_id": 20563, "verse_number": "५-२२-३७", "content_sanskrit": "इति स्तुत्या प्रहृष्टात्मा भगवान्पुरुषोत्तमः ।\nउवाच वचनं सत्यं राजानं प्रति सार्थकम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000563037, "chapter_id": 20563, "verse_number": "५-२२-३८", "content_sanskrit": "श्रीभगवानुवाच ।\nतव स्तुत्या प्रहर्षोऽभून्मम राजन्महामते ।\nजानीहि त्वं महाराज मां च प्रकृतितः परम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000563038, "chapter_id": 20563, "verse_number": "५-२२-३९", "content_sanskrit": "नैवेद्यभक्षणं त्वं हि शीघ्रं कुरु मनोहरम् ।\nचतुर्भुजत्वमाप्तः सन्गंतासि परमं पदम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000563039, "chapter_id": 20563, "verse_number": "५-२२-४०", "content_sanskrit": "त्वत्कृत्स्तुतिरत्नेन यो मां स्तोष्यति मानवः ।\nतस्यापि दर्शनं दास्ये भुक्तिमुक्तिवरप्रदम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000563040, "chapter_id": 20563, "verse_number": "५-२२-४१", "content_sanskrit": "इत्येवं वचनं राजा श्रुत्वा भगवतोदितम् ।\nनैवेद्यभक्षणं चक्रे चतुर्भिः सह सेवकैः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000563041, "chapter_id": 20563, "verse_number": "५-२२-४२", "content_sanskrit": "ततो विमानं संप्राप्तं किंकिणीजालमंडितम् ।\nअप्सरोवृंदसंसेव्यं सर्वभोगसमन्वितम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000563042, "chapter_id": 20563, "verse_number": "५-२२-४३", "content_sanskrit": "पुरुषोत्तमसंज्ञं च पश्यन्राजा स धार्मिकः ।\nववंदे चरणौ तस्य कृपापात्रकृतात्मकः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000563043, "chapter_id": 20563, "verse_number": "५-२२-४४", "content_sanskrit": "तदाज्ञया विमाने स आरुह्य महिलायुतः ।\nजगाम पश्यतस्तस्य दिवि वैकुंठमद्भुतम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000563044, "chapter_id": 20563, "verse_number": "५-२२-४५", "content_sanskrit": "मंत्री धर्मपरो राज्ञः सर्वधर्मविदुत्तमः ।\nययौ साकं विमानेन ललनावृन्दसेवितः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000563045, "chapter_id": 20563, "verse_number": "५-२२-४६", "content_sanskrit": "तापसब्राह्मणस्तत्र सर्वतीर्थावगाहकः ।\nचतुर्भुजत्वं संप्राप्तो ययौ देवैर्विमानिभिः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000563046, "chapter_id": 20563, "verse_number": "५-२२-४७", "content_sanskrit": "करंबोऽपि महाराज गानपुण्येन दर्शनम् ।\nप्राप्तो ययौ सुरावासं सर्वदेवादिदुर्ल्लभम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000563047, "chapter_id": 20563, "verse_number": "५-२२-४८", "content_sanskrit": "सर्वे प्रचलिता विष्णुलोकं परममद्भुतम् ।\nचतुर्भुजाः शंखचक्रगदापाथोजधारिणः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000563048, "chapter_id": 20563, "verse_number": "५-२२-४९", "content_sanskrit": "सर्वे मेघश्रियः शुद्धा लसदंभोजपाणयः ।\nहारकेयूरकटकैर्भूषितांगा ययुर्दिवम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000563049, "chapter_id": 20563, "verse_number": "५-२२-५०", "content_sanskrit": "तद्विमानावलीर्दृष्ट्वा लोकैः प्रकृतिभिस्तदा ।\nदुंदुभीनां तु निर्घोषस्तैः कृतः कर्णगोचरः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000563050, "chapter_id": 20563, "verse_number": "५-२२-५१", "content_sanskrit": "तदैको ब्राह्मणो ह्यासीद्विष्णुपादाब्जवल्लभः ।\nगतस्तद्विरहाकृष्टचेता जातश्चतुर्भुजः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000563051, "chapter_id": 20563, "verse_number": "५-२२-५२", "content_sanskrit": "तच्चित्रं वीक्ष्य लोकास्ते प्रशंसंतो महोदयम् ।\nगंगासागरसंयोगे स्नात्वाऽगुस्तं पुरं प्रति ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000563052, "chapter_id": 20563, "verse_number": "५-२२-५३", "content_sanskrit": "अहो भाग्यं भूमिपते रत्नग्रीवस्य सन्मतेः ।\nजगामानेन देहेन तद्विष्णोः परमं पदम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000563053, "chapter_id": 20563, "verse_number": "५-२२-५४", "content_sanskrit": "राजन्नसौ नीलगिरिः पुरुषोत्तमसत्कृतः ।\nयं वीक्ष्यैव व्रजंत्यद्धा वैकुंठं परमायनम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000563054, "chapter_id": 20563, "verse_number": "५-२२-५५", "content_sanskrit": "एतन्नीलस्य माहात्म्यं यः शृणोति स भाग्यवान् ।\nयः श्रावयति लोकान्वै तौ गच्छेतां परं पदम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000563055, "chapter_id": 20563, "verse_number": "५-२२-५६", "content_sanskrit": "एतच्छ्रुत्वा तु दुःस्वप्नो नश्यति स्मृतिमात्रतः ।\nप्रांते संसारनिस्तारं ददाति पुरुषोत्तमः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000563056, "chapter_id": 20563, "verse_number": "५-२२-५७", "content_sanskrit": "योऽसौ नीलाधिवासी च स रामः पुरुषोत्तमः ।\nसीतासाक्षान्महालक्ष्मीः सर्वकारणकारणम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000563057, "chapter_id": 20563, "verse_number": "५-२२-५८", "content_sanskrit": "हयमेधं चरित्वा स लोकान्वै पावयिष्यति ।\nयन्नामब्रह्महत्यायाः प्रायश्चित्ते प्रदिश्यते ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000563058, "chapter_id": 20563, "verse_number": "५-२२-५९", "content_sanskrit": "इदानीं त्वद्धयः प्राप्तो नीलेपर्वतसत्तमे ।\nपुरुषोत्तमदेवं त्वं नमस्कुरु महामते ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000563059, "chapter_id": 20563, "verse_number": "५-२२-६०", "content_sanskrit": "तत्र निष्पापिनो भूत्वा यास्यामः परमं पदम् ।\nयस्य प्रसादाद्बहवो निस्तीर्णा भवसागरात् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000563060, "chapter_id": 20563, "verse_number": "५-२२-६१", "content_sanskrit": "एवं प्रवदतस्तस्य प्राप्तोऽश्वो नीलपर्वतम् ।\nवायुवेगेन पृथिवीं कुर्वन्संक्षुण्णमंडलाम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000563061, "chapter_id": 20563, "verse_number": "५-२२-६२", "content_sanskrit": "तदा राजापि तत्पृष्ठचारी नीलाभिधं गिरिम् ।\nप्राप्तो गंगाब्धिसंयोगे स्नात्वागात्पुरुषोत्तमम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000563062, "chapter_id": 20563, "verse_number": "५-२२-६३", "content_sanskrit": "स्तुत्वा नत्वा च देवेशं सुरासुरनमस्कृतम् ।\nजातं कृतार्थमात्मानममन्यत स शत्रुहा ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]