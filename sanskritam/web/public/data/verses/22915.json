[{"id": 7002915000, "chapter_id": 22915, "verse_number": "९-२००-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nअतः परं प्रवक्ष्यामि कार्पासाचलमुत्तमम् ।\nपरमं सर्वदानानां प्रियं सर्वदिवौकसाम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002915001, "chapter_id": 22915, "verse_number": "९-२००-२", "content_sanskrit": "देशकालौ समासाद्य धनं श्रद्धां च यत्नतः ।\nदेयमेतन्महादानं कुलोद्धरणहेतवे ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002915002, "chapter_id": 22915, "verse_number": "९-२००-३", "content_sanskrit": "पूर्वोक्तेन विधानेन कृत्वा सर्वमशेषतः ।\nपर्वतं कल्पयेत्तत्र कार्पासेन विधानतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002915003, "chapter_id": 22915, "verse_number": "९-२००-४", "content_sanskrit": "विंशद्भारस्तु कर्तव्य उत्तमः पर्वतो बुधैः ।\nदशभिर्मध्यमः प्रोक्तो जघन्यः पंचभिर्मतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002915004, "chapter_id": 22915, "verse_number": "९-२००-५", "content_sanskrit": "भारेणाल्पधनो दद्याद्वित्तशाठ्यविवर्जितः ।\nधान्यपर्वतवत्सर्वमासाद्य नृपपुंगव ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002915005, "chapter_id": 22915, "verse_number": "९-२००-६", "content_sanskrit": "तद्वज्जागरणं कुर्यात्तद्वच्चैवाधिवासनम् ।\nप्रभातायां तु शर्वर्यामिमं मन्त्रमुदीरयेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002915006, "chapter_id": 22915, "verse_number": "९-२००-७", "content_sanskrit": "त्वमेवावरणं यस्माल्लोकानामिह सर्वदा ।\nकार्पासाचल नस्तस्मादघौघध्वंसनो भव ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002915007, "chapter_id": 22915, "verse_number": "९-२००-८", "content_sanskrit": "इति कार्पासशैलेन्द्रं यो दद्यात्पर्वसंनिधौ ।\nरुद्रलोके वसेत्कल्पं ततो राजा भवेदिह ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002915008, "chapter_id": 22915, "verse_number": "९-२००-९", "content_sanskrit": "रूपवान्सुभगो वाग्मी श्रीमानतुलविक्रमः ।\nपञ्चजन्मानि नारी वा जायते नात्र संशयः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002915009, "chapter_id": 22915, "verse_number": "९-२००-१०", "content_sanskrit": "कार्पासपर्वतमयो जगदेकबंधुर्यस्मान्नतेन रहितो वरवस्त्रयोगः ।\nतस्मादघौधशमनाय सुखाय नित्यं देयो नरेण नरनाथविमत्सरेण ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]