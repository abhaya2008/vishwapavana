[{"id": 6000275000, "chapter_id": 10275, "verse_number": null, "content_sanskrit": "अथ एकोनाशीतितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000275001, "chapter_id": 10275, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.001.m4a", "display_order": 2}, {"id": 6000275002, "chapter_id": 10275, "verse_number": "१०-७९-१", "content_sanskrit": "तथा ताभिर्वरस्‍त्रीभी रममाणो जनार्दनः।\nदिनानि हतसापत्नः सुबहून्यत्यवासयत्॥ १०/७९/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.002.m4a", "display_order": 3, "topics": [{"text": "कृष्णमहिमानं द्रष्टुमागतस्य नारदस्य विविधहम्र्येषु तस्य बहुविधव्यापारदर्शनम्", "range": "१–४७"}]}, {"id": 6000275003, "chapter_id": 10275, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.003.m4a", "display_order": 4}, {"id": 6000275004, "chapter_id": 10275, "verse_number": "१०-७९-२", "content_sanskrit": "तासां षोडशसाहस्रमहिषीणां जनार्दनः।\nतृप्तिं कथं चकारैको मानुषं देहमाश्रितः॥ १०/७९/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.004.m4a", "display_order": 5}, {"id": 6000275005, "chapter_id": 10275, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.005.m4a", "display_order": 6}, {"id": 6000275006, "chapter_id": 10275, "verse_number": "१०-७९-३", "content_sanskrit": "हन्त ते कथयिष्यामि श्रोतॄॄणां विस्मयावहम्।\nयथा चकार बह्वीनामेकस्तृप्तिं जनार्दनः॥ १०/७९/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.006.m4a", "display_order": 7}, {"id": 6000275007, "chapter_id": 10275, "verse_number": "१०-७९-४", "content_sanskrit": "नरकं निहतं श्रुत्वा तथोद्वाहं च योषिताम्।\nकृष्णेनैकेन बह्वीनां तद्दिदृक्षुः स्म नारदः॥ १०/७९/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.007.m4a", "display_order": 8}, {"id": 6000275008, "chapter_id": 10275, "verse_number": "१०-७९-५", "content_sanskrit": "चित्रं बतैतदेकेन वपुषा युगपत् पृथक्।\nगृहेषु व्द्यष्टसाहस्रस्‍त्रिय एक उदावहत्॥ १०/७९/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.008.m4a", "display_order": 9}, {"id": 6000275009, "chapter_id": 10275, "verse_number": "१०-७९-६", "content_sanskrit": "इत्युत्सुको द्वारवतीं देवर्षिर्द्रष्टुमागमत्।\nपुष्पितोपवनारामां द्विजालिकुलनादिताम्॥ १०/७९/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.009.m4a", "display_order": 10}, {"id": 6000275010, "chapter_id": 10275, "verse_number": "१०-७९-७", "content_sanskrit": "उत्फुल्लेन्दीवराम्भोजकल्हारकुमुदोत्पलैः।\nछुरितेषु सरस्सूच्चैः कूजितां हंससारसैः॥ १०/७९/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.010.m4a", "display_order": 11}, {"id": 6000275011, "chapter_id": 10275, "verse_number": "१०-७९-८", "content_sanskrit": "प्रासादलक्षैर्नवभिर्जुष्टां स्फाटिकराजतैः।\nमहामरकतप्रख्यैः स्वर्णरत्नपरिच्छदैः॥ १०/७९/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.011.m4a", "display_order": 12}, {"id": 6000275012, "chapter_id": 10275, "verse_number": "१०-७९-९", "content_sanskrit": "विभक्तरथ्यापथचत्वरापणैः शालासभाभी रुचिरां सुरालयैः।\nसंसिक्तमार्गाङ्कणवीथिगेहिनीं पतत्पताकाध्वजवारितातपाम्॥ १०/७९/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.012.m4a", "display_order": 13}, {"id": 6000275013, "chapter_id": 10275, "verse_number": "१०-७९-१०", "content_sanskrit": "तस्यामन्तःपुरं श्रीमदर्चितं सर्वधिष्ण्यपैः।\nहरेः स्वकौशलं यत्र त्वष्ट्रा कार्त्स्न्येन दर्शितम्॥ १०/७९/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.013.m4a", "display_order": 14}, {"id": 6000275014, "chapter_id": 10275, "verse_number": "१०-७९-११", "content_sanskrit": "तत्र षोडशभिः सद्मसहस्रैः समलङ्कृतम्।\nविवेशैकतमं शौरेः पत्नीनां भवनं महत्॥ १०/७९/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.014.m4a", "display_order": 15}, {"id": 6000275015, "chapter_id": 10275, "verse_number": "१०-७९-१२", "content_sanskrit": "विष्टब्धं विद्रुमस्तम्भैर्वैडूर्यफलकोत्तमैः।\nइन्द्रनीलमयैः कुड्यैर्जालैर्मरकतोत्तमैः॥ १०/७९/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.015.m4a", "display_order": 16}, {"id": 6000275016, "chapter_id": 10275, "verse_number": "१०-७९-१३", "content_sanskrit": "वितानैर्निर्मितैस्त्वष्ट्रा मुक्तादामविलम्बिभिः।\nदान्तैरासनपर्यङ्कैर्मण्युत्तमपरिष्कृतैः॥ १०/७९/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.016.m4a", "display_order": 17}, {"id": 6000275017, "chapter_id": 10275, "verse_number": "१०-७९-१४", "content_sanskrit": "दासीभिर्निष्ककण्ठीभिः सुवासोभिरलङ्कृतम्।\nपुम्भिः सकञ्चुकोष्णीषसुवस्‍त्रमणिकुण्डलैः॥ १०/७९/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.017.m4a", "display_order": 18}, {"id": 6000275018, "chapter_id": 10275, "verse_number": "१०-७९-१५", "content_sanskrit": "रत्नप्रदीपनिकरद्युतिभिर्निरस्तध्वान्तं विचित्रवलभीषु शिखण्डिनोऽङ्ग।\nनृत्यन्ति यत्र विहितागरुधूपमक्षैर्निर्यान्तमीक्ष्य घनबुद्धय उन्नदन्तः॥ १०/७९/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.018.m4a", "display_order": 19}, {"id": 6000275019, "chapter_id": 10275, "verse_number": "१०-७९-१६", "content_sanskrit": "तस्मिन् समानगुणरूपवयःसुवेषदासीसहस्रयुतयाऽनुसवं गृहिण्या।\nविप्रो ददर्श चमरव्यजनेन रुग्मदण्डेन सात्त्वतपतिं परिवीजयन्त्या॥ १०/७९/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.019.m4a", "display_order": 20}, {"id": 6000275020, "chapter_id": 10275, "verse_number": "१०-७९-१७", "content_sanskrit": "तं सन्निरीक्ष्य भगवान् सहसोत्थितः श्रीपर्यङ्कतः सकलधर्मभृतां वरिष्ठः।\nआनम्य पादयुगलं शिरसा किरीटजुष्टेन साञ्जलिरवीविशदासने स्वे॥ १०/७९/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.020.m4a", "display_order": 21}, {"id": 6000275021, "chapter_id": 10275, "verse_number": "१०-७९-१८", "content_sanskrit": "तस्यावनिज्य चरणौ तदपः स्वमूर्ध्ना बिभ्रज्जगद्गुरुतरोऽपि सतां पतिर्हि।\nब्रह्मण्यदेव इति यद् गुणनाम युक्तं तस्यैव यच्चरणशौचमशेषतीर्थम्॥ १०/७९/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.021.m4a", "display_order": 22}, {"id": 6000275022, "chapter_id": 10275, "verse_number": "१०-७९-१९", "content_sanskrit": "सम्पूज्य देवऋषिमादिऋषिः पुराणो नारायणो नरसखो विधिनोदितेन।\nवाण्याऽभिभाष्य मितयाऽमृतकल्पया च प्राह प्रभो भगवतः करवाम किं ते॥ १०/७९/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.022.m4a", "display_order": 23}, {"id": 6000275023, "chapter_id": 10275, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.023.m4a", "display_order": 24}, {"id": 6000275024, "chapter_id": 10275, "verse_number": "१०-७९-२०", "content_sanskrit": "नैवाद्भुतं त्वयि विभोऽखिललोकनाथे मैत्रीं जनेषु दधतश्च दमं खलानाम्।\nनिःश्रेयसाय जगतां स्थितिरक्षणाभ्यां स्वैरावतार उरुगाय विदाम सुष्ठु॥ १०/७९/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.024.m4a", "display_order": 25}, {"id": 6000275025, "chapter_id": 10275, "verse_number": "१०-७९-२१", "content_sanskrit": "दृष्टं तवाङ्घ्रियुगलं जनतापवर्गं ब्रह्मादिभिर्हृदि विचिन्त्यमगाधबोधैः।\nसंसारकूपपतितोत्तरणावलम्बं ध्यायंश्चराम्यनुगृहाण यथा स्मृतिः स्यात्॥ १०/७९/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.025.m4a", "display_order": 26}, {"id": 6000275026, "chapter_id": 10275, "verse_number": "१०-७९-२२", "content_sanskrit": "ततोऽन्यदाविशद् गेहं कृष्णपत्न्याः स्म नारदः।\nयोगेश्वरेश्वरस्याङ्ग योगमायाविवित्सया॥ १०/७९/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.026.m4a", "display_order": 27}, {"id": 6000275027, "chapter_id": 10275, "verse_number": "१०-७९-२३", "content_sanskrit": "दीव्यन्तमक्षभिस्तत्र प्रियया चोद्धवेन च।\nपूजितः परया भक्त्या प्रत्युत्थानासनादिभिः॥ १०/७९/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.027.m4a", "display_order": 28}, {"id": 6000275028, "chapter_id": 10275, "verse_number": "१०-७९-२४", "content_sanskrit": "पृष्टश्चाविदुषेवासौ कदाऽऽयातो भवानिति।\nक्रियते किन्नु पूर्णानामपूर्णैरस्मदादिभिः॥ १०/७९/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.028.m4a", "display_order": 29}, {"id": 6000275029, "chapter_id": 10275, "verse_number": "१०-७९-२५", "content_sanskrit": "अथापि ब्रूहि नो ब्रह्मन् जन्मैतच्छोभनं कुरु।\nस तु विस्मित उत्थाय तूर्णमन्यदगाद् गृहम्॥ १०/७९/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.029.m4a", "display_order": 30}, {"id": 6000275030, "chapter_id": 10275, "verse_number": "१०-७९-२६", "content_sanskrit": "तत्राप्यचष्ट गोविन्दं लालयन्तं शिशून् सुतान्।\nततोऽन्यस्मिन् गृहेऽपश्यन्मज्जनाय कृतोद्यमम्॥ १०/७९/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.030.m4a", "display_order": 31}, {"id": 6000275031, "chapter_id": 10275, "verse_number": "१०-७९-२७", "content_sanskrit": "जुह्वन्तं च वितानाग्नीन् यजन्तं पञ्चभिर्मखैः।\nभोजयन्तं द्विजान् क्‍वापि भुञ्जानमवशेषितम्॥ १०/७९/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.031.m4a", "display_order": 32}, {"id": 6000275032, "chapter_id": 10275, "verse_number": "१०-७९-२८", "content_sanskrit": "क्‍वापि सन्ध्यामुपासीनं जपन्तं ब्रह्म वाग्यतम्।\nएकत्र चासिचर्मभ्यां चरन्तं शिष्यवर्त्मसु॥ १०/७९/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.032.m4a", "display_order": 33}, {"id": 6000275033, "chapter_id": 10275, "verse_number": "१०-७९-२९", "content_sanskrit": "अश्वैर्गजै रथैः क्‍वापि विचरन्तं गदाग्रजम्।\nक्‍वचिच्छयानं पर्यङ्के स्तूयमानं च वन्दिभिः॥ १०/७९/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.033.m4a", "display_order": 34}, {"id": 6000275034, "chapter_id": 10275, "verse_number": "१०-७९-३०", "content_sanskrit": "मन्त्रयन्तं च कस्मिंश्चिन्मन्त्रिभिश्चोद्धवादिभिः।\nजलक्रीडारतं क्‍वापि वारमुख्याबलावृतम्॥ १०/७९/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.034.m4a", "display_order": 35}, {"id": 6000275035, "chapter_id": 10275, "verse_number": "१०-७९-३१", "content_sanskrit": "कुत्रचिद् द्विजमुख्येभ्यो ददतं गाः स्वलङ्कृताः।\nइतिहासपुराणानि शृण्वन्तं मङ्गलानि च॥ १०/७९/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.035.m4a", "display_order": 36}, {"id": 6000275036, "chapter_id": 10275, "verse_number": "१०-७९-३२", "content_sanskrit": "हसन्तं हास्यकथया कदाचित् प्रियया गृहे।\nक्‍वापि धर्मं सेवमानमर्थकामौ च कुत्रचित्॥ १०/७९/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.036.m4a", "display_order": 37}, {"id": 6000275037, "chapter_id": 10275, "verse_number": "१०-७९-३३", "content_sanskrit": "ध्यायन्तमेकमात्मानं पुरुषं प्रकृतेः परम्।\nशुश्रूषन्तं गुरून् क्‍वापि कामैर्भोगैः सपर्यया॥ १०/७९/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.037.m4a", "display_order": 38}, {"id": 6000275038, "chapter_id": 10275, "verse_number": "१०-७९-३४", "content_sanskrit": "कुर्वन्तं विग्रहं कैश्चित् सन्धिं चान्यत्र केशवम्।\nकुत्रापि सह रामेण चिन्तयन्तं सतां शिवम्॥ १०/७९/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.038.m4a", "display_order": 39}, {"id": 6000275039, "chapter_id": 10275, "verse_number": "१०-७९-३५", "content_sanskrit": "पुत्राणां दुहितॄणां च काले विध्युपनायनम्।\nदारैर्वरैस्तत्सदृशैः कल्पयन्तं विभूतिभिः॥ १०/७९/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.039.m4a", "display_order": 40}, {"id": 6000275040, "chapter_id": 10275, "verse_number": "१०-७९-३६", "content_sanskrit": "प्रस्थापनोपनयनैरपत्यानां महोत्सवान्।\nवीक्ष्य योगेश्वरेशस्य येषां लोका विसिस्मिरे॥ १०/७९/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.040.m4a", "display_order": 41}, {"id": 6000275041, "chapter_id": 10275, "verse_number": "१०-७९-३७", "content_sanskrit": "यजन्तं सकलान् देवान् क्‍वचित् क्रतुभिरूर्जितैः।\nपूर्तयन्तं क्‍वचिद् धर्मं कूपारामालयादिभिः॥ १०/७९/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.041.m4a", "display_order": 42}, {"id": 6000275042, "chapter_id": 10275, "verse_number": "१०-७९-३८", "content_sanskrit": "चरन्तं मृगयां क्‍वापि हयमारुह्य सैन्धवम्।\nघ्नन्तं तीर्थे पशून् मेध्यान् परीतं यदुपुङ्गवैः॥ १०/७९/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.042.m4a", "display_order": 43}, {"id": 6000275043, "chapter_id": 10275, "verse_number": "१०-७९-३९", "content_sanskrit": "अव्यक्तलिङ्गप्रकृतिमन्तःपुरचरादिषु।\nक्‍वचिच्चरन्तं योगेशं तत्तद्भावबुभुत्सया॥ १०/७९/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.043.m4a", "display_order": 44}, {"id": 6000275044, "chapter_id": 10275, "verse_number": "१०-७९-४०", "content_sanskrit": "अथोवाच हृषीकेशं नारदः प्रहसन्निव।\nयोगमायाबलं वीक्ष्य मानुषीमीयुषो रतिम्॥ १०/७९/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.044.m4a", "display_order": 45}, {"id": 6000275045, "chapter_id": 10275, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.045.m4a", "display_order": 46}, {"id": 6000275046, "chapter_id": 10275, "verse_number": "१०-७९-४१", "content_sanskrit": "विदाम योगमायां ते दुर्दर्शामपि योगिनाम्।\nयोगेश्वरात्मन् निर्भातभवत्पादनिषेवया॥ १०/७९/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.046.m4a", "display_order": 47}, {"id": 6000275047, "chapter_id": 10275, "verse_number": "१०-७९-४२", "content_sanskrit": "अनुजानीहि मां देव लोकास्ते यशसा प्लुतान्।\nपर्यटामि तवोद्गायन् लीलां भुवनपावनीम्॥ १०/७९/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.047.m4a", "display_order": 48}, {"id": 6000275048, "chapter_id": 10275, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.048.m4a", "display_order": 49}, {"id": 6000275049, "chapter_id": 10275, "verse_number": "१०-७९-४३", "content_sanskrit": "ब्रह्मन् धर्मस्य वक्ताऽहं कर्तारमनुमोदकः।\nशिक्षयंस्तं लोकमिममास्थितः पुत्र मा खिदः॥ १०/७९/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.049.m4a", "display_order": 50}, {"id": 6000275050, "chapter_id": 10275, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.050.m4a", "display_order": 51}, {"id": 6000275051, "chapter_id": 10275, "verse_number": "१०-७९-४४", "content_sanskrit": "इत्याचरन्तं सद्धर्मान् प्राक्सृष्टान् गृहमेधिनाम्।\nतमेव सर्वगेहेषु सत्त्वमेषां ददर्श ह॥ १०/७९/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.051.m4a", "display_order": 52}, {"id": 6000275052, "chapter_id": 10275, "verse_number": "१०-७९-४५", "content_sanskrit": "कृष्णस्याचिन्त्यवीर्यस्य योगमायामहोदयम्।\nमुहुर्दृष्ट्वा ऋषिरभूद् विस्मितो जातकौतुकः॥ १०/७९/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.052.m4a", "display_order": 53}, {"id": 6000275053, "chapter_id": 10275, "verse_number": "१०-७९-४६", "content_sanskrit": "इत्यर्थधर्मकामेषु कृष्णेनावहितात्मना।\nसम्यक् सभाजितः प्रीतस्तमेवानुस्मरन् ययौ॥ १०/७९/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.053.m4a", "display_order": 54}, {"id": 6000275054, "chapter_id": 10275, "verse_number": "१०-७९-४७", "content_sanskrit": "एवं मनुष्यपदवीमनुवर्तमानो नारायणोऽखिलभवाय गृहीतशक्तिः।\nरेमे च षोडशसहस्रवराङ्गनानां सव्रीडसौहृदनिरीक्षणहासजुष्टः॥ १०/७९/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.054.m4a", "display_order": 55}, {"id": 6000275055, "chapter_id": 10275, "verse_number": "१०-७९-४८", "content_sanskrit": "यानीह विश्वविलयोद्भववृत्तिहेतुः कर्माण्यनन्यविषयाणि हरिश्चकार।\nयस्त्वङ्ग गायति शृणोत्यनुमोदते वा भक्तिर्भवेद् भगवति ह्यपवर्गमार्गे॥ १०/७९/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_079/BhP_10.079.055.m4a", "display_order": 56}, {"id": 6000275056, "chapter_id": 10275, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्ध एकोनाशीतितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]