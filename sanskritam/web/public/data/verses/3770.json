[{"id": 2128912, "chapter_id": 3770, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2128913, "chapter_id": 3770, "verse_number": "१", "content_sanskrit": "स तत्र तामुषित्वैकां रजनीं पृथिवीपतिः ।\nतापसानां परं चक्रे सत्कारं भ्रातृभिः सह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2128914, "chapter_id": 3770, "verse_number": "२", "content_sanskrit": "लोमशश्चात्र तान् सर्वानाचख्यौ तत्र तापसान् ।\nभृगूनङ्गिरसश्चैव वासिष्ठानथ काश्यपान्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2128915, "chapter_id": 3770, "verse_number": "३", "content_sanskrit": "तान् समेत्य स राजर्षिरभिवाद्य कृताञ्जलिः ।\nरामस्यानुचरं वीरमपृच्छदकृतव्रणम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2128916, "chapter_id": 3770, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2128917, "chapter_id": 3770, "verse_number": "४", "content_sanskrit": "कदा नु रामो भगवान् तापसान् दर्शयिष्यति ।\nतेनैवाहं प्रसङ्गेन द्रष्टुमिच्छामि भार्गवम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2128918, "chapter_id": 3770, "verse_number": "", "content_sanskrit": "अकृतव्रणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2128919, "chapter_id": 3770, "verse_number": "५", "content_sanskrit": "आयानेवासि विदितो रामस्य विदितात्मनः ।\nप्रीतिस्त्वयि च रामस्य क्षिप्रं त्वां दर्शयिष्यति\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2128920, "chapter_id": 3770, "verse_number": "६", "content_sanskrit": "चतुर्दशीमष्टमीं च रामं पश्यन्ति तापसाः ।\nअस्यां रात्र्यां व्यतीतायां भवित्री च चतुर्दशी ।\nतत्र द्रक्ष्यसि रामं त्वं कृष्णाजिनजटाधरम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2128921, "chapter_id": 3770, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2128922, "chapter_id": 3770, "verse_number": "७", "content_sanskrit": "भवाननुगतो रामं जामदग्न्यं महाबलम् ।\nप्रत्यक्षदर्शी सर्वस्य पूर्ववृत्तस्य कर्मणः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2128923, "chapter_id": 3770, "verse_number": "८", "content_sanskrit": "स भवान् कथयत्वेतद् यथा रामेण निर्जिताः ।\nआहवे क्षत्रियाः सर्वे कथं केन च हेतुना\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2128924, "chapter_id": 3770, "verse_number": "", "content_sanskrit": "अकृतव्रणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2128925, "chapter_id": 3770, "verse_number": "९", "content_sanskrit": "कन्याकुब्जे महानासीत् पार्थिवः सुमहाबलः ।\nगाधीति विश्रुतो लोके वनवासं जगाम सः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2128926, "chapter_id": 3770, "verse_number": "१०", "content_sanskrit": "वने तु तस्य वसतः कन्या जज्ञेऽप्सरोपमा ।\nऋचीको भार्गवस्तां वै वरयामास भारत \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2128927, "chapter_id": 3770, "verse_number": "११", "content_sanskrit": "तमुवाच ततो राजा ब्राह्मणं संशितव्रतम् ।\nउचितं नः कुले किञ्चित् पूर्वैर्यत् सम्परिवर्तनम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2128928, "chapter_id": 3770, "verse_number": "१२", "content_sanskrit": "एकतः श्यामकर्णानां पाण्डराणां तरस्विनाम् ।\nसहस्रं वाजिनां शुल्कमिति विद्धि द्विजोत्तम\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2128929, "chapter_id": 3770, "verse_number": "१३", "content_sanskrit": "न चापि भगवान् वाच्यो दीयतामिति भार्गव ।\nदेया मे दुहिता चैव त्वद्विधाय द्विजातये\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2128930, "chapter_id": 3770, "verse_number": "", "content_sanskrit": "ऋचीकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2128931, "chapter_id": 3770, "verse_number": "१४", "content_sanskrit": "एकतः श्यामकर्णानां पाण्डराणां तरस्विनाम् ।\nदास्याम्यश्वसहस्रं ते मम भार्या सुताऽस्तु ते \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2128932, "chapter_id": 3770, "verse_number": "१५", "content_sanskrit": "स तथेति प्रतिज्ञाय राजन् वरुणमब्रवीत् ।\nएकतः श्यामकर्णानां पाण्डराणां तरस्विनाम् ।\nसहस्रं वाजिनामेकं शुल्कार्थं मे प्रदीयताम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2128933, "chapter_id": 3770, "verse_number": "", "content_sanskrit": "अकृतव्रणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2128934, "chapter_id": 3770, "verse_number": "१६", "content_sanskrit": "तस्मै प्रादात् सहस्रं वै वाजिनां वरुणस्तदा ।\nतदश्वतीर्थं विख्यातमुत्थिता यत्र ते हयाः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2128935, "chapter_id": 3770, "verse_number": "१७", "content_sanskrit": "गङ्गायां कान्यकुब्जे वै ददौ सत्यवतीं तदा ।\nततो गाधिः सुतां तस्मै कन्यां चाप्सरसोपमाम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2128936, "chapter_id": 3770, "verse_number": "१८", "content_sanskrit": "लब्धं हयसहस्रं तत् तां च दृष्ट्वा दिवौकसः ।\nविस्मयं परमं जग्मुः तमेव दिवि संस्तुवन्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2128937, "chapter_id": 3770, "verse_number": "१९", "content_sanskrit": "धर्मेण लब्ध्वा तां भार्याम् ऋचीको द्विजसत्तमः ।\nयथाकामं यथाश्रद्धं तया रेमे सुमध्यया\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2128938, "chapter_id": 3770, "verse_number": "२०", "content_sanskrit": "तं विवाहे कृते राजन् सभार्यमवलोकितुम् ।\nआजगाम भृगुश्रेष्ठः पुत्रं दृष्ट्वा ननन्द च \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2128939, "chapter_id": 3770, "verse_number": "२१", "content_sanskrit": "भार्यापती समासीनं गुरुं सुरगणार्चितम् ।\nअर्चयित्वाभ्युपासीनौ प्राञ्जली तस्थतुस्तदा\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2128940, "chapter_id": 3770, "verse_number": "२२", "content_sanskrit": "ततः स्नुषां स विप्रर्षिः प्रहृष्टो भृगुरब्र्रवीत् ।\nवरं वृणीष्व सुभगे दाता ह्यस्मि तवेप्सितम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2128941, "chapter_id": 3770, "verse_number": "२३", "content_sanskrit": "सा वै प्रसादयामास तं गुरुं पुत्रकारणात् ।\nआत्मनश्चैव मातुश्च प्रसादं च चकार सः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2128942, "chapter_id": 3770, "verse_number": "२४", "content_sanskrit": "ऋतौ त्वं चैव माता च स्नाते पुंसवनाय वै ।\nआलिङ्गेतां पृथग् वृक्षौ साऽश्वत्थं त्वमुदुम्बरम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2128943, "chapter_id": 3770, "verse_number": "२५", "content_sanskrit": "आलिङ्गने तु राजन् वै चक्रतुस्ते विपर्ययम् ।\nकदाचिद् भृगुरागच्छत् तत्र वेद विपर्ययम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2128944, "chapter_id": 3770, "verse_number": "२६", "content_sanskrit": "अथोवाच महातेजा भृगुः सत्यवतीं स्नुषाम् ।\nब्राह्मणः क्षत्रवृत्तिर्वै तव पुत्रो भविष्यति\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2128945, "chapter_id": 3770, "verse_number": "२७", "content_sanskrit": "क्षत्रियो ब्राह्मणाचारो मातुस्तव सुतो महान् ।\nभविष्यति महावीर्यः साधूनां मार्गमास्थितः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2128946, "chapter_id": 3770, "verse_number": "२८", "content_sanskrit": "प्रसादयामास च तं श्वशुरं सा पुनः पुनः ।\nन मे पुत्रो भवेदीदृक् कामं पौत्रो भवेदिति\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2128947, "chapter_id": 3770, "verse_number": "२९", "content_sanskrit": "एवमस्त्विति सा तेन पाण्डव प्रतिनन्दिता ।\nकालं प्रतीक्षती गर्भं धारयामास यत्नतः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2128948, "chapter_id": 3770, "verse_number": "३०", "content_sanskrit": "जमदग्निस्ततः पुत्रं जज्ञे सा काल आगते ।\nतेजसा वर्चसा चैव युक्तं भार्गवनन्दनम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2128949, "chapter_id": 3770, "verse_number": "३१", "content_sanskrit": "स वर्धमानस्तेजस्वी वेदस्याध्ययनेन च ।\nबहूनृषीन् महातेजाः पाण्डवेयात्यवर्तत \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2128950, "chapter_id": 3770, "verse_number": "३२", "content_sanskrit": "तं तु कृत्स्नो धनुर्वेदः प्रत्यभाद् भरतर्षभ ।\nचतुर्विधानि चास्त्राणि भास्करोपमवर्चसम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2128951, "chapter_id": 3770, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि द्वादशोत्तरशततमोऽध्यायः ॥११२॥\n॥ तीर्थयात्रापर्वणि अष्टषष्टितमोऽध्यायः ॥६८॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]