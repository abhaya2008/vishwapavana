[{"id": 2099961, "chapter_id": 3141, "verse_number": "१३-२७१-१", "content_sanskrit": "वैशम्पायन उवाच।\nशरतल्पगतं भीष्मं पाण्डवोऽथ कुरूद्वहः।\nयुधिष्ठिरो हितं प्रेप्सुरपृच्छत्कल्मषापहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2099962, "chapter_id": 3141, "verse_number": "१३-२७१-२x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2099963, "chapter_id": 3141, "verse_number": "१३-२७१-२", "content_sanskrit": "किं श्रेयः पुरुषस्येह किं कुर्वन्सुखमेधते।\nविपाप्मा स भवेत्केन किं वा कल्मषनाशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2099964, "chapter_id": 3141, "verse_number": "१३-२७१-३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2099965, "chapter_id": 3141, "verse_number": "१३-२७१-३", "content_sanskrit": "तस्मै शुश्रूषमाणाय भूयः शान्तनवस्तदा।\nदैवं वंशं यथान्यायमाचष्ट पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2099966, "chapter_id": 3141, "verse_number": "१३-२७१-४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2099967, "chapter_id": 3141, "verse_number": "१३-२७१-४", "content_sanskrit": "अयं दैवतवंशो वै ऋषिवंशसमन्वितः।\nत्रिसन्ध्यं पठितः पुत्र कल्मषापहरः परः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2099968, "chapter_id": 3141, "verse_number": "१३-२७१-५", "content_sanskrit": "यदह्ना कुरुते पापमिन्द्रियैः पुरुषश्चरन्।\nबुद्धिपूर्वमबुद्धिर्वा रात्रौ यच्चापि सन्ध्ययोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2099969, "chapter_id": 3141, "verse_number": "१३-२७१-६", "content_sanskrit": "मुच्यते सर्वपापेभ्यः कीर्तयन्वै शुचिः सदा।\nनान्धो न बधिरः काले कुरुते स्वस्तिमान्सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2099970, "chapter_id": 3141, "verse_number": "१३-२७१-७", "content_sanskrit": "तिर्यग्योनिं न गच्छेच्च नरकं सङ्कराणि च।\nन च दुःखमयं तस्य मरणे स न मुह्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2099971, "chapter_id": 3141, "verse_number": "१३-२७१-८", "content_sanskrit": "देवासुरगकुरुर्देवः सर्वभूतनमस्कृतः।\nअचिन्त्योथाप्यनिर्देश्यः सर्वप्राणो ह्ययोनिजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2099972, "chapter_id": 3141, "verse_number": "१३-२७१-९", "content_sanskrit": "पितामहो जगन्नाथः सावित्री ब्रह्मणः सती।\nवेदभूरथ कर्ता च विष्णुर्नारायणः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2099973, "chapter_id": 3141, "verse_number": "१३-२७१-१०", "content_sanskrit": "उमापतिर्विरूपाक्षः स्कन्दः सेनापतिस्तथा।\nविशाखो हुतभुग्वायुश्चन्द्रसूर्यौ प्रभाकरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2099974, "chapter_id": 3141, "verse_number": "१३-२७१-११", "content_sanskrit": "शक्रः शचीपतिर्देवो यमो धूमोर्णया सह।\nवरुणः सह गौर्या च सह ऋद्ध्या धनेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2099975, "chapter_id": 3141, "verse_number": "१३-२७१-१२", "content_sanskrit": "सौम्या गौः सुरभिर्देवी विश्रवाश्च महानृषिः।\nसङ्कल्पः सागरो गङ्गा स्रवन्त्योऽथ मरुद्गणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2099976, "chapter_id": 3141, "verse_number": "१३-२७१-१३", "content_sanskrit": "वालखिल्यास्तपःसिद्धाः कृष्णद्वैपायनस्तथा।\nनारदः पर्वतश्चैव विश्वावसुर्हहाहुहूः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2099977, "chapter_id": 3141, "verse_number": "१३-२७१-१४", "content_sanskrit": "तुम्बुरुश्चित्रसेनश्च देवदूतश्च विश्रुतः।\nदेवकन्या महाभागा दिव्याश्चाप्सरसां गणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2099978, "chapter_id": 3141, "verse_number": "१३-२७१-१५", "content_sanskrit": "उर्वशी मेनका रम्भा मिश्रकेशी ह्यलम्बुषा।\nविश्वाची च घृताची च पञ्चचूडा तिलोत्तमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2099979, "chapter_id": 3141, "verse_number": "१३-२७१-१६", "content_sanskrit": "आदित्या वसवो रुद्राः साश्विनः पितरोपि च।\nधर्मः श्रुतं तपो दीक्षा व्यवसायः पितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2099980, "chapter_id": 3141, "verse_number": "१३-२७१-१७", "content_sanskrit": "शर्वर्यो दिवसाश्चैव मारीचः कश्यपस्तथा।\nशुक्रो बृहस्पतिर्भौमो बुधो राहुः शनैश्चरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2099981, "chapter_id": 3141, "verse_number": "१३-२७१-१८", "content_sanskrit": "नक्षत्राण्यृतवश्चैव मासाः पक्षाः सवत्सराः।\nवैनतेयाः समुद्राश्च कद्रुजाः पन्नगास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2099982, "chapter_id": 3141, "verse_number": "१३-२७१-१९", "content_sanskrit": "शतद्रुश्च विपाशा च चन्द्रभागा सरस्वती।\nसिन्धुश्च देविका चैव प्रभासं पुष्कराणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2099983, "chapter_id": 3141, "verse_number": "१३-२७१-२०", "content_sanskrit": "गङ्गा महानदी वेणा कावेरी नर्मदा तथा।\nकुलम्पुना विशल्या च करतोयाम्बुवाहिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2099984, "chapter_id": 3141, "verse_number": "१३-२७१-२१", "content_sanskrit": "सरयूर्गण्डकी चैव लोहितश्च महानदः।\nताम्रारुणा वेत्रवती पर्णाशा गौतमी तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2099985, "chapter_id": 3141, "verse_number": "१३-२७१-२२", "content_sanskrit": "गोदावरी च वेण्या च कृष्णवेणा तथाऽद्रिजा।\nदृषद्वती च कावेरी चक्षुर्मन्दाकिनी तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2099986, "chapter_id": 3141, "verse_number": "१३-२७१-२३", "content_sanskrit": "प्रयागं च प्रभासं च पुण्यं नैमिषमेव च।\nतच्च विश्वेश्वरस्थानं यत्र तद्विमलं सरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2099987, "chapter_id": 3141, "verse_number": "१३-२७१-२४", "content_sanskrit": "पुण्यतीर्थं सुसलिलं कुरुक्षेत्रं प्रकीर्तितम्।\nसिन्धूत्तमं तपो दानं जम्बूमार्गमथापि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2099988, "chapter_id": 3141, "verse_number": "१३-२७१-२५", "content_sanskrit": "हिरण्वती वितस्ता च तथा प्लक्षवती नदी।\nवेदस्मृतिर्वेदवती मालवाऽथाश्ववत्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2099989, "chapter_id": 3141, "verse_number": "१३-२७१-२६", "content_sanskrit": "भूमिभागास्तथा पुण्या गङ्गाद्वारमथापि च।\nऋषिकुल्यास्तथा मेध्या नद्यः सिन्धुवहास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2099990, "chapter_id": 3141, "verse_number": "१३-२७१-२७", "content_sanskrit": "चर्मण्वती नदी पुण्या कौशिकी यमुना तथा।\nनदी भीमरथी चैव बाहुदा च महानदी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2099991, "chapter_id": 3141, "verse_number": "१३-२७१-२८", "content_sanskrit": "माहेन्द्रवाणी त्रिदिवा नीलिका च सरस्वती।\nनन्दा चापरनन्दा च तथा तीर्थमहाह्रदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2099992, "chapter_id": 3141, "verse_number": "१३-२७१-२९", "content_sanskrit": "गयाऽथ फल्गुतीर्थं च धर्मारण्यं सुरैर्वृतम्।\nतथा देवनदी पुण्या सरश्च ब्रह्मनिर्मितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2099993, "chapter_id": 3141, "verse_number": "१३-२७१-३०", "content_sanskrit": "पुण्यं त्रिलोकविख्यातं सर्वपापहरं शिवम्।\nहिमवान्पर्वतश्चैव दिव्यौषधिसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2099994, "chapter_id": 3141, "verse_number": "१३-२७१-३१", "content_sanskrit": "विन्ध्यो धातुविचित्राङ्गस्तीर्थवानौषधान्वितः।\nमेरुर्महेन्द्रो मलयः श्वेतश्च रजतावृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2099995, "chapter_id": 3141, "verse_number": "१३-२७१-३२", "content_sanskrit": "शृङ्गवान्मन्दरो नीलो निषधो दर्दुरस्तथा।\nचित्रकूटोऽञ्जनाभश्च पर्वतो गन्धमादनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2099996, "chapter_id": 3141, "verse_number": "१३-२७१-३३", "content_sanskrit": "पुण्यः सोमगिरिश्चैव तथैवान्ये महीधराः।\nदिशश्च विदिशश्चैव क्षितिः सर्वे महीरुहाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2099997, "chapter_id": 3141, "verse_number": "१३-२७१-३४", "content_sanskrit": "विश्वेदेवा नभश्चैव नक्षत्राणि ग्रहास्तथा।\nपान्तु नः सततं देवाः कीर्तिताऽकीर्तिता मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2099998, "chapter_id": 3141, "verse_number": "१३-२७१-३५", "content_sanskrit": "कीर्तयानो नरो ह्येतान्मुच्यते सर्वकिल्बिषैः।\nस्तुवंश्च प्रतिनन्दंश्च मुच्यते सर्वतो भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2099999, "chapter_id": 3141, "verse_number": "१३-२७१-३६", "content_sanskrit": "सर्वसङ्करपापेभ्यो देवतास्तवनन्दकः।\nदेवतानन्तरं विप्रांस्तपःसिद्धांस्तपोधिकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2100000, "chapter_id": 3141, "verse_number": "१३-२७१-३७", "content_sanskrit": "कीर्तितान्कीर्तयिष्यामि सर्वपापप्रमोचनान्।\nयवक्रीतोऽथ रैम्यश्च कक्षीवानौशिजस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2100001, "chapter_id": 3141, "verse_number": "१३-२७१-३८", "content_sanskrit": "भृग्वङ्गिरास्तथा कण्वो मेधातिथिरथ प्रभुः।\nबर्ही च गुणसम्पन्नः प्राचीं दिशमुपाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2100002, "chapter_id": 3141, "verse_number": "१३-२७१-३९", "content_sanskrit": "भद्रां दिशं महाभागा उल्मुचुः प्रमुचुस्तथा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2100003, "chapter_id": 3141, "verse_number": "१३-२७१-३९", "content_sanskrit": "मुमुचुश्च महाभागः स्वस्त्यात्रेयश्च वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2100004, "chapter_id": 3141, "verse_number": "१३-२७१-४०", "content_sanskrit": "मित्रावरुणयोः पुत्रस्तथाऽगस्त्यः प्रतापवान्।\nदृढायुश्चोर्ध्वबाहुश्च विश्रुतावृषिसत्तमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2100005, "chapter_id": 3141, "verse_number": "१३-२७१-४१", "content_sanskrit": "पश्चिमां दिशमाश्रित्य य एधन्ते निबोध तान्।\nउषङ्गुः सह सोदर्यैः परिव्याधश्च वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2100006, "chapter_id": 3141, "verse_number": "१३-२७१-४२", "content_sanskrit": "ऋषिर्दीर्घतमाश्चैव गौतमः काश्यपस्तथा।\nएकतश्च द्वितश्चैव त्रितश्चैव महानृषिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2100007, "chapter_id": 3141, "verse_number": "१३-२७१-४३", "content_sanskrit": "अत्रेः पुत्रश्च धर्मात्मा तथा सारस्वतः प्रभुः।\nउत्तरां दिशमाश्रित्य य एधन्ते निबोध तान्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2100008, "chapter_id": 3141, "verse_number": "१३-२७१-४४", "content_sanskrit": "अत्रिर्वसिष्ठः शक्तिश्च पाराशर्यश्च वीर्यवान्।\nविश्वामित्रो भरद्वाजो जमदग्निस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2100009, "chapter_id": 3141, "verse_number": "१३-२७१-४५", "content_sanskrit": "ऋचीकपुत्रो रामश्च ऋषिरौद्दालकिस्तथा।\nश्वेतकेतुः कोहलश्च विपुलो देवलस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2100010, "chapter_id": 3141, "verse_number": "१३-२७१-४६", "content_sanskrit": "देवशर्मा च धौम्यश्च हस्तिकाश्यप एव च।\nलोमशो नाचिकेतश्च लोमहर्षण एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2100011, "chapter_id": 3141, "verse_number": "१३-२७१-४७", "content_sanskrit": "ऋषिरुग्रश्रवाश्चैव भार्गवश्च्यवनस्तथा।\nएष वै समवायश्च ऋषिदेवसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2100012, "chapter_id": 3141, "verse_number": "१३-२७१-४८", "content_sanskrit": "आद्यः प्रकीर्तितो राजन्सर्वपापप्रमोचनः।\nनृगो ययातिर्नहुषो यदुः पूरुश्च वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2100013, "chapter_id": 3141, "verse_number": "१३-२७१-४९", "content_sanskrit": "धुन्धुमारो दिलीपश्च सगरश्च प्रतापवान्।\nकृशाश्वो यौवनाश्वश्च चित्राश्वः सत्यवांस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2100014, "chapter_id": 3141, "verse_number": "१३-२७१-५०", "content_sanskrit": "दुष्यन्तो भरतश्चैव चक्रवर्ती महायशाः।\nपवनो जनकश्चैव तथा दृष्टरथो नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2100015, "chapter_id": 3141, "verse_number": "१३-२७१-५१", "content_sanskrit": "रघुर्नरवरश्चैव तथा दशरथो नृपः।\nरामो राक्षसहा वीरः शशबिन्दुर्भगीरथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2100016, "chapter_id": 3141, "verse_number": "१३-२७१-५२", "content_sanskrit": "हरिश्चन्द्रो मरुत्तश्च तथा द़ढरथो नृपः।\nमहोदर्यो ह्यलर्कश्च ऐलश्चैव नराधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2100017, "chapter_id": 3141, "verse_number": "१३-२७१-५३", "content_sanskrit": "करंधमो नरश्रेष्ठः कध्मोरश्च नराधिपः।\nदक्षोऽम्बरीषः कुकुरो रैवतश्च महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2100018, "chapter_id": 3141, "verse_number": "१३-२७१-५४", "content_sanskrit": "कुरु संवरणश्चैव मांधाता सत्यविक्रमः।\nमुचुकुन्दश्च राजर्षिर्जह्नुर्जाह्नविसेवितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2100019, "chapter_id": 3141, "verse_number": "१३-२७१-५५", "content_sanskrit": "आदिराजः पृथुर्वैन्यो मित्रभानुः प्रियङ्करः।\nत्रसद्दस्युस्तथा राजा श्वेतो राजर्षिसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2100020, "chapter_id": 3141, "verse_number": "१३-२७१-५६", "content_sanskrit": "महाभिषश्च विख्यातो निमी राजा तथाऽष्टकः।\nआयुः क्षुपश्च राजर्षिः कक्षेयुस्च नराधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2100021, "chapter_id": 3141, "verse_number": "१३-२७१-५७", "content_sanskrit": "प्रतर्दनो दिवोदासः सुदासः कोसलेश्वरः।\nऐलो नलश्च राजर्षिर्मनुश्चैव प्रजापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2100022, "chapter_id": 3141, "verse_number": "१३-२७१-५८", "content_sanskrit": "हविध्रश्च पृषध्रश्च प्रतीपः शान्तनुस्तथा।\nअजः प्राचीनबर्हिश्च तथैक्ष्वाकुर्महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2100023, "chapter_id": 3141, "verse_number": "१३-२७१-५९", "content_sanskrit": "अनरण्यो नरपतिर्जानुजङ्घस्तथैव च।\nकक्षसेनश्च राजर्षिर्ये चान्ये चानुकीर्तिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2100024, "chapter_id": 3141, "verse_number": "१३-२७१-६०", "content_sanskrit": "कल्यमुत्थाय यो नित्यं सन्ध्ये द्वेऽस्तमयोदये।\nपठेच्छुचिरनावृत्तः स धर्मफलभाग्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2100025, "chapter_id": 3141, "verse_number": "१३-२७१-६१", "content_sanskrit": "देवा देवर्षयश्चैव स्तुता राजर्षयस्तथा।\nपुष्टिमायुर्यशः स्वर्गं विधास्यन्ति ममेश्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2100026, "chapter_id": 3141, "verse_number": "१३-२७१-६२", "content_sanskrit": "मा विघ्नं मा च मे पापं मा च मे परिपन्थिनः।\nध्रुवो जयो मे नित्यः स्यात्परत्र च शुभा गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2100027, "chapter_id": 3141, "verse_number": "१३-२७१-६३", "content_sanskrit": "`पालय त्वं प्रजाः सर्वाः शान्तात्मा त्वनुशासिता।\nद्वैपायनः स्वयंचक्षुः कृष्णस्तेऽस्तु परायणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2100028, "chapter_id": 3141, "verse_number": "१३-२७१-६४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2100029, "chapter_id": 3141, "verse_number": "१३-२७१-६४", "content_sanskrit": "इत्युक्त्वोपासनार्थाय विरराम महामतिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2100030, "chapter_id": 3141, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकसप्तत्यधिकद्विशततमोऽध्यायः॥ २७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}]