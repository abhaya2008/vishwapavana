[{"id": 2129180, "chapter_id": 3779, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2129181, "chapter_id": 3779, "verse_number": "१", "content_sanskrit": "ततः श्रुत्वा तु शर्य्यातिर्वयस्स्थं च्यवनं कृतम् ।\nप्रहृष्टः सेनया सार्धमुपायाद् भार्गवाश्रमम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2129182, "chapter_id": 3779, "verse_number": "२", "content_sanskrit": "च्यवनं च सुकन्यां च दृष्ट्वा देवसुताविव ।\nरेमे महीपः शर्य्यातिः कृत्स्नां प्राप्य महीमिव\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2129183, "chapter_id": 3779, "verse_number": "३", "content_sanskrit": "ऋषिणा सत्कृतस्तेन सभार्यः पृथिवीपतिः ।\nउपोपविष्टः कल्याणीः कथाश्चक्रे महामनाः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2129184, "chapter_id": 3779, "verse_number": "४", "content_sanskrit": "अथैनं भार्गवो राजन्नुवाच परिसान्त्वयन् ।\nयाजयिष्यामि राजंस्त्वां सम्भारानुपकल्पय \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2129185, "chapter_id": 3779, "verse_number": "५", "content_sanskrit": "ततः परमसंहृष्टः शर्य्यातिः पृथिवीपतिः ।\nच्यवनस्य महाराज तद्वाक्यं प्रत्यपूजयत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2129186, "chapter_id": 3779, "verse_number": "६", "content_sanskrit": "प्रशस्तेऽहनि याज्ञीये सर्वकामसमृद्धिमत् ।\nकारयामास शर्यातिर्यज्ञायतनमुत्तमम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2129187, "chapter_id": 3779, "verse_number": "७", "content_sanskrit": "तत्रैनं च्यवनो राजन् याजयामास भार्गवः ।\nअत्यद्भुतानि तत्रासन् यानि तानि निबोध मे\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2129188, "chapter_id": 3779, "verse_number": "८", "content_sanskrit": "अगृह्णाच्च्यवनः सोममश्विनोर्देवयोस्तदा ।\nतमिन्द्रो वारयामास गृह्यमाणं तयोर्ग्रहम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2129189, "chapter_id": 3779, "verse_number": "९", "content_sanskrit": "उभावेतौ न सोमार्हौ नासत्याविति मे मतिः ।\nभिषजौ देवतानां हि पातुं सोमं नचार्हतः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2129190, "chapter_id": 3779, "verse_number": "", "content_sanskrit": "च्यवनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2129191, "chapter_id": 3779, "verse_number": "१०", "content_sanskrit": "माऽवमंस्था महात्मानौ रूपद्रविणवत्तमौ ।\nयौ चक्रतुर्मा मघवन् वृन्दारकमिवाजरम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2129192, "chapter_id": 3779, "verse_number": "११", "content_sanskrit": "ऋते त्वां विबुधांश्चान्यान् कथं वै नार्हतः स्वयम् ।\nअश्विनावपि देवेन्द्र देवौ विद्धि पुरन्दर\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2129193, "chapter_id": 3779, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2129194, "chapter_id": 3779, "verse_number": "१२", "content_sanskrit": "चिकित्सकौ कर्मकरौ कामरूपसमन्वितौ ।\nलोके चरन्तौ मर्त्यानां कथं सोममिहार्हतः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2129195, "chapter_id": 3779, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2129196, "chapter_id": 3779, "verse_number": "१३", "content_sanskrit": "एतदेव तदा वाक्यमाम्रेडयति वासवे ।\nअनादृत्य ततः शक्रं ग्रहं जग्राह भार्गवः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2129197, "chapter_id": 3779, "verse_number": "१४", "content_sanskrit": "ग्रहीष्यन्तं तु तं सोममश्विनोरुत्तमं तदा ।\nसमीक्ष्य बलभिद् देव इदं वचनमब्रवीत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2129198, "chapter_id": 3779, "verse_number": "१५", "content_sanskrit": "आभ्यामर्थाय सोमं त्वं ग्रहीष्यसि यदि स्वयम् ।\nवज्रं ते प्रहरिष्यामि घोररूपं भृगूद्वह\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2129199, "chapter_id": 3779, "verse_number": "१६", "content_sanskrit": "एवमुक्तः स्मयन्निन्द्रमभिवीक्ष्य स भार्गवः ।\nजग्राह विधिवत् सोममश्विभ्यामुत्तमं ग्रहम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2129200, "chapter_id": 3779, "verse_number": "१७", "content_sanskrit": "ततोऽस्त्रं प्रतिजग्राह घोररूपं शचीपतिः ।\nतस्य प्रहरतो बाहुं स्तम्भयामास भार्गवः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2129201, "chapter_id": 3779, "verse_number": "१८", "content_sanskrit": "संस्तम्भयित्वा च्यवनो जुहुवे मन्त्रतोऽनलम् ।\nकृत्यार्थी सुमहातेजा देवं हिंसितुमुद्यतः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2129202, "chapter_id": 3779, "verse_number": "१९", "content_sanskrit": "ततः कृत्या समभवद् ऋषेस्तस्य तपोबलात् ।\nमदो नाम महावीर्यो बृहत्कायो महाबलः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2129203, "chapter_id": 3779, "verse_number": "२०", "content_sanskrit": "शरीरं यस्य निर्देष्टुमशक्यं हि सुरासुरैः ।\nतस्यास्यमभवद् घोरं तीक्ष्णाग्रदशनं महत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2129204, "chapter_id": 3779, "verse_number": "२१", "content_sanskrit": "हनुरेका स्थिता त्वस्य भूमावेका दिवं गता ।\nचतस्र आयता दंष्ट्रा योजनानां शतंशतम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2129205, "chapter_id": 3779, "verse_number": "२२", "content_sanskrit": "इतरे तस्य दशना बभूवुर्दशयोजनाः ।\nप्राकारसदृशाकाराः शूलाग्रसमदर्शनाः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2129206, "chapter_id": 3779, "verse_number": "२३", "content_sanskrit": "बाहू परिघसङ्काशावायतावयुतं शतम् ।\nनेत्रे रविशशिप्रख्ये वक्त्रं कालाग्निसंनिभम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2129207, "chapter_id": 3779, "verse_number": "२४", "content_sanskrit": "लेलिहञ्जिह्वया वक्त्रं विद्युच्चपललोलया ।\nव्यात्ताननो घोरदृष्टिर्ग्रसन्निव जगद् बलात्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2129208, "chapter_id": 3779, "verse_number": "२५", "content_sanskrit": "स भक्षयिष्यन् सङ्क्रुद्धः शतक्रतुमुपाद्रवत् ।\nमहता घोररूपेण लोकान् शब्देन पूरयन्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2129209, "chapter_id": 3779, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2129210, "chapter_id": 3779, "verse_number": "२६", "content_sanskrit": "तं दृष्ट्वा घोरवदनं मदं देवः शतक्रतुः ।\nआयान्तं भक्षयिष्यन्तं व्यात्ताननमिवान्तकम् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2129211, "chapter_id": 3779, "verse_number": "२७", "content_sanskrit": "भयात् संस्तम्भितभुजः सृक्विणी लेलिहन् मुहुः ।\nततोऽब्रवीद् देवराजः च्यवनं भयपीडितः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2129212, "chapter_id": 3779, "verse_number": "२८", "content_sanskrit": "सोमार्हावश्विनावेतावद्य प्रभृति भार्गव ।\nभविष्यतः सत्यमेतद् वचो विप्र प्रसीद मे\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2129213, "chapter_id": 3779, "verse_number": "२९", "content_sanskrit": "न ते मिथ्या समारम्भो भवत्येष तपोधन ।\nजानामि चाहं विप्रर्षे न मिथ्या त्वं करिष्यसि\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2129214, "chapter_id": 3779, "verse_number": "३०", "content_sanskrit": "सोमपावश्विनावेतौ यथा वाऽद्य कृतो त्वया ।\nतथैव मामपि ब्रह्मन् श्रेयसा योक्तुमर्हसि \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2129215, "chapter_id": 3779, "verse_number": "३१", "content_sanskrit": "भूय एव तु ते वीर्यं प्रकाशेदिति भार्गव ।\nसुकन्यायाः पितुश्चास्य कीर्तिर्लोके प्रथेदिति\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2129216, "chapter_id": 3779, "verse_number": "३२", "content_sanskrit": "अतो मयैतत् प्रथितं तव कीर्तिप्रकाशनम् ।\nतस्मात् प्रसादं कुरु मे भवत्वेतद् यदिच्छसि\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2129217, "chapter_id": 3779, "verse_number": "३३", "content_sanskrit": "एवमुक्तस्य शक्रेण च्यवनस्य महात्मनः ।\nस मन्युर्व्यगमच्छीघ्रं मुमोच च पुरन्दरम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2129218, "chapter_id": 3779, "verse_number": "३४", "content_sanskrit": "मदं च व्यभजद् राजन् मद्ये स्त्रीषु च वीर्यवान् ।\nअक्षेषु मृगयायां च पूर्वसृष्टं पुनःपुनः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2129219, "chapter_id": 3779, "verse_number": "३५", "content_sanskrit": "तदा मदं विनिक्षिप्य शक्रं सन्तर्प्य चेन्दुना ।\nअश्विभ्यां सहितान् देवान् याजयित्वा च तं नृपम् \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2129220, "chapter_id": 3779, "verse_number": "३६", "content_sanskrit": "विख्याप्य वीर्यं लोकेषु सर्वेषु वदतां वरः ।\nसुकन्यया महारण्ये विजहारानुरक्तया\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2129221, "chapter_id": 3779, "verse_number": "३७", "content_sanskrit": "तस्यैतद् द्विजसङ्घुष्टं सरो दिव्यं प्रकाशते ।\nअत्र त्वं सह सोदर्यैः पितॄन् देवांश्च तर्पय\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2129222, "chapter_id": 3779, "verse_number": "३८", "content_sanskrit": "एतद् दृष्ट्वा महीपाल वल्मीकाग्रं च भारत ।\nसैन्धवारण्यमासाद्य कुल्यानां कुरु दर्शनम् ।\nपुष्करेषु महाराज सर्वेषु च जलं स्पृश \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2129223, "chapter_id": 3779, "verse_number": "३९", "content_sanskrit": "आर्चीकपर्वतश्चैव निवासो वै मनीषिणाम् ।\nसदाफलं सदास्रोतो मरुतां स्थानमुत्तमम् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2129224, "chapter_id": 3779, "verse_number": "४०", "content_sanskrit": "चैत्याश्चैते बहुविधाः त्रिदशानां युधिष्ठिर ।\nएतच्चन्द्रसरो नित्यमर्चयन्नृषयः सदा \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2129225, "chapter_id": 3779, "verse_number": "४१", "content_sanskrit": "वैखानसाश्च ऋषयो वालखिल्यास्तथैव च \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2129226, "chapter_id": 3779, "verse_number": "४२", "content_sanskrit": "शृङ्गाणि त्रीणि पुण्यानि त्रीणि प्रस्रवणानि च ।\nसर्वाण्यनुपरिक्रम्य यथाकाममुपस्पृश \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2129227, "chapter_id": 3779, "verse_number": "४३", "content_sanskrit": "शन्तनुश्चात्र कौन्तेय शुनकश्च विशांपते ।\nनरनारायणौ चोभौ स्थानं प्राप्ताः सनातनम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2129228, "chapter_id": 3779, "verse_number": "४४", "content_sanskrit": "इह नित्याश्रया देवाः पितरश्च महर्षिभिः ।\nआर्चीकपर्वते ये तु तान् यजस्व युधिष्ठिर \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2129229, "chapter_id": 3779, "verse_number": "४५", "content_sanskrit": "इह ते वै चरून् प्राश्नंस्त्रिदशाश्च विशांपते ।\nयमुना चाक्षयस्रोताः कृष्णश्चेह तपोऽचरत्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2129230, "chapter_id": 3779, "verse_number": "४६", "content_sanskrit": "यमौ च भीमसेनश्च कृष्णा चामित्रकर्शन ।\nसर्वे चात्र गमिष्यामः त्वयैव सह पाण्डव ।\nएतत् प्रस्रवणं पुण्यमिन्द्रस्य मनुजाधिप \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2129231, "chapter_id": 3779, "verse_number": "४७", "content_sanskrit": "अत्र धाता विधाता च वरुणश्चोर्ध्वमागताः ।\nअत्र ते न्यवसन् राजन् काङ्क्षन्तः सहधर्मिणः ।\tमैत्राणामृजुबुद्धीनामयं गिरिवरः शिवः \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2129232, "chapter_id": 3779, "verse_number": "४९", "content_sanskrit": "एषा सा यमुना राजन् महर्षिगणसेविता ।\nनानायज्ञचिता पुण्या सर्वपापभयापहा\t॥४८॥\nअत्र राजा महेष्वासो मान्धाताऽयजत स्वयम् ।\nसहदेवश्च कौन्तेय सोमको वदतां वरः \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2129233, "chapter_id": 3779, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि एकविंशोत्तरशततमोऽध्यायः ॥१२१॥\n॥ तीर्थयात्रापर्वणि सप्तसप्ततितमोऽध्यायः ॥७७॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]