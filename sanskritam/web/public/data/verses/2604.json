[{"id": 2075752, "chapter_id": 2604, "verse_number": "१२-१०९-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2075753, "chapter_id": 2604, "verse_number": "१२-१०९-१", "content_sanskrit": "कथं धर्मे स्थातुमिच्छन्नरो वर्तेत भारत।\nतत्त्वं जिज्ञासमानाय प्रब्रूहि भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2075754, "chapter_id": 2604, "verse_number": "१२-१०९-२", "content_sanskrit": "सत्यं चैवानृतं चोभे लोकानावृत्य तिष्ठतः।\nतयोः किमाचरेद्राजन्पुरुषो धर्मनिश्चितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2075755, "chapter_id": 2604, "verse_number": "१२-१०९-३", "content_sanskrit": "किंस्वित्सत्यं किमनृतं किंस्विद्धर्म्यं सनातनम्।\nकस्मिन्काले वदेत्सत्यं कस्मिन्वाऽप्यनृतं वदेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2075756, "chapter_id": 2604, "verse_number": "१२-१०९-४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2075757, "chapter_id": 2604, "verse_number": "१२-१०९-४", "content_sanskrit": "सत्यस्य वचनं साधु न सत्याद्विद्यते परम्।\nयत्तु लोके सुदुर्ज्ञेयं तत्ते वक्ष्यामि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2075758, "chapter_id": 2604, "verse_number": "१२-१०९-५", "content_sanskrit": "भवेत्सत्यं न वक्तव्यं वक्तव्यमनृतं भवेत्।\nयत्रानृतं भवेत्सत्यं सत्यं वाऽप्यनृतं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2075759, "chapter_id": 2604, "verse_number": "१२-१०९-६", "content_sanskrit": "तादृशो वर्धते पापो यत्र सत्यमनिश्चितम्।\nसत्यानृते विनिश्चित्य ततो भवति धर्मवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2075760, "chapter_id": 2604, "verse_number": "१२-१०९-७", "content_sanskrit": "अप्यनार्योऽकृतप्रज्ञः पुरुषोऽप्यतिदारुणः।\nसुमहत्प्राप्नुयात्पुण्यं बलाकोऽन्धवधादिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2075761, "chapter_id": 2604, "verse_number": "१२-१०९-८", "content_sanskrit": "किमाश्चर्यं च यन्मूढो धर्मकामोऽप्यधर्मवित्।\nसुमहत्प्राप्नुयात्पुण्यं गङ्गायामिव कौशिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2075762, "chapter_id": 2604, "verse_number": "१२-१०९-९", "content_sanskrit": "तादृशोऽयमनुप्रश्नो यत्र धर्मः सुदुर्विदः।\nदुष्कारं चापि संख्यातुं तर्केणात्र व्यवस्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2075763, "chapter_id": 2604, "verse_number": "१२-१०९-१०", "content_sanskrit": "प्रभवार्थाय भूतानां धर्मप्रवचनं कृतम्।\nयः स्यात्प्रभवसंयुक्तः स धर्म इति निश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2075764, "chapter_id": 2604, "verse_number": "१२-१०९-११", "content_sanskrit": "`अहिंसा सत्यमक्रोधस्तपो दानं दमो मतिः।\nअनसूयाऽप्यसामर्थ्यमनीर्ष्या शीलमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2075765, "chapter_id": 2604, "verse_number": "१२-१०९-१२", "content_sanskrit": "एष धर्मः कुरुश्रेष्ठ कथितं परमेष्ठिना।\nब्रह्मणा देवदेवेन अयं चैव सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2075766, "chapter_id": 2604, "verse_number": "१२-१०९-१३", "content_sanskrit": "अस्मिन्धर्मे स्थितो राजन्नरो भद्राणि पश्यति।\nश्रौतो वधात्मको धर्म अहिंसापरमार्थिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2075767, "chapter_id": 2604, "verse_number": "१२-१०९-१४", "content_sanskrit": "धारणाद्धर्ममित्याहुर्धर्मेण विधृताः प्रजाः।\nयः स्याद्धारणसंयुक्तः स धर्म इति निश्चः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2075768, "chapter_id": 2604, "verse_number": "१२-१०९-१५", "content_sanskrit": "अहिंसार्थाय भूतानां धर्मप्रवचनं कृतम्।\nयः स्यादहिंसासंयुक्तः स धर्म इति निश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2075769, "chapter_id": 2604, "verse_number": "१२-१०९-१६", "content_sanskrit": "श्रुतिं धर्मं वदन्त्यन्ये मानान्याहुः परे जनाः।\nन च तं स्वभ्यसूयामो न हि सर्वं विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2075770, "chapter_id": 2604, "verse_number": "१२-१०९-१७", "content_sanskrit": "येऽन्यायेन जिहीर्षन्तो धनमिच्छन्ति कर्हिचित्।\nतेभ्यस्तु न तदाख्येयं स धर्म इति निश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2075771, "chapter_id": 2604, "verse_number": "१२-१०९-१८", "content_sanskrit": "अकूजनेन चेन्मोक्षो नावकूजेत्कथंचन।\nअवश्यं कूजितव्यं वा शङ्केरन्वाऽप्यकूजनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2075772, "chapter_id": 2604, "verse_number": "१२-१०९-१९", "content_sanskrit": "`येऽन्ये वाऽप्यनृतं कुर्युः कुर्यादेव विचारणम्।\nश्रेयस्तत्रानृतं वक्तुं सत्यादिति विचारितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2075773, "chapter_id": 2604, "verse_number": "१२-१०९-२०", "content_sanskrit": "अक्षयाद्यो वधं राजन्कुर्यादेवाविचारयन्।\nअबुध्वाऽनुशये दोषं श्रेयस्तच्चानृतं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2075774, "chapter_id": 2604, "verse_number": "१२-१०९-२१", "content_sanskrit": "न स्तेनः सह संबन्धान्मुच्यते शपथादपि।\nश्रेयस्तत्रानृतं वक्तुं सत्यादिति हि धारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2075775, "chapter_id": 2604, "verse_number": "१२-१०९-२२", "content_sanskrit": "यः पापैः सह संबन्धान्मुच्यते शपथादपि।\nन च तेभ्यो धनं दद्याच्छक्ये सति कथंचन।\nपापेभ्यो हि धनं दत्तं दातारमपि पीडयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2075776, "chapter_id": 2604, "verse_number": "१२-१०९-२३", "content_sanskrit": "स्वशरीरोपरोधेन धनमादातुमिच्छतः।\nसत्यसंप्रतिपत्त्यर्थं यद्ब्रूयुः साक्षिणः क्वचित्।\nअनुक्त्वा तत्र तद्वाच्यं सर्वे तेऽनृतवादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2075777, "chapter_id": 2604, "verse_number": "१२-१०९-२४", "content_sanskrit": "प्राणात्यये विवाहे च वक्तव्यमनृतं भवेत्।\nअर्थस्य रक्षणार्थाय परेषां धर्मकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2075778, "chapter_id": 2604, "verse_number": "१२-१०९-२५", "content_sanskrit": "परेषां सिद्धिमाकाङ्क्षन्न च स्याद्धर्मभिक्षुकः।\nप्रतिश्रुत्य न दातव्यं श्वः कार्यस्तु बलात्कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2075779, "chapter_id": 2604, "verse_number": "१२-१०९-२६", "content_sanskrit": "यः कश्चिद्धर्मसमयात्प्रच्युतो धर्मजीवनः।\nदण्डेनैव स हन्तव्यस्तं पन्थानं समाश्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2075780, "chapter_id": 2604, "verse_number": "१२-१०९-२७", "content_sanskrit": "च्युतः सदैव धर्मेभ्यो धनवान्धर्ममाश्रितः।\nकथं स्वधर्ममुत्सृज्य तमिच्छेदुपजीवितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2075781, "chapter_id": 2604, "verse_number": "१२-१०९-२८", "content_sanskrit": "सर्वोपायैर्नियन्तव्यः पापो निकृतिजीवनः।\nधनमित्येव पापानां सर्वेषामिह निश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2075782, "chapter_id": 2604, "verse_number": "१२-१०९-२९", "content_sanskrit": "अविवाह्या ह्यसंभोज्या निकृत्या निरयं गताः।\nच्युता देवमनुष्येभ्यो यथा प्रेतास्तथैव ते।\n[निर्यज्ञास्तपसा हीना मा स्म तैः सह संगमः॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2075783, "chapter_id": 2604, "verse_number": "१२-१०९-३०", "content_sanskrit": "धनादानाद्दुःखतरं जीविता धिक्प्रयोजनम्।\nइदं ते रोचतां धर्म इति वाच्यं प्रयत्नतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2075784, "chapter_id": 2604, "verse_number": "१२-१०९-३१", "content_sanskrit": "न कश्चिदस्ति पापानां धर्म इत्येष निश्चयः।\nतथाविधं च यो हन्यान्न स पापेन लिप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2075785, "chapter_id": 2604, "verse_number": "१२-१०९-३२", "content_sanskrit": "स्वकर्मणा हतं हन्ति हत एव स हन्यते।\nतेषु यः समयं कश्चित्कुर्वीत हतबुद्धिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2075786, "chapter_id": 2604, "verse_number": "१२-१०९-३३", "content_sanskrit": "यथा काकास्तथैव श्वा तथैवोपधिजीवनः।\nऊर्ध्वं देहविमोक्षान्ते भवन्त्येतासु योनिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2075787, "chapter_id": 2604, "verse_number": "१२-१०९-३४", "content_sanskrit": "यस्मिन्यथा वर्तति यो मनुष्य\nस्तस्मिंस्तथा वर्तितव्यं स धर्मः।\nमायाचारो मायया बाधितव्यः\nसाध्वाचारः साधुनैवाभ्युपेयः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2075788, "chapter_id": 2604, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि नवाधिकशततमोऽध्यायः॥ १०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]