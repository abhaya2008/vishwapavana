[{"id": 2204121, "chapter_id": 5351, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2204122, "chapter_id": 5351, "verse_number": "१", "content_sanskrit": "भगवन् देवदेवेश त्रियक्ष वृषभध्वज ।\nमानुषास्त्रिविधा देव दृश्यन्ते सततं विभो\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2204123, "chapter_id": 5351, "verse_number": "२", "content_sanskrit": "आसीना एव भुञ्जन्ते स्थानैश्वर्यपरिग्रहैः ।\nअपरे यत्नपूर्वं तु लभन्ते भोगसङ्ग्रहम्\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2204124, "chapter_id": 5351, "verse_number": "३", "content_sanskrit": "अपरे यत्नकुर्वन्तो लभन्ते न तु किञ्चन ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2204125, "chapter_id": 5351, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2204126, "chapter_id": 5351, "verse_number": "४", "content_sanskrit": "न्यायतस्त्वं महाभागे श्रोतुकामाऽसि भामिनि\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2204127, "chapter_id": 5351, "verse_number": "५", "content_sanskrit": "ये लोके मानुषा देवि दानधर्मपरायणाः ।\nपात्राणि विधिवज्ज्ञात्वा दूरतो ह्यनुमानतः\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2204128, "chapter_id": 5351, "verse_number": "६", "content_sanskrit": "दानादि चेङ्गितैरेव तैरविज्ञातमेव वा ।\nअभिगम्य स्वयं तत्र ग्राहयन्ति प्रसाद्य च\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2204129, "chapter_id": 5351, "verse_number": "७", "content_sanskrit": "पुनर्जन्मनि देवेशि तादृशाः शोभना नराः ।\nअयत्नतस्तु तान्येव फलानि प्राप्नुवन्त्युत\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2204130, "chapter_id": 5351, "verse_number": "८", "content_sanskrit": "आसीना एव भुञ्जन्ते भोगान् सुकृतभोगिनः\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2204131, "chapter_id": 5351, "verse_number": "९", "content_sanskrit": "अपरे ये च दानानि ददत्येव प्रयाचिताः ।\nयथा यथा ते दीनत्वात् पुनर्दास्यन्ति याचिताः\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2204132, "chapter_id": 5351, "verse_number": "१०", "content_sanskrit": "तावत्कालं ततो देवि पुनर्जन्मनि ते नराः ।\nयत्नतः श्रमसंयुक्ताः पुनस्तान् प्राप्नुवन्ति च\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2204133, "chapter_id": 5351, "verse_number": "११", "content_sanskrit": "याचिता अपि ये केचिन्न ददत्येव किञ्चन ।\nअभ्यसूयापरा मर्त्या लोभोपहतचेतसः\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2204134, "chapter_id": 5351, "verse_number": "१२", "content_sanskrit": "ते पुनर्जन्मनि शुभे यतन्ते बहुधा नराः ।\nन प्राप्नुवन्ति मनुजा मार्गन्तस्तेऽपि किञ्चन\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2204135, "chapter_id": 5351, "verse_number": "१३", "content_sanskrit": "नानुप्तं रोहते सस्यं तद्वद् दानफलं विदुः ।\nयद्यद् ददाति पुरुषस्तत्तत् प्राप्नोति केवलम्\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2204136, "chapter_id": 5351, "verse_number": "समाप्तिः", "content_sanskrit": "इति ते कथितं देवि भूयः श्रोतुं किमिच्छसि\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2204137, "chapter_id": 5351, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2204138, "chapter_id": 5351, "verse_number": "१५", "content_sanskrit": "भगवन् भगनेत्रघ्न केचिद् वार्द्धकसंयुताः ।\nअभोगयोग्यकाले तु भोगांश्चैव धनानि च\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2204139, "chapter_id": 5351, "verse_number": "१६", "content_sanskrit": "लभन्ते स्थविरा भूता भोगैश्वर्यं यतस्ततः ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2204140, "chapter_id": 5351, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2204141, "chapter_id": 5351, "verse_number": "१७", "content_sanskrit": "हन्त ते कथयिष्यामि शृणु तत्त्वं समाहिता\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2204142, "chapter_id": 5351, "verse_number": "१८", "content_sanskrit": "धर्मकार्यं चिरं कालं विस्मृत्य धनसंयुताः ।\nप्राणान्तकाले सम्प्राप्ते व्याधिभिश्च निपीडिताः\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2204143, "chapter_id": 5351, "verse_number": "१९", "content_sanskrit": "आरभन्ते पुनर्धर्मं दातुं दानानि वा नराः ।\nते पुनर्जन्मनि शुभे भूत्वा दुःखपरिप्लुताः\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2204144, "chapter_id": 5351, "verse_number": "२०", "content_sanskrit": "अतीतयौवने काले स्थविरत्वमुपागताः ।\nलभन्ते पूर्वदत्तानां फलानि शुभलक्षणे\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2204145, "chapter_id": 5351, "verse_number": "२१", "content_sanskrit": "एवं कर्मफलं देवि कालयोगाद् भवत्युत\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2204146, "chapter_id": 5351, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2204147, "chapter_id": 5351, "verse_number": "२२", "content_sanskrit": "भोगयुक्ता महादेव केचिद् व्याधिपरिप्लुताः ।\nअसमर्थाश्च तान् भोक्तुं भवन्ति किमु कारणम्\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2204148, "chapter_id": 5351, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2204149, "chapter_id": 5351, "verse_number": "२३", "content_sanskrit": "व्याधियोगपरिक्लिष्टा ये निराशाः स्वजविते ।\nआरभन्ते तदा कर्तुं दानानि शुभलक्षणे\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2204150, "chapter_id": 5351, "verse_number": "२४", "content_sanskrit": "ते पुनर्जन्मनि शुभे प्राप्य तानि फलान्युत ।\nअसमर्थाश्च तान् भोक्तुं व्याधितास्ते भवन्त्युत\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2204151, "chapter_id": 5351, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2204152, "chapter_id": 5351, "verse_number": "२५", "content_sanskrit": "भगवन् देवदेवेश मानुषेष्वेव केचन ।\nरूपयुक्ताः प्रदृश्यन्ते शुभाङ्गा प्रियदर्शनाः ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2204153, "chapter_id": 5351, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2204154, "chapter_id": 5351, "verse_number": "२६", "content_sanskrit": "हन्त ते कथयिष्यामि शृणु तत्त्वं समाहिता\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2204155, "chapter_id": 5351, "verse_number": "२७", "content_sanskrit": "ये पुरा मनुजा देवि लज्जायुक्ताः प्रियंवदाः ।\nशक्ताः सुमधुरा नित्यं भूत्वा चैव स्वभावतः\t ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2204156, "chapter_id": 5351, "verse_number": "२८", "content_sanskrit": "अमांसभोजिनश्चैव सदा प्राणिदयायुताः ।\nप्रतिकर्मप्रदा वाऽपि वस्त्रदा धर्मकारणात् ।\nभूमिशुद्धिकरा वाऽपि कारणादग्निपूजकाः\t ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2204157, "chapter_id": 5351, "verse_number": "२९", "content_sanskrit": "एवं युक्तसमाचाराः पुनर्जन्मनि ते नराः ।\nरूपेण स्पृहणीयास्तु भवन्त्येव न संशयः\t ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2204158, "chapter_id": 5351, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2204159, "chapter_id": 5351, "verse_number": "३०", "content_sanskrit": "विरूपाश्च प्रदृश्यन्ते मानुषेष्वेव केचन ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2204160, "chapter_id": 5351, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2204161, "chapter_id": 5351, "verse_number": "३१", "content_sanskrit": "तदहं ते प्रवक्ष्यामि शृणु कल्याणि कारणम्\t ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2204162, "chapter_id": 5351, "verse_number": "३२", "content_sanskrit": "रूपयोगात् पुरा मर्त्या दर्पाहङ्कारसंयुताः ।\nविरूपहासकाश्चैव स्तुतिनिन्दादिभिर्भृशम्\t ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2204163, "chapter_id": 5351, "verse_number": "३३", "content_sanskrit": "परोपतापिनश्चैव मांसादाश्च तथैव च ।\nअभ्यसूयापराश्चैव अशुद्धाश्च तथैव च\t ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2204164, "chapter_id": 5351, "verse_number": "३४", "content_sanskrit": "एवं युक्तसमाचारा यमलोके सुदण्डिताः ।\nकथञ्चित् प्राप्य मानुष्यं तत्र ते रूपवर्जिताः ।\nविरूपाः सम्भवन्त्येव नास्ति तत्र विचारणा\t ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2204165, "chapter_id": 5351, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2204166, "chapter_id": 5351, "verse_number": "३५", "content_sanskrit": "भगवन् देवदेवेश केचित् सौभाग्यसंयुताः ।\nरूपभोगविहीनाश्च दृश्यन्ते प्रमदाप्रियाः ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2204167, "chapter_id": 5351, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2204168, "chapter_id": 5351, "verse_number": "३६", "content_sanskrit": "ये पुरा मनुजा देवि सौम्यशीलाः प्रियंवदाः ।\nस्वदारैरेव सन्तुष्टा दारेषु समवृत्तयः\t ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2204169, "chapter_id": 5351, "verse_number": "३७", "content_sanskrit": "दाक्षिण्येनैव वर्तन्ते प्रमदास्वप्रियास्वपि ।\nन तु प्रत्यादिशन्त्येव स्त्रीदोषान् गुणसंश्रितान्\t ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2204170, "chapter_id": 5351, "verse_number": "३८", "content_sanskrit": "अन्नपानीयदाः काले नृणां स्वादुप्रदाश्च ये ।\nस्वदारवर्तिनश्चैव धृतिमन्तो निरत्ययाः\t ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2204171, "chapter_id": 5351, "verse_number": "३९", "content_sanskrit": "एवं युक्तसमाचाराः पुनर्जन्मनि शोभने ।\nमानुषास्ते भवन्त्येव सततं सुभगा भृशम् ।\nअर्थादृतेऽपि ते देवि भवन्ति प्रमदाप्रियाः\t ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2204172, "chapter_id": 5351, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2204173, "chapter_id": 5351, "verse_number": "४०", "content_sanskrit": "दुर्भगाः सम्प्रदृश्यन्ते आढ्या भोगयुता अपि ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2204174, "chapter_id": 5351, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2204175, "chapter_id": 5351, "verse_number": "४१", "content_sanskrit": "तदहं ते प्रवक्ष्यामि शृणु सर्वं समाहिता\t ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2204176, "chapter_id": 5351, "verse_number": "४२", "content_sanskrit": "ये पुरा मनुजा देवि स्वदारेष्वनपेक्षया ।\nयथेष्टवृत्तयश्चैव निर्लज्जा वीतसम्भ्रमाः\t ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2204177, "chapter_id": 5351, "verse_number": "४३", "content_sanskrit": "परेषां विप्रियकरा वाङ्मनःकायकर्मभिः ।\nनिराश्रया निरन्नाद्याः स्त्रीणां हृदयकोपनाः\t ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2204178, "chapter_id": 5351, "verse_number": "४४", "content_sanskrit": "एवं युक्तसमाचाराः पुनर्जन्मनि ते नराः ।\nदुर्भगास्तु भवन्त्येव स्त्रीणां हृदयविप्रियाः\t ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2204179, "chapter_id": 5351, "verse_number": "४५", "content_sanskrit": "नास्ति तेषां रतिसुखं स्वदारेष्वपि किञ्चन\t ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2204180, "chapter_id": 5351, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे मानुषाणां त्रैविध्यनिमित्तकथनं नाम द्व्यधिकद्विशततमोऽध्यायः ॥२०२॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]