[{"id": 2129593, "chapter_id": 3790, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2129594, "chapter_id": 3790, "verse_number": "१", "content_sanskrit": "एषा मधुविला राजन् समङ्गा सम्प्रकाशते ।\nएतत् कर्दमिलं नाम भरतस्याभिषेचनम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2129595, "chapter_id": 3790, "verse_number": "२", "content_sanskrit": "अलक्ष्म्या किल संयुक्तो वृत्रं हत्वा शचीपतिः ।\nआप्लुतः सर्वपापेभ्यः समङ्गायां व्यमुच्यत\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2129596, "chapter_id": 3790, "verse_number": "३", "content_sanskrit": "एतद् विनशनं कुक्षौ मैनाकस्य नरर्षभ ।\nअदितिर्यत्र पुत्रार्थं तदन्नमपचत् पुरा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2129597, "chapter_id": 3790, "verse_number": "४", "content_sanskrit": "एनं पर्वतराजानमारुह्य भरतर्षभाः ।\nअयशस्यामसंशब्द्यामलक्ष्मीं व्यपनोत्स्यथ ।\nएते कनखला राजन् ऋषीणां दयिता नगाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2129598, "chapter_id": 3790, "verse_number": "५", "content_sanskrit": "एषा प्रकाशते गङ्गा युधिष्ठिर महानदी ।\nसनत्कुमारो भगवानत्र सिद्धिमगात् पुरा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2129599, "chapter_id": 3790, "verse_number": "६", "content_sanskrit": "आजमीढावगाह्यैनां सर्वपापैः प्रमोक्ष्यसे\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2129600, "chapter_id": 3790, "verse_number": "७", "content_sanskrit": "अपां ह्रदं च पुण्याख्यं भृगुतुङ्गं च पर्वतम् ।\nउष्णीगङ्गे च कौन्तेय सामात्यः समुपस्पृश\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2129601, "chapter_id": 3790, "verse_number": "८", "content_sanskrit": "आश्रमः स्थूलशिरसो रमणीयः प्रकाशते ।\nअत्र मानं च कौन्तेय क्रोधं चैव विवर्जय\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2129602, "chapter_id": 3790, "verse_number": "९", "content_sanskrit": "एष रैभ्याश्रमः श्रीमान् पाण्डवेय प्रकाशते ।\nभारद्वाजो यत्र कविर्यवक्रीतो व्यनश्यत\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2129603, "chapter_id": 3790, "verse_number": "", "content_sanskrit": "नानापुष्पसमाकीर्णः फलपुष्पोपशोभितः ।\nनानाविहगसङ्घुष्टस्तापसालय उत्तमः ॥ (अधिकः)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2129604, "chapter_id": 3790, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2129605, "chapter_id": 3790, "verse_number": "१०", "content_sanskrit": "कथं युक्तोऽभवद् ऋषिर्भरद्वाजः प्रतापवान् ।\nकिमर्थं च यवक्रीतः पुत्रोऽनश्यत वै मुनेः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2129606, "chapter_id": 3790, "verse_number": "११", "content_sanskrit": "एतत् सर्वं यथावृत्तं श्रोतुमिच्छामि तत्त्वतः ।\nकर्मभिर्देवकल्पानां कीर्त्यमानैर्भृशं रमे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2129607, "chapter_id": 3790, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2129608, "chapter_id": 3790, "verse_number": "१२", "content_sanskrit": "भरद्वाजश्च रैभ्यश्च सखायौ सम्बभूवतुः ।\nतावूषतुरिहात्यन्तं प्रीयमाणावनन्तरम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2129609, "chapter_id": 3790, "verse_number": "१३", "content_sanskrit": "रैभ्यस्य तु सुतावास्तामर्वावसुपरावसू ।\nआसीद् यवक्रीः पुत्रस्तु भरद्वाजस्य भारत\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2129610, "chapter_id": 3790, "verse_number": "१४", "content_sanskrit": "रैभ्यो विद्वान् सहापत्यस्तपस्वी चेतरोऽभवत् ।\nतयोश्चाप्यतुला प्रीर्तिर्बाल्यात् प्रभृति भारत\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2129611, "chapter_id": 3790, "verse_number": "१५", "content_sanskrit": "यवक्रीः पितरं दृष्ट्वा तपस्विनमसत्कृतम् ।\nदृष्ट्वा च सत्कृतं विप्रै रैभ्यं पुत्रैः सहानघ \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2129612, "chapter_id": 3790, "verse_number": "१६", "content_sanskrit": "पर्यतप्यत तेजस्वी मन्युनाऽभिपरिप्लुतः ।\nतपस्तेपे ततो घोरं वेदज्ञानाय पाण्डव \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2129613, "chapter_id": 3790, "verse_number": "१७", "content_sanskrit": "स समिद्धे महत्यग्नौ शरीरमुपतापयन् ।\nजनयामास सन्तापमिन्द्रस्य सुमहातपाः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2129614, "chapter_id": 3790, "verse_number": "१८", "content_sanskrit": "तत इन्द्रो यवक्रीतमुपगम्य युधिष्ठिर ।\nअब्रवीत् कस्य हेतोस्त्वमास्थितस्तप उत्तमम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2129615, "chapter_id": 3790, "verse_number": "", "content_sanskrit": "यवक्रीतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2129616, "chapter_id": 3790, "verse_number": "१९", "content_sanskrit": "द्विजानामनधीता वै वेदाः सुरगणार्चित ।\nप्रतिभान्त्विति तप्येऽहमिदं परमकं तपः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2129617, "chapter_id": 3790, "verse_number": "२०", "content_sanskrit": "स्वाध्यायार्थं समारम्भो ममायं पाकशासन ।\nतपसा ज्ञातुमिच्छामि सर्वज्ञानानि कौशिक\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2129618, "chapter_id": 3790, "verse_number": "२१", "content_sanskrit": "कालेन महता वेदाः शक्या गुरुमुखाद् विभो ।\nप्राप्तुं तस्मादयं यत्नः परमो मे समास्थितः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2129619, "chapter_id": 3790, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2129620, "chapter_id": 3790, "verse_number": "२२", "content_sanskrit": "अमार्ग एष विप्रर्षे येन त्वं यातुमिच्छसि ।\nकिं विघातेन ते विप्र गच्छाधीहि गुरोर्मुखात्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2129621, "chapter_id": 3790, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2129622, "chapter_id": 3790, "verse_number": "२३", "content_sanskrit": "एवमुक्त्वा गतः शक्रो यवक्रीरपि भारत।\nभूय एवाकरोद् यत्नं तपस्यमितविक्रमः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2129623, "chapter_id": 3790, "verse_number": "२४", "content_sanskrit": "घोरेण तपसा राजंस्तप्यमानो महत्तपः ।\nसन्तापयामास भृशं देवेन्द्रमिति नः श्रुतम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2129624, "chapter_id": 3790, "verse_number": "२५", "content_sanskrit": "तं तथा तप्यमानं तु तपस्तीव्रं महामुनिम् ।\nउपेत्य बलभिद् देवो वारयामास वै पुनः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2129625, "chapter_id": 3790, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2129626, "chapter_id": 3790, "verse_number": "२६", "content_sanskrit": "अशक्योऽर्थः समारब्धो नैतद् बुद्धिकृतं तव ।\nप्रतिभास्यन्ति वै वेदास्तव चैव पितुश्च ते\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2129627, "chapter_id": 3790, "verse_number": "", "content_sanskrit": "यवक्रीतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2129628, "chapter_id": 3790, "verse_number": "२७", "content_sanskrit": "न चैतदेवं क्रियते देवराज ममेप्सितम् ।\nमहता नियमेनाहं तप्स्ये घोरतरं तपः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2129629, "chapter_id": 3790, "verse_number": "२८", "content_sanskrit": "समिद्धेऽग्नावुपकृत्याङ्गमङ्गं होष्यामि वा मघवंस्तन्निबोध ।\nयद्येतदेवं न करोषि कामं ममेप्सितं देवराजेह सर्वम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2129630, "chapter_id": 3790, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2129631, "chapter_id": 3790, "verse_number": "२९", "content_sanskrit": "निश्चयं तमभिज्ञाय मुनेस्तस्य महात्मनः ।\nप्रतिवारणहेत्वर्थं बुद्ध्या सञ्चिन्त्य बुद्धिमान्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2129632, "chapter_id": 3790, "verse_number": "३०", "content_sanskrit": "ततः इन्द्रोऽकरोद् रूपं ब्राह्मणस्य तपस्विनः ।\nअनेकशतवर्षस्य दुर्बलस्य सयक्ष्मणः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2129633, "chapter_id": 3790, "verse_number": "३१", "content_sanskrit": "यवक्रीतस्य यत् तीर्थमुचितं शौचकर्मणि ।\nभागीरथ्यां तत्र सेतुं वालुकाभिश्चकार सः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2129634, "chapter_id": 3790, "verse_number": "३२", "content_sanskrit": "यदाऽस्य वदतो वाक्यं न स चक्रे द्विजोत्तमः ।\nवालुकाभिस्ततः शक्रो गङ्गां समभिपूरयन् ।\nवालुकामुष्टिमनिशं भागीरथ्यां व्यसर्जयत्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2129635, "chapter_id": 3790, "verse_number": "३३", "content_sanskrit": "सेतुमभ्यारभच्छक्रो यवक्रीतं निदर्शयन्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2129636, "chapter_id": 3790, "verse_number": "३४", "content_sanskrit": "तं ददर्श यवक्रीतो यत्नवन्तं निबन्धने ।\nप्रहसंश्चाब्रवीद् वाक्यमिदं स मुनिपुङ्गवः \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2129637, "chapter_id": 3790, "verse_number": "३५", "content_sanskrit": "किमिदं वर्तते ब्रह्मन् किञ्च ते ह चिकीर्षितम् ।\nअतीव हि महान्यत्नः क्रियतेऽयं निरर्थकः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2129638, "chapter_id": 3790, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2129639, "chapter_id": 3790, "verse_number": "३६", "content_sanskrit": "बन्धिष्ये सेतुना गङ्गां सुखः पन्था भविष्यति ।\nक्लिश्यते हि जनस्तात तरमाणः पुनः पुनः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2129640, "chapter_id": 3790, "verse_number": "", "content_sanskrit": "यवक्रीतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2129641, "chapter_id": 3790, "verse_number": "३७", "content_sanskrit": "नायं शक्यस्त्वया बद्धुं महानोघस्तपोधन।\nअशक्याद् विनिवर्तस्व शक्यमर्थं समारभ\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2129642, "chapter_id": 3790, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2129643, "chapter_id": 3790, "verse_number": "३८", "content_sanskrit": "यथैव भवता चेदं तपो वेदाथमुद्यतम् ।\nअशक्यं तद् वदस्माभिरयं भारः समाहितः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2129644, "chapter_id": 3790, "verse_number": "", "content_sanskrit": "यवक्रीतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2129645, "chapter_id": 3790, "verse_number": "३९", "content_sanskrit": "यथा तव निरर्थोऽयमारम्भस्त्रिदशेश्वर ।\nतथा यदि ममापीदं मन्यसे पाकशासन\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2129646, "chapter_id": 3790, "verse_number": "४०", "content_sanskrit": "क्रियतां यद् भवेच्छक्यं त्वया सुरगणेश्वर ।\nवरांश्च मे प्रयच्छान्यान् यैरन्यान् भवितास्म्यति\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2129647, "chapter_id": 3790, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2129648, "chapter_id": 3790, "verse_number": "४१", "content_sanskrit": "तस्मै प्रादाद् वरानिन्द्र उक्तवान् यान् महातपाः ।\nप्रतिभास्यन्ति ते वेदाः पित्रा सह यथेप्सिताः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2129649, "chapter_id": 3790, "verse_number": "४२", "content_sanskrit": "यच्चान्यत् काङ्क्षसे कामं यवक्रीर्गम्यतामिति ।\nस लब्धकामः पितरं समेत्याथेदमब्रवीत्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2129650, "chapter_id": 3790, "verse_number": "", "content_sanskrit": "यवक्रीतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2129651, "chapter_id": 3790, "verse_number": "४३", "content_sanskrit": "प्रतिभास्यन्ति वै वेदा मम तातस्य चोभयोः ।\nअति चान्यान् भविष्यावो वरा लब्धास्तदा मया\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2129652, "chapter_id": 3790, "verse_number": "", "content_sanskrit": "भरद्वाजः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2129653, "chapter_id": 3790, "verse_number": "४४", "content_sanskrit": "दर्पस्ते भविता तात वराँल्लब्ध्वा यथेप्सितान् ।\nस दर्पपूर्णः कृपणः क्षिप्रमेव विनङ्क्ष्यसि\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2129654, "chapter_id": 3790, "verse_number": "४५", "content_sanskrit": "अत्राप्युदाहरन्तीमा गाथा देवैरुदाहृताः ।\nमुनिरासीत् पुरा पुत्र बालधिर्नाम वीर्यवान्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2129655, "chapter_id": 3790, "verse_number": "४६", "content_sanskrit": "स पुत्रशोकादुद्विग्नस्तपस्तेपे सुदुष्करम् ।\nभवेन्मम सुतोऽमर्त्य इति तं लब्धवांश्च सः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2129656, "chapter_id": 3790, "verse_number": "४७", "content_sanskrit": "तस्य प्रसादो वै देवैः कृतो न त्वमरैः समः ।\nनामर्त्यो विद्यते मर्त्यो निमित्तायुर्भविष्यति\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2129657, "chapter_id": 3790, "verse_number": "", "content_sanskrit": "बालधिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2129658, "chapter_id": 3790, "verse_number": "४८", "content_sanskrit": "यथेमे पर्वताः शश्वत् तिष्ठन्ति सुरसत्तम ।\nअक्षयास्तन्निमित्तं मे सुतस्यायुर्भविष्यति\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2129659, "chapter_id": 3790, "verse_number": "", "content_sanskrit": "भरद्वाजः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2129660, "chapter_id": 3790, "verse_number": "४९", "content_sanskrit": "तस्य पुत्रस्तदा जज्ञे मेधावी क्रोधनः सदा ।\nस तच्छ्रुत्वाऽकरोद् दर्पमृषींश्चैवावमन्यत\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2129661, "chapter_id": 3790, "verse_number": "५०", "content_sanskrit": "विकुर्वामो मुनीनां च व्यचरत् स महीमिमाम् ।\nआससाद महावीर्यं धनुषाक्षं मनीषिणम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2129662, "chapter_id": 3790, "verse_number": "५१", "content_sanskrit": "तस्यापचक्रे मेधावी तं शशाप स वीर्यवान् ।\nभव भस्मेति चोक्तः स न भस्म समपद्यत\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2129663, "chapter_id": 3790, "verse_number": "५२", "content_sanskrit": "धनुषाक्षस्तु तं दृष्ट्वा मेधाविनमनामयम् ।\nनिमित्तं महिषैरस्य भेदयामास पर्वतान्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2129664, "chapter_id": 3790, "verse_number": "५३", "content_sanskrit": "स निमित्ते विनष्टे तु ममार सहसा शिशुः ।\nतं मृतं पुत्रमादाय विललाप ततः पिता\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2129665, "chapter_id": 3790, "verse_number": "५४", "content_sanskrit": "लालप्यमानं तं दृष्ट्वा मुनयः परमार्तवत् ।\nऊर्चुर्वेदविदः सर्वे गाथां यां तां निबोध मे\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2129666, "chapter_id": 3790, "verse_number": "५५", "content_sanskrit": "न दिष्टमर्थमत्येतुमीशो मर्त्यः कथञ्चन ।\nमहिषैर्भेदयामास धनुषाक्षो महीधरान्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2129667, "chapter_id": 3790, "verse_number": "५६", "content_sanskrit": "एवं लब्ध्वा वरान्बाला दर्पपूर्णास्तपस्विनः ।\nक्षिप्रमेव विनश्यन्ति तथा न स्यात्तथा भवान्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2129668, "chapter_id": 3790, "verse_number": "५७", "content_sanskrit": "एष रैभ्यो महावीर्यः पुत्रौ चास्य तथाविधौ ।\nतं यथा पुत्र नाभ्येषि तथा कुर्यास्त्वतन्द्रितः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2129669, "chapter_id": 3790, "verse_number": "५८", "content_sanskrit": "स हि क्रुद्धः समर्थश्च(स्त्वां) पुत्र पीडयितुं रुषा ।\nरैभ्यश्चापि तपस्वी च कोपनश्च महानृषिः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2129670, "chapter_id": 3790, "verse_number": "", "content_sanskrit": "यवक्रीतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2129671, "chapter_id": 3790, "verse_number": "५९", "content_sanskrit": "एवं करिष्ये मा तापं तात कार्षीः कथञ्चन ।\nयथा हि मे भवान् मान्यस्तथा रैभ्यः पिता मम\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2129672, "chapter_id": 3790, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2129673, "chapter_id": 3790, "verse_number": "६०", "content_sanskrit": "उक्त्वा स पितरं श्लक्ष्णं यवक्रीरकुतोभयः ।\nविप्रकुर्वन् ऋषीनन्यानतुष्यत् परया मुदा \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2129674, "chapter_id": 3790, "verse_number": "१३२", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि द्वात्रिंशदधिकशततमोऽध्यायः ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2129675, "chapter_id": 3790, "verse_number": "८८", "content_sanskrit": "॥ इति तीर्थयात्रापर्वणि अष्टाशीतितमोऽध्यायः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}]