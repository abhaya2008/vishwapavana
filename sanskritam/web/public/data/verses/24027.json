[{"id": 7004027000, "chapter_id": 24027, "verse_number": "३-२-३८-१", "content_sanskrit": "व्यास उवाच ।\nततः प्रभाते विमले कृतपूर्वाह्निकक्रियाः ।\nशुभवस्त्रपरीधानाः फल हस्ताः पृथक्पृथक्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004027001, "chapter_id": 24027, "verse_number": "३-२-३८-२", "content_sanskrit": "रत्नांगदाढ्यदोर्दंडा अंगुलीयकभूषिताः ।\nकर्णाभरणसंयुक्ताः समाजग्मुः प्रहर्षिताः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004027002, "chapter_id": 24027, "verse_number": "३-२-३८-३", "content_sanskrit": "राजद्वारं तु संप्राप्य संत स्थुर्ब्रह्मवादिनः ।\nतान्दृष्ट्वा राजपुत्रस्तु ईषत्प्रहसितो बली॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004027003, "chapter_id": 24027, "verse_number": "३-२-३८-४", "content_sanskrit": "रामं च हनुमंतं च गत्वा विप्राः समागताः ।\nश्रूयतां मंत्रिणः सर्वे दृश्यंतो द्विज सत्तमान्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004027004, "chapter_id": 24027, "verse_number": "३-२-३८-५", "content_sanskrit": "एतदुक्त्वा तु वचनं तूष्णीं भूत्वा स्थितो नृपः ।\nततो द्वित्रा द्विजाः सर्वे उपविष्टाः क्रमात्ततः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004027005, "chapter_id": 24027, "verse_number": "३-२-३८-६", "content_sanskrit": "क्षेमं पप्रच्छुर्नृपतिं हस्तिरथपदातिषु ।\nततः प्रोवाच नृपतिर्विप्रान्प्रति महामनाः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004027006, "chapter_id": 24027, "verse_number": "३-२-३८-७", "content_sanskrit": "अरिहंतप्रसादेन सर्वत्र कुशलं मम ।\nसा जिह्वा या जिनं स्तौ ति तौ करौ यौ जिनार्चनौ॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004027007, "chapter_id": 24027, "verse_number": "३-२-३८-८", "content_sanskrit": "सा दृष्टिर्या जिने लीना तन्मनो यज्जिने रतम् ।\nदया सर्वत्र कर्तव्या जीवात्मा पूज्यते सदा॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004027008, "chapter_id": 24027, "verse_number": "३-२-३८-९", "content_sanskrit": "योगशाला हि गंतव्या कर्त्तव्यं गुरुवंदनम् ।\nन चकारं महामंत्रं जपितव्यमहर्निशम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004027009, "chapter_id": 24027, "verse_number": "३-२-३८-१०", "content_sanskrit": "पंचूषणं हि कर्त्तव्यं दातव्यं श्रमणे सदा ।\nश्रुत्वा वाक्यं ततो विप्रास्तस्य दंतानपीडयन्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004027010, "chapter_id": 24027, "verse_number": "३-२-३८-११", "content_sanskrit": "विमुच्य दीर्घनिश्वासमूचुस्ते नृपतिं प्रति ।\nरामेण कथितं राजन्धीमता च हनूमता॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004027011, "chapter_id": 24027, "verse_number": "३-२-३८-१२", "content_sanskrit": "दीयतां विप्रवृत्तिं च धर्मिष्ठोऽसि धरातले ।\nज्ञायते तव द्दत्ता स्यान्मदत्ता नैव नैव च॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004027012, "chapter_id": 24027, "verse_number": "३-२-३८-१३", "content_sanskrit": "रक्षस्व रामवाक्यं त्वं यत्कृत्वा त्वं सुखी भव॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004027013, "chapter_id": 24027, "verse_number": "३-२-३८-१४", "content_sanskrit": "राजोवाच ।\nयत्र रामहनूमंतौ यांतु सर्वेऽपि तत्र वै ।\nरामो दास्यति सर्वस्वं किं प्राप्ता इह वै द्विजाः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004027014, "chapter_id": 24027, "verse_number": "३-२-३८-१५", "content_sanskrit": "न दास्यामि न दास्यामि एकां चैव वराटिकाम् ।\nन ग्रामं नैव वृत्तिं च गच्छध्वं यत्र रोचते॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004027015, "chapter_id": 24027, "verse_number": "३-२-३८-१६", "content_sanskrit": "तच्छ्रुत्वा दारुणं वाक्यं द्विजाः कोपाकुलास्तदा ।\nसहस्व रामकोपं हि साम्प्रतञ्च हनूमतः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004027016, "chapter_id": 24027, "verse_number": "३-२-३८-१७", "content_sanskrit": "इत्युक्त्वा हनुमद्दत्ता वामकक्षोद्भवा पुटी ।\nप्रक्षिप्ता चास्य निलये व्यावृत्ता द्विजसत्तमाः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004027017, "chapter_id": 24027, "verse_number": "३-२-३८-१८", "content_sanskrit": "गते तदा विप्रसंघे ज्वालामालाकुलं त्वभूत् ।\nअग्निज्वालाकुलं सर्वं संजातं चैव तत्र हि॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004027018, "chapter_id": 24027, "verse_number": "३-२-३८-१९", "content_sanskrit": "दह्यंते राजवस्तूनिच्छत्राणि चामराणि च ।\nकोशागाराणि सर्वाणि आयुधागारमेव च॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004027019, "chapter_id": 24027, "verse_number": "३-२-३८-२०", "content_sanskrit": "महिष्यो राजपुत्राश्च गजा अश्वा ह्यनेकशः ।\nविमानानि च दह्यंते दह्यंते वाहनानि च॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004027020, "chapter_id": 24027, "verse_number": "३-२-३८-२१", "content_sanskrit": "शिबिकाश्च विचित्रा वै रथाश्चैव सहस्रशः ।\nसर्वत्र दह्यमानं च दृष्ट्वा राजापि विव्यथे॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004027021, "chapter_id": 24027, "verse_number": "३-२-३८-२२", "content_sanskrit": "न कोपि त्राता तस्यास्ति मानवा भयविक्लवाः ।\nन मंत्रयंत्रैर्वह्निः स साध्यते न च मूलिकैः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004027022, "chapter_id": 24027, "verse_number": "३-२-३८-२३", "content_sanskrit": "कौटिल्यकोटिनाशी च यत्र रामः प्रकुप्यते ।\nतत्र सर्वे प्रणश्यंति किं तत्कुमारपालकः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004027023, "chapter_id": 24027, "verse_number": "३-२-३८-२४", "content_sanskrit": "सर्वं तज्जवलितं दृष्ट्वा नग्नक्षपणकास्तदा ।\nधृत्वा करेण पात्राणि नीत्वा दंडाञ्छुभानपि॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004027024, "chapter_id": 24027, "verse_number": "३-२-३८-२५", "content_sanskrit": "रक्तकंबलिका गृह्य वेपमाना मुहुर्मुहुः ।\nअनुपानहिकाश्चैव नष्टाः सर्वे दिशो दश॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004027025, "chapter_id": 24027, "verse_number": "३-२-३८-२६", "content_sanskrit": "कोलाहलं प्रकुर्वाणाः पलायध्वमिति ब्रुवन् ।\nदाहिता विप्रमुख्यैश्च वयं सर्वे न संशयः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004027026, "chapter_id": 24027, "verse_number": "३-२-३८-२७", "content_sanskrit": "केचिच्च भग्नपात्रास्ते भग्नदं ण्डास्तथापरे ।\nप्रनष्टाश्च विवस्त्रास्ते वीतरागमिति ब्रुवन्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004027027, "chapter_id": 24027, "verse_number": "३-२-३८-२८", "content_sanskrit": "अर्हतमेव केचिच्च पलायनपरायणाः ।\nततो वायुः समभवद्वह्निमांदोलयन्निव॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004027028, "chapter_id": 24027, "verse_number": "३-२-३८-२९", "content_sanskrit": "प्रेषितो वै हनुमता विप्राणां प्रियकाम्यया ।\nधावन्स नृपतिः पश्चादितश्चेतश्च वै तदा॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004027029, "chapter_id": 24027, "verse_number": "३-२-३८-३०", "content_sanskrit": "पदातिरेकः प्ररुदन्क्व विप्रा इति जल्पकः ।\nलोकाच्छ्रुत्वा ततो राजा गतस्तत्र यतो द्विजाः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004027030, "chapter_id": 24027, "verse_number": "३-२-३८-३१", "content_sanskrit": "गत्वा तु सहसा राजन्गृहीत्वा चरणौ तदा ।\nविप्राणां नृपतिर्भूमौ मूर्च्छितो न्यपत त्तदा॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004027031, "chapter_id": 24027, "verse_number": "३-२-३८-३२", "content_sanskrit": "उवाच वचनं राजा विप्रान्विनयतत्परः ।\nजपन्दाशरथिं रामं रामरामेति वै पुनः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004027032, "chapter_id": 24027, "verse_number": "३-२-३८-३३", "content_sanskrit": "तस्य दासस्य दासोहं रामस्य च द्विज स्य च ।\nअज्ञानतिमिरांधेन जातोस्म्यंधो हि संप्रति॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004027033, "chapter_id": 24027, "verse_number": "३-२-३८-३४", "content_sanskrit": "अंजनं च मया लब्धं रामनाममहौषधम् ।\nरामं मुक्त्वा हि ये मर्त्या ह्यन्यं देव मुपासते ।\nदह्यंते तेऽग्निना स्वामिन्यथाहं मूढचेतनः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004027034, "chapter_id": 24027, "verse_number": "३-२-३८-३५", "content_sanskrit": "हरिर्भागीरथी विप्रा विप्रा भागीरथी हरिः ।\nभागीरथी हरिर्विप्राः सारमेकं जगत्त्रये॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004027035, "chapter_id": 24027, "verse_number": "३-२-३८-३६", "content_sanskrit": "स्वर्गस्य चैत्र सोपानं विप्रा भागीरथी हरिः ।\nरामनाममहारज्ज्वा वैकुंठे येन नीयते॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004027036, "chapter_id": 24027, "verse_number": "३-२-३८-३७", "content_sanskrit": "इत्येवं प्रणमन्राजा प्रांजलिर्वाक्यमब्रवीत् ।\nवह्निः प्रशाम्यतां विप्राः शासनं वो ददाम्यहम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004027037, "chapter_id": 24027, "verse_number": "३-२-३८-३८", "content_sanskrit": "दासोऽस्मि सांप्रतं विप्रा न मे वागन्यथा भवेत् ।\nयत्पापं ब्रह्महत्यायाः पर दाराभिगामिनाम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004027038, "chapter_id": 24027, "verse_number": "३-२-३८-३९", "content_sanskrit": "यत्पापं मद्यपानां च सुवर्णस्तेयिनां तथा ।\nयत्पापं गुरुघातानां तत्पापं वा भवेन्मम॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004027039, "chapter_id": 24027, "verse_number": "३-२-३८-४०", "content_sanskrit": "यंयं चिंतयते कामं तं तं दास्याम्यहं पुनः ।\nविप्रभक्तिः सदा कार्या रामभक्तिस्तथैव च॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004027040, "chapter_id": 24027, "verse_number": "३-२-३८-४१", "content_sanskrit": "अन्यथा करणीयं मे न कदाचि द्द्विजोत्तमाः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004027041, "chapter_id": 24027, "verse_number": "३-२-३८-४२", "content_sanskrit": "व्यास उवाच ।\nतस्मिन्नवसरे विप्रा जाता भूप दयालवः ।\nअन्या या पुटिका चासीत्सा दत्ता शापशांतये॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004027042, "chapter_id": 24027, "verse_number": "३-२-३८-४३", "content_sanskrit": "जीवितं चैव तत्सैन्यं जातं क्षिप्तेषु रोमसु ।\nदिशः प्रसन्नाः संजाताः शांता दिग्जनितस्वनाः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004027043, "chapter_id": 24027, "verse_number": "३-२-३८-४४", "content_sanskrit": "प्रजा स्वस्था ऽभवत्तत्र हर्षनिर्भरमानसा ।\nअवतस्थे यथापूर्वं पुत्रपौत्रादिकं तथा॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004027044, "chapter_id": 24027, "verse_number": "३-२-३८-४५", "content_sanskrit": "विप्राज्ञाकारिणो लोकाः संजाताश्च यथा पुरा ।\nविष्णुधर्मं परित्यज्य नान्यं जानंति ते वृषम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004027045, "chapter_id": 24027, "verse_number": "३-२-३८-४६", "content_sanskrit": "नवीनं शासनं कृत्वा पूर्ववद्विधिपूर्वकम् ।\nनिष्कासितास्तु पाषंडाः कृतशास्त्रप्रयोजकाः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004027046, "chapter_id": 24027, "verse_number": "३-२-३८-४७", "content_sanskrit": "वेदबाह्याः प्रनष्टास्ते उत्तमाधममध्यमाः ।\nषट्त्रिंशच्च सहस्राणि येऽभूवन्गोभुजाः पुरा॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004027047, "chapter_id": 24027, "verse_number": "३-२-३८-४८", "content_sanskrit": "तेषां मध्यात्तु संजाता अढवीजा वणिग्जनाः ।\nशुश्रूषार्थं ब्राह्मणानां राज्ञा सर्वे निरूपिताः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004027048, "chapter_id": 24027, "verse_number": "३-२-३८-४९", "content_sanskrit": "सदाचाराः सुनिपुणा देवब्राह्मणपूजकाः ।\nत्यक्त्वा पाखण्डमार्गं तु विष्णुभक्तिपरास्तु ते॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004027049, "chapter_id": 24027, "verse_number": "३-२-३८-५०", "content_sanskrit": "जाह्नवीतीरमासाद्य त्रैविद्येभ्यो ददौ नृपः ।\nशासनं तु यदा दत्तं तेषां वै भक्तिपूर्वकम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004027050, "chapter_id": 24027, "verse_number": "३-२-३८-५१", "content_sanskrit": "स्थानधर्मात्प्रचलिता वाडवास्ते समागताः ।\nनृपो विज्ञापितो विप्रैस्तैरेवं क्लेशकारिभिः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004027051, "chapter_id": 24027, "verse_number": "३-२-३८-५२", "content_sanskrit": "ये त्यक्तवाचो विप्रेंद्रास्तान्निःसारय भूपते ।\nपरस्परं विवादास्तु संजाता दत्तवृत्तये॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004027052, "chapter_id": 24027, "verse_number": "३-२-३८-५३", "content_sanskrit": "न्याय प्रदशनार्थं च कारितास्तु सभासदः ।\nहस्ताक्षरेषु दृष्टेषु पृथक्पृथक्प्रपादितम्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004027053, "chapter_id": 24027, "verse_number": "३-२-३८-५४", "content_sanskrit": "एतच्छ्रुत्वा ततो राजा तुलादानं चकार ह ।\nदीयमाने तदा दाने चातुर्विद्या बभाषिरे॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004027054, "chapter_id": 24027, "verse_number": "३-२-३८-५५", "content_sanskrit": "अस्माभिर्हारिता जातिः कथं कुर्मः प्रतिग्रहम् ।\nनिवारितास्तु ते सर्वे स्थानान्मोहेरका द्विजाः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004027055, "chapter_id": 24027, "verse_number": "३-२-३८-५६", "content_sanskrit": "दशपंच सहस्राणि वेदवेदांगपारगाः ।\nततस्तेन तदा राजन्राज्ञा रामानुवर्तिना॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004027056, "chapter_id": 24027, "verse_number": "३-२-३८-५७", "content_sanskrit": "आहूता वाडवांस्तास्तु ज्ञातिभेदं चकार सः ।\nत्रयीविद्या वाडवा ये सेतुबंधं प्रति प्रभुम्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004027057, "chapter_id": 24027, "verse_number": "३-२-३८-५८", "content_sanskrit": "गतास्ते वृत्तिभाजः स्युर्नान्ये वृत्त्यभिभागिनः ।\nतत्र नैव गता ये वै चातुर्विद्यत्वमागताः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004027058, "chapter_id": 24027, "verse_number": "३-२-३८-५९", "content_sanskrit": "वणिग्भिर्न च संबंधो न विवाहश्च तैः सह ।\nग्रामवृत्तौ न संबंधो ज्ञातिभेदे कृते सति॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004027059, "chapter_id": 24027, "verse_number": "३-२-३८-६०", "content_sanskrit": "द्विजभक्तिपराः शूद्राः ये पाखंडैर्न लोपिताः ।\nजैन धर्मात्परावृत्तास्ते गोभूजास्तथोत्तमाः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004027060, "chapter_id": 24027, "verse_number": "३-२-३८-६१", "content_sanskrit": "ये च पाखंडनिरता रामशासनलोपकाः ।\nसर्वे विप्रास्तथा शूद्रा प्रतिबंधेन योजिताः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004027061, "chapter_id": 24027, "verse_number": "३-२-३८-६२", "content_sanskrit": "सत्यप्रतिज्ञां कुर्वाणास्तत्रस्थाः सुखिनोऽभवन् ।\nचातुर्विद्या बहिर्ग्रामे राज्ञा तेन निवासिताः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004027062, "chapter_id": 24027, "verse_number": "३-२-३८-६३", "content_sanskrit": "यथा रामो न कुप्येत तथा कार्यं मया ध्रुवम ।\nपराङ्मुखा ये रामस्य सन्मुखानुगताः किल॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004027063, "chapter_id": 24027, "verse_number": "३-२-३८-६४", "content_sanskrit": "चातुर्विद्यास्ते विज्ञेया वृत्तिबाह्याः कृतास्तदा ।\nकृतकृत्यस्तदा जातो राजा कुमारपालकः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004027064, "chapter_id": 24027, "verse_number": "३-२-३८-६५", "content_sanskrit": "विप्राणां पुरतः प्राह प्रश्रयेण वचस्तदा ।\nग्रामवृत्तिर्न मे लुप्ता एतद्वै देवनिर्मितम्॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004027065, "chapter_id": 24027, "verse_number": "३-२-३८-६६", "content_sanskrit": "स्वयं कृतापराधानां दोषो कस्य न दीयते ।\nयथा वने काष्ठवर्षाद्वह्निः स्याद्दैवयोगतः॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004027066, "chapter_id": 24027, "verse_number": "३-२-३८-६७", "content_sanskrit": "भवद्भिस्तु पणः प्रोक्तो ह्यभिज्ञानस्य हेतवे ।\nरामस्य शासनं कृत्वा वायुपुत्रस्य हेतवे॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004027067, "chapter_id": 24027, "verse_number": "३-२-३८-६८", "content_sanskrit": "व्यावृत्ता वाडवा यूयं स दोषः कस्य दीयते ।\nअवसाने हरिं स्मृत्वा महापापयुतोऽपि वा॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004027068, "chapter_id": 24027, "verse_number": "३-२-३८-६९", "content_sanskrit": "विष्णुलोकं व्रजत्याशु संशयस्तु कथं भवेत् ।\nमहत्पुण्योदये नॄणां बुद्धिः श्रेयसि जायते॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004027069, "chapter_id": 24027, "verse_number": "३-२-३८-७०", "content_sanskrit": "पापस्योदयकाले च विपरीता हि सा भवेत् ।\nसकृत्पालयते यस्तु धर्मेणैतज्जगत्त्रयम्॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004027070, "chapter_id": 24027, "verse_number": "३-२-३८-७१", "content_sanskrit": "योंतरात्मा च भूतानां संशयस्तत्र नो हितः ।\nइंद्रादयोऽमराः सर्वे सनकाद्यास्तपोधनाः॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004027071, "chapter_id": 24027, "verse_number": "३-२-३८-७२", "content_sanskrit": "मुक्त्यर्थमर्चयंतीह संशयस्तत्र नो हितः ।\nसहस्रनाम तत्तुल्यं रामनामेति गीयते॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004027072, "chapter_id": 24027, "verse_number": "३-२-३८-७३", "content_sanskrit": "तस्मिन्ननिश्चयं कृत्वा कथं सिद्धिर्भवेदिह ।\nमम जन्मकृतात्पुण्यादभिज्ञानं ददौ हरिः॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004027073, "chapter_id": 24027, "verse_number": "३-२-३८-७४", "content_sanskrit": "पाखंडाद्यत्कृतं पापं मृष्टं तद्वः प्रणामतः ।\nप्रसीदंतु भवंतश्च त्यक्त्वा क्रोधं ममाधुना॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004027074, "chapter_id": 24027, "verse_number": "३-२-३८-७५", "content_sanskrit": "ब्राह्मणा ऊचुः ।\nराजन्धर्मो विलुप्तस्ते प्रापितानां तथा पुनः ।\nअवश्यं भाविनो भावा भवंति महतामपि॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004027075, "chapter_id": 24027, "verse_number": "३-२-३८-७६", "content_sanskrit": "नग्नत्वं नीलकण्ठस्य महाहिशयनं हरेः ।\nएतद्दैवकृतं सर्वं प्रभुर्यः सुखदुःखयोः॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004027076, "chapter_id": 24027, "verse_number": "३-२-३८-७७", "content_sanskrit": "सत्यप्रतिज्ञास्त्रैविद्या भजंतु रामशासनम् ।\nअस्माकं तु परं देहि स्थानं यत्र वसामहे॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004027077, "chapter_id": 24027, "verse_number": "३-२-३८-७८", "content_sanskrit": "तेषां तु वचनं श्रुत्वा सुखमिच्छुर्द्विजन्मनाम् ।\nतेषां स्थानं तु दत्तं वै सुखवासं तु नामतः॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004027078, "chapter_id": 24027, "verse_number": "३-२-३८-७९", "content_sanskrit": "हिरण्यं पुष्पवासांसि गावः कामदुघा नृप ।\nस्वर्णालंकरणं सर्वं नानावस्तुचयं तथा॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004027079, "chapter_id": 24027, "verse_number": "३-२-३८-८०", "content_sanskrit": "श्रद्धया परया दत्त्वा मुदं लेभे नराधिपः ।\nत्रयीविद्यास्तु ते ज्ञेयाः स्थापिता ये त्रिमूर्तिभिः॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004027080, "chapter_id": 24027, "verse_number": "३-२-३८-८१", "content_sanskrit": "चतुर्थेनैव भूपेन स्थापिताः सुखवासने ।\nते बभूबुर्द्विजश्रेष्ठाश्चातुर्विद्याः कलौ युगे॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004027081, "chapter_id": 24027, "verse_number": "३-२-३८-८२", "content_sanskrit": "चातुर्विद्याश्च ते सर्वे धर्मारण्ये प्रतिष्ठिताः ।\nवेदोक्ता आशिषो दत्त्वा तस्मै राज्ञे महात्मने॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004027082, "chapter_id": 24027, "verse_number": "३-२-३८-८३", "content_sanskrit": "रथैरश्वैरुह्यमानाः कृतकृत्या द्विजातयः ।\nमहत्प्रमोदयुक्तास्ते प्रापुर्मोहेरकं महत्॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004027083, "chapter_id": 24027, "verse_number": "३-२-३८-८४", "content_sanskrit": "पौषशुक्लत्रयोदश्यां लब्धं शासनकं द्विजैः ।\nबलिप्रदानं तु कृतमुद्दिश्य कुलदेवताम्॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004027084, "chapter_id": 24027, "verse_number": "३-२-३८-८५", "content_sanskrit": "वर्षेवर्षे प्रकर्त्तव्यं बलिदानं यथाविधि ।\nकार्यं च मंगलस्नानं पुरुषेण महात्मना॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004027085, "chapter_id": 24027, "verse_number": "३-२-३८-८६", "content_sanskrit": "गीतं नृत्यं तथा वाद्यं कुर्वीत तद्दिने धुवम् ।\nतन्मासे तद्दिने नैव वृत्तिनाशो भवेद्यथा॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004027086, "chapter_id": 24027, "verse_number": "३-२-३८-८७", "content_sanskrit": "दैवादतीतकाले चेत्वृद्धिरापद्यते यदा ।\nतदा प्रथमतः कृत्वा पश्चाद्वृद्धिर्विधीयते॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004027087, "chapter_id": 24027, "verse_number": "३-२-३८-८८", "content_sanskrit": "ये च भिन्नप्रपाप्रायास्त्रैविद्या मोढवंशजाः ।\nतथा चातुर्वेदिनश्च कुर्वंति गोत्रपूजनम्॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004027088, "chapter_id": 24027, "verse_number": "३-२-३८-८९", "content_sanskrit": "वर्षमध्ये प्रकुर्वीत तथा सुप्ते जनार्द्दने ।\nपौषे च लुप्तं कृत्वा च श्रौतं स्मार्त्तं करोति यः॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004027089, "chapter_id": 24027, "verse_number": "३-२-३८-९०", "content_sanskrit": "तत्र क्रोधसमाविष्टा निघ्नंति कुलदेवताः ।\nविवाहोत्सवकाले च मौंजीबंधादिकर्मणि॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004027090, "chapter_id": 24027, "verse_number": "३-२-३८-९१", "content_sanskrit": "मुहूर्तं गणनाथस्य ततः प्रभृति शोभनम्॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004027091, "chapter_id": 24027, "verse_number": "३-२-३८-९२", "content_sanskrit": "निर्वासितास्तु ये विप्रा आमराज्ञा स्वशासनात् ।\nपंचदशसहस्राणि ययुस्ते सुखवासकन्॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004027092, "chapter_id": 24027, "verse_number": "३-२-३८-९३", "content_sanskrit": "पंचपञ्चाशतो ग्रामान्ददौ रामः पुरा स्वयम् ।\nतत्रस्था वणिजश्चैव तेषां वृत्तिमकल्पयन्॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004027093, "chapter_id": 24027, "verse_number": "३-२-३८-९४", "content_sanskrit": "अडालजा माण्डलीया गोभूजाश्च पवित्रकाः ।\nब्राह्मणानां वृत्तिदास्ते ब्रह्मसेवासु तत्पराः॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}]