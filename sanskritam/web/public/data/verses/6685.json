[
  {
    "id": 20011665,
    "chapter_id": 6685,
    "verse_number": "13.1",
    "content_sanskrit": "अथाऽस्मरत्सुभद्राया निद्रां नाभ्रच्च फल्गुनः । अच्युतस्तदवागच्छददित्सत्तां च जिष्णवे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20011666,
    "chapter_id": 6685,
    "verse_number": "13.2",
    "content_sanskrit": "अनयत्तां निजावासं सात्यकिः कृष्णशासनात् । अपश्यच्चेङ्गिताकारान् सुभद्राप्रेमशंसिनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20011667,
    "chapter_id": 6685,
    "verse_number": "13.3",
    "content_sanskrit": "सोऽग्लायत् भृशमम्लायत् पर्यङ्के पर्यवर्तत । अवेपताऽखिलैरङ्गैर्जृम्भत मुहुर्निशि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20011668,
    "chapter_id": 6685,
    "verse_number": "13.4",
    "content_sanskrit": "समैधताऽस्य निश्वासस्सन्तापस्समवर्धत । नादत्स्वादृष्टमप्यन्नमहन्निन्दुस्तमंशुभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20011669,
    "chapter_id": 6685,
    "verse_number": "13.5",
    "content_sanskrit": "अद्वेडिन्दुं सुभद्रायास्सोऽलीढ मनसा मुखम् । अधेगिव तदस्याऽङ्गं कान्तिपीयूषधारया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20011670,
    "chapter_id": 6685,
    "verse_number": "13.6",
    "content_sanskrit": "सन्तापहेतुमाचष्ट पृष्टस्सात्यकयेऽथ सः । अजागर्भक्तिमान् सोऽस्य स्मररोगचिकित्सकः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20011671,
    "chapter_id": 6685,
    "verse_number": "13.7",
    "content_sanskrit": "प्रास्तौद् गुणान् सुभद्रायास्तच्चित्ताह्लादकारिणः । मुक्तामृणालपद्मादि तस्य तप्ते वपुष्यरात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20011672,
    "chapter_id": 6685,
    "verse_number": "13.8",
    "content_sanskrit": "देहं चन्दनपङ्केन प्रौर्णोदविरलेन च । हर्तुं न स्मरसन्तापमन्दप्यैष्टविशृङ्खलः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20011673,
    "chapter_id": 6685,
    "verse_number": "13.9",
    "content_sanskrit": "अनिंस्त स क्षणं पद्मं मत्वेव प्रेयसीमुखम् । प्रायेणाऽपगतभ्रान्तिस्सन्तप्तोव्यजहात् पुनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20011674,
    "chapter_id": 6685,
    "verse_number": "13.10",
    "content_sanskrit": "इन्दुकान्तं तदाऽनन्दत् सुन्दरीमुखमेव सः । चन्द्रिकाविसरस्पर्धिमन्दहासं न तूपलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20011675,
    "chapter_id": 6685,
    "verse_number": "13.11",
    "content_sanskrit": "उदैरताऽस्य रोमाञ्चा दयितां दधतो हृदि । आनन्दादुल्लसद्बिन्दुस्वेदांबूद्जिहीत च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20011676,
    "chapter_id": 6685,
    "verse_number": "13.12",
    "content_sanskrit": "अविध्यदिषुभिः कामस्सुभद्रामपि पार्थवत् । अशुष्यत्साऽप्यतृष्यच्च तत्राऽऽसक्तेन चेतसा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20011677,
    "chapter_id": 6685,
    "verse_number": "13.13",
    "content_sanskrit": "तदङ्गयष्टावक्षिप्यन्नङ्गना रुक्मिणीगिरा । चन्दनाविलवारीणि तथाऽऽस्यन्मौक्तिकावलिम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20011678,
    "chapter_id": 6685,
    "verse_number": "13.14",
    "content_sanskrit": "सखीजनार्पितैस्तस्याश्शरीरैश्शीतवस्तुभिः । समदीप्यत कन्दर्पो हुताशन इवेन्धनैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20011679,
    "chapter_id": 6685,
    "verse_number": "13.15",
    "content_sanskrit": "मुखेन्दुमुदुनोत्तस्याश्चन्द्रार्कश्चन्द्रिकातपैः । उत्तरीयपयोदेन सख्यस्तं समवृण्वत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20011680,
    "chapter_id": 6685,
    "verse_number": "13.16",
    "content_sanskrit": "अचिन्वन्मौक्तिकैस्सख्यो लतागृहमहीतलम् । अस्तृण्वंस्तत्र शय्याञ्च हरिचन्दनपल्लवैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20011681,
    "chapter_id": 6685,
    "verse_number": "13.17",
    "content_sanskrit": "चन्द्रकान्तशिलापृष्ठे हरिचन्दनपल्लवान् । असुन्वन् बहुलं सख्यः प्रासिञ्चंस्ताश्च तद्रसैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20011682,
    "chapter_id": 6685,
    "verse_number": "13.18",
    "content_sanskrit": "अङ्गानि तस्याश्चाऽसिन्वन् प्रत्यग्रबिसवल्लिभिः । कदलीदलवातांश्च प्राहिण्वंस्तेषु शीतलान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20011683,
    "chapter_id": 6685,
    "verse_number": "13.19",
    "content_sanskrit": "निसर्गशीतलैरेतैरित्थं तामजुषन्त ताः । समाश्नुत महाधीरस्मरतापस्तथापि ताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20011684,
    "chapter_id": 6685,
    "verse_number": "13.20",
    "content_sanskrit": "मनसाऽपीयत प्राज्यं प्रियरूपमहौषधम् । मारेण दह्यमानाऽपि प्रालीयत न तेन सा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20011685,
    "chapter_id": 6685,
    "verse_number": "13.21",
    "content_sanskrit": "का ते रुगित्यपृच्छन्तां भद्राख्याऽथ प्रिया सखी । शिरोरोगो ज्वरश्चेति ह्रीता साऽदिशदुत्तरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20011686,
    "chapter_id": 6685,
    "verse_number": "13.22",
    "content_sanskrit": "स्मरार्त्या सीदतोरीत्थं सुभद्रासव्यसाचिनोः । कल्पायमाना साव्यौच्छत् कथं कथमपि क्षपाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20011687,
    "chapter_id": 6685,
    "verse_number": "13.23",
    "content_sanskrit": "अरुणद्धानुभिर्भानुर्भानामिन्दोश्च मण्डलम् । अरिणत्प्राणिनां निद्रामक्षुणत्तिमिराणि च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20011688,
    "chapter_id": 6685,
    "verse_number": "13.24",
    "content_sanskrit": "माधवस्य प्रबोधाय सूताः प्रायुञ्जत स्तुतीः । तस्याऽतन्वन् हृदि प्रीतिं गीतैरतिमनोहरैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20011689,
    "chapter_id": 6685,
    "verse_number": "13.25",
    "content_sanskrit": "अकरोत्सर्वकर्माणि कृतकृत्योऽपि केशवः । कर्म कर्तव्यमर्त्येभ्यः पुरुषानिति बोधयन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20011690,
    "chapter_id": 6685,
    "verse_number": "13.26",
    "content_sanskrit": "अक्षणोद्दीक्षितः पापं मङ्गलञ्चाऽसनोद्धरिः । शरीरिणामशेषाणां वन्दारूणां प्रगेतराम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20011691,
    "chapter_id": 6685,
    "verse_number": "13.27",
    "content_sanskrit": "श्रितानामापदोऽमुष्णादन्वगृह्णीत तानपि । दिशन् मनोरथान् सर्वानच्युतो भक्तवत्सलः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20011692,
    "chapter_id": 6685,
    "verse_number": "13.28",
    "content_sanskrit": "अथ भद्रा सुभद्रायाः स्मरज्वरमवर्णयत् । रुक्मिण्यै सा च कृष्णाय तस्मै जिष्णोश्च सात्यकिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20011693,
    "chapter_id": 6685,
    "verse_number": "13.29",
    "content_sanskrit": "तयोस्समागमोपायं ततोऽमृगयताच्युतः । अपश्यच्चेन्द्रसूनुञ्च विवर्णं कृशमैक्षत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20011694,
    "chapter_id": 6685,
    "verse_number": "13.30",
    "content_sanskrit": "हाऽवदश्च विविक्ते तं शौरिरुन्मूलयन् शुचम् । विस्रम्भयन्मनस्तस्य सौहार्दं च प्रकाशयन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20011695,
    "chapter_id": 6685,
    "verse_number": "13.31",
    "content_sanskrit": "कौन्तेय रात्रौ वृत्तं ते युयुधानाच्छुतं मया । पृष्टात् कथयतो रात्रौ पार्थः किमकरोदिति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20011696,
    "chapter_id": 6685,
    "verse_number": "13.32",
    "content_sanskrit": "नाऽभुङ्क्त नाऽस्त नाऽशेत नाऽहसन्नाऽवदत् कथाः । श्वेताश्वो निशि दीर्घोष्णं मुहुश्च न्यश्वसीदिति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20011697,
    "chapter_id": 6685,
    "verse_number": "13.33",
    "content_sanskrit": "काऽपि नूनमिहत्या ते हृदयं प्रमदाऽहरत् । इयत्येवाऽन्यथा काले विकारस्तव नोचितः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20011698,
    "chapter_id": 6685,
    "verse_number": "13.34",
    "content_sanskrit": "सा त्वया कथनीया मे याऽऽकर्षद्धृदयन्तव । पतितोरसि मारार्ता वेदितव्या च सा त्वया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20011699,
    "chapter_id": 6685,
    "verse_number": "13.35",
    "content_sanskrit": "मा स्म मे निह्नुथा भावमात्मा सन्नात्मने सते । क्व सौहार्दं क्व च व्रीला जनमेवंविधं प्रति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20011700,
    "chapter_id": 6685,
    "verse_number": "13.36",
    "content_sanskrit": "पुरा पुराणौ नन्वावां नरनारायणावृषी । रमणीये तपस्यावस्तस्मिन् बदरिकाश्रमे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20011701,
    "chapter_id": 6685,
    "verse_number": "13.37",
    "content_sanskrit": "इदं त्वया सखे ज्ञातं तत्र भूमिगतौ भुजैः । दीर्घैरगृह्णीवोत्तुङ्गबदर्यग्रात् फलानि यत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20011702,
    "chapter_id": 6685,
    "verse_number": "13.38",
    "content_sanskrit": "स्मृतं त्वया सखे तद्यत् बदरण्युदचिन्वहि । पीयूषरसनिष्यन्दस्वादीयांस्खाद्य तानि यत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20011703,
    "chapter_id": 6685,
    "verse_number": "13.39",
    "content_sanskrit": "स्मृतं यदविशावाऽऽवां देवासुररणाङ्गणम् । न्यपातयाव तत्राऽरीन् काण्डखण्डितकन्धरान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20011704,
    "chapter_id": 6685,
    "verse_number": "13.40",
    "content_sanskrit": "कृतार्थावपि तावावां सार्वौ हर्तुं भुवो भरम् । अनार्यान् पातुमार्यांश्च स्वेच्छयाऽवात्तराव गाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20011705,
    "chapter_id": 6685,
    "verse_number": "13.41",
    "content_sanskrit": "इति नारायणेनोक्ता गिरः श्रुतवता तदा । नरेणाऽस्मर्यत स्वस्य वचनञ्चेदमौच्यत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20011706,
    "chapter_id": 6685,
    "verse_number": "13.42",
    "content_sanskrit": "तदाऽर्जुनमुखाम्भोजे दशनद्युतिहारिणी । हरिणाऽदृश्यताऽशेषविशदा शब्ददेवता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20011707,
    "chapter_id": 6685,
    "verse_number": "13.43",
    "content_sanskrit": "आत्मा तव जगत्सर्वमहमेव न केवलम् । आदिमध्यान्तशून्यस्य विभोर्मायाविनो 'हरे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20011708,
    "chapter_id": 6685,
    "verse_number": "13.44",
    "content_sanskrit": "सखापि ते पुराणोऽहं मायया प्रावृतस्त्वया । पुरस्तादस्मरन्न त्वां स्मृतवांस्त्वद्य बोधितः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20011709,
    "chapter_id": 6685,
    "verse_number": "13.45",
    "content_sanskrit": "त्वयि प्रसन्ने कृष्णोह मम सिद्धा मनोरथाः । विजृम्भिते नवाम्भोदे नाऽकृतार्थो हि चातकः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20011710,
    "chapter_id": 6685,
    "verse_number": "13.46",
    "content_sanskrit": "ह्यो दृष्टा मेऽहरच्चित्तं सुभद्रा भगिनी तव । अदन्दह्यत कन्दर्पो मां तदादि शराग्निभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20011711,
    "chapter_id": 6685,
    "verse_number": "13.47",
    "content_sanskrit": "इति प्रणयिनं स्निग्धो वदन्तं पार्थचातकम् । गिरा गम्भीरयाऽधिन्वन्नवदत्कृष्णवारिदः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20011712,
    "chapter_id": 6685,
    "verse_number": "13.48",
    "content_sanskrit": "दिष्ट्या तव सुभद्रायां सुभद्रायास्तथा त्वयि । इदं परस्परप्रेम जातं गुणसमृद्धये ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20011713,
    "chapter_id": 6685,
    "verse_number": "13.49",
    "content_sanskrit": "वार्तामशृणवं तस्या रुक्मिण्या वर्णितामहम् । पूर्वरात्रे सखीलोकं पृष्ट्वा विज्ञाय तद्गिरा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20011714,
    "chapter_id": 6685,
    "verse_number": "13.50",
    "content_sanskrit": "त्वद्गिरेव तु विज्ञातुं जानन्नप्यद्य पृष्टवान् । मा स्म शोचः करस्थैव वेद्याऽद्य दयिता त्वया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20011715,
    "chapter_id": 6685,
    "verse_number": "13.51",
    "content_sanskrit": "दातुमैच्छमहं तुभ्यं प्रागेव भगिनीमिमाम् । आर्यस्तु प्रियशिष्याय जामात्रे नागकेतवे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20011716,
    "chapter_id": 6685,
    "verse_number": "13.52",
    "content_sanskrit": "न च वञ्चयितुं जातु गुरुत्वान्मे स गच्छति । तदुपायेन केनापि हृत्वा नेया त्वयाऽऽशु सा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20011717,
    "chapter_id": 6685,
    "verse_number": "13.53",
    "content_sanskrit": "इत्युक्तस्तेन कौन्तेयः क्षणं ध्यात्वा कृतस्मितः । तमब्रवीद्यतिर्भूत्वा हर्ताऽहं दयितामिति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20011718,
    "chapter_id": 6685,
    "verse_number": "13.54",
    "content_sanskrit": "ओमित्युक्तोऽथ कृष्णेन वृष्णीनामन्त्र्य स प्रियान् । प्रातिष्ठत कुरून् नाम स्वान्दिदृक्षुश्चिरेक्षितान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20011719,
    "chapter_id": 6685,
    "verse_number": "13.55",
    "content_sanskrit": "प्रस्थाय च विविक्तस्थस्स यतिः समवर्तत । पवित्रपाणिरुष्णीषो माञ्जिष्ठे वसने वहन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20011720,
    "chapter_id": 6685,
    "verse_number": "13.56",
    "content_sanskrit": "युवाऽभिरूपश्चूडालस्त्रिदण्डी सकमण्डलुः । अंसवक्षोललाटस्थसितमृत्सोर्ध्वपुण्ड्रकः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20011721,
    "chapter_id": 6685,
    "verse_number": "13.57",
    "content_sanskrit": "तदैव प्राविशच्चाऽसौ पुरं तां पूजितो नृणाम् । समादधानो हृदयं तत्वे कस्मिन्नपि प्रिये ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20011722,
    "chapter_id": 6685,
    "verse_number": "13.58",
    "content_sanskrit": "गते पार्थे प्रविष्टं तमपश्यत् कुतुकी जनः । दामोदरमिव दृष्टमायातं तरुणं रविम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20011723,
    "chapter_id": 6685,
    "verse_number": "13.59",
    "content_sanskrit": "सोऽतिष्ठद् द्वास्थमासाद्य तमशंसन्नृपाय सः । उग्रसेनस्तमब्रूत स प्रवेश्यस्त्वयाऽऽश्विति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20011724,
    "chapter_id": 6685,
    "verse_number": "13.60",
    "content_sanskrit": "नृपः प्रत्युदतिष्ठत्तमुपायान्तं प्रवेशितम् । सह वृष्ण्यन्धकैस्सर्वे रणन्मणिविभूषणैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20011725,
    "chapter_id": 6685,
    "verse_number": "13.61",
    "content_sanskrit": "स्वयमेवाऽऽहुकस्तस्मै प्रायच्छत् परमासनम् । सुमृष्टमपि पाणिभ्यां मृजन् भृत्येषु सत्स्वपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20011726,
    "chapter_id": 6685,
    "verse_number": "13.62",
    "content_sanskrit": "उपविष्टं च तं तत्र प्राणमत्सार्धमन्धकैः । दीप्तांशुना किरीटेन चरणाम्बुजचुम्बिना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20011727,
    "chapter_id": 6685,
    "verse_number": "13.63",
    "content_sanskrit": "स्मितज्योत्स्नापरीतेन प्रसन्नेन मुखेन्दुना । समवर्धयताऽऽशीर्भिर्नमतो मस्करी नृपान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20011728,
    "chapter_id": 6685,
    "verse_number": "13.64",
    "content_sanskrit": "नत्वा चिरं विरम्याऽथ निषण्णो मणिभूतले । आर्चयत्तं यथाशास्त्रमभाषत च भूपतिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20011729,
    "chapter_id": 6685,
    "verse_number": "13.65",
    "content_sanskrit": "यद् भूर्यकरवं पुण्यं तेन मे भगवन् गृहम् । नीतोऽद्य नूनं क्वाऽपुण्याः क्व भवादृशसङ्गमः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20011730,
    "chapter_id": 6685,
    "verse_number": "13.66",
    "content_sanskrit": "नहि पेलवपुण्यानां पवितारो गृहाण्यमी । भगवत्पादराजीवपरागपरमाणवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20011731,
    "chapter_id": 6685,
    "verse_number": "13.67",
    "content_sanskrit": "पवित्राणां पवित्रोऽयं प्रार्थनीयो न कैर्बुधैः । पुण्यानां कारणं लिङ्गं कार्यञ्चार्यसमागमः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "avatarnika": ""
  },
  {
    "id": 20011732,
    "chapter_id": 6685,
    "verse_number": "13.68",
    "content_sanskrit": "सत्वमुन्मीलितं नोऽद्य कृत्स्नमुन्मूलितं तमः । पुण्यमुल्लसितं भूरि प्रध्वस्तः पापसञ्चयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "avatarnika": ""
  },
  {
    "id": 20011733,
    "chapter_id": 6685,
    "verse_number": "13.69",
    "content_sanskrit": "करुणावारिमेघस्य पार्श्वेऽत्र भवतोऽधुना । सूक्तिशीकरतर्षात्र्ता गताश्चातकतां वयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "avatarnika": ""
  },
  {
    "id": 20011734,
    "chapter_id": 6685,
    "verse_number": "13.70",
    "content_sanskrit": "'क्वाऽवसन् भगवन्तः प्राक् प्राप्ता देशमिमं कथम् । किं वाऽद्य दासैः कर्तव्यं रेणूनां चरणाब्जयोः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "avatarnika": ""
  },
  {
    "id": 20011735,
    "chapter_id": 6685,
    "verse_number": "13.71",
    "content_sanskrit": "इति पाराशरी पृष्टः पार्थिवेन तमब्रवीत् । सितांशुक्रं सरस्वत्या दन्तांशुचयमुद्गिरन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "avatarnika": ""
  },
  {
    "id": 20011736,
    "chapter_id": 6685,
    "verse_number": "13.72",
    "content_sanskrit": "परकीयान् गुणान् सन्तो व्याख्यातारो मितानपि । भूरीनपि न तु स्वीयांस्त्वमेवात्र निदर्शनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "avatarnika": ""
  },
  {
    "id": 20011737,
    "chapter_id": 6685,
    "verse_number": "13.73",
    "content_sanskrit": "अद्भुतान्यपदानानि शुश्रुवांसो वयन्तव । गुप्तविष्टपचक्राणि हतारीणि हरेरिव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 73,
    "avatarnika": ""
  },
  {
    "id": 20011738,
    "chapter_id": 6685,
    "verse_number": "13.74",
    "content_sanskrit": "ज्ञातारस्त्वां वयं कंसे पापे पुत्रेऽप्यवत्सलम् । वत्सलं वासुदेवे च हतपुत्रेऽपि पार्थिव ! ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74,
    "avatarnika": ""
  },
  {
    "id": 20011739,
    "chapter_id": 6685,
    "verse_number": "13.75",
    "content_sanskrit": "स्वसारमपि निर्दोषां कंसोऽबाधत देवकीम् । अभर्त्सयदबभ्राच्च वृद्धमानकदुन्दुभिम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 75,
    "avatarnika": ""
  },
  {
    "id": 20011740,
    "chapter_id": 6685,
    "verse_number": "13.76",
    "content_sanskrit": "मन्दिरे नन्दगोपस्य शश्वत्तस्याऽऽज्ञयाऽवसत् । सञ्चचूर्णयिषुबालं शौंरिं शकट'दानवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 76,
    "avatarnika": ""
  },
  {
    "id": 20011741,
    "chapter_id": 6685,
    "verse_number": "13.77",
    "content_sanskrit": "अपिनट् पादपद्माभ्यां तमुत्तानशयो हरिः । प्रयच्छन्तीं विषस्तन्यं पूतनामप्यपातयत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 77,
    "avatarnika": ""
  },
  {
    "id": 20011742,
    "chapter_id": 6685,
    "verse_number": "13.78",
    "content_sanskrit": "तं हन्तुं कंसभृत्याभ्यामवृध्यत ततो व्रजे । तावर्जुनावपात्येतां क्रीडता पीतवाससा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 78,
    "avatarnika": ""
  },
  {
    "id": 20011743,
    "chapter_id": 6685,
    "verse_number": "13.79",
    "content_sanskrit": "प्राहिणोत्स प्रलम्बादीन् भागिनेयजिघांसया । सरौहिणेयस्तान् सर्वानमश्नान्मधुसूदनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 79,
    "avatarnika": ""
  },
  {
    "id": 20011744,
    "chapter_id": 6685,
    "verse_number": "13.80",
    "content_sanskrit": "नेत्राभ्यां क्रोधदीप्ताभ्यां पश्यत्युत्तानितानने । त्वत्पुत्रेण व्यराजेतां दिवाकरनिशाकरौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 80,
    "avatarnika": ""
  },
  {
    "id": 20011745,
    "chapter_id": 6685,
    "verse_number": "13.81",
    "content_sanskrit": "अक्रूरेण समानाय्य रामकृष्णौ स पापकृत् । रजकादिवधक्रुद्धो वसुदेवमभर्त्सयत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 81,
    "avatarnika": ""
  },
  {
    "id": 20011746,
    "chapter_id": 6685,
    "verse_number": "13.82",
    "content_sanskrit": "तस्याऽधिक्षिपतस्तातम्मल्लारिर्मञ्चवर्तिनः । तार्क्ष्यो नागाधिपस्येव तरसा हृदयेऽपतत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 82,
    "avatarnika": ""
  },
  {
    "id": 20011747,
    "chapter_id": 6685,
    "verse_number": "13.83",
    "content_sanskrit": "भीताऽश्लिष्यदरातिश्रीकुचकुङ्कुमकर्दमः । तदानीं कोपलक्षेण कृष्णस्याऽरञ्जयद्वपुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 83,
    "avatarnika": ""
  },
  {
    "id": 20011748,
    "chapter_id": 6685,
    "verse_number": "13.84",
    "content_sanskrit": "स्फुरन्तमधरन्तस्य न्यरुणद्दशनावलिः । कोपवालातपारूढौ नेत्रपद्मावराजताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 84,
    "avatarnika": ""
  },
  {
    "id": 20011749,
    "chapter_id": 6685,
    "verse_number": "13.85",
    "content_sanskrit": "स्वेदखिन्नाङ्गसंक्रान्तप्रतिबिम्बच्छलेन च । अकम्पत भिया लोकः कम्पमाने रुषा हरौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 85,
    "avatarnika": ""
  },
  {
    "id": 20011750,
    "chapter_id": 6685,
    "verse_number": "13.86",
    "content_sanskrit": "अर्चिर्भिरिव रोषाग्नेः कौस्तुभस्य गभस्तिभिः । अपतन्मधुराधीशं पङ्कजाक्षः परिक्षिपन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 86,
    "avatarnika": ""
  },
  {
    "id": 20011751,
    "chapter_id": 6685,
    "verse_number": "13.87",
    "content_sanskrit": "अभनक् समणिं मौलिमभिनद्धृदयं पदा । तस्याऽमृद्नाद्रिपुश्शौरिरनर्दत् समकुर्दत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 87,
    "avatarnika": ""
  },
  {
    "id": 20011752,
    "chapter_id": 6685,
    "verse_number": "13.88",
    "content_sanskrit": "पद्मापतेस्स पापोऽपि पादपातैरपूयत । गाङ्गञ्जनङ्गमस्यापि पावनं हि विगाहनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 88,
    "avatarnika": ""
  },
  {
    "id": 20011753,
    "chapter_id": 6685,
    "verse_number": "13.89",
    "content_sanskrit": "तस्याऽनुजं सुनामानमग्रजस्तस्य लाङ्गली । पिष्ट्वाशु हृदये पित्रोः प्रकृष्टां तुष्टिमार्पयत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 89,
    "avatarnika": ""
  },
  {
    "id": 20011754,
    "chapter_id": 6685,
    "verse_number": "13.90",
    "content_sanskrit": "मातुलानीस्समाश्वास्य त्वाञ्च मातामहीञ्च सः । तदौर्ध्वदेहिकं शत्रोस्साधु युष्मानकारयत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 90,
    "avatarnika": ""
  },
  {
    "id": 20011755,
    "chapter_id": 6685,
    "verse_number": "13.91",
    "content_sanskrit": "तदाप्रभृति साम्राज्यं त्वया हरिरकारयत् । जीवलोके मरुल्लोके स्वाराज्यमिव वज्रिणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 91,
    "avatarnika": ""
  },
  {
    "id": 20011756,
    "chapter_id": 6685,
    "verse_number": "13.92",
    "content_sanskrit": "चक्रायुधजितारातिचक्रस्याऽस्य त्वमीश्वरः । भूचक्रस्य नृपाऽद्यत्वे सर्वस्य जगतोऽथवा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 92,
    "avatarnika": ""
  },
  {
    "id": 20011757,
    "chapter_id": 6685,
    "verse_number": "13.93",
    "content_sanskrit": "अहन्तु तीर्थयातार्थमुषित्वा दक्षिणापथे । इहाऽऽगतो निवासार्थी युष्मत्प्रणयचोदितः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 93,
    "avatarnika": ""
  },
  {
    "id": 20011758,
    "chapter_id": 6685,
    "verse_number": "13.94",
    "content_sanskrit": "किञ्च कुञ्चितकेशान्तमस्तकन्यस्तचन्द्रकम् । दिदृक्षुरस्मि पत्राक्षं वक्षःस्फुरितकौस्तुभम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 94,
    "avatarnika": ""
  },
  {
    "id": 20011759,
    "chapter_id": 6685,
    "verse_number": "13.95",
    "content_sanskrit": "आविरासीदमुष्यैवं गदतोऽग्रे गदाधरः । सकान्ताकुचकाश्मीरवनमालं वहन्नुरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 95,
    "avatarnika": ""
  },
  {
    "id": 20011760,
    "chapter_id": 6685,
    "verse_number": "13.96",
    "content_sanskrit": "अथ दर्शितसंभ्रान्तिः प्रणिपत्याऽच्युतो यतिम् । अधत्ताऽनिच्छतोऽप्यस्य शिरसाऽङ्घ्रिरजःकणान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 96,
    "avatarnika": ""
  },
  {
    "id": 20011761,
    "chapter_id": 6685,
    "verse_number": "13.97",
    "content_sanskrit": "रुक्मिणीसत्यभामाभ्यां स्वयं सम्पादितां ततः । भिक्षामश्वददात्तस्मै ससत्काररसोत्तराम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 97,
    "avatarnika": ""
  },
  {
    "id": 20011762,
    "chapter_id": 6685,
    "verse_number": "13.98",
    "content_sanskrit": "साध्वीभ्यां सह पत्नीभ्यां गृहमेधी पुरातनः । सोऽमोदततरामर्च्चन्तमभ्यर्च्याऽतिथिं प्रियम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 98,
    "avatarnika": ""
  },
  {
    "id": 20011763,
    "chapter_id": 6685,
    "verse_number": "13.99",
    "content_sanskrit": "मन्त्रयित्वा समं राज्ञा पित्रा रामेण चाऽच्युतः । निजाग्निहोत्रशालान्ते निवासमकरोद्यतेः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 99,
    "avatarnika": ""
  },
  {
    "id": 20011764,
    "chapter_id": 6685,
    "verse_number": "13.100",
    "content_sanskrit": "निकेतनात्सुभद्राया नातिदूरे यदृच्छया । वसतिस्सितवाहस्य माधवेन व्यधीयत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 100,
    "avatarnika": ""
  },
  {
    "id": 20011765,
    "chapter_id": 6685,
    "verse_number": "13.101",
    "content_sanskrit": "शुश्रूषाव्यपदेशेन सदा सन्निहितो हरिः । विजने सह पार्थेन यथापुरमखुर्द्दत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 101,
    "avatarnika": ""
  },
  {
    "id": 20011766,
    "chapter_id": 6685,
    "verse_number": "13.102",
    "content_sanskrit": "अहसत्स मुहुः पश्यन् यतिवेषं धनञ्जयम् । वपुश्च वपुषाऽऽलिङ्गत्तस्य प्रधृतकण्टकम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 102,
    "avatarnika": ""
  },
  {
    "id": 20011767,
    "chapter_id": 6685,
    "verse_number": "13.103",
    "content_sanskrit": "अजपच्च हरिः कर्णे रुक्मिणीसत्यभामयोः । अत्रस्थितस्सुभद्रार्थी पार्थो यतिरसाविति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 103,
    "avatarnika": ""
  },
  {
    "id": 20011768,
    "chapter_id": 6685,
    "verse_number": "13.104",
    "content_sanskrit": "वसुदेवेन देवक्या रामेण च ततस्सह । हरिस्सुभद्रामाहूय मधुरां वाचमब्रवीत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 104,
    "avatarnika": ""
  },
  {
    "id": 20011769,
    "chapter_id": 6685,
    "verse_number": "13.105",
    "content_sanskrit": "वत्से कामदुघास्सन्तो जन्तूनामभिराधिताः । तदतन्द्रितया पूज्यस्त्वया यतिरसाविति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 105,
    "avatarnika": ""
  },
  {
    "id": 20011770,
    "chapter_id": 6685,
    "verse_number": "13.106",
    "content_sanskrit": "भ्रातुराकर्ण्य सा वाक्यं यतेरातिष्ठताऽर्चनम् । बद्धभावा गुडाकेशे प्रागेव जनवर्णिते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 106,
    "avatarnika": ""
  },
  {
    "id": 20011771,
    "chapter_id": 6685,
    "verse_number": "13.107",
    "content_sanskrit": "प्रतिपच्चन्द्रलेखेव गाढोत्कण्ठातनीयसी । प्रियं पर्यचरत्पार्थं सा जानन्तमजानती ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 107,
    "avatarnika": ""
  },
  {
    "id": 20011772,
    "chapter_id": 6685,
    "verse_number": "13.108",
    "content_sanskrit": "विना सखीभिस्त्रपया परीता निवारिताभिर्मधुसूदनेन । सैकाकिनी मुग्धकटाक्षपाता पार्श्वे स्थिता मन्दमवन्दतैनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 108,
    "avatarnika": ""
  },
  {
    "id": 20011773,
    "chapter_id": 6685,
    "verse_number": "13.109",
    "content_sanskrit": "श्यामां विशालेक्षणमूढदण्डं रक्तान्तरीयं रचितोर्ध्वपुण्ड्रम् । न्यशामयन्मस्करिणं कुमारी कुतूहलेन स्तिमितैरपाङ्गैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 109,
    "avatarnika": ""
  },
  {
    "id": 20011774,
    "chapter_id": 6685,
    "verse_number": "13.110",
    "content_sanskrit": "दृष्ट्वा तं संहतोरुः पृथुतरजघना कान्तसूक्ष्मान्तरीया मध्ये गंभीरनाभौ त्रिवलिमतिमिते रूढरोमावलीका । राजन्नक्षत्रमालास्तनमुकुलयुगा निर्निमेषायताक्षी दोर्भ्यां बद्धाञ्जलिभ्यामविरलपुलकं प्राजगमत् प्रावृतं सा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 110,
    "avatarnika": ""
  },
  {
    "id": 20011775,
    "chapter_id": 6685,
    "verse_number": "13.111",
    "content_sanskrit": "माधवीमुखशशाङ्कदर्शने स्पन्दितं हसितफेनशोभिना । सान्ध्यरोचिररुणाम्बरप्रभाभासुरेण विजयामृताब्धिना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 111,
    "avatarnika": ""
  },
  {
    "id": 20011776,
    "chapter_id": 6685,
    "verse_number": "13.112",
    "content_sanskrit": "पयोधरौ पीडयते प्रियायास्विन्नौ कपोलौ परिचुम्बते च । ईहासु तत्राऽस्पृहयत् किरीटी पदे पदे निष्कुटमारुताय ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 112,
    "avatarnika": ""
  }
]