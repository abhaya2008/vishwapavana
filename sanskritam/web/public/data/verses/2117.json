[{"id": 2050908, "chapter_id": 2117, "verse_number": "७-४४-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2050909, "chapter_id": 2117, "verse_number": "७-४४-१", "content_sanskrit": "सैन्धवेन निरुद्धेषु जयगृद्धिषु पाण़्डुषु।\nसुघोरमभवद्युद्धं त्वदीयानां परैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2050910, "chapter_id": 2117, "verse_number": "७-४४-२", "content_sanskrit": "प्रविश्याथार्जुनिः सेनां सत्यसन्धो दुरासदः।\nव्यक्षोभयत तेजस्वी मकरः सागरं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2050911, "chapter_id": 2117, "verse_number": "७-४४-३", "content_sanskrit": "तं तथा शरवर्षेण छादयन्तमरिंदमम्।\nयथा प्रधानाः सौभद्रमभ्ययुः कुरुसत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2050912, "chapter_id": 2117, "verse_number": "७-४४-४", "content_sanskrit": "तेषां तस्य च सम्मर्दो दारुणः समपद्यत।\nसृजतां शरवर्षाणि प्रसक्तममितौजसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2050913, "chapter_id": 2117, "verse_number": "७-४४-५", "content_sanskrit": "रथव्रजेन संरुद्धस्तैरमित्रैस्तथाऽऽर्जुनिः।\nवृषसेनस्य यन्तारं हत्वा चिच्छेद कार्मुकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2050914, "chapter_id": 2117, "verse_number": "७-४४-६", "content_sanskrit": "तं च विव्याध बलवांस्तस्य चाश्वानजिह्मगैः।\nवातायमानैस्तैरश्वैर्विसंज्ञोऽपहृतो रणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2050915, "chapter_id": 2117, "verse_number": "७-४४-७", "content_sanskrit": "तेनान्तरेणाभिमन्योर्यन्तापासारयद्रथम्।\nरथव्रजास्ततो हृष्टाः साधुसाध्विति चुक्रुशुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2050916, "chapter_id": 2117, "verse_number": "७-४४-८", "content_sanskrit": "तं सिंहमिव सङ्क्रुद्धं प्रमथ्नन्तं शरैररीन्।\nआरादायान्तमभ्येत्य वसातीयोऽभ्ययाद्द्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2050917, "chapter_id": 2117, "verse_number": "७-४४-९", "content_sanskrit": "सोऽभिमन्युं शरैः षष्ट्या रुक्मपुङ्कैरवाकिरत्।\nअब्रवीच्च न मे जीवञ्जीवतो युधि मोक्ष्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2050918, "chapter_id": 2117, "verse_number": "७-४४-१०", "content_sanskrit": "तमयस्मयवर्माणमिषुणा दूरपातिना।\nविव्याध हृदि सौभद्रः स पपात व्यसुः क्षितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2050919, "chapter_id": 2117, "verse_number": "७-४४-११", "content_sanskrit": "वसातीयं हतं दृष्ट्वा क्रुद्धाः क्षत्रियपुङ्गवाः।\nपरिवव्रुस्तदा राजंस्तव पौत्रं जिघांसवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2050920, "chapter_id": 2117, "verse_number": "७-४४-१२", "content_sanskrit": "विष्फारयन्तश्चापानि नानारूपाण्यनेकशः।\nतद्युद्धमभवद्रौद्रं सौभद्रस्यारिभिः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2050921, "chapter_id": 2117, "verse_number": "७-४४-१३", "content_sanskrit": "तेषां शरान्सेष्वसनाञ्शरीराणि शिरांसि च।\nसकुण्डलानि स्रग्वीणि क्रुद्धश्चिच्छेद फाल्गुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2050922, "chapter_id": 2117, "verse_number": "७-४४-१४", "content_sanskrit": "सखङ्गाः साङ्गुलित्राणाः सपट्टसपरश्वथाः।\nअदृश्यन्त भुजाश्छिन्ना हेमाभरणभूषिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2050923, "chapter_id": 2117, "verse_number": "७-४४-१५", "content_sanskrit": "स्रग्भिराभरणैर्वस्त्रैः पतितैर्विविधैर्ध्वजैः।\nवर्मभिश्चर्मभिर्हारैर्मुकुटैश्छत्रचामरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2050924, "chapter_id": 2117, "verse_number": "७-४४-१६", "content_sanskrit": "उपस्करैरधिष्ठानैरीषादण्डकबन्धुरैः।\nअक्षैर्विमथितैश्चक्रैर्भग्नैश्च बहुधा युगैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2050925, "chapter_id": 2117, "verse_number": "७-४४-१७", "content_sanskrit": "अनुकर्षैः पताकाभिस्तथा सारथिवाजिभिः।\nरथैश्च भग्नैर्नागैश्च हतैः कीर्णाभवन्मही॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2050926, "chapter_id": 2117, "verse_number": "७-४४-१८", "content_sanskrit": "निहतैः क्षत्रियैः शूरैर्नानाजनपदेश्वरैः।\nजयगृद्धैर्वृता भूमिर्दारुणा समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2050927, "chapter_id": 2117, "verse_number": "७-४४-१९", "content_sanskrit": "दिशो विचरतस्तस्य सर्वाश्च प्रदिशस्तथा।\nरणेऽभिमन्योः क्रुद्धस्य रूपमन्तरधीयत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2050928, "chapter_id": 2117, "verse_number": "७-४४-२०", "content_sanskrit": "काञ्चनं यद्यदस्यासीद्वर्म चाभरणानि च।\nधनुषश्च शराणां च तदपश्याम केवलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2050929, "chapter_id": 2117, "verse_number": "७-४४-२१", "content_sanskrit": "तं तदा नाशकत्कश्चिच्चक्षुर्भ्यामभिवीक्षितुम्।\nआददानं शरैर्योधान्मध्ये सूर्यमिव स्थितम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2050930, "chapter_id": 2117, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि अभिमन्युवधपर्वणि त्रयोदशदिवसयुद्धे चतुश्चत्वारिंशोऽध्यायः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]