[{"id": 2129956, "chapter_id": 3799, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2129957, "chapter_id": 3799, "verse_number": "१", "content_sanskrit": "ते शूरास्ततधन्वानस्तूणवन्तः समार्गणाः ।\nबद्धगोधाङ्गुलित्राणाः खड्गवन्तोऽमितौजसः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2129958, "chapter_id": 3799, "verse_number": "२", "content_sanskrit": "परिगृह्य द्विजश्रेष्ठान् ज्येष्ठाः सर्वधनुष्मताम् ।\nपाञ्चालीसहिता राजन् प्रययुर्गन्धमादनम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2129959, "chapter_id": 3799, "verse_number": "३", "content_sanskrit": "सरांसि सरितश्चैव पर्वतांश्च वनानि च ।\nवृक्षांश्च बहुलच्छायान् ददृशुगिरिमूर्धनि\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2129960, "chapter_id": 3799, "verse_number": "४", "content_sanskrit": "नित्यपुष्पफलान् देशान् देवर्षिगणसेवितान् ।\nआत्मन्यात्मानमाधाय वीरा मूलफलाशिनः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2129961, "chapter_id": 3799, "verse_number": "५", "content_sanskrit": "चेरुरुच्चावचाकारान् देशान् विषमसङ्कटान् ।\nपश्यन्तो मृगजातानि बहूनि विविधानि च\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2129962, "chapter_id": 3799, "verse_number": "६", "content_sanskrit": "ऋषिसिद्धामरयुतं गन्धर्वाप्सरसां प्रियम् ।\nविविशुस्ते महात्मानः किन्नराचरितं गिरिम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2129963, "chapter_id": 3799, "verse_number": "७", "content_sanskrit": "प्रविशत्स्वथ वीरेषु पर्वतं गन्धमादनम् ।\nचण्डवातं महद्वर्षं प्रादुरासीत् विशाम्पते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2129964, "chapter_id": 3799, "verse_number": "८", "content_sanskrit": "ततो रेणुः समुद्भूतः सपत्रबहुलो महान् ।\nपृथिवीं चान्तरिक्षं च द्यां चैव सहसाऽऽवृणोत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2129965, "chapter_id": 3799, "verse_number": "९", "content_sanskrit": "न स्म प्रज्ञायते किञ्चिदावृते व्योम्नि रेणुना ।\nन चापि शेकुस्तत्कर्तुमन्योन्यस्याभिभाषणम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2129966, "chapter_id": 3799, "verse_number": "१०", "content_sanskrit": "न चापश्यंस्ततोऽन्योन्यं तमसाऽऽवृतचक्षुषः ।\nआकृष्यमाणा वातेन साश्मचूर्णेन भारत \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2129967, "chapter_id": 3799, "verse_number": "११", "content_sanskrit": "द्रुमाणां वातभग्नानां पततां भूतळेऽनिशम् ।\nअन्येषां च महीजानां शब्दः समभवन्महान्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2129968, "chapter_id": 3799, "verse_number": "१२", "content_sanskrit": "द्यौः स्वित् पतति किं भूमिर्दीर्यते पर्वतो नु किम् ।\nइति ते मेनिरे सर्वे पवनेनापि मोहिताः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2129969, "chapter_id": 3799, "verse_number": "१३", "content_sanskrit": "ते पथाऽनन्तरान् वृक्षान् वल्मीकान् विषमाणि च ।\nपाणिभिः परिमार्गन्तो भीता वायोर्निलिल्यिरे\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2129970, "chapter_id": 3799, "verse_number": "१४", "content_sanskrit": "ततः कार्मुकमादाय भीमसेनो महाबलः ।\nकृष्णामादाय सङ्गम्य तस्थावाश्रित्य पादपम् ।\nधर्मराजश्च धौम्यश्च निलिल्याते महावने \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2129971, "chapter_id": 3799, "verse_number": "१५", "content_sanskrit": "अग्निहोत्राण्युपादाय सहदेवस्तु पर्वते ।\nनकुलो ब्राह्मणाश्चान्ये लोमशश्च महातपाः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2129972, "chapter_id": 3799, "verse_number": "१६", "content_sanskrit": "वृक्षानासाद्य सन्त्रस्तास्तत्र तत्र निलिल्यिरे\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2129973, "chapter_id": 3799, "verse_number": "१७", "content_sanskrit": "मन्दीभूते तु पवने तस्मिन् रजसि शाम्यति ।\nमहद्भिर्पृषतैः धारैर्वर्षमभ्याजगाम ह \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2129974, "chapter_id": 3799, "verse_number": "", "content_sanskrit": "भृशं चटचटाशब्दो वज्राणां क्षिप्यतामिव ।\nततस्ताश्चञ्चलाभासश्चेरुरभ्रेषु विद्युतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2129975, "chapter_id": 3799, "verse_number": "१८", "content_sanskrit": "ततोऽश्मसहिता धाराः संवृण्वन्त्यः समन्ततः ।\nप्रपेतुरनिशं तत्र शीघ्रवातसमीरिताः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2129976, "chapter_id": 3799, "verse_number": "१९", "content_sanskrit": "तत्र सागरगा ह्यापः कीर्यमाणाः समन्ततः ।\nप्रादुरासन् सकलुषाः फेनवत्यो विशाम्पते\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2129977, "chapter_id": 3799, "verse_number": "२०", "content_sanskrit": "वहन्त्यो वारि बहुलं फेनोडुपपरिप्लुतम् ।\nपरिसस्रुर्महाशब्दाः प्रकर्षन्त्यो महीरुहान्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2129978, "chapter_id": 3799, "verse_number": "२१", "content_sanskrit": "तस्मिन्नुपरते शब्दे वाते च समतां गते ।\nगते ह्यम्भसि निम्नानि प्रादुर्भूते दिवाकरे\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2129979, "chapter_id": 3799, "verse_number": "२२", "content_sanskrit": "निर्जग्मुस्ते शनैः सर्वे समाजग्मुश्च भारत ।\nप्रतस्थिरे पुनर्वीराः पर्वतं गन्धमादनम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2129980, "chapter_id": 3799, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि चत्वारिंशदधिकशततमोऽध्यायः ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2129981, "chapter_id": 3799, "verse_number": "", "content_sanskrit": "॥ इति तीर्थयात्रापर्वणि षण्णवतितमोऽध्यायः ॥९६॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]