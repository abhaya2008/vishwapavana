[{"id": 2030623, "chapter_id": 1670, "verse_number": "३-३०८-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2030624, "chapter_id": 1670, "verse_number": "३-३०८-१", "content_sanskrit": "सा तु कन्या बहुविधं ब्रुवन्ती मधुरं वचः।\nअनुनेतुं सहस्रांशुं न शशाक मनस्विनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2030625, "chapter_id": 1670, "verse_number": "३-३०८-२", "content_sanskrit": "न शशाक यदा बाला प्रत्याख्यातुं तमोनुदम्।\nभीता शापात्ततो राजन्दध्यौ दीर्घमथान्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2030626, "chapter_id": 1670, "verse_number": "३-३०८-३", "content_sanskrit": "अनागसः पितुः शापो ब्राह्मणस्य तथैव च।\nमन्निमित्तः कथं न स्यात्क्रुद्धादस्माद्विभावसोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2030627, "chapter_id": 1670, "verse_number": "३-३०८-४", "content_sanskrit": "बालेनापि सता मोहाद्भृशं सापह्नवान्यपि।\nनाऽभ्यासादयितव्यानि तेजांसि च तपांसि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2030628, "chapter_id": 1670, "verse_number": "३-३०८-५", "content_sanskrit": "साहमद्य भृशं भीता गृहीत्वा च करे भृशम्।\nकथं त्वकार्यं कुर्यां वै प्रदानं ह्यात्मनः स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2030629, "chapter_id": 1670, "verse_number": "३-३०८-६", "content_sanskrit": "सा वै शापपरित्रस्ता बहु चिन्तयती हृदा।\nमोहेनाभिपरीताङ्गी स्मयमाना पुनःपुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2030630, "chapter_id": 1670, "verse_number": "३-३०८-७", "content_sanskrit": "तं देवमब्रवीद्भीता बन्धूनां राजसत्तम।\nव्रीडाविह्वलया वाचा शापत्रस्ता विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2030631, "chapter_id": 1670, "verse_number": "३-३०८-८", "content_sanskrit": "पिता मे ध्रियते देव माता चान्ये च बान्धवाः।\nन तेषु ध्रियमाणएषु विदिलोपो भवेदयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2030632, "chapter_id": 1670, "verse_number": "३-३०८-९", "content_sanskrit": "त्वया तु संगमो देव यदि स्याद्विधिवर्जितः।\nमन्निमित्तं कुलस्यास्य लोकेऽकीर्तिर्न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2030633, "chapter_id": 1670, "verse_number": "३-३०८-१०", "content_sanskrit": "अथवा धर्ममेतं त्वं मन्यसे तपतांवर।\nऋते प्रदानाद्बन्धुभ्यस्तव कामं करोम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2030634, "chapter_id": 1670, "verse_number": "३-३०८-११", "content_sanskrit": "आत्मप्रदानं दुर्धर्ष तव कृत्वासती त्वहम्।\nत्वयि धर्मो यशश्चैव कीर्तिरायुश्च देहिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2030635, "chapter_id": 1670, "verse_number": "३-३०८-१२x", "content_sanskrit": "सूर्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2030636, "chapter_id": 1670, "verse_number": "३-३०८-१२", "content_sanskrit": "न ते पिता न ते माता गुरवो वा शुचिस्मिते।\nप्रभवन्ति प्रदाने ते भद्रं ते शृणु मे वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2030637, "chapter_id": 1670, "verse_number": "३-३०८-१३", "content_sanskrit": "सर्वान्कामयते यस्मात्कनेर्धातोश्च भामिनि।\nतस्मात्कन्येह सुश्रोणी स्वतन्त्रा वरवर्णिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2030638, "chapter_id": 1670, "verse_number": "३-३०८-१४", "content_sanskrit": "नाधर्मश्चरितः कश्चित्त्वया भवति भामिनि।\nअधर्मंकुत एवाहं वरेयं लोककाम्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2030639, "chapter_id": 1670, "verse_number": "३-३०८-१५", "content_sanskrit": "अनावृताः स्त्रियः सर्वा नराश्च वरवर्णिनि।\nस्वभाव एष लोकानां विकारोऽन्य इति स्मृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2030640, "chapter_id": 1670, "verse_number": "३-३०८-१६", "content_sanskrit": "सा मया सहसंगम्य पुनः कन्या भविष्यसि।\nपुत्रश्च ते महावाद्दुर्भविष्यति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2030641, "chapter_id": 1670, "verse_number": "३-३०८-१७x", "content_sanskrit": "कुन्त्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2030642, "chapter_id": 1670, "verse_number": "३-३०८-१७", "content_sanskrit": "यदि पुत्रो मम भवेत्त्वत्तः सर्वतमोनुद।\nकुण्डली कवची शूरो महाबाहुर्महाबलः।\n`अस्तु मे सङ्गमो देव अनेन समयेन ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2030643, "chapter_id": 1670, "verse_number": "३-३०८-१८x", "content_sanskrit": "सूर्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2030644, "chapter_id": 1670, "verse_number": "३-३०८-१८", "content_sanskrit": "भविष्यति महाबाहुः कुण्डली दिव्यवर्मभृत्।\nउभयं चामृतमयं तस् भद्रे भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2030645, "chapter_id": 1670, "verse_number": "३-३०८-१९x", "content_sanskrit": "कुन्त्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2030646, "chapter_id": 1670, "verse_number": "३-३०८-१९", "content_sanskrit": "यद्यतदमृतादस्ति कुण्डले वर्म चोत्तमम्।\nमम पुत्रस्य यं वै त्वं मत्त उत्पादयिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2030647, "chapter_id": 1670, "verse_number": "३-३०८-२०", "content_sanskrit": "अस्तु मे सङ्गमो देव यथोक्तं भगवंस्त्वया।\nत्वद्वीर्यरूपसत्वौजा धऱ्मयुक्तो भवेत्स च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2030648, "chapter_id": 1670, "verse_number": "३-३०८-२१x", "content_sanskrit": "सूर्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2030649, "chapter_id": 1670, "verse_number": "३-३०८-२१", "content_sanskrit": "अदित्या कुण्डले राज्ञि दत्ते मे मत्तकाशिनि।\nतस्मै दास्यामि वामोरु वर्म चैवेदमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2030650, "chapter_id": 1670, "verse_number": "३-३०८-२२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2030651, "chapter_id": 1670, "verse_number": "३-३०८-२२", "content_sanskrit": "परमं भगवन्नेवं सङ्गमिष्ये त्वया सह।\nयदि पुत्रो भवेदेवं यथा वदसि गोपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2030652, "chapter_id": 1670, "verse_number": "३-३०८-२३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2030653, "chapter_id": 1670, "verse_number": "३-३०८-२३", "content_sanskrit": "तथेत्युक्त्वा तु तां कुन्तीमाविवेश विहंगमः।\nस्वर्भानुशत्रुर्योगात्मा नाभ्यां पस्पर्श चैव ताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2030654, "chapter_id": 1670, "verse_number": "३-३०८-२४", "content_sanskrit": "तत सा विह्वलेवासीत्कन्या सूरय्स् तेजसा।\nपपात चाथ सा देवी शयने मूढचेतना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2030655, "chapter_id": 1670, "verse_number": "३-३०८-२५x", "content_sanskrit": "सूर्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2030656, "chapter_id": 1670, "verse_number": "३-३०८-२५", "content_sanskrit": "साधयिष्यामि सुश्रोणि पुत्रं वै जनयिष्यसि।\nसर्वशस्त्रभृतांश्रेष्ठं कन्या चैव भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2030657, "chapter_id": 1670, "verse_number": "३-३०८-२६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2030658, "chapter_id": 1670, "verse_number": "३-३०८-२६", "content_sanskrit": "ततः सा व्रीडिता बाला तदा सूर्यमथाब्रवीत्।\nएवमस्त्विति राजेन्द्रप्रस्थितं भूरिवर्चसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2030659, "chapter_id": 1670, "verse_number": "३-३०८-२७", "content_sanskrit": "इतिस्मोक्ता कुन्तिराजात्मजा सा\nविवस्वन्तं याचमाना सलज्जा।\nतस्मिन्पुण्ये शयनीये पपात\nमोहाविष्टा वेपमाना लतेव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2030660, "chapter_id": 1670, "verse_number": "३-३०८-२८", "content_sanskrit": "तिग्मांशुस्तां तेजसा मोहयित्वा\nयोगेनाविश्यात्मसंस्थां चकार।\nन चैवैनां दूषयामास भानुः\nसंज्ञां लेभे भूय एवात बाला ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2030661, "chapter_id": 1670, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि कुण्डलाहरणपर्वणि रअष्टाधिकत्रिशततमोऽध्यायः ॥ ३०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]