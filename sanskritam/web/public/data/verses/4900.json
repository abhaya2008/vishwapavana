[{"id": 2183708, "chapter_id": 4900, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2183709, "chapter_id": 4900, "verse_number": "१", "content_sanskrit": "पितामह महाप्राज्ञ संशयो मे महानयम् ।\nस च्छेत्तव्यस्त्वया राजन् भवान् कुलकरो हि नः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2183710, "chapter_id": 4900, "verse_number": "२", "content_sanskrit": "पुरुषाणामयं तात दुर्वृत्तानां दुरात्मनाम् ।\nकथितो वाक्यसञ्चारस्ततो विज्ञापयामि ते\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2183711, "chapter_id": 4900, "verse_number": "३", "content_sanskrit": "यद् हितं राज्यतन्त्रस्य कुलस्य च सुखोदयम् ।\nआयत्यां च तदात्वे च क्षेमवृद्धिकरं च यत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2183712, "chapter_id": 4900, "verse_number": "४", "content_sanskrit": "पुत्रपौत्राभिरामं च राष्ट्रवृद्धिकरं च यत् ।\nअन्नपाने शरीरे च हितं यत् तद् ब्रवीहि मे\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2183713, "chapter_id": 4900, "verse_number": "५", "content_sanskrit": "अभिषिक्तो हि यो राजा राज्यस्थो मित्रसंवृतः ।\nअसुहृत्समुपेतो वा स कथं रञ्जयेत् प्रजाः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2183714, "chapter_id": 4900, "verse_number": "६", "content_sanskrit": "यो ह्यसत्प्रग्रहरतिः स्नेहरागबलात्कृतः ।\nइन्द्रियाणामनीशत्वादसज्जनबुभूषकः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2183715, "chapter_id": 4900, "verse_number": "७", "content_sanskrit": "तस्य भृत्या विगुणतां यान्ति सर्वे कुलोद्गताः ।\nनच भृत्यफलैरर्थैः स राजा सम्प्रयुज्यते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2183716, "chapter_id": 4900, "verse_number": "८", "content_sanskrit": "एतान् मे संशयस्थस्य राजधर्मान् सुदुर्लभान् ।\nबृहस्पतिसमो बुद्ध्या भवान् शंसितुमर्हति\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2183717, "chapter_id": 4900, "verse_number": "९", "content_sanskrit": "शंसिता पुरुषव्याघ्र त्वं नः कुलहिते रतः ।\nक्षत्ता चैव पटुप्रज्ञो यो नः शंसति सर्वदा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2183718, "chapter_id": 4900, "verse_number": "१०", "content_sanskrit": "त्वत्तः कुलहितं वाक्यं श्रुत्वा राज्यहितोदयम् ।\nअमृतस्याव्ययस्येव तृप्तः स्वप्स्याम्यहं सुखम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2183719, "chapter_id": 4900, "verse_number": "११", "content_sanskrit": "कीदृशाः सन्निकर्षस्था भृत्याः स्युर्वा गुणान्विताः ।\nकीदृशैः किंकुलीनैर्वा सह यात्रा विधीयते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2183720, "chapter_id": 4900, "verse_number": "१२", "content_sanskrit": "नह्येको भृत्यरहितो राजा भवति रक्षिता ।\nराज्यं चेदं जनः सर्वस्तत्कुलीनोऽभिशासति\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2183721, "chapter_id": 4900, "verse_number": "१३", "content_sanskrit": "न च प्रशास्तुं राज्यं हि शक्यमेकेन भारत ।\nअसहायवता तात नैवार्थाः केचिदप्युत ।\nलब्धुं लब्ध्वा चापि सदा रक्षितुं भरतर्षभ\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2183722, "chapter_id": 4900, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2183723, "chapter_id": 4900, "verse_number": "१४", "content_sanskrit": "यस्य भृत्यजनः सर्वो ज्ञानविज्ञानकोविदः ।\nहितैषी कुलजः स्निग्धः स राज्यफलमश्नुते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2183724, "chapter_id": 4900, "verse_number": "१५", "content_sanskrit": "मन्त्रिणो यस्य कुलजा असंहार्या सहोषिताः ।\nनृपतेर्मतिदाः सन्ति सम्बन्धज्ञानकोविदाः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2183725, "chapter_id": 4900, "verse_number": "१६", "content_sanskrit": "अनागतविधातारः कालज्ञानविशारदाः ।\nअतिक्रान्तमशोचन्तः स राज्यफलमश्नुते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2183726, "chapter_id": 4900, "verse_number": "१७", "content_sanskrit": "समदुःखसुखा यस्य सहायाः सत्यकारिणः ।\nअर्थचिन्तापरा यस्य स राज्यफलमश्नुते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2183727, "chapter_id": 4900, "verse_number": "१८", "content_sanskrit": "यस्य नार्तो जनपदः सन्निकर्षगतः सदा ।\nअक्षुद्रः सत्पथालम्बी स राज्यफलभाग् भवेत्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2183728, "chapter_id": 4900, "verse_number": "१९", "content_sanskrit": "कोशाक्षपटलं यस्य कोशवृद्धिकरैर्जनैः ।\nआप्तैस्तुष्टैश्च सततं धार्यते स नृपोत्तमः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2183729, "chapter_id": 4900, "verse_number": "२०", "content_sanskrit": "कोष्ठागारमसंहार्यैराप्तैः संचयतत्परैः ।\nपात्रभूतैरलुब्धैश्च पाल्यमानं गुणी भवेत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2183730, "chapter_id": 4900, "verse_number": "२१", "content_sanskrit": "व्यवहारश्च नगरे यस्य कर्मफलोदयः ।\nदृश्यते शङ्खलिखितः स धर्मफलभाग् भवेत्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2183731, "chapter_id": 4900, "verse_number": "२२", "content_sanskrit": "सङ्गृहीतमनुष्यश्च यो राजा राजधर्मवित् ।\nषड्वर्गं प्रतिगृह्णन् स धर्मात् फलमुपाश्नुते\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2183732, "chapter_id": 4900, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे सप्तदशाधिकशततमोध्यायः ॥ ११७ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]