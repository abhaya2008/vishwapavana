[{"id": 7006110000, "chapter_id": 26110, "verse_number": "३-५-१", "content_sanskrit": "एतादृशे महत्तत्त्वे लक्ष्म्या सह हरिः स्वयम् ।\nप्रविवेश महाभाग क्षोभयामास वै हरिः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006110001, "chapter_id": 26110, "verse_number": "३-५-२", "content_sanskrit": "अहन्तत्त्वमभूत्तस्माज्ज्ञानद्रव्यक्रियात्मकम् ।\nअहङ्कारसमुत्पत्तावेकांशस्तमसि स्मृतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006110002, "chapter_id": 26110, "verse_number": "३-५-३", "content_sanskrit": "तद्दशांशाधिकरजस्तद्दशांशाधिकं प्रभो ।\nसत्त्वमित्युच्यते सद्भिर्ह्येतदात्मा त्वहं स्मृतम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006110003, "chapter_id": 26110, "verse_number": "३-५-४", "content_sanskrit": "अहन्तत्त्वाभिमानी तु आदौ शेषो बभूवह ।\nसहस्राब्दाच्च पश्चात्तौ जातौ खगहरौ द्विज ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006110004, "chapter_id": 26110, "verse_number": "३-५-५", "content_sanskrit": "अहन्तत्त्वे खग ह्येषु प्रविष्टो हरिरव्ययः ।\nक्षोभयामास भगवाल्लङ्क्ष्म्या सह हरिः स्वयम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006110005, "chapter_id": 26110, "verse_number": "३-५-६", "content_sanskrit": "वैकारिकस्तामसश्च तैजसश्चेत्यहं त्रिधा ।\nत्रिधा बभूव रुद्रोपि यतस्तेषां नियामकः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006110006, "chapter_id": 26110, "verse_number": "३-५-७", "content_sanskrit": "वैकारिकस्थितो रुद्रो वैकारिक इति स्मृतः ।\nतामसे तु स्थितो रुद्रस्तामसो ह्यभिधीयते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006110007, "chapter_id": 26110, "verse_number": "३-५-८", "content_sanskrit": "तैजसे तु स्थितो रुद्रो लोके वै तैजसः स्मृतः ।\nतैजसे तु ह्यहन्तत्त्वे लक्ष्म्या सह हरिः स्वयम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006110008, "chapter_id": 26110, "verse_number": "३-५-९", "content_sanskrit": "विशित्वा क्षोभयामास तदासौ दशधा त्वभूत् ।\nश्रोत्रं चक्षुः स्पर्शनं च रसनं घ्राणमेव च ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006110009, "chapter_id": 26110, "verse_number": "३-५-१०", "content_sanskrit": "वाक्पाणिपादं पायुश्च उपस्थेति दश स्मृताः ।\nवैकारिके ह्यहन्तत्त्वे प्रविश्य क्षोभयद्धरिः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006110010, "chapter_id": 26110, "verse_number": "३-५-११", "content_sanskrit": "महत्तत्त्वादिमा अदाविन्द्रियाणां च देवताः ।\nएकादशविधा आसन्क्रमेण तु खगेश्वर ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006110011, "chapter_id": 26110, "verse_number": "३-५-१२", "content_sanskrit": "मनोभिमानि नी ह्यादौ वारुणी त्वभवत्तदा ।\nअनन्तरं च सौपर्णी गौरोजापि तथैव च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006110012, "chapter_id": 26110, "verse_number": "३-५-१३", "content_sanskrit": "शेषादनन्तरास्तासां दशवर्षादनंरम् ।\nउत्पत्तिरिति विज्ञेयं क्रमेण तु खगेश्वर ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006110013, "chapter_id": 26110, "verse_number": "३-५-१४", "content_sanskrit": "मनोभिमानिनावन्याविन्द्रकामौ प्रजज्ञतुः ।\nतार्क्ष्य ह्यनन्तरौ ज्ञेयौ मुक्तौ संसार एव च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006110014, "chapter_id": 26110, "verse_number": "३-५-१५", "content_sanskrit": "ततस्त्वगात्मा ह्यभवत्सोहं कारिक ईरितः ।\nततः पाण्यात्मकाश्चैव जज्ञिरे पक्षिसत्तम ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006110015, "chapter_id": 26110, "verse_number": "३-५-१६", "content_sanskrit": "शची रतिश्चानिरुद्धस्तथा स्वायंभुवो मनुः ।\nबृहस्पतिस्तथा दक्ष एते पाण्यात्मकाः स्मृताः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006110016, "chapter_id": 26110, "verse_number": "३-५-१७", "content_sanskrit": "दक्षस्यानन्तरं जज्ञे प्रवाहो नाम चाण्डज ।\nस एवोक्तश्चातिंवाहो यापयत्यात्मचोदितः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006110017, "chapter_id": 26110, "verse_number": "३-५-१८", "content_sanskrit": "हस्तादनन्तरं ज्ञेयो न तु शच्यादिवत्स्मृतः ।\nततोभवन्महाभाग चक्षुरिद्रियमात्मनः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006110018, "chapter_id": 26110, "verse_number": "३-५-१९", "content_sanskrit": "स्वायंभुवमनोर्भार्या शतरूपा यमस्तथा ।\nचन्द्रसूर्यौ तु चत्त्वारश्चक्षुरिन्द्रियमानिनः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006110019, "chapter_id": 26110, "verse_number": "३-५-२०", "content_sanskrit": "चन्द्रः श्रोत्राभिमानीति तथा ज्ञेयः खगेश्वर ।\nजिह्वेन्द्रियात्मा वरुणः सूर्यस्यानन्तरोभवत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006110020, "chapter_id": 26110, "verse_number": "३-५-२१", "content_sanskrit": "वागिन्द्रियाभिमानिन्यो ह्यभवन्वरुणादनु ।\nदक्षपत्नी प्रसूतिश्च भृगुरग्निस्तर्थव च ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006110021, "chapter_id": 26110, "verse_number": "३-५-२२", "content_sanskrit": "तत्र वैते महात्मानो वागिन्द्रियनियामकाः ।\nये क्रव्यादादयश्चोक्तास्तेनन्तत्त्वनियामकाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006110022, "chapter_id": 26110, "verse_number": "३-५-२३", "content_sanskrit": "साम्यत्वाच्च तथैवोक्तिर्न तु तत्त्वाभिमानितः ।\nउपस्थमानिनो वीन्द्र बभूवुस्तदनन्तरम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006110023, "chapter_id": 26110, "verse_number": "३-५-२४", "content_sanskrit": "विश्वामित्रो वसिष्टोत्रिर्मरीचिः पुलहः क्रतुः ।\nपुलस्त्योङ्गिरसश्चैव तथा वैवस्वतो मनुः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006110024, "chapter_id": 26110, "verse_number": "३-५-२५", "content_sanskrit": "मन्वादयोनन्तसंख्या उपस्थात्मान ईरिताः ।\nपायोश्च मानिनो वीन्द्र जज्ञिरे तदनन्तरम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006110025, "chapter_id": 26110, "verse_number": "३-५-२६", "content_sanskrit": "सूर्येषु द्वादशस्वेको मित्रस्तारा गुरोः प्रिया ।\nकोणाधिपो निरृतिश्च प्रवहप्रिया ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006110026, "chapter_id": 26110, "verse_number": "३-५-२७", "content_sanskrit": "चत्त्वार एते पक्षीन्द्र वायुतत्त्वाभिमानिनः ।\nघ्राणाभिमानिनः सर्वे जज्ञिरे द्विजसत्तम ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006110027, "chapter_id": 26110, "verse_number": "३-५-२८", "content_sanskrit": "विष्ववसेनो वायुपुत्रौ ह्यश्विनौ गणपस्तथा ।\nवित्तपः सप्त वसव उक्तो ह्याग्निस्तथाष्टमः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006110028, "chapter_id": 26110, "verse_number": "३-५-२९", "content_sanskrit": "सत्यानां शृणु नामानि द्रोणः प्राणो ध्रुवस्तथा ।\nअर्के दोषस्तथा वस्कः सप्तमस्तु विभावसुः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006110029, "chapter_id": 26110, "verse_number": "३-५-३०", "content_sanskrit": "दशरुद्रास्तथा ज्ञेया मूलरुद्रो भवः स्मृतः ।\nदश रुद्रस्य नामानि शृणुष्व द्विजसत्तम ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006110030, "chapter_id": 26110, "verse_number": "३-५-३१", "content_sanskrit": "रैवन्तेयस्तथा भीमो वामदेवो वृषाकपिः ।\nअजैकपादहिर्वुध्न्यो बहुरूपो महानिति ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006110031, "chapter_id": 26110, "verse_number": "३-५-३२", "content_sanskrit": "दश रुद्रा इति प्रोक्ताः षडादित्याञ्छृणु द्विज ।\nउरुक्रमस्तथा शक्रो विवस्वान्वरुणस्तथा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006110032, "chapter_id": 26110, "verse_number": "३-५-३३", "content_sanskrit": "पर्जन्योतिबाहुरेत उक्ताः पूर्वं द्विजोत्तम ।\nपर्जन्यव्यतिरिक्तास्तु पञ्चैवोक्ता न संशयः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006110033, "chapter_id": 26110, "verse_number": "३-५-३४", "content_sanskrit": "गङ्गासमस्तु पर्जन्य इति चोक्तः खगेश्वर ।\nसविता ह्यर्यमा धाता पूषा त्वष्टा तथा भगः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006110034, "chapter_id": 26110, "verse_number": "३-५-३५", "content_sanskrit": "चत्वारिंशत्तथा सप्त महतः परिकीर्तिताः ।\nद्वावुक्ताविति विज्ञेयो प्रवहोतिवहस्तथा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006110035, "chapter_id": 26110, "verse_number": "३-५-३६", "content_sanskrit": "तथा दशविधा ज्ञेया विश्वेदेवाः खगेश्वर ।\nशृणु नामानि तेषां तु पुरूरवार्द्रवसंज्ञकौ ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006110036, "chapter_id": 26110, "verse_number": "३-५-३७", "content_sanskrit": "धूरिलोचनसंज्ञौ द्वौ क्रतुदक्षेतिसंज्ञकौ ।\nद्वौ सत्यवसुसंज्ञौ च कामकालकसंज्ञकौ ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006110037, "chapter_id": 26110, "verse_number": "३-५-३८", "content_sanskrit": "एवं दशविधा ज्ञेया विश्वेदेवाः प्रकीर्तिताः ।\nतथा ऋभुगणश्चोक्तस्तथा च पितरस्त्रयः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006110038, "chapter_id": 26110, "verse_number": "३-५-३९", "content_sanskrit": "द्यावा पृथिव्यौ विज्ञेयौ एते च षडशीतयः ।\nदेवाः प्रजज्ञिरे सर्वे नासिकद्रियमानिनः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006110039, "chapter_id": 26110, "verse_number": "३-५-४०", "content_sanskrit": "आकाशस्याभिमानी तु गणपः सुदाहृतः ।\nउभयत्राभि मानीति ज्ञेयं तत्त्वार्थवेदिभिः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006110040, "chapter_id": 26110, "verse_number": "३-५-४१", "content_sanskrit": "विष्वक्सेनं विना सर्वे जयाद्या विष्णुपार्षदाः ।\nअभवन्समहीनाश्च विष्वक्सेनादनन्तरम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006110041, "chapter_id": 26110, "verse_number": "३-५-४२", "content_sanskrit": "एतेपि नासिकायाश्च अवान्तरनियामकाः ।\nअतस्ते तत्त्वमानिभ्यो ह्यवरास्ते प्रकीर्तिताः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006110042, "chapter_id": 26110, "verse_number": "३-५-४३", "content_sanskrit": "स्पर्शतत्त्वाभिमानी तु अपानश्चेत्युदाहृतः ।\nरूपाभिमानी संजज्ञे व्यानो नाम महान्प्रभो ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006110043, "chapter_id": 26110, "verse_number": "३-५-४४", "content_sanskrit": "रसात्मक उदानश्च समानो गन्धनामकः ।\nअपां नाथाश्च चत्वारो मरुतः परिकीर्तिताः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006110044, "chapter_id": 26110, "verse_number": "३-५-४५", "content_sanskrit": "जयाद्यनन्तरान्वक्ष्ये समुत्पन्नान्खगेश्वर ।\nप्रधानाग्रे प्रथमजः पावकः समुदाहृतः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006110045, "chapter_id": 26110, "verse_number": "३-५-४६", "content_sanskrit": "भृगोर्महर्षेः पुत्रश्च च्यवनः समुदाहृतः ।\nबृहस्पतेश्च पुत्रस्तु उतथ्यः परिकीर्तितः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006110046, "chapter_id": 26110, "verse_number": "३-५-४७", "content_sanskrit": "रैवतश्चाक्षुषश्चैव तथा स्वारोचिषः स्मृतः ।\nउत्तमो ब्रह्मसावर्णी रुद्रसावर्णिरेव च ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006110047, "chapter_id": 26110, "verse_number": "३-५-४८", "content_sanskrit": "देवसावर्णिसावर्णिरिन्द्रसावर्णिरेवच ।\nतथैव दक्षसावर्णिर्धर्मभावर्णिरेव च ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006110048, "chapter_id": 26110, "verse_number": "३-५-४९", "content_sanskrit": "एकादशविधा ह्येवं मनवः परिकीर्तिताः ।\nपितॄणां सप्तकं चैवेत्याद्याः संजज्ञिरे खग ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006110049, "chapter_id": 26110, "verse_number": "३-५-५०", "content_sanskrit": "तदनन्तरमुत्पन्नास्तेभ्यो नीचाः शृणु द्विज ।\nवरुणस्य पत्नी गङ्गा पर्जन्याख्यो विभावसुः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006110050, "chapter_id": 26110, "verse_number": "३-५-५१", "content_sanskrit": "यमभार्या श्यामला तु ह्यनिरुद्धप्रिया विराट् ।\nब्रह्माण्डमानिनी सैव ह्युषानाम्ना सुशब्दिता ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006110051, "chapter_id": 26110, "verse_number": "३-५-५२", "content_sanskrit": "रोहिणी चन्द्रभार्योक्ता सूर्यभार्या तु संज्ञका ।\nएता गङ्गादिषटूसंख्या जज्ञिरे विनतासुत ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006110052, "chapter_id": 26110, "verse_number": "३-५-५३", "content_sanskrit": "गङ्गाद्यनन्तरं जज्ञे स्वाहा वै मन्त्रदेवता ।\nस्वाहानामाग्निभार्योक्ता गङ्गादिभ्योधमा श्रुता ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006110053, "chapter_id": 26110, "verse_number": "३-५-५४", "content_sanskrit": "स्वाहानन्तरजो ज्ञेयो ज्ञानात्मा बुधनामकः ।\nबुधस्तु चन्द्रपुत्रो यः स्वाहाया अधमः स्मृतः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006110054, "chapter_id": 26110, "verse_number": "३-५-५५", "content_sanskrit": "उषा नाम तथा जज्ञे बुधस्यानन्तरं खग ।\nउषानामा भिमानी तु ह्यश्विभार्या प्रकीर्तिता ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006110055, "chapter_id": 26110, "verse_number": "३-५-५६", "content_sanskrit": "बुधाधमा सा विज्ञेया नात्र कार्या विचारणा ।\nततः शनैश्चरो जज्ञे पृथिव्यात्मेति विश्रुतः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006110056, "chapter_id": 26110, "verse_number": "३-५-५७", "content_sanskrit": "उषाधमस्तु विज्ञेयस्ततो जज्ञेथ पुष्करः ।\nकर्माभिमानी विज्ञेयः शनैश्चर इतीरितः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006110057, "chapter_id": 26110, "verse_number": "३-५-५८", "content_sanskrit": "तत्त्वाभिमानिनो देवानेवं सृष्ट्वा हरिः स्वयम् ।\nप्रविवेश स देवेशस्तत्त्वेषु रमया सहा ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]