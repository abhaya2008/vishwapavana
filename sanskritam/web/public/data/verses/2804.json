[{"id": 2084834, "chapter_id": 2804, "verse_number": "१२-३०९-०x", "content_sanskrit": "वसिष्ठ उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2084835, "chapter_id": 2804, "verse_number": "१२-३०९-१", "content_sanskrit": "एवमप्रतिबुद्धत्वादबुद्धमनुवर्तनात्।\nदेहाद्देहसहस्राणि तथा समभिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2084836, "chapter_id": 2804, "verse_number": "१२-३०९-२", "content_sanskrit": "तिर्यग्योनिसहस्रेषु कदाचिद्देवतास्वपि।\nउपपद्यति संयोगाद्गुणैः सह गुणक्षयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2084837, "chapter_id": 2804, "verse_number": "१२-३०९-३", "content_sanskrit": "मानुषत्वाद्दिवं याति दिवो मानुष्यमेति च।\nमानुष्यान्निरयस्थानमनन्तं प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2084838, "chapter_id": 2804, "verse_number": "१२-३०९-४", "content_sanskrit": "कोशकारो यथाऽऽत्मानं कीटः समनुरुन्धति।\nसूत्रतन्तुगुणैर्नित्यं तथाऽयमगुणो गुणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2084839, "chapter_id": 2804, "verse_number": "१२-३०९-५", "content_sanskrit": "द्वन्द्वमेति च निर्द्वन्द्वस्तासु तास्विह योनिषु।\nशीर्षरोगेऽक्षिरोगे च दन्तशूले गलग्रहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2084840, "chapter_id": 2804, "verse_number": "१२-३०९-६", "content_sanskrit": "जलोदरे तृषारोगे ज्वरगण्डे विषूचके।\nश्वित्रकुष्ठेऽग्निदग्धे च सिध्मापस्मारयोरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2084841, "chapter_id": 2804, "verse_number": "१२-३०९-७", "content_sanskrit": "यानि चान्यानि द्वन्द्वानि प्राकृतानि शरीरिषु।\nउत्पद्यन्ते विचित्राणि तान्येषोऽप्यभिमन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2084842, "chapter_id": 2804, "verse_number": "१२-३०९-८", "content_sanskrit": "अभिमन्यत्यभीमानात्तथैव सुकृतान्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2084843, "chapter_id": 2804, "verse_number": "१२-३०९-९", "content_sanskrit": "शुक्लवासाश्च दुर्वासाः शायी नित्यमधस्तथा।\nमण्डूकशायी च तथा वीरासनगतस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2084844, "chapter_id": 2804, "verse_number": "१२-३०९-१०", "content_sanskrit": "चीरधारणमाकाशे शयनं स्थानमेव च।\nइष्टकाप्रस्तरे चैव कण्टकप्रस्तरे तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2084845, "chapter_id": 2804, "verse_number": "१२-३०९-११", "content_sanskrit": "भस्मप्रस्तरशायी च भूमिशय्याऽनुलेपनः।\nवीरस्थानाम्बुपङ्के च शयनं फलकेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2084846, "chapter_id": 2804, "verse_number": "१२-३०९-१२", "content_sanskrit": "विविधासु च शय्यासु फलगृद्ध्यान्वितस्तथा।\nमुञ्जमेखलनग्नत्वं क्षौमकृष्णाजिनानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2084847, "chapter_id": 2804, "verse_number": "१२-३०९-१३", "content_sanskrit": "शणवालपरीधानो व्याघ्रचर्मपरिच्छदः।\nसिंहतचर्मपरीधानः पट्टवासास्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2084848, "chapter_id": 2804, "verse_number": "१२-३०९-१४", "content_sanskrit": "फलकपरिधानश्च तथा कण्टकवस्रधृत्।\nकीटकार्पासवसनश्चीरवासास्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2084849, "chapter_id": 2804, "verse_number": "१२-३०९-१५", "content_sanskrit": "वस्राणि चान्यानि बहून्यभिमन्यत्यबुद्धिमान्।\nभोजनानि विचित्राणि रत्नानि विविधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2084850, "chapter_id": 2804, "verse_number": "१२-३०९-१६", "content_sanskrit": "एकवस्रान्तराशित्वमेककालिकभोजनम्।\nचतुर्थाष्टमकालश्च षष्ठकालिक एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2084851, "chapter_id": 2804, "verse_number": "१२-३०९-१७", "content_sanskrit": "ष़ड्रात्रभोजनश्चैव तथैवाष्टाहभोजनः।\nसप्तरात्रदशाहारो द्वादशाहिकभोजनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2084852, "chapter_id": 2804, "verse_number": "१२-३०९-१८", "content_sanskrit": "मासोपवासी मूलाशी फलाहारस्तथैव च।\nवायुभक्षोऽम्बुपिण्याकदधिगोमयभोजनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2084853, "chapter_id": 2804, "verse_number": "१२-३०९-१९", "content_sanskrit": "गोमूत्रभोजनश्चैव शाकपुष्पाद एव च।\nशेवालभोजनश्चैव तथाऽऽचामेन वर्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2084854, "chapter_id": 2804, "verse_number": "१२-३०९-२०", "content_sanskrit": "वर्तयञ्शीर्णपर्मैश्च प्रकीर्णफलभोजनः।\nविविधानि च कृच्छ्राणि सेवते सिद्धिकाङ्क्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2084855, "chapter_id": 2804, "verse_number": "१२-३०९-२१", "content_sanskrit": "चान्द्रायणानि विधिवल्लिङ्गानि विविधानि च।\nचातुराश्रम्यपन्थानमाश्रयत्यपथानपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2084856, "chapter_id": 2804, "verse_number": "१२-३०९-२२", "content_sanskrit": "उपाश्रमानप्यपरान्पाषण्डान्विविधानपि।\nविविक्ताश्च शिलाच्छायास्तथा प्रस्रवणानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2084857, "chapter_id": 2804, "verse_number": "१२-३०९-२३", "content_sanskrit": "पुलिनानि विविक्तानि विविक्तानि वनानि च।\nदेवस्थानानि पुण्यानि विविक्तानि सरांसि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2084858, "chapter_id": 2804, "verse_number": "१२-३०९-२४", "content_sanskrit": "विविक्ताश्चापि शैलानां गुहा गृहनिभोपमाः।\nविविक्तानि च जप्यानि व्रतानि विविधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2084859, "chapter_id": 2804, "verse_number": "१२-३०९-२५", "content_sanskrit": "नियमान्विविधांश्चापि विविधानि तपांसि च।\nयज्ञांश्च विविधाकारान्विधींश्च विविधांस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2084860, "chapter_id": 2804, "verse_number": "१२-३०९-२६", "content_sanskrit": "वणिक्पथं द्विजक्षत्रं वैश्यं शूद्रांस्तथैव च।\nदानं च विविधाकारं दीनान्धकृपणादिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2084861, "chapter_id": 2804, "verse_number": "१२-३०९-२७", "content_sanskrit": "अभिमन्यत्यसंबोधात्तथैव त्रिविधान्गुणान्।\nसत्वं रजस्तमश्चैव धर्मार्थौ काम एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2084862, "chapter_id": 2804, "verse_number": "१२-३०९-२८", "content_sanskrit": "प्रकृत्याऽऽत्मानमेवात्मा एवं प्रवि भजत्युत।\nस्वधाकारवषट्कारौ स्वाहाकारनमस्क्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2084863, "chapter_id": 2804, "verse_number": "१२-३०९-२९", "content_sanskrit": "याजनाध्यापनं दानं तथैवाहुः प्रतिग्रहम्।\nयजनाध्ययने चैव यच्चान्यदपि किंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2084864, "chapter_id": 2804, "verse_number": "१२-३०९-३०", "content_sanskrit": "जन्ममृत्युविवादे च तथा विशसनेऽपि च।\nशुभाशुभमयं सर्वमेतदाहुः क्रियाफलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2084865, "chapter_id": 2804, "verse_number": "१२-३०९-३१", "content_sanskrit": "प्रकृतिः कुरुते देवी भवं प्रलयमेव च।\nदिवसान्ते गुणानेतानभ्येत्यैकोऽवतिष्ठते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2084866, "chapter_id": 2804, "verse_number": "१२-३०९-३२", "content_sanskrit": "रश्मिजालमिवादित्यस्तत्तत्काले नियच्छति।\nएवमेषोऽसकृत्सर्वं क्रीडार्थमभिमन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2084867, "chapter_id": 2804, "verse_number": "१२-३०९-३३", "content_sanskrit": "आत्मरूपगुणानेतान्विविधान्हृदयप्रियान्।\nएवमेव विकुर्वाणः सर्गप्रलयधर्मिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2084868, "chapter_id": 2804, "verse_number": "१२-३०९-३४", "content_sanskrit": "क्रियां क्रियापथे रक्तस्त्रिगुणांस्त्रिगुणाधिपः।\nक्रियां क्रियापथोपेतस्तथा तदभिमन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2084869, "chapter_id": 2804, "verse_number": "१२-३०९-३५", "content_sanskrit": "प्रकृत्या सर्वमेवेदं जगदन्धीकृतं विभो।\nरजसा तमसा चैव व्याप्तं सर्वमनेकधा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2084870, "chapter_id": 2804, "verse_number": "१२-३०९-३६", "content_sanskrit": "एवं द्वन्द्वान्यथैतानि वर्तन्ते मयि नित्यशः।\nममैवैतानि जायन्ते धावन्ते तानि मामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2084871, "chapter_id": 2804, "verse_number": "१२-३०९-३७", "content_sanskrit": "निस्तर्तव्यान्यथैतानि सर्वाणीति नराधिप।\nमन्यतेऽयं ह्यबुद्धित्वात्तथैव सुकृतान्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2084872, "chapter_id": 2804, "verse_number": "१२-३०९-३८", "content_sanskrit": "भोक्तव्यानि मयैतानि देवलोकगतेन वै।\nइहैव चैनं भोक्ष्यामि शुभाशुभफलोदयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2084873, "chapter_id": 2804, "verse_number": "१२-३०९-३९", "content_sanskrit": "पुण्यमेव तु कर्तव्यं तत्कुत्वा सुसुखं मम।\nयावदन्तं च मे सौख्यं जात्यां जात्यां भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2084874, "chapter_id": 2804, "verse_number": "१२-३०९-४०", "content_sanskrit": "भविष्यति च मे दुःखं कृतेनेहाप्यनन्तकम्।\nमहद्दुःखं हि मानुष्यं निरये चापि मज्जनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2084875, "chapter_id": 2804, "verse_number": "१२-३०९-४१", "content_sanskrit": "निरयाच्चापि मानुष्यं कालेनैष्याम्यहं पुनः।\nमनुष्यत्वाच्च देवत्वं देवत्वात्पौरुषं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2084876, "chapter_id": 2804, "verse_number": "१२-३०९-४२", "content_sanskrit": "मनुष्यत्वाच्च निरयं पर्यायेणोपगच्छति।\nय एवं वेत्ति नित्यं वै निरात्मात्मगुणैर्वृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2084877, "chapter_id": 2804, "verse_number": "१२-३०९-४३", "content_sanskrit": "तेन देवमनुष्येषु निरये चोपपद्यते।\nममत्वेनावृतो नित्यं तत्रैव परिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2084878, "chapter_id": 2804, "verse_number": "१२-३०९-४४", "content_sanskrit": "सर्गकोटिसहस्राणि मरणान्तासु योनिषु।\nय एवं कुरुते कर्म शुभाशुभफलात्मकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2084879, "chapter_id": 2804, "verse_number": "१२-३०९-४५", "content_sanskrit": "स एवं फलमाप्नोति त्रिषु लोकेषु मूर्तिमान्।\nप्रकृतिः कुरुते कर्म शुभाशुभफलात्मकम्।\nप्रकृतिश्च तदश्नाति त्रिषु लोकेषु कामगा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2084880, "chapter_id": 2804, "verse_number": "१२-३०९-४६", "content_sanskrit": "तिर्यग्योनिमनुष्यत्वे देवलोके तथैव च।\nत्रीणि स्थानानि चैतानि जानीयात्प्राकृतानिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2084881, "chapter_id": 2804, "verse_number": "१२-३०९-४७", "content_sanskrit": "अलिङ्गां प्रकृतिं त्वाहुर्लिङ्गैरनुमिमीमहे।\nतथैव पौरुषं लिङ्गमनुमानाद्धि गम्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2084882, "chapter_id": 2804, "verse_number": "१२-३०९-४८", "content_sanskrit": "स लिङ्गान्तरमासाद्य प्राकृतं लिङ्गमव्रणम्।\nव्रणद्वाराण्यधिष्ठाय कर्मणाऽऽत्मनि पश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2084883, "chapter_id": 2804, "verse_number": "१२-३०९-४९", "content_sanskrit": "श्रोत्रादीनि तु सर्वाणि पञ्च कर्मेन्द्रियाण्यथ।\nवागादीनि प्रवर्तन्ते गुणेष्विह गुणैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2084884, "chapter_id": 2804, "verse_number": "१२-३०९-५०", "content_sanskrit": "अहमेतानि वै सर्वं मय्येतानीन्द्रियाणि ह।\nनिरिन्द्रियो हि मन्तेत व्रणवानस्मि निर्व्रणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2084885, "chapter_id": 2804, "verse_number": "१२-३०९-५१", "content_sanskrit": "अलिङ्गो लिङ्गमात्मानमकालः कालमात्मनः।\nअसत्वं सत्वमात्मानमतत्त्वं तत्त्वमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2084886, "chapter_id": 2804, "verse_number": "१२-३०९-५२", "content_sanskrit": "अमृत्युर्मृत्युमात्मानमचरश्चरमात्मनः।\nअक्षेत्रः क्षेत्रमात्मानमसर्गः सर्गमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2084887, "chapter_id": 2804, "verse_number": "१२-३०९-५३", "content_sanskrit": "अतपास्तप आत्मानमगतिर्गतिमात्मनः।\nअभवो भवमात्मानमभयो भयमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2084888, "chapter_id": 2804, "verse_number": "१२-३०९-५४", "content_sanskrit": "`अकर्ता कर्तृ चात्मानमबीजो बीजमात्मनः।\nअक्षरः क्षरमात्मानमबुद्धिस्त्वभिमन्यते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2084889, "chapter_id": 2804, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि नवाधिकत्रिशततमोऽध्यायः॥ ३०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]