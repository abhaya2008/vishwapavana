[{"id": 2115476, "chapter_id": 3486, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2115477, "chapter_id": 3486, "verse_number": "१", "content_sanskrit": "प्रतिज्ञातेऽथ भीमेन करिष्यामीति भारत ।\nआजग्मुः सहिताः सर्वे भैक्षमादाय पाण्डवाः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2115478, "chapter_id": 3486, "verse_number": "२", "content_sanskrit": "भीमसेनं ततो दृष्ट्वा आघूर्ण्णवदनं तथा ।\nबुबोध धर्मराजस्तु हृषितं भीममच्युतम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2115479, "chapter_id": 3486, "verse_number": "३", "content_sanskrit": "हर्षितुं कारणं यत् तन्मनसाऽचिन्तयद् गुरुः ।\nप्रसमीक्ष्य तदा राजन् श्रोतुकामो विशाम्पतिः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2115480, "chapter_id": 3486, "verse_number": "४", "content_sanskrit": "आकारेणैव तं ज्ञात्वा पाण्डुपुत्रो युधिष्ठिरः ।\nरहः समुपविश्यैकः ततः पप्रच्छ मातरम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2115481, "chapter_id": 3486, "verse_number": "५", "content_sanskrit": "किं चिकीर्षत्ययं कर्म भीमो भीमपराक्रमः ।\nभवत्यनुमते कच्चित् स्वयं कर्तुमिहेच्छति \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2115482, "chapter_id": 3486, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2115483, "chapter_id": 3486, "verse_number": "६", "content_sanskrit": "ममैव वचनादेव करिष्यति परन्तपः ।\nब्राह्मणार्थे महत् कृत्यं मोक्षाय नगरस्य च \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2115484, "chapter_id": 3486, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2115485, "chapter_id": 3486, "verse_number": "७", "content_sanskrit": "किमिदं साहसं तीक्ष्णं भवत्या दुष्करं कृतम् ।\nपरित्यागं हि पुत्रस्य न प्रशंसन्ति साधवः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2115486, "chapter_id": 3486, "verse_number": "८", "content_sanskrit": "कथं परसुतस्यार्थे स्वपुत्रं त्यक्तुमर्हसि ।\nलोकवृत्तविरुद्धं च पुत्रत्यागः कृतस्त्वया \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2115487, "chapter_id": 3486, "verse_number": "९", "content_sanskrit": "यस्य विक्रममाश्रित्य सुखं सर्वे स्वपामहे ।\nराज्यं चापहृतं क्षुद्रैराजिहीर्षामहे पुनः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2115488, "chapter_id": 3486, "verse_number": "१०", "content_sanskrit": "यस्य दुर्योधनो वीर्यं चिन्तयन्नमितौजसः ।\nन शेते वसतीः सर्वा दुःखाच्छकुनिना सह \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2115489, "chapter_id": 3486, "verse_number": "११", "content_sanskrit": "यस्य वीरस्य वीर्येण मुक्ता जतुगृहाद् वयम् ।\nअन्येभ्यश्चैव पापेभ्यो निहतश्च पुरोचनः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2115490, "chapter_id": 3486, "verse_number": "१२", "content_sanskrit": "यस्य बाहू समाश्रित्य वसुपूर्णां वसुन्धराम् ।\nइमां मन्यामहे प्राप्तां निहत्य धृतराष्ट्रजान् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2115491, "chapter_id": 3486, "verse_number": "१३", "content_sanskrit": "तस्य व्यवसितस्त्यागो बुद्धिमास्थाय कां त्वया ।\nकच्चिन्नु दुःखैर्बुद्धिस्ते विप्लुता गतचेतसः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2115492, "chapter_id": 3486, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2115493, "chapter_id": 3486, "verse_number": "१४", "content_sanskrit": "युधिष्ठिर न सन्तापः कार्यः प्रति वृकोदरम् ।\nन चायं बुद्धिदौर्बल्याद् व्यवसायः कृतो मया\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2115494, "chapter_id": 3486, "verse_number": "१५", "content_sanskrit": "न च शोकेन बुद्धिर्मे विप्लुता गतचेतना ।\nइह विप्रस्य भवने वयं पुत्र सुखोषिताः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2115495, "chapter_id": 3486, "verse_number": "१६", "content_sanskrit": "तस्य प्रतिक्रिया तात मयैषा प्रसमीक्षिता ।\nएतावानेव पुरुषः कृतं यस्मिन्न नश्यति \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2115496, "chapter_id": 3486, "verse_number": "१७", "content_sanskrit": "यावच्च कुर्यादन्योऽस्य कुर्याद् बहुगुणं ततः ।\nब्राह्मणार्थे महाधर्मं जानीतार्थं वृकोदरे \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2115497, "chapter_id": 3486, "verse_number": "१८", "content_sanskrit": "दृष्ट्वा वीरस्य विक्रान्तं तदा जतुगृहे महत् ।\nहिडिम्बस्य वधाच्चैवं विश्वासोऽयं वृकोदरे \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2115498, "chapter_id": 3486, "verse_number": "१९", "content_sanskrit": "बाह्वोर्बलं हि भीमस्य नागायुतसमं महत् ।\nयेन यूयं गजप्रख्या निर्व्यूढा वारणावतात् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2115499, "chapter_id": 3486, "verse_number": "२०", "content_sanskrit": "वृकोदरबलश्चान्यो न जातो न जनिष्यति ।\nयोऽभ्युदीयाद् युधि श्रेष्ठमपि वज्रधरं स्वयम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2115500, "chapter_id": 3486, "verse_number": "२१", "content_sanskrit": "जातमात्रः पुरा चैव ममाङ्कात् पतितो गिरौ ।\nशरीरगौरवाद् यस्य शिला गात्रैर्विचूर्णिता\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2115501, "chapter_id": 3486, "verse_number": "२२", "content_sanskrit": "तदहं प्रज्ञया ज्ञात्वा बलं भीमस्य पाण्डव ।\nप्रतिकारे च विप्रस्य ततः कृतवती मतिम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2115502, "chapter_id": 3486, "verse_number": "२३", "content_sanskrit": "न च मोहान्न चाज्ञानान्न च लोभान्न च भ्रमात् ।\nइदं व्यवसितं वीर बुद्धिपूर्वमिदं कृतम् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2115503, "chapter_id": 3486, "verse_number": "२४", "content_sanskrit": "अर्थौ द्वावपि निर्वृत्तौ युधिष्ठिर भविष्यतः ।\nप्रतिकारश्च वासस्य धर्मश्च चरितो महान् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2115504, "chapter_id": 3486, "verse_number": "२५", "content_sanskrit": "यो ब्राह्मणस्य साहाय्यं कुर्यादर्थेषु केषुचित् ।\nक्षत्रियः स शुभाँल्लोकानाप्नुयादिति निश्चितम् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2115505, "chapter_id": 3486, "verse_number": "२६", "content_sanskrit": "क्षत्रियः क्षत्रियस्यैव कुर्वाणो वधमोक्षणम् ।\nविपुलां कीर्तिमाप्नोति लोकेऽस्मिंश्च परत्र च \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2115506, "chapter_id": 3486, "verse_number": "२७", "content_sanskrit": "वैश्यस्यैव च साहाय्यं कुर्वाणः क्षत्रियो युधि ।\nस सर्वेष्वपि लोकेषु प्रजा रञ्जयते ध्रुवम् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2115507, "chapter_id": 3486, "verse_number": "२८", "content_sanskrit": "शूद्रं तु मोक्षयन् पुत्र उद्विग्नं शरणार्थिनम् ।\nप्राप्नोतीह कुले जन्म सद्रव्ये राजसत्कृते \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2115508, "chapter_id": 3486, "verse_number": "२९", "content_sanskrit": "एवं हि भगवान् व्यासः पुरा कौरवनन्दन ।\nप्रोवाच सुतरां प्राज्ञ तस्मादेतच्चिकीर्षितम् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2115509, "chapter_id": 3486, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2115510, "chapter_id": 3486, "verse_number": "३०", "content_sanskrit": "उपपन्नमिदं मातस्त्वया सद्बुद्धिपूर्वकम् ।\nआर्तस्य ब्राह्मणस्यैवमनुक्रोशादिदं कृतम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2115511, "chapter_id": 3486, "verse_number": "३१", "content_sanskrit": "ध्रुवमेष महाबाहुर्विजित्य पुरुषादकम् ।\nआगन्ता नगरं चैव तस्मात् पापाद् विमोक्ष्यते \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2115512, "chapter_id": 3486, "verse_number": "३२", "content_sanskrit": "यथा चैव न नो विद्युर्नरा नगरवासिनः ।\nतथाऽयं ब्राह्मणो वाच्यः परिगृह्य च यत्नतः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2115513, "chapter_id": 3486, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2115514, "chapter_id": 3486, "verse_number": "३३", "content_sanskrit": "युधिष्ठिरेण सम्मन्त्र्य ब्राह्मणार्थमरिन्दम ।\nकुन्ती प्रविश्य तान् सर्वान् सान्त्वयामास भारत\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2115515, "chapter_id": 3486, "verse_number": "३४", "content_sanskrit": "अथ रात्र्यां व्यतीतायां भीमसेनो महाबलः ।\nब्राह्मणं समुपागम्य वाक्यमेतदुवाच ह \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2115516, "chapter_id": 3486, "verse_number": "३५", "content_sanskrit": "आपदस्त्वां प्रमुच्येयं सपुत्रं ब्राह्मण प्रियम् ।\nमा भैषी राक्षसात् तस्मान्मां ददातु बलिं भवान् \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2115517, "chapter_id": 3486, "verse_number": "३६", "content_sanskrit": "इह मामशितं कर्तुं प्रयतस्व भवद्गृहे ।\nअथात्मानं प्रदास्यामि तस्मै घोराय रक्षसे \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2115518, "chapter_id": 3486, "verse_number": "३७", "content_sanskrit": "त्वरध्वं किं विलम्बध्वं मा चिरं कुरुतानघाः ।\nव्यवस्येयं मम प्राणैर्युष्मान् रक्षितुमद्य वै\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2115519, "chapter_id": 3486, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2115520, "chapter_id": 3486, "verse_number": "३८", "content_sanskrit": "एवमुक्तस्तु भीमेन ब्राह्मणो भरतर्षभ ।\nसुहृदां तत् समाख्याय ददावन्नं सुसंस्कृतम् \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2115521, "chapter_id": 3486, "verse_number": "३९", "content_sanskrit": "पिशितोदनमाजह्रुरथास्मै पुरवासिनः ।\nसघृतं सोपदंशं च सूपैर्नानाविधैः सह \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2115522, "chapter_id": 3486, "verse_number": "४०", "content_sanskrit": "तदाऽशित्वा भीमसेनो मांसानि विविधानि च ।\nमोदकानि च मुख्यानि चित्रोदनचयान् बहून्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2115523, "chapter_id": 3486, "verse_number": "४१", "content_sanskrit": "ततोऽपिबद् दधिघटान् सुबहून् द्रोणसम्मितान् ।\nतस्य भुक्तवतः पौरा यथार्हं समुपार्जितम् \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2115524, "chapter_id": 3486, "verse_number": "४२", "content_sanskrit": "उपजह्रुर्भूतभागं समृद्धं सर्वसम्पदा ।\nततो रात्र्यां व्यतीतायां सव्यञ्जनदधिप्लुतम् \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2115525, "chapter_id": 3486, "verse_number": "४३", "content_sanskrit": "समारुह्यान्नसम्पूर्णं शकटं स वृकोदरः ।\nप्रययौ तूर्यनिर्घोषैः पौरैश्च परिवारितः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2115526, "chapter_id": 3486, "verse_number": "४४", "content_sanskrit": "आत्मानमेषोऽन्नभूतो राक्षसाय प्रदास्यति ।\nतरुणोऽप्रतिरूपश्च दृढमौदारिको युवा१\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2115527, "chapter_id": 3486, "verse_number": "४५", "content_sanskrit": "वाग्भिरेवंप्रकाराभिः स्तूयमानो वृकोदरः ।\nचुचोद स बलीवर्दौ युक्तौ चाङ्गारकाळकौ \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2115528, "chapter_id": 3486, "verse_number": "४६", "content_sanskrit": "वादित्राणां प्रणादेन ततस्तं पुरुषादकम् ।\nअभ्यागच्छत् सुसंहृष्टः स तत्र मनुजैर्वृतः \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2115529, "chapter_id": 3486, "verse_number": "४७", "content_sanskrit": "सम्प्राप्य स च तं देशमेकाकी समुपाययौ ।\nपुरुषादभयाद् भीतः तत्रैवासीज्जनव्रजः \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2115530, "chapter_id": 3486, "verse_number": "४८", "content_sanskrit": "स गत्वा दीर्घमध्वानं दक्षिणामभितो दिशम् ।\nयथोपदिष्टमुद्देशे ददर्श विपुलं द्रुमम् \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2115531, "chapter_id": 3486, "verse_number": "४९", "content_sanskrit": "केशास्थिमज्जामेदोभिर्बाहूरुचरणैरपि ।\nआर्द्रैः शुष्कैश्च सङ्कीर्णमभितोऽथ वनस्पतिम् \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2115532, "chapter_id": 3486, "verse_number": "५०", "content_sanskrit": "गृध्रकङ्कवळच्छन्नं गोमायुकुलसङ्कुलम् ।\nउग्रगन्धमचक्षुष्यं श्मशानमिव दारुणम् \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2115533, "chapter_id": 3486, "verse_number": "५१", "content_sanskrit": "तं प्रविश्य महावृक्षं चिन्तयामास वीर्यवान् ।\nयावन्न दृश्यते रक्षो बकस्तु बलदर्पितः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2115534, "chapter_id": 3486, "verse_number": "५२", "content_sanskrit": "रुचिरं विविधैर्भोज्यैरन्नैर्गिरिनिभैरिदम् ।\nशकटं सूपसम्पूर्णं यावद् द्रक्ष्यति राक्षसः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2115535, "chapter_id": 3486, "verse_number": "५३", "content_sanskrit": "तावदेव प्रभोक्ष्येऽहं दुर्लभं वै पुनर्भवेत् ।\nविप्रकीर्येत सर्वं हि प्रयुद्धे मयि रक्षसा \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2115536, "chapter_id": 3486, "verse_number": "५४", "content_sanskrit": "अभोज्यं च शवं स्पृष्ट्वा निगृहीते बके भवेत् ।\nस त्वेवं भीमकर्मा तु भीमसेनोऽभिलक्ष्य च \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2115537, "chapter_id": 3486, "verse_number": "५५", "content_sanskrit": "उपविष्टः शनैरन्नं भुङ्क्ते स्म परमं वरम् ।\nतं ततः सर्वतोऽपश्यन् द्रुमानारुह्य नागराः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2115538, "chapter_id": 3486, "verse_number": "५६", "content_sanskrit": "नारक्षो बलिमश्नीयादेवं बहु च मानवाः ।\nभुङ्क्ते ब्राह्मणरूपेण बकोऽयमिति चाब्रुवन्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2115539, "chapter_id": 3486, "verse_number": "५७", "content_sanskrit": "स तं हसति तेजस्वी तदन्नमुपयोजयन् ।\nआसाद्य च वनं तस्य रक्षसः पाण्डवो बली\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2115540, "chapter_id": 3486, "verse_number": "५८", "content_sanskrit": "आजुहाव ततो नाम्ना तदन्नमुपयोजयन् ।\nततः स राक्षसः श्रुत्वा भीमसेनस्य तद्वचः \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2115541, "chapter_id": 3486, "verse_number": "५९", "content_sanskrit": "आजगाम सुसङ्क्रुद्धो यत्र भीमो व्यवस्थितः ।\nमहाकायो महावेगो दारयन्निव मेदिनीम्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2115542, "chapter_id": 3486, "verse_number": "६०", "content_sanskrit": "त्रिशिखां भ्रुकुटिं कृत्वा सन्दश्य दशनच्छदम् ।\nभुञ्जानमन्नं तं दृष्ट्वा भीमसेनं स राक्षसः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2115543, "chapter_id": 3486, "verse_number": "६१", "content_sanskrit": "विवृत्य नेत्रे सङ्क्रुद्ध इदं वचनमब्रवीत् ।\nकोऽयमन्नमिदं भुङ्क्ते मदर्थं समुपाहृतम् ।\nपश्यतो मम दुर्बुद्धिर्यियासुर्यमसादनम् \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2115544, "chapter_id": 3486, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2115545, "chapter_id": 3486, "verse_number": "६२", "content_sanskrit": "भीमसेनस्तु तच्छ्रुत्वा प्रहसन्निव भारत ।\nराक्षसं तमनादृत्य भुङ्क्त एव पराङ्मुखः \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2115546, "chapter_id": 3486, "verse_number": "६३", "content_sanskrit": "ततः स भैरवं कृत्वा समुद्यम्य करावुभौ ।\nअभ्यद्रवद् भीमसेनं जिघांसुः पुरुषादकः \t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2115547, "chapter_id": 3486, "verse_number": "६४", "content_sanskrit": "तथाऽपि परिभूयैनं नेक्षमाणो वृकोदरः ।\nराक्षसं भुङ्क्त एवान्नं पाण्डवः परवीरहा \t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2115548, "chapter_id": 3486, "verse_number": "६५", "content_sanskrit": "अमर्षेण तु सम्पूर्णः कुन्तीपुत्रस्य राक्षसः ।\nजघान पृष्ठे पाणिभ्यामुभाभ्यां पृष्ठतः स्थितः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2115549, "chapter_id": 3486, "verse_number": "६६", "content_sanskrit": "तथा बलवता भीमः पाणिभ्यां भृशमाहतः ।\nनैवावलोकयामास भुङ्क्त एव पराङ्मुखः \t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2115550, "chapter_id": 3486, "verse_number": "६७", "content_sanskrit": "ततः स भूयः सङ्क्रुद्धो वृक्षमादाय राक्षसः ।\nताडयष्यिंस्तदा भीमं पुनरभ्यद्रवद् बली \t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2115551, "chapter_id": 3486, "verse_number": "६८", "content_sanskrit": "न्यस्तं क्रुद्धेन तं वृक्षं प्रतिजग्राह वीर्यवान् ।\nसव्येन पाणिना भीमो दक्षिणेनापि भुक्तवान् \t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2115552, "chapter_id": 3486, "verse_number": "६९", "content_sanskrit": "ततो भीमः शनैर्भुक्त्वा तदन्नं पुरुषर्षभ ।\nवार्युपस्पृश्य संहृष्टः तस्थौ गिरिरिवाचलः \t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2115553, "chapter_id": 3486, "verse_number": "७०", "content_sanskrit": "भुजवेगं तथाऽऽस्फोटं क्ष्वेलितं च महास्वनम् ।\nकृत्वाऽऽह्वयत सङ्क्रुद्धो भीमसेनोऽथ राक्षसम्\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2115554, "chapter_id": 3486, "verse_number": "", "content_sanskrit": "भीमसेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2115555, "chapter_id": 3486, "verse_number": "७१", "content_sanskrit": "बहुकालं सुपुष्टं ते शरीरं राक्षसाधम ।\nमद्बाहुबलमाश्रित्य न त्वं भूयो भविष्यसि\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2115556, "chapter_id": 3486, "verse_number": "७२", "content_sanskrit": "अद्यप्रभृति स्वप्स्यन्ति वेत्रकीयनिवासिनः ।\nनिरुद्विग्नाः पुरस्यास्य कण्टके सूद्धृते मया \t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2115557, "chapter_id": 3486, "verse_number": "७३", "content_sanskrit": "अद्य युद्धे शरीरं ते कङ्कगोमायुवायसाः ।\nमया हतस्य खादन्तु विकुर्वन्तु च भूतळे \t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2115558, "chapter_id": 3486, "verse_number": "१६५", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nपञ्चषष्ठ्यधिकशततमोऽध्यायः ॥१६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2115559, "chapter_id": 3486, "verse_number": "६", "content_sanskrit": "॥ इति बकवधपर्वणि षष्ठोऽध्यायः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2115560, "chapter_id": 3486, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}]