[{"id": 2120051, "chapter_id": 3580, "verse_number": "", "content_sanskrit": "वासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2120052, "chapter_id": 3580, "verse_number": "१", "content_sanskrit": "एष पार्थ महाबाहो पशुमान् नित्यमम्बुमान् ।\nअनामयः सुवेश्माढ्यो निवेशो मागधः शुभः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2120053, "chapter_id": 3580, "verse_number": "२", "content_sanskrit": "वैहारो विपुलः शैलो वाराहो विपुळस्तथा ।\nतथा वर्षगिरिस्तात शुभाश्चैत्यकपञ्चमाः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2120054, "chapter_id": 3580, "verse_number": "३", "content_sanskrit": "एते पञ्च महाशृङ्गाः पर्वताः शीतळद्रुमाः ।\nरक्षन्ति चाभिसंहत्य संहताश्च गिरिव्रजम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2120055, "chapter_id": 3580, "verse_number": "४", "content_sanskrit": "पुष्पवेष्टितशाखाग्रैर्गन्धवद्भिर्मनोरमैः ।\nनिगूढा इव लोध्राणां वनैः कामिजनप्रियैः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2120056, "chapter_id": 3580, "verse_number": "५", "content_sanskrit": "यत्र दीर्घतमा नाम ऋषिः परमयन्त्रितः ।\nसमुत्पन्नश्च शूद्रायां गौतमः संशितव्रतः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2120057, "chapter_id": 3580, "verse_number": "६", "content_sanskrit": "औशीनर्यामजनयत् पुत्रान् काक्षीवदादिकान् ।\nगौतमस्य क्षयादस्मादथासीदत्र सद्मनि\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2120058, "chapter_id": 3580, "verse_number": "७", "content_sanskrit": "भजते मागधं वंशं स नृपाणामनुग्रहात् ।\nअङ्गवङ्गादयश्चैव भूमिपाः सुमहाबलाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2120059, "chapter_id": 3580, "verse_number": "८", "content_sanskrit": "गौतमक्षयमेत्यात्र रमन्ते स्म सहार्जुन ।\nवनराजीस्तु पश्येमाः प्रियालानां मनोरमाः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2120060, "chapter_id": 3580, "verse_number": "९", "content_sanskrit": "लोध्राणां च शुभाः पार्थ राजी राजीवलोचन ।\nपुन्नागानां शुभास्तत्र गौतमौकस्समीपतः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2120061, "chapter_id": 3580, "verse_number": "१०", "content_sanskrit": "अर्बुदः शक्रवापी च पन्नगौ शत्रुतापनौ ।\nस्वस्तिकस्यालयश्चात्र मणिनागस्य चोत्तमः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2120062, "chapter_id": 3580, "verse_number": "११", "content_sanskrit": "स पारिहार्यो मेध्यानां मागधोऽयं मणेः कृते ।\nशेषजश्च मणिश्चैव कृतवन्तावनुग्रहम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2120063, "chapter_id": 3580, "verse_number": "१२", "content_sanskrit": "पाण्डरे विपुळे चैव तथा वाराहकेऽपि च ।\nचैत्यके च गिरिश्रेष्ठे मातङ्गे च शिलोच्चये\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2120064, "chapter_id": 3580, "verse_number": "१३", "content_sanskrit": "एतेषु पर्वतेन्द्रेषु क्रीडन्त्यप्सरसस्तथा ।\nयतीनामाश्रमाश्चैव मुनीनां च महात्मनाम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2120065, "chapter_id": 3580, "verse_number": "१४", "content_sanskrit": "वृषभस्य तमालस्य महावीर्यस्य वै तथा ।\nगन्धर्वरक्षसां चैव नागानां च तथाऽऽलयाः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2120066, "chapter_id": 3580, "verse_number": "१५", "content_sanskrit": "काक्षीवतस्तपोवीर्यात् तपोदा इति विश्रुताः ।\nपुण्यतीर्थाश्च ते सर्वे नराणां पुण्यदायिनः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2120067, "chapter_id": 3580, "verse_number": "१६", "content_sanskrit": "अर्थसिद्धिं त्वनपगां जरासन्धो हि मन्यते ।\nवयमासादने तस्य दर्पमस्यापहन्महि\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2120068, "chapter_id": 3580, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2120069, "chapter_id": 3580, "verse_number": "१७", "content_sanskrit": "एवमुक्त्वा ततः सर्वे भ्रातरौ विपुळौजसौ ।\nकृष्णश्च पाण्डवेयौ च प्रतस्थुर्मागधं पुरम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2120070, "chapter_id": 3580, "verse_number": "१८", "content_sanskrit": "हृष्टपुष्टजनोपेतं चातुर्वर्ण्यजनाकुलम् ।\nस्फीतोत्सवमनाधृष्यमासेदुस्ते गिरिव्रजम् ।\nते च द्वारमनासाद्य पुरस्य गिरिमुच्छ्रिताम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2120071, "chapter_id": 3580, "verse_number": "१९", "content_sanskrit": "बार्हद्रथैः पूज्यमानं तथा नगरवासिभिः ।\nयत्र माषादवृषभमाससाद बृहद्रथः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2120072, "chapter_id": 3580, "verse_number": "२०", "content_sanskrit": "तं हत्वा माषनाळांश्च तिस्रो भेरीश्चकार ह ।\nआनह्य चर्मणा तेन स्थापयामास वै पुरे\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2120073, "chapter_id": 3580, "verse_number": "२१", "content_sanskrit": "यत्र ताः प्राणदन् भेर्यो दिव्यपुष्पाभिपूजिताः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2120074, "chapter_id": 3580, "verse_number": "२२", "content_sanskrit": "मागधानां सुरुचिरं चैत्यं कान्तं महाद्रुमम् ।\nशिरसीव जिघांसन्तो जरासन्धं जिघांसवः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2120075, "chapter_id": 3580, "verse_number": "२३", "content_sanskrit": "गिरिं सुविपुलशृङ्गं सुमहान्तं पुरातनम् ।\nअर्चितं माल्यदामैश्च सततं सुप्रतिष्ठितम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2120076, "chapter_id": 3580, "verse_number": "२४", "content_sanskrit": "विपुलैर्बाहुभिर्वीरास्तेऽभिहत्याभ्यपातयन् ।\nततस्ते मागधं द्रष्टुं हृष्टाः प्रविविशुस्तदा\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2120077, "chapter_id": 3580, "verse_number": "२५", "content_sanskrit": "दृष्ट्वा तु दुर्निमित्तं तं ब्राह्मणा वेदपारगाः ।\nएतस्मिन्नेव काले तु जरासन्धं समर्चयन् ।\nपर्यग्नि कुर्वन् नृपतिं द्विरदस्थं पुरोहिताः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2120078, "chapter_id": 3580, "verse_number": "२६", "content_sanskrit": "स्नातकव्रतिनस्ते तु बाहुशस्त्रा निरायुधाः ।\nयुयुत्सवः प्रविविशुर्जरासन्धेन भारत\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2120079, "chapter_id": 3580, "verse_number": "२७", "content_sanskrit": "भक्ष्यमाल्यापणानां च ददृशुः श्रियमुत्तमाम् ।\nस्फीतां सर्वगुणोपेतां सर्वकामसमृद्धिनीम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2120080, "chapter_id": 3580, "verse_number": "२८", "content_sanskrit": "तां तु दृष्ट्वा समृद्धिं ते वीथ्यां तस्यां नरोत्तमाः ।\nराजमार्गेण गच्छन्तः कृष्णभीमधनञ्जयाः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2120081, "chapter_id": 3580, "verse_number": "२९", "content_sanskrit": "गृह्य माल्यापणान्माल्यं बलाद् बलवतां वराः ।\nकर्पूरशृङ्गं कोष्ठं च सफलं चान्तरापणे\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2120082, "chapter_id": 3580, "verse_number": "३०", "content_sanskrit": "वैश्याद् बलाद् गृहीत्वा ते विहृत्य च महाबलाः ।\nविरागवसनाः सर्वे स्रग्विणो मृष्टकुण्डलाः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2120083, "chapter_id": 3580, "verse_number": "३१", "content_sanskrit": "निवेशनमथाजग्मुर्जरासन्धस्य धीमतः ।\nगोवाटमिव वीक्षन्तः सिंहा हैमवता यथा\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2120084, "chapter_id": 3580, "verse_number": "३२", "content_sanskrit": "शैलस्तम्भनिभास्तेषां चन्दनागुरुरूषिताः ।\nअशोभन्त महाराज बाहवः परिघोपमाः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2120085, "chapter_id": 3580, "verse_number": "३३", "content_sanskrit": "तान् दृष्ट्वा द्विरदप्रख्यान् सालस्कन्धानिवोद्गतान् ।\nव्यूढोरस्कान् मागधानां विस्मयः समपद्यत\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2120086, "chapter_id": 3580, "verse_number": "३४", "content_sanskrit": "अद्वारेणाभ्यवस्कन्द्य विविशुर्मागधालयम् ।\nते त्वतीत्य जनाकीर्णाः कक्ष्यास्तिस्रो नरर्षभाः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2120087, "chapter_id": 3580, "verse_number": "३५", "content_sanskrit": "अद्वारेणैव राजानमुपतस्थुर्महाबलाः ।\nभोशब्देनैव राजानमूचुस्ते तु महारथाः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2120088, "chapter_id": 3580, "verse_number": "३६", "content_sanskrit": "तान् पाद्यमधुपर्कार्हान् दृष्ट्वार्हान् गृहमागतान् ।\nप्रत्युत्थाय जरासन्ध उपतस्थे यथाविधि\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2120089, "chapter_id": 3580, "verse_number": "३७", "content_sanskrit": "उवाच चैतान् राजाऽसौ स्वागतं वोऽस्त्विति प्रभुः ।\nतस्य ह्येतद् व्रतं राजन् बभूव किल विश्रुतम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2120090, "chapter_id": 3580, "verse_number": "३८", "content_sanskrit": "स्नातकान् ब्राह्मणान् राजा श्रुत्वा स समितिञ्जयः ।\nअप्यर्धरात्रे नृपतिः प्रत्युद्गच्छति भारत\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2120091, "chapter_id": 3580, "verse_number": "३९", "content_sanskrit": "तांस्त्वपूर्वेण वेषेण दृष्ट्वा नृपतिसत्तमः ।\nउपतस्थे जरासन्धो विस्मितश्चाभवत् तदा\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2120092, "chapter_id": 3580, "verse_number": "४०", "content_sanskrit": "ते तु दृष्ट्वैव राजानं जरासन्धं नरर्षभाः ।\nइदमूचुरमित्रघ्नाः सर्वे भरतसत्तम\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2120093, "chapter_id": 3580, "verse_number": "४१", "content_sanskrit": "स्वस्त्यस्तु कुशलं राजन्नित्युक्त्वा ते व्यवस्थिताः ।\nतं नृपं पुरुषव्याघ्रा विप्रैक्षन्त परस्परम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2120094, "chapter_id": 3580, "verse_number": "४२", "content_sanskrit": "तानब्रवीज्जरासन्धः तदा यादवपाण्डवान् ।\nआस्यतामिति राजेन्द्रो ब्राह्मणच्छद्मसंवृतान्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2120095, "chapter_id": 3580, "verse_number": "४३", "content_sanskrit": "अथोपविविशुः सर्वे त्रयस्ते पुरुषर्षभाः ।\nसम्प्रदीप्तास्त्रयो लक्ष्म्या महाध्वर इवाग्नयः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2120096, "chapter_id": 3580, "verse_number": "४४", "content_sanskrit": "तानुवाच जरासन्धः सत्यसन्धो नराधिपः ।\nविगर्हमाणः कौरव्य वेषग्रहणकारिणः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2120097, "chapter_id": 3580, "verse_number": "४५", "content_sanskrit": "न स्नातकव्रता विप्रा बहिर्माल्यानुलेपनाः ।\nभवन्तीति नृलोकेऽस्मिन् विदितं मम सर्वशः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2120098, "chapter_id": 3580, "verse_number": "४६", "content_sanskrit": "ते यूयं पुष्पवन्तश्च भुजैर्ज्याघातलक्षणैः ।\nबिभ्रतः क्षात्रमोजश्च ब्राह्मण्यं प्रतिजानथ\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2120099, "chapter_id": 3580, "verse_number": "४७", "content_sanskrit": "एवं विरागवसना बाहुमाल्यानुलेपनाः ।\nक्षत्रिया एव लोकेऽस्मिन् विदिता मम सर्वशः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2120100, "chapter_id": 3580, "verse_number": "४८", "content_sanskrit": "सत्यं वदत के यूयं सत्यं राजसु शोभते\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2120101, "chapter_id": 3580, "verse_number": "४९", "content_sanskrit": "चैत्यकं च गिरेः शृङ्गं भित्त्वा किं मम सद्मनि ।\nअद्वारेण प्रविष्टाः स्थ निर्भया राजकिल्बिषात्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2120102, "chapter_id": 3580, "verse_number": "५०", "content_sanskrit": "कर्म चैतद् द्विलिङ्गस्य किं वाऽन्यत् प्रसमीक्षितम् ।\nवरध्वमविचार्यं हि ब्राह्मणस्य विशेषतः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2120103, "chapter_id": 3580, "verse_number": "५१", "content_sanskrit": "एवं मां समुपस्थाय कस्माद्वा विधिनाऽर्हणाम् ।\nप्रणीतां नो न गृह्णीत कार्यं किं चास्मदागमे\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2120104, "chapter_id": 3580, "verse_number": "५२", "content_sanskrit": "एवमुक्तस्ततः कृष्णः प्रत्युवाच महायशाः ।\nस्निग्धगम्भीरया वाचा वाक्यं वाक्यविशारदः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2120105, "chapter_id": 3580, "verse_number": "५३", "content_sanskrit": "स्नातकव्रतिनः सन्ति ब्राह्मणाः क्षत्रिया विशः ।\nविशेषनियमाश्चैषामविशेषाश्च सन्त्युत\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2120106, "chapter_id": 3580, "verse_number": "५४", "content_sanskrit": "विशेषवांश्च सततं क्षत्रियः श्रियमिच्छति ।\nपुष्पवत्सु ध्रुवा लक्ष्मीः पुष्पवन्तस्ततो वयम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2120107, "chapter_id": 3580, "verse_number": "५५", "content_sanskrit": "क्षत्रियो बाहुवीर्यस्तु न तथा वाक्यवीर्यवान् ।\nअप्रगल्भं वचस्तस्य तस्माद् बार्हद्रथेरितम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2120108, "chapter_id": 3580, "verse_number": "५६", "content_sanskrit": "स्ववीर्यं क्षत्रियाणां च बाह्वोर्धाता न्यवेशयत् ।\nतन्नो द्रक्ष्यसि चेद् राजन् द्रष्टास्यद्य न संशयः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2120109, "chapter_id": 3580, "verse_number": "५७", "content_sanskrit": "अद्वारेण रिपोर्गेहं द्वारेण सुहृदो गृहम् ।\nप्रविशन्ति सदा सन्तो द्वारं ते वर्जितं ततः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2120110, "chapter_id": 3580, "verse_number": "५८", "content_sanskrit": "कार्यवन्तो गृहानेत्य शत्रुतो नार्हणां वयम् ।\nप्रतिगृह्णीम तद् विद्धि एतन्नः शाश्वतं व्रतम्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2120111, "chapter_id": 3580, "verse_number": "", "content_sanskrit": "जरासन्धः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2120112, "chapter_id": 3580, "verse_number": "५९", "content_sanskrit": "न स्मरेयं कदा वैरं कृतं युष्माभिरित्युत ।\nचिन्तयंश्च न पश्यामि भवतां प्रति वैकृतम्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2120113, "chapter_id": 3580, "verse_number": "६०", "content_sanskrit": "वैकृते चासति कथं मन्यध्वे वा कृतागसम् ।\nअरिवद् ब्रूत यद् विप्राः सतां समय एष हि\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2120114, "chapter_id": 3580, "verse_number": "६१", "content_sanskrit": "अर्थधर्मोपघाताद्धि मनः समुपतप्यते ।\nयोऽनागसि प्रसृजति क्षत्रियो वीर्यमुत्थितः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2120115, "chapter_id": 3580, "verse_number": "६२", "content_sanskrit": "अतोऽन्यथा चरंल्लोके धर्मज्ञः स महाव्रतः ।\nवृजिनां गतिमाप्नोति श्रेयसोऽभ्युपहन्ति च\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2120116, "chapter_id": 3580, "verse_number": "६३", "content_sanskrit": "त्रैलोक्ये क्षत्रधर्माद्धि श्रेयांसं धर्मचारिणम् ।\nअनागसं प्रजानन्तः प्रमादादिति जल्पथ\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2120117, "chapter_id": 3580, "verse_number": "", "content_sanskrit": "वासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2120118, "chapter_id": 3580, "verse_number": "६४", "content_sanskrit": "कुलकार्यं महाराज कश्चिदेकः कुलोद्वहः ।\nवहते तन्नियोगाद्वै वयमभ्युत्थितास्त्रयः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2120119, "chapter_id": 3580, "verse_number": "६५", "content_sanskrit": "त्वया चोपहृता राजन् क्षत्रिया लोकवासिनः ।\nतदागः क्रूरमुत्पाद्य मन्यसे किन्न्वनागसम्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2120120, "chapter_id": 3580, "verse_number": "६६", "content_sanskrit": "राजा राज्ञः कथं साधून् हिंस्यान्नृपतिसत्तमः ।\nतान् राज्ञः सन्निगृह्य त्वं रुद्रायोपजिहीर्षसि\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2120121, "chapter_id": 3580, "verse_number": "६७", "content_sanskrit": "अस्मांस्तदेनो गच्छेत त्वया बार्हद्रथे कृतम् ।\nवयं हि शक्ता धर्मस्य रक्षणे दण्डधारिणः\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2120122, "chapter_id": 3580, "verse_number": "६८", "content_sanskrit": "तस्मादद्योपगच्छामस्तव बार्हद्रथान्तिकम् ।\nमनुष्याणां समालम्भो नहि दृष्टः कदाचन\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2120123, "chapter_id": 3580, "verse_number": "६९", "content_sanskrit": "स कथं मानुषैर्देवं यष्टुमिच्छसि शङ्करम् ।\nसवर्णोऽपि विवर्णानां कथं कुर्याद् विहिंसनम्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2120124, "chapter_id": 3580, "verse_number": "७०", "content_sanskrit": "यो न स्यात् त्वमिवानार्यो जरासन्ध वृषामतिः ।\nयस्यां यस्यामवस्थायां यद् यत्कर्म करोति यः ।\nतस्यां तस्यामवस्थायां तत्तत्फलमवाप्नुयात्\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2120125, "chapter_id": 3580, "verse_number": "७१", "content_sanskrit": "ते त्वा ज्ञातिक्षयकरं वयं मार्गानुसारिणः ।\nज्ञातिक्षयनिवृत्त्यर्थं परीप्सामो विशेषतः\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2120126, "chapter_id": 3580, "verse_number": "७२", "content_sanskrit": "नास्ति लोके पुमानन्यः क्षत्रियोऽस्मानतीत्य च ।\nमन्यसे स च ते राजन् सुमहान् बुद्धिविप्लवः\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2120127, "chapter_id": 3580, "verse_number": "७३", "content_sanskrit": "को हि जानन्नभिजनमात्मनः क्षत्रियो नृपः ।\nनाविशेत् स्वर्गमतुलं रणानन्तरमव्ययम्\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2120128, "chapter_id": 3580, "verse_number": "७४", "content_sanskrit": "स्वर्गं ह्येव समुद्दिश्य रणयज्ञेषु दीक्षिताः ।\nजयन्ते क्षत्रिया लोकांस्तान् विद्धि मगधेश्वर\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2120129, "chapter_id": 3580, "verse_number": "७५", "content_sanskrit": "स्वर्गयोनिर्जयो राजन् स्वर्गयोनिर्महद्यशः ।\nस्वर्गयोनिस्तपो युद्धे मार्गस्त्वव्यभिचारवान्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2120130, "chapter_id": 3580, "verse_number": "७६", "content_sanskrit": "एष ह्यैन्द्रो वैजयिको गुणो नित्यं समाहितः ।\nयेनासुरान् पराजित्य जगत् पाति शतक्रतुः\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2120131, "chapter_id": 3580, "verse_number": "७७", "content_sanskrit": "अस्य स्यात् स्वर्गमास्थाय निग्रहीतुं यथा तव\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2120132, "chapter_id": 3580, "verse_number": "७८", "content_sanskrit": "मागधैर्विपुलैः सैन्यैर्बाहुल्याद् बलदर्पितः ।\nमाऽवमंस्थाः परान् राजन् नास्ति वीर्यं नरेश्वर\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2120133, "chapter_id": 3580, "verse_number": "७९", "content_sanskrit": "समं तेजः श्रिया लोके बलं च मनुजर्षभ ।\nयावदेव न सम्बुद्धं तावद् दर्पो भवेत्तव\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2120134, "chapter_id": 3580, "verse_number": "८०", "content_sanskrit": "विषह्यमेतदस्माकमतो राजन् ब्रवीमि ते ।\nजहि त्वं सदृशेष्वेव मानं दर्पं च मागध ।\nमा गमः ससुतामात्यः सबलश्च यमक्षयम्\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2120135, "chapter_id": 3580, "verse_number": "८१", "content_sanskrit": "दम्भोद्भवः कार्तवीर्य उत्तरश्च बृहद्रथः ।\nश्रेयसो ह्यवमत्येह विनेशुः सबला नृपाः\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2120136, "chapter_id": 3580, "verse_number": "८२", "content_sanskrit": "मुमुक्षमाणास्त्वत्तश्च न वयं ब्राह्मणब्रुवाः ।\nशौरिरस्मि हृषीकेश इमौ भीमधनञ्जयौ\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2120137, "chapter_id": 3580, "verse_number": "८३", "content_sanskrit": "त्वामाह्वयामहे राजन् स्थिरो युध्यस्व मागध ।\nमुञ्चेमान् नृपतीन् सर्वान् मा गमस्त्वं यमक्षयम्\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2120138, "chapter_id": 3580, "verse_number": "८४", "content_sanskrit": "एतच्छ्रुत्वा जरासन्धः क्रुद्धो वचनमब्रवीत् ।\nनाहं कंसः प्रलम्बो वा न बाणो नच मुष्टिकः ।\nनरको नेन्द्रतपनो न मुरो नापि वानरः\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2120139, "chapter_id": 3580, "verse_number": "८५", "content_sanskrit": "न कालयवनो वाऽपि ये त्वया निहता युधि ।\nत्वं तु गोपकुलोत्पन्नो जातिं वै पूर्विकां स्मर\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2120140, "chapter_id": 3580, "verse_number": "८६", "content_sanskrit": "योऽस्मद्भयादपक्रम्य सागरानूपमाश्रितः ।\nजन्मभूमिं परित्यज्य मधुरां प्राकृतो यथा\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2120141, "chapter_id": 3580, "verse_number": "८७", "content_sanskrit": "सोऽधुना कत्थसे शौरे शरदीव यथा घनः ।\nअद्यानृण्यं करिष्यामि भोजराजस्य धीमतः\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2120142, "chapter_id": 3580, "verse_number": "८८", "content_sanskrit": "जामातुरौग्रसेनस्य त्वां निहत्य च माधव ।\nआकाङ्क्षितो मे सङ्ग्रामः त्वां हन्तुं ससुहृद्गणम्\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2120143, "chapter_id": 3580, "verse_number": "८९", "content_sanskrit": "दिष्ट्या मे सफलो यत्नः कृतो देवैः सवासवैः ।\nक्लीबाविमौ च गोविन्द भीमसेनार्जुनावुभौ\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2120144, "chapter_id": 3580, "verse_number": "९०", "content_sanskrit": "हिंस्यामि युधि विक्रम्य सिंहः क्षुद्रमृगानिव\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2120145, "chapter_id": 3580, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2120146, "chapter_id": 3580, "verse_number": "९१", "content_sanskrit": "तस्य रोषाभिभूतस्य जरासन्धस्य गर्जतः ।\nसर्वभूतानि वित्रेसुर्ये तत्रासन् समागताः\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2120147, "chapter_id": 3580, "verse_number": "", "content_sanskrit": "श्रीवासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2120148, "chapter_id": 3580, "verse_number": "९२", "content_sanskrit": "किं गर्जसि जरासन्ध कर्मणा तत् समाचर ।\nमम निर्देशकर्तृभ्यां पाण्डवाभ्यां नृपाधम\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2120149, "chapter_id": 3580, "verse_number": "९३", "content_sanskrit": "सामात्यं ससुतं त्वद्य घातयिष्याम्यहं रणे ।\nन कथञ्चन जीवन् वै प्रवेक्ष्यसि पुरोत्तमम्\t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2120150, "chapter_id": 3580, "verse_number": "", "content_sanskrit": "जरासन्धः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2120151, "chapter_id": 3580, "verse_number": "९४", "content_sanskrit": "नाजितं वै नरपतिमहमादद्मि कञ्चन ।\nजितः कः प्रत्यवस्थाता को मया न पराजितः\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2120152, "chapter_id": 3580, "verse_number": "९५", "content_sanskrit": "क्षत्रियस्यैतदेवाहुर्धर्म्यं कृष्णोपजीवनम् ।\nविक्रम्य वशमानीय कामतो यत् समाचरेत्\t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2120153, "chapter_id": 3580, "verse_number": "९६", "content_sanskrit": "देवतार्थमुपाहृत्य राज्ञः कृष्ण कथं भयात् ।\nअहमद्य विमुञ्चेयं क्षत्रधर्ममनुस्मरन्\t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2120154, "chapter_id": 3580, "verse_number": "९७", "content_sanskrit": "सैन्यं सैन्येन व्यूढेन एक एकेन वा पुनः ।\nद्वाभ्यां त्रिभिर्वा योत्स्येऽहं युगपत् पृथगेव वा\t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2120155, "chapter_id": 3580, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2120156, "chapter_id": 3580, "verse_number": "९८", "content_sanskrit": "एवमुक्त्वा जरासन्धः सहदेवाभिषेचनम् ।\nआज्ञापयत् तदा राजा युयुत्सुर्भीमकर्मभिः\t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2120157, "chapter_id": 3580, "verse_number": "९९", "content_sanskrit": "तौ तु सेनापती काले सस्मार भरतर्षभ ।\nकौशिकं चित्रसेनं च तस्मिन् युद्ध उपस्थिते\t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2120158, "chapter_id": 3580, "verse_number": "१००", "content_sanskrit": "ययोस्तु नामनी लोके हंसेति डिभकेति च ।\nपूर्वं स्तः कथितौ पुम्भिर्नृलोके लोकसत्कृतौ\t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2120159, "chapter_id": 3580, "verse_number": "१०१", "content_sanskrit": "तं तु राजन् विभुः शौरी राजानं बलिनां वरम् ।\nस्मृत्वा पुरुषशार्दूलं शार्दूलसमविक्रमम्\t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2120160, "chapter_id": 3580, "verse_number": "१०२", "content_sanskrit": "सत्यसन्धो जरासन्धं भुवि भीमपराक्रमम् ।\nभागमन्यस्य निर्दिष्टं वध्यं मत्वा तदाऽच्युतः\t॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2120161, "chapter_id": 3580, "verse_number": "१०३", "content_sanskrit": "नात्मनाऽत्मवतां मुख्य इयेष मधुसूदनः ।\nब्राह्मणाज्ञां पुरस्कृत्य हन्तुं हलधरानुजः\t॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2120162, "chapter_id": 3580, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि द्वाविंशोऽध्यायः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2120163, "chapter_id": 3580, "verse_number": "२", "content_sanskrit": "जरासन्धवधपर्वणि द्वितीयोऽध्यायः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2120164, "chapter_id": 3580, "verse_number": "", "content_sanskrit": "— ०  —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}]