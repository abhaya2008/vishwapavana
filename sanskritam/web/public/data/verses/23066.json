[{"id": 7003066000, "chapter_id": 23066, "verse_number": "३-४६-१", "content_sanskrit": "नारायण उवाच ।\nस्तुत्वा तां पर्शुरामोऽसौ हर्षसंफुल्लमानसः ।\nस्तोत्रेण हरिणोक्तेन स तुष्टाव गणाधिपम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003066001, "chapter_id": 23066, "verse_number": "३-४६-२", "content_sanskrit": "पूजां चकार भक्त्या च नैवेद्यैर्विविधैरपि ।\nधूपैर्दीपैश्च गन्धैश्च पुष्पैश्च तुलसीं विना ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003066002, "chapter_id": 23066, "verse_number": "३-४६-३", "content_sanskrit": "सम्पूज्य भ्रातरं भक्त्या स रामः शंकराज्ञया ।\nगुरुपत्नीं गुरुं नत्वा गमनं कर्तुमुद्यतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003066003, "chapter_id": 23066, "verse_number": "३-४६-४", "content_sanskrit": "नारद उवाच ।\nपूजां भगवतश्चक्रे रामो गणपतेर्यदा ।\nनैवद्यैर्विविधैः पुष्पैस्तुलसीं च विना कथम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003066004, "chapter_id": 23066, "verse_number": "३-४६-५", "content_sanskrit": "तुलसी सर्वपुष्पाणां मान्या धन्या मनोहरा ।\nकथं पूजां सारभूतां न गृह्णाति गणेश्वरः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003066005, "chapter_id": 23066, "verse_number": "३-४६-६", "content_sanskrit": "नारायण उवाच ।\nशृणु नारद वक्ष्येऽहमितिहासं पुरातनम् ।\nब्रह्मकल्पस्य वृत्तान्तं निगूढं च मनोहरम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003066006, "chapter_id": 23066, "verse_number": "३-४६-७", "content_sanskrit": "एकदा तुलसी देवी प्रोद्भिन्ननवयौवना ।\nतीर्थं भ्रमन्ती तपसा नारायणपरायणा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003066007, "chapter_id": 23066, "verse_number": "३-४६-८", "content_sanskrit": "ददर्श गङ्गातीरे सा गणेशं यौवनान्वितम् ।\nअतीव सुन्दरं शुद्धं सस्मितं पीतवाससम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003066008, "chapter_id": 23066, "verse_number": "३-४६-९", "content_sanskrit": "चन्दनोक्षितसर्वांगं रत्नभूषणभूषितम् ।\nध्यायन्तं कृष्णपादाब्जं जन्ममृत्युजरापहम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003066009, "chapter_id": 23066, "verse_number": "३-४६-१०", "content_sanskrit": "जितेन्द्रियाणां प्रवरं योगीन्द्राणां गुरोर्गुरुम् ।\nसुरूपहार्य्यं निष्कामं सकामा तमुवाच ह ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003066010, "chapter_id": 23066, "verse_number": "३-४६-११", "content_sanskrit": "तुलस्युवाच ।\nअहो ध्यायसि किं देव शान्तरूप गजानन ।\nकथं लम्बोदरो देहो गजवक्त्रं कथं तव ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003066011, "chapter_id": 23066, "verse_number": "३-४६-१२", "content_sanskrit": "एकदन्तः कथं वक्त्रे वदामुत्र च कारणम् ।\nत्यज ध्यानं महाभाग सायंकाल उपस्थितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003066012, "chapter_id": 23066, "verse_number": "३-४६-१३", "content_sanskrit": "इत्युक्त्वा तुलसी देवी प्रजहास पुनः पुनः ।\nपरं चेतसि दग्धा सा कामबाणैः सुदारुणैः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003066013, "chapter_id": 23066, "verse_number": "३-४६-१४", "content_sanskrit": "गणेशस्य प्रधानांगे दत्त्वा किञ्चिज्जलं मुने ।\nजघान तर्जन्यग्रेण निष्पन्दं कृष्णमानसम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003066014, "chapter_id": 23066, "verse_number": "३-४६-१५", "content_sanskrit": "बभूव ध्यानभग्नं च तस्य नारद चेतनम् ।\nदुःखं च ध्यानभेदेन तद्विच्छेदो हि शोकदः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003066015, "chapter_id": 23066, "verse_number": "३-४६-१६", "content_sanskrit": "ध्यानं त्यक्त्वा हरिं स्मृत्वा चापश्यत्कामिनीं पुरः ।\nनवयौवनसम्पन्नां सस्मितां कामपीडिताम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003066016, "chapter_id": 23066, "verse_number": "३-४६-१७", "content_sanskrit": "लम्बोदरश्च तां दृष्ट्वा परं विनयपूर्वकम् ।\nउवाच सस्मितः शान्तः शान्तां कामातुरां वशी ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003066017, "chapter_id": 23066, "verse_number": "३-४६-१८", "content_sanskrit": "गणेश्वर उवाच ।\nका त्वं वत्से कस्य कन्या मातर्मा ब्रूहि किं शुभे ।\nपापदोऽशुभदः शश्वद्ध्यानभंगस्तपस्विनाम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003066018, "chapter_id": 23066, "verse_number": "३-४६-१९", "content_sanskrit": "कृष्णः करोतु कल्याणं हन्तु विघ्नं कृपानिधिः ।\nतद्ध्यानभंगजाद्दोषान्नाशुभं स्यात्तु ते शुभे ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003066019, "chapter_id": 23066, "verse_number": "३-४६-२०", "content_sanskrit": "गणेशवचनं श्रुत्वा तमुवाच स्मरातुरा ।\nसस्मितं सकटाक्षं च देवं मधुरया गिरा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003066020, "chapter_id": 23066, "verse_number": "३-४६-२१", "content_sanskrit": "तुलस्युवाच ।\nधर्मात्मजस्य कन्याऽहमप्रौढा च तपस्विनी ।\nतपस्या मे स्वामिनोऽर्थे त्वं स्वामी भव मे प्रभो ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003066021, "chapter_id": 23066, "verse_number": "३-४६-२२", "content_sanskrit": "तुलसीवचनं श्रुत्वा गणेशः श्रीहरिं स्मरन् ।\nतामुवाच महाप्राज्ञः प्राज्ञीं मधुरया गिरा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003066022, "chapter_id": 23066, "verse_number": "३-४६-२३", "content_sanskrit": "गणेश उवाच ।\nहे मातर्नास्ति मे वाच्छा घोरे दारपरिग्रहे ।\nदारग्रहो हि दुःखाय न सुखाय कदाचन ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003066023, "chapter_id": 23066, "verse_number": "३-४६-२४", "content_sanskrit": "हरिभक्तेर्व्यवायश्च तपस्यानाशकारकः ।\nमोक्षद्वारकपाटश्च भवबन्धनपाशकः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003066024, "chapter_id": 23066, "verse_number": "३-४६-२५", "content_sanskrit": "गर्भवासकरः शश्वत्तत्त्वज्ञाननिकृन्तकः ।\nसंशयानां समारम्भो यस्त्याज्यो वृषलैरपि ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003066025, "chapter_id": 23066, "verse_number": "३-४६-२६", "content_sanskrit": "गेहोऽयं कारणानां च सर्वमायाकरण्डकम् ।\nसाहसानां समूहश्च दोषाणां च विशेषतः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003066026, "chapter_id": 23066, "verse_number": "३-४६-२७", "content_sanskrit": "निवर्तस्व महाभागे पश्यान्यं कामुकं पतिम् ।\nकामुकेनैव कामुक्याः संगमो गुणवान्भवेत ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003066027, "chapter_id": 23066, "verse_number": "३-४६-२८", "content_sanskrit": "इत्येवं वचनं श्रुत्वा कोपात्सा तं शशाप ह ।\nदारास्ते भविताऽसाध्वी गणेश्वर न संशयः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003066028, "chapter_id": 23066, "verse_number": "३-४६-२९", "content_sanskrit": "इत्याकर्ण्य सुरश्रेष्ठस्तां शशाप शिवात्मजः ।\nदेवि त्वमसुरग्रस्ता भविष्यसि न संशयः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003066029, "chapter_id": 23066, "verse_number": "३-४६-३०", "content_sanskrit": "तत्पश्चान्महतां शापाद्वृक्षस्त्वं भवितेति च ।\nमहातपस्वीत्युक्त्वा तां विरराम च नारद ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003066030, "chapter_id": 23066, "verse_number": "३-४६-३१", "content_sanskrit": "शापं श्रुत्वा तु तुलसी सा रुरोद पुनः पुनः ।\nतुष्टाव च सुरश्रेष्ठं स प्रसन्न उवाच ताम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003066031, "chapter_id": 23066, "verse_number": "३-४६-३२", "content_sanskrit": "गणेश्वर उवाच ।\nपुष्पाणां सारभूता त्वं भविष्यसि मनोरमे ।\nकलांशेन महाभागे स्वयं नारायणप्रिया ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003066032, "chapter_id": 23066, "verse_number": "३-४६-३३", "content_sanskrit": "प्रिया त्वं सर्वदेवानां श्रीकृष्णस्य विशेषतः ।\nपूजा विमुक्तिदा नॄणां मया भोग्या न नित्यशः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003066033, "chapter_id": 23066, "verse_number": "३-४६-३४", "content_sanskrit": "इत्युक्त्वा तां सुरश्रेष्ठो जगाम तपसे पुनः ।\nहरेराराधनव्यग्रो बदरीसन्निधिं ययौ ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003066034, "chapter_id": 23066, "verse_number": "३-४६-३५", "content_sanskrit": "जगाम तुलसी देवी हृदयेन विदूयता ।\nनिराहारा तपश्चक्रे पुष्करे लक्षवर्षकम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003066035, "chapter_id": 23066, "verse_number": "३-४६-३६", "content_sanskrit": "पश्चान्मुनीन्द्रशापेन गणेशस्य च नारद ।\nसा प्रिया शंखचूडस्य बभूव सुचिरं मुने ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003066036, "chapter_id": 23066, "verse_number": "३-४६-३७", "content_sanskrit": "ततः शङ्करशूलेन स ममारासुरेश्वरः ।\nसा कलांशेन वृक्षत्वं ययौ नारायणप्रिया ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003066037, "chapter_id": 23066, "verse_number": "३-४६-३८", "content_sanskrit": "कथितश्चेतिहासस्ते श्रुतो धर्ममुखात्पुरा ।\nमोक्षप्रदश्च सारश्च पुराणेन प्रकीर्तितः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003066038, "chapter_id": 23066, "verse_number": "३-४६-३९", "content_sanskrit": "ततः परशुरामोऽसौ जगाम तपसे वनम् ।\nप्रणम्य शङ्करं दुर्गां संपूज्य च गणेश्वरम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003066039, "chapter_id": 23066, "verse_number": "३-४६-४०", "content_sanskrit": "पूजितो वन्दितः सर्वैः सुरेन्द्रमुनिपुङ्गवैः ।\nपार्वतीशिवसान्निध्ये सुखं तस्थौ गणेश्वरः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003066040, "chapter_id": 23066, "verse_number": "३-४६-४१", "content_sanskrit": "इदं गणपतेः खण्डं यः शृणोति समाहितः ।\nस राजसूययज्ञस्य फलमाप्नोति निश्चितम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003066041, "chapter_id": 23066, "verse_number": "३-४६-४२", "content_sanskrit": "अपुत्रो लभते पुत्रं श्रीगणेशप्रसादतः ।\nधीरं वीरं च धनिनं गुणिनं चिरजीविनम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003066042, "chapter_id": 23066, "verse_number": "३-४६-४३", "content_sanskrit": "यशस्विनं पुत्रिणं च विद्वांसं सुकवीश्वरम् ।\nजितेन्द्रियाणां प्रवरं दातारं सर्वसम्पदाम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003066043, "chapter_id": 23066, "verse_number": "३-४६-४४", "content_sanskrit": "सुशीलं च सदाचारं प्रशंस्यं वैष्णवं लभेत् ।\nअहिंसकं दयालुं च तत्त्वज्ञानविशारदम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003066044, "chapter_id": 23066, "verse_number": "३-४६-४५", "content_sanskrit": "भक्त्या गणेशं संपूज्य वस्त्रालङ्कारचन्दनैः ।\nश्रुत्वा गणपतेः खण्डं महावन्ध्या प्रसूयते ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003066045, "chapter_id": 23066, "verse_number": "३-४६-४६", "content_sanskrit": "मृतवत्सा काकवन्ध्या ब्रह्मन्पुत्रं लभेद्ध्रुवम् ।\nअदूष्यदूषणपरा शुद्धा चैव लभेत्सुतम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003066046, "chapter_id": 23066, "verse_number": "३-४६-४७", "content_sanskrit": "संपूर्णं ब्रह्मवैवर्तं श्रुत्वा यल्लभते फलम् ।\nतत्फलं लभते मर्त्यः श्रुत्वेदं खण्डमुत्तमम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003066047, "chapter_id": 23066, "verse_number": "३-४६-४८", "content_sanskrit": "वाञ्छां कृत्वा तु मनसि शृणोति परमास्थितः ।\nतस्मै ददाति सर्वेष्टं सुरश्रेष्ठो गणेश्वरः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003066048, "chapter_id": 23066, "verse_number": "३-४६-४९", "content_sanskrit": "श्रुत्वा गणपतेः खण्डं विघ्ननाशाय यत्नतः ।\nस्वर्णयज्ञोपवीतं च श्वेतच्छत्रं च माल्यकम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]