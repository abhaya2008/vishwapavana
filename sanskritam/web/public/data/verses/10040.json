[{"id": 6000040000, "chapter_id": 10040, "verse_number": null, "content_sanskrit": "अथ दशमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000040001, "chapter_id": 10040, "verse_number": null, "content_sanskrit": "ब्रह्मोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.001.m4a", "display_order": 2}, {"id": 6000040002, "chapter_id": 10040, "verse_number": "३-१०-१", "content_sanskrit": "ज्ञातोऽसि मेऽद्य सुचिरान्ननु देहभाजां न ज्ञायते भगवतो गतिरित्यवद्यम्।\nनान्यत् त्वदस्ति भगवन्नपि तत्त्वशुद्धं मायागुणव्यतिकराद् यदुरुर्विभासि॥ ३/१०/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.002.m4a", "display_order": 3, "topics": [{"text": "ततश्चतुर्मुखेन बहुधा श्रीनारायणस्तवनम्", "range": "१–२५"}]}, {"id": 6000040003, "chapter_id": 10040, "verse_number": "३-१०-२", "content_sanskrit": "रूपं यदेतदवबोधरसोदयेन शश्वन्निवृत्ततमसः सदनुग्रहाय।\nआदौ गृहीतमवतारशतैकबीजं यन्नाभिपद्मभवनादहमाविरासम्॥ ३/१०/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.003.m4a", "display_order": 4}, {"id": 6000040004, "chapter_id": 10040, "verse_number": "३-१०-३", "content_sanskrit": "नातः परं परम यद् भवतः स्वरूपम् आनन्दमात्रमविकारमविद्धवर्चः।\nपश्यामि विश्वसृजमेकमविश्वमाद्यं भूतेन्द्रियात्मकमदस्त उपाश्रितोऽस्मि॥ ३/१०/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.004.m4a", "display_order": 5}, {"id": 6000040005, "chapter_id": 10040, "verse_number": "३-१०-४", "content_sanskrit": "यद्वा इदं भुवनमङ्गल मङ्गलाय ध्यानात्मनो दर्शितं त उपासकानाम्।\nतस्मै नमो भगवतेऽनुविधेम तुभ्यं योऽनादृतो निरयभाग्भिरसत्प्रसङ्गैः॥ ३/१०/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.005.m4a", "display_order": 6}, {"id": 6000040006, "chapter_id": 10040, "verse_number": "३-१०-५", "content_sanskrit": "ये तु त्वदीयचरणाम्बुजकोशगन्धं जिघ्रन्ति कर्णविवरैः श्रुतिवातनीतम्।\nभक्त्या गृहीतचरणः परया च तेषां नापैषि नाथ हृदयाम्बुरुहात् स्वपुंसाम्॥ ३/१०/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.006.m4a", "display_order": 7}, {"id": 6000040007, "chapter_id": 10040, "verse_number": "३-१०-६", "content_sanskrit": "तावद् भयं द्रविणगेहसुहृन्निमित्तं शोकः स्पृहा परिभवो विपुलश्च लोभः।\nतावन्ममेत्यसदवग्रह आर्तिमूलं यावन्न तेऽङ्घ्रिमभयं प्रवृणीत लोकः॥ ३/१०/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.007.m4a", "display_order": 8}, {"id": 6000040008, "chapter_id": 10040, "verse_number": "३-१०-७", "content_sanskrit": "दैवेन ते हतधियो भवतः प्रसङ्गात् सर्वाशुभोपशमनाद् विमुखेन्द्रिया ये।\nकुर्वन्ति कामसुखलेशलवाय दीना लोभाभिभूतमनसोऽकुशलानि शश्वत्॥ ३/१०/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.008.m4a", "display_order": 9}, {"id": 6000040009, "chapter_id": 10040, "verse_number": "३-१०-८", "content_sanskrit": "क्षुत्तृट्त्रिधातुभिरिमा मुहुरर्द्यमानाः शीतोष्णवातवर्षैरितरेतराच्च।\nकामाग्निनाऽच्युत रुषा च सुदुर्भरेण संपश्यतो मन उरुक्रम सीदते मे॥ ३/१०/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.009.m4a", "display_order": 10}, {"id": 6000040010, "chapter_id": 10040, "verse_number": "३-१०-९", "content_sanskrit": "यावत् पृथक्त्वमिदमात्मन इन्द्रियार्थं मायाबलं भगवतो जन ईश पश्येत्।\nतावच्च संसृतिरसौ प्रतिसङ्क्रमेत व्यर्थाऽपि दुःखनिवहं वहती क्रियार्था॥ ३/१०/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.010.m4a", "display_order": 11}, {"id": 6000040011, "chapter_id": 10040, "verse_number": "३-१०-१०", "content_sanskrit": "अध्याहृतार्थकरणा निशि निःशयाना नानामनोरथधियः क्षणभङ्गनिद्राः।\nदैवाद्धतार्थरचना ऋषयोऽपि देव युष्मत्प्रसङ्गविमुखा इह संसरन्ति॥ ३/१०/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.011.m4a", "display_order": 12}, {"id": 6000040012, "chapter_id": 10040, "verse_number": "३-१०-११", "content_sanskrit": "त्वद्भावयोगपरिभावितहृत्सरोजा ये सच्छ्रुतेक्षितपथा ननु नाथ पुंसाम्।\nयद् यद् धिया त उरुगाय विभावयन्ति तत् तद् वपुः प्रणयसे तदनुग्रहाय॥ ३/१०/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.012.m4a", "display_order": 13}, {"id": 6000040013, "chapter_id": 10040, "verse_number": "३-१०-१२", "content_sanskrit": "नातिप्रसीदसि तथोपचितोपचारैराराधितः सुरगणैर्हृदि बद्धकामैः।\nयः सर्वभूतदययाऽसदलभ्ययैको नानाजनेष्ववहितः सुहृदन्तरात्मा॥ ३/१०/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.013.m4a", "display_order": 14}, {"id": 6000040014, "chapter_id": 10040, "verse_number": "३-१०-१३", "content_sanskrit": "पुंसामतो विविधकर्मभिरध्वराद्यैर्दानेन चोग्रतपसा व्रतचर्यया च।\nनाराधनं भगवतस्तव सत्क्रियार्थो धर्मोऽर्पितः कर्हिचित् क्रियते न यत्र॥ ३/१०/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.014.m4a", "display_order": 15}, {"id": 6000040015, "chapter_id": 10040, "verse_number": "३-१०-१४", "content_sanskrit": "शश्वत् स्वरूपमहसैव निपीतभेदमोहाय बोधधिषणाय नमः परस्मै।\nविश्वोदयस्थितिलयेषु निमित्तलीलारामाय ते नम इदं चकृमेश्वराय॥ ३/१०/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.015.m4a", "display_order": 16}, {"id": 6000040016, "chapter_id": 10040, "verse_number": "३-१०-१५", "content_sanskrit": "यस्यावतारगुणकर्मविडम्बनानि नामानि येऽसुविगमे विवशा गृणन्ति।\nते नैकजन्मशमलं सहसैव हित्वा संयान्त्यपावृतमृतं तमजं प्रपद्ये॥ ३/१०/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.016.m4a", "display_order": 17}, {"id": 6000040017, "chapter_id": 10040, "verse_number": "३-१०-१६", "content_sanskrit": "यो वा अहं च गिरिशश्च विभुः स्वयं च स्थित्युद्भवप्रलयहेतव आत्ममूलाः।\nभूत्वा त्रिपाद् ववृध एक उरुप्ररोहस्तस्मै नमो भगवते भुवनद्रुमाय॥ ३/१०/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.017.m4a", "display_order": 18}, {"id": 6000040018, "chapter_id": 10040, "verse_number": "३-१०-१७", "content_sanskrit": "लोको विकर्मनिरतः कुशले प्रमत्तः कर्मण्ययं त्वदुदिते भवदर्चने स्वे।\nयस्तावदस्य बलवानिह जीविताशां सद्यश्छिनत्त्यनिमिषाय नमोऽस्तु तस्मै॥ ३/१०/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.018.m4a", "display_order": 19}, {"id": 6000040019, "chapter_id": 10040, "verse_number": "३-१०-१८", "content_sanskrit": "यस्माद् बिभेम्यहमपि द्विपरार्धधिष्ण्यमध्यासितः सकललोकनमस्कृतं यत्।\nतेपे तपो बहुतपोऽवरुरुत्समानस्तस्मै नमो भगवते विसखाय तुभ्यम्॥ ३/१०/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.019.m4a", "display_order": 20}, {"id": 6000040020, "chapter_id": 10040, "verse_number": "३-१०-१९", "content_sanskrit": "तिर्यङ्मनुष्यविबुधादिषु जीवयोनिष्वात्मेच्छयाऽऽत्मकृतसेतुपरीप्सया यः।\nरेमेऽनिरस्तरतिरप्युपलब्धकाष्ठस्तस्मै नमो भगवते पुरुषोत्तमाय॥ ३/१०/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.020.m4a", "display_order": 21}, {"id": 6000040021, "chapter_id": 10040, "verse_number": "३-१०-२०", "content_sanskrit": "योऽविद्ययाऽनुपहतोऽपि दशार्धवृत्त्या निद्रामुवाह जठरीकृतलोकयात्रः।\nअन्तर्जलेऽहिकशिपुस्पर्शानुकूलं भीमोर्मिमालिनि जनस्य सुखं विवृण्वन्॥ ३/१०/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.021.m4a", "display_order": 22}, {"id": 6000040022, "chapter_id": 10040, "verse_number": "३-१०-२१", "content_sanskrit": "यन्नाभिपद्मभवनादहमासमद्य लोकत्रयोपकरणो यदनुग्रहेण।\nतस्मै नमस्त उदरस्थभवाय योगनिद्रावसानविकसन्नलिनेक्षणाय॥ ३/१०/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.022.m4a", "display_order": 23}, {"id": 6000040023, "chapter_id": 10040, "verse_number": "३-१०-२२", "content_sanskrit": "सोऽयं समस्तजगतां सुहृदेक आत्मा सत्त्वेन यन्मृडयते भगवान् भगेन।\nतेनैव मे दृशमनुस्पृशताद् यथाऽहं स्रक्ष्यामि पूर्ववदिदं प्रणतप्रियोऽसौ॥ ३/१०/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.023.m4a", "display_order": 24}, {"id": 6000040024, "chapter_id": 10040, "verse_number": "३-१०-२३", "content_sanskrit": "एष प्रपन्नवरदो रमयाऽऽत्मशक्त्या यद् यत् करिष्यति गृहीतगुणावतारः।\nतस्मिन् स्वविक्रम इदं सृजतोऽपि चेतो युञ्जीत कर्मशमलं च यथा विजह्याम्॥ ३/१०/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.024.m4a", "display_order": 25}, {"id": 6000040025, "chapter_id": 10040, "verse_number": "३-१०-२४", "content_sanskrit": "नाभिह्रदादिह सतोऽम्भसि यस्य पुंसो विज्ञानशक्तिरहमासमनन्तशक्तेः।\nरूपं विचित्रमिदमस्य विवृण्वतो मे मा रीरिषीष्ट निगमस्य गिरां विसर्गः॥ ३/१०/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.025.m4a", "display_order": 26}, {"id": 6000040026, "chapter_id": 10040, "verse_number": "३-१०-२५", "content_sanskrit": "सोऽसावदभ्रकरुणो भगवान् विवृद्धप्रेमस्मितेन नयनाम्बुरुहं विजृम्भन्।\nउत्थाय विश्वविजयाय मनोविषादं माध्व्या गिराऽपनयतात् पुरुषः पुराणः॥ ३/१०/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.026.m4a", "display_order": 27}, {"id": 6000040027, "chapter_id": 10040, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.027.m4a", "display_order": 28}, {"id": 6000040028, "chapter_id": 10040, "verse_number": "३-१०-२६", "content_sanskrit": "स्वसम्भवं निशाम्यैवं तपोविद्यासमाधिभिः।\nयावन्मनोवचः स्तुत्वा विरराम स खिन्नवत्॥ ३/१०/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.028.m4a", "display_order": 29, "topics": [{"text": "तपस्तुष्टेन विष्णुना चतुर्मुखं प्रति पुनस्तपश्चर्यया विज्ञानं लब्ध्वा जगत्सर्जनं कुर्विति चोदनापूर्वकमन्तर्धानम्", "range": "२६–४४"}]}, {"id": 6000040029, "chapter_id": 10040, "verse_number": "३-१०-२७", "content_sanskrit": "अथाभिप्रेतमालक्ष्य ब्रह्मणो मधुसूदनः।\nविषण्णचेतसस्तेन कल्पव्यतिकराम्भसा॥ ३/१०/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.029.m4a", "display_order": 30}, {"id": 6000040030, "chapter_id": 10040, "verse_number": "३-१०-२८", "content_sanskrit": "लोकसंस्थानविज्ञान आत्मनः परिखिद्यतः।\nतमाहागाधया वाचा कश्मलं शमयन्निव॥ ३/१०/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.030.m4a", "display_order": 31}, {"id": 6000040031, "chapter_id": 10040, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.031.m4a", "display_order": 32}, {"id": 6000040032, "chapter_id": 10040, "verse_number": "३-१०-२९", "content_sanskrit": "मा वेदगर्भ गास्तन्द्रीं सर्ग उद्यममावह।\nतन्मया चोदितं ह्यग्रे यन्मां प्रार्थयते भवान्॥ ३/१०/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.032.m4a", "display_order": 33}, {"id": 6000040033, "chapter_id": 10040, "verse_number": "३-१०-३०", "content_sanskrit": "भूयश्च तप आतिष्ठ विद्यां चैव मदाश्रयाम्।\nताभ्यामन्तर्हृदि ब्रह्मन् लोकान् द्रक्ष्यस्यपावृतान्॥ ३/१०/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.033.m4a", "display_order": 34}, {"id": 6000040034, "chapter_id": 10040, "verse_number": "३-१०-३१", "content_sanskrit": "तत आत्मनि योगेन भक्तियुक्तः समाहितः।\nद्रष्टासि मां ततं ब्रह्मन् मयि लोकांस्त्वमात्मनि॥ ३/१०/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.034.m4a", "display_order": 35}, {"id": 6000040035, "chapter_id": 10040, "verse_number": "३-१०-३२", "content_sanskrit": "यदा तु सर्वभूतेषु दारुष्वग्निमिव स्थितम्।\nप्रतिचक्षीत मां लोको जह्यात् तर्ह्येव कश्मलम्॥ ३/१०/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.035.m4a", "display_order": 36}, {"id": 6000040036, "chapter_id": 10040, "verse_number": "३-१०-३३", "content_sanskrit": "यदा रहितमात्मानं भूतेन्द्रियगुणाशयैः।\nस्वरूपेण मयोपेतं पश्यन् स्वाराज्यमृच्छति॥ ३/१०/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.036.m4a", "display_order": 37}, {"id": 6000040037, "chapter_id": 10040, "verse_number": "३-१०-३४", "content_sanskrit": "नानाकर्मविपाकेन प्रजा बह्वीः सिसृक्षतः।\nनात्माऽवसीदत्यस्मिंस्ते वर्षीयान् मदनुग्रहः॥ ३/१०/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.037.m4a", "display_order": 38}, {"id": 6000040038, "chapter_id": 10040, "verse_number": "३-१०-३५", "content_sanskrit": "ऋषिमाद्यं न बध्नाति पापीयांस्त्वां रजोगुणः।\nयन्मनो मयि निर्बद्धं प्रजाः संसृजतोऽपि ते॥ ३/१०/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.038.m4a", "display_order": 39}, {"id": 6000040039, "chapter_id": 10040, "verse_number": "३-१०-३६", "content_sanskrit": "ज्ञातोऽहं भवता त्वद्य दुर्विज्ञेयोऽपि देहिनाम्।\nयन्मां त्वं मन्यसे युक्तं भूतेन्द्रियगुणात्मभिः॥ ३/१०/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.039.m4a", "display_order": 40}, {"id": 6000040040, "chapter_id": 10040, "verse_number": "३-१०-३७", "content_sanskrit": "तुभ्यं मद्विचिकित्सायामात्मा मे दर्शितो बहिः।\nनालेन सलिले मूलं पुष्करस्य विचिन्वतः॥ ३/१०/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.040.m4a", "display_order": 41}, {"id": 6000040041, "chapter_id": 10040, "verse_number": "३-१०-३८", "content_sanskrit": "यच्चकर्थ मम स्तोत्रं मत्कथाभ्युदयाङ्कितम्।\nयद् वा तपसि निष्ठा च स एष मदनुग्रहः॥ ३/१०/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.041.m4a", "display_order": 42}, {"id": 6000040042, "chapter_id": 10040, "verse_number": "३-१०-३९", "content_sanskrit": "प्रीतोऽहमस्तु भद्रं ते लोकानां विजयेच्छया।\nयदस्तौषीद् गुणमयं निर्गुणं माऽनुवर्णयन्॥ ३/१०/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.042.m4a", "display_order": 43}, {"id": 6000040043, "chapter_id": 10040, "verse_number": "३-१०-४०", "content_sanskrit": "य एतेन पुमान् नित्यं स्तुत्वा स्तोत्रेण मां भजेत्।\nतस्याहं सम्प्रसीदेयं सर्वकामवरेश्वरः॥ ३/१०/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.043.m4a", "display_order": 44}, {"id": 6000040044, "chapter_id": 10040, "verse_number": "३-१०-४१", "content_sanskrit": "पूर्तेन तपसा यज्ञैर्दानैर्योगैः समाधिना।\nराज्यं निःश्रेयसं पुंसां मत्प्रीतिस्तत्त्वविन्मतम्॥ ३/१०/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.044.m4a", "display_order": 45}, {"id": 6000040045, "chapter_id": 10040, "verse_number": "३-१०-४२", "content_sanskrit": "अहमात्माऽऽत्मनां धातः प्रेष्ठः सन् प्रेयसामपि।\nअतो मयि रतिं कुर्याद् देहादिर्यत्कृते प्रियः॥ ३/१०/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.045.m4a", "display_order": 46}, {"id": 6000040046, "chapter_id": 10040, "verse_number": "३-१०-४३", "content_sanskrit": "सर्ववेदमयेनेमा आत्मनाऽऽत्माऽऽत्मयोगिना।\nप्रजाः सृज यथापूर्वं याश्च मय्यनुशेरते॥ ३/१०/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.046.m4a", "display_order": 47}, {"id": 6000040047, "chapter_id": 10040, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.047.m4a", "display_order": 48}, {"id": 6000040048, "chapter_id": 10040, "verse_number": "३-१०-४४", "content_sanskrit": "तस्मा एवं जगत्स्रष्टा प्रधानपुरुषेश्वरः।\nव्यज्येदं स्वेन रूपेण कञ्जनाभस्तिरोदधे॥ ३/१०/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_010/BhP_03.010.048.m4a", "display_order": 49}, {"id": 6000040049, "chapter_id": 10040, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां तृतीयस्कन्धे दशमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]