[{"id": 6000170000, "chapter_id": 10170, "verse_number": null, "content_sanskrit": "अथ सप्तदशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000170001, "chapter_id": 10170, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_017/BhP_08.017.001.m4a", "display_order": 2}, {"id": 6000170002, "chapter_id": 10170, "verse_number": "८-१७-१", "content_sanskrit": "इत्थं विरिञ्चिस्तुतकर्मवीर्यः प्रादुर्बभूवामृतभूरदित्याम्।\nचतुर्भुजः शङ्खगदाब्जचक्रः पिशङ्गवासा नलिनायतेक्षणः॥ ८/१७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_017/BhP_08.017.002.m4a", "display_order": 3, "topics": [{"text": "अदितिदेव्यां भगवतो वामनस्यावतारः", "range": "१–१२"}]}, {"id": 6000170003, "chapter_id": 10170, "verse_number": "८-१७-२", "content_sanskrit": "श्यामावदातो झषराजकुण्डलत्विषोल्लसच्छ्रीवदनाम्बुजः पुमान्।\nश्रीवत्सवक्षा वलयाङ्गदोल्लसत्किरीटकाञ्चीगुणचारुनूपुरः॥ ८/१७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_017/BhP_08.017.003.m4a", "display_order": 4}, {"id": 6000170004, "chapter_id": 10170, "verse_number": "८-१७-३", "content_sanskrit": "मधुव्रतव्रातविघुष्टया स्वया विराजितश्रीवनमालया हरिः।\nप्रजापतेर्वेश्मतमः स्वरोचिषा विनाशयन् कण्ठनिविष्टकौस्तुभः॥ ८/१७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_017/BhP_08.017.004.m4a", "display_order": 5}, {"id": 6000170005, "chapter_id": 10170, "verse_number": "८-१७-४", "content_sanskrit": "दिशः प्रसेदुः सलिलाशयास्तदा प्रजाः प्रहृष्टा ऋतवो गुणान्विताः।\nद्यौरन्तरिक्षं क्षितिरग्निजिह्वा गावो द्विजाः सञ्जहृषुर्नगाश्च॥ ८/१७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_017/BhP_08.017.005.m4a", "display_order": 6}, {"id": 6000170006, "chapter_id": 10170, "verse_number": "८-१७-५", "content_sanskrit": "श्रोणायां श्रवणद्वादश्यां मुहूर्तेऽभिजिति प्रभुः।\nसर्वे नक्षत्रताराद्याश्चक्रुस्तज्जन्म दक्षिणम्॥ ८/१७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_017/BhP_08.017.006.m4a", "display_order": 7}, {"id": 6000170007, "chapter_id": 10170, "verse_number": "८-१७-६", "content_sanskrit": "द्वादश्यां सविताऽतिष्ठन्मध्यन्दिनगतो नृप।\nविजया नाम सा प्रोक्ता यस्यां जन्म विदुर्हरेः॥ ८/१७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_017/BhP_08.017.007.m4a", "display_order": 8}, {"id": 6000170008, "chapter_id": 10170, "verse_number": "८-१७-७", "content_sanskrit": "शङ्खदुन्दुभयो भेर्यो मृदङ्गपणवानकाः।\nचित्रवादित्रतूर्याणां निर्घोषस्तुमलोऽभवत्॥ ८/१७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_017/BhP_08.017.008.m4a", "display_order": 9}, {"id": 6000170009, "chapter_id": 10170, "verse_number": "८-१७-८", "content_sanskrit": "प्रीताश्चाप्सरसोऽनृत्यन् गन्धर्वपतयो जगुः।\nतुष्टुवुर्मुनयो देवा मनवः पितरोऽग्नयः॥ ८/१७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_017/BhP_08.017.009.m4a", "display_order": 10}, {"id": 6000170010, "chapter_id": 10170, "verse_number": "८-१७-९", "content_sanskrit": "सिद्धविद्याधरगणाः सकिम्पुरुषकिन्नराः।\nचारणा यक्षरक्षांसि सुपर्णभुजगोत्तमाः॥ ८/१७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_017/BhP_08.017.010.m4a", "display_order": 11}, {"id": 6000170011, "chapter_id": 10170, "verse_number": "८-१७-१०", "content_sanskrit": "गायन्तोऽभिप्रशंसन्तो नृत्यन्तो विबुधानुगाः।\nअदित्या आश्रमपदं कुसुमैः समवाकिरन्॥ ८/१७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_017/BhP_08.017.011.m4a", "display_order": 12}, {"id": 6000170012, "chapter_id": 10170, "verse_number": "८-१७-११", "content_sanskrit": "दृष्ट्वाऽदितिस्तं निजगर्भसम्भवं परं पुमांसं मुदमाप विस्मिता।\nगृहीतदेहं निजयोगमायया प्रजापतिश्चाह जयेति विस्मितः॥ ८/१७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_017/BhP_08.017.012.m4a", "display_order": 13}, {"id": 6000170013, "chapter_id": 10170, "verse_number": "८-१७-१२", "content_sanskrit": "यत् तद् वपुर्भाति विभूषणायुधैरव्यक्तवद् व्यक्तमधारयद्धरिः।\nबभूव तेनैव स वामनो वटुः सम्पश्यतोर्दिव्यगतिर्यथा नटः॥ ८/१७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_017/BhP_08.017.013.m4a", "display_order": 14}, {"id": 6000170014, "chapter_id": 10170, "verse_number": "८-१७-१३", "content_sanskrit": "तं वटुं वामनं दृष्ट्वा मोदमाना महर्षयः।\nकर्माणि कारयामासुः पुरस्कृत्य प्रजापतिम्॥ ८/१७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_017/BhP_08.017.014.m4a", "display_order": 15, "topics": [{"text": "पित्रोपनीतस्य तस्य अश्वमेधैर्यजतो बलेर्यज्ञवाटगमनम्", "range": "१३–२२"}]}, {"id": 6000170015, "chapter_id": 10170, "verse_number": "८-१७-१४", "content_sanskrit": "तस्योपनीयमानस्य सावित्रीं सविताऽब्रवीत्।\nबृहस्पतिर्ब्रह्मसूत्रं मेखलां कश्यपो ददौ॥ ८/१७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_017/BhP_08.017.015.m4a", "display_order": 16}, {"id": 6000170016, "chapter_id": 10170, "verse_number": "८-१७-१५", "content_sanskrit": "ददौ कृष्णाजिनं भूमिर्दण्डं सोमो वनस्पतिः।\nकौपीनाच्छादनं माता द्यौश्छत्रं जगतः पतेः॥ ८/१७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_017/BhP_08.017.016.m4a", "display_order": 17}, {"id": 6000170017, "chapter_id": 10170, "verse_number": "८-१७-१६", "content_sanskrit": "कमण्डलुं वेदगर्भः कुशान् सप्तर्षयो ददुः।\nअक्षमालां महाराज सरस्वत्यक्षयात्मनः॥ ८/१७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_017/BhP_08.017.017.m4a", "display_order": 18}, {"id": 6000170018, "chapter_id": 10170, "verse_number": "८-१७-१७", "content_sanskrit": "तस्मा इत्युपनीताय यक्षराट् पात्रिकामदात्।\nभिक्षां भगवती साक्षादुमाऽदादम्बिका सती॥ ८/१७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_017/BhP_08.017.018.m4a", "display_order": 19}, {"id": 6000170019, "chapter_id": 10170, "verse_number": "८-१७-१८", "content_sanskrit": "स ब्रह्मवर्चसेनैव सभां सम्भावितो वटुः।\nब्रह्मर्षिगणसञ्जुष्टाम् अत्यरोचत मारिषः॥ ८/१७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_017/BhP_08.017.019.m4a", "display_order": 20}, {"id": 6000170020, "chapter_id": 10170, "verse_number": "८-१७-१९", "content_sanskrit": "समिद्धमाहितं वह्निं कृत्वा परिसमूहनम्।\nपरिस्तीर्य समभ्यर्च्य समिद्भिरजुहोद् द्विजः॥ ८/१७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_017/BhP_08.017.020.m4a", "display_order": 21}, {"id": 6000170021, "chapter_id": 10170, "verse_number": "८-१७-२०", "content_sanskrit": "श्रुत्वाऽश्वमेधैर्यजमानमूर्जितं बलिं भृगूणामुपकल्पितैस्ततः।\nजगाम तत्राखिलसारसम्भृतो भारेण गां संनमयन् पदे पदे॥ ८/१७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_017/BhP_08.017.021.m4a", "display_order": 22}, {"id": 6000170022, "chapter_id": 10170, "verse_number": "८-१७-२१", "content_sanskrit": "तं नर्मदायास्तट उत्तरे बलेर्यज्ञर्त्विजस्ते भृगुवत्ससंज्ञके।\nप्रवर्तयन्तो भृगवः क्रतूत्तमं व्यचक्षतारादुदितं यथा रविम्॥ ८/१७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_017/BhP_08.017.022.m4a", "display_order": 23}, {"id": 6000170023, "chapter_id": 10170, "verse_number": "८-१७-२२", "content_sanskrit": "तत्रर्त्विजो यजमानः सदस्या हतत्विषो वामनतेजसा नृप।\nसूर्यः किमायात्यथवा विभावसुः सनत्कुमारोऽथ दिदृक्षया क्रतोः॥ ८/१७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_017/BhP_08.017.023.m4a", "display_order": 24}, {"id": 6000170024, "chapter_id": 10170, "verse_number": "८-१७-२३", "content_sanskrit": "इत्थं सशिष्येषु भृगुष्वनेकधा वितर्क्यमाणो भगवान् स वामनः।\nसदण्डछत्रं सजलं कमण्डलुं विवेश बिभ्रद् हयमेधवाटम्॥ ८/१७/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_017/BhP_08.017.024.m4a", "display_order": 25, "topics": [{"text": "बलिना वामनं सत्कृत्याभिलषितवरदानप्रतिज्ञानम्", "range": "२३–३२"}]}, {"id": 6000170025, "chapter_id": 10170, "verse_number": "८-१७-२४", "content_sanskrit": "मौञ्ज्या मेखलयाऽऽवीतमुपवीताजिनोत्तरम्।\nजटिलं वामनं विप्रं मायामाणवकं हरिम्॥ ८/१७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_017/BhP_08.017.025.m4a", "display_order": 26}, {"id": 6000170026, "chapter_id": 10170, "verse_number": "८-१७-२५", "content_sanskrit": "प्रविष्टं वीक्ष्य भृगवः सशिष्यास्ते सहाग्निभिः।\nप्रत्यगृह्णन् समुत्थाय संक्षिप्तास्तस्य तेजसा॥ ८/१७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_017/BhP_08.017.026.m4a", "display_order": 27}, {"id": 6000170027, "chapter_id": 10170, "verse_number": "८-१७-२६", "content_sanskrit": "यजमानः प्रमुदितो दर्शनीयं मनोरमम्।\nरूपानुरूपावयवं तस्मा आसनमाहरत्॥ ८/१७/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_017/BhP_08.017.027.m4a", "display_order": 28}, {"id": 6000170028, "chapter_id": 10170, "verse_number": "८-१७-२७", "content_sanskrit": "स्वागतेनाभिनन्द्याथ पादौ भगवतो बलिः।\nअवनिज्यार्चयामास मुक्तसङ्गं मनोरमम्॥ ८/१७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_017/BhP_08.017.028.m4a", "display_order": 29}, {"id": 6000170029, "chapter_id": 10170, "verse_number": "८-१७-२८", "content_sanskrit": "तत्पादशौचं कलिकल्मषापहं स धर्मविन्मूर्ध्न्यदधात् सुमङ्गलम्।\nयद् देवदेवो गिरिशश्चन्द्रमौलिर्दधार मूर्ध्ना परया च भक्तया॥ ८/१७/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_017/BhP_08.017.029.m4a", "display_order": 30}, {"id": 6000170030, "chapter_id": 10170, "verse_number": null, "content_sanskrit": "बलिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_017/BhP_08.017.030.m4a", "display_order": 31}, {"id": 6000170031, "chapter_id": 10170, "verse_number": "८-१७-२९", "content_sanskrit": "स्वागतं ते नमस्तुभ्यं ब्रह्मन् किं करवाम ते।\nब्रह्मर्षीणां तपः साक्षान्मन्ये त्वाऽऽर्य वपुर्धरम्॥ ८/१७/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_017/BhP_08.017.031.m4a", "display_order": 32}, {"id": 6000170032, "chapter_id": 10170, "verse_number": "८-१७-३०", "content_sanskrit": "अद्य नः पितरस्तृप्ता अद्य नः पावितं कुलम्।\nअद्य स्विष्टः क्रतुरयं यद् भवानागतो गृहान्॥ ८/१७/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_017/BhP_08.017.032.m4a", "display_order": 33}, {"id": 6000170033, "chapter_id": 10170, "verse_number": "८-१७-३१", "content_sanskrit": "अद्याग्नयो मे सुहुता यथाविधि द्विजात्मज त्वच्चरणावनेजनैः।\nहतांहसो वार्भिरियं च भूमिरद्धा पुनीता तनुभिः पदैस्तव॥ ८/१७/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_017/BhP_08.017.033.m4a", "display_order": 34}, {"id": 6000170034, "chapter_id": 10170, "verse_number": "८-१७-३२", "content_sanskrit": "यद् यद् वटो वाञ्छसि तत् प्रतीच्छ मे त्वामर्थिनं विप्रसुतानुतर्कये।\nगां काञ्चनं गुणवद् वाऽथ धाम मृष्टं तथाऽन्नमुत वा विप्रकन्याम्।\nग्रामान् समृद्धान् तुरगान् गजान् वा रथांस्तथाऽर्हत्तम संप्रतीच्छ॥ ८/१७/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_017/BhP_08.017.034.m4a", "display_order": 35}, {"id": 6000170035, "chapter_id": 10170, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् अष्टमस्कन्धे सप्तदशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]