[{"id": 900009483, "chapter_id": 8745, "verse_number": "3.1", "content_sanskrit": "नन्वेतदयुक्तं विवरणे श्रवणमङ्गि, प्रमाणस्य प्रमेयावगमं प्रत्यव्यवधानात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900009484, "chapter_id": 8745, "verse_number": "3.2", "content_sanskrit": "यच्चोक्तं विवरणे श्रवणादीनां विषयावगमं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900009485, "chapter_id": 8745, "verse_number": "3.3", "content_sanskrit": "किञ्च न तावच्छक्तितात्पर्यावधारणं वा तद्विशिष्टशब्दावधारणं वा ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900009486, "chapter_id": 8745, "verse_number": "3.4", "content_sanskrit": "केचित्तु अधीतात्स्वाध्यायात्प्रयोजनवदर्थदर्शनात्तन्निर्णयाय पुरुषः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900009487, "chapter_id": 8745, "verse_number": "3.5", "content_sanskrit": "यच्चोक्तं विवरणे– श्रवणविधिरेव विचारविधायक इति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900009488, "chapter_id": 8745, "verse_number": "3.6", "content_sanskrit": "यत्तु भामत्युक्तम् ‘श्रवणादिविध्यभावादध्ययनविधिरेव काण्डद्वयविचराक्षेपकः’ इति..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900009489, "chapter_id": 8745, "verse_number": "3.7", "content_sanskrit": "अस्माकं तु– श्रवणं शब्दजं ज्ञानमुपपत्त्यनुचिन्तनम् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900009490, "chapter_id": 8745, "verse_number": "3.8", "content_sanskrit": "अत्र परैरुक्तं– ‘अनिच्छतोऽपि दुर्गन्धादिज्ञानदर्शनात् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900009491, "chapter_id": 8745, "verse_number": "3.9", "content_sanskrit": "यच्चोक्तम्– ‘तत्त्वमसि’ इत्यादिवाक्यादेवापरोक्षधीः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]