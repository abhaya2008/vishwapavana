[{"id": 2098758, "chapter_id": 3114, "verse_number": "१३-२४४-१", "content_sanskrit": "महेश्वर उवाच।\nअनुद्विग्नमतेर्जन्तोरस्मिन्संसारमण्डले।\nशोकव्याधिजरादुःखैर्निर्वाणं नोपपद्यते॥\nतस्मादुद्वेगजननं मनोऽवस्थानपं तथा।\nज्ञानं ते सम्प्रवक्ष्यामि तन्मूलममृतं हि वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2098759, "chapter_id": 3114, "verse_number": "१३-२४४-३", "content_sanskrit": "शोकस्थानसहस्राणि भयस्थानशतानि च।\nदिवसेदिवसे मूढमाविशन्ति न पण्डितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2098760, "chapter_id": 3114, "verse_number": "१३-२४४-४", "content_sanskrit": "नष्टे धने वा दारे वा पुत्रे पितरि वा मृते।\nअहो दुःखमिति ध्यायञ्शोकस्य पदमाव्रजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2098761, "chapter_id": 3114, "verse_number": "१३-२४४-५", "content_sanskrit": "द्रव्येषु समतीतेषु ये शुभास्तान्न चिन्तयेत्।\nताननाद्रियमाणस्य शोकबन्धः प्रणश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2098762, "chapter_id": 3114, "verse_number": "१३-२४४-६", "content_sanskrit": "सम्प्रयोगादनिष्टस्य विप्रयोगात्प्रियस्य च।\nमानुषा मानसैर्दुःखैः संयुज्यन्तेऽल्पबुद्धयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2098763, "chapter_id": 3114, "verse_number": "१३-२४४-७", "content_sanskrit": "मृतं वा यदि वा नष्टं योऽतीतमनुशोचति।\nसन्तापेन च युज्येत तच्चास्य न निवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2098764, "chapter_id": 3114, "verse_number": "१३-२४४-८", "content_sanskrit": "उत्पन्नमिह मानुष्ये गर्भप्रभृति मानवम्।\nविविधान्युपवर्तन्ते दुःखानि च सुखानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2098765, "chapter_id": 3114, "verse_number": "१३-२४४-९", "content_sanskrit": "तयोरेकतरो मार्गो यद्येनमभिसंनमेत्।\nसुखं प्राप्य न संहृष्येन्न दुःखं प्राप्य संज्वरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2098766, "chapter_id": 3114, "verse_number": "१३-२४४-१०", "content_sanskrit": "दोषदर्शी भवेत्तत्र यत्र स्नेहः प्रवर्तते।\nअनिष्टेनान्वितं पश्येद्यथा क्षिप्रं विरज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2098767, "chapter_id": 3114, "verse_number": "१३-२४४-११", "content_sanskrit": "यथा काष्ठं च काष्ठं च समेयातां महोदधौ।\nसमेत्य च व्यपेयातां तद्वज्ज्ञातिसमागमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2098768, "chapter_id": 3114, "verse_number": "१३-२४४-१२", "content_sanskrit": "अदर्शनादापतिताः पुनश्चादर्शनं गताः।\nस्नेहस्तत्र न कर्तव्यो विप्रयोगो हि तैर्ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2098769, "chapter_id": 3114, "verse_number": "१३-२४४-१३", "content_sanskrit": "कुटुम्बपुत्रदारांश्च शरीरं धनसञ्चयम्।\nऐश्वर्यं स्वस्तिता चेति न मुह्येत्तत्र पण्डितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2098770, "chapter_id": 3114, "verse_number": "१३-२४४-१४", "content_sanskrit": "सुखमेकान्ततो नास्ति शक्रस्यापि त्रिविष्टपे।\nतत्रापि सुमहद्दुःखं न नित्यं लभते सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2098771, "chapter_id": 3114, "verse_number": "१३-२४४-१५", "content_sanskrit": "सुखस्यान्तरं दुःखं दुःखस्यानन्तरं सुखम्।\nक्षया निचयाः सर्वे पतनान्ताः समुच्छ्रयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2098772, "chapter_id": 3114, "verse_number": "१३-२४४-१६", "content_sanskrit": "संयोगा *********** मरणान्तं च जीवितम्।\nउच्छ्रयांश्च निपाताश्च दृष्ट्या प्रत्यक्षतस्त्रयम्।\nअनित्यमसुखं चेति व्यवस्येत्सर्वमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2098773, "chapter_id": 3114, "verse_number": "१३-२४४-१७", "content_sanskrit": "अर्थानामार्जने दुःखमार्जितानां तु रक्षणे।\nनाशे दुःखं व्यये दुःखं धिगर्थं दुःखभाजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2098774, "chapter_id": 3114, "verse_number": "१३-२४४-१८", "content_sanskrit": "अर्थवन्तं नरं नित्यं पञ्चाभिघ्नन्ति शत्रवः।\nराजा चोरश्च दायादा भूतानि क्षय एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2098775, "chapter_id": 3114, "verse_number": "१३-२४४-१९", "content_sanskrit": "अर्थमेव ह्यनर्थस्य मूलमित्यवधारय।\nन ह्यनर्थाः प्रबाधन्ते नरमर्तविवर्जितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2098776, "chapter_id": 3114, "verse_number": "१३-२४४-२०", "content_sanskrit": "अर्थप्राप्तिर्महद्दुःखमाकिञ्चिन्यं परं सुखम्।\nउपद्रवेषु चार्थानां दुःखं हि नियतं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2098777, "chapter_id": 3114, "verse_number": "१३-२४४-२१", "content_sanskrit": "धनलोभेन तृष्णाया न तृप्तिरुपलभ्यते।\nलब्धाश्रयो विवर्धेत समिद्ध इव पावकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2098778, "chapter_id": 3114, "verse_number": "१३-२४४-२२", "content_sanskrit": "जित्वाऽपि पृथिवीं कृत्स्नां चतुःसागरमेखलाम्।\nसागराणां पुनः पारं जेतुमिच्छत्यसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2098779, "chapter_id": 3114, "verse_number": "१३-२४४-२३", "content_sanskrit": "अलं परिग्रहेणेह दोषवान्हि परिग्रहः।\nकोशकारः क्रिमिर्देवि बध्यते हि परिग्रहात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2098780, "chapter_id": 3114, "verse_number": "१३-२४४-२४", "content_sanskrit": "एकोऽपि पृथिवीं कृत्स्नामेकच्छत्रां प्रशास्ति च।\nएकस्मिन्नेव राष्ट्रे तु स चापि निवसेन्नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2098781, "chapter_id": 3114, "verse_number": "१३-२४४-२५", "content_sanskrit": "तस्मिन्राष्ट्रेऽपि नगरमेकमेवाधितिष्ठति।\nनगरेऽपि गृहं चैकं भवेत्तस्य निवेशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2098782, "chapter_id": 3114, "verse_number": "१३-२४४-२६", "content_sanskrit": "एक एव प्रतिष्ठः स्यादावासस्तद्गृहेऽपि च।\nआवासे शयनं चैकं निशि यत्र प्रलीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2098783, "chapter_id": 3114, "verse_number": "१३-२४४-२७", "content_sanskrit": "शयनस्यार्धमेवास्य स्त्रियाश्चार्धं विधीयते।\nतदनेन प्रसङ्गेन स्वल्पेनैव हि युज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2098784, "chapter_id": 3114, "verse_number": "१३-२४४-२८", "content_sanskrit": "सर्वं ममेति सम्मूढो बलं पश्यति बालिशः।\nएवं सर्वोपयोगेषु स्वल्पमस्य प्रयोजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2098785, "chapter_id": 3114, "verse_number": "१३-२४४-२९", "content_sanskrit": "तण्डुलप्रस्थमात्रेण यात्रा स्यात्सर्वदेहिनाम्।\nततो भूयस्तरो योगो दुःखाय तपनाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2098786, "chapter_id": 3114, "verse_number": "१३-२४४-३०", "content_sanskrit": "नास्ति तृष्णासमं दुःखं नास्ति त्यागसमं सुखम्।\nसर्वान्कामान्परित्यज्य ब्रह्मभूयाय कल्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2098787, "chapter_id": 3114, "verse_number": "१३-२४४-३१", "content_sanskrit": "या दुस्त्यजा दुर्मतिभिर्या न जीर्यति जीर्यतः।\nयोऽसौ प्राणान्तिको रोगस्तां तृष्णां त्यजतः सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2098788, "chapter_id": 3114, "verse_number": "१३-२४४-३२", "content_sanskrit": "न जातु कामः कामानामुपभोगेन शाम्यति।\nहविषा कुष्णवर्त्मेव भूय एवाभिवर्धते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2098789, "chapter_id": 3114, "verse_number": "१३-२४४-३३", "content_sanskrit": "अलाभेनैव कामानां शोकं त्यजति पण्डितः।\nआयासविटपस्तीव्रः कामाग्निः कर्षणारणिः।\nइन्द्रियार्थैश्च सम्मोह्य दहत्यकुशलं जनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2098790, "chapter_id": 3114, "verse_number": "१३-२४४-३४", "content_sanskrit": "यत्पृथिव्यां व्रीहियवं हिरण्यं पशवः स्त्रियः।\nनालमेकस्य पर्याप्तमिति पश्यन्न मुह्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2098791, "chapter_id": 3114, "verse_number": "१३-२४४-३५", "content_sanskrit": "यच्च कामसुखं लोके यच्च दिव्यं महत्सुखम्।\nतृष्णाक्षयसुखस्यैते नार्हतः षोडशीं कलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2098792, "chapter_id": 3114, "verse_number": "१३-२४४-३६", "content_sanskrit": "इन्द्रियाणीन्द्रियार्थेषु नैव धीरो नियोजयेत्।\nमनःषष्ठानि संयम्य नित्यमात्मनि योजयेत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2098793, "chapter_id": 3114, "verse_number": "१३-२४४-३७", "content_sanskrit": "इन्द्रियाणां विसर्गेण दोषमृच्छत्यसंशयम्।\nसंनियम्य नु तान्येव ततः सिद्धिमवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2098794, "chapter_id": 3114, "verse_number": "१३-२४४-३८", "content_sanskrit": "षण्णामात्मनि युक्तानामैश्वर्यं योऽधिगच्छति।\nन च पापैर्न चानर्थैः संयुज्येत विचक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2098795, "chapter_id": 3114, "verse_number": "१३-२४४-३९", "content_sanskrit": "अप्रमत्तः सदा रक्षेदिन्द्रियाणि विचक्षणः।\nअरक्षितेषु तेष्वाशु नरो नरकमेति हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2098796, "chapter_id": 3114, "verse_number": "१३-२४४-४०", "content_sanskrit": "हृदि काममयश्चित्रो मोहसञ्चयसम्भवः।\nअज्ञानरूढमूलस्तु विवित्सापरिषेचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2098797, "chapter_id": 3114, "verse_number": "१३-२४४-४१", "content_sanskrit": "रोषलोभमहास्कन्धः पुरा दुष्कृतसारवान्।\nआयासविटपस्तीव्रशोकपुष्पो भयाङ्कुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2098798, "chapter_id": 3114, "verse_number": "१३-२४४-४२", "content_sanskrit": "नानासङ्कल्पपत्राढ्यः प्रमादात्परिवर्धितः।\nमहतीभिः पिपासाभिः समन्तात्परिवेष्टितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2098799, "chapter_id": 3114, "verse_number": "१३-२४४-४३", "content_sanskrit": "संरोहत्यकृतप्रज्ञे पादपः कामसम्भवः।\nनैव रोहति तत्वज्ञे रूढो वा छिद्यते पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2098800, "chapter_id": 3114, "verse_number": "१३-२४४-४४", "content_sanskrit": "कृच्छ्रोपायेष्वनित्येषु निःसारेषु फलेषु च।\nदुःखादिषु दुरन्तेषु कामयोगेषु का रतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2098801, "chapter_id": 3114, "verse_number": "१३-२४४-४५", "content_sanskrit": "इन्द्रियेषु च जीर्यत्सु च्छिद्यमाने तताऽऽयुषि।\nपुरस्ताच्च स्थिते मृत्यौ किं सुखं पश्यतासुखे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2098802, "chapter_id": 3114, "verse_number": "१३-२४४-४६", "content_sanskrit": "व्याधिभिः पीड्यमानस्य नित्यं शारीरमानसैः।\nनरस्याकृतकृत्यस्य किं सुखं मरणे सति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2098803, "chapter_id": 3114, "verse_number": "१३-२४४-४७", "content_sanskrit": "सञ्चिन्वानं तमेवार्थं कामानामवितृप्तकम्।\nव्याघ्रः पशुमिवारण्ये मृत्युरादाय गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2098804, "chapter_id": 3114, "verse_number": "१३-२४४-४८", "content_sanskrit": "जन्ममृत्युजरादुःखैः सततं समभिद्रुतः।\nसंसारे पच्यमानस्तु पापान्नोद्विजते जनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2098805, "chapter_id": 3114, "verse_number": "१३-२४४-४९x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2098806, "chapter_id": 3114, "verse_number": "१३-२४४-४९", "content_sanskrit": "केनोपायेन मर्त्यानां निवर्त्येते जरान्तकौ।\nयद्यस्ति भगवन्मह्यमेतदाचक्ष्व माचिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2098807, "chapter_id": 3114, "verse_number": "१३-२४४-५०", "content_sanskrit": "तपसा वा सुमहता कर्मणा वा श्रुतेन वा।\nरसायनप्रयोगैर्वा केनात्येति जरान्तकौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2098808, "chapter_id": 3114, "verse_number": "१३-२४४-५१x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2098809, "chapter_id": 3114, "verse_number": "१३-२४४-५१", "content_sanskrit": "नैतदस्ति महाभागे जरामृत्युनिवर्तनम्।\nसर्वलोकेषु जानीहि मोक्षादन्यत्र भामिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2098810, "chapter_id": 3114, "verse_number": "१३-२४४-५२", "content_sanskrit": "न धनेन न राज्येन नोग्रेण तपसाऽपि वा।\nमरणं नातितरते विना मुक्त्या शरीरिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2098811, "chapter_id": 3114, "verse_number": "१३-२४४-५३", "content_sanskrit": "अश्वमेधसहस्राणि वाजपेयशतानि च।\nन तरन्ति जरामृत्यू निर्वाणाधिगमाद्विना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2098812, "chapter_id": 3114, "verse_number": "१३-२४४-५४", "content_sanskrit": "ऐस्वर्यं धनधान्यं च विद्यालाभस्तपस्तथा।\nरसायनप्रयोगाद्वै न तरन्ति जरान्तकौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2098813, "chapter_id": 3114, "verse_number": "१३-२४४-५५", "content_sanskrit": "दानयज्ञतपःशीलरसायनविदोऽपि वा।\nस्वाध्यायनिरता वाऽपि न तरन्ति जरान्तकौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2098814, "chapter_id": 3114, "verse_number": "१३-२४४-५६", "content_sanskrit": "देवदानवगन्धर्वकिन्नरोरगराक्षसान्।\nस्ववशे कुरुते कालो न कालस्यास्त्यगोचरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2098815, "chapter_id": 3114, "verse_number": "१३-२४४-५७", "content_sanskrit": "न ह्यहानि निवर्तन्ते न मासा न पुनः क्षपाः।\nस्रेयं प्रपद्यते ध्यानमजस्रं ध्रुवमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2098816, "chapter_id": 3114, "verse_number": "१३-२४४-५८", "content_sanskrit": "स्रवन्ति न निवर्तन्ते स्रोतांसि सरितामिव।\nआयुरादाय मर्त्यानामहोरात्रेषु सन्ततम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2098817, "chapter_id": 3114, "verse_number": "१३-२४४-५९", "content_sanskrit": "जीवितं सर्वभूतानामक्षयः क्षपयन्नसौ।\nआदित्यो ह्यस्तमभ्येति पुनः पुनरुदेति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2098818, "chapter_id": 3114, "verse_number": "१३-२४४-६०", "content_sanskrit": "यस्यां रात्र्यां व्यतीतायामायुरल्पतरं भवेत्।\nगाधोदके मत्स्य इव किन्नु तस्य कुमारता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2098819, "chapter_id": 3114, "verse_number": "१३-२४४-६१", "content_sanskrit": "मरणं हि शरीरस्य नियतं ध्रुवमेव च।\nतिष्ठन्नपि क्षणं सर्वः कालस्यैति वशं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2098820, "chapter_id": 3114, "verse_number": "१३-२४४-६२", "content_sanskrit": "न म्रियेरन्न जीर्येरन्यदि स्युः सर्वदेहिनः।\nन चानिष्टं प्रवर्तेत शोको वा प्राणिनं क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2098821, "chapter_id": 3114, "verse_number": "१३-२४४-६३", "content_sanskrit": "अप्रमत्तः प्रमत्तेषु कालो भूतेषु तिष्ठति।\nअप्रमत्तस्य कालस्य क्षयं प्राप्तो न मुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2098822, "chapter_id": 3114, "verse_number": "१३-२४४-६४", "content_sanskrit": "श्वःकार्यमद्य कुर्वीत पूर्वाह्णे चापराह्णिकम्।\nकोपि तद्वेद यत्रासौ मृत्युना नाभिवीक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2098823, "chapter_id": 3114, "verse_number": "१३-२४४-६५", "content_sanskrit": "वर्षास्विदं करिष्यामि इदं ग्रीष्मवसन्तयोः।\nइति बालश्चिन्तयति अन्तरायं न बुध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2098824, "chapter_id": 3114, "verse_number": "१३-२४४-६६", "content_sanskrit": "इदं मे स्यादिदं मे स्यादित्येवं मनसा नराः।\nअनवाप्तेषु कामेषु ह्रियन्ते मरणं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2098825, "chapter_id": 3114, "verse_number": "१३-२४४-६७", "content_sanskrit": "कालपाशेन बद्धानामहन्यहनि जीर्यताम्।\nका श्रद्धा प्राणिनां मार्गे विषमे भ्रमतां सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2098826, "chapter_id": 3114, "verse_number": "१३-२४४-६८", "content_sanskrit": "युवैव धर्मशीलः स्यादनिमित्तं हि जीवितम्।\nफलानामिव पक्वानां सदा हि पतनाद्भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2098827, "chapter_id": 3114, "verse_number": "१३-२४४-६९", "content_sanskrit": "मर्त्यस्य किं धनैर्दारैः पुत्रैर्भोगैः प्रियैरपि।\nएकाह्ना सर्वमुत्सृज्य मृत्योस्तु वशमन्वियात्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2098828, "chapter_id": 3114, "verse_number": "१३-२४४-७०", "content_sanskrit": "जायामानांश्च सम्प्रेक्ष्य म्रियमाणांस्तथैव च।\nन संवेगोस्ति चेत्पुंसः काष्ठलोसमो हि सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2098829, "chapter_id": 3114, "verse_number": "१३-२४४-७१", "content_sanskrit": "विनाशिनो ह्यध्रुवजीवितस्य\nकिं बन्धुभिर्मित्रपरिग्रहैश्च।\nविहाय यद्गच्छति सर्वमेवं\nक्षणेन गत्वा न निवर्तते च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2098830, "chapter_id": 3114, "verse_number": "१३-२४४-७२", "content_sanskrit": "एवं चिन्तयतो नित्यं सर्वार्थानामनित्यताम्।\nउद्वेगो जायते शीघ्रं निर्वाणस्य पुरस्सरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2098831, "chapter_id": 3114, "verse_number": "१३-२४४-७३", "content_sanskrit": "तेनोद्वेगेन चाप्यस्य विमर्शो जायते पुनः।\nविमर्शो नाम वैराग्यं सर्वद्रव्येषु जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2098832, "chapter_id": 3114, "verse_number": "१३-२४४-७४", "content_sanskrit": "वैराग्येण परां शान्तिं लभन्ते मानवाः शुभे।\nमोक्षस्योपनिषद्दिव्यं वैराग्यमिति निश्चितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2098833, "chapter_id": 3114, "verse_number": "१३-२४४-७५", "content_sanskrit": "एतत्ते कथितं देवि वैराग्योत्पादनं वचः।\nएवं सञ्चिन्त्य सञ्चिन्त्य मुच्यन्ते हि मुमुक्षवः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2098834, "chapter_id": 3114, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि चतुश्चत्वारिंशदधिकद्विशततमोऽध्यायः॥ २४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}]