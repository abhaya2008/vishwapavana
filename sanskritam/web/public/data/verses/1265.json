[{"id": 2012943, "chapter_id": 1265, "verse_number": "२-६-१", "content_sanskrit": "वैशमापायन उवाच।\nसम्पूज्याथाभ्यनुज्ञातो महर्षेर्वचनात्परम्।\nप्रत्युवाचानुपूर्व्येण धर्मराजो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2012944, "chapter_id": 1265, "verse_number": "२-६-२", "content_sanskrit": "भगवत्याय्यमाहैतं यथावद्धर्मनिश्चयम्।\nयथाशक्ति यथान्यायं क्रियतेऽयं विधिर्मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2012945, "chapter_id": 1265, "verse_number": "२-६-३", "content_sanskrit": "राजभिर्यद्यथा कार्यं, पुरा वै तन्न संशयः।\nयथान्यायोपनीतार्थं कृतं हेतुमदर्थवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2012946, "chapter_id": 1265, "verse_number": "२-६-४", "content_sanskrit": "वयं तु सत्पथं तेषां यातुमिच्छामहे प्रभो।\nन तु शक्यं तथा गन्तुं यथा तैर्नियतात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2012947, "chapter_id": 1265, "verse_number": "२-६-५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2012948, "chapter_id": 1265, "verse_number": "२-६-५", "content_sanskrit": "एकमुक्त्वा स धर्मात्मा वाक्यं तदभिपूज्य च।\nतं तु विश्रान्तमासीनं देवर्षिममितद्युतिम्॥\nमुहूर्तात्प्राप्तकालं च दृष्ट्वा लोकचरं मुनिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2012949, "chapter_id": 1265, "verse_number": "२-६-६", "content_sanskrit": "नादरदं सुस्थमासीनमुपासीनो युधिष्ठिरः।\nअपृच्छत्पाण्डवस्तत्र राजमध्ये माहद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2012950, "chapter_id": 1265, "verse_number": "२-६-७", "content_sanskrit": "भवात्सञ्चरते लोकान्सदा नानाविधान्बहून्।\nब्रह्मणा निर्मितान्पूर्वं प्रेक्षमाणो मनोजवः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2012951, "chapter_id": 1265, "verse_number": "२-६-८", "content_sanskrit": "ईदृशी भविता काचिद्दृष्टपूर्वा सभा क्वचित्।\nइतो वा श्रेयसी ब्रह्मंस्तन्ममाचक्ष्व पृच्छतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2012952, "chapter_id": 1265, "verse_number": "२-६-९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2012953, "chapter_id": 1265, "verse_number": "२-६-९", "content_sanskrit": "तच्छ्रुत्वा नारदस्तस्य धर्मराजस्य भाषितम्।\nपाण्डवं प्रत्युवाचेदं स्मयन्मधुरया गिरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2012954, "chapter_id": 1265, "verse_number": "२-६-१०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2012955, "chapter_id": 1265, "verse_number": "२-६-१०", "content_sanskrit": "मानुषेषु न मे तात दृष्टपूर्वा न च श्रुता।\nसभा मणिमयी राजन्यथेयं तव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2012956, "chapter_id": 1265, "verse_number": "२-६-११", "content_sanskrit": "सभां तु पितृराजस्य वरुणस्य च धीमतः।\nकथयिष्ये तथेन्द्रस्य कैलासनिलयस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2012957, "chapter_id": 1265, "verse_number": "२-६-१२", "content_sanskrit": "ब्रह्मणश्च सभां दिव्यां कथयिष्ये गतक्लमाम्।\nदिव्यादिव्यैरभिप्रायैरुपेतां विश्वरूपिणीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2012958, "chapter_id": 1265, "verse_number": "२-६-१३", "content_sanskrit": "देवैः पितृगणैः साध्यैर्यज्वभिर्नियतात्मभिः।\nजुष्टां मुनिगणैः शान्तैर्वेदयज्ञैः सदक्षिणैः॥\nयदि ते श्रवणे बुद्धिर्वर्तते भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2012959, "chapter_id": 1265, "verse_number": "२-६-१४", "content_sanskrit": "नारदेनैवमुक्तस्तु धर्मराजो युधिष्ठिरः।\nप्राञ्जलिर्भ्रातृभिः सार्धं तैश्च सर्वैर्द्विजोत्तमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2012960, "chapter_id": 1265, "verse_number": "२-६-१५", "content_sanskrit": "नारदं प्रत्यवाचेदं धर्मराजो महामनाः।\nसभाः कथय ताः सर्वाः श्रोतुमिच्छामहे वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2012961, "chapter_id": 1265, "verse_number": "२-६-१६", "content_sanskrit": "किन्द्रव्यास्ताः सभा ब्रह्मन्किंविस्ताराः किमायताः।\nपितामहं च के तस्यां सभायां पर्युपासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2012962, "chapter_id": 1265, "verse_number": "२-६-१७", "content_sanskrit": "वासवं देवराजं च यमं वैवस्वतं च के।\nवरुणं च कुबेरं च सभायां पर्युपासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2012963, "chapter_id": 1265, "verse_number": "२-६-१८", "content_sanskrit": "एतत्सर्वं यथान्यायं ब्रह्मर्षे वदतस्तव।\nश्रोतुमिच्छाम सहिताः परं कौतूहलं हि नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2012964, "chapter_id": 1265, "verse_number": "२-६-१९", "content_sanskrit": "एवमुक्तः पाण्डवेन नारदः प्रत्यभाषत।\nक्रमेण राजन्दिव्यास्ताः श्रूयन्तामिह नः सभाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2012965, "chapter_id": 1265, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि मन्त्रपर्वणि षष्ठोऽध्यायः॥ ६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]