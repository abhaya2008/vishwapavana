[{"id": 7005992000, "chapter_id": 25992, "verse_number": "१-१७५-१", "content_sanskrit": "रुद्र उवाच । एवं धन्वन्तरिर्विष्णुः सुश्रुतादीनुवाच ।\nहरिः पुनर्हरायाह नानायोगान्रुगर्दनान् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005992001, "chapter_id": 25992, "verse_number": "१-१७५-२", "content_sanskrit": "हरिरुवाच । सर्वज्वरेषु प्रथमं कार्यं शङ्कर लङघनम् ।\nक्वथितोदकपानं च तथा निर्वातसेवनम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005992002, "chapter_id": 25992, "verse_number": "१-१७५-३", "content_sanskrit": "अग्निस्वेदाज्ज्वरास्त्वेवं नाशमायान्तिहीश्वर। ।\nवातज्वरहरः क्वाथो गुडूच्या मुस्तकेन च ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005992003, "chapter_id": 25992, "verse_number": "१-१७५-४", "content_sanskrit": "दुरालभैश्चैव घृतं पित्तज्वरहरः शृणु ।\nशुण्ठीपर्पटमुस्तैश्च बालकोशीरचन्दनैः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005992004, "chapter_id": 25992, "verse_number": "१-१७५-५", "content_sanskrit": "साज्यः क्वाथः श्लेष्मजं तु सशुण्ठिः सदुरालभ ।\nसवालकः सर्वज्ज्वरं सशुण्ठिः सहपर्पटः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005992005, "chapter_id": 25992, "verse_number": "१-१७५-६", "content_sanskrit": "किराततिक्तैर्नारीगुडूचीशुण्ठिमुस्तकैः ।\nपित्तज्वरहरः स्याच्च शृण्वन्यं योगमुत्तमम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005992006, "chapter_id": 25992, "verse_number": "१-१७५-७", "content_sanskrit": "वालकोशीरपाठाभिः कण्टकारिकमुस्तकैः ।\nज्वरनुच्च कृतः क्वाथस्तथा वै सुरदारुणा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005992007, "chapter_id": 25992, "verse_number": "१-१७५-८", "content_sanskrit": "धन्याकनिम्बमुस्तानां समधुः स तु शङ्र ।\nपटोलपत्रयुक्तस्तु गुडूचीत्रिफलायुतः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005992008, "chapter_id": 25992, "verse_number": "१-१७५-९", "content_sanskrit": "पीतोऽखिलज्वरहरः क्षुधाकृद्वातनुत्तविदम् ।\nहरीतकीपिप्लीनामामलीचित्रकोद्भवम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005992009, "chapter_id": 25992, "verse_number": "१-१७५-१०", "content_sanskrit": "चूर्णं ज्वरं च क्वथितं धान्य (धन्या) कोशपपर्पटैः ।\nआमलक्या गुडूच्या च मधुयुक्तं सचन्दनम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005992010, "chapter_id": 25992, "verse_number": "१-१७५-११", "content_sanskrit": "समस्तज्वरनुच्च स्यात्सन्निपातहरं शण ।\nहरिद्रानिम्बत्रिफलामुस्तकैर्देवदारुणा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005992011, "chapter_id": 25992, "verse_number": "१-१७५-१२", "content_sanskrit": "कषायं कटुरोहिण्या सपटोलं सपत्रकम् ।\nत्रिदोषज्वरनुच्चस्यात्पीतं तु क्वथितं जलम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005992012, "chapter_id": 25992, "verse_number": "१-१७५-१३", "content_sanskrit": "कण्टकार्या नागरस्य गुडूच्या पुष्करेण च ।\nजग्ध्वा नागबलाचूर्णं श्वसकासादिनुद्भवेत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005992013, "chapter_id": 25992, "verse_number": "१-१७५-१४", "content_sanskrit": "कफवातज्वरे देयं जलमुष्णं पिपासिने ।\nविश्वपर्पटकोशीरमुस्तचन्दनसाधितम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005992014, "chapter_id": 25992, "verse_number": "१-१७५-१५", "content_sanskrit": "दद्यात्सुशीतलं वारि तृट्छर्दिज्वरदाहनुत् ।\nबिल्वादिप पञ्चमूलस्य क्वाथः स्याद्वातिके ज्वरे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005992015, "chapter_id": 25992, "verse_number": "१-१७५-१६", "content_sanskrit": "पाचनं पिप्पलीमूलं गुडृचीविश्वभेषजम् ।\nवातज्वरे त्वयं क्वाथो दत्तः शान्तिकरः परः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005992016, "chapter_id": 25992, "verse_number": "१-१७५-१७", "content_sanskrit": "पित्तज्वरघ्नः समधुः क्वाथः पर्पटनिम्बयोः ।\nविधाने क्रियमाणेऽपि य्सय संज्ञा न जायते ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005992017, "chapter_id": 25992, "verse_number": "१-१७५-१८", "content_sanskrit": "पादयोस्तु ललाटे वा दहेल्लौहशलाकया ।\nतिक्ता पाठा पर्पटाश्च विशाला त्रिफला त्रवत् ।\nसक्षीरो भेदनः क्वाथः सर्वज्वरविशोधनः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]