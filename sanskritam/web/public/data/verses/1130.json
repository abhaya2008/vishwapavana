[{"id": 2006567, "chapter_id": 1130, "verse_number": "१-१३१-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2006568, "chapter_id": 1130, "verse_number": "१-१३१-१", "content_sanskrit": "ज्येष्ठाऽनुज्येष्ठतां तेषां नामानि च पृथक्पृथक्।\nधृतराष्ट्रस्य पुत्राणामानुपूर्व्यात्प्रकीर्तय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2006569, "chapter_id": 1130, "verse_number": "१-१३१-२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2006570, "chapter_id": 1130, "verse_number": "१-१३१-२", "content_sanskrit": "दुर्योधनो युयुत्सुश्च राजन्दुःशासनस्तथा।\nदुःसहो दुःशलश्चैव जलसन्धः समः सहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2006571, "chapter_id": 1130, "verse_number": "१-१३१-३", "content_sanskrit": "विन्दानुविन्दौ दुर्धर्षः सुबाहुर्दुष्प्रधर्षणः।\nदुर्मर्षणो दुर्मुखश्च दुष्कर्णः कर्ण एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2006572, "chapter_id": 1130, "verse_number": "१-१३१-४", "content_sanskrit": "विविंशतिर्विकर्णश्च शलः सत्वः सुलोचनः।\nचित्रोपचित्रौ चित्राक्षश्चारुचित्रः शरासनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2006573, "chapter_id": 1130, "verse_number": "१-१३१-५", "content_sanskrit": "दुर्मदो दुर्विगाहश्च विवित्सुर्विकटाननः।\nऊर्णनाभः सुनाभश्च तथा नन्दोपनन्दकौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2006574, "chapter_id": 1130, "verse_number": "१-१३१-६", "content_sanskrit": "चित्रबाणश्चित्रवर्मा सुवर्मा दुर्विमोचनः।\nअयोबाहुर्महाबाहुश्चित्राङ्गश्चित्रकुण्डलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2006575, "chapter_id": 1130, "verse_number": "१-१३१-७", "content_sanskrit": "भीमवेगो भीमबलो बलाकी बलवर्धनः।\nउग्रायुधः सुषेणश्च कुण्डधारो महोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2006576, "chapter_id": 1130, "verse_number": "१-१३१-८", "content_sanskrit": "चित्रायुधो निषङ्गी च पाशी वृन्दारकस्तथा।\nदृढवर्मा दृढक्षत्रः सोमकीर्तिरनूदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2006577, "chapter_id": 1130, "verse_number": "१-१३१-९", "content_sanskrit": "दृढसन्धो जरासन्धः सत्यसन्धः सदः सुवाक्।\nउग्रश्रवा उग्रसेनः सेनानीर्दुष्पराजयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2006578, "chapter_id": 1130, "verse_number": "१-१३१-१०", "content_sanskrit": "अपराजितः कुण्डशायी विशालाक्षो दुराधरः।\nदृढहस्तः सुहस्तश्च वातवेगसुवर्चसौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2006579, "chapter_id": 1130, "verse_number": "१-१३१-११", "content_sanskrit": "आदित्यकेतुर्बह्वाशी नागदत्तोऽग्रयाय्यपि।\nकवची क्रथनः कुण्डी कुण्डधारो धनुर्धरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2006580, "chapter_id": 1130, "verse_number": "१-१३१-१२", "content_sanskrit": "उग्रभीमरथौ वीरौ वीरबाहुरलोलुपः।\nअभयो रौद्रकर्मा च तथा दृढरथाश्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2006581, "chapter_id": 1130, "verse_number": "१-१३१-१३", "content_sanskrit": "अनाधृष्यः कुण्डभेदी विरावी चित्रकुण्डलः।\nप्रमथश्च प्रमाथी च दीर्घरोमश्च वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2006582, "chapter_id": 1130, "verse_number": "१-१३१-१४", "content_sanskrit": "दीर्घबाहुर्महाबाहुर्व्यूढोराः कनकध्वजः।\nकुण्डाशी विराजाश्चैव दुःशला च शताधिका॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2006583, "chapter_id": 1130, "verse_number": "१-१३१-१५", "content_sanskrit": "इति पुत्रशतं राजन्कन्या चैव शताधिका।\nनामधेयानुपूर्व्येण विद्धि जन्मक्रमं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2006584, "chapter_id": 1130, "verse_number": "१-१३१-१६", "content_sanskrit": "सर्वे त्वतिरथाः शूराः सर्वे युद्धविशारदाः।\nसर्वे वेदविदश्चैव सर्वे सर्वास्त्रकोविदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2006585, "chapter_id": 1130, "verse_number": "१-१३१-१७", "content_sanskrit": "सर्वेषामनुरूपाश्च कृता दारा महीपते।\nधृतराष्ट्रेण समये परीक्ष्य विविवन्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2006586, "chapter_id": 1130, "verse_number": "१-१३१-१८", "content_sanskrit": "दुःशलां चापि समये धृतराष्ट्रो नराधिपः।\nजयद्रथाय प्रददौ विधिना भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2006587, "chapter_id": 1130, "verse_number": "१-१३१-१९", "content_sanskrit": "इति पुत्रशतं राजन्युयुत्सुश्च शताधिकः।\nकन्यका दुःशला चैव यथावत्कीर्तितं मया॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2006588, "chapter_id": 1130, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि एकत्रिंशदधिकशततमोऽध्यायः॥ १३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]