[{"id": 2112421, "chapter_id": 3424, "verse_number": "", "content_sanskrit": "विचित्रवीर्यस्याम्बकयाऽम्बालिकया च विवाहः । तस्य मरणम् ।\nतयोः सुतोत्पत्त्या भीष्मेण निराकरणं च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2112422, "chapter_id": 3424, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2112423, "chapter_id": 3424, "verse_number": "१", "content_sanskrit": "अम्बायां निर्गतायां तु भीष्मः शन्तनवस्तदा ।\nन्यायेन कारयामास राज्ञो वैवाहिकीं क्रियाम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2112424, "chapter_id": 3424, "verse_number": "२", "content_sanskrit": "अम्बिकाम्बालिके चैव परिणीयाग्निसन्निधौ ।\nतयोः पाणी गृहीत्वा तु कौरव्यो रूपदर्पितः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2112425, "chapter_id": 3424, "verse_number": "३", "content_sanskrit": "विचित्रवीर्यो धर्मात्मा कामात्मा समपद्यत ।\nते चापि वनिते श्लाघ्ये नीलकुञ्चितमूर्धजे \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2112426, "chapter_id": 3424, "verse_number": "४", "content_sanskrit": "रक्ततुङ्गनखे श्यामे पीनश्रोणिपयोधरे ।\nआत्मरूपानुरुपो नौ लब्धः पतिरिति स्म ते \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2112427, "chapter_id": 3424, "verse_number": "५", "content_sanskrit": "विचित्रवीर्यं कल्याणं ते ततोऽभिरते ह्युभे ।\nअन्योन्यं प्रीतिसक्ते च एकभावाविव स्थिते \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2112428, "chapter_id": 3424, "verse_number": "६", "content_sanskrit": "स चापि रूपसदृशो देवसत्वपराक्रमः ।\nसर्वासामेव नारीणां चित्तप्रमथनो रहः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2112429, "chapter_id": 3424, "verse_number": "७", "content_sanskrit": "ताभ्यां सह समासक्तो विहृत्य पृथिवीपतिः ।\nविचित्रवीर्यस्तरुणो यक्ष्माणं समपद्यत \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2112430, "chapter_id": 3424, "verse_number": "८", "content_sanskrit": "सुहृदां यतमानानामाप्तैः सह चिकित्सकैः ।\nजगामास्तमिवादित्यः कौरव्यो यमसादनम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2112431, "chapter_id": 3424, "verse_number": "९", "content_sanskrit": "तस्य प्रेतस्य कार्याणि भीष्मः सर्वाण्यकारयत् ।\nराज्ञो विचित्रवीर्यस्य सत्यवत्या मते स्थितः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2112432, "chapter_id": 3424, "verse_number": "१०", "content_sanskrit": "ऋत्विग्भिः सहितो भीष्मः सर्वैश्च कुरुजाङ्गलैः ।\nततः सत्यवती दीना कृपणा पुत्रगर्धिनी \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2112433, "chapter_id": 3424, "verse_number": "११", "content_sanskrit": "कृत्वा प्रेतस्य कृत्यानि स्नुषाभ्यां सहिता तदा ।\nमाता सत्यवती भीष्ममुवाच वदतां वरा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2112434, "chapter_id": 3424, "verse_number": "१२", "content_sanskrit": "धर्मं च पितृवंशं च मातृवंशं च शोभनम् ।\nसत्यवत्यभिसम्प्रेक्ष्य भीष्मं वचनमब्रवीत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2112435, "chapter_id": 3424, "verse_number": "१३", "content_sanskrit": "दुःखार्दिता तु शोकेन मज्जतीव च सागरे ।\nशन्तनोर्धर्मनित्यस्य पौरवस्य यशस्विनः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2112436, "chapter_id": 3424, "verse_number": "", "content_sanskrit": "सत्यवती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2112437, "chapter_id": 3424, "verse_number": "१४", "content_sanskrit": "त्वयि कीर्तिश्च पिण्डश्च सन्तानश्च प्रतिष्ठितः ।\nभ्राता विचित्रवीर्यस्ते भूतानामन्तमेयिवान् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2112438, "chapter_id": 3424, "verse_number": "१५", "content_sanskrit": "यथा कर्म शुभं कृत्वा स्वर्गाय गमनं ध्रुवम् ।\nयथा चायुर्ध्रुवं सत्वे त्वयि धर्मस्तथा ध्रुवः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2112439, "chapter_id": 3424, "verse_number": "१६", "content_sanskrit": "वेत्थ धर्मस्य तत्वं च सामान्यस्येतरस्य च ।\nविविधाश्च स्मृतीर्वेत्थ वेदाङ्गानि च सर्वशः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2112440, "chapter_id": 3424, "verse_number": "१७", "content_sanskrit": "व्यवसायं च धर्मेपु कुलाचारं च लक्षयेः ।\nप्रतिपत्तिं च कृच्छ्रेषु शुक्राङ्गिरसयोरिव\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2112441, "chapter_id": 3424, "verse_number": "१८", "content_sanskrit": "तस्मात् सुभृशमैश्वर्यं त्वयि धर्मवतां वर ।\nवक्ष्यामि त्वां यथा प्राज्ञ तच्छ्रुत्वा कर्तुमर्हसि \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2112442, "chapter_id": 3424, "verse_number": "१९", "content_sanskrit": "मम पुत्रस्तव भ्राता यवीयान् कुलवंशभृत् ।\nबाल एव गतः स्वर्गमपुत्रः पुरुषर्षभ\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2112443, "chapter_id": 3424, "verse_number": "२०", "content_sanskrit": "तस्य ते च महिष्यौ द्वे काशिराजसुते शुभे ।\nरूपयौवनसम्पन्ने पुत्रकामे च भारत\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2112444, "chapter_id": 3424, "verse_number": "२१", "content_sanskrit": "धर्ममेतत् परं ज्ञात्वा सन्तानाय कुलस्य च ।\nतयोरुत्पादयापत्यं सन्तानकुलवर्धनम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2112445, "chapter_id": 3424, "verse_number": "२२", "content_sanskrit": "मन्नियोगान्महाभाग धर्म्यं कर्तुमिहार्हसि ।\nराजन् राज्येऽभिषिञ्चस्व भारताननुशाधि च ।\nदारांश्च कुरु कौरव्य मा त्वं हिंसीः पितामहान्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2112446, "chapter_id": 3424, "verse_number": "", "content_sanskrit": "वैशम्पयनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2112447, "chapter_id": 3424, "verse_number": "२३", "content_sanskrit": "तथोच्यमानो मात्रा च सुहृद्भिश्च परन्तपः ।\nप्रत्युवाच स धर्मात्मा धर्ममेव ततः परम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2112448, "chapter_id": 3424, "verse_number": "२४", "content_sanskrit": "असंशयं परो धर्मस्त्वया मातः प्रकीर्तितः ।\nराज्यार्थे नाभिषिञ्चेयं नोपेयां जातु मैथुनम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2112449, "chapter_id": 3424, "verse_number": "२५", "content_sanskrit": "भवत्या मतमाज्ञाय कृतमेतद् व्रतं मया ।\nजानीषे यत् तदा वृत्तं शुल्कहेतोस्तदन्तरे \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2112450, "chapter_id": 3424, "verse_number": "२६", "content_sanskrit": "स सत्यवति सत्येन पुनरेव ब्रवीमि ते ।\nपरित्यजेयं त्रैलोक्यं राज्यं देवेषु वा पुनः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2112451, "chapter_id": 3424, "verse_number": "२७", "content_sanskrit": "यद्वा ह्मधिकमेताभ्यां न तु सत्यं कथञ्चन ।\nत्यजेच्च पृथिवी गन्धमापश्च रसमात्मजम् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2112452, "chapter_id": 3424, "verse_number": "२८", "content_sanskrit": "ज्योतिस्तथा त्यजेद् रूपं वायुस्स्पर्शगुणं त्यजेत् ।\nप्रतापमुत्सृजेदर्को धूमकेतुस्तथोष्णताम् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2112453, "chapter_id": 3424, "verse_number": "१९", "content_sanskrit": "त्यजेच्छब्दं तथाऽऽकाशश्चन्द्रः शीतांशुतां त्यजेत् ।\nवृत्रहा विक्रमं जह्माद् धर्मं जह्याच्च धर्मराट्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2112454, "chapter_id": 3424, "verse_number": "३०", "content_sanskrit": "न त्वहं सत्यमृत्स्रष्टुं व्यवस्येयं कथञ्चन ।\nतन्नजात्वन्यथा कुर्यां लोकानामपि सङ्क्षये ।\nअमरत्वस्य वा हेतोस्त्रैलोक्यसदनस्य वा \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2112455, "chapter_id": 3424, "verse_number": "", "content_sanskrit": "वैशम्पयनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2112456, "chapter_id": 3424, "verse_number": "३१", "content_sanskrit": "तथोच्यमाना पुत्रेण धार्मिकेन महात्मना ।\nमाता सत्यवती भीष्मं पुनरेवाभ्यभाषत \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2112457, "chapter_id": 3424, "verse_number": "३२", "content_sanskrit": "अनुजानीहि धर्मज्ञ सत्यं सत्यवतां वर ।\nइच्छन् सृजेथास्त्रीन् लोकानन्यांश्च स्वेन तेजसा\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2112458, "chapter_id": 3424, "verse_number": "३३", "content_sanskrit": "जानामि चैव तत् सर्वं मदर्थं यदभाषथाः ।\nआपद्धर्ममवेक्षस्व वह पैतामहीं धुरम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2112459, "chapter_id": 3424, "verse_number": "३४", "content_sanskrit": "यथा तु नः कुलं चैव लोकश्च न पराभवेत् ।\nसुहृदश्च सकामा वै तथा त्वं कर्तुमर्हसि ।\nआत्मनश्च हितं तात प्रियं च मम भारत \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2112460, "chapter_id": 3424, "verse_number": "१०३", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nत्र्योत्तरशततमोऽध्यायः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2112461, "chapter_id": 3424, "verse_number": "५१", "content_sanskrit": "॥ इति सम्भवपर्वणि एकपञ्चाशोऽध्यायः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2112462, "chapter_id": 3424, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]