[{"id": 2077545, "chapter_id": 2643, "verse_number": "१२-१४८-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2077546, "chapter_id": 2643, "verse_number": "१२-१४८-१", "content_sanskrit": "वमानस्थौ तु तौ राजंल्लुब्धकः ग्वे ददर्श ह।\nदृष्ट्वा तौ दंपती राजन्व्यचिन्तयत तां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2077547, "chapter_id": 2643, "verse_number": "१२-१४८-२", "content_sanskrit": "कीदृशेनेह तपसा गच्छेयं परमां गतिम्।\nइति बुद्ध्या विनिश्चित्य गमनायोपचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2077548, "chapter_id": 2643, "verse_number": "१२-१४८-३", "content_sanskrit": "महाप्रस्थानमाश्रित्य लुब्धकः पक्षिजीवकः।\nनिश्चष्टो मरुदाहारो निर्ममः स्वर्गकाङ्क्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2077549, "chapter_id": 2643, "verse_number": "१२-१४८-४", "content_sanskrit": "ततोऽपश्यत्सुविस्तीर्णं हृद्यं पद्माभिभूषितम्।\nनानापक्षिगणाकीर्णं सरः शीतजलं शिवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2077550, "chapter_id": 2643, "verse_number": "१२-१४८-५", "content_sanskrit": "पिपांसार्तोऽपि तदृष्ट्वा तृप्तः स्यान्नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2077551, "chapter_id": 2643, "verse_number": "१२-१४८-६", "content_sanskrit": "उपवासकृशोऽत्यर्थं स तु पार्थिव लुब्धकः।\nउपसृत्य तु तद्धृष्टः श्वापदाध्युपितं वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2077552, "chapter_id": 2643, "verse_number": "१२-१४८-७", "content_sanskrit": "महान्तं निश्चयं कृत्वा लुब्धकः प्रविवेश ह।\nप्रविशन्नेव स वनं निगृहीतः स कण्टकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2077553, "chapter_id": 2643, "verse_number": "१२-१४८-८", "content_sanskrit": "स कण्टकैर्विभिन्नाङ्गो लोहितार्द्रीकृतच्छविः।\nवभ्राम तस्मिन्विजने नानामृगसमाकुले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2077554, "chapter_id": 2643, "verse_number": "१२-१४८-९", "content_sanskrit": "ततो द्रुमाणां महतां पवनेन वने तदा।\nउदतिष्ठत संघर्षान्सुमहान्हव्यवाहनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2077555, "chapter_id": 2643, "verse_number": "१२-१४८-१०", "content_sanskrit": "तद्वनं वृक्षसंकीर्णं लताविटपसंकुलम्।\nददाह पावकः क्रुद्धो युगान्ताग्निसमप्रभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2077556, "chapter_id": 2643, "verse_number": "१२-१४८-११", "content_sanskrit": "स ज्वलैः पवनोद्भूतैर्विस्फुलिङ्गैः समन्ततः।\nददाह तद्वनं घोरं मृगपक्षिसमाकुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2077557, "chapter_id": 2643, "verse_number": "१२-१४८-१२", "content_sanskrit": "ततः स देहमोक्षार्थं संप्रहृष्टेन चेतसा।\nअभ्यधावत वर्धन्तं पावकं लुब्धकस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2077558, "chapter_id": 2643, "verse_number": "१२-१४८-१३", "content_sanskrit": "ततस्तेनाग्निना दग्धो लुब्धको नष्टकल्मषः।\nजगाम परमां सिद्धिं ततो भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2077559, "chapter_id": 2643, "verse_number": "१२-१४८-१४", "content_sanskrit": "ततः स्वर्गस्थमात्मानमपश्यद्विगतज्वरः।\nयक्षगन्धर्वसिद्धानां मध्ये भ्राजन्तमिन्द्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2077560, "chapter_id": 2643, "verse_number": "१२-१४८-१५", "content_sanskrit": "एवं खलु कपोतश्च कपोती च पतिव्रता।\nलुब्धकेन सह स्वर्गं गताः पुण्येन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2077561, "chapter_id": 2643, "verse_number": "१२-१४८-१६", "content_sanskrit": "याऽन्या चैवंविधा नारी भर्तारमनुवर्तते।\nविराजते हि सा क्षिप्रं कपोतीव दिवि स्थिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2077562, "chapter_id": 2643, "verse_number": "१२-१४८-१७", "content_sanskrit": "एवमेतत्पुरावृत्तं लुब्धकस्य महात्मनः।\nकपोतस्य च धर्मिष्ठा गतिः पुण्येन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2077563, "chapter_id": 2643, "verse_number": "१२-१४८-१८", "content_sanskrit": "यश्चेदं शृणुयान्नित्यं यश्चेदं परिकीर्तयेत्।\nनाशुभं विद्यते तस्य मनसाऽपि प्रमादतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2077564, "chapter_id": 2643, "verse_number": "१२-१४८-१९", "content_sanskrit": "युधिष्ठिर महानेष धर्मो धर्मभृतां वर।\nगोघ्नेष्वपि भवेदस्मिन्निष्कृतिः पापकर्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2077565, "chapter_id": 2643, "verse_number": "१२-१४८-२०", "content_sanskrit": "न निष्कृतिर्भवेत्तस्य यो हन्याच्छरणागतम्।\nइतिहासमिमं श्रुत्वा पुण्यं पापप्रणाशनम्।\nन दुर्गतिप्रवाप्नोति स्वर्गलोकं च गच्छति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2077566, "chapter_id": 2643, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि अष्टचत्वारिंशदधिकशततमोऽध्यायः॥ १४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]