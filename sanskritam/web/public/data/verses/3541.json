[{"id": 2118030, "chapter_id": 3541, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2118031, "chapter_id": 3541, "verse_number": "१", "content_sanskrit": "ततः कतिपयाहःसु तत्र रैवतके गिरौ ।\nवृष्ण्यन्धकानामभवत् सुमहानुत्सवो नृप \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2118032, "chapter_id": 3541, "verse_number": "२", "content_sanskrit": "तत्र दानं ददुर्वीरा ब्राह्मणानां सहस्रशः ।\nभोजवृष्ण्यन्धकाश्चैव महे तस्मिन् गिरौ तदा \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2118033, "chapter_id": 3541, "verse_number": "३", "content_sanskrit": "प्रासादै रत्नचित्रैस्तु गिरेस्तस्य समन्ततः ।\nस देशः शोभितो राजन् दीपवृक्षैः समन्ततः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2118034, "chapter_id": 3541, "verse_number": "४", "content_sanskrit": "वादित्राणि च तत्र स्म वादकाः समवादयन् ।\nननृतुर्नर्तकाश्चैव जगुर्गीतानि गायकाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2118035, "chapter_id": 3541, "verse_number": "५", "content_sanskrit": "अलङ्कृताः कुमाराश्च वृष्णीनां सुमहौजसः ।\nयानैर्हाटकचित्राङ्गैश्चञ्चूर्यन्ते स्म सर्वशः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2118036, "chapter_id": 3541, "verse_number": "६", "content_sanskrit": "पौराश्च पादचारेण यानैरुच्चावचैस्तथा ।\nसदाराः सानुयात्राश्च शतशोऽथ सहस्रशः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2118037, "chapter_id": 3541, "verse_number": "७", "content_sanskrit": "ततो हलधरः क्षीबो रेवतीसहितः प्रभुः ।\nअनुगम्यमानो बहुभिरचरत् तत्र भारत \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2118038, "chapter_id": 3541, "verse_number": "८", "content_sanskrit": "तथैव राजा वृष्णीनामुग्रसेनः प्रतापवान् ।\nउपगीयमानो गन्धर्वैः स्त्रीसहस्रसहायवान् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2118039, "chapter_id": 3541, "verse_number": "९", "content_sanskrit": "रौग्मिणेयश्च साम्बश्च क्षीबौ समरदुर्मदौ ।\nदिव्यमाल्याम्बरधरौ विजह्रातेऽमराविव \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2118040, "chapter_id": 3541, "verse_number": "१०", "content_sanskrit": "अक्रूरः सारणश्चैव गदो भानुर्विडूरथः ।\nनिशठश्चारुदेष्णश्च पृथुर्विपृथुरेव च \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2118041, "chapter_id": 3541, "verse_number": "११", "content_sanskrit": "सत्यकः सात्यकिश्चैव रङ्गकारसहाकरौ ।\nहार्दिक्यः कृतवर्मा च ये चान्ये नानुकीर्तिताः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2118042, "chapter_id": 3541, "verse_number": "१२", "content_sanskrit": "एते परिवृताः स्त्रीभिर्गन्धर्वैश्च पृथक्पृथक् ।\nतमुत्सवं रैवतके शोभयाञ्चक्रिरे तदा \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2118043, "chapter_id": 3541, "verse_number": "१३", "content_sanskrit": "वासुदेवो ययौ तत्र सह स्त्रीभिर्गुणान्वितः ।\nदत्त्वा दानं द्विजातिभ्यः परिव्राजमपश्यत \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2118044, "chapter_id": 3541, "verse_number": "१४", "content_sanskrit": "तदा कौतूहले तस्मिन् वर्तमाने महोत्सवे ।\nवासुदेवश्च पार्थश्च सहितौ परिजग्मतुः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2118045, "chapter_id": 3541, "verse_number": "१५", "content_sanskrit": "तत्र चङ्क्रममाणौ तौ वसुदेवसुतां शुभाम् ।\nअलङ्कृतां सखीमध्ये भद्रां ददृशतुस्तदा \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2118046, "chapter_id": 3541, "verse_number": "१६", "content_sanskrit": "दृष्ट्वैव तामर्जुनस्य कन्दर्पः समजायत ।\nतं त्वनेकाग्रमनसं कृष्णः पार्थमलक्षयत् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2118047, "chapter_id": 3541, "verse_number": "१७", "content_sanskrit": "अब्रवीत् पुण्डरीकाक्षः प्रहसन्निव भारत ।\nवनेचरस्य किमिदं कामेनालोड्यते मनः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2118048, "chapter_id": 3541, "verse_number": "१८", "content_sanskrit": "ममैषा भगिनी पार्थ सारणस्य सहोदरा ।\nसुभद्रा नाम भद्रं ते पितुर्मे दयिता सुता ।\nयदि ते वर्तते बुद्धिर्वक्ष्यामि पितरं स्वयम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2118049, "chapter_id": 3541, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2118050, "chapter_id": 3541, "verse_number": "१९", "content_sanskrit": "दुहिता वसुदेवस्य वासुदेवस्य च स्वसा ।\nरूपेण चैव सम्पन्ना कमिवैषा न मोहयेत् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2118051, "chapter_id": 3541, "verse_number": "२०", "content_sanskrit": "कृतमेव तु कल्याणं सर्वं मम भवेद् ध्रुवम् ।\nयदि स्यान्मम वार्ष्णेय महिषीयं स्वसा तव \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2118052, "chapter_id": 3541, "verse_number": "२१", "content_sanskrit": "प्राप्तौ तु क उपायोऽस्यास्तं ब्रवीहि जनार्दन ।\nआस्थास्यामि तथा सर्वं यदि शक्यं नरेण तत् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2118053, "chapter_id": 3541, "verse_number": "", "content_sanskrit": "वासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2118054, "chapter_id": 3541, "verse_number": "२२", "content_sanskrit": "स्वयंवरः क्षत्रियाणां विवाहः पुरुर्षषभ ।\nस च संशयितः पार्थ स्वभावस्य निमित्ततः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2118055, "chapter_id": 3541, "verse_number": "२३", "content_sanskrit": "प्रसह्य हरणं चापि क्षत्रियाणां प्रशस्यते ।\nविवाहहेतोः कन्यानामिति धर्मविदो विदुः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2118056, "chapter_id": 3541, "verse_number": "२४", "content_sanskrit": "स त्वमर्जुन कल्याणीं प्रसह्य भगिनीं मम ।\nयतिरूपधरस्त्वं तु यदा कालविपाकता ।\nहर स्वयंवरे ह्यस्याः को वै वेद चिकीर्षितम् \t॥ २४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2118057, "chapter_id": 3541, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2118058, "chapter_id": 3541, "verse_number": "२५", "content_sanskrit": "ततोऽर्जुनश्च कृष्णश्च विनिश्चित्येतिकृत्यताम् ।\nशीघ्रगान् पुरुषान् राजन् प्रेषयामासतुस्तदा \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2118059, "chapter_id": 3541, "verse_number": "२६", "content_sanskrit": "धर्मराजाय तत्सर्वमिन्द्रप्रस्थगताय वै ।\nश्रुत्वैव च महाबाहुरनुजज्ञे समातृकः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2118060, "chapter_id": 3541, "verse_number": "२७", "content_sanskrit": "भीमसेनस्तु तच्छ्रुत्वा कृतकृत्याः स्म शक्यते ।\nइत्येवं मनुजैः सार्धमुक्त्वा प्रीतिमुपेयिवान्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2118061, "chapter_id": 3541, "verse_number": "२२०", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nविंशत्यधिकद्विशततमोऽध्यायः ॥२२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2118062, "chapter_id": 3541, "verse_number": "१", "content_sanskrit": "॥ इति सुभद्राहरणपर्वणि प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2118063, "chapter_id": 3541, "verse_number": "", "content_sanskrit": "–– ० ––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]