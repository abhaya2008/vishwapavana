[{"id": 7003560000, "chapter_id": 23560, "verse_number": "२००-१", "content_sanskrit": "पुनः नरकयातनास्वरूपवर्णनम् ।\nऋषिपुत्र उवाच।\nतप्तं चैव महातप्तं महारौरवरौरवौ ।\nसप्ततालश्च नरको नरकः कालसूत्रकः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003560001, "chapter_id": 23560, "verse_number": "२००-२", "content_sanskrit": "अन्धकारश्च नरको अन्धकारवरस्तथा।\nअष्टावेते तु नरकाः पच्यन्ते यत्र पापिनः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003560002, "chapter_id": 23560, "verse_number": "२००-३", "content_sanskrit": "प्रथमे प्रथमं विद्याद्द्वितीये द्विगुणं तथा।\nतृतीये त्रिगुणं विद्याच्चतुर्थे तु चतुर्गुणम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003560003, "chapter_id": 23560, "verse_number": "२००-४", "content_sanskrit": "पञ्चमे तु गुणाः पञ्च षष्ठे षङ्गुणमुच्यते।\nसप्तमे तु गुणाः सप्त अष्टमेऽष्टविधा गुणाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003560004, "chapter_id": 23560, "verse_number": "२००-५", "content_sanskrit": "अहोरात्रेण चाध्वानं प्रेता गच्छन्ति तत्पुरम् ।\nदुःखितानां ततो दुःखं दुःखाद्दुःखतरं ततः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003560005, "chapter_id": 23560, "verse_number": "२००-६", "content_sanskrit": "दुःखमेवात्र न सुखं दुःखैर्दुःखं विवर्ध्यते ।\nउपायस्तत्र नैवास्ति येन स्वल्पं सुखं भवेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003560006, "chapter_id": 23560, "verse_number": "२००-७", "content_sanskrit": "मुच्यते च मृतस्तत्र मारकास्तत्र दुर्लभाः ।\nशब्दे स्पर्शे तथा रूपे रसे गन्धे तु पञ्चमे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003560007, "chapter_id": 23560, "verse_number": "२००-८", "content_sanskrit": "न सुखं तत्र तस्यास्ति किञ्चिदेवात्र विद्यते ।\nशारीरैर्मानसैश्चैव दुःखैर्दुःखांतगामिभिः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003560008, "chapter_id": 23560, "verse_number": "२००-९", "content_sanskrit": "आयसैः कण्टकैस्तीक्ष्णैस्तप्तैस्तप्तावृता मही ।\nअन्तरिक्षं खगानीकैरग्निजिह्वैः समावृतम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003560009, "chapter_id": 23560, "verse_number": "२००-१०", "content_sanskrit": "अतीव च बुभुक्षात्र पिपासा चाप्यतीव हि ।\nउष्णमत्युष्णमेवात्र शीतलं चातिशीतलम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003560010, "chapter_id": 23560, "verse_number": "२००-११", "content_sanskrit": "पातुकामश्च पानीयं राक्षसैर्नीयते सरः ।\nहंससारससंकीर्णं पद्मोत्पलविभूषितम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003560011, "chapter_id": 23560, "verse_number": "२००-१२", "content_sanskrit": "पातुकामश्च पानीयं सहसा तत्र धावति ।\nसलिलं प्रेक्षते चैव तत्र तप्ततरं तथा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003560012, "chapter_id": 23560, "verse_number": "२००-१३", "content_sanskrit": "ततः पक्वानि मांसानि राक्षसैः परिणीयते ।\nक्षारोदकेऽपि च तथा क्षिप्यतेऽत्र महाह्रदे ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003560013, "chapter_id": 23560, "verse_number": "२००-१४", "content_sanskrit": "तत्र चैव ह्रदे नैका मत्स्याः खादन्ति सर्वशः ।\nततः कालावसाने तु कथञ्चित्प्रपलायिनः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003560014, "chapter_id": 23560, "verse_number": "२००-१५", "content_sanskrit": "किञ्चिदन्तरमागम्य वेदनार्थाः पतन्ति हि ।\nयातनार्थं पुनस्तत्र मांसं चैवोपजायते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003560015, "chapter_id": 23560, "verse_number": "२००-१६", "content_sanskrit": "शिरस्येवोपविष्टस्य प्रस्थितस्य प्रधावतः ।\nतस्यार्त्तायामवस्थायां दुःखं भवति दारुणम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003560016, "chapter_id": 23560, "verse_number": "२००-१७", "content_sanskrit": "करीषगर्त्तस्तत्रैव कुम्भीपाकः सुदारुणः ।\nपद्मपत्राकृतिस्तस्य पेशी तत्र शरीरजः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003560017, "chapter_id": 23560, "verse_number": "२००-१८", "content_sanskrit": "पाटयन्ति सुमार्गेण राक्षसाः करपत्रिकाः ।\nनिपीड्य दशनै रोषं भीमनादाः सुरोषिताः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003560018, "chapter_id": 23560, "verse_number": "२००-१९", "content_sanskrit": "असिपत्रवनं चात्र शृङ्गाटकवनं तथा ।\nतत्र शृङ्गाटकाश्चैव तप्तवालुकमिश्रिताः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003560019, "chapter_id": 23560, "verse_number": "२००-२०", "content_sanskrit": "दह्यते छिद्यते चैव विध्यते भिद्यते पथा।\nपात्यते पीड्यते चैव कृष्यते च विशस्यते ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003560020, "chapter_id": 23560, "verse_number": "२००-२१", "content_sanskrit": "श्यामाश्च शबलाश्चैव श्वानस्तेऽत्र दुरासदाः ।\nखादन्ति च सुसंरब्धाः सर्पवृश्चिकसन्निभैः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003560021, "chapter_id": 23560, "verse_number": "२००-२२", "content_sanskrit": "कण्टकैः प्रतिकूलैश्च तत्रान्या कूट शाल्मलिः ।\nकर्षन्ति तत्र चैवैनं यावदस्थ्यवशेषितः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003560022, "chapter_id": 23560, "verse_number": "२००-२३", "content_sanskrit": "यद्दुःखं तस्य दुर्बुद्धेः प्रतिकूलं च तस्य यत् ।\nतत्तदोत्पद्यते शीघ्रं यातनार्थाय यत्नतः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003560023, "chapter_id": 23560, "verse_number": "२००-२४", "content_sanskrit": "शीतकामस्य वै चोष्णमुष्णकामस्य शीतलम् ।\nसुखकामस्य वै दुःखं सुखं नैवात्र विद्यते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003560024, "chapter_id": 23560, "verse_number": "२००-२५", "content_sanskrit": "छिन्नाश्च शतधाप्येवं ह्यनिशं तैः सहस्रशः ।\nछिन्नाङ्गाः सर्वगात्रेषु सर्वमेव स विन्दति ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003560025, "chapter_id": 23560, "verse_number": "२००-२६", "content_sanskrit": "सलिलं च नदीं घोरां व्यालाकीर्णां भयानकाम् ।\nउत्तार्यन्ते च तां प्रेतां यां दृष्ट्वैव भयं भवेत् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003560026, "chapter_id": 23560, "verse_number": "२००-२७", "content_sanskrit": "करम्भवालुका नाम शतयोजनमायता ।\nअग्निज्वालासमा घोरा यथा येन स गच्छति ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003560027, "chapter_id": 23560, "verse_number": "२००-२८", "content_sanskrit": "ततो वैतरणी नाम क्षारोदा तु महानदी ।\nयोजनानि तु पञ्चाशदधस्थात्पंचयोजनम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003560028, "chapter_id": 23560, "verse_number": "२००-२९", "content_sanskrit": "अगाधपङ्का वै तत्र चर्ममांसास्थिभेदना ।\nतत्र कर्कटका घोरा वज्रदंष्ट्रा विशन्ति ताम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003560029, "chapter_id": 23560, "verse_number": "२००-३०", "content_sanskrit": "उलूकाश्च धनुर्मात्रा वज्रजिह्वास्थिभेदनाः ।\nमहाविषा महाक्रोधा दुर्विषह्याः सुदारुणाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003560030, "chapter_id": 23560, "verse_number": "२००-३१", "content_sanskrit": "समुत्तीर्य तु कृच्छ्रेण तस्माद्योजनकर्दमात् ।\nवसन्त्यत्र धरे केचिच्छून्यागारे निराश्रये ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003560031, "chapter_id": 23560, "verse_number": "२००-३२", "content_sanskrit": "यत्र वै मूषिकगणा भक्षयन्ति ह्यनेकशः ।\nमूषकैर्जग्ध गात्रस्तु ह्यस्थिमात्रावशेषितः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003560032, "chapter_id": 23560, "verse_number": "२००-३३", "content_sanskrit": "प्रभाते वायुना स्पृष्टः पुनर्मांसं स विन्दति ।\nशून्यागारप्रवेशात्तु गव्यूतेर्नातिदूरतः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003560033, "chapter_id": 23560, "verse_number": "२००-३४", "content_sanskrit": "सहकारवनं नाम रौद्रा यत्र च पक्षिणः ।\nनिस्त्वगस्थिस्तैः क्रियते निर्मांसश्चैव मानवः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003560034, "chapter_id": 23560, "verse_number": "२००-३५", "content_sanskrit": "निःशिराजालकश्चैव निरक्षिश्रवणस्तथा ।\nवटवृक्षो नातिदूरे दक्षिणे तु त्रियोजनम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003560035, "chapter_id": 23560, "verse_number": "२००-३६", "content_sanskrit": "सन्ध्याभ्र इव चाभाति प्रदीप्तो नित्यमेव तु ।\nदशयोजनविस्तार्णा अधः शतसमायता ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003560036, "chapter_id": 23560, "verse_number": "२००-३७", "content_sanskrit": "यमचुल्लीति विख्याता गम्भीरा सा त्रियोजनम् ।\nनित्यं प्रज्वलिता सा तु नित्यं धूमान्धकारिता ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003560037, "chapter_id": 23560, "verse_number": "२००-३८", "content_sanskrit": "तत्र प्रेतसहस्राणि प्रयुतान्यर्बुदानि च ।\nप्रक्षिप्यन्ते   त्वहोरात्रं राक्षसैर्यमकिङ्करैः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003560038, "chapter_id": 23560, "verse_number": "२००-३९", "content_sanskrit": "मासमेकं वसत्यन्यो तस्यां चुल्ल्यां परिभ्रमन् ।\nततः शकुनिका नाम वसामेदोवहा नदी ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003560039, "chapter_id": 23560, "verse_number": "२००-४०", "content_sanskrit": "चुल्लीकुक्षौ तु विश्रान्ता वेगिनी वहते तु सा ।\nतां समुत्तीर्य कृच्छ्रेण यातनाः सप्तकाः पुनः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003560040, "chapter_id": 23560, "verse_number": "२००-४१", "content_sanskrit": "एकैकं दुस्तरं घोरं यथापूर्वं यथाक्रमात् ।\nअनुभुङ्क्ते स कृच्छ्रेण दुष्कृती तीव्रवेदनाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003560041, "chapter_id": 23560, "verse_number": "२००-४२", "content_sanskrit": "दश तत्र लताः शूलाः कुम्भीपाकास्त्रयोदश ।\nयाति पापमहोरात्रं तस्मिन्नियमितेन तु ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003560042, "chapter_id": 23560, "verse_number": "२००-४३", "content_sanskrit": "राक्षसैर्निरनुक्रोशैर्दुर्निरीक्ष्यैस्ततस्ततः ।\nअङ्गारेषु विधूमेषु शूलप्रोतस्तु पच्यते ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003560043, "chapter_id": 23560, "verse_number": "२००-४४", "content_sanskrit": "शुष्कोदपाने धूमे च अधःशीर्षोऽवलम्बते ।\nज्वाल्यते तीक्ष्णतैले तु कटाहे स तु पच्यते ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003560044, "chapter_id": 23560, "verse_number": "२००-४५", "content_sanskrit": "करीषगर्त्ते स पुनः पच्यते मेदवह्निना ।\nएकैकस्मिन्दशाहं च शूलादिषु स पच्यते ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003560045, "chapter_id": 23560, "verse_number": "२००-४६", "content_sanskrit": "यातनाः सप्तकास्तस्य निष्क्रान्तस्य त्रियोजने ।\nयतो यमनदी नाम तप्तत्रपुजलोर्मिणी ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003560046, "chapter_id": 23560, "verse_number": "२००-४७", "content_sanskrit": "समुत्तीर्य तु कृच्छ्रेण दह्यमानस्त्वचेतनः ।\nततो मुहूर्त्तं विश्रान्तः किंचिदन्तरमागतः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003560047, "chapter_id": 23560, "verse_number": "२००-४८", "content_sanskrit": "दीर्घिकां मोक्षते कान्तां शीतोदां शीतकाननाम् ।\nसर्वकामान्स लभते भगिनी सा यमस्य तु ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003560048, "chapter_id": 23560, "verse_number": "२००-४९", "content_sanskrit": "भक्ष्यं भोज्यं च सर्वैस्तु पापिभिस्तत्र लभ्यते ।\nस सर्वं विस्मरत्यत्र त्रिरात्रमुषितोऽपि सन् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003560049, "chapter_id": 23560, "verse_number": "२००-५०", "content_sanskrit": "ततः शूलवहो नाम पर्वतः शतयोजनः ।\nनिराश्रयः स सत्वानामेकपाषाण एव च ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003560050, "chapter_id": 23560, "verse_number": "२००-५१", "content_sanskrit": "तत्र वर्षति पर्जन्यस्तत्र तप्तजलं सदा ।\nतत्र कृच्छ्रेण तरति अहोरात्रेण मानवः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003560051, "chapter_id": 23560, "verse_number": "२००-५२", "content_sanskrit": "शृङ्गारकवनं नाम तत्र पश्यन्ति शाद्वलम् ।\nनीलमक्षिकदंशैश्च सुव्याप्तं तद्वनं महत् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003560052, "chapter_id": 23560, "verse_number": "२००-५३", "content_sanskrit": "यैस्तु स्पृष्टश्च दष्टश्च कृमिरूपश्च जायते ।\nप्रेतो वर्षति मांसासृगस्मात्कृच्छ्रात्तु निर्गतः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003560053, "chapter_id": 23560, "verse_number": "२००-५४", "content_sanskrit": "ततोऽन्यल्लभते चैव यातनार्थं प्रयत्नतः।\nततः पश्यति पुत्रांस्तु महद्दुःखं सुदारुणम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003560054, "chapter_id": 23560, "verse_number": "२००-५५", "content_sanskrit": "मातरं पितरं चैव पुत्रान्दारांस्तथा प्रियान् ।\nपुरस्ताद्बध्यमानं स क्रन्दमानमचेतनम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003560055, "chapter_id": 23560, "verse_number": "२००-५६", "content_sanskrit": "हा त्राहि त्राहि पुत्रेति क्रन्दमानस्ततस्ततः ।\nलगुडैर्मुद्गरैर्दण्डैर्जानुभिर्वेणुभिस्तथा ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003560056, "chapter_id": 23560, "verse_number": "२००-५७", "content_sanskrit": "मुष्टिभिश्च कशाभिश्च व्यालैरङ्कगतैरपि ।\nतद्दृष्ट्वा तादृशं दुःखं ततो मोहं स गच्छति ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003560057, "chapter_id": 23560, "verse_number": "२००-५८", "content_sanskrit": "एवमेवात्मकर्माणि पर्यायेण पुनः पुनः ।\nप्राप्नुवन्तीह तेऽत्रैव नरा दुष्कृतकारिणः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003560058, "chapter_id": 23560, "verse_number": "२००-५९", "content_sanskrit": "पातकानि च चत्वारि समाचारेण पंचमम् ।\nकृत्वा तानि नरा यान्ति तं देशं पापकारिणः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003560059, "chapter_id": 23560, "verse_number": "२००-६०", "content_sanskrit": "तदादिषु च सर्वेषु गुणान्तरपथं गतः ।\nयदा भवति स प्रेतस्तदा स्थावरतां व्रजेत् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003560060, "chapter_id": 23560, "verse_number": "२००-६१", "content_sanskrit": "तदा वा स्थावरे तेषु जातस्य हि भवेन्नरः ।\nक्रमशः स भवेत्प्रेतस्तदा पशुगणेष्वपि ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003560061, "chapter_id": 23560, "verse_number": "२००-६२", "content_sanskrit": "षष्टिवर्षसहस्राणि षष्टिवर्षशतानि च ।\nगतः स वसति प्रेतो नरके तु पुनःपुनः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003560062, "chapter_id": 23560, "verse_number": "२००-६३", "content_sanskrit": "ततो निवृत्तकर्मा तु स्वेदजः सम्भवेत्पुनः ।\nस्वेदजानां ततो नित्यं सर्वसंसारचंक्रमात् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003560063, "chapter_id": 23560, "verse_number": "२००-६४", "content_sanskrit": "ततश्च पक्षिणां योनिं सर्वां संतरते पुनः ।\nगोयोनौ तु ततो गत्वा पुनर्मानुषतां व्रजेत् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003560064, "chapter_id": 23560, "verse_number": "२००-६५", "content_sanskrit": "मानुषे शूद्रतां याति लब्ध्वा यदि तु तुष्यति ।\nततो वैश्यत्वमागच्छेत्कमर्णाऽनेन वेष्टितः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003560065, "chapter_id": 23560, "verse_number": "२००-६६", "content_sanskrit": "वैश्यात्क्षत्रियतां याति तस्माच्च ब्राह्मणो भवेत् ।\nब्राह्मणत्वमपि प्राप्तः पापकर्मा दुरात्मवान् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003560066, "chapter_id": 23560, "verse_number": "२००-६७", "content_sanskrit": "दुःशिक्षितेन मनसा ह्यात्मद्रोग्धा भवेत्तदा ।\nशरीरं मानसं घोरं व्यसनैरुपपादितम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003560067, "chapter_id": 23560, "verse_number": "२००-६८", "content_sanskrit": "उपयुक्तो नरो जातः पूर्वकर्मभिरन्वितः ।\nज्ञेयश्च ब्रह्महा कुष्ठी काकाक्षः काकतालुकः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003560068, "chapter_id": 23560, "verse_number": "२००-६९", "content_sanskrit": "सुरापः श्यावदन्तश्च पूतिगन्धश्च पापकृत् ।\nराजहा पितृहा चैव सुरापश्चापि यो भवेत् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003560069, "chapter_id": 23560, "verse_number": "२००-७०", "content_sanskrit": "सुवर्णहर्ता च नरो ब्रह्मघ्नेन समो हि सः ।\nक्वचिच्चात्र विरूपाणां नराणां पापकर्मिणाम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003560070, "chapter_id": 23560, "verse_number": "२००-७१", "content_sanskrit": "यावद्भिः कर्मभिस्तैस्तैस्तेषु निर्याणवेश्मसु ।\nछिन्नभिन्नविशस्तानां रुधिरेण समन्ततः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003560071, "chapter_id": 23560, "verse_number": "२००-७२", "content_sanskrit": "व्याप्तं महीतलं सर्वमापगाश्चापि निर्गताः ।\nअजस्रं क्लिश्यमानानां क्रन्दतां च सुदारुणम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003560072, "chapter_id": 23560, "verse_number": "२००-७३", "content_sanskrit": "समुत्तस्थौ महानादो हाहाकारसमाकुलः ।\nबध्नतो विविधैर्बन्धैर्घातयन्तश्च दारुणम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003560073, "chapter_id": 23560, "verse_number": "२००-७४", "content_sanskrit": "लौहयष्टिप्रहारैश्च आयुधैश्च सुदारुणैः ।\nछेदनैर्भेदनैश्चोग्रैः पीडनाभिश्च सर्वशः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003560074, "chapter_id": 23560, "verse_number": "२००-७५", "content_sanskrit": "श्रान्ताः कर्मकरा दूता मोहेनायत्तचेतसः ।\nयदा श्रान्ताश्च खिन्नाश्च हन्तारः पापकर्मिणाम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003560075, "chapter_id": 23560, "verse_number": "२००-७६", "content_sanskrit": "विज्ञापयेत्तदा दूताश्चित्रगुप्तं महौजसम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}]