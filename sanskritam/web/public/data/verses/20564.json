[{"id": 7000564000, "chapter_id": 20564, "verse_number": "५-२३-१", "content_sanskrit": "शेष उवाच ।\nक्षणं स्थित्वा तृणान्यत्त्वा ययौ वाजी मनोजवः ।\nवीरश्रेणीवृतः पत्रं भाले धृत्वा सचामरः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000564001, "chapter_id": 20564, "verse_number": "५-२३-२", "content_sanskrit": "शत्रुघ्नेन सुवीरेण लक्ष्मीनिधि नृपेण च ।\nपुष्कलेनोग्रवाहेन प्रतापाग्र्येण रक्षितः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000564002, "chapter_id": 20564, "verse_number": "५-२३-३", "content_sanskrit": "ययौ पुरीं स चक्रांकां सुबाहुपरिरक्षिताम् ।\nअनेकवीरकोटीभी रक्षितोऽनुगतः प्रभो ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000564003, "chapter_id": 20564, "verse_number": "५-२३-४", "content_sanskrit": "तदा पुत्रोस्य दमनो मृगयामास्थितो महान् ।\nददर्शाश्वं भालपत्रं चंदनादिकचर्चितम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000564004, "chapter_id": 20564, "verse_number": "५-२३-५", "content_sanskrit": "विलोक्य सेवकं प्राह कस्याश्वो मेऽक्षिगोचरः ।\nभाले पत्रं धृतं किं नु चामरं किंतु शोभनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000564005, "chapter_id": 20564, "verse_number": "५-२३-६", "content_sanskrit": "इति राज्ञोवचः श्रुत्वा सेवकः प्रययौ ततः ।\nयत्रासौ वर्तते वाजी भालपत्रः सुशोभनः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000564006, "chapter_id": 20564, "verse_number": "५-२३-७", "content_sanskrit": "गृहीत्वा तं केशसंघे रत्नमालाविभूषितम् ।\nनिनाय चाग्रे भूपस्य सुबाहुकुलधारिणः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000564007, "chapter_id": 20564, "verse_number": "५-२३-८", "content_sanskrit": "स पत्रं वाचयामास सुंदराक्षरशोभितम् ।\nअयोध्याधिपतिश्चासीद्राजा दशरथो बली ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000564008, "chapter_id": 20564, "verse_number": "५-२३-९", "content_sanskrit": "तस्यात्मजो रामभद्रः सर्वशूरशिरोमणिः ।\nनान्योस्ति तत्समः पृथ्व्यां धनुर्धरणविक्रमः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000564009, "chapter_id": 20564, "verse_number": "५-२३-१०", "content_sanskrit": "तेनासौ मोचितो वाजी चंदनादिकचर्चितः ।\nतं पालयति धर्मात्मा शत्रुघ्नः परवीरहा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000564010, "chapter_id": 20564, "verse_number": "५-२३-११", "content_sanskrit": "ये च शूरा वयं वीरा धनुर्हस्ता इमे वयम् ।\nते गृह्णंतु बलाद्वाहं रत्नमालाविभूषितम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000564011, "chapter_id": 20564, "verse_number": "५-२३-१२", "content_sanskrit": "तं च मोक्ष्यति शत्रुघ्नः सर्ववीरशिरोमणिः ।\nअन्यथा पादयोस्तस्य प्रणतिं यांतु धन्विनः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000564012, "chapter_id": 20564, "verse_number": "५-२३-१३", "content_sanskrit": "इत्यभिप्रायमालोक्य जगाद नृपनंदनः ।\nराम एव धनुर्धारी न वयं क्षत्त्रियाः स्मृताः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000564013, "chapter_id": 20564, "verse_number": "५-२३-१४", "content_sanskrit": "ताते मेऽवस्थिते पृथ्व्यां कोऽयं गर्वो महान्भुवि ।\nप्राप्नोतु गर्वस्य फलं मम निर्मुक्तसायकैः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000564014, "chapter_id": 20564, "verse_number": "५-२३-१५", "content_sanskrit": "अद्य मे निशिता बाणाः शत्रुघ्नं किंशुकं यथा ।\nपुष्पितं विदधत्वद्धा क्षतावृतशरीरकम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000564015, "chapter_id": 20564, "verse_number": "५-२३-१६", "content_sanskrit": "दारयंतु कपोलांश्च सायका मम दंतिनाम् ।\nअश्वान्पश्यंतु शतशो रुधिरौघपरिप्लुतान् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000564016, "chapter_id": 20564, "verse_number": "५-२३-१७", "content_sanskrit": "पिबंतु योगिनीसंघा रुधिराणि नृमस्तकैः ।\nशिवा भवंतु संतुष्टा मद्वैरिक्रव्यभक्षणैः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000564017, "chapter_id": 20564, "verse_number": "५-२३-१८", "content_sanskrit": "पश्यंतु सुभटास्तस्य मम बाहुबलं महत् ।\nकोदंडदंडनिर्मुक्ताः शरकोटीर्विमुंचतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000564018, "chapter_id": 20564, "verse_number": "५-२३-१९", "content_sanskrit": "इत्थमुक्त्वा महीपस्य तनुजो दमनाभिधः ।\nस्वपुरं प्रेषयित्वा तं प्रहृष्टोऽभवदुद्भटः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000564019, "chapter_id": 20564, "verse_number": "५-२३-२०", "content_sanskrit": "सेनापतिमुवाचेदं सज्जीकुरु महामते ।\nसेनां परिमितां मह्यं वैरिवृंदनिवारणे ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000564020, "chapter_id": 20564, "verse_number": "५-२३-२१", "content_sanskrit": "सज्जां सेनां विधायाशु संमुखो रणमंडले ।\nस्थितवान्या वदत्युग्रस्तावत्प्राप्ता हयानुगाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000564021, "chapter_id": 20564, "verse_number": "५-२३-२२", "content_sanskrit": "क्वासौ हयो महाराज्ञो भालपत्रेण चिह्नितः ।\nपप्रच्छुस्ते तु चान्योन्यमतिव्याकुलिता मुहुः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000564022, "chapter_id": 20564, "verse_number": "५-२३-२३", "content_sanskrit": "तावद्ददर्श पुरतः प्रतापाग्र्यः परंतपः ।\nसज्जीभूतं तु कटकं वीरशब्दनिनादितम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000564023, "chapter_id": 20564, "verse_number": "५-२३-२४", "content_sanskrit": "तत्रावदञ्जनाः केचिन्नीतोऽश्वोऽनेन भूपते ।\nअन्यथा संमुखस्तिष्ठेत्कथं वीरो बलानुगः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000564024, "chapter_id": 20564, "verse_number": "५-२३-२५", "content_sanskrit": "इत्याकर्ण्य प्रतापाग्र्यः प्रेषयामास सेवकम् ।\nस गत्वा तत्र पप्रच्छ कुत्राश्वो रामभूपतेः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000564025, "chapter_id": 20564, "verse_number": "५-२३-२६", "content_sanskrit": "केन नीतः कुतो नीतो रामं जानाति नो कुधीः ।\nयं शक्रप्रमुखा देवा बलिमादाय सन्नताः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000564026, "chapter_id": 20564, "verse_number": "५-२३-२७", "content_sanskrit": "तस्य वै धर्मराजस्य कुपितं तु बलं महत् ।\nसर्वथा हि ग्रसिष्येत प्रणतिं चेन्न यास्यति ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000564027, "chapter_id": 20564, "verse_number": "५-२३-२८", "content_sanskrit": "इत्थमुक्तं समाकर्ण्य तदा राजसुतो बली ।\nतं वै धिक्कारयामास वाग्जालेन सुदुर्मनाः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000564028, "chapter_id": 20564, "verse_number": "५-२३-२९", "content_sanskrit": "मयानीतो यज्ञहयः पत्रचिह्नाद्यलंकृतः ।\nये शूरास्ते तु मां जित्वा मोचयंतु बलादिह ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000564029, "chapter_id": 20564, "verse_number": "५-२३-३०", "content_sanskrit": "सेवकस्तद्वचः श्रुत्वा रोषपूर्णो हसन्ययौ ।\nराज्ञे निवेदयामास यथावदुपवर्णितम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000564030, "chapter_id": 20564, "verse_number": "५-२३-३१", "content_sanskrit": "तच्छ्रुत्वा रोषताम्राक्षः प्रतापाग्र्यो महाबलः ।\nययौ योद्धुं राजपुत्रं महावीरपुरस्कृतम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000564031, "chapter_id": 20564, "verse_number": "५-२३-३२", "content_sanskrit": "रथेन कनकांगेन चतुर्वाजिसुशोभिना ।\nसुकूबरेण सर्वास्त्रपूरितेन ययौ बली ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000564032, "chapter_id": 20564, "verse_number": "५-२३-३३", "content_sanskrit": "धनुष्टंकारयामास महाबलसमन्वितः ।\nपुनःपुनर्जहासोच्चैः कोपादुद्गमिताश्रुकः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000564033, "chapter_id": 20564, "verse_number": "५-२३-३४", "content_sanskrit": "अश्ववाहा गजारूढाः खड्गोल्लसितपाणयः ।\nअन्वयुस्ते प्रतापाग्र्यं रोषपूर्णाकुलेक्षणम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000564034, "chapter_id": 20564, "verse_number": "५-२३-३५", "content_sanskrit": "हस्तिनः पत्तयश्चैव कोटिशः प्रधनोद्यताः ।\nचिरकालमभीप्संतो रणं वीरेणकारितम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000564035, "chapter_id": 20564, "verse_number": "५-२३-३६", "content_sanskrit": "तदोद्यतं समाज्ञाय रिपुसैन्यं नृपात्मजः ।\nप्रत्युज्जगाम वीराग्र्यो महाबलपरीवृतः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000564036, "chapter_id": 20564, "verse_number": "५-२३-३७", "content_sanskrit": "सन्नद्धः कवची खड्गी शरासनधरो युवा ।\nलीलयैव ययौ योद्धुं मृगराड्गजतामिव ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000564037, "chapter_id": 20564, "verse_number": "५-२३-३८", "content_sanskrit": "तदा योधाः प्रकुपिताः परस्परवधैषिणः ।\nछिंधि भिंधीति भाषंतो रणकार्यविशारदाः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000564038, "chapter_id": 20564, "verse_number": "५-२३-३९", "content_sanskrit": "पत्तयः पत्तिसंघेन गजारूढाश्च सादिभिः ।\nरथारूढा रथस्थैश्च वाहारूढाश्वसंस्थितैः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000564039, "chapter_id": 20564, "verse_number": "५-२३-४०", "content_sanskrit": "गजा भिन्ना द्विधा जाता हयाश्च द्विदलीकृताः ।\nअनेकनरमस्तिष्कैर्मेदिनीपूरिता ह्यभूत् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000564040, "chapter_id": 20564, "verse_number": "५-२३-४१", "content_sanskrit": "तदा प्रकुपितो राजा प्रतापाग्र्यो महाबलः ।\nस्वसैन्यकदनोद्युक्तं राजपुत्रं समीक्ष्य च ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000564041, "chapter_id": 20564, "verse_number": "५-२३-४२", "content_sanskrit": "उवाच सारथिं तत्र प्रापयाश्वान्यतो मम ।\nसैन्यस्य कदनासक्तो राजपुत्रो महारथः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000564042, "chapter_id": 20564, "verse_number": "५-२३-४३", "content_sanskrit": "अथ वीरशिरोरत्न नमितांघ्रिर्नृपात्मजः ।\nययौ संमुखमेवास्य प्रतापाग्र्यस्य वीर्यवान् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000564043, "chapter_id": 20564, "verse_number": "५-२३-४४", "content_sanskrit": "सारथिः प्रापयामास प्रतापाग्र्यस्य वाजिनः ।\nयत्रासौ दमनो वीरः सर्वशूरशिरोमणिः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000564044, "chapter_id": 20564, "verse_number": "५-२३-४५", "content_sanskrit": "गत्वा तमाह्वयामास राजपुत्रं रणोद्यतम् ।\nरथे पुरटनिर्णिक्ते तिष्ठन्कोदंडदंडभृत् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000564045, "chapter_id": 20564, "verse_number": "५-२३-४६", "content_sanskrit": "रे राजपुत्र क शिशो त्वया बद्धोऽश्वसत्तमः ।\nन ज्ञातोसि महाराजः सर्ववीरेंद्र सेवितः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000564046, "chapter_id": 20564, "verse_number": "५-२३-४७", "content_sanskrit": "यस्य प्रतापं दैत्येंद्रो न शक्तः सोढुमद्भुतम् ।\nतस्य त्वं वाजिनं नीत्वा गतोऽसि पुटभेदनम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000564047, "chapter_id": 20564, "verse_number": "५-२३-४८", "content_sanskrit": "मां जानीहि पुरः प्राप्तं कालरूपं तु वैरिणम् ।\nमुंचाश्वमर्भ गच्छाशु बालक्रीडनकं कुरु ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000564048, "chapter_id": 20564, "verse_number": "५-२३-४९", "content_sanskrit": "कस्यात्मजस्त्वं कुत्रत्यः कथं नोऽदीर्घदर्शिना ।\nधृतोऽश्वस्त्वथ संजाता घृणा मम शिशो त्वयि ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000564049, "chapter_id": 20564, "verse_number": "५-२३-५०", "content_sanskrit": "इत्थमाकर्ण्य दमनः स्मितं चक्रे महामनाः ।\nउवाच च प्रतापाग्र्यं तृणीकुर्वंश्च तद्बलम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000564050, "chapter_id": 20564, "verse_number": "५-२३-५१", "content_sanskrit": "दमन उवाच ।\nमया बद्धो बलादश्वो नीतः स्वपुटभेदनम् ।\nनार्पयिष्येऽद्य सप्राणः कुरु युद्धं महाबल ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000564051, "chapter_id": 20564, "verse_number": "५-२३-५२", "content_sanskrit": "त्वया यदुक्तं बालस्त्वं गत्वा क्रीडनकं कुरु ।\nतन्मे पश्य महाराज क्रीडनं रणमूर्धनि ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000564052, "chapter_id": 20564, "verse_number": "५-२३-५३", "content_sanskrit": "शेष उवाच ।\nइत्युक्त्वा सगुणं चापं विधाय सुभुजां गजः ।\nशराणां शतमाधत्त प्रतापाग्र्यस्य वक्षसि ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000564053, "chapter_id": 20564, "verse_number": "५-२३-५४", "content_sanskrit": "संधाय बाणशतकं शंखं दध्मौ प्रतापवान् ।\nतेन शंखनिनादेन कातराणां भयं ह्यभूत् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000564054, "chapter_id": 20564, "verse_number": "५-२३-५५", "content_sanskrit": "ताडयामास हृदये बाणानां शतकेन सः ।\nप्रतापाग्र्यः प्रचिच्छेद लघुहस्तः सुपर्वणः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000564055, "chapter_id": 20564, "verse_number": "५-२३-५६", "content_sanskrit": "स बाणच्छेदनं दृष्ट्वा कुपितो व्यसृजच्छरान् ।\nकंकपक्षान्वितांस्तीक्ष्णभल्लान्राजात्मजो बली ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000564056, "chapter_id": 20564, "verse_number": "५-२३-५७", "content_sanskrit": "आकाशे भुवि मध्ये च बाणा ददृशिरेऽञ्चिताः ।\nस्वनामचिह्नितास्तीक्ष्णधारापातसुशोभिताः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000564057, "chapter_id": 20564, "verse_number": "५-२३-५८", "content_sanskrit": "शरास्तद्बाहु हृदये लग्ना वह्निकणान्बहून् ।\nसृजंतः कुर्वते सैन्यदाहनं तदभून्महत् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000564058, "chapter_id": 20564, "verse_number": "५-२३-५९", "content_sanskrit": "प्रतापाग्र्यः प्रकुपितस्तिष्ठतिष्ठेति च ब्रुवन् ।\nशरेण दशसंख्येन ताडयामास मूर्धनि ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000564059, "chapter_id": 20564, "verse_number": "५-२३-६०", "content_sanskrit": "ते बाणा राजपुत्रस्य ललाटे परिनिष्ठिताः ।\nविराजंते स्म च मुने दशशाखास्तरोरिव ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000564060, "chapter_id": 20564, "verse_number": "५-२३-६१", "content_sanskrit": "तेन बाणप्रहारेण विव्यथेन महामनाः ।\nयष्टिकाप्रहतो यद्वत्कुंजरः सप्तवर्षकः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000564061, "chapter_id": 20564, "verse_number": "५-२३-६२", "content_sanskrit": "बाणान्धनुषि संधाय मुमोच त्रिशताञ्छुभान् ।\nसुवर्णपुंखरचितान्महाकालानलोपमान् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000564062, "chapter_id": 20564, "verse_number": "५-२३-६३", "content_sanskrit": "ते बाणास्तु प्रतापाग्र्य वक्षो भित्त्वा गता ह्यधः ।\nशोणिताक्ता यथा रामचंद्र भक्ति पराङ्मुखाः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000564063, "chapter_id": 20564, "verse_number": "५-२३-६४", "content_sanskrit": "प्रतापाग्र्यः प्रकुपितः शरान्मुंचन्सहस्रशः ।\nअकरोद्विरथं सूनुं सुबाहोस्तत्क्षणाद्द्रुतम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000564064, "chapter_id": 20564, "verse_number": "५-२३-६५", "content_sanskrit": "चतुर्भिश्च तुरो वाहान्द्वाभ्यां ध्वजमशातयत् ।\nएकेन सारथेः कायाच्छिरो मह्यामपातयत् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000564065, "chapter_id": 20564, "verse_number": "५-२३-६६", "content_sanskrit": "चतुर्भिस्ताडयामास तं सूनुं नृपतेः पुनः ।\nतत्क्षणाच्चापमेकेन गुणयुक्तं तु चिच्छिदे ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000564066, "chapter_id": 20564, "verse_number": "५-२३-६७", "content_sanskrit": "सोऽन्यरथं समारुह्य हयरत्नसुशोभितम् ।\nधनुः करे समादाय सज्यं चक्रे महामनाः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000564067, "chapter_id": 20564, "verse_number": "५-२३-६८", "content_sanskrit": "प्रत्युवाच प्रतापाग्र्यं त्वया विक्रांतमद्भुतम् ।\nपश्येदानीं पराक्रांतिं धनुषो मम सद्भट ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000564068, "chapter_id": 20564, "verse_number": "५-२३-६९", "content_sanskrit": "एवमुक्त्वा तु दमनो बाणान्दश समाददे ।\nचतुर्भिश्चतुरो वाहान्निनाय यमसादनम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000564069, "chapter_id": 20564, "verse_number": "५-२३-७०", "content_sanskrit": "चतुर्भिस्तिलशः कृत्तो रथश्चक्रसमन्वितः ।\nएकेन हृदि विव्याध बाणेनैकेन सारथिम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000564070, "chapter_id": 20564, "verse_number": "५-२३-७१", "content_sanskrit": "जगर्ज शंखमापूर्य शंखशब्दसमन्वितः ।\nतत्कर्म पूजयामास साधु वीर महाबल ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000564071, "chapter_id": 20564, "verse_number": "५-२३-७२", "content_sanskrit": "इति विक्रांतमालोक्य प्रतापाग्र्यो रुषान्वितः ।\nअन्यं रथं समास्थाय ययौ योद्धुं नृपात्मजम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000564072, "chapter_id": 20564, "verse_number": "५-२३-७३", "content_sanskrit": "उवाच वीर पश्य त्वं मम विक्रांतमद्भुतम् ।\nइत्युक्त्वाशु मुमोचौघाञ्छराणां शितपर्वणाम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000564073, "chapter_id": 20564, "verse_number": "५-२३-७४", "content_sanskrit": "शराः सर्वत्र दृश्यंते कुंजरेषु हयेषु च ।\nपरब्रह्मेव सर्वत्र व्याप्ताश्चांतरगोचराः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000564074, "chapter_id": 20564, "verse_number": "५-२३-७५", "content_sanskrit": "तं राजपुत्रं शितबाणकोटिभि ।\nर्व्याप्तं विधायाशु जगर्ज विक्रमी ।\nसंहर्षयन्स्वीयगणान्परान्महान् ।\nकुर्वन्हृदा शून्यतमान्गतासुकान् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000564075, "chapter_id": 20564, "verse_number": "५-२३-७६", "content_sanskrit": "स राजपुत्रः शितसायकव्रजैः ।\nसंपूर्णमात्मानमवेक्ष्य रोषितः ।\nजग्राह शस्त्राणि दुरंतविक्रमो ।\nधनुश्च धुन्वन्भुजदंडयोर्महान् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000564076, "chapter_id": 20564, "verse_number": "५-२३-७७", "content_sanskrit": "चकर्त सर्वाण्यस्त्राणि शस्त्राणि च महाबलः ।\nरोषताम्रेक्षणो मुंचञ्छरान्वैरिविदारिणः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000564077, "chapter_id": 20564, "verse_number": "५-२३-७८", "content_sanskrit": "तच्छस्त्रजालं निर्धूय राजपुत्रो जगाद तम् ।\nक्षमस्वैकं प्रहारं मे यदि शूरोसि मारिष ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000564078, "chapter_id": 20564, "verse_number": "५-२३-७९", "content_sanskrit": "यद्यनेन भवंतं वै रथाच्चेत्पातयामि न ।\nप्रतिज्ञां शृणु मे वीर मम गर्वेण निर्मिताम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000564079, "chapter_id": 20564, "verse_number": "५-२३-८०", "content_sanskrit": "वेदं निंदंति ये मत्ता हेतुवादविचक्षणाः ।\nतेषां पापं ममैवास्तु नरकार्णवमज्जकम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000564080, "chapter_id": 20564, "verse_number": "५-२३-८१", "content_sanskrit": "इत्युक्त्वा बाणमासाद्य कोदंडे कालसन्निभम् ।\nज्वालामालाकुलं तीक्ष्णं निषंगादुद्धृतं वरम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000564081, "chapter_id": 20564, "verse_number": "५-२३-८२", "content_sanskrit": "स मुक्तो नृपवर्येण हृदि लक्ष्यीकृतः शरः ।\nजगाम तरसा तं वै कालानलसमप्रभः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000564082, "chapter_id": 20564, "verse_number": "५-२३-८३", "content_sanskrit": "प्रतापाग्र्यः शरं दृष्ट्वा स्वपातनसमुद्यतम् ।\nबाणान्धनुष्यथाधत्त शरच्छेदायवै शितान् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000564083, "chapter_id": 20564, "verse_number": "५-२३-८४", "content_sanskrit": "स बाणः सर्वबाणांस्तांश्छिंदन्मध्यत एव हि ।\nजगाम वै प्रतापाग्र्यहृदयं धैर्यसंयुतम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000564084, "chapter_id": 20564, "verse_number": "५-२३-८५", "content_sanskrit": "संलग्नो हृदि नालीकः प्रविवेश तदंतरम् ।\nराजाकृतप्रहारस्तु पपात धरणीतले ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000564085, "chapter_id": 20564, "verse_number": "५-२३-८६", "content_sanskrit": "मूर्च्छितं चेतनाहीनं रथोपस्थाद्गतं भुवि ।\nसारथिस्तं समादायापोवाह रणमंडलात् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000564086, "chapter_id": 20564, "verse_number": "५-२३-८७", "content_sanskrit": "हाहाकारोमहानासीद्बलं भग्नं गतं ततः ।\nयत्र शत्रुघ्ननामासौ वीरकोटिपरीवृतः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000564087, "chapter_id": 20564, "verse_number": "५-२३-८८", "content_sanskrit": "राजात्मजो जयं प्राप्य प्रतापाग्र्यं विजित्य सः ।\nप्रतीक्षां तु चकारास्य शत्रुघ्नस्य च भूपतेः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}]