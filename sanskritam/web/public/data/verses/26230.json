[{"id": 7006230000, "chapter_id": 26230, "verse_number": "२-५८-१", "content_sanskrit": "जैमिनिरुवाच एवं ब्रुवाणं वरुणं विलोक्य पतितं भुवि ।\nसंजहार पुनर्धीमानस्त्रं मृगुकुलोद्वहः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006230001, "chapter_id": 26230, "verse_number": "२-५८-२", "content_sanskrit": "संत्दृतास्त्रस्ततो रामो वरुणं पुरतः स्थिरम् ।\nविलोक्य बिगतक्रोधस्तमुवाच हसन्निव ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006230002, "chapter_id": 26230, "verse_number": "२-५८-३", "content_sanskrit": "गोकर्णनिलयाः पूर्वमिमेमां मुनिपुङ्गवाः ।\nसमायाता महेन्द्राद्रौ निवसंतं सरित्पते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006230003, "chapter_id": 26230, "verse_number": "२-५८-४", "content_sanskrit": "त्वत्तोये मेदिनीं पूर्वं खनद्भिः सगरात्मजैः ।\nअधो निपातितं क्षेत्रं गोकर्णमृषिसेवितम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006230004, "chapter_id": 26230, "verse_number": "२-५८-५", "content_sanskrit": "उपलब्धुमिमे भूयः क्षेत्रं तद्भववल्लभम् ।\nअधावन्मामुपागम्य मुनयस्तीर्थवासिनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006230005, "chapter_id": 26230, "verse_number": "२-५८-६", "content_sanskrit": "एषामर्थे ततः सोऽहं महेन्द्रादचलोत्तमात् ।\nभवन्तमागतो द्रष्टुं सहैभिर्मुनिपुङ्गवैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006230006, "chapter_id": 26230, "verse_number": "२-५८-७", "content_sanskrit": "तस्मान्मदर्थे सलिलं समुत्सार्यात्मनो भवान् ।\nदातुमर्हति तत्क्षेत्रमेषां तोये च पूर्ववत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006230007, "chapter_id": 26230, "verse_number": "२-५८-८", "content_sanskrit": "जैमिनिरुवाच इति तस्य वचः श्रुत्वा वरुणो यादसां पतिः ।\nनिरूप्य मनसा राममिद भूयोऽब्रवीद्वचः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006230008, "chapter_id": 26230, "verse_number": "२-५८-९", "content_sanskrit": "वरुण उवाच न शक्यमुत्सारयितुं मदंभः केनचिद्भवेत् ।\nतथा हि मे वरो दत्तः पुरानेन विरिञ्चिना ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006230009, "chapter_id": 26230, "verse_number": "२-५८-१०", "content_sanskrit": "सोऽहं त्वत्तेजसेदारीं विहाय सहजां धृतिम् ।\nकातरं समुपायातो वशतां तव भार्गव ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006230010, "chapter_id": 26230, "verse_number": "२-५८-११", "content_sanskrit": "एषामर्थे विशेषण भवता परिचोदितः ।\nकथं न कुर्यां कर्मेदमहं क्षत्त्रकुलान्तक ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006230011, "chapter_id": 26230, "verse_number": "२-५८-१२", "content_sanskrit": "तस्माद्यावत्प्रमाणं मे भवान्संकल्पयिष्यति ।\nतावत्संघारयिष्यामि भूमौ सलिलमात्मनः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006230012, "chapter_id": 26230, "verse_number": "२-५८-१३", "content_sanskrit": "इति तस्य वचः श्रुत्वा तथेत्युक्त्वा स सायकम् ।\nयथागतं प्रचिक्षेप धनुर्निर्भिद्य भार्गवः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006230013, "chapter_id": 26230, "verse_number": "२-५८-१४", "content_sanskrit": "ततो निरूप्य सीमानं दर्शयानो महीपते ।\nस्रुवं जग्राह मतिमान्क्षप्तुकामो जलाशये ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006230014, "chapter_id": 26230, "verse_number": "२-५८-१५", "content_sanskrit": "प्रसन्नचेतसं रामं गतरोषमथात्मनि ।\nअन्तर्हिते सरिन्नाथे रामः सुवमुदङ्मुखः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006230015, "chapter_id": 26230, "verse_number": "२-५८-१६", "content_sanskrit": "भ्रामयित्वातिवेगेन चिक्षेप लवणार्णवे ।\nक्षिप्तत्वेन समुद्रे तु दिशमुत्तरपश्चिमाम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006230016, "chapter_id": 26230, "verse_number": "२-५८-१७", "content_sanskrit": "गत्वा स्रुवोपतद्राजन्योजनानां शतद्वयम् ।\nतीर्थं शुर्पारकं नाम सर्वपापविमोचनम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006230017, "chapter_id": 26230, "verse_number": "२-५८-१८", "content_sanskrit": "विश्रुतं यत्त्रिलोकेषु तीरे नदनदीपतेः ।\nतीर्थं तदन्तरीकृत्य स्रुवो रामकराच्च्युतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006230018, "chapter_id": 26230, "verse_number": "२-५८-१९", "content_sanskrit": "निपपात महाराज सूचयन्रामविक्रमम् ।\nयत्राभूद्रामसृष्टाया भुवो निष्ठाथ पार्थिव ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006230019, "chapter_id": 26230, "verse_number": "२-५८-२०", "content_sanskrit": "तीर्थं शूर्पारकं तत्तु श्रीमल्लोकपरिश्रुतम् ।\nउत्सारयित्वा सलिलं समुद्रस्तावदात्मनः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006230020, "chapter_id": 26230, "verse_number": "२-५८-२१", "content_sanskrit": "अतिष्ठदपसृत्योर्वीं दत्त्वा रामाय पार्थिव ।\nअनतिक्रान्तमर्यादो यथाकालं भृगूद्वहः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006230021, "chapter_id": 26230, "verse_number": "२-५८-२२", "content_sanskrit": "समयं स्वापयामास तस्यैवानुमते भुवि ।\nविज्ञाय पूर्वसीमान्तां भुवमभ्युत्ससर्ज ह ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006230022, "chapter_id": 26230, "verse_number": "२-५८-२३", "content_sanskrit": "व्यस्मयन्त सुराः सर्वे दृष्ट्वा रामस्य विक्रमम् ।\nनगरग्रमसीमानः किञ्चित्किञ्चित्क्वचित्क्वचित् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006230023, "chapter_id": 26230, "verse_number": "२-५८-२४", "content_sanskrit": "सह्ये तु पूर्ववत्तस्मिन्नब्धेरपसृतेंऽभसि ।\nतत्र दैवात्तथा स्थानान्निम्नत्वात्स प्रलक्ष्य तु ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006230024, "chapter_id": 26230, "verse_number": "२-५८-२५", "content_sanskrit": "ततस्तेषां भृगुश्रेष्ठो मुनीनां भावितात्मनाम् ।\nयथाभिलषितं स्थानं प्रददौ प्रीतिपूर्वकम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006230025, "chapter_id": 26230, "verse_number": "२-५८-२६", "content_sanskrit": "ततस्ते मुनयः सर्वे हर्षेण महातान्विताः ।\nकृतकृत्या भृशं राममाशिषा समपूजयन् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006230026, "chapter_id": 26230, "verse_number": "२-५८-२७", "content_sanskrit": "अथैतैरभ्यनुज्ञातो ययौ प्राप्तमनोरथः ।\nगते मुनिवरे रामे देशात्तस्मान्निजाश्रमम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006230027, "chapter_id": 26230, "verse_number": "२-५८-२८", "content_sanskrit": "संभूय मुनयः सर्वे प्रजग्मुस्तीरमंबुधेः ।\nपरिचङ्क्रम्य तां भूमिं यत्नेन महातान्विताः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006230028, "chapter_id": 26230, "verse_number": "२-५८-२९", "content_sanskrit": "ददृशुः सर्वतो राजन्ह्यर्मवान्तः स्थितां महीम् ।\nनित्यत्वा त्सर्वदेवानामधिष्ठानतया तथा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006230029, "chapter_id": 26230, "verse_number": "२-५८-३०", "content_sanskrit": "कातमब्धौ निपतितं नष्टतोयं चिरोषितम् ।\nअपि रुद्रप्रभावेम प्रायान्नात्यन्तविप्लवम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006230030, "chapter_id": 26230, "verse_number": "२-५८-३१", "content_sanskrit": "तत्तेयनिःसृतं क्षेत्रमभूत्पूर्ववदेव हि ।\nएतद्धि देवसामर्थ्यमचिन्त्यं नृपसत्तम ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006230031, "chapter_id": 26230, "verse_number": "२-५८-३२", "content_sanskrit": "एवं रामेण जलधेः पुनः सृष्टा वसुंधरा ।\nदक्षिणोत्तरतो राजनयोजनानां चतुःशतम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006230032, "chapter_id": 26230, "verse_number": "२-५८-३३", "content_sanskrit": "नातिक्रामति सोऽद्यापि सीमानं पयसां निधिः ।\nकृतं रामेण महता न तु सज्जं महद्धनुः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006230033, "chapter_id": 26230, "verse_number": "२-५८-३४", "content_sanskrit": "एवं प्रभावो रामोऽसौ सगरश्च महीपतिः ।\nयस्य पुत्रैरयं खण्डो भारतोऽब्धौ निपतितः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006230034, "chapter_id": 26230, "verse_number": "२-५८-३५", "content_sanskrit": "योजनानां सहस्रन्तु वर्द्धितश्च महोदधिः ।\nरामेणाभूत्पुनः सृष्टं योजनानां तु षट्शतम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006230035, "chapter_id": 26230, "verse_number": "२-५८-३६", "content_sanskrit": "सगरस्य सुतैर्यस्माद्वर्द्धितो मकरालयः ।\nततः प्रभृति लोकेषु सागराख्यामवाप्तवान् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006230036, "chapter_id": 26230, "verse_number": "२-५८-३७", "content_sanskrit": "एतत्तेऽभिहितं सम्यङ्महतश्चरितं मया ।\nरामस्य कार्त्तवीर्यस्य सगरस्य महीपतेः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]