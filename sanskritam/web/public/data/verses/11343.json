[{"id": 50006279, "chapter_id": 11343, "verse_number": "1", "content_sanskrit": "[न्यायमाला (अनुव्याख्याने २-१-३-४)- आप्तता समताऽदृष्टिश्रुतिसाम्यबलोद्भवाः। सर्वानुसारो लघुता विशेषादर्शनाफले॥ इष्टासिद्धिश्च नियमः पूर्वपक्षेषु युक्तयः। एता एव त्वतिबलाः सिद्धान्तस्य नियामकाः॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50006280, "chapter_id": 11343, "verse_number": "2", "content_sanskrit": "॥ ॐ स्मृत्यनवकाशदोषप्रसङ्ग इति चेन्नान्यस्मृत्यनवकाशदोषप्रसङ्गात् ॐ॥ आप्तता॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50006281, "chapter_id": 11343, "verse_number": "3", "content_sanskrit": "॥ ॐ न विलक्षणत्वादस्य तथात्वं च शब्दात् ॐ॥ समता॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50006282, "chapter_id": 11343, "verse_number": "4", "content_sanskrit": "॥ ॐ अभिमानिव्यपदेशस्तु विशेषानुगतिभ्याम् ॐ॥ अदृष्टिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50006283, "chapter_id": 11343, "verse_number": "5", "content_sanskrit": "॥ ॐ असदिति चेन्न प्रतिषेधमात्रत्वात् ॐ॥ श्रुतिसाम्यम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50006284, "chapter_id": 11343, "verse_number": "6", "content_sanskrit": "॥ ॐ भोक्त्रापत्तेरविभागश्चेत् स्याल्लोकवत् ॐ॥ बलोद्भवः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50006285, "chapter_id": 11343, "verse_number": "7", "content_sanskrit": "॥ ॐ तदनन्यत्वमारम्भणशब्दादिभ्यः ॐ॥ सर्वानुसारः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50006286, "chapter_id": 11343, "verse_number": "8", "content_sanskrit": "॥ ॐ इतरव्यपदेशाद्धिताकरणादिदोषप्रसक्तिः ॐ॥ लघुता॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50006287, "chapter_id": 11343, "verse_number": "9", "content_sanskrit": "॥ ॐ अधिकं तु भेदनिर्देशात् ॐ (ॐ श्रुतेस्तु शब्दमूलत्वात् ॐ) ॥ विशेषादर्शनम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50006288, "chapter_id": 11343, "verse_number": "10", "content_sanskrit": "॥ ॐ न प्रयोजनवत्त्वात् ॐ॥ अफलम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50006289, "chapter_id": 11343, "verse_number": "11", "content_sanskrit": "॥ ॐ वैषम्यनैर्घृण्ये न सापेक्षत्वात् तथा हि दर्शयति ॐ॥ इष्टासिद्धिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50006290, "chapter_id": 11343, "verse_number": "12", "content_sanskrit": "॥ ॐ सर्वधर्मोपपत्तेश्च ॐ॥ नियमः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}]