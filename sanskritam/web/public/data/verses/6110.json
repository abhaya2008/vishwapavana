[
  {
    "id": 16710001,
    "chapter_id": 6110,
    "verse_number": "1.1",
    "content_sanskrit": "ओमित्येतदक्षरमिदं सर्वं तस्योपव्याख्यानं भूतं भवद्भविष्यदिति सर्वमोङ्कार एव । यच्चान्यत्त्रिकालातीतं तदप्योङ्कार एव ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "base_unit_id": "MK_C01_V01"
  },
  {
    "id": 16710002,
    "chapter_id": 6110,
    "verse_number": "1.2",
    "content_sanskrit": "सर्वं ह्येतद्ब्रह्मायमात्मा ब्रह्म सोऽयमात्मा चतुष्पात् ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "base_unit_id": "MK_C01_V02"
  },
  {
    "id": 16710003,
    "chapter_id": 6110,
    "verse_number": "1.3",
    "content_sanskrit": "जागरितस्थानो बहिःप्रज्ञः सप्ताङ्ग एकोनविंशतिमुखः स्थूलभुग्वैश्वानरः प्रथमः पादः ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "base_unit_id": "MK_C01_V03"
  },
  {
    "id": 16710004,
    "chapter_id": 6110,
    "verse_number": "1.4",
    "content_sanskrit": "स्वप्नस्थानोऽन्तःप्रज्ञः सप्ताङ्ग एकोनविंशतिमुखः प्रविविक्तभुक्तैजसो द्वितीयः पादः ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "base_unit_id": "MK_C01_V04"
  },
  {
    "id": 16710005,
    "chapter_id": 6110,
    "verse_number": "1.5",
    "content_sanskrit": "यत्र सुप्तो न कञ्चन कामं कामयते न कञ्चन स्वप्नं पश्यति तत्सुषुप्तम् । सुषुप्तस्थान एकीभूतः प्रज्ञानघन एवानन्दमयो ह्यानन्दभुक्चेतोमुखः प्राज्ञस्तृतीयः पादः ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "base_unit_id": "MK_C01_V05"
  },
  {
    "id": 16710006,
    "chapter_id": 6110,
    "verse_number": "1.6",
    "content_sanskrit": "एष सर्वेश्वर एष सर्वज्ञ एषोऽन्तर्याम्येष योनिः सर्वस्य प्रभवाप्ययौ हि भूतानाम् ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "base_unit_id": "MK_C01_V06"
  },
  {
    "id": 16710007,
    "chapter_id": 6110,
    "verse_number": "1.7",
    "content_sanskrit": "बहिःप्रज्ञो विभुर्विश्वो ह्यन्तःप्रज्ञस्तु तैजसः ।\nघनप्रज्ञस्तथा प्राज्ञ एक एव त्रिधा स्थितः ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "base_unit_id": "MK_C01_K01"
  },
  {
    "id": 16710008,
    "chapter_id": 6110,
    "verse_number": "1.8",
    "content_sanskrit": "दक्षिणाक्षिमुखे विश्वो मनस्यन्तस्तु तैजसः ।\nआकाशे च हृदि प्राज्ञस्त्रिधा देहे व्यवस्थितः ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "base_unit_id": "MK_C01_K02"
  },
  {
    "id": 16710009,
    "chapter_id": 6110,
    "verse_number": "1.9",
    "content_sanskrit": "विश्वो हि स्थूलभुङ् नित्यं तैजसः प्रविविक्तभुक् ।\nआनन्दभुक्तथा प्राज्ञस्त्रिधा भोगं निबोधत ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "base_unit_id": "MK_C01_K03"
  },
  {
    "id": 16710010,
    "chapter_id": 6110,
    "verse_number": "1.10",
    "content_sanskrit": "स्थूलं तर्पयते विश्वं प्रविविक्तं तु तैजसम् ।\nआनन्दश्च तथा प्राज्ञं त्रिधा तृप्तिं निबोधत ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "base_unit_id": "MK_C01_K04"
  },
  {
    "id": 16710011,
    "chapter_id": 6110,
    "verse_number": "1.11",
    "content_sanskrit": "त्रिषु धामसु यद्भोज्यं भोक्ता यश्च प्रकीर्तितः ।\nवेदैतदुभयं यस्तु स भुञ्जानो न लिप्यते ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "base_unit_id": "MK_C01_K05"
  },
  {
    "id": 16710012,
    "chapter_id": 6110,
    "verse_number": "1.12",
    "content_sanskrit": "प्रभवः सर्वभावानां सतामिति विनिश्चयः ।\nसर्वं जनयति प्राणश्चेतोंशून्पुरुषः पृथक् ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "base_unit_id": "MK_C01_K06"
  },
  {
    "id": 16710013,
    "chapter_id": 6110,
    "verse_number": "1.13",
    "content_sanskrit": "विभूतिं प्रसवं त्वन्ये मन्यन्ते सृष्टिचिन्तकाः ।\nस्वप्नमायासरूपेति सृष्टिरन्यैर्विकल्पिता ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "base_unit_id": "MK_C01_K07"
  },
  {
    "id": 16710014,
    "chapter_id": 6110,
    "verse_number": "1.14",
    "content_sanskrit": "इच्छामात्रं प्रभोः सृष्टिरिति सृष्टौ विनिश्चिताः ।\nकालात्प्रसूतिं भूतानां मन्यन्ते कालचिन्तकाः ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "base_unit_id": "MK_C01_K08"
  },
  {
    "id": 16710015,
    "chapter_id": 6110,
    "verse_number": "1.15",
    "content_sanskrit": "भोगार्थं सृष्टिरित्यन्ये क्रीडार्थमिति चापरे ।\nदेवस्यैष स्वभावोऽयमाप्तकामस्य का स्पृहा ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "base_unit_id": "MK_C01_K09"
  },
  {
    "id": 16710016,
    "chapter_id": 6110,
    "verse_number": "1.16",
    "content_sanskrit": "नान्तःप्रज्ञं नबहिःप्रज्ञं नोभयतःप्रज्ञं नप्रज्ञानघनं नप्रज्ञं नाप्रज्ञम् । अदृश्यमव्यवहार्यमग्राह्यमलक्षणमचिन्त्यमव्यपदेश्यमेकात्मप्रत्ययसारं प्रपञ्चोपशमं शान्तं शिवमद्वैतं चतुर्थं मन्यन्ते स आत्मा स विज्ञेयः ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "base_unit_id": "MK_C01_V07"
  },
  {
    "id": 16710017,
    "chapter_id": 6110,
    "verse_number": "1.17",
    "content_sanskrit": "निवृत्तेः सर्वदुःखानामीशानः प्रभुरव्ययः ।\nअद्वैतः सर्वभावानां देवस्तुर्यो विभुः स्मृतः ॥ १० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "base_unit_id": "MK_C01_K10"
  },
  {
    "id": 16710018,
    "chapter_id": 6110,
    "verse_number": "1.18",
    "content_sanskrit": "कार्यकारणबद्धौ ताविष्येते विश्वतैजसौ ।\nप्राज्ञः कारणबद्धस्तु द्वौ तौ तुर्ये न सिध्यतः ॥ ११ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "base_unit_id": "MK_C01_K11"
  },
  {
    "id": 16710019,
    "chapter_id": 6110,
    "verse_number": "1.19",
    "content_sanskrit": "नात्मानं न परं चैव न सत्यं नापि चानृतम् ।\nप्राज्ञः किञ्चन संवेत्ति तुर्यं तत्सर्वदृक्सदा ॥ १२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "base_unit_id": "MK_C01_K12"
  },
  {
    "id": 16710020,
    "chapter_id": 6110,
    "verse_number": "1.20",
    "content_sanskrit": "द्वैतस्याग्रहणं तुल्यमुभयोः प्राज्ञतुर्ययोः ।\nबीजनिद्रायुतः प्राज्ञः सा च तुर्ये न विद्यते ॥ १३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "base_unit_id": "MK_C01_K13"
  },
  {
    "id": 16710021,
    "chapter_id": 6110,
    "verse_number": "1.21",
    "content_sanskrit": "स्वप्ननिद्रायुतावाद्यौ प्राज्ञस्त्वस्वप्ननिद्रया ।\nन निद्रां नैव च स्वप्नं तुर्ये पश्यन्ति निश्चिताः ॥ १४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "base_unit_id": "MK_C01_K14"
  },
  {
    "id": 16710022,
    "chapter_id": 6110,
    "verse_number": "1.22",
    "content_sanskrit": "अन्यथा गृह्णतः स्वप्नो निद्रा तत्त्वमजानतः ।\nविपर्यासे तयोः क्षीणे तुरीयं पदमश्नुते ॥ १५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "base_unit_id": "MK_C01_K15"
  },
  {
    "id": 16710023,
    "chapter_id": 6110,
    "verse_number": "1.23",
    "content_sanskrit": "अनादिमायया सुप्तो यदा जीवः प्रबुध्यते ।\nअजमनिद्रमस्वप्नमद्वैतं बुध्यते तदा ॥ १६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "base_unit_id": "MK_C01_K16"
  },
  {
    "id": 16710024,
    "chapter_id": 6110,
    "verse_number": "1.24",
    "content_sanskrit": "प्रपञ्चो यदि विद्येत निवर्तेत न संशयः ।\nमायामात्रमिदं द्वैतमद्वैतं परमार्थतः ॥ १७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "base_unit_id": "MK_C01_K17"
  },
  {
    "id": 16710025,
    "chapter_id": 6110,
    "verse_number": "1.25",
    "content_sanskrit": "विकल्पो विनिवर्तेत कल्पितो यदि केनचित् ।\nउपदेशादयं वादो ज्ञाते द्वैतं न विद्यते ॥ १८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "base_unit_id": "MK_C01_K18"
  },
  {
    "id": 16710026,
    "chapter_id": 6110,
    "verse_number": "1.26",
    "content_sanskrit": "सोऽयमात्माध्यक्षरमोङ्कारोऽधिमात्रं पादा मात्रा मात्राश्च पादा अकार उकारो मकार इति ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "base_unit_id": "MK_C01_V08"
  },
  {
    "id": 16710027,
    "chapter_id": 6110,
    "verse_number": "1.27",
    "content_sanskrit": "जागरितस्थानो वैश्वानरोऽकारः प्रथमा मात्राप्तेरादिमत्त्वाद्वाप्नोति ह वै सर्वान्कामानादिश्च भवति य एवं वेद ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "base_unit_id": "MK_C01_V09"
  },
  {
    "id": 16710028,
    "chapter_id": 6110,
    "verse_number": "1.28",
    "content_sanskrit": "स्वप्नस्थानस्तैजस उकारो द्वितीया मात्रोत्कर्षादुभयत्वाद्वोत्कर्षति ह वै ज्ञानसन्ततिं समानश्च भवति नास्याब्रह्मवित्कुले भवति य एवं वेद ॥ १० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "base_unit_id": "MK_C01_V10"
  },
  {
    "id": 16710029,
    "chapter_id": 6110,
    "verse_number": "1.29",
    "content_sanskrit": "सुषुप्तस्थानः प्राज्ञो मकारस्तृतीया मात्रा मितेरपीतेर्वा मिनोति ह वा इदं सर्वमपीतिश्च भवति य एवं वेद ॥ ११ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "base_unit_id": "MK_C01_V11"
  },
  {
    "id": 16710030,
    "chapter_id": 6110,
    "verse_number": "1.30",
    "content_sanskrit": "विश्वस्यात्वविवक्षायामादिसामान्यमुत्कटम् ।\nमात्रासम्प्रतिपत्तौ स्यादाप्तिसामान्यमेव च ॥ १९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "base_unit_id": "MK_C01_K19"
  },
  {
    "id": 16710031,
    "chapter_id": 6110,
    "verse_number": "1.31",
    "content_sanskrit": "तैजसस्योत्वविज्ञान उत्कर्षो दृश्यते स्फुटम् ।\nमात्रासम्प्रतिपत्तौ स्यादुभयत्वं तथाविधम् ॥ २० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "base_unit_id": "MK_C01_K20"
  },
  {
    "id": 16710032,
    "chapter_id": 6110,
    "verse_number": "1.32",
    "content_sanskrit": "मकारभावे प्राज्ञस्य मानसामान्यमुत्कटम् ।\nमात्रासम्प्रतिपत्तौ तु लयसामान्यमेव च ॥ २१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "base_unit_id": "MK_C01_K21"
  },
  {
    "id": 16710033,
    "chapter_id": 6110,
    "verse_number": "1.33",
    "content_sanskrit": "त्रिषु धामसु यस्तुल्यं सामान्यं वेत्ति निश्चितः ।\nस पूज्यः सर्वभूतानां वन्द्यश्चैव महामुनिः ॥ २२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "base_unit_id": "MK_C01_K22"
  },
  {
    "id": 16710034,
    "chapter_id": 6110,
    "verse_number": "1.34",
    "content_sanskrit": "अकारो नयते विश्वमुकारश्चापि तैजसम् ।\nमकारश्च पुनः प्राज्ञं नामात्रे विद्यते गतिः ॥ २३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "base_unit_id": "MK_C01_K23"
  },
  {
    "id": 16710035,
    "chapter_id": 6110,
    "verse_number": "1.35",
    "content_sanskrit": "अमात्रश्चतुर्थोऽव्यवहार्यः प्रपञ्चोपशमः शिवोऽद्वैत एवमोङ्कार आत्मैव संविशत्यात्मनात्मानं य एवं वेद ॥ १२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "base_unit_id": "MK_C01_V12"
  },
  {
    "id": 16710036,
    "chapter_id": 6110,
    "verse_number": "1.36",
    "content_sanskrit": "ओङ्कारं पादशो विद्यात्पादा मात्रा न संशयः ।\nओङ्कारं पादशो ज्ञात्वा न किञ्चिदपि चिन्तयेत् ॥ २४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "base_unit_id": "MK_C01_K24"
  },
  {
    "id": 16710037,
    "chapter_id": 6110,
    "verse_number": "1.37",
    "content_sanskrit": "युञ्जीत प्रणवे चेतः प्रणवो ब्रह्म निर्भयम् ।\nप्रणवे नित्ययुक्तस्य न भयं विद्यते क्वचित् ॥ २५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "base_unit_id": "MK_C01_K25"
  },
  {
    "id": 16710038,
    "chapter_id": 6110,
    "verse_number": "1.38",
    "content_sanskrit": "प्रणवो ह्यपरं ब्रह्म प्रणवश्च परं स्मृतः ।\nअपूर्वोऽनन्तरोऽबाह्योऽनपरः प्रणवोऽव्ययः ॥ २६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "base_unit_id": "MK_C01_K26"
  },
  {
    "id": 16710039,
    "chapter_id": 6110,
    "verse_number": "1.39",
    "content_sanskrit": "सर्वस्य प्रणवो ह्यादिर्मध्यमन्तस्तथैव च ।\nएवं हि प्रणवं ज्ञात्वा व्यश्नुते तदनन्तरम् ॥ २७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "base_unit_id": "MK_C01_K27"
  },
  {
    "id": 16710040,
    "chapter_id": 6110,
    "verse_number": "1.40",
    "content_sanskrit": "प्रणवं हीश्वरं विद्यात्सर्वस्य हृदये स्थितम् ।\nसर्वव्यापिनमोङ्कारं मत्वा धीरो न शोचति ॥ २८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "base_unit_id": "MK_C01_K28"
  },
  {
    "id": 16710041,
    "chapter_id": 6110,
    "verse_number": "1.41",
    "content_sanskrit": "अमात्रोऽनन्तमात्रश्च द्वैतस्योपशमः शिवः ।\nओङ्कारो विदितो येन स मुनिर्नेतरो जनः ॥ २९ ॥",
