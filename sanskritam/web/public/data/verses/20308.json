[{"id": 7000308000, "chapter_id": 20308, "verse_number": "१-६२-१", "content_sanskrit": "द्विजाऊचुः ।\nमज्जनादखिलं पापं क्षयं यांति सुनिश्चितम् ।\nमहापातकमन्यच्च तदादेशं वदस्व नः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000308001, "chapter_id": 20308, "verse_number": "१-६२-२", "content_sanskrit": "पापात्पूतोऽक्षयं नाकमश्नुते दिवि शक्रवत् ।\nसुरयोनेर्न हानिः स्यादुपदेशं वदस्व नः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000308002, "chapter_id": 20308, "verse_number": "१-६२-३", "content_sanskrit": "अत्र भोग्यं परं सर्वं मृते स्वर्गे सुरोत्तमः ।\nकलिपापहतानां च स्वर्गसोपानमुच्यते॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000308003, "chapter_id": 20308, "verse_number": "१-६२-४", "content_sanskrit": "व्यास उवाच ।\nगतिं चिंतयतां विप्रास्तूर्णं सामान्यजन्मनाम् ।\nस्त्रीपुंसामीक्षणाद्यस्माद्गंगा पापं व्यपोहति॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000308004, "chapter_id": 20308, "verse_number": "१-६२-५", "content_sanskrit": "गंगेति स्मरणादेव क्षयं याति च पातकम् ।\nकीर्तनादतिपापानि दर्शनाद्गुरुकल्मषम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000308005, "chapter_id": 20308, "verse_number": "१-६२-६", "content_sanskrit": "स्नानात्पानाच्च जाह्नव्यां पितॄणां तर्पणात्तथा ।\nमहापातकवृंदानि क्षयं यांति दिनेदिने॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000308006, "chapter_id": 20308, "verse_number": "१-६२-७", "content_sanskrit": "अग्निना दह्यते तूलं तृणं शुष्कं क्षणाद्यथा ।\nतथा गंगाजलस्पर्शात्पुंसां पापं दहेत्क्षणात्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000308007, "chapter_id": 20308, "verse_number": "१-६२-८", "content_sanskrit": "संप्राप्नोत्यक्षयं स्वर्गं गंगास्नानेन केशवम् ।\nयशो राज्यं लभेत्पुण्यें स्वर्गमंते परां गतिम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000308008, "chapter_id": 20308, "verse_number": "१-६२-९", "content_sanskrit": "पितॄनुद्दिश्य गंगायां यस्तु पिंडं प्रयच्छति ।\nविधिना वाक्यपूर्वेण तस्य पुण्यफलं शृणु॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000308009, "chapter_id": 20308, "verse_number": "१-६२-१०", "content_sanskrit": "अन्नैकेन तु साहस्रं वर्षं पूज्यः सुरालये ।\nतिलेन द्विगुणं विद्धि तथा मेध्यफलेन च॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000308010, "chapter_id": 20308, "verse_number": "१-६२-११", "content_sanskrit": "गव्येन विधिना विप्राः स्वर्गस्यांतो न विद्यते ।\nएवं पिंडप्रदानेन नित्यं क्रतुशतं भवेत्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000308011, "chapter_id": 20308, "verse_number": "१-६२-१२", "content_sanskrit": "पितरो निरयस्था ये धन्यास्ते मर्त्यवासिनः ।\nधनपुत्रयुतारोग्यं सुखसंमानपूजिताः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000308012, "chapter_id": 20308, "verse_number": "१-६२-१३", "content_sanskrit": "रसातलगता ये च ये च कीटा महीतले ।\nस्थावरे पक्षिसंघादौ ते मर्त्या धनिनो नृपाः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000308013, "chapter_id": 20308, "verse_number": "१-६२-१४", "content_sanskrit": "तत्तत्पुत्रैश्च पौत्रैश्च गोत्रैर्दौहित्रकैस्तथा ।\nजामातृभागिनेयैश्च सुहृन्मित्रैः प्रियाप्रियैः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000308014, "chapter_id": 20308, "verse_number": "१-६२-१५", "content_sanskrit": "प्रदीयते जलं पिंडं यथोपकरणान्वितम् ।\nगंगातोयेषु तीरेषु तेषां स्वर्गोऽक्षयो भवेत्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000308015, "chapter_id": 20308, "verse_number": "१-६२-१६", "content_sanskrit": "पिंडादूर्ध्वं स्थिता ये च पितरो मातृगोत्रजाः ।\nभवंति सुखिनः सर्वे मर्त्याश्शतसहस्रशः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000308016, "chapter_id": 20308, "verse_number": "१-६२-१७", "content_sanskrit": "स्वर्गे तस्य स्थिताः सत्वा अधःस्था मध्यवासिनः ।\nनित्यं वांञ्छंति सद्गंगां गच्छंतु सुरनिम्नगाम्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000308017, "chapter_id": 20308, "verse_number": "१-६२-१८", "content_sanskrit": "एको गच्छति गंगां यः पूयंते तस्य पूरुषाः ।\nएतदेव महापुण्यं तरते तारयत्यपि॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000308018, "chapter_id": 20308, "verse_number": "१-६२-१९", "content_sanskrit": "गंगा कृत्स्नगुणं वक्तुं न शक्तश्चतुराननः ।\nअतः किंचिद्वदाम्यत्र भागीरथ्या द्विजा गुणम्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000308019, "chapter_id": 20308, "verse_number": "१-६२-२०", "content_sanskrit": "मुनयः सिद्धगंधर्वा ये चान्ये सुरसत्तमाः ।\nगंगातीरे तपस्तप्त्वा स्वर्गलोकेऽच्युताभवन्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000308020, "chapter_id": 20308, "verse_number": "१-६२-२१", "content_sanskrit": "दिव्येन वपुषा सर्वे कामगेन रथेन च ।\nअद्यापि न निवर्तंते रत्नपूर्णक्षयेषु वै॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000308021, "chapter_id": 20308, "verse_number": "१-६२-२२", "content_sanskrit": "प्रासादा यत्र सौवर्णास्सर्वलोकोर्ध्वगाश्शिवाः ।\nइष्टद्रव्यैः सुसंपूर्णाः स्त्रियो यत्र मनोरमाः॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000308022, "chapter_id": 20308, "verse_number": "१-६२-२३", "content_sanskrit": "पारिजातः समाः पुष्पवृक्षाः कल्पद्रुमोपमाः ।\nगंगातीरे तपस्तप्त्वा तत्रैश्वर्यं लभंति हि॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000308023, "chapter_id": 20308, "verse_number": "१-६२-२४", "content_sanskrit": "तपोभिर्बहुभिर्यज्ञैर्व्रतैर्नानाविधैस्तथा ।\nपुरुदानैर्गतिर्या च गंगां संसेवतां च सा॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000308024, "chapter_id": 20308, "verse_number": "१-६२-२५", "content_sanskrit": "जारजं पतितं दुष्टमंत्यजं गुरुघातिनम् ।\nसर्वद्रोहेण संयुक्तं सर्वपातकसंयुतम्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000308025, "chapter_id": 20308, "verse_number": "१-६२-२६", "content_sanskrit": "त्यजंति पितरं पुत्राः प्रियं पत्न्यः सुहृद्गणाः ।\nअन्ये च बांधवाः सर्वे गंगा तु न परित्यजेत्॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000308026, "chapter_id": 20308, "verse_number": "१-६२-२७", "content_sanskrit": "यथा माता स्वयं जन्ममलशौचं च कारयेत् ।\nक्रोडीकृत्य तथा तेषां गंगा प्रक्षालयेन्मलम्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000308027, "chapter_id": 20308, "verse_number": "१-६२-२८", "content_sanskrit": "भवंति ते सुविख्याता भोग्यालंकारपूजिताः ।\nदर्शने क्रियते गंगा सकृद्भक्त्या नरैस्तु यैः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000308028, "chapter_id": 20308, "verse_number": "१-६२-२९", "content_sanskrit": "तेषां कुलानां लक्षं तु भवात्तारयते शिवा ।\nस्मृतार्ति हर्त्री यैर्ध्याता संस्तुता साधुमोदिता॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000308029, "chapter_id": 20308, "verse_number": "१-६२-३०", "content_sanskrit": "गंगा तारयते नॄणामुभौ वंशौ भवार्णवात् ।\nसंक्रांतिषु व्यतीपाते ग्रहणे चंद्रसूर्ययोः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000308030, "chapter_id": 20308, "verse_number": "१-६२-३१", "content_sanskrit": "पुण्ये स्नात्वा तु गंगायां कुलकोटिं समुद्धरेत् ।\nशुक्लपक्षे दिवामर्त्या गंगायामुत्तरायणे॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000308031, "chapter_id": 20308, "verse_number": "१-६२-३२", "content_sanskrit": "धन्या देहं विमुंचंति हृदिस्थे च जनार्दने ।\nअनेन विधिना यस्तु भागीरथ्या जले शुभे॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000308032, "chapter_id": 20308, "verse_number": "१-६२-३३", "content_sanskrit": "प्राणांस्त्यक्त्वा व्रजेत्स्वर्गं पुनरावृत्तिवर्जितम् ।\nयो गंगानुगतो नित्यं सर्वदेवानुगो हि सः॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000308033, "chapter_id": 20308, "verse_number": "१-६२-३४", "content_sanskrit": "सर्वदेवमयो विष्णुर्गंगा विष्णुमयी यतः ।\nगंगायां पिंडदानेन पितॄणां वै तिलोदकैः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000308034, "chapter_id": 20308, "verse_number": "१-६२-३५", "content_sanskrit": "नरकस्था दिवं यांति स्वर्गस्था मोक्षमाप्नुयुः ।\nपरदारपरद्रव्य बाधा द्रोहपरस्य च॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000308035, "chapter_id": 20308, "verse_number": "१-६२-३६", "content_sanskrit": "गतिर्मनुष्यमात्रस्य गंगैव परमा गतिः ।\nवेदशास्त्रविहीनस्य गुरुनिंदापरस्य च॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000308036, "chapter_id": 20308, "verse_number": "१-६२-३७", "content_sanskrit": "समयाचारहीनस्य नास्ति गंगासमा गतिः ।\nकिं यज्ञैर्बहुवित्ताढ्यैः किं तपोभिः सुदुष्करैः॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000308037, "chapter_id": 20308, "verse_number": "१-६२-३८", "content_sanskrit": "स्वर्गमोक्षप्रदा गंगा सुखसौभाग्यपूजिता ।\nनियमैः परमैर्नित्यं किं योगैश्चित्तरोधकैः॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000308038, "chapter_id": 20308, "verse_number": "१-६२-३९", "content_sanskrit": "भुक्तिमुक्तिप्रदा गंगा सुखमोक्षाग्रतः स्थिता ।\nअनेकजन्मसंघात पापं पुंसां विनश्यति॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000308039, "chapter_id": 20308, "verse_number": "१-६२-४०", "content_sanskrit": "स्नानमात्रेण गंगायां सद्यः स्यात्पुण्यभाङ्नरः ।\nप्रभासे गोसहस्रस्य राहुग्रस्ते दिवाकरे॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000308040, "chapter_id": 20308, "verse_number": "१-६२-४१", "content_sanskrit": "लभते यत्फलं दाने गंगास्नानाद्दिनेदिने ।\nदृष्ट्वा तु हरते पापं स्पृष्ट्वा तु लभते दिवम्॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000308041, "chapter_id": 20308, "verse_number": "१-६२-४२", "content_sanskrit": "प्रसंगादपि सा गंगा मोक्षदा त्ववगाहिता ।\nसर्वेन्द्रियाणां चापल्यं वासनाशक्तिसंभवम्॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000308042, "chapter_id": 20308, "verse_number": "१-६२-४३", "content_sanskrit": "निर्घृणत्वं ततो गंगा दर्शनात्प्रविनश्यति ।\nपरद्रव्याभिकांक्षित्वं परदाराभिलाषिता॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000308043, "chapter_id": 20308, "verse_number": "१-६२-४४", "content_sanskrit": "परधर्मे रुचिश्चैव दर्शनादेव नश्यति ।\nयदृच्छालाभ संतोषस्स्वधर्मेषु प्रवर्तते॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000308044, "chapter_id": 20308, "verse_number": "१-६२-४५", "content_sanskrit": "सर्वभूतसमत्वं च गङ्गायां मज्जनाद्भवेत् ।\nयस्तु गंगां समाश्रित्य सुखं तिष्ठति मानवः॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000308045, "chapter_id": 20308, "verse_number": "१-६२-४६", "content_sanskrit": "जीवन्मुक्तस्स एवेह सर्वेषामुत्तमोत्तमः ।\nगंगां संश्रित्य यस्तिष्ठेत्तस्य कार्यं न विद्यते॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000308046, "chapter_id": 20308, "verse_number": "१-६२-४७", "content_sanskrit": "कृतकृत्यस्स वै मुक्तो जीवन्मुक्तश्च मानवः ।\nयज्ञो दानं तपो जप्यं श्राद्धं च सुरपूजनम्॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000308047, "chapter_id": 20308, "verse_number": "१-६२-४८", "content_sanskrit": "गंगायां तु कृतं नित्यं कोटिकोटि गुणं भवेत् ।\nअन्यस्थाने कृतं पापं गंगातीरे विनश्यति॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000308048, "chapter_id": 20308, "verse_number": "१-६२-४९", "content_sanskrit": "गंगातीरे कृतं पापं गंगास्नानेन नश्यति ।\nआत्मनो जन्मनक्षत्रे जाह्नवीसंगते दिने॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000308049, "chapter_id": 20308, "verse_number": "१-६२-५०", "content_sanskrit": "नरः स्नात्वा तु गंगायां स्वकुलं च समुद्धरेत् ।\nआदरेण यथा स्तौति धनवंतं सदा नरः॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000308050, "chapter_id": 20308, "verse_number": "१-६२-५१", "content_sanskrit": "सकृद्गंगां तथा स्तुत्वा भवेत्स्वर्गस्य भाजनम् ।\nअश्रद्धयापि गंगायां योसौ नामानुकीर्तनं॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000308051, "chapter_id": 20308, "verse_number": "१-६२-५२", "content_sanskrit": "करोति पुण्यवाहिन्यास्स वै स्वर्गस्य भाजनम् ।\nक्षितौ भावयतो मर्त्यान्नागांस्तारयतेप्यधः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000308052, "chapter_id": 20308, "verse_number": "१-६२-५३", "content_sanskrit": "दिवि तारयते देवान्गंगा त्रिपथगा स्मृता ।\nज्ञानतोज्ञानतो वापि कामतोऽकामतोपि वा॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000308053, "chapter_id": 20308, "verse_number": "१-६२-५४", "content_sanskrit": "गंगायां च मृतो मर्त्यः स्वर्गं मोक्षं च विंदति ।\nया गतिर्योगयुक्तस्य सत्वस्थस्य मनीषिणः॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000308054, "chapter_id": 20308, "verse_number": "१-६२-५५", "content_sanskrit": "सा गतिस्त्यजतः प्राणान्गंगायां तु शरीरिणः ।\nचांद्रायणसहस्राणि यश्चरेत्कायशोधनम्॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000308055, "chapter_id": 20308, "verse_number": "१-६२-५६", "content_sanskrit": "पानं कुर्याद्यथेच्छं च गंगांभः स विशिष्यते ।\nतावत्प्रभावस्तीर्थानां देवानां तु विशेषतः॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000308056, "chapter_id": 20308, "verse_number": "१-६२-५७", "content_sanskrit": "तावत्प्रभावो वेदानां यावन्नाप्नोति जाह्नवीम् ।\nतिस्रः कोट्योर्धकोटी च तीर्थानां वायुरब्रवीत्॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000308057, "chapter_id": 20308, "verse_number": "१-६२-५८", "content_sanskrit": "दिविभुव्यन्तरिक्षे च तानि ते सन्ति जाह्नवि ।\nविष्णुपादाब्जसंभूते गंगे त्रिपथगामिनि॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000308058, "chapter_id": 20308, "verse_number": "१-६२-५९", "content_sanskrit": "धर्मद्रवेति विख्याते पापं मे हर जाह्नवि ।\nविष्णुपादप्रसूतासि वैष्णवी विष्णुपूजिता॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000308059, "chapter_id": 20308, "verse_number": "१-६२-६०", "content_sanskrit": "त्राहि मामेनसस्तस्मादाजन्ममरणांतिकात् ।\nश्रद्धया धर्मसंपूर्णे श्रीमता रजसा च ते॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000308060, "chapter_id": 20308, "verse_number": "१-६२-६१", "content_sanskrit": "अमृतेन महादेवि भागीरथि पुनीहि मां ।\nत्रिभिः श्लोकवरैरेभिर्यः स्नायाज्जाह्नवी जले॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000308061, "chapter_id": 20308, "verse_number": "१-६२-६२", "content_sanskrit": "जन्मकोटिकृतात्पापान्मुच्यते नात्र संशयः ।\nमूलमंत्रं प्रवक्ष्यामि जाह्नव्या हरभाषितम्॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000308062, "chapter_id": 20308, "verse_number": "१-६२-६३", "content_sanskrit": "सकृज्जपान्नरः पूतो विष्णुदेहे प्रतिष्ठति ।\nमंत्रश्चायं ।\nओंनमो गंगायै विश्वरूपिण्यै नारायण्यै नमोनमः॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000308063, "chapter_id": 20308, "verse_number": "१-६२-६४", "content_sanskrit": "जाह्नवीतीरसंभूतां मृदं मूर्ध्ना बिभर्ति यः ।\nसर्वपापविनिर्मुक्तो गंगास्नानं विना नरः॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000308064, "chapter_id": 20308, "verse_number": "१-६२-६५", "content_sanskrit": "गंगाजलोर्मिनिर्धूत पवनं स्पृशते यदि ।\nस पूतः कल्मषाद्घोरात्स्वर्गं चाक्षयमश्नुते॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000308065, "chapter_id": 20308, "verse_number": "१-६२-६६", "content_sanskrit": "यावदस्थि मनुष्यस्य गंगातोये प्रतिष्ठति ।\nतावद्वर्षसहस्राणि स्वर्गलोके महीयते॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000308066, "chapter_id": 20308, "verse_number": "१-६२-६७", "content_sanskrit": "पित्रोर्बंधुजनानां च अनाथानां गुरोरपि ।\nगंगायामस्थिपातेन नरः स्वर्गान्न हीयते॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000308067, "chapter_id": 20308, "verse_number": "१-६२-६८", "content_sanskrit": "गंगां प्रतिवहेद्यस्तु पितॄणामस्थिखंडकम् ।\nपदेपदेश्वमेधस्य फलं प्राप्नोति मानवः॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000308068, "chapter_id": 20308, "verse_number": "१-६२-६९", "content_sanskrit": "धन्या जानपदा ये च पशवः पक्षिकीटकाः ।\nस्थावरा जंगमाश्चान्ये गंगातीरसमाश्रिताः॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000308069, "chapter_id": 20308, "verse_number": "१-६२-७०", "content_sanskrit": "क्रोशांतर मृता ये च जाह्नव्या द्विजसत्तमाः ।\nमानवा देवतास्संति इतरे मानवा भुवि॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000308070, "chapter_id": 20308, "verse_number": "१-६२-७१", "content_sanskrit": "गंगास्नानाय संगच्छन्पथि संम्रियते यदि ।\nस च स्वर्गमवाप्नोति गंगास्नानफलं लभेत्॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000308071, "chapter_id": 20308, "verse_number": "१-६२-७२", "content_sanskrit": "गंगाजले प्रयास्यंति ते जीवाः पथि ये मृताः ।\nकीटाः पंतंगाश्शलभाः पादाघातेन गच्छतां॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000308072, "chapter_id": 20308, "verse_number": "१-६२-७३", "content_sanskrit": "ये वदंति समुद्देशं गंगां प्रति जनं द्विजाः ।\nते च यांति परं पुण्यं गंगास्नानफलं नराः॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000308073, "chapter_id": 20308, "verse_number": "१-६२-७४", "content_sanskrit": "जाह्नवीं ये च निंदंति पाषण्डैर्हतचेतसः ।\nते यांति नरकं घोरं पुनरावृत्तिदुर्लभम्॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000308074, "chapter_id": 20308, "verse_number": "१-६२-७५", "content_sanskrit": "दुस्थोवापि स्मरन्नित्यं गंगेति परिकीर्तयन् ।\nपठन्स्वर्गमवाप्नोति किमन्यैर्बहुभाषितैः॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000308075, "chapter_id": 20308, "verse_number": "१-६२-७६", "content_sanskrit": "गंगागंगेति यो ब्रूयाद्योजनानां शतैरपि ।\nमुच्यते सर्वपापेभ्यो विष्णुलोकं स गच्छति॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000308076, "chapter_id": 20308, "verse_number": "१-६२-७७", "content_sanskrit": "अंधाश्च पंगवस्ते च वृथाभव समुद्भवाः ।\nगर्भपाताद्विपद्यंते ये गंगां न गता नराः॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000308077, "chapter_id": 20308, "verse_number": "१-६२-७८", "content_sanskrit": "न कीर्तयंति ये गंगां जडतुल्या नराधमाः ।\nपरान्नोपदिशंति स्म वातूलाश्चित्तविभ्रमाः॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000308078, "chapter_id": 20308, "verse_number": "१-६२-७९", "content_sanskrit": "न पठंति जना ये च तेषां शास्त्रं विनिष्फलम् ।\nगंगापुण्यफलं विप्राः कुधियः पतिताधमाः॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000308079, "chapter_id": 20308, "verse_number": "१-६२-८०", "content_sanskrit": "पाठयंति जना ये च श्रद्धया निपठंति च ।\nगच्छंति ते दिवं धीरास्तारयंति पितॄन्गुरून्॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000308080, "chapter_id": 20308, "verse_number": "१-६२-८१", "content_sanskrit": "पाथेयकं गच्छतां यो वसु शक्त्या प्रयच्छति ।\nभागीरथ्या लभेत्स्नानं यः परान्नेन गच्छति॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000308081, "chapter_id": 20308, "verse_number": "१-६२-८२", "content_sanskrit": "कर्तुः स्नानफलं विद्याद्द्विगुणं प्रेरकस्य च ।\nइच्छयानिच्छया चापि प्रेरणेनान्यसेवया॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000308082, "chapter_id": 20308, "verse_number": "१-६२-८३", "content_sanskrit": "जाह्नवीं यो गतः पुण्यां स गच्छेन्निर्जरालयम् ।\nद्विजा ऊचुः ।\nगंगायाः कीर्तनं व्यास श्रुतं त्वत्तो विनिर्मलम्॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000308083, "chapter_id": 20308, "verse_number": "१-६२-८४", "content_sanskrit": "गंगा कस्मात्किमाकारा कुतः सा ह्यतिपावनी ।\nव्यास उवाच ।\nशृणुध्वं कथयाम्यद्य कथां पुण्यां पुरातनीं॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000308084, "chapter_id": 20308, "verse_number": "१-६२-८५", "content_sanskrit": "यां श्रुत्वा मोक्षमार्गं च प्राप्नोति नरसत्तमः ।\nब्रह्मलोकं पुरा गत्वा नारदो मुनिपुंगवः॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000308085, "chapter_id": 20308, "verse_number": "१-६२-८६", "content_sanskrit": "नत्वा विधिं च पप्रच्छ पूतं त्रैलोक्यपावनम् ।\nकिं सृष्टं च त्वया तात संमतं शंभुकृष्णयोः॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000308086, "chapter_id": 20308, "verse_number": "१-६२-८७", "content_sanskrit": "सर्वलोकहितार्थाय भुवःस्थाने समीहितम् ।\nदेवी वा देवता का वा सर्वासामुत्तमोत्तमा॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000308087, "chapter_id": 20308, "verse_number": "१-६२-८८", "content_sanskrit": "यां समासाद्य देवाश्च दैत्यमानुषपन्नगाः ।\nअंडजाः स्वेदजा वृक्षा ये चान्य उद्भिज्जादयः॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000308088, "chapter_id": 20308, "verse_number": "१-६२-८९", "content_sanskrit": "सर्वे यांति शिवं ब्रह्मन्समग्रं विभवं ध्रुवम् ।\nब्रह्मोवाच ।\nसृजता च पुरा प्रोक्ता माया प्रकृतिरूपिणी॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000308089, "chapter_id": 20308, "verse_number": "१-६२-९०", "content_sanskrit": "आद्या भव स्वलोकानां त्वत्तो भवं सृजाम्यहम् ।\nएतच्छ्रुत्वा परा सा च सप्तधा चाभवत्तदा॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000308090, "chapter_id": 20308, "verse_number": "१-६२-९१", "content_sanskrit": "गायत्रीवाक्च स्वर्लक्ष्मीस्सर्वसस्य वसुप्रदा ।\nज्ञानविद्या उमादेवी शक्तिबीजा तपस्विनी॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000308091, "chapter_id": 20308, "verse_number": "१-६२-९२", "content_sanskrit": "वर्णिका धर्मद्रवा च एतास्सप्त प्रकीर्तिताः ।\nगायत्रीप्रभवा वेदा वेदात्सर्वं स्थितं जगत्॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000308092, "chapter_id": 20308, "verse_number": "१-६२-९३", "content_sanskrit": "स्वस्ति स्वाहा स्वधा दीक्षा एता गायत्रिजा स्मृताः ।\nउच्चारयेत्सदा यज्ञे गायत्रीं मातृकादिभिः॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000308093, "chapter_id": 20308, "verse_number": "१-६२-९४", "content_sanskrit": "क्रतौ देवाः स्वधां प्राप्य भवेयुरजरामराः ।\nततस्सुधारसं देवा मुमुचुर्धरणीतले॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000308094, "chapter_id": 20308, "verse_number": "१-६२-९५", "content_sanskrit": "अथ सस्यवती पृथ्वी ओषधीनां परा शुभा ।\nफलमूलैरसैर्भक्ष्यैर्जनाः सुस्थतराभवन्॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000308095, "chapter_id": 20308, "verse_number": "१-६२-९६", "content_sanskrit": "भारती सर्वलोकानां चानने मानसे स्थिता ।\nतथैव सर्वशास्त्रेषु धर्मोद्देशं करोति सा॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000308096, "chapter_id": 20308, "verse_number": "१-६२-९७", "content_sanskrit": "विज्ञानं कलहं शोकं मोहामोहं शिवाशिवम् ।\nतया विना जगत्सर्वं यात्यतत्त्वमिति स्मृतम्॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000308097, "chapter_id": 20308, "verse_number": "१-६२-९८", "content_sanskrit": "कमलासंभवश्चैव वस्त्रभूषणसंचयः ।\nसुखं राज्यं त्रिलोके तु ततः सा हरिवल्लभा॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000308098, "chapter_id": 20308, "verse_number": "१-६२-९९", "content_sanskrit": "उमया हेतुना शंभोर्ज्ञानं लोकेषु संततम् ।\nज्ञानमाता च सा ज्ञेया शंभोरर्धाङ्गवासिनी॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000308099, "chapter_id": 20308, "verse_number": "१-६२-१००", "content_sanskrit": "वर्णिकाशक्तिरत्युग्रा सर्वलोकप्रमोहिनी ।\nसर्वलोकेषु लोकानां स्थितिसंहारकारिणी॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000308100, "chapter_id": 20308, "verse_number": "१-६२-१०१", "content_sanskrit": "देव्या च निहतौ पूर्वमसुरौ मधुकैटभौ ।\nरुरुश्चापि हतो घोरः सर्वलोकपरिश्रुतः॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000308101, "chapter_id": 20308, "verse_number": "१-६२-१०२", "content_sanskrit": "सर्वदेवैकजेतारं सा जघ्ने महिषासुरम् ।\nनिहता लीलया देव्या येऽसुरा दैत्यपुंगवाः॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000308102, "chapter_id": 20308, "verse_number": "१-६२-१०३", "content_sanskrit": "एवं बलानि दैत्यानां निहत्य सर्वदा तया ।\nपालितं मोदितं चैव कृत्स्नमेतज्जगत्त्रयम्॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000308103, "chapter_id": 20308, "verse_number": "१-६२-१०४", "content_sanskrit": "धर्मद्रवस्वरूपा च सर्वधर्मप्रतिष्ठिता ।\nमहतीं तां समालोक्य मया कमंडलौ धृता॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000308104, "chapter_id": 20308, "verse_number": "१-६२-१०५", "content_sanskrit": "विष्णुपादाब्जसम्भूता शंभुना शिरसा धृता ।\nअस्माभिश्च त्रिभिर्युक्ता ब्रह्मविष्णुमहेश्वरैः॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000308105, "chapter_id": 20308, "verse_number": "१-६२-१०६", "content_sanskrit": "धर्मद्रवा परिख्याता जलरूपा कमंडलौ ।\nबलियज्ञेषु संभूता विष्णुना प्रभविष्णुना॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000308106, "chapter_id": 20308, "verse_number": "१-६२-१०७", "content_sanskrit": "छद्मना छलितः पूर्वं बलिर्बलवतां वरः ।\nततः पादद्वयेनैव क्रांतं सर्वं महीतलम्॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7000308107, "chapter_id": 20308, "verse_number": "१-६२-१०८", "content_sanskrit": "नभः पादश्च ब्रह्माण्डं भित्वा मम पुरः स्थितः ।\nमया संपूजितः पादः कमण्डलुजलेन वै॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7000308108, "chapter_id": 20308, "verse_number": "१-६२-१०९", "content_sanskrit": "प्रक्षाल्यैवार्चितात्पादाद्धेमकूटेऽपतज्जलम् ।\nतत्कूटाच्छंकरं प्राप्य भ्रमते सा जटास्थिता॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7000308109, "chapter_id": 20308, "verse_number": "१-६२-११०", "content_sanskrit": "ततो भगीरथेनैव समाराध्य शिवं भुवि ।\nआनीयाराधितो नित्यं तपसा गजपुंगवः॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7000308110, "chapter_id": 20308, "verse_number": "१-६२-१११", "content_sanskrit": "तेन भित्वा नगं वीर्यात्त्रिभिर्दंतैः कृतं बिलम् ।\nततस्त्रिबिलगा यस्मात्त्रिस्रोता लोकविश्रुता॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7000308111, "chapter_id": 20308, "verse_number": "१-६२-११२", "content_sanskrit": "हरिब्रह्महरयोगात्पूता लोकस्य पावनी ।\nसमासाद्य च तां देवीं सर्वधर्मफलं लभेत्॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7000308112, "chapter_id": 20308, "verse_number": "१-६२-११३", "content_sanskrit": "पाठयज्ञपरैः सर्वैर्मंत्र होम सुरार्चनैः ।\nसा गतिर्न भवेज्जंतोर्गंगा संसेवया च या॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7000308113, "chapter_id": 20308, "verse_number": "१-६२-११४", "content_sanskrit": "धर्मस्य साधनोपायो ह्यतः परो न विद्यते ।\nत्रैलोक्यपुण्यसंयोगात्तस्मात्तां व्रज नारद॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7000308114, "chapter_id": 20308, "verse_number": "१-६२-११५", "content_sanskrit": "गंगातोयास्थिसंयोगात्सुतास्ते सगरस्य च ।\nस्वर्गताः पितृभिश्चैव स्वपूर्वापरजैः सह॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7000308115, "chapter_id": 20308, "verse_number": "१-६२-११६", "content_sanskrit": "ततो ब्रह्ममुखाच्छ्रुत्वा नारदो मुनिपुंगवः ।\nगंगाद्वारे तपः कृत्वा ब्रह्मणा सदृशोभवत्॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7000308116, "chapter_id": 20308, "verse_number": "१-६२-११७", "content_sanskrit": "सर्वत्र सुलभा गंगा त्रिषुस्थानेषु दुर्लभा ।\nगंगाद्वारे प्रयागे च गंगासागरसंगमे॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7000308117, "chapter_id": 20308, "verse_number": "१-६२-११८", "content_sanskrit": "त्रिरात्रेणैकरात्रेण नरो याति परां गतिम् ।\nतस्मात्सर्वप्रयत्नेन सद्यो मुक्तिं विचिंतयेत्॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7000308118, "chapter_id": 20308, "verse_number": "१-६२-११९", "content_sanskrit": "ततो गच्छत धर्मज्ञाः शिवां भागीरथीमिह ।\nअचिरेणैव कालेन स्वर्गं मोक्षं प्रगच्छथ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7000308119, "chapter_id": 20308, "verse_number": "१-६२-१२०", "content_sanskrit": "विशेषात्कलिकाले च गंगा मोक्षप्रदा नृणां ।\nकृच्छ्राच्च क्षीणसत्वानामनंतः पुण्यसंभवः॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7000308120, "chapter_id": 20308, "verse_number": "१-६२-१२१", "content_sanskrit": "ततस्ते ब्राह्मणा हृष्टाः श्रुत्वा व्यासाद्गिरं शुभाम् ।\nगंगायां तु तपस्तप्त्वा मोक्षमार्गं ययुस्तदा॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7000308121, "chapter_id": 20308, "verse_number": "१-६२-१२२", "content_sanskrit": "य इदं शृणुयान्मर्त्यः पुण्याख्यानमनुत्तमम् ।\nसर्वं तरति दुःखौघ गंगास्नानफलं लभेत्॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7000308122, "chapter_id": 20308, "verse_number": "१-६२-१२३", "content_sanskrit": "सकृदुच्चारिते चैव सर्वयज्ञफलं लभेत् ।\nदानं जप्यं तथा ध्यानं स्तोत्रं मंत्रं सुरार्चनम्॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7000308123, "chapter_id": 20308, "verse_number": "१-६२-१२४", "content_sanskrit": "तत्रैव कारयेद्यस्तु स चानंतफलं लभेत् ।\nतस्मात्तत्रैव कर्त्तव्यं जपहोमादिकं नरैः॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7000308124, "chapter_id": 20308, "verse_number": "१-६२-१२५", "content_sanskrit": "अनंतं च फलं प्रोक्तं जन्मजन्मसु लभ्यते॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}]