[{"id": 2173475, "chapter_id": 4691, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2173476, "chapter_id": 4691, "verse_number": "१", "content_sanskrit": "शल्ये तु निहते राजन् मद्रराजपदानुगाः ।\nरथाः सप्तशतं वीरा निर्ययुर्महतो बलात्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2173477, "chapter_id": 4691, "verse_number": "२", "content_sanskrit": "दुर्योधनस्तु द्विरदमारुह्याचलसन्निभम् ।\nछत्रेण ध्रियमाणेन वीज्यमानश्च चामरैः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2173478, "chapter_id": 4691, "verse_number": "३", "content_sanskrit": "न गन्तव्यं न गन्तव्यमिति मद्रानवारयत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2173479, "chapter_id": 4691, "verse_number": "४", "content_sanskrit": "दुर्योधनेन ते वीरा वार्यमाणाः पुनः पुनः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2173480, "chapter_id": 4691, "verse_number": "५", "content_sanskrit": "युधिष्ठिरं जिघांसन्तः पाण्डूनां प्राविशन् बलम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2173481, "chapter_id": 4691, "verse_number": "६", "content_sanskrit": "ते तु शूरा महाराज कृतचित्ताः स्म योधने ।\nधनुःशब्दं महत् कृत्वा सहायुध्यन्त पाण्डवैः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2173482, "chapter_id": 4691, "verse_number": "७", "content_sanskrit": "दृष्ट्वा तु निहतं शल्यं धर्मपुत्रं च पीडितम् ।\nमद्रराजप्रिये युक्तैः मद्रकाणां महारथैः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2173483, "chapter_id": 4691, "verse_number": "८", "content_sanskrit": "आजगाम ततः पार्थो गाण्डीवं विक्षिपन् धनुः ।\nपूरयन् रथघोषेण दिशः सर्वा महारथः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2173484, "chapter_id": 4691, "verse_number": "९", "content_sanskrit": "ततोऽर्जुनश्च भीमश्च माद्रीपुत्रौ च पाण्डवौ ।\nसात्यकिश्च नरव्याघ्रो द्रौपदेयाश्च सर्वशः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2173485, "chapter_id": 4691, "verse_number": "१०", "content_sanskrit": "धृष्टद्युम्नः शिखण्डी च पाञ्चालैः सह सोमकैः ।\nयुधिष्ठिरं परीप्सन्तः समन्तात् पर्यवारयन्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2173486, "chapter_id": 4691, "verse_number": "११", "content_sanskrit": "ते समन्तात् परिवृताः पाण्डवैः पुरुषर्षभैः ।\nक्षोभयन्ति स्म तां सेनां मकराः सागरं यथा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2173487, "chapter_id": 4691, "verse_number": "१२", "content_sanskrit": "पुरोवातेन गङ्गेव क्षोभ्यमाणा महानदी ।\nअक्षोभ्यत महाराज पाण्डूनां ध्वजिनी पुनः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2173488, "chapter_id": 4691, "verse_number": "१३", "content_sanskrit": "प्रस्कन्द्य महतीं सेनां त्यक्तात्मानो महारथाः ।\nवृक्षानिव महावाताः कम्पयन्ति स्म तावकाः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2173489, "chapter_id": 4691, "verse_number": "१४", "content_sanskrit": "बहवश्चुक्रुशुस्तत्र क्व च राजा युधिष्ठिरः ।\nभ्रातरो वाऽस्य ते शूरा दृश्यन्ते नेह केचन\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2173490, "chapter_id": 4691, "verse_number": "१५", "content_sanskrit": "पाञ्चालानां महावीर्यः शिखण्डी च महारथः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2173491, "chapter_id": 4691, "verse_number": "१६", "content_sanskrit": "धृष्टद्युम्नोऽथ शैनेयो द्रौपदेयाश्च सर्वशः ।\nएवं तान् वादिनः शूरा द्रौपदेया महारथाः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2173492, "chapter_id": 4691, "verse_number": "१७", "content_sanskrit": "अभ्यघ्नन् युयुधुश्चैव मद्रराजपदानुगान्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2173493, "chapter_id": 4691, "verse_number": "१८", "content_sanskrit": "चक्रैर्विमथितैः केचित् केचिच्छिन्नैर्महारथैः ।\nप्रादृश्यन्तैव समरे तावका निहता परैः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2173494, "chapter_id": 4691, "verse_number": "१९", "content_sanskrit": "आलोक्य पाण्डवान् युद्धे योधा राजन् समन्ततः ।\nवार्यमाणा ययुः सर्वे तव पुत्रेण भारत\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2173495, "chapter_id": 4691, "verse_number": "२०", "content_sanskrit": "दुर्योधनस्तु तान् वीरान् वारयामास सान्त्वयन् ।\nन चास्य शासनं कश्चित् तत्र चक्रे महारथः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2173496, "chapter_id": 4691, "verse_number": "२१", "content_sanskrit": "ततो गान्धारराजस्य पुत्रः शकुनिरब्रवीत् ।\nदुर्योधनं महाराज वचनं वचनक्षमम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2173497, "chapter_id": 4691, "verse_number": "", "content_sanskrit": "शकुनिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2173498, "chapter_id": 4691, "verse_number": "२२", "content_sanskrit": "किं नः सम्प्रेक्षमाणानां मद्राणां हन्यते बलम् ।\nन युक्तमेतत् समरे त्वयि तिष्ठति भारत\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2173499, "chapter_id": 4691, "verse_number": "२३", "content_sanskrit": "सहितैर्नाम योद्धव्यमित्येवं समयः कृतः ।\nअथ कस्मात् परानेवं घ्नतो मर्षयसेऽनघ\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2173500, "chapter_id": 4691, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2173501, "chapter_id": 4691, "verse_number": "२४", "content_sanskrit": "वार्यमाणा मया पूर्वं नैते कुर्वन्ति शासनम् ।\nएते हि निहताः सर्वे प्रस्कन्दन्तोऽरिवाहिनीम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2173502, "chapter_id": 4691, "verse_number": "", "content_sanskrit": "शकुनिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2173503, "chapter_id": 4691, "verse_number": "२५", "content_sanskrit": "न भर्तुः शासनं शूरा रणे कुर्वन्त्यमर्षिताः ।\nअलं रोद्धुं तवैतेषां नायं काल उपेक्षितुम् ।\nयामः सर्वेऽत्र सम्भूय सवाजिरथकुञ्जराः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2173504, "chapter_id": 4691, "verse_number": "२६", "content_sanskrit": "परित्रातुं महेष्वासान् मद्रराजपदानुगान्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2173505, "chapter_id": 4691, "verse_number": "२७", "content_sanskrit": "अन्योन्यं परिरक्षामो यत्नेन महता नृप ।\nएवं सर्वे तु सञ्चिन्त्य प्रयामो यत्र सैनिकाः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2173506, "chapter_id": 4691, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2173507, "chapter_id": 4691, "verse_number": "२८", "content_sanskrit": "एवमुक्तस्ततो राजा सैन्येन महता वृतः ।\nप्रययौ सिंहनादेन कम्पयानो वसुन्धराम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2173508, "chapter_id": 4691, "verse_number": "२९", "content_sanskrit": "घ्नत गृह्णीत युध्यध्वं प्रहरध्वं निकृन्तत ।\nइत्यासीत् तुमुलःशब्दः तव सैन्यस्य भारत\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2173509, "chapter_id": 4691, "verse_number": "३०", "content_sanskrit": "पाण्डवाश्च रणे दृष्ट्वा मद्रराजपदानुगान् ।\nअभ्यवर्तन्त सङ्ग्रामे गुल्ममास्थाय मध्यमम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2173510, "chapter_id": 4691, "verse_number": "३१", "content_sanskrit": "ते मुहूर्ताद् रणे वीरा हस्ताहस्तं विशाम्पते ।\nनिहताः प्रत्यदृश्यन्त मद्रराजपदानुगाः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2173511, "chapter_id": 4691, "verse_number": "३२", "content_sanskrit": "ततो नः सम्प्रयातानां हतामित्रास्तरस्विनः ।\nहृष्टाः किलकिलाशब्दमकुर्वन् सहिताः परे\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2173512, "chapter_id": 4691, "verse_number": "३३", "content_sanskrit": "अथोत्थितानि मुण्डानि समदृश्यन्त सर्वशः ।\nपपात महती चोल्का मध्येनादित्यमण्डलात्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2173513, "chapter_id": 4691, "verse_number": "३४", "content_sanskrit": "रथैर्भग्नैर्युगाक्षैश्च निहतैश्च महारथैः ।\nअश्वैर्निपातितैश्चैव दृश्यन्ते स्म समन्ततः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2173514, "chapter_id": 4691, "verse_number": "३५", "content_sanskrit": "वातायमानैस्तुरगैः युगासक्तैः समन्ततः ।\nअकृष्यन्त महाराज योधास्तत्र रणाजिरे\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2173515, "chapter_id": 4691, "verse_number": "३६", "content_sanskrit": "भग्नचक्रान् रथान् केचिद् अवहंस्तुरगा रणे ।\nरथार्धं केचिदादाय दिशो दश विबभ्रमुः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2173516, "chapter_id": 4691, "verse_number": "३७", "content_sanskrit": "तत्र तत्र च दृश्यन्ते योक्त्रैः श्लिष्टाः स्म वाजिनः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2173517, "chapter_id": 4691, "verse_number": "३८", "content_sanskrit": "रथिनः पात्यमानाश्च व्यदृश्यन्त नरोत्तम ।\nगगनात् प्रच्युताः सिद्धाः पुण्यानामिव सङ्क्षये\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2173518, "chapter_id": 4691, "verse_number": "३९", "content_sanskrit": "निहतेषु च शूरेषु मद्रराजानुगेषु च ।\nअस्मानापततश्चापि दृष्ट्वा पार्था महारथाः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2173519, "chapter_id": 4691, "verse_number": "४०", "content_sanskrit": "अभ्यवर्तन्त वेगेन जयगृध्राः प्रहारिणः ।\nबाणशब्दरवान् कृत्वा विमिश्रान् शङ्खनिःस्वनैः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2173520, "chapter_id": 4691, "verse_number": "४१", "content_sanskrit": "अस्मांस्तु पुनरासाद्य लब्धलक्षाः प्रहारिणः ।\nशरासनानि धून्वानाः सिंहनादान् प्रचक्रिरे\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2173521, "chapter_id": 4691, "verse_number": "४२", "content_sanskrit": "ततो हतमभिप्रेक्ष्य मद्रराजबलं महत् ।\nमद्रराजं च समरे दृष्ट्वा शूरं निपातितम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2173522, "chapter_id": 4691, "verse_number": "४३", "content_sanskrit": "दुर्योधनबलं सर्वं पुनरासीत् पराङ्मुखम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2173523, "chapter_id": 4691, "verse_number": "४४", "content_sanskrit": "वध्यमानं महाराज पाण्डवैर्जितकाशिभिः ।\nदिशो भेजे च सम्भ्रान्तं त्रासितं दृढधन्विभिः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2173524, "chapter_id": 4691, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशल्यपर्वणि अष्टादशोऽध्यायः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2173525, "chapter_id": 4691, "verse_number": "", "content_sanskrit": "शल्यवधपर्वणि अष्टादशोऽध्यायः ॥१८॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]