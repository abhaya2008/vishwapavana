[{"id": 2186918, "chapter_id": 4974, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2186919, "chapter_id": 4974, "verse_number": "१", "content_sanskrit": "गतीनामुत्तमा प्राप्तिः कथिता जापकेष्विह ।\nएकैवैषा गतिस्तेषामुत यान्त्यपरामपि\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2186920, "chapter_id": 4974, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2186921, "chapter_id": 4974, "verse_number": "२", "content_sanskrit": "शृणुष्वावहितो राजञ्जापकानां गतिं विभो ।\nयथा गच्छन्ति निरयमनेकं पुरुषर्षभ\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2186922, "chapter_id": 4974, "verse_number": "३", "content_sanskrit": "यथोक्तमेतत् पूर्वं यो नानुतिष्ठति जापकः ।\nएकदेशक्रियश्चात्र निरयं स निगच्छति\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2186923, "chapter_id": 4974, "verse_number": "४", "content_sanskrit": "अवमानेन कुरुते न तुष्यति न शोचति ।\nईदृशो जापको याति निरयं नात्र संशयः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2186924, "chapter_id": 4974, "verse_number": "५", "content_sanskrit": "अहङ्कारकृतश्चैव सर्वे निरयगामिनः ।\nपरावमानी पुरुषो भविता निरयोपगः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2186925, "chapter_id": 4974, "verse_number": "६", "content_sanskrit": "अभिध्यापूर्वकं जप्यं कुरुते यश्च मोहितः ।\nयत्राभिध्यां स कुरुते तं वै निरयमृच्छति\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2186926, "chapter_id": 4974, "verse_number": "७", "content_sanskrit": "अथैश्वर्यप्रवृत्तः सञ्जापकस्तत्र रज्यते ।\nस एव निरयस्तस्य नासौ तस्मात् प्रमुच्यते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2186927, "chapter_id": 4974, "verse_number": "८", "content_sanskrit": "रागेण जापको जप्यं कुरुते तत्र मोहितः ।\nयत्रास्य रागः पतति तत्र तत्रोपजायते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2186928, "chapter_id": 4974, "verse_number": "९", "content_sanskrit": "दुर्बुद्धिरकृतप्रज्ञश्चले मनसि तिष्ठति ।\nचलामेव गतिं याति निरयं वाधिगच्छति\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2186929, "chapter_id": 4974, "verse_number": "१०", "content_sanskrit": "अकृतप्रज्ञको बालो मोहं गच्छति जापकः ।\nस मोहान्निरयं याति तत्र गत्वानुशोचति\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2186930, "chapter_id": 4974, "verse_number": "११", "content_sanskrit": "दृढग्राही करोमीति जप्यं जपति जापकः ।\nन सम्पूर्णो न वा युक्तो निरयं सोऽधिगच्छति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2186931, "chapter_id": 4974, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2186932, "chapter_id": 4974, "verse_number": "१२", "content_sanskrit": "अनिमित्तं परं यत्तदव्यक्तं ब्रह्मणि स्थितम् ।\nसद्भूतो जापकः कस्मात् स शरीरमथाविशेत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2186933, "chapter_id": 4974, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2186934, "chapter_id": 4974, "verse_number": "१३", "content_sanskrit": "दुष्प्रज्ञानेन निरया बहवः समुदाहृताः ।\nप्रशस्तं जापकत्वं च दोषाश्चैते तदात्मकाः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2186935, "chapter_id": 4974, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे जापके त्रयोविंशोऽध्यायः ॥ २३ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]