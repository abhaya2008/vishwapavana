[{"id": 2041504, "chapter_id": 1921, "verse_number": "५-१६६-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2041505, "chapter_id": 1921, "verse_number": "५-१६६-१", "content_sanskrit": "सुदक्षिणस्तु काम्भोजो रथ एकगुणो मतः।\nतवार्थसिद्धिमाकाङ्क्षन्योत्स्यते समरे परैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2041506, "chapter_id": 1921, "verse_number": "५-१६६-२", "content_sanskrit": "एतस्य रथसिंहस्य तवार्थे राजसत्तम।\nपराक्रमं यथेन्द्रस्य द्रक्ष्यन्ति कुरवो युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2041507, "chapter_id": 1921, "verse_number": "५-१६६-३", "content_sanskrit": "एतस्य रथवंशे हि तिग्मवेगप्रहारिणः ।\nकाम्भोजानां महाराज शलभानामिवायतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2041508, "chapter_id": 1921, "verse_number": "५-१६६-४", "content_sanskrit": "नीलो माहिष्यतीवासी नीलवर्मा रथस्तव।\nरथवंशेन कदनं शत्रूणां वै करिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2041509, "chapter_id": 1921, "verse_number": "५-१६६-५", "content_sanskrit": "कृतवैरः पुरा चैव सहदेवेन मारिष।\nयोत्स्यते सततं राजंस्तवार्थे कुरुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2041510, "chapter_id": 1921, "verse_number": "५-१६६-६", "content_sanskrit": "विन्दानुविन्दावावन्त्यौ संमतौ रथसत्तमौ ।\nकृतिनौ समरे तात दृढवीर्यपराक्रमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2041511, "chapter_id": 1921, "verse_number": "५-१६६-७", "content_sanskrit": "एतौ तौ पुरुषव्याघ्रौ रिपुसैन्यं प्रधक्ष्यतः।\nगदाप्रासासिनाराचैस्तोमरैश्च करच्यतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2041512, "chapter_id": 1921, "verse_number": "५-१६६-८", "content_sanskrit": "युद्धाभिकामौ समरे क्रीडन्ताविव यूथपौ ।\nयूथमध्ये महाराज विचरन्तौ कृतान्तवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2041513, "chapter_id": 1921, "verse_number": "५-१६६-९", "content_sanskrit": "त्रिगर्ता भ्रातरः पञ्च रथोदारा मता मम।\nकृतवैराश्च पार्थैस्ते विराटनगरे तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2041514, "chapter_id": 1921, "verse_number": "५-१६६-१०", "content_sanskrit": "मकरा इव राजेन्द्र समुद्धततरङ्गिणीम् ।\nगङ्गां विक्षोभयिष्यन्ति पार्थानां युधि वाहिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2041515, "chapter_id": 1921, "verse_number": "५-१६६-११", "content_sanskrit": "ते रथाः पञ्च राजेन्द्र येषां सत्यरथो मुखम्।\nएते योत्स्यन्ति सङ्ग्रामे संस्मरन्तः पुराकृतमक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2041516, "chapter_id": 1921, "verse_number": "५-१६६-१२", "content_sanskrit": "व्यलीकं पाण्डवेयेन भीमसेनानुजेन ह।\nदिशो विजयता राजञ्श्वेतवाहेन भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2041517, "chapter_id": 1921, "verse_number": "५-१६६-१३", "content_sanskrit": "ते हनिष्यन्ति पार्थानां तानासाद्य महारथान्।\nवरान्वरान्महेष्वासान्क्षत्रियाणां धुरंधरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2041518, "chapter_id": 1921, "verse_number": "५-१६६-१४", "content_sanskrit": "लक्ष्णणस्तव पुत्रश्च तथा दुःशासनस्य च।\nउभौ तौ पुरुषव्याघ्रौ संग्रामेष्वपलायिनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2041519, "chapter_id": 1921, "verse_number": "५-१६६-१५", "content_sanskrit": "तरुणौ सुकुमारौ च राजपुत्रौ रतस्विनौ ।\nयुद्धानां च विशेषज्ञौ प्रणेतारौ च सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2041520, "chapter_id": 1921, "verse_number": "५-१६६-१६", "content_sanskrit": "रथौ तौ कुरुशार्दूल मतौ मे रथसत्तमौ ।\nक्षत्रधर्मरतौ वीरौ महत्कर्म करिष्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2041521, "chapter_id": 1921, "verse_number": "५-१६६-१७", "content_sanskrit": "दण्डधारो महाराज रथ एको नरर्षभ ।\nयोत्स्यते तव सङ्ग्रामे स्वेन सैन्येन पालितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2041522, "chapter_id": 1921, "verse_number": "५-१६६-१८", "content_sanskrit": "बृहद्बलस्तथा राजा कौसल्यो रथसत्तमः ।\nरथो मम मतस्तात महावेगपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2041523, "chapter_id": 1921, "verse_number": "५-१६६-१९", "content_sanskrit": "एष योत्स्यति सङ्ग्रामे स्वान्बन्धून्संप्रहर्षयन् ।\nउग्रायुधो महेष्वासो धार्तराष्ट्रहिते रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2041524, "chapter_id": 1921, "verse_number": "५-१६६-२०", "content_sanskrit": "कृपः शारद्वतो रजन्रथयूथपयूथपः।\nप्रियान्प्राणान्परित्यज्य प्रधक्ष्यति रिपूंस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2041525, "chapter_id": 1921, "verse_number": "५-१६६-२१", "content_sanskrit": "गौतमस्य महर्षेर्य आचार्यस्य शरद्वतः।\nकार्तिकेय इवाजयः शरस्तम्बात्सुतोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2041526, "chapter_id": 1921, "verse_number": "५-१६६-२२", "content_sanskrit": "एष सेनाः सुबहुला विविधायुधकार्मुकाः ।\nअग्निवत्समरे तात चरिष्यति विनिर्दहन् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2041527, "chapter_id": 1921, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि रथातिरथसंख्यानपर्वणि षट्षट्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]