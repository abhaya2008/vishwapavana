[{"id": 2069706, "chapter_id": 2457, "verse_number": "१०-९-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2069707, "chapter_id": 2457, "verse_number": "१०-९-१", "content_sanskrit": "ते हत्वा सर्वपाञ्चालान्द्रौपदेयांश्च सर्वशः।\nआगच्छन्सहितास्तत्र यत्र दुर्योधनो हतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2069708, "chapter_id": 2457, "verse_number": "१०-९-२", "content_sanskrit": "गत्वा चैनमपश्यन्त किञ्चित्प्राणं जनाधिपम्।\nततो रथेभ्यः प्रस्कन्द्य परिवव्रुस्तवात्मजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2069709, "chapter_id": 2457, "verse_number": "१०-९-३", "content_sanskrit": "तं भग्रसक्थं राजेन्द्र कृच्छ्रप्राणमचेतसम्।\nवमन्तं रुधिरं वक्त्रादपश्यन्वसुधातले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2069710, "chapter_id": 2457, "verse_number": "१०-९-४", "content_sanskrit": "वृतं समन्ताद्बहुभिः श्वापदैर्घोरदर्शनैः।\nसालावृकगणैश्चैव भक्षयिष्यद्भिरन्तिकात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2069711, "chapter_id": 2457, "verse_number": "१०-९-५", "content_sanskrit": "निरायन्तं कृच्छ्रात्ताञ्श्वापदांश्च चिखादिषून्।\nविवेष्टमानमुरुभ्यां सुभृशं गाढवेदनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2069712, "chapter_id": 2457, "verse_number": "१०-९-६", "content_sanskrit": "तं शयानं तथा दृष्ट्वा भूमौ सुरुधिरोक्षितम्।\nहतशिष्टास्त्रयो वीराः शोकार्ताः पर्यदेवयन्।\nअश्वत्थामा कृपश्चैव कृतवर्मा च सात्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2069713, "chapter_id": 2457, "verse_number": "१०-९-७", "content_sanskrit": "तैस्त्रिभिः शोणितादिग्धौर्निः श्वसद्भिर्महारथैः।\nशुशुभे स वृतो राजा वेदी त्रिभिरिवाग्निभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2069714, "chapter_id": 2457, "verse_number": "१०-९-८", "content_sanskrit": "ते तं शयानं सम्प्रेक्ष्य राजानमतथोचितम्।\nअविषह्येन दुःखेन ततस्ते रुरुदुस्त्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2069715, "chapter_id": 2457, "verse_number": "१०-९-९", "content_sanskrit": "ततस्तु रुधिरं हस्तैर्मुखान्निर्मृज्य तस्य हि।\nरणे राज्ञः शयानस्य कृपः सम्पर्यदेवयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2069716, "chapter_id": 2457, "verse_number": "१०-९-१०x", "content_sanskrit": "कृप उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2069717, "chapter_id": 2457, "verse_number": "१०-९-१०", "content_sanskrit": "न दैवस्यातिभारोऽस्ति यदयं रुधिरोक्षितः।\nएकादशचमूभर्ता शेते दुर्योधनो हतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2069718, "chapter_id": 2457, "verse_number": "१०-९-११", "content_sanskrit": "पश्य चामीकराभस्य चामीकरविभूषिताम्।\nगदां गदाप्रियस्येमां समीपे पतितां भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2069719, "chapter_id": 2457, "verse_number": "१०-९-१२", "content_sanskrit": "इयमेनं गदा शूरं न जहाति रणेरणे।\nस्वर्गायापि व्रजन्तं हि न जहाति यशस्विनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2069720, "chapter_id": 2457, "verse_number": "१०-९-१३", "content_sanskrit": "पश्येमां सह वीरेण जाम्बूनदविभूषिताम्।\nशयानां शयने हर्म्ये भार्यां प्रीतिमतीमिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2069721, "chapter_id": 2457, "verse_number": "१०-९-१४", "content_sanskrit": "योऽयं मूर्धाभिषिक्तानामग्रे याति परन्तपः।\nस हतो ग्रसते पांसून्पश्य कालसय पर्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2069722, "chapter_id": 2457, "verse_number": "१०-९-१५", "content_sanskrit": "येनाजौ निहता भूमौ शेरते क्षत्रियर्षभाः।\nस भूमौ निहतः शेते कुरुराजः परैरयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2069723, "chapter_id": 2457, "verse_number": "१०-९-१६", "content_sanskrit": "भयान्नमन्ति राजानो यस्य स्म शतसङ्घशः।\nस वीरशयने शेते क्रव्याद्भिः परिवारितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2069724, "chapter_id": 2457, "verse_number": "१०-९-१७", "content_sanskrit": "यमुपासन्नृपाः पूर्वमर्थहेतोर्महीपतिम्।\nउपात्पते च तं ह्यद्य क्रव्यादा मांसगृद्धिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2069725, "chapter_id": 2457, "verse_number": "१०-९-१८x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2069726, "chapter_id": 2457, "verse_number": "१०-९-१८", "content_sanskrit": "तं शयानं कुरुश्रेष्ठं ततो भरतसत्तमम्।\nअश्वत्थामा समालिङ्ग्य करुणं पर्यदेवयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2069727, "chapter_id": 2457, "verse_number": "१०-९-१९", "content_sanskrit": "आहुस्त्वां राजशार्दूल मुख्यं सर्वधनुष्मताम्।\nधनाध्यक्षोपमं युद्धे शिष्यं सङ्कर्षणस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2069728, "chapter_id": 2457, "verse_number": "१०-९-२०", "content_sanskrit": "कथं विवरमद्राक्षीद्भीमसेनस्तवानघ।\nबलिनं कृतिनो नित्यं सूदः पापात्मवान्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2069729, "chapter_id": 2457, "verse_number": "१०-९-२१", "content_sanskrit": "कालो नूनं महाराज लोकेऽस्मिन्बलवत्तरः।\nपश्यामो निहतं त्वां च भीमसेनेन संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2069730, "chapter_id": 2457, "verse_number": "१०-९-२२", "content_sanskrit": "कथं त्वां सर्वधर्मज्ञं क्षुद्रः पापो वृकोदरः।\nनिकृत्या हतवान्मन्दो नून कालो दुरत्ययः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2069731, "chapter_id": 2457, "verse_number": "१०-९-२३", "content_sanskrit": "द्वन्द्वयुद्धे ह्यधर्मेण समाहूयौजसा मृधे।\nगदया भीमसेनेन निर्भग्ने सक्थिनी तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2069732, "chapter_id": 2457, "verse_number": "१०-९-२४", "content_sanskrit": "अधर्मेण हतस्याजौ मृद्यमानं पदा शिरः।\nय उपेक्षितवान्क्षुद्रं धिक्तमस्तु--युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2069733, "chapter_id": 2457, "verse_number": "१०-९-२५", "content_sanskrit": "युद्धेष्वपवदिष्यन्ति योधा नूनं वृकोदरम्।\nयावत्स्थास्यन्ति भूतानि निकृत्या ह्यसि पातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2069734, "chapter_id": 2457, "verse_number": "१०-९-२६", "content_sanskrit": "ननु रामोऽब्रवीद्राजंस्त्वां सदा यदुनन्दनः।\nदुर्योधनसमो नास्ति गदायामिति वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2069735, "chapter_id": 2457, "verse_number": "१०-९-२७", "content_sanskrit": "श्लाघते त्वां हि वार्ष्णेयो राजन्संसत्सु भारत।\nस शिष्यो मम कौरव्यो गदायुद्ध इति प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2069736, "chapter_id": 2457, "verse_number": "१०-९-२८", "content_sanskrit": "यां गतिं क्षत्रियस्याहुः प्रशस्तां परमर्षयः।\nहतस्याभिमुखस्याजौ प्राप्तस्त्वमसि तां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2069737, "chapter_id": 2457, "verse_number": "१०-९-२९", "content_sanskrit": "दुर्योधन न शोचामि त्वामहं पुरुषर्षभ।\nहतपुत्रौ तु शोचामि गान्धारीं पिरं च ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2069738, "chapter_id": 2457, "verse_number": "१०-९-३०", "content_sanskrit": "द्वावनाथौ कृतौ वीर त्वया नाथेन वर्धितौ।\nभिक्षुकौ विचरिष्येते शोचन्तौ पृथिवीमिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2069739, "chapter_id": 2457, "verse_number": "१०-९-३१", "content_sanskrit": "घिगस्तु कृष्णं वार्ष्णेयमर्जुनं चापि दुर्मतिम्।\nधर्मज्ञमानिमौ यौ त्वां वध्यमानमुपेक्षताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2069740, "chapter_id": 2457, "verse_number": "१०-९-३२", "content_sanskrit": "पाण्डवाश्चापि ते सर्वे किं वक्ष्यन्ति नराधिप।\nकथं दुर्योधनोऽस्माभिर्हत इत्यनपत्रपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2069741, "chapter_id": 2457, "verse_number": "१०-९-३३", "content_sanskrit": "धन्यस्त्वमसि गान्धारे यस्वमायोधने हतः।\nप्रयातोऽभिमुखः शत्रून्धर्मेण पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2069742, "chapter_id": 2457, "verse_number": "१०-९-३४", "content_sanskrit": "हतपुत्रा हि गान्धारी निहतज्ञातिबान्धवा।\nप्रज्ञाचक्षुश्च दुर्धर्षः कां दशां प्रतिपत्स्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2069743, "chapter_id": 2457, "verse_number": "१०-९-३५", "content_sanskrit": "धिगस्तु कृतवर्माणं मां कृपं च महारथम्।\nये वयं न गताः स्वर्गं त्वां पुरस्कृत्य पार्थिवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2069744, "chapter_id": 2457, "verse_number": "१०-९-३६", "content_sanskrit": "दातारं सर्वकामानां रक्षितारं प्रजाहितम्।\nयद्वयं नानुगच्छाम त्वां धिगस्मान्नराधमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2069745, "chapter_id": 2457, "verse_number": "१०-९-३७", "content_sanskrit": "कृपस्य तव वीर्येण मम चैव पितुश्च मे।\nसभृत्यानां नरव्याघ्र रत्नवन्ति गृहाणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2069746, "chapter_id": 2457, "verse_number": "१०-९-३८", "content_sanskrit": "तव प्रसादादस्माभिः समित्रैः सह बान्धवैः।\nअवाप्ताः क्रतवो मुख्या बहवो भूरिदक्षिणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2069747, "chapter_id": 2457, "verse_number": "१०-९-३९", "content_sanskrit": "कुतश्चापीदृशं पापाः प्रवर्तिष्यामहे वयम्।\nयादृशेन पुरस्कृत्य त्वं गतः सर्वपार्थिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2069748, "chapter_id": 2457, "verse_number": "१०-९-४०", "content_sanskrit": "वयमेव त्रयो राजन्गच्छन्तं परमां गतिम्।\nयद्वै त्वां नानुगच्छाभस्तेन तप्स्यामहे वयम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2069749, "chapter_id": 2457, "verse_number": "१०-९-४१", "content_sanskrit": "तत्स्वर्गहीना हीनार्थाः स्मरन्तः सुकृतस्य ते।\nकिं नाम तद्भवेत्कर्म येन त्वां न व्रजाम वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2069750, "chapter_id": 2457, "verse_number": "१०-९-४२", "content_sanskrit": "दुःखं नून कुरुश्रेष्ठ चरिष्याम महीमिमाम्।\nहीनानां नस्त्वया राजन्कुतः शान्तिः कुतः सुखं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2069751, "chapter_id": 2457, "verse_number": "१०-९-४३", "content_sanskrit": "गत्वैव तु महाराज समेत्य च महारथान्।\nयथाज्येष्ठं यथाश्रेष्ठं पूजयेर्वचनान्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2069752, "chapter_id": 2457, "verse_number": "१०-९-४४", "content_sanskrit": "आचार्यं पूजयित्वा च केतुं सर्वधनुष्मताम्।\nहतं मयाऽद्य शंशेथा दृष्टद्युम्नं नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2069753, "chapter_id": 2457, "verse_number": "१०-९-४५", "content_sanskrit": "परिष्वजेथा राजानं बाह्लिकं सुमहारथम्।\nसैन्धवं सोमदत्तं च भूरिश्रवसमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2069754, "chapter_id": 2457, "verse_number": "१०-९-४६", "content_sanskrit": "तथा पूर्वगतानन्यान्स्वर्गे पार्थिवसत्मान्।\nअस्मद्वाक्यात्परिष्वज्य सम्पृच्छेस्वमनामयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2069755, "chapter_id": 2457, "verse_number": "१०-९-४७x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2069756, "chapter_id": 2457, "verse_number": "१०-९-४७", "content_sanskrit": "इत्येवमुक्वा राजानं भग्नसक्थमचेतसम्।\nअश्वत्थामा लघुप्राणं पुनर्वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2069757, "chapter_id": 2457, "verse_number": "१०-९-४८", "content_sanskrit": "दुर्योधन जीवसि चेद्वाक्यं श्रोत्रमुखं शृणु।\nसप् पाण्डवतः शिष्टा धार्तराष्ट्रास्त्रयो वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2069758, "chapter_id": 2457, "verse_number": "१०-९-४९", "content_sanskrit": "ते चैव भ्रातरः पञ्च वासुदेवोऽथ सात्यकिः।\nअहं च कृतवर्मा च कृपः शारद्वतस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2069759, "chapter_id": 2457, "verse_number": "१०-९-५०", "content_sanskrit": "द्रौपदेया हताः सर्वे धृष्टद्युम्नस्य चात्मजाः।\nपञ्चाला निहताः सर्वे मत्स्यशेषं च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2069760, "chapter_id": 2457, "verse_number": "१०-९-५१", "content_sanskrit": "कृते प्रतिकृतं पश्य हतपुत्रा हि पाण्डवाः।\nसौप्तिके शिबिरं तेषां हतं सनरवाहनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2069761, "chapter_id": 2457, "verse_number": "१०-९-५२", "content_sanskrit": "मया च पापकर्माऽसौ धृष्टद्युम्नो महीपते।\nप्रविश्य शिबिरं रात्रौ पशुमारेण मारितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2069762, "chapter_id": 2457, "verse_number": "१०-९-५३", "content_sanskrit": "दुर्योधनस्तु तां वाचं निशम्य मनसः प्रियाम्।\nप्रतिलभ्य पुनश्चेत इदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2069763, "chapter_id": 2457, "verse_number": "१०-९-५४", "content_sanskrit": "न मेऽकरोत्द्गाङ्गेयो न कर्णो न च ते पिता।\nयत्त्वया कृपभोजाभ्यां सहितेनाद्य मे कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2069764, "chapter_id": 2457, "verse_number": "१०-९-५५", "content_sanskrit": "स च सेनापतिः क्षुद्रो हतः सार्धं शिखण्डिना।\nतेन मन्ये मघवता सममात्मानमद्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2069765, "chapter_id": 2457, "verse_number": "१०-९-५६", "content_sanskrit": "स्वस्ति प्राप्नुत भद्रं वः स्वर्गे नः सङ्गमः पुनः।\nइत्येवमुक्त्वा पुत्रस्ते कुरुराजो महामनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2069766, "chapter_id": 2457, "verse_number": "१०-९-५७", "content_sanskrit": "प्राणानुपासृजद्वीरः सुहृदां दुःखमादधत्।\nअपाक्रामद्दिवं पुण्यां शरीरं क्षितिमाविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2069767, "chapter_id": 2457, "verse_number": "१०-९-५८", "content_sanskrit": "एवं ते निधनं यातः पुत्रो दुर्योधनो नृप।\nअग्रे यात्वा रणे शूरः पश्राद्विनिहतः परैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2069768, "chapter_id": 2457, "verse_number": "१०-९-५९", "content_sanskrit": "तथैव ते परिष्वक्ताः परिष्वज्य च ते नृपम्।\nपुनः पुनः प्रेक्षमाणाः स्वकानारुरुहू रथान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2069769, "chapter_id": 2457, "verse_number": "१०-९-६०", "content_sanskrit": "इत्येवं द्रोणपुत्रस्य निशम्य करुणां गिरम्।\nप्रत्यूषकाले शोकार्ताः प्राद्रवन्नगरं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2069770, "chapter_id": 2457, "verse_number": "१०-९-६१", "content_sanskrit": "एवमेष क्षयो वृत्तः कुरुपाण्डवसेनयोः।\nघोरो विशसनो रौद्रो राजन्दुर्मन्त्रिते तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2069771, "chapter_id": 2457, "verse_number": "१०-९-६२", "content_sanskrit": "तव पुत्रे गते स्वर्गं शोकार्स्य ममानघ।\nऋषिदत्तं प्रनष्टं तद्दिव्यदर्शित्वमद्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2069772, "chapter_id": 2457, "verse_number": "१०-९-६३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2069773, "chapter_id": 2457, "verse_number": "१०-९-६३", "content_sanskrit": "इति श्रुत्वा स नृपतिर्ज्ञातिपुत्रवधं तदा।\nनिःश्वस्य दीर्घमुष्णं च ततश्चिन्तापरोऽभवत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2069774, "chapter_id": 2457, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सौप्तिकपर्वणि नवमोऽध्यायः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]