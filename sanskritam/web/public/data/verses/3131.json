[{"id": 2099591, "chapter_id": 3131, "verse_number": "१३-२६१-१", "content_sanskrit": "भीष्म उवाच।\nइत्युक्तस्त्वर्जुनस्तूष्णीमभूद्वायुस्तमब्रवीत्।\nशृणु मे हैहयश्रेष्ठ कर्मात्रेः सुमहात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2099592, "chapter_id": 3131, "verse_number": "१३-२६१-२", "content_sanskrit": "घोरे तमस्ययुध्यन्त सहिता देवदानवाः।\nअविद्यत शरैस्तत्र स्वर्भानुः सोमभास्करौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2099593, "chapter_id": 3131, "verse_number": "१३-२६१-३", "content_sanskrit": "अथ ते तमसा ग्रस्ता निहन्यन्ते स्म दानवैः।\nदेवा नृपतिशार्दूल सहैव बलिभिस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2099594, "chapter_id": 3131, "verse_number": "१३-२६१-४", "content_sanskrit": "असुरेर्वध्यमानास्ते क्षीणप्राणा दिवौकसः।\nअपश्यन्त तपस्यन्तमत्रिं विप्रं तपोधनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2099595, "chapter_id": 3131, "verse_number": "१३-२६१-५", "content_sanskrit": "अथैनमब्रुवन्देवाः शान्तक्रोधं जितेन्द्रियम्।\nअसुरेरिषुभिर्विद्धौ चन्द्रादित्याविमावुभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2099596, "chapter_id": 3131, "verse_number": "१३-२६१-६", "content_sanskrit": "वयं वध्यामहे चापि शत्रुभिस्तमसा वृते।\nनाधिगच्छाम शान्तिं च भयात्त्रायस्व नः प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2099597, "chapter_id": 3131, "verse_number": "१३-२६१-७x", "content_sanskrit": "अत्रिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2099598, "chapter_id": 3131, "verse_number": "१३-२६१-७", "content_sanskrit": "कथं रक्षामि भवतस्तेऽब्रुवंश्चन्द्रमा भव।\nतिमिरघ्नश्च सविता दस्युहन्ता च नो भव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2099599, "chapter_id": 3131, "verse_number": "१३-२६१-८", "content_sanskrit": "एवमुक्तस्तदात्रिर्वै तमोनुदभवच्छशी।\nअपश्यत्सौम्यभावाच्च सोमवत्प्रियदर्शनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2099600, "chapter_id": 3131, "verse_number": "१३-२६१-९", "content_sanskrit": "दृष्ट्वा नातिप्रभं सोमं तथा सूर्यं च पार्थिव।\nप्रकाशमकरोदत्रिस्तपसा स्वेन संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2099601, "chapter_id": 3131, "verse_number": "१३-२६१-१०", "content_sanskrit": "जगद्वितिमिरं चापि प्रदीप्तमकरोत्तदा।\nव्यजयच्छत्रुसङ्घांश्च देवानां स्वेन तेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2099602, "chapter_id": 3131, "verse_number": "१३-२६१-११", "content_sanskrit": "अत्रिणा दह्यमानांस्तान्दृष्ट्वा देवा महासुरान्।\nपराक्रमैस्तेऽपिं तदा व्यघ्नन्नत्रिसुरक्षिताः।\nउद्भासितश्च सविता देवास्त्राता हतासुराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2099603, "chapter_id": 3131, "verse_number": "१३-२६१-१२", "content_sanskrit": "अत्रिणा त्वथ सोमत्वं कृतमुत्तमतेजसा।\nद्विजेनाग्निद्वितीयेनि जपता चर्मवाससा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2099604, "chapter_id": 3131, "verse_number": "१३-२६१-१३", "content_sanskrit": "फलभक्षेण राजर्षे पश्य कर्मात्रिणा कृतम्।\nतस्यापि विस्तरेणोक्तं कर्मात्रेः सुमहात्मनः।\nब्रवीम्यन्यं ब्रूहि वा त्वमत्रितः क्षत्रियं वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2099605, "chapter_id": 3131, "verse_number": "१३-२६१-१४", "content_sanskrit": "इत्युक्तस्त्वर्जुनस्तूष्णीमभूद्वायुस्ततोऽब्रवीत्।\nशृणु राजन्महत्कर्म च्यवनस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2099606, "chapter_id": 3131, "verse_number": "१३-२६१-१५", "content_sanskrit": "अश्विनोः प्रतिसंश्रुत्य च्यवनः पाकशासनम्।\nप्रोवाच सहितो देवैः सोमपावश्विनौ कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2099607, "chapter_id": 3131, "verse_number": "१३-२६१-१६x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2099608, "chapter_id": 3131, "verse_number": "१३-२६१-१६", "content_sanskrit": "अस्माभिर्निन्दितावेतौ भवेतां सोमपौ कथम्।\nदेवैर्न सम्मितावेतौ तस्मान्मैवं वदस्व नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2099609, "chapter_id": 3131, "verse_number": "१३-२६१-१७", "content_sanskrit": "अश्विभ्यां सह नेच्छामः सोमं पातुं महाव्रत।\nयदन्यद्वक्ष्यसे विप्र तत्करिष्याम ते वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2099610, "chapter_id": 3131, "verse_number": "१३-२६१-१८x", "content_sanskrit": "च्यवन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2099611, "chapter_id": 3131, "verse_number": "१३-२६१-१८", "content_sanskrit": "पिबेतामश्विनौ सोमं भवद्भिः सहिताविमौ।\nउभावेतावपि सुरौ सूर्यपुत्रौ सुरेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2099612, "chapter_id": 3131, "verse_number": "१३-२६१-१९", "content_sanskrit": "क्रियतां मद्वचो देवा यथा वै समुदाहृतम्।\nएतद्वः कुर्वतां श्रेयो भवेन्नैतदकुर्वताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2099613, "chapter_id": 3131, "verse_number": "१३-२६१-२०x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2099614, "chapter_id": 3131, "verse_number": "१३-२६१-२०", "content_sanskrit": "अश्विभ्यां सह सोमं वै न पास्यामि द्विजोत्तम।\nपिबन्त्वन्ये यथाकामं नाहं पातुमिहोत्सहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2099615, "chapter_id": 3131, "verse_number": "१३-२६१-२१x", "content_sanskrit": "च्यवन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2099616, "chapter_id": 3131, "verse_number": "१३-२६१-२१", "content_sanskrit": "न चेत्करिष्यसि वचो मयोक्तं बलसूदन।\nमया प्रमथितः सद्यः सोमं पास्यसि वै मखे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2099617, "chapter_id": 3131, "verse_number": "१३-२६१-२२x", "content_sanskrit": "वायुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2099618, "chapter_id": 3131, "verse_number": "१३-२६१-२२", "content_sanskrit": "ततः कर्म समारब्धं हिताय सहसाऽश्विनोः।\nच्यवनेनि ततो मन्त्रैरभिभूताः सुराऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2099619, "chapter_id": 3131, "verse_number": "१३-२६१-२३", "content_sanskrit": "तत्तु कर्म समारब्धं दृष्ट्वेन्द्रः क्रोधमूर्च्छितः।\nउद्यम्य विपुलं शैलं च्यवनं समुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2099620, "chapter_id": 3131, "verse_number": "१३-२६१-२४", "content_sanskrit": "तथा वज्रेम भगवानमर्षाकुललोचनः।\nतमापतन्तं दृष्ट्वैव च्यवनस्तपसाऽन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2099621, "chapter_id": 3131, "verse_number": "१३-२६१-२५", "content_sanskrit": "अद्भिः सिक्त्वाऽस्तम्ययतं सवज्रं सहपर्वतम्।\nअथेन्द्रस्य महाघोरं सोऽसृजच्छत्रुमेव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2099622, "chapter_id": 3131, "verse_number": "१३-२६१-२६", "content_sanskrit": "मदं नामाहुतिमयं व्यादितास्यं महामुनिः।\nतस्य दन्तसहस्रं तु बभूव शतयोजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2099623, "chapter_id": 3131, "verse_number": "१३-२६१-२७", "content_sanskrit": "द्वियोजनशतास्तस्य दंष्ट्राः परमदारुणाः।\nहनुस्तस्याभवद्भूमावास्यं चास्यास्पृशद्दिवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2099624, "chapter_id": 3131, "verse_number": "१३-२६१-२८", "content_sanskrit": "जिह्वामूले स्थितास्तस्य सर्वे देवाः सवासवाः।\nतिमेरास्यमनुप्राप्ता यथा मत्स्या महार्णवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2099625, "chapter_id": 3131, "verse_number": "१३-२६१-२९", "content_sanskrit": "ते सम्मन्त्र्य ततो देवा मदस्यास्य समीपगाः।\nअब्रुवन्सहिताः शक्रं प्रणमास्मै द्विजातये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2099626, "chapter_id": 3131, "verse_number": "१३-२६१-३०", "content_sanskrit": "अश्विभ्यां सह सोमं च पिबाम विगतज्वराः।\nततः स प्रणतः शक्रश्चकार च्यवनस्य तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2099627, "chapter_id": 3131, "verse_number": "१३-२६१-३१", "content_sanskrit": "च्यवनः कृतवानेतावश्विनौ सोमपायिनौ।\nततः प्रत्याहरत्कर्म मदं च व्यभजन्मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2099628, "chapter_id": 3131, "verse_number": "१३-२६१-३२", "content_sanskrit": "अक्षेषु मृगयायां च पाने स्त्रीषु च वीर्यवान्।\nएतैर्दोषैर्नरा राजन्क्षयं यान्ति न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2099629, "chapter_id": 3131, "verse_number": "१३-२६१-३३", "content_sanskrit": "तस्मादेतान्नरो नित्यं दूरतः परिवर्जयेतद्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2099630, "chapter_id": 3131, "verse_number": "१३-२६१-३४", "content_sanskrit": "एतत्ते च्यवनस्यापि कर्मि राजन्प्रकीर्तितम्।\nब्रवीम्यन्यं ब्रूहि वा त्वं क्षत्रियं ब्राह्मणाद्वरम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2099631, "chapter_id": 3131, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकषष्ट्यधिकद्विशततमोऽध्यायः॥ २६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]