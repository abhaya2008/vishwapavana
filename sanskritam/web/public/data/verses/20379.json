[{"id": 7000379000, "chapter_id": 20379, "verse_number": "२-५१-१", "content_sanskrit": "ब्राह्मण्युवाच ।\nगते तस्मिन्दुराचारे गोभिले पापचेतसि ।\nपद्मावती रुरोदाथ दुःखेन महतान्विता॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000379001, "chapter_id": 20379, "verse_number": "२-५१-२", "content_sanskrit": "तस्यास्तु रुदितं श्रुत्वा सख्यः सर्वा द्विजोत्तम ।\nपप्रच्छुस्तां राजकन्यां ताः सर्वाश्च वराननाः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000379002, "chapter_id": 20379, "verse_number": "२-५१-३", "content_sanskrit": "कस्माद्रोदिषि भद्रं ते कथयस्व हि चेष्टितम् ।\nक्व गतोऽसौ महाराजो माथुराधिपतिस्तव॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000379003, "chapter_id": 20379, "verse_number": "२-५१-४", "content_sanskrit": "येन त्वं हि समाहूता प्रियेत्युक्त्वा वदस्व नः ।\nता उवाच सुदुःखेन रोदमाना पुनः पुनः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000379004, "chapter_id": 20379, "verse_number": "२-५१-५", "content_sanskrit": "तया आवेदितं सर्वं यज्जातं दोषसंभवम् ।\nताभिर्नीता पितुर्गेहं वेपमाना सुदुःखिता॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000379005, "chapter_id": 20379, "verse_number": "२-५१-६", "content_sanskrit": "मातुः समक्षं तस्यास्तु आचचक्षुस्तदा स्त्रियः ।\nसमाकर्ण्य ततो देवी गता सा भर्तृमंदिरम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000379006, "chapter_id": 20379, "verse_number": "२-५१-७", "content_sanskrit": "भर्तारं श्रावयामास सुतावृत्तांतमेव हि ।\nसमाकर्ण्य ततो राजा महादुःखी अजायत॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000379007, "chapter_id": 20379, "verse_number": "२-५१-८", "content_sanskrit": "यानाच्छादनकं दत्वा परिवारसमन्विताम् ।\nमथुरां प्रेषयामास गता सा प्रियमंदिरम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000379008, "chapter_id": 20379, "verse_number": "२-५१-९", "content_sanskrit": "सुतादोषं समाच्छाद्य पितामाता द्विजोत्तम ।\nउग्रसेनस्तु धर्मात्मा पद्मावतीं समागताम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000379009, "chapter_id": 20379, "verse_number": "२-५१-१०", "content_sanskrit": "स दृष्ट्वा मुमुदे चाशु उवाचेदं वचः पुनः ।\nत्वया विना न शक्तोस्मि जीवितुं हि वरानने॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000379010, "chapter_id": 20379, "verse_number": "२-५१-११", "content_sanskrit": "बहुप्रभासि मे प्रीता गुणशीलैस्तु सर्वदा ।\nभक्त्या सत्येन ते कांते पतिदैवत्यकैर्गुणैः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000379011, "chapter_id": 20379, "verse_number": "२-५१-१२", "content_sanskrit": "समाभाष्य प्रियां भार्यां पद्मावतीं नरेश्वरः ।\nतया सार्धं स वै रेमे उग्रसेनो नृपोत्तमः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000379012, "chapter_id": 20379, "verse_number": "२-५१-१३", "content_sanskrit": "ववृधे दारुणो गर्भः सर्वलोकभयप्रदः ।\nपद्मावती विजानाति तस्य गर्भस्य कारणम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000379013, "chapter_id": 20379, "verse_number": "२-५१-१४", "content_sanskrit": "स्वोदरे वर्द्धमानस्य चिंतयंती दिवानिशम् ।\nअनेन किमु जातेन लोकनाशकरेण वै॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000379014, "chapter_id": 20379, "verse_number": "२-५१-१५", "content_sanskrit": "अनेनापि न मे कार्यं दुष्टपुत्रेण सांप्रतम् ।\nऔषधीं पृच्छते सा तु गर्भपातस्य सर्वतः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000379015, "chapter_id": 20379, "verse_number": "२-५१-१६", "content_sanskrit": "नारी महौषधीं सा हि विंदंती च दिने दिने ।\nगर्भस्य पातनायैव उपाया बहुशः कृताः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000379016, "chapter_id": 20379, "verse_number": "२-५१-१७", "content_sanskrit": "ववृधे दारुणो गर्भः सर्वलोकभयंकरः ।\nतामुवाच ततो गर्भः पद्मावतीं च मातरम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000379017, "chapter_id": 20379, "verse_number": "२-५१-१८", "content_sanskrit": "कस्मात्त्वं व्यथसे मातरौषधीभिर्दिनेदिने ।\nपुण्येन वर्द्धते चायुः पापेनाल्पं तु जीवितम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000379018, "chapter_id": 20379, "verse_number": "२-५१-१९", "content_sanskrit": "आत्मकर्मविपाकेन जीवंति च म्रियंति च ।\nआमगर्भाः प्रयांत्यन्ये अपक्वास्तु महीतले॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000379019, "chapter_id": 20379, "verse_number": "२-५१-२०", "content_sanskrit": "जातमात्रा म्रियंतेऽन्ये कति ते यौवनान्विताः ।\nबाला वृद्धाश्च तरुणा आयुषोवशतां गताः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000379020, "chapter_id": 20379, "verse_number": "२-५१-२१", "content_sanskrit": "सर्वे कर्मविपाकेन जीवंति च म्रियंति च ।\nओषध्यो मंत्रदेवाश्च निमित्ताः स्युर्न संशयः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000379021, "chapter_id": 20379, "verse_number": "२-५१-२२", "content_sanskrit": "मामेव हि न जानासि भवती यादृशो ह्यहम् ।\nदृष्टः श्रुतस्त्वया पूर्वं कालनेमिर्महाबलः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000379022, "chapter_id": 20379, "verse_number": "२-५१-२३", "content_sanskrit": "दानवानां महावीर्यस्त्रैलोक्यस्य भयप्रदः ।\nदेवासुरे महायुद्धे हतोहं विष्णुना पुरा॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000379023, "chapter_id": 20379, "verse_number": "२-५१-२४", "content_sanskrit": "साधयितुं च तद्वैरमागतोऽस्मि तवोदरम् ।\nसाहसं च श्रमं मातर्मा कुरुष्व दिन दिने॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000379024, "chapter_id": 20379, "verse_number": "२-५१-२५", "content_sanskrit": "एवमुक्त्वा द्विजश्रेष्ठ मातरं विरराम सः ।\nमातोद्यमं परित्यज्य महादुःखादभूत्तदा॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000379025, "chapter_id": 20379, "verse_number": "२-५१-२६", "content_sanskrit": "दशाब्दाश्च गता यावत्तावद्वृद्धिमवाप्तवान् ।\nपश्चाज्जज्ञे महातेजाः कंसोभूत्स महाबलः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000379026, "chapter_id": 20379, "verse_number": "२-५१-२७", "content_sanskrit": "येन संत्रासिता लोकास्त्रैलोक्यस्य निवासिनः ।\nयो हतो वासुदेवेन गतो मोक्षं न संशयः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000379027, "chapter_id": 20379, "verse_number": "२-५१-२८", "content_sanskrit": "एवं श्रुतं मया कांत भविष्यं तु भविष्यति ।\nपुराणेष्वेव सर्वेषु निश्चितं कथितं तव॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000379028, "chapter_id": 20379, "verse_number": "२-५१-२९", "content_sanskrit": "पितृगेहेस्थिता कन्या नाशमेवं प्रयाति सा ।\nगृहावासाय मे कांत कन्या मोहं न कारयेत्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000379029, "chapter_id": 20379, "verse_number": "२-५१-३०", "content_sanskrit": "इमां दुष्टां महापापां परित्यज्य स्थिरो भव ।\nप्राप्तव्यं तु महापापं दुःखं दारुणमेव च॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000379030, "chapter_id": 20379, "verse_number": "२-५१-३१", "content_sanskrit": "लोके श्रेयःकरं कांत तद्भुंक्ष्व त्वं मया सह ।\nशूकर्युवाच ।\nएतद्वाक्यं सुमंत्रं तु श्रुत्वा स हि द्विजोत्तमः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000379031, "chapter_id": 20379, "verse_number": "२-५१-३२", "content_sanskrit": "त्यागे मतिं चकारासौ समाहूता ह्यहं तदा ।\nसकलं वस्त्रशृंगारं मम दत्तं शुभे शृणु॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000379032, "chapter_id": 20379, "verse_number": "२-५१-३३", "content_sanskrit": "तवैव दुर्नयैर्विप्रः शिवशर्मा द्विजोत्तमः ।\nगतो वै मतिमान्दुष्टे कुलदुष्टप्रचारिणि॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000379033, "chapter_id": 20379, "verse_number": "२-५१-३४", "content_sanskrit": "यत्र ते तिष्ठते भर्ता तत्र गच्छ न संशयः ।\nतव यद्रोचते स्थानं यथादिष्टं तथा कुरु॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000379034, "chapter_id": 20379, "verse_number": "२-५१-३५", "content_sanskrit": "एवमुक्त्वा महाभागे पितृमातृकुटुंबकैः ।\nपरित्यक्ता गता शीघ्रं निर्लज्जाहं वरानने॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000379035, "chapter_id": 20379, "verse_number": "२-५१-३६", "content_sanskrit": "न लभाम्यहमेवापि वासस्थानं सुखं शुभे ।\nभर्त्सयंति च मां लोकाः पुंश्चलीयं समागता॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000379036, "chapter_id": 20379, "verse_number": "२-५१-३७", "content_sanskrit": "अटमाना गता देशात्कुलमानेन वर्जिता ।\nदेशे गुर्जरके पुण्ये सौराष्ट्रे शिवमंदिरे॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000379037, "chapter_id": 20379, "verse_number": "२-५१-३८", "content_sanskrit": "वनस्थलेति विख्यातं नगरं वृद्धिसंकुलम् ।\nअतीव पीडिता देवि क्षुधयाहं तदा शृणु॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000379038, "chapter_id": 20379, "verse_number": "२-५१-३९", "content_sanskrit": "कर्परं हि करे गृह्य भिक्षार्थमुपचक्रमे ।\nगृहिणां द्वारदेशेषु प्रविशामि सुदुःखिता॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000379039, "chapter_id": 20379, "verse_number": "२-५१-४०", "content_sanskrit": "मम रूपं विपश्यंति लोकाः कुत्संति भामिनि ।\nन ददंते च मे भिक्षां पापा चेयं समागता॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000379040, "chapter_id": 20379, "verse_number": "२-५१-४१", "content_sanskrit": "एवं दुःखसमाहारा दारिद्र्यपरिपीडिता ।\nअटंत्या च मया दृष्टं गृहमेकमनुत्तमम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000379041, "chapter_id": 20379, "verse_number": "२-५१-४२", "content_sanskrit": "तुंगप्राकारसंवेष्टं वेदशालासमन्वितम् ।\nवेदध्वनिसमाकीर्णं बहुविप्रसमाकुलम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000379042, "chapter_id": 20379, "verse_number": "२-५१-४३", "content_sanskrit": "धनधान्यसमाकीर्णं दासीदासैरलंकृतम् ।\nप्रविवेश गृहं रम्यं लक्ष्मीमुदितमेव तत्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000379043, "chapter_id": 20379, "verse_number": "२-५१-४४", "content_sanskrit": "तद्गृहं सर्वतोभद्रं तस्यैव शिवशर्मणः ।\nभिक्षां देहीत्युवाचाथ सुदेवा दुःखपीडिता॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000379044, "chapter_id": 20379, "verse_number": "२-५१-४५", "content_sanskrit": "शिवशर्माथ शुश्राव भिक्षाशब्दं द्विजोत्तमः ।\nमंगलां नाम वै भार्यां लक्ष्मीरूपां वराननाम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000379045, "chapter_id": 20379, "verse_number": "२-५१-४६", "content_sanskrit": "तां हसन्प्राह धर्मात्मा शिवशर्मा महामतिः ।\nइयं हि दुर्बला प्राप्ता भिक्षार्थं द्वारमागता॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000379046, "chapter_id": 20379, "verse_number": "२-५१-४७", "content_sanskrit": "समाहूय प्रिये चैनां देहि त्वं भोजनं शुभे ।\nकृपया परयाविष्टा ज्ञात्वा मां तु समागताम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000379047, "chapter_id": 20379, "verse_number": "२-५१-४८", "content_sanskrit": "प्रोवाच मंगला कांतं दास्यामि प्रिय भोजनम् ।\nएवमुक्त्वा च भर्तारं मंगला मंगलान्विता॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000379048, "chapter_id": 20379, "verse_number": "२-५१-४९", "content_sanskrit": "पुनर्मां भोजयामास मिष्टान्नेन सुदुर्बलाम् ।\nमामुवाच स धर्मात्मा शिवशर्मा महामुनिः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000379049, "chapter_id": 20379, "verse_number": "२-५१-५०", "content_sanskrit": "का त्वमत्र समायाता कस्य वा भ्रमसे जगत् ।\nकेन कार्येण सर्वत्र कथयस्व ममाग्रतः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000379050, "chapter_id": 20379, "verse_number": "२-५१-५१", "content_sanskrit": "एवमाकर्ण्य तद्वाक्यं भर्तुश्चैव महात्मनः ।\nस्वरेण लक्षितः कांतो मया वै पापया तदा॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000379051, "chapter_id": 20379, "verse_number": "२-५१-५२", "content_sanskrit": "व्रीडयाधोमुखीजाता दृष्टो भर्ता यदा मया ।\nमंगला चारुसर्वांगी भर्तारमिदमब्रवीत्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000379052, "chapter_id": 20379, "verse_number": "२-५१-५३", "content_sanskrit": "का चेयं हि समाचक्ष्व त्वां दृष्ट्वा हि विलज्जति ।\nकथयस्व प्रसादेन का च एषा भविष्यति॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]