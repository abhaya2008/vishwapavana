[{"id": 7002472000, "chapter_id": 22472, "verse_number": "१-१३४-१", "content_sanskrit": "नारद उवाच ।\nप्रतिपच्य द्वितीया च चतुर्थी पञ्चमी तथा ।\nदशमी त्रयोदशी चैव पौर्णमासी च कीर्तिता ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002472001, "chapter_id": 22472, "verse_number": "१-१३४-२", "content_sanskrit": "सोमो बृहस्पतिश्चैव शुक्रश्चैव बुधस्तथा ।\nएते सौम्या ग्रहाः प्रोक्ताः प्रतिष्ठायज्ञकर्मणि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002472002, "chapter_id": 22472, "verse_number": "१-१३४-३", "content_sanskrit": "त्रिषूत्तरासु रेवत्यामश्विन्यां ब्राह्मभे तथा ।\nपुनर्वस्वोस्तथा हस्ते वासवे१ श्रवणेऽथवा ।\nभरण्यां चैव नक्षत्रे भानोः१ स्थापनमुत्तमम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002472003, "chapter_id": 22472, "verse_number": "१-१३४-४", "content_sanskrit": "शोधयित्वा तु वै भूमिं तुषकेशविवर्जिताम् ।\nवालुकाङ्गारपाषाणास्थिविहीनां विशोध्य तु ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002472004, "chapter_id": 22472, "verse_number": "१-१३४-५", "content_sanskrit": "चतुर्हस्तसमायुक्ता वेदी विस्तरतो रवेः२ ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002472005, "chapter_id": 22472, "verse_number": "१-१३४-६", "content_sanskrit": "मण्डपस्तु प्रमाणेन दशहस्तः समंततः ।\nमण्डलं वृक्षशाखाभिः कारयेद्विधिपूर्वकम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002472006, "chapter_id": 22472, "verse_number": "१-१३४-७", "content_sanskrit": "नदीसङ्गमतीरोत्थां मृत्तिकां च समानयेत् ।\nउपलिप्य ततो भूमिं कारयेत्कुण्डमुत्तमम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002472007, "chapter_id": 22472, "verse_number": "१-१३४-८", "content_sanskrit": "चतुरस्रं श्रिया युक्तं पूर्वं कुण्डं तु कारयेत् ।\nदक्षिणे चार्धचन्द्रं स्याद्वारुण्यां दिशि वर्तुलम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002472008, "chapter_id": 22472, "verse_number": "१-१३४-९", "content_sanskrit": "पद्माकारं तु वै कुर्यादुत्तरे४ च विचक्षणः ।\nतोरणानि ततः कुर्यात्पञ्चहस्तानि सुव्रत ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002472009, "chapter_id": 22472, "verse_number": "१-१३४-१०", "content_sanskrit": "न्यग्रोधोदुम्बरौ चैव बिल्वपालाशमेव च ।\nअश्वत्थश्च शमी चैव चन्दनश्चेति कीर्तिताः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002472010, "chapter_id": 22472, "verse_number": "१-१३४-११", "content_sanskrit": "शुक्लवस्त्रसमायुक्तश्चित्रपट्टसमन्वितः ।\nजपमालान्वितः कुर्यात्तोरणानि विचक्षणः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002472011, "chapter_id": 22472, "verse_number": "१-१३४-१२", "content_sanskrit": "अग्निमीऌएति मन्त्रेण यजेद्वै पूर्वतोरणम् ।\nइषेत्वोर्जेति मन्त्रेण यजेद्दक्षिणतोरणम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002472012, "chapter_id": 22472, "verse_number": "१-१३४-१३", "content_sanskrit": "अग्न आयाहीति मन्त्रेण पश्चिमं तु समर्चयेत् ।\nशं नो देवीति मन्त्रेण यजेदुत्तरतोरणम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002472013, "chapter_id": 22472, "verse_number": "१-१३४-१४", "content_sanskrit": "कलशांस्तु समादाय हेमगर्भसमन्वितान् ।\nश्वेतचन्दनपङ्केन कण्ठस्वस्तिकभूषणान् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002472014, "chapter_id": 22472, "verse_number": "१-१३४-१५", "content_sanskrit": "यवशालिशरावान्नवस्त्रालङ्कारविग्रहान् ।\nआजिघ्रेति च मन्त्रेण कलशांस्तु निवेशयेत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002472015, "chapter_id": 22472, "verse_number": "१-१३४-१६", "content_sanskrit": "दुकूलश्चित्रपट्टैश्च वेष्टयेत्स्तम्भमालिकाम् ।\nध्वजादर्शपताकाभिश्चामरैस्तु वितानकैः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002472016, "chapter_id": 22472, "verse_number": "१-१३४-१७", "content_sanskrit": "शङ्खघण्टानिनादैश्च गेयमङ्गलवाचनैः ।\nतूर्यभेरीनिनादैश्च वेदध्वनिसमन्वितैः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002472017, "chapter_id": 22472, "verse_number": "१-१३४-१८", "content_sanskrit": "पुण्यैश्च जयशब्दैश्च कारयेत महोत्सवम् ।\nपताकाभिर्विचित्राभिः पूजामाल्योपशोभितम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002472018, "chapter_id": 22472, "verse_number": "१-१३४-१९", "content_sanskrit": "विचित्रस्रग्वितानाढ्यं प्रकीर्णकुसुमाङ्कुरम् ।\nतन्मध्ये तु कुशास्तीर्णे देवार्चां स्थापयेद् बुधः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002472019, "chapter_id": 22472, "verse_number": "१-१३४-२०", "content_sanskrit": "पताकां पीतवर्णां तु पूर्वे शक्राय दापयेत् ।\nआग्नेय्यां रक्तवर्णाभां१२ यमाशायां यमोपमान् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002472020, "chapter_id": 22472, "verse_number": "१-१३४-२१", "content_sanskrit": "नीलाञ्जनसमप्रख्यां नैरृत्यां च प्रदापयेत् ।\nवारुण्यां सितवर्णां च कृष्णां वायव्यगोचरे ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002472021, "chapter_id": 22472, "verse_number": "१-१३४-२२", "content_sanskrit": "हरितां यक्षराजाय ऐशान्यां सर्ववर्णिकाम् ।\nश्वेतरक्तकचूर्णेन पद्ममालेखयेत्ततः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002472022, "chapter_id": 22472, "verse_number": "१-१३४-२३", "content_sanskrit": "वैद्या वेदीति मन्त्रेण वेद्या आलभनं भवेत् ।\nपूर्वाग्रानुत्तराग्रांश्च कुशानास्तीर्य यत्नतः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002472023, "chapter_id": 22472, "verse_number": "१-१३४-२४", "content_sanskrit": "योगेयोगेति मन्त्रेण कुशश्चास्तरणं भवेत् ।\nशय्या तत्रैव कर्तव्या दिव्यास्तरणसंयुता ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002472024, "chapter_id": 22472, "verse_number": "१-१३४-२५", "content_sanskrit": "गडुके द्वे विचित्रे तु तन्मध्ये स्थापयेद्बुधः ।\nविचित्रदीपमालाभिर्भक्ष्यभोज्यान्नपानकैः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002472025, "chapter_id": 22472, "verse_number": "१-१३४-२६", "content_sanskrit": "पूपकान्सुविचित्रान्वै मोदकांश्च प्रदापयेत् ।\nपायसं कृशरं चैव दध्योदनसमन्वितम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002472026, "chapter_id": 22472, "verse_number": "१-१३४-२७", "content_sanskrit": "दधि चन्द्रसमप्रख्यं शुभच्छत्रं च विन्यसेत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]