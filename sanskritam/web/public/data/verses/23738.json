[{"id": 7003738000, "chapter_id": 23738, "verse_number": "२-१-२२-१", "content_sanskrit": "अथ दानार्हसत्पात्रनिर्णयः ।\nऋषय ऊचुः ।\nभगवन्सूत सर्वज्ञ वेदवेदान्तकोविद ।\nदानानि कस्मै देयानि दानकालश्च कीदृशः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003738001, "chapter_id": 23738, "verse_number": "२-१-२२-२", "content_sanskrit": "कश्च तत्प्रतिगृह्णीयात्सर्वं नो वक्तुमर्हसि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003738002, "chapter_id": 23738, "verse_number": "२-१-२२-३", "content_sanskrit": "श्रीसूत उवाच ।\nमहापुण्यप्रदे क्षेत्रे वेंकटाख्ये द्विजोत्तमाः ।\nसर्वेषामेव वर्णानां ब्राह्मणः परमो गुरुः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003738003, "chapter_id": 23738, "verse_number": "२-१-२२-४", "content_sanskrit": "तस्मै दानानि देयानि स तारयति पंडितः ।\nब्राह्मणः प्रतिगृह्णीयाद्वर्जयित्वा त्ववर्णकम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003738004, "chapter_id": 23738, "verse_number": "२-१-२२-५", "content_sanskrit": "षण्डस्य पुत्रहीनस्य दंभाचाररतस्य च ।\nवेदविद्वेषिणश्चैव द्विजविद्वेषिणस्तथा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003738005, "chapter_id": 23738, "verse_number": "२-१-२२-६", "content_sanskrit": "स्वकर्मत्यागिनश्चापि दत्तं भवति निष्फलम् ।\nपरदाररतस्यापि परद्रव्यरतस्य च ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003738006, "chapter_id": 23738, "verse_number": "२-१-२२-७", "content_sanskrit": "गायकस्यापि विप्रस्य दत्तं भवति निष्फलम् ।\nअसूयाविष्टमनसः कृतघ्नस्य च मायिनः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003738007, "chapter_id": 23738, "verse_number": "२-१-२२-८", "content_sanskrit": "ज्ञानशून्यस्य विप्रस्य दत्तं भवति निष्फलम् ।\nनित्यं याञ्चापरस्यापि हिंसकस्याबलस्य च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003738008, "chapter_id": 23738, "verse_number": "२-१-२२-९", "content_sanskrit": "नामविक्रयिणश्चैव वेदविक्रयिणस्तथा ।\nस्मृतिविक्रयिणश्चैव धर्मविक्रयिणस्तथा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003738009, "chapter_id": 23738, "verse_number": "२-१-२२-१०", "content_sanskrit": "परोपतापशीलस्य दत्तं भवति निष्फलम् ।\nये केचित्पापनिरता निन्दिताः सुकृतैस्तथा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003738010, "chapter_id": 23738, "verse_number": "२-१-२२-११", "content_sanskrit": "न तेभ्यः प्रतिगृह्णीयान्न देयं वापि किञ्चन ।\nसत्कर्मनिरतायैव श्रोत्रियायाहिताग्नये ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003738011, "chapter_id": 23738, "verse_number": "२-१-२२-१२", "content_sanskrit": "वृत्तिहीनाय वै देयं दरिद्राय कुटुम्बिने ।\nदेवपूजासु सक्ताय पुराणकथकाय च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003738012, "chapter_id": 23738, "verse_number": "२-१-२२-१३", "content_sanskrit": "देयं प्रयत्नतो विप्रा दरिद्रस्य विशेषतः ।\nबहुना किमिहोक्तेन शृणुध्वं द्विजसत्तमाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003738013, "chapter_id": 23738, "verse_number": "२-१-२२-१४", "content_sanskrit": "सर्वेषां ब्राह्मणानां च प्रदातुं शक्यते सदा ।\nवन्ध्याभर्त्रे प्रदत्तञ्चेद्रासभो जायते नरः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003738014, "chapter_id": 23738, "verse_number": "२-१-२२-१५", "content_sanskrit": "नास्तिकं भिन्नमर्यादं पुत्रहीनं जडं खलम् ।\nस्तेयिनं कितवं चैव कदाचिन्नाभिवादयेत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003738015, "chapter_id": 23738, "verse_number": "२-१-२२-१६", "content_sanskrit": "पाषण्डं पतितं व्रात्यं वेदविक्रयिणं तथा ।\nकृतघ्नं पापनिरतं कदाचिन्नाभिवादयेत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003738016, "chapter_id": 23738, "verse_number": "२-१-२२-१७", "content_sanskrit": "तथा स्नानं प्रकुर्वन्तं समित्पुष्पकरं तथा ।\nउदपात्रधरञ्चैव भुंजन्तं नाभिवादयेत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003738017, "chapter_id": 23738, "verse_number": "२-१-२२-१८", "content_sanskrit": "विवादशालिनं चण्डं वमन्तं जनमध्यगम् ।\nभिक्षान्नधारिणं चैव शयानं नाभिवादयेत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003738018, "chapter_id": 23738, "verse_number": "२-१-२२-१९", "content_sanskrit": "वन्ध्याञ्च पुष्पिणीं जारां सूतिकां गर्भपातिनीम् ।\nव्रतघ्नीञ्च तथा चण्डीं कदाचिन्नाभिवादयेत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003738019, "chapter_id": 23738, "verse_number": "२-१-२२-२०", "content_sanskrit": "सभायां यज्ञशालायां देवतायतनेष्वपि ।\nप्रत्येकं तु नमस्कारो हन्ति पुण्यं पुरातनम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003738020, "chapter_id": 23738, "verse_number": "२-१-२२-२१", "content_sanskrit": "श्राद्धव्रते नियुक्तञ्च देवताभ्यर्चकं तथा ।\nयज्ञं च तर्पणञ्चैव कुर्वन्तं नाभिवादयेत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003738021, "chapter_id": 23738, "verse_number": "२-१-२२-२२", "content_sanskrit": "कुर्वते वन्दनं यस्तु न कुर्यात्प्रतिवन्दनम् ।\nनाभिवाद्यः स विज्ञेयो यथा शूद्रस्तथैव च ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003738022, "chapter_id": 23738, "verse_number": "२-१-२२-२३", "content_sanskrit": "तस्मात्सर्वेपु कालेषु बुद्धिमान्ब्राह्मणोत्तमः ।\nवन्ध्यापतिं द्विजं क्रूरं कदाचिन्नाभिवादयेत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003738023, "chapter_id": 23738, "verse_number": "२-१-२२-२४", "content_sanskrit": "अथाकाशगंगामाहात्म्यम् ।\nश्रीसूत उवाच ।\nअत्रेतिहासं वक्ष्यामि पुण्यशीलस्य धीमतः ।\nसनत्कुमारमुनये नारदेन प्रभाषितम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003738024, "chapter_id": 23738, "verse_number": "२-१-२२-२५", "content_sanskrit": "तद्वक्ष्यामि मुनिश्रेष्ठाः शृणुध्वं सुसमाहिताः ।\nपुरा गोदावरीतीरे सर्वधर्मपरायणः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003738025, "chapter_id": 23738, "verse_number": "२-१-२२-२६", "content_sanskrit": "पुण्यशीलो द्विजवरः सत्यवादी जितेन्द्रियः ।\nदयावान्सर्वभूतेषु देवाग्निद्विजपूजकः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003738026, "chapter_id": 23738, "verse_number": "२-१-२२-२७", "content_sanskrit": "कर्मणा जन्मशुद्धश्च मातापितृहिते रतः ।\nगुरुभक्तिः सदाक्षिण्यो ब्रह्मण्यः साधुसंमतः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003738027, "chapter_id": 23738, "verse_number": "२-१-२२-२८", "content_sanskrit": "एतादृशगुणैर्युक्तः पुण्यशीलस्य धीमतः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003738028, "chapter_id": 23738, "verse_number": "२-१-२२-२९", "content_sanskrit": "अथ पुण्यशीलस्य वन्ध्यापतिनिमन्त्रणेन गर्दभमुखत्वप्राप्तिः ।\nगृहं सम्प्राप्तवान्विप्रो वेदवेदांगपारगः ।\nप्रार्थितः पुण्यशीलेन पितृश्राद्धेऽतिवेगतः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003738029, "chapter_id": 23738, "verse_number": "२-१-२२-३०", "content_sanskrit": "तं विप्रं श्रोत्रियं शान्तं पितृश्राद्धे नियोज्य वै ।\nश्राद्धं चकार धर्मात्मा प्रत्याब्दिकमनुत्तमम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003738030, "chapter_id": 23738, "verse_number": "२-१-२२-३१", "content_sanskrit": "ततः कालान्तरे तस्य पुण्यशीलस्य चानने ।\nवैरूप्यं प्राप्तमत्युग्रं रासभाननवत्तदा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003738031, "chapter_id": 23738, "verse_number": "२-१-२२-३२", "content_sanskrit": "ततः खिन्नमना भूत्वा पुण्यशीलोऽतिधार्मिकः ।\nनिःश्वस्य बहुधा खिन्नः प्रपेदेऽगस्त्ययोगिनः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003738032, "chapter_id": 23738, "verse_number": "२-१-२२-३३", "content_sanskrit": "सुवर्णमुखरीतीरे ऋषिसंघनिषेविते ।\nआश्रमं परमं दिव्यं सर्वकामफलप्रदम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003738033, "chapter_id": 23738, "verse_number": "२-१-२२-३४", "content_sanskrit": "तत्राश्रमे मुनिवरैः सेव्यमानमहर्निशम् ।\nदृष्ट्वागस्त्यं महात्मानं सर्वलोकहितैषिणम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003738034, "chapter_id": 23738, "verse_number": "२-१-२२-३५", "content_sanskrit": "प्रणाममकरोत्तस्मै गार्दभास्योऽतिदुःखितः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003738035, "chapter_id": 23738, "verse_number": "२-१-२२-३६", "content_sanskrit": "पुण्यशील उवाच ।\nतपोनिधे नमस्तुभ्यमगस्त्य मुनिसेवित ।\nकुत्सितास्यं महापापं रक्षरक्ष दयानिधे ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003738036, "chapter_id": 23738, "verse_number": "२-१-२२-३७", "content_sanskrit": "केन दोषेण मे चात्र मुखस्यासीत्कुरूपता ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003738037, "chapter_id": 23738, "verse_number": "२-१-२२-३८", "content_sanskrit": "मयि प्रीत्या महाभाग वदस्व मुनिसत्तम ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003738038, "chapter_id": 23738, "verse_number": "२-१-२२-३९", "content_sanskrit": "अगस्त्य उवाच ।\nविप्रवर्य महाभाग पुण्यशील महामते ।\nआननस्य विरूपं वै शृणु नान्यमना द्विज ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003738039, "chapter_id": 23738, "verse_number": "२-१-२२-४०", "content_sanskrit": "अथ वन्ध्यापतेः श्राद्धनिमन्त्रणानर्हत्वकथनम् ।\nकञ्चिद्विप्रं गुणनिधिं वेदवेदांगपारगम् ।\nश्रोत्रियं पुत्ररहितं श्राद्धे त्वं विनियुक्तवान् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003738040, "chapter_id": 23738, "verse_number": "२-१-२२-४१", "content_sanskrit": "तेन दोषेण महता मुखे तव विरूपता ।\nये लोके हव्यकव्यादौ वन्ध्यायाः स्वामिनं द्विजम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003738041, "chapter_id": 23738, "verse_number": "२-१-२२-४२", "content_sanskrit": "नियोजयन्ति ते यान्ति मुखे गर्दभरूपताम् ।\nशुभकर्मणि वा विप्र पैतृके वापि कर्मणि ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003738042, "chapter_id": 23738, "verse_number": "२-१-२२-४३", "content_sanskrit": "वन्ध्यापतिं महापापं कदाचिन्न निमन्त्रयेत् ।\nवन्ध्यापतिं महाक्रूरं वृषलीपतिमेव वा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003738043, "chapter_id": 23738, "verse_number": "२-१-२२-४४", "content_sanskrit": "श्रेयस्कामी हि विप्रेंद्र श्राद्धे तु न निमन्त्रयेत् ।\nवेदशास्त्रादियुक्तोऽपि कुलीनः कर्मठोऽपि वा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003738044, "chapter_id": 23738, "verse_number": "२-१-२२-४५", "content_sanskrit": "वन्ध्याभर्ता द्विजश्रेष्ठ श्राद्धे त्याज्यः कथञ्चन ।\nज्योतिष्टोमादियज्ञेषु व्रतेषु च तपःसु च ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003738045, "chapter_id": 23738, "verse_number": "२-१-२२-४६", "content_sanskrit": "समर्थोऽपि द्विजश्रेष्ठः श्राद्धे वन्ध्यापतिं त्यजेत् ।\nअलभ्ये तु द्विजे पात्रे तन्तुमात्रोपजीविनम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003738046, "chapter_id": 23738, "verse_number": "२-१-२२-४७", "content_sanskrit": "पुत्रवन्तं सदाचारं श्राद्धार्थं तु निमन्त्रयेत् ।\nतदभावे द्विजश्रेष्ठ पुत्रं वाऽनुजमेव वा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003738047, "chapter_id": 23738, "verse_number": "२-१-२२-४८", "content_sanskrit": "आत्मानं वा नियुञ्जीत श्राद्धे वन्ध्यापतिं त्यजेत् ।\nपुण्यशील महाभाग चोद्धृत्य भुजमुच्यते ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003738048, "chapter_id": 23738, "verse_number": "२-१-२२-४९", "content_sanskrit": "सर्वथा पुत्रहीनं तु श्राद्धार्थं न नियोजयेत् ।\nवन्ध्यापतिं द्विजं यस्तु श्राद्धकर्ता नियोक्ष्यति ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003738049, "chapter_id": 23738, "verse_number": "२-१-२२-५०", "content_sanskrit": "तच्छ्राद्धमासुरं ज्ञेयं कर्ता च नरकं व्रजेत् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003738050, "chapter_id": 23738, "verse_number": "२-१-२२-५१", "content_sanskrit": "अथाकाशगंगास्नानेन पुण्यशीलस्य तद्विकृतिनिवृत्तिः ।\nबहुनात्र किमुक्तेन तद्दोषविनिवृत्तये ।\nउपायं ते प्रवक्ष्यामि स्वर्णमुख्यास्तटे शुभे ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003738051, "chapter_id": 23738, "verse_number": "२-१-२२-५२", "content_sanskrit": "वर्तते देवसंघैश्च सेवितो वेंकटाचलः ।\nमेरुपुत्रो महापुण्यः सर्वकामफलप्रदः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003738052, "chapter_id": 23738, "verse_number": "२-१-२२-५३", "content_sanskrit": "तस्मिन्वेंकटशैलेन्द्रे सुरासुरनमस्कृते ।\nवियद्गंगेति नाम्ना वै तीर्थमस्ति महत्तरम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003738053, "chapter_id": 23738, "verse_number": "२-१-२२-५४", "content_sanskrit": "सर्वपापप्रशमनमायुरारोग्यवर्धनम् ।\nत्वं गत्वा वेंकटं शैलं स्वामिपुष्करिणीजले ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003738054, "chapter_id": 23738, "verse_number": "२-१-२२-५५", "content_sanskrit": "स्नात्वा संकल्पपूर्वं तु गंगातीर्थमनन्तरम् ।\nगत्वा तीर्थविधानेन स्नानं कुरु महामते ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003738055, "chapter_id": 23738, "verse_number": "२-१-२२-५६", "content_sanskrit": "स्नानमात्रात्ततः सद्यो मुखस्यास्य महामते ।\nवैरूप्यं तत्क्षणादेव नंक्ष्यत्येव न संशयः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003738056, "chapter_id": 23738, "verse_number": "२-१-२२-५७", "content_sanskrit": "एवमुक्तः पुण्यशीलो ह्यगस्त्येन महात्मना ।\nतं प्रणम्य महात्मानं वेंकटाद्रिं ततो ययौ ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003738057, "chapter_id": 23738, "verse_number": "२-१-२२-५८", "content_sanskrit": "तत्र गत्वा महाभागः स्वामिपुष्करिणीजले ।\nस्नात्वा नियमपूर्वं तु वियद्गंगासमीपगः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003738058, "chapter_id": 23738, "verse_number": "२-१-२२-५९", "content_sanskrit": "तत्र स्नानेन धर्मात्मा कामवक्रोपमं मुखम् ।\nप्राप्तवान्पुण्यशीलस्तु अहो तीर्थस्य वैभवम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003738059, "chapter_id": 23738, "verse_number": "२-१-२२-६०", "content_sanskrit": "श्रीसूत उवाच ।\nएवं वः कथितं विप्रा नारदेन प्रभाषितम् ।\nसनत्कुमारमुनये शौनकाद्या महौजसः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003738060, "chapter_id": 23738, "verse_number": "२-१-२२-६१", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां द्वितीये वैष्णवखण्डे श्रीवेंकटाचलमाहात्म्य आकाशगंगामाहात्म्यवर्णनंनाम द्वाविंशतितमोऽध्यायः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]