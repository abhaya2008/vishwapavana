[{"id": 7004528000, "chapter_id": 24528, "verse_number": "५-३-२२२-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nततः क्रोशान्तरे गच्छेत्तिलादं तीर्थमुत्तमम् ।\nतिलप्राशनकृद्यत्र जाबालिः शुद्धिमाप्तवान्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004528001, "chapter_id": 24528, "verse_number": "५-३-२२२-२", "content_sanskrit": "पितृमातृपरित्यागी भ्रातुर्भार्याभिलाषकृत् ।\nपुत्रविक्रयकृत्पापश्छलकृद्गुरुणा सह॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004528002, "chapter_id": 24528, "verse_number": "५-३-२२२-३", "content_sanskrit": "एवं दोषसमाविष्टो यत्र यत्रापि गच्छति ।\nतत्र तत्रापि धिक्कारं लभते सत्सु भारत ।\nन कोऽपि संगतिं धत्ते तेन सार्द्धं सभास्वपि॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004528003, "chapter_id": 24528, "verse_number": "५-३-२२२-४", "content_sanskrit": "इति लज्जान्वितो विप्रः काले न महता नृप ।\nचिन्तामवाप महतीमगतिज्ञो हि पावने॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004528004, "chapter_id": 24528, "verse_number": "५-३-२२२-५", "content_sanskrit": "चकार सर्वतीर्थानि रेवां चाप्यवगाहयत्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004528005, "chapter_id": 24528, "verse_number": "५-३-२२२-६", "content_sanskrit": "अणिवापान्तमासाद्य दक्षिणे नर्मदातटे ।\nतस्थौ यत्र व्रती पार्थ जाबालिः प्राशयंस्तिलान्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004528006, "chapter_id": 24528, "verse_number": "५-३-२२२-७", "content_sanskrit": "तिलैरेकाशनं कुर्वंस्तथैवैकान्तराशनम् ।\nत्र्यहषड्द्वादशाहाशी पक्षमासाशनस्तथा॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004528007, "chapter_id": 24528, "verse_number": "५-३-२२२-८", "content_sanskrit": "कृच्छ्रचान्द्रायणादीनि व्रतानि च तिलैरपि ।\nतिलादत्वमनुप्राप्तो ह्यब्दद्वासप्ततिं क्रमात्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004528008, "chapter_id": 24528, "verse_number": "५-३-२२२-९", "content_sanskrit": "कालेन गच्छता तस्य प्रसन्नोऽभवदीश्वरः ।\nप्रादादिहामुत्रिकीं तु शुद्धिं सालोक्यमात्मकम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004528009, "chapter_id": 24528, "verse_number": "५-३-२२२-१०", "content_sanskrit": "तेन स स्थापितो देवः स्वनाम्ना भरतर्षभ ।\nतिलादेश्वरसंज्ञां च प्राप लोकादपि प्रभुः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004528010, "chapter_id": 24528, "verse_number": "५-३-२२२-११", "content_sanskrit": "तदा प्रभृति विख्यातं तीर्थं पापप्रणाशनम् ।\nतत्र तीर्थे नरः स्नात्वा चतुर्दश्यष्टमीषु च॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004528011, "chapter_id": 24528, "verse_number": "५-३-२२२-१२", "content_sanskrit": "उपवासपरः पार्थ तथैव हरिवासरे ।\nतिलहोमी तिलोद्वर्ती तिलस्नायी तिलोदकी॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004528012, "chapter_id": 24528, "verse_number": "५-३-२२२-१३", "content_sanskrit": "तिलदाता च भोक्ता च नानापापैः प्रमुच्यते ।\nतिलैरापूरयेल्लिङ्गं तिलतैलेन दीपदः ।\nरुद्रलोकमवाप्नोति पुनात्या सप्तमं कुलम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004528013, "chapter_id": 24528, "verse_number": "५-३-२२२-१४", "content_sanskrit": "तिलपिण्डप्रदानेन श्राद्धे नृपतिसत्तम ।\nविकर्मस्थाश्च गच्छन्ति गतिमिष्टां हि पूर्वजाः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004528014, "chapter_id": 24528, "verse_number": "५-३-२२२-१५", "content_sanskrit": "स्वर्गलोकस्थिताः श्राद्धैर्ब्राह्मणानां च भोजनैः ।\nअक्षयां तृप्तिमासाद्य मोदन्ते शाश्वतीः समाः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004528015, "chapter_id": 24528, "verse_number": "५-३-२२२-१६", "content_sanskrit": "पितुः कुलं मातृकुलं तथा भार्याकुलं नृप ।\nकुलत्रयं समुद्धृत्य स्वर्गं नयति वै नरः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]