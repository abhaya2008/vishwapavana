[{"id": 2007569, "chapter_id": 1147, "verse_number": "१-१४८-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2007570, "chapter_id": 1147, "verse_number": "१-१४८-१", "content_sanskrit": "पाण्डवान्धार्तराष्ट्रांश्च कृतास्त्रान्प्रसमीक्ष्य सः।\nगुर्वर्थं दक्षिणां काले प्राप्तेऽमन्यत वै गुरुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2007571, "chapter_id": 1147, "verse_number": "१-१४८-२", "content_sanskrit": "अस्त्रशिक्षामनुज्ञातान्रङ्गद्वारमुपागतान्।\nभारद्वाजस्ततस्तांस्तु सर्वानेवाभ्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2007572, "chapter_id": 1147, "verse_number": "१-१४८-३", "content_sanskrit": "इच्छामि दत्तां सहितां मह्यं परमदक्षिणाम्।\nएवमुक्तास्ततः सर्वे शिष्या द्रोणमथाब्रुवन्।\nभगवन्किं प्रयच्छाम आज्ञापयतु नो गुरुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2007573, "chapter_id": 1147, "verse_number": "१-१४८-४", "content_sanskrit": "ततः शिष्यान्समाहूय आचार्योऽर्थमचोदयत्।\nद्रोणः सर्वानशेषेण दक्षिणार्थं महीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2007574, "chapter_id": 1147, "verse_number": "१-१४८-५", "content_sanskrit": "पञ्चालराजं द्रुपदं गृहित्वा रणमूर्धनि।\nपर्यानयत भद्रं वः सा स्यात्परमदक्षिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2007575, "chapter_id": 1147, "verse_number": "१-१४८-६", "content_sanskrit": "तथेत्युक्त्वा तु ते सर्वे रथैस्तूर्णं प्रहारिणः।\nआचार्यधनदानार्थं द्रोणेन सहिता ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2007576, "chapter_id": 1147, "verse_number": "१-१४८-७", "content_sanskrit": "ततोऽभिजग्मुः पञ्चालान्निघ्नन्तस्ते नरर्षभाः।\nममृदुस्तस्य नगरं द्रुपदस्य महौजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2007577, "chapter_id": 1147, "verse_number": "१-१४८-८", "content_sanskrit": "दुर्योधनश्च कर्णश्च युयुत्सुश्च महाबलः।\nदुःशासनो विकर्णश्च जलसन्धः सुलोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2007578, "chapter_id": 1147, "verse_number": "१-१४८-९", "content_sanskrit": "एते चान्ये च बहवः कुमारा बहुविक्रमाः।\nअहं पूर्वमहं पूर्वमित्येवं क्षत्रियर्षभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2007579, "chapter_id": 1147, "verse_number": "१-१४८-१०", "content_sanskrit": "ततो वरराथारूढाः कुमाराः सादिभिः सह।\nप्रविश्य नगरं सर्वे राजमार्गमुपाययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2007580, "chapter_id": 1147, "verse_number": "१-१४८-११", "content_sanskrit": "तस्मिन्काले तु पाञ्चालः श्रुत्वा दृष्ट्वा महद्बलम्।\nभ्रातृभिः सहितो राजंस्त्वरया निर्ययौ गृहात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2007581, "chapter_id": 1147, "verse_number": "१-१४८-१२", "content_sanskrit": "ततस्तु कृतसन्नाहा यज्ञसेनसहोदराः।\nशरवर्षाणि मुञ्चन्तः प्रणेदुः सर्व एव ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2007582, "chapter_id": 1147, "verse_number": "१-१४८-१३", "content_sanskrit": "ततो रथेन शुभ्रेण समासाद्य तु कौरवान्।\nयज्ञसेनः शरान्घोरान्ववर्ष युधि दुर्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2007583, "chapter_id": 1147, "verse_number": "१-१४८-१४", "content_sanskrit": "पूर्वमेव तु संमन्त्र्य पार्थो द्रोणमथाऽब्रवीत्।\nदर्पोद्रेकात्कुमाराणामाचार्यं द्विजसत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2007584, "chapter_id": 1147, "verse_number": "१-१४८-१५", "content_sanskrit": "एषां पराक्रमस्यान्ते वयं कुर्याम साहसम्।\nएतैरशक्यः पाञ्चालो ग्रहीतुं रणमूर्धनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2007585, "chapter_id": 1147, "verse_number": "१-१४८-१६", "content_sanskrit": "एवमुक्त्वा तु कौन्तेयो भ्रातृभिः सहितोऽनघः।\nअर्धक्रोशे तु नगरादतिष्ठद्बहिरेव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2007586, "chapter_id": 1147, "verse_number": "१-१४८-१७", "content_sanskrit": "द्रुपदः कौरवान्दृष्ट्वा प्राधावत समन्ततः।\nशरजालेन महता मोहयन्कौरवीं चमूम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2007587, "chapter_id": 1147, "verse_number": "१-१४८-१८", "content_sanskrit": "तमुद्यतं रथेनैकमाशुकारिणमाहवे।\nअनेकमिव सन्त्रासान्मेनिरे तत्र कौरवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2007588, "chapter_id": 1147, "verse_number": "१-१४८-१९", "content_sanskrit": "द्रुपदस्य शरा घोरा विचेरुः सर्वतोदिशम्।\nततः शङ्खाश्च भेर्यश्च मृदङ्गाश्च सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2007589, "chapter_id": 1147, "verse_number": "१-१४८-२०", "content_sanskrit": "प्रावाद्यन्त महाराज पञ्चालानां निवेशने।\nसिंहनादश्च संजज्ञे पञ्चालानां महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2007590, "chapter_id": 1147, "verse_number": "१-१४८-२१", "content_sanskrit": "धनुर्ज्यातलशब्दश्च संस्पृश्य गगनं महान्।\nदुर्योधनो विकर्णश्च सुबाहुर्दीर्घलोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2007591, "chapter_id": 1147, "verse_number": "१-१४८-२२", "content_sanskrit": "दुःशाशनश्च संक्रुद्धः शरवर्षैरवाकिरन्।\nसोऽतिविद्धो महेष्वासः पार्षतो युधि दुर्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2007592, "chapter_id": 1147, "verse_number": "१-१४८-२३", "content_sanskrit": "व्यधमत्तान्यनीकानि तत्क्षणादेव भारत।\nदुर्योधनं विकर्णं च कर्णं चापि महाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2007593, "chapter_id": 1147, "verse_number": "१-१४८-२४", "content_sanskrit": "नानानृपसुतान्वीरान्सैन्यानि विविधानि च।\nअलातचक्रवत्सर्वं चरन्बाणैरतर्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2007594, "chapter_id": 1147, "verse_number": "१-१४८-२५", "content_sanskrit": "ततस्तु नागराः सर्वे मुसलैर्यष्टिभिस्तदा।\nअभ्यवर्षन्त कौरव्यान्वर्षमाणा घा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2007595, "chapter_id": 1147, "verse_number": "१-१४८-२६", "content_sanskrit": "सबालवृद्धाः काम्पिल्याः कौरवानभ्ययुस्तदा।\nश्रुत्वा सुतुमुलं युद्धं कौरवानेव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2007596, "chapter_id": 1147, "verse_number": "१-१४८-२७", "content_sanskrit": "द्रवन्तिस्म नदन्तिस्म क्रोशन्तः पाण्डवान्प्रति।\nपाडवास्तु स्वनं श्रुत्वा आर्तानां रोमहर्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2007597, "chapter_id": 1147, "verse_number": "१-१४८-२८", "content_sanskrit": "अभिवाद्य ततो द्रोणं रथानारुरुहुस्तदा।\nयुधिष्ठिरं निवार्याशु मा युध्यस्वेति पाण्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2007598, "chapter_id": 1147, "verse_number": "१-१४८-२९", "content_sanskrit": "माद्रेयौ चक्ररक्षौ तु फाल्गुनश्च तदाऽकरोत्।\nसेनाग्रगो भीमसेनस्तदाभूद्गदया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2007599, "chapter_id": 1147, "verse_number": "१-१४८-३०", "content_sanskrit": "तदा शत्रुस्वनं श्रुत्वा भ्रातृभिः सहितोऽनघः।\nआयाज्जवेन कौन्तेयो रथेनानादयन्दिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2007600, "chapter_id": 1147, "verse_number": "१-१४८-३१", "content_sanskrit": "पञ्चालानां ततः सेनामुद्धूतार्णवनिःस्वनाम्।\nभीमसेनो महाबाहुर्दण्डपाणिरिवान्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2007601, "chapter_id": 1147, "verse_number": "१-१४८-३२", "content_sanskrit": "प्रविवेश महासेनां मकरः सागरं यथा।\nचतुरङ्गबलाकीर्णे ततस्तस्मिन्रणोत्सवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2007602, "chapter_id": 1147, "verse_number": "१-१४८-३३", "content_sanskrit": "स्वयमभ्यद्रवद्भीमो नागानीकं गदाधरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2007603, "chapter_id": 1147, "verse_number": "१-१४८-३४", "content_sanskrit": "स युद्धकुशलः पार्थो बाहुवीर्येण चातुलः।\nअहनत्कुञ्जरानीकं गदया कालरूपधृक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2007604, "chapter_id": 1147, "verse_number": "१-१४८-३५", "content_sanskrit": "ते गजा गिरिसङ्काशाः क्षरन्तो रुधिरं बहु।\nभीमसेनस्य गदया भिन्नमस्तकपिण्डकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2007605, "chapter_id": 1147, "verse_number": "१-१४८-३६", "content_sanskrit": "पतन्ति द्विरदा भूमौ वज्रघातादिवाचलाः।\nगजानश्वान्रथांश्चैव पातयामास पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2007606, "chapter_id": 1147, "verse_number": "१-१४८-३७", "content_sanskrit": "पदातींश्च रथांश्चैव न्यवधीदर्जुनाग्रजः।\nगोपाल इव दण्डेन यथा पशुगणान्वने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2007607, "chapter_id": 1147, "verse_number": "१-१४८-३८", "content_sanskrit": "चालयन्रथनागांश्च संचचाल वृकोदरः।\nभारद्वाजप्रियं कर्तुमुद्यतः फाल्गुनस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2007608, "chapter_id": 1147, "verse_number": "१-१४८-३९", "content_sanskrit": "पार्षतं शरजालेन क्षिपन्नागात्स पाण्डवः।\nहयौघांश्च रथौघांश्च गजौघांश्च समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2007609, "chapter_id": 1147, "verse_number": "१-१४८-४०", "content_sanskrit": "पातयन्समरे राजन्युगान्ताग्रिरिव ज्वलन्।\nततस्ते हन्यमाना वै पञ्चालाः सृञ्जयास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2007610, "chapter_id": 1147, "verse_number": "१-१४८-४१", "content_sanskrit": "शरैर्नानाविधैस्तूर्णं पार्थं संछाद्य सर्वशः।\nसिंहनादं मुखैः कृत्वा समयुध्वन्त पाण्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2007611, "chapter_id": 1147, "verse_number": "१-१४८-४२", "content_sanskrit": "तद्युद्धमभवद्धोरं समुहाद्भुतदर्शनम्।\nसिंहनादस्वनं श्रुत्वा नामृष्यत्पाकशासनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2007612, "chapter_id": 1147, "verse_number": "१-१४८-४३", "content_sanskrit": "ततः किरीटी सहसा पञ्चालान्समरेऽद्रवत्।\nछादयन्निषुजालेन महता मोहयन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2007613, "chapter_id": 1147, "verse_number": "१-१४८-४४", "content_sanskrit": "शीघ्रमभ्यस्यतो बाणान्संदधानस्य चानिशम्।\nनान्तरं ददृशे किंचित्कौन्तेयस्य यशस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2007614, "chapter_id": 1147, "verse_number": "१-१४८-४५", "content_sanskrit": "न दिशो नान्तरिक्षं च तदा नैव च मेदिनी।\nअदृश्यत महाराज तत्र किंचिन्न सङ्गरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2007615, "chapter_id": 1147, "verse_number": "१-१४८-४६", "content_sanskrit": "पाञ्चालानां कुरूणां च साधुसाध्विति निस्वनः।\nतत्र तूर्यनिनादश्च शङ्खानां च महास्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2007616, "chapter_id": 1147, "verse_number": "१-१४८-४७", "content_sanskrit": "सिंहनादश्च संजज्ञे साधुशब्देन मिश्रितः।\nततः पाञ्चालराजस्तु तथा सत्यजिता सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2007617, "chapter_id": 1147, "verse_number": "१-१४८-४८", "content_sanskrit": "त्वरमाणोऽभिदुद्राव महेन्द्रं शम्बरो यथा।\nमहता शरवर्षेण पार्थः पाञ्चालमावृणोत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2007618, "chapter_id": 1147, "verse_number": "१-१४८-४९", "content_sanskrit": "ततो हलहलाशब्द आसीत्पाञ्चालके बले।\nजिवृक्षति महासिंहे गजानामिव यूथपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2007619, "chapter_id": 1147, "verse_number": "१-१४८-५०", "content_sanskrit": "दृष्ट्वा पार्थं तदायान्तं सत्यजित्सत्यविक्रमः।\nपाञ्चालं वै परिप्रेप्सुर्धनञ्जयमदुद्रुवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2007620, "chapter_id": 1147, "verse_number": "१-१४८-५१", "content_sanskrit": "ततस्त्वर्जुनपाञ्चालौ युद्धाय समुपागतौ।\nव्यक्षोभयेतां तौ सैन्यमिन्द्रवैरोचनाविव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2007621, "chapter_id": 1147, "verse_number": "१-१४८-५२", "content_sanskrit": "ततः सत्यजितं पार्थो दशभिर्मर्मभेदिभिः।\nविव्याध बवलद्गाढं तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2007622, "chapter_id": 1147, "verse_number": "१-१४८-५३", "content_sanskrit": "ततः शरशतैः पार्थं पाञ्चालः शीघ्रमार्दयत्।\nपार्थस्तु शरवर्षेण च्छाद्यमानो महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2007623, "chapter_id": 1147, "verse_number": "१-१४८-५४", "content_sanskrit": "वेगं चक्रे महावेगो धनुर्ज्यामवमृज्य च।\nततः सत्यजितश्चापं छित्वा राजानमभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2007624, "chapter_id": 1147, "verse_number": "१-१४८-५५", "content_sanskrit": "अथान्यद्धनुरादाय सत्यजिद्वेगवत्तरम्।\nसाश्वं ससूतं सरथं पार्थं विव्याध सत्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2007625, "chapter_id": 1147, "verse_number": "१-१४८-५६", "content_sanskrit": "स तं न ममृषे पार्थः पाञ्चालेनार्दितो युधि।\nततस्तस्य विनाशार्थं सत्वरं व्यसृजच्छरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2007626, "chapter_id": 1147, "verse_number": "१-१४८-५७", "content_sanskrit": "हयान्ध्वजं धनुर्मुष्टिमुभौ तौ पार्ष्णिसारथी।\nस तथा भिद्यमानेषु कार्मुकेषु पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2007627, "chapter_id": 1147, "verse_number": "१-१४८-५८", "content_sanskrit": "हयेषु विनिकृत्तेषु विमुखोऽभवदाहवे।\nस सत्यजितमालेक्य तथा विमुखमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2007628, "chapter_id": 1147, "verse_number": "१-१४८-५९", "content_sanskrit": "वेगेन महता राजन्नभ्यधावत पार्षतम्।\nतदा चक्रे महद्युद्धमर्जुनो जयतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2007629, "chapter_id": 1147, "verse_number": "१-१४८-६०", "content_sanskrit": "तस्य पार्थो धनुश्छित्त्वा ध्वजं चोर्व्यामपातयत्।\nपञ्चभिस्तस्य विव्याध हयान्सूतं च सायकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2007630, "chapter_id": 1147, "verse_number": "१-१४८-६१", "content_sanskrit": "तत उत्सृज्य तच्चापमाददानः शरावरम्।\nखड्गमुद्धृत्य कौन्तेयः सिंहनादमथाकरोत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2007631, "chapter_id": 1147, "verse_number": "१-१४८-६२", "content_sanskrit": "पाञ्चालस्य रथस्येषामाप्लुत्य सहसाऽपतत्।\nपाञ्चालरथमास्थाय अवित्रस्तो धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2007632, "chapter_id": 1147, "verse_number": "१-१४८-६३", "content_sanskrit": "विक्षोभ्याम्भोनिधिंतार्क्ष्यस्तंनागमिव सोऽग्रहीत्।\nततस्तु सर्वपाञ्चाला विद्रवन्ति दिशो दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2007633, "chapter_id": 1147, "verse_number": "१-१४८-६४", "content_sanskrit": "दर्शयन्सर्वसैन्यानां स बाह्वोर्बलमात्मनः।\nसिंहनादस्वनं कृत्वा निर्जगाम धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2007634, "chapter_id": 1147, "verse_number": "१-१४८-६५", "content_sanskrit": "आयान्तमर्जुनं दृष्ट्वा कुमाराः सहितास्तदा।\nममृदुस्तस्य नगरं द्रुपदस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2007635, "chapter_id": 1147, "verse_number": "१-१४८-६६x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2007636, "chapter_id": 1147, "verse_number": "१-१४८-६६", "content_sanskrit": "संबन्धी कुरुवीराणां द्रुपदो राजसत्तमः।\nमा वधीस्तद्बलं भीम गुरुदानं प्रदीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2007637, "chapter_id": 1147, "verse_number": "१-१४८-६७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2007638, "chapter_id": 1147, "verse_number": "१-१४८-६७", "content_sanskrit": "भीमसेनस्तदा राजन्नर्जुनेन निवारितः।\nअतृप्तो युद्धधर्मेषु न्यवर्तत महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2007639, "chapter_id": 1147, "verse_number": "१-१४८-६८", "content_sanskrit": "ते यज्ञसेनं द्रुपदं गृहीत्वा रणमूर्धनि।\nउपाजग्मुः सहामात्यं द्रोणाय भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2007640, "chapter_id": 1147, "verse_number": "१-१४८-६९", "content_sanskrit": "भग्नदर्पं हृतधनं तं तथा वशमागतम्।\nस वैरं मनसा ध्यात्वा द्रोणो द्रुपदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2007641, "chapter_id": 1147, "verse_number": "१-१४८-७०", "content_sanskrit": "विमृज्य तरसा राष्ट्रं पुरं ते मृदितं मया।\nप्राप्य जीवन्रिपुवशं सखिपूर्वं किमिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2007642, "chapter_id": 1147, "verse_number": "१-१४८-७१", "content_sanskrit": "एवमुक्त्वा प्रहस्यैनं किंचित्स पुनरब्रवीत्।\nमा भैः प्राणभयाद्वीर क्षमिणो ब्राह्मणा वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2007643, "chapter_id": 1147, "verse_number": "१-१४८-७२", "content_sanskrit": "आश्रमे क्रीडितं यत्तु त्वया बाल्ये मया सह।\nतेन संवर्धितः स्नेहः प्रीतिश्च क्षत्रियर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2007644, "chapter_id": 1147, "verse_number": "१-१४८-७३", "content_sanskrit": "प्रार्थयेयं त्वया सख्यं पुनरेव जनाधिप।\nवरं ददामि ते राजन्राज्यस्यार्धमवाप्नुहि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2007645, "chapter_id": 1147, "verse_number": "१-१४८-७४", "content_sanskrit": "अराजा किल नो राज्ञः सखा भवितुमर्हति।\nअतः प्रयतितं राज्ये यज्ञसेन मया तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2007646, "chapter_id": 1147, "verse_number": "१-१४८-७५", "content_sanskrit": "राजासि दक्षिणे कूले भागीरथ्याहमुत्तरे।\nसखायं मां विजानीहि पाञ्चाल यदि मन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2007647, "chapter_id": 1147, "verse_number": "१-१४८-७६x", "content_sanskrit": "द्रुपद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2007648, "chapter_id": 1147, "verse_number": "१-१४८-७६", "content_sanskrit": "अनाश्चर्यमिदं ब्रह्मन्विक्रान्तेषु महात्मसु।\nप्रीये त्वयाऽहं त्वत्तश्च प्रीतिमिच्छामि शाश्वतीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2007649, "chapter_id": 1147, "verse_number": "१-१४८-७७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2007650, "chapter_id": 1147, "verse_number": "१-१४८-७७", "content_sanskrit": "एवमुक्तः स तं द्रोणो मोक्षयामास भारत।\nसत्कृत्य चैनं प्रीतात्मा राज्यार्धं प्रत्यपादयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2007651, "chapter_id": 1147, "verse_number": "१-१४८-७८", "content_sanskrit": "माकन्दीमथ गङ्गायास्तीरे जनपदायुताम्।\nसोऽध्यावसद्दीनमनाः काम्पिल्यं च पुरोत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2007652, "chapter_id": 1147, "verse_number": "१-१४८-७९", "content_sanskrit": "दक्षिणांश्चापि पञ्चालान्यावच्चर्मण्वती नदी।\nद्रोणेन चैवं द्रुपदः परिभूयाथ पालितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2007653, "chapter_id": 1147, "verse_number": "१-१४८-८०", "content_sanskrit": "क्षात्रेण च बलेनास्य नापश्यत्स पराजयम्।\nहीनं विदित्वा चात्मानं ब्राह्मेण स बलेनतु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2007654, "chapter_id": 1147, "verse_number": "१-१४८-८१", "content_sanskrit": "पुत्रजन्म परीप्सन्वै पृथिवीमन्वसंचरत्।\nअहिच्छत्रं च विषयं द्रोणः समभिपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2007655, "chapter_id": 1147, "verse_number": "१-१४८-८२", "content_sanskrit": "एवं राजन्नहिच्छत्रा पुरीजनपदायुता।\nयुधि निर्जित्य पार्थेन द्रोणाय प्रतिपादिता॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2007656, "chapter_id": 1147, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि अष्टचत्वारिंशदधिकशततमोऽध्यायः॥ १४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}]