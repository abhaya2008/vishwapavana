[{"id": 5000247000, "chapter_id": 9247, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे एकपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000247001, "chapter_id": 9247, "verse_number": "३-५१-१", "content_sanskrit": "इत्युक्तः क्रोधताम्राक्षस्तप्तकाञ्चनकुण्डलः।\nराक्षसेन्द्रोऽभिदुद्राव पतगेन्द्रममर्षणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000247002, "chapter_id": 9247, "verse_number": "३-५१-२", "content_sanskrit": "स सम्प्रहारस्तुमुलस्तयोस्तस्मिन् महामृधे।\nबभूव वातोद‍्धुतयोर्मेघयोर्गगने यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000247003, "chapter_id": 9247, "verse_number": "३-५१-३", "content_sanskrit": "तद् बभूवाद्भुतं युद्धं गृध्रराक्षसयोस्तदा।\nसपक्षयोर्माल्यवतोर्महापर्वतयोरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000247004, "chapter_id": 9247, "verse_number": "३-५१-४", "content_sanskrit": "ततो नालीकनाराचैस्तीक्ष्णाग्रैश्च विकर्णिभिः।\nअभ्यवर्षन्महाघोरैर्गृध्रराजं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000247005, "chapter_id": 9247, "verse_number": "३-५१-५", "content_sanskrit": "स तानि शरजालानि गृध्रः पत्ररथेश्वरः।\nजटायुः प्रतिजग्राह रावणास्त्राणि संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000247006, "chapter_id": 9247, "verse_number": "३-५१-६", "content_sanskrit": "तस्य तीक्ष्णनखाभ्यां तु चरणाभ्यां महाबलः।\nचकार बहुधा गात्रे व्रणान् पतगसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000247007, "chapter_id": 9247, "verse_number": "३-५१-७", "content_sanskrit": "अथ क्रोधाद् दशग्रीवो जग्राह दश मार्गणान्।\nमृत्युदण्डनिभान् घोरान् शत्रोर्निधनकांक्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000247008, "chapter_id": 9247, "verse_number": "३-५१-८", "content_sanskrit": "स तैर्बाणैर्महावीर्यः पूर्णमुक्तैरजिह्मगैः।\nबिभेद निशितैस्तीक्ष्णैर्गृध्रं घोरैः शिलीमुखैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000247009, "chapter_id": 9247, "verse_number": "३-५१-९", "content_sanskrit": "स राक्षसरथे पश्यञ्जानकीं बाष्पलोचनाम्।\nअचिन्तयित्वा बाणांस्तान् राक्षसं समभिद्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000247010, "chapter_id": 9247, "verse_number": "३-५१-१०", "content_sanskrit": "ततोऽस्य सशरं चापं मुक्तामणिविभूषितम्।\nचरणाभ्यां महातेजा बभञ्ज पतगोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000247011, "chapter_id": 9247, "verse_number": "३-५१-११", "content_sanskrit": "ततोऽन्यद् धनुरादाय रावणः क्रोधमूर्च्छितः।\nववर्ष शरवर्षाणि शतशोऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000247012, "chapter_id": 9247, "verse_number": "३-५१-१२", "content_sanskrit": "शरैरावारितस्तस्य संयुगे पतगेश्वरः।\nकुलायमभिसम्प्राप्तः पक्षिवच्च बभौ तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000247013, "chapter_id": 9247, "verse_number": "३-५१-१३", "content_sanskrit": "स तानि शरजालानि पक्षाभ्यां तु विधूय ह।\nचरणाभ्यां महातेजा बभञ्जास्य महद् धनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000247014, "chapter_id": 9247, "verse_number": "३-५१-१४", "content_sanskrit": "तच्चाग्निसदृशं दीप्तं रावणस्य शरावरम्।\nपक्षाभ्यां च महातेजा व्यधुनोत् पतगेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000247015, "chapter_id": 9247, "verse_number": "३-५१-१५", "content_sanskrit": "काञ्चनोरश्छदान् दिव्यान् पिशाचवदनान् खरान्।\nतांश्चास्य जवसम्पन्नाञ्जघान समरे बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000247016, "chapter_id": 9247, "verse_number": "३-५१-१६", "content_sanskrit": "अथ त्रिवेणुसम्पन्नं कामगं पावकार्चिषम्।\nमणिसोपानचित्राङ्गं बभञ्ज च महारथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000247017, "chapter_id": 9247, "verse_number": "३-५१-१७", "content_sanskrit": "पूर्णचन्द्रप्रतीकाशं छत्रं च व्यजनैः सह।\nपातयामास वेगेन ग्राहिभी राक्षसैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000247018, "chapter_id": 9247, "verse_number": "३-५१-१८", "content_sanskrit": "सारथेश्चास्य वेगेन तुण्डेन च महच्छिरः।\nपुनर्व्यपहनच्छ्रीमान् पक्षिराजो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000247019, "chapter_id": 9247, "verse_number": "३-५१-१९", "content_sanskrit": "स भग्नधन्वा विरथो हताश्वो हतसारथिः।\nअङ्केनादाय वैदेहीं पपात भुवि रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000247020, "chapter_id": 9247, "verse_number": "३-५१-२०", "content_sanskrit": "दृष्ट्वा निपतितं भूमौ रावणं भग्नवाहनम्।\nसाधु साध्विति भूतानि गृध्रराजमपूजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000247021, "chapter_id": 9247, "verse_number": "३-५१-२१", "content_sanskrit": "परिश्रान्तं तु तं दृष्ट्वा जरया पक्षियूथपम्।\nउत्पपात पुनर्हृष्टो मैथिलीं गृह्य रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000247022, "chapter_id": 9247, "verse_number": "३-५१-२२", "content_sanskrit": "तं प्रहृष्टं निधायाङ्के रावणं जनकात्मजाम्।\nगच्छन्तं खड्गशेषं च प्रणष्टहतसाधनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000247023, "chapter_id": 9247, "verse_number": "३-५१-२३", "content_sanskrit": "गृध्रराजः समुत्पत्य रावणं समभिद्रवत्।\nसमावार्य महातेजा जटायुरिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000247024, "chapter_id": 9247, "verse_number": "३-५१-२४", "content_sanskrit": "वज्रसंस्पर्शबाणस्य भार्यां रामस्य रावण।\nअल्पबुद्धे हरस्येनां वधाय खलु रक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000247025, "chapter_id": 9247, "verse_number": "३-५१-२५", "content_sanskrit": "समित्रबन्धुः सामात्यः सबलः सपरिच्छदः।\nविषपानं पिबस्येतत् पिपासित इवोदकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000247026, "chapter_id": 9247, "verse_number": "३-५१-२६", "content_sanskrit": "अनुबन्धमजानन्तः कर्मणामविचक्षणाः।\nशीघ्रमेव विनश्यन्ति यथा त्वं विनशिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000247027, "chapter_id": 9247, "verse_number": "३-५१-२७", "content_sanskrit": "बद्धस्त्वं कालपाशेन क्व गतस्तस्य मोक्ष्यसे।\nवधाय बडिशं गृह्य सामिषं जलजो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000247028, "chapter_id": 9247, "verse_number": "३-५१-२८", "content_sanskrit": "नहि जातु दुराधर्षौ काकुत्स्थौ तव रावण।\nधर्षणं चाश्रमस्यास्य क्षमिष्येते तु राघवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000247029, "chapter_id": 9247, "verse_number": "३-५१-२९", "content_sanskrit": "यथा त्वया कृतं कर्म भीरुणा लोकगर्हितम्।\nतस्कराचरितो मार्गो नैष वीरनिषेवितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000247030, "chapter_id": 9247, "verse_number": "३-५१-३०", "content_sanskrit": "युद‍्ध्यस्व यदि शूरोऽसि मुहूर्तं तिष्ठ रावण।\nशयिष्यसे हतो भूमौ यथा भ्राता खरस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000247031, "chapter_id": 9247, "verse_number": "३-५१-३१", "content_sanskrit": "परेतकाले पुरुषो यत् कर्म प्रतिपद्यते।\nविनाशायात्मनोऽधर्म्यं प्रतिपन्नोऽसि कर्म तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000247032, "chapter_id": 9247, "verse_number": "३-५१-३२", "content_sanskrit": "पापानुबन्धो वै यस्य कर्मणः को नु तत् पुमान्।\nकुर्वीत लोकाधिपतिः स्वयंभूर्भगवानपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000247033, "chapter_id": 9247, "verse_number": "३-५१-३३", "content_sanskrit": "एवमुक्त्वा शुभं वाक्यं जटायुस्तस्य रक्षसः।\nनिपपात भृशं पृष्ठे दशग्रीवस्य वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000247034, "chapter_id": 9247, "verse_number": "३-५१-३४", "content_sanskrit": "तं गृहीत्वा नखैस्तीक्ष्णैर्विददार समन्ततः।\nअधिरूढो गजारोहो यथा स्याद् दुष्टवारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000247035, "chapter_id": 9247, "verse_number": "३-५१-३५", "content_sanskrit": "विददार नखैरस्य तुण्डं पृष्ठे समर्पयन्।\nकेशांश्चोत्पाटयामास नखपक्षमुखायुधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000247036, "chapter_id": 9247, "verse_number": "३-५१-३६", "content_sanskrit": "स तथा गृध्रराजेन क्लिश्यमानो मुहुर्मुहुः।\nअमर्षस्फुरितोष्ठः सन् प्राकम्पत च राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000247037, "chapter_id": 9247, "verse_number": "३-५१-३७", "content_sanskrit": "सम्परिष्वज्य वैदेहीं वामेनाङ्केन रावणः।\nतलेनाभिजघानार्तो जटायुं क्रोधमूर्च्छितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000247038, "chapter_id": 9247, "verse_number": "३-५१-३८", "content_sanskrit": "जटायुस्तमतिक्रम्य तुण्डेनास्य खगाधिपः।\nवामबाहून् दश तदा व्यपाहरदरिंदमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000247039, "chapter_id": 9247, "verse_number": "३-५१-३९", "content_sanskrit": "संछिन्नबाहोः सद्यो वै बाहवः सहसाभवन्।\nविषज्वालावलीयुक्ता वल्मीकादिव पन्नगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000247040, "chapter_id": 9247, "verse_number": "३-५१-४०", "content_sanskrit": "ततः क्रोधाद् दशग्रीवः सीतामुत्सृज्य वीर्यवान्।\nमुष्टिभ्यां चरणाभ्यां च गृध्रराजमपोथयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000247041, "chapter_id": 9247, "verse_number": "३-५१-४१", "content_sanskrit": "ततो मुहूर्तं संग्रामो बभूवातुलवीर्ययोः।\nराक्षसानां च मुख्यस्य पक्षिणां प्रवरस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000247042, "chapter_id": 9247, "verse_number": "३-५१-४२", "content_sanskrit": "तस्य व्यायच्छमानस्य रामस्यार्थे स रावणः।\nपक्षौ पादौ च पार्श्वौ च खड्गमुद्‍धृत्य सोऽच्छिनत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000247043, "chapter_id": 9247, "verse_number": "३-५१-४३", "content_sanskrit": "स च्छिन्नपक्षः सहसा रक्षसा रौद्रकर्मणा।\nनिपपात महागृध्रो धरण्यामल्पजीवितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000247044, "chapter_id": 9247, "verse_number": "३-५१-४४", "content_sanskrit": "तं दृष्ट्वा पतितं भूमौ क्षतजार्द्रं जटायुषम्।\nअभ्यधावत वैदेही स्वबन्धुमिव दुःखिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000247045, "chapter_id": 9247, "verse_number": "३-५१-४५", "content_sanskrit": "तं नीलजीमूतनिकाशकल्पं\nसपाण्डुरोरस्कमुदारवीर्यम्।\nददर्श लङ्काधिपतिः पृथिव्यां\nजटायुषं शान्तमिवाग्निदावम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000247046, "chapter_id": 9247, "verse_number": "३-५१-४६", "content_sanskrit": "ततस्तु तं पत्ररथं महीतले\nनिपातितं रावणवेगमर्दितम्।\nपुनश्च संगृह्य शशिप्रभानना\nरुरोद सीता जनकात्मजा तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000247047, "chapter_id": 9247, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे एकपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]