[{"id": 40016347, "chapter_id": 9247, "verse_number": "1", "content_sanskrit": "तस्मिन्हतेराक्षससैन्यपालेप्लवङ्गमानामृषभेणयुद्धे । भीमयुधंसागरतुल्यवेगंविदुद्रुवेराक्षसराजसैन्यम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40016348, "chapter_id": 9247, "verse_number": "2", "content_sanskrit": "गत्वाऽथरक्षोधिपतेश्शशंसुस्सेनापतिंपावकसूनुशस्तम् । तच्छापितेषांवचनंनिशम्यरक्षोधिपःक्रोधवशंजगाम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40016349, "chapter_id": 9247, "verse_number": "3", "content_sanskrit": "सङ् ख्येप्रहस्तंनिहतंनिशम्यशोकार्दितःक्रोधपरीतचेताः । उवाचतान्राक्षसयूथमुख्यानिन्द्रोयथानिर्जरयोथमुख्यान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40016350, "chapter_id": 9247, "verse_number": "4", "content_sanskrit": "नावज्ञारिपवेकार्यायैरिन्द्रबलसूदनः । सूदितस्सैन्यपालोमेसानुयात्रस्सकुञ्जरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40016351, "chapter_id": 9247, "verse_number": "5", "content_sanskrit": "सोऽहंरिपुविनाशायविजयायाविचारयन् । स्वयमेवगमिष्यामिरणशीर्षंतदद्भुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40016352, "chapter_id": 9247, "verse_number": "6", "content_sanskrit": "अद्यतद्वानरानीकंरामंचसहलक्ष्मणम् । निर्दहिष्यामिबाणौघैर्वनंदीप्स्सैरिवानगिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40016353, "chapter_id": 9247, "verse_number": "7", "content_sanskrit": "सएवमुक्त्वाज्वलनप्रकाशंरथंतुरङ्गोत्तमराजयुक्तम् । प्रकाशमानंवपुषाज्वलन्तंसमारुरोहामरराजशत्रुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40016354, "chapter_id": 9247, "verse_number": "8", "content_sanskrit": "सशङ्खभेरीपणवप्रणादैरास्फोटितक्षेळ्वितसिंहनादैः । पुण्यैस्स्तवैश्चाप्यभिपूज्यमानस्तदाययौराक्षसराजमुख्य: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40016355, "chapter_id": 9247, "verse_number": "9", "content_sanskrit": "सशैलजीमून्तिकाशरूपैर्मांसादनैःपावकदीप्तनेत्रैः । बभौवृतोराक्षसराजमुख्योभूतैर्वृतोरुद्रइवासुरेशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40016356, "chapter_id": 9247, "verse_number": "10", "content_sanskrit": "ततोनगर्यास्सहसामहौजानिष्क्रम्यतद्वानरसैन्यमुग्रम् । महार्णवाभ्रस्तनितंददर्शसमुद्यतंपादपशैलहस्तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40016357, "chapter_id": 9247, "verse_number": "11", "content_sanskrit": "तद्राक्षसानीकमतिप्रचण्डमालोक्यरामोभुजगेन्द्रबाहुः । विभीषणंशस्त्रभृतांवरिष्ठमुवाचसेवानुगतःपृथुश्रीः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40016358, "chapter_id": 9247, "verse_number": "12", "content_sanskrit": "नानापताकध्वजशस्त्रजुष्टंप्रासासिशूलायुथवज्रजुष्टम् । कस्येदमक्षोभ्यमभीरुजुष्टंमहेन्द्रोपमनागजुष्टम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40016359, "chapter_id": 9247, "verse_number": "13", "content_sanskrit": "ततस्तुरामस्यनिशम्यवाक्यंविभीषणंश्शक्रसमानवीर्यः । शशंसरामस्यबलप्रवेगंमहात्मनांराक्षसपुङ्गवानाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40016360, "chapter_id": 9247, "verse_number": "14", "content_sanskrit": "योऽसौगजस्कन्धगतोमहात्मानवोदितार्कोपमताम्रवक्त्रः । प्रकम्पयन्नागशिरोऽभ्युपैतिह्यकम्पनंत्वेनमवेहिराजन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40016361, "chapter_id": 9247, "verse_number": "15", "content_sanskrit": "योऽसौरथस्थोमृगराजकेतुर्दून्वस्थिन्दनुश्शक्रधनुःप्रकाशम् । करीवभात्युग्रविवृत्तदंष्ट्रस्सइन्द्रजिन्नामवरप्रधानः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40016362, "chapter_id": 9247, "verse_number": "16", "content_sanskrit": "यश्चैषव्निध्यास्तमहेन्द्रकल्पोधन्वीरथस्थोऽतिरथोतिवीरः । विष्पारयन् चापमतुल्यमानंनाम्नातिकायोऽतिविवृद्धकायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40016363, "chapter_id": 9247, "verse_number": "17", "content_sanskrit": "योऽसौनवार्कोदितताम्रचक्षुरारुह्यघण्टानिनदप्रणादम् । गजंखरंगर्जतिवैमहात्मामहोदरोनामसएषःवीरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40016364, "chapter_id": 9247, "verse_number": "18", "content_sanskrit": "योऽसौहयंकाञ्चनचित्रभाण्डमारुह्यसन्ध्याभ्रगिरिप्रकाशम् । प्रासंसमुद्यम्यमरीचिनद्धंपिशाचएषोऽशनितुल्यवेगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40016365, "chapter_id": 9247, "verse_number": "19", "content_sanskrit": "यश्चैषशूलंनिशितंप्रगृह्यविद्युत्प्रभंकिङ्करवज्रवेगम् । वृषेन्द्रमास्थायगिरिप्रकाशमायातियोऽसौत्रिशिरायशस्वी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40016366, "chapter_id": 9247, "verse_number": "20", "content_sanskrit": "असौचजीमूतनिकाशरूपःकुम्भःपृथुव्यूढसुजातवक्षाः । समाहितःपन्नगराजकेतुर्विष्पारयन्यातिधनुर्विधून्वन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40016367, "chapter_id": 9247, "verse_number": "21", "content_sanskrit": "यश्चैषजाम्बूनदवज्रजुष्टंदीप्तंसधूमंपरिघंप्रगृह्य । आयातिरक्षोबलकेतुभूतःसोऽसौनिकुम्भोऽद्भुतघोरकर्मा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40016368, "chapter_id": 9247, "verse_number": "22", "content_sanskrit": "यश्चैषचापासिशरौघजुष्टंपताकिनंपावकदीप्तरूपम् । रथंसमास्थायविभात्युदग्रोनरान्तकोऽसौनगशृङ्गयोधी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40016369, "chapter_id": 9247, "verse_number": "23", "content_sanskrit": "यश्चैषनानाविधघोररूपैर्व्याघ्रोष्ट्रनागेन्द्रमृगाश्ववक्त्रै: । भूतैर्वृतोभातिविवृत्तनेत्स्रैसोऽसौसुराणामपिदर्पहन्ता ॥ त्रैतदिन्दुप्रतिमंविभातिछत्रंसितंसूक्ष्मशलाकमग्य्रम् । अत्रैषरक्षोधिपतिर्महात्माभूतैर्वृतोरुद्रइवावभाति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40016370, "chapter_id": 9247, "verse_number": "24", "content_sanskrit": "यश्चैषनानाविधघोररूपैर्व्याघ्रोष्ट्रनागेन्द्रमृगाश्ववक्त्रै: । भूतैर्वृतोभातिविवृत्तनेत्स्रैसोऽसौसुराणामपिदर्पहन्ता ॥ त्रैतदिन्दुप्रतिमंविभातिछत्रंसितंसूक्ष्मशलाकमग्य्रम् । अत्रैषरक्षोधिपतिर्महात्माभूतैर्वृतोरुद्रइवावभाति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40016371, "chapter_id": 9247, "verse_number": "25", "content_sanskrit": "असौकिरीटीचलकुण्डलास्योनगेन्द्रविन्ध्योपमभीमकायः । महेन्द्रवैवस्वतदर्पहन्तारक्षोधिपस्सूर्यइवावभाति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40016372, "chapter_id": 9247, "verse_number": "26", "content_sanskrit": "प्रत्युवाचततोरामोविभीषणमरिन्दम् । अहोदीप्तमहातेजारावणोराक्षसेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40016373, "chapter_id": 9247, "verse_number": "27", "content_sanskrit": "आदित्यइवदुष्प्रेक्ष्योरश्मिभिर्भातिरावणः । सुव्यक्तंलक्ष्यतेह्यस्यरूपंतेजःसमावृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40016374, "chapter_id": 9247, "verse_number": "28", "content_sanskrit": "देवदानववीराणांवपुर्नैवंविधंभवेत् । यादृशंराक्षसेन्द्रस्यवपुरेतत्प्रकाशते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40016375, "chapter_id": 9247, "verse_number": "29", "content_sanskrit": "सर्वेपर्वतसङ्काशास्सर्वेपर्वतयोधिनः । सर्वेदीप्तायुधधरायोधाश्चास्यमहोजस: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40016376, "chapter_id": 9247, "verse_number": "30", "content_sanskrit": "भातिरक्षोराजोऽसौप्रदीप्त्तैर्भीमविक्रमैः । भूतैःपरिवृतस्तीक्ष्णैर्देहवद्भिरिवान्तकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40016377, "chapter_id": 9247, "verse_number": "31", "content_sanskrit": "दिष्ट्याऽयमद्यपापात्माममदृष्टिपथंगतः । अद्यक्रोधंविमोक्ष्यामिसीताहरणसम्भवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40016378, "chapter_id": 9247, "verse_number": "32", "content_sanskrit": "एवमुक्त्वाततोरामोधनुरादायवीर्यवान् । लक्ष्मणानुचरस्तस्थौसमुद्धृत्यशरोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40016379, "chapter_id": 9247, "verse_number": "33", "content_sanskrit": "ततःसरक्षोधिपतिर्महात्मारक्षांसितान्याहमहाबलानि । द्वारेषुचर्यागृहगोपुरेषुसुनिर्वृतास्तिष्ठतनिर्विशङ्काः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40016380, "chapter_id": 9247, "verse_number": "34", "content_sanskrit": "हाऽगतंमांसहितंभवद्भिर्वनौकसश्छिद्रमिदंविदित्वा । शून्यापुरींदुष्प्रसहांप्रमथ्यप्रधर्षयेयुस्सहसासमेताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40016381, "chapter_id": 9247, "verse_number": "35", "content_sanskrit": "विसर्जयित्वासचिवांस्ततस्तान्गतेषुरक्षस्सुयथानियोगम् । व्यचारयद्वानरसागरौघंमहाझषःपूर्णमिवार्णवौघम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40016382, "chapter_id": 9247, "verse_number": "36", "content_sanskrit": "तमापतन्तंसहसासमीक्ष्यदीप्तेषुचापंयुधिराक्षसेन्द्रम् । महत्समुत्पाट्यमहीधराग्रंदुद्रावरक्षोधिपतिंहरीशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40016383, "chapter_id": 9247, "verse_number": "37", "content_sanskrit": "तच्छैलशृङ्गंबहुवृक्षसानुंप्रगृह्यचिक्षेपनिशाचराय । तमापतन्तंसहसासमीक्ष्यचिच्छेदबाणैस्तपनीयपुङ्खैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40016384, "chapter_id": 9247, "verse_number": "38", "content_sanskrit": "तस्मिन् प्रवृद्धोत्तमसानुवृक्षेशृङ्गेविकीर्णेपतितेपृथिव्याम् । महाहिकल्पंशरमन्तकाभंसमादधेराक्षसलोकनाथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40016385, "chapter_id": 9247, "verse_number": "39", "content_sanskrit": "सतंगृहीत्वाऽनिलतुल्यवेगंसविस्फुलिङ्गज्वलनप्रकाशम् । बाणंमहेन्द्राशनितुल्यवेगंचिक्षेपसुग्रीववधायरुष्टः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40016386, "chapter_id": 9247, "verse_number": "40", "content_sanskrit": "ससायकोरावणबाहुमुक्तःशक्राशनिप्रख्यवपुश्शिताग्रः । सुग्रीवमासाद्यबिभेदवेगाद्गुहेरिताक्रौञ्चमिवोग्रशक्तिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40016387, "chapter_id": 9247, "verse_number": "41", "content_sanskrit": "ससायकार्तोविपरीतचेताःकूजन्पृथिव्यांनिपपातवीरः । तंप्रेक्ष्यभूमौपतितंविसंज्ञंनेदुःप्रहृष्टायुधियातुधानाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40016388, "chapter_id": 9247, "verse_number": "42", "content_sanskrit": "ततोगवाक्षोगवयस्सुदंष्ट्रस्त्वथर्षभोज्योतिमुखोनलश्च । शैलान् समुत्पाट्यविवृद्धकायाःप्रदुद्रुवुस्तंप्रतिराक्षसेन्द्रम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40016389, "chapter_id": 9247, "verse_number": "43", "content_sanskrit": "तेषांप्रहारान् सचकारमोघान् रक्षोधिपोबाणशतैःशिताग्रैः । तान्वानरेन्द्रानपिबाणजालैर्बिभेदजाम्बूनदचित्रपुङ्खैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40016390, "chapter_id": 9247, "verse_number": "44", "content_sanskrit": "तेवानरेन्द्रास्त्रिदशारिबाणैर्भिन्नानिपेतुर्भुविभीमकायाः । ततस्तुतद्वानरसैन्यमुग्रंप्रच्छादयामाससबाणजालैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40016391, "chapter_id": 9247, "verse_number": "45", "content_sanskrit": "तेवध्यमानाःपतिताःप्रवीरानानद्यमानाभयशल्यविद्धाः । शाखामृगारावणसायकार्ताजग्मुश्शरण्यंशरणंस्मरामम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 40016392, "chapter_id": 9247, "verse_number": "46", "content_sanskrit": "ततोमहात्मासधनुर्धनुष्मानादायरामस्सहसाजगाम । तंलक्ष्मणःप्राञ्जलिरभ्युपेत्यउवाचवाक्यंपरमार्थयुक्तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 40016393, "chapter_id": 9247, "verse_number": "47", "content_sanskrit": "काममार्यस्सुपर्याप्तोवधायास्यदुरात्मनः । विधमिष्याम्यहंचैतमनुजानीहिमांविभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 40016394, "chapter_id": 9247, "verse_number": "48", "content_sanskrit": "तमब्रवीन्महातेजारामस्सत्यपराक्रमः । गच्छयत्नपरश्चापिभवलक्ष्मण संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 40016395, "chapter_id": 9247, "verse_number": "49", "content_sanskrit": "रावणोहिमहावीर्योरणेऽद्भुतपराक्रमः । त्रैलोक्येनापिसङ्क्रुद्धोदुष्प्रसह्योनसंशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 40016396, "chapter_id": 9247, "verse_number": "50", "content_sanskrit": "तस्यच्छिद्राणिमार्गस्वस्वच्छिद्राणिचलक्ष्य । चक्षुषाधनुषायत्ना प्रक्षात्मानंसमाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 40016397, "chapter_id": 9247, "verse_number": "51", "content_sanskrit": "राघवस्यवचश्श्रुत्वासपरिष्वज्याभिपूज्यच । अभिवाद्यतत् रामंययौसौमित्रिराहवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 40016398, "chapter_id": 9247, "verse_number": "52", "content_sanskrit": "सरावणंवारणहस्तबाहुंददर्शभीमोद्यतदीप्तचापम् । प्रच्छादयन्तंशरवृष्टिजालैस्तान्वानराभनिन्नविकीर्णदेहान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 40016399, "chapter_id": 9247, "verse_number": "53", "content_sanskrit": "तमालोक्यमहातेजाहनूमान्मारुतात्मजः । निवार्यशरजालानिप्रदुद्रावसरावणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 40016400, "chapter_id": 9247, "verse_number": "54", "content_sanskrit": "रथंतस्यसमासाद्यबाहुमुद्यम्यदक्षिणम् । त्रासयन्रावणंधीमान्हनूमान्वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 40016401, "chapter_id": 9247, "verse_number": "55", "content_sanskrit": "देवदानवगन्धर्वायक्षाश्चसहराक्षैसैः । अवश्यंतुत्वयाभग्नावानरेभ्यस्तुतेभयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 40016402, "chapter_id": 9247, "verse_number": "56", "content_sanskrit": "एषमेदक्षिणोबाहुःपञ्चशाखःसमुद्यतः । विधमिष्यतितेदेहाद्भूतात्मानंचिरोषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 40016403, "chapter_id": 9247, "verse_number": "57", "content_sanskrit": "श्रुत्वाहनुमतोवाक्यंरावणोभीमविक्रमः । संरक्तनयनःक्रोधादिदंवचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 40016404, "chapter_id": 9247, "verse_number": "58", "content_sanskrit": "क्षिप्रंप्रहरनिःशङ्कंस्थिरांकीर्तिमवाप्नुहि । ततस्त्वांज्ञातविक्रान्तंनाशयिष्यामिवानर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 40016405, "chapter_id": 9247, "verse_number": "59", "content_sanskrit": "रावणस्यवचश्श्रुत्वावायुसूनुर्वचोऽब्रवीत् । प्रहृतंहिमयापूर्वमक्षंतवसुतंतव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 40016406, "chapter_id": 9247, "verse_number": "60", "content_sanskrit": "एवमुक्तोमहातेजारावणोराक्षसेश्वरः । आजघानानिलसुतंतलेनोरसिवीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 40016407, "chapter_id": 9247, "verse_number": "61", "content_sanskrit": "सतलाभिहतस्तेनचचालचमुहुर्मुहुः । स्थित्वामुहूर्तंतेजस्वीस्थैर्यंकृत्वामहामतिः ॥ आजघानाभिसङ्कृद्धस्तलेनैवामरद्विषम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 40016408, "chapter_id": 9247, "verse_number": "62", "content_sanskrit": "ततस्ततेनाभिहतोवानरेणमहात्मना ॥ दशग्रीवःसमाधूतोयथाभूमिचलेऽचलः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 40016409, "chapter_id": 9247, "verse_number": "63", "content_sanskrit": "सङ्ग्रामेतंतथादृष्टवारावणंतलताडितम् ॥ ऋषयोवानराःसिद्धानेदुर्देवास्सहासुरैः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 40016410, "chapter_id": 9247, "verse_number": "64", "content_sanskrit": "अथाऽश्वास्यमहातेजारावणोवाक्यमब्रवीत् ॥ साधुवानर वीर्येणश्लाघनीयोऽसिमेरिपुः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 40016411, "chapter_id": 9247, "verse_number": "65", "content_sanskrit": "रावणेनैवमुक्तस्तुमारुतिर्वाक्यमब्रवीत् ॥ धिगस्तुममवीर्येणयस्त्वंजीवसिरावण ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 40016412, "chapter_id": 9247, "verse_number": "66", "content_sanskrit": "सकृत्तुप्रहरेदानींदुर्भुद्धे किंविकत्थसे ॥ ततस्त्वांमामिकामुष्टिर्नयिष्यतियमक्षयम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 40016413, "chapter_id": 9247, "verse_number": "67", "content_sanskrit": "तोमारतिवाक्येनकोधस्तस्यतदाऽज्वलत् ॥ संरक्तनयनोयत्नान्मुष्टिमुद्यम्यदक्षिणम् । पातयामासवेगेनवानरोरसिवीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 40016414, "chapter_id": 9247, "verse_number": "68", "content_sanskrit": "तोमारतिवाक्येनकोधस्तस्यतदाऽज्वलत् ॥ संरक्तनयनोयत्नान्मुष्टिमुद्यम्यदक्षिणम् । पातयामासवेगेनवानरोरसिवीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 40016415, "chapter_id": 9247, "verse_number": "69", "content_sanskrit": "हनूमान् वक्षसिव्यूढेसञ्चचालहतःपुनः । विह्वलंतुतदादृष्टवाहनूमन्तंमहाबलम् ॥ रथेनातिरथशशीघ्रंनीलंप्रतिसमभ्यगात् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 40016416, "chapter_id": 9247, "verse_number": "70", "content_sanskrit": "राक्षसानामधिपतिर्धशग्रीवःप्रतापवान् ॥ पन्नगप्रतिमैर्भीमैःपरमर्माभिभेदिभिः । शरैरादीपयामासनीलंहरिचमूपतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 40016417, "chapter_id": 9247, "verse_number": "71", "content_sanskrit": "राक्षसानामधिपतिर्धशग्रीवःप्रतापवान् ॥ पन्नगप्रतिमैर्भीमैःपरमर्माभिभेदिभिः । शरैरादीपयामासनीलंहरिचमूपतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 40016418, "chapter_id": 9247, "verse_number": "72", "content_sanskrit": "सशरौघसमायस्तोनीलःकपिचमूपतिः । करेणेकैनेशैलाग्रंरक्षोधिपतयेऽसृजत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 40016419, "chapter_id": 9247, "verse_number": "73", "content_sanskrit": "हनूमानपितेजस्वीसमाश्वस्तोमहामनाः । विप्रेक्षमाणोयुद्धेप्सुस्सरोषमिदमब्रवीत् ॥ नीलेनसहसंयुक्तंरावणंराक्षसेश्वरम् । अन्येनयुद्यमानस्यनयुक्तमभिधावनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 40016420, "chapter_id": 9247, "verse_number": "74", "content_sanskrit": "हनूमानपितेजस्वीसमाश्वस्तोमहामनाः । विप्रेक्षमाणोयुद्धेप्सुस्सरोषमिदमब्रवीत् ॥ नीलेनसहसंयुक्तंरावणंराक्षसेश्वरम् । अन्येनयुद्यमानस्यनयुक्तमभिधावनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 40016421, "chapter_id": 9247, "verse_number": "75", "content_sanskrit": "रावणोऽपिमहातेजास्तंच्छृङ्गंसप्तभिःशरैः । आजघानसुतीक्ष्णाग्रैस्तद्विकीर्णंपपातह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 40016422, "chapter_id": 9247, "verse_number": "76", "content_sanskrit": "तद्विकीर्णंगिरेश्शृङ्गंदृष्टवाहरिचमूपतिः । कालानगिरिवजज्वालकोपेनपरवीरहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 40016423, "chapter_id": 9247, "verse_number": "77", "content_sanskrit": "सोऽश्वकर्णान्धान् शालांश्चूताश्चापिसुपुष्पितान् । अन्यांश्चविविधान् वृक्षान्नीलश्चिक्षेपसंयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 40016424, "chapter_id": 9247, "verse_number": "78", "content_sanskrit": "सतान्वृक्षान् समासाद्यप्रतिचिच्छेदरावणः । अभ्यवर्षत्सुघोरेणशरवर्षेणपावकिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 40016425, "chapter_id": 9247, "verse_number": "79", "content_sanskrit": "अभिवृष्टश्शरौघेणमेघेनेवमहाबलः । ह्रस्वंकृत्वाततोरूपंध्वजाग्रेनिपपातह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 40016426, "chapter_id": 9247, "verse_number": "80", "content_sanskrit": "पावकात्मजमालोक्यध्वजाग्रेसमवस्थितम् । जज्वालरावणःक्रोधात्ततोनीलोननादच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 40016427, "chapter_id": 9247, "verse_number": "81", "content_sanskrit": "ध्वजाग्रेधनुषश्चाग्रेकिरीटाग्रेचतंहरिम् । लक्ष्मणोऽथहनूमांश्चदृष्टवारामश्चविस्मिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 40016428, "chapter_id": 9247, "verse_number": "82", "content_sanskrit": "रावणोऽपिमहातेजाःकपिलाघवविस्मितः । अस्त्रमाहारयामासदीप्तमाग्नेयमद्भुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 40016429, "chapter_id": 9247, "verse_number": "83", "content_sanskrit": "ततस्तेचुक्रुशुर्हृष्टालब्दलक्षाःप्लवङ्गमाः । नीललाघवसम्भ्रान्तंदृष्टवारावणमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 40016430, "chapter_id": 9247, "verse_number": "84", "content_sanskrit": "वानराणांचनादेवसंरब्दोरावणस्तदा । सम्भ्रमाविष्टहृदयोनकिञ्चित्प्रत्यपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 40016431, "chapter_id": 9247, "verse_number": "85", "content_sanskrit": "आग्नेयेनाधसंयुक्तंगृहीत्वारावणश्शरम् । ध्वजशीर्षस्थितंसीलमुदैक्षतनिशाचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 40016432, "chapter_id": 9247, "verse_number": "86", "content_sanskrit": "ततोऽब्रवीन्महातेजारावणोराक्षसेश्वरः । कपेलाघवयुक्तोऽसिमाययापरयाऽनया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 40016433, "chapter_id": 9247, "verse_number": "87", "content_sanskrit": "जीवितंखलुरक्षस्वयदिशक्तोऽपिवानर । तानितान्यात्मरूपाणिसृजसित्वमनेकशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 40016434, "chapter_id": 9247, "verse_number": "88", "content_sanskrit": "तथापित्वांमयामुक्तस्सायोकोऽस्त्रप्रयोजितः । जीवितंपरिरक्षन्तंजीविताद्भ्रंशयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 40016435, "chapter_id": 9247, "verse_number": "89", "content_sanskrit": "एवमुक्त्वामहाबाहूरावणोराक्षसेश्वरः । सन्धायबाणमस्त्रणचमूपतिमताडयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 40016436, "chapter_id": 9247, "verse_number": "90", "content_sanskrit": "सोऽस्त्रयुक्तेनबाणेननीलोवक्षसिताडितः । निर्धह्यमानस्सहसानिपपातमहीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 40016437, "chapter_id": 9247, "verse_number": "91", "content_sanskrit": "पितृमहात्म्यसंयोगात्मनश्चापितेजसा । जानुभ्यानुपतद्भूमौनतुप्राणैर्व्ययुज्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 40016438, "chapter_id": 9247, "verse_number": "92", "content_sanskrit": "विसंज्ञंवानरंदृष्टवादशग्रीवोरणोत्सुकः । रथेनाम्बुदनादेनसौमित्रिमभिदुद्रुवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 40016439, "chapter_id": 9247, "verse_number": "93", "content_sanskrit": "आसाद्यरणमध्येतंवारयित्वास्थितोज्वलन् । धनुर्विष्फारयामासकम्पयन्निवमेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 40016440, "chapter_id": 9247, "verse_number": "94", "content_sanskrit": "तमाहसौमित्रिरदीनसत्त्वोविष्फारयन्तंधनुरप्रमेयम् । अभ्येहिमामद्यनिशाचरेन्द्रनवानरांस्त्वप्रतियोद्धुमर्हः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 40016441, "chapter_id": 9247, "verse_number": "95", "content_sanskrit": "सतस्यवाक्यंप्रतिपूर्णघोषंज्याशब्दमुग्रंचनिशम्यराजा । आसाद्यसौमित्रिमवस्थितंतंकोपान्वितोवाचमुवाचरक्षः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 40016442, "chapter_id": 9247, "verse_number": "96", "content_sanskrit": "दिष्ट्यासिमेराघव दृष्टिमार्गंप्राप्तोऽन्तगामीविपरीतबुद्धिः । अस्मिन् क्षणेयास्यसिमृत्युदेशंसम्पाद्यमानोममबाणजालैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 40016443, "chapter_id": 9247, "verse_number": "97", "content_sanskrit": "तमाहसौमित्रिरविस्मयानोगर्जन्तमुद्वृत्तसिताग्रदंष्ट्रम् । राजन्नगर्जन्तिमहाप्रभावाविकत्थसेपापकृतांवरिष्ठ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 40016444, "chapter_id": 9247, "verse_number": "98", "content_sanskrit": "जानामिवीर्यंतवराक्षसेन्द्रबलंप्रतापंचपराक्रमंच । अवस्थितोऽहंशरचापपाणिरागच्छकिंमोघविकत्थनेन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 40016445, "chapter_id": 9247, "verse_number": "99", "content_sanskrit": "सएवमुक्तःकुपितस्ससर्जरक्षोथिपस्सप्तशरान् सुपुङ्खान् । तान्लक्ष्मणःकाञ्चनचित्रिपुङ्खैश्चिच्छेदबाणैर्निशिताग्रधारैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 40016446, "chapter_id": 9247, "verse_number": "100", "content_sanskrit": "तान् प्रेक्षमाणस्सहसानिकृत्तानिकृत्तभोगानिवपन्नगेन्द्रान् । लङ्केश्वरःक्रोधवशंजगामससर्जचान्यान्निशितान्पृषत्कान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 40016447, "chapter_id": 9247, "verse_number": "101", "content_sanskrit": "सबाणवर्षंतुववर्षतीव्रंरामानुजःकार्मुकसम्प्रयुक्तम् । क्षुरार्धचन्द्रोत्तमकर्णिभल्लैःशरांश्चचिच्छेदनचुक्षुभेच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 40016448, "chapter_id": 9247, "verse_number": "102", "content_sanskrit": "सबाणजालान्यथतानितानिमोघानिपश्यंस्त्रिदशारिराजः । विसिस्मियेलक्ष्मणलाघवेनपुनश्चबाणान्निशितान्मुमोच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 40016449, "chapter_id": 9247, "verse_number": "103", "content_sanskrit": "सलक्ष्मणश्चापिशरान् शिताग्रान्महेन्द्रतुल्योऽशनितुल्यवेगान् । सन्धायचापेज्वलनप्रकाशान् ससर्जरक्षोधिपतेर्वधाय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 40016450, "chapter_id": 9247, "verse_number": "104", "content_sanskrit": "सतान् प्रचिच्छेदहिराक्षसेन्द्रःछित्वाचतन्लक्ष्मणमाजघान । शरेणकालाग्निसमप्रभेणस्वयम्भुदत्तेनललाटदेशे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 40016451, "chapter_id": 9247, "verse_number": "105", "content_sanskrit": "सलक्ष्मणोरावणसायकार्तश्चचालचापंशिधिलंप्रगृह्य । पुनश्चसंज्ञांप्रतिलभ्यकृच्छ्राच्चिच्छेदचापंत्रिदशेन्द्रशत्रो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 40016452, "chapter_id": 9247, "verse_number": "106", "content_sanskrit": "निकृत्तचापंत्रिभिराजघानबाणैस्तदादाशरथिश्शिताग्रैः । ससायकार्तोविचचालराजाकृच्छ्राच्छसंज्ञांपुनराससाद ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 40016453, "chapter_id": 9247, "verse_number": "107", "content_sanskrit": "सकृत्तचापःशरताडितश्चमेदार्द्रगात्रोरुधिरावसिक्तः । जग्राहशक्तिंस्वयमुग्रशक्तिस्स्वयम्भुदत्तांयुधिदेवशत्रुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 40016454, "chapter_id": 9247, "verse_number": "108", "content_sanskrit": "सतांसधूमानलसन्निकाशांवित्रासनींसंयतिवानराणाम् । चिक्षेपशक्तिंतरसाज्वलन्तींसौमित्रयेराक्षसराष्ट्रनाथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 40016455, "chapter_id": 9247, "verse_number": "109", "content_sanskrit": "तामापतन्तींभरतानुजोऽस्त्रैर्जघानबाणैश्चहुताग्निकल्पैः । तथापिसातस्यविवेशशक्तिर्भुजान्तरंदाशरथेर्विशालम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 40016456, "chapter_id": 9247, "verse_number": "110", "content_sanskrit": "सशक्तिमान् शक्तिसमाहतःसन् प्रजज्वालमुहुःरघुप्रवीरः । तंविह्वलन्तंसहसाभ्युपेत्यजग्राहराजातरसाभुजाभ्याम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 40016457, "chapter_id": 9247, "verse_number": "111", "content_sanskrit": "हिमवान् मन्दरोमेरुस्तैलोक्यंवासहामरैः । शक्यंभुजाभ्यामुद्धर्तुंनसङ् ख्येभरतानुजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 40016458, "chapter_id": 9247, "verse_number": "112", "content_sanskrit": "शक्त्याब्राह्म्याहिसौमित्रिस्ताडितास्तुस्तनान्तरे । विष्णोरचिन्यन्त्यंस्वंभागमात्मानंप्रत्यनुस्मरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 40016459, "chapter_id": 9247, "verse_number": "113", "content_sanskrit": "ततोदानवदर्पघ्नंसौमित्रिंदेवकण्टकः । तंपीडयित्वाबाहुभ्यांनप्रभुर्लङ्घनेऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 40016460, "chapter_id": 9247, "verse_number": "114", "content_sanskrit": "अथवायुसुतःक्रुद्धोरावणंसमभिद्रवत् । आजघानोरसिक्रुद्धोवज्रकल्पेनमुष्टिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 40016461, "chapter_id": 9247, "verse_number": "115", "content_sanskrit": "तेनमुष्टिप्रहारेणरावणोराक्षसेश्वरः । जानुभ्यामपतद्भूमौचचालचपपातच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 40016462, "chapter_id": 9247, "verse_number": "116", "content_sanskrit": "अस्यैश्चनेत्रैश्श्रवणैःपपातरुधिरंबहु । विघूर्णमानोनिश्चेष्टोरथोपस्थउपाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 40016463, "chapter_id": 9247, "verse_number": "117", "content_sanskrit": "विसंज्ञोमूर्च्छ्रितश्चासीन्नचस्थानंसमालभत् । विसंज्ञंरावणंदृष्टवासमरेभीमविक्रमम् ॥ ऋषयोवानराश्चैवनेदुर्देवास्सवासवाः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 40016464, "chapter_id": 9247, "verse_number": "118", "content_sanskrit": "हनूमानपितेजस्वीलक्ष्मणंरावणार्धितम् ॥ आनयद्राघवाभ्याशंबाहुभ्यांपरिगृह्यतम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 40016465, "chapter_id": 9247, "verse_number": "119", "content_sanskrit": "वायुसूनोःसुहृत्त्वेनभक्त्यापरमयाचसः ॥ शत्रूणामप्रकम्प्योऽपिलघुत्वमगमत्कपेः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 40016466, "chapter_id": 9247, "verse_number": "120", "content_sanskrit": "तंसमुत्सृज्यसाशक्तिःसौमित्रिंयुधिदुर्जयम् ॥ रावणस्यरथेतस्मिन् स्थानंपुनरुपागता ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 40016467, "chapter_id": 9247, "verse_number": "121", "content_sanskrit": "आश्वस्तश्चनिशल्यश्चलक्ष्मणश्शत्रुसूदनः ॥ विष्णोर्भागममीमांस्यमात्मानंप्रत्यनुस्मरन् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 40016468, "chapter_id": 9247, "verse_number": "122", "content_sanskrit": "रावणोऽपिमहातेजाःप्राप्यसंज्ञांमहाहवे ॥ आददेनिशितान् बाणान् जग्राहचमहद्धमः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 40016469, "chapter_id": 9247, "verse_number": "123", "content_sanskrit": "निपातितमहावीरांद्रवन्तींवानरींचमूम् ॥ राघवस्तुरणेदृष्टवारावणंसमभिद्रवत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 40016470, "chapter_id": 9247, "verse_number": "124", "content_sanskrit": "अथैवमुपसङ्गम्यहनूमान्वाक्यमब्रवीत् ॥ ममपृष्ठंसमारुह्यराक्षसंशास्तुमर्हसि । विष्णुर्यथागरुत्मन्तंबलवन्तंसमाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 40016471, "chapter_id": 9247, "verse_number": "125", "content_sanskrit": "अथैवमुपसङ्गम्यहनूमान्वाक्यमब्रवीत् ॥ ममपृष्ठंसमारुह्यराक्षसंशास्तुमर्हसि । विष्णुर्यथागरुत्मन्तंबलवन्तंसमाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 40016472, "chapter_id": 9247, "verse_number": "126", "content_sanskrit": "तच्छ्रुत्वाराघवोवाक्यंवायुपुत्रेणभाषितम् । आरुरोहमहाशूरंबलवन्तंमहाकपिम् ॥ रथस्थंरावणंसङ् ख्येददर्शमनुजाधिपः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 40016473, "chapter_id": 9247, "verse_number": "127", "content_sanskrit": "तमालोक्यमहातेजाःप्रदुद्रावसराघवः ॥ वैरोचनिवक्रुद्धोविष्णुरभ्युद्यतायुधः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 40016474, "chapter_id": 9247, "verse_number": "128", "content_sanskrit": "ज्याशब्दमकरोत्तीव्रंवज्रनिष्पेषनिस्वनम् ॥ गिरागम्भीरयारामोराक्षसेन्द्रमुवाचह ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 40016475, "chapter_id": 9247, "verse_number": "129", "content_sanskrit": "तिष्ठतिष्ठममत्वंहिकृत्वाविप्रियमीदृशम् ॥ क्वनुराक्षसशार्दूल गतोमोक्षमवाप्स्यसि ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 40016476, "chapter_id": 9247, "verse_number": "130", "content_sanskrit": "यदीन्द्रवैवस्वतभास्करान्वास्वयम्भुवैश्वानरशंकरान्वा । गमिष्यसित्वंदशवादिशोवातथापिमेनाद्यगतोविमोक्ष्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 40016477, "chapter_id": 9247, "verse_number": "131", "content_sanskrit": "यश्चैवशक्त्याभिहतस्त्वयाऽद्यइच्छन्विषादंसहसाभ्युपेत्य । सएषरक्षोगणराजमृत्युःसपुत्रपौत्रस्यतवाद्ययुद्धे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 40016478, "chapter_id": 9247, "verse_number": "132", "content_sanskrit": "एतेनचात्यद्भुतदर्शनानिशरैर्जवस्थानकृतालयानि । चतुर्धशान्यात्तवरायुधानिरक्षःसहस्राणिनिषूदितानि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 40016479, "chapter_id": 9247, "verse_number": "133", "content_sanskrit": "राघवस्यवचश्श्रुत्वाराक्षसेन्द्रोमहाबलः । वायुपुत्रंमहावेगंवहन्तंराघवंरणे ॥ रोषेणमहताविष्टःपूर्ववैरमनुस्मरन् । आजघानशरैर्दीप्स्सैःकालानलशिखोपमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 40016480, "chapter_id": 9247, "verse_number": "134", "content_sanskrit": "राघवस्यवचश्श्रुत्वाराक्षसेन्द्रोमहाबलः । वायुपुत्रंमहावेगंवहन्तंराघवंरणे ॥ रोषेणमहताविष्टःपूर्ववैरमनुस्मरन् । आजघानशरैर्दीप्स्सैःकालानलशिखोपमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 40016481, "chapter_id": 9247, "verse_number": "135", "content_sanskrit": "राक्षसेनाहवेतस्यताडितस्यापिसायकैः । स्वभावतेजोयुक्तस्यभूयस्तेजोऽभ्यवर्धत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 40016482, "chapter_id": 9247, "verse_number": "136", "content_sanskrit": "ततोरामोमहातेजारावणेनकृतव्रणम् । दृष्टवाप्लवगशार्दूलंक्रोधस्यवशमेयिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 40016483, "chapter_id": 9247, "verse_number": "137", "content_sanskrit": "तस्याभिसङ्क्रम्यरथंसचक्रंसाश्वध्वजच्छत्रमहापताकम् । ससारथिंसाशनिशूलखडगंरामःप्रचिच्छेदशरैस्सुपुङ्खैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 40016484, "chapter_id": 9247, "verse_number": "138", "content_sanskrit": "अथेन्द्रशत्रुंतरसाजघानबाणेनवज्राशनिसन्निभेन । भुजान्तरेव्यूढसुजातरूपेवज्रेणमेरुंभगवानिवेन्द्रः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 40016485, "chapter_id": 9247, "verse_number": "139", "content_sanskrit": "योवज्रपातशनिसन्निपातान्नचक्षुभेनापिचचालराजा । सरामबाणाभिहतोभृशार्तश्चचालचापंचमुमोचवीरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 40016486, "chapter_id": 9247, "verse_number": "140", "content_sanskrit": "तंविह्वलन्तंप्रसमीक्ष्यरामस्समाददेदीप्तमथार्थचन्द्रम् । तेनार्कवर्णंसहसाकिरीटंचिच्छेदरक्षोधिपतेर्महात्मा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 40016487, "chapter_id": 9247, "verse_number": "141", "content_sanskrit": "तंनिर्विषाशीविषसन्निकाशंशान्तार्चिषंसूर्यमिवाप्रकाशम् । गतश्रियंकृत्तकिरीटकूटमुवाचरामोयुधिराक्षसेन्द्रम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 40016488, "chapter_id": 9247, "verse_number": "142", "content_sanskrit": "कृतंत्वयाकर्ममहत्सुभीमंहतप्रवीरश्चकृतस्त्वयाऽहम् । तस्मात्परिश्रान्तइतिव्यवस्यन्नत्वांशरैर्मृत्युवशंनयामि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 40016489, "chapter_id": 9247, "verse_number": "143", "content_sanskrit": "गच्छानुजानामिरणार्धितस्त्वंप्रविश्यरात्रिंचरराजलङ्काम् । आश्वस्यनिर्याहिरथीचधन्वीतदाबलंप्रेक्ष्यसिमेरथस्थः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 40016490, "chapter_id": 9247, "verse_number": "144", "content_sanskrit": "सएवमुक्तोहतदर्पहर्षोनिकृत्तचापश्चहताश्वसूतः । शरार्दितःकृत्तमहाकिरीटोविवेशलङ्कांसहसास्मराजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 40016491, "chapter_id": 9247, "verse_number": "145", "content_sanskrit": "प्रविष्टेरजनीचरेन्द्रेमहाबलेदाववदेवशत्रौ । हरीन् विशल्यान् सहलक्ष्मणेनचकाररामःपरमाहवाग्रे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 40016492, "chapter_id": 9247, "verse_number": "146", "content_sanskrit": "तस्मिन्प्रभन्नेत्रिदशेन्द्रशतौसुरासुराभूतगणादिशश्च । ससागरास्सर्षिमहोरगाश्चतथैवभूम्यम्बुचराश्चप्रहृष्टाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}]