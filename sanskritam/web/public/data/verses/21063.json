[{"id": 7001063000, "chapter_id": 21063, "verse_number": "६-७-१", "content_sanskrit": "केशिध्वज उवाच\nन प्रार्थितं त्वया कस्मादस्मद्रा ज्यमकंटकम् ।\nराज्यलाभाद्विना नान्यत्क्षत्त्रियाणामतिप्रियम्  ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001063001, "chapter_id": 21063, "verse_number": "६-७-२", "content_sanskrit": "खांडिक्य उवाच\nकेशिध्वज निबोध त्वं मया न प्रार्थितं यतः\nराज्यमेतदश्षॐ ते यत्र गृध्नंत्यपंडिताः  ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001063002, "chapter_id": 21063, "verse_number": "६-७-३", "content_sanskrit": "क्षत्त्रियाणामयं धर्मो यत्प्रजापरिपालनम् ।\nवधश्च धर्मयुद्धेन स्वराज्यपरिपंथिनाम्  ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001063003, "chapter_id": 21063, "verse_number": "६-७-४", "content_sanskrit": "तत्राशक्तस्य मे दोषो नैवास्त्यपहृते त्वया ।\nबंधायैव भवत्येषा ह्यविद्याप्यक्रमोज्झिता  ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001063004, "chapter_id": 21063, "verse_number": "६-७-५", "content_sanskrit": "अल्पोमोपभोगलिप्सार्थमियं राज्यस्पृहा मम ।\nअन्येषां दोषज सैव धर्मं वै नानुरुध्यते  ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001063005, "chapter_id": 21063, "verse_number": "६-७-६", "content_sanskrit": "न याच्ञा क्षत्त्रबंधूनां धर्मयैतत्सतां मतम्\nअतो न याचितं राज्यमविद्यांतर्गतं तव  ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001063006, "chapter_id": 21063, "verse_number": "६-७-७", "content_sanskrit": "राज्ये गृध्नंत्यविद्वांसो ममत्वाहृतचेतसः ।\nअहंमानमहापानमदमत्ता न मादृशाः  ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001063007, "chapter_id": 21063, "verse_number": "६-७-८", "content_sanskrit": "श्रीपराशर उवाच\nप्रहृष्टस्साध्विति ततः प्राह केशिध्वजो नृपः ।\nखांडिक्यजनकं प्रीत्या श्रूयतां वचनं मम  ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001063008, "chapter_id": 21063, "verse_number": "६-७-९", "content_sanskrit": "केशिध्वज उवाच\nअहं ह्यविद्यया मृत्युं तर्तुकामः करोमि वै ।\nराज्यं यागांश्च विविधान्योगैः पुण्यक्षयं तथा  ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001063009, "chapter_id": 21063, "verse_number": "६-७-१०", "content_sanskrit": "तदिदं ते मनो दिष्ट्या विवेकैश्वर्यतां गतम् ।\nतच्छ्रूयतामविद्यायास्स्वरूपं कुलनंदन  ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001063010, "chapter_id": 21063, "verse_number": "६-७-११", "content_sanskrit": "अनात्मन्यात्मबुद्धिर्या चास्वे स्वमिति या मतिः\nसंसारतरुसंभूतिबीजमेतद्द्विधा स्थितम्  ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001063011, "chapter_id": 21063, "verse_number": "६-७-१२", "content_sanskrit": "पंचभूतात्मके देहे देही मोहतमोवृतः\nअहं ममैतदित्युच्चैः कुरुते कुमतिर्मतिम्  ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001063012, "chapter_id": 21063, "verse_number": "६-७-१३", "content_sanskrit": "आकाशवाय्वग्निजलपृथिवीभ्यः पृथक् स्थिते ।\nआत्मन्यात्ममयं भावं कः करोति कलेवरे  ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001063013, "chapter_id": 21063, "verse_number": "६-७-१४", "content_sanskrit": "कलेवरोपभोग्यं हि गृहक्षेत्रादिकं च कः ।\nअदेहे ह्यात्मनि प्राज्ञे ममेदमिति मन्यते  ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001063014, "chapter_id": 21063, "verse_number": "६-७-१५", "content_sanskrit": "इत्थं च पुत्त्रपौत्त्रेषु तद्देहोत्पादितेषु कः ।\nकरोति पंडितस्स्वाम्यमनात्मनि कलेवरे  ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001063015, "chapter_id": 21063, "verse_number": "६-७-१६", "content_sanskrit": "सर्वं देहोपभोगाय कुरुते कर्म मानवः ।\nदेहश्चान्यो यदा पुंसस्तदा बंधाय तत्परम्  ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001063016, "chapter_id": 21063, "verse_number": "६-७-१७", "content_sanskrit": "मृण्मयं हि यथा गेहं लिप्यते वै मृदंभसा ।\nपार्थिवोऽयं तथा देहो मृदंब्वालेपनस्थितः  ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001063017, "chapter_id": 21063, "verse_number": "६-७-१८", "content_sanskrit": "पंचभूतात्मकैर्भोगैः पंचभूतात्मकं वपुः\nआप्यायते यदि ततः पुंसो भोगोऽत्र किं कृतः  ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001063018, "chapter_id": 21063, "verse_number": "६-७-१९", "content_sanskrit": "अनेकजन्मसाहस्रीं संसारपदवीं व्रजन् ।\nमोहश्रमं प्रयातोऽसौ वासनारेणुकुंठितः  ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001063019, "chapter_id": 21063, "verse_number": "६-७-२०", "content_sanskrit": "प्रक्षाल्यते यदा सोस्य रेणुज्ञानोष्णवारिणा\nतदा संसारपांथस्य याति मोहश्रमश्शमम्  ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001063020, "chapter_id": 21063, "verse_number": "६-७-२१", "content_sanskrit": "मोहश्रमे शमं याते स्वस्थांतःकरणः पुमान् ।\nअनन्यातिशयाबाधं परं निर्वाणमृच्छति  ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001063021, "chapter_id": 21063, "verse_number": "६-७-२२", "content_sanskrit": "निर्वाणमय एवायमात्मा ज्ञानमयोऽमलः ।\nदुःखाज्ञानमया धर्माः प्रकृतेस्ते तु नात्मनः  ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001063022, "chapter_id": 21063, "verse_number": "६-७-२३", "content_sanskrit": "जलस्य नाग्निसंसर्गस्थालीसंगात्तथापि हि ।\nशब्दोद्रेकादिकान्धर्मांस्तत्करोति यथा नृप  ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001063023, "chapter_id": 21063, "verse_number": "६-७-२४", "content_sanskrit": "तथात्मा प्रकृतेस्संगादहंमानादिदूषितः ।\nभजते प्राकृतान्धर्मानन्यस्तेभ्यो हि सोऽव्ययः  ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001063024, "chapter_id": 21063, "verse_number": "६-७-२५", "content_sanskrit": "तदेतत्कथितं बीजमविद्याया मया तव ।\nक्लेशानां च क्षयकरं योगादन्यन्न विद्यते  ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001063025, "chapter_id": 21063, "verse_number": "६-७-२६", "content_sanskrit": "खांडिक्य उवाच\nतं ब्रवीहि महाभाग योगं योगविदुत्तम ।\nविज्ञातयोगशास्त्रार्थस्त्वमस्यां निमिसंततौ  ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001063026, "chapter_id": 21063, "verse_number": "६-७-२७", "content_sanskrit": "केशिध्वज उवाच\nयोगस्वरूपं खांडिक्य श्रूयतां गदतो मम ।\nयत्र स्थितो न च्यवते प्राप्य ब्रह्मलयं मुनिः  ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001063027, "chapter_id": 21063, "verse_number": "६-७-२८", "content_sanskrit": "मन एव मनुष्याणां कारणं बंधमोक्षयोः ।\nबंधाय विषयासंगि मुक्त्यै निर्विषयं मनः  ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001063028, "chapter_id": 21063, "verse_number": "६-७-२९", "content_sanskrit": "विषयेभ्यस्समाहृत्य विज्ञानात्मामनो मुनिः ।\nचिंतयेन्मुक्तये तेन ब्रह्मभूतं परेश्वरम्  ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001063029, "chapter_id": 21063, "verse_number": "६-७-३०", "content_sanskrit": "आत्मभावं नयत्येनं तद्ब्रह्म ध्यायिनं मुनिम् ।\nविकार्यमात्मनश्शक्त्या लोहमाकर्षको यथा  ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001063030, "chapter_id": 21063, "verse_number": "६-७-३१", "content_sanskrit": "आत्मप्रयत्नसापेक्षा विशिष्टा या मनोगतिः ।\nतस्या ब्रह्मणि संयोगो योग इत्यभिधीयते  ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001063031, "chapter_id": 21063, "verse_number": "६-७-३२", "content_sanskrit": "एवमत्यंतवैशिष्ट्ययुक्तधर्मोपलक्षणः ।\nयस्य योगस्स वै योगी मुमुक्षुरभिधीयते  ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001063032, "chapter_id": 21063, "verse_number": "६-७-३३", "content_sanskrit": "योगयुक्प्रथमं योगी युंजानो ह्यभिधीयते ।\nविनिष्पन्नसमाधिस्तु परं ब्रह्मोपलब्धिमान्  ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001063033, "chapter_id": 21063, "verse_number": "६-७-३४", "content_sanskrit": "यद्यंतरायदोषेण दूष्यते चास्य मानसम् ।\nजन्मांतरैरभ्यसतो मुक्तिः पूर्वस्य जायते  ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001063034, "chapter_id": 21063, "verse_number": "६-७-३५", "content_sanskrit": "विनिष्पन्नसमाधिस्तु मुक्तिं तत्रैव जन्मनि ।\nप्राप्नोति योगी योगाग्निदग्धकर्मचयोऽचिरात्  ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001063035, "chapter_id": 21063, "verse_number": "६-७-३६", "content_sanskrit": "ब्रह्मचर्यमहिंसां च सत्यास्तेयापरिग्रहान्\nसेवेत योगी निष्कामो योग्यतां स्वमनो नयन्  ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001063036, "chapter_id": 21063, "verse_number": "६-७-३७", "content_sanskrit": "स्वाध्यायशौचसंतोषतपांसि नियतात्मवान् ।\nकुर्वीत ब्रह्मणि तथा परस्मिन्प्रवणं मनः  ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001063037, "chapter_id": 21063, "verse_number": "६-७-३८", "content_sanskrit": "एते यमास्सनियमाः पंच पंच च कीर्त्तिताः ।\nविशिष्टफलदाः काम्या निष्कामानां विमुक्तिदाः  ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001063038, "chapter_id": 21063, "verse_number": "६-७-३९", "content_sanskrit": "एकं भद्रा सनादीनां समास्थाय गुणैर्युतः ।\nयमाख्यैर्नियमाख्यैश्च युंजीत नियतो यतिः  ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001063039, "chapter_id": 21063, "verse_number": "६-७-४०", "content_sanskrit": "प्राणाख्यमनिलं वश्यमभ्यासात्कुरुते तु यत् ।\nप्राणायामस्स विज्ञेयस्सबीजोऽबीज एव च  ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001063040, "chapter_id": 21063, "verse_number": "६-७-४१", "content_sanskrit": "परस्परेणाभिभवं प्राणापानौ यथानिलौ ।\nकुरुतस्सद्विधानेन तृतीयस्संयमात्तयोः  ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001063041, "chapter_id": 21063, "verse_number": "६-७-४२", "content_sanskrit": "तस्य चालंबनवतः स्थूलरूपं द्विजोत्तम ।\nआलंबनमनंतस्य योगिनोऽभ्यसतः स्मृतम्  ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001063042, "chapter_id": 21063, "verse_number": "६-७-४३", "content_sanskrit": "शब्दादिष्वनुरक्तानि निगृह्याक्षाणि योगवित् ।\nकुर्याच्चित्तानुकारीणि प्रत्याहारपरायणः  ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001063043, "chapter_id": 21063, "verse_number": "६-७-४४", "content_sanskrit": "वश्यता परमा तेन जायतेति चलात्मनाम्\nइन्द्रि याणामवश्यैस्तैर्न योगी योगसाधकः  ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001063044, "chapter_id": 21063, "verse_number": "६-७-४५", "content_sanskrit": "प्राणयामेन पवने प्रत्याहारेण चेंद्रि ये ।\nवशीकृते ततः कुर्यात्स्थितं चेतश्शुभाश्रये  ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001063045, "chapter_id": 21063, "verse_number": "६-७-४६", "content_sanskrit": "खाडिक्य उवाच\nकथ्यतां मे महाभाग चेतसो यश्शुभाश्रयः\nयदाधारमश्षॐ तद्धंति दोषमलोद्भवम्  ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001063046, "chapter_id": 21063, "verse_number": "६-७-४७", "content_sanskrit": "केशिध्वज उवाच\nआश्रयश्चेतसो ब्रह्म द्विधा तच्च स्वभावतः\nभूप मूर्त्तममूर्त्तं च परं चापरमेव च  ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001063047, "chapter_id": 21063, "verse_number": "६-७-४८", "content_sanskrit": "त्रिविधा भावना भूप विश्वमेतन्निबोधताम् ।\nब्रह्माख्या कर्मसंज्ञा च तथा चैवोभयात्मिका  ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001063048, "chapter_id": 21063, "verse_number": "६-७-४९", "content_sanskrit": "कर्मभावात्मिका ह्येका ब्रह्मभावात्मिका परा ।\nउभयात्मिका तथैवान्या त्रिविधा भावभावना  ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001063049, "chapter_id": 21063, "verse_number": "६-७-५०", "content_sanskrit": "सनंदनादयो ये तु ब्रह्मभावनया युताः ।\nकर्मभावनया चान्ये देवाद्याः स्थावरावराः  ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001063050, "chapter_id": 21063, "verse_number": "६-७-५१", "content_sanskrit": "हिरण्यगर्भादिषु च ब्रह्मकर्मात्मिका द्विधा ।\nबोधाधिकारयुक्तेषु विद्यते भावभावना  ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001063051, "chapter_id": 21063, "verse_number": "६-७-५२", "content_sanskrit": "अक्षीणेषु समस्तेषु विशेषज्ञानकर्मसु ।\nविश्वमेतत्परं चान्यद्भेदभिन्नदृशां नृणाम्  ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001063052, "chapter_id": 21063, "verse_number": "६-७-५३", "content_sanskrit": "प्रत्यस्तमितभेदं यत्सत्तामात्रमगोचरम् ।\nवचसामात्मसंवेद्यं तज्ज्ञानं ब्रह्मसंज्ञितम्  ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001063053, "chapter_id": 21063, "verse_number": "६-७-५४", "content_sanskrit": "तच्च विष्णोः परं रूपमरूपाख्यमनुत्तमम् ।\nविश्वस्वरूपवैरूप्यलक्षणं परमात्मनः  ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001063054, "chapter_id": 21063, "verse_number": "६-७-५५", "content_sanskrit": "न तद्योगयुजा शक्यं नृप चिंतयितुं यतः ।\nततस्स्थूलं हरे रूपं चिंतयेद्विश्वगोचरम्  ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001063055, "chapter_id": 21063, "verse_number": "६-७-५६", "content_sanskrit": "हिरण्यगर्भो भगवान्वासुदेवः प्रजापतिः ।\nमरुतो वसवो रुद्रा  भास्करास्तारका ग्रहाः  ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001063056, "chapter_id": 21063, "verse_number": "६-७-५७", "content_sanskrit": "गंधर्वयक्षदैत्याद्यस्सकला देवयोनयः ।\nमनुष्याः पशवश्शैलास्समुद्रा स्सरितो द्रु माः  ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001063057, "chapter_id": 21063, "verse_number": "६-७-५८", "content_sanskrit": "भूप भूतान्यशेषाणि भूतानां ये च हेतवः\nप्रधानादिविशेषांतं चेतनाचेतनात्मकम्  ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001063058, "chapter_id": 21063, "verse_number": "६-७-५९", "content_sanskrit": "एकपादं द्विपादं च बहुपादमपादकम् ।\nमूर्त्तमेतद्धरे रूपं भावनात्रितयात्मकम्  ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001063059, "chapter_id": 21063, "verse_number": "६-७-६०", "content_sanskrit": "एतत्सर्वमिदं विश्वं जगदेतच्चराचरम् ।\nपरब्रह्मस्वरूपस्य विष्णोश्शक्तिसमन्वितम्  ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001063060, "chapter_id": 21063, "verse_number": "६-७-६१", "content_sanskrit": "विष्णुशक्तिः परा प्रोक्ता क्षेत्रज्ञाख्या तथाऽपरा ।\nअविद्याकर्मसंज्ञान्या तृतीया शक्तिरिष्यते  ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001063061, "chapter_id": 21063, "verse_number": "६-७-६२", "content_sanskrit": "यया क्षेत्रज्ञशक्तिस्सा वेष्टिता नृपसर्वगा ।\nसंसारतापानखिलानवाप्नोत्यतिसंततान्  ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001063062, "chapter_id": 21063, "verse_number": "६-७-६३", "content_sanskrit": "तया तिरोहितत्वाच्च शक्तिः क्षेत्रज्ञसंज्ञिता ।\nसर्वभूतेषु भूपाल तारतम्येन लक्ष्यते  ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001063063, "chapter_id": 21063, "verse_number": "६-७-६४", "content_sanskrit": "अप्राणवत्सुस्वल्पा सा स्थावरेषु ततोऽधिका ।\nसरीसृपेषु तेभ्योपि ह्यतिशक्त्या पतत्त्रिषु  ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001063064, "chapter_id": 21063, "verse_number": "६-७-६५", "content_sanskrit": "पतत्त्रिभ्यो मृगास्तेभ्यस्तच्छक्त्या पशवोऽधिकाः ।\nपशुभ्यो मनुजाश्चातिशक्त्या पुंसः प्रभाविताः  ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001063065, "chapter_id": 21063, "verse_number": "६-७-६६", "content_sanskrit": "तेभ्योपि नागगंधर्वयक्षाद्या देवता नृप  ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001063066, "chapter_id": 21063, "verse_number": "६-७-६७", "content_sanskrit": "शक्रस्समस्तदेवेभ्यस्ततश्चातिप्रजापतिः ।\nहिरण्यगर्भोऽपि ततः पुंसश्शक्त्युपलक्षितः  ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001063067, "chapter_id": 21063, "verse_number": "६-७-६८", "content_sanskrit": "एतान्यशेषरूपाणि तस्य रूपाणि पार्थिव ।\nयतस्तच्छक्तियोगेन युक्तानि नभसा यथा  ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001063068, "chapter_id": 21063, "verse_number": "६-७-६९", "content_sanskrit": "द्वितीयं विष्णुसंज्ञस्य योगिध्येयं महामते ।\nअमूर्त्तं ब्रह्मणो रूपं यत्सदित्युच्यते बुधैः  ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001063069, "chapter_id": 21063, "verse_number": "६-७-७०", "content_sanskrit": "समस्ताश्शक्तयश्चैता नृप यत्र प्रतिष्ठिताः ।\nतद्विश्वरूप्यं रूपमन्यद्धरेर्महत्  ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001063070, "chapter_id": 21063, "verse_number": "६-७-७१", "content_sanskrit": "समस्तशक्तिरूपाणि तत्करोति जनेश्वर ।\nदेवतिर्यङ्मनुष्यादिचेष्टावंति स्वलीलया  ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001063071, "chapter_id": 21063, "verse_number": "६-७-७२", "content_sanskrit": "जगतामुपकाराय न सा कर्मनिमित्तजा ।\nचेष्टा तस्याप्रमेयस्य व्यापिन्यव्याहतात्मिका  ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001063072, "chapter_id": 21063, "verse_number": "६-७-७३", "content_sanskrit": "तद्रूपं विश्वरूपस्य तस्य योगयुजा नृप ।\nचिंत्यमात्मविशुद्ध्यर्थं सर्वकिल्बिषनाशनम्  ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001063073, "chapter_id": 21063, "verse_number": "६-७-७४", "content_sanskrit": "यथाग्निरुद्धतशिखः कक्षं दहति सानिलः ।\nतथा चित्तस्थितो विष्णुर्योगिनां सर्वकिल्बिषम्  ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001063074, "chapter_id": 21063, "verse_number": "६-७-७५", "content_sanskrit": "तस्मात्समस्तशक्तीनामाधारे तत्र चेतसः ।\nकुर्वीत संस्थितिं सा तु विज्ञेया शुद्धधारणा  ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001063075, "chapter_id": 21063, "verse_number": "६-७-७६", "content_sanskrit": "शुभाश्रयस्य चित्तस्य सर्वगस्याचलात्मनः ।\nत्रिभावभावनातीतो मुक्तये योगिनो नृप  ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001063076, "chapter_id": 21063, "verse_number": "६-७-७७", "content_sanskrit": "अन्ये तु पुरुषव्याघ्र चेतसो ये व्यपाश्रयाः ।\nअशुद्धास्ते समस्तास्तु देवाद्याः कर्मयोनयः  ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001063077, "chapter_id": 21063, "verse_number": "६-७-७८", "content_sanskrit": "मूर्त्तं भगवतो रूपं सर्वापाश्रयनिस्पृहम् ।\nएषा वै धारण प्रोक्ता यच्चित्तं तत्र धार्यते  ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001063078, "chapter_id": 21063, "verse_number": "६-७-७९", "content_sanskrit": "यच्च मूर्त्तं हरे रूपं यादृक् चिंत्यं नराधिप ।\nतच्छ्रूयतामनाधारा धारणा नोपपद्यते  ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001063079, "chapter_id": 21063, "verse_number": "६-७-८०", "content_sanskrit": "प्रसन्नवदनं चारुपद्मपत्रोपमेक्षणम् ।\nसुकपोलं सुविस्तीर्णललाटफकोज्ज्वलम्  ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001063080, "chapter_id": 21063, "verse_number": "६-७-८१", "content_sanskrit": "समकर्णांतविन्यस्तचारुकुंडलभूषणम् ।\nकंबुग्रीवं सुवीस्तीर्णश्रीवत्सांकितवक्षसम्  ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001063081, "chapter_id": 21063, "verse_number": "६-७-८२", "content_sanskrit": "वलित्रिभंगिना मग्ननाभिना ह्युदरेण च\nप्रलंबाष्टभुजं विष्णुमथवापि चतुर्भुजम्  ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001063082, "chapter_id": 21063, "verse_number": "६-७-८३", "content_sanskrit": "समस्थितोरुजंघं च सुस्थितांघ्रिवरांबुजम् ।\nचिंतयेद्ब्रह्मभूतं तं पीतनिर्मलवाससम्  ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001063083, "chapter_id": 21063, "verse_number": "६-७-८४", "content_sanskrit": "किरीटहारकेयूरकटकादिविभूषितम्  ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001063084, "chapter_id": 21063, "verse_number": "६-७-८५", "content_sanskrit": "शार्ङ्गशंखगदाखड्गचक्राक्षवलयान्वितम् ।\nवरदाभयहस्तं च मुद्रि कारत्नभूषितम्  ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7001063085, "chapter_id": 21063, "verse_number": "६-७-८६", "content_sanskrit": "चिंतयेत्तन्मयो योगी समाधायात्ममानसम् ।\nतावद्यावद्दृढीभूता तत्रैव नृप धारणा  ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7001063086, "chapter_id": 21063, "verse_number": "६-७-८७", "content_sanskrit": "व्रजतस्तिष्ठतोन्यद्वा स्वेच्छया कर्म कुर्वतः ।\nनापयाति यदा चित्तात्सिद्धां मन्येत तां तदा  ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7001063087, "chapter_id": 21063, "verse_number": "६-७-८८", "content_sanskrit": "ततः शंखगदाचक्रशार्ङ्गादिरहितं बुधः\nचिंतयेद्भगवद्रू पं प्रशांतं साक्षसूत्रकम्  ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7001063088, "chapter_id": 21063, "verse_number": "६-७-८९", "content_sanskrit": "सा यदा धारणा तद्वदवस्थानवती ततः ।\nकिरीटकेयूरमुखैर्भूषणै रहितं स्मरेत्  ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7001063089, "chapter_id": 21063, "verse_number": "६-७-९०", "content_sanskrit": "तदेकावयवं देवं चेतसा हि पुनर्बुधः ।\nकुर्यात्ततोऽवयविनि प्रणिधानपरो भवेत्  ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7001063090, "chapter_id": 21063, "verse_number": "६-७-९१", "content_sanskrit": "तद्रूपप्रत्यया चैका संततिश्चान्यनिःस्पृहा ।\nतद्ध्यानं प्रथमैरंगैः षड्भिर्निष्पाद्यते नृप  ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7001063091, "chapter_id": 21063, "verse_number": "६-७-९२", "content_sanskrit": "तस्यैव कल्पनाहीनं स्वरूपग्रहणं हि यत् ।\nमनसा ध्याननिष्पाद्यं समाधिस्सोऽभिधीयते  ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7001063092, "chapter_id": 21063, "verse_number": "६-७-९३", "content_sanskrit": "विज्ञानं प्रापकं प्राप्ये परे ब्रह्मणि पार्थिव ।\nप्रापणीयस्तथैवात्मा प्रक्षीणाश्षोभावनः  ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7001063093, "chapter_id": 21063, "verse_number": "६-७-९४", "content_sanskrit": "क्षेत्रज्ञः करणी ज्ञानं करणं तस्य तेन तत् ।\nनिष्पाद्य मुक्तिकार्यं वै कृतकृत्यं निवर्त्तते  ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7001063094, "chapter_id": 21063, "verse_number": "६-७-९५", "content_sanskrit": "तद्भावभावमापन्नस्ततोऽसौ परमात्मना\nभवत्यभेदी भेदश्च तस्याज्ञानकृतो भवेत्  ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7001063095, "chapter_id": 21063, "verse_number": "६-७-९६", "content_sanskrit": "विभेदजनके ज्ञाने नाशमात्यंतिकं गते ।\nआत्मनो ब्रह्मणो भेदमसंतं कः करिष्यति  ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7001063096, "chapter_id": 21063, "verse_number": "६-७-९७", "content_sanskrit": "इत्युक्तस्ते मया योगः खांडिक्य परिपृच्छतः ।\nसंक्षेपविस्तराभ्यां तु किमन्यत्क्रियतां तव  ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7001063097, "chapter_id": 21063, "verse_number": "६-७-९८", "content_sanskrit": "खांडिक्य उवाच\nकथिते योगसद्भावे सर्वमेव कृतं मम ।\nतवोपदेश्नोआ!श्षोओ! नष्टश्चित्तमलो यतः  ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7001063098, "chapter_id": 21063, "verse_number": "६-७-९९", "content_sanskrit": "ममेति यन्मया चोक्तमसदेतन्न चान्यथा ।\nनरेंद्र  गदितुं शक्यमपि विज्ञेयवेदिभिः  ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7001063099, "chapter_id": 21063, "verse_number": "६-७-१००", "content_sanskrit": "अहं ममेत्यविद्येयं व्यवहारस्तथानयोः ।\nपरमार्थस्त्वसंलापो गोचरे वचसां न यः  ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7001063100, "chapter_id": 21063, "verse_number": "६-७-१०१", "content_sanskrit": "तद्गच्छ श्रेयसे सर्वं ममैतद्भवता कृतम् ।\nयद्विमुक्तिप्रदो योगः प्रोक्तः केशिध्वजाऽव्ययः  ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7001063101, "chapter_id": 21063, "verse_number": "६-७-१०२", "content_sanskrit": "श्रीपराशर उवाच\nयथार्हं पूजया तेन खांडिक्येन स पूजितः ।\nआजगाम पुरं ब्रह्मंस्ततः केशिध्वजो नृपः  ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7001063102, "chapter_id": 21063, "verse_number": "६-७-१०३", "content_sanskrit": "खांडिक्योऽपि सुतं कृत्वा राजानं योगसिद्धये ।\nवनं जगाम गोविंदे विनिवेशितमानसः  ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7001063103, "chapter_id": 21063, "verse_number": "६-७-१०४", "content_sanskrit": "तत्रैकांतमतिर्भूत्वा यमादिगुणसंयुतः ।\nविष्ण्वाख्ये निर्मले ब्रह्मण्यवाप नृपतिर्लयम्  ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7001063104, "chapter_id": 21063, "verse_number": "६-७-१०५", "content_sanskrit": "केशिध्वजो विमुक्त्यर्थं स्वकर्मक्षपणोन्मुखः\nबुभुजे विषयान्कर्म चक्रे चानभिसंहितम्  ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7001063105, "chapter_id": 21063, "verse_number": "६-७-१०६", "content_sanskrit": "अकल्याणोपभोगैश्च क्षीणपापोऽमलस्तथा ।\nअवाप सिद्धिमत्यंतां तापक्षयफलां द्विज  ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}]