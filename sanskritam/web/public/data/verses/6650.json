  {
    "id": 20007492,
    "chapter_id": 6650,
    "verse_number": "20.73",
    "content_sanskrit": "प्रयतः प्रशमं हुताशनस्य क्वचिदालक्ष्यत मुक्तमूलमर्चिः । बलभित्प्रहितायुधाभिघातात्त्रुटितं पत्रिपतेरिवैकपत्रम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 73,
    "avatarnika": ""
