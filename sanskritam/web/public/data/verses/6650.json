  {
    "id": 20007494,
    "chapter_id": 6650,
    "verse_number": "20.75",
    "content_sanskrit": "कृतदाहमुदर्चिषः शिखाभिः परिषिक्तं मुहुरम्भसा नवेन । विहिताम्बुधरव्रणं प्रपेदे गगनं तापितपायितासिलक्ष्मीम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 75,
    "avatarnika": ""
  },
  {
    "id": 20007495,
    "chapter_id": 6650,
    "verse_number": "20.76",
    "content_sanskrit": "इति नरपतिरस्त्रं यद्यदाविश्चकार प्रकुपित इव रोगः क्षिप्रकारी विकारम् । भिषगिव गुरुदोषच्छेदिनोपक्रमेण क्रमविदथ मुरारिः प्रत्यहंस्तत्तदाशु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 76,
    "avatarnika": ""
  },
  {
    "id": 20007496,
    "chapter_id": 6650,
    "verse_number": "20.77",
    "content_sanskrit": "शुद्धिं गतैरपि परामृजुभिर्विदित्वा बाणैरजय्यमविघट्टितमर्मभिस्तम् । मर्मातिगैरनृजुभिर्नितरामशुद्धैर्वाक्सायकैरथ तुतोद तदा विपक्षः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 77,
    "avatarnika": ""
