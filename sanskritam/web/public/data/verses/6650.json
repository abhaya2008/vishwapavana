  {
    "id": 20007490,
    "chapter_id": 6650,
    "verse_number": "20.71",
    "content_sanskrit": "मधुरैरपि भूयसा स मेध्यैः प्रथमं प्रत्युत वारिभिर्दिदीपे । पवमानसखस्ततः क्रमेण प्रणयक्रोध इवाशमद्विवादैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "avatarnika": ""
  },
  {
    "id": 20007491,
    "chapter_id": 6650,
    "verse_number": "20.72",
    "content_sanskrit": "परितः प्रसभेन नीयमानः शरवर्षैरवसायमाश्रयाशः । प्रबलेषु कृती चकार विद्युद्व्यपदेशेन घनेष्वनुप्रवेशम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "avatarnika": ""
