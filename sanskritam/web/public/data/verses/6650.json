  {
    "id": 20007497,
    "chapter_id": 6650,
    "verse_number": "20.78",
    "content_sanskrit": "राहुस्त्रीस्तनयोरकारि सहसा येनाश्लथालिङ्गनव्यापारैकविनोददुर्ललितयोः कार्कश्यलक्ष्मीर्वृथा । तेनाक्रोशत एव तस्य मुरजित्तत्काललोलानलज्वालापल्लवितेन मूर्धविकलं चक्रेण चक्रे वपुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 78,
    "avatarnika": ""
