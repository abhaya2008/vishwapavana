  {
    "id": 20007493,
    "chapter_id": 6650,
    "verse_number": "20.74",
    "content_sanskrit": "व्यगमन्सहसा दिशां मुखेभ्यः शमयित्वा शिखिनाङ्घनाघनौघाः । उपकृत्यनिसर्गतः परेषामुपरोधं न हि कुर्वते महान्तः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74,
    "avatarnika": ""
