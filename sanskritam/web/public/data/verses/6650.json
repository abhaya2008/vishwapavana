[
  {
    "id": 20007420,
    "chapter_id": 6650,
    "verse_number": "20.1",
    "content_sanskrit": "मुखमुल्लसितत्रिरेखमुच्चैर्भिदुरभ्रूयुगभीषणं दधानः । समिताविति विक्रमानमृष्यन्गतभीराह्वतचेदिराण्मुरारिम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20007421,
    "chapter_id": 6650,
    "verse_number": "20.2",
    "content_sanskrit": "शितचक्रनिपातसंप्रतीक्ष्यं वहतः स्कन्धगतं च तस्य मृत्युम् । अभिशौरि रथोऽथनोदिताश्वः प्रययौ सारथिरूपया नियत्या ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20007422,
    "chapter_id": 6650,
    "verse_number": "20.3",
    "content_sanskrit": "अभिचैद्यमगाद्रथोऽपि शौरेरवनिं जागुडकुङ्कुमाभिताम्रैः । गुरनेमिनिपीडनावदीर्णव्यसुदेहस्रुतशोणितैर्विलिम्पन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20007423,
    "chapter_id": 6650,
    "verse_number": "20.4",
    "content_sanskrit": "स निरायतकेतनांशुकान्तः कलनिक्वाणकरालकिङ्किणीकः । विरराज रिपुक्षयप्रतिज्ञामुखरो मुक्तशिखः स्वयं नु मृत्युः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20007424,
    "chapter_id": 6650,
    "verse_number": "20.5",
    "content_sanskrit": "सजलाम्बुधरारवानुकारी ध्वनिरापूरितदिङ्मुखो रथस्य । प्रगुणीकृतकेकमूर्ध्वकण्ठैः शितिकण्ठैरुपकर्णयाम्बभूवे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20007425,
    "chapter_id": 6650,
    "verse_number": "20.6",
    "content_sanskrit": "अभिवीक्ष्य विदर्भराजपुत्रीकुचकाश्मीरजचिह्नमच्युतोरः । चिरसेवितयापि चेदिराजः सहसावाप रुषा तदैव योगम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20007426,
    "chapter_id": 6650,
    "verse_number": "20.7",
    "content_sanskrit": "जनिताशनिशब्दशङ्कमुच्चैर्धनुरास्फालितमध्वनन्नृपेण । चपलानिलचोद्यमानकल्पक्षयकालाग्निशिखानिभस्फुरज्ज्यम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20007427,
    "chapter_id": 6650,
    "verse_number": "20.8",
    "content_sanskrit": "समकालमिवाभिलक्षणीयग्रहसंधानविकर्षणापवर्गैः । अथ साभिसारं शरैस्तरस्वी स तिरस्कर्तुमुपेन्द्रमध्यवर्षत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20007428,
    "chapter_id": 6650,
    "verse_number": "20.9",
    "content_sanskrit": "ऋजुताफलयोगशुद्धिभाजां गुरुपक्षाश्रयिणां शिलीमुखानाम् । गुणिना नतिमागतेन सन्धिः सह चापेन समञ्जसो बभूव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20007429,
    "chapter_id": 6650,
    "verse_number": "20.10",
    "content_sanskrit": "अविषह्यतमे कृताधिकारं वशिना कर्मणि चेदिपार्थिवेन । अरसद्धनुरुच्चकैदृढार्तिप्रसभाकर्षणवेपमानजीवम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20007430,
    "chapter_id": 6650,
    "verse_number": "20.11",
    "content_sanskrit": "अनुसन्ततिपातिनः पटुत्वं दधतः शुद्धिभृतो गृहीतपक्षाः । वदनादिव वादिनोऽथ शब्दाः क्षितिभर्तुर्धनुषः शराः प्रसस्रुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20007431,
    "chapter_id": 6650,
    "verse_number": "20.12",
    "content_sanskrit": "गवलासितकान्ति तस्य मध्यस्थितघोरायतबाहुदण्डनासम् । ददृशे कुपितान्तकोन्न्मद्भ्रूयुगभीमाकृति कार्मुकं जनेन ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20007432,
    "chapter_id": 6650,
    "verse_number": "20.13",
    "content_sanskrit": "तडिदुज्ज्वलजातरूपपुङ्खैः खमयःश्याममुखैरभिध्वनद्भिः । जलदैरिव रंहसा पतद्भिः पिदधे संहतिशालिभिः शरौघैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20007433,
    "chapter_id": 6650,
    "verse_number": "20.14",
    "content_sanskrit": "शितशल्यमुखावदीर्णमेघक्षरदम्भः स्फुटतीव्रवेदनानाम् । स्रवदस्रुततीव चक्रवालं ककुभामौर्णविषुः सुवर्णपुङ्खाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20007434,
    "chapter_id": 6650,
    "verse_number": "20.15",
    "content_sanskrit": "अमनोरमतां यती जनस्य क्षणमालोकपथान्नभः सदां वा । रुरुधे पिहिताहिमद्युतिर्धीर्विशिखैरन्तरिता च्युता धरित्रत्री ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20007435,
    "chapter_id": 6650,
    "verse_number": "20.16",
    "content_sanskrit": "विनिवारितभानुतापमेकं सकलस्यापि मुरद्विषो बलस्य । शरजालमयं समं समन्तादुरु सद्मेव नराधिपेन तेने ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20007436,
    "chapter_id": 6650,
    "verse_number": "20.17",
    "content_sanskrit": "इति चेदिमहीभृता तदानीं तदनीकं दनुसूनुसूदनस्य । वयसमिव चक्रमक्रियाकं परितोऽरोधि विपाटपञ्चरेण ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20007437,
    "chapter_id": 6650,
    "verse_number": "20.18",
    "content_sanskrit": "इषुवर्षमनेकमेकवीरस्तदरिप्रच्युतमच्युतः पृषत्कैः । अथ वादिकृतं प्रमाणमन्यैः प्रतिवादीव निराकरोत्प्रमाणैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20007438,
    "chapter_id": 6650,
    "verse_number": "20.19",
    "content_sanskrit": "प्रतिकुञ्चितकूर्परेण तेन श्रवणोपान्तिकनीयमानगव्यम् । ध्वनति स्म धनुर्घनान्तमत्तप्रचुरक्रौञ्चरवानुकारमुच्चैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20007439,
    "chapter_id": 6650,
    "verse_number": "20.20",
    "content_sanskrit": "उरसा विततेन पातितांसः स मयूराञ्चितमस्तकस्तदानीम् । क्षणमालिखितो नु सौष्ठवेन स्थिरपूर्वापरमुष्टिराबभौ वा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20007440,
    "chapter_id": 6650,
    "verse_number": "20.21",
    "content_sanskrit": "ध्वनतो नितरां रयेण गुर्व्यस्तडिदाकारचलद्गुणादसंख्याः । इषवो धनुषः सशब्दमाशु न्यपतन्नम्बुधरादिवाम्बुधराः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20007441,
    "chapter_id": 6650,
    "verse_number": "20.22",
    "content_sanskrit": "शिखरोन्नतनिष्ठुरांसपीठः स्थगयन्नेकदिगन्तमायतान्तः । निरवर्णि सकृत्प्रसारितोऽस्य क्षितिभर्तेव चमूभिरेकबाहुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20007442,
    "chapter_id": 6650,
    "verse_number": "20.23",
    "content_sanskrit": "तमकुण्ठमुखाः सुपर्णकेतोरिषवः क्षिप्तमिषुव्रजं परेण । विभिदामनयन्त कृत्यपक्षं नृपतेर्नेतुरिवायथार्थवर्णाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20007443,
    "chapter_id": 6650,
    "verse_number": "20.24",
    "content_sanskrit": "दयितैरिव खण्डिता मुरारेर्विशिखैः संमुखमुज्ज्वलाङ्गलेखैः । लघिमानमुपेयुषी पृथिव्यां विफला शत्रुशरावलिः पपात ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20007444,
    "chapter_id": 6650,
    "verse_number": "20.25",
    "content_sanskrit": "प्रमुखेऽभिहताश्च पत्रवाहाः प्रसभं माधवमुक्तवत्सदन्तैः । परिपूर्णतरं भुवो गतायाः परतः कातरवत्प्रतीपमीयुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20007445,
    "chapter_id": 6650,
    "verse_number": "20.26",
    "content_sanskrit": "इतरेतरत्सन्निकर्षजन्मा गलसंघट्टविकीर्णविस्फुलिङ्गः । पटलानि लिहन्वलाहकानामपरेषु क्षणमज्ज्वलत्कृशानुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20007446,
    "chapter_id": 6650,
    "verse_number": "20.27",
    "content_sanskrit": "शरदीव शरश्रिया विभिन्ने विभुना शत्रुशिलीमुखाभ्रजाले । विकसन्मुखवारिजाः प्रकामं बभुराशा इव यादवध्वजिन्यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20007447,
    "chapter_id": 6650,
    "verse_number": "20.28",
    "content_sanskrit": "स दिवं समचिच्छदच्छरौघैः कृततिग्मद्युतिमण्डलापलापैः । ददृशेऽथ च तस्य चापयष्ट्यामिषुरेकैव जनै सकृद्विसृष्टा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20007448,
    "chapter_id": 6650,
    "verse_number": "20.29",
    "content_sanskrit": "भवति स्फुटमागतो विपक्षान्न सपक्षोऽपि हि निर्वृतेर्विधाता । शिशुपालबलानि कृष्णमुक्तः सुतरां तेन तताप तोमरौघः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20007449,
    "chapter_id": 6650,
    "verse_number": "20.30",
    "content_sanskrit": "गुरुवेगविराविभिः पतत्रैरिषवः काञ्चनपिङ्गलभासः । विनतासुतवत्तलं भुवः स्म व्यथितभ्रान्तभुजङ्गमं विशन्ति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20007450,
    "chapter_id": 6650,
    "verse_number": "20.31",
    "content_sanskrit": "शतशः परुषाः पुरो विशङ्कं शिशुपालेन शिलीमुखाः प्रयुक्ताः । परमर्मभिदोऽपि दानवारेरपराधा इव न व्यथां वितेनुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20007451,
    "chapter_id": 6650,
    "verse_number": "20.32",
    "content_sanskrit": "विहिताद्भुतलोकसृष्टिमाये जममिच्छन्किल मायया मुरारौ । भुवनक्षयकालयोगनिद्रे नृपतिः स्वापनमस्त्रमाजहार ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20007452,
    "chapter_id": 6650,
    "verse_number": "20.33",
    "content_sanskrit": "सलिलार्द्रवराहदेहनीलो विदधद्भास्करमर्थशून्यसंज्ञम् । प्रचलायतलोचनारविन्दं विदधे तद्बलमन्धकारः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20007453,
    "chapter_id": 6650,
    "verse_number": "20.34",
    "content_sanskrit": "गुरवोऽपि निषद्य यन्निदद्रुर्धनुषि क्ष्मापतयो न वाच्यमेतत् । क्षयितापदि जाग्रतोऽपि नित्यं ननु तत्रैव हि तेऽभवन्निषण्णाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20007454,
    "chapter_id": 6650,
    "verse_number": "20.35",
    "content_sanskrit": "श्लथतां व्रजतस्तथा परेषामगद्धारणाशक्तिमुज्झतः स्वाम् । सुगृहीतमपि प्रमदभाजां मनसः शास्त्रमिवामस्त्रमग्रपाणेः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20007455,
    "chapter_id": 6650,
    "verse_number": "20.36",
    "content_sanskrit": "उचितस्वपनोऽपि नीरराशौ स्वबलाम्भोनिधिमध्यगस्तदीनीम् । भुवनत्रयकार्यजागरूकः स परं तत्र परः पुमानजागः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20007456,
    "chapter_id": 6650,
    "verse_number": "20.37",
    "content_sanskrit": "अथसूर्यरुचीव तस्य दृष्टावुद्भूत्कौस्तुभदर्पणं गतायाम् । पटुः धाम ततो न चाद्भुतं तद्विभुरिन्द्वर्कविलोचनः किलासौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20007457,
    "chapter_id": 6650,
    "verse_number": "20.38",
    "content_sanskrit": "महतः प्रणतेष्विव प्रसादः स मणेरंशुचयः ककुंमुखेषु । व्यकसद्विकसद्विलोचनेभ्यो दददालोकमनाविलं बलेभ्यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20007458,
    "chapter_id": 6650,
    "verse_number": "20.39",
    "content_sanskrit": "प्रकृतिं प्रतिपादुकैश्च पादैश्चकॢषे भानुमतः पुनः प्रसर्तुम् । तमसोऽभिभवादपास्य मूर्च्छामुपजीवत्सहसैव जीवलोकः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20007459,
    "chapter_id": 6650,
    "verse_number": "20.40",
    "content_sanskrit": "घनसंतमसैर्जवेन भूयो यदुयोधैर्युधि रेधिरे द्विषन्तः । ननु वारिधरोपरोधमुक्तः सुतरामुत्तपते पतिः प्रभाणाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20007460,
    "chapter_id": 6650,
    "verse_number": "20.41",
    "content_sanskrit": "व्यवहार इवानृताभियोगं तिमिरं निर्जितवत्यथप्रकाशे । रिपुरुल्बणभीमभोगभाजां भुजगानां जननीं जजाप विद्याम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20007461,
    "chapter_id": 6650,
    "verse_number": "20.42",
    "content_sanskrit": "पृथुदर्विभृतस्ततः फणीन्द्रा विषमाशीभिरनारतं वमन्तः । अभवन्युगपद्विलोलजिह्वायुगलीढोभयसृक्कभागमाविः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20007462,
    "chapter_id": 6650,
    "verse_number": "20.43",
    "content_sanskrit": "कृतकेशविडम्बनैर्विहायो विजयं तत्क्षणमिच्छुभिश्छलेन । अमृताग्रभुवः पुरेव पुच्छं बडवाभर्तुरवारि काद्रवेयैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20007463,
    "chapter_id": 6650,
    "verse_number": "20.44",
    "content_sanskrit": "दधतस्तनिमानमानपूर्व्या बभुरक्षिश्रवसो मुखे विशालाः । भरतज्ञकविप्रणीतकाव्यग्रथिताङ्का इव नाटकप्रपञ्चाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20007464,
    "chapter_id": 6650,
    "verse_number": "20.45",
    "content_sanskrit": "सविषश्वसनोद्धतोरुधूमव्यवधिम्लानमरीचि पन्नगानाम् । उपरागवतेव तिग्मभासा वपुरौदुम्बरमण्डलाभमूहे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20007465,
    "chapter_id": 6650,
    "verse_number": "20.46",
    "content_sanskrit": "शिखिपिच्छकृतध्वजावचूडक्षणसाशङ्कविवर्तमानभोगाः । यमपाशवदाशुबन्धनाय न्यपतन्वृष्णिगणेषु लेलिहानाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20007466,
    "chapter_id": 6650,
    "verse_number": "20.47",
    "content_sanskrit": "पृथुवारिधिवीचिमण्डलान्तर्विलसत्फेनवितानपाण्डुराणि । दधति स्म भुजङ्गमाङ्गमध्ये नवनिर्मोकरुचिं ध्वजांशुकानि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20007467,
    "chapter_id": 6650,
    "verse_number": "20.48",
    "content_sanskrit": "कृतमण्डलबन्धमुल्लसद्भिः शिरसि प्रत्युरसं विलम्बमानैः । व्यरुचज्जनता भुजङ्गभोगैर्दलितेन्दीवरमालभारिणीव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20007468,
    "chapter_id": 6650,
    "verse_number": "20.49",
    "content_sanskrit": "परिवेष्टितमूर्तयश्च मूलादुरगैराशिरसः सरत्नपुष्पैः । दधुरायतवल्लिवेष्टितानामुपमानं मनुजा महीरुहाणाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20007469,
    "chapter_id": 6650,
    "verse_number": "20.50",
    "content_sanskrit": "बहुलाञ्जनपङ्कपट्टनीलद्युतयो देहमितस्ततः श्रमन्तः । दधिरे फणिनस्तुरङ्गमेषु स्फुटपल्याणनिबद्धवर्ध्रलीलाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20007470,
    "chapter_id": 6650,
    "verse_number": "20.51",
    "content_sanskrit": "प्रसृतं रभसादयोभिनीला प्रतिपदं परितोऽभिवेष्टयन्ती । तनुरायतिशालिनी महाहेर्गजमन्दुरिव निश्चलं चकार ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20007471,
    "chapter_id": 6650,
    "verse_number": "20.52",
    "content_sanskrit": "अथ सस्मितवीक्षितादवज्ञाचलितैकोन्नमितभ्रु माधवेन । निजकेतुशिरःश्रितः सुपर्णादुदपप्तन्नयुतानि पक्षिराजाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20007472,
    "chapter_id": 6650,
    "verse_number": "20.53",
    "content_sanskrit": "द्रुतहेमरुचः खगाः खगेन्द्रादलघूदीरितनादमुत्पतन्तः । क्षणमैक्षिषतोच्चकैश्चमूभिर्ज्वलतः सप्तरुचेरिव स्फुलिङ्गाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20007473,
    "chapter_id": 6650,
    "verse_number": "20.54",
    "content_sanskrit": "उपमानमलाभि लोलपक्षक्षणविक्षिप्तमहाम्बुवाहमत्स्यैः । गगनार्णवमन्तरासुमेरोः कुलजानां गरुडैरिलाधराणाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20007474,
    "chapter_id": 6650,
    "verse_number": "20.55",
    "content_sanskrit": "पततां परितः परिस्फुरद्भिः परिपिङ्गीकृतदिङ्मुखैर्मयूखैः । सुतरामभवदद्दुरीक्ष्यबिम्बस्तपनस्तत्किरणैरिवात्मदर्शः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20007475,
    "chapter_id": 6650,
    "verse_number": "20.56",
    "content_sanskrit": "दधुरम्बुधिमन्थनाद्रिमन्थभ्रमणायस्तफणीन्द्रपित्तजानाम् । रुचमुल्लसमानवैनतेयद्युतिभिन्नाः फणभारिणो मणीनाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20007476,
    "chapter_id": 6650,
    "verse_number": "20.57",
    "content_sanskrit": "अभितः क्षुभिताम्बुराशिधीरध्वनिराकृष्टसमूलपादपौघः । जनयन्नभवद्युगान्तशङ्कामनिलो नागविपक्षपक्षजन्मा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20007477,
    "chapter_id": 6650,
    "verse_number": "20.58",
    "content_sanskrit": "प्रचलत्पतगेन्द्रपत्रवातप्रसभोन्मूलितशैलदत्तमार्गैः । भयविह्वलमाशु दन्दशूकैर्विवशैराविविशे स्वमेव धाम ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20007478,
    "chapter_id": 6650,
    "verse_number": "20.59",
    "content_sanskrit": "खचरैः क्षयमक्षयेऽहिसैन्ये सुकृतैर्दुष्कृतवत्तदोपनीते । अयुगाचिरिव ज्वलन्रुषाथो रिपुरौदर्चिषमाजुहाव मन्त्रम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20007479,
    "chapter_id": 6650,
    "verse_number": "20.60",
    "content_sanskrit": "सहसा दधदुद्धताट्टहासश्रियमुत्त्रासितजन्तुना स्वनेन । वियतायतहेतिबाहुरुच्चैरथ वेताल इवोत्पपात वह्निः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20007480,
    "chapter_id": 6650,
    "verse_number": "20.61",
    "content_sanskrit": "चलितोद्धतधूमकेतनोऽसौ रभसादम्बररोहिरोहिताश्वः । द्रुतमारुतसारथिः शिखावान्कनकस्यन्दनसुन्दरश्चचाल ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20007481,
    "chapter_id": 6650,
    "verse_number": "20.62",
    "content_sanskrit": "ज्वलदम्बरकोटरान्तरालं बहुलार्द्राम्बुदपत्रबद्धधूमम् । परिदीपितदीर्घकाष्ठमुच्चैस्तरुवद्विश्वमुवोष जातवेदाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20007482,
    "chapter_id": 6650,
    "verse_number": "20.63",
    "content_sanskrit": "गुरुतापविशुष्यदम्बुशुभ्राः क्षणमालग्नकृशानुताम्रभासः । स्वमसारतया मषीभवन्तः पुनराकारमवापुराम्बुवाहाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20007483,
    "chapter_id": 6650,
    "verse_number": "20.64",
    "content_sanskrit": "ज्वलितानललोलपल्लवान्ताः स्फुरदष्टापदपत्रपीतभासः । क्षणमात्रभवामभावकाले सुतरामापुरिवायतिं पताकाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20007484,
    "chapter_id": 6650,
    "verse_number": "20.65",
    "content_sanskrit": "निखिलामिति कुर्वतश्चिरायद्रुतचामीकरचारुतामिव द्याम् । प्रतिघातसमर्थमस्त्रमग्नेरथ मेघङ्करमस्मरन्मुरारिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20007485,
    "chapter_id": 6650,
    "verse_number": "20.66",
    "content_sanskrit": "चतुरम्बुधिगर्भधीरकुक्षेर्वपुषः सन्धिषु लीनसर्वसिन्धोः । उदगुः सलिलात्मनस्त्रिधाम्नो जलवाहावलयः शिरोरुहेभ्यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20007486,
    "chapter_id": 6650,
    "verse_number": "20.67",
    "content_sanskrit": "ककुभः कृतनादमास्तृणन्तस्तिरयन्तः पटलानि भानुभासम् । उदनंसिषुरभ्रमभ्रसङ्घाः सपदि श्यामलिमानमानयन्तः ॥",
