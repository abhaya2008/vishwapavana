  {
    "id": 20007489,
    "chapter_id": 6650,
    "verse_number": "20.70",
    "content_sanskrit": "ज्वलतः शमनाय चित्रभानोः प्रलयाप्लावमिवाभिदर्शयन्तः । ववृषुर्वृषनादिनो नदीनां प्रतटारोपितवारि वारिवाहाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
