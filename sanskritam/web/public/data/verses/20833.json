[{"id": 7000833000, "chapter_id": 20833, "verse_number": "६-१७६-१", "content_sanskrit": "श्रीभगवानुवाच ।\nआदिमस्यैवमाख्यानमुदीरितमनुत्तमम् ।\nशृणु माहात्म्यमन्येषामध्यायानामपींदिरे॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000833001, "chapter_id": 20833, "verse_number": "६-१७६-२", "content_sanskrit": "दक्षिणस्यां दिशि श्रीमानासीदाम्नायवादिनाम् ।\nपुरे पुरंदराह्वाने देवशर्मेति विश्रुतः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000833002, "chapter_id": 20833, "verse_number": "६-१७६-३", "content_sanskrit": "अर्चितातिथिराम्नातो वेदशास्त्रविशारदः ।\nआहर्ता क्रतुसंघानां तापसानां प्रियः सदा॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000833003, "chapter_id": 20833, "verse_number": "६-१७६-४", "content_sanskrit": "देवान्संतर्पयामास हव्यैर्हुतवहं चिरम् ।\nन चोपलेभे धर्मात्मा शांतिमेकांतिकीं ततः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000833004, "chapter_id": 20833, "verse_number": "६-१७६-५", "content_sanskrit": "निःश्रेयसं स जिज्ञासुस्तापसाननुवासरम् ।\nसिषेवे सत्यसंकल्पाननल्पैरेव कल्पकैः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000833005, "chapter_id": 20833, "verse_number": "६-१७६-६", "content_sanskrit": "एवमाचरतस्तस्य काले महति गच्छति ।\nमुक्तकर्मा ततः कश्चित्प्रादुरासीत्पुरा भुवि॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000833006, "chapter_id": 20833, "verse_number": "६-१७६-७", "content_sanskrit": "अनुभूतनिराकांक्षी नासाग्रन्यस्तलोचनः ।\nशांतचेताः परं ब्रह्म ध्यायन्नानंदनिर्भरः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000833007, "chapter_id": 20833, "verse_number": "६-१७६-८", "content_sanskrit": "पादौ तस्योपसंगृह्य प्रणतेनांतरात्मना ।\nचकार विधिवत्तस्मै विद्वानतिथिसत्क्रियाम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000833008, "chapter_id": 20833, "verse_number": "६-१७६-९", "content_sanskrit": "तं च शुद्धेन भावेन परितुष्टं तपस्विनम् ।\nप्रणतः परिपप्रच्छ निर्वाणस्थितिमात्मनः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000833009, "chapter_id": 20833, "verse_number": "६-१७६-१०", "content_sanskrit": "स तस्मै कथयामास पुरेऽसौ पुरनामनि ।\nमित्रवंतमजापालमुपदेष्टारमात्मवित्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000833010, "chapter_id": 20833, "verse_number": "६-१७६-११", "content_sanskrit": "स चाभिवंद्य तत्पादावेत्यसौ पुरमूर्जितम् ।\nतस्योत्तरदिशोभागे ददर्श विपुलं वनम्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000833011, "chapter_id": 20833, "verse_number": "६-१७६-१२", "content_sanskrit": "मारुतांदोलितानेक कुसुमामोदसुंदरम् ।\nउन्मत्तभ्रमरोद्गीत नादापूरितदिङ्मुखम्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000833012, "chapter_id": 20833, "verse_number": "६-१७६-१३", "content_sanskrit": "तस्मिन्वने सरित्तीरे निषीदंतं शिलातले ।\nमित्रवंतं ददर्शाथ सानंदस्तिमितेक्षणम्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000833013, "chapter_id": 20833, "verse_number": "६-१७६-१४", "content_sanskrit": "अपि स्वाभाविकं वैरं हित्वान्योन्यं विरोधिभिः ।\nसत्वैरावृतमुद्याने मंदस्यंदनभास्वति॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000833014, "chapter_id": 20833, "verse_number": "६-१७६-१५", "content_sanskrit": "शांतेषु मृगयूथेषु दशानंदमनोज्ञया ।\nकृपानुविद्धया भूमिं निषिंचंतमिवामृतम्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000833015, "chapter_id": 20833, "verse_number": "६-१७६-१६", "content_sanskrit": "उपेत्य विनयेनामुमुन्मनाः प्रीतमानसः ।\nकिंचिदानम्रशिरसा तेनापि स तु सत्कृतः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000833016, "chapter_id": 20833, "verse_number": "६-१७६-१७", "content_sanskrit": "उपतस्थे ततो विद्वान्मित्रवंतमनन्यधीः ।\nसमाप्तध्यानकालं स पर्यपृच्छत्समाहितः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000833017, "chapter_id": 20833, "verse_number": "६-१७६-१८", "content_sanskrit": "देवशर्मोवाच ।\nआत्मानं वेत्तुमिच्छामि तदमुष्मिन्मनोरथे ।\nलब्धसिद्धिमुपायं मामुपदेष्टुं त्वमर्हसि॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000833018, "chapter_id": 20833, "verse_number": "६-१७६-१९", "content_sanskrit": "श्रीभगवानुवाच ।\nपरामृश्य क्षणं सोऽपि मित्रवानिदमब्रवीत् ।\nमित्रवानुवाच ।\nविद्वन्विद्धि पुरावृत्तमुच्यमानमिदं मया॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000833019, "chapter_id": 20833, "verse_number": "६-१७६-२०", "content_sanskrit": "अस्ति गोदावरीतीरे प्रतिष्ठानाभिधं पुरम् ।\nतत्र दुर्दमनामासीदन्वये च मनीषिणाम्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000833020, "chapter_id": 20833, "verse_number": "६-१७६-२१", "content_sanskrit": "तत्रास्ति विक्रमो नाम सेव्यमानो महीपतिः ।\nदानानि प्रत्यहं गृह्णन्वर्त्तते उदरंभरः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000833021, "chapter_id": 20833, "verse_number": "६-१७६-२२", "content_sanskrit": "कालेन कालपाशेन बद्धानीतो यमालयम् ।\nनिरयेषु समग्रेषु यातना अनुभूय च॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000833022, "chapter_id": 20833, "verse_number": "६-१७६-२३", "content_sanskrit": "कस्मिंश्चित्स कुले जातो दुर्वृत्तानां द्विजन्मनाम् ।\nभवांतरानुवर्तिन्या विद्यया स पुरस्कृतः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000833023, "chapter_id": 20833, "verse_number": "६-१७६-२४", "content_sanskrit": "उपयेमे दुराधर्षां कन्यकामधमे कुले ।\nकालेन सा वयो हित्वा शैशवं यौवनं ययौ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000833024, "chapter_id": 20833, "verse_number": "६-१७६-२५", "content_sanskrit": "पीनस्तनी च सुश्रोणी मदविह्वललोचना ।\nपतिं न सेहे दुर्वृत्तं चकमे स्वपतीन्परान्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000833025, "chapter_id": 20833, "verse_number": "६-१७६-२६", "content_sanskrit": "वृत्तिमाहर्तुकामस्मिन्निर्गता सा पुराद्बहिः ।\nसंगता कामुकेनासौ चिरं चांडालजन्मना॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000833026, "chapter_id": 20833, "verse_number": "६-१७६-२७", "content_sanskrit": "दधे गर्भमसौ तस्मात्सा च कन्योपपद्यते ।\nसैव भार्यापि तस्यासीत्पूर्वपापप्रसंगतः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000833027, "chapter_id": 20833, "verse_number": "६-१७६-२८", "content_sanskrit": "सैव वृद्धा ततः काले डाकिनी समजायत ।\nकुसंगात्कुमतिर्जाता दुष्टनारीप्रसंगतः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000833028, "chapter_id": 20833, "verse_number": "६-१७६-२९", "content_sanskrit": "चखाद व्याधितं व्याधमसृगास्वादलालसा ।\nभ्रमंती विपिने घोरे जनैर्दृष्ट्वा बहिष्कृता॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000833029, "chapter_id": 20833, "verse_number": "६-१७६-३०", "content_sanskrit": "परेतलोकमासाद्य व्याधौ व्याघ्रोऽभ्यवर्त्तत ।\nनरकान्दारुणान्भुक्त्वा जीवहिंसा प्रभावतः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000833030, "chapter_id": 20833, "verse_number": "६-१७६-३१", "content_sanskrit": "सापि कालेन दुष्टात्मा मृत्युवेगमुपागता ।\nनिरयानेत्य दुर्द्धर्षानजाजायत मद्गृहे॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000833031, "chapter_id": 20833, "verse_number": "६-१७६-३२", "content_sanskrit": "तामन्या अप्यहं विद्वन्पालयन्काननांतरे ।\nअपश्यन्द्वीपिनं घोरं जिघांसंतमिवाखिलम्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000833032, "chapter_id": 20833, "verse_number": "६-१७६-३३", "content_sanskrit": "समालोक्य तमायांतं भयेन प्रपलायितम् ।\nअजायूथं परित्यज्य मया मरणभीरुणा॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000833033, "chapter_id": 20833, "verse_number": "६-१७६-३४", "content_sanskrit": "उपदुद्राव स द्वीपी पूर्ववैरमनुस्मरन् ।\nअजा तु तत्समीपेऽगात्सत्वरं सरिदंतिके॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000833034, "chapter_id": 20833, "verse_number": "६-१७६-३५", "content_sanskrit": "तत्र सा भयमुत्सृज्य हित्वा वैरमनर्गला ।\nअवतस्थे स च द्वीपी तूष्णीमासीदमत्सरः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000833035, "chapter_id": 20833, "verse_number": "६-१७६-३६", "content_sanskrit": "तं तथाविधमालोक्य सा वक्तुमुपचक्रमे ।\nद्वीपिन्नभीप्सितं भुंक्ष्व मांसमुद्धृत्य सादरः॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000833036, "chapter_id": 20833, "verse_number": "६-१७६-३७", "content_sanskrit": "नेयं भवति ते बुद्धिः कथं वैरमतिं त्यजः ।\nइत्याकर्ण्य तदा वाक्यं प्राह द्वीपी विमत्सरः॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000833037, "chapter_id": 20833, "verse_number": "६-१७६-३८", "content_sanskrit": "स्थानेऽस्मिन्मे गतो द्वेषः क्षुत्पिपासा च निर्ययौ ।\nन प्रार्थयामि तेन त्वां समीपे समुपस्थिताम्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000833038, "chapter_id": 20833, "verse_number": "६-१७६-३९", "content_sanskrit": "सैवमुक्ता पुनः प्राह जाताहं निर्भया कथम् ।\nकिमत्र कारणं वेत्सि यदि मे वक्तुमर्हसि॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000833039, "chapter_id": 20833, "verse_number": "६-१७६-४०", "content_sanskrit": "एवमुक्तः पुनर्द्वीपी तामाहाजां न वेद्म्यहम् ।\nपुरोगतमिमं प्रष्टुं महांतमिति निर्गतौ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000833040, "chapter_id": 20833, "verse_number": "६-१७६-४१", "content_sanskrit": "ताभ्यामुभाभ्यामागत्य पृष्टोऽहं बहुविस्मयः ।\nअहं च सहितस्ताभ्यामपृच्छं वानरेश्वरम्॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000833041, "chapter_id": 20833, "verse_number": "६-१७६-४२", "content_sanskrit": "मया पृष्टः स विप्रेदमब्रवीत्सादरं कपिः ।\nशृणु वक्ष्याम्यजापाल वृत्तमत्र पुरातनम्॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000833042, "chapter_id": 20833, "verse_number": "६-१७६-४३", "content_sanskrit": "इदमायतनं पश्य पुरोवनगतं महत् ।\nअत्र त्र्यंबकलिंगं हि द्रुहिणेन प्रतिष्ठितम्॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000833043, "chapter_id": 20833, "verse_number": "६-१७६-४४", "content_sanskrit": "सुकर्मानाम मेधावी पर्युपास्ते तपश्चरन् ।\nवनपुष्पाण्यपाहृत्य सुरपूज्यं पुरोभवम्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000833044, "chapter_id": 20833, "verse_number": "६-१७६-४५", "content_sanskrit": "संस्नाप्य सरिदंभोभिः केवलं कर्मणा वसन् ।\nकाले महति तस्यागादतिथिः कश्चिदंतिकम्॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000833045, "chapter_id": 20833, "verse_number": "६-१७६-४६", "content_sanskrit": "उपाहृत्य फलाहारं स तस्मै पर्यकल्पयत् ।\nतेनातिथ्येन संप्रीतः सुकर्माणमभाषत॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000833046, "chapter_id": 20833, "verse_number": "६-१७६-४७", "content_sanskrit": "किमिदं कर्मणो मूलं फलं भुक्त्वा तु तिष्ठसि ।\nगतानुगतया वृत्त्या किं वा केवलमीहसे॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000833047, "chapter_id": 20833, "verse_number": "६-१७६-४८", "content_sanskrit": "स एवमुक्तः प्रायेण प्रीतेनात्मविदा तदा ।\nप्रत्युवाच वचः स्पष्टमात्मनो हितमुत्तमम्॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000833048, "chapter_id": 20833, "verse_number": "६-१७६-४९", "content_sanskrit": "विद्वन्न वेद्मि तत्वेन फलमेतस्य कर्मणः ।\nबुभुत्सया परः शंभुः सेव्यते केवलं यया॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000833049, "chapter_id": 20833, "verse_number": "६-१७६-५०", "content_sanskrit": "फलमेतस्य सेवायाः परिपाकं कपर्दिनः ।\nयन्मांसमनुगृह्णासि संस्पृश्यात्ममनोरथम्॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000833050, "chapter_id": 20833, "verse_number": "६-१७६-५१", "content_sanskrit": "तस्यैवं सूनृतं वाक्यं श्रुत्वा प्रीतस्तपोधनः ।\nद्वितीयमालिलेखाऽसौ गीताध्यायं शिलातले॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000833051, "chapter_id": 20833, "verse_number": "६-१७६-५२", "content_sanskrit": "आदिदेशाशु तं विप्रं पठनाभ्यसनाय च ।\nफलिष्यत्यात्मनः स्वैरं परितस्ते मनोरथः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000833052, "chapter_id": 20833, "verse_number": "६-१७६-५३", "content_sanskrit": "इत्युक्त्वांतर्दधे धीमान्पुरतस्तस्य पश्यतः ।\nविस्मितस्तस्य चादेशात्सोऽन्वतिष्ठदनारतम्॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000833053, "chapter_id": 20833, "verse_number": "६-१७६-५४", "content_sanskrit": "ततः कालेन महता भावितात्मा प्रसन्नधीः ।\nयत्रयत्र चचारासौ शांतं तत्तत्तपोवनम्॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000833054, "chapter_id": 20833, "verse_number": "६-१७६-५५", "content_sanskrit": "न द्वंद्वबाधा नैव क्षुत्पिपासा न च वा भयम् ।\nतपसा तस्य जानीहि द्वितीयाध्यायजापिनः॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000833055, "chapter_id": 20833, "verse_number": "६-१७६-५६", "content_sanskrit": "मित्रवानुवाच ।\nएवमुक्तश्च तेनाऽहं ख्यापयित्वा परां कथाम् ।\nअनुज्ञातप्रसंनेन च्छागीव्याघ्रयुतोगमम्॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000833056, "chapter_id": 20833, "verse_number": "६-१७६-५७", "content_sanskrit": "गत्वा शिलातले पश्यमध्यायं लिखितं पठेत् ।\nतस्यैवावर्त्तनादाप्तं तपसः पारमुत्तमम्॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000833057, "chapter_id": 20833, "verse_number": "६-१७६-५८", "content_sanskrit": "तेन त्वमपि कल्याण नित्यमाहर्तुमर्हसि ।\nअध्यायं तेन ते मुक्तिरदूरस्था भविष्यति॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000833058, "chapter_id": 20833, "verse_number": "६-१७६-५९", "content_sanskrit": "देवशर्मा समादिष्टस्तेन मित्रवता स्वयम् ।\nअभ्यर्च्य प्रणतो भूत्वा पुरंदरपुरं ययौ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000833059, "chapter_id": 20833, "verse_number": "६-१७६-६०", "content_sanskrit": "तत्रात्मविदमासाद्य देवतायतने क्वचित् ।\nवृत्तमेतन्निवेद्यादावध्यायमपठत्ततः॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000833060, "chapter_id": 20833, "verse_number": "६-१७६-६१", "content_sanskrit": "शिक्षितस्तेन पूतात्मा पठन्नध्यायमादरात् ।\nद्वितीयमाससादोच्चैर्निरवद्यं परं पदम्॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000833061, "chapter_id": 20833, "verse_number": "६-१७६-६२", "content_sanskrit": "द्वितीयस्येदमाख्यानं कथितं शृणु सांप्रतम् ।\nतृतीयस्याथ वक्ष्यामि माहात्म्यमपि चेंदिरे॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]