[{"id": 2096460, "chapter_id": 3063, "verse_number": "१३-१९३-१", "content_sanskrit": "[भीष्म उवाच।\nततस्त्वृषिगणाः सर्वे पितरश्च सदेवताः।\nअरुन्धतीं तपोवृद्धामपृच्छन्त समाहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2096461, "chapter_id": 3063, "verse_number": "१३-१९३-२", "content_sanskrit": "समानशीलां वीर्येण वसिष्ठस्य महात्मनः।\nत्वत्तो धर्मरहस्यानि श्रोतुमिच्छामहे वयम्।\nयत्ते गुह्यतमं भद्रे तत्प्रभाषितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2096462, "chapter_id": 3063, "verse_number": "१३-१९३-३x", "content_sanskrit": "अरुन्धत्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2096463, "chapter_id": 3063, "verse_number": "१३-१९३-३", "content_sanskrit": "तपोवृद्धिर्मया प्राप्ता भवतां स्मरणेन वै।\nभवतां च प्रसादेन धर्मान्वक्ष्यामि शाश्वतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2096464, "chapter_id": 3063, "verse_number": "१३-१९३-४", "content_sanskrit": "सगुह्यान्सरहस्यांश्च ताञ्शृणुद्वमशेषतः।\nश्रद्दधाने प्रयोक्तव्या यस्य शुद्धं तथा मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2096465, "chapter_id": 3063, "verse_number": "१३-१९३-५", "content_sanskrit": "अश्रद्दधानो मानी च ब्रह्महा गुरुतल्पग।\nअसम्भाष्या हि चत्वारो नैषां धर्मं प्रकाशयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2096466, "chapter_id": 3063, "verse_number": "१३-१९३-६", "content_sanskrit": "अहन्यहनि यो दद्यात्कपिलां द्वादशीः समाः।\nमासिमासि च सत्रेण यो यजेत सदा नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2096467, "chapter_id": 3063, "verse_number": "१३-१९३-७", "content_sanskrit": "गवां शतसहस्रं च यो दद्याज्ज्येष्ठपुष्करे।\nन तद्धर्मफलं तुल्यमतिथिर्यस्य तुष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2096468, "chapter_id": 3063, "verse_number": "१३-१९३-८", "content_sanskrit": "श्रूयतां चापरो धर्मो मनुष्याणां सुखावहः।\nश्रद्दधानेन कर्तव्यः सरहस्यो महाफलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2096469, "chapter_id": 3063, "verse_number": "१३-१९३-९", "content_sanskrit": "कल्यमुत्थाय गोमध्ये गृह्य दर्भान्सहोदकान्।\nनिषिञ्चेत गवां शृङ्गे मस्तकेन च तज्जलम्।\nप्रतीच्छेत निराहारस्तस्यि धर्मफलं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2096470, "chapter_id": 3063, "verse_number": "१३-१९३-१०", "content_sanskrit": "श्रूयन्ते यानि तीर्थानि त्रिषु लोकेषु कानिचित्।\nसिद्धचारणजुष्टानि सेवितानि महर्षिभिः।\nअभिषेकः समस्तेषां गवां शृङ्गोदकस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2096471, "chapter_id": 3063, "verse_number": "१३-१९३-११", "content_sanskrit": "साधुसाध्विति चोद्दिष्टं दैवतैः पितृभिस्तथा।\nभूतैश्चैव सुसंहृष्टैः पूजिता साऽप्यरुन्धती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2096472, "chapter_id": 3063, "verse_number": "१३-१९३-१२x", "content_sanskrit": "पितामह उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2096473, "chapter_id": 3063, "verse_number": "१३-१९३-१२", "content_sanskrit": "अहो धर्मो महाभागे सरहस्य उदाहृतः।\nवरं ददामि ते धन्ये तपस्ते वर्दतां सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2096474, "chapter_id": 3063, "verse_number": "१३-१९३-१३x", "content_sanskrit": "यम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2096475, "chapter_id": 3063, "verse_number": "१३-१९३-१३", "content_sanskrit": "रमणीया कथा दिव्या युष्मत्तो या मया श्रुता।\nश्रूयतां चित्रगुप्तस्य भाषितं मम च प्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2096476, "chapter_id": 3063, "verse_number": "१३-१९३-१४", "content_sanskrit": "रहस्यं धर्मसंयुक्तं शक्यं श्रोतुं महर्षिभिः।\nश्रद्दधानेन मर्त्येन आत्मनो हितमिच्छाता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2096477, "chapter_id": 3063, "verse_number": "१३-१९३-१५", "content_sanskrit": "न हि पुण्यं तथा पापं कृतं किञ्चिद्विनश्यति।\nपर्वकाले च यत्किंचिदादित्यं चाधितिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2096478, "chapter_id": 3063, "verse_number": "१३-१९३-१६", "content_sanskrit": "प्रेतलोकं गते मर्त्ये तत्तत्सर्वं विभावसुः।\nप्रतिजानाति पुण्यात्मा तच्चि तत्रोपयुज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2096479, "chapter_id": 3063, "verse_number": "१३-१९३-१७", "content_sanskrit": "किञ्चिद्धर्म प्रवक्ष्यामि चित्रगुप्तमतं शुभम्।\nपानीयं चैव दीपं च दातव्यं सततं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2096480, "chapter_id": 3063, "verse_number": "१३-१९३-१८", "content_sanskrit": "उपानहौ च च्छत्रं च कपिला च यथातथम्।\nपुष्करे कपिला देया ब्राह्मणे वेदपारगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2096481, "chapter_id": 3063, "verse_number": "१३-१९३-१९", "content_sanskrit": "अग्निहोत्रं च यत्नेन सर्वशः प्रतिपालयेत्।\nअयं चैवापरो धर्मश्चित्रगुप्तेन भाषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2096482, "chapter_id": 3063, "verse_number": "१३-१९३-२०", "content_sanskrit": "फलमस्य पृथक्त्वेन श्रोतुमर्हन्ति सत्तमाः।\nप्रलयं सर्वभूतैस्तु गन्तव्यं कालपर्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2096483, "chapter_id": 3063, "verse_number": "१३-१९३-२१", "content_sanskrit": "तत्र दुर्गमनुप्राप्ताः क्षुत्तृष्णापरिपीडिताः।\nदह्यमाना विपच्यन्ते न तत्रास्ति पलायनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2096484, "chapter_id": 3063, "verse_number": "१३-१९३-२२", "content_sanskrit": "अन्धकारं तमो घोरं प्रविशन्त्यल्पबुद्धयः।\nतत्र धर्मं प्रवक्ष्यामि येन दुर्गाणि सन्तरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2096485, "chapter_id": 3063, "verse_number": "१३-१९३-२३", "content_sanskrit": "अल्पव्ययं महार्थं च प्रेत्य चैव सुखोदयम्।\nपानीयस्य गुणा दिव्याः प्रेतलोके विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2096486, "chapter_id": 3063, "verse_number": "१३-१९३-२४", "content_sanskrit": "तत्र पुण्योदका नाम नदी तेषां विधीयते।\nअक्षयं सलिलं तत्र शीतलं ह्यमृतोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2096487, "chapter_id": 3063, "verse_number": "१३-१९३-२५", "content_sanskrit": "स तत्र तोयं पिबति पीनीयं यः प्रयच्छति।\nप्रदीपस्य प्रदानेन श्रूयतां गुणविस्तरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2096488, "chapter_id": 3063, "verse_number": "१३-१९३-२६", "content_sanskrit": "तमोन्धकारं नियतं दीपदो न प्रपश्यति।\nप्रभां चास्य प्रयच्छन्ति सोमभास्करपावकाः।\nदेवताश्चानुमन्यन्ते विमलाः सर्वतो दिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2096489, "chapter_id": 3063, "verse_number": "१३-१९३-२७", "content_sanskrit": "द्योततें च यथाऽऽदित्यः प्रेतलोकगतो नरः।\nतस्माद्दीपः प्रदातव्यः पानीयं च विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2096490, "chapter_id": 3063, "verse_number": "१३-१९३-२८", "content_sanskrit": "कपिलां ये प्रयच्छन्ति ब्राह्मणे वेदपारगे।\nपुष्करे च विशेषेण श्रूयतां तस्य यत्फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2096491, "chapter_id": 3063, "verse_number": "१३-१९३-२९", "content_sanskrit": "गोशतं सवृषं तेन दत्तं भवति शाश्वतम्।\nपापं कर्म च यत्किञ्चिद्ब्रह्महत्यासमं भवेत्।\nशोधयेत्कपिला ह्येका प्रदत्तं गोशतं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2096492, "chapter_id": 3063, "verse_number": "१३-१९३-३०", "content_sanskrit": "तस्मात्तु कपिला देया कौमुद्यां ज्येष्ठपुष्करे।\nन तेषां विषमं किञ्चिन्न दुःखं न च कण्टकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2096493, "chapter_id": 3063, "verse_number": "१३-१९३-३१", "content_sanskrit": "उपानहौ च यो दद्यात्पात्रभूते द्विजोत्तमे।\nछत्रदाने सुखां छायां लभते परलोकगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2096494, "chapter_id": 3063, "verse_number": "१३-१९३-३२", "content_sanskrit": "न हि दत्तस्य दानस्य नाशोऽस्तीह कदाचन।\nचित्रगुप्तमतं श्रुत्वा हृष्टरोमा विभावसुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2096495, "chapter_id": 3063, "verse_number": "१३-१९३-३३", "content_sanskrit": "उवाच देवताः सर्वाः पितॄंश्चैव महाद्युतिः।\nश्रुतं हि चित्रगुप्तस्य धर्मगुह्यं महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2096496, "chapter_id": 3063, "verse_number": "१३-१९३-३४", "content_sanskrit": "श्रद्दधानाश्च ये मर्त्या ब्राह्मणेषु महात्मसु।\nदानमेतत्प्रयच्छन्ति न तेषां विद्यते भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2096497, "chapter_id": 3063, "verse_number": "१३-१९३-३५", "content_sanskrit": "धर्मदोषास्त्विमे पञ्च येषां नास्तीह निष्कृतिः।\nअसंभाष्या अनाचारा वर्जनीया नराधमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2096498, "chapter_id": 3063, "verse_number": "१३-१९३-३६", "content_sanskrit": "ब्रह्महा चैव गोघ्नश्च परदाररतश्च यः।\nअश्रद्दधानश्च नरः स्त्रियं यश्चोपजीवति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2096499, "chapter_id": 3063, "verse_number": "१३-१९३-३७", "content_sanskrit": "प्रेतलोकगता ह्येते नरके पापकर्मिणः।\nपच्यन्ते वै यथा मीनाः पूयशोणितभोजनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2096500, "chapter_id": 3063, "verse_number": "१३-१९३-३८", "content_sanskrit": "असम्भाष्याः पितॄणां च देवानां चैव पञ्च ते।\nस्नातकानां च विप्राणां ये चान्ये च तपोधनाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2096501, "chapter_id": 3063, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि त्रिनवत्यधिकशततमोऽध्यायः॥ १९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]