[{"id": 7002459000, "chapter_id": 22459, "verse_number": "१-१२१-१", "content_sanskrit": "शतानीक उवाच ।\nशरीरलेखनं१ भानोरुक्तं संक्षेपतस्त्वया ।\nविस्तराच्छ्रोतुमिच्छामि तन्ममाचक्ष्व सुव्रत ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002459001, "chapter_id": 22459, "verse_number": "१-१२१-२", "content_sanskrit": "सुमन्तुरुवाच ।\nपितुर्गृहं तु यातायां संज्ञायां कुरुनंदन ।\nभास्करश्चिंतयामास संज्ञा मद्रूपकारिणी ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002459002, "chapter_id": 22459, "verse_number": "१-१२१-३", "content_sanskrit": "एतस्मिन्नंतरे ब्रह्मा तत्रागत्य दिवाकरम् ।\nअव्रवीन्मधुरां वाचं रवेः प्रीतिकरां शुभाम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002459003, "chapter_id": 22459, "verse_number": "१-१२१-४", "content_sanskrit": "आदिदेवोऽसि देवानां व्याप्तमेतत्त्वया जगत् ।\nश्वशुरो विश्वकर्मा ते रूपं निर्वर्तयिष्यति ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002459004, "chapter_id": 22459, "verse_number": "१-१२१-५", "content_sanskrit": "एवमुक्त्वा रविं ब्रह्मा विश्वकर्माणमब्रवीत् ।\nनिवर्तस्य मार्तण्डं स्वरूपं तत्सुशोभनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002459005, "chapter_id": 22459, "verse_number": "१-१२१-६", "content_sanskrit": "ततो ब्रह्मसमादेशाद्भ्र मिमारोप्य भास्करम् ।\nरूपं निर्वर्तयामास विश्वकर्मा शनैःशनैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002459006, "chapter_id": 22459, "verse_number": "१-१२१-७", "content_sanskrit": "ततस्तुष्टाव तं ब्रह्मा सर्वदेवगणैः सह ।\nगुह्यैर्नानाविधैः स्तोत्रैर्वेदवेदाङ्गपारगैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002459007, "chapter_id": 22459, "verse_number": "१-१२१-८", "content_sanskrit": "स्वस्ति तेऽस्तु जगन्नाथ धर्मवर्षहिमाकर ।\nशांतिस्ते सर्वलोकानां देवदेव दिवाकर ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002459008, "chapter_id": 22459, "verse_number": "१-१२१-९", "content_sanskrit": "ततो रुद्रश्च विष्ण्वाद्याः स्तुवंतस्तं दिवाकरम् ।\nतेजस्ते वर्धतां देव लिख्यतेऽपि दिवस्पते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002459009, "chapter_id": 22459, "verse_number": "१-१२१-१०", "content_sanskrit": "इन्द्रश्चागत्य तं देवं लिख्यमानमथास्तुवत् ।\nजय देव जयस्वेति तत्त्वदोऽसि जगत्पते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002459010, "chapter_id": 22459, "verse_number": "१-१२१-११", "content_sanskrit": "ऋषयस्तु ततः सप्त विश्वामित्रपुरोगमाः ।\nतुष्टुवुर्विविधैः स्तोत्रैः स्वस्तिस्वस्तीतिवादिनः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002459011, "chapter_id": 22459, "verse_number": "१-१२१-१२", "content_sanskrit": "वेदोक्ताभिरथाशीर्भिर्वालखिल्याश्च तुष्टुवुः ।\nत्वं नाथ मोक्षिणां मोक्षो ध्येयस्त्वं ध्यानिनामपि ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002459012, "chapter_id": 22459, "verse_number": "१-१२१-१३", "content_sanskrit": "त्वं गतिः सर्वभूतानां त्वयि सर्वं प्रतिष्ठितम् ।\nप्रजाभ्यश्चैव देवेश शं नोऽस्तु जगतः पते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002459013, "chapter_id": 22459, "verse_number": "१-१२१-१४", "content_sanskrit": "त्वत्तो भवति वै नित्यं जगत्संलीयते त्वयि ।\nत्वमेकस्त्वं द्विधा चैव त्रिधा च त्वं न संशयः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002459014, "chapter_id": 22459, "verse_number": "१-१२१-१५", "content_sanskrit": "त्वयैकेन जगत्सृष्टं त्वयैकेन प्रबोधितम् ।\nततो विद्याधरगणा यक्षराक्षसपन्नगाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002459015, "chapter_id": 22459, "verse_number": "१-१२१-१६", "content_sanskrit": "कृताञ्जलिपुटाः सर्वे शिरोभिः प्रणता रविम् ।\nऊचुरेवंविधा वाचो मनः श्रोत्रसुखप्रदाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002459016, "chapter_id": 22459, "verse_number": "१-१२१-१७", "content_sanskrit": "सह्यं भवतु ते तेजो भूतानां भूतभावन ।\nहाहा हूहूस्ततश्चैव तुम्बुरुर्नारदस्तथा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002459017, "chapter_id": 22459, "verse_number": "१-१२१-१८", "content_sanskrit": "उपगातुं समारब्धा गामुच्चैः कुशला रविम् ।\nषड्जमध्यमगांधारग्रामत्रयविशारदाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002459018, "chapter_id": 22459, "verse_number": "१-१२१-१९", "content_sanskrit": "मूर्च्छनाभिस्ततश्चैव तथा धैवतपञ्चमैः ।\nनानानुभावमन्द्रैश्च अर्धमन्द्रैस्तथैव च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002459019, "chapter_id": 22459, "verse_number": "१-१२१-२०", "content_sanskrit": "त्रिसाधनैः प्रकारैस्तु वाद्यतालसमन्वितैः ।\nविश्वाची च घृताची च उर्वशी च तिलोत्तमा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002459020, "chapter_id": 22459, "verse_number": "१-१२१-२१", "content_sanskrit": "मेनका सहजन्या च रम्भा चाप्सरसां वरा ।\nहावभावविलासैश्च कुर्वत्योऽभिनयान्बहून् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002459021, "chapter_id": 22459, "verse_number": "१-१२१-२२", "content_sanskrit": "ततोऽतीव कलं गेयं मधुरं च प्रवर्तते ।\nसर्वेषां देवसंघानां मनः श्रोत्रसुखप्रदम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002459022, "chapter_id": 22459, "verse_number": "१-१२१-२३", "content_sanskrit": "प्रवाद्यं तु ततस्तत्र वीणावंशादि सुव्रत ।\nपणवाः पुष्कराश्चैव मृदङ्गाः पटहास्तथा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002459023, "chapter_id": 22459, "verse_number": "१-१२१-२४", "content_sanskrit": "देवदुन्दुभयः शंखाः शतशोऽथ सहस्रशः ।\nगायद्भिश्चैव गन्धर्वैर्नृत्यद्भिश्चाप्सरोगणैः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002459024, "chapter_id": 22459, "verse_number": "१-१२१-२५", "content_sanskrit": "तूर्यवादित्रघोषैश्च सर्वं कोलाहलीकृतम् ।\nततः कृतैः करपुटैः पद्यकुड्मलसन्निभैः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002459025, "chapter_id": 22459, "verse_number": "१-१२१-२६", "content_sanskrit": "ललाटोपरि विन्यस्तैः प्रणेमुः सर्वदेवताः ।\nततः कोलाहले तस्मिन्सर्वदेवसमागमे ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002459026, "chapter_id": 22459, "verse_number": "१-१२१-२७", "content_sanskrit": "तेजसः शातनं चक्रे विश्वकर्मा शनैः शनैः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002459027, "chapter_id": 22459, "verse_number": "१-१२१-२८", "content_sanskrit": "इति हिमजलघर्मकालहेतोर्हरकमलासनविष्णुसंस्तुतस्य ।\nतदुपरि लिखनं निशम्य भानोर्व्रजति दिवाकरलोकमायुषोन्ते ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]