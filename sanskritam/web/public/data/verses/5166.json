[{"id": 2195652, "chapter_id": 5166, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2195653, "chapter_id": 5166, "verse_number": "१", "content_sanskrit": "विनता पुत्रशोकार्ता शापाद् भीता च भारत ।\nप्रतीक्षते स्म तं कालं यः पुत्रोक्तस्तदाऽभवत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2195654, "chapter_id": 5166, "verse_number": "२", "content_sanskrit": "ततोऽप्यतीते पञ्चशते वर्षाणां कालसंयुगे ।\nगरुडोऽथ महावीर्यो जज्ञे भुजगभुग् बली\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2195655, "chapter_id": 5166, "verse_number": "३", "content_sanskrit": "बन्धुरास्यः शिखी पत्रकोशः कूर्मनखो महान् ।\nरक्ताक्षः संहतग्रीवो ह्रस्वपादो महाशिराः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2195656, "chapter_id": 5166, "verse_number": "४", "content_sanskrit": "यस्त्वण्डात् स विनिर्भिन्नो निष्क्रान्तो भरतर्षभ ।\nविनतापूर्वजः पुत्रः सोऽरुणो दृश्यते दिवि\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2195657, "chapter_id": 5166, "verse_number": "५", "content_sanskrit": "पूर्वां दिशमभिप्रेत्य सूर्यस्योदयनं प्रति ।\nअरुणोऽरुणसङ्काशो नाम्ना चैवारुणः स्मृतः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2195658, "chapter_id": 5166, "verse_number": "६", "content_sanskrit": "जातमात्रस्तु विहगो गरुडः पन्नगाशनः ।\nविहाय मातरं क्षिप्रमगमत् सर्वतोदिशः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2195659, "chapter_id": 5166, "verse_number": "७", "content_sanskrit": "स तथा चातिववृधे सर्वकामैरथार्चितः ।\nपितामहविसृष्टेन भोजनेन विशाम्पते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2195660, "chapter_id": 5166, "verse_number": "८", "content_sanskrit": "तस्मिंश्च विहगे तत्र यथाकामं विवर्धति ।\nकद्रूश्च विनता चैव गच्छेतां सागरं प्रति\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2195661, "chapter_id": 5166, "verse_number": "९", "content_sanskrit": "ददृशाते तु ते यान्तमुच्चैःश्रवसमन्तिकात् ।\nस्नात्वोपवृत्तं त्वरितं पीतवन्तं च वाजिनम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2195662, "chapter_id": 5166, "verse_number": "१०", "content_sanskrit": "ततः कद्रूर्हसन्त्येव विनतामिदमब्रवीत् ।\nहयस्य वर्णः को न्वत्र ब्रूहि यस्ते मनः शुभे\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2195663, "chapter_id": 5166, "verse_number": "", "content_sanskrit": "विनता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2195664, "chapter_id": 5166, "verse_number": "११", "content_sanskrit": "एकवर्णो हयो राज्ञि सर्वश्वेतो मतो मम ।\nवर्णं वा कीदृशं तस्य मन्यसे त्वं मनस्विनि\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2195665, "chapter_id": 5166, "verse_number": "", "content_sanskrit": "कद्रूः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2195666, "chapter_id": 5166, "verse_number": "१२", "content_sanskrit": "यद्यार्ये (स?) मतस्तुभ्यं य एष हयसत्तमः ।\nब्रूहि कल्याणि दीव्यावो वर्णान्यत्वेन भामिनि\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2195667, "chapter_id": 5166, "verse_number": "", "content_sanskrit": "विनता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2195668, "chapter_id": 5166, "verse_number": "१३", "content_sanskrit": "यद्यार्ये दीव्यसि त्वं मे कः पणो नो भविष्यति ।\nसा तज्ज्ञात्वा पणेयं वै ज्ञात्वा तु विपणे त्वया\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2195669, "chapter_id": 5166, "verse_number": "", "content_sanskrit": "कद्रूः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2195670, "chapter_id": 5166, "verse_number": "१४", "content_sanskrit": "जिता दासी भवेर्मे त्वमहं चाप्यसितेक्षणे ।\nनैकवर्णैकवर्णत्वे विनते रोचते च ते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2195671, "chapter_id": 5166, "verse_number": "१५", "content_sanskrit": "रोचते मे पणे राज्ञि दासीत्वेन न संशयः ।\nसत्यमातिष्ठ भद्रं ते सत्ये स्थास्यामि चाप्यहम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2195672, "chapter_id": 5166, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे गरुडोपाख्याने गरुडोत्पत्तिर्नाम सप्तदशोऽध्यायः ॥१७॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]