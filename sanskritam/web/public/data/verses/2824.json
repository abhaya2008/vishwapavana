[{"id": 2085705, "chapter_id": 2824, "verse_number": "१२-३२९-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2085706, "chapter_id": 2824, "verse_number": "१२-३२९-१", "content_sanskrit": "कथं निर्वेदमापन्नः शुको वैयासकिः पुरा।\nएतदिच्छाम्यहं श्रोतुं परं कौतूहलं हि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2085707, "chapter_id": 2824, "verse_number": "१२-३२९-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2085708, "chapter_id": 2824, "verse_number": "१२-३२९-२", "content_sanskrit": "प्राकृतेनैव वृत्तेन चरन्तमकुतोभयम्।\nअध्याप्य कृत्स्नं स्वाध्यायमन्वशाद्वै पिता सुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2085709, "chapter_id": 2824, "verse_number": "१२-३२९-३x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2085710, "chapter_id": 2824, "verse_number": "१२-३२९-३", "content_sanskrit": "धर्मं पुत्र निपेवस्व सुतीक्ष्णौ च हिमातपौ।\nक्षुत्पिपासे च वायुं च जय नित्यं जितेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2085711, "chapter_id": 2824, "verse_number": "१२-३२९-४", "content_sanskrit": "सत्यमार्जवमक्रोधमनसूयां दमं तपः।\nअहिंसां चानृशंस्यं च विधिवत्परिपालय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2085712, "chapter_id": 2824, "verse_number": "१२-३२९-५", "content_sanskrit": "सत्ये तिष्ठ रतो धर्मे हित्वा सर्वमनार्जवम्।\nदेवतातिथिशेषेण यात्रां प्राणस्य संलिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2085713, "chapter_id": 2824, "verse_number": "१२-३२९-६", "content_sanskrit": "फेनमात्रोपमे देहे जीवे शकुनिवत्स्थिते।\nअनित्ये प्रियसंवासे कथं स्वपिषि पुत्रक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2085714, "chapter_id": 2824, "verse_number": "१२-३२९-७", "content_sanskrit": "अप्रमत्तेषु जाग्रत्सु नित्ययुक्तेषु शत्रुषु।\nअन्तरं लिप्यमानेषु बालस्त्वं नावबुध्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2085715, "chapter_id": 2824, "verse_number": "१२-३२९-८", "content_sanskrit": "अहःसु गण्यमानेषु क्षीयमाणे तथाऽऽयुषि।\nजीविते लिख्यमाने च किमुत्थाय न धावसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2085716, "chapter_id": 2824, "verse_number": "१२-३२९-९", "content_sanskrit": "ऐहलौकिकनीहन्ते मांसशोणितवर्धनम्।\nपारलौकिककार्येषु प्रसुप्ता भृशनास्तिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2085717, "chapter_id": 2824, "verse_number": "१२-३२९-१०", "content_sanskrit": "धर्माय येऽभ्यसूयन्ति बुद्धिमोहान्विता नराः।\nअपथा गच्छतां तेषामनुयाताऽपि पीड्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2085718, "chapter_id": 2824, "verse_number": "१२-३२९-११", "content_sanskrit": "ये तु तुष्टाः श्रुतिपरा महात्मानो महाबलाः।\nधर्म्यं पन्थानमारूढास्तानुपास्स्व च पृच्छ च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2085719, "chapter_id": 2824, "verse_number": "१२-३२९-१२", "content_sanskrit": "उपधार्य मतं तेषां बुधानां धर्मदर्शिनाम्।\nनियच्छ परया बुद्ध्या चित्तमुत्पथगामि वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2085720, "chapter_id": 2824, "verse_number": "१२-३२९-१३", "content_sanskrit": "आद्यकालिकया बुद्ध्या दूरेश्च इति निर्भयाः।\nसर्वभक्ष्या न पश्यन्ति कर्मभूमिमचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2085721, "chapter_id": 2824, "verse_number": "१२-३२९-१४", "content_sanskrit": "धर्मं निःश्रेणिमास्थाय किंचित्किंचित्समारुह।\nकोशकारवदात्मानं वेष्टयन्नावबुध्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2085722, "chapter_id": 2824, "verse_number": "१२-३२९-१५", "content_sanskrit": "नास्तिकं भिन्नमर्यादं कूलपातमिव स्थितम्।\nवामतः कुरु विस्रब्धो नरं वेणुमिवोद्धृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2085723, "chapter_id": 2824, "verse_number": "१२-३२९-१६", "content_sanskrit": "कामक्रोधग्राहवतीं पञ्चेन्द्रियजलां नदीम्।\nनावं धृतिमयीं कृत्वा जन्मदुर्गाणि संतर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2085724, "chapter_id": 2824, "verse_number": "१२-३२९-१७", "content_sanskrit": "मृत्युनाऽभ्याहते लोके जरया परिपीडिते।\nअमोघासु पतन्तीषु धर्मयानेन संतर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2085725, "chapter_id": 2824, "verse_number": "१२-३२९-१८", "content_sanskrit": "तिष्ठन्तं च शयानं च मृत्युरन्वेषते यदा।\nनिर्वृत्तिं लभते कस्मादकस्मान्मृत्युनाऽशितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2085726, "chapter_id": 2824, "verse_number": "१२-३२९-१९", "content_sanskrit": "संचिन्वानकमेवैनं कामानामवितृप्तकम्।\nवृकीवोरणमासाद्य मृत्युरादायं गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2085727, "chapter_id": 2824, "verse_number": "१२-३२९-२०", "content_sanskrit": "क्रमशः संचितशिखो धर्मबुद्धिमयो महान्।\nअन्धकारे प्रवेष्टव्ये दीपो यत्नेन धार्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2085728, "chapter_id": 2824, "verse_number": "१२-३२९-२१", "content_sanskrit": "संपतन्देहजालानि कदाचिदिह मानुषे।\nब्राह्मण्यं लभते जन्तुस्तत्पुत्र परिपालय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2085729, "chapter_id": 2824, "verse_number": "१२-३२९-२२", "content_sanskrit": "ब्राह्मणस्य तु देहोऽयं न कामार्थाय जायते।\nइह क्लेशाय तपसे प्रेत्य त्वनुपमं सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2085730, "chapter_id": 2824, "verse_number": "१२-३२९-२३", "content_sanskrit": "ब्राह्मण्यं बहुभिरवाप्यते तपोभि\nस्तल्लब्ध्वा न रतिपरेण हेलितव्यम्।\nस्वाध्याये तपसि दमे च नित्ययुक्तः\nमोक्षार्थी कुशलपरः सदा यतस्व॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2085731, "chapter_id": 2824, "verse_number": "१२-३२९-२४", "content_sanskrit": "अव्यक्तप्रकृतिरयं कलाशरीरः\nसूक्ष्मात्मा क्षणत्रुटिका निमेषरोमा।\nयानेतत्समबलशुक्लकृष्णनेत्रो\nमासाङ्गो द्रवति वयोहयो नराणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2085732, "chapter_id": 2824, "verse_number": "१२-३२९-२५", "content_sanskrit": "तं दृष्ट्वा प्रसृतमजस्रमुग्रवेगं\nगच्छन्तं सततमिहान्ववेक्षमाणम्।\nयक्षुस्ते यदि न परप्रणेतृनेयं\nधर्मे ते रमतु मनः परं निशाम्य॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2085733, "chapter_id": 2824, "verse_number": "१२-३२९-२६", "content_sanskrit": "येऽमी तु प्रचलितधर्मकामवृत्ताः\nक्रोशन्तः सततमनिष्टसंप्रयोगात्।\nक्लिश्यन्तः परिगतवेदनाशरीरा\nबह्वीभिः सुभृशमधर्मवागुराभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2085734, "chapter_id": 2824, "verse_number": "१२-३२९-२७", "content_sanskrit": "राजा सदा धर्मपरः शुभाशुभस्य गोप्ता\nसमीक्ष्य सुकृतिनां दधाति लोकान्।\nबहुविधमपि चरति प्रविशति\nसुखमनुपगतं निरवद्यम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2085735, "chapter_id": 2824, "verse_number": "१२-३२९-२८", "content_sanskrit": "श्वानो भीषणकाया अयोमुखानि वयांसि\nबलगृध्रकुररपक्षिणां च संघातम्।\nनरकदने रुधिरपा गुरुवचन\nनुदमुपरतं विशन्त्यसन्तः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2085736, "chapter_id": 2824, "verse_number": "१२-३२९-२९", "content_sanskrit": "मर्यादा नियताः स्वयम्भुवा य इहेमाः\nप्रभिनत्ति दश गुणा मनोऽनुगत्वात्।\nनिवसति भृशमसुखं पितृविषय\nविपिनमवगाह्य स पापः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2085737, "chapter_id": 2824, "verse_number": "१२-३२९-३०", "content_sanskrit": "यो लुब्ध सुभृशं प्रियानृतश्च मनुष्यः\nसततनिकृतिवञ्चनाभिरतिः स्यात्।\nउपनिधिभिरसुखकृत्स परमनिरयगो\nभृशमसुखमनुभवति दुष्कृतकर्मा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2085738, "chapter_id": 2824, "verse_number": "१२-३२९-३१", "content_sanskrit": "उष्णां वैतरणीं महानदीमव\nगाढोऽसिपत्रवनभिन्नगात्रः।\nपरशुवनशयोनिपतितो\nवसति च महानिरये भृशार्तः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2085739, "chapter_id": 2824, "verse_number": "१२-३२९-३२", "content_sanskrit": "महापादनि कत्थसे न चाप्यवेक्षसे परम्।\nचिरस्य मृत्युकारिकामनागतां न बुध्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2085740, "chapter_id": 2824, "verse_number": "१२-३२९-३३", "content_sanskrit": "प्रयस्यतां किमास्यते समुत्थितं महद्भयम्।\nअतिप्रमार्थि दारुणं सुखस्य संविधीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2085741, "chapter_id": 2824, "verse_number": "१२-३२९-३४", "content_sanskrit": "पुरा मृतः प्रणीयसे यमस्य राजशासनात्।\nत्वमन्तकाय दारुणैः प्रयत्नमार्जवे कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2085742, "chapter_id": 2824, "verse_number": "१२-३२९-३५", "content_sanskrit": "पुरा समूलबान्धवं प्रभुर्हरत्यदुःखवित्।\nकियत्तवेह जीवितं यमे न चास्ति वारकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2085743, "chapter_id": 2824, "verse_number": "१२-३२९-३६", "content_sanskrit": "पुरा विवाति मारुतो यमस्य यः पुरःसरः।\nपुरैक एव नीयसे कुरुष्व सांपरायिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2085744, "chapter_id": 2824, "verse_number": "१२-३२९-३७", "content_sanskrit": "पुरा स एक एव ते प्रवाति मारुतोऽन्तकः।\nपुरा च विभ्रमन्ति ते दिशो महाभयागमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2085745, "chapter_id": 2824, "verse_number": "१२-३२९-३८", "content_sanskrit": "श्रुतिश्च सन्निरुध्यते पुरा तवेह पुत्रक।\nसमाकुलस्य गच्छतः समाधिमुत्तमं कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2085746, "chapter_id": 2824, "verse_number": "१२-३२९-३९", "content_sanskrit": "शुभाशुभे पुरा कृते प्रमादकर्मविप्लुते।\nस्मरन्पुराऽनुतप्यसे निधत्स्व केवलं निधिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2085747, "chapter_id": 2824, "verse_number": "१२-३२९-४०", "content_sanskrit": "पुरा जरा कलेवरं विजर्झरीकरोति ते।\nबलाङ्गरूपहारिणी निधत्स्व केवलं निधिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2085748, "chapter_id": 2824, "verse_number": "१२-३२९-४१", "content_sanskrit": "पुरा शरीरमन्तको भिनत्ति रोगसायकैः।\nप्रसह्य जीवितक्षये तपो महत्समारभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2085749, "chapter_id": 2824, "verse_number": "१२-३२९-४२", "content_sanskrit": "पुरा वृका भयंकरा मनुष्यदेहगोचराः।\nअभिद्रवन्ति सर्वतो यतस्व पुण्यशीलने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2085750, "chapter_id": 2824, "verse_number": "१२-३२९-४३", "content_sanskrit": "पुरान्धकारमेककोऽनुपश्यसि त्वरस्व वै।\nपुरा हिरण्मयान्नगान्निरीक्षसेऽद्रिमूर्धनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2085751, "chapter_id": 2824, "verse_number": "१२-३२९-४४", "content_sanskrit": "पुरा कुसङ्गतानि ते सुहृन्मुखाश्च शत्रवः।\nविचालयन्ति दर्शनाद्धटस्व पुत्र यत्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2085752, "chapter_id": 2824, "verse_number": "१२-३२९-४५", "content_sanskrit": "धनस्य यस्य राजतो भयं न चास्ति चोरतः।\nमृतं च यन्न मुञ्चति समार्जयस्व तद्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2085753, "chapter_id": 2824, "verse_number": "१२-३२९-४६", "content_sanskrit": "न तत्र संविभज्यते स्वकर्मभिः परस्परम्।\nयदेव यस्य यौतकं तदेव तत्र सोऽश्नृते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2085754, "chapter_id": 2824, "verse_number": "१२-३२९-४७", "content_sanskrit": "परत्र तेन जीव्यते तदेव पुत्र जीयताम्।\nधनं यदक्षरं ध्रुवं समार्जयस्व तत्स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2085755, "chapter_id": 2824, "verse_number": "१२-३२९-४८", "content_sanskrit": "न यावदेव पच्यते महाजनस्य यावकम्।\nअपक्व एव यावके पुरा प्रलीयते त्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2085756, "chapter_id": 2824, "verse_number": "१२-३२९-४९", "content_sanskrit": "न मातृपुत्रबान्धवा न संस्तुतः प्रियो जनः।\nअनुव्रजन्ति संकटे व्रजन्तमेकपातिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2085757, "chapter_id": 2824, "verse_number": "१२-३२९-५०", "content_sanskrit": "यदेव कर्म केवलं पुराकृतं शुभाशुभम्।\nतदेव पुत्र यौतकं भवत्यमुत्र गच्छतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2085758, "chapter_id": 2824, "verse_number": "१२-३२९-५१", "content_sanskrit": "हिरण्यरत्नसंचयाः शुभाशुभेन संचिताः।\nन तस्य देहसंक्षये भवन्ति कार्यसाधकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2085759, "chapter_id": 2824, "verse_number": "१२-३२९-५२", "content_sanskrit": "न पुत्र शान्तिरस्ति ते कृताकृतस्य कर्मणः।\nन साक्षिकोऽऽत्मना समो नृणामिहास्ति कश्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2085760, "chapter_id": 2824, "verse_number": "१२-३२९-५३", "content_sanskrit": "मनुष्यदेहशून्यकं भवत्यमुत्र गच्छतः।\nप्रविश्य बुद्धिचक्षुषा प्रदृश्यते हि सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2085761, "chapter_id": 2824, "verse_number": "१२-३२९-५४", "content_sanskrit": "इहाग्निसूर्यवायवः शरीरमाश्रितास्त्रयः।\nत एव तस्य साक्षिणो भवन्ति धर्मदर्शिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2085762, "chapter_id": 2824, "verse_number": "१२-३२९-५५", "content_sanskrit": "अहनिंशेषु सर्वतः स्पृशत्सु सर्वचारिषु।\nप्रकाशगूढवृत्तिषु स्वधर्ममेव पालय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2085763, "chapter_id": 2824, "verse_number": "१२-३२९-५६", "content_sanskrit": "अनेकपारिपान्थके विरूपरौद्रमक्षिके।\nस्वमेव कर्म रक्ष्यतां स्वकर्म तत्र गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2085764, "chapter_id": 2824, "verse_number": "१२-३२९-५७", "content_sanskrit": "न तत्र संविभज्यते स्वकर्मभिः परस्परम्।\nतथा कृतं स्वकर्मजं तदेव भुज्यते फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2085765, "chapter_id": 2824, "verse_number": "१२-३२९-५८", "content_sanskrit": "यथाऽप्सरोगणाः फलं सुखं महर्षिभिः सह।\nतथाऽऽप्नुवन्ति कर्मजं विमानकामगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2085766, "chapter_id": 2824, "verse_number": "१२-३२९-५९", "content_sanskrit": "यथेह यत्कृतं शुभं विपाप्मभिः कृतात्मभिः।\nतदाप्नुवन्ति मानवास्तथा विशुद्धयोनयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2085767, "chapter_id": 2824, "verse_number": "१२-३२९-६०", "content_sanskrit": "प्रजापतेः सलोकतां बृहस्पतेः शतक्रतोः।\nव्रजन्ति ते परां गतिं गृहस्थधर्मसेतुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2085768, "chapter_id": 2824, "verse_number": "१२-३२९-६१", "content_sanskrit": "सहस्रशोऽप्यनेकशः प्रवक्तुमुत्सहामहे।\nअबुद्धिमोहनं पुनः प्रभुस्तु तेन पावकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2085769, "chapter_id": 2824, "verse_number": "१२-३२९-६२", "content_sanskrit": "गता त्रिरष्टवर्षता ध्रुवोऽसि पञ्चविंशकः।\nकुरष्व धर्मसंचयं वयो हि तेऽतिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2085770, "chapter_id": 2824, "verse_number": "१२-३२९-६३", "content_sanskrit": "पुरा करोति सोऽन्तकः प्रमादगोमुखां चमूम्।\nयथागृहीतमुत्थितस्त्वरस्व धर्मपालने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2085771, "chapter_id": 2824, "verse_number": "१२-३२९-६४", "content_sanskrit": "यथा त्वमेव पृष्ठतस्त्वमग्रतो गमिष्यसि।\nतथा गतिं गमिष्यतः किमात्मना परेण वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2085772, "chapter_id": 2824, "verse_number": "१२-३२९-६५", "content_sanskrit": "यदेकपातिनां सतां भवत्यमुत्र गच्छताम्।\nभयेषु सांपरायिकं निधत्स्व केवलं निधिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2085773, "chapter_id": 2824, "verse_number": "१२-३२९-६६", "content_sanskrit": "सतूलमूलबान्धवं प्रभुर्हरत्यसङ्गवान्।\nन सन्ति यस्य वारकाः कुरष्व धर्मसंनिधिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2085774, "chapter_id": 2824, "verse_number": "१२-३२९-६७", "content_sanskrit": "इदं निदर्शनं मया तवेह पुत्र संमतम्।\nस्वदर्शनानुपानतः प्रवर्णितं कुरुष्व तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2085775, "chapter_id": 2824, "verse_number": "१२-३२९-६८", "content_sanskrit": "ददाति यः स्वकर्मणा धनानि यस्यकस्यचित्।\nअबुद्धिमोहजैर्गुणैः स एक एव युज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2085776, "chapter_id": 2824, "verse_number": "१२-३२९-६९", "content_sanskrit": "शुभं समस्तमश्नुते प्रकुर्वतः शुभाः क्रियाः।\nतदेतदर्थदर्शनं कृतज्ञमर्थसंहितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2085777, "chapter_id": 2824, "verse_number": "१२-३२९-७०", "content_sanskrit": "निबन्धनी रज्जुरेषा या ग्रामे वसतो रतिः।\nछित्त्वैतां सुकृतो यान्ति नैनां छिदन्ति दुष्कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2085778, "chapter_id": 2824, "verse_number": "१२-३२९-७१", "content_sanskrit": "किं ते धनेन किं बन्धुभिस्ते\nकिं ते पुत्रैः पुत्रक यो मरिष्यसि।\nआत्मानमन्विच्छ गुहां प्रविष्टं\nपितामहास्ते क्व गताश्च सर्वे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2085779, "chapter_id": 2824, "verse_number": "१२-३२९-७२", "content_sanskrit": "श्वः कार्यमद्ये कुर्वीत पूर्वाह्णे चापराह्णिकम्।\nन हि प्रतीक्षते मृत्युः कृतं वाऽस्य न वाऽकृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2085780, "chapter_id": 2824, "verse_number": "१२-३२९-७३", "content_sanskrit": "अनुगम्य विनाशान्ते निवर्तन्ते ह बान्धवाः।\nअग्नौ प्रक्षिप्य पुरुषं ज्ञातयः सुहृदस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2085781, "chapter_id": 2824, "verse_number": "१२-३२९-७४", "content_sanskrit": "नास्तिकान्निरनुक्रोशान्नरान्पापमते स्थितान्।\nवामतः कुरु विस्रब्धं परं प्रेप्सुरतन्द्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2085782, "chapter_id": 2824, "verse_number": "१२-३२९-७५", "content_sanskrit": "एवमभ्याहते लोके कालेनोपनिपीडिते।\nसुमहद्धैर्यमालम्ब्य धर्मं सर्वात्मना कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2085783, "chapter_id": 2824, "verse_number": "१२-३२९-७६", "content_sanskrit": "अथेमं दर्शनोपायं सम्यग्यो वेत्ति मानवः।\nसम्यक् स्वधर्मं कृत्वेह परत्र सुखमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2085784, "chapter_id": 2824, "verse_number": "१२-३२९-७७", "content_sanskrit": "न देहभेदे मरणं विजानतां\nन च प्रणाशः स्वनुपालिते पथि।\nधर्मं हि यो बर्धयते स पण़्डितो\nय एव धर्माच्च्यवते स दह्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2085785, "chapter_id": 2824, "verse_number": "१२-३२९-७८", "content_sanskrit": "प्रयुक्तयोः कर्मपथि स्वकर्मणोः\nफलं प्रयोक्ता लभते यथाविधि।\nनिहीनकर्मा निरयं प्रपद्यते\nत्रिविष्टपं गच्छति धर्मपारगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2085786, "chapter_id": 2824, "verse_number": "१२-३२९-७९", "content_sanskrit": "सोपानभूतं स्वर्गस्य मानुष्यं प्राप्य दुर्लभम्।\nतथाऽऽत्मानं समादध्याद्धश्यते न पुनर्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2085787, "chapter_id": 2824, "verse_number": "१२-३२९-८०", "content_sanskrit": "यस्य नोत्क्रामति मतिः स्वर्गमार्गानुसारिणी।\nतमाहुः पुण्यकर्माणमशोच्यं मित्रबान्धवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2085788, "chapter_id": 2824, "verse_number": "१२-३२९-८१", "content_sanskrit": "यस्य नोपहता बुद्धिर्निश्चये ह्यवलम्बते।\nस्वर्गे कृतावकाशस्य नास्ति तस्य महद्भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2085789, "chapter_id": 2824, "verse_number": "१२-३२९-८२", "content_sanskrit": "तपोवनेषु ये जातास्तत्रैव निधनं गताः।\nतेषामल्पतरो धर्मः कामभोगानजानताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2085790, "chapter_id": 2824, "verse_number": "१२-३२९-८३", "content_sanskrit": "यस्तु भोगान्परित्यज्य शरीरेण तपश्चरेत्।\nन तेन किंचिन्न प्राप्तं तन्मे बहुमतं फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2085791, "chapter_id": 2824, "verse_number": "१२-३२९-८४", "content_sanskrit": "मातापितृसहस्राणि पुत्रदारशतानि च।\nअनागतान्यतीतानि कस्य ते कस्य वा वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2085792, "chapter_id": 2824, "verse_number": "१२-३२९-८५", "content_sanskrit": "अहमेको न मे कश्चिन्नाहमन्यस्य कस्यचित्।\nन तं पश्यामि यस्याहं तन्न पश्यामि यो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2085793, "chapter_id": 2824, "verse_number": "१२-३२९-८६", "content_sanskrit": "न तेषां भवता कार्यं न कार्यं तव तैरपि।\nस्वकृतैस्तानि जातानि भवांश्चैव गमिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2085794, "chapter_id": 2824, "verse_number": "१२-३२९-८७", "content_sanskrit": "इह लोके हि धनिना परोऽपि स्वजनायते।\nस्वजनस्तु दरिद्राणां जीवतामपि नश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2085795, "chapter_id": 2824, "verse_number": "१२-३२९-८८", "content_sanskrit": "संचिनोत्यशुभं कर्म कलत्रापेक्षया नरः।\nततः क्लेशमवाप्नोति परत्रेह तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2085796, "chapter_id": 2824, "verse_number": "१२-३२९-८९", "content_sanskrit": "पश्यति च्छिन्नभूतं हि जीवलोकं स्वकर्मणा।\nतत्कुरुष्व तथा पुत्र कृत्स्नं यत्समुदाहृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2085797, "chapter_id": 2824, "verse_number": "१२-३२९-९०", "content_sanskrit": "तदेतत्संप्रदृश्यैव कर्म भूमिं प्रपश्यतः।\nशुभान्याचरितव्यानि परलोकमभीप्सता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2085798, "chapter_id": 2824, "verse_number": "१२-३२९-९१", "content_sanskrit": "मासर्तुसंज्ञापरिवर्तकेन\nसूर्याग्निना रात्रिदिवेन्धनेन।\nस्वकर्मनिष्ठाफलसाक्षिकेण\nभूतानि कालः पचति प्रसह्य॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2085799, "chapter_id": 2824, "verse_number": "१२-३२९-९२", "content_sanskrit": "धनेन किं यन्न ददाति नाश्नुते\nबलेन किं येन रिपुं न बाधते।\nश्रुतेन किं येन न धर्ममाचरे\nत्किमात्मना यो न जितेन्द्रियो वशी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2085800, "chapter_id": 2824, "verse_number": "१२-३२९-९३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2085801, "chapter_id": 2824, "verse_number": "१२-३२९-९३", "content_sanskrit": "इदं द्वैपायनवचो हितमुक्तं निशम्य तु।\nशुको गतः परित्यज्य पितरं मोक्षदैशिकम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2085802, "chapter_id": 2824, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि एकोनत्रिंशदधिकत्रिशततमोऽध्यायः॥ ३२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}]