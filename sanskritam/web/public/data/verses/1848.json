[{"id": 2038790, "chapter_id": 1848, "verse_number": "५-९३-०x", "content_sanskrit": "` वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2038791, "chapter_id": 1848, "verse_number": "५-९३-१", "content_sanskrit": "विदुरस्य वचः श्रुत्वा प्रश्रितं पुरुषोत्तमः ।\nइदं होवाच वचनं मधुरं मधुसूदनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2038792, "chapter_id": 1848, "verse_number": "५-९३-२x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2038793, "chapter_id": 1848, "verse_number": "५-९३-२", "content_sanskrit": "यथा व्रूयान्महाप्राज्ञो यथा ब्रूयाद्विचक्षणः।\nसथा वाच्यस्त्वद्विधेन भवता मद्विधः सुहृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2038794, "chapter_id": 1848, "verse_number": "५-९३-३", "content_sanskrit": "धर्मार्थयुक्तं तथ्यं च यथा त्वय्युपपद्यते।\nतथा वचनमुक्तोऽस्ति त्वयैतत्पितृमातृवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2038795, "chapter_id": 1848, "verse_number": "५-९३-४", "content_sanskrit": "सत्यं प्राप्तं च युक्तं वाऽप्येवमेव यथाऽऽत्थ माम्।\nश्रृणुष्वागमने हेतुं विदुरावहितो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2038796, "chapter_id": 1848, "verse_number": "५-९३-५", "content_sanskrit": "दौरात्म्यं धार्तराष्ट्रस्य क्षत्रियाणां च वैरिताम्।\nसर्वमेतदहं जानन्क्षत्तः प्राप्तोऽद्य कौरवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2038797, "chapter_id": 1848, "verse_number": "५-९३-६", "content_sanskrit": "पर्यस्तां पृथिवीं सर्वां साश्वां सरथकुञ्जराम् ।\nयो मोचयेन्मृत्युपाशात्प्राप्नुयाद्धर्ममुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2038798, "chapter_id": 1848, "verse_number": "५-९३-७", "content_sanskrit": "धर्मकार्यं यतञ्शक्त्या नो चेत्प्राप्नोति मानवः ।\nप्राप्तो भवति तत्पुण्यमत्र मे नास्ति संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2038799, "chapter_id": 1848, "verse_number": "५-९३-८", "content_sanskrit": "मनसा चिन्तयन्पापं कर्मणा नातिरोचयन्।\nन प्राप्नोति फलं तस्येत्येवं धर्मविदो विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2038800, "chapter_id": 1848, "verse_number": "५-९३-९", "content_sanskrit": "सोऽहं यतिष्ये प्रशमं क्षत्तः कर्तुममायया।\nकुरूणां सृञ्जयानां च सङ्ग्राने विनशिष्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2038801, "chapter_id": 1848, "verse_number": "५-९३-१०", "content_sanskrit": "सेयमापन्महाघोरा कुरुष्वेव समुत्थिता ।\nकर्णदुर्योधनकृता सर्वे ह्येते तदन्वयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2038802, "chapter_id": 1848, "verse_number": "५-९३-११", "content_sanskrit": "व्यसने क्लिश्यमानं हि यो मित्रं नाभिपद्यते ।\nअनुनीय यथाशक्ति तं नृशंसं विदुर्बुधाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2038803, "chapter_id": 1848, "verse_number": "५-९३-१२", "content_sanskrit": "आकेशग्रहणान्मित्रमकार्यात्संनिवर्तयन्।\nअवाच्यः कस्यचिद्भवति कृतयत्नो यथाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2038804, "chapter_id": 1848, "verse_number": "५-९३-१३", "content_sanskrit": "तत्समर्थं शुभं वाक्यं धर्मार्थसहितं हितम्।\nधार्तराष्ट्रः सहामात्यो ग्रहीतुं विदुरार्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2038805, "chapter_id": 1848, "verse_number": "५-९३-१४", "content_sanskrit": "हितं हि धार्तराष्ट्राणां पाण्डवानां तथैव च ।\nपृथिव्यां क्षत्रियाणां च यतिष्येऽहममायया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2038806, "chapter_id": 1848, "verse_number": "५-९३-१५", "content_sanskrit": "हिते प्रयतमानं मां शङ्केद्दुर्योधनो यदि।\nहृदयस्य च मे प्रीतिरानृण्यं च भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2038807, "chapter_id": 1848, "verse_number": "५-९३-१६", "content_sanskrit": "ज्ञातीनां हि मिथो भेदे यन्मित्रं नाभिपद्यते ।\nसर्वयत्नेन माध्यस्थ्यं न तन्मित्रं विदुर्बुधाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2038808, "chapter_id": 1848, "verse_number": "५-९३-१७", "content_sanskrit": "न मां ब्रूयुरधर्मिष्ठा मूढा ह्यसुहृदस्तथा ।\nशक्तो नावारयत्कृष्णः संरब्धान्कुरुपाण्डवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2038809, "chapter_id": 1848, "verse_number": "५-९३-१८", "content_sanskrit": "उभयोः साधयन्नर्थमहामागत इत्युत ।\nतत्र यत्नमहं कृत्वा गच्छेयं नृष्ववाच्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2038810, "chapter_id": 1848, "verse_number": "५-९३-१९", "content_sanskrit": "मम धर्मार्थयुक्तं हि श्रुत्वा वाक्यमनामयम्।\nन चेदादास्यते बालो दिष्टस्य वशमेष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2038811, "chapter_id": 1848, "verse_number": "५-९३-२०", "content_sanskrit": "अहापयन्पाण्डवार्थं यथाव-\nच्छमं कुरूणां यदि चाचरेयम्।\nपुण्यं च मे स्याच्चरितं महात्म-\nन्मुच्येरंश्च कुरवो मृत्युपाशात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2038812, "chapter_id": 1848, "verse_number": "५-९३-२१", "content_sanskrit": "अपि वाचं भाषमाणस्य काव्यां\nधर्मरामामर्थवतीमहिंस्राम्।\nअवेक्षेरन्धार्तराष्ट्राः शमार्थं\nमां च प्राप्तं कुरवः पूजयेयुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2038813, "chapter_id": 1848, "verse_number": "५-९३-२२", "content_sanskrit": "न चापि मम पर्याप्ताः सहिताः सर्वपार्थिवाः।\nक्रुद्धस्य प्रमुखे स्थातुं सिंहस्येवेतरे मृगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2038814, "chapter_id": 1848, "verse_number": "५-९३-२३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2038815, "chapter_id": 1848, "verse_number": "५-९३-२३", "content_sanskrit": "इत्येवमुक्त्वा वचनं वृष्णीनामृषभस्तदा।\nशयने सुखसंस्पर्शे शिश्ये यदुसुखावहः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2038816, "chapter_id": 1848, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि त्रिनवतितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]