[{"id": 2004896, "chapter_id": 1097, "verse_number": "१-९८-१", "content_sanskrit": "एवमुक्ता वरारोहा व्रीडितेव मनस्विनी।\nविसंज्ञेव च दुःखेन तस्थौ स्थूणेव निश्चला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2004897, "chapter_id": 1097, "verse_number": "१-९८-२", "content_sanskrit": "संरम्भामर्षताम्राक्षी स्फुरमाणोष्ठसंपुटा।\nकटाक्षैर्निर्दहन्तीव तिर्यग्राजानमैक्षत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2004898, "chapter_id": 1097, "verse_number": "१-९८-३", "content_sanskrit": "आकारं गूहमाना च मन्युना च समीरितम्।\nतपसा संभृतं तेजो धारयामास वै तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2004899, "chapter_id": 1097, "verse_number": "१-९८-४", "content_sanskrit": "सा मुहूर्तमिव ध्यात्वा दुःखामर्षसमन्विता।\nभर्तारमभिसंप्रेक्ष्य यथान्यायं वचोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2004900, "chapter_id": 1097, "verse_number": "१-९८-५", "content_sanskrit": "जानन्नपि महाराज कस्मादेवं प्रभाषसे।\nन जानामीति निःशङ्कं यथान्यः प्राकृतस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2004901, "chapter_id": 1097, "verse_number": "१-९८-६", "content_sanskrit": "तस्य ते हृदयं वेद सत्यस्यैवानृतस्य च।\nसाक्षिणं बत कल्याणमात्मानमवमन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2004902, "chapter_id": 1097, "verse_number": "१-९८-७", "content_sanskrit": "योऽन्यथा सन्तमात्मानन्यथा प्रतिपद्यते।\nकिं तेन न कृतं पापं चोरेणात्मापहारिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2004903, "chapter_id": 1097, "verse_number": "१-९८-८", "content_sanskrit": "एकोऽहमस्मीति च मन्यसे त्वं\nन हृच्छयं वेत्सि मुनिं पुराणम्।\nयो वेदिता कर्मणः पापकस्य\nतस्यान्तिके त्वं वृजिनं करोषि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2004904, "chapter_id": 1097, "verse_number": "१-९८-९", "content_sanskrit": "धर्म एव हि साधूनां सर्वेषां हितकारणम्।\nनित्यं मिथ्याविहीनानां न च दुःखावहो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2004905, "chapter_id": 1097, "verse_number": "१-९८-१०", "content_sanskrit": "मन्यते पापकं कृत्वा न कश्चिद्वेत्ति मामिति।\nविदन्ति चैनं देवाश्च यश्चैवान्तरपूरुषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2004906, "chapter_id": 1097, "verse_number": "१-९८-११", "content_sanskrit": "आदित्यचन्द्रावनिलोऽनलश्च\nद्यौर्भूमिरापो हृदयं यमश्च।\nअहश्च रात्रिश्च उभे च सन्ध्ये\nधर्मश्च जानाति नरस्य वृत्तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2004907, "chapter_id": 1097, "verse_number": "१-९८-१२", "content_sanskrit": "यमो वैवस्वतस्तस्य निर्यातयति दुष्कृतम्।\nहृदि स्थितः कर्मसाक्षी क्षेत्रज्ञो यस्य तुष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2004908, "chapter_id": 1097, "verse_number": "१-९८-१३", "content_sanskrit": "न तुष्यति च यस्यैष पुरुषस्य दुरात्मनः।\nतं यमः पापकर्माणं निर्भर्त्सयति दुष्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2004909, "chapter_id": 1097, "verse_number": "१-९८-१४", "content_sanskrit": "योऽवमत्यात्मनात्मानमन्यथा प्रतिपद्यते।\nन तस्य देवाः श्रेयांसो यस्यात्मापि न कारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2004910, "chapter_id": 1097, "verse_number": "१-९८-१५", "content_sanskrit": "स्वयं प्राप्तेति मामेवं मावमंस्था पतिव्रताम्।\nअर्चार्हां नार्चयसि मां स्वयं भार्यामुपस्थिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2004911, "chapter_id": 1097, "verse_number": "१-९८-१६", "content_sanskrit": "किमर्थं मां प्राकृतवदुपप्रेक्षसि संसदि।\nनखल्वहमिदं शून्ये रौमि किं न शृणोषि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2004912, "chapter_id": 1097, "verse_number": "१-९८-१७", "content_sanskrit": "यदि मे याचमानाया वचनं न करिष्यसि।\nदुष्यन्त शतधा त्वद्य मूर्धा ते विफलिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2004913, "chapter_id": 1097, "verse_number": "१-९८-१८", "content_sanskrit": "जायां पतिः संप्रविश्य यदस्यां जायते पुनः।\nजायायास्तद्धि जायात्वं पौराणाः कवयो विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2004914, "chapter_id": 1097, "verse_number": "१-९८-१९", "content_sanskrit": "यदागमवतः पुंसस्तदपत्यं प्रजायते।\nतत्तारयति संतत्या पूर्वप्रेतान्पितामहान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2004915, "chapter_id": 1097, "verse_number": "१-९८-२०", "content_sanskrit": "पुन्नाम्नो नरकाद्यस्मात्पितरं त्रायते सुतः।\nतस्मात्पुत्र इति प्रोक्तः पूर्वमेव स्वयंभुवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2004916, "chapter_id": 1097, "verse_number": "१-९८-२१", "content_sanskrit": "पुत्रेण लोकाञ्जयन्ति पौत्रेणानन्त्यमश्नुते।\nअथ पौत्रस्य पुत्रेण मोदन्ते प्रपितामहाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2004917, "chapter_id": 1097, "verse_number": "१-९८-२२", "content_sanskrit": "सा भार्या या गृहे दक्षा सा भार्या या प्रजावती।\nसा भार्या या पतिप्राणा सा भार्या या पतिव्रता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2004918, "chapter_id": 1097, "verse_number": "१-९८-२३", "content_sanskrit": "अर्धं भार्या मनुष्यस्य भार्या श्रेष्ठतमः सखा।\nभार्या मूलं त्रिवर्गस्य यः सभार्यः स बन्धुमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2004919, "chapter_id": 1097, "verse_number": "१-९८-२४", "content_sanskrit": "भार्यावन्तः क्रियावन्तः सभार्या गृहमेधिनः।\nभार्यावन्तः प्रमोदन्ते भार्यावन्तः श्रियावृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2004920, "chapter_id": 1097, "verse_number": "१-९८-२५", "content_sanskrit": "सखायः प्रविविक्तेषु भवन्त्येताः प्रियंवदाः।\nपितरो धर्मकार्येषु भवन्त्यार्तस्य मातरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2004921, "chapter_id": 1097, "verse_number": "१-९८-२६", "content_sanskrit": "कान्तारेष्वपि विश्रामो जनस्याध्वनि कस्य वै।\nयः सदारः स विश्वास्यस्तस्माद्दाराः परा गतिः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2004922, "chapter_id": 1097, "verse_number": "१-९८-२७", "content_sanskrit": "संसरन्तमभिप्रेतं विषमेष्वेकपातिनम्।\nभार्यैवान्वेति भर्तारं सततं या पतिव्रता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2004923, "chapter_id": 1097, "verse_number": "१-९८-२८", "content_sanskrit": "प्रथमं संस्थिता भार्या पतिं प्रेत्य प्रतीक्षते।\nपूर्वप्रेतं तु भर्तारं पश्चात्साप्यनुगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2004924, "chapter_id": 1097, "verse_number": "१-९८-२९", "content_sanskrit": "एतस्मात्कारणाद्राजन्पाणिग्रहणमिष्यते।\nयदाप्नोति पतिर्भार्यामिह लोके परत्र च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2004925, "chapter_id": 1097, "verse_number": "१-९८-३०", "content_sanskrit": "पोषणार्थं शरीरस्य पाथेयं स्वर्गतस्य वै।\nआत्माऽऽत्मनैव जनितः पुत्र इत्युच्यते बुधैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2004926, "chapter_id": 1097, "verse_number": "१-९८-३१", "content_sanskrit": "तस्माद्भार्यां पतिः पश्येन्मातृवत्पुत्रमातरम्।\nअन्तरात्मैव सर्वस्य पुत्रो नामोच्यते सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2004927, "chapter_id": 1097, "verse_number": "१-९८-३२", "content_sanskrit": "गती रूपं च चेष्टा च आवर्ता लक्षणानि च।\nपितॄणां यानि दृश्यन्ते पुत्राणां सन्ति तानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2004928, "chapter_id": 1097, "verse_number": "१-९८-३३", "content_sanskrit": "तेषां शीलगुणाचारास्तत्संपर्काच्छुभाशुभात्।\nभार्यायां जनितं पुत्रमादर्शे स्वमिवाननम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2004929, "chapter_id": 1097, "verse_number": "१-९८-३४", "content_sanskrit": "जनिता मोदते प्रेक्ष्य स्वर्गं प्राप्येव पुण्यकृत्।\nपतिव्रतारूपधराः परबीजस्य संग्रहात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2004930, "chapter_id": 1097, "verse_number": "१-९८-३५", "content_sanskrit": "कुलं विनाश्य भर्तॄणां नरकं यान्ति दारुणम्।\nपरेण जनिताः पुत्राः स्वभार्यायां यथेष्टतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2004931, "chapter_id": 1097, "verse_number": "१-९८-३६", "content_sanskrit": "मम पुत्रा इति मतास्ते पुत्रा अपि शत्रवः।\nद्विषन्ति प्रतिकुर्वन्ति न ते वचनंकारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2004932, "chapter_id": 1097, "verse_number": "१-९८-३७", "content_sanskrit": "द्वेष्टि तांश्च पिता चापि स्वबीजे न तथा नृप।\nन द्वेष्टि पितरं पुत्रो जनितारमथापि वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2004933, "chapter_id": 1097, "verse_number": "१-९८-३८", "content_sanskrit": "न द्वेष्टि जनिता पुत्रं तस्मादात्मा सुतो भवेत्।\nदह्यमाना मनोदुःखैर्व्याधिभिस्तुमुलैर्जनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2004934, "chapter_id": 1097, "verse_number": "१-९८-३९", "content_sanskrit": "ह्लादन्ते स्वेषु दारेषु घर्मार्ताः सलिलेष्विव।\nविप्रवासकृशा दीना नरा मलिनवाससः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2004935, "chapter_id": 1097, "verse_number": "१-९८-४०", "content_sanskrit": "तेऽपि स्वदारांस्तुष्यन्ति दरिद्रा धनलाभवत्।\nअप्रियोक्तोपि दाराणां न ब्रूयादप्रियं बुधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2004936, "chapter_id": 1097, "verse_number": "१-९८-४१", "content_sanskrit": "रतिं प्रीतिं च धर्मं च तदायत्तमवेक्ष्य च।\nआत्मनोऽर्धमिति श्रौतं सा रक्षति धनं प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2004937, "chapter_id": 1097, "verse_number": "१-९८-४२", "content_sanskrit": "शरीरं लोकयात्रां वै धर्मं स्वर्गमृषीन्पितॄन्।\nआत्मनो जन्मनः क्षेत्रं पुण्या रामाः सनातनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2004938, "chapter_id": 1097, "verse_number": "१-९८-४३", "content_sanskrit": "ऋषीणामपि का शक्तिः स्रष्टुं रामामृते प्रजा-।\nदेवानामपि का शक्तिः कर्तुं संभवमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2004939, "chapter_id": 1097, "verse_number": "१-९८-४४", "content_sanskrit": "पण्डितस्यापि लोकेषु स्त्रीषु सृष्टिः प्रतिष्ठिता।\nऋषिभ्यो ह्यृषयः केचिच्चण्डालीष्वपि जज्ञिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2004940, "chapter_id": 1097, "verse_number": "१-९८-४५", "content_sanskrit": "परिसृत्य यथा सूनुर्धरणीरेणुकुण्ठितः।\nपितुरालिङ्गतेऽङ्गानि किमस्त्यभ्यधिकं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2004941, "chapter_id": 1097, "verse_number": "१-९८-४६", "content_sanskrit": "स त्वं सूनुमनुप्राप्तं साभिलाषं मनस्विनम्।\nप्रेक्षमाणं कटाक्षेण किमर्थमवमन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2004942, "chapter_id": 1097, "verse_number": "१-९८-४७", "content_sanskrit": "अण्डानि बिभ्रति स्वानि न त्यजन्ति पिपीलिकाः।\nकिं पुनस्त्वं न मन्येथाः सर्वथा पुत्रमीदृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2004943, "chapter_id": 1097, "verse_number": "१-९८-४८", "content_sanskrit": "न भरेथाः कथं नु त्वं मयि जातं स्वमात्मजम्।\nममाण्डानीति वर्ध्ते कोकिलाण्डानि वायसाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2004944, "chapter_id": 1097, "verse_number": "१-९८-४९", "content_sanskrit": "किं पुनस्त्वं न मन्येथाः सर्वज्ञः पुत्रमीदृशम्।\nमलयाच्चन्दनं जातमतिशीतं वदन्ति वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2004945, "chapter_id": 1097, "verse_number": "१-९८-५०", "content_sanskrit": "शिशोरालिङ्गनं तस्माच्चन्दनादधिकं भवेत्।\nन वाससां न रामाणां नापां स्पर्शस्तथाविधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2004946, "chapter_id": 1097, "verse_number": "१-९८-५१", "content_sanskrit": "शिशुनालिङ्ग्यमानस्य स्पर्शः सूनोर्यथा सुखः।\nपुत्रस्पर्शात्प्रियतरः स्पर्शो लोके न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2004947, "chapter_id": 1097, "verse_number": "१-९८-५२", "content_sanskrit": "स्पृशतु त्वां समालिङ्ग्य पुत्रोऽयं प्रियदर्शनः।\nब्राह्मणो द्विपदां श्रेष्ठो गौर्वरिष्ठा चतुष्पदाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2004948, "chapter_id": 1097, "verse_number": "१-९८-५३", "content_sanskrit": "मुरुर्गरीयसां श्रेष्ठः पुत्रः स्पर्शवतां वरः॥\nत्रिषु वर्षेषु पूर्णेषु प्रजातोऽयमरिन्दमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2004949, "chapter_id": 1097, "verse_number": "१-९८-५४", "content_sanskrit": "अद्यायं मन्नियोगात्तु तवाह्वानं प्रतीक्षते।\nकुमारो राजशार्दूल तव शोकप्रणाशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2004950, "chapter_id": 1097, "verse_number": "१-९८-५५", "content_sanskrit": "आहर्ता वाजिमेधस्य शतसङ्ख्यस्य पौरवः।\nराजसूयादिकानन्यान्क्रतूनमितदक्षिणान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2004951, "chapter_id": 1097, "verse_number": "१-९८-५६", "content_sanskrit": "इति गौरन्तरिक्षे मां सूतके ह्यवदत्पुरा।\nहन्त स्वमङ्कमारोप्य स्नेहाद्ग्रामान्तरं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2004952, "chapter_id": 1097, "verse_number": "१-९८-५७", "content_sanskrit": "मूर्ध्नि पुत्रानुपाघ्राय प्रतिनन्दन्ति मानवाः।\nवेदेष्वपि वदन्तीमं मन्त्रग्रामं द्विजातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2004953, "chapter_id": 1097, "verse_number": "१-९८-५८", "content_sanskrit": "जातकर्मणि पुत्राणां तवापि विदितं ध्रुवम्।\nअङ्गादङ्गात्संभवसि हृदयादधिजायसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2004954, "chapter_id": 1097, "verse_number": "१-९८-५९", "content_sanskrit": "आत्मा वै पुत्रनामासि स जीव शरदः शतम्।\nउपजिघ्रन्ति पितरो मन्त्रेणानेन मूर्धनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2004955, "chapter_id": 1097, "verse_number": "१-९८-६०", "content_sanskrit": "पोषणं त्वदधीनं मे सन्तानमपि चाक्षयम्।\nतस्मात्त्वं जीव मे पुत्र स सुखी शरदां शतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2004956, "chapter_id": 1097, "verse_number": "१-९८-६१", "content_sanskrit": "एको भूत्वा द्विधा भूत इति वादः प्रवर्तते।\nत्वदङ्गेभ्यः प्रसूतोऽयं पुरुषात्पुरुषः परः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2004957, "chapter_id": 1097, "verse_number": "१-९८-६२", "content_sanskrit": "सरसीवामलेऽऽत्मानं द्वितीयं पश्य ते सुतम्।\nसरसीवामले सोमं प्रेक्षात्मानं त्वमात्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2004958, "chapter_id": 1097, "verse_number": "१-९८-६३", "content_sanskrit": "यथाचाहवनीयोऽग्निर्वर्हपत्यात्प्रणीयते।\nएवं त्वत्तः प्रणीतोऽयं त्वमेकः सन्द्विधा कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2004959, "chapter_id": 1097, "verse_number": "१-९८-६४", "content_sanskrit": "मृगापकृष्टेन हि वै मृगयां परिधावता।\nअहमासादिता राजन्कुमारी पितुराश्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2004960, "chapter_id": 1097, "verse_number": "१-९८-६५", "content_sanskrit": "उर्वशी पूर्वचित्तिश्च सहजन्या च मेनका।\nविश्वाची च घृताची च षडेवाप्सरसां वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2004961, "chapter_id": 1097, "verse_number": "१-९८-६६", "content_sanskrit": "तासां वै मेनका नाम ब्रह्मयोनिर्वराप्सराः।\nदिवः संप्राप्य जगतीं विश्वामित्रादजीजनत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2004962, "chapter_id": 1097, "verse_number": "१-९८-६७", "content_sanskrit": "श्रीमानृषिर्धर्मपरो वैश्वानर इवापरः।\nब्रह्मयोनिः कुशो नाम विश्वामित्रपितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2004963, "chapter_id": 1097, "verse_number": "१-९८-६८", "content_sanskrit": "कुशस्य पुत्रो बलवान्कुशनाभश्च धार्मिकः।\nगाधिस्तस्य सुतो राजन्विश्वामित्रस्तु गाधिजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2004964, "chapter_id": 1097, "verse_number": "१-९८-६९", "content_sanskrit": "एवंविधो मम पिता मेनका जननी वरा।\nसा मां हिमवतः पृष्ठे सुषुवे मेनकाऽप्सराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2004965, "chapter_id": 1097, "verse_number": "१-९८-७०", "content_sanskrit": "परित्यज्य च मां याता परात्मजमिवासती।\nपक्षिणः पुम्यवन्तस्ते सहिता धर्मतस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2004966, "chapter_id": 1097, "verse_number": "१-९८-७१", "content_sanskrit": "पक्षैस्तैरभिगुप्ता च तस्मादस्मि शकुन्तला।\nततोऽहमृषिणा दृष्टा काश्यपेन महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2004967, "chapter_id": 1097, "verse_number": "१-९८-७२", "content_sanskrit": "जलार्थमग्निहोत्रस्य गतं दृष्ट्वा तु पक्षिणः।\nन्यासभूतामिव मुनेः प्रददुर्मां दयावतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2004968, "chapter_id": 1097, "verse_number": "१-९८-७३", "content_sanskrit": "कण्वस्त्वालोक्य मां प्रीतो हसन्तीति हविर्भुजः।\nस माऽरणिमिवादाय स्वमाश्रममुपागमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2004969, "chapter_id": 1097, "verse_number": "१-९८-७४", "content_sanskrit": "सा वै संभाविता राजन्ननुक्रोशान्महर्षिणा।\nतेनैव स्वसुतेवाहं राजन्वै वरवर्णिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2004970, "chapter_id": 1097, "verse_number": "१-९८-७५", "content_sanskrit": "विश्वामित्रसुता चाहं वर्धिता मुनिना नृप।\nयौवने वर्तमानां च दृष्टवानसि मां नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2004971, "chapter_id": 1097, "verse_number": "१-९८-७६", "content_sanskrit": "आश्रमे पर्णशालायां कुमारीं विजने तदा।\nधात्रा प्रचोदितां शून्ये पित्रा विरहितां मिथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2004972, "chapter_id": 1097, "verse_number": "१-९८-७७", "content_sanskrit": "वाग्भिस्त्वं सूनृताभिर्मामपत्यार्थमचूचुदः।\nअकार्षीस्त्वाश्रमे वासं धर्मकामार्थनिश्चितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2004973, "chapter_id": 1097, "verse_number": "१-९८-७८", "content_sanskrit": "गान्धर्वेण विवाहेन विधिना पाणिमग्रहीः।\nसाऽहं कुलं च शीलं च सत्यवादित्वमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2004974, "chapter_id": 1097, "verse_number": "१-९८-७९", "content_sanskrit": "स्वधर्मं च पुरस्कृत्य त्वामद्य शरणं गता।\nतस्मान्नर्हसि संश्रुत्य तथेति वितथं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2004975, "chapter_id": 1097, "verse_number": "१-९८-८०", "content_sanskrit": "स्वधर्मं पृष्ठतः कृत्वा परित्यक्तुमुपस्थिताम्।\nत्वन्नाथां लोकनाथस्त्वं नार्हसि त्वमनागसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2004976, "chapter_id": 1097, "verse_number": "१-९८-८१", "content_sanskrit": "किं नु कर्माशुभं पूर्वं कृतवत्यस्मि पार्थिव।\nयदहं बान्धवैस्त्यक्ता बाल्ये संप्रति वै त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2004977, "chapter_id": 1097, "verse_number": "१-९८-८२", "content_sanskrit": "कामं त्वया परित्यक्ता गमिष्याम्यहमाश्रमम्।\nइमं बालं तु संत्युक्तं नार्हस्यात्मजमात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2004978, "chapter_id": 1097, "verse_number": "१-९८-८३x", "content_sanskrit": "दुष्यन्त उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2004979, "chapter_id": 1097, "verse_number": "१-९८-८३", "content_sanskrit": "न पुत्रमभिजानामि त्वयि जातं शकुन्तले।\nअसत्वचना नार्यः कस्ते श्रद्धास्यते वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2004980, "chapter_id": 1097, "verse_number": "१-९८-८४", "content_sanskrit": "अश्रद्धेयमिदं वाक्यं कथयन्ती न लज्जसे।\nविशेषतो मत्सकाशे दुष्टतापसि गम्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2004981, "chapter_id": 1097, "verse_number": "१-९८-८५", "content_sanskrit": "क्व महर्षिस्तपस्युग्रः क्वाप्सराः सा च मेनका।\nक्व च त्वमेवं कृपणा तापसीवेषधारिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2004982, "chapter_id": 1097, "verse_number": "१-९८-८६", "content_sanskrit": "अतिकायश्च पुत्रस्ते बालोऽतिबलवानयम्।\nकथमल्पेन कालेन सालस्कन्ध इवोद्गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2004983, "chapter_id": 1097, "verse_number": "१-९८-८७", "content_sanskrit": "सुनिकृष्टा च योनिस्ते पुंश्चली प्रतिभासि मे।\nयदृच्छया कामरागाज्जाता मेनकया ह्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2004984, "chapter_id": 1097, "verse_number": "१-९८-८८", "content_sanskrit": "सर्वमेव परोक्षं मे यत्त्वं वदसि तापसि।\nसर्वा वामाः स्त्रियो लोके सर्वाः कामपरायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2004985, "chapter_id": 1097, "verse_number": "१-९८-८९", "content_sanskrit": "सर्वाः स्त्रियः परवशाः सर्वाः क्रोधसमाकुलाः।\nअसत्योक्ताः स्त्रियः सर्वा न कण्वं वक्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2004986, "chapter_id": 1097, "verse_number": "१-९८-९०", "content_sanskrit": "मेनका निरनुक्रोशा वर्धकी जननी तव।\nयया हिमवतः पादे निर्माल्यवदुपेक्षिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2004987, "chapter_id": 1097, "verse_number": "१-९८-९१", "content_sanskrit": "स चापि निरनुक्रोशः क्षत्रयोनिः पिता तव।\nविश्वामित्रो ब्राह्मणत्वे लुब्धः कामपरायणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2004988, "chapter_id": 1097, "verse_number": "१-९८-९२", "content_sanskrit": "सुषाव सुरनारी मां विश्वामित्राद्यथेष्टतः।\nअहो जानामि ते जन्म कुत्सितं कुलटे जनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2004989, "chapter_id": 1097, "verse_number": "१-९८-९३", "content_sanskrit": "मेनकाऽप्सरसां श्रेष्ठा महर्षिश्चापि ते पिता।\nतयोरपत्यं कस्मात्त्वं पुंश्चलीवाभिभाषसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2004990, "chapter_id": 1097, "verse_number": "१-९८-९४", "content_sanskrit": "जातिश्चापि निकृष्टो ते कुलीनेति विजल्पसे।\nजनयित्वा त्वमुत्सृष्टा कोकिलेन परैर्भृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2004991, "chapter_id": 1097, "verse_number": "१-९८-९५", "content_sanskrit": "अरिष्टैरिव दुर्बद्धिः कण्वो वर्धयिता पिता।\nअश्रद्धेयमिदं वाक्यं यत्त्वं जल्पसि तापसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2004992, "chapter_id": 1097, "verse_number": "१-९८-९६", "content_sanskrit": "ब्रुवन्ती राजसान्निध्ये गम्यतां यत्र चेच्छसि।\nसुवर्णमणिमुक्तानि वस्त्राण्याभरणानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2004993, "chapter_id": 1097, "verse_number": "१-९८-९७", "content_sanskrit": "यदिहेच्छसि भोगार्थं तापसि प्रतिगृह्यताम्।\nनाहं त्वां द्रष्टुमिच्छामि यथेष्टं गम्यतामितः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2004994, "chapter_id": 1097, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि अष्टनवतितमोऽध्यायः॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}]