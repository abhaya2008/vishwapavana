[{"id": 7003578000, "chapter_id": 23578, "verse_number": "२१८-१", "content_sanskrit": "त्रिःसप्तषट्क्षितिमिते नृपविक्रमस्य काले गते भगवतो हरिबोधनस्य ।\nवीरेश्वरेण सह माधवभद्रनाम्ना काश्यां वराहकथितं लिखितं पुराणम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003578001, "chapter_id": 23578, "verse_number": "२१८-२", "content_sanskrit": "वराहस्य पुराणस्य वृत्तान्तान्प्रब्रवीम्यहम् ।\nआदौ सम्बन्धकथनं वृत्तान्तश्चादिकल्पकः॥ २॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003578002, "chapter_id": 23578, "verse_number": "२१८-३", "content_sanskrit": "आदिसृष्टिस्ततः प्रोक्ता चरितं दुर्जनस्य च ।\nवृत्तान्तोद्देशभागश्च श्राद्धकल्पस्ततः परम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003578003, "chapter_id": 23578, "verse_number": "२१८-४", "content_sanskrit": "आदिवृत्तान्तकथने सरमाख्यानमेव च ।\nमहातपोपाख्यानं च अग्न्युत्पत्तिस्ततः परम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003578004, "chapter_id": 23578, "verse_number": "२१८-५", "content_sanskrit": "अश्विनोरपि चोत्पत्ति गौर्युत्पत्तिस्तथैव च ।\nविनायकस्य चोत्पत्तिर्नागोत्पत्तिस्तथैव च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003578005, "chapter_id": 23578, "verse_number": "२१८-६", "content_sanskrit": "स्कन्दोत्पत्तिश्च भानोश्च उत्पत्तिः समुदाहृता ।\nकामादीनां तथोत्पत्तिः देव्युत्पत्तिस्तथैव च ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003578006, "chapter_id": 23578, "verse_number": "२१८-७", "content_sanskrit": "धनदस्य तथोत्पत्तिः परापरविनिर्णयः ।\nधर्मोत्पत्तिस्तथोत्पत्ती रुद्रस्य च ततः स्मृता ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003578007, "chapter_id": 23578, "verse_number": "२१८-८", "content_sanskrit": "सोमोत्पत्तिरहस्यं च क्षितेश्चापि समासतः ।\nउक्तः प्रागितिहासश्च व्याधोपाख्यानमेव च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003578008, "chapter_id": 23578, "verse_number": "२१८-९", "content_sanskrit": "ततः सत्यतपोपाख्या मत्स्यद्वादशिका तथा ।\nकूर्मद्वादशिका चापि वराहद्वादशी तथा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003578009, "chapter_id": 23578, "verse_number": "२१८-१०", "content_sanskrit": "नृसिंहद्वादशी चापि वामनद्वादशी तथा ।\nभार्गवद्वादशी चापि श्रीरामद्वादशी तथा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003578010, "chapter_id": 23578, "verse_number": "२१८-११", "content_sanskrit": "कृष्णद्वादशिका चापि बुद्धद्वादशिका तथा ।\nकल्कि द्वादशिका चापि पद्मनाभस्य द्वादशी ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003578011, "chapter_id": 23578, "verse_number": "२१८-१२", "content_sanskrit": "ततो व्रतं धरण्याश्च गीतागस्त्यस्य चोत्तमा ।\nपशुपालस्य चाख्यानं भर्तृप्राप्तिव्रतं तथा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003578012, "chapter_id": 23578, "verse_number": "२१८-१३", "content_sanskrit": "शुभव्रतं धन्यव्रतं कान्तिव्रतमतः स्मृतम् ।\nसौभाग्यव्रतमाख्यातमविघ्नव्रतमेव च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003578013, "chapter_id": 23578, "verse_number": "२१८-१४", "content_sanskrit": "शान्तिव्रतं कामव्रतमारोग्यव्रतमेव च ।\nपुत्रप्राप्तिव्रतं शौर्यव्रतं वै सार्वभौमिकम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003578014, "chapter_id": 23578, "verse_number": "२१८-१५", "content_sanskrit": "पुराणस्तवनं चैव नारायणेश्वरेण च ।\nरुद्रगीता ततः पुंसां प्रकृतेश्चापि निर्णयः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003578015, "chapter_id": 23578, "verse_number": "२१८-१६", "content_sanskrit": "ततो भुवनकोशस्य वर्णनं समुदाहृतम् ।\nजम्बूद्वीपस्य मर्यादावर्णनं परिकार्तितम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003578016, "chapter_id": 23578, "verse_number": "२१८-१७", "content_sanskrit": "भारतादिसमुद्देशः सृष्टिसम्भाग एव च ।\nनारदस्य च संवादो महिषेण प्रकीर्त्तितः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003578017, "chapter_id": 23578, "verse_number": "२१८-१८", "content_sanskrit": "शक्तिमाहात्म्यकथनं महिषासुरघातनम् ।\nरुद्रमाहात्म्यकथनं पर्वाध्यायस्ततः परम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003578018, "chapter_id": 23578, "verse_number": "२१८-१९", "content_sanskrit": "श्वेतोपाख्यानमत्रोक्तं तिलधेनुविधिस्ततः ।\nजलधेनोरसधेनोर्गुडधेनोर्विधिः परम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003578019, "chapter_id": 23578, "verse_number": "२१८-२०", "content_sanskrit": "ततश्च शर्क्कराधेनोर्मधुधेनोस्ततः परम् ।\nदधिधेनोश्च लवणधेनोः कार्पासधेनुका ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003578020, "chapter_id": 23578, "verse_number": "२१८-२१", "content_sanskrit": "धान्यधेनुश्च भगवच्छास्त्रलक्षणमेव च ।\nविष्णोस्तोत्रं ततो नाना प्रश्नाः प्रोक्ता हरिं प्रति ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003578021, "chapter_id": 23578, "verse_number": "२१८-२२", "content_sanskrit": "ततो भागवतानां च लक्षणं परिकीर्त्तितम् ।\nलक्षणं सुखदुःखानां द्वात्रिंशदपराधकाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003578022, "chapter_id": 23578, "verse_number": "२१८-२३", "content_sanskrit": "नानामन्त्रास्ततः प्रोक्ता देवोपकरणे विधिः।\nभोज्याभोज्यस्य कथनं संध्योपस्थानकारणम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003578023, "chapter_id": 23578, "verse_number": "२१८-२४", "content_sanskrit": "वियोनिगर्भमोक्षश्च कोकामुखप्रशंसनम् ।\nभगवच्छास्त्रकथने माहात्म्यं पुष्पगन्धयोः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003578024, "chapter_id": 23578, "verse_number": "२१८-२५", "content_sanskrit": "रूपकारणमत्रोक्तं मायाचक्रं ततः परम् ।\nकुब्जाम्रकस्य माहात्म्यं वर्णदीक्षा ततः परम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003578025, "chapter_id": 23578, "verse_number": "२१८-२६", "content_sanskrit": "कंकृताञ्जनदर्पाणां मन्त्राः प्रोक्तास्ततः परम् ।\nराजान्नभक्षणे प्रायश्चित्तं प्रोक्तं ततः परम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003578026, "chapter_id": 23578, "verse_number": "२१८-२७", "content_sanskrit": "दन्तकाष्ठाद्यकरणे प्रायश्चित्तं ततः परम् ।\nशवादिस्पर्शने मन्त्र त्यागे चोक्तं ततः परम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003578027, "chapter_id": 23578, "verse_number": "२१८-२८", "content_sanskrit": "नीलवस्त्रपरिधाने क्रोधयुक्तस्य चार्चने ।\nरक्तवस्त्रपरिधाने अन्धकारे प्रपूजने ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003578028, "chapter_id": 23578, "verse_number": "२१८-२९", "content_sanskrit": "कृष्णवस्त्रपरिधाने धौतवस्त्रस्य धारणे ।\nक्रोडादिमांसभक्षे च प्रायश्चित्तं प्रकीर्त्तितम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003578029, "chapter_id": 23578, "verse_number": "२१८-३०", "content_sanskrit": "दीपोच्छिष्टस्य तैलस्य करलेपेन  पूजने।\nश्मशानगमने स्पृष्टपूजने  चैव शोधने ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003578030, "chapter_id": 23578, "verse_number": "२१८-३१", "content_sanskrit": "पिण्याकभक्षणे चैव उपानद्गूढपादके ।\nभगवच्छास्त्रविहिताकरणे शोधने ततः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003578031, "chapter_id": 23578, "verse_number": "२१८-३२", "content_sanskrit": "सूकरक्षेत्रमहिमा ततो जम्बूकगृध्रयोः ।\nखञ्जरीटस्य चाख्यानं पुनः कोकामुखस्य च ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003578032, "chapter_id": 23578, "verse_number": "२१८-३३", "content_sanskrit": "बदरीषण्डमाहात्म्यं गुह्यधर्मप्रकीर्तनम्।\nमन्दारगुह्यमहिमा शालग्रामप्रसंशनम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003578033, "chapter_id": 23578, "verse_number": "२१८-३४", "content_sanskrit": "सोमेश्वरस्य महिमा मुक्तिक्षेत्रस्य चापि हि।\nत्रिवेण्याश्चैव माहात्म्यं माहात्म्यं गण्डकीभवम् ।३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003578034, "chapter_id": 23578, "verse_number": "२१८-३५", "content_sanskrit": "चक्रतीर्थस्य महिमा हरिक्षेत्रसमुद्भवः ।\nदेवह्रदस्य चाख्यानं रुरुक्षेत्रस्य चापि हि ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003578035, "chapter_id": 23578, "verse_number": "२१८-३६", "content_sanskrit": "गोनिष्क्रमस्य महिमा द्वारवत्यास्ततः परम् ।\nतत्रत्य तीर्थमहिमा लौहार्गलमतः परम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003578036, "chapter_id": 23578, "verse_number": "२१८-३७", "content_sanskrit": "मथुरातीर्थमाहात्म्यं प्रादुर्भावस्तथैव च ।\nयमुनातीर्थमाहात्म्यमक्रूरस्य च तीर्थकम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003578037, "chapter_id": 23578, "verse_number": "२१८-३८", "content_sanskrit": "देवारण्यस्य माहात्म्यं चक्रतीर्थस्य चोत्तमम् ।\nकपिलस्यापि महिमा तथा गोवर्धनस्य च ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003578038, "chapter_id": 23578, "verse_number": "२१८-३९", "content_sanskrit": "तथा आख्यायिकायुक्तं विश्रान्तेश्च ततः परम् ।\nगोकर्णस्य च माहात्म्यं सरस्वत्यास्तथैव च ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003578039, "chapter_id": 23578, "verse_number": "२१८-४०", "content_sanskrit": "यमुनोद्भेदमहिमा कालिञ्जरसमुद्भवाः ।\nगंगोद्भेदस्य महिमा शापः स्यम्बस्य वै तथा ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003578040, "chapter_id": 23578, "verse_number": "२१८-४१", "content_sanskrit": "मधुकप्रतिमायाश्च स्थापनं संप्रकीर्तितम् ।\nशैलार्च्चा स्थापनं चापि मृन्मयार्च्चास्थितिस्तथा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003578041, "chapter_id": 23578, "verse_number": "२१८-४२", "content_sanskrit": "ताम्रार्चास्थापनं चापि कांस्यार्चास्थापनं  तथा ।\nरौप्यर्चास्थापनं चाथ सौवर्णप्रतिमास्थितिः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003578042, "chapter_id": 23578, "verse_number": "२१८-४३", "content_sanskrit": "श्राद्धोत्पत्ति स्ततः प्रोक्तं पिण्डं संकल्प एव च ।\nपिण्डोत्पत्तिस्ततः प्रोक्ता पितृयज्ञविनिर्णयः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003578043, "chapter_id": 23578, "verse_number": "२१८-४४", "content_sanskrit": "मधुपर्क्कफलं दाने संसारचक्रवर्णनम् ।\nदुष्कृत्यकरणं चैव सुखवर्णनमेव च ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003578044, "chapter_id": 23578, "verse_number": "२१८-४५", "content_sanskrit": "कृतान्तदूतकथनं यातनारूपमेव च ।\nवर्णनं नरकाणां च किंकराणां च वर्णनम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003578045, "chapter_id": 23578, "verse_number": "२१८-४६", "content_sanskrit": "तथा कर्मविपाकं च यादृशं कर्म तादृशम् ।\nपापकृत्यस्य कथनं दूतप्रेषणकर्म च ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003578046, "chapter_id": 23578, "verse_number": "२१८-४७", "content_sanskrit": "शुभाशुभस्य कथनं शुभकर्मफलोदयम् ।\nलोभनं पुरुषस्यापि निमेराख्यानमद्भुतम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003578047, "chapter_id": 23578, "verse_number": "२१८-४८", "content_sanskrit": "पापनाशकथां दिव्यां गोकर्णेशसमुद्भवम् ।\nनन्दिना वरदानं च जलशैलेशयोस्तथा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003578048, "chapter_id": 23578, "verse_number": "२१८-४९", "content_sanskrit": "शृंगेश्वरस्य महिमा चैवं वृत्तान्तसंग्रहः ।\nएतच्छ्रुत्वाप्नुयान्मर्त्त्यो वाराहश्रुतिजं फलम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003578049, "chapter_id": 23578, "verse_number": "२१८-५०", "content_sanskrit": "इत्यनुक्रमणिका नाम अष्टादशाधिकद्विशततमोऽध्यायः ॥२१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003578050, "chapter_id": 23578, "verse_number": "२१८-५१", "content_sanskrit": "समाप्तं वाराहं महापुराणं शुभम् ।\nयादृशं पुस्तके दृष्टं तादृशं लिखितं मया ।\nयदि शुद्धमशुद्धं वा मम दोषो न विद्यते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]