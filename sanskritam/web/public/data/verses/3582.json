[{"id": 2120250, "chapter_id": 3582, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2120251, "chapter_id": 3582, "verse_number": "१", "content_sanskrit": "भीमसेनस्तदा कृष्णमुवाच यदुनन्दनम् ।\nबुद्धिमास्थाय विपुलां जरासन्धजिघांसया\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2120252, "chapter_id": 3582, "verse_number": "२", "content_sanskrit": "अयं पापो मया कृष्ण युक्तः स्यान्नानुरोधितुम् ।\nप्रायेण यदुशार्दूल बान्धवक्षयकृत् तव\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2120253, "chapter_id": 3582, "verse_number": "३", "content_sanskrit": "एवमुक्तस्तदा कृष्णः प्रत्युवाच वृकोदरम् ।\nत्वरया पुरुषव्याघ्रो जरासन्धवधेप्सया\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2120254, "chapter_id": 3582, "verse_number": "४", "content_sanskrit": "यत्ते दैवं परं सत्त्वं पितुस्ते मातरिश्वनः ।\nबलं भीम जरासन्धे दर्शयस्व तदद्य नः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2120255, "chapter_id": 3582, "verse_number": "५", "content_sanskrit": "तवैष वध्यो दुर्बुद्धिर्जरासन्धो महाबलः ।\nइत्यन्तरिक्षे त्वश्रौषं यदा वायुरपोह्यते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2120256, "chapter_id": 3582, "verse_number": "६", "content_sanskrit": "गोमन्ते पर्वतश्रेष्ठे येनैव परिमोक्षितः ।\nबलदेवबलं प्राप्य कोऽन्यो जीवेत मागधात्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2120257, "chapter_id": 3582, "verse_number": "७", "content_sanskrit": "तदस्य मृत्युर्विहितः त्वदृते न महाबल ।\nवायुं चिन्त्य महाबाहो जहीमं मगधाधिपम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2120258, "chapter_id": 3582, "verse_number": "८", "content_sanskrit": "एवमुक्तस्तदा भीमो मनसा चिन्त्य मारुतम् ।\nजनार्दनं नमस्यैव परिष्वज्य च फल्गुनम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2120259, "chapter_id": 3582, "verse_number": "९", "content_sanskrit": "प्रभञ्जनबलाविष्टो जरासन्धमरिन्दमः ।\nउत्क्षिप्याभ्रमद् राजन् बलवन्तं महाबलः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2120260, "chapter_id": 3582, "verse_number": "१०", "content_sanskrit": "भ्रामयित्वा शतगुणं जानुभ्यां भरतर्षभ ।\nबभञ्ज पृष्ठे सङ्क्षिप्य निष्पिष्य विननाद च\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2120261, "chapter_id": 3582, "verse_number": "११", "content_sanskrit": "प्रस्फाल्य पादौ भूमौ च जानुनाऽऽक्रम्य सत्वरः ।\nसन्धिं विश्लेषयामास सतटिद्घननिस्वनम् ।\nमध्ये विदारयामास कर्तव्यमुपशस्य च\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2120262, "chapter_id": 3582, "verse_number": "१२", "content_sanskrit": "तस्य निष्पिष्यमाणस्य पाण्डवस्य च गर्जतः ।\nअभवत् तुमुलो नादः सर्वप्राणिभयङ्करः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2120263, "chapter_id": 3582, "verse_number": "१३", "content_sanskrit": "वित्रेसुर्मागधाः सर्वे स्त्रीणां गर्भाश्च सुस्रुवुः ।\nभीमसेनस्य नादेन जरासन्धस्य चैव ह ।\nकिन्नुस्विद्धिमवान् भिन्नः किन्नुस्विद् दीर्यते मही\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2120264, "chapter_id": 3582, "verse_number": "समाप्तिः", "content_sanskrit": "इति स्म मागधा जल्पन् भीमसेनस्य गर्जनात् ।\nततो राज्ञः कुलद्वारि प्रसुप्तमिव तं नृपम् ।\nरात्रौ परासुमुत्सृज्य निश्चक्रमुररिन्दमाः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2120265, "chapter_id": 3582, "verse_number": "१५", "content_sanskrit": "जरासन्धरथं कृष्णो योजयित्वा पताकिनम् ।\nआरोप्य भ्रातरौ राज्ञो मोक्षयामास बान्धवान्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2120266, "chapter_id": 3582, "verse_number": "१६", "content_sanskrit": "ते वै रत्नभुजं कृष्णं रत्नार्हं चैव पार्थिवम् ।\nराजानश्चक्रुरासाद्य मोक्षिता महतो भयात्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2120267, "chapter_id": 3582, "verse_number": "१७", "content_sanskrit": "अक्षतः क्षत्रसम्पन्नो जितारिः सह राजभिः ।\nरथमास्थाय तं दिव्यं निर्जगाम गिरिव्रजात्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2120268, "chapter_id": 3582, "verse_number": "१८", "content_sanskrit": "तयोः सौन्दर्यवान् नाम विधेयः कृष्णसारथिः ।\nअभ्याययावभिमुखो दुर्जयः सर्वधन्विभिः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2120269, "chapter_id": 3582, "verse_number": "१९", "content_sanskrit": "भीमार्जुनाभ्यां योधाभ्यामास्थितः कृष्णसारथिः ।\nशुशुभे रथवर्योऽसौ दुर्जयः सर्वधन्विभिः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2120270, "chapter_id": 3582, "verse_number": "२०", "content_sanskrit": "शक्रविष्णू हि सङ्ग्रामे चेरतुस्तारकामये ।\nरथेन तेन तं कृष्ण उपारुह्योपयात् तदा\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2120271, "chapter_id": 3582, "verse_number": "२१", "content_sanskrit": "एवमेतौ महाबाहू तदा दुष्करकारिणौ ।\nकृष्णप्रणीतावेकस्मिन् रथे को द्रष्टुमर्हति\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2120272, "chapter_id": 3582, "verse_number": "२२", "content_sanskrit": "इत्यवोचन् व्रजन्तं तं जरासन्धपुरालयाः ।\nवासुदेवं नरश्रेष्ठं युक्तं वायुजवैर्हयैः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2120273, "chapter_id": 3582, "verse_number": "२३", "content_sanskrit": "तप्तचामीकराभेण किङ्किणीजालमालिना ।\nमेघनिर्घोषनादेन जैत्रेणामित्रघातिना\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2120274, "chapter_id": 3582, "verse_number": "२४", "content_sanskrit": "येन शक्रो दानवानां जघान नवतीर्नव ।\nतं प्राप्य समहृष्यन्त रथं ते पुरुषर्षभाः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2120275, "chapter_id": 3582, "verse_number": "२५", "content_sanskrit": "ततः कृष्णं महाबाहुं भ्रातृभ्यां सहितं तदा ।\nरथस्थं मागधा दृष्ट्वा समपद्यन्त विस्मिताः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2120276, "chapter_id": 3582, "verse_number": "२६", "content_sanskrit": "हयैर्दिव्यैः समायुक्तो रथो वायुसमो जवे ।\nअधिष्ठितः स शुशुभे कृष्णेनातीव भारत\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2120277, "chapter_id": 3582, "verse_number": "२७", "content_sanskrit": "असङ्गी देवविहितस्तस्मिन् रथवरे ध्वजः ।\nस योजनद्वये दृश्यः श्रीमानिन्द्रायुधप्रभः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2120278, "chapter_id": 3582, "verse_number": "२८", "content_sanskrit": "चिन्तयामास कृष्णोऽथ गरुत्मन्तं स चाभ्ययात् ।\nक्षणे तस्मिन् स तत्रासीच्चैत्ये यूप इवोच्छ्रितः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2120279, "chapter_id": 3582, "verse_number": "२९", "content_sanskrit": "व्यादितास्यो महानादैः सह भूतैर्ध्वजालयैः ।\nतस्मिन् रथवरे तस्थौ गरुत्मान् पन्नगाशनः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2120280, "chapter_id": 3582, "verse_number": "३०", "content_sanskrit": "दुर्निरीक्ष्यो हि भूतानां तेजसाऽभ्यधिकं बभौ ।\nआदित्य इव मध्याह्ने सहस्रकिरणावृतः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2120281, "chapter_id": 3582, "verse_number": "३१", "content_sanskrit": "न स सज्जति वृक्षेषु शस्त्रैश्चापि न रिष्यति ।\nदिव्यो रथवरो राजन् दृश्यते चैव मानुषैः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2120282, "chapter_id": 3582, "verse_number": "३२", "content_sanskrit": "तमास्थाय रथं दिव्यं पर्जन्यसमनिःस्वनम् ।\nनिर्ययौ पुण्डरीकाक्षः पाण्डवाभ्यां सहाच्युतः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2120283, "chapter_id": 3582, "verse_number": "३३", "content_sanskrit": "यं लेभे वासवाद् राजा वसुस्तस्माद् बृहद्रथः ।\nबृहद्रथात् क्रमेणैव प्राप्तो बार्हद्रथो रथम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2120284, "chapter_id": 3582, "verse_number": "३४", "content_sanskrit": "स निर्याय महाबाहुः पुण्डरीकेक्षणस्ततः ।\nगिरिव्रजाद् बहिस्तस्थौ समदेशे महायशाः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2120285, "chapter_id": 3582, "verse_number": "३५", "content_sanskrit": "तत्रैनं नागराः सर्वे सत्कारेणाभ्ययुस्तदा ।\nब्राह्मणप्रमुखा राजन् विधिदृष्टेन कर्मणा\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2120286, "chapter_id": 3582, "verse_number": "३६", "content_sanskrit": "बन्धनाद् विप्रमुक्ताश्च राजानो मधुसूदनम् ।\nपूजयामासुरूचुश्च सान्त्वपूर्वमिदं वचः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2120287, "chapter_id": 3582, "verse_number": "३७", "content_sanskrit": "नैतच्चित्रं महाबाहो त्वयि देवकिनन्दन ।\nभीमार्जुनबलोपेते धर्मस्य परिपालनम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2120288, "chapter_id": 3582, "verse_number": "३८", "content_sanskrit": "जरासन्धह्रदे घोरे दुःखपङ्के निमज्जताम्\nराज्ञां समभ्युद्धरणं यदिदं कृतमद्य वै\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2120289, "chapter_id": 3582, "verse_number": "३९", "content_sanskrit": "राज्ञां समवसन्नानां गिरिदुर्गे सुदारुणे ।\nदिष्ट्या मोक्षाद् यशो दीप्तमाहृतं ते नरोत्तम\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2120290, "chapter_id": 3582, "verse_number": "४०", "content_sanskrit": "किं कुर्मः पुरुषव्याघ्र समाज्ञापय नः प्रभो ।\nकृतमित्येव तज्ज्ञेयं यद्यपि स्यात् सुदुष्करम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2120291, "chapter_id": 3582, "verse_number": "४१", "content_sanskrit": "तानुवाच हृषीकेशः समाश्वास्य महामनाः ।\nयुधिष्ठिरो राजसूयं क्रतुमाहर्तुमिच्छति\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2120292, "chapter_id": 3582, "verse_number": "४२", "content_sanskrit": "तस्य धर्मप्रवृत्तस्य पार्थिवत्वं चिकीर्षतः ।\nसर्वैर्भवद्भिर्यज्ञार्थे साहाय्यं दीयतामिति\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2120293, "chapter_id": 3582, "verse_number": "४३", "content_sanskrit": "ततः सुप्रीतमनसस्ते नृपा भरतर्षभ ।\nतं तथेत्यब्रुवन् सर्वे प्रतिजज्ञुश्च तां गिरम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2120294, "chapter_id": 3582, "verse_number": "४४", "content_sanskrit": "रत्नभाजं च दाशार्हं चक्रुस्ते पृथिवीश्वराः ।\nकृच्छ्राज्जग्राह गोविन्दस्तेषां तदनुकम्पया\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2120295, "chapter_id": 3582, "verse_number": "४५", "content_sanskrit": "जरासन्धात्मजश्चैव सहदेवो महारथः ।\nनिर्ययौ सजनामात्यः पुरस्कृत्य पुरोहितम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2120296, "chapter_id": 3582, "verse_number": "४६", "content_sanskrit": "सचिवैः प्रश्रितो भूत्वा बहुरत्नपुरस्कृतः ।\nसहदेवो नृणां देवं वासुदेवमुपाश्रितः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2120297, "chapter_id": 3582, "verse_number": "", "content_sanskrit": "सहदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2120298, "chapter_id": 3582, "verse_number": "४७", "content_sanskrit": "यत् कृतं पुरुषव्याघ्र मम पित्रा जनार्दन ।\nतत् ते हृदि महाबाहो न कार्यं पुरुषोत्तम\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2120299, "chapter_id": 3582, "verse_number": "४८", "content_sanskrit": "त्वां प्रपन्नोस्मि गोविन्द प्रसादं कुरु मे प्रभो ।\nपितुरिच्छामि संस्कारं कर्तुं देवकिनन्दन\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2120300, "chapter_id": 3582, "verse_number": "४९", "content_sanskrit": "त्वत्तोऽभ्यनुज्ञां सम्प्राप्य भीमसेनात् तथार्जुनात् ।\nनिर्भयो विचरिष्यामि यथाकामं यथासुखम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2120301, "chapter_id": 3582, "verse_number": "५०", "content_sanskrit": "एवं विज्ञाप्यमानस्य सहदेवस्य मारिष ।\nप्रहृष्टो देवकीपुत्रः पाण्डवौ च महारथौ ।\nक्रियतां संस्क्रिया राजन् पितुस्त इति चाब्रुवन्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2120302, "chapter_id": 3582, "verse_number": "५१", "content_sanskrit": "तच्छ्रुत्वा वासुदेवस्य पार्थयोश्च स मागधः ।\nप्रविश्य नगरं तूर्णं सह मन्त्रिभिरप्युत\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2120303, "chapter_id": 3582, "verse_number": "५२", "content_sanskrit": "चितां चन्दनकाष्ठैश्च काळैश्च सरळैस्तथा ।\nकाळागुरुसुगन्धैश्च तैलैश्च विविधैरपि\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2120304, "chapter_id": 3582, "verse_number": "५३", "content_sanskrit": "घृतधाराक्षतैश्चैव सुमनोभिश्च मागधम् ।\nसमन्तादवकीर्यैतददहन् मगधाधिपम्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2120305, "chapter_id": 3582, "verse_number": "५४", "content_sanskrit": "उदकं तस्य चक्रेऽथ सहदेवः सहानुजः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2120306, "chapter_id": 3582, "verse_number": "५५", "content_sanskrit": "कृत्वा पितुः स्वर्गगतिं निर्ययौ यत्र केशवः ।\nपाण्डवौ च महाभागौ भीमसेनार्जुनावुभौ ।\nस प्रह्वः प्राञ्जलिर्भूत्वा व्यज्ञापयत माधवम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2120307, "chapter_id": 3582, "verse_number": "५६", "content_sanskrit": "इमे रत्नानि भूरीणि गोजाविमहिषादयः ।\nहस्तिनोऽश्वाश्च गोविन्द वासांसि विविधानि च\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2120308, "chapter_id": 3582, "verse_number": "५७", "content_sanskrit": "नीयतां धर्मराजाय यथा वा मन्यते भवान्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2120309, "chapter_id": 3582, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2120310, "chapter_id": 3582, "verse_number": "५८", "content_sanskrit": "भयार्ताय तदा तस्मै दत्वा कृष्णोऽभयं तथा ।\nअभ्यषिञ्चत राजानं सहदेवं जनार्दनः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2120311, "chapter_id": 3582, "verse_number": "५९", "content_sanskrit": "मागधानां महीपालं जरासन्धात्मजं तदा ।\nआददेऽस्य महार्हाणि रत्नानि पुरुषोत्तमः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2120312, "chapter_id": 3582, "verse_number": "६०", "content_sanskrit": "गत्वैकत्वं स कृष्णेन पार्थाभ्यां चापि सत्कृतः ।\nविवेश मतिमान् राजा पुनर्बार्हद्रथं पुरम्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2120313, "chapter_id": 3582, "verse_number": "६१", "content_sanskrit": "पार्थाभ्यां सहितः कृष्णः सर्वैश्च वसुधाधिपैः ।\nयथावयः समागम्य विससर्ज नराधिपान्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2120314, "chapter_id": 3582, "verse_number": "६२", "content_sanskrit": "विसृज्य सर्वान् नृपतीन् राजसूये महात्मभिः ।\nआगन्तव्यं भवद्भिस्तु धर्मराजप्रियेप्सुभिः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2120315, "chapter_id": 3582, "verse_number": "६३", "content_sanskrit": "एवमुक्ता माधवेन सर्वे ते वसुधाधिपाः ।\nएवमस्त्विति चाप्युक्त्वा समेताः परया मुदा\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2120316, "chapter_id": 3582, "verse_number": "६४", "content_sanskrit": "भीमार्जुनहृषीकेशाः प्रहृष्टाः प्रययुः सह ।\nरत्नान्यादाय भूरीणि ज्वलन्तो रिपुसूदनाः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2120317, "chapter_id": 3582, "verse_number": "६५", "content_sanskrit": "इन्द्रप्रस्थमथागम्य भ्रातृभ्यां सहितोऽच्युतः ।\nसमेत्य धर्मराजानं प्रीयमाणमुपस्थितः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2120318, "chapter_id": 3582, "verse_number": "६६", "content_sanskrit": "दिष्ट्या भीमेन बलवान् जरासन्धो निपातितः ।\nराजानो मोक्षिताश्चेमे बन्धनान्नृपसत्तमाः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2120319, "chapter_id": 3582, "verse_number": "६७", "content_sanskrit": "दिष्ट्या कुशलिनौ चेमौ भीमसेनधनञ्जयौ ।\nपुनः स्वनगरं प्राप्तावक्षताविति भारत\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2120320, "chapter_id": 3582, "verse_number": "६८", "content_sanskrit": "ततो युधिष्ठिरः कृष्णं पूजयित्वा यथार्हतः ।\nभीमसेनार्जुनौ चैव प्रहृष्टः परिषस्वजे\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2120321, "chapter_id": 3582, "verse_number": "६९", "content_sanskrit": "ततः क्षीणे जरासन्धे भ्रातृभिर्विहितं जयम् ।\nअजातशत्रुरासाद्य मुमुदे भ्रातृभिः सह\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2120322, "chapter_id": 3582, "verse_number": "७०", "content_sanskrit": "हृष्टश्च धर्मराड् वाक्यं जनार्दनमभाषत\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2120323, "chapter_id": 3582, "verse_number": "७१", "content_sanskrit": "त्वां प्राप्य पुरुषव्याघ्र भीमसेनेन पातितः ।\nमागधोऽसौ बलोन्मत्तो जरासन्धः प्रतापवान्\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2120324, "chapter_id": 3582, "verse_number": "७२", "content_sanskrit": "राजसूयं क्रतुश्रेष्ठं प्राप्स्यामि विगतज्वरः ।\nत्वद्बुद्धिबलमाश्रित्य भागार्होऽसि जनार्दन\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2120325, "chapter_id": 3582, "verse_number": "७३", "content_sanskrit": "पीतं पृथिव्या कुण्डेन यशस्ते पुरुषोत्तम ।\nजरासन्धवधेनैव प्राप्तास्ते विपुलाः श्रियः ।\nएवं सम्भाष्य कौन्तेयः प्रादाद् रथवरं प्रभोः\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2120326, "chapter_id": 3582, "verse_number": "७४", "content_sanskrit": "प्रतिगृह्य तु गोविन्दो जरासन्धस्य तं रथम् ।\nप्रहृष्टस्तस्य मुमुदे फल्गुनेन जनार्दनः\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2120327, "chapter_id": 3582, "verse_number": "७५", "content_sanskrit": "प्रीतिमानभवद् राजन् धर्मराजपुरस्कृतः\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2120328, "chapter_id": 3582, "verse_number": "७६", "content_sanskrit": "ययावथ समाभाष्य प्रेम्णा राजन् नृपैः सह ।\nसत्कृत्य पूजयित्वा च विससर्ज नराधिपान्\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2120329, "chapter_id": 3582, "verse_number": "७७", "content_sanskrit": "युधिष्ठिराभ्यनुज्ञातास्ते नृपा हृष्टमानसाः ।\nजग्मुः स्वदेशांस्त्वरिता यानैरुच्चावचैस्तदा\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2120330, "chapter_id": 3582, "verse_number": "७८", "content_sanskrit": "एवं स पुरुषव्याघ्रो महाबुद्धिर्जनार्दनः ।\nपाण्डवैर्घातयामास जरासन्धमरिं तदा\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2120331, "chapter_id": 3582, "verse_number": "७९", "content_sanskrit": "घातयित्वा जरासन्धं बुद्धिपूर्वमरिन्दमः ।\nधर्मराजमनुज्ञाप्य पृथां कृष्णां च भारत\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2120332, "chapter_id": 3582, "verse_number": "८०", "content_sanskrit": "सुभद्रां भीमसेनं च फल्गुनं च यमौ तथा ।\nधौम्यं भीममनुज्ञाप्य प्रययौ द्वारकां प्रति\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2120333, "chapter_id": 3582, "verse_number": "८१", "content_sanskrit": "पाण्डवैरनुयायद्भिर्युधिष्ठिरपुरोगमैः ।\nहर्षेण महता युक्तः प्राप्य चानुत्तमं यशः\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2120334, "chapter_id": 3582, "verse_number": "८२", "content_sanskrit": "जगाम हृष्टः कृष्णस्तु पुनर्द्वारवतीं पुरीम्\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2120335, "chapter_id": 3582, "verse_number": "८३", "content_sanskrit": "तेनैव रथमुख्येन तरुणादित्यवर्चसा ।\nधर्मराजनिसृष्टेन दिव्येनानादयन् दिशः\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2120336, "chapter_id": 3582, "verse_number": "८४", "content_sanskrit": "ततो युधिष्ठिरमुखाः पाण्डवा भरतर्षभ ।\nप्रदक्षिणं तदाऽकुर्वन् कृष्णमक्लिष्टकारिणम्\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2120337, "chapter_id": 3582, "verse_number": "८५", "content_sanskrit": "ततो गते भगवति कृष्णे देवकिनन्दने ।\nजयं लब्ध्वा सुविपुलं राज्ञामभयदास्ततः\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2120338, "chapter_id": 3582, "verse_number": "८६", "content_sanskrit": "संवर्धितौजसो भूयः कर्मणा तेन भारत ।\nद्रौपद्याः पाण्डवा राजन् परां प्रीतिमवर्धयन्\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2120339, "chapter_id": 3582, "verse_number": "८७", "content_sanskrit": "तस्मिन् काले तु सम्प्राप्तं धर्मकामार्थसंयुतम् ।\nतद्राजा धर्मतश्चक्रे राज्यं प्राप्य युधिष्ठिरः\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2120340, "chapter_id": 3582, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि चतुर्विंशोऽध्यायः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2120341, "chapter_id": 3582, "verse_number": "४", "content_sanskrit": "जरासन्धवधपर्वणि चतुर्थोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2120342, "chapter_id": 3582, "verse_number": "", "content_sanskrit": "॥ समाप्तं जरासन्धपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2120343, "chapter_id": 3582, "verse_number": "", "content_sanskrit": "— ०  —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}]