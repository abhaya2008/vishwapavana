[{"id": 2002340, "chapter_id": 1049, "verse_number": "१-५०-०x", "content_sanskrit": "मन्त्रिण ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2002341, "chapter_id": 1049, "verse_number": "१-५०-१", "content_sanskrit": "ततः स राजा राजेन्द्र स्कन्धे तस्य भुजंगमम्।\nमुनेः क्षुत्क्षाम आसज्य स्वपुरं प्रययौ पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2002342, "chapter_id": 1049, "verse_number": "१-५०-२", "content_sanskrit": "ऋषेस्तस्य तु पुत्रोऽभूद्गति जातो महायशाः।\nशृङ्गी नाम महातेजास्तिग्मवीर्योऽतिकोपनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2002343, "chapter_id": 1049, "verse_number": "१-५०-३", "content_sanskrit": "ब्रह्माणं समुपागम्य मुनिः पूजां चकार ह।\nसोऽनुज्ञातस्ततस्तत्र शृङ्गी शुश्राव तं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2002344, "chapter_id": 1049, "verse_number": "१-५०-४", "content_sanskrit": "सख्युः सकाशात्पितरं पित्रा ते धर्षितं पुरा।\nमृतं सर्पं समासक्तं स्थाणुभूतस्य तस्य तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2002345, "chapter_id": 1049, "verse_number": "१-५०-५", "content_sanskrit": "वहन्तं राजशार्दूल स्कन्धेनानपकारिणम्।\nतपस्विनमतीवाथ तं मुनिप्रवरं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2002346, "chapter_id": 1049, "verse_number": "१-५०-६", "content_sanskrit": "जितेन्द्रियं विशुद्धं च स्थितं कर्मण्यथाद्भुतम्।\nतपसा द्योतितात्मानं स्वेष्वङ्गेषु यतं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2002347, "chapter_id": 1049, "verse_number": "१-५०-७", "content_sanskrit": "शुभाचारं शुभकथं सुस्थितं तमलोलुपम्।\nअक्षुद्रमनसूयं च वृद्धं मौनव्रते स्थितम्।\nशरण्यं सर्वभूतानां पित्रा विनिकृतं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2002348, "chapter_id": 1049, "verse_number": "१-५०-८", "content_sanskrit": "शशापाथ महातेजाः पितरं ते रुषान्वितः।\nऋषेः पुत्रो महातेजा बालोऽपि स्थविरद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2002349, "chapter_id": 1049, "verse_number": "१-५०-९", "content_sanskrit": "स क्षिप्रमुदकं स्पृष्ट्वा रोषादिदमुवाच ह।\nपितरं तेऽभिसन्धाय तेजसा प्रज्वलन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2002350, "chapter_id": 1049, "verse_number": "१-५०-१०", "content_sanskrit": "अनागसि गुरौ यो मे मृतं सर्पवासृजत्।\nतं नागस्तक्षकः क्रुद्धस्तेजसा प्रदहिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2002351, "chapter_id": 1049, "verse_number": "१-५०-११", "content_sanskrit": "आशीविषस्तिग्मतेजा मद्वाक्यबलचोदितः।\nसप्तरात्रादितः पापं पश्य मे तपसो बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2002352, "chapter_id": 1049, "verse_number": "१-५०-१२", "content_sanskrit": "इत्युक्त्वा प्रययौ तत्र पिता यत्राऽस्य सोऽभवत्।\nदृष्ट्वा च पितरं तस्मै तं शापं प्रत्यवेदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2002353, "chapter_id": 1049, "verse_number": "१-५०-१३", "content_sanskrit": "स चापि मुनिशार्दूलः प्रेरयामास ते पितुः।\nशिष्यं गौरमुखं नाम शीलवन्तं गुणान्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2002354, "chapter_id": 1049, "verse_number": "१-५०-१४", "content_sanskrit": "आचख्यौं सत्त्व विश्रान्तो राज्ञः सर्वमशेषतः।\nशप्तोऽसि मम पुत्रेण यत्तो भव महीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2002355, "chapter_id": 1049, "verse_number": "१-५०-१५", "content_sanskrit": "तक्षकस्त्वां महाराज तेजसाऽसौ दहिष्यति।\nश्रुत्वा च तद्वचो घोरं पिता ते जनमेजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2002356, "chapter_id": 1049, "verse_number": "१-५०-१६", "content_sanskrit": "यत्तोऽभवत्परित्रस्तस्तक्षकात्पन्नगोत्तमात्।\nततस्तस्मिंस्तु दिवसे सप्तमे समुपस्थिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2002357, "chapter_id": 1049, "verse_number": "१-५०-१७", "content_sanskrit": "राज्ञः समीपं ब्रह्मर्षिः काश्यपो गन्तुमैच्छत।\nतं ददर्शाथ नागेन्द्रस्तक्षकः काश्यपं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2002358, "chapter_id": 1049, "verse_number": "१-५०-१८", "content_sanskrit": "तमब्रवीत्पन्नगेन्द्रः काश्यपं त्वरितं द्विजम्।\nक्व भवांस्त्वरितो याति किं च कार्यं चिकीर्षति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2002359, "chapter_id": 1049, "verse_number": "१-५०-१९x", "content_sanskrit": "काश्यप उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2002360, "chapter_id": 1049, "verse_number": "१-५०-१९", "content_sanskrit": "यत्र राजा कुरुश्रेष्ठः परिक्षिन्नाम वै द्विज।\nतक्षकेण भुजंगेन धक्ष्यते किल सोऽद्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2002361, "chapter_id": 1049, "verse_number": "१-५०-२०", "content_sanskrit": "गच्छाम्यहं तं त्वरितः सद्यः कर्तुमपज्वरम्।\nमयाऽभिपन्नं तं चापि न सर्पो धर्षयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2002362, "chapter_id": 1049, "verse_number": "१-५०-२१x", "content_sanskrit": "तक्षक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2002363, "chapter_id": 1049, "verse_number": "१-५०-२१", "content_sanskrit": "किमर्थं तं मया दष्टं संजीवयितुमिच्छसि।\nअहं त तक्षको ब्रह्मन्पश्य मे वीर्यमद्भुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2002364, "chapter_id": 1049, "verse_number": "१-५०-२२", "content_sanskrit": "न शक्तस्त्वं मया दष्टं तं संजीवयितुं नृपम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2002365, "chapter_id": 1049, "verse_number": "१-५०-२३x", "content_sanskrit": "मन्त्रिण ऊचुः।\nइत्युक्त्वा तक्षकस्तत्र सोऽदशद्वै वनस्पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2002366, "chapter_id": 1049, "verse_number": "१-५०-२३", "content_sanskrit": "स दष्टमात्रो नागेन भस्मीभूतोऽभवन्नगः।\nकाश्यपश्च ततो राजन्नजीवयत तं नगम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2002367, "chapter_id": 1049, "verse_number": "१-५०-२४", "content_sanskrit": "ततस्तं लोभयामास कामं ब्रूहीति तक्षकः।\nस एवमुक्तस्तं प्राह काश्यपस्तक्षकं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2002368, "chapter_id": 1049, "verse_number": "१-५०-२५", "content_sanskrit": "धनलिप्सुरहं तत्र यामीत्युक्तश्च तेन सः।\nतमुवाच महात्मानं तक्षकः श्लक्ष्णया गिरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2002369, "chapter_id": 1049, "verse_number": "१-५०-२६", "content_sanskrit": "यावद्धनं प्रार्थयसे राज्ञस्तस्मात्ततोऽधिकम्।\nगृहाण मत्त एव त्वं सन्निवर्तस्व चानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2002370, "chapter_id": 1049, "verse_number": "१-५०-२७", "content_sanskrit": "स एवमुक्तो नागेन काश्यपो द्विपदां वरः।\nलब्ध्वा वित्तं निववृते तक्षकाद्यावदीप्सितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2002371, "chapter_id": 1049, "verse_number": "१-५०-२८", "content_sanskrit": "तस्मिन्प्रतिगते विप्रे छद्मनोपेत्य तक्षकः।\nतं नृपं नृपतिश्रेष्ठं पितरं धार्मिकं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2002372, "chapter_id": 1049, "verse_number": "१-५०-२९", "content_sanskrit": "प्रासादस्थं यत्तमपि दग्धवान्विषवह्निना।\nततस्त्वं पुरुषव्याघ्र विजयायाभिषेचितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2002373, "chapter_id": 1049, "verse_number": "१-५०-३०", "content_sanskrit": "एतद्दृष्टं श्रुतं चापि यथावन्नृपसत्तम।\nअस्माभिर्निखिलं सर्वं कथितं तेऽतिदारुणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2002374, "chapter_id": 1049, "verse_number": "१-५०-३१", "content_sanskrit": "श्रुत्वा चैतं नरश्रेष्ठ पार्थिवस्य पराभवम्।\nअस्य चर्षेरुदङ्कस्य विधत्स्व यदनन्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2002375, "chapter_id": 1049, "verse_number": "१-५०-३२x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2002376, "chapter_id": 1049, "verse_number": "१-५०-३२", "content_sanskrit": "एतस्मिन्नेव काले तु स राजा जनमेजयः।\nउवाच मन्त्रिणः सर्वानिदं वाक्यमरिदमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2002377, "chapter_id": 1049, "verse_number": "१-५०-३३x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2002378, "chapter_id": 1049, "verse_number": "१-५०-३३", "content_sanskrit": "अथ तत्कथितं केन यद्वृत्तं तद्वनस्पतौ।\nआश्चर्यभूतं लोकस्य भस्मराशीकृतं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2002379, "chapter_id": 1049, "verse_number": "१-५०-३४", "content_sanskrit": "यद्वृक्षं जीवयामास काश्यपस्तक्षकेण वै।\nनूनं मन्त्रैर्हतविषो न प्रणश्येत काश्यपात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2002380, "chapter_id": 1049, "verse_number": "१-५०-३५", "content_sanskrit": "चिन्तयामास पापात्मा मनसा पन्नगाधमः।\nदष्टं यदि मया विप्रः पार्थिवं जीवयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2002381, "chapter_id": 1049, "verse_number": "१-५०-३६", "content_sanskrit": "तक्षकः संहतविषो लोके यास्यति हास्यताम्।\nविचिन्त्यैवं कृता तेन ध्रुवं तुष्टिर्द्विजस्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2002382, "chapter_id": 1049, "verse_number": "१-५०-३७", "content_sanskrit": "भविष्यति ह्युपायेन यस्य दास्यामि यातनाम्।\nएकं तु श्रोतुमिच्छामि तद्वृत्तं निर्जने वने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2002383, "chapter_id": 1049, "verse_number": "१-५०-३८", "content_sanskrit": "संवादं पन्नगेन्द्रस्य काश्यपस्य च कस्तदा।\nश्रुतवान्दृष्टवांश्चापि भवत्सु कथमागतम्।\nश्रुत्वा तस्य विधास्येऽहं पन्नगान्तकरीं मतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2002384, "chapter_id": 1049, "verse_number": "१-५०-३९x", "content_sanskrit": "मन्त्रिण ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2002385, "chapter_id": 1049, "verse_number": "१-५०-३९", "content_sanskrit": "शृणु राजन्यथास्माकं येन तत्कथितं पुरा।\nसमागतं द्विजेन्द्रस्य पन्नगेन्द्रस्य चाध्वनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2002386, "chapter_id": 1049, "verse_number": "१-५०-४०", "content_sanskrit": "तस्मिन्वृक्षे नरः कश्चिदिन्धनार्थाय पार्थिव।\nविचिन्वन्पूर्वमारूढः शुष्कशाखावनस्पतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2002387, "chapter_id": 1049, "verse_number": "१-५०-४१", "content_sanskrit": "न बुध्येतामुभौ तौ च नगस्थं पन्नगद्विजौ।\nसह तेनैव वृक्षेण भस्मीभूतोऽभवन्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2002388, "chapter_id": 1049, "verse_number": "१-५०-४२", "content_sanskrit": "द्विजप्रभावाद्राजेन्द्र व्यजीवत्स वनस्पतिः।\nतेनागम्य द्विजश्रेष्ठ पुंसाऽस्मासु निवेदितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2002389, "chapter_id": 1049, "verse_number": "१-५०-४३", "content_sanskrit": "यथा वृत्तं तु तत्सर्वं तक्षकस्य द्विजस्य च।\nएतत्ते कथितं राजन्यथादृष्टं श्रुतं च यत्।\nश्रुत्वा च नृपशार्दूल विधत्स्व यदनन्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2002390, "chapter_id": 1049, "verse_number": "१-५०-४४x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2002391, "chapter_id": 1049, "verse_number": "१-५०-४४", "content_sanskrit": "मन्त्रिणां तु वचः श्रुत्वा स राजा जनमेजयः।\nपर्यतप्यत दुःखार्तः प्रत्यपिंषत्करं करे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2002392, "chapter_id": 1049, "verse_number": "१-५०-४५", "content_sanskrit": "निःश्वासमुष्णमसकृद्दीर्घं राजीवलोचनः।\nमुमोचाश्रूणि च तदा नेत्राभ्यां प्ररुदन्नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2002393, "chapter_id": 1049, "verse_number": "१-५०-४६", "content_sanskrit": "उवाच च महीपालो दुःखशोकसमन्वितः।\nदुर्धरं बाष्पमुत्सृज्य स्पृष्ट्वा चापो यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2002394, "chapter_id": 1049, "verse_number": "१-५०-४७", "content_sanskrit": "मुहूर्तमिव च ध्यात्वा निश्चित्य मनसा नृपः।\nअमर्षी मन्त्रिणः सर्वानिदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2002395, "chapter_id": 1049, "verse_number": "१-५०-४८x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2002396, "chapter_id": 1049, "verse_number": "१-५०-४८", "content_sanskrit": "श्रुत्वैतद्भवतां वाक्यं पितुर्मे स्वर्गतिं प्रति।\nनिश्चितेयं मम मतिर्या च तां मे निबोधत।\nअनन्तरं च मन्येऽहं तक्षकाय दुरात्मने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2002397, "chapter_id": 1049, "verse_number": "१-५०-४९", "content_sanskrit": "प्रतिकर्तव्यमित्येवं येन मे हिंसितः पिता।\nशृङ्गिणं हेतुमात्रं यः कृत्वा दग्ध्वा च पार्थिवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2002398, "chapter_id": 1049, "verse_number": "१-५०-५०", "content_sanskrit": "इयं दुरात्मता तस्य काश्यपं यो न्यवर्तयत्।\nयद्यागच्छेत्स वै विप्रो ननु जीवेत्पिता मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2002399, "chapter_id": 1049, "verse_number": "१-५०-५१", "content_sanskrit": "परिहीयेत किं तस्य यदि जीवेत्स पार्थिवः।\nकाश्यपस्य प्रसादेन मन्त्रिणां विनयेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2002400, "chapter_id": 1049, "verse_number": "१-५०-५२", "content_sanskrit": "स तु वारितवान्मोहात्काश्यपं द्विजसत्तमम्।\nसंजिजीवयिषुं प्राप्तं राजानमपराजितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2002401, "chapter_id": 1049, "verse_number": "१-५०-५३", "content_sanskrit": "महानतिक्रमो ह्येष तक्षकस्य दुरात्मनः।\nद्विजस्य योऽददद्द्रव्यं मा नृपं जीवयेदिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2002402, "chapter_id": 1049, "verse_number": "१-५०-५४", "content_sanskrit": "उत्तङ्कस्य प्रियं कर्तुमात्मनश्च महत्प्रियम्।\nभवतां चैव सर्वेषां गच्छाम्यपचितिं पितुः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2002403, "chapter_id": 1049, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि पञ्चाशत्तमोऽध्यायः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]