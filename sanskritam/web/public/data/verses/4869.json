[{"id": 2182547, "chapter_id": 4869, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2182548, "chapter_id": 4869, "verse_number": "१", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nबृहस्पतेश्च संवादं शक्रस्य च युधिष्ठिर\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2182549, "chapter_id": 4869, "verse_number": "", "content_sanskrit": "शक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2182550, "chapter_id": 4869, "verse_number": "२", "content_sanskrit": "किंस्विदेकपदं ब्रह्मन् पुरुषः सम्यगाचरन् ।\nप्रमाणं सर्वभूतानां यशश्चैवाप्नुयान्महत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2182551, "chapter_id": 4869, "verse_number": "", "content_sanskrit": "बृहस्पतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2182552, "chapter_id": 4869, "verse_number": "३", "content_sanskrit": "सान्त्वमेकपदं शक्र पुरुषः सम्यगाचरन् ।\nप्रमाणं सर्वभूतानां यशश्चैवाप्नुयान्महत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2182553, "chapter_id": 4869, "verse_number": "४", "content_sanskrit": "एतदेकपदं शक्र सर्वलोकसुखावहम् ।\nआचरन् सर्वभूतेषु प्रियो भवति सर्वदा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2182554, "chapter_id": 4869, "verse_number": "५", "content_sanskrit": "यो हि नाभाषते किञ्चित् सततं भ्रुकुटीमुखः ।\nद्वेष्यो भवति भूतानां स स्आन्त्वमिह नाचरन्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2182555, "chapter_id": 4869, "verse_number": "६", "content_sanskrit": "यस्तु पूर्वमभिप्रेक्ष्य पूर्वमेवाभिभाषते ।\nस्मितपूर्वाभिभाषी च तस्य लोकः प्रसीदति\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2182556, "chapter_id": 4869, "verse_number": "७", "content_sanskrit": "दानमेव हि सर्वत्र सान्त्वेनानभिजल्पितम् ।\nन प्रीणयति भूतानि निर्व्यञ्जनमिवाशनम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2182557, "chapter_id": 4869, "verse_number": "८", "content_sanskrit": "अदाता ह्यपि भूतानां मधुरामीरयन् गिरम् ।\nसर्वलोकमिमं शक्र सान्त्वेन कुरुते वशे\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2182558, "chapter_id": 4869, "verse_number": "९", "content_sanskrit": "तस्मात् सान्त्वं प्रयोक्तव्यं दण्डमाधित्सतामिह ।\nफलं च जनयत्येवं नचास्योद्विजते जनः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2182559, "chapter_id": 4869, "verse_number": "१०", "content_sanskrit": "सुकृतस्य हि सान्त्वस्य श्लक्ष्णस्य मधुरस्य च ।\nसम्यगासेव्यमानस्य तुल्यं जातु न विद्यते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2182560, "chapter_id": 4869, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2182561, "chapter_id": 4869, "verse_number": "१२", "content_sanskrit": "इत्युक्तः कृतवान् सर्वं तथा शक्रः पुरोधसा ।\nतथा त्वमपि कौन्तेय सम्यगेतत् समाचर\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2182562, "chapter_id": 4869, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे षडशीतितमोऽध्यायः ॥ ८६ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]