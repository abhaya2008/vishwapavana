[{"id": 7005861000, "chapter_id": 25861, "verse_number": "१-४४-१", "content_sanskrit": "हरिरुवाच ।\nपूजयित्वा पवित्राद्यैर्ब्रह्म ध्यात्वा हरिर्भवेत् ।\nब्रह्मध्यानं प्रवक्ष्यामि मायायन्त्रप्रमर्दकम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005861001, "chapter_id": 25861, "verse_number": "१-४४-२", "content_sanskrit": "यच्छेद्वाङ्मनसं प्राज्ञस्तं यजेज्ज्ञानमात्मनि।\nज्ञानं महति संयच्छेद्य इच्छेज्ज्ञानमात्मानि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005861002, "chapter_id": 25861, "verse_number": "१-४४-३", "content_sanskrit": "देहेन्द्रियमनोबुद्धिप्राणाहङ्करावर्जितम्।\nवर्जितं भूततन्मात्रैर्गुणजन्माशनादिभिः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005861003, "chapter_id": 25861, "verse_number": "१-४४-४", "content_sanskrit": "स्वप्रकाशं निराकारं सदानं दमनादि यत् ।\nनित्यं शुद्धं बुद्धमृद्धं सत्यमानन्दमद्वयम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005861004, "chapter_id": 25861, "verse_number": "१-४४-५", "content_sanskrit": "तुरीयमक्षरं ब्रह्म अहमस्मि परं पदम् ।\nअहं ब्रह्मेत्यवस्थानं समाधिरपि (रिति) गीयते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005861005, "chapter_id": 25861, "verse_number": "१-४४-६", "content_sanskrit": "आत्मानं रथिनं विद्धि शरीरं रथमेव ।\nबुद्धिं च सारथिं विद्धि मनः प्रग्रहमे च।\nइन्द्रियाणि हयानाहुर्विषयास्तेषु गोचराः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005861006, "chapter_id": 25861, "verse_number": "१-४४-७", "content_sanskrit": "आत्मेंद्रियमनोयुक्तो भोक्तेत्यार्मनीषिणः ।\nयस्तु विज्ञानबाह्मेन युक्तेन मनसा सदा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005861007, "chapter_id": 25861, "verse_number": "१-४४-८", "content_sanskrit": "स तु तत्पदमाप्नोति स हि भूयो न जायते।\nविज्ञानसारथिर्यस्तु मनः प्रग्रहवान्नरः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005861008, "chapter_id": 25861, "verse_number": "१-४४-९", "content_sanskrit": "स्वर्धुन्याः पारमाप्नोति तद्विष्णोः परमं पम्।\nअहिंसादिर्यमः प्रोक्तः शौचादिर्नियमः स्मृतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005861009, "chapter_id": 25861, "verse_number": "१-४४-१०", "content_sanskrit": "आसनं पद्मकाद्युक्तं प्राणायामो मरुज्जयः ।\nप्रत्याहारो जयः प्रोक्तो ध्यानमीश्वरचिन्तनम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005861010, "chapter_id": 25861, "verse_number": "१-४४-११", "content_sanskrit": "मनोधृतिर्धारणा स्थात्समाधिर्ब्रह्मणि स्थितिः ।\nपूर्वं चेतः स्थिरं न स्यात्ततोमूर्त्तिं विचिन्तयेत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005861011, "chapter_id": 25861, "verse_number": "१-४४-१२", "content_sanskrit": "हृत्पद्मकर्णिकामध्ये शङ्खचक्रगदाब्जवन।\nश्रीवत्सकौस्तुभयुतो वनमालाश्रिया युतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005861012, "chapter_id": 25861, "verse_number": "१-४४-१३", "content_sanskrit": "नित्यः शुद्धो भूतियुक्तः सत्यानन्दाह्वयः परः ।\nआत्माहं परमं ब्रह्म परमं ज्योतिरेव तु ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005861013, "chapter_id": 25861, "verse_number": "१-४४-१४", "content_sanskrit": "चतुर्विंशतिमूर्त्तिः स शालग्रामशिलास्थितः ।\nद्वारकादिशिलासंस्थो ध्येयः पूज्योऽप्यहं च सः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005861014, "chapter_id": 25861, "verse_number": "१-४४-१५", "content_sanskrit": "मनसोऽभीप्सितं प्राप्य देवो वैमानिको भवेत् ।\nनिष्कामो मुक्तिमाप्नोति मूर्त्तिं ध्याययंस्तुवञ्जपन् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005861015, "chapter_id": 25861, "verse_number": "१-४४-१६", "content_sanskrit": "इति श्रीगारुडे महापुराणे पूर्वखण्डे प्रथमांशाख्ये आचारकाण्डे ब्रह्ममूर्तिध्याननिरूपणं नाम चतुश्चत्वारिंशोऽध्यायः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]