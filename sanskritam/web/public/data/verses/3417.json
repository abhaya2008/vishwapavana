[{"id": 2112017, "chapter_id": 3417, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2112018, "chapter_id": 3417, "verse_number": "१", "content_sanskrit": "अहोरात्रानृतून् मासान् न बुबोध गतान् बहून् ।\nरममाणः प्रियां लब्ध्वा यथाकामं नराधिपः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2112019, "chapter_id": 3417, "verse_number": "२", "content_sanskrit": "स्वर्गस्थान् मानुषांश्चैव भोगान् भुङ्क्ते स्म वै नृपः ।\nआसाद्य शन्तनुः श्रीमान् मुमुदे योषितां वराम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2112020, "chapter_id": 3417, "verse_number": "३", "content_sanskrit": "ऋतुकाले तु सा देवी दिव्यं गर्भमधारयत् ।\nअष्टावजनयत् पुत्रांस्तस्य सा वरवर्णिनी\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2112021, "chapter_id": 3417, "verse_number": "४", "content_sanskrit": "जातं जातं च सा पुत्रं सा स्वाप्सु क्षिपति स्म ह ।\nसूतके कण्ठमाक्रम्य तान् निनाय यमक्षयम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2112022, "chapter_id": 3417, "verse_number": "५", "content_sanskrit": "प्रीणामि त्वामिहेत्युक्त्वा सर्वान् स्रोतस्यवाक्षिपत् ।\nतस्य तत् त्वप्रियं राज्ञः शन्तनोरभवत् तदा ।\nनोवाच किञ्चिद् वचनं पितुर्वचनयन्त्रितः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2112023, "chapter_id": 3417, "verse_number": "६", "content_sanskrit": "अमीमांस्या कर्मयोनिरागमश्चेति शन्तनुः ।\nस्मरन् पितृवचश्चैव नापृच्छत् पुत्रकिल्बिषम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2112024, "chapter_id": 3417, "verse_number": "७", "content_sanskrit": "जाताञ्जातांश्च वै हन्ति सा स्त्री सप्त वरान् सुतान् ।\nशन्तनुर्धर्मसङ्गाच्च नापृच्छत् तां कथञ्चन \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2112025, "chapter_id": 3417, "verse_number": "८", "content_sanskrit": "अष्टमं तु जिघांसन्त्यां चुक्षुभे शन्तनोर्धृतिः ।\nउवाच राजा दुःखार्तः परीप्सन् पुत्रमात्मनः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2112026, "chapter_id": 3417, "verse_number": "९", "content_sanskrit": "पुत्रहन्त्रीं तदा दृष्ट्वा तां स कौरवनन्दनः ।\nअब्रवीद् भरतश्रेष्ठो वाक्यं परमदुःखितः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2112027, "chapter_id": 3417, "verse_number": "१०", "content_sanskrit": "मा वधीः काऽसि कस्यासि किं त्वं हंसि सुतानिति ।\nपुत्रघ्नि सुमहत्पापं मा कार्षीः कर्म निन्दितम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2112028, "chapter_id": 3417, "verse_number": "", "content_sanskrit": "गङ्गा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2112029, "chapter_id": 3417, "verse_number": "११", "content_sanskrit": "पुत्रकाम न ते पुत्रं हन्मि पुत्रवतां वर ।\nजीर्णस्तु मम वासोऽयं यथा स समयः कृतः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2112030, "chapter_id": 3417, "verse_number": "१२", "content_sanskrit": "अहं गङ्गा जह्नुसुता महर्षिगणसेविता ।\nदेवकार्यार्थसिद्ध्यर्थमुषिताऽहं त्वया सह \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2112031, "chapter_id": 3417, "verse_number": "१३", "content_sanskrit": "अष्टौ हि वसवो देवा महाभागा महौजसः ।\nआपवस्याभिशापेन मानुषेषूपपादिताः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2112032, "chapter_id": 3417, "verse_number": "१४", "content_sanskrit": "तेषां जनयिता नान्यस्त्वदृते भुवि विद्यते ।\nजनित्री मद्विधा धात्री नैवास्ति मनुजाधिप \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2112033, "chapter_id": 3417, "verse_number": "१५", "content_sanskrit": "तस्माद् विजनने युक्ता त्वत्संयोगमरोचयम् ।\nजनयित्वा वसूनष्टौ जिता लोकाश्च पुष्कलाः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2112034, "chapter_id": 3417, "verse_number": "१६", "content_sanskrit": "देवानां समयस्त्वेष वसूनां संश्रुतो मया ।\nजातं जातं मोक्षयिष्ये नियोगान्मानुषेष्विति \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2112035, "chapter_id": 3417, "verse_number": "१७", "content_sanskrit": "शप्ताः शापाद् विमुक्तास्ते त्वत्कृतेऽयं न मुच्यते ।\nस्वस्ति तेऽस्तु गमिष्यामि पुत्रं पाहि महाव्रतम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2112036, "chapter_id": 3417, "verse_number": "१८", "content_sanskrit": "अयं तव सुतस्तेषां वीर्येण कुलनन्दनः ।\nसम्भूतोऽति जनानन्यान् भविष्यति न संशयः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2112037, "chapter_id": 3417, "verse_number": "१९", "content_sanskrit": "एष पर्यायवासस्थो देवस्त्वत्सदृशोऽष्टमः ।\nमत्प्रसादाच्च जानीहि गङ्गादत्तमिमं सुतम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2112038, "chapter_id": 3417, "verse_number": "२१", "content_sanskrit": "तस्माद् देवव्रतश्चैव गङ्गादत्तश्च वीर्यवान् ।\nद्विनामा शन्तनोः पुत्रः शन्तनोरधिको गुणैः ।\nतेषां लोकानवाप्नोति वसूनां वसुधाधिप \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2112039, "chapter_id": 3417, "verse_number": "९६", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nषण्णवतितमोऽध्यायः॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2112040, "chapter_id": 3417, "verse_number": "४४", "content_sanskrit": "॥ इति सम्भवपर्वणि चतुश्चत्वारिंशोऽध्यायः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2112041, "chapter_id": 3417, "verse_number": "", "content_sanskrit": "* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]