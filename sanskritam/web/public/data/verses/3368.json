[{"id": 2109144, "chapter_id": 3368, "verse_number": "", "content_sanskrit": "शौनकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2109145, "chapter_id": 3368, "verse_number": "१", "content_sanskrit": "सर्पसत्रे तु वै राज्ञः पाण्डवेयस्य धीमतः ।\nजनमेजयस्य के वाऽऽसन् ऋत्विजः परमर्षयः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2109146, "chapter_id": 3368, "verse_number": "२", "content_sanskrit": "के सदस्या बभूवुश्च तस्मिन् सत्रे सुदारुणे ।\nविषादजननेऽत्यर्थं पन्नगानां भयावहे\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2109147, "chapter_id": 3368, "verse_number": "३", "content_sanskrit": "सर्वं विस्तरतस्तात भवान् व्याख्यातुमर्हति ।\nसर्पसत्रविधानज्ञा विज्ञेयास्तेऽपि सूतज \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2109148, "chapter_id": 3368, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2109149, "chapter_id": 3368, "verse_number": "४", "content_sanskrit": "अहं ते कथयिष्यामि नामानीह मनीषिणाम् ।\nय ऋत्विजः सदस्याश्च तस्यासन् नृपतेस्तदा \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2109150, "chapter_id": 3368, "verse_number": "५", "content_sanskrit": "तत्र होता बभूवाथ ब्राह्मणश्चण्डभार्गवः ।\nच्यवनस्यान्वये जातः ख्यातो वेदविदां वरः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2109151, "chapter_id": 3368, "verse_number": "६", "content_sanskrit": "उद्गाता ब्राह्मणो वृद्धो विद्वान् कौत्सोऽथ जैमिनिः ।\nब्रह्माऽभवच्छार्ङ्गरवोऽथाध्वर्युर्बोधिपिङ्गलः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2109152, "chapter_id": 3368, "verse_number": "७", "content_sanskrit": "सदस्यश्चाभवद् व्यासः पुत्रशिष्यसहायवान् ।\nउद्दालकः कामठकः श्वेतकेतुश्च शाण्डिलः\t ॥ ७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2109153, "chapter_id": 3368, "verse_number": "८", "content_sanskrit": "असितो देवलश्चैव नारदः पर्वतस्तथा ।\nआत्रेयः कुण्डजठरौ द्विजः किरिकटस्तथा \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2109154, "chapter_id": 3368, "verse_number": "९", "content_sanskrit": "वात्स्यः श्रुतश्रवा वृद्धः तपस्स्वाध्यायशीलवान् ।\nकहोलो देवशर्मा च मौद्गल्यः शमठोरगः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2109155, "chapter_id": 3368, "verse_number": "१०", "content_sanskrit": "एते चान्ये च बहवो ब्राह्मणाः संशितव्रताः ।\nसदस्याश्चाभवंस्तत्र सत्रे पारीक्षितस्य ह \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2109156, "chapter_id": 3368, "verse_number": "११", "content_sanskrit": "जुह्वत्स्वृत्विक्ष्वथ तदा सर्पसत्रे महाक्रतौ ।\nअहयः प्रापतंस्तत्र सर्वप्राणिभयावहाः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2109157, "chapter_id": 3368, "verse_number": "१२", "content_sanskrit": "वसामेदोवहाः कुल्या नागानां सम्प्रवर्तिताः ।\nववौ गन्धस्तु तुमुलो दह्यतामनिशं तदा \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2109158, "chapter_id": 3368, "verse_number": "१३", "content_sanskrit": "पततां चैव नागानां विष्ठितानां तथाम्बरे ।\nअश्रूयतानिशं शब्दो दह्यतां चाग्निना भृशम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2109159, "chapter_id": 3368, "verse_number": "१४", "content_sanskrit": "तक्षकस्तु स नागेन्द्रः पुरन्दरनिवेशनम् ।\nगतः श्रुत्वैव राजानं दीक्षितं जनमेजयम्\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2109160, "chapter_id": 3368, "verse_number": "१५", "content_sanskrit": "ततः सर्वं यथावृत्तमाख्याय भुजगोत्तमः ।\nअगच्छत् शरणं भीतो नमस्कृत्वा पुरन्दरम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2109161, "chapter_id": 3368, "verse_number": "१६", "content_sanskrit": "तमिन्द्रः प्राह सुप्रीतो न तवास्तीह तक्षक ।\nभयं नागेन्द्र तस्माद् वै सर्पसत्रात् कथञ्चन\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2109162, "chapter_id": 3368, "verse_number": "१७", "content_sanskrit": "प्रसादितो मया पूर्वं तवार्थाय पितामहः ।\nतस्मात् तव भयं नास्ति व्येतु ते मानसो ज्वरः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2109163, "chapter_id": 3368, "verse_number": "१८", "content_sanskrit": "एवमाश्वासितस्तेन ततः स भुजगोत्तमः ।\nउवास भवने तस्य शक्रस्य मुदितः सुखी \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2109164, "chapter_id": 3368, "verse_number": "१९", "content_sanskrit": "अजस्रं निपतत्स्वग्नौ नागेषु भृशदुःखितः ।\nअल्पशेषपरीवारो वासुकिः पर्यतप्यत \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2109165, "chapter_id": 3368, "verse_number": "२०", "content_sanskrit": "कश्मलं प्राविशद् घोरं वासुकिः पन्नगेश्वरः ।\nस घूर्णमानहृदयो भगिनीमिदमब्रवीत् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2109166, "chapter_id": 3368, "verse_number": "", "content_sanskrit": "वासुकिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2109167, "chapter_id": 3368, "verse_number": "२१", "content_sanskrit": "दह्यन्तेऽङ्गानि मे भद्रे दिशो न प्रतिभान्ति माम् ।\nसीदामीव च सम्मोहाद् घूर्णतीव च मे मनः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2109168, "chapter_id": 3368, "verse_number": "२२", "content_sanskrit": "दृष्टिर्भ्रमति मेऽतीव हृदयं दीर्यतीव च ।\nपतिष्याम्यवशोऽद्याहं तस्मिन् दीप्ते विभावसौ \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2109169, "chapter_id": 3368, "verse_number": "२३", "content_sanskrit": "पारीक्षितस्य यज्ञोऽसौ वर्ततेऽस्मज्जिघांसया ।\nव्यक्तं मयाऽपि गन्तव्यं पितृराजनिवेशनम् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2109170, "chapter_id": 3368, "verse_number": "२४", "content_sanskrit": "अयं स कालः सम्प्राप्तो यदर्थमसि मे स्वसः ।\nजरत्कारोः पुरा दत्ता त्राह्यस्मान् सह बान्धवान् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2109171, "chapter_id": 3368, "verse_number": "२५", "content_sanskrit": "आस्तीकः किल तं यज्ञं वर्तमानं भुजङ्गमे ।\nप्रतिषेत्स्यति मां पूर्वं स्वयमाह पितामहः\t ॥ २५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2109172, "chapter_id": 3368, "verse_number": "२६", "content_sanskrit": "तद् वत्से ब्रूहि वत्सं तदास्तीकं वृद्धसम्मतम् ।\nममाद्य त्वं सभृत्यस्य मोक्षार्थं वेदवित्तमम् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2109173, "chapter_id": 3368, "verse_number": "४७", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि सप्तचत्वारिंशोऽध्यायः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2109174, "chapter_id": 3368, "verse_number": "३५", "content_sanskrit": "॥ आस्तीकपर्वणि पञ्चत्रिंशोऽध्यायः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]