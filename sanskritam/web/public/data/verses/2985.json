[{"id": 2093131, "chapter_id": 2985, "verse_number": "१३-११५-१", "content_sanskrit": "वसिष्ठ उवाच।\nघृतक्षीरप्रदा गावो घृतयोन्यो घृतोद्भवाः।\nघृतनद्यो घृतावर्तास्ता मे सन्तु सदा गृहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2093132, "chapter_id": 2985, "verse_number": "१३-११५-२", "content_sanskrit": "घृतं मे हृदये नित्यं घृतं नाभ्यां प्रतिष्ठितम्।\nघृतं सर्वेषु गात्रेषु घृतं मे मनसि स्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2093133, "chapter_id": 2985, "verse_number": "१३-११५-३", "content_sanskrit": "गावो ममाग्रतो नित्यं गावः पृष्ठत एव च।\nगावो मे सर्वतश्चैव गवां मध्ये वसाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2093134, "chapter_id": 2985, "verse_number": "१३-११५-४", "content_sanskrit": "इत्याचम्य जपेत्सायं प्रातश्च पुरुषः सदा।\nयदह्ना कुरुते पापं तस्मात्स परिमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2093135, "chapter_id": 2985, "verse_number": "१३-११५-५", "content_sanskrit": "प्रासादा यत्र सौवर्णा वसोर्धाराश्च कामदाः।\nगन्धर्वाप्सरसो यत्र तत्र यान्ति सहस्रदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2093136, "chapter_id": 2985, "verse_number": "१३-११५-६", "content_sanskrit": "नवनीतपङ्काः क्षीरोदा दधिशैवलसङ्कुलाः।\nवहन्ति यत्र वै नद्यस्तत्र यान्ति सहस्रदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2093137, "chapter_id": 2985, "verse_number": "१३-११५-७", "content_sanskrit": "गवां शतसहस्रं तु यः प्रच्छेद्यथाविधि।\nपरां वृद्धिमवाप्याथ स्वर्गलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2093138, "chapter_id": 2985, "verse_number": "१३-११५-८", "content_sanskrit": "दश चोभयतः प्रेत्य मातापित्रोः पितामहान्।\nदधाति सुकृताँल्लोकान्पुनाति च कुलं नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2093139, "chapter_id": 2985, "verse_number": "१३-११५-९", "content_sanskrit": "धेन्वाः प्रमाणेन समप्रमाणां\nधेनुं तिलानामपि च प्रदाय।\nपानीयवापीः स यमस्य लोके\nन यातनां काञ्चिदुपैति तत्र॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2093140, "chapter_id": 2985, "verse_number": "१३-११५-१०", "content_sanskrit": "पवित्रमग्र्यं जगतः प्रतिष्ठा\nदिवौकसां मातरोऽथाप्रमेयाः।\nअन्वालभेद्दक्षिणतो व्रजेच्च\nदद्याच्च पात्रे प्रसमीक्ष्य कालम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2093141, "chapter_id": 2985, "verse_number": "१३-११५-११", "content_sanskrit": "धेनुं सवत्सां कपिलां भूरिशृङ्गीं\nकांस्योपदोहां वसनोत्तरीयाम्।\nप्रदाय तां गाहति दुर्विगाह्यां\nयाम्यां सभां वीतभयो मनुष्यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2093142, "chapter_id": 2985, "verse_number": "१३-११५-१२", "content_sanskrit": "सुरूपा बहुरूपाश्चि विश्वरूपाश्च मातरः।\nगावो मामुपतिष्ठन्तामिति नित्यं प्रकीर्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2093143, "chapter_id": 2985, "verse_number": "१३-११५-१३", "content_sanskrit": "नातः पुण्यतरं दानं नातः पुण्यतरं फलम्।\nनातो विशिष्टं लोकेषु भूतं भवितुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2093144, "chapter_id": 2985, "verse_number": "१३-११५-१४", "content_sanskrit": "त्वचा लोम्नाऽथ शृङ्गैर्वा वालैः क्षीरेण मेदसा।\nयज्ञं वहति सम्भूय किमस्त्यभ्यधिकं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2093145, "chapter_id": 2985, "verse_number": "१३-११५-१५", "content_sanskrit": "यया सर्वमिदं व्याप्तं जगत्स्थावरजङ्गमम्।\nतां धेनुं शिरसा वन्दे भूतभव्यस्य मातरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2093146, "chapter_id": 2985, "verse_number": "१३-११५-१६", "content_sanskrit": "गुणवचनसमुच्चयैकदेशो\nनृवर मयैष गवां प्रकीर्तितस्ते।\nन च परमिह दानमस्ति गोभ्यो\nभवति न चापि परायणं ततोऽन्यम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2093147, "chapter_id": 2985, "verse_number": "१३-११५-१७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2093148, "chapter_id": 2985, "verse_number": "१३-११५-१७", "content_sanskrit": "वरमिदमिति भूमिपो विचिन्त्य\nप्रवरमृषेर्वचनं ततो महात्मा।\nव्यसृजत नियतात्मवान्द्विजेभ्यः\nसुबहु च गोधनमाप्तवांश्च लोकान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2093149, "chapter_id": 2985, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि पञ्चदशाधिकशततमोऽध्यायः॥ ११५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]