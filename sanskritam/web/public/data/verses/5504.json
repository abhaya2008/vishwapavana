[{"id": 2210595, "chapter_id": 5504, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2210596, "chapter_id": 5504, "verse_number": "१", "content_sanskrit": "एवमात्मोद्भवं सर्वं जगदुद्दिश्य केशवः ।\nधर्मान् धर्मात्मजस्यैव पुण्यानकथयत् प्रभुः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2210597, "chapter_id": 5504, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2210598, "chapter_id": 5504, "verse_number": "२", "content_sanskrit": "शृणु पाण्डव तत्त्वेन पवित्रं पापनाशनम् ।\nकथ्यमानं मया पुण्यं धर्मशास्त्रफलं महत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2210599, "chapter_id": 5504, "verse_number": "३", "content_sanskrit": "यः शृणोति शुचिर्भूत्वा एकचित्तस्तपोयुतः ।\nस्वर्ग्यं यशस्यमायुष्यं धर्मं ज्ञेयं युधिष्ठिर ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2210600, "chapter_id": 5504, "verse_number": "४", "content_sanskrit": "श्रद्दधानस्य तस्येह यत् पापं पूर्वसञ्चितम् ।\nविनश्यत्याशु तत्सर्वं मद्भक्तस्य विशेषतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2210601, "chapter_id": 5504, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2210602, "chapter_id": 5504, "verse_number": "५", "content_sanskrit": "एवं श्रुत्वा वचः पुण्यं सत्यं केशवभाषितम् ।\nप्रहृष्टमनसो भूत्वा चिन्तयन्तोऽद्भुतं परम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2210603, "chapter_id": 5504, "verse_number": "६", "content_sanskrit": "देवब्रह्मर्षयः सर्वे गन्धर्वाप्सरसस्तथा ।\nभूतयक्षग्रहगणा गुह्यका भुजगास्तथा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2210604, "chapter_id": 5504, "verse_number": "७", "content_sanskrit": "वालखिल्या महात्मानो योगिनस्तत्त्वदर्शिनः ।\nतथा भागवताश्चापि पञ्चकालमुपासकाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2210605, "chapter_id": 5504, "verse_number": "८", "content_sanskrit": "कौतूहलसमाविष्टाः प्रहृष्टाः परमर्षयः ।\nश्रोतुकामाः परं गुह्यं वैष्णवं धर्मशासनम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2210606, "chapter_id": 5504, "verse_number": "९", "content_sanskrit": "हृदि कर्तुं च तद् वाक्यं प्रणेमुः शिरसा तदा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2210607, "chapter_id": 5504, "verse_number": "१०", "content_sanskrit": "ततस्तान् वासुदेवेन दृष्टान् सौम्येन चक्षुषा ।\nविमुक्तपापानालोक्य प्रणम्य शिरसा हरिम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2210608, "chapter_id": 5504, "verse_number": "११", "content_sanskrit": "पप्रच्छ केशवं धर्मान् धर्मपुत्रः प्रतापवान् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2210609, "chapter_id": 5504, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2210610, "chapter_id": 5504, "verse_number": "१२", "content_sanskrit": "कीदृशी ब्राह्मणस्याथ कीदृशी क्षत्रियस्य वै ।\nवैश्यस्य कीदृशी देव गतिः शूद्रस्य कीदृशी ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2210611, "chapter_id": 5504, "verse_number": "१३", "content_sanskrit": "कथं वध्येत पापेन ब्राह्मणस्तु यमालये ।\nक्षत्रियो वाऽथ वैश्यो वा शूद्रो वा बध्यते कथम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2210612, "chapter_id": 5504, "verse_number": "१४", "content_sanskrit": "एतत् कथय देवेश लोकनाथ नमोऽस्तु ते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2210613, "chapter_id": 5504, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2210614, "chapter_id": 5504, "verse_number": "१५", "content_sanskrit": "स पृष्टः केशवोऽप्येवं धर्मपुत्रेण धीमता ।\nउवाच संसारगतिं चातुर्वर्ण्यस्य कर्मजाम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2210615, "chapter_id": 5504, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2210616, "chapter_id": 5504, "verse_number": "१६", "content_sanskrit": "शृणु वर्णक्रमेणैव धर्मं धर्मभृतां वर ।\nनास्ति किञ्चिन्नरश्रेष्ठ ब्राह्मणस्य तु दुष्कृतम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2210617, "chapter_id": 5504, "verse_number": "१७", "content_sanskrit": "शिखायज्ञोपवीती स्यात् सन्ध्यां ये चाप्युपासते ।\nयैश्च पूर्णाहुतिः प्राप्ता विधिवज्जुह्वते च ये ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2210618, "chapter_id": 5504, "verse_number": "१८", "content_sanskrit": "वैश्वदेवं च ये कुर्युः पूजयन्त्यतिथींश्च ये ।\nनित्यं स्वाध्यायशीलाश्च जपयज्ञपरास्तथा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2210619, "chapter_id": 5504, "verse_number": "१९", "content_sanskrit": "सायम्प्रातर्हुताशाश्च शूद्रभोजनवर्जिताः ।\nडम्भानृतविनिर्मुक्ताः स्वदारनिरताः सदा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2210620, "chapter_id": 5504, "verse_number": "२०", "content_sanskrit": "पञ्चयज्ञपराश्चैव येऽग्निहोत्रमुपासते ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2210621, "chapter_id": 5504, "verse_number": "२१", "content_sanskrit": "दहन्ति दुष्कृतं येषां हूयमानास्त्रयोऽग्नयः ।\nनष्टदुष्कृतकर्माणो ब्रह्मलोकं व्रजन्ति ते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2210622, "chapter_id": 5504, "verse_number": "२२", "content_sanskrit": "ब्रह्मलोके ततः कामं गन्धर्वैर्ब्रह्मगायनैः ।\nउपगीयमानाः प्रयतैः पूज्यमानाः स्वयम्भुवा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2210623, "chapter_id": 5504, "verse_number": "२३", "content_sanskrit": "ब्रह्मलोके प्रमोदन्ते यावदाभूतसम्प्लवम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2210624, "chapter_id": 5504, "verse_number": "२४", "content_sanskrit": "क्षत्रियोऽपि स्थितो राज्ये स्वधर्मं परिपालयन् ।\nसम्यक् प्रजाः पालयित्वा स्वधर्मनिरतः सदा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2210625, "chapter_id": 5504, "verse_number": "२५", "content_sanskrit": "यज्ञदानरतो धीरः स्वदारनिरतः शुचिः ।\nशास्त्रानुकारी तत्त्वज्ञः प्रजाकार्यपरायणः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2210626, "chapter_id": 5504, "verse_number": "२६", "content_sanskrit": "विप्रेभ्यः कामदो नित्यं भृत्यानां भरणे रतः ।\nसत्यसन्धः शुचिर्नित्यं लोभडम्भविवर्जितः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2210627, "chapter_id": 5504, "verse_number": "२७", "content_sanskrit": "क्षत्रियोऽप्युत्तमां याति गतिं देवनिषेविताम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2210628, "chapter_id": 5504, "verse_number": "२८", "content_sanskrit": "तत्र दिव्याप्सरोभिस्तु गन्धर्वैश्च प्रयत्नतः ।\nसेव्यमानो महातेजाः क्रीडते शक्रपूजितः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2210629, "chapter_id": 5504, "verse_number": "२९", "content_sanskrit": "चतुर्युगानि वै त्रिंशत् क्रीडित्वा दिवि देववत् ।\nइह मानुष्यलोके तु चतुर्वेदी द्विजो भवेत् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2210630, "chapter_id": 5504, "verse_number": "३०", "content_sanskrit": "कृषिगोपालनिरतः स्वधर्मान्वेषणे रतः ।\nदानधर्मेऽपि निरतो विप्रशुश्रूषकस्तथा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2210631, "chapter_id": 5504, "verse_number": "३१", "content_sanskrit": "सत्यसन्धः शुचिर्नित्यं लोभडम्भविवर्जितः ।\nऋजुः स्वदारनिरतो हिंसाद्रोहविवर्जितः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2210632, "chapter_id": 5504, "verse_number": "३२", "content_sanskrit": "वणिग्धर्मानमुञ्चन् वै देवब्राह्मणपूजकः ।\nवणिक् च स्वर्गमाप्नोति पूज्यमानोऽप्सरोगणैः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2210633, "chapter_id": 5504, "verse_number": "३३", "content_sanskrit": "चतुर्युगानि वै त्रिंशत् क्रीडित्वा दश पञ्च च ।\nइह मानुष्यके लोके राजा भवति वीर्यवान् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2210634, "chapter_id": 5504, "verse_number": "३४", "content_sanskrit": "त्रयाणामपि वर्णानां शुश्रूषानिरतः सदा ।\nविशेषेणैव विप्राणां दासवद्यस्तु तिष्ठति ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2210635, "chapter_id": 5504, "verse_number": "३५", "content_sanskrit": "अयाचितप्रदाता च सत्यशौचसमन्वितः ।\nगुरुदेवार्चनरतः परदारविवर्जितः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2210636, "chapter_id": 5504, "verse_number": "३६", "content_sanskrit": "परपीडामकृत्वैव भृत्यवर्गं बिभर्ति यः ।\nशूद्रोऽपि स्वर्गमाप्नोति जीवानामभयप्रदः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2210637, "chapter_id": 5504, "verse_number": "३७", "content_sanskrit": "स स्वर्गलोके क्रीडित्वा वर्षकोटिं महातपाः ।\nइह मानुष्यके लोके वैश्यो धनपतिर्भवेत् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2210638, "chapter_id": 5504, "verse_number": "३८", "content_sanskrit": "एवं धर्मात् परं नास्ति महत् संसारमोक्षणम् ।\nन च धर्मात् परं किञ्चित् पापकर्मव्यपोहनम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2210639, "chapter_id": 5504, "verse_number": "३९", "content_sanskrit": "तस्माद् धर्मः सदा कार्यो मानुष्यं प्राप्य दुर्लभम् ।\nन हि धर्मानुरक्तानां लोके किञ्चन दुर्लभम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2210640, "chapter_id": 5504, "verse_number": "", "content_sanskrit": "(स्वयम्भुविहितो धर्मो यो यस्येह नरेश्वर ।\nस तेन क्षपयेत् पापं सम्यगाचरितेन च ॥४०॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2210641, "chapter_id": 5504, "verse_number": "४१", "content_sanskrit": "सहजं यद्भवेत् कर्म न तत् त्याज्यं हि केनचित् ।\nस एव तस्य धर्मो हि तेन सिद्धिं स गच्छति ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2210642, "chapter_id": 5504, "verse_number": "४२", "content_sanskrit": "निर्गुणोऽपि स्वधर्मस्तु पापकर्म व्यपोहति ।\nएवमेव तु धर्मोऽपि क्षीयते पापवर्धनात् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2210643, "chapter_id": 5504, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2210644, "chapter_id": 5504, "verse_number": "४३", "content_sanskrit": "भगवन् देवदेवेश श्रोतुं कौतूहलं हि मे ।\nशुभस्याप्यशुभस्यापि क्षयवृद्धी यथाक्रमम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2210645, "chapter_id": 5504, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2210646, "chapter_id": 5504, "verse_number": "४४", "content_sanskrit": "शृणु पाण्डव तत्सर्वं धर्मसूक्ष्मं सनातनम् ।\nदुर्विज्ञेयतमं नित्यं मम भक्तैर्महात्मभिः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2210647, "chapter_id": 5504, "verse_number": "४५", "content_sanskrit": "यथैव शीतमुदकमुष्णेन बहुना वृतम् ।\nभवेत्तु तत्क्षणादुष्णं शीतत्वं च विनश्यति ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2210648, "chapter_id": 5504, "verse_number": "४६", "content_sanskrit": "यथोष्णं वा भवेदल्पं शीतेन बहुना वृतम् ।\nशीतलं तद् भवेत् सर्वमुष्णत्वं च विनश्यति ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2210649, "chapter_id": 5504, "verse_number": "४७", "content_sanskrit": "एवं तु यद्भवेद् भूरि सुकृतं वाऽथ दुष्कृतम् ।\nतदल्पं क्षपयेच्छीघ्रं नात्र कार्या विचारणा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2210650, "chapter_id": 5504, "verse_number": "४८", "content_sanskrit": "समत्वे सति राजेन्द्र तयोः सुकृतपापयोः ।\nगूहितस्य भवेद् वृद्धिः कीर्तितस्य भवेत् क्षयः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2210651, "chapter_id": 5504, "verse_number": "४९", "content_sanskrit": "ख्यापनेनानुतापेन प्रायः पापं प्रणश्यति ।\nतथाकृतश्च(स्तु) राजेन्द्र धर्मो नश्यति भारत ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2210652, "chapter_id": 5504, "verse_number": "५०", "content_sanskrit": "तावुभौ गूहितौ सम्यग् वृद्धिं यातौ न संशयः ।\nतस्मात् सर्वप्रयत्नेन न पापं गूहयेद् बुधः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2210653, "chapter_id": 5504, "verse_number": "५१", "content_sanskrit": "तस्मादेतत् प्रयत्नेन कीर्तनं क्षयकारणम् ।\nतस्मात् सङ्कीर्तयेत् पापं नित्यं धर्मं च गूहयेत् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2210654, "chapter_id": 5504, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि वैष्णवधर्मशास्त्रे चातुर्वर्ण्यधर्मफलकथनं नाम अष्टनवतितमोऽध्यायः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]