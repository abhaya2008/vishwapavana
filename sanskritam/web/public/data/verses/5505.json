[{"id": 2210655, "chapter_id": 5505, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2210656, "chapter_id": 5505, "verse_number": "१", "content_sanskrit": "एवं श्रुत्वा वचस्तथ्यं धर्मपुत्रोऽच्युतस्य तु ।\nपप्रच्छ पुनरप्यन्यान् धर्मान् धर्मात्मजो नृप ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2210657, "chapter_id": 5505, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2210658, "chapter_id": 5505, "verse_number": "२", "content_sanskrit": "वृथा च कति जन्मानि वृथा दानानि वा कति ।\nवृथा च जीवनं येषां नराणां पुरुषोत्तम ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2210659, "chapter_id": 5505, "verse_number": "३", "content_sanskrit": "कीदृशासु ह्यवस्थासु दानं दत्तं जनार्दन ।\nइह लोके च भजति पुरुषः पुरुषोत्तम ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2210660, "chapter_id": 5505, "verse_number": "४", "content_sanskrit": "गर्भस्थे कर्म चायाति किं बाल्ये वाऽपि शैशवे ।\nयौवने चापि किं कृष्ण वृद्धत्वे चाऽपि किं भवेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2210661, "chapter_id": 5505, "verse_number": "५", "content_sanskrit": "सात्विकं कीदृशं दानं राजसं कीदृशं भवेत् ।\nतामसं कीदृशं देव तर्पयिष्यति किं प्रभो ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2210662, "chapter_id": 5505, "verse_number": "६", "content_sanskrit": "उत्तमं कीदृशं दानं मध्यमं कीदृशं भवेत् ।\nअधमं कीदृशं दानं तेषां यादव किं फलम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2210663, "chapter_id": 5505, "verse_number": "७", "content_sanskrit": "किं दानं नयति ह्यूर्ध्वं किं गति मध्यमां नयेत् ।\nगतिं जघन्यामथवा देवदेव ब्रवीहि मे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2210664, "chapter_id": 5505, "verse_number": "८", "content_sanskrit": "एतदिच्छामि विज्ञातुं परं कौतूहलं हि मे ।\nत्वदीयं वचनं सत्यं पुण्यं च मधुसूदन ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2210665, "chapter_id": 5505, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2210666, "chapter_id": 5505, "verse_number": "९", "content_sanskrit": "एवं धर्मं प्रयत्नेन पृष्टः पाण्डुसुतेन वै ।\nउवाच वासुदेवोऽथ धर्मान् धर्मात्मजस्य सः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2210667, "chapter_id": 5505, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2210668, "chapter_id": 5505, "verse_number": "१०", "content_sanskrit": "शृणु राजन् यथान्यायं वचनं तथ्यमुत्तमम् ।\nकथ्यमानं मया पुण्यं सर्वपापव्यपोहनम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2210669, "chapter_id": 5505, "verse_number": "११", "content_sanskrit": "वृथा च दश जन्मानि चत्वारि च नराधिप ।\nवृथा दानानि पञ्चाशत् पञ्च चैव यथाक्रमम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2210670, "chapter_id": 5505, "verse_number": "१२", "content_sanskrit": "वृथा च जीवितं येषां ते च षट् परिकीर्तिताः ।\nअनुक्रमेण सर्वाणि तानि वक्ष्यामि पाण्डव ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2210671, "chapter_id": 5505, "verse_number": "१३", "content_sanskrit": "धर्मघ्नानां तथा जन्म लुब्धानां पापिनां तथा ।\nवृथा पाकं च येऽश्नन्ति परदाररताश्च ये ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2210672, "chapter_id": 5505, "verse_number": "१४", "content_sanskrit": "पाकभेदकरा ये च ये च स्युः सत्यवर्जिताः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2210673, "chapter_id": 5505, "verse_number": "१५", "content_sanskrit": "मृष्टमश्नाति यश्चैको दृश्यमानस्तु बान्धवैः ।\nपितरं मातरं चैव उपाध्यायं गुरुं तथा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2210674, "chapter_id": 5505, "verse_number": "१६", "content_sanskrit": "मातुलं मातुलानीं च यो विहन्याच्छपेत वा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2210675, "chapter_id": 5505, "verse_number": "१७", "content_sanskrit": "ब्राह्मणाश्चैव ये भूताः सन्ध्योपासनवर्जिताः ।\nनिःस्वाहा निःस्वधाश्चैव यश्च शूद्रान्नभुग् द्विजः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2210676, "chapter_id": 5505, "verse_number": "१८", "content_sanskrit": "मम वा शङ्करस्यापि ब्रह्मणो वा युधिष्ठिर ।\nअथवा ब्राह्मणानां तु ये न भक्ता नराधिप ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2210677, "chapter_id": 5505, "verse_number": "१९", "content_sanskrit": "वृथा जन्मान्यथैतेषां पापिनां विद्धि पाण्डव ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2210678, "chapter_id": 5505, "verse_number": "", "content_sanskrit": "अश्रद्धया च यद्दत्तम् अवमानेन वाऽपि यत् ।\n(डम्भार्थमपि यद्दत्तं यत् पाषण्डिहृतं नृप ॥२०॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2210679, "chapter_id": 5505, "verse_number": "२१", "content_sanskrit": "शूद्राचाराय यद्दत्तं यद्दत्त्वा चानुकीर्तितम् ।\nरोषयुक्तं च यद्दत्तं यद्दत्तमनुशोचितम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2210680, "chapter_id": 5505, "verse_number": "२२", "content_sanskrit": "डम्भार्जितं च यद्दत्तं यच्च वाऽप्यनृतार्जितम् ।\nब्राह्मणस्वं च यद्दत्तं चौर्येणाप्यार्जितं च यत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2210681, "chapter_id": 5505, "verse_number": "२३", "content_sanskrit": "अभिशापहृतं यत्तु यद्दत्तं पतिते द्विजे ।\nयद्दत्तं स्वैरिणीभर्तुर्बहुकार्यानुवर्तिने ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2210682, "chapter_id": 5505, "verse_number": "२४", "content_sanskrit": "निर्ब्रह्माभिहृतं यत्तु यद्दत्तं सर्वयाजके ।\nव्रात्ये तु यत्कृतं दत्तमारूढपतिते च यत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2210683, "chapter_id": 5505, "verse_number": "२५", "content_sanskrit": "यद् ग्रामयाजकहृतं यत् कृतघ्नहृतं तथा ।\nउपपातकिने दत्तं वेदविक्रयिणे च यत् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2210684, "chapter_id": 5505, "verse_number": "२६", "content_sanskrit": "स्त्रीजिताय च यद्दत्तं यद्दत्तं राजसेविने ।\nगणकाय च यद्दत्तं यच्च कारणिकाय च ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2210685, "chapter_id": 5505, "verse_number": "२७", "content_sanskrit": "वृषलीपतये दत्तं यद्दत्तं शस्त्रजीविने ।\nभृतकाय च यद्दत्तं व्यालग्राहिहृतं च यत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2210686, "chapter_id": 5505, "verse_number": "२८", "content_sanskrit": "देवद्रव्याशिने दत्तं यद्दत्तं चित्रकर्मिणे ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2210687, "chapter_id": 5505, "verse_number": "२९", "content_sanskrit": "रङ्गोपजीविने दत्तं यच्च मांसोपजीविने ।\nसेवकाय च यद्दत्तं यद्दत्तं ब्राह्मणब्रुवे ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2210688, "chapter_id": 5505, "verse_number": "३०", "content_sanskrit": "अदेशिने च यद्दत्तं दत्तं वार्धुषिकाय यत् ।\nयदनाचारिणे दत्तं यत्तु दत्तमनग्नये ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2210689, "chapter_id": 5505, "verse_number": "३१", "content_sanskrit": "असन्ध्योपासिने दत्तं यच्छ्रूद्रग्रामवासिने ।\nयन्मिथ्यालिङ्गिने दत्तं दत्तं सर्वाशिने च यत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2210690, "chapter_id": 5505, "verse_number": "३२", "content_sanskrit": "नास्तिकाय च यद्दत्तं धर्मविक्रयिणे च यत् ।\nचोरकाय च यद्दत्तं यद्दत्तं कूटसाक्षिणे ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2210691, "chapter_id": 5505, "verse_number": "३३", "content_sanskrit": "ग्रामकूटाय यद्दत्तं दानं पार्थिवपुङ्गव ।\nवृथा भवति तत् सर्वं नात्र कार्या विचारणा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2210692, "chapter_id": 5505, "verse_number": "३४", "content_sanskrit": "विप्रनामधरा ह्येते लोलुपा ब्राह्मणाधमाः ।\nनात्मानं तारयन्त्येते न दातारं युधिष्ठिर ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2210693, "chapter_id": 5505, "verse_number": "३५", "content_sanskrit": "एतेभ्यो दत्तमात्राणि दानानि सुबहून्यपि ।\nवृथा भवन्ति राजेन्द्र भस्मन्याज्याहुतिर्यथा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2210694, "chapter_id": 5505, "verse_number": "३६", "content_sanskrit": "एतेषु यत् फलं किञ्चिद् भविष्यति कथञ्चन ।\nराक्षसाश्च पिशाचाश्च तद्विलुम्पन्ति हर्षिताः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2210695, "chapter_id": 5505, "verse_number": "३७", "content_sanskrit": "वृथा ह्येतानि दानानि कथितानि समासतः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2210696, "chapter_id": 5505, "verse_number": "३८", "content_sanskrit": "जीवितं च वृथा येषां तच्छृणुष्व युधिष्ठिर ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2210697, "chapter_id": 5505, "verse_number": "३९", "content_sanskrit": "ये च मां न प्रपद्यन्ते शङ्करं वा नराधमाः ।\nब्राह्मणान् वा महादेवान् वृथा जीवन्ति ते नराः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2210698, "chapter_id": 5505, "verse_number": "४०", "content_sanskrit": "ये च निन्दन्ति मां मूढाः शङ्करं वा नराधमाः ।\nब्राह्मणान् वा द्विजान् वेदान् वृथा जीवन्ति ते नराः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2210699, "chapter_id": 5505, "verse_number": "४१", "content_sanskrit": "हेतुशास्त्रेषु ये हृष्टाः कुदृष्टिपथमाश्रिताः ।\nवेदान् निन्दन्त्यनाचारा वृथा जीवन्ति ते नराः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2210700, "chapter_id": 5505, "verse_number": "४२", "content_sanskrit": "कुशलैः कृतशास्त्राणि पठित्वा ये नराधमाः ।\nविप्रान् निन्दन्ति यज्ञांश्च वृथा जीवन्ति ते नराः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2210701, "chapter_id": 5505, "verse_number": "४३", "content_sanskrit": "ये च दुर्गां कुमारं वा वायुमग्निं जलं रविम् ।\nपितरं मातरं चैव गुरुं नित्यं निशाकरम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2210702, "chapter_id": 5505, "verse_number": "४४", "content_sanskrit": "मूढा निन्दन्त्यनाचारा वृथा जीवन्ति ते नराः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2210703, "chapter_id": 5505, "verse_number": "४५", "content_sanskrit": "विद्यमाने धने यस्तु दानधर्मविवर्जितः ।\nमृष्टमश्नाति यश्चैको वृथा जीवति सोऽप्युत ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2210704, "chapter_id": 5505, "verse_number": "४६", "content_sanskrit": "वृथा जीवितमाख्यातं दानकालं ब्रवीमि ते ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2210705, "chapter_id": 5505, "verse_number": "४७", "content_sanskrit": "तमोनिविष्टचित्तेन दत्तं दानं तु यद्भवेत् ।\nस तस्य फलमश्नाति नरो गर्भगतो नृप ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2210706, "chapter_id": 5505, "verse_number": "४८", "content_sanskrit": "ईर्ष्यामात्सर्यसंयुक्तो डम्भार्थं चार्थकारणात् ।\nददाति दानं यो मर्त्यो बालभावे तदश्नुते ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2210707, "chapter_id": 5505, "verse_number": "४९", "content_sanskrit": "भोक्तु भोगान(भोगम)शक्तस्तु व्याधिभिः पीडितो भृशम् ।\nददाति दानं यो मर्त्यो वृद्धभावे तदश्नुते ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2210708, "chapter_id": 5505, "verse_number": "५०", "content_sanskrit": "श्रद्धायुक्तः शुचिः स्नातः प्रसन्नेन्द्रियमानसः ।\nदानं ददाति यो मर्त्यो यौवने स तदश्नुते ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2210709, "chapter_id": 5505, "verse_number": "५१", "content_sanskrit": "स्वयं नीत्वा तु यद्दानं भक्त्या पात्रे प्रदीयते ।\nतत् सार्वकालिकं विद्धि दानमामरणान्तिकम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2210710, "chapter_id": 5505, "verse_number": "५२", "content_sanskrit": "सात्विकं राजसं चैव तामसं च युधिष्ठिर ।\nदानं दानफलं चैव गतिं च त्रिविधां शृणु ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2210711, "chapter_id": 5505, "verse_number": "५३", "content_sanskrit": "दानं दातव्यमित्येव मतिं कृत्वा द्विजाय वै ।\nउपकारवियुक्ताय यद्दत्तं तद्धि सात्विकम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2210712, "chapter_id": 5505, "verse_number": "५४", "content_sanskrit": "श्रोत्रियाय दरिद्राय बहुपुत्राय पाण्डव ।\nदीयते यत् प्रहृष्टेन तत् सात्विकमुदाहृतम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2210713, "chapter_id": 5505, "verse_number": "५५", "content_sanskrit": "वेदाक्षरविहीनाय यत्तु पूर्वोपकारिणे ।\nसमृद्धाय च यद्दत्तं तद्दानं राजसं स्मृतम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2210714, "chapter_id": 5505, "verse_number": "५६", "content_sanskrit": "सम्बन्धिने च यद्दत्तम् अव्रताय च पाण्डव ।\nलोभादितर(भिर)पात्राय तद्दानं राजसं स्मृतम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2210715, "chapter_id": 5505, "verse_number": "४७", "content_sanskrit": "वैश्वदेवविहीनाय दानमश्रोत्रियाय यत् ।\nदीयते तस्करायापि तद्दानं तामसं स्मृतम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2210716, "chapter_id": 5505, "verse_number": "५८", "content_sanskrit": "सरोषमवधूतं च कोपयुक्तमवज्ञया ।\nसेवकाय च यद्दत्तं तद्दानं तामसं स्मृतम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2210717, "chapter_id": 5505, "verse_number": "५९", "content_sanskrit": "देवाः पितृगणाश्चैव पितरश्चाग्नयस्तथा ।\nसात्विकं दानमश्नन्ति तुष्यन्ति च नरेश्वर ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2210718, "chapter_id": 5505, "verse_number": "६०", "content_sanskrit": "दानवा दैत्यसङ्घाश्च ग्रहा यक्षाश्च राक्षसाः ।\nराजसं दानमश्नन्ति वर्जितं पितृदैवतैः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2210719, "chapter_id": 5505, "verse_number": "६१", "content_sanskrit": "पिशाचाः प्रेतसङ्घाश्च कश्मला ये मलीमसाः ।\nतामसं दानमश्नन्ति गतिं च त्रिविधां शृणु ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2210720, "chapter_id": 5505, "verse_number": "६२", "content_sanskrit": "सात्विकानां तु दानानामुत्तमं फलमिष्यते ।\nमध्यमं राजसानां तु तामसानां तु पश्चिमम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2210721, "chapter_id": 5505, "verse_number": "६३", "content_sanskrit": "अभिगम्योपनीतानां दानानामुत्तमं फलम् ।\nमध्यमं तु समानीय जघन्यं याचते फलम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2210722, "chapter_id": 5505, "verse_number": "६४", "content_sanskrit": "अयाचितप्रदाता वै स याति गतिमुत्तमाम् ।\nसमाहूय तु वै दद्यान्मध्यमां स गतिं व्रजेत् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2210723, "chapter_id": 5505, "verse_number": "", "content_sanskrit": "(याचितो यस्तु वै दद्यात् जघन्यां स गतिं व्रजेत् ॥६५॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2210724, "chapter_id": 5505, "verse_number": "६६", "content_sanskrit": "उत्तमा दैविकी ज्ञेया मध्यमा मानुषी गतिः ।\nजघन्या चैव तिर्यक्षु गतिरेषा त्रिधा मता ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2210725, "chapter_id": 5505, "verse_number": "६७", "content_sanskrit": "पात्रभूतेषु विप्रेषु सुस्थितेष्वाहिताग्निषु ।\nयत्तु प्रक्षिप्यते दानमक्षय्यं तत् प्रकीर्त्यते ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2210726, "chapter_id": 5505, "verse_number": "६८", "content_sanskrit": "श्रोत्रियाणां दरिद्राणां भरणं कुरु पाण्डव ।\nसमृद्धानां द्विजातीनां कार्यं ते परिरक्षणम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2210727, "chapter_id": 5505, "verse_number": "६९", "content_sanskrit": "दरिद्रान् वृत्तिहीनांश्च प्रदानैस्तु सुपूजयेत् ।\nआतुरस्यौषधैः कार्यं नीरुजस्य किमौषधैः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2210728, "chapter_id": 5505, "verse_number": "७०", "content_sanskrit": "पापं प्रतिग्रहीतारं प्रदातुरुपगच्छति ।\nप्रतिग्रहीतुर्यत् पुण्यं प्रदातारमुपैति तत् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2210729, "chapter_id": 5505, "verse_number": "७१", "content_sanskrit": "तस्माद् दानं सदा कार्यं परत्र हितमिच्छता ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2210730, "chapter_id": 5505, "verse_number": "७२", "content_sanskrit": "वेदविद्यावदातेषु सदा शूद्रान्नवर्जिषु ।\nप्रयत्नेन निधातव्यो महादानमयो निधिः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2210731, "chapter_id": 5505, "verse_number": "७३", "content_sanskrit": "येषां दाता प्रतीक्षेत सहस्रस्येव लम्भनम् ।\nभुक्तशेषस्य भक्तस्य तान् निमन्त्रय भारत ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2210732, "chapter_id": 5505, "verse_number": "७४", "content_sanskrit": "आमन्त्र्य तु निराशानि न कर्तव्यानि पाण्डव ।\nकुलानि सुदरिद्राणि तेषामाशा हता भवेत् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2210733, "chapter_id": 5505, "verse_number": "७५", "content_sanskrit": "मद्भक्ता ये नरश्रेष्ठ मद्गता मत्परायणाः ।\nमद् याजिनो मन्नियमास्तान् प्रयत्नेन पूजयेत् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2210734, "chapter_id": 5505, "verse_number": "७६", "content_sanskrit": "तेषां तु पावनायाहं नित्यमेव युधिष्ठिर ।\nउभे सन्ध्येऽपि तिष्ठामि ह्यस्कन्नं तद् व्रतं मम ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2210735, "chapter_id": 5505, "verse_number": "७७", "content_sanskrit": "तस्मादष्टाक्षरं मन्त्रं मद्भक्तैर्वीतकल्मषैः ।\nसन्ध्याकालेषु जप्तव्यं सततं चात्मशुद्धये ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2210736, "chapter_id": 5505, "verse_number": "७८", "content_sanskrit": "अन्येषामपि विप्राणां किल्बिषं हि प्रणश्यति ।\nउभे सन्ध्येऽप्युपासीत तस्माद् विप्रो विशुद्धये ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2210737, "chapter_id": 5505, "verse_number": "७९", "content_sanskrit": "दैवे श्राद्धे च विप्रः स नियोक्तव्योऽजुगुप्सितः ।\nजुगुप्सितस्तु तच्छ्राद्धं दहत्यग्निरिवेन्धनम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2210738, "chapter_id": 5505, "verse_number": "८०", "content_sanskrit": "पुराणं मानवो धर्मो वेदाः साङ्गाश्चिकित्सितम् ।\nआज्ञासिद्धानि चत्वारि न हन्तव्यानि हेतुभिः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2210739, "chapter_id": 5505, "verse_number": "८१", "content_sanskrit": "न ब्राह्मणान् परीक्षेत दैवे कर्मणि धर्मवित् ।\nमहान् भवेत् परीवादो ब्राह्मणानां परीक्षणे ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2210740, "chapter_id": 5505, "verse_number": "८२", "content_sanskrit": "ब्राह्मणानां परीवादं यः कुर्यात् स नराधमः ।\nसहसैव शुनां योनिं स गच्छेद् ब्रह्मदूषकः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2210741, "chapter_id": 5505, "verse_number": "८३", "content_sanskrit": "श्वत्वं प्राप्नोति निन्दित्वा परीवादात् खरो भवेत् ।\nपरिभूय कृमिर्भवति कीटो भवति मत्सरी ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2210742, "chapter_id": 5505, "verse_number": "८४", "content_sanskrit": "दुर्वृत्ता वा सुवृत्ता वा प्राकृता वा सुसंस्कृताः ।\nब्राह्मणा नावमन्तव्या भस्मच्छन्ना इवाग्नयः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2210743, "chapter_id": 5505, "verse_number": "८५", "content_sanskrit": "क्षत्रियं चैव सर्पं च ब्राह्मणं च बहुश्रुतम् ।\nनावमन्येत मेधावी कृशानपि कदाचन ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2210744, "chapter_id": 5505, "verse_number": "८६", "content_sanskrit": "एतत् त्रयं हि पुरुषं निर्दहेदवमानिनम् ।\nतस्मादेतत् प्रयत्नेन नावमन्येत बुद्धिमान् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2210745, "chapter_id": 5505, "verse_number": "८७", "content_sanskrit": "यथा सर्वास्ववस्थासु पावको दैवतं महत् ।\nतथा सर्वास्ववस्थासु ब्राह्मणो दैवतं महत् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2210746, "chapter_id": 5505, "verse_number": "८८", "content_sanskrit": "व्यङ्गाः कुब्जाश्च काणाश्च वामनाङ्गास्तथैव च ।\nसर्वे दैवे नियोक्तव्या व्यामिश्रा वेदपारगैः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2210747, "chapter_id": 5505, "verse_number": "८९", "content_sanskrit": "मन्युं नोत्पादयेत् तेषां न चानिष्टं समाचरेत् ।\nमन्युप्रहरणा विप्रा न विप्राः शस्त्रपाणयः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2210748, "chapter_id": 5505, "verse_number": "९०", "content_sanskrit": "मन्युना घ्नन्ति ते शत्रून् वज्रेणेन्द्र इवासुरान् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2210749, "chapter_id": 5505, "verse_number": "९१", "content_sanskrit": "ब्राह्मणो हि महद्दैवं जातमात्रेण जायते ।\nईश्वरः सर्वभूतानां धर्मकोशस्य गुप्तये ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2210750, "chapter_id": 5505, "verse_number": "९२", "content_sanskrit": "किं पुनर्ये च कौन्तेय सन्ध्ये नित्यमुपासते ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2210751, "chapter_id": 5505, "verse_number": "९३", "content_sanskrit": "यस्यास्येन समश्नन्ति हव्यानि त्रिदिवौकसः ।\nकव्यानि चैव पितरः किं भूतमधिकं ततः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2210752, "chapter_id": 5505, "verse_number": "९४", "content_sanskrit": "उत्पत्तिरेव विप्रस्य मूर्तिर्धर्मस्य शाश्वती ।\nस हि धर्मार्थमुत्पन्नो ब्रह्मभूयाय कल्पते ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2210753, "chapter_id": 5505, "verse_number": "९५", "content_sanskrit": "स्वमेव ब्राह्मणो भुङ्क्ते स्वं वस्ते स्वं ददाति च ।\nआनृशंस्याद् ब्राह्मणस्य भुञ्जते हीतरे जनाः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2210754, "chapter_id": 5505, "verse_number": "९६", "content_sanskrit": "तस्मात् ते नावमन्तव्या मद्भक्ता हि द्विजाः सदा ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2210755, "chapter_id": 5505, "verse_number": "९७", "content_sanskrit": "आरण्यकोपनिषदि ये तु पश्यन्ति मां द्विजाः ।\nनिगूढं निष्कलावस्थं तान् प्रयत्नेन पूजयेत् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2210756, "chapter_id": 5505, "verse_number": "९८", "content_sanskrit": "स्वगृहे वा प्रवासे वा दिवा रात्रौ तथैव च ।\nश्रद्धया ब्राह्मणाः पूज्या मद्भक्ता ये च पाण्डव ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2210757, "chapter_id": 5505, "verse_number": "९९", "content_sanskrit": "नास्ति विप्रसमं दैवं नास्ति विप्रसमो गुरुः ।\nनास्ति विप्रसमो बन्धुर्नास्ति विप्रसमो निधिः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2210758, "chapter_id": 5505, "verse_number": "१००", "content_sanskrit": "नास्ति विप्रसमं तीर्थं न पुण्यं ब्राह्मणात् परम् ।\nन पवित्रं परं विप्रान्न विप्रात् पावनं परम् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2210759, "chapter_id": 5505, "verse_number": "१०१", "content_sanskrit": "नास्ति विप्रात् परो धर्मो नास्ति विप्रात् परा गतिः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2210760, "chapter_id": 5505, "verse_number": "१०२", "content_sanskrit": "पापकर्मसमाक्षिप्तं पतन्तं नरके नरम् ।\nत्रायते दानमप्येकं पात्रभूते द्विजे कृतम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2210761, "chapter_id": 5505, "verse_number": "१०३", "content_sanskrit": "बालाहिताग्नयो ये च शान्ताः शूद्रान्नवर्जिताः ।\nमामर्चयन्ति मद्भक्तास्तेभ्यो दत्तं तदक्षयम् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2210762, "chapter_id": 5505, "verse_number": "१०४", "content_sanskrit": "प्रदानैः पूजितो विप्रो वन्दितो वाऽपि कृत्स्नशः ।\nसम्भावितो वा विप्रो वै मद्भक्तो दिवमुन्नयेत् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2210763, "chapter_id": 5505, "verse_number": "१०५", "content_sanskrit": "ये पठन्ति नमस्यन्ति ध्यायन्ति पुरुषास्तु माम् ।\nतांश्च स्पृष्ट्वाऽथवा दृष्ट्वा नरः पापैः प्रमुच्यते ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2210764, "chapter_id": 5505, "verse_number": "१०६", "content_sanskrit": "मद्भक्ता मद्गतप्राणा मद्गता मत्परायणाः ।\nबीजयोनिविशुद्धा ये श्रोत्रियाः संयतेन्द्रियाः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2210765, "chapter_id": 5505, "verse_number": "१०७", "content_sanskrit": "शूद्रान्नविरता नित्यं ते पुनन्तीह दर्शनात् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2210766, "chapter_id": 5505, "verse_number": "१०८", "content_sanskrit": "स्वयं नीत्वा विशेषेण दानं तेषां गृहेष्वथ ।\nनिधापयेत्तु यद्भक्त्या तद्दानं कोटिसम्मितम् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2210767, "chapter_id": 5505, "verse_number": "१०९", "content_sanskrit": "जग्रतः स्वपतो वाऽपि प्रवासे स्वगृहेऽथवा ।\nहृदये न प्रणश्यामि यस्य विप्रस्य भारत ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2210768, "chapter_id": 5505, "verse_number": "११०", "content_sanskrit": "स पूजितो वा दृष्टो वा स्पृष्टो वाऽपि द्विजोत्तमः ।\nसम्भाषितो वा राजेन्द्र पुनातीह नरं सदा ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2210769, "chapter_id": 5505, "verse_number": "१११", "content_sanskrit": "एवं सर्वास्ववस्थासु सर्वदानानि पाण्डव ।\nमद्भक्तेभ्यः प्रदत्तानि स्वर्गमार्गप्रदानि वै ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2210770, "chapter_id": 5505, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि वैष्णवधर्मशास्त्रे विप्रमाहात्म्यं नाम एकोनशततमोऽध्यायः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}]