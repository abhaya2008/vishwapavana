[{"id": 2104004, "chapter_id": 3248, "verse_number": "१४-१०४-१", "content_sanskrit": "युधिष्ठिर उवाच।\nविप्रयोगे शरीरस्य सेन्द्रियस्य विशेषतः।\nअन्तरा वर्तमानस्य गतिः प्राणस्य कीदृशी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2104005, "chapter_id": 3248, "verse_number": "१४-१०४-२x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2104006, "chapter_id": 3248, "verse_number": "१४-१०४-२", "content_sanskrit": "शुभाशुभकृतं सर्वं प्राप्नोतीह फलं नरः।\nन तु सर्वस्य भूतस्य पञ्चत्वं विद्यते नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2104007, "chapter_id": 3248, "verse_number": "१४-१०४-३", "content_sanskrit": "पञ्चत्वं पाण्डवश्रेष्ठ भूरिभूतिकरं नृणाम्।\nतेषां पञ्च महायज्ञान्ये कुर्वन्ति द्विजोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2104008, "chapter_id": 3248, "verse_number": "१४-१०४-४", "content_sanskrit": "पञ्चत्वं पञ्चभिर्भूतैर्वियोगं संप्रचक्षते।\nन जायते न म्रियते पुरुषः शाश्वतः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2104009, "chapter_id": 3248, "verse_number": "१४-१०४-५", "content_sanskrit": "प्रायेण मरणं नाम पापिनामेव पाण्डव।\nयेषां तु न गतिः पुण्या तेषां मरणमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2104010, "chapter_id": 3248, "verse_number": "१४-१०४-६", "content_sanskrit": "प्रायेणाकृतकृत्यस्तु मृत्योरुद्विजते जनः।\nकृतकृत्याः प्रतीक्षन्ते मृत्युं प्रियमिवातिथिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2104011, "chapter_id": 3248, "verse_number": "१४-१०४-७x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2104012, "chapter_id": 3248, "verse_number": "१४-१०४-७", "content_sanskrit": "पञ्च यज्ञाः कथं देव क्रियन्तेऽत्र द्विजातिभिः।\nतेषां नाम च देवेश वक्तुमर्हस्यशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2104013, "chapter_id": 3248, "verse_number": "१४-१०४-८x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2104014, "chapter_id": 3248, "verse_number": "१४-१०४-८", "content_sanskrit": "शृणु पञ्च महायज्ञान्कीर्त्यमानान्युधिष्ठिर।\nयैरेव ब्रह्मसालोक्यं लभ्यते गृहमेधिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2104015, "chapter_id": 3248, "verse_number": "१४-१०४-९", "content_sanskrit": "ऋभुजज्ञं ब्रह्मयज्ञं भूतयज्ञं च पाण्डव।\nनृयज्ञं पितृयज्ञं च पञ्च यज्ञान्प्रचक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2104016, "chapter_id": 3248, "verse_number": "१४-१०४-१०", "content_sanskrit": "तर्पणं ऋभुयज्ञः स्यात्स्वाध्यायो ब्रह्मयज्ञकः।\nभूतयज्ञो बलिर्यज्ञो नृयज्ञोऽतिथिपूजनम्।\nपितॄनुद्दिश्य यत्कर्म पितृयज्ञः प्रकीर्तितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2104017, "chapter_id": 3248, "verse_number": "१४-१०४-११", "content_sanskrit": "हुतं चाप्यहुतं चैव तथा प्रहुतमेव च।\nप्राशितं बलिदानं च पाकयज्ञान्प्रचक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2104018, "chapter_id": 3248, "verse_number": "१४-१०४-१२", "content_sanskrit": "वैश्वदेवादयो होमा हुतमित्युच्यते बुधैः।\nअहुतं च भवेद्दत्तं प्रहुतं ब्राह्मणाशितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2104019, "chapter_id": 3248, "verse_number": "१४-१०४-१३", "content_sanskrit": "प्राणाग्निहोत्रहोमं च प्राशितं विधिवद्विदुः।\nबलिकर्म च राजेन्द्र पाकयज्ञाः प्रकीर्तिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2104020, "chapter_id": 3248, "verse_number": "१४-१०४-१४", "content_sanskrit": "केचित्पञ्च महायज्ञान्पाकयज्ञान्प्रचक्षते।\nअपरे ब्रह्मयज्ञादीन्महायज्ञविदो विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2104021, "chapter_id": 3248, "verse_number": "१४-१०४-१५", "content_sanskrit": "सर्व एते महायज्ञाः सर्वथा परिकीर्तिताः।\nबुभुक्षितान्ब्राह्मणांस्तु यथाशक्ति न हापयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2104022, "chapter_id": 3248, "verse_number": "१४-१०४-१६", "content_sanskrit": "अहन्यहनि ये त्वेतानकृत्वा भुञ्जते स्वयम्।\nकेवलं मलमश्नन्ति ते नार न च संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2104023, "chapter_id": 3248, "verse_number": "१४-१०४-१७", "content_sanskrit": "तस्मात्स्नात्वा द्विजो विद्वान्कुर्यादेतान्दिनेदिने।\nअतोऽन्यथा तु भुञ्जन्वै प्रायश्चित्ती भवेद्द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2104024, "chapter_id": 3248, "verse_number": "१४-१०४-१८x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2104025, "chapter_id": 3248, "verse_number": "१४-१०४-१८", "content_sanskrit": "देवदेवेशक दैत्यघ्न त्वद्भक्तस्य जनार्दन।\nवक्तुमर्हसि देवेश स्नानस्य च विधिं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2104026, "chapter_id": 3248, "verse_number": "१४-१०४-१९x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2104027, "chapter_id": 3248, "verse_number": "१४-१०४-१९", "content_sanskrit": "शृणु पाण्डव तत्सर्व पवित्रं पापनाशनम्।\nस्नात्वा येन विधानेन मुच्यन्ते किल्बिषाद्द्विजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2104028, "chapter_id": 3248, "verse_number": "१४-१०४-२०", "content_sanskrit": "मृदं च गोमयं चैव तिलं दर्भांस्तथैव च।\nपुष्पाण्यपि यथान्यायमादाय तु जलं व्रजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2104029, "chapter_id": 3248, "verse_number": "१४-१०४-२१", "content_sanskrit": "नद्यां स्नात्वा न च स्नायदन्यत्र द्विजसत्तम।\nसति प्रभूते पयसि नाल्पे स्नायात्कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2104030, "chapter_id": 3248, "verse_number": "१४-१०४-२२", "content_sanskrit": "गत्वोदकसमीपं तु शुचौ देशे मनोरमे।\nततो मृद्गोमयादीनि तत्र विप्रो विनिक्षिपेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2104031, "chapter_id": 3248, "verse_number": "१४-१०४-२३", "content_sanskrit": "बहिः प्रक्षाल्य पादौ च द्विराचम्य प्रयत्नतः।\nप्रदक्षिणं समावृत्य नमस्कुर्यात्तु तज्जलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2104032, "chapter_id": 3248, "verse_number": "१४-१०४-२४", "content_sanskrit": "न च प्रक्षालयेद्विद्वांस्तीर्थमद्भिः कदाचन।\nन च पादेन वा हन्याद्धस्तेनान्येन तज्जलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2104033, "chapter_id": 3248, "verse_number": "१४-१०४-२५", "content_sanskrit": "सर्वदेवमया ह्यापो मन्मयाः पाण्डुनन्दन।\nतस्मात्तास्तु न हन्तव्यास्त्वद्भिः प्रक्षालयेत्स्थलं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2104034, "chapter_id": 3248, "verse_number": "१४-१०४-२६", "content_sanskrit": "केवलं प्रथमं मज्जेन्नाङ्गानि विमृशेद्बुधः।\nतत्तु तीर्थं समासाद्य कुर्यादाचमनं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2104035, "chapter_id": 3248, "verse_number": "१४-१०४-२७", "content_sanskrit": "गोकर्णाकृतिवत्कृत्वा करं त्रिः प्रपिबेज्जलम्।\nद्विस्तत्परिमृजेद्वक्त्रं पादावभ्युक्ष्य चात्मनः।\nशीर्षण्यांस्तु ततः प्राणान्सकृदेवतु संस्पृशेन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2104036, "chapter_id": 3248, "verse_number": "१४-१०४-२८", "content_sanskrit": "बाहू द्वौ च ततः स्पृष्ट्वा हृदयं नाभिमेव च।\nप्रत्यङ्गमुदकं स्पृष्ट्वा मूर्धानं तु पुनः स्पृशेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2104037, "chapter_id": 3248, "verse_number": "१४-१०४-२९", "content_sanskrit": "आपः पुनन्त्वित्युक्त्वा च पुनराचमनं चरेत्।\nसोङ्कारव्याहृतीर्वाऽपि सदसस्पतिमित्यृचम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2104038, "chapter_id": 3248, "verse_number": "१४-१०४-३०", "content_sanskrit": "आचम्य मृत्तिकाः पश्चात्त्रिधा कृत्वा समालभेत्।\nऋचेदं विष्णुरित्यङ्गमुत्तमाधममध्यमम्।\nआलभ्य वारुणैः सूक्तैर्नमस्कृत्य जलं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2104039, "chapter_id": 3248, "verse_number": "१४-१०४-३१", "content_sanskrit": "स्रवन्ती चेत्प्रतिस्रोतः प्रत्यर्कं चान्यवारिषु।\nमज्जेदोमित्युदाहृत्य न च विक्षोभयेज्जलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2104040, "chapter_id": 3248, "verse_number": "१४-१०४-३२", "content_sanskrit": "गोमयं च त्रिधा कृत्वा जले पूर्वं समालभेत्।\nसव्याहृतीकां सप्रणवां गायत्रीं च जपेत्पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2104041, "chapter_id": 3248, "verse_number": "१४-१०४-३३", "content_sanskrit": "पुनराचमनं कृत्वा मद्गतेनान्तरात्मना।\nआपोहिष्ठेति तिसृभिर्ऋग्भिः पूतेन वारिणा।\nतथा तरत्समन्दीभिः सिञ्चेच्चतसृभिः क्रमात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2104042, "chapter_id": 3248, "verse_number": "१४-१०४-३४", "content_sanskrit": "गोसूक्तेनाश्वसूक्तेन शुद्धवर्गेणि चात्मनः।\nवैष्णवैर्वारुणैः सूक्तैः सावित्रैरिन्द्रदेवतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2104043, "chapter_id": 3248, "verse_number": "१४-१०४-३५", "content_sanskrit": "वामदैव्येन चात्मानमन्यैर्मन्मयसामभिः।\nस्थित्वाऽन्तःसलिले सूक्तं जपेद्वाचाऽघमर्षणं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2104044, "chapter_id": 3248, "verse_number": "१४-१०४-३६", "content_sanskrit": "सव्याहृतीकां सप्रणवां गायत्रीं वा ततो जपेत्।\nआश्वासमोक्षात्प्रणवं जपेद्वा मामनुस्मरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2104045, "chapter_id": 3248, "verse_number": "१४-१०४-३७", "content_sanskrit": "उत्प्लुत्य तीर्थमासाद्य धौते शुक्ले च वाससी॥\nशुद्धे चाच्छादयेत्कक्षे न कुर्यात्परिपाशके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2104046, "chapter_id": 3248, "verse_number": "१४-१०४-३८", "content_sanskrit": "पाशेन बद्ध्वा कक्षे यत्कुरुते कर्म वैदिकम्।\nराक्षसा दानवा दैत्यास्तद्विलुंपन्ति हर्षिताः।\nतस्मत्सर्वप्रयत्नेन कक्ष्यापाशं न धारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2104047, "chapter_id": 3248, "verse_number": "१४-१०४-३९", "content_sanskrit": "ततः प्रक्षाल्य पादौ च हस्तौ चैव मृदा शनैः।\nआचम्य पुनराचामेत्पुनः सावित्रिया द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2104048, "chapter_id": 3248, "verse_number": "१४-१०४-४०", "content_sanskrit": "प्राङ्मुखोदङ्मुखो वाऽपि ध्यायन्वेदान्समाहितः।\nजले जलगतः शुद्धः स्थल एव स्थलस्थितः।\nउभयत्र स्थितस्तस्मादाचामेदात्मशुद्धये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2104049, "chapter_id": 3248, "verse_number": "१४-१०४-४१", "content_sanskrit": "दर्भेषु दर्भपाणिः सन्प्राङ्मुखः सुसमाहितः।\nप्राणायामांस्ततः कुर्यान्मद्गतेनान्तरात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2104050, "chapter_id": 3248, "verse_number": "१४-१०४-४२", "content_sanskrit": "सहस्रकृत्वः सावित्रीं शतकृत्वस्तु वा जपेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2104051, "chapter_id": 3248, "verse_number": "१४-१०४-४३", "content_sanskrit": "समाहितो जपेत्तस्मात्सावित्र्या चाभिमन्त्र्य च।\nमन्देहानां विनाशाय रक्षसां विक्षिपेज्जलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2104052, "chapter_id": 3248, "verse_number": "१४-१०४-४४", "content_sanskrit": "उद्वर्गोसीत्यथा चान्तःप्रायश्चित्तजलं क्षिपेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2104053, "chapter_id": 3248, "verse_number": "१४-१०४-४५", "content_sanskrit": "अथादाय सुपुष्पाणि तोयमञ्जलिना द्विजः\nप्रक्षिप्य प्रतिसूर्यं च व्योममुद्रां प्रकल्पयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2104054, "chapter_id": 3248, "verse_number": "१४-१०४-४६", "content_sanskrit": "ततो द्वादशकृत्वस्तु सूर्यस्येकाक्षरं जपेत्।\nततः षडक्षरादीनि षट्कृत्वः परिवर्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2104055, "chapter_id": 3248, "verse_number": "१४-१०४-४७", "content_sanskrit": "प्रदक्षिणं परामृश्य मुद्रया स्वमुखान्तरे।\nऊर्ध्वबाहुस्ततो भूत्वा सूर्यमीक्षेत्समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2104056, "chapter_id": 3248, "verse_number": "१४-१०४-४८", "content_sanskrit": "तन्मण्डलस्थं मां ध्यायंस्तोजोमूर्तिं चतुर्भुजम्।\nउदुत्यं च जपेन्मन्त्रं चित्रं तच्चक्षुरित्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2104057, "chapter_id": 3248, "verse_number": "१४-१०४-४९", "content_sanskrit": "सावित्रीं च यथाशत्ति जप्त्वा सूक्तं च मामकम्।\nमन्मयानि च सामानि पुरुषव्रतमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2104058, "chapter_id": 3248, "verse_number": "१४-१०४-५०", "content_sanskrit": "ततश्चालोकयेदर्कं हंसः शुचिषदित्यपि।\nप्रदक्षिणं समावृत्य नमस्कृत्य दिवाकरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2104059, "chapter_id": 3248, "verse_number": "१४-१०४-५१", "content_sanskrit": "ततस्तु तर्पयेदद्भिर्ब्रह्म्णां मां च शङ्करम्।\nप्रजापतिं च देवांश्च तथा देवमुनीनपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2104060, "chapter_id": 3248, "verse_number": "१४-१०४-५२", "content_sanskrit": "साङ्गानपि तथा वेदानितिहासान्क्रतूनपि।\nपुराणानि च सर्वाणि कुलान्यप्सरसां तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2104061, "chapter_id": 3248, "verse_number": "१४-१०४-५३", "content_sanskrit": "क्रतून्संवत्सरं चैव कलाकाष्ठात्मकं तथा।\nभूतग्रामांश्च भूतानि सरितः सागरांस्तथा।\nशैलाञ्शैलस्थितान्देवानोषधीः सवनस्पतीः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2104062, "chapter_id": 3248, "verse_number": "१४-१०४-५४", "content_sanskrit": "तर्पयेदुपवीती च प्रत्येकं तृप्यतामिति।\nअन्वारभ्य च सव्येन पाणिना दक्षिणेन तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2104063, "chapter_id": 3248, "verse_number": "१४-१०४-५५", "content_sanskrit": "निवीती तर्पयेद्विद्वानृषीन्मन्त्रकृतस्तथा।\nमरीच्यादीनृषींश्चैव नारदाद्यान्समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2104064, "chapter_id": 3248, "verse_number": "१४-१०४-५६", "content_sanskrit": "प्राचीनावीत्यथैतास्तु तर्पयेद्देवताः पितॄत्।\nततस्तु कव्यवाडग्निं सों वैवस्वतं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2104065, "chapter_id": 3248, "verse_number": "१४-१०४-५७", "content_sanskrit": "ततश्चार्यमणं चापि ह्यग्निष्वात्तांस्तथैव च।\nसोमपांश्चैव दर्भेषु सतिलैरेव वारिभिः।\nतृप्यतामिति पश्चात्तु स पितॄंस्तर्पयेत्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2104066, "chapter_id": 3248, "verse_number": "१४-१०४-५८", "content_sanskrit": "पितॄन्पितामहांश्चैव तथैव प्रपितामहान्।\nपितामहीस्तता चापि तथैव प्रपितामहीः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2104067, "chapter_id": 3248, "verse_number": "१४-१०४-५९", "content_sanskrit": "मातरं चात्मनश्चैव गुरुमाचार्यमेव च।\nपितृमातृष्वसारौ च तथा मातामहीमपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2104068, "chapter_id": 3248, "verse_number": "१४-१०४-६०", "content_sanskrit": "उपाध्यायान्सखीन्बन्धूञ्शिष्यर्त्विग्ज्ञातिबांधवान्।\nप्रमीतानानृशंस्यार्थं तर्पयेत्तानमत्सरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2104069, "chapter_id": 3248, "verse_number": "१४-१०४-६१", "content_sanskrit": "तर्पयित्वा तथाऽऽचम्य स्नानवस्त्रं प्रपीडयेत्।\nवृत्तिं भृत्यजनस्याहुः स्नानं पानं च तद्विदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2104070, "chapter_id": 3248, "verse_number": "१४-१०४-६२", "content_sanskrit": "अतर्पयित्वा तान्पूर्वं स्नानवस्त्रं न पीडयेत्।\nपीडयेच्चेत्पुरा मोहाद्देवाः सर्पिगणास्तथा।\nपितरस्तु निराशास्ते शप्त्वा यान्ति यथागतं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2104071, "chapter_id": 3248, "verse_number": "१४-१०४-६३", "content_sanskrit": "प्रक्षाल्य तु मृदा पादावाचम्य प्रयतः पुनः।\nदर्भेषु दर्भपाणिः सन्स्वाध्यायं तु समारभेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2104072, "chapter_id": 3248, "verse_number": "१४-१०४-६४", "content_sanskrit": "वेदमादौ समारभ्य ततोपर्युपरि क्रमात्।\nयदधीतेऽन्वहं शक्त्या तत्स्वाध्यायं प्रचक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2104073, "chapter_id": 3248, "verse_number": "१४-१०४-६५", "content_sanskrit": "ऋचो वाऽपि यजुर्वाऽपि सामगायमथापि च।\nइतिहासपुराणानि यथाशक्ति न हापयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2104074, "chapter_id": 3248, "verse_number": "१४-१०४-६६", "content_sanskrit": "उत्थाय तु नमस्कृत्य दिशो दिग्देवता अपि।\nब्रह्मणं च ततश्चाग्निं पृथिवीमोषधीस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2104075, "chapter_id": 3248, "verse_number": "१४-१०४-६७", "content_sanskrit": "वाचं वाचस्पतिं चैव मां चैव सरितस्तथा।\nनमस्कृत्य तथाऽद्भिस्तु प्रणवादि च पूर्ववत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2104076, "chapter_id": 3248, "verse_number": "१४-१०४-६८", "content_sanskrit": "ततो नमोऽद्भ्य इत्युक्त्वा नमस्कुर्यात्तु तज्जलम्।\nघृणिः सूर्यस्तथाऽऽदित्यस्तं प्रणम्य स्वमूर्धनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2104077, "chapter_id": 3248, "verse_number": "१४-१०४-६९", "content_sanskrit": "ततस्त्वालोकयन्नर्कं प्रणवेन समाहितः।\nततो मामर्चयेत्पुष्पैर्मत्प्रियैरेव नित्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2104078, "chapter_id": 3248, "verse_number": "१४-१०४-७०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2104079, "chapter_id": 3248, "verse_number": "१४-१०४-७०", "content_sanskrit": "त्वत्प्रियाणि प्रसूनानि त्वदधिष्ठानि माधव।\nसर्वाण्याचक्ष्व देवेश त्वद्भक्तस्य ममाच्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2104080, "chapter_id": 3248, "verse_number": "१४-१०४-७१x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2104081, "chapter_id": 3248, "verse_number": "१४-१०४-७१", "content_sanskrit": "शृणुष्वावहितो राजन्पुष्पाणि प्रियकृन्ति मे।\nकुमुदं करवीरं च चणकं चंपकं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2104082, "chapter_id": 3248, "verse_number": "१४-१०४-७२", "content_sanskrit": "मल्लिकाजातिपुष्पं च नन्द्यावर्तं च नन्दिकम्।\nपलाशपुष्पपत्राणि दूर्वा भृङ्गकमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2104083, "chapter_id": 3248, "verse_number": "१४-१०४-७३", "content_sanskrit": "वनमाला च राजेन्द्र मत्प्रियाणि विशेषतः।\nसर्वेषामपि पुष्पाणां सहस्रगुणमुत्पलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2104084, "chapter_id": 3248, "verse_number": "१४-१०४-७४", "content_sanskrit": "तस्मात्पद्मं तथा राजन्पद्मात्तु सतपत्रकम्।\nतस्मात्सहस्रपत्रं तु पुण्डरीकं ततः परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2104085, "chapter_id": 3248, "verse_number": "१४-१०४-७५", "content_sanskrit": "पुण्डरीकसहस्रात्तु तुलसी गुणतोऽधिका।\nबकपुष्पं ततस्तस्मात्सौवर्णं तु ततोऽधिकम्।\nसौवर्णात्तु प्रसूनाच्च मत्प्रियं नास्ति पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2104086, "chapter_id": 3248, "verse_number": "१४-१०४-७६", "content_sanskrit": "पुष्पाभावे तुलस्यास्तु पत्रैर्मामर्चयेत्पुनः।\nपत्रालाभे तु शाखाभिः शाकालाभे शिफालवैः।\nशिफाभावे मृदा तत्र भक्तिमानर्चयेत माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2104087, "chapter_id": 3248, "verse_number": "१४-१०४-७७", "content_sanskrit": "वर्जनीयानि पुष्पाणि शृणु राजन्समाहितः।\nकिङ्किणी मुनिपुष्पं च धुर्धूरं पाटलं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2104088, "chapter_id": 3248, "verse_number": "१४-१०४-७८", "content_sanskrit": "तथाऽतिमुक्तकं चैव पुन्नागं नक्तमालिकम्।\nयौधिकं क्षीरिकापुष्पं निर्गुण्डी लाङ्गुली जपा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2104089, "chapter_id": 3248, "verse_number": "१४-१०४-७९", "content_sanskrit": "कर्णिकारं तथाऽशोकं शल्मलीपुष्पमेव च।\nककुभाः कोविदाराश्च वैभीतकमथापि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2104090, "chapter_id": 3248, "verse_number": "१४-१०४-८०", "content_sanskrit": "कुरण्टकप्रसूनं च कल्पकं कालकं तथा।\nअङ्केलं गिरिकर्णी च नीलान्येव च सर्वशः।\nएकपर्णानि चान्यानि सर्वाण्येव विवर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2104091, "chapter_id": 3248, "verse_number": "१४-१०४-८१", "content_sanskrit": "अर्कपुष्पाणि वर्ज्यानि अर्कपत्रस्तितानि च।\nव्याघृताः पिचुमन्दानि सर्वाण्येव विवर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2104092, "chapter_id": 3248, "verse_number": "१४-१०४-८२", "content_sanskrit": "अन्यैस्तु शुक्लपत्रैस्तु गन्धवद्भिर्नराधिप।\nअवर्ज्यैस्तैर्यथालाभं मद्भक्तो मां समर्चयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2104093, "chapter_id": 3248, "verse_number": "१४-१०४-८३x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2104094, "chapter_id": 3248, "verse_number": "१४-१०४-८३", "content_sanskrit": "कथं त्वमर्चनीयोसि मूर्तयः कीदृशास्तु ते।\nवैखानसाः कथं ब्रुयूः कथं वा पाञ्चरात्रिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2104095, "chapter_id": 3248, "verse_number": "१४-१०४-८४x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2104096, "chapter_id": 3248, "verse_number": "१४-१०४-८४", "content_sanskrit": "शृणु पाण्डव तत्सर्वमर्चनाक्रममात्मनः।\nस्थण्डिले पद्मकं कृत्वा चाष्टपत्रं सकर्णिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2104097, "chapter_id": 3248, "verse_number": "१४-१०४-८५", "content_sanskrit": "अष्टाक्षरविधानेन ह्यथवा द्वादशाक्षरैः।\nवैदिकैरथ मन्त्रैश्च मम सूक्तेन वा पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2104098, "chapter_id": 3248, "verse_number": "१४-१०४-८६", "content_sanskrit": "स्थापितं मां ततस्तस्मिन्नर्ययित्वा विचक्षणः।\nपुरुषं च ततः सत्यमत्युतं च युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2104099, "chapter_id": 3248, "verse_number": "१४-१०४-८७", "content_sanskrit": "अनिरुद्धं च मां प्राहुर्वैखानसविदो जनाः।\nअन्ये त्वेवं विजानन्ति मां राजन्पाञ्चरात्रिकाः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2104100, "chapter_id": 3248, "verse_number": "१४-१०४-८८", "content_sanskrit": "वासुदेवं च राजेन्द्र संकर्षणमथापि वा।\nप्रद्युम्नं चानिरुद्धं च चतुर्मूर्तिं प्रचक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2104101, "chapter_id": 3248, "verse_number": "१४-१०४-८९", "content_sanskrit": "एताश्चान्याश्च राजेन्द्र संज्ञाभेदेन मूर्तयः।\nविद्ध्यार्थान्तरा एवं मामेवं चार्चयेद्भुधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2104102, "chapter_id": 3248, "verse_number": "१४-१०४-९०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2104103, "chapter_id": 3248, "verse_number": "१४-१०४-९०", "content_sanskrit": "त्वद्भक्ताः कीदृसा देव कानि तेषं व्रतानि च।\nएतत्कथय देवेश त्वद्भक्तस्य ममाच्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2104104, "chapter_id": 3248, "verse_number": "१४-१०४-९१x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2104105, "chapter_id": 3248, "verse_number": "१४-१०४-९१", "content_sanskrit": "अनन्यदेवताभक्ता चे मद्भक्तजनप्रियाः।\nमामेव शरणं प्राप्ता मद्भक्तास्ते प्रकीर्तिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2104106, "chapter_id": 3248, "verse_number": "१४-१०४-९२", "content_sanskrit": "स्वर्ग्याण्यपि यशस्यानि मत्प्रियाणि विशेषतः।\nमद्भक्तः पाण्डवश्रेष्ठ व्रतानीमानि धारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2104107, "chapter_id": 3248, "verse_number": "१४-१०४-९३", "content_sanskrit": "नान्यदाच्छादयेद्वस्त्रं मद्भक्तो जलतारणे।\nस्वस्थस्तु न दिवा स्वप्येन्मधुमांसानि वर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2104108, "chapter_id": 3248, "verse_number": "१४-१०४-९४", "content_sanskrit": "प्रदक्षिणं व्रजेद्विप्रान्गामश्वत्थं हुताशनम्।\nन धावेत्पतिते वर्षे नाग्नभिक्षां च लोपयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2104109, "chapter_id": 3248, "verse_number": "१४-१०४-९५", "content_sanskrit": "प्रत्यक्षलवणं नाद्यत्सौभाञ्जनकरञ्जनौ।\nग्रासमुष्टिं गवपे दद्याद्धान्याम्लं चैव वर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2104110, "chapter_id": 3248, "verse_number": "१४-१०४-९६", "content_sanskrit": "तथा पर्युषितं चापि पक्वं परगृहागतम्।\nअनिवेदितं च यद्द्रव्यं तत्प्रयत्नेन वर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2104111, "chapter_id": 3248, "verse_number": "१४-१०४-९७", "content_sanskrit": "विभितककरञ्जानां छायां दूरे विवर्जयेत्।\nपिप्रदेवपरीवादान्न वदेत्पीडितोपि सन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2104112, "chapter_id": 3248, "verse_number": "१४-१०४-९८", "content_sanskrit": "सात्विका राजसाश्चापि तामसाश्चापि पाण्डव।\nमामर्चयन्ति मद्भक्तास्तेषामीदृग्विदा गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2104113, "chapter_id": 3248, "verse_number": "१४-१०४-९९", "content_sanskrit": "तामसास्तिमिरं यान्ति राजसा रज एव तत्।\nसात्विकाः सत्वसंपन्नाः सत्वमेव प्रयान्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2104114, "chapter_id": 3248, "verse_number": "१४-१०४-१००", "content_sanskrit": "ये सिद्धाः सन्ति साङ्ख्येन योगसत्वबलेन च।\nनभस्यादित्यचन्द्राभ्यां पश्यन्ति पदविस्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2104115, "chapter_id": 3248, "verse_number": "१४-१०४-१०१", "content_sanskrit": "एकस्तंभे नवद्वारे त्रिस्थूणे पञ्चसाक्षिके।\nएतस्मिन्देहनगरे राजसस्तु सदा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2104116, "chapter_id": 3248, "verse_number": "१४-१०४-१०२", "content_sanskrit": "उदिते सवितर्याप्य क्रियायुक्तस्य धीमतः।\nचतुर्वेदविदश्चापि देहे षड्वृषलाः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2104117, "chapter_id": 3248, "verse_number": "१४-१०४-१०३", "content_sanskrit": "क्षत्रियाः सप्त विज्ञेया वैश्यास्त्वष्टौ प्रकीर्तिताः।\nनियताः पाण्डवश्रेष्ठ शूद्राणामेकविंशतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2104118, "chapter_id": 3248, "verse_number": "१४-१०४-१०४", "content_sanskrit": "कामः क्रोधश्च लोभश्च मोहश्च मद एव च।\nमहामोहश्च इत्येते देहे षड्वृषलाः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2104119, "chapter_id": 3248, "verse_number": "१४-१०४-१०५", "content_sanskrit": "गर्वः स्तंभो ह्यहङ्कार ईर्ष्या च द्रोह एव च।\nपारुष्यं क्रूरता चैव सप्तैत क्षत्रियाः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2104120, "chapter_id": 3248, "verse_number": "१४-१०४-१०६", "content_sanskrit": "तीक्ष्णता निकृतिर्माया शाठ्यं डंभो ह्यनार्जवम्।\nपैशुन्यमनृतं चैव वेश्यास्त्वष्टौ प्रकीर्तिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2104121, "chapter_id": 3248, "verse_number": "१४-१०४-१०७", "content_sanskrit": "तृष्णा बुभुक्षा निद्रा च ह्यालस्यं चाघृणादयः।\nआधिश्चापि विषादश्च प्रमादो हीनसत्वता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2104122, "chapter_id": 3248, "verse_number": "१४-१०४-१०८", "content_sanskrit": "भयं विक्लबता जाड्यं पापकं मन्युरेव च।\nआशा चाश्रद्दधानत्वमनवस्थाप्यमन्त्रणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2104123, "chapter_id": 3248, "verse_number": "१४-१०४-१०९", "content_sanskrit": "आशौचं मलिनत्वं च शूद्रा ह्येते प्रकीर्तिताः।\nयस्मिन्नेते न दृश्यन्ते स वै ब्राह्मण उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2104124, "chapter_id": 3248, "verse_number": "१४-१०४-११०", "content_sanskrit": "येषुयेषु हि भावेषु यत्कालं वर्तते द्विजः।\nतत्कालं वै स विज्ञेयो ब्राह्मणो ज्ञानदुर्बलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2104125, "chapter_id": 3248, "verse_number": "१४-१०४-१११", "content_sanskrit": "प्राणानायम्य यत्कालं येन मां चापि चिन्तयेत्।\nतत्कालो वै द्विजो ज्ञेयः शेषकालो ह्यथेतरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2104126, "chapter_id": 3248, "verse_number": "१४-१०४-११२", "content_sanskrit": "तस्मात्तु सात्विको भूत्वा शुचिः क्रोधविवर्जितः।\nमामर्चयेत्तु सततं मत्प्रियत्वं यदीच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2104127, "chapter_id": 3248, "verse_number": "१४-१०४-११३", "content_sanskrit": "अलोलजिह्वः समुपस्थितो धृतिं\nनिधाय चक्षुर्युगमात्रमेव तत।\nमनश्च वाचं च निगृह्य चञ्चलं\nभयान्निवृत्तो मम भक्त उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2104128, "chapter_id": 3248, "verse_number": "१४-१०४-११४", "content_sanskrit": "ईदृशाध्यात्मिनो ये तु ब्राह्मणा नियतेन्द्रियाः।\nतेषां श्राद्धेषु तृप्यन्ति तेन तृप्ताः पितामहाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2104129, "chapter_id": 3248, "verse_number": "१४-१०४-११५", "content_sanskrit": "धर्मो जयति नाधर्मः सत्यं जयति नानृतम्।\nक्षमा जयति न क्रोधः क्षमावान्ब्राह्मणो भवेत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2104130, "chapter_id": 3248, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि वैष्णवधर्मपर्वणि चतुरधिकशततमोऽध्यायः॥ १०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}]