[{"id": 7000809000, "chapter_id": 20809, "verse_number": "६-१५२-१", "content_sanskrit": "महादेव उवाच ।\nतीर्थानां प्रवरं तीर्थं साभ्रमत्यास्तटे स्थितम् ।\nबालाप इति विख्यातं भुक्तिमुक्तिप्रदायकम्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000809001, "chapter_id": 20809, "verse_number": "६-१५२-२", "content_sanskrit": "तपस्विधारितं तीर्थं विबुधानां समाश्रयम् ।\nतत्र कन्या तपस्तेपे परमं सुदृढव्रता॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000809002, "chapter_id": 20809, "verse_number": "६-१५२-३", "content_sanskrit": "कन्या कण्वमुनेः साध्वी रूपेणाप्रतिमा भुवि ।\nबाला बालावती नाम कुमारी ब्रह्मचारिणी॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000809003, "chapter_id": 20809, "verse_number": "६-१५२-४", "content_sanskrit": "व्रतं चचार सावित्र्या नियमैर्बहुभिर्युता ।\nभर्ता मे भास्करो भूयादिति निश्चित्य भामिनि॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000809004, "chapter_id": 20809, "verse_number": "६-१५२-५", "content_sanskrit": "समास्तस्य समाक्रांता दश साभ्रमतीतटे ।\nचरंत्या नियमांस्तांस्तान्भक्त्या परमदुश्चरान्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000809005, "chapter_id": 20809, "verse_number": "६-१५२-६", "content_sanskrit": "तस्यास्तु तेन व्रतेन तपसा व्रतचर्यया ।\nभक्त्या च भगवान्प्रीतः परया भक्तिसंपदा॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000809006, "chapter_id": 20809, "verse_number": "६-१५२-७", "content_sanskrit": "आजगामाश्रमपदं देवदेवो दिवाकरः ।\nआस्थाय रूपं विप्रर्षेः प्रविष्टस्तु महामनाः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000809007, "chapter_id": 20809, "verse_number": "६-१५२-८", "content_sanskrit": "सा तं दृष्ट्वोग्रतपसा वरिष्ठं ब्रह्मवित्तमम् ।\nवानप्रस्थविधानेन पूजयामास तं द्विजम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000809008, "chapter_id": 20809, "verse_number": "६-१५२-९", "content_sanskrit": "उवाच रविभक्ता सा कल्याणी तं तपोधनम् ।\nभगवन्मुनिशार्दूल किमाज्ञापयसि प्रभो॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000809009, "chapter_id": 20809, "verse_number": "६-१५२-१०", "content_sanskrit": "सर्वं तुभ्यं यथाशक्ति दास्यामि स्वतनुं विना ।\nसूर्यभक्तास्मि ते पाणिं दास्यामि न कथंचन॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000809010, "chapter_id": 20809, "verse_number": "६-१५२-११", "content_sanskrit": "व्रतैश्च नियमैश्चापि तपोभिश्च तपोधन ।\nसूर्यस्तोषयितव्यो मे देवस्त्रिभुवनेश्वरः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000809011, "chapter_id": 20809, "verse_number": "६-१५२-१२", "content_sanskrit": "इत्युक्तवत्यां तस्यां तु स्मयन्निव निरीक्ष्य ताम् ।\nउवाच नियमस्थां तां सांत्वयन्निव भास्करः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000809012, "chapter_id": 20809, "verse_number": "६-१५२-१३", "content_sanskrit": "उग्रं चरसि कल्याणि तपः परमदुष्करम् ।\nयदर्थं च समारंभस्तव बाले तथैव तत्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000809013, "chapter_id": 20809, "verse_number": "६-१५२-१४", "content_sanskrit": "तपसा लभ्यते सर्वं सर्वं तपसि तिष्ठति ।\nदेवत्वं प्राप्यते भद्रे तपसा मोक्ष एव च॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000809014, "chapter_id": 20809, "verse_number": "६-१५२-१५", "content_sanskrit": "इमानि पंच सुभगे बदराणि प्रतीच्छ मे ।\nदत्त्वा स बदराण्यस्यै पचेत्युक्त्वा रविर्ययौ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000809015, "chapter_id": 20809, "verse_number": "६-१५२-१६", "content_sanskrit": "अपृष्ट्वा तां तु कल्याणीं ब्रह्मरूपी विहाय ताम् ।\nस्थितोऽसौ नातिदूरेण इंद्रग्रामे महायशाः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000809016, "chapter_id": 20809, "verse_number": "६-१५२-१७", "content_sanskrit": "स्थित्वा जिज्ञासया भावं तस्याश्च ब्राह्मणो रविः ।\nबदराणामुपवनं कारयामास भास्करः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000809017, "chapter_id": 20809, "verse_number": "६-१५२-१८", "content_sanskrit": "ततः सा प्रयता बाला प्रांजलिर्विगतश्रमा ।\nपाकाय बदराणां सा पावकं समधिश्रयत्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000809018, "chapter_id": 20809, "verse_number": "६-१५२-१९", "content_sanskrit": "अपचत्परमा देवि बदराणि महाप्रभा ।\nतस्याः पचंत्याः सुमहान्कालोऽगाच्च सुरेश्वरि॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000809019, "chapter_id": 20809, "verse_number": "६-१५२-२०", "content_sanskrit": "भस्मपुंजो महान्जातो दिनं च क्षयमन्वगात् ।\nहुताशनेन दग्धस्तु महान्वै काष्ठसंचयः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000809020, "chapter_id": 20809, "verse_number": "६-१५२-२१", "content_sanskrit": "पादौ प्रक्षाल्य सा पश्चात्पावके चारुदर्शने ।\nददाह बदरार्थं च ब्राह्मणप्रियकाम्यया॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000809021, "chapter_id": 20809, "verse_number": "६-१५२-२२", "content_sanskrit": "दग्ध्वा दग्ध्वा पुनः पादौ उपर्या धार्यतेऽनघे ।\nअथास्याः कर्म तद्दृष्ट्वा प्रीतो देवो दिवाकरः॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000809022, "chapter_id": 20809, "verse_number": "६-१५२-२३", "content_sanskrit": "ततः संदर्शयामास कन्यायै रूपमात्मनः ।\nउवाच परमप्रीतस्तां कन्यां सुदृढव्रताम्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000809023, "chapter_id": 20809, "verse_number": "६-१५२-२४", "content_sanskrit": "सूर्य उवाच ।\nप्रीतोऽस्मि बाले भक्त्या ते तपसा व्रतचर्यया ।\nयस्मादभिमतः कामो बाले संपद्यतां तव॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000809024, "chapter_id": 20809, "verse_number": "६-१५२-२५", "content_sanskrit": "अस्मिंस्तीर्थे तपोयुक्ता मद्गृहे त्वं निवत्स्यसि ।\nइदं च तीर्थप्रवरं तव नाम्ना च लक्षितम्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000809025, "chapter_id": 20809, "verse_number": "६-१५२-२६", "content_sanskrit": "बालाप इति विख्यातं साभ्रमत्यास्तटे स्थितम् ।\nविख्यातं त्रिषु लोकेषु ब्रह्मर्षिभिस्तु स्तुतं पुरा॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000809026, "chapter_id": 20809, "verse_number": "६-१५२-२७", "content_sanskrit": "बालातीर्थे नरः स्नात्वा त्रिरात्रमुषितः शुचिः ।\nरक्तादित्यमुखं दृष्ट्वा सूर्यस्योदयनं प्रति॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000809027, "chapter_id": 20809, "verse_number": "६-१५२-२८", "content_sanskrit": "सूर्यलोकमवाप्नोति नात्र कार्या विचारणा ।\nसूर्यवारेऽथ संक्रांतौ सप्तम्यां तु विशेषतः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000809028, "chapter_id": 20809, "verse_number": "६-१५२-२९", "content_sanskrit": "विषुवत्ययने चापि चंद्रसूर्यग्रहेऽपि च ।\nस्नात्वा संतर्पयेद्देवान्पितॄनथ पितामहान्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000809029, "chapter_id": 20809, "verse_number": "६-१५२-३०", "content_sanskrit": "गुडधेनुं ततो दद्याद्ब्राह्मणेभ्यो गुडोदनम् ।\nकरवीरैर्जपापुष्पै रक्तादित्यप्रपूजनम्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000809030, "chapter_id": 20809, "verse_number": "६-१५२-३१", "content_sanskrit": "ये कुर्वंति नरास्ते वै सूर्यलोके वसंति वै ।\nरक्तां धेनुं नरो दद्यादेकं चैव धुरंधरम्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000809031, "chapter_id": 20809, "verse_number": "६-१५२-३२", "content_sanskrit": "स यज्ञफलमाप्नोति न नरो निरयं व्रजेत् ।\nव्याधितो मुच्यते रोगात्बद्धो मुच्येत बंधनात् ।\nतीर्थेऽस्मिन्पिंडदानेन तृप्तिं यांति पितामहाः॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000809032, "chapter_id": 20809, "verse_number": "६-१५२-३३", "content_sanskrit": "महादेव उवाच ।\nतथान्यदपि माहात्म्यं तीर्थस्यास्य तपोधने ।\nश्रूयतां यत्पुरावृत्तं व्यासेन कथितं महत्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000809033, "chapter_id": 20809, "verse_number": "६-१५२-३४", "content_sanskrit": "पुरात्र महिषो वृद्धो जरया जर्जरीकृतः ।\nअशक्तो भारमुद्वोढुं सार्थवाहस्तमत्यजत्॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000809034, "chapter_id": 20809, "verse_number": "६-१५२-३५", "content_sanskrit": "स निदाघे जलं पातुं जगाम च महानदीम् ।\nदैवात्पंके निमग्नोऽसौ ततो मृत्युवशं गतः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000809035, "chapter_id": 20809, "verse_number": "६-१५२-३६", "content_sanskrit": "प्लवितास्थिर्जले पुण्ये तीर्थस्यास्य प्रभावतः ।\nकान्यकुब्जेश्वरसुतो राजा जातिस्मरोऽभवत्॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000809036, "chapter_id": 20809, "verse_number": "६-१५२-३७", "content_sanskrit": "संस्मृत्य च स्ववृत्तांतं प्रभावं तीर्थजं महत् ।\nआगत्य तज्जले स्नात्वा ददौ दानान्यनेकशः॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000809037, "chapter_id": 20809, "verse_number": "६-१५२-३८", "content_sanskrit": "स तत्र स्थापयामास देवदेवं महेश्वरम् ।\nअत्र तीर्थे नरः स्नात्वा संपूज्य महिषेश्वरम्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000809038, "chapter_id": 20809, "verse_number": "६-१५२-३९", "content_sanskrit": "रक्तादित्यमुखं दृष्ट्वा सर्वपापैः प्रमुच्यते ।\nसाभ्रमत्युदकं यत्र पूर्वतः पश्चिमं व्रजेत्॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000809039, "chapter_id": 20809, "verse_number": "६-१५२-४०", "content_sanskrit": "प्रयागादपि तत्पुण्यं सर्वकामप्रदं महत् ।\nदत्तं द्विजेंद्रेषु हुतं यदग्नौ श्राद्धं कृतं जाप्यमिहाक्षयं स्यात्॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000809040, "chapter_id": 20809, "verse_number": "६-१५२-४१", "content_sanskrit": "गोभूतिलाः कांचनवस्त्रधान्यं शय्यासनं वाहनछत्रदानम् ।\nयं यं वांछयते कामं तं तं प्राप्नोति मानवः॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000809041, "chapter_id": 20809, "verse_number": "६-१५२-४२", "content_sanskrit": "श्रीमहेशप्रसादाच्च तीर्थस्यास्य प्रभावतः ।\nबालापेंद्रं इदं तीर्थं पुण्यपापहरं सदा॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000809042, "chapter_id": 20809, "verse_number": "६-१५२-४३", "content_sanskrit": "यं दृष्ट्वा मुनयः सर्वे वीतरागाः सदैव तु ।\nयत्र माहिषनामेति श्वेताख्यं पुण्यदं महत्॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000809043, "chapter_id": 20809, "verse_number": "६-१५२-४४", "content_sanskrit": "यत्र स्नात्वा तु देवेशि पुनर्जन्म न विद्यते ।\nगोदावर्यां कृते स्नाने यत्फलं लभते नरः॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000809044, "chapter_id": 20809, "verse_number": "६-१५२-४५", "content_sanskrit": "तत्फलं लभते देवि अत्र तीर्थे न संशयः॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]