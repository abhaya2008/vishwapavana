[{"id": 2110874, "chapter_id": 3397, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2110875, "chapter_id": 3397, "verse_number": "१", "content_sanskrit": "स्वर्गतः स तु राजेन्द्रो निवसन् देवसद्मनि ।\nपूजितः त्रिदशैः साध्यैर्मरुद्भिर्वसुभिस्तथा \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2110876, "chapter_id": 3397, "verse_number": "२", "content_sanskrit": "देवलोकाद् ब्रह्मलोकं सञ्चरन् पुण्यकृद् वशी ।\nअवसत् पृथिवीपालो दीर्घकालमिति श्रुतिः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2110877, "chapter_id": 3397, "verse_number": "३", "content_sanskrit": "स कदाचिन्नृपश्रेष्ठो ययातिः शक्रमागमत् ।\nकथान्ते तत्र शक्रेण स पृष्टः पृथिवीपतिः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2110878, "chapter_id": 3397, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2110879, "chapter_id": 3397, "verse_number": "४", "content_sanskrit": "यदा स पूरुस्तव रूपेण राज-\nञ्जरां गृहीत्वा विचचार भूमौ ।\nतदा राज्यं संप्रदायैव तस्मै\nत्वया किमुक्तः कथयेह सत्यम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2110880, "chapter_id": 3397, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2110881, "chapter_id": 3397, "verse_number": "५", "content_sanskrit": "गङ्गायमुनयोर्मध्ये कृत्स्नोऽयं विषयस्तव ।\nमध्ये पृथिव्यास्त्वं राजा भ्रातरोऽन्ताधिपास्तव\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2110882, "chapter_id": 3397, "verse_number": "६", "content_sanskrit": "न च कुर्यान्नरो दैन्यं शाठ्यं क्रोधं तथैव च ।\nज्यैष्ठ्यं च मत्सरं वैरं सर्वत्रैव न कारयेत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2110883, "chapter_id": 3397, "verse_number": "७", "content_sanskrit": "मातरं पितरं चैव विद्वांसं च तपोधनम् ।\nक्षमावन्तं च देवेन्द्र नावमन्येत बुद्धिमान् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2110884, "chapter_id": 3397, "verse_number": "८", "content_sanskrit": "शक्तस्तु बाधते नित्यमशक्तः क्रोशते नरः ।\nदुर्जनः सुजनं द्वेष्टि दुर्बलो बलवत्तरम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2110885, "chapter_id": 3397, "verse_number": "९", "content_sanskrit": "रूपवन्तमरूपी च धनवन्तं च निर्धनः ।\nअकर्मी कर्मिणं द्वेष्टि धर्मिणं च नधार्मिकः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2110886, "chapter_id": 3397, "verse_number": "१०", "content_sanskrit": "निर्गुणो गुणवन्तं च शक्रैतत् कलिलक्षणम् ।\nविपरीतं च देवेन्द्र एतेषां कृतलक्षणम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2110887, "chapter_id": 3397, "verse_number": "११", "content_sanskrit": "ब्राह्मणो वाऽथ राजा वा वैश्यो वा शूद्र एव वा ।\nप्रशस्तेषु प्रशस्ता ये प्रशस्यन्ते यशस्विनः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2110888, "chapter_id": 3397, "verse_number": "१२", "content_sanskrit": "तस्मात् प्रशस्ते देवेन्द्र नरः सक्तमना भवेत् ।\nअलोकज्ञा ह्यप्रशस्ता भ्रातरस्ते ह्यबुद्धयः ।\nअन्ताधिपतयः सर्वे ह्यभवन् मम शासनात्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2110889, "chapter_id": 3397, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2110890, "chapter_id": 3397, "verse_number": "१३", "content_sanskrit": "त्वं हि धर्मविदो राजन् कत्थसे धर्ममुत्तमम् ।\nकथयस्व पुनर्मेऽद्य लोकवृत्तान्तमुत्तमम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2110891, "chapter_id": 3397, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2110892, "chapter_id": 3397, "verse_number": "१४", "content_sanskrit": "अक्रोधनः क्रोधनेभ्यो विशिष्ट-\nस्तथा तितिक्षुरतितिक्षोर्विशिष्टः ।\nअमानुषेभ्यो मानुषाश्च प्रधाना\nविद्वांस्तथैवाविदुषः प्रधानः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2110893, "chapter_id": 3397, "verse_number": "१५", "content_sanskrit": "आक्रुश्यमानो नाक्रोशेन्मन्युरेव तितिक्षतः ।\nआक्रोष्टारं निर्दहति सुकृतं चास्य विन्दति\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2110894, "chapter_id": 3397, "verse_number": "१६", "content_sanskrit": "नारुन्तुदः स्यान्न नृशंसवादी\t\t\tन हीनतः परमभ्याददीत ।\t\tययाऽस्य वाचा पर उद्विजेत\t\t\tन तां वदेद् रुशतीं पापलोक्याम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2110895, "chapter_id": 3397, "verse_number": "", "content_sanskrit": "अरुन्तुदं परुषं रूक्षवाचं वाक्वण्टकैर्वितुदन्तं मनुष्यम् ।\nक्षिप्रं ह्यलक्ष्मीर्भजते मनुष्यं मुखे निबद्धां निकृतिं वहन्तम् \t॥१७", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2110896, "chapter_id": 3397, "verse_number": "१८", "content_sanskrit": "सद्भिः पुरस्तादभिपूजितः स्यात्\nसद्भिः सदा पृष्ठतो रक्षितः स्यात् ।\nसदाऽसतामतिवादांस्तितिक्षेत्\nसतां वृत्तं चाददीतार्यवृत्तः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2110897, "chapter_id": 3397, "verse_number": "१९", "content_sanskrit": "वाक्सायका वदनान्निस्सरन्ति\nयैराहतः शोचति रात्र्यहानि ।\nपरस्य चामर्मसु ये पतन्ति\nतान् पण्डितो नावसृजेत् परेषु\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2110898, "chapter_id": 3397, "verse_number": "२०", "content_sanskrit": "नैतादृशं संवननं त्रिषु लोकेषु विद्यते ।\nदया मैत्री च भूतेषु दानं च मधुरा च वाक्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2110899, "chapter_id": 3397, "verse_number": "२१", "content_sanskrit": "तस्मात् सान्त्वं सदा वाच्यं न वाच्यं परुषं क्वचित् ।\nपूज्यान् सम्पूजयेन्नित्यं न याचेच्च कदाचन\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2110900, "chapter_id": 3397, "verse_number": "७६", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nषट्सप्ततितमोऽध्यायः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2110901, "chapter_id": 3397, "verse_number": "२४", "content_sanskrit": "॥ सम्भवपर्वणि चतुर्विंशोऽध्यायः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]