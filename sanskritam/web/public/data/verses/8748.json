[{"id": 900009499, "chapter_id": 8748, "verse_number": "1.1", "content_sanskrit": "स्वभावतः स्वतन्त्रत्वप्रमुखैर्निखिलैर्गुणैः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900009500, "chapter_id": 8748, "verse_number": "1.2", "content_sanskrit": "ननु कथं विष्ण्वाख्यस्य परब्रह्मणः स्वतश्चेतनाचेतनात्मकविश्वभिन्नत्वम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900009501, "chapter_id": 8748, "verse_number": "1.3", "content_sanskrit": "नाप्यनुमानम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900009502, "chapter_id": 8748, "verse_number": "1.4", "content_sanskrit": "द्वा सुपर्णा' `द्वे ब्रह्मणी' इत्याद्यागमो लोकसिद्धभेदानुवादकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900009503, "chapter_id": 8748, "verse_number": "1.5", "content_sanskrit": "ननु किमत्र पक्षतावच्छेदकम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900009504, "chapter_id": 8748, "verse_number": "1.6", "content_sanskrit": "किञ्च विमतानि शरीराणि देवदत्तस्यैव भोगायतनानि शरीरत्वाद्देवदत्तशरीरवत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900009505, "chapter_id": 8748, "verse_number": "1.7", "content_sanskrit": "अपि च भेदो मिथ्या भेदत्वाच्चन्द्रभेदवत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900009506, "chapter_id": 8748, "verse_number": "1.8", "content_sanskrit": "अपि च । विमतं (तत्त्वतः) तात्विकस्वान्तर्भेदहीनं मतत्वतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900009507, "chapter_id": 8748, "verse_number": "1.9", "content_sanskrit": "ननु कथमाकाशभेदे प्रमाणाभावः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900009508, "chapter_id": 8748, "verse_number": "1.10", "content_sanskrit": "नन्वथाऽपि घटादिरूपोपाधिः किं गगनमात्रं स्पृशति उत गगनैकदेशम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900009509, "chapter_id": 8748, "verse_number": "1.11", "content_sanskrit": "ननु विद्यमान एव भेदो घटादिभिर्नाभिव्यज्यते चेत्तर्ह्युत्पद्यत इति वक्तव्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900009510, "chapter_id": 8748, "verse_number": "1.12", "content_sanskrit": "अत्रायं परिहारः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900009511, "chapter_id": 8748, "verse_number": "1.13", "content_sanskrit": "ननु ‘नाहं निर्दुःखो न सर्वज्ञ’ इति..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900009512, "chapter_id": 8748, "verse_number": "1.14", "content_sanskrit": "अनुमानानि च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900009513, "chapter_id": 8748, "verse_number": "1.15", "content_sanskrit": "नन्वत्र जीवशब्देनानवच्छिन्नचैतन्यविवक्षायां", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900009514, "chapter_id": 8748, "verse_number": "1.16", "content_sanskrit": "यद्वा जीवो ब्रह्मप्रतियोगिक(तात्त्विक)तादात्म्याधिकरणं न भवति..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900009515, "chapter_id": 8748, "verse_number": "1.17", "content_sanskrit": "यद्वा ब्रह्मप्रतियोगिकाभेदो न जीवधर्मिको भवति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900009516, "chapter_id": 8748, "verse_number": "1.18", "content_sanskrit": "नन्वौपाधिकभेदमात्रेण..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900009517, "chapter_id": 8748, "verse_number": "1.19", "content_sanskrit": "अपि च पृथिवीत्वं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900009518, "chapter_id": 8748, "verse_number": "1.20", "content_sanskrit": "द्रव्यत्वं पृथिवीत्वजलत्वतेजस्त्ववायुत्वमनस्त्वेतरजातिं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900009519, "chapter_id": 8748, "verse_number": "1.21", "content_sanskrit": "न चात्र द्रव्यत्वव्याप्यजातिमत्पदार्थान्तरसिद्ध्याऽर्थान्तरत्वम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900009520, "chapter_id": 8748, "verse_number": "1.22", "content_sanskrit": "व्यक्त्यभेदोऽपि न बाधकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900009521, "chapter_id": 8748, "verse_number": "1.23", "content_sanskrit": "नन्वेतावताऽऽत्मत्वस्य जातित्वमात्रं सिध्यति नात्मभेदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900009522, "chapter_id": 8748, "verse_number": "1.24", "content_sanskrit": "एवञ्चात्मा धर्मिसत्तासमानसत्ताकात्मप्रतियोगिकभेदाधिकरणं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900009523, "chapter_id": 8748, "verse_number": "1.25", "content_sanskrit": "एवं देवदत्तान्तःकरणं यज्ञदत्तान्तःकरणावच्छिन्नचैतन्याद्वस्तुतो ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900009524, "chapter_id": 8748, "verse_number": "1.26", "content_sanskrit": "श्रुतयश्च द्वा सुपर्णेत्यादिकाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900009525, "chapter_id": 8748, "verse_number": "1.27", "content_sanskrit": "यदि पुनरबाध्यो भेदस्तर्ह्यविवादः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900009526, "chapter_id": 8748, "verse_number": "1.28", "content_sanskrit": "यद्वा, तत्त्वमसीति श्रुत्यर्थापरिज्ञानादद्वैतप्राप्तिरस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 900009527, "chapter_id": 8748, "verse_number": "1.29", "content_sanskrit": "अनुमानं च घटः पटप्रतियोगिकतात्त्विकतादात्म्याधिकरणं न भवति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 900009528, "chapter_id": 8748, "verse_number": "1.30", "content_sanskrit": "ननु तथाऽपि (नन्वथापि) घटपटयोरपारमार्थिकभेदं वदता..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 900009529, "chapter_id": 8748, "verse_number": "1.31", "content_sanskrit": "ननु तर्हि घटे (घटेऽपि) घटत्वस्य मिथ्यात्वेन..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 900009530, "chapter_id": 8748, "verse_number": "1.32", "content_sanskrit": "किञ्च घटः...", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 900009531, "chapter_id": 8748, "verse_number": "1.33", "content_sanskrit": "यदुक्तमभेदे प्रत्यक्षं प्रमाणमिति तदसत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 900009532, "chapter_id": 8748, "verse_number": "1.34", "content_sanskrit": "विमता आत्मानः परमात्मनोऽपरमार्थतो (अपरमार्थतोऽपि) न भिद्यन्ते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 900009533, "chapter_id": 8748, "verse_number": "1.35", "content_sanskrit": "भेदत्वेन प्रतीयमानत्वादित्यत्र किमिदं प्रतीयमानत्वम् ?", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 900009534, "chapter_id": 8748, "verse_number": "1.36", "content_sanskrit": "यच्चेदमुच्यते (घटपटाद्यभेदेऽनुमानं प्रमाणमिति)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]