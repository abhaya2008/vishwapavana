[{"id": 2149577, "chapter_id": 4238, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2149578, "chapter_id": 4238, "verse_number": "१", "content_sanskrit": "पाञ्चालराजस्य सुतो राजन् परपुरञ्जयः ।\nशिखण्डी रथमुख्यो मे मतः पार्थस्य सम्मतः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2149579, "chapter_id": 4238, "verse_number": "२", "content_sanskrit": "एष योत्स्यति सङ्ग्रामे नाशयन् पूर्वसंस्थितम् ।\nवैरं योऽसौ सम्प्रथयन् तव सेनासु भारत\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2149580, "chapter_id": 4238, "verse_number": "३", "content_sanskrit": "एतस्य बहुलाः सेनाः पाञ्चालाश्च प्रभद्रकाः ।\nतेनाऽसौ रथवंशेन महत् कर्म करिष्यति\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2149581, "chapter_id": 4238, "verse_number": "४", "content_sanskrit": "धृष्टद्युम्नश्च सेनानीः सर्वसेनासु भारत ।\nमतो मेऽतिरथो राजन् द्रोणशिष्यो महारथः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2149582, "chapter_id": 4238, "verse_number": "५", "content_sanskrit": "एष योत्स्यति सङ्ग्रामे सूदयन् वै परान् बहून् ।\nभगवानिव सङ्क्रुद्धः पिनाकी युगसङ्क्षये\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2149583, "chapter_id": 4238, "verse_number": "६", "content_sanskrit": "एतस्य तद्रथानीकं कथयन्ति रणप्रियाः ।\nबहुत्वात् सागरप्रख्यं देवानामिव संयुगे\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2149584, "chapter_id": 4238, "verse_number": "७", "content_sanskrit": "धृतवर्मा तु राजेन्द्र मतो मेऽर्धरथो महान् ।\nधृष्टद्युम्नस्य तनयो बाल्यान्नातिकृतश्रमः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2149585, "chapter_id": 4238, "verse_number": "८", "content_sanskrit": "शिशुपालसुतो वीरः चेदिराजो महारथः ।\nधृष्टकेतुर्महेष्वासः सम्बन्धी पाण्डवस्य ह\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2149586, "chapter_id": 4238, "verse_number": "९", "content_sanskrit": "एष चेदिपतिः शूरः सह पुत्रेण भारत ।\nमहारथानां सुकरं महत् कर्म करिष्यति\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2149587, "chapter_id": 4238, "verse_number": "१०", "content_sanskrit": "क्षत्रधर्मरतो मह्यं मतः परपुरञ्जयः ।\nक्षत्रदेवस्तु राजेन्द्र पाण्डवेषु रथोत्तमः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2149588, "chapter_id": 4238, "verse_number": "११", "content_sanskrit": "जयन्तश्चामितौजाश्च सत्यजिच्च महारथः ।\nमहारथा महात्मानः सर्वे पाञ्चालसत्तमाः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2149589, "chapter_id": 4238, "verse_number": "१२", "content_sanskrit": "योत्स्यन्ति समरे तात संरब्धा इव कुञ्जराः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2149590, "chapter_id": 4238, "verse_number": "१३", "content_sanskrit": "अजो भोजश्च विक्रान्तौ पाण्डवेषु महारथौ ।\nपाण्डवानां सहायार्थे परं शक्त्या यतिष्यतः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2149591, "chapter_id": 4238, "verse_number": "१४", "content_sanskrit": "शीघ्रास्त्राश्चित्रयोद्धारः कृतिनो दृढविक्रमाः ।\nकेकयाः पञ्च राजेन्द्र भ्रातरो युद्धदुर्मदाः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2149592, "chapter_id": 4238, "verse_number": "१५", "content_sanskrit": "सर्वे चैव रथोदाराः सर्वे लोहितकध्वजाः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2149593, "chapter_id": 4238, "verse_number": "१६", "content_sanskrit": "काशिकः सुकुमारश्च नीलो यश्चापरो नृप ।\nसूर्यदत्तश्च शङ्खश्च मदिराक्षश्च नामतः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2149594, "chapter_id": 4238, "verse_number": "१७", "content_sanskrit": "सर्व एते रथोदाराः सर्वे चाहवलक्षणाः ।\nसर्वास्त्रविदुषः सर्वे महात्मानो मता मम\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2149595, "chapter_id": 4238, "verse_number": "१८", "content_sanskrit": "वार्धक्षेमिर्महाराज रथो मम महान् मतः ।\nचित्रायुधश्च नृपतिर्मतो मे रथसत्तमः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2149596, "chapter_id": 4238, "verse_number": "१९", "content_sanskrit": "स हि सङ्ग्रामशोभी च भक्तश्चापि किरीटिनः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2149597, "chapter_id": 4238, "verse_number": "२०", "content_sanskrit": "चेकितानः सत्यधृतिः पाण्डवानां महारथौ ।\nद्वाविमौ पुरुषव्याघ्रौ रथोदारौ मतौ मम\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2149598, "chapter_id": 4238, "verse_number": "२१", "content_sanskrit": "व्याघ्रदत्तश्च राजेन्द्र चन्द्रसेनश्च भारत ।\nमतौ मम रथोदारौ पाण्डवानां न संशयः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2149599, "chapter_id": 4238, "verse_number": "२२", "content_sanskrit": "सेनाबिन्दुश्च राजेन्द्र क्रोधहन्ता च नामतः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2149600, "chapter_id": 4238, "verse_number": "२३", "content_sanskrit": "यः समो वासुदेवेन भीमसेनेन चाभिभूः ।\nस योत्स्यति हि विक्रम्य समरे तव सैनिकैः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2149601, "chapter_id": 4238, "verse_number": "२४", "content_sanskrit": "मां च द्रोणं कृपं चैव यथा सम्मन्यते भवान् ।\nतथा स समरश्लाघी मन्तव्यो रथसत्तमः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2149602, "chapter_id": 4238, "verse_number": "२५", "content_sanskrit": "काश्यः परमशीघ्रास्त्रः श्लाघनीयो रथोत्तमः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2149603, "chapter_id": 4238, "verse_number": "२६", "content_sanskrit": "रथ एकगुणो मह्यं ज्ञेयः परपुरञ्जयः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2149604, "chapter_id": 4238, "verse_number": "२७", "content_sanskrit": "स्वयं च युधि विक्रान्तो मन्तव्योऽष्टगुणो रथः ।\nसत्यजित् समरश्लाघी द्रुपदस्यात्मजो युवा\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2149605, "chapter_id": 4238, "verse_number": "२८", "content_sanskrit": "गतः सोऽतिरथत्वं हि धृष्टद्युम्नेन सम्मितः ।\nपाण्डवानां यशस्कामो महत् कर्म करिष्यति\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2149606, "chapter_id": 4238, "verse_number": "२९", "content_sanskrit": "अनुरक्तश्च शूरश्च रथोऽयमपरो महान् ।\nपाण्ड्यराजो महावीर्यः पाण्डवानां धुरन्धरः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2149607, "chapter_id": 4238, "verse_number": "३०", "content_sanskrit": "दृढधन्वा महेष्वासः पाण्डवानां रथोत्तमः ।\nश्रेणिमान् कौरवश्रेष्ठ वसुदानश्च पार्थिवः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2149608, "chapter_id": 4238, "verse_number": "३१", "content_sanskrit": "उभावेतावतिरथौ मतौ मम परन्तपौ\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2149609, "chapter_id": 4238, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि एकोनसप्तत्युत्तरशततमोऽध्यायः ॥१६९॥\nरथातिरथसङ्ख्यानपर्वणि सप्तमोऽध्यायः ॥७॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]