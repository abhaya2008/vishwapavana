[{"id": 2093787, "chapter_id": 3004, "verse_number": "१३-१३४-१", "content_sanskrit": "युधिष्ठिर उवाच।\nचातुर्वर्ण्यस्य धर्मात्मन्धर्माः प्रोक्ता यथा त्वया।\nतथैव मे श्राद्धविधिं कृत्स्नं प्रब्रूहि पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2093788, "chapter_id": 3004, "verse_number": "१३-१३४-२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2093789, "chapter_id": 3004, "verse_number": "१३-१३४-२", "content_sanskrit": "युधिष्ठिरेणैवमुक्तो भीष्मः शान्तनवस्तदा।\nइमं श्राद्धविधिं कृत्स्नं वक्तुं समुपचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2093790, "chapter_id": 3004, "verse_number": "१३-१३४-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2093791, "chapter_id": 3004, "verse_number": "१३-१३४-३", "content_sanskrit": "शृणुष्वावहितो राजञ्श्राद्धकर्मविधिं शुभम्।\nधन्यं यशस्यं पुत्रीयं पितृयज्ञं परन्तप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2093792, "chapter_id": 3004, "verse_number": "१३-१३४-४", "content_sanskrit": "देवासुरमनुष्याणां गन्धर्वोरगरक्षसाम्।\nपिशाचकिन्नराणां च पूज्या वै पितरः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2093793, "chapter_id": 3004, "verse_number": "१३-१३४-५", "content_sanskrit": "पितॄन्पूज्यादितः पश्चाद्देवतास्तर्पयन्ति वै।\nतस्मात्तान्सर्वयत्नेन पुरुषः पूजयेत्सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2093794, "chapter_id": 3004, "verse_number": "१३-१३४-६", "content_sanskrit": "अन्वाहार्यं महाराज पितॄणां श्राद्धमुच्यते।\nतस्माद्विशेषविधिना विधिः प्रथमकल्पितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2093795, "chapter_id": 3004, "verse_number": "१३-१३४-७", "content_sanskrit": "सर्वेष्वहःसु प्रीयन्ते कृते श्राद्धे पितामहाः।\n`पिण्डान्वाहार्यकं श्राद्धं कुर्यान्मासानुमासिकम्।\nपितृयज्ञं तु निर्वर्त्य विप्रश्चन्द्रक्षयेऽग्निमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2093796, "chapter_id": 3004, "verse_number": "१३-१३४-८", "content_sanskrit": "पिण्डानां मासिकश्राद्धमन्वाहार्यं विदुर्बुधाः।\nतदामिषेण कुर्वीत प्रयतः प्राञ्जलिः शुचिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2093797, "chapter_id": 3004, "verse_number": "१३-१३४-९", "content_sanskrit": "प्रवक्ष्यामि तु ते सर्वांस्तिथ्यांतिथ्यां दिने गुणान्।\nयेष्वहःसु कृतैः श्राद्धैर्यत्फलं प्राप्यतेऽनघ।\nतत्सर्वं कीर्तयिष्यामि यथावत्तन्निबोध मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2093798, "chapter_id": 3004, "verse_number": "१३-१३४-१०", "content_sanskrit": "पितॄनर्च्य प्रतिपदि प्राप्नुयात्स्वगृहे स्त्रियः।\nअभिरूपप्रजायिन्यो दर्शनीया बहुप्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2093799, "chapter_id": 3004, "verse_number": "१३-१३४-११", "content_sanskrit": "स्त्रियो द्वितीयां जायन्ते तृतीयायां तु वाजिनः।\nचतुर्थ्यां क्षुद्रपशवो भवन्ति बहवो गृहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2093800, "chapter_id": 3004, "verse_number": "१३-१३४-१२", "content_sanskrit": "पञ्चम्यां बहवः पुत्रा जायन्ते कुर्वतां नृप।\nकुर्वाणास्तु नराः षष्ठ्यां भवन्ति द्युतिभागिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2093801, "chapter_id": 3004, "verse_number": "१३-१३४-१३", "content_sanskrit": "कृषिभागी भवेच्छ्राद्धं कुर्वाणः सप्तमीं नृप।\nअष्टम्यां तु प्रकुर्वाणो वाणिज्ये लाभमाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2093802, "chapter_id": 3004, "verse_number": "१३-१३४-१४", "content_sanskrit": "नवम्यां कुर्वतः श्राद्धं भवत्येकशफं बहु।\nविवर्धन्ते तु दशमीं गावः श्राद्धानि कुर्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2093803, "chapter_id": 3004, "verse_number": "१३-१३४-१५", "content_sanskrit": "कुप्यभागी भवेन्मर्त्यः कुर्वन्नेकादशीं नृप।\nब्रह्मवर्चस्विनः पुत्रा जायन्ते तस्य वेश्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2093804, "chapter_id": 3004, "verse_number": "१३-१३४-१६", "content_sanskrit": "द्वादश्यामीहमानस्य नित्यमेव प्रदृश्यते।\nरजतं बहुवित्तं च सुवर्णं च मनोरमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2093805, "chapter_id": 3004, "verse_number": "१३-१३४-१७", "content_sanskrit": "ज्ञातीनां तु भवेच्छ्रेष्ठः कुर्वञ्श्राद्धं त्रयोदशीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2093806, "chapter_id": 3004, "verse_number": "१३-१३४-१८", "content_sanskrit": "अवश्यं तु युवानोऽस्य प्रमीयन्ते नरा गृहे।\nयुद्धभागी भवेन्मर्त्यः कुर्वञ्श्राद्धं चतुर्दशीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2093807, "chapter_id": 3004, "verse_number": "१३-१३४-१९", "content_sanskrit": "अमावास्यां तु निवपन्सर्वकामानवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2093808, "chapter_id": 3004, "verse_number": "१३-१३४-२०", "content_sanskrit": "कृष्णपक्षे दशम्यादौ वर्जयित्वा चतुर्दशीम्।\nश्राद्धकर्मणि तिथ्यस्तु प्रशस्ता न तथेतराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2093809, "chapter_id": 3004, "verse_number": "१३-१३४-२१", "content_sanskrit": "यथा चैवापरः पक्षः पूर्वपक्षाद्विशिष्यते।\nतथा श्राद्धस्य पूर्वाह्णादपराह्णो विशिष्यते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2093810, "chapter_id": 3004, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि चतुस्त्रिंशदधिकशततमोऽध्यायः॥ १३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]