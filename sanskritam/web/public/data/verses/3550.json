[{"id": 2118543, "chapter_id": 3550, "verse_number": "", "content_sanskrit": "वैशम्पयानः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2118544, "chapter_id": 3550, "verse_number": "१", "content_sanskrit": "इन्द्रपस्थे वसन्तस्ते जघ्नुरन्यान् नराधिपान् ।\nशासनाद् धृतराष्ट्रस्य राज्ञः शान्तनवस्य च\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2118545, "chapter_id": 3550, "verse_number": "२", "content_sanskrit": "आश्रित्य धर्मराजानं सर्वलोकोऽवसत् सुखम् ।\nपुण्यलक्षणधर्माणं स्वदेहमिव देहिनः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2118546, "chapter_id": 3550, "verse_number": "३", "content_sanskrit": "स समं धर्मकामार्थान् सिषेवे भरतर्षभ ।\nत्रीनिवात्मसमान् बन्धून् बन्धुमानिव मानयन् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2118547, "chapter_id": 3550, "verse_number": "४", "content_sanskrit": "तेषां समविभक्तानां क्षितौ देहवतामिव ।\nबभौ धर्मार्थकामानां चतुर्थ इव पार्थिवः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2118548, "chapter_id": 3550, "verse_number": "५", "content_sanskrit": "अध्येतारं यथा वेदाः प्रयोक्तारं महाध्वराः ।\nरक्षितारं तथा वर्णा लेभिरे तं जनाधिपम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2118549, "chapter_id": 3550, "verse_number": "६", "content_sanskrit": "अधिष्ठानवती लक्ष्मीः परायणवती मही ।\nबन्धुमानखिलो लोकस्तेनासीत् पृथिवीक्षिता \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2118550, "chapter_id": 3550, "verse_number": "७", "content_sanskrit": "भ्रातृभिः सहितो राजा चतुर्भिरधिकं बभौ ।\nप्रयुज्यमानो विततो वेदैरिव महाध्वरः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2118551, "chapter_id": 3550, "verse_number": "८", "content_sanskrit": "तं तु धौम्यादयो विप्राः परिवार्योपतस्थिरे ।\nबृहस्पतिसमा बुद्ध्या प्रजापतिमिवाध्वरे \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2118552, "chapter_id": 3550, "verse_number": "९", "content_sanskrit": "धर्मराजे ह्यतिप्रीत्या पूर्णचन्द्र इवामले ।\nप्रजानां रेमिरे नित्यं नेत्राणि हृदयानि च \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2118553, "chapter_id": 3550, "verse_number": "१०", "content_sanskrit": "न तु केवलदैवेन प्रजा भावेन रेमिरे ।\nयद् बभूव मनःकान्तं कर्मणा स चकार तत् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2118554, "chapter_id": 3550, "verse_number": "११", "content_sanskrit": "न ह्ययुक्तं न दैन्यं च नानृतं न च विप्रियम् ।\nभाषितं चारुभाषस्य जज्ञे पार्थस्य धीमतः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2118555, "chapter_id": 3550, "verse_number": "१२", "content_sanskrit": "स हि सर्वस्य लोकस्य हितमात्मन एव च ।\nचिकीर्षुः सुमहातेजा रेमे भरतसत्तम \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2118556, "chapter_id": 3550, "verse_number": "१३", "content_sanskrit": "तथा तु मुदिताः सर्वे पाण्डवा विगतज्वराः ।\nअजयन् पृथिवीपालान् त्रासयन्तः स्वतेजसा \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2118557, "chapter_id": 3550, "verse_number": "१४", "content_sanskrit": "ततः कतिपयाहःसु बीभत्सुः कृष्णमब्रवीत् ।\nकृष्णकृष्ण निवर्तन्तां गच्छाव यमुनां प्रति \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2118558, "chapter_id": 3550, "verse_number": "१५", "content_sanskrit": "सुहृज्जनयुतास्तत्र विहृत्य मधुसूदन ।\nसायाह्ने विनिवर्तामो रोचतां ते जनार्दन \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2118559, "chapter_id": 3550, "verse_number": "", "content_sanskrit": "वासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2118560, "chapter_id": 3550, "verse_number": "१६", "content_sanskrit": "कुन्तीमातर्ममाप्येष रोचते यद् वयं जले ।\nसुहृज्जनवृताः पार्थ विहरेम यथासुखम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2118561, "chapter_id": 3550, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2118562, "chapter_id": 3550, "verse_number": "१७", "content_sanskrit": "आमन्त्र्य तौ धर्मराजमनुज्ञाप्य च भारत ।\nजग्मतुः पार्थगोविन्दौ सुहृज्जनवृतौ तदा \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2118563, "chapter_id": 3550, "verse_number": "१८", "content_sanskrit": "विहरन् खाण्डवप्रस्थे काननेषु च माधवः ।\nपुष्पितोपवनां रम्यां ददर्श यमुनां नदीम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2118564, "chapter_id": 3550, "verse_number": "१९", "content_sanskrit": "आलयं सर्वभूतानां खाण्डवं खड्गचर्मभृत् ।\nददर्श खाण्डवं देशं सहितः सव्यसाचिना \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2118565, "chapter_id": 3550, "verse_number": "२०", "content_sanskrit": "ऋक्षगोमायुसङ्घुष्टं हंससारसनादितम् ।\nशाखामृगगणैर्जुष्टं निकेतं सर्वरक्षसाम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2118566, "chapter_id": 3550, "verse_number": "२१", "content_sanskrit": "द्वीपिगोमायुसिंहर्क्षवराहरुरुवारणैः ।\nनानामृगसहस्रैश्च पक्षिभिश्च समावृतम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2118567, "chapter_id": 3550, "verse_number": "२२", "content_sanskrit": "मानार्हं तच्च सर्वेषां देवदानवरक्षसाम् ।\nआलयं पन्नगेन्द्रस्य तक्षकस्य महात्मनः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2118568, "chapter_id": 3550, "verse_number": "२३", "content_sanskrit": "वेणुशाल्मलिमाल्वङ्गैरुपेतं वेत्रसंवृतम् ।\nशाकपद्मकतालैश्च शतशाखैश्च रौहिणैः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2118569, "chapter_id": 3550, "verse_number": "२४", "content_sanskrit": "निरुद्देशसमप्रख्यमावृतं गजसंस्थितैः ।\nगुल्मैः कीचकवेणूनामाशीविषनिषेवितम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2118570, "chapter_id": 3550, "verse_number": "२५", "content_sanskrit": "विहङ्गौघमहाभासं प्रतानं द्रुमसङ्कटम् ।\nस्नुनिवेत्रकुळिङ्गाक्षैर्हिन्तालैश्च समावृतम् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2118571, "chapter_id": 3550, "verse_number": "२६", "content_sanskrit": "व्यालदंष्ट्रिगणाकीर्णं वर्जितं सर्वमानुषैः ।\nरक्षसां भुजगेन्द्राणां पक्षिणां च महालयम् \t॥ २६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2118572, "chapter_id": 3550, "verse_number": "२७", "content_sanskrit": "देवेशः सर्वभूतेशः सर्वलोकविभागवित् ।\nपीताम्बरधरो देवस्तद्वनं बहुधा चरन् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2118573, "chapter_id": 3550, "verse_number": "२८", "content_sanskrit": "सद्रुमस्य सयक्षस्य सभूतगणपक्षिणः ।\nखाण्डवस्य विनाशं तं ददर्श मधुसूदनः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2118574, "chapter_id": 3550, "verse_number": "२२९", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nएकोनत्रिंशत्यधिकद्विशततमोऽध्यायः ॥२२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2118575, "chapter_id": 3550, "verse_number": "१", "content_sanskrit": "॥ इति खाण्डवदाहपर्वणि प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2118576, "chapter_id": 3550, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]