[
  {
    "id": 16792001,
    "chapter_id": 6192,
    "verse_number": "2.1",
    "content_sanskrit": "वैतथ्यं सर्वभावानां स्वप्न आहुर्मनीषिणः ।\nअन्तःस्थानात्तु भावानां संवृतत्वेन हेतुना ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "base_unit_id": "MK_C02_K01"
  },
  {
    "id": 16792002,
    "chapter_id": 6192,
    "verse_number": "2.2",
    "content_sanskrit": "अदीर्घत्वाच्च कालस्य गत्वा देहान्न पश्यति ।\nप्रतिबुद्धश्च वै सर्वस्तस्मिन्देशे न विद्यते ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "base_unit_id": "MK_C02_K02"
  },
  {
    "id": 16792003,
    "chapter_id": 6192,
    "verse_number": "2.3",
    "content_sanskrit": "अभावश्च रथादीनां श्रूयते न्यायपूर्वकम् ।\nवैतथ्यं तेन वै प्राप्तं स्वप्न आहुः प्रकाशितम् ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "base_unit_id": "MK_C02_K03"
  },
  {
    "id": 16792004,
    "chapter_id": 6192,
    "verse_number": "2.4",
    "content_sanskrit": "अन्तःस्थानात्तु भेदानां तस्माज्जागरिते स्मृतम् ।\nयथा तत्र तथा स्वप्ने संवृतत्वेन भिद्यते ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "base_unit_id": "MK_C02_K04"
  },
  {
    "id": 16792005,
    "chapter_id": 6192,
    "verse_number": "2.5",
    "content_sanskrit": "स्वप्नजागरिते स्थाने ह्येकमाहुर्मनीषिणः ।\nभेदानां हि समत्वेन प्रसिद्धेनैव हेतुना ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "base_unit_id": "MK_C02_K05"
  },
  {
    "id": 16792006,
    "chapter_id": 6192,
    "verse_number": "2.6",
    "content_sanskrit": "आदावन्ते च यन्नास्ति वर्तमानेऽपि तत्तथा ।\nवितथैः सदृशाः सन्तोऽवितथा इव लक्षिताः ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "base_unit_id": "MK_C02_K06"
  },
  {
    "id": 16792007,
    "chapter_id": 6192,
    "verse_number": "2.7",
    "content_sanskrit": "सप्रयोजनता तेषां स्वप्ने विप्रतिपद्यते ।\nतस्मादाद्यन्तवत्त्वेन मिथ्यैव खलु ते स्मृताः ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "base_unit_id": "MK_C02_K07"
  },
  {
    "id": 16792008,
    "chapter_id": 6192,
    "verse_number": "2.8",
    "content_sanskrit": "अपूर्वं स्थानिधर्मो हि यथा स्वर्गनिवासिनाम् ।\nतानयं प्रेक्षते गत्वा यथैवेह सुशिक्षितः ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "base_unit_id": "MK_C02_K08"
  },
  {
    "id": 16792009,
    "chapter_id": 6192,
    "verse_number": "2.9",
    "content_sanskrit": "स्वप्नवृत्तावपि त्वन्तश्चेतसा कल्पितं त्वसत् ।\nबहिश्चेतो गृहीतं सद्दृष्टं वैतथ्यमेतयोः ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "base_unit_id": "MK_C02_K09"
  },
  {
    "id": 16792010,
    "chapter_id": 6192,
    "verse_number": "2.10",
    "content_sanskrit": "जाग्रद्वृत्तावपि त्वन्तश्चेतसा कल्पितं त्वसत् ।\nबहिश्चेतोगृहीतं सद्युक्तं वैतथ्यमेतयोः ॥ १० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "base_unit_id": "MK_C02_K10"
  },
  {
    "id": 16792011,
    "chapter_id": 6192,
    "verse_number": "2.11",
    "content_sanskrit": "उभयोरपि वैतथ्यं भेदानां स्थानयोर्यदि ।\nक एतान्बुध्यते भेदान्को वै तेषां विकल्पकः ॥ ११ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "base_unit_id": "MK_C02_K11"
  },
  {
    "id": 16792012,
    "chapter_id": 6192,
    "verse_number": "2.12",
    "content_sanskrit": "कल्पयत्यात्मनात्मानमात्मा देवः स्वमायया ।\nस एव बुध्यते भेदानिति वेदान्तनिश्चयः ॥ १२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "base_unit_id": "MK_C02_K12"
  },
  {
    "id": 16792013,
    "chapter_id": 6192,
    "verse_number": "2.13",
    "content_sanskrit": "विकरोत्यपरान्भावानन्तश्चित्ते व्यवस्थितान् ।\nनियतांश्च बहिश्चित्त एवं कल्पयते प्रभुः ॥ १३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "base_unit_id": "MK_C02_K13"
  },
  {
    "id": 16792014,
    "chapter_id": 6192,
    "verse_number": "2.14",
    "content_sanskrit": "चित्तकाला हि येऽन्तस्तु द्वयकालाश्च ये बहिः ।\nकल्पिता एव ते सर्वे विशेषो नान्यहेतुकः ॥ १४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "base_unit_id": "MK_C02_K14"
  },
  {
    "id": 16792015,
    "chapter_id": 6192,
    "verse_number": "2.15",
    "content_sanskrit": "अव्यक्ता एव येऽन्तस्तु स्फुटा एव च ये बहिः ।\nकल्पिता एव ते सर्वे विशेषस्त्विन्द्रियान्तरे ॥ १५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "base_unit_id": "MK_C02_K15"
  },
  {
    "id": 16792016,
    "chapter_id": 6192,
    "verse_number": "2.16",
    "content_sanskrit": "जीवं कल्पयते पूर्वं ततो भावान्पृथग्विधान् ।\nबाह्यानाध्यात्मिकांश्चैव यथाविद्यस्तथास्मृतिः ॥ १६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "base_unit_id": "MK_C02_K16"
  },
  {
    "id": 16792017,
    "chapter_id": 6192,
    "verse_number": "2.17",
    "content_sanskrit": "अनिश्चिता यथा रज्जुरन्धकारे विकल्पिता ।\nसर्पधारादिभिर्भावैस्तद्वदात्मा विकल्पितः ॥ १७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "base_unit_id": "MK_C02_K17"
  },
  {
    "id": 16792018,
    "chapter_id": 6192,
    "verse_number": "2.18",
    "content_sanskrit": "निश्चितायां यथा रज्ज्वां विकल्पो विनिवर्तते ।\nरज्जुरेवेति चाद्वैतं तद्वदात्मविनिश्चयः ॥ १८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "base_unit_id": "MK_C02_K18"
  },
  {
    "id": 16792019,
    "chapter_id": 6192,
    "verse_number": "2.19",
    "content_sanskrit": "प्राणादिभिरनन्तैस्तु भावैरेतैर्विकल्पितः ।\nमायैषा तस्य देवस्य ययायं मोहितः स्वयम् ॥ १९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "base_unit_id": "MK_C02_K19"
  },
  {
    "id": 16792020,
    "chapter_id": 6192,
    "verse_number": "2.20",
    "content_sanskrit": "प्राण इति प्राणविदो भूतानीति च तद्विदः ।\nगुणा इति गुणविदस्तत्त्वानीति च तद्विदः ॥ २० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "base_unit_id": "MK_C02_K20"
  },
  {
    "id": 16792021,
    "chapter_id": 6192,
    "verse_number": "2.21",
    "content_sanskrit": "पादा इति पादविदो विषया इति तद्विदः ।\nलोका इति लोकविदो देवा इति च तद्विदः ॥ २१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "base_unit_id": "MK_C02_K21"
  },
  {
    "id": 16792022,
    "chapter_id": 6192,
    "verse_number": "2.22",
    "content_sanskrit": "वेदा इति वेदविदो यज्ञा इति च तद्विदः ।\nभोक्तेति च भोक्तृविदो भोज्यमिति च तद्विदः ॥ २२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "base_unit_id": "MK_C02_K22"
  },
  {
    "id": 16792023,
    "chapter_id": 6192,
    "verse_number": "2.23",
    "content_sanskrit": "सूक्ष्म इति सूक्ष्मविदः स्थूल इति च तद्विदः ।\nमूर्त इति मूर्तविदोऽमूर्त इति च तद्विदः ॥ २३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "base_unit_id": "MK_C02_K23"
  },
  {
    "id": 16792024,
    "chapter_id": 6192,
    "verse_number": "2.24",
    "content_sanskrit": "काल इति कालविदो दिश इति च तद्विदः ।\nवादा इति वादविदो भुवनानीति तद्विदः ॥ २४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "base_unit_id": "MK_C02_K24"
  },
  {
    "id": 16792025,
    "chapter_id": 6192,
    "verse_number": "2.25",
    "content_sanskrit": "मन इति मनोविदो बुद्धिरिति च तद्विदः ।\nचित्तमिति चित्तविदो धर्माधर्मौ च तद्विदः ॥ २५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "base_unit_id": "MK_C02_K25"
  },
  {
    "id": 16792026,
    "chapter_id": 6192,
    "verse_number": "2.26",
    "content_sanskrit": "पञ्चविंशक इत्येके षड्विंश इति चापरे ।\nएकत्रिंशक इत्याहुरनन्त इति चापरे ॥ २६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "base_unit_id": "MK_C02_K26"
  },
  {
    "id": 16792027,
    "chapter_id": 6192,
    "verse_number": "2.27",
    "content_sanskrit": "लोकांल्लोकविदः प्राहुराश्रमा इति तद्विदः ।\nस्त्रीपुंनपुंसकं लैङ्गाः परापरमथापरे ॥ २७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "base_unit_id": "MK_C02_K27"
  },
  {
    "id": 16792028,
    "chapter_id": 6192,
    "verse_number": "2.28",
    "content_sanskrit": "सृष्टिरिति सृष्टिविदो लय इति च तद्विदः ।\nस्थितिरिति स्थितिविदः सर्वे चेह तु सर्वदा ॥ २८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "base_unit_id": "MK_C02_K28"
  },
  {
    "id": 16792029,
    "chapter_id": 6192,
    "verse_number": "2.29",
    "content_sanskrit": "यं भावं दर्शयेद्यस्य तं भावं स तु पश्यति ।\nतं चावति स भूत्वासौ तद्ग्रहः समुपैति तम् ॥ २९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "base_unit_id": "MK_C02_K29"
  },
  {
    "id": 16792030,
    "chapter_id": 6192,
    "verse_number": "2.30",
    "content_sanskrit": "एतैरेषोऽपृथग्भावैः पृथगेवेति लक्षितः ।\nएवं यो वेद तत्त्वेन कल्पयेत्सोऽविशङ्कितः ॥ ३० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "base_unit_id": "MK_C02_K30"
  },
  {
    "id": 16792031,
    "chapter_id": 6192,
    "verse_number": "2.31",
    "content_sanskrit": "स्वप्नमाये यथा दृष्टे गन्धर्वनगरं यथा ।\nतथा विश्वमिदं दृष्टं वेदान्तेषु विचक्षणैः ॥ ३१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "base_unit_id": "MK_C02_K31"
  },
  {
    "id": 16792032,
    "chapter_id": 6192,
    "verse_number": "2.32",
    "content_sanskrit": "न निरोधो न चोत्पत्तिर्न बद्धो न च साधकः ।\nन मुमुक्षुर्न वै मुक्त इत्येषा परमार्थता ॥ ३२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "base_unit_id": "MK_C02_K32"
  },
  {
    "id": 16792033,
    "chapter_id": 6192,
    "verse_number": "2.33",
    "content_sanskrit": "भावैरसद्भिरेवायमद्वयेन च कल्पितः ।\nभावा अप्यद्वयेनैव तस्मादद्वयता शिवा ॥ ३३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "base_unit_id": "MK_C02_K33"
  },
  {
    "id": 16792034,
    "chapter_id": 6192,
    "verse_number": "2.34",
    "content_sanskrit": "नात्मभावेन नानेदं न स्वेनापि कथञ्चन ।\nन पृथङ् नापृथक्किञ्चिदिति तत्त्वविदो विदुः ॥ ३४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "base_unit_id": "MK_C02_K34"
  },
  {
    "id": 16792035,
    "chapter_id": 6192,
    "verse_number": "2.35",
    "content_sanskrit": "वीतरागभयक्रोधैर्मुनिभिर्वेदपारगैः ।\nनिर्विकल्पो ह्ययं दृष्टः प्रपञ्चोपशमोऽद्वयः ॥ ३५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "base_unit_id": "MK_C02_K35"
