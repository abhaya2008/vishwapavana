[{"id": 7002944000, "chapter_id": 22944, "verse_number": "१-२१-१", "content_sanskrit": "सौतिरुवाच ।\nबभूव काले बालश्च क्रमेण पञ्चहायनः ।\nजातिस्मरो ज्ञानयुक्तः पूर्वमन्त्रस्मृतः सदा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002944001, "chapter_id": 22944, "verse_number": "१-२१-२", "content_sanskrit": "गीयते सततं कृष्णयशोनामगुणादिकम् ।\nक्षणं रोदिति नृत्येन पुलकाञ्चितविग्रहः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002944002, "chapter_id": 22944, "verse_number": "१-२१-३", "content_sanskrit": "कृष्णसम्बन्धिनीं गाथां शृणोति यत्र तत्र वै ।\nतत्सम्बन्धि पुराणं च तत्र तिष्ठति बालकः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002944003, "chapter_id": 22944, "verse_number": "१-२१-४", "content_sanskrit": "धूलिधूसरसर्वाङ्गो धूलिनैवेद्यमीप्सितम् ।\nधूलिषु प्रतिमां कृत्वा धूलिना पूजयेद्धरिम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002944004, "chapter_id": 22944, "verse_number": "१-२१-५", "content_sanskrit": "पुत्रमाह्वयते माता प्रातराशाय चेन्मुने ।\nहरिं संपूजयामीति मातरं संवदेत्पुनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002944005, "chapter_id": 22944, "verse_number": "१-२१-६", "content_sanskrit": "शौनक उवाच ।\nकिं नाम बालकस्यास्य जन्मन्यत्र बभूव ह ।\nव्युत्पत्त्या संज्ञया वाऽपि तद्भवान्वक्तुमर्हति ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002944006, "chapter_id": 22944, "verse_number": "१-२१-७", "content_sanskrit": "सौतिरुवाच ।\nअनावृष्ट्यवशेषे च काले बालो बभूव ह ।\nनारं ददौ जन्मकाले तेनायं नारदाभिधः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002944007, "chapter_id": 22944, "verse_number": "१-२१-८", "content_sanskrit": "ददाति नारं ज्ञानं च बालकेभ्यश्च बालकः ।\nजातिस्मरो महाज्ञानी तेनायं नारदाभिधः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002944008, "chapter_id": 22944, "verse_number": "१-२१-९", "content_sanskrit": "वीर्येण नारदस्यैव बभूव बालको मुने ।\nमुनीन्द्रस्य वरेणैव तेनायं नारदाभिधः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002944009, "chapter_id": 22944, "verse_number": "१-२१-१०", "content_sanskrit": "शौनक उवाच ।\nशिशुनाम च विज्ञातं व्युत्पत्त्या च यथोचितम् ।\nमुनीन्द्रस्य कथं नाम नारदश्चेति मंगलम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002944010, "chapter_id": 22944, "verse_number": "१-२१-११", "content_sanskrit": "सौतिरुवाच ।\nअपुत्रकाय विप्राय धर्मपुत्रो नरो मुनिः ।\nददौ पुत्र कश्यपाय तेनायं नारदाभिधः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002944011, "chapter_id": 22944, "verse_number": "१-२१-१२", "content_sanskrit": "शौनक उवाच ।\nअधुना नामव्युत्पत्तिः श्रुता सौते शिशोरपि ।\nशूद्रयोनौ ब्रह्मपुत्रः कथं स नारदाभिधः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002944012, "chapter_id": 22944, "verse_number": "१-२१-१३", "content_sanskrit": "सौतिरुवाच ।\nकल्पान्तरे ब्रह्मकण्ठाद्बभूवुर्बहवो नराः ।\nनरान्ददौ तत्कण्ठं च तेन तन्नारदं स्मृतम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002944013, "chapter_id": 22944, "verse_number": "१-२१-१४", "content_sanskrit": "ततो बभूव बालश्च नारदात्कण्ठदेशतः ।\nअतो ब्रह्मा नाम चक्रे नारदश्चेति मङ्गलम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002944014, "chapter_id": 22944, "verse_number": "१-२१-१५", "content_sanskrit": "साम्प्रतं शिशुवृत्तान्तं सावधानं निशामय ।\nउपालम्भरहस्येन विशिष्टं किं प्रयोजनम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002944015, "chapter_id": 22944, "verse_number": "१-२१-१६", "content_sanskrit": "ववृधे गोपिकाबालो विप्रगेहे दिनेदिने ।\nसपुत्रां पालितां चक्रे ब्राह्मणः स्वसुतां यथा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002944016, "chapter_id": 22944, "verse_number": "१-२१-१७", "content_sanskrit": "एतस्मिन्नन्तरे विप्रा आययुर्विप्रमन्दिरम् ।\nशिशवः पञ्चवर्षीया महातेजस्विनो यथा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002944017, "chapter_id": 22944, "verse_number": "१-२१-१८", "content_sanskrit": "प्रच्छन्नं हृतवन्तश्च ग्रीष्ममध्याह्नभास्करम् ।\nमधुपर्कादिकं दत्त्वा तान्ननाम गृही द्विज ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002944018, "chapter_id": 22944, "verse_number": "१-२१-१९", "content_sanskrit": "फलमूलादिकं काले चत्वारो मुनिपुङ्गवाः ।\nविप्रदत्तं बुभुजिरे तच्छेशं बुभुजे शिशुः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002944019, "chapter_id": 22944, "verse_number": "१-२१-२०", "content_sanskrit": "चतुर्थको मुनिस्तस्मै कृष्णमन्त्रं ददौ मुदा ।\nतेषां बभूव दासः स द्विजस्य मातुराज्ञया ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002944020, "chapter_id": 22944, "verse_number": "१-२१-२१", "content_sanskrit": "एकदा शिशुमाता च गच्छन्ती निशि वर्त्मनि ।\nममार सर्पदष्टा च तत्क्षणं स्मरती हरिम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002944021, "chapter_id": 22944, "verse_number": "१-२१-२२", "content_sanskrit": "सद्यो जगाम वैकुण्ठं विष्णुयानेन सा सती ।\nविष्णुपार्षदसंयुक्ता सद्रत्ननिर्मितेन च ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002944022, "chapter_id": 22944, "verse_number": "१-२१-२३", "content_sanskrit": "प्रातर्बालो द्विजैः सार्धं प्रययौ विप्रमन्दिरात् ।\nतत्त्वज्ञानं ददुस्तस्मै ब्राह्मणाश्च कृपालवः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002944023, "chapter_id": 22944, "verse_number": "१-२१-२४", "content_sanskrit": "ब्रह्मपुत्राः शिशुं त्यक्त्वा स्वस्थानं प्रययुः किल ।\nमहाज्ञानी शिशुस्तस्थौ गङ्गातीरे मनोहरे ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002944024, "chapter_id": 22944, "verse_number": "१-२१-२५", "content_sanskrit": "तत्र स्नात्वा विप्रदत्तं विष्णुमन्त्रं जजाप सः ।\nक्षुत्पिपासारोगशोकहरं वेदेषु दुर्लभम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002944025, "chapter_id": 22944, "verse_number": "१-२१-२६", "content_sanskrit": "महारण्ये च घोरे च अश्वत्थमूलसन्निधौ ।\nकृत्वा योगासनं तस्थौ सुचिरं तत्र बालकः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002944026, "chapter_id": 22944, "verse_number": "१-२१-२७", "content_sanskrit": "शौनक उवाच ।\nकं मन्त्रं बालकः प्राप कुमारेण च धीमता ।\nदत्तं परं श्रींहरेश्च तद्भवान्वक्तु मर्हति ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002944027, "chapter_id": 22944, "verse_number": "१-२१-२८", "content_sanskrit": "सौतिरुवाच ।\nकृष्णेन दत्तो गोलोके कृपया ब्रह्मणे पुरा ।\nद्वाविंशत्यक्षरो मन्त्रो वेदेषु च सुदुर्लभः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002944028, "chapter_id": 22944, "verse_number": "१-२१-२९", "content_sanskrit": "तं च ब्रह्मा ददौ भक्त्या कुमाराय च धीमते ।\nकुमारेण स दत्तश्च मन्त्रश्च शिशवे द्विज ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002944029, "chapter_id": 22944, "verse_number": "१-२१-३०", "content_sanskrit": "ॐ श्रीं नमो भगवते रास मण्डलेश्वराय ।\nश्रीकृष्णाय स्वाहेति च मन्त्रोऽयं कल्पपादपः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002944030, "chapter_id": 22944, "verse_number": "१-२१-३१", "content_sanskrit": "महापुरुषस्तोत्रं च पूर्वोक्तं कवचं च यत् ।\nअस्यौपयौगिकं ध्यानं सामवेदोक्तमेव च ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002944031, "chapter_id": 22944, "verse_number": "१-२१-३२", "content_sanskrit": "तेजोमण्डलरूपे च सूर्य्यकोटिसमप्रभे ।\nयोगिभिर्वाञ्छितं ध्याने योगैः सिद्धगणैः सुरैः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002944032, "chapter_id": 22944, "verse_number": "१-२१-३३", "content_sanskrit": "ध्यायन्ते वैष्णवा रूपं तदभ्यन्तरसन्निधौ ।\nअतीव कमनीयानिर्वचनीयं मनोहरम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002944033, "chapter_id": 22944, "verse_number": "१-२१-३४", "content_sanskrit": "नवीनजलदश्यामं शरत्पङ्कजलोचनम् ।\nशरत्पार्वणचन्द्रास्यं पक्वबिम्बाधिकाधरम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002944034, "chapter_id": 22944, "verse_number": "१-२१-३५", "content_sanskrit": "मुक्तापङ्क्तिविनिन्दैकदन्तपंक्तिमनोहरम् ।\nसस्मितं मुरलीन्यस्तहस्तावलम्बनेन च ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002944035, "chapter_id": 22944, "verse_number": "१-२१-३६", "content_sanskrit": "कोटिकन्दर्पलावण्यं लीलाधाम मनोहरम् ।\nचन्द्रलक्षप्रभाजुष्टं पुष्टश्रीयुक्तविग्रहम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002944036, "chapter_id": 22944, "verse_number": "१-२१-३७", "content_sanskrit": "त्रिभङ्गसङ्गि वा युक्तं द्विभुजं पीतवाससम् ।\nरत्नकेयूरवलयरत्ननूपुरभूषि तम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002944037, "chapter_id": 22944, "verse_number": "१-२१-३८", "content_sanskrit": "रत्नकुण्डलयुग्मेन गण्डस्थलविराजितम् ।\nमयूरपुच्छचूडं च रत्नमालाविभूषितम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002944038, "chapter_id": 22944, "verse_number": "१-२१-३९", "content_sanskrit": "शोभितं जानुपर्य्यन्तं मालतीवनमालया ।\nचन्दनोक्षितसर्वाङ्गं भक्तानुग्रहकारकम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002944039, "chapter_id": 22944, "verse_number": "१-२१-४०", "content_sanskrit": "मणिना कौस्तुभेन्द्रेण वक्षस्थलसमुज्ज्वलम् ।\nवीक्षितं गोपिकाभिश्च शश्वद्व्रीडितलोचनैः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002944040, "chapter_id": 22944, "verse_number": "१-२१-४१", "content_sanskrit": "स्थिरयौवनयुक्ताभिर्वेष्टिताभिश्च सन्ततम् ।\nभूषणैर्भूषिताभिश्च राधावक्षःस्थलस्थितम्॥ ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002944041, "chapter_id": 22944, "verse_number": "१-२१-४२", "content_sanskrit": "ब्रह्मविष्णुशिवाद्यैश्च पूजितं वन्दितं स्तुतम् ।\nकिशोरं राधिकाकान्तं शान्तरूपं परात्परम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002944042, "chapter_id": 22944, "verse_number": "१-२१-४३", "content_sanskrit": "निर्लिप्तं साक्षिरूपं  च निर्गुणं प्रकृतेः परम् ।\nध्यायेत्सर्वेश्वरं तं च परमात्मानमीश्वरम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002944043, "chapter_id": 22944, "verse_number": "१-२१-४४", "content_sanskrit": "इदं ते कथितं ध्यानं स्तोत्रं च कवचं मुने ।\nमन्त्रोपयौगिकं सत्यं मन्त्रश्च कल्पपादपः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002944044, "chapter_id": 22944, "verse_number": "१-२१-४५", "content_sanskrit": "साम्प्रतं बालकस्तस्थौ ध्यानस्थस्तत्र शौनक ।\nदिव्यं वर्षसहस्रं च निराहारः कृशोदरः॥ ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002944045, "chapter_id": 22944, "verse_number": "१-२१-४६", "content_sanskrit": "शक्तिमान्परिपुष्टश्च सिद्धमन्त्रप्रभावत ।\nददर्श बालको ध्याने दिव्यं लोकं च बालकम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002944046, "chapter_id": 22944, "verse_number": "१-२१-४७", "content_sanskrit": "रत्नसिंहासनस्थं च रत्नभूषणभूषितम् ।\nकिशोरवयसं श्यामं गोपवेषं च सस्मितम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002944047, "chapter_id": 22944, "verse_number": "१-२१-४८", "content_sanskrit": "गोपैर्गोपाङ्गनाभिश्च वेष्टितं पीतवाससम् ।\nद्विभुजं मुरलीहस्तं चन्दनेन विचर्चितम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002944048, "chapter_id": 22944, "verse_number": "१-२१-४९", "content_sanskrit": "ब्रह्मविष्णुशिवाद्यैश्च स्तूयमानं परात्परम् ।\nदृष्ट्वा च सुचिरं शान्तं शान्तश्च गोपिकासुतः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002944049, "chapter_id": 22944, "verse_number": "१-२१-५०", "content_sanskrit": "विरराम च शोकार्तो यदा तद्द्रष्टुमक्षमः ।\nरुरोदाश्वत्थमूले च न दृष्ट्वा बालकं शिशुः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002944050, "chapter_id": 22944, "verse_number": "१-२१-५१", "content_sanskrit": "बभूवाकाशवाणीति रुदन्तं बालकं प्रति ।\nसत्यं प्रबोधयुक्तं च हितमेव मिताक्षरम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002944051, "chapter_id": 22944, "verse_number": "१-२१-५२", "content_sanskrit": "सकृद्यद्दर्शितं रूपं तदेव नाधुना पुनः ।\nअपि पक्वकषायाणां दुर्दर्शं च कुयोगिनाम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002944052, "chapter_id": 22944, "verse_number": "१-२१-५३", "content_sanskrit": "एतस्मिन्विग्रहेऽतीते संप्राप्ते दिव्यविग्रहे ।\nपुनर्द्रक्ष्यसि गोविन्दं जन्ममृत्युहरं हरिम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002944053, "chapter_id": 22944, "verse_number": "१-२१-५४", "content_sanskrit": "इति श्रुत्वा बालकश्च विरराम मुदाऽन्वितः ।\nकाले तत्याज तीर्थे च तनुं कृष्णं हृदि स्मरन् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002944054, "chapter_id": 22944, "verse_number": "१-२१-५५", "content_sanskrit": "नेदुर्दुन्दुभयः स्वर्गे पुष्पवृष्टिर्बभूव ह ।\nबभूव शापमुक्तश्च नारदश्च महामुनिः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002944055, "chapter_id": 22944, "verse_number": "१-२१-५६", "content_sanskrit": "तनुं त्वक्वा स जीवश्च विलीनो ब्रह्मविग्रहे ।\nबभूव प्राक्तनान्नित्यः कालभेदे तिरोहितः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002944056, "chapter_id": 22944, "verse_number": "१-२१-५७", "content_sanskrit": "आविर्भावस्तिरोभावः स्वेच्छया नित्यदेहिनाम् ।\nजन्ममृत्युजराव्याधिर्भक्तानां नास्ति शौनक ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]