[{"id": 2098835, "chapter_id": 3115, "verse_number": "१३-२४५-१", "content_sanskrit": "महेश्वर उवाच।\nसाङ्ख्यज्ञानं प्रवक्ष्यामि यथावत्ते शुचिस्मिते।\nयज्ज्ञात्वा न पुनर्मर्त्यः संसारेषु प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2098836, "chapter_id": 3115, "verse_number": "१३-२४५-२", "content_sanskrit": "ज्ञानेनैव विमुक्तास्ते साङ्ख्याः संन्यासकोविदाः।\nशरीरं तु तपो घोरं साङ्ख्याः प्राहुर्निरर्थकम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2098837, "chapter_id": 3115, "verse_number": "१३-२४५-३", "content_sanskrit": "पञ्चविंशतिकं ज्ञानं तेषां ज्ञानमिति स्मृतम्।\nमूलप्रकृतिरव्यक्तमव्यक्ताज्जायते महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2098838, "chapter_id": 3115, "verse_number": "१३-२४५-४", "content_sanskrit": "महतोऽभूदहङ्कारस्तस्मात्तन्मात्रपञ्चकम्।\nइन्द्रियाणि दशैकं च तन्मात्रेभ्यो भवन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2098839, "chapter_id": 3115, "verse_number": "१३-२४५-५", "content_sanskrit": "तेभ्यो भूतानि पञ्चास्य शरीरं यैः प्रवर्तते।\nइति क्षेत्रस्य संक्षेपं चतुर्विंशतिरिष्यते।\nपञ्चविंशतित्याहुः पुरुषेणेह सङ्ख्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2098840, "chapter_id": 3115, "verse_number": "१३-२४५-६", "content_sanskrit": "सत्वं रजस्तमश्चेति गुणाः प्रकृतिसम्भवाः।\nतैः सृजत्यखिलं लोकं प्रकृतिः स्वात्मकैर्गुणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2098841, "chapter_id": 3115, "verse_number": "१३-२४५-७", "content_sanskrit": "इच्छा द्वेषः सुखं दुःखं संघातश्चेतना धृतिः।\nविकाराः प्रकृतेश्चैते वेदितव्या मनीषिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2098842, "chapter_id": 3115, "verse_number": "१३-२४५-८", "content_sanskrit": "लक्षणं चापि सर्वेषां विकल्पं चादितः पृथक्।\nविस्तरेणैव वक्ष्यामि तस्य व्याख्यामहं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2098843, "chapter_id": 3115, "verse_number": "१३-२४५-९", "content_sanskrit": "नित्यमेकमणु व्यापि क्रियाहीनमहेतुकम्।\nअग्राह्यमिन्द्रियैः सर्वैरेतदव्यक्तलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2098844, "chapter_id": 3115, "verse_number": "१३-२४५-१०", "content_sanskrit": "अव्यक्तं प्रकृतिर्मूलं प्रधानं योनिरव्ययम्।\nअव्यक्तस्यैव नामानि शब्दैः पर्यायवाचकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2098845, "chapter_id": 3115, "verse_number": "१३-२४५-११", "content_sanskrit": "तत्सूक्ष्मत्वादनिर्देश्यं तत्सदित्यभिधीयते।\nतन्मूलं च जगत्सर्वं तन्मूला सृष्टिरिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2098846, "chapter_id": 3115, "verse_number": "१३-२४५-१२", "content_sanskrit": "सत्वादयः प्रकृतिजा गुणास्तान्प्रब्रवीम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2098847, "chapter_id": 3115, "verse_number": "१३-२४५-१३", "content_sanskrit": "सुखं तुष्टिः प्रकाशश्च त्रयस्ते सात्विका गुणाः।\nरागद्वेषौ सुखं दुःखं स्तम्भश्च रजसो गुणाः।\nअप्रकाशो भयं मोहस्तन्द्री च तमसो गुणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2098848, "chapter_id": 3115, "verse_number": "१३-२४५-१४", "content_sanskrit": "श्रद्धा प्रहर्षो विज्ञानमसंमोहो दया धृतिः।\nसत्वे प्रवृत्ते वर्धन्ते विपरीते विपर्ययः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2098849, "chapter_id": 3115, "verse_number": "१३-२४५-१५", "content_sanskrit": "कामक्रोधौ मनस्तापो लोभो मोहस्तथामृषा।\nप्रवृद्धे परिवर्धन्ते रजस्येतानि सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2098850, "chapter_id": 3115, "verse_number": "१३-२४५-१६", "content_sanskrit": "विषादः संशयो मोहस्तन्द्री निद्रा भयं तथा।\nतमस्येतानि वर्धन्ते प्रवृद्धे हेत्वहेतुकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2098851, "chapter_id": 3115, "verse_number": "१३-२४५-१७", "content_sanskrit": "एवमन्योन्यमेतानि वर्धन्ते च पुनःपुनः।\nहीयन्ते च तथा नित्यमभिभूतानि भूरिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2098852, "chapter_id": 3115, "verse_number": "१३-२४५-१८", "content_sanskrit": "तत्र यत्प्रीतिसंयुक्तं कायेन मनसाऽपि वा।\nवर्तते सात्विको भाव इत्युपेक्षेत तत्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2098853, "chapter_id": 3115, "verse_number": "१३-२४५-१९", "content_sanskrit": "यदा सन्तापसंयुक्तं चित्तक्षोभकरं भवेत्।\nवर्तते रज इत्येव तदा तदभिचिन्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2098854, "chapter_id": 3115, "verse_number": "१३-२४५-२०", "content_sanskrit": "यदा सम्मोहसंयुक्तं यद्विषादकरं भवेत्।\nअप्रतार्क्यमविज्ञेयं तमस्तदुपधारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2098855, "chapter_id": 3115, "verse_number": "१३-२४५-२१", "content_sanskrit": "समासात्सात्विको धर्मः समासाद्राजसं धनम्।\nसमासात्तामसः कामस्त्रिवर्गे त्रिगुणाः क्रमात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2098856, "chapter_id": 3115, "verse_number": "१३-२४५-२२", "content_sanskrit": "ब्रह्मादिदेवसृष्टिर्या सात्विकीति प्रकीर्त्यते।\nराजसी मानवी सृष्टिस्तिर्यग्योनिस्तु तामिसी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2098857, "chapter_id": 3115, "verse_number": "१३-२४५-२३", "content_sanskrit": "ऊर्ध्वं गच्छन्ति सत्वस्था मध्ये तिष्ठन्ति राजसाः।\nजघन्यगुणवृतच्तिस्था अधो गच्छन्ति तामसाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2098858, "chapter_id": 3115, "verse_number": "१३-२४५-२४", "content_sanskrit": "देवमानुषतिर्यक्षु यद्भूतं सचराचरम्।\nआदिप्रभृति संयुक्तं व्याप्तमेभिस्त्रिभिर्गुणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2098859, "chapter_id": 3115, "verse_number": "१३-२४५-२५", "content_sanskrit": "अतः परं प्रवक्ष्यामि महदादीनि लिङ्गतः।\nविज्ञानं च विवेकश्च महतो लक्षणं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2098860, "chapter_id": 3115, "verse_number": "१३-२४५-२६", "content_sanskrit": "महान्बुद्धिर्मतिः प्रज्ञा नामानि महतो विदुः।\nअहङ्कारः स विज्ञेयो लक्षणेन समासतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2098861, "chapter_id": 3115, "verse_number": "१३-२४५-२७", "content_sanskrit": "अहङ्कारेण भूतानां सर्गो नानाविधो भवेत्।\nअहङ्कारनिवृत्तिर्हि निर्वाणायोपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2098862, "chapter_id": 3115, "verse_number": "१३-२४५-२८", "content_sanskrit": "खं वायुरग्निः सलिलं पृथिवी चेति पञ्चमी।\nमहाभूतानि भूतानां सर्वेषां प्रभवाप्ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2098863, "chapter_id": 3115, "verse_number": "१३-२४५-२९", "content_sanskrit": "शब्दः श्रोत्रं तथा खानि त्रयमाकाशसम्भवम्।\nस्पर्शवत्प्राणिनां चेष्टा पवनस्य गुणाः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2098864, "chapter_id": 3115, "verse_number": "१३-२४५-३०", "content_sanskrit": "रूपं पाकोक्षिणी ज्योतिश्चत्वारस्तेजसो गुणाः।\nरसः स्नेहस्तथा जिह्वा शैत्यं च जलजा गुणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2098865, "chapter_id": 3115, "verse_number": "१३-२४५-३१", "content_sanskrit": "गन्धो घ्राणं शरीरं च पृथिव्यास्ते गुणास्त्रयः।\nइति सर्वगुणा देवि विख्याताः पाञ्चभौतिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2098866, "chapter_id": 3115, "verse_number": "१३-२४५-३२", "content_sanskrit": "गुणान्पूर्वस्यपूर्वस्य प्राप्नुवन्त्युत्तराणि तु।\nतस्मान्नैकगुणाश्चेह दृश्यन्ते बूतसृष्टयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2098867, "chapter_id": 3115, "verse_number": "१३-२४५-३३", "content_sanskrit": "उपलभ्याप्सु ये गन्धं केचिद्ब्रूयुरनैपुणाः।\nअपां गन्धगुणं प्राज्ञा नेच्छन्ति कमलेक्षणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2098868, "chapter_id": 3115, "verse_number": "१३-२४५-३४", "content_sanskrit": "तद्गन्धत्वमपां नास्ति पृथिव्या एव तद्गुणः।\nभूमिर्गन्धे रसे स्नेहो ज्योतिश्चक्षुषि संस्थितम्।\nप्राणापानाश्रयोः वायुः खेष्वाकाशः शरीरिणां", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2098869, "chapter_id": 3115, "verse_number": "१३-२४५-३५", "content_sanskrit": "केशास्थिनखदन्तत्वक्पाणिपादशिरांसि च।\nपृष्ठोदरकटिग्रीवाः सर्वं भूम्यात्मकं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2098870, "chapter_id": 3115, "verse_number": "१३-२४५-३६", "content_sanskrit": "यत्किञ्चिदपि कायेऽस्मिन्धातुदोषमलाश्रितम्।\nतत्सर्वं भौतिकं विद्धि देहैरेवास्य स्वामिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2098871, "chapter_id": 3115, "verse_number": "१३-२४५-३७", "content_sanskrit": "बुद्धीन्द्रियाणि कर्णत्वक्चक्षुर्जिह्वाऽथ नासिका।\nकर्मेन्द्रियाणि वाक्पाणिपादौ मेढ्रं गुदस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2098872, "chapter_id": 3115, "verse_number": "१३-२४५-३८", "content_sanskrit": "शब्दः स्पर्शश्च रूपं च रसो गन्धश्च पञ्चमः।\nबुद्धीन्द्रियार्थाञ्जानीयाद्भूतेभ्यस्त्वभिनिःसृतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2098873, "chapter_id": 3115, "verse_number": "१३-२४५-३९", "content_sanskrit": "वाक्यं क्रिया गतिः प्रीतिरुत्सर्गश्चेति पञ्चधा।\nकर्मेन्द्रियार्थाञ्जानीयात्ते च भूतोद्भवा मताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2098874, "chapter_id": 3115, "verse_number": "१३-२४५-४०", "content_sanskrit": "इन्द्रियाणां तु सर्वेषामीश्वरं मन उच्यते।\nप्रार्थनालक्षणं तच्च इन्द्रियं तु मनः स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2098875, "chapter_id": 3115, "verse_number": "१३-२४५-४१", "content_sanskrit": "नियुङ्क्ते च सदा तानि भूतानि मनसा सह।\nनियमे च विसर्गे च मनसः कारणं प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2098876, "chapter_id": 3115, "verse_number": "१३-२४५-४२", "content_sanskrit": "इन्द्रियाणीन्द्रियार्थाश्च स्वभावश्चेतना धृतिः।\nभूताभूतविकारश्च शरीरमिति संस्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2098877, "chapter_id": 3115, "verse_number": "१३-२४५-४३", "content_sanskrit": "शरीराच्च परो देही शरीरं च व्यपाश्रितः।\nशरीरिणः शरीरस्य सोऽन्तरं वेत्ति वै मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2098878, "chapter_id": 3115, "verse_number": "१३-२४५-४४", "content_sanskrit": "रसः स्पर्शस्च गन्धश्च रूपं शब्दविवर्जितम्।\nअशरीरं शरीरेषु दिदृक्षेत निरिन्द्रियम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2098879, "chapter_id": 3115, "verse_number": "१३-२४५-४५", "content_sanskrit": "अव्यक्तं सर्वदेहेषु मर्त्येष्वमरमाश्रितम्।\nयः पश्येत्परमात्मानं बन्धनैः स विमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2098880, "chapter_id": 3115, "verse_number": "१३-२४५-४६", "content_sanskrit": "नैवायं चक्षुषां ग्राह्यो नापरैरिन्द्रियैरपि।\nमनसैव प्रदीप्तेन महानात्मा प्रदृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2098881, "chapter_id": 3115, "verse_number": "१३-२४५-४७", "content_sanskrit": "स हि सर्वेषु भूतेषु स्थावरेषु चरेषु च।\nवसत्येको महावीर्यो नानाभावसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2098882, "chapter_id": 3115, "verse_number": "१३-२४५-४८", "content_sanskrit": "नैव चोर्ध्वं न तिर्यक्च नाधस्तान्न कदाचन।\nइन्द्रियैरिव बुद्ध्या वा न दृश्येत कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2098883, "chapter_id": 3115, "verse_number": "१३-२४५-४९", "content_sanskrit": "नवद्वारं पुरं गत्वा स्थितोऽसौ नियतो वशी।\nईश्वरः सर्वलोकेषु स्थावरस्य चरस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2098884, "chapter_id": 3115, "verse_number": "१३-२४५-५०", "content_sanskrit": "तमेवाहुरणुभ्योऽणुं तु महद्भ्यो महत्तरम्।\nबहुधा सर्वभूतानि व्याप्य तिष्ठति शाश्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2098885, "chapter_id": 3115, "verse_number": "१३-२४५-५१", "content_sanskrit": "क्षेत्रज्ञमेकतः कृत्वा सर्वं क्षेत्रमथैकतः।\nएवं स विमृशेज्ज्ञानी संयतः सततं हृदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2098886, "chapter_id": 3115, "verse_number": "१३-२४५-५२", "content_sanskrit": "पुरुषः प्रकृतिस्थो हि भुङ्क्ते प्रकृतिजान्गुणान्।\nअकर्ता लेपको नित्यो मध्यस्थः सर्वकर्मणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2098887, "chapter_id": 3115, "verse_number": "१३-२४५-५३", "content_sanskrit": "कार्यकारणकर्तृत्वे हेतुः प्रकृतिरुच्यते।\nपुरुषः सुखदुःखानां भोक्तृत्वे हेतुरुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2098888, "chapter_id": 3115, "verse_number": "१३-२४५-५४", "content_sanskrit": "अजय्योऽयमचिन्त्योऽयमव्यक्तोऽयं सनातनः।\nदेही तेजोमयो देहि तिष्ठतीत्यपरे विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2098889, "chapter_id": 3115, "verse_number": "१३-२४५-५५", "content_sanskrit": "ज्ञानमूष्मा च वायुश्च शरीरे जीवसंज्ञकः।\nइत्येते निश्चिता बुद्ध्या तत्रैते बुद्धिचिन्तकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2098890, "chapter_id": 3115, "verse_number": "१३-२४५-५६", "content_sanskrit": "अपरे सर्वलोकांश्च व्याप्य तिष्ठन्तमीश्वरम्।\nब्रुवते केचिदत्रैव तिलतैलवदास्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2098891, "chapter_id": 3115, "verse_number": "१३-२४५-५७", "content_sanskrit": "अपरे नास्तिका मूढा हीनत्वात्स्थूललक्षणैः।\nनास्त्यात्मेति विनिश्चित्याप्रज्ञास्ते निरयालयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2098892, "chapter_id": 3115, "verse_number": "१३-२४५-५८", "content_sanskrit": "एवं नानाविधा नैव विमृशन्ति महेश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2098893, "chapter_id": 3115, "verse_number": "१३-२४५-५९x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2098894, "chapter_id": 3115, "verse_number": "१३-२४५-५९", "content_sanskrit": "भगवन्ब्राह्मणो लोके नित्यमक्षरमव्ययम्।\nअस्त्यात्मा सर्वभूतेषु हेतुस्तत्र सुदुर्गमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2098895, "chapter_id": 3115, "verse_number": "१३-२४५-६०x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2098896, "chapter_id": 3115, "verse_number": "१३-२४५-६०", "content_sanskrit": "ऋषिभिश्चापि देवैश्च व्यक्तमेष न दृश्यते।\nदृष्ट्वा तु तं महात्मानं पुनस्तु न निवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2098897, "chapter_id": 3115, "verse_number": "१३-२४५-६१", "content_sanskrit": "तस्मात्तद्दर्शनादेव विन्दते परमां गतिम्।\nइति ते कथितो देवि साङ्ख्यधर्मः सनातनः।\nकपिलादिभिराचार्यैः सेवितः परमर्षिभिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2098898, "chapter_id": 3115, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि पञ्चचत्वारिंशदधिकद्विशततमोऽध्यायः॥ २४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]