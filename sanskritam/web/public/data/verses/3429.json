[{"id": 2112684, "chapter_id": 3429, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2112685, "chapter_id": 3429, "verse_number": "१", "content_sanskrit": "किं कृतं कर्म धर्मेण येन शापमुपेयिवान् ।\nकस्य शापाच्च धर्मस्तु शुद्रयोनावजायत \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2112686, "chapter_id": 3429, "verse_number": "", "content_sanskrit": "वैशम्पयानः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2112687, "chapter_id": 3429, "verse_number": "२", "content_sanskrit": "बभूव ब्राह्मणः कश्चिन्माण्डव्य इति विश्रुतः ।\nएकान्तचारी वन्यश्च सत्ये तपसि च ध्रुवः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2112688, "chapter_id": 3429, "verse_number": "३", "content_sanskrit": "स तीर्थयात्रां विचरन् जगाम च यदृच्छया\nसन्निकृष्टानि तीर्थानि ग्रामाणां यानि कानिचित्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2112689, "chapter_id": 3429, "verse_number": "४", "content_sanskrit": "तदाश्रमपदं कृत्वा वसति स्म महामुनिः ।\nस त्वाश्रमपदद्वारि वृक्षमूले महायशाः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2112690, "chapter_id": 3429, "verse_number": "५", "content_sanskrit": "ऊर्ध्वबाहुः स्थितो योगी मौनी व्रतसमन्वितः ।\nकेनचित्त्वथ कालेन तथा तपसि तिष्ठतः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2112691, "chapter_id": 3429, "verse_number": "६", "content_sanskrit": "तस्याश्रमपदं प्राप्ता दस्यवो लोप्त्रहारिणः ।\nअनुसार्यमाणास्ते चोरा रक्षिभिर्भरतर्षभ\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2112692, "chapter_id": 3429, "verse_number": "७", "content_sanskrit": "तामेव वसतिं जग्मुस्तद्ग्रामे लोप्त्रहरिणः ।\nतस्मिन् निवसथे लोप्त्रं निदधुर्भयमोहिताः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2112693, "chapter_id": 3429, "verse_number": "८", "content_sanskrit": "अभितस्तेऽत्र सँल्लीनान् बलमन्वगमच्च तान् ।\nततः शीघ्रतरं राजंस्तत्र राजबलं महत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2112694, "chapter_id": 3429, "verse_number": "९", "content_sanskrit": "यस्मिन्नावसथे शेते स मुनिः संशितव्रतः ।\nतत्राजग्मुस्ततोऽपश्यंस्तं मुनिं रक्षिणस्तु ते \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2112695, "chapter_id": 3429, "verse_number": "१०", "content_sanskrit": "तमपृच्छंस्तदा राजंस्तथावृत्तं तपोधनम् ।\nकतरेण पथा याता दस्यवो मुनिसत्तम \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2112696, "chapter_id": 3429, "verse_number": "११", "content_sanskrit": "तेन गच्छाम वै व्रह्मन् पथा शीघ्रतरं वयम् ।\nवचस्तद् रक्षिणां श्रुत्वा ब्रुवतां स तपोधनः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2112697, "chapter_id": 3429, "verse_number": "१२", "content_sanskrit": "न किञ्चिद् वचनं राजन् मुनिस्तान् प्रत्यभाषत ।\nततस्ते राजपुरुषा विचिन्वानास्तदाश्रमम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2112698, "chapter_id": 3429, "verse_number": "१३", "content_sanskrit": "ददृशुस्तत्र वै लीनांश्चोरांस्तद् द्रव्यमेव च ।\nततः शङ्का समभवद् रक्षिणां तं मुनिं प्रति\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2112699, "chapter_id": 3429, "verse_number": "१४", "content_sanskrit": "प्रसँह्य तं मुनिं राज्ञे चोरांश्चैवान्ववेदयन् ।\nतं राजा सह चोरैस्तैरवदच्छिद्यतामिति \t॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2112700, "chapter_id": 3429, "verse_number": "१५", "content_sanskrit": "स वध्यघातैराज्ञप्तः शूले प्रोतो महातपाः ।\nततस्ते शूलमारोप्य तं मुनिं रक्षिणस्तदा \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2112701, "chapter_id": 3429, "verse_number": "१६", "content_sanskrit": "प्रतिजग्मुर्महीपाल धनान्यादाय सर्वतः ।\nशूलस्थः स तु धर्मात्मा कालेन महता अपि\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2112702, "chapter_id": 3429, "verse_number": "१७", "content_sanskrit": "निराहारस्तदा राजन् मरणं नाभ्युपागमत् ।\nधारयामास वै प्राणान् ऋषींश्च समुपानयत् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2112703, "chapter_id": 3429, "verse_number": "१७", "content_sanskrit": "शूलाग्रे तप्यमानेन तदाऽनेन महात्मना ।\nसन्तापं परमं जग्मुर्ऋषयो भरतर्षभ \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2112704, "chapter_id": 3429, "verse_number": "१८", "content_sanskrit": "काचित् पतिव्रता तं तु भर्तृपादेन पीडितम् ।\nतयोश्च शपतो रात्रिरभूत् तं ब्राह्मणास्तदा \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2112705, "chapter_id": 3429, "verse_number": "१९", "content_sanskrit": "तां प्रसाद्य ततो देवीं शापमोक्षं च ते ददुः ।\nदुःखिता ऋषयस्तत्र आश्रमस्थाश्च तं तदा \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2112706, "chapter_id": 3429, "verse_number": "२०", "content_sanskrit": "ते रात्रौ शकुना भूत्वा तमार्तिं परमां गतम् ।\nदर्शयन्तो यथाशक्ति तमपृच्छन् द्विजोत्तमम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2112707, "chapter_id": 3429, "verse_number": "", "content_sanskrit": "ऋषयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2112708, "chapter_id": 3429, "verse_number": "२१", "content_sanskrit": "भगवन् केन दोषेण गन्ताऽसि द्विजसत्तम ।\nश्रोतुमिच्छामहे ब्रह्मन् किं पापं कृतवानसि \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2112709, "chapter_id": 3429, "verse_number": "२२", "content_sanskrit": "तत् ते द्विजवरश्रेष्ठ संशयस्तु महान् हि नः ।\nईदृशस्य नरश्रेष्ठ उग्रे तपसि वर्ततः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2112710, "chapter_id": 3429, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2112711, "chapter_id": 3429, "verse_number": "२३", "content_sanskrit": "तदोवाच महाप्रज्ञस्तानृषीन् संशितव्रतान् ।\nदोषतः कं गमिष्यामि न हि मेऽन्योऽपराध्यति \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2112712, "chapter_id": 3429, "verse_number": "२४", "content_sanskrit": "तच्छ्रुत्वा रक्षिणस्तत्र तथा बहुतिथेऽहनि ।\nन्यवेदयंस्ततो राज्ञे तथावृत्तं नराधिप \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2112713, "chapter_id": 3429, "verse_number": "२५", "content_sanskrit": "राजा च हि तथा श्रुत्वा निश्चित्य सह मन्त्रिभिः ।\nप्रसादयामास तदा शूलस्थमृषिसत्तमम् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2112714, "chapter_id": 3429, "verse_number": "", "content_sanskrit": "राजा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2112715, "chapter_id": 3429, "verse_number": "२४", "content_sanskrit": "यन्मयाऽपकृतं मोहादज्ञानाद् द्विजसत्तम ।\nप्रसादये त्वां विप्रेन्द्र न मे त्वं क्रोद्धुमर्हसि \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2112716, "chapter_id": 3429, "verse_number": "", "content_sanskrit": "वैशम्पायानः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2112717, "chapter_id": 3429, "verse_number": "२५", "content_sanskrit": "एवमुक्तस्तदा राज्ञा प्रसादमकरोत् तदा ।\nकृतप्रसादो राजा तं ततः समवतारयत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2112718, "chapter_id": 3429, "verse_number": "२६", "content_sanskrit": "अवतार्यमाणः शूलाग्रात् तच्छूलं च चकर्ष ह ।\nअशक्नुवन्तो निष्क्रष्टुं शूलं मूलेऽथ चिच्छिदुः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2112719, "chapter_id": 3429, "verse_number": "२७", "content_sanskrit": "स तदान्तर्गतेनैव शूलेन व्यचरन्मुनिः ।\nकण्ठपार्श्वान्तरस्थेन शङ्कुना मुनिराचरन्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2112720, "chapter_id": 3429, "verse_number": "२८", "content_sanskrit": "पुष्पभाजनधारी स्यादिति चिन्तापरोऽभवत् ।\nस चातितपसा लोकान् विजिग्ये दुर्लभान् परैः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2112721, "chapter_id": 3429, "verse_number": "२९", "content_sanskrit": "तमाहुराणिमाण्डव्यमिति धर्मे रतं मुनिम् ।\nस गत्वा सदनं विप्रो धर्मस्य परमार्थवित् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2112722, "chapter_id": 3429, "verse_number": "३०", "content_sanskrit": "आसनस्थं ततो धर्मं दृष्ट्वोपालभतानघ ।\nकिं नु दुष्टतरं कर्म मया कृतमजानता \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2112723, "chapter_id": 3429, "verse_number": "३१", "content_sanskrit": "यस्येयं फलनिर्वृत्तिरीदृश्यासादिता मया ।\nशीघ्रमाचक्ष्व मे तत्त्वं पश्य मे तपसो बलम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2112724, "chapter_id": 3429, "verse_number": "", "content_sanskrit": "धर्मराजः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2112725, "chapter_id": 3429, "verse_number": "३२", "content_sanskrit": "पतङ्गकानां पुच्छेषु त्वयेषीकाः प्रवेशिताः ।\nअहिंसकानां धर्मज्ञ तेनैतत् प्राप्तवानसि \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2112726, "chapter_id": 3429, "verse_number": "", "content_sanskrit": "आणिमाण्डव्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2112727, "chapter_id": 3429, "verse_number": "", "content_sanskrit": "कस्मिन् काले मया तत् तु कृतं ब्रूहि यथातथम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2112728, "chapter_id": 3429, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2112729, "chapter_id": 3429, "verse_number": "३३", "content_sanskrit": "तेनोक्तो धर्मराजस्तु बालभावे त्वया कृतम् \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2112730, "chapter_id": 3429, "verse_number": "", "content_sanskrit": "आणिमाण्डव्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2112731, "chapter_id": 3429, "verse_number": "३४", "content_sanskrit": "बालो हि द्वादशाद्वर्षाज्जन्मनो यत् करिष्यति ।\nन भविष्यत्यधर्मोऽद्य न प्रज्ञास्यति वैशसम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2112732, "chapter_id": 3429, "verse_number": "३५", "content_sanskrit": "गरीयान् ब्राह्मणवधः सर्वभूतवधादपि ।\nअल्पापराधे विपुलो मम दण्डस्त्वया धृतः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2112733, "chapter_id": 3429, "verse_number": "३६", "content_sanskrit": "शूद्रयोनावतो धर्म मानुषः सम्भविष्यसि ।\nमर्यादां स्थापयाम्यद्य लोके धर्मफलोदयाम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2112734, "chapter_id": 3429, "verse_number": "३७", "content_sanskrit": "आचतुर्दशमाद् वर्षान्न भविष्यति पातकम् ।\nपरेण कुर्वतामेव दोष एव भविष्यति \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2112735, "chapter_id": 3429, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2112736, "chapter_id": 3429, "verse_number": "३८", "content_sanskrit": "एतेन त्वपराधेन शापात् तस्य महात्मनः ।\nधर्मो विदुररूपेण शूद्रयोनावजायत\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2112737, "chapter_id": 3429, "verse_number": "३९", "content_sanskrit": "धर्मे चार्थे च कुशलो लोभक्रोधविवर्जितः ।\nदीर्घदर्शी शमपरः कुरूणां च हिते रतः \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2112738, "chapter_id": 3429, "verse_number": "१०८", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nअष्टाधिकशततमोऽध्यायः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2112739, "chapter_id": 3429, "verse_number": "५६", "content_sanskrit": "॥ इति सम्भवपर्वणि षट्पञ्चाशोऽध्यायः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2112740, "chapter_id": 3429, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]