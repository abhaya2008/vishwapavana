[{"id": 7001448000, "chapter_id": 21448, "verse_number": "७-१-२१-१", "content_sanskrit": "वायुरुवाच ।\nततस्त्रिदशमुख्यास्ते विष्णुशक्रपुरोगमाः ।\nसर्वे भयपरित्रस्तादुद्रुवुर्भयविह्वलाः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001448001, "chapter_id": 21448, "verse_number": "७-१-२१-२", "content_sanskrit": "निजैरदूषितैरंगैर्दृष्ट्वा देवानुपद्रुतान् ।\nदंड्यानदंडितान्मत्वा चुकोप गणपुंगवः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001448002, "chapter_id": 21448, "verse_number": "७-१-२१-३", "content_sanskrit": "ततस्त्रिशूलमादाय शर्वशक्तिनिबर्हणम् ।\nऊर्ध्वदृष्टिर्महाबाहुर्मुखाज्ज्वालाः समुत्सृजन्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001448003, "chapter_id": 21448, "verse_number": "७-१-२१-४", "content_sanskrit": "अमरानपि दुद्राव द्विरदानिव केसरी ।\nतानभिद्रवतस्तस्य गमनं सुमनोहरम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001448004, "chapter_id": 21448, "verse_number": "७-१-२१-५", "content_sanskrit": "वाराणस्येव मत्तस्य जगाम प्रेक्षणीयताम् ।\nततस्तत्क्षोभयामास महत्सुरबलं बली॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001448005, "chapter_id": 21448, "verse_number": "७-१-२१-६", "content_sanskrit": "महासरोवरं यद्वन्मत्तो वारणयूथपः ।\nविकुर्वन्बहुधावर्णान्नीलपांडुरलोहितान्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001448006, "chapter_id": 21448, "verse_number": "७-१-२१-७", "content_sanskrit": "विभ्रद्व्याघ्राजिनं वासो हेमप्रवरतारकम् ।\nछिन्दन्भिन्दन्नुद १ लिन्दन्दारयन्प्रमथन्नपि॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001448007, "chapter_id": 21448, "verse_number": "७-१-२१-८", "content_sanskrit": "व्यचरद्देवसंघेषु भद्रो ऽग्निरिव कक्षगः ।\nतत्र तत्र महावेगाच्चरंतं शूलधारिणम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001448008, "chapter_id": 21448, "verse_number": "७-१-२१-९", "content_sanskrit": "तमेकं त्रिदशाः सर्वे सहस्रमिव मेनिरे ।\nभद्रकाली च संक्रुद्धा युद्धवृद्धमदोद्धता॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001448009, "chapter_id": 21448, "verse_number": "७-१-२१-१०", "content_sanskrit": "मुक्तज्वालेन शूलेन निर्बिभेद रणे सुरान् ।\nस तया रुरुचे भद्रो रुद्रकोपसमुद्भवः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001448010, "chapter_id": 21448, "verse_number": "७-१-२१-११", "content_sanskrit": "प्रभयेव युगांताग्निश्चलया धूमधूम्रया ।\nभद्रकाली तदायुद्धे विद्रुतत्रिदशाबभौ॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001448011, "chapter_id": 21448, "verse_number": "७-१-२१-१२", "content_sanskrit": "कल्पे शेषानलज्वालादग्धाविश्वजगद्यथा ।\nतदा सवाजिनं सूर्यं रुद्रान्रुद्रगणाग्रणीः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001448012, "chapter_id": 21448, "verse_number": "७-१-२१-१३", "content_sanskrit": "भद्रो मूर्ध्नि जघानाशु वामपादेन लीलया ।\nअसिभिः पावकं भद्रः पट्टिशैस्तु यमं यमी॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001448013, "chapter_id": 21448, "verse_number": "७-१-२१-१४", "content_sanskrit": "रुद्रान्दृढेन शूलेन मुद्गरैर्वरुणं दृढैः ।\nपरिघैर्निरृतिं वायुं टंकैष्टंकधरः स्वयम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001448014, "chapter_id": 21448, "verse_number": "७-१-२१-१५", "content_sanskrit": "निर्बिभेद रणे वीरो लीलयैव गणेश्वरः ।\nसर्वान्देवगणान्सद्यो मुनीञ्छंभोर्विरोधिनः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001448015, "chapter_id": 21448, "verse_number": "७-१-२१-१६", "content_sanskrit": "ततो देवः सरस्वत्या नासिकाग्रं सुशोभनम् ।\nचिच्छेद करजाग्रेण देवमातुस्तथैव च॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001448016, "chapter_id": 21448, "verse_number": "७-१-२१-१७", "content_sanskrit": "चिच्छेद च कुठारेण बाहुदंडं विभावसोः ।\nअग्रतो द्व्यंगुलां जिह्वां मातुर्देव्या लुलाव च॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001448017, "chapter_id": 21448, "verse_number": "७-१-२१-१८", "content_sanskrit": "स्वाहादेव्यास्तथा देवो दक्षिणं नासिकापुटम् ।\nचकर्त करजाग्रेण वामं च स्तनचूचुकम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001448018, "chapter_id": 21448, "verse_number": "७-१-२१-१९", "content_sanskrit": "भगस्य विपुले नेत्रे शतपत्रसमप्रभे ।\nप्रसह्योत्पाटयामास भद्रः परमवेगवान्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001448019, "chapter_id": 21448, "verse_number": "७-१-२१-२०", "content_sanskrit": "पूष्णो दशनरेखां च दीप्तां मुक्तावलीमिव ।\nजघान धनुषः कोट्या स तेनास्पष्टवागभूत्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001448020, "chapter_id": 21448, "verse_number": "७-१-२१-२१", "content_sanskrit": "ततश्चंद्रमसं देवः पादांगुष्ठेन लीलया ।\nक्षणं कृमिवदाक्रम्य घर्षयामास भूतले॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001448021, "chapter_id": 21448, "verse_number": "७-१-२१-२२", "content_sanskrit": "शिरश्चिच्छेद दक्षस्य भद्रः परमकोपतः ।\nक्रोशंत्यामेव वैरिण्यां भद्रकाल्यै ददौ च तत्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001448022, "chapter_id": 21448, "verse_number": "७-१-२१-२३", "content_sanskrit": "तत्प्रहृष्टा समादाय शिरस्तालफलोपमम् ।\nसा देवी कंडुकक्रीडां चकार समरांगणे॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001448023, "chapter_id": 21448, "verse_number": "७-१-२१-२४", "content_sanskrit": "ततो दक्षस्य यज्ञस्त्री कुशीला भर्तृभिर्यथा ।\nपादाभ्यां चैव हस्ताभ्यां हन्यते स्म गणेश्वरैः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001448024, "chapter_id": 21448, "verse_number": "७-१-२१-२५", "content_sanskrit": "अरिष्टनेमिने सोमं धर्मं चैव प्रजापतिम् ।\nबहुपुत्रं चांगिरसं कृशाश्वं कश्यपं तथा॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001448025, "chapter_id": 21448, "verse_number": "७-१-२१-२६", "content_sanskrit": "गले प्रगृह्य बलिनो गणपाः सिंहविक्रमाः ।\nभर्त्सयंतो भृशं वाग्भिर्निर्जघ्नुर्मूर्ध्नि मुष्टिभिः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001448026, "chapter_id": 21448, "verse_number": "७-१-२१-२७", "content_sanskrit": "धर्षिता भूतवेतालैर्दारास्सुतपरिग्रहाः ।\nयथा कलियुगे जारैर्बलेन कुलयोषितः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001448027, "chapter_id": 21448, "verse_number": "७-१-२१-२८", "content_sanskrit": "तच्च विध्वस्तकलशं भग्नयूपं गतोत्सवम् ।\nप्रदीपितमहाशालं प्रभिन्नद्वारतोरणम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001448028, "chapter_id": 21448, "verse_number": "७-१-२१-२९", "content_sanskrit": "उत्पाटितसुरानीकं हन्यमानं तपोधनम् ।\nप्रशान्तब्रह्मनिर्घोषं प्रक्षीणजनसंचयम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001448029, "chapter_id": 21448, "verse_number": "७-१-२१-३०", "content_sanskrit": "क्रन्दमानातुरस्त्रीकं हताशेषपरिच्छदम् ।\nशून्यारण्यनिभं जज्ञे यज्ञवाटं तदार्दितम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001448030, "chapter_id": 21448, "verse_number": "७-१-२१-३१", "content_sanskrit": "शूलवेगप्ररुग्णाश्च भिन्नबाहूरुवक्षसः ।\nविनिकृत्तोत्तमांगाश्च पेतुरुर्व्यां सुरोत्तमाः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001448031, "chapter_id": 21448, "verse_number": "७-१-२१-३२", "content_sanskrit": "हतेषु तेषु देवेषु पतितेषुः सहस्रशः ।\nप्रविवेश गणेशानः क्षणादाहवनीयकम्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001448032, "chapter_id": 21448, "verse_number": "७-१-२१-३३", "content_sanskrit": "प्रविष्टमथ तं दृष्ट्वा भद्रं कालाग्निसंनिभम् ।\nदुद्राव मरणाद्भीतो यज्ञो मृगवपुर्धरः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001448033, "chapter_id": 21448, "verse_number": "७-१-२१-३४", "content_sanskrit": "स विस्फार्य महच्चापं दृढज्याघोषणभीषणम् ।\nभद्रस्तमभिदुद्राव विक्षिपन्नेव सायकान्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001448034, "chapter_id": 21448, "verse_number": "७-१-२१-३५", "content_sanskrit": "आकर्णपूर्णमाकृष्टं धनुरम्बुदसंनिभम् ।\nनादयामास च ज्यां द्यां खं च भूमिं च सर्वशः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001448035, "chapter_id": 21448, "verse_number": "७-१-२१-३६", "content_sanskrit": "तमुपश्रित्य सन्नादं हतो ऽस्मीत्येव विह्वलम् ।\nशरणार्धेन वक्रेण स वीरो ऽध्वरपूरुषम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001448036, "chapter_id": 21448, "verse_number": "७-१-२१-३७", "content_sanskrit": "महाभयस्खलत्पादं वेपन्तं विगतत्विषम् ।\nमृगरूपेण धावन्तं विशिरस्कं तदाकरोत्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001448037, "chapter_id": 21448, "verse_number": "७-१-२१-३८", "content_sanskrit": "तमीदृशमवज्ञातं दृष्ट्वा वै सूर्यसंभवम् ।\nविष्णुः परमसंक्रुद्धो युद्धायाभवदुद्यतः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001448038, "chapter_id": 21448, "verse_number": "७-१-२१-३९", "content_sanskrit": "तमुवाह महावेगात्स्कन्धेन नतसंधिना ।\nसर्वेषां वयसां राजा गरुडः पन्नगाशनः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001448039, "chapter_id": 21448, "verse_number": "७-१-२१-४०", "content_sanskrit": "देवाश्च हतशिष्टा ये देवराजपुरोगमाः ।\nप्रचक्रुस्तस्य साहाय्यं प्राणांस्त्यक्तुमिवोद्यताः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001448040, "chapter_id": 21448, "verse_number": "७-१-२१-४१", "content_sanskrit": "विष्णुना सहितान्देवान्मृगेन्द्रः क्रोष्टुकानिव ।\nदृष्ट्वा जहास भूतेन्द्रो मृगेन्द्र इव विव्यथः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]