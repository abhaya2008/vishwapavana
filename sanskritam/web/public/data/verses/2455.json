[{"id": 2069466, "chapter_id": 2455, "verse_number": "१०-७-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2069467, "chapter_id": 2455, "verse_number": "१०-७-१", "content_sanskrit": "एवं सञ्चिन्तयित्वा तु द्रोणपुत्रो विशाम्पते।\nअवतीर्य रथोपस्थाद्दध्यौ स प्रयतः स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2069468, "chapter_id": 2455, "verse_number": "१०-७-२x", "content_sanskrit": "द्रौणिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2069469, "chapter_id": 2455, "verse_number": "१०-७-२", "content_sanskrit": "उग्रं स्थाणुं शिवं रुद्रं शर्वमीशानमीश्वरम्।\nगिरिशं वरदं देवं भवभावनमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2069470, "chapter_id": 2455, "verse_number": "१०-७-३", "content_sanskrit": "शितिकण्ठमजं रुद्रं दक्षक्रतुहरं हरम्।\nविश्वरूपं विरूपाक्षं बहुरूपमुमापतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2069471, "chapter_id": 2455, "verse_number": "१०-७-४", "content_sanskrit": "श्मशानवासिनं दृप्तं महागणपतिं विभुम्।\nखट्वाङ्गधारिणं मुण्डं जटिलं ब्रह्मचारिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2069472, "chapter_id": 2455, "verse_number": "१०-७-५", "content_sanskrit": "मनसा ह्यनुचिन्त्यैनं दुष्करेणाल्पचेतसा।\nअद्य भूतोपहारेण यक्ष्ये त्रिपुराघातिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2069473, "chapter_id": 2455, "verse_number": "१०-७-६", "content_sanskrit": "xxतुतं स्तुत्यं स्तूयमानममोघं कृत्तिवाससम्।\nविलोहितं नीलकण्ठमसह्यं दुर्निवारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2069474, "chapter_id": 2455, "verse_number": "१०-७-७", "content_sanskrit": "शुक्रं विश्वसृजं ब्रह्म ब्रह्मचारिणमेव च।\nव्रतवन्तं तपोनिष्ठमनन्तं तपतां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2069475, "chapter_id": 2455, "verse_number": "१०-७-८", "content_sanskrit": "बहुरूपं गणाध्यक्षं त्र्यक्षं पारिषदप्रियम्।\nधनाध्यक्षप्रियसखं गौरीहृदयवल्लभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2069476, "chapter_id": 2455, "verse_number": "१०-७-९", "content_sanskrit": "कुमारपितरं पिङ्गं गोवृषोत्तमवाहनम्।\nकुत्तिवाससमत्युग्रमातोषणतत्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2069477, "chapter_id": 2455, "verse_number": "१०-७-१०", "content_sanskrit": "परं परेभ्यः परमं परं यस्मान्न विद्यते।\nइष्वस्त्रोत्तमभर्तारं दिगन्तं देशरक्षिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2069478, "chapter_id": 2455, "verse_number": "१०-७-११", "content_sanskrit": "हिरण्यकवचं देवं चन्द्रमौलिविभूषणम्।\nप्रपद्ये शरणं देवं परमेण समाधिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2069479, "chapter_id": 2455, "verse_number": "१०-७-१२", "content_sanskrit": "इमां चेदापदं घोरां तराम्यद्य सुदुस्तराम्।\nसर्वभूतोपहारेण यक्ष्येऽहं शुचिना शुचिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2069480, "chapter_id": 2455, "verse_number": "१०-७-१३", "content_sanskrit": "इति तस्य व्यवसितं ज्ञात्वा योगात्सुकर्मणः।\nपुरस्तात्काञ्चनी वेदी प्रादुरासीन्महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2069481, "chapter_id": 2455, "verse_number": "१०-७-१४", "content_sanskrit": "तस्यां वेद्यां तदा राजंश्चित्रभानुरजायत।\nस दिशो विदिशः खं च ज्वालाभिरिव पूरयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2069482, "chapter_id": 2455, "verse_number": "१०-७-१५", "content_sanskrit": "दीप्तास्यनयनाश्चात्र नैकपादशिरोधराः।\n[रत्नचित्राङ्गदधराः समुद्यतकरास्तथाः॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2069483, "chapter_id": 2455, "verse_number": "१०-७-१६", "content_sanskrit": "द्विपाः शैलप्रतीकाशाः प्रादुरासन्महागणाः।\nश्ववराहोष्ट्ररूपाश्च हयगोमायुगोमुखाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2069484, "chapter_id": 2455, "verse_number": "१०-७-१७", "content_sanskrit": "ऋक्षमार्जारवदना व्याघ्रद्वीपिमुखास्तथा।\nकाकवक्त्राः प्लुवमुखाः शुकवक्त्रास्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2069485, "chapter_id": 2455, "verse_number": "१०-७-१८", "content_sanskrit": "महाजगरवक्त्राश्च हंसवक्त्राः शितप्रभाः।\nदार्वाघाटमुखाश्चापि चाषवक्त्राश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2069486, "chapter_id": 2455, "verse_number": "१०-७-१९", "content_sanskrit": "कूर्मनक्रमुखाश्चैव शिंशुमारमुखास्तथा।\nमहामकरवक्त्राश्च तिमिवक्त्रास्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2069487, "chapter_id": 2455, "verse_number": "१०-७-२०", "content_sanskrit": "हरिवक्त्राः क्रौञ्चमुखाः कपोताभमुखास्तथा।\nपारावतमुखाश्चैव मद्गुवक्त्रास्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2069488, "chapter_id": 2455, "verse_number": "१०-७-२१", "content_sanskrit": "पाणिकर्णाः सहस्राक्षास्तथैव च महोदराः।\nनिर्मांसाः काकवक्त्राश्च श्येनवक्त्राश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2069489, "chapter_id": 2455, "verse_number": "१०-७-२२", "content_sanskrit": "तथैवाशिरसो राजन्नृक्षवक्त्राश्च भीषणाः।\nप्रदीप्तनेत्रजिह्वाश्च ज्वालावर्णास्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2069490, "chapter_id": 2455, "verse_number": "१०-७-२३", "content_sanskrit": "ज्वालाकेशाश्च राजेन्द्र ज्वलद्रोमचतुर्भुजाः।\nमेषवक्त्रास्तथैवान्ये तथा छागमुखा नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2069491, "chapter_id": 2455, "verse_number": "१०-७-२४", "content_sanskrit": "शङ्खाभाः शङ्खवक्त्राश्च शङ्खवर्णास्तथैव च।\nशङ्खमालापरिकराः शह्खध्वनिसमस्वनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2069492, "chapter_id": 2455, "verse_number": "१०-७-२५", "content_sanskrit": "जटाधराः प़ञ्चशिखास्तथा मुण्डाः कृशोदराः।\nचतुर्दंष्ट्राश्चतुर्जिह्वाः शङ्कुकर्णाः किरीटिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2069493, "chapter_id": 2455, "verse_number": "१०-७-२६", "content_sanskrit": "मौञ्जीधराश्च राजेन्द्र तथा कुञ्चितमूर्धजाः।\nउष्णीषिणः कुण्डलिनश्चारुवक्त्राः स्वलङ्कृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2069494, "chapter_id": 2455, "verse_number": "१०-७-२७", "content_sanskrit": "पद्मोत्पलापीडधरास्तथा मुकुटधारिणः।\nमहात्म्येन च संयुक्ताः शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2069495, "chapter_id": 2455, "verse_number": "१०-७-२८", "content_sanskrit": "शतघ्नीचक्रहस्ताश्च तथा मुसलपाणयः।\nभुशुण्डीपाशहस्ताश्च दण़्डहस्ताश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2069496, "chapter_id": 2455, "verse_number": "१०-७-२९", "content_sanskrit": "पृष्ठेषु बद्धेषुधयश्चित्रबाणोत्कटास्तथा।\nसध्वजाः सपताकाश्च सघण्टाः सपरश्वथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2069497, "chapter_id": 2455, "verse_number": "१०-७-३०", "content_sanskrit": "महापाशोद्यतकरास्तथा लगुडपाणयः।\nस्थूणाहस्ताः खङ्गहस्ताः सर्पोच्छ्रितकिरीटिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2069498, "chapter_id": 2455, "verse_number": "१०-७-३१", "content_sanskrit": "महासर्पाङ्गदधराश्चित्राभरणधारिणः।\nरजोध्वजाः पङ्कदिग्धाः सर्वे चित्राम्बरस्रजः।\nनीलाङ्गाः पिङ्गलाङ्गाश्च मुण्डवक्तास्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2069499, "chapter_id": 2455, "verse_number": "१०-७-३२", "content_sanskrit": "भेरीशङ्खमृदङ्गांश्च झर्झरानकगोमुखान्।\nअवादयन्पारिषदाः प्रहृष्टाः कनकप्रभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2069500, "chapter_id": 2455, "verse_number": "१०-७-३३", "content_sanskrit": "गायमानास्तथैवान्ये संहृष्टाः पुरुषर्षभाः।\nलङ्घयन्तः प्लुवन्तश्च वल्गन्तश्च महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2069501, "chapter_id": 2455, "verse_number": "१०-७-३४", "content_sanskrit": "धावन्तो जवनाश्चण्डाः पावकोद्वूतमूर्धजाः।\nमत्ता इव महानागा विनदन्तो मुहुर्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2069502, "chapter_id": 2455, "verse_number": "१०-७-३५", "content_sanskrit": "सुभीमा घोररूपाश्च शूलपट्टसपाणयः।\nनानाविरागवसनाश्चित्रमाल्यानुलेपनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2069503, "chapter_id": 2455, "verse_number": "१०-७-३६", "content_sanskrit": "रत्नचित्राङ्गदधराः समुद्यतकरास्तथा।\nहन्तारो द्विषतां शूराः प्रसह्यासह्यविक्रमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2069504, "chapter_id": 2455, "verse_number": "१०-७-३७", "content_sanskrit": "पातारोऽसृग्वसाज्यानां मांसान्त्रकृतभोजनाः।\nचूडालाः कर्णिकाराश्च प्रहृष्टाः पिठरोदराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2069505, "chapter_id": 2455, "verse_number": "१०-७-३८", "content_sanskrit": "अतिहस्वातिदीर्घाश्च प्रलम्बाश्चातिभैरवाः।\nविकटाः काललंबोष्ठा बृहच्छेफाण्डपिण्डिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2069506, "chapter_id": 2455, "verse_number": "१०-७-३९", "content_sanskrit": "महार्हनानाविकटा मुण्डाश्च जटिलाः परे।\nसार्केन्दुग्रहनक्षत्रां द्यां कुर्युस्ते महीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2069507, "chapter_id": 2455, "verse_number": "१०-७-४०", "content_sanskrit": "उत्सहेरंश्च ये हन्तुं भूतग्रामं चतुर्विधम्।\nये च वीतभया नित्यं हरस्य भ्रुकुटीसहाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2069508, "chapter_id": 2455, "verse_number": "१०-७-४१", "content_sanskrit": "कामकारकरा नित्यं त्रैलोक्यस्येश्वरेश्वराः।\nनित्यानन्दप्रमुदिता वागीशा वीतमत्सराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2069509, "chapter_id": 2455, "verse_number": "१०-७-४२", "content_sanskrit": "प्राप्याष्टगुणमैश्वर्यं ये न यास्यन्ति वै स्मयम्।\nयेषां विस्मयते नित्यं भगवान्कर्मभिर्हरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2069510, "chapter_id": 2455, "verse_number": "१०-७-४३", "content_sanskrit": "मनोवाक्कर्मभिर्युक्तैर्नित्यमाराधितश्च यैः।\nमनोवाक्कर्मभिर्भक्तान्पाति पुत्रानिवौरसान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2069511, "chapter_id": 2455, "verse_number": "१०-७-४४", "content_sanskrit": "पिबन्तोऽसृग्वसाश्चान्ये क्रुद्धा ब्रह्मद्विषां सदा।\nचतुर्विधात्मकं सोमं ये पिबन्ति च सर्वदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2069512, "chapter_id": 2455, "verse_number": "१०-७-४५", "content_sanskrit": "श्रुतेन ब्रह्मचर्येण तपसा च दमेन च।\nये समाराध्य शूलाङ्कं भवसायुज्यमागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2069513, "chapter_id": 2455, "verse_number": "१०-७-४६", "content_sanskrit": "यैरात्मभूतैर्भगवान्पार्वत्या च महेश्वरः।\nमहाभूतगणैर्भुङ्क्ते भूतभव्यभवत्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2069514, "chapter_id": 2455, "verse_number": "१०-७-४७", "content_sanskrit": "नानावादित्रहसितक्ष्वेडितोत्कृष्टगर्जितैः।\nसन्त्रासयन्तस्ते विश्वमश्वत्थामानमभ्ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2069515, "chapter_id": 2455, "verse_number": "१०-७-४८", "content_sanskrit": "संस्तुवन्तो महादेवं भाः कुर्वाणाः सुवर्चसः।\nविवर्धयिषवो द्रौणेर्महिमानं महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2069516, "chapter_id": 2455, "verse_number": "१०-७-४९", "content_sanskrit": "जिज्ञासमानास्तत्तेजः सौप्तिकं च दिदृक्षवः।\nभीमोग्रपरिघालातशूलपट्टसपाणयः।\nघोररूपाः समाजग्मुर्भूतसङ्घाः सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2069517, "chapter_id": 2455, "verse_number": "१०-७-५०", "content_sanskrit": "जनयेयुर्भयं ये स्म त्रैलोक्यस्यापि दर्शनात्।\nन च तान्प्रेक्षमाणोऽपि व्यथामुपजगाम ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2069518, "chapter_id": 2455, "verse_number": "१०-७-५१", "content_sanskrit": "अथ द्रौणिर्धनुष्पाणिर्बद्धगोधाङ्गुलित्रवान्।\nस्वयमेवात्मनात्मानमुपहारमुपाहरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2069519, "chapter_id": 2455, "verse_number": "१०-७-५२", "content_sanskrit": "धनूंषि समिधस्तत्र पवित्राणि सिताः शराः।\nहविरात्मवतश्चात्मा तस्मिन्भारत कर्मणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2069520, "chapter_id": 2455, "verse_number": "१०-७-५३", "content_sanskrit": "ततः सौम्येन मन्त्रेण द्रोणपुत्रः प्रतापवान्।\nउपहारं महामन्युरथात्मानमुपाहरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2069521, "chapter_id": 2455, "verse_number": "१०-७-५४", "content_sanskrit": "तं रुद्रं रौद्रकर्माणं रौद्रैः कर्मभिरच्युतम्।\nअभिष्टुत्य महात्मानमित्युवाच कृताञ्जलिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2069522, "chapter_id": 2455, "verse_number": "१०-७-५५x", "content_sanskrit": "द्रौणिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2069523, "chapter_id": 2455, "verse_number": "१०-७-५५", "content_sanskrit": "इममात्मानमद्याहं जातमाङ्गिरसे कुले।\nस्वग्नौ जुहोमि भगवन्प्रतिगृह्णीष्व मां बलिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2069524, "chapter_id": 2455, "verse_number": "१०-७-५६", "content_sanskrit": "भवद्भक्त्या महादेव पस्मेण समाधिना।\nअस्यामापदि विश्वात्मन्नुपाकुर्मी तवाग्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2069525, "chapter_id": 2455, "verse_number": "१०-७-५७", "content_sanskrit": "त्वयि सर्वाणि भूतानि सर्वभूतेषु चासि वै।\nगुणानां हि प्रधानानां कैवल्यं त्वयि तिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2069526, "chapter_id": 2455, "verse_number": "१०-७-५८", "content_sanskrit": "सर्वभूताश्रय विभो हविर्भूतमवस्थितम्।\nप्रतिगृहाण मां देव यद्यशक्याः परे मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2069527, "chapter_id": 2455, "verse_number": "१०-७-५९", "content_sanskrit": "इत्युक्त्वा द्रौणिरास्थाय तां देवीं दीप्तपावकाम्।\nसन्त्यज्यात्मानमारुह्य कृष्णवर्त्मन्युपाविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2069528, "chapter_id": 2455, "verse_number": "१०-७-६०", "content_sanskrit": "तमूर्ध्वबाहुं निश्चेष्टं दृष्ट्वा हविरुपस्थितम्।\nअब्रवीद्भगवान्साक्षान्महादेवो हसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2069529, "chapter_id": 2455, "verse_number": "१०-७-६१", "content_sanskrit": "सत्यशौचार्जवत्यागैस्तपसा नियमेन च।\nक्षान्त्या भक्त्या च धृत्या च कर्मणा मनसा गिरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2069530, "chapter_id": 2455, "verse_number": "१०-७-६२", "content_sanskrit": "यथावदहमाराद्वः कृष्णेनाक्लिष्टकर्मणा।\nतस्मादिष्टतमः कृष्णादन्यो मम न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2069531, "chapter_id": 2455, "verse_number": "१०-७-६३", "content_sanskrit": "कुर्वता तात सम्मानं त्वां च जिज्ञासता मया।\nपाञ्चालाः सर्वदा गुप्ता मायाश्च बहुशः कृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2069532, "chapter_id": 2455, "verse_number": "१०-७-६४", "content_sanskrit": "कृतस्तस्यैव सम्मानं पाञ्चालान्रक्षता मया।\nअभिभूतास्तु कालेन नैषामद्यास्ति जीवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2069533, "chapter_id": 2455, "verse_number": "१०-७-६५", "content_sanskrit": "एवमुक्त्वा महात्मानं भगवानात्मनस्तनुम्।\nआविवेश ददौ चास्मै विमलं खङ्गमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2069534, "chapter_id": 2455, "verse_number": "१०-७-६६", "content_sanskrit": "अथाविष्टो भगवता भूयो जज्वाल तेजसा।\nवेगवांश्चाभवद्युद्धे देवसृष्टेन तेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2069535, "chapter_id": 2455, "verse_number": "१०-७-६७", "content_sanskrit": "तं दृष्ट्वा तानि भूतानि रक्षांसि च समाद्रवन्।\nअभितः शिबिरं यान्तं द्रोणपुत्रं महारथम्।\nदेवदेवं हरं स्थाउं यान्तं साक्षादिवेश्वरम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2069536, "chapter_id": 2455, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सौप्तिकपर्वणि सप्तमोऽध्यायः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]