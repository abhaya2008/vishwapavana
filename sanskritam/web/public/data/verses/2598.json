[{"id": 2075500, "chapter_id": 2598, "verse_number": "१२-१०३-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2075501, "chapter_id": 2598, "verse_number": "१२-१०३-१", "content_sanskrit": "कथं मृदौ कथं तीक्ष्णे महापक्षे च भारत।\nअरौ वर्तेत नृपतिस्तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2075502, "chapter_id": 2598, "verse_number": "१२-१०३-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2075503, "chapter_id": 2598, "verse_number": "१२-१०३-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nबृहस्पतेश्च संवादमिन्द्रस्य च युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2075504, "chapter_id": 2598, "verse_number": "१२-१०३-३", "content_sanskrit": "बृहस्पतिं देवपतिरभिवाद्य कृताञ्जलिः।\nउपसंगम्य पप्रच्छ वासवः परवीरहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2075505, "chapter_id": 2598, "verse_number": "१२-१०३-४", "content_sanskrit": "अहितेषु कथं ब्रह्मन्प्रवर्तेयमतन्द्रितः।\nअसमुछिद्य चैवैतान्नियच्छेयमुपायतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2075506, "chapter_id": 2598, "verse_number": "१२-१०३-५", "content_sanskrit": "सेनयोर्थ्यतिषङ्गे च जयः साधारणो भवेत्।\nकिं कुर्वाणं न मां जह्याज्ज्वलिता श्रीः प्रतापिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2075507, "chapter_id": 2598, "verse_number": "१२-१०३-६", "content_sanskrit": "ततो र्मार्थकामानां कुशलः प्रतिभानवान्।\nराजधर्मविधानज्ञः प्रत्युवाच पुरंदरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2075508, "chapter_id": 2598, "verse_number": "१२-१०३-७", "content_sanskrit": "न जा कलहेनेच्छेन्नियन्तुमपकारिणः।\nबालैर सवितं ह्येतद्यदमर्षो यदक्षमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2075509, "chapter_id": 2598, "verse_number": "१२-१०३-८", "content_sanskrit": "न शत्रुर्विवृतः कार्यो वधमस्याभिकाङ्क्षता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2075510, "chapter_id": 2598, "verse_number": "१२-१०३-९", "content_sanskrit": "क्रोधं भयं च हर्षं च नियम्य स्वयमात्मनि।\nअमित्र पसेवेत विश्वस्तवदविश्वसन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2075511, "chapter_id": 2598, "verse_number": "१२-१०३-१०", "content_sanskrit": "प्रियमेव वदेन्नित्यं नाप्रियं किंचिदाचरेत्।\nविरमेच्छुष्कवैरेभ्यः कर्णजापं च वर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2075512, "chapter_id": 2598, "verse_number": "१२-१०३-११", "content_sanskrit": "यथा वैतंसिको युक्तो द्विजानां सदृशस्वरः।\nतान्द्विजान्कुरुते वश्यांस्तथायुक्तो महीपतिः।\nवशं चोपनयेच्छत्रून्निहन्याच्च पुंरदर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2075513, "chapter_id": 2598, "verse_number": "१२-१०३-१२", "content_sanskrit": "न नित्यं परिभूयारीन्सुखं स्वपिति वासव।\nजागर्त्येव हि दुष्टात्मा संकरेऽग्निरिवोत्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2075514, "chapter_id": 2598, "verse_number": "१२-१०३-१३", "content_sanskrit": "न सन्निपातः कर्तव्यः सामान्ये विजये सति।\nविश्वास्यैवोपसंनम्यो वशे कृत्वा रिपुः प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2075515, "chapter_id": 2598, "verse_number": "१२-१०३-१४", "content_sanskrit": "संप्रधार्य सहामात्यैर्मन्त्रविद्भिर्महात्मभिः।\nउपेक्ष्यमाणो विज्ञातो हृदयेनापराजितः।\nअथास्य प्रहरेत्काले विधेर्वित्तलितो यदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2075516, "chapter_id": 2598, "verse_number": "१२-१०३-१५", "content_sanskrit": "दण्डं च दूषयेदस्य पुरुषैराप्तकारिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2075517, "chapter_id": 2598, "verse_number": "१२-१०३-१६", "content_sanskrit": "आदिमध्यावसानज्ञान्प्रच्छन्नं च विचारयेत्।\nबलानि दूषयेदस्य जानन्नेव प्रमाणतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2075518, "chapter_id": 2598, "verse_number": "१२-१०३-१७", "content_sanskrit": "भेदेनोपप्रदानेन संसृजेदौषधैस्तथा।\nन त्वेव खलु संसर्गं रोचयेदरिभिः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2075519, "chapter_id": 2598, "verse_number": "१२-१०३-१८", "content_sanskrit": "दीर्घकालमपीक्षेत्त निग्राह्या एव शत्रवः।\nकालकाङ्गी च युक्तः सन्नुपासीत शचीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2075520, "chapter_id": 2598, "verse_number": "१२-१०३-१९", "content_sanskrit": "तथा प्रियं च वक्तव्यं यथा विस्रम्भमाप्नुयात्।\nन सद्योऽरीन्विहन्याच्च द्रष्टव्यो विजयो ध्रुवः।\nभूयः शल्यं घटयति नवं च कुरुते व्रणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2075521, "chapter_id": 2598, "verse_number": "१२-१०३-२०", "content_sanskrit": "प्राप्ते च प्रहरेत्काले न च संवर्तते पुनः।\nहन्तुकामस्य देवेन्द्र पुरुषस्य रिपून्प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2075522, "chapter_id": 2598, "verse_number": "१२-१०३-२१", "content_sanskrit": "यं हि कालो व्यतिक्रामेत्पुरुषं कालकाङ्क्षिणम्।\nदुर्लभः स पुनस्तेन कालः कर्म चिकीर्षता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2075523, "chapter_id": 2598, "verse_number": "१२-१०३-२२", "content_sanskrit": "औजस्यं जनयेदेव संगृह्णन्साधुसंमतम्।\nकालेन साधयेत्कृत्यमप्राप्तो न हि पीडयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2075524, "chapter_id": 2598, "verse_number": "१२-१०३-२३", "content_sanskrit": "विहाय कामं क्रोधं च तथाऽहंकारमेव च।\nयुक्तो विवरमन्विच्छेदहितानां सदा नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2075525, "chapter_id": 2598, "verse_number": "१२-१०३-२४", "content_sanskrit": "मार्दवं दण्ड आलस्यं प्रमादश्च सुरोत्तम।\nमायाः सुविहिताः शक्र शातयन्त्यविचक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2075526, "chapter_id": 2598, "verse_number": "१२-१०३-२५", "content_sanskrit": "निहत्यैतानि चत्वारि मायां प्रतिविधाय च।\nततः शक्नोति शत्रूणां प्रहर्तुमविचारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2075527, "chapter_id": 2598, "verse_number": "१२-१०३-२६", "content_sanskrit": "यदेवैतेन शक्येत गुह्यं कर्तुं तदाऽऽचरेत्।\nयच्छन्ति सतिवा गुह्यं मिथो विश्रावयन्त्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2075528, "chapter_id": 2598, "verse_number": "१२-१०३-२७", "content_sanskrit": "अशक्यमिति कृत्वा वा ततोऽन्यैः संविदं चरेत्।\nब्रह्मदण्डमदृष्टेषु दृष्टेषु चतुरङ्गिणीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2075529, "chapter_id": 2598, "verse_number": "१२-१०३-२८", "content_sanskrit": "भेदं च प्रथमं विद्यात्तूष्णीं दण्डं तथैव च।\nकाले प्रयोजयेद्राजा तस्मिंस्तस्मिंस्तदातदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2075530, "chapter_id": 2598, "verse_number": "१२-१०३-२९", "content_sanskrit": "प्रणिपातं च गच्छेत काले शत्रोर्बलीयसः।\nयुक्तोऽस्य वधमन्विच्छेदप्रमत्तः प्रमाद्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2075531, "chapter_id": 2598, "verse_number": "१२-१०३-३०", "content_sanskrit": "प्रणिपातेन दानेन वाचा मधुरया ब्रुवन्।\nअमित्रमुपसेवेत न च जातु विशङ्कयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2075532, "chapter_id": 2598, "verse_number": "१२-१०३-३१", "content_sanskrit": "स्थानानि शङ्कितानां च नित्यमेव विवर्जयेत्।\nन च तेष्वाश्वसेद्राजा जाग्रतीह निराकृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2075533, "chapter_id": 2598, "verse_number": "१२-१०३-३२", "content_sanskrit": "न ह्यतो दुष्करं कर्म किंचिदस्ति सुरोत्तम।\nयथा विविधवृत्तानामैश्वर्यममराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2075534, "chapter_id": 2598, "verse_number": "१२-१०३-३३", "content_sanskrit": "तथा विविधशीलानामपि संभव उच्यते।\nप्रयतेद्योगमास्थाय मित्रामित्रानधारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2075535, "chapter_id": 2598, "verse_number": "१२-१०३-३४", "content_sanskrit": "मृदुमप्यवमन्यन्ते तीक्ष्णादुद्विजते जनः।\nमातीक्ष्णो मा मृदुर्भूस्त्वं तीक्ष्णो भव मृदुर्भव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2075536, "chapter_id": 2598, "verse_number": "१२-१०३-३५", "content_sanskrit": "यथा वप्रे वेगवति सर्वतः संप्लतोदके।\nनित्यं विचरणाद्वाधस्तथा राज्यं प्रमाद्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2075537, "chapter_id": 2598, "verse_number": "१२-१०३-३६", "content_sanskrit": "न बहूनुपरुध्येत यौगपद्येन शात्रवान्।\nसाम्ना दानेन भेदेन दण्डेन च पुरंदर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2075538, "chapter_id": 2598, "verse_number": "१२-१०३-३७", "content_sanskrit": "एकैकमेषां निष्पिष्य शिष्टेषु निपुणं चरेत्।\nन तु शक्तोऽपि मेधावी सर्वानेवाचरेद्बुधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2075539, "chapter_id": 2598, "verse_number": "१२-१०३-३८", "content_sanskrit": "यदा स्यान्महती सेना हयनागरथाकुला।\nपदातियन्त्रबहुला अनुरक्ता षडङ्गिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2075540, "chapter_id": 2598, "verse_number": "१२-१०३-३९", "content_sanskrit": "यदा बहुविधां वृद्धिं मन्येत प्रतियोगतः।\nतदा विवृत्य प्रहरेद्दस्यूनामविचारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2075541, "chapter_id": 2598, "verse_number": "१२-१०३-४०", "content_sanskrit": "न साम दण्डोपनिषत्प्रशस्यते\nन मार्दवं शत्रुषु यात्रिकं सदा।\nन सस्यघातो न च संकरक्रिया\nन चापि भूयः प्रकृतेर्विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2075542, "chapter_id": 2598, "verse_number": "१२-१०३-४१", "content_sanskrit": "मायाविभेदानुपसर्जनानि\nवाचं तथैव प्रथमं प्रयोगात्।\nआप्तैर्मनुष्यैरुपचारयेत\nपुरेषु राष्ट्रेषु च संप्रयुक्तान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2075543, "chapter_id": 2598, "verse_number": "१२-१०३-४२", "content_sanskrit": "पुराऽपि चैताननुसृत्य भूमिपाः\nपुरेषु भोगानखिलाञ्जयन्ति\nपुरेषु नीतिं विहितां यथाविधि\nप्रयोजयन्तो बलवृत्रसूदन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2075544, "chapter_id": 2598, "verse_number": "१२-१०३-४३", "content_sanskrit": "प्रदाय गूढानि वसूनि नाम\nप्रच्छिद्य भोगानपहाय च स्वान्।\nदुष्टाः स्वदोषैरिति कीर्तयित्वा\nपुरेषु राष्ट्रेषु च योजयन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2075545, "chapter_id": 2598, "verse_number": "१२-१०३-४४", "content_sanskrit": "तथैव चान्यैरपि शास्त्रवेदिभिः\nस्वलंकृतैः शास्त्रविधानलिङ्गितैः।\nसुशिक्षितैर्भाष्यकथाविशारदैः\nपरेषु कृत्यामुपधारयेच्च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2075546, "chapter_id": 2598, "verse_number": "१२-१०३-४५x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2075547, "chapter_id": 2598, "verse_number": "१२-१०३-४५", "content_sanskrit": "कानि लिङ्गानि दुष्टस्य भवन्ति द्विजसत्तम।\nकथं दुष्टं विजानीयादेतत्पुष्टो ब्रवीहि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2075548, "chapter_id": 2598, "verse_number": "१२-१०३-४६x", "content_sanskrit": "बृहस्पतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2075549, "chapter_id": 2598, "verse_number": "१२-१०३-४६", "content_sanskrit": "परोक्षमगुणानाह सद्रुणानभ्यसूयति।\nपरैर्वा कीर्त्यमानेषु तूष्णीमास्ते पराङ्भुखः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2075550, "chapter_id": 2598, "verse_number": "१२-१०३-४७", "content_sanskrit": "तूष्णींभावेऽपि विज्ञेयं न चेद्भवति कारणम्।\nविश्वासं चोष्ठसंदंशं शिरसश्च प्रकम्पनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2075551, "chapter_id": 2598, "verse_number": "१२-१०३-४८", "content_sanskrit": "करोत्यभीक्ष्णं संसृष्टमसंसृष्टश्च भाषते।\nअदृष्टवद्विकुरुते दृष्ट्वा वा नाभिभाषते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2075552, "chapter_id": 2598, "verse_number": "१२-१०३-४९", "content_sanskrit": "पृथगेत्य समश्नाति नेदमद्य यथाविधि।\nआसने शयने याने भावा लक्ष्या विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2075553, "chapter_id": 2598, "verse_number": "१२-१०३-५०", "content_sanskrit": "आर्तिरार्ते प्रिये प्रीतिरेतावन्मित्रलक्षणम्।\nविपरीतं तु बोद्धव्यमरिलक्षणमेव तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2075554, "chapter_id": 2598, "verse_number": "१२-१०३-५१", "content_sanskrit": "एतान्येव यथोक्तानि बुध्येथास्त्रिदशाधिप।\nपुरुषाणां प्रदुष्टानां स्वभावो बलवत्तरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2075555, "chapter_id": 2598, "verse_number": "१२-१०३-५२", "content_sanskrit": "इति दुष्टस्य विज्ञानमुक्तं ते सुतसत्तम।\nनिशाम्य शास्त्रतत्त्वार्थं यथावदमरेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2075556, "chapter_id": 2598, "verse_number": "१२-१०३-५३x", "content_sanskrit": "भीष्म उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2075557, "chapter_id": 2598, "verse_number": "१२-१०३-५३", "content_sanskrit": "स तद्वचः शत्रुनिबर्हणे रत\nस्तथा चकारावितथं बृहस्पतेः।\nचचार काले विजयाय चारिहा\nवशं च शत्रूननयत्पुरंदरः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2075558, "chapter_id": 2598, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि त्र्यधिकशततमोऽध्यायः॥ १०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]