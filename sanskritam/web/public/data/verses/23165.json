[{"id": 7003165000, "chapter_id": 23165, "verse_number": "४-१०१-१", "content_sanskrit": "अथैकाधिकशततमोध्यायः ।\nनारायण उवाच ।\nसंस्तूय देवा मुनयो विरेमुर्नहि मानसे ।\nददृशुः प्राङ्गणे कृष्णं शोभितं पीतवाससा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003165001, "chapter_id": 23165, "verse_number": "४-१०१-२", "content_sanskrit": "यथा सौदामिनीयुक्तं नवीनजलदं मुने ।\nबकपङ् क्तियुतं चैव मालतीमालया तथा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003165002, "chapter_id": 23165, "verse_number": "४-१०१-३", "content_sanskrit": "कपाले मण्डलाकारकस्तूरीयुक्तचन्दनम् ।\nसकलङ्कं मृगाङ्कं च शोभितं जलदे तथा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003165003, "chapter_id": 23165, "verse_number": "४-१०१-४", "content_sanskrit": "द्विभुजं श्यामलंकान्तं राधाकान्तं मनोहरम् ।\nईषद्धास्यप्रसन्नास्यं भक्तानुग्रहविग्रहम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003165004, "chapter_id": 23165, "verse_number": "४-१०१-५", "content_sanskrit": "रत्नकेयूरवलयरत्नमञ्जीररञ्जितम् ।\nरुदन्तं पितुरुत्सङ्गे बलेन सहितं परम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003165005, "chapter_id": 23165, "verse_number": "४-१०१-६", "content_sanskrit": "अथ मङ्गलकाले च शुभलग्ने मनोरमे ।\nसंपीक्षिते ग्रहैः सौम्यैर्जांग्रल्लग्नाधिपे स्थिते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003165006, "chapter_id": 23165, "verse_number": "४-१०१-७", "content_sanskrit": "असद्ग्रहैरदृष्टे च सद्ग्रहेक्षित एव च ।\nशुभकर्मसमारम्भं स्वस्तिवाचनपूर्वकम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003165007, "chapter_id": 23165, "verse_number": "४-१०१-८", "content_sanskrit": "चकार वसुदेवश्चाप्याज्ञया सुरविप्रयोः ।\nदत्त्वा सुवर्णशतकं ब्राह्मणाय च सादरम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003165008, "chapter_id": 23165, "verse_number": "४-१०१-९", "content_sanskrit": "देवेन्द्रांश्च मुनीन्द्राश्च नमस्कृत्य पुरोहितम् ।\nगणेशं च दिनेशं च वह्निं च शंकरं शिवाम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003165009, "chapter_id": 23165, "verse_number": "४-१०१-१०", "content_sanskrit": "संपूज्य देवषट्कं च साक्षतैर्देवसंसदि ।\nउपचारैः षोडशभिः संयतो भक्तिपूर्वकम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003165010, "chapter_id": 23165, "verse_number": "४-१०१-११", "content_sanskrit": "पुत्राधिवासनं चक्रै वेदमन्त्रेण संसदि ।\nसंपूज्य नानादेवांश्च दिक्पालांश्च नवग्रहान् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003165011, "chapter_id": 23165, "verse_number": "४-१०१-१२", "content_sanskrit": "दत्त्वा पञ्चोपचारांश्च भक्त्या षोडशमातृकाः ।\nदत्त्वा च वसुधारां च सप्तवारान्घृतेन च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003165012, "chapter_id": 23165, "verse_number": "४-१०१-१३", "content_sanskrit": "चेदिराजं वसुं नत्वा संपूज्य प्रययौ पुनः ।\nवृद्धिश्राद्धं सुनिर्वाप्य यत्किंचिद्दैविकं तथा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003165013, "chapter_id": 23165, "verse_number": "४-१०१-१४", "content_sanskrit": "यज्ञं कृत्वा तु वेदोक्तं यज्ञसूत्रं ददौ मुदा ।\nवलदेवाग्रचायैव कृष्णाय परमात्मने ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003165014, "chapter_id": 23165, "verse_number": "४-१०१-१५", "content_sanskrit": "गायत्री च ददौ ताभ्यां मुनिः सांदीपनिस्तथा ।\nभिक्षां ददौ च प्रथमं पार्वती परमादरात् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003165015, "chapter_id": 23165, "verse_number": "४-१०१-१६", "content_sanskrit": "अमूल्यरत्नपात्रस्थं मुक्तामाणिक्यहीरकम् ।\nहीरसारविनिर्माणं पित्रा दत्तं च हारकम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003165016, "chapter_id": 23165, "verse_number": "४-१०१-१७", "content_sanskrit": "शुभाशिषं च प्रददौ शुक्लपुष्पेणा दूर्वया ।\nततोऽदितिर्दितिश्चैव मुनिपत्न्यश्च देवकी ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003165017, "chapter_id": 23165, "verse_number": "४-१०१-१८", "content_sanskrit": "यशोदा रोहिणी हृष्टा सावित्री च सरस्वती ।\nप्रत्येकं प्रददौ भिक्षां मणिकाञ्चनभूषिताम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003165018, "chapter_id": 23165, "verse_number": "४-१०१-१९", "content_sanskrit": "देवकन्या नागकन्या राजकन्याः पतिव्रताः ।\nकामिन्यो बान्धवानां च सस्मिताः स्निग्धलोचनाः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003165019, "chapter_id": 23165, "verse_number": "४-१०१-२०", "content_sanskrit": "इन्द्राणी वरुणानी च पवनानी च रोहिणी ।\nकुबेरपत्नीं स्वाहा च रतिः कामस्य कामिनी ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003165020, "chapter_id": 23165, "verse_number": "४-१०१-२१", "content_sanskrit": "प्रत्येकं प्रददौ भिक्षां रत्नभूषणभूषिताम् ।\nभिक्षां गृहीत्वा भगवान्सबलो भक्तिपूर्वकम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003165021, "chapter_id": 23165, "verse_number": "४-१०१-२२", "content_sanskrit": "किंचिद्ददौ च गर्गाय किचित्स्वगुरवे तथा ।\nवैदिकं कर्म निर्वाप्य गर्गाय दक्षिणां ददौ ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003165022, "chapter_id": 23165, "verse_number": "४-१०१-२३", "content_sanskrit": "देवांश्च भोजयामास ब्राह्मणांश्चापि सादरम् ।\nये ये समाययुर्यज्ञे तेच दत्त्वा शुभाशिषम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003165023, "chapter_id": 23165, "verse_number": "४-१०१-२४", "content_sanskrit": "कृण्णाय बलदेवाय प्रहृष्टाः प्रययृर्गुहम् ।\nनन्दः सभार्यो निर्वाप्य शुभकर्म सुतस्य वै ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003165024, "chapter_id": 23165, "verse_number": "४-१०१-२५", "content_sanskrit": "क्रोडे कृत्वा बलं कृष्णं चुचुम्ब वदनं तयोः ।\nउचचै रुरोद नन्दश्च यशोदा च पतिव्रता ।\nश्रीकृष्णस्तं समाश्वास्य बोधयामास यत्नतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003165025, "chapter_id": 23165, "verse_number": "४-१०१-२६", "content_sanskrit": "श्रीकृष्ण उवाच ।\nसानन्दं गच्छ हे मातर्यशोदे तातमत्वरम् ।\nत्वमेव माता पोष्ट्री त्वं पिता च परमार्थतः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003165026, "chapter_id": 23165, "verse_number": "४-१०१-२७", "content_sanskrit": "अवन्तिनगरं तात यास्यामि सबलोऽधुना ।\nमुनेः सांदीपनेः स्थानं वेदपाठार्थमीप्सितम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003165027, "chapter_id": 23165, "verse_number": "४-१०१-२८", "content_sanskrit": "तत आगत्य सुचिरं काले भवति दर्शनम् ।\nकामः करोति कलनं स च भेदं करोति च ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003165028, "chapter_id": 23165, "verse_number": "४-१०१-२९", "content_sanskrit": "सर्वं कालकृतं मातर्भेदं संमीलनं नृणाम् ।\nसुखं दुःखं च हर्षं च शोकं च मङ्गलालयम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003165029, "chapter_id": 23165, "verse_number": "४-१०१-३०", "content_sanskrit": "मया दत्तं च तत्त्वं च योगिनामपि दुर्लभम् ।\nसर्वं नन्दश्च सानन्दं त्वामेव कथयिष्यति ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003165030, "chapter_id": 23165, "verse_number": "४-१०१-३१", "content_sanskrit": "इत्युक्त्वा जगतां नाथो वसुदेवसभां ययौ ।\nतदाज्ञया क्षणं प्राप्य ययौ संदीपनेर्गूहम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003165031, "chapter_id": 23165, "verse_number": "४-१०१-३२", "content_sanskrit": "वसुदेवं देवकीं च संभाष्य विनयेन च ।\nनन्दः सभार्यः प्रययौ हृदयेन विदूयता ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003165032, "chapter_id": 23165, "verse_number": "४-१०१-३३", "content_sanskrit": "मुक्तामणिं सुवर्ण च माणिक्यं हीरकं तथा ।\nवह्निशुद्धांशुकं रत्नं नन्दाय देवकी ददौ ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003165033, "chapter_id": 23165, "verse_number": "४-१०१-३४", "content_sanskrit": "श्वेताश्वं च गजेन्द्रं च सुवर्णरथमुत्तमम् ।\nनन्दाय कृष्णः प्रददौ वसुदेवश्च सादरम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003165034, "chapter_id": 23165, "verse_number": "४-१०१-३५", "content_sanskrit": "तयोरनुव्रजन्विप्रा देवकीप्रमुखाः स्त्रियः ।\nवसुदेवस्तथाऽक्रूरोऽप्युद्धवश्च ययौ मुदा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003165035, "chapter_id": 23165, "verse_number": "४-१०१-३६", "content_sanskrit": "कालिन्दीनिकटं गत्वा ते सर्वे रुरुदुः शुचा ।\nपरस्परं च संभाष्य ते सर्वे स्वालयं ययुः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003165036, "chapter_id": 23165, "verse_number": "४-१०१-३७", "content_sanskrit": "कुन्ती सपुत्रा विधवा वसुदेवाज्ञया मुने ।\nनानारत्नमणिं प्राप्य प्रययौ स्वरलयं मुदा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003165037, "chapter_id": 23165, "verse_number": "४-१०१-३८", "content_sanskrit": "वसुतेवो देवकी च पुत्रकल्याणहेतवे ।\nनानारत्नमणिं वस्त्रं मुवर्णं रजतं तथा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003165038, "chapter_id": 23165, "verse_number": "४-१०१-३९", "content_sanskrit": "मुक्तामाणिक्यचहारं च मिष्टान्नं च सुधोपमम् ।\nभट्टेम्यो ब्राह्मणेभ्यश्च प्रददौ सादरं मुदा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003165039, "chapter_id": 23165, "verse_number": "४-१०१-४०", "content_sanskrit": "महोत्सवं वेदपाठं हरेर्नामैकमङ्गलम् ।\nविप्राणां भोजनं चैव कारयामास यत्नतः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003165040, "chapter_id": 23165, "verse_number": "४-१०१-४१", "content_sanskrit": "ज्ञातीनां बान्धवानां च पुरस्कारं यथोचितम् ।\nचकार मणिमाणिक्यमुक्तावस्त्रैर्मनोहरैः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]