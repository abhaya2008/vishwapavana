[{"id": 40018881, "chapter_id": 9298, "verse_number": "1", "content_sanskrit": "तौतथायुध्यमानौतुसमरेरामरावणौ । ददृशुस्सर्वभूतानिविस्मितेनान्तरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40018882, "chapter_id": 9298, "verse_number": "2", "content_sanskrit": "अर्धयन्तौतुसमरेतयोस्तौस्यन्दनोत्तमौ । परस्परमभिक्रुद्धौपरस्परमभिद्रुतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40018883, "chapter_id": 9298, "verse_number": "3", "content_sanskrit": "परस्परवधेयुक्तौघोररूपौबभूवतुः । मण्डलानि च वीधीश्चगतप्रत्यागतानि च ॥ दर्शयन्तौबहुविधांसूतसामर्थ्यजांगतिम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40018884, "chapter_id": 9298, "verse_number": "4", "content_sanskrit": "अर्धयन्रावणंरामोराघवंचापिरावणः ॥ गतिवेगंसमापन्नौप्रतिवेगप्रवर्तने ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40018885, "chapter_id": 9298, "verse_number": "5", "content_sanskrit": "क्षिपतोश्शरजालानितयोस्तौस्यन्दनोत्तमौ ॥ चेरतुस्सम्युगमहीं सासारौ जलदाविव ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40018886, "chapter_id": 9298, "verse_number": "6", "content_sanskrit": "दर्शयित्वातदातौतुगतिंबहुविधांरणे ॥ परस्परस्याभिमुखौपुनरेव च तस्थतुः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40018887, "chapter_id": 9298, "verse_number": "7", "content_sanskrit": "धुरंधुरेणरथयोर्वक्त्रंवक्त्रेणवाजिनाम् ॥ पताकाश्चपताकाभिस्समीयुस्स्थितयोस्तदा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40018888, "chapter_id": 9298, "verse_number": "8", "content_sanskrit": "रावणस्यततोरामोधनुर्मुस्तैश्शितैश्शरैः ॥ चतुर्भिश्चतुरोदीप्तान्हयान्प्रत्यपसर्पयत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40018889, "chapter_id": 9298, "verse_number": "9", "content_sanskrit": "सक्रोधवशमापन्नोहयानामपसर्पणे ॥ मुमोचनिशितान्बाणान्राघवायदशाननः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40018890, "chapter_id": 9298, "verse_number": "10", "content_sanskrit": "सोतिविद्धोबलवतादशग्रीवेणराघवः ॥ जगाम न विकारं च न चापिव्यथितोऽभवत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40018891, "chapter_id": 9298, "verse_number": "11", "content_sanskrit": "चिक्षेप च पुनर्भाणान्वज्रपातसमस्वनान् ॥ सारथिंवज्रहस्तस्यसमुद्दिश्यदशाननः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40018892, "chapter_id": 9298, "verse_number": "12", "content_sanskrit": "मातलेस्तुमहावेगाश्शरीरेपतिताश्शराः ॥ न सूक्ष्ममपिसम्मोहंव्यथांवाप्रददुर्युधि ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40018893, "chapter_id": 9298, "verse_number": "13", "content_sanskrit": "तयाधर्षणयाक्रुद्धोमातलेर्नतथात्मनः ॥ चकारशरजालेनराघवोविमुखंरिपुम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40018894, "chapter_id": 9298, "verse_number": "14", "content_sanskrit": "विंशतिंत्रिंशतिंषष्टिंशतशोऽथसहस्रशः ॥ मुमोचराघवोवीरस्सायकान्स्यन्दनेरिपोः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40018895, "chapter_id": 9298, "verse_number": "15", "content_sanskrit": "रावणोऽपिततःक्रुद्धोरथस्थराक्षसेश्वरः ॥ गदामुसलव