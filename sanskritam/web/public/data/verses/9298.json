[{"id": 5000298000, "chapter_id": 9298, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे षड्विंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000298001, "chapter_id": 9298, "verse_number": "४-२६-१", "content_sanskrit": "ततः शोकाभिसंतप्तं सुग्रीवं क्लिन्नवाससम्।\nशाखामृगमहामात्राः परिवार्योपतस्थिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000298002, "chapter_id": 9298, "verse_number": "४-२६-२", "content_sanskrit": "अभिगम्य महाबाहुं राममक्लिष्टकारिणम्।\nस्थिताः प्राञ्जलयः सर्वे पितामहमिवर्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000298003, "chapter_id": 9298, "verse_number": "४-२६-३", "content_sanskrit": "ततः काञ्चनशैलाभस्तरुणार्कनिभाननः।\nअब्रवीत् प्राञ्जलिर्वाक्यं हनूमान् मारुतात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000298004, "chapter_id": 9298, "verse_number": "४-२६-४", "content_sanskrit": "भवत्प्रसादात् काकुत्स्थ पितृपैतामहं महत्।\nवानराणां सुदंष्ट्राणां सम्पन्नबलशालिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000298005, "chapter_id": 9298, "verse_number": "४-२६-५", "content_sanskrit": "महात्मनां सुदुष्प्रापं प्राप्तं राज्यमिदं प्रभो।\nभवता समनुज्ञातः प्रविश्य नगरं शुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000298006, "chapter_id": 9298, "verse_number": "४-२६-६", "content_sanskrit": "संविधास्यति कार्याणि सर्वाणि ससुहृद‍्गणः।\nस्नातोऽयं विविधैर्गन्धैरौषधैश्च यथाविधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000298007, "chapter_id": 9298, "verse_number": "४-२६-७", "content_sanskrit": "अर्चयिष्यति माल्यैश्च रत्नैश्च त्वां विशेषतः।\nइमां गिरिगुहां रम्यामभिगन्तुं त्वमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000298008, "chapter_id": 9298, "verse_number": "४-२६-८", "content_sanskrit": "कुरुष्व स्वामिसम्बन्धं वानरान् सम्प्रहर्षय।\nएवमुक्तो हनुमता राघवः परवीरहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000298009, "chapter_id": 9298, "verse_number": "४-२६-९", "content_sanskrit": "प्रत्युवाच हनूमन्तं बुद्धिमान् वाक्यकोविदः।\nचतुर्दश समाः सौम्य ग्रामं वा यदि वा पुरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000298010, "chapter_id": 9298, "verse_number": "४-२६-१०", "content_sanskrit": "न प्रवेक्ष्यामि हनुमन् पितुर्निर्देशपालकः।\nसुसमृद्धां गुहां दिव्यां सुग्रीवो वानरर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000298011, "chapter_id": 9298, "verse_number": "४-२६-११", "content_sanskrit": "प्रविष्टो विधिवद् वीरः क्षिप्रं राज्येऽभिषिच्यताम्।\nएवमुक्त्वा हनूमन्तं रामः सुग्रीवमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000298012, "chapter_id": 9298, "verse_number": "४-२६-१२", "content_sanskrit": "वृत्तज्ञो वृत्तसम्पन्नमुदारबलविक्रमम्।\nइममप्यङ्गदं वीरं यौवराज्येऽभिषेचय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000298013, "chapter_id": 9298, "verse_number": "४-२६-१३", "content_sanskrit": "ज्येष्ठस्य हि सुतो ज्येष्ठः सदृशो विक्रमेण च।\nअङ्गदोऽयमदीनात्मा यौवराज्यस्य भाजनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000298014, "chapter_id": 9298, "verse_number": "४-२६-१४", "content_sanskrit": "पूर्वोऽयं वार्षिको मासः श्रावणः सलिलागमः।\nप्रवृत्ताः सौम्य चत्वारो मासा वार्षिक संज्ञिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000298015, "chapter_id": 9298, "verse_number": "४-२६-१५", "content_sanskrit": "नायमुद्योगसमयः प्रविश त्वं पुरीं शुभाम्।\nअस्मिन् वत्स्याम्यहं सौम्य पर्वते सहलक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000298016, "chapter_id": 9298, "verse_number": "४-२६-१६", "content_sanskrit": "इयं गिरिगुहा रम्या विशाला युक्तमारुता।\nप्रभूतसलिला सौम्य प्रभूतकमलोत्पला ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000298017, "chapter_id": 9298, "verse_number": "४-२६-१७", "content_sanskrit": "कार्तिके समनुप्राप्ते त्वं रावणवधे यत।\nएष नः समयः सौम्य प्रविश त्वं स्वमालयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000298018, "chapter_id": 9298, "verse_number": "४-२६-१८", "content_sanskrit": "अभिषिञ्चस्व राज्ये च सुहृदः सम्प्रहर्षय।\nइति रामाभ्यनुज्ञातः सुग्रीवो वानरर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000298019, "chapter_id": 9298, "verse_number": "४-२६-१९", "content_sanskrit": "प्रविवेश पुरीं रम्यां किष्किन्धां वालिपालिताम्।\nतं वानरसहस्राणि प्रविष्टं वानरेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000298020, "chapter_id": 9298, "verse_number": "४-२६-२०", "content_sanskrit": "अभिवार्य प्रविष्टानि सर्वतः प्लवगेश्वरम्।\nततः प्रकृतयः सर्वा दृष्ट्वा हरिगणेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000298021, "chapter_id": 9298, "verse_number": "४-२६-२१", "content_sanskrit": "प्रणम्य मूर्ध्ना पतिता वसुधायं समाहिताः।\nसुग्रीवः प्रकृतीः सर्वाः सम्भाष्योत्थाप्य वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000298022, "chapter_id": 9298, "verse_number": "४-२६-२२", "content_sanskrit": "भ्रातुरन्तःपुरं सौम्यं प्रविवेश महाबलः।\nप्रविष्टं भीमविक्रान्तं सुग्रीवं वानरर्षभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000298023, "chapter_id": 9298, "verse_number": "४-२६-२३", "content_sanskrit": "अभ्यषिञ्चन्त सुहृदः सहस्राक्षमिवामराः।\nतस्य पाण्डुरमाजह्रुश्छत्रं हेमपरिष्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000298024, "chapter_id": 9298, "verse_number": "४-२६-२४", "content_sanskrit": "शुक्ले च वालव्यजने हेमदण्डे यशस्करे।\nतथा रत्नानि सर्वाणि सर्वबीजौषधानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000298025, "chapter_id": 9298, "verse_number": "४-२६-२५", "content_sanskrit": "सक्षीराणां च वृक्षाणां प्ररोहान् कुसुमानि च।\nशुक्लानि चैव वस्त्राणि श्वेतं चैवानुलेपनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000298026, "chapter_id": 9298, "verse_number": "४-२६-२६", "content_sanskrit": "सुगन्धीनि च माल्यानि स्थलजान्यम्बुजानि च।\nचन्दनानि च दिव्यानि गन्धांश्च विविधान् बहून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000298027, "chapter_id": 9298, "verse_number": "४-२६-२७", "content_sanskrit": "अक्षतं जातरूपं च प्रियङ्गुं मधुसर्पिषी।\nदधि चर्म च वैयाघ्रं परार्घ्यौ चाप्युपानहौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000298028, "chapter_id": 9298, "verse_number": "४-२६-२८", "content_sanskrit": "समालम्भनमादाय गोरोचनमनःशिलाम्।\nआजग्मुस्तत्र मुदिता वराः कन्याश्च षोडश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000298029, "chapter_id": 9298, "verse_number": "४-२६-२९", "content_sanskrit": "ततस्ते वानरश्रेष्ठमभिषेक्तुं यथाविधि।\nरत्नैर्वस्त्रैश्च भक्ष्यैश्च तोषयित्वा द्विजर्षभान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000298030, "chapter_id": 9298, "verse_number": "४-२६-३०", "content_sanskrit": "ततः कुशपरिस्तीर्णं समिद्धं जातवेदसम्।\nमन्त्रपूतेन हविषा हुत्वा मन्त्रविदो जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000298031, "chapter_id": 9298, "verse_number": "४-२६-३१", "content_sanskrit": "ततो हेमप्रतिष्ठाने वरास्तरणसंवृते।\nप्रासादशिखरे रम्ये चित्रमाल्योपशोभिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000298032, "chapter_id": 9298, "verse_number": "४-२६-३२", "content_sanskrit": "प्राङ्मुखं विधिवन्मन्त्रैः स्थापयित्वा वरासने।\nनदीनदेभ्यः संहृत्य तीर्थेभ्यश्च समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000298033, "chapter_id": 9298, "verse_number": "४-२६-३३", "content_sanskrit": "आहृत्य च समुद्रेभ्यः सर्वेभ्यो वानरर्षभाः।\nअपः कनककुम्भेषु निधाय विमलं जलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000298034, "chapter_id": 9298, "verse_number": "४-२६-३४", "content_sanskrit": "शुभैर्ऋषभशृङ्गैश्च कलशैश्चैव काञ्चनैः।\nशास्त्रदृष्टेन विधिना महर्षिविहितेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000298035, "chapter_id": 9298, "verse_number": "४-२६-३५", "content_sanskrit": "गजो गवाक्षो गवयः शरभो गन्धमादनः।\nमैन्दश्च द्विविदश्चैव हनूमाञ्जाम्बवांस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000298036, "chapter_id": 9298, "verse_number": "४-२६-३६", "content_sanskrit": "अभ्यषिञ्चत सुग्रीवं प्रसन्नेन सुगन्धिना।\nसलिलेन सहस्राक्षं वसवो वासवं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000298037, "chapter_id": 9298, "verse_number": "४-२६-३७", "content_sanskrit": "अभिषिक्ते तु सुग्रीवे सर्वे वानरपुङ्गवाः।\nप्रचुक्रुशुर्महात्मानो हृष्टाः शतसहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000298038, "chapter_id": 9298, "verse_number": "४-२६-३८", "content_sanskrit": "रामस्य तु वचः कुर्वन् सुग्रीवो वानरेश्वरः।\nअङ्गदं सम्परिष्वज्य यौवराज्येऽभ्यषेचयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000298039, "chapter_id": 9298, "verse_number": "४-२६-३९", "content_sanskrit": "अङ्गदे चाभिषिक्ते तु सानुक्रोशाः प्लवंगमाः।\nसाधु साध्विति सुग्रीवं महात्मानो ह्यपूजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000298040, "chapter_id": 9298, "verse_number": "४-२६-४०", "content_sanskrit": "रामं चैव महात्मानं लक्ष्मणं च पुनः पुनः।\nप्रीताश्च तुष्टुवुः सर्वे तादृशे तत्र वर्तिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000298041, "chapter_id": 9298, "verse_number": "४-२६-४१", "content_sanskrit": "हृष्टपुष्टजनाकीर्णा पताकाध्वजशोभिता।\nबभूव नगरी रम्या किष्किन्धा गिरिगह्वरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000298042, "chapter_id": 9298, "verse_number": "४-२६-४२", "content_sanskrit": "निवेद्य रामाय तदा महात्मने\nमहाभिषेकं कपिवाहिनीपतिः।\nरुमां च भार्यामुपलभ्य वीर्यवा-\nनवाप राज्यं त्रिदशाधिपो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000298043, "chapter_id": 9298, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे षड्विंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]