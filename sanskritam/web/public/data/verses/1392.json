[{"id": 2018733, "chapter_id": 1392, "verse_number": "३-३०-०x", "content_sanskrit": "द्रौपद्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2018734, "chapter_id": 1392, "verse_number": "३-३०-१", "content_sanskrit": "नमो धात्रे विधात्रे च यौ मोहं चक्रतुस्तव।\nपितृपैतामहे राज्ये वोढव्ये तेऽन्यथा मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2018735, "chapter_id": 1392, "verse_number": "३-३०-२", "content_sanskrit": "[कर्मभिश्चिन्तितो लोको गत्यांगत्यां पृथग्विधः।\nतस्मात्कर्माणि नित्यानि लोभान्मोक्षं यियासति ।]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2018736, "chapter_id": 1392, "verse_number": "३-३०-३", "content_sanskrit": "नेह धर्मानृशंस्याभ्यां न क्षान्त्या नार्जवेन च।\nपुरुषः श्रियमाप्नोति न घृणित्वेन कर्हिचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2018737, "chapter_id": 1392, "verse_number": "३-३०-४", "content_sanskrit": "त्वां चेद्व्यसनमभ्यागादिदं भारत दुःसहम्।\nस त्वं नार्हसि नापीमे भ्रातरस्ते महौजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2018738, "chapter_id": 1392, "verse_number": "३-३०-५", "content_sanskrit": "न हि तेऽध्यगमञ्जातु तदानीं नाद्य भारत।\nधर्मात्प्रियतरं किंचिदपि चेज्जीवितादपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2018739, "chapter_id": 1392, "verse_number": "३-३०-६", "content_sanskrit": "धर्मार्थमेव ते राज्यं धर्मार्थं जीवितं च ते।\nब्राह्मणा गुरवश्चैव जानन्त्यपि च देवताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2018740, "chapter_id": 1392, "verse_number": "३-३०-७", "content_sanskrit": "भीमसेनार्जुनौ चोभौ माद्रेयौ च मया सह।\nत्यजेस्त्वमिति मे बुद्धिर्न तु धर्मं परित्यजेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2018741, "chapter_id": 1392, "verse_number": "३-३०-८", "content_sanskrit": "राजानं धर्मगोप्तारं धर्मो रक्षति रक्षितः।\nइति मे श्रुतमार्याणां त्वां तु मन्ये न रक्षति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2018742, "chapter_id": 1392, "verse_number": "३-३०-९", "content_sanskrit": "त्यक्त्वाऽन्यान्हि नरव्याघ्र नित्यदा धर्म एव ते।\nबुद्धिः सततमन्वेति छायेवं पुरुषं निजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2018743, "chapter_id": 1392, "verse_number": "३-३०-१०", "content_sanskrit": "नावमंस्था हि सदृशान्नावराञ्श्रेयसः कुतः।\nअवाप्य पृथिवीं कृत्स्नां न ते शृङ्गमवर्धत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2018744, "chapter_id": 1392, "verse_number": "३-३०-११", "content_sanskrit": "स्वाहाकारैः स्वधाभिश्च पूजाभिरपि च द्विजान्।\nदेवताश्च पितॄंश्चैव सततं पार्थ सेवसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2018745, "chapter_id": 1392, "verse_number": "३-३०-१२", "content_sanskrit": "ब्राह्मणाः सर्वकामैस्ते सततं पार्थ तर्पिताः।\nयतयो मोक्षिणश्चैव गृहस्ताश्चैव भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2018746, "chapter_id": 1392, "verse_number": "३-३०-१३", "content_sanskrit": "भुञ्जते रुक्मपात्रीभिर्यत्राहं परिचारिका।\nआरण्यकेभ्यो वन्यानि भोजनानि प्रयच्छसि।\nनादेयं ब्राह्मणेभ्यस्ते गृहे किंचन विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2018747, "chapter_id": 1392, "verse_number": "३-३०-१४", "content_sanskrit": "यदिदं वैश्वदेवान्ते सायं प्रातः प्रदीयते।\nतद्दत्त्वाऽतिथिभृत्येभ्योराजञ्शिष्टेनजीवसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2018748, "chapter_id": 1392, "verse_number": "३-३०-१५", "content_sanskrit": "इष्टयः पशुबन्धाश्च काम्यनैमित्तिकाश्च ये।\nवर्तन्ते पाकयज्ञाश्च सदा यज्ञाश्च तेऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2018749, "chapter_id": 1392, "verse_number": "३-३०-१६", "content_sanskrit": "अस्मिन्नपि महारण्ये विजने दस्युसेविते।\nराष्ट्रादपेत्य वसतो धर्मस्ते नावसीदति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2018750, "chapter_id": 1392, "verse_number": "३-३०-१७", "content_sanskrit": "अश्वमेधो राजसूयः पौण्डरीकोऽथ गोसवः।\nइष्टास्त्वया महायज्ञाबहवोऽन्ये सदक्षिणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2018751, "chapter_id": 1392, "verse_number": "३-३०-१८", "content_sanskrit": "राजन्परीतया बुद्ध्या विषमेऽक्षपराजये।\nपार्थ मित्राणि चास्मांश्च वसूनि च पराजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2018752, "chapter_id": 1392, "verse_number": "३-३०-१९", "content_sanskrit": "ऋजोर्मृदोर्बदान्यस्य धीमतः सत्यवादिनः।\nकथमक्षव्यसनजा बुद्धिरापतिता तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2018753, "chapter_id": 1392, "verse_number": "३-३०-२०", "content_sanskrit": "अतीव मोह आयाति मनश् परिदूयते।\nनिशाम्य व्यसनं पार्थ तवेदमतिदुःसहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2018754, "chapter_id": 1392, "verse_number": "३-३०-२१", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nईश्वरस्य वशे लोकस्तिष्ठते नात्मनो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2018755, "chapter_id": 1392, "verse_number": "३-३०-२२", "content_sanskrit": "धातैव खलु भूतानां सुखदुःखे प्रियाप्रिये।\nददाति सर्वमीशानः पुरस्ताच्छुक्रमुच्चरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2018756, "chapter_id": 1392, "verse_number": "३-३०-२३", "content_sanskrit": "यथा दारुमयीं योषां नरो धीरः समाहितः।\nइङ्ग्यत्यङ्गमङ्गानि तथा राजन्निमाः प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2018757, "chapter_id": 1392, "verse_number": "३-३०-२४", "content_sanskrit": "आकाश इव भूतानि व्याप्य सर्वाणि भारत।\nईश्वरो विदधातीह कल्याणं यच्च पापकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2018758, "chapter_id": 1392, "verse_number": "३-३०-२५", "content_sanskrit": "शकुनिस्तन्तुबद्धो वा नीयतेऽयमनीश्वरः।\nईश्वरस्य वशे तिष्ठन्नान्येषामात्मनः प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2018759, "chapter_id": 1392, "verse_number": "३-३०-२६", "content_sanskrit": "मणिः सूत्र इव प्रोतो नस्योत इव गोवृषः।\nधातुरादेशमन्वेति तन्मयो हि तदर्पणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2018760, "chapter_id": 1392, "verse_number": "३-३०-२७", "content_sanskrit": "नात्माथीनो मनुष्योऽयं कालं भजतिं कंचन।\nस्रोतसो मध्यमापन्नः कूलवृक्ष इव च्युतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2018761, "chapter_id": 1392, "verse_number": "३-३०-२८", "content_sanskrit": "अज्ञो जन्तुरनीशोऽयमात्मनः सुखदुःखयोः।\nईश्वरप्रेरितो गच्छेत्स्वर्गं नरकमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2018762, "chapter_id": 1392, "verse_number": "३-३०-२९", "content_sanskrit": "यथा वायोस्तृणाग्राणि वशं यान्ति बलीयसः।\nधातुरेवं वशं यान्ति सर्वभूतानि भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2018763, "chapter_id": 1392, "verse_number": "३-३०-३०", "content_sanskrit": "आर्ये कर्मणि युञ्जानः पापे वा पुनरीश्वः।\nव्याप्य भूतानि चरते न चायमिति लक्ष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2018764, "chapter_id": 1392, "verse_number": "३-३०-३१", "content_sanskrit": "हेतुमात्रमिदं धातुः शरीरं क्षेत्रसंज्ञितम्।\nयेन कारयते कर्म शुभाशुभफलं विभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2018765, "chapter_id": 1392, "verse_number": "३-३०-३२", "content_sanskrit": "पश्य मायाप्रभावोऽयमीश्वरेण यथा कृतः।\nयो हन्ति भूतैर्भूतानि मोहयित्वाऽऽत्ममायया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2018766, "chapter_id": 1392, "verse_number": "३-३०-३३", "content_sanskrit": "अन्यथा परिदृष्टानि मुनिभिस्तत्त्वदर्शिभिः।\nअन्यथा परिवर्तन्ते वेगा इव नभस्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2018767, "chapter_id": 1392, "verse_number": "३-३०-३४", "content_sanskrit": "अन्यथैव हि वर्तन्ते पुरुषास्तानि तानि च।\nअन्यथैव प्रभुस्तानि करोति विकरोति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2018768, "chapter_id": 1392, "verse_number": "३-३०-३५", "content_sanskrit": "यथा काष्ठेन वा काष्ठमश्मानं चाश्मना पुनः।\nअयसा चाप्ययश्छिन्द्यान्निर्विचेष्टमचेतनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2018769, "chapter_id": 1392, "verse_number": "३-३०-३६", "content_sanskrit": "एवं स भगवान्देवः स्वयंभूः प्रपितामहः।\nनिहन्ति भूतैर्भूतानि छद्म कृत्वा युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2018770, "chapter_id": 1392, "verse_number": "३-३०-३७", "content_sanskrit": "संप्रयोज्य वियोज्यायं कामकारकरः प्रभुः।\nक्रीडते भगवान्भूतैर्बालः क्रीडनकैरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2018771, "chapter_id": 1392, "verse_number": "३-३०-३८", "content_sanskrit": "न मातृपितृवद्राजन्धाता भूतेषु वर्तते।\nरोषादिव प्रवृत्तोऽयं यथाऽयमितरो जनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2018772, "chapter_id": 1392, "verse_number": "३-३०-३९", "content_sanskrit": "आर्याञ्शीलवो दृष्ट्वा हीमतो वृत्तिकर्शितान्।\nअनार्यान्सुखिनश्चैव विह्वलानिव चिन्तये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2018773, "chapter_id": 1392, "verse_number": "३-३०-४०", "content_sanskrit": "तवेमामापदं दृष्ट्वा समृद्धिं च सुयोधने।\nधातारं गर्हये पार्थ विषमं योऽनुपश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2018774, "chapter_id": 1392, "verse_number": "३-३०-४१", "content_sanskrit": "आर्यशास्त्रातिगे क्रूरे लुब्धे धर्मापचायिनि।\nधार्तराष्ट्रे श्रियं दत्त्वा धाता किं फलमश्नुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2018775, "chapter_id": 1392, "verse_number": "३-३०-४२", "content_sanskrit": "कर्मचेत्कृतमन्वेति कर्तारं नान्यमृच्छति।\nकर्मणा तेन पापेन लिप्यते नूनमीश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2018776, "chapter_id": 1392, "verse_number": "३-३०-४३", "content_sanskrit": "अथ कर्मकृतं पापं न चेत्कर्तारमृच्छति।\nकारणं बलमेवेह जनाञ्शोचामि दुर्बलान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2018777, "chapter_id": 1392, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि अर्जुनाभिगमनपर्वणि त्रिंशोऽध्यायः ॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]