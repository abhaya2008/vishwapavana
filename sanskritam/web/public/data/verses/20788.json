[{"id": 7000788000, "chapter_id": 20788, "verse_number": "६-१३१-१", "content_sanskrit": "पार्वत्युवाच ।\nशालग्रामशिला शुद्धा मूर्त्तयः संति भूतले ।\nतासां चैव तु मूर्तीनां पूजनं कतिधा स्मृतम्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000788001, "chapter_id": 20788, "verse_number": "६-१३१-२", "content_sanskrit": "ब्राह्मणैः कति पूज्यास्ताः क्षत्रियैर्वा सुरेश्वर ।\nवैश्यैर्वापि कथं शूद्रैः स्त्रीभिर्वापि समादिश॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000788002, "chapter_id": 20788, "verse_number": "६-१३१-३", "content_sanskrit": "महादेव उवाच ।\nशालग्रामशिला पुण्या पवित्रा धर्मकारिणी ।\nयस्या दर्शनमात्रेण ब्रह्महा शुध्यते नरः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000788003, "chapter_id": 20788, "verse_number": "६-१३१-४", "content_sanskrit": "तद्गृहं सर्वतीर्थानां प्रवरं श्रुतिनोदितम् ।\nयत्रेयं सर्वदा मूर्तिः शालग्रामशिला शुभा॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000788004, "chapter_id": 20788, "verse_number": "६-१३१-५", "content_sanskrit": "ब्राह्मणैः पंचपूज्या स्युश्चतस्रः क्षत्रियैस्तथा ।\nवैश्यैस्तिस्रस्तथापूज्याएकापूज्याप्रयत्नतः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000788005, "chapter_id": 20788, "verse_number": "६-१३१-६", "content_sanskrit": "तस्यादर्शनमात्रेणशूद्रो मुक्तिमवाप्नुयात् ।\nअनेन विधिना देवि ये नराः पूजयंति वै॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000788006, "chapter_id": 20788, "verse_number": "६-१३१-७", "content_sanskrit": "भोगान्सर्वांस्तत्र भुक्त्वा यांति विष्णोः सनातनम् ।\nइयं सा महती मूर्तिः सर्वदा पापहारिणी॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000788007, "chapter_id": 20788, "verse_number": "६-१३१-८", "content_sanskrit": "कैलासाद्यं फलं देवि जायते पूजनाद्यतः ।\nतत्र गंगा च यमुना गोदावरी सरस्वती॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000788008, "chapter_id": 20788, "verse_number": "६-१३१-९", "content_sanskrit": "तिष्ठते च शिला यत्र सर्वं तत्र न संशयः ।\nकिमत्र बहुनोक्तेन भूयोभूयो वरानने॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000788009, "chapter_id": 20788, "verse_number": "६-१३१-१०", "content_sanskrit": "पूजनं मनुजैः सम्यक्कर्त्तव्यं मुक्तिमिच्छुभिः ।\nभक्तिभावेन देवेशि येऽर्चयंति जनार्दनम्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000788010, "chapter_id": 20788, "verse_number": "६-१३१-११", "content_sanskrit": "तेषां दर्शनमात्रेण ब्रह्महा शुध्यते जनः ।\nदासभावेन ये शूद्राः स्वर्चनं कुर्वते सदा॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000788011, "chapter_id": 20788, "verse_number": "६-१३१-१२", "content_sanskrit": "तेषां पुण्यं न जानंति ब्रह्माद्याश्च सुरेश्वरि ।\nभक्तिभावेन ये विप्रा हरिमभ्यर्चयंति वै॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000788012, "chapter_id": 20788, "verse_number": "६-१३१-१३", "content_sanskrit": "एकविंशतिकुलं तैस्तु तारितं तेषु जन्मसु ।\nशंखचक्रांकितो यस्तु विप्रः पूजनमाचरेत्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000788013, "chapter_id": 20788, "verse_number": "६-१३१-१४", "content_sanskrit": "पूजितं तु जगत्सर्वं तेन विष्णुप्रपूजनात् ।\nपितरः संवदंत्यस्मत्कुले जाताश्च वैष्णवाः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000788014, "chapter_id": 20788, "verse_number": "६-१३१-१५", "content_sanskrit": "तत्कुलं तारितं तैस्तु यावदाभूतसंप्लवम् ।\nते तु चास्मान्समुद्धृत्य नयंते विष्णुमंदिरम्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000788015, "chapter_id": 20788, "verse_number": "६-१३१-१६", "content_sanskrit": "स एव दिवसो धन्यो धन्या माताऽथ बांधवाः ।\nपिता तस्य च वै धन्यो धन्या वै सुहृदस्तथा॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000788016, "chapter_id": 20788, "verse_number": "६-१३१-१७", "content_sanskrit": "सर्वे धन्यतमा ज्ञेया विष्णुभक्तिपरायणाः ।\nतेषां दर्शनमात्रेण महापापात्प्रमुच्यते॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000788017, "chapter_id": 20788, "verse_number": "६-१३१-१८", "content_sanskrit": "उपपातकानि सर्वाणि महांति पातकानि च ।\nतानि सर्वाणि नश्यंति वैष्णवानां च दर्शनात्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000788018, "chapter_id": 20788, "verse_number": "६-१३१-१९", "content_sanskrit": "पावका इव दीप्यंते ये नरा वैष्णवा भुवि ।\nविमुक्ताः सर्वपापेभ्यो मेघेभ्य इव चंद्रमाः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000788019, "chapter_id": 20788, "verse_number": "६-१३१-२०", "content_sanskrit": "आर्द्रशुष्कं लघुस्थूलं वाङ्मनः कर्मभिः कृतम् ।\nतत्सर्वं नाशमायाति वैष्णवानां च दर्शनात्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000788020, "chapter_id": 20788, "verse_number": "६-१३१-२१", "content_sanskrit": "हिंसादिकं च यत्पापं ज्ञानाज्ञानं कृतं च यत् ।\nतत्सर्वं नाशमायाति दर्शनाद्वैष्णवस्य च॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000788021, "chapter_id": 20788, "verse_number": "६-१३१-२२", "content_sanskrit": "निःपापास्त्रिदिवं यांति पापिष्ठा यांति शुद्धिताम् ।\nदर्शनादेव साधूनां सत्यं तुभ्यं मयोदितम्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000788022, "chapter_id": 20788, "verse_number": "६-१३१-२३", "content_sanskrit": "संसारकर्दमालेपप्रक्षालनविशारदः ।\nपावनः पावनानां च विष्णुभक्तो न संशयः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000788023, "chapter_id": 20788, "verse_number": "६-१३१-२४", "content_sanskrit": "प्रत्यहं विष्णुभक्ता ये स्मरंति मधुसूदनम् ।\nते तु विष्णुमया ज्ञेया विष्णुस्तत्र न संशयः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000788024, "chapter_id": 20788, "verse_number": "६-१३१-२५", "content_sanskrit": "नवनीलघनश्यामं नलिनायतलोचनम् ।\nशंखचक्रगदापद्मधरं पीतांबरावृतम्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000788025, "chapter_id": 20788, "verse_number": "६-१३१-२६", "content_sanskrit": "कौस्तुभेन विराजंतं वनमालाधरं हरिम् ।\nउल्लसत्कुंडलज्योतिः कपोलवदनश्रिया॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000788026, "chapter_id": 20788, "verse_number": "६-१३१-२७", "content_sanskrit": "विराजितं किरीटेन वलयांगदनूपुरैः ।\nप्रसन्नवदनांभोजं चतुर्बाहुं श्रियान्वितम्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000788027, "chapter_id": 20788, "verse_number": "६-१३१-२८", "content_sanskrit": "एवं ध्यायंति ये विप्रा विष्णुं चैव तु पार्वति ।\nते विप्रा विष्णुरूपाश्च वैष्णवास्ते न संशयः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000788028, "chapter_id": 20788, "verse_number": "६-१३१-२९", "content_sanskrit": "तेषां दर्शनमात्रेण भक्त्या वा भोजनेन वा ।\nपूजनेन च देवेशि वैकुंठं लभते ध्रुवम्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]