[{"id": 2047544, "chapter_id": 2052, "verse_number": "६-१०१-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2047545, "chapter_id": 2052, "verse_number": "६-१०१-१", "content_sanskrit": "आर्जुनं समरे शूरं विनिघ्नन्तं महारथान्।\nअलम्बुसः कथं युद्धे प्रत्ययुध्यत सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2047546, "chapter_id": 2052, "verse_number": "६-१०१-२", "content_sanskrit": "आर्श्यशृङ्गिं कथं चैव सौभद्रः परवीरहा।\nतन्ममाचक्ष्व तत्त्वेन यथावृत्तं स्म संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2047547, "chapter_id": 2052, "verse_number": "६-१०१-३", "content_sanskrit": "धनंजयश्च किं चक्रे मम सैन्येषु संयुगे ।\nभीमो वा रथिनां श्रेष्ठो राक्षसो वा घटोत्कचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2047548, "chapter_id": 2052, "verse_number": "६-१०१-४", "content_sanskrit": "नकुलः सहदेवो वा सात्यकिर्वा महारथः ।\nएतदाचक्ष्व मे सत्यं कुशलो ह्यसि सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2047549, "chapter_id": 2052, "verse_number": "६-१०१-५x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2047550, "chapter_id": 2052, "verse_number": "६-१०१-५", "content_sanskrit": "हन्ते तेऽहं प्रवक्ष्यामि संग्रामं रोमहर्षणम्।\nयथाऽभूद्राक्षसेन्द्रस्य सौभद्रस्य च मारिष ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2047551, "chapter_id": 2052, "verse_number": "६-१०१-६", "content_sanskrit": "अर्जुनश्च यथा सङ्ख्ये भीमसेनश्च पाण्डवः ।\nनकुलः सहदेवश्च रणे चक्रुः पराक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2047552, "chapter_id": 2052, "verse_number": "६-१०१-७", "content_sanskrit": "तथैव तावकाः सर्वे भीष्मद्रोणपुरःसराः।\nअद्भुतानि विचिन्राणि चक्रुः कर्माण्यभीतवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2047553, "chapter_id": 2052, "verse_number": "६-१०१-८", "content_sanskrit": "अलम्बुसस्तु समरे अभिमन्युं महारथम् ।\nविनद्य सुमहानादं तर्जयित्वा मुहुर्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2047554, "chapter_id": 2052, "verse_number": "६-१०१-९", "content_sanskrit": "अभिदुद्राव वेगेन तिष्ठतिष्ठेति चाब्रवीत् ।\nअभिमन्युश्च वेगेन सिंहवद्विनदन्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2047555, "chapter_id": 2052, "verse_number": "६-१०१-१०", "content_sanskrit": "आर्श्यशृङ्गिं महेष्वासि पितुरत्यन्तवैरिणम् ।\nततः समीपतुः सङ्ख्ये त्वरितौ नरराक्षसौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2047556, "chapter_id": 2052, "verse_number": "६-१०१-११", "content_sanskrit": "रथाभ्यां रथिनौ श्रेष्ठौ यथा वै देवदानवौ ।\nमायावा राक्षसश्रेष्ठो दिव्यास्त्रश्चैव फाल्गुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2047557, "chapter_id": 2052, "verse_number": "६-१०१-१२", "content_sanskrit": "ततः कर्ष्णिर्महाराज निशितैः सायकैस्त्रिभिः।\nआर्श्यशृङ्गिं रणे विद्ध्वा पुनर्विव्याव पञ्चभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2047558, "chapter_id": 2052, "verse_number": "६-१०१-१३", "content_sanskrit": "अलम्बुरोऽपि संक्रुद्धः कार्ष्णि नवभिराशुगैः ।\nहृदि विव्याध वेगेन तोत्रैरिव महाद्विपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2047559, "chapter_id": 2052, "verse_number": "६-१०१-१४", "content_sanskrit": "ततः शरसहस्रेण क्षिप्रकारी निशाचरः ।\nअर्जुनास सुतं सङ्ख्ये पीडयामास भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2047560, "chapter_id": 2052, "verse_number": "६-१०१-१५", "content_sanskrit": "अभिमन्युस्ततः क्रुद्धो नवभिर्नतपर्वभिः ।\nबिभेद निशिसैर्बाणै राक्षसेन्द्रं महोरसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2047561, "chapter_id": 2052, "verse_number": "६-१०१-१६", "content_sanskrit": "ते तस्य विविशुस्तूर्णं कायं निर्भिद्य मर्मसु।\nस तैर्विभिन्नसर्वाङ्गः शुशुभे राक्षसोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2047562, "chapter_id": 2052, "verse_number": "६-१०१-१७", "content_sanskrit": "पुष्पितैः किंशुकै राजन्संस्तीर्ण इव पर्वतः ।\nस संदधानश्च शरान्हेमपुङ्खान्महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2047563, "chapter_id": 2052, "verse_number": "६-१०१-१८", "content_sanskrit": "विबभौ राक्षसश्रेष्ठः सज्वाल इव पर्वतः ।\nततः क्रुद्धो महाराज आर्श्यशृङ्गिरमर्षणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2047564, "chapter_id": 2052, "verse_number": "६-१०१-१९", "content_sanskrit": "महेन्द्रप्रतिमं कार्ष्णि छादयामास पत्रिभिः ।\nतेन ते विशिखा मुक्ता यमदण्डोपमाः शिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2047565, "chapter_id": 2052, "verse_number": "६-१०१-२०", "content_sanskrit": "अभिमन्युं विनिर्भिद्य प्राविशन्त धरातलम् ।\nतथैवार्जुनिना मुक्ताः शराः कनकभूषणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2047566, "chapter_id": 2052, "verse_number": "६-१०१-२१", "content_sanskrit": "अलम्बुसं विनिर्भिद्य प्राविशन्त धरातलम् ।\nसौभद्रस्तु रणे रक्षः शरैः सन्नतपर्वभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2047567, "chapter_id": 2052, "verse_number": "६-१०१-२२", "content_sanskrit": "चक्रे विमुखमासाद्य बलं शक्र इवाहवे ।\nविमुखं च रणे रक्षो वध्यमानं रणेऽरिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2047568, "chapter_id": 2052, "verse_number": "६-१०१-२३", "content_sanskrit": "प्रादुश्चक्रे महामायां तामसीमरिघातिनीम् ।\nततस्ते तमसा सर्वे वृताश्चासन्महीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2047569, "chapter_id": 2052, "verse_number": "६-१०१-२४", "content_sanskrit": "नाभिमन्युमपश्यन्त नैव स्वान्न परान्रणे ।\nअभिमन्युश्च तदृष्ट्वा घोररूपं महत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2047570, "chapter_id": 2052, "verse_number": "६-१०१-२५", "content_sanskrit": "प्रादुश्चक्रेऽस्त्रमत्सुग्रं भास्करं कुरुनन्दनः ।\nततः प्रकाशमभवज्जगत्सर्वं महीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2047571, "chapter_id": 2052, "verse_number": "६-१०१-२६", "content_sanskrit": "तां चाभिजघ्निवान्मायां राक्षसस्य दुरात्मनः ।\nसंक्रुद्धश्च महावीर्यो राक्षसेन्द्रं नरोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2047572, "chapter_id": 2052, "verse_number": "६-१०१-२७", "content_sanskrit": "छादयामास समरे शरैः सन्नतपर्वभिः।\nबह्वीस्तथाऽन्या मायाश्च प्रयुक्तास्तेन रक्षसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2047573, "chapter_id": 2052, "verse_number": "६-१०१-२८", "content_sanskrit": "सर्वास्त्रविदमेयात्मा वारयामास फाल्गुनिः।\nहतमायं ततो रक्षो वध्यमानं च सायकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2047574, "chapter_id": 2052, "verse_number": "६-१०१-२९", "content_sanskrit": "रथं तत्रैव संत्यज्य प्राद्रवन्महतो भयात्।\nतस्मिन्विनिर्जिते तूर्णं कूटयोधिनि राक्षसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2047575, "chapter_id": 2052, "verse_number": "६-१०१-३०", "content_sanskrit": "आर्जुनिः समरे सैन्यं तावकं संममर्द ह।\nमदान्धो वन्यनागेन्द्रः सपद्मां पद्मिनीमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2047576, "chapter_id": 2052, "verse_number": "६-१०१-३१", "content_sanskrit": "ततः शान्तनवो भीष्मः सैन्यं दृष्ट्वाऽभिविद्रुतम्।\nमहता शरवर्षेण सौभद्रं पर्यवारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2047577, "chapter_id": 2052, "verse_number": "६-१०१-३२", "content_sanskrit": "कोष्ठीकृत्य च तं वीरं धार्तराष्ट्रा महारथः ।\nएवं सुबहवो युद्धे ततक्षुः सायकैर्दृढम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2047578, "chapter_id": 2052, "verse_number": "६-१०१-३३", "content_sanskrit": "स तेषां रथिनां वीरः पितुस्तुल्यपराक्रमः ।\nसदृशो वासुदेवस्य विक्रमेण बलेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2047579, "chapter_id": 2052, "verse_number": "६-१०१-३४", "content_sanskrit": "उभयोः सदृशं कर्म स पितुर्मातुलस्य च ।\nरणे बहुविधं चक्रे सर्वशस्त्रभृतां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2047580, "chapter_id": 2052, "verse_number": "६-१०१-३५", "content_sanskrit": "ततो धनञ्जयो वीरो विनिघ्नंस्तव सैनिकान् ।\nआससाद रणे भीष्मं पुत्रप्रेप्सुरमर्षणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2047581, "chapter_id": 2052, "verse_number": "६-१०१-३६", "content_sanskrit": "तथैव समरे राजन्पिता देवव्रतस्तव ।\nआससाद रणे पार्थं स्वर्भानुरिव भास्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2047582, "chapter_id": 2052, "verse_number": "६-१०१-३७", "content_sanskrit": "ततः सरथनागाश्वाः पुत्रास्तव जनेश्वर ।\nपरिवव्रू रणे भीष्मं जुगुपुश्च समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2047583, "chapter_id": 2052, "verse_number": "६-१०१-३८", "content_sanskrit": "तथैव पाण्डवा राजन्परिवार्य धनञ्जयम् ।\nरणाय महते युक्ता दंशिता भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2047584, "chapter_id": 2052, "verse_number": "६-१०१-३९", "content_sanskrit": "शारद्वतस्ततो राजन्भीष्मस्य प्रमुखे स्थितम् ।\nअर्जुनं पञ्चविंशत्या सायकानां समाचिनोत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2047585, "chapter_id": 2052, "verse_number": "६-१०१-४०", "content_sanskrit": "प्रत्युद्गम्याथ विव्याध सात्यकिस्तं शितैः शरैः ।\nपाण्डवप्रियकामार्थं शार्दूल इव कुञ्जरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2047586, "chapter_id": 2052, "verse_number": "६-१०१-४१", "content_sanskrit": "गौतमोऽपि त्वरायुक्तो माधवं नवभिः शरैः ।\nहृदि विव्याध संक्रुद्धः कङ्कपत्रपरिच्छदैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2047587, "chapter_id": 2052, "verse_number": "६-१०१-४२", "content_sanskrit": "शैनेयोऽपि ततः क्रुद्धश्चापमानम्य वेगवान् ।\nगौतमान्तकरं तूर्णं समाधत्त शिलीमुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2047588, "chapter_id": 2052, "verse_number": "६-१०१-४३", "content_sanskrit": "तमापतन्तं वेगेन शक्राशनिसमद्युतिम् ।\nद्विधा चिच्छेद संक्रुद्धो द्रौणिः परमकोपनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2047589, "chapter_id": 2052, "verse_number": "६-१०१-४४", "content_sanskrit": "समुत्सृज्याथ शैनेयो गौतमं रथिनां वरः ।\nअभ्यद्रवद्रणे द्रौणिं राहुः खे शशिनं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2047590, "chapter_id": 2052, "verse_number": "६-१०१-४५", "content_sanskrit": "तस्य द्रोणसुतश्चापं द्विधा चिच्छेद भारत।\nअथैनं छिन्नधन्वानं ताडयामास सायकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2047591, "chapter_id": 2052, "verse_number": "६-१०१-४६", "content_sanskrit": "सोऽन्यत्कार्मुकमादाय शत्रुघ्नं भारसाधनम् ।\nद्रौणिं षष्ट्या महाराज बाह्वोरुरसि चार्पयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2047592, "chapter_id": 2052, "verse_number": "६-१०१-४७", "content_sanskrit": "स विद्धो व्यथितश्चैव मुहूर्तं कश्मलायुतः।\nनिषसाद रथोपस्थे ध्वजयष्टिं समाश्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2047593, "chapter_id": 2052, "verse_number": "६-१०१-४८", "content_sanskrit": "प्रतिलभ्य ततः संज्ञां द्रोणपुत्रः प्रतापवान् ।\nवार्ष्णेयं समरे क्रुद्धो नाराचेन समार्पयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2047594, "chapter_id": 2052, "verse_number": "६-१०१-४९", "content_sanskrit": "शैनेयं स तु निर्भिद्य प्राविशद्धरणीतलम् ।\nवसन्तकाले बलवान्बिलं सर्पशिशुर्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2047595, "chapter_id": 2052, "verse_number": "६-१०१-५०", "content_sanskrit": "अथापरेण भल्लेन माधवस्य ध्वजोत्तमम् ।\nचिच्छेद समरे द्रौणिः सिंहनादं मुमोच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2047596, "chapter_id": 2052, "verse_number": "६-१०१-५१", "content_sanskrit": "पुनश्चैनं शरैर्घोरैश्छादयामास भारत।\nनिदाघान्ते महाराज यथा मेघो दिवाकरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2047597, "chapter_id": 2052, "verse_number": "६-१०१-५२", "content_sanskrit": "सात्यकोऽपि महाराज शरजालं निहत्य तत्।\nद्रौणिमभ्याकिरत्तूर्णं शरजालैरनेकधा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2047598, "chapter_id": 2052, "verse_number": "६-१०१-५३", "content_sanskrit": "तापयामास च द्रौणिं शैनेयः परवारहा ।\nविमुक्तो मेघजालेन यथैव तपनस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2047599, "chapter_id": 2052, "verse_number": "६-१०१-५४", "content_sanskrit": "शराणां च सहस्रेण पुनरेव समुद्यतः ।\nसात्यकिश्छादयामास ननाद च महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2047600, "chapter_id": 2052, "verse_number": "६-१०१-५५", "content_sanskrit": "दृष्ट्वा पुत्रं च तं ग्रस्तं राहुणेव निशाकरम् ।\nअभ्यद्रवत शैनेयं भारद्वाजः प्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2047601, "chapter_id": 2052, "verse_number": "६-१०१-५६", "content_sanskrit": "विव्याध च सुतीक्ष्णेन पृषत्केन महामृधे ।\nपरीप्सन्खसुतं राजन्वार्ष्णेयेनाभिपीडितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2047602, "chapter_id": 2052, "verse_number": "६-१०१-५७", "content_sanskrit": "सात्यकिस्तु रणे हित्वा गुरुपुत्रं महारथम् ।\nद्रोणं विव्याध विंशत्या सर्वपारशवैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2047603, "chapter_id": 2052, "verse_number": "६-१०१-५८", "content_sanskrit": "तदन्तरममेयात्मा कौन्तेयः शत्रुतापनः ।\nअभ्यद्रवद्रणे क्रुद्धो द्रोणं प्रति महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2047604, "chapter_id": 2052, "verse_number": "६-१०१-५९", "content_sanskrit": "ततो द्रोणश्च पार्थश्च समेयातां महामृधे ।\nयथा बुधश्च शुक्रश्च महाराज नभस्तले ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2047605, "chapter_id": 2052, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि नवमदिवसयुद्धे एकाधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]