[{"id": 2093828, "chapter_id": 3006, "verse_number": "१३-१३६-१", "content_sanskrit": "भीष्म उवाच।\nयमस्तु यानि श्राद्धानि प्रोवाच शशबिन्दवे।\nतानि मे शृणु काम्यानि नक्षत्रेषु पृथक्पृथक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2093829, "chapter_id": 3006, "verse_number": "१३-१३६-२", "content_sanskrit": "श्राद्धं यः कृत्तिकायोगे कुर्वीत सततं नरः।\nअग्नीनाधाय सापत्यो यजेत विगतज्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2093830, "chapter_id": 3006, "verse_number": "१३-१३६-३", "content_sanskrit": "अपत्यकामो रोहिण्यां तेजस्कामो मृगोत्तमे।\nक्रूरकर्मा ददच्छ्राद्धमार्द्रायां मानवो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2093831, "chapter_id": 3006, "verse_number": "१३-१३६-४", "content_sanskrit": "कृषिभागी भवेन्मर्त्यः कुर्वञ्श्राद्धं पुनर्वसौ।\nपुष्टिकामोऽथ पुष्येण श्राद्धमीहेत मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2093832, "chapter_id": 3006, "verse_number": "१३-१३६-५", "content_sanskrit": "आश्लेषायां ददच्छ्राद्धं धीरान्पुत्रान्प्रजायते।\nज्ञातीनां तु भवेच्छ्रेष्ठो मघासु श्राद्धमावपन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2093833, "chapter_id": 3006, "verse_number": "१३-१३६-६", "content_sanskrit": "फल्गुनीषु ददच्छ्राद्धं सुभगः श्राद्धदो भवेत्।\nअपत्यभागुत्तरासु हस्तेन फलभाग्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2093834, "chapter_id": 3006, "verse_number": "१३-१३६-७", "content_sanskrit": "चित्रायां तु ददच्छ्राद्धं लभेद्रूपवतः सुतान्।\nस्वातियोगे पितॄनर्च्य वाणिज्यमुपजीवति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2093835, "chapter_id": 3006, "verse_number": "१३-१३६-८", "content_sanskrit": "बहुपुत्रो विशाखासु पुत्रमीनहन्भवेन्नरः।\nअनुराधासु कुर्वाणो राज्यचक्रं प्रवर्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2093836, "chapter_id": 3006, "verse_number": "१३-१३६-९", "content_sanskrit": "आधिपत्यं व्रजेन्मर्त्यो ज्येष्ठायामपवर्जयन्।\nनरः कुरुकुलश्रेष्ठ ऋद्धो दमपुरःसरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2093837, "chapter_id": 3006, "verse_number": "१३-१३६-१०", "content_sanskrit": "मूले त्वारोग्यमृच्छेत यशोऽषाढासु चोत्तमम्।\nउत्तरासु त्वषाढासु वीतशोकश्चरेन्महीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2093838, "chapter_id": 3006, "verse_number": "१३-१३६-११", "content_sanskrit": "श्राद्धं त्वभिजितौ कुर्वन्विद्यां श्रेष्ठामवाप्नुयात्।\nश्रवणेषु ददच्छ्राद्धं प्रेत्य गच्छेत्स तद्गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2093839, "chapter_id": 3006, "verse_number": "१३-१३६-१२", "content_sanskrit": "राज्यभागी धनिष्ठायां भवेत नियतं नरः।\nनक्षत्रे वारुणे कुर्वन्भिषक्सिद्धिमवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2093840, "chapter_id": 3006, "verse_number": "१३-१३६-१३", "content_sanskrit": "पूर्वप्रोष्ठपदाः कुर्वन्बहून्विन्दत्यजाविकान्।\nउत्तरासु प्रकुर्वाणो विन्दो गाः सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2093841, "chapter_id": 3006, "verse_number": "१३-१३६-१४", "content_sanskrit": "बहुकुप्यकृतं वित्तं विन्दते रेवतीं श्रितः।\nअश्विनीष्वश्वान्विन्देत भरणीष्वायुरुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2093842, "chapter_id": 3006, "verse_number": "१३-१३६-१५", "content_sanskrit": "इमं श्राद्धविधिं श्रुत्वा शशबिन्दुस्तथाऽकरोत्।\nअक्लेसेनाजयच्चापि महीं सोऽनुशशास ह॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2093843, "chapter_id": 3006, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि षट्त्रिंशदधिकशततमोऽध्यायः॥ १३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]