[{"id": 7000883000, "chapter_id": 20883, "verse_number": "६-२२६-१", "content_sanskrit": "शंकर उवाच ।\nन्यासेवाप्यर्चने वापि मंत्रमेकांतिनः श्रयेत् ।\nअवैष्णवोपदिष्टेन मंत्रेण न परा गतिः ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000883001, "chapter_id": 20883, "verse_number": "६-२२६-२", "content_sanskrit": "अवैष्णवोपदिष्टंचेत्पूर्वमंत्रवरंद्वयम् ।\nपुनश्च विधिना सम्यक्वैष्णवाद्ग्राहयेद्गुरोः ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000883002, "chapter_id": 20883, "verse_number": "६-२२६-३", "content_sanskrit": "सहस्रशाखाध्यायी वा सर्वयज्ञेषु दीक्षितः ।\nकुले महति जातोऽपि न गुरुः स्यादवैष्णवः ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000883003, "chapter_id": 20883, "verse_number": "६-२२६-४", "content_sanskrit": "यस्तु मंत्रद्वयं सम्यगध्यापयति वैष्णवः ।\nस आचार्यस्तु विज्ञेयो भवबंधविदारकः ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000883004, "chapter_id": 20883, "verse_number": "६-२२६-५", "content_sanskrit": "आचार्यं संश्रयित्वाथ वत्सरं सेवयेद्दिवजः ।\nतस्य वृत्तिं परिज्ञात्वा मंत्रमध्यापयेद्गुरुः ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000883005, "chapter_id": 20883, "verse_number": "६-२२६-६", "content_sanskrit": "कृत्वा तापादिसंस्कारान्पश्चान्मंत्रमुदीरयेत् ।\nतापं पुंड्रं तथा नाम कृत्वा वै विधिना गुरुः ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000883006, "chapter_id": 20883, "verse_number": "६-२२६-७", "content_sanskrit": "पश्चादध्यापयेन्मंत्रं शिष्यं निर्मलचेतसम् ।\nचक्रेण विधिना तप्तं ताप इत्यभिधीयते ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000883007, "chapter_id": 20883, "verse_number": "६-२२६-८", "content_sanskrit": "पुंड्रमूर्द्ध्वं तथा प्रोक्तं नाम वैष्णवमुच्यते ।\nततो मंत्रं विधानेन शिष्यमध्यापयेद्गुरुः ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000883008, "chapter_id": 20883, "verse_number": "६-२२६-९", "content_sanskrit": "न्यासमष्टाक्षरं मंत्रमन्यं वा वैष्णवं मनुम् ।\nन्यासमेवात्र परमं वैष्णवानां शुभानने ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000883009, "chapter_id": 20883, "verse_number": "६-२२६-१०", "content_sanskrit": "तस्मात्तु न्यासमेवैषामतिरिक्तमिहोच्यते ।\nन्यासविद्यापरो यस्तु ब्राह्मणः श्रेष्ठ उच्यते ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000883010, "chapter_id": 20883, "verse_number": "६-२२६-११", "content_sanskrit": "न्यासात्परतरं नास्ति मन्त्रं सत्यं ब्रवीमि ते ।\nन्यासं द्वयं प्रपत्तिः स्यात्पर्यायेण निबोध मे ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000883011, "chapter_id": 20883, "verse_number": "६-२२६-१२", "content_sanskrit": "द्वयोपदेशपूर्वं तु सर्वकर्मसमाचरेत् ।\nद्वयाधिकारी न भवेत्सर्वकर्मसु नार्हति ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000883012, "chapter_id": 20883, "verse_number": "६-२२६-१३", "content_sanskrit": "तस्माद्वयमधीत्येव पश्चान्मंत्रमनुत्तमम् ।\nश्रीमदष्टाक्षरं सम्यगभ्यसेद्दिवजसत्तमः ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000883013, "chapter_id": 20883, "verse_number": "६-२२६-१४", "content_sanskrit": "मंत्रमष्टाक्षरं प्रोक्तं प्रणवस्यैव संग्रहात् ।\nनैसर्गप्रणवाद्यन्तु मंत्रमित्युच्यतेबुधैः ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000883014, "chapter_id": 20883, "verse_number": "६-२२६-१५", "content_sanskrit": "नान्यत्र सर्वमंत्रेषु प्रणवस्वस्वभावतः ।\nपूर्वं तु सर्वमंत्राणां योजयेत्प्रणवं शुभम् ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000883015, "chapter_id": 20883, "verse_number": "६-२२६-१६", "content_sanskrit": "ओंकारः प्रणवं ब्रह्म सर्वमंत्रेषु नायकः ।\nआदौ सर्वत्र युंजीत मंत्राणां तु शुभानने ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000883016, "chapter_id": 20883, "verse_number": "६-२२६-१७", "content_sanskrit": "स्वभावात्प्रणवन्तस्मिन्मूलमंत्रे प्रतिष्ठितम् ।\nओमित्येकाक्षरं पूर्वं द्व्यक्षरं नम इत्यथ ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000883017, "chapter_id": 20883, "verse_number": "६-२२६-१८", "content_sanskrit": "ततो नारायणायेति पंचार्णानि यथाक्रमम् ।\nएवमष्टाक्षरो मंत्रो ज्ञेयः सर्वार्थसाधकः ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000883018, "chapter_id": 20883, "verse_number": "६-२२६-१९", "content_sanskrit": "सर्वदुःखहरः श्रीमान्सर्वमंत्रात्मकः शुभः ।\nऋषिर्नारायणस्तस्य देवता श्रीश एव च ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000883019, "chapter_id": 20883, "verse_number": "६-२२६-२०", "content_sanskrit": "छंदस्तु देवी गायत्री प्रणवो बीजमुच्यते ।\nनित्यानपायिनी देवी शक्तिः श्रीरुच्यते मनोः ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000883020, "chapter_id": 20883, "verse_number": "६-२२६-२१", "content_sanskrit": "प्रथमं पदमोङ्कार द्वितीयं नम उच्यते ।\nतृतीयं नारायणायेति पदत्रयमुदाहृतम् ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000883021, "chapter_id": 20883, "verse_number": "६-२२६-२२", "content_sanskrit": "अकारश्चाप्युकारश्च मकारश्च ततः परम् ।\nवेदत्रयात्मकं प्रोक्तं प्रणवं ब्रह्मणः पदम् ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000883022, "chapter_id": 20883, "verse_number": "६-२२६-२३", "content_sanskrit": "अकारेणोच्यते विष्णुः श्रीरुकारेण चोच्यते ।\nमकारस्त्वनयोर्दासः पंचविंशः प्रकीर्तितः ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000883023, "chapter_id": 20883, "verse_number": "६-२२६-२४", "content_sanskrit": "वासुदेवस्वरूपं तदकारेणोच्यतै बुधैः ।\nउकारेण श्रियो देव्या रूपं मुनिभिरुच्यते ॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000883024, "chapter_id": 20883, "verse_number": "६-२२६-२५", "content_sanskrit": "मकारेणोच्यते जीवः पंचविंशोदितः पुमान् ।\nभूतानि च कवर्गेण चवर्गणेन्द्रियाणि च ॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000883025, "chapter_id": 20883, "verse_number": "६-२२६-२६", "content_sanskrit": "ट वर्गेण तवर्गेण ज्ञानं धादयस्तथा ।\nमनः पकारेणैवोक्तं फकारेण त्वहंकृतिः ॥२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000883026, "chapter_id": 20883, "verse_number": "६-२२६-२७", "content_sanskrit": "बकारेण भकारेण महान्प्रकृतिरुच्यते ।\nआत्मा तु समकारः स्यात्पंचविंशः प्रकीर्तितः ॥२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000883027, "chapter_id": 20883, "verse_number": "६-२२६-२८", "content_sanskrit": "देहेंद्रियमनः प्राणादिभ्योन्योऽनन्यसाधनः ।\nभगवच्छेषभूतोऽसौ मकाराख्यः स चेतनः ॥२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000883028, "chapter_id": 20883, "verse_number": "६-२२६-२९", "content_sanskrit": "अवधारणवाच्येवमुकारः कैश्चिदुच्यते ।\nश्रीतत्वमपि तत्पक्षे वकारेणैव चोच्यते ॥२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000883029, "chapter_id": 20883, "verse_number": "६-२२६-३०", "content_sanskrit": "भास्करस्य प्रभा यद्वत्तस्य नित्यानपायिनी ।\nआकारेणोच्यते विष्णुः कल्याणगुणसागरः ॥३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000883030, "chapter_id": 20883, "verse_number": "६-२२६-३१", "content_sanskrit": "श्रीशः सर्वात्मनां शेषो जगद्बीजं परः पुमान् ।\nजगत्कर्त्ता जगद्भर्त्ता ईश्वरो लोकबांधवः ॥३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000883031, "chapter_id": 20883, "verse_number": "६-२२६-३२", "content_sanskrit": "जगतामीश्वरी नित्या विष्णोरनपगामिनी ।\nमाता सर्वस्य जगतः पत्नी विष्णोर्मनोरमा ॥३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000883032, "chapter_id": 20883, "verse_number": "६-२२६-३३", "content_sanskrit": "जगदाधारभूता श्रीरुकारेणात्र चोच्यते ।\nमकारेण तयोर्दासः क्षेत्रज्ञः प्रोच्यते बुधैः ॥३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000883033, "chapter_id": 20883, "verse_number": "६-२२६-३४", "content_sanskrit": "ज्ञानाश्रमो ज्ञानगुणश्चेतनः प्रकृतेः परः ।\nन जडो निर्विकारश्च एकरूप स्वरूपभाक् ॥३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000883034, "chapter_id": 20883, "verse_number": "६-२२६-३५", "content_sanskrit": "अणुर्नित्यो व्याप्तिशीलश्चिदानंदात्मकस्तथा ।\nअहमर्थोऽव्ययः क्षेत्री भिन्नरूपं सनातनः ॥३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000883035, "chapter_id": 20883, "verse_number": "६-२२६-३६", "content_sanskrit": "अदाह्योच्छेद्यो ह्यक्लैद्यस्त्वशोष्योक्षर एव च ।\nएवमादिगुणोपेतश्शेषभूतः परस्य वै ॥३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000883036, "chapter_id": 20883, "verse_number": "६-२२६-३७", "content_sanskrit": "मकारेणोच्यते जीवः क्षेत्रज्ञः परवान्सदा ।\nदासभूतो हरेरेव नान्यस्य तु कदाचन ॥३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000883037, "chapter_id": 20883, "verse_number": "६-२२६-३८", "content_sanskrit": "एवं दासत्वमेवास्य मध्यमेवावधार्यते ।\nइत्येवं प्रणवस्यार्थो ज्ञातव्योक्तो मयानघे ॥३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000883038, "chapter_id": 20883, "verse_number": "६-२२६-३९", "content_sanskrit": "विवृतिः प्रणवस्यार्थ मन्त्रशेषेण वै शुभे ।\nपरस्य दासभूतस्य स्वातन्त्र्यं नेह विद्यते ॥३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000883039, "chapter_id": 20883, "verse_number": "६-२२६-४०", "content_sanskrit": "तस्मान्महदहंकारौ मनसा विनिवर्त्तयेत् ।\nस्वोपायबुद्ध्या यत्कृत्यं तदपि प्रतिषिध्यते ॥४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000883040, "chapter_id": 20883, "verse_number": "६-२२६-४१", "content_sanskrit": "अहंकृतिर्मकारः स्यान्नकारस्तन्निषेधकः ।\nतस्मात्तु मनसैवास्य अहंकारविमोचनम् ॥४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000883041, "chapter_id": 20883, "verse_number": "६-२२६-४२", "content_sanskrit": "मनसा सर्वसिद्धिः स्यादन्यथा नाशमाप्नुयात् ।\nनमसा सहितं किंचित्तदहंकार उच्यते ॥४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000883042, "chapter_id": 20883, "verse_number": "६-२२६-४३", "content_sanskrit": "अहंकारेण युक्तस्य सुखं किंचिन्न विद्यते ।\nअहंकारविमूढात्मा अंधे तमसि मज्जति ॥४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000883043, "chapter_id": 20883, "verse_number": "६-२२६-४४", "content_sanskrit": "तस्मान्न मनसा चात्र स्वातंत्र्यं प्रतिषिध्यते ।\nभगवत्परतंत्रोऽसौ तदायत्तश्च जीवति ॥४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000883044, "chapter_id": 20883, "verse_number": "६-२२६-४५", "content_sanskrit": "तस्मात्साधनकर्तृत्वं चेतनस्य न विद्यते ।\nईश्वरस्यैव संकल्पाद्वर्त्तते स्वचराचरम् ॥४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000883045, "chapter_id": 20883, "verse_number": "६-२२६-४६", "content_sanskrit": "तस्मात्स्वसामर्थ्यविधिं त्यजेत्सर्वमशेषतः ।\nईश्वरस्य तु सामर्थ्यान्नालभ्यं तस्य विद्यते ॥४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000883046, "chapter_id": 20883, "verse_number": "६-२२६-४७", "content_sanskrit": "तस्मिन्न्यस्तभरः श्रीशे तत्कर्मैव समाचरेत् ।\nपरमात्मा हरिस्स्वामी स्वमहं तस्य सर्वदा ॥४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000883047, "chapter_id": 20883, "verse_number": "६-२२६-४८", "content_sanskrit": "इच्छाया विनियोक्तव्यस्तस्यैवात्मेश्वरस्य हि ।\nइत्येवं मनसा त्यक्तमहंता ममतोर्जितम् ॥४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000883048, "chapter_id": 20883, "verse_number": "६-२२६-४९", "content_sanskrit": "देहेष्वहं मतिर्मूलं संसृतौ कर्मबंधने ।\nतस्मान्महदहंकारौ मनसा वर्जयेद्बुधः ॥४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000883049, "chapter_id": 20883, "verse_number": "६-२२६-५०", "content_sanskrit": "अथ नारायणपदं वक्ष्यामि गिरजे शुभे ।\nनारा इत्यात्मनां संघास्तेषां गतिरसौ पुमान् ॥५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000883050, "chapter_id": 20883, "verse_number": "६-२२६-५१", "content_sanskrit": "त एव चायनं तस्य तस्मान्नारायणः स्मृतः ।\nसर्वं हि चिदचिद्वस्तु श्रूयते दृश्यते जगत् ॥५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000883051, "chapter_id": 20883, "verse_number": "६-२२६-५२", "content_sanskrit": "योऽसौ व्याप्यस्थितो नित्यं स वै नारायणः स्मृतः ।\nनाराश्चेति सर्वपुंसां समूहाः परिकीर्तिताः ॥५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000883052, "chapter_id": 20883, "verse_number": "६-२२६-५३", "content_sanskrit": "गतिरालंबनं तेषां तस्मान्नारायणः स्मृतः ।\nनराज्जातानि तत्वानि नाराणीति विदुर्बुधाः ॥५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000883053, "chapter_id": 20883, "verse_number": "६-२२६-५४", "content_sanskrit": "तान्येव चायनं तस्य तेन नारायणस्स्मृतः ।\nकल्पांतेपि जगत्कृत्स्नं ग्रसित्वा येन धार्यते ॥५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000883054, "chapter_id": 20883, "verse_number": "६-२२६-५५", "content_sanskrit": "पुनः संसृज्यते येन स वै नारायणः स्मृतः ।\nचराचरं जगत्कृत्स्नं नार इत्यभि धीयते ॥५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000883055, "chapter_id": 20883, "verse_number": "६-२२६-५६", "content_sanskrit": "तस्य वासं गतिर्येन तेन नारायणः स्मृतः ।\nनारो नराणां संघातस्तस्यासावयनं गतिः ॥५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000883056, "chapter_id": 20883, "verse_number": "६-२२६-५७", "content_sanskrit": "तेनासौ मुनिभिर्नित्यं नारायण इतीरितः ।\nप्रभवन्ति यतो लोका महाब्धौ पृथुफेनवत् ॥५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000883057, "chapter_id": 20883, "verse_number": "६-२२६-५८", "content_sanskrit": "पुनर्यस्मात्प्रलीयन्ते तस्मान्नारायणः स्मृतः ।\nयो वै नित्यपदे नित्यो नित्यमुक्तैकभोगवान् ॥५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000883058, "chapter_id": 20883, "verse_number": "६-२२६-५९", "content_sanskrit": "ईशः सर्वस्य जगतः स वै नारायणः स्मृतः ।\nनारायणः परंब्रह्म तत्वं नारायणः परम् ॥५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000883059, "chapter_id": 20883, "verse_number": "६-२२६-६०", "content_sanskrit": "यच्च किंचिज्जगत्यस्मिन्दृश्यते श्रूयतेऽपि वा ।\nअंतर्बंहिश्च तत्सर्वं व्याप्य नारायणः स्थितः ॥६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000883060, "chapter_id": 20883, "verse_number": "६-२२६-६१", "content_sanskrit": "अपहतपाप्मा पुरुषः सर्वभूतांतरस्थितः ।\nदिव्यएकस्सदा नित्यो हरिर्नारायणोऽच्युतः ॥६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000883061, "chapter_id": 20883, "verse_number": "६-२२६-६२", "content_sanskrit": "यस्तु द्रष्टा च द्रष्टव्यं श्रोता श्रोतव्यमेव च ।\nस्प्रष्टा च स्पर्शितव्यश्च ध्याता ध्यातव्यमेव च ॥६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000883062, "chapter_id": 20883, "verse_number": "६-२२६-६३", "content_sanskrit": "वक्ता च वाच्यं ज्ञाता च ज्ञातव्यं चिदचिज्जगत् ।\nतच्च सर्वं हरिः श्रीशो नारायण उदाहृतः ॥६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000883063, "chapter_id": 20883, "verse_number": "६-२२६-६४", "content_sanskrit": "सहस्रशीर्षा पुरुषः सहस्राक्षः सहस्रपात् ।\nस लोकान्सर्वतो व्याप्य अत्यतिष्ठद्दशांगुलम् ॥६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000883064, "chapter_id": 20883, "verse_number": "६-२२६-६५", "content_sanskrit": "यद्भूतं यच्च भव्यं तत्सर्वं नारायणो हरिः ।\nउतामृतत्वस्येशानो यदन्नेन विराट्पुमान् ॥६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000883065, "chapter_id": 20883, "verse_number": "६-२२६-६६", "content_sanskrit": "स एव पुरुषो विष्णुर्वासुदेवोऽच्युतो हरिः ।\nहिरण्मयोऽथ भगवान्सोऽमृतः शाश्वतः शिवः ॥६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000883066, "chapter_id": 20883, "verse_number": "६-२२६-६७", "content_sanskrit": "पतिर्विश्वस्य जगतः सर्वलोकेश्वरं प्रभुः ।\nहिरण्यगर्भाः सविता अनंतोऽसौ महेश्वरः ॥६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000883067, "chapter_id": 20883, "verse_number": "६-२२६-६८", "content_sanskrit": "भगवानिति शब्दोऽयं तथा पुरुष इत्यपि ।\nवर्त्तते निरुपाधिश्च वासुदेवोऽखिलात्मनि ॥६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000883068, "chapter_id": 20883, "verse_number": "६-२२६-६९", "content_sanskrit": "ईश्वरो भगवान्विष्णुः परमात्मा जगत्सुहृत् ।\nशास्ता चराचरस्यैको यतीनां परमा गतिः ॥६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000883069, "chapter_id": 20883, "verse_number": "६-२२६-७०", "content_sanskrit": "यो वेदादौ स्वरः प्रोक्तो वेदांते च प्रतिष्ठितः ।\nतस्य प्रकृतिलीनस्य यः परः स महेश्वरः ॥७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000883070, "chapter_id": 20883, "verse_number": "६-२२६-७१", "content_sanskrit": "योसावकारो वै विष्णुर्योऽसौ नारायणो हरिः ।\nस एव पुरुषो नित्यः परमात्मा महेश्वरः ॥७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000883071, "chapter_id": 20883, "verse_number": "६-२२६-७२", "content_sanskrit": "यस्मादुद्भूतमैश्वर्यं यस्मिन्कस्मिंश्च वर्तते ।\nतस्मिन्नीश्वरशब्दोऽपि प्रोच्यते मुनिभिस्तथा ।\nनिरुपाधीश्वरत्वं हि वासुदेवे प्रतिष्ठितम् ॥७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000883072, "chapter_id": 20883, "verse_number": "६-२२६-७३", "content_sanskrit": "आत्मेश्वर इति प्रोक्तो वेदवादैः सनातनैः ।\nतस्मान्महेश्वरत्वं तु वासुदेवे प्रतिष्ठितम् ॥७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000883073, "chapter_id": 20883, "verse_number": "६-२२६-७४", "content_sanskrit": "असौ त्रिपाद्विभूतेस्तु लीलया अपि चेश्वरः ।\nविभूतिद्वयमैश्वर्यं तस्यैव सकलात्मनः ॥७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000883074, "chapter_id": 20883, "verse_number": "६-२२६-७५", "content_sanskrit": "श्रीभूनीलापतिर्योसावीश्वरस्स उदाहृतः ।\nतस्मात्सर्वेश्वरत्वं तु वासुदेवे प्रतिष्ठितम् ॥७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000883075, "chapter_id": 20883, "verse_number": "६-२२६-७६", "content_sanskrit": "असौ यज्ञेश्वरो यज्ञो यज्ञभुक्यज्ञकृद्विभुः ।\nयज्ञभुग्यज्ञपुरुषः स एव परमेश्वरः ॥७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000883076, "chapter_id": 20883, "verse_number": "६-२२६-७७", "content_sanskrit": "यज्ञेश्वरो हव्यसमस्तकव्यभोक्ता व्ययात्मा हरिरीश्वरोऽत्र ।\nतत्संनिधानादपयांति सद्यो रक्षांस्यशेषाण्यसुराश्च सर्वे ॥७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000883077, "chapter_id": 20883, "verse_number": "६-२२६-७८", "content_sanskrit": "योऽसौ विराट्त्वमापन्नो हरिर्भूतो जनार्दनः ।\nसंतर्पयति लोकांस्त्रीन्स एव परमेश्वरः ॥७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000883078, "chapter_id": 20883, "verse_number": "६-२२६-७९", "content_sanskrit": "येन पूर्णेन हविषा देवा यज्ञमतन्वत ।\nतस्माद्यज्ञात्समुत्पन्ना ये के चोभयादतः ॥७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000883079, "chapter_id": 20883, "verse_number": "६-२२६-८०", "content_sanskrit": "तस्माद्यज्ञात्सर्वहुत ऋचः सामानि जज्ञिरे ।\nतस्मादश्वा अजायंत गावश्च पुरुषादयः ॥८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000883080, "chapter_id": 20883, "verse_number": "६-२२६-८१", "content_sanskrit": "पुरुषस्य तनोरस्य सर्वयज्ञमयस्य वै ।\nहरेः सर्वं समुद्भूतं जगत्स्थावरजंगमम् ॥८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000883081, "chapter_id": 20883, "verse_number": "६-२२६-८२", "content_sanskrit": "मुखबाहूरुपादाः स्युस्तस्य वर्णा यथाक्रमम् ।\nपद्भ्यां तु पृथिवी तस्य शिरसा द्यौरजायत ॥८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000883082, "chapter_id": 20883, "verse_number": "६-२२६-८३", "content_sanskrit": "मनसश्चंद्रमा जातश्चक्षुषश्च प्रभाकरः ।\nमुखादग्निः सहस्राक्षो वायुः प्राणात्सदागतिः ॥८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000883083, "chapter_id": 20883, "verse_number": "६-२२६-८४", "content_sanskrit": "नाभेर्विरिंचिर्गगनं जगत्सर्वं चराचरम् ।\nयस्मात्सर्वं समुद्भूतं जगद्विष्णोः सनातनात् ॥८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000883084, "chapter_id": 20883, "verse_number": "६-२२६-८५", "content_sanskrit": "तस्मात्सर्वमयो विष्णुर्नारायण इतीरितः ।\nएवं सृष्ट्वा जगत्सर्वं पुनः संग्रसते हरिः ॥८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000883085, "chapter_id": 20883, "verse_number": "६-२२६-८६", "content_sanskrit": "निजलीलासमुद्भूतं तान्तवं चोर्णनाभिवत् ।\nब्रह्माणमिंद्रं रुद्रं च यमं वरुणमेव च ॥८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000883086, "chapter_id": 20883, "verse_number": "६-२२६-८७", "content_sanskrit": "निगृह्य हरते यस्मात्तस्माद्धरिरहोच्यते ।\nअसावेकार्णवीभूते मायावटतले पुमान् ॥८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000883087, "chapter_id": 20883, "verse_number": "६-२२६-८८", "content_sanskrit": "जगत्स्वजठरे कृत्वा शेते तस्मिन्सनातनः ।\nआसीदेको हि वै चात्र विष्णुर्नारायणोऽच्युतः ॥८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000883088, "chapter_id": 20883, "verse_number": "६-२२६-८९", "content_sanskrit": "न ब्रह्मा न च रुद्रश्च न देवा न महर्षयः ।\nनेमे द्यावापृथिव्यौ च न सोमो न च भास्करः ॥८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000883089, "chapter_id": 20883, "verse_number": "६-२२६-९०", "content_sanskrit": "न नक्षत्राणि लोकाश्च न चांडं महदावृतम् ।\nयस्माज्जगद्वृतं तेन सकलं हरिणा शुभे ॥९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000883090, "chapter_id": 20883, "verse_number": "६-२२६-९१", "content_sanskrit": "सृष्टं पुनस्तथा सर्गे तस्मान्नारायणस्स्मृतः ।\nतस्य दास्यं चतुर्थ्यानु मंत्रे प्रोक्तं तु पार्वति ॥९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000883091, "chapter_id": 20883, "verse_number": "६-२२६-९२", "content_sanskrit": "दासभूतमिदं तस्य ब्रह्माद्यं सकलं जगत् ।\nएवमर्थं विदित्वा वै पश्चान्मंत्रं प्रयोजयेत् ॥९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000883092, "chapter_id": 20883, "verse_number": "६-२२६-९३", "content_sanskrit": "अविदित्वा तु मन्त्रार्थं सिद्धिं नैवाधिगच्छति ।\nन तु भुक्तिं च भक्तिं च न च मुक्तिं वरानने ॥९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}]