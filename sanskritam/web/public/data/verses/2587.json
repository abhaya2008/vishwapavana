[{"id": 2075087, "chapter_id": 2587, "verse_number": "१२-९२-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2075088, "chapter_id": 2587, "verse_number": "१२-९२-१", "content_sanskrit": "कथं धर्मे स्थातुमिच्छन्राजा वर्तेत भारत।\nपृच्छामि त्वां कुरुश्रेष्ठ तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2075089, "chapter_id": 2587, "verse_number": "१२-९२-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2075090, "chapter_id": 2587, "verse_number": "१२-९२-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nगीतं दृष्टार्थतत्त्वेन वामदेवेन धीमता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2075091, "chapter_id": 2587, "verse_number": "१२-९२-३", "content_sanskrit": "राजा वसुमना नाम कौसल्यो बलवाञ्शुचिः।\nमहर्षि परिपप्रच्छ वामदेवं तपस्विनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2075092, "chapter_id": 2587, "verse_number": "१२-९२-४", "content_sanskrit": "धर्मार्थसहितैर्वाक्यैर्भगवन्ननुशाधि माम्।\nयेन वृत्तेन वै तिष्ठन्न च्यवेयं स्वधर्मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2075093, "chapter_id": 2587, "verse_number": "१२-९२-५", "content_sanskrit": "तमब्रवीद्धामदेवस्तेजस्वी तपतां वरः।\nहेमवर्णं सुखासीनं ययातिमिव नाहुषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2075094, "chapter_id": 2587, "verse_number": "१२-९२-६x", "content_sanskrit": "वामदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2075095, "chapter_id": 2587, "verse_number": "१२-९२-६", "content_sanskrit": "धर्ममेवानुवर्तस्व न धर्माद्विद्यते परम्।\nधर्मे स्थिता हि राजानो जयन्ति पृथिवीमिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2075096, "chapter_id": 2587, "verse_number": "१२-९२-७", "content_sanskrit": "अर्थसिद्धेः परं धर्मं मन्यते यो महीपतिः।\nवृद्ध्यां च कुरुते बृद्धिं स धर्मेण विराजते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2075097, "chapter_id": 2587, "verse_number": "१२-९२-८", "content_sanskrit": "अधर्मदर्शी यो राजा बलादेव प्रवर्तते।\nक्षिप्रमेवापयातोऽस्मादुभौ प्रथममध्यमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2075098, "chapter_id": 2587, "verse_number": "१२-९२-९", "content_sanskrit": "असत्पापिष्ठसचिवो वध्यो लोकस्य धर्महा।\nसहैव परिवारेण क्षिप्रमेवावसीदति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2075099, "chapter_id": 2587, "verse_number": "१२-९२-१०", "content_sanskrit": "अर्थानामननुष्ठाता कामचारी विकत्थनः।\nअपि सर्वां महीं लब्ध्वा क्षिप्रमेव विनश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2075100, "chapter_id": 2587, "verse_number": "१२-९२-११", "content_sanskrit": "अथाददानः कल्याणमनसूयुर्जितेन्द्रियः।\nवर्धते मतिमान्राजा स्रोतोभिरिव सागरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2075101, "chapter_id": 2587, "verse_number": "१२-९२-१२", "content_sanskrit": "न पूर्णोऽस्मीति मन्येत धर्मतः कामतोऽर्थतः।\nबुद्धितो मन्त्रतश्चापि सततं वसुधाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2075102, "chapter_id": 2587, "verse_number": "१२-९२-१३", "content_sanskrit": "एतेष्वेव हि सर्वेषु लोकयात्रा प्रतिष्ठिता।\nएतानि शृण्वँल्लभते यशः कीर्ति श्रियं प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2075103, "chapter_id": 2587, "verse_number": "१२-९२-१४", "content_sanskrit": "एवं यो धर्मसंरम्भी धर्मार्थपरिचिन्तकः।\nअर्थान्परीक्ष्यारभते स ध्रुवं महदश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2075104, "chapter_id": 2587, "verse_number": "१२-९२-१५", "content_sanskrit": "अदाता ह्यनभिस्नेहो दण़्डेनावर्तयन्प्रजाः।\nसाहसप्रकृती राजा क्षिप्रमेव विनश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2075105, "chapter_id": 2587, "verse_number": "१२-९२-१६", "content_sanskrit": "अथ पापं कृतं बुद्ध्या न च पश्यत्यबुद्धिमान्।\nअकीर्त्याऽभिसमायुक्तो भूयो नरकमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2075106, "chapter_id": 2587, "verse_number": "१२-९२-१७", "content_sanskrit": "ततो न याचितुर्दातुः शुक्लस्य रसवेदिनः।\nव्यसनं स्वमिवोत्पन्नं विजिघांसन्ति मानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2075107, "chapter_id": 2587, "verse_number": "१२-९२-१८", "content_sanskrit": "यस्य नास्ति गुरुर्धर्मे न चान्यानपि पृच्छति।\nसुखतन्त्रोऽर्थलाभेषु न चिरं सुखमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2075108, "chapter_id": 2587, "verse_number": "१२-९२-१९", "content_sanskrit": "गुरुप्रधानो धर्मेषु स्वयमर्थानवेक्षिता।\nधर्मप्रधानो लाभेषु स चिरं सुखमश्नुते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2075109, "chapter_id": 2587, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वमि राजधर्मपर्वणि द्विनवतितमोऽध्यायः॥ ९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]