[{"id": 2004765, "chapter_id": 1095, "verse_number": "१-९६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2004766, "chapter_id": 1095, "verse_number": "१-९६-१", "content_sanskrit": "तं कुमारमृषिर्दृष्ट्वा कर्म चास्यातिमानुषम्।\nसमयो यौवराज्याय इत्यनुध्याय स द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2004767, "chapter_id": 1095, "verse_number": "१-९६-२", "content_sanskrit": "शकुन्तलां समाहूय कण्वो वचनमब्रवीत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2004768, "chapter_id": 1095, "verse_number": "१-९६-२x", "content_sanskrit": "कण्व उवाच।\nशृणु भद्रे मम सुते मम वाक्यं शुचिस्मिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2004769, "chapter_id": 1095, "verse_number": "१-९६-३", "content_sanskrit": "पतिव्रतानां नारीणां विशिष्टमिति चोच्यते।\nपतिशुश्रूषणं पूर्वं मनोवाक्कायचेष्टितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2004770, "chapter_id": 1095, "verse_number": "१-९६-४", "content_sanskrit": "अनुज्ञाता मया पूर्वं पूजयैतद्व्रतं तव।\nएतेनैव च वृत्तेन पुण्याँल्लोकानवाप्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2004771, "chapter_id": 1095, "verse_number": "१-९६-५", "content_sanskrit": "तस्यान्ते मानुषे लोके विशिष्टां तप्स्यसे श्रियम्।\nतस्माद्भद्रेऽद्य यातव्यं समीपं पौरवस्य ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2004772, "chapter_id": 1095, "verse_number": "१-९६-६", "content_sanskrit": "स्वयं नायाति मत्वा ते गतं कालं शुचिस्मिते।\nगत्वाऽऽराधय राजानं दुष्यन्तं हितकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2004773, "chapter_id": 1095, "verse_number": "१-९६-७", "content_sanskrit": "दौष्यन्तिं यौवराज्यस्थं दृष्ट्वा प्रीतिमवाप्स्यसि।\nदेवतानां गुरूणां च क्षत्रियाणां च भामिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2004774, "chapter_id": 1095, "verse_number": "१-९६-८", "content_sanskrit": "भर्तॄणां च विशेषेम हितं संगमनं भवेत्।\nतस्मात्पुत्रि कुमारेण गन्तव्यं मत्प्रियेप्सया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2004775, "chapter_id": 1095, "verse_number": "१-९६-९", "content_sanskrit": "प्रतिवाक्यं न दद्यास्त्वं शपिता मम पादयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2004776, "chapter_id": 1095, "verse_number": "१-९६-१०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2004777, "chapter_id": 1095, "verse_number": "१-९६-१०", "content_sanskrit": "एवमुक्त्वा सुतां तत्र पौत्रं कण्वोऽभ्यभाषत।\nपरिष्वज्य च बाहुभ्यां मूर्ध्न्युपाघ्राय पौरवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2004778, "chapter_id": 1095, "verse_number": "१-९६-११", "content_sanskrit": "सोमवंशोद्भवो राजा दुष्यन्त इति विश्रुतः।\nतस्याग्रमहिषी चैषा तव माता शुचिव्रता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2004779, "chapter_id": 1095, "verse_number": "१-९६-१२", "content_sanskrit": "गन्तुकामा भर्तृपार्श्वं त्वया सह सुमध्यमा।\nगत्वाऽभिवाद्य राजनं यौवराज्यमवाप्स्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2004780, "chapter_id": 1095, "verse_number": "१-९६-१३", "content_sanskrit": "स पिता तव राजेन्द्रस्तस्य त्वं वशगो भव।\nपितृपैतामहं राज्यमातिष्ठस्व स्वभावतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2004781, "chapter_id": 1095, "verse_number": "१-९६-१४", "content_sanskrit": "तस्मिन्काले स्वराज्यस्थो मामनुस्मर पौरव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2004782, "chapter_id": 1095, "verse_number": "१-९६-१५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2004783, "chapter_id": 1095, "verse_number": "१-९६-१५", "content_sanskrit": "अभिवाद्य मुनेः पादौ पौरवो वाक्यमब्रवीत्।\nत्वं पिता मम विप्रर्षे त्वं माता त्वं गतिश्च मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2004784, "chapter_id": 1095, "verse_number": "१-९६-१६", "content_sanskrit": "न चान्यं पितरं मन्ये त्वामृते तु महातपः।\nतव शुश्रूषणं पुण्यमिह लोके परत्र च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2004785, "chapter_id": 1095, "verse_number": "१-९६-१७", "content_sanskrit": "शकुन्तला भर्तृकामा स्वयं यातु यथेष्टतः।\nअहं सुश्रूषणपरः पादमूले वसामि वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2004786, "chapter_id": 1095, "verse_number": "१-९६-१८", "content_sanskrit": "क्रीडां व्यालमृगैः सार्धं करिष्ये न पुरा यथा।\nत्वच्छासनपरो नित्यं स्वाध्यायं च करोम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2004787, "chapter_id": 1095, "verse_number": "१-९६-१९", "content_sanskrit": "एवमुक्त्वा तु संश्लिष्य पादौ कण्वस्य तिष्ठतः।\nतस्य तद्वचनं श्रुत्वा प्ररुरोद शकुन्तला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2004788, "chapter_id": 1095, "verse_number": "१-९६-२०", "content_sanskrit": "स्नेहात्पितुश्च पुत्रस्य हर्षशोकसमन्विता।\nनिशाम्य रुदतीमार्तां दौष्यन्तिर्वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2004789, "chapter_id": 1095, "verse_number": "१-९६-२१", "content_sanskrit": "श्रुत्वा भगवतो वाक्यं किं रोदिषि शकुन्तले।\nगन्तव्यं काल्य उत्थाय भर्तृप्रीतिस्ववास्ति चेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2004790, "chapter_id": 1095, "verse_number": "१-९६-२२x", "content_sanskrit": "शकुन्तलोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2004791, "chapter_id": 1095, "verse_number": "१-९६-२२", "content_sanskrit": "एकस्तु कुरुते पापं फलं भुङ्क्ते महाजनः।\nमया निवारितो नित्यं न करोषि वचो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2004792, "chapter_id": 1095, "verse_number": "१-९६-२३", "content_sanskrit": "निःसृतान्कुञ्जरान्नित्यं बाहुभ्यां संप्रमथ्य वै।\nवनं च लोडयन्नित्यं सिंहव्याघ्रगणैर्वृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2004793, "chapter_id": 1095, "verse_number": "१-९६-२४", "content_sanskrit": "एवंविधानि चान्यानि कृत्वा वै पुरुनन्दन।\nरुषितो भगवांस्तात तस्मादावां विवासितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2004794, "chapter_id": 1095, "verse_number": "१-९६-२५", "content_sanskrit": "नाहं गच्छामि दुष्यन्तं नास्मि पुत्र हितैषिणी।\nपादमूले वसिष्यामि महर्षेर्भावितात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2004795, "chapter_id": 1095, "verse_number": "१-९६-२६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2004796, "chapter_id": 1095, "verse_number": "१-९६-२६", "content_sanskrit": "एवमुक्त्वा तु रुदती पपात मुनिपादयोः।\nएवं विलपतीं कण्वश्चानुनीय च हेतुभिः।\nपुनः प्रोवाच भगवानानृशंस्याद्धितं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2004797, "chapter_id": 1095, "verse_number": "१-९६-२७x", "content_sanskrit": "कण्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2004798, "chapter_id": 1095, "verse_number": "१-९६-२७", "content_sanskrit": "शकुन्तले शृणुष्वेदं हितं पथ्यं च भामिनि।\nपतिव्रताभावगुणान्हित्वा साध्यं न किंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2004799, "chapter_id": 1095, "verse_number": "१-९६-२८", "content_sanskrit": "प्रतिव्रतानां देवा वै तुष्टाः सर्वरप्रदाः।\nप्रसादं च करिष्यन्ति आपदो मोक्षयन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2004800, "chapter_id": 1095, "verse_number": "१-९६-२९", "content_sanskrit": "पतिप्रसादात्पुण्यं च प्राप्नुवन्ति न चाशुभम्।\nतस्माद्गत्वा तु राजानमाराधय शुचिस्मिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2004801, "chapter_id": 1095, "verse_number": "१-९६-३०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2004802, "chapter_id": 1095, "verse_number": "१-९६-३०", "content_sanskrit": "शकुन्तलां तथोक्त्वा वै शाकुन्तलमथाब्रवीत्।\nदौहित्रो मम पौत्रस्त्वमिलिलस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2004803, "chapter_id": 1095, "verse_number": "१-९६-३१", "content_sanskrit": "शृणुष्व वचनं सत्यं प्रब्रवीमि तवानघ।\nमनसा भर्तृकामा वै वाग्भिरुक्त्वा पृथग्विधम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2004804, "chapter_id": 1095, "verse_number": "१-९६-३२", "content_sanskrit": "गन्तुं नेच्छति कल्याणी तस्मात्तात वहस्व वै।\nशक्तस्त्वं प्रतिगन्तुं च मुनिभिः सह पौरव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2004805, "chapter_id": 1095, "verse_number": "१-९६-३३", "content_sanskrit": "इत्युक्त्वा सर्वदमनं कण्वः शिष्यानथाब्रवीत्।\nशकुन्तलामिमां शीग्रं सपुत्रामाश्रमादितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2004806, "chapter_id": 1095, "verse_number": "१-९६-३४", "content_sanskrit": "भर्तुः प्रापयताभ्याशं सर्वलक्षणपूजिताम्।\nनारीणां चिरवासो हि बान्धवेषु न रोचते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2004807, "chapter_id": 1095, "verse_number": "१-९६-३५", "content_sanskrit": "कीर्तिचारित्रधर्म्नस्तस्मान्नयत मा चिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2004808, "chapter_id": 1095, "verse_number": "१-९६-३६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2004809, "chapter_id": 1095, "verse_number": "१-९६-३६", "content_sanskrit": "धर्माभिपूजितं पुत्रं काश्यपेन निशाम्य तु।\nकाश्यपात्प्राप्य चानुज्ञां मुमुदे च शकुन्तला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2004810, "chapter_id": 1095, "verse_number": "१-९६-३७", "content_sanskrit": "कण्वस्य वचनं श्रुत्वा प्रतिगच्छेति चासकृत्।\nतथेत्युक्त्वा तु कण्वं च मातरं पौरवोऽब्रवीत्।\nकिं चिरायसि मातस्त्वं गमिष्यामो नृपालयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2004811, "chapter_id": 1095, "verse_number": "१-९६-३८", "content_sanskrit": "एवमुक्त्वा तु तां देवीं दुष्यन्तस्य महात्मनः।\nअभिवाद्य मुनेः पादौ गन्तुमैच्छत्स पौरवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2004812, "chapter_id": 1095, "verse_number": "१-९६-३९", "content_sanskrit": "शकुन्तला च पितरमभिवाद्य कृताञ्जलिः।\nप्रदक्षिणीकृत्य तदा पितरं वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2004813, "chapter_id": 1095, "verse_number": "१-९६-४०", "content_sanskrit": "अज्ञानान्मे पिता चेति दुरुक्तं वापि चानृतम्।\nअकार्यं वाप्यनिष्टं वा क्षन्तुमर्हति तद्भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2004814, "chapter_id": 1095, "verse_number": "१-९६-४१", "content_sanskrit": "एवमुक्तो नतशिरा मुनिर्नोवाच किंचन।\nमनुष्यभावात्कण्वोऽपि मुनिरश्रूण्यवर्तयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2004815, "chapter_id": 1095, "verse_number": "१-९६-४२", "content_sanskrit": "अब्भक्षान्वायुभक्षांश्च शीर्णपर्णाशनान्मुनीन्।\nफलमूलाशिनो दान्तान्कृशान्धमनिसंततान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2004816, "chapter_id": 1095, "verse_number": "१-९६-४३", "content_sanskrit": "व्रतिनो जटिलान्मुण्डान्वल्कलाजिनसंवृतान्।\nसमाहूय मुनिः कण्वः कारुण्यादिदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2004817, "chapter_id": 1095, "verse_number": "१-९६-४४", "content_sanskrit": "मया तु लालिता नित्यं मम पुत्री यशस्विनी।\nवने जाता विवृद्धा च न च जानाति किंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2004818, "chapter_id": 1095, "verse_number": "१-९६-४५", "content_sanskrit": "आश्रमात्तु पथा सर्वैर्नीयतां क्षत्रियालयम्।\nद्वितीययोजने विप्राः प्रतिष्ठानं प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2004819, "chapter_id": 1095, "verse_number": "१-९६-४६", "content_sanskrit": "प्रतिष्ठाने पुरे राजा शाकुन्तलपितामहः।\nअध्युवास चिरं कालमुर्वश्या सहितः पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2004820, "chapter_id": 1095, "verse_number": "१-९६-४७", "content_sanskrit": "अनूपजाङ्गलयुतं धनधान्यसमाकुलम्।\nप्रतिष्ठितं पुरवरं गङ्गायामुनसङ्गमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2004821, "chapter_id": 1095, "verse_number": "१-९६-४८", "content_sanskrit": "तत्र सङ्गममासाद्य स्नात्वा हुतहुताशनाः।\nशाकमूलफलाहारा निवर्तध्वं तपोधनाः।\nअन्यथा तु भवेद्विप्रा अध्वनो गमने श्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2004822, "chapter_id": 1095, "verse_number": "१-९६-४९", "content_sanskrit": "तथेत्युक्त्वा च ते सर्वे प्रातिष्ठन्त महौजसः।\nशकुन्तलां पुरस्कृत्य दुष्यन्तस्य पुरं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2004823, "chapter_id": 1095, "verse_number": "१-९६-५०", "content_sanskrit": "गृहीत्वा चामरप्रख्यं पुत्रं कमललोचनम्।\nआजग्मुश्च पुरं रम्यं दुष्यन्ताध्युषितं वनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2004824, "chapter_id": 1095, "verse_number": "१-९६-५१", "content_sanskrit": "शकुन्तलां समादाय मुनयो धर्मवत्सलाः।\nते वनानि नदीः शैलान्गिरिप्रस्रवणानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2004825, "chapter_id": 1095, "verse_number": "१-९६-५२", "content_sanskrit": "कन्दराणि नितम्बांश्च राष्ट्राणि नगराणि च।\nआश्रमाणि च पुण्यानि गत्वा चैव गतश्रमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2004826, "chapter_id": 1095, "verse_number": "१-९६-५३", "content_sanskrit": "शनैर्मध्याह्नवेलायां प्रतिष्ठानं समाययुः।\nतां पुरीं पुरुहूतेन ऐलस्यार्थे विनिर्मिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2004827, "chapter_id": 1095, "verse_number": "१-९६-५४", "content_sanskrit": "परिघाट्टालकैर्मुख्यैरुपकल्पशतैरपि।\nशतघ्नीचक्रयन्त्रैश्च गुप्तामन्यैर्दुरासदाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2004828, "chapter_id": 1095, "verse_number": "१-९६-५५", "content_sanskrit": "हर्म्यप्रसादसंबाधां नानापण्यविभूषिताम्।\nमण्टपैः ससभै रम्यैः प्रपाभिश्च समावृताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2004829, "chapter_id": 1095, "verse_number": "१-९६-५६", "content_sanskrit": "राजमार्गेण महता सुविभक्तेन शोभिताम्।\nकैलासशिखराकारैर्गोपुरैः समलङ्कृताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2004830, "chapter_id": 1095, "verse_number": "१-९६-५७", "content_sanskrit": "द्वारतोरणनिर्यूहैर्मङ्गलैरुपशोभिताम्।\nउद्यानाम्रवणोपेतां महतीं सालमेखलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2004831, "chapter_id": 1095, "verse_number": "१-९६-५८", "content_sanskrit": "सर्वपुष्करिणीभिश्च उद्यानैश्च समावृताम्।\nवर्णाश्रमैः स्वधर्मस्थैर्नित्योत्सवसमाहितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2004832, "chapter_id": 1095, "verse_number": "१-९६-५९", "content_sanskrit": "धनधान्यसमृद्धैश्च संतुष्टै रत्नपूजितैः।\nकृतयज्ञैश्च विद्वद्भिरग्निहोत्रपरैः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2004833, "chapter_id": 1095, "verse_number": "१-९६-६०", "content_sanskrit": "वर्जिता कार्यकरणैर्दानशीलैर्दयापरैः।\nअधर्मभीरुभिः सर्वैः स्वर्गलोकजिगीषुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2004834, "chapter_id": 1095, "verse_number": "१-९६-६१", "content_sanskrit": "एवंविधजनोपेतमिन्द्रलोकमिवापरम्।\nतस्मिन्नगरमध्ये तु राजवेश्म प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2004835, "chapter_id": 1095, "verse_number": "१-९६-६२", "content_sanskrit": "इन्द्रसद्मप्रतीकाशं संपूर्णं वित्तसंचयैः।\nतस्य मध्ये सभा दिव्या नानारत्नविभूषिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2004836, "chapter_id": 1095, "verse_number": "१-९६-६३", "content_sanskrit": "तस्यां सभायां राजर्षिः सर्वालङ्कारभूषितः।\nब्राह्मणैः क्षत्रियैश्चापि मन्त्रिभिश्चापि संवृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2004837, "chapter_id": 1095, "verse_number": "१-९६-६४", "content_sanskrit": "संस्तूयमानो राजेन्द्रः सूतमागधबन्दिभिः।\nकार्यार्थिषु तदाऽभ्येत्य कृत्वा कार्यं गतेषु सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2004838, "chapter_id": 1095, "verse_number": "१-९६-६५", "content_sanskrit": "सुखासीनोऽभवद्राजा तस्मिन्काले महर्षयः।\nशकुन्तानां स्वनं श्रुत्वा निमित्तज्ञास्त्वलक्षयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2004839, "chapter_id": 1095, "verse_number": "१-९६-६६", "content_sanskrit": "शकुन्तले निमित्तानि शोभनानि भवन्ति नः।\nकार्यसिद्धिं वदन्त्येते ध्रुवं राज्ञी भविष्यसि।\nअस्मिंस्तु दिवसे पुत्रो युवराजो भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2004840, "chapter_id": 1095, "verse_number": "१-९६-६७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2004841, "chapter_id": 1095, "verse_number": "१-९६-६७", "content_sanskrit": "वर्धमानपुरद्वारं तूर्यघोषनिनादितम्।\nशकुन्तलां पुरस्कृत्य विविशुस्ते महर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2004842, "chapter_id": 1095, "verse_number": "१-९६-६८", "content_sanskrit": "प्रविशन्तं नृपसुतं प्रशशंसुश्च वीक्षकाः।\nवर्धमानपुरद्वारं प्रविशन्नेव पौरवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2004843, "chapter_id": 1095, "verse_number": "१-९६-६९", "content_sanskrit": "इन्द्रलोकस्थमात्मानं मेने हर्षसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2004844, "chapter_id": 1095, "verse_number": "१-९६-७०", "content_sanskrit": "ततो वै नागराः सर्वे समाहूय परस्परम्।\nद्रष्टुकामा नृपसुतं समपद्यन्त भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2004845, "chapter_id": 1095, "verse_number": "१-९६-७१x", "content_sanskrit": "नागरा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2004846, "chapter_id": 1095, "verse_number": "१-९६-७१", "content_sanskrit": "देवतेव जनस्याग्रे भ्राजते श्रीरिवागता।\nजयन्तेनेव पौलोमी इन्द्रलोकादिहागता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2004847, "chapter_id": 1095, "verse_number": "१-९६-७२", "content_sanskrit": "इति ब्रुवन्तस्ते सर्वे महर्षीनिदमब्रुवन्।\nअभिवादयन्तः सहिता महर्षीन्देववर्चसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2004848, "chapter_id": 1095, "verse_number": "१-९६-७३", "content_sanskrit": "अद्य नः सफलं जन्म कृतार्थाश्च ततो वयम्।\nएवं ये स्म प्रपश्यामो महर्षीन्सूर्यवर्चसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2004849, "chapter_id": 1095, "verse_number": "१-९६-७४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2004850, "chapter_id": 1095, "verse_number": "१-९६-७४", "content_sanskrit": "इत्युक्त्वा सहिताः केचिदन्वगच्छन्त पौरवम्।\nहैमवत्याः सुतमिव कुमारं पुष्करेक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2004851, "chapter_id": 1095, "verse_number": "१-९६-७५", "content_sanskrit": "ये केचिदब्रुवन्मूढाः शाकुन्तलदिदृक्षवः।\nकृष्णाजिनेन संछन्नाननिच्छन्तो ह्यवेक्षितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2004852, "chapter_id": 1095, "verse_number": "१-९६-७६", "content_sanskrit": "पिशाचा इव दृश्यन्ते नागराणां विरूपिणः।\nविना सन्ध्यां पिशाचास्ते प्रविशन्ति पुरोत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2004853, "chapter_id": 1095, "verse_number": "१-९६-७७", "content_sanskrit": "क्षुत्पिपासार्दितान्दीनान्वल्कलाजिनवाससः।\nत्वगस्थिभूतान्निर्मांसान्धमनीसन्ततानपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2004854, "chapter_id": 1095, "verse_number": "१-९६-७८", "content_sanskrit": "पिङ्गलाक्षान्पिङ्गजटान्दीर्घदन्तान्निरूदरान्।\nविशीर्षकानूर्ध्वहस्तान्दृष्ट्वा हास्यन्ति नागराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2004855, "chapter_id": 1095, "verse_number": "१-९६-७९", "content_sanskrit": "एवमुक्तवतां तेषां गिरं श्रुत्वा महर्षयः।\nअन्योन्यं ते समाहूय इदं वचनमब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2004856, "chapter_id": 1095, "verse_number": "१-९६-८०", "content_sanskrit": "उक्तं भगवता वाक्यं न कृतं सत्यवादिना।\nपुरप्रवेशनं नात्र कर्तव्यमिति शासनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2004857, "chapter_id": 1095, "verse_number": "१-९६-८१", "content_sanskrit": "किं कारणं प्रवेक्ष्यामो नगरं दुर्जनैर्वृतम्।\nत्यक्तसङ्गस्य च मुनेर्नगरे किं प्रयोजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2004858, "chapter_id": 1095, "verse_number": "१-९६-८२", "content_sanskrit": "गमिष्यामो वनं तस्माद्गङ्गायामुनसङ्गमम्।\nएवमुक्त्वा मुनिगणाः प्रतिजग्मुर्यथागतम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2004859, "chapter_id": 1095, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि षण्णवतितमोऽध्यायः॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}]