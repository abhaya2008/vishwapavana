[{"id": 2024972, "chapter_id": 1536, "verse_number": "३-१७४-०x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2024973, "chapter_id": 1536, "verse_number": "३-१७४-१", "content_sanskrit": "अदृश्यमानास्ते दैत्या योधयन्ति स्म मायया।\nअदृश्यनास्त्रवीर्येण तानप्यहमयोधयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2024974, "chapter_id": 1536, "verse_number": "३-१७४-२", "content_sanskrit": "गाण्डीवमुक्ता विशिखाः सम्यगस्त्रप्रचोदिताः।\nअच्छिन्दन्नुत्तमाङ्गानि यत्रयत्र स्म तेऽभवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2024975, "chapter_id": 1536, "verse_number": "३-१७४-३", "content_sanskrit": "ततो निवातकवचा वध्यमाना मया युधि।\nसंहृत्य रमायां सहसा प्राविशन्पुरमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2024976, "chapter_id": 1536, "verse_number": "३-१७४-४", "content_sanskrit": "व्यपयातेषु दैत्येषु प्रादुर्भूते च दर्शने।\nअपश्यं दानवांस्तत्र हताञ्शतसहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2024977, "chapter_id": 1536, "verse_number": "३-१७४-५", "content_sanskrit": "विनिष्पिष्टानि तत्रैषां शस्त्राण्याभरणानि च।\nशतशः स्म प्रदृश्यन्ते गात्राणि कवचानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2024978, "chapter_id": 1536, "verse_number": "३-१७४-६", "content_sanskrit": "हयानां नान्तरं ह्यासीत्पदाद्विचलितुं पदम्।\nउत्पत्य सहसा तस्थुरन्तरिक्षगमास्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2024979, "chapter_id": 1536, "verse_number": "३-१७४-७", "content_sanskrit": "ततो निवातकवचा व्योम संछाद्य केवलम्।\nअदृश्या ह्यभ्यवर्तन्त विसृजन्तः शिलोच्चयान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2024980, "chapter_id": 1536, "verse_number": "३-१७४-८", "content_sanskrit": "अन्तर्भूमिगताश्चान्ये हयानां चरणानथ।\nव्यगृह्णन्दानवा घोरा रथचक्रे च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2024981, "chapter_id": 1536, "verse_number": "३-१७४-९", "content_sanskrit": "विनिगृह्य हयांश्चान्ये रथं च मम युध्यतः।\nसर्वतो मामविध्यन्त सरथं धरणीधरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2024982, "chapter_id": 1536, "verse_number": "३-१७४-१०", "content_sanskrit": "पर्वतैरुपचीयद्भिः पतद्भिश्च तथाऽपरैः।\nस देशो यत्रवर्तामि गुहेव समपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2024983, "chapter_id": 1536, "verse_number": "३-१७४-११", "content_sanskrit": "पर्वतैश्चाद्यमानोऽहं निगृहीतैश्च वाजिभिः।\nअगच्छं परमामार्तिं मातलिस्तदलक्षयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2024984, "chapter_id": 1536, "verse_number": "३-१७४-१२", "content_sanskrit": "लक्षयित्वा च मां भीतमिदं वचनमब्रवीत्।\nआर्जुनार्जुन मा भैस्त्वं वज्रमस्त्रमुदीरय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2024985, "chapter_id": 1536, "verse_number": "३-१७४-१३", "content_sanskrit": "ततोऽहं तस्य तद्वाक्यं श्रुत्वा वज्रमुदीरयम्।\nदेवराजस् दयितं वज्रमस्त्रं नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2024986, "chapter_id": 1536, "verse_number": "३-१७४-१४", "content_sanskrit": "अचलं स्थानमासाद्य गाण्डीवमनुमन्त्र्य च।\nअमुञ्चं वज्रसंस्पर्शानायतान्निशिताञ्सरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2024987, "chapter_id": 1536, "verse_number": "३-१७४-१५", "content_sanskrit": "ततो मायाश् ताः सर्वा निवातकवचांश्च तान्।\nते वज्रचोदिता बाणा वज्रभूताः रसमाविशन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2024988, "chapter_id": 1536, "verse_number": "३-१७४-१६", "content_sanskrit": "ते वज्रवेगविहता दानवाः पर्वतोपमाः।\nइतरेतरमाश्लिष्य न्यपतन्पृथिवीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2024989, "chapter_id": 1536, "verse_number": "३-१७४-१७", "content_sanskrit": "अन्तर्भूमौ च येऽगृह्णन्दानवा रथवाजिनः।\nअनुप्रविश्य तान्वाणाः प्राहिण्वन्यमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2024990, "chapter_id": 1536, "verse_number": "३-१७४-१८", "content_sanskrit": "हतैर्निवातकवचैर्निरस्तैः पर्वतोपमैः।\nसमाच्छाद्यत देशः स विकीर्णैरिव पर्वतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2024991, "chapter_id": 1536, "verse_number": "३-१७४-१९", "content_sanskrit": "न हयानां क्षतिः काचिन्न रथस् न मातलेः।\nमम चादृश्यत तदा तदद्भुतमिवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2024992, "chapter_id": 1536, "verse_number": "३-१७४-२०", "content_sanskrit": "ततो मां प्रहसन्राजन्मातलिः प्रत्यभाषत।\nनैतदर्जुन देवेषु त्वयि वीर्यं यदीक्ष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2024993, "chapter_id": 1536, "verse_number": "३-१७४-२१", "content_sanskrit": "हतेष्वसुरसङ्घेषु दारास्तेषां तु सर्वशः।\nप्राक्रोशन्नगरे तस्मिन्यथा शरदि लक्ष्मणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2024994, "chapter_id": 1536, "verse_number": "३-१७४-२२", "content_sanskrit": "ततो मातलिना सार्धमहं तत्पुरमभ्ययाम्।\nत्रासयन्रथघोषेण निवातकवचस्त्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2024995, "chapter_id": 1536, "verse_number": "३-१७४-२३", "content_sanskrit": "तान्दृष्ट्वा दशसाहस्रान्मयूरसदृशान्हयान्।\nरथं च रविसंकाशं प्राद्रवन्गणशः स्त्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2024996, "chapter_id": 1536, "verse_number": "३-१७४-२४", "content_sanskrit": "ताभिराभरणैः शब्दस्त्रासिताभिः समीरितः।\nशिलानामिव शैलेषु पतन्तीनामभूत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2024997, "chapter_id": 1536, "verse_number": "३-१७४-२५", "content_sanskrit": "वित्रस्ता दैत्यनार्यस्ताः स्वानि वेश्मान्यथाविशन्।\nबहुरत्नविचित्राणि शातकुम्भमयानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2024998, "chapter_id": 1536, "verse_number": "३-१७४-२६", "content_sanskrit": "तदद्भुताकारमहं दृष्ट्वा नगरमुत्तमम्।\nविशिष्टं देवनगरादपृच्छं मातलिं ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2024999, "chapter_id": 1536, "verse_number": "३-१७४-२७", "content_sanskrit": "इदमेवंविधं कस्माद्देवता न विशन्त्युत।\nपुरंदरपुराद्धीदं विशिष्टमिति लक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2025000, "chapter_id": 1536, "verse_number": "३-१७४-२८x", "content_sanskrit": "मातलिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2025001, "chapter_id": 1536, "verse_number": "३-१७४-२८", "content_sanskrit": "आसीदिदं पुरा पार्थ देवराजस्य नः पुरम्।\nततो निवातकवचैरितः प्रच्याविताः सुराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2025002, "chapter_id": 1536, "verse_number": "३-१७४-२९", "content_sanskrit": "तपस्तप्त्वा महत्तीव्रं प्रसाद्य च पितामहम्।\nइदं वृतं निवासाय देवेभ्यश्चाभयं युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2025003, "chapter_id": 1536, "verse_number": "३-१७४-३०", "content_sanskrit": "ततः शक्रेण भगवान्स्वयंभूरभिचोदितः।\nविधत्तां भगवानत्रेत्यात्मनो हितकाम्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2025004, "chapter_id": 1536, "verse_number": "३-१७४-३१", "content_sanskrit": "तत उक्तो भगवता दिष्टमत्रेति भारत।\nभवितान्तस्त्वमप्येषां देहेनान्येन वृत्रहन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2025005, "chapter_id": 1536, "verse_number": "३-१७४-३२", "content_sanskrit": "तत एषां वधार्थाय शक्रोऽस्त्राणि ददौ तव।\nन हि शक्याः सुरैर्हन्तुं य एते निहतास्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2025006, "chapter_id": 1536, "verse_number": "३-१७४-३३", "content_sanskrit": "कालस्य परिणामेन ततस्त्वमिह भारत।\nएषामन्तकरः प्राप्तस्तत्त्वया च कृतं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2025007, "chapter_id": 1536, "verse_number": "३-१७४-३४", "content_sanskrit": "दानवानां विनाशार्थं महास्त्राणां महद्बलम्।\nग्राहितस्त्वं महेन्द्रेण पुरुषेन्द्र तदुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2025008, "chapter_id": 1536, "verse_number": "३-१७४-३५x", "content_sanskrit": "उर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2025009, "chapter_id": 1536, "verse_number": "३-१७४-३५", "content_sanskrit": "ततः प्रशाम्य नगरं दानवांश्च निहत्य तान्।\nपुनर्मातलिना सार्धमगमं देवसद्म तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2025010, "chapter_id": 1536, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि निवातकवचयुद्धपर्वणि चतुःसप्तत्यधिकशततमोऽध्यायः ॥ १७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]