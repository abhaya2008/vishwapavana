[{"id": 7001054000, "chapter_id": 21054, "verse_number": "५-३६-१", "content_sanskrit": "मेत्रेय!श्रूयतां तस्य बलस्य बलशालिनः ।\nकृतं यदन्यत्तेनाभूत्तदपि श्रूयतां द्रिज ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001054001, "chapter_id": 21054, "verse_number": "५-३६-२", "content_sanskrit": "नरकस्यासुरेन्द्रस्य देवपक्षविरोधिनः ।\nसखाभवन्महावीर्य्यो द्रिविदो नाम वानरः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001054002, "chapter_id": 21054, "verse_number": "५-३६-३", "content_sanskrit": "वैरानुबन्ध बलवान् स चकार सुरान् प्रित ।\nनरक हतवान् कृष्णो बलदर्पसमन्वितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001054003, "chapter_id": 21054, "verse_number": "५-३६-४", "content_sanskrit": "करिष्ये सर्व्वदेवानां तस्मादेतत्प्रतिक्रियाम् ।\nयज्ञविध्वंसनं कुर्व्वन् मर्त्तलोकक्षयं तथा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001054004, "chapter_id": 21054, "verse_number": "५-३६-५", "content_sanskrit": "ततो विध्वसयामास यज्ञानज्ञानमोहितः ।\nबिबेद साधुमर्य्यादां क्षयं चक्र च देहिनाम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001054005, "chapter_id": 21054, "verse_number": "५-३६-६", "content_sanskrit": "ददाह च वनोद्देशान् पुरग्रामान्तराणि च ।\nक्वचिज्व पर्व्वताक्षेपैर्ग्रामादीन् समचूणोयत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001054006, "chapter_id": 21054, "verse_number": "५-३६-७", "content_sanskrit": "शैलानुतूपाट्य तोयेषु मुमोचाम्बुनिधौ तथा ।\nपुनञ्चार्णवमध्यस्थः क्षोभयामास सागरम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001054007, "chapter_id": 21054, "verse_number": "५-३६-८", "content_sanskrit": "तेन विक्षोभितश्वाब्धिरुद्रेलोऽजायत द्रिज ।\nप्लावयंस्तीरजान् ग्रामान् पुरादीनतिवेगवान् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001054008, "chapter_id": 21054, "verse_number": "५-३६-९", "content_sanskrit": "कामरूपी महारूपं कृत्वा संस्थानशेषतः ।\nलुण्ठन् भ्रमणसंमर्द्देः सञ्चूर्णायति वानरः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001054009, "chapter_id": 21054, "verse_number": "५-३६-१०", "content_sanskrit": "तेन विप्रकृतं सर्व्वं जगदेतदूदुरात्मना ।\nनिः स्वाध्यायवषटूकारं मैत्रेयासीत् सुदुः खितम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001054010, "chapter_id": 21054, "verse_number": "५-३६-११", "content_sanskrit": "एकदा रैवतोद्याने पपौ पानं हलायुधः ।\nरेवती च महाभागा तथैवान्या वरस्त्रियः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001054011, "chapter_id": 21054, "verse_number": "५-३६-१२", "content_sanskrit": "उपगीयमानो विलसल्ललनामौलिमध्यगः ।\nरेमे यदुवरश्वष्ठः कुवेर इव मन्दरे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001054012, "chapter_id": 21054, "verse_number": "५-३६-१३", "content_sanskrit": "ततः स वानरोऽभ्येत्य गृहीत्वा सीरिणो हलम् ।\nमुषलञ्च चकारास्य सम्मुख़्च बिड़म्बनम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001054013, "chapter_id": 21054, "verse_number": "५-३६-१४", "content_sanskrit": "तथैव योषितां तासां जहासाभिमुखं कपिः ।\nपानपूर्णाश्व करकांश्विक्षेपाहत्य वै तदा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001054014, "chapter_id": 21054, "verse_number": "५-३६-१५", "content_sanskrit": "ततः कोपपरीतात्मा भर्तूसयामास तं बलः ।\nतथापि तमवज्ञाय चक्र किलकिलाध्वनिम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001054015, "chapter_id": 21054, "verse_number": "५-३६-१६", "content_sanskrit": "ततः समुत्थाय बलो जग्राह मुषल रुषा ।\nसोऽपि शैलशिलां भीमां जग्राह प्लवगोत्तमः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001054016, "chapter_id": 21054, "verse_number": "५-३६-१७", "content_sanskrit": "चिक्षेप च स तां क्षिप्तां मुषलेन सहस्त्रधा ।\nबिभेद यादवश्वेष्ठः सा पपात महीतले ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001054017, "chapter_id": 21054, "verse_number": "५-३६-१८", "content_sanskrit": "आपतन्मुषलञ्चासौ समुल्लङ्घय प्लवङ्गमः ।\nवेगेनागम्य रोषेण तलेनोरस्यताड़यत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001054018, "chapter_id": 21054, "verse_number": "५-३६-१९", "content_sanskrit": "ततो बलेन कोपेन मुष्टिना मूद्धि ताड़ितः ।\nपपात रुधिरोदूगारी द्रिविदः क्षीणाजीवितः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001054019, "chapter_id": 21054, "verse_number": "५-३६-२०", "content_sanskrit": "पतता तच्छरीरेण गिरेः श्वृङ्गमदीर्य्यत ।\nमैत्रेय!शतधा वज्रिवजणेव हि ताड़ितम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001054020, "chapter_id": 21054, "verse_number": "५-३६-२१", "content_sanskrit": "पुष्पवृष्टिं ततो देवा रामस्योपरि चिक्षिपुः ।\nप्रशशंसुस्तथाभ्येत्य साध्वेतत्ते महत् कृतम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001054021, "chapter_id": 21054, "verse_number": "५-३६-२२", "content_sanskrit": "अनेन दुष्टकपिना दैत्यपक्षोपकारिणा ।\nजगन्निराकृतं वीर! दिष्ट्यासौ क्षयमागतः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001054022, "chapter_id": 21054, "verse_number": "५-३६-२३", "content_sanskrit": "इत्युक्त्वा दिवमाजग्मुर्देवा ह्टष्टाः सगुह्यकाः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001054023, "chapter_id": 21054, "verse_number": "५-३६-२४", "content_sanskrit": "एवंविधान्यनेकानि बलदेवस्य धीमतः ।\nकर्म्माण्यपरिमेयाणि शेषस्य धरणीबृतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]