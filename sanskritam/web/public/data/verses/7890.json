[{"id": 33000054, "chapter_id": 7890, "verse_number": "1", "content_sanskrit": "लषते लष्यति लषत्याशास्ते माङ्क्षतीप्सति । आकाङ्क्षति स्पृहयति नाथते वष्टि वाञ्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "avatarnika": ""}, {"id": 33000055, "chapter_id": 7890, "verse_number": "2", "content_sanskrit": "आशंसते कामयते लष्यते वाङ्क्षतीच्छति । लिप्सते हर्यतीच्छायां खटत्यप्यनुरुध्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2, "avatarnika": ""}, {"id": 33000056, "chapter_id": 7890, "verse_number": "3", "content_sanskrit": "विंशतिः स्युर्भ्रूणयते त्वपि लुभ्यति गृध्यति । ककते चार्थयति च गार्ध्ये षट्‌ स्यर्धनायति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3, "avatarnika": ""}, {"id": 33000057, "chapter_id": 7890, "verse_number": "4", "content_sanskrit": "क्रमते क्रम्यते यस्यत्दयुद्युङक्ते चोत्सहत्यपि । आराधयत्युत्सहत एषते संयसत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4, "avatarnika": ""}, {"id": 33000058, "chapter_id": 7890, "verse_number": "5", "content_sanskrit": "यसत्यपि प्रयतते संयस्यति च जेहते । वेहते षोडशोत्साहे बाहतेऽमी व्यवस्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5, "avatarnika": ""}, {"id": 33000059, "chapter_id": 7890, "verse_number": "6", "content_sanskrit": "विप्रीयतेऽपरजति द्वेष्टि द्वेषेऽपरज्यति । विरुणद्धि विगृह्णाति पञ्चाऽमी चाऽऽत्मनेपदे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6, "avatarnika": ""}, {"id": 33000060, "chapter_id": 7890, "verse_number": "7", "content_sanskrit": "वैरायते स्पर्द्धते च विराध्नोत्यभ्यसूयति । सूर्क्ष्यतीर्क्ष्यति चेर्ष्यायाम्‌ ईर्ष्यत्यपि च भर्त्स्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7, "avatarnika": ""}, {"id": 33000061, "chapter_id": 7890, "verse_number": "8", "content_sanskrit": "मोदते ह्लादते माद्यत्यानन्दति च तुष्यति । हृष्यति प्रीयते निर्वात्यपि नन्दति तूषते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8, "avatarnika": ""}, {"id": 33000062, "chapter_id": 7890, "verse_number": "9", "content_sanskrit": "निर्वृणोत्यात्मने सुख्यत्येते प्रीतौ सुखायते । प्रचेतीभवतीत्येवं प्रमनीभवतीति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9, "avatarnika": ""}, {"id": 33000063, "chapter_id": 7890, "verse_number": "10", "content_sanskrit": "सुमनायत इत्येवं सुमनीभवतीत्यपि । ह्रियां ह्रीच्छति जिह्रेति लजते च हृणीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10, "avatarnika": ""}, {"id": 33000064, "chapter_id": 7890, "verse_number": "11", "content_sanskrit": "व्रीडयति त्रपते मन्दाक्षयत्यप्यष्ट लज्जते । बिभेति त्रस्यति दरत्येवं त्रसति भेषते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11, "avatarnika": ""}, {"id": 33000065, "chapter_id": 7890, "verse_number": "12", "content_sanskrit": "विनक्ति भ्यसते चैव दर्भयत्यपि दर्भति । भेषत्युद्विजते भीत्यां व्यथते द्वादशेरिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12, "avatarnika": ""}, {"id": 33000066, "chapter_id": 7890, "verse_number": "13", "content_sanskrit": "तितिक्षतेऽधिकुरुते क्षान्तौ सहति सह्यति । मृष्यतीदं मर्षति चेत्यात्मनेऽपि चतुष्टयम्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13, "avatarnika": ""}, {"id": 33000067, "chapter_id": 7890, "verse_number": "14", "content_sanskrit": "क्षाम्यत्येवं क्षामयति क्षमते परिमृष्यति । तथा मर्षयति क्षम्पयति साहयतीति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14, "avatarnika": ""}, {"id": 33000068, "chapter_id": 7890, "verse_number": "15", "content_sanskrit": "अवधीरयति यातयत्यवजानाति हेडते । विमानयत्यट्टयति सुट्टयत्यवमन्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15, "avatarnika": ""}, {"id": 33000069, "chapter_id": 7890, "verse_number": "16", "content_sanskrit": "होडते हिण्डते रौडत्येते शेटति सेटति । करोत्यधस्तिरोभ्यां चाऽत्मनेऽवगणयत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16, "avatarnika": ""}, {"id": 33000070, "chapter_id": 7890, "verse_number": "17", "content_sanskrit": "अनादरे स्माययते तथा परिभवत्यपि । मङ्घते त्वात्मने विप्रकरोति निकरोति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17, "avatarnika": ""}, {"id": 33000071, "chapter_id": 7890, "verse_number": "18", "content_sanskrit": "त्रयोऽतिसन्दधात्येके विचति च्छलयत्यपि । ` प्रलोभयत्यपि शठत्युल्लापयत इत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18, "avatarnika": ""}, {"id": 33000072, "chapter_id": 7890, "verse_number": "19", "content_sanskrit": "दभ्नोति विप्रलभते प्रतारयति वञ्चने । अमी वञ्चयते गर्धयति चाऽथ जिघांसने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19, "avatarnika": ""}, {"id": 33000073, "chapter_id": 7890, "verse_number": "20", "content_sanskrit": "जिघांसति द्रुह्यति चाऽपराध्नोत्यपराध्यति । अवराध्यत्यपकरोत्येतेऽपकुरुतेऽपि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20, "avatarnika": ""}, {"id": 33000074, "chapter_id": 7890, "verse_number": "21", "content_sanskrit": "चिरिणोति रिणोत्येवं क्षिणोति जिरिणोति च । दाश्नोति च दृणोत्याहुः पदानि च्छान्दसानि षट्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21, "avatarnika": ""}, {"id": 33000075, "chapter_id": 7890, "verse_number": "22", "content_sanskrit": "कुप्यति क्रुध्यति क्रोधे भामते भामयत्यपि । चण्डते रोषयति च मन्तूयति च रुष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22, "avatarnika": ""}, {"id": 33000076, "chapter_id": 7890, "verse_number": "23", "content_sanskrit": "गुध्रात्येवं संरभतेऽथो गृह्लात्यात्मनेऽप्यदः। आग्रहेऽभिनिविशते कृपायां करुणायते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23, "avatarnika": ""}, {"id": 33000077, "chapter_id": 7890, "verse_number": "24", "content_sanskrit": "कृपायते चाऽनुकम्पतेऽनुक्रोशत्यृतीयते । घृणायते च दयते क्रपतेऽभ्युपपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24, "avatarnika": ""}, {"id": 33000078, "chapter_id": 7890, "verse_number": "25", "content_sanskrit": "प्रसीदत्यनुगृह्णाति चाऽऽत्मनेऽयं विषीदति । शोचतीति च शोके द्वे त्रयोऽनुशयवाचिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25, "avatarnika": ""}, {"id": 33000079, "chapter_id": 7890, "verse_number": "26", "content_sanskrit": "अनुशेतेऽनुतपति स्युर्विप्रतिसरत्यमी । कन्दति क्रन्दति क्लन्दत्यस्रयत्यपि रोदिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26, "avatarnika": ""}, {"id": 33000080, "chapter_id": 7890, "verse_number": "27", "content_sanskrit": "बाष्पायते विलपति तेवते परिदेवते । क्रोशति किलन्दते क्लिन्दत्येते द्वादश रोदने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27, "avatarnika": ""}, {"id": 33000081, "chapter_id": 7890, "verse_number": "28", "content_sanskrit": "अनुरज्यत्यनुरजत्यात्मने मिन्दयत्ययम्‌ । मेद्यति स्निह्यति स्नेहे प्रीयते सप्त मेदते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28, "avatarnika": ""}, {"id": 33000082, "chapter_id": 7890, "verse_number": "29", "content_sanskrit": "गर्वेऽभिमन्यते गर्वयते कर्वति खर्वति । हृष्यति स्माभिमनुते गर्वत्युद्यति दृप्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29, "avatarnika": ""}, {"id": 33000083, "chapter_id": 7890, "verse_number": "30", "content_sanskrit": "क्षीबते शौटति कडत्यपि हर्षति कण्डते । माद्यत्यहङ्करोत्यात्मनेऽप्युन्मादे तु लोडति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30, "avatarnika": ""}, {"id": 33000084, "chapter_id": 7890, "verse_number": "31", "content_sanskrit": "म्लेटत्युन्माद्यति म्रेडत्येते लेट्यति लोट्यति । ताम्यति श्राम्यति ग्लानौ खिन्ते खिन्दति खिद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31, "avatarnika": ""}, {"id": 33000085, "chapter_id": 7890, "verse_number": "32", "content_sanskrit": "ग्लायति क्लाम्यति परिम्लायति क्लामतीति च। निर्विद्यते चोपति च ग्लेपतेऽप्यथ दूयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32, "avatarnika": ""}, {"id": 33000086, "chapter_id": 7890, "verse_number": "33", "content_sanskrit": "क्लिश्यते व्यथते तन्तस्यति पम्पस्यतीति च । दुःखायते दुःख्यति च दुःखे कृच्छ्रायतेऽष्टकम्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33, "avatarnika": ""}, {"id": 33000087, "chapter_id": 7890, "verse_number": "34", "content_sanskrit": "बीभत्सते च बीभत्से जुगुप्सत इतीर्यते । प्रमीलतीति तन्द्र्यां स्याद्‌ घूर्णते प्रचलायते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34, "avatarnika": ""}, {"id": 33000088, "chapter_id": 7890, "verse_number": "35", "content_sanskrit": "जम्भते जृम्भते चाऽपि जृम्भे जञ्जभ्यते त्रयम्‌ । शेते द्रायति निद्राति संसस्ति स्वपितीति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35, "avatarnika": ""}, {"id": 33000089, "chapter_id": 7890, "verse_number": "36", "content_sanskrit": "निद्रायते संविशति निद्रायां संस्ति मन्दते । वलते परिवृत्तौ स्याद्‌ घोटते परिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36, "avatarnika": ""}, {"id": 33000090, "chapter_id": 7890, "verse_number": "37", "content_sanskrit": "प्रबुध्यते च जागर्ति द्राहते जागरे त्रयम्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37, "avatarnika": ""}]