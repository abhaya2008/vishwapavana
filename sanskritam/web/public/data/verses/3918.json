[{"id": 2134945, "chapter_id": 3918, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2134946, "chapter_id": 3918, "verse_number": "१", "content_sanskrit": "शत्रुभिर्जितबद्धस्य पाण्डवैश्च महात्मभिः ।\nमोक्षितस्य युधा पश्चान्मानितस्य दुरात्मनः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2134947, "chapter_id": 3918, "verse_number": "२", "content_sanskrit": "कत्थनस्यावलिप्तस्य गर्वितस्य च नित्यशः ।\nसदा च पौरुषौदार्यैः पाण्डवानवजानतः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2134948, "chapter_id": 3918, "verse_number": "३", "content_sanskrit": "दुर्योधनस्य पापस्य नित्याहङ्कारमानिनः ।\nप्रवेशो हस्तिनपुरे दुष्करः प्रतिभाति मे \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2134949, "chapter_id": 3918, "verse_number": "४", "content_sanskrit": "तस्य लज्जान्वितस्यैव शोकव्याकुलचेतसः ।\nप्रवेशं विस्तरेण त्वं वैशम्पायन कीर्तय \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2134950, "chapter_id": 3918, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2134951, "chapter_id": 3918, "verse_number": "५", "content_sanskrit": "धर्मराजनिसृष्टस्तु धार्तराष्ट्रः सुयोधनः ।\nलज्जयाऽधोमुखः सीदन्नुपासर्पत्सुदुःखितः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2134952, "chapter_id": 3918, "verse_number": "६", "content_sanskrit": "स्वपुरं प्रययौ राजा चतुरङ्गबलानुगः ।\nशोकोपहतया बुद्ध्या चिन्तयानः पराभवम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2134953, "chapter_id": 3918, "verse_number": "७", "content_sanskrit": "विमुच्य पथि यानानि देशे सुयवसोदके ।\nसन्निविष्टः शुभे रम्ये भूमिभागे यथेप्सितम् ।\nहस्त्यश्वरथपादातं यथास्थानं न्यवेशयत् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2134954, "chapter_id": 3918, "verse_number": "८", "content_sanskrit": "अथोपविष्टं राजानं पर्यङ्के ज्वलनप्रभे ।\nउपप्लुतं यथा सोमं राहुणा रात्रिसङ्क्षये \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2134955, "chapter_id": 3918, "verse_number": "९", "content_sanskrit": "उपागम्याब्रवीत् कर्णो दुर्योधनमिदं तदा \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2134956, "chapter_id": 3918, "verse_number": "१०", "content_sanskrit": "दिष्ट्या जीवसि गान्धारे दिष्ट्या नः सङ्गमः पुनः ।\nदिष्ट्या त्वया जिताश्चैव गन्धर्वाः कामरूपिणः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2134957, "chapter_id": 3918, "verse_number": "११", "content_sanskrit": "दिष्ट्या समग्रान् पश्यामि भ्रातॄंस्ते कुरुनन्दन ।\nविजिगीषून् रणे युक्तान् निर्जितारीन् महारथान् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2134958, "chapter_id": 3918, "verse_number": "१२", "content_sanskrit": "अहं त्वभिद्रुतः सर्वैर्गन्धर्वैः पश्यतस्तव ।\nनाशक्नुवं धारयितुं दीर्यमाणां च वाहिनीम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2134959, "chapter_id": 3918, "verse_number": "१३", "content_sanskrit": "शरक्षताङ्गस्तु भृशं व्यपयातोऽभिपीडितः ।\nइदं त्वत्यद्भुतं मन्ये यद् युष्मानिह भारत \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2134960, "chapter_id": 3918, "verse_number": "१४", "content_sanskrit": "अरिष्टानक्षतांश्चापि सदारबलवाहनान् ।\nविमुक्तान् सम्प्रपश्यामि युद्धात् तस्मादमानुषात्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2134961, "chapter_id": 3918, "verse_number": "१५", "content_sanskrit": "नैतस्य कर्ता लोकेऽस्मिन् पुमान् भारत विद्यते ।\nयत्कृतं ते महाराज सह भ्रातृभिराहवे \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2134962, "chapter_id": 3918, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2134963, "chapter_id": 3918, "verse_number": "१६", "content_sanskrit": "एवमुक्तस्तु कर्णेन राजा दुर्योधनस्तदा ।\nउवाच चाङ्गराजानं बाष्पगद्गदया गिरा \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2134964, "chapter_id": 3918, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि घोषयात्रापर्वणि कर्णदुर्योधनसंवादे षट्त्रिंशदधिकद्विशततमोऽध्यायः ॥२३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2134965, "chapter_id": 3918, "verse_number": "", "content_sanskrit": "प्रायोपवेशपर्वणि प्रथमोऽध्यायः ॥१॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]