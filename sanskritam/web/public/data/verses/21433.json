[{"id": 7001433000, "chapter_id": 21433, "verse_number": "७-१-६-१", "content_sanskrit": "मुनय ऊचुः ।\nयो ऽयं पशुरिति प्रोक्तो यश्च पाश उदाहृतः ।\nअभ्यां विलक्षणः कश्चित्कोयमस्ति तयोः पतिः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001433001, "chapter_id": 21433, "verse_number": "७-१-६-२", "content_sanskrit": "वायुरुवाच ।\nअस्ति कश्चिदपर्यंतरमणीयगुणाश्रयः ।\nपतिर्विश्वस्य निर्माता पशुपाशविमोचनः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001433002, "chapter_id": 21433, "verse_number": "७-१-६-३", "content_sanskrit": "अभावे तस्य विश्वस्य सृष्टिरेषा कथं भवेत् ।\nअचेतनत्वादज्ञानादनयोः पशुपाशयोः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001433003, "chapter_id": 21433, "verse_number": "७-१-६-४", "content_sanskrit": "प्रधानपरमाण्वादि यावत्किंचिदचेतनम् ।\nतत्कर्तृकं स्वयं दृष्टं बुद्धिमत्कारणं विना॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001433004, "chapter_id": 21433, "verse_number": "७-१-६-५", "content_sanskrit": "जगच्च कर्तृसापेक्षं कार्यं सावयवं यतः ।\nतस्मात्कार्यस्य कर्तृत्वं पत्युर्न पशुपाशयोः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001433005, "chapter_id": 21433, "verse_number": "७-१-६-६", "content_sanskrit": "पशोरपि च कर्तृत्वं पत्युः प्रेरणपूर्वकम् ।\nअयथाकरणज्ञानमंधस्य गमनं यथा॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001433006, "chapter_id": 21433, "verse_number": "७-१-६-७", "content_sanskrit": "आत्मानं च पृथङ्मत्वा प्रेरितारं ततः पृथक् ।\nअसौ जुष्टस्ततस्तेन ह्यमृतत्वाय कल्पते॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001433007, "chapter_id": 21433, "verse_number": "७-१-६-८", "content_sanskrit": "पशोः पाशस्य पत्युश्च तत्त्वतो ऽस्ति पदं परम् ।\nब्रह्मवित्तद्विदित्वैव योनिमुक्तो भविष्यति॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001433008, "chapter_id": 21433, "verse_number": "७-१-६-९", "content_sanskrit": "संयुक्तमेतद्द्वितयं क्षरमक्षरमेव च ।\nव्यक्ताव्यक्तं बिभर्तीशो विश्वं विश्वविमोचकः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001433009, "chapter_id": 21433, "verse_number": "७-१-६-१०", "content_sanskrit": "भोक्ता भोग्यं प्रेरयिता मंतव्यं त्रिविधं स्मृतम् ।\nनातः परं विजानद्भिर्वेदितव्यं हि किंचनः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001433010, "chapter_id": 21433, "verse_number": "७-१-६-११", "content_sanskrit": "तिलेषु वा यथा तैलं दध्नि वा सर्पिरर्पितम् ।\nयथापः स्रोतसि व्याप्ता यथारण्यां हुताशनः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001433011, "chapter_id": 21433, "verse_number": "७-१-६-१२", "content_sanskrit": "एवमेव महात्मानमात्मन्यात्मविलक्षणम् ।\nसत्येन तपसा चैव नित्ययुक्तो ऽनुपश्यति॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001433012, "chapter_id": 21433, "verse_number": "७-१-६-१३", "content_sanskrit": "य एको जालवानीश ईशानीभिस्स्वशक्तिभिः ।\nसर्वांल्लोकानिमान् कृत्वा एक एव स ईशते १॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001433013, "chapter_id": 21433, "verse_number": "७-१-६-१४", "content_sanskrit": "एक एव तदा रुद्रो न द्वितीयो ऽस्ति कश्चन ।\nसंसृज्य विश्वभुवनं गोप्ता ते संचुकोच यः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001433014, "chapter_id": 21433, "verse_number": "७-१-६-१५", "content_sanskrit": "विश्वतश्चक्षुरेवायमुतायं विश्वतोमुखः ।\nतथैव विश्वतोबाहुविश्वतः पादसंयुतः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001433015, "chapter_id": 21433, "verse_number": "७-१-६-१६", "content_sanskrit": "द्यावाभूमी च जनयन् देव एको महेश्वरः ।\nस एव सर्वदेवानां प्रभवश्चोद्भवस्तथा॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001433016, "chapter_id": 21433, "verse_number": "७-१-६-१७", "content_sanskrit": "हिरण्यगर्भं देवानां प्रथमं जनयेदयम् ।\nविश्वस्मादधिको रुद्रो महर्षिरिति हि श्रुतिः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001433017, "chapter_id": 21433, "verse_number": "७-१-६-१८", "content_sanskrit": "वेदाहमेतं पुरुषं महांतममृतं ध्रुवम् ।\nआदित्यवर्णं तमसः परस्तात्संस्थितं प्रभुम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001433018, "chapter_id": 21433, "verse_number": "७-१-६-१९", "content_sanskrit": "अस्मान्नास्ति परं किंचिदपरं परमात्मनः ।\nनाणीयो ऽस्ति न च ज्यायस्तेन पूर्णमिदं जगत्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001433019, "chapter_id": 21433, "verse_number": "७-१-६-२०", "content_sanskrit": "सर्वाननशिरोग्रीवः सर्वभूतगुहाशयः ।\nसर्वव्यापी च भगवांस्तस्मात्सर्वगतश्शिवः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001433020, "chapter_id": 21433, "verse_number": "७-१-६-२१", "content_sanskrit": "सर्वतः पाणिपादो ऽयं सर्वतो ऽक्षिशिरोमुखः ।\nसर्वतः श्रुतिमांल्लोके सर्वमावृत्य तिष्ठति॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001433021, "chapter_id": 21433, "verse_number": "७-१-६-२२", "content_sanskrit": "सर्वेन्द्रियगुणाभासस्सर्वेन्द्रियविवर्जितः ।\nसर्वस्य प्रभुरीशानः सर्वस्य शरणं सुहृत्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001433022, "chapter_id": 21433, "verse_number": "७-१-६-२३", "content_sanskrit": "अचक्षुरपि यः पश्यत्यकर्णो ऽपि शृणोति यः ।\nसर्वं वेत्ति न वेत्तास्य तमाहुः पुरुषं परम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001433023, "chapter_id": 21433, "verse_number": "७-१-६-२४", "content_sanskrit": "अणोरणीयान्महतो महीयानयमव्ययः ।\nगुहायां निहितश्चापि जंतोरस्य महेश्वरः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001433024, "chapter_id": 21433, "verse_number": "७-१-६-२५", "content_sanskrit": "तमक्रतुं क्रतुप्रायं महिमातिशयान्वितम् ।\nधातुः प्रसादादीशानं वीतशोकः प्रपश्यति॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001433025, "chapter_id": 21433, "verse_number": "७-१-६-२६", "content_sanskrit": "वेदाहमेनमजरं पुराणं सर्वगं विभुम् ।\nनिरोधं जन्मनो यस्य वदंति ब्रह्मवादिनः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001433026, "chapter_id": 21433, "verse_number": "७-१-६-२७", "content_sanskrit": "एको ऽपि त्रीनिमांल्लोकान् बहुधा शक्तियोगतः ।\nविदधाति विचेत्यंते १ विश्वमादौ महेश्वरः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001433027, "chapter_id": 21433, "verse_number": "७-१-६-२८", "content_sanskrit": "विश्वधात्रीत्यजाख्या च शैवी चित्रा कृतिः परा ।\nतामजां लोहितां शुक्लां कृष्णामेकां त्वजः प्रजाम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001433028, "chapter_id": 21433, "verse_number": "७-१-६-२९", "content_sanskrit": "जनित्रीमनुशेते ऽन्योजुषमाणस्स्वरूपिणीम् ।\nतामेवाजामजो ऽन्यस्तु भक्तभोगा जहाति च॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001433029, "chapter_id": 21433, "verse_number": "७-१-६-३०", "content_sanskrit": "द्वौ सुपर्णौ च सयुजौ समानं वृक्षमास्थितौ ।\nएको ऽत्ति पिप्पलं स्वादु परो ऽनश्नन् प्रपश्यति॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001433030, "chapter_id": 21433, "verse_number": "७-१-६-३१", "content_sanskrit": "वृक्षेस्मिन् पुरुषो मग्नो गुह्यमानश्च शोचति ।\nजुष्टमन्यं यदा पश्येदीशं परमकारणम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001433031, "chapter_id": 21433, "verse_number": "७-१-६-३२", "content_sanskrit": "तदास्य महिमानं च वीतशोकस्सुखी भवेत् ।\nछंदांसि यज्ञाः ऋतवो यद्भूतं भव्यमेव च॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001433032, "chapter_id": 21433, "verse_number": "७-१-६-३३", "content_sanskrit": "मायी विश्वं सृजत्यस्मिन्निविष्टो मायया परः ।\nमायां तु प्रकृतिं विद्यान्मायिनं तु महेश्वरम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001433033, "chapter_id": 21433, "verse_number": "७-१-६-३४", "content_sanskrit": "तस्यास्त्ववयवैरेव व्याप्तं सर्वमिदं जगत् ।\nसूक्ष्मातिसूक्ष्ममीशानं कललस्यापि मध्यतः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001433034, "chapter_id": 21433, "verse_number": "७-१-६-३५", "content_sanskrit": "स्रष्टारमपि विश्वस्य वेष्टितारं च तस्य तु ।\nशिवमेवेश्वरं ज्ञात्वा शांतिमत्यंतमृच्छति॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001433035, "chapter_id": 21433, "verse_number": "७-१-६-३६", "content_sanskrit": "स एव कालो गोप्ता च विश्वस्याधिपतिः प्रभुः ।\nतं विश्वाधिपतिं ज्ञात्वा मृत्युपाशात्प्रमुच्यते॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001433036, "chapter_id": 21433, "verse_number": "७-१-६-३७", "content_sanskrit": "घृतात्परं मंडमिव सूक्ष्मं ज्ञात्वा स्थितं प्रभुम् ।\nसर्वभूतेषु गूढं च सर्वपापैः प्रमुच्यते॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001433037, "chapter_id": 21433, "verse_number": "७-१-६-३८", "content_sanskrit": "एष एव परो देवो विश्वकर्मा महेश्वरः ।\nहृदये संनिविष्टं तं ज्ञात्वैवामृतमश्नुते॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001433038, "chapter_id": 21433, "verse_number": "७-१-६-३९", "content_sanskrit": "यदा समस्तं न दिवा न रात्रिर्न सदप्यसत् ।\nकेवलश्शिव एवैको यतः प्रज्ञा पुरातनी॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001433039, "chapter_id": 21433, "verse_number": "७-१-६-४०", "content_sanskrit": "नैनमूर्ध्वं न तिर्यक्च न मध्यं पर्यजिग्रहत् ।\nन तस्य प्रतिमा चास्ति यस्य नाम महद्यशः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001433040, "chapter_id": 21433, "verse_number": "७-१-६-४१", "content_sanskrit": "अजातमिममेवैके बुद्धा जन्मनि भीरवः ।\nरुद्रस्यास्य प्रपद्यंते रक्षार्थं दक्षिणं सुखम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001433041, "chapter_id": 21433, "verse_number": "७-१-६-४२", "content_sanskrit": "द्वे अक्षरे ब्रह्मपरे त्वनंते समुदाहृते ।\nविद्याविद्ये समाख्याते निहिते यत्र गूढवत्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001433042, "chapter_id": 21433, "verse_number": "७-१-६-४३", "content_sanskrit": "क्षरं त्वविद्या ह्यमृतं विद्येति परिगीयते ।\nते उभे ईशते यस्तु सो ऽन्यः खलु महेश्वरः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001433043, "chapter_id": 21433, "verse_number": "७-१-६-४४", "content_sanskrit": "एकैकं बहुधा जालं विकुर्वन्नेकवच्च यः ।\nसर्वाधिपत्यं कुरुते सृष्ट्वा सर्वान् प्रतापवान्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001433044, "chapter_id": 21433, "verse_number": "७-१-६-४५", "content_sanskrit": "दिश ऊर्ध्वमधस्तिर्यक्भासयन् भ्राजते स्वयम् ।\nयो निःस्वभावादप्येको वरेण्यस्त्वधितिष्ठति॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001433045, "chapter_id": 21433, "verse_number": "७-१-६-४६", "content_sanskrit": "स्वभाववाचकान् सर्वान् वाच्यांश्च परिणामयन् ।\nगुणांश्च भोग्यभोक्तृत्वे तद्विश्वमधितिष्ठति॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001433046, "chapter_id": 21433, "verse_number": "७-१-६-४७", "content_sanskrit": "ते वै गुह्योपणिषदि गूढं ब्रह्म परात्परम् ।\nब्रह्मयोनिं जगत्पूर्वं विदुर्देवा महर्षयः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001433047, "chapter_id": 21433, "verse_number": "७-१-६-४८", "content_sanskrit": "भावग्राह्यमनीहाख्यं भावाभावकरं शिवम् ।\nकलासर्गकरं देवं ये विदुस्ते जहुस्तनुम्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001433048, "chapter_id": 21433, "verse_number": "७-१-६-४९", "content_sanskrit": "स्वभावमेके मन्यंते कालमेके विमोहिताः ।\nदेवस्य महिमा ह्येष येनेदं भ्राम्यते जगत्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001433049, "chapter_id": 21433, "verse_number": "७-१-६-५०", "content_sanskrit": "येनेदमावृतं नित्यं कालकालात्मना यतः ।\nतेनेरितमिदं कर्म भूतैः सह विवर्तते॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001433050, "chapter_id": 21433, "verse_number": "७-१-६-५१", "content_sanskrit": "तत्कर्म भूयशः कृत्वा विनिवृत्य च भूयशः ।\nतत्त्वस्य सह तत्त्वेन योगं चापि समेत्य वै॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001433051, "chapter_id": 21433, "verse_number": "७-१-६-५२", "content_sanskrit": "अष्टाभिश्च त्रिभिश्चैवं द्वाभ्यां चैकेन वा पुनः ।\nकालेनात्मगुणैश्चापि कृत्स्नमेव जगत्स्वयम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001433052, "chapter_id": 21433, "verse_number": "७-१-६-५३", "content_sanskrit": "गुणैरारभ्य कर्माणि स्वभावादीनि योजयेत् ।\nतेषामभावे नाशः स्यात्कृतस्यापि च कर्मणः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001433053, "chapter_id": 21433, "verse_number": "७-१-६-५४", "content_sanskrit": "कर्मक्षये पुनश्चान्यत्ततो याति स तत्त्वतः ।\nस एवादिस्स्वयं योगनिमित्तं भोक्तृभोगयोः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001433054, "chapter_id": 21433, "verse_number": "७-१-६-५५", "content_sanskrit": "परस्त्रिकालादकलस्स एव परमेश्वरः ।\nसर्ववित्त्रिगुणाधीशो ब्रह्मसाक्षात्परात्परः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001433055, "chapter_id": 21433, "verse_number": "७-१-६-५६", "content_sanskrit": "तं विश्वरूपमभवं भवमीड्यं प्रजापतिम् ।\nदेवदेवं जगत्पूज्यं स्वचित्तस्थमुपास्महे॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001433056, "chapter_id": 21433, "verse_number": "७-१-६-५७", "content_sanskrit": "कालादिभिः परो यस्मात्प्रपञ्चः परिवर्तते ।\nधर्मावहं पापनुदं भोगेशं विश्वधाम च॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001433057, "chapter_id": 21433, "verse_number": "७-१-६-५८", "content_sanskrit": "तमीश्वराणां परमं महेश्वरं तं देवतानां परमं च दैवतम् ।\nपतिं पतीनां परमं परस्ताद्विदाम देवं भुवनेश्वरेश्वरम्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001433058, "chapter_id": 21433, "verse_number": "७-१-६-५९", "content_sanskrit": "न तस्य विद्येत कार्यं कारणं च न विद्यते ।\nन तत्समो ऽधिकश्चापि क्वचिज्जगति दृश्यते॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001433059, "chapter_id": 21433, "verse_number": "७-१-६-६०", "content_sanskrit": "परास्य विविधा शक्तिः श्रुतौ स्वाभाविकी श्रुता ।\nज्ञानं बलं क्रिया चैव याभ्यो विश्वमिदं कृतम्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001433060, "chapter_id": 21433, "verse_number": "७-१-६-६१", "content_sanskrit": "तस्यास्ति पतिः कश्चिन्नैव लिंगं न चेशिता ।\nकारणं कारणानां च स तेषामधिपाधिपः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001433061, "chapter_id": 21433, "verse_number": "७-१-६-६२", "content_sanskrit": "न चास्य जनिता कश्चिन्न च जन्म कुतश्चन ।\nन जन्महेतवस्तद्वन्मलमायादिसंज्ञकाः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001433062, "chapter_id": 21433, "verse_number": "७-१-६-६३", "content_sanskrit": "स एकस्सर्वभूतेषु गूढो व्याप्तश्च विश्वतः ।\nसर्वभूतांतरात्मा च धर्माध्यक्षस्स कथ्यते॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001433063, "chapter_id": 21433, "verse_number": "७-१-६-६४", "content_sanskrit": "सर्वभूताधिवासश्च साक्षी चेता च निर्गुणः ।\nएको वशी निष्क्रियाणां बहूनां विवशात्मनाम्॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001433064, "chapter_id": 21433, "verse_number": "७-१-६-६५", "content_sanskrit": "नित्यानामप्यसौ नित्यश्चेतनानां च चेतनः ।\nएको बहूनां चाकामः कामानीशः प्रयच्छति॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001433065, "chapter_id": 21433, "verse_number": "७-१-६-६६", "content_sanskrit": "सांख्ययोगाधिगम्यं यत्कारणं जगतां पतिम् ।\nज्ञात्वा देवं पशुः पाशैस्सर्वैरेव विमुच्यते॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001433066, "chapter_id": 21433, "verse_number": "७-१-६-६७", "content_sanskrit": "विश्वकृद्विश्ववित्स्वात्मयोनिज्ञः कालकृद्गुणी ।\nप्रधानः क्षेत्रज्ञपतिर्गुणेशः पाशमोचकः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001433067, "chapter_id": 21433, "verse_number": "७-१-६-६८", "content_sanskrit": "ब्रह्माणं विदधे पूर्वं वेदांश्चोपादिशत्स्वयम् ।\nयो देवस्तमहं बुद्ध्वा स्वात्मबुद्धिप्रसादतः॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001433068, "chapter_id": 21433, "verse_number": "७-१-६-६९", "content_sanskrit": "मुमुक्षुरस्मात्संसारात्प्रपद्ये शरणं शिवम् ।\nनिष्फलं निष्क्रियं शांतं निरवद्यं निरंजनम्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001433069, "chapter_id": 21433, "verse_number": "७-१-६-७०", "content_sanskrit": "अमृतस्य परं सेतुं दग्धेंधनमिवानिलम् ।\nयदा चर्मवदाकाशं वेष्टयिष्यंति मानवाः॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001433070, "chapter_id": 21433, "verse_number": "७-१-६-७१", "content_sanskrit": "तदा शिवमविज्ञाय दुःखस्यांतो भविष्यति ।\nतपःप्रभावाद्देवस्य प्रसादाच्च महर्षयः॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001433071, "chapter_id": 21433, "verse_number": "७-१-६-७२", "content_sanskrit": "अत्याश्रमोचितज्ञानं पवित्रं पापनाशनम् ।\nवेदांते परमं गुह्यं पुराकल्पप्रचोदितम्॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001433072, "chapter_id": 21433, "verse_number": "७-१-६-७३", "content_sanskrit": "ब्रह्मणो वदनाल्लब्धं मयेदं भाग्यगौरवात् ।\nनाप्रशांताय दातव्यमेतज्ज्ञानमनुत्तमम्॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001433073, "chapter_id": 21433, "verse_number": "७-१-६-७४", "content_sanskrit": "न पुत्रायाशुवृत्ताय नाशिष्याय च सर्वथा ।\nयस्य देवे पराभक्तिर्यथा देवे तथा गुरौ॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001433074, "chapter_id": 21433, "verse_number": "७-१-६-७५", "content_sanskrit": "तस्यैते कथिताह्यर्थाः प्रकाशंते महात्मनः ।\nअतश्च संक्षेपमिदं शृणुध्वं शिवः परस्तात्प्रकृतेश्च पुंसः॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001433075, "chapter_id": 21433, "verse_number": "७-१-६-७६", "content_sanskrit": "स सर्गकाले च करोति सर्वं संहारकाले पुनराददाति॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}]