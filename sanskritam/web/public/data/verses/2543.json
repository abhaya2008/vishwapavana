[{"id": 2073043, "chapter_id": 2543, "verse_number": "१२-४८-०x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2073044, "chapter_id": 2543, "verse_number": "१२-४८-१", "content_sanskrit": "शृणु कौन्तेय रामस्य प्रभावो यो मया श्रुतः।\nमहर्षीणां कथयतां कारणं तस्य जन्म च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2073045, "chapter_id": 2543, "verse_number": "१२-४८-२", "content_sanskrit": "यथा च जामदग्न्येन कोटिशः क्षत्रिया हताः।\nउद्भूता राजवंशेषु ये भूयो भारते हताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2073046, "chapter_id": 2543, "verse_number": "१२-४८-३", "content_sanskrit": "जह्नोरजस्तु तनयो बलाकाश्चस्तु तत्सुतः।\nकुशिको नाम धर्मज्ञस्तस्य पुत्रो महीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2073047, "chapter_id": 2543, "verse_number": "१२-४८-४", "content_sanskrit": "अग्र्यं तपः समातिष्ठत्सहस्राक्षसमो भुवि।\nपुत्रं लभेयमजितं त्रिलोकेश्वरमित्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2073048, "chapter_id": 2543, "verse_number": "१२-४८-५", "content_sanskrit": "तमुग्रतपसं दृष्ट्वा सहस्राक्षः पुरंदरः।\nसमर्थं पुत्रजनने स्वयमेवैत्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2073049, "chapter_id": 2543, "verse_number": "१२-४८-६", "content_sanskrit": "पुत्रत्वमगमद्राजंस्तस्य लोकेश्वरेश्वरः।\nगाधिर्नामाभवत्पुत्रः कौशिकः पाकशासनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2073050, "chapter_id": 2543, "verse_number": "१२-४८-७", "content_sanskrit": "तस्य कन्याऽभवद्राजन्नाम्ना सत्यवती प्रभो।\nतां गाधिर्भृगुपुत्राय ऋचीकाय ददौ प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2073051, "chapter_id": 2543, "verse_number": "१२-४८-८", "content_sanskrit": "ततस्तया हि कौन्तेय भार्गवः कुरुनदनः।\nपुत्रार्थं श्रपयामास चरुं गाधेस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2073052, "chapter_id": 2543, "verse_number": "१२-४८-९", "content_sanskrit": "आहूय चाह तां भार्यामृचीको भार्गवस्तदा।\nउपयोज्यश्चरुरयं त्वया मात्राऽप्ययं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2073053, "chapter_id": 2543, "verse_number": "१२-४८-१०", "content_sanskrit": "तस्या जनिष्यते पुत्रो दीप्तिमान्क्षत्रियर्षभः।\nअजय्यः क्षत्रियैर्लोके क्षत्रियर्षभसूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2073054, "chapter_id": 2543, "verse_number": "१२-४८-११", "content_sanskrit": "तवापि पुत्रं कल्याणि धृतिमन्तं शमात्मकम्।\nतपोन्वितं द्विजश्रेष्ठं चरुरेष विधास्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2073055, "chapter_id": 2543, "verse_number": "१२-४८-१२", "content_sanskrit": "इत्येवमुक्त्वा तां भार्यां सर्चीको भृगुनन्दनः।\nतपस्यभिरतः श्रीमाञ्जगामारण्यमेव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2073056, "chapter_id": 2543, "verse_number": "१२-४८-१३", "content_sanskrit": "एतस्मिन्नेव काले तु तीर्थयात्रापरो नृपः।\nगाधिः सदारः संप्राप्त ऋचीकस्याश्रमं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2073057, "chapter_id": 2543, "verse_number": "१२-४८-१४", "content_sanskrit": "चरुद्वयं गृहीत्वा तु राजन्सत्यवती तदा।\nभर्त्रा दत्तं प्रसन्नेन मात्रे हृष्टा न्यवेदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2073058, "chapter_id": 2543, "verse_number": "१२-४८-१५", "content_sanskrit": "माता तु तस्याः कौन्तेय दुहित्रे स्वं चरुं ददौ।\nतस्याश्ररुमथाज्ञातमात्मसंस्थं चकार ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2073059, "chapter_id": 2543, "verse_number": "१२-४८-१६", "content_sanskrit": "अथ सत्यवती गर्भं क्षत्रियान्तकरं तदा।\nधारयामास दीप्तेन वपुषा घोरदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2073060, "chapter_id": 2543, "verse_number": "१२-४८-१७", "content_sanskrit": "तामृचीकस्तदा दृष्ट्वा ध्यानयोगेन भारत।\nअब्रवीद्भृगुशार्दूलः स्वां भार्यां देवरूपिणीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2073061, "chapter_id": 2543, "verse_number": "१२-४८-१८", "content_sanskrit": "मात्राऽसि व्यंसिता भद्रे चरुव्यत्यासहेतुना।\nतस्माज्जनिष्यते पुत्रः क्रूरकर्माऽत्यमर्षणः।\n`जनयिष्यति माता ते ब्रह्मभूतं तपोधनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2073062, "chapter_id": 2543, "verse_number": "१२-४८-१९", "content_sanskrit": "विश्वं हि ब्रह्म सुमहच्चरौ तव समाहितम्।\nक्षत्रवीर्यं च सकलं तव मात्रे समर्पितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2073063, "chapter_id": 2543, "verse_number": "१२-४८-२०", "content_sanskrit": "विपर्ययेण ते भद्रे नैतदेवं भविष्यति।\nमातुस्ते ब्राह्मणो भूयात्तव च क्षत्रियः सुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2073064, "chapter_id": 2543, "verse_number": "१२-४८-२१", "content_sanskrit": "सैवमुक्ता महाभागा भर्त्रा सत्यवती तदा।\nपपात शिरसा तस्मै वेपन्ती चाब्रवीदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2073065, "chapter_id": 2543, "verse_number": "१२-४८-२२", "content_sanskrit": "नार्होऽसि भगवन्नद्य वक्तुमेवंविधं वचः।\nब्राह्मणापशदं पुत्रं प्राप्स्यसीति हि मां प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2073066, "chapter_id": 2543, "verse_number": "१२-४८-२३x", "content_sanskrit": "ऋचीक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2073067, "chapter_id": 2543, "verse_number": "१२-४८-२३", "content_sanskrit": "नैष संकल्पितः कामो मया भद्रे तथा त्वयि।\nउग्रकर्मा भवेत्पुत्रश्चरुव्यत्यासहेतुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2073068, "chapter_id": 2543, "verse_number": "१२-४८-२४x", "content_sanskrit": "सत्यवत्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2073069, "chapter_id": 2543, "verse_number": "१२-४८-२४", "content_sanskrit": "इच्छँल्लोकानपि मुने सृजेथाः किं पुनः सुतम्।\nशमात्मकमृजुं पुत्रं दातुमर्हसि मे प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2073070, "chapter_id": 2543, "verse_number": "१२-४८-२५x", "content_sanskrit": "ऋचीक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2073071, "chapter_id": 2543, "verse_number": "१२-४८-२५", "content_sanskrit": "नोक्तपूर्वं मया भद्रे स्वैरेष्वप्यनृतं वचः।\nकिमुताग्निं समाधाय मन्त्रवच्चरुसाधने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2073072, "chapter_id": 2543, "verse_number": "१२-४८-२६", "content_sanskrit": "[दृष्टमेतत्पुरा भद्रे ज्ञातं च तपसा मया।\nब्रह्मभूतं हि सकलं पितुस्तव कुलं भवेत्॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2073073, "chapter_id": 2543, "verse_number": "१२-४८-२७x", "content_sanskrit": "सत्यवत्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2073074, "chapter_id": 2543, "verse_number": "१२-४८-२७", "content_sanskrit": "काममेवं भवेत्पौत्रो मामैवं तनयः प्रभो।\nशमात्मकमृजुं पुत्रं लभेयं जपतां वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2073075, "chapter_id": 2543, "verse_number": "१२-४८-२८x", "content_sanskrit": "ऋचीक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2073076, "chapter_id": 2543, "verse_number": "१२-४८-२८", "content_sanskrit": "पुत्रे नास्ति विशेषो मे पौत्रे च वरवर्णिनि।\nयथा त्वयोक्तं वचनं तथा भद्रे भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2073077, "chapter_id": 2543, "verse_number": "१२-४८-२९x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2073078, "chapter_id": 2543, "verse_number": "१२-४८-२९", "content_sanskrit": "ततः सत्यवती पुत्रं जनयामास भार्गवम्।\nतपस्यभिरतं शान्तं जमदग्निं यतव्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2073079, "chapter_id": 2543, "verse_number": "१२-४८-३०", "content_sanskrit": "विश्वामित्रं च दायादं गाधिः कुशिकनन्दनः।\nप्राप ब्रह्मर्षिसमितं विश्वेन ब्रह्मणा युतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2073080, "chapter_id": 2543, "verse_number": "१२-४८-३१", "content_sanskrit": "ऋचीको जनयामास जमदग्निं तपोनिधिम्।\nसोऽपि पुत्रं ह्यजनयज्जमदग्निः सुदारुणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2073081, "chapter_id": 2543, "verse_number": "१२-४८-३२", "content_sanskrit": "सर्वविद्यान्तगं श्रेष्ठं धनुर्वेदस्य पारगम्।\nरामं क्षत्रियहन्तारं प्रदीप्तमिव पावकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2073082, "chapter_id": 2543, "verse_number": "१२-४८-३३", "content_sanskrit": "[तेषयित्वा महादेवं पर्वते गन्धमादने।\nअस्त्राणि वरयामास परशुं चातितेजसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2073083, "chapter_id": 2543, "verse_number": "१२-४८-३४", "content_sanskrit": "स तेनाकुण्ठधारेण ज्वलितानलवर्चसा।\nकुठारेणाप्रमेयेण लोकेष्वप्रतिमोऽभवत्॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2073084, "chapter_id": 2543, "verse_number": "१२-४८-३५", "content_sanskrit": "एतस्मिन्नेव काले तु कृतवीर्यात्मजो बली।\nअर्जुनो नाम तेजस्वी क्षत्रियो हैहयाधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2073085, "chapter_id": 2543, "verse_number": "१२-४८-३६", "content_sanskrit": "दत्तात्रेयप्रसादेन राजा बाहुसहस्रवान्।\nचक्रवर्ती महातेजा विप्राणामाश्वमेधिके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2073086, "chapter_id": 2543, "verse_number": "१२-४८-३७", "content_sanskrit": "ददौ स पृथिवीं सर्वां सप्तद्वीपां सपर्वताम्।\nसबाह्वस्त्रबलेनाजौ जित्वा परमधर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2073087, "chapter_id": 2543, "verse_number": "१२-४८-३८", "content_sanskrit": "तृषितेन च कौन्तेय भिक्षितश्चित्रभानुना।\nसहस्त्रबाहुर्विक्रान्तः प्रादाद्भिक्षामथाग्नये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2073088, "chapter_id": 2543, "verse_number": "१२-४८-३९", "content_sanskrit": "ग्रामान्पुराणि राष्ट्राणि घोषांश्चैव तु वीर्यवान्।\nजज्वाल तस्य वाणेद्धचित्रभानुर्दिधक्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2073089, "chapter_id": 2543, "verse_number": "१२-४८-४०", "content_sanskrit": "स तस्य पुरुषेन्द्रस्य प्रभावेण महौजसः।\nददाह कार्तवीर्यस्य शैलानपि धरामपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2073090, "chapter_id": 2543, "verse_number": "१२-४८-४१", "content_sanskrit": "स शून्यमाश्रमारण्यमापवस्य महात्मनः।\nददाह पवनेनेद्धश्चित्रभानुः सहैहयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2073091, "chapter_id": 2543, "verse_number": "१२-४८-४२", "content_sanskrit": "आपवस्तं ततो रोषाच्छशापार्जुनमच्युत।\nदग्धे श्रमे महाबाहो कार्तवीर्येण वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2073092, "chapter_id": 2543, "verse_number": "१२-४८-४३", "content_sanskrit": "त्वया न वर्जितं यस्मान्ममेदं हि महद्वनम्।\nदग्धं तस्माद्रणे रामो बाहूंस्ते च्छेत्स्यतेऽर्जुन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2073093, "chapter_id": 2543, "verse_number": "१२-४८-४४", "content_sanskrit": "अर्जुनस्तु महातेजा बली नित्यं शमात्मकः।\nब्रह्मण्यश्च शरण्यश्च दाता शूरश्च भारत।\nनाचिन्तयत्तदा शापं तेन दत्तं महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2073094, "chapter_id": 2543, "verse_number": "१२-४८-४५", "content_sanskrit": "तस्य पुत्राः सुबलिनः शापेनासन्पितुर्वधे।\nनिमित्तमवलिप्ता वै नृशंसाश्चैव नित्यदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2073095, "chapter_id": 2543, "verse_number": "१२-४८-४६", "content_sanskrit": "जमदग्नेस्तु धेन्वास्ते वत्समानिन्युरच्युत।\nअज्ञातं कार्तवीर्यस्य हैहयेन्द्रस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2073096, "chapter_id": 2543, "verse_number": "१२-४८-४७", "content_sanskrit": "तन्निमित्तमभूद्युद्धं जामदग्नेर्महात्मनः।\nततोऽर्जुनस्य बाहून्स चिच्छेद रुषितोऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2073097, "chapter_id": 2543, "verse_number": "१२-४८-४८", "content_sanskrit": "तं भ्रमन्तं ततो वत्सं जामदग्न्यः स्वमाश्रमम्।\nप्रत्यानयत राजेन्द्र तेषामन्तः पुरात्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2073098, "chapter_id": 2543, "verse_number": "१२-४८-४९", "content_sanskrit": "अर्जुनस्य सुतास्ते तु संभूयाबुद्धयस्तदा।\nगत्वाऽऽश्रममसंबुद्धा जमदग्नेर्महात्मनः।\nअपातयन्त भल्लाग्रैः शिरः कायान्नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2073099, "chapter_id": 2543, "verse_number": "१२-४८-५०", "content_sanskrit": "समित्कुशार्थं रामस्य निर्यातस्य यशस्विनः।\n`प्रत्यक्षं राममातुश्च तथैवाश्रमवासिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2073100, "chapter_id": 2543, "verse_number": "१२-४८-५१", "content_sanskrit": "श्रुत्वा रामस्तमर्थं च क्रुद्धः कालानलोपमः।\nधनुर्वेदेऽद्वितीयो हि दिव्यास्त्रैः समलंकृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2073101, "chapter_id": 2543, "verse_number": "१२-४८-५२", "content_sanskrit": "चन्द्रबिम्बार्धसंकाशं परशुं गृह्य भार्गवः।\nततः पितृवधामर्षाद्रामः परममन्युमान्।\nनिःक्षत्रियां प्रतिश्रुत्य महीं शस्त्रमगृह्णत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2073102, "chapter_id": 2543, "verse_number": "१२-४८-५३", "content_sanskrit": "ततः स भृगुशार्दूलः कार्तवीर्यस्य वीर्यवान्।\nविक्रम्य निजघानाशु पुत्रान्पौत्रांश्च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2073103, "chapter_id": 2543, "verse_number": "१२-४८-५४", "content_sanskrit": "स हैहयसहस्राणि हत्वा परममन्युमान्।\nमहीं सागरपर्यन्तां चकार रुधिरोक्षिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2073104, "chapter_id": 2543, "verse_number": "१२-४८-५५", "content_sanskrit": "स तथा सुमहातेजाः कृत्वा निःक्षत्रियां महीम्।\nकृपया परयाऽऽविष्टो वनमेव जगाम ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2073105, "chapter_id": 2543, "verse_number": "१२-४८-५६", "content_sanskrit": "ततो वर्षसहस्रेषु समतीतेषु केषुचित्।\nकोपं संप्राप्तवांस्तत्र प्रकृत्या कोपनः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2073106, "chapter_id": 2543, "verse_number": "१२-४८-५७", "content_sanskrit": "विश्वामित्रस्य पौत्रस्तु रैभ्यपुत्रो महातपाः।\nपरावसुर्महाराज क्षिप्त्वाऽऽह जनसंसदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2073107, "chapter_id": 2543, "verse_number": "१२-४८-५८", "content_sanskrit": "ये ते ययातिपतने यज्ञे सन्तः समागताः।\nप्रतर्दनप्रभृतयो राम किं क्षत्रिया न ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2073108, "chapter_id": 2543, "verse_number": "१२-४८-५९", "content_sanskrit": "मिथ्याप्रतिज्ञो राम त्वं कत्थसे जनसंसदि।\nभयात्क्षत्रियवीराणां पर्वतं समुपाश्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2073109, "chapter_id": 2543, "verse_number": "१२-४८-६०", "content_sanskrit": "सा पुनः क्षत्रियशतैः पृथिवी सर्वतः स्तृता।\nपरावसोर्वचः श्रुत्वा शस्त्रं जग्राह भार्गवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2073110, "chapter_id": 2543, "verse_number": "१२-४८-६१", "content_sanskrit": "ततो ये क्षत्रिया राजञ्शतशस्तेन वर्जिताः।\nते विवृद्धा महावीर्याः पृथिवीपतयोऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2073111, "chapter_id": 2543, "verse_number": "१२-४८-६२", "content_sanskrit": "स पुनस्ताञ्जघानाशु बालानपि नराधिप।\nगर्भस्थैस्तु मही व्याप्ता पुनरेवाभवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2073112, "chapter_id": 2543, "verse_number": "१२-४८-६३", "content_sanskrit": "जातंजातं स गर्भं तु पुनरेव जघान ह।\nअरक्षंश्च सुतान्कांश्चित्तदा क्षत्रिययोषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2073113, "chapter_id": 2543, "verse_number": "१२-४८-६४", "content_sanskrit": "त्रिःसप्तकृत्वः पृथिवीं कृत्वा निःक्षत्रियां प्रभुः।\nदक्षिणामश्वमेधान्ते कश्यपायाददत्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2073114, "chapter_id": 2543, "verse_number": "१२-४८-६५", "content_sanskrit": "स क्षत्रियाणां शेषार्थं करेणोद्दिश्य कश्यपः।\nस्रुक्प्रग्रहवता राजंस्ततो वाक्यमथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2073115, "chapter_id": 2543, "verse_number": "१२-४८-६६", "content_sanskrit": "गच्छ पारं समुद्रस्य दक्षिणस्य महामुने।\nन ते मद्विषये राम वस्तव्यमिह कर्हिचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2073116, "chapter_id": 2543, "verse_number": "१२-४८-६७", "content_sanskrit": "`पृथिवी दक्षिणा दत्ता वाजिमेधे मम त्वया।\nपुनरस्याः पृथिव्या हि दत्त्वा दातुमनीश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2073117, "chapter_id": 2543, "verse_number": "१२-४८-६८", "content_sanskrit": "ततः शूर्पाकरं देशं सागरस्तस्य निर्ममे।\nसंत्रासाज्जामदग्न्यस्य सोऽपरान्तमहीतलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2073118, "chapter_id": 2543, "verse_number": "१२-४८-६९", "content_sanskrit": "कश्यपस्तां महाराज प्रतिगृह्य वसुंधराम्।\nकृत्वा ब्राह्मणसंस्थां वै प्रविष्टः सुमहद्वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2073119, "chapter_id": 2543, "verse_number": "१२-४८-७०", "content_sanskrit": "ततः शूद्राश्च वैश्याश्च यथा स्वैरप्रचारिणः।\nअवर्तन्त द्विजाग्र्याणां दारेषु भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2073120, "chapter_id": 2543, "verse_number": "१२-४८-७१", "content_sanskrit": "अराजके जीवलोके दुर्बला बलवत्तरैः।\nवध्यन्ते न हि वित्तेषु प्रभुत्वं कस्यचित्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2073121, "chapter_id": 2543, "verse_number": "१२-४८-७२", "content_sanskrit": "`ब्राह्मणाः क्षत्रिया वैश्याः शृद्राश्चोत्पथगामिनः।\nपरस्परं समाश्रित्य घातयन्त्यपथस्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2073122, "chapter_id": 2543, "verse_number": "१२-४८-७३", "content_sanskrit": "स्वधर्मं ब्राह्मणास्त्यक्त्वा पाषण़्डत्वं समाश्रिताः।\nचौरिकानृतमायाश्च सर्वे चैव प्रकुर्वते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2073123, "chapter_id": 2543, "verse_number": "१२-४८-७४", "content_sanskrit": "स्वधर्मस्थान्द्विजान्हत्वा तथाऽऽश्रमनिवासिनः।\nवैश्याः सत्पथसंस्थाश्च शूद्रा ये चैव धार्मिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2073124, "chapter_id": 2543, "verse_number": "१२-४८-७५", "content_sanskrit": "तान्सर्वान्घातयन्ति स्म दुराचाराः सुनिर्भयाः।\nयज्ञाध्ययनशीलांश्च आश्रमस्थांस्तपस्विनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2073125, "chapter_id": 2543, "verse_number": "१२-४८-७६", "content_sanskrit": "गोबालवृद्धनारीणां नाशं कुर्वन्ति चापरे।\nआन्वीक्षकी त्रयी वार्ता न च नीतिः प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2073126, "chapter_id": 2543, "verse_number": "१२-४८-७७", "content_sanskrit": "व्रात्यतां समनुप्राप्ता बहवो हि द्विजातयः।\nअधरोत्तरापचारेण म्लेच्छभूताश्च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2073127, "chapter_id": 2543, "verse_number": "१२-४८-७८", "content_sanskrit": "ततः कालेन पृथिवी पीड्यमाना दुरात्मभिः।\nविपर्ययेण तेनाशु प्रविवेश पसातलम्।\nअरक्ष्यमाणा विधिवत्क्षत्रियैर्धर्मरक्षिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2073128, "chapter_id": 2543, "verse_number": "१२-४८-७९", "content_sanskrit": "तां दृष्ट्वा द्रवतीं तत्र संत्रासात्स महामनाः।\nऊरुणा धारयामास कश्यपः पृथिवीं ततः।\nनिमज्जन्तीं ततो राजंस्तेनोर्वीति मही स्मृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2073129, "chapter_id": 2543, "verse_number": "१२-४८-८०", "content_sanskrit": "रक्षणार्थं समुद्दिश्य ययाचे पृथिवी तदा।\nप्रसाद्य कश्यपं देवी क्षत्रियान्बाहुशालिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2073130, "chapter_id": 2543, "verse_number": "१२-४८-८१x", "content_sanskrit": "पृथिव्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2073131, "chapter_id": 2543, "verse_number": "१२-४८-८१", "content_sanskrit": "सन्ति ब्रह्मन्मया गुप्ताः स्त्रीषु क्षत्रियपुङ्गवाः।\nहैहयानां कुले जातास्ते संरक्षन्तु मां मुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2073132, "chapter_id": 2543, "verse_number": "१२-४८-८२", "content_sanskrit": "अस्ति पौरवदायादो विदूरथसुतः प्रभो।\nऋक्षैः संवर्धितो विप्र ऋक्षवत्यथ पर्वते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2073133, "chapter_id": 2543, "verse_number": "१२-४८-८३", "content_sanskrit": "तथाऽनुकम्पमानेन यज्वनाथामितौजसा।\nपराशरेण दायादः सौदासस्याभिरक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2073134, "chapter_id": 2543, "verse_number": "१२-४८-८४", "content_sanskrit": "सर्वकर्माणि कुरुते शूद्रवत्तस्य स द्विजः।\nसर्वकर्मेत्यभिख्यातः स मां रक्षतु पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2073135, "chapter_id": 2543, "verse_number": "१२-४८-८५", "content_sanskrit": "शिबिपुत्रो महातेजा गोपतिर्नाम नामतः।\nवने संवर्धितो गोभिः सोऽभिरक्षतु मां मुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2073136, "chapter_id": 2543, "verse_number": "१२-४८-८६", "content_sanskrit": "प्रतर्दनस्य पुत्रस्तु वत्सो नाम महाबलः।\nवत्सैः संवर्धितो गोष्ठे स मां रक्षतु पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2073137, "chapter_id": 2543, "verse_number": "१२-४८-८७", "content_sanskrit": "दधिवाहनपुत्रस्तु पौत्रो दिविरथस्य च।\nअङ्गः स गौतमेनासीद्गङ्गाकूलेऽभिरक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2073138, "chapter_id": 2543, "verse_number": "१२-४८-८८", "content_sanskrit": "बृहद्रथो महातेजा भूरिभूतिपरिष्कृतः।\nगोलाङ्गूलैर्महाभागो गृध्रकूटेऽभिरक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2073139, "chapter_id": 2543, "verse_number": "१२-४८-८९", "content_sanskrit": "मरुत्तस्यान्ववाये च रक्षिताः क्षत्रियात्मजाः।\nमरुत्पतिसमा वीर्ये समुद्रेणाभिरक्षिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2073140, "chapter_id": 2543, "verse_number": "१२-४८-९०", "content_sanskrit": "एते क्षत्रियदायादास्तत्रतत्र परिश्रुताः।\nव्योकारहेमकारादिजातिं नित्यं समाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2073141, "chapter_id": 2543, "verse_number": "१२-४८-९१", "content_sanskrit": "यदि मामभिरक्षन्ति ततः स्थास्यामि निश्चला।\nएतेषां पितरश्चैव तथैव च पितामहाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2073142, "chapter_id": 2543, "verse_number": "१२-४८-९२", "content_sanskrit": "मदर्थं निहता युद्धे रामेणाक्लिष्टकर्मणा।\nतेषामपचितिश्चैव मया कार्या महामुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2073143, "chapter_id": 2543, "verse_number": "१२-४८-९३", "content_sanskrit": "न ह्यहं कामये नित्यमतिक्रान्तेन रक्षणम्।\nवर्तमानेन वर्तेयं तत्क्षिप्रं संविधीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2073144, "chapter_id": 2543, "verse_number": "१२-४८-९४x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2073145, "chapter_id": 2543, "verse_number": "१२-४८-९४", "content_sanskrit": "ततः पृथिव्या निर्दिष्टांस्तान्समानीय कश्यपः।\nअभ्यषिञ्चन्महीपालान्क्षत्रियान्वीर्यसंमतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2073146, "chapter_id": 2543, "verse_number": "१२-४८-९५", "content_sanskrit": "तेषां पुत्राश्च पौत्राश्च येषां वंशाः प्रतिष्ठिताः।\nएवमेतत्पुरावृत्तं यन्मां पृच्छसि पाण़्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2073147, "chapter_id": 2543, "verse_number": "१२-४८-९६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2073148, "chapter_id": 2543, "verse_number": "१२-४८-९६", "content_sanskrit": "एवं ब्रुवंस्तं च यदुप्रवीरो\nयुधिष्ठिरं धर्मभृतां वरिष्ठम्।\nरथेन तेनाशु ययौ यथाऽर्को\nविशन्प्रभाभिर्भगवांस्त्रिलोकीम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2073149, "chapter_id": 2543, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि अष्टचत्वारिंशोऽध्यायः॥ ४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}]