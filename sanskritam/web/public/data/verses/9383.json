[{"id": 5000383000, "chapter_id": 9383, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे चतुश्चत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000383001, "chapter_id": 9383, "verse_number": "५-४४-१", "content_sanskrit": "संदिष्टो राक्षसेन्द्रेण प्रहस्तस्य सुतो बली ।\nजम्बुमाली महादंष्ट्रो निर्जगाम धनुर्धरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000383002, "chapter_id": 9383, "verse_number": "५-४४-२", "content_sanskrit": "रक्तमाल्याम्बरधरः स्रग्वी रुचिरकुण्डलः ।\nमहान् विवृत्तनयनश्चण्डः समरदुर्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000383003, "chapter_id": 9383, "verse_number": "५-४४-३", "content_sanskrit": "धनुः शक्रधनुःप्रख्यं महद्रुचिरसायकम् ।\nविस्फारयानो वेगेन वज्राशनिसमस्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000383004, "chapter_id": 9383, "verse_number": "५-४४-४", "content_sanskrit": "तस्य विस्फारघोषेण धनुषो महता दिशः ।\nप्रदिशश्च नभश्चॆव सहसा समपूर्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000383005, "chapter_id": 9383, "verse_number": "५-४४-५", "content_sanskrit": "रथेन खरयुक्तेन तमागतमुदीक्ष्य सः ।\nहनुमान् वेगसंपन्नो जहर्ष च ननाद च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000383006, "chapter_id": 9383, "verse_number": "५-४४-६", "content_sanskrit": "तं तोरणविटङ्कस्थं हनुमन्तं महाकपिम् ।\nजम्बुमाली महाबाहुर्विव्याध निशितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000383007, "chapter_id": 9383, "verse_number": "५-४४-७", "content_sanskrit": "अर्धचन्द्रेण वदने शिरस्येकेन कर्णिना ।\nबाह्वोर्विव्याध नाराचैर्दशभिस्तं कपीश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000383008, "chapter_id": 9383, "verse_number": "५-४४-८", "content_sanskrit": "तस्य तच्छुशुभे ताम्रं शरेणाभिहतं मुखम् ।\nशरदीवाम्बुजम्फुल्लं विद्धं भास्कररश्मिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000383009, "chapter_id": 9383, "verse_number": "५-४४-९", "content_sanskrit": "तत्तस्य रक्तं रक्तेन रञ्जितं शुशुभे मुखम् ।\nयथाकाशे महापद्मं सिक्तं चन्दनबिन्दुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000383010, "chapter_id": 9383, "verse_number": "५-४४-१०", "content_sanskrit": "चुकोप बाणाभिहतो राक्षसस्य महाकपिः ।\nततः पार्श्वेतिविपुलां ददर्श महतीं शिलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000383011, "chapter_id": 9383, "verse_number": "५-४४-११", "content_sanskrit": "तरसा तां समुत्पाट्य चिक्षेप बलवद्बली ।\nतां शरैर्दशभिः क्रुद्धस्ताडयामास राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000383012, "chapter_id": 9383, "verse_number": "५-४४-१२", "content_sanskrit": "विपन्नं कर्म तद्दृष्ट्वा हनुमांश्चण्डविक्रमः ।\nसालं विपुलमुत्पाट्य भ्रामयामास वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000383013, "chapter_id": 9383, "verse_number": "५-४४-१३", "content_sanskrit": "भ्रामयन्तं कपिं दृष्ट्वा सालवृक्षं महाबलम् ।\nचिक्षेप सुबहून् बाणान् जम्बुमाली महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000383014, "chapter_id": 9383, "verse_number": "५-४४-१४", "content_sanskrit": "सालं चतुर्भिश्चिच्छेद वानरं पञ्चभिर्भुजे ।\nशिरस्येकेन बाणेन दशभिस्तु स्तनान्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000383015, "chapter_id": 9383, "verse_number": "५-४४-१५", "content_sanskrit": "स शरैः पूरिततनुः क्रोधेन महता वृतः ।\nतमेव परिघं गृह्य भ्रामयामास वेगतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000383016, "chapter_id": 9383, "verse_number": "५-४४-१६", "content_sanskrit": "अतिवेगोतिवेगेन भ्रामयित्वा बलोत्कटः ।\nपरिघं पातयामास जम्बुमालेर्महोरसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000383017, "chapter_id": 9383, "verse_number": "५-४४-१७", "content_sanskrit": "तस्य चैव शिरो नास्ति न बाहू न च जानुनी ।\nन धनुर्नरथो नाश्वास्तत्रादृश्यन्त नेषवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000383018, "chapter_id": 9383, "verse_number": "५-४४-१८", "content_sanskrit": "स हतस्तरसा तेन जम्बुमाली महाबलः ।\nपपात निहतो भूवौ चूर्णिताङ्गविभूषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000383019, "chapter_id": 9383, "verse_number": "५-४४-१९", "content_sanskrit": "जम्बुमालिं च निहतं किङ्करांश्च महाबलान् ।\nचुक्रोध रावणः श्रुत्वा कोपसंरक्त लोचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000383020, "chapter_id": 9383, "verse_number": "५-४४-२०", "content_sanskrit": "स रोषसंवर्तितताम्रलोचनः\nप्रहस्त पुत्रे निहते महाबले ।\nअमात्यपुत्रानतिवीर्यविक्रमान्\nसमादिदेशाशु निशाचरेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000383021, "chapter_id": 9383, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे चतुश्चत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]