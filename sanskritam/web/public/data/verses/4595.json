[{"id": 2167415, "chapter_id": 4595, "verse_number": "", "content_sanskrit": "भीमाश्वत्थाम्नोर्युद्धम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2167416, "chapter_id": 4595, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2167417, "chapter_id": 4595, "verse_number": "१", "content_sanskrit": "भीमसेनं ततो राजन् द्रौणिर्विव्याध पत्रिणा ।\nत्वरया परया युक्तो दर्शयन्नस्त्रलाघवम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2167418, "chapter_id": 4595, "verse_number": "२", "content_sanskrit": "अथैनं पुनराजघ्ने नवत्या निशितैः शरैः ।\nसर्वमर्माणि सम्प्रेक्ष्य मर्मज्ञो लघुहस्तवत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2167419, "chapter_id": 4595, "verse_number": "३", "content_sanskrit": "भीमसेनः समाकीर्णो द्रौणिना निशितैः शरैः ।\nरराज समरे राजन् रश्मिमानिव भास्करः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2167420, "chapter_id": 4595, "verse_number": "४", "content_sanskrit": "ततः शरसहस्रेण सुप्रयुक्तेन पाण्डवः ।\nद्रोणपुत्रमवच्छाद्य सिंहनादमथानदत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2167421, "chapter_id": 4595, "verse_number": "५", "content_sanskrit": "शरैः शरांस्तथा द्रौणिः संवार्य युधि पाण्डवम् ।\nललाटेऽभ्यहनद् राजन् नाराचेन स्मयन्निव\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2167422, "chapter_id": 4595, "verse_number": "६", "content_sanskrit": "ललाटस्थं ततो बाणं धारयामास पाण्डवः ।\nयथा शृङ्गं वने दृप्तः खड्गो धारयते नृप\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2167423, "chapter_id": 4595, "verse_number": "७", "content_sanskrit": "ततो द्रौणिं रणे भीमो स्मयमानः पराक्रमी ।\nत्रिभिर्विव्याध नाराचैर्ललाटे विस्मयन्निव\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2167424, "chapter_id": 4595, "verse_number": "८", "content_sanskrit": "ललाटस्थैस्त्रिभिर्बाणैरश्वत्थामा व्यरोचत ।\nप्रावृष्यम्बुपरिक्षिप्तः त्रिशृङ्ग इव पर्वतः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2167425, "chapter_id": 4595, "verse_number": "९", "content_sanskrit": "ततः शरशतैर्द्रौणिरर्दयामास पाण्डवम् ।\nन चैनं कम्पयामास मातरिश्वेव पर्वतम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2167426, "chapter_id": 4595, "verse_number": "१०", "content_sanskrit": "तथैव पाण्डवो युद्धे द्रौणिं शरशतैः शितैः ।\nनाकम्पयत संहृष्टो वार्योघ इव पर्वतम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2167427, "chapter_id": 4595, "verse_number": "११", "content_sanskrit": "तावन्योन्यं शरैर्घोरैश्छादयन्तौ महारथौ ।\nरथचर्यागतौ वीरौ शुशुभाते नरर्षभौ\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2167428, "chapter_id": 4595, "verse_number": "१२", "content_sanskrit": "आदित्याविव सन्दीप्तौ लोकक्षयकरावुभौ ।\nस्वरश्मिभिरिवान्योन्यं तापयन्तौ शरोत्तमैः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2167429, "chapter_id": 4595, "verse_number": "१३", "content_sanskrit": "कृतप्रतिकृते यत्नं कुर्वाणौ तौ महारथौ ।\nकृतप्रतिकृते चैव बाणसङ्घैरभीतवत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2167430, "chapter_id": 4595, "verse_number": "१४", "content_sanskrit": "व्याघ्राविव च संरब्धौ चेरतुस्तौ नरोत्तमौ ।\nशरदंष्ट्रौ दुराधर्षौ चापहस्तौ भयङ्करौ\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2167431, "chapter_id": 4595, "verse_number": "१५", "content_sanskrit": "अदृश्यौ च मुहूर्तेन शरजालैर्बभूवतुः ।\nमेघजालैः प्रतिच्छन्नौ सूर्याचन्द्रमसाविव\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2167432, "chapter_id": 4595, "verse_number": "१६", "content_sanskrit": "प्रकाशौ च मुहूर्तेन तत्रैवास्तामरिन्दमौ ।\nविमुक्तौ मेघजालेन शशिसूर्यौ यथा दिवि\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2167433, "chapter_id": 4595, "verse_number": "१७", "content_sanskrit": "अथ तत्रैव सङ्ग्रामे वर्तमाने सुदारुणे ।\nअपसव्यं ततश्चक्रे द्रौणिस्तत्र वृकोदरम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2167434, "chapter_id": 4595, "verse_number": "१८", "content_sanskrit": "किरन् शरशतैरुग्रैर्धाराभिरिव पर्वतम् ।\nन तु तन्ममृषे भीमः शत्रोर्विजयलक्षणम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2167435, "chapter_id": 4595, "verse_number": "१९", "content_sanskrit": "प्रतिचक्रे ततो राजन् पाण्डवोऽप्यपसव्यतः ।\nमण्डलानां विभागेन गतप्रत्यागतेन च\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2167436, "chapter_id": 4595, "verse_number": "२०", "content_sanskrit": "बभूव तुमुलं युद्धं तयोस्तत्र महामृधे ।\nचरित्वा विविधान् मार्गान् मण्डलस्थानमेव च\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2167437, "chapter_id": 4595, "verse_number": "२१", "content_sanskrit": "शरैः पूर्णायतोत्सृष्टैरन्योन्यमभिजग्मतुः ।\nअन्योन्यस्य वधे चैव चक्रतुर्यत्नमाहवे\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2167438, "chapter_id": 4595, "verse_number": "२२", "content_sanskrit": "इयेषतुश्च विरथं कर्तुमन्योन्यमाहवे\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2167439, "chapter_id": 4595, "verse_number": "२३", "content_sanskrit": "ततो द्रौणिर्महास्त्राणि प्रादुश्चक्रे महारथः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2167440, "chapter_id": 4595, "verse_number": "२४", "content_sanskrit": "तान्यस्त्रैरेव समरे प्रतिजघ्ने स पाण्डवः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2167441, "chapter_id": 4595, "verse_number": "२५", "content_sanskrit": "ततो घोरं महाराज ह्यस्त्रयुद्धमवर्तत ।\nग्रहयुद्धं यथा घोरं प्रजासंहरणे ह्यभूत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2167442, "chapter_id": 4595, "verse_number": "२६", "content_sanskrit": "ते बाणाः समसज्जन्त ताभ्यां क्षिप्ता इतस्ततः ।\nद्योतयन्तो दिशः सर्वाः तच्च सैन्यं समन्ततः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2167443, "chapter_id": 4595, "verse_number": "२७", "content_sanskrit": "बाणसङ्घावृतं सर्वमाकाशं समपद्यत ।\nउल्कापातावृतं यद्वत् प्रजासंहरणे नृप\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2167444, "chapter_id": 4595, "verse_number": "२८", "content_sanskrit": "बाणाभिघातात् सञ्जज्ञे तत्र भारत पावकः ।\nसविष्फुलिङ्गो दीप्तार्चिर्योऽदहद् वाहिनीद्वयम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2167445, "chapter_id": 4595, "verse_number": "२९", "content_sanskrit": "तत्र सिद्धा महाराज सम्पतन्तोऽब्रुवन् वचः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2167446, "chapter_id": 4595, "verse_number": "३०", "content_sanskrit": "अति युद्धानि सर्वाणि युद्धमेतदवर्तत ।\nसर्वयुद्धानि चैतस्य कलां नार्हन्ति षोडशीम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2167447, "chapter_id": 4595, "verse_number": "३१", "content_sanskrit": "नैतादृशं पुनर्युद्धं भविष्यति कदाचन ।\nअहो ज्ञानेन सम्पन्नावुभौ चोग्रपराक्रमौ\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2167448, "chapter_id": 4595, "verse_number": "३२", "content_sanskrit": "अहोऽनयोर्बलं युद्धे अहो चापि कृतास्त्रता ।\nअहो ज्ञानस्य सम्पच्च अहो सौष्ठवमेव च\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2167449, "chapter_id": 4595, "verse_number": "३३", "content_sanskrit": "स्थितावेतौ हि समरे कालान्तकयमोपमौ ।\nरुद्रौ द्वाविव सम्भूतौ तथा द्वाविव भास्करौ\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2167450, "chapter_id": 4595, "verse_number": "३४", "content_sanskrit": "यमाविव नरव्याघ्रौ घोररूपाविमौ रणे\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2167451, "chapter_id": 4595, "verse_number": "समाप्तिः", "content_sanskrit": "इति स्म वाचः श्रूयन्ते सम्पतन्त्यो मुहुर्मुहुः ।\nसिंहनादश्च सञ्जज्ञे समेतानां दिवौकसाम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2167452, "chapter_id": 4595, "verse_number": "३६", "content_sanskrit": "अद्भुतं चाप्यचिन्त्यं च दृष्ट्वा युद्धं महारणे\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2167453, "chapter_id": 4595, "verse_number": "३७", "content_sanskrit": "सिद्धचारणसङ्घानां विस्मयः समपद्यत ।\nप्रशंसन्ति तदा देवाः सिद्धाश्च परमर्षयः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2167454, "chapter_id": 4595, "verse_number": "३८", "content_sanskrit": "साधु द्रौणे महाबाहो साधु भीमेति चाब्रुवन्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2167455, "chapter_id": 4595, "verse_number": "३९", "content_sanskrit": "तौ शूरौ समरे राजन् परस्परकृतागसौ\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2167456, "chapter_id": 4595, "verse_number": "४०", "content_sanskrit": "परस्परमुदीक्षेतां क्रोधादुद्धृत्य चक्षुषी ।\nक्रोधरक्तेक्षणौ तौ तु क्रोधात् प्रस्फुरिताधरौ\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2167457, "chapter_id": 4595, "verse_number": "४१", "content_sanskrit": "क्रोधात् सन्दश्य दशनैस्तथैव दशनच्छदौ ।\nछादयामासतुरुभौ तावन्योन्यं रणे शरैः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2167458, "chapter_id": 4595, "verse_number": "४२", "content_sanskrit": "शराम्बुधारौ समरे शस्त्रविद्युत्प्रकाशिनौ ।\nतावन्योन्यं ध्वजौ विद्ध्वा सारथी च महारथौ\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2167459, "chapter_id": 4595, "verse_number": "४३", "content_sanskrit": "अन्योन्यस्य हयांश्चापि सायकैर्निर्बिभेदतुः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2167460, "chapter_id": 4595, "verse_number": "४४", "content_sanskrit": "ततः क्रुद्धौ महाराज बाणौ गृह्य महाहवे ।\nउभौ चिक्षिपतुस्तूर्णमन्योन्यस्य वधैषिणौ\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2167461, "chapter_id": 4595, "verse_number": "४५", "content_sanskrit": "तौ सायकौ महाराज द्योतमानौ चमूमुखे ।\nआजघ्नतुः समासाद्य वज्रवेगौ दुरासदौ\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2167462, "chapter_id": 4595, "verse_number": "४६", "content_sanskrit": "तौ परस्परवेगेन शराभ्यामाहतौ भृशम् ।\nनिपेततुर्महाराज स्वरथोपस्थयोस्तदा\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2167463, "chapter_id": 4595, "verse_number": "४७", "content_sanskrit": "ततस्तु सारथिर्ज्ञात्वा द्रोणपुत्रमचेतनम् ।\nअपोवाह रणाद् राजन् सर्वक्षत्रस्य पश्यतः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2167464, "chapter_id": 4595, "verse_number": "४८", "content_sanskrit": "तथैव पाण्डवं राजन् विह्वलन्तं मुहुर्मुहुः ।\nअपोवाह रणाद् राजन् विशोकः शत्रुतापनम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2167465, "chapter_id": 4595, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nभीमाश्वत्थामयुद्धं नाम पञ्चदशोऽध्यायः ॥१५॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]