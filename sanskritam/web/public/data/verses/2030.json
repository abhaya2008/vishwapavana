[{"id": 2046356, "chapter_id": 2030, "verse_number": "६-७९-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2046357, "chapter_id": 2030, "verse_number": "६-७९-१", "content_sanskrit": "ततो दुर्योधनो राजा लोहितायति भास्करे।\nसंग्रामरभसो भीमं हन्तुकामोऽभ्यधावत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2046358, "chapter_id": 2030, "verse_number": "६-७९-२", "content_sanskrit": "तमायान्तमभिप्रेक्ष्य नृवीरं दृढवैरिणम् ।\nभीमसेनः सुसंक्रुद्ध इदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2046359, "chapter_id": 2030, "verse_number": "६-७९-३", "content_sanskrit": "अयं स कालः संप्राप्तो वर्षपूगाभिवाञ्छितः ।\nअद्य त्वां निहनिष्यामि यदि नोत्सृजसे रणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2046360, "chapter_id": 2030, "verse_number": "६-७९-४", "content_sanskrit": "अद्य कुन्त्याः परिक्लेशं वनवासं च कृत्स्नशः।\nद्रौपद्याश्च परिक्लेशं प्रणेष्यामि हते त्वयि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2046361, "chapter_id": 2030, "verse_number": "६-७९-५", "content_sanskrit": "यत्पुरा मत्सरीभूत्वा पाण्डवानवमन्यसे ।\nतस्य पापस्य गान्धारे पश्य व्यसनमागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2046362, "chapter_id": 2030, "verse_number": "६-७९-६", "content_sanskrit": "कर्णस्य मतमास्थाय सौबलस्य च यत्पुरा ।\nअचिन्त्य पाण्डवान्कामाद्यथेष्टं कृतवानसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2046363, "chapter_id": 2030, "verse_number": "६-७९-७", "content_sanskrit": "याचमानं च यन्मोहाद्दाशार्हमवमन्यसे।\nउलूकस्य समादेशं यद्ददासि च हृष्टवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2046364, "chapter_id": 2030, "verse_number": "६-७९-८", "content_sanskrit": "तेन त्वां निहनिष्यामि सानुबन्धं सबान्धवम् ।\nशमीकरिष्ये तत्पापं यत्पुरा कृतवानसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2046365, "chapter_id": 2030, "verse_number": "६-७९-९", "content_sanskrit": "एवमुक्त्वा धनुर्घोरं विकृष्योद्भ्राम्य चासकृत् ।\nसमाधत्त शरान्घोरान्महाशनिसमप्रभान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2046366, "chapter_id": 2030, "verse_number": "६-७९-१०", "content_sanskrit": "षड्विंशतिमसं क्रुद्धो मुमोचाशु सुयोधने ।\nज्वलिताग्निशिखाकारान्वज्रकल्पानजिह्मगान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2046367, "chapter_id": 2030, "verse_number": "६-७९-११", "content_sanskrit": "ततोऽस्य कार्मुकं द्वाभ्यां सूतं द्वाभ्यां च विव्यधे ।\nचतुर्भिरश्वाञ्जवनाननयद्यमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2046368, "chapter_id": 2030, "verse_number": "६-७९-१२", "content_sanskrit": "द्वाभ्यां च सुविकृष्टाभ्यां शराभ्यामरिमर्दनः ।\nछत्रं चिच्छेद समरे राज्ञस्तस्य नरोत्तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2046369, "chapter_id": 2030, "verse_number": "६-७९-१३", "content_sanskrit": "षङ्भिश्च तस्य चिच्छेद ज्वलन्तं ध्वजमुत्तमम् ।\nछित्त्वा तं च ननादोच्चैस्तव पुत्रस्य पश्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2046370, "chapter_id": 2030, "verse_number": "६-७९-१४", "content_sanskrit": "रथाच्च स ध्वजः श्रीमान्नानारत्नविभूषितात्।\nपपात सहसा भूमौ विद्युञ्जलधरादिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2046371, "chapter_id": 2030, "verse_number": "६-७९-१५", "content_sanskrit": "ज्वलन्तं सूर्यसंकाशं नागं मणिमयं शुभम् ।\nध्वजं कुरुपतेश्छिन्नं ददृशुः सर्वपार्थिवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2046372, "chapter_id": 2030, "verse_number": "६-७९-१६", "content_sanskrit": "अथैनं दशभिर्बाणैस्तोत्रैरिव महाद्विपम् ।\nआजघान रणे वीरं स्मयन्निव महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2046373, "chapter_id": 2030, "verse_number": "६-७९-१७", "content_sanskrit": "स गाढविद्धो व्यथितो भीमसेनेन संयुगे ।\nनिषसाद रथोपस्थे मूर्च्छाभिहतचेतनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2046374, "chapter_id": 2030, "verse_number": "६-७९-१८", "content_sanskrit": "ततः स राजा सिन्धूनां रथश्रेष्ठो महाबलः ।\nदुर्योधनस्य जग्राह पार्ष्णिं स्वपुरुषैर्वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2046375, "chapter_id": 2030, "verse_number": "६-७९-१९", "content_sanskrit": "कृपश्च रथिनां श्रेष्ठस्तव पुत्रमचेतनम् ।\nआरोपयद्रथं राजन्दुर्योधनममर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2046376, "chapter_id": 2030, "verse_number": "६-७९-२०", "content_sanskrit": "परिवार्य ततो भीमं जेतुकामो जयद्रथः ।\nरथैरनेकसाहस्रैर्भीमस्यावारयद्दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2046377, "chapter_id": 2030, "verse_number": "६-७९-२१", "content_sanskrit": "धृष्टकेतुस्ततो राजन्नभिमन्युश्च वीर्यवान्।\nकेकया द्रौपदेयाश्च तव पुत्रानयोधयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2046378, "chapter_id": 2030, "verse_number": "६-७९-२२", "content_sanskrit": "चित्रसेनः सुचित्रश्च चित्राङ्गश्चित्रदर्शनः ।\nचारुचित्रः सुचारुश्च तथा नन्दोपनन्दकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2046379, "chapter_id": 2030, "verse_number": "६-७९-२३", "content_sanskrit": "अष्टावेते महेष्वासाः सुकुमारा यशस्विनः ।\nअभिमन्युरथं राजन्समन्तात्पर्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2046380, "chapter_id": 2030, "verse_number": "६-७९-२४", "content_sanskrit": "आजघान ततस्तूर्णमभिमन्युर्महामनाः ।\nएकैकं पञ्चभिर्बाणैः शितैः सन्नतपर्वभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2046381, "chapter_id": 2030, "verse_number": "६-७९-२५", "content_sanskrit": "वज्रमृत्युप्रतीकाशैर्विचित्रायुधनिःसृतैः ।\nअमृष्यमाणास्ते सर्वे सौभद्रं रथसत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2046382, "chapter_id": 2030, "verse_number": "६-७९-२६", "content_sanskrit": "ववृषुर्मार्गणैस्तीक्ष्णैर्गिरिं मेरुमिवाम्बुदाः ।\nस पीड्यमानः समरे कृतास्त्रो युद्धदुर्मदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2046383, "chapter_id": 2030, "verse_number": "६-७९-२७", "content_sanskrit": "अभिमन्युर्महाराज तावकान्समकम्पयत्।\nयथा देवासुरे युद्धे वज्रपाणिर्महासुरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2046384, "chapter_id": 2030, "verse_number": "६-७९-२८", "content_sanskrit": "विकर्णस्य ततो भल्लान्प्रेषयामास भारत।\nचतुर्दश रथश्रेष्ठो घोरानाशीविषोपमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2046385, "chapter_id": 2030, "verse_number": "६-७९-२९", "content_sanskrit": "स तैर्विकर्णस्य रथात्पातयामास वीर्यवान् ।\nध्वजं सूतं हयांश्चैव नृत्यमान इवाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2046386, "chapter_id": 2030, "verse_number": "६-७९-३०", "content_sanskrit": "पुनश्चान्याञ्शरान्पीतानकुण्ठाग्राञ्शिलाशितान्।\nप्रेषयामास संक्रुद्धो विकर्णाय महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2046387, "chapter_id": 2030, "verse_number": "६-७९-३१", "content_sanskrit": "ते विकर्णं समासाद्य कङ्कबर्हिणवाससः।\nभित्त्वा देहं गता भूमिं ज्वलन्त इव पन्नगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2046388, "chapter_id": 2030, "verse_number": "६-७९-३२", "content_sanskrit": "ते शरा हेमपुङ्खाग्रा व्यदृश्यन्त महीतले ।\nविकर्णरुधिरक्लिन्ना वमन्त इव शोणितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2046389, "chapter_id": 2030, "verse_number": "६-७९-३३", "content_sanskrit": "विकर्णं वीक्ष्य निर्भिन्नं तस्यैवान्ये सहोदराः ।\nअभ्यद्रवन्त समरे सौभद्रप्रमुखान्रथान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2046390, "chapter_id": 2030, "verse_number": "६-७९-३४", "content_sanskrit": "अभियात्वा तथैवान्यान्रथांस्तान्सूर्यवर्चसः ।\nअविध्यन्समरेऽन्योन्यं संरम्भाद्युद्धदुर्मदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2046391, "chapter_id": 2030, "verse_number": "६-७९-३५", "content_sanskrit": "दुर्मुखः श्रुतकर्माणं विद्ध्वा सप्तभिराशुगैः ।\nध्वजमेकेन चिच्छेद सारथिं चास्य सप्तमिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2046392, "chapter_id": 2030, "verse_number": "६-७९-३६", "content_sanskrit": "अश्वाञ्जाम्बूनदैर्जालैः प्रच्छन्नान्वातरंहसः ।\nजघान षङ्भिरासाद्य सारथिं चाभ्यपातयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2046393, "chapter_id": 2030, "verse_number": "६-७९-३७", "content_sanskrit": "स हताश्वे रथे तिष्ठञ्श्रुतकर्मा महारथः ।\nशक्तिं चिक्षेप संक्रुद्धो महोल्कां ज्वलितामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2046394, "chapter_id": 2030, "verse_number": "६-७९-३८", "content_sanskrit": "सा दुर्मुखस्य विमलं वर्म भित्त्वा यशस्विनः ।\nविदार्य प्राविशद्भूभिं दीप्यमाना स्वतेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2046395, "chapter_id": 2030, "verse_number": "६-७९-३९", "content_sanskrit": "दुर्मुखो विह्वलस्तत्र निषसाद रणे विभो।\nविसंज्ञं प्रेक्ष्य ते सर्वे भ्रातरः पर्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2046396, "chapter_id": 2030, "verse_number": "६-७९-४०", "content_sanskrit": "तं दृष्ट्वा विरथं तत्र सुतसोमो महारथः ।\nपश्यतां सर्वसैन्यानां रथमारोपयत्स्वकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2046397, "chapter_id": 2030, "verse_number": "६-७९-४१", "content_sanskrit": "श्रुतकीर्तिस्तथा वीरो जयत्सेनं सुतं तव।\nअभ्ययात्समरे राजन्हन्तुकामो यशस्विनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2046398, "chapter_id": 2030, "verse_number": "६-७९-४२", "content_sanskrit": "तस्य विक्षिपतश्चापं श्रुतकीर्तेर्महास्वनम्।\nचिच्छेद समरे तूर्णं जयत्सेनः सुतस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2046399, "chapter_id": 2030, "verse_number": "६-७९-४३", "content_sanskrit": "क्षुरप्रेण सुतीक्ष्णेन प्रहसन्निव भारत।\nतं दृष्ट्वा च्छिन्नधन्वानं शतानीकः सहोदरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2046400, "chapter_id": 2030, "verse_number": "६-७९-४४", "content_sanskrit": "अभ्यपद्यत तेजस्वी सिंहवन्निनदन्मुहुः ।\nशतानीकस्तु समरे दृढं विस्पार्य कार्मुकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2046401, "chapter_id": 2030, "verse_number": "६-७९-४५", "content_sanskrit": "विव्याध दशभिस्तूर्णं जयत्सेनं शिलीमुखैः ।\nननाद सुमहानादं प्रभिन्न इव वारणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2046402, "chapter_id": 2030, "verse_number": "६-७९-४६", "content_sanskrit": "अथान्येन सुतीक्ष्णेन सर्वावरणभेदिना ।\nशतानीको जयत्सेनं विव्याध हृदये भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2046403, "chapter_id": 2030, "verse_number": "६-७९-४७", "content_sanskrit": "तथा तस्मिन्वर्तमाने दुष्कर्णो भ्रातुरन्तिके ।\nमुमोचास्मैशितान्बाणांस्तीक्ष्णानाशीविषोपमान्\nचिच्छेद समरे चापं नाकुलेः क्रोधमूर्च्छितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2046404, "chapter_id": 2030, "verse_number": "६-७९-४८", "content_sanskrit": "अथान्यद्धनुरादाय भारसाहमनुत्तमम् ।\nसमादत्त शरान्घोराञ्शतानीको महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2046405, "chapter_id": 2030, "verse_number": "६-७९-४९", "content_sanskrit": "तिष्ठतिष्ठेति चामन्त्र्य दुष्कर्णं भ्रातुरग्रतः।\nमुमोचास्मै शितान्बाणाज्ज्वलितान्पन्नगानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2046406, "chapter_id": 2030, "verse_number": "६-७९-५०", "content_sanskrit": "ततोऽस्य धनुरेकेन द्वाभ्यां सूतं च मारिष ।\nचिच्छेद समरे तूर्णं तं च विव्याध सप्तभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2046407, "chapter_id": 2030, "verse_number": "६-७९-५१", "content_sanskrit": "अश्वान्मनोजवांस्तस्य कर्बुरान्वातरंहसः ।\nजघान निशितैस्तूर्णं सर्वान्द्वादशभिः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2046408, "chapter_id": 2030, "verse_number": "६-७९-५२", "content_sanskrit": "अथापरेण भल्लेन सुयुक्तेनाशुपातिना।\nदुष्कर्णं नाकुलिः क्रुद्धो विव्याध हृदये भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2046409, "chapter_id": 2030, "verse_number": "६-७९-५३", "content_sanskrit": "स पपात ततो भूमौ वज्राहत इव द्रुमः ।\nदुष्कर्णं व्यथितं दृष्ट्वा पञ्च राजन्महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2046410, "chapter_id": 2030, "verse_number": "६-७९-५४", "content_sanskrit": "दिघांसन्तः शतानीकं सर्वतः पर्यवारयन्।\nछाद्यमानं शरव्रतैः शतानीकं यशस्विनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2046411, "chapter_id": 2030, "verse_number": "६-७९-५५", "content_sanskrit": "अभ्यधावन्त संक्रुद्धाः केकयाः पञ्च सोदराः ।\nतानभ्यापततः प्रेक्ष्य तव पुत्रा महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2046412, "chapter_id": 2030, "verse_number": "६-७९-५६", "content_sanskrit": "प्रत्युद्ययुर्महाराज गजानिव महागजाः ।\nदुर्मुखो दुर्जयश्चैव तथा दुर्मर्षणो युवा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2046413, "chapter_id": 2030, "verse_number": "६-७९-५७", "content_sanskrit": "शत्रुंजयः सत्रुसहः सर्वे क्रुद्धा यशस्विनः ।\nप्रत्युद्याता महाराज केकयान्भ्रातरः समम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2046414, "chapter_id": 2030, "verse_number": "६-७९-५८", "content_sanskrit": "रथैर्नगरसंकाशैर्हयैर्युक्तैर्मनोजवैः ।\nनानावर्णविचित्राभिः पताकाभिरलङ्कृतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2046415, "chapter_id": 2030, "verse_number": "६-७९-५९", "content_sanskrit": "शरचापधरा वीरा विचित्रकवचध्वजाः ।\nविविशुस्ते परं सैन्यं सिंहा इव वनाद्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2046416, "chapter_id": 2030, "verse_number": "६-७९-६०", "content_sanskrit": "तेषां सुतुमुलं युद्धं व्यतिषक्तरथद्विपम्।\nअवर्तत महारौद्रं निघ्नतामितरेतरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2046417, "chapter_id": 2030, "verse_number": "६-७९-६१", "content_sanskrit": "अन्योन्यागस्कृतां राजन्यमराष्ट्रविवर्धनम् ।\nमुहूर्तास्तमिते सूर्ये चक्रुर्युद्धं सुदारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2046418, "chapter_id": 2030, "verse_number": "६-७९-६२", "content_sanskrit": "रथिनः सादिनश्चाथ व्यकीर्यन्त सहस्रशः ।\nततः शान्तनवः क्रुद्धः शरैः सन्नतपर्वभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2046419, "chapter_id": 2030, "verse_number": "६-७९-६३", "content_sanskrit": "नाशयामास सेनां तां भीष्मस्तेषां महात्मनाम् ।\nपञ्चालानां च सैन्यानि शरैर्निन्ये यमक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2046420, "chapter_id": 2030, "verse_number": "६-७९-६४", "content_sanskrit": "एवं भित्त्वा महेष्वासः पाण्डवानामनीकिनीम्।\nकृत्वाऽवहारं सैन्यानां ययौ स्वशिबिरं नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2046421, "chapter_id": 2030, "verse_number": "६-७९-६५", "content_sanskrit": "नाशयामासतुर्वीरौ धृष्टद्युम्नवृकोदरौ।\nकरवाणामनीकानि शरैः सन्नतपर्वभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2046422, "chapter_id": 2030, "verse_number": "६-७९-६६", "content_sanskrit": "धर्मराजोऽपि संप्रेक्ष्य धृष्टद्युम्नवृकोदरौ ।\nमूर्ध्नि चैतावुपाघ्राय प्रहृष्टः शिबिरं ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2046423, "chapter_id": 2030, "verse_number": "६-७९-६७", "content_sanskrit": "` अर्जुनो वासुदेवश्च कौरवाणामनीकिनीम् ।\nहत्वा विद्राव्य च शरैः शिबिरायैव जग्मतुः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2046424, "chapter_id": 2030, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि षष्ठदिवसयुद्धे एकोनाशीतितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]