[{"id": 2004225, "chapter_id": 1083, "verse_number": "१-८४-०x", "content_sanskrit": "अष्टक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2004226, "chapter_id": 1083, "verse_number": "१-८४-१", "content_sanskrit": "यदाऽवसो नन्दने कामरूपी\nसंवत्सराणामयुतं शतानाम्।\nकिं कारणं कार्तयुगप्रधान\nहित्वा च त्वं वसुधामन्वपद्यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2004227, "chapter_id": 1083, "verse_number": "१-८४-२x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2004228, "chapter_id": 1083, "verse_number": "१-८४-२", "content_sanskrit": "ज्ञातिः सुहृत्स्वजनो वा यथेह\nक्षीणे वित्ते त्यज्यते मानवैर्हि।\nतथा तत्र क्षीणपुण्यं मनुष्यं\nत्यजन्ति सद्यः सेश्वरा देवसङ्घाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2004229, "chapter_id": 1083, "verse_number": "१-८४-३x", "content_sanskrit": "अष्टक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2004230, "chapter_id": 1083, "verse_number": "१-८४-३", "content_sanskrit": "तस्मिन्कथं क्षीणपुण्या भवन्ति\nसंमुह्यते मेऽत्र मनोऽतिमात्रम्।\nकिं वा विशिष्टाः कस्य धामोपयान्ति\nतद्वै ब्रूहि क्षेत्रवित्त्वं मतो मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2004231, "chapter_id": 1083, "verse_number": "१-८४-४x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2004232, "chapter_id": 1083, "verse_number": "१-८४-४", "content_sanskrit": "इमं भौमं नरकं ते पतन्ति\nललाप्यमाना नरदेव सर्वे।\nते कङ्कगोमायुबलाशनार्थे\nक्षीणे पुण्ये बहुधा प्रव्रजन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2004233, "chapter_id": 1083, "verse_number": "१-८४-५", "content_sanskrit": "तस्मादेतद्वर्जनीयं नरेन्द्र\nदुष्टं लोके गर्हणीयं च कर्म।\nआख्यातं ते पार्थिव सर्वमेव\nभूयश्चेदानीं वद किं ते वदामि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2004234, "chapter_id": 1083, "verse_number": "१-८४-६x", "content_sanskrit": "अष्टक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2004235, "chapter_id": 1083, "verse_number": "१-८४-६", "content_sanskrit": "यदा तु तान्वितुदन्ते वयांसि\nतथा गृध्राः शितिकण्ठाः पतङ्गाः।\nकथं भवन्ति कथमाभवन्ति\nन भौममन्यं नरकं शृणोमि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2004236, "chapter_id": 1083, "verse_number": "१-८४-७x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2004237, "chapter_id": 1083, "verse_number": "१-८४-७", "content_sanskrit": "ऊर्ध्वं देहात्कर्मणो जृम्भमाणा-\nद्व्यक्तं पृथिव्यामनुसंचरन्ति।\nइमं भौमं नरकं ते पतन्ति\nनावेक्षन्ते वर्षपूगाननेकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2004238, "chapter_id": 1083, "verse_number": "१-८४-८", "content_sanskrit": "षष्टिं सहस्राणि पतन्ति व्योम्नि\nतथा अशीतिं परिवत्सराणि।\nतान्वै तुदन्ति पततः प्रपातं\nभीमा भौमा राक्षसास्तीक्ष्णदंष्ट्राः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2004239, "chapter_id": 1083, "verse_number": "१-८४-९x", "content_sanskrit": "अष्टक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2004240, "chapter_id": 1083, "verse_number": "१-८४-९", "content_sanskrit": "यदेनसस्ते पततस्तुदन्ति\nभीमा भौमा राक्षसास्तीक्ष्णदंष्ट्राः।\nकथं भवन्ति कथमाभवन्ति\nकथंभूता गर्भभूता भवन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2004241, "chapter_id": 1083, "verse_number": "१-८४-१०x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2004242, "chapter_id": 1083, "verse_number": "१-८४-१०", "content_sanskrit": "अस्रं रेतः पुष्पफलानुपृक्त-\nमन्वेति तद्वै पुरुषेण सृष्टम्।\nस वै तस्या रज आपद्यते वै\nस गर्भभूतः समुपैति तत्र॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2004243, "chapter_id": 1083, "verse_number": "१-८४-११", "content_sanskrit": "वनस्पतीनोषधीश्चाविशन्ति\nआपो वायुं पृथिवीं चान्तरिक्षम्।\nचतुष्पदं द्विपदं चाति सर्व-\nमेवंभूता गर्भभूता भवन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2004244, "chapter_id": 1083, "verse_number": "१-८४-१२x", "content_sanskrit": "अष्टक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2004245, "chapter_id": 1083, "verse_number": "१-८४-१२", "content_sanskrit": "अन्यद्वपुर्विदधातीह गर्भ-\nमुताहोस्वित्स्वेन कायेन याति।\nआपद्यमानो नरयोनिमेता-\nमाचक्ष्व मे संशयात्प्रब्रवीमि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2004246, "chapter_id": 1083, "verse_number": "१-८४-१३", "content_sanskrit": "शरीरदेहातिसमुच्छ्रयं च\nचक्षुःश्रोत्रे लभते केन संज्ञाम्।\nएतत्तत्त्वं सर्वमाचक्ष्व पृष्टः\nक्षेत्रज्ञं त्वां तात मन्याम सर्वे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2004247, "chapter_id": 1083, "verse_number": "१-८४-१४x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2004248, "chapter_id": 1083, "verse_number": "१-८४-१४", "content_sanskrit": "वायुः समुत्कर्षति गर्भयोनि-\nमृतौ रेतः पुष्पफलानुपृक्तम्।\nस तत्र तन्मात्रकृताधिकारः\nक्रमेण संवर्धयतीह गर्भम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2004249, "chapter_id": 1083, "verse_number": "१-८४-१५", "content_sanskrit": "स जायमानो विगृहीतमात्रः\nसंज्ञामधिष्ठाय ततो मनुष्यः।\nस श्रोत्राभ्यां वेदयतीह शब्दं\nस वै रूपं पश्यति चक्षुषा च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2004250, "chapter_id": 1083, "verse_number": "१-८४-१६", "content_sanskrit": "घ्राणेन गन्धं जिह्वयाऽथो रसं च\nत्वचा स्पर्शं मनसा वेदभावम्।\nइत्यष्टकेहोपहितं हि विद्धि\nमहात्मनः प्राणभृतः शरीरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2004251, "chapter_id": 1083, "verse_number": "१-८४-१७x", "content_sanskrit": "अष्टक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2004252, "chapter_id": 1083, "verse_number": "१-८४-१७", "content_sanskrit": "यः संस्थितः पुरुषो दह्यते वा\nनिखन्यते वापि निकृष्यते वा।\nअभावभूतः स विनाशमेत्य\nकेनात्मानं चेतयते परस्तात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2004253, "chapter_id": 1083, "verse_number": "१-८४-१८x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2004254, "chapter_id": 1083, "verse_number": "१-८४-१८", "content_sanskrit": "हित्वा सोऽसून्सुप्तवन्निष्टनित्वा\nपुरोधाय सुकृतं दुष्कृतं वा।\nअन्यां योनिं पवनाग्रानुसारी\nहित्वा देहं भजते राजसिंह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2004255, "chapter_id": 1083, "verse_number": "१-८४-१९", "content_sanskrit": "पुण्यां योनिं पुण्यकृतो व्रजन्ति\nपापां योनिं पापकृतो व्रजन्ति।\nकीटाः पतङ्गाश्च भवन्ति पापा\nन मे विवक्षास्ति महानुभाव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2004256, "chapter_id": 1083, "verse_number": "१-८४-२०", "content_sanskrit": "चतुष्पदा द्विपदाः षट्पदाश्च\nतथाभूता गर्भभूता भवन्ति।\nआख्यातमेतन्निखिलेन सर्वं\nभूयस्तु किं पृच्छसि राजसिंह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2004257, "chapter_id": 1083, "verse_number": "१-८४-२१x", "content_sanskrit": "अष्टक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2004258, "chapter_id": 1083, "verse_number": "१-८४-२१", "content_sanskrit": "किंस्वित्कृत्वा लभते तात लोका-\nन्मर्त्यः श्रेष्ठांस्तपसा विद्यया च।\nतन्मे पृष्टः शंस सर्वं यथाव-\nच्छुभाँल्लोकान्येन गच्छेत्क्रमेण॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2004259, "chapter_id": 1083, "verse_number": "१-८४-२२x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2004260, "chapter_id": 1083, "verse_number": "१-८४-२२", "content_sanskrit": "तपश्च दानं च शमो दमश्च\nह्रीरार्जवं सर्वभूतानुकम्पा।\nस्वर्गस्य लोकस्य वदन्ति सन्तो\nद्वाराणि सप्तैव महान्ति पुंसाम्।\nनश्यन्ति मानेन तमोऽभिभूताः\nपुंसः सदैवेति वदन्ति सन्तः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2004261, "chapter_id": 1083, "verse_number": "१-८४-२३", "content_sanskrit": "अधीयानः पण्डितंमन्यमानो\nयो विद्यया हन्ति यशः परेषाम्।\nतस्यान्तवन्तश्च भवन्ति लोका\nन चास्य तद्ब्रह्म फलं ददाति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2004262, "chapter_id": 1083, "verse_number": "१-८४-२४", "content_sanskrit": "चत्वारि कर्माण्यभयङ्कराणि\nभयं प्रयच्छन्त्ययथाकृतानि।\nमानाग्निहोत्रमुत मानमौनं\nमानेनाधीतमुत मानयज्ञः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2004263, "chapter_id": 1083, "verse_number": "१-८४-२५", "content_sanskrit": "न मानमान्यो मुदमाददीत\nन सन्तापं प्राप्नुयाच्चावमानात्।\nसन्तः सतः पूजयन्तीह लोके\nनासाधवः साधुबुद्धिं लभन्ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2004264, "chapter_id": 1083, "verse_number": "१-८४-२६", "content_sanskrit": "इति दद्यामिति यज इत्यदीय इति व्रतम्।\nइत्येतानि भयान्याहुस्तानि वर्ज्यानि सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2004265, "chapter_id": 1083, "verse_number": "१-८४-२७", "content_sanskrit": "ये चाश्रयं वेदयन्ते पुराणं\nमनीषिणो मानसमार्गरुद्धम्।\nतन्निःश्रेयस्तेन संयोगमेत्य\nपरां शान्तिं प्रत्युः प्रेत्य चेह॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2004266, "chapter_id": 1083, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि चतुरशीतितमोऽध्यायः॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]