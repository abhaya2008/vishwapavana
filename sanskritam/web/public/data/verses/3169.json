[{"id": 2101006, "chapter_id": 3169, "verse_number": "१४-२५-१", "content_sanskrit": "ब्राह्मण उवाच।\nअत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nनारदस्य च संवादमृषेर्देवमतस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2101007, "chapter_id": 3169, "verse_number": "१४-२५-२x", "content_sanskrit": "देवमत उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2101008, "chapter_id": 3169, "verse_number": "१४-२५-२", "content_sanskrit": "जन्तोः संजायमानस्य किंनु पूर्वं प्रवर्तते।\nप्राणोऽपानः समानो वा व्यानो वोदान एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2101009, "chapter_id": 3169, "verse_number": "१४-२५-३x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2101010, "chapter_id": 3169, "verse_number": "१४-२५-३", "content_sanskrit": "येनायं सृज्यते जन्तुस्ततोऽन्यः पूर्वमेति तम्।\nप्राणद्वन्द्वं हि विज्ञेयं तिर्यगूर्ध्वमधश्च यत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2101011, "chapter_id": 3169, "verse_number": "१४-२५-४x", "content_sanskrit": "देवमत उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2101012, "chapter_id": 3169, "verse_number": "१४-२५-४", "content_sanskrit": "केनायं सृज्यते जन्तुः कश्चान्यः पूर्वमेति तम्।\nप्राणद्वन्द्वं च मे ब्रूहि तिर्यगूर्ध्वमधश्च यत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2101013, "chapter_id": 3169, "verse_number": "१४-२५-५x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2101014, "chapter_id": 3169, "verse_number": "१४-२५-५", "content_sanskrit": "सङ्कल्पाज्जायते हर्षः शब्दादपि च जायते।\nरसात्संजायते चापि रूपादपि च जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2101015, "chapter_id": 3169, "verse_number": "१४-२५-६", "content_sanskrit": "`स्पर्शात्संजायते चापि गन्धादपि च जायते।\nशुक्राच्छोणितसंसृष्टात्पूर्वं प्राणः प्रवर्तते।\nप्राणेन विकृते शुक्रे ततोऽपानः प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2101016, "chapter_id": 3169, "verse_number": "१४-२५-७", "content_sanskrit": "शुक्रात्संजायते चापि रसादपि च जायते।\nएतद्रूपमुदानस्य हर्षो मिथुनमन्तरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2101017, "chapter_id": 3169, "verse_number": "१४-२५-८", "content_sanskrit": "कामात्संजायते शुक्रं शुक्रात्संजायते रजः।\nसमानव्यानजनिते सामान्ये शुक्रशोणिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2101018, "chapter_id": 3169, "verse_number": "१४-२५-९", "content_sanskrit": "प्राणापानाविदं द्वन्द्वमवाक् चोर्ध्वं च गच्छतः।\nव्यानः समानश्चैवोभौ तिर्यग्द्वन्द्वत्वमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2101019, "chapter_id": 3169, "verse_number": "१४-२५-१०", "content_sanskrit": "अग्निर्वै देवताः सर्वा इति देवस्य शासनात्।\nसंजायते हि प्राणेषु ज्ञानं बुद्धिसमन्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2101020, "chapter_id": 3169, "verse_number": "१४-२५-११", "content_sanskrit": "तस्य धूमस्तमोरूपं रजो भस्म सुतेजसः।\nसर्वं संजायते तस्य यत्र प्रक्षिप्यते हविः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2101021, "chapter_id": 3169, "verse_number": "१४-२५-१२", "content_sanskrit": "हविः समानो व्यानश्च इति यज्ञविदो विदुः।\nप्राणापानावाज्यभागौ तयोर्मध्ये हुताशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2101022, "chapter_id": 3169, "verse_number": "१४-२५-१३", "content_sanskrit": "एतद्रूपमुदानस्य परमं ब्राह्मणा विदुः।\nनिर्द्वन्द्वमिति यत्त्वेतत्तन्मे निगदतः शृणुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2101023, "chapter_id": 3169, "verse_number": "१४-२५-१४", "content_sanskrit": "अहोरात्रमिदं द्वन्द्वं तयोर्मध्ये हुताशनः।\nएतद्रूपमुदानस्य परमं ब्राह्मणा विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2101024, "chapter_id": 3169, "verse_number": "१४-२५-१५", "content_sanskrit": "`उभे सत्यानृते द्वन्द्वं तयोर्मध्ये हुताशनः।\nएतद्रूपमुदानस्य परमं ब्राह्मणा विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2101025, "chapter_id": 3169, "verse_number": "१४-२५-१६", "content_sanskrit": "सच्चासच्चैव तद्द्वन्द्वं तयोर्मध्ये हुताशनः।\nएतद्रूपमुदानस्य परमं ब्राह्मणा विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2101026, "chapter_id": 3169, "verse_number": "१४-२५-१७", "content_sanskrit": "`उभे शुभाशुभे द्वन्द्वं तयोर्मध्ये हुताशनः।\nएतद्रूपमुदानस्य परमं ब्राह्मणा विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2101027, "chapter_id": 3169, "verse_number": "१४-२५-१८", "content_sanskrit": "ऊर्ध्वं समानो व्यानश्च व्यस्यते कर्म तेन तत्।\nद्वितीयं तु समानेन पुनरेव व्यवस्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2101028, "chapter_id": 3169, "verse_number": "१४-२५-१९", "content_sanskrit": "शान्त्यर्थं वामदेव्यं च शान्तिर्ब्रह्म सनातनम्।\nएतद्रूपमुदानस्य परमं ब्राह्मणा विदुः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2101029, "chapter_id": 3169, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि पञ्चविशोऽध्यायः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]