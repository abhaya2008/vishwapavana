[{"id": 50024842, "chapter_id": 11917, "verse_number": "1", "content_sanskrit": "अज्ञताऽखिलसंवेत्तुर्घटते न कुतश्चन। उपाधिभेदाद् घटत इति चेत् स स्वभावतः॥ २॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024843, "chapter_id": 11917, "verse_number": "2", "content_sanskrit": "अज्ञानतो वा द्वैतस्य सत्यता स्वत एव चेत्। अनवस्थितिरज्ञानहेतौ वाऽन्योन्यसिद्धिता॥ ३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024844, "chapter_id": 11917, "verse_number": "3", "content_sanskrit": "चक्रकापत्तिरथवा भेदश्चोपाधितः कुतः। विद्यमानस्य भेदस्य ज्ञापको नैव कारकः॥ ४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024845, "chapter_id": 11917, "verse_number": "4", "content_sanskrit": "उपाधिर्दृष्टपूर्वो हि खेऽपि देशान्तरस्य सः। ज्ञापको विद्यमानस्य मूढबुद्धिव्यपेक्षया॥ ५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50024846, "chapter_id": 11917, "verse_number": "5", "content_sanskrit": "न चेदुपाधिसम्बन्ध एकदेशेऽथ सर्वगः। एकदेशेऽनवस्था स्यात् सर्वगश्चेन्न भेदकः॥ ६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50024847, "chapter_id": 11917, "verse_number": "6", "content_sanskrit": "सुखदुःखादिभोगश्च स्वरूपैक्ये न भेदतः। दृश्यो ह्युपाधिभेदेऽपि हस्तपादादिगो यथा॥ ७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50024848, "chapter_id": 11917, "verse_number": "7", "content_sanskrit": "नानादेहगभोगानुसन्धानं योगिनो यथा। न चेद् भोगानुसन्धानं तदिच्छा योगिनः कुतः॥ ८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50024849, "chapter_id": 11917, "verse_number": "8", "content_sanskrit": "अनुसन्धानरहितदेहबाहुल्यमन्यथा। सिद्धमेव हि तत्पक्षे विशेषो योगिनः कुतः॥ ९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50024850, "chapter_id": 11917, "verse_number": "9", "content_sanskrit": "सिद्धौ हि कर्मभेदस्य स्यादुपाधिविभिन्नता। तत्सिद्धौ चैव तत्सिद्धिरित्यन्योन्यव्यपाश्रयः॥ १०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]