[{"id": 900003874, "chapter_id": 8309, "verse_number": "5.1", "content_sanskrit": "प्रियव्रतो भागवत आत्मारामः कथं मुने", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900003875, "chapter_id": 8309, "verse_number": "5.2", "content_sanskrit": "एवं पितरि सन्निवृत्ते तदनुशासने वर्तमान", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900003876, "chapter_id": 8309, "verse_number": "5.3", "content_sanskrit": "नाभिरपत्यकामोऽप्रजया मेरुदेव्या भगवन्तं", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900003877, "chapter_id": 8309, "verse_number": "5.4", "content_sanskrit": "अथ तमुत्पत्त्यैवाभिव्यज्यमानभगवल्लक्षणं", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900003878, "chapter_id": 8309, "verse_number": "5.5", "content_sanskrit": "नायं देहो देहभाजां नृलोके कस्तत्कामानर्हति विड्भुजां ये", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900003879, "chapter_id": 8309, "verse_number": "5.6", "content_sanskrit": "न नूनं भगवन्नात्मरामाणां", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900003880, "chapter_id": 8309, "verse_number": "5.7", "content_sanskrit": "भरतस्तु महाभागवतो यदा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900003881, "chapter_id": 8309, "verse_number": "5.8", "content_sanskrit": "एकदा तु महानद्यां कृताभिषेकनैगमिकावश्यको", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900003882, "chapter_id": 8309, "verse_number": "5.9", "content_sanskrit": "अथ कस्यचिद् द्विजवरस्याङ्गिरसप्रवरस्य", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900003883, "chapter_id": 8309, "verse_number": "5.10", "content_sanskrit": "अथ सिन्धुसौवीरपते रहूगणस्य", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900003884, "chapter_id": 8309, "verse_number": "5.11", "content_sanskrit": "अकोविदः कोविदवादवादान्वदस्यथो", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900003885, "chapter_id": 8309, "verse_number": "5.12", "content_sanskrit": "नमो नमः कारणविग्रहाय स्वरूपतुच्छीकृतविग्रहाय", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900003886, "chapter_id": 8309, "verse_number": "5.13", "content_sanskrit": "दुरत्ययेऽध्वन्यजया निवेशितो रजस्तमस्सत्वविभक्तकर्मदृक्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900003887, "chapter_id": 8309, "verse_number": "5.14", "content_sanskrit": "यो ह वा इह बहुविदा महाभागवत त्वयाऽभिहितः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900003888, "chapter_id": 8309, "verse_number": "5.15", "content_sanskrit": "भरतस्यात्मजः सुमतिर्नामाऽभिहितो यमु ह वाव", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900003889, "chapter_id": 8309, "verse_number": "5.16", "content_sanskrit": "इत्युक्तस्त्वया भूमण्डलायामविशेषो यावदादित्यस्तपति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900003890, "chapter_id": 8309, "verse_number": "5.17", "content_sanskrit": "तत्र भगवतः साक्षाद्यज्ञलिङ्गस्य विष्णोर्विक्रमतो", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900003891, "chapter_id": 8309, "verse_number": "5.18", "content_sanskrit": "तथा च भद्रश्रवा नाम धर्मसुतस्तत्कुलपतयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900003892, "chapter_id": 8309, "verse_number": "5.19", "content_sanskrit": "किंपुरुषे तु वर्षे भगवन्तमादिपुरुषं लक्ष्मणाग्रजं", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900003893, "chapter_id": 8309, "verse_number": "5.20", "content_sanskrit": "अतः परं प्लक्षादिद्वीपानां प्रमाणलक्षणसंस्थानतो वर्षविभाग उपवर्ण्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900003894, "chapter_id": 8309, "verse_number": "5.21", "content_sanskrit": "एतावानेव भूवलयस्य सन्निवेशः प्रमाणलक्षणतश्च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900003895, "chapter_id": 8309, "verse_number": "5.22", "content_sanskrit": "यदेतस्य भगवत आदित्यस्य मेरुं ध्रुवं", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900003896, "chapter_id": 8309, "verse_number": "5.23", "content_sanskrit": "अधस्तात्सवितुर्योजनायुते स्वर्भानुर्नक्षत्रवच्चरतीत्येके", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900003897, "chapter_id": 8309, "verse_number": "5.24", "content_sanskrit": "महर्षे एतद्वैचित्र्यं लोकस्य कथमिति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]