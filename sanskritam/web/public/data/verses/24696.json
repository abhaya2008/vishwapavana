[{"id": 7004696000, "chapter_id": 24696, "verse_number": "६-१५८-१", "content_sanskrit": "सूत उवाच ।\nपुष्पोऽपि गुटिके लब्ध्वा भास्कराद्वारितस्करात् ।\nचिराद्भोजनमासाद्य प्रस्थितो वैदिशं प्रति ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004696001, "chapter_id": 24696, "verse_number": "६-१५८-२", "content_sanskrit": "ततो वैदिशमासाद्य स पुष्पो हृष्टमानसः ।\nशुक्ला तां गुटिकां वक्त्रे चकारद्विजसत्तमाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004696002, "chapter_id": 24696, "verse_number": "६-१५८-३", "content_sanskrit": "मणिभद्रसमो जातस्तत्क्षणादेव स द्विजः ।\nहट्टमार्गं गते सोऽथ तस्मिन्गत्वाऽथ मंदिरे ।\nप्रविष्टः सहसा मध्ये प्रहृष्टेनांतरात्मना ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004696003, "chapter_id": 24696, "verse_number": "६-१५८-४", "content_sanskrit": "ततश्चाकारयामास तं षंढं द्वारमाश्रितम् ।\nतस्य दत्त्वाथ वस्त्राणि पश्चात्षंढमुवाच सः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004696004, "chapter_id": 24696, "verse_number": "६-१५८-५", "content_sanskrit": "षंढकश्चित्पुमानत्र सम्यग्वेषकरो हि सः ।\nमम वेषं समाधाय भ्रमते सकले पुरे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004696005, "chapter_id": 24696, "verse_number": "६-१५८-६", "content_sanskrit": "सांप्रतं मद्गृहे सोऽथ लोभनायागमिष्यति ।\nस च कृत्रिम वेषेण निषेद्धव्यस्त्वया हि सः ।\nस तथेति प्रतिज्ञाय द्वारदेशं समाश्रितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004696006, "chapter_id": 24696, "verse_number": "६-१५८-७", "content_sanskrit": "पुष्पोऽपि चाब्रवीद्भार्यां माहिकाख्यां ततः परम् ।\nमाहिकेद्य मया दृष्टः स्वतातः स्वपुरः स्थितः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004696007, "chapter_id": 24696, "verse_number": "६-१५८-८", "content_sanskrit": "वीरभद्रः सुदुःखार्तो मलिनांबरसंवृतः ।\nअब्रवीच्च ततः कोपान्मामेवं परुषाक्षरम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004696008, "chapter_id": 24696, "verse_number": "६-१५८-९", "content_sanskrit": "धिग्धिक्पाप त्वया कन्यातीव रूपवती सदा ।\nवंचयित्वा जनेतारमुदूढा सा सुमध्यमा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004696009, "chapter_id": 24696, "verse_number": "६-१५८-१०", "content_sanskrit": "न दत्तं तत्पितुः किंचिन्न तस्या अथ पुत्रक ।\nविधवां यादृशीं तां च श्वेतांबरधरां सदा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004696010, "chapter_id": 24696, "verse_number": "६-१५८-११", "content_sanskrit": "संधारयसि पापात्मन्नेष्टं भोज्यं प्रयच्छसि ।\nतस्मात्तस्याः पितुर्देहि त्वं सुवर्णायुतं ध्रुवम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004696011, "chapter_id": 24696, "verse_number": "६-१५८-१२", "content_sanskrit": "भूषणं वांछितं तस्या यत्तद्वै रुचिपूर्वकम् ।\nयेन संधारयेद्भार्या साऽनंदं परमं गता ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004696012, "chapter_id": 24696, "verse_number": "६-१५८-१३", "content_sanskrit": "निरानंदा यतो नारी न गर्भं धारयेत्स्फुटम् ।\nनिःसंतानो यतो वंशः स्वर्गादपि क्षितिं व्रजेत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004696013, "chapter_id": 24696, "verse_number": "६-१५८-१४", "content_sanskrit": "स पतिष्यत्यसंदिग्धं कुलांगारेण च त्वया ।\nसा त्वमानय वस्त्राणि गृहमध्याच्छुभानि च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004696014, "chapter_id": 24696, "verse_number": "६-१५८-१५", "content_sanskrit": "यानि दत्तानि भूपेन व्यवहारैस्तदा मम ।\nपञ्चांगश्च प्रसादो यो मया प्राप्तश्च तैः सह ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004696015, "chapter_id": 24696, "verse_number": "६-१५८-१६", "content_sanskrit": "त्वं संधारय गात्रैः स्वैः शीघ्रं रसवतीं कुरु ।\nभोजनायैव शीघ्रं तु त्वया सार्धं करोम्यहम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004696016, "chapter_id": 24696, "verse_number": "६-१५८-१७", "content_sanskrit": "एकस्मिन्नपि पात्रे च तदादेशादसंशयम् ।\nसापि सर्वं तथा चक्रे यदुक्तं तेन हर्षिता ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004696017, "chapter_id": 24696, "verse_number": "६-१५८-१८", "content_sanskrit": "भोजनाच्छादनं चैव निर्विकल्पेन चेतसा ।\nततः कामातुरः पुष्पो मैथुनायोपचक्रमे ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004696018, "chapter_id": 24696, "verse_number": "६-१५८-१९", "content_sanskrit": "एतस्मिन्नंतरे प्राप्तो मणिभद्रः समुत्सुकः ।\nक्षुत्क्षामः स पिपासार्तो व्यवहारोत्थलिप्सया ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004696019, "chapter_id": 24696, "verse_number": "६-१५८-२०", "content_sanskrit": "प्रवेशं कुरुते यावद्गृहमध्ये समुत्सुकः ।\nनिषिद्धस्तेन षण्ढेन भर्त्सयित्वा मुहुर्मुहुः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004696020, "chapter_id": 24696, "verse_number": "६-१५८-२१", "content_sanskrit": "हठाद्यावत्प्रवेशं स चकार निजमंदिरे ।\nतावच्च दण्डकाष्ठेन मस्तके तेन ताडितः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004696021, "chapter_id": 24696, "verse_number": "६-१५८-२२", "content_sanskrit": "अथ संपतितो भूमौ मूर्छया संपरिप्लुतः ।\nकर्तव्यं नैव जानाति तत्प्रहारप्रपीडितः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004696022, "chapter_id": 24696, "verse_number": "६-१५८-२३", "content_sanskrit": "ततः कोलाहलो जातस्तस्य द्वारे गृहस्य च ।\nजनस्य संप्रयातस्य हाहाकारपरस्य च ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004696023, "chapter_id": 24696, "verse_number": "६-१५८-२४", "content_sanskrit": "पप्रच्छुस्तं जनाः केचि द्धिक्पाप किमिदं कृतम् ।\nवृत्तिभंगः कृतोऽनेन अथ त्वं व्यंतरार्दितः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004696024, "chapter_id": 24696, "verse_number": "६-१५८-२५", "content_sanskrit": "इमामवस्थां यन्नीतः संप्राप्तोऽसि नृपाद्वधम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004696025, "chapter_id": 24696, "verse_number": "६-१५८-२६", "content_sanskrit": "षंढ उवाच ।\nन वृत्तिर्गर्हिता तेन नाहं व्यंतरपीडितः ।\nमणिभद्रो न चैष स्यादेष वेषकरः पुमान् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004696026, "chapter_id": 24696, "verse_number": "६-१५८-२७", "content_sanskrit": "माणिभद्रं वपुः कृत्वा संप्राप्तो याचितुं धनम् ।\nहठात्प्रविश्यमानस्तु स मया मूर्ध्नि ताडितः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004696027, "chapter_id": 24696, "verse_number": "६-१५८-२८", "content_sanskrit": "मणिभद्रो गृहस्यांतर्भुक्त्वा शयनमाश्रितः ।\nसंतिष्ठते न जानाति वृत्तांतमिदमा स्थितम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004696028, "chapter_id": 24696, "verse_number": "६-१५८-२९", "content_sanskrit": "ततः पुष्पोऽपि तच्छ्रुत्वा तं च कोलाहलं बहिः ।\nमणिभद्रस्य रूपेण द्वारदेशं समागतः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004696029, "chapter_id": 24696, "verse_number": "६-१५८-३०", "content_sanskrit": "अब्रवीन्नित्यमभ्येति मम रूपेण चाधमः ।\nएष वेषधरः कश्चिद्याचितुं धनमेव हि ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004696030, "chapter_id": 24696, "verse_number": "६-१५८-३१", "content_sanskrit": "एतेनापि च षंढेन न च भद्रमनुष्ठितम् ।\nयत्कुब्जोऽयं हतो मूर्ध्नि याचितुं समु पस्थितः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004696031, "chapter_id": 24696, "verse_number": "६-१५८-३२", "content_sanskrit": "एतस्मिन्नन्तरे सोऽपि चेतनां प्राप्य कृत्स्नशः ।\nवीक्षते पुरतो यावत्तावदात्मसमः पुमान् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004696032, "chapter_id": 24696, "verse_number": "६-१५८-३३", "content_sanskrit": "सर्वतः स तमालोक्य ततो वचनमब्रवीत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004696033, "chapter_id": 24696, "verse_number": "६-१५८-३४", "content_sanskrit": "क्व चोरः संप्रविष्टो मे मम रूपेण मंदिरे ।\nभेदयित्वा तु षण्डाख्यमेवं दत्त्वा च वाससी ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004696034, "chapter_id": 24696, "verse_number": "६-१५८-३५", "content_sanskrit": "यावद्भूपगृहं गत्वा त्वां षंढेन समन्वितम् ।\nवधाय योजयाम्येव तावद्द्रुततरं व्रज ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004696035, "chapter_id": 24696, "verse_number": "६-१५८-३६", "content_sanskrit": "पुष्प उवाच ।\nमम रूपं समाधाय त्वमायातो गृहे मम ।\nशून्यं मत्वा ततो ज्ञातस्त्वयाऽहं गृहसंस्थितः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004696036, "chapter_id": 24696, "verse_number": "६-१५८-३७", "content_sanskrit": "ततो नृपाय दास्यामि वधार्थं च न संशयः ।\nनो चेद्गच्छ द्रुतं पाप यदि जीवितुमिच्छसि ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004696037, "chapter_id": 24696, "verse_number": "६-१५८-३८", "content_sanskrit": "सूत उवाच ।\nएवमुक्त्त्वा ततस्तौ च बाहुयुद्धेन वै मिथः ।\nयुध्यमानौ नरैरन्यैः कृच्छ्रेण तु निवारितौ ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004696038, "chapter_id": 24696, "verse_number": "६-१५८-३९", "content_sanskrit": "ततस्ते स्वजना ये तु मणिभ द्रस्य चागताः ।\nपरिजानंति नो द्वाभ्यां विशेषं माणिभद्रकम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004696039, "chapter_id": 24696, "verse_number": "६-१५८-४०", "content_sanskrit": "वालिसुग्रीवयोर्युद्धं तारार्थे युध्यमानयोः ।\nएवं विवदमानौ तु क्रोधताम्रा यतेक्षणौ ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004696040, "chapter_id": 24696, "verse_number": "६-१५८-४१", "content_sanskrit": "राजद्वारं समासाद्य स्थितौ स्वजनसंवृतौ ।\nद्वाःस्थेन सूचितौ राज्ञे सभातलमुपस्थितौ ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004696041, "chapter_id": 24696, "verse_number": "६-१५८-४२", "content_sanskrit": "चौरचौरेति जल्पन्तौ पर स्परवधैषिणौ ।\nभूभुजा वीक्षितौ तौ च द्विजौ तु द्विजसत्तमाः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004696042, "chapter_id": 24696, "verse_number": "६-१५८-४३", "content_sanskrit": "न विशेषोऽस्ति विश्लेषस्तयोरेकोपिकायतः ।\nततश्च व्यवहारेषु समती तेषु वै तदा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004696043, "chapter_id": 24696, "verse_number": "६-१५८-४४", "content_sanskrit": "पृष्टौ गुह्येषु सर्वेषु प्रत्यक्षेषु विशेषतः ।\nवदतस्तौ यथावृत्तं पृथक्पृथग्व्यवस्थितम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004696044, "chapter_id": 24696, "verse_number": "६-१५८-४५", "content_sanskrit": "ततस्तु स्वजनैः सर्वैरेको नीत्व थ चान्यतः ।\nपृष्टो गोत्रान्वयं सर्वं द्वितीयस्तु ततः परम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004696045, "chapter_id": 24696, "verse_number": "६-१५८-४६", "content_sanskrit": "तेषामपि तथा सर्वं यथासम्यङ्निवेदितम् ।\nअथ राजा बृहत्सेनः सर्वांस्तानि दमब्रवीत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004696046, "chapter_id": 24696, "verse_number": "६-१५८-४७", "content_sanskrit": "पत्नी चानीयतां तस्य मणिभद्रस्य वै गृहात् ।\nनिजकान्तस्य विज्ञाने सा प्रमाणं भविष्यति ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004696047, "chapter_id": 24696, "verse_number": "६-१५८-४८", "content_sanskrit": "ततो गत्वा च सा प्रोक्ता पुरुषैर्नृपसंभवैः ।\nआगच्छ कांतं जानीहि त्वं प्रमाणं भविष्यसि ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004696048, "chapter_id": 24696, "verse_number": "६-१५८-४९", "content_sanskrit": "ततः सा व्रीडया युक्ता प्रच्छादितशिरास्ततः ।\nनृपाग्रे संस्थिता प्रोचे विद्धिसम्यङ्निजं प्रियम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004696049, "chapter_id": 24696, "verse_number": "६-१५८-५०", "content_sanskrit": "न वयं निश्चयं विद्मो न चैते स्वजनास्तव ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004696050, "chapter_id": 24696, "verse_number": "६-१५८-५१", "content_sanskrit": "ततः सा चिन्तयामास निजचित्ते वरांगना ।\nमणिभद्रेण दग्धाहमीर्ष्यावह्निगताऽनिशम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004696051, "chapter_id": 24696, "verse_number": "६-१५८-५२", "content_sanskrit": "वंचयित्वा तु पितरं गृहीतास्मि ततः परम् ।\nन किंचित्पाप्मना दत्तं जल्पयित्वा धनं बहु ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004696052, "chapter_id": 24696, "verse_number": "६-१५८-५३", "content_sanskrit": "द्वितीयेन तु मे पुंसा मर्त्यलोके सुखं कृतम् ।\nदत्त्वा वस्त्राणि चित्राणि तथैवाभरणानि च ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004696053, "chapter_id": 24696, "verse_number": "६-१५८-५४", "content_sanskrit": "प्रदास्यति च तातस्य सुवर्णं कथितं च यत् ।\nयद्गृह्णामि स्वहस्तेन मणिभद्रं द्वितीयकम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004696054, "chapter_id": 24696, "verse_number": "६-१५८-५५", "content_sanskrit": "एवं निश्चित्य मनसा दृष्ट्वा रक्तपरिप्लुतम् ।\nप्रथमं मणिभद्रं सा जगृहेऽथ द्वितीयकम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004696055, "chapter_id": 24696, "verse_number": "६-१५८-५६", "content_sanskrit": "अब्रवीच्च ततो वाक्यं सर्वलोकस्य शृण्वतः ।\nअहं तातेन दत्तास्य विवाहे अग्निसंनिधौ ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004696056, "chapter_id": 24696, "verse_number": "६-१५८-५७", "content_sanskrit": "द्वितीयोऽयं दुराचारो वेषकर्ता समा गतः ।\nमां च प्रार्थयते गुप्तां नानाचारैः पृथग्विधैः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004696057, "chapter_id": 24696, "verse_number": "६-१५८-५८", "content_sanskrit": "ततस्तु पार्थिवः क्रुद्धस्तस्य शाखावलंबनम् ।\nआदिदेश द्विजश्रेष्ठा मणिभद्रस्य दुर्मतेः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004696058, "chapter_id": 24696, "verse_number": "६-१५८-५९", "content_sanskrit": "एतस्मिन्नंतरे सोऽथ वधकानां समर्पितः ।\nतं वृक्षं नीयमानस्तु श्लोकानेतांस्तदापठत् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004696059, "chapter_id": 24696, "verse_number": "६-१५८-६०", "content_sanskrit": "निर्दयत्वं तथा द्रोहं कुटिलत्वं विशेषतः ।\nअशौचं निर्घृणत्वं च स्त्रीणां दोषाः स्वभावजाः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004696060, "chapter_id": 24696, "verse_number": "६-१५८-६१", "content_sanskrit": "अन्तर्विषमया ह्येता बहिर्भागे मनोरमाः ।\nगुञ्जाफलसमाकारा योषितः सर्व दैवहि ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004696061, "chapter_id": 24696, "verse_number": "६-१५८-६२", "content_sanskrit": "उशना वेद यच्छास्त्रं यच्च वेद बृहस्पतिः ।\nमन्वादयस्तथान्येऽपि स्त्रीबुद्धेस्तत्र किंच न ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004696062, "chapter_id": 24696, "verse_number": "६-१५८-६३", "content_sanskrit": "पीयूषमधरे वासं हृदि हालाहलं विषम् ।\nआस्वाद्यतेऽधरस्तेन हृदयं च प्रपीड्यते ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004696063, "chapter_id": 24696, "verse_number": "६-१५८-६४", "content_sanskrit": "अलक्तको यथा रक्तो नरः कामी तथैव च ।\nहृतसारस्तथा सोऽपि पादमूले निपा त्यते ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004696064, "chapter_id": 24696, "verse_number": "६-१५८-६५", "content_sanskrit": "संसारविषवृक्षस्य कुकर्मकुसुमस्य च ।\nनरकार्तिफलस्योक्ता मूलमेषा नितंबिनी ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004696065, "chapter_id": 24696, "verse_number": "६-१५८-६६", "content_sanskrit": "कस्य नो जायते त्रासो दृष्ट्वा दूरा दपि स्त्रियम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004696066, "chapter_id": 24696, "verse_number": "६-१५८-६७", "content_sanskrit": "संसारभ्रमणं नारी प्रथमेऽपि समागमे ।\nवह्निप्रदक्षिणन्यायव्याजेनैव प्रदर्शयेत् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004696067, "chapter_id": 24696, "verse_number": "६-१५८-६८", "content_sanskrit": "एतास्तु निर्घृणत्वेन निर्दय त्वेन नित्यशः ।\nविशेषाज्जाड्यकृत्येन दूषयंति कुलत्रयम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004696068, "chapter_id": 24696, "verse_number": "६-१५८-६९", "content_sanskrit": "कुलत्रयगृहं कीर्त्या निजया धवलीकृतम् ।\nकृष्णं करोत्यकृ त्येन नारी दीपशिखेव तु ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004696069, "chapter_id": 24696, "verse_number": "६-१५८-७०", "content_sanskrit": "धर्मवृक्षस्य वाताली चित्तपद्मशशिप्रभा ।\nसृष्टा कामार्णवग्राही केन मोक्षदृढार्गला ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004696070, "chapter_id": 24696, "verse_number": "६-१५८-७१", "content_sanskrit": "कारा संतानकूटस्य संसारवनवागुरा ।\nस्वर्गमार्गमहागर्ता पुंसां स्त्री वेधसा कृता ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004696071, "chapter_id": 24696, "verse_number": "६-१५८-७२", "content_sanskrit": "वेधसा बंधनं किंचिन्नृणामन्यदपश्यता ।\nस्त्रीरूपेण ततः कोऽपि पाशोऽयं सुदृढः कृतः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004696072, "chapter_id": 24696, "verse_number": "६-१५८-७३", "content_sanskrit": "इत्येवं बहुधा सोऽपि विललाप सुदुःखितः ।\nस्त्रीचिन्तां बहुधा कृत्वा आत्मानं चाप्यगर्हयत् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004696073, "chapter_id": 24696, "verse_number": "६-१५८-७४", "content_sanskrit": "अहो कुबुद्धिना नैव लब्धं संसारजं फलम् ।\nन कदाचिन्मया दत्तं तृष्णाव्याकुलचेतसा ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004696074, "chapter_id": 24696, "verse_number": "६-१५८-७५", "content_sanskrit": "ऐश्वर्येऽपि स्थिते भूरि न मया सुकृतं कृतम् ।\nकदाचिन्नैव जप्तं च न हुतं च हुताशने ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004696075, "chapter_id": 24696, "verse_number": "६-१५८-७६", "content_sanskrit": "अथवा सत्यमेवोक्तं केनापि च महात्मना ।\nकृपणेन समो दाता न भूतो न भविष्यति ।\nअस्पृष्ट्वापि च वित्तं स्वं यः परेभ्यः प्रयच्छति ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004696076, "chapter_id": 24696, "verse_number": "६-१५८-७७", "content_sanskrit": "शरणं किं प्रपन्नानां विषवन्मारयंति किम् ।\nन दीयते न भुज्यंते कृपणेन धनानि च ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004696077, "chapter_id": 24696, "verse_number": "६-१५८-७८", "content_sanskrit": "दानं भोगो नाशस्तिस्रो गतयो भवंति वित्तस्य ।\nयो न ददाति न भुंक्ते तस्य तृतीया गतिर्भवति ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004696078, "chapter_id": 24696, "verse_number": "६-१५८-७९", "content_sanskrit": "धनिनोप्यदानविभवा गण्यंते धुरि दरिद्राणाम् ।\nनहि हंति यत्पिपासामतः समुद्रोऽपि मरुरेव ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004696079, "chapter_id": 24696, "verse_number": "६-१५८-८०", "content_sanskrit": "अत्युपयुक्ताः सद्भिर्गतागतैरहरहः सुनिर्विण्णाः ।\nकृपणजनसंनिकाशं संप्राप्यार्थाः स्वपंतीह ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004696080, "chapter_id": 24696, "verse_number": "६-१५८-८१", "content_sanskrit": "प्राप्तान्न लभंते ते भोगान्भोक्तुं स्वकर्मणा कृपणाः ।\nमुखपाकः किल भवति द्राक्षापाके बलिभुजानाम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004696081, "chapter_id": 24696, "verse_number": "६-१५८-८२", "content_sanskrit": "दातव्यं भोक्तव्यं सति विभवे संचयो न कर्तव्यः ।\nपश्येह मधुकरीणां संचितमर्थं हरंत्यन्ये ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004696082, "chapter_id": 24696, "verse_number": "६-१५८-८३", "content_sanskrit": "याचितं द्विजवरे न दीयते संचितं क्रतुवरे न योज्यते ।\nतत्कदर्यपरिरक्षितं धनं चौरपार्थिवगृहेषु भुज्यते ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004696083, "chapter_id": 24696, "verse_number": "६-१५८-८४", "content_sanskrit": "त्यागो गुणो वित्तवतां वित्तं त्यागवतां गुणः ।\nपरस्परवियुक्तौ तु वित्त त्यागौ विडम्बनम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004696084, "chapter_id": 24696, "verse_number": "६-१५८-८५", "content_sanskrit": "किं तया क्रियते लक्ष्म्या या वधूरिव केवला ।\nया न वेश्येव सामान्या पथिकैरपि भुज्यते ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004696085, "chapter_id": 24696, "verse_number": "६-१५८-८६", "content_sanskrit": "अर्थोष्मणा भवेत्प्राणो भवेद्भक्ष्यैर्विना नृणाम् ।\nयतः संधार्यते भूमिः कृपणस्योष्मणा हि सा ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004696086, "chapter_id": 24696, "verse_number": "६-१५८-८७", "content_sanskrit": "कृपणानां प्रसादेन शेषो धारयते महीम् ।\nयतस्ते भूगतं वित्तं कुर्वते तस्य चोष्मणा ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004696087, "chapter_id": 24696, "verse_number": "६-१५८-८८", "content_sanskrit": "एवं बहुविधा वाचः प्रलपन्मणिभद्रकः ।\nनीत्वा तैः पार्थिवोद्दिष्टैः पुरुषैः परुषाक्षरम् ।\nबहुधा प्रलपं श्चैव कृतः शाखावलंबनः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004696088, "chapter_id": 24696, "verse_number": "६-१५८-८९", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां षष्ठे नागरखण्डे हाटकेश्वरक्षेत्रमाहात्म्ये मणिभद्रोपाख्याने मणिभद्रनिधनवर्णनंनामाष्टपंचाशदुत्तरशततमोऽध्यायः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}]