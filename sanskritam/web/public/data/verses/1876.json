[{"id": 2039647, "chapter_id": 1876, "verse_number": "५-१२१-०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2039648, "chapter_id": 1876, "verse_number": "५-१२१-१", "content_sanskrit": "अथ प्रचलितः स्थानादासनाच्च परिच्युतः।\nकम्पितेनेव मनसा धर्षितः शेकवाह्निना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2039649, "chapter_id": 1876, "verse_number": "५-१२१-२", "content_sanskrit": "म्लानस्रग्भ्रष्टविज्ञानः प्रभ्रष्टमुकुटाङ्गदः ।\nविघूर्णन्स्रस्तसर्वाङ्गः प्रभ्रष्टाभरणाम्बरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2039650, "chapter_id": 1876, "verse_number": "५-१२१-३", "content_sanskrit": "अदृश्यमानस्तान्पश्यन्नपश्यंश्च पुनः पुनः ।\nशून्यः शून्येन मनसा प्रपतिष्यन्महीतलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2039651, "chapter_id": 1876, "verse_number": "५-१२१-४", "content_sanskrit": "किं मया मनसा ध्यातमशुभं धर्मदूषणम् ।\nयेनाहं चलितः स्थानादिति राजा व्यचिन्तयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2039652, "chapter_id": 1876, "verse_number": "५-१२१-५", "content_sanskrit": "ते तु तत्रैव राजानः सिद्धाश्चाप्सरसस्तथा ।\nअपश्यन्त निरालम्बं तं ययातिं परिच्युतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2039653, "chapter_id": 1876, "verse_number": "५-१२१-६", "content_sanskrit": "अथैत्य पुरुषः कश्चित्क्षीणपुण्यनिपातकः ।\nययातिमब्रवीद्राजन्द्रेवराजस्य शासनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2039654, "chapter_id": 1876, "verse_number": "५-१२१-७", "content_sanskrit": "अतीव मदमत्तस्त्वं न कंचिन्नावमन्यसे ।\nमानेन भ्रष्टः स्वर्गस्ते नार्हस्त्वं पार्थिवात्मज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2039655, "chapter_id": 1876, "verse_number": "५-१२१-८", "content_sanskrit": "न च प्रज्ञायसे गच्छ पतस्वेति तमब्रवीत् ।\nपतेयं सत्स्विति वचस्त्रिरुत्त्का नहुषात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2039656, "chapter_id": 1876, "verse_number": "५-१२१-९", "content_sanskrit": "पतिष्यंन्तयामास गतिं गतिमतां वरः।\nएतस्मिन्नेव काले तु नैमिषे पार्थिवर्षभान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2039657, "chapter_id": 1876, "verse_number": "५-१२१-१०", "content_sanskrit": "चतुरोऽपश्यत नृपस्तेषां मध्ये पपात ह ।\nप्रतर्दनो वसुमनाः शिबिरौशीनरोऽष्टकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2039658, "chapter_id": 1876, "verse_number": "५-१२१-११", "content_sanskrit": "वाजपेयेन यज्ञेन तर्पयन्ति सुरेश्वरम् ।\nतेषामध्वरजं धूमं स्वर्गद्वारमुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2039659, "chapter_id": 1876, "verse_number": "५-१२१-१२", "content_sanskrit": "ययातिरुपजिघ्रन्वै निपपात महीं प्रति ।\nभूमौ स्वर्गे च संबद्धां नदीं धूममयीमिव ।\nगङ्गां गामिव गच्छन्तीमालम्ब्य जगतीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2039660, "chapter_id": 1876, "verse_number": "५-१२१-१३", "content_sanskrit": "श्रीमत्स्ववभृथाग्र्येषु चतुर्षु प्रतिबन्धुषु ।\nमध्ये निपतितो राजा लोकपालोपमेषु सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2039661, "chapter_id": 1876, "verse_number": "५-१२१-१४", "content_sanskrit": "चतुर्षु हुतकल्पेषु राजसिंहमहाग्निषु ।\nपपात मध्ये राजर्षिर्ययातिः पुण्यसङ्क्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2039662, "chapter_id": 1876, "verse_number": "५-१२१-१५", "content_sanskrit": "तमाहुः पार्थिवाः सर्वे दीप्यमानमिव श्रिया ।\nको भवान्कस्य वा बन्धुर्देशस्य नगरस्य वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2039663, "chapter_id": 1876, "verse_number": "५-१२१-१६", "content_sanskrit": "यक्षो वाऽप्यथवा देवो गन्धर्वो राक्षसोऽपि वा ।\nन हि मानुषरूपोसि कोवार्थः काङ्क्ष्यते त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2039664, "chapter_id": 1876, "verse_number": "५-१२१-१७x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2039665, "chapter_id": 1876, "verse_number": "५-१२१-१७", "content_sanskrit": "ययातिरस्मि राजर्षिः क्षीणपुण्यश्च्युतो दिवः।\nपतेयं सत्स्विति ध्यायन्भवत्सु पतितस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2039666, "chapter_id": 1876, "verse_number": "५-१२१-१८x", "content_sanskrit": "राजान ऊचुः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2039667, "chapter_id": 1876, "verse_number": "५-१२१-१८", "content_sanskrit": "सत्यमेतद्भवतु ते काङ्क्षितं पुरुषर्षभ ।\nसर्वेषां नः क्रतुफलं धर्मश्च प्रतिगृह्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2039668, "chapter_id": 1876, "verse_number": "५-१२१-१९x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2039669, "chapter_id": 1876, "verse_number": "५-१२१-१९", "content_sanskrit": "नाहं प्रतिग्रहधनो ब्राह्मणः क्षत्रियोऽह्यहम्।\nन च मे प्रवणा बुद्धिः परपुण्यविनाशने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2039670, "chapter_id": 1876, "verse_number": "५-१२१-२०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2039671, "chapter_id": 1876, "verse_number": "५-१२१-२०", "content_sanskrit": "एतस्मिन्नेव काले तु मृगचर्याक्रमागताम्।\nमाधवीं प्रेक्ष्य राजानस्तेऽभिवाद्येदमब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2039672, "chapter_id": 1876, "verse_number": "५-१२१-२१", "content_sanskrit": "किमागमनकृत्यं ते किं कुर्मः शासनं तव।\nआज्ञाप्या हि वयं सर्वे तव पुत्रास्तपोधने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2039673, "chapter_id": 1876, "verse_number": "५-१२१-२२x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2039674, "chapter_id": 1876, "verse_number": "५-१२१-२२", "content_sanskrit": "तेषां तद्भाषितं श्रुत्वा माधवी परया मुदा।\nपितरं समुपागच्छद्ययातिं सा ववन्द च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2039675, "chapter_id": 1876, "verse_number": "५-१२१-२३", "content_sanskrit": "स्पृष्ट्वा मूर्धनि तान्पुत्रांस्तापसी वाक्यमब्रवीत् ।\nदौहित्रास्तव राजेन्द्र मम पुत्रा न ते पराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2039676, "chapter_id": 1876, "verse_number": "५-१२१-२४", "content_sanskrit": "इमे त्वां तारयिष्यन्ति दिष्टमेतत्पुरातनम् ।\nअहं ते दुहिता राजन्माधवी मृगचारिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2039677, "chapter_id": 1876, "verse_number": "५-१२१-२५", "content_sanskrit": "मयाऽप्युपचितो धर्मस्ततोऽर्धं प्रतिगृह्यताम् ।\nयस्माद्राजन्नराः सर्वे अपत्यफलभागिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2039678, "chapter_id": 1876, "verse_number": "५-१२१-२६", "content_sanskrit": "तस्मादिच्छन्ति दौहित्रान्यथा त्वं वसुधाधिप ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2039679, "chapter_id": 1876, "verse_number": "५-१२१-२६x", "content_sanskrit": "नारद उवाच।\nततस्ते पार्थिवाः सर्वे शिरसा जननीं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2039680, "chapter_id": 1876, "verse_number": "५-१२१-२७", "content_sanskrit": "अभिवाद्य नमस्कृत्य मातामहमथाब्रुवन् ।\nउच्चैरनुपमैः स्निग्धैः स्वरैरापूर्य मेदिनीम् ।\nमातामहं नृपतयस्तारयन्तो दिवश्च्युतम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2039681, "chapter_id": 1876, "verse_number": "५-१२१-२८x", "content_sanskrit": "` राजान ऊचुः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2039682, "chapter_id": 1876, "verse_number": "५-१२१-२८", "content_sanskrit": "राजधर्मगुणोपेताः सत्यधर्मगुणान्विताः।\nदौहित्रास्ते वयं राजन्दिवमारोह पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2039683, "chapter_id": 1876, "verse_number": "५-१२१-२९x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2039684, "chapter_id": 1876, "verse_number": "५-१२१-२९", "content_sanskrit": "अथाकस्मादुपगतो गालवोऽप्याह पार्थिवम् ।\nतपसो मेऽष्टभागेन स्वर्गमारोहतां भवान् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2039685, "chapter_id": 1876, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि एकविंशत्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]