[{"id": 2102400, "chapter_id": 3215, "verse_number": "१४-७१-१", "content_sanskrit": "वैशम्पायन उवाच।\nतान्समीपगताञ्श्रुत्वा पाण्डवाञ्शत्रुकर्शनः।\nवासुदेवः सहामात्यः प्रययौ ससुहृद्गणः।\nते समेत्य यथान्यायं प्रत्युद्याता दिदृक्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2102401, "chapter_id": 3215, "verse_number": "१४-७१-२", "content_sanskrit": "ते समेत्य तथाधर्मं पाण्डवा वृष्णिभिः सह।\nविविशुः सहिता राजन्पुरं वारणसाह्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2102402, "chapter_id": 3215, "verse_number": "१४-७१-३", "content_sanskrit": "विशतस्तस्य सैन्यस्य खुरनेमिस्वनेन ह।\nद्यावापृथिव्यौ खं चैव सर्वमासीत्समावृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2102403, "chapter_id": 3215, "verse_number": "१४-७१-४", "content_sanskrit": "ते कोशानग्रतः कृत्वा विविशुः स्वं पुरं तदा।\nपाण्डवाः प्रीतमनसः सामात्याः ससुहृद्गणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2102404, "chapter_id": 3215, "verse_number": "१४-७१-५", "content_sanskrit": "ते समेत्य यथान्यायं धृतराष्ट्रं जनाधिपम्।\nकीर्तयन्तः स्वनामानि तस्य पादौ ववन्दिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2102405, "chapter_id": 3215, "verse_number": "१४-७१-६", "content_sanskrit": "धृतराष्ट्राभ्यनुज्ञाता गान्धारीं सुबलात्मजाम्।\nकुन्तीं च राजशार्दूल तदा भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2102406, "chapter_id": 3215, "verse_number": "१४-७१-७", "content_sanskrit": "विदुरं यूजयित्वा च वैश्यापुत्रं समेत्य च।\nपूज्यमानाः स्म ते वीरा व्यरोचन्त विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2102407, "chapter_id": 3215, "verse_number": "१४-७१-८", "content_sanskrit": "ततस्तत्परमाश्चर्यं विचित्रं महदद्भुतम्।\nशुश्रुवुस्ते तदा वीराः पितुस्ते जन्म भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2102408, "chapter_id": 3215, "verse_number": "१४-७१-९", "content_sanskrit": "तदुपश्रुत्य तत्कर्म वासुदेवस्य धीमतः।\nपूजार्हं पूजयामासुः कृष्णं देवकीनन्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2102409, "chapter_id": 3215, "verse_number": "१४-७१-१०", "content_sanskrit": "ततः कतिपयाहस्य व्यासः सत्यवतीसुतः।\nआजगाम महातेजा नगरं नागसाह्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2102410, "chapter_id": 3215, "verse_number": "१४-७१-११", "content_sanskrit": "तस्य सर्वे यथान्यायं पूजा चक्रुः कुरूद्वहाः।\nसह वृष्ण्यन्धकव्याघ्रैरुपासांचक्रिरे तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2102411, "chapter_id": 3215, "verse_number": "१४-७१-१२", "content_sanskrit": "तत्र नानाविधाकाराः कथाः समभिकीर्त्य वै।\nयुधिष्ठिरो धर्मसुतो व्यासं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2102412, "chapter_id": 3215, "verse_number": "१४-७१-१३", "content_sanskrit": "भवत्प्रसादाद्भगवन्यदिदं रत्नमाहृतम्।\nउपयोक्तुं तदिच्छामि वाजिमेधे महाक्रतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2102413, "chapter_id": 3215, "verse_number": "१४-७१-१४", "content_sanskrit": "तमनुज्ञातुमिच्छामि भवता मुनिसत्तम।\nत्वदधीना वयं सर्वे कृष्णस्य च महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2102414, "chapter_id": 3215, "verse_number": "१४-७१-१५x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2102415, "chapter_id": 3215, "verse_number": "१४-७१-१५", "content_sanskrit": "अनुजानामि राजंस्त्वां क्रियतां यदनन्तरम्।\nयजस्व वाजिमेधेन विधिवद्दक्षिणावता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2102416, "chapter_id": 3215, "verse_number": "१४-७१-१६", "content_sanskrit": "अश्वमेधो हि राजेन्द्र पावनः सर्वपाप्मनाम्।\nतेनेष्ट्वा त्वं विपात्मा वै भविता नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2102417, "chapter_id": 3215, "verse_number": "१४-७१-१७", "content_sanskrit": "इत्युक्तः स तु धर्मात्मा कुरुराजो युधिष्ठिरः।\nअश्वमेधस्य कौरव्य चकाराहरणे मतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2102418, "chapter_id": 3215, "verse_number": "१४-७१-१८", "content_sanskrit": "समनुज्ञाप्य तत्सर्वं कृष्मद्वैपायनं नृपः।\nवासुदेवमथाभ्येत्य वाग्मी वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2102419, "chapter_id": 3215, "verse_number": "१४-७१-१९", "content_sanskrit": "देवकी सुप्रजा देवी त्वया पुरुषसत्तम।\nयद्ब्रूयां त्वां महाबाहो तत्कृथास्त्वमिहाच्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2102420, "chapter_id": 3215, "verse_number": "१४-७१-२०", "content_sanskrit": "त्वत्प्रभावार्जितान्भोगानश्नीम यदुनन्दन।\nपराक्रमेण बुद्ध्या च त्वयेयं निर्जिता मही॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2102421, "chapter_id": 3215, "verse_number": "१४-७१-२१", "content_sanskrit": "दीक्षयस्व त्वमात्मानं त्वं हि नः परमो गुरुः।\nत्वयीष्टवति दाशार्ह विपाप्मा भविता ह्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2102422, "chapter_id": 3215, "verse_number": "१४-७१-२२", "content_sanskrit": "त्वं हि यज्ञो गुरुश्च त्वं धर्मज्ञस्त्वं प्रजापतिः।\nत्वं गतिः सर्वभूतानामिति मे निश्चिता मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2102423, "chapter_id": 3215, "verse_number": "१४-७१-२३x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2102424, "chapter_id": 3215, "verse_number": "१४-७१-२३", "content_sanskrit": "त्वमेवैतन्महाबाहो कर्तुमर्हस्यरिंदम।\nत्वं गतिः सर्वभूतानामिति मे निश्चिता मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2102425, "chapter_id": 3215, "verse_number": "१४-७१-२४", "content_sanskrit": "त्वं चाद्यि कुरुवीराणां धर्मेण हि विराजसे।\nगुणीभूताः स्म ते राजंस्त्वं नो राजन्गुरुर्मतः।\nयजस्व मदनुज्ञातः प्राप्य एष क्रतुस्त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2102426, "chapter_id": 3215, "verse_number": "१४-७१-२५", "content_sanskrit": "युनक्तु नो भवान्कार्ये यत्र वाञ्छसि भारत।\nसत्यं ते प्रतिजानामि सर्वं कर्तास्मि तेऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2102427, "chapter_id": 3215, "verse_number": "१४-७१-२६", "content_sanskrit": "भीमसेनार्जुनौ चैव तथा माद्रवतीसुतौ।\nइष्टवन्तो भविष्यन्ति त्वयीष्टवति पार्थिवे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2102428, "chapter_id": 3215, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि एकसप्ततितमोऽध्यायः॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]