[{"id": 2190345, "chapter_id": 5051, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2190346, "chapter_id": 5051, "verse_number": "१", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nप्रजानामनुकम्पार्थं गीतं राज्ञा विचख्नुना\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2190347, "chapter_id": 5051, "verse_number": "२", "content_sanskrit": "छिन्नस्थूणं वृषं दृष्ट्वा विरावं च गवां भृशम् ।\nगोग्रहे यज्ञवाटस्य प्रेक्षमाणः स पार्थिवः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2190348, "chapter_id": 5051, "verse_number": "३", "content_sanskrit": "स्वस्ति गोभ्योऽस्तु लोकेषु ततो निर्वचनं कृतम् ।\nहिंसायां हि प्रवृत्तायामाशीरेषानुकल्पिता\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2190349, "chapter_id": 5051, "verse_number": "४", "content_sanskrit": "अव्यवस्थितमर्यादैर्विमूढैर्नास्तिकैर्नरैः ।\nसंशयात्मभिरव्यक्तैर्हिंसा समनुकीर्तिता\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2190350, "chapter_id": 5051, "verse_number": "५", "content_sanskrit": "सर्वकर्मस्वहिंसा हि धर्मात्मा मनुरब्रवीत् ।\nकामरागाद् विहिंसन्ति बहिर्वेद्यां पशून्नराः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2190351, "chapter_id": 5051, "verse_number": "६", "content_sanskrit": "तस्मात् प्रमाणतः कार्यो धर्मः सूक्ष्मो विजानता ।\nअहिंसैव हि सर्वेभ्यो धर्मेभ्यो ज्यायसी मता\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2190352, "chapter_id": 5051, "verse_number": "७", "content_sanskrit": "उपोष्य संशितो भूत्वा हित्वा वेदकृतां शुचिः ।\nआचार इत्यनाचाराः कृपणाः फलहेतवः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2190353, "chapter_id": 5051, "verse_number": "८", "content_sanskrit": "यदि छिन्दन्ति वृक्षांश्च यूपांश्चोद्दिश्य मानवाः ।\nवृथा मांसानि खादन्ति नैष धर्मः प्रशस्यते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2190354, "chapter_id": 5051, "verse_number": "९", "content_sanskrit": "मांसं मधु सुरा मत्स्या आसवं कृसरोदनम् ।\nधूर्तैः प्रवर्तितं ह्येतन्नैतद्वेदेषु कल्पितम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2190355, "chapter_id": 5051, "verse_number": "१०", "content_sanskrit": "कामान्मोहाच्च लोभाच्च लौल्यमेतत् प्रवर्तितम् ।\nविष्णुमेवाभिजानन्ति सर्वयज्ञेषु ब्राह्मणाः ।\nपायसैः सुमनोभिश्च तस्यापि यजनं स्मृतम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2190356, "chapter_id": 5051, "verse_number": "११", "content_sanskrit": "यज्ञियाश्चैव ये वृक्षा वेदेषु परिकल्पिताः ।\nयच्चापि किञ्चित् कर्तव्यमन्यच्चोक्षैः सुसंस्कृतम्॥\nमहासत्त्वैः शुद्धभावैः सर्वं देवार्हमेव तत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2190357, "chapter_id": 5051, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2190358, "chapter_id": 5051, "verse_number": "१२", "content_sanskrit": "शरीरमापदश्चापि विवदन्त्यविहिंसतः ।\nकथं यात्रा शरीरस्य निरारम्भस्य सेत्स्यति\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2190359, "chapter_id": 5051, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2190360, "chapter_id": 5051, "verse_number": "१३", "content_sanskrit": "यथा शरीरं न ग्लायेन्नेयान्मृत्युवशं यथा ।\nतथा कर्मसु वर्तेत समर्थो धर्ममाचरेत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2190361, "chapter_id": 5051, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे विचख्युगीतासु शततमोऽध्यायः ॥१००॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]