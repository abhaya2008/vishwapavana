[{"id": 2097930, "chapter_id": 3096, "verse_number": "१३-२२६-१", "content_sanskrit": "उमोवाच।\nदेवदेव महादेव श्रुतं मे भगवन्निदम्।\nआत्मनो जातिसम्बन्धं ब्रूहि स्त्रीपुरुषान्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2097931, "chapter_id": 3096, "verse_number": "१३-२२६-२", "content_sanskrit": "स्त्रीप्राणाः पुरुषप्राणा एकतः पृथगेव वा।\nएष मे संशयो देव तं मे छेत्तुं त्वमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2097932, "chapter_id": 3096, "verse_number": "१३-२२६-३x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2097933, "chapter_id": 3096, "verse_number": "१३-२२६-३", "content_sanskrit": "तदहं ते प्रवक्ष्यामि शृणु सर्वं समाहिता।\nस्त्रीत्वं पुंस्त्वमिति प्राणे स्थितिर्नास्ति शुभेक्षणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2097934, "chapter_id": 3096, "verse_number": "१३-२२६-४", "content_sanskrit": "निर्विकारः सदैवात्मा स्त्रीत्वं पुंस्त्वं न चात्मनि।\nकर्मप्रकारेण तथा जात्यां जात्यां प्रजायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2097935, "chapter_id": 3096, "verse_number": "१३-२२६-५", "content_sanskrit": "कृत्वा कर्म पुमान्स्त्री वा स्त्री पुमानपि जायते।\nस्त्रीभावं यत्पुमान्कृत्वा कर्मणा प्रमदा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2097936, "chapter_id": 3096, "verse_number": "१३-२२६-६x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2097937, "chapter_id": 3096, "verse_number": "१३-२२६-६", "content_sanskrit": "भगवन्सर्वलोकेश कर्मात्मा न करोति चेत्।\nकोऽन्यः कर्मकरो देहे तन्मे त्वं वक्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2097938, "chapter_id": 3096, "verse_number": "१३-२२६-७x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2097939, "chapter_id": 3096, "verse_number": "१३-२२६-७", "content_sanskrit": "शृणु भामिनि कर्तारमात्मा हि न च कर्मकृत्।\nप्रकृत्या गुणयुक्तेन क्रियते कर्म नित्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2097940, "chapter_id": 3096, "verse_number": "१३-२२६-८", "content_sanskrit": "शरीरं प्राणिनां लोके यथा पित्तकफानिलैः।\nव्याप्तमेभिस्त्रिभिर्दोषैस्तथा व्याप्तं त्रिभिर्गुणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2097941, "chapter_id": 3096, "verse_number": "१३-२२६-९", "content_sanskrit": "सत्वं रजस्तमश्चैव गुणास्त्वेते शरीरिणः।\nप्रकाशात्मकमेतेषां सत्वं सततमिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2097942, "chapter_id": 3096, "verse_number": "१३-२२६-१०", "content_sanskrit": "रजो दुःखत्मकं तत्र तमो मोहात्मकं स्मृतम्।\nत्रिभिरेतैर्गुणैर्युक्तं लोके कर्म प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2097943, "chapter_id": 3096, "verse_number": "१३-२२६-११", "content_sanskrit": "सत्यं प्राणिदया शौचं श्रेयः प्रीतिः क्षमा दमः।\nएवमादि तथाऽन्यश्च कर्म सात्विकमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2097944, "chapter_id": 3096, "verse_number": "१३-२२६-१२", "content_sanskrit": "दाक्ष्यं कर्मपरत्वं च लोभो मोहो विधिं प्रति।\nकलत्रसङ्गो माधुर्यं नित्यमैश्वर्यलुब्धता।\nरजसश्चोद्भवं चैतत्कर्म नानाविधं सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2097945, "chapter_id": 3096, "verse_number": "१३-२२६-१३", "content_sanskrit": "अनृतं चैव पारुष्यं धृतिर्विद्वेषिता भृशम्।\nहिंसाऽसत्यं च नास्तिक्यं निद्रालस्यभयानि च।\nतमसश्चोद्भवं चैतत्कर्म पापयुतं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2097946, "chapter_id": 3096, "verse_number": "१३-२२६-१४", "content_sanskrit": "तस्माद्गुणमयः सर्वः कार्यारम्भः शुभाशुभः।\nतस्मादात्मानमव्यग्रं विद्ध्यकर्तारमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2097947, "chapter_id": 3096, "verse_number": "१३-२२६-१५", "content_sanskrit": "सात्विकाः पुण्यलोकेषु राजसा मानुषे पदे।\nतिर्यग्योनौ च नरके तिष्ठेयुस्तामसा नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2097948, "chapter_id": 3096, "verse_number": "१३-२२६-१६x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2097949, "chapter_id": 3096, "verse_number": "१३-२२६-१६", "content_sanskrit": "किमर्थमात्मा भिन्नेऽस्मिन्देहे शस्त्रेण वा हते।\nस्वयं प्रयास्यति तदा तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2097950, "chapter_id": 3096, "verse_number": "१३-२२६-१७x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2097951, "chapter_id": 3096, "verse_number": "१३-२२६-१७", "content_sanskrit": "तदहं ते प्रक्ष्यामि शृणु कल्याणि कारणम्।\nएतन्निर्णायकैश्चापि मुह्यन्ते सूक्ष्मबुद्धिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2097952, "chapter_id": 3096, "verse_number": "१३-२२६-१८", "content_sanskrit": "कर्मक्षये तु सम्प्राप्ते प्राणिनां जन्मधारिणाम्।\nउपद्रवो भवेद्देहे येन केनापि हेतुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2097953, "chapter_id": 3096, "verse_number": "१३-२२६-१९", "content_sanskrit": "तन्निमित्तं शरीरी तु शरीरं प्राप्य संक्षयम्।\nअपयाति परित्यज्य ततः कर्मवशेन सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2097954, "chapter_id": 3096, "verse_number": "१३-२२६-२०", "content_sanskrit": "देहक्षयेपि नैवात्मा वेदनाभिर्न चाल्यते।\nतिष्ठेत्कर्मफलं यावद्व्रजेत्कर्मक्षये पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2097955, "chapter_id": 3096, "verse_number": "१३-२२६-२१", "content_sanskrit": "आदिप्रभृति लोकेऽस्मिन्नेवमात्मगतिः स्मृता।\nएतत्ते कथितं देवि किं भूयः श्रोतुमिच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2097956, "chapter_id": 3096, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि षड्विंशत्यधिकद्विशततमोऽध्यायः॥ २२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]