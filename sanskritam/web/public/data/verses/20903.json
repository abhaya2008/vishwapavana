[{"id": 7000903000, "chapter_id": 20903, "verse_number": "६-२४६-१", "content_sanskrit": "श्रीमहेश्वर उवाच ।\nअथोपनयनं नाम चकारानकदुंदुभिः ।\nपुत्रयोर्वेदविधिना तस्मिन्वै रामकृष्णयोः ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000903001, "chapter_id": 20903, "verse_number": "६-२४६-२", "content_sanskrit": "आचार्येण हि गर्गेण संस्कृतौ रामकेशवौ ।\nपंडितैर्वैष्णवैर्दिव्यैः स्नापनैर्विमलैः शुभैः ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000903002, "chapter_id": 20903, "verse_number": "६-२४६-३", "content_sanskrit": "कृतसंस्कारकर्माणौ रामकृष्णौ महाबलौ ।\nसांदीपनेर्गृहं गत्वा नमस्कृत्य महात्मनः ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000903003, "chapter_id": 20903, "verse_number": "६-२४६-४", "content_sanskrit": "अधीत्य वेदशास्त्राणि तस्मात्तौ द्विजपुंगवात् ।\nमृतं पुत्रं समानीय ददतुस्तस्य दक्षिणाम् ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000903004, "chapter_id": 20903, "verse_number": "६-२४६-५", "content_sanskrit": "आशिषो वचनं लब्ध्वा गुरोस्तस्मान्महात्मनः ।\nतस्मै प्रणम्य मथुरां जग्मतुर्यदुपुंगवौ ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000903005, "chapter_id": 20903, "verse_number": "६-२४६-६", "content_sanskrit": "अथ कृष्णेन निहतं श्रुत्वा कंसं दुरासदम् ।\nश्वशुरस्तस्य नृपतेर्जरासंधो महाबलः ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000903006, "chapter_id": 20903, "verse_number": "६-२४६-७", "content_sanskrit": "अक्षौहिणीसहस्रैस्तु सेनानीकैर्महाबलैः ।\nकृष्णं हंतुं समागत्य रुरोध मथुरां पुरीम् ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000903007, "chapter_id": 20903, "verse_number": "६-२४६-८", "content_sanskrit": "रामकृष्णौ महावीर्यौ विनिर्गत्य पुरोत्तमात् ।\nगजवाजिसमाकीर्णं तद्बलौघमपश्यताम् ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000903008, "chapter_id": 20903, "verse_number": "६-२४६-९", "content_sanskrit": "सस्मार वासुदेवस्तु पूर्वं रूपं सनातनम् ।\nतस्य स्मरणमात्रेण दारुको विष्णुसारथिः ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000903009, "chapter_id": 20903, "verse_number": "६-२४६-१०", "content_sanskrit": "सुग्रीवपुष्पकं नाम समानीय महारथम् ।\nवाजिभिर्दिव्यपुष्पाद्यैरुह्यमानं सनातनम् ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000903010, "chapter_id": 20903, "verse_number": "६-२४६-११", "content_sanskrit": "दिव्यायुधैरुपेतं तं शंखचक्रगदादिभिः ।\nवैनतेयपताकेन शोभितं देवदुर्जयम् ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000903011, "chapter_id": 20903, "verse_number": "६-२४६-१२", "content_sanskrit": "अवनीं प्राप्य गोविंदं प्रणम्य हरिसारथिः ।\nप्रददौ स्यंदनं शुभ्रं सायुधाश्वसमन्वितम् ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000903012, "chapter_id": 20903, "verse_number": "६-२४६-१३", "content_sanskrit": "दृष्ट्वा हर्षेण कृष्णोऽपि परिणीय महारथम् ।\nआरुरोहाग्रजेनैव स्तूयमानो मरुद्गणैः ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000903013, "chapter_id": 20903, "verse_number": "६-२४६-१४", "content_sanskrit": "चतुर्भुजं वपुर्भूत्वा शंखचक्रगदासिभृत् ।\nकिरीटी कुंडली स्रग्वी संग्रामाभिमुखं ययौ ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000903014, "chapter_id": 20903, "verse_number": "६-२४६-१५", "content_sanskrit": "बलदेवोऽपि मुशलं लांगलं गृह्य वीर्यवान् ।\nतत्सैन्यं हंतुमारेभे महेश्वर इवापरः ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000903015, "chapter_id": 20903, "verse_number": "६-२४६-१६", "content_sanskrit": "दारुकश्च रथं शीघ्रं नोदयामास तद्रणे ।\nतृणगुल्मलताक्रांते काननेऽग्निमिवानिलः ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000903016, "chapter_id": 20903, "verse_number": "६-२४६-१७", "content_sanskrit": "ततो गदाभिः परिघैः शक्तिभिर्मुद्गरैस्तथा ।\nतद्रथं छादयामासुर्जरासंधस्य सैनिकाः ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000903017, "chapter_id": 20903, "verse_number": "६-२४६-१८", "content_sanskrit": "चक्रेणैव हरिस्तूर्णं तानि चिच्छेद लीलया ।\nबहूनि तृणकाष्ठानि महावह्निरिवार्चिषा ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000903018, "chapter_id": 20903, "verse_number": "६-२४६-१९", "content_sanskrit": "ततः शार्ङ्गं समादाय सायकैरक्षयैः शितैः ।\nचिच्छेद तानि सैन्यानि न प्राज्ञायत किंचन ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000903019, "chapter_id": 20903, "verse_number": "६-२४६-२०", "content_sanskrit": "चक्रच्छिन्नास्यकमलाः केचित्तत्र महाबलाः ।\nगदया चूर्णिताः केचित्केचिदन्यैर्महारणे ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000903020, "chapter_id": 20903, "verse_number": "६-२४६-२१", "content_sanskrit": "केचिच्चैवासिनाछिन्नास्तथान्ये शरताडिताः ।\nलांगलाग्रहतग्रीवा मुशलाहतमस्तकाः ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000903021, "chapter_id": 20903, "verse_number": "६-२४६-२२", "content_sanskrit": "क्षणेन तद्बलं सर्वं निहत्य मधुसूदनः ।\nशंखं दध्मौ यदुश्रेष्ठो लयाशनि निभस्वनम् ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000903022, "chapter_id": 20903, "verse_number": "६-२४६-२३", "content_sanskrit": "शंखरावविनिर्भिन्नहृदयास्ते महाबलाः ।\nयोधाः साश्वाः सनागाश्च पतितास्त्यक्तजीविताः ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000903023, "chapter_id": 20903, "verse_number": "६-२४६-२४", "content_sanskrit": "अक्षौहिणीसहस्रं तु साश्वं सरथकुंजरम् ।\nकृष्णेनैकेन निहतं निःशेषं तदभूद्बलम् ॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000903024, "chapter_id": 20903, "verse_number": "६-२४६-२५", "content_sanskrit": "निहतं वासुदेवेन प्रहरार्द्धेन शार्ङ्गिणा ।\nततो देवगणाः सर्वे हर्षनिर्भरचेतसः ॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000903025, "chapter_id": 20903, "verse_number": "६-२४६-२६", "content_sanskrit": "ववृषुः पुष्पवर्षाणि साधुसाध्विति चाब्रुवन् ।\nसर्वमप्यवनीभारं विमुच्य धरणीधरः ॥२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000903026, "chapter_id": 20903, "verse_number": "६-२४६-२७", "content_sanskrit": "संस्तूयमानस्त्रिदशैर्बभौ संग्राममूर्द्धनि ।\nनिहतं स्वबलं दृष्ट्वा जरासंधोऽतिवीर्यवान् ॥२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000903027, "chapter_id": 20903, "verse_number": "६-२४६-२८", "content_sanskrit": "योद्धुमभ्याययौ तूर्णं बलदेवेन दुर्मतिः ।\nतयोर्युद्धमभूद्धोरं संग्रामेष्वनिवर्तिनोः ॥२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000903028, "chapter_id": 20903, "verse_number": "६-२४६-२९", "content_sanskrit": "रामो लांगलमादाय रथं तस्य ससारथिम् ।\nविनिपात्य रणे शूरो गृहीत्वा तं महाबलम् ॥२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000903029, "chapter_id": 20903, "verse_number": "६-२४६-३०", "content_sanskrit": "उद्यम्य मुशलं तूर्णं तं हंतुमुपचक्रमे ।\nप्राणसंशयमापन्नं जरासंधं नृपोत्तमम् ॥३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000903030, "chapter_id": 20903, "verse_number": "६-२४६-३१", "content_sanskrit": "कृतं रामेण बलिना सिंहेनेव महागजम् ।\nदृष्ट्वा कृष्णोग्रजं प्राह न हंतव्य इति प्रभुः ॥३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000903031, "chapter_id": 20903, "verse_number": "६-२४६-३२", "content_sanskrit": "मोचयामास धर्मात्मा जरासंधं महामतिः ।\nविमुच्य कृष्णवाक्येन शत्रुं संकर्षणोऽव्ययः ॥३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000903032, "chapter_id": 20903, "verse_number": "६-२४६-३३", "content_sanskrit": "सानुजो रथमारुह्य मथुरां प्रविवेश ह ।\nस कालयवनं प्राप्य महावीर्यं बलान्वितम् ॥३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000903033, "chapter_id": 20903, "verse_number": "६-२४६-३४", "content_sanskrit": "पुत्रयोर्वसुदेवस्य समाचष्ट पराक्रमम् ।\nदानवानां वधं चैव कंसस्य निधनं तथा ॥३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000903034, "chapter_id": 20903, "verse_number": "६-२४६-३५", "content_sanskrit": "अक्षौहिणीनां च वधं तथा स्वस्य पराजयम् ।\nसर्वं निवेदयामास कृष्णस्य चरितं महत् ॥३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000903035, "chapter_id": 20903, "verse_number": "६-२४६-३६", "content_sanskrit": "तच्छ्रुत्वा यवनः क्रुद्धो महाबलपराक्रमैः ।\nम्लेच्छकोटिसहस्रैस्तु संवृतो मदसंयुतैः ॥३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000903036, "chapter_id": 20903, "verse_number": "६-२४६-३७", "content_sanskrit": "मगधाधिपतेस्तस्य सहायार्थं महाबलः ।\nतेनैव सहितस्तूर्णं जगाम मथुरां पुरीम् ॥३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000903037, "chapter_id": 20903, "verse_number": "६-२४६-३८", "content_sanskrit": "बलैराच्छाद्य पृथिवीं नानाजनपदान्विताम् ।\nसंनिवेश्य महासैन्यं रुरोध मथुरां पुरीम् ॥३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000903038, "chapter_id": 20903, "verse_number": "६-२४६-३९", "content_sanskrit": "कृष्णोऽपि चिंतयित्वाऽथ पौराणां कुशलं तदा ।\nययाचे सागरं भूमिं निवासार्थं जनस्य च ॥३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000903039, "chapter_id": 20903, "verse_number": "६-२४६-४०", "content_sanskrit": "त्रिंशद्योजनविस्तीर्णां ददौ कृष्णस्य सागरः ।\nअसृजत्पयसां मध्ये तत्र द्वारवतीं पुरीम् ॥४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000903040, "chapter_id": 20903, "verse_number": "६-२४६-४१", "content_sanskrit": "बहुप्रासादसंयुक्तां हेमप्राकारतोरणाम् ।\nनानामणिमयैर्दिव्यैर्गृहपंक्तिभिरावृताम् ॥४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000903041, "chapter_id": 20903, "verse_number": "६-२४६-४२", "content_sanskrit": "उद्यानैश्च तथा रम्यैस्तडागैर्बहुभिर्युताम् ।\nअसृजत्पुंडरीकाक्षो यथेंद्रस्यामरावतीम् ॥४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000903042, "chapter_id": 20903, "verse_number": "६-२४६-४३", "content_sanskrit": "सुषुप्तान्मथुरायां तु पौरांस्तत्र जनार्दनः ।\nउद्धृत्य सहसा रात्रौ द्वारावत्यां निवेशयत् ॥४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000903043, "chapter_id": 20903, "verse_number": "६-२४६-४४", "content_sanskrit": "प्रबुद्धास्ते जनाः सर्वे पुत्रदारसमन्विताः ।\nहेमहर्म्यतलेविष्टा विस्मयं परमं ययुः ॥४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000903044, "chapter_id": 20903, "verse_number": "६-२४६-४५", "content_sanskrit": "बहुभिर्धनधान्यैश्च दिव्यवस्त्रविभूषणैः ।\nपरिपूर्णैरिवाभोगैर्गृहमुख्यैः समावृताः ॥४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000903045, "chapter_id": 20903, "verse_number": "६-२४६-४६", "content_sanskrit": "तस्मिन्प्रहृष्टाः संतस्थुर्दिवि देवगणा इव ।\nयवनेन तदा योद्धुं रामकृष्णौ महाबलौ ॥४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000903046, "chapter_id": 20903, "verse_number": "६-२४६-४७", "content_sanskrit": "विनिर्ययतुरात्मेशौ मथुराया बहिस्तदा ।\nरामो लांगलमादाय मुशलं च महारथः ॥४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000903047, "chapter_id": 20903, "verse_number": "६-२४६-४८", "content_sanskrit": "जघान समरे क्रुद्धो यवनानां महद्बलम् ।\nकृष्णस्तु शार्ङ्गमासज्य बाणैरग्निशिखोपमैः ॥४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000903048, "chapter_id": 20903, "verse_number": "६-२४६-४९", "content_sanskrit": "निर्ददाह बलं सर्वं म्लेच्छानां देवकीसुतः ।\nनिहतं स्वबलं दृष्ट्वा स कालयवनो बली ॥४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000903049, "chapter_id": 20903, "verse_number": "६-२४६-५०", "content_sanskrit": "युयुधे वासुदेवेन गदया यवनेश्वरः ।\nकृष्णोऽपि कदनं तेन कृत्वा चिरमनामयः ॥५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000903050, "chapter_id": 20903, "verse_number": "६-२४६-५१", "content_sanskrit": "विमुखः प्राद्रवत्तस्मात्संग्रामात्कमलेक्षणः ।\nसोनुयातोऽतिवेगेन तिष्ठतिष्ठेति चाब्रुवन् ॥५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000903051, "chapter_id": 20903, "verse_number": "६-२४६-५२", "content_sanskrit": "वेगात्कृष्णो गिरिगुहां प्रविवेश महामतिः ।\nतत्र प्रसुप्तो राजाऽसौ मुचुकुंदो महामुनिः ॥५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000903052, "chapter_id": 20903, "verse_number": "६-२४६-५३", "content_sanskrit": "अदृश्यस्तस्य नृपतेः संस्थितो भगवान्हरिः ।\nयवनोऽपि महावीरो गदामुद्यम्य पाणिना ॥५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000903053, "chapter_id": 20903, "verse_number": "६-२४६-५४", "content_sanskrit": "कृष्णं हंतु समारब्धो गुहां तां प्रविवेश ह ।\nदृष्ट्वा शयानं राजानं मत्वा कृष्णं जनार्दनम् ॥५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000903054, "chapter_id": 20903, "verse_number": "६-२४६-५५", "content_sanskrit": "पादेन ताडयामास मुचुकुंदं महामुनिम् ।\nततः प्रबुद्धो भगवान्मुचुकुंदो महामुनिः ॥५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000903055, "chapter_id": 20903, "verse_number": "६-२४६-५६", "content_sanskrit": "क्रोधात्संरक्तनयनो हुंकारं कृतवानसौ ।\nतस्य हुंकारशब्देन तथा क्रोधनिरीक्षणात् ॥५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000903056, "chapter_id": 20903, "verse_number": "६-२४६-५७", "content_sanskrit": "निर्दग्धो भस्मतां प्राप यवनस्त्यक्तजीवितः ।\nततस्तु कृष्णो ददृशे राजर्षेः पुरतः प्रभुः ॥५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000903057, "chapter_id": 20903, "verse_number": "६-२४६-५८", "content_sanskrit": "नीलोत्पलदलश्यामः पुंडरीकनिभेक्षणः ।\nशंखचक्रगदापाणिः पीतवासा जनार्दनः ॥५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000903058, "chapter_id": 20903, "verse_number": "६-२४६-५९", "content_sanskrit": "दृष्ट्वा तं सहसोत्थाय राजर्षिरमितौजसम् ।\nअहोभाग्यमहोभाग्यमित्युवाच महामुनिः ॥५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000903059, "chapter_id": 20903, "verse_number": "६-२४६-६०", "content_sanskrit": "पुलकांकितसर्वांगः सानंदाश्रुजलाकुलः ।\nस्तुवन्वै जयशब्देन प्रणनाम मुहुर्मुहुः ॥६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000903060, "chapter_id": 20903, "verse_number": "६-२४६-६१", "content_sanskrit": "मुचुकुंद उवाच ।\nधन्योस्मि कृतकृत्योस्मि दर्शनात्परमेश्वर ।\nअद्य मे सफलं जन्म जीवितं सफलं मम ॥६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000903061, "chapter_id": 20903, "verse_number": "६-२४६-६२", "content_sanskrit": "नमस्ते वासुदेवाय जगन्नाथाय शार्ङ्गिणे ।\nदामोदराय देवाय तेजसां निधये नमः ॥६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000903062, "chapter_id": 20903, "verse_number": "६-२४६-६३", "content_sanskrit": "अधोक्षजाय हरये नृसिंहवपुषे नमः ।\nराघवाय नमस्तुभ्यं पुंडरीकेक्षणाय च ॥६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000903063, "chapter_id": 20903, "verse_number": "६-२४६-६४", "content_sanskrit": "अच्युतायाविकाराय तथानंताय ते नमः ।\nगोविंदाय नमस्तुभ्यं विष्णवे जिष्णवे नमः ॥६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000903064, "chapter_id": 20903, "verse_number": "६-२४६-६५", "content_sanskrit": "नारायणाय श्रीशाय कृष्णाय परमात्मने ।\nमुकुंदाय नमस्तुभ्यं चतुर्व्यूहाय ते नमः ॥६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000903065, "chapter_id": 20903, "verse_number": "६-२४६-६६", "content_sanskrit": "नमः परमकल्याण नमस्ते परमात्मने ।\nवासुदेवाय शांताय यदूनां पतये नमः ॥६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000903066, "chapter_id": 20903, "verse_number": "६-२४६-६७", "content_sanskrit": "महेश्वर उवाच ।\nएवं स्तुत्वा तु गोविंदं प्रणनाम पुनः पुनः ।\nसंतुष्टो भगवान्प्राह मुचुकुंदं महामुनिम् ॥६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000903067, "chapter_id": 20903, "verse_number": "६-२४६-६८", "content_sanskrit": "श्रीभगवानुवाच ।\nवरं वृणीष्व राजर्षे यत्ते मनसि वर्त्तते ।\nमहेश्वर उवाच ।\nसोऽपि मुक्तिं ययाचाथ पुनरावृत्तिवर्जिताम् ॥६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000903068, "chapter_id": 20903, "verse_number": "६-२४६-६९", "content_sanskrit": "तस्मै ददौ तदा कृष्णो दिव्यं लोकं सनातनम् ।\nराजा तु मानुषं रूपं विहायाथ महामतिः ॥६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000903069, "chapter_id": 20903, "verse_number": "६-२४६-७०", "content_sanskrit": "समानं रूपमास्थाय देवस्य परमात्मनः ।\nवैनतेयं समारुह्य शाश्वतं पदमाविशत् ॥७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}]