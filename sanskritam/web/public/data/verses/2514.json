[{"id": 2071771, "chapter_id": 2514, "verse_number": "१२-१९-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2071772, "chapter_id": 2514, "verse_number": "१२-१९-१", "content_sanskrit": "वेदाहं तात शास्त्राणि अपराणि पराणि च।\nउभयं वेदवचनं कुरु कर्म त्यजेति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2071773, "chapter_id": 2514, "verse_number": "१२-१९-२", "content_sanskrit": "आकुलानि च शास्त्राणि हेतुभिश्चिन्तितानि च।\nनिश्चयश्चैव यो मन्त्रे वेदाहं तं यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2071774, "chapter_id": 2514, "verse_number": "१२-१९-३", "content_sanskrit": "त्वं तु केवलशास्त्रज्ञो वीरव्रतसमन्वितः।\nशास्त्रार्थं तत्त्वतो गन्तुं न समर्थः कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2071775, "chapter_id": 2514, "verse_number": "१२-१९-४", "content_sanskrit": "शास्त्रार्थतत्त्वदर्शी यो धर्मनिश्चयकोविदः।\nतेनाप्येवं न वाच्योऽयं यदि धर्मं प्रपश्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2071776, "chapter_id": 2514, "verse_number": "१२-१९-५", "content_sanskrit": "भ्रातृसौहृदमास्थाय यदुक्तं वचनं त्वया।\nन्याय्यं युक्तं च कौन्तेय प्रीतोऽहं तेन तेऽर्जुन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2071777, "chapter_id": 2514, "verse_number": "१२-१९-६", "content_sanskrit": "`महेश्वरसमं सत्वं ब्रह्मणा चैव यत्समम्।\nवासुदेवसमं चैव न भूतं न भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2071778, "chapter_id": 2514, "verse_number": "१२-१९-७", "content_sanskrit": "तथा त्वं योधमुख्येषु सत्वं परममिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2071779, "chapter_id": 2514, "verse_number": "१२-१९-८", "content_sanskrit": "बलमिन्द्रे च वायौ च बलं यच्च जनार्दने।\nतद्वलं भीमसेने च त्वयि चार्जुना विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2071780, "chapter_id": 2514, "verse_number": "१२-१९-९", "content_sanskrit": "त्वत्समश्चित्रयोधी च दूरपाती च पाण्डव।\nदिव्यास्त्रबलसंपन्नः को वाऽन्यस्त्वत्समो नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2071781, "chapter_id": 2514, "verse_number": "१२-१९-१०", "content_sanskrit": "युद्धधर्मेषु सर्वेषु क्रियाणां नैपुणेषु च।\nन त्वया सदृशः कश्चिन्त्रिषु लोकेषु विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2071782, "chapter_id": 2514, "verse_number": "१२-१९-११", "content_sanskrit": "धार्मिकं धर्मयुक्तं च निःशेषं ज्ञायते मया।\nधर्मसूक्ष्मं तु यद्वाच्यं तत्र दुष्प्रतरं त्वया।\nधनञ्जय न मे बुद्धिमतिशङ्कितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2071783, "chapter_id": 2514, "verse_number": "१२-१९-१२", "content_sanskrit": "युद्धशास्त्रविदेव त्वं न वृद्धाः सेवितास्त्वया।\nसमासविस्तरविदां न तेषां वेत्सि निश्चयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2071784, "chapter_id": 2514, "verse_number": "१२-१९-१३", "content_sanskrit": "तपस्त्यागो विधिरिति निश्चयस्तात धीमताम्।\nपरस्परं ज्याय एषामिति नः श्रेयसी मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2071785, "chapter_id": 2514, "verse_number": "१२-१९-१४", "content_sanskrit": "यत्त्वेतन्मन्यसे पार्थ न ज्यायोऽस्ति धनादिति।\nतत्र ते वर्तयिष्यामि यथा नैतत्प्रधानतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2071786, "chapter_id": 2514, "verse_number": "१२-१९-१५", "content_sanskrit": "तपः स्वाध्यायशीला हि दृश्यन्ते धार्मिका जनाः।\nऋषयस्तपसा युक्ता येषां लोकाः सनातनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2071787, "chapter_id": 2514, "verse_number": "१२-१९-१६", "content_sanskrit": "अजातश्मश्रवो धीरास्तथाऽन्ये वनवासिनः।\nअरुणाः केतवश्चैव स्वाध्यायेन दिवं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2071788, "chapter_id": 2514, "verse_number": "१२-१९-१७", "content_sanskrit": "उत्तरेण तु पन्थानमार्या विषयनिग्रहात्।\nअबुद्धिजं तमस्त्यक्त्वा लोकांस्त्यागवतां गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2071789, "chapter_id": 2514, "verse_number": "१२-१९-१८", "content_sanskrit": "दक्षिणेन तु पन्थानं यं भास्वन्तं प्रचक्षते।\nएते क्रियावतां लोका ये श्मशानानि भेजिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2071790, "chapter_id": 2514, "verse_number": "१२-१९-१९", "content_sanskrit": "अनिर्देश्या गतिः सा तु यां प्रपश्यन्ति मोक्षिणः।\nतस्मात्त्यागः प्रधानेष्टः स तु दुःखं प्रवेदितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2071791, "chapter_id": 2514, "verse_number": "१२-१९-२०", "content_sanskrit": "अनुस्मृत्य तु शास्त्राणि कवयः समवस्थिताः।\nअपीह स्यादपीह स्यात्सारासारदिदृक्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2071792, "chapter_id": 2514, "verse_number": "१२-१९-२१", "content_sanskrit": "वेदवादानतिक्रम्य शास्त्राण्यारण्यकानि च।\nविपाट्य कदलीस्तम्भं सारं ददृशिरे न ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2071793, "chapter_id": 2514, "verse_number": "१२-१९-२२", "content_sanskrit": "अथैकान्तव्युदासेन शरीरे पाञ्चभौतिके।\nइच्छाद्वेषसमायुक्तमात्मानं प्राहुरिङ्गितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2071794, "chapter_id": 2514, "verse_number": "१२-१९-२३", "content_sanskrit": "अग्राह्यं चक्षुषा सत्वमनिर्देश्यं च तद्गिरा।\nकर्महेतुपुरस्कारं भूतेषु पस्विर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2071795, "chapter_id": 2514, "verse_number": "१२-१९-२४", "content_sanskrit": "कल्याणगोचरं कृत्वा मानं तृष्णां निगृह्य च।\nकर्मसंततिमुत्सृज्य स्यान्निरालम्बनः सुखी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2071796, "chapter_id": 2514, "verse_number": "१२-१९-२५", "content_sanskrit": "अस्मिन्नेवं सूक्ष्मगम्ये मार्गे सद्भिर्निषेविते।\nकथमर्थमनर्थाढ्यमर्जुन त्वं प्रशंससि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2071797, "chapter_id": 2514, "verse_number": "१२-१९-२६", "content_sanskrit": "पूर्वशास्त्रविदोऽप्येवं जनाः पश्यन्ति भारत।\nक्रियासु निरता नित्यं दाने यज्ञे च कर्मणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2071798, "chapter_id": 2514, "verse_number": "१२-१९-२७", "content_sanskrit": "भवन्ति सुदुरावर्ता हेतुमन्तोऽपि पण्डिताः।\nदृढपूर्वे स्मृता मूढा नैतदस्तीति वादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2071799, "chapter_id": 2514, "verse_number": "१२-१९-२८", "content_sanskrit": "अनृतस्यावमन्तारो वक्तारो जनसंसदि।\nचरन्ति वसुधां कृत्स्नां वावदूका बहुश्रुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2071800, "chapter_id": 2514, "verse_number": "१२-१९-२९", "content_sanskrit": "पार्थ यन्न विजानीमः कस्ताञ्ज्ञातुमिहार्हति।\nएवं प्राज्ञाः श्रुताश्चापि महान्तः शास्त्रवित्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2071801, "chapter_id": 2514, "verse_number": "१२-१९-३०", "content_sanskrit": "तपसा महदाप्नोति बुद्ध्या वै विन्दते महत्।\nत्यागेन सुखमाप्नोति सदा कौन्तेय धर्मवित्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2071802, "chapter_id": 2514, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि एकोनविंशोऽध्यायः॥ १९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]