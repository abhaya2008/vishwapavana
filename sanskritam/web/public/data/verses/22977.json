[{"id": 7002977000, "chapter_id": 22977, "verse_number": "२-२४-१", "content_sanskrit": "नारायण उवाच ।\nस्तुत्वा सोऽश्वपतिस्तेन संपूज्य विधिपूर्वकम् ।\nददर्श तत्र तां देवीं सहस्रार्कसमप्रभाम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002977001, "chapter_id": 22977, "verse_number": "२-२४-२", "content_sanskrit": "उवाच सा तं राजानं प्रसन्ना सस्मिता सती ।\nयथा माता स्वपुत्रं च द्योतयन्ती दिशस्त्विषा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002977002, "chapter_id": 22977, "verse_number": "२-२४-३", "content_sanskrit": "सावित्र्युवाच ।\nजानामि ते महाराज यत्ते मनसि वर्त्तते ।\nवाञ्छितं तव पत्न्याश्च सर्वं दास्यामि निश्चितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002977003, "chapter_id": 22977, "verse_number": "२-२४-४", "content_sanskrit": "साध्वी कन्याभिलाषं च करोति तव कामिनी ।\nत्वं प्रार्थयसि पुत्रं च भविष्यति च ते क्रमात् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002977004, "chapter_id": 22977, "verse_number": "२-२४-५", "content_sanskrit": "इत्युक्त्वा सा महादेवी ब्रह्मलोकं जगाम ह ।\nराजा जगाम स्वगृहं तत्कन्याऽऽदौ बभूव ह ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002977005, "chapter_id": 22977, "verse_number": "२-२४-६", "content_sanskrit": "राज्ञो धनाच्च सावित्र्या बभूव कमला कला ।\nसावित्रीति च तन्नाम चकाराश्वपतिर्नृपः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002977006, "chapter_id": 22977, "verse_number": "२-२४-७", "content_sanskrit": "कालेन सा वर्द्धमाना बभूव च दिने दिने ।\nरूपयौवनसम्पन्ना शुक्ले चन्द्रकला यथा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002977007, "chapter_id": 22977, "verse_number": "२-२४-८", "content_sanskrit": "सा वरं वरयामास द्युमत्सेनात्मजं तदा ।\nसावित्री सत्यवन्तं च नानागुणसमन्वितम्॥ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002977008, "chapter_id": 22977, "verse_number": "२-२४-९", "content_sanskrit": "राजा तस्मै ददौ तां च रत्नभूषणभूषिताम् ।\nस च सार्धं कौतुकेन तां गृहीत्वा गृहं ययौ ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002977009, "chapter_id": 22977, "verse_number": "२-२४-१०", "content_sanskrit": "स च संवत्सरेऽतीते सत्यवान्सत्यविक्रमः ।\nजगाम फलकाष्ठार्थं प्रहर्षं पितुराज्ञया ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002977010, "chapter_id": 22977, "verse_number": "२-२४-११", "content_sanskrit": "जगाम तत्र सावित्री तत्पश्चाद्दैवयोगतः ।\nनिपत्य वृक्षाद्दैवेन प्राणांस्तत्याज सत्यवान् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002977011, "chapter_id": 22977, "verse_number": "२-२४-१२", "content_sanskrit": "यमस्तज्जीवपुरुषं बद्ध्वाङ्गुष्ठसमं मुने ।\nगृहीत्वा गमनं चक्रे तत्पश्चात्प्रययौ सती ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002977012, "chapter_id": 22977, "verse_number": "२-२४-१३", "content_sanskrit": "पश्चात्तां सुन्दरीं दृष्ट्वा यमः संयमिनीपतिः ।\nउवाच मधुरं साध्वीं साधूनां प्रवरो महान् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002977013, "chapter_id": 22977, "verse_number": "२-२४-१४", "content_sanskrit": "यम उवाच ।\nअहो क्व यासि सावित्रि गृहीत्वा मानुषीं तनुम् ।\nयदि यास्यसि कान्तेन सार्धं देहं तदा त्यज ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002977014, "chapter_id": 22977, "verse_number": "२-२४-१५", "content_sanskrit": "गन्तुं मर्त्त्यो न शक्नोति गृहीत्वा पाञ्चभौतिकम् ।\nदेहं च यमलोकं च नश्वरं नश्वरः सदाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002977015, "chapter_id": 22977, "verse_number": "२-२४-१६", "content_sanskrit": "पूर्णश्च भर्त्तुस्ते कालः ह्यभवद्भारते सति ।\nस कर्मफलभोगार्थं सत्यवान्याति मद्गृहम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002977016, "chapter_id": 22977, "verse_number": "२-२४-१७", "content_sanskrit": "कर्मणा जायते जन्तुः कर्मणैव प्रलीयते ।\nसुखं दुःखं भयं शोकं कर्मणैव प्रपद्यते ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002977017, "chapter_id": 22977, "verse_number": "२-२४-१८", "content_sanskrit": "कर्मणेन्द्रो भवेज्जीवो ब्रह्मपुत्रः स्वकर्मणा ।\nस्वकर्मणा हरेर्दासो जन्मादिरहितो भवेत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002977018, "chapter_id": 22977, "verse_number": "२-२४-१९", "content_sanskrit": "स्वकर्मणा सर्वसिद्धिममरत्वं लभेद् ध्रुवम् ।\nलभेत्स्वकर्मणा विष्णोः सालोक्यादिचतुष्टयम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002977019, "chapter_id": 22977, "verse_number": "२-२४-२०", "content_sanskrit": "कर्मणा ब्राह्मणत्वं च मुक्तत्वं च स्वकर्मणा ।\nसुरत्वं च मनुत्वं च राजेन्द्रत्वं लभेन्नरः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002977020, "chapter_id": 22977, "verse_number": "२-२४-२१", "content_sanskrit": "कर्मणा च मुनीन्द्रत्वं तपस्वित्वं च कर्मणा ।\nकर्मणा क्षत्रियत्वं च वैश्यत्वं च स्वकर्मणा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002977021, "chapter_id": 22977, "verse_number": "२-२४-२२", "content_sanskrit": "कर्मणा चैव शूद्रत्वमन्त्यजत्वं स्वकर्मणा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002977022, "chapter_id": 22977, "verse_number": "२-२४-२३", "content_sanskrit": "स्वकर्मणा च म्लेच्छत्वं लभते नात्र संशयः ।\nस्वकर्मणा जङ्गमत्वं स्थावरत्वं स्वकर्मणा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002977023, "chapter_id": 22977, "verse_number": "२-२४-२४", "content_sanskrit": "स्वकर्मणा च शैलत्वं वृक्षत्वं च स्वकर्मणा ।\nस्वकर्मणा पशुत्वं च पक्षित्वं च स्वकर्मणा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002977024, "chapter_id": 22977, "verse_number": "२-२४-२५", "content_sanskrit": "स्वकर्मणा क्षुद्रजन्तुः कृमित्वं च स्वकर्मणा ।\nस्वकर्मणा च सर्पत्वं गन्धर्वत्वं स्वकर्मणा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002977025, "chapter_id": 22977, "verse_number": "२-२४-२६", "content_sanskrit": "स्वकर्मणा राक्षसत्वं किन्नरत्वं स्वकर्मणा ।\nस्वकर्मणा च यक्षत्वं कूष्माण्डत्वं स्वकर्मणा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002977026, "chapter_id": 22977, "verse_number": "२-२४-२७", "content_sanskrit": "स्वकर्मणा च प्रेतत्वं वेतालत्वं स्वकर्मणा ।\nभूतत्वं च पिशाचत्वं डाकिनीत्वं स्वकर्मणा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002977027, "chapter_id": 22977, "verse_number": "२-२४-२८", "content_sanskrit": "दैत्यत्वं दानवत्वं चाप्यसुरत्वं स्वकर्मणा ।\nकर्मणा पुण्यवाञ्जीवो महापापी स्वकर्मणा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002977028, "chapter_id": 22977, "verse_number": "२-२४-२९", "content_sanskrit": "कर्मणा सुन्दरोऽरोगी महारोगी च कर्मणा ।\nकर्मणा चान्धः काणश्च कुत्सितश्च स्वकर्मणा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002977029, "chapter_id": 22977, "verse_number": "२-२४-३०", "content_sanskrit": "कर्मणा नरकं यान्ति जीवाः स्वर्गं स्वकर्मणा ।\nकर्मणा शक्रलोकं च सूर्य्यलोकं स्वकर्मणा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002977030, "chapter_id": 22977, "verse_number": "२-२४-३१", "content_sanskrit": "कर्मणा चन्द्रलोकं च वह्निलोकं स्वकर्मणा ।\nकर्मणा वायुलोकं च कर्मणा वरुणालयम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002977031, "chapter_id": 22977, "verse_number": "२-२४-३२", "content_sanskrit": "तथा कुबेरलोकं च नरो याति स्वकर्मणा ।\nकर्मणा ध्रुवलोकं च शिवलोकं स्वकर्मणा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002977032, "chapter_id": 22977, "verse_number": "२-२४-३३", "content_sanskrit": "याति नक्षत्रलोकं च सत्यलोकं स्वकर्मणा ।\nजनोलोकं तपोलोकं महर्लोकं स्वकर्मणा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002977033, "chapter_id": 22977, "verse_number": "२-२४-३४", "content_sanskrit": "स्वकर्मणा च पातालं ब्रह्मलोकं स्वकर्मणा ।\nकर्मणा भारतं पुण्यं सर्वेप्सितवरप्रदम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002977034, "chapter_id": 22977, "verse_number": "२-२४-३५", "content_sanskrit": "कर्मणा याति वैकुण्ठं गोलोकं च निरामयम् ।\nकर्मणा चिरजीवी च क्षणायुश्च स्वकर्मणा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002977035, "chapter_id": 22977, "verse_number": "२-२४-३६", "content_sanskrit": "कर्मणा कोटिकल्पायुः क्षीणायुश्च स्वकर्मणा ।\nजीवसंचारमात्रायुर्गर्भे मृत्युः स्वकर्मणा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002977036, "chapter_id": 22977, "verse_number": "२-२४-३७", "content_sanskrit": "इत्येवं कथितं सर्वं मया तत्त्वं च सुन्दरि ।\nकर्मणा ते मृतो भर्त्ता गच्छ वत्से यथासुखम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]