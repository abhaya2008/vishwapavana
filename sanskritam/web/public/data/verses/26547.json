[{"id": 7006547000, "chapter_id": 26547, "verse_number": "३-८६-१", "content_sanskrit": "पिशाचैः, मुनिभिः अप्सरोभिश्च साकं उमासहितस्य भगवतः शङ्करस्य श्रीकृष्णस्य समीपे गमनम् वैशम्पायन उवाच तस्याग्रे समपद्यन्त भूतसंघाः सहस्रशः ।\nघण्टाकर्णो विरूपाक्षः कुण्डधार कुमुद्वहः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006547001, "chapter_id": 26547, "verse_number": "३-८६-२", "content_sanskrit": "दीर्घरोमा दीर्घभुजो दीर्घबाहुर्निरञ्जनः ।\nउरुनेत्रः शतमुखः शतग्रीवः शतोदरः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006547002, "chapter_id": 26547, "verse_number": "३-८६-३", "content_sanskrit": "कुण्डोदरो महाग्रीवः स्थूलजिह्वो द्विबाहुकः ।\nपार्श्ववक्त्रः सिंहमुख उन्नतांसो महाहनुः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006547003, "chapter_id": 26547, "verse_number": "३-८६-४", "content_sanskrit": "त्रिबाहुः पञ्चबाहुश्च व्याघ्रवक्त्रः सिताननः ।\nएते चान्ये च बहवो दीर्घास्या दीर्घलोचनाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006547004, "chapter_id": 26547, "verse_number": "३-८६-५", "content_sanskrit": "नृत्यन्तः प्रहसन्तश्च स्फोटयन्तः परस्परम् ।\nतथान्ये घोररूपाश्च तथान्ये विकृताननाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006547005, "chapter_id": 26547, "verse_number": "३-८६-६", "content_sanskrit": "प्रेतभक्षाः प्रेतवाहा मांसशोणितभोजनाः ।\nशवानि सुबहून्याशु भक्षयन्तस्ततस्ततः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006547006, "chapter_id": 26547, "verse_number": "३-८६-७", "content_sanskrit": "पिबन्तो रुधिरं घोरं खण्डयन्तः शवान् बहून् ।\nकराला वितता दीर्घा धमनिस्नायुसंतताः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006547007, "chapter_id": 26547, "verse_number": "३-८६-८", "content_sanskrit": "नानाविधाः सुवीराश्च शूलाग्रप्रोतमानुषाः ।\nशिरोमालावृताः केचिदान्त्रपाशावपाशिताः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006547008, "chapter_id": 26547, "verse_number": "३-८६-९", "content_sanskrit": "डिण्डिमैरट्टहासैश्च नादयन्तो वसुन्धराम् ।\nकपालिनो भैरवाश्च जटिला मुण्डिनस्तथा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006547009, "chapter_id": 26547, "verse_number": "३-८६-१०", "content_sanskrit": "एवं बहुविधा घोराः पिशाचा विकृताननाः ।\nतथान्ये मुनिवीराश्च ध्यायन्तः परमेश्वरम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006547010, "chapter_id": 26547, "verse_number": "३-८६-११", "content_sanskrit": "पठन्तो वेदवाक्यानि साङ्गानि विविधानि च ।\nकुण्डि=कास्थकराः केचित्केचित्कुशविचारिणः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006547011, "chapter_id": 26547, "verse_number": "३-८६-१२", "content_sanskrit": "कौपीनवसनाः केचित् केचित् कार्पाससंवृताः ।\nस्तुवन्तः शंकरं भक्त्या स्तोत्रैर्माहेश्वरैस्तथा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006547012, "chapter_id": 26547, "verse_number": "३-८६-१३", "content_sanskrit": "एकत्र ते मुनिगणा अपरत्र गणास्तथा ।\nअन्यत्र सिद्धगन्धर्वाः प्रियाभिः सह संगताः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006547013, "chapter_id": 26547, "verse_number": "३-८६-१४", "content_sanskrit": "नृत्यन्ति नृत्यकुशला गायन्ति स्म च कन्यकाः ।\nविद्याधरास्तथान्यत्र स्तुवन्तः शंकरं शिवम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006547014, "chapter_id": 26547, "verse_number": "३-८६-१५", "content_sanskrit": "ननृतुस्तस्य पुरतो गच्छन्तोऽप्सरसां गणाः ।\nएवमेतैर्महाघोरैः पिशाचैर्भूतकिन्नरैः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006547015, "chapter_id": 26547, "verse_number": "३-८६-१६", "content_sanskrit": "मुनिभिश्चैव प्रमथैः समं शर्वः समाययौ ।\nयत्र विश्वेश्वरो विष्णुस्तपस्तेपे सुदारुणम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006547016, "chapter_id": 26547, "verse_number": "३-८६-१७", "content_sanskrit": "यत्र ते लोकपालाश्च तिष्ठन्ति स्म दिदृक्षया ।\nउमया लोकभाविन्या गङ्गया चन्द्रशेखरः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006547017, "chapter_id": 26547, "verse_number": "३-८६-१८", "content_sanskrit": "स सर्वलोकप्रभवो भवो विभुर्जटी च साक्षात् प्रणवात्मकः कृती ।\nद्रष्टुं हरिं विष्णुमुदारविक्रमो ययौ यथेष्टं पिशिताशनैर्वृतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]