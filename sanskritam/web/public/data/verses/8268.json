 "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 900002621, "chapter_id": 8268, "verse_number": "2.122", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 900002622, "chapter_id": 8268, "verse_number": "2.123", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 900002623, "chapter_id": 8268, "verse_number": "2.124", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 900002624, "chapter_id": 8268, "verse_number": "2.125", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 900002625, "chapter_id": 8268, "verse_number": "2.126", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 900002626, "chapter_id": 8268, "verse_number": "2.127", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 900002627, "chapter_id": 8268, "verse_number": "2.128", "content_sanskrit": "कर्मजं बुद्धियुक्ता हि फलं त्यक्त्वा मनीषिणः ।। जन्मबन्धविनिर्मुक्ताः पदं गच्छन्त्यनामयम्।। ५१ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 900002628, "chapter_id": 8268, "verse_number": "2.129", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 900002629, "chapter_id": 8268, "verse_number": "2.130", "content_sanskrit": "यदा ते मोहकलिलं बुद्धिर्व्यतितरिष्यति । तदा गन्ताऽसि निर्वेदं श्रोतव्यस्य श्रुतस्य च ।। ५२ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 900002630, "chapter_id": 8268, "verse_number": "2.131", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 900002631, "chapter_id": 8268, "verse_number": "2.132", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 900002632, "chapter_id": 8268, "verse_number": "2.133", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 900002633, "chapter_id": 8268, "verse_number": "2.134", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 900002634, "chapter_id": 8268, "verse_number": "2.135", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 900002635, "chapter_id": 8268, "verse_number": "2.136", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 900002636, "chapter_id": 8268, "verse_number": "2.137", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 900002637, "chapter_id": 8268, "verse_number": "2.138", "content_sanskrit": "श्रुतिविप्रतिपन्ना ते यथा स्थास्यति निश्चला । समाधावचला बुद्धिस्तदा योगमवाप्स्यसि ।। ५३ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 900002638, "chapter_id": 8268, "verse_number": "2.139", "content_sanskrit": "स्थितप्रज्ञस्य का भाषा समाधिस्थस्य केशव । स्थितधीः किं प्रभाषेत किमासीत व्रजेत किम् ।। ५४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 900002639, "chapter_id": 8268, "verse_number": "2.140", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 900002640, "chapter_id": 8268, "verse_number": "2.141", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 900002641, "chapter_id": 8268, "verse_number": "2.142", "content_sanskrit": "प्रजहाति यदा कामान् सर्वान् पार्थ मनोगतान् । आत्मन्येवाऽत्मना तुष्टः स्थितप्रज्ञस्तदोच्यते ।। ५५ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 900002642, "chapter_id": 8268, "verse_number": "2.143", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 900002643, "chapter_id": 8268, "verse_number": "2.144", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 900002644, "chapter_id": 8268, "verse_number": "2.145", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 900002645, "chapter_id": 8268, "verse_number": "2.146", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 900002646, "chapter_id": 8268, "verse_number": "2.147", "content_sanskrit": "दुःखेष्वनुद्विग्नमनाः सुखेषु विगतस्पृहः । वीतरागभयक्रोधः स्थितधीर्मुनिरुच्यते ।। ५६ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 900002647, "chapter_id": 8268, "verse_number": "2.148", "content_sanskrit": "यः सर्वत्रानभिस्नेहः तत्तत् प्राप्य शुभाशुभम् । नाभिनन्दति न द्वेष्टि तस्य प्रज्ञा प्रतिष्ठिता।। ५७ ।। यदा संहरते चायं कूर्मोऽङ्गानीव सर्वशः । इन्द्रियाणीन्द्रियार्थेभ्यस्तस्य प्रज्ञा प्रतिष्ठिता ।। ५८ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 900002648, "chapter_id": 8268, "verse_number": "2.149", "content_sanskrit": "विषया विनिवर्तन्ते निराहारस्य देहिनः । रसवर्जं रसोऽप्यस्य परं दृष्ट्वा निवर्तते ।। ५९ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 900002649, "chapter_id": 8268, "verse_number": "2.150", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 900002650, "chapter_id": 8268, "verse_number": "2.151", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}, {"id": 900002651, "chapter_id": 8268, "verse_number": "2.152", "content_sanskrit": "यततो ह्यपि कौन्तेय पुरुषस्य विजानतः । इन्द्रियाणि प्रमाथीनि हरन्ति प्रसभं मनः ।। ६० ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 152}, {"id": 900002652, "chapter_id": 8268, "verse_number": "2.153", "content_sanskrit": "तानि सर्वाणि संयम्य युक्त आसीत मत्परः । वशे हि यस्येन्द्रियाणि तस्य प्रज्ञा प्रतिष्ठिता ।। ६१ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 153}, {"id": 900002653, "chapter_id": 8268, "verse_number": "2.154", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 154}, {"id": 900002654, "chapter_id": 8268, "verse_number": "2.155", "content_sanskrit": "ध्यायतो विषयान् पुंसः सङ्गस्तेषूपजायते । सङ्गात् सञ्जायते कामः कामात् क्रोधोऽभिजायते।। ६२ ।। क्रोधाद्भवति सम्मोहः सम्मोहात्स्मृतिविभ्रमः । स्मृतिभ्रंशाद् बुद्धिनाशो बुद्धिनाशाद् विनश्यति।। ६३ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 155}, {"id": 900002655, "chapter_id": 8268, "verse_number": "2.156", "content_sanskrit": "रागद्वेषवियुक्तैस्तु विषयानिन्द्रियैश्चरन् । आत्मवश्यैर्विधेयात्मा प्रसादमधिगच्छति ।। ६४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 156}, {"id": 900002656, "chapter_id": 8268, "verse_number": "2.157", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 157}, {"id": 900002657, "chapter_id": 8268, "verse_number": "2.158", "content_sanskrit": "प्रसादे सर्वदुःखानां हानिरस्योपजायते । प्रसन्नचेतसो ह्याशु बुद्धिः पर्यवतिष्ठते ।। ६५ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 158}, {"id": 900002658, "chapter_id": 8268, "verse_number": "2.159", "content_sanskrit": "नास्ति बुद्धिरयुक्तस्य न चायुक्तस्य भावना । नचाभावयतः शान्तिरशान्तस्य कुतः सुखम् ।। ६६ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 159}, {"id": 900002659, "chapter_id": 8268, "verse_number": "2.160", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 160}, {"id": 900002660, "chapter_id": 8268, "verse_number": "2.161", "content_sanskrit": "इन्द्रियाणां हि चरतां यन्मनोऽनुविधीयते । तदस्य हरति प्रज्ञां वायुर्नावमिवाम्भसि ।। ६७ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 161}, {"id": 900002661, "chapter_id": 8268, "verse_number": "2.162", "content_sanskrit": "तस्माद्यस्य महाबाहो निगृहीतानि सर्वशः । इन्द्रियाणीन्द्रियार्थेभ्यस्तस्य प्रज्ञा प्रतिष्ठिता ।। ६८ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 162}, {"id": 900002662, "chapter_id": 8268, "verse_number": "2.163", "content_sanskrit": "या निशा सर्वभूतानां तस्यां जागर्ति संयमी ।। यस्यां जाग्रति भूतानि सा निशा पश्यतो मुनेः ।। ६९ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 163}, {"id": 900002663, "chapter_id": 8268, "verse_number": "2.164", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 164}, {"id": 900002664, "chapter_id": 8268, "verse_number": "2.165", "content_sanskrit": "आपूर्यमाणमचलप्रतिष्ठं समुद्रमापः प्रवहन्ति यद्वत् ।। तद्वत् कामा यं प्रविशन्ति सर्वे स शान्तिमाप्नोति न कामकामी ।। ७० ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 165}, {"id": 900002665, "chapter_id": 8268, "verse_number": "2.166", "content_sanskrit": "विहाय कामान् यः सर्वान् पुमांश्चरति निस्पृहः । निर्ममो निरहङ्कारः स शान्तिमधिगच्छति।। ७१ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 166}, {"id": 900002666, "chapter_id": 8268, "verse_number": "2.167", "content_sanskrit": "एषा ब्राह्मी स्थितिः पार्थ नैनां प्राप्य विमुह्यति । स्थित्वाऽस्यामन्तकालेऽपि ब्रह्म निर्वाणमृच्छति।। ७२ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 167}, {"id": 900002667, "chapter_id": 8268, "verse_number": "2.168", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 168}, {"id": 900002668, "chapter_id": 8268, "verse_number": "2.169", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 169}, {"id": 900002669, "chapter_id": 8268, "verse_number": "2.170", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 170}, {"id": 900002670, "chapter_id": 8268, "verse_number": "2.171", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 171}, {"id": 900002671, "chapter_id": 8268, "verse_number": "2.172", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 172}, {"id": 900002672, "chapter_id": 8268, "verse_number": "2.173", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 173}, {"id": 900002673, "chapter_id": 8268, "verse_number": "2.174", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 174}, {"id": 900002674, "chapter_id": 8268, "verse_number": "2.175", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 175}, {"id": 900002675, "chapter_id": 8268, "verse_number": "2.176", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 176}, {"id": 900002676, "chapter_id": 8268, "verse_number": "2.177", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 177}]