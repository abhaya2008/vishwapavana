[{"id": 5000213000, "chapter_id": 9213, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे सप्तदशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000213001, "chapter_id": 9213, "verse_number": "३-१७-१", "content_sanskrit": "कृताभिषेको रामस्तु सीता सौमित्रिरेव च।\nतस्माद् गोदावरीतीरात् ततो जग्मुः स्वमाश्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000213002, "chapter_id": 9213, "verse_number": "३-१७-२", "content_sanskrit": "आश्रमं तमुपागम्य राघवः सहलक्ष्मणः।\nकृत्वा पौर्वाह्णिकं कर्म पर्णशालामुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000213003, "chapter_id": 9213, "verse_number": "३-१७-३", "content_sanskrit": "उवास सुखितस्तत्र पूज्यमानो महर्षिभिः।\nस रामः पर्णशालायामासीनः सह सीतया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000213004, "chapter_id": 9213, "verse_number": "३-१७-४", "content_sanskrit": "विरराज महाबाहुश्चित्रया चन्द्रमा इव।\nलक्ष्मणेन सह भ्रात्रा चकार विविधाः कथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000213005, "chapter_id": 9213, "verse_number": "३-१७-५", "content_sanskrit": "तदासीनस्य रामस्य कथासंसक्तचेतसः।\nतं देशं राक्षसी काचिदाजगाम यदृच्छया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000213006, "chapter_id": 9213, "verse_number": "३-१७-६", "content_sanskrit": "सा तु शूर्पणखा नाम दशग्रीवस्य रक्षसः।\nभगिनी राममासाद्य ददर्श त्रिदशोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000213007, "chapter_id": 9213, "verse_number": "३-१७-७", "content_sanskrit": "दीप्तास्यं च महाबाहुं पद्मपत्रायतेक्षणम्।\nगजविक्रान्तगमनं जटामण्डलधारिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000213008, "chapter_id": 9213, "verse_number": "३-१७-८", "content_sanskrit": "सुकुमारं महासत्त्वं पार्थिवव्यञ्जनान्वितम्।\nराममिन्दीवरश्यामं कंदर्पसदृशप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000213009, "chapter_id": 9213, "verse_number": "३-१७-९", "content_sanskrit": "बभूवेन्द्रोपमं दृष्ट्वा राक्षसी काममोहिता।\nसुमुखं दुर्मुखी रामं वृत्तमध्यं महोदरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000213010, "chapter_id": 9213, "verse_number": "३-१७-१०", "content_sanskrit": "विशालाक्षं विरूपाक्षी सुकेशं ताम्रमूर्धजा।\nप्रियरूपं विरूपा सा सुस्वरं भैरवस्वना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000213011, "chapter_id": 9213, "verse_number": "३-१७-११", "content_sanskrit": "तरुणं दारुणा वृद्धा दक्षिणं वामभाषिणी।\nन्यायवृत्तं सुदुर्वृत्ता प्रियमप्रियदर्शना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000213012, "chapter_id": 9213, "verse_number": "३-१७-१२", "content_sanskrit": "शरीरजसमाविष्टा राक्षसी राममब्रवीत्।\nजटी तापसवेषेण सभार्यः शरचापधृक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000213013, "chapter_id": 9213, "verse_number": "३-१७-१३", "content_sanskrit": "आगतस्त्वमिमं देशं कथं राक्षससेवितम्।\nकिमागमनकृत्यं ते तत्त्वमाख्यातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000213014, "chapter_id": 9213, "verse_number": "३-१७-१४", "content_sanskrit": "एवमुक्तस्तु राक्षस्या शूर्पणख्या परंतपः।\nऋजुबुद्धितया सर्वमाख्यातुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000213015, "chapter_id": 9213, "verse_number": "३-१७-१५", "content_sanskrit": "आसीद् दशरथो नाम राजा त्रिदशविक्रमः।\nतस्याहमग्रजः पुत्रो रामो नाम जनैः श्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000213016, "chapter_id": 9213, "verse_number": "३-१७-१६", "content_sanskrit": "भ्रातायं लक्ष्मणो नाम यवीयान् मामनुव्रतः।\nइयं भार्या च वैदेही मम सीतेति विश्रुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000213017, "chapter_id": 9213, "verse_number": "३-१७-१७", "content_sanskrit": "नियोगात् तु नरेन्द्रस्य पितुर्मातुश्च यन्त्रितः।\nधर्मार्थं धर्मकांक्षी च वनं वस्तुमिहागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000213018, "chapter_id": 9213, "verse_number": "३-१७-१८", "content_sanskrit": "त्वां तु वेदितुमिच्छामि कस्य त्वं कासि कस्य वा।\nत्वं हि तावन्मनोज्ञाङ्गी राक्षसी प्रतिभासि मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000213019, "chapter_id": 9213, "verse_number": "३-१७-१९", "content_sanskrit": "इह वा किंनिमित्तं त्वमागता ब्रूहि तत्त्वतः।\nसाब्रवीद् वचनं श्रुत्वा राक्षसी मदनार्दिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000213020, "chapter_id": 9213, "verse_number": "३-१७-२०", "content_sanskrit": "श्रूयतां राम तत्त्वार्थं वक्ष्यामि वचनं मम।\nअहं शूर्पणखा नाम राक्षसी कामरूपिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000213021, "chapter_id": 9213, "verse_number": "३-१७-२१", "content_sanskrit": "अरण्यं विचरामीदमेका सर्वभयंकरा।\nरावणो नाम मे भ्राता यदि ते श्रोत्रमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000213022, "chapter_id": 9213, "verse_number": "३-१७-२२", "content_sanskrit": "वीरो विश्रवसः पुत्रो यदि ते श्रोत्रमागतः।\nप्रवृद्धनिद्रश्च सदा कुम्भकर्णो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000213023, "chapter_id": 9213, "verse_number": "३-१७-२३", "content_sanskrit": "विभीषणस्तु धर्मात्मा न तु राक्षसचेष्टितः।\nप्रख्यातवीर्यौ च रणे भ्रातरौ खरदूषणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000213024, "chapter_id": 9213, "verse_number": "३-१७-२४", "content_sanskrit": "तानहं समतिक्रान्तां राम त्वापूर्वदर्शनात्।\nसमुपेतास्मि भावेन भर्तारं पुरुषोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000213025, "chapter_id": 9213, "verse_number": "३-१७-२५", "content_sanskrit": "अहं प्रभावसम्पन्ना स्वच्छन्दबलगामिनी।\nचिराय भव भर्ता मे सीतया किं करिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000213026, "chapter_id": 9213, "verse_number": "३-१७-२६", "content_sanskrit": "विकृता च विरूपा च न सेयं सदृशी तव।\nअहमेवानुरूपा ते भार्यारूपेण पश्य माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000213027, "chapter_id": 9213, "verse_number": "३-१७-२७", "content_sanskrit": "इमां विरूपामसतीं करालां निर्णतोदरीम्।\nअनेन सह ते भ्रात्रा भक्षयिष्यामि मानुषीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000213028, "chapter_id": 9213, "verse_number": "३-१७-२८", "content_sanskrit": "ततः पर्वतशृङ्गाणि वनानि विविधानि च।\nपश्यन् सह मया कामी दण्डकान् विचरिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000213029, "chapter_id": 9213, "verse_number": "३-१७-२९", "content_sanskrit": "इत्येवमुक्तः काकुत्स्थः प्रहस्य मदिरेक्षणाम्।\nइदं वचनमारेभे वक्तुं वाक्यविशारदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000213030, "chapter_id": 9213, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे सप्तदशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]