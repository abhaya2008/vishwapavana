[{"id": 5000026000, "chapter_id": 9026, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकीयरामायणे बालकाण्डे षड्विंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000026001, "chapter_id": 9026, "verse_number": "१-२६-१", "content_sanskrit": "मुनेर्वचनमक्लीबं श्रुत्वा नरवरात्मजः ।\nराघवः प्राञ्जलिर्भूत्वा प्रत्युवाच दृढव्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000026002, "chapter_id": 9026, "verse_number": "१-२६-२", "content_sanskrit": "पितुर्वचननिर्देशात् पितुर्वचनगौरवात् ।\nवचनं कौशिकस्येति कर्तव्यमविशङ्कया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000026003, "chapter_id": 9026, "verse_number": "१-२६-३", "content_sanskrit": "अनुशिष्टोऽस्म्ययोध्यायां गुरुमध्ये महात्मना ।\nपित्रा दशरथेनाहं नावज्ञेयं हि तद्वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000026004, "chapter_id": 9026, "verse_number": "१-२६-४", "content_sanskrit": "सोऽहं पितुर्वचः श्रुत्वा शासनाद् ब्रह्मवादिनः ।\nकरिष्यामि न संदेहस्ताटकावधमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000026005, "chapter_id": 9026, "verse_number": "१-२६-५", "content_sanskrit": "गोब्राह्मणहितार्थाय देशस्य च हिताय च ।\nतव चैवाप्रमेयस्य वचनं कर्तुमुद्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000026006, "chapter_id": 9026, "verse_number": "१-२६-६", "content_sanskrit": "एवमुक्त्वा धनुर्मध्ये बद्ध्वा मुष्टिमरिन्दमः ।\nज्याघोषमकरोत् तीव्रं दिशः शब्देन नादयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000026007, "chapter_id": 9026, "verse_number": "१-२६-७", "content_sanskrit": "तेन शब्देन वित्रस्तास्ताटकावनवासिनः ।\nताटका च सुसंक्रुद्धा तेन शब्देन मोहिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000026008, "chapter_id": 9026, "verse_number": "१-२६-८", "content_sanskrit": "तं शब्दमभिनिध्याय राक्षसी क्रोधमूर्छिता ।\nश्रुत्वा चाभ्यद्रवत् क्रुद्धा यत्र शब्दो विनिःसृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000026009, "chapter_id": 9026, "verse_number": "१-२६-९", "content_sanskrit": "तां दृष्ट्वा राघवः क्रुद्धां विकृतां विकृताननाम् ।\nप्रमाणेनातिवृद्धां च लक्ष्मणं सोऽभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000026010, "chapter_id": 9026, "verse_number": "१-२६-१०", "content_sanskrit": "पश्य लक्ष्मण यक्षिण्या भैरवं दारुणं वपुः ।\nभिद्येरन् दर्शनादस्या भीरूणां हृदयानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000026011, "chapter_id": 9026, "verse_number": "१-२६-११", "content_sanskrit": "एतां पश्य दुराधर्षां मायाबलसमन्विताम् ।\nविनिवृत्तां करोम्यद्य हृतकर्णाग्रनासिकाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000026012, "chapter_id": 9026, "verse_number": "१-२६-१२", "content_sanskrit": "न ह्येनामुत्सहे हन्तुं स्त्रीस्वभावेन रक्षिताम् ।\nवीर्यं चास्या गतिं चैव हन्यामिति हि मे मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000026013, "chapter_id": 9026, "verse_number": "१-२६-१३", "content_sanskrit": "एवं ब्रुवाणे रामे तु ताटका क्रोधमूर्छिता ।\nउद्यम्य बाहू गर्जन्ती राममेवाभ्यधावत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000026014, "chapter_id": 9026, "verse_number": "१-२६-१४", "content_sanskrit": "विश्वामित्रस्तु ब्रह्मर्षिर्हुंकारेणाभिभर्त्स्य ताम् ।\nस्वस्ति राघवयोरस्तु जयं चैवाभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000026015, "chapter_id": 9026, "verse_number": "१-२६-१५", "content_sanskrit": "उद्धुन्वाना रजो घोरं ताटका राघवावुभौ ।\nरजोमेघेन महता मुहूर्तं सा व्यमोहयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000026016, "chapter_id": 9026, "verse_number": "१-२६-१६", "content_sanskrit": "ततो मायां समास्थाय शिलावर्षेण राघवौ ।\nअवाकिरत् सुमहता ततश्चुक्रोध राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000026017, "chapter_id": 9026, "verse_number": "१-२६-१७", "content_sanskrit": "शिलावर्षं महत् तस्याः शरवर्षेण राघवः ।\nप्रतिवार्योपधावन्त्याः करौ चिच्छेद पत्रिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000026018, "chapter_id": 9026, "verse_number": "१-२६-१८", "content_sanskrit": "ततश्च्छिन्नभुजां श्रान्तामभ्याशे परिगर्जतीम् ।\nसौमित्रिरकरोत् क्रोधाद्धृतकर्णाग्रनासिकाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000026019, "chapter_id": 9026, "verse_number": "१-२६-१९", "content_sanskrit": "कामरूपधरा सा तु कृत्वा रूपाण्यनेकशः ।\nअन्तर्धानं गता यक्षी मोहयन्ती स्वमायया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000026020, "chapter_id": 9026, "verse_number": "१-२६-२०", "content_sanskrit": "अश्मवर्षं विमुञ्चन्ती भैरवं विचचार सा ॥\nततस्तावश्मवर्षेण कीर्यमाणौ समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000026021, "chapter_id": 9026, "verse_number": "१-२६-२१", "content_sanskrit": "दृष्ट्वा गाधिसुतः श्रीमानिदं वचनमब्रवीत् ।\nअलं ते घृणया राम पापैषा दुष्टचारिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000026022, "chapter_id": 9026, "verse_number": "१-२६-२२", "content_sanskrit": "यज्ञविघ्नकरी यक्षी पुरा वर्धेत मायया ।\nवध्यतां तावदेवैषा पुरा संध्या प्रवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000026023, "chapter_id": 9026, "verse_number": "१-२६-२३", "content_sanskrit": "रक्षांसि संध्याकाले तु दुर्धर्षाणि भवन्ति हि ।\nइत्युक्तः स तु तां यक्षीमश्मवृष्ट्याभिवर्षणीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000026024, "chapter_id": 9026, "verse_number": "१-२६-२४", "content_sanskrit": "दर्शयञ्शब्दवेधित्वं तां रुरोध स सायकैः ।\nसा रुद्धा बाणजालेन मायाबलसमन्विता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000026025, "chapter_id": 9026, "verse_number": "१-२६-२५", "content_sanskrit": "अभिदुद्राव काकुत्स्थं लक्ष्मणं च विनेषुदी ।\nतामापतन्तीं वेगेन विक्रान्तामशनीमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000026026, "chapter_id": 9026, "verse_number": "१-२६-२६", "content_sanskrit": "शरेणोरसि विव्याध सा पपात ममार च ।\nतां हतां भीमसंकाशां दृष्ट्वा सुरपतिस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000026027, "chapter_id": 9026, "verse_number": "१-२६-२७", "content_sanskrit": "साधु साध्विति काकुत्स्थं सुराश्चाप्यभिपूजयन् ।\nउवाच परमप्रीतः सहस्राक्षः पुरन्दरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000026028, "chapter_id": 9026, "verse_number": "१-२६-२८", "content_sanskrit": "सुराश्च सर्वे संहृष्टा विश्वामित्रमथाब्रुवन् ।\nमुने कौशिक भद्रं ते सेन्द्राः सर्वे मरुद्गणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000026029, "chapter_id": 9026, "verse_number": "१-२६-२९", "content_sanskrit": "तोषिताः कर्मणानेन स्नेहं दर्शय राघवे ।\nप्रजापतेः कृशाश्वस्य पुत्रान् सत्यपराक्रमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000026030, "chapter_id": 9026, "verse_number": "१-२६-३०", "content_sanskrit": "तपोबलभृतो ब्रह्मन् राघवाय निवेदय ।\nपात्रभूतश्च ते ब्रह्मंस्तवानुगमने रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000026031, "chapter_id": 9026, "verse_number": "१-२६-३१", "content_sanskrit": "कर्तव्यं सुमहत् कर्म सुराणां राजसूनुना ।\nएवमुक्त्वा सुराः सर्वे जग्मुर्हृष्टा विहायसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000026032, "chapter_id": 9026, "verse_number": "१-२६-३२", "content_sanskrit": "विश्वामित्रं पूजयन्तस्ततः संध्या प्रवर्तते ।\nततो मुनिवरः प्रीतस्ताटकावधतोषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000026033, "chapter_id": 9026, "verse_number": "१-२६-३३", "content_sanskrit": "मूर्ध्नि राममुपाघ्राय इदं वचनमब्रवीत् ।\nइहाद्य रजनीं राम वसाम शुभदर्शन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000026034, "chapter_id": 9026, "verse_number": "१-२६-३४", "content_sanskrit": "श्वः प्रभाते गमिष्यामस्तदाश्रमपदं मम ।\nविश्वामित्रवचः श्रुत्वा हृष्टो दशरथात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000026035, "chapter_id": 9026, "verse_number": "१-२६-३५", "content_sanskrit": "उवास रजनीं तत्र ताटकाया वने सुखम् ।\nमुक्तशापं वनं तच्च तस्मिन्नेव तदाहनि ।\nरमणीयं विबभ्राज यथा चैत्ररथं वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000026036, "chapter_id": 9026, "verse_number": "१-२६-३६", "content_sanskrit": "निहत्य तां यक्षसुतां स रामः\n::प्रशस्यमानः सुरसिद्धसङ्घैः ।\nउवास तस्मिन् मुनिना सहैव\n::प्रभातवेलां प्रतिबोध्यमानः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000026037, "chapter_id": 9026, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे षड्विंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]