[{"id": 40008010, "chapter_id": 9026, "verse_number": "1", "content_sanskrit": "एवं बृवन्त्यां सीतायां संरब्दः परुषं वचः। ललाटे भृकुटीं कृत्वा रावणः प्रत्युवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40008011, "chapter_id": 9026, "verse_number": "2", "content_sanskrit": "भ्राता वैश्रवणस्याहं सापत्न्यो वरवर्णिनि। रावणो नाम भद्रं ते दशग्रीवः प्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40008012, "chapter_id": 9026, "verse_number": "3", "content_sanskrit": "यस्य देवास्सगन्धर्वाः पिशाचपतगोरगाः। विद्रवन्ति भयाद्भीता मृत्योरिव सदा प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40008013, "chapter_id": 9026, "verse_number": "4", "content_sanskrit": "येन वैश्रवणो राजा द्वैमात्रः कारणान्तरे। द्वन्द्वमासादितः क्रोधाद्रणे विक्रम्य निर्जितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40008014, "chapter_id": 9026, "verse_number": "5", "content_sanskrit": "यद्भयार्तः परित्यज्य स्वमधिष्ठानमृद्धिमत्। कैलासं पर्वतश्रेष्ठमध्यास्ते नरवाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40008015, "chapter_id": 9026, "verse_number": "6", "content_sanskrit": "यस्य तत्पुष्पकं नाम विमानं कामगं शुभम्। वीर्यादेवार्जितं भद्रे येन यामि विहायसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40008016, "chapter_id": 9026, "verse_number": "7", "content_sanskrit": "मम सञ्जातरोषस्य मुखं दृष्ट्वैव मैथिलि। विद्रवन्ति परित्रस्तास्सुराश्शक्रपुरोगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40008017, "chapter_id": 9026, "verse_number": "8", "content_sanskrit": "यत्र तिष्ठाम्यहं तत्र मारुतो वाति शङ्कितः। तीव्रांशुश्शिशिरांशुश्च भयात्सम्पद्यते रविः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40008018, "chapter_id": 9026, "verse_number": "9", "content_sanskrit": "निष्कम्पपत्रास्तरवो नद्यश्च स्तिमितोदकाः। भवन्ति यत्र यत्राहं तिष्ठामि विचरामि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40008019, "chapter_id": 9026, "verse_number": "10", "content_sanskrit": "मम पारे समुद्रस्य लङ्का नाम पुरी शुभा। सम्पूर्णा राक्षसैर्घोरैर्यथेन्द्रस्यामरावती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40008020, "chapter_id": 9026, "verse_number": "11", "content_sanskrit": "प्राकारेण परिक्षिप्ता पाण्डुरेण विराजता। हेमकक्ष्या पुरी रम्या वैढूर्यमयतोरणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40008021, "chapter_id": 9026, "verse_number": "12", "content_sanskrit": "हस्त्यश्वरथसम्बाधा तूर्यनादविनादिता। सर्वकालफलैर्वृक्षैस्सङ्कुलोद्द्यानशोभिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40008022, "chapter_id": 9026, "verse_number": "13", "content_sanskrit": "तत्र त्वं वसती सीते राजपुत्रि मया सह। न स्मरिष्यसि नारीणां मानुषीणां मनस्विनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40008023, "chapter_id": 9026, "verse_number": "14", "content_sanskrit": "भुञ्जाना मानुषान्भोगान्दिव्यांश्च वरवर्णिनि। न स्मरिष्यसि रामस्य मानुषस्य गतायुषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40008024, "chapter_id": 9026, "verse_number": "15", "content_sanskrit": "स्थापयित्वा प्रियं पुत्रं राज्ञा दशरथेन यः। मन्दवीर्यस्सुतो ज्येष्ठस्ततः प्रस्थापितो वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40008025, "chapter_id": 9026, "verse_number": "16", "content_sanskrit": "तेन किं भ्रष्टराज्येन रामेण गतचेतसा। करिष्यसि विशालाक्षि तापसेन तपस्विना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40008026, "chapter_id": 9026, "verse_number": "17", "content_sanskrit": "सर्वराक्षसभर्तारं कामात्स्वयमिहागतम्। न मन्मथशराविष्टं प्रत्याख्यातुं त्वमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40008027, "chapter_id": 9026, "verse_number": "18", "content_sanskrit": "प्रत्याख्याय हि मां भीरु परितापं गमिष्यसि। चरणेनाभिहत्येव पुरूरवसमूर्वशी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40008028, "chapter_id": 9026, "verse_number": "19", "content_sanskrit": "अङ्गुल्या न समो रामो मम युद्धे स मानुषः। तव भाग्येन सम्प्राप्तं भजस्व वरवर्णिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40008029, "chapter_id": 9026, "verse_number": "20", "content_sanskrit": "एवमुक्ता तु वैदेही क्रुद्धा संरक्तलोचना। अब्रवीत्परुषं वाक्यं रहिते राक्षसाधिपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40008030, "chapter_id": 9026, "verse_number": "21", "content_sanskrit": "कथं वैश्रवणं देवं सर्वभूतनमस्कृतम्। भ्रातरं व्यपदिश्य त्वमशुभं कर्तुमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40008031, "chapter_id": 9026, "verse_number": "22", "content_sanskrit": "अवश्यं विनशिष्यन्ति सर्वे रावण राक्षसाः। येषां त्वं कर्कशो राजा दुर्बुद्धिरजितेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40008032, "chapter_id": 9026, "verse_number": "23", "content_sanskrit": "अपहृत्य शचीं भार्यां शक्यमिन्द्रस्य जीवितुम्। न च रामस्य भार्यां मामपनीयास्ति जीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40008033, "chapter_id": 9026, "verse_number": "24", "content_sanskrit": "जीवेच्चिरं वज्रधरस्य हस्ताच्छचीं प्रधृष्याप्रतिरूपरूपाम्। न मादृशीं राक्षस दूशयित्वा पीतामृतस्यापि तवास्ति मोक्षः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]