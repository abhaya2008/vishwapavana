[{"id": 2005621, "chapter_id": 1109, "verse_number": "१-११०-०x", "content_sanskrit": "अम्बोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2005622, "chapter_id": 1109, "verse_number": "१-११०-१", "content_sanskrit": "अन्यपूर्वेति मां साल्वो नाभिनन्दति बालिशः।\nसाहं धर्माच्च कामाच्च विहीना शोकधारिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2005623, "chapter_id": 1109, "verse_number": "१-११०-२", "content_sanskrit": "अपतिः क्षत्रियान्सर्वानाक्रन्दामि समन्ततः।\nइयं वः क्षत्रिया माला या भीष्मं निहनिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2005624, "chapter_id": 1109, "verse_number": "१-११०-३", "content_sanskrit": "अहं च भार्या तस्य स्यां यो भीष्मं घातयिष्यति।\nतस्याश्चङ्क्रम्यमाणायाः समाः पञ्च गताः पराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2005625, "chapter_id": 1109, "verse_number": "१-११०-४", "content_sanskrit": "नाभवच्छरणं कश्चित्क्षत्रियो भीष्मजाद्भयात्।\nअगच्छत्सोमकं साऽम्बा पाञ्चालेषु यशस्विनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2005626, "chapter_id": 1109, "verse_number": "१-११०-५", "content_sanskrit": "सत्यसन्धं महेष्वासं सत्यधर्मपरायणम्।\nसा सभाद्वारमागम्य पाञ्चालैरभिरक्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2005627, "chapter_id": 1109, "verse_number": "१-११०-६", "content_sanskrit": "पाञ्चालराजमाक्रन्दत्प्रगृह्य सुभुजा भुजौ।\nभीष्मेण हन्यमानां मां मज्जन्तीमिव च ह्रदे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2005628, "chapter_id": 1109, "verse_number": "१-११०-७", "content_sanskrit": "यज्ञसेनाभिधावेह पाणिमालम्ब्य चोद्धर।\nतेन मे सर्वधर्माश्च रतिभोगाश्च केवलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2005629, "chapter_id": 1109, "verse_number": "१-११०-८", "content_sanskrit": "उभौ च लोकौ कीर्तिश्च समूलौ सफलौ हृतौ।\n***न्त्येवं न विन्दामि राजन्यं शरणं क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2005630, "chapter_id": 1109, "verse_number": "१-११०-९", "content_sanskrit": "किं नु निःक्षत्रियो लोको यत्रानाथोऽवसीदति।\nसमागम्य तु राजानो मयोक्ता राजसत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2005631, "chapter_id": 1109, "verse_number": "१-११०-१०", "content_sanskrit": "शृण्वन्तु सर्वे राजानो मयोक्तं राजसत्तमाः।\nइक्ष्वाकूणां तु ये वृद्धाः पाञ्चालानां च ये वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2005632, "chapter_id": 1109, "verse_number": "१-११०-११", "content_sanskrit": "त्वत्प्रसादाद्विवाहेऽस्मिन्मा धर्मो मा पराजयेत्।\nप्रसीद यज्ञसेनेह गतिर्मे भव सोमक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2005633, "chapter_id": 1109, "verse_number": "१-११०-१२x", "content_sanskrit": "यज्ञसेन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2005634, "chapter_id": 1109, "verse_number": "१-११०-१२", "content_sanskrit": "जानामि त्वां बोधयामि राजपुत्रि विशेषतः।\nयथाशक्ति यथाधर्मं बलं संधारयाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2005635, "chapter_id": 1109, "verse_number": "१-११०-१३", "content_sanskrit": "अन्यस्मात्पार्थिवाद्यत्ते भयं स्यात्पार्थिवात्मजे।\nतस्यापनयने हेतुं संविधातुमहं प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2005636, "chapter_id": 1109, "verse_number": "१-११०-१४", "content_sanskrit": "नहि शान्तनवस्याहं महास्त्रस्य प्रहारिणः।\nईश्वरः क्षत्रियाणां हि बलं धर्मोऽनुवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2005637, "chapter_id": 1109, "verse_number": "१-११०-१५", "content_sanskrit": "सा साधु व्रज कल्याणि न मां भीष्मो दहेद्बलात्।\nन प्रत्यगृह्णंस्ते सर्वे किमित्येव न वेद्म्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2005638, "chapter_id": 1109, "verse_number": "१-११०-१६", "content_sanskrit": "न हि भीष्मादहं धर्मं शक्तो दातुं कथंचन।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2005639, "chapter_id": 1109, "verse_number": "१-११०-१६x", "content_sanskrit": "वैशम्पायन उवाच।\nइत्युक्ता स्रजमासज्य द्वारि राज्ञो व्यपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2005640, "chapter_id": 1109, "verse_number": "१-११०-१७", "content_sanskrit": "व्युदस्तां सर्वलोकेषु तपसा संशितव्रताम्।\nतामन्वगच्छद्द्रुपदः सान्त्वं जल्पन्पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2005641, "chapter_id": 1109, "verse_number": "१-११०-१८", "content_sanskrit": "स्रजं गृहाण कल्याणि न नो वैरं प्रसञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2005642, "chapter_id": 1109, "verse_number": "१-११०-१९x", "content_sanskrit": "अम्बोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2005643, "chapter_id": 1109, "verse_number": "१-११०-१९", "content_sanskrit": "एवमेव त्वया कार्यमिति स्म प्रतिकाङ्क्षते।\nन तु तस्यान्यथा भावो दैवमेतदमानुषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2005644, "chapter_id": 1109, "verse_number": "१-११०-२०", "content_sanskrit": "यश्चैनां स्रजमादाय स्वयं वै प्रतिमोक्षते।\nस भीष्मं समरे हन्ता मम धर्मप्रणाशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2005645, "chapter_id": 1109, "verse_number": "१-११०-२१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2005646, "chapter_id": 1109, "verse_number": "१-११०-२१", "content_sanskrit": "तां स्रजं द्रुपदो राजा कंचित्कालं ररक्ष सः।\nततो विस्रम्भमास्थाय तूष्णीमेतामुपैक्षत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2005647, "chapter_id": 1109, "verse_number": "१-११०-२२", "content_sanskrit": "तां शिखण्डिन्यबध्नात्तु बाला पितुरवज्ञया।\nतां पिता त्वत्यजच्छीघ्रं त्रस्तो भीष्मस्य किल्बिषात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2005648, "chapter_id": 1109, "verse_number": "१-११०-२३", "content_sanskrit": "इषीकं ब्राह्मणं भीता साभ्यगच्छत्तपस्विनम्।\nगङ्गाद्वारि तपस्यन्तं तुष्टिहेतोस्तपस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2005649, "chapter_id": 1109, "verse_number": "१-११०-२४", "content_sanskrit": "उपचाराभितुष्टस्तामब्रवीदृषिसत्तमः।\nगङ्गाद्वारे विभजनं भविता नचिरादिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2005650, "chapter_id": 1109, "verse_number": "१-११०-२५", "content_sanskrit": "तत्र गन्धर्वराजानं तुम्बुरुं प्रियदर्शनम्।\nआराधयितुमीहस्व सम्यक्परिचरस्व तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2005651, "chapter_id": 1109, "verse_number": "१-११०-२६", "content_sanskrit": "अहमप्यत्र साचिव्यं कर्तास्मि तव शोभने।\nतं तदाचर भद्रं ते स ते श्रेयो विधास्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2005652, "chapter_id": 1109, "verse_number": "१-११०-२७", "content_sanskrit": "ततो विभजनं तत्र गन्धर्वाणामवर्तत।\nतत्र द्वाववशिष्येतां गन्धर्वावमितौ जसौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2005653, "chapter_id": 1109, "verse_number": "१-११०-२८", "content_sanskrit": "तयोरेकः समीक्ष्यैनां स्त्रीबुभूषुरुवाच ह।\nइदं गृह्णीष्व पुंलिङ्गं वृणे स्त्रीलिङ्गमेव ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2005654, "chapter_id": 1109, "verse_number": "१-११०-२९", "content_sanskrit": "नियमं चक्रतुस्तत्र स्त्री पुमांश्चैव तावुभौ।\nततः पुमान्समभवच्छिखण्डी परवीरहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2005655, "chapter_id": 1109, "verse_number": "१-११०-३०", "content_sanskrit": "स्त्री भूत्वा ह्यपचक्राम स गन्धर्वो मुदान्वितः।\nलब्ध्वा तु महतीं प्रीतिं याज्ञसेनिर्महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2005656, "chapter_id": 1109, "verse_number": "१-११०-३१", "content_sanskrit": "ततो बुद्बुदकं गत्वा पुनरस्त्राणि सोऽकरोत्।\nतत्र चास्त्राणि दिव्यानि कृत्वा स सुमहाद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2005657, "chapter_id": 1109, "verse_number": "१-११०-३२", "content_sanskrit": "स्वदेशमभिसंपदे पाञ्चालं कुरुनन्दन।\nसोऽभिवाद्य पितुः पादौ महेष्वासः कृताञ्जलिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2005658, "chapter_id": 1109, "verse_number": "१-११०-३३", "content_sanskrit": "उवाच भवता भीष्मान्न भेतव्यं कथंचन॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2005659, "chapter_id": 1109, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि दशाधिकशततमोऽध्यायः॥ ११० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]