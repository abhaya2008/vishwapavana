[{"id": 2160903, "chapter_id": 4482, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2160904, "chapter_id": 4482, "verse_number": "१", "content_sanskrit": "सलिले जनिते तस्मिन् कौन्तेयेन महात्मना ।\nनिवारिते द्विषत्सैन्ये कृते च शरवेश्मनि\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2160905, "chapter_id": 4482, "verse_number": "२", "content_sanskrit": "वासुदेवो रथात् तूर्णमवतीर्य महाद्युतिः ।\nमोचयामास तुरगान् विनुन्नान् कङ्कपत्रिभिः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2160906, "chapter_id": 4482, "verse_number": "३", "content_sanskrit": "सिद्धचारणसङ्घानां सैनिकानां च सर्वशः ।\nअदृष्टपूर्वं तद् दृष्ट्वा सिंहनादो महानभूत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2160907, "chapter_id": 4482, "verse_number": "४", "content_sanskrit": "पदातिनं तु कौन्तेयं युद्ध्यमानं नरर्षभाः ।\nनाशक्नुवन् वारयितुं तदद्भुतमिवाभवत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2160908, "chapter_id": 4482, "verse_number": "५", "content_sanskrit": "आपतत्सु रथौघेषु प्रभूतगजवाजिषु ।\nनासम्भ्रमत् तदा पार्थस्तदस्य पुरुषानति\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2160909, "chapter_id": 4482, "verse_number": "६", "content_sanskrit": "व्यसृजन्त शरौघांस्ते पाण्डवं प्रति पार्थिवाः ।\nन चाव्यथत धर्मात्मा वासविः परवीरहा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2160910, "chapter_id": 4482, "verse_number": "७", "content_sanskrit": "स तानि शरजालानि गदाः प्रासांश्च वीर्यवान् ।\nसमन्ताद् ग्रसते पार्थः सरितः सागरो यथा\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2160911, "chapter_id": 4482, "verse_number": "८", "content_sanskrit": "अस्त्रवेगेन महता पार्थो बाहुबलेन च ।\nसर्वेषां पार्थिवेन्द्राणामग्रसत् तान् शरोत्तमान्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2160912, "chapter_id": 4482, "verse_number": "९", "content_sanskrit": "तत् तु पार्थस्य विक्रान्तं वासुदेवस्य चोभयोः ।\nअपूजयन् महाराज कौरवाः परमाद्भुतम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2160913, "chapter_id": 4482, "verse_number": "", "content_sanskrit": "कौरवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2160914, "chapter_id": 4482, "verse_number": "१०", "content_sanskrit": "किञ्चाद्भुततरं लोके भविता चाथवाप्यभूत् ।\nयदश्वान् पार्थगोविन्दौ पाययामासतू रणे\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2160915, "chapter_id": 4482, "verse_number": "११", "content_sanskrit": "भयं विपुलमस्मासु धत्तामतिमहारथौ ।\nतेजो विदधतुश्चोग्रं विस्रम्भाद् रणमूर्धनि\nदधारैको रणे पार्थो वेलोद्धृतमिवार्णवम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2160916, "chapter_id": 4482, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2160917, "chapter_id": 4482, "verse_number": "१२", "content_sanskrit": "पार्थस्य शरसञ्छन्ने तस्मिन् वेश्मनि भारत ।\nआकाशमिव सम्प्राप्य विचेरुस्तत्र पक्षिणः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2160918, "chapter_id": 4482, "verse_number": "१३", "content_sanskrit": "न चैनं युधि तिष्ठन्तं तव सैन्येषु भारत ।\nअभ्यद्रवत सङ्क्रुद्धः पुमान् कश्चित् तु तावकः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2160919, "chapter_id": 4482, "verse_number": "१४", "content_sanskrit": "सर्वे विमनसो भूत्वा तव योधा विशांपते ।\nसम्प्रेक्ष्य तत्र गोविन्दं पाण्डवं च धनञ्जयम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2160920, "chapter_id": 4482, "verse_number": "१५", "content_sanskrit": "अथोत्स्मयन् हृषीकेशः स्त्रीमध्य इव भारत ।\nअर्जुनेन कृते सङ्खे शरगर्भगृहे विभो\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2160921, "chapter_id": 4482, "verse_number": "१६", "content_sanskrit": "उपावर्तयदव्यग्रः तानश्वान् पुष्करेक्षणः ।\nमिषतां सर्वसैन्यानां त्वदीयानां विशांपते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2160922, "chapter_id": 4482, "verse_number": "१७", "content_sanskrit": "उपावृत्योत्थितानश्वान् पाणिभ्यां पुष्करेक्षणः ।\nसम्मार्जयद् रणे राजन् पश्यतां सर्वयोधिनाम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2160923, "chapter_id": 4482, "verse_number": "१८", "content_sanskrit": "तेषां श्रमं च ग्लानिं च वमथुं वेपथुं व्रणान् ।\nसर्वाण्यपानुदत् कृष्णः कुशलो ह्यश्वकर्मणि\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2160924, "chapter_id": 4482, "verse_number": "१९", "content_sanskrit": "शल्यानुद्धृत्य पाणिभ्यां परिमृज्य च तान् हयान् ।\nउपावृत्तान् यथाकामं पाययामास वारि च\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2160925, "chapter_id": 4482, "verse_number": "२०", "content_sanskrit": "ततो लब्धोदकान् स्नातान् जग्धान्नान् विगतक्लमान् ।\nयोजयामास संहृष्टः पुनरेव रथोत्तमे\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2160926, "chapter_id": 4482, "verse_number": "२१", "content_sanskrit": "स तं रथवरं शौरिः सर्वशस्त्रभृतां वरः ।\nसमास्थाय महातेजाः सार्जुनः प्रययौ द्रुतम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2160927, "chapter_id": 4482, "verse_number": "२२", "content_sanskrit": "योजयित्वा हयांस्तत्र विधिदृष्टेन कर्मणा ।\nरणे चचार गोविन्दः तृणीकृत्य महारथान् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2160928, "chapter_id": 4482, "verse_number": "२३", "content_sanskrit": "रथं रथवरस्याजौ युक्तं लब्धोदकैर्हयैः ।\nदृष्ट्वा कुरुबलश्रेष्ठाः पुनर्विमनसोऽभवन्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2160929, "chapter_id": 4482, "verse_number": "२५", "content_sanskrit": "विनिःश्वसन्तस्ते राजन् भग्नदंष्ट्रा इवोरगाः ।\nधिगहोऽधिगतः पार्थः कृष्णश्चेत्यब्रुवन् पृथक्\t॥२४॥\nतत् सैन्यं सर्वतो दृष्ट्वा लोमहर्षणमद्भुतम् ।\nत्वरध्वमिति चाक्रन्दन् नैतदस्तीति चाब्रुवन्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2160930, "chapter_id": 4482, "verse_number": "", "content_sanskrit": "सैनिकाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2160931, "chapter_id": 4482, "verse_number": "२६", "content_sanskrit": "सर्वक्षत्रस्य मिषतो रथेनैकेन दंसितौ ।\nबालः क्रीडनकेनेव कदर्थीकृत्य नो बलम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2160932, "chapter_id": 4482, "verse_number": "२७", "content_sanskrit": "क्रोशतां यतमानानामसंसक्तौ परन्तपौ ।\nदर्शयित्वाऽत्मनो वीर्यं प्रयातौ सर्वराजसु\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2160933, "chapter_id": 4482, "verse_number": "२८", "content_sanskrit": "यथा दैवासुरे युद्धे तृणीकृत्य च दानवान् ।\nइन्द्राविष्णू पुरा राजन् जम्भस्य वधकाङ्क्षिणौ\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2160934, "chapter_id": 4482, "verse_number": "२९", "content_sanskrit": "तौ प्रयातौ पुनर्दृष्ट्वा तवाऽन्ये सैनिकाब्रुवन् ।\nत्वरध्वं कुरवः सर्वे वधे कृष्णकिरीटिनोः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2160935, "chapter_id": 4482, "verse_number": "३०", "content_sanskrit": "रथं युङ्क्त्वा तु दाशार्हो मिषतां सर्वधन्विनाम् ।\nजयद्रथाय यात्येष कदर्थीकृत्य नो रणे\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2160936, "chapter_id": 4482, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2160937, "chapter_id": 4482, "verse_number": "३१", "content_sanskrit": "तत्र केचिन्महाराज समभाषन्त भूमिपाः ।\nअदृष्टपूर्वं सङ्ग्रामे तद् दृष्ट्वा महदद्भुतम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2160938, "chapter_id": 4482, "verse_number": "३२", "content_sanskrit": "सर्वसैन्यानि राजा च धृतराष्ट्रोऽत्ययं गतः ।\nदुर्योधनापराधेन क्षत्रं कृत्स्नं च मेदिनी\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2160939, "chapter_id": 4482, "verse_number": "३३", "content_sanskrit": "विलयं समनुप्राप्ता तच्च राजा न बुद्ध्यते ।\nइत्येवं क्षत्रियास्तत्र ब्रुवन्त्यन्ये च भारत\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2160940, "chapter_id": 4482, "verse_number": "३४", "content_sanskrit": "सिन्धुराजस्य यत् कृत्यं गतस्य यमसादनम् ।\nतत् करोतु वृथादृष्टिर्धार्तराष्ट्रोऽनुपायवित्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2160941, "chapter_id": 4482, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2160942, "chapter_id": 4482, "verse_number": "३५", "content_sanskrit": "ततः शीघ्रतरं प्रायात् सैन्धवं प्रति पाण्डवः ।\nविवर्तमाने तिग्मांशौ हृष्टैः पीतोदकैर्हयैः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2160943, "chapter_id": 4482, "verse_number": "३६", "content_sanskrit": "तं प्रयान्तं महाबाहुं सर्वशस्त्रभृतां वरम् ।\nनाशक्नुवन् धारयितुं योधाः क्रुद्धमिवान्तकम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2160944, "chapter_id": 4482, "verse_number": "३७", "content_sanskrit": "विद्राव्य तु ततः सैन्यं पाण्डवः श्वेतवाहनः ।\nयथा मृगगणान् सिंहः सैन्धवार्थे व्यलोलयत्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2160945, "chapter_id": 4482, "verse_number": "३८", "content_sanskrit": "गाहमानो ह्यनीकानि तूर्णमश्वानचोदयत् ।\nबलाकवर्णं दाशार्हः पाञ्चजन्यं व्यनादयत्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2160946, "chapter_id": 4482, "verse_number": "३९", "content_sanskrit": "कौन्तेयेनाग्रतः सृष्टा न्यपतन् पृष्ठतः शराः ।\nतूर्णात् तूर्णतरं ह्यश्वाः तेऽवहन् वातरंहसः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2160947, "chapter_id": 4482, "verse_number": "४०", "content_sanskrit": "वातोद्धूतपताकान्तं रथं जलदनिस्वनम् ।\nघोरं कपिध्वजं दृष्ट्वा विषण्णा बहवोऽभवन्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2160948, "chapter_id": 4482, "verse_number": "४१", "content_sanskrit": "दिवाकरेऽथ रजसा सर्वतः संवृते भृशम् ।\nशरार्ताश्च रणे योधा न कृष्णौ शेकुरीक्षितुम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2160949, "chapter_id": 4482, "verse_number": "४२", "content_sanskrit": "ततो नृपतयः क्रुद्धाः परिवव्रुर्धनञ्जयम् ।\nक्षत्रिया बहवश्चान्ये जयद्रथवधैषिणम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2160950, "chapter_id": 4482, "verse_number": "४३", "content_sanskrit": "बलेषु म्रियमाणेषु वीक्ष्य तं पुरुषर्षभम् ।\nदुर्योधनोऽभ्ययात् पार्थं त्वरमाणो सहानुगः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2160951, "chapter_id": 4482, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि सप्ताशीतितमोऽध्यायः ॥ ८७ ॥\nजयद्रथवधपर्वणि एकादशोऽध्यायः ॥ ११ ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]