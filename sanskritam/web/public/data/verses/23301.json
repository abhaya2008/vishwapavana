[{"id": 7003301000, "chapter_id": 23301, "verse_number": "१-१०४-१", "content_sanskrit": "ऋषय ऊचुः  ।\nकथं विनायको जातो गजवक्त्रो गणेश्वरः  ।\nकथंप्रभावस्तस्यैवं सूत वक्तुमिहार्हसि ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003301001, "chapter_id": 23301, "verse_number": "१-१०४-२", "content_sanskrit": "सूत उवाच  ।\nएतस्मिन्नंतरे देवाः सेंद्रोपेंद्राः समेत्य ते  ।\nधर्मविघ्नं तदा कर्त्तुं दैत्यानामभवन्द्विजाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003301002, "chapter_id": 23301, "verse_number": "१-१०४-३", "content_sanskrit": "असुरा यातुधानाश्च राक्षसाः क्रूरकर्मिणः  ।\nतामसाश्च तथा चान्ये राजसाश्च तथा भुवि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003301003, "chapter_id": 23301, "verse_number": "१-१०४-४", "content_sanskrit": "अविघ्नं यज्ञदानाद्यौः समभ्यर्च्य महेश्वरम्  ।\nब्रह्माणं च हरिं विप्रा लब्धेप्सितवरा यतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003301004, "chapter_id": 23301, "verse_number": "१-१०४-५", "content_sanskrit": "ततोऽस्माकं सुरश्रेष्ठाः गणपं विजयसंभवः  ।\nतेषां ततस्तु विघ्नार्थमविघ्नाय दिवौकसाम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003301005, "chapter_id": 23301, "verse_number": "१-१०४-६", "content_sanskrit": "पुत्रार्थं चैव नारीणां नराणां कर्मसिद्धये  ।\nविघ्नेशं शंकरं स्रष्टुं गणपं स्तोतुमर्हथ ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003301006, "chapter_id": 23301, "verse_number": "१-१०४-७", "content_sanskrit": "इत्युक्त्वान्योन्यमनघं तुष्टुवुः शिवमीश्वरम्  ।\nनमः सर्वात्मने तुभ्यं सर्वज्ञाय पिनाकिने ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003301007, "chapter_id": 23301, "verse_number": "१-१०४-८", "content_sanskrit": "अनघायविरिंचाय देव्याः कार्यार्थदायिने  ।\nअकायायार्थकायाय हरेः कायापहारिणे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003301008, "chapter_id": 23301, "verse_number": "१-१०४-९", "content_sanskrit": "कायांतस्थामृताधारमंडलावस्थिताय ते  ।\nकृतादिभेदकालाय कालवेगाय ते नमः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003301009, "chapter_id": 23301, "verse_number": "१-१०४-१०", "content_sanskrit": "कालाग्निरुद्ररुपाय धर्माद्यष्टपदाय च  ।\nकालीविशुद्धदेहाय कालिकाकारणाय ते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003301010, "chapter_id": 23301, "verse_number": "१-१०४-११", "content_sanskrit": "कालकंठाय मुख्याय वाहनाय वराय ते  ।\nअंबिकापतये तुभ्यं हिरण्यपतये नमः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003301011, "chapter_id": 23301, "verse_number": "१-१०४-१२", "content_sanskrit": "हिरण्यरेतसे चैव नमः शर्वाय शूलिने  ।\nकपालदंडपाशासिचर्मांकुशधरायच ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003301012, "chapter_id": 23301, "verse_number": "१-१०४-१३", "content_sanskrit": "पतये हैमवत्याश्च हेमशुक्लाय ते नमः  ।\nपीतशुक्लाय रक्षार्थं सुराणां कृष्णवर्त्मने ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003301013, "chapter_id": 23301, "verse_number": "१-१०४-१४", "content_sanskrit": "पंचमाय महापंचयज्ञिनां फलदाय च  ।\nपंचास्यफणिहाराय पंचाक्षरमयाय ते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003301014, "chapter_id": 23301, "verse_number": "१-१०४-१५", "content_sanskrit": "पंचधा पंचकैवल्यदेवैरर्चितमूर्तये  ।\nपंचाक्षरदृशे तुभ्यं परात्परतराय ते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003301015, "chapter_id": 23301, "verse_number": "१-१०४-१६", "content_sanskrit": "षोडशस्वरवज्रांगवक्त्रायाक्षयरूपिणे  ।\nकादिपंचकहस्ताय चादिहस्ताय ते नमः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003301016, "chapter_id": 23301, "verse_number": "१-१०४-१७", "content_sanskrit": "टादिपादाय रुद्राय तादिपादाय ते नमः  ।\nपादिमेंढ्राय यद्यंगधातुसप्तकधारिणे ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003301017, "chapter_id": 23301, "verse_number": "१-१०४-१८", "content_sanskrit": "शांतात्मरूपिणे साक्षात्क्षदंतक्रोधिने नमः  ।\nलवरेफहळांगाय निरंगाय च ते नमः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003301018, "chapter_id": 23301, "verse_number": "१-१०४-१९", "content_sanskrit": "सर्वेषामेव भूतानां हृदि निःस्वनकारिणे  ।\nभ्रुवेरंते सदा सद्भिर्दृष्टायात्यंतभानवे ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003301019, "chapter_id": 23301, "verse_number": "१-१०४-२०", "content_sanskrit": "भानुसोमाग्निनेत्राय परमात्मस्वरूपिणे  ।\nगुणत्रयोपरिस्थाय तीर्थपादाय ते नमः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003301020, "chapter_id": 23301, "verse_number": "१-१०४-२१", "content_sanskrit": "तीर्थतत्त्वाय साराय तस्मादपि पराय ते  ।\nऋग्जयुः सामवेदाय ओंकाराय नमोनमः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003301021, "chapter_id": 23301, "verse_number": "१-१०४-२२", "content_sanskrit": "ओंकारे त्रिविधं रूपमास्थायोपरिवासिने  ।\nपीताय कृष्णवर्णाय रक्तायात्यंततेजसे ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003301022, "chapter_id": 23301, "verse_number": "१-१०४-२३", "content_sanskrit": "स्थानपंचकसंस्थाय पंचधांडबहिः क्रमात्  ।\nब्रह्मणे विष्णवे तुभ्यं कुमाराय नमोनमः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003301023, "chapter_id": 23301, "verse_number": "१-१०४-२४", "content_sanskrit": "अंबायाः परमेशाय सर्वोपरिचारय ते  ।\nमूलसूक्ष्मस्वरूपाय स्थूलसूक्ष्माय ते नमः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003301024, "chapter_id": 23301, "verse_number": "१-१०४-२५", "content_sanskrit": "सर्वसंकल्पशून्याय सर्वस्माद्रक्षिताय ते  ।\nआदिमध्यांतशून्याय चित्संस्थाय नमोनमः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003301025, "chapter_id": 23301, "verse_number": "१-१०४-२६", "content_sanskrit": "यमाग्निवायुरुद्रांबुसोमशक्रनिशाचरैः  ।\nदिङ्मुखोदिङ्मुखे नित्यं सगणैः पूजिताय ते ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003301026, "chapter_id": 23301, "verse_number": "१-१०४-२७", "content_sanskrit": "सर्वेषु सर्वदा सर्वमार्गे संपूजिताय ते  ।\nरुद्राय रुद्रनीलाय कद्रुद्राय प्रचेतसे  ।\nमहेश्वराय धीराय नमः साक्षाच्छिवाय ते ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003301027, "chapter_id": 23301, "verse_number": "१-१०४-२८", "content_sanskrit": "अथ श्रृणु भगवन् स्तवच्छलेन कथितमजेंद्रमुखैः सुरासुरेशैः  ।\nमखमदनयमाग्निदक्षयज्ञक्षपणविचित्रविचेष्टितं क्षमस्व ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003301028, "chapter_id": 23301, "verse_number": "१-१०४-२९", "content_sanskrit": "सूत उवाच  ।\nयः पठेत्तु स्तवं भक्या शक्राग्निप्रमुखैः सुरैः  ।\nकीर्तितं श्रावयेद्विद्वान् स याति परमां गतिम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]