[{"id": 2161127, "chapter_id": 4487, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2161128, "chapter_id": 4487, "verse_number": "१", "content_sanskrit": "ध्वजान् बहुविधाकारान् भ्राजमानानतिश्रिया ।\nपार्थानां मामकानां च तान् ममाचक्ष्व सञ्जय\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2161129, "chapter_id": 4487, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2161130, "chapter_id": 4487, "verse_number": "२", "content_sanskrit": "ध्वजान् बहुविधाकारान् शृणु तेषां महात्मनाम् ।\nप्रत्यदृश्यन्त राजेन्द्र ज्वलिता इव पावकाः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2161131, "chapter_id": 4487, "verse_number": "३", "content_sanskrit": "तेषां तु रथमुख्यानां रथेषु विविधा ध्वजाः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2161132, "chapter_id": 4487, "verse_number": "४", "content_sanskrit": "काञ्चनाः काञ्चनापीडाः काञ्चनस्रगलङ्कृताः ।\nकाञ्चनानीव शृङ्गाणि काञ्चनस्य महागिरेः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2161133, "chapter_id": 4487, "verse_number": "५", "content_sanskrit": "अनेकवर्णा विविधा ध्वजाः परमशोभनाः ।\nते ध्वजाः संवृतास्तेषां पताकाभिः समन्ततः\nनानावर्णविचित्राभिः शोभन्ते सर्वतोदिशः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2161134, "chapter_id": 4487, "verse_number": "६", "content_sanskrit": "पताकाश्च ततस्तास्तु श्वसनेन समीरिताः ।\nनृत्यमानाः प्रदृश्यन्ते रङ्गमध्ये यथा स्त्रियः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2161135, "chapter_id": 4487, "verse_number": "७", "content_sanskrit": "इन्द्रायुधसवर्णाभाः पताका भरतर्षभ ।\nदोधूयमाना रथिनां शोभयन्ति महारथाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2161136, "chapter_id": 4487, "verse_number": "८", "content_sanskrit": "सिंहलाङ्गूलमुग्रास्यं ध्वजं वानरलक्षणम् ।\nधनञ्जयस्य सङ्ग्रामे प्रत्यपश्याम भैरवम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2161137, "chapter_id": 4487, "verse_number": "९", "content_sanskrit": "स वानरध्वजो राजन् पताकाभिरलङ्कृतः ।\nत्रासयामास तत् सैन्यं ध्वजो गाण्डीवधन्वनः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2161138, "chapter_id": 4487, "verse_number": "१०", "content_sanskrit": "तथैव सिंहलाङ्गूलं द्रोणपुत्रस्य भारत ।\nध्वजाग्रे समपश्याम बालसूर्यसमप्रभम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2161139, "chapter_id": 4487, "verse_number": "११", "content_sanskrit": "काञ्चनं पवनोद्धूतं शक्रध्वजसमद्युति ।\nनन्दनं कौरवेयाणां द्रौणेर्लक्षणमुच्छ्रितम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2161140, "chapter_id": 4487, "verse_number": "१२", "content_sanskrit": "हस्तकाक्या पुनर्हैमी बभूवाधिरथेर्ध्वजः ।\nखं चाहवे महाराज ददृशे पूरयन्निव\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2161141, "chapter_id": 4487, "verse_number": "१३", "content_sanskrit": "पताकी काञ्चनः स्रग्वी ध्वजः कर्णस्य संयुगे ।\nनृत्यतीव रथोपस्थे श्वसनेन समीरितः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2161142, "chapter_id": 4487, "verse_number": "१४", "content_sanskrit": "आचार्यस्य च पाण्डूनां ब्राह्मणस्य यशस्विनः ।\nगोवृषो गौतमस्यासीत् कृपस्य च परिष्कृतः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2161143, "chapter_id": 4487, "verse_number": "१५", "content_sanskrit": "स तेन भ्राजते राजन् गोवृषेण महारथः ।\nत्रिपुरघ्नरथो यद्वद् गोवृषेण विराजता\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2161144, "chapter_id": 4487, "verse_number": "१६", "content_sanskrit": "मयूरो वृषसेनस्य काञ्चनो मणिरत्नवान् ।\nव्याहरन्निव चातिष्ठत् सेनाग्रमभिशोभयन्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2161145, "chapter_id": 4487, "verse_number": "१७", "content_sanskrit": "तेन तस्य रथो भाति मयूरेण महात्मनः ।\nयथा स्कन्दरथो राजन् मयूरेण विराजता\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2161146, "chapter_id": 4487, "verse_number": "१८", "content_sanskrit": "मद्रराजस्य शल्यस्य ध्वजाग्रेऽग्निशिखामिव ।\nसौवर्णीं प्रत्यपश्याम सीतामप्रतिमां शुभाम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2161147, "chapter_id": 4487, "verse_number": "१९", "content_sanskrit": "सा सीता भ्राजते तस्य रथमास्थाय मारिष ।\nसर्वबीजविरूढेव यथा सीता श्रिया वृता\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2161148, "chapter_id": 4487, "verse_number": "२०", "content_sanskrit": "वराहः सिन्धुराजस्य राजतोऽभिविराजते ।\nध्वजाग्रे लोहितार्काभो हेमजालपरिष्कृतः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2161149, "chapter_id": 4487, "verse_number": "२१", "content_sanskrit": "शुशुभे केतुना तेन राजतेन जयद्रथः ।\nयथा दैवासुरे युद्धे पुरा पूषा स्म शोभते \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2161150, "chapter_id": 4487, "verse_number": "२२", "content_sanskrit": "सौमदत्तेः पुनर्यूपो यज्ञशीलस्य धीमतः ।\nध्वजः सूर्य इवाभाति रथे चात्र प्रदृश्यते\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2161151, "chapter_id": 4487, "verse_number": "२३", "content_sanskrit": "स यूपः काञ्चनो राजन् सौमदत्तेर्विराजते ।\nराजसूये मखश्रेष्ठे यथा यूपः समुच्छ्रितः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2161152, "chapter_id": 4487, "verse_number": "२४", "content_sanskrit": "शल्यस्य तु महाराज राजते द्विरदो महान् ।\nकेतनः काञ्चनस्तत्र मयूखैरिव शोभितः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2161153, "chapter_id": 4487, "verse_number": "२५", "content_sanskrit": "स ध्वजोऽशोभयत् सैन्यं तावकं भरतर्षभ ।\nयथा श्वेतो महानागो देवराजचमूं तथा\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2161154, "chapter_id": 4487, "verse_number": "२६", "content_sanskrit": "नागो मणिमयो राज्ञो ध्वजः केतनसंवृतः ।\nकिङ्किणीशतनिर्ह्रादो भ्राजञ्जैत्रे रथोत्तमे\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2161155, "chapter_id": 4487, "verse_number": "२७", "content_sanskrit": "व्यभ्राजत भृशं राजन् पुत्रस्तव विशांपते ।\nध्वजेन महता सङ्खे कुरूणामृषभस्तदा\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2161156, "chapter_id": 4487, "verse_number": "२८", "content_sanskrit": "नवैते तव वाहिन्यामुच्छ्रिताः परमध्वजाः ।\nव्यदीपयंस्ते पृतनां युगान्तादित्यसन्निभाः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2161157, "chapter_id": 4487, "verse_number": "२९", "content_sanskrit": "दशमस्त्वर्जुनस्यासीदेक एव महाकपिः ।\nअदीव्यदर्जुनस्तेन हिमवानिव शम्भुना\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2161158, "chapter_id": 4487, "verse_number": "३०", "content_sanskrit": "ततश्चित्राणि शुभ्राणि सुमहान्ति महारथाः ।\nकार्मुकाण्याददुस्तूर्णमर्जुनार्थं परन्तपाः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2161159, "chapter_id": 4487, "verse_number": "३१", "content_sanskrit": "तथैव धनुरायच्छत् पार्थः शत्रुविनाशनम् ।\nगाण्डीवं दिव्यकर्माणं राजन् दुर्मन्त्रिते तव\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2161160, "chapter_id": 4487, "verse_number": "३२", "content_sanskrit": "तवापराधाद् राजेन्द्र बहुधा निहता युधि ।\nनानादिग्भ्यः समाहूताः सहयाः सरथद्विपाः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2161161, "chapter_id": 4487, "verse_number": "३३", "content_sanskrit": "तेषामासीद् व्यतिक्षेपो गर्जतामितरेतरम् ।\nदुर्योधनमुखानां च पाण्डूनामृषभस्य च\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2161162, "chapter_id": 4487, "verse_number": "३४", "content_sanskrit": "तत्राद्भुतं परं चक्रे कौन्तेयः कृष्णसारथिः ।\nयदेको बहुभिः सार्धं समागच्छदभीतवत्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2161163, "chapter_id": 4487, "verse_number": "३५", "content_sanskrit": "अशोभत महाबाहुर्गाण्डीवं विक्षिपन् धनुः ।\nजिगीषुस्तान् रथश्रेष्ठान् जिघांसुश्च जयद्रथम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2161164, "chapter_id": 4487, "verse_number": "३६", "content_sanskrit": "ततोऽर्जुनो महाराज शरैर्मुक्तैः सहस्रशः ।\nअदृश्यानकरोद् योधांस्तावकान् शत्रुतापनः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2161165, "chapter_id": 4487, "verse_number": "३७", "content_sanskrit": "ततस्तेऽपि नरव्याघ्राः सर्वे पार्थं महारथाः ।\nअदृश्यं समरे चक्रुः सायकौघैः समन्ततः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2161166, "chapter_id": 4487, "verse_number": "३८", "content_sanskrit": "संवृते नरसिंहे तैः कुरूणामृषभेऽर्जुने ।\nमहानासीत् समुद्धूतः तस्य सैन्यस्य निस्वनः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2161167, "chapter_id": 4487, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि द्विनवतितमोऽध्यायः ॥ ९२ ॥\nजयद्रथवधपर्वणि पञ्चदशोऽध्यायः ॥ १५ ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]