[{"id": 2091239, "chapter_id": 2938, "verse_number": "१३-६८-१", "content_sanskrit": "युधिष्ठिर उवाच।\nकिं राज्ञः सर्वकृत्यानां गरीयः स्यात्पितामह।\nकुर्वन्किं कर्म नृपतिरुभौ लोकौ समश्रुते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2091240, "chapter_id": 2938, "verse_number": "१३-६८-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2091241, "chapter_id": 2938, "verse_number": "१३-६८-२", "content_sanskrit": "एतद्राज्ञः कृत्यतममभिषिक्तस्य भारत।\nब्राह्मणानां रक्षणं च पूजा च सुखमिच्छतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2091242, "chapter_id": 2938, "verse_number": "१३-६८-३", "content_sanskrit": "कर्तव्यं पार्थिवेन्द्रेण तथैव भरतर्षभ।\nश्रोत्रियान्ब्राह्मणान्वृद्धान्नित्यमेवाभिपूजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2091243, "chapter_id": 2938, "verse_number": "१३-६८-४", "content_sanskrit": "पौरजानपदांश्चापि ब्राह्मणांश्च बहुश्रुतान्।\nसांत्वेन भोगदानेन नमस्कारैः सदाऽर्चयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2091244, "chapter_id": 2938, "verse_number": "१३-६८-५", "content_sanskrit": "एतत्कृत्यतमं राज्ञो नित्यमेवोपलक्षयेत्।\nयथाऽऽत्मानं यथा पुत्रांस्तथैतान्प्रतिपालयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2091245, "chapter_id": 2938, "verse_number": "१३-६८-६", "content_sanskrit": "ये चाप्येषां पूज्यतमास्तान्दृढं प्रतिपूजयेत्।\nतेषु शान्तेषु तद्राष्ट्रं सर्वमेव विराजते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2091246, "chapter_id": 2938, "verse_number": "१३-६८-७", "content_sanskrit": "ते पूज्यास्ते नमस्कार्या मान्यास्ते पितरो यथा।\nतेष्वेव यात्रा लोकानां भूतानामिव वासवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2091247, "chapter_id": 2938, "verse_number": "१३-६८-८", "content_sanskrit": "अभिचारैरुपायैश्च दहेयुरपि चेतसा।\nनिःशेपं कुपिताः कुर्युरुग्राः सत्यपराक्रमाः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2091248, "chapter_id": 2938, "verse_number": "१३-६८-९", "content_sanskrit": "नान्तमेषां प्रपश्यामि न दिशश्चाप्यपावृताः।\nकुपिताः समुदीक्षन्ते दावेषअवग्निशिखा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2091249, "chapter_id": 2938, "verse_number": "१३-६८-१०", "content_sanskrit": "`मान्यास्तेषां साधवो ये न निन्द्याश्चाप्यसाधवः।\nबिभ्यत्येषां साहसिका गुणास्तेषामतीव हि।\nकूपा इव तृणच्छन्ना विशुद्धा द्यौरिवापरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2091250, "chapter_id": 2938, "verse_number": "१३-६८-११", "content_sanskrit": "प्रसह्यकारिणः केचित्कार्पासमृदवोऽपरे।\nसन्ति चैषामतिशठास्तथैवान्ये तपस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2091251, "chapter_id": 2938, "verse_number": "१३-६८-१२", "content_sanskrit": "कृषिगोरक्ष्यमप्येके भैक्ष्यमन्येऽप्यनुष्ठिताः।\nचोराश्चान्येऽनृताश्चान्ये तथाऽन्ये नटनर्तकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2091252, "chapter_id": 2938, "verse_number": "१३-६८-१३", "content_sanskrit": "सर्वकर्मसहाश्चान्ये पार्थिवेष्वितरेषु च।\nविविधाचारयुक्ताश्च ब्राह्मणा भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2091253, "chapter_id": 2938, "verse_number": "१३-६८-१४", "content_sanskrit": "नानाकर्मसु रक्तानां बहुकर्मोपजीविनाम्।\nधर्मज्ञानां सतां तेषां नित्यमवोनुकीर्तयेत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2091254, "chapter_id": 2938, "verse_number": "१३-६८-१५", "content_sanskrit": "पितॄणां देवतानं च मनुष्योरगरक्षसाम्।\nपुराऽप्येते महाभागा ब्राह्मणा वै जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2091255, "chapter_id": 2938, "verse_number": "१३-६८-१६", "content_sanskrit": "नैते देवैर्न पितृभिर्न गन्धर्वैर्न राक्षसैः।\nनासुरैर्न पिशाचैश्च शक्या जेतुं द्विजातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2091256, "chapter_id": 2938, "verse_number": "१३-६८-१७", "content_sanskrit": "अदैवं दैवतं कुर्युर्दैवतं चाप्यदैवतम्।\nयमिच्छेयुः स राजा स्याद्यं द्विष्युः स पराभवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2091257, "chapter_id": 2938, "verse_number": "१३-६८-१८", "content_sanskrit": "परिवादं च ये कुर्युर्ब्राह्मणानामचेतसः।\nसत्यं ब्रवीमि ते राजन्विनश्येयुर्न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2091258, "chapter_id": 2938, "verse_number": "१३-६८-१९", "content_sanskrit": "निन्दाप्रशंसाकुशलाः कीर्त्यकीर्तिपरायणाः।\nपरिकुप्यन्ति ते राजन्सततं द्विषतां द्विजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2091259, "chapter_id": 2938, "verse_number": "१३-६८-२०", "content_sanskrit": "ब्राह्मणा यं प्रशंसन्ति पुरुषः स प्रवर्धते।\nब्राह्मणैर्यः पराकृष्टः पराभूयात्क्षणाद्धि सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2091260, "chapter_id": 2938, "verse_number": "१३-६८-२१", "content_sanskrit": "शका यवनकाम्भोजास्तास्ताः क्षत्रियजातयः।\nवृषलत्वं परिगता ब्राह्मणानामदर्शनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2091261, "chapter_id": 2938, "verse_number": "१३-६८-२२", "content_sanskrit": "द्राविडाश्च कलिङ्गाश्च पुलिन्दाश्चाप्युशीनराः।\nकोलिसर्पा महिपकास्तास्ताः क्षत्रियजातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2091262, "chapter_id": 2938, "verse_number": "१३-६८-२३", "content_sanskrit": "वृपलत्वं परिगता ब्राह्मणानामदर्शनात्।\nश्रेयान्पराजयस्तेभ्यो न जयो जयतांवर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2091263, "chapter_id": 2938, "verse_number": "१३-६८-२४", "content_sanskrit": "यस्तु सर्वमिदं हन्याद्ब्राह्मणं च न तत्समम्।\nब्रह्मवध्या महान्दोष इत्याहुः परमर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2091264, "chapter_id": 2938, "verse_number": "१३-६८-२५", "content_sanskrit": "परिवादो द्विजातीनां न श्रोतव्यः कथञ्चन।\nआसीताधोमुखस्तूष्णीं समुत्थाय व्रजेत वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2091265, "chapter_id": 2938, "verse_number": "१३-६८-२६", "content_sanskrit": "न स जातो जनिष्यो वा पृथिव्यामिह कश्चन।\nयो ब्राह्मणविरोधेन सुखं जीवितुमुत्सहेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2091266, "chapter_id": 2938, "verse_number": "१३-६८-२७", "content_sanskrit": "दुर्ग्राह्यो मुष्टिना वायुर्दुःस्पर्शः पाणिना शशी।\nदुर्धरा पृथिवी मूर्ध्ना दुर्जया ब्राह्मणा भुवि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2091267, "chapter_id": 2938, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि अष्टषष्टितमोऽध्यायः॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]