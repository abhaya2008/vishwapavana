[
  {
    "id": 16706001,
    "chapter_id": 6106,
    "verse_number": "1.1",
    "content_sanskrit": "ईशा वास्यमिदं सर्वं यत्किंच जगत्यां जगत् ।\nतेन त्यक्तेन भुञ्जीथा मा गृधः कस्य स्विद्धनम् ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "base_unit_id": "IS_C01_V01"
  },
  {
    "id": 16706002,
    "chapter_id": 6106,
    "verse_number": "1.2",
    "content_sanskrit": "कुर्वन्नेवेह कर्माणि जिजीविषेच्छतं समाः ।\nएवं त्वयि नान्यथेतोऽस्ति न कर्म लिप्यते नरे ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "base_unit_id": "IS_C01_V02"
  },
  {
    "id": 16706003,
    "chapter_id": 6106,
    "verse_number": "1.3",
    "content_sanskrit": "असुर्या नाम ते लोका अन्धेन तमसा वृताः ।\nतांस्ते प्रेत्याभिगच्छन्ति ये के चात्महनो जनाः ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "base_unit_id": "IS_C01_V03"
  },
  {
    "id": 16706004,
    "chapter_id": 6106,
    "verse_number": "1.4",
    "content_sanskrit": "अनेजदेकं मनसो जवीयो नैनद्देवा आप्नुवन्पूर्वमर्षत् ।\nतद्धावतोऽन्यानत्येति तिष्ठत्तस्मिन्नपो मातरिश्वा दधाति ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "base_unit_id": "IS_C01_V04"
  },
  {
    "id": 16706005,
    "chapter_id": 6106,
    "verse_number": "1.5",
    "content_sanskrit": "तदेजति तन्नैजति तद्दूरे तद्वन्तिके ।\nतदन्तरस्य सर्वस्य तदु सर्वस्यास्य बाह्यतः ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "base_unit_id": "IS_C01_V05"
  },
  {
    "id": 16706006,
    "chapter_id": 6106,
    "verse_number": "1.6",
    "content_sanskrit": "यस्तु सर्वाणि भूतानि आत्मन्येवानुपश्यति ।\nसर्वभूतेषु चात्मानं ततो न विजुगुप्सते ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "base_unit_id": "IS_C01_V06"
  },
  {
    "id": 16706007,
    "chapter_id": 6106,
    "verse_number": "1.7",
    "content_sanskrit": "यस्मिन्सर्वाणि भूतानि आत्मैवाभूद्विजानतः ।\nतत्र को मोहः कः शोक एकत्वमनुपश्यतः ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "base_unit_id": "IS_C01_V07"
  },
  {
    "id": 16706008,
    "chapter_id": 6106,
    "verse_number": "1.8",
    "content_sanskrit": "स पर्यगाच्छुक्रमकायमव्रणमस्नाविरं शुद्धमपापविद्धम् ।\nकविर्मनीषी परिभूः स्वयम्भूर्याथातथ्यतोऽर्थान्व्यदधाच्छाश्वतीभ्यः समाभ्यः ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "base_unit_id": "IS_C01_V08"
  },
  {
    "id": 16706009,
    "chapter_id": 6106,
    "verse_number": "1.9",
    "content_sanskrit": "अन्धं तमः प्रविशन्ति ये अविद्यामुपासते ।\nततो भूय इव ते तमो य उ विद्यायां रताः ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "base_unit_id": "IS_C01_V09"
  },
  {
    "id": 16706010,
    "chapter_id": 6106,
    "verse_number": "1.10",
    "content_sanskrit": "अन्यदेवाहुर्विद्यया अन्यदाहुरविद्यया ।\nइति शुश्रुम धीराणां ये नस्तद्विचचक्षिरे ॥ १० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "base_unit_id": "IS_C01_V10"
  },
  {
    "id": 16706011,
    "chapter_id": 6106,
    "verse_number": "1.11",
    "content_sanskrit": "विद्यां चाविद्यां च यस्तद्वेदोभयं सह ।\nअविद्यया मृत्युं तीर्त्वा विद्ययामृतमश्नुते ॥ ११ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "base_unit_id": "IS_C01_V11"
  },
  {
    "id": 16706012,
    "chapter_id": 6106,
    "verse_number": "1.12",
    "content_sanskrit": "अन्धं तमः प्रविशन्ति येऽसम्भूतिमुपासते ।\nततो भूय इव ते तमो य उ सम्भूत्यां रताः ॥ १२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "base_unit_id": "IS_C01_V12"
  },
  {
    "id": 16706013,
    "chapter_id": 6106,
    "verse_number": "1.13",
    "content_sanskrit": "अन्यदेवाहुः सम्भवादन्यदाहुरसम्भवात् ।\nइति शुश्रुम धीराणां ये नस्तद्विचचक्षिरे ॥ १३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "base_unit_id": "IS_C01_V13"
  },
  {
    "id": 16706014,
    "chapter_id": 6106,
    "verse_number": "1.14",
    "content_sanskrit": "सम्भूतिं च विनाशं च यस्तद्वेदोभयं सह ।\nविनाशेन मृत्युं तीर्त्वा सम्भूत्यामृतमश्नुते ॥ १४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "base_unit_id": "IS_C01_V14"
  },
  {
    "id": 16706015,
    "chapter_id": 6106,
    "verse_number": "1.15",
    "content_sanskrit": "हिरण्मयेन पात्रेण सत्यस्यापिहितं मुखम् ।\nतत्त्वं पूषन्नपावृणु सत्यधर्माय दृष्टये ॥ १५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "base_unit_id": "IS_C01_V15"
  },
  {
    "id": 16706016,
    "chapter_id": 6106,
    "verse_number": "1.16",
    "content_sanskrit": "पूषन्नेकर्षे यम सूर्य प्राजापत्य व्यूह\nरश्मीन्समूह तेजो यत्ते रूपं कल्याणतमं\nतत्ते पश्यामि योऽसावसौ पुरुषः सोऽहमस्मि ॥ १६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "base_unit_id": "IS_C01_V16"
  },
  {
    "id": 16706017,
    "chapter_id": 6106,
    "verse_number": "1.17",
    "content_sanskrit": "वायुरनिलममृतमथेदं भस्मान्तं शरीरम् ।\nओं क्रतो स्मर कृतं स्मर क्रतो स्मर कृतं स्मर ॥ १७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "base_unit_id": "IS_C01_V17"
  },
  {
    "id": 16706018,
    "chapter_id": 6106,
    "verse_number": "1.18",
    "content_sanskrit": "अग्ने नय सुपथा राये अस्मान्विश्वानि देव वयुनानि विद्वान् ।\nयुयोध्यस्मज्जुहुराणमेनो भूयिष्ठां ते नमउक्तिं विधेम ॥ १८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "base_unit_id": "IS_C01_V18"
  }
]