[{"id": 2056335, "chapter_id": 2227, "verse_number": "७-१५४-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2056336, "chapter_id": 2227, "verse_number": "७-१५४-१", "content_sanskrit": "तदुदीर्णं रथाश्वौघं बलं तव जनाधिप।\nपाण्डुसेनामतिक्रम्य योधयामास सर्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2056337, "chapter_id": 2227, "verse_number": "७-१५४-२", "content_sanskrit": "पाञ्चालाः कुरवश्चैव योधयन्तः परस्परम्।\nयमराष्ट्राय महते परलोकाय दीक्षिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2056338, "chapter_id": 2227, "verse_number": "७-१५४-३", "content_sanskrit": "शूराः शूरैः समागम्य शरतोमरशक्तिभिः।\nविव्यधुः समरेऽन्योन्यं निन्युश्चैव यमक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2056339, "chapter_id": 2227, "verse_number": "७-१५४-४", "content_sanskrit": "रथिनां रथिभिः सार्धं रुधिरस्रावदारुणम्।\nप्रावर्तत महद्युद्धं निघ्नतामितरेतरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2056340, "chapter_id": 2227, "verse_number": "७-१५४-५", "content_sanskrit": "वारणाश्च महाराज समासाद्य परस्परम्।\nविषाणैर्दारयामासुः सुसङ्क्रुद्धा मदोत्कटाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2056341, "chapter_id": 2227, "verse_number": "७-१५४-६", "content_sanskrit": "हयारोहान्हयारोहाः प्रासशक्तिपरश्वथैः।\nबिभिदुस्तुमुले युद्धे प्रार्थयन्तो महद्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2056342, "chapter_id": 2227, "verse_number": "७-१५४-७", "content_sanskrit": "पत्तयश्च महाबाहो शतशः शस्त्रपाणयः।\nअन्योन्यमार्दयन्राजन्नित्यं यत्ताः पराक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2056343, "chapter_id": 2227, "verse_number": "७-१५४-८", "content_sanskrit": "गोत्राणां नामधेयानां कुलानां चैव मारिष।\nश्रवणाद्धि विजानीमः पाञ्चालान्कुरुभिः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2056344, "chapter_id": 2227, "verse_number": "७-१५४-९", "content_sanskrit": "तेऽन्योन्यं समरे योधाः शरशक्तिपरश्वथैः।\nप्रैषयन्परलोकाय विचरन्तो ह्यभीतवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2056345, "chapter_id": 2227, "verse_number": "७-१५४-१०", "content_sanskrit": "शरैर्दश दिशो राजंस्तेषां मुक्तैः सहस्रशः।\nन भ्राजन्ते यथा पूर्वं भास्करस्य च नाशनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2056346, "chapter_id": 2227, "verse_number": "७-१५४-११", "content_sanskrit": "तथा प्रयुध्यमानेषु पाण्डवेयेषु भारत।\nदुर्योधनो महाराज व्यवागाहत तद्बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2056347, "chapter_id": 2227, "verse_number": "७-१५४-१२", "content_sanskrit": "सैन्धवस्य वधेनैव भृशं दुःखसमन्वितः।\nमर्तव्यमिति संचिन्त्य प्राविशच्च द्विषद्बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2056348, "chapter_id": 2227, "verse_number": "७-१५४-१३", "content_sanskrit": "नादयन्रथघोषेण कम्पयन्निव मेदिनीम्।\nअभ्यवर्तत पुत्रस्ते पाण्डवानामनीकिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2056349, "chapter_id": 2227, "verse_number": "७-१५४-१४", "content_sanskrit": "स सन्निपातस्तुमुलस्तस्य तेषां च भारत।\nअभवत्सर्वसैन्यानामभावकरमो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2056350, "chapter_id": 2227, "verse_number": "७-१५४-१५x", "content_sanskrit": "`धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2056351, "chapter_id": 2227, "verse_number": "७-१५४-१५", "content_sanskrit": "तथा हतेषु सैन्येषु तथा कृच्छ्रगतः स्वयम्।\nकच्चिद्दुर्योधनः सूत नाकार्षीत्पृष्ठतो रणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2056352, "chapter_id": 2227, "verse_number": "७-१५४-१६", "content_sanskrit": "एकस्य च बहुनां च सन्निपातो महानभूत्।\nविशेषतो हि नृपतेर्विषमं प्रतिभाति मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2056353, "chapter_id": 2227, "verse_number": "७-१५४-१७", "content_sanskrit": "सोऽत्यन्तसुखसंवृद्धो रक्ष्यो लोकस्य चेश्वरः।\nएको बहून्समासाद्य कच्चिन्नासीत्पराङ्मुखः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2056354, "chapter_id": 2227, "verse_number": "७-१५४-१८", "content_sanskrit": "द्रोणः कर्णः कृपश्चैव कृतवर्मा च सात्वतः।\nनावारयन्कथं युद्धे राजानं राज्यकाङ्क्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2056355, "chapter_id": 2227, "verse_number": "७-१५४-१९", "content_sanskrit": "सर्वोपायैर्हि युद्धेषु रक्षितव्यो महीपतिः।\nएषा नीतिः परा युद्धे दृष्टा तत्र मनीषिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2056356, "chapter_id": 2227, "verse_number": "७-१५४-२०", "content_sanskrit": "प्रविष्टे वै मम सुते परेषां वै महद्बलम्।\nमामका रथिनां श्रेष्ठाः किमकुर्वत स़ञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2056357, "chapter_id": 2227, "verse_number": "७-१५४-२१x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2056358, "chapter_id": 2227, "verse_number": "७-१५४-२१", "content_sanskrit": "राजन्सङ्ग्राममाश्चर्यं पुत्रस्य तव भारत।\nएकस्य च बहूनां च शृणु मे ब्रुवतो ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2056359, "chapter_id": 2227, "verse_number": "७-१५४-२२", "content_sanskrit": "द्रोणेन वार्यमाणोऽसौ कर्णेन च कृपेण च।\nप्राविशत्पाण्डवीं सेनां मकरः सागरं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2056360, "chapter_id": 2227, "verse_number": "७-१५४-२३", "content_sanskrit": "किरन्निषुसहस्राणि तत्रतत्र तथातथा।\nपाञ्चालान्पाण्डवांश्चैव विव्याध निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2056361, "chapter_id": 2227, "verse_number": "७-१५४-२४", "content_sanskrit": "यथोदयगतः सूर्यो रश्मिभिर्नाशयेत्तमः।\nतथा पुत्रस्तव बलं नाशयत्तन्महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2056362, "chapter_id": 2227, "verse_number": "७-१५४-२५", "content_sanskrit": "यथा मध्यन्दिने सूर्यं प्रतपन्तं गभस्तिभिः।\nतथा तव सुतं मध्ये प्रतपन्तं शरार्चिभिः।\nन शेकुर्भारतं युद्धे पाण्डवाः समुदीक्षितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2056363, "chapter_id": 2227, "verse_number": "७-१५४-२६", "content_sanskrit": "पलायनकृतोत्साहा निरुत्साहा द्विषज्जये।\nपर्यधावन्त पाञ्चाला वध्यमाना महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2056364, "chapter_id": 2227, "verse_number": "७-१५४-२७", "content_sanskrit": "रुक्मपुङ्खैः प्रसन्नाग्रैस्तव पुत्रेण धन्विना।\nअर्द्यमानाः शरैस्तूर्णं न्यपतन्पाण्डुसैनिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2056365, "chapter_id": 2227, "verse_number": "७-१५४-२८", "content_sanskrit": "`व्यद्रवंश्च भयाद्योधा दृष्ट्वा तं परमाहवे।\nव्यात्ताननमिव प्राप्तमन्तकं प्राणहारिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2056366, "chapter_id": 2227, "verse_number": "७-१५४-२९", "content_sanskrit": "न तादृशं रमे कर्म कृतवन्तस्तु तावकाः।\nयादृशं कृतवान्राजा पुत्रस्तव विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2056367, "chapter_id": 2227, "verse_number": "७-१५४-३०", "content_sanskrit": "पुत्रेण तव सा सेना पाण्डवी मथिता रणे।\nनलिनी द्विरदेनेव समन्तात्फुल्लपङ्कजा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2056368, "chapter_id": 2227, "verse_number": "७-१५४-३१", "content_sanskrit": "क्षीणतोयानिलार्काभ्यां हतत्विडिव पद्मिनी।\nबभूव पाण्डवी सेना तव पुत्रस्य तेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2056369, "chapter_id": 2227, "verse_number": "७-१५४-३२", "content_sanskrit": "पाण्डुसेनां हतां दृष्ट्वा तव पुत्रेण भारत।\nभीमसेनपुरोगास्तु पाञ्चालाः समुपाद्रवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2056370, "chapter_id": 2227, "verse_number": "७-१५४-३३", "content_sanskrit": "स भीमसेनं दशभिर्माद्रीपुत्रौ त्रिभिस्त्रिभिः।\nविराटद्रुपदौ षड्भिः शतेन च शिखण्डिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2056371, "chapter_id": 2227, "verse_number": "७-१५४-३४", "content_sanskrit": "धृष्टद्युम्नं च सप्तत्या धर्मपुत्रं च सप्तभिः।\nकेकयांश्चैव चेदींश्च बहुभिर्निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2056372, "chapter_id": 2227, "verse_number": "७-१५४-३५", "content_sanskrit": "सात्वतं पञ्चभिर्विद्धा द्रौपदेयांस्त्रिभिस्त्रिभिः।\nघटोत्कचं च समरे विद्ध्वा सिंह इवानदत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2056373, "chapter_id": 2227, "verse_number": "७-१५४-३६", "content_sanskrit": "शतशश्चापरान्योधान्सद्विपांश्च महारणे।\nशरैरवचकर्तोग्रैः क्रुद्धोऽन्तक इव प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2056374, "chapter_id": 2227, "verse_number": "७-१५४-३७", "content_sanskrit": "सा तेन पाण्डवी सेना वध्यमाना शिलीमुखैः।\nतव पुत्रेण सङ्ग्रामे विदुद्राव नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2056375, "chapter_id": 2227, "verse_number": "७-१५४-३८", "content_sanskrit": "तं तपन्तमिवादित्यं कुरुराजं महाहवे।\nनाशकन्वीक्षितुं राजन्पाण्डुपुत्रस्य सैनिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2056376, "chapter_id": 2227, "verse_number": "७-१५४-३९", "content_sanskrit": "ततो युधिष्ठिरो राजा कुपितो राजसत्तम।\nअभ्यधावत्कुरुपतिं तव पुत्रं जिघांसया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2056377, "chapter_id": 2227, "verse_number": "७-१५४-४०", "content_sanskrit": "तावुभौ युधि कौरव्यौ समीयतुररिन्दमौ।\nस्वार्थहेतोः पराक्रान्तौ दुर्योधनयुधिष्ठिरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2056378, "chapter_id": 2227, "verse_number": "७-१५४-४१", "content_sanskrit": "ततो दुर्योधनः क्रुद्धः शरैः सन्नतपर्वभिः।\nविव्याध दशभिस्तूर्णं ध्वजं चिच्छेद चेषुणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2056379, "chapter_id": 2227, "verse_number": "७-१५४-४२", "content_sanskrit": "इन्द्रसेनं त्रिभिश्चैव ललाटे जघ्निवान्नृप।\nसारथिं दयितं राज्ञः पाण्डवस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2056380, "chapter_id": 2227, "verse_number": "७-१५४-४३", "content_sanskrit": "धनुश्च पुनरन्येन चकर्तास्य महारथः।\nचतुर्भिश्चतुरश्चैव बाणैर्विव्याध वाजिनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2056381, "chapter_id": 2227, "verse_number": "७-१५४-४४", "content_sanskrit": "ततो युधिष्ठिरः क्रुद्धो निमेषादिव कार्मुकम्।\nअन्यदादाय वेगेन कौरवं प्रत्यवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2056382, "chapter_id": 2227, "verse_number": "७-१५४-४५", "content_sanskrit": "तस्य तान्निघ्नतः शत्रून्रुक्मपृष्ठं महद्धनुः।\nभल्लाभ्यां पण्डवो ज्येष्ठस्त्रिधा चिच्छेद मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2056383, "chapter_id": 2227, "verse_number": "७-१५४-४६", "content_sanskrit": "विव्याध चैनं दशभिः सम्यगस्तैः शितैः शरैः।\nमर्म भित्त्वा तु ते सर्वे संलग्नाः क्षितिमाविशन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2056384, "chapter_id": 2227, "verse_number": "७-१५४-४७", "content_sanskrit": "ततः परिवृता योधाः परिवव्रुर्युधिष्ठिरम्।\nवृत्रेण सह युध्यन्तं यद्वद्देवाः शतक्रतुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2056385, "chapter_id": 2227, "verse_number": "७-१५४-४८", "content_sanskrit": "ततो युधिष्ठिरो राजा तव पुत्रस्य मारिष।\nशरं च सूर्यरश्म्याभमत्युग्रमनिवारणम्।\nहा हतोऽसीति राजानमुक्त्वाऽमुञ्चद्युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2056386, "chapter_id": 2227, "verse_number": "७-१५४-४९", "content_sanskrit": "स तेनाकर्णमुक्तेन विद्धो बाणेन कौरवः।\nनिषसाद रथोपस्थे भृशं सम्मूढचेतनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2056387, "chapter_id": 2227, "verse_number": "७-१५४-५०", "content_sanskrit": "ततः पाञ्चाल्यसेनानां भृशमासीद्रवो महान्।\nहतो राजेति राजेन्द्र मुदितानां समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2056388, "chapter_id": 2227, "verse_number": "७-१५४-५१", "content_sanskrit": "बाणशब्दरवश्चोग्रः शुश्रुवे तत्र मारिष।\nअथ द्रोणो द्रुतं तत्र प्रत्यदृश्यत संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2056389, "chapter_id": 2227, "verse_number": "७-१५४-५२", "content_sanskrit": "हृष्टो दुर्योधनश्चापि दृढमादाय कार्मुकम्।\nतिष्ठतिष्ठेति राजानं ब्रुवन्पाण्डवमभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2056390, "chapter_id": 2227, "verse_number": "७-१५४-५३", "content_sanskrit": "प्रत्युद्ययुस्तं त्वरिताः पाञ्चाला जयगृद्धिनः।\nतान्द्रोणः प्रतिजग्राह परीप्सन्कुरुसत्तमम्।\nचण्डवातः समुद्वूतो मेघानम्बुमुचो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2056391, "chapter_id": 2227, "verse_number": "७-१५४-५४", "content_sanskrit": "ततो राजन्महानासीत्सङ्ग्रामो भूरिवर्धनः।\nतावकानां परेषां च समेतानां युयुत्सया॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2056392, "chapter_id": 2227, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि घटोत्कचवधपर्वणि चतुर्दशरात्रियुद्धे चतुःपञ्चाशदधिकशततमोऽध्यायः॥ १५४ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१५४-८ गोत्रं पित्रादि नाम शैनेय सात्यके इत्यादि। कुलं पाण्ड्यपाञ्चाल्येत्यादि॥ ५-१५४-४६ सम्यगस्तैः दृढं प्रक्षिप्तैः॥ ५-१५४-५१ बाणशब्दरवो बाणशब्दसहितो रवः प्राणिशब्दः॥ ५-१५४-५४ भूरिवर्धनो बहुच्छेदनः॥ ५-१५४-१५४ चतुःपञ्चाशदधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]