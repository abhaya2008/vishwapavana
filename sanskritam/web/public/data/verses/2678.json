[{"id": 2078980, "chapter_id": 2678, "verse_number": "१२-१८३-०x", "content_sanskrit": "भरद्वाज उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2078981, "chapter_id": 2678, "verse_number": "१२-१८३-१", "content_sanskrit": "पार्थिवं धातुमाश्रित्य शारीरोऽग्निः कथं भवेत्।\nअवकाशविशेषेण कथं वर्तयतेऽनिलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2078982, "chapter_id": 2678, "verse_number": "१२-१८३-२x", "content_sanskrit": "भृगुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2078983, "chapter_id": 2678, "verse_number": "१२-१८३-२", "content_sanskrit": "वायोर्गतिमहं ब्रह्मन्कीर्तयिष्यामि तेऽनघ।\nप्राणिनामनिलो देहान्यथा चेष्टयते बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2078984, "chapter_id": 2678, "verse_number": "१२-१८३-३", "content_sanskrit": "श्रितो मूर्धानमग्निस्तु शरीरं परिपालयन्।\nप्राणो मूर्धनि चाग्नौ च वर्तमानो विचेष्टने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2078985, "chapter_id": 2678, "verse_number": "१२-१८३-४", "content_sanskrit": "स जन्तुः सर्वभूतात्मा पुरुषः स सनातनः।\nमनो बुद्धिरहंकारो भूतानि विषयाश्च सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2078986, "chapter_id": 2678, "verse_number": "१२-१८३-५", "content_sanskrit": "एवं त्विह स सर्वत्र प्राणेन परिपाल्यते।\nकोष्ठतस्तु समानेन स्वां स्वां गतिमुपाश्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2078987, "chapter_id": 2678, "verse_number": "१२-१८३-६", "content_sanskrit": "वस्तिमूलं गुदं चैव पावकं समुपाश्रितः।\nवहन्मूत्रं पुरीषं चाप्यपानः परिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2078988, "chapter_id": 2678, "verse_number": "१२-१८३-७", "content_sanskrit": "प्रयत्ने कर्मणि बले य एकस्त्रिषु वर्तते।\nउदान इति तं प्राहुरध्यात्मकुशला जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2078989, "chapter_id": 2678, "verse_number": "१२-१८३-८", "content_sanskrit": "संधिष्वपि च सर्वेषु सन्निविष्टस्तथाऽनिलः।\nशरीरेषु मनुष्याणां व्यान इत्युपदिश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2078990, "chapter_id": 2678, "verse_number": "१२-१८३-९", "content_sanskrit": "धातुष्वग्निस्तु विततः समानोऽग्निः समीरितः।\nरसान्धातूंश्च दोषांश्च वर्तयन्नवतिष्ठते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2078991, "chapter_id": 2678, "verse_number": "१२-१८३-१०", "content_sanskrit": "अपानप्राणयोर्मध्ये प्राणापानसमाहितः।\nसमन्वितस्त्वधिष्ठानं सम्यक्पचति पावकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2078992, "chapter_id": 2678, "verse_number": "१२-१८३-११", "content_sanskrit": "आस्यं हि पायुसंयुक्तमन्ते स्याद्गुदसंज्ञितम्।\nस्रोतस्तस्मात्प्रजायन्ते सर्वस्रोतांसि देहिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2078993, "chapter_id": 2678, "verse_number": "१२-१८३-१२", "content_sanskrit": "प्राणानां सन्निपाताच्च सन्निपातः प्रजायते।\nऊष्मा सोग्निरिति ज्ञेयो योऽन्नं पचति देहिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2078994, "chapter_id": 2678, "verse_number": "१२-१८३-१३", "content_sanskrit": "अग्निवेगवहः प्राणो गुदान्ते प्रतिहन्यते।\nस ऊर्ध्वमागम्य पुनः समुत्क्षिपति पावकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2078995, "chapter_id": 2678, "verse_number": "१२-१८३-१४", "content_sanskrit": "पक्वाशयस्त्वधो नाभ्या ऊर्ध्वमामाशयः स्मृतः।\nनाभिमध्ये शरीरस्य सर्वे प्राणाः समाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2078996, "chapter_id": 2678, "verse_number": "१२-१८३-१५", "content_sanskrit": "प्रसृता हृदयात्सर्वास्तिर्यगूर्ध्वमधस्तथा।\nवहन्त्यन्नरसान्नाड्यो दशप्राणप्रचोदिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2078997, "chapter_id": 2678, "verse_number": "१२-१८३-१६", "content_sanskrit": "एष मार्गोऽथ योगानां येन गच्छन्ति तत्पदम्।\nजितक्लमासना धीरा सूर्धन्यात्मानमादधन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2078998, "chapter_id": 2678, "verse_number": "१२-१८३-१७", "content_sanskrit": "एवं सर्वेषु विहितः प्राणापानेषु देहिनाम्।\nतस्मिन्योऽवस्थितो नित्यमग्निः स्थाल्यामिवाहितः। ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2078999, "chapter_id": 2678, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि त्र्यशीत्यधिकशततमोऽध्यायः॥ १८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]