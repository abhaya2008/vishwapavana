[{"id": 5000037000, "chapter_id": 9037, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे सप्तत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000037001, "chapter_id": 9037, "verse_number": "१-३७-१", "content_sanskrit": "तप्यमाने तदा देवे सेन्द्राः साग्निपुरोगमाः ।\nसेनापतिमभीप्सन्तः पितामहमुपागमन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000037002, "chapter_id": 9037, "verse_number": "१-३७-२", "content_sanskrit": "ततोऽब्रुवन् सुराः सर्वे भगवन्तं पितामहम् ।\nप्रणिपत्य सुराराम सेन्द्राः साग्निपुरोगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000037003, "chapter_id": 9037, "verse_number": "१-३७-३", "content_sanskrit": "येन सेनापतिर्देव दत्तो भगवता पुरा ।\nस तपः परमास्थाय तप्यते स्म सहोमया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000037004, "chapter_id": 9037, "verse_number": "१-३७-४", "content_sanskrit": "यदत्रानन्तरं कार्यं लोकानां हितकाम्यया ।\nसंविधत्स्व विधानज्ञ त्वं हि नः परमा गतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000037005, "chapter_id": 9037, "verse_number": "१-३७-५", "content_sanskrit": "देवतानां वचः श्रुत्वा सर्वलोकपितामहः ।\nसान्त्वयन् मधुरैर्वाक्यैस्त्रिदशानिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000037006, "chapter_id": 9037, "verse_number": "१-३७-६", "content_sanskrit": "शैलपुत्र्या यदुक्तं तन्न प्रजाः स्वासु पत्निषु ।\nतस्या वचनमक्लिष्टं सत्यमेव न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000037007, "chapter_id": 9037, "verse_number": "१-३७-७", "content_sanskrit": "इयमाकाशगङ्गा च यस्यां पुत्रं हुताशनः ।\nजनयिष्यति देवानां सेनापतिमरिंदमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000037008, "chapter_id": 9037, "verse_number": "१-३७-८", "content_sanskrit": "ज्येष्ठा शैलेन्द्रदुहिता मानयिष्यति तं सुतम् ।\nउमायास्तद्बहुमतं भविष्यति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000037009, "chapter_id": 9037, "verse_number": "१-३७-९", "content_sanskrit": "तच्छ्रुत्वा वचनं तस्य कृतार्था रघुनन्दन ।\nप्रणिपत्य सुराः सर्वे पितामहमपूजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000037010, "chapter_id": 9037, "verse_number": "१-३७-१०", "content_sanskrit": "ते गत्वा परमं राम कैलासं धातुमण्डितम् ।\nअग्निं नियोजयामासुः पुत्रार्थं सर्वदेवताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000037011, "chapter_id": 9037, "verse_number": "१-३७-११", "content_sanskrit": "देवकार्यमिदं देव समाधत्स्व हुताशन ।\nशैलपुत्र्यां महातेजो गङ्गायां तेज उत्सृज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000037012, "chapter_id": 9037, "verse_number": "१-३७-१२", "content_sanskrit": "देवतानां प्रतिज्ञाय गङ्गामभ्येत्य पावकः ।\nगर्भं धारय वै देवि देवतानामिदं प्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000037013, "chapter_id": 9037, "verse_number": "१-३७-१३", "content_sanskrit": "इत्येतद् वचनं श्रुत्वा दिव्यं रूपमधारयत् ।\nस तस्या महिमां दृष्ट्वा समन्तादवशीर्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000037014, "chapter_id": 9037, "verse_number": "१-३७-१४", "content_sanskrit": "समन्ततस्तदा देवीमभ्यषिञ्चत पावकः ।\nसर्वस्रोतांसि पूर्णानि गङ्गाया रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000037015, "chapter_id": 9037, "verse_number": "१-३७-१५", "content_sanskrit": "तमुवाच ततो गङ्गा सर्वदेवपुरोगमम् ।\nअशक्ता धारणे देव तेजस्तव समुद्धतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000037016, "chapter_id": 9037, "verse_number": "१-३७-१६", "content_sanskrit": "दह्यमानाग्निना तेन सम्प्रव्यथितचेतना ।\nअथाब्रवीदिदं गङ्गां सर्वदेवहुताशनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000037017, "chapter_id": 9037, "verse_number": "१-३७-१७", "content_sanskrit": "इह हैमवते पार्श्वे गर्भोऽयं संनिवेश्यताम् ।\nश्रुत्वा त्वग्निवचो गङ्गा तं गर्भमतिभास्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000037018, "chapter_id": 9037, "verse_number": "१-३७-१८", "content_sanskrit": "उत्ससर्ज महातेजाः स्रोतोभ्यो हि तदानघ ।\nयदस्या निर्गतं तस्मात् तप्तजाम्बूनदप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000037019, "chapter_id": 9037, "verse_number": "१-३७-१९", "content_sanskrit": "काञ्चनं धरणीं प्राप्तं हिरण्यमतुलप्रभम् ।\nताम्रं कार्ष्णायसं चैव तैक्ष्ण्यादेवाभिजायत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000037020, "chapter_id": 9037, "verse_number": "१-३७-२०", "content_sanskrit": "मलं तस्याभवत् तत्र त्रपु सीसकमेव च ।\nतदेतद्धरणीं प्राप्य नानाधातुरवर्धत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000037021, "chapter_id": 9037, "verse_number": "१-३७-२१", "content_sanskrit": "निक्षिप्तमात्रे गर्भे तु तेजोभिरभिरञ्जितम् ।\nसर्वं पर्वतसंनद्धं सौवर्णमभवद् वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000037022, "chapter_id": 9037, "verse_number": "१-३७-२२", "content_sanskrit": "जातरूपमिति ख्यातं तदाप्रभृति राघव ।\nसुवर्णं पुरुषव्याघ्र हुताशनसमप्रभम् ।\nतृणवृक्षलतागुल्मं सर्वं भवति काञ्चनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000037023, "chapter_id": 9037, "verse_number": "१-३७-२३", "content_sanskrit": "तं कुमारं ततो जातं सेन्द्राः सह मरुद्गणाः ।\nक्षीरसम्भावनार्थाय कृत्तिकाः समयोजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000037024, "chapter_id": 9037, "verse_number": "१-३७-२४", "content_sanskrit": "ताः क्षीरं जातमात्रस्य कृत्वा समयमुत्तमम् ।\nददुः पुत्रोऽयमस्माकं सर्वासामिति निश्चिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000037025, "chapter_id": 9037, "verse_number": "१-३७-२५", "content_sanskrit": "ततस्तु देवताः सर्वाः कार्तिकेय इति ब्रुवन् ।\nपुत्रस्त्रैलोक्यविख्यातो भविष्यति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000037026, "chapter_id": 9037, "verse_number": "१-३७-२६", "content_sanskrit": "तेषां तद् वचनं श्रुत्वा स्कन्नं गर्भपरिस्रवे ।\nस्नापयन् परया लक्ष्म्या दीप्यमानं यथानलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000037027, "chapter_id": 9037, "verse_number": "१-३७-२७", "content_sanskrit": "स्कन्द इत्यब्रुवन् देवाः स्कन्नं गर्भपरिस्रवे ।\nकार्तिकेयं महाबाहुं काकुत्स्थ ज्वलनोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000037028, "chapter_id": 9037, "verse_number": "१-३७-२८", "content_sanskrit": "प्रादुर्भूतं ततः क्षीरं कृत्तिकानामनुत्तमम् ।\nषण्णां षडाननो भूत्वा जग्राह स्तनजं पयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000037029, "chapter_id": 9037, "verse_number": "१-३७-२९", "content_sanskrit": "गृहीत्वा क्षीरमेकाह्ना सुकुमारवपुस्तदा ।\nअजयत् स्वेन वीर्येण दैत्यसैन्यगणान् विभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000037030, "chapter_id": 9037, "verse_number": "१-३७-३०", "content_sanskrit": "सुरसेनागणपतिमभ्यषिञ्चन्महाद्युतिम् ।\nततस्तममराः सर्वे समेत्याग्निपुरोगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000037031, "chapter_id": 9037, "verse_number": "१-३७-३१", "content_sanskrit": "एष ते राम गङ्गाया विस्तरोऽभिहितो मया ।\nकुमारसम्भवश्चैव धन्यः पुण्यस्तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000037032, "chapter_id": 9037, "verse_number": "१-३७-३२", "content_sanskrit": "भक्तश्च यः कार्तिकेये काकुत्स्थ भुवि मानवः ।\nआयुष्मान् पुत्रपौत्रैश्च स्कन्दसालोक्यतां व्रजेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000037033, "chapter_id": 9037, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे सप्तत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]