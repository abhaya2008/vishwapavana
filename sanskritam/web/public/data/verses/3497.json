[{"id": 2115982, "chapter_id": 3497, "verse_number": "", "content_sanskrit": "गन्धर्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2115983, "chapter_id": 3497, "verse_number": "१", "content_sanskrit": "एवमुक्त्वा ततस्तूर्णं जगामोर्ध्वमनिन्दिता ।\nतपती तपतीत्येव विललापातुरो नृपः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2115984, "chapter_id": 3497, "verse_number": "२", "content_sanskrit": "प्रस्खलंश्चासकृद् राजा पुनरुत्थाय धावति ।\nधावमानस्तु तपतीमदृष्ट्वैव महीपते \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2115985, "chapter_id": 3497, "verse_number": "३", "content_sanskrit": "अमात्यः सानुयात्रस्तु सन्ददर्श महावने ।\nक्षितौ निपतितं काले शक्रध्वजमिवोच्छ्रितम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2115986, "chapter_id": 3497, "verse_number": "४", "content_sanskrit": "तं हि दृष्ट्वा महेष्वासं निरस्तं पतितं क्षितौ ।\nबभूव सोऽस्य सचिवः सम्प्रदीप्त इवाग्निना\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2115987, "chapter_id": 3497, "verse_number": "५", "content_sanskrit": "त्वरया चोपसङ्गृह्य स्नेहादागतसम्भ्रमः ।\nतं समुत्थापयामास नृपतिं काममोहितम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2115988, "chapter_id": 3497, "verse_number": "६", "content_sanskrit": "भूतळाद् भूमिपालेशं पितेव पतितं सुतम् ।\nप्रज्ञया तपसा चैव वृद्धः कीर्त्या दमेन च \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2115989, "chapter_id": 3497, "verse_number": "७", "content_sanskrit": "अमात्यस्तं समुत्थाप्य बभूव विगतज्वरः ।\nउवाच चैनं कल्याणं वाचा मधुरयोत्थितम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2115990, "chapter_id": 3497, "verse_number": "८", "content_sanskrit": "मा भैर्मनुजशार्दूल भद्रं चास्तु तवानघ ।\nक्षुत्पिपासाश्रमार्तं तु तर्कयामास तं नृपम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2115991, "chapter_id": 3497, "verse_number": "९", "content_sanskrit": "पतितं पातनं सङ्खे शात्रवाणां महीतळे ।\nवारिणाऽथ सुशीतेन शिरस्तस्यावसेचयत् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2115992, "chapter_id": 3497, "verse_number": "१०", "content_sanskrit": "अस्पृशन्मकुटं राज्ञः पुण्डरीकसुगन्धिना ।\nततः प्रत्यागतप्राणः तद्बलं बलवान् नृपः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2115993, "chapter_id": 3497, "verse_number": "११", "content_sanskrit": "सर्वं विसर्जयामास तमेकं सचिवं विना ।\nततस्तस्याज्ञया राज्ञो विप्रतस्थे महद्बलम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2115994, "chapter_id": 3497, "verse_number": "१२", "content_sanskrit": "स तु राजा गिरिप्रस्थे तस्मिन् पुनरुपाविशत् ।\nस तु तस्मिन् गिरिवरे शुचिर्भूत्वा कृताञ्जलिः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2115995, "chapter_id": 3497, "verse_number": "१३", "content_sanskrit": "आरिराधयिषुः सूर्यं तस्थावूर्ध्वभुजः क्षितौ ।\nजगाम मनसा चैवं वसिष्ठमृषिसत्तमम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2115996, "chapter_id": 3497, "verse_number": "१४", "content_sanskrit": "पुरोहितममित्रघ्नं तदा संवरणो नृपः ।\nनक्तन्दिनमथैकस्थे स्थिते तस्मिन् जनाधिपे \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2115997, "chapter_id": 3497, "verse_number": "१५", "content_sanskrit": "अथाजगाम विप्रर्षिस्तदा द्वादशमेऽहनि ।\nस विदित्वैव नृपतिं तपत्या क्षतमानसम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2115998, "chapter_id": 3497, "verse_number": "१६", "content_sanskrit": "दिव्येन चक्षुषा ज्ञात्वा भावितात्मा महानृषिः ।\nतथा तु नियतात्मानं तं वै नृपतिसत्तमम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2115999, "chapter_id": 3497, "verse_number": "१७", "content_sanskrit": "आबभाषे स धर्मात्मा तस्यैवार्थचिकीर्षया ।\nस तस्य मनुजेन्द्रस्य पश्यतो भगवानृषिः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2116000, "chapter_id": 3497, "verse_number": "१८", "content_sanskrit": "ऊर्ध्वमाचक्रमे द्रष्टुं भास्करं भास्करद्युतिः ।\nयोजनानां तु नियुतं क्षणाद् गत्वा तपोधनः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2116001, "chapter_id": 3497, "verse_number": "१९", "content_sanskrit": "सहस्रांशुं ततो विप्रः कृताञ्जलिरुपस्थितः ।\nवसिष्ठोऽहमिति प्रीत्या स चात्मानं न्यवेदयत् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2116002, "chapter_id": 3497, "verse_number": "२०", "content_sanskrit": "तमुवाच महातेजा विवस्वान् मुनिसत्तमम् ।\nमहर्षे स्वागतं तेऽस्तु कथयस्व यथेप्सितम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2116003, "chapter_id": 3497, "verse_number": "१७६", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nषट्सप्तत्यधिकशततमोऽध्यायः ॥१७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2116004, "chapter_id": 3497, "verse_number": "९", "content_sanskrit": "॥ इति चैत्ररथपर्वणि नवमोऽध्यायः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2116005, "chapter_id": 3497, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]