[{"id": 7001046000, "chapter_id": 21046, "verse_number": "५-२८-१", "content_sanskrit": "चारुदेष्णां सुदेष्णञ्च चारुदेवञ्च वीर्य्यवान् ।\nसुषेणं चारुगुप्तञ्च भद्रचारु तथापरम्  ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001046001, "chapter_id": 21046, "verse_number": "५-२८-२", "content_sanskrit": "चारुविन्दं सुचारुञ्च चारुञ्च बलिनां वरम् ।\nरुक्मिण्यजनयत् पुत्रान् कन्यां चारुमतीं तथा  ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001046002, "chapter_id": 21046, "verse_number": "५-२८-३", "content_sanskrit": "अन्याश्व भार्य्याः कृष्णस्य बभूवुः स्प्त शोभनाः ।\nकालिन्दी मित्रविन्दा च सत्या नाग्रजिती तथा  ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001046003, "chapter_id": 21046, "verse_number": "५-२८-४", "content_sanskrit": "देवी जाम्बवती चापि रोहिणी कामरूपिणी ।\nमद्रराजसुता चान्या सुशीला शीलभण्डना  ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001046004, "chapter_id": 21046, "verse_number": "५-२८-५", "content_sanskrit": "सात्राजिती सत्यभीमा लक्ष्णा चारुहासिनी ।\nषोड़शासन सहस्त्राणि स्त्रीणामन्यानि चक्रिणः  ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001046005, "chapter_id": 21046, "verse_number": "५-२८-६", "content_sanskrit": "प्रद्यु म्रोऽपि महावीर्य्यो रुक्मिणस्तनयां शुभाम् ।\nस्वयंवरस्थां जग्राह सा च तं तनय हरेः  ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001046006, "chapter_id": 21046, "verse_number": "५-२८-७", "content_sanskrit": "यस्यामस्याभवत् पुत्रो महाबलपराक्रमः ।\nअनिरुद्धो रणो क्रे द्धो वीर्य्योदधिररिन्दमः  ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001046007, "chapter_id": 21046, "verse_number": "५-२८-८", "content_sanskrit": "तस्यापि रुक्मिणः पौत्रीं वरयामास केशवः ।\nदौहित्राय ददौ रुक्मी तां स्पर्द्धन्नपि शौरिणा  ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001046008, "chapter_id": 21046, "verse_number": "५-२८-९", "content_sanskrit": "तस्या विवाहे रामाद्या यादवा हरिणा सह ।\nरुक्मिणो नगरं जग्मुर्नाम्रा भोजकटं द्रिज  ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001046009, "chapter_id": 21046, "verse_number": "५-२८-१०", "content_sanskrit": "विवाहे तत्र निवृत्ते प्राद्यूम्नेः सुमहात्मनः ।\nकलिङ्गराजप्रमुखा रुक्मिणां वाक्यमब्रु वन्  ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001046010, "chapter_id": 21046, "verse_number": "५-२८-११", "content_sanskrit": "अनक्षज्ञो हली द्यूते तथास्य व्यसनं महत् ।\nन जयामो बलं कस्मादू द्यूतेनैनं महाद्युते  ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001046011, "chapter_id": 21046, "verse_number": "५-२८-१२", "content_sanskrit": "तथेति तानाह नृपान् रुक्मी बलसमन्वितः ।\nसभायां सह रामेण चक्र द्रू तञ्च वै तदा  ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001046012, "chapter_id": 21046, "verse_number": "५-२८-१३", "content_sanskrit": "सहस्त्रमेकं निष्काणां रुक्मिणा विजितो बलः ।\nद्रितीयेऽपि पणे चान्यत् सहस्त्र रुक्मिणा जितम्  ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001046013, "chapter_id": 21046, "verse_number": "५-२८-१४", "content_sanskrit": "ततो दश सहस्त्राणि निष्काणां पणमाददे ।\nबलभद्रोऽजयत्तानि रुक्मी द्यूतविदां वरः  ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001046014, "chapter_id": 21046, "verse_number": "५-२८-१५", "content_sanskrit": "ततो जहास खनवत् कलिङ्गाधिपतिर्द्रिज!\nदन्तान् विदर्शयन् मूढ़ो रुक्मी चाह मदोद्धतः  ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001046015, "chapter_id": 21046, "verse_number": "५-२८-१६", "content_sanskrit": "ग्रविज्ञोऽयं मया द्यूते बलदेवः पराजितः ।\nमुधैवाक्षावलेपान्धो यः स्वं मेनेऽक्षकाविदम्  ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001046016, "chapter_id": 21046, "verse_number": "५-२८-१७", "content_sanskrit": "दृष्टा कलिङ्गराजं तं प्रकाशदशनाननम् ।\nरुक्मिणञ्चपि दुव्वक्यिं कोपं चक्र हलायुधः  ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001046017, "chapter_id": 21046, "verse_number": "५-२८-१८", "content_sanskrit": "ग्लहं जग्राह रुक्मी च तदर्थेऽक्षानपातयत्  ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001046018, "chapter_id": 21046, "verse_number": "५-२८-१९", "content_sanskrit": "अजयद् बलदेवस्तं प्राहोच्चैस्तं जितं मया ।\nमयेति रुक्मी प्राहोच्चैरलीकोक्तेरलं बल  ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001046019, "chapter_id": 21046, "verse_number": "५-२८-२०", "content_sanskrit": "त्वयोक्तोऽ.यं ग्लहः सत्यं न ममैषोऽनुमोदितः ।\nएवं त्वया चेदू विजितं मया न विजितं कथम्  ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001046020, "chapter_id": 21046, "verse_number": "५-२८-२१", "content_sanskrit": "अथान्तरिक्षे वागुच्चैः प्राह गम्भीरनादिनी ।\nबलदेवस्य तदूकोपं वर्द्धयन्ती महात्मनः  ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001046021, "chapter_id": 21046, "verse_number": "५-२८-२२", "content_sanskrit": "जितं बलेन धर्म्मेण रुक्मिणो भाषितं मृषा ।\nअनुक्त्वापि वचः किञ्चित् कृतं भवति कर्म्मा  ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001046022, "chapter_id": 21046, "verse_number": "५-२८-२३", "content_sanskrit": "ततो बलः समुत्थाय कोपसंरक्तलोचनः ।\nजघानाष्टापदेनैव रुक्मिणं सुमहाबलः  ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001046023, "chapter_id": 21046, "verse_number": "५-२८-२४", "content_sanskrit": "कलिङ्गराजञ्चादाय विस्फुरन्तं बलाद बलः ।\nवभञ्च दन्तान् कुपितो यैः प्रकाशं जहास सः  ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001046024, "chapter_id": 21046, "verse_number": "५-२८-२५", "content_sanskrit": "आकृष्य च महास्तम्भं जातरूपमयं बलः ।\nजघान येऽन्ये तत्पक्षा बूभृतः कुपितो बलात  ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001046025, "chapter_id": 21046, "verse_number": "५-२८-२६", "content_sanskrit": "ततो हाहाकृतं सर्व्वं पलायनपरं द्रिज!\nतद्राजमणडलं भीतं बभूव कुपिते बले  ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001046026, "chapter_id": 21046, "verse_number": "५-२८-२७", "content_sanskrit": "बलेन निहतं श्रुत्वा रुक्मिणं मधुसूदनः ।\nनोवाच किञ्चिन्मैत्रेय!रुक्मिणी-बलयोर्भयात्  ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]