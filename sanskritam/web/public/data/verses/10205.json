[{"id": 6000205000, "chapter_id": 10205, "verse_number": null, "content_sanskrit": "अथ नवमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000205001, "chapter_id": 10205, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.001.m4a", "display_order": 2}, {"id": 6000205002, "chapter_id": 10205, "verse_number": "१०-९-१", "content_sanskrit": "गर्गः पुरोहितो राजन् यदूनां सुमहायशाः।\nव्रजं जगाम नन्दस्य वसुदेवप्रचोदितः॥ १०/९/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.002.m4a", "display_order": 3, "topics": [{"text": "गोकुले गर्गाचार्यागमनम्", "range": "१–१२"}]}, {"id": 6000205003, "chapter_id": 10205, "verse_number": "१०-९-२", "content_sanskrit": "तं दृष्ट्वा परमप्रीतः प्रत्युत्थाय कृताञ्जलिः।\nआनर्चाधोक्षजधिया प्रणिपातपुरस्सरम्॥ १०/९/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.003.m4a", "display_order": 4}, {"id": 6000205004, "chapter_id": 10205, "verse_number": "१०-९-३", "content_sanskrit": "सूपविष्टं कृतातिथ्यं गिरा सूनृतया मुनिम्।\nनन्दयित्वाऽब्रवीद् ब्रह्मन् पूर्णस्य करवाम किम्॥ १०/९/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.004.m4a", "display_order": 5}, {"id": 6000205005, "chapter_id": 10205, "verse_number": "१०-९-४", "content_sanskrit": "महद्विचलनं नॄणां गृहिणां दीनचेतसाम्।\nनिःश्रेयसाय भगवान् कल्पते नान्यथा क्‍वचित्॥ १०/९/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.005.m4a", "display_order": 6}, {"id": 6000205006, "chapter_id": 10205, "verse_number": "१०-९-५", "content_sanskrit": "ज्योतिषामयनं साक्षाद् यत्तज्ज्ञानमतीन्द्रियम्।\nप्रणीतं भवता येन पुमान् वेद परावरम्॥ १०/९/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.006.m4a", "display_order": 7}, {"id": 6000205007, "chapter_id": 10205, "verse_number": "१०-९-६", "content_sanskrit": "त्वं हि ब्रह्मविदां श्रेष्ठः संस्कारान् कर्तुमर्हसि।\nबालयोरनयोर्नॄणां जन्मना ब्राह्मणो गुरुः॥ १०/९/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.007.m4a", "display_order": 8}, {"id": 6000205008, "chapter_id": 10205, "verse_number": null, "content_sanskrit": "गर्ग उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.008.m4a", "display_order": 9}, {"id": 6000205009, "chapter_id": 10205, "verse_number": "१०-९-७", "content_sanskrit": "यदूनामहमाचार्यः ख्यातश्च भुवि सर्वतः।\nसुतं मया संस्कृतं ते मन्यते देवकीसुतम्॥ १०/९/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.009.m4a", "display_order": 10}, {"id": 6000205010, "chapter_id": 10205, "verse_number": "१०-९-८", "content_sanskrit": "कंसः पापमतिः सख्यं तव चानकदुन्दुभेः।\nदेवक्या अष्टमो गर्भो न स्‍त्री भवितुमर्हति॥ १०/९/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.010.m4a", "display_order": 11}, {"id": 6000205011, "chapter_id": 10205, "verse_number": "१०-९-९", "content_sanskrit": "इति सञ्चिन्तयन् श्रुत्वा देवकीदारिकावचः।\nअपि हन्ता गताशङ्कस्तर्हि तन्नोऽनयो महान्॥ १०/९/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.011.m4a", "display_order": 12}, {"id": 6000205012, "chapter_id": 10205, "verse_number": null, "content_sanskrit": "नन्द उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.012.m4a", "display_order": 13}, {"id": 6000205013, "chapter_id": 10205, "verse_number": "१०-९-१०", "content_sanskrit": "अलक्षितेऽस्मिन् रहसि मामकैरपि गोव्रजे।\nकुरु द्विजातिसंस्कारं स्वस्तिवाचनपूर्वकम्॥ १०/९/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.013.m4a", "display_order": 14}, {"id": 6000205014, "chapter_id": 10205, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.014.m4a", "display_order": 15}, {"id": 6000205015, "chapter_id": 10205, "verse_number": "१०-९-११", "content_sanskrit": "एवं सम्प्रार्थितो विप्रः स्वचिकीर्षितमेव तत्।\nचकार नामकरणं गूढो रहसि बालयोः॥ १०/९/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.015.m4a", "display_order": 16}, {"id": 6000205016, "chapter_id": 10205, "verse_number": "१०-९-१२", "content_sanskrit": "अयं हि रोहिणीपुत्रो रमयन् सुहृदो गुणैः। आख्यास्यते राम इति बलाधिक्याद् बलं विदुः।\nयदूनामपृथग्भावात् सङ्कर्षणमुशन्त्युत॥ १०/९/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.016.m4a", "display_order": 17}, {"id": 6000205017, "chapter_id": 10205, "verse_number": "१०-९-१३", "content_sanskrit": "आसन् वर्णास्‍त्रयो ह्यस्य गृह्णतोऽनुयुगं तनूः।\nशुक्लो रक्तस्तथा पीत इदानीं कृष्णतां गतः॥ १०/९/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.017.m4a", "display_order": 18, "topics": [{"text": "गर्गाचार्येण श्रीकृष्णस्य नामकरणपूर्वकं तन्माहात्म्यकथनम्", "range": "१३–२०"}]}, {"id": 6000205018, "chapter_id": 10205, "verse_number": "१०-९-१४", "content_sanskrit": "प्रागयं वसुदेवस्य क्‍वचिज्जातस्तवात्मजः।\nवासुदेव इति श्रीमानभिज्ञाः सम्प्रचक्षते॥ १०/९/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.018.m4a", "display_order": 19}, {"id": 6000205019, "chapter_id": 10205, "verse_number": "१०-९-१५", "content_sanskrit": "बहूनि सन्ति नामानि रूपाणि च सुतस्य ते।\nगुणकर्मानुरूपाणि तान्यहं वेद नो जनाः॥ १०/९/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.019.m4a", "display_order": 20}, {"id": 6000205020, "chapter_id": 10205, "verse_number": "१०-९-१६", "content_sanskrit": "एष वः श्रेय आधास्यद् गोपगोकुलनन्दनः।\nअनेन सर्वदुर्गाणि यूयमञ्जस्तरिष्यथ॥ १०/९/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.020.m4a", "display_order": 21}, {"id": 6000205021, "chapter_id": 10205, "verse_number": "१०-९-१७", "content_sanskrit": "पुराऽनेन व्रजपते साधवो दस्युपीडिताः।\nअराजकेऽरक्ष्यमाणा जिग्युर्दस्यून् समेधिताः॥ १०/९/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.021.m4a", "display_order": 22}, {"id": 6000205022, "chapter_id": 10205, "verse_number": "१०-९-१८", "content_sanskrit": "य एतस्मिन् महाभागाः प्रीतिं कुर्वन्ति मानवाः।\nनारयोऽभिभवन्त्येतान् विष्णुपक्षानिवासुराः॥ १०/९/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.022.m4a", "display_order": 23}, {"id": 6000205023, "chapter_id": 10205, "verse_number": "१०-९-१९", "content_sanskrit": "तस्मान्नन्दात्मजोऽयं ते नारायणसमो गुणैः॥ १०/९/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.023.m4a", "display_order": 24}, {"id": 6000205024, "chapter_id": 10205, "verse_number": "१०-९-२०", "content_sanskrit": "श्रिया कीर्त्याऽनुभावेन गोपायस्व समाहितः। इत्यात्मानं समादिश्य गर्गे च स्वगृहं गते।\nनन्दः प्रमुदितो मेने आत्मानं पूर्णमाशिषाम्॥ १०/९/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.024.m4a", "display_order": 25}, {"id": 6000205025, "chapter_id": 10205, "verse_number": "१०-९-२१", "content_sanskrit": "कालेन व्रजताऽल्पेन गोकुले रामकेशवौ।\nजानुभ्यां सह पाणिभ्यां रङ्गमाणौ विचेरतुः॥ १०/९/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.025.m4a", "display_order": 26, "topics": [{"text": "श्रीकृष्णस्य बाललीलावर्णनम्", "range": "२१–३४"}]}, {"id": 6000205026, "chapter_id": 10205, "verse_number": "१०-९-२२", "content_sanskrit": "तावङ्घ्रियुग्ममनुकृष्य सरीसृपन्तौ घोषप्रघोषरुचिरव्रजकर्दमेषु।\nतन्नादहृष्टमनसावनुसृत्य लोकं मुग्धप्रभीतवदुपेयतुरन्ति मात्रोः॥ १०/९/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.026.m4a", "display_order": 27}, {"id": 6000205027, "chapter_id": 10205, "verse_number": "१०-९-२३", "content_sanskrit": "तन्मातरौ निजसुतौ घृणया स्रवन्त्यौ पङ्काङ्गरागरुचिरावुपगुह्य दोर्भ्याम्।\nदत्वा स्तनं प्रपिबतोः स्म मुखं निरीक्ष्य मुग्धस्मिताल्पदशनं ययतुः प्रमोदम्॥ १०/९/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.027.m4a", "display_order": 28}, {"id": 6000205028, "chapter_id": 10205, "verse_number": "१०-९-२४", "content_sanskrit": "यर्ह्यागतातिरमणीयकुमारलीलावन्तर्व्रजे तदबलाः प्रगृहीतपुच्छैः।\nवत्सैरितस्तत उभावनुकृष्यमाणौ प्रेक्ष्यन्त्य उत्स्मृतगृहा जगृहुर्हसन्त्यः॥ १०/९/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.028.m4a", "display_order": 29}, {"id": 6000205029, "chapter_id": 10205, "verse_number": "१०-९-२५", "content_sanskrit": "शृङ्ग्यग्निदंष्ट्य्रहिजलद्विजकण्टकेभ्यः क्रीडापरावतिचलौ स्वसुतौ निषेद्धुम्।\nगृह्याणि कर्तुमपि यत्र न तज्जनन्यौ शेकात आपतुरलं मनसोऽनवस्थाम्॥ १०/९/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.029.m4a", "display_order": 30}, {"id": 6000205030, "chapter_id": 10205, "verse_number": "१०-९-२६", "content_sanskrit": "कालेनाल्पेन राजर्षे रामः कृष्णश्च गोकुले।\nअघृष्टजानुभिः पद्भिर्विचक्रमतुरञ्जसा॥ १०/९/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.030.m4a", "display_order": 31}, {"id": 6000205031, "chapter_id": 10205, "verse_number": "१०-९-२७", "content_sanskrit": "ततस्तु भगवान् कृष्णो वयस्यैर्व्रजबालकैः।\nसहरामो व्रजस्‍त्रीणां चिक्रीडे जनयन् मुदम्॥ १०/९/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.031.m4a", "display_order": 32}, {"id": 6000205032, "chapter_id": 10205, "verse_number": "१०-९-२८", "content_sanskrit": "कृष्णस्य गोप्यो रुचीरादीनकौमारचापलाः।\nशृण्वन्त्याः किल तन्मातुरिति होचुः समागताः॥ १०/९/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.032.m4a", "display_order": 33}, {"id": 6000205033, "chapter_id": 10205, "verse_number": "१०-९-२९", "content_sanskrit": "वत्सान् मुञ्चन् क्‍वचिदसमयान् क्रोशसञ्जातहासः\nस्तेयं स्वाद्वत्त्यथ दधि पयः कल्पितैः स्तेययोगैः।\nमर्कं भोक्ष्यन् विभजति स चेन्नास्ति भाण्डं भिनत्ति\nद्रव्यालाभे सुभृशकुपितो यात्युपक्रोश्य तोकान्॥ १०/९/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.033.m4a", "display_order": 34}, {"id": 6000205034, "chapter_id": 10205, "verse_number": "१०-९-३०", "content_sanskrit": "हस्ताग्राह्ये रचयति विधिं पीठकोलूखलाद्यै-\nश्छिद्रं ह्यन्तर्निहितवयुने शिक्यभाण्डेषु तद्वत्।\nध्वान्तागारे धृतमणिगणं स्वाङ्गमर्थप्रदीपं\nकाले गोप्यो यर्हि गृहकृत्येषु सुव्यग्रचित्ताः॥ १०/९/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.034.m4a", "display_order": 35}, {"id": 6000205035, "chapter_id": 10205, "verse_number": "१०-९-३१", "content_sanskrit": "एवं धार्ष्ट्याद् विशति कुरुते मेहनादीनि वास्तौ\nस्तेयोपायैर्विरचितकृतिः सुप्रतीको यथाऽऽस्ते।\nइत्थं स्‍त्रीभिः सभयनयनश्रीमुखालोकिनीभिः\nव्याख्यातार्थप्रहसितमुखी न ह्युपालब्धुमैच्छत्॥ १०/९/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.035.m4a", "display_order": 36}, {"id": 6000205036, "chapter_id": 10205, "verse_number": "१०-९-३२", "content_sanskrit": "एकदा क्रीडमानास्ते रामाद्या गोपबालकाः।\nकृष्णो मृदं भक्षितवानिति मात्रे न्यवेदयन्॥ १०/९/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.036.m4a", "display_order": 37}, {"id": 6000205037, "chapter_id": 10205, "verse_number": "१०-९-३३", "content_sanskrit": "सा गृहीत्वा करे कृष्णमुपालभ्य हितैषिणी।\nयशोदा भयसम्भ्रान्तप्रेक्षणाक्षमभाषत॥ १०/९/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.037.m4a", "display_order": 38}, {"id": 6000205038, "chapter_id": 10205, "verse_number": "१०-९-३४", "content_sanskrit": "कस्मान्मृदमदीनात्मन् भवान् भक्षितवान् रहः।\nवदन्ति तावका ह्येते कुमारास्तेऽग्रजोऽप्ययम्॥ १०/९/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.038.m4a", "display_order": 39}, {"id": 6000205039, "chapter_id": 10205, "verse_number": null, "content_sanskrit": "श्रीकृष्ण उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.039.m4a", "display_order": 40}, {"id": 6000205040, "chapter_id": 10205, "verse_number": "१०-९-३५", "content_sanskrit": "नाहं भक्षितवानम्ब सर्वे मिथ्याभिशंसिनः।\nयदि सत्यगिरस्तर्हि समक्षं पश्य मे मुखम्॥ १०/९/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.040.m4a", "display_order": 41, "topics": [{"text": "श्रीकृष्णेन यशोदायै मृद्भक्षणव्याजेन विश्वरूपप्रदर्शनम्", "range": "३५–४५"}]}, {"id": 6000205041, "chapter_id": 10205, "verse_number": "१०-९-३६", "content_sanskrit": "यद्येवं तर्हि व्यादेहीत्युक्तः स भगवान् हरिः।\nव्यादत्ताव्याहतैश्वर्यः क्रीडामनुजबालकः॥ १०/९/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.041.m4a", "display_order": 42}, {"id": 6000205042, "chapter_id": 10205, "verse_number": "१०-९-३७", "content_sanskrit": "सा तत्र ददृशे विश्वं जगत् स्थास्नु च खं दिशः।\nसाद्रिद्वीपाब्धिभूगोलं सवाय्वग्नीन्दुतारकम्॥ १०/९/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.042.m4a", "display_order": 43}, {"id": 6000205043, "chapter_id": 10205, "verse_number": "१०-९-३८", "content_sanskrit": "ज्योतिश्चक्रं जलं तेजो नभः स्वर्वियदेव च।\nवैकारिकाणीन्द्रियाणि मनो मात्रा गुणास्‍त्रयः॥ १०/९/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.043.m4a", "display_order": 44}, {"id": 6000205044, "chapter_id": 10205, "verse_number": "१०-९-३९", "content_sanskrit": "एतद् विचित्रं सह जीवकालस्वभावकर्माशयलिङ्गभेदम्।\nसूनोस्तनौ वीक्ष्य विदारितास्ये व्रजं सहात्मानमवाप शङ्काम्॥ १०/९/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.044.m4a", "display_order": 45}, {"id": 6000205045, "chapter_id": 10205, "verse_number": "१०-९-४०", "content_sanskrit": "किं स्वप्न एतदुत देवमाया किं वा मदीयो बत बुद्धिभेदः।\nअथो अमुष्यापि ममार्भकस्य यः कश्चनौत्पत्तिक आत्मयोगः॥ १०/९/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.045.m4a", "display_order": 46}, {"id": 6000205046, "chapter_id": 10205, "verse_number": "१०-९-४१", "content_sanskrit": "अदो यथा तन्न वितर्कगोचरं चेतोमनःकर्मवचोभिरञ्जसा।\nयदाश्रयं येन यतः प्रतीयते सुदुर्विभाव्यं प्रणताऽस्मि तत्पदम्॥ १०/९/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.046.m4a", "display_order": 47}, {"id": 6000205047, "chapter_id": 10205, "verse_number": "१०-९-४२", "content_sanskrit": "अहं ममासौ पतिरेष मे सुतो व्रजेश्वरस्याखिलवित्तपा सती।\nगोप्यश्च गोपाः सहगोधनाश्च ये यन्माययेत्थं कुमतिः स मे गतिः॥ १०/९/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.047.m4a", "display_order": 48}, {"id": 6000205048, "chapter_id": 10205, "verse_number": "१०-९-४३", "content_sanskrit": "इत्थं विदिततत्त्वायां गोपिकायां स ईश्वरः।\nवैष्णवीं व्यतनोन्मायां प्रजास्नेहमयीं विभुः॥ १०/९/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.048.m4a", "display_order": 49}, {"id": 6000205049, "chapter_id": 10205, "verse_number": "१०-९-४४", "content_sanskrit": "सद्यो नष्टस्मृतिर्गोपी आरोप्यारोहमात्मजम्।\nप्रवृद्धस्नेहकलिलहृदया सा यथा पुरा॥ १०/९/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.049.m4a", "display_order": 50}, {"id": 6000205050, "chapter_id": 10205, "verse_number": "१०-९-४५", "content_sanskrit": "त्रय्या चोपनिषद्भिश्च साङ्ख्ययोगैश्च सात्त्वतैः।\nउपगीयमानमाहात्म्यं हरिं साऽमन्यतात्मजम्॥ १०/९/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.050.m4a", "display_order": 51}, {"id": 6000205051, "chapter_id": 10205, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.051.m4a", "display_order": 52}, {"id": 6000205052, "chapter_id": 10205, "verse_number": "१०-९-४६", "content_sanskrit": "नन्दः किमकरोद् ब्रह्मन् श्रेय एवं महोदयम्।\nयशोदा च महाभागा पपौ यस्याः स्तनं हरिः॥ १०/९/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.052.m4a", "display_order": 53, "topics": [{"text": "नन्दस्य पूर्वजन्मवृत्तान्तकथनम्", "range": "४६–५२"}]}, {"id": 6000205053, "chapter_id": 10205, "verse_number": "१०-९-४७", "content_sanskrit": "पितरौ नान्वविन्देतां कृष्णरामार्भकेहितम्।\nगायन्त्यद्यापि कवयो यल्लोकशमलापहम्॥ १०/९/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.053.m4a", "display_order": 54}, {"id": 6000205054, "chapter_id": 10205, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.054.m4a", "display_order": 55}, {"id": 6000205055, "chapter_id": 10205, "verse_number": "१०-९-४८", "content_sanskrit": "द्रोणो वसूनां प्रवरो धरया सह भार्यया।\nकरिष्यमाण आदेशं ब्रह्मणस्तमुवाच ह॥ १०/९/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.055.m4a", "display_order": 56}, {"id": 6000205056, "chapter_id": 10205, "verse_number": "१०-९-४९", "content_sanskrit": "जातयोर्नौ महादेवे भुवि विश्वेश्वरे हरौ।\nभक्तिः स्यात् परमा लोके ययाऽञ्जो दुस्तरं तरेत्॥ १०/९/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.056.m4a", "display_order": 57}, {"id": 6000205057, "chapter_id": 10205, "verse_number": "१०-९-५०", "content_sanskrit": "अस्त्वित्युक्तः स एतेन व्रजे द्रोणो महायशाः।\nजज्ञे नन्द इति ख्यातो यशोदा सा धराऽभवत्॥ १०/९/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.057.m4a", "display_order": 58}, {"id": 6000205058, "chapter_id": 10205, "verse_number": "१०-९-५१", "content_sanskrit": "ततो भक्तिर्भगवति पुत्रभूते जनार्दने।\nदम्पत्योर्नितरामासीद् गोपगोपीषु भारत॥ १०/९/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.058.m4a", "display_order": 59}, {"id": 6000205059, "chapter_id": 10205, "verse_number": "१०-९-५२", "content_sanskrit": "कृष्णो ब्रह्मण आदेशं सत्यं कर्तुं व्रजे विभुः।\nसहरामो वसंश्चक्रे तेषां प्रीतिं स्वलीलया॥ १०/९/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_009/BhP_10.009.059.m4a", "display_order": 60}, {"id": 6000205060, "chapter_id": 10205, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे नवमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]