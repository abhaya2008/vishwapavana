[{"id": 2057574, "chapter_id": 2247, "verse_number": "७-१७४-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2057575, "chapter_id": 2247, "verse_number": "७-१७४-१", "content_sanskrit": "ततः कर्णो रणे दृष्ट्वा पार्षतं परवीरहा।\nआजघानरोसि शरैर्दशभिर्मर्मभेदिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2057576, "chapter_id": 2247, "verse_number": "७-१७४-२", "content_sanskrit": "प्रतिविव्याध तं तूर्णं धृष्टद्युम्नोपि मारिष।\nदशभिः सायकैर्हृष्टस्तिष्ठतिष्ठेति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2057577, "chapter_id": 2247, "verse_number": "७-१७४-३", "content_sanskrit": "तावन्योन्यं शरैः सङ्ख्ये सञ्छाद्य सुमहारथैः।\nपुनः पूर्णायतोत्सृष्टैर्विव्यधाते परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2057578, "chapter_id": 2247, "verse_number": "७-१७४-४", "content_sanskrit": "ततः पाञ्चालमुख्यस्य धृष्टद्युम्नस्य संयुगे।\nसारथिं चतुरश्चाश्वान्कर्णो विव्याध सायकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2057579, "chapter_id": 2247, "verse_number": "७-१७४-५", "content_sanskrit": "कार्मुकप्रवरं चापि प्रचिच्छेद शितैः शरैः।\nसारथिं चास्य भल्लेन रथनीडादपातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2057580, "chapter_id": 2247, "verse_number": "७-१७४-६", "content_sanskrit": "धृष्टद्युम्नस्तु विरथो हताश्वो हतसारथिः।\nगृहीत्वा परिघं घोरं कर्णस्याश्वानपीडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2057581, "chapter_id": 2247, "verse_number": "७-१७४-७", "content_sanskrit": "विद्धश्च बहुभिस्तेन शरैराशीविषोपमैः।\nततो युधिष्ठिरानीकं पद्ध्यामेवान्वपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2057582, "chapter_id": 2247, "verse_number": "७-१७४-८", "content_sanskrit": "आरुरोह रथं चापि सहदेवस्य मारिष।\nप्रयातुकामः कर्णाय वारितो धर्मसूनुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2057583, "chapter_id": 2247, "verse_number": "७-१७४-९", "content_sanskrit": "कर्णस्तु सुमहातेजाः सिंहनादविमिश्रितम्।\nधनुःशब्दं महच्चक्रे दध्मौ तारेण चाम्बुजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2057584, "chapter_id": 2247, "verse_number": "७-१७४-१०", "content_sanskrit": "दृष्ट्वा विनिर्जितं युद्धे पार्षतं ते महारथाः।\nअमर्षवशमापन्नाः पाञ्चालाः सहसोमकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2057585, "chapter_id": 2247, "verse_number": "७-१७४-११", "content_sanskrit": "सूतपुत्रवधार्थाय शस्त्राण्यादाय सर्वशः।\nप्रययुः कर्णमुद्दिश्य मृत्युं कृत्वा निवर्तनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2057586, "chapter_id": 2247, "verse_number": "७-१७४-१२", "content_sanskrit": "कर्णस्यापि रथे वाहानन्यान्सूतोऽभ्ययोजयत्।\nशङ्खवर्णान्महावेगान्सैन्धवान्साधुवाहिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2057587, "chapter_id": 2247, "verse_number": "७-१७४-१३", "content_sanskrit": "लब्धलक्षस्तु राधेयः पञ्चालानां महारथान्।\nअभ्यपीडयदायस्तः शरैर्मेघ इवाचलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2057588, "chapter_id": 2247, "verse_number": "७-१७४-१४", "content_sanskrit": "सा पीड्यमाना कर्णेन पाञ्चालानां महाचमूः।\nसम्प्राद्रवत्सुसन्त्रस्ता सिंहेनेवार्दिता मृगी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2057589, "chapter_id": 2247, "verse_number": "७-१७४-१५", "content_sanskrit": "पतितास्तुरगेभ्यश्च गजेभ्यश्च महीतले।\nरथेभ्यश्च नरास्तूर्णमदृश्यन्त ततस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2057590, "chapter_id": 2247, "verse_number": "७-१७४-१६", "content_sanskrit": "धावमानस्य योधस्य क्षुरप्रैः स महामृधे।\nबाहू चिच्छेद वै कर्णः शिरश्चैव सकुण्डलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2057591, "chapter_id": 2247, "verse_number": "७-१७४-१७", "content_sanskrit": "ऊरू चिच्छेद चान्यस्य गजस्थस्य विशाम्पते।\nवाजिपृष्ठगतस्यापि भूमिष्ठस्य च मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2057592, "chapter_id": 2247, "verse_number": "७-१७४-१८", "content_sanskrit": "नाज्ञासिषुर्धावमाना बहवश्च महारथाः।\nसञ्छिन्नान्यात्मगात्राणि वाहनानि च संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2057593, "chapter_id": 2247, "verse_number": "७-१७४-१९", "content_sanskrit": "ते वध्यमानाः समरे पाञ्चालाः सृञ्जयैः सह।\nतृणप्रस्पन्दनाच्चापि सूतपुत्रं स्म मेनिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2057594, "chapter_id": 2247, "verse_number": "७-१७४-२०", "content_sanskrit": "अपि स्वं समरे योधं धावमानं विचेतसम्।\nकर्णमेवाभ्यमन्यन्त ततो भीता द्रवन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2057595, "chapter_id": 2247, "verse_number": "७-१७४-२१", "content_sanskrit": "तान्यनीकानि भग्नानि द्रवमाणानि भारत।\nअभ्यद्रवद्द्रुतं कर्णः पृष्ठतो विकिरञ्छरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2057596, "chapter_id": 2247, "verse_number": "७-१७४-२२", "content_sanskrit": "अवेक्षमाणास्त्वन्योन्यं सुसम्मूढा विचेतसः।\nनाशक्नुवन्नवस्थातुं काल्यमाना महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2057597, "chapter_id": 2247, "verse_number": "७-१७४-२३", "content_sanskrit": "कर्णेनाभ्याहता राजन्पाञ्चालाः परमेषुभिः।\nद्रोणेन च दिशः सर्वा वीक्षमाणाः प्रदुद्रुवुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2057598, "chapter_id": 2247, "verse_number": "७-१७४-२४", "content_sanskrit": "ततो युधिष्ठिरो राजा स्वसैन्यं प्रेक्ष्य विद्रुतम्।\nअपयाने मनः कृत्वा फल्गुनं वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2057599, "chapter_id": 2247, "verse_number": "७-१७४-२५", "content_sanskrit": "पश्य कर्णं महेष्वासं धनुष्पाणिमवस्थितम्।\nनिशीथे दारुणे काले तपन्तमिव भास्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2057600, "chapter_id": 2247, "verse_number": "७-१७४-२६", "content_sanskrit": "कर्णसायकनुन्नानां क्रोशतामेष निःस्वनः।\nअनिशं श्रूयते पार्थ त्वद्बन्धूनामनाथवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2057601, "chapter_id": 2247, "verse_number": "७-१७४-२७", "content_sanskrit": "यथा विसृजतश्चास्य सन्दधानस्य चाशुगान्।\nपश्यामि नान्तरं पार्थ क्षपयिष्यति नो ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2057602, "chapter_id": 2247, "verse_number": "७-१७४-२८", "content_sanskrit": "यदत्रानन्तरं कार्यं प्राप्तकाल च पश्यसि।\nकर्णस्य वधसंयुक्तं तत्कुरुष्व धनञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2057603, "chapter_id": 2247, "verse_number": "७-१७४-२९", "content_sanskrit": "एवमुक्तो महाराज पार्थः कृष्णमथाब्रवीत्।\nभीतः कुन्तीसुतो राजा राधेयस्याद्य विक्रमात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2057604, "chapter_id": 2247, "verse_number": "७-१७४-३०", "content_sanskrit": "एवं गते प्राप्तकालं कर्णानीके पुनः पुनः।\nभवान्व्यवस्यतु क्षिप्रं द्रवते हि वरूथिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2057605, "chapter_id": 2247, "verse_number": "७-१७४-३१", "content_sanskrit": "द्रोणसायकनुन्नानां भग्नानां मधुसूदन।\nकर्णेन त्रास्यमानानामवस्थानं न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2057606, "chapter_id": 2247, "verse_number": "७-१७४-३२", "content_sanskrit": "पश्यामि च तथा कर्णं विचरन्तमभीतवत्।\nद्रवमाणान्रथोदारान्किरन्तं निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2057607, "chapter_id": 2247, "verse_number": "७-१७४-३३", "content_sanskrit": "नैनं शक्ष्यामि संसोढुं चरन्तं रणमूर्धनि।\nप्रत्यक्षं वृष्णिशार्दूल पादस्पर्शमिवोरगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2057608, "chapter_id": 2247, "verse_number": "७-१७४-३४", "content_sanskrit": "स सवांस्तत्र यात्वाशु यत्र कर्णो महारथः।\nअहमेनं हनिष्यामि मां वैष मधुसूदन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2057609, "chapter_id": 2247, "verse_number": "७-१७४-३५x", "content_sanskrit": "श्रीवासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2057610, "chapter_id": 2247, "verse_number": "७-१७४-३५", "content_sanskrit": "पश्यामि कर्णं कौन्तेय देवराजमिवाहवे।\nविचरन्तं नरव्याघ्रमतिमानुषविक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2057611, "chapter_id": 2247, "verse_number": "७-१७४-३६", "content_sanskrit": "नैतस्यान्योऽस्ति सङ्ग्रामे प्रत्युद्याता धनञ्जय।\nऋते त्वां पुरुषव्याघ्र राक्षसाद्वा घटोत्कचात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2057612, "chapter_id": 2247, "verse_number": "७-१७४-३७", "content_sanskrit": "न तु तावदहं मन्ये प्राप्तकालं तवानघ।\nसमागमं महाबाहो सूतपुत्रेण संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2057613, "chapter_id": 2247, "verse_number": "७-१७४-३८", "content_sanskrit": "दीप्यमाना महोल्केव तिष्ठत्यस्य हि वासवी।\nत्वदर्थं हि महाबाहो सूतपुत्रेण संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2057614, "chapter_id": 2247, "verse_number": "७-१७४-३९", "content_sanskrit": "रक्ष्यते शक्तिरेषा हि रौद्रां रूपं बिभर्ति च।\nघटोत्कचस्तु राधेयं प्रत्युद्यातु महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2057615, "chapter_id": 2247, "verse_number": "७-१७४-४०", "content_sanskrit": "स हि भीमेन बलिना जातः सुरपराक्रमः।\nतस्मिन्नस्त्राणि दिव्यानि राक्षसान्यासुराणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2057616, "chapter_id": 2247, "verse_number": "७-१७४-४१", "content_sanskrit": "सततं चानुरक्तो वो हितैषी च घटोत्कचः।\nविजेष्यति रणे कर्णमिति मे नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2057617, "chapter_id": 2247, "verse_number": "७-१७४-४२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2057618, "chapter_id": 2247, "verse_number": "७-१७४-४२", "content_sanskrit": "एवमुक्तो महाबाहुः पार्थः पुष्करलोचनः।\nआजुहावाथ तद्रक्षस्तच्चासीत्प्रादुरप्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2057619, "chapter_id": 2247, "verse_number": "७-१७४-४३", "content_sanskrit": "कवची सशरः खङ्गी सधन्वा च विशाम्पते।\nअभिवाद्य ततः कृष्णं पाण्डवं च धनञ्जयम्।\nअब्रवीच्च तदा कृष्णमयमस्म्यनुशाधि माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2057620, "chapter_id": 2247, "verse_number": "७-१७४-४४", "content_sanskrit": "ततस्तं मेघसङ्काशं दीप्तास्यं दीप्तकुण्डलम्।\nअभ्यभाषत हैडिम्बिं दाशार्हः प्रहसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2057621, "chapter_id": 2247, "verse_number": "७-१७४-४५x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2057622, "chapter_id": 2247, "verse_number": "७-१७४-४५", "content_sanskrit": "घटोत्कच विजानीहि यत्त्वां वक्ष्यामि पुत्रक।\nप्राप्तो विक्रमकालोऽयं तव नान्यस्य कस्याचित्।\nस त्वं निमज्जतां युद्धे बन्धूनां बान्धवो भव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2057623, "chapter_id": 2247, "verse_number": "७-१७४-४६", "content_sanskrit": "यावन्ति च तवास्त्राणि सन्ति मायाश्च राक्षसीः।\n`अद्यैव समयस्तेषां मायानां चैव राक्षस॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2057624, "chapter_id": 2247, "verse_number": "७-१७४-४७", "content_sanskrit": "पश्य कर्णेन हैडिम्बे पाण्डवानामनीकिनीम्।\nकाल्यमानां रणे तात सिंहनेवेतरान्मृगान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2057625, "chapter_id": 2247, "verse_number": "७-१७४-४८", "content_sanskrit": "एष कर्णो महेष्वासो मतिमान्दृढविक्रमः।\nपाण्वानामनीकेषु निहन्ति क्षत्रियर्षभान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2057626, "chapter_id": 2247, "verse_number": "७-१७४-४९", "content_sanskrit": "किरन्तः शरवर्षाणि महान्ति दृढधन्विनः।\nन शक्नुवन्त्यवस्थातुं पीड्यमानाः शरार्चिषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2057627, "chapter_id": 2247, "verse_number": "७-१७४-५०", "content_sanskrit": "निशीथे सूतपुत्रेण शरवर्षेण पीडिताः।\nएते द्रवन्ति पाञ्चालाः सिंहेनेवार्दिता मृशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2057628, "chapter_id": 2247, "verse_number": "७-१७४-५१", "content_sanskrit": "एतस्यैवं प्रवृद्धस्य सूतपुत्रस्य संयुगे।\nनिषेद्धा विद्यते नान्यस्त्वामृते भीमविक्रम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2057629, "chapter_id": 2247, "verse_number": "७-१७४-५२", "content_sanskrit": "स त्वं कुरु महाबाहो कर्म युक्तमिहात्मनः।\nमातुलानां पितॄणां च तेसजोऽस्त्रबलस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2057630, "chapter_id": 2247, "verse_number": "७-१७४-५३", "content_sanskrit": "एतदर्थे हि हैडिम्बे पुत्रानिच्छन्ति मानवाः।\nकथं नस्तारयेद्दुःखात्स त्वं तारय बान्धवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2057631, "chapter_id": 2247, "verse_number": "७-१७४-५४", "content_sanskrit": "इच्छन्ति पितरः पुत्रान्स्वार्थहेतोर्घटोत्कच।\nहहलोकात्परे लोके तारयिष्यन्ति ये हिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2057632, "chapter_id": 2247, "verse_number": "७-१७४-५५", "content_sanskrit": "तव ह्यत्र बलं भीमं मायाश्च तव दुस्तराः।\nसङ्क्रामे युध्यमानस्य सततं भीमनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2057633, "chapter_id": 2247, "verse_number": "७-१७४-५६", "content_sanskrit": "पाण्डवानां प्रभग्नानां कर्णेन निशि सायकैः।\nमज्जतां धार्तराष्ट्रेषु भव पारं परन्तप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2057634, "chapter_id": 2247, "verse_number": "७-१७४-५७", "content_sanskrit": "रात्रौ हि राक्षसा भूयो भवन्त्यमितविक्रमाः।\nबलवन्तः सुदुर्धर्षाः शूरा विक्रान्तचारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2057635, "chapter_id": 2247, "verse_number": "७-१७४-५८", "content_sanskrit": "जहि कर्णं हमेष्वासं निशीथे मायया रणे।\nपार्था द्रोणं वधिष्यन्ति धृष्टद्युम्नपुरोगमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2057636, "chapter_id": 2247, "verse_number": "७-१७४-५९x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2057637, "chapter_id": 2247, "verse_number": "७-१७४-५९", "content_sanskrit": "केशवस्य वचः श्रुत्वा बीभत्सुरपि राक्षसम्।\nअभ्यभाषत कौरव्य घटोत्कचमरिन्दमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2057638, "chapter_id": 2247, "verse_number": "७-१७४-६०", "content_sanskrit": "घटोत्कच भवांश्चैव दीर्घबाहुश्च सात्यकिः।\nमतौ मे सर्वसैन्येषु भीमसेनश्च पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2057639, "chapter_id": 2247, "verse_number": "७-१७४-६१", "content_sanskrit": "तद्भवान्यातु कर्णेन द्वैरथं युध्यतां निशि।\nसात्यकिः पृष्ठगोपस्ते भविष्यति महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2057640, "chapter_id": 2247, "verse_number": "७-१७४-६२", "content_sanskrit": "जहि कर्णं रणे शूरं सात्वतेन सहायवान्।\nयथेन्द्रस्तारकं पूर्वं स्कन्देन सह जघ्निवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2057641, "chapter_id": 2247, "verse_number": "७-१७४-६३x", "content_sanskrit": "घटोत्कच उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2057642, "chapter_id": 2247, "verse_number": "७-१७४-६३", "content_sanskrit": "`एवमेव महाबाहो यथा वदसि मां प्रभो।\nत्वया नियुक्तो गच्छामि कर्णस्य बधकाङ्क्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2057643, "chapter_id": 2247, "verse_number": "७-१७४-६४", "content_sanskrit": "अलमेवास्मि कर्णाय द्रोणायालं च भारत।\nअन्येषां क्षत्रियाणां च कृतास्त्राणां महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2057644, "chapter_id": 2247, "verse_number": "७-१७४-६५", "content_sanskrit": "अद्य दास्यामि सङ्ग्रामं सूतपुत्राय तं निशि।\nयं जनाः सम्प्रवक्ष्यन्ति यावद्भूमिर्धरिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2057645, "chapter_id": 2247, "verse_number": "७-१७४-६६", "content_sanskrit": "न चात्र शूरान्मोक्ष्यामि न भीतान्न कृताञ्जलीन्।\nसर्वानेव वधिष्यामि राक्षसं धर्ममास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2057646, "chapter_id": 2247, "verse_number": "७-१७४-६७x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2057647, "chapter_id": 2247, "verse_number": "७-१७४-६७", "content_sanskrit": "एवमुक्त्वा महाबाहुर्हैडिम्बिः परवीरहा।\nअभ्ययात्तुमुले कर्णं तव सैन्यं विभीषयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2057648, "chapter_id": 2247, "verse_number": "७-१७४-६८", "content_sanskrit": "तमापतन्तं सङ्क्रुद्धं दीप्तास्यं दीप्तमूर्धजम्।\nप्रहसन्पुरुषव्याघ्रः प्रतिजग्राह सूतजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2057649, "chapter_id": 2247, "verse_number": "७-१७४-६९", "content_sanskrit": "तयोः समभवद्युद्धं कर्णराक्षसयोर्निशि।\nगर्जतो राजशार्दूल शक्रप्रह्लादयोरिव॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2057650, "chapter_id": 2247, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि घटोत्कचवधपर्वणि चतुर्दशरात्रियुद्धे चतुःसप्तत्यधिकशततमोऽध्यायः॥ १७४ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१७४-१३ आयस्तः प्रयत्नवान्॥ ५-१७४-१७४ चतुःसप्तत्यधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}]