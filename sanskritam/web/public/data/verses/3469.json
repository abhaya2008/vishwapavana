[{"id": 2114818, "chapter_id": 3469, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2114819, "chapter_id": 3469, "verse_number": "१", "content_sanskrit": "तांस्तु दृष्ट्वा सुमनसः परिसंवत्सरोषितान् ।\nविश्वस्तानिति सम्प्रेक्ष्य हर्षं चक्रे पुरोचनः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2114820, "chapter_id": 3469, "verse_number": "२", "content_sanskrit": "पुरोचने तथा हृष्टे कौन्तेयोऽथ युधिष्ठिरः ।\nभीमसेनार्जुनौ तौ च यमौ प्रोवाच धर्मवित् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2114821, "chapter_id": 3469, "verse_number": "३", "content_sanskrit": "अस्मानयं सुविश्वस्तान् वेत्ति पापः पुरोचनः ।\nवञ्चकोऽयं नृशंसात्मा कालं मन्ये पलायने \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2114822, "chapter_id": 3469, "verse_number": "४", "content_sanskrit": "जातुषागारमादीप्य दग्ध्वा चैव पुरोचनम् ।\nषट् प्राणिनो निधायेह द्रवामोऽनुपलक्षिताः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2114823, "chapter_id": 3469, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2114824, "chapter_id": 3469, "verse_number": "५", "content_sanskrit": "अथ दानापदेशेन कुन्ती ब्राह्मणभोजनम् ।\nचक्रे निशि महाराज आजग्मुस्तत्र योषितः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2114825, "chapter_id": 3469, "verse_number": "६", "content_sanskrit": "ता विहृत्य यथाकामं भुक्त्वा पीत्वा च भारत ।\nजग्मुर्निशि गृहानेव समनुज्ञाप्य माधवीम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2114826, "chapter_id": 3469, "verse_number": "७", "content_sanskrit": "पुरोचनप्रणिहिता पृथां स्म खलु सेवते ।\nनिषादी दुष्टहृदया नित्यमन्तरचारिणी \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2114827, "chapter_id": 3469, "verse_number": "८", "content_sanskrit": "निषादी पञ्चपुत्रा तु तस्मिन् भोज्ये यदृच्छया ।\nपुराभ्यासकृतस्नेहा सखी कुन्त्याः समं सुतैः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2114828, "chapter_id": 3469, "verse_number": "९", "content_sanskrit": "आनीय मधुमूलानि फलनि विविधानि च ।\nअन्नार्थिनी समभ्यागात् सपुत्रा कालचोदिता \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2114829, "chapter_id": 3469, "verse_number": "१०", "content_sanskrit": "सपापा पञ्चपुत्रा च सा पृथायाः सखी मता ।\nसा पीत्वा मदिरां तत्र सपुत्रा मदविह्वला \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2114830, "chapter_id": 3469, "verse_number": "११", "content_sanskrit": "सा हि सर्वैः सुतै राजंस्तस्मिन्नेव निवेशने ।\nसुष्वाप विगतज्ञाना मृतकल्पा नराधिप \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2114831, "chapter_id": 3469, "verse_number": "१२", "content_sanskrit": "अथ प्रवाते तुमुले निशि सुप्ते जने विभो ।\nतनूनपाद्भयाद् भीमः शेते यत्र पुरोचनः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2114832, "chapter_id": 3469, "verse_number": "१३", "content_sanskrit": "पूर्वमेव बिलं शोध्य भीमसेनो महामतिः ।\nपाण्डवैः सहितां कुन्तीं प्रावेशयत तद्बिलम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2114833, "chapter_id": 3469, "verse_number": "१४", "content_sanskrit": "दत्त्वाऽग्निं सहसा भीमो निर्जगाम बिलेन सः ।\nततः प्रवातः सुमहाञ्छब्दश्चैव विभावसोः ।\nप्रादुरासीत् ततः सर्वो बुबुधे स जनव्रजः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2114834, "chapter_id": 3469, "verse_number": "", "content_sanskrit": "पौराः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2114835, "chapter_id": 3469, "verse_number": "१५", "content_sanskrit": "दुर्योधनप्रयुक्तेन पापेनाकृतबुद्धिना ।\nगृहमात्मविनाशाय कारितं दाहितं च तत् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2114836, "chapter_id": 3469, "verse_number": "१६", "content_sanskrit": "अहो धिग् धृतराष्ट्रस्य बुद्धिर्नातिसमञ्जसी ।\nयः शुचीन् पाण्डवान् बालान् दाहयासास निर्घृणः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2114837, "chapter_id": 3469, "verse_number": "१७", "content_sanskrit": "दिष्ट्या त्विदानीं पापात्मा दग्ध्वा दग्धः पुरोचनः ।\nअनागसः सुविश्वस्तान् यो ददाह नरोत्तमान् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2114838, "chapter_id": 3469, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2114839, "chapter_id": 3469, "verse_number": "१८", "content_sanskrit": "एवं ते विलपन्ति स्म वारणावतगा जनाः ।\nपरिवार्य गृहं सर्वे रात्रौ तस्थुः समन्ततः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2114840, "chapter_id": 3469, "verse_number": "१९", "content_sanskrit": "पाण्डवाश्चापि ते सर्वे सह मात्रा परन्तपाः ।\nबिलेन तेन महता जग्मुर्वनमलक्षिताः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2114841, "chapter_id": 3469, "verse_number": "२०", "content_sanskrit": "ते तु निद्रोपरोधेन साध्वसेन च पाण्डवाः ।\nन शेकुस्त्वरिता गन्तुं सह कुन्त्या नराधिप \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2114842, "chapter_id": 3469, "verse_number": "२१", "content_sanskrit": "भीमसेनस्तु राजेन्द्र भीमवेगपराक्रमः ।\nजगाम सर्वानादाय भ्रातॄन् मातरमेव च \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2114843, "chapter_id": 3469, "verse_number": "२२", "content_sanskrit": "स्कन्धमारोप्य जननीं यमावङ्केन वीर्यवान् ।\nपार्थौ गृहीत्वा पाणिभ्यां भ्रातरौ सुमहाबलः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2114844, "chapter_id": 3469, "verse_number": "२३", "content_sanskrit": "तरसा पादपान् भञ्जन् महीं पद्भ्यां विदारयन् ।\nस जगामाशु तेजस्वी वातरंहा वृकोदरः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2114845, "chapter_id": 3469, "verse_number": "१४८", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nअष्टचत्वारिंशदधिकशततमोऽध्यायः ॥१४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2114846, "chapter_id": 3469, "verse_number": "६", "content_sanskrit": "॥ इति जतुगृहदाहपर्वणि षष्ठोऽध्यायः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2114847, "chapter_id": 3469, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]