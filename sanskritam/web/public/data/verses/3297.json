[{"id": 2106019, "chapter_id": 3297, "verse_number": "१६-२६-१", "content_sanskrit": "वैशम्पायन उवाच।\nततस्ते पाण्डवा दूरादवतीर्य पदातयः।\nअभिजग्मुर्नरपतेराश्रमं विनयानताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2106020, "chapter_id": 3297, "verse_number": "१६-२६-२", "content_sanskrit": "स च योधजनः सर्वो ये च राष्ट्रनिवासिनः।\nस्त्रियश्च कुरुमुख्यानां पद्भिरेवान्वयुस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2106021, "chapter_id": 3297, "verse_number": "१६-२६-३", "content_sanskrit": "आश्रमं ते ततो जग्मुर्धृतराष्ट्रस्य पाण्डवाः।\nशून्यं मृगगणाकीर्णं कदलीवनशोभितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2106022, "chapter_id": 3297, "verse_number": "१६-२६-४", "content_sanskrit": "ततस्तत्र समाजग्मुस्तापसा नियतव्रताः।\nपाण्डवानागतान्द्रष्टुं कौतूहलसमन्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2106023, "chapter_id": 3297, "verse_number": "१६-२६-५", "content_sanskrit": "तानपृच्छत्ततो राजा क्वासौ कौरववंशभृत्।\nपिता ज्येष्ठो गतोऽस्माकमिति बाष्पपरिप्लुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2106024, "chapter_id": 3297, "verse_number": "१६-२६-६", "content_sanskrit": "ते तमूचुस्ततो वाक्यं यमुनामवगाहितुम्।\nपुष्पाणामुदकुंभस्य चार्थे गत इति प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2106025, "chapter_id": 3297, "verse_number": "१६-२६-७", "content_sanskrit": "तैराख्यातेन मार्गेण ततस्ते जग्मुरञ्जसा।\nददृशुश्चाविदूरे तान्सर्वानथ पदातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2106026, "chapter_id": 3297, "verse_number": "१६-२६-८", "content_sanskrit": "ततस्ते सत्वरा जग्मुः वितुर्दर्शनकाङ्क्षिणः।\nसहदेवस्तु वेगेन प्राधावद्यत्र सा पृथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2106027, "chapter_id": 3297, "verse_number": "१६-२६-९", "content_sanskrit": "सुस्वरं रुरुदे धीमान्मातुः पादावुपस्पृशन्।\nसा च बाष्पाकुलमुखी ददर्शक दयितं सुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2106028, "chapter_id": 3297, "verse_number": "१६-२६-१०", "content_sanskrit": "बाहुभ्यां सम्परिष्वज्य समुन्नाम्य च पुत्रकम्।\nगान्धार्याः कथयामास सहद्रेवमुपस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2106029, "chapter_id": 3297, "verse_number": "१६-२६-११", "content_sanskrit": "अनन्तरं च राजानं भीमसेनमथार्जुनम्।\nनकुलं च पृथा दृष्ट्वा त्वरमाणोपचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2106030, "chapter_id": 3297, "verse_number": "१६-२६-१२", "content_sanskrit": "सा ह्यग्रे गच्छति तयोर्दपत्योर्हतपुत्रयोः।\nकर्षन्ती तौ ततस्ते तां दृष्ट्वा संन्यपतन्भुवि।\n`तयोस्तु पादयो राजन्न्यपतन्हतपुत्रयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2106031, "chapter_id": 3297, "verse_number": "१६-२६-१३", "content_sanskrit": "राजा तान्स्वरयोगेन स्पर्शेन च महामनाः।\nप्रत्यभिज्ञाय मेधावी समाश्वासयत प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2106032, "chapter_id": 3297, "verse_number": "१६-२६-१४", "content_sanskrit": "ततस्ते बाष्पमुत्सृज्य गान्धारीसहितं नृपम्।\nउपतस्थुर्महात्मानो मातरं च यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2106033, "chapter_id": 3297, "verse_number": "१६-२६-१५", "content_sanskrit": "सर्वेषां तोयकलशाञ्जगृहुस्ते स्वयं तदा।\nपाण्डवा लब्धसंज्ञास्ते मात्रा चाश्वासिताः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2106034, "chapter_id": 3297, "verse_number": "१६-२६-१६", "content_sanskrit": "तथा नार्यो नृसिंहानां सोऽवरोधजनस्तदा।\nपौरजानपदाश्चैव ददृशुस्तं जनाधिपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2106035, "chapter_id": 3297, "verse_number": "१६-२६-१७", "content_sanskrit": "निवेदयामास तदा जनं तन्नामगोत्रतः।\nयुधिष्ठिरो नरपतिः स चैनं प्रत्यपूजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2106036, "chapter_id": 3297, "verse_number": "१६-२६-१८", "content_sanskrit": "स तैः परिवृतो मेने हर्षबाष्पाविलेक्षणः।\nराजाऽऽत्मानं गृहगतं पुरेवि गजसाह्वये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2106037, "chapter_id": 3297, "verse_number": "१६-२६-१९", "content_sanskrit": "अभिवादितो वधूभिश्च कृष्णाद्याभिः स पार्थिवः।\nगान्धार्या सहितो धीमान्कुन्त्या च प्रत्यनन्दत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2106038, "chapter_id": 3297, "verse_number": "१६-२६-२०", "content_sanskrit": "ततश्चाश्रममागच्छत्सिद्धचारणसेवितम्।\nदिदृक्षुभिः समाकीर्णं नभस्तारागणैरिव॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2106039, "chapter_id": 3297, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्रमवासिकपर्वणि आश्रमवासपर्वणि षड्विंशोऽध्यायः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]