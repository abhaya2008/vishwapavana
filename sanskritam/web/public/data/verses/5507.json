[{"id": 2210847, "chapter_id": 5507, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2210848, "chapter_id": 5507, "verse_number": "१", "content_sanskrit": "देवदेवेश दैत्यघ्न परं कौतूहलं हि मे ।\nएतत् कथय सर्वज्ञ त्वद्भक्तस्य जनार्दन ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2210849, "chapter_id": 5507, "verse_number": "२", "content_sanskrit": "मानुषस्य च लोकस्य यमलोकस्य चान्तरम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2210850, "chapter_id": 5507, "verse_number": "३", "content_sanskrit": "कीदृशं किम्प्रमाणं वा किमधिष्ठानमेव वा ।\nतरन्ति मानवा देव केनोपायेन माधव ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2210851, "chapter_id": 5507, "verse_number": "४", "content_sanskrit": "त्वगस्थिमांसनिर्मुक्ते पञ्चभूतविवर्जिते ।\nकथयस्व महादेव सुखदुःखमशेषतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2210852, "chapter_id": 5507, "verse_number": "५", "content_sanskrit": "जीवस्य यमलोके तु कर्मभिस्तु शुभाशुभैः ।\nअनुबद्धस्य तैः पाशैर्नीयमानस्य दारुणैः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2210853, "chapter_id": 5507, "verse_number": "६", "content_sanskrit": "मृत्युदूतैर्दुराधर्षैर्घोरैर्घोरपराक्रमैः ।\nबद्धस्याक्षिप्यमाणस्य विद्रुतस्य यमाज्ञया ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2210854, "chapter_id": 5507, "verse_number": "७", "content_sanskrit": "पुण्यपापकृतस्तिष्ठेत् सुखदुःखमशेषतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2210855, "chapter_id": 5507, "verse_number": "८", "content_sanskrit": "यमदूतैर्दुराधर्षैर्नीयते वा कथं पुनः ।\nकिं वा तत्र महादेव कर्म कुर्वन्ति मानवाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2210856, "chapter_id": 5507, "verse_number": "९", "content_sanskrit": "कथं धर्मरता यान्ति देवताद्विजपूजकाः ।\nकथं वा पापकर्माणो यान्ति प्रेतपुरं नराः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2210857, "chapter_id": 5507, "verse_number": "१०", "content_sanskrit": "किं रूपं किं प्रमाणं वा वर्णः को वाऽस्य केशव ।\nजीवस्य गच्छतो नित्यं यमलोकं ब्रवीहि मे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2210858, "chapter_id": 5507, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2210859, "chapter_id": 5507, "verse_number": "११", "content_sanskrit": "शृणु राजन् यथातत्त्वं यन्मां त्वं परिपृच्छसि ।\nतत् तेऽहं कथयिष्यामि मद्भक्तस्य नरेश्वर ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2210860, "chapter_id": 5507, "verse_number": "१२", "content_sanskrit": "षडशीतिसहस्राणि योजनानां शतानि च ।\nमानुष्यस्य च लोकस्य यमलोकस्य चान्तरम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2210861, "chapter_id": 5507, "verse_number": "१३", "content_sanskrit": "न तत्र वृक्षच्छाया वा न तटाकं सरोऽपि वा ।\nन वाप्यो दीर्घिका वाऽपि न कूपं वा युधिष्ठिर ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2210862, "chapter_id": 5507, "verse_number": "१४", "content_sanskrit": "न मण्टपं सभा वाऽपि न प्रपा न निवेशनम् ।\nन पर्वतो नदी वाऽपि न भूमेर्विवरं क्वचित् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2210863, "chapter_id": 5507, "verse_number": "१५", "content_sanskrit": "न ग्रामो नाश्रमो वाऽपि नोद्यानं काननानि वा ।\nन किञ्चिद्विश्रमस्थानं पथि तस्मिन् युधिष्ठिर ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2210864, "chapter_id": 5507, "verse_number": "१६", "content_sanskrit": "जन्तोः सम्प्राप्तकालस्य वेदनार्तस्य वै भृशम् ।\nकरणैस्त्यक्तदेहस्य प्राणैः कण्ठगतैः पुनः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2210865, "chapter_id": 5507, "verse_number": "१७", "content_sanskrit": "शरीराच्चोद्यते जीवो ह्यवशो मातरिश्वना ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2210866, "chapter_id": 5507, "verse_number": "१८", "content_sanskrit": "निर्गतो वायुभूतस्तु षट्कोशात् तु कलेबरात् ।\nशरीरमन्यत् तद्रूपं तद्वर्णं तत्प्रमाणकम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2210867, "chapter_id": 5507, "verse_number": "१९", "content_sanskrit": "अदृश्यं सम्प्रविष्टस्तु सोऽप्यदृष्टेन केनचित् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2210868, "chapter_id": 5507, "verse_number": "२०", "content_sanskrit": "सोऽन्तरात्मा देहवतामष्टाङ्गो यस्तु सञ्चरेत् ।\nछेदनाद् दाहनाद् भेदात् ताडनाद् वा न नश्यति ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2210869, "chapter_id": 5507, "verse_number": "२१", "content_sanskrit": "नानारूपधरैर्घोरैः प्रचण्डैश्चण्डविक्रमैः ।\nह्रियमाणो दुराधर्षैर्यमदूतैर्यमाज्ञया ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2210870, "chapter_id": 5507, "verse_number": "२२", "content_sanskrit": "पुत्रदारमयैः पाशैः सन्निरुद्धोऽवशाद् बलात् ।\nस्वकर्मभिश्चानुगतैः कृतैः सुकृतदुष्कृतैः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2210871, "chapter_id": 5507, "verse_number": "२३", "content_sanskrit": "आक्रन्दमानः करुणं बन्धुभिर्दुःखपीडितैः ।\nत्यक्त्वा बन्धुजनं सर्वं निरपेक्षस्तु गच्छति ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2210872, "chapter_id": 5507, "verse_number": "२४", "content_sanskrit": "मातृभिः पितृभिश्चैव भ्रातृभिर्मातुलैस्तथा ।\nदारैः पुत्रैर्वयस्यैश्च रुदद्भिस्त्यज्यते नरः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2210873, "chapter_id": 5507, "verse_number": "२५", "content_sanskrit": "अदृश्यमानस्तैर्दीनैरश्रुपूर्णमुखेक्षणैः ।\nस्वशरीरं परित्यज्य वायुभूतस्तु गच्छति ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2210874, "chapter_id": 5507, "verse_number": "२६", "content_sanskrit": "अन्धकारमपारं तं महाघोरं तमोवृतम् ।\nदुःखान्तं दुष्प्रतारं च दुष्प्रकारं च दुर्गमम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2210875, "chapter_id": 5507, "verse_number": "२७", "content_sanskrit": "दुःसहं यद् दुरन्तं च दुर्निरीक्षं दुरासदम् ।\nदुरापमतिदुर्गं च पापिष्ठानां नरोत्तम ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2210876, "chapter_id": 5507, "verse_number": "२८", "content_sanskrit": "ऋषिभिः कथ्यमानं तत् पारम्पर्येण पार्थिव ।\nत्रासं जनयति प्रायः श्रूयमाणः कथास्वपि ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2210877, "chapter_id": 5507, "verse_number": "२९", "content_sanskrit": "अवश्यं चैव गन्तव्यस्तदध्वा तु युधिष्ठिर ।\nप्राप्तकालेन सन्त्यज्य बन्धून् भोगान् धनानि च ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2210878, "chapter_id": 5507, "verse_number": "३०", "content_sanskrit": "जरायुजैरण्डजैश्च स्वेदजैरुद्भिजैस्तथा ।\nजङ्गमैः स्थिरसञ्ज्ञैश्च गन्तव्यं हि यमालयम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2210879, "chapter_id": 5507, "verse_number": "३१", "content_sanskrit": "देवासुरैर्मनुष्याद्यैर्वैवस्वतवशानुगैः ।\nस्त्रीपुंनपुंसकैश्चापि पृथिव्यां जीवसञ्ज्ञितैः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2210880, "chapter_id": 5507, "verse_number": "३२", "content_sanskrit": "मध्यमैर्युवभिश्चापि बालैर्वृद्धैस्तथैव च ।\nजातमात्रैश्च गर्भस्थैर्गन्तव्यः स महापथः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2210881, "chapter_id": 5507, "verse_number": "३३", "content_sanskrit": "पूर्वाह्णे वाऽपराह्णे वा सन्ध्याकालेऽथवा पुनः ।\nप्रदोषे वाऽर्धरात्रे वा प्रत्यूषे वाऽप्युपस्थिते ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2210882, "chapter_id": 5507, "verse_number": "३४", "content_sanskrit": "प्रवासस्थैर्वनस्थैर्वा पर्वतस्थैर्जलस्थितैः ।\nक्षेत्रस्थैर्वा नभःस्थैर्वा गृहमध्यगतैरपि ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2210883, "chapter_id": 5507, "verse_number": "३५", "content_sanskrit": "भुञ्जद्भिर्वा पिबद्भिर्वा खादद्भिर्वा नरोत्तम ।\nआसीनैर्वा स्थितैर्वाऽपि शयनीयगतैरपि ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2210884, "chapter_id": 5507, "verse_number": "३६", "content_sanskrit": "जाग्रद्भिर्वा प्रसुप्तैर्वा गन्तव्यः स महापथः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2210885, "chapter_id": 5507, "verse_number": "३७", "content_sanskrit": "मृत्युदूतैर्दुराधर्षैः प्रचण्डैश्चण्डविक्रमैः ।\nआक्षिप्यमाणा विवशं यान्ति शीघ्रं यमालयम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2210886, "chapter_id": 5507, "verse_number": "३८", "content_sanskrit": "क्वचिद् भीतैः क्वचित् त्रस्तैः प्रस्कलद्भिः क्वचित् क्वचित् ।\nक्रन्दद्भिर्वेदनार्तैस्तु गन्तव्यं यमसादनम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2210887, "chapter_id": 5507, "verse_number": "३९", "content_sanskrit": "निर्भर्त्स्यमानैरुद्विग्नैर्विधृतैर्भयविह्वलैः ।\nकल्प्यमानशरीरैस्तु गन्तव्यं स्त्रीजितैः सदा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2210888, "chapter_id": 5507, "verse_number": "४०", "content_sanskrit": "कण्टकाकीर्णमार्गेण तप्तवालुकपांसुना ।\nदह्यमानैस्तु गन्तव्यो नरैर्दानविवर्जितैः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2210889, "chapter_id": 5507, "verse_number": "४१", "content_sanskrit": "काष्ठोपलशिलाघातैर्दण्डोल्मुककशाङ्कुशैः ।\nहन्यमानैर्यमपुरं गन्तव्यं धर्मवर्जितैः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2210890, "chapter_id": 5507, "verse_number": "४२", "content_sanskrit": "मेदः शोणितपूयाद्यैर्वक्त्रैर्गात्रैश्च सव्रणैः ।\nदग्धक्षतव्रणाकीर्णैर्गन्तव्यं जीवघातकैः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2210891, "chapter_id": 5507, "verse_number": "४३", "content_sanskrit": "क्रन्दद्भिश्च रुदद्भिश्च क्रोशद्भिश्चापि विस्वरम् ।\nवेदनार्तैः पतद्भिश्च गन्तव्यं जीवघातकैः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2210892, "chapter_id": 5507, "verse_number": "४४", "content_sanskrit": "भग्नपादोरुहस्ताङ्गैर्भग्नदन्तशिरोधरैः ।\nछिन्नकर्णोष्ठनासैश्च गन्तव्यं जीवघातकैः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2210893, "chapter_id": 5507, "verse_number": "४५", "content_sanskrit": "शक्तिभिर्भिण्डिपालैश्च शङ्कुतोमरसायकैः ।\nतुद्यमानैस्तु शूलाग्रैर्गन्तव्यं जीवघातकैः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2210894, "chapter_id": 5507, "verse_number": "४६", "content_sanskrit": "श्वभिव्याघ्रैर्वृकैः कङ्कैर्भक्ष्यमाणाः समन्ततः ।\nतुद्यमानाश्च गच्छन्ति राक्षसैर्मांसखादिभिः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2210895, "chapter_id": 5507, "verse_number": "४७", "content_sanskrit": "महिषैश्च मृगैश्चापि सूकरैर्जम्बुकैस्तथा ।\nभक्ष्यमाणैस्तदध्वानं गन्तव्यं मांसखादिभिः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2210896, "chapter_id": 5507, "verse_number": "४८", "content_sanskrit": "सूचीसुतीक्ष्णतुण्डाभिर्मक्षिकाभिः समन्ततः ।\nतुद्यमानैश्च गन्तव्यं पापिष्ठैर्बालघातकैः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2210897, "chapter_id": 5507, "verse_number": "४९", "content_sanskrit": "विश्वस्तं स्वामिनं विप्रं स्त्रियं वा घ्नन्ति ये नराः ।\nशस्त्रैर्निर्भिद्यमानैस्तु गन्तव्यं तैर्यमक्षयम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2210898, "chapter_id": 5507, "verse_number": "५०", "content_sanskrit": "घातयन्ति च ये जीवान् दुःखमापादयन्ति च ।\nराक्षसैश्च पिशाचैश्च भक्ष्यमाणा व्रजन्ति ते ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2210899, "chapter_id": 5507, "verse_number": "५१", "content_sanskrit": "ये हरन्तीह वस्त्राणि शय्यां प्रावरणानि च ।\nते यान्ति विद्रुता नग्नाः पिशाचा इव तत्पथम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2210900, "chapter_id": 5507, "verse_number": "५२", "content_sanskrit": "गाश्च धान्यं हिरण्यं वा बलात् क्षेत्रं गृहं तथा ।\nये हरन्ति दुरात्मानः परस्वं पापकारिणः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2210901, "chapter_id": 5507, "verse_number": "५३", "content_sanskrit": "पाषाणैरुल्मुकैर्दण्डैः काष्ठघातैश्च जर्झरैः ।\nहन्यमानैः क्षताकीर्णैर्गन्तव्यं तैर्यमालयम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2210902, "chapter_id": 5507, "verse_number": "५४", "content_sanskrit": "ब्रह्मस्वं ये हरन्तीह नरा नरकपातिनः ।\nआक्रोशन्तीह ये नित्यं प्रहरन्ति च ये द्विजान् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2210903, "chapter_id": 5507, "verse_number": "५५", "content_sanskrit": "शुष्ककण्ठा निबद्धास्ते छिन्नजिह्वाक्षिनासिकाः ।\nपूयशोणितदुर्गन्धा भक्ष्यमाणाश्च जम्बुकैः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2210904, "chapter_id": 5507, "verse_number": "५६", "content_sanskrit": "चण्डालैर्निर्घृणैश्चण्डैस्तुद्यमानाः समन्ततः ।\nक्रोशन्तः करुणं घोरं गच्छन्ति यमसादनम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2210905, "chapter_id": 5507, "verse_number": "५७", "content_sanskrit": "तत्रैव पतिताः पापा विष्ठाकूपेष्वनेकशः ।\nमज्जन्ते वर्षकोटीस्तु क्लिश्यन्तो वेदनार्दिताः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2210906, "chapter_id": 5507, "verse_number": "५८", "content_sanskrit": "ततश्च मुक्ताः कालेन लोके चास्मिन् नराधमाः ।\nविष्ठाक्रिमित्वं गच्छन्ति जन्मकोटिशतं नृप ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2210907, "chapter_id": 5507, "verse_number": "५९", "content_sanskrit": "विद्यमानधनैर्यैस्तु लोभडम्भानृतान्वितैः ।\nश्रोत्रियेभ्यो न दत्तानि दानानि बहुधा नृप ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2210908, "chapter_id": 5507, "verse_number": "६०", "content_sanskrit": "ग्रीवापाशनिबद्धास्ते हन्यमानाश्च राक्षसैः ।\nक्षुत्पिपासाश्रमार्तास्तु यान्ति प्रेतपुरं नराः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2210909, "chapter_id": 5507, "verse_number": "६१", "content_sanskrit": "अदत्तदाना गच्छन्ति शुष्ककण्ठास्यतालुकाः ।\nअन्नं पानीयसहितं प्रार्थयन्तः पुनः पुनः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2210910, "chapter_id": 5507, "verse_number": "६२", "content_sanskrit": "स्वामिन् बुभुक्षातृष्णार्ता गन्तुं नैवाद्य शक्नुमः ।\nममान्नं दीयतां स्वादु पानीयं दीयतामिति ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2210911, "chapter_id": 5507, "verse_number": "समाप्तिः", "content_sanskrit": "इति ब्रुवाणांस्तान् दूताः प्रापयन्ति यमालयम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2210912, "chapter_id": 5507, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2210913, "chapter_id": 5507, "verse_number": "६४", "content_sanskrit": "तच्छ्रुत्वा वचनं विष्णोः पपात भुवि पाण्डवः ।\nनिःसञ्ज्ञो भयसन्त्रस्तो निश्चेष्टो भयविह्वलः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2210914, "chapter_id": 5507, "verse_number": "६५", "content_sanskrit": "ततो लब्ध्वा शनैःसञ्ज्ञां समाश्वस्तोऽच्युतेन सः ।\nनेत्रे प्रक्षाल्य तोयेन भूयः केशवमब्रवीत् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2210915, "chapter_id": 5507, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2210916, "chapter_id": 5507, "verse_number": "६६", "content_sanskrit": "भीतोऽस्म्यहं महादेव श्रुत्वा मार्गस्य विस्तरम् ।\nकेन दानेन तन्मार्गं तरन्ति पुरुषाः सुखम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2210917, "chapter_id": 5507, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2210918, "chapter_id": 5507, "verse_number": "६७", "content_sanskrit": "इह ये धार्मिका लोके जीवघातविवर्जिताः ।\nगुरुशिश्रूषणे युक्ता देवब्राह्मणपूजकाः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2210919, "chapter_id": 5507, "verse_number": "६८", "content_sanskrit": "अस्मान्मानुष्यलोकात् ते सभार्याः सहबान्धवाः ।\nयमध्वानं तु गच्छन्ति यथावत् तं निबोध मे ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2210920, "chapter_id": 5507, "verse_number": "६९", "content_sanskrit": "ब्राह्मणेभ्यः प्रदानानि नानारूपाणि पार्थिव ।\nये प्रयच्छन्ति विप्रेभ्यस्ते सुखं यान्ति तत्पथम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2210921, "chapter_id": 5507, "verse_number": "७०", "content_sanskrit": "अन्नं च ये प्रयच्छन्ति ब्राह्मणेभ्यः सुसंस्कृतम् ।\nश्रोत्रियेभ्यो विशेषेण भक्त्या परमया युताः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2210922, "chapter_id": 5507, "verse_number": "७१", "content_sanskrit": "ते विमानैर्महात्मानो यान्ति चित्रैर्यमालयम् ।\nसेव्यमाना वरस्त्रीभिरप्सरोभिर्महापथि ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2210923, "chapter_id": 5507, "verse_number": "७२", "content_sanskrit": "ये च नित्यं प्रभाषन्ते प्रियं निष्कल्मषं वचः ।\nते च यान्त्यमलाभ्राभैः उद्यानैः वृषयोजितैः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2210924, "chapter_id": 5507, "verse_number": "७३", "content_sanskrit": "कपिलादीनि दानानि श्रद्धायुक्ताश्च ये नराः ।\nब्राह्मणेभ्यः प्रयच्छन्ति श्रोत्रियेभ्यो विशेषतः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2210925, "chapter_id": 5507, "verse_number": "७४", "content_sanskrit": "ते यान्त्यादित्यवर्णाभैर्विमानैर्हेमभूषणैः ।\nवैवस्वतपुरं रम्यमपप्सरोभिर्निषेवितम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2210926, "chapter_id": 5507, "verse_number": "७५", "content_sanskrit": "उपानहौ च छत्रं च शयनान्यासनानि च ।\nविप्रेभ्यो ये प्रयच्छन्ति वस्त्राण्याभरणानि च ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2210927, "chapter_id": 5507, "verse_number": "७६", "content_sanskrit": "ते यान्त्यश्वैर्वृषैर्वाऽपि कुञ्जरैरप्यलङ्कृताः ।\nधनदस्य पुरं रम्यं सौवर्णच्छत्रशोभिताः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2210928, "chapter_id": 5507, "verse_number": "७७", "content_sanskrit": "ये च भक्ष्याणि दास्यन्ति भोज्यं पेयं तथैव च ।\nस्निग्धान्नं चापि विप्रेभ्यः श्रद्धया परया युताः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2210929, "chapter_id": 5507, "verse_number": "७८", "content_sanskrit": "ते यान्ति काञ्चनैर्यानैः सुखं वैवस्वतालयम् ।\nवरस्त्रीभिर्युवतिभिः सेव्यमानाः समन्ततः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2210930, "chapter_id": 5507, "verse_number": "७९", "content_sanskrit": "ये च क्षीरं प्रयच्छन्ति घृतं दधि गुडं मधु ।\nब्राह्मणेभ्यः प्रयत्नेन श्रद्दधानाः सुसंस्कृताः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2210931, "chapter_id": 5507, "verse_number": "८०", "content_sanskrit": "चक्रवाकप्रयुक्तैस्तु यानैः रुग्ममयैः शुभैः ।\nयान्ति गन्धर्ववादित्रैः सेव्यमाना यमालयम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2210932, "chapter_id": 5507, "verse_number": "८१", "content_sanskrit": "ये फलानि प्रयच्छन्ति पुष्पाणि सुरभीणि च ।\nहंसयुक्तैर्विमानैस्तु यान्ति धर्मपुरं नराः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2210933, "chapter_id": 5507, "verse_number": "८२", "content_sanskrit": "ये प्रयच्छन्ति विप्रेभ्यो विविधान्नं घृताप्लुतम् ।\nते व्रजन्त्यमलाभ्राभैर्विमानैर्वायुवेगिभिः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2210934, "chapter_id": 5507, "verse_number": "८३", "content_sanskrit": "पुरं तत् प्रेतनाथस्य नानाजनसमाकुलम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2210935, "chapter_id": 5507, "verse_number": "८४", "content_sanskrit": "पानीयं ये प्रयच्छन्ति सर्वभूतप्रजीवनम् ।\nते सुतृप्ताः सुखं यान्ति विमानैर्हंसचोदितैः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2210936, "chapter_id": 5507, "verse_number": "८५", "content_sanskrit": "ये तिलांस्तिलधेनुं वा घृतधेनुमथापि वा ।\nश्रोत्रियेभ्यः प्रयच्छन्ति सौम्यभावसमन्विताः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2210937, "chapter_id": 5507, "verse_number": "८६", "content_sanskrit": "सोममण्डलसङ्काशैर्यानैस्ते यान्ति निर्मलैः ।\nगीयमानास्तु गन्धर्वैर्वैवस्वतपुरं नराः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2210938, "chapter_id": 5507, "verse_number": "८७", "content_sanskrit": "येषां वाप्यश्च कूपाश्च तटाकानि सरांसि च ।\nदीर्घिकाः पुष्करिण्यश्च सजलाश्च जलाशयाः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2210939, "chapter_id": 5507, "verse_number": "८८", "content_sanskrit": "यानैस्ते यान्ति चन्द्राभैर्दिव्यघण्टानिनादितैः ।\nचामरैस्तालवृन्तैश्च वीज्यमाना महाप्रभाः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2210940, "chapter_id": 5507, "verse_number": "८९", "content_sanskrit": "नित्यतृप्ता महात्मानो गच्छन्ति यमसादनम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2210941, "chapter_id": 5507, "verse_number": "", "content_sanskrit": "येषां देवगृहाणीह चित्राण्यायतनानि च ।\nमनोहराणि कान्तानि दर्शनीयानि भान्त्युत ॥९०।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2210942, "chapter_id": 5507, "verse_number": "९१", "content_sanskrit": "ते व्रजन्त्यमलाभ्राभैर्विमानैर्वायुवेगिभिः ।\nपुरं तत् प्रेतनाथस्य नानाजनकसमाकुलम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2210943, "chapter_id": 5507, "verse_number": "९२", "content_sanskrit": "वैवस्वतं च पश्यन्ति सुखचित्तं सुखस्थितम् ।\nयमेन पूजिता यान्ति यमसालोक्यतां गताः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2210944, "chapter_id": 5507, "verse_number": "९३", "content_sanskrit": "मृतानुद्दिश्य लोकेषु प्रपासु करकोद्धृतम् ।\nशीतलं सलिलं रम्यं तृषितेभ्यो दिशन्ति ये ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2210945, "chapter_id": 5507, "verse_number": "९४", "content_sanskrit": "ते तु तृप्तिं परां प्राप्ताः सुखं यान्ति महापथम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2210946, "chapter_id": 5507, "verse_number": "९५", "content_sanskrit": "काष्ठपादुकदा यान्ति तदध्वानं सुखं नराः ।\nसुवर्णमणिपीठे तु पादं कृत्वा रथोत्तमे ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2210947, "chapter_id": 5507, "verse_number": "९६", "content_sanskrit": "आरामान् वृक्षषण्डांश्च रोपयन्ति च ये नराः ।\nसंवर्धयन्ति चाव्यग्रा फलपुष्पैश्च शोभिताः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2210948, "chapter_id": 5507, "verse_number": "९७", "content_sanskrit": "वृक्षच्छायासु रम्यासु शीतलासु स्वलङ्कृताः ।\nयान्ति ते वाहनैर्दिव्यैः पूज्यमाना मुहुर्मुहुः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2210949, "chapter_id": 5507, "verse_number": "९८", "content_sanskrit": "सुवर्णं रजतं वाऽपि विद्रुमं मौक्तिकं तथा ।\nये प्रयच्छन्ति ते यान्ति विमानैः कनकोज्ज्वलैः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2210950, "chapter_id": 5507, "verse_number": "९९", "content_sanskrit": "सेव्यमानाः सुरूपाभिरकृशाभिः प्रयत्नतः ।\nस्त्रीभिः कनकवर्णाभिर्यथाकामं यथासुखम् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2210951, "chapter_id": 5507, "verse_number": "१००", "content_sanskrit": "अश्वदानं तु गोदानं हस्तिदानमथापि वा ।\nये प्रयच्छन्ति विप्रेभ्यो विमानैः कनकोज्ज्वलैः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2210952, "chapter_id": 5507, "verse_number": "१०१", "content_sanskrit": "ते व्रजन्ति वरस्त्रीभिर्सेव्यमाना यथासुखम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2210953, "chapter_id": 5507, "verse_number": "१०२", "content_sanskrit": "भूमिदा यान्ति तं लोकं सर्वकामैः सुतर्पिताः ।\nउदितादित्यसङ्काशैर्विमानैस्ते यमालयम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2210954, "chapter_id": 5507, "verse_number": "१०३", "content_sanskrit": "कन्यां ये च प्रयच्छन्ति विप्राय श्रोत्रियाय च ।\nदिव्यकन्यावृता यान्ति विमानैस्ते यमालयम् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2210955, "chapter_id": 5507, "verse_number": "१०४", "content_sanskrit": "सुगन्धान् गन्धसंयोगान् पुष्पाणि सुरभीणि च ।\nप्रयच्छन्ति द्विजाग्रेभ्यो भक्त्या परमया युताः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2210956, "chapter_id": 5507, "verse_number": "१०५", "content_sanskrit": "ते सुगन्धाः सुवेषाश्च सुप्रभाः स्रग्विभूषिताः ।\nयान्ति धर्मपुरं यानैर्विचित्रैरप्यलङ्कृताः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2210957, "chapter_id": 5507, "verse_number": "१०६", "content_sanskrit": "दीपदा यान्ति यानैश्च दीपयन्तो दिशो दश ।\nआदित्यसदृशाकारैर्दीप्यमाना यथाऽग्नयः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2210958, "chapter_id": 5507, "verse_number": "१०७", "content_sanskrit": "गृहावसथदातारो गृहैः काञ्चनवेदिकैः ।\nव्रजन्ति बालसूर्याभैर्धर्मराजपुरं नराः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2210959, "chapter_id": 5507, "verse_number": "१०८", "content_sanskrit": "जलभाजनदातारः कुण्डिकाकरकप्रदाः ।\nपूज्यमाना वरस्त्रीभिर्यान्ति तृप्ता महागजैः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2210960, "chapter_id": 5507, "verse_number": "१०९", "content_sanskrit": "पादाभ्यङ्गं शिरोभ्यङ्गं यानं पादोदकं तथा ।\nये प्रयच्छन्ति विप्रेभ्यस्ते यान्त्यश्वैर्यमालयम् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2210961, "chapter_id": 5507, "verse_number": "११०", "content_sanskrit": "विश्रामयन्ति ये विप्रान् श्रान्तानध्वनि कर्शितान् ।\nचक्रवाकप्रयुक्तेन यान्ति यानेन तेऽपि च ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2210962, "chapter_id": 5507, "verse_number": "१११", "content_sanskrit": "स्वागतेन च यो विप्रं पूजयेदासनेन च ।\nस गच्छति तमध्वानं सुखं परमनिर्वृतः ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2210963, "chapter_id": 5507, "verse_number": "११२", "content_sanskrit": "नमो ब्रह्मण्यदेवाय यो मां दृष्ट्वाऽभिवादयेत् ।\nव्रतवत् प्रयतो नित्यं स सुखं याति तत्पथम् ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2210964, "chapter_id": 5507, "verse_number": "११३", "content_sanskrit": "नमः सर्वसहाभ्यश्चेत्यभिधाय दिने दिने ।\nनमस्करोति गोभ्यो यः स सुखं याति तत्पथम् ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2210965, "chapter_id": 5507, "verse_number": "११४", "content_sanskrit": "नमोऽस्तु प्रियदत्तायैत्येवंवादी दिने दिने ।\nभुमिमाक्रमते प्रातः शयनादुत्थितस्तु यः ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2210966, "chapter_id": 5507, "verse_number": "११५", "content_sanskrit": "स सर्वकामतृप्तात्मा सर्वभूषणभूषितः ।\nयाति यानेन दिव्येन सुखं वैवस्वतालयम् ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2210967, "chapter_id": 5507, "verse_number": "११६", "content_sanskrit": "अनन्तराशिनो ये तु डम्भाहङ्कारवर्जिताः ।\nतेऽपि सारसयुक्तेन यान्ति यानेन वै सुखम् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2210968, "chapter_id": 5507, "verse_number": "११७", "content_sanskrit": "ये चाप्येकेन भक्तेन वर्तन्ते डम्भवर्जिताः ।\nहंसयुक्तैर्विमानैस्तु सुखं यान्ति यमालयम् ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2210969, "chapter_id": 5507, "verse_number": "११८", "content_sanskrit": "चतुर्थेन हि भक्तेन वर्तन्ते ये जितेन्द्रियाः ।\nयान्ति ते धर्मनगरं यानैर्बर्हिणयोजितैः ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2210970, "chapter_id": 5507, "verse_number": "११९", "content_sanskrit": "तृतीयदिवसेनेह भुञ्जते ये जितेन्द्रियाः ।\nतेऽपि हस्तिरथैर्यान्ति तत्पथं कनकोज्ज्वलैः ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2210971, "chapter_id": 5507, "verse_number": "१२०", "content_sanskrit": "षष्ठान्नकालिको यस्तु वर्षमेकं तु वर्तते ।\nकामक्रोधविनिर्मुक्तः शुचिर्नित्यं जितेन्द्रियः ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2210972, "chapter_id": 5507, "verse_number": "१२१", "content_sanskrit": "स याति कुञ्जरस्थस्तु जयशब्दरवैर्युतः ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2210973, "chapter_id": 5507, "verse_number": "१२२", "content_sanskrit": "पक्षोपवासिनो यान्ति यानैः शार्दूलयोजितैः ।\nधर्मराजपुरं रम्यं दिव्यस्त्रीगणसेवितम् ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2210974, "chapter_id": 5507, "verse_number": "१२३", "content_sanskrit": "ये च मासोपवासं वै कुर्वते संयतेन्द्रियाः ।\nतेऽपि सूर्योदयप्रख्यैर्यान्ति यानैर्यमालयम् ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2210975, "chapter_id": 5507, "verse_number": "१२४", "content_sanskrit": "अग्निप्रवेशं यश्चापि कुरुते मद्गतात्मना ।\nस यात्यग्निप्रकाशेन विमानेन यमालयम् ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2210976, "chapter_id": 5507, "verse_number": "१२५", "content_sanskrit": "प्राणांस्त्यजति यो विप्रो मां प्रपन्नो ह्यनाशकः ।\nस बालार्कप्रकाशेन व्रजेद् यानेन तत्पथम् ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2210977, "chapter_id": 5507, "verse_number": "१२६", "content_sanskrit": "प्रविष्टोऽन्तर्जले यस्तु प्राणांस्त्यजति मानवः ।\nसोममण्डलयानेन याति यानेन तत्पथम् ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2210978, "chapter_id": 5507, "verse_number": "१२७", "content_sanskrit": "स्वशरीरं हि गृध्राणां मन्मना यः प्रयच्छति ।\nस याति रथमुख्येन काञ्चनेन यमालयम् ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2210979, "chapter_id": 5507, "verse_number": "१२८", "content_sanskrit": "गोकृते स्त्रीकृते चैव हता विप्रकृतेऽपि ये ।\nते यान्त्यमरकन्याभिः सेव्यमाना रविप्रभाः ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2210980, "chapter_id": 5507, "verse_number": "१२९", "content_sanskrit": "ये च कुर्वन्ति मद्भक्त्या तीर्थयात्रां जितेन्द्रियाः ।\nते पन्थानं महात्मानो यानैर्यान्ति सुखं नराः ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2210981, "chapter_id": 5507, "verse_number": "१३०", "content_sanskrit": "ये यजन्ति द्विजश्रेष्ठाः क्रतुभिभूरिदक्षिणैः ।\nहंससारसयुक्तेन यान्ति यानेन तत्पथम् ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2210982, "chapter_id": 5507, "verse_number": "१३१", "content_sanskrit": "परपीडामकृत्वैव भृत्यान् बिभ्रति ये नराः ।\nतत्पथं ते सुखं यान्ति विमानैः काञ्चनोज्ज्वलैः ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 2210983, "chapter_id": 5507, "verse_number": "१३२", "content_sanskrit": "ये समाः सर्वभूतेषु जीवानामभयप्रदाः ।\nक्रोधलोभविनिर्मुक्ता निगृहीतेन्द्रियास्तथा ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 2210984, "chapter_id": 5507, "verse_number": "१३३", "content_sanskrit": "पूर्णचन्द्रप्रतीकाशैर्विमानैस्ते महाप्रभाः ।\nयान्ति वैवस्वतपुरं देवगन्धर्वसेविताः ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 2210985, "chapter_id": 5507, "verse_number": "१३४", "content_sanskrit": "ये मामेकान्तभावेन भक्त्या त्र्यम्बकमेव वा ।\nपूजयन्ति नमस्यन्ति स्तुवन्ति च दिने दिने ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 2210986, "chapter_id": 5507, "verse_number": "१३५", "content_sanskrit": "धर्मराजपुरं यान्ति यानैस्तेऽर्कसमप्रभैः ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 2210987, "chapter_id": 5507, "verse_number": "१३६", "content_sanskrit": "पूजितास्तत्र धर्मेण स्वयं माल्यादिभिर्गुणैः ।\nयान्त्येव मम लोकं वा रुद्रलोकमथापि वा ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 2210988, "chapter_id": 5507, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि वैष्णवधर्मशास्त्रे एकाधिकशततमोऽध्यायः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}]