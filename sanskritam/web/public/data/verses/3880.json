[{"id": 2133556, "chapter_id": 3880, "verse_number": "", "content_sanskrit": "धर्मव्याधेन कौशिकं प्रति मातापितृशुश्रूषणचोदनपूर्वकं स्वस्य शूद्रयोनौ जनननिदानकथनम् । धर्मन्याधेन नानाधर्मान् बोधितेन कौशिकेन गृहमेत्य स्वपित्रोः शुश्रूषणम् । मार्कण्डेयेन युधिष्ठिरं प्रति पतिव्रतामाहात्म्यादिकथनोपसंहारः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2133557, "chapter_id": 3880, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2133558, "chapter_id": 3880, "verse_number": "१", "content_sanskrit": "गुरू निवेद्य विप्राय तौ मातापितरावुभौ ।\nपुनरेव स धर्मात्मा व्याधो ब्राह्मणमब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2133559, "chapter_id": 3880, "verse_number": "२", "content_sanskrit": "प्रवृत्तचक्षुर्जातोऽस्मि सम्पश्य तपसो बलम् ।\nयदर्थमुक्तोऽसि तया गच्छ त्वं मिथिलामिति\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2133560, "chapter_id": 3880, "verse_number": "३", "content_sanskrit": "पतिशुश्रूषपरया दान्तया सत्यशीलया ।\nमिथिलायां वसेद् व्याधः स ते धर्मान् प्रवक्ष्यति\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2133561, "chapter_id": 3880, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2133562, "chapter_id": 3880, "verse_number": "४", "content_sanskrit": "पतिव्रतायाः सत्यायाः शीलाढ्याया यतव्रत ।\nसंस्मृत्य वाक्यं धर्मज्ञ गुणवानसि मे मतः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2133563, "chapter_id": 3880, "verse_number": "", "content_sanskrit": "व्याधः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2133564, "chapter_id": 3880, "verse_number": "५", "content_sanskrit": "यत् तदा त्वं द्विजश्रेष्ठ तयोक्तो मां प्रति प्रभो ।\nदृष्टमेव तया सम्यगेकपत्न्या न संशयः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2133565, "chapter_id": 3880, "verse_number": "६", "content_sanskrit": "त्वदनुग्रहबुद्ध्या तु विप्रैतद् दर्शितं मया ।\nवाक्यं च शृणु मे तात यत् ते वक्ष्ये हितं द्विज \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2133566, "chapter_id": 3880, "verse_number": "७", "content_sanskrit": "त्वया विनिकृता माता पिता च द्विजसत्तम ।\nअनिसृष्टोऽसि निष्क्रान्तो गृहात् ताभ्यामनिन्दित ।\nवेदोच्चारणकार्यार्थमयुक्तं तत् त्वया कृतम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2133567, "chapter_id": 3880, "verse_number": "८", "content_sanskrit": "तव शोकेन वृद्धौ तावन्धीभूतौ तपस्विनौ ।\nतौ प्रसादयितुं गच्छ मा त्वां धर्मोऽत्यगादयम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2133568, "chapter_id": 3880, "verse_number": "९", "content_sanskrit": "तपस्वी त्वं महात्मा च धर्मे च निरतः सदा ।\nसर्वमेतदपार्थं ते क्षिप्रं तौ सम्प्रसादय ।\nतौ प्रसाद्य द्विजश्रेष्ठ यच्छ्रेयस्तदवाप्स्यसि\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2133569, "chapter_id": 3880, "verse_number": "१०", "content_sanskrit": "श्रद्दधस्व मम ब्रह्मन् नान्यथा कर्तुमर्हसि ।\nगम्यतामद्य विप्रर्षे श्रेयस्ते कथयाम्यहम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2133570, "chapter_id": 3880, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2133571, "chapter_id": 3880, "verse_number": "११", "content_sanskrit": "यदेतदुक्तं भवता सर्वं सत्यमसंशयम् ।\nप्रीतोऽस्मि तव भद्रं ते धर्माचारगुणान्वित \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2133572, "chapter_id": 3880, "verse_number": "", "content_sanskrit": "व्याधः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2133573, "chapter_id": 3880, "verse_number": "१२", "content_sanskrit": "दैवतप्रतिमो हि त्वं यस्त्वं धर्ममनुव्रतः ।\nपुराणं शाश्वतं दिव्यं दुष्प्राप्यमकृतात्मभिः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2133574, "chapter_id": 3880, "verse_number": "१३", "content_sanskrit": "मातापित्रोः सकाशं हि गत्वा त्वं द्विजसत्तम।\nअतन्द्रितः कुरु क्षिप्रं मातापित्रोर्हि पूजनम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2133575, "chapter_id": 3880, "verse_number": "१४", "content_sanskrit": "अतः परमहं धर्मं नान्यं पश्यामि कञ्चन\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2133576, "chapter_id": 3880, "verse_number": "", "content_sanskrit": "कौशिकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2133577, "chapter_id": 3880, "verse_number": "१५", "content_sanskrit": "इहाहमागतो दिष्ट्या दिष्ट्या मे सङ्गतं त्वया ।\nईदृशा दुर्लभा लोके नरा धर्मप्रदर्शकाः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2133578, "chapter_id": 3880, "verse_number": "१६", "content_sanskrit": "एको नरसहस्रेषु धर्मविद् विद्यते न वा ।\nप्रीतोऽस्मि तव सत्येन भद्रं ते पुरुषर्षभ\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2133579, "chapter_id": 3880, "verse_number": "९७", "content_sanskrit": "पतमानोऽद्य नरके भवताऽस्मि समुद्धृतः ।\nभवितव्यमथैवं च यद् दृष्टोऽसि मयानघ\t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2133580, "chapter_id": 3880, "verse_number": "१८", "content_sanskrit": "राजा ययातिर्दौहित्रैः पतितस्तारितो यथा ।\nसद्भिः पुरुषशार्दूल तथाऽहं भवता द्विजः\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2133581, "chapter_id": 3880, "verse_number": "१९", "content_sanskrit": "मातापितृभ्यां शुश्रूषां करिष्ये वचनात् तव ।\nनाकृतात्मा वेदयति धर्माधर्मविनिश्चयम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2133582, "chapter_id": 3880, "verse_number": "२०", "content_sanskrit": "दुर्ज्ञेयः शाश्वतो धर्मः शूद्रयोनौ हि वर्तते ।\nन त्वां शूद्रमहं मन्ये भवितव्यं हि कारणम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2133583, "chapter_id": 3880, "verse_number": "२१", "content_sanskrit": "येन कर्मविशेषेण प्राप्तेयं शूद्रता त्वया ।\nएतदिच्छामि विज्ञातुं तत्त्वेन हि महामते ।\nकामया ब्रूहि मे सर्वं सत्येन प्रयतात्मना\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2133584, "chapter_id": 3880, "verse_number": "", "content_sanskrit": "व्याधः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2133585, "chapter_id": 3880, "verse_number": "२२", "content_sanskrit": "अनतिक्रमणीया वै ब्राह्मणा मे द्विजोत्तम ।\nशृणु सर्वमिदं वृत्तं पूर्वदेहे ममानघ\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2133586, "chapter_id": 3880, "verse_number": "२३", "content_sanskrit": "अहं हि ब्राह्मणः पूर्वमासं द्विजवरात्मजः ।\nवेदाध्यायी सुकुशलो वेदाङ्गानां च पारगः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2133587, "chapter_id": 3880, "verse_number": "२४", "content_sanskrit": "आत्मदोषकृतैर्ब्रह्मन्नवस्थामाप्तवानिमाम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2133588, "chapter_id": 3880, "verse_number": "२५", "content_sanskrit": "कश्चिद् राजा मम सखा धनुर्वेदपरायणः ।\nसंसर्गाद् धनुषि श्रेष्ठस्ततोऽहमभवं द्विज \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2133589, "chapter_id": 3880, "verse_number": "२६", "content_sanskrit": "एतस्मिन्नेव काले तु मृगयां निर्गतो नृपः ।\nसहितो योधमुख्यैश्च मन्त्रिभिश्च सुसंवृतः ।\nततोऽभ्यहन् मृगांस्तत्र सुबहूनाश्रमं प्रति\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2133590, "chapter_id": 3880, "verse_number": "२७", "content_sanskrit": "अथ क्षिप्तः शरो घोरो मयाऽपि द्विजसत्तम ।\nताडितश्च ऋषिस्तेन शरेणानतपर्वणा\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2133591, "chapter_id": 3880, "verse_number": "२८", "content_sanskrit": "भूमौ निपतितो ब्रह्मन्नुवाच प्रतिनादयन् ।\nनापराध्याम्यहं किञ्चित् केन पापमिदं कृतम् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2133592, "chapter_id": 3880, "verse_number": "२९", "content_sanskrit": "मन्वानस्तं मृगं चाहं सम्प्राप्तः सहसा प्रभो ।\nअपश्यं तमृषिं विद्धं शरेणानतपर्वणा\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2133593, "chapter_id": 3880, "verse_number": "३०", "content_sanskrit": "तमुग्रतपसं विप्रं निष्टनन्तं महीतळे ।\nअकार्यकरणाच्चापि भृशं मे व्यथितं मनः\t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2133594, "chapter_id": 3880, "verse_number": "३१", "content_sanskrit": "अजानता कृतमिदं मयेत्यहमथाब्रुवम् ।\nक्षन्तुमर्हसि मे सर्वमिति चोक्तो मया मुनिः \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2133595, "chapter_id": 3880, "verse_number": "३२", "content_sanskrit": "ततः प्रत्यब्रवीद् वाक्यमृषिर्मां क्रोधमूर्छितः ।\nव्याधस्त्वं भविता क्रूर शूद्रयोनाविति द्विज \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2133596, "chapter_id": 3880, "verse_number": "३३", "content_sanskrit": "एवं शप्तोऽहमृषिणा तदा द्विजवरोत्तम ।\nअभिप्रसादयमृषिं गिरा त्राहीति मां तदा \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2133597, "chapter_id": 3880, "verse_number": "३४", "content_sanskrit": "अजानता मयाकार्यमिदमद्य कृतं मुने ।\nक्षन्तुमर्हसि तत्सर्वं प्रसीद भगवन्निति\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2133598, "chapter_id": 3880, "verse_number": "", "content_sanskrit": "ऋषिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2133599, "chapter_id": 3880, "verse_number": "३५", "content_sanskrit": "नान्यथा भविता शाप एवमेतदसंशयम् ।\nआनृशंस्यात् त्वहं किञ्चित् कर्ताऽनुग्रहमद्य ते\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2133600, "chapter_id": 3880, "verse_number": "३६", "content_sanskrit": "शूद्रयोन्यां वर्तमानो धर्मज्ञो हि भविष्यसि ।\nमातापित्रोश्च शुश्रूषां करिष्यसि न संशयः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2133601, "chapter_id": 3880, "verse_number": "३७", "content_sanskrit": "तया शुश्रूषया सिद्धिं महतीं समवाप्स्यसि ।\nजातिस्मरश्च भविता स्वर्गं चैव गमिष्यसि\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2133602, "chapter_id": 3880, "verse_number": "३८", "content_sanskrit": "भूत्वा च धार्मिको व्याधः पितृशुश्रूषणे रतः ।\nशापक्षये तु निर्वृत्ते भवितासि पुनर्द्विजः\t ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2133603, "chapter_id": 3880, "verse_number": "", "content_sanskrit": "व्याधः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2133604, "chapter_id": 3880, "verse_number": "३९", "content_sanskrit": "एवं शप्तः पुरा तेन ऋषिणाऽस्म्युग्रतेजसा ।\nप्रसादश्च कृतस्तेन ममैवं द्विपदांवर \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2133605, "chapter_id": 3880, "verse_number": "४०", "content_sanskrit": "शरं चोद्धृतवानस्मि तस्य वै द्विजसत्तम ।\nआश्रमं च मया नीतो न च प्राणैर्व्ययुज्यत\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2133606, "chapter_id": 3880, "verse_number": "४१", "content_sanskrit": "एतत् ते सर्वमाख्यातं यथा मम पुराऽभवत् ।\nअभितश्चापि गन्तव्यं मया स्वर्गं द्विजोत्तम \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2133607, "chapter_id": 3880, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2133608, "chapter_id": 3880, "verse_number": "४२", "content_sanskrit": "एवमेतानि पुरुषा दुःखानि च सुखानि च ।\nआप्नुवन्ति महाबुद्धे नोत्कण्ठां कर्तुमर्हसि\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2133609, "chapter_id": 3880, "verse_number": "४३", "content_sanskrit": "दुष्करं हि कृतं कर्म जानता जातिमात्मनः \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2133610, "chapter_id": 3880, "verse_number": "", "content_sanskrit": "लोकवृत्तान्ततत्त्वज्ञ नित्यं धर्मपरायण ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2133611, "chapter_id": 3880, "verse_number": "४४", "content_sanskrit": "कर्मदोषश्च वै विद्वन्नात्मजातिकृतेन ते ।\nकञ्चित् कालं मृष्यतां वै ततोऽसि भविता द्विजः ।\nसाम्प्रतं च मतो मेऽसि ब्राह्मणो नात्र संशयः \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2133612, "chapter_id": 3880, "verse_number": "४५", "content_sanskrit": "ब्राह्मणः पतनीयेषु वर्तमानो विकर्मसु ।\nदाम्भिको दुष्कृतः प्रायः शूद्रेण सदृशो भवेत्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2133613, "chapter_id": 3880, "verse_number": "४६", "content_sanskrit": "यस्तु शूद्रो दमे सत्ये धर्मे च सततोत्थितः ।\nतं ब्राह्मणमहं मन्ये वृत्तेन हि भवेद् द्विजः \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2133614, "chapter_id": 3880, "verse_number": "४७", "content_sanskrit": "कर्मदोषेण विषमां गतिमाप्नोति दारुणाम् ।\nक्षीणदोषमहं मन्ये चाभितस्त्वां नरोत्तम\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2133615, "chapter_id": 3880, "verse_number": "४८", "content_sanskrit": "कर्तुमर्हसि नोत्कण्ठां त्वद्विधा ह्यविषादिनः ।\nलोकवृत्तानुवृत्तज्ञा नित्यं धर्मपरायणाः \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2133616, "chapter_id": 3880, "verse_number": "", "content_sanskrit": "व्याधः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2133617, "chapter_id": 3880, "verse_number": "४९", "content_sanskrit": "प्रज्ञया मानसं दुःखं हन्याच्छारीरमौषधैः ।\nएतद् विज्ञानसामर्थ्यं न बालैः समतामियात् \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2133618, "chapter_id": 3880, "verse_number": "५०", "content_sanskrit": "अनिष्टसम्प्रयोगाच्च विप्रयोगात् प्रियस्य च ।\nमनुष्या मानसैर्दुःखैर्युज्यन्ते चाल्पबुद्धयः\t ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2133619, "chapter_id": 3880, "verse_number": "५१", "content_sanskrit": "गुणैर्भूतानि युज्यन्ते वियुज्यन्ते तथैव च ।\nसर्वाणि नैतदेकस्य शोकस्थानं हि विद्यते\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2133620, "chapter_id": 3880, "verse_number": "५२", "content_sanskrit": "अनिष्टं चान्वितं पश्यंस्तथा क्षिप्रं विरज्यते ।\nततश्च प्रतिकुर्वन्ति यदि पश्यन्त्युपक्रमात्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2133621, "chapter_id": 3880, "verse_number": "५३", "content_sanskrit": "शोचतो न भवेत् किञ्चित् केवलं परितप्यते \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2133622, "chapter_id": 3880, "verse_number": "५४", "content_sanskrit": "परित्यजन्ति ये दुःखं सुखं वाप्युभयं नराः ।\nत एव सुखमेधन्ते ज्ञानतृप्ता मनीषिणः ।\nअसन्तोषपरा मूढाः सन्तोषं यान्ति पण्डिताः \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2133623, "chapter_id": 3880, "verse_number": "५५", "content_sanskrit": "असन्तोषस्य नास्त्यन्तस्तुष्टिस्तु परमं सुखम् ।\nन शोचन्ति गताध्वानः पश्यन्तः परमां गतिम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2133624, "chapter_id": 3880, "verse_number": "५६", "content_sanskrit": "न विषादे मनः कार्यं विषादो विषमुत्तमम् ।\nमारयत्यकृतप्रज्ञं बालं क्रुद्ध इवोरगः \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2133625, "chapter_id": 3880, "verse_number": "५७", "content_sanskrit": "यं विषादोऽभिभवति विक्रमे समुपस्थिते ।\nतेजसा तस्य हीनस्य पुरुषार्थो न विद्यते\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2133626, "chapter_id": 3880, "verse_number": "५८", "content_sanskrit": "अवश्यं क्रियमाणस्य कर्मणो दृश्यते फलम् ।\nन हि निर्वेदमागम्य किञ्चित् प्राप्नोति शोभनम्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2133627, "chapter_id": 3880, "verse_number": "५९", "content_sanskrit": "अथाप्युपायं पश्येत दुःखस्य परिमोक्षणे ।\nअशोचं नारभेतैव युक्तश्चाव्यसनी भवेत्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2133628, "chapter_id": 3880, "verse_number": "६०", "content_sanskrit": "भूतेष्वभावं सञ्चिन्त्य ये तु बुद्धेः परं गताः ।\nन शोचन्ति कृतप्रज्ञाः पश्यन्तः परमां गतिम्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2133629, "chapter_id": 3880, "verse_number": "६१", "content_sanskrit": "न शोचामि च वै विद्वन् कालाकाङ्क्षी स्थितो ह्यहम् ।\nएतैर्निदर्शनैर्ब्रह्मन् नावसीदामि सत्तम\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2133630, "chapter_id": 3880, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2133631, "chapter_id": 3880, "verse_number": "६२", "content_sanskrit": "कृतप्रज्ञोऽसि मेधावी बुद्धिर्हि विपुला तव ।\nनाहं भवन्तं शोचामि ज्ञानतृप्तोऽसि धर्मवित् \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2133632, "chapter_id": 3880, "verse_number": "६३", "content_sanskrit": "आपृच्छे त्वां स्वस्ति तेऽस्तु धर्मस्त्वां परिरक्षतु ।\nअप्रमादस्तु कर्तव्यो धर्मे धर्मभृतां वर \t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2133633, "chapter_id": 3880, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2133634, "chapter_id": 3880, "verse_number": "६४", "content_sanskrit": "बाढमित्येव तं व्याधः कृताञ्जलिरुवाच ह ।\nप्रदक्षिणमथो कृत्वा प्रस्थितो द्विजसत्तमः \t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2133635, "chapter_id": 3880, "verse_number": "६५", "content_sanskrit": "स तु गत्वा द्विजः सर्वां शुश्रूषां कृतवांस्तदा ।\nमातापितृभ्यां वृद्धाभ्यां यथान्यायं सुशंसितः \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2133636, "chapter_id": 3880, "verse_number": "६६", "content_sanskrit": "एतत् ते सर्वमाख्यातं निखिलेन युधिष्ठिर ।\nपृष्टवानसि यं तात धर्मं धर्मभृतां वर \t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2133637, "chapter_id": 3880, "verse_number": "६७", "content_sanskrit": "पतिव्रताया माहात्म्यं ब्राह्मणस्य च सत्तम ।\nमातापित्रोश्च शुश्रूषा धर्मव्याधेन कीर्तिता\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2133638, "chapter_id": 3880, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2133639, "chapter_id": 3880, "verse_number": "६८", "content_sanskrit": "अत्यद्भुतमिदं ब्रह्मन् धर्माख्यानमनुत्तमम् ।\nसर्वधर्मविदां श्रेष्ठ कथितं मुनिसत्तम \t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2133640, "chapter_id": 3880, "verse_number": "६९", "content_sanskrit": "सुखश्रव्यतया विद्वन् मुहूर्त इव मे गतः ।\nन हि तृप्तोऽस्मि भगवन् शृण्वानो धर्ममुत्तमम् \t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2133641, "chapter_id": 3880, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि मार्कण्डेयसमास्यापर्वणि ब्राह्मणव्याधसंवादे एकाधिकद्विशततमोऽध्यायः ॥२०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2133642, "chapter_id": 3880, "verse_number": "", "content_sanskrit": "॥ इति मार्कण्डेयसमास्यापर्वणि षड्विंशोऽध्यायः ॥२६॥\n* * * * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}]