[{"id": 2109019, "chapter_id": 3365, "verse_number": "", "content_sanskrit": "शौनकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2109020, "chapter_id": 3365, "verse_number": "१", "content_sanskrit": "यदपृच्छत् तदा राजा मन्त्रिणो जनमेजयः ।\nपितुः स्वर्गगतिं तन्मे विस्तरेण पुनर्वद \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2109021, "chapter_id": 3365, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2109022, "chapter_id": 3365, "verse_number": "२", "content_sanskrit": "शृणु ब्रह्मन् यथापृष्टा मन्त्रिणो नृपतेस्तदा ।\nआख्यातवन्तस्ते सर्वे निधनं तत् परीक्षितः\t ॥ २॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2109023, "chapter_id": 3365, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2109024, "chapter_id": 3365, "verse_number": "३", "content_sanskrit": "जानन्ति तु भवन्तस्तद् यथावृत्तः पिता मम ।\nआसीद् यथा च निधनं गतः काले महायशाः\t ॥ ३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2109025, "chapter_id": 3365, "verse_number": "४", "content_sanskrit": "श्रुत्वा भवत्सकाशाद्धि पितुर्वधमशेषतः ।\nकल्याणं प्रतिपत्स्यामि विपरीतं न जातुचित्\t ॥ ४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2109026, "chapter_id": 3365, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2109027, "chapter_id": 3365, "verse_number": "५", "content_sanskrit": "मन्त्रिणोऽथाब्रुवन् वाक्यं पृष्टास्तेन महात्मना ।\nसर्वधर्मविदः प्राज्ञा राजानं जनमेजयम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2109028, "chapter_id": 3365, "verse_number": "६", "content_sanskrit": "शृणु पार्थिव यद्रूपं पितुस्तव महात्मनः ।\nचरितं पार्थिवेन्द्रस्य यथा स निधनं गतः\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2109029, "chapter_id": 3365, "verse_number": "", "content_sanskrit": "मन्त्रिणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2109030, "chapter_id": 3365, "verse_number": "७", "content_sanskrit": "धर्मात्मा च महात्मा च प्रजापालः पिता तव ।\nआसीदिह यथावृत्तः स महात्मा शृणुष्व तत् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2109031, "chapter_id": 3365, "verse_number": "८", "content_sanskrit": "चातुर्वर्ण्यं स्वधर्मस्थं स कृत्वा पर्यरक्षत ।\nधर्मतो धर्मविद् राजा धर्मो विग्रहवानिव \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2109032, "chapter_id": 3365, "verse_number": "९", "content_sanskrit": "अरक्षत् पृथिवीं देवीं श्रीमानतुलविक्रमः ।\nद्वेष्टारस्तस्य नैवासन् स च न द्वेष्टि कञ्चन \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2109033, "chapter_id": 3365, "verse_number": "१०", "content_sanskrit": "समः सर्वेषु भूतेषु प्रजापतिरिवाभवत् ।\nब्राह्मणाः क्षत्रिया वैश्याः शूद्राश्चैव स्वकर्मसु \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2109034, "chapter_id": 3365, "verse_number": "११", "content_sanskrit": "स्थिताः सुमनसो राजंस्तेन राज्ञा स्वनुष्ठिताः ।\nविधवानाथकृपणान् विकलांश्च बभार सः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2109035, "chapter_id": 3365, "verse_number": "१२", "content_sanskrit": "सुदर्शः सर्वभूतानामासीत् सोम इवापरः ।\nहृष्टपुष्टजनः श्रीमान् सत्यवाग् दृढविक्रमः \t ॥ १२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2109036, "chapter_id": 3365, "verse_number": "१३", "content_sanskrit": "धनुर्वेदे च शिष्योऽभूत् नृपः शारद्वतस्य सः ।\nजितेन्द्रियश्चात्मवांश्च मेधावी वृद्धसेवया \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2109037, "chapter_id": 3365, "verse_number": "१४", "content_sanskrit": "षड्वर्गजिन्महाबुद्धिर्नीतिकर्मविदुत्तमः ।\nगोविन्दस्य प्रियश्चासीत् पिता ते जनमेजय \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2109038, "chapter_id": 3365, "verse_number": "१५", "content_sanskrit": "लोकस्य चैव सर्वस्य प्रिय आसीन्महायशाः ।\nपरिक्षीणेषु कुरुषु उत्तरायामजायत\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2109039, "chapter_id": 3365, "verse_number": "१६", "content_sanskrit": "परीक्षिदभवत् तेन सौभद्रस्यात्मजो बली ।\nराजधर्मार्थकुशलो युक्तः सर्वगुणैर्नृप \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2109040, "chapter_id": 3365, "verse_number": "१७", "content_sanskrit": "प्रजा इमास्तव पिता षष्टिवर्षाण्यपालयत् ।\nततो दिष्टान्तमापन्नः सर्पेणानतिवर्तिना \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2109041, "chapter_id": 3365, "verse_number": "१८", "content_sanskrit": "ततस्त्वं पुरुषश्रेष्ठ धर्मेण प्रतिपेदिवान् ।\nइदं वर्षसहस्राय राज्यं कुलधरागतम् ।\nबाल एवाभिजातोऽसि सर्वभूतानुकम्पनः\t ॥ १८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2109042, "chapter_id": 3365, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2109043, "chapter_id": 3365, "verse_number": "१९", "content_sanskrit": "नास्मिन् कुले जातु बभूव राजा\nयो न प्रजानां प्रियकृत् प्रियश्च\nविशेषतः प्रेक्ष्य पितामहानां\nवृत्तं महद्वृत्तपरायणानाम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2109044, "chapter_id": 3365, "verse_number": "२०", "content_sanskrit": "कथं निधनमापन्नः पिता मम तथाविधः ।\nआचक्षध्वं यथावन्मे श्रोतुमिच्छामि तत्त्वतः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2109045, "chapter_id": 3365, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2109046, "chapter_id": 3365, "verse_number": "२१", "content_sanskrit": "एवं सम्बोधिता राज्ञा मन्त्रिणस्ते नराधिपम् ।\nऊचुः सर्वे यथातत्त्वं राज्ञः प्रियहिते रताः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2109047, "chapter_id": 3365, "verse_number": "", "content_sanskrit": "मन्त्रिणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2109048, "chapter_id": 3365, "verse_number": "२२", "content_sanskrit": "स राजा पृथिवीपालः सर्वशस्त्रविदां वरः ।\nबभूव मृगयाशीलः तव राजन् पिता सदा\t ॥ २२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2109049, "chapter_id": 3365, "verse_number": "२३", "content_sanskrit": "यथा पाण्डुर्महाभागो धनुर्धरवरो युधि ।\nअस्मास्वासज्य सर्वाणि राजकार्याण्यशेषतः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2109050, "chapter_id": 3365, "verse_number": "२४", "content_sanskrit": "स कदाचिद् वनचरो मृगं विव्याध पत्रिणा ।\nविद्ध्वा चान्वसरत् तूर्णं स मृगं गहने वने \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2109051, "chapter_id": 3365, "verse_number": "२५", "content_sanskrit": "पदातिर्बद्धनिस्त्रिंशः शरपाणिर्धनुर्धरः ।\nन चाससाद गहने मृगं नष्टं पिता तव \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2109052, "chapter_id": 3365, "verse_number": "२६", "content_sanskrit": "परिश्रान्तो वयःस्थश्च षष्टिवर्षो जरान्वितः ।\nक्षुधितः स महारण्ये ददर्श मुनिमन्तिके \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2109053, "chapter_id": 3365, "verse_number": "२७", "content_sanskrit": "स तं पप्रच्छ राजेन्द्रो मुनिं मौनव्रतान्वितम् ।\nन च किञ्चिदुवाचैनं स मुनिः पृच्छतोऽपि सन् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2109054, "chapter_id": 3365, "verse_number": "२८", "content_sanskrit": "ततो राजा क्षुच्छ्रमार्तः तं मुनिं स्थाणुवत् स्थितम् ।\nमौनव्रतधरं श्रान्तः सद्यो मन्युवशं गतः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2109055, "chapter_id": 3365, "verse_number": "२९", "content_sanskrit": "न बुबोध च तं राजा मौनव्रतधरं मुनिम् ।\nस तं मन्युसमाविष्टो धर्षयामास ते पिता \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2109056, "chapter_id": 3365, "verse_number": "३०", "content_sanskrit": "मृतं सर्पं धनुष्कोट्या समुत्क्षिप्य धरातळात् ।\nतस्य शुद्धात्मनः प्रादात् स्कन्धे भारतसत्तम \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2109057, "chapter_id": 3365, "verse_number": "३१", "content_sanskrit": "तं नोवाच स धर्मात्मा राजानं साध्वसाधु वा ।\nतस्थौ तथैव नाक्रुध्यत् सर्पं स्कन्धेन धारयन् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2109058, "chapter_id": 3365, "verse_number": "४४", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nचतुश्चत्वारिंशोऽध्यायः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2109059, "chapter_id": 3365, "verse_number": "३२", "content_sanskrit": "॥ आस्तीकपर्वणि द्वात्रिंशोऽध्यायः॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]