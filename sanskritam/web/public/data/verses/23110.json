[{"id": 7003110000, "chapter_id": 23110, "verse_number": "४-४६-१", "content_sanskrit": "राधिकोवाच ।\nसुचिरं च मृतं कामं शंकरेण च जीवितम् ।\nरतिः पुनः प्रियं प्राप्य किं चकार मुदाऽन्विता ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003110001, "chapter_id": 23110, "verse_number": "४-४६-२", "content_sanskrit": "स्त्रीणां स्वस्वामिविच्छेदो मरणादतिदुष्करः ।\nपुनः संमेलनं भर्तुः सुखं परमदुर्लभम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003110002, "chapter_id": 23110, "verse_number": "४-४६-३", "content_sanskrit": "शिवः सतीं तां संप्राप्य सङ्गे मङ्गलकर्मणि।\nचिरं प्रनष्टविरहः किं चकार मुदाऽन्वितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003110003, "chapter_id": 23110, "verse_number": "४-४६-४", "content_sanskrit": "कलत्रविरहः पुंसां सर्वशोकात्सुदुष्करः ।\nपुनः संमीलनं तस्याः प्राणदानाधिकं सुखम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003110004, "chapter_id": 23110, "verse_number": "४-४६-५", "content_sanskrit": "रतिः पुंसो विरहिणी शिवः स्त्रीविरही चिरम् ।\nद्वयोर्द्वयोश्च संप्राप्तौ किं बभूव द्वयोः सुखम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003110005, "chapter_id": 23110, "verse_number": "४-४६-६", "content_sanskrit": "तदेवं श्रोतुमिच्छामि परं कौतूहलं मम ।\nकृपया विदुषां श्रेष्ठ सव्यासं कथय प्रभो ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003110006, "chapter_id": 23110, "verse_number": "४-४६-७", "content_sanskrit": "मेलनं शक्तिशिवयो रतिमन्मथयोस्ततः ।\nशोकापहं श्रुतवतां सर्वमङ्गलकारणम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003110007, "chapter_id": 23110, "verse_number": "४-४६-८", "content_sanskrit": "नारायण उवाच ।\nइत्युक्त्वा राधिका देवी सस्मिता विरराम ह ।\nकृष्णस्तद्वचनं श्रुत्वा सस्मितस्तामुवाच ह ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003110008, "chapter_id": 23110, "verse_number": "४-४६-९", "content_sanskrit": "कृष्ण उवाच ।\nमृतं कामं पुनः प्राप्य कामार्ता कामकामिनी ।\nस्वालयं तं समानीय हरोद्वाहगृहादहो ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003110009, "chapter_id": 23110, "verse_number": "४-४६-१०", "content_sanskrit": "भर्तुः सुवेषं विविधं स्वात्मनः स्वालिभिर्मुदा ।\nकारयामास यत्नेन सा रती रमणोत्सुका ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003110010, "chapter_id": 23110, "verse_number": "४-४६-११", "content_sanskrit": "ज्ञात्वा कामस्तु तद्भावं कामशास्त्रविधायकः ।\nरत्नयानं समारुह्य जगाम स्वालयाद्वनम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003110011, "chapter_id": 23110, "verse_number": "४-४६-१२", "content_sanskrit": "शैलेशैलेऽतिरम्ये च नद्यांनद्यां नदेनदे ।\nद्वीपेद्वीपे सिन्धुतटे पुष्पोद्याने मनोहरे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003110012, "chapter_id": 23110, "verse_number": "४-४६-१३", "content_sanskrit": "काञ्चने भूमिनिकरे वटमृलेऽतिनिर्जने ।\nनदीपुलिनभूम्यां च पुष्पिते पुष्पकानने ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003110013, "chapter_id": 23110, "verse_number": "४-४६-१४", "content_sanskrit": "भ्रमरध्वनिसंयुक्ते पुंस्कोकिलरुतश्रुते ।\nसुगन्धिवायुनाऽऽकीर्णे दधती जलसीकरम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003110014, "chapter_id": 23110, "verse_number": "४-४६-१५", "content_sanskrit": "चित्तेषु चेतनानां च हरणं योषितामहो ।\nकलामानप्रकारेण शृङ्गारं च चकार सा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003110015, "chapter_id": 23110, "verse_number": "४-४६-१६", "content_sanskrit": "पूर्णमब्दशतं दिव्यं स रेमे वामया सह ।\nदिवानिशं न बुबुधे संसक्तः सततं मुदा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003110016, "chapter_id": 23110, "verse_number": "४-४६-१७", "content_sanskrit": "तस्थतुस्तौ च तत्रैव संसक्तौ सततं मुदा ।\nसुरतौ च न विरतौ रतिशास्त्रविशारदौ ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003110017, "chapter_id": 23110, "verse_number": "४-४६-१८", "content_sanskrit": "पतिविच्छेदसंतापं विजहौ सा रतिर्मुदा ।\nप्राप्य रत्नमपहृतं कः क्षणं त्यक्तुमुत्सहेत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003110018, "chapter_id": 23110, "verse_number": "४-४६-१९", "content_sanskrit": "इत्येवं कथितं सर्वं रतिसंतापकारणम् ।\nशृङ्गारं शक्तिशिवयोरतुलं शृणु राधिके ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003110019, "chapter_id": 23110, "verse_number": "४-४६-२०", "content_sanskrit": "शृण्वतां कर्णपीयूषं परमाश्चर्यमीप्सितम् ।\nसर्वसंतापहरणं सुखदं पुण्यदं शुभम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003110020, "chapter_id": 23110, "verse_number": "४-४६-२१", "content_sanskrit": "वसञ्छ्वशुरगेहे स पार्वत्या सह शंकरः ।\nतदनुज्ञां समादाय क्रीडार्थं प्रययौ वनम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003110021, "chapter_id": 23110, "verse_number": "४-४६-२२", "content_sanskrit": "रत्नस्यन्दनमारुह्य रत्नसारपरिच्छदम्।\nरत्नसारेण खचितं रचितं विश्वकर्मणा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003110022, "chapter_id": 23110, "verse_number": "४-४६-२३", "content_sanskrit": "शतशृङ्गे सुवसने मलये गन्धमादने ।\nनन्दने पुष्पभद्रे च पारिभद्रे च भद्रके ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003110023, "chapter_id": 23110, "verse_number": "४-४६-२४", "content_sanskrit": "पुलिन्दे च कलिन्दे च पुंड्रे पिंडारकेंऽधके ।\nवनेवनेऽतिरम्ये च सागराणां तटेतटे ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003110024, "chapter_id": 23110, "verse_number": "४-४६-२५", "content_sanskrit": "निकटेऽस्तगिरेः पार्श्ववटमूले मनोहरे ।\nचकार करुणां यत्र परित्यज्य सती शिवम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003110025, "chapter_id": 23110, "verse_number": "४-४६-२६", "content_sanskrit": "नानास्थानेषु  रहसि पशुपक्षिविवर्जिते ।\nयथामनोरथंगामी स रेमे वामया सह ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003110026, "chapter_id": 23110, "verse_number": "४-४६-२७", "content_sanskrit": "यत्रयत्र शिवं नीत्वा बभ्राम धरणीतलम् ।\nतत्सर्वं दर्शयामास सतीं शंभुर्मुदाऽन्वितः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003110027, "chapter_id": 23110, "verse_number": "४-४६-२८", "content_sanskrit": "कृत्वा विहारं सुचिरं न पूर्णं मानसं तयोः ।\nमहाशृङ्गारमारेभे सहस्राब्दं जगत्पिता ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003110028, "chapter_id": 23110, "verse_number": "४-४६-२९", "content_sanskrit": "मायातीतोऽतिमायेशो मायासक्तः स्वमायया ।\nकालं न बुबुधे योगी सुखेन कालकारकः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003110029, "chapter_id": 23110, "verse_number": "४-४६-३०", "content_sanskrit": "शक्तिशक्तिमतोस्तत्र न बभूव परिश्रमः ।\nजहतोः सर्वसंतापमन्योन्यविरहोद्भवम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003110030, "chapter_id": 23110, "verse_number": "४-४६-३१", "content_sanskrit": "सुखसंसक्तमनसोः पुलकाञ्चितगात्रयोः ।\nकामबाणमूर्च्छितयोः पुष्पशय्याशयानयोः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003110031, "chapter_id": 23110, "verse_number": "४-४६-३२", "content_sanskrit": "नग्नयोः सुखसंभोगाद्रतिशास्त्रविधिज्ञयोः ।\nनखदन्तप्रहारैश्च क्षतविक्षतदेहयोः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003110032, "chapter_id": 23110, "verse_number": "४-४६-३३", "content_sanskrit": "चन्दनागुरुकस्तूरीसिन्दूरबिन्दुलिप्तयोः। ।\nनिबद्धकेशकबरीश्लथयोश्छिन्नमाल्य योः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003110033, "chapter_id": 23110, "verse_number": "४-४६-३४", "content_sanskrit": "वसनानां नूपुराणां कङ्कणानां च सुन्दरि ।\nवलयानां कुण्डलानां शब्दैः क्रीडां प्रकुर्वतोः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003110034, "chapter_id": 23110, "verse_number": "४-४६-३५", "content_sanskrit": "पुष्पतल्पं दलितयोर्बाष्पोत्कर्षं च बिभ्रतोः ।\nतेजसा समयोः शश्वत्क्रीडया कौतुकेन च ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003110035, "chapter_id": 23110, "verse_number": "४-४६-३६", "content_sanskrit": "भारेण विश्वंभरयोर्भाराक्रान्ता वसुन्धरा ।\nसा विदीर्णा चकम्पे च सशैलवनसागरा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003110036, "chapter_id": 23110, "verse_number": "४-४६-३७", "content_sanskrit": "तयोर्भरभराक्रान्तधरायाश्च भरेण च ।\nभाराक्रान्तो हि शेषश्च तद्भरार्तोऽपि कच्छपः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003110037, "chapter_id": 23110, "verse_number": "४-४६-३८", "content_sanskrit": "कच्छपस्य भरेणैव सर्वाधारा समीरणाः ।\nमहाविक्लवयुक्ताश्च सर्वप्राणाश्च स्तम्भिताः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003110038, "chapter_id": 23110, "verse_number": "४-४६-३९", "content_sanskrit": "स्तम्भितेषु समीरेषु त्रिलोका भयविह्वलाः ।\nब्रह्मादयः सुराः सर्वे वैकुण्ठं शरणं ययुः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003110039, "chapter_id": 23110, "verse_number": "४-४६-४०", "content_sanskrit": "सर्वं निवेदनं चक्रुर्नारायणपदाम्बुजे ।\nनारायणश्च भगवानुवाच कमलोद्भवम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003110040, "chapter_id": 23110, "verse_number": "४-४६-४१", "content_sanskrit": "श्रीनारायण उवाच ।\nशृङ्गारभङ्गसमयो भविता नाधुना विधे ।\nकालप्रयुक्तं कार्यं च सिद्धं तत्समयोचितम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003110041, "chapter_id": 23110, "verse_number": "४-४६-४२", "content_sanskrit": "पूर्णे वर्षसहस्रे च स्वेच्छया विरमिष्यति ।\nशंभोः संयोगमिष्टं च को भेदं कर्तुमीश्वरः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003110042, "chapter_id": 23110, "verse_number": "४-४६-४३", "content_sanskrit": "स्त्रीपुंसो रतिविच्छेदमुपायेन करोति यः ।\nतस्य स्त्रीपुंसयोर्भेदो भवेज्जन्मनिजन्मनि ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003110043, "chapter_id": 23110, "verse_number": "४-४६-४४", "content_sanskrit": "यात्यन्ते कालसूत्रे च वर्षलक्षं स पातकी ।\nभ्रष्टज्ञानो नष्टकीर्तिरलक्ष्मीको भवेदिह ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003110044, "chapter_id": 23110, "verse_number": "४-४६-४५", "content_sanskrit": "रम्भायुक्तं शक्रमिमं चकार विरतं रतौ ।\nमहामुनीन्द्रो दुर्वासास्तत्स्त्रीभेदो बभूव ह ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003110045, "chapter_id": 23110, "verse_number": "४-४६-४६", "content_sanskrit": "पुनरन्यां स संप्राप्य निषेव्य शूलपाणिनम् ।\nदिव्यवर्षसहस्रं च विजहौ विरहज्वरम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003110046, "chapter_id": 23110, "verse_number": "४-४६-४७", "content_sanskrit": "रोहिणीसहितं चन्द्रं चकार विरतं रतौ ।\nमहर्षिर्गौतमस्तस्य स्त्रीविच्छेदो बभूव ह ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003110047, "chapter_id": 23110, "verse_number": "४-४६-४८", "content_sanskrit": "पुनः शिवं समाराध्य प्राप्याहल्यां च पुष्करे ।\nदिव्यवर्षसहस्रं च विजहौ विरहज्वरम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003110048, "chapter_id": 23110, "verse_number": "४-४६-४९", "content_sanskrit": "मुनिः स्वभार्यासंसक्ते दिवसे निर्जने वने ।\nब्रह्माण्डकसुतं नीत्वा चकार विरतं रुषा ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003110049, "chapter_id": 23110, "verse_number": "४-४६-५०", "content_sanskrit": "बभूव पुत्रविच्छेदस्तस्य कल्पान्तरे पुनः ।\nशिवं निषेव्य संप्राप्य पुत्रं तत्याज विक्लवम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003110050, "chapter_id": 23110, "verse_number": "४-४६-५१", "content_sanskrit": "हरिश्चन्द्रो हालिकं च वृषल्या सह संयुतम् ।\nवारयामास निश्चेष्टं निर्जने तत्फलं शृणु ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003110051, "chapter_id": 23110, "verse_number": "४-४६-५२", "content_sanskrit": "भ्रष्टः श्रीराज्यवित्तेभ्यस्तं चकारावलीलया ।\nविश्वामित्रो महर्षिश्च ताडयामास तं पुरा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003110052, "chapter_id": 23110, "verse_number": "४-४६-५३", "content_sanskrit": "ततः शिवं समाराध्य दातारं सर्वसंपदाम् ।\nसद्यो जगाम वैकुण्ठं सगणो मम मन्दिरम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003110053, "chapter_id": 23110, "verse_number": "४-४६-५४", "content_sanskrit": "आजामिलं द्विजश्रेष्ठं वृषल्या सह संयुतम् ।\nन भिया वारयामासुः सुरास्तं चापि केचन ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003110054, "chapter_id": 23110, "verse_number": "४-४६-५५", "content_sanskrit": "निष्पन्ने कर्मभोगे च स मद्भक्तो मुमोच ह ।\nमन्नामस्मृतिमात्रेण चाजगाम ममालयम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003110055, "chapter_id": 23110, "verse_number": "४-४६-५६", "content_sanskrit": "सर्वं निषेकसाध्यं च निषेको बलवान्विधे ।\nनिषेकफलदाताऽहं निषेकः केन वार्यते ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003110056, "chapter_id": 23110, "verse_number": "४-४६-५७", "content_sanskrit": "दिव्यं वर्षसहस्रं च शंभोः संभोगकर्मकृत् ।\nनिषेकफलदातुस्तु निषेकफलसंचयम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003110057, "chapter_id": 23110, "verse_number": "४-४६-५८", "content_sanskrit": "पूर्णे वर्षसहस्रे च गत्वा तत्र महेश्वरः ।\nयेन वीर्यं पतेद्भूमौ तत्करिष्यति निश्चितम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003110058, "chapter_id": 23110, "verse_number": "४-४६-५९", "content_sanskrit": "तत्र वीर्ये च भविता स्कन्दको भक्ततारकः ।\nसदा भद्रस्वरूपोऽहं भयं किं वो मयि स्थिते ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003110059, "chapter_id": 23110, "verse_number": "४-४६-६०", "content_sanskrit": "अधुना त्वं गृहं गच्छ भगवान्स्वगणैः सह ।\nकरोतु शंभुः संभोगं पार्वत्या सह निर्जने ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003110060, "chapter_id": 23110, "verse_number": "४-४६-६१", "content_sanskrit": "इत्युक्त्वा कमलाकान्तः शीघ्रं स्वान्तःपुरं ययौ ।\nस्वालयं प्रययुर्देवाः शिवः स्वस्थो रतौ रतः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003110061, "chapter_id": 23110, "verse_number": "४-४६-६२", "content_sanskrit": "नारायण उवाच ।\nइत्युक्त्वा राधिकां कृष्णः सकटाक्षां च सस्मिताम् ।\nजगाम चन्दनवनं निर्जने च तया सह ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003110062, "chapter_id": 23110, "verse_number": "४-४६-६३", "content_sanskrit": "अतीव निर्जनं रम्यं वायुना सुरभीकृतम् ।\nपुष्पोद्यानैः समाकीर्णं तत्र क्रीडां चकार ह ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003110063, "chapter_id": 23110, "verse_number": "४-४६-६४", "content_sanskrit": "पुष्पतल्पसमाकीर्णे परपुष्टरुतश्रुते ।\nभ्रमरवध्वनि संयुक्ते कामिनीनां मनोहरे ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003110064, "chapter_id": 23110, "verse_number": "४-४६-६५", "content_sanskrit": "कृष्णसंभोगमात्रेण सुखसंमूर्च्छिता च सा ।\nअतीव मूर्च्छितः कृष्णो राधाङ्गस्पर्शमात्रतः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003110065, "chapter_id": 23110, "verse_number": "४-४६-६६", "content_sanskrit": "तस्थतुस्तत्र संयुक्तौ राधारासेश्वरौ मुने ।\nअतीवरतिनिश्चेष्टौ किं भूयः श्रोतुमिच्छसि ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003110066, "chapter_id": 23110, "verse_number": "४-४६-६७", "content_sanskrit": "इत्येवं मङ्गलं कर्म यः शृणोति समाहितः ।\nकदाचिद्बन्धुविच्छेदो न भवेत्तस्य नारद ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003110067, "chapter_id": 23110, "verse_number": "४-४६-६८", "content_sanskrit": "महाशोकार्णवे मग्नो भेदे पुत्रकलत्रयोः। ।\nमद्भृत्यानां च बन्धूनां मासं श्रुत्वा लभेद्ध्रुवम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003110068, "chapter_id": 23110, "verse_number": "४-४६-६९", "content_sanskrit": "सूत उवाच ।\nइत्युक्त्वा धर्मपुत्रश्च विरराम महामुनिः ।\nपुनः संप्रष्टुमारेभे देवर्षिः कौतुकान्वितः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]