[{"id": 2082604, "chapter_id": 2761, "verse_number": "१२-२६६-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2082605, "chapter_id": 2761, "verse_number": "१२-२६६-१", "content_sanskrit": "सूक्ष्मं साधु समादिष्टं भवता धर्मलक्षणम्।\nप्रतिभा त्यस्ति मे काचित्तां ब्रूयामनुमानतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2082606, "chapter_id": 2761, "verse_number": "१२-२६६-२", "content_sanskrit": "भूयांसो हृदये ये मे प्रश्नास्ते व्याहृतास्त्वया।\nइदं त्वन्यत्प्रवक्ष्यामि न राजन्निग्रहादिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2082607, "chapter_id": 2761, "verse_number": "१२-२६६-३", "content_sanskrit": "इमानि हि प्राणयन्ति सृदन्त्युत्तारयन्ति च।\nन धर्मः परिपाठेन शक्यो भारत वेदितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2082608, "chapter_id": 2761, "verse_number": "१२-२६६-४", "content_sanskrit": "अन्यो धर्मः समस्थस्य विषमस्थस्य चापरः।\nआपदस्तु कथं शक्याः परिपाठेन वेदितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2082609, "chapter_id": 2761, "verse_number": "१२-२६६-५", "content_sanskrit": "सदाचारो मचो धर्मः संतस्त्वाचारलक्षणाः।\nसाध्यासाध्यं कथं शक्यं सदाचारो ह्यलक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2082610, "chapter_id": 2761, "verse_number": "१२-२६६-६", "content_sanskrit": "दृश्यते धर्मरूपेण ह्यधर्मं प्राकृतश्चरन्।\nधर्मं चाधर्मरूपेण कश्चिदप्राकृतश्चरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2082611, "chapter_id": 2761, "verse_number": "१२-२६६-७", "content_sanskrit": "पुनरस्य प्रमाणं हि निर्दिष्टं शास्त्रकोविदैः।\nवेदवादाश्चानुयुगं ह्रसन्तीतीह नः श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2082612, "chapter_id": 2761, "verse_number": "१२-२६६-८", "content_sanskrit": "अन्ये कृतयुगे धर्मास्त्रेतायां द्वापरे परे।\nअन्ये कलियुगे धर्मा यथाशक्ति कृता इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2082613, "chapter_id": 2761, "verse_number": "१२-२६६-९", "content_sanskrit": "आम्नायवचनं सत्यमित्ययं लोकसंग्रहः।\nआम्नायेभ्यः पुनर्वेदाः प्रसृताः सर्वतोमुखाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2082614, "chapter_id": 2761, "verse_number": "१२-२६६-१०", "content_sanskrit": "ते चेत्सर्वप्रमाणं वै प्रमाणं ह्यत्र विद्यते।\nप्रमाणं च प्रमाणेन विरुद्ध्येच्छास्त्रता कुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2082615, "chapter_id": 2761, "verse_number": "१२-२६६-११", "content_sanskrit": "धर्मस्य क्रियमाणस्य बलवद्भिर्दुरात्मभिः।\nयदा विक्रियते संस्था ततः साऽपि प्रणश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2082616, "chapter_id": 2761, "verse_number": "१२-२६६-१२", "content_sanskrit": "विद्मश्चैनं न वा विद्मः शक्यं वा वेदितुं न वा।\nअणीयान्क्षुरधाराया गरीयानपि पर्वतात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2082617, "chapter_id": 2761, "verse_number": "१२-२६६-१३", "content_sanskrit": "गन्धर्वनगराकारः प्रथमं संप्रदृश्यते।\nअन्वीक्ष्यमाणः कविभिः पुनर्गच्छत्यदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2082618, "chapter_id": 2761, "verse_number": "१२-२६६-१४", "content_sanskrit": "निपानानीव गोभ्याशे क्षेत्रे कुल्ये च भारत।\nस्मृतो हि शाश्वतो धर्मो विप्रहीणो न दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2082619, "chapter_id": 2761, "verse_number": "१२-२६६-१५", "content_sanskrit": "कामादन्ये भयादन्ये कारणैरपरैस्तथा।\nअसन्तोऽपि वृथाचारं भजन्ते बहवोऽपरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2082620, "chapter_id": 2761, "verse_number": "१२-२६६-१६", "content_sanskrit": "धर्मो भवति स क्षिप्रं विलोमस्तेष्वसाधुषु।\nअथैतानाहुरुन्मत्तानपि चावहसन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2082621, "chapter_id": 2761, "verse_number": "१२-२६६-१७", "content_sanskrit": "महाजना ह्युपावृत्ता राजधर्मं समाश्रिताः।\nन हि सर्वहितः कश्चिदाचारः संप्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2082622, "chapter_id": 2761, "verse_number": "१२-२६६-१८", "content_sanskrit": "तेनैवान्यः प्रभवति सोऽपरं बाधते पुनः।\nदृश्यते चैव स पुनस्तुल्यरूपो यदृच्छया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2082623, "chapter_id": 2761, "verse_number": "१२-२६६-१९", "content_sanskrit": "येनैवान्यः प्रभवति सोऽपरानपि बाधते।\nआचाराणामनैकाग्र्यं सर्वेषामेव लक्षयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2082624, "chapter_id": 2761, "verse_number": "१२-२६६-२०", "content_sanskrit": "चिराभिपन्नः कविभिः पूर्वं धर्म उदाहृतः।\nतेनाचारेण पूर्वेण संस्था भवति शाश्वती॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2082625, "chapter_id": 2761, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि षट्षष्ट्यधिकद्विशततमोऽध्यायः॥ २६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]