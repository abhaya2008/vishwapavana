[{"id": 7000477000, "chapter_id": 20477, "verse_number": "३-२४-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nअथान्यानि तु तीर्थानि वसिष्ठोक्तानि मे वद ।\nश्रुत्वा यानि च पापानि विलयं यांति नारद ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000477001, "chapter_id": 20477, "verse_number": "३-२४-२", "content_sanskrit": "नारद उवाच ।\nशृणुष्वात्र हि तीर्थानि वसिष्ठोक्तानि पार्थिव ।\nदक्षिणं सिंधुमासाद्य ब्रह्मचारी जितेंद्रियः ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000477002, "chapter_id": 20477, "verse_number": "३-२४-३", "content_sanskrit": "अग्निष्टोममवाप्नोति विमानं चाधिरोहति ।\nचर्मण्वतीं समासाद्य नियतो नियताशनः ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000477003, "chapter_id": 20477, "verse_number": "३-२४-४", "content_sanskrit": "रंतिदेवाभ्यनुज्ञातो अग्निष्टोमफलं लभेत् ।\nततो गच्छेत धर्मज्ञ हिमवत्सुतमर्बुदम् ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000477004, "chapter_id": 20477, "verse_number": "३-२४-५", "content_sanskrit": "पृथिव्या यत्र वै छिद्रं पूर्वमासीद्युधिष्ठिर ।\nतत्राश्रमो वसिष्ठस्य त्रिषु लोकेषु विश्रुतं ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000477005, "chapter_id": 20477, "verse_number": "३-२४-६", "content_sanskrit": "तत्रोष्य रजनीमेकां गोसहस्रफलं लभेत् ।\nपिंगातीर्थमुपस्पृश्य ब्रह्मचारी नराधिप ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000477006, "chapter_id": 20477, "verse_number": "३-२४-७", "content_sanskrit": "कपिलानां नरव्याघ्र शतस्य फलमाप्नुयात् ।\nततो गच्छेत धर्मज्ञ प्रभासं लोकविश्रुतम् ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000477007, "chapter_id": 20477, "verse_number": "३-२४-८", "content_sanskrit": "यत्र सन्निहितो नित्यं स्वयमेव हुताशनः ।\nदेवतानां मुखं वीर अनलोऽनिलसारथिः ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000477008, "chapter_id": 20477, "verse_number": "३-२४-९", "content_sanskrit": "तस्मिंस्तीर्थवरे स्नात्वा शुचिः प्रयतमानसः ।\nअग्निष्टोमातिरात्राभ्यां फलं प्राप्नोति मानवः ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000477009, "chapter_id": 20477, "verse_number": "३-२४-१०", "content_sanskrit": "ततो गत्वा सरस्वत्याः सागरस्य च संगमम् ।\nगोसहस्रफलं प्राप्य स्वर्गलोके महीयते ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000477010, "chapter_id": 20477, "verse_number": "३-२४-११", "content_sanskrit": "दीप्यमानोऽग्निवन्नित्यं प्रभया भरतर्षभ ।\nतीर्थे सलिलराजस्य स्नात्वा प्रयतमानसः ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000477011, "chapter_id": 20477, "verse_number": "३-२४-१२", "content_sanskrit": "त्रिरात्रमुषितस्तत्र तर्पयेत्पितृदेवताः ।\nविराजति यथा सोमो वाजिमेधं च विंदति ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000477012, "chapter_id": 20477, "verse_number": "३-२४-१३", "content_sanskrit": "वरदानं ततो गच्छेत्तीर्थं भरतसत्तम ।\nविष्णोर्दुर्वाससा यत्र वरो दत्तो युधिष्ठिर ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000477013, "chapter_id": 20477, "verse_number": "३-२४-१४", "content_sanskrit": "वरदाने नरः स्नात्वा गोसहस्रफलं लभेत् ।\nततो द्वारवतीं गच्छेन्नियतो नियताशनः ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000477014, "chapter_id": 20477, "verse_number": "३-२४-१५", "content_sanskrit": "पिंडारके नरः स्नात्वा लभेद्बहुसुवर्णकम् ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000477015, "chapter_id": 20477, "verse_number": "३-२४-१६", "content_sanskrit": "तस्मिंस्तीर्थे महाराज पद्मलक्षणलक्षिताः ।\nअद्यापि मुद्रा दृश्यंते तदद्भुतमरिंदम ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000477016, "chapter_id": 20477, "verse_number": "३-२४-१७", "content_sanskrit": "त्रिशूलांकानि पद्मानि दृश्यंते कुरुनंदन ।\nमहादेवस्य सान्निध्यं तत्रैव भरतर्षभ ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000477017, "chapter_id": 20477, "verse_number": "३-२४-१८", "content_sanskrit": "सागरस्य च सिंधोश्च संगमं प्राप्य भारत ।\nतीर्थे सलिलराजस्य स्नात्वा प्रयतमानसः ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000477018, "chapter_id": 20477, "verse_number": "३-२४-१९", "content_sanskrit": "तर्पयित्वा पितॄन्देवानृषींश्च भरतर्षभ ।\nप्राप्नोति वारुणं लोकं दीप्यमानः स्वतेजसा ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000477019, "chapter_id": 20477, "verse_number": "३-२४-२०", "content_sanskrit": "शंकुकर्णेश्वरं देवमर्चयित्वा युधिष्ठिर ।\nअश्वमेधं दशगुणं प्रवदंति मनीषिणः ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000477020, "chapter_id": 20477, "verse_number": "३-२४-२१", "content_sanskrit": "प्रदक्षिणमुपावृत्य गच्छेत भरतर्षभ ।\nतीर्थं कुरुवरश्रेष्ठ त्रिषु लोकेषु विश्रुतम् ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000477021, "chapter_id": 20477, "verse_number": "३-२४-२२", "content_sanskrit": "तिमीति नाम्ना विख्यातं सर्वपापप्रमोचनम् ।\nयत्र शक्रादयो देवा उपासंते महेश्वरम् ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000477022, "chapter_id": 20477, "verse_number": "३-२४-२३", "content_sanskrit": "तत्र स्नात्वार्चयित्वा च रुद्रं देवगणैर्वृतम् ।\nजन्मप्रभृति पापानि कृतानि नुदते नरः ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000477023, "chapter_id": 20477, "verse_number": "३-२४-२४", "content_sanskrit": "तिमिरत्र नरश्रेष्ठ सर्वदेवैरभिष्टुतः ।\nतत्र स्नात्वा नरश्रेष्ठ हयमेधमवाप्नुयात् ॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000477024, "chapter_id": 20477, "verse_number": "३-२४-२५", "content_sanskrit": "जित्वा तत्र महाप्राज्ञ विष्णुना दितिनंदनम् ।\nपुरा शौचं कृतं राजन्हत्वा दैवतकंटकान् ॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000477025, "chapter_id": 20477, "verse_number": "३-२४-२६", "content_sanskrit": "ततो गच्छेत धर्मज्ञ वसुधारामभिष्टुताम् ।\nगमनादेव तस्यां हि हयमेधमवाप्नुयात् ॥२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000477026, "chapter_id": 20477, "verse_number": "३-२४-२७", "content_sanskrit": "स्नात्वा कुरुवरश्रेष्ठ प्रयतात्मा तु मानवः ।\nतर्पयित्वा पितॄन्देवान्विष्णुलोके महीयते ॥२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000477027, "chapter_id": 20477, "verse_number": "३-२४-२८", "content_sanskrit": "तीर्थं चापि परं तत्र वसूनां भरतर्षभ ।\nतत्र स्नात्वा च पीत्वा च वसूनां संमतो भवेत् ॥२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000477028, "chapter_id": 20477, "verse_number": "३-२४-२९", "content_sanskrit": "सिंधुतममिति ख्यातं सर्वपापप्रणाशनम् ।\nतत्र स्नात्वा नरश्रेष्ठ लभेद्बहुसुवर्णकम् ॥२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000477029, "chapter_id": 20477, "verse_number": "३-२४-३०", "content_sanskrit": "ब्रह्मतुंगं समासाद्य शुचिः प्रयतमानसः ।\nब्रह्मलोकमवाप्नोति सुकृती विरजा नरः ॥३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000477030, "chapter_id": 20477, "verse_number": "३-२४-३१", "content_sanskrit": "कुमारिकाणां शक्रस्य तीर्थं सिद्धनिषेवितम् ।\nतत्र स्नात्वा नरश्रेष्ठ शक्रलोकमवाप्नुयात् ॥३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000477031, "chapter_id": 20477, "verse_number": "३-२४-३२", "content_sanskrit": "रेणुकायाश्च तत्रैव तीर्थं देवनिषेवितम् ।\nस्नात्वा तत्र भवेद्विप्रो विमलश्चंद्रमा इव ॥३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000477032, "chapter_id": 20477, "verse_number": "३-२४-३३", "content_sanskrit": "अथ पंचनदं गत्वा नियतो नियताशनः ।\nपंचयज्ञानवाप्नोति क्रमशो ये तु कीर्तिताः ॥३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000477033, "chapter_id": 20477, "verse_number": "३-२४-३४", "content_sanskrit": "ततो गच्छेत धर्मज्ञ भीमायाः स्थानमुत्तमम् ।\nतत्र स्नात्वा न योन्यां वै नरो भरतसत्तम ॥३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000477034, "chapter_id": 20477, "verse_number": "३-२४-३५", "content_sanskrit": "देव्याः पुत्रो भवेद्राजन्तत्र कुंडलविग्रहः ।\nगवां शतसहस्रस्य फलं चैवाप्नुयान्महत् ॥३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000477035, "chapter_id": 20477, "verse_number": "३-२४-३६", "content_sanskrit": "गिरिकुंजं समासाद्य त्रिषु लोकेषु विश्रुतम् ।\nपितामहं नमस्कृत्य गोसहस्रफलं लभेत् ॥३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000477036, "chapter_id": 20477, "verse_number": "३-२४-३७", "content_sanskrit": "ततो गच्छेत धर्मज्ञ विमलं तीर्थमुत्तमम् ।\nअद्यापि यत्र दृश्यंते मत्स्याः सौवर्णराजताः ॥३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000477037, "chapter_id": 20477, "verse_number": "३-२४-३८", "content_sanskrit": "तत्र स्नात्वा नरश्रेष्ठ वाजपेयमवाप्नुयात् ।\nसर्वपापविशुद्धात्मा गच्छेत्परमिकां गतिम् ॥३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]