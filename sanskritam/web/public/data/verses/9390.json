[{"id": 5000390000, "chapter_id": 9390, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे एकपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000390001, "chapter_id": 9390, "verse_number": "५-५१-१", "content_sanskrit": "तं समीक्ष्य महासत्त्वं सत्त्ववान् हरिसत्तमः।\nवाक्यमर्थवदव्यग्रस्तमुवाच दशाननम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000390002, "chapter_id": 9390, "verse_number": "५-५१-२", "content_sanskrit": "अहं सुग्रीवसंदेशादिह प्राप्तस्तवान्तिके।\nराक्षसेश हरीशस्त्वां भ्राता कुशलमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000390003, "chapter_id": 9390, "verse_number": "५-५१-३", "content_sanskrit": "भ्रातुः श्रृणु समादेशं सुग्रीवस्य महात्मनः।\nधर्मार्थसहितं वाक्यमिह चामुत्र च क्षमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000390004, "chapter_id": 9390, "verse_number": "५-५१-४", "content_sanskrit": "राजा दशरथो नाम रथकुञ्जरवाजिमान्।\nपितेव बन्धुर्लोकस्य सुरेश्वरसमद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000390005, "chapter_id": 9390, "verse_number": "५-५१-५", "content_sanskrit": "ज्येष्ठस्तस्य महाबाहुः पुत्रः प्रियतरः प्रभुः।\nपितुर्निदेशान्निष्क्रान्तः प्रविष्टो दण्डकावनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000390006, "chapter_id": 9390, "verse_number": "५-५१-६", "content_sanskrit": "लक्ष्मणेन सह भ्राता सीतया सह भार्यया।\nरामो नाम महातेजा धर्म्यं पन्थानमाश्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000390007, "chapter_id": 9390, "verse_number": "५-५१-७", "content_sanskrit": "तस्य भार्या जनस्थाने भ्रष्टा सीतेति विश्रुता।\nवैदेहस्य सुता राज्ञो जनकस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000390008, "chapter_id": 9390, "verse_number": "५-५१-८", "content_sanskrit": "मार्गमाणस्तु तां देवीं राजपुत्रः सहानुजः।\nऋष्यमूकमनुप्राप्तः सुग्रीवेण च संगतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000390009, "chapter_id": 9390, "verse_number": "५-५१-९", "content_sanskrit": "तस्य तेन प्रतिज्ञातं सीतायाः परिमार्गणम्।\nसुग्रीवस्यापि रामेण हरिराज्यं निवेदितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000390010, "chapter_id": 9390, "verse_number": "५-५१-१०", "content_sanskrit": "ततस्तेन मृधे हत्वा राजपुत्रेण वालिनम्।\nसुग्रीवः स्थापितो राज्ये हर्यृक्षाणां गणेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000390011, "chapter_id": 9390, "verse_number": "५-५१-११", "content_sanskrit": "त्वया विज्ञातपूर्वश्च वाली वानरपुङ्गवः।\nस तेन निहतः संख्ये शरेणैकेन वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000390012, "chapter_id": 9390, "verse_number": "५-५१-१२", "content_sanskrit": "स सीतामार्गणे व्यग्रः सुग्रीवः सत्यसंगरः।\nहरीन् सम्प्रेषयामास दिशः सर्वा हरीश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000390013, "chapter_id": 9390, "verse_number": "५-५१-१३", "content_sanskrit": "तां हरीणां सहस्राणि शतानि नियुतानि च।\nदिक्षु सर्वासु मार्गन्ते ह्यधश्चोपरि चाम्बरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000390014, "chapter_id": 9390, "verse_number": "५-५१-१४", "content_sanskrit": "वैनतेयसमाः केचित् केचित् तत्रानिलोपमाः।\nअसङ्गगतयः शीघ्रा हरिवीरा महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000390015, "chapter_id": 9390, "verse_number": "५-५१-१५", "content_sanskrit": "अहं तु हनुमान्नाम मारुतस्यौरसः सुतः।\nसीतायास्तु कृते तूर्णं शतयोजनमायतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000390016, "chapter_id": 9390, "verse_number": "५-५१-१६", "content_sanskrit": "समुद्रं लङ्घयित्वैव त्वां दिदृक्षुरिहागतः।\nभ्रमता च मया दृष्टा गृहे ते जनकात्मजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000390017, "chapter_id": 9390, "verse_number": "५-५१-१७", "content_sanskrit": "तद् भवान् दृष्टधर्मार्थस्तपःकृतपरिग्रहः।\nपरदारान् महाप्राज्ञ नोपरोद‍्धुं त्वमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000390018, "chapter_id": 9390, "verse_number": "५-५१-१८", "content_sanskrit": "नहि धर्मविरुद्धेषु बह्वपायेषु कर्मसु।\nमूलघातिषु सज्जन्ते बुद्धिमन्तो भवद्विधाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000390019, "chapter_id": 9390, "verse_number": "५-५१-१९", "content_sanskrit": "कश्च लक्ष्मणमुक्तानां रामकोपानुवर्तिनाम्।\nशराणामग्रतः स्थातुं शक्तो देवासुरेष्वपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000390020, "chapter_id": 9390, "verse_number": "५-५१-२०", "content_sanskrit": "न चापि त्रिषु लोकेषु राजन् विद्येत कश्चन।\nराघवस्य व्यलीकं यः कृत्वा सुखमवाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000390021, "chapter_id": 9390, "verse_number": "५-५१-२१", "content_sanskrit": "तत् त्रिकालहितं वाक्यं धर्म्यमर्थानुयायि च।\nमन्यस्व नरदेवाय जानकी प्रतिदीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000390022, "chapter_id": 9390, "verse_number": "५-५१-२२", "content_sanskrit": "दृष्टा हीयं मया देवी लब्धं यदिह दुर्लभम्।\nउत्तरं कर्म यच्छेषं निमित्तं तत्र राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000390023, "chapter_id": 9390, "verse_number": "५-५१-२३", "content_sanskrit": "लक्षितेयं मया सीता तथा शोकपरायणा।\nगृहे यां नाभिजानासि पञ्चास्यामिव पन्नगीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000390024, "chapter_id": 9390, "verse_number": "५-५१-२४", "content_sanskrit": "नेयं जरयितुं शक्या सासुरैरमरैरपि।\nविषसंस्पृष्टमत्यर्थं भुक्तमन्नमिवौजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000390025, "chapter_id": 9390, "verse_number": "५-५१-२५", "content_sanskrit": "तपःसंतापलब्धस्ते सोऽयं धर्मपरिग्रहः।\nन स नाशयितुं न्याय्य आत्मप्राणपरिग्रहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000390026, "chapter_id": 9390, "verse_number": "५-५१-२६", "content_sanskrit": "अवध्यतां तपोभिर्यां भवान् समनुपश्यति।\nआत्मनः सासुरैर्देवैर्हेतुस्तत्राप्ययं महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000390027, "chapter_id": 9390, "verse_number": "५-५१-२७", "content_sanskrit": "सुग्रीवो न च देवोऽयं न यक्षो न च राक्षसः।\nमानुषो राघवो राजन् सुग्रीवश्च हरीश्वरः।\nतस्मात् प्राणपरित्राणं कथं राजन् करिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000390028, "chapter_id": 9390, "verse_number": "५-५१-२८", "content_sanskrit": "न तु धर्मोपसंहारमधर्मफलसंहितम्।\nतदेव फलमन्वेति धर्मश्चाधर्मनाशनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000390029, "chapter_id": 9390, "verse_number": "५-५१-२९", "content_sanskrit": "प्राप्तं धर्मफलं तावद् भवता नात्र संशयः।\nफलमस्याप्यधर्मस्य क्षिप्रमेव प्रपत्स्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000390030, "chapter_id": 9390, "verse_number": "५-५१-३०", "content_sanskrit": "जनस्थानवधं बुद्‍ध्वा वालिनश्च वधं तथा।\nरामसुग्रीवसख्यं च बुद्‍ध्यस्व हितमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000390031, "chapter_id": 9390, "verse_number": "५-५१-३१", "content_sanskrit": "कामं खल्वहमप्येकः सवाजिरथकुञ्जराम्।\nलङ्कां नाशयितुं शक्तस्तस्यैष तु न निश्चयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000390032, "chapter_id": 9390, "verse_number": "५-५१-३२", "content_sanskrit": "रामेण हि प्रतिज्ञातं हर्यृक्षगणसंनिधौ।\nउत्सादनममित्राणां सीता यैस्तु प्रधर्षिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000390033, "chapter_id": 9390, "verse_number": "५-५१-३३", "content_sanskrit": "अपकुर्वन् हि रामस्य साक्षादपि पुरंदरः।\nन सुखं प्राप्नुयादन्यः किं पुनस्त्वद्विधो जनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000390034, "chapter_id": 9390, "verse_number": "५-५१-३४", "content_sanskrit": "यां सीतेत्यभिजानासि येयं तिष्ठति ते गृहे।\nकालरात्रीति तां विद्धि सर्वलङ्काविनाशिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000390035, "chapter_id": 9390, "verse_number": "५-५१-३५", "content_sanskrit": "तदलं कालपाशेन सीताविग्रहरूपिणा।\nस्वयं स्कन्धावसक्तेन क्षेममात्मनि चिन्त्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000390036, "chapter_id": 9390, "verse_number": "५-५१-३६", "content_sanskrit": "सीतायास्तेजसा दग्धां रामकोपप्रदीपिताम्।\nदह्यमानामिमां पश्य पुरीं साट्टप्रतोलिकाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000390037, "chapter_id": 9390, "verse_number": "५-५१-३७", "content_sanskrit": "स्वानि मित्राणि मन्त्रींश्च ज्ञातीन् भ्रातॄन् सुता‍न‍‍्हितान्।\nभोगान् दारांश्च लङ्कां च मा विनाशमुपानय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000390038, "chapter_id": 9390, "verse_number": "५-५१-३८", "content_sanskrit": "सत्यं राक्षसराजेन्द्र शृणुष्व वचनं मम।\nरामदासस्य दूतस्य वानरस्य विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000390039, "chapter_id": 9390, "verse_number": "५-५१-३९", "content_sanskrit": "सर्वाल्ँ लोकान् सुसंहृत्य सभूतान् सचराचरान्।\nपुनरेव तथा स्रष्टुं शक्तो रामो महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000390040, "chapter_id": 9390, "verse_number": "५-५१-४०", "content_sanskrit": "देवासुरनरेन्द्रेषु यक्षरक्षोरगेषु च।\nविद्याधरेषु नागेषु गन्धर्वेषु मृगेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000390041, "chapter_id": 9390, "verse_number": "५-५१-४१", "content_sanskrit": "सिद्धेषु किंनरेन्द्रेषु पतत्त्रिषु च सर्वतः।\nसर्वत्र सर्वभूतेषु सर्वकालेषु नास्ति सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000390042, "chapter_id": 9390, "verse_number": "५-५१-४२", "content_sanskrit": "यो रामं प्रति युध्येत विष्णुतुल्यपराक्रमम्।\nसर्वलोकेश्वरस्येह कृत्वा विप्रियमीदृशम्।\nरामस्य राजसिंहस्य दुर्लभं तव जीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000390043, "chapter_id": 9390, "verse_number": "५-५१-४३", "content_sanskrit": "देवाश्च दैत्याश्च निशाचरेन्द्र\nगन्धर्वविद्याधरनागयक्षाः।\nरामस्य लोकत्रयनायकस्य\nस्थातुं न शक्ताः समरेषु सर्वे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000390044, "chapter_id": 9390, "verse_number": "५-५१-४४", "content_sanskrit": "ब्रह्मा स्वयम्भूश्चतुराननो वा\nरुद्रस्त्रिनेत्रस्त्रिपुरान्तको वा।\nइन्द्रो महेन्द्रः सुरनायको वा\nस्थातुं न शक्ता युधि राघवस्य ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000390045, "chapter_id": 9390, "verse_number": "५-५१-४५", "content_sanskrit": "स सौष्ठवोपेतमदीनवादिनः\nकपेर्निशम्याप्रतिमोऽप्रियं वचः।\nदशाननः कोपविवृत्तलोचनः\nसमादिशत् तस्य वधं महाकपेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000390046, "chapter_id": 9390, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे एकपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]