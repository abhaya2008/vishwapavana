[{"id": 50012769, "chapter_id": 11499, "verse_number": "1", "content_sanskrit": "राजोवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50012770, "chapter_id": 11499, "verse_number": "2", "content_sanskrit": "समः प्रियः सुहृद् ब्रह्मन् भूतानां भगवान् स्वयम्। इन्द्रस्यार्थे कथं दैत्यानवधीद् विषमो यथा॥ ७/१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50012771, "chapter_id": 11499, "verse_number": "3", "content_sanskrit": "नह्यस्यार्थः सुरगणैः साक्षान्निःश्रेयसात्मनः। नैवासुरेभ्यो विद्वेषो नोद्वेगश्चागुणस्य हि॥ ७/१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50012772, "chapter_id": 11499, "verse_number": "4", "content_sanskrit": "इति नः सुमहाभाग नारायणगुणान् प्रति। संशयः सुमहान् जातस्तं भवांश्छेत्तुमर्हति॥ ७/१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50012773, "chapter_id": 11499, "verse_number": "5", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50012774, "chapter_id": 11499, "verse_number": "6", "content_sanskrit": "साधु पृष्टं महाराज हरेश्चरितमद्भुतम्। यत्र भागवतमाहात्म्यं भगवद्भक्तिवर्धनम्॥ ७/१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50012775, "chapter_id": 11499, "verse_number": "7", "content_sanskrit": "गीयते परमं पुण्यं ऋषिभिर्नारदादिभिः। नत्वा कृष्णाय मुनये कथयिष्ये हरेः कथाम्॥ ७/१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50012776, "chapter_id": 11499, "verse_number": "8", "content_sanskrit": "निर्गुणोऽपि ह्यजोऽव्यक्तो भगवान् प्रकृतेः परः। स्वमायागुणमाविश्य बाध्यबाधकतां गतः॥ ७/१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50012777, "chapter_id": 11499, "verse_number": "9", "content_sanskrit": "सत्वं रजस्तम इति प्रकृतेर्नात्मनो गुणाः। न तेषां युगपद् राजन् ह्वास उन्नाह एव च॥ ७/१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50012778, "chapter_id": 11499, "verse_number": "10", "content_sanskrit": "जयकाले तु सत्वस्य देवर्षीन् रजसोऽसुरान्। तमसो यक्षरक्षांसि तत्कालानुगुणो भजन्॥ ७/१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50012779, "chapter_id": 11499, "verse_number": "11", "content_sanskrit": "ज्योतिरादिरिवाभाति सङ्घातान्न विविच्यते। विन्दन्त्यात्मानमात्मस्थं मथित्वा कवयोऽन्ततः॥ ७/१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50012780, "chapter_id": 11499, "verse_number": "12", "content_sanskrit": "यदा सिसृक्षुः पुर आत्मनः परो रजः सृजत्येष पृथक् स्वमायया। सत्वं विचित्रासु रिरंसुरीश्वरः शयिष्यमाणस्तम ईरयत्यसौ॥ ७/१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50012781, "chapter_id": 11499, "verse_number": "13", "content_sanskrit": "कालं चरन्तं सृजतीश आश्रयः प्रधानपुम्भ्यां नरदेव सत्यकृत्। स तत्र तत्रोभयसिद्धिमाप्नुयात् लिङ्गात्मनो लिङ्गगुणाश्च सन्ति॥ ७/१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50012782, "chapter_id": 11499, "verse_number": "14", "content_sanskrit": "य एष राजन्नपि काल ईशिता सत्वं सुरानीकमिवैधयत्यजः। तत्प्रत्यनीकानसुरान् सुरप्रियो रजस्तमस्कान् प्रमिणोत्युरुश्रवाः॥ ७/१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50012783, "chapter_id": 11499, "verse_number": "15", "content_sanskrit": "स वा पुनः स्वसृष्टस्य स्थितिरक्षानुवृत्तये। सत्वं सुरगणान् विष्णुरुपबृंहयते मुहुः॥ ७/१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50012784, "chapter_id": 11499, "verse_number": "16", "content_sanskrit": "अत्रैवोदाहृतः पूर्वमितिहासः सुरर्षिणा। प्रीत्या महाक्रतौ राजन् पृच्छतेऽजातशत्रवे॥ ७/१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50012785, "chapter_id": 11499, "verse_number": "17", "content_sanskrit": "दृष्ट्वा महाद्भुतं राजा राजसूये महाक्रतौ। वासुदेवे भगवति सायुज्यं चेदिभूभुजः॥ ७/१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50012786, "chapter_id": 11499, "verse_number": "18", "content_sanskrit": "तत्रासीनं सुरऋषिं राजा पाण्डुसुतः क्रतौ। पप्रच्छ विस्मितमना मुनीनां शृण्वतामिदम्॥ ७/१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50012787, "chapter_id": 11499, "verse_number": "19", "content_sanskrit": "अहो ह्यत्यद्भुतं ह्येतद् दुर्लभैकान्तिनामपि। वासुदेवे परे तत्वे प्राप्तिश्चैद्यस्य विद्विषः॥ ७/१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50012788, "chapter_id": 11499, "verse_number": "20", "content_sanskrit": "एतद् वेदितुमिच्छामः सर्व एव वयं मुने। भगवन्निन्दया वेनो द्विजैस्तमसि पातितः॥ ७/१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50012789, "chapter_id": 11499, "verse_number": "21", "content_sanskrit": "दमघोषसुतः पाप आरभ्य कळभाषणात्। सम्प्रत्यमर्षी गोविन्दे दन्तवक्रश्च दुर्मतिः॥ ७/१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50012790, "chapter_id": 11499, "verse_number": "22", "content_sanskrit": "शपतोरसकृद् विष्णुं यद् ब्रह्म परमव्ययम्। श्वित्रो न जातो जिह्वायां नान्धं विविशतुस्तमः॥ ७/१/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50012791, "chapter_id": 11499, "verse_number": "23", "content_sanskrit": "कथं तस्मिन् भगवति दुरवग्राह्यधामनि। पश्यतां सर्वलोकानां लयमीयतुरञ्जसा॥ ७/१/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50012792, "chapter_id": 11499, "verse_number": "24", "content_sanskrit": "एतद् भ्राम्यति मे बुद्धिर्दीपार्चिरिव वायुना। बूरह्येतदद्भुततमं भगवन्नत्र कारणम्॥ ७/१/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50012793, "chapter_id": 11499, "verse_number": "25", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50012794, "chapter_id": 11499, "verse_number": "26", "content_sanskrit": "राज्ञस्तद्वच आकर्ण्य नारदो भगवान् ऋषिः। तुष्टः प्राह तमाभाष्य शृण्वन्त्याः सदसः कथाः॥ ७/१/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50012795, "chapter_id": 11499, "verse_number": "27", "content_sanskrit": "नारद उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50012796, "chapter_id": 11499, "verse_number": "28", "content_sanskrit": "निन्दनस्तवसत्कारन्यक्काराथं कळेबरम्। प्रधानपरयो राजन्नविवेकेन कल्पितम्॥ ७/१/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50012797, "chapter_id": 11499, "verse_number": "29", "content_sanskrit": "हिंसा तदभिमानेन दण्डपारुष्ययोरपि। वैषम्यमिह भूतानां ममाहमिति पार्थिव॥ ७/१/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50012798, "chapter_id": 11499, "verse_number": "30", "content_sanskrit": "यन्निबन्धोऽभिमानोऽयं तद्वधात् प्राणिनां वधः। तथा न यस्य कैवल्यादभिमानोऽखिलात्मनः। परस्येदमकर्तुर्हि हिंसा केनास्य कल्प्यते॥ ७/१/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50012799, "chapter_id": 11499, "verse_number": "31", "content_sanskrit": "तस्माद् वैरानुबन्धेन निर्वैरेण भयेन वा। स्नेहात् कामेन वा युञ्ज्यात् कथञ्चिन्नेक्षते पृथक्॥ ७/१/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50012800, "chapter_id": 11499, "verse_number": "32", "content_sanskrit": "यथा वैरानुबन्धेन मर्त्यस्तन्मयतामियात्। न तथा भक्तियोगेन इति मे निश्चिता मतिः॥ ७/१/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50012801, "chapter_id": 11499, "verse_number": "33", "content_sanskrit": "कीटः पेशस्कृता रुद्धः कुड्ये यान्तमनुस्मरन्। संरम्भभययोगेन विन्दते तत्सरूपताम्॥ ७/१/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50012802, "chapter_id": 11499, "verse_number": "34", "content_sanskrit": "एवं कृष्णे भगवति मायामनुज ईश्वरे। वैरेण धूतपाप्मानः तमापुरनुचिन्तया॥ ७/१/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50012803, "chapter_id": 11499, "verse_number": "35", "content_sanskrit": "कामात् स्नेहाद् भयाद् द्वेषाद् यथा भक्त्येश्वरे मनः। आवेश्य तदघं हित्वा बहवस्तद्गतिं गताः॥ ७/१/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50012804, "chapter_id": 11499, "verse_number": "36", "content_sanskrit": "गोप्यः कामाद् भयात् कंसो द्वेषाच्चैद्यादयो नृपाः। सम्बन्धाद् वृष्णयः स्नेहाद् यूयं भक्त्या वयं विभो॥ ७/१/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50012805, "chapter_id": 11499, "verse_number": "37", "content_sanskrit": "मातृष्वस्रेयो वश्चैद्यो दन्तवक्रश्च पार्थिव। पार्षदप्रवरौ विष्णोर्विप्रशापात् पदच्युतौ॥ ७/१/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50012806, "chapter_id": 11499, "verse_number": "38", "content_sanskrit": "युधिष्ठिर उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50012807, "chapter_id": 11499, "verse_number": "39", "content_sanskrit": "कीदृशः कस्य वा शापो हरिदासाभिमर्शनः। अश्रद्धेय इवाभाति हरेरेकान्तिनां भवः॥ ७/१/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50012808, "chapter_id": 11499, "verse_number": "40", "content_sanskrit": "देहेन्द्रियासुहीनानां वैकुण्ठपुरवासिनाम्। देहसम्बन्धसम्बन्धमेतदाख्यातुमर्हसि॥ ७/१/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50012809, "chapter_id": 11499, "verse_number": "41", "content_sanskrit": "नारद उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50012810, "chapter_id": 11499, "verse_number": "42", "content_sanskrit": "एकदा ब्रह्मणः पुत्रा विष्णोर्लोकं यदृच्छया। सनन्दनादयो जग्मुश्चरन्तो भुवनत्रयम्॥ ७/१/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50012811, "chapter_id": 11499, "verse_number": "43", "content_sanskrit": "पञ्चषड्ढायनार्भाभाः पूर्वेषामपि पूर्वजाः। दिग्वाससः शिशून् मत्वा द्वाःस्थौ तान् प्रत्यषेधताम्॥ ७/१/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50012812, "chapter_id": 11499, "verse_number": "44", "content_sanskrit": "अशपन् कुपिता एवं युवां वासं न चार्हथः। रजस्तमोभ्यां रहिते पादमूले मधुद्विषः। पापिष्ठामासुरीं योनिं बालिशौ यातमाश्वतः॥ ७/१/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50012813, "chapter_id": 11499, "verse_number": "45", "content_sanskrit": "एवं शप्तौ स्वभवनात् पतन्तौ तैः कृपाळुभिः। प्रोक्तौ पुनर्जन्मभिर्वां त्रिभिर्लोकाय कल्प्यताम्॥ ७/१/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 50012814, "chapter_id": 11499, "verse_number": "46", "content_sanskrit": "जज्ञाते तौ दितेः पुत्रौ दैत्यदानववन्दितौ। हिरण्यकशिपुर्ज्येष्ठो हिरण्याक्षोऽनुजस्ततः॥ ७/१/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 50012815, "chapter_id": 11499, "verse_number": "47", "content_sanskrit": "हतो हिरण्यकशिपुर्हरिणा सिंहरूपिणा। हिरण्याक्षो धरोद्धारे बिभ्रता सौकरं वपुः॥ ७/१/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 50012816, "chapter_id": 11499, "verse_number": "48", "content_sanskrit": "हिरण्यकशिपुः पुत्रं प्रह्लादं भगवत्प्रियम्। जिघांसुरकरोन्नाना यातना मृत्युहेतवे॥ ७/१/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 50012817, "chapter_id": 11499, "verse_number": "49", "content_sanskrit": "तं सर्वभूतात्मभूतं प्रशान्तं समदर्शनम्। भगवत्तेजसा स्पृष्टं नाशक्नोद्धन्तुमुद्यमैः॥ ७/१/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 50012818, "chapter_id": 11499, "verse_number": "50", "content_sanskrit": "ततस्तौ राक्षसौ जातौ केशिन्यां विश्रवःसुतौ। रावणः कुम्भकर्णश्च सर्वलोकोपतापनौ॥ ७/१/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 50012819, "chapter_id": 11499, "verse_number": "51", "content_sanskrit": "तत्रापि राघवो भूत्वा न्यहनच्छापमुक्तये। रामवीर्यं श्रोष्यसि त्वं मार्कण्डेयमुखात् प्रभो॥ ७/१/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 50012820, "chapter_id": 11499, "verse_number": "52", "content_sanskrit": "तावद्य क्षत्रियौ जातौ मातृष्वस्रात्मजौ तव। अधुना शापनिर्मुक्तौ कृष्णचक्रहतांहसौ॥ ७/१/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 50012821, "chapter_id": 11499, "verse_number": "53", "content_sanskrit": "वैरानुबन्धतीव्रेण ध्यानेनाच्युतसात्म्यताम्। नीतौ पुनर्हरेः पार्श्वं जग्मतुर्विष्णुपार्षदौ॥ ७/१/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 50012822, "chapter_id": 11499, "verse_number": "54", "content_sanskrit": "युधिष्ठिर उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 50012823, "chapter_id": 11499, "verse_number": "55", "content_sanskrit": "विद्वेषो दयिते पुत्रे कथमासीन्महात्मनि। ब्रूहि मे भगवन् येन प्रह्लादेऽप्यच्युतात्मनि॥ ७/१/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 50012824, "chapter_id": 11499, "verse_number": "56", "content_sanskrit": "इति श्रीमद्भागवते सप्तमस्कन्धे प्रथमोऽध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]