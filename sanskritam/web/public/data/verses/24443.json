[{"id": 7004443000, "chapter_id": 24443, "verse_number": "५-३-१३७-१", "content_sanskrit": "मार्कण्डेय उवाच ।\nधर्मपुत्र ततो गच्छेत्कर्कटेश्वरमुत्तमम् ।\nउत्तरे नर्मदाकूले सर्वपापक्षयंकरम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004443001, "chapter_id": 24443, "verse_number": "५-३-१३७-२", "content_sanskrit": "तत्र स्नात्वा विधानेन यस्तु पूजयते शिवम् ।\nअनिवर्तिका गतिस्तस्य रुद्रलोकादसंशयम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004443002, "chapter_id": 24443, "verse_number": "५-३-१३७-३", "content_sanskrit": "तस्य तीर्थस्य माहात्म्यं पुराणे यच्छ्रुतं मया ।\nन तद्वर्णयितुं शक्यं संक्षेपेण वदाम्यतः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004443003, "chapter_id": 24443, "verse_number": "५-३-१३७-४", "content_sanskrit": "तत्र तीर्थे तु यः कुर्यात्किंचित्कर्म शुभाशुभम् ।\nहर्षान्मदान्महाराज तत्सर्वं जायतेऽक्षयम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004443004, "chapter_id": 24443, "verse_number": "५-३-१३७-५", "content_sanskrit": "तत्र तीर्थे तपस्तप्त्वा वालखिल्या मरीचयः ।\nरमन्तेऽद्यापि लोकेषु स्वेच्छया कुरुनन्दन॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004443005, "chapter_id": 24443, "verse_number": "५-३-१३७-६", "content_sanskrit": "तत्रस्थास्तन्न जानन्ति नराज्ञानबहिष्कृताः ।\nशरीरस्थमिवात्मानमक्षयं ज्योतिरव्ययम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004443006, "chapter_id": 24443, "verse_number": "५-३-१३७-७", "content_sanskrit": "तत्र तीर्थे नृपश्रेष्ठ देवी नारायणी पुरा ।\nअद्यापि तपते घोरं तपो यावत्किलार्बुदम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004443007, "chapter_id": 24443, "verse_number": "५-३-१३७-८", "content_sanskrit": "तत्र तीर्थे तु यः स्नात्वा तर्पयेत्पितृदेवताः ।\nतस्य ते द्वादशाब्दानि तृप्तिं यान्ति पितामहाः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}]