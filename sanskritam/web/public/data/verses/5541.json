[{"id": 2212957, "chapter_id": 5541, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2212958, "chapter_id": 5541, "verse_number": "१", "content_sanskrit": "भीम ज्येष्ठो गुरुर्मे त्वं नातोऽन्यद् वक्तुमुत्सहे ।\nधृतराष्ट्रोऽपि राजर्षिः सर्वथा मानमर्हति\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2212959, "chapter_id": 5541, "verse_number": "२", "content_sanskrit": "न स्मरन्त्यपराद्धानि स्मरन्ति सुकृतानि च ।\nअसम्भिन्नार्थमर्यादाः साधवः पुरुषोत्तमाः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2212960, "chapter_id": 5541, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2212961, "chapter_id": 5541, "verse_number": "३", "content_sanskrit": "इदं मद्वचनात् क्षत्तः कौरवं ब्रूहि पार्थिवम् ।\nयावदिच्छति पुत्राणां दातुं तावद् ददाम्यहम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2212962, "chapter_id": 5541, "verse_number": "४", "content_sanskrit": "भीष्मादीनां तु सर्वेषां सुहृदामुपकारिणाम् ।\nमम कोशादिविभवे माभूद् भीमः सुदुर्मनाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2212963, "chapter_id": 5541, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2212964, "chapter_id": 5541, "verse_number": "५", "content_sanskrit": "इत्युक्त्वा धर्मराजस्तमर्जुनं प्रत्यपूजयत् ।\nभीमसेनः कटाक्षेण वीक्षाञ्चक्रे धनञ्जयम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2212965, "chapter_id": 5541, "verse_number": "६", "content_sanskrit": "ततः स विदुरं धीमान् वाक्यमाह युधिष्ठिरः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2212966, "chapter_id": 5541, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2212967, "chapter_id": 5541, "verse_number": "७", "content_sanskrit": "न भीमसेने कोपं स नृपतिः कर्तुमर्हति\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2212968, "chapter_id": 5541, "verse_number": "८", "content_sanskrit": "परिक्लिष्टो हि भीमस्तु हिमवातातपादिभिः ।\nदुःखैर्बहुविधैर्धीमान् अरण्ये विदितं तव\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2212969, "chapter_id": 5541, "verse_number": "९", "content_sanskrit": "किं तु मद्वचनाद् ब्रूहि राजानं भरतर्षभम् ।\nयद्यदिच्छति यावच्च गृह्यतां मे गृहादिति\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2212970, "chapter_id": 5541, "verse_number": "१०", "content_sanskrit": "यन्मात्सर्यमयं भीमः करोति भृशदुःखितः ।\nन तन्मनसि कर्तव्यमिति वाच्यः स पार्थिवः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2212971, "chapter_id": 5541, "verse_number": "", "content_sanskrit": "(यन्ममास्ति धनं किञ्चिद् अर्जुनस्य च वेश्मनि ।\nतस्य स्वामी महाराज इति वाच्यश्च पार्थिवः\t॥११॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2212972, "chapter_id": 5541, "verse_number": "१२", "content_sanskrit": "ददातु राजा विप्रेभ्यो यथेष्टं क्रियतामिति ।\nपुत्राणां सुतरां चैव गच्छत्वानृण्यमद्य सः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2212973, "chapter_id": 5541, "verse_number": "१३", "content_sanskrit": "इदं चापि शरीरं मे तत्रायत्तं जनाधिप ।\nधनानि चेति विद्धि त्वं क्षत्तर्नास्त्यत्र संशयः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2212974, "chapter_id": 5541, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nआश्रमवासिकपर्वणि युधिष्ठिरवचनं नाम सप्तदशोऽध्यायः ॥१७॥\nआश्रमवासपर्वणि सप्तदशोऽध्यायः ॥१७॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]