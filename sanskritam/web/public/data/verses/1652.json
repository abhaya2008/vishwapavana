[{"id": 2029840, "chapter_id": 1652, "verse_number": "३-२९०-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2029841, "chapter_id": 1652, "verse_number": "३-२९०-१", "content_sanskrit": "तावुभौ पतितौ दृष्ट्वा भ्रातरौ रामलक्ष्मणौ।\nबबन्ध रावणिर्भूयः शरैर्दत्तवरैस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2029842, "chapter_id": 1652, "verse_number": "३-२९०-२", "content_sanskrit": "तौ वीरौ शरजालेन बद्धाविन्द्रजिता रणे।\nरेजतुः पुरुषव्याघ्रौ शकुन्ताविव पञ्जरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2029843, "chapter_id": 1652, "verse_number": "३-२९०-३", "content_sanskrit": "दृष्ट्वा निपतितौ भूमौ सर्वाङ्गेषु शराचितौ।\nसुग्रीवः कपिभिः सार्धं परिवार्योपतस्तिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2029844, "chapter_id": 1652, "verse_number": "३-२९०-४", "content_sanskrit": "सुषेणमैन्दद्विविदैः कुमुदेनाङ्गदेन च।\nहनुमननीलतारैश्च नलेन च कपीश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2029845, "chapter_id": 1652, "verse_number": "३-२९०-५", "content_sanskrit": "ततस्तं देशमागम्य कृतकर्मा विभीषणः।\nबोधयामास तौ वीरौ प्रज्ञास्त्रेण प्रमोहितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2029846, "chapter_id": 1652, "verse_number": "३-२९०-६", "content_sanskrit": "विशल्यौ चापि सुग्रीवः क्षणेनैतौ चकार ह।\nविशल्यया महौषध्या दिव्यमन्त्रप्रयुक्तया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2029847, "chapter_id": 1652, "verse_number": "३-२९०-७", "content_sanskrit": "तौ लब्धसंज्ञौ नृवरौ विशल्यावुदतिष्ठताम्।\nउभौ गतक्लमौ चास्तां णेनैतौ महारथौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2029848, "chapter_id": 1652, "verse_number": "३-२९०-८", "content_sanskrit": "ततो विभीषणः पार्थ राममिक्ष्वाकुनन्दनम्।\nउवाच विज्वरं दृष्ट्वा कृताञ्जलिरिदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2029849, "chapter_id": 1652, "verse_number": "३-२९०-९", "content_sanskrit": "अयमम्भो गृहीत्वातु राजराजस् शासनात्।\nगुह्कोऽभ्यागतः श्लेतात्त्वत्सकाशमरिंदम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2029850, "chapter_id": 1652, "verse_number": "३-२९०-१०", "content_sanskrit": "इदमम्भः कुबेरस्ते महाराज प्रयच्छति।\nअन्तर्हितानां भूतानां दर्शनार्थं परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2029851, "chapter_id": 1652, "verse_number": "३-२९०-११", "content_sanskrit": "अनेन मृष्टनयनो भूतान्यन्तर्हितान्युत।\nभवान्द्रक्ष्यति यस्मै च भवानेतत्प्रदास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2029852, "chapter_id": 1652, "verse_number": "३-२९०-१२", "content_sanskrit": "तथेति रामस्तद्वारि प्रतिगृह्याभिसंस्कृतम्।\nचकार नेत्रयोः शौचं लक्ष्मणश्च महामनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2029853, "chapter_id": 1652, "verse_number": "३-२९०-१३", "content_sanskrit": "सुग्रीवजाम्बवन्तौ चहनुमानङ्गदस्तथा।\nमैन्दद्विविदनीलाश्च प्रायः प्लवगसत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2029854, "chapter_id": 1652, "verse_number": "३-२९०-१४", "content_sanskrit": "तथासमभवच्चापि यदुवाच विभीषणः।\nक्षणेनातीन्द्रियाण्येषां चक्षुंष्यासन्युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2029855, "chapter_id": 1652, "verse_number": "३-२९०-१५", "content_sanskrit": "इन्द्रजित्कृतकर्मा तु पित्रे कर्म तदाऽऽत्मनः।\nनिवेद्य पुनरागच्छत्त्वरयाऽऽजिशिरःप्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2029856, "chapter_id": 1652, "verse_number": "३-२९०-१६", "content_sanskrit": "तमागतं तु संक्रुद्धं पुनरेव युयुत्सया।\nअभिदुद्राव सौमित्रिर्विभीषणमते स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2029857, "chapter_id": 1652, "verse_number": "३-२९०-१७", "content_sanskrit": "अकृताह्निकमेवैनं जिघांसुर्जितकाशिनम्।\nशरैर्जघान संक्रुद्धः कृतसंज्ञोऽथ लक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2029858, "chapter_id": 1652, "verse_number": "३-२९०-१८", "content_sanskrit": "तयोः समभवद्युद्धं तदाऽन्योन्यं जीगीषतोः।\nअतीव चित्रमाश्चर्यं शक्रप्रह्लादयोरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2029859, "chapter_id": 1652, "verse_number": "३-२९०-१९", "content_sanskrit": "अविध्यदिन्द्रजित्तीक्ष्णैः सौमित्रिं मर्मभेदिभिः।\nसौमित्रिश्चानलस्पर्शैरविध्यद्रावणिं शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2029860, "chapter_id": 1652, "verse_number": "३-२९०-२०", "content_sanskrit": "सौमित्रिशरसंस्पर्शाद्रावणिः क्रोधमूर्च्छितः।\nअसृजल्लक्ष्मणायाष्टौ शरानाशीविषोपमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2029861, "chapter_id": 1652, "verse_number": "३-२९०-२१", "content_sanskrit": "तस्येषून्पावकस्पर्शैः सौमित्रिः पत्रिभिस्त्रिभिः।\n`वारयामास नाराचैः सौमित्रिर्मित्रनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2029862, "chapter_id": 1652, "verse_number": "३-२९०-२२", "content_sanskrit": "असृजल्लक्ष्मणश्चाष्टौ राक्षसाय शरान्पुनः।\nतथा तं न्यहनद्वीरस्तन्मे निगदतः शृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2029863, "chapter_id": 1652, "verse_number": "३-२९०-२३", "content_sanskrit": "एकेनास्य धनुष्मन्तं बाहुं देहादपातयत्।\nद्वितीयेन तु बाणेन भुजमन्यमपातयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2029864, "chapter_id": 1652, "verse_number": "३-२९०-२४", "content_sanskrit": "तृतीयेन तु बाणेन शितधारेण भास्वता।\nजहार सुनसं चापि शिरो ज्वलितकुण्डलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2029865, "chapter_id": 1652, "verse_number": "३-२९०-२५", "content_sanskrit": "विनिकृत्तभुजस्कन्धः कबन्धाकृतिदर्शनः।\n`पपात वसुधायां तु छिन्नमूल इवद्रुमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2029866, "chapter_id": 1652, "verse_number": "३-२९०-२६", "content_sanskrit": "तं हत्वासूतमप्यस्त्रैर्जघान बलिनंवरः।\nलङ्कां प्रवेशयामासुस्तं रथं वाजिनस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2029867, "chapter_id": 1652, "verse_number": "३-२९०-२७", "content_sanskrit": "ददर्श रावणस्तं च रथं पुत्रविनाकृतम्।\nस पुत्रं निहतं श्रुत्वा त्रासात्संभ्रान्तमानसः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2029868, "chapter_id": 1652, "verse_number": "३-२९०-२८", "content_sanskrit": "रावणः शोकमोहार्तो वैदेहीं हन्तुमुद्यतः ॥\nङ्गमादाय दुष्टात्मा जवेनाभिपपात ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2029869, "chapter_id": 1652, "verse_number": "३-२९०-२९", "content_sanskrit": "तं दृष्ट्वातस्य दुर्बुद्देरविन्ध्यः पापनिश्चयम्।\nशमयामास संक्रुद्धं श्रूयतां येन हेतुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2029870, "chapter_id": 1652, "verse_number": "३-२९०-३०", "content_sanskrit": "महाराज्येस्थितो दीप्ते न स्त्रियं हन्तुमर्हसि।\nहतैवैषा यदा स्त्री च कबन्धनस्था च ते वशे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2029871, "chapter_id": 1652, "verse_number": "३-२९०-३१", "content_sanskrit": "न चैषा दहभेदेन हतास्यादिति मे मतिः।\nजहि भर्तारमेवास्या हते तस्मिन्हता भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2029872, "chapter_id": 1652, "verse_number": "३-२९०-३२", "content_sanskrit": "न हि ते विक्रमे तुल्यः साक्षादपि शतक्रतुः।\nअसकृद्धि त्वया सन्द्रास्त्रासितास्त्रिदसा युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2029873, "chapter_id": 1652, "verse_number": "३-२९०-३३", "content_sanskrit": "एवं बहुविधैर्वाक्यैरविन्ध्यो रावणं तदा।\nक्रुद्धं संशमयामास जगृहे च स तद्वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2029874, "chapter_id": 1652, "verse_number": "३-२९०-३४", "content_sanskrit": "निर्याणे स मतिं कृत्वा नियन्तारं क्षपाचरः।\nआज्ञापयामास तदारथो मे कल्प्यतामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2029875, "chapter_id": 1652, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि रामोपाख्यानपर्वणि नवत्यधिकद्विशततमोऽध्यायः ॥ २९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]