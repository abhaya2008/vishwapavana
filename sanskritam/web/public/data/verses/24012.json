[{"id": 7004012000, "chapter_id": 24012, "verse_number": "३-२-२३-१", "content_sanskrit": "व्यास उवाच ।\nअतः परं प्रवक्ष्यामि ब्रह्मणा यत्कृतं पुरा ।\nतत्सर्वं कथयाम्यद्य शृणुष्वैकाग्रमानसः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004012001, "chapter_id": 24012, "verse_number": "३-२-२३-२", "content_sanskrit": "देवानां दानवानां च वैराद्युद्धं बभूव ह ।\nतस्मिन्युद्धे महादुष्टे देवाः संक्लिष्टमानसाः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004012002, "chapter_id": 24012, "verse_number": "३-२-२३-३", "content_sanskrit": "बभूवुस्तत्र सोद्वेगा ब्रह्माणं शरणं ययुः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004012003, "chapter_id": 24012, "verse_number": "३-२-२३-४", "content_sanskrit": "देवा ऊचुः ।\nब्रह्मन्केन प्रकारेण दैत्यानां वधमेव च ।\nकरोम्यद्य उपायं हि कथ्यतां शीघ्रमेव मे॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004012004, "chapter_id": 24012, "verse_number": "३-२-२३-५", "content_sanskrit": "ब्रह्मोवाच ।\nमया हि शंकरेणैव विष्णुना हि तथा पुरा ।\nयमस्य तपसा तुष्टैर्धर्मारण्यं विनिर्मितम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004012005, "chapter_id": 24012, "verse_number": "३-२-२३-६", "content_sanskrit": "तत्र यद्दीयते दानं यज्ञं वा तप उत्तमम् ।\nतत्सर्वं कोटिगुणितं भवेदिति न संशयः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004012006, "chapter_id": 24012, "verse_number": "३-२-२३-७", "content_sanskrit": "पापं वा यदि वा पुण्यं सर्वं कोटि गुणं भवेत् ।\nतस्माद्दैत्यैर्न धर्षितं कदाचिदपि भोः सुराः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004012007, "chapter_id": 24012, "verse_number": "३-२-२३-८", "content_sanskrit": "श्रुत्वा तु ब्रह्मणो वाक्यं देवाः सर्वे सविस्मयाः ।\nब्रह्माणं त्वग्रतः कृत्वा धर्मार ण्यमुपाययुः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004012008, "chapter_id": 24012, "verse_number": "३-२-२३-९", "content_sanskrit": "सत्रं तत्र समारभ्य सहस्राब्दमनुत्तमम् ।\nवृत्वाऽचार्यं चांगिरसं मार्कंण्डेयं तथैव च॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004012009, "chapter_id": 24012, "verse_number": "३-२-२३-१०", "content_sanskrit": "अत्रिं च कश्यपं चैव होता कृत्वा महामतिः ।\nजमदग्निं गौतमं च अध्वर्युत्वं न्यवेदयन्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004012010, "chapter_id": 24012, "verse_number": "३-२-२३-११", "content_sanskrit": "भरद्वाजं वसिष्ठं तु प्रत्यध्वर्युत्वमादिशन् ।\nनारदं चैव वाल्मीकिं नोदना याकरोत्तदा॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004012011, "chapter_id": 24012, "verse_number": "३-२-२३-१२", "content_sanskrit": "ब्रह्मासने च ब्रह्माणं स्थापयामासुरादरात् ।\nक्रोशचतुष्कमात्रां च वेदिं कृत्वा सुरैस्ततः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004012012, "chapter_id": 24012, "verse_number": "३-२-२३-१३", "content_sanskrit": "द्विजाः सर्वे समाहूता यज्ञस्यार्थे हि जापकाः ।\nऋग्यजुःसामाथर्वान्वै वेदानुद्गिरयंति ये॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004012013, "chapter_id": 24012, "verse_number": "३-२-२३-१४", "content_sanskrit": "गणनाथं शंभुसुतं कार्त्तिकेयं तथैव च ।\nइन्द्रं वज्रधरं चैव जयंतं चन्द्रसूनुकम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004012014, "chapter_id": 24012, "verse_number": "३-२-२३-१५", "content_sanskrit": "चत्वारो द्वारपालाश्च देवाः शूरा विनिर्मिताः ।\nततो राक्षोघ्नमंत्रेण हूयते हव्यवाहनः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004012015, "chapter_id": 24012, "verse_number": "३-२-२३-१६", "content_sanskrit": "तिलांश्च यवमिश्रांश्च मध्वाज्येन च मिश्रितान् ।\nजुहुवुस्ते तदा देवा वेदमंत्रैर्नरेश्वर॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004012016, "chapter_id": 24012, "verse_number": "३-२-२३-१७", "content_sanskrit": "आघारावाज्यभागौ च हुत्वा चैव ततः परम् ।\nद्राक्षेक्षुपूगनारिंग जंबीरं बीजपूरकम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004012017, "chapter_id": 24012, "verse_number": "३-२-२३-१८", "content_sanskrit": "उत्तरतो नालिकेरं दाडिमं च यथाक्रमम् ।\nमध्वाज्यं पयसा युक्तं कृशरशर्करायुतम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004012018, "chapter_id": 24012, "verse_number": "३-२-२३-१९", "content_sanskrit": "तंडुलैः शतपत्रैश्च यज्ञे वाचं नियम्य च ।\nविचिंत्य च महाभागाः कृत्वा यज्ञं सदक्षिणम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004012019, "chapter_id": 24012, "verse_number": "३-२-२३-२०", "content_sanskrit": "उत्तमं च शुभं स्तोमं कृत्वा हर्षमुपाययुः ।\nअवारितान्नमददन्दीनांधकृपणेष्वपि॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004012020, "chapter_id": 24012, "verse_number": "३-२-२३-२१", "content_sanskrit": "ब्राह्मणेभ्यो विशेषेण दत्तमन्नं यथेप्सितम् ।\nपायसं शर्करायुक्तं साज्यशाकसमन्वितम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004012021, "chapter_id": 24012, "verse_number": "३-२-२३-२२", "content_sanskrit": "मंडका वटकाः पूपास्तथा वै वेष्टिकाः शुभाः ।\nसहस्रमोदकाश्चापि फेणिका घुर्घुरादयः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004012022, "chapter_id": 24012, "verse_number": "३-२-२३-२३", "content_sanskrit": "ओदनश्च तथा दाली आढकीसंभवा शुभा ।\nतथा वै मुद्गदाली च पर्पटा वटिका तथा॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004012023, "chapter_id": 24012, "verse_number": "३-२-२३-२४", "content_sanskrit": "प्रलेह्यानि विचित्राणि युक्तास्त्र्यूषणसंचयैः ।\nकुल्माषा वेल्लकाश्चैव कोमला वालकाः शुभाः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004012024, "chapter_id": 24012, "verse_number": "३-२-२३-२५", "content_sanskrit": "कर्कटिकाश्चार्द्रयुता मरिचेन समन्विताः ।\nएवंविधानि चान्नानि शाकानि विविधानि च॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004012025, "chapter_id": 24012, "verse_number": "३-२-२३-२६", "content_sanskrit": "भोजयित्वा द्विजान्सर्वान्धर्मारण्य निवासिनः ।\nअष्टादशसहस्राणि सपुत्रांश्च तदा नृप॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004012026, "chapter_id": 24012, "verse_number": "३-२-२३-२७", "content_sanskrit": "प्रतिदिनं तदा देवा भोजयंति स्म वाडवान् ।\nएवं वर्षसहस्रं वै कृत्वा यज्ञं तदामराः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004012027, "chapter_id": 24012, "verse_number": "३-२-२३-२८", "content_sanskrit": "कृत्वा दैत्यवधं राजन्निर्भयत्वमवाप्नुयुः ।\nस्वर्गं जग्मुस्ते सहसा देवाः सर्वे मरुद्गणाः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004012028, "chapter_id": 24012, "verse_number": "३-२-२३-२९", "content_sanskrit": "तथैवाप्सरसः सर्वा ब्रह्मवि ष्णुमहेश्वराः ।\nकैलासशिखरं रम्यं वैकुंठं विष्णुवल्लभम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004012029, "chapter_id": 24012, "verse_number": "३-२-२३-३०", "content_sanskrit": "ब्रह्मलोकं महापुण्यं प्राप्य सर्वे दिवौकसः ।\nपरं हर्षमुपाजग्मुः प्राप्य नंदनमुत्तम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004012030, "chapter_id": 24012, "verse_number": "३-२-२३-३१", "content_sanskrit": "स्वेस्वे स्थाने स्थिरीभूत्वा तस्थुः सर्वे हि निर्भयाः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004012031, "chapter_id": 24012, "verse_number": "३-२-२३-३२", "content_sanskrit": "ततः कालेन महता कृताख्ययुगपर्यये ।\nलोहासुरो मदोन्मत्तो ब्रह्मवेषधरः सदा॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004012032, "chapter_id": 24012, "verse_number": "३-२-२३-३३", "content_sanskrit": "आगत्य सर्वान्विप्रांश्च धर्षयेद्धर्मवित्तमान् ।\nशूद्रांश्च वणिजश्चैव दंडघातेन ताडयेत्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004012033, "chapter_id": 24012, "verse_number": "३-२-२३-३४", "content_sanskrit": "विध्वंसयेच्च यज्ञादीन्होमद्रव्याणि भक्षयेत् ।\nवेदिका दीर्घिका दृष्ट्वा कश्मलेन प्रदूषयेत्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004012034, "chapter_id": 24012, "verse_number": "३-२-२३-३५", "content_sanskrit": "मूत्रोत्सर्गपुरीषेण दूषयेत्पुण्यभूमिकाः ।\nगहनेन तथा राजन्स्त्रियो दूषयते हि सः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004012035, "chapter_id": 24012, "verse_number": "३-२-२३-३६", "content_sanskrit": "ततस्ते वाडवाः सर्वे लोहासुरभयातुराः ।\nप्रनष्टाः सपरीवारा गतास्ते वै दिशो दश॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004012036, "chapter_id": 24012, "verse_number": "३-२-२३-३७", "content_sanskrit": "वणिजस्ते भयोद्विग्ना विप्राननुययुर्नृप ।\nमहाभयेन संभीता दूरं गत्वा विमृश्य च॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004012037, "chapter_id": 24012, "verse_number": "३-२-२३-३८", "content_sanskrit": "सह शूद्रैद्विजैः सर्व एकीभूत्वा गतास्तदा ।\nमुक्तारण्यं पुण्यतमं निर्जनं हि ययुश्च ते॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004012038, "chapter_id": 24012, "verse_number": "३-२-२३-३९", "content_sanskrit": "निवासं कारयामासुर्नातिदूरे नरेश्वर ।\nवजिङ्नाम्ना हि तद्ग्रामं वासयामासुरेव ते॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004012039, "chapter_id": 24012, "verse_number": "३-२-२३-४०", "content_sanskrit": "लोहासुरभयाद्राजन्विप्र नाम्ना विनिर्मितम् ।\nशंभुना वणिजा यस्मात्तस्मात्तन्नामधारणम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004012040, "chapter_id": 24012, "verse_number": "३-२-२३-४१", "content_sanskrit": "शंभुग्राममिति ख्यातं लोके विख्यातिमागतम् ।\nअथ केचिद्भयान्नष्टा वणिजः प्रथमं तदा॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004012041, "chapter_id": 24012, "verse_number": "३-२-२३-४२", "content_sanskrit": "ते नातिदूरे गत्वा वै मंडलं चक्रुरुत्तमम् ।\nविप्रागमनकांक्षास्ते तत्र वासमकल्पयन्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004012042, "chapter_id": 24012, "verse_number": "३-२-२३-४३", "content_sanskrit": "मंडलेति च नाम्ना वै ग्रामं कृत्वा न्यवीवसन् ।\nविप्रसार्थपरिभ्रष्टाः केचित्तु वणिजस्तदा॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004012043, "chapter_id": 24012, "verse_number": "३-२-२३-४४", "content_sanskrit": "अन्यमार्गे गता ये वै लोहासुरभयार्दिताः ।\nधर्मारण्यान्नाति दूरे गत्वा चिंतामुपाययुः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004012044, "chapter_id": 24012, "verse_number": "३-२-२३-४५", "content_sanskrit": "कस्मिन्मार्गे वयं प्राप्ताः कस्मिन्प्राप्ता द्विजातयः ।\nइति चिंतां परं प्राप्ता वासं तत्र त्वकारयन्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004012045, "chapter_id": 24012, "verse_number": "३-२-२३-४६", "content_sanskrit": "अन्यमार्गे गता यस्मात्तस्मात्तन्नामसंभवम् ।\nग्रामं निवासयामासुरडालंजमिति क्षितौ॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004012046, "chapter_id": 24012, "verse_number": "३-२-२३-४७", "content_sanskrit": "यस्मिन्ग्रामे निवासी यो यत्संज्ञश्च वणिग्भवेत् ।\nतस्य ग्रामस्य तन्नाम ह्यभवत्पृथिवीपते॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004012047, "chapter_id": 24012, "verse_number": "३-२-२३-४८", "content_sanskrit": "वणिजश्च तथा विप्रा मोहं प्राप्ता भयार्दिताः ।\nतस्मान्मोहेतिसंज्ञास्ते राजन्सर्वे निरब्रुवन्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004012048, "chapter_id": 24012, "verse_number": "३-२-२३-४९", "content_sanskrit": "एवं प्रनषणं नष्टास्ते गताश्च दिशो दिश ।\nधर्मारण्ये न तिष्ठंति वाडवा वणिजोऽपि वा॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004012049, "chapter_id": 24012, "verse_number": "३-२-२३-५०", "content_sanskrit": "उद्वसं हि तदा जातं धर्मारण्यं च दुर्लभम् ।\nभूषणं सर्वतीर्थानां कृतं लोहासुरेण तत्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004012050, "chapter_id": 24012, "verse_number": "३-२-२३-५१", "content_sanskrit": "नष्टद्विजं नष्टतीर्थं स्थानं कृत्वा हि दानवः ।\nपरां मुदमवाप्यैव जगाम स्वालयं ततः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]