[{"id": 2201801, "chapter_id": 5301, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2201802, "chapter_id": 5301, "verse_number": "१", "content_sanskrit": "श्रुतं मे भरतश्रेष्ठ पुष्पधूपप्रदायिनाम् ।\nफलं बलिविधाने च तद् भूयो वक्तुमर्हसि\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2201803, "chapter_id": 5301, "verse_number": "२", "content_sanskrit": "धूपप्रदानस्य फलं प्रदीपस्य तथैव च ।\nबलयश्च किमर्थं वै क्षिप्यन्ते गृहमेधिभिः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2201804, "chapter_id": 5301, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2201805, "chapter_id": 5301, "verse_number": "३", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nनहुषं प्रति संवादमगस्त्यस्य भृगोस्तथा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2201806, "chapter_id": 5301, "verse_number": "४", "content_sanskrit": "नहुषो हि महाराज राजर्षिः सुमहातपाः ।\nदेवराज्यमनुप्राप्य सुकृतेनेह कर्मणा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2201807, "chapter_id": 5301, "verse_number": "५", "content_sanskrit": "तत्रापि प्रयतो राजन् नहुषस्त्रिदिवे वसन् ।\nमानुषीश्चैव दिव्याश्च कुर्वाणो विविधाः क्रियाः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2201808, "chapter_id": 5301, "verse_number": "६", "content_sanskrit": "मानुष्यस्तत्र सर्वाः स्म क्रियास्तस्य महात्मनः ।\nप्रवृत्तास्त्रिदिवे राजन् दिव्याश्चैव सनातनाः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2201809, "chapter_id": 5301, "verse_number": "७", "content_sanskrit": "अग्निकार्याणि समिधः कुशाः सुमनसस्तथा ।\nबलयश्चान्नलाजाभिर्धूपनं दीपकर्म च\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2201810, "chapter_id": 5301, "verse_number": "८", "content_sanskrit": "सर्वं तस्य गृहे राज्ञः प्रावर्तत महात्मनः ।\nजपयज्ञान् मनोयज्ञान् त्रिदिवेऽपि चकार सः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2201811, "chapter_id": 5301, "verse_number": "९", "content_sanskrit": "दैवतान्यर्चयंश्चापि विधिवत् स सुरेश्वरः ।\nसर्वाण्येव यथान्यायं यथापूर्वमरिन्दम\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2201812, "chapter_id": 5301, "verse_number": "१०", "content_sanskrit": "अथेन्द्रस्य भविष्यत्वादहङ्कारस्तमाविशत् ।\nसर्वाश्चैव क्रियास्तस्य पर्यहीयन्त भूपते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2201813, "chapter_id": 5301, "verse_number": "११", "content_sanskrit": "स ऋषीन् वाहयामास वरदानमदान्वितः ।\nपरिहीनक्रियश्चापि दुर्बलत्वमुपेयिवान्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2201814, "chapter_id": 5301, "verse_number": "१२", "content_sanskrit": "तस्य वाहयतः कालो मुनिमुख्यान् तपोधनान् ।\nअहङ्काराभिभूतस्य सुमहानत्यवर्तत\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2201815, "chapter_id": 5301, "verse_number": "१३", "content_sanskrit": "अथ पर्यायश ऋषीन् वाहनायोपचक्रमे ।\nपर्यायश्चाप्यगस्त्यस्य समपद्यत भारत\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2201816, "chapter_id": 5301, "verse_number": "१४", "content_sanskrit": "अथागम्य महातेजा भृगुर्ब्रह्मविदां वरः ।\nअगस्त्यमाश्रमस्थं वै समुपेत्येदमब्रवीत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2201817, "chapter_id": 5301, "verse_number": "१५", "content_sanskrit": "एवं वयमसत्कारं देवेन्द्रस्यास्य दुर्मतेः ।\nनहुषस्य किमर्थं वै मर्षयाम महामुने\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2201818, "chapter_id": 5301, "verse_number": "", "content_sanskrit": "अगस्त्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2201819, "chapter_id": 5301, "verse_number": "१६", "content_sanskrit": "कथमेष मया शक्यः शप्तुं यस्य महामुने ।\nवरदेन वरो दत्तो विदितो भवतश्च सः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2201820, "chapter_id": 5301, "verse_number": "१७", "content_sanskrit": "यो मे दृष्टिपथं गच्छेत् स मे वश्यो भवेदिति ।\nइत्यनेन वरो देवान् याचितो गच्छता दिवम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2201821, "chapter_id": 5301, "verse_number": "१८", "content_sanskrit": "एवं न दग्धः स मया भवता च न संशयः ।\nअन्येनाप्यृषिमुख्येन न शप्तो न च पातितः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2201822, "chapter_id": 5301, "verse_number": "१९", "content_sanskrit": "अमृतं चैव पानाय दत्तमस्मै पुरा विभो ।\nमहात्मने तदर्थं च नास्माभिर्विनिपात्यते\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2201823, "chapter_id": 5301, "verse_number": "२०", "content_sanskrit": "प्रायच्छत वरं देवः प्रजानां दुःखकारकम् ।\nद्विजेष्वधर्मयुक्तानि स करोति नराधमः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2201824, "chapter_id": 5301, "verse_number": "२१", "content_sanskrit": "अत्र यत्प्राप्तकालं नस्तद् ब्रूहि वदतांवर ।\nभवांश्चापि यथा ब्रूयात् तत्कर्तास्मि न संशयः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2201825, "chapter_id": 5301, "verse_number": "", "content_sanskrit": "भृगुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2201826, "chapter_id": 5301, "verse_number": "२२", "content_sanskrit": "पितामहनियोगेन भवन्तमहमागतः ।\nप्रतिकर्तुं बलवति नहुषे दर्पमास्थिते\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2201827, "chapter_id": 5301, "verse_number": "२३", "content_sanskrit": "अद्य हि त्वा सुदुर्बुद्धी रथे योक्ष्यति देवराट् ।\nअद्यैनमहमुद्वृत्तं करिष्येऽनिन्द्रमोजसा\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2201828, "chapter_id": 5301, "verse_number": "२४", "content_sanskrit": "अद्येन्द्रं स्थापयिष्यामि पश्यतस्ते शतक्रतुम् ।\nसञ्चाल्य पापकर्माणमिन्द्रस्थानात् सुदुर्मतिम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2201829, "chapter_id": 5301, "verse_number": "२५", "content_sanskrit": "अद्य चासौ कुदेवेन्द्रस्त्वां पदा धर्षयिष्यति ।\nदैवोपहतचित्तत्वादात्मनाशाय मन्दधीः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2201830, "chapter_id": 5301, "verse_number": "२६", "content_sanskrit": "व्युत्क्रान्तधर्मं तमहं धर्षणामर्षितो भृशम् ।\nअहिर्भवस्वेति रुषा शप्स्ये पापं द्विजद्रुहम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2201831, "chapter_id": 5301, "verse_number": "२७", "content_sanskrit": "तत एनं सुदुर्बुद्धिं धिक्शब्दाभिहतत्विषम् ।\nधरण्यां पातयिष्यामि प्रेक्षतस्ते महामुने\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2201832, "chapter_id": 5301, "verse_number": "२८", "content_sanskrit": "नहुषं पापकर्माणमैश्वर्यबलमोहितम् ।\nयथा च रोचते तुभ्यं तथा कर्तास्म्यहं मुने\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2201833, "chapter_id": 5301, "verse_number": "२९", "content_sanskrit": "एवमुक्तस्तु भृगुणा मैत्रावरुणिरव्ययः ।\nअगस्त्यः परमप्रीतो बभूव विगतज्वरः ।\nतथा चकार तत्सर्वं पपात नहुषो यथा\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2201834, "chapter_id": 5301, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे अगस्त्यभृगुसंवादो नाम द्विपञ्चाशदुत्तरशततमोऽध्यायः ॥१५२॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]