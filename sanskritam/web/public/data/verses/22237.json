[{"id": 7002237000, "chapter_id": 22237, "verse_number": "२८२-१", "content_sanskrit": "धन्वन्तरिरुवाच ।\nवृक्षायुर्वेदमाख्यास्ये प्लक्षश्चोत्तरतः शुभः ।\nप्राग्वटो याम्यतस्त्वाम्र आप्येऽश्वत्थः क्रमेण तु ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002237001, "chapter_id": 22237, "verse_number": "२८२-२", "content_sanskrit": "दक्षिणां दिशमुत्पन्नाः समीपे कण्टकद्रुमाः ।\nउद्यानं गृहवासे स्यात्तिलान् वाप्यथ पुष्पितान् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002237002, "chapter_id": 22237, "verse_number": "२८२-३", "content_sanskrit": "गृह्णीयाद्रोपयेद्वृक्षान् द्विजञ्चन्द्रं प्रपूज्य च ।\nध्रुवाणि पञ्च वायव्यं हस्तं प्राजेशवैष्णवं ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002237003, "chapter_id": 22237, "verse_number": "२८२-४", "content_sanskrit": "नक्षत्राणि तथा मूलं शस्यन्ते द्रुमरोपणे ।\nप्रवेशयेन्नदीवाहान् पुष्करिण्यान्तु कारयेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002237004, "chapter_id": 22237, "verse_number": "२८२-५", "content_sanskrit": "हस्ता मघा तथा मैत्रमाद्यं पुष्यं सवासवं ।\nजलाशयसमारम्भे वारुणञ्चोत्तरात्रयम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002237005, "chapter_id": 22237, "verse_number": "२८२-६", "content_sanskrit": "संपूज्य वरुणं विष्णुं पर्जन्यं तत्समाचरेत् ।\nअरिष्टाशोकपुन्नागशिरीषाः सप्रियङ्गवः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002237006, "chapter_id": 22237, "verse_number": "२८२-७", "content_sanskrit": "अशोकः कदली जम्बुस्तथा वकुलदाडिमाः ।\nसायं प्रातस्तु घर्मर्तौ शीतकाले दिनान्तरे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002237007, "chapter_id": 22237, "verse_number": "२८२-८", "content_sanskrit": "वर्षारत्रौ भुवः शोषे सेक्तव्या रोपिता द्रुमाः ।\nउत्तमं विंशतिर्हस्ता मध्यमं षोडशान्तरम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002237008, "chapter_id": 22237, "verse_number": "२८२-९", "content_sanskrit": "स्थानात्स्थानान्तरं कार्यं वृक्षाणां द्वादशावरं ।\nविफलाः स्युर्घना वृक्षाः शस्त्रेणादौ हि शोधनम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002237009, "chapter_id": 22237, "verse_number": "२८२-१०", "content_sanskrit": "विडङ्गघृतपङ्काक्तान् सेचयेच्छीतवारिणा ।\nफलनाशे कुलथैश्च मासैर्मुद्गैर्यवैस्तिलैः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002237010, "chapter_id": 22237, "verse_number": "२८२-११", "content_sanskrit": "घृतशीतपयःसेकः फलपुष्पाय सर्वदा ।\nआविकाजशकृच्चूर्णं यवचूर्णं तिलानि च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002237011, "chapter_id": 22237, "verse_number": "२८२-१२", "content_sanskrit": "गोमांसमुदकञ्चैव सप्तरात्रं निधापयेत् ।\nउत्सेकः सर्ववृक्षाणां फलपुष्पादिवृद्धिदः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002237012, "chapter_id": 22237, "verse_number": "२८२-१३", "content_sanskrit": "मत्स्याम्भसा तु सेकेन वृद्धिर्भवति शाखिनः ।\nविडङ्गतण्डुलोपेतं मत्स्यं मांसं हि दोहदं ।\nसर्वेषामविशेषेण वृक्षाणां रोगमर्दनम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]