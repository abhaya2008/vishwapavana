[{"id": 2151154, "chapter_id": 4282, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2151155, "chapter_id": 4282, "verse_number": "१", "content_sanskrit": "अथ गावल्गणिर्धीमान् समरादेत्य सञ्जयः ।\nप्रत्यक्षदर्शी सर्वस्य भूतभव्यभविष्यवित् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2151156, "chapter_id": 4282, "verse_number": "२", "content_sanskrit": "वचनाद् धृतराष्ट्रस्य कुरुक्षेत्रं जगाम ह ।\nव्यासस्य वरदानेन त्वरमाणस्तु सञ्जयः ।\nदृष्ट्वा तु समरे राजन् क्षणेनैव समागतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2151157, "chapter_id": 4282, "verse_number": "३", "content_sanskrit": "ध्यायते धृतराष्ट्राय सहसोपेत्य दुःखितः ।\nआचष्ट निहतं भीष्मं भरतानाममद्यपम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2151158, "chapter_id": 4282, "verse_number": "४", "content_sanskrit": "सञ्जयोऽहं महाराज नमस्ते भरतर्षभ ।\nहतो भीष्मः शान्तनवो भरतानां पितामहः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2151159, "chapter_id": 4282, "verse_number": "५", "content_sanskrit": "ककुदं सर्वयोधानां धाम सर्वधनुष्मताम् ।\nशरतल्पगतः सोऽद्य शेते कुरुपितामहः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2151160, "chapter_id": 4282, "verse_number": "६", "content_sanskrit": "यस्य वीर्यं समाश्रित्य द्यूतं पुत्रस्तवाकरोत् ।\nस शेते निहतो राजन् सङ्खे भीष्मः शिखण्डिना ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2151161, "chapter_id": 4282, "verse_number": "७", "content_sanskrit": "यः सर्वान् पृथिवीपालान् समवेतान् महामृधे ।\nजिगायैकरथेनैव काशिपुर्यां महारथः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2151162, "chapter_id": 4282, "verse_number": "८", "content_sanskrit": "जामदग्न्यं रणे राममायोध्य वसुसम्भवः ।\nन हतो जामदग्न्येन स हतोऽद्य शिखण्डिना ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2151163, "chapter_id": 4282, "verse_number": "९", "content_sanskrit": "महेन्द्रसदृशः शौर्ये स्थैर्ये च हिमवानिव ।\nसमुद्र इव गाम्भीर्ये सहिष्णुत्वे धरासमः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2151164, "chapter_id": 4282, "verse_number": "१०", "content_sanskrit": "शरदंष्ट्रो धनुर्वक्त्रः खड्गजिह्वो दुरासदः ।\nनरसिंहः पिता तेऽद्य पाञ्चाल्येन निपातितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2151165, "chapter_id": 4282, "verse_number": "११", "content_sanskrit": "पाण्डवानां महत्सैन्यं यं दृष्ट्वोद्यन्तमाहवे ।\nप्रवेपत भयोद्विग्नं सिंहं दृष्ट्वेव गोगणः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2151166, "chapter_id": 4282, "verse_number": "१२", "content_sanskrit": "परिरक्ष्य स सेनां ते दशरात्रमनीकहा ।\nजगामास्तमिवादित्यः कृत्वा कर्म सुदुष्करम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2151167, "chapter_id": 4282, "verse_number": "१३", "content_sanskrit": "यः स शक्र इवाक्षोभ्यो वर्षन् बाणान् सहस्रशः ।\nजघान युधि योधानामर्बुदं दशभिर्दिनैः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2151168, "chapter_id": 4282, "verse_number": "१४", "content_sanskrit": "स शेते निष्टनन् भूमौ वातरुग्ण इव द्रुमः ।\nतव दुर्मन्त्रिते राजन् यथा नार्हः स भारत ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2151169, "chapter_id": 4282, "verse_number": "१४", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां भीष्मपर्वणि चतुर्दशोऽध्यायः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2151170, "chapter_id": 4282, "verse_number": "१", "content_sanskrit": "॥ भगवद्गीतापर्वणि प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]