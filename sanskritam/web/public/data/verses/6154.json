[
  {
    "id": 16754001,
    "chapter_id": 6154,
    "verse_number": "6.1",
    "content_sanskrit": "श्रीभगवानुवाच —",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "base_unit_id": "BG_C06_V01"
  },
  {
    "id": 16754002,
    "chapter_id": 6154,
    "verse_number": "6.2",
    "content_sanskrit": "यं संन्यासमिति प्राहुर्योगं तं विद्धि पाण्डव ।\nन ह्यसंन्यस्तसङ्कल्पो योगी भवति कश्चन ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "base_unit_id": "BG_C06_V02"
  },
  {
    "id": 16754003,
    "chapter_id": 6154,
    "verse_number": "6.3",
    "content_sanskrit": "आरुरुक्षोर्मुनेर्योगं कर्म कारणमुच्यते ।\nयोगारूढस्य तस्यैव शमः कारणमुच्यते ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "base_unit_id": "BG_C06_V03"
  },
  {
    "id": 16754004,
    "chapter_id": 6154,
    "verse_number": "6.4",
    "content_sanskrit": "यदा हि नेन्द्रियार्थेषु न कर्मस्वनुषज्जते ।\nसर्वसङ्कल्पसंन्यासी योगारूढस्तदोच्यते ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "base_unit_id": "BG_C06_V04"
  },
  {
    "id": 16754005,
    "chapter_id": 6154,
    "verse_number": "6.5",
    "content_sanskrit": "उद्धरेदात्मनात्मानं नात्मानमवसादयेत् ।\nआत्मैव ह्यात्मनो बन्धुरात्मैव रिपुरात्मनः ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "base_unit_id": "BG_C06_V05"
  },
  {
    "id": 16754006,
    "chapter_id": 6154,
    "verse_number": "6.6",
    "content_sanskrit": "बन्धुरात्मात्मनस्तस्य येनात्मैवात्मना जितः ।\nअनात्मनस्तु शत्रुत्वे वर्तेतात्मैव शत्रुवत् ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "base_unit_id": "BG_C06_V06"
  },
  {
    "id": 16754007,
    "chapter_id": 6154,
    "verse_number": "6.7",
    "content_sanskrit": "जितात्मनः प्रशान्तस्य परमात्मा समाहितः ।\nशीतोष्णसुखदुःखेषु तथा मानापमानयोः ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "base_unit_id": "BG_C06_V07"
  },
  {
    "id": 16754008,
    "chapter_id": 6154,
    "verse_number": "6.8",
    "content_sanskrit": "ज्ञानविज्ञानतृप्तात्मा कूटस्थो विजितेन्द्रियः ।\nयुक्त इत्युच्यते योगी समलोष्टाश्मकाञ्चनः ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "base_unit_id": "BG_C06_V08"
  },
  {
    "id": 16754009,
    "chapter_id": 6154,
    "verse_number": "6.9",
    "content_sanskrit": "सुहृन्मित्रार्युदासीनमध्यस्थद्वेष्यबन्धुषु ।\nसाधुष्वपि च पापेषु समबुद्धिर्विशिष्यते ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "base_unit_id": "BG_C06_V09"
  },
  {
    "id": 16754010,
    "chapter_id": 6154,
    "verse_number": "6.10",
    "content_sanskrit": "योगी युञ्जीत सततमात्मानं रहसि स्थितः ।\nएकाकी यतचित्तात्मा निराशीरपरिग्रहः ॥ १० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "base_unit_id": "BG_C06_V10"
  },
  {
    "id": 16754011,
    "chapter_id": 6154,
    "verse_number": "6.11",
    "content_sanskrit": "शुचौ देशे प्रतिष्ठाप्य स्थिरमासनमात्मनः ।\nनात्युच्छ्रितं नातिनीचं चैलाजिनकुशोत्तरम् ॥ ११ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "base_unit_id": "BG_C06_V11"
  },
  {
    "id": 16754012,
    "chapter_id": 6154,
    "verse_number": "6.12",
    "content_sanskrit": "तत्रैकाग्रं मनः कृत्वा यतचित्तेन्द्रियक्रियः ।\nउपविश्यासने युञ्ज्याद्योगमात्मविशुद्धये ॥ १२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "base_unit_id": "BG_C06_V12"
  },
  {
    "id": 16754013,
    "chapter_id": 6154,
    "verse_number": "6.13",
    "content_sanskrit": "समं कायशिरोग्रीवं धारयन्नचलं स्थिरः ।\nसम्प्रेक्ष्य नासिकाग्रं स्वं दिशश्चानवलोकयन् ॥ १३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "base_unit_id": "BG_C06_V13"
  },
  {
    "id": 16754014,
    "chapter_id": 6154,
    "verse_number": "6.14",
    "content_sanskrit": "प्रशान्तात्मा विगतभीर्ब्रह्मचारिव्रते स्थितः ।\nमनः संयम्य मच्चित्तो युक्त आसीत मत्परः ॥ १४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "base_unit_id": "BG_C06_V14"
  },
  {
    "id": 16754015,
    "chapter_id": 6154,
    "verse_number": "6.15",
    "content_sanskrit": "युञ्जन्नेवं सदात्मानं योगी नियतमानसः ।\nशान्तिं निर्वाणपरमां मत्संस्थामधिगच्छति ॥ १५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "base_unit_id": "BG_C06_V15"
  },
  {
    "id": 16754016,
    "chapter_id": 6154,
    "verse_number": "6.16",
    "content_sanskrit": "नात्यश्नतस्तु योगोऽस्ति न चैकान्तमनश्नतः ।\nन चातिस्वप्नशीलस्य जाग्रतो नैव चार्जुन ॥ १६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "base_unit_id": "BG_C06_V16"
  },
  {
    "id": 16754017,
    "chapter_id": 6154,
    "verse_number": "6.17",
    "content_sanskrit": "युक्ताहारविहारस्य युक्तचेष्टस्य कर्मसु ।\nयुक्तस्वप्नावबोधस्य योगो भवति दुःखहा ॥ १७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "base_unit_id": "BG_C06_V17"
  },
  {
    "id": 16754018,
    "chapter_id": 6154,
    "verse_number": "6.18",
    "content_sanskrit": "यदा विनियतं चित्तमात्मन्येवावतिष्ठते ।\nनिःस्पृहः सर्वकामेभ्यो युक्त इत्युच्यते तदा ॥ १८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "base_unit_id": "BG_C06_V18"
  },
  {
    "id": 16754019,
    "chapter_id": 6154,
    "verse_number": "6.19",
    "content_sanskrit": "यदा दीपो निवातस्थो नेङ्गते सोपमा स्मृता ।\nयोगिनो यतचित्तस्य युञ्जतो योगमात्मनः ॥ १९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "base_unit_id": "BG_C06_V19"
  },
  {
    "id": 16754020,
    "chapter_id": 6154,
    "verse_number": "6.20",
    "content_sanskrit": "यत्रोपरमते चित्तं निरुद्धं योगसेवया ।\nयत्र चैवात्मनात्मानं पश्यन्नात्मनि तुष्यति ॥ २० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "base_unit_id": "BG_C06_V20"
  },
  {
    "id": 16754021,
    "chapter_id": 6154,
    "verse_number": "6.21",
    "content_sanskrit": "सुखमात्यन्तिकं यत्तद्बुद्धिग्राह्यमतीन्द्रियम् ।\nवेत्ति यत्र न चैवायं स्थितश्चलति तत्त्वतः ॥ २१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "base_unit_id": "BG_C06_V21"
  },
  {
    "id": 16754022,
    "chapter_id": 6154,
    "verse_number": "6.22",
    "content_sanskrit": "यं लब्ध्वा चापरं लाभं मन्यते नाधिकं ततः ।\nयस्मिन्स्थितो न दुःखेन गुरुणापि विचाल्यते ॥ २२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "base_unit_id": "BG_C06_V22"
  },
  {
    "id": 16754023,
    "chapter_id": 6154,
    "verse_number": "6.23",
    "content_sanskrit": "तं विद्याद्दुःखसंयोगवियोगं योगसंज्ञितम् ।\nस निश्चयेन योक्तव्यो योगोऽनिर्विण्णचेतसा ॥ २३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "base_unit_id": "BG_C06_V23"
  },
  {
    "id": 16754024,
    "chapter_id": 6154,
    "verse_number": "6.24",
    "content_sanskrit": "सङ्कल्पप्रभवान्कामांस्त्यक्त्वा सर्वानशेषतः ।\nमनसैवेन्द्रियग्रामं विनियम्य समन्ततः ॥ २४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "base_unit_id": "BG_C06_V24"
  },
  {
    "id": 16754025,
    "chapter_id": 6154,
    "verse_number": "6.25",
    "content_sanskrit": "शनैः शनैरुपरमेद्बुद्ध्या धृतिगृहीतया ।\nआत्मसंस्थं मनः कृत्वा न किञ्चिदपि चिन्तयेत् ॥ २५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "base_unit_id": "BG_C06_V25"
  },
  {
    "id": 16754026,
    "chapter_id": 6154,
    "verse_number": "6.26",
    "content_sanskrit": "यतो यतो निश्चरति मनश्चञ्चलमस्थिरम् ।\nततस्ततो नियम्यैतदात्मन्येव वशं नयेत् ॥ २६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "base_unit_id": "BG_C06_V26"
  },
  {
    "id": 16754027,
    "chapter_id": 6154,
    "verse_number": "6.27",
    "content_sanskrit": "प्रशान्तमनसं ह्येनं योगिनं सुखमुत्तमम् ।\nउपैति शान्तरजसं ब्रह्मभूतमकल्मषम् ॥ २७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "base_unit_id": "BG_C06_V27"
  },
  {
    "id": 16754028,
    "chapter_id": 6154,
    "verse_number": "6.28",
    "content_sanskrit": "युञ्जन्नेवं सदात्मानं योगी विगतकल्मषः ।\nसुखेन ब्रह्मसंस्पर्शमत्यन्तं सुखमश्नुते ॥ २८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "base_unit_id": "BG_C06_V28"
  },
  {
    "id": 16754029,
    "chapter_id": 6154,
    "verse_number": "6.29",
    "content_sanskrit": "सर्वभूतस्थमात्मानं सर्वभूतानि चात्मनि ।\nईक्षते योगयुक्तात्मा सर्वत्र समदर्शनः ॥ २९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "base_unit_id": "BG_C06_V29"
  },
  {
    "id": 16754030,
    "chapter_id": 6154,
    "verse_number": "6.30",
    "content_sanskrit": "यो मां पश्यति सर्वत्र सर्वं च मयि पश्यति ।\nतस्याहं न प्रणश्यामि स च मे न प्रणश्यति ॥ ३० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "base_unit_id": "BG_C06_V30"
  },
  {
    "id": 16754031,
    "chapter_id": 6154,
    "verse_number": "6.31",
    "content_sanskrit": "सर्वभूतस्थितं यो मां भजत्येकत्वमास्थितः ।\nसर्वथा वर्तमानोऽपि स योगी मयि वर्तते ॥ ३१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "base_unit_id": "BG_C06_V31"
  },
  {
    "id": 16754032,
    "chapter_id": 6154,
    "verse_number": "6.32",
    "content_sanskrit": "आत्मौपम्येन सर्वत्र समं पश्यति योऽर्जुन ।\nसुखं वा यदि वा दुःखं स योगी परमो मतः ॥ ३२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "base_unit_id": "BG_C06_V32"
  },
  {
    "id": 16754033,
    "chapter_id": 6154,
    "verse_number": "6.33",
    "content_sanskrit": "अर्जुन उवाच —",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "base_unit_id": "BG_C06_V33"
  },
  {
    "id": 16754034,
    "chapter_id": 6154,
    "verse_number": "6.34",
    "content_sanskrit": "चञ्चलं हि मनः कृष्ण प्रमाथि बलवद्दृढम् ।\nतस्याहं निग्रहं मन्ये वायोरिव सुदुष्करम् ॥ ३४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "base_unit_id": "BG_C06_V34"
  },
  {
    "id": 16754035,
    "chapter_id": 6154,
    "verse_number": "6.35",
    "content_sanskrit": "श्रीभगवानुवाच —",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "base_unit_id": "BG_C06_V35"
  },
  {
    "id": 16754036,
    "chapter_id": 6154,
    "verse_number": "6.36",
    "content_sanskrit": "असंयतात्मना योगो दुष्प्राप इति मे मतिः ।\nवश्यात्मना तु यतता शक्योऽवाप्तुमुपायतः ॥ ३६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "base_unit_id": "BG_C06_V36"
  },
  {
    "id": 16754037,
    "chapter_id": 6154,
    "verse_number": "6.37",
    "content_sanskrit": "अर्जुन उवाच —",
