  {
    "id": 16754038,
    "chapter_id": 6154,
    "verse_number": "6.38",
    "content_sanskrit": "कच्चिन्नोभयविभ्रष्टश्छिन्नाभ्रमिव नश्यति ।\nअप्रतिष्ठो महाबाहो विमूढो ब्रह्मणः पथि ॥ ३८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "base_unit_id": "BG_C06_V38"
  },
  {
    "id": 16754039,
    "chapter_id": 6154,
    "verse_number": "6.39",
    "content_sanskrit": "एतन्मे संशयं कृष्ण च्छेत्तुमर्हस्यशेषतः ।\nत्वदन्यः संशयस्यास्य च्छेत्ता न ह्युपपद्यते ॥ ३९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "base_unit_id": "BG_C06_V39"
  },
  {
    "id": 16754040,
    "chapter_id": 6154,
    "verse_number": "6.40",
    "content_sanskrit": "श्रीभगवानुवाच —",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "base_unit_id": "BG_C06_V40"
  },
  {
    "id": 16754041,
    "chapter_id": 6154,
    "verse_number": "6.41",
    "content_sanskrit": "प्राप्य पुण्यकृतां लोकानुषित्वा शाश्वतीः समाः ।\nशुचीनां श्रीमतां गेहे योगभ्रष्टोऽभिजायते ॥ ४१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "base_unit_id": "BG_C06_V41"
  },
  {
    "id": 16754042,
    "chapter_id": 6154,
    "verse_number": "6.42",
    "content_sanskrit": "अथवा योगिनामेव कुले भवति धीमताम् ।\nएतद्धि दुर्लभतरं लोके जन्म यदीदृशम् ॥ ४२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "base_unit_id": "BG_C06_V42"
  },
  {
    "id": 16754043,
    "chapter_id": 6154,
    "verse_number": "6.43",
    "content_sanskrit": "तत्र तं बुद्धिसंयोगं लभते पौर्वदेहिकम् ।\nयतते च ततो भूयः संसिद्धौ कुरुनन्दन ॥ ४३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "base_unit_id": "BG_C06_V43"
  },
  {
    "id": 16754044,
    "chapter_id": 6154,
    "verse_number": "6.44",
    "content_sanskrit": "पूर्वाभ्यासेन तेनैव ह्रियते ह्यवशोऽपि सः ।\nजिज्ञासुरपि योगस्य शब्दब्रह्मातिवर्तते ॥ ४४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "base_unit_id": "BG_C06_V44"
  },
  {
    "id": 16754045,
    "chapter_id": 6154,
    "verse_number": "6.45",
    "content_sanskrit": "प्रयत्नाद्यतमानस्तु योगी संशुद्धकिल्बिषः ।\nअनेकजन्मसंसिद्धस्ततो याति परां गतिम् ॥ ४५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "base_unit_id": "BG_C06_V45"
  },
  {
    "id": 16754046,
    "chapter_id": 6154,
    "verse_number": "6.46",
    "content_sanskrit": "तपस्विभ्योऽधिको योगी\nज्ञानिभ्योऽपि मतोऽधिकः ।\nकर्मिभ्यश्चाधिको योगी\nतस्माद्योगी भवार्जुन ॥ ४६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "base_unit_id": "BG_C06_V46"
  },
  {
    "id": 16754047,
    "chapter_id": 6154,
    "verse_number": "6.47",
    "content_sanskrit": "योगिनामपि सर्वेषां मद्गतेनान्तरात्मना ।\nश्रद्धावान्भजते यो मां स मे युक्ततमो मतः ॥ ४७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "base_unit_id": "BG_C06_V47"
  }
]