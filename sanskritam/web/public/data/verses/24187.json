[{"id": 7004187000, "chapter_id": 24187, "verse_number": "५-१-३६-१", "content_sanskrit": "व्यास उवाच ।\nमहाकालं किमर्थं तु किं वा शिवपदं स्मृतम् ।\nकोटीश्वरं किमर्थं तु पावकं तत्किमुच्यते॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004187001, "chapter_id": 24187, "verse_number": "५-१-३६-२", "content_sanskrit": "नरदीपं किमर्थं तु द्वितीया वटमातरः ।\nअभयेश्वरं किमर्थं तु शंखोद्धा रणमेव च॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004187002, "chapter_id": 24187, "verse_number": "५-१-३६-३", "content_sanskrit": "शूलेश्वरं किमर्थं तु किमोंकारस्तु कथ्यते ।\nधूतपापं किमर्थं तु किमंगारेश्वरं तथा॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004187003, "chapter_id": 24187, "verse_number": "५-१-३६-४", "content_sanskrit": "पुरी चोज्जयिनी दिव्या सप्तकल्पा कथं स्मृता ।\nकथयस्व मुनिश्रेष्ठ तस्या नामानि यानि च॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004187004, "chapter_id": 24187, "verse_number": "५-१-३६-५", "content_sanskrit": "सनत्कुमार उवाच ।\nशृणु व्यास यथा ख्याता पुरी दिव्या कुश स्थली ।\nनामतः कर्मतः श्रेष्ठा सप्तकल्पानुवासिनी॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004187005, "chapter_id": 24187, "verse_number": "५-१-३६-६", "content_sanskrit": "प्राक्कल्पे स्वर्णशृंगाख्या द्वितीये तु कुशस्थली ।\nतृतीयेऽवंतिका प्रोक्ता चतुर्थेत्वमरा वती॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004187006, "chapter_id": 24187, "verse_number": "५-१-३६-७", "content_sanskrit": "विख्याता पञ्चमे कल्पे पुरी चूडामणीति च ।\nषष्ठे पद्मावती ज्ञेया सप्तमे चोज्जयिनी पुरी॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004187007, "chapter_id": 24187, "verse_number": "५-१-३६-८", "content_sanskrit": "पुनरंते तु कल्पस्य स्वर्णशृङ्गादि का स्मृता ।\nएतानि सप्त नामानि प्रातरुत्थाय यः पठेत्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004187008, "chapter_id": 24187, "verse_number": "५-१-३६-९", "content_sanskrit": "सप्तजन्मकृतात्पापान्मुच्यते नात्र संशयः ।\nउज्जयिन्यां पुरा राजा बभूव किल चांधकः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004187009, "chapter_id": 24187, "verse_number": "५-१-३६-१०", "content_sanskrit": "तस्य पुत्रो महावीर्यो नाम्ना कनकदानवः ।\nयुद्धार्थं स महावीर्यः शक्रं युद्धे समाह्वयत्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004187010, "chapter_id": 24187, "verse_number": "५-१-३६-११", "content_sanskrit": "क्रोधादिंद्रेण संग्रामे युध्य मानो निपातितः ।\nनिहत्य दानवं शक्रो भयादंधासुरस्य तु॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004187011, "chapter_id": 24187, "verse_number": "५-१-३६-१२", "content_sanskrit": "जगाम शंकरान्वेषी कैलासं शंकरालयम् ।\nदृष्ट्वा प्रणम्य देवेशं चंद्रार्धकृत शेखरम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004187012, "chapter_id": 24187, "verse_number": "५-१-३६-१३", "content_sanskrit": "भीतो विज्ञापयामास स चाश्र्वाकुललोचनः ।\nअभयं देहि मे देव दानवादंधकाच्च वै॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004187013, "chapter_id": 24187, "verse_number": "५-१-३६-१४", "content_sanskrit": "शक्रस्येत्थं वचः श्रुत्वा शरणा गतवत्सलः ।\nददावभयमेवासौ मा भैस्त्वमंधकाद्धि वै॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004187014, "chapter_id": 24187, "verse_number": "५-१-३६-१५", "content_sanskrit": "कृत्वा रूपं महादेवो विश्वरूपं सुभैरवम् ।\nसर्पैर्ललद्भिरत्युग्रैस्तीक्ष्णदंष्ट्रैर्विषोल्बणैः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004187015, "chapter_id": 24187, "verse_number": "५-१-३६-१६", "content_sanskrit": "पातालोदररूपैश्च भैरवारावनादिभिः ।\nभुजैरनेकसाहस्रैर्बहुशस्त्रधृतैस्तथा॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004187016, "chapter_id": 24187, "verse_number": "५-१-३६-१७", "content_sanskrit": "सिंहचर्मपरीधानं व्याघ्रत्वगुत्तरीयकम् ।\nगवाजिन कृताटोपं चंद्राग्निरविलोचनम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004187017, "chapter_id": 24187, "verse_number": "५-१-३६-१८", "content_sanskrit": "महामहीध्रतुल्याभ्यां जंघाभ्यां भूषितं सदा ।\nक्षोभयंश्चालयन्सर्वान्पातालस्य तलावधि॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004187018, "chapter_id": 24187, "verse_number": "५-१-३६-१९", "content_sanskrit": "ईदृग्रूपं विधायेशो दनुदैत्यभयावहम् ।\nअवातरन्महीं भीमः पादेनैकेन शंकरः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004187019, "chapter_id": 24187, "verse_number": "५-१-३६-२०", "content_sanskrit": "तत्रैव हि ह्रदो जातः सर्वदैवतवंदितः ।\nख्यातं शिवपदं तद्धि यत्पदाऽक्रांतवान्विभुः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004187020, "chapter_id": 24187, "verse_number": "५-१-३६-२१", "content_sanskrit": "पापानां च पुरा कोटिः पादांगुष्ठेन दारिता ।\nकोटितीर्थमतः ख्यातं सर्वपापप्रणाशनम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004187021, "chapter_id": 24187, "verse_number": "५-१-३६-२२", "content_sanskrit": "अगस्त्येन तथा कोटिस्तीर्थानामवधारिता ।\nअतोऽपीदं शुभं लोके कोटितीर्थं सदा स्मृतम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004187022, "chapter_id": 24187, "verse_number": "५-१-३६-२३", "content_sanskrit": "दृष्ट्वा तु त्रिदशाः सर्वे स्नाता वै हितकाम्यया ।\nमहा कालकृतं रूपं महाकालस्ततः स्मृतः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004187023, "chapter_id": 24187, "verse_number": "५-१-३६-२४", "content_sanskrit": "अंधासुरोऽपि दनुजः पुत्रं श्रुत्वा हतं युधि ।\nक्रोधेन तमसाविष्टो रणतूर्याण्यवादयत॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004187024, "chapter_id": 24187, "verse_number": "५-१-३६-२५", "content_sanskrit": "ससैन्यो निर्गतः प्राप्तो यत्र ते त्रिदशाः स्थिताः ।\nमहत्या सेनया सार्धं रथवारणयुक्तया॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004187025, "chapter_id": 24187, "verse_number": "५-१-३६-२६", "content_sanskrit": "तदैव दानवान्वीक्ष्य महाहवकृतोद्यमान् ।\nवेपंतस्ते सुसंनद्धा शंभुं शरणमाययुः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004187026, "chapter_id": 24187, "verse_number": "५-१-३६-२७", "content_sanskrit": "मा भैरिति महाकालो देवानुक्त्वा त्रिलोचनः ।\nगृहीत्वा शूलमातिष्ठद्दष्टादंष्ट्राधरो रुषा॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004187027, "chapter_id": 24187, "verse_number": "५-१-३६-२८", "content_sanskrit": "कोपयुक्ते विरूपाक्षे ज्वालाभिः पूरितं नभः ।\nअंधकेनाथ रुष्टेन शरकोटिस्तु दुःसहा॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004187028, "chapter_id": 24187, "verse_number": "५-१-३६-२९", "content_sanskrit": "मुक्ता जगाम देवानां ननाश शलभाकृति ।\nविस्फुलिंगार्चिषं वह्निं मुंचमानः पिनाकधृक्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004187029, "chapter_id": 24187, "verse_number": "५-१-३६-३०", "content_sanskrit": "शतशः शकलीचक्रे तं च बाणैरताडयत् ।\nअंधकोऽपि हि युद्धस्थः शिथिलः शिथिला युधः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004187030, "chapter_id": 24187, "verse_number": "५-१-३६-३१", "content_sanskrit": "निरुद्धः शंभुना बाणैरलिभिः पंकजं यथा ।\nतस्य सैन्यं प्रविद्धं च तद्गणैर्युधि योधिभिः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004187031, "chapter_id": 24187, "verse_number": "५-१-३६-३२", "content_sanskrit": "योधवरैर्हता दिव्यैः स्थाणु सान्निध्यमाश्रितैः ।\nततोंऽधकेन सैन्यं स्वं भिन्नं दृष्ट्वा तथासुरैः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004187032, "chapter_id": 24187, "verse_number": "५-१-३६-३३", "content_sanskrit": "आत्मानं च महेशेन विद्धं च बाणकोटिभिः ।\nविदलीकृतदेहोऽसौ भय माश्रित्य वेगतः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004187033, "chapter_id": 24187, "verse_number": "५-१-३६-३४", "content_sanskrit": "चकार तामसीं मायां मायाशतविशारदः ।\nतयांतर्हितदेवेशो जगाम दिशमुत्तराम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004187034, "chapter_id": 24187, "verse_number": "५-१-३६-३५", "content_sanskrit": "शंभुर्भीतिभरं बिभ्रद्बभ्राम भुवि भिन्नहृत् ।\nयस्मिन्मार्गे गतो देवस्तेन दैत्यो जगाम ह॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004187035, "chapter_id": 24187, "verse_number": "५-१-३६-३६", "content_sanskrit": "वदन्न दृश्यते क्वासौ गतो दुष्टः पुनःपुनः ।\nउवाच चांधकः शब्दं तथोवा च महेश्वरः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004187036, "chapter_id": 24187, "verse_number": "५-१-३६-३७", "content_sanskrit": "तत्र तीर्थमथोत्पन्नं वागंधकमभिश्रुतम् ।\nतत्र स्नात्वा शुचिर्भूत्वा यो वै दद्यात्सशर्करम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004187037, "chapter_id": 24187, "verse_number": "५-१-३६-३८", "content_sanskrit": "नवम्यां मार्गशीर्षस्य शुक्लायां श्रद्धयान्वितः ।\nअक्षयं तद्भवेद्दत्तं दाता शिवपुरं व्रजेत्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004187038, "chapter_id": 24187, "verse_number": "५-१-३६-३९", "content_sanskrit": "पितृनुद्दिश्य यत्किंचिद्दीयते भक्तितः शिवे ।\nतृप्तास्तिष्ठंति ते तावद्यावदाभूत संप्लवम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004187039, "chapter_id": 24187, "verse_number": "५-१-३६-४०", "content_sanskrit": "तमसा च्छादिता देवाः संबभूवुः समाकुलाः ।\nसंभ्रांतमनसः सर्वे न किंचिदपि मेनिरे॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004187040, "chapter_id": 24187, "verse_number": "५-१-३६-४१", "content_sanskrit": "एतस्मिन्नंतरे व्यास नरादित्यः स्वतेजसा ।\nउत्तस्थौ नररूपेण कुर्वन्वितिमिरा दिशः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004187041, "chapter_id": 24187, "verse_number": "५-१-३६-४२", "content_sanskrit": "नष्टे तमसि दैत्येपि प्रकाश प्रकटे सति ।\nदेवा मुदमवापुस्ते दृष्ट्वा नरं विलोचनैः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004187042, "chapter_id": 24187, "verse_number": "५-१-३६-४३", "content_sanskrit": "स्तुवंतो विविधैः स्तोत्रैर्नररूपं दिवाकरम् ।\nउत्तस्थौ नररूपेण दीप्तो यस्माद्दिवाकरः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004187043, "chapter_id": 24187, "verse_number": "५-१-३६-४४", "content_sanskrit": "तेनास्य नाम ते चकुर्नरदीप इतीश्वराः ।\nयः पश्यति नरो भक्त्या नरदीपं दिवाकरम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004187044, "chapter_id": 24187, "verse_number": "५-१-३६-४५", "content_sanskrit": "मुच्यते सर्वपापेभ्यो यद्यपि ब्रह्महा भवेत् ।\nषष्ठ्यामर्कदिने विप्र सप्तम्यामुप वासयेत्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004187045, "chapter_id": 24187, "verse_number": "५-१-३६-४६", "content_sanskrit": "दिनच्छिद्रेथ संक्रांतौ ग्रहणे विषुवत्यथ ।\nकुंडे स्नात्वा शुचिर्भूत्वा जपन्नियतमानसः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004187046, "chapter_id": 24187, "verse_number": "५-१-३६-४७", "content_sanskrit": "नरदीपं नरः पश्येत्स्तोत्रवा दित्रमंगलैः ।\nगंधैर्धूपैस्तथा दीपैर्नैवेद्यैः पूजयेत्तथा॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004187047, "chapter_id": 24187, "verse_number": "५-१-३६-४८", "content_sanskrit": "गीतं वाद्यं पुरस्कृत्य प्रणम्याष्टांगमेव च ।\nप्रातर्मध्यापराह्ने वा कृत्वार्कस्य प्रदक्षिणा म्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004187048, "chapter_id": 24187, "verse_number": "५-१-३६-४९", "content_sanskrit": "स मुक्तः सर्वपापैस्तु सप्तजन्मकृतैरपि ।\nसूर्यकोटिप्रतीकाशैर्विमानैः सार्वकामिकैः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004187049, "chapter_id": 24187, "verse_number": "५-१-३६-५०", "content_sanskrit": "सूर्यलोकं प्रयात्याशु यत्सुरैरपि दुर्लभम् ।\nशक्रात्प्राप्य पुरा यस्माद्भानुरत्र प्रतिष्ठितः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004187050, "chapter_id": 24187, "verse_number": "५-१-३६-५१", "content_sanskrit": "नरेणैव प्रसादेन नरदीपस्ततो ह्ययम् ।\nतदैवास्य पुरा व्यास यात्रा शक्रेण निर्मिता॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004187051, "chapter_id": 24187, "verse_number": "५-१-३६-५२", "content_sanskrit": "आगमिष्याम्यहं पार्थ सार्धं देवैः समाहितः ।\nज्येष्ठे सिते द्वितीयायां नरदीपे तु सर्वदा॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004187052, "chapter_id": 24187, "verse_number": "५-१-३६-५३", "content_sanskrit": "तत्राहमागतो ज्ञेयो लोके देवस्य वर्षणात् ।\nततोऽनंतरमागत्य देवा ये त्रिदशालयात्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004187053, "chapter_id": 24187, "verse_number": "५-१-३६-५४", "content_sanskrit": "दृष्ट्वा देवं तथारूढं नरदीपं सुदीपितम् ।\nकृत्वा यात्रां च ते यांति देवयानैरितस्ततः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004187054, "chapter_id": 24187, "verse_number": "५-१-३६-५५", "content_sanskrit": "यः पश्येन्मानवो भक्त्या नरदीपं रथस्थितम् ।\nसर्वपापविनिर्मुक्तः सूर्यलोके महीयते॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004187055, "chapter_id": 24187, "verse_number": "५-१-३६-५६", "content_sanskrit": "रथयात्रामथो वक्ष्ये नरदीपस्य या मुने ।\nतां कृत्वा चैव यत्पुण्यं मुनिभिः परिकीर्तितम्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004187056, "chapter_id": 24187, "verse_number": "५-१-३६-५७", "content_sanskrit": "ज्येष्ठे सिते द्वितीयायां रथस्थो हि दिवाकरः ।\nकुशस्थल्यां द्विजैः श्रेष्ठैर्बाहुक्षेपैः प्रणीयते॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004187057, "chapter_id": 24187, "verse_number": "५-१-३६-५८", "content_sanskrit": "उत्तरां दिशमायांतं यः पश्यति दिवस्पतिम् ।\nअग्निष्टोमस्य यज्ञस्य लभते सोऽखिलं फलम्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004187058, "chapter_id": 24187, "verse_number": "५-१-३६-५९", "content_sanskrit": "निवृत्य केशवार्काद्यो रथं पश्यति मानवः ।\nशुंडीरस्वामिनो यात्रा कृता तेन न संशयः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004187059, "chapter_id": 24187, "verse_number": "५-१-३६-६०", "content_sanskrit": "रथमाकर्षते यस्तु रज्ज्वाकर्षेण वै मुने ।\nकुलमुद्धरते सोऽपि पूर्वान्पितृपितामहान्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004187060, "chapter_id": 24187, "verse_number": "५-१-३६-६१", "content_sanskrit": "दक्षिणाभिमुखं यांतं नरदीपं द्विजोत्तम ।\nये संयताः प्रपश्यंति ते यांति च त्रिविष्टपम्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004187061, "chapter_id": 24187, "verse_number": "५-१-३६-६२", "content_sanskrit": "सूत्रेण वेष्टयेत्क्षेत्रं रथं देवमथापि वा ।\nसर्वान्कामानवाप्नोति कृतपुण्यश्च जायते॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004187062, "chapter_id": 24187, "verse_number": "५-१-३६-६३", "content_sanskrit": "प्रदक्षिणां तु सूर्यस्य भक्त्या कुर्वंति ये नराः ।\nप्रदक्षिणीकृता तैस्तु सप्तद्वीपा वसुंधरा॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004187063, "chapter_id": 24187, "verse_number": "५-१-३६-६४", "content_sanskrit": "प्रातरुत्थाय यो भक्त्या मौनी याति दिवाकरम् ।\nदृष्ट्वा तु पूर्वद्वारेण नमस्कृत्य द्विजोत्तम॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004187064, "chapter_id": 24187, "verse_number": "५-१-३६-६५", "content_sanskrit": "प्रविश्य दक्षिणेनैव रथचक्रं प्रपूजयेत् ।\nतेन द्वारेण निष्क्रम्य प्रणिपत्य व्रजेत्ततः॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004187065, "chapter_id": 24187, "verse_number": "५-१-३६-६६", "content_sanskrit": "पश्चिमं द्वारमाश्रित्य रथस्थं सूर्यमर्चयेत् ।\nचामरं च वितानं च घंटादीनि निवेदयेत्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004187066, "chapter_id": 24187, "verse_number": "५-१-३६-६७", "content_sanskrit": "पूर्वद्वारे तु गौर्दे या तथाश्वश्चैव दक्षिणे ।\nपश्चिमे च गजः प्रोक्त उत्तरे रथ एव च॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004187067, "chapter_id": 24187, "verse_number": "५-१-३६-६८", "content_sanskrit": "कुर्यादेव तु यो यात्रां नरदीपस्य मानवः ।\nसर्वान्कामानवाप्नोति कृतपुण्यश्च जायते॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004187068, "chapter_id": 24187, "verse_number": "५-१-३६-६९", "content_sanskrit": "गोसूर्यशिवशक्राणां स्वर्लोकं लभते शुभम् ।\nप्रदक्षिणा महामेरोः कृता तेन भवेन्मुने॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004187069, "chapter_id": 24187, "verse_number": "५-१-३६-७०", "content_sanskrit": "दद्याद्गवां सहस्रं यो व्यतीपातशते नरः ।\nअश्वानां च सहस्रेण यद्यायात्तत्फलं लभेत्॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004187070, "chapter_id": 24187, "verse_number": "५-१-३६-७१", "content_sanskrit": "नरदीपे रथारूढे वपनं कारयेत्तु यः ।\nश्रिया न विच्युतिस्तस्य सूर्यलोके महीयते॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004187071, "chapter_id": 24187, "verse_number": "५-१-३६-७२", "content_sanskrit": "सूर्यस्य पुरतो वाप्यां मासं नित्यं सरस्वती ।\nयस्तामालोकते मर्त्यो दुःस्वप्नं तस्य नश्यति॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004187072, "chapter_id": 24187, "verse_number": "५-१-३६-७३", "content_sanskrit": "भक्त्या योऽनुदिनं व्यास नरदीपं प्रपश्यति ।\nउत्तमं स्थान मासाद्य पुत्रपौत्रसमन्वितः॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004187073, "chapter_id": 24187, "verse_number": "५-१-३६-७४", "content_sanskrit": "प्रक्रीड्य बंधुभिः सार्धं मृतः सूर्यपुरं व्रजेत् ।\nप्रनष्टे तिमिरे विप्र जाते सर्वत्र सुप्रभे॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004187074, "chapter_id": 24187, "verse_number": "५-१-३६-७५", "content_sanskrit": "हतेंऽधके महेशेन शूलेन त्रिशिखेन वै ।\nप्रहृष्टाश्च सुराः सर्वे ब्रह्मेंद्रप्रमुखास्तदा॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004187075, "chapter_id": 24187, "verse_number": "५-१-३६-७६", "content_sanskrit": "शंखं दध्मौ तदा विष्णुः सुराणां हितकाम्यया ।\nतत्र तीर्थमथोत्पन्नं शंखोद्धारणसंज्ञ कम्॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004187076, "chapter_id": 24187, "verse_number": "५-१-३६-७७", "content_sanskrit": "तत्र संनिहितो विष्णुर्लिंगं चैव चतुर्मुखम् ।\nअनाद्यं चैव विप्रेंद्र लिंगस्यैव समीपतः॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004187077, "chapter_id": 24187, "verse_number": "५-१-३६-७८", "content_sanskrit": "देवस्य दक्षिणे भागे शूलेनाधिष्ठितः स्थितः ।\nचतुर्दश्यां तथाष्टम्यां ये पश्यंति जितेंद्रियाः॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004187078, "chapter_id": 24187, "verse_number": "५-१-३६-७९", "content_sanskrit": "ते क्षीणाशेषपापौघाः प्राप्स्यंति परमां गतिम् ।\nयोगिनीनां बलिं यस्तु यथावत्संप्रदा स्यति॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004187079, "chapter_id": 24187, "verse_number": "५-१-३६-८०", "content_sanskrit": "भूतप्रेतपिशाचाद्यैर्नासौ केनापि बाध्यते ।\nद्वादशीं समुपोष्यैव स्नात्वा देवं जनार्दनम्॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004187080, "chapter_id": 24187, "verse_number": "५-१-३६-८१", "content_sanskrit": "यः पश्येच्छंखिनं देवं सोऽच्युतं स्थानमाप्नुयात्॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004187081, "chapter_id": 24187, "verse_number": "५-१-३६-८२", "content_sanskrit": "यः स्थूलसूक्ष्मप्रकटप्रकाशो यः सर्वभूतो न च सर्वभूतः ।\nविश्व यतश्चैव हि विश्वहेतुर्नमोस्तु तस्मै पुरुषोत्तमाय॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}]