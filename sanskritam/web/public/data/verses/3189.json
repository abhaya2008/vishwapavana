[{"id": 2101533, "chapter_id": 3189, "verse_number": "१४-४५-१", "content_sanskrit": "ब्रह्मोवाच।\nबुद्धिसारं मनस्तम्भमिन्द्रियग्रामबन्धनम्।\nमहाभूतारविष्कम्भं निमेषपरिवेष्टनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2101534, "chapter_id": 3189, "verse_number": "१४-४५-२", "content_sanskrit": "जराशोकसमाविष्टं व्याधिव्यसनसञ्चरम्।\nदेशकालविचारीदं श्रमव्यायामनिःस्वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2101535, "chapter_id": 3189, "verse_number": "१४-४५-३", "content_sanskrit": "अहोरात्रपरिक्षेपं शीतोष्णपरिमण्डलम्।\nसुखदुःखान्तसंश्लेषं क्षुत्पिपासावकीलकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2101536, "chapter_id": 3189, "verse_number": "१४-४५-४", "content_sanskrit": "छायातपविलेखं च निमेषोन्मेषविह्वलम्।\nशोकमोहजराकीर्णं वर्तमानमचेतनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2101537, "chapter_id": 3189, "verse_number": "१४-४५-५", "content_sanskrit": "मासार्धमासगुणितं विषमं लोकसञ्चरम्।\nतमोनिचयपङ्कं च रजोवेगप्रवर्तकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2101538, "chapter_id": 3189, "verse_number": "१४-४५-६", "content_sanskrit": "सत्त्वालङ्कारदीप्तं च गुणसंघातमण्डलम्।\nविरतिग्रहणाभीकं शोकसंहारवर्तनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2101539, "chapter_id": 3189, "verse_number": "१४-४५-७", "content_sanskrit": "क्रियाकारणसंयुक्तं रागविस्तारमायतम्।\nलोभेप्सापरिविक्षोभं विविक्तज्ञानसम्भवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2101540, "chapter_id": 3189, "verse_number": "१४-४५-८", "content_sanskrit": "भयमोहपरीवारं भूतसंमोहकारकम्।\nआनन्दप्रीतिचारं च कामक्रोधपरिग्रहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2101541, "chapter_id": 3189, "verse_number": "१४-४५-९", "content_sanskrit": "महदादिविशेषान्तमव्यक्तं प्रभवाप्ययम्।\nमनोजवनमश्रान्तं कालचक्रं प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2101542, "chapter_id": 3189, "verse_number": "१४-४५-१०", "content_sanskrit": "एतद्द्वन्द्वसमायुक्तं कालचक्रमचेतनम्।\nविसृजेत्संक्षिपेच्चापि बोधयेत्स्वापयेज्जगम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2101543, "chapter_id": 3189, "verse_number": "१४-४५-११", "content_sanskrit": "कालचक्रप्रवृत्तिं च निवृत्तिं चैव तत्त्वतः।\nयस्तु वेद नरो नित्यं न स भूतेषु मुह्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2101544, "chapter_id": 3189, "verse_number": "१४-४५-१२", "content_sanskrit": "विमुक्तः सर्वसङ्क्लेशैः सर्वद्वन्द्वातिगो मुनिः।\nविमुक्तः सर्वपापेभ्यः प्राप्नोति परमां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2101545, "chapter_id": 3189, "verse_number": "१४-४५-१३", "content_sanskrit": "गृहस्थो ब्रह्मचारी च वानप्रस्थोऽथ भिक्षुकः।\nचत्वार आश्रमाः प्रोक्ताः सर्वे गार्हस्थ्यमूलकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2101546, "chapter_id": 3189, "verse_number": "१४-४५-१४", "content_sanskrit": "यः कश्चिदिह लोकेऽस्मिन्नाश्रमः परिकीर्तितः।\nतस्यान्तगमनं श्रेयः कीर्तिरेषा सनातनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2101547, "chapter_id": 3189, "verse_number": "१४-४५-१५", "content_sanskrit": "संस्कारैः संस्कृतः पूर्वं यथावच्चरितव्रतः।\nजातौ गुणविशिष्टायां समावर्तेत वेदवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2101548, "chapter_id": 3189, "verse_number": "१४-४५-१६", "content_sanskrit": "स्वदारनिरतो नित्यं शिष्टाचारो जितेन्द्रियः।\nपञ्चभिश्च महायज्ञैः श्रद्दधानो यजेदिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2101549, "chapter_id": 3189, "verse_number": "१४-४५-१७", "content_sanskrit": "देवतातिथिशिष्टाशी निरतो वेदकर्मसु।\nइज्याप्रदानयुक्तश्च यथाशक्ति यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2101550, "chapter_id": 3189, "verse_number": "१४-४५-१८", "content_sanskrit": "न पाणिपादचपलो न नेत्रचपलो मुनिः।\nन च वागङ्गचपल इति शिष्टस्य गोचरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2101551, "chapter_id": 3189, "verse_number": "१४-४५-१९", "content_sanskrit": "नित्यं यज्ञोपवीती स्याच्छुक्लवासाः शुचिव्रतः।\nनियतो यमदानाभ्यां सदा शिष्टैश्च संविशेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2101552, "chapter_id": 3189, "verse_number": "१४-४५-२०", "content_sanskrit": "जितशिश्नोदरो मैत्रः शिष्टाचारसमन्वितः।\nवैणवीं धारयेद्यष्टिं सोदकं च कमण्डलुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2101553, "chapter_id": 3189, "verse_number": "१४-४५-२१", "content_sanskrit": "`त्रीणि धारयते नित्यं कमण्डलुमतन्द्रितः।\nएकमाचमनार्थाय एकं वै पादधावनम्।\nएकं शौचविधानार्थमित्येतत्त्रितयं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2101554, "chapter_id": 3189, "verse_number": "१४-४५-२२", "content_sanskrit": "अधीत्याध्यापनं कुर्यात्तथा यजनयाजने।\nदानं प्रतिग्रहं वाऽपि षङ्गुणां वृत्तिमाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2101555, "chapter_id": 3189, "verse_number": "१४-४५-२३", "content_sanskrit": "त्रीणि कर्माणि जानीत ब्राह्मणानां तु जीविकाः।\nयाजनाध्यापने चोभे शुद्धाच्चापि प्रतिग्रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2101556, "chapter_id": 3189, "verse_number": "१४-४५-२४", "content_sanskrit": "अथ शेषाणि चान्यानि त्रीणि कर्माणि यानि तु।\nदानमध्ययनं यज्ञो धर्मयुक्तानि तानि तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2101557, "chapter_id": 3189, "verse_number": "१४-४५-२५", "content_sanskrit": "तेष्वप्रमादं कुर्वीत त्रिषु कर्मसु धर्मवित्।\nदान्तो मैत्रः क्षमायुक्तः सर्वभूतसमो मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2101558, "chapter_id": 3189, "verse_number": "१४-४५-२६", "content_sanskrit": "सर्वमेतद्यथाशक्ति विप्रो निर्वर्तयञ्शुचिः।\nएवं युक्तो जयेत्स्वर्गं गृहस्थः संशितव्रतः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2101559, "chapter_id": 3189, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि पञ्चचत्वारिंशोऽध्यायः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]