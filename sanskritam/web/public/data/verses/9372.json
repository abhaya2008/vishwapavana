[{"id": 5000372000, "chapter_id": 9372, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे त्रयस्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000372001, "chapter_id": 9372, "verse_number": "५-३३-१", "content_sanskrit": "सोऽवतीर्य द्रुमात् तस्माद् विद्रुमप्रतिमाननः।\nविनीतवेषः कृपणः प्रणिपत्योपसृत्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000372002, "chapter_id": 9372, "verse_number": "५-३३-२", "content_sanskrit": "तामब्रवीन्महातेजा हनूमान् मारुतात्मजः।\nशिरस्यञ्जलिमाधाय सीतां मधुरया गिरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000372003, "chapter_id": 9372, "verse_number": "५-३३-३", "content_sanskrit": "का नु पद्मपलाशाक्षि क्लिष्टकौशेयवासिनि।\nद्रुमस्य शाखामालम्ब्य तिष्ठसि त्वमनिन्दिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000372004, "chapter_id": 9372, "verse_number": "५-३३-४", "content_sanskrit": "किमर्थं तव नेत्राभ्यां वारि स्रवति शोकजम्।\nपुण्डरीकपलाशाभ्यां विप्रकीर्णमिवोदकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000372005, "chapter_id": 9372, "verse_number": "५-३३-५", "content_sanskrit": "सुराणामसुराणां च नागगन्धर्वरक्षसाम्।\nयक्षाणां किंनराणां च का त्वं भवसि शोभने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000372006, "chapter_id": 9372, "verse_number": "५-३३-६", "content_sanskrit": "का त्वं भवसि रुद्राणां मरुतां वा वरानने।\nवसूनां वा वरारोहे देवता प्रतिभासि मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000372007, "chapter_id": 9372, "verse_number": "५-३३-७", "content_sanskrit": "किं नु चन्द्रमसा हीना पतिता विबुधालयात्।\nरोहिणी ज्योतिषां श्रेष्ठा श्रेष्ठा सर्वगुणाधिका ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000372008, "chapter_id": 9372, "verse_number": "५-३३-८", "content_sanskrit": "कोपाद् वा यदि वा मोहाद् भर्तारमसितेक्षणे।\nवसिष्ठं कोपयित्वा त्वं वासि कल्याण्यरुन्धती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000372009, "chapter_id": 9372, "verse_number": "५-३३-९", "content_sanskrit": "को नु पुत्रः पिता भ्राता भर्ता वा ते सुमध्यमे।\nअस्माल्लोकादमुं लोकं गतं त्वमनुशोचसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000372010, "chapter_id": 9372, "verse_number": "५-३३-१०", "content_sanskrit": "रोदनादतिनिःश्वासाद् भूमिसंस्पर्शनादपि।\nन त्वां देवीमहं मन्ये राज्ञः संज्ञावधारणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000372011, "chapter_id": 9372, "verse_number": "५-३३-११", "content_sanskrit": "व्यञ्जनानि हि ते यानि लक्षणानि च लक्षये।\nमहिषी भूमिपालस्य राजकन्या च मे मता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000372012, "chapter_id": 9372, "verse_number": "५-३३-१२", "content_sanskrit": "रावणेन जनस्थानाद् बलात् प्रमथिता यदि।\nसीता त्वमसि भद्रं ते तन्ममाचक्ष्व पृच्छतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000372013, "chapter_id": 9372, "verse_number": "५-३३-१३", "content_sanskrit": "यथा हि तव वै दैन्यं रूपं चाप्यतिमानुषम्।\nतपसा चान्वितो वेषस्त्वं राममहिषी ध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000372014, "chapter_id": 9372, "verse_number": "५-३३-१४", "content_sanskrit": "सा तस्य वचनं श्रुत्वा रामकीर्तनहर्षिता।\nउवाच वाक्यं वैदेही हनूमन्तं द्रुमाश्रितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000372015, "chapter_id": 9372, "verse_number": "५-३३-१५", "content_sanskrit": "पृथिव्यां राजसिंहानां मुख्यस्य विदितात्मनः।\nस्नुषा दशरथस्याहं शत्रुसैन्यप्रणाशिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000372016, "chapter_id": 9372, "verse_number": "५-३३-१६", "content_sanskrit": "दुहिता जनकस्याहं वैदेहस्य महात्मनः।\nसीतेति नाम्ना चोक्ताहं भार्या रामस्य धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000372017, "chapter_id": 9372, "verse_number": "५-३३-१७", "content_sanskrit": "समा द्वादश तत्राहं राघवस्य निवेशने।\nभुञ्जाना मानुषान् भोगान् सर्वकामसमृद्धिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000372018, "chapter_id": 9372, "verse_number": "५-३३-१८", "content_sanskrit": "ततस्त्रयोदशे वर्षे राज्ये चेक्ष्वाकुनन्दनम्।\nअभिषेचयितुं राजा सोपाध्यायः प्रचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000372019, "chapter_id": 9372, "verse_number": "५-३३-१९", "content_sanskrit": "तस्मिन् सम्भ्रियमाणे तु राघवस्याभिषेचने।\nकैकेयी नाम भर्तारमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000372020, "chapter_id": 9372, "verse_number": "५-३३-२०", "content_sanskrit": "न पिबेयं न खादेयं प्रत्यहं मम भोजनम्।\nएष मे जीवितस्यान्तो रामो यद्यभिषिच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000372021, "chapter_id": 9372, "verse_number": "५-३३-२१", "content_sanskrit": "यत् तदुक्तं त्वया वाक्यं प्रीत्या नृपतिसत्तम।\nतच्चेन्न वितथं कार्यं वनं गच्छतु राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000372022, "chapter_id": 9372, "verse_number": "५-३३-२२", "content_sanskrit": "स राजा सत्यवाग् देव्या वरदानमनुस्मरन्।\nमुमोह वचनं श्रुत्वा कैकेय्याः क्रूरमप्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000372023, "chapter_id": 9372, "verse_number": "५-३३-२३", "content_sanskrit": "ततस्तं स्थविरो राजा सत्यधर्मे व्यवस्थितः।\nज्येष्ठं यशस्विनं पुत्रं रुदन् राज्यमयाचत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000372024, "chapter_id": 9372, "verse_number": "५-३३-२४", "content_sanskrit": "स पितुर्वचनं श्रीमानभिषेकात् परं प्रियम्।\nमनसा पूर्वमासाद्य वाचा प्रतिगृहीतवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000372025, "chapter_id": 9372, "verse_number": "५-३३-२५", "content_sanskrit": "दद्यान्न प्रतिगृह्णीयात् सत्यं ब्रूयान्न चानृतम्।\nअपि जीवितहेतोर्हि रामः सत्यपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000372026, "chapter_id": 9372, "verse_number": "५-३३-२६", "content_sanskrit": "स विहायोत्तरीयाणि महार्हाणि महायशाः।\nविसृज्य मनसा राज्यं जनन्यै मां समादिशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000372027, "chapter_id": 9372, "verse_number": "५-३३-२७", "content_sanskrit": "साहं तस्याग्रतस्तूर्णं प्रस्थिता वनचारिणी।\nनहि मे तेन हीनाया वासः स्वर्गेऽपि रोचते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000372028, "chapter_id": 9372, "verse_number": "५-३३-२८", "content_sanskrit": "प्रागेव तु महाभागः सौमित्रिर्मित्रनन्दनः।\nपूर्वजस्यानुयात्रार्थे कुशचीरैरलंकृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000372029, "chapter_id": 9372, "verse_number": "५-३३-२९", "content_sanskrit": "ते वयं भर्तुरादेशं बहुमान्य दृढव्रताः।\nप्रविष्टाः स्म पुरादृष्टं वनं गम्भीरदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000372030, "chapter_id": 9372, "verse_number": "५-३३-३०", "content_sanskrit": "वसतो दण्डकारण्ये तस्याहममितौजसः।\nरक्षसापहृता भार्या रावणेन दुरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000372031, "chapter_id": 9372, "verse_number": "५-३३-३१", "content_sanskrit": "द्वौ मासौ तेन मे कालो जीवितानुग्रहः कृतः।\nऊर्ध्वं द्वाभ्यां तु मासाभ्यां ततस्त्यक्ष्यामि जीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000372032, "chapter_id": 9372, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे त्रयस्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]