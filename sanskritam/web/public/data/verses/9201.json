[{"id": 5000201000, "chapter_id": 9201, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे पञ्चमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000201001, "chapter_id": 9201, "verse_number": "३-५-१", "content_sanskrit": "हत्वा तु तं भीमबलं विराधं राक्षसं वने।\nततः सीतां परिष्वज्य समाश्वास्य च वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000201002, "chapter_id": 9201, "verse_number": "३-५-२", "content_sanskrit": "अब्रवीद् भ्रातरं रामो लक्ष्मणं दीप्ततेजसम्।\nकष्टं वनमिदं दुर्गं न च स्मो वनगोचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000201003, "chapter_id": 9201, "verse_number": "३-५-३", "content_sanskrit": "अभिगच्छामहे शीघ्रं शरभङ्गं तपोधनम्।\nआश्रमं शरभङ्गस्य राघवोऽभिजगाम ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000201004, "chapter_id": 9201, "verse_number": "३-५-४", "content_sanskrit": "तस्य देवप्रभावस्य तपसा भावितात्मनः।\nसमीपे शरभङ्गस्य ददर्श महदद्भुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000201005, "chapter_id": 9201, "verse_number": "३-५-५", "content_sanskrit": "विभ्राजमानं वपुषा सूर्यवैश्वानरप्रभम्।\nरथप्रवरमारूढमाकाशे विबुधानुगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000201006, "chapter_id": 9201, "verse_number": "३-५-६", "content_sanskrit": "असंस्पृशन्तं वसुधां ददर्श विबुधेश्वरम्।\nसम्प्रभाभरणं देवं विरजोऽम्बरधारिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000201007, "chapter_id": 9201, "verse_number": "३-५-७", "content_sanskrit": "तद्विधैरेव बहुभिः पूज्यमानं महात्मभिः।\nहरितैर्वाजिभिर्युक्तमन्तरिक्षगतं रथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000201008, "chapter_id": 9201, "verse_number": "३-५-८", "content_sanskrit": "ददर्शादूरतस्तस्य तरुणादित्यसंनिभम्।\nपाण्डुराभ्रघनप्रख्यं चन्द्रमण्डलसंनिभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000201009, "chapter_id": 9201, "verse_number": "३-५-९", "content_sanskrit": "अपश्यद् विमलं छत्रं चित्रमाल्योपशोभितम्।\nचामरव्यजने चाग्र्ये रुक्मदण्डे महाधने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000201010, "chapter_id": 9201, "verse_number": "३-५-१०", "content_sanskrit": "गृहीते वरनारीभ्यां धूयमाने च मूर्धनि।\nगन्धर्वामरसिद्धाश्च बहवः परमर्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000201011, "chapter_id": 9201, "verse_number": "३-५-११", "content_sanskrit": "अन्तरिक्षगतं देवं गीर्भिरग्र्या भिरैडयन्।\nसह सम्भाषमाणे तु शरभङ्गेन वासवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000201012, "chapter_id": 9201, "verse_number": "३-५-१२", "content_sanskrit": "दृष्ट्वा शतक्रतुं तत्र रामो लक्ष्मणमब्रवीत्।\nरामोऽथ रथमुद्दिश्य भ्रातुर्दर्शयताद्भुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000201013, "chapter_id": 9201, "verse_number": "३-५-१३", "content_sanskrit": "अर्चिष्मन्तं श्रिया जुष्टमद्भुतं पश्य लक्ष्मण।\nप्रतपन्तमिवादित्यमन्तरिक्षगतं रथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000201014, "chapter_id": 9201, "verse_number": "३-५-१४", "content_sanskrit": "ये हयाः पुरुहूतस्य पुरा शक्रस्य नः श्रुताः।\nअन्तरिक्षगता दिव्यास्त इमे हरयो ध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000201015, "chapter_id": 9201, "verse_number": "३-५-१५", "content_sanskrit": "इमे च पुरुषव्याघ्र ये तिष्ठन्त्यभितो दिशम्।\nशतं शतं कुण्डलिनो युवानः खड्गपाणयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000201016, "chapter_id": 9201, "verse_number": "३-५-१६", "content_sanskrit": "विस्तीर्णविपुलोरस्काः परिघायतबाहवः।\nशोणांशुवसनाः सर्वे व्याघ्रा इव दुरासदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000201017, "chapter_id": 9201, "verse_number": "३-५-१७", "content_sanskrit": "उरोदेशेषु सर्वेषां हारा ज्वलनसंनिभाः।\nरूपं बिभ्रति सौमित्रे पञ्चविंशतिवार्षिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000201018, "chapter_id": 9201, "verse_number": "३-५-१८", "content_sanskrit": "एतद्धि किल देवानां वयो भवति नित्यदा।\nयथेमे पुरुषव्याघ्रा दृश्यन्ते प्रियदर्शनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000201019, "chapter_id": 9201, "verse_number": "३-५-१९", "content_sanskrit": "इहैव सह वैदेह्या मुहूर्तं तिष्ठ लक्ष्मण।\nयावज्जानाम्यहं व्यक्तं क एष द्युतिमान् रथे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000201020, "chapter_id": 9201, "verse_number": "३-५-२०", "content_sanskrit": "तमेवमुक्त्वा सौमित्रिमिहैव स्थीयतामिति।\nअभिचक्राम काकुत्स्थः शरभङ्गाश्रमं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000201021, "chapter_id": 9201, "verse_number": "३-५-२१", "content_sanskrit": "ततः समभिगच्छन्तं प्रेक्ष्य रामं शचीपतिः।\nशरभङ्गमनुज्ञाप्य विबुधानिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000201022, "chapter_id": 9201, "verse_number": "३-५-२२", "content_sanskrit": "इहोपयात्यसौ रामो यावन्मां नाभिभाषते।\nनिष्ठां नयत तावत् तु ततो माद्रष्टुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000201023, "chapter_id": 9201, "verse_number": "३-५-२३", "content_sanskrit": "जितवन्तं कृतार्थं हि तदाहमचिरादिमम्।\nकर्म ह्यनेन कर्तव्यं महदन्यैः सुदुष्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000201024, "chapter_id": 9201, "verse_number": "३-५-२४", "content_sanskrit": "अथ वज्री तमामन्त्र्य मानयित्वा च तापसम्।\nरथेन हययुक्तेन ययौ दिवमरिंदमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000201025, "chapter_id": 9201, "verse_number": "३-५-२५", "content_sanskrit": "प्रयाते तु सहस्राक्षे राघवः सपरिच्छदः।\nअग्निहोत्रमुपासीनं शरभङ्गमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000201026, "chapter_id": 9201, "verse_number": "३-५-२६", "content_sanskrit": "तस्य पादौ च संगृह्य रामः सीता च लक्ष्मणः।\nनिषेदुस्तदनुज्ञाता लब्धवासा निमन्त्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000201027, "chapter_id": 9201, "verse_number": "३-५-२७", "content_sanskrit": "ततः शक्रोपयानं तु पर्यपृच्छत राघवः।\nशरभङ्गश्च तत् सर्वं राघवाय न्यवेदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000201028, "chapter_id": 9201, "verse_number": "३-५-२८", "content_sanskrit": "मामेष वरदो राम ब्रह्मलोकं निनीषति।\nजितमुग्रेण तपसा दुष्प्रापमकृतात्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000201029, "chapter_id": 9201, "verse_number": "३-५-२९", "content_sanskrit": "अहं ज्ञात्वा नरव्याघ्र वर्तमानमदूरतः।\nब्रह्मलोकं न गच्छामि त्वामदृष्ट्वा प्रियातिथिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000201030, "chapter_id": 9201, "verse_number": "३-५-३०", "content_sanskrit": "त्वयाहं पुरुषव्याघ्र धार्मिकेण महात्मना।\nसमागम्य गमिष्यामि त्रिदिवं चावरं परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000201031, "chapter_id": 9201, "verse_number": "३-५-३१", "content_sanskrit": "अक्षया नरशार्दूल जिता लोका मया शुभाः।\nब्राह्म्याश्च नाकपृष्ठ्याश्च प्रतिगृह्णीष्व मामकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000201032, "chapter_id": 9201, "verse_number": "३-५-३२", "content_sanskrit": "एवमुक्तो नरव्याघ्रः सर्वशास्त्रविशारदः।\nऋषिणा शरभङ्गेन राघवो वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000201033, "chapter_id": 9201, "verse_number": "३-५-३३", "content_sanskrit": "अहमेवाहरिष्यामि सर्वाल्ँ लोकान् महामुने।\nआवासं त्वहमिच्छामि प्रदिष्टमिह कानने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000201034, "chapter_id": 9201, "verse_number": "३-५-३४", "content_sanskrit": "राघवेणैवमुक्तस्तु शक्रतुल्यबलेन वै।\nशरभङ्गो महाप्राज्ञः पुनरेवाब्रवीद् वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000201035, "chapter_id": 9201, "verse_number": "३-५-३५", "content_sanskrit": "इह राम महातेजाः सुतीक्ष्णो नाम धार्मिकः।\nवसत्यरण्ये नियतः स ते श्रेयो विधास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000201036, "chapter_id": 9201, "verse_number": "३-५-३६", "content_sanskrit": "सुतीक्ष्णमभिगच्छ त्वं शुचौ देशे तपस्विनम्।\nरमणीये वनोद्देशे स ते वासं विधास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000201037, "chapter_id": 9201, "verse_number": "३-५-३७", "content_sanskrit": "इमां मन्दाकिनीं राम प्रतिस्रोतामनुव्रज।\nनदीं पुष्पोडुपवहां ततस्तत्र गमिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000201038, "chapter_id": 9201, "verse_number": "३-५-३८", "content_sanskrit": "एष पन्था नरव्याघ्र मुहूर्तं पश्य तात माम्।\nयावज्जहामि गात्राणि जीर्णां त्वचमिवोरगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000201039, "chapter_id": 9201, "verse_number": "३-५-३९", "content_sanskrit": "ततोऽग्निं स समाधाय हुत्वा चाज्येन मन्त्रवत् ।\nशरभङ्गो महातेजाः प्रविवेश हुताशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000201040, "chapter_id": 9201, "verse_number": "३-५-४०", "content_sanskrit": "तस्य रोमाणि केशांश्च तदा वह्निर्महात्मनः।\nजीर्णां त्वचं तदस्थीनि यच्च मांसं च शोणितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000201041, "chapter_id": 9201, "verse_number": "३-५-४१", "content_sanskrit": "स च पावकसंकाशः कुमारः समपद्यत।\nउत्थायाग्निचयात् तस्माच्छरभङ्गो व्यरोचत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000201042, "chapter_id": 9201, "verse_number": "३-५-४२", "content_sanskrit": "स लोकानाहिताग्नीनामृषीणां च महात्मनाम्।\nदेवानां च व्यतिक्रम्य ब्रह्मलोकं व्यरोहत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000201043, "chapter_id": 9201, "verse_number": "३-५-४३", "content_sanskrit": "स पुण्यकर्मा भुवने द्विजर्षभः\nपितामहं सानुचरं ददर्श ह।\nपितामहश्चापि समीक्ष्य तं द्विजं\nननन्द सुस्वागतमित्युवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000201044, "chapter_id": 9201, "verse_number": null, "content_sanskrit": "इति वाल्मीकि रामायणे आदि काव्ये अरण्यकाण्डे पञ्चमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]