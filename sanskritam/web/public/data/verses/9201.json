[{"id": 40014551, "chapter_id": 9201, "verse_number": "1", "content_sanskrit": "रावणंक्रुद्धमाज्ञायमहापार्श्वोमहाबलः । मुहूर्तमनुसञ्चिन्त्यप्राञ्जलिर्वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40014552, "chapter_id": 9201, "verse_number": "2", "content_sanskrit": "यःखल्वपिवनंप्राप्यमृगव्यालनिषेवितम् । नपिबेन्मधुसम्प्राप्यसनरोबालिशोभवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40014553, "chapter_id": 9201, "verse_number": "3", "content_sanskrit": "ईश्वरस्येश्वरःकोऽस्तितवशत्रुनिबर्हण: । रमस्वसहवैदेह्याशत्रूनाक्रम्यमूर्धसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40014554, "chapter_id": 9201, "verse_number": "4", "content_sanskrit": "बलात्कुक्कुटवृत्तेनप्रवर्तस्वमहाबल: । आक्रम्याक्रम्यसीतांवैतांभुङ् क्ष्वचरमस्वच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40014555, "chapter_id": 9201, "verse_number": "5", "content_sanskrit": "लब्धकामस्यतेपश्चादागमिष्यतियद्भयम् । प्राप्तमप्राप्तकालंवासर्वंप्रतिसहिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40014556, "chapter_id": 9201, "verse_number": "6", "content_sanskrit": "कुम्भकर्णस्सहास्माभिरिन्द्रजिच्चमहाबलः । प्रतिषेधयितुंशक्तौसवज्रमपिवज्रिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40014557, "chapter_id": 9201, "verse_number": "7", "content_sanskrit": "उपप्रदानंसान्त्वंवाभेदंवाकुशलैःकृतम् । समतिक्रम्यदण्डेनसिद्धिमर्थेषुरोचये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40014558, "chapter_id": 9201, "verse_number": "8", "content_sanskrit": "इहप्राप्तान्वयंसर्वान् शत्रूंस्तवमहाबल: । वशेशस्त्रप्रतापेनकरिष्यामोनसंशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40014559, "chapter_id": 9201, "verse_number": "9", "content_sanskrit": "एवमुक्तस्तदाराजामहापार्श्वेनरावणः । तस्यसम्पूजयन्वाक्यमिदंवचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40014560, "chapter_id": 9201, "verse_number": "10", "content_sanskrit": "महापार्श्वनिबोधत्वंरहस्यंकिञ्चिदात्मन: । चिरवृत्तंतदाख्यास्येयदवाप्तंपुरामया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40014561, "chapter_id": 9201, "verse_number": "11", "content_sanskrit": "पितामहस्यभवनंगच्छन्तींपुञ्जिकस्थलाम् । चञ्चूर्यमाणामद्राक्षमाकाशेऽग्निशिखामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40014562, "chapter_id": 9201, "verse_number": "12", "content_sanskrit": "साप्रसह्यमयाभुक्ताकृताविवसनाततः । स्वयम्भूभवनंप्राप्तालोलितानलिनीयथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40014563, "chapter_id": 9201, "verse_number": "13", "content_sanskrit": "तच्चतस्यतदामन्येज्ञातमासीन्महात्मनः । अथसङ्कुपितोदेवोमामिदंवाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40014564, "chapter_id": 9201, "verse_number": "14", "content_sanskrit": "अद्यप्रभृतियामन्याबलान्नारींगमिष्यसि । तदातेशतधामूर्धाफलिष्यतिनसंशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40014565, "chapter_id": 9201, "verse_number": "15", "content_sanskrit": "इत्यहंतस्यशापस्यभीतःप्रसभमेवताम् । नारोहयेबलात्सीतांवैदेहींशयनेशुभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40014566, "chapter_id": 9201, "verse_number": "16", "content_sanskrit": "सागरस्येनमेवेगोमारुतस्येवमेगतिः । नैतद्दाशरथिर्वेदह्यासादयतितेनमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40014567, "chapter_id": 9201, "verse_number": "17", "content_sanskrit": "कोहिसिंहमिवासीनंसुप्तंगिरिगुहाशये । क्रुद्धंमृत्युमिवाऽसीनंसम्भोधयितुमिच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40014568, "chapter_id": 9201, "verse_number": "18", "content_sanskrit": "नमत्तोनिशितान्बाणान्द्विजिह्वान्पन्नगानिव । रामःपश्यतिसङ्ग्रामेतेनमामभिगच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40014569, "chapter_id": 9201, "verse_number": "19", "content_sanskrit": "क्षिप्रंवज्रसमैर्बाणैश्शतथाकार्मुकच्युतैः । राममादीपयिष्यामिउल्काभिरिवकुञ्जरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40014570, "chapter_id": 9201, "verse_number": "20", "content_sanskrit": "तच्चास्यबलमादास्येबलेनमहतावृतः । उदितस्सविताकालेनक्षत्राणामिवप्रभाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40014571, "chapter_id": 9201, "verse_number": "21", "content_sanskrit": "नवासनेनापिसहस्रचक्षुषायुधाऽस्मिशक्योवरुणेनवापुनः । मयात्वियंबाहुबलेननिर्जितापुरापुरीवैश्रवणेनपालिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]