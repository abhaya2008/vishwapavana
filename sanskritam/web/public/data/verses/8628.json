[{"id": 900008346, "chapter_id": 8628, "verse_number": "9.1", "content_sanskrit": "अत्राधिभूतगताकाशादिनाम्नां समन्वय उच्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008347, "chapter_id": 8628, "verse_number": "9.2", "content_sanskrit": "यद्यपि ‘‘अत एव प्राण’..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008348, "chapter_id": 8628, "verse_number": "9.3", "content_sanskrit": "ननु यद्येवमानन्दमयाधिकरणाक्षेपस्तर्हि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008349, "chapter_id": 8628, "verse_number": "9.4", "content_sanskrit": "केचित्तु अचेतनस्यैव पूर्वपक्षिणाऽऽकाशत्वेन ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900008350, "chapter_id": 8628, "verse_number": "9.5", "content_sanskrit": "अत्राकाशः किं भूताकाशः किं वा ब्रह्मेति चिन्ता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900008351, "chapter_id": 8628, "verse_number": "9.6", "content_sanskrit": "तत्राकाशशब्दप्रवृत्तिनिमित्तस्य..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900008352, "chapter_id": 8628, "verse_number": "9.7", "content_sanskrit": "यद्वा विवरत्वादिकं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900008353, "chapter_id": 8628, "verse_number": "9.8", "content_sanskrit": "यद्वा ‘‘स्वातन्त्र्यं तद्गतत्वं च शब्दवृत्तेर्हि कारणम्’’..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900008354, "chapter_id": 8628, "verse_number": "9.9", "content_sanskrit": "प्रमाणाश्रिता वाक्यस्य ब्रह्मपरत्वविरोधिनी..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900008355, "chapter_id": 8628, "verse_number": "9.10", "content_sanskrit": "आकाशशब्दस्य तु क्वापि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900008356, "chapter_id": 8628, "verse_number": "9.11", "content_sanskrit": "ननु च भूतप्रकरणाद्भूतकारणत्वलिङ्गाच्च भाष्ये..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900008357, "chapter_id": 8628, "verse_number": "9.12", "content_sanskrit": "आकाशोऽर्थान्तरत्वादित्यत्र..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900008358, "chapter_id": 8628, "verse_number": "9.13", "content_sanskrit": "एवं च यथा नवमोक्तरीत्या..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900008359, "chapter_id": 8628, "verse_number": "9.14", "content_sanskrit": "अनन्तत्वादिलिङ्गानि तु निरवकाशानि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900008360, "chapter_id": 8628, "verse_number": "9.15", "content_sanskrit": "अत्रोभयेऽप्याहुः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900008361, "chapter_id": 8628, "verse_number": "9.16", "content_sanskrit": "यच्चोक्तं ‘‘त्यजेदेकं कुलस्यार्थे’’ इति तन्न", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]