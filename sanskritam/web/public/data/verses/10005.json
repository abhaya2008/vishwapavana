[{"id": 6000005000, "chapter_id": 10005, "verse_number": null, "content_sanskrit": "अथ पञ्चमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000005001, "chapter_id": 10005, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.001.m4a", "display_order": 2}, {"id": 6000005002, "chapter_id": 10005, "verse_number": "१-५-१", "content_sanskrit": "अथ तं सुखमासीन उपासीनं बृहच्छ्रवाः।\nदेवर्षिः प्राह विप्रर्षिं वीणापाणिः स्मयन्निव॥ १/५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.002.m4a", "display_order": 3, "topics": [{"text": "श्रीव्यासेन स्वस्यापरितोषकारणं पृष्‍टेन नारदेन व्यासं प्रति प्राधान्येन भगवच्चरित्रप्रतिपादकप्रबन्ध- प्रणयननिवेदनम्", "range": "१–२२"}]}, {"id": 6000005003, "chapter_id": 10005, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.003.m4a", "display_order": 4}, {"id": 6000005004, "chapter_id": 10005, "verse_number": "१-५-२", "content_sanskrit": "पाराशर्य महाभाग भवतः कच्चिदात्मना।\nपरितुष्यति शारीर आत्मा मानस एव वा॥ १/५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.004.m4a", "display_order": 5}, {"id": 6000005005, "chapter_id": 10005, "verse_number": "१-५-३", "content_sanskrit": "जिज्ञासितं सुसंपन्नमपि ते महदद्भुतम्।\nकृतवान्भारतं यस्त्वं सर्वार्थपरिबृंहितम्॥ १/५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.005.m4a", "display_order": 6}, {"id": 6000005006, "chapter_id": 10005, "verse_number": "१-५-४", "content_sanskrit": "जिज्ञासितमधीतञ्च ब्रह्म यत्तत्सनातनम्।\nतथापि शोचस्यात्मानमकृतार्थ इव प्रभो॥ १/५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.006.m4a", "display_order": 7}, {"id": 6000005007, "chapter_id": 10005, "verse_number": null, "content_sanskrit": "व्यास उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.007.m4a", "display_order": 8}, {"id": 6000005008, "chapter_id": 10005, "verse_number": "१-५-५", "content_sanskrit": "अस्त्येव मे सर्वमिदं त्वयोक्‍तं तथापि नात्मा परितुष्यते मे।\nतन्मूलमव्यक्‍तमगाधबोधं पृच्छामहे त्वाऽऽत्मभवात्मभूतम्॥ १/५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.008.m4a", "display_order": 9}, {"id": 6000005009, "chapter_id": 10005, "verse_number": "१-५-६", "content_sanskrit": "स वै भवान् वेदसमस्तगुह्यमुपासितो यः पुरुषः पुराणः।\nपरावरेशो मनसैव विश्‍वं सृजत्यवत्यत्ति गुणैरसङ्गः॥ १/५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.009.m4a", "display_order": 10}, {"id": 6000005010, "chapter_id": 10005, "verse_number": "१-५-७", "content_sanskrit": "त्वं पर्यटन्नर्क इव त्रिलोकीमन्तश्‍चरो वायुरिवात्मसाक्षी।\nपरावरे ब्रह्मणि धर्मतो व्रतैस्स्नातस्य मे न्यूनमलं विचक्ष्व॥ १/५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.010.m4a", "display_order": 11}, {"id": 6000005011, "chapter_id": 10005, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.011.m4a", "display_order": 12}, {"id": 6000005012, "chapter_id": 10005, "verse_number": "१-५-८", "content_sanskrit": "भवताऽनुदितप्रायं यशो भगवतोऽमलम्।\nयेनैवासौ न तुष्येत मन्ये तद्दर्शनं खिलम्॥ १/५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.012.m4a", "display_order": 13}, {"id": 6000005013, "chapter_id": 10005, "verse_number": "१-५-९", "content_sanskrit": "यथा धर्मादयो ह्यर्था मुनिवर्यानुवर्णिताः।\nन तथा वासुदेवस्य महिमा ह्यनुवर्णितः॥ १/५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.013.m4a", "display_order": 14}, {"id": 6000005014, "chapter_id": 10005, "verse_number": "१-५-१०", "content_sanskrit": "न यद्वचश्‍चित्रपदं हरेर्यशो जगत्पवित्रं न गृणीत कर्हिचित्।\nतद्वायसं तीर्थमुशन्ति मानसा न यत्र हंसा न्यपतन्मिमङ्क्षया॥ १/५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.014.m4a", "display_order": 15}, {"id": 6000005015, "chapter_id": 10005, "verse_number": "१-५-११", "content_sanskrit": "स वाग्विसर्गो जनताघविप्लवो यस्मिन् प्रतिश्लोकमबद्धवत्यपि।\nनामान्यनन्तस्य यशोङ्कितानि शृण्वन्ति गायन्ति गृणन्ति साधवः॥ १/५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.015.m4a", "display_order": 16}, {"id": 6000005016, "chapter_id": 10005, "verse_number": "१-५-१२", "content_sanskrit": "नैष्कर्म्यमप्यच्युतभाववर्जितं न शोभते ज्ञानमलं निरञ्जनम्।\nकुतः पुनः शश्‍वदभद्रमीश्‍वरे न चार्पितं कर्म यदप्यकारणम्॥ १/५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.016.m4a", "display_order": 17}, {"id": 6000005017, "chapter_id": 10005, "verse_number": "१-५-१३", "content_sanskrit": "अतो महाभाग भवानमोघदृक् शुचिश्रवाः सत्यरतो धृतवतः।\nउरुक्रमस्याखिलबन्धमुक्‍तये समाधिनाऽनुस्मर यद्विचेष्‍टितम्॥ १/५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.017.m4a", "display_order": 18}, {"id": 6000005018, "chapter_id": 10005, "verse_number": "१-५-१४", "content_sanskrit": "अतोऽन्यथा किञ्चन यद्विवक्षितं पृथग्दृशस्तत्कृतरूपनामभिः।\nन कर्हिचित् क्‍वापि च दुःस्थिता मतिर्लभेत वाताहतनौरिवास्पदम्॥ १/५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.018.m4a", "display_order": 19}, {"id": 6000005019, "chapter_id": 10005, "verse_number": "१-५-१५", "content_sanskrit": "जुगुप्सितं धर्मकृतेऽनुशासनं स्वभावरक्‍तस्य महान् व्यतिक्रमः।\nयद्वाक्यतो धर्म इतीतरस्थितो न मन्यते तस्य निवारणं जनः॥ १/५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.019.m4a", "display_order": 20}, {"id": 6000005020, "chapter_id": 10005, "verse_number": "१-५-१६", "content_sanskrit": "विचक्षणोऽस्यार्हति वेदितुं विभोरनन्तपारस्य निवृत्तितः सुखम्।\nप्रवर्तमानस्य गुणैरनात्मनस्ततो भवान्दर्शय चेष्‍टितं विभोः॥ १/५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.020.m4a", "display_order": 21}, {"id": 6000005021, "chapter_id": 10005, "verse_number": "१-५-१७", "content_sanskrit": "त्यक्‍त्वा स्वधर्मं चरणाम्बुजं हरेर्भजन्नपक्‍वोऽथ पतेत्ततो यदि।\nयत्र क्‍व वा भद्रमभूदमुष्य को वाऽर्थ आप्‍तो भजतां स्वधर्मम्॥ १/५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.021.m4a", "display_order": 22}, {"id": 6000005022, "chapter_id": 10005, "verse_number": "१-५-१८", "content_sanskrit": "तस्यैव हेतोः प्रयतेत कोविदो न लभ्यते यद्भ्रमतामुपर्यधः।\nतल्‍लभ्यते दुःखवदन्यतः सुखं कालेन सर्वत्र गभीररंहसा॥ १/५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.022.m4a", "display_order": 23}, {"id": 6000005023, "chapter_id": 10005, "verse_number": "१-५-१९", "content_sanskrit": "न वै जनो जातु कथञ्चन व्रजेन्मुकुन्दसेव्यन्यवदङ्ग संसृतिम्।\nस्मरन्मुकुन्दाङ्घ्र्युपगूहनं पुनर्विहातुमिच्छेन्न रसग्रही जनः॥ १/५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.023.m4a", "display_order": 24}, {"id": 6000005024, "chapter_id": 10005, "verse_number": "१-५-२०", "content_sanskrit": "इदं हि विश्‍वं भगवानिवेतरो यतो जगत्स्थाननिरोधसंभवः।\nतद्धि स्वयं वेद भवांस्तथाऽपि प्रादेशमात्रं भवतः प्रदर्शितम्॥ १/५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.024.m4a", "display_order": 25}, {"id": 6000005025, "chapter_id": 10005, "verse_number": "१-५-२१", "content_sanskrit": "त्वमात्मनाऽऽत्मानमवैह्यमोघदृक् परस्य पुंसः परमात्मनः कलाम्।\nअजं प्रजातं जगतः शिवाय तन्महानुभावाभ्युदयोऽपि गण्यताम्॥ १/५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.025.m4a", "display_order": 26}, {"id": 6000005026, "chapter_id": 10005, "verse_number": "१-५-२२", "content_sanskrit": "इदं हि पुंसस्तपसः श्रुतस्य वा स्विष्‍टस्य सूक्‍तस्य च बुद्धदत्तयोः।\nअविप्लुतोऽर्थः कविभिर्निरूपितो यदुत्तमश्लोकगुणानुवर्णनम्॥ १/५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.026.m4a", "display_order": 27}, {"id": 6000005027, "chapter_id": 10005, "verse_number": "१-५-२३", "content_sanskrit": "अहं पुराऽतीतभवेऽभवं मुने दास्यास्तु कस्याश्‍चन वेदवादिनाम्।\nनिरूपितो बालक एव योगिनां शुश्रूषणे प्रावृषि निर्विवक्षताम्॥ १/५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.027.m4a", "display_order": 28, "topics": [{"text": "तथा भगवत्कथाश्रवणादेः परमपुमर्थहेतुत्वे स्वस्यैव साक्षीकरणाय स्वपूर्वजन्मवृत्तान्तकथनम्", "range": "२३"}]}, {"id": 6000005028, "chapter_id": 10005, "verse_number": "१-५-२४", "content_sanskrit": "ते मय्यपेताखिलचापलेऽर्भके दान्ते यतक्रीडनकेऽनुवर्तिनि।\nचक्रुः कृपां यद्यपि तुल्यदर्शनाः शुश्रूषमाणे मुनयोऽल्पधारिणि॥ १/५/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.028.m4a", "display_order": 29, "topics": [{"text": "पूर्वजन्मनि दासीसूनुना नारदेन बाल्ये योगिनां शुश्रूषणम्", "range": "२४–२८"}]}, {"id": 6000005029, "chapter_id": 10005, "verse_number": "१-५-२५", "content_sanskrit": "उच्छिष्‍टलेपाननुमोदितौ द्विजैः सकृच्च भुञ्जे तदपास्तकिल्बिषः।\nएवं प्रवृत्तस्य विशुद्धचेतसस्तद्धर्म एवाभिरुचिः प्रजायते॥ १/५/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.029.m4a", "display_order": 30}, {"id": 6000005030, "chapter_id": 10005, "verse_number": "१-५-२६", "content_sanskrit": "तत्रान्वहं कृष्णकथाः प्रगायतामनुग्रहेणाशृणवं मनोहराः।\nताः श्रद्धया मेऽनुसवं विशृण्वतः प्रियश्रवस्याङ्ग तदाऽभवन्मतिः॥ १/५/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.030.m4a", "display_order": 31}, {"id": 6000005031, "chapter_id": 10005, "verse_number": "१-५-२७", "content_sanskrit": "तस्मिंस्तदा लब्धरुचेर्महामते प्रियश्रवस्यस्खलिता मतिर्मम।\nययाहमेतत्सदसत्स्वमायया पश्ये मयि ब्रह्मणि कल्पितं परे॥ १/५/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.031.m4a", "display_order": 32}, {"id": 6000005032, "chapter_id": 10005, "verse_number": "१-५-२८", "content_sanskrit": "इत्थं शरत्प्रावृषिकावृतू हरेर्विशृण्वतो मेऽनुसवं यशोऽमलम्।\nसङ्कीर्त्यमानं मुनिभिर्महात्मभिर्भक्‍तिः प्रवृत्ताऽऽत्मरजस्तमोपहा॥ १/५/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.032.m4a", "display_order": 33}, {"id": 6000005033, "chapter_id": 10005, "verse_number": "१-५-२९", "content_sanskrit": "तस्यैवं मेऽनुरक्‍तस्य प्रश्रितस्य हतैनसः।\nश्रद्धधानस्य बालस्य दान्तस्यानुचरस्य च॥ १/५/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.033.m4a", "display_order": 34, "topics": [{"text": "तत्र तदुदीरितहरिकथाश्रवणसमुपजातहरिभक्तेः बालस्य शुश्रूषासंतुष्‍टैर्योगिभिस्तस्मै ज्ञानोपदेशः", "range": "२९–४०"}]}, {"id": 6000005034, "chapter_id": 10005, "verse_number": "१-५-३०", "content_sanskrit": "ज्ञानं गुह्यतमं यत्तत्साक्षाद्भगवतोदितम्।\nअन्ववोचन् गमिष्यन्तः कृपया दीनवत्सलाः॥ १/५/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.034.m4a", "display_order": 35}, {"id": 6000005035, "chapter_id": 10005, "verse_number": "१-५-३१", "content_sanskrit": "येनैवाहं भगवतो वासुदेवस्य वेधसः।\nमायानुभावमविदं तेन गच्छन्ति तत्पदम्॥ १/५/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.035.m4a", "display_order": 36}, {"id": 6000005036, "chapter_id": 10005, "verse_number": "१-५-३२", "content_sanskrit": "एतत्संसूचितं ब्रह्मन् तापत्रयचिकित्सितम्।\nयदीश्‍वरे भगवति कर्म ब्रह्मणि भावितम्॥ १/५/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.036.m4a", "display_order": 37}, {"id": 6000005037, "chapter_id": 10005, "verse_number": "१-५-३३", "content_sanskrit": "आमयोऽयं च भूतानां जायते येन सुव्रत।\nतदेव ह्यामयद्रव्यं तत्पुनाति चिकित्सितम्॥ १/५/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.037.m4a", "display_order": 38}, {"id": 6000005038, "chapter_id": 10005, "verse_number": "१-५-३४", "content_sanskrit": "एवं नृणां क्रियायोगाः सर्वे संसृतिहेतवः।\nत एवात्मविनाशाय कल्पन्ते कल्पिताः परे॥ १/५/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.038.m4a", "display_order": 39}, {"id": 6000005039, "chapter_id": 10005, "verse_number": "१-५-३५", "content_sanskrit": "यदत्र क्रियते कर्म भगवत्परितोषणम्।\nज्ञानं यत्तदधीनं हि भक्‍तियोगसमन्वितम्॥ १/५/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.039.m4a", "display_order": 40}, {"id": 6000005040, "chapter_id": 10005, "verse_number": "१-५-३६", "content_sanskrit": "कुर्वाणा यत्र कर्माणि भगवच्छिक्षयाऽसकृत्।\nगृणन्ति गुणनामानि कृष्णस्यानुस्मरन्ति च॥ १/५/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.040.m4a", "display_order": 41}, {"id": 6000005041, "chapter_id": 10005, "verse_number": "१-५-३७", "content_sanskrit": "ओं नमो भगवते तुभ्यं वासुदेवाय धीमहि।\nप्रद्युम्नायानिरुद्धाय नमः संकर्षणाय च॥ १/५/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.041.m4a", "display_order": 42}, {"id": 6000005042, "chapter_id": 10005, "verse_number": "१-५-३८", "content_sanskrit": "इति मूर्त्यभिधानेन मन्त्रमूर्तिममूर्तिकम्।\nयजते यज्ञपुरुषं स सम्यग्दर्शनः पुमान्॥ १/५/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.042.m4a", "display_order": 43}, {"id": 6000005043, "chapter_id": 10005, "verse_number": "१-५-३९", "content_sanskrit": "इमं स्वधर्मनियममवेत्य मदनुष्‍ठितम्।\nअदान्मे ज्ञानमैश्‍वर्यं स्वस्मिन् भावं च केशवः॥ १/५/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.043.m4a", "display_order": 44}, {"id": 6000005044, "chapter_id": 10005, "verse_number": "१-५-४०", "content_sanskrit": "त्वमप्यदभ्रश्रुत विश्रुतं विभोः समाप्यते येन विदां बुभुत्सितम्।\nप्रख्याहि दुःखैर्मुहुरर्दितात्मनां संक्‍लेशनिर्वाणमुशन्ति नान्यथा॥ १/५/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_005/BhP_01.005.044.m4a", "display_order": 45}, {"id": 6000005045, "chapter_id": 10005, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां प्रथमस्कन्धे पञ्चमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]