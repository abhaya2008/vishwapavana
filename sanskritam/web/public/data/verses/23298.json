[{"id": 7003298000, "chapter_id": 23298, "verse_number": "१-१०१-१", "content_sanskrit": "ऋषय ऊचुः  ।\nकथं हिमवतः पुत्री बभूवांबा सती शुभा  ।\nकथं वा देवदेवेशमवाप पतिमीश्वरम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003298001, "chapter_id": 23298, "verse_number": "१-१०१-२", "content_sanskrit": "सूत उवाच  ।\nसा मेनानुमाश्रित्य स्वेच्छयैव वरांगना  ।\nतदा हैमवती जज्ञे तपसा च द्विजोत्तमाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003298002, "chapter_id": 23298, "verse_number": "१-१०१-३", "content_sanskrit": "जातकर्मादिकाः सर्वाश्चकार च गिरिश्वरः  ।\nद्वादशे च तदा वर्षे पूर्णे हैमवती शुभा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003298003, "chapter_id": 23298, "verse_number": "१-१०१-४", "content_sanskrit": "तपस्तेपे तया सार्धमनुजा च शुभानना  ।\nअन्या च देवी ह्यनुजा सर्वलोके नमस्कृता ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003298004, "chapter_id": 23298, "verse_number": "१-१०१-५", "content_sanskrit": "ऋषयश्च तदा सर्वे सर्वलोकमहेश्वरीम्  ।\nतुष्टुस्तपसा देवीं समावृत्य समंततः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003298005, "chapter_id": 23298, "verse_number": "१-१०१-६", "content_sanskrit": "ज्येष्ठा ह्यपर्णा ह्यनुजा चैकपर्णा शभानना  ।\nतृतीया च वारारोहा तथा चैवैकपाटला ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003298006, "chapter_id": 23298, "verse_number": "१-१०१-७", "content_sanskrit": "तपसा च महादेव्याः पर्वात्याः परमेश्वरः  ।\nवशीकृतो महादेवः सर्वभूतपतिर्भवः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003298007, "chapter_id": 23298, "verse_number": "१-१०१-८", "content_sanskrit": "एतस्मिन्नेव काले तु तारको नाम दानवः  ।\nतारात्मजो महातेजा बभूव दितिनंदनः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003298008, "chapter_id": 23298, "verse_number": "१-१०१-९", "content_sanskrit": "तस्य पुत्रास्त्रयश्चापि तारकाक्षो महासुरः  ।\nविद्युन्माली च भगवान् कमलाक्षश्च वीर्यवान् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003298009, "chapter_id": 23298, "verse_number": "१-१०१-१०", "content_sanskrit": "पितामहस्तथा चैषां तारो नाम महाबलः  ।\nतपसा लब्धवीर्यश्च प्रसादाद्ब्रह्मणः प्रभोः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003298010, "chapter_id": 23298, "verse_number": "१-१०१-११", "content_sanskrit": "सोपि तारो महातेजास्त्रैलोक्यं सचराचरम्  ।\nविजित्य समरे पूर्वं विष्णुं च जितवानसौ ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003298011, "chapter_id": 23298, "verse_number": "१-१०१-१२", "content_sanskrit": "तयोः समभवद्युद्धं सुघोरं रोमहर्षणम्  ।\nदिव्यं वर्षसहस्रं तु दिवारात्रमविश्रमम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003298012, "chapter_id": 23298, "verse_number": "१-१०१-१३", "content_sanskrit": "सरथं विष्णुमादाय चिक्षेप शतयोजनम्  ।\nतारेण विजितः संख्ये दुद्राव गरुडध्वजः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003298013, "chapter_id": 23298, "verse_number": "१-१०१-१४", "content_sanskrit": "तारो वराञ्छतगुणं लब्ध्वा शतगुणं बलम्  ।\nपितामहाज्जगत्सर्वमवाप दितिनंदनः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003298014, "chapter_id": 23298, "verse_number": "१-१०१-१५", "content_sanskrit": "देवेंद्रप्रमुखाञ्जित्वा देवान्देवेश्वरेश्वरः  ।\nवारयामास तैर्देवान्सर्वलोकेषु मायया ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003298015, "chapter_id": 23298, "verse_number": "१-१०१-१६", "content_sanskrit": "देवताश्च सहेंद्रेण तारकाद्भयपीडिताः  ।\nन शांतिं लेभिरे शूराः शरणं वा भयार्दिताः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003298016, "chapter_id": 23298, "verse_number": "१-१०१-१७", "content_sanskrit": "तदामरपतिः श्रीमान् सन्निपत्यमरप्रभुः  ।\nउवाचांगिरसं देवो देवानामपि सन्निधौ ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003298017, "chapter_id": 23298, "verse_number": "१-१०१-१८", "content_sanskrit": "भगवंस्तारको नाम तारजो दानवोत्तमः  ।\nतेन सन्निहता युद्धे वत्सा गोपतिना यता ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003298018, "chapter_id": 23298, "verse_number": "१-१०१-१९", "content_sanskrit": "भयात्तस्मान्महाभाग बृहद्युद्धे बृहस्पते  ।\nअनिकेता भ्रमंत्येते शकुंता इव पंजरे ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003298019, "chapter_id": 23298, "verse_number": "१-१०१-२०", "content_sanskrit": "अस्माकं यान्यमोघानि आयुधान्यंगिरोवर  ।\nतानि मोघानि जायंते प्रभावादमरद्विषः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003298020, "chapter_id": 23298, "verse_number": "१-१०१-२१", "content_sanskrit": "दशवर्षसहस्राणि द्विगुणानि बृहस्पते  ।\nविष्णुना योधितो युद्धे तेनापि न च सूदितः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003298021, "chapter_id": 23298, "verse_number": "१-१०१-२२", "content_sanskrit": "यस्तेनानिर्जितो युद्धे विष्णुना प्रभविष्णुना  ।\nकथमस्मद्विधस्तस्य स्थास्यते समरेऽग्रतः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003298022, "chapter_id": 23298, "verse_number": "१-१०१-२३", "content_sanskrit": "एवमुक्त्स्तु शक्रेण जीवः सार्धं सुराधिपैः  ।\nसहस्राक्षेण च विभुं संप्राप्याह कुशध्वजम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003298023, "chapter_id": 23298, "verse_number": "१-१०१-२४", "content_sanskrit": "सोपि तस्य मुखाच्छ्रुत्वा प्रणयात्प्रणतार्तिहा  ।\nदेवैरशेषैः सेंद्रैस्तु जीवमाह पितामहः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003298024, "chapter_id": 23298, "verse_number": "१-१०१-२५", "content_sanskrit": "जाने वोर्तिं सुरेंद्राणां तथापि श्रृणु सांप्रतम्  ।\nविनिंद्यदक्ष या देवी सती रुद्रांगसंभवा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003298025, "chapter_id": 23298, "verse_number": "१-१०१-२६", "content_sanskrit": "उमा हैमवती जज्ञे सर्वलोकनमस्कृता  ।\nतस्याश्चैवेह रूपेण यूयं देवाः सुरोत्तमाः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003298026, "chapter_id": 23298, "verse_number": "१-१०१-२७", "content_sanskrit": "विभोर्यतध्वमाक्रष्टुं रुद्रस्यास्य मनो महत्  ।\nतयोर्योगेन संभूतः स्कंदः शक्तिधरः प्रभुः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003298027, "chapter_id": 23298, "verse_number": "१-१०१-२८", "content_sanskrit": "षडास्यो द्वादशभुजः सेनानीः पावकिः प्रभुः  ।\nस्वाहेयः कार्तिकेयश्च गांगेयः शरधामजः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003298028, "chapter_id": 23298, "verse_number": "१-१०१-२९", "content_sanskrit": "देवः शाखो विशाखश्च नैगमेशश्च वीर्यवान्  ।\nसेनापतिः कुमाराख्यः सर्वलोकनमस्कृतः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003298029, "chapter_id": 23298, "verse_number": "१-१०१-३०", "content_sanskrit": "लीलयैव महासेनः प्रबलं तारकासुरम्  ।\nबालोपि विनहत्यैको देवान् संतारयिष्यति ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003298030, "chapter_id": 23298, "verse_number": "१-१०१-३१", "content_sanskrit": "एवमुक्तास्तदातेन ब्रह्मणा परमेष्ठिना  ।\nबृहस्पतिस्तथा सेंद्रैर्देवैर्देवं प्रणम्य तम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003298031, "chapter_id": 23298, "verse_number": "१-१०१-३२", "content_sanskrit": "मेरो शिखरमासाद्य स्मरं सस्मार सुव्रतः  ।\nस्मरणाद्देवदेवस्य स्मरोपि सह भार्यया ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003298032, "chapter_id": 23298, "verse_number": "१-१०१-३३", "content_sanskrit": "रत्या समं समागम्य नमस्कृत्य कृतांजलिः  ।\nसशक्रमाह तं जीवं जगज्जीवो द्विजोत्तमाः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003298033, "chapter_id": 23298, "verse_number": "१-१०१-३४", "content_sanskrit": "स्मृतो यद्भवता जीव संप्राप्तोहं तवांतिकम्  ।\nब्रूहि यन्मे विधातव्यं तमाह सुरपुजितः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003298034, "chapter_id": 23298, "verse_number": "१-१०१-३५", "content_sanskrit": "तमाह भगवाञ्छक्रः संभाव्य मकरध्वजम्  ।\nशंकरेणांबिकामद्य संयोजय यथासुखम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003298035, "chapter_id": 23298, "verse_number": "१-१०१-३६", "content_sanskrit": "तया स रमते येन भगवान् वृषभध्वजः  ।\nतेन मार्गेण मार्गस्व पत्न्या रत्याऽनया सह ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003298036, "chapter_id": 23298, "verse_number": "१-१०१-३७", "content_sanskrit": "सोपि तुष्टो महादेवः प्रदास्यति शुभां गतिम्  ।\nविप्रयुक्तस्तया पूर्वं लब्द्वा तां गिरिजामुमाम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003298037, "chapter_id": 23298, "verse_number": "१-१०१-३८", "content_sanskrit": "एवमुक्तो नमस्कृत्य देवदेवं शचीपतिम्  ।\nदेवदेवाश्रमं गंतुं मतिं चक्रे तया सह ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003298038, "chapter_id": 23298, "verse_number": "१-१०१-३९", "content_sanskrit": "गत्वा तदश्रये शंभोः सह रत्या महाबलः  ।\nवसंतेन सहायेन देवं योक्तुमनाभवत् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003298039, "chapter_id": 23298, "verse_number": "१-१०१-४०", "content_sanskrit": "ततः संप्रेक्ष्य मदनं हसन् देवस्त्रियंवकः  ।\nनयनेन तृतीयेन सावज्ञं तमेवैक्षत ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003298040, "chapter_id": 23298, "verse_number": "१-१०१-४१", "content_sanskrit": "ततोस्य नेत्रजो वह्निर्मदनं पार्श्वतः स्थितम्  ।\nअदहत्तत्क्षणादेव ललाप करुणं रतिः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003298041, "chapter_id": 23298, "verse_number": "१-१०१-४२", "content_sanskrit": "रत्याः प्रलापमाकर्ण्य देवदेवो वृपध्वजः  ।\nकृपया परया प्राह कामपत्नीं निरीभ्य च ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003298042, "chapter_id": 23298, "verse_number": "१-१०१-४३", "content_sanskrit": "अमूर्त्तोपि ध्रुपं भद्र कार्यं सर्वं पतिस्तव  ।\nरतिकाले ध्रुवे भद्रे करिष्यति न संशयः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003298043, "chapter_id": 23298, "verse_number": "१-१०१-४४", "content_sanskrit": "यदा विष्णुश्च भविता वासुदेवो महायशाः  ।\nशापाद्भृगोर्महातेजाः सर्वलोकहितायवै ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003298044, "chapter_id": 23298, "verse_number": "१-१०१-४५", "content_sanskrit": "तदा तस्य सुतो यश्च स पतिस्ते भविष्यति  ।\nसा प्रणम्य तदा रुद्रं कामपत्नी शुचिस्मिता ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003298045, "chapter_id": 23298, "verse_number": "१-१०१-४६", "content_sanskrit": "जगाम भवनं लब्ध्वा वसंतेन समन्विता ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]