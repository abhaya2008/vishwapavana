[{"id": 7005835000, "chapter_id": 25835, "verse_number": "१-१८-१", "content_sanskrit": "सूत उवाच ।\nगरुडोक्तं कश्यपाय वक्ष्ये मृत्युञ्जयार्चम्।\nउद्धारपूर्वकं पुण्यं सर्वदेवमयं मतम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005835001, "chapter_id": 25835, "verse_number": "१-१८-२", "content_sanskrit": "ओङ्कारं पूर्वमुद्धृत्य जु(हु)ङ्काँरं तदनन्तम्।\nसविसर्गं तृतीयं स्यान्मृत्युदारिद्र्यमर्दनम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005835002, "chapter_id": 25835, "verse_number": "१-१८-३", "content_sanskrit": "ईशविष्णवर्कदेव्यादिकवचं ।\nअमृतेशं महामन्त्रंत्र्यक्षरं पूजनं समम।\nजपनान्मृत्युहीनाः स्युः सर्वपापविवर्जिताः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005835003, "chapter_id": 25835, "verse_number": "१-१८-४", "content_sanskrit": "शतजप्याद्वेदफलं यज्ञतीर्थफलं लभेत् ।\nअष्टोत्तरशताज्जाप्यात्रिसन्ध्यं मृत्यु शत्रुजित ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005835004, "chapter_id": 25835, "verse_number": "१-१८-५", "content_sanskrit": "ध्यायेच्च सितपद्मस्थं वरदं चाभयं करे ।\nद्वाभ्यां चामृतकुम्भं तु चिन्तयेदमृतेश्वरम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005835005, "chapter_id": 25835, "verse_number": "१-१८-६", "content_sanskrit": "तस्यैवांगगतां देवीममृतामृतभाषिणी(विनि) म् ।\nकलशं दक्षिणे हस्ते वामहस्ते सरोरुहम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005835006, "chapter_id": 25835, "verse_number": "१-१८-७", "content_sanskrit": "जपेदष्टसहस्त्रं वै त्रिसन्ध्यं मासमकतः।\nजरामृत्युमहाव्याधिशत्रुच्छिवशान्तिदम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005835007, "chapter_id": 25835, "verse_number": "१-१८-८", "content_sanskrit": "आह्वानं स्थापनं रोधं सन्निधानं निवेशनम् ।\nपाद्यमा चमनं स्नानमर्घ्यं स्त्रगनुलेपनम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005835008, "chapter_id": 25835, "verse_number": "१-१८-९", "content_sanskrit": "दीपांबरं भूषणं च नैवद्यं पानवीजनम् ।\nमात्रामुद्राजपध्यानं दक्षिणा चाहुतिः स्तुतिः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005835009, "chapter_id": 25835, "verse_number": "१-१८-१०", "content_sanskrit": "वाद्यं गतिं च नृत्यं च न्यासयोगं प्रदक्षिणम् ।\nप्रणतिर्मन्त्रशय्या च वन्दनं च विसर्जनम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005835010, "chapter_id": 25835, "verse_number": "१-१८-११", "content_sanskrit": "षडंगादिप्रकारेण पूजनं तु क्रमोदितम् ।\nपरमेशमुखोद्रीतं यो जानाति स पूजकः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005835011, "chapter_id": 25835, "verse_number": "१-१८-१२", "content_sanskrit": "अर्घ्यपात्रार्चनं चादौवस्त्रेणैव तताडनम्।\nशोधनं कवचेनैव अमृतीकरणं ततः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005835012, "chapter_id": 25835, "verse_number": "१-१८-१३", "content_sanskrit": "पूजा चाधारशक्त्यादेः प्राणायामं तथासने ।\nपीठशुद्धिं ततः कुर्य्याच्छोषणाद्यैस्ततः स्मरेत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005835013, "chapter_id": 25835, "verse_number": "१-१८-१४", "content_sanskrit": "आत्मानं देवरूपं च करांगन्यासकं चरेत् ।\nआत्मानं पूजयेत्पश्चाज्यो तीरूपं हृदब्जतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005835014, "chapter_id": 25835, "verse_number": "१-१८-१५", "content_sanskrit": "मूर्त्तौ वा स्थण्डिले वापि क्षिपेत्पुष्पंत भास्वरम्।\nआह्वानद्वारपूजार्थं पूजा चाधारशक्तितः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005835015, "chapter_id": 25835, "verse_number": "१-१८-१६", "content_sanskrit": "सान्निध्यकरणं देवे परिवारस्य पूजनम् ।\nअंगषट्कस्य पूजा वै कर्त्तव्या च विपश्चितैः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005835016, "chapter_id": 25835, "verse_number": "१-१८-१७", "content_sanskrit": "धर्मादयश्च शक्राद्याः सायुधाः परिवारकाः ।\nयुगवेदमुहूर्त्ताश्च पूजेयं भुक्तिमुक्तिकृत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005835017, "chapter_id": 25835, "verse_number": "१-१८-१८", "content_sanskrit": "मातृकाश्च गणांश्चादौ नन्दिगङ्गे च पूजयत।\nमहाकालं च यमनां देहल्यां पूजयेत्पुरा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005835018, "chapter_id": 25835, "verse_number": "१-१८-१९", "content_sanskrit": "ॐ अमृतेश्वर ॐ भैरवाय नमः ।\nएवं ॐ जुं हंसः सूर्य्याय नमः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005835019, "chapter_id": 25835, "verse_number": "१-१८-२०", "content_sanskrit": "एवं शिवाय कृष्णाय ब्रह्मणे च गणाय च ।\nचण्डिकायै सरस्वत्यै महालक्ष्मादि पूजयेत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]