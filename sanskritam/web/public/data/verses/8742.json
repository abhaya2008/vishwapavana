[{"id": 900009279, "chapter_id": 8742, "verse_number": "32.1", "content_sanskrit": "ननु पक्षे साध्याभावप्रमितिदशायां हेतुरप्रमितः प्रमितो वा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900009280, "chapter_id": 8742, "verse_number": "32.2", "content_sanskrit": "केचित्तु बाधप्रतिरोधौ हेतुदोषावित्याहुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900009281, "chapter_id": 8742, "verse_number": "32.3", "content_sanskrit": "ननु साध्यविकलो दृष्टान्तो विपक्ष एवेति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900009282, "chapter_id": 8742, "verse_number": "32.4", "content_sanskrit": "आश्रयासिद्धिस्तु न दोषः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900009283, "chapter_id": 8742, "verse_number": "32.5", "content_sanskrit": "एवं साध्याप्रसिद्धिरपि न दोषः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900009284, "chapter_id": 8742, "verse_number": "32.6", "content_sanskrit": "एवं व्यधिकरणासिद्धिरपि न दोषः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900009285, "chapter_id": 8742, "verse_number": "32.7", "content_sanskrit": "केचित्तु– सव्यभिचारविरुद्धसत्प्रतिपक्षासिद्धबाधिताः पञ्चहेत्वाभासाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900009286, "chapter_id": 8742, "verse_number": "32.8", "content_sanskrit": "एवं हेतुदोषेऽप्यसाधकतालिङ्गत्वं सव्यभिचारविरुद्धव्याप्यत्वा-सिद्धानुगतेनाव्याप्तित्वेनैव", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900009287, "chapter_id": 8742, "verse_number": "32.9", "content_sanskrit": "नापि मण्युक्तप्रकारेण साधारणत्वादिनाऽसाधकतालिङ्गत्वम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900009288, "chapter_id": 8742, "verse_number": "32.10", "content_sanskrit": "असाधारणत्वमपि सर्वसपक्षविपक्षव्यावृत्तत्वं चेत् विशेष्य-वैयर्थ्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900009289, "chapter_id": 8742, "verse_number": "32.11", "content_sanskrit": "अनुपसंहारित्वमपि न तावद्व्याप्तिग्रहानुकूलैकधर्म्युपसंहाराभावः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900009290, "chapter_id": 8742, "verse_number": "32.12", "content_sanskrit": "विरुद्धत्वमपि विपक्षमात्रवृत्तित्वं चेत्, मात्रपदवैयर्थ्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900009291, "chapter_id": 8742, "verse_number": "32.13", "content_sanskrit": "यच्चोक्तं मणौ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900009292, "chapter_id": 8742, "verse_number": "32.14", "content_sanskrit": "उदयनेन तु निबन्धे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900009293, "chapter_id": 8742, "verse_number": "32.15", "content_sanskrit": "एतेन यदुक्तं मणिकण्ठे । सूत्रोक्तरीत्या हेत्वाभासाः पञ्चैव", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900009294, "chapter_id": 8742, "verse_number": "32.16", "content_sanskrit": "लीलावत्यां तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900009295, "chapter_id": 8742, "verse_number": "32.17", "content_sanskrit": "एतेन यदुक्तं भासर्वज्ञेन..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900009296, "chapter_id": 8742, "verse_number": "32.18", "content_sanskrit": "अयमत्र निष्कृष्टोऽर्थः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]