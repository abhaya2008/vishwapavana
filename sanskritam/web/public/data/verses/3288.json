[{"id": 2105807, "chapter_id": 3288, "verse_number": "१६-१७-०", "content_sanskrit": "धृतराष्ट्रस्य वनप्रस्थानसमये विदुरसंजयाभ्यामपि वनवासाय तेन सह प्रस्थानम् ॥ १ ॥ तथा कुन्त्यापि युधिष्ठिरादिभिर्बहुधा प्रार्थनाभिः प्रतिषेधनेपि तत्समाश्वासनपूर्वकं गान्धार्या सह वनंप्रति प्रस्थानम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2105808, "chapter_id": 3288, "verse_number": "१६-१७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2105809, "chapter_id": 3288, "verse_number": "१६-१७-१", "content_sanskrit": "ततः प्रासादहर्म्येषु वसुधायां च पार्थिव।\nनारीणां च नराणां च निःस्वनः सुमहानभूत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2105810, "chapter_id": 3288, "verse_number": "१६-१७-२", "content_sanskrit": "स राजा राजमार्गेण नृनारीसंकुलेन च।\nकथञ्चिन्निर्ययौ धीमान्वेपमानः कृताञ्जलिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2105811, "chapter_id": 3288, "verse_number": "१६-१७-३", "content_sanskrit": "स वर्धमानद्वारेणि निर्ययौ गजसाह्वयात्।\nविसर्जयामास च तं जनौघं स मुहुर्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2105812, "chapter_id": 3288, "verse_number": "१६-१७-४", "content_sanskrit": "वनं गन्तुं च विदुरो राज्ञा सह कृतक्षणः।\nसंजयश्च महामात्रः सूतो गावल्गणिस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2105813, "chapter_id": 3288, "verse_number": "१६-१७-५", "content_sanskrit": "ककृपं निवर्तयामास युयुत्सुं च महारथम्।\nधृताराष्ट्रो महीपालः परिदाप्य युधिष्ठिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2105814, "chapter_id": 3288, "verse_number": "१६-१७-६", "content_sanskrit": "निवृत्ते पौरवर्गे च राजा सान्तःपुरस्तदा।\nधृतराष्ट्राभ्यनुज्ञातो निवर्तितुमियेष ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2105815, "chapter_id": 3288, "verse_number": "१६-१७-७", "content_sanskrit": "सोब्रवीन्मातरं कुन्तीमुपेत्य भरतर्षभ॥\nअहं राजानमन्विष्ये भवती विनिवर्तताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2105816, "chapter_id": 3288, "verse_number": "१६-१७-८", "content_sanskrit": "वधूपरिवृता राज्ञि नगरं गन्तुमर्हसि।\nराजा यात्वेष धर्मात्मा तपसे कृतनिश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2105817, "chapter_id": 3288, "verse_number": "१६-१७-९", "content_sanskrit": "इत्युक्ता धर्मराजेनि बाष्पव्याकुललोचना।\nजगामैव तदा कुन्ती गान्धारीं परिगृह्य ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2105818, "chapter_id": 3288, "verse_number": "१६-१७-१०x", "content_sanskrit": "कुन्त्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2105819, "chapter_id": 3288, "verse_number": "१६-१७-१०", "content_sanskrit": "सहदेवे महाराज माऽप्रसादं कृथाः क्वचित्।\nएष मामनुरक्तो हि राजंस्त्वां चैव सर्वदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2105820, "chapter_id": 3288, "verse_number": "१६-१७-११", "content_sanskrit": "कर्णं स्मरेथाः सततं सङ्ग्रामेष्वपलायिनम्।\nअवकीर्णो हि स मया वीरो दुष्प्रज्ञया तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2105821, "chapter_id": 3288, "verse_number": "१६-१७-१२", "content_sanskrit": "आयसं हृदयं नूनं मन्दाया मम पुत्रक।\nयत्सूर्यजमपश्यन्त्याः शतधा न विदीर्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2105822, "chapter_id": 3288, "verse_number": "१६-१७-१३", "content_sanskrit": "एवं गते तु किं शक्यं मया कर्तुमरिंदम।\nमम दोषोऽयमत्यर्थं ख्यापितो यन्न सूर्यजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2105823, "chapter_id": 3288, "verse_number": "१६-१७-१४", "content_sanskrit": "तन्निमित्तं महाबाहो दानं दद्यास्त्वमुत्तमम्।\nसदैव भ्रातृभिः सार्धं सूर्यजस्यारिमर्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2105824, "chapter_id": 3288, "verse_number": "१६-१७-१५", "content_sanskrit": "द्रौपद्याश्च प्रिये नित्यं स्थातव्यमरिकर्शन।\nभीमसेनोऽर्जुनश्चैव नकुलश्च कुरूद्वह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2105825, "chapter_id": 3288, "verse_number": "१६-१७-१६", "content_sanskrit": "समाधेयास्त्वया राजंस्त्वय्यद्य कुलधूर्गता।\nश्वश्रूश्वशुरयोः पादाञ्शुश्रूषन्ती वने त्वहम्।\nगान्धारीसहिता वत्स्ये तापसी मलपङ्किनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2105826, "chapter_id": 3288, "verse_number": "१६-१७-१७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2105827, "chapter_id": 3288, "verse_number": "१६-१७-१७", "content_sanskrit": "एवमुक्तः स धर्मात्मा भ्रातृभिः सहितो वशी।\nविषादमगमद्धीमान्न च किञ्चिदुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2105828, "chapter_id": 3288, "verse_number": "१६-१७-१८", "content_sanskrit": "मुहूर्तमिव तु ध्यात्वा धर्मराजो युधिष्ठिरः।\nउवाच मतारं दीनश्चिन्ताशोकपरायणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2105829, "chapter_id": 3288, "verse_number": "१६-१७-१९", "content_sanskrit": "किमिदं ते व्यवसितं नैवं त्वं वक्तुमर्हसि।\nन त्वामभ्यनुजानामि प्रसादं कर्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2105830, "chapter_id": 3288, "verse_number": "१६-१७-२०", "content_sanskrit": "व्यचोदयः पुराऽस्माकमुत्साहं शुभदर्शने।\nविदुलाया वचोभिस्त्वं नास्मान्संत्यक्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2105831, "chapter_id": 3288, "verse_number": "१६-१७-२१", "content_sanskrit": "निहत्य पृथिवीपालान्राज्यं प्राप्तमिदं मया।\nतव प्रज्ञामुपश्रुत्य वासुदेवान्नरर्षभात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2105832, "chapter_id": 3288, "verse_number": "१६-१७-२२", "content_sanskrit": "क्व सा बुद्धिरियं चाद्य भवत्या या श्रुता मया।\nक्षत्रधर्मे स्थितं त्यक्त्वा न प्रयातुमिहार्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2105833, "chapter_id": 3288, "verse_number": "१६-१७-२३", "content_sanskrit": "अस्मानुत्सृज्य राज्यं च स्नुषाहीना यशस्विनि।\nकथं वत्स्यसि दुर्गेषु वनेष्वद्य प्रसीद मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2105834, "chapter_id": 3288, "verse_number": "१६-१७-२४", "content_sanskrit": "इति बाष्पकला वाचः कुन्ती पुत्रस्य शृण्वती।\nजगामैवाश्रुपूर्णाक्षी भीमस्तामिदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2105835, "chapter_id": 3288, "verse_number": "१६-१७-२५", "content_sanskrit": "यदा राज्यमिदं कुन्ति भोक्तव्यं पुत्रनिर्जितम्।\nप्राप्तव्या राजधर्माश्च तदेयं ते कुतो मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2105836, "chapter_id": 3288, "verse_number": "१६-१७-२६", "content_sanskrit": "किं वयं कारिताः पूर्वं भवत्या पृथिवीक्षयम्।\nकस्य हेतोः परित्यज्य वनं गन्तुमभीप्ससि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2105837, "chapter_id": 3288, "verse_number": "१६-१७-२७", "content_sanskrit": "वनाच्चापि किमानीता भवत्या बालका वयम्।\nदुःखशोकसमाविष्टौ माद्रीपुत्राविमौ तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2105838, "chapter_id": 3288, "verse_number": "१६-१७-२८", "content_sanskrit": "प्रसीद मातर्मा गास्त्वं वनमद्य यशस्विनि।\nश्रियं यौधिष्ठिरीं मातर्भुङ्क्ष्व पार्थबलार्जिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2105839, "chapter_id": 3288, "verse_number": "१६-१७-२९", "content_sanskrit": "इति सा निश्चितैवाशु वनवासकृततक्षणा।\nलालप्यतां बहुविधं पुत्राणां नाकरोद्वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2105840, "chapter_id": 3288, "verse_number": "१६-१७-३०", "content_sanskrit": "द्रौपदी चान्वयाच्छ्वश्रूं विषष्णवदना तदा।\nवनवासाय गच्छन्तीं रुदती भद्रया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2105841, "chapter_id": 3288, "verse_number": "१६-१७-३१", "content_sanskrit": "सा पुत्रान्रुदतः सर्वान्मुहुर्मुहुरवेक्षती।\nजगामैव महाप्राज्ञा वनाय कृतनिश्चया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2105842, "chapter_id": 3288, "verse_number": "१६-१७-३२", "content_sanskrit": "अन्वयुः पाण्डवास्तां तु सभृत्यान्तःपुरास्तथा।\nततः प्रमृज्य साऽश्रूणि पुत्रान्वचनमब्रवीत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2105843, "chapter_id": 3288, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्रमवासिकपर्वणि आश्रमवासपर्वणि सप्तदशोऽध्यायः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]