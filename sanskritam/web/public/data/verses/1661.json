[{"id": 2030330, "chapter_id": 1661, "verse_number": "३-२९९-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2030331, "chapter_id": 1661, "verse_number": "३-२९९-१", "content_sanskrit": "एतस्मिन्नेव काले तु द्युमत्सेनो महाबलः।\nलब्धचक्षुः प्रसन्नायां दृष्ट्यां सर्वं ददर्श ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2030332, "chapter_id": 1661, "verse_number": "३-२९९-२", "content_sanskrit": "स सर्वानाश्रमान्गत्वा शैब्यया सह भार्यया।\nपुत्रहेतोः परामार्तिं जगाम भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2030333, "chapter_id": 1661, "verse_number": "३-२९९-३", "content_sanskrit": "तावाश्रमान्नदीश्चैववनानि च सरांसि च।\nतस्यां निशि विचिन्वन्तौ दम्पती परिजग्मतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2030334, "chapter_id": 1661, "verse_number": "३-२९९-४", "content_sanskrit": "श्रुत्वा शब्दं तु यं कंचिदुन्मुखौ सुतशङ्कया।\nसावित्रीसहितोऽभ्येति सत्यवानित्यभाषताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2030335, "chapter_id": 1661, "verse_number": "३-२९९-५", "content_sanskrit": "भिन्नैश्च परुषैः पादैः सव्रणैः शोणितोक्षितैः।\nकुशकणअटकविद्धाङ्गावुनमत्ताविव धावतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2030336, "chapter_id": 1661, "verse_number": "३-२९९-६", "content_sanskrit": "ततोऽभिसृत्य तैर्विप्रैः सर्वैराश्रमवासिभिः।\nपरिवार्य समाश्वास्य तावानीतौ स्वमाश्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2030337, "chapter_id": 1661, "verse_number": "३-२९९-७", "content_sanskrit": "तत्रभार्यासहायः स वृतो वृद्धैस्तपोधनैः।\nआश्वासितोपि चित्रार्थैः पूर्वराजकथाश्रयैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2030338, "chapter_id": 1661, "verse_number": "३-२९९-८", "content_sanskrit": "ततस्तौ पुनराश्वस्तौ वृद्धौ पुत्रदिदृक्षया।\nबाल्यवृत्तानि पुत्रस्य सावित्र्या दर्शनानि च।\nशोकं जग्मतुरन्योन्यं स्मरन्तौ भृशदुःखितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2030339, "chapter_id": 1661, "verse_number": "३-२९९-९", "content_sanskrit": "हापुत्र हासाध्वि वधु क्वासिक्वासीत्यरोदताम्।\nब्राह्मणः सत्यवाक्येषामुवाचेदं तयोर्वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2030340, "chapter_id": 1661, "verse_number": "३-२९९-१०x", "content_sanskrit": "सुवर्चा उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2030341, "chapter_id": 1661, "verse_number": "३-२९९-१०", "content_sanskrit": "यथास्य भार्या सावित्री तपसा च दमेन च।\nआचारेण च संयुक्ता तथा जीवति सत्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2030342, "chapter_id": 1661, "verse_number": "३-८३-२९९x", "content_sanskrit": "गौतम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2030343, "chapter_id": 1661, "verse_number": "३-२९९-११", "content_sanskrit": "वेदाः साङ्गा मयाऽधीतास्तपो मे संचितं महत्।\nकौमारब्रह्मचर्यं च गुरवोऽग्निश्च तोषिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2030344, "chapter_id": 1661, "verse_number": "३-२९९-१२", "content_sanskrit": "समाहितेन चीर्णानि सर्वाण्येव व्रतानि मे।\nवायुभक्षोपवासश्च कृतोमे विधिवत्सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2030345, "chapter_id": 1661, "verse_number": "३-२९९-१३", "content_sanskrit": "अनेन तपसा वेद्मि सर्वं परचीकीर्षितम्।\nसत्यमेतन्निबोधध्वं ध्रियते सत्यवानिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2030346, "chapter_id": 1661, "verse_number": "३-२९९-१४x", "content_sanskrit": "शिष्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2030347, "chapter_id": 1661, "verse_number": "३-२९९-१४", "content_sanskrit": "उपाध्यायस्य मे वक्राद्यथा वाक्यं विनिःसृतम्।\nनैव जातु भवेन्मिथ्या तथा जीवति सत्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2030348, "chapter_id": 1661, "verse_number": "३-२९९-१५x", "content_sanskrit": "ऋषय ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2030349, "chapter_id": 1661, "verse_number": "३-२९९-१५", "content_sanskrit": "यथाऽस्य भार्या सावित्री सर्वैरेव सुलक्षणैः।\nअवैधव्यकरैर्युक्ता तथा जीवति सत्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2030350, "chapter_id": 1661, "verse_number": "३-२९९-१६x", "content_sanskrit": "भारद्वाज उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2030351, "chapter_id": 1661, "verse_number": "३-२९९-१६", "content_sanskrit": "यथाऽस्य भार्या सावित्री तपसा च दमेन च।\nआचारेण च संयुक्ता तथा जीवति सत्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2030352, "chapter_id": 1661, "verse_number": "३-२९९-१७x", "content_sanskrit": "दाल्भ्या रउवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2030353, "chapter_id": 1661, "verse_number": "३-२९९-१७", "content_sanskrit": "यथा दृष्टिः प्रवृत्ता ते सावित्र्याश्च यथा व्रतम्।\nगताऽऽहारमकृत्वैव तथा जीवति सत्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2030354, "chapter_id": 1661, "verse_number": "३-२९९-१८x", "content_sanskrit": "आपस्तम्ब उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2030355, "chapter_id": 1661, "verse_number": "३-२९९-१८", "content_sanskrit": "यथा वदन्ति शान्तायां दिशि वै मृगपक्षिणः।\nपार्थिवीं चैववृद्धिं ते तथा जीवति सत्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2030356, "chapter_id": 1661, "verse_number": "३-२९९-१९x", "content_sanskrit": "धौम्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2030357, "chapter_id": 1661, "verse_number": "३-२९९-१९", "content_sanskrit": "सर्वैर्गुणैरुपेतस्ते यथा पुत्रो जनप्रियः।\nदीर्घायुर्लक्षणोपेतस्तथा जीवति स्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2030358, "chapter_id": 1661, "verse_number": "३-२९९-२०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2030359, "chapter_id": 1661, "verse_number": "३-२९९-२०", "content_sanskrit": "एवमाश्वासितस्तैस्तु सत्यवाग्भिस्तपस्विभिः।\nतांस्तान्विगणयन्सर्वांस्ततः स्थिर इवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2030360, "chapter_id": 1661, "verse_number": "३-२९९-२१", "content_sanskrit": "ततो मुहूर्तात्सावित्री भर्त्रा सत्वता सह।\nआजगामाश्रमं रात्रौ प्रहृष्टा प्रविवेश ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2030361, "chapter_id": 1661, "verse_number": "३-२९९-२२", "content_sanskrit": "`दृष्ट्वा चोत्पतिताः सर्वेहर्षं जग्मुश्च ते द्विजाः।\nकण्ठं माता पिता चास्य समालिङ्ग्याभ्यरोदतां ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2030362, "chapter_id": 1661, "verse_number": "३-२९९-२३x", "content_sanskrit": "ब्राह्मणा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2030363, "chapter_id": 1661, "verse_number": "३-२९९-२३", "content_sanskrit": "पुत्रेण संगतं त्वां तु चक्षुष्मन्तं निरीक्ष्य च।\nसर्वे वयं वै पृच्छामो वृद्धिं वै पृथिवीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2030364, "chapter_id": 1661, "verse_number": "३-२९९-२४", "content_sanskrit": "समागमेन पुत्रस्य सावित्र्या दर्शनेन च।\nचक्षुषश्चात्मनो लाभात्रिभिर्दिष्ठ्या विवर्धसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2030365, "chapter_id": 1661, "verse_number": "३-२९९-२५", "content_sanskrit": "सर्वैरस्माभिरुक्तं यत्तथा तन्नात्रसंशयः।\nभूयोभूयः समृद्धिस्ते क्षिप्रमेव भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2030366, "chapter_id": 1661, "verse_number": "३-२९९-२६x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2030367, "chapter_id": 1661, "verse_number": "३-२९९-२६", "content_sanskrit": "ततोऽग्निं तत्र संज्वाल्य द्विजास्ते सर्व एव हि।\nउपासांचक्रिरे पार्थ द्युमत्सेनं महीपतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2030368, "chapter_id": 1661, "verse_number": "३-२९९-२७", "content_sanskrit": "शैव्या च सत्यवांश्चैव सावित्री चैकतः स्थिताः।\nसर्वैस्तैरभ्यनुज्ञाता विशोका समुपाविशन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2030369, "chapter_id": 1661, "verse_number": "३-२९९-२८", "content_sanskrit": "ततो राज्ञा सहासीनाः सर्वे ते वनवासिनः।\nजातकौतूहलाः पार्थ पप्रच्छुर्नृपतेः सुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2030370, "chapter_id": 1661, "verse_number": "३-२९९-२९", "content_sanskrit": "प्रागेव नागतं कस्मात्सभार्येण त्वया विभो।\nविरात्रे चागतं कस्मात्कोनु बन्धस्तवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2030371, "chapter_id": 1661, "verse_number": "३-२९९-३०", "content_sanskrit": "संतापितः पिता माता वयं चैव नृपात्मज।\nकस्मादिति न जानीमस्तत्सर्वं वक्तुमर्हिसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2030372, "chapter_id": 1661, "verse_number": "३-२९९-३१x", "content_sanskrit": "सत्यवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2030373, "chapter_id": 1661, "verse_number": "३-२९९-३१", "content_sanskrit": "पित्राऽहमभ्यनुज्ञातः सावित्रीसहितो गतः।\nअथ मेऽभूच्छिरोदुःखं वने काष्ठानि भिन्दतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2030374, "chapter_id": 1661, "verse_number": "३-२९९-३२", "content_sanskrit": "सुप्तश्चाहं वेदनया चिरमित्युपलक्षये।\nतावत्कालं न च मया सुप्तपूर्वं कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2030375, "chapter_id": 1661, "verse_number": "३-२९९-३३", "content_sanskrit": "सर्वेषामेव भवतां संतापो मा भवेदिति।\nअतो विरात्रागमनं नान्यदस्तीह कारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2030376, "chapter_id": 1661, "verse_number": "३-२९९-३४x", "content_sanskrit": "गौतम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2030377, "chapter_id": 1661, "verse_number": "३-२९९-३४", "content_sanskrit": "अकस्माच्चक्षुः प्राप्तिर्द्युमत्सेनस्य ते पितुः।\nनास्य त्वं कारणं वेत्सि सावित्री वक्तुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2030378, "chapter_id": 1661, "verse_number": "३-२९९-३५", "content_sanskrit": "श्रोतुमिच्छामि सावित्रि त्वं हि वेत्थ परावरम्।\nत्वां हि जानामि सावित्रि सावित्रीमिव तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2030379, "chapter_id": 1661, "verse_number": "३-२९९-३६", "content_sanskrit": "त्वमत्र हेतुं जानीषे तस्मात्सत्यं निरुच्यताम्।\nरहस्यं यदि ते नास्ति किंचिदत्र वदस्व नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2030380, "chapter_id": 1661, "verse_number": "३-२९९-३७x", "content_sanskrit": "सावित्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2030381, "chapter_id": 1661, "verse_number": "३-२९९-३७", "content_sanskrit": "एवमेतद्यथा वेत्थ संकल्पो नान्यथा हि वः।\nन हि किंचिद्रहस्यं मे श्रूयतां तथ्यमेव यत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2030382, "chapter_id": 1661, "verse_number": "३-२९९-३८", "content_sanskrit": "मृत्युर्मे पत्युराख्यातो नारदेन महात्मना।\nस चाद्य दिवसः प्राप्तस्ततो नैनं जहाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2030383, "chapter_id": 1661, "verse_number": "३-२९९-३९", "content_sanskrit": "सुप्तं चैनं साक्षादुपागच्छत्सकिंकरः।\nस एनमनयद्बद्ध्वा दिशं पितृनिषेविताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2030384, "chapter_id": 1661, "verse_number": "३-२९९-४०", "content_sanskrit": "अस्तौषं तमहं देवं सत्येन वचसा विभुम्।\nपञ्च वै तेन मे दत्ता वराः शृणुत तान्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2030385, "chapter_id": 1661, "verse_number": "३-२९९-४१", "content_sanskrit": "चक्षुषी च स्वराज्यंच द्वौ वरौ श्वशुरस्य मे।\nलब्धं पितुः पुत्रशतं पुत्राणां चात्मनः शतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2030386, "chapter_id": 1661, "verse_number": "३-२९९-४२", "content_sanskrit": "चतुर्वर्षशतायुर्मे भर्ता लब्धश्च सत्यवान्।\nभर्तुर्हि जीवितार्थं तु मया चीर्णं त्विदं व्रतम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2030387, "chapter_id": 1661, "verse_number": "३-२९९-४३", "content_sanskrit": "एतत्सर्वं मयाऽऽख्यातं कारणं विस्तरण वः।\nयथावृत्तं सुखोदर्कमिदं दुःखं महन्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2030388, "chapter_id": 1661, "verse_number": "३-२९९-४४x", "content_sanskrit": "ऋषय ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2030389, "chapter_id": 1661, "verse_number": "३-२९९-४४", "content_sanskrit": "निमज्ज्मानं व्यसनैरभिद्रुतं\nकुलं नरन्द्रस्य तमोमये ह्रदे।\nत्वया सुशीलव्रतपुण्यया कुलं\nरसमुद्धृतं साध्वि पुनः कुलीनया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2030390, "chapter_id": 1661, "verse_number": "३-२९९-४५x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2030391, "chapter_id": 1661, "verse_number": "३-२९९-४५", "content_sanskrit": "तथा प्रशस्य ह्यभिपूज्य चैव\nवरस्त्रियं तामृषयः समागताः।\nनरेन्द्रमामन्त्र्य सपुत्रभञ्जसा\nशिवेन रजग्मुर्मुदिताः स्वमालयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2030392, "chapter_id": 1661, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि पतिव्रतामाहात्म्यपर्वणि एकोनत्रिशततमोऽध्यायः ॥ २९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]