[{"id": 7002745000, "chapter_id": 22745, "verse_number": "९-३०-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nबहुनात्र किमुक्तेन किं बह्वक्षरमालया ।\nवैशाखस्य सितामेकां तृतीयां शृणु पाण्डव ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002745001, "chapter_id": 22745, "verse_number": "९-३०-२", "content_sanskrit": "स्नानं दानं जपो होमः स्वाध्यायः पितृतर्पणम् ।\nयदस्यां क्रियते किञ्चित्सर्वं स्यात्तदिहाक्ष यम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002745002, "chapter_id": 22745, "verse_number": "९-३०-३", "content_sanskrit": "आदौ कृतयुगस्येयं युगादिस्तेन कथ्यते ।\nसर्वपापप्रशमनी सर्वसौख्यप्रदायिनी ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002745003, "chapter_id": 22745, "verse_number": "९-३०-४", "content_sanskrit": "शाकले नगरे कश्चिद्धर्मनामाभवद्वणिक् ।\nप्रियंवदः सत्यरतो देवब्राह्मणपूजकः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002745004, "chapter_id": 22745, "verse_number": "९-३०-५", "content_sanskrit": "तेन श्रुतं वाच्यमानं तृतीया रोहिणी पुरा ।\nयदा स्याद्बुधसंयुक्ता तदा साच महाफला ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002745005, "chapter_id": 22745, "verse_number": "९-३०-६", "content_sanskrit": "तस्यां यद्दीयते किंञ्चित्तत्सर्वं चाक्षयं भवेत् ।\nइति श्रुत्वा स गंगायां सन्तर्प्य पितृदेवताः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002745006, "chapter_id": 22745, "verse_number": "९-३०-७", "content_sanskrit": "गृहमागत्य करकान्सान्नानुदकसंयुतान् ।\nअंबुपूर्णान्गृहे कुंभान्क्रमान्निःशेषतस्तदा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002745007, "chapter_id": 22745, "verse_number": "९-३०-८", "content_sanskrit": "यवगोधूमचणकसक्तुदध्यौदनं तथा ।\nइक्षुक्षीरविकारांश्च सहिरण्यांश्च शक्तितः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002745008, "chapter_id": 22745, "verse_number": "९-३०-९", "content_sanskrit": "शुचिः शुद्धेन मनसा ब्राह्मणेभ्यो ददौ वणिक् ।\nभार्यया वार्यमाणोपि कुटुंबासक्तचिंतया ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002745009, "chapter_id": 22745, "verse_number": "९-३०-१०", "content_sanskrit": "तावत्स च स्थितः सत्त्वे मत्वा सर्वं विनश्वरम् ।\nधर्मार्थकाम शक्तस्तु कालेन बहुना ततः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002745010, "chapter_id": 22745, "verse_number": "९-३०-११", "content_sanskrit": "जगाम पञ्चत्वमसौ वासुदेवं स्मरन्मुहुः ।\nततः स क्षत्रियो जातः कुशावत्यां नरेश्वरः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002745011, "chapter_id": 22745, "verse_number": "९-३०-१२", "content_sanskrit": "बभूव चा क्षया तस्य समृद्धिर्धर्मनिर्जिता ।\nइयाज स महायज्ञैः समाप्तवरदक्षिणैः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002745012, "chapter_id": 22745, "verse_number": "९-३०-१३", "content_sanskrit": "ददौ गोभूहिरण्यादि दानान्यस्यामहर्निशम् ।\nबुभुजे कामतो भोगान्दीनार्तांस्तर्पयञ्जनान् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002745013, "chapter_id": 22745, "verse_number": "९-३०-१४", "content_sanskrit": "तथाप्यक्षयमेवास्य क्षयं याति न तद्धनम् ।\nश्रद्धापूर्वं तृतीयायां यद्दत्तं विभवं विना ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002745014, "chapter_id": 22745, "verse_number": "९-३०-१५", "content_sanskrit": "एतद्व्रतं मयाख्यातं श्रूयतामत्र यो विधिः ।\nउदकुंभान्सकरकात्स्नानसर्वरसैर्युतान् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002745015, "chapter_id": 22745, "verse_number": "९-३०-१६", "content_sanskrit": "ग्रैष्मिकं सर्वमेवात्र सस्यदानं प्रशस्यते ।\nछत्रोपानत्प्रदानं च गोभूकांचनवाससाम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002745016, "chapter_id": 22745, "verse_number": "९-३०-१७", "content_sanskrit": "यद्यदिष्टतमं चान्यत्तद्देयमविशंकया ।\nएतत्ते सर्वमाख्यातं किमन्यच्छ्रोतुमिच्छसि ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002745017, "chapter_id": 22745, "verse_number": "९-३०-१८", "content_sanskrit": "अनाख्येयं न मे किञ्चिदस्ति स्वस्त्यस्तु तेऽनघ ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002745018, "chapter_id": 22745, "verse_number": "९-३०-१९", "content_sanskrit": "अस्यां तिथौ क्षयमुपैति हुतं न दत्तं तेनाक्षया च मुनिभिः कथिता तृतीया ।\nउद्दिश्य यत्सुरपितॄन्क्रियते मनुष्यैस्तच्चाक्षयं भवति भारत सर्वमेव ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]