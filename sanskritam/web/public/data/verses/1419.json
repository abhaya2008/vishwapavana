[{"id": 2020036, "chapter_id": 1419, "verse_number": "३-५७-०x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2020037, "chapter_id": 1419, "verse_number": "३-५७-१", "content_sanskrit": "दमयन्ती ततो दृष्ट्वा पुण्यश्लोकं नराधिपम्।\nउन्मत्तवदनुन्मत्ता देवने कृतचेतसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2020038, "chapter_id": 1419, "verse_number": "३-५७-२", "content_sanskrit": "भयशोकसमाविष्टा राजन्भीमसुता ततः।\nचिन्तयामास तत्कार्यं सुमहत्पार्थिवं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2020039, "chapter_id": 1419, "verse_number": "३-५७-३", "content_sanskrit": "सा शङ्कमाना तत्पापं चिकीर्षन्ती च तत्प्रियम्।\nनलं च हृतसर्वस्वमुपलभ्येदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2020040, "chapter_id": 1419, "verse_number": "३-५७-४", "content_sanskrit": "बृहत्सेनामतियशां तां धात्रीं परिचारिकाम्।\nहितां सर्वार्थकुशलामनुरक्तां सुभाषिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2020041, "chapter_id": 1419, "verse_number": "३-५७-५", "content_sanskrit": "बृहन्सेने व्रजामात्यानानाय्य नलंशासनात्।\nआचक्ष्व यद्धृतं द्रव्यमवशिष्टं च यद्वसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2020042, "chapter_id": 1419, "verse_number": "३-५७-६", "content_sanskrit": "`इत्येवं सा समादिष्टा बृहत्सेना नरेश्वर।\nउवाच देव्या वचनं मन्त्रिणां सा समीपत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2020043, "chapter_id": 1419, "verse_number": "३-५७-७", "content_sanskrit": "ततस्ते मन्त्रिणः सर्वे विज्ञाय नलशासनम्।\nअपि नो भागधेयं स्यादित्युक्त्वा पुनराव्रजन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2020044, "chapter_id": 1419, "verse_number": "३-५७-८", "content_sanskrit": "तास्तु सर्वाः प्रकृतयो द्वितीयं समुपस्थिताः।\nन्यवेदयद्भीमसुता न च तत्प्रत्यनन्दत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2020045, "chapter_id": 1419, "verse_number": "३-५७-९", "content_sanskrit": "वाक्यमप्रतिनन्दन्तं भर्तारमभिवीक्ष्य सा।\nदमयन्ती पुनर्वेश्म व्रीडिता प्रविवेश ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2020046, "chapter_id": 1419, "verse_number": "३-५७-१०", "content_sanskrit": "निशाम्य सततं चाक्षान्पुण्यश्लोकपराङ्युखान्।\nनलं च हृतसर्वस्वं धात्रीं पुनरुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2020047, "chapter_id": 1419, "verse_number": "३-५७-११", "content_sanskrit": "बृहत्सेने पुनर्गच्छ वार्ष्णेयं नलशासनात्।\nसूतमानय कल्याणि महत्कार्यमुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2020048, "chapter_id": 1419, "verse_number": "३-५७-१२", "content_sanskrit": "बृहत्सेना तु सा श्रुत्वा दमयन्त्याः प्रभापितम्।\nवार्ष्णेयमानयामास पुरुषैराप्तकारिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2020049, "chapter_id": 1419, "verse_number": "३-५७-१३", "content_sanskrit": "वार्ष्णेयं तु ततो भैमी सान्त्वयच्छ्लक्ष्णया गिरा।\nउवाच देशकालज्ञा प्राप्तकालमनिन्दिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2020050, "chapter_id": 1419, "verse_number": "३-५७-१४", "content_sanskrit": "जानषे त्वं यथा राजा सम्यग्वृत्तः सदा त्वयि।\nतस्य त्वं विपमस्थस्य साहाय्यं कर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2020051, "chapter_id": 1419, "verse_number": "३-५७-१५", "content_sanskrit": "यथायथा हि नृपतिः पुष्करेणैव जीयते।\nतथातथाऽस्य वै द्यूते रागो भूयोऽभिवर्धते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2020052, "chapter_id": 1419, "verse_number": "३-५७-१६", "content_sanskrit": "यथा च पुष्करस्याक्षाः पतन्ति वशवर्तिनः।\nतथा विपर्ययश्चापि नलस्याक्षेषु दृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2020053, "chapter_id": 1419, "verse_number": "३-५७-१७", "content_sanskrit": "सुहृत्स्वजनवाक्यानि यथाऽयं न शृणोति च।\nममापि च तथा वाक्यं नाभिनन्दति नैषध ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2020054, "chapter_id": 1419, "verse_number": "३-५७-१८", "content_sanskrit": "यथा राज्ञः प्रदीप्तानां भाग्यानामद्य सारथे।\nनूनं मन्ये न शेषोस्ति नैषधस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2020055, "chapter_id": 1419, "verse_number": "३-५७-१९", "content_sanskrit": "यत्तु मे वचनं राजा नाभिनन्दति मोहितः।\nशरणं त्वां प्रपन्नाऽस्मि सारथे कुरु मद्वचः।\nन हि मे शुध्ते भावो विनाशं प्रति सारथे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2020056, "chapter_id": 1419, "verse_number": "३-५७-२०", "content_sanskrit": "नलस्य दयितानश्वान्योजयित्वा मनोजवान्।\nरथमारोप्य मिथुनं कुण्डिनं यातुर्महसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2020057, "chapter_id": 1419, "verse_number": "३-५७-२१", "content_sanskrit": "मम ज्ञातिषु निक्षिप्य दारकौ स्यन्दनं तथा।\nअश्वांश्चेमान्यथाकामं वस वाऽन्यत्र गच्छवा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2020058, "chapter_id": 1419, "verse_number": "३-५७-२२", "content_sanskrit": "दमयन्त्यास्तु तद्वाक्यं वार्ण्येयो नलसारथिः।\nन्यवेदयदशेषेण नलामात्येषु मुख्यशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2020059, "chapter_id": 1419, "verse_number": "३-५७-२३", "content_sanskrit": "तैः समेत्य विनिश्चित्य सोऽनुज्ञातो महीपते।\nययौ मिथुनमारोप्य विदर्भांस्तेन वाहिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2020060, "chapter_id": 1419, "verse_number": "३-५७-२४", "content_sanskrit": "हयांस्तत्र विनिक्षिप्य सूतो रथवरं च तम्।\nइन्द्रसेनां च तां कन्यामिन्द्रसेनं च बालकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2020061, "chapter_id": 1419, "verse_number": "३-५७-२५", "content_sanskrit": "आमन्त्र्य भीमं राजानमार्तः शोचन्नलं नृपम्।\nक्व नु यास्यामि मनसा चिन्तयानो मुहुर्मुहुः।\nअटमानस्ततोऽयोध्यां जगाम नगरीं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2020062, "chapter_id": 1419, "verse_number": "३-५७-२६", "content_sanskrit": "ऋतुपर्णं स राजानमुपतस्थे सुदुःखितः।\nभृतिं च स ददौ चास्य सारथ्येन नियोजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2020063, "chapter_id": 1419, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि नलोपाख्यानपर्वणि सप्तपञ्चाशोऽध्याः ॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]