[{"id": 2093976, "chapter_id": 3010, "verse_number": "१३-१४०-१", "content_sanskrit": "युधिष्ठिर उवाच।\nद्विजातयो व्रतोपेता हविस्ते यदि भुञ्जते।\nअन्नं ब्राह्मणकामाय कथमेतत्पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2093977, "chapter_id": 3010, "verse_number": "१३-१४०-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2093978, "chapter_id": 3010, "verse_number": "१३-१४०-२", "content_sanskrit": "अवेदोक्तव्रताश्चैव भुञ्जानाः कामकारणे।\nवेदोक्तेषु तु भुञ्जाना व्रतलुप्ता युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2093979, "chapter_id": 3010, "verse_number": "१३-१४०-३x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2093980, "chapter_id": 3010, "verse_number": "१३-१४०-३", "content_sanskrit": "यदिदं तप इत्याहुरुपवासं पृथग्जनाः।\nतपः स्यादेतदेवेह तपोऽन्यद्वाऽपि किं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2093981, "chapter_id": 3010, "verse_number": "१३-१४०-४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2093982, "chapter_id": 3010, "verse_number": "१३-१४०-४", "content_sanskrit": "मासार्धमासोपवासाद्यत्तपो मन्यते जनः।\nआत्मतन्त्रोपघाती यो न तपस्वी न धर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2093983, "chapter_id": 3010, "verse_number": "१३-१४०-५", "content_sanskrit": "त्यागस्य चापि सम्पत्तिः शिष्यते तप उत्तमम्।\nसदोपवासी च भवेद्ब्रह्मचारी तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2093984, "chapter_id": 3010, "verse_number": "१३-१४०-६", "content_sanskrit": "मुनिश्च स्यात्सदा विप्रो देवांश्चैव सदा यजेत्।\nकुटुम्बिको धर्मकामः सदाऽस्वप्नश्च मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2093985, "chapter_id": 3010, "verse_number": "१३-१४०-७", "content_sanskrit": "अमृताशी सदा च स्यात्पवित्रं च सदा पठेत्।\nऋतवादी सदा च स्यान्नियतश्च सदा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2093986, "chapter_id": 3010, "verse_number": "१३-१४०-८", "content_sanskrit": "विघसाशी कथं च स्यात्सदा चैवातिथिप्रियः।\nअमृताशी सदा च स्यात्पवित्री च सदा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2093987, "chapter_id": 3010, "verse_number": "१३-१४०-९x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2093988, "chapter_id": 3010, "verse_number": "१३-१४०-९", "content_sanskrit": "कथं सदोपवासी स्याद्ब्रह्मचारी च पार्थिव।\nविघसाशी कथं च स्यात्कथं चैवातिथिप्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2093989, "chapter_id": 3010, "verse_number": "१३-१४०-१०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2093990, "chapter_id": 3010, "verse_number": "१३-१४०-१०", "content_sanskrit": "अन्तरा सायमाशं च प्रातराशं च यो नरः।\nसदोपवासी भवति यो न भुङ्क्तेऽन्तरा पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2093991, "chapter_id": 3010, "verse_number": "१३-१४०-११", "content_sanskrit": "भार्या गच्छन्ब्रह्मचारी ऋतौ भवति चैव ह।\nऋतवादी सदा च स्याद्दानशीलस्तु मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2093992, "chapter_id": 3010, "verse_number": "१३-१४०-१२", "content_sanskrit": "अभक्षयन्वृथा मांसममांसाशी भवत्युत।\nदानं ददत्पवित्री स्यादस्वप्नश्च दिवाऽस्वपन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2093993, "chapter_id": 3010, "verse_number": "१३-१४०-१३", "content_sanskrit": "भृत्यातिथिषु यो भुङ्क्ते भुक्तवत्सु नरः सदा।\nअमृतं केवलं भुङ्क्ते इति विद्धि युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2093994, "chapter_id": 3010, "verse_number": "१३-१४०-१४", "content_sanskrit": "अभुक्तवत्सु नाश्नाति ब्राह्मणेषु तु यो नरः।\nअभोजनेन तेनास्य जितः स्वर्गो भवत्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2093995, "chapter_id": 3010, "verse_number": "१३-१४०-१५", "content_sanskrit": "देवेभ्यश्च पितृभ्यश्च संश्रितेभ्यस्तथैव च।\nअवशिष्टानि यो भुङ्क्ते तमाहुर्विघसाशिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2093996, "chapter_id": 3010, "verse_number": "१३-१४०-१६", "content_sanskrit": "तेषां लोका ह्यपर्यन्ताः सदने ब्रह्मणः स्मृताः।\nउपस्थिता ह्यप्सरसो गन्धर्वैश्च जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2093997, "chapter_id": 3010, "verse_number": "१३-१४०-१७", "content_sanskrit": "देवतातिथिभिः सार्धं पितृभिश्चोपभुञ्जते।\nरमन्ते पुत्रपौत्रैश्च तेषां गतिरनुत्तमा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2093998, "chapter_id": 3010, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि चत्वारिंशदधिकशततमोऽध्यायः॥ १४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]