[
  {
    "id": 20131515,
    "chapter_id": 7007,
    "verse_number": "25.1",
    "content_sanskrit": "पञ्चविंशो ऽध्यायः",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20131516,
    "chapter_id": 7007,
    "verse_number": "25.2",
    "content_sanskrit": "अङ्गाभिनयस्यैव यो विशेषः क्वचित् क्वचित् । अनुक्त उच्यते चित्रः चित्राभिनयस्स्मृतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20131517,
    "chapter_id": 7007,
    "verse_number": "25.3",
    "content_sanskrit": "उत्तानौ तु करौ कृत्वा स्वस्तिकौ पार्श्वसंस्थितौ । उद्वाहितेन शिरसा तथा चोर्ध्वनिरीक्षणात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20131518,
    "chapter_id": 7007,
    "verse_number": "25.4",
    "content_sanskrit": "प्रभातं गगनं रात्रिः प्रदोषं दिवसं तथा । ऋतून् घनान् वनान्तांश्च विस्तीर्णांश्च जलाशयान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20131519,
    "chapter_id": 7007,
    "verse_number": "25.5",
    "content_sanskrit": "दिशो ग्रहान् सनक्षत्रान् किञ्चित् स्वस्थं च यद्भवेत् । तस्य त्वभिनयः कार्यो नानादृष्टिसमन्वितः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20131520,
    "chapter_id": 7007,
    "verse_number": "25.6",
    "content_sanskrit": "एभिरेव करैर्भूयस्तेनैव शिरसा पुनः । अधो निरीक्षणेनाथ भूमिस्थान् संप्रदर्शयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20131521,
    "chapter_id": 7007,
    "verse_number": "25.7",
    "content_sanskrit": "स्पर्शस्य ग्रहणेनैव तथोल्लुकसनेन च । चन्द्रज्योस्त्नां सुखं वायुं रसं गन्धं च निर्दिशेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20131522,
    "chapter_id": 7007,
    "verse_number": "25.8",
    "content_sanskrit": "वस्त्रावकुण्ठनात्सूर्यं रजोधूमानिलांस्तथा । भूमितापमथोष्णं च कुर्याच्छायाभिलाषतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20131523,
    "chapter_id": 7007,
    "verse_number": "25.9",
    "content_sanskrit": "ऊर्ध्वाकेकरदृष्टिस्तु मध्याह्ने सूर्यमादिशेत् । उदयास्तगतं चैव विस्मयार्थैः प्रदर्शयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20131524,
    "chapter_id": 7007,
    "verse_number": "25.10",
    "content_sanskrit": "यानि सौम्यार्थयुक्तानि सुस्वभावकृतानि च । गात्रस्पर्शैस्सरोमाञ्चैस्तेषामभिनयो भवेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20131525,
    "chapter_id": 7007,
    "verse_number": "25.11",
    "content_sanskrit": "यानि स्युस्तीक्ष्णरूपाणि तानि चाभिनयेत्सुधीः । असंस्पर्शैस्तथोद्वेगैस्तथा मुखविकुण्ठनैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20131526,
    "chapter_id": 7007,
    "verse_number": "25.12",
    "content_sanskrit": "गम्भीरोदातसंयुक्तानर्थानभिनयेद्बुधः । साटोपैश्च सगर्वैश्च गात्रैः सौष्ठवसंयुतैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20131527,
    "chapter_id": 7007,
    "verse_number": "25.13",
    "content_sanskrit": "यज्ञोपवीतदेशस्थमरालं हासमादिशेत् । स्वस्तिकौ विच्युतौ हारस्रग्दामार्थान् निदर्शयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20131528,
    "chapter_id": 7007,
    "verse_number": "25.14",
    "content_sanskrit": "भ्रमणेन प्रदर्शिन्या दृष्टेः परिगमेन च । अलपद्मकपीडायाः सर्वार्थग्रहणं भवेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20131529,
    "chapter_id": 7007,
    "verse_number": "25.15",
    "content_sanskrit": "श्रव्यं श्रवणयोगेन दृश्यं दृष्टिविलोकनैः । आत्मस्थं परसंस्थं वा मध्यस्थं वा विनिर्दिशेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20131530,
    "chapter_id": 7007,
    "verse_number": "25.16",
    "content_sanskrit": "विद्युदुल्काघनरवाविष्फुलिंगार्चिषस्तथा । त्रस्तांगाक्षिनिमेषैश्च ते ऽभिनेयाः प्रयोक्तृभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20131531,
    "chapter_id": 7007,
    "verse_number": "25.17",
    "content_sanskrit": "उद्वेष्टितकरावृत्तौ करौ कृत्वा नतं शिरः । असंस्पर्शे तथानिष्टे जिह्मदृष्टेन कारयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20131532,
    "chapter_id": 7007,
    "verse_number": "25.18",
    "content_sanskrit": "वायुमुष्णं तमस्तेजो मुखप्रच्छादनेन च । रेणुतोयपतंगांश्च भ्रमरांश्च निवारयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20131533,
    "chapter_id": 7007,
    "verse_number": "25.19",
    "content_sanskrit": "कृत्वा स्वस्तिकसंस्थानौ पद्मकोशावधोमुखौ । सिअंहर्क्षवानरव्याघ्रश्वापदांश्च निरूपयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20131534,
    "chapter_id": 7007,
    "verse_number": "25.20",
    "content_sanskrit": "स्वस्तिकौ त्रिपताकौ तु गुरूणां पादवन्दने । खटकस्वस्थिकौ चापि प्रतोदग्रहणे स्मृतौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20131535,
    "chapter_id": 7007,
    "verse_number": "25.21",
    "content_sanskrit": "एकं द्वि त्रीणि चत्वारि पञ्च षट् सप्त चाष्टधा । नव वा दश वापि स्युर्गणनांगुलिभिर्भवेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20131536,
    "chapter_id": 7007,
    "verse_number": "25.22",
    "content_sanskrit": "दशाख्याश्च शताख्याश्च सहस्राख्यास्तथैव च । पताकाभ्यां तु हस्ताभ्यां प्रयोज्यास्ताः प्रयोक्तृभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20131537,
    "chapter_id": 7007,
    "verse_number": "25.23",
    "content_sanskrit": "दशाख्यगणनायास्तु परतो या भवेदिह । वाक्यार्थेनैव साध्यासौ परोक्षाभिनयेन च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20131538,
    "chapter_id": 7007,
    "verse_number": "25.24",
    "content_sanskrit": "छत्रध्वजपताकाश्च निर्देश्या दण्डधारणात् । नानाप्रहरणं चाथ निर्देश्यं धारणाश्रयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20131539,
    "chapter_id": 7007,
    "verse_number": "25.25",
    "content_sanskrit": "एकचित्तो ह्यधोदृष्टिः किञ्चिन्नतशिरास्तथा । सव्यहस्तश्च संदंशः स्मृते ध्याने वितर्किते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20131540,
    "chapter_id": 7007,
    "verse_number": "25.26",
    "content_sanskrit": "उद्वाहितं शिरः कृत्वा हंसपक्षौ प्रदक्षिणौ । अपत्यरूपणे कार्यावुछ्रयौ च प्रयोक्तृभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20131541,
    "chapter_id": 7007,
    "verse_number": "25.27",
    "content_sanskrit": "उद्वाहितं शिरः कृत्वा हंसवक्त्रं तथोर्ध्वगम् । प्रसादयच्च यं मानं दीर्घसत्वं च निर्दिशेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20131542,
    "chapter_id": 7007,
    "verse_number": "25.28",
    "content_sanskrit": "अरालं च शिरस्थाने समुद्वाह्य तु वामकम् । गते निर्वृत्ते ध्वस्ते च श्रान्तवाक्ये च योजयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20131543,
    "chapter_id": 7007,
    "verse_number": "25.29",
    "content_sanskrit": "सर्वेन्द्रियस्वस्थतया प्रसन्नवदनस्तथा । विचित्रभूतलालोकैः शरदन्तु विनिर्दिशेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20131544,
    "chapter_id": 7007,
    "verse_number": "25.30",
    "content_sanskrit": "गात्रसंकोचनाच्चापि सूर्याग्निपटुसेवनात् । हेमन्तस्त्वभिनेतव्यः पुरुषैर्मध्यमाधमैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20131545,
    "chapter_id": 7007,
    "verse_number": "25.31",
    "content_sanskrit": "शिरोदन्तोष्ठकम्पेन गात्रसंकोचनेन च । कूजितैश्च सशीत्कारैरधमश्शीतमादिशेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20131546,
    "chapter_id": 7007,
    "verse_number": "25.32",
    "content_sanskrit": "अवस्थान्तरमासाद्य कदाचित्तूत्तमरैरपि । शीताभिनयनं कूर्याद्देवाद्व्यसनसंभवम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20131547,
    "chapter_id": 7007,
    "verse_number": "25.33",
    "content_sanskrit": "ऋतुजानां तु पुष्पाणां गन्धघ्राणैस्तथैव च । रूक्षस्य वायोः स्पर्शाच्च शिशिरं रूपयेद्बुधः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20131548,
    "chapter_id": 7007,
    "verse_number": "25.34",
    "content_sanskrit": "प्रमोदजननारंभैरुपभोगैः पृथग्विधिः । वसन्तस्त्वभिनेतव्यो नानापुष्पप्रदर्शनात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20131549,
    "chapter_id": 7007,
    "verse_number": "25.35",
    "content_sanskrit": "स्वेद प्रमार्जनैश्चैव भूमितापैः सवीजनैः । उष्णस्य वायोः स्पर्शेन ग्रीष्मं त्वभिनयेद्बुधः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20131550,
    "chapter_id": 7007,
    "verse_number": "25.36",
    "content_sanskrit": "कदम्बनीपकुटपैः शाद्वलैः सेन्द्रगोपकैः । मेघवातैः सुखस्पर्शैः प्रावृट्कालं प्रदर्शयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20131551,
    "chapter_id": 7007,
    "verse_number": "25.37",
    "content_sanskrit": "मेघौघनादैर्गम्भीरैर्धाराप्रपतनैस्तदा । विद्युन्निर्घातघोषैश्च वर्षारात्रं समादिशेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20131552,
    "chapter_id": 7007,
    "verse_number": "25.38",
    "content_sanskrit": "यद्यस्य चिह्नं वेषो वा कर्म वा रूपमेव वा । निर्देश्यः स ऋतुस्तेन इष्टानिष्टार्थदर्शनात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20131553,
    "chapter_id": 7007,
    "verse_number": "25.39",
    "content_sanskrit": "एतानृतूनर्थवशाद्दर्शयेद्धि रसानुगान् । सुखिनस्तु सुखोपेतान् सुःखार्थान् दुःखसंयुतान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20131554,
    "chapter_id": 7007,
    "verse_number": "25.40",
    "content_sanskrit": "यो येन भावेनाविष्टः सुखदेनेतरेअन वा । स तदाहितसंकारः सर्वं पश्यति तन्मयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20131555,
    "chapter_id": 7007,
    "verse_number": "25.41",
    "content_sanskrit": "भावाभिनयनं कुर्याद्विभावानां निदर्शनैः । तथैव चानुभावानां भावसिद्धिः प्रवर्तिता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20131556,
    "chapter_id": 7007,
    "verse_number": "25.42",
    "content_sanskrit": "विभावेनाहृतं कार्यमनुभावेन नीयते । आत्मानुभवनं भावो विभावः परदर्शनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20131557,
    "chapter_id": 7007,
    "verse_number": "25.43",
    "content_sanskrit": "गुरुर्मित्रं सखा स्निग्धः संबन्धी बन्धुरेव वा । आवेद्यते हि यः प्राप्तः स विभाव इति स्मृतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20131558,
    "chapter_id": 7007,
    "verse_number": "25.44",
    "content_sanskrit": "यत्त्वस्य संभ्रमोत्थानैरर्घ्यपाद्यासनादिभिः । पूजनं क्रियते भक्त्या सो ऽनुभावः प्रकीर्तितः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20131559,
    "chapter_id": 7007,
    "verse_number": "25.45",
    "content_sanskrit": "एवमन्येष्वपि ज्ञेयो नानाकार्यप्रदर्शनात् । विभावो वापि भावो वा विज्ञेयो ऽर्थवशाद्बुधैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20131560,
    "chapter_id": 7007,
    "verse_number": "25.46",
    "content_sanskrit": "यस्त्वपि प्रतिसंदेशो दूतस्येह प्रदीयते । सो ऽनुभाव इति ज्ञेयः प्रतिसन्देशदर्शितः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20131561,
    "chapter_id": 7007,
    "verse_number": "25.47",
    "content_sanskrit": "एवं भावो विभावो वाप्यनुभावश्च कीर्तितः । पुरुषैरभिनेयः स्यात्प्रमदाभिरथापि वा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20131562,
    "chapter_id": 7007,
    "verse_number": "25.48",
    "content_sanskrit": "स्वभावाभिनये स्थानं पुंसां कार्यं तु वैष्णवम् । आयतं वावहित्थं वा स्त्रीणां कार्यं स्वभावतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20131563,
    "chapter_id": 7007,
    "verse_number": "25.49",
    "content_sanskrit": "प्रयोजनवशाच्चैव शेषाण्यपि भवन्ति हि । नानाभवाभिनयनैः प्रयोगैश्च पृथग्विधैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20131564,
    "chapter_id": 7007,
    "verse_number": "25.50",
    "content_sanskrit": "धैर्यलीलाङ्गसंपन्नं पुरुषाणां विचेष्टितम् । मृदुलीलाङ्गहारैश्च स्त्रीणां कार्यं तु चेष्टितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20131565,
    "chapter_id": 7007,
    "verse_number": "25.51",
    "content_sanskrit": "करपादाङ्गसञ्चारास्स्त्रीणां तु ललिताः स्मृताः । सुधीरश्चोद्धतश्चैव पुरुषाणां प्रयोक्तृभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20131566,
    "chapter_id": 7007,
    "verse_number": "25.52",
    "content_sanskrit": "यथा रसं यथा भावं स्त्रीणां भावप्रदर्शनम् । नराणां प्रमदानां च भावाभिनयनं पृथक् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20131567,
    "chapter_id": 7007,
    "verse_number": "25.53",
    "content_sanskrit": "भावानुभावनं युक्तं व्याख्यास्याम्यनुपूर्वशः । आलिङ्गनेन गात्राणां सस्मितेन च चक्षुषा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20131568,
    "chapter_id": 7007,
    "verse_number": "25.54",
    "content_sanskrit": "तथोल्लुकसानच्चापि हर्षं संदर्शयेन्नरः । क्षिप्रस!न्जातरोमाञ्चात् बाष्पेणावृतलोचना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20131569,
    "chapter_id": 7007,
    "verse_number": "25.55",
    "content_sanskrit": "कुर्वीत नर्तकी हर्षं प्रीत्या वाक्यैश्च सस्मितैः । उद्वृत्तरक्तनेत्रश्च सन्दष्टाधर एव च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20131570,
    "chapter_id": 7007,
    "verse_number": "25.56",
    "content_sanskrit": "निश्वासकंपितांगश्च क्रोधं चाभिनयेन्नरः । नेत्राभ्यां बाष्पपूर्णाभ्यां चिबुकौष्ठप्रकंपनात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20131571,
    "chapter_id": 7007,
    "verse_number": "25.57",
    "content_sanskrit": "शिरसः कंपनाच्चैव भ्रुकुटीकरणेन च । मौनेनाङ्गुलिभङ्गेन माल्याभरणवर्जनात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20131572,
    "chapter_id": 7007,
    "verse_number": "25.58",
    "content_sanskrit": "आयतकस्थानकक्षाया ईर्ष्या क्रोधे भवेत्स्त्रियाः । निश्वासोच्छ्वासबहुलैरधोमुखविचिन्तनैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20131573,
    "chapter_id": 7007,
    "verse_number": "25.59",
    "content_sanskrit": "आकाशवचनाच्चापि दुःखं पुंसां तु योजयेत् । रुदितैः श्वसितैश्चैव शिरोभिहननेन च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20131574,
    "chapter_id": 7007,
    "verse_number": "25.60",
    "content_sanskrit": "भूमिपाताभिघातैश्च दुःखं स्त्रीषु प्रयोजयेत् । आनन्दजं चार्तिजं वा ईर्ष्यासंभूतमेव वा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20131575,
    "chapter_id": 7007,
    "verse_number": "25.61",
    "content_sanskrit": "यत्पूर्वमुक्तं रुदितं तत्स्त्रीनीचेषु योजयेत् । संभ्रमावेगचेष्टाभिश्शस्त्रसंपातनेन च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20131576,
    "chapter_id": 7007,
    "verse_number": "25.62",
    "content_sanskrit": "पुरुषाणां भयं कार्यं धैर्यावेगबलादिभिः । चलतारकनेत्रत्वाद्गात्रैः स्फुरितकम्पितैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20131577,
    "chapter_id": 7007,
    "verse_number": "25.63",
    "content_sanskrit": "सन्त्रस्तहृदयत्वाच्च पार्श्वाभ्यामवलोकनैः । भर्तृरन्वेषणाच्चैवमुच्चैराक्रन्दनादपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20131578,
    "chapter_id": 7007,
    "verse_number": "25.64",
    "content_sanskrit": "प्रियस्यालिंगनाच्चैव भयं कार्यं भवेत्स्त्रियाः । मदा ये ऽभिहिताः पूर्वं ते स्त्रीनीचेषु योजयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20131579,
    "chapter_id": 7007,
    "verse_number": "25.65",
    "content_sanskrit": "मृदुभिः स्खलितैर्नित्यमाकाशस्यावलंबनात् । नेत्रावघूर्णनैश्चैव सालस्यैः कथितैस्तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20131580,
    "chapter_id": 7007,
    "verse_number": "25.66",
    "content_sanskrit": "गात्राणां कंपनैश्चैव मदः कार्यो भवेत्स्त्रियाः । अनेन विधिना कार्यः प्रयोगाः कारणोत्थिताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20131581,
    "chapter_id": 7007,
    "verse_number": "25.67",
    "content_sanskrit": "पौरुषः स्त्रीकृतो वापि भावा ह्यभिनयं प्रति । सर्वे सललिता भावास्स्त्रीभिः कार्याः प्रयत्नतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "avatarnika": ""
  },
  {
    "id": 20131582,
    "chapter_id": 7007,
    "verse_number": "25.68",
    "content_sanskrit": "धैर्यमाधुर्यसंपन्ना भावाः कार्यास्तु पौरुषाः । त्रिपताकाङ्गुलीभ्यां तु वलिताभ्यां प्रयोजयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "avatarnika": ""
  },
  {
    "id": 20131583,
    "chapter_id": 7007,
    "verse_number": "25.69",
    "content_sanskrit": "शुकाश्च सारिकाश्चैव सूक्ष्मा ये चापि पक्षिणः । शिखिसारसहंसाद्याः स्थूला ये ऽपि स्वभावतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "avatarnika": ""
  },
  {
    "id": 20131584,
    "chapter_id": 7007,
    "verse_number": "25.70",
    "content_sanskrit": "रेचकैरङ्गहारैश्च तेषामभिनयो भवेत् । खरोष्ट्राश्वतरासिंहव्याघ्रगोमहिषादय ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "avatarnika": ""
  },
  {
    "id": 20131585,
    "chapter_id": 7007,
    "verse_number": "25.71",
    "content_sanskrit": "गतिप्रचरैरङ्गैश्च ते ऽभिनेयाः प्रयोक्तृभिः । भूताः पिशाचा यक्षाश्च दानवाः सहराक्षसैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "avatarnika": ""
  },
  {
    "id": 20131586,
    "chapter_id": 7007,
    "verse_number": "25.72",
    "content_sanskrit": "अङ्गहारैरविनिर्देश्या नामसंकीर्तनादपि । अङ्गहारैर्विनिर्देश्या अप्रत्यक्षा भवन्ति ये ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "avatarnika": ""
  },
  {
    "id": 20131587,
    "chapter_id": 7007,
    "verse_number": "25.73",
    "content_sanskrit": "प्रत्यक्षास्त्वभिनेतव्या भयोद्वेगैः सविस्मयैः । देवाश्च चिह्नैश्च प्रणामकरणैर्भावैश्च विचेष्टितैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 73,
    "avatarnika": ""
  },
  {
    "id": 20131588,
    "chapter_id": 7007,
    "verse_number": "25.74",
    "content_sanskrit": "अभिनेयो ह्यर्थवशादप्रत्यक्षाः प्रयोगज्ञैः । सव्योत्थितेन हस्तेन ह्यरालेन शिरः स्पृशेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74,
    "avatarnika": ""
  },
  {
    "id": 20131589,
    "chapter_id": 7007,
    "verse_number": "25.75",
    "content_sanskrit": "नरे ऽह्यभिवादनं ह्येतदप्रत्यक्षे विधीयते । खटकावर्धमानेन कपोताख्येन वा पुनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 75,
    "avatarnika": ""
  },
  {
    "id": 20131590,
    "chapter_id": 7007,
    "verse_number": "25.76",
    "content_sanskrit": "दैवतानि गुरूंश्चैव प्रमदाश्चाभिवादयेत् । दिवौकसश्च ये पूज्याः प्रत्यक्षाश्च भवन्ति ये ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 76,
    "avatarnika": ""
  },
  {
    "id": 20131591,
    "chapter_id": 7007,
    "verse_number": "25.77",
    "content_sanskrit": "तान् प्रमाणैः प्रभावैश्च गंभीरार्थैश्च योजयेत् । महाजनं सखीवर्गं विटधूर्तजनं तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 77,
    "avatarnika": ""
  },
  {
    "id": 20131592,
    "chapter_id": 7007,
    "verse_number": "25.78",
    "content_sanskrit": "परिमण्डलसंस्थेन हस्तेनाभिनयेनन्नरः । पर्वतान् प्रांशुयोगेन वृक्षांश्चैव समुच्छ्रितान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 78,
    "avatarnika": ""
  },
  {
    "id": 20131593,
    "chapter_id": 7007,
    "verse_number": "25.79",
    "content_sanskrit": "प्रसारिताभ्यां बाहुभ्यामुत्क्षिप्ताभ्यां प्रयोजयेत् । समूहसागरं सेना बहुविस्तीर्णमेव च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 79,
    "avatarnika": ""
  },
  {
    "id": 20131594,
    "chapter_id": 7007,
    "verse_number": "25.80",
    "content_sanskrit": "पताकाभ्यां तु हस्ताभ्यामुत्क्षिप्ताभ्यां प्रदर्शयेत् । शौर्यं धैर्यं च गर्वं च दर्पमौदार्यमुच्छ्रयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 80,
    "avatarnika": ""
  },
  {
    "id": 20131595,
    "chapter_id": 7007,
    "verse_number": "25.81",
    "content_sanskrit": "ललाटदेशस्थानेन त्वरालेनाभिदर्शयेत् । वक्षोदेशादपाविद्धौ करौ तु मृगशीर्षकौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 81,
    "avatarnika": ""
  },
  {
    "id": 20131596,
    "chapter_id": 7007,
    "verse_number": "25.82",
    "content_sanskrit": "विस्तीर्णप्रद्रुतोत्क्षेपौ योज्यौ यस्यादपावृतम् । अधोमुखोत्तानतलौ हस्तौ किञ्चित्प्रसारितौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 82,
    "avatarnika": ""
  },
  {
    "id": 20131597,
    "chapter_id": 7007,
    "verse_number": "25.83",
    "content_sanskrit": "कृत्वा त्वभिनयेद्वेलां बिलद्वारं गृहं गुहान् । कामं शापग्रहग्रस्तान् ज्वरोपहतचेतसः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 83,
    "avatarnika": ""
  },
  {
    "id": 20131598,
    "chapter_id": 7007,
    "verse_number": "25.84",
    "content_sanskrit": "एतेषां चेष्टितं कुर्यादङ्गाद्यैः सदृशैर्बुधैः । दोलाभिनयनं कुर्याद्दोलायास्तु विलोकनैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 84,
    "avatarnika": ""
  },
  {
    "id": 20131599,
    "chapter_id": 7007,
    "verse_number": "25.85",
    "content_sanskrit": "संभोक्षेण च गात्राणां रज्वश्वाग्रहणेन च । यदा चाङ्गवती डोला प्रत्यक्षा पुस्तजा भवेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 85,
    "avatarnika": ""
  },
  {
    "id": 20131600,
    "chapter_id": 7007,
    "verse_number": "25.86",
    "content_sanskrit": "आसनेषु प्रविष्टानां कर्तव्यं तत्र डोलनम् । आकाशवचनानीह वक्ष्याम्यात्मगतानि च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 86,
    "avatarnika": ""
  },
  {
    "id": 20131601,
    "chapter_id": 7007,
    "verse_number": "25.87",
    "content_sanskrit": "अपवारितकं चैव जनान्तिकमथापि च । दूरस्थाभाषणं यत्स्यादशरीरनिवेदनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 87,
    "avatarnika": ""
  },
  {
    "id": 20131602,
    "chapter_id": 7007,
    "verse_number": "25.88",
    "content_sanskrit": "परोक्षान्तरितं वाक्यमाकाशवचनं तु तत् । तत्रोत्तरकृतैर्वाक्यैः संलापं संप्रयोजयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 88,
    "avatarnika": ""
  },
  {
    "id": 20131603,
    "chapter_id": 7007,
    "verse_number": "25.89",
    "content_sanskrit": "नानाकारणसंयुक्तैः काव्यभावसमुत्थितैः । हृदयस्य वचो यत्तू तदात्मगतमीष्यते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 89,
    "avatarnika": ""
  },
  {
    "id": 20131604,
    "chapter_id": 7007,
    "verse_number": "25.90",
    "content_sanskrit": "सवितर्कं च तद्योज्यं प्रायशो नाटकादिषु । निगूढभावसंयुक्तमपवारितकं स्मृतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 90,
    "avatarnika": ""
  },
  {
    "id": 20131605,
    "chapter_id": 7007,
    "verse_number": "25.91",
    "content_sanskrit": "कार्यवशादश्रवणं पार्श्वगतैर्यज्जनान्तिकं तत्स्यात् । हृदयस्थं सविकल्पं भावस्थं चात्मगतमेव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 91,
    "avatarnika": ""
  },
  {
    "id": 20131606,
    "chapter_id": 7007,
    "verse_number": "25.92",
    "content_sanskrit": "इति गूढार्थयुक्तानि वचनानीह नाटके । जनान्तिकानि कर्णे तु तानि योज्यानि योक्तृभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 92,
    "avatarnika": ""
  },
  {
    "id": 20131607,
    "chapter_id": 7007,
    "verse_number": "25.93",
    "content_sanskrit": "पूर्ववृत्तं तु यत्कार्यं भूयः कथ्यं तु कारणात् । कर्णप्रदेशे तद्वाच्यं मागात्तत्पुनरुक्तताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 93,
    "avatarnika": ""
  },
  {
    "id": 20131608,
    "chapter_id": 7007,
    "verse_number": "25.94",
    "content_sanskrit": "अव्यभिचारेण पठेदाकाशजनान्तिकात्मगतपाठ्यम् । प्रत्यक्षपरोक्षकृतानामात्मसमुत्थान् परकृतांश्च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 94,
    "avatarnika": ""
  },
  {
    "id": 20131609,
    "chapter_id": 7007,
    "verse_number": "25.95",
    "content_sanskrit": "हस्तमन्तरितं कृत्वा त्रिपताकं प्रयोक्तृभिः । जनान्तिकं प्रयोक्तव्यमपवारितकं तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 95,
    "avatarnika": ""
  },
  {
    "id": 20131610,
    "chapter_id": 7007,
    "verse_number": "25.96",
    "content_sanskrit": "स्वप्नायितवाक्यार्थैस्त्वभिनेयो न खलु हस्तसंचारैः । सुप्ताभिहितैरेव तु वाक्यार्थैः सो ऽभिनेयः स्यात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 96,
    "avatarnika": ""
  },
  {
    "id": 20131611,
    "chapter_id": 7007,
    "verse_number": "25.97",
    "content_sanskrit": "मन्दस्वरसञ्चारैर्व्यक्ताव्यक्तं पुनरुक्तवचनार्थम् । पूर्वानुस्मरणकृतं कार्यं स्वप्नाञ्चिते पाठ्यम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 97,
    "avatarnika": ""
  },
  {
    "id": 20131612,
    "chapter_id": 7007,
    "verse_number": "25.98",
    "content_sanskrit": "प्रशिथिलगुरुकरुणाक्षरघण्टानुस्वरितवाक्यगद्गदजैः । हिक्काश्वसोपेतां काकुं कुर्यान्मरणकाले ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 98,
    "avatarnika": ""
  },
  {
    "id": 20131613,
    "chapter_id": 7007,
    "verse_number": "25.99",
    "content_sanskrit": "हिक्काश्वासोपेतां मूर्च्छोपगमे मरणवत्कथयेत् । अतिमत्तेष्वपि कार्यं तद्वत्स्वप्नायिते यथा पाठ्यम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 99,
    "avatarnika": ""
  },
  {
    "id": 20131614,
    "chapter_id": 7007,
    "verse_number": "25.100",
    "content_sanskrit": "वृद्धानां योजयेत्पाठ्यं गद्गदस्खलिताक्षरम् । असमाप्ताक्षरं चैव बालानां तु कलस्वनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 100,
    "avatarnika": ""
  },
  {
    "id": 20131615,
    "chapter_id": 7007,
    "verse_number": "25.101",
    "content_sanskrit": "नानाभावोपगतं मरणाभिनये बहुकीर्तितं तु । विक्षिप्तहस्तपादैर्निभृतैः सन्नैस्तथा कार्यम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 101,
    "avatarnika": ""
  },
  {
    "id": 20131616,
    "chapter_id": 7007,
    "verse_number": "25.102",
    "content_sanskrit": "व्याधिप्लुते च मरणं निषण्णगात्रैस्तु संप्रयोक्तव्यम् । हिक्काश्वासोपेतं तथा पराधीनगात्रसंचारम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 102,
    "avatarnika": ""
  },
  {
    "id": 20131617,
    "chapter_id": 7007,
    "verse_number": "25.103",
    "content_sanskrit": "विषपीते ऽपि च मरणं कार्यं विक्षिप्तगात्रकरचरणम् । विषवेगसंप्रयुक्तं विस्फुरितांगक्रियोपेतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 103,
    "avatarnika": ""
  },
  {
    "id": 20131618,
    "chapter_id": 7007,
    "verse_number": "25.104",
    "content_sanskrit": "प्रथेमे वेगे कार्श्यं त्वभिनेये वेपथुर्द्वितीये तु । दाहस्तथा तृतीये विलल्लिका स्याच्चतुर्थे तु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 104,
    "avatarnika": ""
  },
  {
    "id": 20131619,
    "chapter_id": 7007,
    "verse_number": "25.105",
    "content_sanskrit": "फेनस्तु पञ्चमस्थे तु ग्रीवा षष्ठे तु भज्यते । जडता सप्तमे तु स्यान्मरणं त्वष्टमे भवेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 105,
    "avatarnika": ""
  },
  {
    "id": 20131620,
    "chapter_id": 7007,
    "verse_number": "25.106",
    "content_sanskrit": "तत्र प्रथमवेगे तु क्षामवक्रकपोलता । कृशत्वे ऽभिनयः कार्यो वाक्यानामल्पभाषणम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 106,
    "avatarnika": ""
  },
  {
    "id": 20131621,
    "chapter_id": 7007,
    "verse_number": "25.107",
    "content_sanskrit": "सर्वाङ्गवेपथुं च कण्डूयनं तथाङ्गानाम् । विक्षिप्तहस्तगात्रं दाहं चैवाप्यभिनयेत्तु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 107,
    "avatarnika": ""
  },
  {
    "id": 20131622,
    "chapter_id": 7007,
    "verse_number": "25.108",
    "content_sanskrit": "उद्वृत्तनिमेषत्वादुद्गारच्छर्दनैस्तथाक्षेपैः । अव्यक्ताक्षरकथनैः विलल्लिकामभिनयेदेवम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 108,
    "avatarnika": ""
  },
  {
    "id": 20131623,
    "chapter_id": 7007,
    "verse_number": "25.109",
    "content_sanskrit": "उद्गारवमनयोगैः शिरसश्च विलोलनैरनेकविधैः । फेनस्त्वभिनेतव्यो निःसंज्ञतया निमेषैश्च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 109,
    "avatarnika": ""
  },
  {
    "id": 20131624,
    "chapter_id": 7007,
    "verse_number": "25.110",
    "content_sanskrit": "अंसकपोलस्पर्शः शिरसो ऽथ विनामनं शिरो ऽपाङ्गः । सर्वेन्द्रिअयसंमोहाज्जडतामेवं त्वभिनयेत्तु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 110,
    "avatarnika": ""
  },
  {
    "id": 20131625,
    "chapter_id": 7007,
    "verse_number": "25.111",
    "content_sanskrit": "संमीलितनेत्रत्वात् व्याधिविवृद्धौ भुजङ्गदशनाद्वा । एवं हि नाट्यधर्मे मरणानि बुधैः प्रयोज्यानि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 111,
    "avatarnika": ""
  },
  {
    "id": 20131626,
    "chapter_id": 7007,
    "verse_number": "25.112",
    "content_sanskrit": "संभ्रमेष्वथ रोषेषु शोकावेशकृतेषु च । यानि वाक्यानि युज्यन्ते पुनरुक्तं न तेष्विह ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 112,
    "avatarnika": ""
  },
  {
    "id": 20131627,
    "chapter_id": 7007,
    "verse_number": "25.113",
    "content_sanskrit": "साध्वहो मां च हेहेति किं त्वं मामावदेति च । एवंविधानि कार्याणि द्वित्रिसंख्यानि कारयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 113,
    "avatarnika": ""
  },
  {
    "id": 20131628,
    "chapter_id": 7007,
    "verse_number": "25.114",
    "content_sanskrit": "प्रत्यङ्गहीनं यत्काव्यं विकृतं च प्रयुज्यते । न लक्षणकृतस्तत्र कार्यस्त्वभिनयो बुधैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 114,
    "avatarnika": ""
  },
  {
    "id": 20131629,
    "chapter_id": 7007,
    "verse_number": "25.115",
    "content_sanskrit": "भावो यत्रोत्तमानां तु न तं मध्येषु योजयेत् । यो भावश्चैव मध्यानां न ते नीचेषु योजयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 115,
    "avatarnika": ""
  },
  {
    "id": 20131630,
    "chapter_id": 7007,
    "verse_number": "25.116",
    "content_sanskrit": "पृथक् पृथग्भावरसैरात्मचेष्टासमुत्थितैः । ज्येष्ठमध्यमनीचेषु नाट्यं रागं हि गच्छति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 116,
    "avatarnika": ""
  },
  {
    "id": 20131631,
    "chapter_id": 7007,
    "verse_number": "25.117",
    "content_sanskrit": "एते ऽभिनयविशेषाः कर्तव्याः सत्त्वभावसंयुक्ताः । अन्ये तु लौकिका ये तु ते सर्वे लोकवत्कार्याः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 117,
    "avatarnika": ""
  },
  {
    "id": 20131632,
    "chapter_id": 7007,
    "verse_number": "25.118",
    "content_sanskrit": "नानाविधैर्यथा पुष्पैर्मालां ग्रथ्नाति माल्यकृत् । अंगोपांगै रसैर्भावैस्तथा नाट्यं प्रयोजयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 118,
    "avatarnika": ""
  },
  {
    "id": 20131633,
    "chapter_id": 7007,
    "verse_number": "25.119",
    "content_sanskrit": "या यस्य लीला नियता गतिश्च रङ्गप्रविष्टस्य निधानयुक्तः । तामेव कुर्यादविमुक्तसत्त्वो यावन्नरङ्गात्प्रतिनिर्वृतः स्यात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 119,
    "avatarnika": ""
  },
  {
    "id": 20131634,
    "chapter_id": 7007,
    "verse_number": "25.120",
    "content_sanskrit": "एवमेते मया प्रोक्ता नाट्ये चाभिनयाः क्रमात् । अन्ये तु लौकिका ये ते लोकाद्ग्राह्याः सदा बुधैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 120,
    "avatarnika": ""
  },
  {
    "id": 20131635,
    "chapter_id": 7007,
    "verse_number": "25.121",
    "content_sanskrit": "लोको वेदस्तथाध्यात्मं प्रमाणं त्रिविधं स्मृतम् । वेदाध्यात्मपदार्थेषु प्रायो नाट्यं प्रतिष्ठितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 121,
    "avatarnika": ""
  },
  {
    "id": 20131636,
    "chapter_id": 7007,
    "verse_number": "25.122",
    "content_sanskrit": "वेदाध्यात्मोपपन्नं तु शब्दच्छन्दस्समन्वितम् । लोकसिद्धं भवेत्सिद्धं नाट्यं लोकात्मकं तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 122,
    "avatarnika": ""
  },
  {
    "id": 20131637,
    "chapter_id": 7007,
    "verse_number": "25.123",
    "content_sanskrit": "न च शक्यं हि लोकस्य स्थावरस्य चरस्य च । शास्त्रेण निर्णयं कर्तुं भावचेष्टाविधिं प्रति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 123,
    "avatarnika": ""
  },
  {
    "id": 20131638,
    "chapter_id": 7007,
    "verse_number": "25.124",
    "content_sanskrit": "नानाशीलाः प्रकृतयः शीले नाट्यं प्रतिष्ठिअतम् । तस्माल्लोकप्रमाणं हि विज्ञेयं नाट्ययोक्तृभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 124,
    "avatarnika": ""
  },
  {
    "id": 20131639,
    "chapter_id": 7007,
    "verse_number": "25.125",
    "content_sanskrit": "एतान् विधींश्चाभिनयस्य सम्यग्विज्ञाय रङ्गे मनुजः प्रयुङ्क्ते । स नाट्यतत्त्वाभिनयप्रयोक्ता संमानमग्र्यं लभते हि लोके ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 125,
    "avatarnika": ""
  },
  {
    "id": 20131640,
    "chapter_id": 7007,
    "verse_number": "25.126",
    "content_sanskrit": "एवमेते ह्यभिनया वाङ्नेपथ्याङ्गसंभवाः । प्रयोगज्ञेन कर्तव्या नाटके सिद्धिमिच्छता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 126,
    "avatarnika": ""
  }
]