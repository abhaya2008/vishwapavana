[{"id": 7005487000, "chapter_id": 25487, "verse_number": "२-४-१", "content_sanskrit": "ईश्वर उवाच ।\nवक्ष्ये समाहित युयं श्रृणुध्वं ब्रह्मवादिनः ।\nमाहात्म्यं देवदेवस्य येनेदं सम्प्रवर्तते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005487001, "chapter_id": 25487, "verse_number": "२-४-२", "content_sanskrit": "नाहं तपोभिर्विविधैर्न दानेन न चेज्यया ।\nशक्यो हि पुरुषैर्ज्ञातुम्रुते भक्तिमनुत्तमाम ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005487002, "chapter_id": 25487, "verse_number": "२-४-३", "content_sanskrit": "अहं हि सर्वभावानामन्तस्तिष्थामि सर्वगः ।\nमां सर्वसाक्षिणं लोको न जानाति मुनीश्वराः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005487003, "chapter_id": 25487, "verse_number": "२-४-४", "content_sanskrit": "यस्यान्तरा सर्वमिदं यो हि सर्वान्तरः परः ।\nसोऽहं धाता विधता च कलोऽग्निर्विश्वतोमुखः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005487004, "chapter_id": 25487, "verse_number": "२-४-५", "content_sanskrit": "न मां पश्यन्ति मुनयः सर्वेऽपि त्रिदिवौकसः ।\nब्रह्माच मनव शक्रो ये चान्ये प्रथितौजसः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005487005, "chapter_id": 25487, "verse_number": "२-४-६", "content_sanskrit": "गृणान्ति सततं वेदा मामेकं परमेश्वरम ।\nयजन्ति विविधैरग्निं ब्राह्मणा वैदिकैर्मखैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005487006, "chapter_id": 25487, "verse_number": "२-४-७", "content_sanskrit": "सर्व लोका नमस्यान्ति ब्रह्मा लोकपितामहः ।\nध्यायन्ति योगिनो देवं भूताधिपतिमीश्वरम ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005487007, "chapter_id": 25487, "verse_number": "२-४-८", "content_sanskrit": "अहं ही सर्वहविषां भोक्ता चैव फलप्रदः ।\nसर्वदेवतनुर्भुत्वा सर्वात्मा सर्वसंस्थितः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005487008, "chapter_id": 25487, "verse_number": "२-४-९", "content_sanskrit": "मां पश्‍यन्तीह विद्वांसो धार्मिक वेदवादिनः ।\nतेषा संनिहितो नित्यं ये भक्त्या मामुपासते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005487009, "chapter_id": 25487, "verse_number": "२-४-१०", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्या धार्मिका मामुपासते ।\nतेषां ददामि तत स्थानामानन्दं परमं पदम ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005487010, "chapter_id": 25487, "verse_number": "२-४-११", "content_sanskrit": "अन्येऽपि ये विकर्मस्थाः शुद्राद्या नीचजातयः ।\nभक्तिमन्तः प्रमुच्यन्ते कालेन मयि संगताः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005487011, "chapter_id": 25487, "verse_number": "२-४-१२", "content_sanskrit": "न मद्भक्ता विनश्यन्ति मद्भाक्ता वीतकल्मषाः ।\nआदावेतत प्रतिज्ञातं न मे भक्त प्रणश्यति ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005487012, "chapter_id": 25487, "verse_number": "२-४-१३", "content_sanskrit": "यो वै निन्दति तं मुढो देव देवं स निन्दति ।\nयो हि तं पुजयेद भक्त्या स पुजयति मां सदा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005487013, "chapter_id": 25487, "verse_number": "२-४-१४", "content_sanskrit": "पत्रं पुष्पं फलं तीर्य मदाराधनकारणात ।\nयो मे ददाति नियतः स मे भक्तः प्रियो मतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005487014, "chapter_id": 25487, "verse_number": "२-४-१५", "content_sanskrit": "अहं हि जगतामादौ ब्रह्माणां परमेष्ठिनम ।\nविधाय दत्तवान वेदानशेषानात्मनिः सृतान ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005487015, "chapter_id": 25487, "verse_number": "२-४-१६", "content_sanskrit": "अहमेव हि सर्वेषां योगिनां गुरुरव्ययः ।\nधार्मिकाणां च गोप्ताहं निहन्तां वेदविद्विषाम ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005487016, "chapter_id": 25487, "verse_number": "२-४-१७", "content_sanskrit": "अहं वै सर्वसंसारान्मोचको योगिनामिह ।\nसंसारहेतुरेवाहं सर्वसंसारवार्जितः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005487017, "chapter_id": 25487, "verse_number": "२-४-१८", "content_sanskrit": "अहमेव हि संहर्ता स्त्रष्टाहं परिपालकः ।\nमायावी मामिका शक्तिर्माया लोकविमोहिनी ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005487018, "chapter_id": 25487, "verse_number": "२-४-१९", "content_sanskrit": "ममैव च परा शक्तिर्या सा विद्येति गीयते ।\nनशयामि तया मायां योगिनां हृदि संस्थितः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005487019, "chapter_id": 25487, "verse_number": "२-४-२०", "content_sanskrit": "अहं हि सर्वशक्तिनां प्रवर्तकनिवर्तकः ।\nआधारभुतः सर्वासां निधानममृतस्य च ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005487020, "chapter_id": 25487, "verse_number": "२-४-२१", "content_sanskrit": "एका सर्वान्तरा शक्तिःकरोति विविधं जगत ।\nआस्थाय ब्रह्माणो रुपं मन्मयी मदधिष्ठिता ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005487021, "chapter_id": 25487, "verse_number": "२-४-२२", "content_sanskrit": "अन्या च शक्तिर्विपुला संस्थापयाति मे जगत ।\nभूत्वा नारायणोऽनन्तो जगन्नथा जगन्मयः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005487022, "chapter_id": 25487, "verse_number": "२-४-२३", "content_sanskrit": "तृतीया महती शक्तिर्निहन्ति सकलं जगत ।\nतामसी मे समाख्याता कालाख्या रुद्ररुपिणी ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005487023, "chapter_id": 25487, "verse_number": "२-४-२४", "content_sanskrit": "ध्यानेन मां प्रपश्यन्ति केचिज्ज्ञानेन चापरे ।\nअपरे भक्तियोगेन कर्मयोगेन चापरे ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005487024, "chapter_id": 25487, "verse_number": "२-४-२५", "content_sanskrit": "सर्वषमेव भक्तानामिष्टः प्रियवरो मम ।\nयो हि ज्ञानेन मां नित्यमाराधयीत नान्यथा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005487025, "chapter_id": 25487, "verse_number": "२-४-२६", "content_sanskrit": "अन्ये च ये त्रयो भक्ता मदाराधनकांगक्षिनः ।\nतेऽपि मां प्राप्नुवन्त्येव नावर्तन्ते च वै पुनः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005487026, "chapter_id": 25487, "verse_number": "२-४-२७", "content_sanskrit": "मया ततमिदं कृत्स्नं प्रधानपुरुषत्मकम ।\nमय्येव संस्थितं विश्‍वं मया सम्प्रेर्यते जगत ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005487027, "chapter_id": 25487, "verse_number": "२-४-२८", "content_sanskrit": "नाहं प्रेरयिता विप्राः परमं योगामाश्रितः ।\nप्रेरयामि जगत्कृत्स्नमेतद्यो वेद सोऽमृतः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005487028, "chapter_id": 25487, "verse_number": "२-४-२९", "content_sanskrit": "पश्‍याम्यशेषमेवेदं वर्तमानं स्वभावतः ।\nकरोति कालो भगवान महायोगेश्वरः स्वयम ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005487029, "chapter_id": 25487, "verse_number": "२-४-३०", "content_sanskrit": "योगः सम्प्रोच्यते योगी माया शास्त्रेषु सुरिभिः ।\nयोगेश्वरोऽसौ भगवान महादेवी महान प्रभुः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005487030, "chapter_id": 25487, "verse_number": "२-४-३१", "content_sanskrit": "महत्वं सर्वतत्वानां परत्वात परमेष्ठिनः ।\nप्रोच्यते भगवान ब्रह्मा महान ब्रह्मामयोऽमलः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005487031, "chapter_id": 25487, "verse_number": "२-४-३२", "content_sanskrit": "यो मामेवं विजानाति महायोग्श्वरेश्वरम ।\nसोऽविकल्पेन योगेन युज्यते नात्र संशयः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005487032, "chapter_id": 25487, "verse_number": "२-४-३३", "content_sanskrit": "सोऽहं प्रेरयिता देवः परमान्दमाश्रितः ।\nनृत्यामि योगी सततं यस्तद वेद स वेदवित ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005487033, "chapter_id": 25487, "verse_number": "२-४-३४", "content_sanskrit": "इति गुह्मातमंक ज्ञानं सर्ववेदेषु निष्ठितम ।\nप्रसन्नचेतसे देयं धार्मिकायाहिताग्रये ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]