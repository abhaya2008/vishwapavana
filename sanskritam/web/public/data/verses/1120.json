[{"id": 2006086, "chapter_id": 1120, "verse_number": "१-१२१-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2006087, "chapter_id": 1120, "verse_number": "१-१२१-१", "content_sanskrit": "सत्वरूपगुणोपेता धर्मारामा महाव्रता।\nदुहिता कुन्तिभोजस्य पृथा पृथुललोचना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2006088, "chapter_id": 1120, "verse_number": "१-१२१-२", "content_sanskrit": "तां तु तेजस्विनीं कन्यां रूपयौवनशालिनीम्।\nव्यावृण्वन्पार्थिवाः केचिदतीव स्त्रीगुणैर्युताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2006089, "chapter_id": 1120, "verse_number": "१-१२१-३", "content_sanskrit": "ततः सा कुन्तिभोजेन राज्ञाहूय नराधिपान्।\nपित्रा स्वयंवरे दत्ता दुहिता राजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2006090, "chapter_id": 1120, "verse_number": "१-१२१-४", "content_sanskrit": "ततः सा रङ्गमध्यस्थं तेषां राज्ञां मनस्विनी।\nददर्श राजशार्दूलं पाण्डुं भरतसत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2006091, "chapter_id": 1120, "verse_number": "१-१२१-५", "content_sanskrit": "सिंहदर्पं महोरस्कं वृषभाक्षं महाबलम्।\nआदित्यमिव सर्वेषां राज्ञां प्रच्छाद्य वै प्रभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2006092, "chapter_id": 1120, "verse_number": "१-१२१-६", "content_sanskrit": "तिष्ठन्तं राजसमितौ पुरन्दरमिवापरम्।\nतं दृष्ट्वा साऽनवद्याङ्गी कुन्तिभोजसुता शुभा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2006093, "chapter_id": 1120, "verse_number": "१-१२१-७", "content_sanskrit": "पाण्डुं नरवरं रङ्गे हृदयेनाकुलाऽभवत्।\nततः कामपरीताङ्गी सकृत्प्रचलमानसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2006094, "chapter_id": 1120, "verse_number": "१-१२१-८", "content_sanskrit": "व्रीडमान स्रजं कुन्ती राज्ञः स्कन्धे समासजत्।\nतं निशम्य वृतं पाण्डुं कुन्त्या सर्वे नराधिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2006095, "chapter_id": 1120, "verse_number": "१-१२१-९", "content_sanskrit": "यथागतं समाजग्मुर्गजैरश्वै रथैस्तथा।\nततस्तस्याः पिता राजन्विवाहमकरोत्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2006096, "chapter_id": 1120, "verse_number": "१-१२१-१०", "content_sanskrit": "स तया कुन्तिभोजस्य दुहित्रा कुरुनन्दनः।\nयुयुजेऽमितसौभाग्यः पौलोम्या मघवानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2006097, "chapter_id": 1120, "verse_number": "१-१२१-११", "content_sanskrit": "कुन्त्याः पाण्डोश्च राजेन्द्र कुन्तिभोजो महीपतिः।\nकृत्वोद्वाहं तदा तं तु नानावसुभिरर्चितम्।\nस्वपुरं प्रेषयामास स राजा कुरुसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2006098, "chapter_id": 1120, "verse_number": "१-१२१-१२", "content_sanskrit": "ततो बलेन महता नानाध्वजपताकिना।\nस्तूयमानः स चाशीर्भिर्ब्राह्मणैश्च महर्षिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2006099, "chapter_id": 1120, "verse_number": "१-१२१-१३", "content_sanskrit": "संप्राप्य नगरं राजा पाण्डुः कौरवनन्दनः।\nन्यवेशत तां भार्यां कुन्तीं स्वभवने प्रभुः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2006100, "chapter_id": 1120, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि एकविंशत्यधिकशततमोऽध्यायः॥ १२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]