[{"id": 7000970000, "chapter_id": 20970, "verse_number": "२-१०-१", "content_sanskrit": "श्रीपराशर उवाच ।\nत्र्यशीतिमण्डलशतं काष्ठयोरन्तरं द्वयोः ।\nआरोहणावरोहाभ्यां भानोरब्देन या गतिः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000970001, "chapter_id": 20970, "verse_number": "२-१०-२", "content_sanskrit": "स रथोधिष्ठितो देवैरादित्यै ऋषिभिस्तथा ।\nगन्धर्वैरप्सरोभिश्च ग्रामणीसर्पराक्षसैः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000970002, "chapter_id": 20970, "verse_number": "२-१०-३", "content_sanskrit": "धाता क्रतुस्थला चैव पुलस्त्यो वासुकिस्तथा ।\nरथभृद्ग्रामणीर्हेतिस्तुम्बुरुश्चैव सप्तमः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000970003, "chapter_id": 20970, "verse_number": "२-१०-४", "content_sanskrit": "एते वसन्ति वै चैत्रे मधुमासे सदैव हि ।\nमैत्रेय स्यन्दने भानोः सप्तमासाधिकारिणः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000970004, "chapter_id": 20970, "verse_number": "२-१०-५", "content_sanskrit": "अर्यमा पुलहश्चैव रथौजाः पुञ्जिकस्थला ।\nप्रहेतिः कच्छवीरश्व नारदश्च रथे रवेः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000970005, "chapter_id": 20970, "verse_number": "२-१०-६", "content_sanskrit": "माधवे निवसन्त्येते शुचिसंज्ञे निबोध मे ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000970006, "chapter_id": 20970, "verse_number": "२-१०-७", "content_sanskrit": "मित्रोत्रिस्तक्षको रक्षः पौरुषेयोथ मेनका ।\nहाहा रथस्वनश्चैव मैत्रेयैते वसन्ति वै ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000970007, "chapter_id": 20970, "verse_number": "२-१०-८", "content_sanskrit": "वरुणो वसिष्ठो रम्भा च सहजन्या हुहूरथः ।\nरथचित्रस्तथा शुक्रे वसन्त्याषाढसंज्ञके ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000970008, "chapter_id": 20970, "verse_number": "२-१०-९", "content_sanskrit": "इन्द्रो  विश्वासुः स्रोता एलापुत्रस्तथांगिराः ।\nप्रम्लोचा च नभस्येते सप्तिश्चार्के वसन्ति वै ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000970009, "chapter_id": 20970, "verse_number": "२-१०-१०", "content_sanskrit": "विवस्वानुग्रसेनश्च भृगुरापूरणस्तथा ।\nअनुम्लोचा शंखपालो व्याघ्रो भाद्र पदे तथा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000970010, "chapter_id": 20970, "verse_number": "२-१०-११", "content_sanskrit": "पूषा च सुरुचिर्वातो गौतमोथ धनञ्जयः ।\nसुषेणोऽन्यो घृताची च वसन्त्याश्वयुजे रवौ ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000970011, "chapter_id": 20970, "verse_number": "२-१०-१२", "content_sanskrit": "विश्वावसुर्भरद्वाजः पर्जन्यैरावतौ तथा ।\nविश्वाची सेनजिच्चापि कार्त्तिके च वसन्ति वै ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000970012, "chapter_id": 20970, "verse_number": "२-१०-१३", "content_sanskrit": "अंशः काश्यपतार्क्ष्यास्तु महापद्मस्तथोर्वशी ।\nचित्रसेनस्तथा विद्युन्मार्गशीर्षेधिकारिणः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000970013, "chapter_id": 20970, "verse_number": "२-१०-१४", "content_sanskrit": "क्रतुर्भगस्तथोर्णायुः स्फूर्जः कार्कोटकस्तथा ।\nअरिष्टनेमिश्चैवान्या पूर्वाचित्तिर्वराप्सराः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000970014, "chapter_id": 20970, "verse_number": "२-१०-१५", "content_sanskrit": "पौषमासे वसन्त्येते सप्तभास्करमण्डले ।\nलोकप्रकाशनार्थाय विग्रवर्याधिकारिणः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000970015, "chapter_id": 20970, "verse_number": "२-१०-१६", "content_sanskrit": "त्वष्टाथ जमदग्निश्च कम्बलोथ तिलोत्तमा ।\nब्रह्मोपेतोथ ऋतजिद्धृतराष्ट्रोथ सप्तमः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000970016, "chapter_id": 20970, "verse_number": "२-१०-१७", "content_sanskrit": "माघमासे वसन्त्येते सप्त मैत्रेय भास्करे ।\nश्रूयतां चापरे सूर्ये फाल्गुने निवसन्ति ये ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000970017, "chapter_id": 20970, "verse_number": "२-१०-१८", "content_sanskrit": "विष्णुरश्वतरो रम्भा सूर्यवर्चाश्च सत्यजित् ।\nविश्वामित्रस्तथा रक्षो यज्ञोपेतो महामुने ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000970018, "chapter_id": 20970, "verse_number": "२-१०-१९", "content_sanskrit": "मासेष्वेतेषु मैत्रेय वसन्त्येते तु सप्तकाः ।\nसवितुर्मण्डले ब्रह्मन्विष्णुशक्त्युपबृंहिताः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000970019, "chapter_id": 20970, "verse_number": "२-१०-२०", "content_sanskrit": "स्तुवन्ति मुनयः सूर्यं गंधर्वैर्गीयते पुरः ।\nनृत्यन्त्यप्सरसो यान्ति सूर्यस्यानुनिशाचराः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000970020, "chapter_id": 20970, "verse_number": "२-१०-२१", "content_sanskrit": "वहन्ति पन्नगा यक्षैः क्रियतेऽभीषुसंग्रहः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000970021, "chapter_id": 20970, "verse_number": "२-१०-२२", "content_sanskrit": "वालखित्यास्तथैवैनं परिवार्य समासते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000970022, "chapter_id": 20970, "verse_number": "२-१०-२३", "content_sanskrit": "सोयं सप्तगणः सूर्यमण्डले मुनिसत्तम ।\nहिमोष्णवारिवृष्टीनां हेतुः स्वसमयं गतः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]