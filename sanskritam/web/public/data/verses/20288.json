[{"id": 7000288000, "chapter_id": 20288, "verse_number": "१-४२-१", "content_sanskrit": "भीष्म उवाच ।\nश्रुतः पद्मोद्भवो ब्रह्मन्विस्तरेण त्वयेरितः ।\nसमासाद्भवमाहात्म्यमुत्पत्तिं च गुहस्य च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000288001, "chapter_id": 20288, "verse_number": "१-४२-२", "content_sanskrit": "श्रोतुमिच्छामि ते ब्रह्मन्यथाभूतः कृतं च यत् ।\nतारकश्च कथं भूतो दानवो बलवत्तरः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000288002, "chapter_id": 20288, "verse_number": "१-४२-३", "content_sanskrit": "कार्त्तिकेयेन स ब्रह्मन्कथं ध्वस्तो महासुरः ।\nकथं रुद्रेण मुनयः प्रेषिता मंदरं गिरिम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000288003, "chapter_id": 20288, "verse_number": "१-४२-४", "content_sanskrit": "कथं लब्धा उमा तत्र रुद्रेण परमेष्ठिना ।\nएतदाख्याहि मे सर्वं यथाभूतं महामुने ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000288004, "chapter_id": 20288, "verse_number": "१-४२-५", "content_sanskrit": "पुलस्त्य उवाच ।\nकश्यपेन पुरा प्रोक्ता दितिर्दैत्यारणिः शुभा ।\nवज्रसारमयैश्चांगैः पुत्रो देवि भविष्यति ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000288005, "chapter_id": 20288, "verse_number": "१-४२-६", "content_sanskrit": "वज्रांगो नाम पुत्रस्तु भविता धर्मवत्सलः ।\nसा च लब्धवरा देवी सुषुवे वज्रदुश्छिदम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000288006, "chapter_id": 20288, "verse_number": "१-४२-७", "content_sanskrit": "स जातमात्र एवाभूत्सर्वशास्त्रार्थपारगः ।\nउवाच मातरं भक्त्या मातः किं करवाण्यहम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000288007, "chapter_id": 20288, "verse_number": "१-४२-८", "content_sanskrit": "तस्योवाच ततो हृष्टा दितिर्दैत्याधिपस्य तु ।\nबहवो मे हताः पुत्राः सहस्राक्षेण पुत्रक ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000288008, "chapter_id": 20288, "verse_number": "१-४२-९", "content_sanskrit": "तेषामपचितिं कर्तुं गच्छ शक्रवधाय तु ।\nबाढमित्येव तां चोक्त्वा जगाम त्रिदिवं बलात् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000288009, "chapter_id": 20288, "verse_number": "१-४२-१०", "content_sanskrit": "बध्वा ततः सहस्राक्षं पाशेनामोघवर्चसा ।\nमातुरंतिकमागच्छद्व्याधः क्षुद्रमृगं यथा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000288010, "chapter_id": 20288, "verse_number": "१-४२-११", "content_sanskrit": "एतस्मिन्नंतरे ब्रह्मा कश्यपश्च महातपाः ।\nआगतौ तत्र यत्रास्तां मातापुत्रावभीतकौ ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000288011, "chapter_id": 20288, "verse_number": "१-४२-१२", "content_sanskrit": "दृष्ट्वा तु तावुवाचेदं ब्रह्मा कश्यप एव च ।\nमुंचैनं पुत्र देवेंद्रं किमनेन प्रयोजनम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000288012, "chapter_id": 20288, "verse_number": "१-४२-१३", "content_sanskrit": "अवमानो वधः प्रोक्तः पुत्र संभावितस्य तु ।\nअस्मद्वाक्येन यो मुक्तस्त्वद्धस्तान्मृत एव सः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000288013, "chapter_id": 20288, "verse_number": "१-४२-१४", "content_sanskrit": "परस्य गौरवान्मुक्तः शत्रूणां शत्रुराहवे ।\nसजीवन्नेव हि मृतो दिवसे दिवसे पुनः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000288014, "chapter_id": 20288, "verse_number": "१-४२-१५", "content_sanskrit": "एतच्छ्रुत्वा तु वज्रांगः प्रणतो वाक्यमब्रवीत् ।\nन मे कृत्यमनेनास्ति मातुराज्ञा कृता हि मे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000288015, "chapter_id": 20288, "verse_number": "१-४२-१६", "content_sanskrit": "त्वं सुरासुरनाथो वै मान्यश्च प्रपितामहः ।\nकरिष्ये त्वद्वचो देव एष मुक्तः शतक्रतुः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000288016, "chapter_id": 20288, "verse_number": "१-४२-१७", "content_sanskrit": "तपसेमेरतिर्देवनिर्विघ्नंतच्चमेभवेत् ।\nत्वत्प्रसादेन भगवन्नित्युक्त्वा विरराम ह ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000288017, "chapter_id": 20288, "verse_number": "१-४२-१८", "content_sanskrit": "तस्मिंस्तूष्णीं स्थिते दैत्ये प्रोवाचेदं पितामहः ।\nब्रह्मोवाच ।\nतपस्त्वं कुरु मापन्नः सोस्मच्छासनसंस्थितः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000288018, "chapter_id": 20288, "verse_number": "१-४२-१९", "content_sanskrit": "अनया चित्तशुद्ध्या हि पर्याप्तं जन्मनः फलम् ।\nइत्युक्त्वा पद्मजः कन्यां ससर्जायतलोचनाम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000288019, "chapter_id": 20288, "verse_number": "१-४२-२०", "content_sanskrit": "तामस्मै प्रददौ देवः पत्न्यर्थे पद्मसंभवः ।\nवरांगीति च नामास्याः कृत्वा यातः पितापहः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000288020, "chapter_id": 20288, "verse_number": "१-४२-२१", "content_sanskrit": "वज्रांगोपि तया सार्द्धं जगाम तपसे वनम् ।\nऊर्द्ध्वबाहुस्स दैत्येंद्रो चरद्वर्षसहस्रकम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000288021, "chapter_id": 20288, "verse_number": "१-४२-२२", "content_sanskrit": "कालं कमलपत्राक्षः शुद्धबुद्धिर्महातपाः ।\nतावच्चाधोमुखः कालं तावत्पंचाग्निमध्यगः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000288022, "chapter_id": 20288, "verse_number": "१-४२-२३", "content_sanskrit": "निराहारो घोरतपास्तपोराशिरजायत ।\nततः सोंतर्जले चक्रे वासं वर्षसहस्रकम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000288023, "chapter_id": 20288, "verse_number": "१-४२-२४", "content_sanskrit": "जलांतरं प्रविष्टस्य तस्य पत्नी महाव्रता ।\nतस्यैव तीरे सरसः स्थिताऽसौ मौनमाश्रिता ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000288024, "chapter_id": 20288, "verse_number": "१-४२-२५", "content_sanskrit": "निराहारं तपो घोरं प्रविवेश महाद्युतिः ।\nतस्यां तपसि वर्तंत्यामिंद्रश्चक्रे विभीषिकाम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000288025, "chapter_id": 20288, "verse_number": "१-४२-२६", "content_sanskrit": "गत्वा तु मर्कटाकारस्तदाश्रमपदं महत् ।\nब्रसीं चकर्ष बलवान्गंधाद्यर्चाकरंडकम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000288026, "chapter_id": 20288, "verse_number": "१-४२-२७", "content_sanskrit": "ततस्तु सिंहरूपेण भीषयामास भामिनीम् ।\nततो भुजंगरूपेणाप्यदशच्चरणद्वयम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000288027, "chapter_id": 20288, "verse_number": "१-४२-२८", "content_sanskrit": "तपोबलवशात्सा तु नवध्यत्वं जगाम ह ।\nभीषिकाभिरनेकाभिः क्लेशयन्पाकशासनः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000288028, "chapter_id": 20288, "verse_number": "१-४२-२९", "content_sanskrit": "विरराम यदा नैव वज्रांगमहिषी तदा ।\nशैलस्यदुष्टतां मत्वा शापं दातुं समुद्यता ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000288029, "chapter_id": 20288, "verse_number": "१-४२-३०", "content_sanskrit": "तां शापाभिमुखीं दृष्ट्वा शैलः पुरुषविग्रहः ।\nउवाच तां वरारोहां वरांगीं भीतलोचनः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000288030, "chapter_id": 20288, "verse_number": "१-४२-३१", "content_sanskrit": "शैल उवाच ।\nनाहं महाव्रते दुष्टः सेव्योहं सर्वदेहिनाम् ।\nविप्रियं ते करोत्येष रुषितः पाकशासनः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000288031, "chapter_id": 20288, "verse_number": "१-४२-३२", "content_sanskrit": "एतस्मिन्नंतरे जातः कालो वर्षसहस्रकः ।\nतस्मिन्ज्ञात्वा तु भगवान्काले कमलसंभवः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000288032, "chapter_id": 20288, "verse_number": "१-४२-३३", "content_sanskrit": "तुष्टः प्रोवाच वज्रांगं तदागत्य जलाशयम् ।\nब्रह्मोवाच ।\nददामि सर्वकामं त उत्तिष्ठ दितिनंदन ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000288033, "chapter_id": 20288, "verse_number": "१-४२-३४", "content_sanskrit": "एवमुक्तस्तदोत्थाय स दैत्येंद्रस्तपोनिधिः ।\nउवाच प्रांजलिर्वाक्यं सर्वलोकपितामहम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000288034, "chapter_id": 20288, "verse_number": "१-४२-३५", "content_sanskrit": "वज्रांग उवाच ।\nआसुरो मास्तु मे भावः संतु लोका ममाक्षयाः ।\nतपस्यभिरतिर्मेऽस्तु शरीरस्यास्य वर्तनम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000288035, "chapter_id": 20288, "verse_number": "१-४२-३६", "content_sanskrit": "एवमस्त्विति तं देवो जगाम स्वकमालयम् ।\nवज्रांगोपि समाप्ते तु तपसि स्थिरसंयमः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000288036, "chapter_id": 20288, "verse_number": "१-४२-३७", "content_sanskrit": "संगंतुमिच्छन्स्वां भार्यां न ददर्शाश्रमे स्वके ।\nक्षुधाविष्टः स शैलस्य गहनं प्रविवेश ह ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000288037, "chapter_id": 20288, "verse_number": "१-४२-३८", "content_sanskrit": "आदातुं फलमूलानि स च तस्मिन्व्यलोकयत् ।\nरुदन्तीं स्वां प्रियां दीनां तरुप्रच्छादिताननाम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000288038, "chapter_id": 20288, "verse_number": "१-४२-३९", "content_sanskrit": "तां विलोक्य ततो दैत्यः प्रोवाच परिसांत्वयन् ।\nवज्रांग उवाच ।\nकेन तेऽपकृतं भद्रे यमलोकं यियासुना ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000288039, "chapter_id": 20288, "verse_number": "१-४२-४०", "content_sanskrit": "कं वा कामं प्रयच्छामि शीघ्रं प्रब्रूहि मानिनि ।\nवरांग्युवाच ।\nत्रासितास्म्यपविद्धास्मि ताडिता पीडितास्मि च ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000288040, "chapter_id": 20288, "verse_number": "१-४२-४१", "content_sanskrit": "रौद्रेण देवराजेन नष्टनाथेव भूरिशः ।\nदुःखस्यांतमपश्यंती प्राणांस्त्यक्तुं व्यवस्थिता ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000288041, "chapter_id": 20288, "verse_number": "१-४२-४२", "content_sanskrit": "पुत्रं मे तारकं देहि तस्माद्दुःखमहार्णवात् ।\nएवमुक्तस्तु दैत्येंद्रः कोपव्याकुललोचनः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000288042, "chapter_id": 20288, "verse_number": "१-४२-४३", "content_sanskrit": "शक्तोपि देवराजस्य प्रतिकर्तुं महासुरः ।\nतप एव पुनश्चर्तुं व्यवस्यत महाबलः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000288043, "chapter_id": 20288, "verse_number": "१-४२-४४", "content_sanskrit": "ज्ञात्वा तस्य तु संकल्पं ब्रह्मा क्रूरतरं पुनः ।\nआजगाम त्वरायुक्तो यत्रासौ दितिनंदनः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000288044, "chapter_id": 20288, "verse_number": "१-४२-४५", "content_sanskrit": "ब्रह्मोवाच ।\nकिमर्थं पुत्र भूयस्त्वं कर्तुं नियममुद्यतः ।\nतदहं ते पुनर्दद्मि कांक्षितं पुत्रमोजसा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000288045, "chapter_id": 20288, "verse_number": "१-४२-४६", "content_sanskrit": "वज्रांग उवाच ।\nउत्थितेन मया दृष्टा समाधानात्त्वदाज्ञया ।\nत्रासितेंद्रेण मामाह सा वरांगी सुतार्थिनी ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000288046, "chapter_id": 20288, "verse_number": "१-४२-४७", "content_sanskrit": "पुत्रं मे तारकं देहि तुष्टो मे त्वं पितामह ।\nब्रह्मोवाच ।\nअलं ते तपसा वीर मा क्लेशे दुस्तरे विश ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000288047, "chapter_id": 20288, "verse_number": "१-४२-४८", "content_sanskrit": "पुत्रस्तु तारको नाम भविष्यति महाबलः ।\nदेवसीमंतिनीनां तु धम्मिल्लक विमोक्षकः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000288048, "chapter_id": 20288, "verse_number": "१-४२-४९", "content_sanskrit": "इत्युक्तो दैत्यनाथस्तु प्रणम्य प्रपितामहम् ।\nगत्वा तां नंदयामास महिषीं कर्शितांतराम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000288049, "chapter_id": 20288, "verse_number": "१-४२-५०", "content_sanskrit": "तौ दंपती कृतार्थौ तु जग्मतुः स्वाश्रमं तदा ।\nआहितं तु तदा गर्भं वरांगी वरवर्णिनी ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000288050, "chapter_id": 20288, "verse_number": "१-४२-५१", "content_sanskrit": "पूर्णं वर्षसहस्रं तु दधारोदर एव हि ।\nततो वर्षसहस्रांते वरांगी सा प्रसूयत ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000288051, "chapter_id": 20288, "verse_number": "१-४२-५२", "content_sanskrit": "जायमाने तु दैत्ये तु तस्मिन्लोकभयंकरे ।\nचचाल सर्वा पृथिवी प्रोद्भूताश्च महार्णवाः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000288052, "chapter_id": 20288, "verse_number": "१-४२-५३", "content_sanskrit": "चेलुर्धराधराश्चापि ववुर्वाताश्च भीषणाः ।\nजेपुर्जप्यं मुनिवरा नेदुर्व्यालमृगा अपि ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000288053, "chapter_id": 20288, "verse_number": "१-४२-५४", "content_sanskrit": "जहौ कांतिश्चंद्रसूर्यौ नीहारच्छादिता दिशः ।\nजाते महासुरे तस्मिन्सर्वे चापि महासुराः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000288054, "chapter_id": 20288, "verse_number": "१-४२-५५", "content_sanskrit": "आजग्मुर्हर्षितास्तत्र तथा चासुरयोषितः ।\nजगुर्हर्षसमाविष्टा ननृतुश्चाप्सरोगणाः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000288055, "chapter_id": 20288, "verse_number": "१-४२-५६", "content_sanskrit": "ततो महोत्सवे जाते दानवानां महाद्युते ।\nविषण्णमनसो देवाः सहेंद्रा अभवंस्तदा ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000288056, "chapter_id": 20288, "verse_number": "१-४२-५७", "content_sanskrit": "वरांगी तु सुतं दृष्ट्वा हर्षेणापूरिता तदा ।\nबहुमेने च दैत्येंद्रो विजातं तं तदा तया ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000288057, "chapter_id": 20288, "verse_number": "१-४२-५८", "content_sanskrit": "जातमात्रस्तु दैत्येंद्रस्तारकश्चोग्रविक्रमः ।\nअभिषिक्तो सुरैर्मुख्यैः कुजंभमहिषादिभिः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000288058, "chapter_id": 20288, "verse_number": "१-४२-५९", "content_sanskrit": "सर्वासुरमहाराज्ये पृथिवीतुलनक्षमे ।\nस तु प्राप्तमहाराज्यस्तारको नृपसत्तम ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000288059, "chapter_id": 20288, "verse_number": "१-४२-६०", "content_sanskrit": "उवाच दानवश्रेष्ठो युक्तियुक्तमिदं वचः ।\nतारक उवाच ।\nशृणुध्वमसुराः सर्वे वाक्यं मम महाबलाः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000288060, "chapter_id": 20288, "verse_number": "१-४२-६१", "content_sanskrit": "वंशक्षयकरा देवाः सर्वेषामेव दानवाः ।\nअस्माकं जातिधर्मेण विरूढं वैरमक्षयम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000288061, "chapter_id": 20288, "verse_number": "१-४२-६२", "content_sanskrit": "वयं तपश्चरिष्यामः सुराणां निग्रहाय तु ।\nस्वबाहुबलमाश्रित्य सर्व एव न संशयः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000288062, "chapter_id": 20288, "verse_number": "१-४२-६३", "content_sanskrit": "तच्छ्रुत्वा संमतं कृत्वा पारियात्रं ययौ गिरिं ।\nनिराहारः पंचतपाः पत्रभुग्वारिभोजनः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000288063, "chapter_id": 20288, "verse_number": "१-४२-६४", "content_sanskrit": "शतंशतं समानां तु तपांस्येतान्यथाकरोत् ।\nएवं तु कर्शिते देहे तपोराशित्वमागते ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000288064, "chapter_id": 20288, "verse_number": "१-४२-६५", "content_sanskrit": "ब्रह्मागत्याह दैत्येंद्रं वरं वरय सुव्रत ।\nस वव्रे सर्वभूतेभ्यो न मे मृत्युर्भवेदिति ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000288065, "chapter_id": 20288, "verse_number": "१-४२-६६", "content_sanskrit": "तमुवाच ततो ब्रह्मा देहिनां मरणं ध्रुवम् ।\nयतस्ततोपि वरय मृत्युं यस्मान्न शंकसे ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000288066, "chapter_id": 20288, "verse_number": "१-४२-६७", "content_sanskrit": "ततः संचिंत्य दैत्येंद्रः शिशोर्वै सप्तवासरात् ।\nवव्रे महासुरो मृत्युं मोहितो ह्यवलेपतः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000288067, "chapter_id": 20288, "verse_number": "१-४२-६८", "content_sanskrit": "जगामोमित्युदाहृत्य ब्रह्मा दैत्यो निजं गृहम् ।\nअथाह मंत्रिणस्तूर्णं बलं मे संप्रयुज्यताम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000288068, "chapter_id": 20288, "verse_number": "१-४२-६९", "content_sanskrit": "यदि वो मत्प्रियं कार्यं निग्राह्याः सुरसत्तमाः ।\nनिगृहीतेषु मे प्रीतिर्जायते चातुलाऽसुराः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000288069, "chapter_id": 20288, "verse_number": "१-४२-७०", "content_sanskrit": "तारकस्य वचः श्रुत्वा ग्रसनो नाम दानवः ।\nसेनानीर्दैत्यराजस्य सज्जं चक्रे बलं च तत् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000288070, "chapter_id": 20288, "verse_number": "१-४२-७१", "content_sanskrit": "आहत्य भेरीं गंभीरां दैत्यानाहूय सत्वरः ।\nदशकोटीश्वरा दैत्या दैत्यानां चंडविक्रमाः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000288071, "chapter_id": 20288, "verse_number": "१-४२-७२", "content_sanskrit": "तेषामग्रेसरो जंभः कुजंभोनंतरोऽसुरः ।\nमहिषः कुंजरो मेघः कालनेमिर्निमिस्तथा ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000288072, "chapter_id": 20288, "verse_number": "१-४२-७३", "content_sanskrit": "मंथनो जंभकः शुम्भो दैत्येंद्रा दशनायकाः ।\nअन्ये च शतशस्तत्र पृथिवीतुलनक्षमाः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000288073, "chapter_id": 20288, "verse_number": "१-४२-७४", "content_sanskrit": "गरुडानां सहस्रेण चक्राष्टकविभूषितः ।\nसकूबरपरीवारश्चतुर्योजनविस्तृतः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000288074, "chapter_id": 20288, "verse_number": "१-४२-७५", "content_sanskrit": "स्यंदनस्तारकस्यासीत्व्याघ्रसिंहखरार्वभिः ।\nयुक्ता रथास्तु ग्रसन जंभकौ जंभकुंभिनां ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000288075, "chapter_id": 20288, "verse_number": "१-४२-७६", "content_sanskrit": "मेघस्य द्वीपिभिर्युक्तः कूष्मांडैः कालनेमिनः ।\nपर्वताभश्चतुर्दंष्ट्रो निमेश्चैव महागजः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000288076, "chapter_id": 20288, "verse_number": "१-४२-७७", "content_sanskrit": "शतहस्ततुरंगस्थो मंथनो नाम दैत्यराट् ।\nजंभकस्तूष्ट्रमारूढो गिरींद्राभं महाबलः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000288077, "chapter_id": 20288, "verse_number": "१-४२-७८", "content_sanskrit": "शुंभो मेषं समारूढोऽन्येप्येवं चित्रवाहनाः ।\nप्रचंडाश्चित्रवर्माणः कुंडलोष्णीषभूषिताः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000288078, "chapter_id": 20288, "verse_number": "१-४२-७९", "content_sanskrit": "तद्बलं दैत्यसिंहस्य भीमरूपं व्यजायत ।\nप्रमत्तमत्तमातंगतुरंगरथसंकुलम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000288079, "chapter_id": 20288, "verse_number": "१-४२-८०", "content_sanskrit": "प्रतस्थेऽमरयुद्धाय बहुपत्तिपताकिकम् ।\nएतस्मिन्नंतरे वायुर्देवदूतोऽसुरालये ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000288080, "chapter_id": 20288, "verse_number": "१-४२-८१", "content_sanskrit": "दृष्ट्वा तद्दानवबलं जगामेंद्रस्य शंसितुं ।\nस गत्वा तु सभां दिव्यां महेंद्रस्य महात्मनः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000288081, "chapter_id": 20288, "verse_number": "१-४२-८२", "content_sanskrit": "शशंस मध्ये देवानां तत्कार्यं समुपस्थितम् ।\nतच्छ्रुत्वा देवराजस्तु निमीलितविलोचनः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000288082, "chapter_id": 20288, "verse_number": "१-४२-८३", "content_sanskrit": "बृहस्पतिमुवाचेदं वाक्यं काले महाभुजः ।\nइंद्र उवाच ।\nसंप्राप्नोति विमर्दोयं देवानां दानवैः सह ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000288083, "chapter_id": 20288, "verse_number": "१-४२-८४", "content_sanskrit": "कार्यं किमत्र तद्ब्रूहि नीत्युपायोपबृंहितम् ।\nएतच्छ्रुत्वा तु वचनं महेंद्रस्य गिरां पतिः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000288084, "chapter_id": 20288, "verse_number": "१-४२-८५", "content_sanskrit": "इत्युवाच महाभागो बृहस्पतिरुदारधीः ।\nबृहस्पतिरुवाच ।\nसामपूर्वा श्रुता नीतिश्चतुरंगापताकिनी ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000288085, "chapter_id": 20288, "verse_number": "१-४२-८६", "content_sanskrit": "जिगीषतां सुरश्रेष्ठ स्थितिरेषा सनातनी ।\nसामभेदस्तथा दानं दंडश्चांगचतुष्टयम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000288086, "chapter_id": 20288, "verse_number": "१-४२-८७", "content_sanskrit": "न सांत्वगोचरे लुब्धानभेद्यास्त्वेकधर्मिणः ।\nन दानमत्त्र संसिद्ध्यै प्रसह्यैवापहारिणाम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000288087, "chapter_id": 20288, "verse_number": "१-४२-८८", "content_sanskrit": "एकोभ्युपायो दंडोऽत्र भवतां यदि रोचते ।\nएवमुक्तः सहस्राक्ष एवमेतदुवाच ह ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000288088, "chapter_id": 20288, "verse_number": "१-४२-८९", "content_sanskrit": "कर्त्तव्यतां च संचिंत्य प्रोवाचामरसंसदि ।\nइंद्र उवाच ।\nअवधानेन मे वाचं शृणुध्वं नाकवासिनः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000288089, "chapter_id": 20288, "verse_number": "१-४२-९०", "content_sanskrit": "भवंतो यज्ञभोक्तारो दिव्यात्मानो हि सान्वयाः ।\nस्वे महिम्नि स्थिता नित्यं जगतः पालने रताः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000288090, "chapter_id": 20288, "verse_number": "१-४२-९१", "content_sanskrit": "क्रियतां समरोद्योगः सैन्यं संयोज्यतां मम ।\nआह्रियंतां च शस्त्राणि पूज्यंतां शस्त्रदेवताः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000288091, "chapter_id": 20288, "verse_number": "१-४२-९२", "content_sanskrit": "वाहनानि विमानानि योजयद्ध्वं ममेश्वराः ।\nयमं सेनापतिं कृत्वा शीघ्रमेव दिवौकसः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000288092, "chapter_id": 20288, "verse_number": "१-४२-९३", "content_sanskrit": "इत्युक्तास्समनह्यंत देवानां ये प्रधानतः ।\nवाजिनामयुतेनाजौ हेमघंटा परिष्कृतम् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000288093, "chapter_id": 20288, "verse_number": "१-४२-९४", "content_sanskrit": "नानाश्चर्यगुणोपेतं संप्राप्तं देवदानवैः ।\nरथं मातलिना युक्तं देवराजस्य दुर्जयम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000288094, "chapter_id": 20288, "verse_number": "१-४२-९५", "content_sanskrit": "यमो महिषमास्थाय सेनाग्रे समवर्त्तत ।\nचंडकिंकरवृंदेन सर्वतः परिवारितः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000288095, "chapter_id": 20288, "verse_number": "१-४२-९६", "content_sanskrit": "कल्पकालोद्गतज्वाला पूरितोम्बरगोचरः ।\nहुताशनस्त्वजारूढः शक्तिहस्तो व्यवस्थितः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000288096, "chapter_id": 20288, "verse_number": "१-४२-९७", "content_sanskrit": "पवनोऽङकुशहस्तश्च विस्तारित महाजवः ।\nभुजगेंद्रसमारूढो जलेशो भगवान्स्वयम् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000288097, "chapter_id": 20288, "verse_number": "१-४२-९८", "content_sanskrit": "नरयुक्ते रथे देवो राक्षसेशो वियच्चरः ।\nतीक्ष्णखड्गयुतो भीमः समरे समवस्थितः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000288098, "chapter_id": 20288, "verse_number": "१-४२-९९", "content_sanskrit": "महासिंहरथे देवो धनाध्यक्षो गदायुधः ।\nचंद्रादित्यावश्विनौ च चतुरंगबलान्विताः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000288099, "chapter_id": 20288, "verse_number": "१-४२-१००", "content_sanskrit": "सेनान्यो देवराजस्य दुर्जया भुवनत्रये ।\nकोटयस्तास्त्रयस्त्रिंशद्देवदेवनिकायिनाम् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000288100, "chapter_id": 20288, "verse_number": "१-४२-१०१", "content_sanskrit": "हिमाचलाभे सितचारुचामरे सुवर्णपद्मामलसुंदरस्रजि ।\nकृताभिरामो ज्वलकुंकुमांकुरे कपोललीलालिकदंबसंकुले ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000288101, "chapter_id": 20288, "verse_number": "१-४२-१०२", "content_sanskrit": "स्थितस्तदैरावणनाम कुंजरे महामनाश्चित्रविभूषणांबरः ।\nविशालवज्रः सुवितानभूषितः प्रकीर्णकेयूरभुजंगमंडलः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000288102, "chapter_id": 20288, "verse_number": "१-४२-१०३", "content_sanskrit": "सहस्रदृग्वंदितपादपल्लवस्त्रिविष्टपे शोभत पाकशासनः ।\nतुरंग मातंग कुलौघसंकुला सितातपत्त्रद्ध्वजशालिनी च ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000288103, "chapter_id": 20288, "verse_number": "१-४२-१०४", "content_sanskrit": "बभूव सा दुर्जयपत्तिसंतता विभाति नानायुधयोधदुस्तरा ।\nततोश्विनौ च मरुतः ससाध्याः सपुरंदराः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000288104, "chapter_id": 20288, "verse_number": "१-४२-१०५", "content_sanskrit": "यक्षराक्षसगंधर्वा दिव्य नानास्त्रपाणयः ।\nजघ्नुर्दैत्येश्वरं सर्वे संभूय तु महाबलाः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000288105, "chapter_id": 20288, "verse_number": "१-४२-१०६", "content_sanskrit": "न चैवास्त्राण्यसज्जंत गात्रे वज्राचलोपमे ।\nअथो रथादवप्लुत्य तारको दानवाधिपः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000288106, "chapter_id": 20288, "verse_number": "१-४२-१०७", "content_sanskrit": "जघान कोटिशो देवान्करपार्ष्णिभिरेव च ।\nहतशेषाणि सैन्यानि देवानां विप्र दुद्रुवुः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7000288107, "chapter_id": 20288, "verse_number": "१-४२-१०८", "content_sanskrit": "दिशो भीतानि संत्यज्य रणोपकरणानि च ।\nदृष्ट्वा तान्विद्रुतान्देवांस्तारको वाक्यमब्रवीत् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7000288108, "chapter_id": 20288, "verse_number": "१-४२-१०९", "content_sanskrit": "मा वधिष्ठ सुरान्दैत्या वज्रांगाय च मंदिरे ।\nशीघ्रमानीय दर्श्यंतां बद्धान्पश्यत्वयं सुरान् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7000288109, "chapter_id": 20288, "verse_number": "१-४२-११०", "content_sanskrit": "लोकपालांस्ततो दैत्यो बद्ध्वा चेंद्रमुखान्रणे ।\nसरुद्रान्सुदृढैः पाशैः पशुपालः पशूनिव ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7000288110, "chapter_id": 20288, "verse_number": "१-४२-१११", "content_sanskrit": "स भूयो रथमास्थाय जगाम स्वकमालयं ।\nसिद्धगंधर्वसंघुष्टं विपुलाचलमस्तकम् ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}]