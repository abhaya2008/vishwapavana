[{"id": 7004857000, "chapter_id": 24857, "verse_number": "७-१-४०-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेन्महादेवि श्वेतकेतुप्रतिष्ठितम् ।\nलिंगं महाप्रभावं तु भीमेनाराधितं पुरा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004857001, "chapter_id": 24857, "verse_number": "७-१-४०-२", "content_sanskrit": "केदारेश्वरसांनिध्ये नातिदूरे व्यवस्थितम् ।\nपूजयते त्तद्विधानेन क्षीरस्नानादिभिः क्रमात् ।\nयात्राफलमभिप्रेप्सुः प्रेत्य स्वर्गफलाय वै ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004857002, "chapter_id": 24857, "verse_number": "७-१-४०-३", "content_sanskrit": "देव्युवाच ।\nश्वेतकेतोस्तु यद्देव लिंगं प्रोक्तं त्वया मम ।\nतस्य जातं कथं देव नाम भीमेश्वरेति च ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004857003, "chapter_id": 24857, "verse_number": "७-१-४०-४", "content_sanskrit": "कथं विनिर्मितं पूर्वं तस्मिन्दृष्टे तु किं फलम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004857004, "chapter_id": 24857, "verse_number": "७-१-४०-५", "content_sanskrit": "ईश्वर उवाच ।\nआसीत्त्रेतायुगे पूर्वं राजा स्वायंभुवेंतरे ।\nश्वेतकेतुरिति ख्यातो राजर्षिः सुमहातपाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004857005, "chapter_id": 24857, "verse_number": "७-१-४०-६", "content_sanskrit": "स प्रभासं समागत्य प्रतिष्ठाप्य महे श्वरम् ।\nतपस्तेपे सुविपुलं सागरस्य तटे शुभे ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004857006, "chapter_id": 24857, "verse_number": "७-१-४०-७", "content_sanskrit": "पंचाग्निसाधको ग्रीष्मे वर्षास्वाकाशगस्तथा ।\nहेमंते जलमध्यस्थो नव वर्षाणि पंच च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004857007, "chapter_id": 24857, "verse_number": "७-१-४०-८", "content_sanskrit": "ततश्चतुर्द्दशे देवि तपसा नियमेन च ।\nतुष्टेनोक्तो मया देवि वरं वरय सुव्रत ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004857008, "chapter_id": 24857, "verse_number": "७-१-४०-९", "content_sanskrit": "श्वेतकेतुरथोवाच भक्तिं देहि सुनिश्चलाम् ।\nस्थानेऽस्मिन्स्थीयतां देव यदि तुष्टोऽसि मे प्रभो ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004857009, "chapter_id": 24857, "verse_number": "७-१-४०-१०", "content_sanskrit": "एवमस्त्वित्यथोक्त्वाऽहं तस्यांतर्द्धानमागतः ।\nततः कालांतरेऽतीते श्वेतकेतुर्महाप्रभः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004857010, "chapter_id": 24857, "verse_number": "७-१-४०-११", "content_sanskrit": "समाराध्य त्विदं लिंगं प्राप्तः स्थानं महोदयम् ।\nततो जातं नाम तस्य श्वेतकेत्वीश्वरं श्रुतम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004857011, "chapter_id": 24857, "verse_number": "७-१-४०-१२", "content_sanskrit": "अग्नितीर्थे महापुण्ये सर्वपातकनाशने ।\nततः कलियुगे प्राप्ते भ्रातृभिश्च समन्वितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004857012, "chapter_id": 24857, "verse_number": "७-१-४०-१३", "content_sanskrit": "तीर्थयात्राप्रसंगेन यदा प्रभासमागतः ।\nभीमसेनो महाबाहुर्वायुपुत्रो ममांशजः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004857013, "chapter_id": 24857, "verse_number": "७-१-४०-१४", "content_sanskrit": "तल्लिंगं पूजयामास कृत्वा जागेश्वरं निजम् ।\nमत्वा तीर्थं महापुण्यं सागरस्य समीपतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004857014, "chapter_id": 24857, "verse_number": "७-१-४०-१५", "content_sanskrit": "तदा प्रभृति भीमेशं पुनर्नामाऽभवच्छुभम् ।\nदृष्टमात्रेण तेनैव सकृल्लिंगेन भामिनि ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004857015, "chapter_id": 24857, "verse_number": "७-१-४०-१६", "content_sanskrit": "अन्यजन्मकृतान्येव पापानि सुबहून्यपि ।\nनाशमायांति सर्वाणि तथैवामुष्मिकाणि तु ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004857016, "chapter_id": 24857, "verse_number": "७-१-४०-१७", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभासखण्डे प्रथमे प्रभासक्षेत्रमाहात्म्ये भीमेश्वरमाहात्म्यवर्णनंनाम चत्वारिंशोऽध्यायः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]