[{"id": 2082167, "chapter_id": 2743, "verse_number": "१२-२४८-०x", "content_sanskrit": "शुक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2082168, "chapter_id": 2743, "verse_number": "१२-२४८-१", "content_sanskrit": "क्षरात्प्रभृति यः सर्गः सगुणानीन्द्रियाणि च।\nबुद्ध्यैश्वर्यातिसर्गोऽयं प्रधानश्चात्मनः श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2082169, "chapter_id": 2743, "verse_number": "१२-२४८-२", "content_sanskrit": "भूय एव तु लोकेऽस्मिन्सद्वृतिं कालहेतुकीम्।\nयया सन्तः प्रवर्तन्ते तदिच्छाम्यनुवर्तितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2082170, "chapter_id": 2743, "verse_number": "१२-२४८-३", "content_sanskrit": "वेदे वचनमुक्तं तु कुरु कर्म त्यजेति च।\nकथमेतद्विजानीयां तच्च व्याख्यातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2082171, "chapter_id": 2743, "verse_number": "१२-२४८-४", "content_sanskrit": "लोकवृत्तान्ततत्वज्ञः पूतोऽहं गुरुशासनात्।\nकृत्वा बुद्धिं विमुक्तात्मा द्रक्ष्याम्यात्मानमव्ययं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2082172, "chapter_id": 2743, "verse_number": "१२-२४८-५x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2082173, "chapter_id": 2743, "verse_number": "१२-२४८-५", "content_sanskrit": "एषा वै विहिता वृत्तिः पुरस्ताद्ब्रह्मणा स्वयम्।\nएषा पूर्वतरैः सद्भिराचीर्णा परमर्षिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2082174, "chapter_id": 2743, "verse_number": "१२-२४८-६", "content_sanskrit": "ब्रह्मचर्येण वै लोकाञ्जयन्ति परमर्षयः।\nआत्मनश्च हृदि श्रेयो ह्यन्विच्छन्मनसाऽऽत्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2082175, "chapter_id": 2743, "verse_number": "१२-२४८-७", "content_sanskrit": "वने मूलफलाशी च तप्यन्सुविपुलं तपः।\nपुण्यायतनचारी च भूतानामविहिंसक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2082176, "chapter_id": 2743, "verse_number": "१२-२४८-८", "content_sanskrit": "विधूमे सन्नमुसले वानप्रस्थप्रतिश्रये।\nकाले प्राप्ते चरन्भैक्षं कल्पते ब्रह्मभूयसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2082177, "chapter_id": 2743, "verse_number": "१२-२४८-९", "content_sanskrit": "निस्तुतिर्निर्नमस्कारः परित्यज्य शुभाशुभे।\nअरण्ये विचरैकाकी येनकेनचिदाशितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2082178, "chapter_id": 2743, "verse_number": "१२-२४८-१०x", "content_sanskrit": "शुक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2082179, "chapter_id": 2743, "verse_number": "१२-२४८-१०", "content_sanskrit": "यदिदं वेदवचनं लोकवादे विरुध्यते।\nप्रमाणे चाप्रमाणे च विरुद्धे शास्त्रतः कुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2082180, "chapter_id": 2743, "verse_number": "१२-२४८-११", "content_sanskrit": "इत्येतच्छ्रोतुमिच्छामि प्रमाणं तूभयं कथम्।\nकर्मणामविरोधेन कथमेतत्प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2082181, "chapter_id": 2743, "verse_number": "१२-२४८-१२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2082182, "chapter_id": 2743, "verse_number": "१२-२४८-१२", "content_sanskrit": "इत्युक्तः प्रत्युवाचेदं गन्धवत्याः सुतः सुतम्।\nऋषिस्तत्पूजयन्वाक्यं पुत्रस्यामिततेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2082183, "chapter_id": 2743, "verse_number": "१२-२४८-१३x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2082184, "chapter_id": 2743, "verse_number": "१२-२४८-१३", "content_sanskrit": "ब्रह्मचारी गृहस्थश्च वानप्रस्थोऽथ भिक्षुकः।\nयथोक्तकारिणः सर्वे गच्छन्ति परमां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2082185, "chapter_id": 2743, "verse_number": "१२-२४८-१४", "content_sanskrit": "एको वाऽप्याश्रमानेतान्योऽनुतिष्ठेद्यथाविधि।\nअकामद्वेषसंयुक्तः स परत्र महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2082186, "chapter_id": 2743, "verse_number": "१२-२४८-१५", "content_sanskrit": "चतुष्पदी हि निःश्रेयणी ब्रह्मण्येषा प्रतिष्ठिता।\nएतामाश्रित्य निःश्रेणीं ब्रह्मलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2082187, "chapter_id": 2743, "verse_number": "१२-२४८-१६", "content_sanskrit": "आयुषस्तु चतुर्भागं ब्रह्मचार्यनसूयकः।\nगुरौ वा गुरुपुत्रे वा वसेद्धर्मार्थकोविदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2082188, "chapter_id": 2743, "verse_number": "१२-२४८-१७", "content_sanskrit": "जघन्यशायी पूर्वं स्यादुत्थाय गुरुवेश्मनि।\nयच्च शिष्येण कर्तव्यं कार्यं दासेन वा पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2082189, "chapter_id": 2743, "verse_number": "१२-२४८-१८", "content_sanskrit": "कृतमित्येव तत्सर्वं कृत्वा तिष्ठेत पार्श्वतः।\nकिंकरः सर्वकारी स्यात्सर्वकर्मसु कोविदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2082190, "chapter_id": 2743, "verse_number": "१२-२४८-१९", "content_sanskrit": "कर्मातिशेषेण गुरावध्येतव्यं बुभूषता।\nदक्षिणेनोपसादी स्यादाकूतो नुल्माश्रयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2082191, "chapter_id": 2743, "verse_number": "१२-२४८-२०", "content_sanskrit": "शुचिर्दक्षो गुणोपेतो ब्रूयादिष्टमिवान्तरा।\nचक्षुष गुरुमव्यग्रो निरीक्षेत जितेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2082192, "chapter_id": 2743, "verse_number": "१२-२४८-२१", "content_sanskrit": "नाभुक्तवति चाश्नीयादपीतवति नो पिबेत्।\nनातिष्ठति तथासीत नासुप्ते प्रस्वपेत च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2082193, "chapter_id": 2743, "verse_number": "१२-२४८-२२", "content_sanskrit": "उत्तानाभ्यां च पाणिभ्यां पादावस्य मृदु स्पृशेत्।\nदक्षिणं दक्षिणेनैव सव्यं सव्येन पीडयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2082194, "chapter_id": 2743, "verse_number": "१२-२४८-२३", "content_sanskrit": "अभिवाद्य गुरुं ब्रूयादधीष्व भगवन्निति।\nइदं करिष्ये भगवन्निदं चापि कृतं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2082195, "chapter_id": 2743, "verse_number": "१२-२४८-२४", "content_sanskrit": "ब्रह्मंस्तदपि कर्ताऽस्मि यद्भावन्वक्ष्यते पुनः।\nइति सर्वमनुज्ञाप्य निवेद्य गुरवे पुनः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2082196, "chapter_id": 2743, "verse_number": "१२-२४८-२५", "content_sanskrit": "कुर्यात्कृत्वा च तत्सर्वमाख्येयं गुरवे पुनः।\nयांस्तु गन्धान्रसान्वाऽपि ब्रह्मचारी न सेवते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2082197, "chapter_id": 2743, "verse_number": "१२-२४८-२६", "content_sanskrit": "सेवेत तान्समावृत्त इति धर्मेषु निश्चयः।\nये केचिन्नियमेनोक्ता नियमा ब्रह्मचारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2082198, "chapter_id": 2743, "verse_number": "१२-२४८-२७", "content_sanskrit": "तान्सर्वाननुगृह्णीयाद्भवेच्चानपगो गुरोः।\nस एवं गुरवे प्रीतिमुपहृत्य यथाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2082199, "chapter_id": 2743, "verse_number": "१२-२४८-२८", "content_sanskrit": "अग्राम्येणा मेष्वेवं शिष्यो वर्तते कर्मणा।\nवदव्रतोपवासेन चतुर्थे च-------।\nगुरवे दक्षिणां दत्त्वा समावतेद्यथातिधि----॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2082200, "chapter_id": 2743, "verse_number": "१२-२४८-२९", "content_sanskrit": "धर्मलब्धैर्युतो दारैरग्नीनुत्पाद्य यनतः।\nद्वितीयमायुषो भागं गृहमेधी भवेद्व्रती॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2082201, "chapter_id": 2743, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि अष्टचत्वारिंशदधिकद्विशततमोऽध्यायः॥ २४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]