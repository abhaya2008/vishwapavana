[{"id": 2205136, "chapter_id": 5370, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2205137, "chapter_id": 5370, "verse_number": "१", "content_sanskrit": "भगवन् देवदेवेश कथं देयं तिलान्वितम् ।\nतस्य तस्य फलं ब्रूहि दत्तस्य च कृतस्य च\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2205138, "chapter_id": 5370, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2205139, "chapter_id": 5370, "verse_number": "२", "content_sanskrit": "तिलकल्पविधिं देवि तन्मे शृणु समाहिता\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2205140, "chapter_id": 5370, "verse_number": "३", "content_sanskrit": "समृद्धैरसमृद्धैर्वा तिला देया विशेषतः ।\nतिलाः पवित्राः पापघ्नाः सुपुण्या इति संस्मृताः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2205141, "chapter_id": 5370, "verse_number": "४", "content_sanskrit": "न्यायतस्तु तिलान् शुद्धान् संहृत्याथ स्वशक्तिनः ।\nतिलराशिं पुनः कुर्यात् पर्वताभं सुरत्नकम् ।\nमहान्तं यदि वा स्तोकं नानाद्रव्यसमायुतम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2205142, "chapter_id": 5370, "verse_number": "५", "content_sanskrit": "सुवर्णरजताभ्यां च मणिमुक्ताप्रवाळकैः ।\nअलङ्कृत्य यथायोगं सपताकं सवेदिकम् ।\nसभूषणं सवस्त्रं च शयनासनसंयुतम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2205143, "chapter_id": 5370, "verse_number": "६", "content_sanskrit": "प्रायशः कौमुदीमासे पौर्णमास्यां विशेषतः ।\nभोजयित्वा च विधिवद् ब्राह्मणानर्हतो बहून्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2205144, "chapter_id": 5370, "verse_number": "७", "content_sanskrit": "स्वयं कृतोपवासं च वृत्तशौचसमन्वितः ।\nदद्यात् प्रदक्षिणीकृत्य तिलराशिं सदक्षिणम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2205145, "chapter_id": 5370, "verse_number": "८", "content_sanskrit": "एकस्य वा बहूनां वा दातव्यं भूतिमिच्छता ।\nतस्य दानफलं देवि अग्निष्टोमेन सम्मितम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2205146, "chapter_id": 5370, "verse_number": "९", "content_sanskrit": "केवलं वा तिलैरेव भूमौ कृत्वा गवाकृतिम् ।\nसवस्त्रकं सवत्सं च पुंसा गोदानकाङ्क्षिणा ।\nतदर्हाय प्रदातव्यं तस्य गोदानवत् फलम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2205147, "chapter_id": 5370, "verse_number": "१०", "content_sanskrit": "शरावांस्तिलसम्पूर्णान् सहिरण्यान् सचम्पकान् ।\nजलैर्ददद् ब्राह्मणाय स पुण्यफलभाग् भवेत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2205148, "chapter_id": 5370, "verse_number": "११", "content_sanskrit": "एवं तिलमयं देयं नरेण हितमिच्छता ।\nनानादानफलं भूयः शृणु देवि समाहिता\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2205149, "chapter_id": 5370, "verse_number": "१२", "content_sanskrit": "बलमायुष्यमारोग्यमन्नदानाल्लभेन्नरः ।\nपानीयदस्तु सौभाग्यं रसज्ञानं लभेन्नरः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2205150, "chapter_id": 5370, "verse_number": "१३", "content_sanskrit": "वस्त्रदानाद् वपुःशोभामलङ्कारं लभेन्नरः ।\nदीपदो बुद्धिवैमल्यं द्युतिं शोभां लभेत् पुनः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2205151, "chapter_id": 5370, "verse_number": "१४", "content_sanskrit": "राजपीडाविमोक्षं तच्छत्रदो लभते फलम् ।\nदासीदासप्रदानात्तु भवेत् कर्मान्तभाङ् नरः ।\nदासीदासं च विविधं लभेत् प्रेत्य गुणान्वितम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2205152, "chapter_id": 5370, "verse_number": "१५", "content_sanskrit": "यानानि वाहनं चैव तदर्हाय ददन्नरः ।\nपादरोगपरिक्लेशान्मुक्तश्चोत्साहवान् भवेत् ।\nविचित्रं रमणीयं च लभते यानवाहनम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2205153, "chapter_id": 5370, "verse_number": "१६", "content_sanskrit": "प्रतिश्रयप्रदानं च तदर्हाय तदिच्छते ।\nवर्षाकाले तु रात्रौ वा लभेत् पक्षबलं शुभम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2205154, "chapter_id": 5370, "verse_number": "१७", "content_sanskrit": "सेतुकूपतटाकानां कर्ता तु लभते नरः ।\nदीर्घायुष्ट्वं च सौभाग्यं तथा प्रेत्यायतीं शुभाम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2205155, "chapter_id": 5370, "verse_number": "१८", "content_sanskrit": "वृक्षपङ्क्तिकरो यस्तु छायापुष्पफलप्रदः ।\nप्रेत्यभावे लभेत् पुण्यमभिगम्यो भवेन्नरः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2205156, "chapter_id": 5370, "verse_number": "१९", "content_sanskrit": "यस्तु सङ्क्रमकृल्लोके नदीषु जलतारिणाम् ।\nलभेत् पुण्यफलं प्रेत्य व्यसनेभ्यो विमोक्षणम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2205157, "chapter_id": 5370, "verse_number": "२०", "content_sanskrit": "मार्गकृत् सततं मर्त्यो भवेत् सन्तानवान् पुनः ।\nकायदोषविमुक्तस्तु तीर्थकृत् सततं भवेत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2205158, "chapter_id": 5370, "verse_number": "२१", "content_sanskrit": "औषधानां प्रदाता च सततं कृपयाऽन्वितः ।\nभवेद् व्याधिविहीनश्च दीर्घायुश्च विशेषतः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2205159, "chapter_id": 5370, "verse_number": "२२", "content_sanskrit": "अनाथान् पोषयेद् यस्तु कृपणान्धकपङ्गुकान् ।\nस च पुण्यफलं प्रेत्य लभते कृच्छ्रमोक्षणम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2205160, "chapter_id": 5370, "verse_number": "२३", "content_sanskrit": "देवगोष्ठान् सभाः शाला भिक्षूणां च प्रतिश्रयम् ।\nयः कुर्याल्लभते नित्यं नरः प्रेत्य फलं शुभम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2205161, "chapter_id": 5370, "verse_number": "२४", "content_sanskrit": "प्रासादवासं विविधं पक्षशोभां लभेन्नरः ।\nविविधं विविधाकारं भक्ष्यभोज्यगुणान्वितम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2205162, "chapter_id": 5370, "verse_number": "२५", "content_sanskrit": "रम्यं सदैव गोवाटं यः कुर्याल्लभते नरः ।\nप्रेत्यभावे शुभां जातिं व्याधिमोक्षं तथैव च\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2205163, "chapter_id": 5370, "verse_number": "२६", "content_sanskrit": "एवं नानाविधं द्रव्यं दाता कर्ता लभेत् फलम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2205164, "chapter_id": 5370, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2205165, "chapter_id": 5370, "verse_number": "२७", "content_sanskrit": "कृतं दत्तं यथा यावत् तस्य तल्लभते फलम् ।\nएतन्मे देवदेवेश तत्र कौतूहलं महत्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2205166, "chapter_id": 5370, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2205167, "chapter_id": 5370, "verse_number": "२८", "content_sanskrit": "प्रेत्यभावे शृणु फलं दत्तस्य च कृतस्य च ।\nदानं षङ्गुणयुक्तं तु तदर्हाय यथाविधि ।\nयथाविभवतो दानं दातव्यमिति मानवैः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2205168, "chapter_id": 5370, "verse_number": "२९", "content_sanskrit": "बुद्धिमायुष्यमारोग्यं कुलं भाग्यं तथाऽऽगमम् ।\nरूपेण सप्तधा भूत्वा मानुष्यं फलति ध्रुवम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2205169, "chapter_id": 5370, "verse_number": "३०", "content_sanskrit": "इदं दत्तमिदं मे स्यादित्येवं फलकाङ्क्षया ।\nयद् दत्तं तत् तदेव स्यान्न तु किञ्चन लभ्यते\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2205170, "chapter_id": 5370, "verse_number": "३१", "content_sanskrit": "ध्रुवं देव्युत्तमे दानं मध्यमे त्वधमं फलम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2205171, "chapter_id": 5370, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nअनुशासनपर्वणि दानधर्मे अन्नदानगोदानसुवर्णदानप्रशंसा नाम एकविंशोत्तरद्विशततमोऽध्यायः ॥२२१॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]