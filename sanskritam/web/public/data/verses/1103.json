[{"id": 2005256, "chapter_id": 1103, "verse_number": "१-१०४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2005257, "chapter_id": 1103, "verse_number": "१-१०४-१", "content_sanskrit": "एतच्छ्रुत्वा वचो राज्ञः सस्मितं मृदु वल्गु च।\nयशस्विनी च साऽगच्छच्छान्तनोर्भूतये तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2005258, "chapter_id": 1103, "verse_number": "१-१०४-२", "content_sanskrit": "सा तु दृष्ट्वा नृपश्रेष्ठं चरन्तं तीरमाश्रितम्।\nवसूनां समयं स्मृत्वाऽथाभ्यगच्छदनिन्दिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2005259, "chapter_id": 1103, "verse_number": "१-१०४-३", "content_sanskrit": "प्रजार्थिनी राजपुत्रं शान्तनुं पृथिवीपतिम्।\nप्रतीपवचनं चापि संस्मृत्यैव स्वयं नृपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2005260, "chapter_id": 1103, "verse_number": "१-१०४-४", "content_sanskrit": "कालोऽयमिति मत्वा सा वसूनां शापचोदिता।\nउवाच चैव राज्ञः सा ह्लादयन्ती मनो गिरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2005261, "chapter_id": 1103, "verse_number": "१-१०४-५x", "content_sanskrit": "गङ्गोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2005262, "chapter_id": 1103, "verse_number": "१-१०४-५", "content_sanskrit": "भविष्यामि महीपाल महिषी ते वशानुगा।\nन तु त्वं वा द्वितीयो वा ज्ञातुमिच्छेत्कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2005263, "chapter_id": 1103, "verse_number": "१-१०४-६", "content_sanskrit": "यत्तु कुर्यामहं राजञ्शुभं वा यदि वाऽशुभम्।\nन तद्वारयितव्याऽस्मि न वक्तव्या तथाऽप्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2005264, "chapter_id": 1103, "verse_number": "१-१०४-७", "content_sanskrit": "एवं हि वर्तमानेऽहं त्वयि वत्स्यामि पार्थिव।\nवारिता विप्रियं चोक्ता त्यजेयं त्वामसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2005265, "chapter_id": 1103, "verse_number": "१-१०४-८", "content_sanskrit": "एष मे समयो राजन्भज मां त्वं यथेप्सितम्।\nअनुनीताऽस्मि ते पित्रा भर्ता मे त्वं भव प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2005266, "chapter_id": 1103, "verse_number": "१-१०४-९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2005267, "chapter_id": 1103, "verse_number": "१-१०४-९", "content_sanskrit": "तथेति सा यदा तूक्ता तदा भरतसत्तम।\nप्रहर्षमतुलं लेभे प्राप्य तं पार्थिवोत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2005268, "chapter_id": 1103, "verse_number": "१-१०४-१०", "content_sanskrit": "प्रतिज्ञाय तु तत्तस्यास्तथेति मनुजाधिपः।\nरथमारोप्य तां देवीं जगाम स तया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2005269, "chapter_id": 1103, "verse_number": "१-१०४-११", "content_sanskrit": "सा च शान्तनुमभ्यागात्साक्षाल्लक्ष्मीरिवापरा।\nआसाद्य शान्तनुस्तां च बुभुजे कामतो वशी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2005270, "chapter_id": 1103, "verse_number": "१-१०४-१२", "content_sanskrit": "न प्रष्टव्येति मन्वानो न स तां किंचिदूचिवान्।\nस तस्याः शीलवृत्तेन रूपौदार्यगुणेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2005271, "chapter_id": 1103, "verse_number": "१-१०४-१३", "content_sanskrit": "उपचारेण च रहस्तुतोष जगतीपतिः।\nस राजा परमप्रीतः परमस्त्रीप्रलालितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2005272, "chapter_id": 1103, "verse_number": "१-१०४-१४", "content_sanskrit": "दिव्यरूपा हि सा देवी गङ्गा त्रिपथगामिनी।\nमानुषं विग्रहं कृत्वा श्रीमन्तं वरवर्णिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2005273, "chapter_id": 1103, "verse_number": "१-१०४-१५", "content_sanskrit": "भाग्योपनतकामस्य भार्या चोपनताऽभवत्।\nशन्तनोर्नृपसिंहस्य देवराजसमद्युतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2005274, "chapter_id": 1103, "verse_number": "१-१०४-१६", "content_sanskrit": "संभोगस्नेहचातुर्यैर्हावलास्यैर्मनोहरैः।\nराजानं रमयामास यथा रज्येत स प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2005275, "chapter_id": 1103, "verse_number": "१-१०४-१७", "content_sanskrit": "स राजा रतिसक्तोऽभूदुत्तमस्त्रीगुणैर्हृतः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2005276, "chapter_id": 1103, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि चतुरधिकशततमोऽध्यायः॥ १०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]