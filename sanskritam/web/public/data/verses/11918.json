[{"id": 50024851, "chapter_id": 11918, "verse_number": "1", "content_sanskrit": "आत्मस्वभावभेदस्य विदोषत्वेन चाखिलः। प्रत्यक्षादिविरोधाच्च दुष्टः पक्षोऽयमञ्जसा॥ ११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024852, "chapter_id": 11918, "verse_number": "2", "content_sanskrit": "चेष्टालिङ्गेन सात्मत्वे परदेहस्य साधिते। अन्यत्वं स्वात्मनस्तस्मात् सर्वैरेवानुभूयते॥ १२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024853, "chapter_id": 11918, "verse_number": "3", "content_sanskrit": "अज्ञता चाल्पशक्तित्वं दुःखित्वं स्वल्पकर्तृता। सर्वज्ञतादीशगुणविरुद्धा ह्यनुभूतिगाः॥ १३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024854, "chapter_id": 11918, "verse_number": "4", "content_sanskrit": "सार्वज्ञादिगुणा विष्णोः श्रुतिषु प्रतिपादिताः। “सत्यः सो अस्य महिमा” (कुत्र: ऋग्वेदसंहिताया ८/३/४) इत्यादिवाक्यान्मृषा नच॥ १४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50024855, "chapter_id": 11918, "verse_number": "5", "content_sanskrit": "नच वेदोक्तमिथ्यात्वे मानं तन्मानताऽपि न।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}]