[{"id": 2078665, "chapter_id": 2671, "verse_number": "१२-१७६-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2078666, "chapter_id": 2671, "verse_number": "१२-१७६-१", "content_sanskrit": "ईहमानः समारम्भान्यदि नासादयेद्धनम्।\nधनतृष्णाभिभूतश्च किं कुर्वन्सुखमाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2078667, "chapter_id": 2671, "verse_number": "१२-१७६-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2078668, "chapter_id": 2671, "verse_number": "१२-१७६-२", "content_sanskrit": "सर्वसाम्यमनायासः सत्यवाक्यं च भारत।\nनिर्वेदश्चाविधित्सा च यस्य स्यात्स सखी नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2078669, "chapter_id": 2671, "verse_number": "१२-१७६-३", "content_sanskrit": "एतान्येव पदान्याहुः पञ्च वृद्धाः प्रशान्तये।\nएष स्वर्गश्च धर्मश्च सुखं चानुत्तमं सताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2078670, "chapter_id": 2671, "verse_number": "१२-१७६-४", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nनिर्वेदान्मङ्किना गीतं तन्निबोध युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2078671, "chapter_id": 2671, "verse_number": "१२-१७६-५", "content_sanskrit": "ईहमानो धनं मङ्किर्भग्नेहश्च पुनः पुनः।\nकेनचिद्धनलेशेन क्रीतवान्दम्यगोयुगम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2078672, "chapter_id": 2671, "verse_number": "१२-१७६-६", "content_sanskrit": "सुसंबद्धौ तु तौ दम्यौ दमनायाभिनिःसृतौ।\nआसीनमुष्ट्रं मध्येन सहसैवाभ्यधावताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2078673, "chapter_id": 2671, "verse_number": "१२-१७६-७", "content_sanskrit": "तयोः संप्राप्तयोरुष्ट्रः स्कन्धदेशममर्पणः।\nउत्थायोत्क्षिप्य तौ दम्यौ पससार महाजवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2078674, "chapter_id": 2671, "verse_number": "१२-१७६-८", "content_sanskrit": "ह्रियमाणौ तु तौ दम्यौ तेनोष्ट्रेण प्रमाथिना।\nप्रियमाणौ च संप्रेक्ष्य मङ्किस्तत्राब्रवीदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2078675, "chapter_id": 2671, "verse_number": "१२-१७६-९", "content_sanskrit": "न जात्वविहितं शक्यं दक्षेणाषीहितुं धनम्।\nयुक्तेन श्रद्धया सम्यगीहां समनुतिष्ठता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2078676, "chapter_id": 2671, "verse_number": "१२-१७६-१०", "content_sanskrit": "पूर्वमर्यैर्विहीनस्य युक्तस्याप्युतिष्ठतः।\nइमं पश्यत संगत्या मम दैवमुपप्लवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2078677, "chapter_id": 2671, "verse_number": "१२-१७६-११", "content_sanskrit": "उद्यम्योद्यम्य मे दम्यौ विषमेणैव गच्छतः।\nउत्क्षिप्य काकतालीयमुन्माथेनेव जम्बुकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2078678, "chapter_id": 2671, "verse_number": "१२-१७६-१२", "content_sanskrit": "मणीवोष्ट्रस्य लम्वेते प्रियौ वत्सतरौ मम।\nशुद्वं हि दैवमेवेदं हठे नैवास्ति पौरुषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2078679, "chapter_id": 2671, "verse_number": "१२-१७६-१३", "content_sanskrit": "यदि वाऽप्युपपद्येत पौरुषं नाम कर्हिचित्।\nअन्विष्यमाणं तदपि दैवमेवावतिष्ठते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2078680, "chapter_id": 2671, "verse_number": "१२-१७६-१४", "content_sanskrit": "तस्मान्निर्वेद एवेह गन्तव्यः सुखभीप्सता।\nसुखं स्वपिति निर्विण्णो निराशश्चार्थसाधने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2078681, "chapter_id": 2671, "verse_number": "१२-१७६-१५", "content_sanskrit": "अहो सम्यक्शुकेनोक्तं सर्वतः परिमुच्यता।\nप्रतिष्ठता महारण्यं जनकस्य निवेशनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2078682, "chapter_id": 2671, "verse_number": "१२-१७६-१६", "content_sanskrit": "यः कामानाप्नुयात्सर्वान्यश्चैतान्केवलांस्त्यजेत्।\nप्रापणात्सर्वकामानां परित्यागो विशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2078683, "chapter_id": 2671, "verse_number": "१२-१७६-१७", "content_sanskrit": "नान्तं सर्वविधित्सानां गतपूर्वोऽस्ति कश्चन।\nशरीरे जीविते चैव तृष्णा मर्त्यस्य वर्धते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2078684, "chapter_id": 2671, "verse_number": "१२-१७६-१८", "content_sanskrit": "निवर्तस्य विधित्साभ्यः शाम्य निर्विद्य कामुक।\nअसकृच्चासि निकृतो न च निर्विद्यसे मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2078685, "chapter_id": 2671, "verse_number": "१२-१७६-१९", "content_sanskrit": "यदि नाहं विनाश्यस्ते यद्येवं रमसे मया।\nमा मां योजय लोभेन वृथाऽत्वं वित्तकामुक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2078686, "chapter_id": 2671, "verse_number": "१२-१७६-२०", "content_sanskrit": "संचितं संचितं द्रव्यं नष्टं तव पुनः पुनः।\nकदा तां मोक्ष्यसे मूढ धनेहां धनकामुक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2078687, "chapter_id": 2671, "verse_number": "१२-१७६-२१", "content_sanskrit": "अहो नु मम बालिश्यं योऽहं क्रीडनकस्तव।\n`क्लेशैर्नानाविधैर्नित्यं संयोजयसि निर्घृणः।\nकिं नैवं जातु पुरुषः परेषां प्रेष्यतामियात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2078688, "chapter_id": 2671, "verse_number": "१२-१७६-२२", "content_sanskrit": "न पूर्वे नापरे जातु कामानामन्तमाप्नुवन्।\nत्यक्त्वा सर्वसमारम्भान्प्रतिबुद्धोऽस्मि जागृमि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2078689, "chapter_id": 2671, "verse_number": "१२-१७६-२३", "content_sanskrit": "नूनं मे हृदयं कामं वज्रसारमयं दृढम्।\nयदनर्थशताविष्टं शतधा न विदीर्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2078690, "chapter_id": 2671, "verse_number": "१२-१७६-२४", "content_sanskrit": "त्यजामि काम त्वां चैव यच्च किंचित्प्रियं तव।\nतवाहं प्रियमन्विच्छन्नात्मन्युपलभे सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2078691, "chapter_id": 2671, "verse_number": "१२-१७६-२५", "content_sanskrit": "काम जानामि ते मूलं संकल्पात्किल जायसे।\nन त्वां संकल्पयिष्यामि समूलो नभविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2078692, "chapter_id": 2671, "verse_number": "१२-१७६-२६", "content_sanskrit": "ईहा धनस्य न सुखा लुब्ध्वा चिन्ता च भूयसी।\nलब्धनाशो यथा मृत्युर्लब्धं भवति वा न वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2078693, "chapter_id": 2671, "verse_number": "१२-१७६-२७", "content_sanskrit": "परित्यागे न लभते ततो दुःखतरं नु किम्।\nन च तुष्यति लब्धेन भूय एव च मार्गति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2078694, "chapter_id": 2671, "verse_number": "१२-१७६-२८", "content_sanskrit": "अनुतर्पुल एवार्थः स्वादु गाङ्गभिवोदकम्।\nमद्विलापनमेततु प्रतिबुद्धोऽस्मि संत्यज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2078695, "chapter_id": 2671, "verse_number": "१२-१७६-२९", "content_sanskrit": "य इमं मामकं देहं भूतग्रामः समाश्रितः।\nस यात्वितो यथाकामं वसतां वा यथासुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2078696, "chapter_id": 2671, "verse_number": "१२-१७६-३०", "content_sanskrit": "न युष्मास्विह मे प्रीतिः कामलोभानुसारिषु।\nतस्मादुत्सृज्य वः सर्वान्सत्वमेवाश्रयाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2078697, "chapter_id": 2671, "verse_number": "१२-१७६-३१", "content_sanskrit": "सर्व भूतान्यहं देहे पश्यन्मनसि चात्मनः।\nयोगे बुद्धिं श्रुते सत्वं मनो ब्रह्मणि धारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2078698, "chapter_id": 2671, "verse_number": "१२-१७६-३२", "content_sanskrit": "विहरिष्याम्यनासक्तः सुखी लोकान्निरामयः।\nयथा मां त्वं पुनर्नैवं दुःखेषु प्रणिधास्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2078699, "chapter_id": 2671, "verse_number": "१२-१७६-३३", "content_sanskrit": "त्वया हि मे प्रणुन्नस्य गतिरन्या न विद्यते।\nतृष्णा शोकश्रमाणां हि त्वं काम प्रभवः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2078700, "chapter_id": 2671, "verse_number": "१२-१७६-३४", "content_sanskrit": "धननाशेऽधिकं दुःखं मन्ये सर्वमहत्तरम्।\nज्ञातयो ह्यवमन्यन्ते मित्राणि च धनाच्च्युतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2078701, "chapter_id": 2671, "verse_number": "१२-१७६-३५", "content_sanskrit": "अवज्ञानसहस्रैस्तु दोषाः कष्टतराऽधने।\nधने सुखकला या तु साऽपि दुःखैर्विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2078702, "chapter_id": 2671, "verse_number": "१२-१७६-३६", "content_sanskrit": "धनमस्येति पुरुषं पुरो निघ्नन्ति दस्यवः।\nक्लिश्यन्ति विविधैर्दण्डैर्नित्यमुद्वेजयन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2078703, "chapter_id": 2671, "verse_number": "१२-१७६-३७", "content_sanskrit": "धनलोलुपता दुःखमिति बुद्धं चिरान्मया।\nयद्यदालम्बसे कामं तत्तदेवानुरुध्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2078704, "chapter_id": 2671, "verse_number": "१२-१७६-३८", "content_sanskrit": "अतत्त्वज्ञोऽसि बालश्च दुस्तोषोऽपूरणोऽनलः।\nनैव त्वं वेत्थ सुलभं नैव त्वं वेत्थ दुर्लभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2078705, "chapter_id": 2671, "verse_number": "१२-१७६-३९", "content_sanskrit": "पाताल इव दुष्पूरो मां दुःखैर्योक्तुमिच्छसि।\nनाहमद्य समावेष्टुं शक्यः काम पुनस्त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2078706, "chapter_id": 2671, "verse_number": "१२-१७६-४०", "content_sanskrit": "निर्वेदमहमासाद्य द्रव्यनाशाद्यदृच्छया।\nनिवृत्तिं परमां प्राप्य नाद्य कामान्विचिन्तये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2078707, "chapter_id": 2671, "verse_number": "१२-१७६-४१", "content_sanskrit": "अतिक्लेशान्सहामीह नाहं बुद्ध्याम्यबुद्धिमान्।\nनिकृतो धननाशेन शये सर्वाङ्गविज्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2078708, "chapter_id": 2671, "verse_number": "१२-१७६-४२", "content_sanskrit": "परित्यजामि काम त्वां हित्वा सर्वं मनोगतम्।\nन त्वं मया पुनः काम नस्योतेनेव रंस्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2078709, "chapter_id": 2671, "verse_number": "१२-१७६-४३", "content_sanskrit": "क्षमिष्ये क्षिपमाणानां न हिंसिष्ये विहिंसितः।\nद्वेष्यमुक्तः प्रियं वक्ष्याम्यनादृत्य तदप्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2078710, "chapter_id": 2671, "verse_number": "१२-१७६-४४", "content_sanskrit": "तृप्तः स्वस्थेन्द्रियो नित्यं यथालब्धेन वर्तयन्।\nन सकामं करिष्यामि त्वामहं शत्रुमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2078711, "chapter_id": 2671, "verse_number": "१२-१७६-४५", "content_sanskrit": "निर्वेदं निर्वृतिं तृप्तिं शान्तिं सत्यं दमं क्षमाम्।\nसर्वभूतदयां चैव विद्धि मां शरणागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2078712, "chapter_id": 2671, "verse_number": "१२-१७६-४६", "content_sanskrit": "तस्मात्कामश्च लोभश्च तृष्णा कार्पण्यमेव च।\nत्यजन्तु मां प्रतिष्ठन्तं सत्वस्थो ह्यस्मि सांप्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2078713, "chapter_id": 2671, "verse_number": "१२-१७६-४७", "content_sanskrit": "प्रहाय कामं लोभं च क्रोधं पारुष्यमेव च।\nनाद्य लोभवशं प्राप्तो दुःखं प्राप्स्याम्यनात्मवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2078714, "chapter_id": 2671, "verse_number": "१२-१७६-४८", "content_sanskrit": "यद्यस्त्यजति कामानां तत्सुखस्याभिपूर्यते।\nकामस्य वशगो नित्यं दुःखमेव प्रपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2078715, "chapter_id": 2671, "verse_number": "१२-१७६-४९", "content_sanskrit": "कामानुबन्धं नुदते यत्किंचित्पुरुषो रजः।\nकामक्रोधोद्भवं दुःखमह्रीररतिरेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2078716, "chapter_id": 2671, "verse_number": "१२-१७६-५०", "content_sanskrit": "एष ब्रह्मप्रतिष्ठोऽहं ग्रीष्मे शीतमिव ह्रदम्।\nशाम्यामि परिनिर्वामि सुखमासे च केवलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2078717, "chapter_id": 2671, "verse_number": "१२-१७६-५१", "content_sanskrit": "यच्च कामसुखं लोके यच्च दिव्यं महत्सुखम्।\nतृष्णाक्षयसुखस्यैते नार्हतः षोडशीं कलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2078718, "chapter_id": 2671, "verse_number": "१२-१७६-५२", "content_sanskrit": "आत्मना सप्तमं कामं हत्वा शत्रुमिवोत्तमम्।\nप्राप्यावध्यं ब्रह्मपुरं राजेव च वसाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2078719, "chapter_id": 2671, "verse_number": "१२-१७६-५३", "content_sanskrit": "एतां बुद्धिं समास्थाय मङ्किर्निर्वेदमागतः।\nसर्वान्कामान्परित्यज्य प्राप्य ब्रह्म महत्सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2078720, "chapter_id": 2671, "verse_number": "१२-१७६-५४", "content_sanskrit": "दम्यनाशकृते मङ्किरमृतत्वं किलागमत्।\nअच्छिनत्काममूलं स तेन प्राप परां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2078721, "chapter_id": 2671, "verse_number": "१२-१७६-५५", "content_sanskrit": "अत्राप्युदाहरन्तीमं श्लोकं मोक्षोपसंहितम्।\nगीतं विदेहराजेन जनकेन प्रशाम्यता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2078722, "chapter_id": 2671, "verse_number": "१२-१७६-५६", "content_sanskrit": "अनन्तमिव मे वित्तं यस्य मे नास्ति किंचन।\nमिथिलायां प्रदीप्तायां न मे दह्यति किंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2078723, "chapter_id": 2671, "verse_number": "१२-१७६-५७", "content_sanskrit": "अत्रैवोदाहरन्तीमं बोध्यस्य पदसंचयम्।\nनिर्वेदं प्रति विन्यस्तं तं निबोध युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2078724, "chapter_id": 2671, "verse_number": "१२-१७६-५८", "content_sanskrit": "बोध्यं शान्तमृषिं राजा नाहुषः पर्यपृच्छत।\nनिर्वेदाच्छान्तिमापन्नं शास्त्रप्रज्ञानतर्पितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2078725, "chapter_id": 2671, "verse_number": "१२-१७६-५९", "content_sanskrit": "उपदेशं महाप्राज्ञ शमस्योपदिशस्व मे।\nकां बुद्धिं समनुप्राप्य शान्तश्चरसि निर्वृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2078726, "chapter_id": 2671, "verse_number": "१२-१७६-६०x", "content_sanskrit": "बोध्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2078727, "chapter_id": 2671, "verse_number": "१२-१७६-६०", "content_sanskrit": "उपदेशेन वर्तामि नानुशास्मीह कंचन।\nलक्षणं तस्य वक्ष्येऽहं तत्स्वयं परिमृष्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2078728, "chapter_id": 2671, "verse_number": "१२-१७६-६१", "content_sanskrit": "पिङ्गला कुररः सर्पः सारङ्गान्वेषणं वने।\nइषुकारः कुमारी च षडेते गुरवो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2078729, "chapter_id": 2671, "verse_number": "१२-१७६-६२x", "content_sanskrit": "[*भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2078730, "chapter_id": 2671, "verse_number": "१२-१७६-६२", "content_sanskrit": "आशा बलवती राजन्नैराश्यं परमं सुखम्।\nआशां निराशां कृत्वा तु सुखं स्वपिति पिङ्गला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2078731, "chapter_id": 2671, "verse_number": "१२-१७६-६३", "content_sanskrit": "सामिषं कुररं दृष्ट्वा वध्यमानं निरामिषैः।\nआमिषस्य परित्यागात्कुररः सुखमेधते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2078732, "chapter_id": 2671, "verse_number": "१२-१७६-६४", "content_sanskrit": "गृहारम्भो हि दुःखाय न सुखाय कदाचन।\nसर्पः परकृतं वेश्म प्रविश्य सुखमेधते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2078733, "chapter_id": 2671, "verse_number": "१२-१७६-६५", "content_sanskrit": "सुखं जीवन्ति मुनयो भैक्ष्यवृत्तिं समाश्रिताः।\nअद्रोहणैव भूतानां सारङ्ग इव पक्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2078734, "chapter_id": 2671, "verse_number": "१२-१७६-६६", "content_sanskrit": "`अल्पेभ्यश्च महद्भ्यश्च शास्त्रेभ्यो मतिमान्नरः।\nसर्वतः सारमादद्यात्पुष्पेभ्य इव षट्पदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2078735, "chapter_id": 2671, "verse_number": "१२-१७६-६७", "content_sanskrit": "इषुकारो नरः कश्चिदिपावासक्तमानसः।\nसमीपेनापि गच्छन्तं राजानं नावबुद्धवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2078736, "chapter_id": 2671, "verse_number": "१२-१७६-६८", "content_sanskrit": "बहूनां कलहो नित्यं द्वयोः संकथनं ध्रुवम्।\nएकाकी विचरिष्यानि कुमारीशङ्खको यथा॥] ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2078737, "chapter_id": 2671, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि षट्सप्तत्यधिकशततमोऽध्यायः॥ १७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}]