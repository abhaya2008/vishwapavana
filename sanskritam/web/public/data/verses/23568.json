[{"id": 7003568000, "chapter_id": 23568, "verse_number": "२०८-१", "content_sanskrit": "अथ पतिव्रतोपाख्यानवर्णनम् ।\nऋषिपुत्र उवाच ।\nमुहूर्त्तस्य तु कालस्य दिव्याभरणभूषितान् ।\nप्रयातान्दिवि संप्रेक्ष्य विमानैः सूर्यसन्निभैः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003568001, "chapter_id": 23568, "verse_number": "२०८-२", "content_sanskrit": "ब्राह्मणास्तपसा सिद्धाः सपत्नीकाः सबान्धवाः ।\nसानुरागा ह्युभयतो मन्युनाभिपरिप्लुताः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003568002, "chapter_id": 23568, "verse_number": "२०८-३", "content_sanskrit": "विवर्णवदनो राजा प्रभातेजोविवर्जितः ।\nअचिरादेव सञ्जातः क्रोधेन भृशदुःखितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003568003, "chapter_id": 23568, "verse_number": "२०८-४", "content_sanskrit": "तं तथा निष्प्रभं दृष्ट्वा धर्मराजं तपोधनः ।\nनारदश्चाब्रवीत्तत्र ज्ञात्वा तस्य मनोगतम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003568004, "chapter_id": 23568, "verse_number": "२०८-५", "content_sanskrit": "अपि त्वं भ्राजमानस्तु पशोः पतिरिवापरः ।\nकस्मात्ते शोभनं वक्त्रं क्षणाद्वैवर्ण्यमापतत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003568005, "chapter_id": 23568, "verse_number": "२०८-६", "content_sanskrit": "विनिःश्वसन्यथा नागः कस्मात्त्वं परितप्यसे ।\nराजन्कस्माद्बिभेषि त्वमेतदिच्छामि वेदितुम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003568006, "chapter_id": 23568, "verse_number": "२०८-७", "content_sanskrit": "यम उवाच ।\nविवर्णं जायते वक्त्रं शुष्यते न च संशयः ।\nयन्मया हीदृशं दृष्टं श्रूयतां तन्महामुने ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003568007, "chapter_id": 23568, "verse_number": "२०८-८", "content_sanskrit": "यायावरास्तु ये विप्रा उञ्छवृत्तिपरायणाः ।\nदृढस्वाध्यायतपसो ह्रीमन्तो ह्यनसूयकाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003568008, "chapter_id": 23568, "verse_number": "२०८-९", "content_sanskrit": "अतिथिप्रियकाश्चैव नित्ययुक्ता जितेन्द्रियाः ।\nते त्वहंमानिनः सर्वे गच्छन्त्युपरि मे द्विज ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003568009, "chapter_id": 23568, "verse_number": "२०८-१०", "content_sanskrit": "न च मामुपतिष्ठन्ति न चैव वशगा मम ।\nमस्तकं मम गच्छन्ति सपत्नीकाः सहानुगाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003568010, "chapter_id": 23568, "verse_number": "२०८-११", "content_sanskrit": "दिव्यगन्धैर्विलिप्ताङ्गा माल्यभूषितवाससः ।\nसृजन्तो मम माल्यानि तेन ताम्ये द्विजोत्तम ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003568011, "chapter_id": 23568, "verse_number": "२०८-१२", "content_sanskrit": "मृत्यो तिष्ठसि कस्यार्थे को वा मृत्युः कथं भवेत् ।\nकि त्वं न भाषसे मृत्यो ब्रूहि लोके निरर्थकः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003568012, "chapter_id": 23568, "verse_number": "२०८-१३", "content_sanskrit": "लोभासक्तान्सदा   हंसि पापिष्ठान्धर्मवर्जितान् ।\nएषां तपसि सिद्धानां नाहं विग्रहवानिह ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003568013, "chapter_id": 23568, "verse_number": "२०८-१४", "content_sanskrit": "निग्रहानुग्रहौ नापि मया शक्यौ महात्मनाम् ।\nकर्त्तुं वा प्रतिषेद्धुं वा तेन तप्ये भृशं मुने .॥ १४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003568014, "chapter_id": 23568, "verse_number": "२०८-१५", "content_sanskrit": "एतस्मिन्नन्तरे तत्र विमानेन महाद्युतिः ।\nपतिव्रता समं भर्त्रा सानुगा सपरिच्छदा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003568015, "chapter_id": 23568, "verse_number": "२०८-१६", "content_sanskrit": "महता तूर्यघोषेण सम्प्राप्ता प्रियदर्शना ।\nधर्मराजहितं सर्वं धर्मज्ञा धर्मवत्सला ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003568016, "chapter_id": 23568, "verse_number": "२०८-१७", "content_sanskrit": "साब्रवीत्तु विमानस्था साधयन्ती शुभाङ्गना ।\nविचित्रं प्रसृतं वाक्यं सर्वसत्त्वसुखावहम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003568017, "chapter_id": 23568, "verse_number": "२०८-१८", "content_sanskrit": "पतिव्रतोवाच ।\nधर्मराज महाबाहो कृतज्ञः सर्वसम्मतः।\nमैवमीर्षां कुरुष्व त्वं ब्राह्मणेषु तपस्विसु ।\nएतेषां तपसां वीर माहात्म्यं बलमेव च ।\nअचिन्त्याः सर्वभूतानां ब्राह्मणा वेदपारगाः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003568018, "chapter_id": 23568, "verse_number": "२०८-१९", "content_sanskrit": "ब्राह्मणाः सततं पूज्या ब्राह्मणाः सर्वदेवताः ।\nमात्सर्यं क्रोधसंयुक्तं न कर्त्तव्यं द्विजातिषु ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003568019, "chapter_id": 23568, "verse_number": "२०८-२०", "content_sanskrit": "त्वया शुभाशुभं कर्म नित्यं पूजा मनस्विनाम् ।\nरागो वा रोषमोहौ वा न कर्तव्यौ सदा सताम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003568020, "chapter_id": 23568, "verse_number": "२०८-२१", "content_sanskrit": "प्रयाता गगने दृष्टा विद्युत्सौदामिनी यथा ।\nदृष्ट्वा पतिव्रतां नारीं धर्मराजेन पूजिताम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003568021, "chapter_id": 23568, "verse_number": "२०८-२२", "content_sanskrit": "अब्रवीन्नारदस्तत्र धर्मराजं तथागतम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003568022, "chapter_id": 23568, "verse_number": "२०८-२३", "content_sanskrit": "नारद उवाच।\nका चैषा सुमहाभागा सुरूपा प्रमदोत्तमा ।\nया त्वया पूजिता राजन् हितमुक्त्वा गता पुनः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003568023, "chapter_id": 23568, "verse_number": "२०८-२४", "content_sanskrit": "एतदिच्छाम्यहं ज्ञातुं परं कौतूहलं हि मे ।\nएतन्मे सुमहाभाग कथयस्व समासतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003568024, "chapter_id": 23568, "verse_number": "२०८-२५", "content_sanskrit": "यम उवाच ।\nअहं ते कथयिष्यामि कथां परमशोभनाम् ।\nएषा मया यथा तात पूजितापि च कृत्स्नशः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003568025, "chapter_id": 23568, "verse_number": "२०८-२६", "content_sanskrit": "पुरा कृतयुगे तात निमिर्नाम महायशाः ।\nआसीद्राजा महातेजाः सत्यसन्ध  इति श्रुतः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003568026, "chapter_id": 23568, "verse_number": "२०८-२७", "content_sanskrit": "तस्य पुत्रो मिथिर्नाम जननाज्जनकोऽभवत् ।\nतस्य रूपवती नाम पत्नी प्रियहिते रता ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003568027, "chapter_id": 23568, "verse_number": "२०८-२८", "content_sanskrit": "सा चाप शुभकर्माणि पतिभक्ता पतिव्रता ।\nप्रीत्या परमया युक्ता भर्त्तुर्वचनकारिणी ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003568028, "chapter_id": 23568, "verse_number": "२०८-२९", "content_sanskrit": "सोऽपि राजा महाभागः सर्वभूतहिते रतः ।\nधर्मात्मा च महात्मा च सत्यसन्धो महातपाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003568029, "chapter_id": 23568, "verse_number": "२०८-३०", "content_sanskrit": "य इमां पृथिवीं सर्वां धर्मेण परिपालयन् ।\nन व्याधिर्न जरा मृत्युस्तस्मिन्राजनि शासति ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003568030, "chapter_id": 23568, "verse_number": "२०८-३१", "content_sanskrit": "ववर्ष सततं देवस्तस्य राष्ट्रे महाद्युतेः ।\nएवं बहुगुणोपेतं तस्य राज्यं महात्मनः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003568031, "chapter_id": 23568, "verse_number": "२०८-३२", "content_sanskrit": "न कश्चिद् दृश्यते मर्त्यो रुजार्त्तो दुःखितोऽपि वा ।\nअथात्र बहुकालस्य राजानं मिथिलाधिपम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003568032, "chapter_id": 23568, "verse_number": "२०८-३३", "content_sanskrit": "उवाच राज्ञी विप्रेन्द्र विनयात्प्रश्रितं वचः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003568033, "chapter_id": 23568, "verse_number": "२०८-३४", "content_sanskrit": "राज्ञ्युवाच ।\nभृत्यानां च द्विजातीनां तथा परिजनस्य च ।\nयदस्ति द्रविणं किंचित्पृथिव्यां यद्गृहे च ते ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003568034, "chapter_id": 23568, "verse_number": "२०८-३५", "content_sanskrit": "विनियुक्तं तु तत्सर्वं सान्निध्यं तु तथा त्वया ।\nन च राजन्विजानासि भोजनस्य प्रशंससि ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003568035, "chapter_id": 23568, "verse_number": "२०८-३६", "content_sanskrit": "नास्ति तन्नियमः कश्चित्पुष्पमूल्यं च नास्ति नः ।\nन वा गवादिकं किंचिन्न च वस्त्राणि कर्हिचित् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003568036, "chapter_id": 23568, "verse_number": "२०८-३७", "content_sanskrit": "न चैव वार्षिकः कश्चिद्विद्यते भाजनस्य च ।\nदृश्यते हि महाराज मम चैवाथ सुव्रत ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003568037, "chapter_id": 23568, "verse_number": "२०८-३८", "content_sanskrit": "यत्कर्तव्यं मया वापि तन्मे ब्रूहि नराधिप ।\nकर्त्र्यस्म्यहं विशेषेण यद्वाक्यमपि मन्यसे ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003568038, "chapter_id": 23568, "verse_number": "२०८-३९", "content_sanskrit": "राजोवाच ।\nन शक्यमुपरोधेन वक्तुं भामिनि विप्रियम् ।\nन च पश्याम्यहं देवि तव चैव जनस्य च ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003568039, "chapter_id": 23568, "verse_number": "२०८-४०", "content_sanskrit": "तद्ब्रवीमि यथाशक्त्या यदि मे मन्यसे प्रिये ।\nहविष्ये वर्त्तमानानामिदं वर्षशतं गतम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003568040, "chapter_id": 23568, "verse_number": "२०८-४१", "content_sanskrit": "कुद्दालेन हि काष्ठेन क्षेत्रं वै कुर्महे प्रिये ।\nततो धर्मविधिं तत्त्वात्प्राप्नुयां मे न संशयः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003568041, "chapter_id": 23568, "verse_number": "२०८-४२", "content_sanskrit": "भक्ष्यं भोज्यं च ये ये च ततस्त्वं सुखमाप्स्यसि ।\nएवमुक्ता ततो राज्ञी राजानमिदमब्रवीत् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003568042, "chapter_id": 23568, "verse_number": "२०८-४३", "content_sanskrit": "देव्युवाच ।\nभृत्यानां तु सहस्राणि तव राजन्निवेशने ।\nअश्वानां च गजानां च सैरिभानां तथैव च ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003568043, "chapter_id": 23568, "verse_number": "२०८-४४", "content_sanskrit": "उष्ट्राणां महिषाणां च खराणां च महायशाः ।\nएते सर्वे कथं राजन्न कुर्वन्ति तवेप्सितम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003568044, "chapter_id": 23568, "verse_number": "२०८-४५", "content_sanskrit": "राजोवाच ।\nनियुक्तानि हि कर्माणि वार्षिकाणीतराणि च ।\nसर्वकर्माणि कुर्वन्ति ये भृत्या मे वरानने ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003568045, "chapter_id": 23568, "verse_number": "२०८-४६", "content_sanskrit": "बलीवर्दाः खरा अश्वा गजा उष्ट्रा ह्यनेकशः ।\nसर्वे नियुक्ता मे देवि सर्वकर्मसु शोभने ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003568046, "chapter_id": 23568, "verse_number": "२०८-४७", "content_sanskrit": "आयसं त्रापुषं ताम्रं राजतं कांचनं तथा ।\nनियुक्तानि तु सर्वाणि सर्व कर्मस्वनिन्दिते ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003568047, "chapter_id": 23568, "verse_number": "२०८-४८", "content_sanskrit": "ननु पश्याम्यहं देवि किंचिद्धैमं न चायसम् ।\nयेन कुर्यामहं देवि कुद्दालं सुसमाहितः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003568048, "chapter_id": 23568, "verse_number": "२०८-४९", "content_sanskrit": "एवमुक्ता महादेवी  तेन राज्ञा सुशोभना ।\nहृष्टपुष्टमना देवी राजानमिदमब्रवीत् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003568049, "chapter_id": 23568, "verse_number": "२०८-५०", "content_sanskrit": "गच्छ राजन्यथाकाममनुयास्यामि पृष्ठतः ।\nएवमुक्तः सुनिष्क्रान्तः सभार्यः स नरेश्वरः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003568050, "chapter_id": 23568, "verse_number": "२०८-५१", "content_sanskrit": "ततो राजा च देवी च क्षेत्रं मृगयतस्तदा ।\nगतौ च परमाध्वानं ततो राजाब्रवीदिदम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003568051, "chapter_id": 23568, "verse_number": "२०८-५२", "content_sanskrit": "इदं भद्रं मम क्षेत्रमास्स्वात्र वरवर्णिनि ।\nयावद्गुल्मानिमान् भद्रे कण्टकांश्च वरानने ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003568052, "chapter_id": 23568, "verse_number": "२०८-५३", "content_sanskrit": "अहं छिनद्मि वै देवि त्वमेताञ्छोधय प्रिये ।\nएष ते कर्म योगस्तु ततः प्राप्स्यामि चेप्सितम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003568053, "chapter_id": 23568, "verse_number": "२०८-५४", "content_sanskrit": "एवमुक्ता महादेवी तेन राज्ञा तपोधन ।\nउवाच मधुरं वाक्यं प्रहसन्ती नृपाङ्गना ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003568054, "chapter_id": 23568, "verse_number": "२०८-५५", "content_sanskrit": "वृक्षोऽत्र दृश्यते पार्श्वे सौवर्णो गुल्म एव च ।\nपानीयस्य तु सान्निध्यं न किंचिदिह दृश्यते ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003568055, "chapter_id": 23568, "verse_number": "२०८-५६", "content_sanskrit": "कथं क्षेत्रं करिष्यावो हृद्रोगस्य तु कारकम् ।\nइयं नदी ह्ययं वृक्ष इयं भूमिः समांसला ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003568056, "chapter_id": 23568, "verse_number": "२०८-५७", "content_sanskrit": "अस्मिन्वापि कृतं कर्म कथं गुणकरं भवेत् ।\nतस्यास्तद्वचनं श्रुत्वा राजा वचनमब्रवीत् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003568057, "chapter_id": 23568, "verse_number": "२०८-५८", "content_sanskrit": "शुभं सानुनयं वाक्यं भूतानां गुणवत्सलः ।\nपूर्वगृहे भवेत्पूर्वं विनियुक्तं तथा प्रिये ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003568058, "chapter_id": 23568, "verse_number": "२०८-५९", "content_sanskrit": "पानीयस्य तु पार्श्वेन सन्निकृष्टेन सुन्दरि ।\nचतुर्थं जनपर्यन्तं न किंचिदिह दृश्यते ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003568059, "chapter_id": 23568, "verse_number": "२०८-६०", "content_sanskrit": "अयं गृहो महादेवि न च बाधाऽत्र कस्यचित् ।\nततस्तच्छोधयामास तत्क्षेत्रं भार्यया सह ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003568060, "chapter_id": 23568, "verse_number": "२०८-६१", "content_sanskrit": "वियन्मध्ये तथोग्रश्च सविता तपते सदा ।\nसमृद्धश्च तदा तत्र निदाघः काल आगतः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003568061, "chapter_id": 23568, "verse_number": "२०८-६२", "content_sanskrit": "प्रवृद्धो दारुणो घर्मः कालश्चैवातिदारुणः ।\nततः सा तृषिता देवी क्षुधिता च तपस्विनी ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003568062, "chapter_id": 23568, "verse_number": "२०८-६३", "content_sanskrit": "स्निग्धौ ताम्रतलौ पादौ तस्यां सन्तापमागतौ ।\nगुणप्रवाहरक्तौ तु तस्याः पादौ च सुव्रत ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003568063, "chapter_id": 23568, "verse_number": "२०८-६४", "content_sanskrit": "सूर्यस्य पादा मध्याह्ने तापयन्त्यग्निसन्निभाः ।\nततः सा व्यथिता देवी भर्त्तारमिदमब्रवीत् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003568064, "chapter_id": 23568, "verse_number": "२०८-६५", "content_sanskrit": "तृषितास्मि महाराज भृशमुष्णेन पीडिता ।\nपानीयं दीयतां राजन्मम शीघ्रं प्रसादतः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003568065, "chapter_id": 23568, "verse_number": "२०८-६६", "content_sanskrit": "इत्युक्त्वा पतिता देवी विह्वला दुःखपीडिता ।\nपतन्त्या च तया सूर्यो दृष्टो विह्वलया तथा ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003568066, "chapter_id": 23568, "verse_number": "२०८-६७", "content_sanskrit": "यदृच्छया पतन्त्या तु सूर्यः कोपेन वीक्षितः ।\nततो विवस्वान् भगवान् सन्त्रस्तो गगने तदा ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003568067, "chapter_id": 23568, "verse_number": "२०८-६८", "content_sanskrit": "दिवं मुक्त्वा महातेजाः पतितो धरणीतले ।\nततो दृष्ट्वा तु राजाऽसौ स्वभावेन च वर्जितम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003568068, "chapter_id": 23568, "verse_number": "२०८-६९", "content_sanskrit": "किमर्थमिह तेजस्विंस्त्यक्त्वा मण्डलमागतः ।\nकिं करोमि महातेजाः सर्वलोकनमस्कृतः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003568069, "chapter_id": 23568, "verse_number": "२०८-७०", "content_sanskrit": "एवं ब्रुवन्तं राजानं सूर्यः सानुनयोऽब्रवीत् ।\nपतिव्रता शुभाक्षी च ममैषा रुषिता भृशम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003568070, "chapter_id": 23568, "verse_number": "२०८-७१", "content_sanskrit": "ततोऽहं पतितो राजंस्तव कार्यानुशासनः ।\nअनया सदृशी नारी त्रैलोक्ये नैव विद्यते ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003568071, "chapter_id": 23568, "verse_number": "२०८-७२", "content_sanskrit": "पृथिव्यां स्वर्गलोके वा न काचिदिह दृश्यते ।\nअहोऽस्याः परमं सत्त्वमहोऽस्याः परमं तपः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003568072, "chapter_id": 23568, "verse_number": "२०८-७३", "content_sanskrit": "अहो धैर्यं च शक्तिश्च तवैवं शंसिता गुणाः।\nतथेयं ते महाभाग तव चित्तानुसारिणी ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003568073, "chapter_id": 23568, "verse_number": "२०८-७४", "content_sanskrit": "अनुरूपा विशुद्धा च तपसा च वराङ्गना।\nपतिव्रता च साध्वी च नित्यं तव हिते रता ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003568074, "chapter_id": 23568, "verse_number": "२०८-७५", "content_sanskrit": "सदृशी ते महाभाग शक्रस्येव यथा शची।\nपात्रं पात्रवता प्राप्तं सुकृतस्य महत्फलम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003568075, "chapter_id": 23568, "verse_number": "२०८-७६", "content_sanskrit": "अनुरूपः सुरूपो वा यतो जातः सुयन्त्रितः ।\nमा च ते वितथः कामो भवेच्चैव नराधिपः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003568076, "chapter_id": 23568, "verse_number": "२०८-७७", "content_sanskrit": "कुरुष्व दयितं क्षेत्रं यथा मनसि वर्त्तते ।\nभोजनार्थं महाराज त्वदन्यो न हि विद्यते ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003568077, "chapter_id": 23568, "verse_number": "२०८-७८", "content_sanskrit": "फलदं च यशस्यं च भविष्यति हि कामदम्।\nएवमुक्त्वा ततः सूर्यः ससर्ज जलभाजनम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003568078, "chapter_id": 23568, "verse_number": "२०८-७९", "content_sanskrit": "उपानहौ च छत्रं च दिव्यालंकार भूषितम् ।\nददौ च राज्ञे सविता प्रीत्या परमया युतः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003568079, "chapter_id": 23568, "verse_number": "२०८-८०", "content_sanskrit": "उपभोक्तुं सुखस्यार्थं सुपुण्यस्य विशेषतः ।\nदत्त्वा तत्पुण्यकर्माणं ततः प्राह दिवाकरः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003568080, "chapter_id": 23568, "verse_number": "२०८-८१", "content_sanskrit": "एवमुक्त्वा तु भगवांस्तथा तत्कृतवान् क्वचित् ।\nराज्ञा च जनकेनैव प्रियाया हितकाम्यया ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003568081, "chapter_id": 23568, "verse_number": "२०८-८२", "content_sanskrit": "ततः साप्यायिता देवी तोयेन शुभलक्षणा ।\nलब्धसंज्ञा गतभया राजानमिदमब्रवीत् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003568082, "chapter_id": 23568, "verse_number": "२०८-८३", "content_sanskrit": "देवी दृष्ट्वा तदाश्चर्यं विस्मयोत्फुल्ललोचना ।\nकेन दत्तं शुभं तोयं दिव्यं छत्रमुपानहौ ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003568083, "chapter_id": 23568, "verse_number": "२०८-८४", "content_sanskrit": "एतन्मे संशयं राजन्कथयस्व तपोधन ।\nराजोवाच ।\nएष देवो महादेवि विवस्वान्नाम नामतः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003568084, "chapter_id": 23568, "verse_number": "२०८-८५", "content_sanskrit": "तवानुकम्पया देवि मुक्त्वाकाशमिहागतः ।\nएवमुक्ता तु सा देवी भर्त्तारमिदमब्रवीत् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003568085, "chapter_id": 23568, "verse_number": "२०८-८६", "content_sanskrit": "करवाण्यस्य कां प्रीतिं ज्ञायतामस्य वाच्छितम् ।\nततो राजा महातेजाः प्रणिपत्य कृताञ्जलिः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003568086, "chapter_id": 23568, "verse_number": "२०८-८७", "content_sanskrit": "विज्ञापयामास तदा भगवन् किं करोमि ते ।\nएवमुक्तो नरेन्द्रेण सूर्यो वचनमब्रवीत् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003568087, "chapter_id": 23568, "verse_number": "२०८-८८", "content_sanskrit": "अभयं मे महाराज स्त्रीभ्यो भवतु मानद ।\nतच्छ्रुत्वा वचनं तस्य भास्करस्य तु मानदः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003568088, "chapter_id": 23568, "verse_number": "२०८-८९", "content_sanskrit": "तां प्रियां प्रीतहृदयां श्रावयंस्तस्य भाषितम् ।\nराज्ञस्तु वचनं श्रुत्वा देवी वचनमब्रवीत् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003568089, "chapter_id": 23568, "verse_number": "२०८-९०", "content_sanskrit": "प्रीत्या परमया युक्ता तस्य राज्ञो मनःप्रिया ।\nरश्मीनां तारणार्थाय छत्रं दत्त्वा तु कुण्डिकाम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003568090, "chapter_id": 23568, "verse_number": "२०८-९१", "content_sanskrit": "इमौ चोपानहौ दत्त्वा चौभौ पादस्य शङ्करौ ।\nअभयं ते महाभाग यथा त्वं वृतवानसि ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003568091, "chapter_id": 23568, "verse_number": "२०८-९२", "content_sanskrit": "एवं पतिव्रतां विप्र पूजयामि नमामि च ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}]