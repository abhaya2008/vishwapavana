[{"id": 6000155000, "chapter_id": 10155, "verse_number": null, "content_sanskrit": "अथ द्वितीयाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000155001, "chapter_id": 10155, "verse_number": null, "content_sanskrit": "श्री शुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_002/BhP_08.002.001.m4a", "display_order": 2}, {"id": 6000155002, "chapter_id": 10155, "verse_number": "८-२-१", "content_sanskrit": "आसीद् गिरिवरो राजंस्‍त्रिकूट इति विश्रुतः।\nक्षीरोदेनावृतः श्रीमान् योजनायुतमुच्छ्रितः॥ ८/२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_002/BhP_08.002.002.m4a", "display_order": 3, "topics": [{"text": "गजेन्द्रमोक्षकथाऽऽरम्भः", "range": "१–१९"}]}, {"id": 6000155003, "chapter_id": 10155, "verse_number": "८-२-२", "content_sanskrit": "तावता विस्तृतः पर्यक् त्रिभिः शृृङ्गैः पयोनिधिम्।\nदिशश्च रोचयन्नास्ते रौप्यायसहिरण्मयैः॥ ८/२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_002/BhP_08.002.003.m4a", "display_order": 4}, {"id": 6000155004, "chapter_id": 10155, "verse_number": "८-२-३", "content_sanskrit": "अन्यैश्च ककुभः सर्वा रत्नधातुविचित्रितैः।\nनानाद्रुमलतागुल्मैः निर्घोषैर्निर्झराम्भसाम्॥ ८/२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_002/BhP_08.002.004.m4a", "display_order": 5}, {"id": 6000155005, "chapter_id": 10155, "verse_number": "८-२-४", "content_sanskrit": "सदा निर्णिज्यमानाङ्घ्रिः समन्तात् पयऊर्मिभिः।\nकरोति श्यामलां भूमिं शुभैर्मरकतादिभिः॥ ८/२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_002/BhP_08.002.005.m4a", "display_order": 6}, {"id": 6000155006, "chapter_id": 10155, "verse_number": "८-२-५", "content_sanskrit": "सिद्धचारणगन्धर्वविद्याधरमहोरगैः।\nकिन्नरैरप्सरोभिश्च क्रीडद्भिर्जुष्टकन्दरः॥ ८/२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_002/BhP_08.002.006.m4a", "display_order": 7}, {"id": 6000155007, "chapter_id": 10155, "verse_number": "८-२-६", "content_sanskrit": "यत्र सङ्गीतसन्नादैर्नदद्गुहममर्षया।\nअभि गर्जन्ति हरयः श्लाघिनः परशङ्कया॥ ८/२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_002/BhP_08.002.007.m4a", "display_order": 8}, {"id": 6000155008, "chapter_id": 10155, "verse_number": "८-२-७", "content_sanskrit": "नानारण्यपशुव्रातसङ्कुलद्रोण्यलङ्कृतः।\nचित्रद्रुमसुरोद्यानकलकण्ठविहङ्गमः॥ ८/२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_002/BhP_08.002.008.m4a", "display_order": 9}, {"id": 6000155009, "chapter_id": 10155, "verse_number": "८-२-८", "content_sanskrit": "सरित्सरोभिरच्छोदैः पुलिनैर्मणिवालुकैः।\nदेवस्‍त्रीमज्जनामोदसौरभाक्तानिलैर्युतः॥ ८/२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_002/BhP_08.002.009.m4a", "display_order": 10}, {"id": 6000155010, "chapter_id": 10155, "verse_number": "८-२-९", "content_sanskrit": "तस्य द्रोण्यां भगवतो वरुणस्य महात्मनः।\nउद्यानमृतुमन्नाम आक्रीडं सुरयोषिताम्॥ ८/२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_002/BhP_08.002.010.m4a", "display_order": 11}, {"id": 6000155011, "chapter_id": 10155, "verse_number": "८-२-१०", "content_sanskrit": "सर्वतोऽलङ्कृतं दिव्यैर्नित्यपुष्पफलद्रुमैः।\nमन्दारैः पारिजातैश्च पाटलाशोकचम्पकैः॥ ८/२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_002/BhP_08.002.011.m4a", "display_order": 12}, {"id": 6000155012, "chapter_id": 10155, "verse_number": "८-२-११", "content_sanskrit": "चूतैः प्रियालैः पनसैराम्रैराम्रातकैरपि।\nक्रमुकैर्नारिकेलैश्च खर्जूरैर्बीजपूरकैः॥ ८/२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_002/BhP_08.002.012.m4a", "display_order": 13}, {"id": 6000155013, "chapter_id": 10155, "verse_number": "८-२-१२", "content_sanskrit": "मधुकैः सालतालैश्च तमालै रसनार्जुनैः।\nअरिष्टोदुम्बरप्लक्षैर्वटैः किंशुकचन्दनैः॥ ८/२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_002/BhP_08.002.013.m4a", "display_order": 14}, {"id": 6000155014, "chapter_id": 10155, "verse_number": "८-२-१३", "content_sanskrit": "पिचुमन्दैः कोविदारैः सरलैः सुरदारुभिः।\nद्राक्षेक्षुरम्भाजम्बूभिर्बदर्यक्षाभयामलैः॥ ८/२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_002/BhP_08.002.014.m4a", "display_order": 15}, {"id": 6000155015, "chapter_id": 10155, "verse_number": "८-२-१४", "content_sanskrit": "बिल्वैः कपित्थैर्जम्बीरैर्वृतो भल्लातकादिभिः।\nतस्मिन् सरः सुविपुलं लसत्काञ्चनपङ्कजम्॥ ८/२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_002/BhP_08.002.015.m4a", "display_order": 16}, {"id": 6000155016, "chapter_id": 10155, "verse_number": "८-२-१५", "content_sanskrit": "कुमुदोत्पलकल्हारशतपत्रश्रियोर्जितम्।\nमत्तषट्‌पदनिर्जुष्टं शकुन्तैः कलनिःस्वनैः॥ ८/२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_002/BhP_08.002.016.m4a", "display_order": 17}, {"id": 6000155017, "chapter_id": 10155, "verse_number": "८-२-१६", "content_sanskrit": "हंसकारण्डवाकीर्णं चक्राह्वैः सारसैरपि।\nजलकुक्‍कुटकोयष्टिदात्यूहकुलकूजितम्॥ ८/२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_002/BhP_08.002.017.m4a", "display_order": 18}, {"id": 6000155018, "chapter_id": 10155, "verse_number": "८-२-१७", "content_sanskrit": "मत्स्यकच्छपसञ्चारचलत्पद्मरजःपयः।\nकदम्बवेतसनलनीपवञ्जुलकैर्वृतम्॥ ८/२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_002/BhP_08.002.018.m4a", "display_order": 19}, {"id": 6000155019, "chapter_id": 10155, "verse_number": "८-२-१८", "content_sanskrit": "कुन्दैः कुरबकाशोकैः शिरीषैः कुटजेङ्गुदैः।\nकुब्जकैः स्वर्णयूथीभिर्नागपुन्नागजातिभिः॥ ८/२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_002/BhP_08.002.019.m4a", "display_order": 20}, {"id": 6000155020, "chapter_id": 10155, "verse_number": "८-२-१९", "content_sanskrit": "मल्लिकाशतपत्रैश्च माधवीजालकादिभिः।\nशोभितं तीरजैश्चान्यैर्नित्यर्तुभिरलं द्रुमैः॥ ८/२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_002/BhP_08.002.020.m4a", "display_order": 21}, {"id": 6000155021, "chapter_id": 10155, "verse_number": "८-२-२०", "content_sanskrit": "तत्रैकदा तद्गिरिकाननाश्रयः करेणुभिर्वारणयूथपश्चरन्।\nसकण्टकं कीचकवेणुवेत्रवद्विशालगुल्मं प्ररुजन् वनस्पतीन्॥ ८/२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_002/BhP_08.002.021.m4a", "display_order": 22, "topics": [{"text": "त्रिकूटपर्वते स्वैरं गजीभिः सह विक्रीडतो मदान्धस्य गजेन्द्रस्य जलं पातुं सरस्यवतीर्य लोडयतो ग्राहेण चरणे गृहीतस्य तस्य दुःखकाले हरिस्मरणप्राप्तिः", "range": "२०–३३"}]}, {"id": 6000155022, "chapter_id": 10155, "verse_number": "८-२-२१", "content_sanskrit": "यद्गन्धमात्राद्धरयो गजेन्द्रा व्याघ्रादयो व्यालमृगाः सखड्गाः।\nमहोरगाश्चपि भयाद् द्रवन्ति सगौरकृष्णाः शरभाश्चमर्यः॥ ८/२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_002/BhP_08.002.022.m4a", "display_order": 23}, {"id": 6000155023, "chapter_id": 10155, "verse_number": "८-२-२२", "content_sanskrit": "वृका वराहा महिषर्क्षशल्या गोपुच्छसालावृकमर्कटाश्च।\nअन्ये च क्षुद्रा हरिणाः शशादयश्चरन्त्यभीता यदनुग्रहेण॥ ८/२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_002/BhP_08.002.023.m4a", "display_order": 24}, {"id": 6000155024, "chapter_id": 10155, "verse_number": "८-२-२३", "content_sanskrit": "स घर्मतप्तः करिभिः करेणुभिर्वृतो मदच्युत्कलभैरनुद्रुतः।\nगिरिं गरिम्णा परितः प्रकम्पयन् निषेव्यमाणोऽलिकुलैर्मदाशनैः॥ ८/२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_002/BhP_08.002.024.m4a", "display_order": 25}, {"id": 6000155025, "chapter_id": 10155, "verse_number": "८-२-२४", "content_sanskrit": "सरोऽनिलं पङ्कजरेणुरूषितं जिघ्रन् विदूरात् मदविह्वलेक्षणः।\nवृतः स्वयूथेन तृषार्दितेन तत्सरोवराभ्याशमथागमद् द्रुतम्॥ ८/२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_002/BhP_08.002.025.m4a", "display_order": 26}, {"id": 6000155026, "chapter_id": 10155, "verse_number": "८-२-२५", "content_sanskrit": "विगाह्य तस्मिन्नमृताम्बु निर्मलं हेमारविन्दोत्पलरेणुवासितम्।\nपपौ निकामं निजपुष्करोद्धृतं स्वात्मानमद्भिः स्नपयन् गतक्लमः॥ ८/२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_002/BhP_08.002.026.m4a", "display_order": 27}, {"id": 6000155027, "chapter_id": 10155, "verse_number": "८-२-२६", "content_sanskrit": "स्वपुष्करेणोद्धृतशीकराम्बुभिर्निपाययत् संस्नपयन् यथा गृही।\nघूर्णन् करेणून् कलभांश्च दुर्मदो नाचष्ट कृच्छ्रं कृपणोऽजमायया॥ ८/२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_002/BhP_08.002.027.m4a", "display_order": 28}, {"id": 6000155028, "chapter_id": 10155, "verse_number": "८-२-२७", "content_sanskrit": "तं तत्र कश्चिन्नृप दैवचोदितो ग्राहो बलीयांश्चरणे रुषाऽग्रहीत्।\nयदृच्छयैवं व्यसनं गतो गजो यथाबलं सोऽतिबलो विचक्रमे॥ ८/२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_002/BhP_08.002.028.m4a", "display_order": 29}, {"id": 6000155029, "chapter_id": 10155, "verse_number": "८-२-२८", "content_sanskrit": "तथाऽऽतुरं यूथपतिं करेणवो विकृष्यमाणं तरसा बलीयसा।\nविचुक्रुशुर्दीनधियोऽपरे गजाः पार्ष्णिग्रहाः तारयितुं न चाशकन्॥ ८/२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_002/BhP_08.002.029.m4a", "display_order": 30}, {"id": 6000155030, "chapter_id": 10155, "verse_number": "८-२-२९", "content_sanskrit": "नियुध्यतोरेवमिभेन्द्रनक्रयोर्विकर्षतोरन्तरतो बहिर्मिथः।\nसमाः सहस्रं व्यगमन् महीपते सप्राणयोश्चित्रममंसतामराः॥ ८/२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_002/BhP_08.002.030.m4a", "display_order": 31}, {"id": 6000155031, "chapter_id": 10155, "verse_number": "८-२-३०", "content_sanskrit": "ततो गजेन्द्रस्य सहोबलौजसां कालेन दीर्घेण महानभूद् व्ययः।\nविकृष्यमाणस्य जलेऽवसीदतो विपर्ययोऽभूत् सकलं जलौकसः॥ ८/२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_002/BhP_08.002.031.m4a", "display_order": 32}, {"id": 6000155032, "chapter_id": 10155, "verse_number": "८-२-३१", "content_sanskrit": "इत्थं गजेन्द्रः स यदाप सङ्कटं प्राणस्य देही विवशो यदृच्छया।\nअपारयन्नात्मविमोक्षणे चिरं दध्याविमां बुद्धिमथाभ्यपद्यत॥ ८/२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_002/BhP_08.002.032.m4a", "display_order": 33}, {"id": 6000155033, "chapter_id": 10155, "verse_number": "८-२-३२", "content_sanskrit": "न मामिमे ज्ञातय आतुरं गजाः कुतः करिण्यः प्रभवन्ति मोचितुम्।\nग्राहेण पाशेन विधातुरावृतोऽप्यहं च तं यामि परं परायणम्॥ ८/२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_002/BhP_08.002.033.m4a", "display_order": 34}, {"id": 6000155034, "chapter_id": 10155, "verse_number": "८-२-३३", "content_sanskrit": "यः कश्चनेशो बलिनोऽन्तकोरगात् प्रचण्डवेगादभिधावतो भृशम्।\nभीतं प्रपन्नं परिपाति यद्भयान्मृत्युः प्रधावत्यरणं तमीमहि॥ ८/२/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_002/BhP_08.002.034.m4a", "display_order": 35}, {"id": 6000155035, "chapter_id": 10155, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् अष्टमस्कन्धे द्वितीयाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]