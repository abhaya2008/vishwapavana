[{"id": 2078028, "chapter_id": 2656, "verse_number": "१२-१६१-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2078029, "chapter_id": 2656, "verse_number": "१२-१६१-१", "content_sanskrit": "यतः प्रभवति क्रोधः कामो वा भरतर्षभ।\nशोकमोहौ विधित्सा च परासुत्वं तथा मदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2078030, "chapter_id": 2656, "verse_number": "१२-१६१-२", "content_sanskrit": "लोभो मात्सर्यमीर्ष्या च कुत्साऽसूया कृपा भयम्।\nएतत्सर्वं महाप्राज्ञ याथातथ्येन मे वद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2078031, "chapter_id": 2656, "verse_number": "१२-१६१-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2078032, "chapter_id": 2656, "verse_number": "१२-१६१-३", "content_sanskrit": "त्रयोदशैतेऽतिबलाः शत्रवः प्राणिनां स्मृताः।\nउपासते महाराज समन्तात्पुरुषानिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2078033, "chapter_id": 2656, "verse_number": "१२-१६१-४", "content_sanskrit": "एते प्रमत्तं पुरुषमप्रमत्तास्तुदन्ति च।\nवृका इव विलुम्पन्ति दृष्ट्वेव पुरुषेतरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2078034, "chapter_id": 2656, "verse_number": "१२-१६१-५", "content_sanskrit": "एभ्यः प्रवर्तते दुःखमेभ्यः पापं प्रवर्तते।\nइति मर्त्यो विजानीयात्सततं पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2078035, "chapter_id": 2656, "verse_number": "१२-१६१-६", "content_sanskrit": "एतेषामुदयं स्थानं क्षयं च पृथिवीपते।\nहन्त ते कथयिष्यामि क्रोधस्योत्पत्तिमादितः।\nयथातत्त्वं क्षितिपते तन्मे निगदतः शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2078036, "chapter_id": 2656, "verse_number": "१२-१६१-७", "content_sanskrit": "लोभात्क्रोधः प्रभवति परदोषैरुदीर्यते।\nक्षमया तिष्ठते राजन्क्षमया विनिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2078037, "chapter_id": 2656, "verse_number": "१२-१६१-८", "content_sanskrit": "संकल्पाज्जायते कामः सेव्यमानो विवर्धते।\nयदा प्राज्ञो विरमते तदा सद्यः प्रणश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2078038, "chapter_id": 2656, "verse_number": "१२-१६१-९", "content_sanskrit": "[परामूया क्रोधलोभावन्तरा प्रतिमुच्यते।\nदयया सर्वभूतानां निर्वेदाद्विनिवर्तते।]\nअवद्यदर्शनादेति तत्त्वज्ञानाच्च नश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2078039, "chapter_id": 2656, "verse_number": "१२-१६१-१०", "content_sanskrit": "अज्ञानप्रभवो मोहः पापाभ्यासात्प्रवर्तते।\nयदा प्राज्ञेषु रमते तदा सद्यः प्रणश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2078040, "chapter_id": 2656, "verse_number": "१२-१६१-११", "content_sanskrit": "विरुद्धानीह शास्त्राणि ये पश्यन्ति कुरूद्वह।\nविधित्सा जायते तेषां तत्त्वज्ञानान्निवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2078041, "chapter_id": 2656, "verse_number": "१२-१६१-१२", "content_sanskrit": "प्रीतेः शोकः प्रभवति वियोगात्तस्य देहिनः।\nयदा निरर्थकं वेत्ति तदा सद्यः प्रणश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2078042, "chapter_id": 2656, "verse_number": "१२-१६१-१३", "content_sanskrit": "परासुता क्रोधलोभादभ्यासाच्च प्रवर्तते।\nदयया सर्वभूतानां निर्वेदात्सा निवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2078043, "chapter_id": 2656, "verse_number": "१२-१६१-१४", "content_sanskrit": "सत्यत्यागात्तु मात्सर्यमहितानां च सेवया।\nएतत्तु क्षीयते तात साधूनामुपसेवनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2078044, "chapter_id": 2656, "verse_number": "१२-१६१-१५", "content_sanskrit": "कुलाञ्ज्ञानात्तथैश्वर्यान्मदो भवति देहिनाम्।\nएभिरेव तु विज्ञातैर्मदः सद्यः प्रणश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2078045, "chapter_id": 2656, "verse_number": "१२-१६१-१६", "content_sanskrit": "ईर्ष्या कामात्प्रभवति संहर्षाच्चैव जायते।\nइतरेषां तु सत्वानां प्रज्ञया सा प्रणश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2078046, "chapter_id": 2656, "verse_number": "१२-१६१-१७", "content_sanskrit": "विभ्रमाल्लोकबाह्यानां द्वेष्यैर्वाक्यैरसंमतैः।\nकुत्सा संजायते राजँल्लोकान्प्रेक्ष्याभिशाम्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2078047, "chapter_id": 2656, "verse_number": "१२-१६१-१८", "content_sanskrit": "प्रतिकर्तुं न शक्ता ये बलस्थायापकारिणे।\nअसूया जायते तीव्रा कारुण्याद्विनिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2078048, "chapter_id": 2656, "verse_number": "१२-१६१-१९", "content_sanskrit": "कृपणान्सततं दृष्ट्वा ततः संजायते कृपा।\nधर्मनिष्ठां यदा वेत्ति तदा शाम्यति सा कृपा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2078049, "chapter_id": 2656, "verse_number": "१२-१६१-२०", "content_sanskrit": "अज्ञानप्रभवो लोभो भूतानां दृश्यते सदा।\nअस्थिरत्वं च भोगानां दृष्ट्वा ज्ञात्वा निवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2078050, "chapter_id": 2656, "verse_number": "१२-१६१-२१", "content_sanskrit": "एतान्येव जितान्याहुः प्रशान्तेन त्रयोदश।\nएते हि धार्तराष्ट्राणां सर्वे दोषास्त्रयोदश।\nत्वया सत्यार्थिना नित्यं विजिता जेष्यता चते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2078051, "chapter_id": 2656, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि एकषष्ट्यधिकशततमोऽध्यायः॥ १६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]