[{"id": 7001736000, "chapter_id": 21736, "verse_number": "१-१२२-१", "content_sanskrit": "सनातन उवाच ।\nअथातः संप्रवक्ष्यामि त्रयोदश्या व्रतानि ते ।\nयानि कृत्वा नरो भक्त्या सुभगो जायते भुवि ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001736001, "chapter_id": 21736, "verse_number": "१-१२२-२", "content_sanskrit": "मधौ शुक्लत्रयोदश्यां मदनं चन्दनात्मकम् ।\nकृत्वा संपूज्य यत्नेन वीजेयव्द्यजनेन च ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001736002, "chapter_id": 21736, "verse_number": "१-१२२-३", "content_sanskrit": "ततः संक्षुधितः कामः पुत्रपौत्रविवर्द्धनः ।\nअनंगपूजाप्यत्रोक्ता तां निबोध मुनीश्वर ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001736003, "chapter_id": 21736, "verse_number": "१-१२२-४", "content_sanskrit": "सिन्दूररजनीरागैः फलकेऽनंगमालिखेत् ।\nरतिप्रीतियुतं श्लक्ष्णं पुष्पचापेषुधारिणम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001736004, "chapter_id": 21736, "verse_number": "१-१२२-५", "content_sanskrit": "कामदेवं वसन्तं च वाजिवक्त्रं वृषध्वजम् ।\nमध्याह्ने पूजयेद्भक्त्या गंधस्रग्भूषणांशुकैः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001736005, "chapter_id": 21736, "verse_number": "१-१२२-६", "content_sanskrit": "क्षभ्यैर्नानाविधैस्चापि मन्त्रेणानेन नारद ।\nनमो माराय कामाय कामदेवस्य मूर्त्तये ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001736006, "chapter_id": 21736, "verse_number": "१-१२२-७", "content_sanskrit": "ब्रह्मविष्णुशिवेंद्राणां मनःभोभकराय वै ।\nतत्तस्याग्रतो भक्त्या पूजयेदंगनापतिम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001736007, "chapter_id": 21736, "verse_number": "१-१२२-८", "content_sanskrit": "वस्त्रमाल्याविभूषाद्यैः कामोऽयमिति चिंतयेत् ।\nसंपूज्य द्विजदांपत्यं गंधवस्त्रविभूषणैः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001736008, "chapter_id": 21736, "verse_number": "१-१२२-९", "content_sanskrit": "एवं यः कुरुते विप्र वर्षे वर्षे महोत्सवम् ।\nवसंतसमये प्राप्ते हृष्टः पुष्टः सदैव सः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001736009, "chapter_id": 21736, "verse_number": "१-१२२-१०", "content_sanskrit": "प्रतिमासं पूजयेद्वा यावद्वर्षं समाप्यते ।\nमदनं हृद्भवं कामं मन्मथं च रतिप्रियम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001736010, "chapter_id": 21736, "verse_number": "१-१२२-११", "content_sanskrit": "अनंगं चैव कंदर्पं पूजयेन्मकरध्वजम् ।\nकुसुमायुधसंज्ञं च ततः पश्चान्मनोभवम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001736011, "chapter_id": 21736, "verse_number": "१-१२२-१२", "content_sanskrit": "विषमेषु तथा विप्र मालतीगप्रियमित्यपि ।\nअजाया दानमप्युक्तं स्नात्वा नद्या विधानतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001736012, "chapter_id": 21736, "verse_number": "१-१२२-१३", "content_sanskrit": "अजाः पयस्विनीर्दद्याद्दरिद्राय कुटुंबिने ।\nभूयस्त्वनेन दानेन स लोके नैव जायते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001736013, "chapter_id": 21736, "verse_number": "१-१२२-१४", "content_sanskrit": "यदीयं शनिना युक्ता सा महावारुणी स्मृता ।\nगंगायां यदि लभ्येत कोटिसूर्यग्रहाधिका ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001736014, "chapter_id": 21736, "verse_number": "१-१२२-१५", "content_sanskrit": "शुभयोगः शतर्क्षं च शनौ कामे मधौ सिते ।\nमहामहेति विख्याता कुलकोटिविमुक्तिदा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001736015, "chapter_id": 21736, "verse_number": "१-१२२-१६", "content_sanskrit": "राधशुक्लत्रयोदश्यां कामदेवव्रतं स्मृतम् ।\nतत्र गंधादिभिः कामं पूजयेदुपवासवान् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001736016, "chapter_id": 21736, "verse_number": "१-१२२-१७", "content_sanskrit": "प्रतिमासं ततः पश्चात्त्रयोदश्यां सिते दले ।\nएवमेव व्रतं कार्यं वर्षांते गामलंकृताम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001736017, "chapter_id": 21736, "verse_number": "१-१२२-१८", "content_sanskrit": "दद्याद्विप्राय सत्कृत्य व्रतसांगत्वसिद्धये ।\nज्येष्ठशुक्लत्रयोदश्यां दौर्भाग्यशमनं व्रतम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001736018, "chapter_id": 21736, "verse_number": "१-१२२-१९", "content_sanskrit": "तत्र स्नात्वा नदीतोये पूजयेच्छुचिदेशजम् ।\nश्वेतमंदारमर्कं वा करवीरं च रक्तकम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001736019, "chapter_id": 21736, "verse_number": "१-१२२-२०", "content_sanskrit": "निरीक्ष्य गगने सूर्यं प्रार्थयेन्मंत्रतस्तदा ।\nमंदारकरवीरार्का भवंतो भास्करांशजाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001736020, "chapter_id": 21736, "verse_number": "१-१२२-२१", "content_sanskrit": "पूजिता मम दौर्भाग्यं नाशयंतु नमोऽस्तु वः ।\nइत्थं योऽर्चयते भक्त्या वर्षे वर्षे द्रुमत्रयम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001736021, "chapter_id": 21736, "verse_number": "१-१२२-२२", "content_sanskrit": "नश्यते तस्य दौर्भाग्यं नात्र कार्या विचारणा ।\nशुचिशुक्लत्रयोदश्यामेकभक्तं समाचरेत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001736022, "chapter_id": 21736, "verse_number": "१-१२२-२३", "content_sanskrit": "पूजयित्वा जगन्नाथावुमामाहेश्वरी तनूः ।\nहैम्यौ रौप्यौ च मृन्मप्यौ यथाशक्त्या विधाय च ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001736023, "chapter_id": 21736, "verse_number": "१-१२२-२४", "content_sanskrit": "सिंहोक्षस्थे देवगृहे गोष्ठे ब्राह्मणवेश्मनि ।\nस्थापयित्वा प्रतिष्ठाप्य दैवमंत्रेण नारद ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001736024, "chapter_id": 21736, "verse_number": "१-१२२-२५", "content_sanskrit": "ततः पंचदिनं पूजा चैकभक्तं व्रतं तथा ।\nतृतीयदिवसे प्रातः स्नात्वा संपूज्य तौ पुनः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001736025, "chapter_id": 21736, "verse_number": "१-१२२-२६", "content_sanskrit": "समर्पणीयौ विप्राय वेदवेदांगशालिने ।\nवर्षे वर्षे ततः पश्चाद्विधेयं वर्षपंचकम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001736026, "chapter_id": 21736, "verse_number": "१-१२२-२७", "content_sanskrit": "तदंते धेनुयुग्मेन सहितौ तौ प्रदापयेत् ।\nइत्थं नरो वा नारी वा कृत्वा व्रतमिदं शुभम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001736027, "chapter_id": 21736, "verse_number": "१-१२२-२८", "content_sanskrit": "नैव दांपत्यविच्छेदं लभते सप्तजन्मसु ।\nनभः शुक्लत्रयोदश्यां रतिकामव्रतं शुभम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001736028, "chapter_id": 21736, "verse_number": "१-१२२-२९", "content_sanskrit": "वैधव्यवारणं स्त्रीणां तथा संतानवर्धनम् ।\nकृतोपवासा कन्यैव नारी वा द्विजसत्तम ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001736029, "chapter_id": 21736, "verse_number": "१-१२२-३०", "content_sanskrit": "ताम्रे वा मृन्मये वापि सौवर्णे राजते तथा ।\nरतिकामौ प्रविन्यस्य गंधाद्यैः सम्यगर्चयेत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001736030, "chapter_id": 21736, "verse_number": "१-१२२-३१", "content_sanskrit": "ततस्तु द्विजदांपत्यं चतुर्दश्यां निमंत्र्य च ।\nसतकृत्य भोज्य प्रतिमे दद्यात्ताभ्यां सदक्षिणे ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001736031, "chapter_id": 21736, "verse_number": "१-१२२-३२", "content_sanskrit": "एवं चतुर्दशाब्दं च कृत्वा व्रतमनुत्तमम् ।\nधेनुयुग्मान्विते देये व्रतसंपूर्तिहेतवे ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001736032, "chapter_id": 21736, "verse_number": "१-१२२-३३", "content_sanskrit": "भाद्रशुक्लत्रयोदश्यां गोत्रिरात्रव्रतं स्मृतम् ।\nलक्ष्मीनारायणं कृत्वा सौवर्णं वापि राजतम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001736033, "chapter_id": 21736, "verse_number": "१-१२२-३४", "content_sanskrit": "पंचामृतेन संस्नाप्य मण्डलेऽष्टदले शुभे ।\nपीठे विन्यस्य वस्त्राढ्यं गंधाद्यैः परिपूजयेत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001736034, "chapter_id": 21736, "verse_number": "१-१२२-३५", "content_sanskrit": "आरार्तिकं ततः कृत्वा दद्यात्सान्नोदकं घटम् ।\nएवं दिनत्रयं कृत्वा व्रतांते मासमर्च्य च ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001736035, "chapter_id": 21736, "verse_number": "१-१२२-३६", "content_sanskrit": "सम्यगर्थं च संपाद्य दद्यान्मंत्रेण नारद ।\nपंचगावः समुत्पन्ना मथ्यमाने महोदधौ ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001736036, "chapter_id": 21736, "verse_number": "१-१२२-३७", "content_sanskrit": "तासां मध्ये तु या नंदा तस्यै धेन्वै नमो नमः ।\nप्रदक्षिणीकृत्य ततो दद्याद्विप्राय मंत्रतः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001736037, "chapter_id": 21736, "verse_number": "१-१२२-३८", "content_sanskrit": "गावो ममाग्रतः सन्तु गावो मे संतु पृष्ठतः ।\nगावो मे पार्श्वतः संतु गवां मध्ये वसाम्यहम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001736038, "chapter_id": 21736, "verse_number": "१-१२२-३९", "content_sanskrit": "ततश्च द्विजदांपत्यं सम्यगभ्यर्च्य भोजयेत् ।\nलक्ष्मीनारायणं तस्मै सत्कृत्य प्रतिपादयेत् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001736039, "chapter_id": 21736, "verse_number": "१-१२२-४०", "content_sanskrit": "अश्वमेधसहस्राणि राजसूयशतानि च ।\nकृत्वा यत्फलमाप्नोति गोत्रिरात्रव्रताच्च तत् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001736040, "chapter_id": 21736, "verse_number": "१-१२२-४१", "content_sanskrit": "इषे शुक्लत्रयोदश्यां त्रिरात्रशोककव्रतम् ।\nहैमं ह्यशोकं निर्माय पूजयित्वा विधानतः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001736041, "chapter_id": 21736, "verse_number": "१-१२२-४२", "content_sanskrit": "उपवासपरा नारी नित्यं कुर्यात्प्रदक्षिणाः ।\nअष्टोत्तरशतं विप्र मंत्रेणानेन सादरम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001736042, "chapter_id": 21736, "verse_number": "१-१२२-४३", "content_sanskrit": "हरेण निर्मितः पूर्वं त्वमशोक कृपालुना ।\nलोकोपकारकरणस्तत्प्रसीद शिवप्रिय ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001736043, "chapter_id": 21736, "verse_number": "१-१२२-४४", "content_sanskrit": "ततस्तृतीये दिवसे वृक्षे तस्मिन्वृषध्वजम् ।\nसमभ्यर्च्य विधानेन द्विजं संभोज्य दापयेत् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001736044, "chapter_id": 21736, "verse_number": "१-१२२-४५", "content_sanskrit": "एवं कृतव्रता नारी वैधव्यं नाप्नुयात्क्वचित् ।\nपुत्रपौत्रादि सहिता भर्तुश्च स्यात्सुवल्लभा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001736045, "chapter_id": 21736, "verse_number": "१-१२२-४६", "content_sanskrit": "ऊर्ज्जकृष्णत्रयोदश्यामेकभक्तः समाहितः ।\nप्रदोषे तैलदीपं तु प्रज्वाल्याभ्यर्च्य यत्नतः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001736046, "chapter_id": 21736, "verse_number": "१-१२२-४७", "content_sanskrit": "गृहद्वारे बहिर्दद्याद्यमो मे प्रीयतामिति ।\nएवं कृते तु विप्रेंद्र यमपीडा न जायते ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001736047, "chapter_id": 21736, "verse_number": "१-१२२-४८", "content_sanskrit": "ऊर्ज्शुक्लत्रयोदश्यामेकभोजी द्विजोत्तम ।\nपुनः स्नात्वा प्रदोषे तु वाग्यतः सुसमाहितः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001736048, "chapter_id": 21736, "verse_number": "१-१२२-४९", "content_sanskrit": "प्रदीपानां सहस्रेण शतेनाप्यथवा द्विज ।\nप्रदीपयेच्छिवं वापि द्वात्रिंशद्दीपमालया ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001736049, "chapter_id": 21736, "verse_number": "१-१२२-५०", "content_sanskrit": "घृतेन दीपयेद्द्वीपान्गंधाद्यैः पूजयेच्छिवम् ।\nफलैर्नानाविधैश्चैव नैवेद्यैरपि नारद ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001736050, "chapter_id": 21736, "verse_number": "१-१२२-५१", "content_sanskrit": "ततः स्तुवीत देवेशं शिवं नाम्नां शतेन च ।\nतानि नामानि कीर्त्यंते सर्वाभीष्टप्रदानि वै ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001736051, "chapter_id": 21736, "verse_number": "१-१२२-५२", "content_sanskrit": "नमो रुद्राय भीमाय नीलकंठाय वेधसे ।\nकपर्द्दिने सुरेशाय व्योमकेशाय वै नमः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001736052, "chapter_id": 21736, "verse_number": "१-१२२-५३", "content_sanskrit": "वृषध्वजाय सोमाय सोमनाथाय वै नमः ।\nदिगंबराय भृंगाय उमाकांताय वर्द्धिने ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001736053, "chapter_id": 21736, "verse_number": "१-१२२-५४", "content_sanskrit": "तपोमयाय व्याप्ताय शिपिविष्याय वै नमः ।\nव्यालप्रियाय व्यालाय व्यालानां पतये नमः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001736054, "chapter_id": 21736, "verse_number": "१-१२२-५५", "content_sanskrit": "महीधराय व्योमाय पशूनां पतये नमः ।\nत्रिपुरघ्नाय सिंहाय शार्दूलायार्षभाय च ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001736055, "chapter_id": 21736, "verse_number": "१-१२२-५६", "content_sanskrit": "मिताय मितनाथाय सिद्धाय परमेष्ठिने ।\nवेदगीताय गुप्ताय वेदगुह्याय वै नमः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001736056, "chapter_id": 21736, "verse_number": "१-१२२-५७", "content_sanskrit": "दीर्घाय दीर्घरूपाय दीर्घार्थाय महीयसे ।\nनमो जगत्प्रतिष्ठाय व्योमरूपाय वै नमः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001736057, "chapter_id": 21736, "verse_number": "१-१२२-५८", "content_sanskrit": "कल्याणाय विशिष्याय शिष्टाय परमात्मने ।\nगजकृत्ति धरायाथ अंधकासुरभेदिने ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001736058, "chapter_id": 21736, "verse_number": "१-१२२-५९", "content_sanskrit": "नीललोहितशुक्लाय चडमुंडप्रियाय च ।\nभक्तिप्रियाय देवाय यज्ञांतायाव्ययाय च ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001736059, "chapter_id": 21736, "verse_number": "१-१२२-६०", "content_sanskrit": "महेशाय नमस्तुभ्यं महादेवहराय च ।\nत्रिनेत्राय त्रिवेदाय वेदांगाय नमो नमः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001736060, "chapter_id": 21736, "verse_number": "१-१२२-६१", "content_sanskrit": "अर्थायार्थस्वरूपाय परमार्थाय वै नमः ।\nविश्वरूपाय विश्वाय विश्वनाथाय वै नमः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001736061, "chapter_id": 21736, "verse_number": "१-१२२-६२", "content_sanskrit": "शंकराय च कालाय कालावयवरूपिणे ।\nअरूपाय विरूपाय सूक्ष्मसूक्ष्माय वै नमः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001736062, "chapter_id": 21736, "verse_number": "१-१२२-६३", "content_sanskrit": "श्मशानवासिने तुभ्यं नमस्ते कृत्तिवाससे ।\nशशांकशेखरायाथ रुद्रभूमिश्रिताय च ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001736063, "chapter_id": 21736, "verse_number": "१-१२२-६४", "content_sanskrit": "दुर्गाय दुर्गपाराय दुर्गावयवसाक्षिणे ।\nलिंगरूपाय लिंगाय लिंगानपतये नमः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001736064, "chapter_id": 21736, "verse_number": "१-१२२-६५", "content_sanskrit": "नमः प्रभावरूपाय प्रभावार्थाय वै नमः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001736065, "chapter_id": 21736, "verse_number": "१-१२२-६६", "content_sanskrit": "नमो नमः कारणकारणाय ते मृत्युंजयायात्मभवस्वरूपिणे ।\nत्रियंबकाय शितिकंठभार्गिणे गौरीयुजे मंगलहेतवे नमः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001736066, "chapter_id": 21736, "verse_number": "१-१२२-६७", "content_sanskrit": "नाम्नां शतमिदं विप्र पिनाकिगुणकीर्तनम् ।\nपठित्वा दक्षिणीकृत्य प्रायान्निजनिकेतनम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001736067, "chapter_id": 21736, "verse_number": "१-१२२-६८", "content_sanskrit": "एवं कृत्वा व्रतं विप्र महादेवप्रसादतः ।\nभुक्त्वेह भोगानखिलानंते शिवपदं लभेत् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001736068, "chapter_id": 21736, "verse_number": "१-१२२-६९", "content_sanskrit": "मार्गशुक्लत्रयोदश्यां योऽनंगं विधिना यजेत् ।\nत्रिकालमेककालं वा शिवसंगमसंभवम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001736069, "chapter_id": 21736, "verse_number": "१-१२२-७०", "content_sanskrit": "गन्धाद्यैरुपचारैस्तु पूजयित्वा विधानतः ।\nघटे मंगलपट्टे वा भोजयेद्द्विजदंपती ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001736070, "chapter_id": 21736, "verse_number": "१-१२२-७१", "content_sanskrit": "ततश्च दक्षिणां दत्वा स्वयमेकाशनं चरेत् ।\nएवं कृते तु विधिवद्व्रती सौभाग्यभाजनः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001736071, "chapter_id": 21736, "verse_number": "१-१२२-७२", "content_sanskrit": "जायते भुवि विप्रेन्द्र महादेवप्रसादतः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001736072, "chapter_id": 21736, "verse_number": "१-१२२-७३", "content_sanskrit": "पौषशुक्लत्रयोदश्यां समभ्यर्च्याच्युतं हरिम् ।\nघृतपात्रं द्विजेन्द्राय प्रदद्यात्सर्वसिद्धये ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001736073, "chapter_id": 21736, "verse_number": "१-१२२-७४", "content_sanskrit": "माघशुक्लत्रयोदश्यां समारभ्य दिनत्रयम् ।\nमाघस्नानव्रतं विप्र नानाकामफलावहम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001736074, "chapter_id": 21736, "verse_number": "१-१२२-७५", "content_sanskrit": "प्रयागे माघमासे तु त्र्यहं स्नातस्य यत्फलम् ।\nनाश्वमेघसहस्रेण तत्फलं लभते भुवि ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001736075, "chapter_id": 21736, "verse_number": "१-१२२-७६", "content_sanskrit": "तत्र स्नानं जपो होमो दानं चानंत्यमश्नुते ।\nफाल्गुने तु सिते पक्षे त्रयोदश्यामुपोषितः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001736076, "chapter_id": 21736, "verse_number": "१-१२२-७७", "content_sanskrit": "नमस्कृत्य जगन्नाथं प्रारंभे धनदव्रतम् ।\nमहाराजं यक्षपतिं गंधाद्यैरुपचारकैः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001736077, "chapter_id": 21736, "verse_number": "१-१२२-७८", "content_sanskrit": "लिखितं वर्णकैः पट्टे पूजयेद्भक्तिभावतः ।\nएवं शुक्लत्रयोदश्यां प्रतिमासं द्विजोत्तम ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001736078, "chapter_id": 21736, "verse_number": "१-१२२-७९", "content_sanskrit": "संपूजयेत्सोपवासश्चैकभुक्तो भवेन्नरः ।\nततो व्रतांते तु पुनः सौवर्णं धननायकम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001736079, "chapter_id": 21736, "verse_number": "१-१२२-८०", "content_sanskrit": "विधाय निधिभिः सार्द्धं सौवर्णाभिर्द्विजोत्तम ।\nउपचारैः षोडशभिः स्नानैः पंचामृतादिभिः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001736080, "chapter_id": 21736, "verse_number": "१-१२२-८१", "content_sanskrit": "नैवेद्यैर्विविधैर्भक्त्या पूजयेत्तु समाहितः ।\nततो धेनुमलंकृत्य वस्त्रस्रग्गंधभूषणैः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001736081, "chapter_id": 21736, "verse_number": "१-१२२-८२", "content_sanskrit": "सवत्सां दापयेद्विप्र सम्यग्वेदविदे शुभाम् ।\nसंभोज्य विप्रान्मिष्टान्नैर्द्वादशाथ त्रयोदश ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001736082, "chapter_id": 21736, "verse_number": "१-१२२-८३", "content_sanskrit": "गुरुं समर्च्य वस्त्राद्यैः प्रतिमां तां निवेदयेत् ।\nद्विजेभ्यो दक्षणां शक्त्या दत्वा नत्वा विसृज्य च ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001736083, "chapter_id": 21736, "verse_number": "१-१२२-८४", "content_sanskrit": "स्वयं भुंजीत मतिमानिष्टैः सह समाहितः ।\nएवं कृते व्रते विप्र निर्धनः प्राप्य वैभवम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001736084, "chapter_id": 21736, "verse_number": "१-१२२-८५", "content_sanskrit": "मोदते भुवि विख्यातो राजराज इवापरः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}]