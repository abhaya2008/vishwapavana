[{"id": 7000629000, "chapter_id": 20629, "verse_number": "५-८८-१", "content_sanskrit": "सुमनोवाच ।\nऋणसंबंधिनं पुत्रं प्रवक्ष्यामि तवाग्रतः ।\nऋणं यस्य गृहीत्वा यः प्रयाति मरणं किल ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000629001, "chapter_id": 20629, "verse_number": "५-८८-२", "content_sanskrit": "अर्थदाता सुतो भूत्वा भ्रातावाथ पिता प्रिया ।\nमित्ररूपेण वर्तेत अंतर्दुष्टः सदैव सः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000629002, "chapter_id": 20629, "verse_number": "५-८८-३", "content_sanskrit": "गुणं नैव प्रपश्येत स क्रूरो निष्ठुराकृतिः ।\nजल्पते निष्ठुरं वाक्यं सदैव स्वजनेषु च ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000629003, "chapter_id": 20629, "verse_number": "५-८८-४", "content_sanskrit": "मिष्टं मिष्टं समश्नाति भोगान्भुंजति नित्यशः ।\nद्यूतकर्मरतो नित्यं चौरकर्मणि सस्पृहः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000629004, "chapter_id": 20629, "verse_number": "५-८८-५", "content_sanskrit": "गृहाद्द्रव्यं चोरयति वार्यमाणः स कुप्यति ।\nपितरं मातरं चैव कुत्सते च दिनेदिने ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000629005, "chapter_id": 20629, "verse_number": "५-८८-६", "content_sanskrit": "एवं संक्षीयते द्रव्यमेवमेतद्वदत्यपि ।\nगृहं क्षेत्रादिकं सर्वं ममैव हि न संशयः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000629006, "chapter_id": 20629, "verse_number": "५-८८-७", "content_sanskrit": "पितरं मातरं चैव हिनस्त्येव दिने दिने ।\nसुदंडैर्मुशलैश्चैव केशोत्पाटैश्च दारुणैः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000629007, "chapter_id": 20629, "verse_number": "५-८८-८", "content_sanskrit": "मृते तु तस्मिन्पितरि मातरि चातिनिष्ठुरः ।\nनिःस्नेहो निष्ठुरश्चैव जायते नात्र संशयः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000629008, "chapter_id": 20629, "verse_number": "५-८८-९", "content_sanskrit": "श्राद्धकार्याणि दानानि न करोति सदैव सः ।\nएवंविधाः प्रियाः पुत्रा भवंति च महीपते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000629009, "chapter_id": 20629, "verse_number": "५-८८-१०", "content_sanskrit": "रिपुं पुत्रं प्रवक्ष्यामि तवाग्रे द्विजसत्तम ।\nबाल्येवयसि संप्राप्ते पुत्रत्वे वर्तते सदा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000629010, "chapter_id": 20629, "verse_number": "५-८८-११", "content_sanskrit": "पितरं मातरं चैव क्रीडमानो हि ताडयेत् ।\nताडयित्वा प्रयात्येवं प्रहस्यैवं पुनः पुनः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000629011, "chapter_id": 20629, "verse_number": "५-८८-१२", "content_sanskrit": "पुनरायाति तं तत्र पितरं मातरं पुनः ।\nसक्रोधो वर्तते नित्यं कुत्सते च दिनेदिने ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000629012, "chapter_id": 20629, "verse_number": "५-८८-१३", "content_sanskrit": "एवं संवर्तते नित्यं वैरकर्मणि संपदा ।\nपितरं ताडयित्वा च मातरं च ततः पुनः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000629013, "chapter_id": 20629, "verse_number": "५-८८-१४", "content_sanskrit": "प्रयात्येवं स दुष्टात्मा पूर्ववैरानुभावतः ।\nअथातः संप्रवक्ष्यामि यथालभ्यं भवेत्प्रियम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000629014, "chapter_id": 20629, "verse_number": "५-८८-१५", "content_sanskrit": "जातमात्रं प्रियं कुर्याद्बाल्ये क्रीडनताडनैः ।\nवयः प्राप्य प्रियं कुर्यान्मातृपित्रोरनंतरम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000629015, "chapter_id": 20629, "verse_number": "५-८८-१६", "content_sanskrit": "भक्त्या संतोषयेन्नित्यं तावुभौ परितोषयेत् ।\nस्नेहेन वचसा चैव प्रियसंभाषणेन च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000629016, "chapter_id": 20629, "verse_number": "५-८८-१७", "content_sanskrit": "मृतौ गुरू समाज्ञाय स्नेहेन रुदते पुनः ।\nश्राद्धकर्माणि सर्वाणि पिंडदानादिकां क्रियाम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000629017, "chapter_id": 20629, "verse_number": "५-८८-१८", "content_sanskrit": "करोत्येवसुदुःखार्तस्तेभ्यो यात्रां प्रयच्छति ।\nऋणत्रयान्वितः स्नेहान्मोचयेद्यस्तु निश्चितः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000629018, "chapter_id": 20629, "verse_number": "५-८८-१९", "content_sanskrit": "यस्माल्लभ्यं भवेत्कांत प्रयच्छति न संशयः ।\nपुत्रो भूत्वा महाप्राज्ञ अनेनविधिना किल ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000629019, "chapter_id": 20629, "verse_number": "५-८८-२०", "content_sanskrit": "उदासीनं प्रवक्ष्यामि तवाग्रे प्रिय सांप्रतम् ।\nउदासीनेन भावेन सदैव परिवर्तते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000629020, "chapter_id": 20629, "verse_number": "५-८८-२१", "content_sanskrit": "ददाति नैव गृह्णाति न च कुप्यति तुष्यति ।\nनो वा प्रयाति संत्यज्य उदासीनो द्विजोत्तम ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000629021, "chapter_id": 20629, "verse_number": "५-८८-२२", "content_sanskrit": "भृत्याश्चापि समाख्याताः पशवस्तुरगास्तथा ।\nगजा महिष्यो दास्यश्च ऋणसंबंधिनस्त्वमी ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000629022, "chapter_id": 20629, "verse_number": "५-८८-२३", "content_sanskrit": "गृहीतमाययैकेन आवाभ्यां तु न कस्य हि ।\nन्यासमेवं न कस्यापि कृतं वै पूर्वजन्मनि ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000629023, "chapter_id": 20629, "verse_number": "५-८८-२४", "content_sanskrit": "राधयामि न कस्यापि क्षणं कांत शृणुष्व हि ।\nन वैरमस्ति केनापि पूर्वजन्मनि वै कृतम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000629024, "chapter_id": 20629, "verse_number": "५-८८-२५", "content_sanskrit": "आबाल्येन तु विप्रेंद्र न च त्यक्तो मया पतिः ।\nएवं ज्ञात्वा शमं गच्छ त्यज चिंतामनर्थिकीम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000629025, "chapter_id": 20629, "verse_number": "५-८८-२६", "content_sanskrit": "हृतं नैव च कस्यापि नैव दत्तं त्वया पुनः ।\nकथं ते धनमायाति विस्मयं व्रज मा विभो ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000629026, "chapter_id": 20629, "verse_number": "५-८८-२७", "content_sanskrit": "प्राप्तमेव हि यत्रैव रक्षितुश्च न तिष्ठति ।\nएवं ज्ञात्वा शमं गच्छ त्यज चिंतामनर्थिकीम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000629027, "chapter_id": 20629, "verse_number": "५-८८-२८", "content_sanskrit": "कस्य पुत्राः प्रिया भार्या कस्य स्वजनबांधवाः ।\nकः कस्य नास्ति संसारे न संबंधो द्विजोत्तम ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000629028, "chapter_id": 20629, "verse_number": "५-८८-२९", "content_sanskrit": "मायामोहेन संमूढा मानवाः पापचेतनाः ।\nइदं गृहमयं पुत्र इयं भार्या ममैव हि ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000629029, "chapter_id": 20629, "verse_number": "५-८८-३०", "content_sanskrit": "अनृतं दृश्यते कांत संसारस्य हि बंधनम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]