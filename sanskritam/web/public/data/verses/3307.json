[{"id": 2106325, "chapter_id": 3307, "verse_number": "१६-३६-१", "content_sanskrit": "सौतिरुवाच।\nएतच्छ्रुत्वा नृपो विद्वान्हृष्टोऽभूज्जनमेजयः।\nपितामहानां सर्वेषां गमनागमनं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2106326, "chapter_id": 3307, "verse_number": "१६-३६-२", "content_sanskrit": "अब्रवीच्च मुदा युक्तः पुनरागमनं प्रति।\nकथं न त्यक्तदेहानां पुनस्तद्रूपदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2106327, "chapter_id": 3307, "verse_number": "१६-३६-३", "content_sanskrit": "इत्युक्तः स द्विजश्रेष्ठो व्यासशिष्यः प्रतापवान्।\nप्रोवाच वदतांश्रेष्ठस्तं नृपं जनमेजयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2106328, "chapter_id": 3307, "verse_number": "१६-३६-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2106329, "chapter_id": 3307, "verse_number": "१६-३६-४", "content_sanskrit": "अविप्रणाशः सर्वेषां कर्मणामिति निश्चयः।\nकर्मजानि शरीराणि शरीराकृतयस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2106330, "chapter_id": 3307, "verse_number": "१६-३६-५", "content_sanskrit": "महाभूतानि नित्यानि भूताधिपतिसंश्रयात्।\nतेषां च नित्यसंवासो न विनाशो वियुज्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2106331, "chapter_id": 3307, "verse_number": "१६-३६-६", "content_sanskrit": "अनाशया कृतं कर्म तस्य चेष्टः फलागमः।\nआत्मा चैभिः समायुक्तः सुखदुःखमुपाश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2106332, "chapter_id": 3307, "verse_number": "१६-३६-७", "content_sanskrit": "अविनाश्यस्तथा नित्यं क्षेत्रज्ञ इति निश्चयः।\nभूतानामात्मभावो यो ध्रुवोसौ संविजानताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2106333, "chapter_id": 3307, "verse_number": "१६-३६-८", "content_sanskrit": "यावन्न क्षीयते कर्म तावत्तस्य स्वरूपता।\nक्षीणकर्मा नरो लोके रूपान्यत्वमुपाश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2106334, "chapter_id": 3307, "verse_number": "१६-३६-९", "content_sanskrit": "नानाभूतास्तथैकत्वं शरीरं प्राप्य संहताः।\nभवन्ति ते तथा नित्याः पृथग्भावं विजानताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2106335, "chapter_id": 3307, "verse_number": "१६-३६-१०", "content_sanskrit": "अश्वमेधश्रुतिश्चेयमश्वसंज्ञपनं प्रति।\nलोकान्तरगता नित्यं प्राणा नित्या हि वाजिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2106336, "chapter_id": 3307, "verse_number": "१६-३६-११", "content_sanskrit": "अहं हितं वदाम्येतत्प्रियं चेत्तव पार्थिव।\nदेवयाना हि पन्थानः श्रुतास्ते यज्ञसंस्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2106337, "chapter_id": 3307, "verse_number": "१६-३६-१२", "content_sanskrit": "सुकृतो यत्र यज्ञस्ते तत्र देवा हितास्तव।\nयदा समन्विता देवाः पशूनां गमनेश्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2106338, "chapter_id": 3307, "verse_number": "१६-३६-१३", "content_sanskrit": "गमिमन्तश्च तेनेष्ट्वा नान्ये नित्या भवन्त्युत।\nनित्येऽस्मिन्पञ्चके वर्गे नित्ये चात्मनि पूरुषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2106339, "chapter_id": 3307, "verse_number": "१६-३६-१४", "content_sanskrit": "अस्य नाशं समायोगं यः पश्यति वृथामतिः।\nवियोगे शोचतेऽत्यर्थं स बाल इति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2106340, "chapter_id": 3307, "verse_number": "१६-३६-१५", "content_sanskrit": "वियोगे दोषदर्शी यः संयोगं स विसर्जयेत्।\nअसङ्गे सङ्गमो नास्ति दुःखं भावि वियोगजम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2106341, "chapter_id": 3307, "verse_number": "१६-३६-१६", "content_sanskrit": "परापरज्ञस्त्वपरो नाभिमानादुदीक्षितः।\nअपरज्ञः परां बुद्धिं स्पृष्ट्वा मोहाद्विमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2106342, "chapter_id": 3307, "verse_number": "१६-३६-१७", "content_sanskrit": "अदर्शनादापतितः पुनश्चादर्शनं गतः।\nनाहं तं वेद्मि नासौ मां न च मेऽस्ति विरागता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2106343, "chapter_id": 3307, "verse_number": "१६-३६-१८", "content_sanskrit": "येनयेन शरीरेणि करोत्ययमनीश्वरः।\nतेनतेन शरीरेण तदवश्यमुपाश्नुते।\nमानसं मनसाऽऽप्नोति शरीरं च शरीरवान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2106344, "chapter_id": 3307, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्रमवासिकपर्वणि पुत्रदर्शनपर्वणि षट्त्रिंशोऽध्यायः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]