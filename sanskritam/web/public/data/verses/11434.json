[{"id": 50010063, "chapter_id": 11434, "verse_number": "1", "content_sanskrit": "श्रीशुक उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50010064, "chapter_id": 11434, "verse_number": "2", "content_sanskrit": "निशम्य कौषारविणोपवर्णितं ध्रुवस्य वैकुण्ठपदाधिरोहणम्। प्ररूढभावो भगवत्यधोक्षजे प्रष्टुं पुनस्तं विदुरः प्रचक्रमे॥ ४/१३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50010065, "chapter_id": 11434, "verse_number": "3", "content_sanskrit": "विदुर उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50010066, "chapter_id": 11434, "verse_number": "4", "content_sanskrit": "के ते प्रचेतसो नाम कस्यापत्यानि सुव्रत। कस्यान्ववाये प्रख्याताः कुत्र वा सत्रमासत॥ ४/१३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50010067, "chapter_id": 11434, "verse_number": "5", "content_sanskrit": "मन्ये महाभागवतं नारदं देवदर्शनम्। येन प्रोक्तः क्रिययोगः परिचर्याविधिर्हरेः॥ ४/१३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50010068, "chapter_id": 11434, "verse_number": "6", "content_sanskrit": "स्वधर्मशीलैः पुरुषैर्भगवान् यज्ञपूरुषः। इज्यमानो भक्तिमता नारदेनेरितः किल॥ ४/१३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50010069, "chapter_id": 11434, "verse_number": "7", "content_sanskrit": "यास्ता देवर्षिणा तत्र वर्णिता भगवत्कथाः। मह्यं शुश्रूषवे ब्रह्मन् कात्स्र्न्येनाचष्टुमर्हसि॥ ४/१३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50010070, "chapter_id": 11434, "verse_number": "8", "content_sanskrit": "मैत्रेय उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50010071, "chapter_id": 11434, "verse_number": "9", "content_sanskrit": "ध्रुवस्य चोत्कलः पुत्रः पितरि प्रस्थिते वनम्। सार्वभौमश्रियं नैच्छदधिराजासनं पितुः॥ ४/१३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50010072, "chapter_id": 11434, "verse_number": "10", "content_sanskrit": "स जन्मनोपशान्तात्मा निस्सङ्गः समदर्शनः। ददर्श लोके विततमात्मानं लोकमात्मनि॥ ४/१३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50010073, "chapter_id": 11434, "verse_number": "11", "content_sanskrit": "आत्मानं ब्रह्म निर्वाणं प्रत्यस्तमितविग्रहम्। अवबोधरसैकात्म्यमानन्दमनुसन्ततम्॥ ४/१३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50010074, "chapter_id": 11434, "verse_number": "12", "content_sanskrit": "अव्यवच्छिन्नयोगाग्निदग्धकर्ममलाशयः। स्वरूपमवरुन्धानो नान्यदस्मात् तदैक्षत॥ ४/१३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50010075, "chapter_id": 11434, "verse_number": "13", "content_sanskrit": "जडान्धबधिरोन्मत्तमूकाकृतिरतन्मतिः। लक्षितः पथि बालानां प्रशान्तार्चिरिवानलः॥ ४/१३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50010076, "chapter_id": 11434, "verse_number": "14", "content_sanskrit": "मत्वा तं जडमुन्मत्तं कुलवृद्धाः समन्त्रिणः। वत्सरं भूपतिं चक्रुर्यवीयांसं भृमेः सुतम्॥ ४/१३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50010077, "chapter_id": 11434, "verse_number": "15", "content_sanskrit": "स्वर्वीर्या वत्सरस्येष्टा भार्याऽसूत षडात्मजान्। पुष्पार्णं तिग्मकेतुं च इषमूर्जं वसुं जयम्॥ ४/१३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50010078, "chapter_id": 11434, "verse_number": "16", "content_sanskrit": "पुष्पार्णस्य प्रभा भार्या दोषा च द्वे बभूवतुः। प्रातर्मध्यन्दिनं सायमिति ह्यासन् प्रभासुताः॥ ४/१३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50010079, "chapter_id": 11434, "verse_number": "17", "content_sanskrit": "प्रदोषोऽथ निशीथश्च व्युष्टिर्दोषासुतास्त्रयः१। व्युष्टिः सुतं पुष्करिण्यां सर्वतेजसमादधे॥ ४/१३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50010080, "chapter_id": 11434, "verse_number": "18", "content_sanskrit": "स चक्षुः सुतमाकूत्यां पत्नयां मनुमवाप ह। मनोरसूत महिषी वैराजा नड्वला सुतान्॥ ४/१३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50010081, "chapter_id": 11434, "verse_number": "19", "content_sanskrit": "षुरुकुत्सं त्रितं द्युम्नं सत्यवन्तमृतव्रतम्। अग्निष्टोममतीरात्रं सुद्युम्नं शिबिमुल्मुकम्॥ ४/१३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50010082, "chapter_id": 11434, "verse_number": "20", "content_sanskrit": "उल्मुकोऽजनयत् पुत्रान् पुष्करिण्यां षडुत्तमान्। अङ्गं सुनासमाख्यातिं क्रतुमाङ्गिरसं गयम्॥ ४/१३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50010083, "chapter_id": 11434, "verse_number": "21", "content_sanskrit": "सुनीथाऽङ्गस्य या पत्नी सुषुवे वेनमुद्बणम्। यद्दौःशील्यात् स राजर्षिर्निर्विण्णो निरगात् पुरात्॥ ४/१३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50010084, "chapter_id": 11434, "verse_number": "22", "content_sanskrit": "यमङ्ग शेपुः कुपिता वाग्वज्रा मुनयः किल। गतासोस्तस्य भूयस्ते ममन्थुर्दक्षिणं करम्॥ ४/१३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50010085, "chapter_id": 11434, "verse_number": "23", "content_sanskrit": "अराजके तु भूलोके दस्युभिः पीडिताः प्रजाः। जातो नारायणांशेन पृथू राजा क्षितीश्वरः॥ ४/१३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50010086, "chapter_id": 11434, "verse_number": "24", "content_sanskrit": "विदुर उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50010087, "chapter_id": 11434, "verse_number": "25", "content_sanskrit": "तस्य शीलनिधेः साधोर्ब्रह्मण्यस्य महात्मनः। राज्ञः कथमभूद् दुष्टा प्रजा यद्विमना ययौ॥ ४/१३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50010088, "chapter_id": 11434, "verse_number": "26", "content_sanskrit": "किं चांहो वेनमुद्दिश्य ब्रह्मदण्डमयूयुजन्। दण्डव्रतधरे राज्ञि मुनयो धर्मकोविदाः॥ ४/१३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50010089, "chapter_id": 11434, "verse_number": "27", "content_sanskrit": "नावध्येयः प्रजापालः प्रजाभिरघवानपि। यदसौ लोकपालानां बिभर्त्योजः स्वतेजसा॥ ४/१३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50010090, "chapter_id": 11434, "verse_number": "28", "content_sanskrit": "एतदाख्याहि मे ब्रह्मन् सुनीथात्मजचेष्टितम्। श्रद्दधानाय भक्ताय त्वं परावरवित्तमः॥ ४/१३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50010091, "chapter_id": 11434, "verse_number": "29", "content_sanskrit": "मैत्रेय उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50010092, "chapter_id": 11434, "verse_number": "30", "content_sanskrit": "अङ्गोऽश्वमेधं राजर्षिराजहार महाक्रतुम्। नाजग्मुर्देवतास्तस्मिन्नाहूता ब्रह्मवादिभिः॥ ४/१३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50010093, "chapter_id": 11434, "verse_number": "31", "content_sanskrit": "त ऊचुर्विस्मितास्तात यजमानमथर्त्विजः। हवींषि हूयमानानि न ते गृह्णन्ति देवताः॥ ४/१३/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50010094, "chapter_id": 11434, "verse_number": "32", "content_sanskrit": "राजन् हवींष्यदुष्टानि श्रद्धयाऽऽसादितानि ते। छन्दांस्ययातयामानि योजितानि धृतव्रतैः॥ ४/१३/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50010095, "chapter_id": 11434, "verse_number": "33", "content_sanskrit": "न विदामेह देवानां हेळनं वयमण्वपि। यन्न गृह्णन्ति भागान् स्वान् ये देवाः कर्मसाक्षिणः॥ ४/१३/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50010096, "chapter_id": 11434, "verse_number": "34", "content_sanskrit": "मैत्रेय उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50010097, "chapter_id": 11434, "verse_number": "35", "content_sanskrit": "अङ्गो द्विजवचः श्रुत्वा यजमानः सुदुर्मनाः। तत् प्रष्टुं व्यसृजद् वाचं सदस्यांस्तदनुज्ञया॥ ४/१३/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50010098, "chapter_id": 11434, "verse_number": "36", "content_sanskrit": "नागच्छन्त्याहुता देवा न गृह्णन्ति ग्रहानिह। सदसस्पतयो ब्रूत किमवद्यं मया कृतम्॥ ४/१३/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50010099, "chapter_id": 11434, "verse_number": "37", "content_sanskrit": "सदस्या ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50010100, "chapter_id": 11434, "verse_number": "38", "content_sanskrit": "नरदेवेह भवतो नावद्यं हि मनाक् स्थितम्। अस्त्येकं प्राक्तनमघं यदिहेदृक् त्वमप्रजः॥ ४/१३/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50010101, "chapter_id": 11434, "verse_number": "39", "content_sanskrit": "तथा साधय भद्रं ते आत्मानं सप्रजं नृप। इष्टस्ते पुत्रकामस्य पुत्रं दास्यति यज्ञभुक्॥ ४/१३/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50010102, "chapter_id": 11434, "verse_number": "40", "content_sanskrit": "यथा१ स्वभागधेयानि ग्रहीष्यन्ति दिवौकसः। यद् यज्ञपुरुषः साक्षादपत्याय हरिर्वृतः॥ ४/१३/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50010103, "chapter_id": 11434, "verse_number": "41", "content_sanskrit": "तांस्तान् कामान् हरिर्दद्याद् यान्यान् कामयते जनः। आराधितो यथैवैष तथा पुंसां फलोदयः॥ ४/१३/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50010104, "chapter_id": 11434, "verse_number": "42", "content_sanskrit": "इति व्यवसिता विप्रास्तस्य राज्ञः प्रजातये। पुरोडाशं निरवपन् शिपिविष्टाय विष्णवे॥ ४/१३/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50010105, "chapter_id": 11434, "verse_number": "43", "content_sanskrit": "तस्मात् पुरुष उत्तस्थौ हेममाल्यमलाम्बरः। हिरण्मयेन पात्रेण सिद्धमादाय पायसम्॥ ४/१३/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50010106, "chapter_id": 11434, "verse_number": "44", "content_sanskrit": "स विप्रानुमतो राजा गृहीत्वाऽञ्जलिनोदनम्। अवघ्राय मुदा युक्तः प्रादात् पत्नया उदारधीः॥ ४/१३/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50010107, "chapter_id": 11434, "verse_number": "45", "content_sanskrit": "सा तत् पुंसवनं राज्ञी प्राश्यर्तौ पत्युरादधे। ततः काल उपावृत्ते कुमारं सुषुवेऽप्रजा॥ ४/१३/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 50010108, "chapter_id": 11434, "verse_number": "46", "content_sanskrit": "स बाल एव पुरुषो मातामहमनुव्रतः। अधर्मांशोद्भवं मृत्युं तेनाभवदधार्मिकः॥ ४/१३/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 50010109, "chapter_id": 11434, "verse_number": "47", "content_sanskrit": "स शरासनमुद्यम्य मृगयुर्वनगोचरः। हन्त्यसाधुर्मृगान् दीनान् वेनोऽसावित्यरौज्जनः॥ ४/१३/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 50010110, "chapter_id": 11434, "verse_number": "48", "content_sanskrit": "आक्राडे क्राडतो बालान् वयस्यानतिदारुणः। प्रसह्य निरनुक्रोशः पशुमारममारयत्॥ ४/१३/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 50010111, "chapter_id": 11434, "verse_number": "49", "content_sanskrit": "तं विलक्ष्य खलं पुत्रं शासनैर्विविधैर्नृपः। यदा न शासितुं कल्यो भृशमासीत् सुदुर्मनाः॥ ४/१३/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 50010112, "chapter_id": 11434, "verse_number": "50", "content_sanskrit": "प्रायेणाभ्यर्चितो देवो येऽप्रजा गृहमेधिनः। कदपत्यकृतं दुःखं ये न विन्दन्ति दुर्भरम्॥ ४/१३/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 50010113, "chapter_id": 11434, "verse_number": "51", "content_sanskrit": "यतः पापीयसी कार्तिरधर्मश्च महान् नृणाम्। यतो विरोधः सर्वेषां यत आधिरनन्तकः॥ ४/१३/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 50010114, "chapter_id": 11434, "verse_number": "52", "content_sanskrit": "कस्तं प्रजापदेशं वै मोहबन्धनमात्मनः। पण्डितो बहुमन्येत यदर्थाः क्लेशदा गृहाः॥ ४/१३/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 50010115, "chapter_id": 11434, "verse_number": "53", "content_sanskrit": "कदपत्यं वरं मन्ये सदपत्याच्छुचास्पदात्। निर्विद्येत गृहार्न्मत्यो यत् क्लेशनिवहातुरः॥ ४/१३/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 50010116, "chapter_id": 11434, "verse_number": "54", "content_sanskrit": "एवं स निर्विण्णमना नृपो गृहा- न्निशीथ उत्थाय महोदयोदयात्। अलब्धनिद्रोऽनुपलक्षितो नृभि- र्हित्वा गतो वेनशुचा प्रतप्तः॥ ४/१३/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 50010117, "chapter_id": 11434, "verse_number": "55", "content_sanskrit": "विज्ञाय निर्विद्य गतं पतिं प्रजाः पुरोहितामात्यसुहृद्गणादयः। विचिक्युरुर्व्यामतिशोककातरा यथा निगूढं पुरुषं कुयोगिनः॥ ४/१३/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 50010118, "chapter_id": 11434, "verse_number": "56", "content_sanskrit": "अलक्षयन्तः पदवीं प्रजापतेर्हतोद्यमाः प्रत्युपसृत्य ते पुरीम्। ऋषीन् समेतानभिवन्द्य साश्रवो न्यवेदयन् पौरव भर्तृविप्लवम्॥ ४/१३/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 50010119, "chapter_id": 11434, "verse_number": "57", "content_sanskrit": "इति श्रीमद्भागवते चतुर्थस्कन्धे त्रयोदशोऽध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]