[{"id": 2053645, "chapter_id": 2183, "verse_number": "७-११०-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2053646, "chapter_id": 2183, "verse_number": "७-११०-१", "content_sanskrit": "भारद्वाजं कथं युद्धे युयुधानो न्यवारयत्।\nसञ्जयाचक्ष्व तत्त्वेन परं कौतूहलं हि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2053647, "chapter_id": 2183, "verse_number": "७-११०-२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2053648, "chapter_id": 2183, "verse_number": "७-११०-२", "content_sanskrit": "शृणु राजन्महाप्राज्ञ सङ्ग्रामं रोमहर्षणम्।\nद्रोणस्य पाण्डवैः सार्धं युयुधानपुरोगमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2053649, "chapter_id": 2183, "verse_number": "७-११०-३", "content_sanskrit": "वध्यमानं बलं दृष्ट्वा युयुधानेन मारिष।\nअभ्यद्रवत्स्वयं द्रोणः सात्यकिं सत्यविक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2053650, "chapter_id": 2183, "verse_number": "७-११०-४", "content_sanskrit": "तमापतन्तं सहसा भारद्वाजं महारथम्।\nसात्यकिः पञ्चविंशत्या क्षुद्रकाणां समार्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2053651, "chapter_id": 2183, "verse_number": "७-११०-५", "content_sanskrit": "द्रोणोऽपि युधि विक्रान्तो युयुधानं समाहितः।\nअविध्यत्पञ्चभिस्तूर्णं हेमपुङ्खैः शरैः शितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2053652, "chapter_id": 2183, "verse_number": "७-११०-६", "content_sanskrit": "ते वर्म भित्त्वा सुदृढं द्विषत्पिशितभोजनाः।\nअभ्ययुर्धरणीं राजन्वल्मीकमिव पन्नगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2053653, "chapter_id": 2183, "verse_number": "७-११०-७", "content_sanskrit": "दीर्घबाहुरभिक्रुद्धस्तोत्रार्दित इव द्विपः।\nद्रोणं पञ्चाशताऽविध्यन्नाराचैरग्निसन्निभैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2053654, "chapter_id": 2183, "verse_number": "७-११०-८", "content_sanskrit": "भारद्वाजो रणे विद्धो युयुधानेन सत्वरम्।\nसात्यकिं बहुभिर्बाणैर्यतमानमविध्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2053655, "chapter_id": 2183, "verse_number": "७-११०-९", "content_sanskrit": "ततः क्रुद्धो महेष्वासो भूय एव महाबलः।\nसात्वतं पीडयामास व्रातेन नतपर्वणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2053656, "chapter_id": 2183, "verse_number": "७-११०-१०", "content_sanskrit": "स वध्यमानः समरे भारद्वाजेन सात्यकिः।\nनान्वपद्यत कर्तव्यं किञ्चिदेव विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2053657, "chapter_id": 2183, "verse_number": "७-११०-११", "content_sanskrit": "विषण्णवदनश्चापि युयुधानोऽभवन्नृप।\nभारद्वाजं रणे दृष्ट्वा विसृजन्तं शिताञ्शरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2053658, "chapter_id": 2183, "verse_number": "७-११०-१२", "content_sanskrit": "तं तु सम्प्रेक्ष्य ते पुत्राः सैनिकाश्च विशाम्पते।\nप्रहृष्टमनसो भूत्वा सिंहवद्व्यनदन्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2053659, "chapter_id": 2183, "verse_number": "७-११०-१३", "content_sanskrit": "तं श्रुत्वा निनदं घोरं पीड्यमानं च माधवम्।\nयुधिष्ठिरोऽब्रवीद्राजा सर्वसैन्यानि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2053660, "chapter_id": 2183, "verse_number": "७-११०-१४", "content_sanskrit": "एष वृष्णिवरो वीरः सात्यकिः सत्यविक्रमः।\nग्रस्यते युधि वीरेण भानुमानिव राहुणा।\nअभिद्रवत गच्छध्वं सात्यकिर्यत्र युध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2053661, "chapter_id": 2183, "verse_number": "७-११०-१५", "content_sanskrit": "अभिद्रवत गच्छद्वं सात्यकिर्यत्र युध्यते॥\nधृष्टद्युम्नं च पाञ्चाल्यमिदमाह जनाधिपः।\n`द्रोणं वारय सुक्षित्रं सात्यकिं मावधीद्द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2053662, "chapter_id": 2183, "verse_number": "७-११०-१६", "content_sanskrit": "अभिद्रव द्रुतं द्रोणं किमु तिष्ठसि पार्पत।\nन पश्यसि भयं द्रोणाद्धोरं नः समुपस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2053663, "chapter_id": 2183, "verse_number": "७-११०-१७", "content_sanskrit": "असौ द्रोणो महेष्वासो युयुधानेन संयुगे।\nक्रीडते सूत्रबद्धेन पक्षिणा बालको यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2053664, "chapter_id": 2183, "verse_number": "७-११०-१८", "content_sanskrit": "तत्रैव सर्वे गच्छन्तु भीमसेनपुरोगमाः।\nत्वयैव सहिताः सर्वे युयुधानरथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2053665, "chapter_id": 2183, "verse_number": "७-११०-१९", "content_sanskrit": "पृष्ठतोऽनुगमिष्यामि त्वामहं सहसैनिकः।\nसात्यकिं मोक्षयस्वाद्य यमदंष्ट्रान्तरं गतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2053666, "chapter_id": 2183, "verse_number": "७-११०-२०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2053667, "chapter_id": 2183, "verse_number": "७-११०-२०", "content_sanskrit": "एवमुक्त्वा ततो राजा सर्वसैन्येन भारत।\nअभ्यद्रवद्रणे द्रोणं युयुधानस्य कारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2053668, "chapter_id": 2183, "verse_number": "७-११०-२१", "content_sanskrit": "तत्रारावो महानासीद्द्रोणमेकं युयुत्सताम्।\nपाण्डवानां च भद्रं ते सृञ्जयानां च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2053669, "chapter_id": 2183, "verse_number": "७-११०-२२", "content_sanskrit": "ते समेत्य नरव्याघ्रा भारद्वाजं महारथम्।\nअभ्यवर्षञ्शरैस्तीक्ष्णैः कङ्कबर्हिणवाजितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2053670, "chapter_id": 2183, "verse_number": "७-११०-२३", "content_sanskrit": "स्मयन्नेव तु तान्वीरान्द्रोणः प्रत्यग्रहीत्स्वयम्।\nअतिथीनागतान्यद्वत्सलिलेनासनेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2053671, "chapter_id": 2183, "verse_number": "७-११०-२४", "content_sanskrit": "तर्पितास्ते शरैस्तस्य भारद्वाजस्य धन्विनः।\nआतिथेयं गृहं प्राप्य तर्प्यन्तेऽतिथयो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2053672, "chapter_id": 2183, "verse_number": "७-११०-२५", "content_sanskrit": "भारद्वाजं च ते सर्वे न शेकुः प्रतिवीक्षितुम्।\nमध्यन्दिनमनुप्राप्तं सहस्रांशुमिव प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2053673, "chapter_id": 2183, "verse_number": "७-११०-२६", "content_sanskrit": "तांस्तु सर्वान्महेष्वासान्द्रोणः शस्त्रभृतां वरः।\nअतापयच्छरव्रातैर्गभस्तिभिरिवांशुमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2053674, "chapter_id": 2183, "verse_number": "७-११०-२७", "content_sanskrit": "वध्यमाना महाराज पाण्डवाः सृञ्जयास्तथा।\nत्रातारं नाध्यगच्छन्त पङ्कमग्ना इव द्विपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2053675, "chapter_id": 2183, "verse_number": "७-११०-२८", "content_sanskrit": "द्रोणस्य च व्यदृश्यन्त विसर्पन्तो महाशराः।\nगभस्तय इवार्कस्य प्रतपन्तः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2053676, "chapter_id": 2183, "verse_number": "७-११०-२९", "content_sanskrit": "तस्मिन्द्रोणेन निहताः पाञ्चालाः पञ्चविंशतिः।\nमहारथाः समाख्याता धृष्टद्युम्नस्य सम्मताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2053677, "chapter_id": 2183, "verse_number": "७-११०-३०", "content_sanskrit": "पाण्डूनां सर्वसैन्येषु पाञ्चालानां तथैव च।\nद्रोणं स्म ददृशुः शूरं विनिघ्नन्तं वरान्वरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2053678, "chapter_id": 2183, "verse_number": "७-११०-३१", "content_sanskrit": "केकयानां शतं हत्वा विद्राव्य च समन्ततः।\nद्रोणस्तस्थौ महाराज व्यादितास्य इवान्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2053679, "chapter_id": 2183, "verse_number": "७-११०-३२", "content_sanskrit": "पाञ्चालान्सृञ्जयान्मत्स्यान्केकयांश्च नराधिप।\nद्रोणोऽजयन्महाबाहुः शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2053680, "chapter_id": 2183, "verse_number": "७-११०-३३", "content_sanskrit": "तेषां समभवच्छब्दो विद्धानां द्रोणसायकैः।\nवनौकसामिवारण्ये व्याप्तानां धृमकेतुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2053681, "chapter_id": 2183, "verse_number": "७-११०-३४", "content_sanskrit": "तत्र देवाः सगन्धर्वाः पितरश्चाब्रुवन्नृप।\nएते द्रवन्ति पाञ्चालाः पाण्डवाश्च ससैनिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2053682, "chapter_id": 2183, "verse_number": "७-११०-३५", "content_sanskrit": "तं तथा समरे द्रोणं निघ्नन्तं सौमकान्रणे।\nन चाप्यभिययुः केचिदपरे नैव विव्यधुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2053683, "chapter_id": 2183, "verse_number": "७-११०-३६", "content_sanskrit": "वर्तमाने तथा रौद्रे तस्मिन्वीरवरक्षये।\nअशृणोत्सहसा पार्थः पाञ्चजन्यस्य निःस्वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2053684, "chapter_id": 2183, "verse_number": "७-११०-३७", "content_sanskrit": "पूरिते वासुदेवेन शङ्खराजे महात्मना।\nयुध्यमानेषु वीरेषु सैन्धवस्याभिरक्षिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2053685, "chapter_id": 2183, "verse_number": "७-११०-३८", "content_sanskrit": "नदत्सु धार्तराष्ट्रेषु विजयस्य रथं प्रति।\nगाण्डीवस्य च निर्घोषे विप्रनष्टे समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2053686, "chapter_id": 2183, "verse_number": "७-११०-३९", "content_sanskrit": "कश्मलाभिहतो राजा चिन्तयामास पाण्डवः।\nन नूनं स्वस्ति पार्थाय यथा नदति शङ्खराट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2053687, "chapter_id": 2183, "verse_number": "७-११०-४०", "content_sanskrit": "कौरवाश्च यथा हृष्टा विनदन्ति मुहुर्मुहुः।\n`व्यक्तमद्य विनश्यन्ति सर्वलोकमहारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2053688, "chapter_id": 2183, "verse_number": "७-११०-४१", "content_sanskrit": "एवं सञ्चिन्तयित्वा तु व्याकुलेनान्तरात्मना।\nअजताशत्रुः कौन्तेयः सात्वतं प्रत्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2053689, "chapter_id": 2183, "verse_number": "७-११०-४२", "content_sanskrit": "बाष्पगद्गदया वाचा मुह्यमानो मुहुर्मुहुः।\nकृत्यस्यानन्तरापेक्षी शैनेयं शिनिपुङ्गवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2053690, "chapter_id": 2183, "verse_number": "७-११०-४३x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2053691, "chapter_id": 2183, "verse_number": "७-११०-४३", "content_sanskrit": "यः स धर्मः पुरा दृष्टः सद्भिः शैनेय शाश्वतः।\nसाम्पराये सुहृत्कृत्ये तस्य कालोऽयमागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2053692, "chapter_id": 2183, "verse_number": "७-११०-४४", "content_sanskrit": "सर्वेष्वपि च योधेषु चिन्तयञ्शिनिपुङ्गव।\nत्वत्तः सुहृत्तमं कञ्चिन्नाभिजानामि सात्यके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2053693, "chapter_id": 2183, "verse_number": "७-११०-४५", "content_sanskrit": "यो हि प्रीतमना नित्यं यश्च नित्यमनुव्रतः।\nस कार्ये साम्पराये तु नियोज्य इति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2053694, "chapter_id": 2183, "verse_number": "७-११०-४६", "content_sanskrit": "यथा च केशवो नित्यं पाण्डवानानं परायणम्।\nतथा त्वमपि वार्ष्णेय कृष्णतुल्यपराक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2053695, "chapter_id": 2183, "verse_number": "७-११०-४७", "content_sanskrit": "सोऽहं भारं समाधास्ये त्वयि तं वोढुमर्हसि।\nअभिप्रायं च मे नित्यं न वृथा कर्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2053696, "chapter_id": 2183, "verse_number": "७-११०-४८", "content_sanskrit": "स त्वं भ्रातुर्वयस्यस्य गुरोरपि च संयुगे।\nकुरु कृच्छ्रे सहायार्थमर्जुनस्य नरर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2053697, "chapter_id": 2183, "verse_number": "७-११०-४९", "content_sanskrit": "त्वं हि सत्यव्रतः शूरो मित्राणामभयङ्करः।\nलोके विख्यायसे वीर कर्मभिः सत्यवागिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2053698, "chapter_id": 2183, "verse_number": "७-११०-५०", "content_sanskrit": "यो हि शैनेय मित्रार्थे युध्यमानस्त्यजेत्तनुम्।\nपृथिवीं च द्विजातिभ्यो यो दद्यात्स समो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2053699, "chapter_id": 2183, "verse_number": "७-११०-५१", "content_sanskrit": "श्रुताश्च बहवोऽस्माभी राजानो ये दिवं गताः।\nदत्त्वेमां पृथिवीं कृत्स्नां ब्राह्मणेभ्यो यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2053700, "chapter_id": 2183, "verse_number": "७-११०-५२", "content_sanskrit": "`दीयमाना च बहुभिर्दास्यते च मुहुर्मही।\nन हि कश्चिद्रणे प्राणान्मित्रार्थे त्यक्तवानिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2053701, "chapter_id": 2183, "verse_number": "७-११०-५३", "content_sanskrit": "एवं त्वामपि धर्मात्मन्प्रयाचेऽहं कृताञ्जलिः।\nपृथिवीदानतुल्यं स्यादधिकं वा फलं विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2053702, "chapter_id": 2183, "verse_number": "७-११०-५४", "content_sanskrit": "एक एव सदा कृष्णो मित्राणामभयङ्करः।\nरणे सन्तजति प्राणान्द्वितीयस्त्वं च सात्यके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2053703, "chapter_id": 2183, "verse_number": "७-११०-५५", "content_sanskrit": "विक्रान्तस्य च वीरस्य युद्धे प्रार्थयतो यशः।\nशूर एव सहायः स्यान्नेतरः प्राकृतो जनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2053704, "chapter_id": 2183, "verse_number": "७-११०-५६", "content_sanskrit": "ईदृशे तु परामर्दे वर्तमानस्य माधव।\nत्वदन्यो हि रणे गोप्ता विजयस्य न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2053705, "chapter_id": 2183, "verse_number": "७-११०-५७", "content_sanskrit": "श्लाघन्नेव हि कर्माणि शतशस्तव पाण्डवः।\nमम सञ्चनयन्हर्षं पुनः पुनरकीर्तयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2053706, "chapter_id": 2183, "verse_number": "७-११०-५८", "content_sanskrit": "लघुहस्तश्चित्रयोधी तथा लघुपराक्रमः।\nप्राज्ञः सर्वास्त्रविच्छूरो मुह्यते न च संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2053707, "chapter_id": 2183, "verse_number": "७-११०-५९", "content_sanskrit": "महास्कन्धो महोरस्को महाबाहुर्महाहनुः।\nमहाबलो महावीर्यः स महात्मा महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2053708, "chapter_id": 2183, "verse_number": "७-११०-६०", "content_sanskrit": "शिष्यो मम सखा चैव प्रियोऽस्याहं प्रियश्च मे।\nयुयुधानः सहायो मे प्रमथिष्यति कौरवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2053709, "chapter_id": 2183, "verse_number": "७-११०-६१", "content_sanskrit": "अस्मदर्थं च राजेन्द्र सन्नह्येद्यदि केशवः।\nरामो वाप्यनिरुद्धो वा प्रद्युम्नो वा महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2053710, "chapter_id": 2183, "verse_number": "७-११०-६२", "content_sanskrit": "गदो वा मारणो वापि साम्वो वा सह वृष्णिभिः।\nसहायार्थं महाराज सङ्ग्रामोत्तममूर्धनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2053711, "chapter_id": 2183, "verse_number": "७-११०-६३", "content_sanskrit": "तथाप्यहं नरव्याघ्रं शैनेयं सत्यविक्रमम्।\nसाहाय्ये विनियोक्ष्यामि नास्ति मेऽन्योहि तत्समः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2053712, "chapter_id": 2183, "verse_number": "७-११०-६४", "content_sanskrit": "इति द्वैतवने तात मामुवाच धनञ्जयः।\nपरोक्षे त्वद्गुणांस्तथ्यान्कथयन्नार्यसंसदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2053713, "chapter_id": 2183, "verse_number": "७-११०-६५", "content_sanskrit": "तस्य त्वमेवं सङ्कल्पं न वृथा कर्तुमर्हसि।\nधनञ्जयस्य वार्ष्णेय मम भीमस्य चोभयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2053714, "chapter_id": 2183, "verse_number": "७-११०-६६", "content_sanskrit": "यच्चापि तीर्थानि चरन्नगच्छं द्वारकां प्रति।\nतत्राहमपि ते भक्तिमर्जुनं प्रति दृष्टवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2053715, "chapter_id": 2183, "verse_number": "७-११०-६७", "content_sanskrit": "न तन्सौहृदनन्येपु मया शैनेय लक्षितम्।\nयथा त्वमस्मान्भजसे वर्तमानानुपप्लवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2053716, "chapter_id": 2183, "verse_number": "७-११०-६८", "content_sanskrit": "सोऽभिजात्या च भक्त्या च सख्यस्याचार्यकस्य च।\nसौहृदस्य च वीर्यस्य कुलीनत्वस्य माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2053717, "chapter_id": 2183, "verse_number": "७-११०-६९", "content_sanskrit": "सत्यस्य च महावाहो अनुकम्पार्थमेव च।\nअनुरूपं महेप्वास कर्म त्वं कर्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2053718, "chapter_id": 2183, "verse_number": "७-११०-७०", "content_sanskrit": "सुयोधनो हि सहसा गतो द्रोणेन दंशितः।\nपूर्वमेवानुयातास्ते कौरवाणां महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2053719, "chapter_id": 2183, "verse_number": "७-११०-७१", "content_sanskrit": "सुमहान्निनदश्चैव श्रूयते विजयं प्रति।\nस शैनेय जवेनाशु गन्तुमर्हसि मानद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2053720, "chapter_id": 2183, "verse_number": "७-११०-७२", "content_sanskrit": "भीमसेनो वयं चैव संयत्ताः सहसैनिकाः।\nद्रोणमावारयिष्यामो यदि त्वां प्रतियोत्स्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2053721, "chapter_id": 2183, "verse_number": "७-११०-७३", "content_sanskrit": "पश्य शैनेय सैन्यानि द्रवमाणानि संयुगे।\nमहान्तं चरणे शब्दं दीर्यमाणां च भारतीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2053722, "chapter_id": 2183, "verse_number": "७-११०-७४", "content_sanskrit": "महामारुतवेगेन समुद्रमिव पर्वसु।\nधार्तराष्टबलं तात विक्षिप्तं सव्यसाचिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2053723, "chapter_id": 2183, "verse_number": "७-११०-७५", "content_sanskrit": "रथैर्विपरिधावद्भिर्मनुष्यैश्च हयैश्च ह।\nसैन्यं रजःसमुद्भूतमेतत्सम्परिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2053724, "chapter_id": 2183, "verse_number": "७-११०-७६", "content_sanskrit": "संवृतः सिन्धुसौवीरैर्नखरप्रासयोधिभिः।\nअत्यन्तोपचितैः शूरैः फल्गुनः परवीरहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2053725, "chapter_id": 2183, "verse_number": "७-११०-७७", "content_sanskrit": "नैतद्बलमसंवार्यं शक्यो जेतुं जयद्रथः।\nएते हि सैन्धवस्यार्थे सर्वे सन्त्यक्तजीविताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2053726, "chapter_id": 2183, "verse_number": "७-११०-७८", "content_sanskrit": "शरशक्तिध्वजवरं हयनागसमाकुलम्।\nपश्यैतद्धार्तराष्ट्राणामनीकं सुदुरासदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2053727, "chapter_id": 2183, "verse_number": "७-११०-७९", "content_sanskrit": "शृणु दुन्दुभिनिर्घोषं शङ्खशब्दांश्च पुष्कलान्।\nसिंहनादरवांश्चैव रथनेमिस्वनांस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2053728, "chapter_id": 2183, "verse_number": "७-११०-८०", "content_sanskrit": "नागानां शृणु शब्दं च पत्तीनां च सहस्रशः।\nसादिनां द्रवतां चैव शृणु कम्पयतां महीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2053729, "chapter_id": 2183, "verse_number": "७-११०-८१", "content_sanskrit": "पुरस्तात्सैन्धवानीकं द्रोणानीकं च पृष्ठतः।\nबहुत्वाद्धि नरव्याघ्र देवेन्द्रमपि पीडयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2053730, "chapter_id": 2183, "verse_number": "७-११०-८२", "content_sanskrit": "अपर्यन्ते बले मग्नो जह्यादपि च जीवितम्।\nतस्मिंश्च निहते युद्धे कथं जीवेत मादृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2053731, "chapter_id": 2183, "verse_number": "७-११०-८३", "content_sanskrit": "सर्वथा समनुप्राप्तः सुकृच्छ्रं त्वयि जीवति।\nश्यामो युवा गुडाकेशो दर्शनीयश्च पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2053732, "chapter_id": 2183, "verse_number": "७-११०-८४", "content_sanskrit": "लघ्वस्त्रश्चित्रयोधी च प्रविष्टस्यात भारतीम्।\nसूर्योदये महाबाहुर्दिवसश्चातिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2053733, "chapter_id": 2183, "verse_number": "७-११०-८५", "content_sanskrit": "तन्न जानामि वार्ष्णेय यदि जीवति वा न वा।\nकुरूणां चापि तत्सैन्यं सागरप्रतिमं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2053734, "chapter_id": 2183, "verse_number": "७-११०-८६", "content_sanskrit": "एक एव च बीभत्सुः प्रविष्टस्तात भारतीम्।\nअविपह्यां महाबाहुः सुरैरपि महाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2053735, "chapter_id": 2183, "verse_number": "७-११०-८७", "content_sanskrit": "न हि मे वर्तते बुद्धिरद्य युद्धे कथञ्चन।\nद्रोणोऽपि रभसो युद्धे मम पीडयते बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2053736, "chapter_id": 2183, "verse_number": "७-११०-८८", "content_sanskrit": "प्रत्यक्षं ते महाबाहो यथाऽसौ चरति द्विजः।\nयुगपच्च समेतानां कार्याणां त्वं विचक्षणः।\nमहार्थं लघुसंयुक्तं कर्तुमर्हसि मानद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2053737, "chapter_id": 2183, "verse_number": "७-११०-८९", "content_sanskrit": "तस्य मे सर्वकार्येषु कार्यमेतन्मतं महत्।\nअर्जुनस्य परित्राणां कर्तव्यमिति संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2053738, "chapter_id": 2183, "verse_number": "७-११०-९०", "content_sanskrit": "नाहं शोचामि दाशार्हं गोप्तारं जगतः पतिम्।\nस हि शक्तो रणे तात त्रीँल्लोकानपि सङ्गतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2053739, "chapter_id": 2183, "verse_number": "७-११०-९१", "content_sanskrit": "विजेतुं पुरुषव्याघ्रः सत्यमेतद्ब्रवीमि ते।\nकिम्पुनर्धार्तराष्ट्रस्य बलमेतत्सुदुर्बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2053740, "chapter_id": 2183, "verse_number": "७-११०-९२", "content_sanskrit": "अर्जुनस्त्वेष वार्ष्णेय पीडितो बहुभिर्युधि।\nप्रजह्यात्समरे प्राणांस्तस्माद्विन्दामि कश्मलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2053741, "chapter_id": 2183, "verse_number": "७-११०-९३", "content_sanskrit": "तस्य त्वं पदवीं गच्छ गच्छेयुस्त्वादृशा यथा।\nतादृशस्येदृशे काले मादृशेनाभिनोदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2053742, "chapter_id": 2183, "verse_number": "७-११०-९४", "content_sanskrit": "रणे वृष्णिप्रवीराणां द्वावेवातिरथौ स्मृतौ।\nप्रद्युम्नश्च महाबाहुस्त्वं च सात्वत विश्रुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2053743, "chapter_id": 2183, "verse_number": "७-११०-९५", "content_sanskrit": "अस्त्रे नारायणसमः सङ्कर्षणसमो बले।\nवीरतायां नरव्याघ्र धनञ्जयसमो ह्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2053744, "chapter_id": 2183, "verse_number": "७-११०-९६", "content_sanskrit": "भीष्मद्रोणावतिक्रम्य सर्वयुद्धविशारदम्।\nत्वामेव पुरुषव्याघ्रं लोके सन्तः प्रचक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2053745, "chapter_id": 2183, "verse_number": "७-११०-९७", "content_sanskrit": "`सदेवासुरगन्धर्वान्सकिन्नरमहोरगान्।\nयोधयेच्च जगत्सर्वं विजयेत रिपून्बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2053746, "chapter_id": 2183, "verse_number": "७-११०-९८", "content_sanskrit": "इति ब्रुवन्ति लोकेषु जनास्तव गुणांस्तथा।\nसमागमेषु सर्वेषु पृथगेव च सर्वदा।\nनाशक्यं विद्यते लोके सात्यकेरिति माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2053747, "chapter_id": 2183, "verse_number": "७-११०-९९", "content_sanskrit": "तत्त्वां यदभिवक्ष्यामि तत्कुरुष्व महाबल॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2053748, "chapter_id": 2183, "verse_number": "७-११०-१००", "content_sanskrit": "सम्भावना हि लोकस्य मम पार्थस्य चोभयोः।\nनान्यथा तां महाबाहो सम्प्रकर्तुमिहार्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2053749, "chapter_id": 2183, "verse_number": "७-११०-१०१", "content_sanskrit": "परित्यज्य प्रियान्प्राणान्रणे चर विभीतवत्।\nन हि शैनेय दाशार्हा रणे रक्षन्ति जीवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2053750, "chapter_id": 2183, "verse_number": "७-११०-१०२", "content_sanskrit": "अयुद्धमनवस्थानं सङ्ग्रामे च पलायनम्।\nभीरूणामसतां मार्गे नैष दाशार्हसेवितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2053751, "chapter_id": 2183, "verse_number": "७-११०-१०३", "content_sanskrit": "तवार्जुनो गुरुस्तात धर्मात्मा शिनिपुङ्गच।\nवासुदेवो गुरुश्चापि तव पार्थस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2053752, "chapter_id": 2183, "verse_number": "७-११०-१०४", "content_sanskrit": "कारणद्वयमेतद्धि जानंस्त्वामहमब्रुवम्।\nमावमंस्था वचो मह्यं गुरुस्तव गुरोर्ह्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2053753, "chapter_id": 2183, "verse_number": "७-११०-१०५", "content_sanskrit": "वासुदेवमतं चैव मम चैवार्जुनस्य च।\nसत्यमेतन्मयोक्तं ते याहि यत्र धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2053754, "chapter_id": 2183, "verse_number": "७-११०-१०६", "content_sanskrit": "एतद्वचनमाज्ञाय मम सत्यपराक्रम।\nप्रविशैतद्बलं तात धार्तराष्ट्रस्य दुर्मतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2053755, "chapter_id": 2183, "verse_number": "७-११०-१०७", "content_sanskrit": "प्रविश्य च यथान्यायं सङ्गम्य च महारथैः।\nयथार्हमात्मनः कर्म रणे सात्वत दर्शय॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2053756, "chapter_id": 2183, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्दशदिवसयुद्धे दशाधिकशततमोऽध्यायः॥ ११० ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-११०-२९ तस्मिन्नवसरे॥ ५-११०-४२ कृत्यस्य जयद्रथवधस्यानन्तरापेक्षी अविघ्नाकाङ्क्षी॥ ५-११०-४३ यः स धर्मो मैत्रीलक्षणः। साम्पराये आपत्काले॥ ५-११०-४७ वयस्यस्य स्रिग्धस्य। सहायार्थं सहायरूपप्रयोजनम्॥ ५-११०-६७ उपप्लुवे विमर्दे॥ ५-११०-६८ सख्यादेरनुरूपमित्यनेनान्वयः॥ ५-११०-६९ सत्यस्याङ्गीकारस्य। अनुकम्पार्थमर्जुनानुपालननिमित्तम्॥ ५-११०-७९ श्रूयते हि रणं प्रति इति क.पाठः॥ ५-११०-८८ महार्थं महान्तमर्थम्। लघुसंयुक्तमविलम्बसम्पन्नम्॥ ५-११०-१०१ विभीतवदभीतः॥ ५-११०-१०२ अनबस्थानमस्थैर्यम्॥ ५-११०-११० दशाधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}]