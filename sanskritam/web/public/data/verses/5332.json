[{"id": 2203299, "chapter_id": 5332, "verse_number": "१", "content_sanskrit": "ततः पद्मप्रतीकाशः पद्मोद्भूतः पितामहः ।\nउवाच वचनं देवान् वासवं च शचीपतिम्\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2203300, "chapter_id": 5332, "verse_number": "२", "content_sanskrit": "अयं महाबलो नागो रसातळचरो बली ।\nतेजस्वी रेणुको नाम महासत्वपराक्रमः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2203301, "chapter_id": 5332, "verse_number": "३", "content_sanskrit": "अतितेजस्विनः सर्वे महावीर्या महागजाः ।\nधारयन्ति महीं कृत्स्नां सशैलवनकाननाम्\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2203302, "chapter_id": 5332, "verse_number": "४", "content_sanskrit": "भवद्भिः समनुज्ञातो रेणुकस्तान् महागजान् ।\nधर्मगुह्यानि सर्वाणि गत्वा पृच्छतु तत्र वै॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2203303, "chapter_id": 5332, "verse_number": "५", "content_sanskrit": "पितामहवचः श्रुत्वा ते देवा रेणुकं तदा ।\nप्रेषयामासुरव्यग्रा यत्र ते धरणीधराः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2203304, "chapter_id": 5332, "verse_number": "", "content_sanskrit": "रेणुकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2203305, "chapter_id": 5332, "verse_number": "६", "content_sanskrit": "अनुज्ञातोऽस्मि देवैश्च पितृभिश्च महाबलाः ।\nधर्मगुह्यानि युष्माकं श्रोतुमिच्छामि तत्त्वतः ।\nकथयध्वं महाभागा यद्वस्तत्त्वं मनीषितम्\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2203306, "chapter_id": 5332, "verse_number": "", "content_sanskrit": "दिग्गजाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2203307, "chapter_id": 5332, "verse_number": "७", "content_sanskrit": "कार्त्तिके मासि चाश्लेषा बहुलस्याष्टमी शिवा ।\nतेन नक्षत्रयोगेन यो ददाति गुडौदनम् ।\nइमं मन्त्रं जपन् श्राद्धे यताहारो ह्यकोपनः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2203308, "chapter_id": 5332, "verse_number": "८", "content_sanskrit": "बलदेवप्रभृतयो ये नागा बलवत्तराः ।\nअनन्ता ह्यक्षया नित्यं भोगिनः सुमहाबलाः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2203309, "chapter_id": 5332, "verse_number": "९", "content_sanskrit": "तेषां कुलोद्भवा ये च महाभूता भुजङ्गमाः ।\nते मे बलिं प्रयच्छन्तु बलतेजोभिवृद्धये\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2203310, "chapter_id": 5332, "verse_number": "१०", "content_sanskrit": "यदा नारायणः श्रीमानुज्जहार वसुन्धराम् ।\nतद्बलं तस्य देवस्य धरामुद्धरतस्तथा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2203311, "chapter_id": 5332, "verse_number": "११", "content_sanskrit": "एवमुक्त्वा बलिं तत्र वल्मीके तु निवेदयेत्\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2203312, "chapter_id": 5332, "verse_number": "१२", "content_sanskrit": "गजेन्द्रकुसुमाकीर्णं नीलवस्त्रानुलेपनम् ।\nनिर्वपेत् तं तु वल्मीके अस्तं याते दिवाकरे\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2203313, "chapter_id": 5332, "verse_number": "१३", "content_sanskrit": "एवं तुष्टास्ततः सर्वे अधस्ताद् भारपीडिताः ।\nश्रमं तं नावबुध्यामो धारयन्तो वसुन्धराम्\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2203314, "chapter_id": 5332, "verse_number": "१४", "content_sanskrit": "एवं मन्यामहे धर्मं भारार्ता निरपेक्षिणः ।\nब्राह्मणः क्षत्रियो वैश्यः शूद्रो वा यद्युपोषितः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2203315, "chapter_id": 5332, "verse_number": "१५", "content_sanskrit": "एवं संवत्सरं कृत्वा दानं बहुफलं लभेत् ।\nवल्मीके बलिमादाय तन्नो बहुफलं मतम्\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2203316, "chapter_id": 5332, "verse_number": "१६", "content_sanskrit": "ये च नागा महावीर्यास्त्रिषु लोकेषु कृत्स्नशः ।\nकृतातिथ्या भवेयुस्ते शतं वर्षाणि तत्त्वतः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2203317, "chapter_id": 5332, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे दिग्गजानामुपदेशो नाम त्र्यशीत्युत्तरशततमोऽध्यायः ॥१८३॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]