[{"id": 7001182000, "chapter_id": 21182, "verse_number": "२-३-३०-१", "content_sanskrit": "॥ नारद उवाच  ।\nविधे तात महाभाग धन्यस्त्वं परमार्थदृक् ।\nअद्भुतेयं कथाश्रावि त्वदनुग्रहतो मया॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001182001, "chapter_id": 21182, "verse_number": "२-३-३०-२", "content_sanskrit": "गते हरे स्वशैले हि पार्वती सर्वमंगला ।\nकिं चकार गता कुत्र तन्मे वद महामते॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001182002, "chapter_id": 21182, "verse_number": "२-३-३०-३", "content_sanskrit": "॥ ब्रह्मोवाच  ।\nशृणु सुप्रीतितस्तात यज्जातं तदनन्तरम् ।\nहरे गते निजस्थाने तद्वदामि शिवं स्मरन्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001182003, "chapter_id": 21182, "verse_number": "२-३-३०-४", "content_sanskrit": "पार्वत्यपि सखीयुक्ता रूपं कृत्वा तु सार्थकम् ।\nजगाम स्वपितुर्गेहं महादेवेति वादिनी॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001182004, "chapter_id": 21182, "verse_number": "२-३-३०-५", "content_sanskrit": "पार्वत्यागमनं श्रुत्वा मेना च स हिमाचलः ।\nदिव्यं यानं समारुह्य प्रययौ हर्षविह्वलः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001182005, "chapter_id": 21182, "verse_number": "२-३-३०-६", "content_sanskrit": "पुरोहितश्च पौराश्च सख्यश्चैवाप्यनेकशः ।\nसम्वन्धिनस्तथान्ये च सर्वे ते च समाययुः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001182006, "chapter_id": 21182, "verse_number": "२-३-३०-७", "content_sanskrit": "भ्रातरः सकला जग्मुर्मैनाकप्रमुखास्तदा ।\nजयशब्दं प्रब्रुवन्तो महाहर्षसमन्विताः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001182007, "chapter_id": 21182, "verse_number": "२-३-३०-८", "content_sanskrit": "संस्थाप्य मंगलघटं राजवर्त्मनि राजिते ।\nचन्दनागरुकस्तूरीफलशाखासमन्विते॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001182008, "chapter_id": 21182, "verse_number": "२-३-३०-९", "content_sanskrit": "सपुरोधोब्राह्मणैश्च मुनिभिर्ब्रह्मवादिभिः ।\nनारीभिर्नर्तकीभिश्च गजेन्द्राद्रिसुशोभितैः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001182009, "chapter_id": 21182, "verse_number": "२-३-३०-१०", "content_sanskrit": "परितः परितो रंभास्तम्भवृन्दसमन्विते ।\nपतिपुत्रवतीयोषित्समूहैर्दीपहस्तकैः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001182010, "chapter_id": 21182, "verse_number": "२-३-३०-११", "content_sanskrit": "द्विजवृन्दैश्च संयुक्ते कुर्वद्भिर्मङ्गलध्वनिम् ।\nनानाप्रकारवाद्यैश्च शंखध्वनिभिरन्विते॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001182011, "chapter_id": 21182, "verse_number": "२-३-३०-१२", "content_sanskrit": "एतस्मिन्नन्तरे दुर्गा जगाम स्वपुरान्तिकम् ।\nविशंती नगरं देवी ददर्श पितरौ पुनः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001182012, "chapter_id": 21182, "verse_number": "२-३-३०-१३", "content_sanskrit": "सुप्रसन्नौ प्रधावन्तौ हर्षविह्वलमानसौ ।\nदृष्ट्वा काली सुप्रहृष्टा स्वालिभिः प्रणनाम तौ॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001182013, "chapter_id": 21182, "verse_number": "२-३-३०-१४", "content_sanskrit": "तौ सम्पूर्णाशिषं दत्त्वा चक्रतुस्तौ स्ववक्षसि ।\nहे वत्से त्वेवमुच्चार्य रुदन्तौ प्रेमविह्वलौ॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001182014, "chapter_id": 21182, "verse_number": "२-३-३०-१५", "content_sanskrit": "ततस्स्वकीया अप्यस्या अन्या नार्यापि संमुदा ।\nभ्रातृस्त्रियोपि सुप्रीत्या दृढालिंगनमादधुः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001182015, "chapter_id": 21182, "verse_number": "२-३-३०-१६", "content_sanskrit": "साधितं हि त्वया सम्यक्सुकार्यं कुलतारणम् ।\nत्वत्सदाचरणेनापि पाविताः स्माखिला वयम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001182016, "chapter_id": 21182, "verse_number": "२-३-३०-१७", "content_sanskrit": "इति सर्वे सुप्रशंस्य प्रणेमुस्तां प्रहर्षिताः ।\nचन्दनैः सुप्रसूनैश्च समानर्चुश्शिवां मुदा॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001182017, "chapter_id": 21182, "verse_number": "२-३-३०-१८", "content_sanskrit": "तस्मिन्नवसरे देवा विमानस्था मुदाम्बरे ।\nपुष्पवृष्टिं शुभां चक्रुर्नत्वा तां तुष्टुवुः स्तवैः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001182018, "chapter_id": 21182, "verse_number": "२-३-३०-१९", "content_sanskrit": "तदा तां च रथे स्थाप्य सर्वे शोभान्विते वरे ।\nपुरं प्रवेशयामासुस्सर्वे विप्रादयो मुदा॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001182019, "chapter_id": 21182, "verse_number": "२-३-३०-२०", "content_sanskrit": "अथ विप्राः पुरोधाश्च सख्योन्याश्च स्त्रियः शिवाम् ।\nगृहं प्रवेशयामासुर्बहुमानपुरस्सरम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001182020, "chapter_id": 21182, "verse_number": "२-३-३०-२१", "content_sanskrit": "स्त्रियो निर्मच्छनं चक्रुर्विप्रा युयुजुराशिषः ।\nहिमवान्मेनका माता मुमोदाति मुनीश्वर॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001182021, "chapter_id": 21182, "verse_number": "२-३-३०-२२", "content_sanskrit": "स्वाश्रमं सफलं मेने कुपुत्रात्पुत्रिका वरा ।\nहिमवान्नारदं त्वाञ्च संस्तुवन् साधुसाध्विति॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001182022, "chapter_id": 21182, "verse_number": "२-३-३०-२३", "content_sanskrit": "ब्राह्मणेभ्यश्च बंदिभ्यः पर्वतेन्द्रो धनं ददौ ।\nमङ्गलं पाठयामास स द्विजेभ्यो महोत्सवम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001182023, "chapter_id": 21182, "verse_number": "२-३-३०-२४", "content_sanskrit": "एवं स्वकन्यया हृष्टौ पितरौ भ्रातरस्तथा ।\nजामयश्च महाप्रीत्या समूषुः प्रांगणे मुने॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001182024, "chapter_id": 21182, "verse_number": "२-३-३०-२५", "content_sanskrit": "ततस्स हिमवान् तात सुप्रहृष्टाः प्रसन्नधीः ।\nसम्मान्य सकलान्प्रीत्या स्नातुं गंगां जगाम ह॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001182025, "chapter_id": 21182, "verse_number": "२-३-३०-२६", "content_sanskrit": "एतस्मिन्नंतरे शंभुस्सुलीलो भक्तवत्सलः ।\nसुनर्तकनटो भूत्वा मेनकासंनिधिं ययौ॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001182026, "chapter_id": 21182, "verse_number": "२-३-३०-२७", "content_sanskrit": "शृंगं वामे करे धृत्वा दक्षिणे डमरु तथा ।\nपृष्ठे कंथां रक्तवासा नृत्यगानविशारदः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001182027, "chapter_id": 21182, "verse_number": "२-३-३०-२८", "content_sanskrit": "ततस्सुनटरूपोसौ मेनकाया गणे मुदा ।\nचक्रे सुनृत्यं विविधं गानं चातिमनोहरम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001182028, "chapter_id": 21182, "verse_number": "२-३-३०-२९", "content_sanskrit": "शृंगं च डमरुं तत्र वादयामास सुध्वनिम् ।\nमहतीं विविधां तत्र स चकार मनोहराम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001182029, "chapter_id": 21182, "verse_number": "२-३-३०-३०", "content_sanskrit": "तां द्रष्टुं नागरास्सर्वे पुरुषाश्च स्त्रियस्तथा ।\nआजग्मुस्सहसा तत्र बाला वृद्धा अपि ध्रुवम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001182030, "chapter_id": 21182, "verse_number": "२-३-३०-३१", "content_sanskrit": "श्रुत्वा सुगीतं तद्दृष्ट्वा सुनृत्यं च मनोहरम् ।\nसहसा मुमुहुस्सर्वे मेनापि च तदा मुने॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001182031, "chapter_id": 21182, "verse_number": "२-३-३०-३२", "content_sanskrit": "मूर्च्छां संप्राप्य सा दुर्गा सुदृष्ट्वा हृदि शंकरम् ।\nत्रिशूलादिकचिह्नानि बिभ्रतं चातिसुन्दरम्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001182032, "chapter_id": 21182, "verse_number": "२-३-३०-३३", "content_sanskrit": "विभूतिविभूषितं रम्यमस्थिमालासमन्वितम् ।\nत्रिलोचनोज्ज्वलद्वक्त्रं नागायज्ञोपवीतकम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001182033, "chapter_id": 21182, "verse_number": "२-३-३०-३४", "content_sanskrit": "वरं वृण्वित्युक्तवन्तं गौरवर्णं महेश्वरम् ।\nदीनबन्धु दयासिन्धुं सर्वथा सुमनोहरम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001182034, "chapter_id": 21182, "verse_number": "२-३-३०-३५", "content_sanskrit": "हृदयस्थं हरं दृष्ट्वेदृशं सा प्रणनाम तम् ।\nवरं वव्रे मानसं हि पतिर्मे त्वं भवेति च॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001182035, "chapter_id": 21182, "verse_number": "२-३-३०-३६", "content_sanskrit": "वरं दत्त्वा शिवं चाथ तादृशं प्रीतितो हृदा ।\nअन्तर्धाय पुनस्तत्र सुननर्त्त स भिक्षुकः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001182036, "chapter_id": 21182, "verse_number": "२-३-३०-३७", "content_sanskrit": "ततो मेना सुरत्नानि स्वर्णपात्रस्थितानि च ।\nतस्मै दातुं ययौ प्रीत्या तद्भूति प्रीतमानसः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001182037, "chapter_id": 21182, "verse_number": "२-३-३०-३८", "content_sanskrit": "तानि न स्वीचकारासौ भिक्षां याचे शिवां च ताम् ।\nपुनस्सुनृत्यं गानश्च कौतुकात्कर्तुमुद्यतः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001182038, "chapter_id": 21182, "verse_number": "२-३-३०-३९", "content_sanskrit": "मेना तद्वचनं श्रुत्वा चुकोपाति सुविस्मिता ।\nभिक्षुकं भर्त्सयामास बहिष्कर्तुमियेष सा॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001182039, "chapter_id": 21182, "verse_number": "२-३-३०-४०", "content_sanskrit": "एतस्मिन्नन्तरे तत्र गंगातो गिरिराययौ ।\nददर्श पुरतो भिक्षुं प्रांगणस्थं नराकृतिम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001182040, "chapter_id": 21182, "verse_number": "२-३-३०-४१", "content_sanskrit": "श्रुत्वा मेनामुखाद्वृत्तं तत्सर्वं सुचुकोप सः ।\nआज्ञां चकारानुचरान्बहिष्कर्तुञ्च तं नटम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001182041, "chapter_id": 21182, "verse_number": "२-३-३०-४२", "content_sanskrit": "महाग्निमिव दुःस्पर्शं प्रज्वलन्तं सुतेजसम् ।\nन शशाक बहिष्कर्तुं कोपि तं मुनिसत्तम॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001182042, "chapter_id": 21182, "verse_number": "२-३-३०-४३", "content_sanskrit": "ततस्स भिक्षुकस्तात नानालीलाविशारदः ।\nदर्शयामास शैलाय स्वप्रभावमनन्तकम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001182043, "chapter_id": 21182, "verse_number": "२-३-३०-४४", "content_sanskrit": "शैलो ददर्श तं तत्र विष्णुरूपधरं द्रुतम् ।\nकिरीटिनं कुण्डलिनं पीतवस्त्रं चतुर्भुजम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001182044, "chapter_id": 21182, "verse_number": "२-३-३०-४५", "content_sanskrit": "यद्यत्पुष्पादिकं दत्तं पूजाकाले गदाभृते ।\nगात्रे शिरसि तत्सर्वं भिक्षुकस्य ददर्श ह॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001182045, "chapter_id": 21182, "verse_number": "२-३-३०-४६", "content_sanskrit": "ततो ददर्श जगतां स्रष्टारं स चतुर्मुखम् ।\nरक्तवर्णं पठन्तञ्च श्रुतिसूक्तं गिरीश्वरः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001182046, "chapter_id": 21182, "verse_number": "२-३-३०-४७", "content_sanskrit": "ततस्सूर्य्यस्वरूपञ्च जगच्चक्षुस्स्वरूपकम् ।\nददर्श गिरिराजस्स क्षणं कौतुककारिणाम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001182047, "chapter_id": 21182, "verse_number": "२-३-३०-४८", "content_sanskrit": "ततो ददर्श तं तात रुद्ररूपं महाद्भुतम् ।\nपार्वती सहितं रम्यं विहसन्तं सुतेजसम्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001182048, "chapter_id": 21182, "verse_number": "२-३-३०-४९", "content_sanskrit": "ततस्तेजस्स्वरूपञ्च निराकारं निरंजनम् ।\nनिरुपाधिं निरीहञ्च महाद्भुतमरूपकम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001182049, "chapter_id": 21182, "verse_number": "२-३-३०-५०", "content_sanskrit": "एवं बहूनि रूपाणि तस्य तत्र ददर्श सः ।\nसुविस्मितो बभूवाशु परमानन्दसंयुतः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001182050, "chapter_id": 21182, "verse_number": "२-३-३०-५१", "content_sanskrit": "अथासौ भिक्षुवर्य्यो हि तस्मात्तस्याश्च सूतिकृत् ।\nभिक्षां ययाचे दुर्गान्तां नान्यज्जग्राह किञ्चन॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001182051, "chapter_id": 21182, "verse_number": "२-३-३०-५२", "content_sanskrit": "न स्वीचकार शैलैन्द्रो मोहितश्शिवमायया ।\nभिक्षुः किंचिन्न जग्राह तत्रैवान्तर्दधे ततः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001182052, "chapter_id": 21182, "verse_number": "२-३-३०-५३", "content_sanskrit": "तदा बभूव सुज्ञानं मेनाशैलेशयोरिति ।\nआवां शिवो वञ्चयित्वा स्वस्थानं गतवान्प्रभुः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001182053, "chapter_id": 21182, "verse_number": "२-३-३०-५४", "content_sanskrit": "तयोर्विचिन्त्य तत्रैव शिवे भक्तिरभूत्परा ।\nमहामोक्षकरी दिव्या सर्वानन्दप्रदायिनी॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]