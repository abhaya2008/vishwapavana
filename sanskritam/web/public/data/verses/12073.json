[{"id": 50026128, "chapter_id": 12073, "verse_number": "1", "content_sanskrit": "ब्रह्माण्या अपि भारत्या गौरीर्यस्त इति श्रुतौ। मन्त्रौ दीर्घतमोदृष्टौ सर्वाभीष्टप्रदायकौ॥ ६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50026129, "chapter_id": 12073, "verse_number": "2", "content_sanskrit": "उद्यद्दिवाकरसमूहनिभां स्वभर्तुरङ्कस्थितामभयसद्वरबाहुयुग्माम्। मुद्रां च तत्त्वदृशये वरपुस्तकं च दोर्युग्मकेन दधतीं स्मरतात्मविद्याम्॥ ६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50026130, "chapter_id": 12073, "verse_number": "3", "content_sanskrit": "पादैर्व्यस्तैः समस्तैश्च तदङ्गानि विदो विदुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}]