[{"id": 2105891, "chapter_id": 3291, "verse_number": "१६-२०-१", "content_sanskrit": "वैशम्पायन उवाच।\nततो भागीरथीतीरे मेध्ये पुण्यजनोचिते।\nनिवासमकरोद्राजा विदुरस्य मते स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2105892, "chapter_id": 3291, "verse_number": "१६-२०-२", "content_sanskrit": "तत्रैनं पर्युपातिष्ठन्ब्राह्मणा वनवासिनः।\nक्षत्रविट्शूद्रसङ्खाश्च बहवो भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2105893, "chapter_id": 3291, "verse_number": "१६-२०-३", "content_sanskrit": "स तैः परिवृतो राजा कथाभिः परिनन्द्य तान्।\nअनुजज्ञे स शिष्यान्वै विधिवत्प्रतिपूज्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2105894, "chapter_id": 3291, "verse_number": "१६-२०-४", "content_sanskrit": "सायाह्ने स महीपालस्ततो गङ्गामुपेत्य च।\nचकार विधिवच्छौचं गान्धारी च यशस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2105895, "chapter_id": 3291, "verse_number": "१६-२०-५", "content_sanskrit": "ते चैवान्ये पृथक् सर्वे तीर्थेष्वाप्लुत्य भारत।\nचक्रुः सर्वाः क्रियास्तत्र पुरुषा विदुरादयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2105896, "chapter_id": 3291, "verse_number": "१६-२०-६", "content_sanskrit": "कृतशौचं ततो वृद्धं श्वशुरं कुन्तिभोजजा।\nगान्धारीं च पृथा राजन्गङ्गातीर्थमुपानयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2105897, "chapter_id": 3291, "verse_number": "१६-२०-७", "content_sanskrit": "राज्ञस्तु याजकैस्तत्र कृतो वेदीपरिस्तरः।\nजुहाव तत्र वह्निं स नृपतिः सत्यसङ्गरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2105898, "chapter_id": 3291, "verse_number": "१६-२०-८", "content_sanskrit": "ततो भागीरथीतीरात्कुरुक्षेत्रं जगाम सः।\nसानुगो नृपतिर्वृद्धो नियतः संयतेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2105899, "chapter_id": 3291, "verse_number": "१६-२०-९", "content_sanskrit": "तत्राश्रमपदं धीमानभिगम्य स पार्थिवः।\nआससादाथ राजर्षिं शतयूपं मनीषिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2105900, "chapter_id": 3291, "verse_number": "१६-२०-१०", "content_sanskrit": "स हि राजा महानासीत्केकयेषु परंपतः।\nस्वपुत्रं मनुजैश्वर्ये निवेश्य वनमाविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2105901, "chapter_id": 3291, "verse_number": "१६-२०-११", "content_sanskrit": "तेनासौ सहितो राजा ययौ व्यासाश्रमं प्रति।\nतत्रैनं विधिवद्राजन्प्रत्यगृह्णात्कुरूद्वहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2105902, "chapter_id": 3291, "verse_number": "१६-२०-१२", "content_sanskrit": "स दीक्षां तत्र संप्राप्य राजा कौरवनन्दनः।\nशतयूपाश्रमे तस्मिन्निवासमकरोत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2105903, "chapter_id": 3291, "verse_number": "१६-२०-१३", "content_sanskrit": "तस्मै सर्वं विधिं राज्ञे राजाऽऽचख्यौ महामतिः।\nआरण्यकं महाराज व्यासस्यानुमते तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2105904, "chapter_id": 3291, "verse_number": "१६-२०-१४", "content_sanskrit": "एवं च तपसा राजन्धृतराष्ट्रो महामनाः।\nयोजयामास चात्मानं तांश्चाप्यनुचरांस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2105905, "chapter_id": 3291, "verse_number": "१६-२०-१५", "content_sanskrit": "तथैव देवी गान्धारी वल्कलाजिनधारिणी।\nकुन्त्या सह महाराजि समानव्रतचारिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2105906, "chapter_id": 3291, "verse_number": "१६-२०-१६", "content_sanskrit": "कर्मणा मनसा वाचा चक्षुषा चैव ते नृप।\nसन्नियम्येन्द्रियग्राममास्थिताः परमं तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2105907, "chapter_id": 3291, "verse_number": "१६-२०-१७", "content_sanskrit": "त्वगस्थिभूतः परिशुष्कमांसो\nजटाजिनी वल्कलसंवृताङ्गः।\nस पार्तिवस्तत्र तपश्चचार\nमहर्षिवत्तीव्रमपेतमोहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2105908, "chapter_id": 3291, "verse_number": "१६-२०-१८", "content_sanskrit": "क्षत्ता च धर्मार्थविदग्र्यबुद्धिः\nससंजयस्तं नृपतिं सदारम्।\nउपाचरद्धोरतपोर्जितात्मा\nतदा कृशो वल्कलचीरवासाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2105909, "chapter_id": 3291, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्रमवासिकपर्वणि आश्रमवासपर्वणि विंशोऽध्यायः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]