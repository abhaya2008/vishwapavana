[{"id": 2178833, "chapter_id": 4783, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2178834, "chapter_id": 4783, "verse_number": "१", "content_sanskrit": "ते समासाद्य गङ्गां तु शिवां पुण्यजलान्विताम् ।\nह्रादिनीं वप्रसम्पन्नां महानूपां महावनाम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2178835, "chapter_id": 4783, "verse_number": "२", "content_sanskrit": "भूषणान्युत्तरीयाणि वेष्टनान्यवमुच्य च ।\nकवचानि विचित्राणि गङ्गामवजगाहिरे\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2178836, "chapter_id": 4783, "verse_number": "३", "content_sanskrit": "ततः पितॄणां पुत्राणां गुरूणां स्वजनस्य च ।\nभ्रातॄणामार्यकाणां च पतीनां च कुरुस्त्रियः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2178837, "chapter_id": 4783, "verse_number": "४", "content_sanskrit": "उदकं चक्रिरे सर्वा रुदन्त्यो भृशदुःखिताः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2178838, "chapter_id": 4783, "verse_number": "५", "content_sanskrit": "सुहृदां चापि धर्मज्ञाः प्रचक्रुः सलिलक्रियाः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2178839, "chapter_id": 4783, "verse_number": "६", "content_sanskrit": "उदके क्रियमाणे तु वीराणां वीरपत्निभिः ।\nसूपतीर्थाऽभवद् गङ्गा भूयो विप्रससार च\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2178840, "chapter_id": 4783, "verse_number": "७", "content_sanskrit": "तन्महोदधिसङ्काशं निरानन्दनिरुत्सवम् ।\nवीरपत्नीभिराकीर्णं गङ्गातीरमशोभत\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2178841, "chapter_id": 4783, "verse_number": "८", "content_sanskrit": "ततः कुन्ती महाराज रुदन्ती शोककर्शिता ।\nव्रीडया मन्दया वाचा पुत्रान् वचनमब्रवीत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2178842, "chapter_id": 4783, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2178843, "chapter_id": 4783, "verse_number": "९", "content_sanskrit": "यः स शूरो महेष्वासो रथयूथपयूथपः ।\nअर्जुनेन हतः सङ्खे वीरलक्षणलक्षितः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2178844, "chapter_id": 4783, "verse_number": "१०", "content_sanskrit": "यं सूतपुत्रं मन्यध्वं राधेय इति पाण्डवाः ।\nयो व्यराजच्चमूमध्ये दिवाकर इव प्रभुः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2178845, "chapter_id": 4783, "verse_number": "११", "content_sanskrit": "अत्यरिच्यत यः सर्वान् पुरा वः सपदानुगान् ।\nदुर्योधनबलं सर्वं यः प्रकर्षन् व्यरोचत\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2178846, "chapter_id": 4783, "verse_number": "१२", "content_sanskrit": "यस्य नास्ति समो लोके पृथिव्यामपि कश्चन ।\nयोऽवृणीत यशः शूरः प्राणैरपि सदा भुवि\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2178847, "chapter_id": 4783, "verse_number": "१३", "content_sanskrit": "सत्यसन्धस्य शूरस्य सङ्ग्रामेष्वपलायिनः ।\nकुरुध्वमुदकं तस्य भ्रातुरक्लिष्टकर्मणः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2178848, "chapter_id": 4783, "verse_number": "१४", "content_sanskrit": "स हि ते पूर्वजो भ्राता भास्करान्मय्यजायत ।\nकुण्डली कवची शूरो दिवाकरसमप्रभः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2178849, "chapter_id": 4783, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2178850, "chapter_id": 4783, "verse_number": "१५", "content_sanskrit": "श्रुत्वा तु पाण्डवाः सर्वे मातुर्वचनमप्रियम् ।\nकर्णमेवाभ्यरोचन्त भूयश्चात्यातुरा भवन्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2178851, "chapter_id": 4783, "verse_number": "१६", "content_sanskrit": "ततः स पुरुषव्याघ्रः कुन्तीपुत्रो युधिष्ठिरः ।\nउवाच मातरं वीरो निःश्वसन्निव पन्नगः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2178852, "chapter_id": 4783, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2178853, "chapter_id": 4783, "verse_number": "१७", "content_sanskrit": "यः शरोर्मिध्वजावर्तो महाभुजमहाग्रहः ।\nतळशब्दप्रणुदितो महारथमहाद्रुमः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2178854, "chapter_id": 4783, "verse_number": "१८", "content_sanskrit": "यस्येषुपातमासाद्य कोऽन्यस्तिष्ठेद्धनञ्जयात्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2178855, "chapter_id": 4783, "verse_number": "१९", "content_sanskrit": "कथं पुत्रो भवत्याऽऽशु देवगर्भः पुराऽभवत् ।\nकुण्डली कवची शूरो दिवाकरसमप्रभः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2178856, "chapter_id": 4783, "verse_number": "२०", "content_sanskrit": "यस्य बाहुप्रतापेन तापिताः सर्वतो वयम् ।\nतमग्निरिव वस्त्रेण कथं छादितवत्यसि\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2178857, "chapter_id": 4783, "verse_number": "२१", "content_sanskrit": "यस्य बाहुप्रभावेन वैरमस्मास्वरोचयत् ।\nसुयोधनस्तु तं ज्येष्ठं कथं नोदितवत्यसि\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2178858, "chapter_id": 4783, "verse_number": "२२", "content_sanskrit": "तथा कर्णं महेश्वासं धार्तराष्ट्रैरुपासितम् ।\nआर्योपायैर्यथाऽस्माभिर्बलं गाण्डीवधन्वनः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2178859, "chapter_id": 4783, "verse_number": "२३", "content_sanskrit": "भूमिपानां च सर्वेषां लोके बलवतां वरम् ।\nनान्यः कुन्तीसुताज्जिष्णोर्निहन्याद् रथिनो रथी\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2178860, "chapter_id": 4783, "verse_number": "२४", "content_sanskrit": "स नः प्रथमजो भ्राता सर्वशस्त्रभृतां वरः ।\nअसूत तं भवत्यग्रे कथमद्भुतविक्रमम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2178861, "chapter_id": 4783, "verse_number": "२५", "content_sanskrit": "अहो भवत्या मन्त्रेण गृहीतेन वयं हताः ।\nनिधनेन हि कर्णस्य पीडिताः सहबान्धवाः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2178862, "chapter_id": 4783, "verse_number": "२६", "content_sanskrit": "अभिमन्योर्विनाशाद्धि द्रौपदेयवधादपि ।\nपाञ्चालानां वधाच्चापि कुरूणां घातनादपि\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2178863, "chapter_id": 4783, "verse_number": "२७", "content_sanskrit": "ततः शतगुणं दुःखमिदमापतितं महत्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2178864, "chapter_id": 4783, "verse_number": "२८", "content_sanskrit": "कर्णमेवानुशोचामि दग्धामग्नाविवाहुतिम् ।\nन च मे किञ्चिदप्राप्यं भवेदपि दिवि स्थितम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2178865, "chapter_id": 4783, "verse_number": "२९", "content_sanskrit": "न च स्म वैशसं घोरं कौरवाणां कृतं भवेत्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2178866, "chapter_id": 4783, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2178867, "chapter_id": 4783, "verse_number": "३०", "content_sanskrit": "एवं विलप्य करुणं धर्मराजो युधिष्ठिरः ।\nवदन् स शनकै राजन् चकारास्योदकं प्रभुः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2178868, "chapter_id": 4783, "verse_number": "३१", "content_sanskrit": "ततो विनेदुः सहसा स्त्रियः पुम्भिश्च सर्वशः ।\nअभितो याः स्थितास्तत्र तस्मिन्नुदककर्मणि\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2178869, "chapter_id": 4783, "verse_number": "३२", "content_sanskrit": "ततः समानयामास कर्णस्य च परिच्छदम् ।\nस्त्रियः कुरुपतिः श्रीमान् प्रेम्णा भ्रातुर्युधिष्ठिरः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2178870, "chapter_id": 4783, "verse_number": "३३", "content_sanskrit": "स ताभिः सह धर्मात्मा प्रेतकार्यमनन्तरम् ।\nकृत्वोत्ततार गङ्गायाः सलिला कुशलेन्द्रियः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2178871, "chapter_id": 4783, "verse_number": "३४", "content_sanskrit": "सर्वं चकार कर्णस्य विधिवद् भूरिदक्षिणम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2178872, "chapter_id": 4783, "verse_number": "३५", "content_sanskrit": "स राजा धृतराष्ट्रश्च कृताञ्जलिरतन्द्रितः ।\nसमुत्ततार गङ्गायां भार्यया सह भारत\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2178873, "chapter_id": 4783, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां स्त्रीपर्वणि\nसप्तविंशोऽध्यायः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2178874, "chapter_id": 4783, "verse_number": "२", "content_sanskrit": "श्राद्धपर्वणि द्वितीयोऽध्यायः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2178875, "chapter_id": 4783, "verse_number": "", "content_sanskrit": "॥ समाप्तं श्राद्धपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2178876, "chapter_id": 4783, "verse_number": "", "content_sanskrit": "॥ समाप्तं स्त्रीपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2178877, "chapter_id": 4783, "verse_number": "", "content_sanskrit": "स्त्रीपर्वणि अमीवृत्तान्ताः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2178878, "chapter_id": 4783, "verse_number": "", "content_sanskrit": "धृतराष्ट्रविशोककरणम् । सञ्जयवाक्यम् । संसारगहनवर्णनम् । व्यासवाक्यम् ।\nधृतराष्ट्रस्य स्त्रीभिः सह निर्याणम् । कृपद्रोणीभोजदर्शनम् । पाण्डवानां धृतराष्ट्रगमनम् । अयोमयभीमभङ्गः । गान्धारीप्रभृतीनां आयोधनगमनम् । स्त्रीणां विलापः । गान्धारीकोपः । वासुदेववाक्यम् । राज्ञां शरीरसंस्कारः । जलप्रदानिकम् । गङ्गाभिगमनम् । कर्णोपाख्यानमिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2178879, "chapter_id": 4783, "verse_number": "", "content_sanskrit": "एतदेकादशम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2178880, "chapter_id": 4783, "verse_number": "", "content_sanskrit": "एतत् त्रयोदशं प्रोक्तं पर्वातिकरुणं महत् ।\nसप्तविंशतिरध्यायः पर्वण्यस्मिन्नुदाहृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2178881, "chapter_id": 4783, "verse_number": "", "content_sanskrit": "श्लोकाश्चाष्टशतं चापि सहाविंशतिरुच्यते ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2178882, "chapter_id": 4783, "verse_number": "", "content_sanskrit": "प्रणीतसञ्ज्ञानमनोवैकल्याश्रुप्रवर्तनम् ।\nस्त्रीपर्वणि तथा रसैस्तर्पयत् द्विजोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2178883, "chapter_id": 4783, "verse_number": "", "content_sanskrit": "श्रुत्वेदं भारतं पुण्यं पवित्रं पापनाशनम् ।\nप्रदातव्यं द्विजातिभ्यो यदिच्छेदहितात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2178884, "chapter_id": 4783, "verse_number": "", "content_sanskrit": "शिवस्य भवने राजन् नात्र कार्या विचारणा ।\nश्रद्धदानेन वैभव्यं मानवा यद्यदिच्छति ।\nहस्त्यश्वरथयानानि वाहनानि विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2178885, "chapter_id": 4783, "verse_number": "", "content_sanskrit": "कटकं कुण्डले चैव वस्त्रशुभ्रं तथापरम् ।\nवस्त्रं चैव विचित्रं च गन्धं चैव विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2178886, "chapter_id": 4783, "verse_number": "", "content_sanskrit": "देवतापूजयेद्विप्रं (एवं वः पूजयेद्विप्रं) विष्णुलोकमवाप्नुयात् ।\nविमानं सुकृतं तोषं सुखेनैवोपपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2178887, "chapter_id": 4783, "verse_number": "", "content_sanskrit": "मकुटेनाग्निवर्णेन जाम्बूनदविशेषणैः ।\nदिव्यं चन्दनदिग्धां च दिव्यकाञ्चनभूषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2178888, "chapter_id": 4783, "verse_number": "", "content_sanskrit": "दिव्यान् लोकान् विचरते दिव्यैर्भोगैः समन्वितः ।\nविबुधानां प्रसादेन श्रिया परमया युतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2178889, "chapter_id": 4783, "verse_number": "", "content_sanskrit": "अथवर्षगणेनैवं स्वर्गलोके महीयते ।\nतत्र गन्धर्वसहितः सहस्रोप्येकविंशतिः ।\nपुरन्दरपुरे रम्ये शक्रेण सह मोदते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2178890, "chapter_id": 4783, "verse_number": "", "content_sanskrit": "श्रीश्रीवेदव्यासार्पितमस्तु ॥ श्रीमद्वादिराजगुरुभ्यो नमः ॥ शुभमस्तु ॥ हरिः ॐ॥ श्रीश्रीः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]