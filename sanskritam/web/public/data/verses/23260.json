[{"id": 7003260000, "chapter_id": 23260, "verse_number": "१-६३-१", "content_sanskrit": "ऋषय ऊचुः  ।\nदेवानां दानवानां च गंधर्वोरगरक्षसाम्  ।\nउत्पत्तिं ब्रूहि सूताद्य यथाक्रममनुत्तमम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003260001, "chapter_id": 23260, "verse_number": "१-६३-२", "content_sanskrit": "सूत उवाच  ।\nसंकल्पाद्दर्शनात्स्पर्शात्पूर्वेषां सृष्टिरुच्यते  ।\nदक्षात्प्राचेतसादूर्ध्वं सृष्टिर्मैथुनसंभवा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003260002, "chapter_id": 23260, "verse_number": "१-६३-३", "content_sanskrit": "यदा तु सृजतस्तस्य देवर्षिगण पन्नगान्  ।\nन वृद्धिमगमल्लोकस्तदा मैथुनयोगतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003260003, "chapter_id": 23260, "verse_number": "१-६३-४", "content_sanskrit": "दक्षः पुत्रसहस्राणि पंच सूत्यामजीजनत्  ।\nतांस्तु दृष्ट्वा महाभागान् सिसृक्षुर्विविधाः प्रजाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003260004, "chapter_id": 23260, "verse_number": "१-६३-५", "content_sanskrit": "नारदः प्राह हर्यश्वान्दक्षपुत्रान्समागतान्  ।\nभुवः प्रमाणं सर्वं तु ज्ञात्वोर्ध्वमध एव च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003260005, "chapter_id": 23260, "verse_number": "१-६३-६", "content_sanskrit": "ततः सृष्टिं विशेषेण कुरुध्वं मुनिसत्तमाः  ।\nते तु तद्वचनं श्रुत्वा प्रयाताः सर्वतोदिशम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003260006, "chapter_id": 23260, "verse_number": "१-६३-७", "content_sanskrit": "अद्यापि न निवर्तंते समुद्रादिव सिंधवः  ।\nहर्यश्वेषु च नष्टेषु पुनर्दक्षः प्रजापतिः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003260007, "chapter_id": 23260, "verse_number": "१-६३-८", "content_sanskrit": "सूत्यामेव च पुत्राणां सहस्रमसृजत्प्रभुः  ।\nशबला नाम ते विप्राः समेताः सृष्टिहेतवः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003260008, "chapter_id": 23260, "verse_number": "१-६३-९", "content_sanskrit": "नारदोनुगतान्प्राह पुनस्तान्सूर्यवर्चसः  ।\nभुवः प्रमाणं सर्वं तु ज्ञात्वा भ्रातॄन् पुनः पुनः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003260009, "chapter_id": 23260, "verse_number": "१-६३-१०", "content_sanskrit": "आगत्य वाथ सृष्टिं वै करिष्यथ विशेषतः  ।\nतेपि तेनैव मार्गेण जग्मुर्भ्रातृगतिं तथा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003260010, "chapter_id": 23260, "verse_number": "१-६३-११", "content_sanskrit": "ततस्तेष्वपि नष्टेषु षष्टिकन्याः प्रजापतिः  ।\nवैरिण्यां जनयामास दक्षः प्राचेतसस्तदा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003260011, "chapter_id": 23260, "verse_number": "१-६३-१२", "content_sanskrit": "प्रादात्स दशकं धर्मे कश्यपाय त्रयोदश  ।\nविंशत्सप्त च सोमाय चतस्रोऽरिष्टनेमये  ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003260012, "chapter_id": 23260, "verse_number": "१-६३-१३", "content_sanskrit": "द्वे चैव भृगुपुत्त्राय द्वे कृशाश्वाय धीमते  ।\nद्वे चैवाङ्गिरसे तद्वत्तासां नामानि विस्तरात् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003260013, "chapter_id": 23260, "verse_number": "१-६३-१४", "content_sanskrit": "श्रृणुध्वं देवमातॄणां प्रजाविस्तारमादितः  ।\nमरुत्वती वसूर्यामिर्लबा भानुररुंधती ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003260014, "chapter_id": 23260, "verse_number": "१-६३-१५", "content_sanskrit": "संकल्पा च मुहूर्ता च साध्या विश्वा च भामिनि  ।\nधर्मपत्न्यः समाख्यातास्तासां पुत्रान्वदामि वः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003260015, "chapter_id": 23260, "verse_number": "१-६३-१६", "content_sanskrit": "विश्वेदेवास्तु विश्वायाः साध्या साध्यानजीजनत्  ।\nमरुत्वत्यां मरुत्वंतो वसोस्तु वसवस्तथा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003260016, "chapter_id": 23260, "verse_number": "१-६३-१७", "content_sanskrit": "भानोस्तु भानवः प्रोक्ता मुहूर्ताया मुहूर्तकाः  ।\nलंबाया घोषनामानो नागवीथिस्तु यामिजः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003260017, "chapter_id": 23260, "verse_number": "१-६३-१८", "content_sanskrit": "संकल्पायास्तु संकल्पो वसुसर्गं वदामि वः  ।\nज्योतिष्मंतस्तु ये देवा व्यापकाः सर्वतोदिशम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003260018, "chapter_id": 23260, "verse_number": "१-६३-१९", "content_sanskrit": "वसवस्ते समाख्याताः सर्वभूतहितैषिणः  ।\nआपो ध्रुवश्च सोमश्च धरश्चैवानिलोनलः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003260019, "chapter_id": 23260, "verse_number": "१-६३-२०", "content_sanskrit": "प्रत्यूषश्च प्रभासश्च वसवोष्टौ प्रकीर्तिताः  ।\nअजैकपादहिर्बुध्यो विरुपाक्षः सभैरवः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003260020, "chapter_id": 23260, "verse_number": "१-६३-२१", "content_sanskrit": "हरश्च बहुरूपश्च त्र्यंबकश्च सुरेश्वरः  ।\nसावित्रश्च जयंतश्च पिनाकी चापराजितः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003260021, "chapter_id": 23260, "verse_number": "१-६३-२२", "content_sanskrit": "एते रुद्राः समाख्याता एकादश गणेश्वराः  ।\nकश्यपस्य प्रवक्ष्यामि पत्नीभ्यः पुत्रपौत्रकम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003260022, "chapter_id": 23260, "verse_number": "१-६३-२३", "content_sanskrit": "अदितिश्च दितिश्चैव अरिष्टा सुरसा मुनिः  ।\nसुरभिर्विनता ताम्रा तद्वत् क्रोधवशा इला ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003260023, "chapter_id": 23260, "verse_number": "१-६३-२४", "content_sanskrit": "कद्रूस्त्विषा दनुस्तद्वत्तासां पुत्रान्वदामि वः  ।\nतुषिता नाम ये देवाश्चाक्षुषास्यांतरे मनोः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003260024, "chapter_id": 23260, "verse_number": "१-६३-२५", "content_sanskrit": "वैवस्वतांतरे ते वै आदित्या द्वादश स्मृताः  ।\nइंद्रो धाता भगस्त्वष्ट मित्रोथ वरुणोर्यमा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003260025, "chapter_id": 23260, "verse_number": "१-६३-२६", "content_sanskrit": "विवस्वान्सविता पूषा अंशुमान् विष्णुरेव च  ।\nएते सहस्रकिरणा आदीत्या द्वादश स्मृताः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003260026, "chapter_id": 23260, "verse_number": "१-६३-२७", "content_sanskrit": "दितिः पुत्रद्वयं लेभे कश्यपादिति नः श्रुतम्  ।\nहिरण्यकशिपुं चैव हिरण्याक्षं तथैव च ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003260027, "chapter_id": 23260, "verse_number": "१-६३-२८", "content_sanskrit": "दनुः पुत्रशतं लेभे कश्यपाद्बलदर्पितम्  ।\nविप्रचित्तिः प्रधानोभूत्तेषां मध्ये द्विजोत्तमाः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003260028, "chapter_id": 23260, "verse_number": "१-६३-२९", "content_sanskrit": "ताम्रा च जनयामास षट् कन्या द्विजपुंगवाः  ।\nशुकीं श्येनीं च भासीं च सुग्रीवीं गृध्रिकां शुचिम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003260029, "chapter_id": 23260, "verse_number": "१-६३-३०", "content_sanskrit": "शुकी शुकानुलूकांश्च जनयामास धर्मतः  ।\nश्येनी श्येनांस्तथा भासी कुरंगांश्च व्यजीजनत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003260030, "chapter_id": 23260, "verse_number": "१-६३-३१", "content_sanskrit": "गृध्री गृध्रान् कपोतांश्च पारावतीविहंगमान्  ।\nहंससारसकारंडप्लवाञ्छुचिरजीजनत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003260031, "chapter_id": 23260, "verse_number": "१-६३-३२", "content_sanskrit": "अजाश्वमेषोष्ट्रखरान् सुग्रीवी चाप्यजीजनत्  ।\nविनता जनया मास गरुडं चारुणं शुभा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003260032, "chapter_id": 23260, "verse_number": "१-६३-३३", "content_sanskrit": "सौदामिनीं तथा कन्यां सर्वलोकभयंकरीम्  ।\nसुरसायाः सहस्रं तु सर्पाणामभवत्पुरा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003260033, "chapter_id": 23260, "verse_number": "१-६३-३४", "content_sanskrit": "कद्रूः सहस्रशिरसां सहस्रं प्राप सुव्रता  ।\nप्रधानास्तेषु विख्याताः षड्विंशतिरनुत्तमाः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003260034, "chapter_id": 23260, "verse_number": "१-६३-३५", "content_sanskrit": "शेषवासुकिकर्कोचशंखैरावतकंबलाः  ।\nधनंजयमहानीलपद्माश्वतरतक्षकाः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003260035, "chapter_id": 23260, "verse_number": "१-६३-३६", "content_sanskrit": "एलापत्रमहापद्मधृतराष्ट्रबलाहकाः  ।\nशंखपालमहाशंखपुष्पदंष्ट्रशुभाननाः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003260036, "chapter_id": 23260, "verse_number": "१-६३-३७", "content_sanskrit": "शंख लोमा च नहुषो वामनः फणितस्तथा  ।\nकपिलो दुर्मुखश्चापि पतंजलिरिति स्मृतः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003260037, "chapter_id": 23260, "verse_number": "१-६३-३८", "content_sanskrit": "रक्षोगणं क्रोधवशा महामायं व्यजीजनत्  ।\nरुद्राणां च गणं तद्वद्गोमहिष्यौ वरांगना ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003260038, "chapter_id": 23260, "verse_number": "१-६३-३९", "content_sanskrit": "सुरभिर्जनयामास कश्यपादिति नः श्रुतम्  ।\nमुनिर्मुनीनां च गणं गणमप्सरसां तथा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003260039, "chapter_id": 23260, "verse_number": "१-६३-४०", "content_sanskrit": "तता किंनरगंधर्वानरिष्टाजनयद्बहून्  ।\nतृणवृक्षलतागुल्ममिला सर्वमजीजनत् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003260040, "chapter_id": 23260, "verse_number": "१-६३-४१", "content_sanskrit": "त्विषा तु यक्षरक्षांसि जनयामास कोटिशः  ।\nएते तु काश्यपेयाश्च संक्षेपात्परिकीर्तिताः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003260041, "chapter_id": 23260, "verse_number": "१-६३-४२", "content_sanskrit": "एतेषां पुत्रपौत्रादिवंशाश्च बहवः स्मृताः  ।\nएवं प्रजासु सृष्टासु कश्य पेन महात्मना ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003260042, "chapter_id": 23260, "verse_number": "१-६३-४३", "content_sanskrit": "प्रतिष्ठितासु सर्वासु चरासु स्थावरासु च  ।\nअभिषिच्याधिपत्येषु तेषां मुख्यान्प्रजापतिः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003260043, "chapter_id": 23260, "verse_number": "१-६३-४४", "content_sanskrit": "ततो मनुष्याधिपतिं चक्रे वैवस्वतं मनुम्  ।\nस्वायंभुवेन्तरे पूर्वं ब्रह्मणा येऽभिषेचिताः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003260044, "chapter_id": 23260, "verse_number": "१-६३-४५", "content_sanskrit": "तैरियं पृथिवी सर्वा सप्तद्वीपा सपर्वता  ।\nयथोपदेशमद्यापि धर्मेण प्रतिपाल्यते ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003260045, "chapter_id": 23260, "verse_number": "१-६३-४६", "content_sanskrit": "स्वायंभुवेन्तरे पूर्वे ब्रह्मणा येऽभिषेचिताः  ।\nते ह्येते चाभिषिच्यंते मनवश्च भवन्ति ते ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003260046, "chapter_id": 23260, "verse_number": "१-६३-४७", "content_sanskrit": "मन्वंतरेष्वतीतेषु गता ह्येतेषु पार्थिवाः  ।\nएवमन्येभिषिच्यन्ते प्राप्ते मन्वंतरे ततः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003260047, "chapter_id": 23260, "verse_number": "१-६३-४८", "content_sanskrit": "अतीतानागताः सर्वे नृपा मन्वन्तरे स्मृताः  ।\nएतानुत्पाद्य पुत्रांस्तु प्रजासंतानकारणात् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003260048, "chapter_id": 23260, "verse_number": "१-६३-४९", "content_sanskrit": "कश्यपो गोत्रकामस्तु चचार स पुनस्तपः  ।\nपुत्रो गोत्रकरो मह्यं भवतादिति चिंतयन् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003260049, "chapter_id": 23260, "verse_number": "१-६३-५०", "content_sanskrit": "तस्यैवं ध्यायमानस्य कश्यपस्य महात्मनः  ।\nब्रह्मयोगात्सुतौ पश्चात्प्रादुर्भूतौ महौजसौ ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003260050, "chapter_id": 23260, "verse_number": "१-६३-५१", "content_sanskrit": "वत्सरश्चासितश्चैव तावुभौ ब्रह्मवादिनौ  ।\nवत्सरान्नैध्रुवो जज्ञे रैभ्यश्च सुमहायशाः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003260051, "chapter_id": 23260, "verse_number": "१-६३-५२", "content_sanskrit": "रैभ्यस्य रैभ्या विज्ञेया नैध्रुवस्य वदामि वः  ।\nच्यवनस्य तु कन्यायां सुमेधाः समपद्यत ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003260052, "chapter_id": 23260, "verse_number": "१-६३-५३", "content_sanskrit": "नैध्रुवस्य तु सा पत्नी माता वै कुंडपायिनाम्  ।\nअसितस्यैकपर्णायां ब्रह्मिष्ठः समपद्यत ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003260053, "chapter_id": 23260, "verse_number": "१-६३-५४", "content_sanskrit": "शांडिल्यानां वरः श्रीमान्देवलः सुमहातपाः  ।\nशांडिल्या नैध्रुवा रैभ्यास्त्रयः पक्षास्तु काश्यपाः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003260054, "chapter_id": 23260, "verse_number": "१-६३-५५", "content_sanskrit": "नव प्रकृतयो देवाः पुलस्त्यस्य वदामि वः  ।\nचतुर्युगे ह्यतिक्रांते मनोरेकादशे प्रभोः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003260055, "chapter_id": 23260, "verse_number": "१-६३-५६", "content_sanskrit": "अर्धावशिष्टे तस्मिंस्तु द्वापरे संप्रवर्तिते  ।\nमानवस्य नरिष्यन्तः पुत्र सीद्दमः किल ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003260056, "chapter_id": 23260, "verse_number": "१-६३-५७", "content_sanskrit": "दमस्य तस्य दायादस्तृणबिंदुरिति स्मृतः  ।\nत्रेतायुगमुखे राजा तृतीये संबभूव ह ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003260057, "chapter_id": 23260, "verse_number": "१-६३-५८", "content_sanskrit": "तस्य कन्या त्विलविला रूपेणाप्रतिमाभवत्  ।\nपुरस्त्याय स राजर्षिस्तां कन्यां प्रत्यपादयत् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003260058, "chapter_id": 23260, "verse_number": "१-६३-५९", "content_sanskrit": "ऋषिरैरविलो यस्यां विश्रवाः समपद्यत  ।\nतस्य पत्न्यश्चतस्रस्तु पौलस्त्यकुलवर्धनाः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003260059, "chapter_id": 23260, "verse_number": "१-६३-६०", "content_sanskrit": "बृहस्पतेः शुभा कन्या नाम्ना वै देववर्णिनी  ।\nपुष्पोत्कटा बलाका च सुते माल्यवतः स्मृतेः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003260060, "chapter_id": 23260, "verse_number": "१-६३-६१", "content_sanskrit": "कैकसी मालिनः कन्या तासां वै श्रृणुत प्रजाः  ।\nज्येष्ठं वैश्रवणं तस्मात्सुषुवे देव वर्णिनी ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003260061, "chapter_id": 23260, "verse_number": "१-६३-६२", "content_sanskrit": "कैकसी चाप्यजनयद्रावणं राक्षसाधिपम्  ।\nकुंभकर्णं शूर्पनखां धीमन्तं च विभीषणम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003260062, "chapter_id": 23260, "verse_number": "१-६३-६३", "content_sanskrit": "पुष्पोत्कटा ह्यजनयत्पुत्रांस्तस्माद्द्विजोत्तमाः  ।\nमहोदरं प्रहस्तं च महापार्श्वं खरं तथा ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003260063, "chapter_id": 23260, "verse_number": "१-६३-६४", "content_sanskrit": "कुंभीनसीं तथा कन्यां बलायाः श्रृणुत प्रजाः  ।\nत्रिशिरा दूषमश्चैव विद्युज्जिह्वश्च राक्षसः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003260064, "chapter_id": 23260, "verse_number": "१-६३-६५", "content_sanskrit": "कन्या वै मालिका चापि बलायाः प्रसवः स्मृतः  ।\nइत्येते क्रूरकर्माणः पौलस्त्या राक्षसा नव ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003260065, "chapter_id": 23260, "verse_number": "१-६३-६६", "content_sanskrit": "विभीषणोतिशुद्धात्मा धर्मज्ञः परिकीर्तितः  ।\nपुलस्त्यस्य मृगाः पुत्राः सर्वे व्याघ्रश्च दंष्ट्रिणः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003260066, "chapter_id": 23260, "verse_number": "१-६३-६७", "content_sanskrit": "भूताः पिशाचाः सर्पाश्च सूकरा हस्तिनस्तथा  ।\nवानराः किंनराश्चैव ये च किंपुरुषास्तथा ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003260067, "chapter_id": 23260, "verse_number": "१-६३-६८", "content_sanskrit": "अनपत्यः क्रतुस्तस्मिन् स्मृतो वैवस्वतेन्तरे  ।\nअत्रेः पत्न्यो दशैवासन् सुंदर्यश्च पतिव्रताः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003260068, "chapter_id": 23260, "verse_number": "१-६३-६९", "content_sanskrit": "भद्राश्वस्य घृताच्यां वै दशाप्सरसि सूनवः  ।\nभद्राभद्रा च जलदा मंदा नंदा तथैव च ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003260069, "chapter_id": 23260, "verse_number": "१-६३-७०", "content_sanskrit": "बलाबला च विप्रेन्द्रा या च गोपाबला स्मृता  ।\nतथा तामरसा चैव वरक्रीडा च वै दश ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003260070, "chapter_id": 23260, "verse_number": "१-६३-७१", "content_sanskrit": "आत्रेयवंशप्रभवा स्तासां भर्ता प्रभाकरः  ।\nस्वर्भानुपिहिते सूर्ये पतितेस्मिन्दिवो महीम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003260071, "chapter_id": 23260, "verse_number": "१-६३-७२", "content_sanskrit": "तमोऽभिभूते लोकेस्मिन्प्रभा येन प्रवर्तिता  ।\nस्वस्त्यस्तु हि तवेत्युक्ते पतन्निह दिवाकरः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003260072, "chapter_id": 23260, "verse_number": "१-६३-७३", "content_sanskrit": "ब्रह्मर्षेर्वचनात्तस्य पपात न विभुर्दिवः  ।\nततः प्रभाकरेत्युक्तः प्रभुरत्रिर्महर्षिभिः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003260073, "chapter_id": 23260, "verse_number": "१-६३-७४", "content_sanskrit": "भद्रायां जनयामास सोमं पुत्रं यशस्विनम्  ।\nस तासु जनयामास पुनः पुत्रांस्तपोधनः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003260074, "chapter_id": 23260, "verse_number": "१-६३-७५", "content_sanskrit": "स्वस्त्यात्रेया इति ख्याता ऋषयो वेदपारगाः  ।\nतेषां द्वौ ख्यातयशसौ ब्रह्मिष्ठौ च महौजसौ ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003260075, "chapter_id": 23260, "verse_number": "१-६३-७६", "content_sanskrit": "दत्तो ह्यत्रिवरो ज्येष्ठो दुर्वासास्तस्य चानुजः  ।\nयवीयसी स्वसा तेषाममला ब्रह्मवादिनी ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003260076, "chapter_id": 23260, "verse_number": "१-६३-७७", "content_sanskrit": "तस्य गोत्रद्वये जाताश्चत्वारः प्रथिता भुवि  ।\nश्यावश्च प्रत्वसश्चैव ववल्गुश्चाथ गह्वरः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003260077, "chapter_id": 23260, "verse_number": "१-६३-७८", "content_sanskrit": "आत्रेयाणां च चत्वारः स्मृताः पक्षा महात्मनाम्  ।\nकाश्यपो नारदश्चैव पर्वतानुद्धतस्तथा ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003260078, "chapter_id": 23260, "verse_number": "१-६३-७९", "content_sanskrit": "जज्ञिरे मानसा ह्येते अरुंधत्या निबोधत  ।\nनारदस्तु वसिष्ठायारुन्धतीं प्रत्यपादयत् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003260079, "chapter_id": 23260, "verse_number": "१-६३-८०", "content_sanskrit": "ऊर्ध्वरेता महातेजा दक्षशापात्तु नारदः  ।\nपुरा देवासुरे युद्धे घोरे वै तारकामये ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003260080, "chapter_id": 23260, "verse_number": "१-६३-८१", "content_sanskrit": "अनावृष्ट्या हते लोके ह्युग्रे लोकेश्वरैः सह  ।\nवसिष्ठस्तपसा धीमान्धारयामास वै प्रजाः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003260081, "chapter_id": 23260, "verse_number": "१-६३-८२", "content_sanskrit": "अन्नोदकं मूलफलमोषधीश्च प्रवर्तयन्  ।\nतानेताञ्जीवयामास कारुण्यादौषधेन च ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003260082, "chapter_id": 23260, "verse_number": "१-६३-८३", "content_sanskrit": "अरुन्धत्यां वसिष्ठस्तु सुतानुत्पादयच्छतम्  ।\nज्यायसोजनयच्छक्तेरदृश्यंती पराशरम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003260083, "chapter_id": 23260, "verse_number": "१-६३-८४", "content_sanskrit": "रक्षसा भक्षिते शक्तौ रुधिरेण तु वै तदा  ।\nकाली पराशराज्जज्ञे कृष्णद्वैपायनं प्रभुम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003260084, "chapter_id": 23260, "verse_number": "१-६३-८५", "content_sanskrit": "द्वैपायनो ह्यरण्यां वै शुकमुत्पादयत्सुतम्  ।\nउपमन्युं च पीवर्यां विद्धीमे शुकसूनवः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003260085, "chapter_id": 23260, "verse_number": "१-६३-८६", "content_sanskrit": "भूरिश्रवाः प्रभुः शंभुः कृष्णो गौरस्तु पंचमः  ।\nकन्या कीर्ति मती चैव योगमाता धृतव्रता ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003260086, "chapter_id": 23260, "verse_number": "१-६३-८७", "content_sanskrit": "जननी ब्रह्मदत्तस्य पत्नी सा त्वनुहस्य च  ।\nश्वेतः कृष्णश्च गौरश्च श्यामो धूम्रस्तथारुणः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003260087, "chapter_id": 23260, "verse_number": "१-६३-८८", "content_sanskrit": "नीलो बादरिकश्चैव सर्वे चैते पराशराः  ।\nपराशराणामष्टौ ते पक्षाः प्रोक्ता महात्मनाम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003260088, "chapter_id": 23260, "verse_number": "१-६३-८९", "content_sanskrit": "अत ऊर्ध्वं निबोधध्वमिंद्रप्रमितिसंभवम्  ।\nवसिष्ठस्य कपिंजल्यो घृताच्यामुदपद्यत ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003260089, "chapter_id": 23260, "verse_number": "१-६३-९०", "content_sanskrit": "त्रिमूर्तिर्यः समाख्यात इंद्रप्रमितिरुच्यते  ।\nपृथोः सुतायां संभूतो भद्रस्तस्या भवद्वसुः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003260090, "chapter_id": 23260, "verse_number": "१-६३-९१", "content_sanskrit": "उपमन्युः सुतस्तस्य बहवो ह्यौपमन्यवः  ।\nमित्रावरुणयोश्चैव कौण्डिन्या ये परिश्रुताः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003260091, "chapter_id": 23260, "verse_number": "१-६३-९२", "content_sanskrit": "एकार्षेयास्तथा चान्ये वासिष्ठा नाम विश्रुताः  ।\nएते पक्षा वसिष्ठानां स्मृता दश महात्मनाम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003260092, "chapter_id": 23260, "verse_number": "१-६३-९३", "content_sanskrit": "इत्येते ब्रह्मणः पुत्रा मानसा विश्रुता भुवि  ।\nभर्तारश्च महाभागा एषां वंशाः प्रकीर्तिताः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003260093, "chapter_id": 23260, "verse_number": "१-६३-९४", "content_sanskrit": "त्रिलोकधारणे शक्ता देवर्षिकुलसंभवाः  ।\nतेषां पुत्राश्च पौत्राश्च शतशोथ सहस्रशः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003260094, "chapter_id": 23260, "verse_number": "१-६३-९५", "content_sanskrit": "यैस्तु व्याप्तास्त्रयो लोकाः सूर्यस्येव गभस्तिभिः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}]