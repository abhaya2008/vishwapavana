[{"id": 2028879, "chapter_id": 1630, "verse_number": "३-२६८-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2028880, "chapter_id": 1630, "verse_number": "३-२६८-१", "content_sanskrit": "तथाऽऽसीनेषु सर्वेषु तेषु राजसु भारत।\n`कोटिकाश्यो जगामाशु सिन्धुराजनिवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2028881, "chapter_id": 1630, "verse_number": "३-२६८-२", "content_sanskrit": "यदुक्तं कृष्णया सार्धं तत्सर्वं प्रत्यवेदयत्।\nकोटिकाश्यवचः श्रुत्वा शैब्यं सौवीरकोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2028882, "chapter_id": 1630, "verse_number": "३-२६८-३", "content_sanskrit": "यदा वाचं व्याहरन्त्यामस्यां मे रमते मनः।\nसीमन्तिनीनां सुख्यायां विनिवृत्तः कथं भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2028883, "chapter_id": 1630, "verse_number": "३-२६८-४", "content_sanskrit": "एतां दृष्ट्वा स्त्रियो मेऽन्या यथा शाखामृगस्त्रियः।\nप्रतिभान्ति महाबाहो सत्यमेतद्ब्रवीमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2028884, "chapter_id": 1630, "verse_number": "३-२६८-५", "content_sanskrit": "दर्शनादेव हि मनस्तया मेऽपहृतं भृशम्।\nतां समाचक्ष्व कल्याणीं यदि स्याच्छैब्य मानुषी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2028885, "chapter_id": 1630, "verse_number": "३-२६८-६x", "content_sanskrit": "कोटिक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2028886, "chapter_id": 1630, "verse_number": "३-२६८-६", "content_sanskrit": "एषा वै द्रौपदी कृष्णा राजपुत्री यशस्विनी।\nपञ्चानां पाण्डुपुत्राणां महिषी संमता भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2028887, "chapter_id": 1630, "verse_number": "३-२६८-७", "content_sanskrit": "सर्वेषां चैव पार्थानां प्रिया बहुमता सती।\nतया समेत्य सौवीर सौवीराभिमुखो व्रज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2028888, "chapter_id": 1630, "verse_number": "३-२६८-८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2028889, "chapter_id": 1630, "verse_number": "३-२६८-८", "content_sanskrit": "एवमुक्तः प्रत्युवाच पश्यामि द्रौपदीमिति।\nपतिः सौवीरसिन्धूनां दुष्टभावो जयद्रथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2028890, "chapter_id": 1630, "verse_number": "३-२६८-९", "content_sanskrit": "स प्रविश्याश्रमं पुण्यं सिंहगोष्ठं वृको यथा।\nआत्मना सप्तमः कृष्णामिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2028891, "chapter_id": 1630, "verse_number": "३-२६८-१०", "content_sanskrit": "कुशलं ते वरारोहे भर्तारस्तेऽप्यनामयाः।\nयेषां कुशलकामासि तेऽपिकच्चिदनामयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2028892, "chapter_id": 1630, "verse_number": "३-२६८-११x", "content_sanskrit": "द्रौपद्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2028893, "chapter_id": 1630, "verse_number": "३-२६८-११", "content_sanskrit": "अपि ते कुशलं राजन्राष्ट्रे कोशे बले तथा।\nकच्चिदेकः शिबीनाढ्यान्सौवीरान्सह सिन्धुभिः।\nअनुतिष्ठसि धर्मेण ये चान्ये विदितास्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2028894, "chapter_id": 1630, "verse_number": "३-२६८-१२", "content_sanskrit": "कौरव्यः कुशली राजा कुन्तीपुत्रो युधिष्ठिरः।\nअहं च भ्रातरश्चास्य यांश्चान्यान्परिपृच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2028895, "chapter_id": 1630, "verse_number": "३-२६८-१३", "content_sanskrit": "पाद्यं प्रतिगृहाणेदमासनं च नृपात्मज।\nमृगान्विता मृगीश्चैव प्रातराशं ददानि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2028896, "chapter_id": 1630, "verse_number": "३-२६८-१४", "content_sanskrit": "ऐणेयान्पृषतान्न्यङ्कून्हरिणाञ्शरभाञ्शशान्।\nऋक्षाव्रुरूञ्शम्बरांश्च गवयांश्च मृगान्बहून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2028897, "chapter_id": 1630, "verse_number": "३-२६८-१५", "content_sanskrit": "वराहामहिषांश्चैव याश्चान्या मृगजातयः।\nप्रदास्यति स्वयं तुभ्यं कुन्तीपुत्रो युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2028898, "chapter_id": 1630, "verse_number": "३-२६८-१६x", "content_sanskrit": "जयद्रथ उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2028899, "chapter_id": 1630, "verse_number": "३-२६८-१६", "content_sanskrit": "कुशलं प्रातराशस्य सर्वं मे दित्सितं त्वया।\nएहि मे रथमारोह सुखमाप्नुहि केवलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2028900, "chapter_id": 1630, "verse_number": "३-२६८-१७", "content_sanskrit": "गतश्रीकान्हृतराज्यान्कृपणान्गतचेतसः।\nअरण्यवासिनः पार्थान्नानुरोद्धुं त्वमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2028901, "chapter_id": 1630, "verse_number": "३-२६८-१८", "content_sanskrit": "नैव प्राज्ञा गतश्रीकं भर्तारमुपयुञ्जते।\nयुञ्जानमनुयुञ्जीत न शरियः संक्षये वसेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2028902, "chapter_id": 1630, "verse_number": "३-२६८-१९", "content_sanskrit": "श्रिया विहीना राष्ट्राच्च विनष्टाः शाश्वतीः समाः।\nअलं ते पाण्डुपुत्राणां भक्त्या क्लेशमुपासितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2028903, "chapter_id": 1630, "verse_number": "३-२६८-२०", "content_sanskrit": "भार्या मे भव सुश्रोणि त्यजैनान्मुखमाप्नुहि।\nअखिलान्सिन्धुसौवीरानाप्नुहि त्वं मया सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2028904, "chapter_id": 1630, "verse_number": "३-२६८-२१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2028905, "chapter_id": 1630, "verse_number": "३-२६८-२१", "content_sanskrit": "इत्युक्ता सिन्धुराजेन वाक्यं हृदयकम्पनम्।\nकृष्णा तस्मादपाक्रामद्देशात्सभ्रुकुटीमुखी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2028906, "chapter_id": 1630, "verse_number": "३-२६८-२२", "content_sanskrit": "अवमत्यास्य तद्वांक्यमाक्षिप्य च सुमध्यमा।\nमैवमित्यब्रवीत्कृष्णा लज्जस्वेति च सैन्धवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2028907, "chapter_id": 1630, "verse_number": "३-२६८-२३", "content_sanskrit": "सा काङ्क्षमाणा भर्तृणामुपयातमनिन्दिता।\nविलम्बयामास परं वाक्यैर्वाक्यानि युञ्जती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2028908, "chapter_id": 1630, "verse_number": "३-२६८-२३x", "content_sanskrit": "द्रैपद्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2028909, "chapter_id": 1630, "verse_number": "३-२६८-२४", "content_sanskrit": "नैवं वद महाबाहो न्याय्यं त्वं न च मन्यसे।\nपाण्डूनां धार्तराष्ट्राणां स्वसा चैव कनीयसी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2028910, "chapter_id": 1630, "verse_number": "३-२६८-२५", "content_sanskrit": "दुश्शला नाम तस्यास्त्वं भर्ता राजकुलोद्वह।\nमम भ्राता च न्याय्येन त्वया रक्ष्या महारथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2028911, "chapter_id": 1630, "verse_number": "३-२६८-२६", "content_sanskrit": "धर्मिष्ठानां कुले जातो न धर्मं त्वमवेक्षसे।\nइत्युक्तः सिन्धुराजोथ वाक्यमुत्तरमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2028912, "chapter_id": 1630, "verse_number": "३-२६८-२७", "content_sanskrit": "राज्ञां धर्मं न जानीषे स्त्रियो रत्नानि चैव हि।\nसाधारणानि लोकेऽस्मिन्प्रवदन्ति मनीषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2028913, "chapter_id": 1630, "verse_number": "३-२६८-२८", "content_sanskrit": "स्वसा च स्वस्रिया चैव भ्रातृभार्या तथैव च।\nसुखं गृह्णन्ति राजानस्ताश्च तत्र नृपोद्भवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2028914, "chapter_id": 1630, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि द्रौपदीहरणपर्वणि अष्टषष्ट्यधिकद्विशततमोऽध्यायः ॥ २६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]