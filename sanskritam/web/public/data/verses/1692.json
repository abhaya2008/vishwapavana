[{"id": 2031836, "chapter_id": 1692, "verse_number": "४-१५-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2031837, "chapter_id": 1692, "verse_number": "४-१५-१", "content_sanskrit": "एवं विराटनगरे वसन्तः सत्यविक्रमाः।\nअत ऊर्ध्वं नरव्याघ्राः किमकुर्वत पाण्डवाः ॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2031838, "chapter_id": 1692, "verse_number": "४-१५-२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2031839, "chapter_id": 1692, "verse_number": "४-१५-२", "content_sanskrit": "एवं ते न्यवसंस्तत्र प्रच्छन्नाः कुरुनन्दनाः ।\nआराधयन्तो राजानां यदकुर्वत तच्छृणु ॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2031840, "chapter_id": 1692, "verse_number": "४-१५-३", "content_sanskrit": "युधिष्ठिरः सभास्तारः सभ्यानामभवत्प्रियः ।\nतथैव च विराटस्य सपुत्रस्य विशांपते ॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2031841, "chapter_id": 1692, "verse_number": "४-१५-४", "content_sanskrit": "स ह्यक्षहृदयज्ञस्तान्क्रीडयामास पाण्डवः।\nअक्षबद्धान्यथाकामं सूत्रबद्धानिव द्विजान् ॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2031842, "chapter_id": 1692, "verse_number": "४-१५-५", "content_sanskrit": "अज्ञातं च विराटस्य विजित्य वसु धर्मराट्।\nभ्रातृभ्यः पुरुषव्याघ्रो यथेष्टं संप्रयच्छति ॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2031843, "chapter_id": 1692, "verse_number": "४-१५-६", "content_sanskrit": "भीमसेनोपि मांसानि भक्ष्याणि विविधानि च ।\nअतिसृष्टानि मत्स्येन विक्रीणन्निव भ्रातृषु ॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2031844, "chapter_id": 1692, "verse_number": "४-१५-७", "content_sanskrit": "वासांसि परिजीर्णानि लब्धान्यन्तःपुरेऽर्जुनः ।\nविक्रीणन्निव सर्वेभ्यः पाण्डवेभ्यः प्रयच्छति ॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2031845, "chapter_id": 1692, "verse_number": "४-१५-८", "content_sanskrit": "नकुलोपि धनं लब्ध्वा कृते कर्मणि वाजिनाम्।\nतुष्टे तस्मिन्नरपतौ पाण्डवेभ्यः प्रयच्छति ॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2031846, "chapter_id": 1692, "verse_number": "४-१५-९", "content_sanskrit": "सहदेवोपि गोपानां वेषमास्थाय पाण्डवः।\nदधि क्षीरं घृतं चैव पाण्डवेभ्यः प्रयच्छति ॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2031847, "chapter_id": 1692, "verse_number": "४-१५-१०", "content_sanskrit": "कृष्णा तु सर्वान्भ्रातॄंस्तान्निरीक्षन्ती तपस्विनी ।\nयथा पुनरविज्ञाता तथा चरति भामिनी ॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2031848, "chapter_id": 1692, "verse_number": "४-१५-११", "content_sanskrit": "एवं संभावयन्तस्ते तदाऽन्योन्यं महारथाः।\nविराटनगरे चेरुः पुनर्गर्भधृता इव ॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2031849, "chapter_id": 1692, "verse_number": "४-१५-१२", "content_sanskrit": "साशङ्का धार्तराष्ट्रस्य भयात्पाण्डुसुतास्तदा ।\nप्रेक्षमाणास्तदा कृष्णामूपुश्छन्ना नराधिप ॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2031850, "chapter_id": 1692, "verse_number": "४-१५-१३", "content_sanskrit": "अथ मासे चतुर्थे तु शङ्करस्य महोत्सवः।\nआसीत्समृद्धो मत्स्येषु पुरुषाणां सुसंमतः ॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2031851, "chapter_id": 1692, "verse_number": "४-१५-१४", "content_sanskrit": "तत्र मल्लाः समापेतुर्दिग्भ्यो राजन्सहस्रशः ॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2031852, "chapter_id": 1692, "verse_number": "४-१५-१५", "content_sanskrit": "महाकाया महावीर्याः कालकेया इवासुराः।\nवीर्योन्मत्ता बलोदग्रा राज्ञा समभिपूजिताः ॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2031853, "chapter_id": 1692, "verse_number": "४-१५-१६", "content_sanskrit": "सिंहस्कन्धकटिग्रीवाः स्ववदाता मनस्विनः।\nअसकृल्लब्धलक्षास्ते रङ्गे पार्थिवसन्निधौ ॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2031854, "chapter_id": 1692, "verse_number": "४-१५-१७", "content_sanskrit": "तेषामेको महानासीत्सर्वमल्लानथाह्वयत्।\nव्यावल्गमानो ददृशे गर्जितोद्गतिभिः स्थितः ॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2031855, "chapter_id": 1692, "verse_number": "४-१५-१८", "content_sanskrit": "वित्रस्तमनसः सर्वे मल्लास्ते हतचेतसः ।\nअवाङ्भुखाश्च भीताश्च मल्लाश्चान्ये विचेतसः ॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2031856, "chapter_id": 1692, "verse_number": "४-१५-१९", "content_sanskrit": "व्यसुत्वमपरे चैव वाञ्छन्ति प्रतिविह्वलाः।\nगां प्रवेष्टुमथेच्छन्ति खं गन्तुमिव चोत्थिताः ॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2031857, "chapter_id": 1692, "verse_number": "४-१५-२०", "content_sanskrit": "त्रस्ताः शान्ता विषणाङ्गा निःशब्दं विह्वलेक्षणाः ।\nविराटराजमल्लास्ते भग्नदर्पा हतप्रभाः ॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2031858, "chapter_id": 1692, "verse_number": "४-१५-२१", "content_sanskrit": "मल्लेन्द्रनिहताः सर्वे न किंचित्प्रवदन्ति ते।\nमल्ल उद्वीक्ष्य तान्मल्लांस्रस्तान्वाक्यमुवाचह ॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2031859, "chapter_id": 1692, "verse_number": "४-१५-२२", "content_sanskrit": "आगतं मल्लराजं मां कृत्स्ने पृथिविमण्डले ।\nसिंहव्याघ्रगणैः सार्धं क्रीडन्तं विद्धि भूपते ॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2031860, "chapter_id": 1692, "verse_number": "४-१५-२३", "content_sanskrit": "मल्लेन्द्रस्य वचः श्रुत्वा बलदर्पसमन्वितम् ।\nविराटो वीक्ष्य तान्मल्लांस्त्रस्तान्वाक्यमुवाच ह ॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2031861, "chapter_id": 1692, "verse_number": "४-१५-२४", "content_sanskrit": "अनेन सह मल्लेन को योद्धुं शक्तिमान्नरः ॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2031862, "chapter_id": 1692, "verse_number": "४-१५-२५", "content_sanskrit": "इत्युक्तास्ते विराटेन सर्वे मल्ला विशांपते ।\nतूष्णीमासंस्ततो राजा क्रोधाविष्ट उवाच ह ॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2031863, "chapter_id": 1692, "verse_number": "४-१५-२६", "content_sanskrit": "ग्रामांश्च वेतनान्येपां मल्लानां हारयाम्यहम्।\nततो युधिष्ठिरोऽवादीच्छ्रुत्वा मात्स्यपतेर्वचः ॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2031864, "chapter_id": 1692, "verse_number": "४-१५-२७", "content_sanskrit": "अस्ति मल्लो महाराज मया दृष्टो युधिष्ठिरे।\nअनेन सह मल्लेन योद्धुं शक्नोति भूपते ॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2031865, "chapter_id": 1692, "verse_number": "४-१५-२८", "content_sanskrit": "योसौ मल्लो मया दृष्टः पूर्वं यौधिष्ठिरे पुरे।\nसोयं मल्लो वसत्येप राजंस्तव महानसे ॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2031866, "chapter_id": 1692, "verse_number": "४-१५-२९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2031867, "chapter_id": 1692, "verse_number": "४-१५-२९", "content_sanskrit": "युधिष्ठिरवचः श्रुत्वा व्यक्तमाहेति पार्थिवः।\nसोप्यथाहूयतां क्षिप्रं योद्धुं मल्लेन संप्रति ॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2031868, "chapter_id": 1692, "verse_number": "४-१५-३०", "content_sanskrit": "भीमसेनो विराटेन आहूतश्चोदितस्तथा।\nयोद्धुं ततोऽब्रवीद्वाक्यं योद्धुं शक्नोमि भूपते ॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2031869, "chapter_id": 1692, "verse_number": "४-१५-३१", "content_sanskrit": "नरेन्द्र ते प्रभावेन श्रिया शक्त्या च शासनात्।\nअनेन सह मल्लेन योद्धुं राजेन्द्र शक्नुयाम् ॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2031870, "chapter_id": 1692, "verse_number": "४-१५-३२", "content_sanskrit": "युधिष्ठिरकृतं ज्ञात्वा श्रिया तव विशांपते।\nमहादेवस्य भक्त्या च तं मल्लं पातयाम्यहम् ॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2031871, "chapter_id": 1692, "verse_number": "४-१५-३३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2031872, "chapter_id": 1692, "verse_number": "४-१५-३३", "content_sanskrit": "चोदितो भीमसेनस्तु मल्लमाहूय मण्डले।\nयोद्धुं व्यवस्थितो वीरो रेणुं संमृज्य हस्तयोः।\nमत्तो गज इवान्यं तु योद्धुं समुपचक्रमे ॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2031873, "chapter_id": 1692, "verse_number": "४-१५-३४", "content_sanskrit": "अथ सूदेन तं मल्लं योधयामास मत्स्यराट्र ॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2031874, "chapter_id": 1692, "verse_number": "४-१५-३५", "content_sanskrit": "नोद्यमानस्तदा भीमो दुःखेनेवाकरोन्मतिम्।\nन हि शक्नोम्यशक्तोपि प्रत्याख्यातुं नराधिपं ॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2031875, "chapter_id": 1692, "verse_number": "४-१५-३६", "content_sanskrit": "ततः स पुरुषव्याघ्रः शार्दूलशिथिलं चरन्।\nप्रविवेश महारङ्गं विराटमभिहर्षयन् ॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2031876, "chapter_id": 1692, "verse_number": "४-१५-३७", "content_sanskrit": "बवन्ध कक्षां कौन्तेयस्ततः संहर्षयञ्जनम् ।\nततस्तु वृत्रसङ्काशं भीमो मल्लं समाह्वयत् ॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2031877, "chapter_id": 1692, "verse_number": "४-१५-३८", "content_sanskrit": "जीमूतं नाम तं तत्र मल्लप्रख्यातविक्रमम् ।\nकक्षे मल्लं गृहीत्वाऽथ ननाद बहु सिंहवत् ॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2031878, "chapter_id": 1692, "verse_number": "४-१५-३९", "content_sanskrit": "तावुभौ सुमहोत्साहावुभौ भीमपराक्रमौ ।\nमत्ताविव महाकायौ वारणौ षष्ठिहायनौ ॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2031879, "chapter_id": 1692, "verse_number": "४-१५-४०", "content_sanskrit": "ततस्तौ नरशार्दूलौ बाहुयुद्धं समीयतु।\nवीरौ परमसंहृष्टावन्योन्यजयकाङ्क्षिणौ ॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2031880, "chapter_id": 1692, "verse_number": "४-१५-४१", "content_sanskrit": "उभौ परमसंहृष्टौ बलेनातिबलावुभौ ।\nअन्योन्यस्यान्तरं प्रेप्सू परस्परजयैषिणौ ॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2031881, "chapter_id": 1692, "verse_number": "४-१५-४२", "content_sanskrit": "कृतप्रतिकृतैश्चित्रैर्बाहुभिश्च सुसङ्कटैः।\nसन्निपातावधूतैश्च प्रमाथोन्मथनैस्तथा ॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2031882, "chapter_id": 1692, "verse_number": "४-१५-४३", "content_sanskrit": "क्षेपणैर्मुष्टिभिश्चैव वराहोद्धूतनिस्स्वनैः।\nतलैर्वज्रनिपातैश्च प्रसृष्टाभिस्तथैव च ॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2031883, "chapter_id": 1692, "verse_number": "४-१५-४४", "content_sanskrit": "शलाकानखपातैश्च पादोद्धूतैश्च दारुणैः ।\nजानुभिश्चाश्मनिर्घोषैः शिरोभिश्चावघट्टनैः ॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2031884, "chapter_id": 1692, "verse_number": "४-१५-४५", "content_sanskrit": "तद्युद्धमभवद्धोरमशस्त्रं बाहुतेजसा।\nबलप्राणेन शूराणां समाजोत्सवसन्निधौ ॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2031885, "chapter_id": 1692, "verse_number": "४-१५-४६", "content_sanskrit": "अरज्यत जनः सर्वः सोत्क्रुष्टनिनदोत्थितः।\nबलिनोः संयुगे राजन्वृत्रवासवयोरिव ॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2031886, "chapter_id": 1692, "verse_number": "४-१५-४७", "content_sanskrit": "प्रकर्षणाकर्षणयोरभ्याकर्षविकर्षणैः।\nआकर्षतुरथान्योन्यं जानुभिश्चापि जन्घतुः ॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2031887, "chapter_id": 1692, "verse_number": "४-१५-४८", "content_sanskrit": "ततः शब्देन महता भर्त्सयन्तौ परस्परम्।\nव्यूढोरस्कौ दीर्घभुजौ नियुद्धकुशलावुभौ।\nबाहुभिः समसज्जेतामायसैः परिघैरिव ॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2031888, "chapter_id": 1692, "verse_number": "४-१५-४९", "content_sanskrit": "उत्पपाताथ वेगेन मल्लं कक्षे गृहीतवान्।\nपार्श्वं निगृह्य हस्तेन पातयामास मल्लकम् ॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2031889, "chapter_id": 1692, "verse_number": "४-१५-५०", "content_sanskrit": "चकर्ष दोर्भ्यामुत्पात्य भीमो मल्लममित्रहा।\nनिनदं तमभिक्रोशञ्शार्दूल इव वारणम् ॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2031890, "chapter_id": 1692, "verse_number": "४-१५-५१", "content_sanskrit": "समुद्यम्य महाबाहुर्भ्रामयामास वीर्यवान् ।\nततो मल्लाश्च मत्स्याश्च विस्मयं चक्रिरे परम् ॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2031891, "chapter_id": 1692, "verse_number": "४-१५-५२", "content_sanskrit": "भ्रामयित्वा शतगुणं गतसत्वमचेतनम् ।\nप्रत्यपिंषन्महाबाहुर्मल्लं भुवि वृकोदरः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2031892, "chapter_id": 1692, "verse_number": "४-१५-५३", "content_sanskrit": "तस्मिन्विनिहते वीरे जीमूते लोकविश्रुते ।\nविराटः परमं हर्षमगच्छद्वान्धवैः सह ॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2031893, "chapter_id": 1692, "verse_number": "४-१५-५४", "content_sanskrit": "प्रहर्षात्प्रददौ वित्तं बहु राज महामनाः।\nवललाय महारङ्गे यथा वैश्रवणस्तथा ॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2031894, "chapter_id": 1692, "verse_number": "४-१५-५५", "content_sanskrit": "एवं स सुबहून्मल्लान्पुरुषांश्च महाबलान् ।\nविनिघ्नन्मत्स्यराजस्य प्रीतिमाहरदुत्तमाम् ॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2031895, "chapter_id": 1692, "verse_number": "४-१५-५६", "content_sanskrit": "यदाऽस्य तुल्यः पुरुषो न कश्चितत्र विद्यते ।\nततो व्याघ्रैश्च सिंहैश्च द्विरदैश्चाप्ययोधयत् ॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2031896, "chapter_id": 1692, "verse_number": "४-१५-५७", "content_sanskrit": "विराटेन प्रदत्तानि चित्राणि विविधानि च।\nस्थितेभ्यः पुरुषेभ्यश्च दत्त्वा द्रव्याणि जग्मिवान् ॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2031897, "chapter_id": 1692, "verse_number": "४-१५-५८", "content_sanskrit": "पुनरन्तःपुरगतः स्त्रीणां मध्ये वृकोदरः।\nयोध्यते स विराटस्य गजैः सिंहैर्महाबलैः ॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2031898, "chapter_id": 1692, "verse_number": "४-१५-५९", "content_sanskrit": "बीभत्सुरपि गीतेन नृत्तेनापि च पाण्डवः।\nविराटं तोषयामास सर्वाश्चान्तःपुरस्त्रियः ॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2031899, "chapter_id": 1692, "verse_number": "४-१५-६०", "content_sanskrit": "अश्वैर्विनीतैर्जवनैस्तत्रतत्र समागतः।\nतोपयामास राजानं नकुलो नृपसत्तमम्।\nतस्मै प्रदेयं प्रायच्छत्प्रीतो राजा धनं बहु ॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2031900, "chapter_id": 1692, "verse_number": "४-१५-६१", "content_sanskrit": "विनीतान्वृपभान्दृष्ट्वा सहदेवस्य चाभितः।\nधनं ददौ बहुविधं विराटः पुरुषर्षभः ॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2031901, "chapter_id": 1692, "verse_number": "४-१५-६२", "content_sanskrit": "द्रौपदी प्रेक्ष्य तान्सर्वान्क्लिश्यमानान्महारथान् ।\nनातिप्रीतमना राजन्निश्वासपरमाऽभवत् ॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2031902, "chapter_id": 1692, "verse_number": "४-१५-६३", "content_sanskrit": "एवं ते न्यवसंस्तत्र प्रच्छन्नाः पुरुषर्षभाः ।\nकर्माणि तस्य कुर्वाणा विराटनृपतेस्तदा ॥ ६३ ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2031903, "chapter_id": 1692, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि समयपालनपर्वणि पञ्चदशोऽध्यायः ॥ १५ ॥ ॥ समाप्तं चेदं समयपालनपर्व ॥ २ ॥\n------------", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]