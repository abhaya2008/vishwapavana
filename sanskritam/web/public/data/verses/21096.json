[{"id": 7001096000, "chapter_id": 21096, "verse_number": "२-१-७-१", "content_sanskrit": "ब्रह्मोवाच ।\nसुप्ते नारायणे देवे नाभौ पंकजमुत्तमम् ।\nआविर्बभूव सहसा बहव संकरेच्छया॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001096001, "chapter_id": 21096, "verse_number": "२-१-७-२", "content_sanskrit": "अनंतयष्टिकायुक्तं कर्णिकारसमप्रभम् ।\nअनंतयोजनायाममनंतोच्छ्रायसंयुतम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001096002, "chapter_id": 21096, "verse_number": "२-१-७-३", "content_sanskrit": "कोटिसूर्यप्रतीकाशं सुंदर वचसंयुतम् ।\nअत्यद्भुतं महारम्यं दर्शनीयमनुत्तमम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001096003, "chapter_id": 21096, "verse_number": "२-१-७-४", "content_sanskrit": "कृत्वा यत्नं पूर्ववत्स शंकरः परमेश्वरः ।\nदक्षिणांगान्निजान्मां कैसाशीश्शंभुरजीजनत्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001096004, "chapter_id": 21096, "verse_number": "२-१-७-५", "content_sanskrit": "स मायामोहितं कृत्वा मां महेशो द्रुतं मुने ।\nतन्नाभिपंकजादाविर्भावयामास लीलया॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001096005, "chapter_id": 21096, "verse_number": "२-१-७-६", "content_sanskrit": "एष पद्मात्ततो जज्ञे पुत्रोऽहं हेमगर्भकः ।\nचतुर्मुखो रक्तवर्णस्त्रिपुड्रांकितमस्तकः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001096006, "chapter_id": 21096, "verse_number": "२-१-७-७", "content_sanskrit": "तन्मायामोहितश्चाहं नाविदं कमल विना ।\nस्वदेहजनकं तात पितरं ज्ञानदुर्बलः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001096007, "chapter_id": 21096, "verse_number": "२-१-७-८", "content_sanskrit": "कोहं वा कुत आयातः किं कार्य तु मदीयकम् ।\nकस्य पुत्रोऽहमुत्पन्नः केनैव निर्मितोऽधुना॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001096008, "chapter_id": 21096, "verse_number": "२-१-७-९", "content_sanskrit": "इति संशयमापन्नं बुद्धिर्मां समपद्यत ।\nकिमर्थं मोहमायामि तज्ज्ञानं सुकरं खलु॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001096009, "chapter_id": 21096, "verse_number": "२-१-७-१०", "content_sanskrit": "एतत्कमलपुष्पस्य पत्रारोहस्थलं ह्यधः ।\nमत्कर्ता च स वै तत्र भविष्यति न संशयः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001096010, "chapter_id": 21096, "verse_number": "२-१-७-११", "content_sanskrit": "इति बुद्धिं समास्थाय कमलादवरोहयन् ।\nनाले नालेगतस्तत्र वर्षाणां शतकं मुने॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001096011, "chapter_id": 21096, "verse_number": "२-१-७-१२", "content_sanskrit": "न लब्धं तु मया तत्र कमलस्थानमुत्तमम् ।\nसंशयं च पुनः प्राप्तः कमले गन्तुमुत्सुकः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001096012, "chapter_id": 21096, "verse_number": "२-१-७-१३", "content_sanskrit": "आरुरोहाथ कमलं नालमार्गेण वै मुने ।\nकुड्मलं कमलस्याथ लब्धवान्न विमोहिताः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001096013, "chapter_id": 21096, "verse_number": "२-१-७-१४", "content_sanskrit": "नालमार्गेण भ्रमतो गतं वर्षशतं पुनः ।\nक्षणमात्र तदा तत्र ततस्तिष्ठन्विमोहितः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001096014, "chapter_id": 21096, "verse_number": "२-१-७-१५", "content_sanskrit": "तदा वाणी समुत्पन्ना तपेति परमा शुभा ।\nशिवेच्छया परा व्योम्नो मोहविध्वंसिनी मुने॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001096015, "chapter_id": 21096, "verse_number": "२-१-७-१६", "content_sanskrit": "तच्छ्रुत्वा व्योमवचनं द्वादशाब्दं प्रयत्नतः ।\nपुनस्तप्तं तपो घोरं द्रष्टुं स्वजनकं तदा॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001096016, "chapter_id": 21096, "verse_number": "२-१-७-१७", "content_sanskrit": "तदा हि भगवान्विष्णुश्चतुर्बाहुस्सुलोचनः ।\nमय्येवानुग्रहं कर्तुं द्रुतमाविर्बभूव ह॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001096017, "chapter_id": 21096, "verse_number": "२-१-७-१८", "content_sanskrit": "शंखचक्रायुधकरो गदापद्मधरः परः ।\nघनश्यामलसर्वांगः पीताम्बरधरः परः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001096018, "chapter_id": 21096, "verse_number": "२-१-७-१९", "content_sanskrit": "मुकुटादिमहाभूषः प्रसन्नमुखपंकजः ।\nकोटिकंदर्पसंकाशस्सन्दष्टो मोहितेन सः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001096019, "chapter_id": 21096, "verse_number": "२-१-७-२०", "content_sanskrit": "तद्दृष्ट्वा सुन्दरं रूपं विस्मयं परमं गतः ।\nकालाभं कांचनाभं च सर्वात्मानं चतुर्भुजम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001096020, "chapter_id": 21096, "verse_number": "२-१-७-२१", "content_sanskrit": "तथाभूतमहं दृष्ट्वा सदसन्मयमात्मना ।\nनारायणं महाबाहु हर्षितो ह्यभवं तदा॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001096021, "chapter_id": 21096, "verse_number": "२-१-७-२२", "content_sanskrit": "मायया मोहितश्शम्भोस्तदा लीलात्मनः प्रभोः ।\nअविज्ञाय स्वजनकं तमवोचं प्रहर्षितः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001096022, "chapter_id": 21096, "verse_number": "२-१-७-२३", "content_sanskrit": "ब्रह्मोवाच ।\nकस्त्वं वदेति हस्तेन समुत्थाप्य सनातनम् ।\nतदा हस्तप्रहारेण तीव्रेण सुदृढेन तु॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001096023, "chapter_id": 21096, "verse_number": "२-१-७-२४", "content_sanskrit": "प्रबुद्ध्योत्थाय शयनात्समासीनः क्षणं वशी ।\nददर्श निद्राविक्लिन्ननीरजामललोचनः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001096024, "chapter_id": 21096, "verse_number": "२-१-७-२५", "content_sanskrit": "मामत्र संस्थितं भासाध्यासितो भगवान्हरिः ।\nआह चोत्थाय ब्रह्माणं हसन्मां मधुरं सकृत्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001096025, "chapter_id": 21096, "verse_number": "२-१-७-२६", "content_sanskrit": "विष्णुरुवाच ।\nस्वागतं स्वागतं वत्स पितामह महाद्युते ।\nनिर्भयो भव दास्येऽहं सर्वान्कामान्न संशयः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001096026, "chapter_id": 21096, "verse_number": "२-१-७-२७", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा स्मितपूर्वं सुरर्षभः ।\nरजसा बद्धवैरश्च तमवोचं जनार्दनम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001096027, "chapter_id": 21096, "verse_number": "२-१-७-२८", "content_sanskrit": "ब्रह्मोवाच ।\nभाषसे वत्स वत्सेति सर्वसंहारकारणम् ।\nमामिहाति स्मितं कृत्वा गुरुश्शिष्यमिवानघ॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001096028, "chapter_id": 21096, "verse_number": "२-१-७-२९", "content_sanskrit": "कर्तारं जगतां साक्षात्प्रकृतेश्च प्रवर्तकम् ।\nसनातनमजं विष्णुं विरिंचिं विष्णुसंभवम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001096029, "chapter_id": 21096, "verse_number": "२-१-७-३०", "content_sanskrit": "विश्वात्मानं विधातारं धातारम्पंकजेक्षणम् ।\nकिमर्थं भाषसे मोहाद्वक्तुमर्हसि सत्वरम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001096030, "chapter_id": 21096, "verse_number": "२-१-७-३१", "content_sanskrit": "वेदो मां वक्ति नियमात्स्वयंभुवमजं विभुम् ।\nपितामहं स्वराजं च परमेष्ठिनमुत्तमम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001096031, "chapter_id": 21096, "verse_number": "२-१-७-३२", "content_sanskrit": "इत्याकर्ण्य हरिर्वाक्यं मम क्रुद्धो रमापतिः ।\nसोऽपि मामाह जाने त्वां कर्तारमिति लोकतः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001096032, "chapter_id": 21096, "verse_number": "२-१-७-३३", "content_sanskrit": "विष्णुरुवाच ।\nकर्तुं धर्त्तुं भवानंगादवतीर्णो ममाव्ययात् ।\nविस्मृतोऽसि जगन्नाथं नारायणमनामयम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001096033, "chapter_id": 21096, "verse_number": "२-१-७-३४", "content_sanskrit": "पुरुषं परमात्मानं पुरुहूतं पुरुष्टुतम् ।\nविष्णुमच्युतमीशानं विश्वस्य प्रभवोद्भवम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001096034, "chapter_id": 21096, "verse_number": "२-१-७-३५", "content_sanskrit": "नारायणं महाबाहुं सर्वव्याप कमीश्वरम् ।\nमन्नाभिपद्मतस्त्वं हि प्रसूतो नात्र संशयः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001096035, "chapter_id": 21096, "verse_number": "२-१-७-३६", "content_sanskrit": "तवापराधो नास्त्यत्र त्वयि मायाकृतं मम ।\nशृणु सत्यं चतुर्वक्त्र सर्वदेवेश्वरो ह्यहम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001096036, "chapter_id": 21096, "verse_number": "२-१-७-३७", "content_sanskrit": "कर्ता हर्ता च भर्ता च न मयास्तिसमो विभुः ।\nअहमेव परं ब्रह्म परं तत्त्वं पितामह॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001096037, "chapter_id": 21096, "verse_number": "२-१-७-३८", "content_sanskrit": "अहमेव परं ज्योतिः परमात्मा त्वहं विभुः ।\nअद्य दृष्टं श्रुतं सर्वं जगत्यस्मिंश्चराचरम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001096038, "chapter_id": 21096, "verse_number": "२-१-७-३९", "content_sanskrit": "तत्तद्विद्धि चतुर्वक्त्र सर्वं मन्मयमित्यथ ।\nमया सृष्टं पुरा व्यक्तं चतुर्विंशतितत्त्वकम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001096039, "chapter_id": 21096, "verse_number": "२-१-७-४०", "content_sanskrit": "नित्यं तेष्वणवो बद्धास्सृष्टक्रोधभयादयः ।\nप्रभावाच्च भवानंगान्यनेकानीह लीलया॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001096040, "chapter_id": 21096, "verse_number": "२-१-७-४१", "content_sanskrit": "सृष्टा बुद्धिर्मया तस्यामहंकारस्त्रिधा ततः ।\nतन्मात्रं पंकजं तस्मान्मनोदेहेन्द्रियाणि च॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001096041, "chapter_id": 21096, "verse_number": "२-१-७-४२", "content_sanskrit": "आकाशादीनि भूतानि भौतिकानि च लीलया ।\nइति बुद्ध्वा प्रजानाथ शरणं व्रज मे विधे॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001096042, "chapter_id": 21096, "verse_number": "२-१-७-४३", "content_sanskrit": "अहं त्वां सर्वदुःखेभ्यो रक्षिष्यामि न संशयः ।\nब्रह्मोवाच ।\nइति श्रुत्वा वचस्तस्य ब्रह्मा क्रोधसमन्वितः ।\nको वा त्वमिति संभर्त्स्माब्रुवं मायाविमोहितः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001096043, "chapter_id": 21096, "verse_number": "२-१-७-४४", "content_sanskrit": "किमर्थं भाषसे भूरि वह्वनर्थकरं वचः ।\nनेश्वरस्त्वं परब्रह्म कश्चित्कर्ता भवेत्तव॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001096044, "chapter_id": 21096, "verse_number": "२-१-७-४५", "content_sanskrit": "मायया मोहितश्चाहं युद्धं चक्रे सुदारुणम् ।\nहरिणा तेन वै सार्द्धं शंकरस्य महाप्रभोः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001096045, "chapter_id": 21096, "verse_number": "२-१-७-४६", "content_sanskrit": "एवं मम हरेश्चासीत्संगरो रोमहर्षणः ।\nप्रलयार्णवमध्ये तु रजसा बद्धवैरयोः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001096046, "chapter_id": 21096, "verse_number": "२-१-७-४७", "content_sanskrit": "एतस्मिन्नंतरे लिंगमभवच्चावयोः पुरः ।\nविवादशमनार्थं हि प्रबोधार्थं तथाऽऽवयोः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001096047, "chapter_id": 21096, "verse_number": "२-१-७-४८", "content_sanskrit": "ज्लामालासहस्राढ्यं कालानलशतोपमम् ।\nक्षयवृद्धि विनिर्मुक्तमादिमध्यांतवर्जितम्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001096048, "chapter_id": 21096, "verse_number": "२-१-७-४९", "content_sanskrit": "अनौपम्यमनिर्देश्यमव्यक्तं विश्वसंभवम् ।\nतस्य ज्वालासहस्रेण मोहितो भगवान्हरिः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001096049, "chapter_id": 21096, "verse_number": "२-१-७-५०", "content_sanskrit": "मोहितं चाह मामत्र किमर्थं स्पर्द्धसेऽधुना ।\nआगतस्तु तृतीयोऽत्र तिष्ठतां युद्धमावयोः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001096050, "chapter_id": 21096, "verse_number": "२-१-७-५१", "content_sanskrit": "कुत एवात्र संभूतः परीक्षावो ऽग्निसंभवम् ।\nअधो गमिष्याम्यनलस्तंभस्यानुपमस्य च॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001096051, "chapter_id": 21096, "verse_number": "२-१-७-५२", "content_sanskrit": "परीक्षार्थं प्रजानाथ तस्य वै वायुवेगतः ।\nभवानूर्द्ध्वं प्रयत्नेन गंतुमर्हति सत्वरम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001096052, "chapter_id": 21096, "verse_number": "२-१-७-५३", "content_sanskrit": "ब्रह्मोवाच ।\nएवं व्याहृत्य विश्वात्मा स्वरूपमकरोत्तदा ।\nवाराहमहप्याशु हंसत्वं प्राप्तवान्मुने॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001096053, "chapter_id": 21096, "verse_number": "२-१-७-५४", "content_sanskrit": "तदा प्रभृति मामाहुर्हंसहंसो विराडिति ।\nहंसहंसेति यो ब्रूयात्स हंसोऽथ भविष्यति॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001096054, "chapter_id": 21096, "verse_number": "२-१-७-५५", "content_sanskrit": "सुश्वे ह्यनलप्रख्यो विश्वतः पक्षसंयुतः ।\nमनोनिलजवो भूत्वा गत्वोर्द्ध्वं चोर्द्ध्वतः पुरा॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001096055, "chapter_id": 21096, "verse_number": "२-१-७-५६", "content_sanskrit": "नारायणोऽपि विश्वात्मा सुश्वेतो ह्यभवत्तदा ।\nदश योजनविस्तीर्णं शतयोजनमायतम्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001096056, "chapter_id": 21096, "verse_number": "२-१-७-५७", "content_sanskrit": "मेरुपर्वतवर्ष्माणं गौरतीक्ष्णोग्रदंष्ट्रिणम् ।\nकालादित्यसमाभासं दीर्घघोणं महास्वनम्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001096057, "chapter_id": 21096, "verse_number": "२-१-७-५८", "content_sanskrit": "ह्रस्वपादं विचित्रांगं जैत्रं दृढमनौपमम् ।\nवाराहाकारमास्थाय गतवांस्तदधौ जवात्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001096058, "chapter_id": 21096, "verse_number": "२-१-७-५९", "content_sanskrit": "एवम्बर्षसहस्रं च चरन्विष्णुरधो गतः ।\nतथाप्रभृति लोकेषु श्वेतवाराहसंज्ञकः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001096059, "chapter_id": 21096, "verse_number": "२-१-७-६०", "content_sanskrit": "कल्पो बभूव देवर्षे नराणां कालसंज्ञकः ।\nबभ्राम बहुधा विष्णुः प्रभविष्णुरधोगतः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001096060, "chapter_id": 21096, "verse_number": "२-१-७-६१", "content_sanskrit": "नापश्यदल्पमप्यस्य मूलं लिंगस्य सूकरः ।\nतावत्कालं गतश्चोर्द्ध्वमहमप्यरिसूदन॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001096061, "chapter_id": 21096, "verse_number": "२-१-७-६२", "content_sanskrit": "सत्वरं सर्वयत्नेन तस्यान्तं ज्ञातुमिच्छया ।\nश्रान्तो न दृष्ट्वा तस्यांतमहं कालादधोगतः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001096062, "chapter_id": 21096, "verse_number": "२-१-७-६३", "content_sanskrit": "तथैव भगवान्विष्णुश्चांतं कमललोचनः ।\nसर्वदेवनिभस्तूर्णमुत्थितस्स महावपुः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001096063, "chapter_id": 21096, "verse_number": "२-१-७-६४", "content_sanskrit": "समागतो मया सार्द्धं प्रणिपत्य भवं मुहुः ।\nमायया मोहितश्शंभोस्तस्थौ संविग्नमानसः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001096064, "chapter_id": 21096, "verse_number": "२-१-७-६५", "content_sanskrit": "पृष्ठतः पार्श्वतश्चैव ह्यग्रतः परमेश्वरम् ।\nप्रणिपत्य मया सार्द्धं सस्मार किमिदं त्विति॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001096065, "chapter_id": 21096, "verse_number": "२-१-७-६६", "content_sanskrit": "अनिर्देश्यं च तद्रूपमनाम कर्मवर्जितम् ।\nअलिंगं लिंगतां प्राप्तं ध्यानमार्गेप्यगोचरम्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001096066, "chapter_id": 21096, "verse_number": "२-१-७-६७", "content_sanskrit": "स्वस्थं चित्तं तदा कृत्वा नमस्कार परायणो ।\nबभूवतुरुभावावामहं हरिरपि ध्रुवम्॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001096067, "chapter_id": 21096, "verse_number": "२-१-७-६८", "content_sanskrit": "जानीवो न हि ते रूपं योऽसियोऽसि महाप्रभो ।\nनमोऽस्तु ते महेशान रूपं दर्शय नौ त्वरन्॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001096068, "chapter_id": 21096, "verse_number": "२-१-७-६९", "content_sanskrit": "एवं शरच्छतान्यासन्नमस्कारं प्रकुर्वतोः ।\nआवयोर्मुनिशार्दूल मदमास्थितयोस्तदा॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]