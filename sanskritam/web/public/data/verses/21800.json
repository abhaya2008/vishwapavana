[{"id": 7001800000, "chapter_id": 21800, "verse_number": "२-६१-१", "content_sanskrit": "वसुरुवाच ।\nएवं तदा विधिसुते कृष्णं रामेण संगतम् ।\nसुभद्रां च महाभागाः संस्तुवंति मुदान्विताः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001800001, "chapter_id": 21800, "verse_number": "२-६१-२", "content_sanskrit": "देवो ऊचुः ।\nजय जय लोकपाल जय पद्मनाभ भूधरणा ।\nजय जय चादिदेव बहुकारणा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001800002, "chapter_id": 21800, "verse_number": "२-६१-३", "content_sanskrit": "जय जय वासुदेव जय सच्चरण सत्करण ।\nजय जय दिव्यमीन जयत्रिदशवर ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001800003, "chapter_id": 21800, "verse_number": "२-६१-४", "content_sanskrit": "जय जय जलधिशयन जय जय योगेश जय देवधरा ।\nजय जय विश्वमूर्ते जय चक्रधरा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001800004, "chapter_id": 21800, "verse_number": "२-६१-५", "content_sanskrit": "जय  जय भूतनाथ जय श्रीनिवास जय जय योगिवर ।\nजय जय सूर्यनेत्र जय देव वराह ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001800005, "chapter_id": 21800, "verse_number": "२-६१-६", "content_sanskrit": "जय जय कैटभारे जय जय वेदवर ।\nजय जय कूर्मरूप जय यज्ञवर ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001800006, "chapter_id": 21800, "verse_number": "२-६१-७", "content_sanskrit": "जय जय कमलनाभ जय शैलधर ।\nजय जय योगेश जय वेगधर ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001800007, "chapter_id": 21800, "verse_number": "२-६१-८", "content_sanskrit": "जय जय विश्वमूर्ते जय चक्रधर ।\nजय जय भूतनाथ जय धरणीधर ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001800008, "chapter_id": 21800, "verse_number": "२-६१-९", "content_sanskrit": "जय जय शेषशायिञ्जय पीतवास ।\nजय सोमकान्त जय योगवास जय जय ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001800009, "chapter_id": 21800, "verse_number": "२-६१-१०", "content_sanskrit": "दहनचक्र जय धर्मवास जय जय ।\nगुणनिधान जय श्रीनिवास जय जय ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001800010, "chapter_id": 21800, "verse_number": "२-६१-११", "content_sanskrit": "गरुडासन जय सुखनिवास जय जय ।\nजय जय धर्मकांत जय जय मतिनिवास ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001800011, "chapter_id": 21800, "verse_number": "२-६१-१२", "content_sanskrit": "जय जय गहनगेहनिवास ।\nजय जय योगिगम्य जय मखनिवास ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001800012, "chapter_id": 21800, "verse_number": "२-६१-१३", "content_sanskrit": "जय जय वेदवेद्य जय शांतिकर ।\nजय जय योकिचिंत्य जय पुष्टिकर ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001800013, "chapter_id": 21800, "verse_number": "२-६१-१४", "content_sanskrit": "जय जय ज्ञानमूर्ते जय कमलाकर ।\nजय जय भाववेद्य जय मुक्तिकर ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001800014, "chapter_id": 21800, "verse_number": "२-६१-१५", "content_sanskrit": "जय विमलदेह जय जय सत्त्वनिलय ।\nजय जय गुणसमूह जय जय यज्ञकर ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001800015, "chapter_id": 21800, "verse_number": "२-६१-१६", "content_sanskrit": "जय जय गुणविहीन जय जय मोक्षकर ।\nजय जय भूहिरण्य जय जय कांतियुत ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001800016, "chapter_id": 21800, "verse_number": "२-६१-१७", "content_sanskrit": "जय लोकशरण जय जय लक्ष्मीपते ।\nजय पंकजाक्ष जय जय सृष्टिकर ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001800017, "chapter_id": 21800, "verse_number": "२-६१-१८", "content_sanskrit": "जय योगयुत जयातसीकुसुमश्यामदेह ।\nजय जय समुद्राविष्टदेह जय लक्ष्मीपंकजभोगदेह ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001800018, "chapter_id": 21800, "verse_number": "२-६१-१९", "content_sanskrit": "जय जय भक्तिभावन लोकगेय ।\nजय लोककांत जय परमशांत ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001800019, "chapter_id": 21800, "verse_number": "२-६१-२०", "content_sanskrit": "जय जय परमसार जयचक्रधर ।\nजय भोगियुत जय नीलांबर ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001800020, "chapter_id": 21800, "verse_number": "२-६१-२१", "content_sanskrit": "जय सांख्यनुत जय कलुषहर ।\nजय कृष्ण जगन्नाथ जय संकर्षणानुज ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001800021, "chapter_id": 21800, "verse_number": "२-६१-२२", "content_sanskrit": "जय जय पद्मपलाशाक्ष जय वांछितफलप्रद ।\nजय मालावृतोरस्क जय चक्रगदाधर ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001800022, "chapter_id": 21800, "verse_number": "२-६१-२३", "content_sanskrit": "जय पद्मालयाकांत जय विष्णो नमोऽस्तु ते ।\nएवं स्तुत्वा तदा देवाः शक्राद्या दृष्टमानसाः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001800023, "chapter_id": 21800, "verse_number": "२-६१-२४", "content_sanskrit": "सिद्धचारणगंधर्वा ये चान्ये स्वर्गवासिनः ।\nदृष्ट्वा स्तुत्वा नमस्कृत्य तद्गतेनान्तरात्मना ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001800024, "chapter_id": 21800, "verse_number": "२-६१-२५", "content_sanskrit": "कृष्णं रामं सुभद्रां च यांति स्वं स्वं निवेशनम् ।\nकपिलाशतदानेन यत्फलं पुष्करे स्मृतम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001800025, "chapter_id": 21800, "verse_number": "२-६१-२६", "content_sanskrit": "तत्फलं कृष्णमालोक्य मंचस्थं सहलायुधम् ।\nकन्याशतप्रदानेन यत्फलं समुदाहृतम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001800026, "chapter_id": 21800, "verse_number": "२-६१-२७", "content_sanskrit": "तत्फलं कृष्णमालोक्य मंचस्थँ लभते नरः ।\nशतनिष्कसुवर्णेन भूमिदानेन यत्फलम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001800027, "chapter_id": 21800, "verse_number": "२-६१-२८", "content_sanskrit": "तत्फलं चान्नदानेन सर्वातिथ्येन यत्फलम् ।\nवृषोत्सर्गेण विधिवद् ग्रीष्मे तोयप्रदानतः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001800028, "chapter_id": 21800, "verse_number": "२-६१-२९", "content_sanskrit": "तिलधेनुप्रदानेन गजाश्वरथदानतः ।\nचांद्रायणेन चीर्णेन तथा मासोपवासतः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001800029, "chapter_id": 21800, "verse_number": "२-६१-३०", "content_sanskrit": "यत्फलं सर्वतीर्थेषु व्रतैर्दानैश्च यत्फलम् ।\nससुभद्रौ रामकृष्णौ तल्लभेद्वीक्ष्यमंचगौ ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001800030, "chapter_id": 21800, "verse_number": "२-६१-३१", "content_sanskrit": "तस्मान्नरोऽथवा नारी पश्येत्तं पुरुषोत्तमम् ।\nस्नानशेषेण कृष्णस्य तोयेन यदि मोहिनि ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001800031, "chapter_id": 21800, "verse_number": "२-६१-३२", "content_sanskrit": "वंध्या मृतप्रजा वापि दुर्भगाग्रहपीडिताः ।\nराक्षसाद्यैर्गुहीता वा तथा रोगैश्च संहताः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001800032, "chapter_id": 21800, "verse_number": "२-६१-३३", "content_sanskrit": "सद्यस्ताः शुद्धिमायांति विधिना ह्यभिषेचिताः ।\nप्राप्नुंवितीप्सितान्कामान्यान्यान्वांछंति सुप्रभे ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001800033, "chapter_id": 21800, "verse_number": "२-६१-३४", "content_sanskrit": "पुण्यानि यानि तोयानि संत्यन्यानि धरातले ।\nतानि स्नातावशेषस्य कलां नार्हंति षोडशीम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001800034, "chapter_id": 21800, "verse_number": "२-६१-३५", "content_sanskrit": "तस्मात्स्नानावशेषेण जलेन जलशायिनः ।\nअभ्युक्षेत्सर्वगात्राणि सर्वकामप्रदेन च ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001800035, "chapter_id": 21800, "verse_number": "२-६१-३६", "content_sanskrit": "स्नातं पश्यंति ये कृष्णं व्रजंतं दक्षिणामुखम् ।\nब्रह्महत्यादिभिः पापेर्मुच्यंते ते न संशयः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001800036, "chapter_id": 21800, "verse_number": "२-६१-३७", "content_sanskrit": "शास्त्रेषु यत्कलं प्रोक्तं त्रिः प्रदक्षिणया भुवः ।\nदृष्ट्वा नरो लभेत्कृष्णं तत्फल दक्षिणामुखम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001800037, "chapter_id": 21800, "verse_number": "२-६१-३८", "content_sanskrit": "तीर्थयात्राफलं यत्तु पृथिव्यां समुदाहतम् ।\nदृष्ट्वा यांतं लभेत्कृष्णं तत्फलं दक्षिणामुखम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001800038, "chapter_id": 21800, "verse_number": "२-६१-३९", "content_sanskrit": "&nbsp;गंगाद्वारे च कुब्जाम्ने कुरुक्षेत्रेऽर्कपर्वणि ।\nपुष्करादिषु चान्येषु यत्फलं स्नानतः स्मृतम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001800039, "chapter_id": 21800, "verse_number": "२-६१-४०", "content_sanskrit": "यत्फलं दक्षिणास्यं तु कृष्णं यांतं निरीक्ष्य च ।\nअत किं बहुनोक्तेन यत्फलं पुण्यकर्मणः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001800040, "chapter_id": 21800, "verse_number": "२-६१-४१", "content_sanskrit": "वेदशास्त्रपुराणेषु भारते संहितादिषु ।\nतत्फलं वीक्ष्य दक्षास्यौ सुभद्रौ बलकेशवौ ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001800041, "chapter_id": 21800, "verse_number": "२-६१-४२", "content_sanskrit": "गुंडिचामंडपं यांतं ये पश्यंति रथे स्थितम् ।\nसभद्रं सबलं कृष्णं ते यांति भवनं हरेः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001800042, "chapter_id": 21800, "verse_number": "२-६१-४३", "content_sanskrit": "गुंडिचायानसमये फाल्गुन्यां विषुवे तथा ।\nसकृद्यात्रां नरः कृत्वा विष्णुलोकं प्रगच्छति ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001800043, "chapter_id": 21800, "verse_number": "२-६१-४४", "content_sanskrit": "यावतीः कुरुते मर्त्त्यो यात्राः श्रीपुरुषोत्तमे ।\nतावत्कल्पं विष्णुलोके वसेदिति विनिश्चयः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001800044, "chapter_id": 21800, "verse_number": "२-६१-४५", "content_sanskrit": "यात्रा द्वादश संपूर्णा यदा स्युर्विधिनंदिनि ।\nतदा प्रतिष्ठां कुर्वीत विधिना पापनाशिनि ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001800045, "chapter_id": 21800, "verse_number": "२-६१-४६", "content_sanskrit": "ज्येष्ठमासि सिते पक्षे ह्येकादश्यां समाहितः ।\nगत्वा जलाशयं पुण्यमाचम्य प्रयतः शुचिः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001800046, "chapter_id": 21800, "verse_number": "२-६१-४७", "content_sanskrit": "आवाह्य सर्वतीर्थानि ध्यात्वा नारायणं तथा ।\nततः स्नानं प्रकुर्वीत विधिबोधितवर्त्मना ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001800047, "chapter_id": 21800, "verse_number": "२-६१-४८", "content_sanskrit": "स्नात्वा सम्यक्ततो देवानृषींश्चापि पितॄन्स्वकान् ।\nसंतर्पयेत्तथान्यांश्च नामगोत्रोक्तिपूर्वकम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001800048, "chapter_id": 21800, "verse_number": "२-६१-४९", "content_sanskrit": "उत्तीर्य वाससी धौते निर्मले परिधाय च ।\nउपस्पृश्य विधानेन तथोपकस्थाय भास्करम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001800049, "chapter_id": 21800, "verse_number": "२-६१-५०", "content_sanskrit": "वेदमातरमावर्त्य पुण्यामष्टोत्तरं शतम् ।\nसौरमन्त्रांस्तथा चान्यांस्त्रिः परीत्य नमेद्रविम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001800050, "chapter_id": 21800, "verse_number": "२-६१-५१", "content_sanskrit": "वेदोक्तं त्रिषु वर्णेषु स्नानं जप्यमुदाहृतम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001800051, "chapter_id": 21800, "verse_number": "२-६१-५२", "content_sanskrit": "स्त्रीशूद्रयोर्वरारोहे वेदोक्तविधिवर्जितम् ।\nततो व्रजेन्मंदिरस्थं भक्त्या श्रीपुरुषोत्तमम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001800052, "chapter_id": 21800, "verse_number": "२-६१-५३", "content_sanskrit": "प्रक्षाल्य हस्तौ पादौ च उपस्पृश्य यथाविधि ।\nघृतेन स्नापयेद्देवं क्षीरेण तदनंतरम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001800053, "chapter_id": 21800, "verse_number": "२-६१-५४", "content_sanskrit": "मधुगंधोदकेनापि तीर्थचंदनवारिणा ।\nततो वस्त्रयुगं श्रेष्ठं भक्त्या तं परिधापयेत् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001800054, "chapter_id": 21800, "verse_number": "२-६१-५५", "content_sanskrit": "चंदनागुरुकर्पूरैः कुंकुमेन विलेपयेत् ।\nपूजयेत्परया भक्त्या पद्मैश्च पुरषोत्तमम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001800055, "chapter_id": 21800, "verse_number": "२-६१-५६", "content_sanskrit": "संपूज्यैवं जगन्नाथं भुक्तिमुक्तिप्रदं हरिम् ।\nधूपं चागुरुसंयुक्तं देहे देवस्य चाग्रतः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001800056, "chapter_id": 21800, "verse_number": "२-६१-५७", "content_sanskrit": "गुग्गुलं च सुनिष्पूतं दहेदूघृतसमन्वितम् ।\nदीपं प्रज्वालयेद्भक्त्या यथाशक्ति घृतेन वै ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001800057, "chapter_id": 21800, "verse_number": "२-६१-५८", "content_sanskrit": "अन्याँश्च दीपकान्दद्याद्द्वादर्शैव समाहितः ।\nगोघृतेन तु देवेशि तिलतैलेन वा पुनः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001800058, "chapter_id": 21800, "verse_number": "२-६१-५९", "content_sanskrit": "नैवेद्यं पायसा पूपशष्कुलीवेटकानि च ।\nमोदकं फाणिकं चान्यत्फलानि च निवेदयेत् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001800059, "chapter_id": 21800, "verse_number": "२-६१-६०", "content_sanskrit": "एवं पंचोपचारेण संपूज्य पुरुषोत्तमम् ।\nॐ नमः पुरुषोत्तमायेति जपेदष्टोत्तरं शतम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001800060, "chapter_id": 21800, "verse_number": "२-६१-६१", "content_sanskrit": "ततः प्रसादयेद्देवं दंडवत्प्रणिपत्य चत ।\nततोऽचर्येद्गुरुं भक्त्या पुष्पवस्त्रानुलेपनैः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001800061, "chapter_id": 21800, "verse_number": "२-६१-६२", "content_sanskrit": "नानयोरंतरं यस्माद्विद्यते विधिर्नंदिनि ।\nदेवस्योपरि कुर्वीत मंडपं सुसमाहितः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001800062, "chapter_id": 21800, "verse_number": "२-६१-६३", "content_sanskrit": "नानापुष्पैः सुविशदं विचित्रं मंडलं पुरः ।\nकृत्वावधारणं पश्चाज्जागरं कारयेन्निशि ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001800063, "chapter_id": 21800, "verse_number": "२-६१-६४", "content_sanskrit": "कथां च वासुदेवस्य गीतिकां चापि कारयेत् ।\nध्यायन्पठन्स्तुवन्देवं प्रणयेद्रजनीं बुधः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001800064, "chapter_id": 21800, "verse_number": "२-६१-६५", "content_sanskrit": "ततः प्रभाते विमले द्वादश्यां द्वादशैव तु ।\nनिमंत्रयेद्व्रतस्नातान्ब्रह्मणान्वेदपारगान् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001800065, "chapter_id": 21800, "verse_number": "२-६१-६६", "content_sanskrit": "इतिहासपुराणज्ञाञ्छो त्रियान्संयतेंद्रियान् ।\nस्नात्वा सम्यग्विधानेन धौतवासा  जितेंद्रियः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001800066, "chapter_id": 21800, "verse_number": "२-६१-६७", "content_sanskrit": "स्नापयेत्पूर्ववद्भक्त्या तत्रस्थं पुरुषोत्तमम् ।\nगंधैः पुष्पैः स्तूपहारैर्नैवेर्द्यैदैर्पिकैस्तथा ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001800067, "chapter_id": 21800, "verse_number": "२-६१-६८", "content_sanskrit": "उपचारैर्बहुविधैः प्रणिपातैः प्रदक्षिणैः ।\nजाप्यस्तुतिनमस्कारैर्गीतवाद्यैर्मनोहरैः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001800068, "chapter_id": 21800, "verse_number": "२-६१-६९", "content_sanskrit": "संपूज्यैवं जगन्नाथं ब्राह्मणान्पूजयेत्ततः ।\nद्वादशैव तु गास्तेभ्यो दत्त्वा कनकमेव च ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001800069, "chapter_id": 21800, "verse_number": "२-६१-७०", "content_sanskrit": "छत्रोपानद्युगं चार्प्य कांस्यपात्रं च भक्तितः ।\nततस्तान्भोजयेद्विप्रान्भोज्यंम पायसपूर्वकम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001800070, "chapter_id": 21800, "verse_number": "२-६१-७१", "content_sanskrit": "पक्वान्नं भक्ष्यभोज्यं च सगुडं शर्करान्वितम् ।\nततो भुक्त्वा सुसंतृप्तान्ब्राह्मणान्सुस्थमानसान् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001800071, "chapter_id": 21800, "verse_number": "२-६१-७२", "content_sanskrit": "द्वादशैवोदकुंभांश्च ग्राहयेत्तान्समोदकान् ।\nदक्षिणां च यथाशक्ति विष्णुतुल्यं विरिंचिजे ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001800072, "chapter_id": 21800, "verse_number": "२-६१-७३", "content_sanskrit": "सुवर्णवस्त्रगोधान्यैर्द्रव्यैश्चन्यैर्वरैर्बुधः ।\nसंपूज्य तान्नमस्कृत्य इमं मंत्रमुदीरयेत् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001800073, "chapter_id": 21800, "verse_number": "२-६१-७४", "content_sanskrit": "सर्वव्यीपी जगन्नाथः शंखचक्रगदाधरः ।\nअनादिनिधनो देवः प्रीयतां पुरुषोत्तमः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001800074, "chapter_id": 21800, "verse_number": "२-६१-७५", "content_sanskrit": "इत्युच्चार्य ततो विप्रांस्त्रिः परिक्रम्य सादरम् ।\nप्रणम्य शिरसा भक्त्या साचार्यांस्तान्विसर्जयेत् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001800075, "chapter_id": 21800, "verse_number": "२-६१-७६", "content_sanskrit": "ततस्तान्ब्राह्मणान्भक्त्या चासीमांतमनुव्रजेत् ।\nअनुव्रज्य तु तान्विप्रान्नमस्कृत्य निवर्त्य च ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001800076, "chapter_id": 21800, "verse_number": "२-६१-७७", "content_sanskrit": "बांधवैः स्वजनैर्युक्तस्ततो भुंजीतवाग्यतः ।\nएवं कृत्वा नरः सम्यङ् नारी वा लभते फलम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001800077, "chapter_id": 21800, "verse_number": "२-६१-७८", "content_sanskrit": "अश्वमेधसहस्रस्य राजसूयशतस्य च ।\nअतीतं शतमुद्धृत्य पुरुषाणां नरोत्तमः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001800078, "chapter_id": 21800, "verse_number": "२-६१-७९", "content_sanskrit": "भविष्यच्च शतं देवि दिव्यरूपधरोऽव्ययः ।\nसर्वलक्षणसंपन्नः सर्वालंकारभूषितः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001800079, "chapter_id": 21800, "verse_number": "२-६१-८०", "content_sanskrit": "सर्वकामसमृद्धात्मा गुणरूपवयोऽन्वितः ।\nस्तूयमानोऽथ गंधर्वैरप्सरोभिः समंततः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001800080, "chapter_id": 21800, "verse_number": "२-६१-८१", "content_sanskrit": "विमानेनार्कवर्णेन कामगेन स्थिरेण च ।\nपताकाध्वजयुक्तेन शतसूर्यप्रभेण च ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001800081, "chapter_id": 21800, "verse_number": "२-६१-८२", "content_sanskrit": "उद्योतयन्दिशः सर्वा आकाशे विगतक्लमः ।\nयुवा महाबलो धीमान्विष्णुलोकं स गच्छति ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001800082, "chapter_id": 21800, "verse_number": "२-६१-८३", "content_sanskrit": "तत्र कल्पशतं यावद्भुङ्कते भोगान्यथेप्सितान् ।\nस्तुतो मुनिवरैर्देवि तिष्ठेश्च विगतज्वरः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001800083, "chapter_id": 21800, "verse_number": "२-६१-८४", "content_sanskrit": "यथा देवो जगन्नाथः शंखचक्रगदाधरः ।\nतथाऽसौ मुदितो देवि धृत्वा रूपं चतुर्भुजम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001800084, "chapter_id": 21800, "verse_number": "२-६१-८५", "content_sanskrit": "भुक्त्वा तत्र वरान्भोगान्क्रीडित्वा सुचिरं सति ।\nतदंते ब्रह्मसदनमायात्यखिलकामदम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7001800085, "chapter_id": 21800, "verse_number": "२-६१-८६", "content_sanskrit": "सिद्धविद्याधरैश्चापि शोभितं सुरकिन्नरैः ।\nकालं नवतिकल्पं तु तत्र भुक्त्वा सुखं नरः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7001800086, "chapter_id": 21800, "verse_number": "२-६१-८७", "content_sanskrit": "रुद्रलोकं समायाति मुखदं सेवितं सुरैः ।\nसिद्धविद्याधरै र्यक्षैर्भूषितं दैत्यदानवैः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7001800087, "chapter_id": 21800, "verse_number": "२-६१-८८", "content_sanskrit": "अशीतिकल्पकालं तु तत्र भुक्त्वा सुखं नरः ।\nतदंते याति गोलोकं सर्वभोगसमन्वितम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7001800088, "chapter_id": 21800, "verse_number": "२-६१-८९", "content_sanskrit": "सुरसिद्धाप्सरोभिश्च शोभितं सुमनोहरम् ।\nतत्र सप्ततिकल्पं तु भुक्त्वा भोगानभीप्सितान् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7001800089, "chapter_id": 21800, "verse_number": "२-६१-९०", "content_sanskrit": "पश्चादायाति वै लोकं प्राजापत्यमनुत्तमम् ।\nषष्टिकल्पं सुखं तत्र भुक्त्वा नानाविधं मुदा ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7001800090, "chapter_id": 21800, "verse_number": "२-६१-९१", "content_sanskrit": "तदंते शक्रभवनं नानाश्चर्यं समाव्रजेत् ।\nआगत्य तत्र पंचाशत्कल्पं भुक्त्वा सुखं नरः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7001800091, "chapter_id": 21800, "verse_number": "२-६१-९२", "content_sanskrit": "प्रपद्यतेऽमरगृहान्विमानैः समलङ्कृतान् ।\nचत्वारिंशत्कत्ल्पकालं भोगान्भुक्त्वा सुदुर्लभान् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7001800092, "chapter_id": 21800, "verse_number": "२-६१-९३", "content_sanskrit": "नाक्षत्रं लोकमायाति नानासौख्य समन्वितम् ।\nतत्र भुक्त्वा वरान्भोगांस्त्रिंशत्कल्पं यथेप्सितान् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7001800093, "chapter_id": 21800, "verse_number": "२-६१-९४", "content_sanskrit": "तस्माद्गच्छति तं लोकं शशांकस्य विरिंचिजे ।\nयत्र तिष्ठति सोमोऽसौ सर्वदेवैरलंकृतः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7001800094, "chapter_id": 21800, "verse_number": "२-६१-९५", "content_sanskrit": "तत्र विंशतिकल्पं तु भुक्त्वा भोगं सुदुर्लभम् ।\nआदित्यस्य ततो लोकमायाति सुरपूजितम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7001800095, "chapter_id": 21800, "verse_number": "२-६१-९६", "content_sanskrit": "तत्र भुक्त्वा शुभान्भोगन्दशकल्पं सुनिर्वृतः ।\nतस्मादायाति भवनं गंधर्वाणां सुदुर्लभम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7001800096, "chapter_id": 21800, "verse_number": "२-६१-९७", "content_sanskrit": "तत्र भोगान्समस्तांश्च कल्पमेकं यथासुखम् ।\nभुक्त्वा चायाति मेदिन्यां राजा भवति धार्मिकः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7001800097, "chapter_id": 21800, "verse_number": "२-६१-९८", "content_sanskrit": "चक्रवर्ती महावीर्यो गुणैः सर्वैरलंकृतः ।\nकृत्वा राज्यं तु धर्मेण यज्ञैरिष्ट्वा सदक्षिणैः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7001800098, "chapter_id": 21800, "verse_number": "२-६१-९९", "content_sanskrit": "तदंते योगिनां लोकं गत्वा मोक्षप्रदं शिवम् ।\nतत्र भुक्त्वा वरान्भोगान्यावदाभूतसंप्लवम् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7001800099, "chapter_id": 21800, "verse_number": "२-६१-१००", "content_sanskrit": "तस्मात्पुनरिहायातो जायते योगिनां कुले ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7001800100, "chapter_id": 21800, "verse_number": "२-६१-१०१", "content_sanskrit": "प्रवरे वैष्णवे भद्रे दुर्लभे साधुसंमते ।\nचतुर्वेदी विप्रवरो ब्रह्मयज्ञपरः सति ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7001800101, "chapter_id": 21800, "verse_number": "२-६१-१०२", "content_sanskrit": "वैष्णवं योगमासाद्य कैवल्यं मोक्षमाप्नुयात् ।\nएवं यात्राफलं तुभ्यं प्रोक्तं श्रीपुरुषोत्तमे ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7001800102, "chapter_id": 21800, "verse_number": "२-६१-१०३", "content_sanskrit": "भुक्तिमुक्तिप्रदं नॄणां किमन्यच्छ्रोतुमिच्छसि ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7001800103, "chapter_id": 21800, "verse_number": "२-६१-१०४", "content_sanskrit": "इति श्रीबृहन्नारदीयपुराणोत्तरभागे मोहिनीवसुसंवादे पुरुषोत्तमक्षेत्रमाहात्म्ये पुरुषोत्तमक्षेत्रयात्रा फलवर्णनं", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7001800104, "chapter_id": 21800, "verse_number": "२-६१-१०५", "content_sanskrit": "नामैकषष्टितमोऽध्यायः ॥६१ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}]