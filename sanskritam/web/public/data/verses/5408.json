[{"id": 2206841, "chapter_id": 5408, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2206842, "chapter_id": 5408, "verse_number": "१", "content_sanskrit": "एवमुक्तस्तु राजाऽसौ धृतराष्ट्रेण धीमता ।\nतूष्णीं बभूव मेधावी तमुवाचाथ केशवः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2206843, "chapter_id": 5408, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2206844, "chapter_id": 5408, "verse_number": "२", "content_sanskrit": "अतीव मनसा शोको ध्रियमाणो नराधिप ।\nसन्तापयति चैतस्य पूर्वप्रेतान् पितामहान्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2206845, "chapter_id": 5408, "verse_number": "३", "content_sanskrit": "यजस्व विविधैर्यज्ञैर्बहुभिश्चाप्तदक्षिणैः ।\nदेवांस्तर्पय सोमेन स्वधया च पितॄनपि ।\nअतिथीनन्नपानेन कामैरन्यैरकिञ्चनात्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2206846, "chapter_id": 5408, "verse_number": "४", "content_sanskrit": "त्वद्विधस्य महाबुद्धे नैतदद्योपपद्यते ।\nविदितं वेदितव्यं ते कर्तव्यमपि ते कृतम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2206847, "chapter_id": 5408, "verse_number": "५", "content_sanskrit": "श्रुताश्च राजधर्मास्ते भीष्माद् भागीरथीसुतात् ।\nकृष्णद्वैपायनाच्चापि नारदाद् विदुरात् तथा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2206848, "chapter_id": 5408, "verse_number": "६", "content_sanskrit": "नेमामर्हसि मूढानां मतिं त्वमनुवर्तितुम् ।\nपितृपैतामहं वृत्तमास्थाय धुरमुद्वह\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2206849, "chapter_id": 5408, "verse_number": "७", "content_sanskrit": "युक्तं हि यशसा क्षात्रं स्वर्गं प्राप्नुमसंशयम् ।\nन हि कश्चन शूराणां निहतोऽत्र पराङ्मुखः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2206850, "chapter_id": 5408, "verse_number": "८", "content_sanskrit": "त्यज शोकं महाराज भवितव्यं हि तत् तथा ।\nन शक्यास्ते पुनर्द्रष्टुं त्वया येऽस्मिन् रणे हताः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2206851, "chapter_id": 5408, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2206852, "chapter_id": 5408, "verse_number": "९", "content_sanskrit": "एतावदुक्त्वा गोविन्दो धर्मराजं युधिष्ठिरम् ।\nविरराम तदा राजा पुनर्वचनमब्रवीत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2206853, "chapter_id": 5408, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2206854, "chapter_id": 5408, "verse_number": "१०", "content_sanskrit": "गोविन्द मयि या प्रीतिः तव सा विदिता मया ।\nसौहृदेन तथा प्रेम्णा सदा मामनुकम्पसे\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2206855, "chapter_id": 5408, "verse_number": "११", "content_sanskrit": "प्रियं तु मे स्यात् सुमहत् कृतं चक्रगदाधर\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2206856, "chapter_id": 5408, "verse_number": "१२", "content_sanskrit": "श्रीमन् प्रीतेन मनसा सर्वयादवनन्दन ।\nयदि मामनुजानीयाद् भवान् गन्तुं तपोवनम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2206857, "chapter_id": 5408, "verse_number": "१३", "content_sanskrit": "कृतकृत्यो भविष्यामीति मे निश्चिता मतिः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2206858, "chapter_id": 5408, "verse_number": "१४", "content_sanskrit": "न हि शान्तिं प्रपश्यामि घातयित्वा पितामहम् ।\nकर्णं च पुरुषव्याघ्रं सङ्ग्रामेष्वपलायिनम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2206859, "chapter_id": 5408, "verse_number": "१५", "content_sanskrit": "कर्मणा येन मुच्येयं तस्मात् पापादरिन्दम ।\nकर्म तत् त्वं विधत्स्वेह न हि शुद्ध्यति मे मनः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2206860, "chapter_id": 5408, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2206861, "chapter_id": 5408, "verse_number": "१६", "content_sanskrit": "तमेवंवादिनं व्यासस्ततः प्रोवाच तं प्रभुः ।\nसान्त्वयन् सुमहातेजाः वेदवेदाङ्गतत्त्ववित्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2206862, "chapter_id": 5408, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2206863, "chapter_id": 5408, "verse_number": "१७", "content_sanskrit": "सुकृता ते मतिस्तात पुनर्बाल्येन मुह्यसि ।\nकिमाकाशे वयं सर्वे प्रलपामो मुहुर्मुहुः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2206864, "chapter_id": 5408, "verse_number": "१८", "content_sanskrit": "विदिताः क्षत्रधर्मास्ते येषां युद्धेन जीविका\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2206865, "chapter_id": 5408, "verse_number": "१९", "content_sanskrit": "यथा वै कामजां मायां परित्यक्तुं त्वमर्हसि ।\nतथा तु कुर्वन् नृपतिर्नानुबन्धेन युज्यते\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2206866, "chapter_id": 5408, "verse_number": "२०", "content_sanskrit": "यथा च वै त्वं नृपते शोकबन्धाद् विमोक्ष्यसे ।\nमोक्षधर्माश्च निखिला यथावत् संश्रुतास्त्वया\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2206867, "chapter_id": 5408, "verse_number": "२१", "content_sanskrit": "असकृच्चैव सन्देहाश्छिन्नास्ते कामजा मया ।\nअश्रद्दधानो दुर्मेधा लुप्तस्मृतिरसि ध्रुवम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2206868, "chapter_id": 5408, "verse_number": "२२", "content_sanskrit": "मैवं भूस्त्वं न ते युक्तमिदमज्ञानमीदृशम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2206869, "chapter_id": 5408, "verse_number": "२३", "content_sanskrit": "प्रायश्चित्तानि सर्वाणि विदितानि च तेऽनघ ।\nयुद्धधर्माश्च ते सर्वे दानधर्माश्च ते श्रुताः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2206870, "chapter_id": 5408, "verse_number": "२४", "content_sanskrit": "स कथं सर्वधर्मज्ञः सर्वागमविशारद ।\nपरिमुह्यसि भूयस्त्वमज्ञानादिव भारत\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2206871, "chapter_id": 5408, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्याम् आश्वमेधिकपर्वणि व्यासवचनं नाम द्वितीयोऽध्यायः ॥२॥\nअश्वमेधपर्वणि द्वितीयोऽध्यायः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]