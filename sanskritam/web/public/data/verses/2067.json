[{"id": 2048409, "chapter_id": 2067, "verse_number": "६-११६-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2048410, "chapter_id": 2067, "verse_number": "६-११६-१", "content_sanskrit": "अभिमन्युर्महाराज तव पुत्रमयोधयत्।\nमहत्या सेनया युक्तं भीष्महेतोः पराक्रमी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2048411, "chapter_id": 2067, "verse_number": "६-११६-२", "content_sanskrit": "दुर्योधनो रणे कार्षिं नवभिर्नतपर्वभिः।\nआजघानोरसि क्रुद्धः पुनश्चैनं त्रिभिः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2048412, "chapter_id": 2067, "verse_number": "६-११६-३", "content_sanskrit": "तस्य शक्तिं रणे कार्ष्णिर्मृत्योर्जिह्वामिवायसीम्।\nप्रेषयामास संक्रुद्धो दुर्योधनरथं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2048413, "chapter_id": 2067, "verse_number": "६-११६-४", "content_sanskrit": "तामापतन्तीं सहसा घोररूपां विशांपते ।\nद्विधा चिच्छेद ते पुत्रः क्षुरप्रेण महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2048414, "chapter_id": 2067, "verse_number": "६-११६-५", "content_sanskrit": "तां शक्तिं पतितां दृष्ट्वा कार्ष्णिः परमकोपनः ।\nदुर्योधनं त्रिभिर्बाणैर्बाह्वोरुरसि चार्पयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2048415, "chapter_id": 2067, "verse_number": "६-११६-६", "content_sanskrit": "पुनश्चैनं शरैर्घोरैराजघान स्तनान्तरे ।\nदशभिर्भरतश्रेष्ठ दुर्योधनममर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2048416, "chapter_id": 2067, "verse_number": "६-११६-७", "content_sanskrit": "तद्युद्धमभवद्धोरं चित्ररूपं च भारत।\nईक्षितृप्रीतितजननं सर्वपार्थिवपूजितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2048417, "chapter_id": 2067, "verse_number": "६-११६-८", "content_sanskrit": "भीष्मस्य निधनार्थाय पार्थस्य विजयाय च।\nयुयुधाते रणे वीरौ सौभद्रकुरुपुङ्गवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2048418, "chapter_id": 2067, "verse_number": "६-११६-९", "content_sanskrit": "सात्यकिं रभसं युद्धे द्रौणिर्ब्राह्मणपुङ्गवः ।\nआजघानोरसि क्रुद्धो नाराचेन परंतपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2048419, "chapter_id": 2067, "verse_number": "६-११६-१०", "content_sanskrit": "शैनेयोऽपि गुरोः पुत्रं सर्वमर्मसु भारत।\nअताडयदमेयात्मा नवभिः कङ्कपत्रिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2048420, "chapter_id": 2067, "verse_number": "६-११६-११", "content_sanskrit": "अश्वत्थामा तु समरे सात्यकिं नवभिः शरैः ।\nत्रिंशता च पुनस्तूर्णं बाह्वोरुरसि चार्पयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2048421, "chapter_id": 2067, "verse_number": "६-११६-१२", "content_sanskrit": "सोऽतिविद्धो महेष्वासो द्रोणपुत्रेण सात्यकिः ।\nद्रोणपुत्रं त्रिभिर्बाणैराजघान महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2048422, "chapter_id": 2067, "verse_number": "६-११६-१३", "content_sanskrit": "पौरवो धृष्टकेतुं च शरैराच्छाद्य संयुगे ।\nबहुधा दारयांचक्रे महेष्वासं महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2048423, "chapter_id": 2067, "verse_number": "६-११६-१४", "content_sanskrit": "तथैव पौरवं युद्धे धृष्टकेतुर्महारथः।\nत्रिंशता निशितैर्बाणैर्विव्याधाशु महाभुजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2048424, "chapter_id": 2067, "verse_number": "६-११६-१५", "content_sanskrit": "पौरवस्तु धनुश्छित्त्वा धृष्टकेतोर्महारथः ।\nननाद बलवन्नादं विव्याध च शितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2048425, "chapter_id": 2067, "verse_number": "६-११६-१६", "content_sanskrit": "सोऽन्यत्कार्मुकमादाय पौरवं निशितैः शरैः ।\nआजघान महाराज त्रिसप्तत्या शिलीमुखैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2048426, "chapter_id": 2067, "verse_number": "६-११६-१७", "content_sanskrit": "तौ तु तत्र महेष्वासौ महामात्रौ महारथौ ।\nमहता शरवर्षेण परस्परमवर्षताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2048427, "chapter_id": 2067, "verse_number": "६-११६-१८", "content_sanskrit": "अन्योन्यस्य धनुश्छित्त्वा हयान्हत्वा च भारत।\nविरथावसियुद्धाय समीयतुरमर्षणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2048428, "chapter_id": 2067, "verse_number": "६-११६-१९", "content_sanskrit": "आर्षभे चर्मणी चित्रे शतचन्द्रपुरस्कृते ।\nतारकाशतचित्रे च निस्त्रिंशौ सुमहाप्रभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2048429, "chapter_id": 2067, "verse_number": "६-११६-२०", "content_sanskrit": "प्रगृह्य विमलौ राजंस्तावन्योन्यमभिद्रुतौ ।\nवासितासंगमे यत्तौ सिंहाविव महावने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2048430, "chapter_id": 2067, "verse_number": "६-११६-२१", "content_sanskrit": "मण्डलानि विचित्राणि गतप्रत्यागतानि च।\nचेरतुर्दर्शयन्तौ च प्रार्थयन्तौ परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2048431, "chapter_id": 2067, "verse_number": "६-११६-२२", "content_sanskrit": "पौरवो धृष्टकेतुं तु शङ्खदेशे महासिना ।\nताडयामास संक्रुद्धस्तिष्ठतिष्ठेति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2048432, "chapter_id": 2067, "verse_number": "६-११६-२३", "content_sanskrit": "चेदिराजोऽपि समरे पौरवं पुरुषर्षभम् ।\nआजघान शिताग्रेण जत्रुदेशे महासिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2048433, "chapter_id": 2067, "verse_number": "६-११६-२४", "content_sanskrit": "तावन्योन्यं महाराज समासाद्य महाहवे ।\nअन्योन्यवेगाभिहतौ निपेततुररिंदमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2048434, "chapter_id": 2067, "verse_number": "६-११६-२५", "content_sanskrit": "ततः स्वरथमारोप्य पौरवं तनयस्तव ।\nजयत्सेनो रथेनाजावपोवाह रणाजिरात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2048435, "chapter_id": 2067, "verse_number": "६-११६-२६", "content_sanskrit": "धृष्टकेतु तु समरे माद्रीपुत्रः प्रतापवान् ।\nअपोवाह रणे क्रुद्धः सहदेवः पराक्रमी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2048436, "chapter_id": 2067, "verse_number": "६-११६-२७", "content_sanskrit": "चित्रसेनः सुशर्माणं विद्ध्वा बहुभिरायसैः ।\nपुनर्विव्याध तं षष्ट्या पुनश्च नवभि शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2048437, "chapter_id": 2067, "verse_number": "६-११६-२८", "content_sanskrit": "सुशर्मा तु रणे क्रुद्धस्तव पुत्रं विशांपते ।\nदशमिर्दशभिश्चैव विव्याध निशितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2048438, "chapter_id": 2067, "verse_number": "६-११६-२९", "content_sanskrit": "चित्रसेनश्च तं राजंस्त्रिंशता नतपर्वभिः ।\nआजघान रमे क्रुद्धः स च तं प्रत्यविध्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2048439, "chapter_id": 2067, "verse_number": "६-११६-३०", "content_sanskrit": "भीष्मस्य समरे राजन्यशो मानं च वर्धयन् ।\nसौभद्रो राजपुत्रं तु बृहद्बलमयोधयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2048440, "chapter_id": 2067, "verse_number": "६-११६-३१", "content_sanskrit": "पार्थहेतोः पराक्रान्तो भीष्मस्य निधनं प्रति।\nआर्जुनिं कोसलेन्द्रस्तु विद्ध्वा पञ्चभिरायसैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2048441, "chapter_id": 2067, "verse_number": "६-११६-३२", "content_sanskrit": "पुनर्विव्याध विंशत्या शरैः सन्नतपर्वभिः ।\nसौभद्रः कोसलेन्द्रं तु विव्याधाष्टभिरायसैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2048442, "chapter_id": 2067, "verse_number": "६-११६-३३", "content_sanskrit": "नाकम्पयत संग्रामे विव्याध च पुनः शरैः ।\nकौसल्यस्य धनुश्चापि पुनश्चिच्छेद फाल्गुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2048443, "chapter_id": 2067, "verse_number": "६-११६-३४", "content_sanskrit": "आजघान शरैश्चापि त्रिंशता कङ्कपत्रिभिः ।\nसोऽन्यत्कार्मुकमादाय राजपुत्रो बृहद्बलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2048444, "chapter_id": 2067, "verse_number": "६-११६-३५", "content_sanskrit": "फाल्गुनिं समरे क्रुद्धो विव्याध बहुभिः शरैः ।\nतयोर्युद्धं समभवद्भीष्महेतोः परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2048445, "chapter_id": 2067, "verse_number": "६-११६-३६", "content_sanskrit": "संरब्धयोर्महाराज समरे चित्रयोधिनोः ।\nयथा देवासुरे युद्धे बलिवासवयोरभूत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2048446, "chapter_id": 2067, "verse_number": "६-११६-३७", "content_sanskrit": "भीमसेनो गजानीकं योधयन्बह्वशोभत ।\nयथा शक्रो वज्रपाणिर्दारयन्पर्वतोत्तमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2048447, "chapter_id": 2067, "verse_number": "६-११६-३८", "content_sanskrit": "ते वध्यमाना भीमेन मात्गा गिरिसन्निभाः ।\nनिपेतुरुर्व्यां सहिता नादयन्तो वसुधराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2048448, "chapter_id": 2067, "verse_number": "६-११६-३९", "content_sanskrit": "गिरिमात्रा हि ते नागा भिन्नाञ्जनचयोपमाः ।\nविरेजुर्वसुधां प्राप्ता विकीर्णा इव पर्वताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2048449, "chapter_id": 2067, "verse_number": "६-११६-४०", "content_sanskrit": "युधिष्ठिरो महेष्वासो मद्रराजानमाहवे ।\nमहत्या सेनया गुप्तं पीडयामास संगतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2048450, "chapter_id": 2067, "verse_number": "६-११६-४१", "content_sanskrit": "मद्रेश्वरश्च समरे धर्मपुत्रं महारथम् ।\nपीडयामास संरब्धो भीष्महेतोः पराक्रमी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2048451, "chapter_id": 2067, "verse_number": "६-११६-४२", "content_sanskrit": "विराटं सैन्धवो राजा विद्ध्वा सन्नतपर्वभिः ।\nनवभिः सायकैस्तीक्ष्णैस्त्रिंशता पुनरार्पयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2048452, "chapter_id": 2067, "verse_number": "६-११६-४३", "content_sanskrit": "विराटश्च महाराज सैन्धवं वाहिनीपतिः ।\nत्रिंशद्भिर्निशितैर्बाणैराजघान स्तनान्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2048453, "chapter_id": 2067, "verse_number": "६-११६-४४", "content_sanskrit": "चित्रकार्मुकनिस्त्रिंशौ चित्रवर्मायुधध्वजौ ।\nरेजतुश्चित्ररूपौ तौ संग्रामे मत्स्यसैन्धवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2048454, "chapter_id": 2067, "verse_number": "६-११६-४५", "content_sanskrit": "द्रोणः पाञ्चालपुत्रेण समागम्य महारणे ।\nमहासमुदयं चक्रे शरैः सन्नतपर्वभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2048455, "chapter_id": 2067, "verse_number": "६-११६-४६", "content_sanskrit": "ततो द्रोणो महाराज पार्षतस्य महद्धनुः ।\nछित्त्वा पञ्चाशतेषूंश्च पार्षतं प्रति सृष्टवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2048456, "chapter_id": 2067, "verse_number": "६-११६-४७", "content_sanskrit": "सोऽन्यत्कार्मुकमादाय पार्षतः परवीरहा।\nद्रोणस्य मिषतो युद्धे प्रेषयामास सायकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2048457, "chapter_id": 2067, "verse_number": "६-११६-४८", "content_sanskrit": "ताञ्छराञ्छरघातेन चिच्छेद स महारथः ।\nद्रोणो द्रुपदपुत्राय प्राहिणोत्पञ्च सायकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2048458, "chapter_id": 2067, "verse_number": "६-११६-४९", "content_sanskrit": "ततः क्रुद्धो महाराज पार्षतः परवीरहा ।\nद्रोणाय चिक्षेप गदां यमदण्डोपमां रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2048459, "chapter_id": 2067, "verse_number": "६-११६-५०", "content_sanskrit": "तामापतन्तीं सहसा हेमपट्टविभूषिताम्।\nशरैः पञ्चाशता द्रोणो वारयामास संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2048460, "chapter_id": 2067, "verse_number": "६-११६-५१", "content_sanskrit": "सा छिन्ना बहुधा राजन्द्रोगचापच्युतैः शरैः ।\nचूर्णीकृता विशीर्यन्ती पपात वसुधातले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2048461, "chapter_id": 2067, "verse_number": "६-११६-५२", "content_sanskrit": "गदां विनिहतां दृष्ट्वा पार्षतः शत्रुतापनः ।\nद्रोणाय शक्तिं चिक्षेप सर्वपारशवीं शुभाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2048462, "chapter_id": 2067, "verse_number": "६-११६-५३", "content_sanskrit": "तां द्रोणो नवभिर्बाणैश्चिच्छेद युधि भारत।\nपार्षतं च महेष्वासं पीजयामास संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2048463, "chapter_id": 2067, "verse_number": "६-११६-५४", "content_sanskrit": "एवमेतन्महायुद्धं द्रोणपार्षतयोरभूत्।\nभीष्मं प्रति महाराज घोररूपं भयानकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2048464, "chapter_id": 2067, "verse_number": "६-११६-५५", "content_sanskrit": "अर्जुनः प्राप्य गाङ्गेयं पीडयन्निशितैः शरैः ।\nअभ्यद्रवत संयत्तो वने मत्तमिव द्विपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2048465, "chapter_id": 2067, "verse_number": "६-११६-५६", "content_sanskrit": "प्रत्युद्ययौ च तं राजा भगदत्तः प्रतापवान् ।\nत्रिधा भिन्नेन नागेन मदान्धेन महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2048466, "chapter_id": 2067, "verse_number": "६-११६-५७", "content_sanskrit": "तमापतन्तं सहसा महेन्द्रगजसन्निभम् ।\nपरं यत्नं समस्थाय बीभत्सुः प्रत्यपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2048467, "chapter_id": 2067, "verse_number": "६-११६-५८", "content_sanskrit": "ततो गजगतो राजा भगदत्तः प्रतापवान् ।\nअर्जुनं शरवर्षेण वारयामास संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2048468, "chapter_id": 2067, "verse_number": "६-११६-५९", "content_sanskrit": "अर्जुनस्तु ततो नागमायान्तं रजतोपमैः ।\nविमलैरायसैस्तीक्ष्णैरविध्यत महारणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2048469, "chapter_id": 2067, "verse_number": "६-११६-६०", "content_sanskrit": "शिखण्डिनं च कौन्तेयो याहियाहीत्यचोदयत्।\nभीष्मं प्रति महाराज जह्येनमिति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2048470, "chapter_id": 2067, "verse_number": "६-११६-६१", "content_sanskrit": "प्राग्ज्योतिषस्ततो हित्वा पाण्डवं पाण्डुपूर्वज।\nप्रययौ त्वरितो राजन्द्रुपदस्य रथं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2048471, "chapter_id": 2067, "verse_number": "६-११६-६२", "content_sanskrit": "ततोऽर्जुनो महाराज भीष्ममभ्यद्रवद्द्रुतम्।\nशिखण्डिनं पुरस्कृत्य ततो युद्धमवर्तत ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2048472, "chapter_id": 2067, "verse_number": "६-११६-६३", "content_sanskrit": "ततस्ते तावकाः शूराः पाण्डवं रभसं युधि ।\nसमभ्यधावन्क्रोशन्तस्तदद्भुतमिवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2048473, "chapter_id": 2067, "verse_number": "६-११६-६४", "content_sanskrit": "नानाविधान्यनीकानि पुत्राणां ते जनाधिप ।\nअर्जुनो व्यधमत्काले दिवीवाभ्राणि मारुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2048474, "chapter_id": 2067, "verse_number": "६-११६-६५", "content_sanskrit": "शिखण्डी तु समासाद्य भरतानां पितामहम्।\nइषुभिस्तूर्णमव्यग्रो बहुभिः स समाचिनोत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2048475, "chapter_id": 2067, "verse_number": "६-११६-६६", "content_sanskrit": "रथाग्न्यगारश्चापार्चिरशिशक्तिगदेन्धनः ।\nशरसङ्घमहाज्वालः क्षत्रियान्समरेऽदहत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2048476, "chapter_id": 2067, "verse_number": "६-११६-६७", "content_sanskrit": "यथाऽग्निः सुमहानिद्धः कक्षे चरति सानिलः।\nतथा जज्वाल भीष्मोऽपि दिव्यान्यस्त्राण्युदीरयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2048477, "chapter_id": 2067, "verse_number": "६-११६-६८", "content_sanskrit": "सोमकांश्च रणे भीष्मो जघ्ने पार्थपदानुगान् ।\nन्यवारयत तत्सैन्यं पाण्डवस्य महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2048478, "chapter_id": 2067, "verse_number": "६-११६-६९", "content_sanskrit": "सुवर्णपुङ्खैरिषुभिः शितैः सन्नतपर्वभिः ।\nनादयन्स दिशो भीष्मः प्रदिशश्च महाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2048479, "chapter_id": 2067, "verse_number": "६-११६-७०", "content_sanskrit": "पातयन्रथिनो राजन्हयांश्च सह सादिभिः ।\nमुण्डतालवनानीव चकार स रथव्रजान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2048480, "chapter_id": 2067, "verse_number": "६-११६-७१", "content_sanskrit": "निर्मनुष्यान्रथान्राजन्गजानश्वांश्च संयुगे ।\nचकार समरे भीष्मः सर्वशस्त्रभृतां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2048481, "chapter_id": 2067, "verse_number": "६-११६-७२", "content_sanskrit": "तस्य ज्यातलनिर्घोषं विस्फूर्जितमिवाशनेः ।\nनिशम्य सर्वतो राजन्समकम्पन्त सैनिकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2048482, "chapter_id": 2067, "verse_number": "६-११६-७३", "content_sanskrit": "अघोमा न्यपतन्बाणाः पितुस्ते मनुजेश्वर ।\nनासञ्जन्त शरीरेषु भीष्मचापच्युताः शराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2048483, "chapter_id": 2067, "verse_number": "६-११६-७४", "content_sanskrit": "निर्मनुष्यान्रथान्राजन्सुयुक्ताञ्जवनैर्हयैः ।\nवातायमानानद्राक्षं ध्रियमाणान्विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2048484, "chapter_id": 2067, "verse_number": "६-११६-७५", "content_sanskrit": "चेदिकाशिकरूशानां सहस्राणि चतुर्दश ।\nमहारथाः समाख्याताः कुलपुत्रास्तनुत्यजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2048485, "chapter_id": 2067, "verse_number": "६-११६-७६", "content_sanskrit": "अपरावर्तिनः शूराः सुवर्णविकृतध्वजाः ।\nसंग्रामे भीष्ममासाद्य सवाजिरथकुञ्जराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2048486, "chapter_id": 2067, "verse_number": "६-११६-७७", "content_sanskrit": "जग्मुस्ते परलोकाय व्यादितास्यमिवान्तकम्।\nन तत्रासीद्रणे राजन्सोमकानां महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2048487, "chapter_id": 2067, "verse_number": "६-११६-७८", "content_sanskrit": "यः संप्राप्य रणे भीष्मं जीविते स्म मनो दधे ।\nतांश्च सर्वान्रणे योधान्प्रेतराजपुरं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2048488, "chapter_id": 2067, "verse_number": "६-११६-७९", "content_sanskrit": "नीतानमन्यन्त जना दृष्ट्वा भीष्मस्य विक्रमम् ।\nन कश्चिदेनं समरे प्रत्युद्याति महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2048489, "chapter_id": 2067, "verse_number": "६-११६-८०", "content_sanskrit": "ऋते पाण्डुसुतं वीरं श्वेताश्वं कृष्णसारथिम् ।\nशिखण्डिनं च समरे पाञ्चाल्यममितौजसम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2048490, "chapter_id": 2067, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि दशमदिवसयुद्धे षोडशाधिकशततमोऽध्यायः ॥\nMahabharata - Bhishma Parva - Chapter Footnotes\n६-११६-२७ चित्रसेन इति। पाण्डवपक्षीयः सुशर्मायमपरो वार्धक्षेमिर्नतु त्रैगर्तः ॥ ६-११६-४५ समुदयं संग्रामम्। भवेत्समुदयः सङ्घे संयुगे च समुद्रमे इति मेदिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}]