[{"id": 7003985000, "chapter_id": 23985, "verse_number": "३-१-४८-१", "content_sanskrit": "श्रीसूत उवाच ।\nरामनाथं समुद्दिश्य कथां पापविनाशिनीम् ।\nप्रवक्ष्यामि मुनिश्रेष्ठाः शृणुध्वं सुसमाहिताः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003985001, "chapter_id": 23985, "verse_number": "३-१-४८-२", "content_sanskrit": "पांड्यदेशाधिपो राजा पुरासीच्छंकराभिधः ।\nब्रह्मण्यः सत्यसंधश्च यायजूकश्च धार्मिकः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003985002, "chapter_id": 23985, "verse_number": "३-१-४८-३", "content_sanskrit": "वेदवेदांगतत्त्वज्ञः परसैन्यविदारणः ।\nचतुरोऽप्याश्रमान्वर्णान्धर्मतः परिपालयन्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003985003, "chapter_id": 23985, "verse_number": "३-१-४८-४", "content_sanskrit": "वैदिकाचारनिरतः पुराणस्मृतिपारगः ।\nशिवविष्ण्वर्चको नित्यमन्यदैवतपूजकः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003985004, "chapter_id": 23985, "verse_number": "३-१-४८-५", "content_sanskrit": "महादानप्रदो नित्यं ब्राह्मणानां महात्मनाम् ।\nमृगयार्थं ययौ धीमान्स कदाचित्तपोवनम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003985005, "chapter_id": 23985, "verse_number": "३-१-४८-६", "content_sanskrit": "सिंहव्याघ्रेभमहिष क्रूरसत्वभयंकरम् ।\nझिल्लिकाभीषणरवं सरीसृपसमाकुलम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003985006, "chapter_id": 23985, "verse_number": "३-१-४८-७", "content_sanskrit": "भीमश्वापदसंपूर्णं दावानलभयंकरम् ।\nमहारण्यं प्रविश्याथ शंकरो राजशेखरः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003985007, "chapter_id": 23985, "verse_number": "३-१-४८-८", "content_sanskrit": "अनेकसैनिकोपेत आखेटिकुलसंकुलः ।\nपादुकागूढचरणो रक्तोष्णीषो हरिच्छदः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003985008, "chapter_id": 23985, "verse_number": "३-१-४८-९", "content_sanskrit": "बद्धगोधांगुलित्राणो धृतकोदण्डसायकः ।\nकक्ष्याबद्धमहाखङ्गः श्वेताश्ववरमास्थितः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003985009, "chapter_id": 23985, "verse_number": "३-१-४८-१०", "content_sanskrit": "सुवेषधारी सन्नद्धः पत्तिसंघसमावृतः ।\nकांतारेषु च सर्वेषु पर्वतेषु गुहासु च॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003985010, "chapter_id": 23985, "verse_number": "३-१-४८-११", "content_sanskrit": "समुत्तीर्ण महास्रोता युवा सिंहपराक्रमः ।\nविचचार बलैः साकं दरीषु मृगयन्मृगान्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003985011, "chapter_id": 23985, "verse_number": "३-१-४८-१२", "content_sanskrit": "बध्यतां वध्यतामेष याति वेगान्मृगो वने ।\nएवं वदत्सु सैन्येषु स्वयमुत्प्लुत्य शंकरः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003985012, "chapter_id": 23985, "verse_number": "३-१-४८-१३", "content_sanskrit": "मृगं हंति महाराजो विगाह्य विपिनस्थलीम् ।\nसिंहान्वराहान्महिषान्कुञ्जराच्छरभांस्तथा॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003985013, "chapter_id": 23985, "verse_number": "३-१-४८-१४", "content_sanskrit": "विनिघ्नन्स मृगानन्यान्वन्याञ्छंकरभूपतिः ।\nकुत्रचिद्विपिनोद्देशे दरीमध्यनिवासिनम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003985014, "chapter_id": 23985, "verse_number": "३-१-४८-१५", "content_sanskrit": "व्याघ्रचर्मधरं शांतं मुनिं नियतमानसम् ।\nव्याघ्रबुद्ध्या जघानाशु शरेणानतपर्वणा॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003985015, "chapter_id": 23985, "verse_number": "३-१-४८-१६", "content_sanskrit": "अतिवेगेन विप्रेंद्रास्तत्पत्नीं च ससायकः ।\nनिजघान पतिप्राणां निविष्टां पत्युरंतिके॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003985016, "chapter_id": 23985, "verse_number": "३-१-४८-१७", "content_sanskrit": "विलोक्य मातापितरौ तत्पुत्रो निहतौ वने ।\nरुरोद भृशदुःखार्तो विललाप च कातरः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003985017, "chapter_id": 23985, "verse_number": "३-१-४८-१८", "content_sanskrit": "भोस्तात मातर्मां हित्वा युवां यातौ क्व वाधुना ।\nअहं कुत्र गमिष्यामि को वा मे शरणं भवेत्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003985018, "chapter_id": 23985, "verse_number": "३-१-४८-१९", "content_sanskrit": "को मामध्यापयेद्वेदाञ्छास्त्रं वा पाठयेत्पितः ।\nअंब मे भोजनं का वा दास्यते सोपदेशकम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003985019, "chapter_id": 23985, "verse_number": "३-१-४८-२०", "content_sanskrit": "आचाराञ्च्छिक्षयेत्को वा तात त्वयि मृतेऽधुना ।\nअंब बालं प्रकुपितं का वा मामुपलाप येत्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003985020, "chapter_id": 23985, "verse_number": "३-१-४८-२१", "content_sanskrit": "युवां निरागसावद्य केन पापेन सायकैः ।\nनिहतौ वै तपोनिष्ठौ मत्प्राणौ मद्गुरू वने॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003985021, "chapter_id": 23985, "verse_number": "३-१-४८-२२", "content_sanskrit": "एवं तयोः सुतो विप्रा मुक्तकण्ठं रुरोद वै ।\nअथ प्रलपितं श्रुत्वा शंकरो विपिने चरन्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003985022, "chapter_id": 23985, "verse_number": "३-१-४८-२३", "content_sanskrit": "तच्छब्दाभिमुखः सद्यः प्रययौ स दरीमुखम् ।\nतत्रत्या मुनयोऽप्याशु समागच्छंस्तमाश्रमम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003985023, "chapter_id": 23985, "verse_number": "३-१-४८-२४", "content_sanskrit": "ते दृष्ट्वा मुनयः सर्वे शरेण निहतं मुनिम् ।\nतत्पत्नीं च हतां विप्रा राजानं च धनुर्धरम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003985024, "chapter_id": 23985, "verse_number": "३-१-४८-२५", "content_sanskrit": "विलपंतं सुतं चापि विलोक्य भृशविह्वलाः ।\nपुत्रमाश्वासयामासुर्मा रोदीरिति कातरम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003985025, "chapter_id": 23985, "verse_number": "३-१-४८-२६", "content_sanskrit": "मुनय ऊचुः ।\nआढ्ये वापि दरिद्रे वा मूर्खे वा पंडितेऽपि वा ।\nपीने वाथ कृशे वापि समवर्ती परेतराट्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003985026, "chapter_id": 23985, "verse_number": "३-१-४८-२७", "content_sanskrit": "वने वा नगरे ग्रामे पर्वते वा स्थलांतरे ।\nमृत्योर्वशे प्रयातव्यं सर्वैरपि हि जंतुभिः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003985027, "chapter_id": 23985, "verse_number": "३-१-४८-२८", "content_sanskrit": "वत्स नित्यं च गर्भस्थैर्जातैरपि च जंतुभिः ।\nयुवभिः स्थविरैः सर्वैर्यातव्यं यमपत्तनम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003985028, "chapter_id": 23985, "verse_number": "३-१-४८-२९", "content_sanskrit": "वर्णिभिश्च गृहस्थैश्च वानप्रस्थैश्च भिक्षुभिः ।\nकाले प्राप्ते त्वयं देहस्त्यक्तव्यो द्विजपुत्रक॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003985029, "chapter_id": 23985, "verse_number": "३-१-४८-३०", "content_sanskrit": "ब्राह्मणैः क्षत्रियैर्वैश्यैः शूद्रैरपि च संकरैः ।\nयातव्यं प्रेतनिलये द्विजपुत्र महामते॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003985030, "chapter_id": 23985, "verse_number": "३-१-४८-३१", "content_sanskrit": "देवाश्च मुनयो यक्षा गंधर्वोरगराक्षसाः ।\nअन्ये च जंतवः सर्वे ब्रह्मविष्णुहरादयः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003985031, "chapter_id": 23985, "verse_number": "३-१-४८-३२", "content_sanskrit": "सर्वे यास्यंति विलयं न त्वं शोचितुमर्हसि ।\nअद्वयं सच्चिदानंदं यद्ब्रह्मोपनिषद्गतम्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003985032, "chapter_id": 23985, "verse_number": "३-१-४८-३३", "content_sanskrit": "न तस्य विलयो जन्म वर्धनं चापि सत्तम ।\nमलभांडे नवद्वारे पूयासृक्छोणितालये॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003985033, "chapter_id": 23985, "verse_number": "३-१-४८-३४", "content_sanskrit": "देहेऽस्मिन्बुद्बुदाकारे कृमियूथसमाकुले ।\nकामक्रोधभयद्रोहमोहमात्सर्यकारिणि॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003985034, "chapter_id": 23985, "verse_number": "३-१-४८-३५", "content_sanskrit": "परदारपरक्षेत्रपरद्रव्यैकलोलुपे ।\nहिंसासूयाशुचिव्याप्ते विष्ठामूत्रैकभाजने॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003985035, "chapter_id": 23985, "verse_number": "३-१-४८-३६", "content_sanskrit": "यः कुर्याच्छोभनधियं स मूढः स च दुर्मतिः ।\nबहुच्छिद्रघटाकारे देहेऽस्मिन्नशुचौ सदा॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003985036, "chapter_id": 23985, "verse_number": "३-१-४८-३७", "content_sanskrit": "वायोरवस्थितिः किं स्यात्प्राणाख्यस्य चिरं द्विज ।\nअतो मा कुरु शोकं त्वं जननीं पितरं प्रति॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003985037, "chapter_id": 23985, "verse_number": "३-१-४८-३८", "content_sanskrit": "तौ स्वकर्मवशाद्यातौ गृहं त्यक्त्वा त्विदं क्वचित् ।\nतव कर्मवशात्त्वं च तिष्ठस्यस्मिन्महीतले॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003985038, "chapter_id": 23985, "verse_number": "३-१-४८-३९", "content_sanskrit": "यदा कर्मक्षयस्ते स्यात्तदा त्वं च मरिष्यसि ।\nमरिष्यमाणप्रेतो हि मृतप्रेतस्य शोचति॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003985039, "chapter_id": 23985, "verse_number": "३-१-४८-४०", "content_sanskrit": "यस्मिन्काले समुत्पन्नौ तव माता पिता तथा ।\nन तस्मिंस्त्वं समुत्पन्नस्ततो भिन्ना गतिर्हि वः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003985040, "chapter_id": 23985, "verse_number": "३-१-४८-४१", "content_sanskrit": "यदि तुल्या गतिस्ते स्यात्ताभ्यां सह महामते॥  ।\nतर्हि त्वयापि यातव्यं मृतौ यत्र हि तौ गतौ॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003985041, "chapter_id": 23985, "verse_number": "३-१-४८-४२", "content_sanskrit": "मृतानां बांधवा ये तु मुंचंत्यश्रूणि भूतले ।\nपिबंत्यश्रूणि तान्यद्धा मृताः प्रेताः परत्र वै॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003985042, "chapter_id": 23985, "verse_number": "३-१-४८-४३", "content_sanskrit": "अतः शोकं परित्यज्य धृतिं कृत्वा समाहितः ।\nअनयोः प्रेतकार्याणि कुरु त्वं वैदिकानि तु॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003985043, "chapter_id": 23985, "verse_number": "३-१-४८-४४", "content_sanskrit": "शरघातान्मृतावेतौ यस्मात्ते जननी पिता ।\nअतस्तद्दोषशांत्यर्थमस्थीन्यादाय वै तयोः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003985044, "chapter_id": 23985, "verse_number": "३-१-४८-४५", "content_sanskrit": "रामनाथशिवक्षेत्रे रामसेतौ विमुक्तिदे ।\nस्थापयस्व तथा श्राद्धं सपिंडीकरणादिकम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003985045, "chapter_id": 23985, "verse_number": "३-१-४८-४६", "content_sanskrit": "तत्रैव कुरु शुद्ध्यर्थं तयोर्बाह्मणपुत्रक ।\nतेन दुर्मृत्युदोषस्य शांतिर्भवति नान्यथा॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003985046, "chapter_id": 23985, "verse_number": "३-१-४८-४७", "content_sanskrit": "श्रीसूत उवाच ।\nएवमुक्तः स मुनिभिः शाकल्यस्य सुतो द्विजाः ।\nजांगलाख्यस्तयोः सर्वं पितृमेधं चकार वै॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003985047, "chapter_id": 23985, "verse_number": "३-१-४८-४८", "content_sanskrit": "अन्येद्युरस्थीन्यादाय हालास्यं प्रययौ च सः ।\nतस्माद्रामेश्वरं सद्यो गत्वाऽयं जांगलो द्विजः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003985048, "chapter_id": 23985, "verse_number": "३-१-४८-४९", "content_sanskrit": "मुनिप्रोक्तप्रकारेण तस्मिन्रामेश्वरस्थले ।\nनिधाय पित्रोरस्थीनि श्राद्धादीन्यकरोत्तथा॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003985049, "chapter_id": 23985, "verse_number": "३-१-४८-५०", "content_sanskrit": "प्रथमाब्दिकपर्यंतं कार्यं तत्राकरोच्च सः ।\nस्थित्वाब्दं स मुनेः पुत्र एको जांगलसंज्ञकः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003985050, "chapter_id": 23985, "verse_number": "३-१-४८-५१", "content_sanskrit": "आब्दिकांते दिने विप्रो रात्रौ स्वप्ने विलोक्य तु ।\nस्वमातरं च पितरं शंखचक्रगदाधरौ॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003985051, "chapter_id": 23985, "verse_number": "३-१-४८-५२", "content_sanskrit": "गरुडोपरि संविष्टौ पद्ममालाविभूषितौ ।\nशोभितौ तुलसीदाम्ना स्फुरन्मकरकुंडलौ॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003985052, "chapter_id": 23985, "verse_number": "३-१-४८-५३", "content_sanskrit": "कौस्तुभालंकृतोरस्कौ पीतांबरविराजितौ ।\nएवं दृष्ट्वा मुनिसुतो जांगलः सुप्रसन्नधीः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003985053, "chapter_id": 23985, "verse_number": "३-१-४८-५४", "content_sanskrit": "स्वाश्रमं पुनरागत्य सुखेन न्यवसद्द्विजाः ।\nस्वप्नदृष्टं च वृत्तांतं मातापित्रोः स जांगलः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003985054, "chapter_id": 23985, "verse_number": "३-१-४८-५५", "content_sanskrit": "तेभ्यो न्यवेदयत्सर्वं ब्राह्मणेभ्योऽतिहर्षितः ।\nश्रुत्वा ते मुनयो वृत्तमासन्संप्रीतमानसाः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003985055, "chapter_id": 23985, "verse_number": "३-१-४८-५६", "content_sanskrit": "अथ राजानमालोक्य सर्वे तेऽपि महर्षयः ।\nअवदन्कुपिता विप्राः शपंतः शंकरं नृपम्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003985056, "chapter_id": 23985, "verse_number": "३-१-४८-५७", "content_sanskrit": "पांड्यभूप महामूर्ख क्रौर्याद्ब्राह्मणघातक ।\nस्त्रीहत्या ब्रह्महत्या च कृता यस्मात्त्वयाधुना॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003985057, "chapter_id": 23985, "verse_number": "३-१-४८-५८", "content_sanskrit": "अतः शरीरसंत्यागं कुरु त्वं हव्यवाहने ।\nनोचेत्तव न शुद्धिः स्यात्प्रायश्चित्तशतैरपि॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003985058, "chapter_id": 23985, "verse_number": "३-१-४८-५९", "content_sanskrit": "त्वत्संभाषणमात्रेण ब्रह्महत्यायुतं भवेत् ।\nअस्मत्सकाशाद्गच्छ त्वं पांड्यानां कुलपांसन॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003985059, "chapter_id": 23985, "verse_number": "३-१-४८-६०", "content_sanskrit": "इत्युक्तो मुनिभिः पांड्यः शंकरो द्विजपुंगवाः ।\nतथास्तु देहसंत्यागं करिष्ये हव्यवाहने॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003985060, "chapter_id": 23985, "verse_number": "३-१-४८-६१", "content_sanskrit": "ब्रह्महत्याविशुद्ध्यर्थं भवतां सन्निधावहम् ।\nअनुग्रहं मे कुर्वंतु भवंतो मुनिसत्तमाः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003985061, "chapter_id": 23985, "verse_number": "३-१-४८-६२", "content_sanskrit": "तथा शरीर संत्यागात्पातकं मे लयं व्रजेत् ।\nएवमुक्त्वा मुनीन्सर्वाञ्च्छंकरः पांड्यभूपतिः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003985062, "chapter_id": 23985, "verse_number": "३-१-४८-६३", "content_sanskrit": "स्वान्मंत्रिणः समाहूय बभाषे वचनं त्विदम् ।\nभो मंत्रिणो ब्रह्महत्या मयाऽकार्यविचारतः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003985063, "chapter_id": 23985, "verse_number": "३-१-४८-६४", "content_sanskrit": "स्त्रीहत्या च तथा क्रूरा महानरकदायिनी ।\nएतत्पातकशुद्ध्यर्थं मुनीनां वचनादहम्॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003985064, "chapter_id": 23985, "verse_number": "३-१-४८-६५", "content_sanskrit": "प्रदीप्ते ऽग्नौ महाज्वाले परित्यक्ष्ये कलेवरम् ।\nकाष्ठान्यानयत क्षिप्रं तैरग्निश्च समिध्यताम्॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003985065, "chapter_id": 23985, "verse_number": "३-१-४८-६६", "content_sanskrit": "मम पुत्रं च सुरुचिं राज्ये स्थापयताचिरात् ।\nमा शोकं कुरुतामात्या दैवतं दुरतिक्रमम्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003985066, "chapter_id": 23985, "verse_number": "३-१-४८-६७", "content_sanskrit": "इतीरिता नृपतिना मंत्रिणो रुरुदुस्तदा ।\nपांड्यनाथ महाराज रिपूणामपि वत्सल॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003985067, "chapter_id": 23985, "verse_number": "३-१-४८-६८", "content_sanskrit": "वयं हि भवता नित्यं पुत्रवत्परिपालिताः ।\nत्वां विना न प्रवेक्ष्याम पुरीं देवपुरोपमाम्॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003985068, "chapter_id": 23985, "verse_number": "३-१-४८-६९", "content_sanskrit": "हव्यवाहं प्रवेक्ष्यामो महा काष्ठसमेधितम् ।\nतेषां प्रलपितं श्रुत्वा पांड्य शंकरभूपतिः ।\nप्रोवाच मंत्रिणः सर्वान्वचनं सांत्वपूर्वकम्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003985069, "chapter_id": 23985, "verse_number": "३-१-४८-७०", "content_sanskrit": "शंकर उवाच ।\nकिं करिष्यथ भोऽमात्या महापातकिना मया॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003985070, "chapter_id": 23985, "verse_number": "३-१-४८-७१", "content_sanskrit": "सिंहासनं समारुह्य न कर्तुं युज्यते बत ।\nचतुरर्णवपर्यंतधरापालनमंजसा॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003985071, "chapter_id": 23985, "verse_number": "३-१-४८-७२", "content_sanskrit": "मत्पुत्रं सुरुचिं शीघ्रमतः स्थापयतासने ।\nकाष्ठान्यानयत क्षिप्रं प्रवेष्टुं हव्यवाहनम्॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003985072, "chapter_id": 23985, "verse_number": "३-१-४८-७३", "content_sanskrit": "मम मंत्रिवरा यूयं विलंबं त्यजताधुना ।\nइत्युक्ता मंत्रिणः काष्ठं समानिन्युः क्षणेन ते॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003985073, "chapter_id": 23985, "verse_number": "३-१-४८-७४", "content_sanskrit": "अग्निं प्रज्वलितं काष्ठैर्दृष्ट्वा शंकरभूपतिः ।\nस्नात्वाचम्य विशुद्धात्मा मुनीनां संनिधौ तदा॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003985074, "chapter_id": 23985, "verse_number": "३-१-४८-७५", "content_sanskrit": "अग्निं प्रदक्षिणीकृत्य तान्मुनीनपि सत्वरम् ।\nअग्निं मुनीन्नमस्कृत्य ध्यात्वा देवमुमापतिम्॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003985075, "chapter_id": 23985, "verse_number": "३-१-४८-७६", "content_sanskrit": "अग्नौ पतितुमारेभे धैर्यमालंब्य भूपतिः ।\nतस्मिन्नवसरे विप्रा मुनीनामपि शृण्वताम्॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003985076, "chapter_id": 23985, "verse_number": "३-१-४८-७७", "content_sanskrit": "अशरीरा समुदभूद्वाणी भैरवनादिनी ।\nभोः शंकर महीपाल मानलं प्रविशाधुना॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003985077, "chapter_id": 23985, "verse_number": "३-१-४८-७८", "content_sanskrit": "ब्रह्महत्यानिमित्तं ते भयं मा भून्महामते ।\nतवोपदेशं वक्ष्यामि रहस्यं वेदसंमितम्॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003985078, "chapter_id": 23985, "verse_number": "३-१-४८-७९", "content_sanskrit": "शृणुष्वावहितो राजन्मदुक्तं क्रियतां त्वया ।\nदक्षिणांबुनिधेस्तीरे गंधमादनपर्वते॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003985079, "chapter_id": 23985, "verse_number": "३-१-४८-८०", "content_sanskrit": "रामसेतौ महापुण्ये महापातकनाशने ।\nरामप्रतिष्ठितं लिगं रामनाथं महेश्वरम्॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003985080, "chapter_id": 23985, "verse_number": "३-१-४८-८१", "content_sanskrit": "सेवस्व वर्षमेकं त्वं त्रिकालं भक्तिपूर्वकम् ।\nप्रदक्षिणप्रक्रमणं नमस्कारं च वै कुरु॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003985081, "chapter_id": 23985, "verse_number": "३-१-४८-८२", "content_sanskrit": "महाभिषेकः क्रियतां रामनाथस्य वै त्वया ।\nनैवेद्यं विविधं राजन्क्रियतां च दिनेदिने॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003985082, "chapter_id": 23985, "verse_number": "३-१-४८-८३", "content_sanskrit": "चन्दनागरुकर्पूरै रामलिंगं प्रपूजय ।\nभारद्वयेन गव्येन ह्याज्येन त्वभिषेचय॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003985083, "chapter_id": 23985, "verse_number": "३-१-४८-८४", "content_sanskrit": "प्रत्यहं च गवां क्षीरैर्द्विभारपरिसंमितैः ।\nमधुद्रोणेन तल्लिंगं प्रत्यहं स्नापय प्रभोः॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003985084, "chapter_id": 23985, "verse_number": "३-१-४८-८५", "content_sanskrit": "प्रत्यहं पायसान्नेन नैवेद्यं कुरु भूपते ।\nप्रत्यहं तिलतैलेन दीपाराधनमाचर॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003985085, "chapter_id": 23985, "verse_number": "३-१-४८-८६", "content_sanskrit": "एतेन तव राजेंद्र रामनाथस्य शूलिनः ।\nस्त्रीहत्य्रा ब्रह्महत्या च तत्क्षणादेव नश्यतः॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003985086, "chapter_id": 23985, "verse_number": "३-१-४८-८७", "content_sanskrit": "दर्शनाद्रामनाथस्य भ्रूणहत्याशतानि च ।\nअयुतं ब्रह्महत्यानां सुरापानायुतं तथा॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003985087, "chapter_id": 23985, "verse_number": "३-१-४८-८८", "content_sanskrit": "स्वर्णस्तेयायुतं राजन्गुरुस्त्रीगमनायुतम् ।\nएतत्संसर्गदोषाश्च विनश्यंति क्षणाद्विभो॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003985088, "chapter_id": 23985, "verse_number": "३-१-४८-८९", "content_sanskrit": "महापातकतुल्यानि यानि पापानि संति वै ।\nतानि सर्वाणि नश्यंति रामनाथस्य सेवया॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003985089, "chapter_id": 23985, "verse_number": "३-१-४८-९०", "content_sanskrit": "महती रामनाथस्य सेवा लभ्येत चेन्नृणाम्॥  ।\nकिं गंगया च गयया प्रयागेणाध्वरेण वा॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003985090, "chapter_id": 23985, "verse_number": "३-१-४८-९१", "content_sanskrit": "तद्गच्छ रामसेतुं त्वं रामनाथं भजानिशम् ।\nविलंबं मा कुरु विभो गमने च त्वरां कुरु॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003985091, "chapter_id": 23985, "verse_number": "३-१-४८-९२", "content_sanskrit": "इत्युक्त्वा विररामाथ सापि वागशरीरिणी ।\nतच्छ्रुत्वा मुनयः सर्वे त्वरयंति स्म भूपतिम्॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003985092, "chapter_id": 23985, "verse_number": "३-१-४८-९३", "content_sanskrit": "गच्छ शीघं महाराज रामसेतुं विमुक्तिदम्॥  ।\nरामनाथस्य माहात्म्यमज्ञात्वास्माभिरीरितम्॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003985093, "chapter_id": 23985, "verse_number": "३-१-४८-९४", "content_sanskrit": "देहत्यागं कुरुष्वेति वह्नौ प्रज्वलितेऽधुना ।\nअनुज्ञातो मुनिवरैरिति राजा स शंकरः॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003985094, "chapter_id": 23985, "verse_number": "३-१-४८-९५", "content_sanskrit": "चतुरंगबलं पुर्यां प्रापयित्वा त्वरान्वितः ।\nनमस्कृत्य मुनीन्सर्वान्प्रहृष्टेनांतरात्मना॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003985095, "chapter_id": 23985, "verse_number": "३-१-४८-९६", "content_sanskrit": "वृतः कतिपयैः सैन्यैः समादाय धनं बहु ।\nरामनाथस्य सेवार्थमयासीद्गंधमादनम्॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003985096, "chapter_id": 23985, "verse_number": "३-१-४८-९७", "content_sanskrit": "उवास वर्षमेकं च रामसेतौ विशुद्धिदे ।\nएकभुक्तो जितक्रोधो विजितेंद्रियसंचयः॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003985097, "chapter_id": 23985, "verse_number": "३-१-४८-९८", "content_sanskrit": "त्रिसंध्यं रामनाथं च सेवमानः सभक्तिकम् ।\nप्रददौ रामनाथाय दशभारं धनं मुदा॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003985098, "chapter_id": 23985, "verse_number": "३-१-४८-९९", "content_sanskrit": "प्रत्यहं रामनाथस्य महापूजामकारयत् ।\nअकरोच्च धनुष्कोटौ प्रत्यहं भक्तिपूर्वकम्॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003985099, "chapter_id": 23985, "verse_number": "३-१-४८-१००", "content_sanskrit": "स्नानं प्रतिदिनं चान्नं ब्राह्मणेभ्य ददौ मुदा ।\nअशरीरावचःप्रोक्तमखिलं पूजनं तथा॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003985100, "chapter_id": 23985, "verse_number": "३-१-४८-१०१", "content_sanskrit": "एवं कृतवतस्तस्य वर्षमेकं गतं द्विजाः ।\nवर्षांते स शुचिर्भूत्वा शंकरस्तुष्टमानसः ।\nतुष्टाव परमेशानं रामनाथं घृणानिधिम्॥ १०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003985101, "chapter_id": 23985, "verse_number": "३-१-४८-१०२", "content_sanskrit": "शंकर उवाच ।\nनमामि रुद्रमीशानं रामनाथमुमापतिम्॥ १०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003985102, "chapter_id": 23985, "verse_number": "३-१-४८-१०३", "content_sanskrit": "पाहि मां कृपया देव ब्रह्महत्यां दहाशु मे ।\nत्रिपुरघ्न महादेव कालकूटविषादन॥ १०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003985103, "chapter_id": 23985, "verse_number": "३-१-४८-१०४", "content_sanskrit": "रक्ष मां त्वं दयासिंधो स्त्रीहत्यां मे विमोचय ।\nगंगाधर विरूपाक्ष रामनाथ त्रिलोचन॥ १०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003985104, "chapter_id": 23985, "verse_number": "३-१-४८-१०५", "content_sanskrit": "मां पालय कृपादृष्ट्या छिन्धि मत्पातकं विभो ।\nकामारे कामसंदायिन्भक्तानां राघवेश्वर॥ १०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003985105, "chapter_id": 23985, "verse_number": "३-१-४८-१०६", "content_sanskrit": "कटाक्षं पातय मयि शुद्धं मां कुरु धूर्जटे ।\nमार्कंडेयभयत्राण मृत्युंजय शिवाव्यय॥ १०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003985106, "chapter_id": 23985, "verse_number": "३-१-४८-१०७", "content_sanskrit": "नमस्ते गिरिजार्धाय निष्पापं कुरु मां सदा ।\nरुद्राक्षमालाभरण चन्द्रशेखर शंकर॥ १०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003985107, "chapter_id": 23985, "verse_number": "३-१-४८-१०८", "content_sanskrit": "वेदोक्तसम्यगाचारयोग्यं मां कुरु ते नमः ।\nसूर्यदंतभिदे तुभ्यं भारतीनासिकाच्छिदे॥ १०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003985108, "chapter_id": 23985, "verse_number": "३-१-४८-१०९", "content_sanskrit": "रामेश्वराय देवाय नमो मे शुद्धिदो भव ।\nआनंदं सच्चिदानंदं रामनाथं वृषध्वजम्॥ १०९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003985109, "chapter_id": 23985, "verse_number": "३-१-४८-११०", "content_sanskrit": "भूयोभूयो नमस्यामि पातकं मे विनश्यतु ।\nभक्त्यैवं स्तुवतस्तस्य रामनाथं महेश्वरम्॥ ११० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003985110, "chapter_id": 23985, "verse_number": "३-१-४८-१११", "content_sanskrit": "निर्जगाम मुखाद्राज्ञो ब्रह्महत्यातिभीषणा ।\nनीलवस्त्रधरा क्रूरा महारक्तशिरोरुहा॥ १११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003985111, "chapter_id": 23985, "verse_number": "३-१-४८-११२", "content_sanskrit": "तां ब्रह्महत्यां बीभत्सां नृपवक्त्राद्विनिर्गताम् ।\nनिजघान त्रिशूलेन भैरवो रुद्रशासनात्॥ ११२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003985112, "chapter_id": 23985, "verse_number": "३-१-४८-११३", "content_sanskrit": "हतायां ब्रह्महत्यायां भैरवेण शिवाज्ञया ।\nरामनाथो नृपं प्राह स्तुत्या तस्य प्रसन्नधीः॥ ११३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003985113, "chapter_id": 23985, "verse_number": "३-१-४८-११४", "content_sanskrit": "श्रीरामनाथ उवाच ।\nपांड्यभूप महाराज स्तोत्रेणानेन तेऽनघ ।\nप्रसन्नोऽहं वरं दास्ये तुभ्यं वरय चेप्सितम्॥ ११४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003985114, "chapter_id": 23985, "verse_number": "३-१-४८-११५", "content_sanskrit": "स्त्रीहत्याब्रह्महत्याभ्यां यस्ते दोषः स निर्गतः ।\nशुद्धो विधूतपापोऽसि राज्यं पालय पूर्ववत्॥ ११५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003985115, "chapter_id": 23985, "verse_number": "३-१-४८-११६", "content_sanskrit": "ये मामत्र निषेवंते भक्तियुक्तेन चेतसा ।\nनाशयामि नृणां तेषां ब्रह्महत्यायुतान्यपि॥ ११६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003985116, "chapter_id": 23985, "verse_number": "३-१-४८-११७", "content_sanskrit": "सुरापानायुतं भूप गुरुस्त्रीगमनायुतम् ।\nस्वर्णस्तेयायुतमपि तत्संसर्गायुतं तथा॥ ११७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7003985117, "chapter_id": 23985, "verse_number": "३-१-४८-११८", "content_sanskrit": "अन्यान्यपि च पापानि नाशयामि न संशयः ।\nमत्सेविनो नरा राजन्न भूयः संसरंति ते॥ ११८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7003985118, "chapter_id": 23985, "verse_number": "३-१-४८-११९", "content_sanskrit": "किं तु सायुज्यरूपां मे मुक्तिं यास्यन्त्यसंशयम् ।\nस्तुवंत्यनेन स्तोत्रेण ये मां भक्तिपुरःसरम्॥ ११९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7003985119, "chapter_id": 23985, "verse_number": "३-१-४८-१२०", "content_sanskrit": "नाशयाम्यहमेतेषां महापातकसंचयम् ।\nप्रीतोऽहं तव भक्त्या च स्तोत्रेण मनुजेश्वर॥ १२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7003985120, "chapter_id": 23985, "verse_number": "३-१-४८-१२१", "content_sanskrit": "यथेष्टं प्रार्थय वरं मत्तस्त्वं वरदान्नृप ।\nएवमुक्तः शिवेनाथ शंकरो नृपपुंगवः ।\nरामनाथं बभाषे तं शंकरं करुणानिधिम्॥ १२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7003985121, "chapter_id": 23985, "verse_number": "३-१-४८-१२२", "content_sanskrit": "नृप उवाच ।\nतव संदर्शनेनाहं कृतार्थोऽस्मि महेश्वर॥ १२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7003985122, "chapter_id": 23985, "verse_number": "३-१-४८-१२३", "content_sanskrit": "इतः परं प्रार्थनीयं मम नास्त्यधुनाधिकम् ।\nमृकण्डुसुतसंतापहारि पादयुगं तव॥ १२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7003985123, "chapter_id": 23985, "verse_number": "३-१-४८-१२४", "content_sanskrit": "दृष्टं मया महादेव नातः प्रार्थ्यं विभोस्ति वै ।\nत्वत्पादपद्मयुगुले निश्चला भक्तिरस्तु मे॥ १२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7003985124, "chapter_id": 23985, "verse_number": "३-१-४८-१२५", "content_sanskrit": "न पुनर्जन्म मे भूयान्मातॄणामुदरेऽशुचौ ।\nये मत्कृतमिदं स्तोत्रं कीर्तयंति तव प्रभो ।\nते नराः पापनिर्मुक्तास्त्वत्सेवाफलमाप्नुयुः॥ १२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7003985125, "chapter_id": 23985, "verse_number": "३-१-४८-१२६", "content_sanskrit": "श्रीसूत उवाच ।\nतथास्त्वित्यनुगृह्यैनं रामनाथो द्विजोत्तमाः॥ १२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7003985126, "chapter_id": 23985, "verse_number": "३-१-४८-१२७", "content_sanskrit": "नीलकण्ठो विरूपाक्षो लिंगरूपे तिरोहितः ।\nराजापि रामनाथेन विहितानुग्रहस्ततः॥ १२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7003985127, "chapter_id": 23985, "verse_number": "३-१-४८-१२८", "content_sanskrit": "रामनाथं नमस्कृत्य कृतार्थेनांतरात्मना ।\nस सेनासंवृतः प्रीतः प्रययावात्मनः पुरीम्॥ १२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7003985128, "chapter_id": 23985, "verse_number": "३-१-४८-१२९", "content_sanskrit": "वृत्तांतमेतमवदन्मुनीनां वनवासिनाम् ।\nतेभ्यषिंचन्नृपं राज्ये मुनयः प्रीतमानसाः॥ १२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7003985129, "chapter_id": 23985, "verse_number": "३-१-४८-१३०", "content_sanskrit": "पुत्रदारयुतो राजा प्राप्य राज्यमकण्टकम् ।\nमंत्रिभिः सहितो विप्रा ररक्ष पृथिवीं चिरम्॥ १३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7003985130, "chapter_id": 23985, "verse_number": "३-१-४८-१३१", "content_sanskrit": "ततोंतकाले संप्राप्ते ध्यायन्रामेश्वरं शिवम् ।\nदेहांते रामनाथस्य सायुज्यं प्रययौ शुभम्॥ १३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7003985131, "chapter_id": 23985, "verse_number": "३-१-४८-१३२", "content_sanskrit": "एवं वः कथितं विप्रा रामनाथस्य वैभवम् ।\nचरितं पुण्यमाख्यानं शंकराख्य नृपस्य च॥ १३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7003985132, "chapter_id": 23985, "verse_number": "३-१-४८-१३३", "content_sanskrit": "शृण्वन्पठन्वा मनुजस्त्विममध्यायमादरात् ।\nसर्वपापविनिर्मुक्तो रामनाथं समश्नुते॥ १३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}]