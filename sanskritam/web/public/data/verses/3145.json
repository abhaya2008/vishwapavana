[{"id": 2100146, "chapter_id": 3145, "verse_number": "१४-१-१", "content_sanskrit": "श्रीवेदव्यासाय नमः।\nनारायणं नमस्कृत्य नरं चैव नरोत्तमम्।\nदेवीं सरस्वतीं व्यासं ततो जयमुदीरयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2100147, "chapter_id": 3145, "verse_number": "१४-१-२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2100148, "chapter_id": 3145, "verse_number": "१४-१-२", "content_sanskrit": "कृतोदकस्तु राजानं धृतराष्ट्रं युधिष्ठिरः।\nपुरस्कृत्य महाबाहुरुत्तताराकुलेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2100149, "chapter_id": 3145, "verse_number": "१४-१-३", "content_sanskrit": "उत्तीर्य तु महाबाहुर्बाष्पव्याकुललोचनः।\nपपात तीरे गङ्गाया व्याधविद्ध इव द्विपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2100150, "chapter_id": 3145, "verse_number": "१४-१-४", "content_sanskrit": "तं सीदमानं जग्राह भीमः कृष्णेन चोदितः।\nमैवमित्यब्रवीच्चैनं कृष्णः परबलार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2100151, "chapter_id": 3145, "verse_number": "१४-१-५", "content_sanskrit": "तमार्तं पतितं भूमौ श्वसन्तं च पुनः पुनः।\nतदृशुः पार्थिवा राजन्धर्मपुत्रं युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2100152, "chapter_id": 3145, "verse_number": "१४-१-६", "content_sanskrit": "त दृष्ट्वा दीनमनसं गतसत्वं नरेश्वरम्।\nभूयः शोकसमाविष्टाः पाण्डवाःक समुपाविशन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2100153, "chapter_id": 3145, "verse_number": "१४-१-७", "content_sanskrit": "राजा तु धृतराष्ट्रस्तं तथा दीनो महाभुजम्।\nवाक्यमाह महाबुद्धिः प्रज्ञाचक्षुर्नरेश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2100154, "chapter_id": 3145, "verse_number": "१४-१-८", "content_sanskrit": "उत्तिष्ठ कुरुशार्दूल कुरु कार्यमनन्तरम्।\nक्षत्रधर्मेण कौन्तेय जितेयमवनी त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2100155, "chapter_id": 3145, "verse_number": "१४-१-९", "content_sanskrit": "भुङ्क्ष सार्धं भ्रातृभिस्तां सुहृद्भिश्च जनेश्वर।\nशोचितव्यं न पश्यामि त्वया धर्मभृतांवर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2100156, "chapter_id": 3145, "verse_number": "१४-१-१०", "content_sanskrit": "शोचितव्यं मया चैव गान्धार्या च महीपते।\nययोः पुत्रशतं नष्टं स्वप्नलब्धं यथा धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2100157, "chapter_id": 3145, "verse_number": "१४-१-११", "content_sanskrit": "अश्रुत्वा हितकामस्य विदुरस्य महात्मनः।\nवाक्यानि सुमहार्थानि परितप्यामि दुर्मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2100158, "chapter_id": 3145, "verse_number": "१४-१-१२", "content_sanskrit": "उक्तवान्विदुरो यन्मां धर्मात्मा दिव्यदर्शनः।\nदुर्योधनापराधेन कुलं ते विनशिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2100159, "chapter_id": 3145, "verse_number": "१४-१-१३", "content_sanskrit": "स्वस्ति चेदिच्छसे राजन्कुलस्य कुरु मे वचः।\nवध्यतामेष दुष्टात्मा मन्दो राजा सुयोधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2100160, "chapter_id": 3145, "verse_number": "१४-१-१४", "content_sanskrit": "कर्णश्च शकुनिश्चैव नैनं पश्यतु कर्हिचित्।\nद्यूतसङ्घातमप्येषामप्रमादेन वारय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2100161, "chapter_id": 3145, "verse_number": "१४-१-१५", "content_sanskrit": "अभिषेचय राजानं धर्मात्मानं युधिष्ठिरम्।\nस पालयिष्यति वशी धर्मेण पृथिवीमिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2100162, "chapter_id": 3145, "verse_number": "१४-१-१६", "content_sanskrit": "अथ नेच्छसि राजानं कुन्तीपुत्रं युधिष्ठिरम्।\n`विनाशमुपयास्तन्ति तव पुत्रा न संशयः।\nमेढीभूतः स्वयं राज्यं प्रतिगृह्णीष्व पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2100163, "chapter_id": 3145, "verse_number": "१४-१-१७", "content_sanskrit": "समं सर्वेषु भूतेषु वर्तमानं नराधिप।\nअनुजीवन्तु सर्वे त्वां ज्ञातयो ज्ञातिवर्धंन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2100164, "chapter_id": 3145, "verse_number": "१४-१-१८", "content_sanskrit": "एवं ब्रुवति कौन्तेय विदुरे दीर्घदर्शिनि।\nदुर्योधनमहं पापमन्ववर्तं वृथामतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2100165, "chapter_id": 3145, "verse_number": "१४-१-१९", "content_sanskrit": "अश्रुत्वा तस्य धीरस्य वाक्यानि मधुराण्यहम्।\nफलं प्राप्य महद्दुःखं निमग्नः शोकसागरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2100166, "chapter_id": 3145, "verse_number": "१४-१-२०", "content_sanskrit": "वृद्धौ हि तेऽद्य पितरौ पश्य नौ दुःखितौ नृप।\nन शोचितव्यं भवता पश्यामीह जनाधिप॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2100167, "chapter_id": 3145, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अश्वमेधपर्वणि प्रथमोऽध्यायः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]