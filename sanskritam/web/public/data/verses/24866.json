[{"id": 7004866000, "chapter_id": 24866, "verse_number": "७-१-४९-१", "content_sanskrit": "ईश्वर उवाच ।\nतस्माच्छुक्रेश्वराद्गच्छेद्देवि लिंगं महाप्रभम् ।\nशनैश्चरैश्वरंनाम महापातकनाशनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004866001, "chapter_id": 24866, "verse_number": "७-१-४९-२", "content_sanskrit": "बुधेश्वरात्पश्चिमतो ह्यजादेव्यग्निगोचरे ।\nतस्या धनुः पंचकेन नातिदूरे व्यवस्थितम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004866002, "chapter_id": 24866, "verse_number": "७-१-४९-३", "content_sanskrit": "कल्पलिंगं महादेवि पूजितं देवदानवैः ।\nछायापुत्रेण संतप्तं तपः परमदुष्करम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004866003, "chapter_id": 24866, "verse_number": "७-१-४९-४", "content_sanskrit": "अनादि निधनो देवो येन लिंगेऽवतारितः ।\nप्राप्तवान्यो ग्रहेशत्वं भक्त्या शंभोः प्रसादतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004866004, "chapter_id": 24866, "verse_number": "७-१-४९-५", "content_sanskrit": "यस्य दृष्ट्या बिभेति स्म देवासुरगणो महान् ।\nन स कोऽप्यस्ति वै प्राणी ब्रह्मांडे सचराचरे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004866005, "chapter_id": 24866, "verse_number": "७-१-४९-६", "content_sanskrit": "देवो वा दानवो वापि सौरिणा पीडितो न यः ।\nशनिवारेण संपूज्य भक्त्या सौरीश्वरं शिवम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004866006, "chapter_id": 24866, "verse_number": "७-१-४९-७", "content_sanskrit": "शमीपत्रैर्महादेवि तिलमाषगुडौदनैः ।\nसंतर्प्य तु विधानेन दद्यात्कृष्णं वृषं द्विजे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004866007, "chapter_id": 24866, "verse_number": "७-१-४९-८", "content_sanskrit": "स्तुत्वा स्तोत्रैश्च विविधैः पुराणश्रुतिसंभवैः ।\nअथ वैकेन देवेशः स्तोत्रेण परितोषितः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004866008, "chapter_id": 24866, "verse_number": "७-१-४९-९", "content_sanskrit": "राज्ञा दशरथेनैव कृतेन तु बलीयसा ।\nस्तुत्यः सौरीश्वरो देवः सर्वपीडोपशांतये ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004866009, "chapter_id": 24866, "verse_number": "७-१-४९-१०", "content_sanskrit": "देव्यु वाच ।\nकथं दशरथो राजा चक्रे शानैश्चरीं स्तुतिम् ।\nकथं संतुष्टिमगमत्तस्य देवः शनैश्चरः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004866010, "chapter_id": 24866, "verse_number": "७-१-४९-११", "content_sanskrit": "ईश्वर उवाच ।\nरघुवंशेऽति विख्यातो राजा दशरथो बली ।\nचक्रवर्ती स विज्ञेयः सप्तद्वीपाधिपः पुरा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004866011, "chapter_id": 24866, "verse_number": "७-१-४९-१२", "content_sanskrit": "कृत्तिकांते शनिं कृत्वा दैवज्ञैर्ज्ञापितो हि सः ।\nरोहिणीं भेद यित्वा तु शनिर्यास्यति सांप्रतम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004866012, "chapter_id": 24866, "verse_number": "७-१-४९-१३", "content_sanskrit": "उक्तं शकटभेदं तु सुरासुरभयंकरम् ।\nद्वादशाब्दं तु दुर्भिक्षं भविष्यति सुदारुणम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004866013, "chapter_id": 24866, "verse_number": "७-१-४९-१४", "content_sanskrit": "एतच्छ्रुत्वा मुनेर्वाक्यं मंत्रिभिः सहितो नृपः ।\nआकुलं तु जगद्दृष्ट्वा पौरजानपदादिकम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004866014, "chapter_id": 24866, "verse_number": "७-१-४९-१५", "content_sanskrit": "वदंति सततं लोका नियमेन समागताः ।\nदेशाश्च नगर ग्रामा भयाक्रांताः समंततः ।\nमुनीन्वसिष्ठप्रमुखान्पप्रच्छ च स्वयं नृपः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004866015, "chapter_id": 24866, "verse_number": "७-१-४९-१६", "content_sanskrit": "दशरथ उवाच ।\nसमाधानं किमत्रास्ते ब्रूहि मे द्विज सत्तम ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004866016, "chapter_id": 24866, "verse_number": "७-१-४९-१७", "content_sanskrit": "वसिष्ठ उवाच ।\nप्राजापत्ये च नक्षत्रे तस्मिन्भिन्ने कुतः प्रजाः ।\nअयं योगो ह्यसाध्यस्तु ब्रह्मादींद्रादिभिः सुरैः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004866017, "chapter_id": 24866, "verse_number": "७-१-४९-१८", "content_sanskrit": "तदा संचिंत्य मनसा साहसं परमं महत् ।\nसमादाय धनुर्दिव्यं दिव्यैरस्त्रैः समन्वितम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004866018, "chapter_id": 24866, "verse_number": "७-१-४९-१९", "content_sanskrit": "रथमारुह्य वेगेन गतो नक्षत्रमंडलम्॥  ।\nरथं तु कांचनं दिव्यं मणिरत्नविभूषितम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004866019, "chapter_id": 24866, "verse_number": "७-१-४९-२०", "content_sanskrit": "ध्वजैश्च चामरैश्छत्रैः किंकिणैरथ शोभितम् ।\nहंसवर्णहयैर्युक्तं महाकेतुसमन्वितम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004866020, "chapter_id": 24866, "verse_number": "७-१-४९-२१", "content_sanskrit": "दीप्यमानो महारत्नैः किरीटमुकुटोज्ज्वलः ।\nबभ्राज स तदाकाशे द्वितीय इव भास्करः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004866021, "chapter_id": 24866, "verse_number": "७-१-४९-२२", "content_sanskrit": "आकर्णं चापमापूर्य संहारास्त्रं नियोज्य च ।\nकृत्तिकांते शनिं ज्ञात्वा प्रविश्य किल रोहिणीम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004866022, "chapter_id": 24866, "verse_number": "७-१-४९-२३", "content_sanskrit": "दृष्ट्वा दशरथोऽस्याग्रे तस्थौ सभ्रुकुटीमुखः ।\nसंहारास्त्रं शनिर्दृष्ट्वा सुरासुरविमर्द्दनम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004866023, "chapter_id": 24866, "verse_number": "७-१-४९-२४", "content_sanskrit": "हसित्वा तद्रयात्सौरिरिदं वचनमब्रवीत् ।\nपौरुषं तव राजेंद्र परं रिपुभयंकरम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004866024, "chapter_id": 24866, "verse_number": "७-१-४९-२५", "content_sanskrit": "देवासुरमनुष्याश्च सिद्धविद्याधरोरगाः ।\nमया विलोकिताः सर्वे भयं चाशु व्रजंति ते ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004866025, "chapter_id": 24866, "verse_number": "७-१-४९-२६", "content_sanskrit": "तुष्टोहं तव राजेंद्र तपसा पौरुषेण च ।\nवरं ब्रूहि प्रदास्यामि मनसा यदभीप्सितम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004866026, "chapter_id": 24866, "verse_number": "७-१-४९-२७", "content_sanskrit": "दशरथ उवाच ।\nरोहिणीं भेदयित्वा तु न गंतव्यं त्वया शने ।\nसरितः सागरा यावद्यावच्चद्रार्कमेदिनी ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004866027, "chapter_id": 24866, "verse_number": "७-१-४९-२८", "content_sanskrit": "याचितं ते मया सौरे नान्य मिच्छामि ते वरम् ।\nएवमुक्तः शनिः प्रादाद्वरं तस्मै तु शाश्वतम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004866028, "chapter_id": 24866, "verse_number": "७-१-४९-२९", "content_sanskrit": "प्राप्यैवं तु वरं राजा कृतकृत्योऽभवत्तदा ।\nपुनरेवाब्रवीत्सौरिर्वरं वरय सुव्रत ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004866029, "chapter_id": 24866, "verse_number": "७-१-४९-३०", "content_sanskrit": "प्रार्थयामास हृष्टात्मा वरमेवं शनेस्तदा ।\nन भेत्तव्यं च शकटं त्वया भास्करनंदन ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004866030, "chapter_id": 24866, "verse_number": "७-१-४९-३१", "content_sanskrit": "द्वादशाब्दं तु दुर्भिक्षं न कर्तव्यं कदाचन ।\nकीर्तिरेषा मदीया च त्रैलोक्ये विचरिष्यति ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004866031, "chapter_id": 24866, "verse_number": "७-१-४९-३२", "content_sanskrit": "ईश्वर उवाच ।\nवरद्वयं ततः प्राप्य हृष्टरोमा स पार्थिवः ।\nरथोपरि धनुर्मुक्त्वा भूत्वा चैव कृतांजलिः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004866032, "chapter_id": 24866, "verse_number": "७-१-४९-३३", "content_sanskrit": "ध्यात्वा सरस्वतीं देवीं गणनाथं विनायकम् ।\nराजा दशरथः स्तोत्रं सौरेरिदमथाकरोत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004866033, "chapter_id": 24866, "verse_number": "७-१-४९-३४", "content_sanskrit": "राजोवाच ।\nनमो नीलमयूखाय नीलोत्पलनिभाय च ।\nनमो निर्मांसदेहाय दीर्घश्मश्रुजटाय च ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004866034, "chapter_id": 24866, "verse_number": "७-१-४९-३५", "content_sanskrit": "नमो विशालनेत्राय शुष्कोदरभयान क ।\nनमः परुषगात्राय स्थूलरोमाय वै नमः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004866035, "chapter_id": 24866, "verse_number": "७-१-४९-३६", "content_sanskrit": "नमो नित्यं क्षुधार्त्ताय नित्यतप्ताय वै नमः ।\nनमः कालाग्निरूपाय कृतांतक नमोस्तु ते ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004866036, "chapter_id": 24866, "verse_number": "७-१-४९-३७", "content_sanskrit": "नमो दीर्घाय शुष्काय कालदृष्टे नमोऽस्तु ते ।\nनमस्ते कोटराक्षाय दुर्निरीक्ष्याय वै नमः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004866037, "chapter_id": 24866, "verse_number": "७-१-४९-३८", "content_sanskrit": "नमो घोराय रौद्राय भीषणाय करा लिने ।\nनमस्ते सर्वभक्षाय वलीमुख नमोऽस्तु ते ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004866038, "chapter_id": 24866, "verse_number": "७-१-४९-३९", "content_sanskrit": "सूर्यपुत्र नमस्तेऽस्तु भास्करे भयदायक ।\nअधोदृष्टे नमस्तुभ्यं वपुःश्याम नमोऽस्तु ते ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004866039, "chapter_id": 24866, "verse_number": "७-१-४९-४०", "content_sanskrit": "नमो मन्दगते तुभ्यं निस्त्रिंशाय नमोनमः ।\nनमस्त उग्ररूपाय चण्डतेजाय ते नमः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004866040, "chapter_id": 24866, "verse_number": "७-१-४९-४१", "content_sanskrit": "तपसा दग्धदेहाय नित्यं योगरताय च ।\nनमस्ते ज्ञाननेत्राय कश्यपात्मजसूनवे ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004866041, "chapter_id": 24866, "verse_number": "७-१-४९-४२", "content_sanskrit": "तुष्टो ददासि वै राज्यं रुष्टो हरसि तत्क्षणात् ।\nदेवासुरमनुष्याश्च पशुपक्षिसरीसृपाः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004866042, "chapter_id": 24866, "verse_number": "७-१-४९-४३", "content_sanskrit": "त्वया विलोकिताः सौरे दैन्यमाशु व्रजंति च ।\nब्रह्मा शक्रो यमश्चैव ऋषयः सप्ततारकाः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004866043, "chapter_id": 24866, "verse_number": "७-१-४९-४४", "content_sanskrit": "राज्यभ्रष्टाश्च ते सर्वे तव दृष्ट्या विलोकिताः ।\nदेशाश्च नगरग्रामा द्वीपाश्चैवाद्रयस्तथा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004866044, "chapter_id": 24866, "verse_number": "७-१-४९-४५", "content_sanskrit": "रौद्रदृष्ट्या तु ये दृष्टाः क्षयं गच्छंति तत्क्षणात् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004866045, "chapter_id": 24866, "verse_number": "७-१-४९-४६", "content_sanskrit": "प्रसादं कुरु मे सौरे वरार्थेऽहं तवाश्रितः ।\nसौरे क्षमस्वापराधं सर्वभूतहिताय च ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004866046, "chapter_id": 24866, "verse_number": "७-१-४९-४७", "content_sanskrit": "ईश्वर उवाच ।\nएवं स्तुतस्तदा सौरी राज्ञा दशरथेन च ।\nमहराजः शनिर्वाक्यं हृष्टरो माऽब्रवीदिदम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004866047, "chapter_id": 24866, "verse_number": "७-१-४९-४८", "content_sanskrit": "शनिरुवाच ।\nतुष्टोऽहं तव राजेन्द्र स्तवेनानेन सुव्रत ।\nवरं ब्रूहि प्रदास्यामि स्वेच्छया रघुनंदन ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004866048, "chapter_id": 24866, "verse_number": "७-१-४९-४९", "content_sanskrit": "दशरथ उवाच ।\nअद्यप्रभृति पिंगाक्ष पीडा कार्या न कस्यचित् ।\nदेवासुरमनुष्याणां पशुपक्षिसरीसृपाम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004866049, "chapter_id": 24866, "verse_number": "७-१-४९-५०", "content_sanskrit": "शनिरुवाच ।\nग्रहाणां दुर्ग्रहो ज्ञेयो ग्रहपीडां करोम्यहम् ।\nअदेयं प्रार्थितं राजन्किंचिद्युक्तं ददाम्यहम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004866050, "chapter_id": 24866, "verse_number": "७-१-४९-५१", "content_sanskrit": "त्वया प्रोक्तं मम स्तोत्रं ये पठि ष्यंति मानवाः ।\nपुरुषाश्च स्त्रियो वापि मद्भयेनोपपीडिताः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004866051, "chapter_id": 24866, "verse_number": "७-१-४९-५२", "content_sanskrit": "देवासुरमनुष्यास्तु सिद्धविद्याधरोरगाः ।\nमृत्युस्थाने स्थितो वापि जन्मप्रांतगतस्तथा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004866052, "chapter_id": 24866, "verse_number": "७-१-४९-५३", "content_sanskrit": "एककालं द्विकालं वा तेषां श्रेयो ददाम्यहम् ।\nपूजयित्वा जपेत्स्तोत्रं भूत्वा चैव कृतांजलिः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004866053, "chapter_id": 24866, "verse_number": "७-१-४९-५४", "content_sanskrit": "तस्य पीडां न चैवाहमिह कुर्यां कदाचन ।\nजन्मस्थाने स्थितो वापि मृत्युस्थाने स्थितोऽपि च ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004866054, "chapter_id": 24866, "verse_number": "७-१-४९-५५", "content_sanskrit": "जन्मऋक्षे च लग्ने च दशास्वंतर्दशासु च ।\nरक्षामि सततं तस्य पीडां चान्यग्रहस्य च ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004866055, "chapter_id": 24866, "verse_number": "७-१-४९-५६", "content_sanskrit": "अनेनैव प्रकारेण र्पाडामुक्तस्त्वसौ भवेत् ।\nएतत्प्रोक्तं मया दत्तं वरं च रघुनंदन ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004866056, "chapter_id": 24866, "verse_number": "७-१-४९-५७", "content_sanskrit": "ईश्वर उवाच ।\nवरद्वयं च संप्राप्य राजा दशरथः पुरा ।\nमेने कृतार्थमात्मानं नमस्कृत्य शनैश्चरम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004866057, "chapter_id": 24866, "verse_number": "७-१-४९-५८", "content_sanskrit": "शनिं स्तुत्वाऽभ्यनुज्ञातो रथमारुह्य वीर्यवान् ।\nस्वस्थानं गतवान्राजा पूज्यमानो दिवौकसैः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004866058, "chapter_id": 24866, "verse_number": "७-१-४९-५९", "content_sanskrit": "य इदं प्रातरुत्थाय सौरिवारे पठेन्नरः ।\nसर्वग्रहोद्भवा पीडा न भवेद्भुवि तस्य तु ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004866059, "chapter_id": 24866, "verse_number": "७-१-४९-६०", "content_sanskrit": "शनैश्चरं स्मरेद्देवं नित्यं भक्तिसमन्वितः ।\nपूजयित्वा पठेत्स्तोत्रं तस्य तुष्यति भास्करिः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004866060, "chapter_id": 24866, "verse_number": "७-१-४९-६१", "content_sanskrit": "इति ते कथितं देवि माहात्म्यं शनिदैवतम् ।\nसर्वपापोपशमनं सर्वकामफलप्रदम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]