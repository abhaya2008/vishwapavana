[{"id": 7000320000, "chapter_id": 20320, "verse_number": "१-७४-१", "content_sanskrit": "व्यास उवाच ।\nचतुर्भिस्तुरगैर्जुष्टं रथं सूर्यसमप्रभं ।\nत्रैपुरिः संरुरोहाथाब्रवीद्वाक्यं गणाधिपं॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000320001, "chapter_id": 20320, "verse_number": "१-७४-२", "content_sanskrit": "पिता मे निहतः पित्रा तव यस्माद्गणाधिप ।\nतस्मात्त्वामद्य विशिखैर्नयामि यमसादनं॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000320002, "chapter_id": 20320, "verse_number": "१-७४-३", "content_sanskrit": "ततस्तमब्रवीद्देवो गणेशस्त्रिपुरात्मजं ।\nतव तातेन दुष्टेन सुराणामहितं पुरा॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000320003, "chapter_id": 20320, "verse_number": "१-७४-४", "content_sanskrit": "कृतं कर्ममहत्पापं श्रुतं नो जनकेन हि ।\nपापकर्मरतं दुष्टं ज्ञात्वा ज्ञानबलेन च॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000320004, "chapter_id": 20320, "verse_number": "१-७४-५", "content_sanskrit": "अवधीत्तं शरैकेन पितरं ते बलेन च ।\nपंकात्प्रतारितो मोहात्प्रेषितो यममंदिरं॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000320005, "chapter_id": 20320, "verse_number": "१-७४-६", "content_sanskrit": "त्वां चाहं तत्पथं दैत्य प्रेषयामि क्षणादिह ।\nउक्तवंतं महाप्राज्ञं सुराणां च गणाधिपं॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000320006, "chapter_id": 20320, "verse_number": "१-७४-७", "content_sanskrit": "विव्याध दशभिस्तीक्ष्णैः कालानलसमप्रभैः ।\nततः शरसहस्रैस्तु दैत्यं विव्याध साहसात्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000320007, "chapter_id": 20320, "verse_number": "१-७४-८", "content_sanskrit": "यमदंडसमैर्बाणैः क्षुरप्रैश्च शिलीमुखैः ।\nकंकपत्रैर्महातीक्ष्णैर्वज्रानलसमप्रभैः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000320008, "chapter_id": 20320, "verse_number": "१-७४-९", "content_sanskrit": "विचकर्त शरांश्चास्य लंबोदरः सुरार्चितः ।\nपुनर्विव्याध विशिखैः सहसाभि दुरोपमैः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000320009, "chapter_id": 20320, "verse_number": "१-७४-१०", "content_sanskrit": "शरैरर्दितसर्वांगो मूर्च्छितस्त्वपतद्भुवि ।\nततो भद्रश्च सौभद्रो भीषणो निर्जरांतकः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000320010, "chapter_id": 20320, "verse_number": "१-७४-११", "content_sanskrit": "स्वां स्वां गदां समादाय दुद्रुवुस्तं विनायकम् ।\nयुगपत्ते गदापातैर्निजघ्नुर्गणनायकम्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000320011, "chapter_id": 20320, "verse_number": "१-७४-१२", "content_sanskrit": "लाघवात्तु वृथा कृत्वा गदास्तेषां महाबलः ।\nभद्रकस्य तु शीर्षे चाहनत्परशुना तदा॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000320012, "chapter_id": 20320, "verse_number": "१-७४-१३", "content_sanskrit": "सौभद्रस्योत्तमांगं च असिनाग्रे निपातितम् ।\nभीषणस्य कुठारेण खड्गेन निर्जरांतकम्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000320013, "chapter_id": 20320, "verse_number": "१-७४-१४", "content_sanskrit": "पातयित्वा च हेरम्बो महागिरिसमांस्तदा ।\nचतुरो गणमुख्यांश्च अन्यांश्चापातयद्द्विषः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000320014, "chapter_id": 20320, "verse_number": "१-७४-१५", "content_sanskrit": "ततः संज्ञां समालभ्य त्रैपुरिश्चासुरोत्तमः ।\nसमारुह्य रथं स्वं च जघान सुरसत्तमम्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000320015, "chapter_id": 20320, "verse_number": "१-७४-१६", "content_sanskrit": "विशिखैरर्धचंद्रैश्च क्षुरप्रैर्भल्लकैस्तथा ।\nतांस्तु चिच्छेद धर्मात्मा पुनर्विव्याध तं शरैः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000320016, "chapter_id": 20320, "verse_number": "१-७४-१७", "content_sanskrit": "चतुर्भिः सैंधवांश्चैव शरैकेन च सारथिम् ।\nशरैः संपातयामास धरण्यां गणनायकान्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000320017, "chapter_id": 20320, "verse_number": "१-७४-१८", "content_sanskrit": "लाघवात्तु रथं चान्यं गत्वा त्रिपुरनंदनः ।\nविशिखैर्वज्रसंकाशैः संबिभेद गणाधिपम्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000320018, "chapter_id": 20320, "verse_number": "१-७४-१९", "content_sanskrit": "रुधिरेणावसिक्तांगो रुषा घोर यमप्रभः ।\nललाटे च त्रिभिर्बाणैस्सप्तभिश्च स्तनांतरे॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000320019, "chapter_id": 20320, "verse_number": "१-७४-२०", "content_sanskrit": "चतुर्भिर्नाभिदेशे च पंचभिर्मुष्टिमस्तके ।\nसंबिभेद महाक्रोधो बलिनं शंभुनंदनः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000320020, "chapter_id": 20320, "verse_number": "१-७४-२१", "content_sanskrit": "शरैरर्दितसर्वांगः स दैत्यो रणमूर्धनि ।\nकश्मलं परमं गत्वा संपपात रथोपरि॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000320021, "chapter_id": 20320, "verse_number": "१-७४-२२", "content_sanskrit": "ततः सूतेन धीरेण अपनीतो रणाजिरात् ।\nविमुखं नाहनच्छूरो विनायकः सुरार्चितः॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000320022, "chapter_id": 20320, "verse_number": "१-७४-२३", "content_sanskrit": "चिरात्संज्ञां समालभ्य यंतारं चाब्रवीद्वचः ।\nगच्छ सूत रणे भीरुं विनायकं हरात्मजम्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000320023, "chapter_id": 20320, "verse_number": "१-७४-२४", "content_sanskrit": "ततो यंताब्रवीद्वाक्यं सत्यं पथ्यं च कोमलम् ।\nहरात्मजशरान्सोढुं कस्समर्थो रणाजिरे॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000320024, "chapter_id": 20320, "verse_number": "१-७४-२५", "content_sanskrit": "तस्मान्मोहगतस्त्वं च मयानीतः प्रभासुत ।\nएतज्ज्ञात्वा त्विदानीं भो यद्युक्तं तद्विधीयताम्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000320025, "chapter_id": 20320, "verse_number": "१-७४-२६", "content_sanskrit": "एतस्मिन्नंतरे राज्ञा प्रेरितः कविसत्तमः ।\nऔषधादिप्रयोगेण गजः संज्ञामबोधयत्॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000320026, "chapter_id": 20320, "verse_number": "१-७४-२७", "content_sanskrit": "अकारयच्छतगुण प्राणं च जयमादिशत् ।\nप्राग्जलं मंत्रितं दत्वा रुरोधास्याङ्गकव्रणान्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000320027, "chapter_id": 20320, "verse_number": "१-७४-२८", "content_sanskrit": "स गजो दशनैरेव स्फोटयामास वै गिरिम् ।\nएवं शतसहस्राणि सैन्यानि सैन्यपालकान्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000320028, "chapter_id": 20320, "verse_number": "१-७४-२९", "content_sanskrit": "पातयामास समितौ गजः परमदुर्जयः ।\nस दैत्यस्तस्य पृष्ठस्थः शरैः कालानलप्रभैः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000320029, "chapter_id": 20320, "verse_number": "१-७४-३०", "content_sanskrit": "हत्वा त्वपातयच्चोर्व्यां मुख्यमुख्यान्सुराधिपान् ।\nशरैस्तस्य तदा देवा यमदंडसमप्रभैः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000320030, "chapter_id": 20320, "verse_number": "१-७४-३१", "content_sanskrit": "निपतंति महावीर्या रुधिरौघपरिप्लुताः ।\nयस्मिन्यस्मिंश्च मार्गे तु स दैत्यः सगजो गतः॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000320031, "chapter_id": 20320, "verse_number": "१-७४-३२", "content_sanskrit": "तत्र तत्र चकाराशु भीषणं संचितं शरैः ।\nगजेन पातिताः केचिद्गजारोहेण चापरे॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000320032, "chapter_id": 20320, "verse_number": "१-७४-३३", "content_sanskrit": "वेगेन भ्रमणेनैव सुराः केचित्प्रतापिताः ।\nएवं सुरगणाध्यक्षाः शस्त्रास्त्रैर्विविधैश्च तम्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000320033, "chapter_id": 20320, "verse_number": "१-७४-३४", "content_sanskrit": "सगजं युद्धनिर्भीता निजघ्नुर्बहुभिः शरैः ।\nतथापि तद्गजं योद्धुं न शक्तास्ते महाबलाः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000320034, "chapter_id": 20320, "verse_number": "१-७४-३५", "content_sanskrit": "क्षिप्रं तांस्तु गजो दंतैस्त्रैपुरोऽपातयच्छरैः ।\nन गता ये धरण्यां च देवा जर्जरविग्रहाः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000320035, "chapter_id": 20320, "verse_number": "१-७४-३६", "content_sanskrit": "शरण्यं गणपं जग्मुर्भीतास्ते वेदनातुराः ।\nदेवानां कदनं दृष्ट्वा गणाधीशः प्रतापवान्॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000320036, "chapter_id": 20320, "verse_number": "१-७४-३७", "content_sanskrit": "स गजं ताडयामास वज्रानलसमैः शरैः ।\nस गजो वेगसंरुद्धः शरेण च समुत्थितः॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000320037, "chapter_id": 20320, "verse_number": "१-७४-३८", "content_sanskrit": "अथोतौ द्वौ शरैरेव बिभिदाते परस्परम् ।\nउभौ तौ नर्दमानौ च अन्योन्यं जयमैच्छताम्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000320038, "chapter_id": 20320, "verse_number": "१-७४-३९", "content_sanskrit": "शोणितैर्लिप्तसर्वांगौ वीरमुख्यौ सुरासुरौ ।\nअथाखुं स गजो मत्तो बिभेद दशनैः स्वकैः॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000320039, "chapter_id": 20320, "verse_number": "१-७४-४०", "content_sanskrit": "आखुनाभिद्रुतो नागो घोरयुद्धं तयोः परम् ।\nअधोर्ध्वं संविभागे च चतुर्भिर्युद्धमद्भुतम्॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000320040, "chapter_id": 20320, "verse_number": "१-७४-४१", "content_sanskrit": "सशब्दं तुमुलं युद्धं सर्वलोकभयंकरम् ।\nदशनैर्दशनैरेव शरैरेव शरोत्तमैः॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000320041, "chapter_id": 20320, "verse_number": "१-७४-४२", "content_sanskrit": "तद्घोरमभवद्युद्धं देवदानवसंगरे ।\nआखुको भेदयांचक्रे महानांगं महाबलम्॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000320042, "chapter_id": 20320, "verse_number": "१-७४-४३", "content_sanskrit": "पर्शुना पृष्ठवंशाग्रे स्थित्वा तेनाहनत्पुनः ।\nदैत्यस्य दशनद्वारे हृदिस्कंधेथ लाघवात्॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000320043, "chapter_id": 20320, "verse_number": "१-७४-४४", "content_sanskrit": "सगजः स पपातोर्व्यां गतासुर्लोहितं वमन् ।\nशशंसुर्मुनयो देवास्साधुसाध्विति चाब्रुवत्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000320044, "chapter_id": 20320, "verse_number": "१-७४-४५", "content_sanskrit": "अत्रान्येस्त्रैरमोघैश्च दैत्यानाजघ्नुराहवे ।\nयावत्तु सेनयोर्नैव जययुद्धं समापयेत्॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]