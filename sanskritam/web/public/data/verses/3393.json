[{"id": 2110670, "chapter_id": 3393, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2110671, "chapter_id": 3393, "verse_number": "१", "content_sanskrit": "तस्मिन् नक्षत्रसंयोगे शुक्ले चन्द्रस्तु यादृशः ।\nतादृशो मुमुदे राजा तया शर्मिष्ठया सह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2110672, "chapter_id": 3393, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2110673, "chapter_id": 3393, "verse_number": "२", "content_sanskrit": "प्रजानां श्रीरिवाग्र्या मे शर्मिष्ठा ह्यभवद् वधूः ।\nपन्नगीवोग्ररूपेयं देवयानी मम ह्यभूत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2110674, "chapter_id": 3393, "verse_number": "३", "content_sanskrit": "पर्जन्य इव सस्यानां देवानाममृतं यथा ।\nतद्वन्ममापि सम्भूता शर्मिष्ठा वार्षपर्वणी ।\nइत्येवं मनसा ध्यात्वा देवयानीमवर्जयत् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2110675, "chapter_id": 3393, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2110676, "chapter_id": 3393, "verse_number": "४", "content_sanskrit": "श्रुत्वा कुमारं जातं तु देवयानी शुचिस्मिता ।\nचिन्तां बहुविधां चक्रे शर्मिष्ठां प्रति भारत \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2110677, "chapter_id": 3393, "verse_number": "५", "content_sanskrit": "अभिगम्य तु शर्मिष्ठां देवयानी तथाऽब्रवीत् ।\nकिमिदं व्रजिनं सुभ्रु कृतं ते कामलुब्धया \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2110678, "chapter_id": 3393, "verse_number": "", "content_sanskrit": "शर्मिष्ठा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2110679, "chapter_id": 3393, "verse_number": "६", "content_sanskrit": "ऋषिरभ्यागतः कश्चिद् धर्मात्मा वेदपारगः ।\nस मया वरदः कामं याचितो धर्मसंहितम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2110680, "chapter_id": 3393, "verse_number": "७", "content_sanskrit": "अपत्यार्थं स तु मया वृतो वै चारुहासिनि ।\nनाहमन्यायतः काममाचरामि शुचिस्मिते ।\nतस्माल्लब्धं मयाऽपत्यमिदं सत्यं शुचिस्मिते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2110681, "chapter_id": 3393, "verse_number": "", "content_sanskrit": "देवयानी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2110682, "chapter_id": 3393, "verse_number": "८", "content_sanskrit": "शोभनं भीरु सत्यं चेद् अथ विज्ञायते द्विजः ।\nगोत्रनामाभिजनतो वेत्तुमिच्छामि तं द्विजम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2110683, "chapter_id": 3393, "verse_number": "", "content_sanskrit": "शर्मिष्ठा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2110684, "chapter_id": 3393, "verse_number": "९", "content_sanskrit": "ओजसा तपसा चैव दीप्यमानं रविं यथा ।\nतं दृष्ट्वा मम सम्प्रष्टुं शक्तिर्नासीच्छुचिस्मिते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2110685, "chapter_id": 3393, "verse_number": "", "content_sanskrit": "देवयानी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2110686, "chapter_id": 3393, "verse_number": "१०", "content_sanskrit": "यद्येतदेवं शर्मिष्ठे न मन्युर्विद्यते मम ।\nअपत्यं यदि ते लब्धं ज्येष्ठाच्छ्रेष्ठाच्च भामिनि\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2110687, "chapter_id": 3393, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2110688, "chapter_id": 3393, "verse_number": "११", "content_sanskrit": "अन्योन्यमेवं सम्भाष्य सम्प्रहस्य च ते मिथः ।\nजगाम भार्गवी वेश्म तथ्यमित्येव जज्ञुषी\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2110689, "chapter_id": 3393, "verse_number": "१२", "content_sanskrit": "ययातिर्देवयान्यां द्वौ पुत्रावजनयन्नृपः ।\nयदुं च तुर्वशुं चैव इन्द्रविष्णू इवापरौ \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2110690, "chapter_id": 3393, "verse_number": "१३", "content_sanskrit": "तस्मिन् काले तु राजर्षिर्ययातिः पृथिवीपतिः ।\nमाध्वीकरससंयुक्तां मदिरां मदवर्धनीम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2110691, "chapter_id": 3393, "verse_number": "१४", "content_sanskrit": "पाययामास शुक्रस्य तनयां रक्तपिञ्जराम् ।\nपीत्वापीत्वा च मदिरां देवयानी मुमोह सा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2110692, "chapter_id": 3393, "verse_number": "१५", "content_sanskrit": "रुदती गायमाना च नृत्यन्ती च मुहुर्मुहुः ।\nबहु प्रलपती देवी राजानमिदमब्रवीत् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2110693, "chapter_id": 3393, "verse_number": "१६", "content_sanskrit": "राजवद् रूपवेषौ ते किमर्थं त्वमिहागतः ।\nकेन कार्येण सम्प्ताप्तो निर्जनं गहनं वनम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2110694, "chapter_id": 3393, "verse_number": "१७", "content_sanskrit": "द्विजश्रेष्ठ नृपश्रेष्ठो ययातिश्चोग्रदर्शनः ।\nतस्मादितः पलायस्व हितमिच्छसि चेद् द्विज\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2110695, "chapter_id": 3393, "verse_number": "१८", "content_sanskrit": "इत्येवं प्रलपन्तीं तां देवयानीं स नाहुषः ।\nभत्सयामास वचनैरपापां पापवर्धनीम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2110696, "chapter_id": 3393, "verse_number": "१९", "content_sanskrit": "ततो वर्षवरान् मूकान् पङ्गून् वृद्धान् सपण्डकान् ।\nरक्षणे देवयान्याः स पोषणे च शशास ह \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2110697, "chapter_id": 3393, "verse_number": "२०", "content_sanskrit": "ततस्तु नाहुषो राजा शर्मिष्ठां प्राप्य बुद्धिमान् ।\nरेमे च सुचिरं कालं तया शर्मिष्ठया सह\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2110698, "chapter_id": 3393, "verse_number": "२१", "content_sanskrit": "तस्मादेव तु राजर्षेः शर्मिष्ठा वार्षपर्वणी ।\nद्रुह्युं चानुं च पूरुं च त्रीन् कुमारानजीजनत्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2110699, "chapter_id": 3393, "verse_number": "२२", "content_sanskrit": "ततः काले तु राजेन्द्र देवयानी वराङ्गना ।\nययातिसहिता देवी जगाम प्रमदावनम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2110700, "chapter_id": 3393, "verse_number": "२३", "content_sanskrit": "सा ददर्श वने तत्र कुमारान् देवरूपिणः ।\nक्रीडमानान् सुविस्रब्धान् विस्मिता चेदमब्रवीत् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2110701, "chapter_id": 3393, "verse_number": "२५", "content_sanskrit": "कस्यैते दारका राजन् देवपुत्रोपमाः शुभाः ।\nवर्चसा रूपतश्चैव सदृशा मे मतास्तव\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2110702, "chapter_id": 3393, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2110703, "chapter_id": 3393, "verse_number": "२६", "content_sanskrit": "एवं पृष्ट्वा तु राजानं कुमारान् पर्यपृच्छत ।\nतस्मिन् काले तु तच्छ्रुत्वा धात्री तेषां वचोऽब्रवीत् ।\nकिं न व्रूत कुमारा वः पितरं वै द्विजर्षभम् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2110704, "chapter_id": 3393, "verse_number": "", "content_sanskrit": "देवयानी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2110705, "chapter_id": 3393, "verse_number": "२७", "content_sanskrit": "किन्नामधेयगोत्रो वः पुत्रकाः ब्राह्मणः पिता ।\nविब्रूत तत्त्वतः क्षिप्रं कश्चासौ क्व च वर्तते ।\nविब्रूत मे यथातथ्यं श्रोतुमिच्छामि तं ह्यहम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2110706, "chapter_id": 3393, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2110707, "chapter_id": 3393, "verse_number": "२८", "content_sanskrit": "एवमुक्ताः कुमारास्ते देवयान्या सुमध्यया ।\nतेऽदर्शयन् प्रदेशिन्या तमेव पितरं नृपम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2110708, "chapter_id": 3393, "verse_number": "२९", "content_sanskrit": "शर्मिष्ठां मातरं चैव तस्या ऊचुश्च दारकाः ।\nऋषिश्च ब्राह्मणश्चैव द्विजातिश्चैव नः पिता \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2110709, "chapter_id": 3393, "verse_number": "३०", "content_sanskrit": "शर्मिष्ठा नानृतं व्रूयाद् देवयानि क्षमस्व वै ।\nइत्युक्त्वा सहिता देवीं राजानमुपचक्रमुः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2110710, "chapter_id": 3393, "verse_number": "३१", "content_sanskrit": "नाभ्यनन्दत तान् राजा देवयान्यास्तदाऽन्तिके ।\nरुदन्तस्तेऽथ शर्मिष्ठामभ्ययुर्बालकास्ततः \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2110711, "chapter_id": 3393, "verse_number": "३२", "content_sanskrit": "अविब्रुवन्तं किञ्चिच्च राजानं चारुलोचना ।\nनातिदूराच्च राजानं सा चातिष्ठदवाङ्मुखी\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2110712, "chapter_id": 3393, "verse_number": "३३", "content_sanskrit": "श्रुत्वा तु तेषां बालानां सव्रीड इव पार्थिवः ।\nप्रतिवक्तुमशक्तोऽभूत् तूष्णीम्भूतोऽभवन्नृपः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2110713, "chapter_id": 3393, "verse_number": "३४", "content_sanskrit": "दृष्ट्वा तु तेषां बालानां प्रणयं पार्थिवं प्रति ।\nबुध्वा तु तत्त्वतो देवी शर्मिष्ठामिदमब्रवीत् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2110714, "chapter_id": 3393, "verse_number": "३५", "content_sanskrit": "गृहीत्वा तु करे रोषाच्छर्मिष्ठां पुनरब्रवीत् ।\nअन्यो गच्छति मां कश्चिद् ऋषिरित्येवमब्रवीः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2110715, "chapter_id": 3393, "verse_number": "३६", "content_sanskrit": "ययातिमेवं नूनं त्वं प्रोत्साहयसि भामिनि ।\nपूर्वमेव मया प्रोक्तं त्वया तु व्रजिनं कृतम् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2110716, "chapter_id": 3393, "verse_number": "३७", "content_sanskrit": "मय्यधीना सती कस्मादकार्षीर्मम विप्रियम् ।\nतमेवासुरधर्मं त्वं चरती न बिभेषि माम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2110717, "chapter_id": 3393, "verse_number": "", "content_sanskrit": "शर्मिष्ठा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2110718, "chapter_id": 3393, "verse_number": "३८", "content_sanskrit": "यदुक्तमृषिरित्येव तत्सत्यं चारुहासिनि ।\nन्यायतो धर्मतश्चैव चरन्ती न बिभेमि ते\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2110719, "chapter_id": 3393, "verse_number": "३९", "content_sanskrit": "वृतस्त्वया यदा राजा तदैवायं मया वृतः ।\nममापि चाभवद् भर्ता सखीभर्ता हि शोभने\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2110720, "chapter_id": 3393, "verse_number": "४०", "content_sanskrit": "पूज्या च मम मान्या च ज्येष्ठा साध्वी च ब्राह्मणी ।\nत्वत्तोऽपि मे पूज्यतमो राजर्षिः किं न वेत्थ तत् \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2110721, "chapter_id": 3393, "verse_number": "४१", "content_sanskrit": "तव पित्रा मे गुरुणा सह दत्ते उभे शुभे ।\nततो भर्ता च पूज्यश्च पोष्यां पोषयतीह माम् \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2110722, "chapter_id": 3393, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2110723, "chapter_id": 3393, "verse_number": "४२", "content_sanskrit": "एवं श्रुत्वा ततो वाक्यं देवयान्यब्रवीदिदम् ।\nराजन् नाद्येह वत्स्यामि विप्रियं मे कृतं त्वया \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2110724, "chapter_id": 3393, "verse_number": "४३", "content_sanskrit": "रमस्वेह यथाकामं देव्या शर्मिष्ठया सह ।\nप्रतिजज्वाल क्रोधेन देवयानी तदा भृशम् \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2110725, "chapter_id": 3393, "verse_number": "४४", "content_sanskrit": "निर्दहन्तीव शर्मिष्ठां सव्रीडां समुदैक्षत ।\nअपविध्य तु सर्वाणि भूषणान्यसितेक्षणा\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2110726, "chapter_id": 3393, "verse_number": "४५", "content_sanskrit": "सहसोत्पतिता श्यामा नीलकुन्तलमूर्धजा ।\nरुष्टा सकाशं काव्यस्य प्रस्थिता व्यथितानना\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2110727, "chapter_id": 3393, "verse_number": "४६", "content_sanskrit": "अनुवव्राज सम्भ्रान्तः पृष्ठतः सान्त्वयन् नृपः ।\nन न्यवर्तत वै तस्मात् क्रोधसंरक्तलोचना \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2110728, "chapter_id": 3393, "verse_number": "४७", "content_sanskrit": "अविब्रुवन्ती किंचिच्च राजानं चारुहासिनी ।\nअचिरादिव सम्प्राप्ता काव्यस्योशनसोऽन्तिकम् \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2110729, "chapter_id": 3393, "verse_number": "४८", "content_sanskrit": "सा तु दृष्ट्वैव पितरमभिवाद्याग्रतः स्थिता ।\nअनन्तरं ययातिस्तु पूजयामास भार्गवम् \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2110730, "chapter_id": 3393, "verse_number": "", "content_sanskrit": "देवयानी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2110731, "chapter_id": 3393, "verse_number": "४९", "content_sanskrit": "अधर्मेण जितो धर्मः प्रवृत्तमधरोत्तरम् ।\nशर्मिष्ठया निवृत्ताऽस्मि दुहित्रा वृषपर्वणः \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2110732, "chapter_id": 3393, "verse_number": "५०", "content_sanskrit": "त्रयोऽस्यां जनिताः पुत्रा राज्ञा तेन ययातिना ।\nदुर्भगाया मम द्वौ तु पुत्रौ तात ब्रवीमि ते\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2110733, "chapter_id": 3393, "verse_number": "५१", "content_sanskrit": "धर्मिष्ठ इति विख्यात एष राजा भृगूद्वह ।\nअतिक्रान्तश्च मर्यादां काव्यैतत् कथयामि ते\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2110734, "chapter_id": 3393, "verse_number": "", "content_sanskrit": "शुक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2110735, "chapter_id": 3393, "verse_number": "५२", "content_sanskrit": "धर्मज्ञः सन् महाराज यो धर्मं नाकृथाः स्वयम् ।\nतस्माज्जरा त्वां नचिराद् धर्षयिष्यति दुर्जया\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2110736, "chapter_id": 3393, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2110737, "chapter_id": 3393, "verse_number": "५३", "content_sanskrit": "ऋतुं वै याचमानाया भगवन् नान्यचेतसा ।\nदुहितुर्दानवेन्द्रस्य धर्म्यमेतत् कृतं मया \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2110738, "chapter_id": 3393, "verse_number": "५४", "content_sanskrit": "ऋतुं वै याचमानाया न ददाति पुमान् ऋतुम् ।\nभ्रूणहेत्युच्यते ब्रह्मन् सदा वै ब्रह्मवादिभिः \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2110739, "chapter_id": 3393, "verse_number": "५५", "content_sanskrit": "अभिकामां स्त्रियं चैव गम्यां रहसि याचितः ।\nउपैति यः स्वधर्मेषु किल्बिषी न च सः पुमान् \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2110740, "chapter_id": 3393, "verse_number": "५६", "content_sanskrit": "यद्यद् याचति मां कश्चित् तत्तद् देयमिति व्रतम् ।\nत्वयाऽपि सा च दत्ता मे नान्यं नाथमिहेच्छति ।\nमत्वैतन्मम धर्मेण कृतं ब्रह्मन् क्षमस्व मे \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2110741, "chapter_id": 3393, "verse_number": "५७", "content_sanskrit": "इत्येतानि समीक्ष्याहं कारणानि भृगूद्वह ।\nअधर्मभयसंविग्नः शर्मिष्ठामुपजग्मिवान् \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2110742, "chapter_id": 3393, "verse_number": "", "content_sanskrit": "शुक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2110743, "chapter_id": 3393, "verse_number": "५८", "content_sanskrit": "नन्वहं प्रत्यवेक्ष्यस्ते मय्यधीनोऽसि पार्थिव ।\nमिथ्याचारस्य धर्मेषु जरा भवति नाहुष\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2110744, "chapter_id": 3393, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2110745, "chapter_id": 3393, "verse_number": "५९", "content_sanskrit": "क्रुद्धेनोशनसा शप्तो ययातिर्नाहुषस्तदा ।\nपूर्वं वयः परित्यज्य जरां सद्योऽन्वपद्यत \t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2110746, "chapter_id": 3393, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2110747, "chapter_id": 3393, "verse_number": "६०", "content_sanskrit": "अतृप्तो यौवनस्याहं देवयान्यां भृगूद्वह ।\nप्रसादं कुरु मे ब्रह्मन् जरेयं मा विशेत माम् \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2110748, "chapter_id": 3393, "verse_number": "", "content_sanskrit": "शुक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2110749, "chapter_id": 3393, "verse_number": "६१", "content_sanskrit": "नाहं मृषा ब्रवीम्येनां जरां प्राप्तोऽसि नाहुष ।\nजरां त्वेतां त्वमन्यस्मै सङ्क्रामय यदीच्छसि\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2110750, "chapter_id": 3393, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2110751, "chapter_id": 3393, "verse_number": "६२", "content_sanskrit": "राज्यभाक् स भवेद् ब्रह्मन् पुण्यभाक् कीर्तिभाक् तथा ।\nयो मे दद्याद् वयः पुत्रस्तद् भवाननुमन्यताम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2110752, "chapter_id": 3393, "verse_number": "", "content_sanskrit": "शुक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2110753, "chapter_id": 3393, "verse_number": "६३", "content_sanskrit": "सङ्क्रामयिष्यसि जरां यथेष्टं नहुषात्मज ।\nमामनुध्याय भावेन न च पापमवाप्स्यसि\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2110754, "chapter_id": 3393, "verse_number": "६४", "content_sanskrit": "वयो दास्यति ते पुत्रो यः स राजा भविष्यति ।\nआयुष्मान् कीर्तिमांश्चैव बह्वपत्यस्तथैव च\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2110755, "chapter_id": 3393, "verse_number": "२०", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि द्वासप्ततितमोऽध्यायः ॥७२॥ ॥ सम्भवपर्वणि विंशोऽध्यायः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}]