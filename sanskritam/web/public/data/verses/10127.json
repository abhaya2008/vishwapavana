[{"id": 6000127000, "chapter_id": 10127, "verse_number": null, "content_sanskrit": "अथ अष्टमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "topics": [{"text": "विश्वरूपाचार्येण इन्द्राय नारायणवर्मोपदेशः, ध्येयदेवतादिनिरूपणं च", "range": null}]}, {"id": 6000127001, "chapter_id": 10127, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.001.m4a", "display_order": 2}, {"id": 6000127002, "chapter_id": 10127, "verse_number": "६-८-१", "content_sanskrit": "यया गुप्तः सहस्राक्षः सवाहान् रिपुसैनिकान्।\nक्रीडन्निव विनिर्जित्य त्रैलोक्यां बुभुजे श्रियम्॥ ६/८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.002.m4a", "display_order": 3}, {"id": 6000127003, "chapter_id": 10127, "verse_number": "६-८-२", "content_sanskrit": "भगवंस्तन्ममाख्याहि वर्म नारायणात्मकम्।\nयथाऽऽततायिनः शत्रून् येन गुप्तोऽजयन्मृधे॥ ६/८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.003.m4a", "display_order": 4}, {"id": 6000127004, "chapter_id": 10127, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.004.m4a", "display_order": 5}, {"id": 6000127005, "chapter_id": 10127, "verse_number": "६-८-३", "content_sanskrit": "वृतः पुरोहितस्त्वाष्ट्रो महेन्द्रायानुपृच्छते।\nनारायणाख्यं वर्माह तदिहैकमनाः शृृणु॥ ६/८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.005.m4a", "display_order": 6}, {"id": 6000127006, "chapter_id": 10127, "verse_number": null, "content_sanskrit": "विश्वरूप उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.006.m4a", "display_order": 7}, {"id": 6000127007, "chapter_id": 10127, "verse_number": "६-८-४", "content_sanskrit": "धौताङ्घ्रिपाणिराचम्य सपवित्र उदङ्मुखः।\nकृतस्वाङ्गकरन्यासो मन्त्राभ्यां वाग्यतः शुचिः॥ ६/८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.007.m4a", "display_order": 8}, {"id": 6000127008, "chapter_id": 10127, "verse_number": "६-८-५", "content_sanskrit": "नारायणमयं वर्म सन्नह्येद् भय आगते।\nदैवभूतात्मकर्मभ्यो नारायणमयः पुमान्॥ ६/८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.008.m4a", "display_order": 9}, {"id": 6000127009, "chapter_id": 10127, "verse_number": "६-८-६", "content_sanskrit": "पादयोर्जानुनोरूर्वोरुदरे हृद्यथोरसि।\nमुखे शिरस्यानुपूर्व्यादोङ्कारादीनि विन्यसेत्॥ ६/८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.009.m4a", "display_order": 10}, {"id": 6000127010, "chapter_id": 10127, "verse_number": "६-८-७", "content_sanskrit": "ओं नमो नारायणायेति विपर्ययमथापि वा।\nकरन्यासं ततः कुर्याद् द्वादशाक्षरविद्यया॥ ६/८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.010.m4a", "display_order": 11}, {"id": 6000127011, "chapter_id": 10127, "verse_number": "६-८-८", "content_sanskrit": "प्रणवादियकारान्तमङ्गुल्यङ्गुष्ठपर्वसु।\nन्यसेद्धृदय ओङ्कारं विकारमनु मूर्धनि॥ ६/८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.011.m4a", "display_order": 12}, {"id": 6000127012, "chapter_id": 10127, "verse_number": "६-८-९", "content_sanskrit": "षकारं तु भ्रुवोर्मध्ये णकारं शिखया दिशेत्।\nवेकारं नेत्रयोर्युञ्ज्यान्नकारं सर्वसन्धिषु॥ ६/८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.012.m4a", "display_order": 13}, {"id": 6000127013, "chapter_id": 10127, "verse_number": "६-८-१०", "content_sanskrit": "मकारमस्‍त्रमुद्दिश्य मन्त्रमूर्तिर्भवेद् बुधः।\nसविसर्गं, फडन्तं तु सर्वदिक्षु विनिर्दिशेत्॥ ६/८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.013.m4a", "display_order": 14}, {"id": 6000127014, "chapter_id": 10127, "verse_number": null, "content_sanskrit": "‘ओं विष्णवे नमः’", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.014.m4a", "display_order": 15}, {"id": 6000127015, "chapter_id": 10127, "verse_number": "६-८-११", "content_sanskrit": "इत्यात्मानं परं ध्यायेद् ध्येयं षट्‌शक्तिभिर्युतम्।\nविद्यातेजस्तपोमूर्तिरिमं मन्त्रमुदाहरेत्॥ ६/८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.015.m4a", "display_order": 16}, {"id": 6000127016, "chapter_id": 10127, "verse_number": "६-८-१२", "content_sanskrit": "हरिर्विदध्यान्मम सर्वरक्षां न्यस्ताङ्घ्रिपद्मः पतगेन्द्रपृष्ठे।\nदरारिचर्मासिगदेषुचापपाशान् दधानोऽष्टगुणोऽष्टबाहुः॥ ६/८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.016.m4a", "display_order": 17}, {"id": 6000127017, "chapter_id": 10127, "verse_number": "६-८-१३", "content_sanskrit": "जलेषु मां रक्षतु मत्स्यमूर्तिर्यादोगणेभ्यो वरुणस्य पाशात्।\nस्थले च मायावटुवामनोऽव्यात् त्रिविक्रमः खेऽवतु विश्वरूपः॥ ६/८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.017.m4a", "display_order": 18}, {"id": 6000127018, "chapter_id": 10127, "verse_number": "६-८-१४", "content_sanskrit": "दुर्गेष्वटव्याजिमखादिषु प्रभुः पायान्नृसिंहोऽसुरयूथपारिः।\nविमुञ्चतो यस्य महाट्टहासं दिशो विनेदुर्न्यपतंश्च गर्भाः॥ ६/८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.018.m4a", "display_order": 19}, {"id": 6000127019, "chapter_id": 10127, "verse_number": "६-८-१५", "content_sanskrit": "रक्षत्वसौ माऽध्वनि यज्ञकल्पः स्वदंष्ट्रयोन्नीतधरो वराहः।\nरामोऽद्रिकूटेष्वथ विप्रवासे सलक्ष्मणोऽव्याद् भरताग्रजो माम्॥ ६/८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.019.m4a", "display_order": 20}, {"id": 6000127020, "chapter_id": 10127, "verse_number": "६-८-१६", "content_sanskrit": "मामुग्रधन्वा अखिलप्रमादान्नारायणः पातु नरश्च हासात्।\nदत्तस्त्वयोगादथ योगनाथः पायाद् गुणेशः कपिलः कर्मबन्धात्॥ ६/८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.020.m4a", "display_order": 21}, {"id": 6000127021, "chapter_id": 10127, "verse_number": "६-८-१७", "content_sanskrit": "सनत्कुमारोऽवतु कामदेवाद्धयशीर्षो मां पथि देवहेलनात्।\nदेवर्षिवर्यः पुरुषान्तरार्चनात् कूर्मो हरिर्मां निरयादशेषात्॥ ६/८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.021.m4a", "display_order": 22}, {"id": 6000127022, "chapter_id": 10127, "verse_number": "६-८-१८", "content_sanskrit": "धन्वन्तरिर्भगवान् पात्वपथ्याद् द्वन्द्वाद् भयाद् ऋषभो निर्जितात्मा।\nयज्ञश्च लोकादुत तत्कृतान्नो बलो गणात् क्रोधवशादहीन्द्रः॥ ६/८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.022.m4a", "display_order": 23}, {"id": 6000127023, "chapter_id": 10127, "verse_number": "६-८-१९", "content_sanskrit": "द्वैपायनो भगवानप्रबोधाद् बुद्धस्तु पाखण्डगणात् प्रमादात्।\nकल्की कलेः कालमलात् प्रपातु धर्मावनायोरुकृतावतारः॥ ६/८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.023.m4a", "display_order": 24}, {"id": 6000127024, "chapter_id": 10127, "verse_number": "६-८-२०", "content_sanskrit": "मां केशवो गदया प्रातरव्याद् गोविन्द आसङ्गव आत्तवेणुः।\nनारायणः प्राह्ण उदात्तशक्तिर्मध्यन्दिने विष्णुररीन्द्रपाणिः॥ ६/८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.024.m4a", "display_order": 25}, {"id": 6000127025, "chapter_id": 10127, "verse_number": "६-८-२१", "content_sanskrit": "देवोऽपराह्णे मधुहोग्रधन्वा सायं त्रिधामाऽवतु माधवो माम्।\nदोषे हृषीकेश उतार्धरात्रे निशीथ एकोऽवतु पद्मनाभः॥ ६/८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.025.m4a", "display_order": 26}, {"id": 6000127026, "chapter_id": 10127, "verse_number": "६-८-२२", "content_sanskrit": "श्रीवत्सलक्ष्माऽपररात्र ईशः प्रत्यूष ईशोऽसिधरो जनार्दनः।\nदामोदरोऽव्यादनुसन्ध्यं प्रभाते विष्णुः श्रीमान् भगवान् कालमूर्तिः॥ ६/८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.026.m4a", "display_order": 27}, {"id": 6000127027, "chapter_id": 10127, "verse_number": "६-८-२३", "content_sanskrit": "चक्रं युगान्तानलतिग्मनेमि भ्रमत् समान्ताद् भगवत्प्रयुक्तम्।\nदन्दग्धि दन्दग्ध्यरिसैन्यमाशु कक्षं यथा वातसखो हुताशः॥ ६/८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.027.m4a", "display_order": 28}, {"id": 6000127028, "chapter_id": 10127, "verse_number": "६-८-२४", "content_sanskrit": "गदेऽशनिस्पर्शनविस्फुलिङ्गे निष्पिण्डि निष्पिण्ड्यजितप्रियाऽसि।\nकूष्माण्डवैनायकयक्षरक्षोभूतग्रहांश्चूर्णय चूर्णयारीन्॥ ६/८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.028.m4a", "display_order": 29}, {"id": 6000127029, "chapter_id": 10127, "verse_number": "६-८-२५", "content_sanskrit": "त्वं यातुधानप्रमथप्रेतमातृपिशाचविप्रग्रहघोरदृष्टीन्।\nदरेन्द्र विद्रावय कृष्णपूरितो भीमस्वनोऽरीन् हृदयानि कम्पयन्॥ ६/८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.029.m4a", "display_order": 30}, {"id": 6000127030, "chapter_id": 10127, "verse_number": "६-८-२६", "content_sanskrit": "त्वं तिग्मधारासिवरारिसैन्यम् ईशप्रयुक्तो मम छिन्धि छिन्धि।\nचक्षूंषि चर्मञ्छतचन्द्र च्छादय द्विषामघं नो हर पापचक्षुषाम्॥ ६/८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.030.m4a", "display_order": 31}, {"id": 6000127031, "chapter_id": 10127, "verse_number": "६-८-२७", "content_sanskrit": "यन्नो भयं ग्रहेभ्योऽभूत् केतुभ्यो नृभ्य एव च।\nसरीसृपेभ्यो दंष्ट्रिभ्यो भूतेभ्योऽघेभ्य एव च॥ ६/८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.031.m4a", "display_order": 32}, {"id": 6000127032, "chapter_id": 10127, "verse_number": "६-८-२८", "content_sanskrit": "सर्वाण्येतानि भगवन्नामरूपास्‍त्रकीर्तनात्।\nप्रयान्तु संक्षयं सद्यो येऽन्ये श्रेयःप्रतीपकाः॥ ६/८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.032.m4a", "display_order": 33}, {"id": 6000127033, "chapter_id": 10127, "verse_number": "६-८-२९", "content_sanskrit": "गरुडो भगवांस्तोत्रस्तोमच्छन्दोमयः प्रभुः।\nरक्षत्वशेषकृच्छ्रेभ्यो विष्वक्सेनः स्वनामभिः॥ ६/८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.033.m4a", "display_order": 34}, {"id": 6000127034, "chapter_id": 10127, "verse_number": "६-८-३०", "content_sanskrit": "सर्वापद्भ्यो हरेर्नामरूपयानायुधानि नः।\nबुद्धीन्द्रियमनःप्राणान् पान्तु पार्षदभूषणाः॥ ६/८/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.034.m4a", "display_order": 35}, {"id": 6000127035, "chapter_id": 10127, "verse_number": "६-८-३१", "content_sanskrit": "यथा हि भगवानेव वस्तुतः सदसच्च यत्।\nसत्येनानेन नः सर्वे यान्तु नाशमुपद्रवाः॥ ६/८/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.035.m4a", "display_order": 36}, {"id": 6000127036, "chapter_id": 10127, "verse_number": "६-८-३२", "content_sanskrit": "यथैकात्म्यानुभावेन विकल्परहितः स्वयम्।\nभूषणायुधलिङ्गाख्या धत्ते शक्तीः स्वमायया॥ ६/८/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.036.m4a", "display_order": 37}, {"id": 6000127037, "chapter_id": 10127, "verse_number": "६-८-३३", "content_sanskrit": "तेनैव सत्यमानेन सर्वज्ञो भगवान् हरिः।\nपातु सर्वैः स्वरूपैर्नः सदा सर्वत्र सर्वगः॥ ६/८/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.037.m4a", "display_order": 38}, {"id": 6000127038, "chapter_id": 10127, "verse_number": "६-८-३४", "content_sanskrit": "विदिक्षु दिक्षूर्ध्वमधः समन्तादन्तर्बहिर्भगवान् नारसिंहः।\nप्रहापयल्लोकभयं स्वनेन स्वतेजसा ग्रस्तसमस्ततेजाः॥ ६/८/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.038.m4a", "display_order": 39}, {"id": 6000127039, "chapter_id": 10127, "verse_number": "६-८-३५", "content_sanskrit": "मघवन्निदमाख्यातं वर्म नारायणात्मकम्।\nविजेष्यस्यञ्जसा येन दंशितोऽसुरयूथपान्॥ ६/८/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.039.m4a", "display_order": 40}, {"id": 6000127040, "chapter_id": 10127, "verse_number": "६-८-३६", "content_sanskrit": "एतद् धारयमाणस्तु यं यं पश्यति चक्षुषा।\nपदा वा संस्पृशेत् सद्यः साध्वसात् स विमुच्यते॥ ६/८/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.040.m4a", "display_order": 41}, {"id": 6000127041, "chapter_id": 10127, "verse_number": "६-८-३७", "content_sanskrit": "न कुतश्चिद् भयं तस्य विद्यां धारयतो भवेत्।\nराजदस्युग्रहादिभ्यो व्याध्यादिभ्यश्च कर्हिचित्॥ ६/८/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.041.m4a", "display_order": 42}, {"id": 6000127042, "chapter_id": 10127, "verse_number": "६-८-३८", "content_sanskrit": "इमां विद्यां पुरा कश्चित् कौशिको धारयन् द्विजः।\nयोगधारणया स्वाङ्गं जहौ स मरुधन्वनि॥ ६/८/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.042.m4a", "display_order": 43}, {"id": 6000127043, "chapter_id": 10127, "verse_number": "६-८-३९", "content_sanskrit": "तस्योपरि विमानेन गन्धर्वपतिरेकदा।\nययौ चित्ररथः स्‍त्रीभिर्वृतो यत्र द्विजक्षयः॥ ६/८/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.043.m4a", "display_order": 44}, {"id": 6000127044, "chapter_id": 10127, "verse_number": "६-८-४०", "content_sanskrit": "साङ्गनो न्यपतत् सद्यः सविमानो ह्यवाक्शिराः॥ ६/८/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.044.m4a", "display_order": 45}, {"id": 6000127045, "chapter_id": 10127, "verse_number": "६-८-४१", "content_sanskrit": "स वालखिल्यवचनादस्थीन्यादाय विस्मितः।\nप्रास्य प्राचीसरस्वत्यां स्नात्वा धाम स्वमन्वगात्॥ ६/८/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.045.m4a", "display_order": 46}, {"id": 6000127046, "chapter_id": 10127, "verse_number": "६-८-४२", "content_sanskrit": "य इदं शृृणुयात् काले यो धारयति चादृतः।\nतं नमस्यन्ति भूतानि मुच्यते सर्वतो भयात्॥ ६/८/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.046.m4a", "display_order": 47}, {"id": 6000127047, "chapter_id": 10127, "verse_number": "६-८-४३", "content_sanskrit": "एतां विद्यामधिगतो विश्वरूपाच्छतक्रतुः।\nत्रैलोक्यलक्ष्मीं बुभुजे विनिर्जित्य मृधेऽसुरान्॥ ६/८/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_008/BhP_06.008.047.m4a", "display_order": 48}, {"id": 6000127048, "chapter_id": 10127, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां षष्ठस्कन्धे अष्टमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]