[{"id": 50004999, "chapter_id": 10895, "verse_number": "1", "content_sanskrit": "॥ [ॐ] उपसंहारोऽर्थाभेदाद् विधिशेषवत् समाने च [ॐ]॥ ३/३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50005000, "chapter_id": 10895, "verse_number": "2", "content_sanskrit": "॥ [ॐ] अन्यथात्वं च शब्दादिति चेन्नाविशेषात् [ॐ]॥ ३/३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50005001, "chapter_id": 10895, "verse_number": "3", "content_sanskrit": "॥ [ॐ] न वा प्रकरणभेदात् परोवरीयस्त्वादिवत् [ॐ]॥ ३/३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50005002, "chapter_id": 10895, "verse_number": "4", "content_sanskrit": "॥ [ॐ] सञ्ज्ञातश्चेत् तदुक्तमस्ति तु तदपि [ॐ]॥ ३/३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]