[{"id": 2035765, "chapter_id": 1775, "verse_number": "५-२०-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2035766, "chapter_id": 1775, "verse_number": "५-२०-१", "content_sanskrit": "स च कौरव्यमासाद्य द्रुपदस्य पुरोहितः।\nसत्कृतो धृतराष्ट्रेण भीष्मेण विदुरेण च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2035767, "chapter_id": 1775, "verse_number": "५-२०-२", "content_sanskrit": "सर्वकौशल्यमुक्त्वाऽऽदौ पृष्ट्वा चैवमनामयम्।\nसर्वसेनाप्रणेतॄणां मध्ये वाक्यमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2035768, "chapter_id": 1775, "verse_number": "५-२०-३", "content_sanskrit": "सर्वैर्भवद्भिर्विदितो राजधर्मः सनातनः।\nवाक्योपादानहेतोस्तु वक्ष्यामि विदिते सति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2035769, "chapter_id": 1775, "verse_number": "५-२०-४", "content_sanskrit": "धृतराष्ट्रश्च पाण्डुश्च सुतावेकस्य विश्रुतौ ।\nतयोः समानं द्रविणं पैतृकं नात्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2035770, "chapter_id": 1775, "verse_number": "५-२०-५", "content_sanskrit": "धृतराष्ट्रस्य ये पुत्राः प्राप्तं तैः पैतृकं वसु।\nपाण्डुपुत्राः कथं नाम न प्राप्ताः पैतृकं वसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2035771, "chapter_id": 1775, "verse_number": "५-२०-६", "content_sanskrit": "वनं गतैः पाण्डवेयैर्विदितं वः पुरा यथा।\nन प्राप्तं पैतृकं द्रव्यं धृतराष्ट्रेण यद्धृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2035772, "chapter_id": 1775, "verse_number": "५-२०-७", "content_sanskrit": "प्राणान्तिकैरप्युपायैः प्रयतद्भिरनेकशः ।\nशेषवन्तो न शकिता नेतुं वै यमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2035773, "chapter_id": 1775, "verse_number": "५-२०-८", "content_sanskrit": "पुनश्च वर्धितं राज्यं स्वबलेन महात्मभिः ।\nछद्मनाऽपहृतं क्षुद्रैर्धार्तराष्ट्रैः ससौबलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2035774, "chapter_id": 1775, "verse_number": "५-२०-९", "content_sanskrit": "तदप्यनुमतं कर्म यथा युक्तमनेन वै।\nवासिताश्च महारण्ये वर्षाणीह त्रयोदश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2035775, "chapter_id": 1775, "verse_number": "५-२०-१०", "content_sanskrit": "सभायां क्लेशितैर्वीरैः सहभार्यैस्तथा भृशम् ।\nअरण्ये विविधाः क्लेशाः संप्राप्तास्तैः सुदारुणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2035776, "chapter_id": 1775, "verse_number": "५-२०-११", "content_sanskrit": "तथा विराटनगरे योन्यन्तरगतैरिव।\nप्राप्तः परमसंक्लेशो यथा पापैर्महात्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2035777, "chapter_id": 1775, "verse_number": "५-२०-१२", "content_sanskrit": "ते सर्वं पृष्ठतः कृत्वा तत्पूर्वं कर्म किल्विषम् ।\nसाम्नैव कुरुभिः सन्धिमिच्छन्ति कुरुपुङ्गवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2035778, "chapter_id": 1775, "verse_number": "५-२०-१३", "content_sanskrit": "तेषां च वृत्तमाज्ञाय वृत्तं दुर्योधनस्य च।\nअनुनेतुमिहार्हन्ति धार्तराष्ट्रं सुहृज्जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2035779, "chapter_id": 1775, "verse_number": "५-२०-१४", "content_sanskrit": "न हि ते विग्रहं वीराः कुर्वन्ति कुरुभिः सह।\nअविनाशेन लोकस्य काङ्क्षन्ते पाण्डवाः स्वकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2035780, "chapter_id": 1775, "verse_number": "५-२०-१५", "content_sanskrit": "यश्चापि धार्तराष्ट्रस्य हेतुः स्याद्विग्रहं प्रति।\nस च हेतुर्न मन्तव्यो बलीयांसस्तथा हि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2035781, "chapter_id": 1775, "verse_number": "५-२०-१६", "content_sanskrit": "अक्षौहिण्यश्च सप्तैव धर्मपुत्रस्य सङ्गताः।\nयुयुत्समानाः कुरुभिः प्रतीक्षन्तेऽस्य शासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2035782, "chapter_id": 1775, "verse_number": "५-२०-१७", "content_sanskrit": "अपरे पुरुषव्याघ्राः सहस्राक्षौहिणीसमाः ।\nसात्यकिर्भीमसेनश्च यमौ च सुमहाबलौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2035783, "chapter_id": 1775, "verse_number": "५-२०-१८", "content_sanskrit": "एकादशैताः पृतना एकतश्च समागताः ।\nएकतश्च महाबाहुर्बहुरूपी धनञ्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2035784, "chapter_id": 1775, "verse_number": "५-२०-१९", "content_sanskrit": "यथा किरीटी सर्वाभ्यः सेनाभ्यो व्यतिरिच्यते।\nएवमेव महाबाहुर्वासुदेवो महाद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2035785, "chapter_id": 1775, "verse_number": "५-२०-२०", "content_sanskrit": "बहुलत्वं च सेनानां विक्रमं च किरीटिनः।\nबुद्धिमत्त्वं च कृष्णस्य बुद्ध्वा युध्येत को नरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2035786, "chapter_id": 1775, "verse_number": "५-२०-२१", "content_sanskrit": "ते भवन्तो यथाधर्मं यथासमयमेव च।\nप्रयच्छन्तु प्रदातव्यं मा वः कालोऽत्यगादयम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2035787, "chapter_id": 1775, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि सञ्जययानपर्वणि विंशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]