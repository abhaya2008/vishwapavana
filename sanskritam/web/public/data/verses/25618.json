[{"id": 7005618000, "chapter_id": 25618, "verse_number": "९१-१", "content_sanskrit": "रौप्याचलदानवर्णनम् ।\nअतः परं प्रवक्ष्यामि रौप्याचलमनुत्तमम् ।\nयत्प्रदानान्नरो याति सोमलोकमनुत्तमम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005618001, "chapter_id": 25618, "verse_number": "९१-२", "content_sanskrit": "दशभिः पलसाहस्रैरुत्तमो रजताचलः ।\nपञ्चभिर्मध्यमः प्रोक्तस्तदर्द्धेनाधमः स्मृतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005618002, "chapter_id": 25618, "verse_number": "९१-३", "content_sanskrit": "अशक्तो विंशतेरूर्द्ध्वं कारयेच्छक्तितस्तदा ।\nविष्कम्भपर्वतास्तद्वत्तुरीयांशेन कल्पयेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005618003, "chapter_id": 25618, "verse_number": "९१-४", "content_sanskrit": "पूर्ववद्राजतान् कुर्वन् मन्दरादीन् विधानतः ।\nकलधौतमयांस्तद्वल्लोकेशानर्चयेद् बुधः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005618004, "chapter_id": 25618, "verse_number": "९१-५", "content_sanskrit": "ब्रह्मविष्ण्वर्कवान् कार्यो नितम्बोऽत्र हिरण्मयः ।\nराजतं स्याद्यदन्येषां सर्वं तदिह काञ्चनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005618005, "chapter_id": 25618, "verse_number": "९१-६", "content_sanskrit": "शेषन्तु पूर्ववत् कुर्यात् होमजागरणादिकम् ।\nदद्यात्ततः प्रभाते तु गुरवे रौप्यपर्वतम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005618006, "chapter_id": 25618, "verse_number": "९१-७", "content_sanskrit": "विष्कम्भशैलानृत्विग्‌भ्यः पूज्य वस्त्रविभूषणैः ।\nइमं मन्त्रं पठन्‌ दद्याद्दर्भपाणिर्विमत्सरः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005618007, "chapter_id": 25618, "verse_number": "९१-८", "content_sanskrit": "पितॄणां वल्लभो यस्माद् हरीन्द्राणां शिवस्य च ।\nपाहि राजत! तस्मात् त्वं शोकसंसारसागरात् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005618008, "chapter_id": 25618, "verse_number": "९१-९", "content_sanskrit": "इत्थं निवेद्य यो दद्याद्रजताचलमुत्तमम् ।\nगवामयुतदानस्य फलं प्राप्नोति मानवः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005618009, "chapter_id": 25618, "verse_number": "९१-१०", "content_sanskrit": "सोमलोकेसगन्धर्वैः किन्नराप्सरसाङ्गणैः ।\nपूज्यमानो वसेद्‌विद्वान्‌ यावदाभूतसम्प्लवम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]