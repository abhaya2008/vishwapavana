[{"id": 2071181, "chapter_id": 2500, "verse_number": "१२-५-०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2071182, "chapter_id": 2500, "verse_number": "१२-५-१", "content_sanskrit": "आदित्कृतबलं कर्णं दृष्ट्वा राजा स मागधः।\nआह्वयद्द्वैरथेनाजौ जरासन्धो महीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2071183, "chapter_id": 2500, "verse_number": "१२-५-२", "content_sanskrit": "तयोः समभवद्युद्धं दिव्यास्त्रविदुषोर्द्वयोः।\nयुधि नानाप्रहरणैरन्योन्यमभिवर्षतोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2071184, "chapter_id": 2500, "verse_number": "१२-५-३", "content_sanskrit": "क्षीणबाणौ विधनुषौ भग्नखङ्गौ महीं गतौ।\nबाहुभिः समसज्जेतामुभावतिबलान्वितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2071185, "chapter_id": 2500, "verse_number": "१२-५-४", "content_sanskrit": "[बाहुकण्टकयुद्धेन तस्य कर्णोऽथ युध्यतः।]\nविभेदं संधिं देहस्य जरया श्लेषितस्य हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2071186, "chapter_id": 2500, "verse_number": "१२-५-५", "content_sanskrit": "स विकारं शरीरस्य दृष्ट्वा नृपतिरात्मनः।\nप्रीतोऽस्मीत्यब्रवीत्कर्णं वैरमुत्सृज्य दूरतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2071187, "chapter_id": 2500, "verse_number": "१२-५-६", "content_sanskrit": "प्रीत्या ददौ स कर्णाय मालिनीं नगरीमनु।\nअङ्गेषु नरशार्दूल स राजाऽऽसीत्सपत्नजित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2071188, "chapter_id": 2500, "verse_number": "१२-५-७", "content_sanskrit": "पालयामास वर्णांस्तु कर्णः परबलार्दनः।\nदुर्योधनस्यानुमते तवापि विदितं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2071189, "chapter_id": 2500, "verse_number": "१२-५-८", "content_sanskrit": "एवं शस्त्रप्रतापेन प्रथितः सोऽभवत्क्षितौ।\nत्वद्धितार्थं सुरेन्द्रेण भिक्षितो वर्मकुण्डले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2071190, "chapter_id": 2500, "verse_number": "१२-५-९", "content_sanskrit": "स दिव्ये सहजे प्रादात्कुण्डले परमार्चिते।\nसहजं कवचं चापि मोहितो देवमायया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2071191, "chapter_id": 2500, "verse_number": "१२-५-१०", "content_sanskrit": "विमुक्तः कुण्डलाभ्यां च सहजेन च वर्मणा।\nनिहतो विजयेनाजौ वासुदेवस्य पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2071192, "chapter_id": 2500, "verse_number": "१२-५-११", "content_sanskrit": "ब्राह्मणस्यापि शापेन रामस्य च महात्मनः।\nकुन्त्याश्च वरदानेन मायया च शतक्रतोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2071193, "chapter_id": 2500, "verse_number": "१२-५-१२", "content_sanskrit": "भीष्मावमानात्सङ्ख्यायां रथानामर्धकीर्तनात्।\nशल्यतेजोवधाच्चापि वासुदेवनयेन च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2071194, "chapter_id": 2500, "verse_number": "१२-५-१३", "content_sanskrit": "रुद्रस्य देवराजस्य यमस्य वरुणस्य च।\nकुबेरद्रोणयोश्चैव कृपस्य च महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2071195, "chapter_id": 2500, "verse_number": "१२-५-१४", "content_sanskrit": "अस्त्राणि दिव्यान्यादाय युधि गाण्डीवधन्वना।\nहतो वैकर्तनः कर्णो दिवाकरसमद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2071196, "chapter_id": 2500, "verse_number": "१२-५-१५", "content_sanskrit": "एवं शप्तस्तव भ्राता बहुभिश्चापि वञ्चितः।\nन शोच्यः पुरुषव्याघ्र युद्धे हि निधनं गतः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2071197, "chapter_id": 2500, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि पञ्चमोऽध्यायः॥ ५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]