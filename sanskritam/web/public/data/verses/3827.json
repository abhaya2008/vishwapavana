[{"id": 2131045, "chapter_id": 3827, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2131046, "chapter_id": 3827, "verse_number": "१", "content_sanskrit": "ततः सूर्योदये धौम्यः पाञ्चालीसहितांश्च तान् ।\nआर्ष्टिषेणेन सहितः पाण्डवानभ्यवर्तत\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2131047, "chapter_id": 3827, "verse_number": "२", "content_sanskrit": "तेऽभिवाद्यार्ष्टिषेणस्य पादौ धौम्यस्य चैव ह ।\nततः प्राञ्जलयः सर्वे ब्राह्मणांस्तानपूजयन्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2131048, "chapter_id": 3827, "verse_number": "३", "content_sanskrit": "ततो युधिष्ठिरं धौम्यो गृहीत्वा दक्षिणे करे ।\nप्राचीं दिशमभिप्रेक्ष्य महर्षिरिदमब्रवीत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2131049, "chapter_id": 3827, "verse_number": "४", "content_sanskrit": "असौ सागरपर्यन्तां भूमिमावृत्य तिष्ठति ।\nशैलराजो महाराज मन्दरोऽति विराजते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2131050, "chapter_id": 3827, "verse_number": "५", "content_sanskrit": "इन्द्रवैश्रवणावेतां दिशं पाण्डव रक्षतः ।\nपर्वतैश्च वनान्तैश्च काननैश्चैव शोभिताम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2131051, "chapter_id": 3827, "verse_number": "६", "content_sanskrit": "एतदाहुर्महेन्द्रस्य राज्ञो वैश्रवणस्य च ।\nऋषयः सर्वधर्मज्ञाः सद्म तात मनीषिणः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2131052, "chapter_id": 3827, "verse_number": "७", "content_sanskrit": "अतश्चोद्यन्तमादित्यमुपतिष्ठन्ति वै प्रजाः ।\nऋषयश्चापि धर्मज्ञाः सिद्धाः साध्याश्च देवताः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2131053, "chapter_id": 3827, "verse_number": "८", "content_sanskrit": "यमस्तु राजा धर्मज्ञः सर्वप्राणभृतां प्रभुः ।\nप्रेतसत्त्वगतिं ह्येनां दक्षिणामाश्रितो दिशम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2131054, "chapter_id": 3827, "verse_number": "९", "content_sanskrit": "एतत्संयमनं पुण्यमतीवाद्भुतदर्शनम् ।\nप्रेतराजस्य भवनमृद्ध्या परमया युतम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2131055, "chapter_id": 3827, "verse_number": "१०", "content_sanskrit": "यं प्राप्य सविता राजन् सत्येन प्रतितिष्ठति ।\nअस्तं पर्वतराजानमेतमाहुर्मनीषिणः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2131056, "chapter_id": 3827, "verse_number": "११", "content_sanskrit": "एतं पर्वतराजानं समुद्रं च महोदधिम् ।\nआवसन् वरुणो राजा भूतानि परिरक्षति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2131057, "chapter_id": 3827, "verse_number": "१२", "content_sanskrit": "उदीचीं दीपयन्नेष दिशं तिष्ठति वीर्यवान् ।\nमहामेरुर्महाभाग शिवो ब्रह्मविदां गतिः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2131058, "chapter_id": 3827, "verse_number": "१३", "content_sanskrit": "यस्मिन् ब्रह्मसदश्चैव भूतात्मा चावतिष्ठते ।\nप्रजापतिः सृजन् सर्वं यत्किञ्चिज्जङ्गमागमम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2131059, "chapter_id": 3827, "verse_number": "१४", "content_sanskrit": "यानाहुर्ब्रह्मणः पुत्रान्मानसान्दक्षसप्तमान्।\nतेषामपि महामेरुः शिवं स्थानमनामयम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2131060, "chapter_id": 3827, "verse_number": "१५", "content_sanskrit": "अत्रैव प्रतितिष्ठन्ति पुनरत्रो(रेवो)दयन्ति च ।\nसप्त देवर्षयस्तात वसिष्ठप्रमुखाः सदा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2131061, "chapter_id": 3827, "verse_number": "१६", "content_sanskrit": "देशं विरजसं पश्य मेरोः शिखरमुत्तमम् ।\nयत्रात्मतृप्तैरध्यास्ते देवैः सह पितामहः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2131062, "chapter_id": 3827, "verse_number": "१७", "content_sanskrit": "यमाहुः सर्वभूतानां प्रकृतेः प्रकृतिं ध्रुवम् ।\nअनादिनिधनं देवं प्रभुं नारायणं परम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2131063, "chapter_id": 3827, "verse_number": "१८", "content_sanskrit": "ब्रह्मणः सदनात् तस्य परं स्थानं प्रकाशते ।\nदेवा अपि न पश्यन्ति सर्वतेजोमयं शुभम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2131064, "chapter_id": 3827, "verse_number": "१९", "content_sanskrit": "अत्यर्कानलदीप्तं तत् स्थानं विष्णोर्महात्मनः ।\nस्वयैव प्रभया राजन् दुष्प्रेक्ष्यं देवदानवैः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2131065, "chapter_id": 3827, "verse_number": "२०", "content_sanskrit": "प्राच्यां नारायणस्थानं मेरावतिविराजते \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2131066, "chapter_id": 3827, "verse_number": "२१", "content_sanskrit": "यत्र भूतेश्वरस्तात सर्वप्रकृतिरात्मभूः\nभासयन् सर्वभूतानि सुश्रियाऽभिविराजते \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2131067, "chapter_id": 3827, "verse_number": "२२", "content_sanskrit": "नात्र ब्रह्मर्षयस्तात कुत एव महर्षयः ।\nप्राप्नुवन्ति गतिं ह्येतां यतीनां कुरुसत्तम\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2131068, "chapter_id": 3827, "verse_number": "२३", "content_sanskrit": "न तं ज्योतींषि सर्वाणि प्राप्य भासन्ति पाण्डव ।\nस्वयं प्रभुरचिन्त्यात्मा तत्र ह्यतिविराजते\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2131069, "chapter_id": 3827, "verse_number": "२४", "content_sanskrit": "यतयस्तत्र गच्छन्ति भक्त्या नारायणं हरिम् ।\nपरेण तपसा युक्ता भाविताः कर्मभिः शुभैः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2131070, "chapter_id": 3827, "verse_number": "२५", "content_sanskrit": "योगसिद्धा महात्मानस्तमोमोहविवर्जिताः ।\nतत्र गत्वा पुनर्नेमं लोकमायान्ति भारत ।\nस्वयम्भुवं महात्मानं देवदेवं सनातनम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2131071, "chapter_id": 3827, "verse_number": "२६", "content_sanskrit": "स्थानमेतन्महाभाग ध्रुवमक्षयमव्ययम् ।\nईश्वरस्य सदा ह्येतत् प्रणमात्र युधिष्ठिर\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2131072, "chapter_id": 3827, "verse_number": "", "content_sanskrit": "एनं त्वहरहर्मेरुं सूर्याचन्द्रमसौ ध्रुवम् ।\nप्रदक्षिणमुपावृत्य कुरुतः कुरुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2131073, "chapter_id": 3827, "verse_number": "", "content_sanskrit": "ज्योतींषि चाप्यशेषेण सर्वाण्यनघ सर्वतः ।\nपरियान्ति महाराज गिरिराजं प्रदक्षिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2131074, "chapter_id": 3827, "verse_number": "२७", "content_sanskrit": "एतं ज्योतींषि सर्वाणि प्रकर्षन् भगवानपि ।\nकुरुते वितमस्कर्मा आदित्योऽभिप्रदक्षिणम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2131075, "chapter_id": 3827, "verse_number": "२८", "content_sanskrit": "अस्तं प्राप्य ततः सन्ध्यामतिक्रम्य दिवाकरः ।\nउदीचीं भजते काष्ठां दिशमेष विभावसुः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2131076, "chapter_id": 3827, "verse_number": "२९", "content_sanskrit": "स मेरुमनुवृत्तः सन् पुनर्गच्छति पाण्डव ।\nप्राङ्मुखः सविता देवः सर्वभूतहिते रतः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2131077, "chapter_id": 3827, "verse_number": "३०", "content_sanskrit": "स मासान् विभजन् काले बहुधा पर्वसन्धिषु ।\nतथैव भगवान् सोमो नक्षत्रैः सह गच्छति\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2131078, "chapter_id": 3827, "verse_number": "३१", "content_sanskrit": "एवमेतं परिक्रम्य महामेरुमतन्द्रितः ।\nसोमश्च विभजन् कालं बहुधा पर्वसन्धिषु \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2131079, "chapter_id": 3827, "verse_number": "३२", "content_sanskrit": "भावयन् सर्वभूतानि पुनर्गच्छति मन्दरम् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2131080, "chapter_id": 3827, "verse_number": "३३", "content_sanskrit": "तथा तमिस्रहा देवो मयूखैर्भावयन् जगत् ।\nमार्गमेतदसम्बाधमादित्यः परिवर्तते\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2131081, "chapter_id": 3827, "verse_number": "३४", "content_sanskrit": "सिसृक्षुः शिशिराण्येष दक्षिणां भजते दिशम् ।\nततः सर्वाणि भूतानि कालोऽभ्यर्च्छति शैशिरः \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2131082, "chapter_id": 3827, "verse_number": "३५", "content_sanskrit": "स्थावराणां च भूतानां जङ्गमानां च तेजसा ।\nतेजांसि समुपादत्ते निवृत्तः स विभावसुः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2131083, "chapter_id": 3827, "verse_number": "३६", "content_sanskrit": "ततः स्वेदक्लमौ तन्द्री ग्लानिश्च भजते नरान् ।\nप्राणिभिः सततं स्वप्नो ह्यभीक्ष्णं च निषेव्यते\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2131084, "chapter_id": 3827, "verse_number": "३७", "content_sanskrit": "एवमेतदनिर्देश्यं मार्गमावृत्य भानुमान् ।\nपुनः सृजति वर्षाणि भगवान् भावयन् प्रजाः \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2131085, "chapter_id": 3827, "verse_number": "३८", "content_sanskrit": "वृष्टिमारुतसन्तापैः सुखैः स्थावरजङ्गमान् ।\nवर्धयन् सुमहातेजाः पुनः प्रतिनिवर्तते\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2131086, "chapter_id": 3827, "verse_number": "३९", "content_sanskrit": "एवमेष चरन् पार्थ कालचक्रमतन्द्रितः ।\nप्रकर्षन् सर्वभूतानि सविता परिवर्तते\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2131087, "chapter_id": 3827, "verse_number": "४०", "content_sanskrit": "सन्तता गतिरेतस्य नैष तिष्ठति पाण्डव ।\nआदायैव तु भूतानां तेजो विसृजते पुनः \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2131088, "chapter_id": 3827, "verse_number": "४१", "content_sanskrit": "विभजन् सर्वभूतानामायुः कर्म च भारत।\nअहोरात्रं कलाः काष्ठाः सृजत्येष सदा विभुः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2131089, "chapter_id": 3827, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि यक्षयुद्धपर्वणि एकोनषष्ट्यशदधिकशततमोऽध्यायः ॥ १५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2131090, "chapter_id": 3827, "verse_number": "६", "content_sanskrit": "यक्षयुद्धपर्वणि षष्ठोऽध्यायः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]