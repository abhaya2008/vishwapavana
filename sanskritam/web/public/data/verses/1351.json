[{"id": 2016774, "chapter_id": 1351, "verse_number": "२-९२-१", "content_sanskrit": "वैशम्पायन उवाच॥\nतथा तु दृष्ट्वा बहु तत्र देवीं\nरोरूयमाणां कुररीमिवार्ताम्।\nनोचुर्वचः साध्वथवाऽप्यसाधु\nमहीक्षितो धार्तराष्ट्रस्य भीताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2016775, "chapter_id": 1351, "verse_number": "२-९२-२", "content_sanskrit": "दृष्ट्वा तथा पार्थिवपुत्रपौत्रां-\nस्तूष्णींभूतान्धृतराष्ट्रस्य पुत्रः।\nस्मयन्निवेदं वचनं बभाषे\nपाञ्चालराजस्य सुतां तदानीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2016776, "chapter_id": 1351, "verse_number": "२-९२-३x", "content_sanskrit": "दुर्योधन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2016777, "chapter_id": 1351, "verse_number": "२-९२-३", "content_sanskrit": "तिष्ठत्वयं प्रश्न उदारसत्वे\nभीमेऽर्जुने सहदेवे तथैव।\nपत्यौ च ते नकुले याज्ञसेनि\nवदन्त्वेते वचनं त्वत्प्रसूतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2016778, "chapter_id": 1351, "verse_number": "२-९२-४", "content_sanskrit": "अनीश्वरं विब्रुवन्त्वार्यमध्ये\nयुधिष्ठिरं तव पाञ्चालि हेतोः।\nकुर्वन्तु सर्वे चानृतं धर्मराजं\nपाञ्चालि त्वं मोक्ष्यसे दासभावात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2016779, "chapter_id": 1351, "verse_number": "२-९२-५", "content_sanskrit": "धर्मे स्थितो धर्मसुतो महात्मा\nस्वयं चेदं कथयत्विन्द्रकल्पः।\nईशो वा ते ह्यनीशोऽथवैष\nवाक्यादस्य क्षिप्रमेकं भजस्व॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2016780, "chapter_id": 1351, "verse_number": "२-९२-६", "content_sanskrit": "सर्वे हीमे कौरवेयाः सभायां\nदुःखान्तरे वर्तमानास्तवैव।\nन विब्रुवन्त्यार्यसत्वा यथाव-\nत्पतींश्च ते समवेक्ष्याल्पभाग्यान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2016781, "chapter_id": 1351, "verse_number": "२-९२-७x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2016782, "chapter_id": 1351, "verse_number": "२-९२-७", "content_sanskrit": "ततः सभ्याः कुरुराजस्य तस्य\nवाक्यं सर्वे प्रशशंसुस्तथोच्चैः।\nचेलावेधांश्चापि चक्रुर्नदन्तो\nहाहेत्यासीदपि चैवार्तनादः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2016783, "chapter_id": 1351, "verse_number": "२-९२-८", "content_sanskrit": "श्रुत्वा तुं तद्वाक्यमनोहरं त-\nद्धर्षश्चासीत्कौरवाणां सभायाम्।\nसर्वे चासन्पार्थिवाः प्रीतिमन्तः\nकुरुश्रेष्ठं धार्मिकं पूजयन्तः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2016784, "chapter_id": 1351, "verse_number": "२-९२-९", "content_sanskrit": "युधिष्ठिरं च ते सर्वे समुदैक्षन्त पार्थिवाः।\nकिं नु वक्ष्यति धर्मज्ञ इति साचीकृताननाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2016785, "chapter_id": 1351, "verse_number": "२-९२-१०", "content_sanskrit": "किं नु वक्ष्यति बीभत्सुरजितो युधि पाण्डवः।\nभीमसेनो यमौ चोभौ भृशं कौतूहलान्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2016786, "chapter_id": 1351, "verse_number": "२-९२-११", "content_sanskrit": "तस्मिन्नुपरते शब्दे भीमसेनोऽब्रवीदिदम्।\nप्रगृह्य रुचिरं दिव्यं भुजं चन्दनचर्चितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2016787, "chapter_id": 1351, "verse_number": "२-९२-१२", "content_sanskrit": "यद्येष गुरुरस्माकं धर्मराजो महामनाः।\nन प्रभुः स्यात्कुलस्यास्य न वयं मर्षयेमहि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2016788, "chapter_id": 1351, "verse_number": "२-९२-१३", "content_sanskrit": "ईशो नः पुण्यतपसां प्राणानामपि चेश्वरः।\nमन्यते जितमात्मानं यद्येष विजिता वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2016789, "chapter_id": 1351, "verse_number": "२-९२-१४", "content_sanskrit": "न हि मुच्येत मे जीवन्पदा भूमिमुपस्पृशन्।\nमर्त्यधर्मा परामृश्य पाञ्चाल्या मूर्धजानिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2016790, "chapter_id": 1351, "verse_number": "२-९२-१५", "content_sanskrit": "पश्यध्वं ह्यायतौ वृत्तौ भुजौ मे परिघाविव।\nनैतयोरन्तरं प्राप्य मुच्येतापि शतक्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2016791, "chapter_id": 1351, "verse_number": "२-९२-१६", "content_sanskrit": "धर्मपाशसितस्त्वेवमधिगच्छामि सङ्कटम्।\nगौरवेण निरुद्धश्च निग्रहादर्जुनस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2016792, "chapter_id": 1351, "verse_number": "२-९२-१७", "content_sanskrit": "धर्मराजनिसृष्टस्तु सिंहः क्षुद्रमृगानिव।\nधार्तराष्टारानिमान्पापान्निष्पषेयं तलासिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2016793, "chapter_id": 1351, "verse_number": "२-९२-१८x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2016794, "chapter_id": 1351, "verse_number": "२-९२-१८", "content_sanskrit": "तमुवाच तदा भीष्मो द्रोणो विदुर एव च।\nक्षम्यतामिदमित्येवं सर्वं सम्भाव्यते त्वयि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2016795, "chapter_id": 1351, "verse_number": "२-९२-१९x", "content_sanskrit": "कर्ण उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2016796, "chapter_id": 1351, "verse_number": "२-९२-१९", "content_sanskrit": "त्रयः किलेमे ह्यधना भवन्ति।\nदासः पुत्रश्चास्वतन्त्रा च नारी।\nदासस्य पत्नी त्वधनस्य भद्रे\nहीनश्वरा दासधनं च सर्वम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2016797, "chapter_id": 1351, "verse_number": "२-९२-२०", "content_sanskrit": "प्रविश्य राज्ञः परिवारं भजस्व\nतत्ते कार्यं शिष्टमादिश्यतेऽत्र।\nईशास्तु सर्वे तव राजपुत्रि\nभवन्ति वै धार्तराष्ट्रा न पार्थाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2016798, "chapter_id": 1351, "verse_number": "२-९२-२१", "content_sanskrit": "अन्यं वृणीष्व पतिमाशु भामिनि\nयस्माद्दास्यं न लभसि देवनेन।\nअवाच्या वै पतिषु कामवृत्ति-\nर्नित्यं दास्ये विदितं तत्तवास्तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2016799, "chapter_id": 1351, "verse_number": "२-९२-२२", "content_sanskrit": "पराजितो नकुलो भीमसेनो\nयुधिष्ठरः सहदेवार्जुनौ च।\nदासीभूता त्वं हि वै याज्ञसेनि\nपराजितास्ते पतयो नैव सन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2016800, "chapter_id": 1351, "verse_number": "२-९२-२३", "content_sanskrit": "प्रयोजनं जन्मनि किं न मन्यते\nपराक्रमं पौरुषं चैव पार्थटः।\nपाञ्चाल्यस्य द्रुपदस्यात्मजामिमां\nसभामध्ये यो व्यदेवीद्ग्लहेषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2016801, "chapter_id": 1351, "verse_number": "२-९२-२४x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2016802, "chapter_id": 1351, "verse_number": "२-९२-२४", "content_sanskrit": "तद्वै श्रुत्वा भीमसेनोऽत्यमर्षी\nभृशं निशश्वास तदाऽर्तरूपः।\nराजानुगो धर्मपाशानुबद्धो\nदहन्निवैनं क्रोधसंरक्तदृष्टिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2016803, "chapter_id": 1351, "verse_number": "२-९२-२५x", "content_sanskrit": "भीम उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2016804, "chapter_id": 1351, "verse_number": "२-९२-२५", "content_sanskrit": "नाहं कुप्ये सूतपुत्रस्य राज-\nन्नेष सत्यं दासधर्मः प्रदिष्टः।\nकिं विद्विषो वै मामेवं व्याहरेयु-\nर्नादेवीस्त्वं यद्यनया नरेन्द्र॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2016805, "chapter_id": 1351, "verse_number": "२-९२-२६x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2016806, "chapter_id": 1351, "verse_number": "२-९२-२६", "content_sanskrit": "भीमसेनवचः श्रुत्वा राजा दुर्योधनस्तदा।\nयुधिष्ठिरमुवाचेदं तूष्णीम्भूतमचेतनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2016807, "chapter_id": 1351, "verse_number": "२-९२-२७", "content_sanskrit": "भीमार्जुनौ यमौ चैव स्थितौ ते नृप शासने।\nप्रश्नं ब्रूहि च कृष्णां त्वमजितां यदि मन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2016808, "chapter_id": 1351, "verse_number": "२-९२-२८", "content_sanskrit": "एवमुक्त्वा तु कौन्येयमपोह्य वसनं स्वकम्।\nस्मयन्निवेक्ष्य पाञ्चालीमैश्वर्यमदमोहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2016809, "chapter_id": 1351, "verse_number": "२-९२-२९", "content_sanskrit": "कदलीदण्डसदृशं सर्वलक्षणसंयुतम्।\nगजहस्तप्रतीकाशं वज्रप्रतिमगौरवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2016810, "chapter_id": 1351, "verse_number": "२-९२-३०", "content_sanskrit": "अभ्युत्स्मयित्वा राधेयं भीममाधर्षयन्निव।\nद्रौपद्याः प्रेक्षमाणायाः सव्यमूरुमदर्शयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2016811, "chapter_id": 1351, "verse_number": "२-९२-३१", "content_sanskrit": "भीमसेनस्तमालोक्य नेत्रे उत्फाल्य लोहिते।\nप्रोवाच राजमध्ये तं सभां विश्रावयन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2016812, "chapter_id": 1351, "verse_number": "२-९२-३२", "content_sanskrit": "पितृभिः सह सालोक्यं मा स्म गच्छेद्वृकोदरः।\nयद्येतमूरुं गदया न भिन्द्यां ते महाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2016813, "chapter_id": 1351, "verse_number": "२-९२-३३x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2016814, "chapter_id": 1351, "verse_number": "२-९२-३३", "content_sanskrit": "क्रुद्धस्य तस्य सर्वेभ्यः स्रोतोभ्यः पावकार्चिषः।\nवृक्षस्येव विनिश्वेरुः कोटरेभ्यः प्रदह्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2016815, "chapter_id": 1351, "verse_number": "२-९२-३४x", "content_sanskrit": "विदुर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2016816, "chapter_id": 1351, "verse_number": "२-९२-३४", "content_sanskrit": "परं भयं पश्यत भीमसेना-\nत्तद्बुध्यध्वं पार्थिवाः प्रातिपेयाः।\nदैवेरितो नूनमयं पुरस्ता-\nत्परोऽनयो भरतेषूदपादि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2016817, "chapter_id": 1351, "verse_number": "२-९२-३५", "content_sanskrit": "अतिद्यूतं कृतमिदं धार्तराष्ट्र\nयस्मात्स्त्रियं विवदध्वं सभायाम्।\nयोगक्षेमौ नश्यतो वः समग्रौ\nपापान्मन्त्रान्कुरवो मन्त्रयन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2016818, "chapter_id": 1351, "verse_number": "२-९२-३६", "content_sanskrit": "इमं धर्मं कुरवो जानताशु\nध्वस्ते धर्मे परिषत्सम्प्रदुष्येत्।\nइमां चेत्पूर्वं कितवोऽग्लहिष्य-\nदीशोऽभविष्यदपराजितात्मा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2016819, "chapter_id": 1351, "verse_number": "२-९२-३७", "content_sanskrit": "स्वप्ने यथैतद्विजितं धनं स्या-\nदेवं मन्ये यस्य दीव्यत्यनीशः।\nगान्धारराजस्य वचो निशम्य\nधर्मादस्मात्कुरवो माऽपयात॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2016820, "chapter_id": 1351, "verse_number": "२-९२-३८x", "content_sanskrit": "दुर्योधन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2016821, "chapter_id": 1351, "verse_number": "२-९२-३८", "content_sanskrit": "भीमस्य वाक्ये तद्वदेवार्जुनस्य\nस्थितोऽहं वै यमयोश्चैवमेव।\nयुधिष्ठिरं ते प्रवदन्त्वनीश-\nमथो दास्यान्मोक्षसे याज्ञसेनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2016822, "chapter_id": 1351, "verse_number": "२-९२-३९x", "content_sanskrit": "अर्जुन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2016823, "chapter_id": 1351, "verse_number": "२-९२-३९", "content_sanskrit": "ईशो राजा पूर्वमासीद्ग्लहे नः\nकुन्तीसुतो धर्मराजो महात्मा।\nईशस्त्वयं कस्य पराजितात्मा\nतज्जानीध्वं कुरवः सर्व एव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2016824, "chapter_id": 1351, "verse_number": "२-९२-४०x", "content_sanskrit": "कर्ण उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2016825, "chapter_id": 1351, "verse_number": "२-९२-४०", "content_sanskrit": "दुश्शासन निबोधेदं वचनं वै प्रभाषितम्।\nकिमनेन चिरं वीर नयस्व द्रपदात्मजाम्।\nदासीभावेन भुङ्क्ष्व त्वं यथेष्टं कुरुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2016826, "chapter_id": 1351, "verse_number": "२-९२-४१x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2016827, "chapter_id": 1351, "verse_number": "२-९२-४१", "content_sanskrit": "ततो गान्धारराजस्य पुत्रः शकुनिरब्रवीत्।\nसाधु कर्ण महाबाहो यथेष्टं क्रियतामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2016828, "chapter_id": 1351, "verse_number": "२-९२-४२", "content_sanskrit": "ततो दुश्शासनस्तूर्णं द्रुपदस्य सुतां बलात्।\nप्रवेशयितुमारब्धः स चकर्ष दुरात्मवान्॥\nततो विक्रोशति तदा पाञ्चाली वरवर्णिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2016829, "chapter_id": 1351, "verse_number": "२-९२-४४x", "content_sanskrit": "द्रौपद्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2016830, "chapter_id": 1351, "verse_number": "२-९२-४४", "content_sanskrit": "परित्रायस्व मां भीष्ण द्रोण द्रौणे तथा कृप।\nपरित्रायस्व विदुर धर्मिष्ठो धर्मवत्सल॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2016831, "chapter_id": 1351, "verse_number": "२-९२-४५", "content_sanskrit": "धृतराष्ट्र महाराज परित्रायस्व वै स्नुषाम्।\nगान्धारि त्वं महाभागे सर्वज्ञे सर्वदर्शिनि।\nपिरत्रायस्व मां भीरुं सुयोधनभयार्दिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2016832, "chapter_id": 1351, "verse_number": "२-९२-४६", "content_sanskrit": "त्वमार्ये वीरजननि किं मां पश्यसि यादवीम्।\nक्लिश्यमानामनार्येण न त्रायसिव वधूं स्वकाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2016833, "chapter_id": 1351, "verse_number": "२-९२-४७", "content_sanskrit": "यदि लालप्यमानां मां न कश्चित्किञ्चिदब्रवीत्।\nहा हताऽस्मि सुमन्दात्मा सुयोधनवशं गता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2016834, "chapter_id": 1351, "verse_number": "२-९२-४८", "content_sanskrit": "न वै पाण्डुर्नरपतिर्न धर्मो न च देवराट्।\nन चायुर्नाश्विनौ वाऽपि परित्रायन्ति वै स्नुषाम्॥\nधिक्कष्टं यदि जीवेयं मन्दभाग्या पतिव्रता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2016835, "chapter_id": 1351, "verse_number": "२-९२-५०x", "content_sanskrit": "विदुर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2016836, "chapter_id": 1351, "verse_number": "२-९२-५०", "content_sanskrit": "शृणोमि वाक्यं तव राजपुत्रि\nनेमे पार्थाः किञ्चिदपि ब्रुवन्ति।\nसा त्वं प्रियार्थं शृणु वाक्यमेत-\nद्यदुच्यते पापमतिः कृतघ्नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2016837, "chapter_id": 1351, "verse_number": "२-९२-५१", "content_sanskrit": "सुयोधनः सानुचरः सुदुष्टः\nसहैव राजा निकृतः सूनुना च\nयद्येष वाचं महदुच्यमानां\nन श्रोष्यते पापमतिः सुदुष्टः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2016838, "chapter_id": 1351, "verse_number": "२-९२-५२x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2016839, "chapter_id": 1351, "verse_number": "२-९२-५२", "content_sanskrit": "इत्येवमुक्त्वा द्रुपदस्य पुत्रीं\nक्षत्ताऽब्रवीद्धृतराष्ट्रस्य पुत्रम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2016840, "chapter_id": 1351, "verse_number": "२-९२-५३", "content_sanskrit": "मा क्लिश्यतां वै द्रुपदस्य पुत्रीं\nमा त्वं चरीं द्रक्ष्यसि राजपुत्र॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2016841, "chapter_id": 1351, "verse_number": "२-९२-५४x", "content_sanskrit": "विदुर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2016842, "chapter_id": 1351, "verse_number": "२-९२-५४", "content_sanskrit": "यद्येवं त्वं महाराज सङ्क्लेशयसि द्रौपदीम्।\nअचिरेणैव कालेन पुत्रस्ते सह मन्त्रिभिः।\nगमिष्यति क्षयं पापः पाण्डवक्षयकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2016843, "chapter_id": 1351, "verse_number": "२-९२-५५", "content_sanskrit": "भीमार्जुनाभ्यां क्रुद्धाभ्यां माद्रीपुत्रद्वयेन च।\nतस्मान्निवारय सुतं मा विनाशं विचिन्तय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2016844, "chapter_id": 1351, "verse_number": "२-९२-५६x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2016845, "chapter_id": 1351, "verse_number": "२-९२-५६", "content_sanskrit": "एतच्छुत्वा मन्दबुद्धिर्नोत्तरं किञ्चिदब्रवीत्।\nततो दुर्योधनस्तत्र दैवमोहबलात्कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2016846, "chapter_id": 1351, "verse_number": "२-९२-५७", "content_sanskrit": "अचिन्त्य क्षत्तुर्वचनं हर्षेणायतलोचनः।\nऊरू दर्शयते पापो द्रौपद्या वै मुहुर्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2016847, "chapter_id": 1351, "verse_number": "२-९२-५८", "content_sanskrit": "ऊरौ सन्दर्श्यमाने तु निरीक्ष्य तु सुयोधनम्।\nवृकोदरस्तदालोक्य नेत्रे चोल्फाल्य लोहिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2016848, "chapter_id": 1351, "verse_number": "२-९२-५९", "content_sanskrit": "एतत्समीक्ष्यात्मनि चावमानं\nनियम्य मन्युं बलनान्स मानी।\nराजानुजः संसदि कौरवाणां\nविनिष्क्रमन्वाक्यमुवाच भीमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2016849, "chapter_id": 1351, "verse_number": "२-९२-६०", "content_sanskrit": "अहं दुर्योधनं हन्ता कर्णं हन्ता धनञ्जयः।\nशकुनिं चाक्षकितवं सहदेवो हनिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2016850, "chapter_id": 1351, "verse_number": "२-९२-६१", "content_sanskrit": "इदं च भूयो वक्ष्यामि सभामध्ये बृहद्वचः।\nसत्यं देवाः करिष्यन्ति यन्नो युद्धं भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2016851, "chapter_id": 1351, "verse_number": "२-९२-६२", "content_sanskrit": "सुयोधनमिमं पापं हन्ताऽस्मि गदया युधि।\nशिरः पादेन चास्याहमधिष्ठास्यामि भूतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2016852, "chapter_id": 1351, "verse_number": "२-९२-६३", "content_sanskrit": "वक्षः शूरस्य निर्वास्य परुषस्य दुरात्मनः।\nदुश्शासनस्य रुधिरं पास्यामि मृगराडिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2016853, "chapter_id": 1351, "verse_number": "२-९२-६४x", "content_sanskrit": "अर्जुन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2016854, "chapter_id": 1351, "verse_number": "२-९२-६४", "content_sanskrit": "भीमसेन न ते सन्ति येषां वैरं त्वया सह।\nनन्दा गृहेषु न बुद्ध्यन्ते महद्भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2016855, "chapter_id": 1351, "verse_number": "२-९२-६५", "content_sanskrit": "नैव वाचा व्यवसितं भीम विज्ञायते सताम्।\nयदि स्थास्यन्ति सङ्ग्रामे क्षत्रधर्मेण वै सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2016856, "chapter_id": 1351, "verse_number": "२-९२-६६", "content_sanskrit": "दुर्योधनस्य कर्णस्य शकुनेश्च दुरात्मनः।\nदुश्शासनचतुर्थानां भूमिः पास्यति शोणितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2016857, "chapter_id": 1351, "verse_number": "२-९२-६७", "content_sanskrit": "असूयितारं वक्तारं प्रहृष्टानां दुरात्मनाम्।\nभीमसेन नियोगात्ते हन्ताऽहं कर्णमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2016858, "chapter_id": 1351, "verse_number": "२-९२-६८", "content_sanskrit": "कर्णं कर्णानुगांश्चैव रणे हन्ताऽस्मि पत्रिभिः।\nये चान्ये विप्रयोत्स्यन्ति बुद्धिमोहेन मां नृपाः।\nतान्स्म सर्वञ्छितैर्बाणैर्नेताऽस्मि यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2016859, "chapter_id": 1351, "verse_number": "२-९२-६९", "content_sanskrit": "चलेद्वि हिमवान्स्थानान्निष्प्रभः स्याद्दिवाकरः।\nशैत्यं सोमात्प्रणश्येत मत्सत्यं विचलेद्यदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2016860, "chapter_id": 1351, "verse_number": "२-९२-७०x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2016861, "chapter_id": 1351, "verse_number": "२-९२-७०", "content_sanskrit": "उत्युक्तवति पार्थे तु श्रीमान्माद्रवतीसुतः।\nप्रगृह्य विपुलं बाहुं सहदेवः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2016862, "chapter_id": 1351, "verse_number": "२-९२-७१", "content_sanskrit": "सौबलस्य वधप्रेप्सुरिदं वचनमब्रवीत्।\nक्रोधसंरक्तनयनो निश्वस्य च मुहुर्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2016863, "chapter_id": 1351, "verse_number": "२-९२-७२x", "content_sanskrit": "सहदेव उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2016864, "chapter_id": 1351, "verse_number": "२-९२-७२", "content_sanskrit": "यानक्षान्मन्यसे मूढ गान्धाराणां यशोहर।\nनैते ह्यक्षाः शिता वाणास्त्वयैते समरे धृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2016865, "chapter_id": 1351, "verse_number": "२-९२-७३", "content_sanskrit": "यथा चैवोक्तवान्भीमस्त्वामुद्दिश्य सबान्धवम्।\nकर्ताऽहं कर्मणा चास्य कुरुकार्याणि सर्वशः।\nयदि स्थस्यासि सङ्ग्रामे क्षत्रधर्मेण सौबल॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2016866, "chapter_id": 1351, "verse_number": "२-९२-७४x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2016867, "chapter_id": 1351, "verse_number": "२-९२-७४", "content_sanskrit": "सहदेववचः श्रुत्वा नकुलोऽपि विशाम्पते।\nदर्शनीयतमो नॄणामिदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2016868, "chapter_id": 1351, "verse_number": "२-९२-७५x", "content_sanskrit": "नकुल उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2016869, "chapter_id": 1351, "verse_number": "२-९२-७५", "content_sanskrit": "सुतेयं यज्ञसेनस्य द्यूतेऽस्मिन्धृतराष्ट्रजैः।\nयैर्वाचः श्राविता रूक्षा धूर्तैर्दुर्योधनप्रियैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2016870, "chapter_id": 1351, "verse_number": "२-९२-७६", "content_sanskrit": "धार्तराष्ट्रान्सुदुर्वृत्तान्मुमूर्षून्कालचोदितान्।\nदर्शयिष्यामि भूयिष्ठमहं वैवस्वतक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2016871, "chapter_id": 1351, "verse_number": "२-९२-७७", "content_sanskrit": "उलूकं च दुरात्मानं सौबलस्य प्रियं सुतम्।\nहन्ताऽहमस्मि समरे मम शत्रुं नराधमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2016872, "chapter_id": 1351, "verse_number": "२-९२-७८", "content_sanskrit": "निदेशाद्धर्मराजस्य द्रौपद्याः पदवीं चरन्।\nनर्धार्तराष्टां पृथिवीं कर्तास्मि नचिरादिवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2016873, "chapter_id": 1351, "verse_number": "२-९२-७९x", "content_sanskrit": "द्रौपद्युवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2016874, "chapter_id": 1351, "verse_number": "२-९२-७९", "content_sanskrit": "यस्माच्चोरुं दर्शयसे यस्माच्चोरुं निरीक्षसे।\nतस्मात्तव ह्यधर्मिष्ठ ऊरौ मृत्युर्भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2016875, "chapter_id": 1351, "verse_number": "२-९२-८०", "content_sanskrit": "यस्माच्चैवं क्लेशयति भ्राता ते मां दुरात्मवान्।\nतस्मादुधिरमेवास्य पास्यते वै वृकोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2016876, "chapter_id": 1351, "verse_number": "२-९२-८१", "content_sanskrit": "इमं च पापिष्ठमतिं कर्णं समुतबान्धवम्।\nसामात्यं सपरीवारं हनिष्यति धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2016877, "chapter_id": 1351, "verse_number": "२-९२-८२", "content_sanskrit": "क्षुद्रधर्मं नैकृतिकं शकुनिं पापचेतसम्।\nसहदेवो रणे क्रुद्धो हनिष्यति सबान्धवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2016878, "chapter_id": 1351, "verse_number": "२-९२-८३x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2016879, "chapter_id": 1351, "verse_number": "२-९२-८३", "content_sanskrit": "एवमुक्ते तु वचने द्रौपद्या धर्मशीलया।\nततोऽन्तरिक्षात्सुमहत्पुष्पवर्षमवापततम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2016880, "chapter_id": 1351, "verse_number": "२-९२-८४", "content_sanskrit": "तेषां तु वचनं श्रुत्वा नोचुस्तत्र सभासदः।\nअर्जुनस्य भयाद्राजन्नभून्निश्शब्दमत्र वै॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2016881, "chapter_id": 1351, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि द्यूतपर्वणि द्विनवतितमोऽध्यायः॥९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}]