[{"id": 7004063000, "chapter_id": 24063, "verse_number": "४-१२-१", "content_sanskrit": "शिवशर्मोवाच ।\nनैरृतादीन् क्रमाल्लोकानाख्यातं पुरुषोत्तमौ ।\nपुरुषोत्तमपादाब्जपरागोद्धूसरालकौ ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004063001, "chapter_id": 24063, "verse_number": "४-१२-२", "content_sanskrit": "गणावूचतुः ।\nआकर्णय महाभाग संयमिन्याः पुरीं पराम् ।\nदिक्पतेर्निरृतस्यासौ पुण्यापुण्यजनोषिता ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004063002, "chapter_id": 24063, "verse_number": "४-१२-३", "content_sanskrit": "राक्षसानिवसंत्यस्यामपरद्रोहिणः सदा ।\nजातिमात्रेण रक्षांसि वृत्तैः पुण्यजना इमे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004063003, "chapter_id": 24063, "verse_number": "४-१२-४", "content_sanskrit": "स्मृत्युक्तश्रुतिवर्त्मानो जातवर्णावरेष्वपि ।\nनाद्रियंतेऽन्नपानानामस्मृत्युक्तं कदाचन ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004063004, "chapter_id": 24063, "verse_number": "४-१२-५", "content_sanskrit": "परदार परद्रव्य परद्रोहपराङ्मुखाः ।\nजाताजातौ निकृष्टायामपिपुण्यानुसारिणः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004063005, "chapter_id": 24063, "verse_number": "४-१२-६", "content_sanskrit": "द्विजातिभक्त्युत्पन्नार्थैरात्मानं पोषयंति ये ।\nसदा संकुचितांगाश्च द्विजसंभाषणादिषु ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004063006, "chapter_id": 24063, "verse_number": "४-१२-७", "content_sanskrit": "आहूता वस्त्रवदना वदंति द्विजसंनिधौ ।\nजयजीवभगोनाथ स्वामिन्निति हि वादिनः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004063007, "chapter_id": 24063, "verse_number": "४-१२-८", "content_sanskrit": "तीर्थस्नानपरानित्यं नित्यं देवपरायणाः ।\nद्विजेषु नित्यं प्रणताः स्वनामाख्यानपूर्वकम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004063008, "chapter_id": 24063, "verse_number": "४-१२-९", "content_sanskrit": "दम दान दया क्षांति शौचेंद्रिय विनिग्रहाः ।\nअस्तेय सत्याहिंसाश्च सर्वेषां धर्महेतवः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004063009, "chapter_id": 24063, "verse_number": "४-१२-१०", "content_sanskrit": "आवश्येषु सदोद्युक्ता ये जाता यत्रकुत्रचित् ।\nसर्वभोगसमृद्धास्ते वसंत्यत्र पुरोत्तमे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004063010, "chapter_id": 24063, "verse_number": "४-१२-११", "content_sanskrit": "म्लेच्छा अपि सुतीर्थेषु ये मृतानात्मघातकाः ।\nविहाय काशीं निर्वाण विश्राणांतेऽत्र भोगिनः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004063011, "chapter_id": 24063, "verse_number": "४-१२-१२", "content_sanskrit": "अंधं तमो विशेयुस्ते ये चैवात्महनो जनाः ।\nभुक्त्वा निरयसाहस्रं ते च स्युर्ग्रामसूकराः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004063012, "chapter_id": 24063, "verse_number": "४-१२-१३", "content_sanskrit": "आत्मघातो न कर्तव्यस्तस्मात्क्वापि विपश्चिता ।\nइहापि च परत्रापि न शुभान्यात्मघातिनाम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004063013, "chapter_id": 24063, "verse_number": "४-१२-१४", "content_sanskrit": "यथेष्टमरणं केचिदाहुस्तत्त्वावबोधकाः ।\nप्रयागे सर्वतीर्थानां राज्ञिसर्वाभिलाषदे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004063014, "chapter_id": 24063, "verse_number": "४-१२-१५", "content_sanskrit": "अंत्यजा अपि ये केचिद्दयाधर्मानुसारिणः ।\nपरोपकृतिनिष्ठास्ते वसंत्यत्र तु सत्तमाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004063015, "chapter_id": 24063, "verse_number": "४-१२-१६", "content_sanskrit": "अस्य स्वरूपं वक्ष्यावो दिक्पतेः क्षणतः शृणु ।\nमध्ये विंध्याटवि पुरा पक्कणस्थजनाग्रणीः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004063016, "chapter_id": 24063, "verse_number": "४-१२-१७", "content_sanskrit": "पल्लीपतिरभूदुग्रः पिंगाक्ष इति विश्रुतः ।\nनिर्विंध्यायास्तटे शूरः क्रूरकर्मपराङ्मुखः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004063017, "chapter_id": 24063, "verse_number": "४-१२-१८", "content_sanskrit": "घातयेद्दूरसंस्थोपि यः पांथपरिपंथिनः ।\nव्याघ्रादीन् दुष्टसत्त्वांश्च स हिनस्ति प्रयत्नतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004063018, "chapter_id": 24063, "verse_number": "४-१२-१९", "content_sanskrit": "जीवेन्मृगयु धर्मेण तत्रापि करुणापरः ।\nन विश्वस्तान्पक्षिमृगान्न सुप्तान्न व्यवायिनः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004063019, "chapter_id": 24063, "verse_number": "४-१२-२०", "content_sanskrit": "न तोयगृध्नून्न शिशून्नांतर्वर्त्नित्वलक्षणान् ।\nस घातयति धर्मज्ञो जातिधर्मपराङ्मुखः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004063020, "chapter_id": 24063, "verse_number": "४-१२-२१", "content_sanskrit": "श्रमातुरेभ्यः पांथेभ्यः स विश्रामं प्रयच्छति ।\nहरेत्क्षुधा क्षुधार्तानामुपानद्दोऽनुपानहे ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004063021, "chapter_id": 24063, "verse_number": "४-१२-२२", "content_sanskrit": "मृगत्त्वचोतिमृदुला विवस्त्रेभ्यातिसर्जति ।\nअनुव्रजति कांतारे प्रांतरे पथिकान्पथि ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004063022, "chapter_id": 24063, "verse_number": "४-१२-२३", "content_sanskrit": "न जिघृक्षति तेभ्योर्थमभयं चेति यच्छति ।\nआविंध्याटवि मे नाम ग्राह्यं दुष्टभयापहम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004063023, "chapter_id": 24063, "verse_number": "४-१२-२४", "content_sanskrit": "नित्यं कार्पटिकान्सर्वान् स पुत्रेण प्रपश्यति ।\nतेपि च प्रतितीर्थं हि तमाशीर्वादयं ति वै ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004063024, "chapter_id": 24063, "verse_number": "४-१२-२५", "content_sanskrit": "इति तिष्ठति पिंगाक्षे साटवी नगरायिता ।\nअध्वनीने ऽध्वगान्कोपि न रुणद्धि ससाध्वसः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004063025, "chapter_id": 24063, "verse_number": "४-१२-२६", "content_sanskrit": "कदाचित्तत्पितृव्येण समीप ग्रामवासिना ।\nश्रुतः कार्पटिकानां हि सार्थः सार्थो महास्वनः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004063026, "chapter_id": 24063, "verse_number": "४-१२-२७", "content_sanskrit": "लुब्धकस्तद्धने लुब्धः क्षुद्रस्तन्निधनोद्यतः ।\nस रुरोध तमध्वानमग्रे गत्वाऽतिगूढवत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004063027, "chapter_id": 24063, "verse_number": "४-१२-२८", "content_sanskrit": "तदा युप्यस्यशेषेण पिंगाक्षो मृगयां गतः ।\nतस्मिन्नरण्ये तन्मार्गं निकषाध्युषितो निशि ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004063028, "chapter_id": 24063, "verse_number": "४-१२-२९", "content_sanskrit": "परप्राणद्रुहां पुंसां न सिद्ध्येयुर्मनोरथाः ।\nविश्वं कुशलितेनैतद्विश्वेशपरिरक्षितम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004063029, "chapter_id": 24063, "verse_number": "४-१२-३०", "content_sanskrit": "न चिंतयेदनिष्टानि तस्मात्कृष्टिः कदाचन ।\nविधिदृष्टं यतो भावि कलुषंभावि केवलम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004063030, "chapter_id": 24063, "verse_number": "४-१२-३१", "content_sanskrit": "तस्मादात्मसुखंप्रेप्सु रिष्टानिष्टं न चिंतयेत् ।\nचिंतयेच्चेत्तदाचिंत्यो मोक्षोपायो न चेतरः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004063031, "chapter_id": 24063, "verse_number": "४-१२-३२", "content_sanskrit": "व्युष्टायामथयामिन्यामभूत्कोलाहलो महान् ।\nघातयध्वं पातयध्वं नग्नयध्वं द्रुतं भटाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004063032, "chapter_id": 24063, "verse_number": "४-१२-३३", "content_sanskrit": "मा मारयध्वं त्रायध्वं भटाः कार्पटिका वयम् ।\nअनायासं लुंठयध्वं नयध्वं च यदस्ति नः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004063033, "chapter_id": 24063, "verse_number": "४-१२-३४", "content_sanskrit": "वयं पांथा अनाथाः स्मो विश्वनाथपरायणाः ।\nसनाथास्ते न दूरं सनाथतां पथिकोऽपरः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004063034, "chapter_id": 24063, "verse_number": "४-१२-३५", "content_sanskrit": "वयं पिंगाक्षविश्वासादस्मिन्मार्गेऽकुतोभयाः ।\nयातायातं सदा कुर्मः स च दूर इतो वनात् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004063035, "chapter_id": 24063, "verse_number": "४-१२-३६", "content_sanskrit": "इति श्रुत्वाऽथ पिंगाक्षो भटः कार्पटिकेरितम ।\nदूरान्मा भैष्ट माभैष्ट ब्रुवन्निति समागतः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004063036, "chapter_id": 24063, "verse_number": "४-१२-३७", "content_sanskrit": "तत्कर्मसूत्रैराकृष्टो भिल्लःकार्पटिकप्रियः ।\nतूर्णं तदायुष्यमिव तत्रोपस्थितवान् क्षणात् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004063037, "chapter_id": 24063, "verse_number": "४-१२-३८", "content_sanskrit": "कोयंकोयं दुराचारः पिंगाक्षे मयि जीवति ।\nउल्लुलुंठयिषुः पांथान्प्राणलिंगसमान्मम ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004063038, "chapter_id": 24063, "verse_number": "४-१२-३९", "content_sanskrit": "इति तद्वाक्यमाकर्ण्य ताराक्षस्तत्पितृव्यकः ।\nधनलोभेन पिंगाक्षे पापं पापो व्यचिंतयत् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004063039, "chapter_id": 24063, "verse_number": "४-१२-४०", "content_sanskrit": "कुलधर्मं व्यपास्यैष वर्तते कुलपांसनः ।\nचिरं चिंतितमद्यामुं घातयिष्याम्यसंशयम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004063040, "chapter_id": 24063, "verse_number": "४-१२-४१", "content_sanskrit": "विचार्येति स दुष्टात्मा भृत्यानाज्ञापयत्क्रुधा ।\nआदावेनं घातयंतु ततः कार्पटिकानिमान् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004063041, "chapter_id": 24063, "verse_number": "४-१२-४२", "content_sanskrit": "ततो ऽयुध्यन्दुराचारास्तेनैकेन च तेऽखिलाः ।\nयथाकथंचित्ताननयत्स च स्वावसथांतिकम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004063042, "chapter_id": 24063, "verse_number": "४-१२-४३", "content_sanskrit": "आच्छिन्नं हि धनुर्वाणं छिन्नं सन्नहनं शरैः ।\nअसूदयिष्यमेतांस्तदभविष्यं यदीश्वरः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004063043, "chapter_id": 24063, "verse_number": "४-१२-४४", "content_sanskrit": "अभिलप्यन्निति प्राणानत्याक्षीत्स परार्थतः ।\nतेपि कार्पटिकाः प्राप्तास्तत्पल्लीं गतसाध्वसाः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004063044, "chapter_id": 24063, "verse_number": "४-१२-४५", "content_sanskrit": "या मतिस्त्वंतकाले स्याद्गतिस्तदनुरूपतः ।\nदिगीशत्वमतः प्राप्तो निरृत्यां नैरृतेश्वरः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004063045, "chapter_id": 24063, "verse_number": "४-१२-४६", "content_sanskrit": "इत्थमस्य स्वरूपं ते आवाभ्यां समुदीरितम् ।\nएतस्योत्तरतो लोको वरुणस्यायमद्भुतः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004063046, "chapter_id": 24063, "verse_number": "४-१२-४७", "content_sanskrit": "कूपवापीतडागानां कर्तारो निर्मलैर्धनैः ।\nइह लोके महीयंते वारुणे वरुणप्रभाः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004063047, "chapter_id": 24063, "verse_number": "४-१२-४८", "content_sanskrit": "निर्जले जलदातारः परसंतापहारिणः ।\nअर्थिभ्यो ये प्रयच्छंति चित्रच्छत्रकमंडलून् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004063048, "chapter_id": 24063, "verse_number": "४-१२-४९", "content_sanskrit": "पानीयशालिकाः कुर्युर्नानोपस्करसंयुताः ।\nदद्युर्धर्मघटांश्चापि सुगंधोदकपूरितान् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004063049, "chapter_id": 24063, "verse_number": "४-१२-५०", "content_sanskrit": "अश्वत्थसेकं ये कुर्युः पथि पादपरोपकाः ।\nविश्रामशालाकर्तारः श्रांतसंतापनोदकाः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004063050, "chapter_id": 24063, "verse_number": "४-१२-५१", "content_sanskrit": "ग्रीष्मोष्प्रहंति मायूरपिच्छादि रचितान्यपि ।\nचित्राणि तालवृंतानि वितरंति तपागमे ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004063051, "chapter_id": 24063, "verse_number": "४-१२-५२", "content_sanskrit": "रसवंति सुगंधीनि हिमवंति तपर्तुषु ।\nविश्राणयंति वा तृप्ति पानकानि प्रयत्नतः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004063052, "chapter_id": 24063, "verse_number": "४-१२-५३", "content_sanskrit": "इक्षुक्षेत्राणि संकल्प्य ब्राह्मणेभ्यो ददत्यपि ।\nतथा नानाप्रकारांश्च विकारानैक्षवान्बहून् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004063053, "chapter_id": 24063, "verse_number": "४-१२-५४", "content_sanskrit": "गोरसानां प्रदातारस्तथा गोमहिषीप्रदाः ।\nधारामंडपकर्तारश्छायामंडपकारिणः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004063054, "chapter_id": 24063, "verse_number": "४-१२-५५", "content_sanskrit": "देवालयेषु ये दद्युर्बहुधारागलंतिकाः ।\nतीर्थे वा करहर्तारस्तीर्थमार्गावनेजका ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004063055, "chapter_id": 24063, "verse_number": "४-१२-५६", "content_sanskrit": "अभयं ये प्रयच्छंति भयार्तोद्यत पाणयः ।\nनिर्भया वारुणे लोके ते वसंति लसंति च ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004063056, "chapter_id": 24063, "verse_number": "४-१२-५७", "content_sanskrit": "विपाशयंति ये पुण्या दुर्वृतैः कंठपाशितान् ।\nते पाशपाणे लोकेस्मिन्निवसंत्यकुतोभयाः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004063057, "chapter_id": 24063, "verse_number": "४-१२-५८", "content_sanskrit": "नौकाद्युपायैर्न द्यादौ पांथान्ये तारयंत्यपि ।\nतारयंत्यपि दुःखाब्धेस्तत्र नागरिका द्विज ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004063058, "chapter_id": 24063, "verse_number": "४-१२-५९", "content_sanskrit": "घट्टान्पुण्यतटिन्यादेर्बंधयंति शिलादिभिः ।\nतोयार्थिसुखसिद्ध्यर्थं ये नरास्तेत्र भोगिनः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004063059, "chapter_id": 24063, "verse_number": "४-१२-६०", "content_sanskrit": "वितर्पयंति ये पुण्यास्तृषिताञ्शीतलैर्जलैः ।\nतेऽत्र वै वारुणे लोके सुखसंततिभागिनः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004063060, "chapter_id": 24063, "verse_number": "४-१२-६१", "content_sanskrit": "जलाशयानां सर्वेषामयमेकतमः पतिः ।\nप्रचेता यादसांनाथः साक्षी सर्वेषुकर्मसु ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004063061, "chapter_id": 24063, "verse_number": "४-१२-६२", "content_sanskrit": "अस्योत्पत्तिं शृणु पतेर्वरुणस्यमहात्मनः ।\nआसीन्मुनिरमेयात्मा कर्दमस्य प्रजापतेः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004063062, "chapter_id": 24063, "verse_number": "४-१२-६३", "content_sanskrit": "शुचिष्मानिति विख्यातस्तनयो विनयोचितः ।\nस्थैर्य माधुर्य धैर्याद्यैर्गुणैरुपचितोहितः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004063063, "chapter_id": 24063, "verse_number": "४-१२-६४", "content_sanskrit": "अच्छोदे सरसि स्नातुं स गतो बालकैः सह ।\nजलक्रीडनसंसक्तं शिशुमारो हरच्च तम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004063064, "chapter_id": 24063, "verse_number": "४-१२-६५", "content_sanskrit": "ततस्तस्मिन्मुनिसुते हृतेऽत्याहितशंसिभिः ।\nतैः समागत्य शिशुभिः कथितं तत्पितुः पुरः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004063065, "chapter_id": 24063, "verse_number": "४-१२-६६", "content_sanskrit": "हरार्चनोपविष्टस्य समाधौ निश्चलात्मनः ।\nश्रुतबालविपत्तेश्च चचाल न मनोहरात् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004063066, "chapter_id": 24063, "verse_number": "४-१२-६७", "content_sanskrit": "अधिकं शीलयामास स सर्वज्ञं त्रिलोचनम् ।\nपश्यञ्शंभोः समीपे स भुवनानि चतुर्दश ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004063067, "chapter_id": 24063, "verse_number": "४-१२-६८", "content_sanskrit": "नाना भूतानि भूतानि ब्रह्मांडांतर्गतानि च ।\nचंद्रसूर्यर्क्षताराश्च पर्वतान्सरितो द्रुमान् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004063068, "chapter_id": 24063, "verse_number": "४-१२-६९", "content_sanskrit": "समुद्रानंतरीयाणि ह्यरण्यानीस्सरांसि च ।\nनाना देवनिकायांश्च बह्वीर्दिविषदां पुरीः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004063069, "chapter_id": 24063, "verse_number": "४-१२-७०", "content_sanskrit": "वापीकूपतडागानि कुल्याः पुष्करिणीर्बहु ।\nएकस्मिन्क्वापि सरसि जलक्रीडापरायणान् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004063070, "chapter_id": 24063, "verse_number": "४-१२-७१", "content_sanskrit": "बहून्मुनिकुमारांश्च मज्जनोन्मज्जनादिभिः ।\nकरयंत्रविनिर्मुक्ततोयधाराभिषेचनैः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004063071, "chapter_id": 24063, "verse_number": "४-१२-७२", "content_sanskrit": "करताडितपानीयशब्ददिङ्मुखनादिभिः ।\nजलखेलनकैरित्थं संसक्तान्बहुबालकान् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004063072, "chapter_id": 24063, "verse_number": "४-१२-७३", "content_sanskrit": "तेषां मध्ये ददर्शाथ समाधिस्थः स कर्दमः ।\nस्वं शिशुं शिशुमारेण नीयमानं सुविह्वलम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004063073, "chapter_id": 24063, "verse_number": "४-१२-७४", "content_sanskrit": "कयाचिज्जलदेव्याथ तस्माच्चक्रूरयादसः ।\nप्रसह्य नीत्वोदधये दृष्टवांस्तं समर्पितम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004063074, "chapter_id": 24063, "verse_number": "४-१२-७५", "content_sanskrit": "निर्भर्त्स्य सरितांनाथं केनचिद्रुद्ररूपिणा ।\nत्रिशूलपाणिनेत्युक्तं क्रोधताम्राननेनच ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004063075, "chapter_id": 24063, "verse_number": "४-१२-७६", "content_sanskrit": "कुतो जलानामधिप शिवभक्तस्य बालकः ।\nप्रजापतेः कर्दमस्य महाभागस्य धीमतः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004063076, "chapter_id": 24063, "verse_number": "४-१२-७७", "content_sanskrit": "अज्ञात्वा शिवसामर्थ्यं भवताचिरमासितः ।\nभयत्रस्तेन तद्वाक्यश्रवणात्तमुदन्वता ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004063077, "chapter_id": 24063, "verse_number": "४-१२-७८", "content_sanskrit": "बालं रत्नैरलंकृत्य बद्ध्वा तं शिशुमारकम् ।\nसमर्पितं समानीय शंभुपादाब्जसंनिधौ ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004063078, "chapter_id": 24063, "verse_number": "४-१२-७९", "content_sanskrit": "नत्वा विज्ञापयत्तं च नापराध्याम्यहं विभो ।\nअनाथनाथविश्वेश भक्तापत्तिविनाशन ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004063079, "chapter_id": 24063, "verse_number": "४-१२-८०", "content_sanskrit": "भक्तकल्पतरो शंभोऽनेनायं दुष्टयादसा ।\nअनायिन मया नाथ भवद्भक्तजनार्भकः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004063080, "chapter_id": 24063, "verse_number": "४-१२-८१", "content_sanskrit": "गणेन तेन विज्ञाय शंभोरथ मनोगतम् ।\nपाशेन बद्ध्वा तद्यादः शिशुहस्ते समर्पितम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004063081, "chapter_id": 24063, "verse_number": "४-१२-८२", "content_sanskrit": "गृहाणेमं स्वतनयं पार्षदे शंकराज्ञया ।\nयाहि स्वभवनं वत्स ब्रुवतीति स कर्दमः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004063082, "chapter_id": 24063, "verse_number": "४-१२-८३", "content_sanskrit": "समाधिसमये सर्वमिति शृण्वन्नुदारधीः ।\nउन्मील्य नयने यावत्प्रणिधानं विसृज्य च ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004063083, "chapter_id": 24063, "verse_number": "४-१२-८४", "content_sanskrit": "संपश्यते शिशुं तावत्पुरतः समवैक्षत ।\nगृहीतशिशुमारं च पार्श्वेऽलंकृतकर्णिकम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004063084, "chapter_id": 24063, "verse_number": "४-१२-८५", "content_sanskrit": "तोयार्द्रकाकपक्षाग्रं कषायनयनांचलम् ।\nकिंचिद्विरूक्षं त्वक्क्षोभं संभ्रमापन्नमानसम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004063085, "chapter_id": 24063, "verse_number": "४-१२-८६", "content_sanskrit": "कृतप्रणाममालिंग्य जिघ्रंस्तन्मुखपंकजम् ।\nपुनर्जातमिवामंस्त पश्यंश्चापि मुहुर्मुहुः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004063086, "chapter_id": 24063, "verse_number": "४-१२-८७", "content_sanskrit": "शतानिपंचवर्षाणि प्रणिधानस्थितस्य हि ।\nकर्दमस्य व्यतीतानि शंभुमर्चयतस्तदा ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004063087, "chapter_id": 24063, "verse_number": "४-१२-८८", "content_sanskrit": "कर्दमोपि च तत्कालमज्ञासीत्क्षणसंगतम् ।\nयतो न प्रभवेत्कालो महाकालस्य संनिधौ ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004063088, "chapter_id": 24063, "verse_number": "४-१२-८९", "content_sanskrit": "ततस्तं तनयः पृष्ट्वा पितरं प्रणिपत्य च ।\nजगाम तूर्णं तपसे श्रीमद्वाराणसीं पुरीम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004063089, "chapter_id": 24063, "verse_number": "४-१२-९०", "content_sanskrit": "तत्र तप्त्वा तपो घोरं लिंगं संस्थाप्य शांभवम् ।\nपंचवर्षसहस्राणि स्थितः पाषाणनिश्चलः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004063090, "chapter_id": 24063, "verse_number": "४-१२-९१", "content_sanskrit": "आविरासीन्महादेवस्तुष्टस्तत्तपसा ततः ।\nउवाच कार्दमे ब्रूहि कं ददामि वरोत्तमम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004063091, "chapter_id": 24063, "verse_number": "४-१२-९२", "content_sanskrit": "कार्दमिरुवाच ।\nयदि नाथ प्रसन्नोसि भक्तानामनुकंपक ।\nसर्वासामाधिपत्यं मे देह्यपां यादसामपि ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004063092, "chapter_id": 24063, "verse_number": "४-१२-९३", "content_sanskrit": "इति श्रुत्वा महेशानः सर्वचिंतितदः प्रभुः ।\nअभ्यषिंचत तं तत्र वारुणे परमे पदे ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004063093, "chapter_id": 24063, "verse_number": "४-१२-९४", "content_sanskrit": "रत्नानामब्धिजातानामब्धीनां सरितामपि ।\nसरसां पल्वलानां च वाप्यंबु स्रोतसा पुनः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004063094, "chapter_id": 24063, "verse_number": "४-१२-९५", "content_sanskrit": "जलाशयानां सर्वेषां प्रतीच्याश्चापि वैदिशः ।\nअधीश्वरः पाशपाणिर्भव सर्वामरप्रियः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004063095, "chapter_id": 24063, "verse_number": "४-१२-९६", "content_sanskrit": "ददामि वरमन्यं च सर्वेषां हितकारकम् ।\nत्वयैतत्स्थापितं लिंगं तव नाम्ना भविष्यति ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004063096, "chapter_id": 24063, "verse_number": "४-१२-९७", "content_sanskrit": "वरुणेशमिति ख्यातं वाराणस्यां सुसिद्धिदम् ।\nमणिकर्णेश लिंगस्य नैरृत्यां दिशि संस्थितम् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004063097, "chapter_id": 24063, "verse_number": "४-१२-९८", "content_sanskrit": "आराधितं सदा पुंसां सर्वजाड्यविनाशकृत् ।\nवरुणेशस्य ये भक्ता न तेषामब्भयं क्वचित् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004063098, "chapter_id": 24063, "verse_number": "४-१२-९९", "content_sanskrit": "न संतापभयं तेषां नापायमरणं क्वचित् ।\nजलोदरभयं नैव न भयं वै तृषः क्वचित् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004063099, "chapter_id": 24063, "verse_number": "४-१२-१००", "content_sanskrit": "नीरसान्यन्नपानानि वरुणेश्वर संस्मृतेः ।\nसरसानि भविष्यंति नात्र कार्या विचारणा ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004063100, "chapter_id": 24063, "verse_number": "४-१२-१०१", "content_sanskrit": "इत्युक्त्वांतर्दधे शंभुर्वरुणोपि स्वबंधुभिः ।\nइमं लोकमलंकुर्वंस्तदारभ्य स्थितो द्विजः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004063101, "chapter_id": 24063, "verse_number": "४-१२-१०२", "content_sanskrit": "इदं वरुणलोकस्य स्वरूपं ते निरूपितम् ।\nयच्छ्रुत्वा न नरः क्वापि दुरपायैः प्रबाध्यते ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}]