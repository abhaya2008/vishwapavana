[{"id": 2062677, "chapter_id": 2334, "verse_number": "८-५५-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2062678, "chapter_id": 2334, "verse_number": "८-५५-१", "content_sanskrit": "प्रत्येत्याथ पुनर्जिष्णुर्जित्वा संशप्तकान्बभौ।\nवक्रानुवक्रगमनादङ्गारक इव ग्रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2062679, "chapter_id": 2334, "verse_number": "८-५५-२", "content_sanskrit": "पार्थबाणहता राजन्नराश्वरथकुञ्जराः।\nविचेलुर्बभ्रमुर्नेशुः पेतुर्मम्लुश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2062680, "chapter_id": 2334, "verse_number": "८-५५-३", "content_sanskrit": "धुर्यान्धुर्येतरान्सूतान्ध्वजांश्चपासिसायकान्।\nपाणीन्पाणिगताञ्शस्त्रान्बाहूनपि शिरांसि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2062681, "chapter_id": 2334, "verse_number": "८-५५-४", "content_sanskrit": "भल्लैः क्षुरैरर्धचन्द्रैर्वत्सदन्तैश्च पाण्डवः।\nचिच्छेदामित्रवीराणां समरे प्रतियुध्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2062682, "chapter_id": 2334, "verse_number": "८-५५-५", "content_sanskrit": "तं प्रवीरास्त्वदीयानां नर्दमानाऽभिदुद्रुवुः।\nवासितार्थे युयुत्सन्तो वृषभा वृषभं यथा।\nनिपतन्त्यर्जुनं शूराः शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2062683, "chapter_id": 2334, "verse_number": "८-५५-६", "content_sanskrit": "तेषां तस्य च तद्युद्धमभवद्रोमहर्षणम्।\nत्रैलोक्यविजये यादृग्दैत्यानां सह वज्रिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2062684, "chapter_id": 2334, "verse_number": "८-५५-७", "content_sanskrit": "तमविध्यत्त्रिभिर्बाणैर्दन्दशूकैरिवाहिभिः।\nउग्रायुधस्य तस्याशु शिरः कायादपाहरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2062685, "chapter_id": 2334, "verse_number": "८-५५-८", "content_sanskrit": "तेऽर्जुनं सर्वतः क्रुद्धा नानाशस्त्रैरवीवृषन्।\nमरुद्भिः प्रेरिता मेघा हिमवन्तमिवोष्णगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2062686, "chapter_id": 2334, "verse_number": "८-५५-९", "content_sanskrit": "अस्त्रैरस्त्राणिं संवार्य द्विषतां सर्वतोऽर्जुनः।\nसम्यगस्तैः शरैः सर्वानहितानहनद्बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2062687, "chapter_id": 2334, "verse_number": "८-५५-१०", "content_sanskrit": "छिन्नत्रिवेणुजङ्घेषान्हताश्वान्हतसारथीन्।\nविस्रस्तहस्ततूणीरान्विचक्रथकेतनान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2062688, "chapter_id": 2334, "verse_number": "८-५५-११", "content_sanskrit": "सञ्छिन्नरश्मियोक्त्राक्षान्व्यनुकर्षयुगान्रथान्।\nविध्वस्तसर्वसन्नाहान्बाणैश्चक्रेऽर्जुनस्त्वरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2062689, "chapter_id": 2334, "verse_number": "८-५५-१२", "content_sanskrit": "ते रथास्तत्र विध्वस्ताः परार्द्व्या भान्त्यनेकशः।\nधनिनामिव वेश्मानि हतान्यग्न्यनिलाम्बुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2062690, "chapter_id": 2334, "verse_number": "८-५५-१३", "content_sanskrit": "द्विपाः सम्भिन्नमर्माणो वज्राशनिसमैः शरैः।\nपेतुर्गिर्यग्रवेश्मानि वज्रवाताग्निभिर्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2062691, "chapter_id": 2334, "verse_number": "८-५५-१४", "content_sanskrit": "अनेकैश्च शिलाधौतैर्वज्रानलविषोपमैः।\nशरैर्निजघ्निवान्पार्थो महेन्द्र इव दानवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2062692, "chapter_id": 2334, "verse_number": "८-५५-१५", "content_sanskrit": "सारोहास्तुरगाः पेतुर्बहवोऽर्जुनताडिताः।\nनिर्जिह्वान्त्राः क्षितौ क्षीणा रुधिरार्द्राः सुदुर्दृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2062693, "chapter_id": 2334, "verse_number": "८-५५-१६", "content_sanskrit": "नराश्वनागा नाराचैः संस्यूताः सव्यसाचिना।\nबभ्रमुश्चस्खलुः पेतुर्नेदुर्मम्लुश्च मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2062694, "chapter_id": 2334, "verse_number": "८-५५-१७", "content_sanskrit": "महार्हवर्माभरणा नानारूपाम्बरायुधाः।\nसरथाश्वद्विपा वीरा हताः पार्थेन शेरते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2062695, "chapter_id": 2334, "verse_number": "८-५५-१८", "content_sanskrit": "निर्भयाः पुण्यकर्माणो विशिष्टाभिजनश्रुताः।\nगताः शरीरैर्वसुधामूर्जितैः कर्मभिर्दिवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2062696, "chapter_id": 2334, "verse_number": "८-५५-१९", "content_sanskrit": "अथार्जुनरथं वीरास्त्वदीयाः समभिद्रवन्।\nनानाजनपदाध्यक्षाः सगणा जातमन्यवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2062697, "chapter_id": 2334, "verse_number": "८-५५-२०", "content_sanskrit": "उह्यमना रथाश्वेभैः पत्तयश्च जिघांसवः।\nसमभ्यधावन्नस्यन्तो विविधं क्षिप्रमायुधम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2062698, "chapter_id": 2334, "verse_number": "८-५५-२१", "content_sanskrit": "तदायुधमहावर्षं क्षिप्तं योधमहाम्बुदैः।\nव्यधमन्निशितैर्बाणैः क्षिप्रमर्जुनमारुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2062699, "chapter_id": 2334, "verse_number": "८-५५-२२", "content_sanskrit": "साश्वपत्तिद्विपरथं महाशस्त्रौघसम्प्लवम्॥\nसहसा सन्तितीर्षन्तं पार्थं शस्त्रास्त्रसेतुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2062700, "chapter_id": 2334, "verse_number": "८-५५-२३", "content_sanskrit": "अथाब्रवीद्वासुदेवः पार्थ किं क्रीडसेऽनघ।\nसंशप्तकान्प्रमथ्यैनांस्ततः कर्णवधे त्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2062701, "chapter_id": 2334, "verse_number": "८-५५-२४", "content_sanskrit": "तथेत्युक्त्वाऽर्जुनः कृष्णं शिष्टान्संशप्तकांस्तदा।\nक्षपयिष्यंस्तदा बाणैर्दैत्यानिन्द्र इवावधीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2062702, "chapter_id": 2334, "verse_number": "८-५५-२५", "content_sanskrit": "आददत्सन्दधन्नेषृन्दृष्टः कैश्चिद्रणेऽर्जुनः।\nविमुञ्चन्वा शराञ्शीघ्रं दृश्यन्ते वै नरा हताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2062703, "chapter_id": 2334, "verse_number": "८-५५-२६", "content_sanskrit": "आश्चर्यमिति गोविन्दो ब्रुवन्नश्वानचोदयत्।\nहंसांशुगौरास्ते सेनां हंसाः सर इवाविशन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2062704, "chapter_id": 2334, "verse_number": "८-५५-२७", "content_sanskrit": "ततः सङ्ग्रामभूमिं तां वर्तमाने जनक्षये।\nअवेक्षमाणो गोविन्दः सव्यसाचिनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2062705, "chapter_id": 2334, "verse_number": "८-५५-२८", "content_sanskrit": "एष पार्थ महारौद्रो वर्तते भरतक्षयः।\nपृथिव्यां पार्थिवानां वै दुर्योधनकृते महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2062706, "chapter_id": 2334, "verse_number": "८-५५-२९", "content_sanskrit": "पश्य भारत चापानि रुक्मपृष्ठानि धन्विनाम्।\nहतानामपविद्धानि कलापानिषुधींस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2062707, "chapter_id": 2334, "verse_number": "८-५५-३०", "content_sanskrit": "जातरूपमयैः पुङ्खैः शरांश्च नतपर्वणः।\nतैलधौतांश्च नाराचान्निर्मुक्तानिव पन्नगान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2062708, "chapter_id": 2334, "verse_number": "८-५५-३१", "content_sanskrit": "आकीर्णांस्तोमरान्वाहांश्छत्रान्हेमविभूषितान्।\nचर्माणि चापविद्धानि रुक्मपृष्ठानि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2062709, "chapter_id": 2334, "verse_number": "८-५५-३२", "content_sanskrit": "सुवर्णविकृतान्प्रासाञ्शक्तीः कनकभूषिताः।\nजाम्बूनदमयैः पट्टैर्बद्धाश्च विपुला गदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2062710, "chapter_id": 2334, "verse_number": "८-५५-३३", "content_sanskrit": "जातरूपमयीश्चर्ष्टीः पट्टसान्हेमभूषितान्।\nदण्डैः कनकचित्रैश्च विप्रविद्धान्परश्वथान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2062711, "chapter_id": 2334, "verse_number": "८-५५-३४", "content_sanskrit": "परिघान्भिण्डिपालांश्च भुशुण्डीः कणपानपि।\nअयस्कुन्तांश्च पतितान्मुसलानि गुरूणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2062712, "chapter_id": 2334, "verse_number": "८-५५-३५", "content_sanskrit": "नानाविधानि शस्त्राणि प्रगृह्य जयगृद्धिनः।\nजीवन्त इव दृश्यन्ते गतसत्वास्तरस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2062713, "chapter_id": 2334, "verse_number": "८-५५-३६", "content_sanskrit": "गदाविमथितैर्गात्रैर्मुसलैर्भिन्नमस्तकान्।\nगजवाजिरथैः क्षुण्णान्पश्य योधान्सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2062714, "chapter_id": 2334, "verse_number": "८-५५-३७", "content_sanskrit": "मनुष्यगजवाजीनां शरशक्त्यृष्टितोमरैः।\nनिस्त्रिंशैः पट्टसैः प्रासैर्नखरैर्लगुडैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2062715, "chapter_id": 2334, "verse_number": "८-५५-३८", "content_sanskrit": "शरीरैर्बहुघा छिन्नैः शोणितौघपरिप्लुतैः।\nगतासुभिरमित्रघ्न संवृता रणभूमयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2062716, "chapter_id": 2334, "verse_number": "८-५५-३९", "content_sanskrit": "बाहुभिश्चन्दनादिग्धैः साङ्गदैः शुभभूषणैः।\nसतलत्रैः सकेयूरैर्भाति भारत मेदिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2062717, "chapter_id": 2334, "verse_number": "८-५५-४०", "content_sanskrit": "साङ्गुलित्रैर्भुजाग्रैश्च विप्रविद्वैरलङ्कृतैः।\nहस्तिहस्तोपमैश्छिन्नैरूरुभिश्च तरस्विनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2062718, "chapter_id": 2334, "verse_number": "८-५५-४१", "content_sanskrit": "बद्धचूडामणिवरैः शिरोभिश्च सकुण्डलैः।\n`निकृत्तैर्वृषभाक्षाणां शरीरैश्चापि सङ्घशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2062719, "chapter_id": 2334, "verse_number": "८-५५-४२", "content_sanskrit": "गजवाजिमनुष्याणां शरशक्त्यृष्टितोमरैः।\nकबन्धैः शोणितादिग्धैश्छिन्नगात्रशिरोधरैः।\nभूर्भाति भरतश्रेष्ठ शान्ताग्निभिरिवाध्वरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2062720, "chapter_id": 2334, "verse_number": "८-५५-४३", "content_sanskrit": "रथांश्च बहुधा भग्नान्हेमकिङ्किणिनः शुभान्।\nअश्वांश्च बुहधा पश्य शोणितेन परिप्लुतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2062721, "chapter_id": 2334, "verse_number": "८-५५-४४", "content_sanskrit": "अनुकर्षानुपासङ्गान्पताका विविधान्ध्वजान्।\nयोधानां च महाशङ्खान्पाण्डुरांश्च प्रकीर्णकान्।\nनिरस्तजिह्वान्मातङ्गाञ्शयानान्पर्वतोपमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2062722, "chapter_id": 2334, "verse_number": "८-५५-४५", "content_sanskrit": "वैजयन्तीर्विचित्राश्च हतांश्च गजयोधिनः।\nवारणानां परिस्तोमान्संयुक्तानेककम्बलान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2062723, "chapter_id": 2334, "verse_number": "८-५५-४६", "content_sanskrit": "विपाटितविचित्राश्च रूपचित्राः कुथास्तथा।\nभिन्नाश्च बहुधा घण्टाः पतद्भिश्चूर्णिता गजैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2062724, "chapter_id": 2334, "verse_number": "८-५५-४७", "content_sanskrit": "वैदूर्यमणिदण्डांश्च पतितांश्चाङ्कुशान्भुवि।\nअश्वानां च युगापीडान्रत्नचित्रानुरश्छदान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2062725, "chapter_id": 2334, "verse_number": "८-५५-४८", "content_sanskrit": "विद्धाः सादिध्वजाग्रेषु सुवर्णविकृताः कुथाः।\nविचित्रान्मणिचित्रांश्च जातरूपपरिष्कृतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2062726, "chapter_id": 2334, "verse_number": "८-५५-४९", "content_sanskrit": "अश्वास्तरपरिस्तोमान्राङ्कवान्पतितान्भुवि।\nचूडामणीन्नरेन्द्राणां विचित्राः काञ्चनस्रजः।\nछत्राणि चापविद्धानि चामरव्यजनानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2062727, "chapter_id": 2334, "verse_number": "८-५५-५०", "content_sanskrit": "चन्द्रनक्षत्रभासैश्च वदनैश्चारुकुण्डलैः।\nक्लृप्तश्मश्रुभिरत्यर्थं वीराणां समलङ्कृतैः।\nवदनैः पश्य सञ्छन्नां महीं शोणितकर्दमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2062728, "chapter_id": 2334, "verse_number": "८-५५-५१", "content_sanskrit": "सजीवांश्च नरान्पश्य कूजमानान्समन्ततः।\nउपास्यमानांश्च बहून्न्यस्तशस्त्रैश्च भूपते।\nज्ञातिभिश्च जलक्लिन्नान्रोदमानैर्मुहुर्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2062729, "chapter_id": 2334, "verse_number": "८-५५-५२", "content_sanskrit": "उत्क्रान्तानपरान्योधाञ्छादयित्वा तरस्विनः।\nपुनर्युद्धाय गच्छन्ति जये लुब्धाः प्रमन्यवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2062730, "chapter_id": 2334, "verse_number": "८-५५-५३", "content_sanskrit": "अपरे तत्रतत्रैव परिधावन्ति मानवाः।\nसन्निवृत्ताश्च ते शूरा दृष्टा चैतान्विचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2062731, "chapter_id": 2334, "verse_number": "८-५५-५४", "content_sanskrit": "जलं त्यक्त्वा प्रधावन्ति क्रोशमानाः परस्परम्।\nजलं पीत्वा मृतान्पश्य पिबतोऽन्यांश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2062732, "chapter_id": 2334, "verse_number": "८-५५-५५", "content_sanskrit": "परिष्वज्य प्रियानन्ये बान्धवान्बन्धुवत्सलाः।\nविसंज्ञान्समरे योधांस्तत्रतत्र महारणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2062733, "chapter_id": 2334, "verse_number": "८-५५-५६", "content_sanskrit": "पश्यापरान्नरश्रेष्ठ सन्दष्टोष्ठपुटान्पुनः।\nभृकुटीकुटिलैर्वक्त्रैः प्रेक्षमाणान्महारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2062734, "chapter_id": 2334, "verse_number": "८-५५-५७", "content_sanskrit": "एतत्तवैवानुरूपं कर्मार्जुन महाहवे।\nदिवि वा देवराजस्य त्वया यत्कृतमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2062735, "chapter_id": 2334, "verse_number": "८-५५-५८x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2062736, "chapter_id": 2334, "verse_number": "८-५५-५८", "content_sanskrit": "एवं तां दर्शयन्कृष्णो युद्धभूमिं किरीटिने।\nगच्छन्नेवाशृणोच्छब्दं दुर्योधनबले महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2062737, "chapter_id": 2334, "verse_number": "८-५५-५९", "content_sanskrit": "शङ्खदुन्दुभिनिर्घोषं भेरीपणवनिःस्वनम्।\nरथाश्वनरनागानां पादशब्दांश्च दारुणान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2062738, "chapter_id": 2334, "verse_number": "८-५५-६०", "content_sanskrit": "प्रविश्य तद्बलं कृष्णस्तुरगैर्वातवेगितैः।\nपाण्ड्येनाभ्यर्दितं सैन्यं त्वदीयं वीक्ष्य विस्मितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2062739, "chapter_id": 2334, "verse_number": "८-५५-६१", "content_sanskrit": "स हि नानाविधैर्बाणैरिष्वस्त्रप्रवरो युधि।\nन्यहनद्द्विषतां पूगान्गतासूनन्तको यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2062740, "chapter_id": 2334, "verse_number": "८-५५-६२", "content_sanskrit": "गजवाजिमनुष्याणां शरीराणि शितैः शरैः।\nभित्त्वा प्रहरतां श्रेष्ठो विदेहासूनपातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2062741, "chapter_id": 2334, "verse_number": "८-५५-६३", "content_sanskrit": "शत्रुप्रवीरैरस्त्राणि नानाशस्त्राणि सायकैः।\nछित्त्वा तानवधीच्छत्रून्पाण्ड्यः शक्र इवासुरान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2062742, "chapter_id": 2334, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तदशदिवसयुद्धे पञ्चपञ्चाशोऽध्यायः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]