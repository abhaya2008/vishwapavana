[{"id": 6000318000, "chapter_id": 10318, "verse_number": null, "content_sanskrit": "अथ सप्तदशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000318001, "chapter_id": 10318, "verse_number": null, "content_sanskrit": "उद्धव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.001.m4a", "display_order": 2}, {"id": 6000318002, "chapter_id": 10318, "verse_number": "११-१७-१", "content_sanskrit": "यस्त्वयाऽभिहितः पूर्वं धर्मस्त्वद्भक्तिलक्षणः।\nवर्णाश्रमाचारवतां सर्वेषां द्विपदामपि॥ ११/१७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.002.m4a", "display_order": 3, "topics": [{"text": "उद्धवाय श्रीकृष्णेन ब्राह्मणादिवर्ण-ब्रह्मचर्याद्याश्रमधर्मवर्णनम्", "range": "१–५८"}]}, {"id": 6000318003, "chapter_id": 10318, "verse_number": "११-१७-२", "content_sanskrit": "यथाऽनुष्ठीयमानेन त्वयि भक्तिर्नृणां भवेत्।\nस्वधर्मेणारविन्दाक्ष तन्ममाख्यातुमर्हसि॥ ११/१७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.003.m4a", "display_order": 4}, {"id": 6000318004, "chapter_id": 10318, "verse_number": "११-१७-३", "content_sanskrit": "पुरा किल महाबाहो धर्मं परमकं भवान्।\nयमाह त्वयि भक्तेभ्यो ब्राह्मणेभ्यश्च माधव॥ ११/१७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.004.m4a", "display_order": 5}, {"id": 6000318005, "chapter_id": 10318, "verse_number": "११-१७-४", "content_sanskrit": "स इदानीं सुमहता कालेनामित्रकर्शन।\nप्रायोऽन्तर्भविता मर्त्यलोके प्रागनुशासितः॥ ११/१७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.005.m4a", "display_order": 6}, {"id": 6000318006, "chapter_id": 10318, "verse_number": "११-१७-५", "content_sanskrit": "वक्ता कर्ताऽविता नान्यो धर्मस्याच्युत ते भुवि।\nसभायामपि वैरिञ्च्यां यत्र मूर्तिधराः कलाः॥ ११/१७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.006.m4a", "display_order": 7}, {"id": 6000318007, "chapter_id": 10318, "verse_number": "११-१७-६", "content_sanskrit": "कर्त्राऽवित्रा प्रवक्त्रा च भवता मधुसूदन।\nत्यक्ते महीतले देव विनष्टं कः प्रवक्ष्यति॥ ११/१७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.007.m4a", "display_order": 8}, {"id": 6000318008, "chapter_id": 10318, "verse_number": "११-१७-७", "content_sanskrit": "त्वमतः सर्वधर्मज्ञ धर्मस्त्वद्भक्तिलक्षणः।\nयथा यस्य विधीयेत तथा वर्णय मेऽच्युत॥ ११/१७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.008.m4a", "display_order": 9}, {"id": 6000318009, "chapter_id": 10318, "verse_number": null, "content_sanskrit": "बादरायणिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.009.m4a", "display_order": 10}, {"id": 6000318010, "chapter_id": 10318, "verse_number": "११-१७-८", "content_sanskrit": "इत्थं तु भृत्यमुख्येन पृष्टः स भगवान् हरिः।\nप्रीतः क्षेमाय मर्त्यानां धर्मानाह सनातनान्॥ ११/१७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.010.m4a", "display_order": 11}, {"id": 6000318011, "chapter_id": 10318, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.011.m4a", "display_order": 12}, {"id": 6000318012, "chapter_id": 10318, "verse_number": "११-१७-९", "content_sanskrit": "धर्म्य एष तव प्रश्नो नैःश्रेयसकरो नृणाम्।\nवर्णाश्रमाचारवतां तमुद्धव निबोध मे॥ ११/१७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.012.m4a", "display_order": 13}, {"id": 6000318013, "chapter_id": 10318, "verse_number": "११-१७-१०", "content_sanskrit": "आदौ कृतयुगे वर्णो नृणां हंस इति स्मृतः।\nकृतकृत्याः प्रजा जात्या तस्मात् कृतयुगं विदुः॥ ११/१७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.013.m4a", "display_order": 14}, {"id": 6000318014, "chapter_id": 10318, "verse_number": "११-१७-११", "content_sanskrit": "वेदः प्रणव एवाग्रे धर्मोऽहं वृषरूपधृक्।\nउपासते तपोनिष्ठा हंसा मां मुक्तकिल्बिषाः॥ ११/१७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.014.m4a", "display_order": 15}, {"id": 6000318015, "chapter_id": 10318, "verse_number": "११-१७-१२", "content_sanskrit": "त्रेतामुखे महाभाग प्राणान्मे हृदयात् त्रयी।\nविद्या प्रादुरभूत् तस्या अहमासं त्रिवृन्मुखः॥ ११/१७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.015.m4a", "display_order": 16}, {"id": 6000318016, "chapter_id": 10318, "verse_number": "११-१७-१३", "content_sanskrit": "विप्रक्षत्रियविट्‍शूद्रा मुखबाहूरुपादजाः।\nवैराजात् पुरुषाज्जाता य आत्माचारलक्षणाः॥ ११/१७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.016.m4a", "display_order": 17}, {"id": 6000318017, "chapter_id": 10318, "verse_number": "११-१७-१४", "content_sanskrit": "गृहाश्रमो जघनतो ब्रह्मचर्यं हृदो मम।\nवक्षःस्थलाद् वने वासो न्यासः शीर्षण्यवस्थितः॥ ११/१७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.017.m4a", "display_order": 18}, {"id": 6000318018, "chapter_id": 10318, "verse_number": "११-१७-१५", "content_sanskrit": "वर्णानामाश्रमाणां च जन्मभूम्यनुसारतः।\nआसन् प्रकृतयो नॄणां नीचैर्नीचोत्तमोत्तमाः॥ ११/१७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.018.m4a", "display_order": 19}, {"id": 6000318019, "chapter_id": 10318, "verse_number": "११-१७-१६", "content_sanskrit": "शमो दमस्तपः शौचं सन्तोषः क्षान्तिरार्जवम्।\nमद्भक्तिश्च दया सत्यं ब्रह्मप्रकृतयस्त्विमाः॥ ११/१७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.019.m4a", "display_order": 20}, {"id": 6000318020, "chapter_id": 10318, "verse_number": "११-१७-१७", "content_sanskrit": "तेजो बलं धृतिः शौर्यं तितिक्षौदार्यमुद्यमः।\nस्थैर्यं ब्रह्मण्यमैश्वर्यं क्षत्रप्रकृतयस्त्विमाः॥ ११/१७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.020.m4a", "display_order": 21}, {"id": 6000318021, "chapter_id": 10318, "verse_number": "११-१७-१८", "content_sanskrit": "आस्तिक्यं दाननिष्ठा च अदम्भो विप्रसेवनम्।\nअतुष्टिरर्थोपचये वैश्यप्रकृतयस्त्विमाः॥ ११/१७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.021.m4a", "display_order": 22}, {"id": 6000318022, "chapter_id": 10318, "verse_number": "११-१७-१९", "content_sanskrit": "शुश्रूषणं द्विजगवां देवानां चाप्यमायया।\nतत्र लब्धेन सन्तोषः शूद्रप्रकृतयस्त्विमाः॥ ११/१७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.022.m4a", "display_order": 23}, {"id": 6000318023, "chapter_id": 10318, "verse_number": "११-१७-२०", "content_sanskrit": "अशौचमनृतं स्तेयं नास्तिक्यं शुष्कविग्रहः।\nकामः क्रोधश्च तर्षश्च स्वभावोऽन्तेऽवसायिनाम्॥ ११/१७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.023.m4a", "display_order": 24}, {"id": 6000318024, "chapter_id": 10318, "verse_number": "११-१७-२१", "content_sanskrit": "अहिंसा सत्यमस्तेयमकामक्रोधलोभता।\nभूतप्रियहितेहा च धर्मोऽयं सार्ववर्णिकः॥ ११/१७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.024.m4a", "display_order": 25}, {"id": 6000318025, "chapter_id": 10318, "verse_number": "११-१७-२२", "content_sanskrit": "द्वितीयं प्राप्याऽनुपूर्व्याज्जन्मोपनयनं द्विजः।\nवसन् गुरुकुले दान्तो ब्रह्माधीयीत वाग्यतः॥ ११/१७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.025.m4a", "display_order": 26}, {"id": 6000318026, "chapter_id": 10318, "verse_number": "११-१७-२३", "content_sanskrit": "मेखलाजिनदण्डाक्षब्रह्मसूत्रकमण्डलून्।\nजटिलोऽधौतदन्तश्च वासःपीठकुशान् दधत्॥ ११/१७/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.026.m4a", "display_order": 27}, {"id": 6000318027, "chapter_id": 10318, "verse_number": "११-१७-२४", "content_sanskrit": "स्नानभोजनहोमेषु जपोच्चारे च वाग्यतः।\nन छिन्द्यान्नखरोमाणि कक्षोपस्थगतान्यपि॥ ११/१७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.027.m4a", "display_order": 28}, {"id": 6000318028, "chapter_id": 10318, "verse_number": "११-१७-२५", "content_sanskrit": "रेतो नावकिरेज्जातु ब्रह्मव्रतधरः स्वयम्।\nअवकीर्णेऽवगाह्याप्सु यतासुस्त्रिपदीं जपेत्॥ ११/१७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.028.m4a", "display_order": 29}, {"id": 6000318029, "chapter_id": 10318, "verse_number": "११-१७-२६", "content_sanskrit": "अग्न्यर्काचार्यगोविप्रगुरुवृद्धसुरान् नमेत्।\nसमाहित उपासीत सन्ध्ये च यतवाग् जपेत्॥ ११/१७/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.029.m4a", "display_order": 30}, {"id": 6000318030, "chapter_id": 10318, "verse_number": "११-१७-२७", "content_sanskrit": "आचार्यं मां विजानीयान्नावमन्येत कर्हिचित्।\nन मर्त्यबुद्ध्याऽसूयेत सर्वदेवमयो गुरुः॥ ११/१७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.030.m4a", "display_order": 31}, {"id": 6000318031, "chapter_id": 10318, "verse_number": "११-१७-२८", "content_sanskrit": "सायं प्रातरुपानीय भैक्ष्यं तस्मै निवेदयेत्।\nयच्चान्यदप्यनुज्ञात उपभुञ्जीत संयतः॥ ११/१७/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.031.m4a", "display_order": 32}, {"id": 6000318032, "chapter_id": 10318, "verse_number": "११-१७-२९", "content_sanskrit": "शुश्रूषमाण आचार्यं सदोपासीत नीचवत्।\nयानशय्यासनस्थाने नातिदूरः कृताञ्जलिः॥ ११/१७/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.032.m4a", "display_order": 33}, {"id": 6000318033, "chapter_id": 10318, "verse_number": "११-१७-३०", "content_sanskrit": "एवंवृतो गुरुकुले वसेद् भोगविवर्जितः।\nविद्या समाप्यते यावद् बिभ्रद् व्रतमखण्डितम्॥ ११/१७/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.033.m4a", "display_order": 34}, {"id": 6000318034, "chapter_id": 10318, "verse_number": "११-१७-३१", "content_sanskrit": "यद्यसौ च्छन्दसां लोकमारोक्ष्यन् ब्रह्मविष्टपम्।\nगुरवे विन्यसेद् देहं स्वाध्यायार्थे बृहद्व्रतः॥ ११/१७/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.034.m4a", "display_order": 35}, {"id": 6000318035, "chapter_id": 10318, "verse_number": "११-१७-३२", "content_sanskrit": "अग्नौ गुरावात्मनि च सर्वभूतेषु मां परम्।\nअपृथग्धीरुपासीत ब्रह्मवर्चस्व्यकल्मषः॥ ११/१७/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.035.m4a", "display_order": 36}, {"id": 6000318036, "chapter_id": 10318, "verse_number": "११-१७-३३", "content_sanskrit": "स्त्रीणां निरीक्षणस्पर्शसल्लापक्ष्वेलनादिकम्।\nप्राणिनो मिथुनीभूतानगृहस्थोऽग्रतस्त्यजेत्॥ ११/१७/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.036.m4a", "display_order": 37}, {"id": 6000318037, "chapter_id": 10318, "verse_number": "११-१७-३४", "content_sanskrit": "शौचमाचमनं स्नानं सन्ध्योपासनमार्जवम्।\nतीर्थसेवा जपोऽस्पृश्याभक्ष्यासम्भाष्यवर्जनम्॥ ११/१७/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.037.m4a", "display_order": 38}, {"id": 6000318038, "chapter_id": 10318, "verse_number": "११-१७-३५", "content_sanskrit": "सर्वाश्रमप्रयुक्तोऽयं नियमः कुलनन्दन।\nमद्भावः सर्वभूतेषु मनोवाक्कायसंयमः॥ ११/१७/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.038.m4a", "display_order": 39}, {"id": 6000318039, "chapter_id": 10318, "verse_number": "११-१७-३६", "content_sanskrit": "एवं ब्रह्मव्रतधरो ब्राह्मणोऽग्निरिव ज्वलन्।\nमद्भक्तस्तीव्रतपसा दग्धकर्माशयोऽमलः॥ ११/१७/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.039.m4a", "display_order": 40}, {"id": 6000318040, "chapter_id": 10318, "verse_number": "११-१७-३७", "content_sanskrit": "अथानन्तरमावेक्ष्यन् यथाजिज्ञासितागमः।\nगुरवे दक्षिणां दत्वा स्नायाद् गुर्वनुमोदितः॥ ११/१७/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.040.m4a", "display_order": 41}, {"id": 6000318041, "chapter_id": 10318, "verse_number": "११-१७-३८", "content_sanskrit": "गृहं वनं चोपविशेत् प्रव्रजेद् वा द्विजोत्तमः।\nआश्रमादाश्रमं गच्छेत् नान्यथानाश्रमश्चरेत्॥ ११/१७/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.041.m4a", "display_order": 42}, {"id": 6000318042, "chapter_id": 10318, "verse_number": "११-१७-३९", "content_sanskrit": "गृहार्थी सदृशीं भार्यामुद्वहेदजुगुप्सिताम्।\nयवीयसीं तु वयसा यां सवर्णामनुक्रमात्॥ ११/१७/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.042.m4a", "display_order": 43}, {"id": 6000318043, "chapter_id": 10318, "verse_number": "११-१७-४०", "content_sanskrit": "इज्याध्ययनदानानि सर्वेषां च द्विजन्मनाम्।\nप्रतिग्रहोऽध्यापनं च ब्राह्मणस्यैव याजनम्॥ ११/१७/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.043.m4a", "display_order": 44}, {"id": 6000318044, "chapter_id": 10318, "verse_number": "११-१७-४१", "content_sanskrit": "प्रतिग्रहं मन्यमानस्तपस्तेजोयशोनुदम्।\nअन्याभ्यां चैव जीवेत शिलैर्वा दोषदृक् तयोः॥ ११/१७/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.044.m4a", "display_order": 45}, {"id": 6000318045, "chapter_id": 10318, "verse_number": "११-१७-४२", "content_sanskrit": "ब्राह्मणस्य च देहोऽयं क्षुद्रकामाय नेष्यते।\nकृच्छ्राय तपसे चेह प्रेत्यानन्तसुखाय च॥ ११/१७/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.045.m4a", "display_order": 46}, {"id": 6000318046, "chapter_id": 10318, "verse_number": "११-१७-४३", "content_sanskrit": "शिलोञ्छवृत्त्या परितुष्टचित्तो धर्मं महान्तं विरजं जुषाणः।\nमय्यर्पितात्मा गृह एव तिष्ठन् नातिप्रसक्तः समुपैति शान्तिम्॥ ११/१७/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.046.m4a", "display_order": 47}, {"id": 6000318047, "chapter_id": 10318, "verse_number": "११-१७-४४", "content_sanskrit": "समुद्धरन्ति ये विप्रं सीदन्तं मत्परायणम्।\nतानुद्धरिष्ये नचिरादापदो नौरिवार्णवात्॥ ११/१७/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.047.m4a", "display_order": 48}, {"id": 6000318048, "chapter_id": 10318, "verse_number": "११-१७-४५", "content_sanskrit": "सर्वाः समुद्धरेद् राजा पितेव व्यसनात् प्रजाः।\nआत्मानमात्मना धीरो यथा गजपतिर्गजान्॥ ११/१७/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.048.m4a", "display_order": 49}, {"id": 6000318049, "chapter_id": 10318, "verse_number": "११-१७-४६", "content_sanskrit": "एवंविधो नरपतिर्विमानेनार्कवर्चसा।\nविधूयेहाशुभं कृत्स्नमिन्द्रेण सह मोदते॥ ११/१७/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.049.m4a", "display_order": 50}, {"id": 6000318050, "chapter_id": 10318, "verse_number": "११-१७-४७", "content_sanskrit": "सीदन् विप्रो वणिग्वृत्त्या पण्यैरेवापदं तरेत्।\nखड्गेन वाऽऽपदाक्रन्तो न श्ववृत्त्या कथञ्चन॥ ११/१७/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.050.m4a", "display_order": 51}, {"id": 6000318051, "chapter_id": 10318, "verse_number": "११-१७-४८", "content_sanskrit": "वैश्यवृत्त्या तु राजन्यो जीवेन्मृगययाऽऽपदि।\nचरेद् वा विप्ररूपेण न श्ववृत्त्या कथञ्चन॥ ११/१७/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.051.m4a", "display_order": 52}, {"id": 6000318052, "chapter_id": 10318, "verse_number": "११-१७-४९", "content_sanskrit": "शूद्रवृत्तिं भजेद् वैश्यः शूद्रो वै कारुकक्रियाम्।\nकृच्छ्रान्मुक्तो न गर्ह्येण वृत्तिं लिप्सेत कर्मणा॥ ११/१७/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.052.m4a", "display_order": 53}, {"id": 6000318053, "chapter_id": 10318, "verse_number": "११-१७-५०", "content_sanskrit": "वेदाध्यायी स्वधास्वाहाबल्यन्नाद्यैर्यथोदयम्।\nदेवर्षिपितृभूतानि मद्रूपाण्यन्वहं यजेत्॥ ११/१७/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.053.m4a", "display_order": 54}, {"id": 6000318054, "chapter_id": 10318, "verse_number": "११-१७-५१", "content_sanskrit": "यदृच्छयोपपन्नेन शुक्लेनोपार्जितेन वा।\nधनेनापीडयन् भृत्यान् मां यजेतान्वहं विभुम्॥ ११/१७/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.054.m4a", "display_order": 55}, {"id": 6000318055, "chapter_id": 10318, "verse_number": "११-१७-५२", "content_sanskrit": "कुटुम्बेषु न सज्जेत न प्रमाद्येत् कुटुम्ब्यपि।\nविपश्चिन्नश्वरं पश्येददृष्टमपि दृष्टवत्॥ ११/१७/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.055.m4a", "display_order": 56}, {"id": 6000318056, "chapter_id": 10318, "verse_number": "११-१७-५३", "content_sanskrit": "पुत्रदाराप्तबन्धूनां सङ्गमः पान्थसङ्गमः।\nअनुदेहं भवन्त्येते स्वप्नो निद्रानुगो यथा॥ ११/१७/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.056.m4a", "display_order": 57}, {"id": 6000318057, "chapter_id": 10318, "verse_number": "११-१७-५४", "content_sanskrit": "इत्थं परिमृशन् युक्तो गृहेष्वतिथिवद् वसेत्।\nन गृहैरनुबध्येत निर्ममो निरहंकृतिः॥ ११/१७/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.057.m4a", "display_order": 58}, {"id": 6000318058, "chapter_id": 10318, "verse_number": "११-१७-५५", "content_sanskrit": "कर्मभिर्गृहमेधीयैरिष्ट्वा मामेव भक्तिमान्।\nतिष्ठेद् वनं वोपविशेत् प्रज्ञावान् वा परिव्रजेत्॥ ११/१७/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.058.m4a", "display_order": 59}, {"id": 6000318059, "chapter_id": 10318, "verse_number": "११-१७-५६", "content_sanskrit": "यस्त्वासक्तमतिर्गेहे पुत्रवित्तेषणातुरः।\nस्त्रैणः कृपणधीर्मूढो ममाहमिति बध्यते॥ ११/१७/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.059.m4a", "display_order": 60}, {"id": 6000318060, "chapter_id": 10318, "verse_number": "११-१७-५७", "content_sanskrit": "अहो मे पितरौ वृद्धौ भार्या बालात्मजा सती।\nअनाथा मामृते दीनाः कथं जीवन्ति दुःखिताः॥ ११/१७/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.060.m4a", "display_order": 61}, {"id": 6000318061, "chapter_id": 10318, "verse_number": "११-१७-५८", "content_sanskrit": "एवं गृहाशयाऽऽक्षिप्तहृदयो मूढधीरयम् ।\nअतृप्तस्ताननुध्यायन् मृतोऽन्धं विशते तमः॥ ११/१७/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_017/BhP_11.017.061.m4a", "display_order": 62}, {"id": 6000318062, "chapter_id": 10318, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् एकादशस्कन्धे सप्तदशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]