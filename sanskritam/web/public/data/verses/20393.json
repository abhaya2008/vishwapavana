[{"id": 7000393000, "chapter_id": 20393, "verse_number": "२-६५-१", "content_sanskrit": "ययातिरुवाच ।\nधर्मस्य रक्षकः कायो मातले चात्मना सह ।\nनाकमेष न प्रयाति तन्मे त्वं कारणं वद॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000393001, "chapter_id": 20393, "verse_number": "२-६५-२", "content_sanskrit": "मातलिरुवाच ।\nपंचानामपि भूतानां संगतिर्नास्ति भूपते ।\nआत्मना सह वर्तंते संगत्या नैव पंच ते॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000393002, "chapter_id": 20393, "verse_number": "२-६५-३", "content_sanskrit": "सर्वेषां तत्र संघातः कायग्रामे प्रवर्तते ।\nजरया पीडिताः सर्वेः स्वंस्वं स्थानं प्रयांति ते॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000393003, "chapter_id": 20393, "verse_number": "२-६५-४", "content_sanskrit": "यथा रसाधिका पृथ्वी महाराज प्रकल्पिता ।\nरसैः क्लिन्ना ततः पृथ्वी मृदुत्वं याति भूपते॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000393004, "chapter_id": 20393, "verse_number": "२-६५-५", "content_sanskrit": "भिद्यते पिपीलिकाभिर्मूषिकाभिस्तथैव च ।\nछिद्राण्येव प्रजायंते वल्मीकाश्च महोदराः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000393005, "chapter_id": 20393, "verse_number": "२-६५-६", "content_sanskrit": "तद्वत्काये प्रजायंते गंडमाला विचार्चिकाः ।\nकृमिभिर्भिद्यमानश्च काय एष नरोत्तम॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000393006, "chapter_id": 20393, "verse_number": "२-६५-७", "content_sanskrit": "गुल्मास्तत्र प्रजायंते सद्यः पीडाकरास्तदा ।\nएभिर्दोषैः समायुक्तः कायोयं नहुषात्मज ।\nकथं प्राणसमायोगाद्दिवं याति नरेश्वर॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000393007, "chapter_id": 20393, "verse_number": "२-६५-८", "content_sanskrit": "काये पार्थिवभागोऽयं समानार्थं प्रतिष्ठितः ।\nन कायः स्वर्गमायाति यथा पृथ्वी तथास्थितः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000393008, "chapter_id": 20393, "verse_number": "२-६५-९", "content_sanskrit": "एतत्ते सर्वमाख्यातं दोषौघैः पार्थिवस्य यः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]