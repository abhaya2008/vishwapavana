[{"id": 40017133, "chapter_id": 9258, "verse_number": "1", "content_sanskrit": "नरान्तकंहतंदृष्टवाचुक्रुशुर्नैरृतर्षभाः । देवान्तकस्त्रिमूर्धा च पौलस्त्यश्चमहोदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40017134, "chapter_id": 9258, "verse_number": "2", "content_sanskrit": "आरूढोमेघसङ्काशंवारणेन्द्रंमहोदरः । वालिपुत्रंमहावीर्यमभिदुद्राववीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40017135, "chapter_id": 9258, "verse_number": "3", "content_sanskrit": "भ्रारातृव्यसनसन्तप्तस्तदादेवान्तकोबली । आदायपरिघंदीप्तमङ्गदंसमभिद्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40017136, "chapter_id": 9258, "verse_number": "4", "content_sanskrit": "रथमादित्यसङ्काशंयुक्तंपरमवाजिभिः । आस्थायत्रिशिरावीरोवालिपुत्रमथाभ्ययात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40017137, "chapter_id": 9258, "verse_number": "5", "content_sanskrit": "स त्रिभिर्देवदर्पघ्नेर्नेरृतीन्द्रेरभिद्रुतः । वृक्षमुत्पाटयामासमहाविटपमङ्गदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40017138, "chapter_id": 9258, "verse_number": "6", "content_sanskrit": "देवान्तकायतंवीरच्शिक्षेपसहसाङ्गदः । महावृक्षंमहाशाखंशक्रोदीप्तमिवाशनिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40017139, "chapter_id": 9258, "verse_number": "7", "content_sanskrit": "त्रिशिरास्तंप्रचिच्छेदशरैराशीविषोपमैः । स वृक्षंकृत्तमालोक्यउत्पपाततदाङ्गदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40017140, "chapter_id": 9258, "verse_number": "8", "content_sanskrit": "स ववर्षततोवृक्षान् शैलाश्चकपिकुञ्जरः । तान् प्रचिच्छेदसङ्कृद्धस्त्रिशिरानिशितैश्शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40017141, "chapter_id": 9258, "verse_number": "9", "content_sanskrit": "परिघाग्रेणतान् वृक्षान्बभञ्ज च महोदरः । त्रिशिराश्चाङ्गदंवीरमभिदुद्रावसायकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40017142, "chapter_id": 9258, "verse_number": "10", "content_sanskrit": "गजेनसमभिद्रुत्यवालिपुत्रंमहोदरः । जघानोरसिसङ्कृद्धस्तोमरैर्वज्रसन्निभैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40017143, "chapter_id": 9258, "verse_number": "11", "content_sanskrit": "देवान्तकश्चसङ्कृद्धःपरिघेणतदाङ्गदम् । उपगम्याभिहत्याशुव्यपचक्रामवेगवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40017144, "chapter_id": 9258, "verse_number": "12", "content_sanskrit": "सत्रिभिर्नैरृतश्रेष्ठैर्युगतपत्समभिद्रुतः । न विव्यथेमहातेजावालिपुत्रःप्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40017145, "chapter_id": 9258, "verse_number": "13", "content_sanskrit": "स वेगवान्महावेगंकृत्वापरमदुर्जयः । तलेनभृशमुत्पत्यजघानास्यमहागजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40017146, "chapter_id": 9258, "verse_number": "14", "content_sanskrit": "तस्यतेनप्रहारेणनागराजस्यसंयुगे । पेततुर्लोचनेतस्यविननाद स वारणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40017147, "chapter_id": 9258, "verse_number": "15", "content_sanskrit": "विषाणंचास्यसःनिष्कृष्यवालिपुत्रोमहाबलः । देवान्तकमभिप्लुत्यताडयामाससंयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40017148, "chapter_id": 9258, "verse_number": "16", "content_sanskrit": "स विह्वलस्तुतेजस्वीवातोद्धूतइवद्रुमः । लक्षारससवर्णं च सुस्रावरुधिरंमहत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40017149, "chapter_id": 9258, "verse_number": "17", "content_sanskrit": "अथाश्वस्यमहातेजाःकृच्छ्राद्देवान्तकोबली । आविध्यपरिघंवेगादाजघानतदाङ्गदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40017150, "chapter_id": 9258, "verse_number": "18", "content_sanskrit": "परिघाभिहतश्चापिवानरेन्द्रात्मजस्तदा । जानुभ्यांपतितोबूमौपुनरेवोत्पपात ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40017151, "chapter_id": 9258, "verse_number": "19", "content_sanskrit": "तमुत्पतन्तंत्रिशिरास्त्रिभिर्बाणैरजिह्मगैः । घोरैर्हरिपतेःपुत्रेंललाटेऽभिजघान ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40017152, "chapter_id": 9258, "verse_number": "20", "content_sanskrit": "ततोऽङ्गदंपरिक्षिप्तंत्रिभिर्नैरृतपुङ्गवैः । हनूमानपिविज्ञायनीलश्चापिप्रतस्थतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40017153, "chapter_id": 9258, "verse_number": "21", "content_sanskrit": "तश्चिक्षेपशैलाग्रंनीलस्त्रिशिरसेतदा । तद्रावणसुतोधीमाबनिभेदनिशितैश्शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40017154, "chapter_id": 9258, "verse_number": "22", "content_sanskrit": "तद्बाणशतनिर्भिन्नंविदारितशिलातलम् । सविस्फुलिंगंसज्वालंनिपपातगिरेशशिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40017155, "chapter_id": 9258, "verse_number": "23", "content_sanskrit": "ततोजृम्भितमालोक्यहर्षाद्वेवान्तकस्तदा । परिघेणाभिदुद्रावमारुतात्मजमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40017156, "chapter_id": 9258, "verse_number": "24", "content_sanskrit": "तमापतन्तमुत्प्लुत्यहनुमान्मारुतात्मजः । आजघानतदामूर्ध्निवज्रकल्पेनमुष्टिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40017157, "chapter_id": 9258, "verse_number": "25", "content_sanskrit": "शिरसिप्रहरवनीरस्तदावायुसुतोबली । नादेनाकम्पयच्चैवराक्षसान् स महाकपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40017158, "chapter_id": 9258, "verse_number": "26", "content_sanskrit": "मुष्टिनिष्पिष्टविभिन्नमूर्धानिर्वान्तदन्ताक्षिविलम्बिजिव्वाः । देवान्तकोराक्षसराजसूनुर्गतासुरुत्व्यांसहसापपात ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40017159, "chapter_id": 9258, "verse_number": "27", "content_sanskrit": "तस्मिन्हतेराक्षसयोधमुख्येमहाबलेसंयतिदेवशत्रौ । क्रुद्धस्त्रिमूर्धानिशिताग्रमुग्रंववर्षनीलोरसिबाणवर्षम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40017160, "chapter_id": 9258, "verse_number": "28", "content_sanskrit": "महोदरस्तुसङ्कृद्धःकुञ्जरंपर्वतोपमम् । भूयस्समधिरुह्याशुमन्दरंरमशिमानिव ॥ ततोबाणमयंवर्षंनीलस्योरस्यपातयत् । गिरौवर्षंतडिच्चक्रचापवानिवतोयदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40017161, "chapter_id": 9258, "verse_number": "29", "content_sanskrit": "महोदरस्तुसङ्कृद्धःकुञ्जरंपर्वतोपमम् । भूयस्समधिरुह्याशुमन्दरंरमशिमानिव ॥ ततोबाणमयंवर्षंनीलस्योरस्यपातयत् । गिरौवर्षंतडिच्चक्रचापवानिवतोयदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40017162, "chapter_id": 9258, "verse_number": "30", "content_sanskrit": "ततश्शरौघेरभिवर्ष्यमाणोविभिन्नगात्रःकपिसैन्यपालः । नीलोबभूवाथविसृष्टगात्रोविष्टम्भितस्तेनमहाबलेन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40017163, "chapter_id": 9258, "verse_number": "31", "content_sanskrit": "ततस्तुनीलःप्रतिलभ्यसंज्ञांशैलंसमुत्पाट्यसवृक्षषंण्डम् । ततस्समुत्पत्यभृशोग्रवेशोमहादरंतेनजघानमूर्ध्नि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40017164, "chapter_id": 9258, "verse_number": "32", "content_sanskrit": "तत: स्सशैलेद्रनिपातभग्नोमहोदरस्तेनमहाद्विपेन । विपोथितोभूमितलेगतासुःपपातवज्राभिहतोयथाद्रिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40017165, "chapter_id": 9258, "verse_number": "33", "content_sanskrit": "पितृव्यंनिहतंदृष्टवात्रिशिराश्चापमाददे । हनूमन्तं च सङ्कृद्धोविव्याथनिशितैश्शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40017166, "chapter_id": 9258, "verse_number": "34", "content_sanskrit": "स वायुसुनूःकुपितश्चिक्षेपशिखरंगिरेः । त्रिशिरास्तच्छरैस्तीक्ष्णैर्बिभेदबहुधाबली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40017167, "chapter_id": 9258, "verse_number": "35", "content_sanskrit": "तद्व्यर्थंशिखरंदृष्टवाद्रुमवर्षंमहाकपिः । विससर्जरणेतस्मिन्रावणस्यसुतंप्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40017168, "chapter_id": 9258, "verse_number": "36", "content_sanskrit": "तमापतन्तमाकाशेद्रुमवर्षंप्रतापवान् । त्रिशिरानिशितैर्बाणैश्चिच्छेद च ननाद च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40017169, "chapter_id": 9258, "verse_number": "37", "content_sanskrit": "हनूमानुतोप्लुत्यहयंस्त्रीशिरसस्तदा । विददारनखैःक्रुद्धोनागेन्द्रंमृगराडिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40017170, "chapter_id": 9258, "verse_number": "38", "content_sanskrit": "अथशक्तिंसमादायकाळरात्रिमिवान्तकः । चिक्षेपानिलपुत्रायत्रिशिरारावणात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40017171, "chapter_id": 9258, "verse_number": "39", "content_sanskrit": "दिवःक्षिप्तामिवोल्कांतांशक्तिंक्षिप्तामसङ्गताम् । गृहीत्वाहरिशार्दूलोबभञ्ज च ननाद च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40017172, "chapter_id": 9258, "verse_number": "40", "content_sanskrit": "तांदृष्टवाघोरसङ्काशांशक्तिंभग्नांहनूमता । प्रहृष्टावानरगणाविनेदुर्जलदाइव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40017173, "chapter_id": 9258, "verse_number": "41", "content_sanskrit": "तःखडगंसमुद्यम्यत्रिशिराराक्षसोत्तमः । निजघानतदाव्यूढेवायुपुत्रस्यवक्षसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40017174, "chapter_id": 9258, "verse_number": "42", "content_sanskrit": "खडगप्रहाराभिहतोहनुमान्मारुतात्मजः । आजघानतिशिरसंतलेनोरसिवीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40017175, "chapter_id": 9258, "verse_number": "43", "content_sanskrit": "सतलाभिहतस्तेनस्रस्तहस्तायुधोभुवि । निपपातमहातेजास्त्रिशिरास्त्यक्तचेतनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40017176, "chapter_id": 9258, "verse_number": "44", "content_sanskrit": "स तस्यपततःखङ्गंतमाच्छिद्यमहाकपिः । ननादगिरिसङ्काशस्त्रासयन् सर्वनैरृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40017177, "chapter_id": 9258, "verse_number": "45", "content_sanskrit": "अमृष्यमाणस्तंघोषमुत्पपातनिशाचरः । उत्पत्य च हनूमन्तंताडयामासमुष्टिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 40017178, "chapter_id": 9258, "verse_number": "46", "content_sanskrit": "तेनमुष्टिप्रहोरेणसञ्चुकोपमहाकपिः । कुपितश्चनिजग्राहकिरीटेराक्षसर्षभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 40017179, "chapter_id": 9258, "verse_number": "47", "content_sanskrit": "स तस्यशीर्षाण्यसिनाशितेनकिरीटजुष्टानिसकुण्डलानि । क्रुद्धःप्रचिच्छेदसुतोऽनिलस्यत्वष्टुस्सुतस्येवशिरांसिशक्रः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 40017180, "chapter_id": 9258, "verse_number": "48", "content_sanskrit": "तान्यायताक्षाण्यगसन्निभानिप्रदीप्तवैश्वानरलोचनानि । पेतुशिरांसीन्द्ररिपोःर्धरण्यांज्योतींषिमुक्तानियथार्कमार्गात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 40017181, "chapter_id": 9258, "verse_number": "49", "content_sanskrit": "तस्मिन् न्हतेदेवरिपौत्रिशीर्षेहनूमताशक्रपराक्रमेण । नेदुःप्लवंगाःप्रचचालभूमीरक्षांस्यथोदुद्रुविरेसमन्तात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 40017182, "chapter_id": 9258, "verse_number": "50", "content_sanskrit": "हतंत्रिशिरसंदृष्टवातथैवचमहोदरं । हतौप्रेक्षयदुराधर्षौदेवान्तकनरान्तकौ ॥ चुकोपपरमामर्षीमत्तोराक्षसपुङ्गवः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 40017183, "chapter_id": 9258, "verse_number": "51", "content_sanskrit": "जग्राहार्चिष्मतींघोरांगदांसर्वायसींशुभां ॥ हेमपट्टपरिक्षिप्तांमांसशोणितफेनिलाम् । विराजमानांवपुषांशत्रुशोणितरंजिताम् ॥ तेजसासंप्रदीप्ताग्रांरक्तमाल्यविभूषिताम् । ऐरावतमहापद्मसार्वभौमभयावहाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 40017184, "chapter_id": 9258, "verse_number": "52", "content_sanskrit": "जग्राहार्चिष्मतींघोरांगदांसर्वायसींशुभां ॥ हेमपट्टपरिक्षिप्तांमांसशोणितफेनिलाम् । विराजमानांवपुषांशत्रुशोणितरंजिताम् ॥ तेजसासंप्रदीप्ताग्रांरक्तमाल्यविभूषिताम् । ऐरावतमहापद्मसार्वभौमभयावहाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 40017185, "chapter_id": 9258, "verse_number": "53", "content_sanskrit": "जग्राहार्चिष्मतींघोरांगदांसर्वायसींशुभां ॥ हेमपट्टपरिक्षिप्तांमांसशोणितफेनिलाम् । विराजमानांवपुषांशत्रुशोणितरंजिताम् ॥ तेजसासंप्रदीप्ताग्रांरक्तमाल्यविभूषिताम् । ऐरावतमहापद्मसार्वभौमभयावहाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 40017186, "chapter_id": 9258, "verse_number": "54", "content_sanskrit": "गदामादायसङ्कृद्धोमत्तोराक्षसपुङ्गवः । हरीन् समभिदुद्रावयुगान्तानगिरिवज्वलन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 40017187, "chapter_id": 9258, "verse_number": "55", "content_sanskrit": "अथर्षभस्समुत्पत्यवानरोरावणानुजम् । मत्तानीकमुपागम्यतस्थौतस्याग्रतोबली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 40017188, "chapter_id": 9258, "verse_number": "56", "content_sanskrit": "तंपुरस्तात् स्थितंदृष्टवावानरंपर्वतोपमम् । आजघानोरसिक्रुद्धोगदयावज्रकल्पया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 40017189, "chapter_id": 9258, "verse_number": "57", "content_sanskrit": "स तयाऽभिहतस्तेनगदयावानरर्षभः । भिन्नवक्षास्समाधूतस्सुस्रावरुधिरंबहु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 40017190, "chapter_id": 9258, "verse_number": "58", "content_sanskrit": "स संज्ञांप्राप्यसुचिरादृषभोवानरर्षभः । क्रुद्धोविस्फुरमाणौष्ठोमहापार्श्वमुदैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 40017191, "chapter_id": 9258, "verse_number": "59", "content_sanskrit": "स वेगवान् वेगवदभ्युपेत्यतंराक्षसंवानरवीरमुख्यः । सम्वर्त्यमुष्टिंसहसाजघानबाह्वन्तरेशैलनिकाशरूपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 40017192, "chapter_id": 9258, "verse_number": "60", "content_sanskrit": "स कृत्तमूलस्सहसेववृक्षःक्षितौपपातक्षतजोक्षिताङ्गः । तांचास्यघोरांयमदण्डकल्पांगदांप्रगृह्याशुतदाननाद ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 40017193, "chapter_id": 9258, "verse_number": "61", "content_sanskrit": "मुहूर्तमासीत्सगतासुकल्पःप्रत्यागतात्मासहसासुरारिः । उत्पत्यसन्ध्याभ्रसमानवर्णस्तंवारिराजात्मजमाजघान ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 40017194, "chapter_id": 9258, "verse_number": "62", "content_sanskrit": "स मूर्भितोभूमितलेपपातमुहूर्तमुत्पत्यपुनस्ससंज्ञः । तामेवतस्याद्रिवराद्रिकल्पांगदांसमाविध्यजघानसङ्ख्ये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 40017195, "chapter_id": 9258, "verse_number": "63", "content_sanskrit": "सातस्यरौद्रासमुपेत्यदेहंरौद्रस्यदेवाध्वरविप्रशत्रोः । बिभेदवक्षःक्षतजं च भूरिसुस्रावधात्वम्भइवाद्रिराजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 40017196, "chapter_id": 9258, "verse_number": "64", "content_sanskrit": "अभिदुद्राववेगेनगदांतस्यमहात्मनः । गृहीत्वातांगदांभीमामाविध्य च पुनःपुनः ॥ मत्तानीकंमहात्मानंजघानरणमूर्धनि ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 40017197, "chapter_id": 9258, "verse_number": "65", "content_sanskrit": "स स्वयागदयाभग्नोविदीर्णदशनेक्षणः ॥ निपपातततोमत्तोवज्राहतइवाचलः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 40017198, "chapter_id": 9258, "verse_number": "66", "content_sanskrit": "विदीर्णनयनेभूमौगतसत्त्वेगतायुषि ॥ पतितेराक्षसेतस्मिन् विद्रुतंराक्षसंबलम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]