[{"id": 5000258000, "chapter_id": 9258, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे एकषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000258001, "chapter_id": 9258, "verse_number": "३-६१-१", "content_sanskrit": "दृष्ट्वाऽऽश्रमपदं शून्यं रामो दशरथात्मजः।\nरहितां पर्णशालां च प्रविद्धान्यासनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000258002, "chapter_id": 9258, "verse_number": "३-६१-२", "content_sanskrit": "अदृष्ट्वा तत्र वैदेहीं संनिरीक्ष्य च सर्वशः।\nउवाच रामः प्राक्रुश्य प्रगृह्य रुचिरौ भुजौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000258003, "chapter_id": 9258, "verse_number": "३-६१-३", "content_sanskrit": "क्व नु लक्ष्मण वैदेही कं वा देशमितो गता।\nकेनाहृता वा सौमित्रे भक्षिता केन वा प्रिया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000258004, "chapter_id": 9258, "verse_number": "३-६१-४", "content_sanskrit": "वृक्षेणावार्य यदि मां सीते हसितुमिच्छसि।\nअलं ते हसितेनाद्य मां भजस्व सुदुःखितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000258005, "chapter_id": 9258, "verse_number": "३-६१-५", "content_sanskrit": "यैः परिक्रीडसे सीते विश्वस्तैर्मृगपोतकैः।\nएते हीनास्त्वया सौम्ये ध्यायन्त्यस्राविलेक्षणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000258006, "chapter_id": 9258, "verse_number": "३-६१-६", "content_sanskrit": "सीतया रहितोऽहं वै नहि जीवामि लक्ष्मण।\nवृतं शोकेन महता सीताहरणजेन माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000258007, "chapter_id": 9258, "verse_number": "३-६१-७", "content_sanskrit": "परलोके महाराजो नूनं द्रक्ष्यति मे पिता।\nकथं प्रतिज्ञां संश्रुत्य मया त्वमभियोजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000258008, "chapter_id": 9258, "verse_number": "३-६१-८", "content_sanskrit": "अपूरयित्वा तं कालं मत्सकाशमिहागतः।\nकामवृत्तमनार्यं वा मृषावादिनमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000258009, "chapter_id": 9258, "verse_number": "३-६१-९", "content_sanskrit": "धिक् त्वामिति परे लोके व्यक्तं वक्ष्यति मे पिता।\nविवशं शोकसंतप्तं दीनं भग्नमनोरथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000258010, "chapter_id": 9258, "verse_number": "३-६१-१०", "content_sanskrit": "मामिहोत्सृज्य करुणं कीर्तिर्नरमिवानृजुम्।\nक्व गच्छसि वरारोहे मा मोत्सृज सुमध्यमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000258011, "chapter_id": 9258, "verse_number": "३-६१-११", "content_sanskrit": "त्वया विरहितश्चाहं त्यक्ष्ये जीवितमात्मनः।\nइतीव विलपन् रामः सीतादर्शनलालसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000258012, "chapter_id": 9258, "verse_number": "३-६१-१२", "content_sanskrit": "न ददर्श सुदुःखार्तो राघवो जनकात्मजाम्।\nअनासादयमानं तं सीतां शोकपरायणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000258013, "chapter_id": 9258, "verse_number": "३-६१-१३", "content_sanskrit": "पङ्कमासाद्य विपुलं सीदन्तमिव कुञ्जरम्।\nलक्ष्मणो राममत्यर्थमुवाच हितकाम्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000258014, "chapter_id": 9258, "verse_number": "३-६१-१४", "content_sanskrit": "मा विषादं महाबुद्धे कुरु यत्नं मया सह।\nइदं गिरिवरं वीर बहुकन्दरशोभितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000258015, "chapter_id": 9258, "verse_number": "३-६१-१५", "content_sanskrit": "प्रियकाननसंचारा वनोन्मत्ता च मैथिली।\nसा वनं वा प्रविष्टा स्यान्नलिनीं वा सुपुष्पिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000258016, "chapter_id": 9258, "verse_number": "३-६१-१६", "content_sanskrit": "सरितं वापि सम्प्राप्ता मीनवञ्जुलसेविताम्।\nवित्रासयितुकामा वा लीना स्यात् कानने क्वचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000258017, "chapter_id": 9258, "verse_number": "३-६१-१७", "content_sanskrit": "जिज्ञासमाना वैदेही त्वां मां च पुरुषर्षभ।\nतस्या ह्यन्वेषणे श्रीमन् क्षिप्रमेव यतावहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000258018, "chapter_id": 9258, "verse_number": "३-६१-१८", "content_sanskrit": "वनं सर्वं विचिनुवो यत्र सा जनकात्मजा।\nमन्यसे यदि काकुत्स्थ मा स्म शोके मनः कृथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000258019, "chapter_id": 9258, "verse_number": "३-६१-१९", "content_sanskrit": "एवमुक्तः स सौहार्दाल्लक्ष्मणेन समाहितः।\nसह सौमित्रिणा रामो विचेतुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000258020, "chapter_id": 9258, "verse_number": "३-६१-२०", "content_sanskrit": "तौ वनानि गिरींश्चैव सरितश्च सरांसि च।\nनिखिलेन विचिन्वन्तौ सीतां दशरथात्मजौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000258021, "chapter_id": 9258, "verse_number": "३-६१-२१", "content_sanskrit": "तस्य शैलस्य सानूनि शिलाश्च शिखराणि च।\nनिखिलेन विचिन्वन्तौ नैव तामभिजग्मतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000258022, "chapter_id": 9258, "verse_number": "३-६१-२२", "content_sanskrit": "विचित्य सर्वतः शैलं रामो लक्ष्मणमब्रवीत्।\nनेह पश्यामि सौमित्रे वैदेहीं पर्वते शुभाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000258023, "chapter_id": 9258, "verse_number": "३-६१-२३", "content_sanskrit": "ततो दुःखाभिसंतप्तो लक्ष्मणो वाक्यमब्रवीत्।\nविचरन् दण्डकारण्यं भ्रातरं दीप्ततेजसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000258024, "chapter_id": 9258, "verse_number": "३-६१-२४", "content_sanskrit": "प्राप्स्यसे त्वं महाप्राज्ञ मैथिलीं जनकात्मजाम्।\nयथा विष्णुर्महाबाहुर्बलिं बद्‍ध्वा महीमिमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000258025, "chapter_id": 9258, "verse_number": "३-६१-२५", "content_sanskrit": "एवमुक्तस्तु वीरेण लक्ष्मणेन स राघवः।\nउवाच दीनया वाचा दुःखाभिहतचेतनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000258026, "chapter_id": 9258, "verse_number": "३-६१-२६", "content_sanskrit": "वनं सुविचितं सर्वं पद्मिन्यः फुल्लपङ्कजाः।\nगिरिश्चायं महाप्राज्ञ बहुकन्दरनिर्झरः।\nनहि पश्यामि वैदेहीं प्राणेभ्योऽपि गरीयसीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000258027, "chapter_id": 9258, "verse_number": "३-६१-२७", "content_sanskrit": "एवं स विलपन् रामः सीताहरणकर्षितः।\nदीनः शोकसमाविष्टो मुहूर्तं विह्वलोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000258028, "chapter_id": 9258, "verse_number": "३-६१-२८", "content_sanskrit": "स विह्वलितसर्वाङ्गो गतबुद्धिर्विचेतनः।\nनिषसादातुरो दीनो निःश्वस्याशीतमायतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000258029, "chapter_id": 9258, "verse_number": "३-६१-२९", "content_sanskrit": "बहुशः स तु निःश्वस्य रामो राजीवलोचनः।\nहा प्रियेति विचुक्रोश बहुशो बाष्पगद‍्गदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000258030, "chapter_id": 9258, "verse_number": "३-६१-३०", "content_sanskrit": "तं सान्त्वयामास ततो लक्ष्मणः प्रियबान्धवम्।\nबहुप्रकारं शोकार्तः प्रश्रितः प्रश्रिताञ्जलिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000258031, "chapter_id": 9258, "verse_number": "३-६१-३१", "content_sanskrit": "अनादृत्य तु तद् वाक्यं लक्ष्मणोष्ठपुटच्युतम्।\nअपश्यंस्तां प्रियां सीतां प्राक्रोशत् स पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000258032, "chapter_id": 9258, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे एकषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]