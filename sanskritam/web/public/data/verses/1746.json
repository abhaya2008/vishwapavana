[{"id": 2034601, "chapter_id": 1746, "verse_number": "४-६९-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2034602, "chapter_id": 1746, "verse_number": "४-६९-१", "content_sanskrit": "स विजित्य धनं चापि विराटो वाहिनीपतिः।\nप्राविशन्नगरं हृष्टश्चतुर्भिः सह पाण्डवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2034603, "chapter_id": 1746, "verse_number": "४-६९-२", "content_sanskrit": "जित्वा त्रिगर्तान्संग्रामे गाश्चैवानाय्य केवलाः।\nअशोभत महाराजः सह पार्थैः श्रिया वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2034604, "chapter_id": 1746, "verse_number": "४-६९-३", "content_sanskrit": "तमासनगत वीरं सुहृदां प्रीतिवर्धनम् ।\nतपतस्थुः प्रकृतयः समन्ताद्ब्राह्मणैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2034605, "chapter_id": 1746, "verse_number": "४-६९-४", "content_sanskrit": "सभाजितः सभासद्भिः प्रतिनन्द्य स मत्स्यराट् ।\nविसर्जयामास तदा द्विजांश्च प्रकृतीस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2034606, "chapter_id": 1746, "verse_number": "४-६९-५", "content_sanskrit": "ततः स राजा मात्स्यानां विराटो वाहिनीपतिः।\nप्रविश्यान्तःपुरं रम्यं स्त्रीशतैरुपशोभितम्।\nउत्तरं तत्र नापश्यत्क्व यात इति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2034607, "chapter_id": 1746, "verse_number": "४-६९-६", "content_sanskrit": "आचख्युस्तत्र संहृष्टाः स्त्रियः कन्याश्च वेश्मनि।\nअन्तःपुरचराश्चैव कुरुभिर्गोधनं हृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2034608, "chapter_id": 1746, "verse_number": "४-६९-७", "content_sanskrit": "ताञ्जेतुमभिसंरब्ध एक एवातिसाहसात् ।\nबृहन्नलासहायश्च निर्यातः पृथिवींजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2034609, "chapter_id": 1746, "verse_number": "४-६९-८", "content_sanskrit": "उपयातानतिरथान्द्रोणं शान्तनवं कृपम्।\nकर्णं दुर्योधनं चैव द्रोणपुत्रं च षड्रथान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2034610, "chapter_id": 1746, "verse_number": "४-६९-९", "content_sanskrit": "ततो विराटः परमाभितप्तः\nपुत्रं निशम्यैकरथेन यातम्।\nबृहन्नलासारथिमाजिमर्दनं\nप्रोवाच सर्वानथ मन्त्रिमुख्यान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2034611, "chapter_id": 1746, "verse_number": "४-६९-१०", "content_sanskrit": "गवां शतसहस्राणि उभिभूय ममात्मजम्।\nकुस्वः कालयन्ति स्म सर्वे युद्धविशारदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2034612, "chapter_id": 1746, "verse_number": "४-६९-११", "content_sanskrit": "तस्माद्गच्छतु मे योधा बलेन महता वृताः।\nउत्तरस्य परीप्सार्थं ये त्रिगर्तैरविक्षताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2034613, "chapter_id": 1746, "verse_number": "४-६९-१२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2034614, "chapter_id": 1746, "verse_number": "४-६९-१२", "content_sanskrit": "हयांश्च नागांश्च रथांश्च शीघ्रं\nवादित्रसङ्घांश्च ततः प्रभूतान्।\nप्रस्थापयामास सुतस्य हेतो-\nर्विचित्रचित्राभरणोपपन्नान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2034615, "chapter_id": 1746, "verse_number": "४-६९-१३", "content_sanskrit": "एवं स राजा मात्स्यानां महानक्षोहिणीपतिः।\nव्यादिदेशाथ स क्षिप्रं वाहिनीं चतुरङ्गिणीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2034616, "chapter_id": 1746, "verse_number": "४-६९-१४", "content_sanskrit": "कुमारमाशु जानीत यदि जीवति वा नवा।\nयस्य यन्ता गतः षण्डो मन्येऽहं स न जीवति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2034617, "chapter_id": 1746, "verse_number": "४-६९-१५", "content_sanskrit": "तमब्रवीद्धर्मसुतो विराट-\nमार्तं विदित्वा कुरुभिः प्रतप्तम्।\nबृहन्नला सारथिश्चेन्नरेन्द्र\nपरे न नेष्यन्ति तवाद्य गाश्च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2034618, "chapter_id": 1746, "verse_number": "४-६९-१६", "content_sanskrit": "सर्वान्महीपान्सहितान्कुरूंश्च\nतथैव देवासुरनागयक्षान्।\nअलं विजेतुं समरे सुतस्ते\nअनुष्ठितः सारथिना हि तेन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2034619, "chapter_id": 1746, "verse_number": "४-६९-१७", "content_sanskrit": "सर्वथा कुरवश्चापि ये चान्ये वसुधाधिपाः ।\nत्रिगर्तान्निर्जिताञ्श्रुत्वा न स्थास्यन्ति कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2034620, "chapter_id": 1746, "verse_number": "४-६९-१८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2034621, "chapter_id": 1746, "verse_number": "४-६९-१८", "content_sanskrit": "अथोत्तरेण प्रहिता दूतास्ते शीघ्रगामिनः ।\nविराटनगरं प्राप्य जयं प्रावेदयंस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2034622, "chapter_id": 1746, "verse_number": "४-६९-१९", "content_sanskrit": "राजानं वृतमाचख्युर्मन्त्रिभिर्जयमुत्तमम् ।\nपराजयं कुरूणां च उपायान्तं तथोत्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2034623, "chapter_id": 1746, "verse_number": "४-६९-२०", "content_sanskrit": "सर्वा विनिर्जिता गावः कुरवश्च पराजिताः।\nउत्तरः सह सूतेन कुशली च परंतपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2034624, "chapter_id": 1746, "verse_number": "४-६९-२१x", "content_sanskrit": "कङ्क उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2034625, "chapter_id": 1746, "verse_number": "४-६९-२१", "content_sanskrit": "दिष्ट्या ते निर्जिता गावः कुरवश्च पराजिताः।\nदिष्ट्या ते विजयी पुत्रः श्रूयते पार्थिवर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2034626, "chapter_id": 1746, "verse_number": "४-६९-२२", "content_sanskrit": "नाद्भुतं त्विह मन्येऽहं यत्ते पुत्रोऽजयत्कुरून्।\nध्रुव एव जयस्तस्य यस्य यन्ता बृहन्नला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2034627, "chapter_id": 1746, "verse_number": "४-६९-२३", "content_sanskrit": "देवेन्द्रसारथिश्चैव मातलिः ख्यातविक्रमः ।\nकृष्णस्य सारथिश्चैव न बृहन्नलया समौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2034628, "chapter_id": 1746, "verse_number": "४-६९-२४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2034629, "chapter_id": 1746, "verse_number": "४-६९-२४", "content_sanskrit": "ततो विराटो नृपतिः संप्रहृष्टतनूरुह।\nश्रुत्वा तु विजयं तस्य कुमारस्यामितौजसः।\nसंतोषयित्वा दूतांस्तान्धनरत्नैश्च सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2034630, "chapter_id": 1746, "verse_number": "४-६९-२५", "content_sanskrit": "गते त्वनुजने तस्मिन्दूतवाक्यं निशम्य च।\nउत्तरस्य जयात्प्रीतो विराटः प्रत्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2034631, "chapter_id": 1746, "verse_number": "४-६९-२६", "content_sanskrit": "राजमार्गाः क्रियन्तां वै पताकाभिरलंकृताः।\nपुष्पोपहारैरर्च्यतां देवताश्चापि सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2034632, "chapter_id": 1746, "verse_number": "४-६९-२७", "content_sanskrit": "कुमारा योधमुख्याश्च गणिकाश्च स्वलंकृताः।\nवादित्राणि च सर्वाणि प्रत्युद्यान्तु सुतं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2034633, "chapter_id": 1746, "verse_number": "४-६९-२८", "content_sanskrit": "भवन्तु ते लब्धजये सुते मे\nपौराश्च मर्त्याश्च परे च नार्यः ।\nते शुक्लवस्त्राः प्रभवन्तु मार्गे\nसुगन्धमाल्याभरणाश्च नार्यः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2034634, "chapter_id": 1746, "verse_number": "४-६९-२९", "content_sanskrit": "भजन्तु सर्वा गणिकाः सुतं मे\nनार्यश्च कन्याः सहसैनिकाश्च ।\nस्वलंकृतास्ताः सुभगाः सुवेषाः\nपुत्रस्य पन्थानमनुव्रजन्तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2034635, "chapter_id": 1746, "verse_number": "४-६९-३०", "content_sanskrit": "घण्टापणवकाः शीघ्रं मत्तमारुह्य कुञ्जरम्।\nशृङ्गाटकेषु सर्वेषु समाख्यान्तु जयं मम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2034636, "chapter_id": 1746, "verse_number": "४-६९-३१", "content_sanskrit": "उत्तरा च कुमारीभिर्बह्वाभरणभूषिता।\nसखीं विजितसंग्रामां प्रत्युद्यातु बृहन्नलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2034637, "chapter_id": 1746, "verse_number": "४-६९-३२", "content_sanskrit": "श्रुत्वा तु वचनं तस्य पार्थिवस्य महात्मन।\nतथैव चक्रुः संहृष्टाः पौराः स्वस्तिकपाणयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2034638, "chapter_id": 1746, "verse_number": "४-६९-३३", "content_sanskrit": "मूताश्च सर्वे सहमागधाश्च\nहृष्टा विराटस्य पुरे जनौघाः ।\nभेर्यश्च तूर्याणि च वारिजाश्च\nवेपैः परार्ध्यैः प्रमदाजनाश्च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2034639, "chapter_id": 1746, "verse_number": "४-६९-३४", "content_sanskrit": "वन्दिप्रवादाः पणवादिकाश्च\nतथैव वाद्यानि च वंशशब्दाः ।\nकांस्यं सतालं मधुरं च गीत-\nमादाय नार्यो नगरान्निरीयुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2034640, "chapter_id": 1746, "verse_number": "४-६९-३५", "content_sanskrit": "प्रत्युद्ययुः पुत्रमनन्तवीर्यं\nते ब्राह्मणाः शान्तिपराः प्रधानाः ।\nस्वाध्यायवेदाध्ययनक्रमज्ञाः\nस्वस्तिक्रियागीतजपप्रधानाः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2034641, "chapter_id": 1746, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि गोग्रहणपर्वणि एकोनसप्ततितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]