[{"id": 2093446, "chapter_id": 2995, "verse_number": "१३-१२५-१", "content_sanskrit": "`शुक उवाच।\nक्षत्रियाश्चैव शूद्राश्च मन्त्रहीनाश्च ये द्विजाः।\nकपिलामुपजीवन्ति कथमेतत्पितर्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2093447, "chapter_id": 2995, "verse_number": "१३-१२५-२x", "content_sanskrit": "श्रीव्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2093448, "chapter_id": 2995, "verse_number": "१३-१२५-२", "content_sanskrit": "क्षत्रियाश्चैव शूद्राश्च मन्त्रहीनाश्च ये द्विजाः।\nकपिलामुपजीवन्ति तेषां वक्ष्यामि निर्णयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2093449, "chapter_id": 2995, "verse_number": "१३-१२५-३", "content_sanskrit": "कपिलास्तूत्तमा लोके गोषु चैवोत्तमा मताः।\nतासां दाता लभेत्स्वर्गं विधिना यश्च सेवते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2093450, "chapter_id": 2995, "verse_number": "१३-१२५-४", "content_sanskrit": "स्पृशेत कपिलां यस्तु दण्डेन चरणेन वा।\nस तेन स्पर्शमात्रेण नरकायोपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2093451, "chapter_id": 2995, "verse_number": "१३-१२५-५", "content_sanskrit": "मन्त्रेण युञ्ज्यात्कपिलां मन्त्रेणैव प्रमुञ्चते।\nमन्त्रिहीनं तु यो युञ्जात्कृमियोनौ प्रसूयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2093452, "chapter_id": 2995, "verse_number": "१३-१२५-६", "content_sanskrit": "प्रहाराहतमर्माङ्गा दुःखेन च जडीकृता।\nपदानि यावद्गच्छेत तावल्लोकान्कृमिर्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2093453, "chapter_id": 2995, "verse_number": "१३-१२५-७", "content_sanskrit": "यावन्तो बिन्दवस्तस्याः शोणितस्य क्षितिं गताः।\nतावद्वर्षसहस्राणि नरकं प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2093454, "chapter_id": 2995, "verse_number": "१३-१२५-८", "content_sanskrit": "मन्त्रेण युञ्ज्यात्कपिलां मन्त्रेण विनियोजयेत्।\nमन्त्रहीनैरनुयुतो मञ्जयेत्तमसि प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2093455, "chapter_id": 2995, "verse_number": "१३-१२५-९", "content_sanskrit": "कपिलां येऽपि जीवन्ति बुद्धिमोहान्विता नराः।\nतेऽपि वर्षसहस्राणि पतन्ति नरके नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2093456, "chapter_id": 2995, "verse_number": "१३-१२५-१०", "content_sanskrit": "अथ न्यायेन ये विप्राः कपिलामुपयुञ्जते।\nतस्मिंल्लोके प्रमोदन्ते लोकाश्चैषामनामयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2093457, "chapter_id": 2995, "verse_number": "१३-१२५-११", "content_sanskrit": "विधिना ये न कुर्वन्ति शूद्रास्तानुपधारय॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2093458, "chapter_id": 2995, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि पञ्चविंशत्यधिकशततमोऽध्यायः॥ १२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]