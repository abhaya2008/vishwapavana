[{"id": 2178292, "chapter_id": 4770, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2178293, "chapter_id": 4770, "verse_number": "१", "content_sanskrit": "धृतराष्ट्राभ्यनुज्ञाताः ततस्ते कुरुपुङ्गवाः ।\nअभ्ययुर्भ्रातरः सर्वे गान्धारीं सहकेशवाः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2178294, "chapter_id": 4770, "verse_number": "२", "content_sanskrit": "ततो ज्ञात्वा हतामित्रं धर्मराजं युधिष्ठिरम् ।\nगान्धारी पुत्रशोकार्ता शप्तुमैच्छदनिन्दिता\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2178295, "chapter_id": 4770, "verse_number": "३", "content_sanskrit": "तस्याः पापमभिप्रायं विदित्वा पाण्डवान् प्रति ।\nऋषिर्गन्धवतीपुत्रः प्रागेव समपद्यत\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2178296, "chapter_id": 4770, "verse_number": "४", "content_sanskrit": "स गङ्गायामुपस्पृश्य ब्रह्मर्षिः प्रयतः शुचिः ।\nतं देशमुपसम्पेदे पाराशर्यो मनोजवः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2178297, "chapter_id": 4770, "verse_number": "५", "content_sanskrit": "दिव्येन चक्षुषा ज्ञात्वा मनसाऽनुद्धतेन च ।\nसर्वं प्राणभृतां भावं सततं समबुद्ध्यत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2178298, "chapter_id": 4770, "verse_number": "६", "content_sanskrit": "स स्नुषामब्रवीत् काले कल्याणानि महातपाः ।\nशापकालमवाक्षिप्य शमकालमुदीरयन्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2178299, "chapter_id": 4770, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2178300, "chapter_id": 4770, "verse_number": "७", "content_sanskrit": "न कोपः पाण्डवे कार्यो गान्धारि शममाप्नुहि ।\nरजो निगृह्यतां चैव शृणु चेदं वचो मम\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2178301, "chapter_id": 4770, "verse_number": "८", "content_sanskrit": "पुरोक्ता युद्धकाले त्वं पुत्रेण जयमिच्छता ।\nजयमाशास्व मे मातर्युद्ध्यमानस्य शत्रुभिः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2178302, "chapter_id": 4770, "verse_number": "९", "content_sanskrit": "सा तथा याच्यमाना त्वं युद्धकाले जयैषिणा ।\nउक्तवत्यसि कल्याणि यतो धर्मस्ततो जयः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2178303, "chapter_id": 4770, "verse_number": "१०", "content_sanskrit": "वाक्ये व्यतीते मा क्रोधे मनः कुरु यशस्विनि ।\nस्मरामि भाषमाणां हि त्वामहं सत्यवादिनीम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2178304, "chapter_id": 4770, "verse_number": "११", "content_sanskrit": "विग्रहे तुमुले राज्ञां गत्वा परमसंशयम् ।\nजितं पाण्डुसुतैर्युद्धे नूनं धर्मस्ततोऽधिकः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2178305, "chapter_id": 4770, "verse_number": "१२", "content_sanskrit": "क्षमाशीला पुरा भूत्वा साऽद्य न क्षमसे कथम् ।\nअधर्मं जहि धर्मज्ञे यतो धर्मस्ततो जयः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2178306, "chapter_id": 4770, "verse_number": "१३", "content_sanskrit": "सा त्वं धर्मं परित्यज्य वाचं चोक्तां मनस्विनि ।\nकोपं संयच्छ गान्धारि मैवं भूः सत्यवादिनि\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2178307, "chapter_id": 4770, "verse_number": "", "content_sanskrit": "गान्धारी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2178308, "chapter_id": 4770, "verse_number": "१४", "content_sanskrit": "भगवन् नाभ्यसूयामि नैतानिच्छामि नश्यतः ।\nपुत्रशोकेन तु बलान्मनो विह्वलतीव मे\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2178309, "chapter_id": 4770, "verse_number": "१५", "content_sanskrit": "यथैव कुन्त्या कौन्तेया रक्षितव्यास्तथा मया ।\nतथैव धृतराष्ट्रेण रक्षितव्या मया यथा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2178310, "chapter_id": 4770, "verse_number": "१६", "content_sanskrit": "दुःशासनापराधेन शकुनेः सौबलस्य च ।\nकर्णदुर्योधनाभ्यां च वृत्तोऽयं कुरुसङ्क्षयः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2178311, "chapter_id": 4770, "verse_number": "१७", "content_sanskrit": "नापराध्नोति बीभत्सुः न च पार्थो वृकोदरः ।\nनकुलः सहदेवश्च नैव जातु युधिष्ठिरः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2178312, "chapter_id": 4770, "verse_number": "१८", "content_sanskrit": "युध्यमाना हि कौरव्याः कृन्तमानाः परस्परम् ।\nनिहतास्तैर्हताश्चान्ये तत्र नास्त्यप्रियं मम\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2178313, "chapter_id": 4770, "verse_number": "१९", "content_sanskrit": "यत् तु कर्माकरोद्भीमो वासुदेवस्य पश्यतः ।\nदुर्योधनं समाहूय गदायुद्धे महामनाः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2178314, "chapter_id": 4770, "verse_number": "२०", "content_sanskrit": "शिक्षयाऽभ्यधिकं ज्ञात्वा चरन्तं बहुधा रणे ।\nअधो नाभेः प्रहृतवान् तन्मे कोपयतीव हि\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2178315, "chapter_id": 4770, "verse_number": "२१", "content_sanskrit": "कथं हि धर्मं धर्मज्ञाः समुद्दिष्टं महात्मभिः ।\nत्यजेयुराहवे शूराः प्राणहेतोः कथञ्चन\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2178316, "chapter_id": 4770, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां स्त्रीपर्वणि\nगान्धारीवाक्यं नाम चतुर्दशोऽध्यायः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2178317, "chapter_id": 4770, "verse_number": "", "content_sanskrit": "जलप्रदानपर्वणि चतुर्दशोऽध्यायः ॥१४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]