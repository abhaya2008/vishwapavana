[{"id": 2049136, "chapter_id": 2080, "verse_number": "७-१-०x", "content_sanskrit": "द्रोण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2049137, "chapter_id": 2080, "verse_number": "७-१-१", "content_sanskrit": "वेदं षडङ्गं वेदाहमर्थविद्यां च मानवीम्।\nत्रैय्यम्बकमथेष्वस्त्रं शस्त्राणि विविधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2049138, "chapter_id": 2080, "verse_number": "७-१-२", "content_sanskrit": "ये चाप्युक्ता मयि गुणा भवद्भिर्जयकाङ्क्षिभिः।\nचिकीर्षुस्तानहं सर्वान्योधयिष्यामि पाण्डवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2049139, "chapter_id": 2080, "verse_number": "७-१-३", "content_sanskrit": "पार्षतं तु रणे राजन्न हनिष्ये कथञ्चन।\nस हि सृष्टो वधार्थाय ममैव पुरुषर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2049140, "chapter_id": 2080, "verse_number": "७-१-४", "content_sanskrit": "योधयिष्यामि सैन्यानि नाशयन्सर्वसोमकान्।\nन च मां पाण्डवा युद्धे योधयिष्यन्ति हर्षिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2049141, "chapter_id": 2080, "verse_number": "७-१-५x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2049142, "chapter_id": 2080, "verse_number": "७-१-५", "content_sanskrit": "स एवमभ्यनुज्ञातश्चक्रे सेनापतिं ततः।\nद्रोणं तव सुतो राजन्विधिदृष्टेन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2049143, "chapter_id": 2080, "verse_number": "७-१-६", "content_sanskrit": "अथाभिषिषिचुर्द्रोणं दुर्योधनमुखा नृपाः।\n`स्वस्तिवादरवैश्चान्यैः श्लक्ष्णैश्चान्यैर्मनोरमैः।\nसैनापत्ये यथा स्कन्दं पुरा शक्रमुखाः सुराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2049144, "chapter_id": 2080, "verse_number": "७-१-७", "content_sanskrit": "ततो वादित्रघोषेण शङ्खानां च महास्वनैः।\nप्रादुरासीत्कृते द्रोणे हर्षः सेनापतौ तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2049145, "chapter_id": 2080, "verse_number": "७-१-८", "content_sanskrit": "ततः पुण्याहघोषेण साशीर्वादस्वनेन च।\nसंस्तवैर्गीतशब्दैश्च सूतमागधबन्दिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2049146, "chapter_id": 2080, "verse_number": "७-१-९", "content_sanskrit": "जयशब्दैर्द्विजाग्र्याणां सुभगानर्तितैस्तथा।\nसत्कृत्य विधिना द्रोणं मेनिरे पाण्डवाञ्जितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2049147, "chapter_id": 2080, "verse_number": "७-१-१०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2049148, "chapter_id": 2080, "verse_number": "७-१-१०", "content_sanskrit": "सैनापत्यं तु संप्राप्य भारद्वाजो महारथः।\nयुयुत्सुर्व्यूह्य सैन्यानि प्रायात्तव सुतैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2049149, "chapter_id": 2080, "verse_number": "७-१-११", "content_sanskrit": "सैन्धवश्च कलिङ्गश्च विकर्णश्च तवात्मजः।\nदक्षिणं पार्श्वमास्थाय समतिष्ठन्त दंशिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2049150, "chapter_id": 2080, "verse_number": "७-१-१२", "content_sanskrit": "प्रपक्षः शकुनिस्तेषां प्रवरैर्हयसादिभिः।\nययौ गान्धारकैः सार्धं विमलप्रासयोधिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2049151, "chapter_id": 2080, "verse_number": "७-१-१३", "content_sanskrit": "कृपश्च कृतवर्मा च चित्रसेनो विविंशतिः।\nदुःशासनमुखा यत्ताः सव्यं पक्षमपालयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2049152, "chapter_id": 2080, "verse_number": "७-१-१४", "content_sanskrit": "तेषां प्रपक्षाः काम्भोजाः सुदक्षिणपुस्सराः।\nययुरश्चैर्महावेगैः शकाश्च यवनैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2049153, "chapter_id": 2080, "verse_number": "७-१-१५", "content_sanskrit": "मद्रास्त्रिगर्ताः साम्बष्ठाः प्रतीच्योदीच्यमालवाः।\nशिबयः शूरसेनाश्च शूद्राश्च मलदैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2049154, "chapter_id": 2080, "verse_number": "७-१-१६", "content_sanskrit": "सौवीराः कितवाः प्राच्या दाक्षिणात्याश्च सर्वशः।\nनवात्मजं पुरस्कृत्य सूतपुत्रस्य पृष्ठतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2049155, "chapter_id": 2080, "verse_number": "७-१-१७", "content_sanskrit": "हर्षयन्तः स्वसैन्यानि ययुस्तव सुतैः सह।\nप्रवरः सर्वयोधानां बलेषु बलमादधम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2049156, "chapter_id": 2080, "verse_number": "७-१-१८", "content_sanskrit": "ययौ वैकर्तनः कर्णः प्रमुखे सर्वधन्विनाम्।\nतस्य दीप्तो महाकायः स्वान्यनीकानिहर्षयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2049157, "chapter_id": 2080, "verse_number": "७-१-१९", "content_sanskrit": "हस्तिकक्ष्यो गहाकेतुर्बभौ सूर्यसमद्युतिः।\nन भीष्मव्यसनं कश्चिदृष्ट्वा कर्णममन्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2049158, "chapter_id": 2080, "verse_number": "७-१-२०", "content_sanskrit": "विशोकाश्चाभवन्सर्वे राजानः कुरुभिः सह।\nहृष्टाश्च बहवो योधास्तत्राजल्पन्त वेगतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2049159, "chapter_id": 2080, "verse_number": "७-१-२१", "content_sanskrit": "न हि कर्णं रणे दृष्ट्वा युधि स्थास्यन्ति पाण्डवाः।\nकर्णो हि समरे शक्तो जेतुं देवान्सवासवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2049160, "chapter_id": 2080, "verse_number": "७-१-२२", "content_sanskrit": "किमु पाण्डुसुतान्युद्धे हीनवीर्यपराक्रमान्।\nभीष्मेण तु रणे पार्थाः पालिता बाहुशालिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2049161, "chapter_id": 2080, "verse_number": "७-१-२३", "content_sanskrit": "तांस्तु कर्णः शरैस्तीक्ष्णैर्नाशयिष्यति संयुगे।\nएवं ब्रुवन्तस्तेऽन्योन्यं हृष्टरूपा विशांपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2049162, "chapter_id": 2080, "verse_number": "७-१-२४", "content_sanskrit": "राधेयं पूजयन्तश्च प्रशंसन्तश्च निर्ययुः।\nअस्माकं शकटव्यूहों द्रोणेन विहितोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2049163, "chapter_id": 2080, "verse_number": "७-१-२५", "content_sanskrit": "परेषां क्रौञ्च एवासीद्व्यूहो राजन्महात्मनाम्।\nप्रीयमाणेन विहितो धर्मराजेन भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2049164, "chapter_id": 2080, "verse_number": "७-१-२६", "content_sanskrit": "व्यूहप्रमुखतस्तेषां तस्थतुः पुरुषर्षभौ।\nवानरध्वजमुच्छ्रित्य विष्वक्सेनधनंजयौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2049165, "chapter_id": 2080, "verse_number": "७-१-२७", "content_sanskrit": "ककुदं सर्वसैन्यानां धाम सर्वधनुष्मताम्।\nआदित्यपथगः केतुः पार्थस्यामिततेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2049166, "chapter_id": 2080, "verse_number": "७-१-२८", "content_sanskrit": "दीपयामास तत्सैन्यं पाण्डवस्य महात्मनः।\nयथा प्रज्वलितः सूर्यो युगान्ते वै वसुंधराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2049167, "chapter_id": 2080, "verse_number": "७-१-२९", "content_sanskrit": "दीप्यन्दृश्येत हि तथा केतुः सर्वत्र धीमतः।\nयोधानामर्जुनः श्रेष्ठो गाण्डीवं धनुषां वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2049168, "chapter_id": 2080, "verse_number": "७-१-३०", "content_sanskrit": "वासुदेवश्च भूतानां चक्राणां च सुदर्शनम्।\nचत्वार्येतानि तेजाञ्सि वहञ्श्वेतहयो रथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2049169, "chapter_id": 2080, "verse_number": "७-१-३१", "content_sanskrit": "परेषामग्रतस्तस्थौ कालचक्रमिवोद्यतम्।\nएवं तौ सुमहात्मानौ बलसेनाग्रगावुभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2049170, "chapter_id": 2080, "verse_number": "७-१-३२", "content_sanskrit": "तावकानां मुखे कर्णः परेषां च धनंजयः।\nततो जयाभिसंरब्धौ परस्परवधैषिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2049171, "chapter_id": 2080, "verse_number": "७-१-३३", "content_sanskrit": "अवेक्षेतां तदान्योन्यं समरे कर्णपाण्डवौ।\nततः प्रयाते सहसा भारद्वाजे महारथे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2049172, "chapter_id": 2080, "verse_number": "७-१-३४", "content_sanskrit": "सिंहनादेन घोरेण वसुधा समकम्पत।\nततस्तुमुलमाकाशमावृणोत्सदिवाकरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2049173, "chapter_id": 2080, "verse_number": "७-१-३५", "content_sanskrit": "वातोद्भूतं रजस्तीव्रं कौशेयनिकरोपमम्।\nववर्ष द्यौरनभ्राऽपि मांसास्थिरुधिराण्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2049174, "chapter_id": 2080, "verse_number": "७-१-३६", "content_sanskrit": "गृध्राः श्येना बकाः कङ्का वायसाश्च सहस्रशः।\nउपर्युपरि सेनां ते तदा पर्यपतन्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2049175, "chapter_id": 2080, "verse_number": "७-१-३७", "content_sanskrit": "गोमायवश्च प्राक्रोशन्भयदान्दारुणान्रवान्।\nअकार्षुरपसव्यं च बहुशः पृतनां तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2049176, "chapter_id": 2080, "verse_number": "७-१-३८", "content_sanskrit": "चिखादिषन्तो मांसानि पिपासन्तश्च शोणितम्।\nअपतद्दीप्यमाना च सनिर्घाता सकम्पना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2049177, "chapter_id": 2080, "verse_number": "७-१-३९", "content_sanskrit": "उल्का ज्वलन्ती सङ्ग्रामे पुच्छेनावृत्य सर्वशः।\nपरिवेषो महांश्चापि सविद्युत्स्तनयित्नुमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2049178, "chapter_id": 2080, "verse_number": "७-१-४०", "content_sanskrit": "भास्करस्याभवद्राजन्प्रयाते वाहिनीपतौ।\nएते चान्ये च बहवः प्रादुरासन्सुदारुणाः।\nउत्पाता युधि वीराणां जीवितक्षयकारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2049179, "chapter_id": 2080, "verse_number": "७-१-४१", "content_sanskrit": "ततः प्रववृते युद्धं परस्परवधैषिणाम्।\nकुरुपाण्डवसैन्यानां शब्देनापूरयज्जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2049180, "chapter_id": 2080, "verse_number": "७-१-४२", "content_sanskrit": "ते त्वन्योन्यं सुसंरब्धाः पाण्डवाः कौरवैः सह।\nअभ्यघ्नन्निशितैः शस्त्रैर्जयगृद्धाः प्रहारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2049181, "chapter_id": 2080, "verse_number": "७-१-४३", "content_sanskrit": "स पाण्डवानां महतीं महेष्वासो महाद्युतिः।\nवेगेनाभ्यद्रवत्सेनां किरञ्शरशतैः शितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2049182, "chapter_id": 2080, "verse_number": "७-१-४४", "content_sanskrit": "द्रोणमभ्युद्यतं दृष्ट्वा पाण्डवाः सहसृञ्जयैः।\nप्रत्यगृह्णंस्तदा राजञ्छरवर्षैः पृथक्पृथक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2049183, "chapter_id": 2080, "verse_number": "७-१-४५", "content_sanskrit": "विक्षोभ्यमाणआ द्रोणेन भिद्यमाना महाचमूः।\nव्यशीर्यत सपाञ्चाला वातेनेव वलाहकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2049184, "chapter_id": 2080, "verse_number": "७-१-४६", "content_sanskrit": "बहूनीह विकुर्वाणो दिव्यान्यस्त्राणि संयुगे।\nअपीडयत्क्षणेनैव द्रोणः पाण्डवसृञ्जयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2049185, "chapter_id": 2080, "verse_number": "७-१-४७", "content_sanskrit": "ते वध्यमाना द्रोणेन वासवेनेव दानवाः।\nपाञ्चालाः समकम्पन्त धृष्टद्युम्नपुरोगमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2049186, "chapter_id": 2080, "verse_number": "७-१-४८", "content_sanskrit": "ततो दिव्यास्त्रविच्छूरो याज्ञसेनिर्महारथः।\nअभिनच्छरवर्षेण द्रोणानीकमनेकधा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2049187, "chapter_id": 2080, "verse_number": "७-१-४९", "content_sanskrit": "द्रोणस्य शरवर्षाणि शरवर्षेण पार्षतः।\nसन्निवार्य ततः सर्वान्कुरूनप्यवधीद्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2049188, "chapter_id": 2080, "verse_number": "७-१-५०", "content_sanskrit": "संयम्य तु ततो द्रोणः समवस्थाप्य चाहवे।\nस्वमनीकं महेष्वासः पार्षतं समुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2049189, "chapter_id": 2080, "verse_number": "७-१-५१", "content_sanskrit": "स बाणवर्षं सुमहदसृजत्पार्षतं प्रति।\nमघवान्समभिक्रुद्धः सहसा दानवानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2049190, "chapter_id": 2080, "verse_number": "७-१-५२", "content_sanskrit": "ते कम्प्यमाना द्रोणेन बाणैः पाण्डवसृञ्जयाः।\nपुनःपुनरभज्यन्त सिंहेनैवेतरे मृगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2049191, "chapter_id": 2080, "verse_number": "७-१-५३", "content_sanskrit": "तथा पर्यपतद्रोणः पाण्डवानां बले बली।\nअलातचक्रवद्राजंस्तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2049192, "chapter_id": 2080, "verse_number": "७-१-५४", "content_sanskrit": "खचरनगरकल्पं कल्पितं शास्त्रदृष्ट्या चलदनिलपताकं ह्लादनं वल्गिताश्वम्।\nस्फटिकविमलकेतुं त्रासनं शात्रवाणां रथवरमधिरूढः सञ्जहारारिसेनाम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2049193, "chapter_id": 2080, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि द्रोणाभिषेकपर्वणि\nMahabharata - Drona Parva - Chapter Footnotes\n५-१-९ सुभगानर्तितैः सौभाग्यवतीनृत्तैः॥ ५-१-२७ आदित्यपथगः आकाशगः॥ ५-१-५४ ह्लादनं योद्भुरानन्दजननम्॥ ५-१-७ सप्तमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]