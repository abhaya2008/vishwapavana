[{"id": 7005967000, "chapter_id": 25967, "verse_number": "१-१५०-१", "content_sanskrit": "धन्वन्तरिरुवाच ।\nअथातः श्वासरोगस्य निदानं प्रवदाम्यहम् ।\nकासवृद्ध्या भवेच्छ्वासः पूर्वैर्वा दोषकोपनैः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005967001, "chapter_id": 25967, "verse_number": "१-१५०-२", "content_sanskrit": "आमातिसारवमथुविषपाण्डुज्वरैरपि ।\nरजोधूमानिलैर्मर्मघातादपि हिमाम्बुना ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005967002, "chapter_id": 25967, "verse_number": "१-१५०-३", "content_sanskrit": "क्षुद्रकस्तमकश्छिन्नो महानूर्ध्वश् पञ्चमः ।\nकफोपरुद्धगमनपवनो विष्वगास्थितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005967003, "chapter_id": 25967, "verse_number": "१-१५०-४", "content_sanskrit": "प्राणोदकान्नवाहीनि दुष्टस्रोतांसि दूषयन् ।\nउरः स्थः कुरुते श्वासमामाशयसमुद्भवम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005967004, "chapter_id": 25967, "verse_number": "१-१५०-५", "content_sanskrit": "प्राग्रूपं तस्य हृत्पार्श्वशूलं प्राणविलमता ।\nआनाहः शङ्खभेदश्च तत्रायासोऽतिभोजनैः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005967005, "chapter_id": 25967, "verse_number": "१-१५०-६", "content_sanskrit": "प्रेरितः प्रेरयन्क्षुद्रं स्वयं स समलं रुत् ।\nप्रतिलोमं शिरा गच्छेदुदीर्य पवनः कफम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005967006, "chapter_id": 25967, "verse_number": "१-१५०-७", "content_sanskrit": "परिगृह्यशिरोग्रीवमुरः पार्श्वे च पीडयन ।\nकासं घुर्घुरकं मोहमरुचिम्पीनसं भृशम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005967007, "chapter_id": 25967, "verse_number": "१-१५०-८", "content_sanskrit": "करोति तीव्रवेगञ्च श्वासं प्राणोपतापिनम् ।\nप्रताम्येत्तस्य वेगेनष्ठीवनान्ते क्षणं सुखी ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005967008, "chapter_id": 25967, "verse_number": "१-१५०-९", "content_sanskrit": "कृच्छ्राच्छयानः श्वसिति निषण्णः स्वास्थ्यमर्हत ।\nउच्छ्रिताक्षो ललाटेन स्विद्यता भृशमार्तिमान् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005967009, "chapter_id": 25967, "verse_number": "१-१५०-१०", "content_sanskrit": "विशुष्कास्यो मुहुः श्वासः काङ्क्षत्युष्णं सवेपथु। ।\nमेघाम्बुशीतप्राग्वातैः श्लेष्मलैश्च विवर्धते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005967010, "chapter_id": 25967, "verse_number": "१-१५०-११", "content_sanskrit": "स याप्यस्तमकः साध्यो नरस्य बलिनो भवेत् ।\nज्वरमूर्छावतः सीतैर्न शाम्येत्प्रथमस्तु सः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005967011, "chapter_id": 25967, "verse_number": "१-१५०-१२", "content_sanskrit": "कासश्वसितवच्छीर्णमर्मच्छेदरुजार्दितः ।\nसस्वेदमूर्छः सानाहो बस्तिदाहविबोधवान् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005967012, "chapter_id": 25967, "verse_number": "१-१५०-१३", "content_sanskrit": "अधोदृष्टिः शुताक्षस्तु स्निह्यद्रक्तैकलोचनः ।\nशुष्कास्यः प्रलपन्दीनो नष्टच्छायो विचेतनः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005967013, "chapter_id": 25967, "verse_number": "१-१५०-१४", "content_sanskrit": "महातामहता दीनो नादेन श्वसिति क्रथन् ।\nउद्धूयमानः संरब्धो मत्तर्षभ इवानिशम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005967014, "chapter_id": 25967, "verse_number": "१-१५०-१५", "content_sanskrit": "प्रनष्टज्ञानविज्ञानो विभ्रान्तनयनाननः ।\nनेत्रे समाक्षिपन्बद्धमूत्रवर्चा विशीर्णवाक् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005967015, "chapter_id": 25967, "verse_number": "१-१५०-१६", "content_sanskrit": "शुष्ककण्ठो मुहुश्चैव कर्णशङ्खाशिरोऽतिरुक् ।\nयो दीर्घमुच्छ्वसित्यूर्ध्वं न च प्रत्याहरत्यधः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005967016, "chapter_id": 25967, "verse_number": "१-१५०-१७", "content_sanskrit": "श्लेष्मावृतमुखश्रोत्रः क्रुद्धगन्धवहार्दितः ।\nऊर्ध्वं समीक्षते भ्रान्तमक्षिणी परितः क्षिपन् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005967017, "chapter_id": 25967, "verse_number": "१-१५०-१८", "content_sanskrit": "मर्मसु च्छिद्यमानेषु परिदेवी निरुद्धवाक् ।\nएते सिध्येयुरव्यक्ताः व्यक्ताः प्राणहरा ध्रुवम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]