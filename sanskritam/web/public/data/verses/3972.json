[{"id": 2137218, "chapter_id": 3972, "verse_number": "१", "content_sanskrit": "तस्यां रात्र्यां व्यतीतायामुदिते सूर्यमण्डले ।\nकृतपौर्वाह्णिकाः सर्वे समेयुस्ते तपोधनाः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2137219, "chapter_id": 3972, "verse_number": "२", "content_sanskrit": "तदेव सर्वं सावित्र्या महाभाग्यं महर्षयः ।\nद्युमत्सेनाय नातृप्यन् कथयन्तः पुनः पुनः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2137220, "chapter_id": 3972, "verse_number": "३", "content_sanskrit": "ततः प्रकृतयः सर्वाः शाल्वःअभ्योऽभ्यागता नृप ।\nआचख्युर्निहतं चैव स्वेनामात्येन तं द्विषम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2137221, "chapter_id": 3972, "verse_number": "४", "content_sanskrit": "तं मन्त्रिणा हतं श्रुत्वा ससहायं सबान्धवम् ।\nन्यवेदयन् यथावृत्तं विद्रुतं च द्विषद्बलम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2137222, "chapter_id": 3972, "verse_number": "", "content_sanskrit": "ऐकमत्यं च सर्वस्य जनस्याथ नृपं प्रति ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2137223, "chapter_id": 3972, "verse_number": "", "content_sanskrit": "प्रकृतयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2137224, "chapter_id": 3972, "verse_number": "५", "content_sanskrit": "सचक्षुर्वाप्यचक्षुर्वा स नो राजा भवत्विति \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2137225, "chapter_id": 3972, "verse_number": "६", "content_sanskrit": "अनेन निश्चयेनेह वयं प्रस्थापिता नृप ।\nप्राप्तानीमानि यानानि चतुरङ्गं च ते बलम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2137226, "chapter_id": 3972, "verse_number": "७", "content_sanskrit": "प्रयाहि राजन् भद्रं ते घुष्टस्ते नगरे जयः ।\nअध्यास्स्व चिररात्राय पितृपैतामहं पदम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2137227, "chapter_id": 3972, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2137228, "chapter_id": 3972, "verse_number": "८", "content_sanskrit": "चक्षुष्मन्तं च तं दृष्ट्वा राजानं वपुषान्वितम् ।\nमूर्ध्ना निपतिताः सर्वे विस्मयोत्फुल्ललोचनाः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2137229, "chapter_id": 3972, "verse_number": "९", "content_sanskrit": "ततोऽभिवाद्य तान् वृद्धान् द्विजानाश्रमवासिनः ।\nतैश्चाभिपूजितः सर्वैः प्रययौ नगरं प्रति \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2137230, "chapter_id": 3972, "verse_number": "१०", "content_sanskrit": "शैब्या च सह सावित्र्या स्वास्तीर्णेन सुवर्चसा ।\nनरयुक्तेन यानेन प्रययौ सेनया वृता \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2137231, "chapter_id": 3972, "verse_number": "११", "content_sanskrit": "ततोऽभिषिषिचुः प्रीत्या द्युमत्सेनं पुरोहिताः ।\nपुत्रं चास्य महात्मानं यौवराज्येऽभ्यषेचयन् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2137232, "chapter_id": 3972, "verse_number": "१२", "content_sanskrit": "ततः कालेन महता सावित्र्याः कीर्तिवर्धनम् ।\nतद्वै पुत्रशतं जज्ञे शूराणामनिवर्तिनाम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2137233, "chapter_id": 3972, "verse_number": "१३", "content_sanskrit": "भ्रातॄणां सोदराणां च तथैवास्याभवच्छतम् ।\nमद्राधिपस्याश्वपतेर्मालव्यां सुमहद्बलम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2137234, "chapter_id": 3972, "verse_number": "१४", "content_sanskrit": "एवमात्मा पिता माता श्वश्रूः श्वशुर एव च ।\nभर्तुः कुलं च सावित्र्या सर्वं कृच्छ्रात् समुद्धृतम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2137235, "chapter_id": 3972, "verse_number": "१५", "content_sanskrit": "तथैवैषा हि कल्याणी द्रौपदी शीलसम्मता ।\nतारयिष्यति वः सर्वान् सावित्रीव कुलाङ्गना \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2137236, "chapter_id": 3972, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2137237, "chapter_id": 3972, "verse_number": "१६", "content_sanskrit": "एवं स पाण्डवस्तेन अनुनीतो महात्मना ।\nविशोको विज्वरो राजन् काम्यके न्यवसत् तदा \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2137238, "chapter_id": 3972, "verse_number": "१७", "content_sanskrit": "यश्चेदं शृणुयाद् भक्त्या सावित्र्याख्यानमुत्तमम् ।\nस सुखी सर्वसिद्धार्थो न दुःखं प्राप्नुयान्नरः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2137239, "chapter_id": 3972, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि अष्टाशीत्यधिकद्विशततमोऽध्यायः ॥२८८॥\nपतिव्रतामाहात्म्यपर्वणि सावित्र्युपाख्याने सप्तमोऽध्यायः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2137240, "chapter_id": 3972, "verse_number": "", "content_sanskrit": "॥ समाप्तं सावित्र्युपाख्यानपर्व ॥\n(पतिव्रतामाहात्म्यपर्व) ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2137241, "chapter_id": 3972, "verse_number": "", "content_sanskrit": "––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]