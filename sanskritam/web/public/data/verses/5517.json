[{"id": 2211935, "chapter_id": 5517, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2211936, "chapter_id": 5517, "verse_number": "१", "content_sanskrit": "भगवंस्तव भक्तस्य धर्माधर्ममजानतः ।\nधर्मं पुण्यतमं देव पृच्छतः कथयस्व मे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2211937, "chapter_id": 5517, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2211938, "chapter_id": 5517, "verse_number": "२", "content_sanskrit": "यदेतदग्निहोत्रं वै सृष्टं वर्णत्रयस्य तु ।\nमन्त्रवद् यद्धुतं सम्यग् विधिना चाप्युपासितम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2211939, "chapter_id": 5517, "verse_number": "३", "content_sanskrit": "आहिताग्निं नयत्यूर्ध्वं सपत्नीकं सबान्धवम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2211940, "chapter_id": 5517, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2211941, "chapter_id": 5517, "verse_number": "४", "content_sanskrit": "कथं तद् ब्राह्मणैर्देव होतव्यं क्षत्रियैः कथम् ।\nवैश्यैर्वा देवदेवेश कथं वा सुहुतं भवेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2211942, "chapter_id": 5517, "verse_number": "५", "content_sanskrit": "कस्मिन् कालेऽथवा कस्मिन्नाधेयोऽग्निः सुरोत्तम ।\nआहितस्य कथं वाऽपि सम्यगाचरणं भवेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2211943, "chapter_id": 5517, "verse_number": "६", "content_sanskrit": "कत्यग्नयः किमात्मानः स्थानं किं कस्य वा विभो ।\nकतरस्मिन् हुते स्थाने कं व्रजेदाग्निहोत्रिकः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2211944, "chapter_id": 5517, "verse_number": "७", "content_sanskrit": "अग्निहोत्रनिमित्तं च किमुत्पन्नं पुराऽनघ ।\nकथमेवाथ हूयन्ते प्रीयन्ते च सुराः कथम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2211945, "chapter_id": 5517, "verse_number": "८", "content_sanskrit": "विधिवन्मन्त्रवद्भक्त्या पूजितास्त्वग्नयः कथम् ।\nकां गतिं वदतांश्रेष्ठ नयन्ति ह्यग्निहोत्रिणः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2211946, "chapter_id": 5517, "verse_number": "९", "content_sanskrit": "दुर्हुताश्चापि भगवन्नविज्ञातास्त्रयोऽग्नयः ।\nकिमाहिताग्नेः कुर्वन्ति दुश्चीर्णा वाऽपि केशव ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2211947, "chapter_id": 5517, "verse_number": "१०", "content_sanskrit": "उत्सन्नाग्निस्तु पापात्मा कां योनिं देव गच्छति ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2211948, "chapter_id": 5517, "verse_number": "११", "content_sanskrit": "एतत्सर्वं समासेन भक्त्या ह्युपगतस्य मे ।\nवक्तुमर्हसि सर्वज्ञ सर्वात्मक नमोऽस्तु ते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2211949, "chapter_id": 5517, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2211950, "chapter_id": 5517, "verse_number": "१२", "content_sanskrit": "शृणु राजन् महापुण्यमिदं धर्मामृतं परम् ।\nयत्तु तारयते युक्तान् ब्राह्मणानग्निहोत्रिणः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2211951, "chapter_id": 5517, "verse_number": "१३", "content_sanskrit": "ब्रह्मत्वेनासृजं लोकान् अहमादौ महाद्युते ।\nसृष्टोऽग्निर्मुखतः पूर्वं लोकानां हितकाम्यया ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2211952, "chapter_id": 5517, "verse_number": "१४", "content_sanskrit": "यस्मादग्ने स भूतानां सर्वेषां निर्मितो मया ।\nतस्मादग्नीत्यभिहितः पुराणज्ञैर्महर्षिभिः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2211953, "chapter_id": 5517, "verse_number": "१५", "content_sanskrit": "यस्मात्तु सर्वकृत्येषु पूर्वमस्मै प्रदीयते ।\nआहुतिर्दीप्यमानाय तस्मादग्नीति कथ्यते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2211954, "chapter_id": 5517, "verse_number": "१६", "content_sanskrit": "यस्माच्च नयति ह्यग्र्यां गतिं विप्रान् सुपूजितः ।\nयस्माच्च नयनाद् राजन् देवेष्वग्नीति कीर्त्यते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2211955, "chapter_id": 5517, "verse_number": "१७", "content_sanskrit": "यस्माच्च दुर्हुतः सोऽयमलं भक्षयितुं क्षणात् ।\nयजमानं नरश्रेष्ठ क्रव्यादोऽग्निस्ततः स्मृतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2211956, "chapter_id": 5517, "verse_number": "१८", "content_sanskrit": "सर्वभूतात्मको राजन् देवानामेष वै मुखम् ।\nप्रथमं मन्मुखात् सृष्टो लोकार्थे पचनप्रभुः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2211957, "chapter_id": 5517, "verse_number": "१९", "content_sanskrit": "सृष्टमात्रो जगत्सर्वमत्तुमैच्छत् पुरा खलु ।\nततः प्रशमितः सोऽग्निरुपासीनो मया पुरा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2211958, "chapter_id": 5517, "verse_number": "२०", "content_sanskrit": "सततोपासनात् सोऽयमौपासन इति स्मृतः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2211959, "chapter_id": 5517, "verse_number": "२१", "content_sanskrit": "आहुतिः सर्वमाख्याता तस्मिन् वसति सोऽनलः ।\nआवसथ्य इति ख्यातस्तेनासौ ब्रह्मवादिभिः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2211960, "chapter_id": 5517, "verse_number": "२२", "content_sanskrit": "तस्मिन् पञ्च महायज्ञा वर्तन्ते यस्य धर्मतः ।\nसोममण्डलमध्येन गतिस्तस्य द्विजन्मनः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2211961, "chapter_id": 5517, "verse_number": "२३", "content_sanskrit": "तेन सप्तर्षयः सिद्धाः संयतेन्द्रियबुद्धयः ।\nगता ह्यमरसायुज्यमेकाग्न्यर्चनतत्पराः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2211962, "chapter_id": 5517, "verse_number": "२४", "content_sanskrit": "अपरे चावसथ्यं च पचनाग्निं प्रचक्षते ।\nतस्मिन् पञ्च महायज्ञा वैश्वदेवश्च वर्तते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2211963, "chapter_id": 5517, "verse_number": "२५", "content_sanskrit": "स्थालीपाकं च गार्ह्यं च सर्वे चास्मिन् प्रतिष्ठिताः ।\nगृहकर्मवहो यस्मात् तस्माद् गृहपतिस्तु सः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2211964, "chapter_id": 5517, "verse_number": "२६", "content_sanskrit": "औपासनं चावसथ्यं सभ्यं पचनपावकम् ।\nआहुर्ब्रह्मविदः केचिन्मतमेतन्ममापि च ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2211965, "chapter_id": 5517, "verse_number": "२७", "content_sanskrit": "अग्निहोत्रप्रकारं तु शृणु राजन् समाहितः ।\nत्रयाणां गुणनामानि वह्नीनामुच्यते मया ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2211966, "chapter_id": 5517, "verse_number": "२८", "content_sanskrit": "गृहाणां हि पतित्वं हि गृहपत्यमिति स्मृतम् ।\nगृहपत्यं तु यस्यासीत् तत् तस्माद् गार्हपत्यता ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2211967, "chapter_id": 5517, "verse_number": "२९", "content_sanskrit": "यजमानं तु यस्मात्तु दक्षिणां तु गतिं नयेत् ।\nदक्षिणाग्निं तमाहुस्ते दक्षिणायतनं द्विजाः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2211968, "chapter_id": 5517, "verse_number": "३०", "content_sanskrit": "आहुतिं सम्यगाख्यातां वहन्तं हव्यवाहनम् ।\nसर्वहव्यवहो वह्निर्गतश्चाहवनीयताम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2211969, "chapter_id": 5517, "verse_number": "३१", "content_sanskrit": "यस्त्वावसथ्यं जुहुयान्मूलाग्निं विधिवद् द्विजः ।\nआवसथ्यं तु तं चाग्निं पचनाग्निं प्रचक्षते ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2211970, "chapter_id": 5517, "verse_number": "३२", "content_sanskrit": "तेषां सभागतो वह्निः सभ्य इत्यभिधीयते ।\nआवसथ्यस्तु यो वह्निः प्रथमः स प्रजापतिः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2211971, "chapter_id": 5517, "verse_number": "३३", "content_sanskrit": "ब्रह्मा च गार्हपत्योऽग्निः तस्मादेव तु सोऽभवत् ।\nदक्षिणाग्निस्त्वयं रुद्रः क्रोधात्मा चण्ड एव सः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2211972, "chapter_id": 5517, "verse_number": "३४", "content_sanskrit": "अहमाहवनीयोऽग्निराहोमाद्यस्य वै मुखे ।\nसभ्योऽग्निः पञ्चमो यस्तु स्कन्द एव नराधिप ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2211973, "chapter_id": 5517, "verse_number": "३५", "content_sanskrit": "पृथिवी गार्हपत्योऽग्निरन्तरिक्षं च दक्षिणः ।\nस्वर्गमाहवनीयोऽग्निरेवमग्नित्रयं स्मृतम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2211974, "chapter_id": 5517, "verse_number": "३६", "content_sanskrit": "वृत्तश्च गार्हपत्योऽग्निर्यस्माद् वृत्ता च मेदिनी ।\nअर्धचन्द्राकृतिः खं वै दक्षिणाग्निस्तथा भवेत् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2211975, "chapter_id": 5517, "verse_number": "३७", "content_sanskrit": "चतुरश्रं ततः स्वर्गं निर्मलं तु निरामयम् ।\nतस्मादाहवनीयोऽग्निर्चतुरश्रो भवेन्नृप ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2211976, "chapter_id": 5517, "verse_number": "३८", "content_sanskrit": "जुहुयाद् गार्हपत्यं यो भुवं जयति स द्विजः ।\nजुहोति दक्षिणाग्निं यः स जयत्यन्तरिक्षकम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2211977, "chapter_id": 5517, "verse_number": "३९", "content_sanskrit": "पृथिवीमन्तरिक्षं च दिवं चर्षिगणैः सह ।\nजयत्याहवनीयं यो जुहुयाद् भक्तिमान् द्विजः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2211978, "chapter_id": 5517, "verse_number": "४०", "content_sanskrit": "आभिमुख्येन होमस्तु यस्य यज्ञेषु वर्तते ।\nतेनाप्याहवनीयत्वं गतो वह्निर्महाद्युतिः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2211979, "chapter_id": 5517, "verse_number": "४१", "content_sanskrit": "आहोमादग्निहोत्रेषु यज्ञैर्वा यत्र सर्वशः ।\nयस्मादस्मिन् प्रवर्तन्ते ततो ह्याहवनीयता ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2211980, "chapter_id": 5517, "verse_number": "४२", "content_sanskrit": "यस्त्वावसथ्यं जुहुयान्मूलाग्निं विधिवद् द्विजः ।\nस तु सप्तर्षिलोकेषु सपत्नीकः प्रमोदते ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2211981, "chapter_id": 5517, "verse_number": "४३", "content_sanskrit": "यश्चाप्युपासनः(सते) सभ्यं विधिवत् प्रयतात्मवान् ।\nस जयेद् वाङ्मयं सर्वं तथात्वृषिसभामपि ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2211982, "chapter_id": 5517, "verse_number": "४४", "content_sanskrit": "अग्नीनामथवाऽग्नेऽस्तु यस्य होमः प्रदीयते ।\nइष्टो भवति सर्वाग्निरग्निहोत्रं च यद्भवेत् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2211983, "chapter_id": 5517, "verse_number": "४५", "content_sanskrit": "त्राणाय यजमानस्य चाग्निहोत्रमिति स्मृतम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2211984, "chapter_id": 5517, "verse_number": "४६", "content_sanskrit": "हो इत्येष विषादो वै विषादो दुःखमुच्यते ।\nदुःखं तापत्रयं प्रोक्तं पापं हि नरकं विदुः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2211985, "chapter_id": 5517, "verse_number": "४७", "content_sanskrit": "तस्माद् वै त्रायते दुःखाद् यजमानं हुतोऽनलः ।\nतस्मात्तु विधिवत् प्रोक्तमग्निहोत्रमिति श्रुतौ ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2211986, "chapter_id": 5517, "verse_number": "४८", "content_sanskrit": "तदग्निहोत्रं सृष्टं वै ब्रह्मणा लोककर्तृणा ।\nवेदाश्चाप्यग्निहोत्रार्थं जज्ञिरे स्वयमेव तु ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2211987, "chapter_id": 5517, "verse_number": "४९", "content_sanskrit": "अग्निहोत्रफला वेदाः शीलवृत्तफलं श्रुतम् ।\nरतिपुत्रफला नारी दत्तभोगफलं धनम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2211988, "chapter_id": 5517, "verse_number": "५०", "content_sanskrit": "त्रिवेदमन्त्रसंयोगादग्निहोत्रं प्रवर्तते ।\nऋग्यजुः सामभिः पुण्येः स्थाप्यते सूत्रसंयुतैः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2211989, "chapter_id": 5517, "verse_number": "५१", "content_sanskrit": "वसन्तो ब्राह्मणस्य स्याद् आधेयोऽग्निर्नराधिप ।\nवसन्तो ब्राह्मणः प्रोक्तो वेदयोनिः स उच्यते ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2211990, "chapter_id": 5517, "verse_number": "५२", "content_sanskrit": "अग्न्याधेयं तु येनाथ वसन्ते क्रियते नृप ।\nतस्य श्रीर्ब्रह्मवृद्धिश्च ब्राह्मणस्य विवर्धते ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2211991, "chapter_id": 5517, "verse_number": "५३", "content_sanskrit": "क्षत्रियस्याग्निराधेयो ग्रीष्मे श्रेष्ठः स वै नृप ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2211992, "chapter_id": 5517, "verse_number": "५४", "content_sanskrit": "येनाधानं तु वै ग्रीष्मे क्रियते तस्य वर्धते ।\nश्रीः प्रजाः पशवश्चैव वित्तं तेजो बलं यशः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2211993, "chapter_id": 5517, "verse_number": "५५", "content_sanskrit": "शरद् रात्रेऽथ वैश्यस्य ह्याधानीयो हुताशनः ।\nशरद् रात्रं स्वयं वैश्यो वैश्ययोनिः स उच्यते ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2211994, "chapter_id": 5517, "verse_number": "५६", "content_sanskrit": "शरद्याधानमेवं वै क्रियते येन पाण्डव ।\nतस्यापि श्रीः प्रजाऽऽयुश्च पशवोऽर्थश्च वर्धते ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2211995, "chapter_id": 5517, "verse_number": "५७", "content_sanskrit": "पशवः सर्व एवैते त्रिभिर्वैदैरलङ्कृताः ।\nअग्निहोत्रात् प्रवर्धन्ते तैरेव ध्रियते जगत् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2211996, "chapter_id": 5517, "verse_number": "५८", "content_sanskrit": "ग्राम्यारण्याश्च पशवस्तथा वृक्षास्तृणानि च ।\nफलान्योषधयश्चापि अग्निहोत्रकृते हि ताः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2211997, "chapter_id": 5517, "verse_number": "५९", "content_sanskrit": "रसाः स्नेहास्तथा गन्धा रत्नानि मणयस्तथा ।\nकाञ्चनानि च लोहानि ह्यग्निहोत्रकृतेऽभवन् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2211998, "chapter_id": 5517, "verse_number": "६०", "content_sanskrit": "आयुर्वेदो धनुर्वेदो मीमांसा न्यायविस्तरः ।\nधर्मशास्त्रं च तत्सर्वमग्निहोत्रकृते कृतम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2211999, "chapter_id": 5517, "verse_number": "६१", "content_sanskrit": "छन्दः शिक्षा च कल्पाश्च तथा व्याकरणं नृप ।\nज्योतिःशास्त्रं निरुक्तं चाप्यग्निहोत्रकृते कृतम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2212000, "chapter_id": 5517, "verse_number": "समाप्तिः", "content_sanskrit": "इतिहासपुराणाश्च गाथाश्चोपनिषत् तथा ।\nआथर्वणानि कर्माणि चाग्निहोत्रकृते कृतम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2212001, "chapter_id": 5517, "verse_number": "६३", "content_sanskrit": "यच्चैतस्यां पृथिव्यां हि किञ्चिदस्ति चराचरम् ।\nतत्सर्वमग्निहोत्रस्य कृते सृष्टं स्वयम्भुवा ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2212002, "chapter_id": 5517, "verse_number": "६४", "content_sanskrit": "अग्निहोत्रस्य दर्शस्य पूर्णमासस्य चाप्यथ ।\nयूपेष्टिपशुबन्धानां सोमपानक्रियावताम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2212003, "chapter_id": 5517, "verse_number": "६५", "content_sanskrit": "तिथिनक्षत्रयोगानां मुहूर्तकरणात्मनाम् ।\nकालस्य वेदनार्थं तु ज्योतिर्ज्ञानं कृतं पुरा ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2212004, "chapter_id": 5517, "verse_number": "६६", "content_sanskrit": "ऋग्यजुःसाममन्त्राणां श्लोकतत्त्वार्थचिन्तनात् ।\nप्रत्यापत्तिविकल्पानां छन्दोज्ञानं प्रकल्पितम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2212005, "chapter_id": 5517, "verse_number": "६७", "content_sanskrit": "वर्णाक्षरपदार्थानां सन्धिलिङ्गविवक्षितम् ।\nनामधातुविवेकार्थं पुरा व्याकरणं कृतम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2212006, "chapter_id": 5517, "verse_number": "६८", "content_sanskrit": "(यूपवेद्यध्वरार्थं तु प्रोक्षणश्रवणाय तु ।\nयज्ञदैवतयोगार्थं शिक्षाज्ञानं प्रकल्पितम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2212007, "chapter_id": 5517, "verse_number": "", "content_sanskrit": "यज्ञपात्रपवित्रार्थं द्रव्यसम्भरणाय च ।\nसर्वयज्ञविकल्पाय पुरा कल्पं प्रकल्पितम् ॥६९॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2212008, "chapter_id": 5517, "verse_number": "७०", "content_sanskrit": "नामधातुविभक्तीनां तत्त्वार्थनियमाय च ।\nसर्ववेदनिरुक्तानां निरुक्तमृषिभिः कृतम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2212009, "chapter_id": 5517, "verse_number": "७१", "content_sanskrit": "वेद्यर्थं पृथिवी सृष्टा सम्भारार्थं तथैव च ।\nइध्मार्थमथ यूपार्थं ब्रह्मा चक्रे वनस्पतिम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2212010, "chapter_id": 5517, "verse_number": "७२", "content_sanskrit": "ग्राम्यारण्याश्च पशवो जायन्ते यज्ञकारणात् ।\nमन्त्राणां विनियोगं च प्रेषितश्रवणं तथा ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2212011, "chapter_id": 5517, "verse_number": "७३", "content_sanskrit": "अनुयाजप्रयाजाश्च मरुतां शंसिनस्तथा ।\nऔद्गात्रं चैव साम्नां वै प्रतिप्रस्थानमेव च ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2212012, "chapter_id": 5517, "verse_number": "७४", "content_sanskrit": "विष्णुक्रमोऽनुत्क्रमणं दक्षिणावभृथं तथा ।\nत्रिकालमर्चनं चैव स्थानेषूपहृतं तथा ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2212013, "chapter_id": 5517, "verse_number": "७५", "content_sanskrit": "देवताग्रहणं मोक्षं हविषां श्रपणं तथा ।\nनावबुद्ध्यन्ति ये विप्रा निन्दन्ति च पशोर्वधम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2212014, "chapter_id": 5517, "verse_number": "७६", "content_sanskrit": "ते यान्ति नरकं घोरं रौरवं तमसाऽऽवृतम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2212015, "chapter_id": 5517, "verse_number": "७७", "content_sanskrit": "शतवर्षसहस्राणि तत्र स्थित्वा नराधमाः ।\nक्रिमिभिर्भक्ष्यमाणाश्च तिष्ठेयुः पूयशोणिते ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2212016, "chapter_id": 5517, "verse_number": "७८", "content_sanskrit": "यूपास्तु मन्त्रसंस्कारैरेषां वै पशवस्तथा ।\nयजमानेन सहिताः स्वर्गं यान्ति नरेश्वर ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2212017, "chapter_id": 5517, "verse_number": "७९", "content_sanskrit": "यावत्कालं हि यज्वा वै स्वर्गलोके महीयते ।\nतावत्कालं प्रमोदन्ते पशवो ह्यध्वरे हताः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2212018, "chapter_id": 5517, "verse_number": "८०", "content_sanskrit": "वृक्षा यूपत्वमिच्छन्ति पशुत्वं पशवस्तथा ।\nतृणानीच्छन्ति बर्हिष्ट्वं ओषध्यश्च हविष्यताम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2212019, "chapter_id": 5517, "verse_number": "८१", "content_sanskrit": "सोमत्वं च लताः सर्वा वेदित्वं च वसुन्धरा ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2212020, "chapter_id": 5517, "verse_number": "८२", "content_sanskrit": "यस्मात् पशुत्वमिच्छन्ति पशवः स्वर्गलिप्सया ।\nतस्मात् पशुवधे हिंसा नास्ति यज्ञेषु पाण्डव ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2212021, "chapter_id": 5517, "verse_number": "८३", "content_sanskrit": "अहिंसा वैदिकं कर्म ब्रह्मकर्मेति तत्कृतम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2212022, "chapter_id": 5517, "verse_number": "८४", "content_sanskrit": "वेदोक्तं ये न कुर्वन्ति हिंसाबुद्ध्या क्रतून् द्विजाः ।\nसद्यः शूद्रत्वमायान्ति प्रेत्य चण्डालतामपि ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2212023, "chapter_id": 5517, "verse_number": "८५", "content_sanskrit": "गावो यज्ञार्थमुत्पन्ना दक्षिणार्थं तथैव च ।\nसुवर्णं रजतं चैव पात्रकुम्भार्थमेव च ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2212024, "chapter_id": 5517, "verse_number": "८६", "content_sanskrit": "दर्भाः संस्तरणार्थं तु रक्षसां रक्षणाय च ।\nयजनार्थं द्विजाः सृष्टास्तारका दिवि देवताः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2212025, "chapter_id": 5517, "verse_number": "८७", "content_sanskrit": "क्षत्रिया रक्षणार्थं तु वैश्या वार्तानिमित्ततः ।\nशुश्रूषार्थं त्रयाणां तु शूद्राः सृष्टाः स्वयम्भुवा ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2212026, "chapter_id": 5517, "verse_number": "८८", "content_sanskrit": "एवमेतज्जगत् सर्वमग्निहोत्रकृते कृतम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2212027, "chapter_id": 5517, "verse_number": "८९", "content_sanskrit": "नावबुद्ध्यन्ति ये चैवं नरास्तु तमसा वृताः ।\nते यान्ति नरकं घोरं रौरवं नाम विश्रुतम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2212028, "chapter_id": 5517, "verse_number": "९०", "content_sanskrit": "रौरवाद् विप्रयुक्तास्तु क्रिमियोनिं व्रजन्ति ते ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2212029, "chapter_id": 5517, "verse_number": "९१", "content_sanskrit": "यथोक्तमग्निहोत्राणां शुश्रूषन्ति च ये द्विजाः ।\nतैस्तु दत्तं हुतं चेष्टं दत्तमध्यापितं भवेत् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2212030, "chapter_id": 5517, "verse_number": "९२", "content_sanskrit": "एवमिष्टं च पूर्तं च यद् विप्रैः क्रियते नृप ।\nतत्सर्वं सम्यगाहृत्य चादित्ये स्थापयाम्यहम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2212031, "chapter_id": 5517, "verse_number": "९३", "content_sanskrit": "मया स्थापितमादित्ये लोकस्य सुकृतं हि यत् ।\nधारयेत् तत् सहस्रांशुः सुकृतं ह्यग्निहोत्रिणाम् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2212032, "chapter_id": 5517, "verse_number": "९४", "content_sanskrit": "यावत्कालं तु तिष्ठन्ति लोके चाप्यग्निहोत्रिणः ।\nतावदेव हि पुण्येन दीप्यते रविणाऽम्बरे ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2212033, "chapter_id": 5517, "verse_number": "९५", "content_sanskrit": "स्वर्गे स्वर्गं गतानां तु वीर्याद् भवति वीर्यवान् ।\nतत्र ते ह्युपभुञ्जन्ति ह्यग्निहोत्रस्य तत्फलम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2212034, "chapter_id": 5517, "verse_number": "९६", "content_sanskrit": "बालाहिताग्नयो ये च शूद्रान्नाद् विरताः सदा ।\nक्रोधलोभविनिर्मुक्ताः प्रातः स्नानपरायणाः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2212035, "chapter_id": 5517, "verse_number": "९७", "content_sanskrit": "यथोक्तमग्निहोत्रं वै जुह्वते विजितेन्द्रियाः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2212036, "chapter_id": 5517, "verse_number": "९८", "content_sanskrit": "आतिथेयाः सदा सौम्या द्विकालं मत्परायणाः ।\nते यान्त्यपुनरावृत्तिं भित्त्वा चादित्यमण्डलम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2212037, "chapter_id": 5517, "verse_number": "९९", "content_sanskrit": "मम लोकं सपत्नीका यानैः सूर्योदयप्रभैः ।\nतत्र बालार्कसङ्काशाः कामगाः कामरूपिणः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2212038, "chapter_id": 5517, "verse_number": "१००", "content_sanskrit": "ऐश्वर्यगुणसम्पन्नाः क्रीडन्ति च यथासुखम् ।\nइत्येषा ह्याहिताग्नीनां विभूतिः पाण्डुनन्दन ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2212039, "chapter_id": 5517, "verse_number": "१०१", "content_sanskrit": "ये च वेदश्रुतिं केचिन्निन्दमाना ह्यबुद्धयः ।\nप्रमाणं न च कुर्वन्ति ते यान्ति ह्यक्षयं तमः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2212040, "chapter_id": 5517, "verse_number": "१०२", "content_sanskrit": "प्रमाणमितिहासं च वेदान् कुर्वन्ति ये द्विजाः ।\nते यान्त्यमरसायुज्यं नित्यमास्तिक्यबुद्धयः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2212041, "chapter_id": 5517, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि वैष्णवधर्मशास्त्रे एकादशोत्तरशततमोऽध्यायः ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}]