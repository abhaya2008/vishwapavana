[{"id": 2083970, "chapter_id": 2786, "verse_number": "१२-२९१-०x", "content_sanskrit": "* युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2083971, "chapter_id": 2786, "verse_number": "१२-२९१-१", "content_sanskrit": "अध्यात्मं नाम यदिदं पुरुषस्येह विद्यते।\nयदध्यात्मं यतश्चैव तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2083972, "chapter_id": 2786, "verse_number": "१२-२९१-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2083973, "chapter_id": 2786, "verse_number": "१२-२९१-२", "content_sanskrit": "सर्वज्ञानं परं बुद्ध्या यन्मां त्वमनुपृच्छसि।\nतद्व्याख्यास्यामि ते तात तस्य व्याख्यामिमां शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2083974, "chapter_id": 2786, "verse_number": "१२-२९१-३", "content_sanskrit": "पृथिवी वायुराकाशमापो ज्योतिश्च पञ्चमम्।\nमहाभूतानि भूतानां सर्वेषां प्रभवाप्ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2083975, "chapter_id": 2786, "verse_number": "१२-२९१-४", "content_sanskrit": "स तेषां गुणसंघातः शरीरं भरतर्षभ।\nसततं हि प्रलीयन्ते गुणास्ते प्रभवन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2083976, "chapter_id": 2786, "verse_number": "१२-२९१-५", "content_sanskrit": "ततः सृष्टानि भूतानि तानि यान्ति पुनः पुनः।\nमहाभूतानि भूतेभ्य ऊर्मयः सागरे यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2083977, "chapter_id": 2786, "verse_number": "१२-२९१-६", "content_sanskrit": "प्रसारयित्वेहाङ्गानि कूर्मः संहरते यथा।\nतद्वद्भूतानि भूतानामल्पीयांसि स्थवीयसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2083978, "chapter_id": 2786, "verse_number": "१२-२९१-७", "content_sanskrit": "आकाशात्खलु यो घोषः संघातस्तु महीगुणः।\nवायोः प्राणो रसस्त्वद्भ्यो रूपं तेजस उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2083979, "chapter_id": 2786, "verse_number": "१२-२९१-८", "content_sanskrit": "इत्येतन्मयमेवैतत्सर्वं स्थावरजङ्गमम्।\nप्रलये च तमभ्येति तस्मादुद्दिश्यते पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2083980, "chapter_id": 2786, "verse_number": "१२-२९१-९", "content_sanskrit": "महाभूतानि पञ्चैव सर्वभूतेषु भूतकृत्।\nविषयान्कल्पयामास यस्मिन्यदनुपश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2083981, "chapter_id": 2786, "verse_number": "१२-२९१-१०", "content_sanskrit": "शब्दश्रोत्रे तथा खानि त्रयमाकाशयोनिजम्।\nरसः स्नेहश्च जिह्वा च अपामेते गुणाः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2083982, "chapter_id": 2786, "verse_number": "१२-२९१-११", "content_sanskrit": "रूपं चक्षुर्विपाकश्च त्रिविधं ज्योतिरूच्यते।\nघ्रेयं घ्राणं शरीरं च एते भूमिगुणाः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2083983, "chapter_id": 2786, "verse_number": "१२-२९१-१२", "content_sanskrit": "प्राणः स्पर्शश्च चेष्टा च वायोरेते गुणाः स्मृताः।\nइति सर्वगुणा राजन्व्याख्याताः पाञ्चभौतिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2083984, "chapter_id": 2786, "verse_number": "१२-२९१-१३", "content_sanskrit": "सत्त्वं रजस्तमः कालः कर्म बुद्धिश्च भारत।\nमनः षष्ठानि चैतेषु ईश्वरः समकल्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2083985, "chapter_id": 2786, "verse_number": "१२-२९१-१४", "content_sanskrit": "यदूर्ध्वपादतलयोरवाड्यूर्ध्नश्च पश्यसि।\nएतस्मिन्नेव कृत्स्नेयं वर्तते बुद्धिरन्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2083986, "chapter_id": 2786, "verse_number": "१२-२९१-१५", "content_sanskrit": "इन्द्रियाणि नरे पञ्च षष्ठं तु मन उच्यते।\nसप्तमीं बुद्धिमेवाहुः क्षेत्रज्ञः पुनरष्टमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2083987, "chapter_id": 2786, "verse_number": "१२-२९१-१६", "content_sanskrit": "इन्द्रियाणि च कर्ता च विचेतव्यानि भागशः।\nतमः सत्वं रजस्तैव तेऽपि भावास्तदाश्रयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2083988, "chapter_id": 2786, "verse_number": "१२-२९१-१७", "content_sanskrit": "चक्षुरालोचनायैव संशयं कुरुते मनः।\nबुद्धिरध्यवसानाय साक्षी क्षेत्रज्ञ उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2083989, "chapter_id": 2786, "verse_number": "१२-२९१-१८", "content_sanskrit": "तमः सत्वं रजश्चेति कालः कर्म च भारत।\nगुणैर्नेनीयते बुद्धिर्बुद्धिरेवेन्द्रियाणि च।\nमनः षष्ठानि सर्वाणि बुद्ध्यभावे कुतो गुणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2083990, "chapter_id": 2786, "verse_number": "१२-२९१-१९", "content_sanskrit": "येन पश्यति तच्चक्षुः शृण्वती श्रोत्रमुच्यते।\nजिघ्रती भवति घ्राणं रसती रसना रसान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2083991, "chapter_id": 2786, "verse_number": "१२-२९१-२०", "content_sanskrit": "स्पर्शनं स्पर्शती स्पर्शान्बुद्धिर्विक्रियतेऽसकृत्।\nयदा प्रार्थयते किंचित्तदा भवति सा मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2083992, "chapter_id": 2786, "verse_number": "१२-२९१-२१", "content_sanskrit": "अधिष्ठानानि बुद्ध्या हि पृथगेतानि पञ्चधा।\nइन्द्रियाणीति तान्याहुस्तेषु दुष्टेषु दुष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2083993, "chapter_id": 2786, "verse_number": "१२-२९१-२२", "content_sanskrit": "पुरुषे तिष्ठती बुद्धिस्त्रिषु भावेषु वर्तते।\nकदाचिल्लभते प्रीतिं कदाचिदपि शोचति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2083994, "chapter_id": 2786, "verse_number": "१२-२९१-२३", "content_sanskrit": "न सुखेन न दुःखेन कदाचिदपि वर्तते।\nसेयं भावात्मिका भावांस्त्रीनेतान्परिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2083995, "chapter_id": 2786, "verse_number": "१२-२९१-२४", "content_sanskrit": "सरितां सागरो भर्ता यथा वेलामिवोर्मिमान्।\nइति भावगता बुद्धिर्भावे मनसि वर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2083996, "chapter_id": 2786, "verse_number": "१२-२९१-२५", "content_sanskrit": "प्रवर्तमानं तु रजस्तद्भावेनानुर्तते।\nप्रहर्षः प्रीतिरानन्दः सुखं संशान्तचित्तता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2083997, "chapter_id": 2786, "verse_number": "१२-२९१-२६", "content_sanskrit": "कथंचिदुपपद्यन्ते पुरुषे सात्विका गुणाः।\nपिरदाहस्तथा शोकः संतापोऽपूर्तिरक्षमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2083998, "chapter_id": 2786, "verse_number": "१२-२९१-२७", "content_sanskrit": "लिङ्गानि रजसस्तानि दृश्यन्ते हेत्वहेतुभिः।\nअविद्या रागमोहौ च प्रमादः स्तब्धता भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2083999, "chapter_id": 2786, "verse_number": "१२-२९१-२८", "content_sanskrit": "असमृद्धिस्तथा दैन्यं प्रमोहः स्वप्नतन्द्रिता।\nकथंचिदुपवर्तन्ते विविधास्तामसा गुणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2084000, "chapter_id": 2786, "verse_number": "१२-२९१-२९", "content_sanskrit": "तत्र यत्प्रीतिसंयुक्तं काये मनसि वा भवेत्।\nवर्तते सात्विको भाव इत्युपेक्षेत तत्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2084001, "chapter_id": 2786, "verse_number": "१२-२९१-३०", "content_sanskrit": "अथ यद्दुःखसंयुक्तमप्रीतिकरमात्मनः।\nप्रवृत्तं रज इत्येव तदसंरभ्य चिन्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2084002, "chapter_id": 2786, "verse_number": "१२-२९१-३१", "content_sanskrit": "अथ यन्मोहसंयुक्तं काये मनसि वा भवेत्।\nअप्रतर्क्यमविज्ञेयं तमस्तदुपधारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2084003, "chapter_id": 2786, "verse_number": "१२-२९१-३२", "content_sanskrit": "इति बुद्धिगतीः सर्वा व्याख्याता यावतीरिह।\nएतद्बुद्ध्वा भवेद्बुद्धः किमन्यद्बुद्धलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2084004, "chapter_id": 2786, "verse_number": "१२-२९१-३३", "content_sanskrit": "सत्वक्षेत्रज्ञयोरेतदन्तरं विद्धि सूक्ष्मयोः।\nसृजतेऽत्र गुणानेक एको न सृजते गुणान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2084005, "chapter_id": 2786, "verse_number": "१२-२९१-३४", "content_sanskrit": "पृथग्भूतौ प्रकृत्या तु संप्रयुक्तौ च सर्वदा।\nयथा मत्स्योऽद्भिरन्यः स्यात्संप्रयुक्तो भवेत्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2084006, "chapter_id": 2786, "verse_number": "१२-२९१-३५", "content_sanskrit": "न गुणा विदुरात्मानं स गुणान्वेद सर्वतः।\nपरिद्रष्टा गुणानां तु संस्रष्टा मन्यते यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2084007, "chapter_id": 2786, "verse_number": "१२-२९१-३६", "content_sanskrit": "आश्रयो नास्ति सत्वस्य गुणसर्गेण चेतना।\nसत्वमस्य सृजन्त्यन्ये गुणान्वेद कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2084008, "chapter_id": 2786, "verse_number": "१२-२९१-३७", "content_sanskrit": "सृजते हि गुणान्सत्वं क्षेत्रज्ञः परिपश्यति।\nसंप्रयोगस्तयोरेष सत्वक्षेत्रज्ञयोर्ध्रुवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2084009, "chapter_id": 2786, "verse_number": "१२-२९१-३८", "content_sanskrit": "इन्द्रियैस्तु प्रदीपार्थं क्रियते बुद्धिरन्तरा।\nनिश्चक्षुर्भिरजानद्भिरिन्द्रियाणि प्रदीपवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2084010, "chapter_id": 2786, "verse_number": "१२-२९१-३९", "content_sanskrit": "एवं स्वभावमेवैतत्तद्बुद्ध्वा विहरन्नरः।\nअशोचन्नप्रहृष्यंश्च स वै विगतमत्सरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2084011, "chapter_id": 2786, "verse_number": "१२-२९१-४०", "content_sanskrit": "स्वभावसिद्धमेवैतद्यदिमान्सृजते गुणान्।\nऊर्णनाभिर्यथा सूत्रं विज्ञेयास्तन्तुवद्गुणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2084012, "chapter_id": 2786, "verse_number": "१२-२९१-४१", "content_sanskrit": "प्रध्वस्ता न निवर्तन्ते प्रवृत्तिर्नोपलभ्यते।\nएवमेके व्यवस्यन्ति निवृत्तिरिति चापरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2084013, "chapter_id": 2786, "verse_number": "१२-२९१-४२", "content_sanskrit": "इतीदं हृदयग्रन्थिं बुद्धिचिन्तामयं दृढम्।\nविमुच्य सुखमासीत विशोकश्छिन्नसंशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2084014, "chapter_id": 2786, "verse_number": "१२-२९१-४३", "content_sanskrit": "ताम्येयुः प्रच्युताः पृथ्वीं मोहपूर्णां नदीं नराः।\nयथा गाधमविद्वांसो बुद्धियोगमयं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2084015, "chapter_id": 2786, "verse_number": "१२-२९१-४४", "content_sanskrit": "नैव ताम्यन्ति विद्वांसः प्लवन्तः पारमम्भसः।\nअध्यात्मविदुषो धीरा ज्ञानं तु परमं प्लवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2084016, "chapter_id": 2786, "verse_number": "१२-२९१-४५", "content_sanskrit": "न भवति विदुषां महद्भयं\nयदविदुषां सुमहद्भयं भवेत्।\nन हि गतिरधिकाऽस्ति कस्यचि\nत्सकृदुपदर्शयतीह तुल्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2084017, "chapter_id": 2786, "verse_number": "१२-२९१-४६", "content_sanskrit": "यत्करोति बहुदोषमेकत\nस्तच्च दूषयति यत्पुरा कृतम्।\nनाप्रियं तदुभयं करोत्यसौ\nयच्च दूषयति यत्करोति च॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2084018, "chapter_id": 2786, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि एकनवत्यधिकद्विशततमोऽध्यायः॥ २९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]