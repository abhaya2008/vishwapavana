[{"id": 2071043, "chapter_id": 2496, "verse_number": "१२-१-१", "content_sanskrit": "॥ श्रीवेदव्यासाय नमः।\nनारायणं नमस्कृत्य नरं चैव नरोत्तमम्।\nदेवीं सरस्वतीं व्यासं ततो जयमुदीरयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2071044, "chapter_id": 2496, "verse_number": "१२-१-१x", "content_sanskrit": "वैशम्पायन उवाच।\nकृत्वोदकं ते सुहृदां सर्वेषां पाण्डुनन्दनाः।\nविदुरो धृतराष्ट्रश्च सर्वाश्च भरतस्त्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2071045, "chapter_id": 2496, "verse_number": "१२-१-२", "content_sanskrit": "तत्र ते सुमहात्मानो न्यवसन्कुरुनन्दनाः।\nशौचं निर्वर्तयिष्यन्तो मासच्चात्रं बहिः पुरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2071046, "chapter_id": 2496, "verse_number": "१२-१-३", "content_sanskrit": "कृतोदकं तु राजानं धर्मात्मानं युधिष्ठिरम्।\nअभिजग्मुर्महात्मानः सिद्धा ब्रह्मर्षिसत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2071047, "chapter_id": 2496, "verse_number": "१२-१-४", "content_sanskrit": "द्वैपायनो नारदश्च देवलश्च महानृषिः।\nदेवस्थानश्च कण्वश्च तेषां शिष्याश्च सत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2071048, "chapter_id": 2496, "verse_number": "१२-१-५", "content_sanskrit": "अन्ये च वेदविद्वांसः कृतप्रज्ञा द्विजातयः।\nगृहस्थाः स्नातकाः सन्तो ददृशुः कुरुसत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2071049, "chapter_id": 2496, "verse_number": "१२-१-६", "content_sanskrit": "तेऽभिगम्य महात्मानं पूजिताश्च यथाविधि।\nआसनेषु महार्हेषु विविशुः परमर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2071050, "chapter_id": 2496, "verse_number": "१२-१-७", "content_sanskrit": "प्रतिगृह्य ततः पूजां तत्कालसदृशीं तदा।\nपर्युपांसन्यथान्यायं परिवार्य युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2071051, "chapter_id": 2496, "verse_number": "१२-१-८", "content_sanskrit": "पुण्ये भागीरथीतीरे शोकव्याकुलचेतसम्।\nआश्वासयन्तो राजेन्द्रं विप्राः शतसहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2071052, "chapter_id": 2496, "verse_number": "१२-१-९", "content_sanskrit": "नारदस्त्वव्रवीत्काले धर्मपुत्रं युधिष्ठिरम्।\nसंभाष्य मुनिभिः सार्धं कृष्णद्वैपायनादिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2071053, "chapter_id": 2496, "verse_number": "१२-१-१०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2071054, "chapter_id": 2496, "verse_number": "१२-१-१०", "content_sanskrit": "पार्थस्य बाहुवीर्येण प्रसादान्माधवस्य च।\nजिता सेयं मही कृत्स्ना धर्मेण च युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2071055, "chapter_id": 2496, "verse_number": "१२-१-११", "content_sanskrit": "दिष्ट्या मुक्ताः स्थ संग्रामादस्माल्लोकभयंकरात्।\nक्षत्रधर्मरतश्चासि कच्चिन्मोदसि पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2071056, "chapter_id": 2496, "verse_number": "१२-१-१२", "content_sanskrit": "कच्चिच्च निहतामित्रः प्रीणासि सुहृदो नृप।\nकच्चिच्छ्रियमिमां प्राप्य न त्वां शोकः प्रबाधते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2071057, "chapter_id": 2496, "verse_number": "१२-१-१३x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2071058, "chapter_id": 2496, "verse_number": "१२-१-१३", "content_sanskrit": "विजितेयं मही कृत्स्ना कृष्णबाहुबलाश्रयात्।\nब्राह्मणानां प्रसादेन भीमार्जुनबलेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2071059, "chapter_id": 2496, "verse_number": "१२-१-१४", "content_sanskrit": "इदं तु मे महद्दुःखं वर्तते हृदि नित्यदा।\nकृत्वा ज्ञातिक्षयमिमं महान्तं घोरदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2071060, "chapter_id": 2496, "verse_number": "१२-१-१५", "content_sanskrit": "सौभद्रं द्रौपदेयांश्च घातयित्वा सुतान्प्रियान्।\nजयोऽयमजयाकारो भगवन्प्रतिभाति मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2071061, "chapter_id": 2496, "verse_number": "१२-१-१६", "content_sanskrit": "किंनु वक्ष्यति वार्ष्णेयी वधूर्मे मधुसूदनम्।\nद्वारकावासिनी कृष्णमितः प्रतिगतं हरिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2071062, "chapter_id": 2496, "verse_number": "१२-१-१७", "content_sanskrit": "द्रौपदी हतपुत्रेयं कृपणा हतबान्धवा।\nअस्मत्प्रियहिते युक्ता भूयः पीडयतीव माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2071063, "chapter_id": 2496, "verse_number": "१२-१-१८", "content_sanskrit": "इदमन्यच्च भगवन्यत्त्वां वक्ष्यामि नारद।\nमन्त्रसंवरणेनास्मि कुन्त्या दुःखेन योजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2071064, "chapter_id": 2496, "verse_number": "१२-१-१९", "content_sanskrit": "यः स नागायुतप्राणो लोकेऽप्रतिरथो रणे।\nसिंहविक्रान्तगामी च जितकाशी यतव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2071065, "chapter_id": 2496, "verse_number": "१२-१-२०", "content_sanskrit": "आश्रयो धार्तराष्ट्राणां मानी तीक्ष्णपराक्रमः।\nअमर्षी नित्यसंरम्भी क्षेप्ताऽस्माकं रणेरणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2071066, "chapter_id": 2496, "verse_number": "१२-१-२१", "content_sanskrit": "शीघ्रास्त्रश्चित्रयोधी च कृती चाद्भुतविक्रमः।\nगूढोत्पन्नः सुतः कुन्त्या भ्राताऽस्माकमसौ किल", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2071067, "chapter_id": 2496, "verse_number": "१२-१-२२", "content_sanskrit": "तोयकर्मणि तं कुन्ती कथयामास मे तदा।\nपुत्रं सर्वगुणोयेतं कर्णं त्यक्तं जले पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2071068, "chapter_id": 2496, "verse_number": "१२-१-२३", "content_sanskrit": "मञ्जूषायां समाधाय गङ्गास्रोतस्यमज्जयत्।\nयं सूतपुत्रं लोकोऽयं राधेयं चाभ्यमन्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2071069, "chapter_id": 2496, "verse_number": "१२-१-२४", "content_sanskrit": "स सूर्यपुत्रः कुन्त्या यै भ्राताऽस्माकं च मातृतः।\nअजानता मया सड्ख्ये राज्यलुब्धेन घातितः।\nतन्मे दहति गात्राणि तूलराशिमिवानलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2071070, "chapter_id": 2496, "verse_number": "१२-१-२५", "content_sanskrit": "न हि तं वेद पार्थोऽपि भ्रातरं श्वेतवाहनः।\nनाहं न भीमो न यमौ स त्वस्मान्वेद तत्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2071071, "chapter_id": 2496, "verse_number": "१२-१-२६", "content_sanskrit": "गता किल पृथा तस्य सकाशमिति नः श्चुतम्।\nअस्माकं शमकामा वै त्वं च पुत्रो ममेत्यथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2071072, "chapter_id": 2496, "verse_number": "१२-१-२७", "content_sanskrit": "पृथाया न कृतः कामस्तेन चापि महात्मना।\nअतीवानुचितं मातरवोच इति सोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2071073, "chapter_id": 2496, "verse_number": "१२-१-२८", "content_sanskrit": "न हि शक्ष्यामि संत्यक्तुमहं दुर्योधनं रणे।\nअनार्यत्वं नृशंसत्वं कृतघ्नत्वं च मे भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2071074, "chapter_id": 2496, "verse_number": "१२-१-२९", "content_sanskrit": "युधिष्ठिरेण सन्धिं हि यदि कुर्यां मते तव।\nभीतो रणे श्वेतवाहादिति मां मंस्यते जनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2071075, "chapter_id": 2496, "verse_number": "१२-१-३०", "content_sanskrit": "सोऽहं निर्जित्य समरे विजयं सहकेशवम्।\nसंधास्ये धर्मपुत्रेण पश्चादिति च सोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2071076, "chapter_id": 2496, "verse_number": "१२-१-३१", "content_sanskrit": "तमवोचत्किल पृथा पुनः पृथुलवक्षसम्।\nचतुर्णामभयं देहि कामं युध्यस्व फल्गुनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2071077, "chapter_id": 2496, "verse_number": "१२-१-३२", "content_sanskrit": "सोऽब्रवीन्मातरं धीमान्वेपमानां कृताञ्जलिः।\nप्राप्तान्विषह्यांश्चतुरो न हनिष्यामि ते सुतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2071078, "chapter_id": 2496, "verse_number": "१२-१-३३", "content_sanskrit": "पञ्चैव हि सुता देवि भविष्यन्ति तव ध्रुवाः।\nसार्जुना वा हते कर्णे सकर्णा वा हतेऽर्जुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2071079, "chapter_id": 2496, "verse_number": "१२-१-३४", "content_sanskrit": "तं पुत्रगृद्धिनी भूयो माता पुत्रमथाब्रवीत्।\nभ्रातॄणां स्वस्ति कुर्वीथा येषां स्वस्ति चिकीर्षसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2071080, "chapter_id": 2496, "verse_number": "१२-१-३५", "content_sanskrit": "एवमुक्त्वा किल पृथा विसृज्योपययौ गृहान्।\nसोऽर्जुनेन हतो वीरो भ्रात्रा भ्राता सहोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2071081, "chapter_id": 2496, "verse_number": "१२-१-३६", "content_sanskrit": "न चैव निःसृतो मन्त्रः पृथायास्तस्य वा मुने।\nअथ शूरो महेष्वासः पार्थेनाजौ निपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2071082, "chapter_id": 2496, "verse_number": "१२-१-३७", "content_sanskrit": "अहं त्वज्ञासिषं पश्चात्स्वसोदर्यं द्विजोत्तम।\nपूर्वजं भ्रातरं कर्णं पृथाया वचनात्प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2071083, "chapter_id": 2496, "verse_number": "१२-१-३८", "content_sanskrit": "तेन मे दूयते तीव्रं हृदयं भ्रातृघातिनः।\nकर्णार्जुनसहायोऽहं जयेयमपि वासवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2071084, "chapter_id": 2496, "verse_number": "१२-१-३९", "content_sanskrit": "सभायां क्लिश्यमानस्य धार्तराष्ट्रैर्दुरात्मभिः।\nसहसोत्पतितः क्रोधः कर्णं दृष्ट्वा प्रशाम्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2071085, "chapter_id": 2496, "verse_number": "१२-१-४०", "content_sanskrit": "यदा ह्यस्य गिरो रूक्षाः श्रृणोमि कटुकोदयाः।\nसभायां गदतो द्यूते दुर्योधनहितैषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2071086, "chapter_id": 2496, "verse_number": "१२-१-४१", "content_sanskrit": "तदा नश्यति मे रोषः पादौ तस्य निरीक्ष्य ह।\nकुन्त्या हि सदृशौ पादौ कर्णस्येति मतिर्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2071087, "chapter_id": 2496, "verse_number": "१२-१-४२", "content_sanskrit": "सादृश्यहेतुमन्विच्छन्पृथायास्तस्य चैव ह।\nकारणं नाधिगच्छामि कथंचिदपि चिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2071088, "chapter_id": 2496, "verse_number": "१२-१-४३", "content_sanskrit": "कथं नु तस्य संग्रामे पृथिवी चक्रमग्रसत्।\nकथं नु शप्तो भ्राता मे तत्त्वं वक्तुमिहार्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2071089, "chapter_id": 2496, "verse_number": "१२-१-४४", "content_sanskrit": "श्रोतुमिच्छामि भगवंस्त्वत्तः सर्वं यथातथम्।\nभवान्हि सर्वविद्विद्वाँल्लोके वेद कृताकृतम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2071090, "chapter_id": 2496, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि प्रथमोऽध्यायः॥ १॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]