[{"id": 2078358, "chapter_id": 2663, "verse_number": "१२-१६८-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2078359, "chapter_id": 2663, "verse_number": "१२-१६८-१", "content_sanskrit": "तस्यां निशायां व्युष्टायां गते तस्मिन्द्विजोत्तमे।\nनिष्क्रम्य गौतमोऽगच्छद्धनार्थी विचचार ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2078360, "chapter_id": 2663, "verse_number": "१२-१६८-२", "content_sanskrit": "सामुद्रिकान्सवणिजस्ततोऽपश्यत्स्थितान्पथि।\nस तेन सह सार्थेन प्रययौ सागरं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2078361, "chapter_id": 2663, "verse_number": "१२-१६८-३", "content_sanskrit": "स तु सार्थो महाराज कस्मिंश्चिद्गिरिगह्वरे।\nमत्तेन द्विरदेनाथ निहतः प्रायशोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2078362, "chapter_id": 2663, "verse_number": "१२-१६८-४", "content_sanskrit": "स कथंचिद्भयात्तस्माद्विमुक्तो प्रायशोऽभवत्।\nकांदिग्भूतो जीवितार्थी प्रदुद्रावोत्तरां दिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2078363, "chapter_id": 2663, "verse_number": "१२-१६८-५", "content_sanskrit": "ततस्तु स परिभ्रष्टः सार्थाद्देशात्तथाऽर्थतः।\nएकाकी व्यभ्रमत्तत्र वने कापुरुषो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2078364, "chapter_id": 2663, "verse_number": "१२-१६८-६", "content_sanskrit": "स पन्थानमथासाद्य समुद्राभिसरं तदा।\nआससाद वनं रम्यं महत्पुष्पितपादपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2078365, "chapter_id": 2663, "verse_number": "१२-१६८-७", "content_sanskrit": "सर्वर्तुकैराम्रवणैः पुष्पितैरुपशोभितम्।\nनन्दनोद्देशसदृशं यक्षकिन्नरसेवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2078366, "chapter_id": 2663, "verse_number": "१२-१६८-८", "content_sanskrit": "सालतालघवाश्वत्थप्लक्षागुरुवनैस्तथा।\nचन्दनस्य च मुख्यस्य पादपैरुपशोभितम्।\nगिरिप्रस्थेषु रम्येषु सुखेषु सुखगन्धिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2078367, "chapter_id": 2663, "verse_number": "१२-१६८-९", "content_sanskrit": "समन्ततो द्विजश्रेष्ठा वल्गु कूजन्ति तत्र वै।\nमनुष्यवदनाश्चान्ये भारुण्डा इति विश्रुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2078368, "chapter_id": 2663, "verse_number": "१२-१६८-१०", "content_sanskrit": "स तान्यतिमनोज्ञानि विहगानां रुतानि वै।\nशृण्वन्सुरमणीयानि विप्रोऽगच्छत गौतमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2078369, "chapter_id": 2663, "verse_number": "१२-१६८-११", "content_sanskrit": "ततोऽपश्यत्सुरम्येषु सुवर्णसिकताचिते।\nदेशभागे समे चित्रे स्वर्गोद्देशसमप्रभे।\nश्रिया जुष्टं ददर्शाथ न्यग्रोधं च सुमण्डलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2078370, "chapter_id": 2663, "verse_number": "१२-१६८-१२", "content_sanskrit": "शाखाभिरनुरूपाभिः संवृतं छत्रसन्निभम्।\nतस्य मूलं च संसिक्तं वरचन्दनवारिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2078371, "chapter_id": 2663, "verse_number": "१२-१६८-१३", "content_sanskrit": "दिव्यपुष्पान्वितं श्रीमत्पितामहसदोपमम्।\nतं दृष्ट्वा गौतमः प्रीतो मनःकान्तमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2078372, "chapter_id": 2663, "verse_number": "१२-१६८-१४", "content_sanskrit": "मेध्यं सुरगृहप्रख्यं पुष्पितैः पादपैर्वृतम्।\nतमासाद्य मुदा युक्तस्तस्याधस्तादुपाविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2078373, "chapter_id": 2663, "verse_number": "१२-१६८-१५", "content_sanskrit": "तत्रासीनस्य कौन्तेय गौतमस्य नराधिप।\nपुष्पाणि समुपस्पृश्य प्रववावनिलः शुभः।\nह्लादयंस्तस्य गात्राणि गौतमस्य तदा नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2078374, "chapter_id": 2663, "verse_number": "१२-१६८-१६", "content_sanskrit": "स तु विप्रः परिश्रान्तिः स्पृष्टः पुण्येन वायुना।\nसुखमासाद्य सुष्वाप भास्करश्चास्तमभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2078375, "chapter_id": 2663, "verse_number": "१२-१६८-१७", "content_sanskrit": "ततोऽस्तं भास्करे याते सन्ध्याकाल उपस्थिते।\nआजगाम स्वभवनं ब्रह्मलोकात्खगोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2078376, "chapter_id": 2663, "verse_number": "१२-१६८-१८", "content_sanskrit": "नाडीजङ्घ इति ख्यातो दयितो ब्रह्मणः सखा।\nबकराजो महाप्राज्ञः काश्यपस्यात्मसंभवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2078377, "chapter_id": 2663, "verse_number": "१२-१६८-१९", "content_sanskrit": "राजधर्मेति विख्यातो बभूवाप्रतिभो भुवि।\nदेवकन्यासुतः श्रीमान्विद्वान्देवसमप्रभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2078378, "chapter_id": 2663, "verse_number": "१२-१६८-२०", "content_sanskrit": "मृष्टहाटकसंछन्नो भूषणैरर्कसन्निभैः।\nभूषितः सर्वगात्रेषु देवगर्भः श्रिया ज्वलन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2078379, "chapter_id": 2663, "verse_number": "१२-१६८-२१", "content_sanskrit": "तमागतं खगं दृष्ट्वा गौतमो विस्मितोऽभवत्।\nक्षुत्पिपासापरीतात्मा हिंसार्थं चैनमैक्षत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2078380, "chapter_id": 2663, "verse_number": "१२-१६८-२२x", "content_sanskrit": "राजधर्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2078381, "chapter_id": 2663, "verse_number": "१२-१६८-२२", "content_sanskrit": "स्वागतं भवतो विप्र दिष्ट्या प्राप्तोऽसि मे गृहान्।\nअस्तं च सविता यातः संध्येयं समुपस्थिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2078382, "chapter_id": 2663, "verse_number": "१२-१६८-२३", "content_sanskrit": "मम त्वं निलयं प्राप्तः प्रियातिथिरनिन्दितः।\nपूजितो यास्यसि प्रातर्विधिदृष्टेन कर्मणा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2078383, "chapter_id": 2663, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि अष्टषष्ट्यधिकशततमोऽध्यायः॥ १६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]