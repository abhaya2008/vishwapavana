[{"id": 5000040000, "chapter_id": 9040, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे चत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000040001, "chapter_id": 9040, "verse_number": "१-४०-१", "content_sanskrit": "देवतानां वचः श्रुत्वा भगवान् वै पितामहः ।\nप्रत्युवाच सुसंत्रस्तान् कृतान्तबलमोहितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000040002, "chapter_id": 9040, "verse_number": "१-४०-२", "content_sanskrit": "यस्येयं वसुधा कृत्स्ना वासुदेवस्य धीमतः ।\nमहिषी माधवस्यैषा स एव भगवन् प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000040003, "chapter_id": 9040, "verse_number": "१-४०-३", "content_sanskrit": "कापिलं रूपमास्थाय धारयत्यनिशं धराम् ।\nतस्य कोपाग्निना दग्धा भविष्यन्ति नृपात्मजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000040004, "chapter_id": 9040, "verse_number": "१-४०-४", "content_sanskrit": "पृथिव्याश्चापि निर्भेदो दृष्ट एव सनातनः ।\nसगरस्य च पुत्राणां विनाशो दीर्घदर्शिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000040005, "chapter_id": 9040, "verse_number": "१-४०-५", "content_sanskrit": "पितामहवचः श्रुत्वा त्रयस्त्रिंशदरिंदमाः ।\nदेवाः परमसंहृष्टाः पुनर्जग्मुर्यथागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000040006, "chapter_id": 9040, "verse_number": "१-४०-६", "content_sanskrit": "सगरस्य च पुत्राणां प्रादुरासीन्महास्वनः ।\nपृथिव्यां भिद्यमानायां निर्घातसमनिस्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000040007, "chapter_id": 9040, "verse_number": "१-४०-७", "content_sanskrit": "ततो भित्त्वा महीं सर्वां कृत्वा चापि प्रदक्षिणम् ।\nसहिताः सागराः सर्वे पितरं वाक्यमब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000040008, "chapter_id": 9040, "verse_number": "१-४०-८", "content_sanskrit": "परिक्रान्ता मही सर्वा सत्त्ववन्तश्च सूदिताः ।\nदेवदानवरक्षांसि पिशाचोरगपन्नगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000040009, "chapter_id": 9040, "verse_number": "१-४०-९", "content_sanskrit": "न च पश्यामहेऽश्वं ते अश्वहर्तारमेव च ।\nकिं करिष्याम भद्रं ते बुद्धिरत्र विचार्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000040010, "chapter_id": 9040, "verse_number": "१-४०-१०", "content_sanskrit": "तेषां तद्वचनं श्रुत्वा पुत्राणां राजसत्तमः ।\nसमन्युरब्रवीद् वाक्यं सगरो रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000040011, "chapter_id": 9040, "verse_number": "१-४०-११", "content_sanskrit": "भूयः खनत भद्रं वो विभेद्य वसुधातलम् ।\nअश्वहर्तारमासाद्य कृतार्थाश्च निवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000040012, "chapter_id": 9040, "verse_number": "१-४०-१२", "content_sanskrit": "पितुर्वचनमासाद्य सगरस्य महात्मनः ।\nषष्टिः पुत्रसहस्राणि रसातलमभिद्रवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000040013, "chapter_id": 9040, "verse_number": "१-४०-१३", "content_sanskrit": "खन्यमाने ततस्तस्मिन् ददृशुः पर्वतोपमम् ।\nदिशागजं विरूपाक्षं धारयन्तं महीतलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000040014, "chapter_id": 9040, "verse_number": "१-४०-१४", "content_sanskrit": "सपर्वतवनां कृत्स्नां पृथिवीं रघुनन्दन ।\nधारयामास शिरसा विरूपाक्षो महागजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000040015, "chapter_id": 9040, "verse_number": "१-४०-१५", "content_sanskrit": "यदा पर्वणि काकुत्स्थ विश्रमार्थं महागजः ।\nखेदाच्चालयते शीर्षं भूमिकम्पस्तदा भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000040016, "chapter_id": 9040, "verse_number": "१-४०-१६", "content_sanskrit": "ते तं प्रदक्षिणं कृत्वा दिशापालं महागजम् ।\nमानयन्तो हि ते राम जग्मुर्भित्त्वा रसातलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000040017, "chapter_id": 9040, "verse_number": "१-४०-१७", "content_sanskrit": "ततः पूर्वां दिशं भित्त्वा दक्षिणां बिभिदुः पुनः ।\nदक्षिणस्यामपि दिशि ददृशुस्ते महागजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000040018, "chapter_id": 9040, "verse_number": "१-४०-१८", "content_sanskrit": "महापद्मं महात्मानं सुमहत्पर्वतोपमम् ।\nशिरसा धारयन्तं गां विस्मयं जग्मुरुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000040019, "chapter_id": 9040, "verse_number": "१-४०-१९", "content_sanskrit": "ते तं प्रदक्षिणं कृत्वा सगरस्य महात्मनः ।\nषष्टिः पुत्रसहस्राणि पश्चिमां बिभिदुर्दिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000040020, "chapter_id": 9040, "verse_number": "१-४०-२०", "content_sanskrit": "पश्चिमायामपि दिशि महान्तमचलोपमम् ।\nदिशागजं सौमनसं ददृशुस्ते महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000040021, "chapter_id": 9040, "verse_number": "१-४०-२१", "content_sanskrit": "तं ते प्रदक्षिणं कृत्वा पृष्ट्वा चापि निरामयम् ।\nखनन्तः समुपक्रान्ता दिशं सोमवतीं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000040022, "chapter_id": 9040, "verse_number": "१-४०-२२", "content_sanskrit": "उत्तरस्यां रघुश्रेष्ठ ददृशुर्हिमपाण्डुरम् ।\nभद्रं भद्रेण वपुषा धारयन्तं महीमिमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000040023, "chapter_id": 9040, "verse_number": "१-४०-२३", "content_sanskrit": "समालभ्य ततः सर्वे कृत्वा चैनं प्रदक्षिणम् ।\nषष्टिः पुत्रसहस्राणि बिभिदुर्वसुधातलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000040024, "chapter_id": 9040, "verse_number": "१-४०-२४", "content_sanskrit": "ततः प्रागुत्तरां गत्वा सागराः प्रथितां दिशम् ।\nरोषादभ्यखनन् सर्वे पृथिवीं सगरात्मजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000040025, "chapter_id": 9040, "verse_number": "१-४०-२५", "content_sanskrit": "ते तु सर्वे महत्मानो भिमवेगा महबलाः ।\nददृशुः कपिलं तत्र वासुदेवं सनातनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000040026, "chapter_id": 9040, "verse_number": "१-४०-२६", "content_sanskrit": "हयं च तस्य देवस्य चरन्तमविदूरतः ।\nप्रहर्षमतुलं प्राप्ताः सर्वे ते रघुनंदन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000040027, "chapter_id": 9040, "verse_number": "१-४०-२७", "content_sanskrit": "ते तं यज्ञहनं ज्ञात्वा क्रोधपर्याकुलेक्षणाः ।\nखनित्रलाङ्गलधरा नानावृक्षशिलाधराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000040028, "chapter_id": 9040, "verse_number": "१-४०-२८", "content_sanskrit": "अभ्यधावन्त संक्रुद्धास्तिष्ठ तिष्ठेति चाब्रुवन् ।\nअस्माकं त्वं हि तुरगं यज्ञियं हृतवानसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000040029, "chapter_id": 9040, "verse_number": "१-४०-२९", "content_sanskrit": "दुर्मेधस्त्वं हि संप्राप्तान् विद्धि नः सगरात्मजान् ।\nश्रुत्वा तद्वचनं तेषां कपिलो रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000040030, "chapter_id": 9040, "verse_number": "१-४०-३०", "content_sanskrit": "रोषेण महताविष्टो हुंकारमकरोत् तदा ।\nततस्तेनाप्रमेयेण कपिलेन महात्मना ।\nभस्मराशीकृताः सर्वे काकुत्स्थ सगरात्मजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000040031, "chapter_id": 9040, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे चत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]