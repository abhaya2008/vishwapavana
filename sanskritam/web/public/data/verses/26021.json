[{"id": 7006021000, "chapter_id": 26021, "verse_number": "१-२०४-१", "content_sanskrit": "सूत उवाच ।\nएवं धन्वन्तरिः प्राह सुश्रुतायच वैद्कम् ।\nअत नामानि वक्ष्यामि ओषधीनां समासतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006021001, "chapter_id": 26021, "verse_number": "१-२०४-२", "content_sanskrit": "स्थिरा विदारिगन्धा च शालपण्यशुमत्यपि ।\nलाङ्गली कलसी चैव क्रोष्टुपुच्छा गुहा मता ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006021002, "chapter_id": 26021, "verse_number": "१-२०४-३", "content_sanskrit": "पुनर्नवाथ पर्षाभूः कठिल्या कारुणा तथा ।\nएरण्डश्चोरुवूकः स्यादामर्दो वर्धमानकः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006021003, "chapter_id": 26021, "verse_number": "१-२०४-४", "content_sanskrit": "झषा नागबला ज्ञेया श्वदंष्ट्रा गोक्षुर मतः ।\nशतावरी वरा भीरु पीवरीन्दीवरी वरी ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006021004, "chapter_id": 26021, "verse_number": "१-२०४-५", "content_sanskrit": "व्याघ्री तु बृहती कृष्णा हंसपादी मधुस्त्रवा ।\nधामनी कण्टकारी स्यात्क्षुद्रा सिंही निदिग्धिका ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006021005, "chapter_id": 26021, "verse_number": "१-२०४-६", "content_sanskrit": "वृश्चिका त्र्यमृता काली विषघ्नी सर्पदंष्ट्रिक ।\nमर्कटी चात्मगुप्ता स्यादार्षेयी कपिकच्छुका ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006021006, "chapter_id": 26021, "verse_number": "१-२०४-७", "content_sanskrit": "मुद्गपर्णो क्षुद्रसहा माषपर्णो महासहा ।\nत्यजा परा च महा ज्ञेया दण्डयोन्यङ्कसंज्ञया। ।\nन्यग्रोधस्तु वटो ज्ञेयः अश्वत्थः कपिलो मतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006021007, "chapter_id": 26021, "verse_number": "१-२०४-८", "content_sanskrit": "प्लक्षोऽथ गर्दभाण्डः स्यात्पर्कटी च कपीनः ।\nपार्थस्तु ककुभो धन्वि विज्ञेयोर्ऽजुननामभिः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006021008, "chapter_id": 26021, "verse_number": "१-२०४-९", "content_sanskrit": "नन्दीवृक्षः प्ररोही स्यात्पुष्टिकारीति चोच्यते। ।\nवञ्जुलो वेतसो ज्ञेयो भल्लातश्चाप्यरुष्करः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006021009, "chapter_id": 26021, "verse_number": "१-२०४-१०", "content_sanskrit": "लोध्रः सारवको धृष्टस्तिरीटश्चापि कीर्तितः ।\nबृहत्फला महाजम्बूर्ज्ञेया बालफला परा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006021010, "chapter_id": 26021, "verse_number": "१-२०४-११", "content_sanskrit": "तृतीया जलजम्बूः स्यान्नादेयी सा च कीर्तिता ।\nकणा कृष्णोपकुञ्ची च शौण्डी मागधिकेति च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006021011, "chapter_id": 26021, "verse_number": "१-२०४-१२", "content_sanskrit": "कथिता पिप्पली तज्ज्ञैस्तन्मूलं ग्रन्थिकं स्मम् ।\nऊषणं मरिचं ज्ञेयं शुण्ठी विश्वं महौषधम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006021012, "chapter_id": 26021, "verse_number": "१-२०४-१३", "content_sanskrit": "व्योषं कटुत्रयं विद्यात्त्र्यूषणं तच्च कीर्तते ।\nलाङ्गली हलिनी च स्याच्छेयसी गज पिप्पली ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006021013, "chapter_id": 26021, "verse_number": "१-२०४-१४", "content_sanskrit": "त्रायन्ती त्रायमाणा स्यादुत्साया सुवहा स्मृता ।\nचित्रकः स्याच्छिखी वह्निरग्निसंज्ञाभिरुच्यते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006021014, "chapter_id": 26021, "verse_number": "१-२०४-१५", "content_sanskrit": "षड्ग्रन्थोग्रा वचा ज्ञेया श्वेता हैमवतीति ।\nकुटजो वृक्षकः शक्रो वत्सको गिरिमाल्लिका ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006021015, "chapter_id": 26021, "verse_number": "१-२०४-१६", "content_sanskrit": "कलिङ्गेन्द्रयवारिष्टं तस्य बीजानि लक्षयेत् ।\nमुस्तक्तो मेघनामा स्यात्कौन्ती ज्ञेया हरेणुका ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006021016, "chapter_id": 26021, "verse_number": "१-२०४-१७", "content_sanskrit": "एला च बहुला प्रोक्ता सूक्ष्मैला च तथा त्रुटिः ।\nपद्मा भार्ङ्गो तथा काञ्जी ज्ञेया ब्राह्मणयष्टिका ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006021017, "chapter_id": 26021, "verse_number": "१-२०४-१८", "content_sanskrit": "मूर्वा मधुरसा ज्ञेया तेजनी तिक्तवल्लिका ।\nमहानिम्बो बृहन्निम्बो दीप्यकः स्याद्यवानिका ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006021018, "chapter_id": 26021, "verse_number": "१-२०४-१९", "content_sanskrit": "विडङ्गं क्रिमशत्रुः स्याद्रामठं हिङ्गुरुचते ।\nअजाजी जीरकं ज्ञेया कारवी चोपकुञ्चिका ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006021019, "chapter_id": 26021, "verse_number": "१-२०४-२०", "content_sanskrit": "विज्ञेया कटुका तिक्ता तथा कटुकरोहिणी ।\nतगरं स्यान्नतं वक्रं चोचं त्वचवराङ्गकम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006021020, "chapter_id": 26021, "verse_number": "१-२०४-२१", "content_sanskrit": "उदीच्यं बालकं प्रोक्तं ह्रीबेरं चाम्बुनामभिः ।\nपत्रकं दलसंज्ञाभिश्चारकं तस्कराह्वयम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006021021, "chapter_id": 26021, "verse_number": "१-२०४-२२", "content_sanskrit": "हेमाभं नागसंज्ञाभिर्नागकेशर उच्यते ।\nअसृक्कुङ्कुममाख्यातं तथा काश्मीरबाह्लिकम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006021022, "chapter_id": 26021, "verse_number": "१-२०४-२३", "content_sanskrit": "अयो लोहं समुद्दिष्टं यौगिकैर्लोहनामभिः ।\nपुरं कुटनटं विद्यान्महिषाक्षः पलङ्कषा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006021023, "chapter_id": 26021, "verse_number": "१-२०४-२४", "content_sanskrit": "काश्मरी कट्फला ज्ञेया श्रीपर्णो चेति कीर्तिता ।\nशल्लकी गजभक्ष्या च पत्री च सुरभी स्त्रवः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006021024, "chapter_id": 26021, "verse_number": "१-२०४-२५", "content_sanskrit": "धात्रीमामलकीं विद्यादक्षश्चैव विभीतकः ।\nपथ्याभया च विज्ञेया पूतना च हरीतकी ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006021025, "chapter_id": 26021, "verse_number": "१-२०४-२६", "content_sanskrit": "त्रिफला फलमेवोक्ता तच्च ज्ञेयं फलत्रिकम् ।\nउदकीर्यो दीर्घवृन्तः करञ्जश्चेति कीर्तितः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006021026, "chapter_id": 26021, "verse_number": "१-२०४-२७", "content_sanskrit": "यष्टी यष्ट्याह्वयं प्रोक्तं मदुकं मधुयष्टिका ।\nधातकी ताम्रपर्णो स्यात्समङ्गा कुञ्जरा मता ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006021027, "chapter_id": 26021, "verse_number": "१-२०४-२८", "content_sanskrit": "सितं मलयजं शीतं गोशीर्षं सितचन्दनम् ।\nविद्याद्रक्तं चन्दनं च द्वितीयं रक्तचन्दनम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006021028, "chapter_id": 26021, "verse_number": "१-२०४-२९", "content_sanskrit": "काकोली च स्मृता वीरा वयस्या चार्कपुष्पिका ।\nशृङ्गी कर्कटशृङ्गी च महाघोषा च कीर्तिता ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006021029, "chapter_id": 26021, "verse_number": "१-२०४-३०", "content_sanskrit": "तुगाक्षीरी शुभा वांशी विज्ञेया वंशलोचना ।\nमृद्विका च स्मृता द्राक्षा तथा गोस्तनिका मता ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006021030, "chapter_id": 26021, "verse_number": "१-२०४-३१", "content_sanskrit": "स्यादुशीरं मृणालञ्च सेव्यं लामज्जकं तथा ।\nसारञ्च गोपवल्ली च गोपी भद्रा च कथ्यते ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006021031, "chapter_id": 26021, "verse_number": "१-२०४-३२", "content_sanskrit": "दन्ती कटङ्कटेरी च ज्ञेया दारुनिशेति च ।\nहरिद्रा रजनी प्रोक्ता पीतिका रात्रिनामिका ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006021032, "chapter_id": 26021, "verse_number": "१-२०४-३३", "content_sanskrit": "वृक्षादनी छिन्नरुहा नीलवल्ली रसामृता ।\nवसुकोटश्च विज्ञेयो वाशिरः काम्पिल्लो मतः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006021033, "chapter_id": 26021, "verse_number": "१-२०४-३४", "content_sanskrit": "पाषाणभेदकोऽरिष्टो ह्यस्मभित्कुट्टभेदकः ।\nघण्टाकः शुष्कको ज्ञेयो वचोऽथ सूचको मतः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006021034, "chapter_id": 26021, "verse_number": "१-२०४-३५", "content_sanskrit": "सुरसो बीजकश्चैव पीतशालोऽभिधीयेत ।\nवज्रवृक्षो महावृक्षः स्नुही स्नुक्च सुधा गुडा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006021035, "chapter_id": 26021, "verse_number": "१-२०४-३६", "content_sanskrit": "तुलसीं सुरसां विद्यादुपस्थेति च कथ्यते ।\nकुठेरकोऽप्यर्जुनकः पर्णो सौगन्धिपर्णिक्रः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006021036, "chapter_id": 26021, "verse_number": "१-२०४-३७", "content_sanskrit": "नीलश्च सिन्धुवारश्च निर्गुण्डीति सुगन्धिका ।\nज्ञेया सुगन्धिपर्णोति वासन्ती कुलजेति च ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006021037, "chapter_id": 26021, "verse_number": "१-२०४-३८", "content_sanskrit": "कालीयकं पीतकाष्ठं कतकाख्यः पुनः स्मृतः ।\nगायत्रीखदिरो ज्ञेयस्तद्भेदः कन्दरो मतः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006021038, "chapter_id": 26021, "verse_number": "१-२०४-३९", "content_sanskrit": "इन्दी वरं कुवलयं पद्मं नीलोत्पलं समतम् ।\nसौगन्धिकं शतदलमब्जं कमलमुच्यते ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006021039, "chapter_id": 26021, "verse_number": "१-२०४-४०", "content_sanskrit": "अजवर्णो भवेदूर्जो वाजिकर्णोऽश्वकर्णकः ।\nश्लेष्मान्तकस्तथा शेलुर्बहुवारश्च कथ्यते ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006021040, "chapter_id": 26021, "verse_number": "१-२०४-४१", "content_sanskrit": "सुनन्दकः ककुद्भद्रं छत्राकी छत्रसंज्ञका ।\nकबरी कुम्भको धृष्टः क्षुद्विधो धनकृत्तथा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006021041, "chapter_id": 26021, "verse_number": "१-२०४-४२", "content_sanskrit": "कृष्णार्जकः करालश्च कालमानः प्रकीर्तितः ।\nप्राची बला नदीक्रान्ता काकजङ्घाथ वायसी ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006021042, "chapter_id": 26021, "verse_number": "१-२०४-४३", "content_sanskrit": "ज्ञेया मूषिकपर्णो तु भ्रमन्ती चाखुपर्णक ।\nविषमुष्टिर्द्रावणञ्च केशमुष्टिरुदाहृता ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006021043, "chapter_id": 26021, "verse_number": "१-२०४-४४", "content_sanskrit": "किंलिहीं कटुकीं विद्यादन्तकश्चाम्लवेतसः ।\nअश्वत्था बहुपत्रा च विज्ञेया चामलक्यपि ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006021044, "chapter_id": 26021, "verse_number": "१-२०४-४५", "content_sanskrit": "अरूषक्रं पत्र शूकं क्षीरी राजादनं मतम। ।\nमहापत्रं दाडिमं च तमेव करकं वदेत् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006021045, "chapter_id": 26021, "verse_number": "१-२०४-४६", "content_sanskrit": "मसूरी विदली शष्पा कालिन्दीति निरुच्यते ।\nकण्टकाख्या महाश्यामा वृक्षपादीति वक्ष्यते ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006021046, "chapter_id": 26021, "verse_number": "१-२०४-४७", "content_sanskrit": "विद्या कुन्ती निकुम्भा च त्रिभङ्गी त्रिपुटी तरवृत् ।\nसप्तला यवतिक्ता च चर्मा चर्मकसेति च ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006021047, "chapter_id": 26021, "verse_number": "१-२०४-४८", "content_sanskrit": "शङ्खिनी सुकुमारी च तिक्ताक्षी चाक्षिपीलुकम। ।\nगवाक्षी चामृता श्वेता गिरिकर्णो गवादिनी ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006021048, "chapter_id": 26021, "verse_number": "१-२०४-४९", "content_sanskrit": "काम्पिल्लकोऽथ रक्ताङ्गो गुण्डा रोचनिकेति ।\nहेमक्षीरी स्मृता पीता गौरी वै कालदुग्धिका ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006021049, "chapter_id": 26021, "verse_number": "१-२०४-५०", "content_sanskrit": "गाङ्गेरुकी नागबला विशाला चेन्द्रवारुणी ।\nतार्क्ष्यं शैलं नीलवर्णमञ्जनञ्च रसाञ्जनम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006021050, "chapter_id": 26021, "verse_number": "१-२०४-५१", "content_sanskrit": "निर्यासो यश्च शाल्मल्याः स मोचरससंज्ञकः ।\nप्रत्यक्पुष्पी खरी ज्ञेया अपामार्गो मयूरकः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006021051, "chapter_id": 26021, "verse_number": "१-२०४-५२", "content_sanskrit": "सिंहास्यवृषवासाकमाटरूषकमादिशेत् ।\nजीवको जीवशाकश्च कर्बुरञ्च शटीं विदुः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006021052, "chapter_id": 26021, "verse_number": "१-२०४-५३", "content_sanskrit": "कट्फलं सोमवृक्षः स्यादग्निगन्धा सुगन्धक ।\nशताङ्गं शतपुष्पा च मिंसिर्मधुरिकामता ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006021053, "chapter_id": 26021, "verse_number": "१-२०४-५४", "content_sanskrit": "ज्ञेयं पुष्करमूलञ्च पुष्करं पुष्कराह्वयम् ।\nयासोऽथ धन्वयासश्च दुष्पर्शोऽथ दुरालभा ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006021054, "chapter_id": 26021, "verse_number": "१-२०४-५५", "content_sanskrit": "वाकुची सोमराजी च सोमवल्लीति कीर्तिता ।\nमार्कवः केशराजश्च भृङ्गराजो निगद्यते ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006021055, "chapter_id": 26021, "verse_number": "१-२०४-५६", "content_sanskrit": "प्रोक्तस्त्वेडगजस्तज्ज्ञैश्चक्रमर्दकसजञखः ।\nसुरङ्गीतगरः स्नायुः कलनाशा तु वायसी ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006021056, "chapter_id": 26021, "verse_number": "१-२०४-५७", "content_sanskrit": "महाकालः स्मृतो बेलस्तण्डुलीयो घनस्तनः ।\nइक्ष्वाकुस्तिक्ततुम्बी स्यात्तिक्तालबुर्निगद्यते ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006021057, "chapter_id": 26021, "verse_number": "१-२०४-५८", "content_sanskrit": "धामार्गवोऽथ कोषातक्यथ यामिनी ।\nविद्यात्कोशतकीभेदं कृतभेदनसंज्ञका ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006021058, "chapter_id": 26021, "verse_number": "१-२०४-५९", "content_sanskrit": "तथा जीमूतकाख्या च खुड्डाको देवताडकः ।\nगृध्रनखी गृध्रनखी हिङ्गुकाकादनी मता ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006021059, "chapter_id": 26021, "verse_number": "१-२०४-६०", "content_sanskrit": "अश्वारिश्चैव बोद्धव्यः करवीरोऽश्वमारकः ।\nसिन्धुः सैन्धवसिन्धूत्थमणिमन्थमुदाहृतम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006021060, "chapter_id": 26021, "verse_number": "१-२०४-६१", "content_sanskrit": "क्षारो यवाग्रजश्चैव यवक्षारोऽभिधीयते ।\nसर्जिका सर्जिकाक्षारो द्वितीयः परिकीर्तितः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006021061, "chapter_id": 26021, "verse_number": "१-२०४-६२", "content_sanskrit": "काशीशं पुष्पकाशीशं विज्ञेयं नेत्त्रभेषजम् ।\nधातुकाशीशकाशी च संज्ञेयं तच्च कीर्तितम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006021062, "chapter_id": 26021, "verse_number": "१-२०४-६३", "content_sanskrit": "सौराष्ट्री मृत्तिकाक्षारं काक्षी वै पङ्कपर्पटी ।\nविद्यात्समाक्षिकं धातु ताप्यं ताप्युत्थसम्भवम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006021063, "chapter_id": 26021, "verse_number": "१-२०४-६४", "content_sanskrit": "शिला मनः शिला ज्ञेया नेपाली कुलटीति च ।\nआलं मनस्तालकं वा हरितालं विनिर्दिशेत् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006021064, "chapter_id": 26021, "verse_number": "१-२०४-६५", "content_sanskrit": "गन्धको गन्धपाषाणो रसः पारद उच्यते ।\nताम्रमौदुम्बरं शुल्बं विद्यान्म्लेच्छमुखं तथा ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006021065, "chapter_id": 26021, "verse_number": "१-२०४-६६", "content_sanskrit": "अद्रिसारस्त्वयस्तीक्ष्णं लोहकञ्चापि कथ्यते ।\nमाक्षिकं मधु च क्षौद्रं तच्च पुष्परसं स्मृतम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006021066, "chapter_id": 26021, "verse_number": "१-२०४-६७", "content_sanskrit": "ज्येष्ठन्तु सोदकं तत्स्यात्काञ्जिकन्तु सुवीरम ।\nसीता सितोपला चैव मत्स्यण्डीशर्करा स्मृता ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006021067, "chapter_id": 26021, "verse_number": "१-२०४-६८", "content_sanskrit": "त्वगेलापत्रकैस्तुल्यैस्त्रिसुगन्धि त्रिजकम् ।\nनागकेशरसंयुक्तं तच्चतुर्जातमिष्यते ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006021068, "chapter_id": 26021, "verse_number": "१-२०४-६९", "content_sanskrit": "पिप्पली पिप्पलीमूलं चव्यचित्रकनागरैः ।\nकथितं पञ्चकोलञ्च कोलकं कोलसंज्ञया ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006021069, "chapter_id": 26021, "verse_number": "१-२०४-७०", "content_sanskrit": "प्रियङ्गुः कङ्गुका ज्ञेया कोरदूषश्च कोद्रव। ।\nत्रिपुटः पुटसंज्ञश्च कलापो लङ्गको मतः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006021070, "chapter_id": 26021, "verse_number": "१-२०४-७१", "content_sanskrit": "सतीनो वर्तुलश्चैव वेणुश्चापि प्रकीर्तत ।\nपिचुकं पितलं चाक्षं बिडालपदकं तथा ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006021071, "chapter_id": 26021, "verse_number": "१-२०४-७२", "content_sanskrit": "विद्यात्कर्षं तथा चापि सुवर्णं कवलग्रहम् ।\nपलार्धं शुक्तिमिच्छन्ति तथाष्टौमाषकास्त्विति ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006021072, "chapter_id": 26021, "verse_number": "१-२०४-७३", "content_sanskrit": "पलं बिल्वञ्च मुष्टिः स्याद्द्वे पले प्रसृतिवदेत् ।\nअञ्जलिं कुडवञ्चैव विद्यात्पलचतुष्टयम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006021073, "chapter_id": 26021, "verse_number": "१-२०४-७४", "content_sanskrit": "अष्टमानं पलान्यष्टौ तच्च मानमिति स्मृतम् ।\nचतुर्भिः कुडवैः प्रस्थ प्रस्थाश्चत्वार आढकः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006021074, "chapter_id": 26021, "verse_number": "१-२०४-७५", "content_sanskrit": "काशपात्रञ्च संप्रोक्तो द्रोणश्चचतुराढके ।\nतुला पलशतं प्रोक्तं भागो विंशत्पलः स्मृतः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006021075, "chapter_id": 26021, "verse_number": "१-२०४-७६", "content_sanskrit": "मानमेवं विधं प्रोक्तं प्रस्थद्रव्येषु पण्डितैः ।\nद्रवद्रव्येषु चोद्दिष्टं द्विगुणं परिकीर्तितम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006021076, "chapter_id": 26021, "verse_number": "१-२०४-७७", "content_sanskrit": "भद्रदारु देवकाष्ठं दारु स्याद्देवदारुकम। ।\nकुष्ठमामयमाख्यातं मांसीञ्च नलदंशनम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006021077, "chapter_id": 26021, "verse_number": "१-२०४-७८", "content_sanskrit": "शङ्खः शुक्तिनखः शङ्खो व्याघ्रो व्याघ्रनखः समतः ।\nपुरं पलङ्कषं विद्यान्महिषाक्षञ्च गुग्गुलुः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006021078, "chapter_id": 26021, "verse_number": "१-२०४-७९", "content_sanskrit": "रसो गन्धरसो बोले सर्जः सर्जरसो मतः ।\nप्रियङ्गुः फलिनी श्यामा गौरी कान्तेति चोच्यते ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006021079, "chapter_id": 26021, "verse_number": "१-२०४-८०", "content_sanskrit": "करञ्जौ नक्तमालः स्यात्पूतिकश्चिरबिल्वकः ।\nशिग्रुः शोभाञ्जनो नाम ज्ञानमानश्च कीर्तितः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006021080, "chapter_id": 26021, "verse_number": "१-२०४-८१", "content_sanskrit": "जया जयन्ती शरणी निर्गुण्डी सिन्धुवारकः ।\nमोरटा पीलुपर्णो च तुण्डी स्यात्तुण्डिकेरिका ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006021081, "chapter_id": 26021, "verse_number": "१-२०४-८२", "content_sanskrit": "मदनो गालवो बोधो घोटा घोटी च कथ्यते ।\nचतुरङ्गुल सम्पाको व्याधिघाताभिसंज्ञकः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006021082, "chapter_id": 26021, "verse_number": "१-२०४-८३", "content_sanskrit": "विद्यादारग्वधं राजवृक्षं रैवतसंज्ञकम् ।\nदन्ती काकेन्दुतिक्ता स्यात्कण्टकी च विकङ्कतः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006021083, "chapter_id": 26021, "verse_number": "१-२०४-८४", "content_sanskrit": "निम्बोऽरिष्टः समाख्यातः पटोलं कोलकं विदुः ।\nवयस्था च विशल्या च च्छिन्ना छिन्नरुहा मता ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006021084, "chapter_id": 26021, "verse_number": "१-२०४-८५", "content_sanskrit": "वशा दन्त्यमृता चेति गुडूचीनामसंग्रहः ।\nकिराततिक्तकश्चैव भूनिम्बः काण्डतिक्तकः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006021085, "chapter_id": 26021, "verse_number": "१-२०४-८६", "content_sanskrit": "सूत उवाच ।\nनामान्येतानि च हरे वन्यानां भेषजां तथा ।\nअतो व्याकरणं वक्ष्ये कुमारोक्तञ्च शौनक ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}]