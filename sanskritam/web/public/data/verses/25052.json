[{"id": 7005052000, "chapter_id": 25052, "verse_number": "७-१-२३५-१", "content_sanskrit": "ईश्वर उवाच ।\nतत्रैव संस्थितं पश्येल्लिंगत्रयमनुत्तमम् ।\nशतमेधं सहस्रमेधं कोटिमेधमिति क्रमात् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005052001, "chapter_id": 25052, "verse_number": "७-१-२३५-२", "content_sanskrit": "दक्षिणे शतमेधं तु शतयज्ञफलप्रदम् ।\nकार्तवीर्य्येण तत्रैव कृतं यज्ञशतं पुरा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005052002, "chapter_id": 25052, "verse_number": "७-१-२३५-३", "content_sanskrit": "प्रतिष्ठाप्य महालिंगं सर्वपातकनाशनम् ।\nमध्यभागेऽत्र यल्लिंगं कोटिमेधेति विश्रुतम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005052003, "chapter_id": 25052, "verse_number": "७-१-२३५-४", "content_sanskrit": "तत्रेष्टा ब्रह्मणा पूर्वं कोटि संख्या मखोत्तमाः ।\nसंस्थाप्य तु महादेवं शंकरं लोकशंकरम ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005052004, "chapter_id": 25052, "verse_number": "७-१-२३५-५", "content_sanskrit": "तस्य उत्तरभागस्थं सहस्रक्रतुसंज्ञकम् ।\nशक्रश्च देवराजोऽपि सहस्रं यष्टवान्क्रतून् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005052005, "chapter_id": 25052, "verse_number": "७-१-२३५-६", "content_sanskrit": "प्रतिष्ठाप्य महालिंगं देवानामादिदैवतम् ।\nगंधपुष्पादिविधिना पंचामृतरसोदकैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005052006, "chapter_id": 25052, "verse_number": "७-१-२३५-७", "content_sanskrit": "स प्राप्नुयात्फलं देवि लिंगनामोद्भवं क्रमात् ।\nगोदानं तत्र देयं तु सम्यग्यात्राफलेप्सुभिः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005052007, "chapter_id": 25052, "verse_number": "७-१-२३५-८", "content_sanskrit": "दशलक्षाणि तीर्थानां तत्र तिष्ठंति भामिनि ।\nलिंगत्रयं तथा मध्ये सर्वपातकनाशनम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005052008, "chapter_id": 25052, "verse_number": "७-१-२३५-९", "content_sanskrit": "इति श्रीस्कान्दे महापुराण एकाशीतिसाहस्र्यां सहितायां सप्तमे प्रभास खण्डे प्रथमे प्रभासक्षेत्रमाहात्म्ये दशाश्वमेधमाहात्म्ये शतमेधादि लिंगत्रयमाहात्म्यवर्णनंनाम पञ्चत्रिंशदुत्तरद्विशततमोऽध्यायः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]