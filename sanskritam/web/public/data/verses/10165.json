[{"id": 6000165000, "chapter_id": 10165, "verse_number": null, "content_sanskrit": "अथ द्वादशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000165001, "chapter_id": 10165, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.001.m4a", "display_order": 2}, {"id": 6000165002, "chapter_id": 10165, "verse_number": "८-१२-१", "content_sanskrit": "मनुर्विवस्वतः पुत्रः श्राद्धदेव इति श्रुतः।\nसप्तमो वर्तमानो यस्तदपत्यानि मे शृृणु॥ ८/१२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.002.m4a", "display_order": 3, "topics": [{"text": "सप्तमादिचतुर्दशमन्वन्तरवर्णनम्", "range": "१–३७"}]}, {"id": 6000165003, "chapter_id": 10165, "verse_number": "८-१२-२", "content_sanskrit": "इक्ष्वाकुश्च नभश्चैव धृष्टः शर्यातिरेव च।\nनरिष्यन्तोऽथ नाभागः सप्तमो दिष्ट उच्यते॥ ८/१२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.003.m4a", "display_order": 4}, {"id": 6000165004, "chapter_id": 10165, "verse_number": "८-१२-३", "content_sanskrit": "करूषश्च वृषध्रश्च दशमो वसुमान् स्मृतः।\nमनोर्वैवस्वतस्यैते दश पुत्राः परन्तप॥ ८/१२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.004.m4a", "display_order": 5}, {"id": 6000165005, "chapter_id": 10165, "verse_number": "८-१२-४", "content_sanskrit": "आदित्या वसवो रुद्रा विश्वेदेवा मरुद्गणाः।\nअश्विनावृभवो राजन्निन्द्रस्तेषां पुरन्दरः॥ ८/१२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.005.m4a", "display_order": 6}, {"id": 6000165006, "chapter_id": 10165, "verse_number": "८-१२-५", "content_sanskrit": "कश्यपोऽत्रिर्वसिष्ठश्च विश्वामित्रोऽथ गौतमः।\nजमदग्निर्भरद्वाज इति सप्तर्षयः स्मृताः॥ ८/१२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.006.m4a", "display_order": 7}, {"id": 6000165007, "chapter_id": 10165, "verse_number": "८-१२-६", "content_sanskrit": "अत्रापि भगवज्जन्म कश्यपाददितेरभूत्।\nआदित्यानामवरजो विष्णुर्वामनरूपधृक्॥ ८/१२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.007.m4a", "display_order": 8}, {"id": 6000165008, "chapter_id": 10165, "verse_number": "८-१२-७", "content_sanskrit": "सङ्क्षेपतो मयोक्तानि सप्तमन्वन्तराणि ते।\nभविष्याण्यथ वक्ष्यामि विष्णोः शक्त्याऽन्वितानि च॥ ८/१२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.008.m4a", "display_order": 9}, {"id": 6000165009, "chapter_id": 10165, "verse_number": "८-१२-८", "content_sanskrit": "विवस्वतश्च द्वे भार्ये विश्वकर्मसुते उभे।\nसंज्ञा छाया च राजेन्द्र ये प्रागभिहिते तव॥ ८/१२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.009.m4a", "display_order": 10}, {"id": 6000165010, "chapter_id": 10165, "verse_number": "८-१२-९", "content_sanskrit": "तृतीयां वडवामेके तासां संज्ञासुतास्‍त्रयः।\nयमो यमी श्राद्धदेवश्छायायाश्च सुतान् शृृणु॥ ८/१२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.010.m4a", "display_order": 11}, {"id": 6000165011, "chapter_id": 10165, "verse_number": "८-१२-१०", "content_sanskrit": "सावर्णिस्तपती कन्या भार्या संवरणस्य या।\nशनैश्चरस्तृतीयोऽभूदश्विनौ वडवात्मजौ॥ ८/१२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.011.m4a", "display_order": 12}, {"id": 6000165012, "chapter_id": 10165, "verse_number": "८-१२-११", "content_sanskrit": "अष्टमे अन्तरे याते सावर्णिर्भविता मनुः।\nनिर्मोहविरजस्काद्याः सावर्णेस्तनया नृप॥ ८/१२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.012.m4a", "display_order": 13}, {"id": 6000165013, "chapter_id": 10165, "verse_number": "८-१२-१२", "content_sanskrit": "तत्र देवाः सुतपसो विरजा अमितप्रजाः।\nतेषां विरोचनसुतो बलिरिन्द्रो भविष्यति॥ ८/१२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.013.m4a", "display_order": 14}, {"id": 6000165014, "chapter_id": 10165, "verse_number": "८-१२-१३", "content_sanskrit": "दत्वेमां याचमानाय विष्णवे यः पदत्रयम्।\nराद्धमिन्द्रपदं हित्वा ततः सिद्धिमवाप्स्यति॥ ८/१२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.014.m4a", "display_order": 15}, {"id": 6000165015, "chapter_id": 10165, "verse_number": "८-१२-१४", "content_sanskrit": "योऽसौ भगवता बद्धः प्रीतेन सुतले पुनः।\nनिवेशितोऽधिके स्वर्गादधुनाऽऽस्ते स्वराडिव॥ ८/१२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.015.m4a", "display_order": 16}, {"id": 6000165016, "chapter_id": 10165, "verse_number": "८-१२-१५", "content_sanskrit": "गालवो दीप्तिमान् रामो द्रोणपुत्रः कृपस्तथा।\nऋष्यशृृङ्गः पिताऽस्माकं भगवान् बादरायणः॥ ८/१२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.016.m4a", "display_order": 17}, {"id": 6000165017, "chapter_id": 10165, "verse_number": "८-१२-१६", "content_sanskrit": "इमे सप्तर्षयस्तत्र भविष्यन्ति स्वयोगतः।\nइदानीमासते राजन् स्वे स्व आश्रममण्डले॥ ८/१२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.017.m4a", "display_order": 18}, {"id": 6000165018, "chapter_id": 10165, "verse_number": "८-१२-१७", "content_sanskrit": "देवगुह्यात् सरस्वत्यां सार्वभौम इति प्रभुः।\nस्थानं पुरन्दराद् हृत्वा बलये दास्यतीश्वरः॥ ८/१२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.018.m4a", "display_order": 19}, {"id": 6000165019, "chapter_id": 10165, "verse_number": "८-१२-१८", "content_sanskrit": "नवमो दक्षसावर्णिर्मनुर्वरुणसम्भवः।\nभूतकेतुर्दीप्तकेतुरित्याद्यास्तत्सुता नृप॥ ८/१२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.019.m4a", "display_order": 20}, {"id": 6000165020, "chapter_id": 10165, "verse_number": "८-१२-१९", "content_sanskrit": "पारामरीचिगर्भाद्या देवा इन्द्रोऽद्भुतः स्मृतः।\nद्युतिमत्प्रमुखास्तत्र भविष्यन्त्यृषयस्ततः॥ ८/१२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.020.m4a", "display_order": 21}, {"id": 6000165021, "chapter_id": 10165, "verse_number": "८-१२-२०", "content_sanskrit": "आयुष्मतोऽम्बुधारायाम् ऋषभो भगवत्कलः।\nभविता येन सन्त्रातस्‍त्रिलोकीं भोक्ष्यतेऽद्भुतः॥ ८/१२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.021.m4a", "display_order": 22}, {"id": 6000165022, "chapter_id": 10165, "verse_number": "८-१२-२१", "content_sanskrit": "दशमो ब्रह्मसावर्णिरुपश्लोकसुतो महान्।\nतत्सुता भूरिषेणाद्या हविष्मत्प्रमुखा द्विजाः॥ ८/१२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.022.m4a", "display_order": 23}, {"id": 6000165023, "chapter_id": 10165, "verse_number": "८-१२-२२", "content_sanskrit": "तत्रापि जन्म भविता हरेर्विश्वसृजां गृहे।\nश्रीमूर्तिरिति विख्यातो येनाप्यायेत वै जगत्॥ ८/१२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.023.m4a", "display_order": 24}, {"id": 6000165024, "chapter_id": 10165, "verse_number": "८-१२-२३", "content_sanskrit": "हविष्मान् सुकृतः सत्यो जयो मूर्तिस्तदा द्विजाः।\nसुवासनविरुद्धाद्या देवाः शम्भुः सुरेश्वरः॥ ८/१२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.024.m4a", "display_order": 25}, {"id": 6000165025, "chapter_id": 10165, "verse_number": "८-१२-२४", "content_sanskrit": "विष्वक्सेनाद् विषूच्यां तु शम्भोः सख्यं करिष्यति।\nजातः शान्तस्तु भगवान् गृहे विश्वसृजां विभुः॥ ८/१२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.025.m4a", "display_order": 26}, {"id": 6000165026, "chapter_id": 10165, "verse_number": "८-१२-२५", "content_sanskrit": "मनुर्वै धर्मसावर्णिरेकादशम आत्मवान्।\nअनागतस्तत्सुताश्च सत्यधर्मादयो दश॥ ८/१२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.026.m4a", "display_order": 27}, {"id": 6000165027, "chapter_id": 10165, "verse_number": "८-१२-२६", "content_sanskrit": "विहङ्गमाः कामगमा निर्वाणरुचयः सुराः।\nइन्द्रश्च वैधृतस्तेषामृषयश्चारुणादयः॥ ८/१२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.027.m4a", "display_order": 28}, {"id": 6000165028, "chapter_id": 10165, "verse_number": "८-१२-२७", "content_sanskrit": "आर्यकस्य सुतस्तत्र धर्मसेतुरिति स्मृतः।\nवैधृतायां हरेरंशस्‍त्रिलोकीं धारयिष्यति॥ ८/१२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.028.m4a", "display_order": 29}, {"id": 6000165029, "chapter_id": 10165, "verse_number": "८-१२-२८", "content_sanskrit": "भविता मेरुसावर्णी राजन् द्वादशमो मनुः।\nदेववानुपदेवश्च देवश्रेष्ठादयः सुताः॥ ८/१२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.029.m4a", "display_order": 30}, {"id": 6000165030, "chapter_id": 10165, "verse_number": "८-१२-२९", "content_sanskrit": "ऋतधामा च तत्रेन्द्रो देवाश्च हरितादयः।\nऋषयश्च तपोमूर्तितपश्चाग्नीध्रकादयः॥ ८/१२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.030.m4a", "display_order": 31}, {"id": 6000165031, "chapter_id": 10165, "verse_number": "८-१२-३०", "content_sanskrit": "स्वधामाख्यो हरेरंशः साधयिष्यति तन्मनोः।\nअन्तरं सत्यमहसः सूनृतायाः सुतो विभुः॥ ८/१२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.031.m4a", "display_order": 32}, {"id": 6000165032, "chapter_id": 10165, "verse_number": "८-१२-३१", "content_sanskrit": "मनुस्‍त्रयोदशो भाव्यो देवसावर्णिरात्मवान्।\nचित्रसेनविचित्राद्या देवसावर्णिदेहजाः॥ ८/१२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.032.m4a", "display_order": 33}, {"id": 6000165033, "chapter_id": 10165, "verse_number": "८-१२-३२", "content_sanskrit": "देवाः सुकर्मसुत्रामसंज्ञा इन्द्रो दिवस्पतिः।\nनिर्मोकतत्त्वदर्शाद्या भविष्यन्त्यृषयस्तदा॥ ८/१२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.033.m4a", "display_order": 34}, {"id": 6000165034, "chapter_id": 10165, "verse_number": "८-१२-३३", "content_sanskrit": "देवहोत्रस्य तनय उपहर्ता दिवस्पतेः।\nयोगेश्वरो हरेरंशो बृहत्यां सम्भविष्यति॥ ८/१२/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.034.m4a", "display_order": 35}, {"id": 6000165035, "chapter_id": 10165, "verse_number": "८-१२-३४", "content_sanskrit": "मनुर्वा इन्द्रसावर्णिश्चतुर्दशम एष्यते।\nजन्तुभीरववर्याद्या इन्द्रसावर्णिवीर्यजाः॥ ८/१२/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.035.m4a", "display_order": 36}, {"id": 6000165036, "chapter_id": 10165, "verse_number": "८-१२-३५", "content_sanskrit": "विचित्राश्चाक्षुषा देवाः शुचिरिन्द्रो भविष्यति।\nअग्निर्बाहुः शुचिः शुद्धो मागधाद्यास्तपस्विनः॥ ८/१२/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.036.m4a", "display_order": 37}, {"id": 6000165037, "chapter_id": 10165, "verse_number": "८-१२-३६", "content_sanskrit": "सत्रायणस्य तनयो बृहद्भानुस्तदा हरिः।\nवितानायां महाराज क्रियातन्तून् वितायिता॥ ८/१२/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.037.m4a", "display_order": 38}, {"id": 6000165038, "chapter_id": 10165, "verse_number": "८-१२-३७", "content_sanskrit": "राजन् चतुर्दशैतानि त्रिकालानुगतानि ते।\nप्रोक्तान्येभिर्मितः कल्पो युगसाहस्रपर्ययः॥ ८/१२/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_012/BhP_08.012.038.m4a", "display_order": 39}, {"id": 6000165039, "chapter_id": 10165, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् अष्टमस्कन्धे द्वादशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]