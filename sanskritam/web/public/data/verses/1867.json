[{"id": 2039411, "chapter_id": 1867, "verse_number": "५-११२-०x", "content_sanskrit": "गालव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2039412, "chapter_id": 1867, "verse_number": "५-११२-१", "content_sanskrit": "गरुत्मन्भुजगेन्द्रारे सुपर्ण विनतात्मज ।\nनय मां तार्क्ष्य पूर्वेण यत्र धर्मस्य चक्षुषी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2039413, "chapter_id": 1867, "verse_number": "५-११२-२", "content_sanskrit": "पूर्वमेतां दिशं गच्छ या पूर्वं परिकीर्तिता ।\nदेवतानां हि सान्निध्यमत्र कीर्तितवानसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2039414, "chapter_id": 1867, "verse_number": "५-११२-३", "content_sanskrit": "अत्र सत्यं च धर्मश्च त्वया सम्यक्प्रकीर्तितः।\nइच्छेयं तु समागन्तुं समस्तैर्दैवतैरहम्।\nभूयश्च तान्सुरान्द्रष्टुमिच्छेयमरुणानुज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2039415, "chapter_id": 1867, "verse_number": "५-११२-४x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2039416, "chapter_id": 1867, "verse_number": "५-११२-४", "content_sanskrit": "तमाह विनतासूनुरारोहस्वेति वै द्विजम्।\nआरुरोहाथ स मुनिर्गरुडं गालवस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2039417, "chapter_id": 1867, "verse_number": "५-११२-५x", "content_sanskrit": "गालव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2039418, "chapter_id": 1867, "verse_number": "५-११२-५", "content_sanskrit": "क्रममाणस्य ते रूपं दृश्यते पन्नगाशन।\nभास्करस्येव पूर्वाह्णे सहस्रांशोर्विवस्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2039419, "chapter_id": 1867, "verse_number": "५-११२-६", "content_sanskrit": "पक्षवातप्रणुन्नानां वृक्षाणामनुगामिनाम् ।\nप्रस्थितानामिव समं पश्यामीह गतिं खग ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2039420, "chapter_id": 1867, "verse_number": "५-११२-७", "content_sanskrit": "ससागरवनामुर्वी सशैलवनकाननाम् ।\nआकर्षन्निव चाभासि पक्षवातेन खेचर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2039421, "chapter_id": 1867, "verse_number": "५-११२-८", "content_sanskrit": "समीननागनक्रं च खमिवारोप्यते जलम्।\nवायुना चैव महता पक्षवातेन चानिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2039422, "chapter_id": 1867, "verse_number": "५-११२-९", "content_sanskrit": "तुल्यरूपाननान्मत्स्यांस्तथा तिमितिमिङ्गिलान् ।\nनागाश्वनरवक्रांश्च पश्याम्युन्मथितानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2039423, "chapter_id": 1867, "verse_number": "५-११२-१०", "content_sanskrit": "महार्णवस्य च रवैः श्रोत्रे मे बधिरे कृते।\nन श्रृणोमि न पश्यामि नात्मनो वेद्मि कारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2039424, "chapter_id": 1867, "verse_number": "५-११२-११", "content_sanskrit": "शनैः स तु भवात्यातु ब्रह्मवध्यामनुस्मरन् ।\nन दृश्यते रविस्तात न दिशो न च खं खग ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2039425, "chapter_id": 1867, "verse_number": "५-११२-१२", "content_sanskrit": "तम एव तु पश्यामि शरीरं ते न लक्षये ।\nमणी व जात्यौ पश्यामि चक्षुषी तेऽहमण्डज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2039426, "chapter_id": 1867, "verse_number": "५-११२-१३", "content_sanskrit": "शरीरं तु न पश्यामि तव चैवात्मनश्च ह।\nपदेपदे तु पश्यामि शरीरादग्निमुत्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2039427, "chapter_id": 1867, "verse_number": "५-११२-१४", "content_sanskrit": "स मे निर्वाप्य सहसा चक्षुषी शाम्यते पुनः।\nतन्नियच्छ महावेगं गमने विनतात्मज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2039428, "chapter_id": 1867, "verse_number": "५-११२-१५", "content_sanskrit": "न मे प्रयोजनं किंचिद्गमने पन्नगाशन ।\nसंनिवर्त महाभाग न वेगं विषहामि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2039429, "chapter_id": 1867, "verse_number": "५-११२-१६", "content_sanskrit": "गुरवे संश्रुतानीह शतान्यष्टौ हि वाजिनाम् ।\nएकतःश्यामकर्णानां शुभ्राणां चन्द्रवर्चसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2039430, "chapter_id": 1867, "verse_number": "५-११२-१७", "content_sanskrit": "तेषां चैवापवर्गाय मार्गं पश्यामि नाण्डज।\nततोऽयं जीवितत्यागे दृष्टो मार्गोमयाऽऽत्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2039431, "chapter_id": 1867, "verse_number": "५-११२-१८", "content_sanskrit": "नैव मेऽस्ति धनं किंचिन्न धनेनान्वितः सुहृत् ।\nन चार्थेनापि महता शक्यमेतद्व्यपोहितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2039432, "chapter_id": 1867, "verse_number": "५-११२-१९x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2039433, "chapter_id": 1867, "verse_number": "५-११२-१९", "content_sanskrit": "एवं बहु च दीनं च ब्रुवाणं गालवं तदा।\nप्रत्युवाच व्रजन्नेव प्रहसन्विनतात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2039434, "chapter_id": 1867, "verse_number": "५-११२-२०", "content_sanskrit": "नातिप्रज्ञोऽसि विप्रर्षे योत्मानं त्युक्तुमिच्छसि ।\nन चापि कृत्रिमः कालः कालो हि परमेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2039435, "chapter_id": 1867, "verse_number": "५-११२-२१", "content_sanskrit": "किमहं पूर्वमेवेह भवता नाभिचोदितः।\nउपायोऽत्र महानस्ति येनैतदुपपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2039436, "chapter_id": 1867, "verse_number": "५-११२-२२", "content_sanskrit": "तदेष ऋषभो नाम पर्वतः सागरान्तिके।\nअत्र विश्रम्य भुक्त्वा च निवर्तिष्याव गालव ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2039437, "chapter_id": 1867, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि द्वादशाधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]