[{"id": 7004128000, "chapter_id": 24128, "verse_number": "४-७७-१", "content_sanskrit": "पार्वत्युवाच ।\nनमस्ते देवदेवेश प्रणमत्करुणानिधे ।\nवद केदारमाहात्म्यं भक्तानामनुकंपया ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004128001, "chapter_id": 24128, "verse_number": "४-७७-२", "content_sanskrit": "तस्मिंल्लिंगे महाप्रीतिस्तव काश्यामनुत्तमा ।\nतद्भक्ताश्च जना नित्यं देवदेवमहाधियः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004128002, "chapter_id": 24128, "verse_number": "४-७७-३", "content_sanskrit": "देवदेव उवाच ।\nशृण्वपर्णेभिधास्यामि केदारेश्वर संकथाम् ।\nसमाकर्ण्यापि यां पापोप्यपापो जायते क्षणात् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004128003, "chapter_id": 24128, "verse_number": "४-७७-४", "content_sanskrit": "केदारं यातुकामस्य पुंसो निश्चितचेतसः ।\nआजन्मसंचितं पापं तत्क्षणादेव नश्यति ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004128004, "chapter_id": 24128, "verse_number": "४-७७-५", "content_sanskrit": "गृहाद्विनिर्गते पुंसि केदारमभिनिश्चितम्॥ जन्मद्वयार्जितं पापं शरीरादपि निर्व्रजेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004128005, "chapter_id": 24128, "verse_number": "४-७७-६", "content_sanskrit": "मध्ये मार्गं प्रपन्नस्य त्रिजन्मजनितं त्वघम् ।\nदेहगेहाद्विनिःसृत्य निराशं याति निःश्वसत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004128006, "chapter_id": 24128, "verse_number": "४-७७-७", "content_sanskrit": "सायंकेदारकेदारकेदारेति त्रिरुच्चरन् ।\nगृहेपि निवसन्नूनं यात्राफलमवाप्नुयात् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004128007, "chapter_id": 24128, "verse_number": "४-७७-८", "content_sanskrit": "दृष्ट्वा केदारशिखरं पीत्वा तत्रत्यमंबु च ।\nसप्तजन्मकृतात्पापान्मुच्यते नात्र संशयः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004128008, "chapter_id": 24128, "verse_number": "४-७७-९", "content_sanskrit": "हरपापह्रदे स्नात्वा केदारेशं प्रपूज्य च ।\nकोटिजन्मार्जितैनोभिर्मुच्यते नात्र संशयः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004128009, "chapter_id": 24128, "verse_number": "४-७७-१०", "content_sanskrit": "सकृत्प्रणम्य केदारं हरपापकृतोदकः ।\nस्थाप्य लिंगं हृदंभोजे प्रांते मोक्षं गमिष्यति ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004128010, "chapter_id": 24128, "verse_number": "४-७७-११", "content_sanskrit": "हरपापह्रदे श्राद्धं श्रद्धया यः करिष्यति ।\nउद्धृत्य सप्तपुरुषान्स मे लोकं गमिष्यति ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004128011, "chapter_id": 24128, "verse_number": "४-७७-१२", "content_sanskrit": "पुरा राथंतरे कल्पे यदभूदत्र तच्छृणु ।\nअपर्णे दत्तकर्णा त्वं वर्णयामि तवाग्रतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004128012, "chapter_id": 24128, "verse_number": "४-७७-१३", "content_sanskrit": "एको ब्राह्मणदायाद उज्जयिन्या इहागतः ।\nकृतोपनयनः पित्रा ब्रह्मचर्यव्रतेस्थितः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004128013, "chapter_id": 24128, "verse_number": "४-७७-१४", "content_sanskrit": "स्थलीं पाशुपतीं काशीं स विलोक्य समंततः ।\nद्विजैः पाशुपतैः कीर्णां जटामुकुटभूषितैः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004128014, "chapter_id": 24128, "verse_number": "४-७७-१५", "content_sanskrit": "कृतलिंगसमर्चैश्च भूतिभूषितवर्ष्मभिः ।\nभिक्षाहृतान्नसंतुष्टैः पुष्टैर्गंगामृतोदकैः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004128015, "chapter_id": 24128, "verse_number": "४-७७-१६", "content_sanskrit": "बभूवानंदितमना व्रतं जग्राह चोत्तमम् ।\nहिरण्यगर्भादाचार्यान्महत्पाशुपताभिधम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004128016, "chapter_id": 24128, "verse_number": "४-७७-१७", "content_sanskrit": "स च शिष्यो वशिष्ठोभूत्सर्वपाशुपतोत्तमः ।\nस्नात्वा ह्रदे हरपापे नित्यप्रातः समुत्थितः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004128017, "chapter_id": 24128, "verse_number": "४-७७-१८", "content_sanskrit": "विभूत्याहरहः स्नाति त्रिकालं लिंगमर्चयन् ।\nनांतरं स विजानाति शिवलिंगे गुरौ तथा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004128018, "chapter_id": 24128, "verse_number": "४-७७-१९", "content_sanskrit": "स द्वादशाब्ददेशीयो वशिष्ठो गुरुणा सह ।\nययौ केदारयात्रार्थं गिरिं गौरीगुरोर्गुरुम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004128019, "chapter_id": 24128, "verse_number": "४-७७-२०", "content_sanskrit": "यत्र गत्वा न शोचंति किंचित्संसारिणः क्वचित ।\nप्राश्योदकं लिंगरूपं लिंगरूपत्वमागताः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004128020, "chapter_id": 24128, "verse_number": "४-७७-२१", "content_sanskrit": "असिधारं गिरिं प्राप्य वशिष्ठस्य तपस्विनः ।\nगुरुर्हिरण्यगर्भाख्यः पंचत्वमगमत्तदा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004128021, "chapter_id": 24128, "verse_number": "४-७७-२२", "content_sanskrit": "पश्यतां तापसानां च विमाने सार्वकामिके ।\nआरोप्य तं पारिषदाः कैलासमनयन्मुदा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004128022, "chapter_id": 24128, "verse_number": "४-७७-२३", "content_sanskrit": "यस्तु केदारमुद्दिश्य गेहादर्धपथेप्यहो ।\nअकातरस्त्यजेत्प्राणान्कैलासे स चिरं वसेत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004128023, "chapter_id": 24128, "verse_number": "४-७७-२४", "content_sanskrit": "तदाश्चर्यं समालोक्य स वशिष्ठस्तपोधनः ।\nकेदारमेव लिंगेषु बह्वमंस्त सुनिश्चितम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004128024, "chapter_id": 24128, "verse_number": "४-७७-२५", "content_sanskrit": "अथ कृत्वा स कैदारीं यात्रां वाराणसीमगात् ।\nअग्रहीन्नियमं चापि यथार्थं चाकरोत्पुनः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004128025, "chapter_id": 24128, "verse_number": "४-७७-२६", "content_sanskrit": "प्रति चैत्रं सदा चैत्र्यां यावज्जीवमहं ध्रुवम् ।\nविलोकयिष्ये केदारं वसन्वाराणसीं पुरीम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004128026, "chapter_id": 24128, "verse_number": "४-७७-२७", "content_sanskrit": "तेन यात्राः कृताः सम्यक् षष्टिरेकाधिका मुदा ।\nआनंदकानने नित्यं वसता ब्रह्मचारिणा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004128027, "chapter_id": 24128, "verse_number": "४-७७-२८", "content_sanskrit": "पुनर्यात्रां स वै चक्रे मधौ निकटवर्तिनि ।\nपरमोत्साहसंतुष्टः पलिता कलितोप्यलम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004128028, "chapter_id": 24128, "verse_number": "४-७७-२९", "content_sanskrit": "तपोधनैस्तन्निधनं शंकमानैर्निवारितः ।\nकारुण्यपूर्णहृदयैरन्यैरपि च संगिभिः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004128029, "chapter_id": 24128, "verse_number": "४-७७-३०", "content_sanskrit": "ततोपि न तदुत्साहभंगोभूद्दृढचेतसः ।\nमध्ये मार्गं मृतस्यापि गुरोरिव गतिर्मम ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004128030, "chapter_id": 24128, "verse_number": "४-७७-३१", "content_sanskrit": "इति निश्चितचेतस्के वशिष्ठे तापसे शुचौ ।\nअशूद्रान्न परीपुष्टे तुष्टोहं चंडिकेऽभवम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004128031, "chapter_id": 24128, "verse_number": "४-७७-३२", "content_sanskrit": "स्वप्रेमया स संप्रोक्तो वशिष्ठस्तापसोत्तमः ।\nदृढव्रत प्रसन्नोस्मि केदारं विद्धि मामिह ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004128032, "chapter_id": 24128, "verse_number": "४-७७-३३", "content_sanskrit": "अभीष्टं च वरं मत्तः प्रार्थयस्वाविचारितम् ।\nइत्युक्तवत्यपि मयि स्वप्नो मिथ्येति सोब्रवीत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004128033, "chapter_id": 24128, "verse_number": "४-७७-३४", "content_sanskrit": "ततोपि स मया प्रोक्तः स्वप्नो मिथ्याऽशुचिष्मताम् ।\nभवादृशाममिथ्यैव स्वाख्या सदृशवर्तिनाम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004128034, "chapter_id": 24128, "verse_number": "४-७७-३५", "content_sanskrit": "वरं ब्रूहि प्रसन्नोस्मि स्वप्नशंकां त्यज द्विज ।\nतव सत्त्ववतः किंचिन्मयादेयं न किंचन ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004128035, "chapter_id": 24128, "verse_number": "४-७७-३६", "content_sanskrit": "इत्युक्तं मे समाकर्ण्य वरयामास मामिति ।\nशिष्यो हिरण्यगर्भस्य तपस्विजनसत्तमः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004128036, "chapter_id": 24128, "verse_number": "४-७७-३७", "content_sanskrit": "यदि प्रसन्नो देवेश तदा मे सानुगा इमे ।\nसर्वे शूलिन्नुग्राह्या एष एव वरो मम ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004128037, "chapter_id": 24128, "verse_number": "४-७७-३८", "content_sanskrit": "देवि तस्येदमाकर्ण्य परोपकृतिशालिनः ।\nवचनं नितरां प्रीतस्तथेति तमुवाच ह ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004128038, "chapter_id": 24128, "verse_number": "४-७७-३९", "content_sanskrit": "पुनः परोपकरणात्तत्तपो द्विगुणीकृतम् ।\nतेन पुण्येन स मया पुनः प्रोक्तो वरं वृणु ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004128039, "chapter_id": 24128, "verse_number": "४-७७-४०", "content_sanskrit": "स वशिष्ठो महाप्राज्ञो दृढ पाशुपतव्रतः ।\nदेवि मे प्रार्थयामास हिमशैलादिह स्थितिम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004128040, "chapter_id": 24128, "verse_number": "४-७७-४१", "content_sanskrit": "ततस्तत्तपसाकृष्टः कलामात्रेण तत्र हि ।\nहिमशैले ततश्चात्र सर्वभावेन संस्थितः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004128041, "chapter_id": 24128, "verse_number": "४-७७-४२", "content_sanskrit": "ततः प्रभाते संजाते सर्वेषां पश्यतामहम् ।\nहिमाद्रे प्रस्थितः प्राप्तस्तूयमानः सुरर्षिभिः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004128042, "chapter_id": 24128, "verse_number": "४-७७-४३", "content_sanskrit": "वशिष्ठं पुरतः कृत्वा सर्वसार्थसमायुतम् ।\nहरपापह्रदे तीर्थे स्थितोहं तद्नुग्रहात् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004128043, "chapter_id": 24128, "verse_number": "४-७७-४४", "content_sanskrit": "मत्परिग्रहतः सर्वे हरपापे कृतोदकाः ।\nआराध्य मामनेनैव वपुषा सिद्धिमागताः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004128044, "chapter_id": 24128, "verse_number": "४-७७-४५", "content_sanskrit": "तदा प्रभृति लिंगेस्मिन्स्थितः साधकसिद्धये ।\nअविमुक्ते परे क्षेत्रे कलिकाले विशेषतः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004128045, "chapter_id": 24128, "verse_number": "४-७७-४६", "content_sanskrit": "तुषाराद्रिं समारुह्य केदारं वीक्ष्य यत्फलम् ।\nतत्फलं सप्तगुणितं काश्यां केदारदर्शने ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004128046, "chapter_id": 24128, "verse_number": "४-७७-४७", "content_sanskrit": "गौरीकुंडं यथा तत्र हंसतीर्थं च निर्मलम् ।\nयथा मधुस्रवा गंगा काश्यां तदखिलं तथा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004128047, "chapter_id": 24128, "verse_number": "४-७७-४८", "content_sanskrit": "इदं तीर्थं हरपापं सप्तजन्माघनाशनम् ।\nगंगायां मिलितं पश्चाज्जन्मकोटिकृताघहम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004128048, "chapter_id": 24128, "verse_number": "४-७७-४९", "content_sanskrit": "अत्र पूर्वं तु काकोलौ युध्यतौ खान्निपेततुः ।\nपश्यतां तत्र संस्थानां हंसौ भूत्वा विनिर्गतौ ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004128049, "chapter_id": 24128, "verse_number": "४-७७-५०", "content_sanskrit": "गौरि त्वया कृतं पूर्वं स्नानमत्र महाह्रदे ।\nगौरीतीर्थं ततः ख्यातं सर्वतीर्थोत्तमोत्तमम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004128050, "chapter_id": 24128, "verse_number": "४-७७-५१", "content_sanskrit": "अत्रामृतस्रवा गंगा महामोहांधकारहृत् ।\nअनेकजन्मजनित जाड्यध्वंसविधायिनी ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004128051, "chapter_id": 24128, "verse_number": "४-७७-५२", "content_sanskrit": "सरसा मानसेनात्र पूर्वं तप्तं महातपः ।\nअतस्तु मानसं तीर्थं जने ख्यातिमिदं गतम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004128052, "chapter_id": 24128, "verse_number": "४-७७-५३", "content_sanskrit": "अत्र पूर्वं जनः स्नानमात्रेणैव प्रमुच्यते ।\nपश्चात्प्रसादितश्चाहं त्रिदशैर्मुक्तिदुर्दृशैः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004128053, "chapter_id": 24128, "verse_number": "४-७७-५४", "content_sanskrit": "सर्वे मुक्तिं गमिष्यंति यदि देवेह मानवाः ।\nकेदारकुंडे सुस्नातास्तदोच्छित्तिर्भविष्यति ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004128054, "chapter_id": 24128, "verse_number": "४-७७-५५", "content_sanskrit": "सर्वेषामेव वर्णानामाश्रमाणां च धर्मिणाम् ।\nतस्मात्तनुविसर्गेत्र मोक्षं दास्यति नान्यथा ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004128055, "chapter_id": 24128, "verse_number": "४-७७-५६", "content_sanskrit": "ततस्तदुपरोधेन तथेति च मयोदितम् ।\nतदारभ्य महादेवि स्नानात्केदारकुंडतः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004128056, "chapter_id": 24128, "verse_number": "४-७७-५७", "content_sanskrit": "समर्चनाच्च भक्त्या वै मम नाम जपादपि ।\nनैःश्रेयसीं श्रियं दद्यामन्यत्रापि तनुत्यजाम ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004128057, "chapter_id": 24128, "verse_number": "४-७७-५८", "content_sanskrit": "केदारतीर्थे यः स्नात्वा पिंडान्दास्यति चात्वरः ।\nएकोत्तरशतं वंश्यास्तस्य तीर्णा भवांबुधिम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004128058, "chapter_id": 24128, "verse_number": "४-७७-५९", "content_sanskrit": "भौमवारे यदा दर्शस्तदा यः श्राद्धदो नरः ।\nकेदारकुंडमासाद्य गयाश्राद्धेन किं ततः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004128059, "chapter_id": 24128, "verse_number": "४-७७-६०", "content_sanskrit": "केदारं गंतुकामस्य बुद्धिर्देया नरैरियम् ।\nकाश्यां स्पृशंस्त्वं केदारं कृतकृत्यो भविष्यसि ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004128060, "chapter_id": 24128, "verse_number": "४-७७-६१", "content_sanskrit": "चैत्रकृष्णचतुर्दश्यामुपवासं विधाय च ।\nत्रिगंडूषान्पिबन्प्रातर्हृल्लिंगमधितिष्ठति ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004128061, "chapter_id": 24128, "verse_number": "४-७७-६२", "content_sanskrit": "केदारोदकपानेन यथा तत्र फलं भवेत् ।\nतथात्र जायते पुंसां स्त्रीणां चापि न संशयः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004128062, "chapter_id": 24128, "verse_number": "४-७७-६३", "content_sanskrit": "केदारभक्तं संपूज्य वासोन्नद्रविणादिभिः ।\nआजन्मजनितं पापं त्यक्त्वा याति ममालयम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004128063, "chapter_id": 24128, "verse_number": "४-७७-६४", "content_sanskrit": "आषण्मासं त्रिकालं यः केदारेशं नमस्यति ।\nतं नमस्यंति सततं लोकपाला यमादयः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004128064, "chapter_id": 24128, "verse_number": "४-७७-६५", "content_sanskrit": "कलौ केदारमाहात्म्यं योपि कोपि न वेत्स्यति ।\nयो वेत्स्यति सुपुण्यात्मा सर्वं वेत्स्यति स ध्रुवम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004128065, "chapter_id": 24128, "verse_number": "४-७७-६६", "content_sanskrit": "केदारेशं सकृद्दृष्ट्वा देवि मेऽनुचरो भवेत् ।\nतस्मात्काश्यां प्रयत्नेन केदारेशं विलोकयेत् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004128066, "chapter_id": 24128, "verse_number": "४-७७-६७", "content_sanskrit": "चित्रांगदेश्वरं लिंगं केदारादुत्तरे शुभम् ।\nतस्यार्चनान्नरो नित्यं स्वर्गभोगानुपाश्नुते ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004128067, "chapter_id": 24128, "verse_number": "४-७७-६८", "content_sanskrit": "केदाराद्दक्षिणे भागे नीलकंठ विलोकनात् ।\nसंसारोरगदष्टस्य तस्य नास्ति विषाद्भयम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004128068, "chapter_id": 24128, "verse_number": "४-७७-६९", "content_sanskrit": "तद्वायव्यंबरीषेशो नरस्तदवलोकनात् ।\nगर्भवासं न चाप्नोति संसारे दुःखसंकुले ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004128069, "chapter_id": 24128, "verse_number": "४-७७-७०", "content_sanskrit": "इंद्रद्युम्नेश्वरं लिंगं तत्समीपे समर्च्य च ।\nतेजोमयेन यानेन स स्वर्ग भुवि मोदते ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004128070, "chapter_id": 24128, "verse_number": "४-७७-७१", "content_sanskrit": "तद्दक्षिणे नरो दृष्ट्वा लिंगं कालंजरेश्वरम् ।\nजरां कालं विनिर्जित्य मम लोके वसेच्चिरम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004128071, "chapter_id": 24128, "verse_number": "४-७७-७२", "content_sanskrit": "दृष्ट्वा क्षेमेश्वरं लिंगमुद्क्चित्रांगदेश्वरात् ।\nसर्वत्र क्षेममाप्नोति लोकेऽत्र च परत्र च ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004128072, "chapter_id": 24128, "verse_number": "४-७७-७३", "content_sanskrit": "स्कंद उवाच ।\nदेवदेवेन विंध्यारे केदार महिमा महान् ।\nइत्याख्यायि पुरांबायै मया तेपि निरूपितः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004128073, "chapter_id": 24128, "verse_number": "४-७७-७४", "content_sanskrit": "केदारेश्वरलिंगस्य श्रुत्वोत्पत्तिं कृती नरः ।\nशिवलोकमवाप्नोति निष्पापो जायते क्षणात् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004128074, "chapter_id": 24128, "verse_number": "४-७७-७५", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीति साहस्र्यां संहितायां चतुर्थे काशीखंड उत्तरार्धे केदारमहिमाख्यानं नाम सप्तसप्ततितमोऽध्यायः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}]