[{"id": 2118877, "chapter_id": 3554, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2118878, "chapter_id": 3554, "verse_number": "१", "content_sanskrit": "किमर्थं शार्ङ्गकानग्निर्न ददाह तथागते ।\nतस्मिन् वने दह्यमाने ब्रह्मन्नेतद् प्रचक्ष्व मे \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2118879, "chapter_id": 3554, "verse_number": "२", "content_sanskrit": "नागस्याप्यश्वसेनस्य दानवस्य मयस्य च ।\nकारणं कीर्तितं ब्रह्मन् शार्ङ्गकाणां न कीर्तितम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2118880, "chapter_id": 3554, "verse_number": "३", "content_sanskrit": "तदेतदद्भुतं ब्रह्मन् शार्ङ्गकाणामनाशनम् ।\nकीर्तयस्वाग्निसम्मर्दे कथं ते न विनाशिताः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2118881, "chapter_id": 3554, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2118882, "chapter_id": 3554, "verse_number": "४", "content_sanskrit": "यदर्थं शार्ङ्गकानग्निर्न ददाह तथा गते ।\nतत् ते सम्यग् यथावृत्तं कथयिष्यामि भारत \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2118883, "chapter_id": 3554, "verse_number": "५", "content_sanskrit": "धर्मज्ञानां मुख्यतमस्तपस्वी संशितव्रतः ।\nआसीन्महर्षिः श्रुतवान् मन्दपाल इति श्रुतः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2118884, "chapter_id": 3554, "verse_number": "६", "content_sanskrit": "मार्गं समास्थितो राजन् ऋषीणामूर्ध्वरेतसाम् ।\nस्वाध्यायवान् धर्मरतस्तपस्वी विजितेन्द्रियः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2118885, "chapter_id": 3554, "verse_number": "७", "content_sanskrit": "स गत्वा तपसां पारं देहमुत्सृज्य भारत ।\nजगाम पितृलोकाय न लेभे तत्र तत्फलम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2118886, "chapter_id": 3554, "verse_number": "८", "content_sanskrit": "स लोकानावृतान् दृष्ट्वा तपसा निर्जितानपि ।\nपप्रच्छ धर्मराजस्य समीपस्थान् दिवौकसः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2118887, "chapter_id": 3554, "verse_number": "", "content_sanskrit": "मन्दपालः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2118888, "chapter_id": 3554, "verse_number": "९", "content_sanskrit": "किमर्थमावृता लोका मयेह तपसाऽर्जिताः ।\nकिं मया न कृतं तत्र यस्येदं कर्मणः फलम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2118889, "chapter_id": 3554, "verse_number": "१०", "content_sanskrit": "तत्राहं तत् करिष्यामि यदर्थमिदमावृतम् ।\nफलमेतस्य तपसः कथयध्वं दिवौकसः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2118890, "chapter_id": 3554, "verse_number": "", "content_sanskrit": "देवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2118891, "chapter_id": 3554, "verse_number": "११", "content_sanskrit": "ऋणिनो मानवा ब्रह्मन् सर्वे जायन्ति तच्छृणु ।\nब्रह्मचर्येण यज्ञेन प्रजया च न संशयः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2118892, "chapter_id": 3554, "verse_number": "१२", "content_sanskrit": "तदपाक्रियते सर्वं यज्ञेन तपसा सुतैः ।\nतपस्वी यज्ञकृच्चासि न च ते विद्यते प्रजा \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2118893, "chapter_id": 3554, "verse_number": "१३", "content_sanskrit": "त इमे प्रसवस्यार्थे तव लोकाः समावृताः ।\nप्रजायस्व ततो लोकानुपभोक्तासि शाश्वतान् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2118894, "chapter_id": 3554, "verse_number": "१४", "content_sanskrit": "पुन्नाम्नो नरकात् पुत्रस्त्रातीति पितरं मुने ।\nतस्मादपत्यसन्ताने यतस्व द्विजसत्तम \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2118895, "chapter_id": 3554, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2118896, "chapter_id": 3554, "verse_number": "१५", "content_sanskrit": "तच्छ्रुत्वा मन्दपालस्तु तेषां वाक्यं महानृषिः ।\nक्क नु शीघ्रमपत्यं स्याद् बहुलं चेत्यचिन्तयत् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2118897, "chapter_id": 3554, "verse_number": "१६", "content_sanskrit": "स चिन्तयन्नभ्यगच्छत् बहुलप्रसवान् खगान् ।\nशार्ङ्गिकां शार्ङ्गको भूत्वा जरितां समुपेयिवान् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2118898, "chapter_id": 3554, "verse_number": "१७", "content_sanskrit": "स तस्यां जनयामास चतुरः शर्ङ्गकानृषीन् ।\nतानपास्य च तत्रैव जगाम लपितां प्रति \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2118899, "chapter_id": 3554, "verse_number": "१८", "content_sanskrit": "बालान् स तानण्डगतान् सह मात्रा मुनिर्वने ।\nतस्मिन् गते महाभागे लपितां प्रति भारत\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2118900, "chapter_id": 3554, "verse_number": "१९", "content_sanskrit": "अपत्यस्नेहसंविग्ना जरिता बह्वचिन्तयत् ।\nतेन त्यक्तानसन्त्याज्यान् ऋषीनण्डगतान् वने \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2118901, "chapter_id": 3554, "verse_number": "२०", "content_sanskrit": "नाजहात् पुत्रकान् तान् स्म जरिता खाण्डवे नृप ।\nबभार चैतान् सञ्जातान् स्वपुत्रान् स्नेहवद् द्विज \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2118902, "chapter_id": 3554, "verse_number": "२१", "content_sanskrit": "ततोऽग्निं खाण्डवं दग्धुमायान्तं दृष्टवानृषिः ।\nमन्दपालश्चरंस्तस्मिन् वने लपितया सह \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2118903, "chapter_id": 3554, "verse_number": "२२", "content_sanskrit": "तं सङ्कल्पं विदित्वास्य ज्ञात्वा पुत्रांश्च बालकान् ।\nमहर्षिर्मन्दपालोऽसौ वह्निं स्तोतुं प्रचक्रमे \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2118904, "chapter_id": 3554, "verse_number": "२३", "content_sanskrit": "सोऽभितुष्टाव विप्रर्षिर्ब्राह्मणं जातवेदसम् ।\nपुत्रान् प्रति वदन् भीतो लोकपालं महौजसम् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2118905, "chapter_id": 3554, "verse_number": "", "content_sanskrit": "मन्दपालः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2118906, "chapter_id": 3554, "verse_number": "२४", "content_sanskrit": "त्वमग्ने सर्वलोकानां मुखं त्वमसि हव्यवाट् ।\nत्वमन्तः सर्वभूतानां गूढश्चरसि पावक \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2118907, "chapter_id": 3554, "verse_number": "२५", "content_sanskrit": "त्वामेकमाहुर्मुनयस्त्वामाहुस्त्रिविधं पुनः ।\nत्वामष्टधा कल्पयित्वा यज्ञवाटमकल्पयन् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2118908, "chapter_id": 3554, "verse_number": "२६", "content_sanskrit": "त्वया सृष्टमिदं सर्वं वदन्ति परमर्षयः ।\nत्वदृते हि जगत् सर्वं सद्यो नश्येद् हुताशन \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2118909, "chapter_id": 3554, "verse_number": "२७", "content_sanskrit": "यस्य कृत्वा नमो विप्राः स्वकर्मविहितां गतिम् ।\nगच्छन्ति सह पत्नीभिः पुत्रैरपि च शाश्वतीम् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2118910, "chapter_id": 3554, "verse_number": "२८", "content_sanskrit": "त्वामग्ने जलदानाहुः खे विषक्तान् सविद्युतः ।\nदहन्ति सर्वभूतानि त्वत्तो निष्क्रम्य हायनाः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2118911, "chapter_id": 3554, "verse_number": "२९", "content_sanskrit": "जातवेदस्त्वयैवेदं विश्वं सृष्टं महाद्युते ।\nतवैव कर्म विहितं भूतं सर्वं चराचरम् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2118912, "chapter_id": 3554, "verse_number": "३०", "content_sanskrit": "त्वयाऽऽपो विहिताः पूर्वं त्वयि सर्वमिदं जगत् ।\nत्वयि हव्यं च कव्यं च यथावत् सम्प्रतिष्ठितम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2118913, "chapter_id": 3554, "verse_number": "३१", "content_sanskrit": "त्वमेव दहनो देव त्वं धाता त्वं बृहस्पतिः ।\nत्वमश्विनौ यमौ मित्रः सोमस्त्वमसि चानिलः \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2118914, "chapter_id": 3554, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2118915, "chapter_id": 3554, "verse_number": "३२", "content_sanskrit": "एवं स्तुतस्तदा तेन मन्दपालेन पावकः ।\nहव्यवाहस्तु नृपते मुनेरमिततेजसः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2118916, "chapter_id": 3554, "verse_number": "३३", "content_sanskrit": "उवाच चैनं प्रीतात्मा किमिष्टं करवाणि ते ।\nतमब्रवीन्मन्दपालः पाञ्जलिर्हव्यवाहनम् \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2118917, "chapter_id": 3554, "verse_number": "३४", "content_sanskrit": "सन्दहन् खाण्डवे दावं मम पुत्रान् विसर्जय ।\nतथेति तत् प्रतिश्रुत्य भगवान् हव्यवाहनः ।\nखाण्डवे तेन काले न प्रजज्वाल दिधक्षया \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2118918, "chapter_id": 3554, "verse_number": "२२३", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nत्रयस्त्रिंशत्यधिकद्विशततमोऽध्यायः ॥२२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2118919, "chapter_id": 3554, "verse_number": "२", "content_sanskrit": "॥ इति मयदर्शनपर्वणि द्वितीयोऽध्यायः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2118920, "chapter_id": 3554, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]