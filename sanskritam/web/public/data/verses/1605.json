[{"id": 2028073, "chapter_id": 1605, "verse_number": "३-२४३-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2028074, "chapter_id": 1605, "verse_number": "३-२४३-१", "content_sanskrit": "गन्धर्वैस्तु महाराज भग्ने कर्णे महारथे।\nसंप्राद्रवच्चमूः सर्वा धार्तराष्ट्रस्य पश्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2028075, "chapter_id": 1605, "verse_number": "३-२४३-२", "content_sanskrit": "तान्दृष्ट्वा द्रवतः सर्वान्धार्तराष्ट्रान्पराङ्मुखान्।\nदुर्योधनो महाराजो नासीत्तत्र पराङ्मुखः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2028076, "chapter_id": 1605, "verse_number": "३-२४३-३", "content_sanskrit": "तामापतन्तीं संप्रेक्ष्य गन्धर्वाणां महाचमूम्।\nमहता शरवर्षेण सोऽभ्यवर्षदरिंदमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2028077, "chapter_id": 1605, "verse_number": "३-२४३-४", "content_sanskrit": "अचिन्त्य शरवर्षं तु गन्धर्वास्तस्य तं रथम्।\nदुर्योधनं जिघांसन्तः समन्तात्पर्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2028078, "chapter_id": 1605, "verse_number": "३-२४३-५", "content_sanskrit": "युगमीषां वरूथं च तथैव ध्वजसारथी।\nअश्वांस्त्रिवेणुमक्षं च तिलशो व्यधमञ्छरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2028079, "chapter_id": 1605, "verse_number": "३-२४३-६", "content_sanskrit": "दुर्योधनं चित्रसनो विरथं पतितं भुवि।\nअभिद्रुस्य महाबाहुर्जीवग्राहमथाग्रहीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2028080, "chapter_id": 1605, "verse_number": "३-२४३-७", "content_sanskrit": "`तस्य बाहू महाराज बद्ध्वा रज्ज्वा महारथम्।\nआरोप्यस महाबाहुश्चित्रसेनो ननाद ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2028081, "chapter_id": 1605, "verse_number": "३-२४३-८", "content_sanskrit": "तस्मिन्गृहीते राजेन्द्र स्थितं दुःशासनं रथे।\nपर्यगृह्णन्त गन्धर्वाः परिवार्य समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2028082, "chapter_id": 1605, "verse_number": "३-२४३-९", "content_sanskrit": "विधिशतिं चित्रसेनमादायान्ये विदुद्रुवुः।\nविन्दानुविन्दावपरे राजदारांश्च सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2028083, "chapter_id": 1605, "verse_number": "३-२४३-१०", "content_sanskrit": "सेनास्तु धार्तराष्ट्रस्य गन्धर्वैः समभिद्रुताः।\nपूर्वं प्रभग्नैः सहिताः पाण्डवानभ्ययुस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2028084, "chapter_id": 1605, "verse_number": "३-२४३-११", "content_sanskrit": "शकटापणवेशाश्च यानयुग्यं च सर्वशः।\nशरणं पाण्डवाञ्जग्मुर्हियमाणे महीपतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2028085, "chapter_id": 1605, "verse_number": "३-२४३-१२x", "content_sanskrit": "सैनिका ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2028086, "chapter_id": 1605, "verse_number": "३-२४३-१२", "content_sanskrit": "प्रियदर्शी महाबाहो धार्तराष्ट्रो महाबलः।\nगन्धर्वैर्ह्रियते राजा पार्थास्तमनुधावत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2028087, "chapter_id": 1605, "verse_number": "३-२४३-१३", "content_sanskrit": "दुःशासनो दुर्विषहो दुर्मुखो दुर्मुखो दुर्जयस्तथा।\nबद्ध्वा ह्रियन्ते गन्धर्वै राजदाराश्च सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2028088, "chapter_id": 1605, "verse_number": "३-२४३-१४", "content_sanskrit": "इतिदुर्योधनामात्याः क्रोशन्तो राजगृद्धिनः।\nआर्ता दीनास्ततः सर्वे युधिष्ठिरमुपागमन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2028089, "chapter_id": 1605, "verse_number": "३-२४३-१५", "content_sanskrit": "तांस्तथा व्यथितान्दीनान्भिक्षमाणान्युधिष्ठिरम्।\nवृद्धान्दुर्योधनामात्यान्भीमसेनोऽभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2028090, "chapter_id": 1605, "verse_number": "३-२४३-१६", "content_sanskrit": "महता हि प्रयत्नेन संनह्य गजवाजिभिः।\nअन्यथा वर्तमानानामर्थो जातोऽयमन्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2028091, "chapter_id": 1605, "verse_number": "३-२४३-१७", "content_sanskrit": "अस्माभिर्यदनुष्ठेयं गन्धर्वैस्तदनुष्ठितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2028092, "chapter_id": 1605, "verse_number": "३-२४३-१८", "content_sanskrit": "दुर्मन्त्रितमिदं तावद्राज्ञो दुर्द्यूतदेविनः।\n`दीनान्दुर्योधनस्यास्मान्द्रष्टुकामस्य दुर्मतेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2028093, "chapter_id": 1605, "verse_number": "३-२४३-१९", "content_sanskrit": "द्वेष्टारमन्ये क्लीवस्य घातयन्तीति नः श्रुतम्।\nइदं कृतं नः प्रत्यक्षं गन्धर्वैरतिमानुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2028094, "chapter_id": 1605, "verse_number": "३-२४३-२०", "content_sanskrit": "दिष्ट्या लोके पुमानस्ति कश्चिदस्मन्प्रिये स्थितः।\nयेनास्माकं हृतो भार आसीनानां सुखावहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2028095, "chapter_id": 1605, "verse_number": "३-२४३-२१", "content_sanskrit": "शीतवातातपसहांस्तपसा चैव कर्शितान्।\nसमस्थो विषमस्थान्हि द्रष्टुमिच्छति दुर्मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2028096, "chapter_id": 1605, "verse_number": "३-२४३-२२", "content_sanskrit": "अधर्मचारिणस्तस्य कौरव्यस्य दुरात्मनः।\nये शीलमनुवर्तन्ति ते पश्यन्ति पराभवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2028097, "chapter_id": 1605, "verse_number": "३-२४३-२३", "content_sanskrit": "अधर्मो हि कृतस्तेन येनैतदुपलक्षितम्।\nअनृशंसास्तु कौन्तेयास्तत्प्रत्यक्षं ब्रवीमि वः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2028098, "chapter_id": 1605, "verse_number": "३-२४३-२४", "content_sanskrit": "एवं ब्रुवाणं कौन्तेयं भीमसेनमपस्वरम्।\nन कालः परुषस्यायमिति राजाऽभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2028099, "chapter_id": 1605, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि घोषयात्रापर्वणि त्रिचत्वारिंशदधिकद्विशततमोऽध्यायः ॥ २४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]