[{"id": 2024013, "chapter_id": 1514, "verse_number": "३-१५२-०x", "content_sanskrit": "भीमसेन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2024014, "chapter_id": 1514, "verse_number": "३-१५२-१", "content_sanskrit": "पूर्वरूपमदृष्ट्वा ते न यास्यामि कथंचन।\nयदि तेऽहमनुग्राह्यो दर्शयात्मानमात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2024015, "chapter_id": 1514, "verse_number": "३-१५२-२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2024016, "chapter_id": 1514, "verse_number": "३-१५२-२", "content_sanskrit": "एवमुक्तस्तु भीमेन स्मितं कृत्वा प्लवंगमः।\nतद्रूपं दर्शयामास यद्वै सागरलङ्घने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2024017, "chapter_id": 1514, "verse_number": "३-१५२-३", "content_sanskrit": "भ्रातुः प्रियमभीप्सन्वै चकार सुमहद्वपुः।\n`तद्रूपं यत्पुरा तस्य बभूवोदधिलङ्घने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2024018, "chapter_id": 1514, "verse_number": "३-१५२-४", "content_sanskrit": "देहस्तस्य ततोऽतीव वर्धत्यायामविस्तरैः।\nसद्रुमं कदलीषण्डं छादयन्नमितद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2024019, "chapter_id": 1514, "verse_number": "३-१५२-५", "content_sanskrit": "गिरिश्चोच्छ्रयमाक्रम्य तस्थौ तत्र च वानरः।\nसमुच्छ्रितमहाकायो द्वितीय इव पर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2024020, "chapter_id": 1514, "verse_number": "३-१५२-६", "content_sanskrit": "ताम्रेक्षणस्तीक्ष्णदंष्ट्रो भृकुटीकृतलोचनः।\nदीर्घं लाङ्गूलमाविध्य दिशो व्याप्य स्थितः कपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2024021, "chapter_id": 1514, "verse_number": "३-१५२-७", "content_sanskrit": "तद्रूपं महदालक्ष्यभ्रातुः कौरवनन्दनः।\nविसिष्मिये तदा भीमो जहृषे च पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2024022, "chapter_id": 1514, "verse_number": "३-१५२-८", "content_sanskrit": "तमर्कमिव तेजोभिः सौवर्णमिव पर्वतम्।\nप्रदीप्तमिव चाकाशं दृष्ट्वा भीमो न्यमीलयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2024023, "chapter_id": 1514, "verse_number": "३-१५२-९", "content_sanskrit": "आबभाषे च हनुमान्भीमसेनं स्मयन्निव।\nएतावदिह शक्तस्त्वं द्रुष्टुं रूपं ममानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2024024, "chapter_id": 1514, "verse_number": "३-१५२-१०", "content_sanskrit": "वर्धेऽहं चाप्यतो भूयो यावन्मे मनसेप्सितम्।\nभीम शत्रुषु चात्यर्थं वर्धते मूर्तिरोजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2024025, "chapter_id": 1514, "verse_number": "३-१५२-११x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2024026, "chapter_id": 1514, "verse_number": "३-१५२-११", "content_sanskrit": "तदद्भुतं महारौद्रं विन्ध्यपर्वतसन्निभम्।\nदृष्ट्वा हनूमतो वर्ष्म संभ्रान्तः पवनात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2024027, "chapter_id": 1514, "verse_number": "३-१५२-१२", "content_sanskrit": "प्रत्युवाच ततो भीमः संप्रहृष्टतनूरुहः।\nकृताञ्जलिरदीनात्मा हनूमन्तमवस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2024028, "chapter_id": 1514, "verse_number": "३-१५२-१३", "content_sanskrit": "दृष्टं प्रमाणं विपुलं शरीरस्यास्य ते विभो।\nसंहरस्व महावीर्य स्वयमात्मानमात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2024029, "chapter_id": 1514, "verse_number": "३-१५२-१४", "content_sanskrit": "न हि शक्नोमि त्वां द्रष्टुं दिवाकरमिवोदितम्।\nअप्रमेयमनाधृष्यं मैनाकमिव पर्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2024030, "chapter_id": 1514, "verse_number": "३-१५२-१५", "content_sanskrit": "विस्मयश्चैव मे वीर सुमहान्मनसोऽद्य वै।\nयद्रामस्त्वयि पार्श्वश्थे स्वयं रावणमभ्यगात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2024031, "chapter_id": 1514, "verse_number": "३-१५२-१६", "content_sanskrit": "त्वमेव शक्तस्तां लङ्कां सयोधां सहरावणाम्।\nस्वबाहुबलमाश्रित् विनाशयितुमञ्जसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2024032, "chapter_id": 1514, "verse_number": "३-१५२-१७", "content_sanskrit": "न हि ते किंचिदप्राप्यं मारुतात्मज विद्यते।\nन चैव तव पर्याप्तो रावयणः सगणो युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2024033, "chapter_id": 1514, "verse_number": "३-१५२-१८", "content_sanskrit": "एवमुक्तस्तु भीमेन हनूमान्प्लवगोत्तमः।\nप्रत्युवाच ततो वाक्यं स्निग्धगम्भीरया गिरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2024034, "chapter_id": 1514, "verse_number": "३-१५२-१९", "content_sanskrit": "एवमेतन्महाबाहो यथा वदसि भारत।\nभीमसेन न पर्याप्तो ममासौ राक्षसाधमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2024035, "chapter_id": 1514, "verse_number": "३-१५२-२०", "content_sanskrit": "मया तु निहते तस्मिन्रावणे लोककण्टके।\nकीर्तिर्नश्येद्राघवस्य तत एतदुपेक्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2024036, "chapter_id": 1514, "verse_number": "३-१५२-२१", "content_sanskrit": "तेन वीरेण तं हत्वा सगणं राक्षसाधमम्।\nआनीता स्वपुरं सीता कीर्तिश्च स्थापिता नृषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2024037, "chapter_id": 1514, "verse_number": "३-१५२-२२", "content_sanskrit": "तद्गच्छ विपुलप्रज्ञ भ्रातुः प्रियहिते रतः।\nअरिष्टं क्षेममध्वानं वायुना परिरक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2024038, "chapter_id": 1514, "verse_number": "३-१५२-२३", "content_sanskrit": "एष पन्थाः कुरुश्रेष्ठ सौगन्धिकवनाय ते।\nद्रक्ष्यसे धनदोद्यानं रक्षितं यक्षराक्षसैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2024039, "chapter_id": 1514, "verse_number": "३-१५२-२४", "content_sanskrit": "न च ते तरसा कार्यः कुसुमापचयः स्वयम्।\nदैवतानि हि मान्यानि पुरुषेण विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2024040, "chapter_id": 1514, "verse_number": "३-१५२-२५", "content_sanskrit": "बलिहोमनमस्कारैर्मन्त्रैश्च भरतर्षभ।\nदैवतानि प्रसादं हि भक्त्या कुर्वन्ति भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2024041, "chapter_id": 1514, "verse_number": "३-१५२-२६", "content_sanskrit": "मा तात साहसं कार्षीः स्वधर्मं परिपालय।\nस्वधर्मस्थापनं धर्मं बुध्यस्वागमयस्व च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2024042, "chapter_id": 1514, "verse_number": "३-१५२-२७", "content_sanskrit": "न हि धर्ममविज्ञाय वृद्धाननुपसेव्य च।\nधर्मो वै वेदितुं शक्यो बृहस्पतिसमैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2024043, "chapter_id": 1514, "verse_number": "३-१५२-२८", "content_sanskrit": "अधर्मो यत्र धर्माख्यो धर्मश्चाधर्मसंज्ञितः।\nस विज्ञेयो विभागेन यत्रमुह्यन्त्यबुद्धयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2024044, "chapter_id": 1514, "verse_number": "३-१५२-२९", "content_sanskrit": "आचारसंभवो धर्मो धर्माद्वेदाः समुत्थिताः।\nवेदैर्यज्ञाः समुत्पन्ना यज्ञैर्देवाः प्रतिष्ठिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2024045, "chapter_id": 1514, "verse_number": "३-१५२-२०", "content_sanskrit": "वेदाचारविधानोक्तैर्यज्ञैर्धार्यन्ति देवताः।\nबृहस्पत्युशनःप्रोक्तैर्नयैर्धार्यन्ति मानवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2024046, "chapter_id": 1514, "verse_number": "३-१५२-३१", "content_sanskrit": "बल्याकरवणिज्याभिः कृष्यर्थैर्योनिपोषणैः।\nवार्तया धार्यते सर्वं धर्मैरेतैर्द्विजातिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2024047, "chapter_id": 1514, "verse_number": "३-१५२-३२", "content_sanskrit": "त्रयी वार्ता दण्डनीतिस्तिस्रो विद्या विजानताम्।\nताभिः सम्यक्प्रवृत्ताभिर्लोकयात्रा विधीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2024048, "chapter_id": 1514, "verse_number": "३-१५२-३३", "content_sanskrit": "सा चेद्धर्मकृता न स्यात्रयीधर्ममृते भुवि।\nदण्डनीतिमृतेचापि निर्मर्यादमिदं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2024049, "chapter_id": 1514, "verse_number": "३-१५२-३४", "content_sanskrit": "वार्ताधर्मे ह्यवर्तिन्यो विनश्येयुरिमाः प्रजाः।\nसुप्रवृत्तैस्त्रिभिर्ह्येतैर्धर्मैः सूयन्ति वै प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2024050, "chapter_id": 1514, "verse_number": "३-१५२-३५", "content_sanskrit": "द्विजानाममृतं धर्मो ह्येकश्चैवैकवर्णकः।\nयज्ञाध्ययनदानानि त्रयः साधारणाः स्मृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2024051, "chapter_id": 1514, "verse_number": "३-१५२-३६", "content_sanskrit": "याजनाध्यापने चोभे ब्राह्मणानां परिग्रहः।\nपालनं क्षत्रियाणां वै वैश्यधर्मश्च पोषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2024052, "chapter_id": 1514, "verse_number": "३-१५२-३७", "content_sanskrit": "शुश्रूषा च द्विजातीनां शूद्राणआं धर्म उच्यते।\nभैक्षहोमव्रतैर्हीनास्तथैव गुरुवासिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2024053, "chapter_id": 1514, "verse_number": "३-१५२-३८", "content_sanskrit": "क्षत्रधर्मोऽत्रकौन्तेय तव धर्मोऽत्र रक्षणम्।\nस्वधर्मं प्रतिपद्यस्व विनीतो नियतेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2024054, "chapter_id": 1514, "verse_number": "३-१५२-३९", "content_sanskrit": "वृद्धैः संमन्त्र्य सद्भिश्च बुद्धिमद्भिः श्रुतान्वितैः।\nआस्थितः शास्तिदण्डेन व्यसनी परिभूयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2024055, "chapter_id": 1514, "verse_number": "३-१५२-४०", "content_sanskrit": "निग्रहानुग्रहैः सम्यग्यदा नेता प्रवर्तते।\nतदा भवन्ति लोकस्य मर्यादाः सुव्यवस्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2024056, "chapter_id": 1514, "verse_number": "३-१५२-४१", "content_sanskrit": "तस्माद्देशे च दुर्गे च शत्रुमित्रबलेषु च।\nनित्यं चारेण बोद्धव्यं स्थानं वृद्धिः क्षयस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2024057, "chapter_id": 1514, "verse_number": "३-१५२-४२", "content_sanskrit": "राज्ञामुपायश्चारश्च बुद्धिमन्त्रपराक्रमाः।\nनिग्रहप्रग्रहौ चैव दाक्ष्यं वै कार्यसाधकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2024058, "chapter_id": 1514, "verse_number": "३-१५२-४३", "content_sanskrit": "साम्ना दानेन भेदेन दण्डेनोपेक्षणेन च।\nसाधनीयानि कार्याणि समासव्यासयोगतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2024059, "chapter_id": 1514, "verse_number": "३-१५२-४४", "content_sanskrit": "मन्त्रमूला नयाः सर्वेचाराश्च भरतर्षभ।\nसुमन्त्रितनयैः सद्भिस्तद्विधैः सह मन्त्रयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2024060, "chapter_id": 1514, "verse_number": "३-१५२-४५", "content_sanskrit": "स्त्रिया मूढेन बालेन लुब्धेन लघुनाऽपि वा।\nन मन्त्रयीत गुह्यानि येषु चास्पनदलक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2024061, "chapter_id": 1514, "verse_number": "३-१५२-४६", "content_sanskrit": "मन्त्रयेत्सह विद्वद्भिः शक्तैः कर्माणि कारयेत्।\nस्निग्धैश्च नीतिविन्यासैर्मूर्खान्सर्वत्र वर्जयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2024062, "chapter_id": 1514, "verse_number": "३-१५२-४७", "content_sanskrit": "धार्मिकान्धर्मकार्येषु अर्थकार्येषु पण्डितान्।\nस्त्रीषु क्लीबान्नियुञ्जीत क्रूरान्क्रूरेषु कर्मसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2024063, "chapter_id": 1514, "verse_number": "३-१५२-४८", "content_sanskrit": "स्वेभ्यश्चैव परेभ्यश्च कार्याकार्यसमुद्भवा।\nबुद्धिः कर्मसु विज्ञेया रिपूणां च बलाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2024064, "chapter_id": 1514, "verse_number": "३-१५२-४९", "content_sanskrit": "बुद्ध्या स्वप्रतिपन्नेषु कुर्यात्साधुष्वनुग्रहम्।\nनिग्रहं चाप्यशिष्टेषु निर्मर्यादेषु कारयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2024065, "chapter_id": 1514, "verse_number": "३-१५२-५०", "content_sanskrit": "निग्रहे प्रग्रहे सम्यग्यदा राजा प्रवर्तते।\nतदा भवति लोकस्य मर्यादा सुव्यवस्थिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2024066, "chapter_id": 1514, "verse_number": "३-१५२-५१", "content_sanskrit": "एष तेऽभिहितः पार्थ घोरो धर्मो दुरन्वयः।\nतं स्वधर्मविभागेन विनयस्थोऽनुपालय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2024067, "chapter_id": 1514, "verse_number": "३-१५२-५२", "content_sanskrit": "तपोधर्मदमेज्याभिर्विप्रा यान्ति यथा दिवम्।\nदानातिथ्यक्रियाधर्मैर्यान्ति वैश्याश्च सद्गतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2024068, "chapter_id": 1514, "verse_number": "३-१५२-५३", "content_sanskrit": "`द्विजशुश्रूषया शूद्रा लभन्ते गतिमुत्तमाम्।\nक्षत्रं याति तथा स्वर्गं भुवि निग्रहपालनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2024069, "chapter_id": 1514, "verse_number": "३-१५२-५४", "content_sanskrit": "सम्यक्प्रणीतदण्डा हि कामद्वेपविवर्जिताः।\nअलुब्धा विगतक्रोधाः सतां यान्ति सलोकतां ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2024070, "chapter_id": 1514, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि द्विपञ्चाशदधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]