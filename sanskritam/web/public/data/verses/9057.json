[{"id": 5000057000, "chapter_id": 9057, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे सप्तपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000057001, "chapter_id": 9057, "verse_number": "१-५७-१", "content_sanskrit": "ततः संतप्तहृदयः स्मरन्निग्रहमात्मनः।\nविनिःश्वस्य विनिःश्वस्य कृतवैरो महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000057002, "chapter_id": 9057, "verse_number": "१-५७-२", "content_sanskrit": "स दक्षिणां दिशं गत्वा महिष्या सह राघव।\nतताप परमं घोरं विश्वामित्रो महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000057003, "chapter_id": 9057, "verse_number": "१-५७-३", "content_sanskrit": "फलमूलाशनो दान्तश्चचार परमं तपः।\nअथास्य जज्ञिरे पुत्राः सत्यधर्मपरायणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000057004, "chapter_id": 9057, "verse_number": "१-५७-४", "content_sanskrit": "हविष्पन्दो मधुष्पन्दो दृढनेत्रो महारथः।\nपूर्णे वर्षसहस्रे तु ब्रह्मा लोकपितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000057005, "chapter_id": 9057, "verse_number": "१-५७-५", "content_sanskrit": "अब्रवीन्मधुरं वाक्यं विश्वामित्रं तपोधनम्।\nजिता राजर्षिलोकास्ते तपसा कुशिकात्मज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000057006, "chapter_id": 9057, "verse_number": "१-५७-६", "content_sanskrit": "अनेन तपसा त्वां हि राजर्षिरिति विद्महे।\nएवमुक्त्वा महातेजा जगाम सह दैवतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000057007, "chapter_id": 9057, "verse_number": "१-५७-७", "content_sanskrit": "त्रिविष्टपं ब्रह्मलोकं लोकानां परमेश्वरः।\nविश्वामित्रोऽपि तच्छ्रुत्वा ह्रिया किंचिदवाङ्मुखः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000057008, "chapter_id": 9057, "verse_number": "१-५७-८", "content_sanskrit": "दुःखेन महताविष्टः समन्युरिदमब्रवीत्।\nतपश्च सुमहत् तप्तं राजर्षिरिति मां विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000057009, "chapter_id": 9057, "verse_number": "१-५७-९", "content_sanskrit": "देवाः सर्षिगणाः सर्वे नास्ति मन्ये तपः फलम्।\nएवं निश्चित्य मनसा भूय एव महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000057010, "chapter_id": 9057, "verse_number": "१-५७-१०", "content_sanskrit": "तपश्चचार धर्मात्मा काकुत्स्थ परमात्मवान्।\nएतस्मिन्नेव काले तु सत्यवादी जितेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000057011, "chapter_id": 9057, "verse_number": "१-५७-११", "content_sanskrit": "त्रिशङ्कुरिति विख्यात इक्ष्वाकुकुलवर्धनः।\nतस्य बुद्धिः समुत्पन्ना यजेयमिति राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000057012, "chapter_id": 9057, "verse_number": "१-५७-१२", "content_sanskrit": "गच्छेयं स्वशरीरेण देवतानां परां गतिम्।\nवसिष्ठं स समाहूय कथयामास चिन्तितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000057013, "chapter_id": 9057, "verse_number": "१-५७-१३", "content_sanskrit": "अशक्यमिति चाप्युक्तो वसिष्ठेन महात्मना।\nप्रत्याख्यातो वसिष्ठेन स ययौ दक्षिणां दिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000057014, "chapter_id": 9057, "verse_number": "१-५७-१४", "content_sanskrit": "ततस्तत्कर्मसिद्ध्यर्थं पुत्रांस्तस्य गतो नृपः।\nवासिष्ठा दीर्घतपसस्तपो यत्र हि तेपिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000057015, "chapter_id": 9057, "verse_number": "१-५७-१५", "content_sanskrit": "त्रिशङ्कुस्तु महातेजाः शतं परमभास्वरम्।\nवसिष्ठपुत्रान् ददृशे तप्यमानान् मनस्विनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000057016, "chapter_id": 9057, "verse_number": "१-५७-१६", "content_sanskrit": "सोऽभिगम्य महात्मानः सर्वानेव गुरोः सुतान्।\nअभिवाद्यानुपूर्वेण ह्रिया किंचिदवाङ्मुखः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000057017, "chapter_id": 9057, "verse_number": "१-५७-१७", "content_sanskrit": "अब्रवीत् स महात्मानः सर्वानेव कृताञ्जलिः।\nशरणं वः प्रपन्नोऽहं शरण्यान् शरणं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000057018, "chapter_id": 9057, "verse_number": "१-५७-१८", "content_sanskrit": "प्रत्याख्यातो हि भद्रं वो वसिष्ठेन महात्मना।\nयष्टुकामो महायज्ञं तदनुज्ञातुमर्हथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000057019, "chapter_id": 9057, "verse_number": "१-५७-१९", "content_sanskrit": "गुरुपुत्रानहं सर्वान् नमस्कृत्य प्रसादये।\nशिरसा प्रणतो याचे ब्राह्मणांस्तपसि स्थितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000057020, "chapter_id": 9057, "verse_number": "१-५७-२०", "content_sanskrit": "ते मां भवन्तः सिद्ध्यर्थं याजयन्तु समाहिताः।\nसशरीरो यथाहं वै देवलोकमवाप्नुयाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000057021, "chapter_id": 9057, "verse_number": "१-५७-२१", "content_sanskrit": "प्रत्याख्यातो वसिष्ठेन गतिमन्यां तपोधनाः।\nगुरुपुत्रानृते सर्वान् नाहं पश्यामि कांचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000057022, "chapter_id": 9057, "verse_number": "१-५७-२२", "content_sanskrit": "इक्ष्वाकूणां हि सर्वेषां पुरोधाः परमा गतिः।\nतस्मादनन्तरं सर्वे भवन्तो दैवतं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000057023, "chapter_id": 9057, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे सप्तपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]