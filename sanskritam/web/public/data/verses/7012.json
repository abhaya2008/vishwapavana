  {
    "id": 20132092,
    "chapter_id": 7012,
    "verse_number": "30.2",
    "content_sanskrit": "अतोद्यं सुषिरं नाम ज्ञेयं वंशगतं बुधैः । वैण एव विधिस्तत्र स्वरग्रामसमाश्रयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20132093,
    "chapter_id": 7012,
    "verse_number": "30.3",
    "content_sanskrit": "द्विकत्रिकचतुष्कास्तु ज्ञेया वंशगताः स्वराः । कम्प्यमानार्थमुक्ताश्च व्यक्तमुक्तास्तथैव च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20132094,
    "chapter_id": 7012,
    "verse_number": "30.4",
    "content_sanskrit": "तत्रोपरि यथा ह्येकः स्वरो वैणस्वरान्तरे । प्राप्नोत्यन्यत्वमेवेह तथा वंशगतो ऽपि हि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20132095,
    "chapter_id": 7012,
    "verse_number": "30.5",
    "content_sanskrit": "द्विकस्त्रिकश्चतुष्को वा श्रुतिसङ्ख्यो भवेत् स्वरः अनीरणात्तु शेषाणां स्वराणामपि सम्भवः । अङ्गुलीवादनकृतं तच्च मे सन्निबोधत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20132096,
    "chapter_id": 7012,
    "verse_number": "30.6",
    "content_sanskrit": "व्यक्तमुक्{ताङ्गुलिस्तत्र स्वरो ज्ञेयश्चतुःश्रुतिः कम्प्यमानाङ्गुलिश्चैव त्रिश्रुतिः परिकीर्तितः । द्विको ऽर्धाङ्गुलिमुक्तः स्यादिति श्रुत्याश्रिताः स्वराः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20132097,
    "chapter_id": 7012,
    "verse_number": "30.7",
    "content_sanskrit": "एते स्युर्मध्यमग्रामे भूयः षड्जाश्रिताः पुनः । व्यक्तमुक्{ताङ्गुलिकृताः षड्जमध्यमपञ्चमाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20132098,
    "chapter_id": 7012,
    "verse_number": "30.8",
    "content_sanskrit": "ऋषभो धैवतश्चापि कम्प्यमानाङ्गुलीकृतौ । अर्धमुक्ताङ्गुलिश्चैव गान्धारो ऽथ निषादवान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
