  {
    "id": 20132100,
    "chapter_id": 7012,
    "verse_number": "30.10",
    "content_sanskrit": "विपर्यया सन्निकर्षे श्रुतिलक्षणसिद्धितः । वैणकण्ठप्रवेशेन सिद्धा एकाश्रिताः स्वराः ॥",
    "padaccheda": "",
    "anvaya": "",
