    "avatarnika": ""
  },
  {
    "id": 20132099,
    "chapter_id": 7012,
    "verse_number": "30.9",
    "content_sanskrit": "स्वरसाधारणश्चापि काकल्यन्तरसंज्ञया । निषादगान्धारकृतौ षड्जमध्यमयोरपि ॥",
    "padaccheda": "",
    "anvaya": "",
