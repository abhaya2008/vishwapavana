  {
    "id": 20132101,
    "chapter_id": 7012,
    "verse_number": "30.11",
    "content_sanskrit": "यं यं गाता स्वरं गच्छेत् तं तं वंशेन वादयेत् । शारीरवैणवंश्यानामेकीभावः प्रशस्यते ॥",
    "padaccheda": "",
    "anvaya": "",
