[{"id": 5000461000, "chapter_id": 9461, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे चतुष्पञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000461001, "chapter_id": 9461, "verse_number": "६-५४-१", "content_sanskrit": "स्वबलस्य च घातेन अङ्गदस्य बलेन च।\nराक्षसः क्रोधमाविष्टो वज्रदंष्ट्रो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000461002, "chapter_id": 9461, "verse_number": "६-५४-२", "content_sanskrit": "विस्फार्य च धनुर्घोरं शक्राशनिसमप्रभम्।\nवानराणामनीकानि प्राकिरच्छरवृष्टिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000461003, "chapter_id": 9461, "verse_number": "६-५४-३", "content_sanskrit": "राक्षसाश्चापि मुख्यास्ते रथेषु समवस्थिताः।\nनानाप्रहरणाः शूराः प्रायुध्यन्त तदा रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000461004, "chapter_id": 9461, "verse_number": "६-५४-४", "content_sanskrit": "वानराणां च शूरास्तु ते सर्वे प्लवगर्षभाः।\nअयुध्यन्त शिलाहस्ताः समवेताः समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000461005, "chapter_id": 9461, "verse_number": "६-५४-५", "content_sanskrit": "तत्रायुधसहस्राणि तस्मिन्नायोधने भृशम्।\nराक्षसाः कपिमुख्येषु पातयांचक्रिरे तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000461006, "chapter_id": 9461, "verse_number": "६-५४-६", "content_sanskrit": "वानराश्चैव रक्षःसु गिरिवृक्षान् महाशिलाः।\nप्रवीराः पातयामासुर्मत्तवारणसंनिभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000461007, "chapter_id": 9461, "verse_number": "६-५४-७", "content_sanskrit": "शूराणां युध्यमानानां समरेष्वनिवर्तिनाम्।\nतद् राक्षसगणानां च सुयुद्धं समवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000461008, "chapter_id": 9461, "verse_number": "६-५४-८", "content_sanskrit": "प्रभिन्नशिरसः केचिच्छिन्नैः पादैश्च बाहुभिः।\nशस्त्रैरर्दितदेहास्तु रुधिरेण समुक्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000461009, "chapter_id": 9461, "verse_number": "६-५४-९", "content_sanskrit": "हरयो राक्षसाश्चैव शेरते गां समाश्रिताः।\nकङ्कगृध्रबलाढ्याश्च गोमायुकुलसंकुलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000461010, "chapter_id": 9461, "verse_number": "६-५४-१०", "content_sanskrit": "कबन्धानि समुत्पेतुर्भीरूणां भीषणानि वै।\nभुजपाणिशिरश्छिन्नाश्छिन्नकायाश्च भूतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000461011, "chapter_id": 9461, "verse_number": "६-५४-११", "content_sanskrit": "वानरा राक्षसाश्चापि निपेतुस्तत्र भूतले।\nततो वानरसैन्येन हन्यमानं निशाचरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000461012, "chapter_id": 9461, "verse_number": "६-५४-१२", "content_sanskrit": "प्राभज्यत बलं सर्वं वज्रदंष्ट्रस्य पश्यतः।\nराक्षसान् भयवित्रस्तान् हन्यमानान् प्लवंगमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000461013, "chapter_id": 9461, "verse_number": "६-५४-१३", "content_sanskrit": "दृष्ट्वा स रोषताम्राक्षो वज्रदंष्ट्रः प्रतापवान्।\nप्रविवेश धनुष्पाणिस्त्रासयन् हरिवाहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000461014, "chapter_id": 9461, "verse_number": "६-५४-१४", "content_sanskrit": "शरैर्विदारयामास कङ्कपत्रैरजिह्मगैः।\nबिभेद वानरांस्तत्र सप्ताष्टौ नव पञ्च च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000461015, "chapter_id": 9461, "verse_number": "६-५४-१५", "content_sanskrit": "विव्याध परमक्रुद्धो वज्रदंष्ट्रः प्रतापवान्।\nत्रस्ताः सर्वे हरिगणाः शरैः संकृत्तदेहिनः।\nअङ्गदं सम्प्रधावन्ति प्रजापतिमिव प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000461016, "chapter_id": 9461, "verse_number": "६-५४-१६", "content_sanskrit": "ततो हरिगणान् भग्नान् दृष्ट्वा वालिसुतस्तदा।\nक्रोधेन वज्रदंष्ट्रं तमुदीक्षन्तमुदैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000461017, "chapter_id": 9461, "verse_number": "६-५४-१७", "content_sanskrit": "वज्रदंष्ट्रोऽङ्गदश्चोभौ योयुध्येते परस्परम्।\nचेरतुः परमक्रुद्धौ हरिमत्तगजाविव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000461018, "chapter_id": 9461, "verse_number": "६-५४-१८", "content_sanskrit": "ततः शतसहस्रेण हरिपुत्रं महाबलम्।\nजघान मर्मदेशेषु शरैरग्निशिखोपमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000461019, "chapter_id": 9461, "verse_number": "६-५४-१९", "content_sanskrit": "रुधिरोक्षितसर्वाङ्गो वालिसूनुर्महाबलः।\nचिक्षेप वज्रदंष्ट्राय वृक्षं भीमपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000461020, "chapter_id": 9461, "verse_number": "६-५४-२०", "content_sanskrit": "दृष्ट्वा पतन्तं तं वृक्षमसम्भ्रान्तश्च राक्षसः।\nचिच्छेद बहुधा सोऽपि मथितः प्रापतद् भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000461021, "chapter_id": 9461, "verse_number": "६-५४-२१", "content_sanskrit": "तं दृष्ट्वा वज्रदंष्ट्रस्य विक्रमं प्लवगर्षभः।\nप्रगृह्य विपुलं शैलं चिक्षेप च ननाद च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000461022, "chapter_id": 9461, "verse_number": "६-५४-२२", "content_sanskrit": "तमापतन्तं दृष्ट्वा स रथादाप्लुत्य वीर्यवान्।\nगदापाणिरसम्भ्रान्तः पृथिव्यां समतिष्ठत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000461023, "chapter_id": 9461, "verse_number": "६-५४-२३", "content_sanskrit": "अङ्गदेन शिला क्षिप्ता गत्वा तु रणमूर्धनि।\nसचक्रकूबरं साश्वं प्रममाथ रथं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000461024, "chapter_id": 9461, "verse_number": "६-५४-२४", "content_sanskrit": "ततोऽन्यच्छिखरं गृह्य विपुलं द्रुमभूषितम्।\nवज्रदंष्ट्रस्य शिरसि पातयामास वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000461025, "chapter_id": 9461, "verse_number": "६-५४-२५", "content_sanskrit": "अभवच्छोणितोद‍्गारी वज्रदंष्ट्रः सुमूर्च्छितः।\nमुहूर्तमभवन्मूढो गदामालिङ्ग्य निःश्वसन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000461026, "chapter_id": 9461, "verse_number": "६-५४-२६", "content_sanskrit": "स लब्धसंज्ञो गदया वालिपुत्रमवस्थितम्।\nजघान परमक्रुद्धो वक्षोदेशे निशाचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000461027, "chapter_id": 9461, "verse_number": "६-५४-२७", "content_sanskrit": "गदां त्यक्त्वा ततस्तत्र मुष्टियुद्धमकुर्वत।\nअन्योन्यं जघ्नतुस्तत्र तावुभौ हरिराक्षसौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000461028, "chapter_id": 9461, "verse_number": "६-५४-२८", "content_sanskrit": "रुधिरोद‍्गारिणौ तौ तु प्रहारैर्जनितश्रमौ।\nबभूवतुः सुविक्रान्तावङ्गारकबुधाविव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000461029, "chapter_id": 9461, "verse_number": "६-५४-२९", "content_sanskrit": "ततः परमतेजस्वी अङ्गदः प्लवगर्षभः।\nउत्पाट्य वृक्षं स्थितवानासीत् पुष्पफलैर्युतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000461030, "chapter_id": 9461, "verse_number": "६-५४-३०", "content_sanskrit": "जग्राह चार्षभं चर्म खड्गं च विपुलं शुभम्।\nकिङ्किणीजालसंछन्नं चर्मणा च परिष्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000461031, "chapter_id": 9461, "verse_number": "६-५४-३१", "content_sanskrit": "चित्रांश्च रुचिरान् मार्गांश्चेरतुः कपिराक्षसौ।\nजघ्नतुश्च तदान्योन्यं नर्दन्तौ जयकांक्षिणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000461032, "chapter_id": 9461, "verse_number": "६-५४-३२", "content_sanskrit": "व्रणैः सास्रैरशोभेतां पुष्पिताविव किंशुकौ।\nयुध्यमानौ परिश्रान्तौ जानुभ्यामवनीं गतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000461033, "chapter_id": 9461, "verse_number": "६-५४-३३", "content_sanskrit": "निमेषान्तरमात्रेण अङ्गदः कपिकुञ्जरः।\nउदतिष्ठत दीप्ताक्षो दण्डाहत इवोरगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000461034, "chapter_id": 9461, "verse_number": "६-५४-३४", "content_sanskrit": "निर्मलेन सुधौतेन खड्गेनास्य महच्छिरः।\nजघान वज्रदंष्ट्रस्य वालिसूनुर्महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000461035, "chapter_id": 9461, "verse_number": "६-५४-३५", "content_sanskrit": "रुधिरोक्षितगात्रस्य बभूव पतितं द्विधा।\nतच्च तस्य परीताक्षं शुभं खड्गहतं शिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000461036, "chapter_id": 9461, "verse_number": "६-५४-३६", "content_sanskrit": "वज्रदंष्ट्रं हतं दृष्ट्वा राक्षसा भयमोहिताः।\nत्रस्ता ह्यभ्यद्रवँल्लङ्कां वध्यमानाः प्लवङ्गमैः।\nविषण्णवदना दीना ह्रिया किंचिदवाङ्मुखाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000461037, "chapter_id": 9461, "verse_number": "६-५४-३७", "content_sanskrit": "निहत्य तं वज्रधरः प्रतापवान्\nस वालिसूनुः कपिसैन्यमध्ये।\nजगाम हर्षं महितो महाबलः\nसहस्रनेत्रस्त्रिदशैरिवावृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000461038, "chapter_id": 9461, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे चतुष्पञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]