[{"id": 5000389000, "chapter_id": 9389, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे पञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000389001, "chapter_id": 9389, "verse_number": "५-५०-१", "content_sanskrit": "तमुद्वीक्ष्य महाबाहुः पिङ्गाक्षं पुरतः स्थितम्।\nरोषेण महताऽऽविष्टो रावणो लोकरावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000389002, "chapter_id": 9389, "verse_number": "५-५०-२", "content_sanskrit": "शङ्काहतात्मा दध्यौ स कपीन्द्रं तेजसा वृतम्।\nकिमेष भगवान् नन्दी भवेत् साक्षादिहागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000389003, "chapter_id": 9389, "verse_number": "५-५०-३", "content_sanskrit": "येन शप्तोऽस्मि कैलासे मया प्रहसिते पुरा।\nसोऽयं वानरमूर्तिः स्यात्किंस्विद् बाणोऽपि वासुरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000389004, "chapter_id": 9389, "verse_number": "५-५०-४", "content_sanskrit": "स राजा रोषताम्राक्षः प्रहस्तं मन्त्रिसत्तमम्।\nकालयुक्तमुवाचेदं वचो विपुलमर्थवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000389005, "chapter_id": 9389, "verse_number": "५-५०-५", "content_sanskrit": "दुरात्मा पृच्छ्यतामेष कुतः किं वास्य कारणम्।\nवनभङ्गे च कोऽस्यार्थो राक्षसानां च तर्जने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000389006, "chapter_id": 9389, "verse_number": "५-५०-६", "content_sanskrit": "मत्पुरीमप्रधृष्यां वै गमने किं प्रयोजनम्।\nआयोधने वा कं कार्यं पृच्छ्यतामेष दुर्मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000389007, "chapter_id": 9389, "verse_number": "५-५०-७", "content_sanskrit": "रावणस्य वचः श्रुत्वा प्रहस्तो वाक्यमब्रवीत्।\nसमाश्वसिहि भद्रं ते न भीः कार्या त्वया कपे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000389008, "chapter_id": 9389, "verse_number": "५-५०-८", "content_sanskrit": "यदि तावत् त्वमिन्द्रेण प्रेषितो रावणालयम्।\nतत्त्वमाख्याहि मा ते भूद् भयं वानर मोक्ष्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000389009, "chapter_id": 9389, "verse_number": "५-५०-९", "content_sanskrit": "यदि वैश्रवणस्य त्वं यमस्य वरुणस्य च।\nचारुरूपमिदं कृत्वा प्रविष्टो नः पुरीमिमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000389010, "chapter_id": 9389, "verse_number": "५-५०-१०", "content_sanskrit": "विष्णुना प्रेषितो वापि दूतो विजयकाङ्क्षिणा।\nनहि ते वानरं तेजो रूपमात्रं तु वानरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000389011, "chapter_id": 9389, "verse_number": "५-५०-११", "content_sanskrit": "तत्त्वतः कथयस्वाद्य ततो वानर मोक्ष्यसे।\nअनृतं वदतश्चापि दुर्लभं तव जीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000389012, "chapter_id": 9389, "verse_number": "५-५०-१२", "content_sanskrit": "अथवा यन्निमित्तस्ते प्रवेशो रावणालये।\nएवमुक्तो हरिवरस्तदा रक्षोगणेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000389013, "chapter_id": 9389, "verse_number": "५-५०-१३", "content_sanskrit": "अब्रवीन्नास्मि शक्रस्य यमस्य वरुणस्य च।\nधनदेन न मे सख्यं विष्णुना नास्मि चोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000389014, "chapter_id": 9389, "verse_number": "५-५०-१४", "content_sanskrit": "जातिरेव मम त्वेषा वानरोऽहमिहागतः।\nदर्शने राक्षसेन्द्रस्य तदिदं दुर्लभं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000389015, "chapter_id": 9389, "verse_number": "५-५०-१५", "content_sanskrit": "वनं राक्षसराजस्य दर्शनार्थं विनाशितम्।\nततस्ते राक्षसाः प्राप्ता बलिनो युद्धकाङ्क्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000389016, "chapter_id": 9389, "verse_number": "५-५०-१६", "content_sanskrit": "रक्षणार्थं च देहस्य प्रतियुद्धा मया रणे।\nअस्त्रपाशैर्न शक्योऽहं बद्धुं देवासुरैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000389017, "chapter_id": 9389, "verse_number": "५-५०-१७", "content_sanskrit": "पितामहादेष वरो ममापि हि समागतः।\nराजानं द्रष्टुकामेन मयास्त्रमनुवर्तितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000389018, "chapter_id": 9389, "verse_number": "५-५०-१८", "content_sanskrit": "विमुक्तोऽप्यहमस्त्रेण राक्षसैस्त्वभिवेदितः।\nकेनचिद् रामकार्येण आगतोऽस्मि तवान्तिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000389019, "chapter_id": 9389, "verse_number": "५-५०-१९", "content_sanskrit": "दूतोऽहमिति विज्ञाय राघवस्यामितौजसः।\nश्रूयतामेव वचनं मम पथ्यमिदं प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000389020, "chapter_id": 9389, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे पञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]