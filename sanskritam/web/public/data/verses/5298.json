[{"id": 2201663, "chapter_id": 5298, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2201664, "chapter_id": 5298, "verse_number": "१", "content_sanskrit": "आरामाणां तडागानां यत्फलं कुरुनन्दन ।\nसंस्कृतानां यथाकामं तत्फलं ब्रूहि सत्तम ।\nतदहं श्रोतुमिच्छामि त्वत्तोऽद्य भरतर्षभ\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2201665, "chapter_id": 5298, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2201666, "chapter_id": 5298, "verse_number": "२", "content_sanskrit": "सुप्रदर्शा वनवती चित्रधातुविभूषिता ।\nउपेता सर्वबीजैश्च श्रेष्ठा भूमिरिहोच्यते\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2201667, "chapter_id": 5298, "verse_number": "३", "content_sanskrit": "तस्याः क्षेत्रविशेषं च तडागानां निवेशनम् ।\nऔदकानि च सर्वाणि प्रवक्ष्याम्यनुपूर्वशः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2201668, "chapter_id": 5298, "verse_number": "४", "content_sanskrit": "तडागानां च वक्ष्यामि कृतानां चापि ये गुणाः ।\nत्रिषु लोकेषु सर्वत्र पूजितो यस्तडागवान्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2201669, "chapter_id": 5298, "verse_number": "५", "content_sanskrit": "अथवा मित्रसदनं मैत्रं मित्रविवर्धनम् ।\nकीर्तिसञ्जननं श्रेष्ठं तडागानां निवेशनम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2201670, "chapter_id": 5298, "verse_number": "६", "content_sanskrit": "धर्मस्यार्थस्य कामस्य फलमाहुर्मनीषिणः ।\nतडागं सुकृतं देशे क्षेत्रमेव महाश्रयम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2201671, "chapter_id": 5298, "verse_number": "७", "content_sanskrit": "चतुर्विधानां भूतानां तडागमुपलक्षयेत् ।\nतडागानि च सर्वाणि दिशन्ति श्रियमुत्तमाम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2201672, "chapter_id": 5298, "verse_number": "८", "content_sanskrit": "देवा मनुष्या गन्धर्वाः पितरोरगराक्षसाः ।\nस्थावराणि च भूतानि संश्रयन्ति जलाशयम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2201673, "chapter_id": 5298, "verse_number": "९", "content_sanskrit": "तस्मात् तांस्ते प्रवक्ष्यामि तडागे ये गुणाः स्मृताः ।\nया च तत्र फलावाप्तिर्ऋषिभिः समुदाहृता\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2201674, "chapter_id": 5298, "verse_number": "१०", "content_sanskrit": "वर्षमात्रे तडागे तु सलिलं यस्य तिष्ठति ।\nअग्निहोत्रफलं तस्य फलमाहुर्मनीषिणः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2201675, "chapter_id": 5298, "verse_number": "११", "content_sanskrit": "शरत्काले तु सलिलं तडागे यस्य तिष्ठति ।\nगोसहस्रस्य स प्रेत्य लभते फलमुत्तमम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2201676, "chapter_id": 5298, "verse_number": "१२", "content_sanskrit": "हेमन्तकाले सलिलं तडागे यस्य तिष्ठति ।\nस वै बहुसुवर्णस्य यज्ञस्य लभते फलम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2201677, "chapter_id": 5298, "verse_number": "१३", "content_sanskrit": "यस्य वै शैशिरे काले तडागे सलिलं भवेत् ।\nअग्निष्टोमस्य यज्ञस्य फलमाहुर्मनीषिणः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2201678, "chapter_id": 5298, "verse_number": "१४", "content_sanskrit": "तडागं सुकृतं यस्य वसन्ते तु महाश्रयम् ।\nअतिरात्रस्य यज्ञस्य फलं स समुपाश्नुते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2201679, "chapter_id": 5298, "verse_number": "१५", "content_sanskrit": "निदाघकाले पानीयं तडागे यस्य तिष्ठति ।\nवाजपेयसमं तस्य फलं वै मुनयो विदुः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2201680, "chapter_id": 5298, "verse_number": "१६", "content_sanskrit": "स कुलं तारयेत् सर्वं यस्य खाते जलाशये ।\nगावः पिबन्ति पानीयं साधवश्च नराः सदा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2201681, "chapter_id": 5298, "verse_number": "१७", "content_sanskrit": "तडागे यस्य गावस्तु पिबन्ति तृषिता जलम् ।\nमृगपक्षिमनुष्याश्च सोऽश्वमेधफलं लभेत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2201682, "chapter_id": 5298, "verse_number": "१८", "content_sanskrit": "यत् पिबन्ति जलं तत्र स्नायन्ते विश्रमन्ति च ।\nतडागदस्य तत् सर्वं प्रेत्यानन्त्याय कल्पते\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2201683, "chapter_id": 5298, "verse_number": "१९", "content_sanskrit": "दुर्लभं सलिलं तात विशेषेण परत्र वै ।\nपानीयस्य प्रदानेन प्रीतिर्भवति शाश्वती\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2201684, "chapter_id": 5298, "verse_number": "२०", "content_sanskrit": "तिलान् ददत पानीयं दीपान् ददत जाग्रत ।\nज्ञातिभिः सह मोदध्वमेतत् प्रेतेषु दुर्लभम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2201685, "chapter_id": 5298, "verse_number": "२१", "content_sanskrit": "सर्वदानैर्गुरुतरं सर्वदानैर्विशिष्यते ।\nपानीयं नरशार्दूल तस्माद् दातव्यमेव हि\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2201686, "chapter_id": 5298, "verse_number": "२२", "content_sanskrit": "एवमेतत् तडागेषु कीर्तितं फलमुत्तमम् ।\nअत ऊर्ध्वं प्रवक्ष्यामि वृक्षाणामपि रोपणे\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2201687, "chapter_id": 5298, "verse_number": "२३", "content_sanskrit": "स्थावराणां च भूतानां जातयः षट्प्रकीर्तिताः ।\nवृक्षगुल्मलतावल्ल्यस्त्वक्सारास्तृणजातयः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2201688, "chapter_id": 5298, "verse_number": "२४", "content_sanskrit": "एता जात्यस्तु वृक्षाणां तेषां रोपे गुणास्त्विमे ।\nकीर्तिश्च मानुषे लोके प्रेत्य चैव फलं शुभम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2201689, "chapter_id": 5298, "verse_number": "२५", "content_sanskrit": "लभते नाम लोके च पितृभिश्च महीयते ।\nदेवलोकगतस्यापि नाम तस्य न नश्यति\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2201690, "chapter_id": 5298, "verse_number": "२६", "content_sanskrit": "अतीतानागते चोभे पितृवंशं च भारत ।\nतारयेद् वृक्षरोपी च तस्माद् वृक्षान् प्ररोपयेत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2201691, "chapter_id": 5298, "verse_number": "२७", "content_sanskrit": "तस्य पुत्रा भवन्त्येते पादपा नात्र संशयः ।\nपरलोकगतः स्वर्गं लोकांश्चाप्नोति सोऽव्ययान्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2201692, "chapter_id": 5298, "verse_number": "२८", "content_sanskrit": "पुष्पैः सुरगणान् वृक्षाः फलैश्चापि तथा पितॄन् ।\nछायया चातिथींस्तात पूजयन्ति महीरुहाः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2201693, "chapter_id": 5298, "verse_number": "२९", "content_sanskrit": "किन्नरोरगरक्षांसि देवगन्धर्वमानवाः ।\nतथा ऋषिगणाश्चैव संश्रयन्ति महीरुहान्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2201694, "chapter_id": 5298, "verse_number": "३०", "content_sanskrit": "पुष्पिताः फलवन्तश्च तर्पयन्तीह मानवान् ।\nवृक्षदं पुत्रवद् वृक्षास्तारयन्ति परत्र च\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2201695, "chapter_id": 5298, "verse_number": "३१", "content_sanskrit": "तस्मात् तडागे वृक्षा वै रोप्याः श्रेयोर्थिना सदा ।\nपुत्रवत् परिपाल्याश्च पुत्रास्ते धर्मतः स्मृताः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2201696, "chapter_id": 5298, "verse_number": "३२", "content_sanskrit": "तडागकृद् वृक्षरोपी इष्टयज्ञश्च यो द्विजः ।\nएते स्वर्गे महीयन्ते ये चान्ये सत्यवादिनः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2201697, "chapter_id": 5298, "verse_number": "३३", "content_sanskrit": "तस्मात् तडागं कुर्वीत आरामांश्चैव रोपयेत् ।\nयजेच्च विविधैर्यज्ञैः सत्यं च सततं वदेत्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2201698, "chapter_id": 5298, "verse_number": "१४९", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे आरामतडागादिनिर्माणफलकथनं नाम एकोनपञ्चाशदधिकशततमोऽध्यायः ॥१४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2201699, "chapter_id": 5298, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]