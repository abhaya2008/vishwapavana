[{"id": 7000998000, "chapter_id": 20998, "verse_number": "४-४-१", "content_sanskrit": "श्रीपराशर उवाच ।\nकाश्यपदुहिता सुमतिर्विदर्भराजतनया केशिनी च द्वे भार्ये सगरस्यास्ताम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000998001, "chapter_id": 20998, "verse_number": "४-४-२", "content_sanskrit": "ताभ्यां चापत्यार्थमौर्वः परमेण समाधिनाराधितो वरमदात् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000998002, "chapter_id": 20998, "verse_number": "४-४-३", "content_sanskrit": "एका वंशकरमेकं पुत्रमपरा षष्टिं पुत्रसहस्राणां जनयिष्यतीति यस्या यदभिमतं तदिच्छया गृह्यतामित्युक्ते केशिन्येकं वरयामास ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000998003, "chapter_id": 20998, "verse_number": "४-४-४", "content_sanskrit": "सुमतिः पुत्रसहस्राणि षष्टिं वव्रे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000998004, "chapter_id": 20998, "verse_number": "४-४-५", "content_sanskrit": "तथेत्युक्ते अल्पैरहोभिः केशिनी पुत्रमेकमसमंजसनामानं वंशकरमसूत ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000998005, "chapter_id": 20998, "verse_number": "४-४-६", "content_sanskrit": "काश्यपतनयायास्तु सुमत्याः षष्टिं पुत्रसहस्राण्यभवन् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000998006, "chapter_id": 20998, "verse_number": "४-४-७", "content_sanskrit": "तस्मादसमंजसादंशुमान्नाम कुमारो जज्ञे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000998007, "chapter_id": 20998, "verse_number": "४-४-८", "content_sanskrit": "स त्वसमंजसो बालो बाल्यादेवासद्वृत्तोभूत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000998008, "chapter_id": 20998, "verse_number": "४-४-९", "content_sanskrit": "पिता चास्याचिंतयदयमतीतबाल्यः सुबुद्धिमान् भविष्यतीति ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000998009, "chapter_id": 20998, "verse_number": "४-४-१०", "content_sanskrit": "अथ तत्रापि च वयस्यतीते असच्चरितमेनं पिता तत्याज ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000998010, "chapter_id": 20998, "verse_number": "४-४-११", "content_sanskrit": "तान्यपि षष्टिः पुत्रसहस्राण्यसमंजसचरितमेवानुचक्रुः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000998011, "chapter_id": 20998, "verse_number": "४-४-१२", "content_sanskrit": "ततश्चासमंजसचरितानुकारिभिस्सागरैरपध्वस्तयज्ञैसन्मार्गे जगति देवास्सकलविद्यामयमसंस्पृष्टमश्षोदोषैर्भगवतः पुरुषोत्तमस्यांशभूत कपिलं प्रणम्य तदर्थमूचुः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000998012, "chapter_id": 20998, "verse_number": "४-४-१३", "content_sanskrit": "भगवन्नेभिस्सगरतनयैरसमंजसचरितमनुगम्यते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000998013, "chapter_id": 20998, "verse_number": "४-४-१४", "content_sanskrit": "कथमेभिरसद्वृत्तमनुसरद्भिर्जगद्भविष्यतीति ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000998014, "chapter_id": 20998, "verse_number": "४-४-१५", "content_sanskrit": "अत्यार्त्त जगत्परित्राणाय च भगवतोत्र शरीरग्रहणमित्याकर्ण्य भगवानाहाल्पैरैव दिनैर्विनंक्ष्यन्तीति ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000998015, "chapter_id": 20998, "verse_number": "४-४-१६", "content_sanskrit": "अत्रांतरे च सगरो हयमेधमारभत ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000998016, "chapter_id": 20998, "verse_number": "४-४-१७", "content_sanskrit": "तस्य च पुत्रैरधिष्ठितमस्याश्वं कोप्यपहृत्य भुवो बिलं प्रविवेश ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000998017, "chapter_id": 20998, "verse_number": "४-४-१८", "content_sanskrit": "ततस्तत्तनयाश्चाश्वखुरगतिनिर्वंधेनावनीमेकैको योजनं चख्नुः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000998018, "chapter_id": 20998, "verse_number": "४-४-१९", "content_sanskrit": "पाताले चाश्वं परिभ्रमंतं तमवनीपतितनयास्ते ददृशुः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000998019, "chapter_id": 20998, "verse_number": "४-४-२०", "content_sanskrit": "नातिदूरेऽवस्थितं च भगवंतमपघने शरत्कालेर्कमिव तेजोभिरवनतमूर्द्धमधश्चाश्षोदिशश्चोद्भासयमानं हयहर्त्तारं कपिलर्षिमपश्यन् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000998020, "chapter_id": 20998, "verse_number": "४-४-२१", "content_sanskrit": "ततश्चोद्यतायुधा दुरात्मानोऽयमस्मदपकारी यज्ञविघ्नकारी हन्यतां हयहर्त्ता हन्यतामित्यवोचन्नभ्यधावंश्च ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000998021, "chapter_id": 20998, "verse_number": "४-४-२२", "content_sanskrit": "ततस्तेनापि भगवता किंचिदीषत्परिवर्त्तितलोचनेनावलोकितास्स्वशरीरसमुत्थेनाऽग्निना-दह्यमाना विनेशुः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000998022, "chapter_id": 20998, "verse_number": "४-४-२३", "content_sanskrit": "सगरोप्यवगम्याश्वानुसारि तत्पुत्रबलमश्षॐ परमर्षिणा कपिलेन तेजसा दग्धं ततॐशुमंतमसमंजसपुत्रमश्वानयनाय युयोज ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000998023, "chapter_id": 20998, "verse_number": "४-४-२४", "content_sanskrit": "स तु सगरतनयखातमार्गेण कपिलमुपगम्य भक्तिनम्रस्तदा तृष्टाव ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000998024, "chapter_id": 20998, "verse_number": "४-४-२५", "content_sanskrit": "अथैनं भगवानाह ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000998025, "chapter_id": 20998, "verse_number": "४-४-२६", "content_sanskrit": "गच्छैनं पितामहायाश्वं प्रापय वरं वृणीष्व च पुत्रक पौत्राश्च ते स्वर्गाद्गंगां भुवमानेष्यन्त इति ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000998026, "chapter_id": 20998, "verse_number": "४-४-२७", "content_sanskrit": "अथांशुमानपि स्वर्यातानां ब्रह्मदंडहतानामस्मत्पितॄणामस्वर्गयोग्यानां स्वर्गप्राप्तिकरं वरमस्माकं प्रयच्छेति प्रत्याह ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000998027, "chapter_id": 20998, "verse_number": "४-४-२८", "content_sanskrit": "तदाकर्ण्य तं च भगवानाह उक्तमेवैतन्मयाद्य पौत्रस्ते त्रिदिवाद्गंगां भुवमानयिष्यतीति ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000998028, "chapter_id": 20998, "verse_number": "४-४-२९", "content_sanskrit": "तदंभसा च संस्पृष्टेष्वस्थिभस्मसु एते च स्वर्गमारोक्ष्यन्ति ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000998029, "chapter_id": 20998, "verse_number": "४-४-३०", "content_sanskrit": "भगवद्विष्णुपादांगुष्ठनिर्गतस्य हि जलस्यैतन्माहात्म्यम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000998030, "chapter_id": 20998, "verse_number": "४-४-३१", "content_sanskrit": "यन्न केवलमभिसंधिपूर्वकं स्नानाद्युपभोगेषूपकारकमनभिसांधितमप्यस्यां प्रेतप्राणस्यास्थिचर्मस्नायुकेशाद्युपस्पृष्टं शरीरजमपि पतितं सद्यश्शरीरिणं स्वर्गं नयतीत्युक्तः प्रणम्य भवगतेऽश्वमादाय पितामहयज्ञमाजगाम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000998031, "chapter_id": 20998, "verse_number": "४-४-३२", "content_sanskrit": "सगरोप्यश्वमासाद्य तं यज्ञं समापयामास ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000998032, "chapter_id": 20998, "verse_number": "४-४-३३", "content_sanskrit": "सागरं चात्मजप्रीत्या पुत्रत्वे कल्पितवान् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000998033, "chapter_id": 20998, "verse_number": "४-४-३४", "content_sanskrit": "तस्यांशुमतो दिलीपः पुत्रोभवत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000998034, "chapter_id": 20998, "verse_number": "४-४-३५", "content_sanskrit": "दिलीपस्य भगीरथः योऽसौ गंगां स्वर्गादिहानीय भागीरथीसंज्ञां चकार ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000998035, "chapter_id": 20998, "verse_number": "४-४-३६", "content_sanskrit": "भगीरथात्सुहोत्रस्सुहोत्राच्छ्रुतः तस्यापि नाभागः ततॐबरीषः तत्पुत्रस्सिंधुद्वीपः सिंधुद्वीपादयुतायुः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000998036, "chapter_id": 20998, "verse_number": "४-४-३७", "content_sanskrit": "तत्पुत्रश्च ऋतुपर्णः योऽसौ नलसहायोक्षहृदयज्ञोभूत् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000998037, "chapter_id": 20998, "verse_number": "४-४-३८", "content_sanskrit": "ऋतुपर्णपुत्रस्सर्वकामः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000998038, "chapter_id": 20998, "verse_number": "४-४-३९", "content_sanskrit": "तत्तनयस्सुदासः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000998039, "chapter_id": 20998, "verse_number": "४-४-४०", "content_sanskrit": "सुदासात्सौदासो मित्र सहनामा ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000998040, "chapter_id": 20998, "verse_number": "४-४-४१", "content_sanskrit": "स चाटव्यां मृगयार्थी पर्यटन् व्याघ्रद्वयमपश्यत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000998041, "chapter_id": 20998, "verse_number": "४-४-४२", "content_sanskrit": "ताभ्यां तद्वनमपमृगं कृतं मत्वैकं तयोर्बाणेन जघान ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000998042, "chapter_id": 20998, "verse_number": "४-४-४३", "content_sanskrit": "म्रियमाणश्चासावतिभीषणाकृतिरतिकरालवदनो राक्षसोऽभूत् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000998043, "chapter_id": 20998, "verse_number": "४-४-४४", "content_sanskrit": "द्वितीयोपि प्रतिक्रियां ते करिष्यामीत्युक्त्वांतर्धानं जगाम ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000998044, "chapter_id": 20998, "verse_number": "४-४-४५", "content_sanskrit": "कालेन गच्छता सौदासो यज्ञमयजत् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000998045, "chapter_id": 20998, "verse_number": "४-४-४६", "content_sanskrit": "परिनिष्ठितयज्ञे आचार्ये वसिष्ठे निष्क्रांते तद्र क्षो वसिष्ठरूपमास्थाय यज्ञावसाने मम नरमांसभोजनं देयमिति तत्संस्क्रियतां क्षणादागमिष्यामीत्युक्त्वा निष्क्रांतः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000998046, "chapter_id": 20998, "verse_number": "४-४-४७", "content_sanskrit": "भूयश्च सूदवेषं कृत्वा राजाज्ञया मानुषं मांसं संस्कृत्य राज्ञे न्यवेदयत् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000998047, "chapter_id": 20998, "verse_number": "४-४-४८", "content_sanskrit": "आगताय वसिष्ठाय निवेदितवान् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000998048, "chapter_id": 20998, "verse_number": "४-४-४९", "content_sanskrit": "स चाप्यचिंतयदहोस्य राज्ञो दौश्शील्यं येनैतन्मांसमस्माकं प्रयच्छति किमेतद्द्र व्यजातमिति ध्यानपरोभवत् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000998049, "chapter_id": 20998, "verse_number": "४-४-५०", "content_sanskrit": "अपश्यच्च तन्मांसंमानुषम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000998050, "chapter_id": 20998, "verse_number": "४-४-५१", "content_sanskrit": "अतः क्रोधकलुषीकृतचेता राजनि सापमुत्ससर्ज ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000998051, "chapter_id": 20998, "verse_number": "४-४-५२", "content_sanskrit": "यस्मादभोज्यमेतदस्मद्विधानां तपस्विनामवगच्छन्नपि भवान्मह्यं ददाति तस्मात्तवैवात्र लोलुपता भविष्यतीति ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000998052, "chapter_id": 20998, "verse_number": "४-४-५३", "content_sanskrit": "अनंतरं च तेनापि भगवतैवाभिहितोस्मीत्युक्ते किं किं मयाभहितमिति मुनिः पुनरपि समाधौ तस्थौ ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000998053, "chapter_id": 20998, "verse_number": "४-४-५४", "content_sanskrit": "समाधिविज्ञानावगतार्थश्चानुग्रहं तस्मै चकार नात्यंतिकमेतद्द्वादशाब्दं तव भोजनं भविष्यतीति ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000998054, "chapter_id": 20998, "verse_number": "४-४-५५", "content_sanskrit": "असावपि प्रतिगृह्योदकांजलिं मुनिशापप्रदानायोद्यतो भगवन्नयमस्मद्गुरुर्नार्हस्येनं कुलदेवताभूतमाचार्यं शप्तुमिति मदयंत्या स्वपत्न्या प्रसादितस्सस्यांबुदरक्षणार्थं तच्छापांवु नोर्व्यां न चाकाशे चिक्षेप किं तु तेनैव स्वपदौ सिषेच ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000998055, "chapter_id": 20998, "verse_number": "४-४-५६", "content_sanskrit": "तेन च क्वोधाश्रितेनांबुना दग्धच्छायौ तत्पादौ कल्माषतामुपगतौ ततस्स कल्माषपादसंज्ञामवाप ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000998056, "chapter_id": 20998, "verse_number": "४-४-५७", "content_sanskrit": "वसिष्ठशापाच्च षष्ठेषष्ठे काले राक्षसस्वभावमेत्याटव्यां पर्यटन्ननेकशो मानुषानभक्षयत् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000998057, "chapter_id": 20998, "verse_number": "४-४-५८", "content_sanskrit": "एकदा तु कंचिन्मुनिमृतुकाले भार्यासंगतं ददर्श ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000998058, "chapter_id": 20998, "verse_number": "४-४-५९", "content_sanskrit": "तयोश्च तमतिभीषणं राक्षसस्वरूपमवलोक्य त्रासाद्दंपत्योः प्रधावितयोर्ब्रह्मणं जग्राह ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000998059, "chapter_id": 20998, "verse_number": "४-४-६०", "content_sanskrit": "ततस्सा ब्राह्मणी बहुशस्तमभियाचितवती ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000998060, "chapter_id": 20998, "verse_number": "४-४-६१", "content_sanskrit": "प्रसीदेक्ष्वाकुकुलतिलकभूतस्त्वं महाराजो मित्रसहो न राक्षसः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000998061, "chapter_id": 20998, "verse_number": "४-४-६२", "content_sanskrit": "नार्हसि स्त्रीधर्मसुखाभिज्ञो मय्यकृतार्थायामस्मद्भर्त्तारं हंतुमित्येवं बहुप्रकारं तस्यां विलपंत्यां व्याघ्रः पशुमिवाऽरण्येऽभिमतं तं ब्राह्मणमभक्षयत् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000998062, "chapter_id": 20998, "verse_number": "४-४-६३", "content_sanskrit": "ततश्चातिकोपसमन्विता ब्राह्मणी तं राजानं शशाप ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000998063, "chapter_id": 20998, "verse_number": "४-४-६४", "content_sanskrit": "यस्मादेवं मय्यतृषप्तायां त्वयायं मत्पतिर्भक्षितः तस्मात्त्वमपि कामोपभोगप्रवृत्तॐतं प्राप्स्यसीति ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000998064, "chapter_id": 20998, "verse_number": "४-४-६५", "content_sanskrit": "शप्त्वा चैव साग्निं प्रविवेश ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000998065, "chapter_id": 20998, "verse_number": "४-४-६६", "content_sanskrit": "ततस्तस्य द्वादशाब्दपर्यये विमुक्तशापस्य स्त्रीविषयाभिलाषिणो मदयंती तं स्मारयामास ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000998066, "chapter_id": 20998, "verse_number": "४-४-६७", "content_sanskrit": "ततः परमसौ स्त्रीभोगं तत्याज ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000998067, "chapter_id": 20998, "verse_number": "४-४-६८", "content_sanskrit": "वसिष्ठश्चापुत्रेण राज्ञा पुत्रार्थमभ्यर्थितो मदयंत्यां गर्भाधानं चकार ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000998068, "chapter_id": 20998, "verse_number": "४-४-६९", "content_sanskrit": "यदा च सप्तवर्षाण्यसौ गर्भेण जज्ञे ततस्तं गर्भमश्मना सा देवी जघान ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000998069, "chapter_id": 20998, "verse_number": "४-४-७०", "content_sanskrit": "पुत्रश्चाजायत ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000998070, "chapter_id": 20998, "verse_number": "४-४-७१", "content_sanskrit": "तस्य चाश्मक इत्येव नामाभवत् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000998071, "chapter_id": 20998, "verse_number": "४-४-७२", "content_sanskrit": "अश्मस्य मूलको नाम पुत्रोऽभवत् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000998072, "chapter_id": 20998, "verse_number": "४-४-७३", "content_sanskrit": "योसौ निःक्षत्रे क्ष्मातलेस्मिन् क्रियमाणे स्त्रीभिर्विवस्त्राभिः परिवार्य रक्षितः ततस्तं नारीकवचमुदाहरंति ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000998073, "chapter_id": 20998, "verse_number": "४-४-७४", "content_sanskrit": "मूलकाद्दशरथस्तस्मादिलिविलस्ततश्च विश्वसहः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000998074, "chapter_id": 20998, "verse_number": "४-४-७५", "content_sanskrit": "तस्माच्च खट्वांगः योसौ देवासुरसंग्रामे देवैरभ्यर्थितोऽसुराञ्जघान ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000998075, "chapter_id": 20998, "verse_number": "४-४-७६", "content_sanskrit": "स्वर्गे च कृतप्रियैर्देवैर्वरग्रहणाय चोदितः प्राह ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000998076, "chapter_id": 20998, "verse_number": "४-४-७७", "content_sanskrit": "यद्यवश्यं वरो ग्राह्यः तन्ममायुः कथ्यतामिति ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000998077, "chapter_id": 20998, "verse_number": "४-४-७८", "content_sanskrit": "अनंतरं च तैरुक्तं मुहूर्त्तमेकं प्रमाणं तवायुरित्युक्तोथास्खलितगतिना विमानेन लघिमादिगुणो मर्त्यलोकमागम्येदमाह ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000998078, "chapter_id": 20998, "verse_number": "४-४-७९", "content_sanskrit": "यथा न ब्राह्मणेभ्यस्सकाशादात्मापि मे प्रियतरः न च स्वधर्मोल्लंघनं मया कदाचिदप्यनुष्ठितं न च सकलदेवमानुषपशुपक्षिवृक्षादिकेष्वच्युतव्यतिरेकवती दृष्टिर्ममाभूत् तथा तमेवं मुनिजनानुस्मृतं भगवंतमस्खलितगतिः प्रापयेयमित्यश्षोदेवगुरौ भगवत्यनिर्द्देश्यवपुषि सत्तामात्रात्मन्यात्मानं परमात्मनि वासुदेवाख्ये युयोज तत्रैव च लयमवाप ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000998079, "chapter_id": 20998, "verse_number": "४-४-८०", "content_sanskrit": "अत्रापि श्रूयते श्लोको गीतस्सप्तर्षिभिः पुरा ।\nखट्वांगेन समो नान्यः कश्चिदुर्व्यां भविष्यति ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000998080, "chapter_id": 20998, "verse_number": "४-४-८१", "content_sanskrit": "येन स्वर्गादिहागम्य मुहूर्त्तं प्राप्य जीवितम् ।\nत्रयोतिसंधिता लोका बुद्ध्या सत्येन चैव हि ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000998081, "chapter_id": 20998, "verse_number": "४-४-८२", "content_sanskrit": "खट्वांगाद्दीर्घबाहुः पुत्रोऽभवत् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000998082, "chapter_id": 20998, "verse_number": "४-४-८३", "content_sanskrit": "ततो रघुरभवत् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000998083, "chapter_id": 20998, "verse_number": "४-४-८४", "content_sanskrit": "तस्मादप्यजः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000998084, "chapter_id": 20998, "verse_number": "४-४-८५", "content_sanskrit": "अजाद्दशरथः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000998085, "chapter_id": 20998, "verse_number": "४-४-८६", "content_sanskrit": "तस्यापि भगवानब्जनाभो जगतः स्थित्यर्थमात्मांश्नो रामलक्ष्मणभरतशत्रुघ्नरूपेण चतुर्द्धा पुत्रत्वमायासीत् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000998086, "chapter_id": 20998, "verse_number": "४-४-८७", "content_sanskrit": "रामोपि बाल एव विश्वमित्रयागरक्षणाय गच्छंस्ताटकां जघान ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000998087, "chapter_id": 20998, "verse_number": "४-४-८८", "content_sanskrit": "यज्ञे च मारीचमिषुवाताहतं समुद्रे चिक्षेप ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000998088, "chapter_id": 20998, "verse_number": "४-४-८९", "content_sanskrit": "सुबाहुप्रमुखांश्च क्षयमनयत् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000998089, "chapter_id": 20998, "verse_number": "४-४-९०", "content_sanskrit": "दर्शनमात्रेणाहल्यामपापां चकार ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000998090, "chapter_id": 20998, "verse_number": "४-४-९१", "content_sanskrit": "जनकगृहे च माहेश्वरं चापमनायासेन बभंज ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000998091, "chapter_id": 20998, "verse_number": "४-४-९२", "content_sanskrit": "सीतामयोनिजां जनकराजतनयां वीर्यशुल्कां लेभे ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000998092, "chapter_id": 20998, "verse_number": "४-४-९३", "content_sanskrit": "सकलक्षत्त्रियक्षयकारिणमश्षोहैहयकुलधूमकेतुभूतं च परशुराममपास्तवीर्यबलावलेपं चकार ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000998093, "chapter_id": 20998, "verse_number": "४-४-९४", "content_sanskrit": "पितृवचनाच्चागणितराज्याभिलाषो भ्रातृभार्यासमेतो वनं प्रविवेश ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000998094, "chapter_id": 20998, "verse_number": "४-४-९५", "content_sanskrit": "विराधखरदूषणादीन् कबंधवालिनौ च निजघान ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000998095, "chapter_id": 20998, "verse_number": "४-४-९६", "content_sanskrit": "बद्धा चांभोनिधिमसेषराक्षसकुलक्षयं कृत्वा दशाननापहृतां भार्यां तद्वधादपहृतकलंकामप्यनलप्रवेशशुद्धामश्षोदेवसंघैस्तूयमानशीलां जनकराजकन्यामयोध्यामानिन्ये ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000998096, "chapter_id": 20998, "verse_number": "४-४-९७", "content_sanskrit": "ततश्चाभिषेकमंगलं मैत्रेय वर्षशतेनापि वक्तुं न शक्यते संक्षेपेण श्रूयताम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000998097, "chapter_id": 20998, "verse_number": "४-४-९८", "content_sanskrit": "लक्ष्मणभरतशत्रुघ्नविभीषणसुग्रीवांगदजाम्बवद्धनुमत्प्रभृतिभिस्समु-त्फुल्लवदनैश्छत्रचामरादियुतैः सेव्यमानो दाशरथिर्ब्रह्मेंयमनिरृतिवरुणवायुकुबेरेशानप्रभृतिभिस्सर्वामरैर्वसि-ष्ठवामदेववाल्मीकिमार्कण्डेयविश्वामित्रभरद्वाजागस्त्यप्रभृतिभिर्मु-निवरैः ऋग्यजुस्सामाथर्वैस्संस्तूयमानो नृत्यगीतवाद्याद्यखिललोकमंगलवाद्यैर्वीणावेणुमृदंगभेरीपटहशंखकाहलगोमुखप्रभृतिभिस्सुना-दैस्समस्तभूभृतां मध्ये सकललोकरक्षार्थं यथोचितमभिषिक्तो दाशरथिः कोसलेंद्रो रघुकुलतिलको जानकीप्रियो भ्रातृत्रयप्रियस्सिंहासनगत एकादसाब्दसहस्रं राज्यमकरोत् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000998098, "chapter_id": 20998, "verse_number": "४-४-९९", "content_sanskrit": "भरतोपि गंधर्वविषयसाधनाय गच्छन् संग्रामे गंधर्वकोटीस्तिस्रो जघान ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000998099, "chapter_id": 20998, "verse_number": "४-४-१००", "content_sanskrit": "शत्रुघ्नेनाप्यमितबलपराक्रमो मधुपुत्रो लवणो नाम राक्षसो निहतो मथुरा च निवेशिता ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000998100, "chapter_id": 20998, "verse_number": "४-४-१०१", "content_sanskrit": "इत्येवमाद्यतिबलपराक्रमविक्रमणैरतिदुष्टसंहारिणोश्षोस्य जगतो निष्पादितस्थितयो रामलक्ष्मणभरतशत्रुघ्नाः पुनरपि दिवमारूढाः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000998101, "chapter_id": 20998, "verse_number": "४-४-१०२", "content_sanskrit": "येऽपि तेषु भगवदंश्ष्वोनुरागिणः कोसलनगरजानपदास्तेपि तन्मनसस्तत्सालोक्यतामवापुः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000998102, "chapter_id": 20998, "verse_number": "४-४-१०३", "content_sanskrit": "अतिदुष्टसंहारिणो रामस्य कुशलवौ द्वौ पुत्रौ लक्ष्मणस्यांगदचंद्र केतू तक्षपुष्कलौ भरतस्य सुबाहुशूरसेनौ शत्रुघ्नस्य ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000998103, "chapter_id": 20998, "verse_number": "४-४-१०४", "content_sanskrit": "कुशस्यातिथिरतिथेरपि निषधः पुत्रोऽभूत् ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000998104, "chapter_id": 20998, "verse_number": "४-४-१०५", "content_sanskrit": "निषधस्याप्यनलस्तस्मादपि नभाः नभसः पुंडरीकस्तत्तनयः क्षेमधन्वा तस्य च देवानीकस्तस्याप्यहीनकोऽहीनकस्यापि रुरुस्तस्य च पारियात्रकः पारियात्राद्देवलो देवलाद्वच्चलः तस्याप्युत्कः उत्काच्च वज्रनाभस्तस्माच्छंखणस्तमाद्युषिताश्वस्ततश्च विश्वसहो जज्ञे ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000998105, "chapter_id": 20998, "verse_number": "४-४-१०६", "content_sanskrit": "तस्माद्धिरण्यनाभः यो महायोगीस्वराज्जैमिनेश्शिष्याद्याज्ञवल्क्याद्योगमवाय ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000998106, "chapter_id": 20998, "verse_number": "४-४-१०७", "content_sanskrit": "हिरण्यनाभस्य पुत्रः पुष्यस्तस्माद् ध्रुवसंधिस्ततस्सुदर्शनस्तस्मादग्निवर्णस्ततश्शीघ्रगस्तस्मादपि मरुः पुत्रोऽभवत् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7000998107, "chapter_id": 20998, "verse_number": "४-४-१०८", "content_sanskrit": "योसौ योगमास्थायाद्यापि कलापग्राममश्रित्य तिष्ठति ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7000998108, "chapter_id": 20998, "verse_number": "४-४-१०९", "content_sanskrit": "आगामियुगे सूर्यवंशक्षत्रव्रत आवर्त्तयिता भविष्यति ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7000998109, "chapter_id": 20998, "verse_number": "४-४-११०", "content_sanskrit": "तस्यात्मजः प्रशुश्रुकस्तस्यापि सुसंधिस्ततश्चाप्यमर्षस्तस्य च सहस्वांस्ततश्च विश्वभवः ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7000998110, "chapter_id": 20998, "verse_number": "४-४-१११", "content_sanskrit": "तस्य बृहद्बलः योर्जुनतनयेनाभिमन्युनाभारतयुद्धे क्षयमनीयत ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7000998111, "chapter_id": 20998, "verse_number": "४-४-११२", "content_sanskrit": "एते इक्ष्वाकुभूपालाः प्राधान्येन मयेरिताः ।\nएतेषां चरितं शृण्वन् सर्वपापैः प्रमुच्यते ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}]