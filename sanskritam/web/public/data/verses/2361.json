[{"id": 2064035, "chapter_id": 2361, "verse_number": "८-८२-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2064036, "chapter_id": 2361, "verse_number": "८-८२-१", "content_sanskrit": "ततो भग्नेषु सैन्येषु भीमसेनेन संयुगे।\nदुर्योधनोऽब्रवीत्किं नु सौबलो वाऽपि सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2064037, "chapter_id": 2361, "verse_number": "८-८२-२", "content_sanskrit": "कर्णो वा जयतां श्रेष्ठो योधा वा मामका युधि।\nकृपो वा कृतवर्मा वा द्रौणिर्दुःशासनोऽपि वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2064038, "chapter_id": 2361, "verse_number": "८-८२-३", "content_sanskrit": "अत्यद्भुतमहं मन्ये पाण्डवेयस्य विक्रमम्।\nयदेकः समरे सर्वान्योधयामास मामकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2064039, "chapter_id": 2361, "verse_number": "८-८२-४", "content_sanskrit": "यथाप्रतिज्ञं योधानां राधेयः कृतवानपि।\nकुरूणामथ सर्वेषां कर्णः शत्रुनिषूदनः।\nशर्म वर्म प्रतिष्ठा च जीविताशा च सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2064040, "chapter_id": 2361, "verse_number": "८-८२-५", "content_sanskrit": "तद्भग्रं स्वबलं दृष्ट्वा कौन्तेयेनामितौजसा।\nधनुर्दराणां प्रवरः कर्णः किमकरोद्युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2064041, "chapter_id": 2361, "verse_number": "८-८२-६", "content_sanskrit": "पुत्रा वा मम दुर्धर्षा राजानो वा महारथाः।\nएतन्मे सर्वमाचक्ष्व कुशलो ह्यसि सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2064042, "chapter_id": 2361, "verse_number": "८-८२-७x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2064043, "chapter_id": 2361, "verse_number": "८-८२-७", "content_sanskrit": "अपराह्णे महाराज सूतपुत्रः प्रतापवान्।\nजघान सोमकान्सर्वान्भीमसेनस्य पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2064044, "chapter_id": 2361, "verse_number": "८-८२-८", "content_sanskrit": "भीमोऽप्यतिबलं सैन्यं धार्तराष्ट्रं व्यपोथयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2064045, "chapter_id": 2361, "verse_number": "८-८२-९", "content_sanskrit": "द्राव्यमाणं बलं दृष्ट्वा भीमसेनेन धीमता।\nयन्तारमब्रवीत्कर्णः पाञ्चालानेव मां वह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2064046, "chapter_id": 2361, "verse_number": "८-८२-१०", "content_sanskrit": "मद्रराजस्ततः शल्यः श्वेतानश्वान्महाजवान्।\nप्राहिणोच्चेदिपाञ्चालान्करूशांश्च महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2064047, "chapter_id": 2361, "verse_number": "८-८२-११", "content_sanskrit": "प्रविश्य च महत्सैन्यं शल्यः परबलार्दनः।\nन्ययच्छत्तुरगान्हृष्टो यत्रयत्र च ते रथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2064048, "chapter_id": 2361, "verse_number": "८-८२-१२", "content_sanskrit": "तं रथं मेघसङ्काशं वैयाघ्रपरिवारणम्।\nसंदृश्य पाण्डुपञ्चालास्त्रस्ता ह्यासन्विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2064049, "chapter_id": 2361, "verse_number": "८-८२-१३", "content_sanskrit": "ततो रथस्य निनदः प्रादुरासीन्महारणे।\nपर्जन्यसमनिर्घोषः पर्वतस्येव दीर्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2064050, "chapter_id": 2361, "verse_number": "८-८२-१४", "content_sanskrit": "ततः शरशतैस्तीक्षणैः कर्ण आकर्णनिःसृतैः।\nजघान पाण्डवबलं शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2064051, "chapter_id": 2361, "verse_number": "८-८२-१५", "content_sanskrit": "तं तथा समरे कर्म कुर्वाणमपराजितम्।\nपरिवव्रुर्महेष्वासाः पाण्डवानां महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2064052, "chapter_id": 2361, "verse_number": "८-८२-१६", "content_sanskrit": "तं शिखण्डी च भीमश्च धृष्टद्युम्नश्च पार्षतः।\nनकुलः सहदेवश्च द्रौपदेयाश्च सात्यकिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2064053, "chapter_id": 2361, "verse_number": "८-८२-१७", "content_sanskrit": "परिवव्रुर्जिघांसन्तो राधेयं शरवृष्टिभिः।\nसात्यकिस्तु तदा कर्णं विंशत्या निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2064054, "chapter_id": 2361, "verse_number": "८-८२-१८", "content_sanskrit": "अताडयद्रणे शूरो जत्रुदेशे नरोत्तमः।\nशिखण्डी पञ्चविंशत्या धृष्टद्युम्नश्च सप्तभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2064055, "chapter_id": 2361, "verse_number": "८-८२-१९", "content_sanskrit": "द्रौपदेयाश्चतुःषष्ट्या सहदेवश्च सप्तभिः।\nनकुलश्च शतेनाजौ कर्णं विव्याध सायकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2064056, "chapter_id": 2361, "verse_number": "८-८२-२०", "content_sanskrit": "भीमसेनस्तु राधेयं नवत्या नतपर्वणाम्।\nविव्याध समरे क्रुद्धो जत्रुदेशे महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2064057, "chapter_id": 2361, "verse_number": "८-८२-२१", "content_sanskrit": "अथ प्रहस्याधिरथिर्व्याक्षिपद्धनुरुत्तमम्।\nमुमोच निशितान्बाणान्पीडयन्सुमहाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2064058, "chapter_id": 2361, "verse_number": "८-८२-२२", "content_sanskrit": "तान्प्रत्यविध्यद्राधेयः पञ्चभिः पञ्चभिः शरैः।\nसात्यकेस्तु धनुश्छित्त्वा ध्वजं च भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2064059, "chapter_id": 2361, "verse_number": "८-८२-२३", "content_sanskrit": "तं तथा नवभिर्बाणैराजघान स्तनान्तरे।\nभीमसेनं ततः क्रुद्धो विव्याध त्रिंशता शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2064060, "chapter_id": 2361, "verse_number": "८-८२-२४", "content_sanskrit": "सहदेवस्य भल्लेन ध्वजं चिच्छेद मारिष।\nसारथिं च त्रिभिर्बाणैराजघान परन्तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2064061, "chapter_id": 2361, "verse_number": "८-८२-२५", "content_sanskrit": "विरथान्द्रौपदेयांश्च चकार भरतर्षभ।\nअक्ष्णोर्निमेषमात्रेण तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2064062, "chapter_id": 2361, "verse_number": "८-८२-२६", "content_sanskrit": "विमुखीकृत्य तान्सर्वाञ्शरैः सन्नतपर्वभिः।\nपाञ्चालानहनञ्छूरांश्चेदीनां च महारथान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2064063, "chapter_id": 2361, "verse_number": "८-८२-२७", "content_sanskrit": "ते वध्यमानाः समरे चेदिमत्स्या विशाम्पते।\nकर्णमेकमभिद्रुत्य शरसङ्खैः समार्पयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2064064, "chapter_id": 2361, "verse_number": "८-८२-२८", "content_sanskrit": "ताञ्जघान शितैर्बाणैः सूतपुत्रो महारथः।\nते वध्यमानाः समरे चेदिमात्स्या विशाम्पते।\nप्राद्रवन्त रणे भीताः सिंहत्रस्ता मृगा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2064065, "chapter_id": 2361, "verse_number": "८-८२-२९", "content_sanskrit": "एतदत्युद्भतं कर्म दृष्ट्वानस्मि भारत।\nयदेकः समरे शूरान्सूतपुत्रः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2064066, "chapter_id": 2361, "verse_number": "८-८२-३०", "content_sanskrit": "यतमानान्परं शक्त्या योधयानांश्च धन्विनः।\nपाण्डवेयान्महाराज शरैर्वारितवान्रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2064067, "chapter_id": 2361, "verse_number": "८-८२-३१", "content_sanskrit": "तत्र भारत कर्णस्य लाघवेन महात्मनः।\nतुतुषुर्देवताः सर्वाः सिद्धाश्च सह चारणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2064068, "chapter_id": 2361, "verse_number": "८-८२-३२", "content_sanskrit": "अपूजयन्महेष्वासा धार्तराष्ट्रा नरोत्तमम्।\nकर्णं रथवरश्रेष्ठं श्रेष्ठं सर्वधनुष्मताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2064069, "chapter_id": 2361, "verse_number": "८-८२-३३", "content_sanskrit": "ततः कर्णो महाराज ददाह रिपुवाहिनीम्।\nकक्षमिद्धो यथा वह्निर्निदाधे ज्वलितो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2064070, "chapter_id": 2361, "verse_number": "८-८२-३४", "content_sanskrit": "ते वध्यमानाः कर्णेन पाण्डवेयास्ततस्ततः।\nप्राद्रवन्त रणे भीताः कर्णं दृष्ट्वा महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2064071, "chapter_id": 2361, "verse_number": "८-८२-३५", "content_sanskrit": "तत्राक्रन्दो महानासीत्पाञ्चालानां महारणे।\nवध्यतां सायकैस्तीक्ष्णैः कर्णचापवरच्युतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2064072, "chapter_id": 2361, "verse_number": "८-८२-३६", "content_sanskrit": "तेन शब्देन वित्रस्ता पाण्डवानां महाचमूः।\nकर्णमेकं रणे योधं मेनिरे तत्र शात्रवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2064073, "chapter_id": 2361, "verse_number": "८-८२-३७", "content_sanskrit": "तत्राद्भुतं पुनश्चक्रे राधेयः शत्रुकर्शनः।\nयदेनं पाण्डवाः सर्वे न शेकुरभिवीक्षितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2064074, "chapter_id": 2361, "verse_number": "८-८२-३८", "content_sanskrit": "जलौघः पर्वतश्रेष्ठं यथासाद्य प्रभिद्यते।\nतथा तत्पाण्डवं सैन्यं कर्णमासाद्य दीर्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2064075, "chapter_id": 2361, "verse_number": "८-८२-३९", "content_sanskrit": "कर्णोऽपि समरे राजन्विधूमोऽग्निरिव ज्वलत्।\nदहंस्तस्थौ महाबाहुः पाण्डवानां महाचमूम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2064076, "chapter_id": 2361, "verse_number": "८-८२-४०", "content_sanskrit": "शिरांसि च महाराज कर्णां श्चैव सकुण्डलान्।\nबाहूंश्च वीरो वीराणां चिच्छेद लघु चेषुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2064077, "chapter_id": 2361, "verse_number": "८-८२-४१", "content_sanskrit": "हस्तिदन्तत्सरून्खङ्गान्ध्वजाञ्शक्तीर्हयान्गजान्।\nरथांश्च विविधान्राजन्पताका व्यजनानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2064078, "chapter_id": 2361, "verse_number": "८-८२-४२", "content_sanskrit": "अक्षं च युगयोक्त्राणि चक्राणि विविधानि च।\nचिच्छेद बहुधा कर्णो योधव्रतमनुष्ठितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2064079, "chapter_id": 2361, "verse_number": "८-८२-४३", "content_sanskrit": "तत्र भारत कर्णेन निहतैर्गजवाजिभिः।\nअगम्यरूपा पृथिवी मांसशोणितकर्दमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2064080, "chapter_id": 2361, "verse_number": "८-८२-४४", "content_sanskrit": "विषमं च समं चैव हतैरश्वपदातिभिः।\nरथैश्च कुञ्जरैश्चैव न प्राज्ञायत किञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2064081, "chapter_id": 2361, "verse_number": "८-८२-४५", "content_sanskrit": "नापि स्वे न परे योधाः प्राज्ञायन्त परस्परम्।\nघोरे शरान्धकारे तु कर्णास्त्रे च विजृम्भिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2064082, "chapter_id": 2361, "verse_number": "८-८२-४६", "content_sanskrit": "राधेयचापनिर्मुक्तैः शरैः काञ्चनभूषणैः।\nसञ्छादिता महाराज पाण्डवानां महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2064083, "chapter_id": 2361, "verse_number": "८-८२-४७", "content_sanskrit": "ते पाण्डवेयाः समरे राधेयेन पुनः पुनः।\nअभज्यन्त महाराज यतमाना महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2064084, "chapter_id": 2361, "verse_number": "८-८२-४८", "content_sanskrit": "मृगसङ्घान्यथा क्रुद्धः सिंहो द्रावयते वने।\nपञ्चालानां रथश्रेष्ठान्द्रावयञ्शात्रवांस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2064085, "chapter_id": 2361, "verse_number": "८-८२-४९", "content_sanskrit": "कर्णस्तु समरे योधांस्त्रासयुन्सुमहायशाः।\nकालयामास तत्सैन्यं यथा पशुगणान्वृकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2064086, "chapter_id": 2361, "verse_number": "८-८२-५०", "content_sanskrit": "दृष्ट्वा तु पाण्डवीं मेनां धार्तराष्ट्राः पराङ्युखीम्।\nतत्राजग्मुर्महेष्वासा रुदन्तो भैरवात्रवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2064087, "chapter_id": 2361, "verse_number": "८-८२-५१", "content_sanskrit": "दुर्योधनो हि राजेन्द्र मुदा परमया युतः।\nवादयामास संहृष्टो नानावाद्यानि सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2064088, "chapter_id": 2361, "verse_number": "८-८२-५२", "content_sanskrit": "पाञ्चालाश्च महेष्वासा भग्नास्तत्र नरोत्तमाः।\nन्यवर्तन्त तदा शूरा मृत्युं कृत्वा निवर्तनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2064089, "chapter_id": 2361, "verse_number": "८-८२-५३", "content_sanskrit": "तान्निवृत्तान्रणे शूरान्राधेयः शत्रुतापनः।\nअनेकशो महाराज बभञ्ज पुरुषर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2064090, "chapter_id": 2361, "verse_number": "८-८२-५४", "content_sanskrit": "तत्र भारत कर्णेन पाञ्चाला विंशती रथाः।\nनिहताः सायकैः क्रोधाच्चेदयश्च परंशताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2064091, "chapter_id": 2361, "verse_number": "८-८२-५५", "content_sanskrit": "कृत्वा शून्यान्रथोपस्थान्वाजिपृष्ठांश्च भारत।\nनिर्मनुष्यान्गजस्कन्धान्पादातांश्चैव विद्रुतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2064092, "chapter_id": 2361, "verse_number": "८-८२-५६", "content_sanskrit": "आदित्य इव मध्याह्ने दुर्निरीक्ष्यः परन्तपः।\nकालान्तकवपुः शूरः सूतपुत्रोऽभ्यराजत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2064093, "chapter_id": 2361, "verse_number": "८-८२-५७", "content_sanskrit": "एवमेतन्महाराज नरवाजिरथद्विपान्।\nहत्वा तस्थौ महेष्वासः कर्णोऽरिगणसूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2064094, "chapter_id": 2361, "verse_number": "८-८२-५८", "content_sanskrit": "यथा भूतगणान्हत्वा कालस्तिष्ठेन्महाबलः।\nतथा स सोमकान्हत्वा तस्थावेको महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2064095, "chapter_id": 2361, "verse_number": "८-८२-५९", "content_sanskrit": "तत्राद्भुतमपश्याम पाञ्चालानां पराक्रमम्।\nवध्यमानाऽपि यत्कर्णं नाजहू रणमूर्धनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2064096, "chapter_id": 2361, "verse_number": "८-८२-६०", "content_sanskrit": "राजा दुःशासनश्चैव कृपः शारद्वतस्तथा।\nअश्वत्थामा कृतवर्मा शकुनिश्च महाबलः।\nव्यहनन्पाण्डवीं सेनां शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2064097, "chapter_id": 2361, "verse_number": "८-८२-६१", "content_sanskrit": "कर्मपुत्रौ तु राजेन्द्र भ्रातरौ सत्यविक्रमौ।\nनिजघ्नाते बलं क्रुद्धौ पाण्डवानामितस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2064098, "chapter_id": 2361, "verse_number": "८-८२-६२", "content_sanskrit": "तत्र युद्धं महच्चासीत्क्रूरं विशसनं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2064099, "chapter_id": 2361, "verse_number": "८-८२-६३", "content_sanskrit": "तथैव पाण्डवाः शूरा धृष्टद्युम्नशिखण्डिनौ।\nद्रौपदेयाश्च सङ्क्रुद्धा अभ्यघ्नंस्तावकं बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2064100, "chapter_id": 2361, "verse_number": "८-८२-६४", "content_sanskrit": "एवमेष क्षयो वृत्तः पाण्डवानां ततस्ततः।\nतावकानामपि रणे भीमं प्राप्य महाबलम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2064101, "chapter_id": 2361, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तदशदिवसयुद्धे द्व्यशीतितमोऽध्यायः॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}]