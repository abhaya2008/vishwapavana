[{"id": 7000204000, "chapter_id": 20204, "verse_number": "२०४-१", "content_sanskrit": "इन्द्रकृष्णसंवादवर्णनम् व्यास उवाच संस्तुतो भगवानित्थं देवराजेन केशवः ।\nप्रहस्य भावगम्भीरमुवोचेदं द्विजोत्तमाः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000204001, "chapter_id": 20204, "verse_number": "२०४-२", "content_sanskrit": "श्रीभगवानुवाच देवराजो भवानिन्द्रो वयं मर्त्या जगत्पते ।\nक्षन्तव्यं भवतैवैतदपराधकृतं मम ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000204002, "chapter_id": 20204, "verse_number": "२०४-३", "content_sanskrit": "पारिजाततरुचायं नीयतामचितास्पदम् ।\nगृहीतोऽयं मया शक्र सत्यावचनकारणात् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000204003, "chapter_id": 20204, "verse_number": "२०४-४", "content_sanskrit": "वज्रं चेदं गृहाण त्वं यष्टव्यं प्रहितं त्वया ।\nतवैवैतत्प्रहरणं शक्रवैरिविदारणम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000204004, "chapter_id": 20204, "verse_number": "२०४-५", "content_sanskrit": "शक्र उवाच विमोहयसि मामीश मर्त्योऽहमिति किं वदन् ।\nजानीमस्त्वां भगवतोऽनन्तसौख्यविदो वयम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000204005, "chapter_id": 20204, "verse_number": "२०४-६", "content_sanskrit": "यऽसि सोऽसि जगन्नाथ प्रवृतौ नाथ संस्थितः ।\nजगतः शल्यनिष्कर्ष करोष्यसुरसूदन ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000204006, "chapter_id": 20204, "verse_number": "२०४-७", "content_sanskrit": "नीयतां पारिजातोऽयं कृष्ण द्वारवतीं पुरीम् ।\nमर्त्यलोके त्वया मुक्ते नायं संस्थास्यते भुवि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000204007, "chapter_id": 20204, "verse_number": "२०४-८", "content_sanskrit": "व्यास उवाच तथेत्युक्त्वा तु देवेन्द्रमाजगाम भुवं हरिः ।\nप्रयुक्तैः सिद्धागन्धर्वैः स्तूयमानस्त्वथर्षिभिः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000204008, "chapter_id": 20204, "verse_number": "२०४-९", "content_sanskrit": "जगाम कृष्णः सहसा गृहीत्वा पादपोत्तमम् ।\nततः शङ्खमुपाध्माय द्वारकोपरि संस्थितः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000204009, "chapter_id": 20204, "verse_number": "२०४-१०", "content_sanskrit": "हर्षमुत्पादयामास द्वारकावासिनां द्विजाः ।\nअवतीर्याथ गरुडात्सत्यभामासहायवान् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000204010, "chapter_id": 20204, "verse_number": "२०४-११", "content_sanskrit": "निष्कुटे स्थापयामास पारिजातं महातरुम् ।\nयमभ्येत्य जनः सर्वो जातिं स्मरति पौर्विकीम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000204011, "chapter_id": 20204, "verse_number": "२०४-१२", "content_sanskrit": "वास्यते यस्य पुष्पाणां गन्धेनोर्वी त्रियोजनम् ।\nततस्ते यादवाः सर्वे देवगन्धानमानुषान् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000204012, "chapter_id": 20204, "verse_number": "२०४-१३", "content_sanskrit": "ददृशुः पादपे तस्मिन्कुर्वतो मुखदर्शनम् ।\nकिंकरैः समुपानीतं हस्त्यश्वादि ततो धनम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000204013, "chapter_id": 20204, "verse_number": "२०४-१४", "content_sanskrit": "स्त्रियश्च कृष्णो जग्राह नरकस्य परिग्रहात् ।\nततः काले शुभे प्राप्त उपयेमे जनार्दनः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000204014, "chapter_id": 20204, "verse_number": "२०४-१५", "content_sanskrit": "ताः कन्या नरकावासात्सर्वतो याः समाहृताः ।\nएकस्मिन्नेव गोविन्दः कालेनाऽऽसां द्विजोत्तमाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000204015, "chapter_id": 20204, "verse_number": "२०४-१६", "content_sanskrit": "जग्राह विधिवत्पाणीन्पृथग्देहे स्वधर्मतः ।\nषोडश स्त्रीसहस्राणि शतमेकं तथाऽधिकम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000204016, "chapter_id": 20204, "verse_number": "२०४-१७", "content_sanskrit": "तावन्ति चक्रे रूपाणि भगवान्मधुसूदनः ।\nएकैकशश्च ताः कन्या मेनिरे मधुसूदनम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000204017, "chapter_id": 20204, "verse_number": "२०४-१८", "content_sanskrit": "ममैव पाणिग्रहणं गोविन्दः कृतवानिति ।\nनिशासु जगतः स्रष्टा तासां गेहेषु केशवः ।\nउवास विप्रा सर्वासां विश्वरूपधरो हरिः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]