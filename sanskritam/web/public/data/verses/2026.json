[{"id": 2046166, "chapter_id": 2026, "verse_number": "६-७५-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2046167, "chapter_id": 2026, "verse_number": "६-७५-१", "content_sanskrit": "विहृत्य तु ततो राजन्सहिताः कुरुपाण्डवाः ।\nव्यतीतायां तु शर्वर्यां पुनर्युद्धाय निर्ययुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2046168, "chapter_id": 2026, "verse_number": "६-७५-२", "content_sanskrit": "ततः शब्दो महानासीत्तव तेषां च भारत ।\nयुज्यतां रथमुख्यानां कल्प्यतां चैव दन्तिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2046169, "chapter_id": 2026, "verse_number": "६-७५-३", "content_sanskrit": "संनह्यतां पदातीनां हयानां चैव भारत।\nशङ्खदुन्दुभिनादश्च तुमुलः सर्वतोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2046170, "chapter_id": 2026, "verse_number": "६-७५-४", "content_sanskrit": "ततो युधिष्ठिरो राजा धृष्टद्युम्नमभाषत।\nव्यूहं व्यूहस्व पाञ्चाल मकरं शत्रुनाशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2046171, "chapter_id": 2026, "verse_number": "६-७५-५", "content_sanskrit": "एवमुक्तस्तु पार्थेन धृष्टद्युम्नो महारथः।\nव्यादिदेश यथान्यायं रथिनो रथिनां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2046172, "chapter_id": 2026, "verse_number": "६-७५-६", "content_sanskrit": "शिरोऽभूद्द्रुपदस्तस्य पाण्डवश्च धनञ्जयः।\nचक्षुषी सहदेवश्च नकुलश्च महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2046173, "chapter_id": 2026, "verse_number": "६-७५-७", "content_sanskrit": "तुण्डमासीन्महाराज भीमसेनो महाबलः ।\nसौभद्रो द्रौपदेयाश्च राक्षसश्च घटोत्कचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2046174, "chapter_id": 2026, "verse_number": "६-७५-८", "content_sanskrit": "सात्यकिर्धर्मराजश्च व्यूहग्रीवां समास्थिताः ।\nपृष्ठमासीन्महाराज विराटो वाहिनीपतिः ॥ ६-७५-९aधृष्टद्युम्नो महाराज महत्या सेनया वृतः ।\nकेकया भ्रातरः पञ्च वामपार्श्वं समाश्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2046175, "chapter_id": 2026, "verse_number": "६-७५-१०", "content_sanskrit": "धृष्टकेतुर्नरव्याघ्रश्चेकितानश्च वीर्यवान्।\nदक्षिणं पक्षमाश्रित्य स्थितौ व्यूहस्य रक्षणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2046176, "chapter_id": 2026, "verse_number": "६-७५-११", "content_sanskrit": "पादयोस्तु महाराज स्थितः श्रीमान्महारथः।\nकुन्तिभोजः शतानीको महत्या सेनया वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2046177, "chapter_id": 2026, "verse_number": "६-७५-१२", "content_sanskrit": "शिखण्डी तु महेष्वासः सोमकैः संवृतो बली ।\nइरावांश्च ततः पुच्छे मकरस्य व्यवस्थितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2046178, "chapter_id": 2026, "verse_number": "६-७५-१३", "content_sanskrit": "एवमेतं महाव्यूहं व्यूह्य भारत पाण़्डवाः ।\nसूर्योदये महाराज पुनर्युद्धाय दंशिताःक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2046179, "chapter_id": 2026, "verse_number": "६-७५-१४", "content_sanskrit": "कौरवानभ्ययुस्तूर्णं हस्त्यश्वरथपत्तिभिः ।\nसमुच्छ्रितैर्ध्वजैश्छत्रैः शस्त्रैश्च विमलैः शितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2046180, "chapter_id": 2026, "verse_number": "६-७५-१५", "content_sanskrit": "व्यूढं दृष्ट्वा तु तत्सैन्यं पिता देवव्रतस्तव ।\nकौञ्चेन महता राजन्प्रत्यव्यूहत वाहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2046181, "chapter_id": 2026, "verse_number": "६-७५-१६", "content_sanskrit": "तस्य तुण्डे महेष्वासो भारद्वाजो व्यरोचत।\nअश्वत्थामा कृपश्चैव चक्षुरास्तां जनेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2046182, "chapter_id": 2026, "verse_number": "६-७५-१७", "content_sanskrit": "कृतवर्मा तु सहितः काम्भोजैरथ बाह्लिकैः ।\nशिरस्यासीन्नरश्रेष्ठः श्रेष्ठः सर्वधनुष्मताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2046183, "chapter_id": 2026, "verse_number": "६-७५-१८", "content_sanskrit": "ग्रीवायां शूरसेनश्च तव पुत्रश्च मारिष ।\nदुर्योधनो महाराज राजभिर्बहुभिर्वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2046184, "chapter_id": 2026, "verse_number": "६-७५-१९", "content_sanskrit": "प्राग्जोतिषस्तु सहितो मद्रसौवीरकेकयैः ।\nउरस्यभून्नरश्रेष्ठ महत्या सेनया वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2046185, "chapter_id": 2026, "verse_number": "६-७५-२०", "content_sanskrit": "पृष्ठे चास्तां महेष्वासावावन्त्यौ सपदानुगौः ।\nस्वसेनया च सहितः शुशर्मा प्रस्थलाधिपः ।\nवामं पक्षं समाश्रित्य दंशितः समवस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2046186, "chapter_id": 2026, "verse_number": "६-७५-२१", "content_sanskrit": "तुषारा यवनाश्चैव शकाश्च सह चूचुपैः ।\nदक्षिणं पक्षमाश्रित्य स्थिता व्यूहस्त भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2046187, "chapter_id": 2026, "verse_number": "६-७५-२२", "content_sanskrit": "श्रुतायुश्च शातायुश्च सौमदत्तिश्च मारिष ।\nव्यूहस्य जघने तस्थू रक्षमाणाः परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2046188, "chapter_id": 2026, "verse_number": "६-७५-२३", "content_sanskrit": "ततो युद्धाय संजग्मुः पाण्डवाः कौरवैः सह।\nसूर्योदये महाराज प्रावर्तत जनक्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2046189, "chapter_id": 2026, "verse_number": "६-७५-२४", "content_sanskrit": "प्रतीयू रथिनो नामान्नागाश्च रथिनो ययुः ।\nहयारोहान्रथारोहा रथिनश्चापि सादिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2046190, "chapter_id": 2026, "verse_number": "६-७५-२५", "content_sanskrit": "सादिनश्च हयान्राजन्रथिनश्च महारणे ।\nहस्त्यारोहान्हयारोहा रथिनः सादिनस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2046191, "chapter_id": 2026, "verse_number": "६-७५-२६", "content_sanskrit": "रथिनः पत्तिभिः सार्धं सादिनश्चापि पत्तिभिः ।\nअन्योन्यं समरे राजन्प्रत्यधावन्नमर्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2046192, "chapter_id": 2026, "verse_number": "६-७५-२७", "content_sanskrit": "भीमसेनार्जुनयमैर्गुप्ता चान्यैर्महारथैः ।\nशुशुभे पाण्डवी सेना नक्षत्रैरिव शर्वरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2046193, "chapter_id": 2026, "verse_number": "६-७५-२८", "content_sanskrit": "तथा भीष्मकृपद्रोणशल्यदुर्योधनादिभिः ।\nतवापि च बभौ सेना ग्रहैर्द्यौरिव संवृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2046194, "chapter_id": 2026, "verse_number": "६-७५-२९", "content_sanskrit": "भीमसेनस्तु कौन्तेयो द्रोणं दृष्ट्वा पराक्रमी ।\nअभ्ययाञ्जवनैरश्वैर्भारद्वाजस्य वाहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2046195, "chapter_id": 2026, "verse_number": "६-७५-३०", "content_sanskrit": "द्रोणास्तु समरे क्रुद्धो भीमं नवभिरायसैः ।\nविव्याध समरश्लाघी मर्माण्युद्दिष्य वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2046196, "chapter_id": 2026, "verse_number": "६-७५-३१", "content_sanskrit": "दृढाहतस्तो भीमो भारद्वाजस्य संयुगे।\nसारथिं प्रेषयामास यमस्य सदनं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2046197, "chapter_id": 2026, "verse_number": "६-७५-३२", "content_sanskrit": "स संगृह्य स्कवयं वाहान्भारद्वाजः प्रतापवान् ।\nव्यधमत्पाण्डवीं सेनां तूलराशिमिवानलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2046198, "chapter_id": 2026, "verse_number": "६-७५-३३", "content_sanskrit": "ते वद्यमाना द्रोणेन भीष्मेण च नरोत्तमाः ।\nसृञ्जयाः तावकं सैन्यं भीमार्जुनपरिक्षतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2046199, "chapter_id": 2026, "verse_number": "६-७५-३४", "content_sanskrit": "तथैव तावकं सैन्यं भीमार्जुनपरिक्षतम्।\nमुह्यते तत्रतत्रैव समदेव वराङ्गना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2046200, "chapter_id": 2026, "verse_number": "६-७५-३५", "content_sanskrit": "अभिद्येतां ततो व्यूहौ तस्मिन्वीरवरक्षये।\nआसीद्व्यतिकरो घोरस्तव तेषां च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2046201, "chapter_id": 2026, "verse_number": "६-७५-३६", "content_sanskrit": "तदद्भुतमपश्याम तावकानां परैः सह ।\nएकायनगताः सर्वे यदयुध्यन्त भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2046202, "chapter_id": 2026, "verse_number": "६-७५-३७", "content_sanskrit": "प्रतिसंवार्य चास्त्राणि तेऽन्योन्यस्य विशांपते ।\nयुयुधुः पाण्डवाश्चैव कौरवाश्च महाबलाः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2046203, "chapter_id": 2026, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि षष्ठदिवसयुद्धे पञ्चसप्ततितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]