  {
    "id": 20011385,
    "chapter_id": 6682,
    "verse_number": "10.29",
    "content_sanskrit": "ज्ञात्वा समाधिना सम्यगभ्यर्च्यार्ध्यादिभिश्च तम् । महामुनिरुवाचेत्थं प्रह्वमादृतविष्टरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
