  },
  {
    "id": 20011387,
    "chapter_id": 6682,
    "verse_number": "10.31",
    "content_sanskrit": "कच्चित्करोति साम्राज्यं गुरुस्ते परमेश्वरः । मित्रैस्सहोत्तमामात्यैः श्रितोत्कृष्टपुरोहितः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
