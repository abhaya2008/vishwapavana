    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20011388,
    "chapter_id": 6682,
    "verse_number": "10.32",
    "content_sanskrit": "राजवृन्दारकः कच्चिन्नृपनागैरुपास्यते । किंराजभिश्च नमितैः प्रतापेन युधिष्ठिरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20011389,
    "chapter_id": 6682,
    "verse_number": "10.33",
    "content_sanskrit": "मुनिमित्युक्तवन्तं तं प्रत्युवाच धनञ्जयः । पृष्टास्त्वयैवं भगवन् सर्वे कुशलिनो वयम् ॥",
    "padaccheda": "",
    "anvaya": "",
