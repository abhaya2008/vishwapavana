  {
    "id": 20011386,
    "chapter_id": 6682,
    "verse_number": "10.30",
    "content_sanskrit": "कच्चित्पूगकृतद्रव्या वर्धन्ते कुरवोऽधुना । कृतैः करिष्यमाणैश्च कार्यैरपि कृताकृतैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
