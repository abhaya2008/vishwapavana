  {
    "id": 20011383,
    "chapter_id": 6682,
    "verse_number": "10.27",
    "content_sanskrit": "भूतलीकृतमेरुञ्च विन्ध्याद्रिमृषिकुञ्जरम् । मुनिचन्दनमारूढं परमब्रह्मवर्चसम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
