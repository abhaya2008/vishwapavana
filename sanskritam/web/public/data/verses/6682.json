[
  {
    "id": 20011357,
    "chapter_id": 6682,
    "verse_number": "10.1",
    "content_sanskrit": "ततो दिदृक्षुः कलशोद्भवं मुनिञ्जगाम पार्थो मलयं महीधरम् । उपेयिवानैक्षत 'योऽधिमस्तकं तमुद्वहन्तं सितमेघचन्दनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20011358,
    "chapter_id": 6682,
    "verse_number": "10.2",
    "content_sanskrit": "वृतं भुजङ्गैरुपचन्दनं गतैस्सुचन्दनं दुर्दवपावकोष्मदम् । दधानमुद्यन्मणिकाञ्चनस्थलीमरीचिभिर्निस्तिमिरञ्च सर्वतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20011359,
    "chapter_id": 6682,
    "verse_number": "10.3",
    "content_sanskrit": "अतिक्षपाफुल्लसरोजमण्डलैस्सरोजिरन्वीतमुपत्यकागतैः । कुरङ्गयूथैरनुयूथपं द्रुतैर्युतं यथाकाममुपात्तशाद्वलैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20011360,
    "chapter_id": 6682,
    "verse_number": "10.4",
    "content_sanskrit": "अनुस्वभावं प्लवगैः प्लुतैश्श्रितं प्रतिद्रुमं पुष्पलसन्मधुव्रतम् । सरेणुपौष्पं पिबता रसं वृतद्विरेफवृन्देन मदेन कूजता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20011361,
    "chapter_id": 6682,
    "verse_number": "10.5",
    "content_sanskrit": "अनुप्रधानं मुनिभिस्समन्ततो गतैर्निषण्णैश्च युतं कृताश्रमैः । उपाहरद्भिः स्वयमेव सादरैश्शुभावृसीर्यावदुपागतातिथि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20011362,
    "chapter_id": 6682,
    "verse_number": "10.6",
    "content_sanskrit": "जलप्रतिप्राश्यकृतासुधारणैस्तपश्चरद्भिर्मुनिभिः क्वचिद्युतम् । क्वचिद्विपर्यक्षपरीति जल्पता गुहागृहे दिव्यजनेन दीव्यता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20011363,
    "chapter_id": 6682,
    "verse_number": "10.7",
    "content_sanskrit": "अपाब्जरागस्थलमग्निशङ्कया युतश्चरद्भिश्चबरीजनैः क्वचित् । परीन्द्रनीलाश्मतलञ्जलाशयभ्रमेण तेषामपरत्र दारकौः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20011364,
    "chapter_id": 6682,
    "verse_number": "10.8",
    "content_sanskrit": "प्राक्कृतपोवनमवाक्कृतपोवनप्रत्यगाश्रममुदक्कृतपोवनात् । रोपितद्रुमचयं मुनित्रजैः कीर्णभूतबलिभिर्बहिर्गुहम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20011365,
    "chapter_id": 6682,
    "verse_number": "10.9",
    "content_sanskrit": "आकर्णमाकृष्य धनुः क्षिपद्भिश्शरान् प्रतिद्वीप्यभिसूकरञ्च । पुलिन्दवृन्दैश्च गणानुयातैः परीतपादं मृगयासु सक्तैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20011366,
    "chapter_id": 6682,
    "verse_number": "10.10",
    "content_sanskrit": "अनुकुसुमितवल्लीवेष्टितानोकहालीप्रचलितमकरन्दामोदमत्तद्विरेफम् । अनुजलधि शरीरं मेघनीलं दधानं प्रतिफलिततयाब्धेर्वृद्धकल्लोलकल्पम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20011367,
    "chapter_id": 6682,
    "verse_number": "10.11",
    "content_sanskrit": "वहद्गु तिष्ठद्गु च याऽन्तरा तां दिनान्तसन्ध्यां गमयन्ति यत्र । मन्त्रं जपन्तं परमं मुनीन्द्राः परं वहन्तो हृदि देवताञ्च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20011368,
    "chapter_id": 6682,
    "verse_number": "10.12",
    "content_sanskrit": "मध्येसमुद्रं प्रतिबिंबितो यो विभाति तिष्ठन्निव सिन्धुमध्ये । यस्मात्सदा चन्दनविक्रयार्थं पारे समुद्रं वणिजः प्रयान्ति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20011369,
    "chapter_id": 6682,
    "verse_number": "10.13",
    "content_sanskrit": "सह स्ववंशप्रभवैर्महर्षिभिर्वने वने बह्वृषि यत्न तिष्ठति । विकन्मषं पञ्चनदादिमज्जनैशिशवैर्शनैर्गङ्गज्लैस्समाप्लुतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20011370,
    "chapter_id": 6682,
    "verse_number": "10.14",
    "content_sanskrit": "वहति सुमनोमार्गातीतानशेषदिशागतान् विटपपतितक्रीडत्पक्षिब्रजान् सुफलाश्रितान् । सुरभिसुमनःप्राप्तान् पादोद्भवान् परितस्तरूनविरलदलापन्नान् योऽलङ्कृतान्नवपल्लवैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20011371,
    "chapter_id": 6682,
    "verse_number": "10.15",
    "content_sanskrit": "खट्वारूढा ददति शरा यद्गुहागेहभाजस्तन्वङ्गीभ्यस्स्वयमुपहता वारुणीस्सामिपीताः । क्रान्तिं मासप्रमितशशिनः कान्तिभिस्सादयन्त्यो जायन्ते यास्सुरतकुशला सर्वराताभिरामाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20011372,
    "chapter_id": 6682,
    "verse_number": "10.16",
    "content_sanskrit": "लपन्तो मांसार्थं विदधति पुलिन्दा यदवनावसृग्धारारक्तास्समरनिपुणा बाणकलहम् । शितेषुच्छिन्नाङ्गप्रकुपितपरास्तेषु दलिताः करस्पृश्यो नॄणां शिरसि वसतां यस्य शशिभृत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20011373,
    "chapter_id": 6682,
    "verse_number": "10.17",
    "content_sanskrit": "प्रजग्धदध्योदनमध्वपूपबह्वन्नशालिप्रवरालयस्थाः । सजीवनाथस्वहितोग्रचेष्टास्सुदारुणा यत्र वसन्ति चोराः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20011374,
    "chapter_id": 6682,
    "verse_number": "10.18",
    "content_sanskrit": "तमारुह्याद्रीन्द्रं कलशजमुनेराश्रमपदं ततोऽपश्यत्पार्थः परममुनिभिर्निर्भवभयैः । वृतं दुःखापेतैरनवरतमर्चद्भिरतिथिव्रजं दूरात्प्राप्तं निगमनिपुणैर्यज्ञकुशलैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20011375,
    "chapter_id": 6682,
    "verse_number": "10.19",
    "content_sanskrit": "महीतलस्थातपशुष्कदर्भं महर्षिभिः पूर्णमतीर्थकाकैः । समाहृतार्हर्मुखजप्यमन्त्रैर्दुमैरण्येतिलकादिभिश्च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20011376,
    "chapter_id": 6682,
    "verse_number": "10.20",
    "content_sanskrit": "मध्याह्नकीर्णं बलिमाहरद्भिः कृतोरुकोलाहलमण्डजौघैः । शुभेऽजिरक्षोणितले कुरङ्गैस्ततस्थितैश्चुम्बिततापसाङ्गम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20011377,
    "chapter_id": 6682,
    "verse_number": "10.21",
    "content_sanskrit": "पटीयसां वेदविदामृषीणां न कर्म यस्मिन्नुदके विशीर्णम् । न यत्र पातेसमितश्शरीरी कश्चिद्बभूवावट कच्छपो वा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20011378,
    "chapter_id": 6682,
    "verse_number": "10.22",
    "content_sanskrit": "आयातासितमेकतत्वशरणं सर्वक्रतुष्विष्टिनं दृष्ट्वा यत्र जरन्महर्षिनिवहं हृष्टाः पुराणर्षयः । 'अचिंत्वा नवविष्टरादिभिरतिप्रह्लाददुर्निर्मलैस्स्वान्तैस्संभृतकेवलादरसुधासंपादितं भोजनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20011379,
    "chapter_id": 6682,
    "verse_number": "10.23",
    "content_sanskrit": "तेजस्विनं कनकवेत्रमयासनस्थं पूर्वाद्रिमस्तकलसत्तरुणार्कतुल्यम् । सप्तर्षिभिः परिवृतं भगवन्तमग्रे जम्भारिसूनुरथ कुंभभवं ददर्श ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20011380,
    "chapter_id": 6682,
    "verse_number": "10.24",
    "content_sanskrit": "पौर्वक्षमैरापरक्षमैरप्यौत्तरक्षमैर्महर्षिभिः । परिवारितमायातैर्दक्षिणक्षमाप्रियं नतैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
