  {
    "id": 20011382,
    "chapter_id": 6682,
    "verse_number": "10.26",
    "content_sanskrit": "दानवाधममातार्पिं वातापिं चाणकासुरम् । निर्दग्धवन्तं पीताब्धिजलं पापासुरान्तकम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
