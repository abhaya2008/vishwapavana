    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20011384,
    "chapter_id": 6682,
    "verse_number": "10.28",
    "content_sanskrit": "तं वीरपुरुषं दृष्ट्वा प्राप्तं मध्यमपाण्डवम् । अभ्यनन्दत् स पूर्वेर्षिः पूर्णचन्द्रमिवार्णवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
