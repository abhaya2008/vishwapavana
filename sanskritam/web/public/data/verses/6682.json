  },
  {
    "id": 20011390,
    "chapter_id": 6682,
    "verse_number": "10.34",
    "content_sanskrit": "कच्चित्पयः कतिपयं परिपीय तोयस्तोकं पुरा जलनिधेरिव तृप्यसि त्वम् । कच्चित्तवाश्रमपदे सरसं प्रभूतं गोधेनवः कवलयन्ति तृणप्रकाण्डम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20011391,
    "chapter_id": 6682,
    "verse_number": "10.35",
    "content_sanskrit": "दधति युवजरत्वं विद्ययैवात्र कच्चिन्नतु युवपलितत्वेनाश्रमे तावकीने । वदनभवयुवानो विप्रवध्वश्च कच्चित्तपसि युवजरत्यो वर्तमाना भवन्ति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20011392,
    "chapter_id": 6682,
    "verse_number": "10.36",
    "content_sanskrit": "वक्तव्यमधुरं भोज्यं खादुपानीयशीतलम् । आतिथ्यमातिथेयानां कच्चिद्वो भवति त्रयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20011393,
    "chapter_id": 6682,
    "verse_number": "10.37",
    "content_sanskrit": "वदन्तमित्यर्जुनमब्रवीन्मुनिस्सहाऽहमेभिः कुशली महर्षिभिः । अतस्त्वमातिथ्यमिदं जुषस्व मे तपस्समृद्ध्या विहितं विशालया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20011394,
    "chapter_id": 6682,
    "verse_number": "10.38",
    "content_sanskrit": "इत्थमुक्त्वा स कौन्तेयः नीलश्वेतविलोचनाम् । कुमारतापसीं पत्नीं लोपामुद्रां व्यलोकत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20011395,
    "chapter_id": 6682,
    "verse_number": "10.39",
    "content_sanskrit": "हृदयं सा तु विज्ञाय स्वस्य पत्युः पतिव्रता । कुमारपण्डितैस्सार्धं सदन्नान्युदपादयत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20011396,
    "chapter_id": 6682,
    "verse_number": "10.40",
    "content_sanskrit": "अन्नपानामृतैस्तत्त्र तृप्तस्सानुचरोऽर्जुनः । रेमे गोगर्भिणीः पश्यन् कबलीकृतशाद्वलाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20011397,
    "chapter_id": 6682,
    "verse_number": "10.41",
    "content_sanskrit": "उच्चावचान्नसम्पन्नां दृष्ट्वा खादतमोदताम् । अचित्रीयत बीभत्सुस्तामातिथ्यक्रियां मुनेः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20011398,
    "chapter_id": 6682,
    "verse_number": "10.42",
    "content_sanskrit": "ततस्स भुक्त्वा सुखितं महर्षिं गत्वा बभाषे नतपूर्वकायः । विलोक्यमानं प्रिययाऽर्धदृष्ट्या पार्श्वस्थया शिष्यसुतैः परीतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20011399,
    "chapter_id": 6682,
    "verse_number": "10.43",
    "content_sanskrit": "द्वितीयभिक्षाञ्च तृतीयभिक्षां भिक्षाकलोकाय सदा ददत्या । भिक्षातुरीयञ्च सहानया त्वं दिष्ट्या महर्षे जयसि स्वपत्न्या ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20011400,
    "chapter_id": 6682,
    "verse_number": "10.44",
    "content_sanskrit": "प्राप्तप्रमोदोऽस्मि सहस्व भृत्यैरद्याऽहमापन्नकुतूहलश्च । भुक्त्वातिपीयूषरसं त्वयेदं तपस्समृद्धया कृतमन्नजातम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20011401,
    "chapter_id": 6682,
    "verse_number": "10.45",
    "content_sanskrit": "अङ्के शयानस्तव मासजातस्त्यक्त्वा कुरङ्गो जननीसमीपम् । ईषत्पदस्सञ्चरणसमर्थो व्यनक्त्यसौ विश्वजनीनतां मे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20011402,
    "chapter_id": 6682,
    "verse_number": "10.46",
    "content_sanskrit": "मत्पूजकोऽभूर्भगवंस्त्वमद्य त्वत्पूजकत्वं न मया तु लब्धम् । इच्छन्ति ये सत्परिचारकत्वं सन्तो जनास्तत्परिचारका हि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20011403,
    "chapter_id": 6682,
    "verse_number": "10.47",
    "content_sanskrit": "महामुनीनां दमवत्तमस्त्वं विद्वत्तमः कान्ततमो महिष्ठः । त्वमुर्वशीनन्दनयोरुसुरष्योर्मैत्रावरुण्योर्भवसि द्वितीयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20011404,
    "chapter_id": 6682,
    "verse_number": "10.48",
    "content_sanskrit": "इति ब्रुवाणस्य धनञ्जयस्य विनीतताया भगवानगस्त्यः । तृप्तोऽस्य वक्तव्यमिदं बभाषे तस्योपकुर्वन् परितुष्य तस्य ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20011405,
    "chapter_id": 6682,
    "verse_number": "10.49",
    "content_sanskrit": "स्तवैरलं पूजितसज्जनानां स्थितस्थिते वर्त्मनि पार्थ तेषाम् । स्तुत्यैर्गुणश्रेष्ठ तया न युक्तं भवादृशैर्हि स्तवनं परेषाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20011406,
    "chapter_id": 6682,
    "verse_number": "10.50",
    "content_sanskrit": "निधेगुणानां पुरुहूतपुत्र द्युयोषितामर्हसि शायिकां त्वम् । रूपेण जेता मकरध्वजस्य शौर्येण शौरेरपि जायकस्त्वम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20011407,
    "chapter_id": 6682,
    "verse_number": "10.51",
    "content_sanskrit": "भृत्यैस्सह त्वं नखलेखकाद्यैः प्रविश्य विश्रम्य सुगेहमद्य । कुमन्दिरे नासितुमर्हसि त्वं बद्धे पलाशैरधिराजपुत्र ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20011408,
    "chapter_id": 6682,
    "verse_number": "10.52",
    "content_sanskrit": "इति प्रयुक्तो मुनिनेन्द्रसूनुर्मुने मदाज्ञापयसि त्वमद्य । अहं करिष्यामि तदित्युदीर्य तत्कल्पितं दिव्यगृहं विवेश ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20011409,
    "chapter_id": 6682,
    "verse_number": "10.53",
    "content_sanskrit": "तस्मिन् कणेहत्य विभूषणार्हैरङ्गानलङ्कृत्य पुरःस्थितैस्साः । भागीरथीसैकतसन्निकाशं पर्यङ्कमापाण्डुरमारुरोह ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20011410,
    "chapter_id": 6682,
    "verse_number": "10.54",
    "content_sanskrit": "अतीन्दुवक्त्रा निमुनिस्स संरता निरात्मगेहासुरलोकसुन्दरीः । उपस्थिताः प्रेमवतीर्विलोकयन्निनिन्द निःश्रेयसजन्म तत्सुखम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20011411,
    "chapter_id": 6682,
    "verse_number": "10.55",
    "content_sanskrit": "आरूढस्मरसञ्ज्वरा हृतधृतीविंश्राणितापाण्डुसत्ताम्बूलच्छदनास्सुनिर्मलतनूः प्राप्तास्स दिव्याङ्गनाः । सम्पूर्णेन्दुमुखीर्निमग्नविलसत्पद्मोपमात्मेक्षणास्सस्त्रीलाः परिरम्भरूढपुलकाः पर्यङ्कमारोपयत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20011412,
    "chapter_id": 6682,
    "verse_number": "10.56",
    "content_sanskrit": "स केशचूडां तपनीयकुण्डलां विकस्वरेन्दीवरपत्रलोचनाम् । श्लथाम्बरामस्तिमनोभवव्यथामुपस्थितां तत्र ददर्श मेनकाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20011413,
    "chapter_id": 6682,
    "verse_number": "10.57",
    "content_sanskrit": "प्रत्युत्थितो विरचिताञ्जलिरुत्तमाङ्गे देविमवन्दत पुरन्दरनन्दनस्ताम् । पप्रच्छ चागमनकारणमब्रवीत्सा रोमाञ्चिता 'पुलकितां परिरभ्य कान्तम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20011414,
    "chapter_id": 6682,
    "verse_number": "10.58",
    "content_sanskrit": "सोमार्धमौलिं समुपास्य सोमं स्त्रीभिस्सहासन्नदशाभिराभिः । पूर्वोत्तरस्या दिश आगताऽहं स्मृताऽधुनाऽगस्त्यमहर्षिणा तम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20011415,
    "chapter_id": 6682,
    "verse_number": "10.59",
    "content_sanskrit": "मुनिरथ सह लोपामुद्रया गच्छ भद्रे भवन इव शयानं मध्यमं पाण्डवेयम् । रमय च सकलाभिस्तं कलाभिः प्रवीणं परसुरवनिताभिस्साकमित्यब्रवीन्माम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20011416,
    "chapter_id": 6682,
    "verse_number": "10.60",
    "content_sanskrit": "इति ब्रुवाणा विनयात् पराङ्मुखं प्रसह्य सा तं परिषस्वजे प्रियम् । महामुनेर्मूर्ध्नि निधाय शासनं क्रमेण पार्थोऽप्यनुकूलतां ययौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20011417,
    "chapter_id": 6682,
    "verse_number": "10.61",
    "content_sanskrit": "अथ मेनकेन्द्रतनयौ रभसात् समरं रताह्वयमवर्तयताम् । सरसं कचाकचि नखानखि च स्तनवक्षसा घनतरं मिलता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20011418,
    "chapter_id": 6682,
    "verse_number": "10.62",
    "content_sanskrit": "तं मेनकाघनपयोधरमण्डलोरस्सम्मर्दभङ्गुरगुणच्युतहारयष्टिः । केशग्रहोन्नमितवक्त्रसुधारसज्ञा खेदाम्बुलुप्ततिलका रमयाञ्चकार ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20011419,
    "chapter_id": 6682,
    "verse_number": "10.63",
    "content_sanskrit": "क्लमश्लथत्कुन्तलबन्धमुक्तैर्विकासिभिः कल्पतरुप्रसूनैः । विशीर्णहारावलिमौक्तिकैश्च प्रियस्य सा भूषयति स्म वक्षः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20011420,
    "chapter_id": 6682,
    "verse_number": "10.64",
    "content_sanskrit": "दरपरिमृदिताधरप्रवालां रचितपयोधरमण्डलां नखाङ्कैः । अरमयदुत बाहुमध्यलुप्तस्तनतटचन्दनकर्दमां स ताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20011421,
    "chapter_id": 6682,
    "verse_number": "10.65",
    "content_sanskrit": "सरभसपरिरम्भस्फीतरोमाञ्चपङ्क्तिः श्लथदधरदुकूलाश्चुम्बितास्येन्दुबिम्बाः । नवनखपदराजिप्रेक्ष्यवक्षोजपृष्ठास्स सुरपुरपुरन्ध्रीर्निर्विशेषाऽपराश्च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20011422,
