[{"id": 2071727, "chapter_id": 2513, "verse_number": "१२-१८-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2071728, "chapter_id": 2513, "verse_number": "१२-१८-१", "content_sanskrit": "तूष्णींभूतं तु राजानं पुनरेवार्जुनोऽब्रवीत्।\nसंतप्तः शोकदुःखाभ्यां राजवाक्शल्यपीडितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2071729, "chapter_id": 2513, "verse_number": "१२-१८-२x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2071730, "chapter_id": 2513, "verse_number": "१२-१८-२", "content_sanskrit": "कथयन्ति पुरावृत्तमितिहासमिमं जनाः।\nविदेहराज्ञः संवादं भार्यया सह भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2071731, "chapter_id": 2513, "verse_number": "१२-१८-३", "content_sanskrit": "उत्सृज्य राज्यं भिक्षार्थं कृतबुद्धिं नरेश्वरम्।\nविदेहराजमहीषी दुःखिता प्रत्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2071732, "chapter_id": 2513, "verse_number": "१२-१८-४", "content_sanskrit": "धनान्यपत्यं मित्राणि रत्नानि विविधानि च।\nपन्थानं पावनं हित्वा जनको मौढ्यमास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2071733, "chapter_id": 2513, "verse_number": "१२-१८-५", "content_sanskrit": "तं ददर्श प्रिया भार्या भैक्षवृत्तिमकिंचनम्।\nधानामुष्टिमुपासीनं निरीहं गतमत्सरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2071734, "chapter_id": 2513, "verse_number": "१२-१८-६", "content_sanskrit": "तमुवाच समामत्य भर्तारमकुतोभयम्।\nक्रुद्धा मनस्विनी भार्या विविक्ते हेतुमद्वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2071735, "chapter_id": 2513, "verse_number": "१२-१८-७", "content_sanskrit": "कथमुत्सृज्य राज्यं स्वं धनधान्यसमन्वितम्।\nकापालीं वृत्तिमास्थाय धान्यमुष्टिमुपाससे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2071736, "chapter_id": 2513, "verse_number": "१२-१८-८", "content_sanskrit": "प्रतिज्ञा तेऽन्यथा राजन्विचेष्टा चान्यथा तव।\nयद्राज्यं महदुत्सृज्य स्वल्पे लुभ्यसि पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2071737, "chapter_id": 2513, "verse_number": "१२-१८-९", "content_sanskrit": "नैतेनातिथयो राजन्देवर्षिपितरस्तथा।\nअद्य शक्यास्त्वया भर्तुं मोघस्तेऽयं परिश्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2071738, "chapter_id": 2513, "verse_number": "१२-१८-१०", "content_sanskrit": "देवतातिथिभिश्चैव पितृभिश्चैव पार्थिव।\nसर्वैरेतैः परित्यक्तः परिव्रजसि निष्क्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2071739, "chapter_id": 2513, "verse_number": "१२-१८-११", "content_sanskrit": "यस्त्वं त्रैविद्यवृद्धानां ब्राह्मणानां सहस्रशः।\nभर्ता भूत्वा च लोकस्य सोऽद्यान्यैर्भूतिमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2071740, "chapter_id": 2513, "verse_number": "१२-१८-१२", "content_sanskrit": "श्रियं हित्वा प्रदीप्तां त्वं श्ववत्संप्रति वीक्ष्यसे।\nअपुत्रा जननी तेऽद्य कौसल्या चापतिस्त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2071741, "chapter_id": 2513, "verse_number": "१२-१८-१३", "content_sanskrit": "आश्रिता धर्मकामास्त्वां क्षत्रियाः पर्युपासते।\nत्वदाशामभिकाङ्क्षन्तः कृपणाः फलहेतुकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2071742, "chapter_id": 2513, "verse_number": "१२-१८-१४", "content_sanskrit": "तांश्च त्वं विफलान्कृत्वा कं नु लोकं गमिष्यसि।\nराजन्संशयिते मोक्षे परतन्त्रेषु देहिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2071743, "chapter_id": 2513, "verse_number": "१२-१८-१५", "content_sanskrit": "नैव तेऽस्ति परो लोको नापरः पापकर्मणः।\nधर्म्यान्दारान्परित्यज्य यस्त्वमिच्छसि जीवितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2071744, "chapter_id": 2513, "verse_number": "१२-१८-१६", "content_sanskrit": "स्रजो गन्धानलंकारान्वासांसि विविधानि च।\nकिमर्थमभिसंत्यज्य परिव्रजसि निष्क्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2071745, "chapter_id": 2513, "verse_number": "१२-१८-१७", "content_sanskrit": "निपानं सर्वभूतानां भूत्वा त्वं पावनं महत।\nआढ्यो वनस्पतिर्भूत्वा सोन्यांस्त्वं पर्युपाससे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2071746, "chapter_id": 2513, "verse_number": "१२-१८-१८", "content_sanskrit": "खादन्ति हस्तिनं न्यासे क्रव्यादा बहवोऽप्युत।\nबहवः कृमयश्चैव किं पुनस्त्वामनर्थकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2071747, "chapter_id": 2513, "verse_number": "१२-१८-१९", "content_sanskrit": "य इमां कुण्डिकां भिन्द्यान्त्रिविष्टब्धं च यो हरेत्।\nवासश्चापि हरेत्तस्मिन्कथं ते मानसं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2071748, "chapter_id": 2513, "verse_number": "१२-१८-२०", "content_sanskrit": "यस्त्वं सर्वं समुत्सृज्य धानामुष्टिमनुग्रहः।\nयदनेन कृतं सर्वं किमिदं मम दीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2071749, "chapter_id": 2513, "verse_number": "१२-१८-२१", "content_sanskrit": "धानामुष्टेरिहार्थश्चेत्प्रतिज्ञा ते विनश्यति।\nका वाऽहं तव को मे त्वं कश्च ते मय्यनुग्रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2071750, "chapter_id": 2513, "verse_number": "१२-१८-२२", "content_sanskrit": "प्रशाधि पृथिवीं राजन्यत्र तेऽनुग्रहो भवेत्।\nप्रासादे शयनं यानं वासांस्याभरणानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2071751, "chapter_id": 2513, "verse_number": "१२-१८-२३", "content_sanskrit": "श्रियां निराशैरधनेस्त्यक्तमित्रैरकिंचनैः।\nसौखिकैः संभृतो योऽर्थः स संत्यजति किंनु तं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2071752, "chapter_id": 2513, "verse_number": "१२-१८-२४", "content_sanskrit": "योऽत्यन्तं प्रतिगृह्णीयाद्यश्च दद्यात्सदैव हि।\nतयोस्त्वमन्तरं विद्धि श्रेयांस्ताभ्यां क उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2071753, "chapter_id": 2513, "verse_number": "१२-१८-२५", "content_sanskrit": "सदैव याचमानेषु तथा दम्भान्वितेषु च।\nएतेषु दक्षिणा दत्ता दावाग्राविव दुर्हुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2071754, "chapter_id": 2513, "verse_number": "१२-१८-२६", "content_sanskrit": "जातवेदा यथा राजन्नादग्ध्वैवोपशाम्यति।\nसदैव याचमानो वै तथा शाम्यति न द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2071755, "chapter_id": 2513, "verse_number": "१२-१८-२७", "content_sanskrit": "सतां वै ददतोऽन्नं च लोकेऽस्मिन्प्रकृतिर्ध्रुवा।\nन चेद्राजा भवेद्दाता कुतः स्युर्मोक्षकाङ्क्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2071756, "chapter_id": 2513, "verse_number": "१२-१८-२८", "content_sanskrit": "अन्नाद्गृहस्था लोकेऽस्मिन्भिक्षवस्तत एव च।\nअन्नात्प्राणः प्रभवति अन्नदः प्राणदो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2071757, "chapter_id": 2513, "verse_number": "१२-१८-२९", "content_sanskrit": "गृहस्थेभ्योऽपि निर्मुक्ता गृहस्थानेव संश्रिताः।\nप्रभवं च प्रतिष्ठां च दान्ता विन्दन्त आसते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2071758, "chapter_id": 2513, "verse_number": "१२-१८-३०", "content_sanskrit": "त्यागान्न भिक्षुकं विन्द्यान्न मौढ्यान्न च याचनात्।\nऋजुस्तु योऽर्थं त्यजति तं मुक्तं विद्धि भिक्षुकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2071759, "chapter_id": 2513, "verse_number": "१२-१८-३१", "content_sanskrit": "असक्तः शक्तवद्गच्छन्निः सङ्गो मुक्तबन्धनः।\nसमः शत्रौ च मित्रे च स वै मुक्तो महीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2071760, "chapter_id": 2513, "verse_number": "१२-१८-३२", "content_sanskrit": "परिव्रजन्ति दानार्थं मुण्डाः काषायवाससः।\nसिता बहुविधैः पाशैः संचिन्वन्तो वृथामिषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2071761, "chapter_id": 2513, "verse_number": "१२-१८-३३", "content_sanskrit": "त्रयीं च नामवार्तां च त्यक्त्वा पुत्रान्व्रजन्ति ये।\nत्रिविष्टब्धं च वासश्च प्रतिगृह्णन्त्यबुद्धयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2071762, "chapter_id": 2513, "verse_number": "१२-१८-३४", "content_sanskrit": "अनिष्कषाये काषायमीहार्थमिति विद्धि तम्।\nधर्मध्वजानां मुण्डानां वृत्त्यर्थमिति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2071763, "chapter_id": 2513, "verse_number": "१२-१८-३५", "content_sanskrit": "काषायैरजिनैश्चीरैर्नग्नान्मुण्डाञ्जटाधरान्।\nबिभ्रत्साधून्महाराज जय लोकाञ्जितेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2071764, "chapter_id": 2513, "verse_number": "१२-१८-३६", "content_sanskrit": "अग्न्याधेयानि गुर्वर्थं क्रतूनपि सुदक्षिणान्।\nददात्यहरहः पूर्वं को नु धर्मरतस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2071765, "chapter_id": 2513, "verse_number": "१२-१८-३७x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2071766, "chapter_id": 2513, "verse_number": "१२-१८-३७", "content_sanskrit": "तत्त्वज्ञो जनको राजा लोकेऽस्मिन्निति गीयते।\nसोऽप्यासीन्मोहसंपन्नो मा मोहवशमन्वगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2071767, "chapter_id": 2513, "verse_number": "१२-१८-३८", "content_sanskrit": "एवं धर्ममनुक्रान्ता सदा दानतपः पराः।\nआनृशंस्यगुणोपेताः कामक्रोधविवर्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2071768, "chapter_id": 2513, "verse_number": "१२-१८-३९", "content_sanskrit": "प्रजानां पालने युक्ता दममुत्तममास्थिताः।\nइष्ट्वा लोकानवाप्स्यामो गुरुवृद्धोपचायिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2071769, "chapter_id": 2513, "verse_number": "१२-१८-४०", "content_sanskrit": "देवतातिथिभूतानां निर्वपन्तो यथाविधि।\nस्थानमिष्टमवाप्स्यामो ब्रह्मण्याः सत्यवादिनः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2071770, "chapter_id": 2513, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि अष्टादशोऽध्यायः॥ १८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]