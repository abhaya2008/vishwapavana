[{"id": 7000120000, "chapter_id": 20120, "verse_number": "१२०-१", "content_sanskrit": "अथ विंशत्यधिकशततमोऽध्यायः धान्यतीर्थवर्णनम् ब्रह्मोवाच धान्यतीर्थमिति ख्यातं सर्वकामप्रदं नृणाम् ।\nसुभिक्षं क्षंमदं पुंसां सर्वापद्विनिवारणम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000120001, "chapter_id": 20120, "verse_number": "१२०-२", "content_sanskrit": "ओषध्यः सोमराजानं पतिं प्राप्य मुदाऽन्विताः ।\nऊचुः सर्वस्य लोकस्य गङ्गायाश्चेप्सितं वचः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000120002, "chapter_id": 20120, "verse_number": "१२०-३", "content_sanskrit": "ओषध्य ऊचुः वैदिकी पुण्यगाथाऽस्ति यां वै वेदविदो विदुः ।\nभूमिं सस्यवतीं कश्चिन्मातरं मातृसंमिताम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000120003, "chapter_id": 20120, "verse_number": "१२०-४", "content_sanskrit": "गङ्गासमीपे यो दद्यात्सर्वकामानवाप्नुयात् ।\nभूमीं सस्यवतीं गाश्च ओषधीश्च मुदाऽन्वितः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000120004, "chapter_id": 20120, "verse_number": "१२०-५", "content_sanskrit": "विष्णुब्रह्मेशरूपाय यो दद्याद्भक्तिमान्नरः ।\nसर्वं तदक्षयं विद्यात्सर्वकामानवाप्नुयात् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000120005, "chapter_id": 20120, "verse_number": "१२०-६", "content_sanskrit": "ओषध्यः सोमराजन्याः सोमश्चाप्येषधीपतिः ।\nइति ज्ञात्वा ब्रह्मविद ओषधीर्यः प्रदास्यति ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000120006, "chapter_id": 20120, "verse_number": "१२०-७", "content_sanskrit": "सर्वान्कामानवाप्नोति ब्रह्मलोके महीयते ।\nता एव सोमराजन्याः प्रीताः प्रोचुः पुनः पुनः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000120007, "chapter_id": 20120, "verse_number": "१२०-८", "content_sanskrit": "ओषध्य ऊचुः योऽस्मान्ददाति गङ्गायां तं राजन्पारयामसि ।\nत्वमुत्तमश्चौषधीश त्वदधीनं चराचरम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000120008, "chapter_id": 20120, "verse_number": "१२०-९", "content_sanskrit": "ओषधयः संवदनते सोमेन सह राज्ञा ।\nयोऽस्मान्ददाति विप्रेभ्यस्तं राजन्पारयामसि ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000120009, "chapter_id": 20120, "verse_number": "१२०-१०", "content_sanskrit": "वयं च ब्रह्मरूपिण्यः प्राणरूपिण्य एव च ।\nयोऽस्मान्ददाति विप्रेभ्यस्तं राजन्पारयामसि ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000120010, "chapter_id": 20120, "verse_number": "१२०-११", "content_sanskrit": "अस्मान्ददाति यो नित्यं ब्राह्मणेभ्यो जितव्रतः ।\nउपास्तिरस्ति साऽस्माकं तं राजन्पारयामसि ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000120011, "chapter_id": 20120, "verse_number": "१२०-१२", "content_sanskrit": "स्थावरं जङ्गमं किंचिदस्माभिर्व्यापृतं जगत् ।\nयोऽस्मान्ददाति विप्रेभ्यस्तं राजान्पारयामसि ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000120012, "chapter_id": 20120, "verse_number": "१२०-१३", "content_sanskrit": "हव्यं कव्यं यदमृतं यत्किंचिदुपभुज्यते ।\nयद्गरीयश्च यो दद्यात्तं राजान्पारयामसि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000120013, "chapter_id": 20120, "verse_number": "१२०-१४", "content_sanskrit": "इत्येतां वैदिकीं गाथां यः शृणोति स्मरेत वा ।\nपठते भक्तिमापन्नस्तं राजन्पारयामसि ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000120014, "chapter_id": 20120, "verse_number": "१२०-१५", "content_sanskrit": "ब्रह्मोवाच यत्रैषा पठिता गाथा सोमेन सह राज्ञा ।\nगङ्गातीरे चोषधीभिर्धान्यतीर्थं तदुच्यते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000120015, "chapter_id": 20120, "verse_number": "१२०-१६", "content_sanskrit": "ततः प्रभृति तत्तीर्थमौषघ्यं सौम्यमेव च ।\nअमृतं वेदगाथं च मातृतीर्थं तथैव च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000120016, "chapter_id": 20120, "verse_number": "१२०-१७", "content_sanskrit": "एषु स्नानं जपो होमो दानं च पितृतर्पणम् ।\nअन्नदानं तु यः कुर्यात्तदानत्त्याय कल्पते ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000120017, "chapter_id": 20120, "verse_number": "१२०-१८", "content_sanskrit": "षट्शताधिकसाहस्रं तीर्थानां तीरयर्द्वयोः ।\nसर्वपापनिहन्तॄणां सर्वसंपद्विवर्धनम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]