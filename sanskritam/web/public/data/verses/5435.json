[{"id": 2207861, "chapter_id": 5435, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2207862, "chapter_id": 5435, "verse_number": "१", "content_sanskrit": "गन्धान् न जिघ्रामि रसान् न वेद्मि\nरूपं न पश्यामि न च स्पृशामि ।\nन चापि शब्दान् विविधान् शृणोमि\nन चापि सङ्कल्पमुपैमि कञ्चित्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2207863, "chapter_id": 5435, "verse_number": "२", "content_sanskrit": "अर्थानिष्टान् कामयते स्वभावः\nसर्वान् द्वेष्यान् द्वेष्टि चैव स्वभावः ।\nकामद्वेषावुद्भवतः स्वभावात्\nप्राणापानौ जन्तुदेहादिवैत्य\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2207864, "chapter_id": 5435, "verse_number": "३", "content_sanskrit": "तेभ्यश्चान्यांस्तेष्वनन्यांश्च भावान्\nभूतात्मानं लक्षयेऽहं शरीरे ।\nतस्मिंस्तिष्ठन् नास्ति शक्तः कथञ्चित्\nकामक्रोधाभ्यां जरया मृत्युना च\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2207865, "chapter_id": 5435, "verse_number": "४", "content_sanskrit": "अनिश्चितश्चैव हि सर्वकामान्\nअविद्विषाणस्य च सर्वदोषान् ।\nन मे स्वभावेषु भवन्ति लेपाः\nतोयस्य बिन्दोरिव पुष्करेषु\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2207866, "chapter_id": 5435, "verse_number": "५", "content_sanskrit": "निरस्य चैतस्य भवन्ति नित्या\nनिरीक्षमाणस्य बहुस्वभावान् ।\nन सज्जते कर्मसु भोगजालं\nदिवीव सूर्यस्य मयूखजालम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2207867, "chapter_id": 5435, "verse_number": "६", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nअध्वर्युयतिसंवादं तं निबोध यशस्विनि\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2207868, "chapter_id": 5435, "verse_number": "७", "content_sanskrit": "प्रोक्ष्यमाणं पशुं दृष्ट्वा यज्ञकर्मण्यथाब्रवीत् ।\nयतिरध्वर्युमासीनो हिंसेयमिति कुत्सयन्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2207869, "chapter_id": 5435, "verse_number": "८", "content_sanskrit": "तमध्वर्युः प्रत्युवाच नायं छागो विनश्यति ।\nश्रेयसा योक्ष्यते जन्तुः यज्ञस्तुतिरियं तथा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2207870, "chapter_id": 5435, "verse_number": "९", "content_sanskrit": "यो ह्यस्य पार्थिवो भावः पृथिवीं स गमिष्यति ।\nयदस्य वारिजं किञ्चिद् अपस्तत् प्रतिपद्यते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2207871, "chapter_id": 5435, "verse_number": "१०", "content_sanskrit": "सूर्यं चक्षुर्दिशं श्रोत्रे प्राणोऽस्य दिवमेव च ।\nआगमे वर्तमानस्य न मे दोषोऽस्ति कश्चन\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2207872, "chapter_id": 5435, "verse_number": "", "content_sanskrit": "यतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2207873, "chapter_id": 5435, "verse_number": "११", "content_sanskrit": "प्राणैर्वियोगे च्छागस्य यदि श्रेयः प्रपश्यति ।\nछागार्थे वर्तते यज्ञो भवतः किं प्रयोजनम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2207874, "chapter_id": 5435, "verse_number": "१२", "content_sanskrit": "अनु त्वां मन्यते माता अनु त्वां मन्यते पिता ।\nमन्त्रमस्यैवमुन्नीय परवन्तं विशेषतः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2207875, "chapter_id": 5435, "verse_number": "१३", "content_sanskrit": "य एवमनुमन्येरन् तान् भवान् प्रष्टुमर्हति ।\nतेषामनुमतिं श्रुत्वा शक्या कर्तुं विचारणा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2207876, "chapter_id": 5435, "verse_number": "", "content_sanskrit": "अध्वर्युः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2207877, "chapter_id": 5435, "verse_number": "१४", "content_sanskrit": "प्राणा अप्यस्य च्छागस्य प्रापितास्ते स्वयोनिषु ।\nशरीरं केवलं शिष्टं निश्चेष्टमिति मे मतिः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2207878, "chapter_id": 5435, "verse_number": "", "content_sanskrit": "यतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2207879, "chapter_id": 5435, "verse_number": "१५", "content_sanskrit": "इन्धनस्य तु तुल्येन शरीरेण विचेतसा ।\nहिंसां निर्वेष्टुकामानामिन्धनं पशुसञ्ज्ञितम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2207880, "chapter_id": 5435, "verse_number": "१६", "content_sanskrit": "अहिंसा सर्वभूतानामिति वृद्धानुशासनम् ।\nयदहिंस्रं भवेत् कर्म तत् कार्यमिति विद्महे\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2207881, "chapter_id": 5435, "verse_number": "१७", "content_sanskrit": "अहिंसेति प्रतिज्ञेयं यदि वक्ष्याम्यतः परम् ।\nशक्यं बहुविधं वक्तुं भवतः कार्यदूषणम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2207882, "chapter_id": 5435, "verse_number": "१८", "content_sanskrit": "अहिंसा सर्वभूतानामस्मभ्यं रोचते सदा ।\nप्रत्यक्षतः साधयामो न परोक्षमुपास्महे\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2207883, "chapter_id": 5435, "verse_number": "", "content_sanskrit": "अध्वर्युः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2207884, "chapter_id": 5435, "verse_number": "१९", "content_sanskrit": "भूमेर्गन्धगुणान् भुङ्क्षे पिबस्यापोमयान् रसान् ।\nज्योतिषामीक्षसे रूपं स्पृशस्यनिलजान् गुणान्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2207885, "chapter_id": 5435, "verse_number": "२०", "content_sanskrit": "शृणोष्याकाशजं शब्दं मनसा मन्यसे मतिम् ।\nसर्वाण्येतानि भूतानि प्राणा इति च मन्यसे\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2207886, "chapter_id": 5435, "verse_number": "२१", "content_sanskrit": "प्राणादाने निवृत्तोसि हिंसायां वर्तते भवान् ।\nनास्ति चेष्टा विना हिंसा किं वा त्वं मन्यसे द्विज\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2207887, "chapter_id": 5435, "verse_number": "", "content_sanskrit": "यतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2207888, "chapter_id": 5435, "verse_number": "२२", "content_sanskrit": "अक्षरं च क्षरं चैव द्वैधीभावोऽयमात्मनः ।\nअक्षरं तत्र तद्भावः स्वभावः क्षर उच्यते\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2207889, "chapter_id": 5435, "verse_number": "२३", "content_sanskrit": "घ्राणं जिह्वा मनः सत्त्वं स्वभावो राजसो गुणः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2207890, "chapter_id": 5435, "verse_number": "२४", "content_sanskrit": "भावैरेतैर्वियुक्तस्य निर्द्वन्द्वस्य निराशिषः ।\nसमस्य सर्वभूतेषु निर्ममस्य जितात्मनः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2207891, "chapter_id": 5435, "verse_number": "२५", "content_sanskrit": "समन्तात् परिमुक्तस्य न भयं विद्यते क्वचित्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2207892, "chapter_id": 5435, "verse_number": "", "content_sanskrit": "अध्वर्युः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2207893, "chapter_id": 5435, "verse_number": "२६", "content_sanskrit": "सद्भिरेवेह संवासः कार्यो मतिमतां वर ।\nभवतां कथितं श्रुत्वा प्रतिभाति मतिर्मम\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2207894, "chapter_id": 5435, "verse_number": "२७", "content_sanskrit": "भगवन् भगवद् बुद्ध्या प्रतिबुद्धो ब्रवीम्यहम् ।\nमतं मन्तुः क्रतुः कर्तुः नापराधोऽस्ति मे द्विज\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2207895, "chapter_id": 5435, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2207896, "chapter_id": 5435, "verse_number": "२८", "content_sanskrit": "उपपत्त्या यतिस्तूष्णीं वर्तमानस्ततः परम् ।\nअध्वर्युरपि निर्मोहः प्रचचार महामखे\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2207897, "chapter_id": 5435, "verse_number": "२९", "content_sanskrit": "एवमेतादृशं मोक्षं सुसूक्ष्मं ब्राह्मणा विदुः ।\nविदित्वा चानुतिष्ठन्ति क्षेत्रज्ञेनानुदर्शिना\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2207898, "chapter_id": 5435, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि अनुगीतासु यति अध्वर्युसंवादो नाम एकोनत्रिंशोऽध्यायः ॥२९॥\nअनुगीतापर्वणि चतुर्दशोऽध्यायः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]