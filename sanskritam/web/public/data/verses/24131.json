[{"id": 7004131000, "chapter_id": 24131, "verse_number": "४-८०-१", "content_sanskrit": "स्कंद उवाच ।\nकुंभोद्भूत तदाश्चर्यं विलोक्य जगदंबिका ।\nउवाच शंभुं प्रणता प्रणतार्तिहरं परम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004131001, "chapter_id": 24131, "verse_number": "४-८०-२", "content_sanskrit": "अंबिकोवाच ।\nअस्य पीठस्य माहात्म्यं महादेव महेश्वर ।\nतिरश्चामपि यज्जातं ज्ञानं संसारमोचनम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004131002, "chapter_id": 24131, "verse_number": "४-८०-३", "content_sanskrit": "अतः प्रभावं विज्ञाय धर्मपीठस्य धूर्जटे ।\nधर्मेश्वरसमीपेहं स्थास्याम्यद्य दिनावधि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004131003, "chapter_id": 24131, "verse_number": "४-८०-४", "content_sanskrit": "अत्र लिंगे तु ये भक्ताः स्त्रियो वा पुरुषास्तु वा ।\nतेषामभीष्टां संसिद्धिं साधयिष्याम्यहं सदा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004131004, "chapter_id": 24131, "verse_number": "४-८०-५", "content_sanskrit": "ईश्वर उवाच ।\nसाधुकृतं त्वया देवि कृतवत्या परिग्रहम् ।\nअस्येह धर्मपीठस्य मनोरथकृतः सताम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004131005, "chapter_id": 24131, "verse_number": "४-८०-६", "content_sanskrit": "त एव विश्वभोक्तारो विश्वमान्यास्त एव हि ।\nये त्वां विश्वभुजामत्र पूजयिष्यंति मानवाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004131006, "chapter_id": 24131, "verse_number": "४-८०-७", "content_sanskrit": "विश्वे विश्वभुजे विश्वस्थित्युत्पत्तिलयप्रदे ।\nनरास्त्वदर्चकाश्चात्र भविष्यंत्यमलात्मकाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004131007, "chapter_id": 24131, "verse_number": "४-८०-८", "content_sanskrit": "मनोरथतृतीयायां यस्ते भक्तिं विधास्यति ।\nतन्मनोरथसंसिद्धिर्भवित्री मदनुग्रहात् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004131008, "chapter_id": 24131, "verse_number": "४-८०-९", "content_sanskrit": "नारी वा पुरुषो वाथ त्वद्व्रताचरणात्प्रिये ।\nमनोरथानिह प्राप्य ज्ञानमंते च लप्स्यते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004131009, "chapter_id": 24131, "verse_number": "४-८०-१०", "content_sanskrit": "देव्युवाच ।\nमनोरथतृतीयायां व्रतं कीदृक्कथा कथम् ।\nकिं फलं कैः कृतं नाथ कथयैतत्कृपां कुरु ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004131010, "chapter_id": 24131, "verse_number": "४-८०-११", "content_sanskrit": "ईश्वर उवाच ।\nशृणु देवि यथा पृष्टं भवत्या भवतारिणि ।\nमनोरथव्रतं चैतद्गुह्याद्गुह्यतरं परम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004131011, "chapter_id": 24131, "verse_number": "४-८०-१२", "content_sanskrit": "पुलोमतनया पूर्वं तताप परमं तपः ।\nकिंचिन्मनोरथं प्राप्तुं न चाप तपसः फलम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004131012, "chapter_id": 24131, "verse_number": "४-८०-१३", "content_sanskrit": "अपूपुजत्ततो मां सा भक्त्या परमया मुदा ।\nगीतेन सरहस्येन कलकंठीकलेन हि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004131013, "chapter_id": 24131, "verse_number": "४-८०-१४", "content_sanskrit": "तद्गानेनातिसंतुष्टो मृदुना मधुरेण च ।\nसुतालेन सुरंगेण धातुमात्राकलावता ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004131014, "chapter_id": 24131, "verse_number": "४-८०-१५", "content_sanskrit": "प्रोवाच तां वरं ब्रूहि प्रसन्नोस्मि पुलोमजे ।\nअनेन च सुगीतेन त्वनया लिंगपूजया ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004131015, "chapter_id": 24131, "verse_number": "४-८०-१६", "content_sanskrit": "पुलोमजोवाच ।\nयदि प्रसन्नो देवेश तदा यो मे मनोरथः ।\nतं पूरय महादेव महादेवी महाप्रिय ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004131016, "chapter_id": 24131, "verse_number": "४-८०-१७", "content_sanskrit": "सर्वदेवेषु यो मान्यः सर्वदेवेषु सुंदरः ।\nयायजूकेषु सर्वेषु यः श्रेष्ठः सोस्तु मे पतिः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004131017, "chapter_id": 24131, "verse_number": "४-८०-१८", "content_sanskrit": "यथाभिलषितं रूपं यथाभिलषितं सुखम् ।\nयथाभिलषितं चायुः प्रसन्नो देहि मे भव ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004131018, "chapter_id": 24131, "verse_number": "४-८०-१९", "content_sanskrit": "यदायदा च पत्या मे संगः स्याद्धृत्सुखेच्छया ।\nतदातदा च तं देहं त्यक्त्वान्यं देहमाप्नुयाम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004131019, "chapter_id": 24131, "verse_number": "४-८०-२०", "content_sanskrit": "सदा च लिंगपूजायां मम भक्तिरनुत्तमा ।\nभव भूयाद्भवहर जरामरणहारिणी ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004131020, "chapter_id": 24131, "verse_number": "४-८०-२१", "content_sanskrit": "भर्तुर्व्ययेपि वैधव्यं क्षणमात्रमपीह न ।\nमम भावि महादेव पातिव्रत्यं च यातु मा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004131021, "chapter_id": 24131, "verse_number": "४-८०-२२", "content_sanskrit": "स्कंद उवाच ।\nइमं मनोरथं तस्याः पौलोम्याः पुरसूदनः ।\nसमाकर्ण्य क्षणं स्मित्वा प्राहेशो विस्मयान्वितः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004131022, "chapter_id": 24131, "verse_number": "४-८०-२३", "content_sanskrit": "ईश्वर उवाच ।\nपुलोमकन्ये यश्चैष त्वयाकारि मनोरथः ।\nलप्स्यसे व्रतचर्यातस्तत्कुरुष्व जितेंद्रिये ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004131023, "chapter_id": 24131, "verse_number": "४-८०-२४", "content_sanskrit": "मनोरथतृतीयायाश्चरणेन भविष्यति ।\nतत्प्राप्तये व्रतं वक्ष्ये तद्विधेहि यथोदितम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004131024, "chapter_id": 24131, "verse_number": "४-८०-२५", "content_sanskrit": "तेन व्रतेन चीर्णेन महासौभाग्यदेन तु ।\nअवश्यं भविता बाले तव चैवं मनोरथः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004131025, "chapter_id": 24131, "verse_number": "४-८०-२६", "content_sanskrit": "पुलोमकन्यावोच ।\nकारुण्यवारिधे शंभो प्रणतप्राणि सर्वद ।\nकिमात्मिकाथ का शक्तिः का पूज्या तत्र देवता ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004131026, "chapter_id": 24131, "verse_number": "४-८०-२७", "content_sanskrit": "कदा च तद्विधातव्यमिति कर्तव्यता च का ।\nइत्याकर्ण्य शिवो वाक्यं तां तु प्रणिजगाद ह ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004131027, "chapter_id": 24131, "verse_number": "४-८०-२८", "content_sanskrit": "ईश्वर उवाच ।\nमनोरथतृतीयायां व्रतं पौलोमि तच्छुभम् ।\nपूज्या विश्वभुजा गौरी भुजविंशतिशालिनी ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004131028, "chapter_id": 24131, "verse_number": "४-८०-२९", "content_sanskrit": "वरदोऽभयहस्तश्च साक्षसूत्रः समोदकः ।\nदेव्याः पुरस्ताद्व्रतिना पूज्य आशाविनायकः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004131029, "chapter_id": 24131, "verse_number": "४-८०-३०", "content_sanskrit": "चैत्रशुक्ल तृतीयायां कृत्वा वै दंतधावनम् ।\nसायंतनीं च निर्वर्त्य नातितृप्त्या भुजिक्रियाम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004131030, "chapter_id": 24131, "verse_number": "४-८०-३१", "content_sanskrit": "नियमं चेति गृह्णीयाज्जितक्रोधो जितेंद्रियः ।\nसंत्यक्तास्पृश्य संस्पर्शः शुचिस्तद्गतमानसः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004131031, "chapter_id": 24131, "verse_number": "४-८०-३२", "content_sanskrit": "प्रातर्व्रतं चरिष्यामि मातर्विश्वभुजेनघे ।\nविधेहि तत्र सांनिध्यं मन्मनोरथसिद्धये ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004131032, "chapter_id": 24131, "verse_number": "४-८०-३३", "content_sanskrit": "नियमं चेति संगृह्य स्वपेद्रात्रौ शुभं स्मरन् ।\nप्रातरुत्थाय मेधावी विधायावश्यकं विधिम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004131033, "chapter_id": 24131, "verse_number": "४-८०-३४", "content_sanskrit": "शौचमाचमनं कृत्वा दंतकाष्ठं समाददेत् ।\nअशोकवृक्षस्य शुभं सर्वशोकनिशातनम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004131034, "chapter_id": 24131, "verse_number": "४-८०-३५", "content_sanskrit": "नित्यंतनं च निष्पाद्य विधिं विधिविदांवरः ।\nस्नात्वा शुद्धांबरः सायं गौरीपूजां समाचरेत् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004131035, "chapter_id": 24131, "verse_number": "४-८०-३६", "content_sanskrit": "आदौ विनायकं पूज्य घृतपूरान्निवेद्य च ।\nततोर्चयेद्विश्वभुजामशोककुसुमैः शुभैः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004131036, "chapter_id": 24131, "verse_number": "४-८०-३७", "content_sanskrit": "अशोकवर्तिनैवेद्यैर्धूपैश्चागुरुसंभवैः ।\nकुंकुमेनानुलिप्यादावेकभक्तं ततश्चरेत् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004131037, "chapter_id": 24131, "verse_number": "४-८०-३८", "content_sanskrit": "अशोकवर्तिसहितैर्घृतपूरैर्मनोहरैः ।\nएवं चैत्रतृतीयायां व्यतीतायां पुलोमजे ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004131038, "chapter_id": 24131, "verse_number": "४-८०-३९", "content_sanskrit": "राधादिफाल्गुनांतासु तृतीयासु व्रतं चरेत् ।\nक्रमेण दंतकाष्ठानि कथयामि तवानघे ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004131039, "chapter_id": 24131, "verse_number": "४-८०-४०", "content_sanskrit": "अनुलेपनवस्तूनि कुसुमानि तथैव च ।\nनैवेद्यानि गजास्यस्य देव्याश्चापि शुभव्रते ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004131040, "chapter_id": 24131, "verse_number": "४-८०-४१", "content_sanskrit": "अन्नानि चैकभक्तस्य शृणुतानि फलाप्तये ।\nजंब्वपामार्ग खदिर जाती चूतकदंबकम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004131041, "chapter_id": 24131, "verse_number": "४-८०-४२", "content_sanskrit": "प्लक्षोदुंबरखर्जूरी बीजपूरी सदाडिमी ।\nदंतकाष्ठ द्रुमा एते व्रतिनः समुदाहृताः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004131042, "chapter_id": 24131, "verse_number": "४-८०-४३", "content_sanskrit": "सिंदूरागुरु कस्तूरी चंदनं रक्तचंदनम् ।\nगोरोचना देवदारु पद्माक्षं च निशाद्वयम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004131043, "chapter_id": 24131, "verse_number": "४-८०-४४", "content_sanskrit": "प्रीत्यानुलेपनं बाले यक्षकर्दमसंभवम् ।\nसर्वेषामप्यलाभे च प्रशस्तो यक्षकर्दमः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004131044, "chapter_id": 24131, "verse_number": "४-८०-४५", "content_sanskrit": "कस्तूरिकाया द्वौ भागौ द्वौ भागौ कुंकुमस्य च ।\nचंदनस्य त्रयो भागाः शशिनस्त्वेक एव हि ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004131045, "chapter_id": 24131, "verse_number": "४-८०-४६", "content_sanskrit": "यक्षकर्दम इत्येष समस्तसुरवल्लभः ।\nअनुलिप्याथ कुसुमैरर्चयेद्वच्मि तान्यपि ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004131046, "chapter_id": 24131, "verse_number": "४-८०-४७", "content_sanskrit": "पाटला मल्लिका पद्म केतकी करवीरकः ।\nउत्पलै राजचंपैश्च नंद्यावर्तैश्च जातिभिः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004131047, "chapter_id": 24131, "verse_number": "४-८०-४८", "content_sanskrit": "कुमारीभिः कर्णिकारैरलाभेतच्छदैः सह ।\nसुगंधिभिः प्रसूनोघैः सर्वालाभेपि पूजयेत् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004131048, "chapter_id": 24131, "verse_number": "४-८०-४९", "content_sanskrit": "करंभो दधिभक्तं च सचूतरसमंडकाः ।\nफेणिका वटकाश्चैव पायसं च सशर्करम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004131049, "chapter_id": 24131, "verse_number": "४-८०-५०", "content_sanskrit": "समुद्गं सघृतं भक्तं कार्त्तिके विनिवेदयेत् ।\nइंडेरिकाश्च लड्डूका माघे लंपसिका शुभा ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004131050, "chapter_id": 24131, "verse_number": "४-८०-५१", "content_sanskrit": "मुष्टिकाः शर्करागर्भाः सर्पिषा परिसाधिताः ।\nनिवेद्याः फाल्गुने देव्यै सार्धं विघ्नजिता मुदा ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004131051, "chapter_id": 24131, "verse_number": "४-८०-५२", "content_sanskrit": "निवेदयेद्यदन्नं हि एकभक्तपि तत्स्मृतम् ।\nअन्यन्निवेद्य संमूढो भुंजानोऽन्यत्पतेदधः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004131052, "chapter_id": 24131, "verse_number": "४-८०-५३", "content_sanskrit": "प्रतिमासं तृतीयायामेवमाराध्य वत्सरम् ।\nव्रतसंपूर्तये कुर्यात्स्थंडिलेऽग्निसमर्चनम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004131053, "chapter_id": 24131, "verse_number": "४-८०-५४", "content_sanskrit": "जातवेदसमंत्रेण तिलाज्यद्रविणेन च ।\nशतमष्टाधिकं होमं कारयेद्विधिना व्रती ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004131054, "chapter_id": 24131, "verse_number": "४-८०-५५", "content_sanskrit": "सदैव नक्ते पूजोक्ता सदा नक्ते तु भोजनम् ।\nनक्त एव हि होमोऽयं नक्त एव क्षमापनम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004131055, "chapter_id": 24131, "verse_number": "४-८०-५६", "content_sanskrit": "गृहाण पूजां मे भक्त्या मातर्विघ्नजिता सह ।\nनमोस्तु ते विश्वभुजे पूरयाशु मनोरथम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004131056, "chapter_id": 24131, "verse_number": "४-८०-५७", "content_sanskrit": "नमो विघ्नकृते तुभ्यं नम आशाविनायक ।\nत्वं विश्वभुजया सार्धं मम देहि मनोरथम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004131057, "chapter_id": 24131, "verse_number": "४-८०-५८", "content_sanskrit": "एतौ मंत्रौ समुच्चार्य पूज्या गौरीविनायकौ ।\nव्रतक्षमापने देयः पर्यंकस्तूलिकान्वितः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004131058, "chapter_id": 24131, "verse_number": "४-८०-५९", "content_sanskrit": "उपधान्या समायुक्तो दीपीदपर्णसंयुतः ।\nआचार्यं च सपत्नीकं पर्यंक उपवेश्य च ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004131059, "chapter_id": 24131, "verse_number": "४-८०-६०", "content_sanskrit": "व्रती समर्चयेद्वस्त्रैः करकर्णविभूषणैः ।\nसुगंधचंदनैर्माल्यैर्दक्षिणाभिर्मुदान्वितः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004131060, "chapter_id": 24131, "verse_number": "४-८०-६१", "content_sanskrit": "दद्यात्पयस्विनीं गां च व्रतस्यपरिपूर्तये ।\nतथोपभोगवस्तूनिच्छत्रोपानत्कमंडलुम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004131061, "chapter_id": 24131, "verse_number": "४-८०-६२", "content_sanskrit": "मनोरथतृतीयाया व्रतमेतन्मया कृतम् ।\nन्यूनातिरिक्तं संपूर्णमेतदस्तु भवद्गिरा ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004131062, "chapter_id": 24131, "verse_number": "४-८०-६३", "content_sanskrit": "इत्याचार्यं समापृच्छ्य तथेत्युक्तश्च तेन वै ।\nआसीमांतमनुव्रज्य दत्त्वान्येभ्योपि शक्तितः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004131063, "chapter_id": 24131, "verse_number": "४-८०-६४", "content_sanskrit": "नक्तं समाचरेत्पोष्यैः सार्धं सुप्रीतमानसः ।\nप्रातश्चतुर्थ्यां संभोज्य चतुरश्च कुमारकान् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004131064, "chapter_id": 24131, "verse_number": "४-८०-६५", "content_sanskrit": "अभ्यर्च्य गंधमाल्याद्यैर्द्वादशापि कुमारिकाः ।\nएवं संपूर्णतां याति व्रतमेतत्सुनिर्मलम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004131065, "chapter_id": 24131, "verse_number": "४-८०-६६", "content_sanskrit": "कार्यं मनोरथावाप्त्यै सर्वैरेतद्व्रतं शुभम् ।\nपत्नीं मनोरमां कुल्यां मनोवृत्त्यनुसारिणीम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004131066, "chapter_id": 24131, "verse_number": "४-८०-६७", "content_sanskrit": "तारिणीं दुःखसंसारसागरस्य पतिव्रताम् ।\nकुर्वन्नेतद्व्रतं वर्षं कुमारः प्राप्नुयात्स्फुटम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004131067, "chapter_id": 24131, "verse_number": "४-८०-६८", "content_sanskrit": "कुमारी पतिमाप्नोति स्वाढ्यं सर्वगुणाधिकम् ।\nसुवासिनी लभेत्पुत्रान्पत्युः सौख्यमखंडितम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004131068, "chapter_id": 24131, "verse_number": "४-८०-६९", "content_sanskrit": "दुर्भगा सुभगास्याच्च धनाढ्या स्याद्दरिद्रिणी ।\nविधवापि न वैधव्यं पुनराप्नोति कुत्रचित् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004131069, "chapter_id": 24131, "verse_number": "४-८०-७०", "content_sanskrit": "गुर्विणी च शुभं पुत्रं लभते सुचिरायुषम् ।\nब्राह्मणो लभते विद्यां सर्वसौभाग्यदायिनीम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004131070, "chapter_id": 24131, "verse_number": "४-८०-७१", "content_sanskrit": "राज्यभ्रष्टो लभेद्राज्यं वैश्यो लाभं च विंदति ।\nचिंतितं लभते शूद्रो व्रतस्यास्य निषेवणात् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004131071, "chapter_id": 24131, "verse_number": "४-८०-७२", "content_sanskrit": "धर्मार्थी धर्ममाप्नोति धनार्थी धनमाप्नुयात् ।\nकामी कामानवाप्नोति मोक्षार्थी मोक्षमाप्नुयात् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004131072, "chapter_id": 24131, "verse_number": "४-८०-७३", "content_sanskrit": "यो यो मनोरथो यस्य स तं तं विंदते ध्रुवम् ।\nमनोरथतृतीयाया व्रतस्य चरणाद्व्रती ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004131073, "chapter_id": 24131, "verse_number": "४-८०-७४", "content_sanskrit": "स्कंद उवाच ।\nइत्थं निशम्य शिवतः शिवा संतुष्टमानसा ।\nपुनः पप्रच्छ विश्वेशं प्रबद्धकरसंपुटा ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004131074, "chapter_id": 24131, "verse_number": "४-८०-७५", "content_sanskrit": "अन्यत्र ये व्रतं चैतत्करिष्यंति सदाशिव ।\nते कथं पूजयिष्यंति मां च आशाविनायकम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004131075, "chapter_id": 24131, "verse_number": "४-८०-७६", "content_sanskrit": "शिव उवाच ।\nसाधु पृष्टं त्वया देवि सर्वसंदेहभेदिनि ।\nवाराणस्यां समर्च्या त्वं विश्वे प्रत्यक्षरूपिणी ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004131076, "chapter_id": 24131, "verse_number": "४-८०-७७", "content_sanskrit": "आशा विघ्नजिता सार्धं सर्वाशापूर्तिकारिणा ।\nहारिणानंतविघ्नानां मम क्षेत्र शुभार्थिना ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004131077, "chapter_id": 24131, "verse_number": "४-८०-७८", "content_sanskrit": "क्षिप्रमागमयित्वा च नत्वा दूरंगतानपि ।\nकृतकृत्यान्विधायाथ चिंतितैः समनोरथैः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004131078, "chapter_id": 24131, "verse_number": "४-८०-७९", "content_sanskrit": "अन्यत्र व्रतिभिर्विश्वे कांचनीप्रतिमा तव ।\nपंचकृष्णलकादूर्ध्वं कार्या विघ्नहृतोपि च ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004131079, "chapter_id": 24131, "verse_number": "४-८०-८०", "content_sanskrit": "आचार्याय व्रती दद्याद् व्रतांते प्रतिमा द्वयम् ।\nसकृत्कृते व्रती चास्मिन्कृतकृत्यो व्रती भवेत् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004131080, "chapter_id": 24131, "verse_number": "४-८०-८१", "content_sanskrit": "ततः पुलोमजा देवि श्रुत्वैतद्व्रतमुत्तमम् ।\nकृत्वा मनोरथं प्राप यथाभिवांछितं हृदि ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004131081, "chapter_id": 24131, "verse_number": "४-८०-८२", "content_sanskrit": "अरुंधत्या वसिष्ठोपि लब्धोऽत्रिऽनसूयया ।\nसुनीत्योत्तानपादाच्च ध्रुवः प्राप्तोंऽगजोत्तमः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004131082, "chapter_id": 24131, "verse_number": "४-८०-८३", "content_sanskrit": "सुनीतेदुर्भर्गत्वं च पुनरस्माद्व्रताद्गतम् ।\nचतुर्भुजः पतिः प्राप्तः क्षीरनीरधिजन्मना ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004131083, "chapter_id": 24131, "verse_number": "४-८०-८४", "content_sanskrit": "किं बहूक्तेन सुश्रोणि कृतंयेन व्रतं त्विदम् ।\nव्रतानि तेन सर्वाणि कृतानि व्रतिना ध्रुवम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004131084, "chapter_id": 24131, "verse_number": "४-८०-८५", "content_sanskrit": "श्रुत्वा धीमान्कथां पुण्यां पुनस्तद्गतमानसः ।\nशुभबुद्धिमवाप्नोति पापैरपि विमुच्यते ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004131085, "chapter_id": 24131, "verse_number": "४-८०-८६", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां चतुर्थे काशीखंडे उत्तरार्धे धर्मेश्वराख्याने विश्वभुजाशाविनायकप्रशंसने मनोरथतृतीयाव्रताख्यानं नामाशीतितमोध्यायः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}]