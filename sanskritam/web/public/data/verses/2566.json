[{"id": 2074165, "chapter_id": 2566, "verse_number": "१२-७१-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2074166, "chapter_id": 2566, "verse_number": "१२-७१-१", "content_sanskrit": "कथं राजा प्रजा रक्षन्नाधिबन्धेन युज्यते।\nधर्मे च नापराध्नोति तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2074167, "chapter_id": 2566, "verse_number": "१२-७१-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2074168, "chapter_id": 2566, "verse_number": "१२-७१-२", "content_sanskrit": "समासेनैव ते राजन्धर्मान्वक्ष्यामि शाश्वतान्।\nविस्तरेणैव धर्माणां न जात्वन्तमवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2074169, "chapter_id": 2566, "verse_number": "१२-७१-३", "content_sanskrit": "धर्मनिष्ठाञ्श्रुतवतो देवव्रतसमाहितान्।\nअर्चितान्वासयेथास्त्वं गृहे गुणवतो द्विजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2074170, "chapter_id": 2566, "verse_number": "१२-७१-४", "content_sanskrit": "प्रत्युत्थायोपसंगृह्य चरणावभिवाद्य च।\nअथ सर्वाणि कुर्वीथाः कार्याणि सपुरोहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2074171, "chapter_id": 2566, "verse_number": "१२-७१-५", "content_sanskrit": "धर्मकार्याणि निर्वर्त्य मङ्गलानि प्रयुज्य च।\nब्राह्मणान्वाचयेथास्त्वमर्थसिद्धिजयाशिषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2074172, "chapter_id": 2566, "verse_number": "१२-७१-६", "content_sanskrit": "आर्जवेन च संपन्नो धृत्या बुद्ध्या च भारत।\nधर्मार्थौ प्रतिगृह्णीयात्कामक्रोधौ च वर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2074173, "chapter_id": 2566, "verse_number": "१२-७१-७", "content_sanskrit": "कामक्रोधौ पुरस्कृत्य योऽर्थं राजाऽनुतिष्ठति।\nन स धर्मं न चाप्यर्थं प्रतिगृह्णाति बालिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2074174, "chapter_id": 2566, "verse_number": "१२-७१-८", "content_sanskrit": "मा स्म लुब्धांश्च मूर्खांश्च कामार्थे च प्रयूयुजः।\nअलुब्धान्बुद्धिसंपन्नान्सर्वकर्मसु योजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2074175, "chapter_id": 2566, "verse_number": "१२-७१-९", "content_sanskrit": "मूर्खो ह्यधिकृतोऽर्थेषु कार्याणामविशारदः।\nप्रजाः क्लिश्नात्ययोगेन कामक्रोधसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2074176, "chapter_id": 2566, "verse_number": "१२-७१-१०", "content_sanskrit": "बलिषष्ठेन शुल्केन दण्डेनाथापराधिनाम्।\nशास्त्रानीतेन लिप्सेथा वेतनेन धनागमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2074177, "chapter_id": 2566, "verse_number": "१२-७१-११", "content_sanskrit": "दापयित्वा करं धर्म्यं राष्ट्रं नीत्या यथाविधि।\nतथैतं कल्पयेद्राजा योगक्षेममतन्द्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2074178, "chapter_id": 2566, "verse_number": "१२-७१-१२", "content_sanskrit": "गोपायितारं दातारं धर्मनित्यमतन्द्रितम्।\nअकामद्वेषसंयुक्तमनुरज्यन्ति मानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2074179, "chapter_id": 2566, "verse_number": "१२-७१-१३", "content_sanskrit": "तस्माद्धर्मेण लाभेन लिप्सेथास्त्वं धनागमम्।\nधर्मार्थावध्रुवौ तस्य यो न शास्त्रपरो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2074180, "chapter_id": 2566, "verse_number": "१२-७१-१४", "content_sanskrit": "अपशास्त्रधनो राजा संचयं नाधिगच्छति।\nअस्थाने चास्य तद्वित्तं सर्वमेव विनश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2074181, "chapter_id": 2566, "verse_number": "१२-७१-१५", "content_sanskrit": "अर्थमूलोऽपि हिंसां च कुरुते स्वयमात्मनः।\nकरैरशास्त्रदृष्टैर्हि मोहात्संपीडयन्प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2074182, "chapter_id": 2566, "verse_number": "१२-७१-१६", "content_sanskrit": "ऊधश्छिन्द्यात्तु यो धेन्वाः क्षीरार्थी न लभेत्पयः।\nएवं राष्ट्रमयोगेन पीडितं न विवर्धते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2074183, "chapter_id": 2566, "verse_number": "१२-७१-१७", "content_sanskrit": "`यवसोदकमादाय सान्त्वेन विनयेन च।\nयो हि दोग्ध्रीमुपास्ते च स नित्यं विन्दते पयः।\nएवं राष्ट्रमुपायेन भुञ्जानो लभते फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2074184, "chapter_id": 2566, "verse_number": "१२-७१-१८", "content_sanskrit": "अथ राष्ट्रमुपायेन भुज्यमानं सुरक्षितम्।\nजनयत्यतुलां नित्यं कोशवृद्धिं युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2074185, "chapter_id": 2566, "verse_number": "१२-७१-१९", "content_sanskrit": "दोग्ध्री धान्यं हिरण्यं च मही राजा सुरक्षिता।\nनित्यं स्वेभ्यः परेभ्यश्च तृप्ता माता यथा पयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2074186, "chapter_id": 2566, "verse_number": "१२-७१-२०", "content_sanskrit": "मालाकारोपमो राजन्भव माऽऽङ्गारिकोपमः।\nतथायुक्तश्चिरं राज्यं भोक्तुं शक्ष्यसि पालयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2074187, "chapter_id": 2566, "verse_number": "१२-७१-२१", "content_sanskrit": "परचक्राभियानेन यदि ते स्याद्धनक्षयः।\nअथ साम्नैव लिप्सेथा धनमब्राह्मणेषु यत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2074188, "chapter_id": 2566, "verse_number": "१२-७१-२२", "content_sanskrit": "मा स्म ते ब्राह्मणं दृष्ट्वा धनस्थं प्रचलेन्मनः।\nअन्त्यायामप्यवस्थायां किमु स्फीतस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2074189, "chapter_id": 2566, "verse_number": "१२-७१-२३", "content_sanskrit": "धनानि तेभ्यो दद्यास्त्वं यथाशक्ति यथार्हतः।\nसान्त्वयन्परिरक्षंश्च स्वर्गमाप्स्यसि दुर्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2074190, "chapter_id": 2566, "verse_number": "१२-७१-२४", "content_sanskrit": "एवं धर्म्येण वृत्तेन प्रजास्त्वं परिपालय।\nस्वर्ग्यं पुण्यं यशो नित्यं प्राप्स्यसे कुरुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2074191, "chapter_id": 2566, "verse_number": "१२-७१-२५", "content_sanskrit": "धर्मेण व्यवहारेण प्रजाः पालय पाण्डव।\nयुधिष्ठिर यथायुक्तो नाधिबन्धेन योक्ष्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2074192, "chapter_id": 2566, "verse_number": "१२-७१-२६", "content_sanskrit": "एष एव परो धर्मो यद्राजा रक्षति प्रजाः।\nभूतानां हि यदा धर्मो रक्षणं परमा दया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2074193, "chapter_id": 2566, "verse_number": "१२-७१-२७", "content_sanskrit": "तस्मादेवं परं धर्मं मन्यन्ते धर्मकोविदाः।\nयो राजा रक्षणे युक्तो भूतेषु कुरुते दयाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2074194, "chapter_id": 2566, "verse_number": "१२-७१-२८", "content_sanskrit": "यदह्ना कुरुते पापमरक्षन्भयतः प्रजाः।\nराजा वर्षसहस्रेण तस्यान्तमधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2074195, "chapter_id": 2566, "verse_number": "१२-७१-२९", "content_sanskrit": "यदह्ना कुरुते धर्मं प्रजा धर्मेण पालयन्।\nदशवर्षसहस्राणि तस्य भुङ्क्ते फलं दिवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2074196, "chapter_id": 2566, "verse_number": "१२-७१-३०", "content_sanskrit": "स्विष्टिः स्वधीतिः सुतपा लोकाञ्जयति यावतः।\nक्षणेन तानवाप्नोति प्रजा धर्मेण पालयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2074197, "chapter_id": 2566, "verse_number": "१२-७१-३१", "content_sanskrit": "एवं धर्मं प्रयत्नेन कौन्तेय परिपालय।\nततः पुण्यफलं लब्ध्वा नानुबन्धेन योक्ष्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2074198, "chapter_id": 2566, "verse_number": "१२-७१-३२", "content_sanskrit": "स्वर्गलोके सुमहतीं श्रियं प्राप्स्यसि पाण्डव।\nअसंभवश्च धर्माणामीदृशानामराजसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2074199, "chapter_id": 2566, "verse_number": "१२-७१-३३", "content_sanskrit": "तस्माद्राजैव नान्योऽस्ति यो धर्मफलमाप्नुयात्।\nस राज्यं धृतिमान्प्राप्य धर्मेण परिपालय।\nइन्द्रं तर्पय सोमेन कामैश्च सुहृदो जनान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2074200, "chapter_id": 2566, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि एकसप्ततितमोऽध्यायः॥ ७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]