[{"id": 2001501, "chapter_id": 1026, "verse_number": "१-२७-०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2001502, "chapter_id": 1026, "verse_number": "१-२७-१", "content_sanskrit": "संप्रहृष्टास्ततो नागा जलधाराप्लुतास्तदा।\nसुपर्णेनोह्यमानास्ते जग्मुस्तं द्वीपमाशु वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2001503, "chapter_id": 1026, "verse_number": "१-२७-२", "content_sanskrit": "तं द्वीपं मकरावासं विहितं विश्वकर्मणा।\nतत्र ते लवणं घोरं ददृशुः पूर्वमागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2001504, "chapter_id": 1026, "verse_number": "१-२७-३", "content_sanskrit": "सुपर्णसहिताः सर्पाः काननं च मनोरमम्।\nसागराम्बुपरिक्षिप्तं पक्षिसङ्घनिजादितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2001505, "chapter_id": 1026, "verse_number": "१-२७-४", "content_sanskrit": "विचित्रफलपुष्पाभिर्वनराजिभिरावृतम्।\nभवनैरावृतं रम्यैस्तथा पद्माकरैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2001506, "chapter_id": 1026, "verse_number": "१-२७-५", "content_sanskrit": "प्रसन्नसलिलैश्चापि ह्वदैर्दिव्यैर्विभूषितम्।\nदिव्यगन्धवहैः पुण्यैर्मारुतैरुपवीजितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2001507, "chapter_id": 1026, "verse_number": "१-२७-६", "content_sanskrit": "उत्पतद्भिरिवाकाशं वृक्षैर्मलयजैरपि।\nशोभितं पुष्पवर्षाणि मुञ्चद्भिर्मारुतोद्धतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2001508, "chapter_id": 1026, "verse_number": "१-२७-७", "content_sanskrit": "वायुविक्षिप्तकुसुमैस्तथाऽन्यैरपि पादपैः।\nकिरद्भिरिव तत्रस्थान्नागान्पुष्पाम्बुवृष्टिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2001509, "chapter_id": 1026, "verse_number": "१-२७-८", "content_sanskrit": "मनःसंहर्षजं दिव्यं गन्धर्वाप्सरसां प्रियम्।\nमत्तभ्रमस्संघुष्टं मनोज्ञाकृतिदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2001510, "chapter_id": 1026, "verse_number": "१-२७-९", "content_sanskrit": "रमणीयं शिवं पुण्यं सर्वैर्जनमनोहरैः।\nनानापक्षिरुतं रम्यं कद्रूपुत्रप्रहर्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2001511, "chapter_id": 1026, "verse_number": "१-२७-१०", "content_sanskrit": "तत्ते वनं समासाद्य विजह्रुः पन्नगास्तदा।\nअब्रुवंश्च महावीर्यं सुपर्णं पतगेश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2001512, "chapter_id": 1026, "verse_number": "१-२७-११", "content_sanskrit": "वहास्मानपरं द्वीपं सुरम्यं विमलोदकम्।\nत्वं हि देशान्बहून्रम्यान्व्रजन्पश्यसि खेचर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2001513, "chapter_id": 1026, "verse_number": "१-२७-१२x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2001514, "chapter_id": 1026, "verse_number": "१-२७-१२", "content_sanskrit": "स विचिन्त्याब्रवीत्पक्षी मातरं विनतो तदा।\nकिं कारणं मया मातः कर्तव्यं सर्पभाषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2001515, "chapter_id": 1026, "verse_number": "१-२७-१३x", "content_sanskrit": "विनतोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2001516, "chapter_id": 1026, "verse_number": "१-२७-१३", "content_sanskrit": "दासीभूतास्मि दुर्योगात्सपत्न्याः पतगोत्तम।\nपणं वितथमास्थाय सर्पैरुपधिना कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2001517, "chapter_id": 1026, "verse_number": "१-२७-१४x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2001518, "chapter_id": 1026, "verse_number": "१-२७-१४", "content_sanskrit": "तस्मिंस्तु कथिते मात्रा कारणे गगनेतरः।\nउवाच वचनं सर्पांस्तेन दुःखेन दुःखितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2001519, "chapter_id": 1026, "verse_number": "१-२७-१५", "content_sanskrit": "किमाहृत्य विदित्वा वा किं वा कृत्वेह पौरुषम्।\nदास्याद्वो विप्रमुच्येयं तथ्यं वदत लेलिहाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2001520, "chapter_id": 1026, "verse_number": "१-२७-१६x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2001521, "chapter_id": 1026, "verse_number": "१-२७-१६", "content_sanskrit": "श्रुत्वा समब्रुवन्सर्पा आहरामृतमोजसा।\nततो दास्याद्विप्रमोक्षो भविता तव खेचर॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2001522, "chapter_id": 1026, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि सप्तविंशोऽध्यायः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]