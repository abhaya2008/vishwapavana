[{"id": 7003212000, "chapter_id": 23212, "verse_number": "१-१५-१", "content_sanskrit": "सूत उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003212001, "chapter_id": 23212, "verse_number": "१-१५-२", "content_sanskrit": "ततस्तस्मिन् गते कल्पे कृष्णवर्णे भयानके  ।\nतुष्टाव देवदेवेशं ब्रह्मा तं ब्रह्मरूपिणम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003212002, "chapter_id": 23212, "verse_number": "१-१५-३", "content_sanskrit": "अनुगृह्य ततस्तुष्टो ब्रह्माणमवदद्धरः  ।\nअनेनैव तु रूपेण संहरामि न संशयः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003212003, "chapter_id": 23212, "verse_number": "१-१५-४", "content_sanskrit": "ब्रह्महत्यादिकान् घोरांस्तथान्यानपि पातकान्  ।\nहीनांश्चैव महाभाग तथैव विविधान्यपि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003212004, "chapter_id": 23212, "verse_number": "१-१५-५", "content_sanskrit": "उपपातकमप्येवं तथा पापानि सुव्रत  ।\nमानसानि सुतीक्ष्णानि वाचिकानि पितामह ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003212005, "chapter_id": 23212, "verse_number": "१-१५-६", "content_sanskrit": "कायिकानि सुमिश्राणि तथा प्रासंगिकानि च  ।\nबुद्धिपूर्वं कृतान्येव सहजागंतुकानि च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003212006, "chapter_id": 23212, "verse_number": "१-१५-७", "content_sanskrit": "मातृदेहोत्थतान्येवं पितृदेहे च पातकम्  ।\nसंहरामि न संदेहः सर्वं पातकजं विभो ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003212007, "chapter_id": 23212, "verse_number": "१-१५-८", "content_sanskrit": "लक्षं जप्त्वा ह्यघोरेभ्यो ब्रह्महा मुच्यते प्रभो  ।\nतदर्धं वाचिके वत्स तदर्धं मानसे पुनः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003212008, "chapter_id": 23212, "verse_number": "१-१५-९", "content_sanskrit": "चतुर्गुणं बुद्धिपूर्वे क्रोधादष्टगुणं स्मृतम्  ।\nवीरहा लक्षमात्रेण भ्रूणहा कोटिमभ्यसेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003212009, "chapter_id": 23212, "verse_number": "१-१५-१०", "content_sanskrit": "मातृहा नियुतं जप्त्वा शुद्ध्यते नात्र संशयः  ।\nगोघ्नश्चैव कृतघ्नश्च स्त्रीघ्नः पापयुतो नरः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003212010, "chapter_id": 23212, "verse_number": "१-१५-११", "content_sanskrit": "अयुताघोरमभ्यस्य मुच्यते नात्र संशयः ।\nसुरापो लक्षमात्रेण बुद्ध्याबुद्ध्यापि वै प्रभो ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003212011, "chapter_id": 23212, "verse_number": "१-१५-१२", "content_sanskrit": "मुच्यते नात्र संदेहस्तदर्धेन च वारुणीम्  ।\nअस्नाताशी सहस्रेण अजपी च तथा द्विजः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003212012, "chapter_id": 23212, "verse_number": "१-१५-१३", "content_sanskrit": "अहुताशी सहस्रेण अदाता च विशुद्ध्यति  ।\nब्राह्मणस्वापहर्ता च स्वर्णस्तेयी नराधमः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003212013, "chapter_id": 23212, "verse_number": "१-१५-१४", "content_sanskrit": "नियुतं मानसं जप्त्वा मुच्यते नात्र संशयः  ।\nगुरुतल्प रतो वापि मातृघ्नो वा नराधमः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003212014, "chapter_id": 23212, "verse_number": "१-१५-१५", "content_sanskrit": "ब्रह्मघ्नश्च जपेदेवं मानसं वै पितामह  ।\nसंपर्कात्पापिनां पापं तत्समं परिभाषितम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003212015, "chapter_id": 23212, "verse_number": "१-१५-१६", "content_sanskrit": "तथाप्ययुतमात्रेण पातकाद्वै प्रमुच्यते  ।\nसंसर्गात्पातकी लक्षं जपेद्वै मानसं धिया ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003212016, "chapter_id": 23212, "verse_number": "१-१५-१७", "content_sanskrit": "उपांशु यच्चतुर्धा वै वाचिकं चाष्टधा जपेत्  ।\nपातकादर्धमेव स्यादुपपातकिनां स्मृतम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003212017, "chapter_id": 23212, "verse_number": "१-१५-१८", "content_sanskrit": "तदर्धं केवले पापे नात्र कार्या विचारणा  ।\nब्रह्महत्या सुरापानं सुवर्णस्तेयमेव च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003212018, "chapter_id": 23212, "verse_number": "१-१५-१९", "content_sanskrit": "कृत्वा च गुरुतल्पं च पापकृद्ब्राह्मणो यदि  ।\nरुद्रगायत्रिया ग्राह्यं गोमूत्रं कापिलं द्विजाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003212019, "chapter_id": 23212, "verse_number": "१-१५-२०", "content_sanskrit": "गंधद्वारेति तस्या वै गोमयं खस्थमाहरेत्  ।\nतेजोसि शुक्तमित्याज्यं कापिलं संहरेद्बुधः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003212020, "chapter_id": 23212, "verse_number": "१-१५-२१", "content_sanskrit": "आप्यायस्वेति च क्षीरं दधिक्राव्णोति चाहरेत्  ।\nगव्यं दधि नवं साक्षात्कापिलं वै पितामह ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003212021, "chapter_id": 23212, "verse_number": "१-१५-२२", "content_sanskrit": "देवस्यत्वेतिमंत्रेण संग्रहेद्वै कुशोदकम्  ।\nएकस्थां हेमपात्रे वा कृत्वाघोरेण राजते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003212022, "chapter_id": 23212, "verse_number": "१-१५-२३", "content_sanskrit": "ताम्रे वा पद्म पत्रे वा पालशे वा दले शुभे  ।\nसकूर्चं सर्वरत्नाढ्यं क्षिप्त्वा तत्रैद कांचनम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003212023, "chapter_id": 23212, "verse_number": "१-१५-२४", "content_sanskrit": "जपेल्लक्षमघोराख्यं हुत्वा चैव घृतादिभिः  ।\nघृतेन चरुणा चैव समिद्भिश्च तिलैस्तथा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003212024, "chapter_id": 23212, "verse_number": "१-१५-२५", "content_sanskrit": "यवैश्च व्रीहिभिश्चैव जुहुयाद्वै पृथक्पृथक्  ।\nप्रत्येकं सप्तवारं तु द्रव्यालाभे घृतेन तु ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003212025, "chapter_id": 23212, "verse_number": "१-१५-२६", "content_sanskrit": "हुत्वाघोरेण देवेशं स्नात्वाऽघोरेण वै द्विजाः  ।\nअष्टद्रोणघृतेनैव स्नाप्य पश्चाद्विशोध्य च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003212026, "chapter_id": 23212, "verse_number": "१-१५-२७", "content_sanskrit": "अहोरात्रोषितः स्नातः पिबेत्कूर्चं शिवाग्रतः  ।\nब्राह्मं ब्रह्मजपं कुर्यादाचम्य च यथा विधि ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003212027, "chapter_id": 23212, "verse_number": "१-१५-२८", "content_sanskrit": "एवं कृत्वा कृतघ्नोऽपि ब्रह्महा भ्रूणहा तथा  ।\nवीरहा गुरुवाती च मित्रविश्वासघातकः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003212028, "chapter_id": 23212, "verse_number": "१-१५-२९", "content_sanskrit": "स्तेयी सुवर्णस्तेयी च गुरुतल्परतः सदा  ।\nमद्यपो वृषलीसक्तः परदारविधर्षकः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003212029, "chapter_id": 23212, "verse_number": "१-१५-३०", "content_sanskrit": "ब्रह्मस्वहा तथा गोघ्नो मातृहा पितृहा तथा  ।\nदेवप्रच्यावकश्चैव लिंगप्रध्वंसकस्तथा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003212030, "chapter_id": 23212, "verse_number": "१-१५-३१", "content_sanskrit": "तथान्यानि च पापानि मानसानि द्विजो यदि  ।\nवाचिकानि तथान्यानि कायिकानि सहस्रशः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003212031, "chapter_id": 23212, "verse_number": "१-१५-३२", "content_sanskrit": "कृत्वा विमुच्यते तद्यो जन्मांतरशतैरपि  ।\nएतद्रहस्यं कथितमघोरेशप्रसंगतः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003212032, "chapter_id": 23212, "verse_number": "१-१५-३३", "content_sanskrit": "तस्माज्जपेद्द्विजो नित्यं सर्वपापविशुद्धये ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]