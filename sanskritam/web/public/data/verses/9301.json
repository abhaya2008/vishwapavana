[{"id": 40018976, "chapter_id": 9301, "verse_number": "1", "content_sanskrit": "रावणंनिहतंदृष्टवाराघवेणमहात्मना । अन्तःपुराद्विनिष्पेतूराक्षस्यश्शोककर्शिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40018977, "chapter_id": 9301, "verse_number": "2", "content_sanskrit": "वार्यमाणास्सुबहुशोवेष्टन्त्यःक्षितिपांसुषु । विमुक्तकेश्यश्शोकार्तागावोवत्सहतायथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40018978, "chapter_id": 9301, "verse_number": "3", "content_sanskrit": "उत्तरेणविनिष्क्रम्यद्वारेणसहराक्षसैः । प्रविश्यायोधनंघोरंविचिन्वन्त्वोहतंपतिम् ॥ आर्यपुत्रेतिवादिन्योहानाथेति च सर्वशः । परिपेतुःकबन्धाङ्कांमहींशोणितकर्दमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40018979, "chapter_id": 9301, "verse_number": "4", "content_sanskrit": "उत्तरेणविनिष्क्रम्यद्वारेणसहराक्षसैः । प्रविश्यायोधनंघोरंविचिन्वन्त्वोहतंपतिम् ॥ आर्यपुत्रेतिवादिन्योहानाथेति च सर्वशः । परिपेतुःकबन्धाङ्कांमहींशोणितकर्दमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40018980, "chapter_id": 9301, "verse_number": "5", "content_sanskrit": "ताबाष्पपरिपूर्णाक्ष्योभर्तृशोकपराजिताः । करेण्वइवनर्द्नत्योविनेदुर्हतयूथपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40018981, "chapter_id": 9301, "verse_number": "6", "content_sanskrit": "ददृशुस्तामहाकायंमहावीर्यंमहाद्युतिम् । रावणंनिहतम्भूमौनीलाञ्जनचयोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40018982, "chapter_id": 9301, "verse_number": "7", "content_sanskrit": "ताःपतिंसहसादृष्टवाशयानंरणपांसुषु । निपेतुस्तस्यगात्रेषुछिन्नावनलताइव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40018983, "chapter_id": 9301, "verse_number": "8", "content_sanskrit": "बहुमानात्परिष्वज्यकाचिदेवंरुरोद ह । चरणौकाचिदालम्ब्यकाचित्कण्ठेऽवलम्ब्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40018984, "chapter_id": 9301, "verse_number": "9", "content_sanskrit": "उत्क्षिप्य च भुजौकाचिद्भूमौसुपरिवर्तते । हतस्यवदनंदृष्टवाकाचिन्मोहमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40018985, "chapter_id": 9301, "verse_number": "10", "content_sanskrit": "काचिदङ्केशिरःकृत्वारुरोदमुखमीक्षती । स्नापयन्तीमुखंबाष्पैस्तुषारैरिवपङ्कजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40018986, "chapter_id": 9301, "verse_number": "11", "content_sanskrit": "एवमार्ताःपतिंदृष्टवारावणंनिहतंभुवि । चुक्रुशुर्भहुधाशोकाद्भूयस्ताःपर्यदेवयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40018987, "chapter_id": 9301, "verse_number": "12", "content_sanskrit": "येनमित्रासितःशक्रोयेनवित्रासितोयमः । येनवैश्रवणोराजापुष्पकेणवियोजितः ॥ गन्धर्वाणामृषीणां च सुराणां च महात्मनाम् । भयंयेनरणेदत्तंसोऽयंशेतेरणेहतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40018988, "chapter_id": 9301, "verse_number": "13", "content_sanskrit": "येनमित्रासितःशक्रोयेनवित्रासितोयमः । येनवैश्रवणोराजापुष्पकेणवियोजितः ॥ गन्धर्वाणामृषीणां च सुराणां च महात्मनाम् । भयंयेनरणेदत्तंसोऽयंशेतेरणेहतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40018989, "chapter_id": 9301, "verse_number": "14", "content_sanskrit": "असुरेभ्यःसुरेभ्योवापन्नगेभ्योऽपिवातथा । भयंयो न विजानातितस्येदंमानुषाद् भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40018990, "chapter_id": 9301, "verse_number": "15", "content_sanskrit": "अवध्योदेवतानांयस्तथादानवराक्षसाम् । हतःसोऽयंरणेशेतेमानुषेणपदातिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40018991, "chapter_id": 9301, "verse_number": "16", "content_sanskrit": "यो न शक्यस्सुरैर्हन्तुं न यक्षैर्नासुरैस्तथा । सोऽयंकश्चिदिवासत्त्वोमृत्युंमर्त्येनलम्भितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40018992, "chapter_id": 9301, "verse_number": "17", "content_sanskrit": "एवंवदन्त्योरुरुदुस्तस्यतादुःखिताःस्त्रियः । भूयएव च दुःखार्ताविलेपुश्चपुनःपुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40018993, "chapter_id": 9301, "verse_number": "18", "content_sanskrit": "अशृण्वतातुसुहृदांसततंहितवादिनाम् । मरणायहृतासीताराक्षसाश्चनिपातिताः ॥ एतास्सममिदानींतेवयमात्मा च पातितः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40018994, "chapter_id": 9301, "verse_number": "19", "content_sanskrit": "ब्रुवाणोऽपिहितंवाक्यमिष्टोभ्राताविभीषणः ॥ धृष्टंपरुषितोमोहत्त्वयात्मवथकाङ्क्षिणा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40018995, "chapter_id": 9301, "verse_number": "20", "content_sanskrit": "दिनिर्यातितातेस्वासतीतारामायमैथिली ॥ ननस्स्याद्व्यसनंघोरमिदंमूलहरंमहत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40018996, "chapter_id": 9301, "verse_number": "21", "content_sanskrit": "वृत्तकामोभवेद्भ्रातारामोमित्रकुलंभवेत् ॥ वयंचाध्विवाःसर्वाःसकमा न च शत्रवः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40018997, "chapter_id": 9301, "verse_number": "22", "content_sanskrit": "त्वयापुनर्नृशंशंसेनसीतांसंरुन्धताबलात् ॥ राक्षसावयमात्मा च त्रयंतुल्यंनिपातितम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40018998, "chapter_id": 9301, "verse_number": "23", "content_sanskrit": "न कामकारःकामंवातवराक्षसपुङ्गव । दैवंचेष्टयतेसर्वंहतंदैवेनहन्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40018999, "chapter_id": 9301, "verse_number": "24", "content_sanskrit": "वानराणांविनाशोऽयंराक्षसानां च तेरणे । तवचैवमहाबाहो दैवयोगादुपागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40019000, "chapter_id": 9301, "verse_number": "25", "content_sanskrit": "नैवार्थेन न कामेनविक्रमेण न चाज्ञया । शक्यादैवगतिर्लोकेनिवर्तयितुमुद्यता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]