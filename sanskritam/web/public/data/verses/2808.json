[{"id": 2085047, "chapter_id": 2808, "verse_number": "१२-३१३-०x", "content_sanskrit": "वसिष्ठ उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2085048, "chapter_id": 2808, "verse_number": "१२-३१३-१", "content_sanskrit": "अप्रबुद्धमथाव्यक्तमिमं गुणविधिं शृणु।\nगुणान्धारयते ह्येषा सृजत्याक्षिपते तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2085049, "chapter_id": 2808, "verse_number": "१२-३१३-२", "content_sanskrit": "अजस्रं त्विह क्रीडार्थं विकरोति जनाधिप।\nआत्मानं बहुधा कृत्वा तान्येव प्रविचक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2085050, "chapter_id": 2808, "verse_number": "१२-३१३-३", "content_sanskrit": "एतदेवं विकुर्वाणं बुध्यमानो न बुध्यते।\nअव्यक्तबोधनाच्चैव बुध्यमानं वदन्त्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2085051, "chapter_id": 2808, "verse_number": "१२-३१३-४", "content_sanskrit": "न त्वेव बुध्यतेऽव्यक्तं सगुणं वाऽथ निर्गुणम्।\nकदाचित्त्वेव खल्वेतदाहुरप्रतिबुद्धकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2085052, "chapter_id": 2808, "verse_number": "१२-३१३-५", "content_sanskrit": "बुध्यते यदि वाऽव्यक्तमेतद्वै पञ्चविंशकम्।\nबुध्यमानो भवत्येष सङ्गात्मक इति श्रुतिः।\nअनेनाप्रतिबुद्धेति वदन्त्यव्यक्तमच्युतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2085053, "chapter_id": 2808, "verse_number": "१२-३१३-६", "content_sanskrit": "अव्यक्तोबोधनाच्चापि बुध्यमानं वदन्त्युत।\nपञ्चविंशं महात्मानं न चासावपि बुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2085054, "chapter_id": 2808, "verse_number": "१२-३१३-७", "content_sanskrit": "षङ्विशं विमलं बुद्धमप्रमेयं सनातनम्।\nस तु तं पञ्चविंशं च चतुर्विशं च बुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2085055, "chapter_id": 2808, "verse_number": "१२-३१३-८", "content_sanskrit": "दृश्यादृश्यौ ह्यनुगतावुभावेव महाद्युती।\nअव्यक्तं तत्तु तद्ब्रह्म बुध्यते तात केवलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2085056, "chapter_id": 2808, "verse_number": "१२-३१३-९", "content_sanskrit": "केवलं पञ्चविंशं च चतुर्विशं च पश्यति।\nबुध्यमानो यदात्मानमन्योऽहमिति मन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2085057, "chapter_id": 2808, "verse_number": "१२-३१३-१०", "content_sanskrit": "तदा प्रकृतिमानेष भवत्यव्यक्तलोचनः।\nबुध्यते च परां बुद्धिं विमलाममलां यदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2085058, "chapter_id": 2808, "verse_number": "१२-३१३-११", "content_sanskrit": "षङ्विंशं राजशार्दूल तथा बुद्धत्वमाव्रजेत्।\nततस्त्यजति सोऽव्यक्तं सर्गप्रलयधर्मि वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2085059, "chapter_id": 2808, "verse_number": "१२-३१३-१२", "content_sanskrit": "निर्गुणः प्रकृतिं वेद गुणयुक्तामचेतनाम्।\nततः केवलधर्माऽसौ भवत्यव्यक्तदर्शनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2085060, "chapter_id": 2808, "verse_number": "१२-३१३-१३", "content_sanskrit": "केवलेन समागम्य विमुक्तोऽऽत्मानमाप्नुयात्।\nएतं वै तत्त्वमित्याहुर्निस्तत्त्वमजरामरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2085061, "chapter_id": 2808, "verse_number": "१२-३१३-१४", "content_sanskrit": "तत्त्वसंश्रयणादेष तत्त्ववान्न च मानद।\nपञ्चविंशतितत्त्वानि प्रवदन्ति मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2085062, "chapter_id": 2808, "verse_number": "१२-३१३-१५", "content_sanskrit": "न चैष तत्त्ववांस्तात निस्तत्त्वस्त्वेष बुद्धिमान्।\nएष मुञ्चति तत्त्वं हि क्षिप्रं बुद्धत्वलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2085063, "chapter_id": 2808, "verse_number": "१२-३१३-१६", "content_sanskrit": "षाङ्विंशोऽहमिति प्राज्ञो गृह्यमाणोऽजरामरः।\nकेवलेन बलेनैव समतां यात्यसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2085064, "chapter_id": 2808, "verse_number": "१२-३१३-१७", "content_sanskrit": "षङ्विंशेन प्रबुद्धेन बुध्यमानो ह्यबुद्धिमान्।\nएवं नानात्वमित्युक्तं साङ्ख्यश्रुतिनिदर्शनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2085065, "chapter_id": 2808, "verse_number": "१२-३१३-१८", "content_sanskrit": "चेतनेन समेतस्य पञ्चविंशतिकस्य च।\nएकत्वं वै भवत्यस्य यदा बुद्ध्या न बुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2085066, "chapter_id": 2808, "verse_number": "१२-३१३-१९", "content_sanskrit": "बुध्यमानोप्रबुद्धेन समतां याति मैथिल।\nसङ्गधर्मा भवत्येष निःसङ्गात्मा नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2085067, "chapter_id": 2808, "verse_number": "१२-३१३-२०", "content_sanskrit": "निःसङ्गात्मानमासाद्य षङ्विंशकमजं विभुम्।\nविभुस्त्यजति चाव्यक्तं यदा त्वेताद्विबुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2085068, "chapter_id": 2808, "verse_number": "१२-३१३-२१", "content_sanskrit": "चतुर्विशं महाभाग षङ्विंशस्य प्रबोधनात्।\nएष ह्यप्रतिबुद्धश्च बुध्यमानश्च तेऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2085069, "chapter_id": 2808, "verse_number": "१२-३१३-२२", "content_sanskrit": "प्रोक्तो बुद्धश्च तत्त्वेन यथाश्रुतिनिदर्शनात्।\nनानात्वैकत्वमेतावद्द्रष्टव्यं शास्त्रदृष्टिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2085070, "chapter_id": 2808, "verse_number": "१२-३१३-२३", "content_sanskrit": "मशकोदुम्बरे यद्वदन्यत्वं तद्वदेतयोः।\nमत्स्योदके यथा तद्वदन्यत्वमुपलभ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2085071, "chapter_id": 2808, "verse_number": "१२-३१३-२४", "content_sanskrit": "एवमेवावगन्तव्यं नानात्वैकत्वमेतयोः।\nएतद्धि मोक्ष इत्युक्तमव्यक्तज्ञानसंज्ञितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2085072, "chapter_id": 2808, "verse_number": "१२-३१३-२५", "content_sanskrit": "पञ्चविंशतिकस्यास्य योऽयं देहेषु वर्तते।\nएष मोक्षयितव्येति प्राहुरव्यक्तगोचरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2085073, "chapter_id": 2808, "verse_number": "१२-३१३-२६", "content_sanskrit": "सोयमेवं विमुच्येत नान्यथेति विनिश्चयः।\nपरेण परधर्मा च भवत्येष समेत्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2085074, "chapter_id": 2808, "verse_number": "१२-३१३-२७", "content_sanskrit": "विशुद्धर्मा शुद्धेन बुद्धेन च स बुद्धिमान्।\nविमुक्तधर्मा मुक्तेन समेत्य पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2085075, "chapter_id": 2808, "verse_number": "१२-३१३-२८", "content_sanskrit": "वियोगधर्मिणा चैव वियोगात्मा भवत्यथ।\nविमोक्षिणा विमोक्षश्च समेत्येह तथा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2085076, "chapter_id": 2808, "verse_number": "१२-३१३-२९", "content_sanskrit": "शुद्धधर्मा शुचिश्चैव भवत्यमितदीप्तिमान्।\nविमलात्मा च भवति समेत्य विमलात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2085077, "chapter_id": 2808, "verse_number": "१२-३१३-३०", "content_sanskrit": "केवलात्मा तथा चैव केवलेन समेत्य वै।\nस्वतन्त्रश्च स्वतन्त्रेण स्वतन्त्रत्वमवाप्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2085078, "chapter_id": 2808, "verse_number": "१२-३१३-३१", "content_sanskrit": "एतावदेतत्कथितं मया ते\nतथ्यं महाराज यथार्थतत्त्वम्।\nअमत्सरत्वं प्रतिगृह्य चार्थं\nसनातनं ब्रह्म विशुद्धमाद्यम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2085079, "chapter_id": 2808, "verse_number": "१२-३१३-३२", "content_sanskrit": "नावेदनिष्ठस्य जनस्य राज\nन्प्रदेयमेतत्परमं त्वया भवेत्।\nविवित्समानाय विबोधकारणं\nप्रबोधहेतोः प्रणतस्य शासनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2085080, "chapter_id": 2808, "verse_number": "१२-३१३-३३", "content_sanskrit": "न देयमेतच्च तथाऽनृतात्मने\nशठाय क्लीबाय न जिह्नबुद्धये।\nन पण्डितज्ञानपरोपतापिने\nदेयं त्वयेदं विनिबोध यादृशे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2085081, "chapter_id": 2808, "verse_number": "१२-३१३-३४", "content_sanskrit": "श्रद्धान्वितायाथ गुणान्विताय\nपरापवादाद्विरताय नित्यम्।\nविशुद्धयोगाय बुधाय चैव\nक्रियावते च क्षमिणे हिताय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2085082, "chapter_id": 2808, "verse_number": "१२-३१३-३५", "content_sanskrit": "विविक्तशीलाय विधिप्रियाय\nविवादहीनाय बहुश्रुताम्।\nविजानते चैव दमक्षमावते\nशक्ताय चैकात्मशमाय देहिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2085083, "chapter_id": 2808, "verse_number": "१२-३१३-३६", "content_sanskrit": "एतैर्गुणैर्हीनतमे न देय\nमेतत्परं ब्रह्म विशुद्धमाहुः।\nन श्रेयसा योक्ष्यति तादृशे कृतं\nधर्मप्रवक्तारमपात्रदानात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2085084, "chapter_id": 2808, "verse_number": "१२-३१३-३७", "content_sanskrit": "पृथ्वीमिमां यद्यपि रत्नपूर्णां\nदद्यान्न देयं त्विदमव्रताय।\nजितेन्द्रियायैतदसंशयं ते\nभवेत्प्रदेयं परमं नरेन्द्र॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2085085, "chapter_id": 2808, "verse_number": "१२-३१३-३८", "content_sanskrit": "कराल मा ते भयमस्तु किंचि\nदेतच्छ्रुतं ब्रह्म परं त्वयाऽद्य।\nयथावदुक्तं परमं पवित्रं\nविशोकमत्यन्तमनादिमध्यम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2085086, "chapter_id": 2808, "verse_number": "१२-३१३-३९", "content_sanskrit": "अगाधजन्मामरणं च राज\nन्निरामयं वीतभयं शिवं च।\nसमीक्ष्य मोहं त्यज बाऽद्य सर्व\nज्ञानस्य तत्त्वार्थमिदं विदित्वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2085087, "chapter_id": 2808, "verse_number": "१२-३१३-४०", "content_sanskrit": "अवाप्तमेतद्धि मया सनातना\nद्धिरण्यगर्भाद्यजतो नराधिप।\nप्रसाद्य यत्नेन तमुग्रतेजसं\nसनातनं ब्रह्म यथाऽद्य वै त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2085088, "chapter_id": 2808, "verse_number": "१२-३१३-४१", "content_sanskrit": "पृष्टस्त्वया चास्मि यथा नरेन्द्र\nतथा मयेदं त्वयि चोक्तमद्य।\nतथाऽवाप्तं ब्रह्मणो मे नरेन्द्र\nमहाज्ञानं मोक्षविदां परायणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2085089, "chapter_id": 2808, "verse_number": "१२-३१३-४२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2085090, "chapter_id": 2808, "verse_number": "१२-३१३-४२", "content_sanskrit": "एतदुक्तं परं ब्रह्म यस्मान्नावर्तते पुनः।\nपञ्चविंशो महाराज परमर्षिनिदर्शनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2085091, "chapter_id": 2808, "verse_number": "१२-३१३-४३", "content_sanskrit": "पुनरावृत्तिमाप्नोति परं ज्ञानमवाप्य च।\nनावबुध्यति तत्त्वेन बुध्यमानोऽजरामरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2085092, "chapter_id": 2808, "verse_number": "१२-३१३-४४", "content_sanskrit": "एतन्निः श्रेयसकरं ज्ञानं ते परमं मया।\nकथितं तत्त्वतस्तात श्रुत्वा देवर्षितो नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2085093, "chapter_id": 2808, "verse_number": "१२-३१३-४५", "content_sanskrit": "हिरण्यगर्भादृषिणा वसिष्ठेन महात्मना।\nवसिष्ठादृषिशार्दूलान्नारदोऽवाप्तवानिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2085094, "chapter_id": 2808, "verse_number": "१२-३१३-४६", "content_sanskrit": "नारदाद्विदितं मह्यमेतद्ब्रह्म सनातनम्।\nमा शुचः कौरवेन्द्र त्वं श्रुत्वैतत्परमं पदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2085095, "chapter_id": 2808, "verse_number": "१२-३१३-४७", "content_sanskrit": "येन क्षराक्षरे वित्ते भयं तस्य न विद्यते।\nविद्यते तु भयं तस्य यो नैतद्वेत्ति पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2085096, "chapter_id": 2808, "verse_number": "१२-३१३-४८", "content_sanskrit": "अविज्ञानाच्च मूढात्मा पुनः पुनरुपाद्रवत्।\nप्रेत्य जातिसहस्राणि मरणान्तान्युपाश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2085097, "chapter_id": 2808, "verse_number": "१२-३१३-४९", "content_sanskrit": "देवलोकं तथा तिर्यङ्भनुष्यमपि चाश्नुते।\nयदि शुध्यति कालेन तस्मादज्ञानसागरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2085098, "chapter_id": 2808, "verse_number": "१२-३१३-५०", "content_sanskrit": "`उत्तीर्णोऽस्मादगाधात्स परमाप्नोति शोभनम्।\nअज्ञानसागरो घोरो ह्यव्यक्तोऽगाध उच्यते।\nअहन्यहनि मज्जन्ति यत्र भूतानि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2085099, "chapter_id": 2808, "verse_number": "१२-३१३-५१", "content_sanskrit": "यस्मादगाधादव्यक्तादुत्तीर्णस्त्वं सनातनात्।\nतस्मात्त्वं विरजाश्चैव वितमस्कश्च पार्थिव॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2085100, "chapter_id": 2808, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि त्रयोदशाधिकत्रिशततमोऽध्यायः॥ ३१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]