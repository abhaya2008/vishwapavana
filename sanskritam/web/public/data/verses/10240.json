[{"id": 6000240000, "chapter_id": 10240, "verse_number": null, "content_sanskrit": "अथ चतुश्चत्वारिंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000240001, "chapter_id": 10240, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.001.m4a", "display_order": 2}, {"id": 6000240002, "chapter_id": 10240, "verse_number": "१०-४४-१", "content_sanskrit": "वृष्णीनां प्रवरो मन्त्री कृष्णस्य दयितः सखा।\nशिष्यो बृहस्पतेः साक्षादुद्धवो बुद्धिसत्तमः॥ १०/४४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.002.m4a", "display_order": 3, "topics": [{"text": "उद्धवं गोकुलं संप्रेष्य यशोदानन्दयोः शोकापनोदनम्", "range": "१–४९"}]}, {"id": 6000240003, "chapter_id": 10240, "verse_number": "१०-४४-२", "content_sanskrit": "तमाह भगवान् प्रेष्ठं भक्तमेकान्तिनं क्‍वचित्।\nगृहीत्वा पाणिना पाणिं प्रपन्नार्तिहरो हरिः॥ १०/४४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.003.m4a", "display_order": 4}, {"id": 6000240004, "chapter_id": 10240, "verse_number": "१०-४४-३", "content_sanskrit": "गच्छोद्धव व्रजं सौम्य पित्रोर्नः प्रीतिमावह।\nगोपीनां मद्वियोगाधिं मत्सन्देशैर्विमोचय॥ १०/४४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.004.m4a", "display_order": 5}, {"id": 6000240005, "chapter_id": 10240, "verse_number": "१०-४४-४", "content_sanskrit": "ता मन्मनस्का मत्प्राणा मदर्थे त्यक्तदैहिकाः।\nमामेव दयितं प्रेष्ठमात्मानं मनसाऽऽगताः॥ १०/४४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.005.m4a", "display_order": 6}, {"id": 6000240006, "chapter_id": 10240, "verse_number": "१०-४४-५", "content_sanskrit": "ये त्यक्तलोकधर्माश्च मदर्थे तान् बिभर्म्यहम्।\nमयि ताः प्रेयसां प्रेष्ठे दूरस्थे गोकुलस्‍त्रियः॥ १०/४४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.006.m4a", "display_order": 7}, {"id": 6000240007, "chapter_id": 10240, "verse_number": "१०-४४-६", "content_sanskrit": "स्मरन्त्यङ्ग विमुह्यन्ति विरहौत्कण्ठ्यविक्लवाः।\nधारयन्त्यतिकृच्छ्रेण प्रायः प्राणान् कथञ्चन॥ १०/४४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.007.m4a", "display_order": 8}, {"id": 6000240008, "chapter_id": 10240, "verse_number": "१०-४४-७", "content_sanskrit": "प्रत्यागमनसन्देशैर्वक्तव्या मे मदात्मिकाः।\nइत्युक्त उद्धवो राजन् सन्देशान् भर्तुरादृतः॥ १०/४४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.008.m4a", "display_order": 9}, {"id": 6000240009, "chapter_id": 10240, "verse_number": "१०-४४-८", "content_sanskrit": "आदाय रथमारुह्य प्रययौ नन्दगोकुलम्।\nप्राप्तो नन्दव्रजं श्रीमान् निम्लोचति विभावसौ॥ १०/४४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.009.m4a", "display_order": 10}, {"id": 6000240010, "chapter_id": 10240, "verse_number": "१०-४४-९", "content_sanskrit": "छन्नयानः प्रविशतां पशूनां खुररेणुभिः।\nवासितार्थे नियुद्ध्यद्भिर्नादितं शुष्मिभिर्वृषैः॥ १०/४४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.010.m4a", "display_order": 11}, {"id": 6000240011, "chapter_id": 10240, "verse_number": "१०-४४-१०", "content_sanskrit": "धावन्तीभिश्च वास्राभिरूधोभारेण वत्सकान्।\nइतस्ततो विलङ्घद्भिर्गोवत्सैर्मण्डितं सितैः॥ १०/४४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.011.m4a", "display_order": 12}, {"id": 6000240012, "chapter_id": 10240, "verse_number": "१०-४४-११", "content_sanskrit": "गोदोहशब्दाभिरवैर्वेणूनां निस्स्वनेन च।\nगायन्तीभिश्च कर्माणि शुभानि बलकृष्णयोः॥ १०/४४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.012.m4a", "display_order": 13}, {"id": 6000240013, "chapter_id": 10240, "verse_number": "१०-४४-१२", "content_sanskrit": "स्वलङ्कृताभिर्गोपीभिर्गोपैश्च सुविराजितम्।\nअग्न्यर्कातिथिगोविप्रपितृदेवार्चनान्वितैः॥ १०/४४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.013.m4a", "display_order": 14}, {"id": 6000240014, "chapter_id": 10240, "verse_number": "१०-४४-१३", "content_sanskrit": "धूपदीपैश्च माल्यैश्च गोपावासैर्मनोरमम्।\nसर्वतः पुष्पितवनं द्विजालिकुलनादितम्॥ १०/४४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.014.m4a", "display_order": 15}, {"id": 6000240015, "chapter_id": 10240, "verse_number": "१०-४४-१४", "content_sanskrit": "हंसकारण्डवाकीर्णैः पद्मषण्डैश्च मण्डितम्।\nतमागतं समालोक्य कृष्णस्यानुचरं प्रियम्॥ १०/४४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.015.m4a", "display_order": 16}, {"id": 6000240016, "chapter_id": 10240, "verse_number": "१०-४४-१५", "content_sanskrit": "नन्दः प्रीतः परिष्वज्य वासुदेवधियाऽऽर्चयत्।\nभोजितं परमान्नेन संविष्टं कशिपौ सुखम्॥ १०/४४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.016.m4a", "display_order": 17}, {"id": 6000240017, "chapter_id": 10240, "verse_number": "१०-४४-१६", "content_sanskrit": "गतश्रमं पर्यपृच्छत् पादसंवाहनादिभिः॥ १०/४४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.017.m4a", "display_order": 18}, {"id": 6000240018, "chapter_id": 10240, "verse_number": null, "content_sanskrit": "नन्द उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.018.m4a", "display_order": 19}, {"id": 6000240019, "chapter_id": 10240, "verse_number": "१०-४४-१७", "content_sanskrit": "कच्चिदङ्ग महाभाग सखा नः शूरनन्दनः।\nआस्ते कुशल्यपत्याद्यैर्युक्तो मुक्तः सुहृद्वृतः॥ १०/४४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.019.m4a", "display_order": 20}, {"id": 6000240020, "chapter_id": 10240, "verse_number": "१०-४४-१८", "content_sanskrit": "दिष्ट्या कंसो हतः पापः सानुगः स्वेन पाप्मना।\nसाधूनां धर्मशीलानां यदूनां द्वेष्टि यः सदा॥ १०/४४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.020.m4a", "display_order": 21}, {"id": 6000240021, "chapter_id": 10240, "verse_number": "१०-४४-१९", "content_sanskrit": "अपि स्मरति नः कृष्णो मातरः सुहृदः सखीन्।\nगोपान् व्रजं चात्मनाथं गावो वृन्दावनं गिरिम्॥ १०/४४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.021.m4a", "display_order": 22}, {"id": 6000240022, "chapter_id": 10240, "verse_number": "१०-४४-२०", "content_sanskrit": "अप्यायास्यति गोविन्दः स्वजनान् सकृदीक्षितुम्।\nतर्हि द्रक्ष्याम तद्वक्त्रं सुनसं सुस्मितेक्षणम्॥ १०/४४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.022.m4a", "display_order": 23}, {"id": 6000240023, "chapter_id": 10240, "verse_number": "१०-४४-२१", "content_sanskrit": "दावाग्नेर्वातवर्षाच्च वृषात् सर्पाच्च रक्षिताः।\nदुरत्ययेभ्यो मृत्युभ्यः कृष्णेन सुमहात्मना॥ १०/४४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.023.m4a", "display_order": 24}, {"id": 6000240024, "chapter_id": 10240, "verse_number": "१०-४४-२२", "content_sanskrit": "स्मरतां कृष्णवीर्याणि लीलापाङ्गनिरीक्षणम्।\nहसितं भाषितं चाङ्ग सर्वा नः शिथिलाः क्रियाः॥ १०/४४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.024.m4a", "display_order": 25}, {"id": 6000240025, "chapter_id": 10240, "verse_number": "१०-४४-२३", "content_sanskrit": "सरिच्छैलवनोद्देशान् मुकुन्दपदभूषितान्।\nआक्रीडानीक्षमाणानां मनो याति तदात्मताम्॥ १०/४४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.025.m4a", "display_order": 26}, {"id": 6000240026, "chapter_id": 10240, "verse_number": "१०-४४-२४", "content_sanskrit": "मन्ये कृष्णं च रामं च प्राप्ताविह सुरोत्तमौ।\nसुराणां महतेऽर्थाय गर्गस्य वचनं यथा॥ १०/४४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.026.m4a", "display_order": 27}, {"id": 6000240027, "chapter_id": 10240, "verse_number": "१०-४४-२५", "content_sanskrit": "कंसं नागायुतबलं मल्लौ गजपतिं तथा।\nअवधीत्तान् लीलयैव पशूनिव मृगाधिपः॥ १०/४४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.027.m4a", "display_order": 28}, {"id": 6000240028, "chapter_id": 10240, "verse_number": "१०-४४-२६", "content_sanskrit": "तालत्रयं महासारं धनुर्यष्टिमिवेभराट्।\nबभञ्जैकेन हस्तेन सप्ताहमदधाद् गिरिम्॥ १०/४४/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.028.m4a", "display_order": 29}, {"id": 6000240029, "chapter_id": 10240, "verse_number": "१०-४४-२७", "content_sanskrit": "प्रलम्बो धेनुकोऽरिष्टस्तृणावर्तो बकादयः।\nदैत्याः सुरासुरजितो हता येनेह लीलया॥ १०/४४/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.029.m4a", "display_order": 30}, {"id": 6000240030, "chapter_id": 10240, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.030.m4a", "display_order": 31}, {"id": 6000240031, "chapter_id": 10240, "verse_number": "१०-४४-२८", "content_sanskrit": "इति संस्मृत्य संस्मृत्य नन्दः कृष्णानुरक्तधीः।\nअश्रुकण्ठोऽभवत् तूष्णीं प्रेमप्रसरविह्वलः॥ १०/४४/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.031.m4a", "display_order": 32}, {"id": 6000240032, "chapter_id": 10240, "verse_number": "१०-४४-२९", "content_sanskrit": "यशोदा वर्ण्यमानानि पुत्रस्य चरितानि च।\nशृण्वन्त्यश्रूण्यवास्राक्षीत् स्नेहस्रुतपयोधरा॥ १०/४४/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.032.m4a", "display_order": 33}, {"id": 6000240033, "chapter_id": 10240, "verse_number": "१०-४४-३०", "content_sanskrit": "तयोरित्थं भगवति कृष्णे नन्दयशोदयोः।\nवीक्ष्यानुरागं परमं नन्दमाहोद्धवो मुदा॥ १०/४४/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.033.m4a", "display_order": 34}, {"id": 6000240034, "chapter_id": 10240, "verse_number": null, "content_sanskrit": "उद्धव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.034.m4a", "display_order": 35}, {"id": 6000240035, "chapter_id": 10240, "verse_number": "१०-४४-३१", "content_sanskrit": "युवां श्लाघ्यतमौ नूनं देहिनामिह मानद।\nनारायणेऽखिलगुरौ यत् कृता मतिरीदृशी॥ १०/४४/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.035.m4a", "display_order": 36}, {"id": 6000240036, "chapter_id": 10240, "verse_number": "१०-४४-३२", "content_sanskrit": "एतौ हि विश्वस्य च बीजयोनी रामो मुकुन्दः पुरुषः प्रधानम्।\nअन्वीय भूतेषु विलक्षणेषु विज्ञाय चेशात इमौ पुराणौ॥ १०/४४/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.036.m4a", "display_order": 37}, {"id": 6000240037, "chapter_id": 10240, "verse_number": "१०-४४-३३", "content_sanskrit": "यस्मिन् जनः प्राणवियोगकाले क्षणं समावेश्य मनो विशुद्धम्।\nनिगृह्य कर्माशयमाशु याति परां गतिं ब्रह्ममयोऽर्कवर्णः॥ १०/४४/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.037.m4a", "display_order": 38}, {"id": 6000240038, "chapter_id": 10240, "verse_number": "१०-४४-३४", "content_sanskrit": "तस्मिन् भवन्तावखिलात्मयोनौ नारायणे कारणमर्त्यमूर्तौ।\nभावं व्यधत्तां नितरां महात्मन् किं वाऽवशिष्टं युवयोः सुकृत्यम्॥ १०/४४/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.038.m4a", "display_order": 39}, {"id": 6000240039, "chapter_id": 10240, "verse_number": "१०-४४-३५", "content_sanskrit": "आगमिष्यत्यदीर्घेण कालेन व्रजमच्युतः।\nप्रियं विधास्यते पित्रोर्भगवान् सात्वतां पतिः॥ १०/४४/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.039.m4a", "display_order": 40}, {"id": 6000240040, "chapter_id": 10240, "verse_number": "१०-४४-३६", "content_sanskrit": "हत्वां कंसं रङ्गमध्ये प्रतीपं सर्वसात्वताम्।\nयदाह वः समागम्य कृष्णः सत्यं करोति तत्॥ १०/४४/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.040.m4a", "display_order": 41}, {"id": 6000240041, "chapter_id": 10240, "verse_number": "१०-४४-३७", "content_sanskrit": "मा खिद्येतां महाभागौ द्रक्ष्यथः कृष्णमन्तिके।\nअन्तर्हृदि स भूतानामास्ते ज्योतिरिवैधसि॥ १०/४४/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.041.m4a", "display_order": 42}, {"id": 6000240042, "chapter_id": 10240, "verse_number": "१०-४४-३८", "content_sanskrit": "न ह्यस्यातिप्रियः कश्चिन्नाप्रियो वाऽस्त्यमानिनः।\nनोत्तमो नाधमो वाऽपि समानस्य समोऽपि वा॥ १०/४४/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.042.m4a", "display_order": 43}, {"id": 6000240043, "chapter_id": 10240, "verse_number": "१०-४४-३९", "content_sanskrit": "न माता न पिता तस्य न भार्या न सुतादयः।\nनात्मीयो न परश्चास्य न देहो जन्म कर्म वा॥ १०/४४/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.043.m4a", "display_order": 44}, {"id": 6000240044, "chapter_id": 10240, "verse_number": "१०-४४-४०", "content_sanskrit": "लोकेऽस्य जन्मकर्माणि सदसन्मिश्रयोनिषु।\nक्रीडार्थं सोऽपि साधूनां परित्राणाय कल्पते॥ १०/४४/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.044.m4a", "display_order": 45}, {"id": 6000240045, "chapter_id": 10240, "verse_number": "१०-४४-४१", "content_sanskrit": "सत्त्वं रजस्तम इति भजते निर्गुणो महान्।\nक्रीडन्ननीहोऽनुगुणैः सृजत्यवति हन्त्यजः॥ १०/४४/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.045.m4a", "display_order": 46}, {"id": 6000240046, "chapter_id": 10240, "verse_number": "१०-४४-४२", "content_sanskrit": "युवयोरेव नैवायमात्मजो भगवान् हरिः।\nसर्वेषामात्मजो ह्यात्मा पिता माता स ईश्वरः॥ १०/४४/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.046.m4a", "display_order": 47}, {"id": 6000240047, "chapter_id": 10240, "verse_number": "१०-४४-४३", "content_sanskrit": "दृष्टं श्रुतं भूतभवद्भविष्यत् स्थास्नु चरिष्णु महदल्पकं च।\nविनाऽच्युताद् वस्तुतया न चान्यत् स एव सर्वं परमार्थरूपः॥ १०/४४/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.047.m4a", "display_order": 48}, {"id": 6000240048, "chapter_id": 10240, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.048.m4a", "display_order": 49}, {"id": 6000240049, "chapter_id": 10240, "verse_number": "१०-४४-४४", "content_sanskrit": "एवं निशा सा ब्रुवतोर्व्यतीता नन्दस्य कृष्णानुचरस्य राजन्।\nगोप्यः समुत्थाय निरूप्य दीपान् वास्तून् समभ्यर्च्य दधीन्यमन्थन्॥ १०/४४/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.049.m4a", "display_order": 50}, {"id": 6000240050, "chapter_id": 10240, "verse_number": "१०-४४-४५", "content_sanskrit": "ता दीपदीप्तैर्मणिभिर्विरेजू रज्ज्वाविकर्षच्चलकङ्कणस्रजः।\nचलन्नितम्बस्तनहारकुण्डलत्विषत्कपोलारुणकुङ्कुमाननाः॥ १०/४४/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.050.m4a", "display_order": 51}, {"id": 6000240051, "chapter_id": 10240, "verse_number": "१०-४४-४६", "content_sanskrit": "उद्गायतीनामरविन्दलोचनं व्रजाङ्गनानां दिवमस्पृशद् ध्वनिः।\nदध्नश्च निर्मन्थनशब्दमिश्रितो निरस्यते येन दिशाममङ्गलम्॥ १०/४४/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.051.m4a", "display_order": 52}, {"id": 6000240052, "chapter_id": 10240, "verse_number": "१०-४४-४७", "content_sanskrit": "भगवत्युदिते सूर्ये व्रजद्वारि व्रजौकसः।\nदृष्ट्वा रथं शातकौम्भं कस्यायमिति चाब्रुवन्॥ १०/४४/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.052.m4a", "display_order": 53}, {"id": 6000240053, "chapter_id": 10240, "verse_number": "१०-४४-४८", "content_sanskrit": "अक्रूर आगतः किं वा यः कंसस्यार्थसाधकः।\nयेन नीतो मधुपुरीं कृष्णः कमललोचनः॥ १०/४४/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.053.m4a", "display_order": 54}, {"id": 6000240054, "chapter_id": 10240, "verse_number": "१०-४४-४९", "content_sanskrit": "किं साधयिष्यत्यस्माभिर्भर्तुः प्रेतस्य निष्कृतिम्।\nइति स्‍त्रीणां वदन्तीनामुद्धवोऽगात् कृताह्निकः॥ १०/४४/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_044/BhP_10.044.054.m4a", "display_order": 55}, {"id": 6000240055, "chapter_id": 10240, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे चतुश्चत्वारिंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]