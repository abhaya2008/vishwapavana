[{"id": 900007202, "chapter_id": 8534, "verse_number": "115.1", "content_sanskrit": "यद्युपाधिकृतं तदा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900007203, "chapter_id": 8534, "verse_number": "115.2", "content_sanskrit": "कथं च भेदो देहादेरात्मनो न प्रतीयते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900007204, "chapter_id": 8534, "verse_number": "115.3", "content_sanskrit": "अस्मृतौ पूर्वदेहस्य विज्ञानं तत्कथं भवेत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900007205, "chapter_id": 8534, "verse_number": "115.4", "content_sanskrit": "यदा देहान्तरज्ञानं देहैक्यावसितिः कुतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900007206, "chapter_id": 8534, "verse_number": "115.5", "content_sanskrit": "व्याप्तत्वादात्मनो देहे व्यवहारेष्वपाटवात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900007207, "chapter_id": 8534, "verse_number": "115.6", "content_sanskrit": "न हि प्रत्यक्षगानपि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900007208, "chapter_id": 8534, "verse_number": "115.7", "content_sanskrit": "न हि प्रत्यक्षगानपि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900007209, "chapter_id": 8534, "verse_number": "115.8", "content_sanskrit": "तच्चेन्नोत्तरगोचरम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900007210, "chapter_id": 8534, "verse_number": "115.9", "content_sanskrit": "आगमोऽपि हि सामान्ये सिद्धे प्रत्यक्षत