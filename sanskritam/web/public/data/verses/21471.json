[{"id": 7001471000, "chapter_id": 21471, "verse_number": "७-२-९-१", "content_sanskrit": "कृष्ण उवाच ।\nयुगावर्तेषु सर्वेषु योगाचार्यच्छलेन तु ।\nअवतारान्हि शर्वस्य शिष्यांश्च भगवन्वद॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001471001, "chapter_id": 21471, "verse_number": "७-२-९-२", "content_sanskrit": "उपमन्युरुवाच ।\nश्वेतः सुतारो मदनः सुहोत्रः कङ्क एव च ।\nलौगाक्षिश्च महामायो जैगीषव्यस्तथैव च॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001471002, "chapter_id": 21471, "verse_number": "७-२-९-३", "content_sanskrit": "दधिवाहश्च ऋषभो मुनिरुग्रो ऽत्रिरेव च ।\nसुपालको गौतमश्च तथा वेदशिरा मुनिः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001471003, "chapter_id": 21471, "verse_number": "७-२-९-४", "content_sanskrit": "गोकर्णश्च गुहावासी शिखण्डी चापरः स्मृतः ।\nजटामाली चाट्टहासो दारुको लांगुली तथा॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001471004, "chapter_id": 21471, "verse_number": "७-२-९-५", "content_sanskrit": "महाकालश्च शूली च डंडी मुण्डीश एव च ।\nसविष्णुस्सोमशर्मा च लकुलीश्वर एव च॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001471005, "chapter_id": 21471, "verse_number": "७-२-९-६", "content_sanskrit": "एते वाराह कल्पे ऽस्मिन्सप्तमस्यांतरो मनोः ।\nअष्टाविंशतिसंख्याता योगाचार्या युगक्रमात्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001471006, "chapter_id": 21471, "verse_number": "७-२-९-७", "content_sanskrit": "शिष्याः प्रत्येकमेतेषां चत्वारश्शांतचेतसः ।\nश्वेतादयश्च रुष्यांतांस्तान्ब्रवीमि यथाक्रमम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001471007, "chapter_id": 21471, "verse_number": "७-२-९-८", "content_sanskrit": "श्वेतश्श्वेतशिखश्चैव श्वेताश्वः श्वेतलोहितः ।\nदुन्दुभिश्शतरूपश्च ऋचीकः केतुमांस्तथा॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001471008, "chapter_id": 21471, "verse_number": "७-२-९-९", "content_sanskrit": "विकोशश्च विकेशश्च विपाशः पाशनाशनः ।\nसुमुखो दुर्मुखश्चैव दुर्गमो दुरतिक्रमः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001471009, "chapter_id": 21471, "verse_number": "७-२-९-१०", "content_sanskrit": "सनत्कुमारस्सनकः सनंदश्च सनातनः ।\nसुधामा विरजाश्चैव शंखश्चांडज एव च॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001471010, "chapter_id": 21471, "verse_number": "७-२-९-११", "content_sanskrit": "सारस्वतश्च मेघश्च मेघवाहस्सुवाहकः ।\nकपिलश्चासुरिः पञ्चशिखो बाष्कल एव च॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001471011, "chapter_id": 21471, "verse_number": "७-२-९-१२", "content_sanskrit": "पराशराश्च गर्गश्च भार्गवश्चांगिरास्तथा ।\nबलबन्धुर्निरामित्राः केतुशृंगस्तपोधनः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001471012, "chapter_id": 21471, "verse_number": "७-२-९-१३", "content_sanskrit": "लंबोदरश्च लंबश्च लम्बात्मा लंबकेशकः ।\nसर्वज्ञस्समबुद्धिश्च साध्यसिद्धिस्तथैव च॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001471013, "chapter_id": 21471, "verse_number": "७-२-९-१४", "content_sanskrit": "सुधामा कश्यपश्चैव वसिष्ठो विरजास्तथा ।\nअत्रिरुग्रो गुरुश्रेष्ठः श्रवनोथ श्रविष्टकः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001471014, "chapter_id": 21471, "verse_number": "७-२-९-१५", "content_sanskrit": "कुणिश्च कुणिबाहुश्च कुशरीरः कुनेत्रकः ।\nकाश्यपो ह्युशनाश्चैव च्यवनश्च बृहस्पतिः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001471015, "chapter_id": 21471, "verse_number": "७-२-९-१६", "content_sanskrit": "उतथ्यो वामदेवश्च महाकालो महा ऽनिलः ।\nवाचःश्रवाः सुवीरश्च श्यावकश्च यतीश्वरः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001471016, "chapter_id": 21471, "verse_number": "७-२-९-१७", "content_sanskrit": "हिरण्यनाभः कौशल्यो लोकाक्षिः कुथुमिस्तथा ।\nसुमन्तुर्जैमिनिश्चैव कुबन्धः कुशकन्धरः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001471017, "chapter_id": 21471, "verse_number": "७-२-९-१८", "content_sanskrit": "प्लक्षो दार्भायणिश्चैव केतुमान्गौतमस्तथा ।\nभल्लवी मधुपिंगश्च श्वेतकेतुस्तथैव च॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001471018, "chapter_id": 21471, "verse_number": "७-२-९-१९", "content_sanskrit": "उशिजो बृहदश्वश्च देवलः कविरेव च ।\nशालिहोत्रः सुवेषश्च युवनाश्वः शरद्वसुः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001471019, "chapter_id": 21471, "verse_number": "७-२-९-२०", "content_sanskrit": "अक्षपादः कणादश्च उलूको वत्स एव च ।\nकुलिकश्चैव गर्गश्च मित्रको रुष्य एव च॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001471020, "chapter_id": 21471, "verse_number": "७-२-९-२१", "content_sanskrit": "एते शिष्या महेशस्य योगाचार्यस्वरूपिणः ।\nसंख्या च शतमेतेषां सह द्वादशसंख्यया॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001471021, "chapter_id": 21471, "verse_number": "७-२-९-२२", "content_sanskrit": "सर्वे पाशुपताः सिद्धा भस्मोद्धूलितविग्रहाः ।\nसर्वशास्त्रार्थतत्त्वज्ञा वेदवेदांगपारगाः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001471022, "chapter_id": 21471, "verse_number": "७-२-९-२३", "content_sanskrit": "शिवाश्रमरतास्सर्वे शिवज्ञानपरायणाः ।\nसर्वे संगविनिर्मुक्ताः शिवैकासक्तचेतसः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001471023, "chapter_id": 21471, "verse_number": "७-२-९-२४", "content_sanskrit": "सर्वद्वंद्वसहा धीराः सर्वभूतहिते रताः ।\nऋजवो मृदवः स्वस्था जितक्रोधा जितेंद्रियाः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001471024, "chapter_id": 21471, "verse_number": "७-२-९-२५", "content_sanskrit": "रुद्राक्षमालाभरणास्त्रिपुंड्रांकितमस्तकाः ।\nशिखाजटास्सर्वजटा अजटा मुंडशीर्षकाः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001471025, "chapter_id": 21471, "verse_number": "७-२-९-२६", "content_sanskrit": "फलमूलाशनप्रायाः प्राणायामपरायणाः ।\nशिवाभिमानसंपन्नाः शिवध्यानैकतत्पराः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001471026, "chapter_id": 21471, "verse_number": "७-२-९-२७", "content_sanskrit": "समुन्मथितसंसारविषवृक्षांकुरोद्गमाः ।\nप्रयातुमेव सन्नद्धाः परं शिवपुरं प्रति॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001471027, "chapter_id": 21471, "verse_number": "७-२-९-२८", "content_sanskrit": "सदेशिकानिमान्मत्वा नित्यं यश्शिवमर्चयेत् ।\nस याति शिवसायुज्यं नात्र कार्या विचारणा॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]