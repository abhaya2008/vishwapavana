[{"id": 2212858, "chapter_id": 5539, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2212859, "chapter_id": 5539, "verse_number": "१", "content_sanskrit": "एवमुक्तास्तु ते तेन पौरजानपदा जनाः ।\nवृद्धेन राज्ञा कौरव्य नष्टसञ्ज्ञा इवाभवन्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2212860, "chapter_id": 5539, "verse_number": "२", "content_sanskrit": "तूष्णीम्भूतान् ततस्तांस्तु बाष्पकण्ठान् महीपतिः ।\nधृतराष्ट्रो महीपालः पुनरेवाभ्यभाषत\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2212861, "chapter_id": 5539, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2212862, "chapter_id": 5539, "verse_number": "३", "content_sanskrit": "वृद्धया हतपुत्र्या च धर्मपत्न्या सहानया ।\nविलपन्तं बहुविधं कृपणं चैव सत्तमाः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2212863, "chapter_id": 5539, "verse_number": "४", "content_sanskrit": "पित्रा चैवाभ्यनुज्ञातं कृष्णद्वैपायनेन वै ।\nवनवासाय धर्मज्ञा धर्मजेन नृपेण च\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2212864, "chapter_id": 5539, "verse_number": "५", "content_sanskrit": "सोऽहं पुनः पुनर्याचे शिरसा च नतोऽनघाः ।\nगान्धारीसहितं तस्मात् समनुज्ञातुमर्हथ\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2212865, "chapter_id": 5539, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2212866, "chapter_id": 5539, "verse_number": "६", "content_sanskrit": "श्रुत्वा तु कुरुराजस्य वाक्यानि करुणानि ते ।\nरुरुदुः सर्वतो राजन् समेताः कुरुजाङ्गलाः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2212867, "chapter_id": 5539, "verse_number": "७", "content_sanskrit": "उत्तरीयैः करैश्चापि सञ्छाद्य वदनानि ते ।\nकुरवः शोकसन्तप्ता मुहूर्तं पितृमातृवत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2212868, "chapter_id": 5539, "verse_number": "८", "content_sanskrit": "हृदयैः शून्यभूतैस्ते धृतराष्ट्रप्रवासजम् ।\nदुःखं सन्धारयन्ति स्म नष्टसञ्ज्ञाः समाहिताः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2212869, "chapter_id": 5539, "verse_number": "९", "content_sanskrit": "ते विनीय तमायासं कुरुराजवियोगजम् ।\nशनैः शनैस्तदाऽन्योन्यमब्रुवन् स्वमतान्युत\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2212870, "chapter_id": 5539, "verse_number": "१०", "content_sanskrit": "ततः सञ्चिन्त्य ते सर्वे वाक्यान्यथ समासतः ।\nएकस्मिन् ब्राह्मणे कार्यमावेश्योचुर्नराधिपम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2212871, "chapter_id": 5539, "verse_number": "११", "content_sanskrit": "तत्र स्वे चरणे वृद्धः सम्मतोऽर्थविशारदः ।\nशाकल्यो बह्वृचो राजन् वक्तुं समुपचक्रमे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2212872, "chapter_id": 5539, "verse_number": "१२", "content_sanskrit": "अनुमान्य महाराजं सदः समनुभाष्य च ।\nविप्रः प्रगल्भो मेधावी स राजानमुवाच ह\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2212873, "chapter_id": 5539, "verse_number": "", "content_sanskrit": "शाकल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2212874, "chapter_id": 5539, "verse_number": "१३", "content_sanskrit": "राजन् वाक्यं जनस्यास्य मयि सर्वं समर्पितम् ।\nवक्ष्यामि तदहं वीर तज्जुषस्व नराधिप\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2212875, "chapter_id": 5539, "verse_number": "१४", "content_sanskrit": "यथा वदसि राजेन्द्र सर्वमेतत् तथा विभो ।\nनात्र मिथ्या वचः किञ्चित् सुहृत्वं नः परस्परम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2212876, "chapter_id": 5539, "verse_number": "१५", "content_sanskrit": "न जात्वस्य तु वंशस्य राज्ञां किञ्चित् कदाचन ।\nराजाऽऽसीद् यः प्रजापालः प्रजानां न प्रियोऽभवत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2212877, "chapter_id": 5539, "verse_number": "१६", "content_sanskrit": "पितृवन्मातृवच्चैव भवन्तः पालयन्ति नः ।\nन च दुर्योधनः किञ्चिदयुक्तं कृतवान् नृप\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2212878, "chapter_id": 5539, "verse_number": "१७", "content_sanskrit": "(प्रियाणि कुर्वन् सर्वेषामनुवृत्त्यर्थमुद्यतः ।)\nयथाऽब्रवीत्तु धर्मज्ञो मुनिः सत्यवतीसुतः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2212879, "chapter_id": 5539, "verse_number": "१८", "content_sanskrit": "तथा कुरु महाराज स हि नः परमो गुरुः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2212880, "chapter_id": 5539, "verse_number": "१९", "content_sanskrit": "त्यक्ता वयं तु भवता दुःखशोकपरायणाः ।\nभविष्यामश्चिरं राजन् भवद्गुणशतैर्हृताः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2212881, "chapter_id": 5539, "verse_number": "२०", "content_sanskrit": "यथा शन्तनुना गुप्ता राज्ञा चित्राङ्गदेन च ।\nभीष्मवीर्योपगूढेन पित्रा च तव पार्थिव\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2212882, "chapter_id": 5539, "verse_number": "२१", "content_sanskrit": "भवद्बुद्धियुजा चैव पाण्डुना पृथिवीक्षिता ।\nतथा दुर्योधनेनापि राज्ञा स्म परिपालिताः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2212883, "chapter_id": 5539, "verse_number": "२२", "content_sanskrit": "न नः सोऽण्वपि पुत्रस्ते व्यलीकं कृतवान् नृप\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2212884, "chapter_id": 5539, "verse_number": "२३", "content_sanskrit": "पितरीव सुविश्वस्तास्तस्मिन्नपि नराधिपे ।\nवयमास्म यथा सम्यग्भवतो विदितं तथा\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2212885, "chapter_id": 5539, "verse_number": "२४", "content_sanskrit": "तथा वर्षसहस्राणि कुन्तीपुत्रेण धीमता ।\nपाल्यमाना धृतिमता सुखं विन्दामहे नृप\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2212886, "chapter_id": 5539, "verse_number": "२५", "content_sanskrit": "राजर्षीणां पुराणानां भवतां पुण्यकर्मणाम् ।\nकुरुसंवरणादीनां भरतस्य च धीमतः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2212887, "chapter_id": 5539, "verse_number": "२६", "content_sanskrit": "वृत्तं समनुयात्येष धर्मात्मा भूरिदक्षिणः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2212888, "chapter_id": 5539, "verse_number": "२७", "content_sanskrit": "नात्र वाच्यं महाराज सुसूक्ष्ममपि विद्यते\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2212889, "chapter_id": 5539, "verse_number": "२८", "content_sanskrit": "उषिताः स्म सुखं नित्यं भवता परिपालिताः ।\nसुसूक्ष्मं च व्यलीकं ते सपुत्रस्य न विद्यते\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2212890, "chapter_id": 5539, "verse_number": "२९", "content_sanskrit": "यत्तु ज्ञातिविमर्देऽस्मिन्नात्थ दुर्योधनं प्रति ।\nभवन्तमनुनेष्यामि तत्रापि कुरुनन्दन\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2212891, "chapter_id": 5539, "verse_number": "३०", "content_sanskrit": "न तद् दुर्योधनकृतं न च तद्भवता कृतम् ।\nन कर्णसौबलाभ्यां च कुरवो यत् क्षयं गताः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2212892, "chapter_id": 5539, "verse_number": "३१", "content_sanskrit": "दैवं तत्तु विजानीमो यन्न शक्यं प्रबाधितुम् ।\nदैवं पुरुषकारेण न शक्यमपि बाधितुम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2212893, "chapter_id": 5539, "verse_number": "३२", "content_sanskrit": "अक्षौहिण्यो महाराज दशाष्टौ च समागताः ।\nअष्टादशाहेन हता दशभिर्योधपुङ्गवैः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2212894, "chapter_id": 5539, "verse_number": "३३", "content_sanskrit": "भीष्मद्रोणकृपै राजन् कर्णेन च महात्मना ।\nयुयुधानेन वीरेण धृष्टद्युम्नेन चाहवे\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2212895, "chapter_id": 5539, "verse_number": "३४", "content_sanskrit": "चतुर्भिः पाण्डुपुत्रैश्च भीमार्जुनयमैर्नृप ।\nजनक्षयोऽयं नृपते कृतो दैवबलात् कृतैः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2212896, "chapter_id": 5539, "verse_number": "३५", "content_sanskrit": "अवश्यमेव सङ्ग्रामे क्षत्रियेण विशेषतः ।\nकर्तव्यं निधनं लोके क्षत्रेण हतबन्धुना\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2212897, "chapter_id": 5539, "verse_number": "३६", "content_sanskrit": "यैरियं पुरुषव्याघ्रैर्विद्याबाहुबलान्वितैः ।\nपृथिवी निहता सर्वा सरथा सहयद्विपा\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2212898, "chapter_id": 5539, "verse_number": "३७", "content_sanskrit": "न च राजाऽपराध्नोति पुत्रस्तव महामनाः ।\nन भवान् न च ते भृत्या न कर्णो न च सौबलः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2212899, "chapter_id": 5539, "verse_number": "३८", "content_sanskrit": "यद्विनष्टाः कुरुक्षेत्रे राजानश्च सहस्रशः ।\nसर्वे दैवकृते यद्वै कोऽत्र किं वक्तुमर्हति\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2212900, "chapter_id": 5539, "verse_number": "३९", "content_sanskrit": "गुरुर्मतो भवानस्य कृत्स्नस्य जगतः प्रभुः ।\nधर्मात्मानमतस्तुभ्यमनुजानीमहे सुतम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2212901, "chapter_id": 5539, "verse_number": "४०", "content_sanskrit": "लभतां वीरलोकं स ससहायो नराधिपः ।\nद्विजाग्र्यैः समनुज्ञातः त्रिदिवे मोदतां सुखम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2212902, "chapter_id": 5539, "verse_number": "४१", "content_sanskrit": "प्राप्स्यते च भवान् पुण्यं धर्मेण सततं स्थितः ।\nवेद धर्मं महाबाहो लौक्यं वैदिकमेव च\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2212903, "chapter_id": 5539, "verse_number": "४२", "content_sanskrit": "दृष्टापदानाश्चास्माभिः पाण्डवाः पुरुषर्षभाः ।\nसमर्थास्त्रिदिवस्यापि पालने किं पुनः क्षितेः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2212904, "chapter_id": 5539, "verse_number": "४३", "content_sanskrit": "अनुवत्स्यन्ति कौरव्याः समेषु विषमेषु च ।\nप्रजाः कुरुकुलश्रेष्ठ पाण्डवान् शीलभूषणान्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2212905, "chapter_id": 5539, "verse_number": "४४", "content_sanskrit": "ब्रह्मदेयाग्रहारांश्च परिहारांश्च पार्थिवः ।\nपूर्वराजनिसर्गांश्च पालयत्येव पाण्डवः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2212906, "chapter_id": 5539, "verse_number": "४५", "content_sanskrit": "दीर्घदर्शी कृतप्रज्ञः सदा वैश्रवणो यथा ।\nअक्षुद्रसचिवश्चायं कुन्तीपुत्रो महामनाः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2212907, "chapter_id": 5539, "verse_number": "४६", "content_sanskrit": "अप्यमित्रे दयावांश्च शुचिश्च भरतर्षभ ।\nऋजुः पश्यति मेधावी पुत्रवत् पाति नः सदा\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2212908, "chapter_id": 5539, "verse_number": "४७", "content_sanskrit": "विप्रियं च जनस्यास्य संसर्गाद् धर्मजस्य वै ।\nन करिष्यति राजर्षे तथा भीमार्जुनादयः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2212909, "chapter_id": 5539, "verse_number": "४८", "content_sanskrit": "मन्दा मृदुषु कौरव्यास्तीक्ष्णेष्वाशीविषोपमाः ।\nवीर्यवन्तो महात्मानः पौराणां च हिते रताः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2212910, "chapter_id": 5539, "verse_number": "४९", "content_sanskrit": "न कुन्ती न च पाञ्चाली न चोलूपी न सात्वती ।\nअस्मिन् जने करिष्यन्ति प्रतिकूलानि कर्हिचित्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2212911, "chapter_id": 5539, "verse_number": "५०", "content_sanskrit": "भवत्कृतमिदं स्नेहं युधिष्ठिरविवर्धितम् ।\nन पृष्ठतः करिष्यन्ति पौरजानपदा जनाः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2212912, "chapter_id": 5539, "verse_number": "५१", "content_sanskrit": "अधर्मिष्ठानपि सतः कुन्तीपुत्रा महारथाः ।\nमानवान् पालयिष्यन्ति भूत्वा धर्मपरायणाः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2212913, "chapter_id": 5539, "verse_number": "५२", "content_sanskrit": "स राजन् मानसं दुःखमपनीय युधिष्ठिरात् ।\nकुरु कार्याणि धर्माणि नमस्ते भरतर्षभ\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2212914, "chapter_id": 5539, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2212915, "chapter_id": 5539, "verse_number": "५३", "content_sanskrit": "तस्य तद्वचनं धर्म्यमनुमान्य गुणोत्तरम् ।\nसाधु साध्विति सर्वः स जनः प्रतिगृहीतवान्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2212916, "chapter_id": 5539, "verse_number": "५४", "content_sanskrit": "धृतराष्ट्रस्तु तद्वाक्यमभिपूज्य पुनः पुनः ।\nविसर्जयामास तदा सर्वास्तु प्रकृतीः शनैः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2212917, "chapter_id": 5539, "verse_number": "५५", "content_sanskrit": "स तैः सम्पूजितो राजा शिवेनावेक्षितस्तदा ।\nप्राञ्जलिः पूजयामास तं जनं भरतर्षभ\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2212918, "chapter_id": 5539, "verse_number": "५६", "content_sanskrit": "ततो विवेश भवनं गान्धारीसहितो नृपः ।\nआगतायां च शर्वर्यां सुखं शेते नराधिपः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2212919, "chapter_id": 5539, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nआश्रमवासिकपर्वणि धृतराष्ट्रतपोवासाभ्यनुज्ञा नाम पञ्चदशोऽध्यायः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2212920, "chapter_id": 5539, "verse_number": "", "content_sanskrit": "आश्रमवासपर्वणि पञ्चदशोऽध्यायः ॥१५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]