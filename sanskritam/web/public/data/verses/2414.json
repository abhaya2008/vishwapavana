[{"id": 2067187, "chapter_id": 2414, "verse_number": "९-३२-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2067188, "chapter_id": 2414, "verse_number": "९-३२-१", "content_sanskrit": "एवं सन्तर्ज्यमानस्तु मम पुत्रो महीपतिः।\nप्रकृत्या मन्युमान्वीरः कथमासीत्परन्तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2067189, "chapter_id": 2414, "verse_number": "९-३२-२", "content_sanskrit": "न हि सन्तर्जना तेन श्रुतपूर्वा कथञ्चन।\nराजभावेन मान्यश्च सर्वलोकस्य सोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2067190, "chapter_id": 2414, "verse_number": "९-३२-३", "content_sanskrit": "[यस्यातपत्रच्छायापि स्वका भानोस्तथा प्रभा।\nखेदायैवाभिमानित्वात्सहेत्सैवं कथं गरिः॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2067191, "chapter_id": 2414, "verse_number": "९-३२-४", "content_sanskrit": "इयं च पृथिवी सर्वा सम्लेच्छाटविका भृशम्।\nप्रसादाद्भ्रियते यस्य प्रत्यक्षं तव सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2067192, "chapter_id": 2414, "verse_number": "९-३२-५", "content_sanskrit": "स तथा तर्ज्यमानस्तु पाण्डुपुत्रैर्विशेषतः।\nविहीनश्च स्वकैर्भृत्यैर्निर्जिते चावृतो भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2067193, "chapter_id": 2414, "verse_number": "९-३२-६", "content_sanskrit": "स श्रुत्वा कटुका वाचो जययुक्ताः पुनःपुनः।\nकिमब्रवीत्पाण्डवेयांस्तन्ममाचक्ष्व सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2067194, "chapter_id": 2414, "verse_number": "९-३२-७x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2067195, "chapter_id": 2414, "verse_number": "९-३२-७", "content_sanskrit": "तर्ज्यमानस्तदा राजन्नुदकस्थस्तवात्मजः।\nयुधिष्ठिरेण राजेन्द्र भ्रातृभिः सहितेन ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2067196, "chapter_id": 2414, "verse_number": "९-३२-८", "content_sanskrit": "श्रुत्वा स कटुका वाचो विषमस्थो नराधिपः।\nदीर्घमुष्णं च निःश्वस्य सलिलस्थः पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2067197, "chapter_id": 2414, "verse_number": "९-३२-९", "content_sanskrit": "सलिलान्तर्गतो राजा धुन्वन्हस्तौ पुनःपुनः।\nमनश्चकार युद्धाय राजानं चाभ्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2067198, "chapter_id": 2414, "verse_number": "९-३२-१०", "content_sanskrit": "यूयं ससुहृदः पार्थाः सर्वे सरथवाहनाः।\nअहमेकः परिद्यूनो विरथो हतवाहनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2067199, "chapter_id": 2414, "verse_number": "९-३२-११", "content_sanskrit": "आत्तशस्त्रै रथोपेतैर्बहुभिः परिवास्तिः।\nकथमेकः पदातिः सन्नशस्त्रो योद्धुमुत्सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2067200, "chapter_id": 2414, "verse_number": "९-३२-१२", "content_sanskrit": "एकैकशश्च मां यूयं योधयध्वं युधिष्ठिर।\nन ह्येको बहुभिर्वीरैर्न्याय्यो योधयितुं युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2067201, "chapter_id": 2414, "verse_number": "९-३२-१३", "content_sanskrit": "विशेषतो विकवचः श्रान्तश्चापत्समाश्रितः।\nभृशं विक्षतगात्रश्च श्रान्तवाहनसैनिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2067202, "chapter_id": 2414, "verse_number": "९-३२-१४", "content_sanskrit": "न मे त्वत्तो भयं राजन्न च पार्थाद्वृकोदरात्।\nफल्गुनाद्वासुदेवाद्वा पाञ्चालेभ्योऽथवा पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2067203, "chapter_id": 2414, "verse_number": "९-३२-१५", "content_sanskrit": "यमाभ्यां युयुधानाद्वा ये चान्ये तव सैनिकाः।\nएकः सर्वानहं क्रुद्धो वारयिष्ये युधि स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2067204, "chapter_id": 2414, "verse_number": "९-३२-१६", "content_sanskrit": "धर्ममूला सतां कीर्तिर्मनुष्याणां जनाधिप।\nधर्मं चैवेह कीर्तिं च पालयन्प्रब्रवीम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2067205, "chapter_id": 2414, "verse_number": "९-३२-१७", "content_sanskrit": "अहमुत्थाय सर्वान्वै प्रतियोत्स्यामि संयुगे।\nअन्वभ्याशं गतान्सर्वान्निहनिष्यामि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2067206, "chapter_id": 2414, "verse_number": "९-३२-१८", "content_sanskrit": "अद्य वः सरथान्साश्वानशस्त्रो विरथोऽपि सन्।\nनक्षत्राणीव सर्वाणि सविता रात्रिसंक्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2067207, "chapter_id": 2414, "verse_number": "९-३२-१९", "content_sanskrit": "तेजसा नाशयिष्यामि स्थिरीभवत पाण़्डवाः।\nअद्यानृण्यं गमिष्यामि क्षत्रियाणां यशस्विनां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2067208, "chapter_id": 2414, "verse_number": "९-३२-२०", "content_sanskrit": "बाह्लीकद्रोणभीष्माणां कर्णस्य च महात्मनः।\nजयद्रथस्य शूरस्य भगदत्तस्य चोभयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2067209, "chapter_id": 2414, "verse_number": "९-३२-२१", "content_sanskrit": "मद्रराजस्य शल्यस्य भूरिश्रवस एव च।\nपुत्राणां भरतश्रेष्ठ शकुनेः सौबलस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2067210, "chapter_id": 2414, "verse_number": "९-३२-२२", "content_sanskrit": "मेत्राणां सुहृदां चैव बान्धवानां तथैव च।\nप्रानृण्यमद्य गच्छामि हत्वा त्वां भ्रातृभिः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2067211, "chapter_id": 2414, "verse_number": "९-३२-२३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2067212, "chapter_id": 2414, "verse_number": "९-३२-२३", "content_sanskrit": "एतावदुक्त्वा वचनं विरराम जनाधिपः।\n`सलिलान्तर्गतः श्रीमान्पुत्रो दुर्योधनस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2067213, "chapter_id": 2414, "verse_number": "९-३२-२४x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2067214, "chapter_id": 2414, "verse_number": "९-३२-२४", "content_sanskrit": "दिष्ट्या त्वमपि जानीषे क्षत्रधर्मं सुयोधन।\nदिष्ट्या ते वर्तते बुद्धिर्युद्धायैव महाभुज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2067215, "chapter_id": 2414, "verse_number": "९-३२-२५", "content_sanskrit": "दिष्ट्या शूरोऽसि गान्धारे दिष्ट्या जानासि सङ्गरम्।\nयस्त्वमेको हि नः सर्वान्सङ्गरे योद्भुमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2067216, "chapter_id": 2414, "verse_number": "९-३२-२६", "content_sanskrit": "एक एकेन सङ्गम्य यत्ते सम्मतमायुधम्।\nतत्त्वमादाय युध्यस्व प्रेक्षकास्ते वयं स्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2067217, "chapter_id": 2414, "verse_number": "९-३२-२७", "content_sanskrit": "अयमिष्टं च ते कामं वीर भूयो ददाम्यहम्।\nहत्वैकं भव नो राजा हतो वा स्वर्गमाप्नुहि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2067218, "chapter_id": 2414, "verse_number": "९-३२-२८x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2067219, "chapter_id": 2414, "verse_number": "९-३२-२८", "content_sanskrit": "एकश्चेद्योद्भुमाक्रन्दे वरोऽद्य मम दीयताम्।\nआयुधानामियं चापि मता मे सतं गदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2067220, "chapter_id": 2414, "verse_number": "९-३२-२९", "content_sanskrit": "भ्रातणां भवतामेकः शक्यं मां योऽभिमन्यते।\nपदातिर्गदया सङ्ख्ये स युध्यतु मया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2067221, "chapter_id": 2414, "verse_number": "९-३२-३०", "content_sanskrit": "वृत्तानि रथयुद्धानि विचित्रामि पदेपदे।\nइदमेकं गदायुद्धं भवत्वद्याद्भुतं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2067222, "chapter_id": 2414, "verse_number": "९-३२-३१", "content_sanskrit": "अन्नानामपि पर्यायं कर्तुमिच्छन्ति मानवाः।\nयुद्धानामपि पर्यायो भवत्वनुमते तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2067223, "chapter_id": 2414, "verse_number": "९-३२-३२", "content_sanskrit": "गदया त्वां महाबाहो विजेष्यामि सहानुजम्।\nपाञ्चालान्सृञ्जयांश्चैव ये चान्ये तव सैनिकाः।\nन हि मे सम्भ्रामो जातु शक्रादपि युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2067224, "chapter_id": 2414, "verse_number": "९-३२-३३x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2067225, "chapter_id": 2414, "verse_number": "९-३२-३३", "content_sanskrit": "उत्तिष्ठोत्तिष्ठ गान्धारे मां योधय सुयोधन।\nएक एकेन सङ्गम्य संयुगे गदया बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2067226, "chapter_id": 2414, "verse_number": "९-३२-३४", "content_sanskrit": "पुरुषो भव गान्धारे युध्यस्व सुसमाहितः।\nअद्य ते जीवितं नास्ति यदीन्द्रोपि तवाश्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2067227, "chapter_id": 2414, "verse_number": "९-३२-३५x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2067228, "chapter_id": 2414, "verse_number": "९-३२-३५", "content_sanskrit": "एतत्स नरशार्दूलो नामृष्यत तवात्मजः।\nसलिलान्तर्गतः श्वभ्रे महानाग इव श्वसन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2067229, "chapter_id": 2414, "verse_number": "९-३२-३६", "content_sanskrit": "तथाऽसौ वाक्प्रतोदेन तुद्यमानः पुनःपुनः।\nवचो न ममृषे राजन्नुत्तमाश्वः कशामिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2067230, "chapter_id": 2414, "verse_number": "९-३२-३७", "content_sanskrit": "सङ्क्षोभ्य सलिलं वेगाद्गदामादाय वीर्यवान्।\nअद्रिसारमयीं गुर्वीं काञ्चनाङ्गदभूषणाम्।\nअन्तर्जलात्समुत्तस्थौ नागेन्द्र इव निःश्वसन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2067231, "chapter_id": 2414, "verse_number": "९-३२-३८", "content_sanskrit": "स भित्त्वा स्तम्भितं तोयं स्कन्धे कृत्वायसीं गदाम्।\nउदतिष्ठत पुत्रस्ते प्रतपन्रश्मिवानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2067232, "chapter_id": 2414, "verse_number": "९-३२-३९", "content_sanskrit": "ततः शैक्यायसीं गुर्वी जातरूपपरिष्कृताम्।\nगदां परामृशद्धीमान्धार्तराष्ट्रो महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2067233, "chapter_id": 2414, "verse_number": "९-३२-४०", "content_sanskrit": "गदाहस्तं तु तं दृष्ट्वा सशृङ्गमिव पर्वतम्।\nप्रजानामिव सङ्क्रुद्धं शूलपाणिमिव स्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2067234, "chapter_id": 2414, "verse_number": "९-३२-४१", "content_sanskrit": "*सगदो भारतो भाति प्रतपन्भास्करो यथा*॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2067235, "chapter_id": 2414, "verse_number": "९-३२-४२", "content_sanskrit": "तमुत्तीर्णं महाबाहुं गदाहस्तमरिन्दमम्।\nमेनिरे सर्वभूतानि दण्डपाणिमिवान्तकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2067236, "chapter_id": 2414, "verse_number": "९-३२-४३", "content_sanskrit": "वज्रहस्तं यथा शक्रं शूलहस्तं यथा हरम्।\nददृशुः शर्वपाञ्चालाः पुत्रं तव जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2067237, "chapter_id": 2414, "verse_number": "९-३२-४४", "content_sanskrit": "तमुत्तीर्णं तु सम्प्रेक्ष्य समहृष्यन्त सर्वशः।\nपाञ्चालाः पाण्डवेयाश्च तेऽन्योन्यस्य तलान्ददुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2067238, "chapter_id": 2414, "verse_number": "९-३२-४५", "content_sanskrit": "अवहासं तु तं मत्वा पुत्रो दुर्योधनस्तव।\nउद्वृत्य नयने क्रुद्धो दिधक्षुरिव पाण्डवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2067239, "chapter_id": 2414, "verse_number": "९-३२-४६", "content_sanskrit": "त्रिशिखां भ्रुकुटीं कृत्वा सन्दष्टदशनच्छदः।\nप्रत्युवाच ततस्तान्वै पाण्डवान्सह केशवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2067240, "chapter_id": 2414, "verse_number": "९-३२-४७x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2067241, "chapter_id": 2414, "verse_number": "९-३२-४७", "content_sanskrit": "अस्यावहासस्य फलं प्रतिमोक्ष्यथ पाण्डवाः।\nगमिष्यथ हताः सद्यः सपाञ्चाला यमक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2067242, "chapter_id": 2414, "verse_number": "९-३२-४८", "content_sanskrit": "उत्थिन्तश्च जलात्तस्मात्पुत्रो दुर्योधनस्तव।\nअतिष्ठत गदापाणी रुधिरेण समुक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2067243, "chapter_id": 2414, "verse_number": "९-३२-४९", "content_sanskrit": "तस्य शोणितदिग्धस्य सलिलेन समुक्षितम्।\nशरीरं स्म तदा भाति स्रवन्निव महीधारः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2067244, "chapter_id": 2414, "verse_number": "९-३२-५०", "content_sanskrit": "तमुद्यतगदं वीरं मेनिरे तत्र पाण्डवाः।\nवैवस्वतमिव क्रुद्धं शूलपाणिमिव स्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2067245, "chapter_id": 2414, "verse_number": "९-३२-५१", "content_sanskrit": "स मेघनिनदो हर्षान्नर्दन्निव च गोवृषः।\nआजुहाव ततः पार्थान्गदया युधि वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2067246, "chapter_id": 2414, "verse_number": "९-३२-५२x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2067247, "chapter_id": 2414, "verse_number": "९-३२-५२", "content_sanskrit": "एकैकेन च मां यूयमासीदत युधिष्ठिर।\nन ह्येको बहुभिर्न्याय्यो वीरो योधयितुं युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2067248, "chapter_id": 2414, "verse_number": "९-३२-५३", "content_sanskrit": "न्यस्तवर्मा विशेषेण श्रान्तश्चाप्सु परिप्लुतः।\nभृशं विक्षतगात्रश्च हतवाहनसैनिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2067249, "chapter_id": 2414, "verse_number": "९-३२-५४", "content_sanskrit": "[अवश्यमेव योद्वव्यं सर्वैरेव मया सह।\nयुक्तं त्वयुक्तमित्येतद्वेत्सि त्वं चैव सर्वदा]॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2067250, "chapter_id": 2414, "verse_number": "९-३२-५५x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2067251, "chapter_id": 2414, "verse_number": "९-३२-५५", "content_sanskrit": "मा भूदियं तव प्रज्ञा कथमेकं सुयोधन।\nयदाऽभिमन्युं बहवो जघ्नुर्युधि महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2067252, "chapter_id": 2414, "verse_number": "९-३२-५६", "content_sanskrit": "[क्षत्रधर्मं भृशं क्रूरं निरपेक्षं सुनिर्घृणम्।\nअन्यथा तु कथं हन्युरभिमन्युं तथागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2067253, "chapter_id": 2414, "verse_number": "९-३२-५७", "content_sanskrit": "सर्वे भवन्तो धर्मज्ञाः सर्वे शूरास्तनुत्यजः।\nन्यायेन युध्यतां प्रोक्ता शक्रलोकगतिः परा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2067254, "chapter_id": 2414, "verse_number": "९-३२-५८", "content_sanskrit": "यद्येकस्तु न हन्तव्यो बहुभिर्धर्म एव तु।\nतदाऽभिमन्युं बहवो निजघ्नुस्त्वन्मते कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2067255, "chapter_id": 2414, "verse_number": "९-३२-५९", "content_sanskrit": "सर्वो विमृशते जन्तुः कृच्छ्रस्थो धर्मदर्शनम्।\nपदस्थः पिहितं द्वारं परलोकस्य पश्यति॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2067256, "chapter_id": 2414, "verse_number": "९-३२-६०", "content_sanskrit": "आमुञ्च कवचं वीर मूर्धजान्यमयस्व च।\nयच्चान्यदपि ते नास्ति तदप्यादत्स्व भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2067257, "chapter_id": 2414, "verse_number": "९-३२-६१", "content_sanskrit": "इममेकं च ते कामं वीर भूयो ददाम्यहम्।\nपञ्चानां पाण़्डवेयानां येन त्वं योद्धुमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2067258, "chapter_id": 2414, "verse_number": "९-३२-६२", "content_sanskrit": "तं हत्वा वै भवाराजा हतो वा स्वर्गमाप्नुहि।\nऋते च जीविताद्वीर युद्धे किं कुर्म ते प्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2067259, "chapter_id": 2414, "verse_number": "९-३२-६३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2067260, "chapter_id": 2414, "verse_number": "९-३२-६३", "content_sanskrit": "ततस्तव सुतो राजन्वर्म जग्राह काञ्चनम्।\nविचित्रं च शिरस्त्राणं जाम्बूनदपरिष्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2067261, "chapter_id": 2414, "verse_number": "९-३२-६४", "content_sanskrit": "सोऽवबद्वशिरस्त्राणः शुभकाञ्चनवर्मभृत्।\nरराज राजन्पुत्रस्ते काञ्चनः शैलराडिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2067262, "chapter_id": 2414, "verse_number": "९-३२-६५", "content_sanskrit": "सन्नद्धः सगतो राजन्सज्जः सङ्ग्राममूर्धनि।\nअब्रवीत्पाण़्डवान्सर्वान्पुत्रो दुर्योधनस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2067263, "chapter_id": 2414, "verse_number": "९-३२-६६", "content_sanskrit": "भ्रातॄणां भवतामेको युध्यतां गदया मया।\nसहदेवेन वा योत्स्ये भीमेन नकुलेन वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2067264, "chapter_id": 2414, "verse_number": "९-३२-६७", "content_sanskrit": "अथवा फल्गुनेनाद्य त्वया वा भरतर्षभ।\nयोत्स्येऽहं सङ्गरं प्राप्य विजेष्ये च रणाजिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2067265, "chapter_id": 2414, "verse_number": "९-३२-६८", "content_sanskrit": "अहमद्य गमिष्यामि वैरस्यान्तं सुदुर्गमम्।\nगदया पुरुषव्याघ्र हेमपट्टनिबद्धया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2067266, "chapter_id": 2414, "verse_number": "९-३२-६९", "content_sanskrit": "गदायुद्धे न मे कश्चित्सदृशोऽस्तीति चिन्तये।\nगदया वो हनिष्यामि सर्वानेव समागतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2067267, "chapter_id": 2414, "verse_number": "९-३२-७०", "content_sanskrit": "न मे समर्थाः सर्वे वै योद्धुं न्यायेन केचन।\nन युक्तमात्मना वक्तुमेवं गर्वोद्धतं वचः।\nअथवा सफलं ह्येतत्करिष्ये भवतां पुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2067268, "chapter_id": 2414, "verse_number": "९-३२-७१", "content_sanskrit": "अस्मिन्महूर्ते सत्यं वा मिथ्या वै तद्भविष्यति।]\nगृह्णातु च गदां यो वै योत्स्यतेऽद्य मया सह॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2067269, "chapter_id": 2414, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि द्वात्रिंशोऽध्यायः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}]