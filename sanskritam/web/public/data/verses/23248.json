[{"id": 7003248000, "chapter_id": 23248, "verse_number": "१-५१-१", "content_sanskrit": "सूत उवाच  ।\nदेवकूटे गिरौ मध्ये महाकूटे सुशोभने  ।\nहेमवैडूर्यमाणिक्यनीलगोमेदकांतिभिः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003248001, "chapter_id": 23248, "verse_number": "१-५१-२", "content_sanskrit": "तथान्यैर्मणिमुख्यैश्च निर्मिते निर्मले शुभे  ।\nशाखाशत सहस्राढ्ये सर्वद्रुमविभूषिते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003248002, "chapter_id": 23248, "verse_number": "१-५१-३", "content_sanskrit": "चंपकाशोकपुंनागवकुलासनमंडिते  ।\nपारिजातकसंपूर्णे नानापक्षिगणान्विते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003248003, "chapter_id": 23248, "verse_number": "१-५१-४", "content_sanskrit": "नैकधातुशतैश्चित्रे विचित्रकुसुमाकुले  ।\nनितंबपुष्पसालंबे नैकसत्त्वगणान्विते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003248004, "chapter_id": 23248, "verse_number": "१-५१-५", "content_sanskrit": "विमलस्वादुपनीये नैकप्रस्रवणैर्युते  ।\nनिर्झरैः कुसुमाकीर्णैरनेकैश्च विभूषिते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003248005, "chapter_id": 23248, "verse_number": "१-५१-६", "content_sanskrit": "पुष्पोडुपवहाभिश्च स्रवंतीभिरलंकृते  ।\nस्निग्धवर्णं महामूलमनेकस्कंधपादपम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003248006, "chapter_id": 23248, "verse_number": "१-५१-७", "content_sanskrit": "रम्यं ह्यविरलच्छायं दशयोजन मंडलम्  ।\nतत्र भूतवनं नाम नानाभूतगणालयम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003248007, "chapter_id": 23248, "verse_number": "१-५१-८", "content_sanskrit": "महादेवस्य देवस्य शंकरस्य महात्मनः  ।\nदीप्तमायतनं तत्र महामणिविभूषितम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003248008, "chapter_id": 23248, "verse_number": "१-५१-९", "content_sanskrit": "हेमप्राकारसंयुक्तं मणितोरणमंडितम्  ।\nस्फाटिकैश्च विचित्रैस्च गोपुरैश्च समन्वितम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003248009, "chapter_id": 23248, "verse_number": "१-५१-१०", "content_sanskrit": "सिंहासनैर्मणिमयैः शुभास्तरणसंयुतैः  ।\nक्षितावितस्ततः सम्यक् शर्वेणाधिष्ठितैः शुभैः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003248010, "chapter_id": 23248, "verse_number": "१-५१-११", "content_sanskrit": "अम्लानमालानिचितैर्नानावर्णैर्गृहोत्तमैः  ।\nमंडपैः सुविचित्रैस्तु स्फाटिकस्तंभसंयुतैः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003248011, "chapter_id": 23248, "verse_number": "१-५१-१२", "content_sanskrit": "संयुतं सर्वभूतेन्द्रैर्ब्रह्मेन्द्रोपेन्द्रपूजितैः  ।\nवराहगज सिंहर्क्षशार्दूलकरभाननैः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003248012, "chapter_id": 23248, "verse_number": "१-५१-१३", "content_sanskrit": "गृध्रोलूकमुखैश्चान्यैर्मृगोष्ट्राजमुखैरपि  ।\nप्रमथैर्विविधैः स्थूलैर्गिरिकूटोपमैः शुभैः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003248013, "chapter_id": 23248, "verse_number": "१-५१-१४", "content_sanskrit": "करालैर्हरिकेशैश्च रोमशैश्च महाभुजैः  ।\nनानावर्णाकृतिधरैर्नानासंस्थानसंस्थितैः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003248014, "chapter_id": 23248, "verse_number": "१-५१-१५", "content_sanskrit": "दीप्तास्यैर्दीप्तचरितैर्नन्दीश्वरमुखैः शुभैः  ।\nब्रह्मेन्द्रविष्णुसंकाशैरणिमादि गुणान्वितैः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003248015, "chapter_id": 23248, "verse_number": "१-५१-१६", "content_sanskrit": "अशून्यममरैर्नित्यं महापरिषदैस्तथा  ।\nतत्र भूतपतेर्देवाः पूजां नित्यं प्रयुंजते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003248016, "chapter_id": 23248, "verse_number": "१-५१-१७", "content_sanskrit": "झर्झरैः शंखपटहैर्भेरीडिंडिम गौमुखैः  ।\nललितावसितोद्गीतैर्वृत्तवल्गितगर्जितैः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003248017, "chapter_id": 23248, "verse_number": "१-५१-१८", "content_sanskrit": "पूजितो वै महादेवः प्रमथैः प्रमथेश्वरः  ।\nसिद्धर्षिदेवगंधर्वैर्ब्रह्मणा च महात्मना ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003248018, "chapter_id": 23248, "verse_number": "१-५१-१९", "content_sanskrit": "उपेन्द्रप्रमुखैश्चान्यैः पूजितस्तत्र शकरः  ।\nविभक्तचारुशिखरं यत्र तच्छंखवर्चसम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003248019, "chapter_id": 23248, "verse_number": "१-५१-२०", "content_sanskrit": "कैलासो यक्षराजस्य कुबेरस्य महात्मनः  ।\nनिवालः कोटियक्षाणां तथान्येषां महात्मनाम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003248020, "chapter_id": 23248, "verse_number": "१-५१-२१", "content_sanskrit": "तत्रापि देवदेवस्य भवस्यायतनं महत्  ।\nतस्मिन्नायतने सोमः सदास्ते सगणो हरः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003248021, "chapter_id": 23248, "verse_number": "१-५१-२२", "content_sanskrit": "यत्र मंदाकिनी नाम नलिनी विपुलोदका  ।\nसवर्णमणिसोपाना कुबेरशिखरे शुभे ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003248022, "chapter_id": 23248, "verse_number": "१-५१-२३", "content_sanskrit": "जांबूनदमयैः पद्मैर्गंधस्पर्शगुणान्वितैः  ।\nनीलवैडूर्यपत्रैश्च गंधोपेतैर्महोत्पलैः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003248023, "chapter_id": 23248, "verse_number": "१-५१-२४", "content_sanskrit": "तथा कुमुदषण्डैश्च महापद्मैरलंकृता  ।\nयक्षगंधर्वनारीभिरप्सरोभिश्च सेविता ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003248024, "chapter_id": 23248, "verse_number": "१-५१-२५", "content_sanskrit": "देवदानवगंधर्वैर्यक्षराक्षसकिन्नरैः  ।\nउपस्पृष्टजला पुण्या नदी मंदाकिनी शुभा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003248025, "chapter_id": 23248, "verse_number": "१-५१-२६", "content_sanskrit": "तस्याश्चोत्तरपार्श्वे तु भवस्यायतनं शुभम्  ।\nवैडूर्यमणिसंपन्नं तत्रास्ते शंकरोऽव्ययः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003248026, "chapter_id": 23248, "verse_number": "१-५१-२७", "content_sanskrit": "द्विजाः कनकनंदायास्तीरे वै प्राचिदक्षिणे  ।\nवनं द्विजसहस्राढ्यं मृगपक्षिसमाकुलम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003248027, "chapter_id": 23248, "verse_number": "१-५१-२८", "content_sanskrit": "तत्रापि सगणः सांबः क्रीडतोद्रिसमे गृहे  ।\nनंदायाः पश्चिमे तीरे किंचिद्वै दक्षिणाश्रिते ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003248028, "chapter_id": 23248, "verse_number": "१-५१-२९", "content_sanskrit": "पुरं रुद्रपुरी नाम नानाप्रासादसंकुलम्  ।\nतत्रापि शतधा कृत्वा ह्यात्मानं चांबया सह ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003248029, "chapter_id": 23248, "verse_number": "१-५१-३०", "content_sanskrit": "क्रीडते सगणः सांबस्तच्छिवालयमुच्यते  ।\nएवं शतसहस्राणि शर्वस्यायतनानि तु ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003248030, "chapter_id": 23248, "verse_number": "१-५१-३१", "content_sanskrit": "प्रतिद्वीपे मुनिश्रेष्ठः पर्वतेषु वनेषु च  ।\nनदीनदतटाकानां तीरेष्वर्णवसांधिषु ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]