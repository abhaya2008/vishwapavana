[{"id": 7006006000, "chapter_id": 26006, "verse_number": "१-१८९-१", "content_sanskrit": "हरिरुवाच ।\nश्वेतापराजितापुष्परसेनाक्ष्णोश्च पूरणे ।\nपटलं नाशमायाति नात्र कार्या विचारणा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006006001, "chapter_id": 26006, "verse_number": "१-१८९-२", "content_sanskrit": "मूलं गोक्षुरकस्यैव चर्वित्वा नीललोहित। ।\nदन्तकीटव्यथा नश्येत्सुरासुरविमर्दन् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006006002, "chapter_id": 26006, "verse_number": "१-१८९-३", "content_sanskrit": "नारी पुष्पादिने पीत्वा गोक्षीरेणोपवासतः ।\nश्वेतार्कस्य तु वै मूलं तस्यास्तद्गुल्मशूलनुत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006006003, "chapter_id": 26006, "verse_number": "१-१८९-४", "content_sanskrit": "श्वेतार्कपुष्पं विधिना गृहीतं पूर्वमन्त्रितम्। ।\nऋतुशुद्धा च ललना कटौ बद्ध्वा प्रसूयते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006006004, "chapter_id": 26006, "verse_number": "१-१८९-५", "content_sanskrit": "हस्तबद्धं पलाशस्य अपामार्गस्य वा ह ।\nमूलं सर्वज्वरहरं भूतप्रेतादिनुद्भवेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006006005, "chapter_id": 26006, "verse_number": "१-१८९-६", "content_sanskrit": "पीतं वृश्चिकमूलञ्च प्रातः पर्युषिताम्बुना। ।\nसार्धं विनाशयेद्दाहज्वरञ्च परमेश्वर ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006006006, "chapter_id": 26006, "verse_number": "१-१८९-७", "content_sanskrit": "शिखायाञ्चैव तद्बद्धं भवेदैकाहिकाहिनुत् ।\nपीतं पर्युषिताद्भिश्च भवेत्सर्वविषापहृत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006006007, "chapter_id": 26006, "verse_number": "१-१८९-८", "content_sanskrit": "यस्य लज्जालुकामूलं दीयते च स्वरेतसा ।\nसार्धं स वैरं संयाति पुमान्स्त्री वा न संशयः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006006008, "chapter_id": 26006, "verse_number": "१-१८९-९", "content_sanskrit": "पिष्ट्वा गव्यघृतेनैव पाठामूलं पिबेत्तु यः ।\nसर्वं विषं विनश्येच्च नात्र कार्या विचारणा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006006009, "chapter_id": 26006, "verse_number": "१-१८९-१०", "content_sanskrit": "मूलं पर्युषितोदेन शिरीषस्य यथा तथा ।\nरक्तचित्रकमूलस्य रसस्य भरणाद्धर ।\nकर्णयोः कामलाव्याधिनाशः स्यान्नात्र संशयः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006006010, "chapter_id": 26006, "verse_number": "१-१८९-११", "content_sanskrit": "श्वेतकोकिलाक्षमूलं छागीक्षीरेण संयुतम् ।\nत्रिसप्ताहेन वै पीतं क्षयरोगं क्षयं नयेत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006006011, "chapter_id": 26006, "verse_number": "१-१८९-१२", "content_sanskrit": "नारिकेलस्य वै पुष्पं छागक्षीरेण संयुतम् ।\nपिबेच्च त्रिविधस्तस्य रक्तवातो विनश्यति ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006006012, "chapter_id": 26006, "verse_number": "१-१८९-१३", "content_sanskrit": "कुर्यात्सुदर्शनामूलं माल्येन सुसमाहृतम् ।\nकण्ठबद्ध त्र्याहिकादिग्रहभूतविनाशनम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006006013, "chapter_id": 26006, "verse_number": "१-१८९-१४", "content_sanskrit": "पुष्पं धवलगुञ्जाया गृहीतं मूलमेव च ।\nमुखे तु निहितं रुद्र हरेन्नानाविषं बहु ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006006014, "chapter_id": 26006, "verse_number": "१-१८९-१५", "content_sanskrit": "हस्ते बद्धं काण्डयुक्तं कण्ठे बद्धं ग्रहादिहृत् ।\nकृष्णायान्तु चतुर्दश्यां कटिबद्धं समाहम् ।\nसिंहादिश्वापदाद्भीतिं हरेच्च नीललोहित ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006006015, "chapter_id": 26006, "verse_number": "१-१८९-१६", "content_sanskrit": "विष्णुक्रान्तामूलमीश कर्णबद्धन्तु धारयत ।\nपट्टसूत्रेण भूतेश मकरादिभयं न वै ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]