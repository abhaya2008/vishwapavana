[{"id": 5000103000, "chapter_id": 9103, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे षड्विंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000103001, "chapter_id": 9103, "verse_number": "२-२६-१", "content_sanskrit": "अभिवाद्य तु कौसल्यां रामः सम्प्रस्थितो वनम्।\nकृतस्वस्त्ययनो मात्रा धर्मिष्ठे वर्त्मनि स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000103002, "chapter_id": 9103, "verse_number": "२-२६-२", "content_sanskrit": "विराजयन् राजसुतो राजमार्गं नरैर्वृतम्।\nहृदयान्याममन्थेव जनस्य गुणवत्तया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000103003, "chapter_id": 9103, "verse_number": "२-२६-३", "content_sanskrit": "वैदेही चापि तत् सर्वं न शुश्राव तपस्विनी।\nतदेव हृदि तस्याश्च यौवराज्याभिषेचनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000103004, "chapter_id": 9103, "verse_number": "२-२६-४", "content_sanskrit": "देवकार्यं स्म सा कृत्वा कृतज्ञा हृष्टचेतना।\nअभिज्ञा राजधर्माणां राजपुत्री प्रतीक्षति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000103005, "chapter_id": 9103, "verse_number": "२-२६-५", "content_sanskrit": "प्रविवेशाथ रामस्तु स्ववेश्म सुविभूषितम्।\nप्रहृष्टजनसम्पूर्णं ह्रिया किंचिदवाङ्मुखः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000103006, "chapter_id": 9103, "verse_number": "२-२६-६", "content_sanskrit": "अथ सीता समुत्पत्य वेपमाना च तं पतिम्।\nअपश्यच्छोकसंतप्तं चिन्ताव्याकुलितेन्द्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000103007, "chapter_id": 9103, "verse_number": "२-२६-७", "content_sanskrit": "तां दृष्ट्वा स हि धर्मात्मा न शशाक मनोगतम्।\nतं शोकं राघवः सोढुं ततो विवृततां गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000103008, "chapter_id": 9103, "verse_number": "२-२६-८", "content_sanskrit": "विवर्णवदनं दृष्ट्वा तं प्रस्विन्नममर्षणम्।\nआह दुःखाभिसंतप्ता किमिदानीमिदं प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000103009, "chapter_id": 9103, "verse_number": "२-२६-९", "content_sanskrit": "अद्य बार्हस्पतः श्रीमान् युक्तः पुष्येण राघव।\nप्रोच्यते ब्राह्मणैः प्राज्ञैः केन त्वमसि दुर्मनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000103010, "chapter_id": 9103, "verse_number": "२-२६-१०", "content_sanskrit": "न ते शतशलाकेन जलफेननिभेन च।\nआवृतं वदनं वल्गु च्छत्रेणाभिविराजते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000103011, "chapter_id": 9103, "verse_number": "२-२६-११", "content_sanskrit": "व्यजनाभ्यां च मुख्याभ्यां शतपत्रनिभेक्षणम्।\nचन्द्रहंसप्रकाशाभ्यां वीज्यते न तवाननम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000103012, "chapter_id": 9103, "verse_number": "२-२६-१२", "content_sanskrit": "वाग्मिनो वन्दिनश्चापि प्रहृष्टास्त्वां नरर्षभ।\nस्तुवन्तो नाद्य दृश्यन्ते मङ्गलैः सूतमागधाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000103013, "chapter_id": 9103, "verse_number": "२-२६-१३", "content_sanskrit": "न ते क्षौद्रं च दधि च ब्राह्मणा वेदपारगाः।\nमूर्ध्नि मूर्धाभिषिक्तस्य ददति स्म विधानतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000103014, "chapter_id": 9103, "verse_number": "२-२६-१४", "content_sanskrit": "न त्वां प्रकृतयः सर्वाः श्रेणीमुख्याश्च भूषिताः।\nअनुव्रजितुमिच्छन्ति पौरजानपदास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000103015, "chapter_id": 9103, "verse_number": "२-२६-१५", "content_sanskrit": "चतुर्भिर्वेगसम्पन्नैर्हयैः काञ्चनभूषणैः।\nमुख्यः पुष्परथो युक्तः किं न गच्छति तेऽग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000103016, "chapter_id": 9103, "verse_number": "२-२६-१६", "content_sanskrit": "न हस्ती चाग्रतः श्रीमान् सर्वलक्षणपूजितः।\nप्रयाणे लक्ष्यते वीर कृष्णमेघगिरिप्रभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000103017, "chapter_id": 9103, "verse_number": "२-२६-१७", "content_sanskrit": "न च काञ्चनचित्रं ते पश्यामि प्रियदर्शन।\nभद्रासनं पुरस्कृत्य यान्तं वीर पुरःसरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000103018, "chapter_id": 9103, "verse_number": "२-२६-१८", "content_sanskrit": "अभिषेको यदा सज्जः किमिदानीमिदं तव।\nअपूर्वो मुखवर्णश्च न प्रहर्षश्च लक्ष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000103019, "chapter_id": 9103, "verse_number": "२-२६-१९", "content_sanskrit": "इतीव विलपन्तीं तां प्रोवाच रघुनन्दनः।\nसीते तत्रभवांस्तातः प्रव्राजयति मां वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000103020, "chapter_id": 9103, "verse_number": "२-२६-२०", "content_sanskrit": "कुले महति सम्भूते धर्मज्ञे धर्मचारिणि।\nशृणु जानकि येनेदं क्रमेणाद्यागतं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000103021, "chapter_id": 9103, "verse_number": "२-२६-२१", "content_sanskrit": "राज्ञा सत्यप्रतिज्ञेन पित्रा दशरथेन वै।\nकैकेय्यै मम मात्रे तु पुरा दत्तौ महावरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000103022, "chapter_id": 9103, "verse_number": "२-२६-२२", "content_sanskrit": "तयाद्य मम सज्जेऽस्मिन्नभिषेके नृपोद्यते।\nप्रचोदितः स समयो धर्मेण प्रतिनिर्जितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000103023, "chapter_id": 9103, "verse_number": "२-२६-२३", "content_sanskrit": "चतुर्दश हि वर्षाणि वस्तव्यं दण्डके मया।\nपित्रा मे भरतश्चापि यौवराज्ये नियोजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000103024, "chapter_id": 9103, "verse_number": "२-२६-२४", "content_sanskrit": "सोऽहं त्वामागतो द्रष्टुं प्रस्थितो विजनं वनम्।\nभरतस्य समीपे ते नाहं कथ्यः कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000103025, "chapter_id": 9103, "verse_number": "२-२६-२५", "content_sanskrit": "ऋद्धियुक्ता हि पुरुषा न सहन्ते परस्तवम्।\nतस्मान्न ते गुणाः कथ्या भरतस्याग्रतो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000103026, "chapter_id": 9103, "verse_number": "२-२६-२६", "content_sanskrit": "अहं ते नानुवक्तव्यो विशेषेण कदाचन।\nअनुकूलतया शक्यं समीपे तस्य वर्तितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000103027, "chapter_id": 9103, "verse_number": "२-२६-२७", "content_sanskrit": "तस्मै दत्तं नृपतिना यौवराज्यं सनातनम्।\nस प्रसाद्यस्त्वया सीते नृपतिश्च विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000103028, "chapter_id": 9103, "verse_number": "२-२६-२८", "content_sanskrit": "अहं चापि प्रतिज्ञां तां गुरोः समनुपालयन्।\nवनमद्यैव यास्यामि स्थिरीभव मनस्विनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000103029, "chapter_id": 9103, "verse_number": "२-२६-२९", "content_sanskrit": "याते च मयि कल्याणि वनं मुनिनिषेवितम्।\nव्रतोपवासपरया भवितव्यं त्वयानघे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000103030, "chapter_id": 9103, "verse_number": "२-२६-३०", "content_sanskrit": "कल्यमुत्थाय देवानां कृत्वा पूजां यथाविधि।\nवन्दितव्यो दशरथः पिता मम जनेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000103031, "chapter_id": 9103, "verse_number": "२-२६-३१", "content_sanskrit": "माता च मम कौसल्या वृद्धा संतापकर्शिता।\nधर्ममेवाग्रतः कृत्वा त्वत्तः सम्मानमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000103032, "chapter_id": 9103, "verse_number": "२-२६-३२", "content_sanskrit": "वन्दितव्याश्च ते नित्यं याः शेषा मम मातरः।\nस्नेहप्रणयसम्भोगैः समा हि मम मातरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000103033, "chapter_id": 9103, "verse_number": "२-२६-३३", "content_sanskrit": "भ्रातृपुत्रसमौ चापि द्रष्टव्यौ च विशेषतः।\nत्वया भरतशत्रुघ्नौ प्राणैः प्रियतरौ मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000103034, "chapter_id": 9103, "verse_number": "२-२६-३४", "content_sanskrit": "विप्रियं च न कर्तव्यं भरतस्य कदाचन।\nस हि राजा च वैदेहि देशस्य च कुलस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000103035, "chapter_id": 9103, "verse_number": "२-२६-३५", "content_sanskrit": "आराधिता हि शीलेन प्रयत्नैश्चोपसेविताः।\nराजानः सम्प्रसीदन्ति प्रकुप्यन्ति विपर्यये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000103036, "chapter_id": 9103, "verse_number": "२-२६-३६", "content_sanskrit": "औरस्यानपि पुत्रान् हि त्यजन्त्यहितकारिणः।\nसमर्थान् सम्प्रगृह्णन्ति जनानपि नराधिपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000103037, "chapter_id": 9103, "verse_number": "२-२६-३७", "content_sanskrit": "सा त्वं वसेह कल्याणि राज्ञः समनुवर्तिनी।\nभरतस्य रता धर्मे सत्यव्रतपरायणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000103038, "chapter_id": 9103, "verse_number": "२-२६-३८", "content_sanskrit": "अहं गमिष्यामि महावनं प्रिये\nत्वया हि वस्तव्यमिहैव भामिनि।\nयथा व्यलीकं कुरुषे न कस्यचित्\nतथा त्वया कार्यमिदं वचो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000103039, "chapter_id": 9103, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे षड्विंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]