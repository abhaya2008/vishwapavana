[{"id": 2004174, "chapter_id": 1081, "verse_number": "१-८२-०x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2004175, "chapter_id": 1081, "verse_number": "१-८२-१", "content_sanskrit": "सर्वाणि कर्माणि समाप्य राजन्\nगृहं परित्यज्य वनं गतोऽसि।\nतत्त्वां पृच्छामि नहुषस्य पुत्र\nकेनासि तुल्यस्तपसा ययाते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2004176, "chapter_id": 1081, "verse_number": "१-८२-२x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2004177, "chapter_id": 1081, "verse_number": "१-८२-२", "content_sanskrit": "नाहं देवमनुष्येषु गन्धर्वेषु महर्षिषु।\nआत्मनस्तपसा तुल्यं कंचित्पश्यामि वासव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2004178, "chapter_id": 1081, "verse_number": "१-८२-३x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2004179, "chapter_id": 1081, "verse_number": "१-८२-३", "content_sanskrit": "यदाऽवमंस्थाः सदृशः श्रेयसश्च\nअल्पीयसश्चाविदितप्रभावः।\nतस्माल्लोकास्त्वन्तवन्तस्तवे मे\nक्षीणे पुण्ये पतिताऽस्यद्य राजन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2004180, "chapter_id": 1081, "verse_number": "१-८२-४x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2004181, "chapter_id": 1081, "verse_number": "१-८२-४", "content_sanskrit": "सुरर्षिगन्धर्वनरावमाना-\nत्क्षयं गता मे यदि शक्रलोकाः।\nइच्छाम्यहं सुरलोकाद्विहीनः\nसतां मध्ये पतितुं देवराज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2004182, "chapter_id": 1081, "verse_number": "१-८२-५x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2004183, "chapter_id": 1081, "verse_number": "१-८२-५", "content_sanskrit": "सतां सकाशे पतिताऽसि राजं-\nश्च्युतः प्रतिष्ठां यत्र लब्धासि भूयः।\nएतद्विदित्वा च पुनर्ययाते\nत्वं माऽवमंस्थाः सदृशः श्रेयसश्च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2004184, "chapter_id": 1081, "verse_number": "१-८२-६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2004185, "chapter_id": 1081, "verse_number": "१-८२-६", "content_sanskrit": "ततः प्रहायामरराजजुष्टा-\nन्पुण्याँल्लोकान्पतमानं ययातिम्।\nसंप्रेक्ष्य राजर्षिवरोऽष्टकस्त-\nमुवाच सद्धर्मविधानगोप्ता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2004186, "chapter_id": 1081, "verse_number": "१-८२-७x", "content_sanskrit": "अष्टक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2004187, "chapter_id": 1081, "verse_number": "१-८२-७", "content_sanskrit": "कस्त्वं युवा वासवतुल्यरूपः\nस्वतेजसा दीप्यमानो यथाऽग्निः।\nपतस्युदीर्णाम्बुधरान्धकारा-\nत्खात्खेचराणां प्रवरो यथाऽर्कः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2004188, "chapter_id": 1081, "verse_number": "१-८२-८", "content_sanskrit": "दृष्ट्वा च त्वां सूर्यपथात्पतन्तं\nवैश्वानरार्कद्युतिमप्रमेयम्।\nकिं नु स्विदेतत्पततीति सर्वे\nवितर्कयन्तः परिमोहिताः स्मः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2004189, "chapter_id": 1081, "verse_number": "१-८२-९", "content_sanskrit": "दृष्ट्वा च त्वां धिष्ठितं देवमार्गे\nशक्रार्कविष्णुप्रतिमप्रभावम्।\nअभ्युद्गतास्त्वां वयमद्य सर्वे\nतत्त्वं प्रपाते तव जिज्ञासमानाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2004190, "chapter_id": 1081, "verse_number": "१-८२-१०", "content_sanskrit": "न चापि त्वां धृष्णुमः प्रष्टुमग्रे\nन च त्वमस्मान्पृच्छसि ये वयं स्मः।\nतत्त्वां पृच्छामि स्पृहणीयरूप\nकस्य त्वं वा किंनिमित्तं त्वमागाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2004191, "chapter_id": 1081, "verse_number": "१-८२-११", "content_sanskrit": "भयं तु ते व्येतु विषादमोहौ\nत्यजाशु चैवेन्द्रसमप्रभाव।\nत्वां वर्तमानं हि सतां सकाशे\nनालं प्रसोढुं बलहाऽपि शक्रः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2004192, "chapter_id": 1081, "verse_number": "१-८२-१२", "content_sanskrit": "सन्तः प्रतिष्ठा हि सुखच्युतानां\nसतां सदैवामरराजकल्प।\nते सङ्गताः स्थावरजङ्गमेशाः\nप्रतिष्ठितस्त्वं सदृशेषु सत्सु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2004193, "chapter_id": 1081, "verse_number": "१-८२-१३", "content_sanskrit": "प्रभुरग्निः प्रतपने भूमिरावपने प्रभुः।\nप्रभुः सूर्यः प्रकाशित्वे सतां चाभ्यागतः प्रभुः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2004194, "chapter_id": 1081, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि द्व्यशीतितमोऽध्यायः॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]