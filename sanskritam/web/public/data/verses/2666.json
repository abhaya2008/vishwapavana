[{"id": 2078453, "chapter_id": 2666, "verse_number": "१२-१७१-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2078454, "chapter_id": 2666, "verse_number": "१२-१७१-१", "content_sanskrit": "अथ तत्र महार्चिष्माननलो वातसारथिः।\nतस्याविदूरे रक्षार्थं खगेन्द्रेण कृतोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2078455, "chapter_id": 2666, "verse_number": "१२-१७१-२", "content_sanskrit": "स चापि पार्श्वे सुष्वाप विश्वस्तो बकराट् तदा।\nकृतघ्नस्तु स दुष्टात्मा तं जिघांसुरजागरीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2078456, "chapter_id": 2666, "verse_number": "१२-१७१-३", "content_sanskrit": "ततोऽलातेन दीप्तेन स सुप्तं निजघान तम्।\nनिहत्य च मुदा युक्तः सोऽनुबन्धं न दृष्टवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2078457, "chapter_id": 2666, "verse_number": "१२-१७१-४", "content_sanskrit": "स तं विपक्षरोमाणं कृत्वाऽग्नावपचत्तदा।\nतं गृहीत्वा सुवर्णं च ययौ द्रुततरं द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2078458, "chapter_id": 2666, "verse_number": "१२-१७१-५", "content_sanskrit": "`ततो दाक्षायणीपुत्रं नागतं तं तु भारत।\nविरूपाक्षश्चिन्तयन्वै हृदयेन विदूयता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2078459, "chapter_id": 2666, "verse_number": "१२-१७१-६", "content_sanskrit": "ततोऽन्यस्मिन्गते चाह्नि विरूपाक्षोऽब्रवीत्सुतम्।\nन प्रेक्षे राजधर्माणमद्य पुत्र खगोत्तमम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2078460, "chapter_id": 2666, "verse_number": "१२-१७१-७", "content_sanskrit": "स पूर्वसन्ध्यां ब्रह्माणं वन्दितुं याति सर्वदा।\nमां चादृष्ट्वा कदाचित्स न गच्छति गृहं खगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2078461, "chapter_id": 2666, "verse_number": "१२-१७१-८", "content_sanskrit": "द्विरात्रमुभयोः सन्ध्योर्नाभ्यगच्छन्ममालयम्।\nतस्मान्न शुद्ध्यते भावो मम स ज्ञायतां सुहृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2078462, "chapter_id": 2666, "verse_number": "१२-१७१-९", "content_sanskrit": "स्वाध्यायेन वियुक्तो हि ब्रह्मवर्चसवर्जितः।\nस गतस्तत्र मे शङ्का हन्यात्तं स द्विजाधमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2078463, "chapter_id": 2666, "verse_number": "१२-१७१-१०", "content_sanskrit": "दुराचारः स दुर्बुद्धिरिङ्गितैर्लक्षितो मया।\nनिष्कृपो दारुणाकारो दुष्टो दस्युरिवाधमः।\nगौतमः स गतस्तत्र तेनोद्विग्नं मनो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2078464, "chapter_id": 2666, "verse_number": "१२-१७१-११", "content_sanskrit": "पुत्र शीघ्रमितो गत्वा राजधर्मनिवेशनम्।\nज्ञायतां स विशुद्धात्मा यदि जीवति वा चिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2078465, "chapter_id": 2666, "verse_number": "१२-१७१-१२", "content_sanskrit": "स एवमुक्तस्त्वरितो रक्षोभिः सहितो ययौ।\n* न्यग्रोधे राजधर्माणमपश्यन्निहतं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2078466, "chapter_id": 2666, "verse_number": "१२-१७१-१३", "content_sanskrit": "रुदित्वा बहुशस्तस्मै विलप्य च स राक्षसः।\nगतो रोषसमाविष्टो गौतमग्रहणाय वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2078467, "chapter_id": 2666, "verse_number": "१२-१७१-१४", "content_sanskrit": "गृहीतो गौतमः पापो रक्षोभिः क्रोधमूर्च्छितैः।\nराजधर्मशरीरस्य कङ्कालश्चाप्यथो धृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2078468, "chapter_id": 2666, "verse_number": "१२-१७१-१५", "content_sanskrit": "मनुव्रजं तु नगरं यातुधानास्ततो गताः।\nक्रोधरक्तेक्षणा घोरा गौतमस्य वधे धृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2078469, "chapter_id": 2666, "verse_number": "१२-१७१-१६", "content_sanskrit": "पार्थिवस्वाग्रतो न्यस्तः कङ्कालो राजधर्मणः।\nतं दृष्ट्वा विमना राजा सामात्यः सगणोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2078470, "chapter_id": 2666, "verse_number": "१२-१७१-१७", "content_sanskrit": "आर्तरावो महानासीद्गृहे तस्य महात्मनः।\nसमुत्थितः स्रीसङ्घस्य निहते काश्यपात्मजे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2078471, "chapter_id": 2666, "verse_number": "१२-१७१-१८", "content_sanskrit": "राजा चैवाब्रवीत्पुत्रं पापोऽयं वध्यतामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2078472, "chapter_id": 2666, "verse_number": "१२-१७१-१९x", "content_sanskrit": "राक्षमा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2078473, "chapter_id": 2666, "verse_number": "१२-१७१-१९", "content_sanskrit": "अस्य मांसं वयं सर्वे खादिष्यामः समागताः।\nपापकृत्पापकर्मा च पापात्मा पापमास्थितः।\nहन्तव्य एव पापात्मा कृतघ्नो नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2078474, "chapter_id": 2666, "verse_number": "१२-१७१-२०x", "content_sanskrit": "विरूपाक्ष उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2078475, "chapter_id": 2666, "verse_number": "१२-१७१-२०", "content_sanskrit": "कृतघ्नं पापकर्माणां न भक्षयितुमुत्सहे।\nदासेभ्यो दीयतामेप मित्रध्रुक्पुरुपाधमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2078476, "chapter_id": 2666, "verse_number": "१२-१७१-२१x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2078477, "chapter_id": 2666, "verse_number": "१२-१७१-२१", "content_sanskrit": "दासाः सर्वे समाहूता यातुधानास्तथा परे।\nनेच्छन्ति स्म कृतघ्नं तं खादितुं पुरुषोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2078478, "chapter_id": 2666, "verse_number": "१२-१७१-२२", "content_sanskrit": "शिरोभिश्चागता भूमिं महाराज ततो बलात्।\nमानार्थं जातु निर्बन्धं किल्विषं दातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2078479, "chapter_id": 2666, "verse_number": "१२-१७१-२३", "content_sanskrit": "यातुधाना नृपेणोक्ताः पापकर्मा विशस्यताम्।\nदह्यतां त्यज्यतां वाऽयं दर्शनादपनीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2078480, "chapter_id": 2666, "verse_number": "१२-१७१-२४", "content_sanskrit": "ततस्ते रुपिता दासाः शूलपट्टसपाणयः।\nखण्डशो विकृतं हत्वा क्रव्याद्भ्यो ह्यददुस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2078481, "chapter_id": 2666, "verse_number": "१२-१७१-२५", "content_sanskrit": "क्रव्यादास्त्वपि राजेन्द्र नेच्छन्ति पिशिताशनाः।\nमृतानपि हि क्रव्यादाः कृतघ्नान्नोपभुञ्जते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2078482, "chapter_id": 2666, "verse_number": "१२-१७१-२६", "content_sanskrit": "ब्रह्मस्वहरणे चोरे ब्रह्मघ्ने गुरुतल्पगे।\nनिष्कृतिर्विहिता सद्भिः कृतघ्ने नास्ति निष्कृतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2078483, "chapter_id": 2666, "verse_number": "१२-१७१-२७", "content_sanskrit": "मित्रद्रुहं कृतघ्नं च नृशंसं च नराधमम्।\nक्रव्यादाः किमयश्चैव नोपभुञ्जन्ति वै सदा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2078484, "chapter_id": 2666, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि एकसप्तत्यधिकशततमोऽध्यायः॥ १७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]