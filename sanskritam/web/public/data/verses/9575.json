[{"id": 5000575000, "chapter_id": 9575, "verse_number": "७-४०-१", "content_sanskrit": "तथा स्म तेषां वसतामृक्षवानररक्षसाम् ।\nराघवस्तु महातेजाः सुग्रीवमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000575001, "chapter_id": 9575, "verse_number": "७-४०-२", "content_sanskrit": "गम्यतां सौम्य किष्किन्धां दुराधर्षां सुरासुरैः ।\nपालयस्व सहामात्यो राज्यं निहतकण्टकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000575002, "chapter_id": 9575, "verse_number": "७-४०-३", "content_sanskrit": "अङ्गदं च महाबाहो प्रीत्या परमया युतः ।\nपश्य त्वं हनुमन्तं च नलं च सुमहाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000575003, "chapter_id": 9575, "verse_number": "७-४०-४", "content_sanskrit": "सुषेणं श्वशुरं वीरं तारं च बलिनां वरम् ।\nकुमुदं चैव दुर्धर्षं नीलं चैव महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000575004, "chapter_id": 9575, "verse_number": "७-४०-५", "content_sanskrit": "वीरं शतवलिं चैव मैन्दं द्विविदमेव च ।\nगजं गवाक्षं गवयं शरभं च महाबलम् ।\nपश्य प्रीतिसमायुक्तो गन्धमादनमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000575005, "chapter_id": 9575, "verse_number": "७-४०-६", "content_sanskrit": "ऋषभं च सुविक्रान्तं जाम्बवन्तं महाबलम् ।\nये चेमे सुमहात्मानो मदर्थे त्यक्तजीविताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000575006, "chapter_id": 9575, "verse_number": "७-४०-७", "content_sanskrit": "पश्य त्वं प्रीतिसंयुक्तो मा चैषां विप्रियं कृथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000575007, "chapter_id": 9575, "verse_number": "७-४०-८", "content_sanskrit": "एवमुक्त्वा तु सुग्रीवमाश्लिष्य च पुनः पुनः ।\nविभीषणमुवाचाथ रामो मधुरया गिरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000575008, "chapter_id": 9575, "verse_number": "७-४०-९", "content_sanskrit": "लङ्कां प्रशाधि धर्मेण धर्मज्ञस्त्वं मतो मम ।\nपुरस्य राक्षसानां च स्वभ्रातुस्सम्मतो ह्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000575009, "chapter_id": 9575, "verse_number": "७-४०-१०", "content_sanskrit": "मा च बुद्धिमधर्मे त्वं कुर्या राजन्कथञ्चन ।\nबुद्धिमन्तो हि राजानो ध्रुवमश्नन्ति मेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000575010, "chapter_id": 9575, "verse_number": "७-४०-११", "content_sanskrit": "अहं च नित्यशो राजन्सुग्रीवसहितस्त्वया ।\nस्मर्तव्यः परया प्रीत्या गच्छ त्वं विगतज्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000575011, "chapter_id": 9575, "verse_number": "७-४०-१२", "content_sanskrit": "रामस्य भाषितं श्रुत्वा ऋक्षवानरराक्षसाः ।\nसाधुसाध्विति काकुत्स्थं प्रशशंसुः पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000575012, "chapter_id": 9575, "verse_number": "७-४०-१३", "content_sanskrit": "तव बुद्धिर्महाबाहो वीर्यमद्भुतमेव च ।\nमाधुर्यं परमं राम स्वयम्भोरिव नित्यदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000575013, "chapter_id": 9575, "verse_number": "७-४०-१४", "content_sanskrit": "तेषामेवं ब्रुवाणानां वानराणां च राक्षसाम् ।\nहनूमान्प्रवणः भूत्वा राघवं वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000575014, "chapter_id": 9575, "verse_number": "७-४०-१५", "content_sanskrit": "स्नेहो मे परमो राजंस्त्वयि तिष्ठतु नित्यदा ।\nभक्तिश्च नियता वीर भावो नान्यत्र गच्छतु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000575015, "chapter_id": 9575, "verse_number": "७-४०-१६", "content_sanskrit": "वायद्रामकथा वीर चरिष्यति महीतले ।\nतावच्छरीरे वत्स्यन्ति प्राणा मम न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000575016, "chapter_id": 9575, "verse_number": "७-४०-१७", "content_sanskrit": "यच्चैतच्चरितं दिव्यं कथा ते रघुनन्दन ।\nतन्मयाप्सरसो नाम श्रावयेयुर्नरर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000575017, "chapter_id": 9575, "verse_number": "७-४०-१८", "content_sanskrit": "तच्छ्रुत्वाहं ततो वीर तव चर्यामृतं प्रभो ।\nउत्कण्ठां तां हरिष्यामि मेघलेखामिवानिलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000575018, "chapter_id": 9575, "verse_number": "७-४०-१९", "content_sanskrit": "एवं ब्रुवाणं रामस्तु हनूमन्तं वरासनात् ।\nउत्थाय सस्वजे स्नेहाद्वाक्यमेतदुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000575019, "chapter_id": 9575, "verse_number": "७-४०-२०", "content_sanskrit": "एवमेतत्कपिश्रेष्ठ भविता नात्र संशयः ।\nचरिष्यति कथा यावदेषा लोके च मामिका ।\nतावत्ते भविता कीर्तिः शरीरे ऽप्यसवस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000575020, "chapter_id": 9575, "verse_number": "७-४०-२१", "content_sanskrit": "लोका हि यावत्स्थास्यन्ति तावत्स्थास्यति मे कथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000575021, "chapter_id": 9575, "verse_number": "७-४०-२२", "content_sanskrit": "लोके च मामिका ।\nएकैकस्योपकारस्य प्राणान्दास्यामि ते कपे ।\nनरः प्रत्युपकाराणामापस्त्वायाति पात्रताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000575022, "chapter_id": 9575, "verse_number": "७-४०-२३", "content_sanskrit": "ततो ऽस्य हारं चन्द्राभं मुच्य कण्ठात्स राघवः ।\nवैडूर्यतरलं कण्ठे बबन्ध च हनूमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000575023, "chapter_id": 9575, "verse_number": "७-४०-२४", "content_sanskrit": "तेनोरसि निबद्धेन हारेण महता कपिः ।\nरराज हेमशैलेन्द्रश्चन्द्रेणाक्रान्तमस्तकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000575024, "chapter_id": 9575, "verse_number": "७-४०-२५", "content_sanskrit": "श्रुत्वा तु राघवस्यैतदुत्थायोत्थाय वानराः ।\nप्रणम्य शिरसा पादौ निर्जग्मुस्ते महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000575025, "chapter_id": 9575, "verse_number": "७-४०-२६", "content_sanskrit": "सुग्रीवः स च रामेण निरन्तरमुरोगतः ।\nविभीषणश्च धर्मात्मा सर्वे ते बाष्पविक्लवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000575026, "chapter_id": 9575, "verse_number": "७-४०-२७", "content_sanskrit": "सर्वे च ते बाष्पकलाः साश्रुनेत्रा विचेतसः ।\nसम्मूढा इव दुःखेन त्यजन्तो राघवं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000575027, "chapter_id": 9575, "verse_number": "७-४०-२८", "content_sanskrit": "कृतप्रसादास्तेनैवं राघवेण महात्मना ।\nजग्मुः स्वं स्वं गृहं सर्वे देही देहमिव त्यजन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000575028, "chapter_id": 9575, "verse_number": "७-४०-२९", "content_sanskrit": "ततस्तु ते राक्षसऋक्षवानराः प्रणम्य रामं रघुवंशवर्धनम् ।\nवियोगजाश्रुप्रतिपूर्णलोचनाः प्रतिप्रयातास्तु यथा निवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000575029, "chapter_id": 9575, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे चत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]