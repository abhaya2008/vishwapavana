[{"id": 7001218000, "chapter_id": 21218, "verse_number": "२-४-११-१", "content_sanskrit": "ब्रह्मोवाच ।\nएतस्मिन्नंतरे तत्र क्रौञ्चनामाचलो मुने ।\nआजगाम कुमारस्य शरणं बाणपीडित॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001218001, "chapter_id": 21218, "verse_number": "२-४-११-२", "content_sanskrit": "पलायमानो यो युद्धादसोढा तेज ऐश्वरम् ।\nतुतोदातीव स क्रौञ्चं कोट्यायुतबलान्वितः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001218002, "chapter_id": 21218, "verse_number": "२-४-११-३", "content_sanskrit": "प्रणिपत्य कुमारस्य स भक्त्या चरणाम्बुजम् ।\nप्रेमनिर्भरया वाचा तुष्टाव गुहमादरात्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001218003, "chapter_id": 21218, "verse_number": "२-४-११-४", "content_sanskrit": "क्रौंच उवाच ।\nकुमार स्कंद देवेश तारकासुरनाशक ।\nपाहि मां शरणापन्नं बाणासुरनिपीडितम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001218004, "chapter_id": 21218, "verse_number": "२-४-११-५", "content_sanskrit": "संगरात्ते महासेन समुच्छिन्नः पलायितः ।\nन्यपीडयच्च मागत्य हा नाथ करुणाकर॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001218005, "chapter_id": 21218, "verse_number": "२-४-११-६", "content_sanskrit": "तत्पीडितस्ते शरणमागतोऽहं सुदुःखितः ।\nपलायमानो देवेश शरजन्मन्दयां कुरु॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001218006, "chapter_id": 21218, "verse_number": "२-४-११-७", "content_sanskrit": "दैत्यं तं नाशय विभो बाणाह्वं मां सुखीकुरु ।\nदैत्यघ्नस्त्वं विशेषेण देवावनकरस्स्वराट्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001218007, "chapter_id": 21218, "verse_number": "२-४-११-८", "content_sanskrit": "ब्रह्मोवाच ।\nइति क्रौंचस्तुतस्स्कन्दः प्रसन्नो भक्तपालकः ।\nगृहीत्वा शक्तिमतुलां स्वां सस्मार शिवो धिया॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001218008, "chapter_id": 21218, "verse_number": "२-४-११-९", "content_sanskrit": "चिक्षेप तां समुद्दिश्य स बाणं शंकरात्मजः ।\nमहाशब्दो बभूवाथ जज्वलुश्च दिशो नभः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001218009, "chapter_id": 21218, "verse_number": "२-४-११-१०", "content_sanskrit": "सबलं भस्मसात्कृत्वासुरं तं क्षणमात्रतः ।\nगुहोपकंठं शक्तिस्सा जगाम परमा मुने॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001218010, "chapter_id": 21218, "verse_number": "२-४-११-११", "content_sanskrit": "ततः कुमार प्रोवाच क्रौंचं गिरिवरं प्रभुः ।\nनिर्भयस्स्वगृहं गच्छ नष्टस्स सबलोऽसुरः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001218011, "chapter_id": 21218, "verse_number": "२-४-११-१२", "content_sanskrit": "तच्छुत्वा स्वामिवचनं मुदितो गिरिराट् तदा ।\nस्तुत्वा गुहं तदारातिं स्वधाम प्रत्यपद्यत॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001218012, "chapter_id": 21218, "verse_number": "२-४-११-१३", "content_sanskrit": "ततः स्कन्दो महेशस्य मुदा स्थापितवान्मुने ।\nत्रीणि लिंगानि तत्रैव पापघ्नानि विधानतः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001218013, "chapter_id": 21218, "verse_number": "२-४-११-१४", "content_sanskrit": "प्रतिज्ञेश्वरनामादौ कपालेश्वरमादरात् ।\nकुमारेश्वरमेवाथ सर्वसिद्धिप्रदं त्रयम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001218014, "chapter_id": 21218, "verse_number": "२-४-११-१५", "content_sanskrit": "पुनस्सर्वेश्वरस्तत्र जयस्तंभसमीपतः ।\nस्तंभेश्वराभिधं लिंगं गुहः स्थापितवान्मुदा॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001218015, "chapter_id": 21218, "verse_number": "२-४-११-१६", "content_sanskrit": "ततस्सर्वे सुरास्तत्र विष्णुप्रभृतयो मुदा ।\nलिंगं स्थापितवंतस्ते देवदेवस्य शूलिनः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001218016, "chapter_id": 21218, "verse_number": "२-४-११-१७", "content_sanskrit": "सर्वेषां शिवलिंगानां महिमाभूत्तदाद्भुतः ।\nसर्वकामप्रदश्चापि मुक्तिदो भक्तिकारिणाम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001218017, "chapter_id": 21218, "verse_number": "२-४-११-१८", "content_sanskrit": "ततस्सर्वे सुरा विष्णुप्रमुखाः प्रीतमानसाः ।\nऐच्छन्गिरिवरं गंतुं पुरस्कृत्य गुहं मुदा॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001218018, "chapter_id": 21218, "verse_number": "२-४-११-१९", "content_sanskrit": "तस्मिन्नवसरे शेषपुत्रः कुमुद नामकः ।\nआजगाम कुमारस्य शरणं दैत्यपीडितः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001218019, "chapter_id": 21218, "verse_number": "२-४-११-२०", "content_sanskrit": "प्रलंबाख्योऽसुरो यो हि रणादस्मात्पलायितः ।\nस तत्रोपद्रवं चक्रे प्रबलस्तारकानुगः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001218020, "chapter_id": 21218, "verse_number": "२-४-११-२१", "content_sanskrit": "सोऽथ शेषस्य तनयः कुमुदोऽहिपतेर्महान् ।\nकुमारशरणं प्राप्तस्तुष्टाव गिरिजात्मजम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001218021, "chapter_id": 21218, "verse_number": "२-४-११-२२", "content_sanskrit": "कुमुद उवाच ।\nदेवदेव महादेव वरतात महाप्रभो ।\nपीडितोऽहं प्रलंबेन त्वाहं शरणमागतः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001218022, "chapter_id": 21218, "verse_number": "२-४-११-२३", "content_sanskrit": "पाहि मां शरणापन्नं प्रलंबा सुरपीडितम् ।\nकुमार स्कन्द देवेश तारकारे महाप्रभो॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001218023, "chapter_id": 21218, "verse_number": "२-४-११-२४", "content_sanskrit": "त्वं दीनबंधुः करुणासिन्धुरानतवत्सलः ।\nखलनिग्रहकर्ता हि शरण्यश्च सतां गतिः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001218024, "chapter_id": 21218, "verse_number": "२-४-११-२५", "content_sanskrit": "कुमुदेनस्तुतश्चेत्थं विज्ञप्तस्तद्वधाय हि ।\nस्वाश्च शक्तिं स जग्राह स्मृत्वा शिवपदांबुजौ॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001218025, "chapter_id": 21218, "verse_number": "२-४-११-२६", "content_sanskrit": "चिक्षेप तां समुद्दिश्य प्रलंबं गिरिजासुतः ।\nमहाशब्दो बभूवाथ जज्वलुश्च दिशो नभः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001218026, "chapter_id": 21218, "verse_number": "२-४-११-२७", "content_sanskrit": "तं सायुतबलं शक्तिर्द्रुतं कृत्वा च भस्मसात् ।\nगुहोपकंठं सहसाजगामाक्लिष्टवारिणी॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001218027, "chapter_id": 21218, "verse_number": "२-४-११-२८", "content_sanskrit": "ततः कुमारः प्रोवाच कुमुदं नागबालकम् ।\nनिर्भयः स्वगृहं गच्छ नष्टस्स सबलोऽसुरः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001218028, "chapter_id": 21218, "verse_number": "२-४-११-२९", "content_sanskrit": "तच्छुत्वा गुहवाक्यं स कुमुदोहिपतेस्सुतः ।\nस्तुत्वा कुमारं नत्वा च पातालं मुदितो ययौ॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001218029, "chapter_id": 21218, "verse_number": "२-४-११-३०", "content_sanskrit": "एवं कुमारविजयं वर्णितं ते मुनीश्वर ।\nचरितं तारकवधं परमाश्चर्यकारकम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001218030, "chapter_id": 21218, "verse_number": "२-४-११-३१", "content_sanskrit": "सर्वपापहरं दिव्यं सर्वकामप्रदं नृणाम् ।\nधन्यं यशस्यमायुष्यं भुक्तिमुक्तिप्रदं सताम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001218031, "chapter_id": 21218, "verse_number": "२-४-११-३२", "content_sanskrit": "ये कीर्तयंति सुयशोऽमितभाग्ययुता नराः ।\nकुमारचरितं दिव्यं शिव लोकं प्रयांति ते॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001218032, "chapter_id": 21218, "verse_number": "२-४-११-३३", "content_sanskrit": "श्रोष्यंति ये च तत्कीर्तिं भक्त्या श्रद्धान्विता जनाः ।\nमुक्तिं प्राप्स्यन्ति ते दिव्यामिह भुक्त्वा परं सुखम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]