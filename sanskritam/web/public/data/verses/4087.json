[{"id": 2143199, "chapter_id": 4087, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2143200, "chapter_id": 4087, "verse_number": "१", "content_sanskrit": "युयुधानस्ततो वीरः सात्वतानां महारथः ।\nमहता चतुरङ्गेण बलेनागाद् युधिष्ठिरम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2143201, "chapter_id": 4087, "verse_number": "२", "content_sanskrit": "तस्य योधा महावीर्या नानादेशसमागताः ।\nनानाप्रहरणा वीराः शोभयाञ्चक्रिरे बलम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2143202, "chapter_id": 4087, "verse_number": "३", "content_sanskrit": "परश्वथैर्भिण्डिवालैः शूलतोमरमुद्गरैः ।\nपरिघैर्यष्टिभिः प्रासैः करवालैश्च निर्मलैः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2143203, "chapter_id": 4087, "verse_number": "४", "content_sanskrit": "खड्गकार्मुकनिर्यूहैः शरैश्च विविधैरपि ।\nतैलधौतैः प्रकाशद्भिस्तदशोभत वै बलम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2143204, "chapter_id": 4087, "verse_number": "५", "content_sanskrit": "तस्य मेघप्रकाशस्य शस्त्रैस्तैः शोभितस्य च ।\nबभूव रूपं सैन्यस्य मेघस्येव सविद्युतः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2143205, "chapter_id": 4087, "verse_number": "६", "content_sanskrit": "अक्षोहिणी हि सा सेना तदा यौधिष्ठिरं बलम् ।\nप्रविश्यान्तर्दधे राजन् सागरं कुनदी यथा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2143206, "chapter_id": 4087, "verse_number": "७", "content_sanskrit": "तथैवाक्षोहिणीं गृह्य चेदीनामृषभो बली ।\nधृष्टकेतुरुपागच्छत् पाण्डवानमितौजसः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2143207, "chapter_id": 4087, "verse_number": "८", "content_sanskrit": "मागधश्च जयत्सेनो जारासन्धिर्महाबलः ।\nअक्षोहिण्यैव सैन्यस्य धर्मराजमुपागमत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2143208, "chapter_id": 4087, "verse_number": "९", "content_sanskrit": "तथैव पाण्ड्यो राजेन्द्र सागरानूपवासिभिः ।\nवृतो बहुविधैर्योधैर्युधिष्ठिरमुपागमत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2143209, "chapter_id": 4087, "verse_number": "१०", "content_sanskrit": "तथा माहिष्मतीवासो नीलो नीलायुधैः सह ।\nमहीपालो महावीर्यो दक्षिणापथवासिभिः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2143210, "chapter_id": 4087, "verse_number": "११", "content_sanskrit": "तस्य सैन्यमतीवासीत् तस्मिन् बलसमागमे ।\nप्रेक्षणीयतरं राजन् सुवेषं बलवत् तदा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2143211, "chapter_id": 4087, "verse_number": "१२", "content_sanskrit": "केकयाश्च नरव्याघ्राः सोदराः पञ्च पार्थिवाः ।\nसंहर्षयन्तः कौन्तेयान् अक्षोहिण्या समागताः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2143212, "chapter_id": 4087, "verse_number": "१३", "content_sanskrit": "द्रुपदस्याप्यभूत् सेना नानादेशसमागतैः ।\nशोभिता पुरुषैः शूरैः पुत्रैश्च सुमहारथैः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2143213, "chapter_id": 4087, "verse_number": "१४", "content_sanskrit": "तथैव राजा मत्स्यानां विराटो वाहिनीपतिः ।\nपार्वतीयैर्महीपालैः सहितः पाण्डवानयात्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2143214, "chapter_id": 4087, "verse_number": "१५", "content_sanskrit": "इतश्चेतश्च पाण्डूनां समाजग्मुर्महात्मनाम् ।\nअक्षोहिण्यस्तु सप्तैता विविधध्वजसङ्कुलाः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2143215, "chapter_id": 4087, "verse_number": "१६", "content_sanskrit": "युयुत्समानाः कुरुभिः पाण्डवान् समहर्षयन्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2143216, "chapter_id": 4087, "verse_number": "१७", "content_sanskrit": "तथैव धार्तराष्ट्रस्य हर्षं समभिवर्धयन् ।\nभगदत्तो महीपालः सेनामक्षोहिणीं ददौ\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2143217, "chapter_id": 4087, "verse_number": "१८", "content_sanskrit": "तस्य चीनैः किरातैश्च काञ्चनैरिव संवृतम् ।\nबभौ बलमनाधृष्यं कर्णिकारवनं यथा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2143218, "chapter_id": 4087, "verse_number": "१९", "content_sanskrit": "तथा भूरिश्रवाः शूरः शल्यश्च कुरुनन्दन ।\nदुर्योधनमुपायातावक्षोहिण्या पृथक् पृथक्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2143219, "chapter_id": 4087, "verse_number": "२०", "content_sanskrit": "कृतवर्मा च हार्दिक्यो भोजान्धकुकुरैः सह ।\nअक्षोहिण्यैव सेनाया दुर्योधनमुपागमत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2143220, "chapter_id": 4087, "verse_number": "२१", "content_sanskrit": "तस्य तैः पुरुषव्याघ्रैर्वनमालाधरैर्बलम् ।\nअशोभत यथा मत्तैर्वनं प्रक्रीडितैर्गजैः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2143221, "chapter_id": 4087, "verse_number": "२२", "content_sanskrit": "जयद्रथमुखाश्चान्ये सिन्धुसौवीरवासिनः ।\nआजग्मुः पृथिवीपालाः कम्पयन्त इवाचलान्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2143222, "chapter_id": 4087, "verse_number": "२३", "content_sanskrit": "तेषामक्षोहिणी सेना बहुला विबभौ तदा ।\nविधूयमानो वातेन बहुरूप इवाम्बुदः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2143223, "chapter_id": 4087, "verse_number": "२४", "content_sanskrit": "सुदक्षिणश्च काम्भोजो यवनैश्च शकैस्तथा ।\nउपाजगाम कौरव्यमक्षोहिण्या विशाम्पते\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2143224, "chapter_id": 4087, "verse_number": "२५", "content_sanskrit": "तस्य सेनासमावायः शलभानामिवाबभौ ।\nस च सम्प्राप्य कौरव्यं तत्रैवान्तर्दधे तदा\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2143225, "chapter_id": 4087, "verse_number": "२६", "content_sanskrit": "आवन्त्यौ च महीपालौ महाबलसुसंवृतौ ।\nपृथगक्षोहिणीभ्यां तावभियातौ सुयोधनम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2143226, "chapter_id": 4087, "verse_number": "२७", "content_sanskrit": "इतस्ततस्तु सर्वेषां भूमिपानां महात्मनाम् ।\nतिस्रोऽन्याः समवर्तन्त वाहिन्यो भरतर्षभ\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2143227, "chapter_id": 4087, "verse_number": "२८", "content_sanskrit": "एवमेकादशा वृत्ताः सेना दुर्योधनस्य ताः ।\nयुयुत्समानाः कौन्तेयान् नानाध्वजसमाकुलाः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2143228, "chapter_id": 4087, "verse_number": "२९", "content_sanskrit": "न हस्तिनपुरे राजन् अवकाशोऽभवत् तदा ।\nराज्ञां स्वबलमुख्यानां प्राधान्येनापि भारत\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2143229, "chapter_id": 4087, "verse_number": "३०", "content_sanskrit": "ततः पञ्चनदं चैव कृत्स्नं च कुरुजाङ्गलम् ।\nतथा रोहितकारण्यं मरुभूमिश्च केवला\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2143230, "chapter_id": 4087, "verse_number": "३१", "content_sanskrit": "अहिच्छत्रं कालकूटं गङ्गातीरं च भारत ।\nवरणावाटधानं च यामुनश्चैव पर्वतः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2143231, "chapter_id": 4087, "verse_number": "३२", "content_sanskrit": "एष देशः सुविस्तीर्णः प्रभूतधनधान्यवान् ।\nबभूव कौरवेयाणां बलेन सुसमाकुलम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2143232, "chapter_id": 4087, "verse_number": "३३", "content_sanskrit": "तत्र सैन्यं तथा युक्तं ददर्श स पुरोहितः ।\nयः स पाञ्चालराजेन प्रेषितः कौरवान् प्रति \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2143233, "chapter_id": 4087, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि एकोनविंशोऽध्यायः ॥१९॥\nसेनोद्योगपर्वणि एकोनविंशोऽध्यायः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2143234, "chapter_id": 4087, "verse_number": "", "content_sanskrit": "॥ समाप्तं सेनोद्योगपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2143235, "chapter_id": 4087, "verse_number": "", "content_sanskrit": "* * * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]