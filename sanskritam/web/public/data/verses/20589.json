[{"id": 7000589000, "chapter_id": 20589, "verse_number": "५-४८-१", "content_sanskrit": "शेष उवाच ।\nइति प्रोक्तं तु मुनिना संश्रुत्य परवीरहा ।\nविस्मयं मानयामास हृदि शौनकमब्रवीत्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000589001, "chapter_id": 20589, "verse_number": "५-४८-२", "content_sanskrit": "शत्रुघ्न उवाच ।\nकर्मणो गहना वार्ता यया सात्वकनामधृत् ।\nदिवं प्राप्तोऽपि महता कर्मणा राक्षसीकृतः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000589002, "chapter_id": 20589, "verse_number": "५-४८-३", "content_sanskrit": "स्वामिन्वद महर्षे त्वं कर्मणां स्वगतिर्यथा ।\nयेन कर्मविपाकेन यादृशं नरकं भवेत्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000589003, "chapter_id": 20589, "verse_number": "५-४८-४", "content_sanskrit": "शौनक उवाच ।\nधन्योसि राघवश्रेष्ठ यत्ते मतिरियं शुभा ।\nजानन्नपि हितार्थाय लोकानां त्वं ब्रवीषि भोः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000589004, "chapter_id": 20589, "verse_number": "५-४८-५", "content_sanskrit": "कथयामि विचित्राणां कर्मणां विविधा गतीः ।\nताः शृणुष्व महाराज यच्छ्रुत्वा मोक्षमाप्नुयात्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000589005, "chapter_id": 20589, "verse_number": "५-४८-६", "content_sanskrit": "परवित्तं परापत्यं कलत्रं पारकं च यः ।\nबलात्कारेण गृह्णाति भोगबुद्ध्या च दुर्मतिः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000589006, "chapter_id": 20589, "verse_number": "५-४८-७", "content_sanskrit": "कालपाशेन संबद्धो यमदूतैर्महाबलैः ।\nतामिस्रे पात्यते तावद्यावद्वर्षसहस्रकम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000589007, "chapter_id": 20589, "verse_number": "५-४८-८", "content_sanskrit": "तत्र ताडनमुद्धूताः कुर्वंति यमकिंकराः ।\nपापभोगेन संतप्तस्ततो योनिं तु शौकरीम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000589008, "chapter_id": 20589, "verse_number": "५-४८-९", "content_sanskrit": "तत्र भुक्त्वा महादुःखं मानुषत्वं गमिष्यति ।\nरोगादिचिह्नितं तत्र दुर्यशो ज्ञापकं स्वकम्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000589009, "chapter_id": 20589, "verse_number": "५-४८-१०", "content_sanskrit": "भूतद्रोहं विधायैव केवलं स्वकुटुंबकम् ।\nपुष्णाति पापनिरतः सोंऽधतामिस्रके पतेत्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000589010, "chapter_id": 20589, "verse_number": "५-४८-११", "content_sanskrit": "ये नरा इह जंतूनां वधं कुर्वंति वै मृषा ।\nते रौरवे निपात्यंते भिद्यंते रुरुभी रुषा॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000589011, "chapter_id": 20589, "verse_number": "५-४८-१२", "content_sanskrit": "यः स्वोदरार्थे भूतानां वधमाचरति स्फुटम् ।\nमहारौरवसंज्ञे तु पात्यते स यमाज्ञया॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000589012, "chapter_id": 20589, "verse_number": "५-४८-१३", "content_sanskrit": "यो वै निजं तु जनकं ब्राह्मणं द्वेष्टि पापकृत् ।\nकालसूत्रे महादुष्टे योजनायुतविस्तृते॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000589013, "chapter_id": 20589, "verse_number": "५-४८-१४", "content_sanskrit": "यावंति पशुरोमाणि गवां द्वेषं करोति यः ।\nतावद्वर्षसहस्राणि पच्यते यमकिंकरैः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000589014, "chapter_id": 20589, "verse_number": "५-४८-१५", "content_sanskrit": "यो भूमौ भूपतिर्भूत्वा दंडायोग्यं तु दंडयेत् ।\nकरोति ब्राह्मणस्यापि देहदंडं च लोलुपः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000589015, "chapter_id": 20589, "verse_number": "५-४८-१६", "content_sanskrit": "स सूकरमुखैर्दुष्टैः पीड्यते यमकिंकरैः ।\nपश्चाद्दुष्टासु योनीषु जायते पापमुक्तये॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000589016, "chapter_id": 20589, "verse_number": "५-४८-१७", "content_sanskrit": "ब्राह्मणानां गवां ये तु द्रव्यं वृत्तं तथाल्पकम् ।\nवृत्तिं वा गृह्णते मोहाल्लुंपंति स्वबलान्नराः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000589017, "chapter_id": 20589, "verse_number": "५-४८-१८", "content_sanskrit": "ते परत्रांधकूपे च पात्यंते च महार्दिताः ।\nयोऽन्नं स्वयमुपाहृत्य मधुरं चात्तिलोलुपः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000589018, "chapter_id": 20589, "verse_number": "५-४८-१९", "content_sanskrit": "न देवाय न सुहृदे ददाति रसनापरः ।\nस पतत्येव नरके कृमिभोजनसंज्ञिते॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000589019, "chapter_id": 20589, "verse_number": "५-४८-२०", "content_sanskrit": "अनापदि नरो यस्तु हिरण्यादीन्यपाहरेत् ।\nब्रह्मस्वं वा महादुष्टे संदंशे नरके पतेत्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000589020, "chapter_id": 20589, "verse_number": "५-४८-२१", "content_sanskrit": "यः स्वदेहं प्रपुष्णाति नान्यं जानाति मूढधीः ।\nस पात्यते तैलतप्ते कुंभीपाकेऽतिदारुणे॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000589021, "chapter_id": 20589, "verse_number": "५-४८-२२", "content_sanskrit": "यो नागम्यां स्त्रियं मोहाद्योषिद्भावाच्च कामयेत् ।\nतं तया किंकराः सूर्म्या परिरंभं च कुर्वते॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000589022, "chapter_id": 20589, "verse_number": "५-४८-२३", "content_sanskrit": "ये बलाद्वेदमर्यादां लुंपंति स्वबलोद्धताः ।\nते वैतरण्यां पतिता मांसशोणितभक्षकाः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000589023, "chapter_id": 20589, "verse_number": "५-४८-२४", "content_sanskrit": "वृषलद्यं यः स्त्रियं कृत्वा तया गार्हस्थ्यमाचरेत् ।\nपूयोदे निपतत्येव महादुःखसमन्वितः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000589024, "chapter_id": 20589, "verse_number": "५-४८-२५", "content_sanskrit": "ये दंभमाश्रयंते वै धूर्ता लोकस्य वंचने ।\nवैशसे नरके मूढाः पतंति यमताडिताः॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000589025, "chapter_id": 20589, "verse_number": "५-४८-२६", "content_sanskrit": "ये सवर्णां स्त्रियं मूढा रेतः स्वं पाययंति च ।\nरेतःकुल्यासु ते पापा रेतःपानेषु तत्पराः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000589026, "chapter_id": 20589, "verse_number": "५-४८-२७", "content_sanskrit": "ये चौरा वह्निदा दुष्टा गरदा ग्रामलुंठकाः ।\nसारमेयादने ते वै पात्यंते पातकान्विताः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000589027, "chapter_id": 20589, "verse_number": "५-४८-२८", "content_sanskrit": "कूटसाक्ष्यं वदत्यद्धा पुरुषः पापसंभृतः ।\nपरकीयं तु द्रव्यं यो हरति प्रसभं बली॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000589028, "chapter_id": 20589, "verse_number": "५-४८-२९", "content_sanskrit": "सोऽवीचिनरके पापी अवाग्वक्त्रः पतत्यधः ।\nतत्र दुःखं महद्भुक्त्वा पापिष्ठां योनिमाव्रजेत्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000589029, "chapter_id": 20589, "verse_number": "५-४८-३०", "content_sanskrit": "यो नरो रसनास्वादात्सुरां पिबति मूढधीः ।\nतं पाययंति लोहस्य रसं धर्मस्य किंकराः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000589030, "chapter_id": 20589, "verse_number": "५-४८-३१", "content_sanskrit": "यो गुरूनवमन्येत स्वविद्याचारदर्पितः ।\nस मृतः पात्यते क्षारनरकेऽधोमुखः पुमान्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000589031, "chapter_id": 20589, "verse_number": "५-४८-३२", "content_sanskrit": "विश्वासघातं कुर्वंति ये नरा धर्मनिष्कृताः ।\nशूलप्रोते च नरके पात्यंते बहुयातने॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000589032, "chapter_id": 20589, "verse_number": "५-४८-३३", "content_sanskrit": "पिशुनो यो नरान्सर्वानुद्वेजयति वाक्यतः ।\nदंदशूके च पतितो दंदशूकैः स दश्यते॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000589033, "chapter_id": 20589, "verse_number": "५-४८-३४", "content_sanskrit": "एवं राजन्ननेके वै नरकाः पापकारिणाम् ।\nपापं कृत्वा प्रयांत्येते पीडां यांति सुदारुणाम्॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000589034, "chapter_id": 20589, "verse_number": "५-४८-३५", "content_sanskrit": "यैर्न श्रुता रामकथा न परोपकृतिः कृता ।\nतेषां सर्वाणि दुःखानि भवंति नरकांतरे॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000589035, "chapter_id": 20589, "verse_number": "५-४८-३६", "content_sanskrit": "अत्र यस्य सुखं स्वर्गे भूयात्तस्य इतीर्यते ।\nये दुःखिनो रोगयुता नरकादागताश्च ते॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000589036, "chapter_id": 20589, "verse_number": "५-४८-३७", "content_sanskrit": "शेष उवाच ।\nएतच्छ्रुत्वा महीपालः कंपमानः क्षणे क्षणे ।\nपप्रच्छ भूयस्तं विप्रं सर्वसंशयनुत्तये॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000589037, "chapter_id": 20589, "verse_number": "५-४८-३८", "content_sanskrit": "तत्तत्पापस्य चिह्नानि कथयस्व महामुने ।\nकेन पापेन किं चिह्नं भूलोके उपजायते॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000589038, "chapter_id": 20589, "verse_number": "५-४८-३९", "content_sanskrit": "इति श्रुत्वा तु तद्वाक्यं मुनिः प्रोवाच भूपतिम् ।\nशृणु राजन्प्रवक्ष्यामि चिह्नानि पापकारिणाम्॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000589039, "chapter_id": 20589, "verse_number": "५-४८-४०", "content_sanskrit": "शौनक उवाच ।\nसुरापः श्यामदंतश्च नरकांते प्रजायते ।\nअभक्ष्यभक्षकारी च जायते गुल्मकोदरः॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000589040, "chapter_id": 20589, "verse_number": "५-४८-४१", "content_sanskrit": "उदक्यावीक्षितं भुक्त्वा जायते कृमिलोदरः ।\nश्वमार्जारादिसंस्पृष्टं भुक्त्वा दुर्गंधिमान्भवेत्॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000589041, "chapter_id": 20589, "verse_number": "५-४८-४२", "content_sanskrit": "अनिवेद्य सुरादिभ्यो भुंजानो जायते नरः ।\nउदरे रोगवान्दुःखी महारोगप्रपीडितः॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000589042, "chapter_id": 20589, "verse_number": "५-४८-४३", "content_sanskrit": "परान्नविघ्नकरणादजीर्णमभिजायते ।\nमंदोदराग्निर्भवति सति द्रव्ये कदन्नदः॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000589043, "chapter_id": 20589, "verse_number": "५-४८-४४", "content_sanskrit": "विषदश्छर्दिरोगी स्यान्मार्गहा पादरोगवान् ।\nपिशुनो नरकस्यांते जायते श्वासकासवान्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000589044, "chapter_id": 20589, "verse_number": "५-४८-४५", "content_sanskrit": "धूर्तोऽपस्माररोगी स्याच्छूली च परतापनः ।\nदावाग्निदायकश्चैव रक्तातीसारवान्भवेत्॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000589045, "chapter_id": 20589, "verse_number": "५-४८-४६", "content_sanskrit": "सुरालये जले वापि शकृत्क्षेपं करोति यः ।\nगुदरोगो भवेत्तस्य पापरूपः सुदारुणः॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000589046, "chapter_id": 20589, "verse_number": "५-४८-४७", "content_sanskrit": "गर्भपातनजा रोगाः क्षयमेहजलोदराः ।\nप्रतिमा भंगकारी च अप्रतिष्ठश्च जायते॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000589047, "chapter_id": 20589, "verse_number": "५-४८-४८", "content_sanskrit": "दुष्टवादी खंडितः स्यात्खल्वाटः परनिंदकः ।\nसभायां पक्षपाती च जायते पक्षघातवान्॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000589048, "chapter_id": 20589, "verse_number": "५-४८-४९", "content_sanskrit": "परोक्तहास्यकृत्काणः कुनखी विप्रहेमहृत् ।\nतुंदीवरी ताम्रचौरः कांस्यहृत्पुंडरीकिकः॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000589049, "chapter_id": 20589, "verse_number": "५-४८-५०", "content_sanskrit": "त्रपुहारी च पुरुषो जायते पिंगमूर्द्धजः ।\nशीसहारी च पुरुषो जायते शीर्षरोगवान्॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000589050, "chapter_id": 20589, "verse_number": "५-४८-५१", "content_sanskrit": "घृतचौरस्तु पुरुषो जायते नेत्ररोगवान् ।\nलोहहारी च पुरुषो बर्बरांगः प्रजायते॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000589051, "chapter_id": 20589, "verse_number": "५-४८-५२", "content_sanskrit": "चर्महारी च पुरुषो जायते मेदसा वृतः ।\nमधुचौरस्तु पुरुषो जायते बस्तिगंधवान्॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000589052, "chapter_id": 20589, "verse_number": "५-४८-५३", "content_sanskrit": "तैलचौर्येण भवति नरः कण्ड्वातिपीडितः ।\nआमान्नहरणाच्चैव दंतहीनः प्रजायते॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000589053, "chapter_id": 20589, "verse_number": "५-४८-५४", "content_sanskrit": "पक्वान्नहरणाच्चैव जिह्वारोगयुतो भवेत् ।\nमातृगामी च पुरुषो जायते लिंगवर्जितः॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000589054, "chapter_id": 20589, "verse_number": "५-४८-५५", "content_sanskrit": "गुरुजायाभिगमनान्मूत्रकृच्छ्रः प्रजायते ।\nभगिनीं चैव गमने पीतकुष्ठः प्रजायते॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000589055, "chapter_id": 20589, "verse_number": "५-४८-५६", "content_sanskrit": "स्वसुतागमने चैव रक्तकुष्ठः प्रजायते ।\nभ्रातृभार्याभिगमने गुल्मकुष्ठः प्रजायते॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000589056, "chapter_id": 20589, "verse_number": "५-४८-५७", "content_sanskrit": "स्वामिगम्यादिगमने जायते दद्रुमंडलम् ।\nविश्वस्तभार्यागमने गजचर्मा प्रजायते॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000589057, "chapter_id": 20589, "verse_number": "५-४८-५८", "content_sanskrit": "पितृष्वस्रभिगमने दक्षिणांगे व्रणी भवेत् ।\nमातुलान्यास्तु गमने वामांगे व्रणवान्भवेत्॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000589058, "chapter_id": 20589, "verse_number": "५-४८-५९", "content_sanskrit": "पितृव्यपत्नीगमने कटौ कुष्ठः प्रजायते ।\nमित्रभार्याभिगमने मृतभार्यः प्रजायते॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000589059, "chapter_id": 20589, "verse_number": "५-४८-६०", "content_sanskrit": "स्वगोत्रस्त्रीप्रसंगेन जायते च भगंदरः ।\nतपस्विनीप्रसंगेन प्रमेहो जायते नरे॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000589060, "chapter_id": 20589, "verse_number": "५-४८-६१", "content_sanskrit": "श्रोत्रियस्त्रीप्रसंगेन जायते नासिकाव्रणी ।\nदीक्षितस्त्रीप्रसंगेन जायते दुष्टरक्तसृक्॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000589061, "chapter_id": 20589, "verse_number": "५-४८-६२", "content_sanskrit": "स्वजातिजायागमने जायते हृदयव्रणी ।\nजात्युन्नतस्त्रीगमने जायते मस्तकव्रणी॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000589062, "chapter_id": 20589, "verse_number": "५-४८-६३", "content_sanskrit": "पशुयोनौ च गमनान्मूत्रघातः प्रजायते ।\nएते दोषा नराणां स्युर्नरकांते न संशयः॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000589063, "chapter_id": 20589, "verse_number": "५-४८-६४", "content_sanskrit": "स्त्रीणामपि भवंत्येते तत्तत्पुरुषसंगमात् ।\nएवं राजन्हि चिह्नानि कीर्तितानि सुपापिनाम्॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000589064, "chapter_id": 20589, "verse_number": "५-४८-६५", "content_sanskrit": "दानपुण्यप्रसंगेन तीर्थादिक्रियया तथा ।\nरामस्य चरितं श्रुत्वा तपसा वाक्षयं व्रजेत्॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000589065, "chapter_id": 20589, "verse_number": "५-४८-६६", "content_sanskrit": "सर्वेषामेव पापानां हरिकीर्तिधुनी नृणाम् ।\nक्षालयेत्पापिनां पंकं नात्र कार्या विचारणा॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000589066, "chapter_id": 20589, "verse_number": "५-४८-६७", "content_sanskrit": "यो नावमन्येत हरिं तस्य यागाविधि श्रुताः ।\nतीर्थान्यपि सुपुण्यानि पावितुं न क्षमाणि तम्॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000589067, "chapter_id": 20589, "verse_number": "५-४८-६८", "content_sanskrit": "हसते कीर्त्यमानं यश्चरित्रं ज्ञानदुर्बलः ।\nन तस्य नरकान्मुक्तिः कल्पांतेऽपि भविष्यति॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000589068, "chapter_id": 20589, "verse_number": "५-४८-६९", "content_sanskrit": "या हि राजन्विमोक्षार्थं हयस्यानुचरैः सह ।\nश्रावय श्रीशचरितं यतो वाहगतिर्भवेत्॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000589069, "chapter_id": 20589, "verse_number": "५-४८-७०", "content_sanskrit": "शेष उवाच ।\nइति श्रुत्वा प्रहृष्टोऽभूच्छत्रुघ्नः परवीरहा ।\nप्रणम्य तं परिक्रम्य ययौ सेवकसंयुतः॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000589070, "chapter_id": 20589, "verse_number": "५-४८-७१", "content_sanskrit": "तत्र गत्वा स हनुमान्हयवर्यस्य पार्श्वतः ।\nउवाच रामचरितं महादुर्गतिनाशकम्॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000589071, "chapter_id": 20589, "verse_number": "५-४८-७२", "content_sanskrit": "याहि देव विमानं स्वं रामकीर्तनपुण्यतः ।\nस्वैरं चर स्वलोके त्वं मुक्तो भव कुयोनितः॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000589072, "chapter_id": 20589, "verse_number": "५-४८-७३", "content_sanskrit": "इति वाक्यं समाकर्ण्य शत्रुघ्नो यावदास्थितः ।\nतावद्ददर्श विमलं देवं वैमानिकं वरम्॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000589073, "chapter_id": 20589, "verse_number": "५-४८-७४", "content_sanskrit": "स उवाच विमुक्तोऽहं रामकीर्तनसंश्रुतेः ।\nयामि स्वं भवनं राजन्नाज्ञापय महामते॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000589074, "chapter_id": 20589, "verse_number": "५-४८-७५", "content_sanskrit": "इत्युक्त्वा प्रययौ देवो विमाने स्वे परिस्थितः ।\nतदा विस्मयमापुस्ते शत्रुघ्नेन सहानुगाः॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000589075, "chapter_id": 20589, "verse_number": "५-४८-७६", "content_sanskrit": "ततो वाहो विनिर्मुक्तो गात्रस्तंभाच्च भूतलात् ।\nययौ तद्विपिनं सर्वं भ्रमन्पक्षिसमाकुलम्॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}]