[{"id": 2037264, "chapter_id": 1804, "verse_number": "५-४९-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2037265, "chapter_id": 1804, "verse_number": "५-४९-१", "content_sanskrit": "समवेतेषु सर्वेषु तेषु राजसु भारत।\nदुर्योधनमिदं वाक्यं भीष्मः शान्तनवोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2037266, "chapter_id": 1804, "verse_number": "५-४९-२", "content_sanskrit": "बृहस्पतिश्चोशना च ब्रह्माणं पर्युपस्थितौ।\nमरुतश्च सहेन्द्रेण वसवश्चाग्रिना सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2037267, "chapter_id": 1804, "verse_number": "५-४९-३", "content_sanskrit": "आदित्याश्चैव साध्याश्च ये च सप्तर्पयो दिवि।\nविश्वावसुश्च गन्धर्वः शुभाश्चाप्सरसां गणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2037268, "chapter_id": 1804, "verse_number": "५-४९-४", "content_sanskrit": "नमस्कृत्योपजग्मुस्ते लोकवृद्धं पितामहम् ।\nपरिवार्य च विश्वेशं पर्यासत दिवौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2037269, "chapter_id": 1804, "verse_number": "५-४९-५", "content_sanskrit": "तेषां मनश्च तेजश्चाप्याददानाविवौजसा ।\nपूर्वदेवौ व्यतिक्रान्तौ नरनारायणावृषी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2037270, "chapter_id": 1804, "verse_number": "५-४९-६", "content_sanskrit": "बृहस्पतिस्तु पप्रच्छ ब्रह्माणं काविमाविति।\nभवन्तं नोपतिष्ठेते तौ नः शंस पितामह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2037271, "chapter_id": 1804, "verse_number": "५-४९-७x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2037272, "chapter_id": 1804, "verse_number": "५-४९-७", "content_sanskrit": "यावेतौ पृथिवीं द्यां च भासयन्तौ तपस्विनौ।\nज्वलन्तौ रोचमानौ च व्याप्यातीतौ महाबलौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2037273, "chapter_id": 1804, "verse_number": "५-४९-८", "content_sanskrit": "नरनारायणावेतौ लोकाल्लोकं समास्थितौ ।\nऊर्जितौ स्वेन तपसा महासत्वपराक्रमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2037274, "chapter_id": 1804, "verse_number": "५-४९-९", "content_sanskrit": "एतौ हि कर्मणा लोकं नन्दयामासतुर्ध्रुवम् ।\nद्विधाभूतौ महाप्राज्ञौ विद्धि ब्रह्मन्परन्तपौ ।\nअसुराणां विनाशाय देवगन्धर्वपूजितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2037275, "chapter_id": 1804, "verse_number": "५-४९-१०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2037276, "chapter_id": 1804, "verse_number": "५-४९-१०", "content_sanskrit": "जगाम शक्रस्तच्छ्रत्वा यत्र तौ तेपतुस्तपः ।\nसार्धं देवगणैः सर्वैर्बृहस्पतिपुरोगमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2037277, "chapter_id": 1804, "verse_number": "५-४९-११", "content_sanskrit": "तदा देवासुरे युद्धे भये जाते दिवौकसाम्।\nअयाचत महात्मानौ नरनारायणौ वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2037278, "chapter_id": 1804, "verse_number": "५-४९-१२", "content_sanskrit": "तावब्रूतां वृणीष्वेति तदा भरतसत्तम।\nअथैतावब्रवीच्छकः साह्यं नः क्रियतामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2037279, "chapter_id": 1804, "verse_number": "५-४९-१३", "content_sanskrit": "ततस्तौ शक्रमब्रूतां करिष्यावो यदिच्छसि।\nताभ्यां च सहितः शक्रो विजिग्ये दैत्यदानवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2037280, "chapter_id": 1804, "verse_number": "५-४९-१४", "content_sanskrit": "नर इन्द्रस्य संग्रामे हत्वा शत्रून्परन्तपः ।\nपौलोमान्कालखञ्जांश्च सहस्राणि शतानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2037281, "chapter_id": 1804, "verse_number": "५-४९-१५", "content_sanskrit": "एष भ्रान्ते रथे तिष्ठन्भल्लेनापाहरच्छिरः।\nजम्भस्य ग्रसमानस्य तदा ह्यर्जुन आहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2037282, "chapter_id": 1804, "verse_number": "५-४९-१६", "content_sanskrit": "एष पारे समुद्रस्य हिरण्यपुरमारुजत्।\nहत्वा षष्टिं सहस्राणि निवातकवचान्रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2037283, "chapter_id": 1804, "verse_number": "५-४९-१७", "content_sanskrit": "एष देवान्सहेन्द्रेण जित्वा परपुरञ्जयः।\nअतर्पयन्महाबाहुरर्जुनो जातवेदसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2037284, "chapter_id": 1804, "verse_number": "५-४९-१८", "content_sanskrit": "नारायणस्तथैवात्र भूयसोऽन्याञ्जघान ह।\nएवमेतौ महावीर्यौ तौ पश्यत समागतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2037285, "chapter_id": 1804, "verse_number": "५-४९-१९", "content_sanskrit": "वासुदेवार्जुनौ वीरौ समवेतौ महारथौ ।\nनरनारायणौ देवौ पूर्वदेवाविति श्रुतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2037286, "chapter_id": 1804, "verse_number": "५-४९-२०", "content_sanskrit": "अजेयौ मानुषे लोके सेन्द्रैरपि सुरासुरैः ।\nएष नारायणः कृष्णः फाल्गुनश्च नरः स्मृतः।\nनारायणो नरश्चैव सत्त्वमेकं द्विधा कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2037287, "chapter_id": 1804, "verse_number": "५-४९-२१", "content_sanskrit": "एतौ हि कर्मणा लोकानश्रुवातेऽक्षयान्ध्रुवान्।\nतत्रतत्रैव जायेते युद्धकाले पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2037288, "chapter_id": 1804, "verse_number": "५-४९-२२", "content_sanskrit": "तस्मात्कर्मैव कर्तव्यमिति होवाच नारदः ।\nएतद्धि सर्वमाचष्ट वृष्णिचक्रस्य वेदवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2037289, "chapter_id": 1804, "verse_number": "५-४९-२३", "content_sanskrit": "शङ्खचक्रगदाहस्तं यदा द्रक्ष्यसि केशवम्।\nपर्याददानं चास्त्राणि भीमधन्वानमर्जुनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2037290, "chapter_id": 1804, "verse_number": "५-४९-२४", "content_sanskrit": "सनातनौ महात्मानौ कृष्णावेकरथे स्थितौ।\nदुर्योधन तदा तात स्मर्तासि वचनं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2037291, "chapter_id": 1804, "verse_number": "५-४९-२५", "content_sanskrit": "नोचेदयमभावः स्यात्कुरूणां प्रत्युपस्थितः।\nअर्थाच्च तात धर्माच्च तव बुद्धिरुपप्लुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2037292, "chapter_id": 1804, "verse_number": "५-४९-२६", "content_sanskrit": "न चेद्ग्रहीष्यसे वाक्यं श्रोतामि सुबहून्हतान्।\nतवैव हि मतं सर्वे कुरवः पर्युपासते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2037293, "chapter_id": 1804, "verse_number": "५-४९-२७", "content_sanskrit": "त्रयाणामेव च मतं तत्त्वमेकोऽनुमन्यसे।\nरामेण चैव शप्तस्य कर्णस्य भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2037294, "chapter_id": 1804, "verse_number": "५-४९-२८", "content_sanskrit": "दुर्जातेः सुतपुत्रस्य शकुनेः सौबलस्य च।\nतथा क्षुद्रस्य पापस्य भ्रातुर्दुःशासनस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2037295, "chapter_id": 1804, "verse_number": "५-४९-२९x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2037296, "chapter_id": 1804, "verse_number": "५-४९-२९", "content_sanskrit": "नैवमायुष्मता वाच्यं यन्मामात्थ पितामह ।\nक्षत्रधर्मे स्थितो ह्यस्मि स्वधर्मादनपेयिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2037297, "chapter_id": 1804, "verse_number": "५-४९-३०", "content_sanskrit": "किञ्चान्यन्मयि दुर्वृत्तं येन मां परिगर्हसे।\nन हि मे वृजिनं किञ्चिद्धार्तराष्ट्रा विदुः क्वचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2037298, "chapter_id": 1804, "verse_number": "५-४९-३१", "content_sanskrit": "नाचरं वृजिनं किञ्चिद्धार्तराष्ट्रस्य नित्यशः ।\nअहं हि पाण्डवान्सर्वान्हनिष्यामि रणे स्थितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2037299, "chapter_id": 1804, "verse_number": "५-४९-३२", "content_sanskrit": "प्राग्विरुद्धैः शमं सद्भिः कथं वा क्रियते पुनः।\nराज्ञो हि धृतराष्ट्रस्य सर्वं कार्यं प्रियं मया।\nतथा दुर्योधनस्यापि स हि राज्ये समाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2037300, "chapter_id": 1804, "verse_number": "५-४९-३३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2037301, "chapter_id": 1804, "verse_number": "५-४९-३३", "content_sanskrit": "कर्णस्य तु वचः श्रुत्वा भीष्मः शान्तनवः पुनः।\nधृतराष्ट्रं महाराजमाभाष्येदं वचोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2037302, "chapter_id": 1804, "verse_number": "५-४९-३४", "content_sanskrit": "यदयं कत्थते नित्यं हन्ताहं पाण्डवानिति।\nनायं कलापि संपूर्णा पाण्डवानां महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2037303, "chapter_id": 1804, "verse_number": "५-४९-३५", "content_sanskrit": "अनयो योयमागन्ता पुत्राणां ते दुरात्मनाम् ।\nतदस्य कर्म जानीहि सूतपुत्रस्य दुर्मतेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2037304, "chapter_id": 1804, "verse_number": "५-४९-३६", "content_sanskrit": "एतमाश्रित्य पुत्रस्ते मन्दबुद्धिः सुयोधनः ।\nअवामन्यत तान्वीरान्देवपुत्रानरिन्दमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2037305, "chapter_id": 1804, "verse_number": "५-४९-३७", "content_sanskrit": "किञ्चाप्येतेन तत्कर्म कृतपूर्वं सुदुष्करम्।\nतैर्यथा पाण्डवैः सर्वैरेकैकेन कृतं पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2037306, "chapter_id": 1804, "verse_number": "५-४९-३८", "content_sanskrit": "दृष्ट्वा विराटनगरे भ्रातरं निहतं प्रियम्।\nधनञ्जयेन विक्रम्य किमनेन तदा कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2037307, "chapter_id": 1804, "verse_number": "५-४९-३९", "content_sanskrit": "` सर्वे ह्यस्त्रिविदः शूराः सर्वे प्राप्ता महद्यशः।\nअपि सर्वामरैश्वर्यं त्यजेयुर्न पुनर्जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2037308, "chapter_id": 1804, "verse_number": "५-४९-४०", "content_sanskrit": "सहितान्हि कुरून्सर्वानभियातो धनञ्जयः।\nप्रमथ्य चाच्छिनद्वासः किमयं प्रोषितस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2037309, "chapter_id": 1804, "verse_number": "५-४९-४१", "content_sanskrit": "गन्धर्वैर्घोषयात्रायां ह्रियते यत्सुतस्तव।\nक्व तदा सूतपुत्रोऽभूद्य इदानीं वृषायते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2037310, "chapter_id": 1804, "verse_number": "५-४९-४२", "content_sanskrit": "ननु तत्रापि भीमेन पार्थेन च महात्मना।\nयमाभ्यामेव संगम्य गन्धर्वास्ते पराजिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2037311, "chapter_id": 1804, "verse_number": "५-४९-४३", "content_sanskrit": "एतान्यस्य मृषोक्तानि बहूनि भरतर्षभ ।\nविकत्थनस्य भद्रं ते सदा धर्मार्थलोपिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2037312, "chapter_id": 1804, "verse_number": "५-४९-४४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2037313, "chapter_id": 1804, "verse_number": "५-४९-४४", "content_sanskrit": "भीष्मस्य तु वचः श्रुत्वा भारद्वाजो महामताः।\nधृतराष्ट्रमुवाचेदं राजमध्येऽभिपूजयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2037314, "chapter_id": 1804, "verse_number": "५-४९-४५", "content_sanskrit": "यदाह भरतश्रेष्ठो भीष्मस्तत्क्रियतां नृप ।\nन काममवलिप्तानां वचनं कर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2037315, "chapter_id": 1804, "verse_number": "५-४९-४६", "content_sanskrit": "पुरा युद्धात्साधु मन्ये पाण्डवैः सह सङ्गतम्।\nयद्वाक्यमर्जुनेनोक्तं सञ्जयेन निवेदितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2037316, "chapter_id": 1804, "verse_number": "५-४९-४७", "content_sanskrit": "सर्वं तदभिजानामि करिष्यति च पाण्डवः।\nन ह्यस्य त्रिषु लोकेषु सदृशोऽस्ति धनुर्धरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2037317, "chapter_id": 1804, "verse_number": "५-४९-४८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2037318, "chapter_id": 1804, "verse_number": "५-४९-४८", "content_sanskrit": "अनादृत्य तु तद्वाक्यमर्थवद्द्रोणभीष्मयोः।\nततः स सञ्जयं राजा पर्यपृच्छत पाण्डवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2037319, "chapter_id": 1804, "verse_number": "५-४९-४९", "content_sanskrit": "तदैव कुरवः सर्वे निराशा जीवितेऽभवन् ।\nभीष्मद्रोणौ यदा राजा न सम्यगनुभाषते ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2037320, "chapter_id": 1804, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि यानसन्धिपर्वणि एकोनपञ्चाशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]