[{"id": 5000407000, "chapter_id": 9407, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे अष्टषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000407001, "chapter_id": 9407, "verse_number": "५-६८-१", "content_sanskrit": "अथाहमुत्तरं देव्या पुनरुक्तः ससम्भ्रमम्।\nतव स्नेहान्नरव्याघ्र सौहार्दादनुमान्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000407002, "chapter_id": 9407, "verse_number": "५-६८-२", "content_sanskrit": "एवं बहुविधं वाच्यो रामो दाशरथिस्त्वया।\nयथा मां प्राप्नुयाच्छीघ्रं हत्वा रावणमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000407003, "chapter_id": 9407, "verse_number": "५-६८-३", "content_sanskrit": "यदि वा मन्यसे वीर वसैकाहमरिंदम।\nकस्मिंश्चित् संवृते देशे विश्रान्तः श्वो गमिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000407004, "chapter_id": 9407, "verse_number": "५-६८-४", "content_sanskrit": "मम चाप्यल्पभाग्यायाः सांनिध्यात् तव वानर।\nअस्य शोकविपाकस्य मुहूर्तं स्याद् विमोक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000407005, "chapter_id": 9407, "verse_number": "५-६८-५", "content_sanskrit": "गते हि त्वयि विक्रान्ते पुनरागमनाय वै।\nप्राणानामपि संदेहो मम स्यान्नात्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000407006, "chapter_id": 9407, "verse_number": "५-६८-६", "content_sanskrit": "तवादर्शनजः शोको भूयो मां परितापयेत्।\nदुखाद् दुःखपराभूतां दुर्गतां दुःखभागिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000407007, "chapter_id": 9407, "verse_number": "५-६८-७", "content_sanskrit": "अयं च वीर संदेहस्तिष्ठतीव ममाग्रतः।\nसुमहांस्त्वत्सहायेषु हर्यृक्षेषु हरीश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000407008, "chapter_id": 9407, "verse_number": "५-६८-८", "content_sanskrit": "कथं नु खलु दुष्पारं तरिष्यन्ति महोदधिम्।\nतानि हर्यृक्षसैन्यानि तौ वा नरवरात्मजौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000407009, "chapter_id": 9407, "verse_number": "५-६८-९", "content_sanskrit": "त्रयाणामेव भूतानां सागरस्यास्य लङ्घने।\nशक्तिः स्याद् वैनतेयस्य वायोर्वा तव चानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000407010, "chapter_id": 9407, "verse_number": "५-६८-१०", "content_sanskrit": "तदस्मिन् कार्यनिर्योगे वीरैवं दुरतिक्रमे।\nकिं पश्यसि समाधानं ब्रूहि कार्यविदां वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000407011, "chapter_id": 9407, "verse_number": "५-६८-११", "content_sanskrit": "काममस्य त्वमेवैकः कार्यस्य परिसाधने।\nपर्याप्तः परवीरघ्न यशस्यस्ते बलोदयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000407012, "chapter_id": 9407, "verse_number": "५-६८-१२", "content_sanskrit": "बलैः समग्रैर्यदि मां हत्वा रावणमाहवे।\nविजयी स्वपुरीं रामो नयेत् तत् स्याद् यशस्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000407013, "chapter_id": 9407, "verse_number": "५-६८-१३", "content_sanskrit": "यथाहं तस्य वीरस्य वनादुपधिना हृता।\nरक्षसा तद्भयादेव तथा नार्हति राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000407014, "chapter_id": 9407, "verse_number": "५-६८-१४", "content_sanskrit": "बलैस्तु संकुलां कृत्वा लङ्कां परबलार्दनः।\nमां नयेद् यदि काकुत्स्थस्तत् तस्य सदृशं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000407015, "chapter_id": 9407, "verse_number": "५-६८-१५", "content_sanskrit": "तद् यथा तस्य विक्रान्तमनुरूपं महात्मनः।\nभवत्याहवशूरस्य तथा त्वमुपपादय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000407016, "chapter_id": 9407, "verse_number": "५-६८-१६", "content_sanskrit": "तदर्थोपहितं वाक्यं प्रश्रितं हेतुसंहितम्।\nनिशम्याहं ततः शेषं वाक्यमुत्तरमब्रवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000407017, "chapter_id": 9407, "verse_number": "५-६८-१७", "content_sanskrit": "देवि हर्यृक्षसैन्यानामीश्वरः प्लवतां वरः।\nसुग्रीवः सत्त्वसम्पन्नस्त्वदर्थे कृतनिश्चयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000407018, "chapter_id": 9407, "verse_number": "५-६८-१८", "content_sanskrit": "तस्य विक्रमसम्पन्नाः सत्त्ववन्तो महाबलाः।\nमनःसंकल्पसदृशा निदेशे हरयः स्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000407019, "chapter_id": 9407, "verse_number": "५-६८-१९", "content_sanskrit": "येषां नोपरि नाधस्तान्न तिर्यक् सज्जते गतिः।\nन च कर्मसु सीदन्ति महत्स्वमिततेजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000407020, "chapter_id": 9407, "verse_number": "५-६८-२०", "content_sanskrit": "असकृत् तैर्महाभागैर्वानरैर्बलसंयुतैः।\nप्रदक्षिणीकृता भूमिर्वायुमार्गानुसारिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000407021, "chapter_id": 9407, "verse_number": "५-६८-२१", "content_sanskrit": "मद्विशिष्टाश्च तुल्याश्च सन्ति तत्र वनौकसः।\nमत्तः प्रत्यवरः कश्चिन्नास्ति सुग्रीवसंनिधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000407022, "chapter_id": 9407, "verse_number": "५-६८-२२", "content_sanskrit": "अहं तावदिह प्राप्तः किं पुनस्ते महाबलाः।\nनहि प्रकृष्टाः प्रेष्यन्ते प्रेष्यन्ते हीतरे जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000407023, "chapter_id": 9407, "verse_number": "५-६८-२३", "content_sanskrit": "तदलं परितापेन देवि मन्युरपैतु ते।\nएकोत्पातेन ते लङ्कामेष्यन्ति हरियूथपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000407024, "chapter_id": 9407, "verse_number": "५-६८-२४", "content_sanskrit": "मम पृष्ठगतौ तौ च चन्द्रसूर्याविवोदितौ।\nत्वत्सकाशं महाभागे नृसिंहावागमिष्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000407025, "chapter_id": 9407, "verse_number": "५-६८-२५", "content_sanskrit": "अरिघ्नं सिंहसंकाशं क्षिप्रं द्रक्ष्यसि राघवम्।\nलक्ष्मणं च धनुष्मन्तं लङ्काद्वारमुपागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000407026, "chapter_id": 9407, "verse_number": "५-६८-२६", "content_sanskrit": "नखदंष्ट्रायुधान् वीरान् सिंहशार्दूलविक्रमान्।\nवानरान् वारणेन्द्राभान् क्षिप्रं द्रक्ष्यसि संगतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000407027, "chapter_id": 9407, "verse_number": "५-६८-२७", "content_sanskrit": "शैलाम्बुदनिकाशानां लङ्कामलयसानुषु।\nनर्दतां कपिमुख्यानां नचिराच्छ्रोष्यसे स्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000407028, "chapter_id": 9407, "verse_number": "५-६८-२८", "content_sanskrit": "निवृत्तवनवासं च त्वया सार्धमरिंदमम्।\nअभिषिक्तमयोध्यायां क्षिप्रं द्रक्ष्यसि राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000407029, "chapter_id": 9407, "verse_number": "५-६८-२९", "content_sanskrit": "ततो मया वाग्भिरदीनभाषिणी\nशिवाभिरिष्टाभिरभिप्रसादिता।\nउवाह शान्तिं मम मैथिलात्मजा\nतवातिशोकेन तथातिपीडिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000407030, "chapter_id": 9407, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे श्रीमद्वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे अष्टषष्टितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]