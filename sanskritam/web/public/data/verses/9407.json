[{"id": 40022741, "chapter_id": 9407, "verse_number": "1", "content_sanskrit": "तां कथामिलसम्बद्धां रामेण समुदीरिताम् । लक्ष्मणो भरतश्चैव श्रुत्वा परमविस्मितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40022742, "chapter_id": 9407, "verse_number": "2", "content_sanskrit": "तौ रामं प्राञ्जली भूत्वा तस्य राज्ञो महात्मनः । विस्तरं तस्य भावस्य तदा पप्रच्छतुः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40022743, "chapter_id": 9407, "verse_number": "3", "content_sanskrit": "कथं स राजा स्त्रीभूतो वर्तयामास दुर्गतिः । पुरुषः स यदा भूतः कां वृत्तिं वर्तयत्यसौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40022744, "chapter_id": 9407, "verse_number": "4", "content_sanskrit": "तयोस्तद्भाषितं श्रुत्वा कौतूहलसमन्वितम् । कथयामास काकुत्स्थस्तस्य राज्ञो यथागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40022745, "chapter_id": 9407, "verse_number": "5", "content_sanskrit": "तमेव प्रथमं मासं स्त्रीभूता लोकसुन्दरी । ताभिः परिवृता स्त्रीभिर्ये च पूर्वपदानुगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40022746, "chapter_id": 9407, "verse_number": "6", "content_sanskrit": "तत्काननं विगाह्वाशु विजह्रे लोकसुन्दरी । द्रुमगुल्मलताकीर्णं पद्भ्यां पद्मदलेक्षणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40022747, "chapter_id": 9407, "verse_number": "7", "content_sanskrit": "वाहनानि च सर्वाणि सा त्यक्त्वा वै समन्ततः । पर्वताभोगविवरे तस्मिन्रेमे इला तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40022748, "chapter_id": 9407, "verse_number": "8", "content_sanskrit": "अथ तस्मिन्वनोद्देशे पर्वतस्याविदूरतः । सरः सुरुचिरप्रख्यं नानापक्षिगणैर्युतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40022749, "chapter_id": 9407, "verse_number": "9", "content_sanskrit": "ददर्श सा त्विला तस्मिन्बुधं सोमसुतं तदा । ज्वलन्तं स्वेन वपुषा पूर्णसोममिवोदितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40022750, "chapter_id": 9407, "verse_number": "10", "content_sanskrit": "तपन्तं च तपस्तीव्रमम्भोमध्ये दुरासदम् । यशस्करं कामकरं कारुण्ये पर्यवस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40022751, "chapter_id": 9407, "verse_number": "11", "content_sanskrit": "सा तं जलाशयं सर्वं क्षोभयामास विस्मिता । सहगैः पूर्वपुरुषैः स्त्रीभूतै रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40022752, "chapter_id": 9407, "verse_number": "12", "content_sanskrit": "बुधस्तु तां समीक्ष्यैव कामबाणवशं गतः । नोपलेभे तदा ऽ ऽत्मानं सञ्चचाल तदा ऽ ऽम्भसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40022753, "chapter_id": 9407, "verse_number": "13", "content_sanskrit": "इलां निरीक्षमाणस्तु त्रैलोक्याभ्यधिकां शुभाम् । चिन्तां समभ्यतिक्रामत् का न्वियं देवताधिका ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40022754, "chapter_id": 9407, "verse_number": "14", "content_sanskrit": "न देवीषु न नागीषु नासुरीष्वप्सरःसु च । दृष्टपूर्वा मया काचिद्रूपेणानेन शोभिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40022755, "chapter_id": 9407, "verse_number": "15", "content_sanskrit": "सदृशीयं मम भवेद्यदि नान्यपरिग्रहः । इति बुद्धिं समास्थाय जलात्कूलमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40022756, "chapter_id": 9407, "verse_number": "16", "content_sanskrit": "आश्रमं समुपागम्य ततस्ताः प्रमदोत्तमाः । शब्दापयत धर्मात्मा ताश्चैनं च ववन्दिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40022757, "chapter_id": 9407, "verse_number": "17", "content_sanskrit": "स ताः पप्रच्छ धर्मात्मा कस्यैषा लोकसुन्दरी । किमर्थमागता चैव सर्वमाख्यात मा चिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40022758, "chapter_id": 9407, "verse_number": "18", "content_sanskrit": "शुभं तु तस्य तद्वाक्यं मधुरं मधुराक्षरम् । श्रुत्वा स्त्रियश्च ताः सर्वा ऊचुर्मधुरया गिरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40022759, "chapter_id": 9407, "verse_number": "19", "content_sanskrit": "अस्माकमेषा सुश्रोणी प्रभुत्वे वर्तते सदा । अपतिः काननान्तेषु सहास्माभिश्चरत्यसौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40022760, "chapter_id": 9407, "verse_number": "20", "content_sanskrit": "तद्वाक्यमव्यक्तपदं तासां स्त्रीणां निशम्य च । विद्यामावर्तनीं पुण्यामावर्तयत स द्विजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40022761, "chapter_id": 9407, "verse_number": "21", "content_sanskrit": "सो ऽर्थं विदित्वा सकलं तस्य राज्ञो यथागतम् । सर्वा एव स्त्रियस्ताश्च बभाषे मुनिपुङ्गवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40022762, "chapter_id": 9407, "verse_number": "22", "content_sanskrit": "अत्र किम्पुरुषीर्भूत्वा शैलरोधसि वत्स्यथ । आवासस्तु गिरावस्मिञ्छीघ्रमेव विधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40022763, "chapter_id": 9407, "verse_number": "23", "content_sanskrit": "मूलपत्रफलैः सर्वा वर्तयिष्यथ नित्यदा । स्त्रियः किम्पुरुषान्नाम भर्तऽन्समुपलप्स्यथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40022764, "chapter_id": 9407, "verse_number": "24", "content_sanskrit": "ताः श्रुत्वा सोमपुत्रस्य वाचं किम्पुरुषीकृताः । उपासाञ्चक्रिरे शैलं वध्वस्ता बहुलास्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]