[{"id": 5000067000, "chapter_id": 9067, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे सप्तषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000067001, "chapter_id": 9067, "verse_number": "१-६७-१", "content_sanskrit": "जनकस्य वचः श्रुत्वा विश्वामित्रो महामुनिः।\nधनुर्दर्शय रामाय इति होवाच पार्थिवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000067002, "chapter_id": 9067, "verse_number": "१-६७-२", "content_sanskrit": "ततः स राजा जनकः सचिवान् व्यादिदेश ह।\nधनुरानीयतां दिव्यं गन्धमाल्यानुलेपितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000067003, "chapter_id": 9067, "verse_number": "१-६७-३", "content_sanskrit": "जनकेन समादिष्टाः सचिवाः प्राविशन् पुरम्।\nतद्धनुः पुरतः कृत्वा निर्जग्मुरमितौजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000067004, "chapter_id": 9067, "verse_number": "१-६७-४", "content_sanskrit": "नृणां शतानि पञ्चाशद् व्यायतानां महात्मनाम्।\nमञ्जूषामष्टचक्रां तां समूहुस्ते कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000067005, "chapter_id": 9067, "verse_number": "१-६७-५", "content_sanskrit": "तामादाय सुमञ्जूषामायसीं यत्र तद्धनुः।\nसुरोपमं ते जनकमूचुर्नृपतिमन्त्रिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000067006, "chapter_id": 9067, "verse_number": "१-६७-६", "content_sanskrit": "इदं धनुर्वरं राजन् पूजितं सर्वराजभिः।\nमिथिलाधिप राजेन्द्र दर्शनीयं यदीच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000067007, "chapter_id": 9067, "verse_number": "१-६७-७", "content_sanskrit": "तेषां नृपो वचः श्रुत्वा कृताञ्जलिरभाषत।\nविश्वामित्रं महात्मानं तावुभौ रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000067008, "chapter_id": 9067, "verse_number": "१-६७-८", "content_sanskrit": "इदं धनुर्वरं ब्रह्मञ्जनकैरभिपूजितम्।\nराजभिश्च महावीर्यैरशक्तैः पूरितं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000067009, "chapter_id": 9067, "verse_number": "१-६७-९", "content_sanskrit": "नैतत् सुरगणाः सर्वे सासुरा न च राक्षसाः।\nगन्धर्वयक्षप्रवराः सकिन्नरमहोरगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000067010, "chapter_id": 9067, "verse_number": "१-६७-१०", "content_sanskrit": "क्व गतिर्मानुषाणां च धनुषोऽस्य प्रपूरणे।\nआरोपणे समायोगे वेपने तोलने तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000067011, "chapter_id": 9067, "verse_number": "१-६७-११", "content_sanskrit": "तदेतद् धनुषां श्रेष्ठमानीतं मुनिपुंगव।\nदर्शयैतन्महाभाग अनयो राजपुत्रयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000067012, "chapter_id": 9067, "verse_number": "१-६७-१२", "content_sanskrit": "विश्वामित्रः सरामस्तु श्रुत्वा जनकभाषितम्।\nवत्स राम धनुः पश्य इति राघवमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000067013, "chapter_id": 9067, "verse_number": "१-६७-१३", "content_sanskrit": "महर्षेर्वचनाद् रामो यत्र तिष्ठति तद्धनुः।\nमञ्जूषां तामपावृत्य दृष्ट्वा धनुरथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000067014, "chapter_id": 9067, "verse_number": "१-६७-१४", "content_sanskrit": "इदं धनुर्वरं दिव्यं संस्पृशामीह पाणिना।\nयत्नवांश्च भविष्यामि तोलने पूरणेऽपि वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000067015, "chapter_id": 9067, "verse_number": "१-६७-१५", "content_sanskrit": "बाढमित्यब्रवीद् राजा मुनिश्च समभाषत।\nलीलया स धनुर्मध्ये जग्राह वचनान्मुनेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000067016, "chapter_id": 9067, "verse_number": "१-६७-१६", "content_sanskrit": "पश्यतां नृसहस्राणां बहूनां रघुनन्दनः।\nआरोपयत् स धर्मात्मा सलीलमिव तद्धनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000067017, "chapter_id": 9067, "verse_number": "१-६७-१७", "content_sanskrit": "आरोपयित्वा मौर्वीं च पूरयामास तद्धनुः।\nतद् बभञ्ज धनुर्मध्ये नरश्रेष्ठो महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000067018, "chapter_id": 9067, "verse_number": "१-६७-१८", "content_sanskrit": "तस्य शब्दो महानासीन्निर्घातसमनिःस्वनः।\nभूमिकम्पश्च सुमहान् पर्वतस्येव दीर्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000067019, "chapter_id": 9067, "verse_number": "१-६७-१९", "content_sanskrit": "निपेतुश्च नराः सर्वे तेन शब्देन मोहिताः।\nवर्जयित्वा मुनिवरं राजानं तौ च राघवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000067020, "chapter_id": 9067, "verse_number": "१-६७-२०", "content_sanskrit": "प्रत्याश्वस्ते जने तस्मिन् राजा विगतसाध्वसः।\nउवाच प्राञ्जलिर्वाक्यं वाक्यज्ञो मुनिपुंगवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000067021, "chapter_id": 9067, "verse_number": "१-६७-२१", "content_sanskrit": "भगवन् दृष्टवीर्यो मे रामो दशरथात्मजः।\nअत्यद्भुतमचिन्त्यं च अतर्कितमिदं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000067022, "chapter_id": 9067, "verse_number": "१-६७-२२", "content_sanskrit": "जनकानां कुले कीर्तिमाहरिष्यति मे सुता।\nसीता भर्तारमासाद्य रामं दशरथात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000067023, "chapter_id": 9067, "verse_number": "१-६७-२३", "content_sanskrit": "मम सत्या प्रतिज्ञा सा वीर्यशुल्केति कौशिक।\nसीता प्राणैर्बहुमता देया रामाय मे सुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000067024, "chapter_id": 9067, "verse_number": "१-६७-२४", "content_sanskrit": "भवतोऽनुमते ब्रह्मन् शीघ्रं गच्छन्तु मन्त्रिणः।\nमम कौशिक भद्रं ते अयोध्यां त्वरिता रथैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000067025, "chapter_id": 9067, "verse_number": "१-६७-२५", "content_sanskrit": "राजानं प्रश्रितैर्वाक्यैरानयन्तु पुरं मम।\nप्रदानं वीर्यशुल्कायाः कथयन्तु च सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000067026, "chapter_id": 9067, "verse_number": "१-६७-२६", "content_sanskrit": "मुनिगुप्तौ च काकुत्स्थौ कथयन्तु नृपाय वै।\nप्रीतियुक्तं तु राजानमानयन्तु सुशीघ्रगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000067027, "chapter_id": 9067, "verse_number": "१-६७-२७", "content_sanskrit": "कौशिकस्तु तथेत्याह राजा चाभाष्य मन्त्रिणः।\nअयोध्यां प्रेषयामास धर्मात्मा कृतशासनान्।\nयथावृत्तं समाख्यातुमानेतुं च नृपं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000067028, "chapter_id": 9067, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे सप्तषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]