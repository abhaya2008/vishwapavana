[{"id": 7002404000, "chapter_id": 22404, "verse_number": "१-६६-१", "content_sanskrit": "सुमन्तुरुवाच ।\nइत्युक्त्वा भगवान्ब्रह्मा जगामादर्शनं विभोः ।\nसूर्यमाराधयद्दिण्डी४ सूर्यस्यानुचरोऽभवत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002404001, "chapter_id": 22404, "verse_number": "१-६६-२", "content_sanskrit": "शतानीक उवाच ।\nभूयः कथय विप्रेन्द्र माहात्म्यं भास्करस्य मे ।\nशृण्वतो नास्ति मे तृप्तिरमृतस्येव सुव्रत ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002404002, "chapter_id": 22404, "verse_number": "१-६६-३", "content_sanskrit": "सुमन्तुरुवाच ।\nशृणुष्वावहितो राजन्सम्वादं द्विजशङ्खयोः ।\nयं श्रुत्वा सर्वपापेभ्यो मुच्यते मानवो१ नृप ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002404003, "chapter_id": 22404, "verse_number": "१-६६-४", "content_sanskrit": "आसीनमाश्रमे शंखं द्विजो द्रष्टुं जगाम ह ।\nफलभारानतच्छाये वृक्षवृन्दसमाकुले ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002404004, "chapter_id": 22404, "verse_number": "१-६६-५", "content_sanskrit": "परस्परमृगशृङ्गकण्डूयितमृगावृते ।\nबर्हिर्वनाम्बरानीततीर्थकन्दोपभोगिनि ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002404005, "chapter_id": 22404, "verse_number": "१-६६-६", "content_sanskrit": "प्रभूतकुसुमामोदषट्पदोद्गीतशालिनी ।\nसिद्धदेवर्षिगन्धर्वतीर्थसेवितवारिणि ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002404006, "chapter_id": 22404, "verse_number": "१-६६-७", "content_sanskrit": "मुण्डैश्च जटिलैश्चैव तापसैरुपशोभिते ।\nआश्रमे तं मुनिश्रेष्ठं शंखाह्वं सुखमास्थितम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002404007, "chapter_id": 22404, "verse_number": "१-६६-८", "content_sanskrit": "स्तोत्रैः स्तोतुं सहस्रांशुं तद्भक्तं तत्परायणम् ।\nततः संहत्य सहसा तं भोजककुमारकाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002404008, "chapter_id": 22404, "verse_number": "१-६६-९", "content_sanskrit": "विनीता उपसंगम्य यथावदभिवाद्य च ।\nआसनेषूपविष्टास्त उपविष्टमथाब्रुवन् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002404009, "chapter_id": 22404, "verse_number": "१-६६-१०", "content_sanskrit": "भगवन्त्सर्ववेदेषु२ च्छिंधि नः संशयो महान् ।\nविनयेनोपपन्नानां कुमाराणां ततो मुनिः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002404010, "chapter_id": 22404, "verse_number": "१-६६-११", "content_sanskrit": "अनादींश्चतुरो वेदानुवाच प्रीतमानसः ।\nतेषां तु पठतामेव आश्रमं तु यदृच्छया ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002404011, "chapter_id": 22404, "verse_number": "१-६६-१२", "content_sanskrit": "मुनिश्रेष्ठोऽथ तं देशमाजगाम द्विजो नृप ।\nयथावदर्चितस्तेन शङ्खेनामिततेजसा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002404012, "chapter_id": 22404, "verse_number": "१-६६-१३", "content_sanskrit": "वन्दितश्च कुमारैस्तैरभवत्प्रीतमानसः ।\nअथैतानब्रवीच्छंखस्तान्भोजककुमारकान् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002404013, "chapter_id": 22404, "verse_number": "१-६६-१४", "content_sanskrit": "शिष्टागमादनध्यायः स च जातो विरम्यताम् ।\nयथाज्ञापयसीत्याहुः कुमारास्ते ऋषिं ततः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002404014, "chapter_id": 22404, "verse_number": "१-६६-१५", "content_sanskrit": "प्रपच्छ सिद्धिदश्चैतान्के ह्येते किं पठन्ति च ।\nशङ्खोवाच महाराज कुमारा भोजकात्मजाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002404015, "chapter_id": 22404, "verse_number": "१-६६-१६", "content_sanskrit": "ससूत्रकल्पांश्चतुरो विप्र वेदानधीयते ।\nतथैव सप्तमीकल्पे परिचर्यां च भास्वतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002404016, "chapter_id": 22404, "verse_number": "१-६६-१७", "content_sanskrit": "अग्निकार्यविधानं च प्रतिष्ठाकल्पमादितः ।\nअध्यङ्गलक्षणं ब्रह्मन् रथयात्राविधिं तथा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002404017, "chapter_id": 22404, "verse_number": "१-६६-१८", "content_sanskrit": "द्विज उवाच ।\nकथं क्रियेत सप्तम्यां कभ्रार्चनविधिक्रमः ।\nगन्धपुष्पप्रदीपानां किं फलं रविमन्दिरे ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002404018, "chapter_id": 22404, "verse_number": "१-६६-१९", "content_sanskrit": "केन तुष्यति दानेन व्रतेन नियमेन च ।\nधूपपुष्पोपहारादि किं च देयं विवस्वते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002404019, "chapter_id": 22404, "verse_number": "१-६६-२०", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं तन्मे ब्रूहि तपोधन ।\nविशेषतस्तु माहात्म्यं ब्रूहि मां भास्करस्य हि ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002404020, "chapter_id": 22404, "verse_number": "१-६६-२१", "content_sanskrit": "शङ्ख उवाच ।\nइममर्थं वशिष्ठेन पृष्टः साम्बो यथा पुरा ।\nस चोवाच वशिष्ठाय तदहं कथयामि ते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002404021, "chapter_id": 22404, "verse_number": "१-६६-२२", "content_sanskrit": "अत्राश्रमे पुण्यतमे तीर्थानामुत्तमे प्रभुः ।\nववन्दे नियतात्मानं वशिष्ठं मुनिसत्तमम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002404022, "chapter_id": 22404, "verse_number": "१-६६-२३", "content_sanskrit": "विनयेनोपसंगम्य ववन्दे चरणौ मुनेः ।\nकृतप्रणामं साम्बं तु भक्तिप्रह्वीकृताननम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002404023, "chapter_id": 22404, "verse_number": "१-६६-२४", "content_sanskrit": "विलोक्य परमप्रीतो मुनिः पप्रच्छ तं तदा ।\nसर्वतः स्फुटितं गात्रं कुष्ठेन महता तव ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002404024, "chapter_id": 22404, "verse_number": "१-६६-२५", "content_sanskrit": "घोररूपेण तीव्रेण कथं तद्विगतं तव ।\nकथं च लक्ष्मीरधिका रूपं चातिमनोहरम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002404025, "chapter_id": 22404, "verse_number": "१-६६-२६", "content_sanskrit": "तेजस्वितातिमहती तथैव२ सुकुमारता ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002404026, "chapter_id": 22404, "verse_number": "१-६६-२७", "content_sanskrit": "साम्ब उवाच ।\nस्तुतो नामसहस्रेण लोकनाथो दिवाकरः ।\nदर्शनं च गतः साक्षाद्दत्तवांश्च वरान्मम ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002404027, "chapter_id": 22404, "verse_number": "१-६६-२८", "content_sanskrit": "वशिष्ठ उवाच ।\nकथमाराधितः सूर्यस्त्वया यादवनंदन ।\nकैश्च व्रततपोदानैर्दर्शनं भगवान्गतः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002404028, "chapter_id": 22404, "verse_number": "१-६६-२९", "content_sanskrit": "साम्ब उवाच ।\nशृणुष्वावहितो ब्रह्मन्सर्वमेव मया यथा ।\nतोषितो भगवान्सूर्यो विधिना येन सुव्रत ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002404029, "chapter_id": 22404, "verse_number": "१-६६-३०", "content_sanskrit": "मोहान्मयोपहसितो३ दुर्वासाः कोपनो मुनिः ।\nततोऽहं तस्य शापेन महाकुष्ठमवाप्तवान् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002404030, "chapter_id": 22404, "verse_number": "१-६६-३१", "content_sanskrit": "ततोऽहं पितरं गत्वा कुष्ठयोगाभिपीडितः ।\nलज्जमानोऽतिगर्वेण इदं वाक्यमथाब्रवम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002404031, "chapter_id": 22404, "verse_number": "१-६६-३२", "content_sanskrit": "तात सीदति मे गात्रं स्वरश्च परिहीयते ।\nघोररूपो महाव्याधिर्वपुरेष जिघांसति ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002404032, "chapter_id": 22404, "verse_number": "१-६६-३३", "content_sanskrit": "अशेषव्याधिराज्ञाहं पीडितः क्रूरकर्मणा ।\nवैद्यैरोषधिभिश्चैव न शान्तिर्मम विद्यते ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002404033, "chapter_id": 22404, "verse_number": "१-६६-३४", "content_sanskrit": "सोऽहं त्वया ह्यनुज्ञातस्त्यक्तुमिच्छामि जीवितम् ।\nयदि वाहमनुग्राह्यस्ततोऽनुज्ञातुमर्हसि ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002404034, "chapter_id": 22404, "verse_number": "१-६६-३५", "content_sanskrit": "इत्युक्तवाक्यः स पिता षुत्रशोकाभिपीडितः ।\nपिता क्षणं ततो ध्यात्वा मामेवं वाक्यमुक्तवान् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002404035, "chapter_id": 22404, "verse_number": "१-६६-३६", "content_sanskrit": "धैर्यमाश्रयतां१ पुत्र मा शोके च मनः कृथाः ।\nहन्ति शोकार्दितं व्याधिः शुष्कं तृणमिवानलः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002404036, "chapter_id": 22404, "verse_number": "१-६६-३७", "content_sanskrit": "देवताराधनपरो भव पुत्रक मा शुचः ।\nइत्युक्ते च मया प्रोक्तो देवमाराधयामि कम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002404037, "chapter_id": 22404, "verse_number": "१-६६-३८", "content_sanskrit": "कमाराध्य विमुच्येऽहं तात रोगैः समन्ततः ।\nइत्येवमुक्तो भगवान्मामुवाच पिता मम ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002404038, "chapter_id": 22404, "verse_number": "१-६६-३९", "content_sanskrit": "इममर्थं पुरा पृष्टः पद्मयोनिः सनातनः ।\nयाज्ञवल्क्येन ऋषिणा योगीशेन महात्मना२ ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002404039, "chapter_id": 22404, "verse_number": "१-६६-४०", "content_sanskrit": "यदुवाच महातेजास्तस्मै स यदुनन्दन ।\nतच्छृणुष्व शुचिर्भूत्वा आत्मनः श्रेयसे सुत ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002404040, "chapter_id": 22404, "verse_number": "१-६६-४१", "content_sanskrit": "सुरज्येष्ठं सुखासीनं पद्मयोनिं प्रजापतिम् ।\nयाज्ञवल्क्यो महातेजाः पर्यपृच्छत्पितामहम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002404041, "chapter_id": 22404, "verse_number": "१-६६-४२", "content_sanskrit": "भगवञ्छ्रोतुमिच्छामि किंचिदात्ममनोगतम् ।\nसमाराध्य विभो देवं नरो मुच्येत वै भवात् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002404042, "chapter_id": 22404, "verse_number": "१-६६-४३", "content_sanskrit": "गृहस्थो ब्रह्मचारी वा वानप्रस्थोऽथ भिक्षुकः ।\nय इच्छेन्मोक्षमास्थातुं देवतां कां यजेत सः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002404043, "chapter_id": 22404, "verse_number": "१-६६-४४", "content_sanskrit": "कुतो ह्यस्य ध्रुवः स्वर्गः कुतो नैः श्रेयसं सुखम् ।\nस्वर्गतश्चैव किं कुर्याद्येन न च्यवते पुनः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002404044, "chapter_id": 22404, "verse_number": "१-६६-४५", "content_sanskrit": "देवातानां तु को देवः पितॄणां चैव कः पिता ।\nतस्मात्परतरं यच्च तन्मे ब्रूहि पितामह ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002404045, "chapter_id": 22404, "verse_number": "१-६६-४६", "content_sanskrit": "केन सृष्टमिदं विश्वं ब्रह्मन्स्थावरजङ्गमम् ।\nप्रलयो च कमभ्येति तन्मे त्वं वक्तुमर्हसि ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002404046, "chapter_id": 22404, "verse_number": "१-६६-४७", "content_sanskrit": "ब्रह्मोवाच ।\nसाधु पृष्टोऽस्मि भवता तुष्टश्चास्मि महामते ।\nप्रणम्य शिरसा देवं पुण्योत्तरमनुत्तमम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002404047, "chapter_id": 22404, "verse_number": "१-६६-४८", "content_sanskrit": "कथयिष्ये द्विजश्रेष्ठ शृणुष्वैकमनाधुना ।\nआत्मनः श्रेयसे विप्र शुचिर्भूत्वा समाहितः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002404048, "chapter_id": 22404, "verse_number": "१-६६-४९", "content_sanskrit": "उद्यन्य एष कुरुते जगद्वितिमिरं करैः ।\nनातः परतरो देवः किमन्यत्कथयामि ते ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002404049, "chapter_id": 22404, "verse_number": "१-६६-५०", "content_sanskrit": "अनादि निधनो ह्येषः पुरुषः शाश्वतोऽव्ययः ।\nदीपयत्येव लोकांस्त्रीन्रवी रश्मिभिरुल्बणैः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002404050, "chapter_id": 22404, "verse_number": "१-६६-५१", "content_sanskrit": "सर्वदेवात्मको ह्येष तपसा चांशुतापनः ।\nसर्वस्य जगतो नाथः कर्मसाक्षी शुभाशुभे ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002404051, "chapter_id": 22404, "verse_number": "१-६६-५२", "content_sanskrit": "क्षपयत्येष भूतानि तथा विसृजते पुनः ।\nएष भाति तपत्येष वर्धते च गभस्तिभिः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002404052, "chapter_id": 22404, "verse_number": "१-६६-५३", "content_sanskrit": "एष धाता विधाता च पूषा१ प्रकृतिभावन ।\nन ह्येष क्षयमायाति नित्यमक्षयमण्डलः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002404053, "chapter_id": 22404, "verse_number": "१-६६-५४", "content_sanskrit": "पितॄणां हि पिता देवतानां च देवता ।\nध्रुवं स्थानं स्मृतं ह्येष आधारो जगतस्तथा ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002404054, "chapter_id": 22404, "verse_number": "१-६६-५५", "content_sanskrit": "सर्वकाले जगत्कृत्स्नमादित्यात्संप्रसूयते ।\nप्रलये च तमभ्येति आदित्यं दीप्ततेजसम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002404055, "chapter_id": 22404, "verse_number": "१-६६-५६", "content_sanskrit": "योगिनश्चात्र संलीनास्त्यक्त्वा गृहकलेवरम् ।\nवायुभूता विशन्त्यस्मिंस्तेजोराशौ दिवाकरे ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002404056, "chapter_id": 22404, "verse_number": "१-६६-५७", "content_sanskrit": "तस्य रश्मिसहस्राणि शाखा इव विहंगमाः ।\nवसन्त्याश्रित्य मुनयः संसिद्धा दैवतैः सह ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002404057, "chapter_id": 22404, "verse_number": "१-६६-५८", "content_sanskrit": "जनकादयो गृहस्थास्तु राजानो योगधर्मिणः ।\nवालखिल्यादयश्चैव मुनयो ब्रह्मचारिणः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002404058, "chapter_id": 22404, "verse_number": "१-६६-५९", "content_sanskrit": "व्यासादयो वनस्थाश्च भिक्षुः पञ्चशिखस्तथा ।\nसर्वे३ ते योगमास्थाय प्रविष्टाः सूर्यमण्डलम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002404059, "chapter_id": 22404, "verse_number": "१-६६-६०", "content_sanskrit": "शुको व्यासात्मजः श्रीमान्योगधर्ममवाप्य तु ।\nआदित्यकिरणान्पीत्वा न पुनर्भवमान्तवान् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002404060, "chapter_id": 22404, "verse_number": "१-६६-६१", "content_sanskrit": "शब्दमात्राः श्रुतिसुखा ब्रह्मविष्णुशिवादयः ।\nप्रत्यक्षोऽयं स्मृतो देवः सूर्यस्तिमिरनाशनः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002404061, "chapter_id": 22404, "verse_number": "१-६६-६२", "content_sanskrit": "तस्मादन्यव्रते भक्तिर्न कार्या शुभमिच्छता ।\nहृष्टेन साध्यते यस्माददृष्टं नित्यमेव हि ।\nत्वयातः सततं विप्र अर्चनीयो दिवाकरः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002404062, "chapter_id": 22404, "verse_number": "१-६६-६३", "content_sanskrit": "याज्ञवल्क्य उवाच ।\nअहो य एष कथितो भवता भास्करो मम ।\nदेवता सर्वदेवानां नैतन्मिथ्या प्रजायते ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002404063, "chapter_id": 22404, "verse_number": "१-६६-६४", "content_sanskrit": "तस्य देवस्य माहात्म्यं श्रुतं सुबहुशो मया ।\nदेवर्षिसिद्धमनुजैः स्तुतस्येह महात्मनः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002404064, "chapter_id": 22404, "verse_number": "१-६६-६५", "content_sanskrit": "कः स्तौति दैवतमजं यस्यैतत्सचराचरम् ।\nअक्षयस्याप्रमेयस्य किरणोद्गमनाद्भवेत् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002404065, "chapter_id": 22404, "verse_number": "१-६६-६६", "content_sanskrit": "दक्षिणात्किरणाद्यस्य सम्भूतो भगवान्हरिः ।\nवामाद्भवांस्तथा जातः किरणात्किल कञ्जज ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002404066, "chapter_id": 22404, "verse_number": "१-६६-६७", "content_sanskrit": "लालाटाद्यस्य रुद्रस्तु का तुल्या तेन देवता ।\nतस्य देवस्य कः शक्तः प्रवक्तुं गुणविस्तरम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002404067, "chapter_id": 22404, "verse_number": "१-६६-६८", "content_sanskrit": "सोऽहमिच्छामि देवस्य तस्य सर्वात्मनः प्रभो ।\nश्रोतुमाराधनं येन निस्तरेयं भवार्णकम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7002404068, "chapter_id": 22404, "verse_number": "१-६६-६९", "content_sanskrit": "केनोपायेन मन्त्रैर्वा रहस्यैः परिचर्यया ।\nदानैर्व्रतोपवासैर्वा होमैर्जप्यैरथापि वा ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7002404069, "chapter_id": 22404, "verse_number": "१-६६-७०", "content_sanskrit": "आराधितः समस्तानां क्लेशानां हानिदो रविः ।\nशक्यः समाराधयितुं कथं शंस प्रजापते ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7002404070, "chapter_id": 22404, "verse_number": "१-६६-७१", "content_sanskrit": "धर्मार्थकामसम्प्राप्तौ पुरुषाणां विचेष्टताम् ।\nजन्मन्यवितथा सैका क्रिया यार्कं समाश्रिता ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7002404071, "chapter_id": 22404, "verse_number": "१-६६-७२", "content_sanskrit": "दुर्गसंसारकांतारमपारमभिधावताम् ।\nएकः सूर्यनमस्कारो मुक्तिमार्गस्य देशकः२ ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7002404072, "chapter_id": 22404, "verse_number": "१-६६-७३", "content_sanskrit": "सोऽहमिच्छामि तं देवं सप्तलोकपरायणम् ।\nकालायनमशेषस्य१ जगतो हद्यवस्थितम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7002404073, "chapter_id": 22404, "verse_number": "१-६६-७४", "content_sanskrit": "आराधयितुं गोपालं ग्रहेशममितौजसम् ।\nशङ्करं जगतो दीपं स्मृतमात्राघनाशनम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7002404074, "chapter_id": 22404, "verse_number": "१-६६-७५", "content_sanskrit": "तमनाद्यं सुरश्रेष्ठं प्रसादयितुमिच्छतः ।\nउपदेशप्रदानेन प्रसादं कर्तुमर्हसि ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7002404075, "chapter_id": 22404, "verse_number": "१-६६-७६", "content_sanskrit": "तस्यैतद्वचनं श्रुत्या भक्तिमुद्वहतो रवौ ।\nजगाम परितोषं स पद्मयोनिर्महातपाः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7002404076, "chapter_id": 22404, "verse_number": "१-६६-७७", "content_sanskrit": "ब्रह्मोवाच ।\nयत्पृच्छसि द्विजश्रेष्ठ सूर्यस्याराधनं प्रति ।\nव्रतोपवासजप्यादि तदिहैकमनाः शृणु ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7002404077, "chapter_id": 22404, "verse_number": "१-६६-७८", "content_sanskrit": "अनादि यत्परं ब्रह्म सर्वहेयविवर्जितम् ।\nव्याप्य यत्सर्वभूतेषु स्थितं सदसतः परम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7002404078, "chapter_id": 22404, "verse_number": "१-६६-७९", "content_sanskrit": "प्रधानपुंसोरनयोर्यतः क्षोभः प्रवर्तते ।\nनित्ययोर्व्यापिनोश्चैव जगदादौ महात्मनोः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7002404079, "chapter_id": 22404, "verse_number": "१-६६-८०", "content_sanskrit": "तत्क्षोभकत्वाद् ब्रह्मांडं सृष्टेर्हेतुर्निरञ्जनः ।\nअहेतुरपि सर्वात्मा जायते परमेश्वरः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7002404080, "chapter_id": 22404, "verse_number": "१-६६-८१", "content_sanskrit": "प्रधानपुरुषत्वं च तथैवेश्वरलीलया ।\nसमुपैति ततश्चैवं ब्रह्मत्वं छन्दतः प्रभुः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7002404081, "chapter_id": 22404, "verse_number": "१-६६-८२", "content_sanskrit": "ततः स्थितौ पालयिता विष्णुत्वं जगतः क्षये ।\nरुद्रत्वं च जगन्नाथः स्वेच्छया कुरुते रविः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7002404082, "chapter_id": 22404, "verse_number": "१-६६-८३", "content_sanskrit": "तमेकमक्षरं धाम सर्वदेवनमस्कृतम् ।\nभेदाभेदस्वरूपं तं प्रणिपत्य दिवाकरम् ।\nवर्णयिष्येऽखिलं विप्र तस्यैवाराधनं रवेः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7002404083, "chapter_id": 22404, "verse_number": "१-६६-८४", "content_sanskrit": "गुह्यं चापि तथा तस्य भास्करस्य शृणुष्व वै ।\nतुष्टेन हि पुरा मह्यं कथितं भास्करेण तु ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}]