[{"id": 50014697, "chapter_id": 11540, "verse_number": "1", "content_sanskrit": "राजोवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50014698, "chapter_id": 11540, "verse_number": "2", "content_sanskrit": "मन्वन्तराणि सर्वाणि त्वयोक्तानि श्रुतानि मे। वीर्याण्यनन्तवीर्यस्य हरेस्तत्र कृतानि च॥ ९/१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50014699, "chapter_id": 11540, "verse_number": "3", "content_sanskrit": "योऽसौ सत्यव्रतो नाम राजर्षिर्द्रमिळेश्वरः। ज्ञानं योऽतीतकल्पान्ते लेभे पुरुषसेवया॥ ९/१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50014700, "chapter_id": 11540, "verse_number": "4", "content_sanskrit": "स वै विवस्वतः पुत्रो मनुरासीदिति श्रुतम्। त्वया तस्य सुताश्चोक्ता इक्ष्वाकुप्रमुखा नृपाः॥ ९/१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50014701, "chapter_id": 11540, "verse_number": "5", "content_sanskrit": "तेषां वंशं पृथग् ब्रह्मन् वंशानुचरितानि च। कार्तयस्व महाभाग नित्यं शुश्रूषतां हि नः॥ ९/१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50014702, "chapter_id": 11540, "verse_number": "6", "content_sanskrit": "ये भूता ये भविष्याश्च भवन्त्यद्यतनाश्च ये। तेषां नः पुण्यकार्तीनां पूर्वेषां वद विक्रमान्॥ ९/१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50014703, "chapter_id": 11540, "verse_number": "7", "content_sanskrit": "सूत उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50014704, "chapter_id": 11540, "verse_number": "8", "content_sanskrit": "एवं परीक्षिता राज्ञा सदसि ब्रह्मवादिनाम्। पृष्टः प्रोवाच भगवान् शुकः परमघर्मवित्॥ ९/१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50014705, "chapter_id": 11540, "verse_number": "9", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50014706, "chapter_id": 11540, "verse_number": "10", "content_sanskrit": "श्रूयतां मानवो वंशः प्राचुर्येण परन्तप। न शक्यते विस्तरतो वक्तुं वर्षशतैरपि॥ ९/१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50014707, "chapter_id": 11540, "verse_number": "11", "content_sanskrit": "परावरेषां भूतानामात्मा यः पुरुषः परः। स एवासीदिदं विश्वं कल्पान्तेऽन्यन्न किञ्चन॥ ९/१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50014708, "chapter_id": 11540, "verse_number": "12", "content_sanskrit": "तस्य नाभेरुदस्तात् स पदम्कोशो हिरण्मयः। यस्मिन् जज्ञे महाराज स्वयम्भूश्चतुराननः॥ ९/१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50014709, "chapter_id": 11540, "verse_number": "13", "content_sanskrit": "मरीचिर्मानसस्तस्य जज्ञे तस्यापि कश्यपः। दाक्षायण्यां ततोऽदित्यां विवस्वानभवत् सुतः॥ ९/१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50014710, "chapter_id": 11540, "verse_number": "14", "content_sanskrit": "ततो मनुः श्राद्धदेवः सञ्ज्ञायामास भारत। श्रद्धायां जनयामास दश पुत्रान् स आत्मवान्॥ ९/१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50014711, "chapter_id": 11540, "verse_number": "15", "content_sanskrit": "इक्ष्वाकुनृगशर्यातिदिष्टधृष्टकरूशकान्। नरिष्यन्तं पृषध्रं च नाभागं च नभं विभुम्॥ ९/१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50014712, "chapter_id": 11540, "verse_number": "16", "content_sanskrit": "अप्रजस्य मनोः पूर्वं वसिष्ठो भगवान् किल। मित्रावरुणयोरिष्टिं प्रजार्थमकरोद् विभुः॥ ९/१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50014713, "chapter_id": 11540, "verse_number": "17", "content_sanskrit": "तत्र श्रद्धा मनोः पत्नी होतारं समयाचत। दुहित्रर्थ उपागम्य प्रणिपत्य पयोव्रता॥ ९/१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50014714, "chapter_id": 11540, "verse_number": "18", "content_sanskrit": "प्रेषितोऽध्वर्युणा होता दध्यौ तत् सुसमाहितः। गृहीते तेन हविषि वषट्कारं गृणान् द्विजः॥ ९/१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50014715, "chapter_id": 11540, "verse_number": "19", "content_sanskrit": "होतुस्तद्व्यभिचारेण कन्येळा नाम साऽभवत्। तां विलोक्य मनुः प्राह नातिहृष्टमना गुरुम्॥ ९/१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50014716, "chapter_id": 11540, "verse_number": "20", "content_sanskrit": "भगवन् किमिदं जातं कर्म वो ब्रह्मवादिनाम्। विपरीतमहो कष्टं मैवं स्याद् ब्रह्मविक्रिया॥ ९/१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50014717, "chapter_id": 11540, "verse_number": "21", "content_sanskrit": "यूयं मन्त्रविदो युक्तास्तपसा दग्धकिल्बिषाः। कुतः सङ्कल्पवैषम्यमनृतं विबुधेष्विव॥ ९/१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50014718, "chapter_id": 11540, "verse_number": "22", "content_sanskrit": "तन्निशम्य वचस्तस्य भगवान् प्रपितामहः। होतुर्व्यतिक्रमं ज्ञात्वा बभाषे रविनन्दनम्॥ ९/१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50014719, "chapter_id": 11540, "verse_number": "23", "content_sanskrit": "एतत् सङ्कल्पवैषम्यं होतुस्ते व्यभिचारतः। तथापि साधयिष्येऽहं सुप्रजास्त्वं स्वतेजसा॥ ९/१/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50014720, "chapter_id": 11540, "verse_number": "24", "content_sanskrit": "एवं व्यवसितो राजन् भगवान् स महायशाः। अस्तौषीदादिपुरुषमिळायाः पुंस्त्वकाम्यया॥ ९/१/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50014721, "chapter_id": 11540, "verse_number": "25", "content_sanskrit": "तस्मै कामवरं तुष्टो भगवान् हरिरीश्वरः। ददाविळाऽभवत् तेन सुद्युम्नः पुरुषर्षभः॥ ९/१/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50014722, "chapter_id": 11540, "verse_number": "26", "content_sanskrit": "स एकदा महाराज विचरन् मृगयां वने। वृतः कतिपयामात्यैरश्वमारुह्य सैन्धवम्॥ ९/१/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50014723, "chapter_id": 11540, "verse_number": "27", "content_sanskrit": "प्रगृह्य रुचिरं चापं शरांश्च परमाद्भुतान्। दंसितोऽनुमृगं वीरो जगाम दिशमुत्तराम्॥ ९/१/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50014724, "chapter_id": 11540, "verse_number": "28", "content_sanskrit": "सुकुमारवनं मेरोरधस्तात् प्रविवेश ह। यत्रास्ते भगवान् शर्वो रममाणः सहोमया॥ ९/१/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50014725, "chapter_id": 11540, "verse_number": "29", "content_sanskrit": "तस्मिन् प्रविष्ट एवासौ सुद्युम्नः परवीरहा। अपश्यत् स्त्रियमात्मानमश्वं च वडवां नृप॥ ९/१/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50014726, "chapter_id": 11540, "verse_number": "30", "content_sanskrit": "तथा तदनुगाः सर्व आत्मलिङ्गविपर्ययम्। दृष्ट्वा विमनसोऽभूवन् वीक्ष्यमाणाः परस्परम्॥ ९/१/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50014727, "chapter_id": 11540, "verse_number": "31", "content_sanskrit": "इति श्रीमद्भागवते नवमस्कन्धस्य प्रथमोऽध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]