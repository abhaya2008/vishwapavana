[{"id": 2098591, "chapter_id": 3109, "verse_number": "१३-२३९-१", "content_sanskrit": "उमोवाच।\nएवं कृतस्य धर्मस्य श्रोतुमिच्छाम्यहं प्रभो।\nप्रमाणं फलमानानां तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2098592, "chapter_id": 3109, "verse_number": "१३-२३९-२x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2098593, "chapter_id": 3109, "verse_number": "१३-२३९-२", "content_sanskrit": "प्रमाणकल्पनां देवि दानस्य शृणु भामिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2098594, "chapter_id": 3109, "verse_number": "१३-२३९-३", "content_sanskrit": "यत्सारस्तु नरो लोके तद्दानं चोत्तमं स्मृतम्।\nसर्वदानविधिं प्राहुस्तदेव भुवि शोभने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2098595, "chapter_id": 3109, "verse_number": "१३-२३९-४", "content_sanskrit": "प्रस्थं सारं दरिद्रस्य शतं कोटिधनस्य च।\nप्रस्थसारस्तु तत्प्रस्थं ददन्महदषाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2098596, "chapter_id": 3109, "verse_number": "१३-२३९-५", "content_sanskrit": "कोटिसारस्तु तां कोटिं ददान्महदवाप्नुयात्।\nउभयं तन्महत्तच्च फलेनैव समं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2098597, "chapter_id": 3109, "verse_number": "१३-२३९-६", "content_sanskrit": "धर्मार्थकामभोगेषु शक्त्यभावस्तु मध्यमम्।\nस्वद्रव्यादतिहीनं तु तद्दानमधमं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2098598, "chapter_id": 3109, "verse_number": "१३-२३९-७", "content_sanskrit": "शृणु दत्तस्य वै देवि पञ्चधा फलकल्पनाम्।\nआनन्त्यं च महच्चैव समं हीनं हि पातकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2098599, "chapter_id": 3109, "verse_number": "१३-२३९-८", "content_sanskrit": "तेषां विशेषं वक्ष्यामि शृणु देवि समाहिता।\nदुस्त्यजस्य च वै दानं पात्र आनन्त्यमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2098600, "chapter_id": 3109, "verse_number": "१३-२३९-९", "content_sanskrit": "दानं षङ्गुणयुक्तं तु महदित्यभिधीयते।\nयथाश्रद्धं तु वै दानं यथार्हं सममुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2098601, "chapter_id": 3109, "verse_number": "१३-२३९-१०", "content_sanskrit": "गुणतस्तु तथा हीनं दानं हीनमिति स्मृतम्।\nदानं पातकमित्याहुः षड्गुणानां विपर्यये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2098602, "chapter_id": 3109, "verse_number": "१३-२३९-११", "content_sanskrit": "देवलोके महत्कालमान्त्यस्य फलं विदुः।\nमहतस्तु तथा कालं स्वर्गलोके तु पूज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2098603, "chapter_id": 3109, "verse_number": "१३-२३९-१२", "content_sanskrit": "समस्य तु तदा दानं मानुष्यं भोगमावहेत्।\nदानं निष्फलमित्याहुर्विहीनं क्रियया शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2098604, "chapter_id": 3109, "verse_number": "१३-२३९-१३", "content_sanskrit": "अथवा म्लेच्छदेशेषु तत्र तत्फलतां व्रजेत्।\nनरकं प्रेत्य तिर्यक्षु गच्छेदशुभदानतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2098605, "chapter_id": 3109, "verse_number": "१३-२३९-१४x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2098606, "chapter_id": 3109, "verse_number": "१३-२३९-१४", "content_sanskrit": "अशुभस्यापि दानस्य शुभं स्याच्च फलं कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2098607, "chapter_id": 3109, "verse_number": "१३-२३९-१५x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2098608, "chapter_id": 3109, "verse_number": "१३-२३९-१५", "content_sanskrit": "मनसा तत्वतः शुद्धमानृशंस्यपुरःसरम्।\nप्रीत्या तु सर्वदानानि दत्त्वा फलमवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2098609, "chapter_id": 3109, "verse_number": "१३-२३९-१६", "content_sanskrit": "रहस्यं सर्वदानानामेतद्विद्धि शुभेक्षणे।\nअन्यानि धर्मकार्याणि शृणु सद्भिः कृतानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2098610, "chapter_id": 3109, "verse_number": "१३-२३९-१७", "content_sanskrit": "आरामदेवगोष्ठानि संक्रमाः कूप एव च।\nगोवाटश्च तटाकश्च सभा शाला च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2098611, "chapter_id": 3109, "verse_number": "१३-२३९-१८", "content_sanskrit": "पाषण्डावसथश्चैव पानीयं गोतृणानि च।\nव्याधितानां च भैषज्यमनाथानां च पोषणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2098612, "chapter_id": 3109, "verse_number": "१३-२३९-१९", "content_sanskrit": "अनाथशवसंस्कारस्तीर्थमार्गविशोधनम्।\nव्यसनाभ्यवपत्तिश्च सर्वेषां च स्वशक्तितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2098613, "chapter_id": 3109, "verse_number": "१३-२३९-२०", "content_sanskrit": "एतत्सर्वं समासेन धर्मकार्यमिति स्मृतम्।\nतत्कर्तव्यं मनुष्येण स्वशक्त्या श्रद्धया शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2098614, "chapter_id": 3109, "verse_number": "१३-२३९-२१", "content_sanskrit": "प्रेत्यभावे लभेत्पुण्यं नास्ति तत्र विचारणा।\nरूपं सौभाग्यमारोग्यं बलं सौख्यं लभेन्नरः।\nस्वर्गो वा मानुषे वाऽपि तैस्तैराप्यायते हि सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2098615, "chapter_id": 3109, "verse_number": "१३-२३९-२२x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2098616, "chapter_id": 3109, "verse_number": "१३-२३९-२२", "content_sanskrit": "भगवन्लोकपालेश धर्मस्तु कतिभेदकः।\nदृश्यते परितः सद्भिस्तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2098617, "chapter_id": 3109, "verse_number": "१३-२३९-२३x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2098618, "chapter_id": 3109, "verse_number": "१३-२३९-२३", "content_sanskrit": "शृणु देवि समुद्देशान्नानात्वं धर्मसङ्कटे।\nधर्मा बहुविधा लोके श्रुतिभेदमुखोद्भवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2098619, "chapter_id": 3109, "verse_number": "१३-२३९-२४", "content_sanskrit": "स्मृतिधर्मश्च बहुधा सद्भिराचार इष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2098620, "chapter_id": 3109, "verse_number": "१३-२३९-२५", "content_sanskrit": "देशधर्माश्च दृश्यन्ते कुलधर्मास्तथैव च।\nजातिधर्माश्च वै धर्मा गणधर्माश्च शोभने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2098621, "chapter_id": 3109, "verse_number": "१३-२३९-२६", "content_sanskrit": "शरीरकालवैषम्यादापद्धर्मश्च दृश्यते।\nएतद्धर्मस्य नानात्वं क्रियते लोकवासिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2098622, "chapter_id": 3109, "verse_number": "१३-२३९-२७", "content_sanskrit": "कारणात्तत्रतत्रैव फलं धर्मस्य चेष्यते।\nतत्कारणसमायोगे लभेत्कुर्वन्फलं नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2098623, "chapter_id": 3109, "verse_number": "१३-२३९-२८", "content_sanskrit": "अन्यथा न लभेत्पुण्यमतदर्हः समाविशेत्।\nएवं धर्मस्य नानात्वं फलं कुर्वल्लँभेन्नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2098624, "chapter_id": 3109, "verse_number": "१३-२३९-२९", "content_sanskrit": "श्रौतस्मार्तस्तु धर्माणां प्राकृतो धर्म उच्यते।\nइति ते कथितं देवि भूयः श्रोतुं किमिच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2098625, "chapter_id": 3109, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकोनचत्वारिंशदधिकद्विशततमोऽध्यायः॥ २३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]