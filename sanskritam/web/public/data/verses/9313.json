[{"id": 5000313000, "chapter_id": 9313, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे एकचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000313001, "chapter_id": 9313, "verse_number": "४-४१-१", "content_sanskrit": "ततः प्रस्थाप्य सुग्रीवस्तन्महद्वानरं बलम्।\nदक्षिणां प्रेषयामास वानरानभिलक्षितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000313002, "chapter_id": 9313, "verse_number": "४-४१-२", "content_sanskrit": "नीलमग्निसुतं चैव हनूमन्तं च वानरम्।\nपितामहसुतं चैव जाम्बवन्तं महौजसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000313003, "chapter_id": 9313, "verse_number": "४-४१-३", "content_sanskrit": "सुहोत्रं च शरारिं च शरगुल्मं तथैव च।\nगजं गवाक्षं गवयं सुषेणं वृषभं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000313004, "chapter_id": 9313, "verse_number": "४-४१-४", "content_sanskrit": "मैन्दं च द्विविदं चैव सुषेणं गन्धमादनम्।\nउल्कामुखमनङ्गं च हुताशनसुतावुभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000313005, "chapter_id": 9313, "verse_number": "४-४१-५", "content_sanskrit": "अङ्गदप्रमुखान् वीरान् वीरः कपिगणेश्वरः।\nवेगविक्रमसम्पन्नान् संदिदेश विशेषवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000313006, "chapter_id": 9313, "verse_number": "४-४१-६", "content_sanskrit": "तेषामग्रेसरं चैव बृहद‍्बलमथाङ्गदम्।\nविधाय हरिवीराणामादिशद् दक्षिणां दिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000313007, "chapter_id": 9313, "verse_number": "४-४१-७", "content_sanskrit": "ये केचन समुद्देशास्तस्यां दिशि सुदुर्गमाः।\nकपीशः कपिमुख्यानां स तेषां समुदाहरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000313008, "chapter_id": 9313, "verse_number": "४-४१-८", "content_sanskrit": "सहस्रशिरसं विन्ध्यं नानाद्रुमलतायुतम्।\nनर्मदां च नदीं रम्यां महोरगनिषेविताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000313009, "chapter_id": 9313, "verse_number": "४-४१-९", "content_sanskrit": "ततो गोदावरीं रम्यां कृष्णवेणीं महानदीम्।\nवरदां च महाभागां महोरगनिषेविताम्।\nमेखलानुत्कलांश्चैव दशार्णनगराण्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000313010, "chapter_id": 9313, "verse_number": "४-४१-१०", "content_sanskrit": "आब्रवन्तीमवन्तीं च सर्वमेवानुपश्यत।\nविदर्भानृष्टिकांश्चैव रम्यान् माहिषकानपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000313011, "chapter_id": 9313, "verse_number": "४-४१-११", "content_sanskrit": "तथा वङ्गान् कलिङ्गांश्च कौशिकांश्च समन्ततः।\nअन्वीक्ष्य दण्डकारण्यं सपर्वतनदीगुहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000313012, "chapter_id": 9313, "verse_number": "४-४१-१२", "content_sanskrit": "नदीं गोदावरीं चैव सर्वमेवानुपश्यत।\nतथैवान्ध्रांश्च पुण्ड्रांश्च चोलान् पाण्ड्यांश्च केरलान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000313013, "chapter_id": 9313, "verse_number": "४-४१-१३", "content_sanskrit": "अयोमुखश्च गन्तव्यः पर्वतो धातुमण्डितः।\nविचित्रशिखरः श्रीमांश्चित्रपुष्पितकाननः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000313014, "chapter_id": 9313, "verse_number": "४-४१-१४", "content_sanskrit": "सुचन्दनवनोद्देशो मार्गितव्यो महागिरिः।\nततस्तामापगां दिव्यां प्रसन्नसलिलाशयाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000313015, "chapter_id": 9313, "verse_number": "४-४१-१५", "content_sanskrit": "तत्र द्रक्ष्यथ कावेरीं विहृतामप्सरोगणैः।\nतस्यासीनं नगस्याग्रे मलयस्य महौजसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000313016, "chapter_id": 9313, "verse_number": "४-४१-१६", "content_sanskrit": "द्रक्ष्यथादित्यसंकाशमगस्त्यमृषिसत्तमम् ।\nततस्तेनाभ्यनुज्ञाताः प्रसन्नेन महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000313017, "chapter_id": 9313, "verse_number": "४-४१-१७", "content_sanskrit": "ताम्रपर्णीं ग्राहजुष्टां तरिष्यथ महानदीम्।\nसा चन्दनवनैश्चित्रैः प्रच्छन्नद्वीपवारिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000313018, "chapter_id": 9313, "verse_number": "४-४१-१८", "content_sanskrit": "कान्तेव युवती कान्तं समुद्रमवगाहते।\nततो हेममयं दिव्यं मुक्तामणिविभूषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000313019, "chapter_id": 9313, "verse_number": "४-४१-१९", "content_sanskrit": "युक्तं कवाटं पाण्ड्यानां गता द्रक्ष्यथ वानराः।\nततः समुद्रमासाद्य सम्प्रधार्यार्थनिश्चयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000313020, "chapter_id": 9313, "verse_number": "४-४१-२०", "content_sanskrit": "अगस्त्येनान्तरे तत्र सागरे विनिवेशितः।\nचित्रसानुनगः श्रीमान् महेन्द्रः पर्वतोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000313021, "chapter_id": 9313, "verse_number": "४-४१-२१", "content_sanskrit": "जातरूपमयः श्रीमानवगाढो महार्णवम्।\nनानाविधैर्नगैः फुल्लैर्लताभिश्चोपशोभितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000313022, "chapter_id": 9313, "verse_number": "४-४१-२२", "content_sanskrit": "देवर्षियक्षप्रवरैरप्सरोभिश्च शोभितम्।\nसिद्धचारणसङ्घैश्च प्रकीर्णं सुमनोरमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000313023, "chapter_id": 9313, "verse_number": "४-४१-२३", "content_sanskrit": "तमुपैति सहस्राक्षः सदा पर्वसु पर्वसु।\nद्वीपस्तस्यापरे पारे शतयोजनविस्तृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000313024, "chapter_id": 9313, "verse_number": "४-४१-२४", "content_sanskrit": "अगम्यो मानुषैर्दीप्तस्तं मार्गध्वं समन्ततः।\nतत्र सर्वात्मना सीता मार्गितव्या विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000313025, "chapter_id": 9313, "verse_number": "४-४१-२५", "content_sanskrit": "स हि देशस्तु वध्यस्य रावणस्य दुरात्मनः।\nराक्षसाधिपतेर्वासः सहस्राक्षसमद्युतेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000313026, "chapter_id": 9313, "verse_number": "४-४१-२६", "content_sanskrit": "दक्षिणस्य समुद्रस्य मध्ये तस्य तु राक्षसी।\nअङ्गारकेति विख्याता छायामाक्षिप्य भोजिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000313027, "chapter_id": 9313, "verse_number": "४-४१-२७", "content_sanskrit": "एवं निःसंशयान् कृत्वा संशयान्नष्टसंशयाः।\nमृगयध्वं नरेन्द्रस्य पत्नीममिततेजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000313028, "chapter_id": 9313, "verse_number": "४-४१-२८", "content_sanskrit": "तमतिक्रम्य लक्ष्मीवान् समुद्रे शतयोजने।\nगिरिः पुष्पितको नाम सिद्धचारणसेवितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000313029, "chapter_id": 9313, "verse_number": "४-४१-२९", "content_sanskrit": "चन्द्रसूर्यांशुसंकाशः सागराम्बुसमाश्रयः।\nभ्राजते विपुलैः शृङ्गैरम्बरं विलिखन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000313030, "chapter_id": 9313, "verse_number": "४-४१-३०", "content_sanskrit": "तस्यैकं काञ्चनं शृङ्गं सेवते यं दिवाकरः।\nश्वेतं राजतमेकं च सेवते यन्निशाकरः।\nन तं कृतघ्नाः पश्यन्ति न नृशंसा न नास्तिकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000313031, "chapter_id": 9313, "verse_number": "४-४१-३१", "content_sanskrit": "प्रणम्य शिरसा शैलं तं विमार्गथ वानराः।\nतमतिक्रम्य दुर्धर्षं सूर्यवान्नाम पर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000313032, "chapter_id": 9313, "verse_number": "४-४१-३२", "content_sanskrit": "अध्वना दुर्विगाहेन योजनानि चतुर्दश।\nततस्तमप्यतिक्रम्य वैद्युतो नाम पर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000313033, "chapter_id": 9313, "verse_number": "४-४१-३३", "content_sanskrit": "सर्वकामफलैर्वृक्षैः सर्वकालमनोहरैः।\nतत्र भुक्त्वा वरार्हाणि मूलानि च फलानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000313034, "chapter_id": 9313, "verse_number": "४-४१-३४", "content_sanskrit": "मधूनि पीत्वा जुष्टानि परं गच्छत वानराः।\nतत्र नेत्रमनःकान्तः कुञ्जरो नाम पर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000313035, "chapter_id": 9313, "verse_number": "४-४१-३५", "content_sanskrit": "अगस्त्यभवनं यत्र निर्मितं विश्वकर्मणा।\nतत्र योजनविस्तारमुच्छ्रितं दशयोजनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000313036, "chapter_id": 9313, "verse_number": "४-४१-३६", "content_sanskrit": "शरणं काञ्चनं दिव्यं नानारत्नविभूषितम्।\nतत्र भोगवती नाम सर्पाणामालयः पुरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000313037, "chapter_id": 9313, "verse_number": "४-४१-३७", "content_sanskrit": "विशालरथ्या दुर्धर्षा सर्वतः परिरक्षिता।\nरक्षिता पन्नगैर्घोरैस्तीक्ष्णदंष्ट्रैर्महाविषैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000313038, "chapter_id": 9313, "verse_number": "४-४१-३८", "content_sanskrit": "सर्पराजो महाघोरो यस्यां वसति वासुकिः।\nनिर्याय मार्गितव्या च सा च भोगवती पुरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000313039, "chapter_id": 9313, "verse_number": "४-४१-३९", "content_sanskrit": "तत्र चानन्तरोद्देशा ये केचन समावृताः।\nतं च देशमतिक्रम्य महानृषभसंस्थितिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000313040, "chapter_id": 9313, "verse_number": "४-४१-४०", "content_sanskrit": "सर्वरत्नमयः श्रीमानृषभो नाम पर्वतः।\nगोशीर्षकं पद्मकं च हरिश्यामं च चन्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000313041, "chapter_id": 9313, "verse_number": "४-४१-४१", "content_sanskrit": "दिव्यमुत्पद्यते यत्र तच्चैवाग्निसमप्रभम्।\nन तु तच्चन्दनं दृष्ट्वा स्प्रष्टव्यं तु कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000313042, "chapter_id": 9313, "verse_number": "४-४१-४२", "content_sanskrit": "रोहिता नाम गन्धर्वा घोरं रक्षन्ति तद्वनम्।\nतत्र गन्धर्वपतयः पञ्च सूर्यसमप्रभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000313043, "chapter_id": 9313, "verse_number": "४-४१-४३", "content_sanskrit": "शैलूषो ग्रामणीः शिक्षः शुको बभ्रुस्तथैव च।\nरविसोमाग्निवपुषां निवासः पुण्यकर्मणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000313044, "chapter_id": 9313, "verse_number": "४-४१-४४", "content_sanskrit": "अन्ते पृथिव्या दुर्धर्षास्ततः स्वर्गजितः स्थिताः।\nततः परं न वः सेव्यः पितृलोकः सुदारुणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000313045, "chapter_id": 9313, "verse_number": "४-४१-४५", "content_sanskrit": "राजधानी यमस्यैषा कष्टेन तमसाऽऽवृता।\nएतावदेव युष्माभिर्वीरा वानरपुंगवाः।\nशक्यं विचेतुं गन्तुं वा नातो गतिमतां गतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000313046, "chapter_id": 9313, "verse_number": "४-४१-४६", "content_sanskrit": "सर्वमेतत् समालोक्य यच्चान्यदपि दृश्यते।\nगतिं विदित्वा वैदेह्याः संनिवर्तितुमर्हथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000313047, "chapter_id": 9313, "verse_number": "४-४१-४७", "content_sanskrit": "यश्च मासान्निवृत्तोऽग्रे दृष्टा सीतेति वक्ष्यति।\nमत्तुल्यविभवो भोगैः सुखं स विहरिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000313048, "chapter_id": 9313, "verse_number": "४-४१-४८", "content_sanskrit": "ततः प्रियतरो नास्ति मम प्राणाद् विशेषतः।\nकृतापराधो बहुशो मम बन्धुर्भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000313049, "chapter_id": 9313, "verse_number": "४-४१-४९", "content_sanskrit": "अमितबलपराक्रमा भवन्तो\nविपुलगुणेषु कुलेषु च प्रसूताः।\nमनुजपतिसुतां यथा लभध्वं\nतदधिगुणं पुरुषार्थमारभध्वम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000313050, "chapter_id": 9313, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे एकचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]