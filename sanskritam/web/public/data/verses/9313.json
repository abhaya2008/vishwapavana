[{"id": 40019441, "chapter_id": 9313, "verse_number": "1", "content_sanskrit": "उपस्थितंतुतंकृत्वापुष्पकंपुष्पभूषितम् । अविदूरेस्थितोराममित्युवाचविभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40019442, "chapter_id": 9313, "verse_number": "2", "content_sanskrit": "स तुबद्धाञ्जलि: प्रह्वोविनीतोराक्षसेश्वरः । अब्रवीत्त्वरयोपेतःकिंकरोमीतिराघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40019443, "chapter_id": 9313, "verse_number": "3", "content_sanskrit": "तमब्रवीन्महातेजालक्ष्मणस्योपशृण्वतः । विमृश्यराघवोवाक्यमिदंस्नेहपुरस्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40019444, "chapter_id": 9313, "verse_number": "4", "content_sanskrit": "कृतप्रयत्नकर्माणःसर्वएववनेचराः । रत्नैरर्थैश्चविविधैस्सम्पूज्यन्तांविभीषण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40019445, "chapter_id": 9313, "verse_number": "5", "content_sanskrit": "सहामीभिस्त्वयालङ्कानिर्जिताराक्षसेश्वर । हृष्टैःप्राणभयंत्यक्त्वासङ्ग्रामेष्वनिवर्तिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40019446, "chapter_id": 9313, "verse_number": "6", "content_sanskrit": "त इमेकृतकर्माणस्सर्वएववनौकसः । धनरत्नप्रदानेनकर्मैषांसफलंकुरु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40019447, "chapter_id": 9313, "verse_number": "7", "content_sanskrit": "एवंसम्मानिताश्चेतेमानार्हमानदात्वया । भविष्यन्तिकृतज्ञेननिर्वृताहरियूथपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40019448, "chapter_id": 9313, "verse_number": "8", "content_sanskrit": "त्यागिनंसङ्ग्रहीतारंसानुक्रोशंजितेन्द्रियम् । सर्वेततःअवगच्छन्तिसम्बोधयामिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40019449, "chapter_id": 9313, "verse_number": "9", "content_sanskrit": "हीनंरतिगुणैस्सर्वैरभिहन्तारमाहवे । सेनात्यजतिसम्विग्नानृपतिंतंनरेश्वरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40019450, "chapter_id": 9313, "verse_number": "10", "content_sanskrit": "एवमुक्तस्तुरामेणवानरांस्तान्विभीषणः । रत्नार्थसंविभागेनसर्वानेवाभ्यपूजयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40019451, "chapter_id": 9313, "verse_number": "11", "content_sanskrit": "ततस्तान्पूजितान्दृष्टवारत्नार्थैर्हरियूथपान् । आरुरोहतदारामस्तद्विमानमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40019452, "chapter_id": 9313, "verse_number": "12", "content_sanskrit": "﻿अङ्केनादायवैदेहींलज्जमानांयशस्विनीम् । लक्ष्मणेनसहभ्रात्राविक्रान्तेवधनुष्मता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40019453, "chapter_id": 9313, "verse_number": "13", "content_sanskrit": "अब्रवीत्सविमानस्थःपूजयन्सर्वावानरान् । सुग्रीवं च महावीर्यंकाकुत्स्थसविभीषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40019454, "chapter_id": 9313, "verse_number": "14", "content_sanskrit": "मित्रकार्यंकृतमिदंभवद्भिद्वानरर्षभाः । अनुज्ञातामयासर्वेयथेष्टंप्रतिगच्छत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40019455, "chapter_id": 9313, "verse_number": "15", "content_sanskrit": "यत्तुकार्यंवयस्येनस्निग्धेन च हितेन च । कृतंसुग्रीवतत्सर्वंभवताधर्मभीरुणा ॥ किष्किन्धांप्रतियाह्यावुस्वसैन्येनाभिसम्वृतः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40019456, "chapter_id": 9313, "verse_number": "16", "content_sanskrit": "स्वराज्येवसलङ्कायांमयादत्तेविभीषण ॥ न त्वांधर्षयितुंशक्तास्सेन्द्राअपिदिवौकसः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40019457, "chapter_id": 9313, "verse_number": "17", "content_sanskrit": "योध्यांप्रतियास्यामिराजधानींपितुर्मम ॥ अभ्यनुज्ञातुमिच्छामिसर्वानामन्त्रयामिवः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40019458, "chapter_id": 9313, "verse_number": "18", "content_sanskrit": "वमुक्तास्तुरामेणहरीन्द्राहरयस्तथा ॥ ऊचुःप्राञ्जलयस्सर्वेराक्षसश्चविभीषणः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40019459, "chapter_id": 9313, "verse_number": "19", "content_sanskrit": "अयोध्यांगन्तुमिच्छामःसर्वन्नयतुनोभवान् ॥ मुद्युक्ताविचरिष्यामोवनान्युपननानि च ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40019460, "chapter_id": 9313, "verse_number": "20", "content_sanskrit": "दृष्टवात्वामभिषेकार्ध्रंकौसल्यामभिवाद्य च ॥ अचिरादगमिष्यामःस्वगृहान्नृपसत्तम ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40019461, "chapter_id": 9313, "verse_number": "21", "content_sanskrit": "एवमुक्तस्सधर्मात्मावानरैस्सविभीषणैः ॥ अब्रवीद्वानरान्रामस्ससुग्रीवविभीषणान् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40019462, "chapter_id": 9313, "verse_number": "22", "content_sanskrit": "प्रिययतरंलब्दंयदहंससुहृज्जनः ॥ सर्वैर्भवद्भिःसहितःप्रीतिंलप्स्येपुरींगतः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40019463, "chapter_id": 9313, "verse_number": "23", "content_sanskrit": "क्षिप्रम् सुग्रीवविमानंवानरैस्सह ॥ त्वमप्यारोहसामात्योराक्षसेन्द्रविभीषण ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40019464, "chapter_id": 9313, "verse_number": "24", "content_sanskrit": "ततः स पुष्पकंदिव्यंसुग्रीवस्सहवानरैः ॥ आरुरोहमुदायुक्तःसामात्यश्चविभीषणः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40019465, "chapter_id": 9313, "verse_number": "25", "content_sanskrit": "तेष्वारूढेषुसर्वेषुकौबेरंपरमासनम् ॥ राघवणाभ्यनुज्ञातमुत्पपातविहायसम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40019466, "chapter_id": 9313, "verse_number": "26", "content_sanskrit": "गतेनविमानेनहंसयुक्तेनभास्वता ॥ प्रहृष्टश्चप्रतीतश्चबभौरामःकुबेरवत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]