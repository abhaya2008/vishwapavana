[{"id": 7002850000, "chapter_id": 22850, "verse_number": "९-१३५-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nगौरीं विवाह्य जग्राह हरः पाशुपतं व्रतम् ।\nउमापतिः पशुपतिर्ध्यानासक्तो बभूव ह ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002850001, "chapter_id": 22850, "verse_number": "९-१३५-२", "content_sanskrit": "ब्रह्मादिभिः समामंत्र्य विबुधैः पुत्रलब्धये ।\nगौर्या मनोभिलषितपूरणाय प्रहर्षितैः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002850002, "chapter_id": 22850, "verse_number": "९-१३५-३", "content_sanskrit": "प्रहितः क्षोभणार्थाय समर्थ इति मन्मथः ।\nततो मारः स्मरः कामोप्याजगाम तमाश्रमम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002850003, "chapter_id": 22850, "verse_number": "९-१३५-४", "content_sanskrit": "रतिप्रीतिमदोन्मादवसंतश्रीसहायवान् ।\nनिधानवारुणीदर्पशृंगारैः परिवारितः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002850004, "chapter_id": 22850, "verse_number": "९-१३५-५", "content_sanskrit": "आम्राशोकवनोत्तंसो मालतीकृतशेखरः ।\nवीणामृदंगसंगीतकोकिलाशृंगदूतकः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002850005, "chapter_id": 22850, "verse_number": "९-१३५-६", "content_sanskrit": "झल्लरीवाद्यसंघुष्टभांडागारिकलेखकः ।\nपानमत्ताङ्गनारूढो हिन्दोलाश्चर्यमंत्रिमान् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002850006, "chapter_id": 22850, "verse_number": "९-१३५-७", "content_sanskrit": "दक्षिणानिलगंधाढ्यः कटाक्षेक्षितवर्षवान् ।\nमहाराजाधिराजो वा स्मरः प्राप्तो हरांतिकम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002850007, "chapter_id": 22850, "verse_number": "९-१३५-८", "content_sanskrit": "स पुष्पचापमाकृष्य मदनोन्मादनं शरम् ।\nचिक्षेप त्रिपुरघ्नाय समाधेर्भंगहेतवे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002850008, "chapter_id": 22850, "verse_number": "९-१३५-९", "content_sanskrit": "बुद्ध्वा तं तस्य संकल्पं रुद्रः क्रोधाज्ज्वलन्रुषा ।\nललाटाद्वह्निमसृजत्तृतीय नयनाद्धरः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002850009, "chapter_id": 22850, "verse_number": "९-१३५-१०", "content_sanskrit": "कामो विलोकितस्तेन भस्मीभूतश्च तत्क्षणात् ।\nदग्धं दृष्ट्वा स्मरं शोकाद्रतिप्रीती स्थिते सदा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002850010, "chapter_id": 22850, "verse_number": "९-१३५-११", "content_sanskrit": "करुणं विलपंत्यौ ते सर्वमन्यद्दिशं गतम् ।\nततः शोकार्तहृदया गौरी रुद्रमुवाच ह ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002850011, "chapter_id": 22850, "verse_number": "९-१३५-१२", "content_sanskrit": "भगवन्नस्मदर्थे तं कामं निर्दग्धवानसि ।\nतेनैते पश्य नार्यौ ते कामस्य रुदितः कथम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002850012, "chapter_id": 22850, "verse_number": "९-१३५-१३", "content_sanskrit": "कुरु प्रसादं देवेश रतिप्रीत्ये वृषध्वज ।\nसंजीवय स्मरं शंभो मूर्तिमंतं पुनः कुरु ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002850013, "chapter_id": 22850, "verse_number": "९-१३५-१४", "content_sanskrit": "तच्छ्रुत्वा तु महादेवो हृष्टः प्रोवाच पार्वतीम् ।\nउपप्लुतं जगत्सर्वं मन्मथेन शरीरिणा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002850014, "chapter_id": 22850, "verse_number": "९-१३५-१५", "content_sanskrit": "मया दग्धस्य कामस्य पुनरागमनं कुतः ।\nकिं तु ते मानयन्वाक्यं करोमि सफलं प्रिये ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002850015, "chapter_id": 22850, "verse_number": "९-१३५-१६", "content_sanskrit": "अस्मिन्वसंतसमये शुक्लपक्षे त्रयोदशी ।\nअस्यां मनोभवो देवि भविष्यति शरीरवान् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002850016, "chapter_id": 22850, "verse_number": "९-१३५-१७", "content_sanskrit": "एतेन बीजभूतेन जगद्वर्णिष्यतेऽखिलम् ।\nएवं वरमिमं दत्त्वा मन्मथाय युधिष्ठिर ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002850017, "chapter_id": 22850, "verse_number": "९-१३५-१८", "content_sanskrit": "जगाम हिमवच्छृंगं कैलासं पार्वतीप्रियः ।\nतदेतत्सर्वमाख्यातं स्मरस्य चरितं नृप ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002850018, "chapter_id": 22850, "verse_number": "९-१३५-१९", "content_sanskrit": "पूजाविधानमपरं कथयामि शृणुण्व तत् ।\nअस्यां स्नात्वा त्रयोदश्यामशोकाख्यं नगं लिखेत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002850019, "chapter_id": 22850, "verse_number": "९-१३५-२०", "content_sanskrit": "सिन्दूरजनितैरंगैरतिप्रीति समन्वितम् ।\nकामदेवं वसंतं च वाजिवक्त्रं झषध्वजम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002850020, "chapter_id": 22850, "verse_number": "९-१३५-२१", "content_sanskrit": "सौवर्णं वा महाराज वार्क्षं चित्रमथापि वा ।\nलीलाविलासगमनं गर्वितं साप्स रोगणम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002850021, "chapter_id": 22850, "verse_number": "९-१३५-२२", "content_sanskrit": "गन्धर्वगीतवादित्रप्रेक्षणीयसमाकुलम् ।\nनंद्यावर्तिरतिक्रीडाप्रीतिविद्याधरैर्युतम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002850022, "chapter_id": 22850, "verse_number": "९-१३५-२३", "content_sanskrit": "मध्याह्ने भोजयेद्भक्त्या भक्ष्यैर्धूपैःस्रगंबरैः ।\nमंत्रेणानेन कौंतेय नरो नार्या समन्वितः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002850023, "chapter_id": 22850, "verse_number": "९-१३५-२४", "content_sanskrit": "नमो वामाय कामाय देवदेवाय मूर्तये ।\nब्रह्मविष्णुशिवेन्द्राणां मनःक्षोभकराय वै ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002850024, "chapter_id": 22850, "verse_number": "९-१३५-२५", "content_sanskrit": "कृत्वैवमर्चयित्वा तु देवदेवमनोभवम् ।\nततस्तस्याग्रतो देया मोदका मुखमोदकाः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002850025, "chapter_id": 22850, "verse_number": "९-१३५-२६", "content_sanskrit": "नानाप्रकारान्भक्ष्यांश्च कामो मे प्रीयतामिति ।\nततो विसर्जयेद्विप्रान्दत्त्वा युग्मं सदक्षिणम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002850026, "chapter_id": 22850, "verse_number": "९-१३५-२७", "content_sanskrit": "स्वपतिं पूजयेन्नारी वस्त्रमालाविभूषणैः ।\nकामोऽयमिति संचिंत्य प्रहृष्टेनांतरात्मना ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002850027, "chapter_id": 22850, "verse_number": "९-१३५-२८", "content_sanskrit": "मन्मथायतने तस्मिन्यजमानः सुहृद्वृतः ।\nरात्रौ जागरणं कुर्यात्सुखरात्रिर्यथा भवेत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002850028, "chapter_id": 22850, "verse_number": "९-१३५-२९", "content_sanskrit": "कर्पूरकुंकुमक्षोदगंधतांबूलसर्जनैः ।\nनानाप्रकारैर्भक्ष्यैश्च कुर्याद्रात्रौ महोत्सवम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002850029, "chapter_id": 22850, "verse_number": "९-१३५-३०", "content_sanskrit": "दीपप्रज्वालनैर्नृत्यैः प्रेक्षणैः प्रेक्षणोत्सवैः ।\nएवं यः कुरुते पार्थ वर्षेवर्षे महोत्सवम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002850030, "chapter_id": 22850, "verse_number": "९-१३५-३१", "content_sanskrit": "वसंतसमये प्राप्ते हृष्टस्तुष्टो नृपः पुरे ।\nतस्य संवत्सरं यावल्लोको रोगैर्विमुच्यते ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002850031, "chapter_id": 22850, "verse_number": "९-१३५-३२", "content_sanskrit": "सुभिक्षं क्षेममारोग्यं यशः श्रीः सौख्यमुत्तमम् ।\nकामवर्षी च पर्जन्यस्तस्मिन्राष्ट्रे प्रजायते ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002850032, "chapter_id": 22850, "verse_number": "९-१३५-३३", "content_sanskrit": "तुष्यते तु भृशं देवो द्वादशार्द्धार्द्धलोचनः ।\nतथा कामश्च विष्णुश्च वसंतश्च प्रजापतिः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002850033, "chapter_id": 22850, "verse_number": "९-१३५-३४", "content_sanskrit": "चन्द्रसूर्यादिका सर्वे ग्रहा ब्रह्मर्षयस्तथा ।\nसर्वेऽपि तस्य तुष्यंति यक्षगंधर्वदानवाः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002850034, "chapter_id": 22850, "verse_number": "९-१३५-३५", "content_sanskrit": "असुरा यातुधानाश्च सुपर्णाः पतगा नगाः ।\nतुष्टाः प्रयच्छंति सुखं तस्य कर्तुर्न संशयः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002850035, "chapter_id": 22850, "verse_number": "९-१३५-३६", "content_sanskrit": "चैत्रोत्सवे सकललोकमनोनिवासं कामं वसंतमलयाद्रिमरुत्सहायम् ।\nरत्या सहार्च्य पुरुषः प्रवरा च योषित्सौभाग्यरूपसुतसौख्ययुता सदा स्यात् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]