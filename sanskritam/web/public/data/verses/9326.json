[{"id": 5000326000, "chapter_id": 9326, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे चतुःपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000326001, "chapter_id": 9326, "verse_number": "४-५४-१", "content_sanskrit": "तथा ब्रुवति तारे तु ताराधिपतिवर्चसि।\nअथ मेने हृतं राज्यं हनूमानङ्गदेन तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000326002, "chapter_id": 9326, "verse_number": "४-५४-२", "content_sanskrit": "बुद‍्ध्या ह्यष्टाङ्गया युक्तं चतुर्बलसमन्वितम्।\nचतुर्दशगुणं मेने हनूमान् वालिनः सुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000326003, "chapter_id": 9326, "verse_number": "४-५४-३", "content_sanskrit": "आपूर्यमाणं शश्वच्च तेजोबलपराक्रमैः।\nशशिनं शुक्लपक्षादौ वर्धमानमिव श्रिया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000326004, "chapter_id": 9326, "verse_number": "४-५४-४", "content_sanskrit": "बृहस्पतिसमं बुद्ध्या विक्रमे सदृशं पितुः।\nशुश्रूषमाणं तारस्य शुक्रस्येव पुरंदरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000326005, "chapter_id": 9326, "verse_number": "४-५४-५", "content_sanskrit": "भर्तुरर्थे परिश्रान्तं सर्वशास्त्रविशारदः।\nअभिसंधातुमारेभे हनूमानङ्गदं ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000326006, "chapter_id": 9326, "verse_number": "४-५४-६", "content_sanskrit": "स चतुर्णामुपायानां तृतीयमुपवर्णयन्।\nभेदयामास तान् सर्वान् वानरान् वाक्यसम्पदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000326007, "chapter_id": 9326, "verse_number": "४-५४-७", "content_sanskrit": "तेषु सर्वेषु भिन्नेषु ततोऽभीषयदङ्गदम्।\nभीषणैर्विविधैर्वाक्यैः कोपोपायसमन्वितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000326008, "chapter_id": 9326, "verse_number": "४-५४-८", "content_sanskrit": "त्वं समर्थतरः पित्रा युद्धे तारेय वै ध्रुवम्।\nदृढं धारयितुं शक्तः कपिराज्यं यथा पिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000326009, "chapter_id": 9326, "verse_number": "४-५४-९", "content_sanskrit": "नित्यमस्थिरचित्ता हि कपयो हरिपुंगव।\nनाज्ञाप्यं विषहिष्यन्ति पुत्रदारं विना त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000326010, "chapter_id": 9326, "verse_number": "४-५४-१०", "content_sanskrit": "त्वां नैते ह्यनुरञ्जेयुः प्रत्यक्षं प्रवदामि ते।\nयथायं जाम्बवान् नीलः सुहोत्रश्च महाकपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000326011, "chapter_id": 9326, "verse_number": "४-५४-११", "content_sanskrit": "नह्यहं ते इमे सर्वे सामदानादिभिर्गुणैः।\nदण्डेन न त्वया शक्याः सुग्रीवादपकर्षितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000326012, "chapter_id": 9326, "verse_number": "४-५४-१२", "content_sanskrit": "विगृह्यासनमप्याहुर्दुर्बलेन बलीयसा।\nआत्मरक्षाकरस्तस्मान्न विगृह्णीत दुर्बलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000326013, "chapter_id": 9326, "verse_number": "४-५४-१३", "content_sanskrit": "यां चेमां मन्यसे धात्रीमेतद् बिलमिति श्रुतम्।\nएतल्लक्ष्मणबाणानामीषत् कार्यं विदारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000326014, "chapter_id": 9326, "verse_number": "४-५४-१४", "content_sanskrit": "स्वल्पं हि कृतमिन्द्रेण क्षिपता ह्यशनिं पुरा।\nलक्ष्मणो निशितैर्बाणैर्भिन्द्यात् पत्रपुटं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000326015, "chapter_id": 9326, "verse_number": "४-५४-१५", "content_sanskrit": "लक्ष्मणस्य च नाराचा बहवः सन्ति तद्विधाः।\nवज्राशनिसमस्पर्शा गिरीणामपि दारकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000326016, "chapter_id": 9326, "verse_number": "४-५४-१६", "content_sanskrit": "अवस्थानं यदैव त्वमासिष्यसि परंतप।\nतदैव हरयः सर्वे त्यक्ष्यन्ति कृतनिश्चयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000326017, "chapter_id": 9326, "verse_number": "४-५४-१७", "content_sanskrit": "स्मरन्तः पुत्रदाराणां नित्योद्विग्ना बुभुक्षिताः।\nखेदिता दुःखशय्याभिस्त्वां करिष्यन्ति पृष्ठतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000326018, "chapter_id": 9326, "verse_number": "४-५४-१८", "content_sanskrit": "स त्वं हीनः सुहृद्भिश्च हितकामैश्च बन्धुभिः।\nतृणादपि भृशोद्विग्नः स्पन्दमानाद् भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000326019, "chapter_id": 9326, "verse_number": "४-५४-१९", "content_sanskrit": "न च जातु न हिंस्युस्त्वां घोरा लक्ष्मणसायकाः।\nअपवृत्तं जिघांसन्तो महावेगा दुरासदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000326020, "chapter_id": 9326, "verse_number": "४-५४-२०", "content_sanskrit": "अस्माभिस्तु गतं सार्धं विनीतवदुपस्थितम्।\nआनुपूर्व्यात्तु सुग्रीवो राज्ये त्वां स्थापयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000326021, "chapter_id": 9326, "verse_number": "४-५४-२१", "content_sanskrit": "धर्मराजः पितृव्यस्ते प्रीतिकामो दृढव्रतः।\nशुचिः सत्यप्रतिज्ञश्च स त्वां जातु न नाशयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000326022, "chapter_id": 9326, "verse_number": "४-५४-२२", "content_sanskrit": "प्रियकामश्च ते मातुस्तदर्थं चास्य जीवितम्।\nतस्यापत्यं च नास्त्यन्यत् तस्मादङ्गद गम्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000326023, "chapter_id": 9326, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे चतुःपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]