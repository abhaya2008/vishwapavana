  },
  {
    "id": 16778072,
    "chapter_id": 6178,
    "verse_number": "2.72",
    "content_sanskrit": "अत्र यजमानः परस्तादायुषः स्वाहापजहि परिघमित्युक्त्वोत्तिष्ठति तस्मै वसवः प्रातःसवनं सम्प्रयच्छन्ति ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
