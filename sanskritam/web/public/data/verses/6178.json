[
  {
    "id": 16778001,
    "chapter_id": 6178,
    "verse_number": "2.1",
    "content_sanskrit": "समस्तस्य खलु साम्न उपासनꣳ साधु यत्खलु साधु तत्सामेत्याचक्षते यदसाधु तदसामेति ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "base_unit_id": "Ch_C02_S01_V01"
  },
  {
    "id": 16778002,
    "chapter_id": 6178,
    "verse_number": "2.2",
    "content_sanskrit": "तदुताप्याहुः साम्नैनमुपागादिति साधुनैनमुपागादित्येव तदाहुरसाम्नैनमुपागादित्यसाधुनैनमुपागादित्येव तदाहुः ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "base_unit_id": "Ch_C02_S01_V02"
  },
  {
    "id": 16778003,
    "chapter_id": 6178,
    "verse_number": "2.3",
    "content_sanskrit": "अथोताप्याहुः साम नो बतेति यत्साधु भवति साधु बतेत्येव तदाहुरसाम नो बतेति यदसाधु भवत्यसाधु बतेत्येव तदाहुः ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "base_unit_id": "Ch_C02_S01_V03"
  },
  {
    "id": 16778004,
    "chapter_id": 6178,
    "verse_number": "2.4",
    "content_sanskrit": "स य एतदेवं विद्वान्साधु सामेत्युपास्तेऽभ्याशो ह यदेनꣳ साधवो धर्मा आ च गच्छेयुरुप च नमेयुः ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "base_unit_id": "Ch_C02_S01_V04"
  },
  {
    "id": 16778005,
    "chapter_id": 6178,
    "verse_number": "2.5",
    "content_sanskrit": "लोकेषु पञ्चविधꣳ सामोपासीत पृथिवी हिङ्कारः । अग्निः प्रस्तावोऽन्तरिक्षमुद्गीथ आदित्यः प्रतिहारो द्यौर्निधनमित्यूर्ध्वेषु ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "base_unit_id": "Ch_C02_S02_V01"
  },
  {
    "id": 16778006,
    "chapter_id": 6178,
    "verse_number": "2.6",
    "content_sanskrit": "अथावृत्तेषु द्यौर्हिङ्कार आदित्यः प्रस्तावोऽन्तरिक्षमुद्गीथोऽग्निः प्रतिहारः पृथिवी निधनम् ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "base_unit_id": "Ch_C02_S02_V02"
  },
  {
    "id": 16778007,
    "chapter_id": 6178,
    "verse_number": "2.7",
    "content_sanskrit": "कल्पन्ते हास्मै लोका ऊर्ध्वाश्चावृत्ताश्च य एतदेवं विद्वांल्लोकेषु पञ्चविधं सामोपास्ते ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "base_unit_id": "Ch_C02_S02_V03"
  },
  {
    "id": 16778008,
    "chapter_id": 6178,
    "verse_number": "2.8",
    "content_sanskrit": "वृष्टौ पञ्चविधं सामोपासीत पुरोवातो हिङ्कारो मेघो जायते स प्रस्तावो वर्षति स उद्गीथो विद्योतते स्तनयति स प्रतिहार उद्गृह्णाति तन्निधनम् ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "base_unit_id": "Ch_C02_S03_V01"
  },
  {
    "id": 16778009,
    "chapter_id": 6178,
    "verse_number": "2.9",
    "content_sanskrit": "वर्षति हास्मै वर्षयति ह य एतदेवं विद्वान्वृष्टौ पञ्चविधं सामोपास्ते ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "base_unit_id": "Ch_C02_S03_V02"
  },
  {
    "id": 16778010,
    "chapter_id": 6178,
    "verse_number": "2.10",
    "content_sanskrit": "सर्वास्वप्सु पञ्चविधꣳ सामोपासीत मेघो यत्सम्प्लवते स हिङ्कारो यद्वर्षति स प्रस्तावो याः प्राच्यः स्यन्दन्ते स उद्गीथो याः प्रतीच्यः स प्रतिहारः समुद्रो निधनम् ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "base_unit_id": "Ch_C02_S04_V01"
  },
  {
    "id": 16778011,
    "chapter_id": 6178,
    "verse_number": "2.11",
    "content_sanskrit": "न हाप्सु पॆत्यप्सुमान्भवति य एतदेवं विद्वान्सर्वास्वप्सु पञ्चविधꣳ सामोपास्ते ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "base_unit_id": "Ch_C02_S04_V02"
  },
  {
    "id": 16778012,
    "chapter_id": 6178,
    "verse_number": "2.12",
    "content_sanskrit": "ऋतुषु पञ्चविधꣳ सामोपासीत वसन्तो हिङ्कारो ग्रीष्मः प्रस्तावो वर्षा उद्गीथः शरत्प्रतिहारो हेमन्तो निधनम् ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "base_unit_id": "Ch_C02_S05_V01"
  },
  {
    "id": 16778013,
    "chapter_id": 6178,
    "verse_number": "2.13",
    "content_sanskrit": "कल्पन्ते हास्मा ॠतव ॠतुमान्भवति य एतदेवं विद्वानृतुषु पञ्चविधꣳ सामोपास्ते ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "base_unit_id": "Ch_C02_S05_V02"
  },
  {
    "id": 16778014,
    "chapter_id": 6178,
    "verse_number": "2.14",
    "content_sanskrit": "पशुषु पञ्चविधꣳ सामोपासीताजा हिङ्कारोऽवयः प्रस्तावो गाव उद्गीथोऽश्वाः प्रतिहारः पुरुषो निधनम् ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "base_unit_id": "Ch_C02_S06_V01"
  },
  {
    "id": 16778015,
    "chapter_id": 6178,
    "verse_number": "2.15",
    "content_sanskrit": "भवन्ति हास्य पशवः पशुमान्भवति य एतदेवं विद्वान्पशुषु पञ्चविधꣳ सामोपास्ते ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "base_unit_id": "Ch_C02_S06_V02"
  },
  {
    "id": 16778016,
    "chapter_id": 6178,
    "verse_number": "2.16",
    "content_sanskrit": "प्राणेषु पञ्चविधं परोवरीयः सामोपासीत प्राणो हिङ्कारो वाक्प्रस्तावश्चक्षुरुद्गीथः श्रोत्रं प्रतिहारो मनो निधनं परोवरीयांसि वा एतानि ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "base_unit_id": "Ch_C02_S07_V01"
  },
  {
    "id": 16778017,
    "chapter_id": 6178,
    "verse_number": "2.17",
    "content_sanskrit": "परोवरीयो हास्य भवति परोवरीयसो ह लोकाञ्जयति य एतदेवं विद्वान्प्राणेषु पञ्चविधं परोवरीयः सामोपास्त इति तु पञ्चविधस्य ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "base_unit_id": "Ch_C02_S07_V02"
  },
  {
    "id": 16778018,
    "chapter_id": 6178,
    "verse_number": "2.18",
    "content_sanskrit": "अथ सप्तविधस्य वाचि सप्तविधꣳ सामोपासीत यत्किञ्च वाचो हुमिति स हिङ्कारो युत्प्रेति स प्रस्तावो यदेति स आदिः ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "base_unit_id": "Ch_C02_S08_V01"
  },
  {
    "id": 16778019,
    "chapter_id": 6178,
    "verse_number": "2.19",
    "content_sanskrit": "यदुदिति स उद्गीथो यत्प्रतीति स प्रतिहारो यदुपेति स उपद्रवो यन्नीति तन्निधनम् ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "base_unit_id": "Ch_C02_S08_V02"
  },
  {
    "id": 16778020,
    "chapter_id": 6178,
    "verse_number": "2.20",
    "content_sanskrit": "दुग्धेऽस्मै वाग्दोहं यो वाचो दोहोऽन्नवानन्नादो भवति य एतदेवं विद्वान्वाचि सप्तविधꣳ सामोपास्ते ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "base_unit_id": "Ch_C02_S08_V03"
  },
  {
    "id": 16778021,
    "chapter_id": 6178,
    "verse_number": "2.21",
    "content_sanskrit": "अथ खल्वमुमादित्यꣳ सप्तविधꣳ सामोपासीत सर्वदा समस्तेन साम मां प्रति मां प्रतीति सर्वेण समस्तेन साम ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "base_unit_id": "Ch_C02_S09_V01"
  },
  {
    "id": 16778022,
    "chapter_id": 6178,
    "verse_number": "2.22",
    "content_sanskrit": "तस्मिन्निमानि सर्वाणि भूतान्यन्वायत्तानीति विद्यात्तस्य यत्पुरोदयात्स हिङ्कारस्तदस्य पशवोऽन्वायत्तास्तस्मात्ते हिं कुर्वन्ति हिङ्कारभाजिनो ह्येतस्य साम्नः ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "base_unit_id": "Ch_C02_S09_V02"
  },
  {
    "id": 16778023,
    "chapter_id": 6178,
    "verse_number": "2.23",
    "content_sanskrit": "अथ यत्प्रथमोदिते स प्रस्तावस्तदस्य मनुष्या अन्वायत्तास्तस्मात्ते प्रस्तुतिकामाः प्रशंसाकामाः प्रस्तावभाजिनो ह्येतस्य साम्नः ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "base_unit_id": "Ch_C02_S09_V03"
  },
  {
    "id": 16778024,
    "chapter_id": 6178,
    "verse_number": "2.24",
    "content_sanskrit": "अथ यत्सङ्गववेलायाꣳ स आदिस्तदस्य वयां स्यन्वायत्तानि तस्मात्तान्यन्तरिक्षेऽनारम्बणान्यादायात्मानं परिपतन्त्यादिभाजीनि ह्येतस्य साम्नः ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "base_unit_id": "Ch_C02_S09_V04"
  },
  {
    "id": 16778025,
    "chapter_id": 6178,
    "verse_number": "2.25",
    "content_sanskrit": "अथ यत्सम्प्रतिमध्यन्दिने स उद्गीथस्तदस्य देवा अन्वायत्तास्तस्मात्ते सत्तमाः प्राजापत्यानामुद्गीथभाजिनो ह्येतस्य साम्नः ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "base_unit_id": "Ch_C02_S09_V05"
  },
  {
    "id": 16778026,
    "chapter_id": 6178,
    "verse_number": "2.26",
    "content_sanskrit": "अथ यदूर्ध्वं मध्यन्दिनात्प्रागपराह्णात्स प्रतिहारस्तदस्य गर्भा अन्वायत्तास्तस्मात्ते प्रतिहृतानावपद्यन्ते प्रतिहारभाजिनो ह्येतस्य साम्नः ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "base_unit_id": "Ch_C02_S09_V06"
  },
  {
    "id": 16778027,
    "chapter_id": 6178,
    "verse_number": "2.27",
    "content_sanskrit": "अथ यदूर्ध्वमपराह्णात्प्रागस्तमयात्सउपद्रवस्तदस्यारण्या अन्वायत्तास्तस्मात्ते पुरुषं दृष्ट्वा कक्षꣳ श्वभ्रमित्युपद्रवन्त्युपद्रवभाजिनो ह्येतस्य साम्नः ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "base_unit_id": "Ch_C02_S09_V07"
  },
  {
    "id": 16778028,
    "chapter_id": 6178,
    "verse_number": "2.28",
    "content_sanskrit": "अथ यत्प्रथमास्तमिते तन्निधनं तदस्य पितरोऽन्वायत्तास्तस्मात्तान्निदधति निधनभाजिनो ह्येतस्य साम्न एवं खल्वमुमादित्यं सप्तविधꣳ सामोपास्ते ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "base_unit_id": "Ch_C02_S09_V08"
  },
  {
    "id": 16778029,
    "chapter_id": 6178,
    "verse_number": "2.29",
    "content_sanskrit": "अथ खल्वात्मसंमितमतिमृत्यु सप्तविधꣳ सामोपासीत हिङ्कार इति त्र्यक्षरं प्रस्ताव इति त्र्यक्षरं तत्समम् ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "base_unit_id": "Ch_C02_S10_V01"
  },
  {
    "id": 16778030,
    "chapter_id": 6178,
    "verse_number": "2.30",
    "content_sanskrit": "आदिरिति द्व्यक्षरं प्रतिहार इति चतुरक्षरं तत इहैकं तत्समम् ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "base_unit_id": "Ch_C02_S10_V02"
  },
  {
    "id": 16778031,
    "chapter_id": 6178,
    "verse_number": "2.31",
    "content_sanskrit": "उद्गीथ इति त्र्यक्षरमुपद्रव इति चतुरक्षरं त्रिभिस्त्रिभिः समं भवत्यक्षरमतिशिष्यते त्र्यक्षरं तत्समम् ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "base_unit_id": "Ch_C02_S10_V03"
  },
  {
    "id": 16778032,
    "chapter_id": 6178,
    "verse_number": "2.32",
    "content_sanskrit": "निधनमिति त्र्यक्षरं तत्सममेव भवति तानि ह वा एतानि द्वाविं शतिरक्षराणि ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "base_unit_id": "Ch_C02_S10_V04"
  },
  {
    "id": 16778033,
    "chapter_id": 6178,
    "verse_number": "2.33",
    "content_sanskrit": "एकविंशत्यादित्यमाप्नोत्येकविंशो वा इतोऽसावादित्यो द्वाविंशेन परमादित्याज्जयति तन्नाकं तद्विशोकम् ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "base_unit_id": "Ch_C02_S10_V05"
  },
  {
    "id": 16778034,
    "chapter_id": 6178,
    "verse_number": "2.34",
    "content_sanskrit": "आप्नोति हादित्यस्य जयं परो हास्यादित्यजयाज्जयो भवति य एतदेवं विद्वानात्मसंमितमतिमृत्यु सप्तविधꣳ सामोपास्ते सामोपास्ते ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "base_unit_id": "Ch_C02_S10_V06"
  },
  {
    "id": 16778035,
    "chapter_id": 6178,
    "verse_number": "2.35",
    "content_sanskrit": "मनो हिङ्कारो वाक्प्रस्तावश्चक्षुरुद्गीथः श्रोत्रं प्रतिहारः प्राणो निधनमेतद्गायत्रं प्राणेषु प्रोतम् ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "base_unit_id": "Ch_C02_S11_V01"
  },
  {
    "id": 16778036,
    "chapter_id": 6178,
    "verse_number": "2.36",
    "content_sanskrit": "स एवमेतद्गायत्रं प्राणेषु प्रोतं वेद प्राणी भवति सर्वमायुरेति ज्योग्जीवति महान्प्रजया पशुभिर्भवति महान्कीर्त्या महामनाः स्यात्तद्व्रतम् ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "base_unit_id": "Ch_C02_S11_V02"
  },
  {
    "id": 16778037,
    "chapter_id": 6178,
    "verse_number": "2.37",
    "content_sanskrit": "अभिमन्थति स हिङ्कारो धूमो जायते स प्रस्तावो ज्वलति स उद्गीथोऽङ्गारा भवन्ति स प्रतिहार उपशांयति तन्निधनं संशांयति तन्निधनमेतद्रथन्तरमग्नौ प्रोतम् ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "base_unit_id": "Ch_C02_S12_V01"
  },
  {
    "id": 16778038,
    "chapter_id": 6178,
    "verse_number": "2.38",
    "content_sanskrit": "स य एवमेतद्रथन्तरमग्नौ प्रोतं वेद ब्रह्मवर्चस्यन्नादो भवति सर्वमायुरेति ज्योग्जीवति महान्प्रजया पशुभिर्भवति महान्कीर्त्या न प्रत्यङ्ङग्निमाचामेन्न निष्ठीवेत्तद्व्रतम् ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "base_unit_id": "Ch_C02_S12_V02"
  },
  {
    "id": 16778039,
    "chapter_id": 6178,
    "verse_number": "2.39",
    "content_sanskrit": "उपमन्त्रयते स हिङ्कारो ज्ञपयते स प्रस्तावः स्त्रिया सह शेते स उद्गीथः प्रति स्त्रीं सह शेते स प्रतिहारः कालं गच्छति तन्निधनं पारं गच्छति तन्निधनमेतद्वामदेव्यं मिथुने प्रोतम् ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "base_unit_id": "Ch_C02_S13_V01"
  },
  {
    "id": 16778040,
    "chapter_id": 6178,
    "verse_number": "2.40",
    "content_sanskrit": "स य एवमेतद्वामदेव्यं मिथुने प्रोतं वेद मिथुनी भवति मिथुनान्मिथुनात्प्रजायते सर्वमायुरेति ज्योग्जीवति महान्प्रजया पशुभिर्भवति महान्कीर्त्या न काञ्चन परिहरेत्तद्व्रतम् ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "base_unit_id": "Ch_C02_S13_V02"
  },
  {
    "id": 16778041,
    "chapter_id": 6178,
    "verse_number": "2.41",
    "content_sanskrit": "उद्यन्हिङ्कार उदितः प्रस्तावो मध्यन्दिन उद्गीथोऽपराह्णः प्रतिहारोऽस्तं यन्निधनमेतद्बृहदादित्ये प्रोतम् ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "base_unit_id": "Ch_C02_S14_V01"
  },
  {
    "id": 16778042,
    "chapter_id": 6178,
    "verse_number": "2.42",
    "content_sanskrit": "स य एवमेतद्बृहदादित्ये प्रोतं वेद तेजस्व्यन्नादो भवति सर्वमायुरेति ज्योग्जीवति महान्प्रजया पशुभिर्भवति महान्कीर्त्या तपन्तं न निन्देत्तद्व्रतम् ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "base_unit_id": "Ch_C02_S14_V02"
  },
  {
    "id": 16778043,
    "chapter_id": 6178,
    "verse_number": "2.43",
    "content_sanskrit": "अभ्राणि सम्प्लवन्ते स हिङ्कारो मेघो जायते स प्रस्तावो वर्षति स उद्गीथो विद्योतते स्तनयति स प्रतिहार उद्गृह्णाति तन्निधनमेतद्वैरूपं पर्जन्ये प्रोतम् ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "base_unit_id": "Ch_C02_S15_V01"
  },
  {
    "id": 16778044,
    "chapter_id": 6178,
    "verse_number": "2.44",
    "content_sanskrit": "स य एवमेतद्वैरूपं पर्जन्ये प्रोतं वेद विरूपाꣳश्च सुरूपाꣳश्च पशूनवरुन्धे सर्वमायुरेति ज्योग्जीवति महान्प्रजया पशुभिर्भवति महान्कीर्त्या वर्षन्तं न निन्देत्तद्ब्रतम् ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "base_unit_id": "Ch_C02_S15_V02"
  },
  {
    "id": 16778045,
    "chapter_id": 6178,
    "verse_number": "2.45",
    "content_sanskrit": "वसन्तो हिङ्कारो ग्रीष्मः प्रस्तावो वर्षा उद्गीथः शरत्प्रतिहारो हेमन्तो निधनमेतद्वैराजमृतुषु प्रोतम् ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "base_unit_id": "Ch_C02_S16_V01"
  },
  {
    "id": 16778046,
    "chapter_id": 6178,
    "verse_number": "2.46",
    "content_sanskrit": "स य एवमेतद्वैराजमृतुषु प्रोतं वेद विराजति प्रजया पशुभिर्ब्रह्मवर्चसेन सर्वमायुरेति ज्योग्जीवति महान्प्रजया पशुभिर्भवति महान्कीर्त्यर्तून्न निन्देत्तद्व्रतम् ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "base_unit_id": "Ch_C02_S16_V02"
  },
  {
    "id": 16778047,
    "chapter_id": 6178,
    "verse_number": "2.47",
    "content_sanskrit": "पृथिवी हिङ्कारोऽन्तरिक्षं प्रस्तावो द्यौरुद्गीथो दिशः प्रतिहारः समुद्रो निधनमेताः शक्वर्यो लोकेषु प्रोताः ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "base_unit_id": "Ch_C02_S17_V01"
  },
  {
    "id": 16778048,
    "chapter_id": 6178,
    "verse_number": "2.48",
    "content_sanskrit": "स य एवमेताः शक्वर्यो लोकेषु प्रोता वेद लोकी भवति सर्वमायुरेति ज्योग्जीवति महान्प्रजया पशुभिर्भवति महान्कीर्त्या लोकान्न निन्देत्तद्व्रतम् ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "base_unit_id": "Ch_C02_S17_V02"
  },
  {
    "id": 16778049,
    "chapter_id": 6178,
    "verse_number": "2.49",
    "content_sanskrit": "अजा हिङ्कारोऽवयः प्रस्तावो गाव उद्गीथोऽश्वाः प्रतिहारः पुरुषो निधनमेता रेवत्यः पशुषु प्रोताः ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "base_unit_id": "Ch_C02_S18_V01"
  },
  {
    "id": 16778050,
    "chapter_id": 6178,
    "verse_number": "2.50",
    "content_sanskrit": "स य एवमेता रेवत्यः पशुषु प्रोता वेद पशुमान्भवति सर्वमायुरेति ज्योग्जीवति महान्प्रजया पशुभिर्भवति महान्कीर्त्या पशून्न निन्देत्तद्व्रतम् ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "base_unit_id": "Ch_C02_S18_V02"
  },
  {
    "id": 16778051,
    "chapter_id": 6178,
    "verse_number": "2.51",
    "content_sanskrit": "लोम हिङ्कारस्त्वक्प्रस्तावो मांसमुद्गीथोऽस्थि प्रतिहारो मज्जा निधनमेतद्यज्ञायज्ञीयमङ्गेषु प्रोतम् ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "base_unit_id": "Ch_C02_S19_V01"
  },
  {
    "id": 16778052,
    "chapter_id": 6178,
    "verse_number": "2.52",
    "content_sanskrit": "स य एवमेतद्यज्ञायज्ञीयमङ्गेषु प्रोतं वेदाङ्गी भवति नाङ्गेन विहूर्छति सर्वमायुरेति ज्योग्जीवति महान्प्रजया पशुभिर्भवति महान्कीर्त्या संवत्सरं मज्ज्ञो नाश्नीयात्तद्व्रतं मज्ज्ञो नाश्नीयादिति वा ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "base_unit_id": "Ch_C02_S19_V02"
  },
  {
    "id": 16778053,
    "chapter_id": 6178,
    "verse_number": "2.53",
    "content_sanskrit": "अग्निर्हिङ्कारो वायुः प्रस्ताव आदित्य उद्गीथो नक्षत्राणि प्रतिहारश्चन्द्रमा निधनमेतद्राजनं देवतासु प्रोतम् ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "base_unit_id": "Ch_C02_S20_V01"
  },
  {
    "id": 16778054,
    "chapter_id": 6178,
    "verse_number": "2.54",
    "content_sanskrit": "स य एवमेतद्राजनं देवतासु प्रोतं वेदैतासामेव देवतानाꣳ सलोकताꣳ सार्ष्टितांꣳसायुज्यं गच्छति सर्वमायुरेति ज्योग्जीवति महान्प्रजया पशुभिर्भवति महान्कीर्त्या ब्राह्मणान्न निन्देत्तद्व्रतम् ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "base_unit_id": "Ch_C02_S20_V02"
  },
  {
    "id": 16778055,
    "chapter_id": 6178,
    "verse_number": "2.55",
    "content_sanskrit": "त्रयी विद्या हिङ्कारस्त्रय इमे लोकाः स प्रस्तावोऽग्निर्वायुरादित्यः स उद्गीथो नक्षत्राणि वयांसि मरीचयः स प्रतिहारः सर्पा गन्धर्वाः पितरस्तन्निधनमेतत्साम सर्वस्मिन्प्रोतम् ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "base_unit_id": "Ch_C02_S21_V01"
  },
  {
    "id": 16778056,
    "chapter_id": 6178,
    "verse_number": "2.56",
    "content_sanskrit": "स य एवमेतत्साम सर्वस्मिन्प्रोतं वेद सर्वं ह भवति ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "base_unit_id": "Ch_C02_S21_V02"
  },
  {
    "id": 16778057,
    "chapter_id": 6178,
    "verse_number": "2.57",
    "content_sanskrit": "तदेष श्लोको यानि पञ्चधा त्रीणि त्रीणि तेभ्यो न ज्यायः परमन्यदस्ति ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "base_unit_id": "Ch_C02_S21_V03"
  },
  {
    "id": 16778058,
    "chapter_id": 6178,
    "verse_number": "2.58",
    "content_sanskrit": "यस्तद्वेद स वेद सर्वꣳ सर्वा दिशो बलिमस्मै हरन्ति सर्वमस्मीत्युपासीत तद्व्रतं तद्व्रतम् ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "base_unit_id": "Ch_C02_S21_V04"
  },
  {
    "id": 16778059,
    "chapter_id": 6178,
    "verse_number": "2.59",
    "content_sanskrit": "विनर्दि साम्नो वृणे पशव्यमित्यग्नेरुद्गीथोऽनिरुक्तः प्रजापतेर्निरुक्तः सोमस्य मृदु श्लक्ष्णं वायोः श्लक्ष्णं बलवदिन्द्रस्य क्रौञ्चं बृहस्पतेरपध्वान्तं वरुणस्य तान्सर्वानेवोपसेवेत वारुणं त्वेव वर्जयेत् ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "base_unit_id": "Ch_C02_S22_V01"
  },
  {
    "id": 16778060,
    "chapter_id": 6178,
    "verse_number": "2.60",
    "content_sanskrit": "अमृतत्वं देवेभ्य आगायानीत्यागायेत्स्वधां पितृभ्य आशां मनुष्येभ्यस्तृणोदकं पशुभ्यः स्वर्गं लोकं यजमानायान्नमात्मन आगायानीत्येतानि मनसा ध्यायन्नप्रमत्तः स्तुवीत ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "base_unit_id": "Ch_C02_S22_V02"
  },
  {
    "id": 16778061,
    "chapter_id": 6178,
    "verse_number": "2.61",
    "content_sanskrit": "सर्वे स्वरा इन्द्रस्यात्मानः सर्व ऊष्माणः प्रजापतेरात्मानः सर्वे स्पर्शा मृत्योरात्मानस्तं यदि स्वरेषूपालभेतेन्द्रं शरणं प्रपन्नोऽभूवं स त्वा प्रति वक्ष्यतीत्येनं ब्रूयात् ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
