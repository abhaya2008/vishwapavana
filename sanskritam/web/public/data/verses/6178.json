  {
    "id": 16778062,
    "chapter_id": 6178,
    "verse_number": "2.62",
    "content_sanskrit": "अथ यद्येनमूष्मसूपालभेत प्रजापतिं शरणं प्रपन्नोऽभूवं स त्वा प्रति पेक्ष्यतीत्येनं ब्रूयादथ यद्येनं स्पर्शेषूपालभेत मृत्युं शरणं प्रपन्नोऽभूवं स त्वा प्रति धक्ष्यतीत्येनं ब्रूयात् ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "base_unit_id": "Ch_C02_S22_V04"
  },
  {
    "id": 16778063,
    "chapter_id": 6178,
    "verse_number": "2.63",
    "content_sanskrit": "सर्वे स्वरा घोषवन्तो बलवन्तो वक्तव्या इन्द्रे बलं ददानीति सर्व ऊष्माणोऽग्रस्ता अनिरस्ता विवृता वक्तव्याः प्रजापतेरात्मानं परिददानीति सर्वे स्पर्शालेशेनानभिनिहिता वक्तव्या मृत्योरात्मानं परिहराणीति ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "base_unit_id": "Ch_C02_S22_V05"
  },
  {
    "id": 16778064,
    "chapter_id": 6178,
    "verse_number": "2.64",
    "content_sanskrit": "त्रयो धर्मस्कन्धा यज्ञोऽध्ययनं दानमिति प्रथमस्तप एव द्वितीयो ब्रह्मचार्याचार्यकुलवासी तृतीयोऽत्यन्तमात्मानमाचार्यकुलेऽवसादयन्सर्व एते पुण्यलोका भवन्ति ब्रह्मसंस्थोऽमृतत्वमेति ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "base_unit_id": "Ch_C02_S23_V01"
  },
  {
    "id": 16778065,
    "chapter_id": 6178,
    "verse_number": "2.65",
    "content_sanskrit": "प्रजापतिर्लोकानभ्यतपत्तेभ्योऽभितप्तेभ्यस्त्रयी विद्या सम्प्रास्रवत्तामभ्यतपत्तस्या अभितप्ताया एतान्यक्षराणि सम्प्रास्रवन्त भूर्भुवः स्वरिति ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "base_unit_id": "Ch_C02_S23_V02"
  },
  {
    "id": 16778066,
    "chapter_id": 6178,
    "verse_number": "2.66",
    "content_sanskrit": "तान्यभ्यतपत्तेभ्योऽभितप्तेभ्य ओङ्कारः सम्प्रास्रवत्तद्यथा शङ्कुना सर्वाणि पर्णानि सन्तृण्णान्येवमोङ्कारेण सर्वा वाक्सन्तृण्णोङ्कार एवेदं सर्वमोङ्कार एवेदं सर्वम् ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "base_unit_id": "Ch_C02_S23_V03"
  },
  {
    "id": 16778067,
    "chapter_id": 6178,
    "verse_number": "2.67",
    "content_sanskrit": "ब्रह्मवादिनो वदन्ति यद्वसूनां प्रातः सवनꣳ रुद्राणां माध्यन्दिनꣳ सवनमादित्यानां च विश्वेषां च देवानां तृतीयसवनम् ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "base_unit_id": "Ch_C02_S24_V01"
  },
  {
    "id": 16778068,
    "chapter_id": 6178,
    "verse_number": "2.68",
    "content_sanskrit": "क्व तर्हि यजमानस्य लोक इति स यस्तं न विद्यात्कथं कुर्यादथ विद्वान्कुर्यात् ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "base_unit_id": "Ch_C02_S24_V02"
  },
  {
    "id": 16778069,
    "chapter_id": 6178,
    "verse_number": "2.69",
    "content_sanskrit": "पुरा प्रातरनुवाकस्योपाकरणाज्जघनेन गार्हपत्यस्योदङ्मुख उपविश्य स वासवं सामाभिगायति ॥ ३ ॥",
