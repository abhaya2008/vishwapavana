[{"id": 2077942, "chapter_id": 2653, "verse_number": "१२-१५८-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2077943, "chapter_id": 2653, "verse_number": "१२-१५८-१", "content_sanskrit": "स्वाध्यायकृतयत्नस्य ब्राह्मणस्य विशेषतः।\nधर्मकामस्य धर्मात्मन्किंनु श्रेय इहोच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2077944, "chapter_id": 2653, "verse_number": "१२-१५८-२", "content_sanskrit": "बहुधा दर्शने लोके श्रेयो यदिह मन्यसे।\nअस्मिँल्लोके परे चैव तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2077945, "chapter_id": 2653, "verse_number": "१२-१५८-३", "content_sanskrit": "महानयं धर्मपथो बहुशाखश्च भारत।\nकिंस्विदेवेह धर्माणामनुष्ठेयतमं मतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2077946, "chapter_id": 2653, "verse_number": "१२-१५८-४", "content_sanskrit": "धर्मस्य महतो राजन्बहुशाखस्य तत्त्वतः।\nयन्मूलं परमं तात तत्सर्वं ब्रूह्यतन्द्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2077947, "chapter_id": 2653, "verse_number": "१२-१५८-५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2077948, "chapter_id": 2653, "verse_number": "१२-१५८-५", "content_sanskrit": "हन्त ते कथयिष्यामि येन श्रेयो ह्यवाप्स्यसि।\nपीत्वाऽमृतमिव प्राज्ञो येन तृप्तो भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2077949, "chapter_id": 2653, "verse_number": "१२-१५८-६", "content_sanskrit": "धर्मस्य विधयो नैके तेते प्रोक्ता महर्षिभिः।\nस्वंस्वं विज्ञानमाश्रित्य दमस्तेषां परायणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2077950, "chapter_id": 2653, "verse_number": "१२-१५८-७", "content_sanskrit": "दमं निःश्रेयसं प्राहुर्वृद्धा निश्चितदर्शिनः।\nब्राह्मणस्य विशेषेण दमो धर्मः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2077951, "chapter_id": 2653, "verse_number": "१२-१५८-८", "content_sanskrit": "नादान्तस्य क्रियासिद्धिर्यथावदुपलभ्यते।\nदमो दानं तथा यज्ञानधीतं चातिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2077952, "chapter_id": 2653, "verse_number": "१२-१५८-९", "content_sanskrit": "दमस्तेजो वर्धयति पवित्रं च दमः परम्।\nविपाप्मा तेजसा युक्तः पुरुषो विन्दते महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2077953, "chapter_id": 2653, "verse_number": "१२-१५८-१०", "content_sanskrit": "दमेन सदृशं धर्मं नान्यं लोकेषु शुश्रुम्।\nदमो हि परमो लोके प्रशस्तः सर्वधर्मिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2077954, "chapter_id": 2653, "verse_number": "१२-१५८-११", "content_sanskrit": "प्रेत्य चात्र मनुष्येन्द्र परमं विन्दते सुखम्।\nदमेन हि सदा युक्तो महान्तं धर्ममश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2077955, "chapter_id": 2653, "verse_number": "१२-१५८-१२", "content_sanskrit": "सुखं दान्तः प्रस्वपिति सुखं च प्रतिबुध्यते।\nसुखं पर्येति लोकांश्च मनश्चास्य प्रसीदति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2077956, "chapter_id": 2653, "verse_number": "१२-१५८-१३", "content_sanskrit": "अदान्तः पुरुषः क्लेशमभीक्ष्णं प्रतिपद्यते।\nअनर्थांश्च बहूनन्यान्प्रसृजत्यात्मदोषजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2077957, "chapter_id": 2653, "verse_number": "१२-१५८-१४", "content_sanskrit": "आश्रमेषु चतुर्ष्वाहुर्दममेवोत्तमं व्रतम्।\nदमलिङ्गानि वक्ष्यामि येषां समुदयो दमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2077958, "chapter_id": 2653, "verse_number": "१२-१५८-१५", "content_sanskrit": "क्षमा धृतिरार्हेसा च समता सत्यमार्जवम्।\nइन्द्रियाभिजयो दाक्ष्यं मार्दवं ह्रीरचापलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2077959, "chapter_id": 2653, "verse_number": "१२-१५८-१६", "content_sanskrit": "अकार्पण्यमसंरम्भः संतोषः प्रियवादिता।\nअविहसाऽनसूया चाप्येषां समुदयो दमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2077960, "chapter_id": 2653, "verse_number": "१२-१५८-१७", "content_sanskrit": "गुरुपूजा च कौरव्य दया भूतेष्वपैशुनम्।\nजनवादमृषावादस्तुतिनिन्दाविसर्जनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2077961, "chapter_id": 2653, "verse_number": "१२-१५८-१८", "content_sanskrit": "कामं क्राधं च लोभं च दर्पं स्तम्भं विकत्थनम्।\nरोषमीर्ष्यावमानं च नैव दान्तो निषेवते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2077962, "chapter_id": 2653, "verse_number": "१२-१५८-१९", "content_sanskrit": "अनिन्दितो ह्यकामात्मा नाल्पेष्वर्थ्यनसूयकः।\nसमुद्रकल्पः स नरो न कथंचन पूर्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2077963, "chapter_id": 2653, "verse_number": "१२-१५८-२०", "content_sanskrit": "अहं त्वयि मम त्वं च मयि ते तेषु चाप्यहम्।\nपूर्वसंबन्धिसंयोगं नैतद्दान्तो निषेवते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2077964, "chapter_id": 2653, "verse_number": "१२-१५८-२१", "content_sanskrit": "सर्वा ग्राम्यास्तथाऽऽरण्या याश्च लोके प्रवृत्तयः।\nनिन्दां चैव प्रशंसां च यो नाश्रयति मुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2077965, "chapter_id": 2653, "verse_number": "१२-१५८-२२", "content_sanskrit": "मैत्रोऽथ शीलसंपन्नः प्रसन्नात्मात्मविच्च यः।\nमुक्तस्य विविधैः सङ्गैस्तस्य प्रेत्य फलं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2077966, "chapter_id": 2653, "verse_number": "१२-१५८-२३", "content_sanskrit": "सुवृत्तः शीलसंपन्नः प्रसन्नात्माऽऽत्मविद्वुधः।\nप्राप्येह लोके सत्कारं सुगतिं प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2077967, "chapter_id": 2653, "verse_number": "१२-१५८-२४", "content_sanskrit": "कर्म यच्छुभमेवेह सद्भिराचरितं च यत्।\nतदेव ज्ञानयुक्तस्य मुनेर्वर्त्म न हीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2077968, "chapter_id": 2653, "verse_number": "१२-१५८-२५", "content_sanskrit": "निष्क्रम्य वनमास्थाय ज्ञानयुक्तो जितेन्द्रियः।\nकालाकाङ्गी चरन्नेवं ब्रह्मभूयाय कल्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2077969, "chapter_id": 2653, "verse_number": "१२-१५८-२६", "content_sanskrit": "अभयं यस्य भूतेभ्यो भूतानामभयं यतः।\nतस्य देहाद्विमुक्तस्य भयं नास्ति कुतश्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2077970, "chapter_id": 2653, "verse_number": "१२-१५८-२७", "content_sanskrit": "अवाचिनोति कर्माणि न च संप्रचिनोति ह।\nसमः सर्वेषु भूतेषु मैत्रायणगतिं चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2077971, "chapter_id": 2653, "verse_number": "१२-१५८-२८", "content_sanskrit": "शकुनीनामिवाकाशे मत्स्यानांमिव चोदके।\nयथा गतिर्न दृश्येत तथा तस्य स संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2077972, "chapter_id": 2653, "verse_number": "१२-१५८-२९", "content_sanskrit": "गृहानुत्सृज्य यो राज्मोक्षमेवाभिपद्यते।\nलोकास्तेजोमयास्तस्य कल्पन्ते शाश्वतीः समाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2077973, "chapter_id": 2653, "verse_number": "१२-१५८-३०", "content_sanskrit": "संन्यस्य सर्वकर्माणि संन्यस्य विधिवत्तपः।\nसंन्यस्य विविधा विद्याः सर्वं संन्यस्य चैव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2077974, "chapter_id": 2653, "verse_number": "१२-१५८-३१", "content_sanskrit": "कामे शुचिरनावृत्तः प्रसन्नात्माऽऽत्मविच्छुचिः।\nप्राप्येह लोके सत्कारं स्वर्गं समभिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2077975, "chapter_id": 2653, "verse_number": "१२-१५८-३२", "content_sanskrit": "यच्च पैतामहं स्थानं ब्रह्मराशिसमुद्भवम्।\nगुहायां निहितं नित्यं तद्दमेनाभिगम्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2077976, "chapter_id": 2653, "verse_number": "१२-१५८-३३", "content_sanskrit": "ज्ञानारामस्य बुद्धस्य सर्वभूतानुरोधिनः।\nनावृत्तिभयमस्तीह परलोकभयं कुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2077977, "chapter_id": 2653, "verse_number": "१२-१५८-३४", "content_sanskrit": "एक एव दमे दोषो द्वितीयो नोपपद्यते।\nयदेनं दमसंयुक्तमशक्तं मन्यते जनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2077978, "chapter_id": 2653, "verse_number": "१२-१५८-३५", "content_sanskrit": "एकोऽस्य सुमहाप्राज्ञ दोषः स्यात्सुमहान्गुणः।\nक्षमया विपुला लोका दुर्लभा हि सहिष्णुता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2077979, "chapter_id": 2653, "verse_number": "१२-१५८-३६", "content_sanskrit": "दान्तस्य किमरण्येन तथाऽदान्तस्य भारत।\nयत्रैव निवसेद्दान्तस्तदरण्यं स चाश्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2077980, "chapter_id": 2653, "verse_number": "१२-१५८-३७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2077981, "chapter_id": 2653, "verse_number": "१२-१५८-३७", "content_sanskrit": "एतद्भीष्मस्य वचनं श्रुत्वा राजा युधिष्ठिरः।\nअमृतेनेव संतृप्तः प्रहृष्टः समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2077982, "chapter_id": 2653, "verse_number": "१२-१५८-३८", "content_sanskrit": "पुनश्च परिपप्रच्छ भीष्मं धर्मभृतां वरम्।\nततः प्रीतः स चोवाच तस्मै सर्वं कुरूद्वहः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2077983, "chapter_id": 2653, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि अष्टपञ्चाशदधिकशततमोऽध्यायः॥ १५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]