[{"id": 6000266000, "chapter_id": 10266, "verse_number": null, "content_sanskrit": "अथ सप्ततितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000266001, "chapter_id": 10266, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.001.m4a", "display_order": 2}, {"id": 6000266002, "chapter_id": 10266, "verse_number": "१०-७०-१", "content_sanskrit": "अथैकदा द्वारवत्यां वसतो रामकृष्णयोः।\nसूर्योपरागः सुमहानासीत् कल्पक्षये यथा॥ १०/७०/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.002.m4a", "display_order": 3, "topics": [{"text": "सपरिवारः कृष्णः ग्रहणनिमित्तं कुरुक्षेत्रमगात्", "range": "१–९"}]}, {"id": 6000266003, "chapter_id": 10266, "verse_number": "१०-७०-२", "content_sanskrit": "तं ज्ञात्वा मनुजा राजन् पुरस्तादेव सर्वशः।\nस्यमन्तपञ्चकं क्षेत्रं जग्मुः श्रेयोविधित्सया॥ १०/७०/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.003.m4a", "display_order": 4}, {"id": 6000266004, "chapter_id": 10266, "verse_number": "१०-७०-३", "content_sanskrit": "निःक्षत्रियां महीं कुर्वन् रामः शस्‍त्रभृतां वरः।\nनृपाणां रुधिरौघेण यत्र चक्रे महाह्रदान्॥ १०/७०/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.004.m4a", "display_order": 5}, {"id": 6000266005, "chapter_id": 10266, "verse_number": "१०-७०-४", "content_sanskrit": "ईजे च भगवान् रामो यत्रास्पृष्टोऽपि कर्मणा।\nलोकस्य सङ्ग्रहायेशो यथाऽन्योऽघापनुत्तये॥ १०/७०/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.005.m4a", "display_order": 6}, {"id": 6000266006, "chapter_id": 10266, "verse_number": "१०-७०-५", "content_sanskrit": "महत्यां तीर्थयात्रायां तत्रागुर्भारतीः प्रजाः।\nकृष्णः षोडशसाहस्रमहिषीशिबिकान्वितः॥ १०/७०/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.006.m4a", "display_order": 7}, {"id": 6000266007, "chapter_id": 10266, "verse_number": "१०-७०-६", "content_sanskrit": "पुत्रपौत्रजनानीकैर्वारकान्ताकरेणुभिः।\nनगरस्‍त्रीकदम्बैश्च प्रियसार्थैश्च संयुतः॥ १०/७०/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.007.m4a", "display_order": 8}, {"id": 6000266008, "chapter_id": 10266, "verse_number": "१०-७०-७", "content_sanskrit": "वृष्णयश्च तथाऽक्रूरवसुदेवगदादयः।\nययुर्भारत तत्क्षेत्रं स्वमघं क्षपयिष्णवः॥ १०/७०/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.008.m4a", "display_order": 9}, {"id": 6000266009, "chapter_id": 10266, "verse_number": "१०-७०-८", "content_sanskrit": "शठप्रद्युम्नसाम्बाश्च सुवज्रोद्धवसारणाः।\nआहुकं कृतवर्माणं संस्थाप्य पुररक्षणे॥ १०/७०/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.009.m4a", "display_order": 10}, {"id": 6000266010, "chapter_id": 10266, "verse_number": "१०-७०-९", "content_sanskrit": "ते रथैर्देवविख्यातैर्हयैश्च तरलप्रभैः।\nगजैर्बृहद्भिरभ्राभैर्नृभिर्विद्याधरद्युभिः॥ १०/७०/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.010.m4a", "display_order": 11}, {"id": 6000266011, "chapter_id": 10266, "verse_number": "१०-७०-१०", "content_sanskrit": "व्यरोचन्त महाभागाः पथि काञ्चनमालिनः।\nवेदवादित्रनिर्घोषैः शङ्खदुन्दुभिनिस्स्वनैः॥ १०/७०/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.011.m4a", "display_order": 12}, {"id": 6000266012, "chapter_id": 10266, "verse_number": "१०-७०-११", "content_sanskrit": "गायन्तः कृष्ण कृष्णेति गोविन्देति च सन्ततम्।\nककुभः पूरयन् नादैर्जग्मुः सर्वे कुरूद्वह॥ १०/७०/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.012.m4a", "display_order": 13}, {"id": 6000266013, "chapter_id": 10266, "verse_number": "१०-७०-१२", "content_sanskrit": "समन्तपञ्चकं प्राप्य क्षेत्रं त्रैलोक्यविश्रुतम्।\nतृणैः पर्णैस्तथा काष्ठैश्चक्रिरे भवनानि च॥ १०/७०/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.013.m4a", "display_order": 14}, {"id": 6000266014, "chapter_id": 10266, "verse_number": "१०-७०-१३", "content_sanskrit": "कम्बलाजिनवस्‍त्राणां शिबिराणि महीभृताम्।\nआसन् विचित्ररूपाणि शतशोऽथ सहस्रशः॥ १०/७०/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.014.m4a", "display_order": 15}, {"id": 6000266015, "chapter_id": 10266, "verse_number": "१०-७०-१४", "content_sanskrit": "तत्राजग्मुर्नृपानेके ब्राह्मणाश्च सहस्रशः।\nवैश्याः शूद्राश्च निःसङ्ख्या ये चान्ये वर्णनिन्दिताः॥ १०/७०/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.015.m4a", "display_order": 16}, {"id": 6000266016, "chapter_id": 10266, "verse_number": "१०-७०-१५", "content_sanskrit": "ऋषयश्च महात्मानो विख्याताः संशितव्रताः।\nसोपाध्यायाः साग्निहोत्राः स्नातका गृहमेधिनः॥ १०/७०/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.016.m4a", "display_order": 17}, {"id": 6000266017, "chapter_id": 10266, "verse_number": "१०-७०-१६", "content_sanskrit": "अन्धाश्च बधिराश्चैव कुब्जवामनपण्डकाः।\nव्यङ्गा जडाश्च मूकाश्च कर्मक्षयमभीप्सवः॥ १०/७०/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.017.m4a", "display_order": 18}, {"id": 6000266018, "chapter_id": 10266, "verse_number": "१०-७०-१७", "content_sanskrit": "गोविन्दचरणाम्भोजरेणुरञ्जितमस्तकाः।\nकटकाङ्गदकेयूरहारकुण्डलभूषणाः॥ १०/७०/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.018.m4a", "display_order": 19}, {"id": 6000266019, "chapter_id": 10266, "verse_number": "१०-७०-१८", "content_sanskrit": "स्रग्गन्धदिव्यवसनाः कलत्रैः खेचरा इव।\nतत्र स्नात्वा महाभागा उपोष्य सुसमाहिताः॥ १०/७०/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.019.m4a", "display_order": 20, "topics": [{"text": "यादवैः ब्राह्मणेभ्यः गवादिदानम्", "range": "१८–२१"}]}, {"id": 6000266020, "chapter_id": 10266, "verse_number": "१०-७०-१९", "content_sanskrit": "ब्राह्मणेभ्यो ददुर्धेनूर्वासःस्रग्रुग्ममालिनीः।\nरामह्रदेषु विधिवत् पुनराप्लुत्य वृष्णयः॥ १०/७०/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.020.m4a", "display_order": 21}, {"id": 6000266021, "chapter_id": 10266, "verse_number": "१०-७०-२०", "content_sanskrit": "ददुः स्वन्नं द्विजाग्र्येभ्यः कृष्णे नो भक्तिरस्त्विति।\nस्वयं च तदनुज्ञाता वृष्णयः कृष्णदेवताः॥ १०/७०/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.021.m4a", "display_order": 22}, {"id": 6000266022, "chapter_id": 10266, "verse_number": "१०-७०-२१", "content_sanskrit": "भुक्त्वोपविविशुः कामं स्निग्धच्छायाङ्घ्रिपाङ्घ्रिषु।\nतत्रागतांस्ते ददृशुः सुहृत्सम्बन्धिनो नृपान्॥ १०/७०/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.022.m4a", "display_order": 23}, {"id": 6000266023, "chapter_id": 10266, "verse_number": "१०-७०-२२", "content_sanskrit": "मत्स्योशीनरकौसल्यविदर्भकुरुसृञ्जयान्।\nकाम्बोजकेकयान् मद्रान् कुन्तिगान्धारकेरलान्॥ १०/७०/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.023.m4a", "display_order": 24, "topics": [{"text": "बान्धवानां मिथः सम्मानादिकम्", "range": "२२–४८"}]}, {"id": 6000266024, "chapter_id": 10266, "verse_number": "१०-७०-२३", "content_sanskrit": "अन्यांश्चैवात्मपक्षीयान् परांश्च शतशो नृपान्।\nनन्दादीन् सुहृदो गोपान् गोपीश्चोत्कण्ठिताश्चिरम्॥ १०/७०/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.024.m4a", "display_order": 25}, {"id": 6000266025, "chapter_id": 10266, "verse_number": "१०-७०-२४", "content_sanskrit": "अन्योन्यसन्दर्शनहर्षरंहसा प्रोत्फुल्लहृद्वक्त्रसरोरुहश्रियः।\nआश्लिष्य गाढं नयनैः स्रवज्जला हृष्यत्त्वचो रुद्धगिरो ययुर्मुदम्॥ १०/७०/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.025.m4a", "display_order": 26}, {"id": 6000266026, "chapter_id": 10266, "verse_number": "१०-७०-२५", "content_sanskrit": "स्‍त्रियश्च संवीक्ष्य मिथोऽतिसौहृदाः सचापलापाङ्गदृशोऽभिरेभिरे।\nस्तनैः स्तनान् कुङ्कुमपङ्करूषितान् निहत्य दोर्भ्यां प्रणयाश्रुलोचनाः॥ १०/७०/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.026.m4a", "display_order": 27}, {"id": 6000266027, "chapter_id": 10266, "verse_number": "१०-७०-२६", "content_sanskrit": "ततोऽभिवाद्य ते वृद्धान् यवीयैरभिवादिताः।\nस्वागतं कुशलं पृष्ट्वा चक्रुः कृष्णकथां मिथः॥ १०/७०/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.027.m4a", "display_order": 28}, {"id": 6000266028, "chapter_id": 10266, "verse_number": "१०-७०-२७", "content_sanskrit": "पृथा भ्रातॄॄन् स्वसॄॄर्वीक्ष्य तत्पुत्रान् पितरावपि।\nभ्रातृपत्नीर्मुकुन्दं च जहौ सङ्कथया शुचः॥ १०/७०/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.028.m4a", "display_order": 29}, {"id": 6000266029, "chapter_id": 10266, "verse_number": null, "content_sanskrit": "कुन्त्युवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.029.m4a", "display_order": 30}, {"id": 6000266030, "chapter_id": 10266, "verse_number": "१०-७०-२८", "content_sanskrit": "आर्य भ्रातरहं मन्ये आत्मानमकृताशिषम्।\nयत आपत्सु मद्वार्तां नानुस्मरथ सत्तमाः॥ १०/७०/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.030.m4a", "display_order": 31}, {"id": 6000266031, "chapter_id": 10266, "verse_number": "१०-७०-२९", "content_sanskrit": "सुहृदो ज्ञातयः पुत्रा भ्रातरः पितरावपि।\nनानुस्मरन्ति स्वजनं यस्य दैवमदक्षिणम्॥ १०/७०/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.031.m4a", "display_order": 32}, {"id": 6000266032, "chapter_id": 10266, "verse_number": null, "content_sanskrit": "वसुदेव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.032.m4a", "display_order": 33}, {"id": 6000266033, "chapter_id": 10266, "verse_number": "१०-७०-३०", "content_sanskrit": "अम्ब मास्मानसूयेथा देवक्रीडनकान् नरान्।\nईशस्य हि वशे लोकः कुरुते कार्यतेऽथवा॥ १०/७०/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.033.m4a", "display_order": 34}, {"id": 6000266034, "chapter_id": 10266, "verse_number": "१०-७०-३१", "content_sanskrit": "कंसप्रतापिताः सर्वे वयं याता दिशो दश।\nएतर्ह्येव पुनः स्थानं दैवेनासादिताः स्वसः॥ १०/७०/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.034.m4a", "display_order": 35}, {"id": 6000266035, "chapter_id": 10266, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.035.m4a", "display_order": 36}, {"id": 6000266036, "chapter_id": 10266, "verse_number": "१०-७०-३२", "content_sanskrit": "वसुदेवोग्रसेनाद्यैर्यदुभिः सेविता नृपाः।\nआसन्नच्युतसन्दर्शपरमानन्दनिर्वृताः॥ १०/७०/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.036.m4a", "display_order": 37}, {"id": 6000266037, "chapter_id": 10266, "verse_number": "१०-७०-३३", "content_sanskrit": "भीष्मो द्रोणोऽम्बिकापुत्रो गान्धारी ससुता तथा।\nसदाराः पाण्डवाः कुन्ती सञ्जयो विदुरः कृपः॥ १०/७०/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.037.m4a", "display_order": 38}, {"id": 6000266038, "chapter_id": 10266, "verse_number": "१०-७०-३४", "content_sanskrit": "कुन्तिभोजो विराटश्च भीष्मको नग्नजिन्महान्।\nपुरुजिद् द्रुपदः शैब्यो धृष्टकेतुश्च काशिराट्॥ १०/७०/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.038.m4a", "display_order": 39}, {"id": 6000266039, "chapter_id": 10266, "verse_number": "१०-७०-३५", "content_sanskrit": "दमघोषो विशालाक्षो मैथिलो मद्रकैकयाः।\nयुधामन्युः सुशर्मा च ससुता बाह्लिकादयः॥ १०/७०/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.039.m4a", "display_order": 40}, {"id": 6000266040, "chapter_id": 10266, "verse_number": "१०-७०-३६", "content_sanskrit": "राजानोऽन्ये च राजेन्द्र युधिष्ठिरमनुव्रताः।\nश्रीनिकेतं वपुः शौरेः सस्‍त्रीका वीक्ष्य विस्मिताः॥ १०/७०/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.040.m4a", "display_order": 41}, {"id": 6000266041, "chapter_id": 10266, "verse_number": "१०-७०-३७", "content_sanskrit": "अथ ते रामकृष्णाभ्यां सम्यक्प्राप्तसमर्हणाः।\nप्रशशंसुर्मुदा युक्तास्तुष्टाः कृष्णपरिग्रहान्॥ १०/७०/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.041.m4a", "display_order": 42}, {"id": 6000266042, "chapter_id": 10266, "verse_number": "१०-७०-३८", "content_sanskrit": "अहो भोजपते यूयं जन्मभाजो नृणामिह।\nयत् पश्यथासकृत् कृष्णं दुर्दर्शमपि योगिनाम्॥ १०/७०/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.042.m4a", "display_order": 43}, {"id": 6000266043, "chapter_id": 10266, "verse_number": "१०-७०-३९", "content_sanskrit": "यन्निःसृतं जगदिदं सकलं पुनाति पादावनेजनपयस्तु वचश्च शास्‍त्रम्।\nभूः कालभर्जितभगाऽपि यदङ्घ्रिपद्मस्पर्शेद्धशक्तिरभिवर्षति नोऽखिलार्थान्॥ १०/७०/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.043.m4a", "display_order": 44}, {"id": 6000266044, "chapter_id": 10266, "verse_number": "१०-७०-४०", "content_sanskrit": "तद्दर्शनस्पर्शनानुपथप्रजल्पशय्यासनाशनसयौवनपिण्डबन्धाः।\nयेषां गृहे निरयवर्त्मनि वर्ततां च स्वर्गापवर्गविरमः स्वयमास विष्णुः॥ १०/७०/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.044.m4a", "display_order": 45}, {"id": 6000266045, "chapter_id": 10266, "verse_number": "१०-७०-४१", "content_sanskrit": "नन्दस्तत्र यदून् प्राप्तान् श्रुत्वा कृष्णपुरोगमान्।\nतत्रागमद् वृतो गोपैस्तरसा तद्दिदृक्षया॥ १०/७०/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.045.m4a", "display_order": 46}, {"id": 6000266046, "chapter_id": 10266, "verse_number": "१०-७०-४२", "content_sanskrit": "तं दृष्ट्वा वृष्णयो हृष्टास्तन्वः प्राणमिवोत्थिताः।\nपरिषस्वजिरे गाढं चिरदर्शनकातराः॥ १०/७०/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.046.m4a", "display_order": 47}, {"id": 6000266047, "chapter_id": 10266, "verse_number": "१०-७०-४३", "content_sanskrit": "वसुदेवः परिष्वज्य सम्प्रीतः प्रेमविह्वलः।\nस्मरन् कंसकृतान् क्लेशान् पुत्रन्यासं च गोकुले॥ १०/७०/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.047.m4a", "display_order": 48}, {"id": 6000266048, "chapter_id": 10266, "verse_number": "१०-७०-४४", "content_sanskrit": "कृष्णरामौ परिष्वज्य पितरावभिवाद्य च।\nन किञ्चनोचतुः प्रेम्णा साश्रुकण्ठौ कुरूद्वह॥ १०/७०/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.048.m4a", "display_order": 49}, {"id": 6000266049, "chapter_id": 10266, "verse_number": "१०-७०-४५", "content_sanskrit": "तावुत्सङ्गं समारोप्य बाहुभ्यां परिरभ्य च।\nयशोदा च महाभागा सुतौ विजहतुः शुचः॥ १०/७०/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.049.m4a", "display_order": 50}, {"id": 6000266050, "chapter_id": 10266, "verse_number": "१०-७०-४६", "content_sanskrit": "रोहिणी देवकी चैव परिष्वज्य व्रजेश्वरीम्।\nस्मरन्त्यौ तत्कृतां मैत्रीं बाष्पकण्ठे समूचतुः॥ १०/७०/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.050.m4a", "display_order": 51}, {"id": 6000266051, "chapter_id": 10266, "verse_number": "१०-७०-४७", "content_sanskrit": "को विस्मरेत वां मैत्रीमनुवृत्तां व्रजेश्वरि।\nअप्यवाप्यैन्द्रमैश्वर्यं यस्या नेह प्रतिक्रिया॥ १०/७०/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.051.m4a", "display_order": 52}, {"id": 6000266052, "chapter_id": 10266, "verse_number": "१०-७०-४८", "content_sanskrit": "एतावदृष्टपितरौ युवयोः स्म पित्रोः सम्प्रीणनाभ्युदयपोषणपालनानि।\nप्राप्योषतुर्भवति पक्ष्म ह यद्वदक्ष्णोर्न्यस्तावकुत्रचभयौ न सतां परस्तात्॥ १०/७०/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.052.m4a", "display_order": 53}, {"id": 6000266053, "chapter_id": 10266, "verse_number": "१०-७०-४९", "content_sanskrit": "गोप्यश्च कृष्णमुपलभ्य चिरादभीष्टं यत्प्रेक्षणे दृशिषु पक्ष्मकृतं शपन्ति।\nदृग्भिर्हृदीकृतमलं परिरभ्य सद्यस्तद्भावमापुरपि नित्ययुजां दुरापम्॥ १०/७०/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.053.m4a", "display_order": 54}, {"id": 6000266054, "chapter_id": 10266, "verse_number": "१०-७०-५०", "content_sanskrit": "भगवांस्तास्तथाभूता विविक्त उपसङ्गताः।\nआश्लिष्यानामयं पृष्ट्वा प्रहसन्निदमब्रवीत्॥ १०/७०/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.054.m4a", "display_order": 55}, {"id": 6000266055, "chapter_id": 10266, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.055.m4a", "display_order": 56}, {"id": 6000266056, "chapter_id": 10266, "verse_number": "१०-७०-५१", "content_sanskrit": "अपि स्मरथ नः सख्यः स्वानामर्थचिकीर्षवः।\nगतांश्चिरायितानन्यासङ्गात् कृपणचेतसः॥ १०/७०/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.056.m4a", "display_order": 57, "topics": [{"text": "गोपस्‍त्रीणां कृष्णोपदेशः", "range": "५१–५६"}]}, {"id": 6000266057, "chapter_id": 10266, "verse_number": "१०-७०-५२", "content_sanskrit": "अवबुद्ध्य यथाऽस्मासु इदमेव विशङ्कये।\nनूनं भूतानि भगवान् युनक्ति वियुनक्ति च॥ १०/७०/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.057.m4a", "display_order": 58}, {"id": 6000266058, "chapter_id": 10266, "verse_number": "१०-७०-५३", "content_sanskrit": "वायुर्यथा घनानीकं तृणतूलरजांसि च।\nसंयोज्य क्षिपते भूयस्तथा भूतानि भूतकृत्॥ १०/७०/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.058.m4a", "display_order": 59}, {"id": 6000266059, "chapter_id": 10266, "verse_number": "१०-७०-५४", "content_sanskrit": "मयि भक्तिर्हि भूतानाममृतत्वाय कल्पते।\nदिष्ट्याऽऽसीन्मयि सुस्नेहो भवतीनां मुदावहः॥ १०/७०/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.059.m4a", "display_order": 60}, {"id": 6000266060, "chapter_id": 10266, "verse_number": "१०-७०-५५", "content_sanskrit": "अहं हि सर्वभूतानामादिरन्तोऽन्तरं बहिः।\nभौतिकानां यथा स्वं वा भूर्वायुर्ज्योतिरङ्गनाः॥ १०/७०/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.060.m4a", "display_order": 61}, {"id": 6000266061, "chapter_id": 10266, "verse_number": "१०-७०-५६", "content_sanskrit": "एवमेतानि भूतानि भूतेष्वात्माऽऽत्मना ततः।\nउभयं मय्यथ परे पश्यताथ तमक्षरे॥ १०/७०/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.061.m4a", "display_order": 62}, {"id": 6000266062, "chapter_id": 10266, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.062.m4a", "display_order": 63}, {"id": 6000266063, "chapter_id": 10266, "verse_number": "१०-७०-५७", "content_sanskrit": "अध्यात्मशिक्षया गोप्य एवं कृष्णेन शिक्षिताः।\nतदनुस्मरणध्वस्तजीवकोशास्तमध्यगुः॥ १०/७०/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.063.m4a", "display_order": 64}, {"id": 6000266064, "chapter_id": 10266, "verse_number": "१०-७०-५८", "content_sanskrit": "नताः स्म ते नाथ पदारविन्दं योगेश्वरैर्हृदि विचिन्त्यमगाधबोधैः।\nसंसारकूपपतितोत्तरणावलम्बं गेहंजुषामपि मनस्युदियात् सदा नः॥ १०/७०/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_070/BhP_10.070.064.m4a", "display_order": 65}, {"id": 6000266065, "chapter_id": 10266, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे सप्ततितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]