[{"id": 5000084000, "chapter_id": 9084, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे सप्तमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000084001, "chapter_id": 9084, "verse_number": "२-७-१", "content_sanskrit": "ज्ञातिदासी यतो जाता कैकेय्या तु सहोषिता।\nप्रासादं चन्द्रसंकाशमारुरोह यदृच्छया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000084002, "chapter_id": 9084, "verse_number": "२-७-२", "content_sanskrit": "सिक्तराजपथां कृत्स्नां प्रकीर्णकमलोत्पलाम्।\nअयोध्यां मन्थरा तस्मात् प्रासादादन्ववैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000084003, "chapter_id": 9084, "verse_number": "२-७-३", "content_sanskrit": "पताकाभिर्वरार्हाभिर्ध्वजैश्च समलंकृताम्।\nसिक्तां चन्दनतोयैश्च शिरःस्नातजनैर्युताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000084004, "chapter_id": 9084, "verse_number": "२-७-४", "content_sanskrit": "माल्यमोदकहस्तैश्च द्विजेन्द्रैरभिनादिताम्।\nशुक्लदेवगृहद्वारां सर्ववादित्रनादिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000084005, "chapter_id": 9084, "verse_number": "२-७-५", "content_sanskrit": "सम्प्रहृष्टजनाकीर्णां ब्रह्मघोषनिनादिताम्।\nप्रहृष्टवरहस्त्यश्वां सम्प्रणर्दितगोवृषाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000084006, "chapter_id": 9084, "verse_number": "२-७-६", "content_sanskrit": "हृष्टप्रमुदितैः पौरैरुच्छ्रितध्वजमालिनीम्।\nअयोध्यां मन्थरा दृष्ट्वा परं विस्मयमागता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000084007, "chapter_id": 9084, "verse_number": "२-७-७", "content_sanskrit": "सा हर्षोत्फुल्लनयनां पाण्डुरक्षौमवासिनीम्।\nअविदूरे स्थितां दृष्ट्वा धात्रीं पप्रच्छ मन्थरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000084008, "chapter_id": 9084, "verse_number": "२-७-८", "content_sanskrit": "उत्तमेनाभिसंयुक्ता हर्षेणार्थपरा सती।\nराममाता धनं किं नु जनेभ्यः सम्प्रयच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000084009, "chapter_id": 9084, "verse_number": "२-७-९", "content_sanskrit": "अतिमात्रं प्रहर्षः किं जनस्यास्य च शंस मे।\nकारयिष्यति किं वापि सम्प्रहृष्टो महीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000084010, "chapter_id": 9084, "verse_number": "२-७-१०", "content_sanskrit": "विदीर्यमाणा हर्षेण धात्री तु परया मुदा।\nआचचक्षेऽथ कुब्जायै भूयसीं राघवे श्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000084011, "chapter_id": 9084, "verse_number": "२-७-११", "content_sanskrit": "श्वः पुष्येण जितक्रोधं यौवराज्येन चानघम्।\nराजा दशरथो राममभिषेक्ता हि राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000084012, "chapter_id": 9084, "verse_number": "२-७-१२", "content_sanskrit": "धात्र्यास्तु वचनं श्रुत्वा कुब्जा क्षिप्रममर्षितः।\nकैलासशिखराकारात् प्रासादादवरोहत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000084013, "chapter_id": 9084, "verse_number": "२-७-१३", "content_sanskrit": "सा दह्यमाना क्रोधेन मन्थरा पापदर्शिनी।\nशयानामेव कैकेयीमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000084014, "chapter_id": 9084, "verse_number": "२-७-१४", "content_sanskrit": "उत्तिष्ठ मूढे किं शेषे भयं त्वामभिवर्तते।\nउपप्लुतमघौघेन नात्मानमवबुध्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000084015, "chapter_id": 9084, "verse_number": "२-७-१५", "content_sanskrit": "अनिष्टे सुभगाकारे सौभाग्येन विकत्थसे।\nचलं हि तव सौभाग्यं नद्याः स्रोत इवोष्णगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000084016, "chapter_id": 9084, "verse_number": "२-७-१६", "content_sanskrit": "एवमुक्ता तु कैकेयी रुष्टया परुषं वचः।\nकुब्जया पापदर्शिन्या विषादमगमत् परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000084017, "chapter_id": 9084, "verse_number": "२-७-१७", "content_sanskrit": "कैकेयी त्वब्रवीत् कुब्जां कच्चित् क्षेमं न मन्थरे।\nविषण्णवदनां हि त्वां लक्षये भृशदुःखिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000084018, "chapter_id": 9084, "verse_number": "२-७-१८", "content_sanskrit": "मन्थरा तु वचः श्रुत्वा कैकेय्या मधुराक्षरम्।\nउवाच क्रोधसंयुक्ता वाक्यं वाक्यविशारदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000084019, "chapter_id": 9084, "verse_number": "२-७-१९", "content_sanskrit": "सा विषण्णतरा भूत्वा कुब्जा तस्यां हितैषिणी।\nविषादयन्ती प्रोवाच भेदयन्ती च राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000084020, "chapter_id": 9084, "verse_number": "२-७-२०", "content_sanskrit": "अक्षयं सुमहद् देवि प्रवृत्तं त्वद्विनाशनम्।\nरामं दशरथो राजा यौवराज्येऽभिषेक्ष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000084021, "chapter_id": 9084, "verse_number": "२-७-२१", "content_sanskrit": "सास्म्यगाधे भये मग्ना दुःखशोकसमन्विता।\nदह्यमानानलेनेव त्वद्धितार्थमिहागता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000084022, "chapter_id": 9084, "verse_number": "२-७-२२", "content_sanskrit": "तव दुःखेन कैकेयि मम दुःखं महद् भवेत्।\nत्वद‍्वृद्धौ मम वृद्धिश्च भवेदिह न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000084023, "chapter_id": 9084, "verse_number": "२-७-२३", "content_sanskrit": "नराधिपकुले जाता महिषी त्वं महीपतेः।\nउग्रत्वं राजधर्माणां कथं देवि न बुध्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000084024, "chapter_id": 9084, "verse_number": "२-७-२४", "content_sanskrit": "धर्मवादी शठो भर्ता श्लक्ष्णवादी च दारुणः।\nशुद्धभावेन जानीषे तेनैवमतिसंधिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000084025, "chapter_id": 9084, "verse_number": "२-७-२५", "content_sanskrit": "उपस्थितः प्रयुञ्जानस्त्वयि सान्त्वमनर्थकम्।\nअर्थेनैवाद्य ते भर्ता कौसल्यां योजयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000084026, "chapter_id": 9084, "verse_number": "२-७-२६", "content_sanskrit": "अपवाह्य तु दुष्टात्मा भरतं तव बन्धुषु।\nकाल्ये स्थापयिता रामं राज्ये निहतकण्टके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000084027, "chapter_id": 9084, "verse_number": "२-७-२७", "content_sanskrit": "शत्रुः पतिप्रवादेन मात्रेव हितकाम्यया।\nआशीविष(=सर्प) इवाङ्गेन बाले परिधृतस्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000084028, "chapter_id": 9084, "verse_number": "२-७-२८", "content_sanskrit": "यथा हि कुर्याच्छत्रुर्वा सर्पो वा प्रत्युपेक्षितः।\nराज्ञा दशरथेनाद्य सपुत्रा त्वं तथा कृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000084029, "chapter_id": 9084, "verse_number": "२-७-२९", "content_sanskrit": "पापेनानृतसान्त्वेन बाले नित्यं सुखोचिता।\nरामं स्थापयता राज्ये सानुबन्धा हता ह्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000084030, "chapter_id": 9084, "verse_number": "२-७-३०", "content_sanskrit": "सा प्राप्तकालं कैकेयि क्षिप्रं कुरु हितं तव।\nत्रायस्व पुत्रमात्मानं मां च विस्मयदर्शने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000084031, "chapter_id": 9084, "verse_number": "२-७-३१", "content_sanskrit": "मन्थराया वचः श्रुत्वा शयनात् सा शुभानना।\nउत्तस्थौ हर्षसम्पूर्णा चन्द्रलेखेव शारदी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000084032, "chapter_id": 9084, "verse_number": "२-७-३२", "content_sanskrit": "अतीव सा तु संतुष्टा कैकेयी विस्मयान्विता।\nदिव्यमाभरणं तस्यै कुब्जायै प्रददौ शुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000084033, "chapter_id": 9084, "verse_number": "२-७-३३", "content_sanskrit": "दत्त्वा त्वाभरणं तस्यै कुब्जायै प्रमदोत्तमा।\nकैकेयी मन्थरां हृष्टा पुनरेवाब्रवीदिदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000084034, "chapter_id": 9084, "verse_number": "२-७-३४", "content_sanskrit": "इदं तु मन्थरे मह्यमाख्यातं परमं प्रियम्।\nएतन्मे प्रियमाख्यातं किं वा भूयः करोमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000084035, "chapter_id": 9084, "verse_number": "२-७-३५", "content_sanskrit": "रामे वा भरते वाहं विशेषं नोपलक्षये।\nतस्मात् तुष्टास्मि यद् राजा रामं राज्येऽभिषेक्ष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000084036, "chapter_id": 9084, "verse_number": "२-७-३६", "content_sanskrit": "न मे परं किंचिदितो वरं पुनः\nप्रियं प्रियार्हे सुवचं वचोऽमृतम्।\nतथा ह्यवोचस्त्वमतः प्रियोत्तरं\nवरं परं ते प्रददामि तं वृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000084037, "chapter_id": 9084, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे सप्तमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]