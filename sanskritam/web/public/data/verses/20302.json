[{"id": 7000302000, "chapter_id": 20302, "verse_number": "१-५६-१", "content_sanskrit": "श्रीभगवानुवाच ।\nपुरा शर्वः स्त्रियो दृष्ट्वा युवती रूपशालिनीः ।\nगंधर्वकिन्नराणां च मनुष्याणां च सर्वतः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000302001, "chapter_id": 20302, "verse_number": "१-५६-२", "content_sanskrit": "मंत्रेण ताः समाकृष्य त्वतिदूरे विहायसि ।\nतपोव्याजपरो देवस्तासु संगतमानसः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000302002, "chapter_id": 20302, "verse_number": "१-५६-३", "content_sanskrit": "अतिरम्यां कुटीं कृत्वा ताभिः सह महेश्वरः ।\nक्रीडां चकार सहसा मनोभव पराभवः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000302003, "chapter_id": 20302, "verse_number": "१-५६-४", "content_sanskrit": "एतस्मिन्नंतरे गौर्याश्चित्तमुद्भ्रांततां गतम् ।\nअपश्यद्ध्यानयोगेन क्रीडंतं जगदीश्वरम्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000302004, "chapter_id": 20302, "verse_number": "१-५६-५", "content_sanskrit": "स्त्रीभिरंतर्गतं ज्ञात्वा रोषस्य वशगाभवत् ।\nततः क्षेमंकरी रूपा भूत्वा च प्रविवेश सा॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000302005, "chapter_id": 20302, "verse_number": "१-५६-६", "content_sanskrit": "व्योमैकांतेतिदूरे च कामदेव समप्रभम् ।\nवामातिमध्यगं शुभ्रं पुरुषं पुरुषोत्तमम्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000302006, "chapter_id": 20302, "verse_number": "१-५६-७", "content_sanskrit": "स्त्रीभिः सह समालिग्य प्रक्रीडंतं मुहुर्मुहुः ।\nचुंबंतं निर्भरं देवं हरं रागप्रपीडितम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000302007, "chapter_id": 20302, "verse_number": "१-५६-८", "content_sanskrit": "वृत्तं क्षेमंकरी दृष्ट्वा निपपाताग्रतस्तदा ।\nतासां केशेषु चाकृष्य चकार चरणाहतिम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000302008, "chapter_id": 20302, "verse_number": "१-५६-९", "content_sanskrit": "त्रपया पीडितश्शर्वः पराङ्मुखमवस्थितः ।\nकेशेष्वाकृष्य रोषात्ताः पातयामास भूतले॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000302009, "chapter_id": 20302, "verse_number": "१-५६-१०", "content_sanskrit": "स्त्रियः सर्वाधरां प्राप्य सहसा विकृताननाः ।\nउमाशापप्रदग्धांगा म्लेच्छानां वशमागताः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000302010, "chapter_id": 20302, "verse_number": "१-५६-११", "content_sanskrit": "ताश्चांडालस्त्रियः ख्याता अधवा धवसंयुताः ।\nअद्याप्युमाकृतं शापं सर्वास्ताश्च समश्नुयुः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000302011, "chapter_id": 20302, "verse_number": "१-५६-१२", "content_sanskrit": "अथोमा शतधा रूपं कृत्वेशं संगता तदा ।\nएवं प्रभावं जानीहि कामस्य सततं द्विज॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000302012, "chapter_id": 20302, "verse_number": "१-५६-१३", "content_sanskrit": "ततश्चिरात्तया सार्द्धं गतः कैलासमंदिरं ।\nअतः क्षेमंकरीं दृष्ट्वा येभिनंदंति मानवाः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000302013, "chapter_id": 20302, "verse_number": "१-५६-१४", "content_sanskrit": "तेषां वित्तर्द्धि विभवा भवंतीह परत्र च ।\nकुंकुमारक्तसर्वांगि कुंदेन्दुधवलानने॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000302014, "chapter_id": 20302, "verse_number": "१-५६-१५", "content_sanskrit": "सर्वमंगलदे देवि क्षेमंकरि नमोस्तु ते ।\nयोगिनीसाम्यं तेनैव संमुखा विमुखापि वा॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000302015, "chapter_id": 20302, "verse_number": "१-५६-१६", "content_sanskrit": "दृष्ट्वा तां नाभिवंदेद्यस्तस्य युद्धे पराजयः ।\nराजगृहेषु विद्यायां नमस्काराज्जयो भवेत्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000302016, "chapter_id": 20302, "verse_number": "१-५६-१७", "content_sanskrit": "एवं कामस्य माहात्म्यं भवो मोहवशं गतः ।\nअयं देवासुराणां च क्षमया प्रभुतां गतः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000302017, "chapter_id": 20302, "verse_number": "१-५६-१८", "content_sanskrit": "अस्यैव सदृशो लोके न भूतो न भविष्यति ।\nरामामङ्कस्थितां रम्यां क्षमातल्पगतेन च॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000302018, "chapter_id": 20302, "verse_number": "१-५६-१९", "content_sanskrit": "त्यक्त्वैव साधिता लोकास्सुरासुरसुदुर्लभाः ।\nएवं वैष्णवमुख्यश्च सुरासुरगणार्चितः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000302019, "chapter_id": 20302, "verse_number": "१-५६-२०", "content_sanskrit": "यो नो ददाति भुक्त्यग्र्यं शेषं च स्वयमश्नुते ।\nएवमभ्यासधैर्येण दीर्घकाले सुखंगते॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000302020, "chapter_id": 20302, "verse_number": "१-५६-२१", "content_sanskrit": "प्राक्संगमात्स्वभार्यां च दृष्ट्वा मां प्रददौ मुदा ।\nद्वादशाब्दं प्रसंकल्प्य प्राग्भोगो मयि वेशितः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000302021, "chapter_id": 20302, "verse_number": "१-५६-२२", "content_sanskrit": "तेन तस्य गृहे नित्यं तिष्ठामि गृहरक्षणात् ।\nतथा धात्रीफलस्यापि सदा स्वर समीहते॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000302022, "chapter_id": 20302, "verse_number": "१-५६-२३", "content_sanskrit": "तस्मादुक्तो मयान्येषां वैष्णवानां च वैष्णवः ।\nपुरा ये विप्र मे भक्तास्सुरा मत्पथगामिनः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000302023, "chapter_id": 20302, "verse_number": "१-५६-२४", "content_sanskrit": "तैरेव न कृतं यच्च तदनेन कृतं परम् ।\nतस्माद्वैष्णवसर्वस्वं नाम रम्यं मया कृतम्॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000302024, "chapter_id": 20302, "verse_number": "१-५६-२५", "content_sanskrit": "अस्य वेश्मनि तिष्ठामि मुहूर्तं न चलाम्यहम् ।\nअतो ये चैवमद्भक्तास्तेष्वहं सुलभो द्विज॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000302025, "chapter_id": 20302, "verse_number": "१-५६-२६", "content_sanskrit": "अस्माकं पदवीं तेभ्यो ह्यद्य दद्मि स्वकारणम् ।\nआवयोर्विप्रसौजन्यं स्वप्नभोज्यादिकं समम्॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000302026, "chapter_id": 20302, "verse_number": "१-५६-२७", "content_sanskrit": "सायुज्यं च सखित्वं च पश्य भूदेवनांतरम् ।\nततो मूकादयः सर्वे स्वागता हरिमीश्वरम्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000302027, "chapter_id": 20302, "verse_number": "१-५६-२८", "content_sanskrit": "गंतुकामा दिवं पुण्यास्सदाराः सपरिच्छदाः ।\nये च तेषां गृहाभ्याशेप्यात्मनो गृहगोधिकाः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000302028, "chapter_id": 20302, "verse_number": "१-५६-२९", "content_sanskrit": "नाना कीटादयो ये च तेषामनुययुः सुराः ।\nव्यास उवाच ।\nएतस्मिन्नंतरे देवाः सिद्धाश्च परमर्षयः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000302029, "chapter_id": 20302, "verse_number": "१-५६-३०", "content_sanskrit": "प्रचक्रुः पुष्पवर्षाणि साधुसाध्वित्यनादयन् ।\nदेवदुंदुभयो नेदुर्विमानेषु वनेषु च॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000302030, "chapter_id": 20302, "verse_number": "१-५६-३१", "content_sanskrit": "समारुह्य रथं स्वं स्वं हरिवीथीपुरं ययुः ।\nतदद्भुतं समालोक्य विप्रोऽवोचज्जनार्दनम्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000302031, "chapter_id": 20302, "verse_number": "१-५६-३२", "content_sanskrit": "उपदेशं च देवेश ब्रूहि मे मधुसूदन ।\nश्रीभगवानुवाच ।\nगच्छ स्वपितरौ तात शोकविक्लवमानसौ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000302032, "chapter_id": 20302, "verse_number": "१-५६-३३", "content_sanskrit": "समाराध्य प्रयत्नेन मद्गृहं प्राप्स्यसेऽचिरात् ।\nपितृमातृसमा देवा न तिष्ठंति सुरालये॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000302033, "chapter_id": 20302, "verse_number": "१-५६-३४", "content_sanskrit": "याभ्यां सुगर्हितं देहं शिशुत्वे पालितं सदा ।\nअज्ञानदोषसहितं प्रपुष्टं चापि वर्धितम्॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000302034, "chapter_id": 20302, "verse_number": "१-५६-३५", "content_sanskrit": "याभ्यां तयोस्समं नास्ति त्रैलोक्ये सचराचरे ।\nततो देवगणास्सर्वे पंचभिस्तैर्मुदान्विताः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000302035, "chapter_id": 20302, "verse_number": "१-५६-३६", "content_sanskrit": "माधवं संस्तुवंतश्च गतास्ते हरिमंदिरम् ।\nखचितां च पुरीं रम्यां विश्वकर्मविनिर्मिताम्॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000302036, "chapter_id": 20302, "verse_number": "१-५६-३७", "content_sanskrit": "रत्नाढ्यामिष्टसंपूर्णां कल्पवृक्षादिभिर्युताम् ।\nशातकुम्भमयैर्गेहैस्सर्वरत्नैस्सकर्बुराम्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000302037, "chapter_id": 20302, "verse_number": "१-५६-३८", "content_sanskrit": "वज्रवैडूर्यसोपानां स्वर्णदीतोयसंयुताम् ।\nगीतवाद्यादिसंपूर्णां सर्वदुर्गसमाकुलाम्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000302038, "chapter_id": 20302, "verse_number": "१-५६-३९", "content_sanskrit": "कोकिलालापबहुलां सिद्धगंधर्वसेविताम् ।\nरूपाढ्यैः सुजनैः पूर्णां प्रयांतीमिव खे पुरीम्॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000302039, "chapter_id": 20302, "verse_number": "१-५६-४०", "content_sanskrit": "ततः स्थित्वाऽच्युताः सर्वे सर्वलोकोर्ध्वतो भृशम् ।\nद्विजोपि पितरौ गत्वा समाराध्य प्रयत्नतः॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000302040, "chapter_id": 20302, "verse_number": "१-५६-४१", "content_sanskrit": "अचिरेणैव कालेन सकुटुंबो हरिं ययौ ।\nपंचाख्यानमिदं पुण्यं मया ते समुदाहृतम्॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000302041, "chapter_id": 20302, "verse_number": "१-५६-४२", "content_sanskrit": "यः पठेच्छृणुयाद्वापि तस्य नास्तीह दुर्गतिः ।\nब्रह्महत्यादिभिः पापैर्न लिप्येत कदाचन॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000302042, "chapter_id": 20302, "verse_number": "१-५६-४३", "content_sanskrit": "गवां कोटिप्रदानेन यत्फलं लभते नरः ।\nतत्फलं समवाप्नोति पंचाख्यानावगाहनात्॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000302043, "chapter_id": 20302, "verse_number": "१-५६-४४", "content_sanskrit": "स्नानेन पुष्करे नित्यं भागीरथ्यां च सर्वदा ।\nयत्फलं तदवाप्नोति सकृच्छ्रवणगोचरात्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000302044, "chapter_id": 20302, "verse_number": "१-५६-४५", "content_sanskrit": "दुःस्वप्नं नाशयेत्क्षिप्रं तथारोग्यं प्रयच्छति ।\nलक्ष्म्यारोग्यकरं चैव तस्माच्छ्रोतव्यमेव हि॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]