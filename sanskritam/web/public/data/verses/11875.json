[{"id": 50024661, "chapter_id": 11875, "verse_number": "1", "content_sanskrit": "द्विविधं परतन्त्रं च भावोऽभाव इतीरितः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024662, "chapter_id": 11875, "verse_number": "2", "content_sanskrit": "॥ अभावप्रभेदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024663, "chapter_id": 11875, "verse_number": "3", "content_sanskrit": "पूर्वापरसदात्वेन त्रिविधोऽभाव इष्यते॥ २ ॥ भावाभावस्वरूपत्वान्नान्योन्याभावता पृथक्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024664, "chapter_id": 11875, "verse_number": "4", "content_sanskrit": "॥ भावविभागः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50024665, "chapter_id": 11875, "verse_number": "5", "content_sanskrit": "चेतनोऽचेतनश्चेति भावश्च द्विविधः स्मृतः॥ ३॥ 【पाठभेदः: BG—चेतनोऽचेतनश्चेति भावोऽपि द्विविधः स्मृतः॥ ३॥】", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50024666, "chapter_id": 11875, "verse_number": "6", "content_sanskrit": "॥ चेतनविभागादि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50024667, "chapter_id": 11875, "verse_number": "7", "content_sanskrit": "नित्यमुक्तश्च सृतियुक् परतन्त्रोऽपि चेतनः। द्विधैव श्रीर्नित्यमुक्ता सृतियुक् च द्विधा मतः॥ ४॥ मुक्तोऽमुक्त इति ह्यत्र ब्रह्मान्ता उत्तरोत्तरम्। मुक्ताः शतगुणाः प्रोक्ता रमा तेभ्योऽखिलैर्गुणैः॥ ५॥ नित्यं बहुगुणोद्रिक्ता ततोऽनन्तगुणो हरिः। अमुक्तास्त्रिविधास्तत्र नीचमध्योच्चभेदतः॥ ६ ॥ मुक्तियोग्यास्तत्र चोच्चा नित्यवर्तास्तु मध्यमाः। नीचा नित्यतमोयोग्याः --- --- --- ---", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50024668, "chapter_id": 11875, "verse_number": "8", "content_sanskrit": "॥ अचेतनविभागादि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50024669, "chapter_id": 11875, "verse_number": "9", "content_sanskrit": "--- --- --- --- द्विधैवाचेतनं मतम्॥ ७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50024670, "chapter_id": 11875, "verse_number": "10", "content_sanskrit": "नित्यानित्यत्वभेदेन देशः कालः श्रुतिस्तथा। भूतेन्द्रियप्राणगुणसूक्ष्मरूपं च नित्यकम्॥ ८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50024671, "chapter_id": 11875, "verse_number": "11", "content_sanskrit": "एषां विकारोऽनित्यः स्यात्  --- --- --- ---", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]