[{"id": 2060767, "chapter_id": 2301, "verse_number": "८-२२-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2060768, "chapter_id": 2301, "verse_number": "८-२२-१", "content_sanskrit": "स्वेन च्छन्देन नः सर्वानवधीद्व्यक्तमर्जुनः।\nन ह्यस्य समरे मुच्येदन्तकोऽप्याततायिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2060769, "chapter_id": 2301, "verse_number": "८-२२-२", "content_sanskrit": "पार्थो ह्येकोऽहरद्भद्रामेकश्चाग्निमतर्पयत्।\nएकश्चेमां महीं जित्वा चक्रे बलिभृतो नृपान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2060770, "chapter_id": 2301, "verse_number": "८-२२-३", "content_sanskrit": "एको निवातकवचनानहनद्दिव्यकार्मुकः।\nएकः किरातरूपेण स्थितं शर्वमयोधयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2060771, "chapter_id": 2301, "verse_number": "८-२२-४", "content_sanskrit": "एको ह्यरक्षद्भरतानेको भवमतोषयत्।\nतेनैकेन जिताः सर्वे मदीया ह्युग्रतेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2060772, "chapter_id": 2301, "verse_number": "८-२२-५", "content_sanskrit": "न ते निन्द्याः प्रशस्यास्ते यत्ते चक्रुर्ब्रवीहि तत्।\nततो दुर्योधनः सूत पश्चात्किमकरोत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2060773, "chapter_id": 2301, "verse_number": "८-२२-६x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2060774, "chapter_id": 2301, "verse_number": "८-२२-६", "content_sanskrit": "हतप्रहतविध्वस्ता विवर्मायुधवाहनाः।\nदीनस्वरा दूयमाना मानिनः शत्रुनिर्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2060775, "chapter_id": 2301, "verse_number": "८-२२-७", "content_sanskrit": "शिबिरस्थाः पुनर्मन्त्रं मन्त्रयन्ति स्म कौरवाः।\nभग्नदंष्ट्रा हतविषाः पादाक्रान्ता इवोरगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2060776, "chapter_id": 2301, "verse_number": "८-२२-८", "content_sanskrit": "तानब्रवीत्ततः कर्णः क्रुद्वः सर्प इव श्वसन्।\nकरं करेण निष्पीड्य प्रेक्षमाणस्तवात्मजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2060777, "chapter_id": 2301, "verse_number": "८-२२-९", "content_sanskrit": "यत्तो दृढश्च दक्षश्च धृतिमानर्जुनः सदा।\nसम्बोधयति चाप्येनं यथाकालमधोक्षजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2060778, "chapter_id": 2301, "verse_number": "८-२२-१०", "content_sanskrit": "सहसाऽस्त्रविसर्गेण वयं तेनाद्य वञ्चिताः।\nश्वस्त्वहं तस्य सङ्कल्पं सर्वं हन्ता महीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2060779, "chapter_id": 2301, "verse_number": "८-२२-११", "content_sanskrit": "एवमुक्तस्तथेत्युक्त्वा सोऽनुजज्ञे नृपोत्तमान्।\nतेऽनुज्ञाता नृपाः सर्वे स्वानि वेश्मानि भेजिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2060780, "chapter_id": 2301, "verse_number": "८-२२-१२", "content_sanskrit": "सुखोषितास्तां रजनीं हृष्टा युद्वाय निर्ययुः।\nतेऽपश्यन्विहितं व्यूहं धर्मराजेन दुर्जयम्।\nप्रयत्नात्कुरुमुख्येन बृहस्पत्युशनोमतात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2060781, "chapter_id": 2301, "verse_number": "८-२२-१३", "content_sanskrit": "अथ प्रतीपकर्तारं प्रवीरं परवीरहा।\nसस्मार वृषभस्कन्धं कर्णं दुर्योधनस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2060782, "chapter_id": 2301, "verse_number": "८-२२-१४", "content_sanskrit": "पुरन्दरसमं युद्वे मरुद्गणसमं बले।\nकार्तवीर्यसमं वीर्ये कर्णं राज्ञोऽगमन्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2060783, "chapter_id": 2301, "verse_number": "८-२२-१५", "content_sanskrit": "सर्वेषां चैव सैन्यानां कर्णमेवागमन्मनः।\nसूतपुत्रं महेष्वासं बन्धुमात्ययिकेष्विव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2060784, "chapter_id": 2301, "verse_number": "८-२२-१६x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2060785, "chapter_id": 2301, "verse_number": "८-२२-१६", "content_sanskrit": "ततो दुर्योधनः सूत पश्चात्किमकरोत्तदा।\nयद्वोऽगमन्मनो मन्दाः कर्णं वैकर्तनं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2060786, "chapter_id": 2301, "verse_number": "८-२२-१७", "content_sanskrit": "अप्यपश्यत राधेयं शीतार्ता इव भास्करम्।\nकृतेऽवहारे सैन्यानां प्रवृत्ते च रणे पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2060787, "chapter_id": 2301, "verse_number": "८-२२-१८", "content_sanskrit": "`दुर्योधनं च तत्राजौ पाण्डवेन भृशार्दितम्।\nपराक्रान्तान्पाण्डुसुतान्दृष्ट्वाऽपि भृशार्दितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2060788, "chapter_id": 2301, "verse_number": "८-२२-१९", "content_sanskrit": "कथं वैकर्तनः कर्णस्तत्रायुध्यत सञ्जय।\nकथं च पाण्डवाः सर्वे युयुधुस्तत्र सूतजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2060789, "chapter_id": 2301, "verse_number": "८-२२-२०", "content_sanskrit": "कर्णो ह्येको महाबाहुर्हन्यात्पार्थान्ससृञ्जयान्।\nकर्णस्य भुजयोर्वीर्यं शक्रविष्णुसमं युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2060790, "chapter_id": 2301, "verse_number": "८-२२-२१", "content_sanskrit": "तस्य शस्त्राणि घोराणि विक्रमश्च महात्मनः।\nकर्णमाश्रित्य सङ्ग्रामे मत्तो दुर्योधनो नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2060791, "chapter_id": 2301, "verse_number": "८-२२-२२", "content_sanskrit": "दुर्योधनं ततो दृष्ट्वा पाण्डवेन भृशार्दितम्।\nपराक्रान्तान्पाण्डुसुतान्दृष्ट्वा चापि महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2060792, "chapter_id": 2301, "verse_number": "८-२२-२३", "content_sanskrit": "कर्णमाश्रित्य सङ्ग्रामे मन्दो दुर्योधनः पुनः।\nजेतुमुत्सहते पार्थान्सपुत्रान्सहकेशवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2060793, "chapter_id": 2301, "verse_number": "८-२२-२४", "content_sanskrit": "`यः सौबलं तथा तात नीतिमानिति मन्यते।\nकर्णं चाग्रतिमं युद्वे देवैरपि दुरुत्सहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2060794, "chapter_id": 2301, "verse_number": "८-२२-२५", "content_sanskrit": "मन्यतेऽभ्यधिकं पार्थादेवं चास्य हृदि स्थितम्।\nविजेष्यति रणे कर्ण एकः पर्थान्ससोमकान्।\nमम चैव सदा मन्दः शंसते नित्यमग्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2060795, "chapter_id": 2301, "verse_number": "८-२२-२६", "content_sanskrit": "अहो बत महद्दुःखं यत्र पाण्डुसुतान्रणे।\nनातरद्रभसः कर्णो दैवं नूनं परायणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2060796, "chapter_id": 2301, "verse_number": "८-२२-२७", "content_sanskrit": "अहो द्यूतस्य निष्ठेयं घोरा सम्प्रति वर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2060797, "chapter_id": 2301, "verse_number": "८-२२-२८", "content_sanskrit": "अहो तीव्राणि दुःखानि दुर्योधनकृतान्यहम्।\nसोढा घोराणि बहुशः शल्यभूतानि सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2060798, "chapter_id": 2301, "verse_number": "८-२२-२९", "content_sanskrit": "सौबलं च तदा तात नीतिमानिति मन्यते।\nकर्णश्च रभसो नित्यं राजा त चाप्यनुव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2060799, "chapter_id": 2301, "verse_number": "८-२२-३०", "content_sanskrit": "यदेवं वर्तमानेषु महायुद्वेषु सञ्जय।\nअश्रौषं निहतान्पुत्रान्नित्यमेव विनिर्जितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2060800, "chapter_id": 2301, "verse_number": "८-२२-३१", "content_sanskrit": "न पाण्डवानां समरे कश्चिदस्ति हतः किल।\nस्त्रीमध्यमिव गाहन्ते दैवं तु बलवत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2060801, "chapter_id": 2301, "verse_number": "८-२२-३२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2060802, "chapter_id": 2301, "verse_number": "८-२२-३२", "content_sanskrit": "[राजन्पूर्वनिमित्तानि धर्मिष्ठानि विचिन्तय]।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2060803, "chapter_id": 2301, "verse_number": "८-२२-३३", "content_sanskrit": "अतिक्रान्तं हि यत्कार्यं पश्चाच्चिन्तयते नरः।\nतच्चास्य न भवेत्कार्यं चिन्तया च विनश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2060804, "chapter_id": 2301, "verse_number": "८-२२-३४", "content_sanskrit": "तदिदं तव कार्यं तु दूरप्राप्तं विजानता।\nन कृतं यत्त्वया पूर्वं प्राप्ताप्राप्तविचारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2060805, "chapter_id": 2301, "verse_number": "८-२२-३५", "content_sanskrit": "उक्तोऽसि बहुधा राज्ञन्मा युध्यस्वेति पाण्डवैः।\nन च तत्त्वग्रहीर्द्वेषात्पाण्डवेषु विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2060806, "chapter_id": 2301, "verse_number": "८-२२-३६", "content_sanskrit": "त्वया पापानि घोराणि समाचीर्णानि पाण्डुषु।\nत्वत्कृते वर्तते घोरः पार्थिवानां जनक्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2060807, "chapter_id": 2301, "verse_number": "८-२२-३७", "content_sanskrit": "तत्त्विदानीमतिक्रान्तं मा शुचो भरतर्षभ।\nशृणु सर्वं यथावृत्तं घोरं वैशसमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2060808, "chapter_id": 2301, "verse_number": "८-२२-३८", "content_sanskrit": "प्रभातायां रजन्यां तु कर्णो राजानमभ्ययात्।\nसमेत्य च महाबाहुर्दुर्योधनमथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2060809, "chapter_id": 2301, "verse_number": "८-२२-३९x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2060810, "chapter_id": 2301, "verse_number": "८-२२-३९", "content_sanskrit": "अद्य राजन्समेष्यामि पाण्डवेन यशस्विना।\nनिहनिष्यामि तं वीरं स वा मां निहनिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2060811, "chapter_id": 2301, "verse_number": "८-२२-४०", "content_sanskrit": "बहुत्वान्मम कार्याणां तथा पार्थस्य भारत।\nनाभूत्समागमो राजन्मम चैवार्जुनस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2060812, "chapter_id": 2301, "verse_number": "८-२२-४१", "content_sanskrit": "इदं तु मे यथाप्रज्ञं शृणु वाक्यं विशाम्पते।\nअनिहत्य रणे पार्थं नाहमेष्यामि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2060813, "chapter_id": 2301, "verse_number": "८-२२-४२", "content_sanskrit": "हतप्रवीरे सैन्येऽस्मिन्मयि चावस्थिते युधि।\nअभियास्यति मां पार्थः शक्रशक्तिविनाकृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2060814, "chapter_id": 2301, "verse_number": "८-२२-४३", "content_sanskrit": "ततः श्रेयस्करं यच्च तन्निबोध जनेश्वर।\nआयुधानां च मे वीर्यं दिव्यानामर्जुनस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2060815, "chapter_id": 2301, "verse_number": "८-२२-४४", "content_sanskrit": "कार्यस्य महतो भेदे लाघवे दूरपातने।\nसौष्ठवे चास्त्रपाते च सव्यसाची न मत्समः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2060816, "chapter_id": 2301, "verse_number": "८-२२-४५", "content_sanskrit": "प्राणे शौर्येऽथ विज्ञाने विक्रमे चापि भारत।\nनिमित्तज्ञानयोगे च सव्यसाची न मत्समः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2060817, "chapter_id": 2301, "verse_number": "८-२२-४६", "content_sanskrit": "सर्वायुधमहामात्रं विजयं नाम तद्वनुः।\nइन्द्रार्थं प्रियकामेन निर्मितं विश्वकर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2060818, "chapter_id": 2301, "verse_number": "८-२२-४७", "content_sanskrit": "येन दैत्यगणान्राजञ्जितवान्वै शतक्रतुः।\nयस्य घोषेण दैत्यानां व्यामुह्यन्त दिशो दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2060819, "chapter_id": 2301, "verse_number": "८-२२-४८", "content_sanskrit": "तद्भार्गवाय प्रायच्छच्छक्रः परमसम्मतम्।\nतद्दिव्यं भार्गवो मह्यमददद्वनुरत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2060820, "chapter_id": 2301, "verse_number": "८-२२-४९", "content_sanskrit": "तेन योत्स्ये महाबाहुमर्जुनं जयतां वरम्।\nयथेन्द्रः समरे सर्वान्दैतेयान्वै समागतान्।\n`निजघान तथा सर्वाञ्जेष्यामि युधि पाण्डवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2060821, "chapter_id": 2301, "verse_number": "८-२२-५०", "content_sanskrit": "धनुर्घोरं रामदत्तं गाण्डीवात्तद्विशिष्यते।\nत्रिस्सप्तकृत्वः पृथिवी धनुषा येन निर्जिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2060822, "chapter_id": 2301, "verse_number": "८-२२-५१", "content_sanskrit": "धनुषो ह्यस्य कर्माणि दिव्यानि प्राह भार्गवः।\nतद्रामो ह्यददन्मह्यं तेन योत्स्यामि पाण्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2060823, "chapter_id": 2301, "verse_number": "८-२२-५२", "content_sanskrit": "अद्य दुर्योधनाहं त्वां नन्दयिष्ये सबान्धवम्।\nनिहत्य समरे वीरमर्जुनं जयतां वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2060824, "chapter_id": 2301, "verse_number": "८-२२-५३", "content_sanskrit": "सपर्वतवनद्वीपा हतवीरा ससागरा।\nपुत्रपौत्रप्रतिष्ठा ते भविष्यत्यद्य पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2060825, "chapter_id": 2301, "verse_number": "८-२२-५४", "content_sanskrit": "नाशक्यं विद्यते मेऽद्य त्वत्प्रियार्थं विशेषतः।\nसम्यग्धर्मानुरक्तस्य सिद्विरात्मवतो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2060826, "chapter_id": 2301, "verse_number": "८-२२-५५", "content_sanskrit": "न हि मे विक्रमं सोढुं स शक्तोऽग्निं तरुर्यथा।\nअवश्यं तु मया वाच्यं येन हीनोऽस्मि फल्गुनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2060827, "chapter_id": 2301, "verse_number": "८-२२-५६", "content_sanskrit": "ज्या तस्य धनुषो दिव्या तथाऽक्षय्ये महेषुधी।\nसारथिस्तस्य गोविन्दो मम तादृङ्ग विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2060828, "chapter_id": 2301, "verse_number": "८-२२-५७", "content_sanskrit": "तस्य दिव्यं धनुः श्रेष्ठं गाण्डीवमजितं युधि।\nविजयं च महद्दिव्यं ममापि धनुरुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2060829, "chapter_id": 2301, "verse_number": "८-२२-५८", "content_sanskrit": "तत्राहमधिकः पार्थाद्वनुषा तेन पार्थिव।\nयेन चाप्यधिको वीरः पाण्डवस्तन्निबोध मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2060830, "chapter_id": 2301, "verse_number": "८-२२-५९", "content_sanskrit": "रश्मिग्राहश्च दाशार्हः सर्वलोकनमस्कृतः।\nअग्निदत्तश्च वै दिव्यो रथः काञ्चनभूषणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2060831, "chapter_id": 2301, "verse_number": "८-२२-६०", "content_sanskrit": "अच्छेद्याः सर्वतो वीर वाजिनश्च मनोजवाः।\nध्वजश्च दिव्यो द्युतिमान्वानरोपि भयङ्करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2060832, "chapter_id": 2301, "verse_number": "८-२२-६१", "content_sanskrit": "कृष्णश्च जगतः स्रष्टा रथं तमभिरक्षति।\nएभिस्त्रिभिरहं हीनो युद्वुमिच्छामि पाण्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2060833, "chapter_id": 2301, "verse_number": "८-२२-६२", "content_sanskrit": "अयं तु सदृशः शौरेः शल्यः समितिशोभनः।\nसारथ्यं यदि मे कुर्याद्द्रुवस्ते विजयो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2060834, "chapter_id": 2301, "verse_number": "८-२२-६३", "content_sanskrit": "तस्य मे सारथिः शल्यो भवत्वसुकरः परैः।\nनाराचान्गार्ध्रपत्रांश्च शकटानि वहन्तु मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2060835, "chapter_id": 2301, "verse_number": "८-२२-६४", "content_sanskrit": "रथाश्च मुख्या राजेन्द्र युक्ता वाजिभिरुत्तमैः।\nआयान्तु पश्चात्सततं मामेव भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2060836, "chapter_id": 2301, "verse_number": "८-२२-६५", "content_sanskrit": "एवमभ्यधिकः पार्थाद्भविष्यामि गुणैरहम्।\nशल्योप्यभ्यधिकः कृष्णादर्जुनादपिचाप्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2060837, "chapter_id": 2301, "verse_number": "८-२२-६६", "content_sanskrit": "यथाऽश्वहृदयं वेद दाशार्हः परवीरहा।\nतथा शल्यो विजानीते हयज्ञानं महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2060838, "chapter_id": 2301, "verse_number": "८-२२-६७", "content_sanskrit": "बाहुवीर्ये समो नास्ति मद्रराजस्य कश्चन।\nतथाऽस्त्रे मत्समो नास्ति कश्चिदेव धनुर्धरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2060839, "chapter_id": 2301, "verse_number": "८-२२-६८", "content_sanskrit": "तथा शल्यसमो नास्ति हयज्ञाने हि कश्चन।\nसोऽयमभ्यधिकः कृष्णाद्भविष्यति रथो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2060840, "chapter_id": 2301, "verse_number": "८-२२-६९", "content_sanskrit": "एवं कृते रथस्थोऽहं गुणैरभ्यधिकोऽर्जुनात्।\nविजयेयमहं सङ्ख्ये फल्गुनं कुरुसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2060841, "chapter_id": 2301, "verse_number": "८-२२-७०", "content_sanskrit": "समुद्यातुं न शक्ष्यन्ति देवा अपि सवासवाः।\nएतत्कृतं महाराज त्वयेच्छामि परन्तप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2060842, "chapter_id": 2301, "verse_number": "८-२२-७१", "content_sanskrit": "क्रियतामेष कामो मे मा वः कालोऽत्यगादयम्।\nएवं कृते कृतं मह्यं त्वया सर्वं भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2060843, "chapter_id": 2301, "verse_number": "८-२२-७२", "content_sanskrit": "ततो द्रक्ष्यसि सङ्ग्रामे यत्करिष्यामि भारत।\nसर्वथा पाण्डवान्सङ्ख्ये विजेष्ये वै समागतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2060844, "chapter_id": 2301, "verse_number": "८-२२-७३", "content_sanskrit": "न हि मे समरे शक्ताः समुद्यातुं सुरासुराः।\nकिमु पाण्डुसुता राजन्रणे मानुषयोनयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2060845, "chapter_id": 2301, "verse_number": "८-२२-७४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2060846, "chapter_id": 2301, "verse_number": "८-२२-७४", "content_sanskrit": "एवमुक्तस्तव सुतः कर्णेनाहवशोभिना।\nसम्पूज्य सम्प्रहृष्टात्मा ततो राधेयमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2060847, "chapter_id": 2301, "verse_number": "८-२२-७५x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2060848, "chapter_id": 2301, "verse_number": "८-२२-७५", "content_sanskrit": "एवमेतत्करिष्यामि यथा त्वं कर्ण मन्यसे।\nसोपासङ्गा रथाः साश्वाः स्वनुयास्यन्ति संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2060849, "chapter_id": 2301, "verse_number": "८-२२-७६", "content_sanskrit": "नाराचान्गार्ध्रपत्रांश्च शकटानि वहन्तु ते।\nअनुयास्याम कर्ण त्वां वयं सर्वे च पार्थिवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2060850, "chapter_id": 2301, "verse_number": "८-२२-७७x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2060851, "chapter_id": 2301, "verse_number": "८-२२-७७", "content_sanskrit": "एवमुक्त्वा महाराज तव पुत्रः प्रतापवान्।\nअभिगम्याब्रवीद्राजा मद्रराजमिदं वचः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2060852, "chapter_id": 2301, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि द्वाविंशोऽध्यायः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}]