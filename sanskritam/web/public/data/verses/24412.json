[{"id": 7004412000, "chapter_id": 24412, "verse_number": "५-३-१०६-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nततो गच्छेन्महीपाल तीर्थं परमशोभनम् ।\nसौभाग्यकरणं दिव्यं नरनारीमनोरमम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004412001, "chapter_id": 24412, "verse_number": "५-३-१०६-२", "content_sanskrit": "तत्र या दुर्भगा नारी नरो वा नृपसत्तम ।\nस्नात्वार्चयेदुमारुद्रौ सौभाग्यं तस्य जायते॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004412002, "chapter_id": 24412, "verse_number": "५-३-१०६-३", "content_sanskrit": "तृतीयायामहोरात्रं सोपवासो जितेन्द्रियः ।\nनिमन्त्रयेद्द्विजं भक्त्या सपत्नीकं सुरूपिणम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004412003, "chapter_id": 24412, "verse_number": "५-३-१०६-४", "content_sanskrit": "गन्धमाल्यैरलंकृत्य वस्त्रधूपादिवासितम् ।\nभोजयेत्पायसान्नेन कृसरेणाथ भक्तितः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004412004, "chapter_id": 24412, "verse_number": "५-३-१०६-५", "content_sanskrit": "भोजयित्वा यथान्यायं प्रदक्षिणमुदाहरेत् ।\nप्रीयतां मे महादेवः सपत्नीको वृषध्वजः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004412005, "chapter_id": 24412, "verse_number": "५-३-१०६-६", "content_sanskrit": "यथा ते देवदेवेश न वियोगः कदाचन ।\nममापि करुणां कृत्वा तथास्त्विति विचिन्तयेत्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004412006, "chapter_id": 24412, "verse_number": "५-३-१०६-७", "content_sanskrit": "एवं कृते ततस्तस्य यत्पुण्यं समुदाहृतम् ।\nतत्ते सर्वं प्रवक्ष्यामि यथा देवेन भाषितम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004412007, "chapter_id": 24412, "verse_number": "५-३-१०६-८", "content_sanskrit": "दौर्भाग्यं दुर्गतिश्चैव दारिद्र्यं शोकबन्धनम् ।\nवन्ध्यत्वं सप्तजन्मानि जायते न युधिष्ठिर॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004412008, "chapter_id": 24412, "verse_number": "५-३-१०६-९", "content_sanskrit": "ज्येष्ठमासे सिते पक्षे तृतीयायां विशेषतः ।\nतत्र गत्वा तु यो भक्त्या पञ्चाग्निं साधयेत्ततः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004412009, "chapter_id": 24412, "verse_number": "५-३-१०६-१०", "content_sanskrit": "सोऽपि पापैरशेषैस्तु मुच्यते नात्र संशयः ।\nगुग्गुलं दहते यस्तु द्विधा चित्तविवर्जितः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004412010, "chapter_id": 24412, "verse_number": "५-३-१०६-११", "content_sanskrit": "शरीरं भेदयेद्यस्तु गौर्याश्चैव समीपतः ।\nतस्मिन्कर्मप्रविष्टस्य उत्क्रान्तिर्जायते यदि॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004412011, "chapter_id": 24412, "verse_number": "५-३-१०६-१२", "content_sanskrit": "देहपाते व्रजेत्स्वर्गमित्येवं शङ्करोऽब्रवीत् ।\nसितरक्तैस्तथा पीतैर्वस्त्रैश्च विविधैः शुभैः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004412012, "chapter_id": 24412, "verse_number": "५-३-१०६-१३", "content_sanskrit": "ब्राह्मणीं ब्राह्मणं चैव पूजयित्वा यथाविधि ।\nपुष्पैर्नानाविधैश्चैव गन्धधूपैः सुशोभनैः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004412013, "chapter_id": 24412, "verse_number": "५-३-१०६-१४", "content_sanskrit": "कण्ठसूत्रकसिन्दूरैः कुङ्कुमेन विलेपयेत् ।\nकल्पयेत स्त्रियं गौरीं ब्राह्मणं शिवरूपिणम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004412014, "chapter_id": 24412, "verse_number": "५-३-१०६-१५", "content_sanskrit": "तेषां तद्रूपकं कृत्वा दानमुत्सृज्यते ततः ।\nकङ्कणं कर्णवेष्टं च कण्ठिकां मुद्रिकां तथा॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004412015, "chapter_id": 24412, "verse_number": "५-३-१०६-१६", "content_sanskrit": "सप्तधान्यं तथा चैव भोजनं नृपसत्तम ।\nअन्यान्यपि च दानानि तस्मिंस्तीर्थे ददाति यः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004412016, "chapter_id": 24412, "verse_number": "५-३-१०६-१७", "content_sanskrit": "सर्वदानैश्च यत्पुण्यं प्राप्नुयान्नात्र संशयः ।\nसहस्रगुणितं सर्वं नात्र कार्या विचारणा॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004412017, "chapter_id": 24412, "verse_number": "५-३-१०६-१८", "content_sanskrit": "शङ्करेण समं तस्माद्भोगं भुङ्क्ते ह्यनुत्तमम् ।\nसौभाग्यं तस्य विपुलं जायते नात्र संशयः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004412018, "chapter_id": 24412, "verse_number": "५-३-१०६-१९", "content_sanskrit": "अपुत्रो लभते पुत्रमधनो धनमाप्नुयात् ।\nराजेन्द्र कामदं तीर्थं नर्मदायां व्यवस्थितम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]