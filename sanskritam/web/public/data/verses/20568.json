[{"id": 7000568000, "chapter_id": 20568, "verse_number": "५-२७-१", "content_sanskrit": "शेष उवाच ।\nचित्रांगः क्रौंचकंठस्थो रथस्थो वीरशोभितः ।\nगाहयामास तत्सैन्यं वाराह इव वारिधिम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000568001, "chapter_id": 20568, "verse_number": "५-२७-२", "content_sanskrit": "धनुर्विस्फार्य सुदृढं मेघनादनिनादितम् ।\nमुमोच बाणान्निशितान्वैरिकोटिविदाहकान् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000568002, "chapter_id": 20568, "verse_number": "५-२७-३", "content_sanskrit": "तद्बाणभिन्नसर्वांगाः शेरते सुभटा भृशम् ।\nसकिरीटतनुत्राणाः सन्दष्टदशनच्छदाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000568003, "chapter_id": 20568, "verse_number": "५-२७-४", "content_sanskrit": "एवं प्रवृत्ते संग्रामे ययौ योद्धुं स पुष्कलः ।\nमणिचित्रितमादाय चापं वैरिप्रतापनम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000568004, "chapter_id": 20568, "verse_number": "५-२७-५", "content_sanskrit": "तयोः संगतयोरूपं दृश्यतेऽतिमनोहरम् ।\nपुरा तारकसंग्रामे स्कंदतारकयोर्यथा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000568005, "chapter_id": 20568, "verse_number": "५-२७-६", "content_sanskrit": "विस्फारयन्धनुः शीघ्रं सव्यसाची तु पुष्कलः ।\nताडयामास तं क्षिप्रं शरैः सन्नतपर्वभिः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000568006, "chapter_id": 20568, "verse_number": "५-२७-७", "content_sanskrit": "चित्रांगोऽपि रुषाक्रांतः शरासन इषूञ्छितान् ।\nदधद्व्यमुंचद्बहुशो रणमंडलमूर्धनि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000568007, "chapter_id": 20568, "verse_number": "५-२७-८", "content_sanskrit": "नादानं न च संधानं न मोचनमथापि वा ।\nदृष्टं तावेव संदृष्टौ कुंडलीकृतचापिनौ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000568008, "chapter_id": 20568, "verse_number": "५-२७-९", "content_sanskrit": "तदासौ पुष्कलः क्रुद्धः शराणां शतकेन तम् ।\nविव्याध वक्षःस्थलके महायोद्धारमुद्भटम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000568009, "chapter_id": 20568, "verse_number": "५-२७-१०", "content_sanskrit": "चित्रांगस्ताञ्शरान्सर्वांश्चिच्छेद तिलशः क्षणात् ।\nताडयामास चांगेषु पुष्कलं शितसायकैः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000568010, "chapter_id": 20568, "verse_number": "५-२७-११", "content_sanskrit": "पुष्कलस्तद्रथं दिव्यं भ्रामकास्त्रेण शोभिना ।\nनभसि भ्रामयामास तदद्भुतमिवाभवत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000568011, "chapter_id": 20568, "verse_number": "५-२७-१२", "content_sanskrit": "भ्रांत्वा मुहूर्तमात्रं तु सरथो हयसंयुतः ।\nस्थितिर्लेभेतिकष्टेन संधृतो रणमंडले ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000568012, "chapter_id": 20568, "verse_number": "५-२७-१३", "content_sanskrit": "स चास्य विक्रमं दृष्ट्वा चित्रांगः कुपितो भृशम् ।\nउवाच पुष्कलं धीमान्सर्वास्त्रेषु विशारदः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000568013, "chapter_id": 20568, "verse_number": "५-२७-१४", "content_sanskrit": "चित्रांग उवाच ।\nत्वया साधुकृतं कर्म सुभटैर्युधिसंमतम् ।\nमद्रथो वाजिसंयुक्तो भ्रामितो नभसि क्षणम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000568014, "chapter_id": 20568, "verse_number": "५-२७-१५", "content_sanskrit": "पराक्रमं समीक्षस्व ममापि सुभटेरितम् ।\nआकाशचारी तु भवान्भवत्वमरपूजितः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000568015, "chapter_id": 20568, "verse_number": "५-२७-१६", "content_sanskrit": "इत्युक्त्वा स मुमोचास्त्रं रणे परमदारुणम् ।\nधनुषा परमास्त्रज्ञः सर्वधर्मविदुत्तमः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000568016, "chapter_id": 20568, "verse_number": "५-२७-१७", "content_sanskrit": "तेन बाणेन संविद्धः खे बभ्राम पतंगवत् ।\nसरथः सहयः संख्ये सध्वजश्च ससारथिः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000568017, "chapter_id": 20568, "verse_number": "५-२७-१८", "content_sanskrit": "भ्रांत्वा सरथवर्यस्तु नभसि त्वरयान्वितः ।\nयावत्स्थितिं न लभते तावन्मुक्तोऽपरः शरः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000568018, "chapter_id": 20568, "verse_number": "५-२७-१९", "content_sanskrit": "पुनश्च परिबभ्राम रथः सूतसमन्वितः ।\nतत्कर्मवीक्ष्य पुत्रस्य राज्ञो विस्मयमाप सः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000568019, "chapter_id": 20568, "verse_number": "५-२७-२०", "content_sanskrit": "कथंचित्स्थितिमप्याप पुष्कलः परवीरहा ।\nरथं जघान बाणैश्च ससूतहयमस्य च ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000568020, "chapter_id": 20568, "verse_number": "५-२७-२१", "content_sanskrit": "सभग्नस्यंदनो वीरः पुनरन्यं समाश्रितः ।\nसोऽपि भग्नः शरैराशु पुष्कलेन रणांगणे ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000568021, "chapter_id": 20568, "verse_number": "५-२७-२२", "content_sanskrit": "पुनरन्यं समास्थाय यावदायाति संमुखम् ।\nतावद्बभंज निशितैः सायकैस्तद्रथं पुनः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000568022, "chapter_id": 20568, "verse_number": "५-२७-२३", "content_sanskrit": "एवं दश रथा भग्ना नृपतेरात्मजस्य हि ।\nपुष्कलेन तु वीरेण महासंयुगशालिना ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000568023, "chapter_id": 20568, "verse_number": "५-२७-२४", "content_sanskrit": "तदा चित्रांगकः संख्ये रथे स्थित्वा विचित्रिते ।\nआजगाम ह वेगेन पुष्कलं प्रति योधितुम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000568024, "chapter_id": 20568, "verse_number": "५-२७-२५", "content_sanskrit": "पुष्कलं पंचभिर्बाणैस्ताडयामास संयुगे ।\nतैर्बाणैर्निहतोऽत्यतं विव्यथे भरतात्मजः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000568025, "chapter_id": 20568, "verse_number": "५-२७-२६", "content_sanskrit": "सक्रुद्धश्चापमुद्यम्य बाणान्दश शितान्महान् ।\nमुमोच हृदये तस्य स्वर्णपुंखसुशोभितान् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000568026, "chapter_id": 20568, "verse_number": "५-२७-२७", "content_sanskrit": "ते बाणाः पपुरेतस्य रुधिरं बहुदारुणाः ।\nपीत्वा पेतुः क्षितौ कूटसाक्षिणः पूर्वजा इव ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000568027, "chapter_id": 20568, "verse_number": "५-२७-२८", "content_sanskrit": "तदा चित्रांगकः क्रुद्धो भल्लान्पंच समाददे ।\nमुमोच भाले पुत्रस्य भरतस्य महौजसः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000568028, "chapter_id": 20568, "verse_number": "५-२७-२९", "content_sanskrit": "तैर्भल्लैराहतः क्रुद्धः शरासनवरे शरम् ।\nदधत्प्रतिज्ञामकरोच्चित्रांगनिधनं प्रति ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000568029, "chapter_id": 20568, "verse_number": "५-२७-३०", "content_sanskrit": "शृणु वीर मम क्षिप्रं प्रतिज्ञां त्वद्वधाश्रिताम् ।\nतज्ज्ञात्वा सावधानेन योद्धव्यं च त्वयात्र हि ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000568030, "chapter_id": 20568, "verse_number": "५-२७-३१", "content_sanskrit": "बाणेनानेन चेत्त्वां वै न कुर्यां प्राणवर्जितम् ।\nसतीं संदूष्य वनितां शीलाचारसुशोभिताम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000568031, "chapter_id": 20568, "verse_number": "५-२७-३२", "content_sanskrit": "यो लोकः प्राप्यते लोकैर्यमस्य वशवर्तिभिः ।\nस लोको मम वै भूयात्सत्यं मम प्रतिश्रुतम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000568032, "chapter_id": 20568, "verse_number": "५-२७-३३", "content_sanskrit": "इति श्रेष्ठं वचः श्रुत्वा जहास परवीरहा ।\nउवाच मतिमान्वीरः पुष्कलं वचनं शुभम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000568033, "chapter_id": 20568, "verse_number": "५-२७-३४", "content_sanskrit": "मृत्युर्वै प्राणिनां भाव्यः सर्वत्रैव च सर्वदा ।\nतस्मान्मे निधने दुःखं नास्ति शूरशिरोमणे ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000568034, "chapter_id": 20568, "verse_number": "५-२७-३५", "content_sanskrit": "प्रतिज्ञा या कृता वीर त्वया वीरत्वशालिना ।\nसा सत्यैव पुनर्मेऽद्य श्रूयतां व्याहृतं महत् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000568035, "chapter_id": 20568, "verse_number": "५-२७-३६", "content_sanskrit": "त्वद्बाणं मद्वधोद्युक्तं न च्छिंद्यां यदि चेदहम् ।\nतदा प्रतिज्ञां शृणु मे सर्ववीराभिमानिनः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000568036, "chapter_id": 20568, "verse_number": "५-२७-३७", "content_sanskrit": "तीर्थं जिगमिषोर्यो वै कुर्यात्स्वांतविखंडनम् ।\nएकादशीव्रतादन्यज्जानाति व्रतमुच्चकैः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000568037, "chapter_id": 20568, "verse_number": "५-२७-३८", "content_sanskrit": "तस्य पापं ममैवास्तु प्रतिज्ञापरिघातिनः ।\nइति वाक्यमुदीर्यैव तूष्णींभूतो धनुर्दधे ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000568038, "chapter_id": 20568, "verse_number": "५-२७-३९", "content_sanskrit": "तदानेन निषंगात्स्वादुद्धृत्य सायकं वरम् ।\nकथयामास विशदं वाक्यं शत्रुवधावहम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000568039, "chapter_id": 20568, "verse_number": "५-२७-४०", "content_sanskrit": "पुष्कल उवाच ।\nयदि रामांघ्रियुगुलं निष्कापट्येन चेतसा ।\nउपासितं मया तर्हि मम वाक्यमृतं भवेत् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000568040, "chapter_id": 20568, "verse_number": "५-२७-४१", "content_sanskrit": "यदि स्वमहिलां भुक्त्वा नान्यां जानामिचेतसा ।\nतेन सत्येन मे वाक्यं सत्यं भवतु संगरे ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000568041, "chapter_id": 20568, "verse_number": "५-२७-४२", "content_sanskrit": "इति वाक्यमुदीर्याशु बाणं धनुषि संधितम् ।\nकालानलोपमं वीरशिरश्छेदनमाक्षिपत् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000568042, "chapter_id": 20568, "verse_number": "५-२७-४३", "content_sanskrit": "तं बाणं मुक्तमालोक्य स तु राजसुतो बली ।\nबाणं शरासने धत्त तीक्ष्णं कालानलोपमम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000568043, "chapter_id": 20568, "verse_number": "५-२७-४४", "content_sanskrit": "तेन बाणेन संछिन्नो बाणः स्ववधौद्यतः ।\nहाहाकारो महानासीच्छिन्ने तस्मिञ्छरे तदा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000568044, "chapter_id": 20568, "verse_number": "५-२७-४५", "content_sanskrit": "परार्धं पतितं भूमौ पूर्वार्धं फलसंयुतम् ।\nशिरोधरां चकर्ताशु पद्मनालमिव क्षणात् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000568045, "chapter_id": 20568, "verse_number": "५-२७-४६", "content_sanskrit": "तदा भूमौ पतंतं तु दृष्ट्वा तत्तस्यसैनिकाः ।\nहाहाकृत्वा भृशं सर्वे पलायनपरागताः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000568046, "chapter_id": 20568, "verse_number": "५-२७-४७", "content_sanskrit": "पृथ्व्यां तन्मस्तकं श्रेष्ठं सकिरीटं सकुंडलम् ।\nशुशुभेऽतीव पतितं चंद्रबिंबं दिवो यथा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000568047, "chapter_id": 20568, "verse_number": "५-२७-४८", "content_sanskrit": "तं वीक्ष्य पतितं वीरः पुष्कलो भरतात्मजः ।\nव्यगाहत व्यूहमिमं सर्ववीरैकशोभितम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]