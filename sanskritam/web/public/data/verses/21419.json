[{"id": 7001419000, "chapter_id": 21419, "verse_number": "६-१५-१", "content_sanskrit": "ईश्वर उवाच ।\nततः परं प्रवक्ष्यामि सृष्टिपद्धतिमुत्तमाम् ।\nसदाशिवान्महेशादिचतुष्कस्य वरानने॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001419001, "chapter_id": 21419, "verse_number": "६-१५-२", "content_sanskrit": "सदाशिवस्समष्टिस्स्यादाकाशधिपतिः प्रभुः ।\nअस्यैव व्यष्टितापन्नम्महेशादिचतुष्टयम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001419002, "chapter_id": 21419, "verse_number": "६-१५-३", "content_sanskrit": "सदाशिवसहस्रांशान्महेशस्य समुद्भवः ।\nपुरुषाननरूपत्वाद्वायोरधिपतिश्च सः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001419003, "chapter_id": 21419, "verse_number": "६-१५-४", "content_sanskrit": "मायाशक्तियुतो वामे सकलश्च क्रियाधिकः ।\nअस्यैव व्यष्टिरूपं स्यादीश्वरादिचतुष्टयम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001419004, "chapter_id": 21419, "verse_number": "६-१५-५", "content_sanskrit": "ईशो विश्वेश्वरः पश्चात्परमेशस्ततः परम् ।\nसर्वेश्वर इतीदन्तु तिरोधाचक्रमुत्तमम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001419005, "chapter_id": 21419, "verse_number": "६-१५-६", "content_sanskrit": "तिरोभावो द्विधा भिन्न एको रुद्रादिगोचरः ।\nअन्यश्च देहभावेन पशुवर्गस्य सन्ततेः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001419006, "chapter_id": 21419, "verse_number": "६-१५-७", "content_sanskrit": "भोगानुरंजनपरः कर्मसाम्यक्षणावधि ।\nकर्मसाम्ये स एकः स्यादनुग्रहमयो विभुः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001419007, "chapter_id": 21419, "verse_number": "६-१५-८", "content_sanskrit": "तत्र सर्वेश्वरा यास्ते देवताः परिकीर्त्तिताः ।\nपरब्रह्मात्मकाः साक्षान्निर्विकल्पा निरामयाः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001419008, "chapter_id": 21419, "verse_number": "६-१५-९", "content_sanskrit": "तिरोभावात्मकं चक्रं भवेच्छान्तिकलामयम् ।\nमहेश्वराधिष्ठितं च पदमेतदनुत्तमम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001419009, "chapter_id": 21419, "verse_number": "६-१५-१०", "content_sanskrit": "एतदेव पदं प्राप्यं महेशपदसेविनाम् ।\nमाहेश्वराणां सालोक्यक्रमादेव विमुक्तिदम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001419010, "chapter_id": 21419, "verse_number": "६-१५-११", "content_sanskrit": "महेश्वरसहस्रांशाद्रुद्रमूर्तिरजायत ।\nअघोरवदनाकारस्तेजस्तत्त्वाधिपश्च सः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001419011, "chapter_id": 21419, "verse_number": "६-१५-१२", "content_sanskrit": "गौरीशक्तियुतो वामे सर्व्वसंहारकृत्प्रभुः ।\nअस्यैव व्यष्टिरूपं स्याच्छिवाद्यथ चतुष्टयम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001419012, "chapter_id": 21419, "verse_number": "६-१५-१३", "content_sanskrit": "शिवो हरो मृडभवौ विदितं चक्रमद्भुतम् ।\nसंहाराख्यं महादिव्यं परमं हि मुनीश्वर॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001419013, "chapter_id": 21419, "verse_number": "६-१५-१४", "content_sanskrit": "स संहारस्त्रिधा प्रोक्तो बुधैर्नित्यादिभेदतः ।\nनित्यो जीवसुषुप्त्याख्यो विधेर्नैमित्तिकः स्मृतः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001419014, "chapter_id": 21419, "verse_number": "६-१५-१५", "content_sanskrit": "विलयस्तस्य तु महानिति वेदनिदर्शितः ।\nजीवानां जन्मदुःखादिशांतानामुषितात्मनाम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001419015, "chapter_id": 21419, "verse_number": "६-१५-१६", "content_sanskrit": "विश्रांत्यर्थं मुनिश्रेष्ठ कर्मणां पाकहेतवे ।\nसंहारः कल्पितस्त्रेधा रुद्रेणामिततेजसा॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001419016, "chapter_id": 21419, "verse_number": "६-१५-१७", "content_sanskrit": "रुद्रस्यैव तु कृत्यानां त्रयमेतदुदाहृतम् ।\nसंहृतवपि सृष्ट्यादिकृत्यानां पञ्चकं विभोः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001419017, "chapter_id": 21419, "verse_number": "६-१५-१८", "content_sanskrit": "मुने तत्र भवाद्यास्ते देवताः परिकीर्त्तिताः ।\nपरब्रह्मस्वरूपाश्च लोकानुग्रहकारकाः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001419018, "chapter_id": 21419, "verse_number": "६-१५-१९", "content_sanskrit": "संहाराख्यमिदं चक्रं विद्यारूपकलामयम् ।\nअधिष्ठितं च रुद्रेण पदमेतन्निरामयम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001419019, "chapter_id": 21419, "verse_number": "६-१५-२०", "content_sanskrit": "एतदेव पदं प्राप्यं रुद्राराधनकांक्षिणाम् ।\nरुद्राणां तद्धि सालोक्यक्रमात्सायुज्यदम्मुने॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001419020, "chapter_id": 21419, "verse_number": "६-१५-२१", "content_sanskrit": "रुद्रमूर्त्तेस्सहस्रांशाद्विष्णोश्चैवाभवज्जनिः ।\nस वामदेवचक्रात्मा वारितत्त्वैकनायकः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001419021, "chapter_id": 21419, "verse_number": "६-१५-२२", "content_sanskrit": "रमाशाक्तियुतो वामे सर्व्वरक्षाकरो महान् ।\nचतुर्भुजोऽरविंदाक्षः श्यामश्शंखादिचिह्नभृत्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001419022, "chapter_id": 21419, "verse_number": "६-१५-२३", "content_sanskrit": "अस्यैव वासुदेवादिचतुष्कं व्यष्टितां गतम् ।\nउपासनरतानां वै वैष्णवानां विमुक्तिदम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001419023, "chapter_id": 21419, "verse_number": "६-१५-२४", "content_sanskrit": "वासुदेवोऽनिरुद्धश्च ततस्संकर्षणः परः ।\nप्रद्युम्नश्चेति विख्यातं स्थितिचक्रमनुत्तमम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001419024, "chapter_id": 21419, "verse_number": "६-१५-२५", "content_sanskrit": "स्थितिस्सृष्टस्य जगतस्तत्कर्त्रा सह पालनम् ।\nआरब्धकर्मभोगान्तं जीवानां फलभोगिनाम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001419025, "chapter_id": 21419, "verse_number": "६-१५-२६", "content_sanskrit": "विष्णोरेवेदमाख्यातं कृत्यं रक्षाविधायिनः ।\nस्थितावपि तु सृष्ट्यादि कृत्यानां पंचकं विभोः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001419026, "chapter_id": 21419, "verse_number": "६-१५-२७", "content_sanskrit": "तत्र प्रद्युम्नमुख्यास्ते देवताः परिकीर्तिताः ।\nनिर्विकल्पा निरातंका मुक्तानंदकरास्सदा॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001419027, "chapter_id": 21419, "verse_number": "६-१५-२८", "content_sanskrit": "स्थितिचक्रमिदं ब्रह्मन्प्रतिष्ठारूपमुत्तमम् ।\nजनार्दनाधिष्ठितं च परमं पदमुच्यते॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001419028, "chapter_id": 21419, "verse_number": "६-१५-२९", "content_sanskrit": "एवदेव पदं प्राप्यं विष्णुपादाब्जसेविनाम् ।\nवैष्णवानां चक्रमिदं सालोक्यादिपदप्रदम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001419029, "chapter_id": 21419, "verse_number": "६-१५-३०", "content_sanskrit": "विष्णोरेव सहस्रांशात्संबभूव पितामहः ।\nसद्योजातमुखात्मा यः पृथिवीतत्त्वनायकः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001419030, "chapter_id": 21419, "verse_number": "६-१५-३१", "content_sanskrit": "वाग्देवीसहितो वामे सृष्टिकर्त्ता जगत्प्रभुः ।\nचतुर्मुखो रक्तवर्णो रजोरूपस्वरूपवान्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001419031, "chapter_id": 21419, "verse_number": "६-१५-३२", "content_sanskrit": "हिण्यगर्भाद्यस्यैव व्यष्टिरूपं चतुष्टयम् ।\nहिरण्यगर्भोथ विराट् पुरुषः काल एव च॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001419032, "chapter_id": 21419, "verse_number": "६-१५-३३", "content_sanskrit": "सृष्टि चक्रमिदं ब्रह्म पुत्रादिऋषिसेवितम् ।\nसर्व्वकामार्थदं ब्रह्मन्परिवारसुखप्रदम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001419033, "chapter_id": 21419, "verse_number": "६-१५-३४", "content_sanskrit": "सृष्टिस्तु संहृतस्यास्य जीवस्य प्रकृतौ बहिः ।\nआनीय कर्मभोगार्थ साधनांगफलैस्सह॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001419034, "chapter_id": 21419, "verse_number": "६-१५-३५", "content_sanskrit": "संयोजनमितीदं तु कृत्यं पैतामहं विदुः ।\nजगत्सृष्टिक्रियाविज्ञा यावद्व्यूहं सुखावहम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001419035, "chapter_id": 21419, "verse_number": "६-१५-३६", "content_sanskrit": "जगत्सृष्टावपि मुने कृत्यानां च पंचकं विभोः ।\nअस्ति कालोदयस्तत्र देवताः परिकीर्त्तिताः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001419036, "chapter_id": 21419, "verse_number": "६-१५-३७", "content_sanskrit": "निवृत्तिरूपमाख्यातं सृष्टिचक्रमिदं बुधैः ।\nपितामहाधिष्ठितं च पदमेतद्धि शोभनम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001419037, "chapter_id": 21419, "verse_number": "६-१५-३८", "content_sanskrit": "एतदेव प्रदं प्राप्यं ब्रह्मार्पितधियां नृणाम् ।\nपैतामहानामेतद्धि सालोक्या दिविमुक्तिदम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001419038, "chapter_id": 21419, "verse_number": "६-१५-३९", "content_sanskrit": "अस्मिन्नपि चतुष्के तु चक्राणां प्रणवो भवेत् ।\nमहेशादिक्रमादेव गौण्या वृत्त्या स वाचकः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001419039, "chapter_id": 21419, "verse_number": "६-१५-४०", "content_sanskrit": "इदं खलु जगच्चक्रं श्रुतिविश्रुतवैभवम् ।\nपञ्चारं चक्रमिति ह स्तौति श्रुतिरिदम्मुने॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001419040, "chapter_id": 21419, "verse_number": "६-१५-४१", "content_sanskrit": "एकमेव जगच्चक्रं शम्भोश्शक्तिविजृंभितम् ।\nसृष्ट्यादिपंचांवयवं पंचारमिति कथ्यते॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001419041, "chapter_id": 21419, "verse_number": "६-१५-४२", "content_sanskrit": "अलातचक्रभ्रमिवदविच्छिन्नलयोदयम् ।\nपरितो वर्तते यस्मात्तस्माच्चक्रमितीरितम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001419042, "chapter_id": 21419, "verse_number": "६-१५-४३", "content_sanskrit": "सृष्ट्यादिपृथुसृष्टित्वात्पृथुत्वेनोपदृश्यते ।\nहिरण्मयस्य देवस्य शम्भोरमिततेजसः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001419043, "chapter_id": 21419, "verse_number": "६-१५-४४", "content_sanskrit": "शक्तिकार्यमिदं चक्रं हिरण्यज्योतिराश्रितम् ।\nसलिलेनावृतमिदं सलिलं वह्निनावृतम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001419044, "chapter_id": 21419, "verse_number": "६-१५-४५", "content_sanskrit": "आवृतो वायुना वह्निराकाशेनावृतं महत् ।\nभूतादिना तथाकाशो भूतादिर्महतावृतः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001419045, "chapter_id": 21419, "verse_number": "६-१५-४६", "content_sanskrit": "अव्यक्तेनावृतस्तद्वन्महानित्येवमास्तिकैः ।\nब्रह्माण्डमिति संप्रोक्तमाचार्य्यैर्मुनिसत्तम॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001419046, "chapter_id": 21419, "verse_number": "६-१५-४७", "content_sanskrit": "उक्तानि सप्तावरणान्यस्य विश्वस्य गुप्तये ।\nचक्राद्दशगुणाधिक्यं सलिलस्य विधीयते॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001419047, "chapter_id": 21419, "verse_number": "६-१५-४८", "content_sanskrit": "उपर्युपरि चान्योन्यमेवं दशगुणाधिकम् ।\nब्रह्माण्डमिति विज्ञेयं तद्द्विजैर्मुनिनायक॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001419048, "chapter_id": 21419, "verse_number": "६-१५-४९", "content_sanskrit": "इममर्थमुरीकृत्य चक्रसामीप्यवर्त्तनात् ।\nसलिलस्य च तन्मध्ये इति प्राह श्रुतिस्स्वयम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001419049, "chapter_id": 21419, "verse_number": "६-१५-५०", "content_sanskrit": "अनुग्रहतिरोभावसंहृतिस्थितिसृष्टिभिः ।\nकरोत्यविरतं लीलामेकश्शक्तियुतश्शिवः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001419050, "chapter_id": 21419, "verse_number": "६-१५-५१", "content_sanskrit": "बहुनेह किमुक्तेन मुने सारं वदामि ते ।\nशिव एवेदमखिलं शक्तिमानिति निश्चितम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]