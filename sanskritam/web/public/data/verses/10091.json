[{"id": 6000091000, "chapter_id": 10091, "verse_number": null, "content_sanskrit": "अथ सप्तविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000091001, "chapter_id": 10091, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_027/BhP_04.027.001.m4a", "display_order": 2}, {"id": 6000091002, "chapter_id": 10091, "verse_number": "४-२७-१", "content_sanskrit": "इत्थं पुरञ्जनं सध्र्यग् वशमानीय विभ्रमैः।\nपुरञ्जनी महाराज रेमे रमयती पतिम्॥ ४/२७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_027/BhP_04.027.002.m4a", "display_order": 3, "topics": [{"text": "महिष्या रममाणस्य भगवन्तं विस्मृतवतः पुरञ्‍जनस्य जराप्राप्तिः", "range": "१–११"}]}, {"id": 6000091003, "chapter_id": 10091, "verse_number": "४-२७-२", "content_sanskrit": "स राजा महिषीं राजन् रुचिराम्बरसंवृताम्।\nकृतस्वस्त्ययनां तृप्तामभ्यनन्ददुपागताम्॥ ४/२७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_027/BhP_04.027.003.m4a", "display_order": 4}, {"id": 6000091004, "chapter_id": 10091, "verse_number": "४-२७-३", "content_sanskrit": "तयोपगूढः परिरब्धकन्धरो रहोऽनुमन्त्रैरपकृष्टचेतनः।\nन कालरंहो बुबुधे दुरत्ययं दिवा निशेति प्रमदापरिग्रहः॥ ४/२७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_027/BhP_04.027.004.m4a", "display_order": 5}, {"id": 6000091005, "chapter_id": 10091, "verse_number": "४-२७-४", "content_sanskrit": "शयान उन्नद्धमदो महामना महार्हतल्पे महिषीभुजोपधे।\nतामेव वीरोऽमनुत व्यवायतस्तमोऽभिभूतो न निजं परं हि तत्॥ ४/२७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_027/BhP_04.027.005.m4a", "display_order": 6}, {"id": 6000091006, "chapter_id": 10091, "verse_number": "४-२७-५", "content_sanskrit": "तस्यैवं रममाणस्य कामकश्मलचेतसः।\nक्षणार्धमिव राजेन्द्र व्यतिक्रान्तं नवं वयः॥ ४/२७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_027/BhP_04.027.006.m4a", "display_order": 7}, {"id": 6000091007, "chapter_id": 10091, "verse_number": "४-२७-६", "content_sanskrit": "तस्यामजनयत् पुत्रान् पुरञ्जन्यां पुरञ्जनः।\nशतान्येकादश विराडायुषोऽर्धमथात्यगात्॥ ४/२७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_027/BhP_04.027.007.m4a", "display_order": 8}, {"id": 6000091008, "chapter_id": 10091, "verse_number": "४-२७-७", "content_sanskrit": "दुहितॄर्दशोत्तरशतं पितृभ्रातृयशस्करीः।\nशीलौदार्यगुणोपेताः पौरञ्जन्यः प्रजापते॥ ४/२७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_027/BhP_04.027.008.m4a", "display_order": 9}, {"id": 6000091009, "chapter_id": 10091, "verse_number": "४-२७-८", "content_sanskrit": "स पाञ्चालपतिः पुत्रान् पितृवंशविवर्धनान्।\nदारैः संयोजयामास दुहितॄः सदृशैर्वरैः॥ ४/२७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_027/BhP_04.027.009.m4a", "display_order": 10}, {"id": 6000091010, "chapter_id": 10091, "verse_number": "४-२७-९", "content_sanskrit": "पुत्राणां चाभवन् पुत्रा एकैकस्य शतं शतम्।\nयैर्वै पौरञ्जनो वंशः पाञ्चालेषु समेधितः॥ ४/२७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_027/BhP_04.027.010.m4a", "display_order": 11}, {"id": 6000091011, "chapter_id": 10091, "verse_number": "४-२७-१०", "content_sanskrit": "तेषु तद्रिक्थहारेषु गृहकोशानुजीविषु।\nनिगूढेन ममत्वेन विषयेष्वन्वबध्यत॥ ४/२७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_027/BhP_04.027.011.m4a", "display_order": 12}, {"id": 6000091012, "chapter_id": 10091, "verse_number": "४-२७-११", "content_sanskrit": "ईजे च क्रतुभिर्विप्रैर्दीक्षितः पशुमारकैः।\nदेवान् पितॄन् भूतपतीन् नानाकामो यथा भवान्॥ ४/२७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_027/BhP_04.027.012.m4a", "display_order": 13}, {"id": 6000091013, "chapter_id": 10091, "verse_number": "४-२७-१२", "content_sanskrit": "युक्तेष्वेवं प्रमत्तस्य कुटुम्बासक्तचेतसः।\nआससाद स वै कालो योऽप्रियः प्रिययोषिताम्॥ ४/२७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_027/BhP_04.027.013.m4a", "display_order": 14, "topics": [{"text": "पुरञ्जनस्य अन्त्यकालः", "range": "१२–३०"}]}, {"id": 6000091014, "chapter_id": 10091, "verse_number": "४-२७-१३", "content_sanskrit": "चण्डवेग इति ख्यातो गन्धर्वाधिपतिर्नृप।\nगन्धर्वास्तस्य बलिनः षष्ट्युत्तरशतत्रयम्॥ ४/२७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_027/BhP_04.027.014.m4a", "display_order": 15}, {"id": 6000091015, "chapter_id": 10091, "verse_number": "४-२७-१४", "content_sanskrit": "गन्धर्व्यस्तावतीरस्य मैथुन्यश्च सितासिताः।\nपरिवृत्त्या विलुम्पन्ति सर्वकामान् विनिर्मितान्॥ ४/२७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_027/BhP_04.027.015.m4a", "display_order": 16}, {"id": 6000091016, "chapter_id": 10091, "verse_number": "४-२७-१५", "content_sanskrit": "ते चण्डवेगानुचराः पुरञ्जनपुरीं यदा।\nहर्तुमारेभिरे तत्र प्रत्यषेधत् प्रजागरः॥ ४/२७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_027/BhP_04.027.016.m4a", "display_order": 17}, {"id": 6000091017, "chapter_id": 10091, "verse_number": "४-२७-१६", "content_sanskrit": "स सप्तभिः शतैरेको विंशकेन शतं समाः।\nपुरञ्जनपुराध्यक्षो गन्धर्वैर्युयुधे बली॥ ४/२७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_027/BhP_04.027.017.m4a", "display_order": 18}, {"id": 6000091018, "chapter_id": 10091, "verse_number": "४-२७-१७", "content_sanskrit": "क्षीयमाणे स्वसामर्थ्ये एकस्य बहुभिर्युधि।\nचिन्तां परां जगामार्तः सराष्ट्रपुरबान्धवः॥ ४/२७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_027/BhP_04.027.018.m4a", "display_order": 19}, {"id": 6000091019, "chapter_id": 10091, "verse_number": "४-२७-१८", "content_sanskrit": "स एव पुर्यां मधुभुक् पाञ्चालेषु स्वपार्षदैः।\nउपनीतं बलिं गृह्णन् स्‍त्रीजितो नाविदद् भयम्॥ ४/२७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_027/BhP_04.027.019.m4a", "display_order": 20}, {"id": 6000091020, "chapter_id": 10091, "verse_number": "४-२७-१९", "content_sanskrit": "कालस्य दुहिता काचित् त्रिलोकीं वरमिच्छती।\nपर्यटन्ती, न बर्हिष्मन् प्रत्यनन्दत कश्चन॥ ४/२७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_027/BhP_04.027.020.m4a", "display_order": 21}, {"id": 6000091021, "chapter_id": 10091, "verse_number": "४-२७-२०", "content_sanskrit": "दौर्भाग्येनात्मनो लोके विश्रुता दुर्भगेति सा।\nयां तुष्टो राजऋषये पिताऽदात् पूरवे वरम्॥ ४/२७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_027/BhP_04.027.021.m4a", "display_order": 22}, {"id": 6000091022, "chapter_id": 10091, "verse_number": "४-२७-२१", "content_sanskrit": "कदाचिदटमाना सा ब्रह्मलोकान्महीं गतम्।\nवव्रे बृहद्व्रतं मां तु जानन्ती काममोहिता॥ ४/२७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_027/BhP_04.027.022.m4a", "display_order": 23}, {"id": 6000091023, "chapter_id": 10091, "verse_number": "४-२७-२२", "content_sanskrit": "मयि संरभ्य विपुलमदाच्छापं सुदुःसहम्।\nस्थातुमर्हसि नैकत्र मद्याच्ञाविमुखो मुने॥ ४/२७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_027/BhP_04.027.023.m4a", "display_order": 24}, {"id": 6000091024, "chapter_id": 10091, "verse_number": "४-२७-२३", "content_sanskrit": "ततो विहतसङ्कल्पा कन्यका यवनेश्वरम्।\nमयोपदिष्टमासाद्य वव्रे नाम्ना भयं पतिम्॥ ४/२७/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_027/BhP_04.027.024.m4a", "display_order": 25}, {"id": 6000091025, "chapter_id": 10091, "verse_number": "४-२७-२४", "content_sanskrit": "ऋषभं यवनानां त्वां वृणे वीरेप्सितं पतिम्।\nसङ्कल्पस्त्वयि भूतानां कृतः किल न रिष्यति॥ ४/२७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_027/BhP_04.027.025.m4a", "display_order": 26}, {"id": 6000091026, "chapter_id": 10091, "verse_number": "४-२७-२५", "content_sanskrit": "द्वाविमावनुशोचन्ति बालावसदवग्रहौ।\nयल्लोकशास्‍त्रोपनतं न राति न तदिच्छति॥ ४/२७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_027/BhP_04.027.026.m4a", "display_order": 27}, {"id": 6000091027, "chapter_id": 10091, "verse_number": "४-२७-२६", "content_sanskrit": "अथो भजस्व मां भद्र भजतीं मे दयां कुरु।\nएतावान् पौरुषो धर्मो यदार्ताननुकम्पते॥ ४/२७/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_027/BhP_04.027.027.m4a", "display_order": 28}, {"id": 6000091028, "chapter_id": 10091, "verse_number": "४-२७-२७", "content_sanskrit": "कालकन्योदितां वाचं निशम्य यवनेश्वरः।\nचिकीर्षुर्देवगुह्यं स सस्मितं तामभाषत॥ ४/२७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_027/BhP_04.027.028.m4a", "display_order": 29}, {"id": 6000091029, "chapter_id": 10091, "verse_number": "४-२७-२८", "content_sanskrit": "मया निरूपितस्तुभ्यं पतिरात्मसमाधिना।\nनाभिनन्दति लोकोऽयं त्वामभद्रामसम्मताम्॥ ४/२७/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_027/BhP_04.027.029.m4a", "display_order": 30}, {"id": 6000091030, "chapter_id": 10091, "verse_number": "४-२७-२९", "content_sanskrit": "त्वमज्ञातमतिर्भुङ्क्ष्व लोकं कर्मविनिर्मितम्।\nयाहि मे पृतनायुक्ता प्रज्वरस्त्वां प्रणेष्यति॥ ४/२७/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_027/BhP_04.027.030.m4a", "display_order": 31}, {"id": 6000091031, "chapter_id": 10091, "verse_number": "४-२७-३०", "content_sanskrit": "प्रज्वारोऽयं मम भ्राता त्वं च मे भगिनी भव।\nचराम्युभाभ्यां लोकेऽस्मिन्नव्यक्तो भीमसैनिकः॥ ४/२७/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_027/BhP_04.027.031.m4a", "display_order": 32}, {"id": 6000091032, "chapter_id": 10091, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां चतुर्थस्कन्धे सप्तविंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]