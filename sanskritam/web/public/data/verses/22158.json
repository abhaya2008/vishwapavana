[{"id": 7002158000, "chapter_id": 22158, "verse_number": "२०३-१", "content_sanskrit": "अग्निरुवाच ।\nपुष्पाद्यैः पूजनाद्विष्णोर्न याति नरकान्दवे ।\nआयुषोऽन्ते नरः प्राणैरनिच्छन्नपि मुच्यते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002158001, "chapter_id": 22158, "verse_number": "२०३-२", "content_sanskrit": "जलमग्निर्विषं शस्त्रं क्षुद्व्याधिः पतनं गिरेः ।\nनिमित्तं किञ्चिदासाद्य देही प्राणैर्विमुच्यते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002158002, "chapter_id": 22158, "verse_number": "२०३-३", "content_sanskrit": "अन्यच्छरीरमादत्ते यातनीयं स्वकर्मभिः ।\nभुङ्क्तेऽथ पापकृत्दुःखं सुखं धर्माय सङ्गतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002158003, "chapter_id": 22158, "verse_number": "२०३-४", "content_sanskrit": "नीयते यमदूतैस्तु यमं प्राणिभयङ्करैः ।\nकुपथे दक्षिणद्वारि धर्मिकः पश्चिमादिभिः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002158004, "chapter_id": 22158, "verse_number": "२०३-५", "content_sanskrit": "यमाज्ञप्तैः किङ्करैस्तु पात्यते नरकेषु च ।\nस्वर्गे तु नीयते धर्माद्वसिष्ठाद्युक्तिसंश्रयात् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002158005, "chapter_id": 22158, "verse_number": "२०३-६", "content_sanskrit": "गोघाती तु महावीच्यां वर्षलक्षन्तु पीड्यते ।\nआमकुम्भे महादीप्ते ब्रह्महा भूमिहारकः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002158006, "chapter_id": 22158, "verse_number": "२०३-७", "content_sanskrit": "महाप्रलयकं यावद्रौरवे पीड्यते शनैः ।\nस्त्रीबालवृद्धहन्ता तु यावदिन्द्राश्चतुर्दश ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002158007, "chapter_id": 22158, "verse_number": "२०३-८", "content_sanskrit": "महारौरवके रौद्रे गृहक्षेत्रादिदीपकः ।\nदह्यते कल्पमेकं स चौरस्तामिस्रके पतेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002158008, "chapter_id": 22158, "verse_number": "२०३-९", "content_sanskrit": "नैककल्पन्तु शूलाद्यैर्भिद्यते यमकिङ्करैः ।\nमहातामिस्रके सर्पजलौकाद्यैश्च पीड्यते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002158009, "chapter_id": 22158, "verse_number": "२०३-१०", "content_sanskrit": "यावद्भूमिर्मातृहाद्या असिपत्रवनेऽसिभिः ।\nनैककल्पन्तु नरके करम्भवालुकासु च ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002158010, "chapter_id": 22158, "verse_number": "२०३-११", "content_sanskrit": "येन दग्धो जनस्तत्र दह्यते वालुकादिभिः ।\nकाकोले कृमिविष्ठाशी एकाकी मिष्टभोजनः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002158011, "chapter_id": 22158, "verse_number": "२०३-१२", "content_sanskrit": "कुट्टले मूत्ररक्ताशी पञ्चयज्ञक्रियोज्झितः ।\nसुदुर्गन्धे रक्तभोजी भवेच्चाभक्ष्यभक्ष्यकः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002158012, "chapter_id": 22158, "verse_number": "२०३-१३", "content_sanskrit": "तैलपाके तु तिलवत्पीड्यते परपीडकः ।\nतैलपाके तु पच्येत शरणागतघातकः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002158013, "chapter_id": 22158, "verse_number": "२०३-१४", "content_sanskrit": "निरुच्छासे दाननाशी रसविक्रयकोऽध्वरे ।\nनाम्ना वज्रकवाटेन महापाते तदानृती ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002158014, "chapter_id": 22158, "verse_number": "२०३-१५", "content_sanskrit": "महाज्वाले पापबुद्धिः क्रकचेऽगम्यगामिनः ।\nसङ्करी गुडपाके च प्रतुदेत्परमर्मनुत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002158015, "chapter_id": 22158, "verse_number": "२०३-१६", "content_sanskrit": "क्षारह्रदे प्राणिहन्ता क्षुरधारे च भूमिहृत् ।\nअम्बरीषे गोस्वर्णहृद्द्रुमच्छिद्वज्रशस्त्रके ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002158016, "chapter_id": 22158, "verse_number": "२०३-१७", "content_sanskrit": "मधुहर्ता परीतापे कालसूत्रे परार्थहृत् ।\nकश्मलेऽत्यन्तमांसाशी उग्रगन्धे ह्यपिण्डदः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002158017, "chapter_id": 22158, "verse_number": "२०३-१८", "content_sanskrit": "दुर्धरे तु काचभक्षी वन्दिग्राहरताश्च ये ।\nमञ्जुषे नरके लोहेऽप्रतिष्ठे श्रुतिनिन्दकः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002158018, "chapter_id": 22158, "verse_number": "२०३-१९", "content_sanskrit": "पूतिवक्त्रे कूटसाक्षी परिलुण्ठे धनापहा ।\nबालस्त्रीवृद्धघाती च कराले ब्राह्मणार्तिकृत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002158019, "chapter_id": 22158, "verse_number": "२०३-२०", "content_sanskrit": "विलेपे मद्यपो विप्रो महाताम्रे तु मेदिनः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002158020, "chapter_id": 22158, "verse_number": "२०३-२१", "content_sanskrit": "तथाक्रम्य पारदारान् ज्वलन्तीमायसीं शिलां ।\nशाल्मलाख्ये तमालिङ्गेन्नारी बहुनरङ्गमा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002158021, "chapter_id": 22158, "verse_number": "२०३-२२", "content_sanskrit": "आस्फोटजिह्वोद्धरणं स्त्रीक्षणान्नेत्रभेदनं ।\nअङ्गारराशौ क्षिप्यन्ते मातृपुत्र्यादिगामिनः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002158022, "chapter_id": 22158, "verse_number": "२०३-२३", "content_sanskrit": "चौराः क्षुरैश्च भिद्यन्ते स्वमांसाशी च मांसभुक् ।\nमासोपवासकर्ता वै न याति नरकन्नरः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]