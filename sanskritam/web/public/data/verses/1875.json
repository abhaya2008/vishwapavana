[{"id": 2039623, "chapter_id": 1875, "verse_number": "५-१२०-०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2039624, "chapter_id": 1875, "verse_number": "५-१२०-१", "content_sanskrit": "स तु राजा पुनस्तस्याः कर्तुकामः स्वयंवरम्।\nउपगम्याश्रमपदं गङ्गायामुनसङ्गमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2039625, "chapter_id": 1875, "verse_number": "५-१२०-२", "content_sanskrit": "गृहीतमाल्यदामां तां रथमारोप्य माधवीम् ।\nपूरुर्यदुश्च भगिनीमाश्रमे पर्यधावताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2039626, "chapter_id": 1875, "verse_number": "५-१२०-३", "content_sanskrit": "नागयक्षमनुष्याणां गन्धर्वमृगपक्षिणाम् ।\nशैलद्रुमवनौकानामासीत्तत्र समागमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2039627, "chapter_id": 1875, "verse_number": "५-१२०-४", "content_sanskrit": "नानापुरुषदेश्यानामीश्वरैश्च समाकुलम् ।\nऋषिभिर्ब्रह्मकल्पैश्च समन्तादावृतं वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2039628, "chapter_id": 1875, "verse_number": "५-१२०-५", "content_sanskrit": "निर्दिश्यमानेषु तु सा वरेषु वरवर्णिनी ।\nवरानुत्क्रम्य सर्वास्तान्वरं वृतवती वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2039629, "chapter_id": 1875, "verse_number": "५-१२०-६", "content_sanskrit": "अवतीर्य रथात्कन्या नमस्कृत्य च बन्धुषु।\nउपगम्य वनं पुण्यं तपस्तेपे ययातिजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2039630, "chapter_id": 1875, "verse_number": "५-१२०-७", "content_sanskrit": "उपवसैश्च विविधैर्दीक्षाभिर्नियमैस्तथा ।\nआत्मनो लघुतां कृत्वा बभूव मृगचारिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2039631, "chapter_id": 1875, "verse_number": "५-१२०-८", "content_sanskrit": "वैदूर्याङ्कुरकल्पानि मृदूनि हरितानि च।\nचरन्ती श्लक्ष्णशष्पाणि तिक्तानि मधुराणि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2039632, "chapter_id": 1875, "verse_number": "५-१२०-९", "content_sanskrit": "स्रवन्तीनां च पुण्यानां सुरसानि सुचीनि च।\nपिबन्ती वारिमुख्यानि शीतानि विमलानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2039633, "chapter_id": 1875, "verse_number": "५-१२०-१०", "content_sanskrit": "वनेषु मृगराजेषु व्याघ्रविप्रोषितेषु च ।\nदावाग्निविप्रयुक्तेषु शून्येषु गहनेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2039634, "chapter_id": 1875, "verse_number": "५-१२०-११", "content_sanskrit": "चरन्ती हरिणैः सार्धं मृगीव वनचारिणी ।\nचचार विपुलं धर्मं ब्रह्मचर्येण संवृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2039635, "chapter_id": 1875, "verse_number": "५-१२०-१२", "content_sanskrit": "ययातिरपि पूर्वेषां राज्ञां वृत्तमनुष्ठितः।\nबहुवर्षसहस्रायुर्युयुजे कालधर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2039636, "chapter_id": 1875, "verse_number": "५-१२०-१३", "content_sanskrit": "पुरुर्यदुश्च द्वौ वंशे वर्धमानौ नरोत्तमौ ।\nताभ्भां प्रतिष्ठितो लोके परलोके च नाहुषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2039637, "chapter_id": 1875, "verse_number": "५-१२०-१४", "content_sanskrit": "महीपते नरपतिर्ययातिः स्वर्गमास्थितः।\nमहर्षिकल्पो नृपतिः स्वर्गाग्र्यफलभुग्विभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2039638, "chapter_id": 1875, "verse_number": "५-१२०-१५", "content_sanskrit": "बहुवर्षसहस्राख्ये काले बहुगुणे गते।\nराजर्षिषु निषण्णेषु महीयःसु महर्धिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2039639, "chapter_id": 1875, "verse_number": "५-१२०-१६", "content_sanskrit": "अवमेने नरान्सर्वान्देवानृषिगणांस्तथा।\nययातिर्मूढविज्ञानो विस्मयाविष्टचेतनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2039640, "chapter_id": 1875, "verse_number": "५-१२०-१७", "content_sanskrit": "ततस्तं बुबुधे देवः शक्रो बलनिषूदनः ।\nते च राजर्षयः सर्वे धिग्धिगित्येवमब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2039641, "chapter_id": 1875, "verse_number": "५-१२०-१८", "content_sanskrit": "विचारश्च समुत्पन्नो निरीक्ष्य नहुषात्मजम् ।\nकोऽन्वयं कस्य वा राज्ञः कथं वा स्वर्गमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2039642, "chapter_id": 1875, "verse_number": "५-१२०-१९", "content_sanskrit": "कर्मणा केनसिद्धोऽयं क्व वाऽनेन तपश्चितम्।\nकथं वा ज्ञायते स्वर्गे केन वा ज्ञायतेऽप्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2039643, "chapter_id": 1875, "verse_number": "५-१२०-२०", "content_sanskrit": "एवं विचास्यन्तस्ते राजानं स्वर्गवासिनः ।\nदृष्ट्वा पप्रच्छुरन्योन्यं ययातिं नृपतिं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2039644, "chapter_id": 1875, "verse_number": "५-१२०-२१", "content_sanskrit": "विमानपालाः शतशः स्वर्गद्वाराभिरक्षिणः ।\nपृष्टा आसनपालाश्च न जानीमेत्यथाऽब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2039645, "chapter_id": 1875, "verse_number": "५-१२०-२२", "content_sanskrit": "सर्वे ते ह्यावृतज्ञाना नाभ्यजानन्त तं नृपम् ।\nस मुहूर्तादथ नृपो हतौजाश्चाभवत्तदा ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2039646, "chapter_id": 1875, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि विंशत्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]