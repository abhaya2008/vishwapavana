[{"id": 7000587000, "chapter_id": 20587, "verse_number": "५-४६-१", "content_sanskrit": "शेष उवाच ।\nआगतं वीक्ष्य श्रीरामं शत्रुघ्नः प्रणतार्तिहम् ।\nभ्रातरं सकलाद्दुःखान्मुक्तोऽभूद्द्विजसत्तम॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000587001, "chapter_id": 20587, "verse_number": "५-४६-२", "content_sanskrit": "हनूमान्वीक्ष्य विभ्रांतो रामस्य चरणौ मुदा ।\nववंदे भक्तरक्षार्थमागतं निजगाद च॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000587002, "chapter_id": 20587, "verse_number": "५-४६-३", "content_sanskrit": "स्वामिंस्तवैतद्युक्तं तु स्वभक्तपरिपालनम् ।\nयत्संग्रामे जितं सर्वं पाशबद्धममोचयः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000587003, "chapter_id": 20587, "verse_number": "५-४६-४", "content_sanskrit": "वयं त्विदानीं धन्या वै यद्द्रक्ष्यामो भवत्पदे ।\nजेष्यामोऽरीन्क्षणादेव त्वत्कृपातो रघूद्वह॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000587004, "chapter_id": 20587, "verse_number": "५-४६-५", "content_sanskrit": "शेष उवाच ।\nस्थाणुस्तदागतं रामं योगिनां ध्यानगोचरम् ।\nपतित्वा पादयोर्विप्र जगाद प्रणताभयम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000587005, "chapter_id": 20587, "verse_number": "५-४६-६", "content_sanskrit": "एकस्त्वं पुरुषः साक्षात्प्रकृतेः पर ईर्यसे ।\nयः स्वांशकलया विश्वं सृजस्यवसि हंसि च॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000587006, "chapter_id": 20587, "verse_number": "५-४६-७", "content_sanskrit": "अरूपस्त्वमशेषस्य जगतः कारणं परम् ।\nएक एव त्रिधारूपं गृह्णासि कुहकान्वितः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000587007, "chapter_id": 20587, "verse_number": "५-४६-८", "content_sanskrit": "सृष्टौ विधातृरूपेण पालने स्वयमास च ।\nप्रलये जगतः साक्षादहं शर्वाख्यतां गतः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000587008, "chapter_id": 20587, "verse_number": "५-४६-९", "content_sanskrit": "तव यत्परमेशस्य हयमेधक्रतुक्रिया ।\nब्रह्महत्यापनोदाय तद्विडंबनमद्भुतम्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000587009, "chapter_id": 20587, "verse_number": "५-४६-१०", "content_sanskrit": "यत्पादशौचममलं गंगाख्यं शिरसोंऽतरा ।\nवहामि पापशांत्यर्थं तस्य ते पातकं कुतः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000587010, "chapter_id": 20587, "verse_number": "५-४६-११", "content_sanskrit": "मया बह्वपकाराय कृतं कर्म तव स्फुटम् ।\nक्षम्यतां तत्कृपालो हि भवतो व्यवधायकम्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000587011, "chapter_id": 20587, "verse_number": "५-४६-१२", "content_sanskrit": "किं करोमि मया सत्यपालनार्थमिदं कृतम् ।\nजानन्प्रभावं भवतो भक्तरक्षार्थमागतः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000587012, "chapter_id": 20587, "verse_number": "५-४६-१३", "content_sanskrit": "असौ पुरा उज्जयिन्यां महाकालनिकेतने ।\nस्नात्वा शिप्राख्य सरिति तपस्तेपे महाद्भुतम्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000587013, "chapter_id": 20587, "verse_number": "५-४६-१४", "content_sanskrit": "ततः प्रसन्नो जातोऽहं जगाद भूमिपं प्रति ।\nयाचस्वेति महाराज स वव्रे राज्यमद्भुतम्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000587014, "chapter_id": 20587, "verse_number": "५-४६-१५", "content_sanskrit": "मया प्रोक्तं देवपुरे तव राज्यं भविष्यति ।\nयावद्रामहयः पुर्यामागमिष्यति याज्ञिकः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000587015, "chapter_id": 20587, "verse_number": "५-४६-१६", "content_sanskrit": "तावत्प्रभृत्यहं स्थास्ये तव रक्षार्थमुद्यतः ।\nएतद्दत्तवरो राम किं करोमि स्वसत्यतः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000587016, "chapter_id": 20587, "verse_number": "५-४६-१७", "content_sanskrit": "घृणितोऽस्म्यधुना राज्ञा सपुत्रपशुबांधवः ।\nहयं समर्प्यते पादसेवां राजा विधास्यति॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000587017, "chapter_id": 20587, "verse_number": "५-४६-१८", "content_sanskrit": "शेष उवाच ।\nइति वाक्यं समाकर्ण्य महेशस्य रघूत्तमः ।\nउवाच धीरया वाचा कृपया पूर्णलोचनः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000587018, "chapter_id": 20587, "verse_number": "५-४६-१९", "content_sanskrit": "राम उवाच ।\nदेवानामयमेवास्ति धर्मो भक्तस्य पालनम् ।\nत्वया साधुकृतं कर्म यद्भक्तो रक्षितोऽधुना॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000587019, "chapter_id": 20587, "verse_number": "५-४६-२०", "content_sanskrit": "ममासि हृदये शर्व भवतो हृदये त्वहम् ।\nआवयोरंतरं नास्ति मूढाः पश्यंति दुर्धियः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000587020, "chapter_id": 20587, "verse_number": "५-४६-२१", "content_sanskrit": "ये भेदं विदधत्यद्धा आवयोरेकरूपयोः ।\nकुंभीपाकेषु पच्यंते नराः कल्पसहस्रकम्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000587021, "chapter_id": 20587, "verse_number": "५-४६-२२", "content_sanskrit": "ये त्वद्भक्तास्त एवासन्मद्भक्ता धर्मसंयुताः ।\nमद्भक्ता अपि भूयस्या भक्त्या तव नतिंकराः॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000587022, "chapter_id": 20587, "verse_number": "५-४६-२३", "content_sanskrit": "शेष उवाच ।\nइत्थं भाषितमाकर्ण्य शर्वो वीरमणिं नृपम् ।\nमूर्च्छितं जीवयामास करस्पर्शादिना प्रभुः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000587023, "chapter_id": 20587, "verse_number": "५-४६-२४", "content_sanskrit": "अन्यानपि सुतानस्य मूर्च्छिताञ्छरपीडितान् ।\nजीवयामास स मृडः समर्थः प्रभुरीश्वरः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000587024, "chapter_id": 20587, "verse_number": "५-४६-२५", "content_sanskrit": "सज्जं विधाय तं भूपं श्रीरामपदयोर्नतिम् ।\nकारयामास भूतेशः पुत्रपौत्रैः परीवृतम्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000587025, "chapter_id": 20587, "verse_number": "५-४६-२६", "content_sanskrit": "धन्यो राजा वीरमणिर्यो ददर्श रघूत्तमम् ।\nयोगिभिर्योगनिष्ठाभिर्दुष्प्रापमयुतायुतैः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000587026, "chapter_id": 20587, "verse_number": "५-४६-२७", "content_sanskrit": "ते नत्वा रघुनाथं तं कृतार्थी कृतविग्रहाः ।\nब्रह्मादिभिः पूज्यतमा अभूवन्द्विजसत्तम॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000587027, "chapter_id": 20587, "verse_number": "५-४६-२८", "content_sanskrit": "शत्रुघ्न हनुमद्भ्यां च पुष्कलादिभिरुद्भटैः ।\nपरिष्टुताय रामाय ददौ राजा हयोत्तमम्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000587028, "chapter_id": 20587, "verse_number": "५-४६-२९", "content_sanskrit": "राज्येन सहितं सर्वं सपुत्रपशुबांधवम् ।\nशर्वेण प्रेरितः प्रादाद्भूपो वीरमणिस्तदा॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000587029, "chapter_id": 20587, "verse_number": "५-४६-३०", "content_sanskrit": "ततो रामो नुतः सर्वैर्वैरिभिर्निजसेवकैः ।\nशत्रुघ्नादिभिरत्यंतमुत्सुकैश्च विशेषतः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000587030, "chapter_id": 20587, "verse_number": "५-४६-३१", "content_sanskrit": "रथे मणिमये तिष्ठन्बभूव स तिरोहितः ।\nअंतर्हिते रामभद्रे सर्वे प्रापुः सुविस्मयम्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000587031, "chapter_id": 20587, "verse_number": "५-४६-३२", "content_sanskrit": "मा जानीहि मनुष्यं तं रामं लोकैकवंदितम् ।\nजले स्थले च सर्वत्र वर्तते संस्थितः सदा॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000587032, "chapter_id": 20587, "verse_number": "५-४६-३३", "content_sanskrit": "ततो वीरा अलं हृष्टा अन्योन्यं परिरेभिरे ।\nतूर्यमंगलवादित्रैः सुमहानुत्सवोऽभवत्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000587033, "chapter_id": 20587, "verse_number": "५-४६-३४", "content_sanskrit": "ततो मुक्तो हयः सर्वैर्वीरैः शस्त्रास्त्रकोविदैः ।\nसर्वैरनुगतः प्रीतैर्विस्मयेन समन्वितैः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000587034, "chapter_id": 20587, "verse_number": "५-४६-३५", "content_sanskrit": "शर्वः सत्यप्रतिज्ञश्च तमनुज्ञाप्य सेवकम् ।\nश्रीरामं शरणं प्रोच्य याहि लोकैकदुर्ल्लभम्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000587035, "chapter_id": 20587, "verse_number": "५-४६-३६", "content_sanskrit": "स्वयमंतर्हितस्तत्र प्रलयोत्पत्तिकारकः ।\nकैलासमगमच्छर्वः सेवकैः परिशोभितः॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000587036, "chapter_id": 20587, "verse_number": "५-४६-३७", "content_sanskrit": "भूपो वीरमणिर्ध्यायञ्छ्रीरामचरणोदजम् ।\nशत्रुघ्नेन ययौ साकं बलिना बलसंयुतः॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000587037, "chapter_id": 20587, "verse_number": "५-४६-३८", "content_sanskrit": "एतद्रामस्य चरितं ये शृण्वंति नरोत्तमाः ।\nतेषां संसारजं दुःखं न भविष्यति कर्हिचित्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]