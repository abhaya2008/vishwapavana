[{"id": 7002873000, "chapter_id": 22873, "verse_number": "९-१५८-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nप्रसूयमाना दातव्या धेनुर्ब्राह्मणपुङ्गवे ।\nविधिना केन धर्मज्ञं दाने तस्याश्च किं फलम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002873001, "chapter_id": 22873, "verse_number": "९-१५८-२", "content_sanskrit": "श्रीकृष्ण उवाच ।\nप्रसूयमानातिपुण्यैः प्राप्यते गौर्नृपोत्तम ।\nप्राप्नुवंति नराः केचित्पुण्यसंभारविस्तराः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002873002, "chapter_id": 22873, "verse_number": "९-१५८-३", "content_sanskrit": "यावत्पादौ योनिगतौ शिरश्चैव प्रदृश्यते ।\nतावद्गौः पृथिवी ज्ञेया यावद्गर्भं न मुंचति ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002873003, "chapter_id": 22873, "verse_number": "९-१५८-४", "content_sanskrit": "गौर्यावद्द्विमुखी चैव यदा भवति भारत ।\nतदासौ पृथिवी ज्ञेया सशैलवनकानना ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002873004, "chapter_id": 22873, "verse_number": "९-१५८-५", "content_sanskrit": "दत्त्वोभयमुखीं राजन्यत्पुण्यं प्राप्यते नृभिः ।\nन तद्वर्णयितुं याति मुखेनैकेन केनचित् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002873005, "chapter_id": 22873, "verse_number": "९-१५८-६", "content_sanskrit": "किमिष्टैर्बहुभिर्यज्ञैर्दानैर्दत्तैश्च सत्तम ।\nप्रसूयमानां गामेकां देहि किं बहुना तव ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002873006, "chapter_id": 22873, "verse_number": "९-१५८-७", "content_sanskrit": "एकैव पाति नरकात्सुखमेकैव कारयेत् ।\nएकापि द्विमुखी दत्ता गौर्गौर्भवति भारत ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002873007, "chapter_id": 22873, "verse_number": "९-१५८-८", "content_sanskrit": "स्वर्णशृंगीं रौप्यखुरां मुक्तालाङ्गूलभूषिताम् ।\nकांस्योपदोहनां राजन्नलंकृत्य द्विजोत्तमे ।\nप्रसूयमानां गां दत्त्वा महत्पुण्यफलं लभेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002873008, "chapter_id": 22873, "verse_number": "९-१५८-९", "content_sanskrit": "यावंति धेनुरोमाणि वत्सस्यापि नराधिप ।\nतावद्वर्षसहस्राणि स्वर्गलोके महीयते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002873009, "chapter_id": 22873, "verse_number": "९-१५८-१०", "content_sanskrit": "पितॄन्पितामहांश्चैव तथैव प्रपितामहान् ।\nसमुद्धरत्यसंदिग्धं नरकाद्भूरिदक्षिणः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002873010, "chapter_id": 22873, "verse_number": "९-१५८-११", "content_sanskrit": "घृतक्षीरवहा नद्यो दधिपायसकर्दमाः ।\nतत्र ते यांति यत्रास्ति द्रुमश्चेप्सितकामदः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002873011, "chapter_id": 22873, "verse_number": "९-१५८-१२", "content_sanskrit": "यो ददाति सुवर्णेन बहुना सह भाविनीम् ।\nगोलोकः सुलभस्तस्य ब्रह्मलोकश्च पार्थिव ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002873012, "chapter_id": 22873, "verse_number": "९-१५८-१३", "content_sanskrit": "न देया दुर्बला राजन्धेनुर्नैवाल्पदक्षिणा ।\nकाम्योऽयं विधिरुद्दिष्टः फलदो विधिना कृतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002873013, "chapter_id": 22873, "verse_number": "९-१५८-१४", "content_sanskrit": "स्त्रियश्च त चंद्रसमानवक्त्राः प्रतप्तजांबूनदतुल्यवर्णाः ।\nमहानितंबास्तनुवृत्तमध्याः सेवंत्यजस्रं नलिनाभनेत्राः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]