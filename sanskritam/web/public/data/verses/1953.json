[{"id": 2042643, "chapter_id": 1953, "verse_number": "६-२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2042644, "chapter_id": 1953, "verse_number": "६-२-१", "content_sanskrit": "ततः पूर्वापरे सैन्ये समीक्ष्य भगवानृषिः।\nसर्ववेदविदां श्रेष्ठो व्यासः सत्यवतीसुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2042645, "chapter_id": 1953, "verse_number": "६-२-२", "content_sanskrit": "भविष्यति रणे घोरे भरतानां पितामहः ।\nप्रत्यक्षदर्शी भगवान्भूतभव्यभविष्यवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2042646, "chapter_id": 1953, "verse_number": "६-२-३", "content_sanskrit": "वैचित्रवीर्यं राजानं रहस्स्थमिदमब्रवीत् ।\nशोचन्तमार्तं ध्यायन्तं पुत्राणामनयं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2042647, "chapter_id": 1953, "verse_number": "६-२-४x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2042648, "chapter_id": 1953, "verse_number": "६-२-४", "content_sanskrit": "राजन्परिकालास्ते पुत्राश्चान्ये च पार्थिवाः।\nते हिंसन्तीव सङ्ग्रामे समासाद्येतरेतरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2042649, "chapter_id": 1953, "verse_number": "६-२-५", "content_sanskrit": "तेषु कालपरीतेषु विनश्यत्स्वेव भारत ।\nकालपर्यायमाहाय मा स्म शोके मनः कृथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2042650, "chapter_id": 1953, "verse_number": "६-२-६", "content_sanskrit": "यदि चेच्छसि संग्रामं द्रुष्टुमेनं विशांपते ।\nचक्षुर्ददानि ते पुत्र युद्धमेतन्निशामया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2042651, "chapter_id": 1953, "verse_number": "६-२-७x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2042652, "chapter_id": 1953, "verse_number": "६-२-७", "content_sanskrit": "न रोचये ज्ञातिवधं द्रष्टुं ब्रह्मर्षिसत्तम।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2042653, "chapter_id": 1953, "verse_number": "६-२-७", "content_sanskrit": "युद्धमेतत्त्वशेषेण श्रृणुयां तव तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2042654, "chapter_id": 1953, "verse_number": "६-२-८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2042655, "chapter_id": 1953, "verse_number": "६-२-८", "content_sanskrit": "तस्मिन्ननिच्छति द्रष्टुं संग्रामं श्रोतुमिच्छति।\nवराणामीश्वरो व्यासः संजयाय वरं ददौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2042656, "chapter_id": 1953, "verse_number": "६-२-९x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2042657, "chapter_id": 1953, "verse_number": "६-२-९", "content_sanskrit": "एष ते संजयो राजन्युद्धमेतद्वदिष्यति।\nएतस्य सर्वं संग्रामे न परोक्षं भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2042658, "chapter_id": 1953, "verse_number": "६-२-१०", "content_sanskrit": "चक्षुषा संजयो राजन्दिव्येनैव समन्वितः ।\nकथयिष्यति ते युद्धं सर्वज्ञश्च भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2042659, "chapter_id": 1953, "verse_number": "६-२-११", "content_sanskrit": "प्रकाशं वाऽप्रकाशं वा दिवा वा यदि वा निशि ।\nमनसा चिन्तितमपि सर्वं वेत्स्यति संजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2042660, "chapter_id": 1953, "verse_number": "६-२-१२", "content_sanskrit": "नैनं शस्त्राणि भेत्स्यन्ति नैनं बाधिष्यते श्रमः ।\nगावल्गणिरयं जीवन्युद्धादस्माद्विमोक्ष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2042661, "chapter_id": 1953, "verse_number": "६-२-१३", "content_sanskrit": "अहं तु कीर्तिमेतेषां करूणां भरतर्षभ ।\nपाण्डवानां च सर्वेषां प्रथयिष्यामि मा शुचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2042662, "chapter_id": 1953, "verse_number": "६-२-१४", "content_sanskrit": "दिष्टमेतन्नरव्याघ्र नाभिशोचितुमर्हसि ।\nन चैव शक्यं संयन्तुं यतो धर्मस्ततो जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2042663, "chapter_id": 1953, "verse_number": "६-२-१५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2042664, "chapter_id": 1953, "verse_number": "६-२-१५", "content_sanskrit": "एवमुक्त्वा स भगवान्कुरूणां प्रतितामहः ।\nपुनरेव महाभागो धृतराष्ट्रमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2042665, "chapter_id": 1953, "verse_number": "६-२-१६", "content_sanskrit": "इह युद्धे महाराज भविष्यति महान्क्षयः ।\nतथेह च निमित्तानि भयदान्युपलक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2042666, "chapter_id": 1953, "verse_number": "६-२-१७", "content_sanskrit": "श्येना गृध्राश्च काकाश्च काङ्काश्च सहिता बकैः ।\nसंपतन्ति ध्वजाग्रेषु समवायांश्च कुर्वते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2042667, "chapter_id": 1953, "verse_number": "६-२-१८", "content_sanskrit": "अभ्यग्रं च प्रपश्यन्ति युद्धमानन्दिनो द्विजाः ।\nक्रव्यादा भक्षयिष्यन्ति मांसानि गजवाजिनां ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2042668, "chapter_id": 1953, "verse_number": "६-२-१९", "content_sanskrit": "कटाकटेति वाशन्तो भैरवा भयवेदिनः ।\nकङ्काः क्रोशन्ति मध्याह्ने दक्षिणामभितो दिशं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2042669, "chapter_id": 1953, "verse_number": "६-२-२०", "content_sanskrit": "उभे पूर्वापरे सन्ध्ये नित्यं पश्यामि भारत ।\nउदयास्तमने सूर्यं कबन्धैः परिवारितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2042670, "chapter_id": 1953, "verse_number": "६-२-२१", "content_sanskrit": "श्वेतलोहितपर्यन्ताः कृष्णाग्रीवाः सविद्युतः ।\nत्रिवर्णाः परिघाः सन्धौ भानुमावारयन्त्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2042671, "chapter_id": 1953, "verse_number": "६-२-२२", "content_sanskrit": "ज्वलितार्के .......त्रं निर्विशेषदिनक्षपम् ।\nचन्द्रोऽभूतग्निवर्णश्च पद्मवर्णे नभस्तले ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2042672, "chapter_id": 1953, "verse_number": "६-२-२३", "content_sanskrit": "आलक्षे प्रभया हीनां पौर्णमासीं च कीर्तिकीम् ।\nचन्द्रोऽभूदग्निवर्णश्च पद्मवर्णे नभस्तले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2042673, "chapter_id": 1953, "verse_number": "६-२-२४", "content_sanskrit": "स्वप्स्यन्ति निहता वीरा भूमिमावृत्य पार्थिवाः ।\nराजानो राजपुत्राश्च शूराः परिघबाहवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2042674, "chapter_id": 1953, "verse_number": "६-२-२५", "content_sanskrit": "अन्तरिक्षे वराहस्य पृषदंशकस्य चोभयोः।\nप्रणादं युध्यतो रात्रौ रौद्रं नित्यं प्रलक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2042675, "chapter_id": 1953, "verse_number": "६-२-२६", "content_sanskrit": "देवताप्रतिमाश्चैव कम्पन्ति च हसन्ति च।\nवमन्ति रुधिरं चास्यैः स्विद्यन्ति प्रपतन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2042676, "chapter_id": 1953, "verse_number": "६-२-२७", "content_sanskrit": "अनाहता दुन्दुभयः प्रणदन्ति विशांपते ।\nअयुक्ताश्च प्रवर्तन्ते क्षत्रियाणां महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2042677, "chapter_id": 1953, "verse_number": "६-२-२८", "content_sanskrit": "कोकिलाः शतपत्राश्च चाषा भासाः शुकास्तथा ।\nसारसाश्च मयूराश्च वाचो मुञ्चन्ति दारुणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2042678, "chapter_id": 1953, "verse_number": "६-२-२९", "content_sanskrit": "गृहीतशस्त्राः क्रोशन्ति चर्मिणो वाजिपृष्ठगाः ।\nअरुणोदये प्रदृश्यन्ते शतशः शलभव्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2042679, "chapter_id": 1953, "verse_number": "६-२-३०", "content_sanskrit": "उभे सन्ध्ये प्रकाशन्ते दिशो दाहसमन्विते।\nपर्जन्यः पांसुवर्षी च मांसवर्षी च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2042680, "chapter_id": 1953, "verse_number": "६-२-३१", "content_sanskrit": "या चैषा विश्रुता राजंस्त्रैलोक्ये साधुसंमता।\nअरुन्धती तयाप्येष वसिष्ठः पृष्ठतः कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2042681, "chapter_id": 1953, "verse_number": "६-२-३२", "content_sanskrit": "रोहिणीं पीडयन्नेष स्थितो राजञ्शनैश्चरः ।\nव्यावृत्तं लक्ष्म सोमस्य भविष्यति महद्भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2042682, "chapter_id": 1953, "verse_number": "६-२-३३", "content_sanskrit": "अनभ्रे च महाघोरस्तनितं श्रूयते भृशम् ।\nवाहनानां च रुदतां निपतन्त्युश्रुबिन्दवः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2042683, "chapter_id": 1953, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि जम्बूखण्डविनिर्माणपर्वणि द्वितीयोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]