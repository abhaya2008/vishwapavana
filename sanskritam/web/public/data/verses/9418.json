[{"id": 40023005, "chapter_id": 9418, "verse_number": "1", "content_sanskrit": "रजन्यां तु प्रभातायां समानीय महामुनीन् । गीयतामविशङ्काभ्यां रामः पुत्रावुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40023006, "chapter_id": 9418, "verse_number": "2", "content_sanskrit": "ततः समुपविष्टेषु ब्रह्मर्षिषु महात्मसु । भविष्यदुत्तरं काव्यं जगतुस्तौ कुशीलवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40023007, "chapter_id": 9418, "verse_number": "3", "content_sanskrit": "प्रविष्टायां तु सीतायां भूतलं सत्यसम्पदा । तस्यावसाने यज्ञस्य रामः परमदुर्मनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40023008, "chapter_id": 9418, "verse_number": "4", "content_sanskrit": "अपश्यमानो वैदेहीं मेने शून्यमिदं जगत् । शोकेन परमायस्तो न शान्तिं मनसा ऽगमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40023009, "chapter_id": 9418, "verse_number": "5", "content_sanskrit": "विसृज्य पार्थिवान्सर्वानृक्षवानरराक्षसान् । जनौघं विप्रमुख्यानां वित्तपूर्वं विसृज्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40023010, "chapter_id": 9418, "verse_number": "6", "content_sanskrit": "एवं समाप्य यज्ञं तु विधिवत्स तु राघवः । ततो विसृज्य तान्सर्वान्रामो राजीवलोचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40023011, "chapter_id": 9418, "verse_number": "7", "content_sanskrit": "हृदि कृत्वा तदा सीतामयोध्यां प्रविवेश ह । इष्टयज्ञो नरपतिः पुत्रद्वयसमन्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40023012, "chapter_id": 9418, "verse_number": "8", "content_sanskrit": "न सीतायाः परां भार्यां वव्रे स रघुनन्दनः । यज्ञे यज्ञे च पत्न्यर्थं जानकी काञ्चनी भवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40023013, "chapter_id": 9418, "verse_number": "9", "content_sanskrit": "दशवर्षसहस्राणि वाजिमेघानथाकरोत् । वाजपेयान्दशगुणांस्तथा बहुसुवर्णकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40023014, "chapter_id": 9418, "verse_number": "10", "content_sanskrit": "अग्निष्टोमातिरात्राभ्यां गोसवैश्च महाधनैः । ईजे क्रतुभिरन्यैश्च स श्रीमानाप्तदक्षिणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40023015, "chapter_id": 9418, "verse_number": "11", "content_sanskrit": "एवं स कालः सुमहान्राज्यस्थस्य महात्मनः । धर्मे प्रयतमानस्य व्यतीयाद्राघवस्य तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40023016, "chapter_id": 9418, "verse_number": "12", "content_sanskrit": "अनुरञ्जन्ति राजानमहन्यहनि राघवम् । ऋक्षवानररक्षांसि स्थिता रामस्य शासने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40023017, "chapter_id": 9418, "verse_number": "13", "content_sanskrit": "काले वर्षति पर्जन्यः सुभिक्षं विमला दिशः । हृष्टपुष्टजनाकीर्णं पुरं जनपदास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40023018, "chapter_id": 9418, "verse_number": "14", "content_sanskrit": "नाकाले म्रियते कश्चिन्न व्याधिः प्राणिनां तथा । नानर्थो विद्यते कश्चिद्रामे राज्यं प्रशासति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40023019, "chapter_id": 9418, "verse_number": "15", "content_sanskrit": "अथ दीर्घस्य कालस्य राममाता यशस्विनी । पुत्रपौत्रैः परिवृता कालधर्ममुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40023020, "chapter_id": 9418, "verse_number": "16", "content_sanskrit": "अन्वियाय सुमित्रा च कैकेयी च यशस्विनी । धर्मं कृत्वा बहुविधं त्रिदिवे पर्यवस्थिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40023021, "chapter_id": 9418, "verse_number": "17", "content_sanskrit": "सर्वाः प्रमुदिताः स्वर्गे राज्ञा दशरथेन च । समागता महाभागाः सर्वधर्मं च लेभिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40023022, "chapter_id": 9418, "verse_number": "18", "content_sanskrit": "तासां रामो महादानं काले काले प्रयच्छति । मातऽणामविशेषेण ब्राह्मणेषु तपस्विषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40023023, "chapter_id": 9418, "verse_number": "19", "content_sanskrit": "पित्र्याणि ब्रह्मरत्नानि यज्ञान्परमदुस्तरान् । चकार रामो धर्मात्मा पितऽन्देवान्विवर्धयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40023024, "chapter_id": 9418, "verse_number": "20", "content_sanskrit": "एवं वर्षसहस्राणि बहून्यथ ययुः सुखम् । यज्ञैर्बहुविधं धर्मं वर्धयानस्य सर्वदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]