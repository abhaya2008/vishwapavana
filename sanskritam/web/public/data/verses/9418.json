[{"id": 5000418000, "chapter_id": 9418, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे एकादशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000418001, "chapter_id": 9418, "verse_number": "६-११-१", "content_sanskrit": "स बभूव कृशो राजा मैथिलीकाममोहितः।\nअसन्मानाच्च सुहृदां पापः पापेन कर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000418002, "chapter_id": 9418, "verse_number": "६-११-२", "content_sanskrit": "अतीव कामसम्पन्नो वैदेहीमनुचिन्तयन्।\nअतीतसमये काले तस्मिन् वै युधि रावणः।\nअमात्यैश्च सुहृद्भिश्च प्राप्तकालममन्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000418003, "chapter_id": 9418, "verse_number": "६-११-३", "content_sanskrit": "स हेमजालविततं मणिविद्रुमभूषितम्।\nउपगम्य विनीताश्वमारुरोह महारथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000418004, "chapter_id": 9418, "verse_number": "६-११-४", "content_sanskrit": "तमास्थाय रथश्रेष्ठं महामेघसमस्वनम्।\nप्रययौ रक्षसां श्रेष्ठो दशग्रीवः सभां प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000418005, "chapter_id": 9418, "verse_number": "६-११-५", "content_sanskrit": "असिचर्मधरा योधाः सर्वायुधधरास्ततः।\nराक्षसा राक्षसेन्द्रस्य पुरस्तात् सम्प्रतस्थिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000418006, "chapter_id": 9418, "verse_number": "६-११-६", "content_sanskrit": "नानाविकृतवेषाश्च नानाभूषणभूषिताः।\nपार्श्वतः पृष्ठतश्चैनं परिवार्य ययुस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000418007, "chapter_id": 9418, "verse_number": "६-११-७", "content_sanskrit": "रथैश्चातिरथाः शीघ्रं मत्तैश्च वरवारणैः।\nअनूत्पेतुर्दशग्रीवमाक्रीडद्भिश्च वाजिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000418008, "chapter_id": 9418, "verse_number": "६-११-८", "content_sanskrit": "गदापरिघहस्ताश्च शक्तितोमरपाणयः।\nपरश्वधधराश्चान्ये तथान्ये शूलपाणयः।\nततस्तूर्यसहस्राणं संजज्ञे निःस्वनो महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000418009, "chapter_id": 9418, "verse_number": "६-११-९", "content_sanskrit": "तुमुलः शङ्खशब्दश्च सभां गच्छति रावणे।\nस नेमिघोषेण महान् सहसाभिनिनादयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000418010, "chapter_id": 9418, "verse_number": "६-११-१०", "content_sanskrit": "राजमार्गं श्रिया जुष्टं प्रतिपेदे महारथः।\nविमलं चातपत्रं च प्रगृहीतमशोभत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000418011, "chapter_id": 9418, "verse_number": "६-११-११", "content_sanskrit": "पाण्डुरं राक्षसेन्द्रस्य पूर्णस्ताराधिपो यथा।\nहेममञ्जरिगर्भे च शुद्धस्फटिकविग्रहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000418012, "chapter_id": 9418, "verse_number": "६-११-१२", "content_sanskrit": "चामरव्यजने तस्य रेजतुः सव्यदक्षिणे।\nते कृताञ्जलयः सर्वे रथस्थं पृथिवीस्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000418013, "chapter_id": 9418, "verse_number": "६-११-१३", "content_sanskrit": "राक्षसा राक्षसश्रेष्ठं शिरोभिस्तं ववन्दिरे।\nराक्षसैः स्तूयमानः सञ्जयाशीर्भिररिंदमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000418014, "chapter_id": 9418, "verse_number": "६-११-१४", "content_sanskrit": "आससाद महातेजाः सभां विरचितां तदा।\nसुवर्णरजतास्तीर्णां विशुद्धस्फटिकान्तराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000418015, "chapter_id": 9418, "verse_number": "६-११-१५", "content_sanskrit": "विराजमानो वपुषा रुक्मपट्टोत्तरच्छदाम्।\nतां पिशाचशतैः षड्‍‍भिरभिगुप्तां सदाप्रभाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000418016, "chapter_id": 9418, "verse_number": "६-११-१६", "content_sanskrit": "प्रविवेश महातेजाः सुकृतां विश्वकर्मणा।\nतस्यां तु वैदूर्यमयं प्रियकाजिनसंवृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000418017, "chapter_id": 9418, "verse_number": "६-११-१७", "content_sanskrit": "महत्सोपाश्रयं भेजे रावणः परमासनम्।\nततः शशासेश्वरवद्दूताँल्लघुपराक्रमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000418018, "chapter_id": 9418, "verse_number": "६-११-१८", "content_sanskrit": "समानयत मे क्षिप्रमिहैतान् राक्षसानिति।\nकृत्यमस्ति महज्जाने कर्तव्यमिति शत्रुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000418019, "chapter_id": 9418, "verse_number": "६-११-१९", "content_sanskrit": "राक्षसास्तद्वचः श्रुत्वा लङ्कायां परिचक्रमुः।\nअनुगेहमवस्थाय विहारशयनेषु च।\nउद्यानेषु च रक्षांसि चोदयन्तो ह्यभीतवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000418020, "chapter_id": 9418, "verse_number": "६-११-२०", "content_sanskrit": "ते रथान्तचरा एके दृप्तानेके दृढान् हयान्।\nनागानेकेऽधिरुरुहुर्जग्मुश्चैके पदातयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000418021, "chapter_id": 9418, "verse_number": "६-११-२१", "content_sanskrit": "सा पुरी परमाकीर्णा रथकुञ्जरवाजिभिः।\nसम्पतद्भिर्विरुरुचे गरुत्मद्भिरिवाम्बरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000418022, "chapter_id": 9418, "verse_number": "६-११-२२", "content_sanskrit": "ते वाहनान्यवस्थाय यानानि विविधानि च।\nसभां पद्भिः प्रविविशुः सिंहा गिरिगुहामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000418023, "chapter_id": 9418, "verse_number": "६-११-२३", "content_sanskrit": "राज्ञः पादौ गृहीत्वा तु राज्ञा ते प्रतिपूजिताः।\nपीठेष्वन्ये बृसीष्वन्ये भूमौ केचिदुपाविशन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000418024, "chapter_id": 9418, "verse_number": "६-११-२४", "content_sanskrit": "ते समेत्य सभायां वै राक्षसा राजशासनात्।\nयथार्हमुपतस्थुस्ते रावणं राक्षसाधिपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000418025, "chapter_id": 9418, "verse_number": "६-११-२५", "content_sanskrit": "मन्त्रिणश्च यथामुख्या निश्चितार्थेषु पण्डिताः।\nअमात्याश्च गुणोपेताः सर्वज्ञा बुद्धिदर्शनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000418026, "chapter_id": 9418, "verse_number": "६-११-२६", "content_sanskrit": "समीयुस्तत्र शतशः शूराश्च बहवस्तथा।\nसभायां हेमवर्णायां सर्वार्थस्य सुखाय वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000418027, "chapter_id": 9418, "verse_number": "६-११-२७", "content_sanskrit": "ततो महात्मा विपुलं सुयुग्यं\nरथं वरं हेमविचित्रिताङ्गम्।\nशुभं समास्थाय ययौ यशस्वी\nविभीषणः संसदमग्रजस्य ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000418028, "chapter_id": 9418, "verse_number": "६-११-२८", "content_sanskrit": "स पूर्वजायावरजः शशंस\nनामाथ पश्चाच्चरणौ ववन्दे।\nशुकः प्रहस्तश्च तथैव तेभ्यो\nददौ यथार्हं पृथगासनानि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000418029, "chapter_id": 9418, "verse_number": "६-११-२९", "content_sanskrit": "सुवर्णनानामणिभूषणानां\nसुवाससां संसदि राक्षसानाम्।\nतेषां परार्घ्यागुरुचन्दनानां\nस्रजां च गन्धाः प्रववुः समन्तात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000418030, "chapter_id": 9418, "verse_number": "६-११-३०", "content_sanskrit": "न चुक्रुशुर्नानृतमाह कश्चित्\nसभासदो नापि जजल्पुरुच्चैः।\nसंसिद्धार्थाः सर्व एवोग्रवीर्या\nभर्तुः सर्वे ददृशुश्चाननं ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000418031, "chapter_id": 9418, "verse_number": "६-११-३१", "content_sanskrit": "स रावणः शस्त्रभृतां मनस्विनां\nमहाबलानां समितौ मनस्वी।\nतस्यां सभायां प्रभया चकाशे\nमध्ये वसूनामिव वज्रहस्तः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000418032, "chapter_id": 9418, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे एकादशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]