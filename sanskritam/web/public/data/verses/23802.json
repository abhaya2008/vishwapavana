[{"id": 7003802000, "chapter_id": 23802, "verse_number": "२-२-४६-१", "content_sanskrit": "जैमिनिरुवाच ।\nअतः परं प्रवक्ष्यामि यात्रामक्षयमोक्षदाम् ।\nअनायासेन मूढानां वासनाबद्धचेतसाम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003802001, "chapter_id": 23802, "verse_number": "२-२-४६-२", "content_sanskrit": "वैशाखस्यामले पक्षे द्वितीयारात्रिमध्यतः ।\nमण्डपं च चतुष्कोणं सुधालिप्तं सवेदिकम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003802002, "chapter_id": 23802, "verse_number": "२-२-४६-३", "content_sanskrit": "सुधौतवाससा कुर्यात्प्रतिसीरासमं ततः ।\nसाधुसोपानसंयुक्तं चारुचंद्रातपान्वितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003802003, "chapter_id": 23802, "verse_number": "२-२-४६-४", "content_sanskrit": "तन्मध्ये विन्यसेन्नूनं साधु भद्रासनोत्तमम् ।\nतस्मिन्निचोलसंछन्ने विन्यसेत्स्वर्णभाजनम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003802004, "chapter_id": 23802, "verse_number": "२-२-४६-५", "content_sanskrit": "तस्य पश्चिमभागे वै स्वासीनो ब्राह्मणः शुचिः ।\nपात्रांतरे तु गृह्णीयाच्चंदनं पचविंशतिम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003802005, "chapter_id": 23802, "verse_number": "२-२-४६-६", "content_sanskrit": "सुपिष्टं कृष्णस्नेहस्य गृह्णीयाच्च पलाधिकम् ।\nअगुर्वर्द्धं कुंकुमं स्यात्कुंकुमार्द्धं च सिह्लकम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003802006, "chapter_id": 23802, "verse_number": "२-२-४६-७", "content_sanskrit": "कस्तूरिकाकर्पुरयोः प्रमाणं सिह्लसंमितम् ।\nसर्वमेकत्र संपिष्यात्पाटलोद्भववारिणा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003802007, "chapter_id": 23802, "verse_number": "२-२-४६-८", "content_sanskrit": "पलद्वयं ततो दद्यादगुरुस्नेहमुत्तमम् ।\nएकत्र लोडितां कृत्वा पूर्वपात्रे निधापयेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003802008, "chapter_id": 23802, "verse_number": "२-२-४६-९", "content_sanskrit": "आच्छाद्य केतकीपत्रैर्वेष्टयेच्चीनवाससा ।\nगन्धस्ते सोममंत्रेण रक्षेद्गरुडमुद्रया ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003802009, "chapter_id": 23802, "verse_number": "२-२-४६-१०", "content_sanskrit": "एवं तु मण्डपे तस्मिन्साधिवासं निधापयेत् ।\nअरुणोदयकालेऽथ नयेत्कृष्णस्य सन्निधिम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003802010, "chapter_id": 23802, "verse_number": "२-२-४६-११", "content_sanskrit": "शंखचामरछत्राद्यैर्भ्रामयित्वा सुरालयम् ।\nदेवाग्रे स्थापयित्वा च पूजयेत्पुरुषोत्तमम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003802011, "chapter_id": 23802, "verse_number": "२-२-४६-१२", "content_sanskrit": "उद्धाटयेत्ततो वस्त्रे दिव्यदृष्ट्यावलोकयेत् ।\nप्रोक्षितं मंत्रराजेन संकुर्यात्ताडनादिभिः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003802012, "chapter_id": 23802, "verse_number": "२-२-४६-१३", "content_sanskrit": "गंधपुष्पाक्षतैः पूज्यः श्रियः सूक्तेन लेपयेत् ।\nश्रीशस्य सर्वगात्रेषु मृदुस्पर्शं शनैः शनैः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003802013, "chapter_id": 23802, "verse_number": "२-२-४६-१४", "content_sanskrit": "वैष्णवा जयशब्दैस्तं वर्द्धयंति तदा हरिम् ।\nनानासूक्तोपनिषदैर्विद्वांसस्तं स्तुवंति वै ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003802014, "chapter_id": 23802, "verse_number": "२-२-४६-१५", "content_sanskrit": "वेणुवीणादिकैर्नृत्यगीतवाद्यैरनेकशः ।\nव्यजनैश्चामरैच्छत्रैरन्यैर्नानोपहारकैः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003802015, "chapter_id": 23802, "verse_number": "२-२-४६-१६", "content_sanskrit": "संतोषयञ्जगन्नाथं तृतीयादौ विलेपयेत् ।\nयस्य चिंतनमात्रेण तापा नश्यंति देहिनाम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003802016, "chapter_id": 23802, "verse_number": "२-२-४६-१७", "content_sanskrit": "सोऽसौ संदर्शनात्तापान्नृणां हंति तदा द्विजाः ।\nअचिन्त्यो महिमा विष्णोरीदृक्तादृक्तया सदा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003802017, "chapter_id": 23802, "verse_number": "२-२-४६-१८", "content_sanskrit": "ततः सूक्ष्मांबरैर्माल्यैर्भक्ष्यभोज्यादिपानकैः ।\nद्रव्यैर्नानाविधैर्हृद्यैर्गव्यैरावर्तितैः शुभैः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003802018, "chapter_id": 23802, "verse_number": "२-२-४६-१९", "content_sanskrit": "ततः संपूजयेद्देवं तांबूलैश्च सुसंस्कृतैः ।\nतस्मिन्काले तु ये कृष्णं भक्त्या पश्यंति मानवाः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003802019, "chapter_id": 23802, "verse_number": "२-२-४६-२०", "content_sanskrit": "न तेषां पुनरावृत्तिः कल्पकोटिशतैरपि ।\nविष्णोः स्वरूपमासाद्य विष्णुलोके वसंति वै ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003802020, "chapter_id": 23802, "verse_number": "२-२-४६-२१", "content_sanskrit": "पुरा कलियुगे विप्रा दक्षो नाम प्रजापतिः ।\nआध्यात्मिकादिसंतापैः सुदीनान्वीक्ष्य मानवान् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003802021, "chapter_id": 23802, "verse_number": "२-२-४६-२२", "content_sanskrit": "तत्र गत्वा कृपायुक्तो महिमानं चकार वै ।\nयथाविधि मया प्रोक्तं स एव प्रथमं द्विजाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003802022, "chapter_id": 23802, "verse_number": "२-२-४६-२३", "content_sanskrit": "प्रलिप्य चन्दनेनांगे माधवामलपक्षके ।\nतृतीयायां जगन्नाथं स्तुतिमेतां मुदा जगौ ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003802023, "chapter_id": 23802, "verse_number": "२-२-४६-२४", "content_sanskrit": "दक्ष उवाच ।\nदेवदेव जगन्नाथ सहजानंदनिर्मल ।\nसंसारार्णवसंमग्नांस्त्राहि नः परमेश्वर ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003802024, "chapter_id": 23802, "verse_number": "२-२-४६-२५", "content_sanskrit": "नानाविधैश्च संतापैः संतप्तान्मानवानिमान् ।\nममानुक्रोशबुद्ध्या वै शुभदृष्ट्याऽमृतेन च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003802025, "chapter_id": 23802, "verse_number": "२-२-४६-२६", "content_sanskrit": "संतर्पय तृणाञ्छुष्कान्कृष्ण मेऽघ नमोऽस्तुते ।\nकलिकल्मषसंमूढानुद्धर्तुं जगतां पते ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003802026, "chapter_id": 23802, "verse_number": "२-२-४६-२७", "content_sanskrit": "अवतारोऽयमेतस्मिन्नीलाचलगुहांतरे ।\nचिरकालप्ररूढानां दुस्त्यजानां महांहसाम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003802027, "chapter_id": 23802, "verse_number": "२-२-४६-२८", "content_sanskrit": "राशिं दग्धुं त्वमेवेशो दीनानाथकृपाकर ।\nत्वद्दर्शनमहायोगे यमाद्यष्टांगवर्जिते ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003802028, "chapter_id": 23802, "verse_number": "२-२-४६-२९", "content_sanskrit": "येषां मतिः समुत्पन्ना चतुर्वर्गैकसाधने ।\nन ते शोचंति दुष्पारे भवारण्ये महाभये ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003802029, "chapter_id": 23802, "verse_number": "२-२-४६-३०", "content_sanskrit": "कर्मानपेक्षं देवेश नात्मज्ञानं विमोचकम् ।\nइदं ते दर्शनं नाथ विना कर्मापि मोचयेत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003802030, "chapter_id": 23802, "verse_number": "२-२-४६-३१", "content_sanskrit": "जय कृष्ण जयेशान जयाक्षर जयाव्यय ।\nप्रसीदानुगृहाणेमान्दीनान्मूढान्विचेतसः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003802031, "chapter_id": 23802, "verse_number": "२-२-४६-३२", "content_sanskrit": "इति स्तुत्वा दंडपातं पपात चरणांबुजे ।\nप्रसीदेश प्रसीदेश प्रसीदेशेति घोषयन् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003802032, "chapter_id": 23802, "verse_number": "२-२-४६-३३", "content_sanskrit": "ततो जगाद भगवान्सुस्वरेण प्रजापतिम् ।\nउत्तिष्ठ वत्स ते दत्तं दुर्लभं यद्वरं त्वया ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003802033, "chapter_id": 23802, "verse_number": "२-२-४६-३४", "content_sanskrit": "कांक्षितं मत्प्रसादेन भविष्यति न संशयः ।\nमदनुग्रहोऽल्पपुण्यानां दुर्लभो विदितस्तव ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003802034, "chapter_id": 23802, "verse_number": "२-२-४६-३५", "content_sanskrit": "मदंगजातोऽस्ति भवान्मां त्वं प्रार्थितवानसि ।\nममोत्सवेन सन्तोष्य ततस्ते प्रददाम्यहम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003802035, "chapter_id": 23802, "verse_number": "२-२-४६-३६", "content_sanskrit": "इमामक्षययात्रां ये भक्त्या पश्यंति हर्षिताः ।\nतस्मिन्काले यदिच्छंति मनसा तदवाप्नुयुः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003802036, "chapter_id": 23802, "verse_number": "२-२-४६-३७", "content_sanskrit": "यथा संतापहरणं चन्दनेनानुलेपनम् ।\nतथोत्सवोऽयं मे दक्ष संतापत्रयनाशनः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003802037, "chapter_id": 23802, "verse_number": "२-२-४६-३८", "content_sanskrit": "मत्प्रेरितमतिस्त्वं हि उत्सवं कृतवानसि ।\nसंकल्पितोऽयं मनसा दीनोद्धृत्यै मया ध्रुवम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003802038, "chapter_id": 23802, "verse_number": "२-२-४६-३९", "content_sanskrit": "त्वयाभिकाक्षितं सर्वं दास्याम्येव प्रजापते ।\nद्वादशैता महायात्रा गुण्डिचाद्यास्तु पावनाः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003802039, "chapter_id": 23802, "verse_number": "२-२-४६-४०", "content_sanskrit": "एकैका मुक्तिदा सर्वा धर्मकामार्थवर्द्धनाः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003802040, "chapter_id": 23802, "verse_number": "२-२-४६-४१", "content_sanskrit": "तासामेकतमां वापि यो भक्त्या चावलोकयेत् ।\nएकयापि भवाब्धिं स तीर्त्वा विष्णुपदं व्रजेत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003802041, "chapter_id": 23802, "verse_number": "२-२-४६-४२", "content_sanskrit": "जैमिनिरुवाच ।\nइत्युदीर्य प्रजानाथं भगवान्स तिरोदधे ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003802042, "chapter_id": 23802, "verse_number": "२-२-४६-४३", "content_sanskrit": "दक्षः प्रजापतिः सोऽपि श्रद्दधानस्तदाज्ञया ।\nसंवत्सरं गिरौ स्थित्वा संददर्श महोत्सवान् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003802043, "chapter_id": 23802, "verse_number": "२-२-४६-४४", "content_sanskrit": "सर्वज्ञो ब्राह्मणो भूत्वा कौशिकस्य कुलोत्तमे ।\nलोकान्प्रवर्तयामास यथाविधि महेषु सः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003802044, "chapter_id": 23802, "verse_number": "२-२-४६-४५", "content_sanskrit": "विश्वासायाल्पबुद्धीनां यात्रा वै परिकीर्तिताः ।\nअयं च साक्षात्परमब्रह्मरूपी जगद्गुरुः ।\nप्रसादितः सुरेशेन लोकानुग्रहणाय वै ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003802045, "chapter_id": 23802, "verse_number": "२-२-४६-४६", "content_sanskrit": "यथा तथा दृष्टिपथं यातो मुक्तिप्रदो धुवम् ।\nसर्वान्कामान्ददात्येव नारीणां नात्र संशयः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003802046, "chapter_id": 23802, "verse_number": "२-२-४६-४७", "content_sanskrit": "सत्यप्रतिज्ञो भगवांस्तत्रास्ते मधुसूदनः ।\nशोकं तरति यं दृष्ट्वा भवपाथोधिसंभवम् ।\nकिं व्रतैः किं तपोदानैः किं कृच्छ्रैः क्रतुभिस्तथा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003802047, "chapter_id": 23802, "verse_number": "२-२-४६-४८", "content_sanskrit": "किमष्टांगेन योगेन किं सांख्येन परेण च ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003802048, "chapter_id": 23802, "verse_number": "२-२-४६-४९", "content_sanskrit": "तीर्थराजजले स्नात्वा क्षेत्रे श्रीपुरुषोत्तमे ।\nन्यग्रोधमूलवसतौ वसन्तं चर्मचक्षुषा ।\nदृष्ट्वा दारुमयं ब्रह्म देहबंधात्प्रमुच्यते ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003802049, "chapter_id": 23802, "verse_number": "२-२-४६-५०", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां द्वितीये वैष्णवखण्डे पुरुषोत्तमक्षेत्रमाहात्म्ये षट्चत्वारिंशोऽध्यायः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]