[{"id": 2104647, "chapter_id": 3256, "verse_number": "१४-११२-१", "content_sanskrit": "युधिष्ठिर उवाच।\nचक्रायुध नमस्तेऽस्तु देवेश गरुडध्वज।\nचान्द्रायणविधिं पुण्यमाख्याहि भगवन्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2104648, "chapter_id": 3256, "verse_number": "१४-११२-२x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2104649, "chapter_id": 3256, "verse_number": "१४-११२-२", "content_sanskrit": "शृणु पाण्डव तत्वेन सर्वपापप्रणाशनम्।\nपापिनो येन शुद्ध्यन्ति तत्ते वक्ष्यामि सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2104650, "chapter_id": 3256, "verse_number": "१४-११२-३", "content_sanskrit": "ब्राह्मणः क्षत्रियो वाऽपि वैश्यो वा चरितव्रतः।\nयथावत्कर्तुकामो वै तस्यैवं प्रथमा क्रिया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2104651, "chapter_id": 3256, "verse_number": "१४-११२-४", "content_sanskrit": "शोधयेत्तु शरीरं स्वं पञ्चगव्येन यन्त्रितः।\nसशिरः कृष्णपक्षस्य ततः कुर्वीत वापनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2104652, "chapter_id": 3256, "verse_number": "१४-११२-५", "content_sanskrit": "शुक्लवासाः शुचिर्भूत्वा मौञ्जीं बध्नीत मेखलाम्।\nपालाशद्ण्डमादाय ब्रह्मचारिव्रते स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2104653, "chapter_id": 3256, "verse_number": "१४-११२-६", "content_sanskrit": "कृतोपलासः पूर्वं तु शुक्लप्रतिपदि द्विजः।\nनदीसंगमतीर्थेषु शुचौ देशे गृहेऽपि वा।\nगोमयेनोपलिप्रेऽथ स्थण्डिलेऽग्निं निधापयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2104654, "chapter_id": 3256, "verse_number": "१४-११२-७", "content_sanskrit": "आघारावाज्यभागौ च प्रणवं व्याहृतीस्तथा।\nवारुणं चैव पञ्चैव हुत्वा सर्वान्यथाक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2104655, "chapter_id": 3256, "verse_number": "१४-११२-८", "content_sanskrit": "सत्याय विष्णवे चेति ब्रह्मर्षिभ्योऽथ ब्रह्मणे।\nविश्वेभ्यो हि च देवेभ्यः सप्रजापतये तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2104656, "chapter_id": 3256, "verse_number": "१४-११२-९", "content_sanskrit": "षडुक्त्वा जुहुयात्पश्चात्प्रायश्चित्ताहुतिं द्विजः।\nअतः समापयेदग्निं शान्तिं कृत्वाऽथ पौष्टिकिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2104657, "chapter_id": 3256, "verse_number": "१४-११२-१०", "content_sanskrit": "प्रणम्य् चाग्निं सोमं च भस्म दिग्ध्वा यथाविधि।\nनदीं गत्वा विशुद्धात्मा सोमाय वरुणाय च।\nआदित्याय नमस्कृत्वा ततः स्नायात्समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2104658, "chapter_id": 3256, "verse_number": "१४-११२-११", "content_sanskrit": "उत्तीर्योदकमाचम्य चासीनः पूर्वतोमुखः।\nप्राणायामं ततः कृत्वा पवित्रैरभिषेचनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2104659, "chapter_id": 3256, "verse_number": "१४-११२-१२", "content_sanskrit": "आचान्तस्त्वमिवीक्षेत ऊर्ध्वबाहुर्दिवाकरम्।\nकृताञ्जलिपुटः स्थित्वा कुर्याच्चैव प्रदक्षिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2104660, "chapter_id": 3256, "verse_number": "१४-११२-१३", "content_sanskrit": "नारायणं वा रुद्रं वा ब्रह्मणमथवाऽपि च।\nवारुणं मन्त्रमूक्तं वा प्राग्भोजनमथापि वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2104661, "chapter_id": 3256, "verse_number": "१४-११२-१४", "content_sanskrit": "वीरघ्नमृषभफं वाऽपि तथा चाप्यघमर्षणम्।\nगायत्रीं मम देवीं वा सावित्रीं वा जपेत्ततः।\nशतं वाऽष्टशतं वाऽपि सहस्रमथवा परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2104662, "chapter_id": 3256, "verse_number": "१४-११२-१५", "content_sanskrit": "ततो मध्याह्नकाले वै पायसं यावकं हि वा।\nपाचयित्वा प्रयत्नेन प्रयतः सुसमाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2104663, "chapter_id": 3256, "verse_number": "१४-११२-१६", "content_sanskrit": "पात्रं तु सुसमादाय सौवर्णं राजतं तु वा।\nताम्रं वा मृन्मयं वापि औदुंबरमथापि वा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2104664, "chapter_id": 3256, "verse_number": "१४-११२-१७", "content_sanskrit": "वृक्षाणां याज्ञियानं तु पर्णैरार्द्रैरकुत्सितैः।\nपुटकेन तु गुप्तेनि चरेद्भैक्षं समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2104665, "chapter_id": 3256, "verse_number": "१४-११२-१८", "content_sanskrit": "ब्राह्मणानां गृहाणां तु सप्तानां नापरं व्रजेत्।\nगोदोहमात्रं तिष्ठित्तु वाग्यतः संयतेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2104666, "chapter_id": 3256, "verse_number": "१४-११२-१९", "content_sanskrit": "न हसेन्न च वीक्षेत नाभिभाषेत वा स्त्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2104667, "chapter_id": 3256, "verse_number": "१४-११२-२०", "content_sanskrit": "दृष्ट्वा मूत्रं पुरीषं वा चण्डालं वा रजस्वलाम्।\nपतितं च तथा श्वानमादित्यमवलोकयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2104668, "chapter_id": 3256, "verse_number": "१४-११२-२१", "content_sanskrit": "यो हि पादुकमारुह्य सर्वदा प्रचरेद्द्विजः।\nतं दृष्ट्वा पापकर्माणमादित्यमवलोकयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2104669, "chapter_id": 3256, "verse_number": "१४-११२-२२", "content_sanskrit": "ततस्त्वावसथं प्राप्तो भिक्षां निक्षिप्य भूतले।\nप्रक्षाल्य पादावाजान्वोर्हस्तावाकूर्परं पुनः।\nआचम्य वारिणा तेन वह्निं विप्रांश्च पूययेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2104670, "chapter_id": 3256, "verse_number": "१४-११२-२३", "content_sanskrit": "पञ्च सप्ताथवा कुर्याद्भागान्भैक्षस्य तस्य वै।\nतेषामन्यतमं पिण्डमादित्याय निवेदयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2104671, "chapter_id": 3256, "verse_number": "१४-११२-२४", "content_sanskrit": "ब्रह्मणे चाग्नये चैव सोमाय वरुणाय च।\nविश्वेभ्यश्चैव देवेभ्यो दद्यादन्नं यथाक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2104672, "chapter_id": 3256, "verse_number": "१४-११२-२५", "content_sanskrit": "अवशिष्टमथैकं तु वक्त्रमात्रं प्रकल्पयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2104673, "chapter_id": 3256, "verse_number": "१४-११२-२६", "content_sanskrit": "अङ्गुल्यग्रे स्थितं पिण्डं गायत्र्या चाभिमन्त्रयेत्।\nअङ्गुलीभिस्त्रिभिः पिण्डं प्राश्नीयात्प्राङ्मुखःक शुचिः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2104674, "chapter_id": 3256, "verse_number": "१४-११२-२७", "content_sanskrit": "यथा च वर्धते सोमो ह्रसते च यथा पुनः।\nतथा पिण्डाश्च वर्धन्ते ह्रसन्ते च दिनेदिने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2104675, "chapter_id": 3256, "verse_number": "१४-११२-२८", "content_sanskrit": "त्रिकालं स्नानमस्योक्तं द्विकालमथवा सकृत्।\nब्रह्मचारी सदा वाऽपि न च वस्त्रं प्रपीडयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2104676, "chapter_id": 3256, "verse_number": "१४-११२-२९", "content_sanskrit": "स्थान न दिवसं तिष्ठेद्रात्रौ वीरासनं व्रजेत्।\nभवेत्स्थण्डिलशायी वाऽप्यथा वृक्षमूलिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2104677, "chapter_id": 3256, "verse_number": "१४-११२-३०", "content_sanskrit": "वल्कलं यदि वा क्षौमं शाणं कार्पासकं तथा।\nआच्छादनं भवेत्तस्य वस्त्रार्थं पाण्डुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2104678, "chapter_id": 3256, "verse_number": "१४-११२-३१", "content_sanskrit": "एवं चान्द्रायणे पूर्णे मासस्यान्ते प्रयत्नवान्।\nब्राह्मणान्भोजयेद्भक्त्या दद्याच्चैव च दक्षिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2104679, "chapter_id": 3256, "verse_number": "१४-११२-३२", "content_sanskrit": "चान्द्रायणेन चीर्णेन यत्कृतं तेन दुष्कृतम्।\nतत्सर्वं तत्क्षणादेव भस्मीभवति काष्ठवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2104680, "chapter_id": 3256, "verse_number": "१४-११२-३३", "content_sanskrit": "ब्रह्महत्या च गोहत्या सुवर्णस्तैन्यमेव च।\nभ्रूणहत्या सुरापानं गुरोर्दारव्यतिक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2104681, "chapter_id": 3256, "verse_number": "१४-११२-३४", "content_sanskrit": "एवमन्यानि पापानि पातकीयानि यानि च।\nचान्द्रायणेन नश्यन्ति वायुना पांसवो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2104682, "chapter_id": 3256, "verse_number": "१४-११२-३५", "content_sanskrit": "अनिर्दशाया गोः क्षीरमौष्ठ्रमाविकमेव च।\nमृतसूतकयोश्चान्नं भुक्त्वा चान्द्रायणं चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2104683, "chapter_id": 3256, "verse_number": "१४-११२-३६", "content_sanskrit": "उपपातकिनश्चान्नं पतितान्नं तथैव च।\nशूद्रस्योच्छेषणं चैव भुक्त्वा चान्द्रायणं चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2104684, "chapter_id": 3256, "verse_number": "१४-११२-३७", "content_sanskrit": "आकाशस्थं तु हस्तस्थमधः स्रस्तं तथैव च।\nपरहस्तस्थितं चैव भुक्त्वा चान्द्रायणं चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2104685, "chapter_id": 3256, "verse_number": "१४-११२-३८", "content_sanskrit": "अथाग्रेधिषोरन्नं दिधिषूपपतेस्तता।\nपरिवेत्तुस्तथा चान्नं परिवित्तान्नमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2104686, "chapter_id": 3256, "verse_number": "१४-११२-३९", "content_sanskrit": "कुण्डान्नं गोलकान्नं च देवलान्नं तथैव च।\nतथा पुरोहितस्यान्नं भुक्त्वा चान्द्रायणं चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2104687, "chapter_id": 3256, "verse_number": "१४-११२-४०", "content_sanskrit": "सुराऽऽसवं विषं सर्पिर्लाक्षा लवणमेव च।\nतैलं चापि च विक्रीणन्द्विजश्चान्द्रायणं चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2104688, "chapter_id": 3256, "verse_number": "१४-११२-४१", "content_sanskrit": "एकोद्दिष्टं तु यो भुङ्क्ते जनमध्यगतोऽपि यः।\nभिन्नभाण्डेषु यो भुङ्क्ते द्विजश्चान्द्रायणं चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2104689, "chapter_id": 3256, "verse_number": "१४-११२-४२", "content_sanskrit": "यो भुङ्क्तेऽनुपनीतेन यो भुङ्क्ते च स्त्रिया सह।\nकन्यया सह यो भुङ्क्ते द्विजश्चान्द्रायणं चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2104690, "chapter_id": 3256, "verse_number": "१४-११२-४३", "content_sanskrit": "उच्छिष्टं स्थापयेद्विप्रो यो मोहाद्भोजनान्तरे।\nदद्याद्वा यदि वा मोहाद्विजश्चान्द्रायणं चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2104691, "chapter_id": 3256, "verse_number": "१४-११२-४४", "content_sanskrit": "तुम्बकोशातकं चैव पलाण्डुं गृञ्जनं तथा।\nछत्राकं लशुनं चैव भुक्त्वा चान्द्रायणं चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2104692, "chapter_id": 3256, "verse_number": "१४-११२-४५", "content_sanskrit": "द्विजः पर्युषितं चान्नं पक्वं परगृहागतम्।\nविपक्वं च तथा मांसं भुक्त्वा चान्द्रायणं चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2104693, "chapter_id": 3256, "verse_number": "१४-११२-४६", "content_sanskrit": "उदक्यया शुना वाऽपि चण्डालैर्वा द्विजोत्तमः।\nदृष्टमन्नं तु भुञ्जानो द्विजश्चान्द्रायणं चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2104694, "chapter_id": 3256, "verse_number": "१४-११२-४७", "content_sanskrit": "****तत्पुरा विशुद्ध्यर्थमृषिभिश्चरितं व्रतम्।\nपावनं सर्वभूतानां पुण्यं पाण्डवचोदितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2104695, "chapter_id": 3256, "verse_number": "१४-११२-४८", "content_sanskrit": "एतेन वसवो रुद्राश्चादित्याश्च दिवं गताः।\nएतदद्य परं गुह्यं पवित्रं पापनाशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2104696, "chapter_id": 3256, "verse_number": "१४-११२-४९", "content_sanskrit": "यथोक्तमेतद्यः कुर्याद्द्विजः पापप्रणाशनम्॥\nस दिवं याति पूतात्मा निर्मलादित्यसंनिभः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2104697, "chapter_id": 3256, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि वैष्णवधर्मपर्वणि द्वादशाधिकशततमोऽध्यायः॥ ११२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]