[{"id": 5000597000, "chapter_id": 9597, "verse_number": "७-६२-१", "content_sanskrit": "तथोक्ते तानृषीन्रामः प्रत्युवाच कृताञ्जलिः ।\nकिमाहारः किमाचारो लवणः क्व च वर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000597001, "chapter_id": 9597, "verse_number": "७-६२-२", "content_sanskrit": "राघवस्य वचः श्रुत्वा ऋषयः सर्व एव ते ।\nततो निवेदयामासुर्लवणो ववृधे यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000597002, "chapter_id": 9597, "verse_number": "७-६२-३", "content_sanskrit": "आहारः सर्वसत्त्वानि विशेषेण च तापसाः ।\nआचारो रौद्रता नित्यं वासो मधुवने तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000597003, "chapter_id": 9597, "verse_number": "७-६२-४", "content_sanskrit": "हत्वा बहुसहस्राणि सिंहव्याघ्रमृगद्विपान् ।\nमानुषांश्चैव कुरुते नित्यमाहारमाह्निकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000597004, "chapter_id": 9597, "verse_number": "७-६२-५", "content_sanskrit": "ततो ऽन्तराणि सत्त्वानि खादते स महाबलः ।\nसंहारे समनुप्राप्ते व्यादितास्य इवान्तकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000597005, "chapter_id": 9597, "verse_number": "७-६२-६", "content_sanskrit": "तच्छ्रुत्वा राघवो वाक्यमुवाच स महामुनीन् ।\nघातयिष्यामि तद्रक्षो ह्यपगच्छतु वो भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000597006, "chapter_id": 9597, "verse_number": "७-६२-७", "content_sanskrit": "प्रतिज्ञाय तथा तेषां मुनीनामुग्रतेजसाम् ।\nस भ्रातऽन्सहितान्सर्वानुवाच रघुनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000597007, "chapter_id": 9597, "verse_number": "७-६२-८", "content_sanskrit": "को हन्ता लवणं वीरः कस्यांशः स विधीयताम् ।\nभरतस्य महाबाहोः शत्रुघ्नस्य च धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000597008, "chapter_id": 9597, "verse_number": "७-६२-९", "content_sanskrit": "राघवेणैवमुक्तस्तु भरतो वाक्यमब्रवीत् ।\nअहमेनं वधिष्यामि ममांशः स विधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000597009, "chapter_id": 9597, "verse_number": "७-६२-१०", "content_sanskrit": "भरतस्य वचः श्रुत्वा धैर्यशौर्यसमन्वितम् ।\nलक्ष्मणावरजस्तस्थौ हित्वा सौवर्णमासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000597010, "chapter_id": 9597, "verse_number": "७-६२-११", "content_sanskrit": "शत्रुघ्नस्त्वब्रवीद्वाक्यं प्रणिपत्य नराधिपम् ।\nकृतकर्मा महाबाहुर्मध्यमो रघुनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000597011, "chapter_id": 9597, "verse_number": "७-६२-१२", "content_sanskrit": "आर्येण हि पुरा शून्या त्वयोध्या परिपालिता ।\nसन्तापं हृदये कृत्वा आर्यस्यागमनं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000597012, "chapter_id": 9597, "verse_number": "७-६२-१३", "content_sanskrit": "दुःखानि च बहूनीह ह्यनुभूतानि पार्थिव ।\nशयानो दुःखशय्यासु नन्दिग्रामे ऽवसत्पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000597013, "chapter_id": 9597, "verse_number": "७-६२-१४", "content_sanskrit": "फलमूलाशनो भूत्वा जटी चीरधरस्तथा ।\nअनुभूयेदृशं दुःखमेष राघवनन्दनः ।\nप्रेष्ये मयि स्थिते राजन्न भूयः क्लेशमाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000597014, "chapter_id": 9597, "verse_number": "७-६२-१५", "content_sanskrit": "तथा ब्रुवति शत्रुघ्ने राघवः पुनरब्रवीत् ।\nएवं भवतु काकुत्स्थ क्रियतां मम शासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000597015, "chapter_id": 9597, "verse_number": "७-६२-१६", "content_sanskrit": "राज्ये त्वामभिषेक्ष्यामि मधोस्तु नगरे शुभे ।\nनिवेशय महाबाहो भरतं यद्यवेक्षसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000597016, "chapter_id": 9597, "verse_number": "७-६२-१७", "content_sanskrit": "शूरस्त्वं कृतविद्यश्च समर्थश्च निवेशने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000597017, "chapter_id": 9597, "verse_number": "७-६२-१८", "content_sanskrit": "यो हि शत्रुं समुत्पाट्य पार्थिवस्य पुनः क्षये ।\nन विधत्ते नृपं तत्र नरकं स हि गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000597018, "chapter_id": 9597, "verse_number": "७-६२-१९", "content_sanskrit": "स त्वं हत्वा मधुसुतं लवणं पापनिश्चयम् ।\nराज्यं प्रशाधि धर्मेण वाक्यं मे यद्यवेक्षसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000597019, "chapter_id": 9597, "verse_number": "७-६२-२०", "content_sanskrit": "उत्तरं च न वक्तव्यं शूर वाक्यान्तरे मम ।\nबालेन पूर्वजस्याज्ञा कर्तव्या नात्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000597020, "chapter_id": 9597, "verse_number": "७-६२-२१", "content_sanskrit": "अभिषेकं च काकुत्स्थ प्रतीच्छस्व मयोद्यतम् ।\nवसिष्ठप्रमुखैर्विप्रैर्विधिमन्त्रपुरस्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000597021, "chapter_id": 9597, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे द्विषष्टितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000597022, "chapter_id": 9597, "verse_number": null, "content_sanskrit": "॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]