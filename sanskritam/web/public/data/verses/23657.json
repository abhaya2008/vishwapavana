[{"id": 7003657000, "chapter_id": 23657, "verse_number": "१-२-४४-१", "content_sanskrit": "अर्जुन उवाच ।\nदिव्यप्राकारमिच्छामि श्रोतुं चाहं मुनीश्वर ।\nकथं कार्याणि कानीह स्फुटं यैः पुण्यपापकम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003657001, "chapter_id": 23657, "verse_number": "१-२-४४-२", "content_sanskrit": "नारद उवाच ।\nशपषाः पोशघटकौ विषाग्न तप्तमाषकौ ।\nफलं च तंदुलं चैव दिव्यान्यष्टौ विदुर्बुधाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003657002, "chapter_id": 23657, "verse_number": "१-२-४४-३", "content_sanskrit": "असाक्षिकेषु चार्थेषु मिथो विवदमानयोः ।\nराजद्रोहाभिशापेषु साहसेषु तथैव च ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003657003, "chapter_id": 23657, "verse_number": "१-२-४४-४", "content_sanskrit": "अविदस्तत्त्वतः सत्यं शपथेनाभिलंघयेत् ।\nमहर्षिभिश्च देवैश्च सत्यार्थाः शपथाः कृताः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003657004, "chapter_id": 23657, "verse_number": "१-२-४४-५", "content_sanskrit": "जवनो नृपतिः क्षीणो मिथ्याशपथमाचरेत् ।\nवसिष्ठाग्रे वर्षमध्ये सान्वयः किल भारत ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003657005, "chapter_id": 23657, "verse_number": "१-२-४४-६", "content_sanskrit": "अंधः शत्रुगृहं गच्छेद्यो मिथ्याशपथांश्चरेत् ।\nरौरवस्य स्वयं द्वारमुद्धाटयति दुर्मतिः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003657006, "chapter_id": 23657, "verse_number": "१-२-४४-७", "content_sanskrit": "मन्यंते वै पापकृतो न कश्चितपश्यतीति नः ।\nतांश्च देवाः प्रपश्यंति स्वस्यैवांतरपौरुषाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003657007, "chapter_id": 23657, "verse_number": "१-२-४४-८", "content_sanskrit": "आदित्यचंद्रावनिलोऽनलश्च द्यौर्भूमिरापो हृदयं यमश्च ।\nअहश्च रात्रिश्च उभे च संध्ये धर्मो हि जानाति नरस्य वृत्तम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003657008, "chapter_id": 23657, "verse_number": "१-२-४४-९", "content_sanskrit": "एवं तस्मादभिज्ञाय सत्यर्थशपथांश्चरेत् ।\nवृथा हि शपथान्कुर्वन्प्रेत्य चेह विनश्यति ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003657009, "chapter_id": 23657, "verse_number": "१-२-४४-१०", "content_sanskrit": "इदं सत्यं वदामीति ब्रुवन्साक्षी भवान्यतः ।\nशुभाशुभफलं देहि शुचिः पादौ रवेः स्वृशेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003657010, "chapter_id": 23657, "verse_number": "१-२-४४-११", "content_sanskrit": "अथ शास्त्रस्य विप्रोऽपि शस्त्रस्यापि च क्षत्रियः ।\nमां संस्पृशंस्तथा वैश्यः शुद्रः स्वगुरुमेव च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003657011, "chapter_id": 23657, "verse_number": "१-२-४४-१२", "content_sanskrit": "मातरं पितरं पूज्यं स्पृशेत्साधारणं त्विदम् ।\nकोशस्य रूपं पूर्वं ते व्याख्यातं पांडुनंदन ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003657012, "chapter_id": 23657, "verse_number": "१-२-४४-१३", "content_sanskrit": "विप्रवर्ज्यं तथा केशं वर्णिनां दापयेन्नृपः ।\nयो यो यद्देवताभक्तः पाययेत्तस्य तं नरम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003657013, "chapter_id": 23657, "verse_number": "१-२-४४-१४", "content_sanskrit": "समभक्तं च देवानामादित्यस्यैव पाययेत् ।\nसर्वेषां चोग्रदेवानां स्नापयेदायुधास्त्रकम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003657014, "chapter_id": 23657, "verse_number": "१-२-४४-१५", "content_sanskrit": "स्नानोदकं वा संकल्पं गृहीत्वा पाययेन्नवम् ।\nत्रिसप्तरात्रमध्ये च फलं कोशस्य निर्दिशेत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003657015, "chapter_id": 23657, "verse_number": "१-२-४४-१६", "content_sanskrit": "अतः परं महादिव्यविधानं श्रृणु यद्भवेत् ।\nसंशयच्छेदि सर्वेषां धार्ष्ट्यत्तद्दिव्यमेव च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003657016, "chapter_id": 23657, "verse_number": "१-२-४४-१७", "content_sanskrit": "सशिरस्कंप्रदातव्यमिति ब्रह्मा पुराब्रवीत् ।\nमहोग्राणां च दातव्यमशिरस्कमपि स्फुटम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003657017, "chapter_id": 23657, "verse_number": "१-२-४४-१८", "content_sanskrit": "साधूनां वर्णिनां राजा न शिरस्कं प्रदापयेत् ।\nन प्रवातेधटं देयं नोष्णकाले हुताशनम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003657018, "chapter_id": 23657, "verse_number": "१-२-४४-१९", "content_sanskrit": "वर्णिनां च तथा कालं तंदुलं मुखरोगिणाम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003657019, "chapter_id": 23657, "verse_number": "१-२-४४-२०", "content_sanskrit": "कुष्ठपित्तार्दितानां च ब्राह्मणानां च नो विषम् ।\nतप्तमाषकमर्हंति सर्वे धर्म्यं निरत्ययम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003657020, "chapter_id": 23657, "verse_number": "१-२-४४-२१", "content_sanskrit": "न व्याधिमरके देशे शपथान्कोशमेव च ।\nदिव्यान्यासुरकैर्मंत्रैः स्तंभयंतीह केचन ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003657021, "chapter_id": 23657, "verse_number": "१-२-४४-२२", "content_sanskrit": "प्रतिघातविदस्तेषां योजयेद्धर्मवत्सलान् ।\nदिव्यानां स्तभकाञ्ज्ञात्वा पापान्नित्यं महीपतिः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003657022, "chapter_id": 23657, "verse_number": "१-२-४४-२३", "content_sanskrit": "विवासयेत्स्वकाद्राष्ट्रात्ते हि लोकस्य कंटकाः ।\nतेषामन्वेषणे यत्नं राजा नित्यं समाचरेत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003657023, "chapter_id": 23657, "verse_number": "१-२-४४-२४", "content_sanskrit": "ते हि पापसमाचारास्तस्करेभ्योऽपि तस्कराः ।\nप्राग्दृष्टदोषान्स्वल्पेषु दिव्येषु विनियोजयेत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003657024, "chapter_id": 23657, "verse_number": "१-२-४४-२५", "content_sanskrit": "महत्स्वपि न चार्थेषु धर्मज्ञान्धर्मवत्सलान् ।\nन मिथ्यावचनं येषां जन्मप्रभृति विद्यते ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003657025, "chapter_id": 23657, "verse_number": "१-२-४४-२६", "content_sanskrit": "श्रद्दध्यात्पार्थिवस्तेषां वचना देव भारत ।\nज्ञात्वा धर्मिष्ठतां राजा पुरुषस्य विचक्षणः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003657026, "chapter_id": 23657, "verse_number": "१-२-४४-२७", "content_sanskrit": "क्रोधाल्लोभात्कारयंश्च स्वयमेव प्रदुष्यति ।\nतस्मात्पापिषु दिव्यं स्यात्तत्रादौ प्रोच्यते धटे ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003657027, "chapter_id": 23657, "verse_number": "१-२-४४-२८", "content_sanskrit": "सुसमायां पृथिव्यां च दिग्भागे पूर्वदक्षिणे ।\nयज्ञियस्य तु वृक्षस्य स्थाप्यं स्यान्मुंडकद्वयम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003657028, "chapter_id": 23657, "verse_number": "१-२-४४-२९", "content_sanskrit": "स्तंभकस्य प्रमाणं च सप्तहस्तं प्रकीर्तितम् ।\nद्वौ हस्तौ निखनेत्काष्ठं दृश्यं स्याद्धस्तपंचकम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003657029, "chapter_id": 23657, "verse_number": "१-२-४४-३०", "content_sanskrit": "अंतरं तु तयोः कार्यं तथा हस्तचतुष्टयम् ।\nमुंडकोपरि काष्ठं च दृढं कुर्याद्विचक्षणः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003657030, "chapter_id": 23657, "verse_number": "१-२-४४-३१", "content_sanskrit": "चतुर्हस्तं तुलाकाष्ठमव्रणं कारयेत्स्थिरम् ।\nखदिरार्जुनवृक्षाणां शिंशपाशालजं त्वथ ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003657031, "chapter_id": 23657, "verse_number": "१-२-४४-३२", "content_sanskrit": "तुलाकाष्ठे तु कर्तव्यं तथा वै शिक्यकद्वयम् ।\nप्राङ्मुखो निश्चलः कार्यः शुचौ देशे धटस्तथा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003657032, "chapter_id": 23657, "verse_number": "१-२-४४-३३", "content_sanskrit": "पाषाणस्यापि जायेत् स्तंभेषु च धटस्तथा ।\nवणिक्सुवर्णकारो वा कुशलः कांस्यकारकः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003657033, "chapter_id": 23657, "verse_number": "१-२-४४-३४", "content_sanskrit": "तुलाधारधरः कार्यो रिपौ मित्रे च यः समः ।\nश्रावयेत्प्राड्विवाकोऽपि तुलाधारं विचक्षणः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003657034, "chapter_id": 23657, "verse_number": "१-२-४४-३५", "content_sanskrit": "ब्रह्मघ्ने ये स्मृता लोका ये च स्त्रीबालघातके ।\nतुलाधारस्य ते लोकास्तुलां धारयतो मृषा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003657035, "chapter_id": 23657, "verse_number": "१-२-४४-३६", "content_sanskrit": "एकस्मिंस्तोलयेच्छिक्ये ज्ञातं सूपोषितं नरम् ।\nद्वितीये मृत्तिकां शुभ्रां गौरां तु तुलयेद्बुधः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003657036, "chapter_id": 23657, "verse_number": "१-२-४४-३७", "content_sanskrit": "इष्टिकाभस्मपाषाणकपालास्थीनि वर्जयेत् ।\nतोलयित्वा ततः पूर्वं तस्मात्तमवतारयेत् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003657037, "chapter_id": 23657, "verse_number": "१-२-४४-३८", "content_sanskrit": "मूर्ध्नि पत्रं ततो न्यस्य न्यस्तपत्रं निवेशयेत् ।\nपत्रे मंत्रस्त्वयं लेख्यो यः पुरोक्तः श्वयंभुवा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003657038, "chapter_id": 23657, "verse_number": "१-२-४४-३९", "content_sanskrit": "ब्रह्मणस्त्वं सुता देवी तुलानाम्नेति कथ्यते ।\nतुकारो गौरवे नित्यं लकारो लघुनि स्मृतः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003657039, "chapter_id": 23657, "verse_number": "१-२-४४-४०", "content_sanskrit": "गुरुलाघवसंयोगात्तुला तेन निगद्यसे ।\nसंशयान्मोचयस्वैनमभिशस्तं नरं शुभे ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003657040, "chapter_id": 23657, "verse_number": "१-२-४४-४१", "content_sanskrit": "भूय आरोपयेत्तं तु नरं तस्मिन्सपत्रकम् ।\nतुलितो यदि वर्धेत शुद्धो भवति धर्मतः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003657041, "chapter_id": 23657, "verse_number": "१-२-४४-४२", "content_sanskrit": "हीयमानो न शुद्धः स्यादिति धर्मविदो विदुः ।\nशिक्यच्छेदे तुलाभंगे पुनरारोपयेन्नरम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003657042, "chapter_id": 23657, "verse_number": "१-२-४४-४३", "content_sanskrit": "एवं निःसंशयं ज्ञानं यच्चान्यायं न लोपयेत् ।\nएतत्सर्वं रवौ वारे कार्यं संपूज्य भास्करम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003657043, "chapter_id": 23657, "verse_number": "१-२-४४-४४", "content_sanskrit": "अथातः संप्रवक्ष्यामि विषदिव्यं श्रृणुष्व मे ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003657044, "chapter_id": 23657, "verse_number": "१-२-४४-४५", "content_sanskrit": "द्विप्रकारं च तत्प्रोक्तं घटसर्पविषं तथा ।\nशृंगिणो वत्सनाभस्य हिमशैलभवस्य वा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003657045, "chapter_id": 23657, "verse_number": "१-२-४४-४६", "content_sanskrit": "यवाः सप्त प्रदातव्या अथवा षड्घृतप्लुताः ।\nमूर्ध्नि विन्यस्तपत्रस्य पत्रे चैवं निवेशयेत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003657046, "chapter_id": 23657, "verse_number": "१-२-४४-४७", "content_sanskrit": "त्वं विष ब्रह्मणः पुत्र सत्यधर्मे व्यवस्थितः ।\nत्रायस्वैनं नरं पापात्सत्येनास्य भवामृतम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003657047, "chapter_id": 23657, "verse_number": "१-२-४४-४८", "content_sanskrit": "येन वेगैर्विना जीर्णं छर्दिमूर्च्छाविवर्जितम् ।\nतं तु शुद्धं विजानीयादिति धर्मविदो विदुः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003657048, "chapter_id": 23657, "verse_number": "१-२-४४-४९", "content_sanskrit": "क्षुधितं क्षुधितः सर्पं घटस्थं प्रोच्य पूर्ववत् ।\nसंस्पृशेत्तालिकाः सप्त न दशेच्छुध्यतीति सः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003657049, "chapter_id": 23657, "verse_number": "१-२-४४-५०", "content_sanskrit": "अग्निदिव्यं यथा प्राह विरंचिस्तच्छृणुष्व मे ।\nसप्तमंडलकान्कुर्याद्देवस्याग्रे रवेस्तथा ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003657050, "chapter_id": 23657, "verse_number": "१-२-४४-५१", "content_sanskrit": "मंडलान्मंडलं कार्यं पूर्वेणेति विनिश्चयः ।\nषोडशांतुलकं कार्यं मंडलात्तावदं तरम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003657051, "chapter_id": 23657, "verse_number": "१-२-४४-५२", "content_sanskrit": "आर्द्रवाससमाहूय तथा चैवाप्युपोपितम् ।\nकारयेत्सर्वदिव्यानि देवब्राह्मणसंनिधौ ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003657052, "chapter_id": 23657, "verse_number": "१-२-४४-५३", "content_sanskrit": "प्रत्यक्षं कारयेद्दिव्यं राज्ञो वाधिकृतस्य वा ।\nब्राह्मणानां श्रुतवतां प्रकृतीनां तथैव च ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003657053, "chapter_id": 23657, "verse_number": "१-२-४४-५४", "content_sanskrit": "पश्चिमे दिनकाले हि प्राङ्मुखः प्राञ्जलिः शुचिः ।\nचतुरस्रे मंडलेऽन्ये कृत्वा चैव समौ करौ ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003657054, "chapter_id": 23657, "verse_number": "१-२-४४-५५", "content_sanskrit": "लक्षयेयुः कृतादीनि हस्तयोस्तस्य हारिणः ।\nसप्ताश्वत्थस्य पत्राणि भध्नीयुः करयोस्ततः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003657055, "chapter_id": 23657, "verse_number": "१-२-४४-५६", "content_sanskrit": "नवेन कृतसूत्रेण कार्पासेन दृढं यथा ।\nततस्तु सुसमं कृत्वा अष्टांगुलमथायसम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003657056, "chapter_id": 23657, "verse_number": "१-२-४४-५७", "content_sanskrit": "पिंडं हुताशसंतप्तं पंचाशत्पलिकं दृढम् ।\nआदौ पूजां रवेः कृत्वा हुताशस्याथ कारयेत् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003657057, "chapter_id": 23657, "verse_number": "१-२-४४-५८", "content_sanskrit": "रक्तचंदनधूपाभ्यां रक्तपुष्पैस्तथैव च ।\nअभिशस्तस्य पत्रं च बध्नीयाच्चैव मूर्धनि ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003657058, "chapter_id": 23657, "verse_number": "१-२-४४-५९", "content_sanskrit": "मंत्रेणानेन संयुक्तं ब्राह्मणाभिहितेन च ।\nत्वमग्ने वेदाश्चत्वारस्त्वं च यज्ञेषु हूयसे ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003657059, "chapter_id": 23657, "verse_number": "१-२-४४-६०", "content_sanskrit": "पापं पुनासि वै यस्मात्तस्मात्पावक उच्यसे ।\nत्वं मुखं सर्वदेवानां त्वं मुखं ब्रह्मवादिनाम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003657060, "chapter_id": 23657, "verse_number": "१-२-४४-६१", "content_sanskrit": "जठरस्थोऽसि भूतानां ततो वेत्सि शुभाशुभम् ।\nपापेषु दर्शयात्मानमर्चिष्मान्भव पावक ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003657061, "chapter_id": 23657, "verse_number": "१-२-४४-६२", "content_sanskrit": "अथवा शुद्धभावेषु शीतो भवमहाबल ।\nततोऽभिशस्तः शनकैर्मंडलानि परिक्रमेत् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003657062, "chapter_id": 23657, "verse_number": "१-२-४४-६३", "content_sanskrit": "परिक्रम्य शनैर्जह्याल्लोहपिंडं ततः क्षितौ ।\nविपत्रहस्तं तं पश्चात्कारयेद्व्रीहिमर्दनम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003657063, "chapter_id": 23657, "verse_number": "१-२-४४-६४", "content_sanskrit": "निर्विकारौ करौ दृष्ट्वा शुद्धो भवति धर्मतः ।\nभयाद्वा पातयेद्यस्तु तदधो वा विभाव्यते ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003657064, "chapter_id": 23657, "verse_number": "१-२-४४-६५", "content_sanskrit": "पुनस्त्वाहारयेल्लोहं विधिरेष प्रकीर्तितः ।\nअथातः संप्रऐवक्ष्यामि तप्तमाषविधिं श्रृणु ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003657065, "chapter_id": 23657, "verse_number": "१-२-४४-६६", "content_sanskrit": "कारयेदायसं पात्रं ताम्रं वा षोडशांगुलम् ।\nचतुरंगुलखातं तु मृन्मयं वापि कारयेत् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003657066, "chapter_id": 23657, "verse_number": "१-२-४४-६७", "content_sanskrit": "पूरयेद्घृततैलाभ्यां पलैर्विशतिभिस्ततः ।\nसुतप्ते निक्षिपेत्तत्र सुवर्णस्य तु माषकम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003657067, "chapter_id": 23657, "verse_number": "१-२-४४-६८", "content_sanskrit": "वह्न्युक्तं विन्यसेन्मंत्रमभिशस्तस्य मूर्धनि ।\nअंगुष्ठांगुलियोगेन तप्तमाषं समुद्धरेत् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003657068, "chapter_id": 23657, "verse_number": "१-२-४४-६९", "content_sanskrit": "शुद्धं ज्ञेयमसंदिग्धं विस्फोटादिविवर्जितम् ।\nफालशुद्धिं प्रवक्ष्यामि तां श्रृणु त्वं धनंजय ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003657069, "chapter_id": 23657, "verse_number": "१-२-४४-७०", "content_sanskrit": "आयसं द्वादशपलं घटितं फालमुच्यते ।\nअष्टांगुलमदीर्घं च चतुरंगुलविस्तृतम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003657070, "chapter_id": 23657, "verse_number": "१-२-४४-७१", "content_sanskrit": "वह्न्युक्तं विन्यसेन्मंत्रमभिशस्तस्य मूर्धनि ।\nत्रिःपरावर्तयेज्जिह्वा लिहन्नस्मात्षडंगुलम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003657071, "chapter_id": 23657, "verse_number": "१-२-४४-७२", "content_sanskrit": "गवां क्षीरं प्रदातव्यं जिह्वाशोधनमुत्तमम् ।\nजिह्वापरीक्षणं कुर्याद्दग्धा चेन्न तु विमोच्यते ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003657072, "chapter_id": 23657, "verse_number": "१-२-४४-७३", "content_sanskrit": "तं विशुद्धं विजानीयाद्विशुद्धा चेत्तु जायते ।\nतंदुलस्याथ वक्ष्यामि विधिधर्मं सनातनम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003657073, "chapter_id": 23657, "verse_number": "१-२-४४-७४", "content_sanskrit": "चौर्ये तु तंदुला देया न चान्यत्र कथंचन ।\nतंदुलानुदके सिक्त्वा रात्रौ तत्रैव स्थापयेत् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003657074, "chapter_id": 23657, "verse_number": "१-२-४४-७५", "content_sanskrit": "प्रभाते कारिणे देया भक्षणाय न संशयः ।\nत्रिःकॉत्वः प्राङ्मुखश्चैव पत्रे निष्ठीवयेत्ततः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003657075, "chapter_id": 23657, "verse_number": "१-२-४४-७६", "content_sanskrit": "पिप्पलस्याथ भूर्जस्य न त्वन्यस्य कथंचन ।\nतांस्तु वै कारयेच्छुद्धांस्तंदुलाञ्छालिसंभवान् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003657076, "chapter_id": 23657, "verse_number": "१-२-४४-७७", "content_sanskrit": "मृन्मये भाजने कृत्वा सवितुः पुरतः स्थितः ।\nतन्दुलान्मंत्रयेच्छुद्धान्मन्त्रेणानेन धर्मतः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003657077, "chapter_id": 23657, "verse_number": "१-२-४४-७८", "content_sanskrit": "दीयसे धर्मतत्त्वज्ञैर्मानुषाणां विशोधनम् ।\nस्तुतस्तन्दुल सत्येन धर्मतस्त्रातुमर्हसि ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003657078, "chapter_id": 23657, "verse_number": "१-२-४४-७९", "content_sanskrit": "निष्ठीवने कृते तेषां सवितुः पुरतः स्थिते ।\nशोणितं दृश्यते यस्य तमशुद्धं विनिर्दिशेत् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003657079, "chapter_id": 23657, "verse_number": "१-२-४४-८०", "content_sanskrit": "एवमष्टविधं दिव्यं पापसंशयच्छेदनम् ।\nभट्टादित्यस्य पुरतो जायते कुरुनंदन ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003657080, "chapter_id": 23657, "verse_number": "१-२-४४-८१", "content_sanskrit": "जलदिव्यं तथा प्राहुर्द्विप्रकारं पुराविदः ।\nजलहस्तं स्मृतं चैकं मज्जनं चापरं विदुः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003657081, "chapter_id": 23657, "verse_number": "१-२-४४-८२", "content_sanskrit": "बाणक्षेपस्तथादानं यावद्वीर्यवता कृतम् ।\nतावत्तं मज्जयेज्जीवेत्तथा तच्छुद्धिमादिशेत् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003657082, "chapter_id": 23657, "verse_number": "१-२-४४-८३", "content_sanskrit": "एवंविधमिदं स्थानं भट्टादित्यस्य भारत ।\nममैव कृपया भानोर्जातमेतन्महीतले ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}]