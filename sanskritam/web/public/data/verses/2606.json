[{"id": 2075826, "chapter_id": 2606, "verse_number": "१२-१११-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2075827, "chapter_id": 2606, "verse_number": "१२-१११-१", "content_sanskrit": "असौम्याः सौम्यरूपेण सौम्याश्चासौम्यरूपिणः।\nतादृशान्पुरुषांस्तात कथं विद्यामहे वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2075828, "chapter_id": 2606, "verse_number": "१२-१११-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2075829, "chapter_id": 2606, "verse_number": "१२-१११-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nव्याघ्रगोमायुसंवादं तं निबोध युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2075830, "chapter_id": 2606, "verse_number": "१२-१११-३", "content_sanskrit": "पुरिकायां पुरि पुरा श्रीमत्यां पौरिको नृपः।\nपररिंसापरः क्रूरो बभूव पुरुषाधमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2075831, "chapter_id": 2606, "verse_number": "१२-१११-४", "content_sanskrit": "स त्वायुषि परिक्षीणे जगामानीप्सितां गतिम्।\nगोमायुत्वं च संप्राप्तो दूषितः पूर्वकर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2075832, "chapter_id": 2606, "verse_number": "१२-१११-५", "content_sanskrit": "संस्मृत्य पूर्वजातिं स्वां निर्वेदं परमं गतः।\nन भक्षयन्ति मांसानि परैरुपहृतान्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2075833, "chapter_id": 2606, "verse_number": "१२-१११-६", "content_sanskrit": "अहिंसा सर्वभूतेषु सत्यवाक् सुदृढव्रतः।\nचकार च यथाकालमाहारं पतितैः फलैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2075834, "chapter_id": 2606, "verse_number": "१२-१११-७", "content_sanskrit": "`पर्णहारः कदाचिच्च नियमव्रतवानपि।\nकदा चदुदकेनापि वर्तयन्न तु यन्त्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2075835, "chapter_id": 2606, "verse_number": "१२-१११-८", "content_sanskrit": "श्मशाने तस्य चावासो गोमायोः संमतोऽभवत्।\nजन्मभूम्यनुरोधाच्च नान्यं वा समरोचयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2075836, "chapter_id": 2606, "verse_number": "१२-१११-९", "content_sanskrit": "तस्य शौचममृष्यन्तस्ते सर्वे सहजातयः।\nचालयन्ति स्म तां बुद्धिं वचनैः प्रश्रयोत्तरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2075837, "chapter_id": 2606, "verse_number": "१२-१११-१०", "content_sanskrit": "वसन्पितृवने रौद्रे शौचं लम्भितुमिच्छसि।\nइयं विप्रतिपत्तिस्ते यदा त्वं पिशिताशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2075838, "chapter_id": 2606, "verse_number": "१२-१११-११", "content_sanskrit": "तत्समानो भवात्समाभिर्भक्ष्यं दास्यामहे वयम्।\nभुङ्क्ष्व शौचं परित्यज्य यद्धि भुक्तं तदस्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2075839, "chapter_id": 2606, "verse_number": "१२-१११-१२", "content_sanskrit": "इति तेषां वचः श्रुत्वा प्रत्युवाच समाहितः।\nमधुरैः प्रश्रितैर्वाक्यैर्हेतुमद्भिरनिष्ठुरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2075840, "chapter_id": 2606, "verse_number": "१२-१११-१३", "content_sanskrit": "अप्रमाणा प्रसूतिर्मे शीलतः क्रियते कुलम्।\nप्रार्थयामि च तत्कर्म येन विस्तीर्यते यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2075841, "chapter_id": 2606, "verse_number": "१२-१११-१४", "content_sanskrit": "श्मशाने यदि मे वासः समाधिर्मे निशाम्यताम्।\nआत्मा फलति कर्माणि नाश्रमो धर्मलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2075842, "chapter_id": 2606, "verse_number": "१२-१११-१५", "content_sanskrit": "आश्रमे यो द्विजं हन्याद्दानं दद्यादनाश्रमे।\nकिंतु तत्पातकं न स्यात्तद्वा दानं वृथा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2075843, "chapter_id": 2606, "verse_number": "१२-१११-१६", "content_sanskrit": "भवन्तः स्वार्थलोभेन केवलं भक्षणे रताः।\nअनुबन्धेषु ये दोषास्तान्न पश्यन्ति मोहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2075844, "chapter_id": 2606, "verse_number": "१२-१११-१७", "content_sanskrit": "अप्रत्ययकृतां गर्ह्यामर्थापनयदूषिताम्।\nइह चामुत्र चानिष्टां तस्माद्वृत्तिं न रोचये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2075845, "chapter_id": 2606, "verse_number": "१२-१११-१८", "content_sanskrit": "तं शुचिं पण्डितं मत्वा शार्दूलः ख्यातविक्रमः।\nकृत्वाऽऽत्मसदृशीं पूजां साचिव्येऽवरयत्स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2075846, "chapter_id": 2606, "verse_number": "१२-१११-१९x", "content_sanskrit": "शार्दूल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2075847, "chapter_id": 2606, "verse_number": "१२-१११-१९", "content_sanskrit": "सौम्य विज्ञातरूपस्त्वं गच्छ यात्रां मया सह।\nव्रियन्तामीप्सिता भोगाः परिहार्याश्च पुष्कलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2075848, "chapter_id": 2606, "verse_number": "१२-१११-२०", "content_sanskrit": "तीक्ष्णा इति वयं ख्याता भवन्तं ज्ञापयामहे।\nमृदुपूर्वं प्रशाधि त्वं श्रेयश्चाधिगमिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2075849, "chapter_id": 2606, "verse_number": "१२-१११-२१x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2075850, "chapter_id": 2606, "verse_number": "१२-१११-२१", "content_sanskrit": "अथं संपूज्य तद्वाक्यं मृगेन्द्रस्य महात्मनः।\nगोमायुः प्रश्रितं वाक्यं बभाषे किंचिदानतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2075851, "chapter_id": 2606, "verse_number": "१२-१११-२२", "content_sanskrit": "सदृशं मृगराजैतत्तव वाक्यं मदन्तरे।\nयत्सहायान्मृगयसे धर्मार्थकुशलाञ्शुचीन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2075852, "chapter_id": 2606, "verse_number": "१२-१११-२३", "content_sanskrit": "न शक्यं ह्यनमात्येन महत्त्वमनुशासितुम्।\nदुष्टामात्येन वा वीर शरीरपरिपन्थिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2075853, "chapter_id": 2606, "verse_number": "१२-१११-२४", "content_sanskrit": "सहायाननुरक्तांश्च नयज्ञानुपसंहितान्।\nपरस्परमसंतुष्टान्विजिगीषूनलोलुपात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2075854, "chapter_id": 2606, "verse_number": "१२-१११-२५", "content_sanskrit": "अनतीतोपदान्प्राज्ञान्हिते युक्तान्मनस्विनः।\nपूजयेथा महाभाग यथा भ्रातृन्यथा पितॄन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2075855, "chapter_id": 2606, "verse_number": "१२-१११-२६", "content_sanskrit": "न त्वेव मम संतोषाद्रोचतेऽन्यन्मृगाधिप।\nन कामये सुखान्भोगानैश्वर्यं वा त्वदाश्रयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2075856, "chapter_id": 2606, "verse_number": "१२-१११-२७", "content_sanskrit": "न योक्ष्यति हि मे शीलं तव भृत्यैः पुरातनैः।\nते त्यां विभेदयिष्यन्ति दुःखशीला मदन्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2075857, "chapter_id": 2606, "verse_number": "१२-१११-२८", "content_sanskrit": "संश्रयः श्लाघनीयस्त्वमन्येषामपि भास्वताम्।\nकृतात्मा सुमहाभागः पापकेष्वप्यदारुणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2075858, "chapter_id": 2606, "verse_number": "१२-१११-२९", "content_sanskrit": "दीर्घदर्शी महोत्साहः स्थूललक्षो महाबलः।\nकृते चामोघकर्ताऽसि भाग्यैश्च समलंकृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2075859, "chapter_id": 2606, "verse_number": "१२-१११-३०", "content_sanskrit": "किंतु स्वेनास्मि संतुष्टो दुःखा वृत्तिरनुष्ठिता।\nसेवायां चापि नाभिज्ञः स्वच्छन्देन वनेचरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2075860, "chapter_id": 2606, "verse_number": "१२-१११-३१", "content_sanskrit": "प्राज्ञोपक्रोशदोषाश्च सर्वे संश्रयवासिनाम्।\nवनचर्या तु निःसङ्गा निर्भया विरवग्रहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2075861, "chapter_id": 2606, "verse_number": "१२-१११-३२", "content_sanskrit": "नृपेण हियमाणस्य यत्तिष्ठति भयं हृदि।\nन तत्तिष्ठति तुष्टानां वने मूलफलाशिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2075862, "chapter_id": 2606, "verse_number": "१२-१११-३३", "content_sanskrit": "पानीयं वा निरायासं स्वाद्वन्नं वा गुणोत्तरम्।\nविचार्य खलु पश्यामि तत्सुखं यत्र निर्वृत्तिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2075863, "chapter_id": 2606, "verse_number": "१२-१११-३४", "content_sanskrit": "अपराधैर्न तावन्तो भृत्याः शिष्टा नराधिपैः।\nअपजातैर्यथा भृत्या दूषिताः निधनं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2075864, "chapter_id": 2606, "verse_number": "१२-१११-३५", "content_sanskrit": "यदि वा तन्ममा कार्यं मृगेन्द्र यदि मन्यसे।\nसमयं कृतमिच्छामि वर्तितव्यं यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2075865, "chapter_id": 2606, "verse_number": "१२-१११-३६", "content_sanskrit": "मदीया माननीयास्ते श्रोतव्यं च हितं वचः।\nकल्पिता या च मे वृत्तिः सा भवेत्त्वयि सुस्थिरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2075866, "chapter_id": 2606, "verse_number": "१२-१११-३७", "content_sanskrit": "न ------- सचिवैः सह कर्हिचित्।\nतीतिमन्तः परीप्सन्तो वृथा ब्रूयुः परे मयि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2075867, "chapter_id": 2606, "verse_number": "१२-१११-३८", "content_sanskrit": "एक एकेन संगम्य रहो ब्रूयां हितं वचः।\nनच ते शातिकार्येषु प्रष्टत्र्योऽस्मि हिताहिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2075868, "chapter_id": 2606, "verse_number": "१२-१११-३९", "content_sanskrit": "--- --- पश्चाच्च न हिंस्याः सचिवास्त्वया।\nमदीयानां च कुपितो मा त्वं दण्डं निपातयेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2075869, "chapter_id": 2606, "verse_number": "१२-१११-४०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2075870, "chapter_id": 2606, "verse_number": "१२-१११-४०", "content_sanskrit": "एवमस्त्विति तेनासौ मृगेन्द्रेणाभिपूजितः।\nप्राप्तवान्मतिसाचिव्यं गोमायुर्व्याघ्रचोदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2075871, "chapter_id": 2606, "verse_number": "१२-१११-४१", "content_sanskrit": "तं तथा सत्कृतं दृष्ट्वा युज्यमानं च कर्मसु।\nप्राद्विषन्कृतसंघाताः पूर्वभृत्या मुहुर्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2075872, "chapter_id": 2606, "verse_number": "१२-१११-४२", "content_sanskrit": "मित्रबुद्ध्या च गोमायुं सान्त्वयित्वा प्रवेश्य च।\nदोषेषु समयान्नेतुमिच्छन्त्यशुभबुद्धयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2075873, "chapter_id": 2606, "verse_number": "१२-१११-४३", "content_sanskrit": "अन्यथा ह्युषिताः पूर्वं परद्रव्यापहारिणः।\nअशक्ताः किंचिदाहर्तुं द्रव्यं गोमायुयन्त्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2075874, "chapter_id": 2606, "verse_number": "१२-१११-४४", "content_sanskrit": "व्युत्थानं चात्र काङ्क्षद्भिः कथाभिः प्रतिलोभ्यते।\nधनेन महता चैव बुद्धिरस्य विलोभ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2075875, "chapter_id": 2606, "verse_number": "१२-१११-४५", "content_sanskrit": "न चापि स महाप्राज्ञस्तस्माद्वैर्याच्चचाल ह।\nअथास्य समयं कृत्वा विनाशाय स्थिताः परे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2075876, "chapter_id": 2606, "verse_number": "१२-१११-४६", "content_sanskrit": "ईप्सितं तु मृगेन्द्रस्य मांसं यत्तत्र संस्कृतम्।\nअपनीय स्वयं तद्धि तैर्न्यस्तं तस्य वेश्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2075877, "chapter_id": 2606, "verse_number": "१२-१११-४७", "content_sanskrit": "यदर्थं चाप्यपहृतं येन तच्चैव मन्त्रितम्।\nतस्य तद्विदितं सर्वं कारणार्थं च मर्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2075878, "chapter_id": 2606, "verse_number": "१२-१११-४८", "content_sanskrit": "समयोऽयं कृतस्तेन साचिव्यमुपगच्छता।\nनोपघातस्त्वया कार्यो राजन्मैत्रीमिहेच्छता\n`इति तस्य च मन्त्रस्य स्थित्यर्थं तदुपेक्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2075879, "chapter_id": 2606, "verse_number": "१२-१११-४९", "content_sanskrit": "[क्षुधितस्य मृगेन्द्रस्य भोक्तुमभ्युत्थितस्य च]\nभोजने चोपहर्तव्ये तन्मांसं नह्यदृश्यत।\nमृगराजेन चाज्ञप्तं मृग्यतां चोर इत्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2075880, "chapter_id": 2606, "verse_number": "१२-१११-५०", "content_sanskrit": "कृतकैश्चापि तन्मांसं मृगेन्द्राय निवेदितम्।\nसचिवेनापनीतं ते विदुषा प्राज्ञमानिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2075881, "chapter_id": 2606, "verse_number": "१२-१११-५१", "content_sanskrit": "सरोषस्त्वध शार्दूलः श्रुत्वा गोमायुचापलम्।\nबभूवामर्षितो राजा वधं चास्य व्यरोचयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2075882, "chapter_id": 2606, "verse_number": "१२-१११-५२", "content_sanskrit": "छिद्रं तु तस्य तदृष्ट्वा प्रोचुस्ते पूर्वमन्त्रिणः।\nसर्वेषामेव सोऽस्माकं वृत्तिभङ्गे प्रवर्तते।\nनिश्चित्यैवं पुनस्तस्य ते तत्कर्मण्यवर्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2075883, "chapter_id": 2606, "verse_number": "१२-१११-५३", "content_sanskrit": "इदं तस्येदृशं कर्म किं तेन न कृतं भवेत्।\nश्रुतश्च स्वामिना पूर्वं यादृशो नैव तादृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2075884, "chapter_id": 2606, "verse_number": "१२-१११-५४", "content_sanskrit": "वाङ्भात्रेणैव धर्मिष्ठः स्वभावेन तु दारुणः।\nधर्मच्छझा ह्ययं पापो वृथाचारपरिग्रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2075885, "chapter_id": 2606, "verse_number": "१२-१११-५५", "content_sanskrit": "कार्यार्थं भोजनाद्येषु व्रतेषु कृतवाञ्श्रमम्।\nयदि विप्रत्ययो ह्येष तदिदं दर्शयाम् ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2075886, "chapter_id": 2606, "verse_number": "१२-१११-५६", "content_sanskrit": "तन्मांसं तैश्च गोमायोस्तत्क्षणादाशु ढौकितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2075887, "chapter_id": 2606, "verse_number": "१२-१११-५७", "content_sanskrit": "मांसापनयनं श्रुत्वा व्याघ्रस्तेषां च तद्वचः।\nआज्ञापयामास तदा गोमायुर्वध्यतामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2075888, "chapter_id": 2606, "verse_number": "१२-१११-५८", "content_sanskrit": "गोमायोर्व्यसनं श्रुत्वा शार्दूलजननी ततः।\nमृगराजं हितैर्वाक्यैः संबोधयितुमागमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2075889, "chapter_id": 2606, "verse_number": "१२-१११-५९", "content_sanskrit": "पुत्र नैतत्त्वया ग्राह्यं कपटारम्भसंयुतम्।\nकर्म संघर्षजैर्दोषैर्दुष्येताशुचिभिः सुचिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2075890, "chapter_id": 2606, "verse_number": "१२-१११-६०", "content_sanskrit": "नोच्छ्रितं सहते कश्चित्प्रक्रिया वैरकारिका।\nशुचेरपि हि युक्तस्य दोष एव निपात्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2075891, "chapter_id": 2606, "verse_number": "१२-१११-६१", "content_sanskrit": "[मुनेरपि वनस्थस्य स्वानि कर्माणि कुर्वतः\nउत्पाद्यन्ते त्रयः पक्षा मित्रोदासीनशत्रवः॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2075892, "chapter_id": 2606, "verse_number": "१२-१११-६२", "content_sanskrit": "लुब्धानां शुचयो द्वेष्याः कातराणां तरस्विनः।\nमूर्खाणां पण्डिता द्वेष्या दरिद्राणां महाधनाः।\nअधार्मिकाणां धर्मिष्ठा विरूपाणां सुरूपिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2075893, "chapter_id": 2606, "verse_number": "१२-१११-६३", "content_sanskrit": "बह पण्डिता मूर्खा लुब्धा मायोपजीविनः।\nआहुंर्दोषमदोषस्य बृहस्पतिमतेरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2075894, "chapter_id": 2606, "verse_number": "१२-१११-६४", "content_sanskrit": "सुन्य्रस्तं ते गृहे मांसं यदद्यापहृतं तव।\nनेचते दीयमानं च साधु तावद्विधीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2075895, "chapter_id": 2606, "verse_number": "१२-१११-६५", "content_sanskrit": "असयाः सत्यसंकाशाः सत्याश्चासत्यदर्शनाः।\nदृश्यन्ते विविधा भावास्तेषु युक्तं परीक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2075896, "chapter_id": 2606, "verse_number": "१२-१११-६६", "content_sanskrit": "तलवद्दृश्यते व्योम खद्योतो हव्यवाडिव।\nन चैवास्ति तलं व्योम्नि खद्योते न हुताशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2075897, "chapter_id": 2606, "verse_number": "१२-१११-६७", "content_sanskrit": "तस्मात्प्रत्यक्षदृष्टोऽपि युक्तो ह्यर्थः परीक्षितुम्।\nपरीक्ष्य ज्ञापयन्नर्थान्न पश्चात्परितप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2075898, "chapter_id": 2606, "verse_number": "१२-१११-६८", "content_sanskrit": "न दुष्करमिदं पुत्रं यत्प्रभुर्घातयेत्परम्।\nश्लाघनीया यशस्या च लोके प्रभवतां क्षमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2075899, "chapter_id": 2606, "verse_number": "१२-१११-६९", "content_sanskrit": "स्थापितोऽयं त्वया पुत्र सामन्तेष्वपि विश्रुतः।\nदुःखेनासाद्यते पात्रं धार्यतामेष ते सुहृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2075900, "chapter_id": 2606, "verse_number": "१२-१११-७०", "content_sanskrit": "दूषितं परदोषैर्हि गृह्णीते योऽन्यथा शुचिम्।\nस्वयं संदूषितामात्यः क्षिप्रमेव विनश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2075901, "chapter_id": 2606, "verse_number": "१२-१११-७१", "content_sanskrit": "एतस्मादरिसंघाताद्गोमायोः कश्चिदागतः।\nधर्मात्मा तेन चाख्यातं यथैतत्कपटं कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2075902, "chapter_id": 2606, "verse_number": "१२-१११-७२", "content_sanskrit": "ततो विज्ञातचारित्रः सत्कृत्य स विमोक्षितः।\nपरिष्वक्तश्च सस्नेहं मृगेन्द्रेण पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2075903, "chapter_id": 2606, "verse_number": "१२-१११-७३", "content_sanskrit": "अनुज्ञाय मृगेन्द्रं तु गोमायुर्नीतिशास्त्रवित्।\nतेनामर्षेण संतप्तः प्रायमासितुमैच्छत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2075904, "chapter_id": 2606, "verse_number": "१२-१११-७४", "content_sanskrit": "गोमायुं तु स शार्दूलः स्नेहात्प्रसृतलोचनः।\nन्यवारयत्स धर्मिष्ठं पूजया प्रतिपूजयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2075905, "chapter_id": 2606, "verse_number": "१२-१११-७५", "content_sanskrit": "तं स गोमायुरालोक्य स्नेहादागतसंभ्रमः।\nबभाषे प्रणतो वाक्यं बाष्पगद्गदया गिरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2075906, "chapter_id": 2606, "verse_number": "१२-१११-७६", "content_sanskrit": "पूजितोऽहं त्वया पूर्वं पश्चाच्चैव विमानितः।\nपरेषामास्पदं नीतो वस्तुं नार्हाम्यहं त्वयि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2075907, "chapter_id": 2606, "verse_number": "१२-१११-७७", "content_sanskrit": "असंतुष्टाश्च्युताः स्थानान्मानात्प्रत्यवरोपिताः।\nस्वयं चोपद्रुता भृत्या ये चाप्युपहिताः परैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2075908, "chapter_id": 2606, "verse_number": "१२-१११-७८", "content_sanskrit": "परिक्षीणाश्च लुब्धाश्च क्रुद्धा भीताः प्रतारिताः।\nहृतस्वा मानिनो ये च त्यक्तोपात्ता महेप्सवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2075909, "chapter_id": 2606, "verse_number": "१२-१११-७९", "content_sanskrit": "संलालिताश्च ये केचिद्व्यसनौघप्रतीक्षिणः।\nअन्तर्हिताः सोहपृतास्ते सर्वेऽपरसाधनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2075910, "chapter_id": 2606, "verse_number": "१२-१११-८०", "content_sanskrit": "अवमानेन युक्तस्य स्थापितस्य च मे पुनः।\nकथं यास्यसि विश्वासमहमेष्वामि वा कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2075911, "chapter_id": 2606, "verse_number": "१२-१११-८१", "content_sanskrit": "समर्थ इति संगृह्य स्थापयित्वा परीक्षितः।\nकृतं च समयं भित्त्वा त्वयाऽहमवमानितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2075912, "chapter_id": 2606, "verse_number": "१२-१११-८२", "content_sanskrit": "प्रथमं यः समाख्यातः शीलवानिति संसदि।\nन वाच्यं तस्य वैगुण्यं प्रतिज्ञां परिरक्षता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2075913, "chapter_id": 2606, "verse_number": "१२-१११-८३", "content_sanskrit": "एवं चावमतस्येह विश्वासं मे न यास्यसि।\nत्वयि चापेतविश्वासे ममोद्वेगो भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2075914, "chapter_id": 2606, "verse_number": "१२-१११-८४", "content_sanskrit": "शङ्कितस्त्वमहं भीतः परे च्छिद्रानुसारिणः।\nअस्त्रिग्धाश्चैव दुस्तोषाः कर्म चैतद्बहुच्छलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2075915, "chapter_id": 2606, "verse_number": "१२-१११-८५", "content_sanskrit": "दुःखेन श्लिष्यते भिन्नं श्लिष्टं दुःखेन भिद्यते।\nभिन्नश्लिष्टे तु या प्रीतिर्न सा स्नेहेन वर्धते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2075916, "chapter_id": 2606, "verse_number": "१२-१११-८६", "content_sanskrit": "कश्चित्तव हिते भर्तुर्दृश्यते न परात्मनः।\nकार्यापेक्षा हि वर्न्तते भावस्त्रिग्धाः सुदुर्लभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2075917, "chapter_id": 2606, "verse_number": "१२-१११-८७", "content_sanskrit": "सुदुःखं पुरुषज्ञानं चित्तं ह्येषां चलाचलम्।\nसमर्थो वाप्यशङ्को वा शतेष्वेकोऽधिगम्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2075918, "chapter_id": 2606, "verse_number": "१२-१११-८८", "content_sanskrit": "अकस्मात्प्रक्रिया नॄणामकस्माच्चापकर्षणम्।\nशुभाशुभे महत्त्वं च प्रहर्तुं बुद्धिलाघवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2075919, "chapter_id": 2606, "verse_number": "१२-१११-८९x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2075920, "chapter_id": 2606, "verse_number": "१२-१११-८९", "content_sanskrit": "एवंविधं सान्त्वमुक्त्वा धर्मकामार्थहेतुमत्।\nप्रसादयित्वा राजानं गोमायुर्वनमभ्यगात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2075921, "chapter_id": 2606, "verse_number": "१२-१११-९०", "content_sanskrit": "अगृह्यानुनयं तस्य मृगेन्द्रस्य च बुद्धिमान्।\nगोमायुः प्रायमासीनस्त्यक्त्वा देहं दिवं ययौ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2075922, "chapter_id": 2606, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि एकादशाधिकशततमोऽध्यायः॥ १११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}]