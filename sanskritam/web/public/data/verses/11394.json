[{"id": 50008058, "chapter_id": 11394, "verse_number": "1", "content_sanskrit": "एवं ब्रुवाणं मैत्रेयं द्वैपायनसुतो बुधः। प्रीणयन्निव भारत्या विदुरः प्रत्यभाषत॥ ३/८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50008059, "chapter_id": 11394, "verse_number": "2", "content_sanskrit": "विदुर उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50008060, "chapter_id": 11394, "verse_number": "3", "content_sanskrit": "ब्रह्मन् कथं भगवतश्चिन्मात्रस्याविकारिणः। लीलया चापि युज्येरन् निर्गुणस्य गुणाः क्रियाः॥ ३/८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50008061, "chapter_id": 11394, "verse_number": "4", "content_sanskrit": "क्रीडाया मुद् यतोऽर्हस्य कामं चिक्रीडिषाऽन्यतः। स्वतस्तृप्तस्य तु कथं निर्वृतस्य सदात्मनः॥ ३/८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50008062, "chapter_id": 11394, "verse_number": "5", "content_sanskrit": "अस्राक्षीत् भगवान् विश्वं गुणमय्याऽऽत्ममायया। तथा संस्थापयत्येतद् भूयः प्रत्यभिधास्यति॥ ३/८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50008063, "chapter_id": 11394, "verse_number": "6", "content_sanskrit": "देशतः कालतो योऽसाववस्थातः स्वतोऽन्यतः। अविलुप्तावबोधात्मा स युज्येताजया कथम्॥ ३/८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50008064, "chapter_id": 11394, "verse_number": "7", "content_sanskrit": "भगवानेष एवैकः सर्वक्षेत्रेष्ववस्थितः। अमुष्य दुर्भगत्वं वा क्लेशो वा कर्मभिः कुतः॥ ३/८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50008065, "chapter_id": 11394, "verse_number": "8", "content_sanskrit": "एतस्मिन् मे मनो विद्वन् खिद्यते ज्ञानसङ्कटे। तन्नः पराणुद विभो कश्मलं मानसं महत्॥ ३/८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50008066, "chapter_id": 11394, "verse_number": "9", "content_sanskrit": "श्रीशुक उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50008067, "chapter_id": 11394, "verse_number": "10", "content_sanskrit": "स इत्थं चोदितः क्षत्त्रा तत्त्वजिज्ञासुना मुनिः। प्रत्याह भगवच्चित्तः स्मयन्निव गतस्मयः॥ ३/८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50008068, "chapter_id": 11394, "verse_number": "11", "content_sanskrit": "मैत्रेय उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50008069, "chapter_id": 11394, "verse_number": "12", "content_sanskrit": "सेयं भगवतो माया न्याय्यं येन विरुध्यते। ईश्वरस्य विमुक्तस्य कार्पण्यमुत बन्धनम्॥ ३/८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50008070, "chapter_id": 11394, "verse_number": "13", "content_sanskrit": "यथाऽर्थेन विनाऽमुष्य पुंस आत्मविपर्ययः। प्रतीयत उपद्रष्टुः स्वशिरश्छेदनादिकः॥ ३/८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50008071, "chapter_id": 11394, "verse_number": "14", "content_sanskrit": "यथा जले चन्द्रमसः कम्पादिस्तत्कृतो गुणः। दृश्यतेऽसन्नपि द्रष्टुरात्मनोऽनात्मनो गुणः॥ ३/८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50008072, "chapter_id": 11394, "verse_number": "15", "content_sanskrit": "स वै निवृत्तिधर्मेण वासुदेवानुकम्पया। भगवद्भक्तियोगेन तिरोधत्ते शनैरिह॥ ३/८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50008073, "chapter_id": 11394, "verse_number": "16", "content_sanskrit": "यदेन्द्रियोपरामार्थो दृष्टात्मनि परे हरौ। विलीयन्ते तदा क्लेशाः संसुप्तस्येव कृत्स्नशः॥ ३/८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50008074, "chapter_id": 11394, "verse_number": "17", "content_sanskrit": "अशेषसङ्क्लेशशमं विधत्ते गुणानुवादश्रवणं मुरारेः। किं वा पुनस्तच्चरणारविन्दपरागसेवारतिरात्मलब्धा॥ ३/८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50008075, "chapter_id": 11394, "verse_number": "18", "content_sanskrit": "विदुर उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50008076, "chapter_id": 11394, "verse_number": "19", "content_sanskrit": "सञ्छिन्नः संशयो मह्यं तव सूक्तासिना विभो। उभयत्रापि भगवन् मनो मे सम्प्रधावति॥ ३/८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50008077, "chapter_id": 11394, "verse_number": "20", "content_sanskrit": "साधु तद् व्याहृतं विद्वन्नात्ममायायनं हरेः। आभात्यपार्थं निर्मूलं विश्वमूलं न यद् बहिः॥ ३/८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50008078, "chapter_id": 11394, "verse_number": "21", "content_sanskrit": "यश्च मूढतमो लोके यश्च बुद्धेः परं गतः। तावुभौ सुखमेधेते क्ल्श्यित्यन्तरितो जनः॥ ३/८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50008079, "chapter_id": 11394, "verse_number": "22", "content_sanskrit": "अर्थाभावं विनिश्चित्य प्रतीतस्याप्यनात्मनः। तां चापि युष्मच्चरणसेवयाऽहं पराणुदे॥ ३/८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50008080, "chapter_id": 11394, "verse_number": "23", "content_sanskrit": "यत्सेवया भगवतः कूटस्थस्य मधुद्विषः। रतिरासो भवेत् तीव्रः पादयोर्व्यसनार्दनः॥ ३/८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50008081, "chapter_id": 11394, "verse_number": "24", "content_sanskrit": "दुरापा ह्यल्पतपसां सेवा वैकुण्ठवर्त्मसु। यत्रोपगीयते नित्यं देवदेवो जनार्दनः॥ ३/८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50008082, "chapter_id": 11394, "verse_number": "25", "content_sanskrit": "सृष्ट्वाऽग्रे महदादीनि सविकाराण्यनुक्रमात्। तेभ्यो विराजमुद्धृत्य तमनु प्राविशद् विभुः॥ ३/८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50008083, "chapter_id": 11394, "verse_number": "26", "content_sanskrit": "यमाहुराद्यं पुरुषं सहस्रङ्घ्रायूरुबाहुकम्। यत्र विश्व इमे लोकाः सविकासं समासते॥ ३/८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50008084, "chapter_id": 11394, "verse_number": "27", "content_sanskrit": "यस्मिन् दशविधः प्राणः सेन्द्रियार्थेन्द्रियस्त्रिवृत्। त्वयेरिता यतो वर्णास्तद्विभूतीर्वदस्व नः॥ ३/८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50008085, "chapter_id": 11394, "verse_number": "28", "content_sanskrit": "यत्र पुत्रैश्च पौत्रैश्च नप्तृभिः सह गोत्रजैः। प्रजा विचित्राकृतय आसन् याभिरिदं ततम्॥ ३/८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50008086, "chapter_id": 11394, "verse_number": "29", "content_sanskrit": "प्रजापतीनां स पतिश्चकॢपे कान् प्रजापतीन्। सर्गांश्चैवानुसर्गांश्च मनून् मन्वन्तराधिपान्॥ ३/८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50008087, "chapter_id": 11394, "verse_number": "30", "content_sanskrit": "एतेषामपि वंशाश्च वंशानुचरितानि च। उपर्यधश्च ये लोका भूमेर्मित्रात्मजासते। तेषां संस्थां प्रमाणं च भूर्लोकस्य च वर्णय॥ ३/८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50008088, "chapter_id": 11394, "verse_number": "31", "content_sanskrit": "तिर्यङ्मनुष्यदेवानां सरीसृपपतत्रिणाम्। वद नो सर्गसंव्यूहं गर्भस्वेदद्विजोद्भिदाम्॥ ३/८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50008089, "chapter_id": 11394, "verse_number": "32", "content_sanskrit": "गुणावतारैर्विश्वस्य सर्गस्थित्यप्ययात्मनः। सृजतः श्रीनिवासस्य व्याचक्ष्वोदारविक्रमम्॥ ३/८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50008090, "chapter_id": 11394, "verse_number": "33", "content_sanskrit": "वर्णाश्रमविभागांश्च रूपशीलस्वभावतः। ॠषीणां जन्मकर्माणि वेदस्य च विकर्षणम्। यज्ञस्य च वितानानि योगस्य च पथः प्रभो॥ ३/८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50008091, "chapter_id": 11394, "verse_number": "34", "content_sanskrit": "नैर्ष्कम्यस्य च साङ्ख्यस्य तन्त्रं वा भगवत्स्मृतम्। पाषण्डपथवैषम्यं प्रतिलोमनिवेशनम्॥ ३/८/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50008092, "chapter_id": 11394, "verse_number": "35", "content_sanskrit": "जीवस्य गतयो याश्च यावतीर्गुणकर्मजाः। धर्मार्थकाममोक्षाणां निमित्तान्यविरोधतः॥ ३/८/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50008093, "chapter_id": 11394, "verse_number": "36", "content_sanskrit": "वार्ताया दण्डनीतेश्च श्रुतस्य च विधिं पृथक्। श्राद्धस्य च विधिं ब्रह्मन् पितॄणां सर्गमेव च॥ ३/८/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50008094, "chapter_id": 11394, "verse_number": "37", "content_sanskrit": "ग्रहनक्षत्रताराणां कालावयवसंस्थितिम्। दानस्य तपसो वापि यच्चेष्टापूर्तयोः फलम्॥ ३/८/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50008095, "chapter_id": 11394, "verse_number": "38", "content_sanskrit": "वानप्रस्थस्य यो धर्मो यश्च पुंस उतापदि। येन वा भगवांस्तुष्येद् धर्मयोनिर्जनार्दनः॥ ३/८/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50008096, "chapter_id": 11394, "verse_number": "39", "content_sanskrit": "सम्प्रसीदति वा येषामेतदाख्याहि मेऽनघ। अनुव्रतानां शिष्याणां पुत्राणां च द्विजोत्तम॥ ३/८/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50008097, "chapter_id": 11394, "verse_number": "40", "content_sanskrit": "अनापृष्टमपि ब्रूयुर्गुरवो दीनवत्सलाः। तत्त्वानां भगवंस्तेषां कतिधा प्रतिसङ्क्रमः॥ ३/८/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50008098, "chapter_id": 11394, "verse_number": "41", "content_sanskrit": "तत्रेमं क उपासीरन् क उ स्विदनुशेरते। पुरुषस्य च संस्थानं स्वरूपं वा परस्य च॥ ३/८/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50008099, "chapter_id": 11394, "verse_number": "42", "content_sanskrit": "ज्ञानं च नैगमं यत् तद् गुरुशिष्यप्रयोजनम्। निमित्तानि च तस्येह प्रोक्तान्यनघ सूरिभिः॥ ३/८/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50008100, "chapter_id": 11394, "verse_number": "43", "content_sanskrit": "स्वतो ज्ञानं कुतः पुंसां भक्तिर्वैराग्यमेव वा॥ ३/८/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50008101, "chapter_id": 11394, "verse_number": "44", "content_sanskrit": "एतान् मे पृच्छतः प्रश्नान् हरेः कर्मविवित्सया। ब्रूहि मेऽन्धस्य मित्रत्वादजया नष्टचक्षुषः॥ ३/८/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50008102, "chapter_id": 11394, "verse_number": "45", "content_sanskrit": "सर्वे वेदाश्च यज्ञाश्च तपो दानानि चानघ। जीवाभयप्रदानस्य न कुर्वीरन् कलामपि॥ ३/८/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 50008103, "chapter_id": 11394, "verse_number": "46", "content_sanskrit": "श्रीशुक उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 50008104, "chapter_id": 11394, "verse_number": "47", "content_sanskrit": "स इत्थमापृष्टपुराणकल्पः कुरुप्रधानेन मुनिप्रधानः। प्रवृद्धहर्षो भगवत्कथायां सञ्चोदितस्तं प्रहसन्निवाह॥ ३/८/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 50008105, "chapter_id": 11394, "verse_number": "48", "content_sanskrit": "॥ इति श्रीमद्भागवते तृतीयस्कन्धेऽष्टमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]