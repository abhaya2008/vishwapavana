[{"id": 7000459000, "chapter_id": 20459, "verse_number": "३-६-१", "content_sanskrit": "ऋषय ऊचुः ।\nयदिदं भारतं वर्षं पुण्यं पुण्यविधायकम् ।\nतत्सर्वं नः समाचक्ष्व त्वं हि नो बुद्धिमान्मतः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000459001, "chapter_id": 20459, "verse_number": "३-६-२", "content_sanskrit": "सूत उवाच ।\nअत्र ते कीर्त्तयिष्यामि वर्षं भारतमुत्तमम् ।\nप्रिय मित्रस्य देवस्य मनोर्वैवस्वतस्य च॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000459002, "chapter_id": 20459, "verse_number": "३-६-३", "content_sanskrit": "पृथोश्च प्राज्ञ वै न्यस्य तथैक्ष्वाकोर्महात्मनः ।\nययातेरंबरीषस्य मांधातुर्नहुषस्य च॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000459003, "chapter_id": 20459, "verse_number": "३-६-४", "content_sanskrit": "तथैव मुचुकुंदस्य कुबेरोशीनरस्य च ।\nऋषभस्य तथैलस्य नृगस्य नृपतेस्तथा॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000459004, "chapter_id": 20459, "verse_number": "३-६-५", "content_sanskrit": "कुशिकस्यैव राजर्षेर्गाधेश्चैव महात्मनः ।\nसोमस्य चैव राजर्षेर्दिलीपस्य तथैव च॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000459005, "chapter_id": 20459, "verse_number": "३-६-६", "content_sanskrit": "अन्येषां च महाभागाः क्षत्रियाणां बलीयसाम् ।\nसर्वेषामेव भूतानां प्रियं भारतमुत्तमम्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000459006, "chapter_id": 20459, "verse_number": "३-६-७", "content_sanskrit": "ततो वर्षं प्रवक्ष्यामि यथाश्रुतमहो द्विजाः ।\nमहेंद्रो मलयःसह्यः शुक्तिमानृक्षवानपि॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000459007, "chapter_id": 20459, "verse_number": "३-६-८", "content_sanskrit": "विंध्यश्च पारियात्रश्च सप्तैते कुलपर्वताः ।\nतेषां सहस्रशो विप्रा पर्वतास्ते समीपतः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000459008, "chapter_id": 20459, "verse_number": "३-६-९", "content_sanskrit": "अविज्ञाताः सारवंतो विपुलाश्चित्रसानवः ।\nअन्ये तु ये परिज्ञाता ह्रस्वा ह्रस्वोपजीविनः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000459009, "chapter_id": 20459, "verse_number": "३-६-१०", "content_sanskrit": "आर्यम्लेच्छसधर्माणस्ते मिश्राः पुरुषा द्विजाः ।\nनदीं पिबंति विमलां गंगां सिंधुंसरस्वतीम्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000459010, "chapter_id": 20459, "verse_number": "३-६-११", "content_sanskrit": "गोदावरीं नर्मदां च बहूदां च महानदीम् ।\nशतद्रुं चंद्रभागां च यमुनां च महानदीम्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000459011, "chapter_id": 20459, "verse_number": "३-६-१२", "content_sanskrit": "दृषद्वतीं वितस्तां च विपापां स्वच्छवालुकाम् ।\nनदीं वेत्रवतीं चैव कृष्णां वेणीं च निम्नगाम्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000459012, "chapter_id": 20459, "verse_number": "३-६-१३", "content_sanskrit": "इरावतीं वितस्तां च पयोष्णीं देविकामपि ।\nवेदस्मृतिं वेदशिरां त्रिदिवां सिंधुला कृमिम्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000459013, "chapter_id": 20459, "verse_number": "३-६-१४", "content_sanskrit": "करीषिणीं चित्रवहां त्रिसेनां चैव निम्नगाम् ।\nगोमतीं धूतपापां च चंदनां च महानदीम्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000459014, "chapter_id": 20459, "verse_number": "३-६-१५", "content_sanskrit": "कौशिकीं त्रिदिवां हृद्यां नाचितां रोहितारणीम् ।\nरहस्यां शतकुंभां च सरयूं च द्विजोत्तमाः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000459015, "chapter_id": 20459, "verse_number": "३-६-१६", "content_sanskrit": "चर्मण्वतीं वेत्रवतीं हस्तिसोमां दिशं तथा ।\nशरावतीं पयोष्णीं च भीमां भीमरथीमपि॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000459016, "chapter_id": 20459, "verse_number": "३-६-१७", "content_sanskrit": "कावेरीं चुलुकां चापि तापीं शतमलामपि ।\nनीवारां महितां चापि सुप्रयोगां तथा नदीम्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000459017, "chapter_id": 20459, "verse_number": "३-६-१८", "content_sanskrit": "पवित्रां कृष्णलां सिंधुं वाजिनीं पुरमालिनीम् ।\nपूर्वाभिरामां वीरां च भीमां मालावतीं तथा॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000459018, "chapter_id": 20459, "verse_number": "३-६-१९", "content_sanskrit": "पलाशिनीं पापहरां महेंद्रां पटलावतीम् ।\nकरीषिणीमसिक्नीं च कुशचीरीं महानदीम्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000459019, "chapter_id": 20459, "verse_number": "३-६-२०", "content_sanskrit": "मरुतां प्रवरां मेनां हेमां घृतवतीं तथा ।\nअनावतीमनुष्णां च सेव्यां कापीं च सत्तमाः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000459020, "chapter_id": 20459, "verse_number": "३-६-२१", "content_sanskrit": "सदावीरामधृष्यां च कुशचीरां महानदीम् ।\nरथचित्रां ज्योतिरथां विश्वामित्रां कपिंजलाम्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000459021, "chapter_id": 20459, "verse_number": "३-६-२२", "content_sanskrit": "चंद्रावहफलद्यं चैव कुचीरामंबुवाहिनीम् ।\nवैनदीं पिंगलां वेणां तुंगवेगां महानदीम्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000459022, "chapter_id": 20459, "verse_number": "३-६-२३", "content_sanskrit": "विदिशां कृष्णवेणां च ताम्रां च कपिलामपि ।\nधेनुं सकामां वेदस्वां हविःस्रावां महापथाम्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000459023, "chapter_id": 20459, "verse_number": "३-६-२४", "content_sanskrit": "शिप्रां च पिच्छलां चैव भारद्वाजीं च निम्नगाम् ।\nकौर्णिकीं निम्नगां शोणां बाहुदामथ चंद्रमाम्॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000459024, "chapter_id": 20459, "verse_number": "३-६-२५", "content_sanskrit": "दुर्गामंतः शिलां चैव ब्रह्ममेध्यां दृषद्वतीम् ।\nपरोक्षामथ रोहीं च तथा जंबूनदीमपि॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000459025, "chapter_id": 20459, "verse_number": "३-६-२६", "content_sanskrit": "सुनासां तमसां दासीं सामान्यां वरणामसिम् ।\nनीलां धृतिकरीं चैव पर्णाशां च महानदीम्॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000459026, "chapter_id": 20459, "verse_number": "३-६-२७", "content_sanskrit": "मानवीं वृषभां भासां ब्रह्ममेध्यां दृषद्वतीम् ।\nएताश्चान्याश्च बहुला महानद्यो द्विजर्षभाः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000459027, "chapter_id": 20459, "verse_number": "३-६-२८", "content_sanskrit": "सदा निरामयां कृष्णां मंदगां मंदवाहिनीम् ।\nब्राह्मणीं च महागौरीं दुर्गामपि च सत्तमाः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000459028, "chapter_id": 20459, "verse_number": "३-६-२९", "content_sanskrit": "चित्रोत्पलां चित्ररथामतुलां रोहिणीं तथा ।\nमंदाकिनीं वैतरणीं कोकां चापि महानदीम्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000459029, "chapter_id": 20459, "verse_number": "३-६-३०", "content_sanskrit": "शुक्तिमतीमनंगां च तथैव वृषसाह्वयाम् ।\nलोहित्यां करतोयां च तथैव वृषकात्वयाम्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000459030, "chapter_id": 20459, "verse_number": "३-६-३१", "content_sanskrit": "कुमारीमृषितुल्यां च मारिषां च सरस्वतीम् ।\nमंदाकिनीं सुपुण्यां च सर्वां गंगां च सत्तमाः॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000459031, "chapter_id": 20459, "verse_number": "३-६-३२", "content_sanskrit": "विश्वस्य मातरः सर्वाः सर्वाश्चैव महाफलाः ।\nतथा नद्यः सुप्रकाशाः शतशोथ सहस्रशः॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000459032, "chapter_id": 20459, "verse_number": "३-६-३३", "content_sanskrit": "इत्येता सरितो विप्राः समाख्याता यथास्मृति ।\nअतऊर्द्ध्वं जनपदान्निबोध गदतो मम॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000459033, "chapter_id": 20459, "verse_number": "३-६-३४", "content_sanskrit": "तत्रेमे कुरुपांचालाः शाल्वमात्रेय जांगलाः ।\nशूरसेनाः पुलिंदाश्च बौधामालास्तथैव च॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000459034, "chapter_id": 20459, "verse_number": "३-६-३५", "content_sanskrit": "मत्स्याः कुशट्टाः सौगंध्याः कुत्सपाः काशिकोशलाः ।\nचेदिमत्स्यकरूषाश्च भोजाः सिंधुपुलिंदकाः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000459035, "chapter_id": 20459, "verse_number": "३-६-३६", "content_sanskrit": "उत्तमाश्च दशार्णाश्च मेकलाश्चोत्कलैः सह ।\nपंचालाः कोशलाश्चैव नैकपृष्ठयुगंधराः॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000459036, "chapter_id": 20459, "verse_number": "३-६-३७", "content_sanskrit": "बोधा मद्राः कलिंगाश्च काशयो परकाशयः ।\nजठराः कुकुराश्चैव सुदशार्णाः सुसत्तमाः॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000459037, "chapter_id": 20459, "verse_number": "३-६-३८", "content_sanskrit": "कुंतयोऽवंतयश्चैव तथैवापरकुंतयः ।\nगोमंता मल्लकाः पुंड्राः विदर्भा नृपवाहिकाः॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000459038, "chapter_id": 20459, "verse_number": "३-६-३९", "content_sanskrit": "अश्मकाः सोत्तराश्चैव गोपराष्ट्राः कनीयसः ।\nअधिराज्यकुशट्टाश्च मल्लराष्ट्राश्च केरलाः॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000459039, "chapter_id": 20459, "verse_number": "३-६-४०", "content_sanskrit": "मालवाश्चोपवास्याश्च चक्रावक्रालयाः शकाः ।\nविदेहा मगधाः सद्मा मलजा विजयास्तथा॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000459040, "chapter_id": 20459, "verse_number": "३-६-४१", "content_sanskrit": "अंगा वंगाः कलिंगाश्च यकृल्लोमान एव च ।\nमल्लाः सुदेष्णाः प्रह्लादा महिषाः शशकास्तथा॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000459041, "chapter_id": 20459, "verse_number": "३-६-४२", "content_sanskrit": "बाह्लिका वाटधानाश्च आभीराः कालतोयकाः ।\nअपरांताः परांताश्च पंकलाश्चर्मचंडिकाः॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000459042, "chapter_id": 20459, "verse_number": "३-६-४३", "content_sanskrit": "अटवीशेखराश्चैव मेरुभूताश्च सत्तमाः ।\nउपावृतानुपावृताः सुराष्ट्राः केकयास्तथा॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000459043, "chapter_id": 20459, "verse_number": "३-६-४४", "content_sanskrit": "कुट्टापरांता माहेयाः कक्षाः सामुद्र निष्कुटाः ।\nअंधाश्च बहवो विप्रा अंतर्गिर्यस्तथैव च॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000459044, "chapter_id": 20459, "verse_number": "३-६-४५", "content_sanskrit": "बहिर्गिर्य्योंगमलदा मगधा मालवार्घटाः ।\nसत्त्वतराः प्रावृषेयाः भार्गवाश्च द्विजर्षभाः॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000459045, "chapter_id": 20459, "verse_number": "३-६-४६", "content_sanskrit": "पुंड्रा भार्गाः किराताश्च सुदेष्णा भासुरास्तथा ।\nशका निषादा निषधास्तथैवानर्त नैऋताः॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000459046, "chapter_id": 20459, "verse_number": "३-६-४७", "content_sanskrit": "पूर्णलाः पूतिमत्स्याश्च कुंतला कुशकास्तथा ।\nतरिग्रहाश्शूरसेना ईजिकाः कल्पकारणाः॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000459047, "chapter_id": 20459, "verse_number": "३-६-४८", "content_sanskrit": "तिलभागामसाराश्च मधुमत्ताः ककुंदकाः ।\nकाश्मीराः सिंधुसौवीरा गांधारा दर्शकास्तथा॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000459048, "chapter_id": 20459, "verse_number": "३-६-४९", "content_sanskrit": "अभीसाराः कुद्रुताश्च सौरिला बाह्लिकास्तथा ।\nदर्वी च मालवा दर्वा वातजामरथोरगाः॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000459049, "chapter_id": 20459, "verse_number": "३-६-५०", "content_sanskrit": "बलरट्टास्तथा विप्राः सुदामानः मुमल्लिकाः ।\nबंधाकरीकषाश्चैव कुलिंदा गंधिकास्तथा॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000459050, "chapter_id": 20459, "verse_number": "३-६-५१", "content_sanskrit": "वनायवोदशाः पार्श्वरोमाणः कुशबिंदवः ।\nकाच्छा गोपालकच्छाश्च जांगलाः कुरुवर्णकाः॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000459051, "chapter_id": 20459, "verse_number": "३-६-५२", "content_sanskrit": "किराताबर्बराः सिद्धा वैदेहास्ताम्रलिप्तिकाः ।\nऔड्रम्लेच्छाः ससैरिंद्राः पार्वतीयाश्च सत्तमाः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000459052, "chapter_id": 20459, "verse_number": "३-६-५३", "content_sanskrit": "अथापरे जनपदा दक्षिणा मुनिपुंगवाः ।\nद्रविडाः केरलाः प्राच्या मूषिका बालमूषिकाः॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000459053, "chapter_id": 20459, "verse_number": "३-६-५४", "content_sanskrit": "कर्णाटका माहिषका विकंधा मूषिकास्तथा ।\nझल्लिकाः कुंतलाश्चैव सौहृदानलकाननाः॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000459054, "chapter_id": 20459, "verse_number": "३-६-५५", "content_sanskrit": "कौक्कुटकास्तथा बोलाः कोकणा मणिवालकाः ।\nसमंगा कनकाश्चैव कुंकुरांगारमारिषाः॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000459055, "chapter_id": 20459, "verse_number": "३-६-५६", "content_sanskrit": "ध्वजिन्युत्सवसंकेतास्त्रिवर्गा माल्यसेनयः ।\nव्यूढकाः कोरकाः प्रोष्टाः संगवेगधरास्तथा॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000459056, "chapter_id": 20459, "verse_number": "३-६-५७", "content_sanskrit": "तथैव विंद्यरुलिकाः पुलिंदा बल्वलैः सह ।\nमालवा मलराश्चैव तथैवापरवर्तकाः॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000459057, "chapter_id": 20459, "verse_number": "३-६-५८", "content_sanskrit": "कुलिंदाः कालदाश्चैव चंडकाः कुरटास्तथा ।\nमुशलास्तनवालाश्च सतीर्था पूतिसृंजयाः॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000459058, "chapter_id": 20459, "verse_number": "३-६-५९", "content_sanskrit": "अनिदायाः शिवाटाश्च तपनाः सूतपास्तथा ।\nऋषिकाश्च विदर्भाश्च स्तंगना परतंगकाः॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000459059, "chapter_id": 20459, "verse_number": "३-६-६०", "content_sanskrit": "उत्तराश्चापरेम्लेच्छा जना हि मुनिपुंगवाः ।\nजवनाश्च सकांबोजा दारुणा म्लेच्छजातयः॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000459060, "chapter_id": 20459, "verse_number": "३-६-६१", "content_sanskrit": "सकृघृहाः कुलट्याश्च हूणा पारसिकैः सह ।\nतथैव रमणाश्चान्यास्तथा च दशमालिकाः॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000459061, "chapter_id": 20459, "verse_number": "३-६-६२", "content_sanskrit": "क्षत्रियोपनिवेशाश्च वैश्यशूद्र कुलानि च ।\nशूराभीराश्च दरदाः काश्मीराः पशुभिः सह॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000459062, "chapter_id": 20459, "verse_number": "३-६-६३", "content_sanskrit": "खांडीकाश्च तुषाराश्च पद्मगा गिरिगह्वराः ।\nआद्रेयाः सभिरादाजास्तथैव स्तनपोषकाः॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000459063, "chapter_id": 20459, "verse_number": "३-६-६४", "content_sanskrit": "द्रोषकाश्च कलिंगाश्च किरातानां च जातयः ।\nतोमरा हन्यमानाश्च तथैव करभंजकाः॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000459064, "chapter_id": 20459, "verse_number": "३-६-६५", "content_sanskrit": "एते चान्ये जनपदाः प्राच्योदीच्यास्तथैव च ।\nउद्देशमात्रेण मया देशाः संकीर्तिता द्विजाः ।\nयथागुणबलं चापि त्रिवर्गस्य महाफलम्॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]