[{"id": 5000497000, "chapter_id": 9497, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे नवतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000497001, "chapter_id": 9497, "verse_number": "६-९०-१", "content_sanskrit": "स हताश्वो महातेजा भूमौ तिष्ठन् निशाचरः।\nइन्द्रजित् परमक्रुद्धः सम्प्रजज्वाल तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000497002, "chapter_id": 9497, "verse_number": "६-९०-२", "content_sanskrit": "तौ धन्विनौ जिघांसन्तावन्योन्यमिषुभिर्भृशम्।\nविजयेनाभिनिष्क्रान्तौ वने गजवृषाविव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000497003, "chapter_id": 9497, "verse_number": "६-९०-३", "content_sanskrit": "निबर्हयन्तश्चान्योन्यं ते राक्षसवनौकसः।\nभर्तारं न जहुर्युद्धे सम्पतन्तस्ततस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000497004, "chapter_id": 9497, "verse_number": "६-९०-४", "content_sanskrit": "ततस्तान् राक्षसान् सर्वान् हर्षयन् रावणात्मजः।\nस्तुन्वानो हर्षमाणश्च इदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000497005, "chapter_id": 9497, "verse_number": "६-९०-५", "content_sanskrit": "तमसा बहुलेनेमाः संसक्ताः सर्वतो दिशः।\nनेह विज्ञायते स्वो वा परो वा राक्षसोत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000497006, "chapter_id": 9497, "verse_number": "६-९०-६", "content_sanskrit": "धृष्टं भवन्तो युध्यन्तु हरीणां मोहनाय वै।\nअहं तु रथमास्थाय आगमिष्यामि संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000497007, "chapter_id": 9497, "verse_number": "६-९०-७", "content_sanskrit": "तथा भवन्तः कुर्वन्तु यथेमे हि वनौकसः।\nन युध्येयुर्महात्मानः प्रविष्टे नगरं मयि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000497008, "chapter_id": 9497, "verse_number": "६-९०-८", "content_sanskrit": "इत्युक्त्वा रावणसुतो वञ्चयित्वा वनौकसः।\nप्रविवेश पुरीं लङ्कां रथहेतोरमित्रहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000497009, "chapter_id": 9497, "verse_number": "६-९०-९", "content_sanskrit": "स रथं भूषयित्वाथ रुचिरं हेमभूषितम्।\nप्रासासिशरसंयुक्तं युक्तं परमवाजिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000497010, "chapter_id": 9497, "verse_number": "६-९०-१०", "content_sanskrit": "अधिष्ठितं हयज्ञेन सूतेनाप्तोपदेशिना।\nआरुरोह महातेजा रावणिः समितिंजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000497011, "chapter_id": 9497, "verse_number": "६-९०-११", "content_sanskrit": "स राक्षसगणैर्मुख्यैर्वृतो मन्दोदरीसुतः।\nनिर्ययौ नगराद् वीरः कृतान्तबलचोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000497012, "chapter_id": 9497, "verse_number": "६-९०-१२", "content_sanskrit": "सोऽभिनिष्क्रम्य नगरादिन्द्रजित् परमौजसा।\nअभ्ययाज्जवनैरश्वैर्लक्ष्मणं सविभीषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000497013, "chapter_id": 9497, "verse_number": "६-९०-१३", "content_sanskrit": "ततो रथस्थमालोक्य सौमित्री रावणात्मजम्।\nवानराश्च महावीर्या राक्षसश्च विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000497014, "chapter_id": 9497, "verse_number": "६-९०-१४", "content_sanskrit": "विस्मयं परमं जग्मुर्लाघवात् तस्य धीमतः।\nरावणिश्चापि संक्रुद्धो रणे वानरयूथपान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000497015, "chapter_id": 9497, "verse_number": "६-९०-१५", "content_sanskrit": "पातयामास बाणौघैः शतशोऽथ सहस्रशः।\nस मण्डलीकृतधनू रावणिः समितिंजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000497016, "chapter_id": 9497, "verse_number": "६-९०-१६", "content_sanskrit": "हरीनभ्यहनत् क्रुद्धः परं लाघवमास्थितः।\nते वध्यमाना हरयो नाराचैर्भीमविक्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000497017, "chapter_id": 9497, "verse_number": "६-९०-१७", "content_sanskrit": "सौमित्रिं शरणं प्राप्ताः प्रजापतिमिव प्रजाः।\nततः समरकोपेन ज्वलितो रघुनन्दनः।\nचिच्छेद कार्मुकं तस्य दर्शयन् पाणिलाघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000497018, "chapter_id": 9497, "verse_number": "६-९०-१८", "content_sanskrit": "सोऽन्यत्कार्मुकमादाय सज्यं चक्रे त्वरन्निव।\nतदप्यस्य त्रिभिर्बाणैर्लक्ष्मणो निरकृन्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000497019, "chapter_id": 9497, "verse_number": "६-९०-१९", "content_sanskrit": "अथैनं छिन्नधन्वानमाशीविषविषोपमैः।\nविव्याधोरसि सौमित्री रावणिं पञ्चभिः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000497020, "chapter_id": 9497, "verse_number": "६-९०-२०", "content_sanskrit": "ते तस्य कायं निर्भिद्य महाकार्मुकनिःसृताः।\nनिपेतुर्धरणीं बाणा रक्ता इव महोरगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000497021, "chapter_id": 9497, "verse_number": "६-९०-२१", "content_sanskrit": "स च्छिन्नधन्वा रुधिरं वमन् वक्त्रेण रावणिः।\nजग्राह कार्मुकश्रेष्ठं दृढज्यं बलवत्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000497022, "chapter_id": 9497, "verse_number": "६-९०-२२", "content_sanskrit": "स लक्ष्मणं समुद्दिश्य परं लाघवमास्थितः।\nववर्ष शरवर्षाणि वर्षाणीव पुरंदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000497023, "chapter_id": 9497, "verse_number": "६-९०-२३", "content_sanskrit": "मुक्तमिन्द्रजिता तत्तु शरवर्षमरिंदमः।\nआवारयदसम्भ्रान्तो लक्ष्मणः सुदुरासदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000497024, "chapter_id": 9497, "verse_number": "६-९०-२४", "content_sanskrit": "संदर्शयामास तदा रावणिं रघुनन्दनः।\nअसम्भ्रान्तो महातेजास्तदद्भुतमिवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000497025, "chapter_id": 9497, "verse_number": "६-९०-२५", "content_sanskrit": "ततस्तान् राक्षसान् सर्वांस्त्रिभिरेकैकमाहवे।\nअविध्यत् परमक्रुद्धः शीघ्रास्त्रं सम्प्रदर्शयन्।\nराक्षसेन्द्रसुतं चापि बाणौघैः समताडयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000497026, "chapter_id": 9497, "verse_number": "६-९०-२६", "content_sanskrit": "सोऽतिविद्धो बलवता शत्रुणा शत्रुघातिना।\nअसक्तं प्रेषयामास लक्ष्मणाय बहून् शरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000497027, "chapter_id": 9497, "verse_number": "६-९०-२७", "content_sanskrit": "तानप्राप्तान् शितैर्बाणैश्चिच्छेद परवीरहा।\nसारथेरस्य च रणे रथिनो रथसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000497028, "chapter_id": 9497, "verse_number": "६-९०-२८", "content_sanskrit": "शिरो जहार धर्मात्मा भल्लेनानतपर्वणा।\nअसूतास्ते हयास्तत्र रथमूहुरविक्लवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000497029, "chapter_id": 9497, "verse_number": "६-९०-२९", "content_sanskrit": "मण्डलान्यभिधावन्ति तदद्भुतमिवाभवत्।\nअमर्षवशमापन्नः सौमित्रिर्दृढविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000497030, "chapter_id": 9497, "verse_number": "६-९०-३०", "content_sanskrit": "प्रत्यविध्यद्धयांस्तस्य शरैर्वित्रासयन् रणे।\nअमर्षमाणस्तत्कर्म रावणस्य सुतो रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000497031, "chapter_id": 9497, "verse_number": "६-९०-३१", "content_sanskrit": "विव्याध दशभिर्बाणैः सौमित्रिं तममर्षणम्।\nते तस्य वज्रप्रतिमाः शराः सर्पविषोपमाः।\nविलयं जग्मुरागत्य कवचं काञ्चनप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000497032, "chapter_id": 9497, "verse_number": "६-९०-३२", "content_sanskrit": "अभेद्यकवचं मत्वा लक्ष्मणं रावणात्मजः।\nललाटे लक्ष्मणं बाणैः सुपुङ्खैस्त्रिभिरिन्द्रजित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000497033, "chapter_id": 9497, "verse_number": "६-९०-३३", "content_sanskrit": "अविध्यत् परमक्रुद्धः शीघ्रमस्त्रं प्रदर्शयन्।\nतैः पृषत्कैर्ललाटस्थैः शुशुभे रघुनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000497034, "chapter_id": 9497, "verse_number": "६-९०-३४", "content_sanskrit": "रणाग्रे समरश्लाघी त्रिशृङ्ग इव पर्वतः।\nस तथाप्यर्दितो बाणै राक्षसेन तदा मृधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000497035, "chapter_id": 9497, "verse_number": "६-९०-३५", "content_sanskrit": "तमाशु प्रतिविव्याध लक्ष्मणः पञ्चभिः शरैः।\nविकृष्येन्द्रजितो युद्धे वदने शुभकुण्डले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000497036, "chapter_id": 9497, "verse_number": "६-९०-३६", "content_sanskrit": "लक्ष्मणेन्द्रजितौ वीरौ महाबलशरासनौ।\nअन्योन्यं जघ्नतुर्वीरौ विशिखैर्भीमविक्रमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000497037, "chapter_id": 9497, "verse_number": "६-९०-३७", "content_sanskrit": "ततः शोणितदिग्धाङ्गौ लक्ष्मणेन्द्रजितावुभौ।\nरणे तौ रेजतुर्वीरौ पुष्पिताविव किंशुकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000497038, "chapter_id": 9497, "verse_number": "६-९०-३८", "content_sanskrit": "तौ परस्परमभ्येत्य सर्वगात्रेषु धन्विनौ।\nघोरैर्विव्यधतुर्बाणैः कृतभावावुभौ जये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000497039, "chapter_id": 9497, "verse_number": "६-९०-३९", "content_sanskrit": "ततः समरकोपेन संयुतो रावणात्मजः।\nविभीषणं त्रिभिर्बाणैर्विव्याध वदने शुभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000497040, "chapter_id": 9497, "verse_number": "६-९०-४०", "content_sanskrit": "अयोमुखैस्त्रिभिर्विद्‍ध्वा राक्षसेन्द्रं विभीषणम्।\nएकैकेनाभिविव्याध तान् सर्वान् हरियूथपान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000497041, "chapter_id": 9497, "verse_number": "६-९०-४१", "content_sanskrit": "तस्मै दृढतरं क्रुद्धो जघान गदया हयान्।\nविभीषणो महातेजा रावणेः स दुरात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000497042, "chapter_id": 9497, "verse_number": "६-९०-४२", "content_sanskrit": "स हताश्वादवप्लुत्य रथान्निहतसारथेः।\nअथ शक्तिं महातेजाः पितृव्याय मुमोच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000497043, "chapter_id": 9497, "verse_number": "६-९०-४३", "content_sanskrit": "तामापतन्तीं सम्प्रेक्ष्य सुमित्रानन्दवर्धनः।\nचिच्छेद निशितैर्बाणैर्दशधापातयद् भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000497044, "chapter_id": 9497, "verse_number": "६-९०-४४", "content_sanskrit": "तस्मै दृढधनुः क्रुद्धो हताश्वाय विभीषणः।\nवज्रस्पर्शसमान् पञ्च ससर्जोरसि मार्गणान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000497045, "chapter_id": 9497, "verse_number": "६-९०-४५", "content_sanskrit": "ते तस्य कायं भित्त्वा तु रुक्मपुङ्खा निमित्तगाः।\nबभूवुर्लोहितादिग्धा रक्ता इव महोरगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000497046, "chapter_id": 9497, "verse_number": "६-९०-४६", "content_sanskrit": "स पितृव्यस्य संक्रुद्ध इन्द्रजिच्छरमाददे।\nउत्तमं रक्षसां मध्ये यमदत्तं महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000497047, "chapter_id": 9497, "verse_number": "६-९०-४७", "content_sanskrit": "तं समीक्ष्य महातेजा महेषुं तेन संहितम्।\nलक्ष्मणोऽप्याददे बाणमन्यद् भीमपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000497048, "chapter_id": 9497, "verse_number": "६-९०-४८", "content_sanskrit": "कुबेरेण स्वयं स्वप्ने यद् दत्तममितात्मना।\nदुर्जयं दुर्विषह्यं च सेन्द्रैरपि सुरासुरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000497049, "chapter_id": 9497, "verse_number": "६-९०-४९", "content_sanskrit": "तयोस्तु धनुषी श्रेष्ठे बाहुभिः परिघोपमैः।\nविकृष्यमाणे बलवत् क्रौञ्चाविव चुकूजतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000497050, "chapter_id": 9497, "verse_number": "६-९०-५०", "content_sanskrit": "ताभ्यां तु धनुषि श्रेष्ठे संहितौ सायकोत्तमौ।\nविकृष्यमाणौ वीराभ्यां भृशं जज्वलतुः श्रिया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000497051, "chapter_id": 9497, "verse_number": "६-९०-५१", "content_sanskrit": "तौ भासयन्तावाकाशं धनुर्भ्यां विशिखौ च्युतौ।\nमुखेन मुखमाहत्य संनिपेततुरोजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000497052, "chapter_id": 9497, "verse_number": "६-९०-५२", "content_sanskrit": "संनिपातस्तयोश्चासीच्छरयोर्घोररूपयोः।\nसधूमविस्फुलिङ्गश्च तज्जोऽग्निर्दारुणोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000497053, "chapter_id": 9497, "verse_number": "६-९०-५३", "content_sanskrit": "तौ महाग्रहसंकाशावन्योन्यं संनिपत्य च।\nसंग्रामे शतधा यातौ मेदिन्यां चैव पेततुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000497054, "chapter_id": 9497, "verse_number": "६-९०-५४", "content_sanskrit": "शरौ प्रतिहतौ दृष्ट्वा तावुभौ रणमूर्धनि।\nव्रीडितौ जातरोषौ च लक्ष्मणेन्द्रजितौ तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000497055, "chapter_id": 9497, "verse_number": "६-९०-५५", "content_sanskrit": "सुसंरब्धस्तु सौमित्रिरस्त्रं वारुणमाददे।\nरौद्रं महेन्द्रजिद् युद्धेऽप्यसृजद् युधि निष्ठितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000497056, "chapter_id": 9497, "verse_number": "६-९०-५६", "content_sanskrit": "तेन तद्विहितं शस्त्रं वारुणं परमाद्भुतम्।\nततः क्रुद्धो महातेजा इन्द्रजित् समितिंजयः।\nआग्नेयं संदधे दीप्तं स लोकं संक्षिपन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000497057, "chapter_id": 9497, "verse_number": "६-९०-५७", "content_sanskrit": "सौरेणास्त्रेण तद् वीरो लक्ष्मणः पर्यवारयत्।\nअस्त्रं निवारितं दृष्ट्वा रावणिः क्रोधमूर्च्छितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000497058, "chapter_id": 9497, "verse_number": "६-९०-५८", "content_sanskrit": "आददे निशितं बाणमासुरं शत्रुदारणम्।\nतस्माच्चापाद् विनिष्पेतुर्भास्वराः कूटमुद‍्गराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000497059, "chapter_id": 9497, "verse_number": "६-९०-५९", "content_sanskrit": "शूलानि च भुशुण्ड्यश्च गदाः खड्गाः परश्वधाः।\nतद् दृष्ट्वा लक्ष्मणः संख्ये घोरमस्त्रमथासुरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000497060, "chapter_id": 9497, "verse_number": "६-९०-६०", "content_sanskrit": "अवार्यं सर्वभूतानां सर्वशस्त्रविदारणम्।\nमाहेश्वरेण द्युतिमांस्तदस्त्रं प्रत्यवारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000497061, "chapter_id": 9497, "verse_number": "६-९०-६१", "content_sanskrit": "तयोः समभवद् युद्धमद्भुतं रोमहर्षणम्।\nगगनस्थानि भूतानि लक्ष्मणं पर्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000497062, "chapter_id": 9497, "verse_number": "६-९०-६२", "content_sanskrit": "भैरवाभिरुते भीमे युद्धे वानररक्षसाम्।\nभूतैर्बहुभिराकाशं विस्मितैरावृतं बभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000497063, "chapter_id": 9497, "verse_number": "६-९०-६३", "content_sanskrit": "ऋषयः पितरो देवा गन्धर्वगरुडोरगाः।\nशतक्रतुं पुरस्कृत्य ररक्षुर्लक्ष्मणं रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000497064, "chapter_id": 9497, "verse_number": "६-९०-६४", "content_sanskrit": "अथान्यं मार्गणश्रेष्ठं संदधे राघवानुजः।\nहुताशनसमस्पर्शं रावणात्मजदारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000497065, "chapter_id": 9497, "verse_number": "६-९०-६५", "content_sanskrit": "सुपत्रमनुवृत्ताङ्गं सुपर्वाणं सुसंस्थितम्।\nसुवर्णविकृतं वीरः शरीरान्तकरं शरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000497066, "chapter_id": 9497, "verse_number": "६-९०-६६", "content_sanskrit": "दुरावारं दुर्विषहं राक्षसानां भयावहम्।\nआशीविषविषप्रख्यं देवसंघैः समर्चितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000497067, "chapter_id": 9497, "verse_number": "६-९०-६७", "content_sanskrit": "येन शक्रो महातेजा दानवानजयत् प्रभुः।\nपुरा देवासुरे युद्धे वीर्यवान् हरिवाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 5000497068, "chapter_id": 9497, "verse_number": "६-९०-६८", "content_sanskrit": "अथैन्द्रमस्त्रं सौमित्रिः संयुगेष्वपराजितम्।\nशरश्रेष्ठं धनुश्रेष्ठे विकर्षन्निदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 5000497069, "chapter_id": 9497, "verse_number": "६-९०-६९", "content_sanskrit": "लक्ष्मीवाँल्लक्ष्मणो वाक्यमर्थसाधकमात्मनः।\nधर्मात्मा सत्यसंधश्च रामो दाशरथिर्यदि।\nपौरुषे चाप्रतिद्वन्द्वस्तदैनं जहि रावणिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 5000497070, "chapter_id": 9497, "verse_number": "६-९०-७०", "content_sanskrit": "इत्युक्त्वा बाणमाकर्णं विकृष्य तमजिह्मगम्।\nलक्ष्मणः समरे वीरः ससर्जेन्द्रजितं प्रति।\nऐन्द्रास्त्रेण समायुज्य लक्ष्मणः परवीरहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 5000497071, "chapter_id": 9497, "verse_number": "६-९०-७१", "content_sanskrit": "तच्छिरः सशिरस्त्राणं श्रीमज्ज्वलितकुण्डलम्।\nप्रमथ्येन्द्रजितः कायात् पातयामास भूतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 5000497072, "chapter_id": 9497, "verse_number": "६-९०-७२", "content_sanskrit": "तद् राक्षसतनूजस्य भिन्नस्कन्धं शिरो महत्।\nतपनीयनिभं भूमौ ददृशे रुधिरोक्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 5000497073, "chapter_id": 9497, "verse_number": "६-९०-७३", "content_sanskrit": "हतः स निपपाताथ धरण्यां रावणात्मजः।\nकवची सशिरस्त्राणो विप्रविद्धशरासनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 5000497074, "chapter_id": 9497, "verse_number": "६-९०-७४", "content_sanskrit": "चुक्रुशुस्ते ततः सर्वे वानराः सविभीषणाः।\nहृष्यन्ते निहते तस्मिन् देवा वृत्रवधे यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 5000497075, "chapter_id": 9497, "verse_number": "६-९०-७५", "content_sanskrit": "अथान्तरिक्षे देवानामृषीणां च महात्मनाम्।\nजज्ञेऽथ जयसंनादो गन्धर्वाप्सरसामपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 5000497076, "chapter_id": 9497, "verse_number": "६-९०-७६", "content_sanskrit": "पतितं समभिज्ञाय राक्षसी सा महाचमूः।\nवध्यमाना दिशो भेजे हरिभिर्जितकाशिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 5000497077, "chapter_id": 9497, "verse_number": "६-९०-७७", "content_sanskrit": "वानरैर्वध्यमानास्ते शस्त्राण्युत्सृज्य राक्षसाः।\nलङ्कामभिमुखाः सस्रुर्भ्रष्टसंज्ञाः प्रधाविताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 5000497078, "chapter_id": 9497, "verse_number": "६-९०-७८", "content_sanskrit": "दुद्रुवुर्बहुधा भीता राक्षसाः शतशो दिशः।\nत्यक्त्वा प्रहरणान् सर्वे पट्टिशासिपरश्वधान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 5000497079, "chapter_id": 9497, "verse_number": "६-९०-७९", "content_sanskrit": "केचिल्लङ्कां परित्रस्ताः प्रविष्टा वानरार्दिताः।\nसमुद्रे पतिताः केचित् केचित् पर्वतमाश्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 5000497080, "chapter_id": 9497, "verse_number": "६-९०-८०", "content_sanskrit": "हतमिन्द्रजितं दृष्ट्वा शयानं च रणक्षितौ।\nराक्षसानां सहस्रेषु न कश्चित् प्रत्यदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 5000497081, "chapter_id": 9497, "verse_number": "६-९०-८१", "content_sanskrit": "यथास्तं गत आदित्ये नावतिष्ठन्ति रश्मयः।\nतथा तस्मिन् निपतिते राक्षसास्ते गता दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 5000497082, "chapter_id": 9497, "verse_number": "६-९०-८२", "content_sanskrit": "शान्तरश्मिरिवादित्यो निर्वाण इव पावकः।\nबभूव स महाबाहुर्व्यपास्तगतजीवितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 5000497083, "chapter_id": 9497, "verse_number": "६-९०-८३", "content_sanskrit": "प्रशान्तपीडाबहुलो विनष्टारिः प्रहर्षवान्।\nबभूव लोकः पतिते राक्षसेन्द्रसुते तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 5000497084, "chapter_id": 9497, "verse_number": "६-९०-८४", "content_sanskrit": "हर्षं च शक्रो भगवान् सह सर्वैर्महर्षिभिः।\nजगाम निहते तस्मिन् राक्षसे पापकर्मणि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 5000497085, "chapter_id": 9497, "verse_number": "६-९०-८५", "content_sanskrit": "आकाशे चापि देवानां शुश्रुवे दुन्दुभिस्वनः।\nनृत्यद्भिरप्सरोभिश्च गन्धर्वैश्च महात्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 5000497086, "chapter_id": 9497, "verse_number": "६-९०-८६", "content_sanskrit": "ववर्षुः पुष्पवर्षाणि तदद्भुतमिवाभवत्।\nप्रशशाम हते तस्मिन् राक्षसे क्रूरकर्मणि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 5000497087, "chapter_id": 9497, "verse_number": "६-९०-८७", "content_sanskrit": "शुद्धा आपो नभश्चैव जहृषुर्देवदानवाः।\nआजग्मुः पतिते तस्मिन् सर्वलोकभयावहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 5000497088, "chapter_id": 9497, "verse_number": "६-९०-८८", "content_sanskrit": "ऊचुश्च सहितास्तुष्टा देवगन्धर्वदानवाः।\nविज्वराः शान्तकलुषा ब्राह्मणा विचरन्त्विति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 5000497089, "chapter_id": 9497, "verse_number": "६-९०-८९", "content_sanskrit": "ततोऽभ्यनन्दन् संहृष्टाः समरे हरियूथपाः।\nतमप्रतिबलं दृष्ट्वा हतं नैर्ऋतपुङ्गवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 5000497090, "chapter_id": 9497, "verse_number": "६-९०-९०", "content_sanskrit": "विभीषणो हनूमांश्च जाम्बवांश्चर्क्षयूथपः।\nविजयेनाभिनन्दन्तस्तुष्टुवुश्चापि लक्ष्मणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 5000497091, "chapter_id": 9497, "verse_number": "६-९०-९१", "content_sanskrit": "क्ष्वेडन्तश्च प्लवन्तश्च गर्जन्तश्च प्लवंगमाः।\nलब्धलक्षा रघुसुतं परिवार्योपतस्थिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 5000497092, "chapter_id": 9497, "verse_number": "६-९०-९२", "content_sanskrit": "लाङ्गूलानि प्रविध्यन्तः स्फोटयन्तश्च वानराः।\nलक्ष्मणो जयतीत्येव वाक्यं विश्रावयंस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 5000497093, "chapter_id": 9497, "verse_number": "६-९०-९३", "content_sanskrit": "अन्योन्यं च समाश्लिष्य हरयो हृष्टमानसाः।\nचक्रुरुच्चावचगुणा राघवाश्रयसत्कथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 5000497094, "chapter_id": 9497, "verse_number": "६-९०-९४", "content_sanskrit": "तदसुकरमथाभिवीक्ष्य हृष्टाः\nप्रियसुहृदो युधि लक्ष्मणस्य कर्म।\nपरममुपलभन्मनःप्रहर्षं\nविनिहतमिन्द्ररिपुं निशम्य देवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 5000497095, "chapter_id": 9497, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे नवतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}]