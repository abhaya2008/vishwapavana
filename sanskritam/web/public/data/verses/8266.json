[{"id": 900002469, "chapter_id": 8266, "verse_number": "11.1", "content_sanskrit": "अशेषगुणपूर्णाय दोषदूराय विष्णवे । नमः श्रीप्राणनाथाय भक्ताभीष्टप्रदायिने", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900002470, "chapter_id": 8266, "verse_number": "11.2", "content_sanskrit": "ॐ समस्तस्य खलु साम्ना उपासनं साधु ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900002471, "chapter_id": 8266, "verse_number": "11.3", "content_sanskrit": "असौ वा आदित्यो देवमधु तस्य द्यौरेव तिरश्चीनवंशोऽन्तरिक्षमपूपो मरीचयः पुत्राः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900002472, "chapter_id": 8266, "verse_number": "11.4", "content_sanskrit": "जानश्रुतिर्ह पौत्रायणः श्रद्धादेयो बहुदायी बहुवाक्य आस", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900002473, "chapter_id": 8266, "verse_number": "11.5", "content_sanskrit": "यो ह वै ज्येष्ठं च श्रेष्ठं च वेद ज्येष्ठश्च ह वै श्रेष्ठश्च ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900002474, "chapter_id": 8266, "verse_number": "11.6", "content_sanskrit": "श्वेतकेतुर्हाऽरुणेय आस त ह पितोवाच श्वेतकेतो ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900002475, "chapter_id": 8266, "verse_number": "11.7", "content_sanskrit": "अधीहि भगव इति होपससाद सनत्कुमारं नारदस्तं होवाच ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900002476, "chapter_id": 8266, "verse_number": "11.8", "content_sanskrit": "अथ यदिदमस्मिन् ब्रह्मपुरे दहरं पुण्डरीकं वेश्म..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}]