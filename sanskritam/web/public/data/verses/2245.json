[{"id": 2057473, "chapter_id": 2245, "verse_number": "७-१७२-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2057474, "chapter_id": 2245, "verse_number": "७-१७२-१", "content_sanskrit": "ततस्ते प्राद्रवन्सर्वे त्वरिता युद्धदुर्मदाः।\nअमृष्यमाणाः संरब्धा युयुधानरथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2057475, "chapter_id": 2245, "verse_number": "७-१७२-२", "content_sanskrit": "ते रथैः कल्पितै राजन्हेमरूप्यविभूषितैः।\nसादिभिश्च गजैश्चैव परिवव्रुः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2057476, "chapter_id": 2245, "verse_number": "७-१७२-३", "content_sanskrit": "अथैनं कोष्ठकीकृत्य सर्वतस्ते महारथाः।\nसिंहनादांस्ततश्चक्रुस्तर्जयन्ति स्म सात्यकिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2057477, "chapter_id": 2245, "verse_number": "७-१७२-४", "content_sanskrit": "तेऽभ्यवर्षञ्छरैस्तीक्ष्णैः सात्यकिं सत्यविक्रमम्।\nत्वरमाणा महावीरा माधवस्य वधैषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2057478, "chapter_id": 2245, "verse_number": "७-१७२-५", "content_sanskrit": "तान्दृष्ट्वा पततस्तूर्णं शैनेयः परवीरहा।\nप्रत्यगृह्णान्महाबाहुः प्रमुञ्चन्विशिखान्बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2057479, "chapter_id": 2245, "verse_number": "७-१७२-६", "content_sanskrit": "तत्र वीरो महेष्वासः सात्यकिर्युद्धदुर्मदः।\nनिचकर्त शिरांस्युग्रैः शरैः सन्नतपर्वभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2057480, "chapter_id": 2245, "verse_number": "७-१७२-७", "content_sanskrit": "हस्तिहस्तान्हयग्रीवा बाहूनपि च सायुधान्।\nक्षुरप्रैः शातयामास तावकानां स माधवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2057481, "chapter_id": 2245, "verse_number": "७-१७२-८", "content_sanskrit": "पतितैश्चामरैश्चैव श्वेतच्छत्रैश्च भारत।\nबभूव धरणी पूर्णा नक्षत्रैर्द्यौरिव प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2057482, "chapter_id": 2245, "verse_number": "७-१७२-९", "content_sanskrit": "एतेषां युयुधानेन युध्यतां युधि भारत।\nबभूव तुमुलः शब्दः प्रेतानां क्रन्दतामिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2057483, "chapter_id": 2245, "verse_number": "७-१७२-१०", "content_sanskrit": "तेन शब्देन महता पूरिताऽभूद्वसुन्धरा।\nरात्रिः समभवच्चैव तीव्ररूपा भयावहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2057484, "chapter_id": 2245, "verse_number": "७-१७२-११", "content_sanskrit": "दीर्यमाणं बलं दृष्ट्वा युयुधानशराहतम्।\nश्रुत्वा च विपुलं नादं निशीथे रोमहर्षणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2057485, "chapter_id": 2245, "verse_number": "७-१७२-१२", "content_sanskrit": "सुतस्तवाब्रवीद्राजन्सारथिंरथिनां वरः।\nयत्रैष शब्दस्तत्राश्वांश्चोदयेति पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2057486, "chapter_id": 2245, "verse_number": "७-१७२-१३", "content_sanskrit": "तेन सञ्चोद्यमानस्तु ततस्तांस्तुरगोत्तमान्।\nसूतः सञ्चोदयामास युयुधानरथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2057487, "chapter_id": 2245, "verse_number": "७-१७२-१४", "content_sanskrit": "ततो दुर्योधनः क्रुद्धो दृढधन्वा जितक्लमः।\nशीघ्रहस्तश्चित्रयोधी युयुधानमुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2057488, "chapter_id": 2245, "verse_number": "७-१७२-१५", "content_sanskrit": "ततः पूर्णायतोत्सृष्टैः शरैः शोणितभोजनैः।\nदुर्योधनं द्वादशभिर्माधवः प्रत्यविध्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2057489, "chapter_id": 2245, "verse_number": "७-१७२-१६", "content_sanskrit": "दुर्योधनस्तेन तथा पूर्वमेवार्दितः शरैः।\nशैनेयं दशभिर्बाणैः प्रत्यविध्यदमर्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2057490, "chapter_id": 2245, "verse_number": "७-१७२-१७", "content_sanskrit": "ततः समभवद्युद्धं तुमुलं भरतर्षभ।\nपाञ्चालानां च सर्वेषां भरतानां च दारुणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2057491, "chapter_id": 2245, "verse_number": "७-१७२-१८", "content_sanskrit": "शैनेयस्तु रणे क्रुद्धस्तव पुत्रं महारथम्।\nसायकानामशीत्या तु विव्याधोरसि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2057492, "chapter_id": 2245, "verse_number": "७-१७२-१९", "content_sanskrit": "ततोऽस्य वाहान्समरे शरैर्निन्ये यमक्षयम्।\nसारथिं च रथात्तूर्णं पातयामास पत्रिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2057493, "chapter_id": 2245, "verse_number": "७-१७२-२०", "content_sanskrit": "हताश्वे तु रथेऽतिष्ठन्पुत्रस्तव विशाम्पते।\nमुमोच निशितान्बाणाञ्शैनेयस्य रथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2057494, "chapter_id": 2245, "verse_number": "७-१७२-२१", "content_sanskrit": "शरान्पञ्छसतांस्तस्मै शैनेयः कृतहस्तवत्।\nचिच्छेद समरे राजन्प्रेषितांस्तनयेन ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2057495, "chapter_id": 2245, "verse_number": "७-१७२-२२", "content_sanskrit": "अथापरेण भल्लेन मुष्टिदेशे महद्धनुः।\nचिच्छेद तरसा युद्धे तव पुत्रस्य माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2057496, "chapter_id": 2245, "verse_number": "७-१७२-२३", "content_sanskrit": "विरथो विधनुष्कश्च सर्वलोकेश्वरः प्रभुः।\nआरुरोह रथं तूर्णं भास्वरं कृतवर्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2057497, "chapter_id": 2245, "verse_number": "७-१७२-२४", "content_sanskrit": "दुर्योधने परावृत्ते शैनेयस्तव वाहिनीम्।\nद्रावयामास विशिखैर्निशामध्ये विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2057498, "chapter_id": 2245, "verse_number": "७-१७२-२५", "content_sanskrit": "शकुनिश्चार्जुनं राजन्परिवार्य समन्ततः।\nरथैरनेकसाहस्रैर्गजैश्चापि सहस्रशः।\nतथा हयसहस्रैश्च नानाशस्त्रैरवाकिरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2057499, "chapter_id": 2245, "verse_number": "७-१७२-२६", "content_sanskrit": "ते महास्त्राणि सर्वाणि विकिरन्तोऽर्जुनं प्रति।\nअर्जुनं योधयन्ति स्म क्षत्रियाः कालचोदिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2057500, "chapter_id": 2245, "verse_number": "७-१७२-२७", "content_sanskrit": "तान्यर्जुनः सहस्राणि रथवारणवाजिनाम्।\nप्रत्यवारयदायस्तः प्रकुर्वन्विपुलं क्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2057501, "chapter_id": 2245, "verse_number": "७-१७२-२८", "content_sanskrit": "ततस्तु समरे शूरः शकुनिः सौबलस्तदा।\nविव्याध निशितैर्बाणैरर्जुनं प्रहसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2057502, "chapter_id": 2245, "verse_number": "७-१७२-२९", "content_sanskrit": "पुनश्चैव शतेनास्य संरुरोध महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2057503, "chapter_id": 2245, "verse_number": "७-१७२-३०", "content_sanskrit": "तमर्जुनस्तु विंशत्या विव्याध युधि भारत।\nअथेतरान्महेष्वासांस्त्रिभिस्त्रिभिरविध्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2057504, "chapter_id": 2245, "verse_number": "७-१७२-३१", "content_sanskrit": "निवार्य तान्बाणगणैर्युधि राजन्धनञ्जयः।\nजघान तावकान्योधान्वज्रपाणिरिवासुरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2057505, "chapter_id": 2245, "verse_number": "७-१७२-३२", "content_sanskrit": "भुजैश्छिन्नैर्महीपाल हस्तिहस्तोपमैर्मृधे।\nसमाकीर्णा मही भाति पञ्चास्यैरिव पन्नगैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2057506, "chapter_id": 2245, "verse_number": "७-१७२-३३", "content_sanskrit": "शिरोभिः सकिरीटैश्च सुनसैश्चारुकुण्डलैः।\nसन्दष्टौष्ठपुटैः क्रुद्धैस्तथैवोद्वृत्तलोचनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2057507, "chapter_id": 2245, "verse_number": "७-१७२-३४", "content_sanskrit": "निष्कचूडामणिधरैः क्षत्रियाणां पियंवदैः।\nपङ्कजैरिव विन्यस्तैः पर्वतैर्विबभौ मही॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2057508, "chapter_id": 2245, "verse_number": "७-१७२-३५", "content_sanskrit": "कृत्वा तत्कर्म बीभत्सुरुग्रमुग्रपराक्रमः।\nविव्याध शकुनिं भूयः पञ्चभिर्नतपर्वभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2057509, "chapter_id": 2245, "verse_number": "७-१७२-३६", "content_sanskrit": "अताडयदुलूकं च त्रिभिरेव तथा शरैः।\nउलूकं पुनराजघ्ने त्रिभिरेव महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2057510, "chapter_id": 2245, "verse_number": "७-१७२-३७", "content_sanskrit": "स तु तेन समाविद्ध क्रोधाद्द्विगुणविक्रमः।\nशरैरनेकसाहस्रैः सोऽर्जुनं प्रत्यविध्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2057511, "chapter_id": 2245, "verse_number": "७-१७२-३८", "content_sanskrit": "तमुलूकस्तथा विद्धा वासुदेवमताडयत्।\nननाद च महानादं पूरयन्निव मेदिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2057512, "chapter_id": 2245, "verse_number": "७-१७२-३९", "content_sanskrit": "अर्जुनः शकुनेश्चापं सायकैरच्छिनद्रणे।\nनिन्ये च चतुरो वाहान्यमस्य सदनं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2057513, "chapter_id": 2245, "verse_number": "७-१७२-४०", "content_sanskrit": "ततो रथादवप्लुत्य सौबलो भरतर्षभ।\nउलूकस्य रथं तूर्णमारुरोह विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2057514, "chapter_id": 2245, "verse_number": "७-१७२-४१", "content_sanskrit": "तावेकरथमारूढौ पितापुत्रौ महारथौ।\nपार्थं सिषिचतुर्बाणैर्गिरिं मेघाविवाम्बुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2057515, "chapter_id": 2245, "verse_number": "७-१७२-४२", "content_sanskrit": "तौ तु विद्धा महाराज पाण्डवो निशितैः शरैः।\nविद्रावयंस्तव चमूं शतशो व्यधमच्छरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2057516, "chapter_id": 2245, "verse_number": "७-१७२-४३", "content_sanskrit": "अनिलेन यथाऽभ्राणि विच्छिन्नानि समन्ततः।\nविच्छिन्नानि तथा राजन्बलान्यासन्विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2057517, "chapter_id": 2245, "verse_number": "७-१७२-४४", "content_sanskrit": "तद्बलं भरतश्चेष्ठ वध्यमानं तदा निशि।\nप्रदुद्राव दिशः सर्वा वीक्षमाणं भयार्दितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2057518, "chapter_id": 2245, "verse_number": "७-१७२-४५", "content_sanskrit": "उत्सृज्य वाहान्समरे चोदयन्तस्तथाऽपरे।\nसम्भ्रान्ताः पर्यधावन्त तस्मिंस्तमसि दारुणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2057519, "chapter_id": 2245, "verse_number": "७-१७२-४६", "content_sanskrit": "विजित्य समरे योधांस्तावकान्भरतर्षभ।\nदध्मतुर्मुदितौ शङ्खौ वासुदेवधनञ्जयौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2057520, "chapter_id": 2245, "verse_number": "७-१७२-४७", "content_sanskrit": "धृष्टद्युम्नो महाराज द्रोणं विद्धा त्रिभिः शरैः।\nचिच्छेद धनुषस्तूर्णं ज्यां शरेण शितेन ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2057521, "chapter_id": 2245, "verse_number": "७-१७२-४८", "content_sanskrit": "तन्निधाय धनुर्भूमौ द्रोणः क्षत्रियमर्दनः।\nआददेऽन्यद्धनुः शूरो वेगवत्सारवत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2057522, "chapter_id": 2245, "verse_number": "७-१७२-४९", "content_sanskrit": "धृष्टद्युम्नं ततो द्रोणो विद्धा सप्तभिराशुगैः।\nसारथिं पञ्चभिर्बाणै राजन्विव्याध संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2057523, "chapter_id": 2245, "verse_number": "७-१७२-५०", "content_sanskrit": "तं निवार्य शरैस्तूर्णं धृष्टद्युम्नो महारथः।\nव्यधमत्कौरवीं सेनामासुरीं मघवानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2057524, "chapter_id": 2245, "verse_number": "७-१७२-५१", "content_sanskrit": "वध्यमाने बले तस्मिंस्तव पुत्रस्य मारिष।\nप्रावर्तत नदी घोरां शोणितौघतरङ्गिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2057525, "chapter_id": 2245, "verse_number": "७-१७२-५२", "content_sanskrit": "उभयोः सेनयोर्मध्ये नराधद्विपवाहिनी।\nतथा वैतरणी राजन्यतराजुपुरं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2057526, "chapter_id": 2245, "verse_number": "७-१७२-५३", "content_sanskrit": "द्रावयित्वा तु तत्सैन्यं धृष्टद्युम्नः प्रतापवान्।\nअभ्यराजत तेजस्वी शक्रो देवगणेष्विव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2057527, "chapter_id": 2245, "verse_number": "७-१७२-५४", "content_sanskrit": "अथ दध्मुर्महाशङ्खान्धृष्टद्युम्नशिखण्डिनौ।\nयमौ च युयुधानश्च पाण्डक्य वृकोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2057528, "chapter_id": 2245, "verse_number": "७-१७२-५५", "content_sanskrit": "जित्वा रथसहस्राणि तावकानां महारथाः।\nसिंहनादरवांश्चक्रुः पाण़्डवा जितकाशिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2057529, "chapter_id": 2245, "verse_number": "७-१७२-५६", "content_sanskrit": "पश्यतस्तव पुत्रस्य कर्णस्य च रणोत्कटाः।\nतथा द्रोणस्य शूरस्य द्रौणेश्चैव विशाम्पते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2057530, "chapter_id": 2245, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि घटोत्कचवधपर्वणि चतुर्दशरात्रियुद्धे द्विसप्तत्यधिकशततमोऽध्यायः॥ १७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]