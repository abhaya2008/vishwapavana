[{"id": 5000584000, "chapter_id": 9584, "verse_number": "७-४९-१", "content_sanskrit": "सीतां तु रुदतीं दृष्ट्वा ते तत्र मुनिदारकाः ।\nप्राद्रवन्यत्र भगवानास्ते वाल्मीकिरुग्रधीः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000584001, "chapter_id": 9584, "verse_number": "७-४९-२", "content_sanskrit": "अभिवाद्य मुनेः पादौ मुनिपुत्रा महर्षये ।\nसर्वं निवेदयामासुस्तस्यास्तु रुदितस्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000584002, "chapter_id": 9584, "verse_number": "७-४९-३", "content_sanskrit": "अदृष्टपूर्वा भगवन्कस्याप्येषा महात्मनः ।\nपत्नी श्रीरिव सम्मोहाद्विरौति विकृतानना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000584003, "chapter_id": 9584, "verse_number": "७-४९-४", "content_sanskrit": "भगवन्साधु पश्य त्वं देवतामिव खाच्च्युताम् ।\nनद्यास्तु तीरे भगवन्वरस्त्री कापि दुःखिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000584004, "chapter_id": 9584, "verse_number": "७-४९-५", "content_sanskrit": "दृष्टास्माभिः प्ररुदिता दृढं शोकपरायणा ।\nअनर्हा दुःखशोकाभ्यामेकां दीनां ह्यनाथवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000584005, "chapter_id": 9584, "verse_number": "७-४९-६", "content_sanskrit": "न ह्येनां मानुषीं विद्मः सत्क्रिया ऽस्याः प्रयुज्यताम् ।\nआश्रमस्याविदूरे च त्वामियं शरणं गता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000584006, "chapter_id": 9584, "verse_number": "७-४९-७", "content_sanskrit": "त्रातारमिच्छते साध्वी भगवंस्त्रातुमर्हसि ।\nतेषां तु वचनं श्रुत्वा बुद्ध्या निश्चित्य धर्मवित् ।\nतपसा लब्धचक्षुष्मान् प्राद्रवद्यत्र मैथिली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000584007, "chapter_id": 9584, "verse_number": "७-४९-८", "content_sanskrit": "तं प्रयान्तमभिप्रेत्य शिष्या ह्येनं महामतिम् ।\nतं तु देशमभि प्रेत्य किञ्चित्पद्भ्यां महामतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000584008, "chapter_id": 9584, "verse_number": "७-४९-९", "content_sanskrit": "अर्घ्यमादाय रुचिरं जाह्नवीतीरमागमत् ।\nददर्श राघवस्येष्टां सीतां पत्नीमनाथवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000584009, "chapter_id": 9584, "verse_number": "७-४९-१०", "content_sanskrit": "तां सीतां शोकभारार्तां वाल्मीकिर्मुनिपुङ्गवः ।\nउवाच मधुरां वाणीं ह्लादयन्निव तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000584010, "chapter_id": 9584, "verse_number": "७-४९-११", "content_sanskrit": "स्नुषा दशरथस्य त्वं रामस्य महिषी प्रिया ।\nजनकस्य सुता राज्ञः स्वागतं ते पतिव्रते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000584011, "chapter_id": 9584, "verse_number": "७-४९-१२", "content_sanskrit": "आयान्ती चासि विज्ञाता मया धर्मसमाधिना ।\nकारणं चैव सर्वं मे हृदयेनोपलक्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000584012, "chapter_id": 9584, "verse_number": "७-४९-१३", "content_sanskrit": "तव चैव महाभागे विदितं मम तत्त्वतः ।\nसर्वं च विदितं मह्यं त्रैलोक्ये यद्धि वर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000584013, "chapter_id": 9584, "verse_number": "७-४९-१४", "content_sanskrit": "अपापां वेद्मि सीते त्वां तपोलब्धेन चक्षुषा ।\nविस्रब्धा भव वैदेहि साम्प्रतं मयि वर्तसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000584014, "chapter_id": 9584, "verse_number": "७-४९-१५", "content_sanskrit": "आश्रमस्याविदूरे मे तापस्यस्तपसि स्थिताः ।\nतास्त्वां वत्से यथा वत्सं पालयिष्यन्ति नित्यशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000584015, "chapter_id": 9584, "verse_number": "७-४९-१६", "content_sanskrit": "इदमर्ध्यं प्रतीच्छ त्वं विस्रब्धा विगतज्वरा ।\nयथा स्वगृहमभ्येत्य विषादं चैव मा कृथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000584016, "chapter_id": 9584, "verse_number": "७-४९-१७", "content_sanskrit": "श्रुत्वा तु भाषितं सीता मुनेः परममद्भुतम् ।\nशिरसा ऽ ऽवन्द्य चरणौ तथेत्याह कृताञ्जलिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000584017, "chapter_id": 9584, "verse_number": "७-४९-१८", "content_sanskrit": "तं प्रयान्तं मुनिं सीता प्राञ्जलिः पृष्ठतो ऽन्वगात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000584018, "chapter_id": 9584, "verse_number": "७-४९-१९", "content_sanskrit": "तं दृष्ट्वा मुनिमायान्तं वैदेह्या मुनिपत्नयः ।\nउपाजग्मुर्मुदा युक्ता वचनं चेदमब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000584019, "chapter_id": 9584, "verse_number": "७-४९-२०", "content_sanskrit": "स्वागतं ते मुनिश्रेष्ठ चिरस्यागमनं च ते ।\nअभिवादयामस्त्वां सर्वा उच्यतां कि च कुर्महे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000584020, "chapter_id": 9584, "verse_number": "७-४९-२१", "content_sanskrit": "तासां तद्वचनं श्रुत्वा वाल्मीकिरिदमब्रवीत् ।\nसीतेयं समनुप्राप्ता पत्नी रामस्य धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000584021, "chapter_id": 9584, "verse_number": "७-४९-२२", "content_sanskrit": "स्नुषा दशरथस्यैषा जनकस्य सुता सती ।\nअपापा पतिना त्यक्ता परिपाल्या मया सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000584022, "chapter_id": 9584, "verse_number": "७-४९-२३", "content_sanskrit": "इमां भवन्त्यः(?) पश्यन्तु स्नेहेन परमेण हि ।\nगौरवान्मम वाक्याच्च पूज्या वो ऽस्तु विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000584023, "chapter_id": 9584, "verse_number": "७-४९-२४", "content_sanskrit": "मुहुर्मुहुश्च वैदेहीं प्रणिधाय महायशाः ।\nस्वमाश्रमं शिष्यवृतः पुनरायान्महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000584024, "chapter_id": 9584, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे एकोनपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]