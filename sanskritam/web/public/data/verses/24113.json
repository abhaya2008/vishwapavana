[{"id": 7004113000, "chapter_id": 24113, "verse_number": "४-६२-१", "content_sanskrit": "अगस्त्य उवाच ।\nश्रुत्वा स्कंद न तृप्तोस्मि तव वक्त्रेरितां कथाम् ।\nअत्याश्चर्यकरं प्रोक्तमाख्यानं बैंदुमाधवम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004113001, "chapter_id": 24113, "verse_number": "४-६२-२", "content_sanskrit": "इदानीं श्रोतुमिच्छामि देवदेवसमागमम् ।\nतार्क्ष्यात्त्र्यक्षः समाकर्ण्य दिवोदासस्य चेष्टितम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004113002, "chapter_id": 24113, "verse_number": "४-६२-३", "content_sanskrit": "विष्णुमायाप्रपंचं च किमाह गरुडध्वजम् ।\nके के च शंभुना सार्धं समीयुर्मंदराद्गिरेः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004113003, "chapter_id": 24113, "verse_number": "४-६२-४", "content_sanskrit": "ब्रह्मणेशः कथं दृष्टस्त्रपाकुलित चक्षुषा ।\nकिमाह देव ब्रह्माणं किमुक्तं भास्वतापि च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004113004, "chapter_id": 24113, "verse_number": "४-६२-५", "content_sanskrit": "योगिनीभिः किमाख्यायि गणाह्रीणाः किमब्रुवन् ।\nएतदाख्याहि मे स्कंद महत्कौतूहलं मयि ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004113005, "chapter_id": 24113, "verse_number": "४-६२-६", "content_sanskrit": "इमं प्रश्नं निशम्यैशिर्मुनेः कलशजन्मनः ।\nप्रत्युवाच नमस्कृत्य शिवौ प्रणतसिद्धिदौ ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004113006, "chapter_id": 24113, "verse_number": "४-६२-७", "content_sanskrit": "स्कंद उवाच ।\nमुने शृणु कथामेतां सर्वपातकनाशिनीम् ।\nअशेषविघ्नशमनीं महाश्रेयोभिवर्धिनीम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004113007, "chapter_id": 24113, "verse_number": "४-६२-८", "content_sanskrit": "अथ देवोऽसुररिपुः श्रुत्वा शंभुसमागमम् ।\nद्विजराजाय स मुदा समदात्पारितोषिकम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004113008, "chapter_id": 24113, "verse_number": "४-६२-९", "content_sanskrit": "आयानं शंसते शंभोरुपवाराणसिप्रियम् ।\nब्रह्माणमग्रतः कृत्वा ततश्चाभ्युद्ययौ हरिः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004113009, "chapter_id": 24113, "verse_number": "४-६२-१०", "content_sanskrit": "विवस्वता समेतश्च तैर्गणैः परितो वृतः ।\nयोगिनीभिरनूद्यातो गणेशमुपसंस्थितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004113010, "chapter_id": 24113, "verse_number": "४-६२-११", "content_sanskrit": "अथनेत्रातिथीकृत्य देवदेवं वृषध्वजम् ।\nमंक्षु तार्क्ष्यादवारुह्य प्रणनाम श्रियः पतिः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004113011, "chapter_id": 24113, "verse_number": "४-६२-१२", "content_sanskrit": "पितामहोपि स्थविरो भृशं नम्रशिरोधरः ।\nप्रणतेन मृडेनैव प्रणमन्विनिवारितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004113012, "chapter_id": 24113, "verse_number": "४-६२-१३", "content_sanskrit": "स्वस्त्यभ्युदितपाणिश्च रुद्रसूक्तैरमंत्रयत् ।\nअक्षतान्यथ सार्द्राणि दर्शयन्सफलान्यजः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004113013, "chapter_id": 24113, "verse_number": "४-६२-१४", "content_sanskrit": "मौलिं पादाब्जयोः कृत्वा गणेशः सत्वरो नतः ।\nमूर्ध्न्युपाजिघ्रयांचक्रे हरो हर्षाद्गजाननम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004113014, "chapter_id": 24113, "verse_number": "४-६२-१५", "content_sanskrit": "अभ्युपावेशयच्चापि परिष्वज्य निजासने ।\nसोमनंदि प्रभृतयः प्रणेमुर्दंडवद्गणाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004113015, "chapter_id": 24113, "verse_number": "४-६२-१६", "content_sanskrit": "योगिन्योपि प्रणम्येशं चक्रुर्मंगलगायनम् ।\nतरणिः प्रणनामाथ प्रमथाधिपतिं हरम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004113016, "chapter_id": 24113, "verse_number": "४-६२-१७", "content_sanskrit": "खंडेंदुशेखरश्चाथ उपसिंहासनं हरिम् ।\nसमुपावेशयद्वामपार्श्वे मानपुरःसरम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004113017, "chapter_id": 24113, "verse_number": "४-६२-१८", "content_sanskrit": "ब्रह्माणं दक्षिणे भागे परिविश्राणितासनम् ।\nदृष्ट्वा संभाविताः सर्वे शर्वेण प्रणता गणाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004113018, "chapter_id": 24113, "verse_number": "४-६२-१९", "content_sanskrit": "मौलिचालनमात्रेण योगिन्योपि प्रसादिताः ।\nसंतोषितो रविश्चापि विशेति करसंज्ञया ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004113019, "chapter_id": 24113, "verse_number": "४-६२-२०", "content_sanskrit": "अथ शंभुं शतधृतिः प्रबद्धकरसंपुटः ।\nपरिविज्ञापयांचक्रे प्रसन्नवदनांबुजम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004113020, "chapter_id": 24113, "verse_number": "४-६२-२१", "content_sanskrit": "ब्रह्मोवाच ।\nभगवन्देवदेवेश क्षंतव्यं गिरिजापते ।\nवाराणसीं समासाद्य यदहं नागतः पुनः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004113021, "chapter_id": 24113, "verse_number": "४-६२-२२", "content_sanskrit": "प्रसंगतोपि कः काशीं प्राप्य चंद्रविभूषण ।\nकिंचिद्विधातुं शक्तोपि त्यजेत्स्थविरतां दधत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004113022, "chapter_id": 24113, "verse_number": "४-६२-२३", "content_sanskrit": "स्वरूपतो ब्राह्मणत्वादपाकर्तुं न शक्यते ।\nअथ शक्तो व्यपाकर्तुं कः पुण्ये संचिकीर्षति ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004113023, "chapter_id": 24113, "verse_number": "४-६२-२४", "content_sanskrit": "विभोरपि समाज्ञेयं धर्मवर्त्मानुसारिणि ।\nन किंचिदपकर्तव्यं जानता केनचित्क्वचित ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004113024, "chapter_id": 24113, "verse_number": "४-६२-२५", "content_sanskrit": "कस्तादृशि महीजानौ पुण्यवर्त्मन्यतंद्रिते ।\nकाशीपाले दिवोदासे मनागपि विरुद्धधीः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004113025, "chapter_id": 24113, "verse_number": "४-६२-२६", "content_sanskrit": "निशम्येति वचस्तुष्टः श्रीकंठोति विशुद्धधीः ।\nहसन्प्रोवाच धातारं ब्रह्मन्सर्वमवैम्यहम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004113026, "chapter_id": 24113, "verse_number": "४-६२-२७", "content_sanskrit": "देवदेव उवाच ।\nआदौ तावददोषं हि ब्रह्मत्वं ब्राह्मणस्य ते ।\nवाजिमेधाध्वराणां च ततोपि दशकं कृतम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004113027, "chapter_id": 24113, "verse_number": "४-६२-२८", "content_sanskrit": "ततोपि विहितं ब्रह्मन्भवता परमं हितम् ।\nअपराधसहस्राणि यल्लिंगं स्थापितं मम ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004113028, "chapter_id": 24113, "verse_number": "४-६२-२९", "content_sanskrit": "येनैकमपि मे लिंगं स्थापितं यत्र कुत्रचित् ।\nतस्यापराधलेशोपि नास्ति सर्वापराधिनः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004113029, "chapter_id": 24113, "verse_number": "४-६२-३०", "content_sanskrit": "अपराधसहस्रेपि ब्राह्मणं योपराध्नुयात् ।\nदिनैः कतिपयैरेव तस्यैश्वर्यं विनश्यति ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004113030, "chapter_id": 24113, "verse_number": "४-६२-३१", "content_sanskrit": "इति ब्रुवति देवेशेप्यंतरुच्छ्वसितं गणैः ।\nसमातृभिः समंताच्च विलोक्यास्यं परस्परम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004113031, "chapter_id": 24113, "verse_number": "४-६२-३२", "content_sanskrit": "अर्कोप्यवसरं ज्ञात्वा नत्वा शंभुं व्यजिज्ञपत् ।\nप्रसन्नास्यमुमाकांतं दृष्ट्वा दृष्टचराचरः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004113032, "chapter_id": 24113, "verse_number": "४-६२-३३", "content_sanskrit": "अर्क उवाच ।\nनाथ काशीमितो गत्वा यथाशक्ति कृतोपधिः ।\nअकिंचित्करतां प्राप्तः सहस्रकरवानपि ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004113033, "chapter_id": 24113, "verse_number": "४-६२-३४", "content_sanskrit": "स्वधर्मपालके तस्मिन्दिवोदासे धरापतौ ।\nनिश्चितागमनं ज्ञात्वा देवस्याहमिह स्थितः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004113034, "chapter_id": 24113, "verse_number": "४-६२-३५", "content_sanskrit": "प्रतीक्षमाणो देवेश त्वदामनमुत्तमम् ।\nविभज्य बहुधात्मानं त्वदाराधनतत्परः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004113035, "chapter_id": 24113, "verse_number": "४-६२-३६", "content_sanskrit": "मनोरथद्रुमश्चाद्य फलितः श्रीमदीक्षशात् ।\nकिंचिद्भक्तिलवांभोभिः सिक्तो ध्यानेन पुष्पितः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004113036, "chapter_id": 24113, "verse_number": "४-६२-३७", "content_sanskrit": "इत्युदीरितमाकर्ण्य रवेर्वैरविलोचनः ।\nप्रोवाच देवदेवेशो नापराध्यसि भास्कर ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004113037, "chapter_id": 24113, "verse_number": "४-६२-३८", "content_sanskrit": "ममैव कार्यं विह्तिं त्वं यदत्र व्यवस्थितः ।\nयस्यां सुरप्रवेशो न तस्मिन्राजनि शासति ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004113038, "chapter_id": 24113, "verse_number": "४-६२-३९", "content_sanskrit": "इति सूरं समाश्वास्य देवदेव कृपानिधिः ।\nगणानाश्वासयामास व्रीडा नम्रशिरोधरान् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004113039, "chapter_id": 24113, "verse_number": "४-६२-४०", "content_sanskrit": "योगिन्योपि सुदृष्ट्वाथ शंभुना संप्रसादिताः ।\nत्रपाभरसमाक्रांत कंधरा इव सं गताः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004113040, "chapter_id": 24113, "verse_number": "४-६२-४१", "content_sanskrit": "ततो व्यापारयांचक्रे त्र्यक्षो नेत्राणि चक्रिणि ।\nहरिर्न किंचिदप्यूचे सर्वज्ञाग्रे महामनाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004113041, "chapter_id": 24113, "verse_number": "४-६२-४२", "content_sanskrit": "ईशोपि श्रुतवृत्तांतस्तार्क्ष्याद्गणप शार्ङ्गिणोः ।\nमनसैव प्रसन्नोभून्न किंचित्पर्यभाषत ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004113042, "chapter_id": 24113, "verse_number": "४-६२-४३", "content_sanskrit": "एतस्मिन्नंतरे प्राप्ता गोलोकात्पंच धेनवः ।\nसुनंदा सुमनाश्चापि सुशीला सुरभिस्तथा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004113043, "chapter_id": 24113, "verse_number": "४-६२-४४", "content_sanskrit": "पंचमी कपिला चापि सर्वाघौघविघट्टिनी ।\nवात्सल्यदृष्ट्या भर्गस्य तासामूधांसि सुस्रुवुः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004113044, "chapter_id": 24113, "verse_number": "४-६२-४५", "content_sanskrit": "ववर्षुः पयसां पूरैस्तदूधांसि पयोधराः ।\nधारासारैरविच्छिन्नैस्तावद्यावद्ध्रदोऽभवत् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004113045, "chapter_id": 24113, "verse_number": "४-६२-४६", "content_sanskrit": "पयःपयोधिरिव स द्वितीयः प्रैक्षि पार्षदैः ।\nदेवेश समधिष्ठानात्तत्तीर्थमभवत्परम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004113046, "chapter_id": 24113, "verse_number": "४-६२-४७", "content_sanskrit": "कपिला ह्रद इत्याख्यां चक्रे तस्य महेश्वरः ।\nततो देवाज्ञया सर्वे स्नातास्तत्र दिवौकसः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004113047, "chapter_id": 24113, "verse_number": "४-६२-४८", "content_sanskrit": "आविरासुस्ततस्तीर्थादथ दिव्यपितामहाः ।\nतान्दृष्ट्वा ते सुराः सर्वे तर्पयांचक्रिरे मुदा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004113048, "chapter_id": 24113, "verse_number": "४-६२-४९", "content_sanskrit": "अग्निष्वात्ता बर्हिषद आज्यपाः सोमपास्तथा ।\nइत्याद्या दिव्यपितरस्तृप्ताः शंभुं व्यजिज्ञपन् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004113049, "chapter_id": 24113, "verse_number": "४-६२-५०", "content_sanskrit": "देवदेव जगन्नाथ भक्तानामभयप्रद ।\nअस्मिंस्तीर्थे त्वदभ्याशाज्जाता नस्तृप्तिरक्षया ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004113050, "chapter_id": 24113, "verse_number": "४-६२-५१", "content_sanskrit": "तस्माच्छंभो वरं देहि प्रसन्नेनांतरात्मना ।\nइति दिव्यपितॄणां स श्रुत्वा वाक्यं वृषध्वजः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004113051, "chapter_id": 24113, "verse_number": "४-६२-५२", "content_sanskrit": "शृण्वतां सर्वदेवानामिदं वचनमब्रवीत् ।\nशर्वः सर्वपितॄणां वै परतृप्तिकरं परम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004113052, "chapter_id": 24113, "verse_number": "४-६२-५३", "content_sanskrit": "श्रीदेवदेव उवाच ।\nशृणु विष्णो महाबाहो शृणु त्वं च पि तामह ।\nएतस्मिन्कापिले तीर्थे कापिलेय पयोभृते ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004113053, "chapter_id": 24113, "verse_number": "४-६२-५४", "content_sanskrit": "ये पिंडान्निर्वपिष्यंति श्रद्धया श्राद्धदानतः ।\nतेषां पितॄणां संतृप्तिर्भविष्यति ममाज्ञया ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004113054, "chapter_id": 24113, "verse_number": "४-६२-५५", "content_sanskrit": "अन्यं विशेषं वक्ष्यामि महातृप्तिकरं परम् ।\nकुहूसोमसमायोगे दत्तं श्राद्धमिहाक्षयम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004113055, "chapter_id": 24113, "verse_number": "४-६२-५६", "content_sanskrit": "संवर्तकाले संप्राप्ते जलराशिर्जलान्यपि ।\nक्षीयंते न क्षयत्यत्र श्राद्धं सोमकुहू कृतम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004113056, "chapter_id": 24113, "verse_number": "४-६२-५७", "content_sanskrit": "अमासोमसमायोगे श्राद्धं यद्यत्र लभ्यते ।\nतीर्थे कापिलधारेस्मिन्गयया पुष्करेण किम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004113057, "chapter_id": 24113, "verse_number": "४-६२-५८", "content_sanskrit": "गदाधरभवान्यत्र यत्र त्वं च पितामह ।\nवृषध्वजोस्म्यहं यत्र फल्गुस्तत्र न संशयः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004113058, "chapter_id": 24113, "verse_number": "४-६२-५९", "content_sanskrit": "दिव्यांतरिक्षभौमानि यानि तीर्थानि सर्वतः ।\nतान्यत्र निवसिष्यंति दर्शे सोमदिनान्विते ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004113059, "chapter_id": 24113, "verse_number": "४-६२-६०", "content_sanskrit": "कुरुक्षेत्रे नैमिषे च गंगासागरसंगमे ।\nग्रहणे श्राद्धतो यत्स्यात्तत्तीर्थे वार्षभध्वजे ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004113060, "chapter_id": 24113, "verse_number": "४-६२-६१", "content_sanskrit": "अस्य तीर्थस्य नामानि यानि दिव्य पितामहाः ।\nतान्यहं कथयिष्यामि भवतां तृप्तिदान्यलम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004113061, "chapter_id": 24113, "verse_number": "४-६२-६२", "content_sanskrit": "मधुस्रवेति प्रथममेषा पुष्करिणी स्मृता ।\nकृतकृत्या ततो ज्ञेया ततोऽसौ क्षीरनीरधिः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004113062, "chapter_id": 24113, "verse_number": "४-६२-६३", "content_sanskrit": "वृषभध्वजतीर्थं च तीर्थं पैतामहं ततः ।\nततो गदाधराख्यं च पितृतीर्थं ततः परम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004113063, "chapter_id": 24113, "verse_number": "४-६२-६४", "content_sanskrit": "ततः कापिलधारं वै सुधाखनिरियं पुनः ।\nततः शिवगयाख्यं च ज्ञेयं तीर्थमिदं शुभम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004113064, "chapter_id": 24113, "verse_number": "४-६२-६५", "content_sanskrit": "एतानि दश नामानि तीर्थस्यास्य पितामहाः ।\nभवतां तृप्तिकारीणि विनापि श्राद्धतर्पणैः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004113065, "chapter_id": 24113, "verse_number": "४-६२-६६", "content_sanskrit": "सूर्येंदु संगमे येत्र पितॄणां तृप्तिकामुकाः ।\nब्राह्मणान्भोजयिष्यंति तेषां श्राद्धमनंतकम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004113066, "chapter_id": 24113, "verse_number": "४-६२-६७", "content_sanskrit": "श्राद्धे पितॄणां संतृप्त्यै दास्यंति कपिलां शुभाम् ।\nयेत्र तेषां पितृगणो वसेत्क्षीरोदरोधसि ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004113067, "chapter_id": 24113, "verse_number": "४-६२-६८", "content_sanskrit": "वृषोत्सर्गः कृतो यैस्तु तीर्थेस्मिन्वार्षभध्वजे ।\nअश्वमेधपुरोडाशैः पितरस्तेन तर्पिताः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004113068, "chapter_id": 24113, "verse_number": "४-६२-६९", "content_sanskrit": "गयातोष्टगुणं पुण्यमस्मिंस्तीर्थे पितामहाः ।\nअमायां सोमयुक्तायां श्राद्धैः कापिलधारिके ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004113069, "chapter_id": 24113, "verse_number": "४-६२-७०", "content_sanskrit": "येषां गर्भेऽभवत्स्रावो येऽ दंतजननामृताः ।\nतेषां तृप्तिर्भवेन्नूनं तीर्थे कापिलधारिके ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004113070, "chapter_id": 24113, "verse_number": "४-६२-७१", "content_sanskrit": "अदत्तमौंजीदाना ये ये चादारपरिग्रहाः ।\nतेभ्यो निर्वापितं पिंडमिह ह्यक्षयतां व्रजेत् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004113071, "chapter_id": 24113, "verse_number": "४-६२-७२", "content_sanskrit": "अग्निदाहमृता ये वै नाग्निदाहश्च येषु वै ।\nते सर्वे तृप्तिमायांति तीर्थे कापिलधारिके ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004113072, "chapter_id": 24113, "verse_number": "४-६२-७३", "content_sanskrit": "और्द्ध्वदैहिकहीना ये षोडश श्राद्धवर्जिताः ।\nते तृप्तिमधिगच्छंति घृतकुल्यां निवापतः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004113073, "chapter_id": 24113, "verse_number": "४-६२-७४", "content_sanskrit": "अपुत्राश्च मृता ये वै येषां नास्त्युकप्रदः ।\nतेपि तृप्तिं परां यांति मधुस्रवसि तर्पिताः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004113074, "chapter_id": 24113, "verse_number": "४-६२-७५", "content_sanskrit": "अपमृत्युमृता ये वै चोरविद्युज्जलादिभिः ।\nतेषामिह कृतं श्राद्धं जायते सुगतिप्रदम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004113075, "chapter_id": 24113, "verse_number": "४-६२-७६", "content_sanskrit": "आत्मघातेन निधनं यैषामिहविकमर्णाम् ।\nतेपि तृप्तिं लभंतेत्र पिंडैः शिवगयाकृतैः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004113076, "chapter_id": 24113, "verse_number": "४-६२-७७", "content_sanskrit": "पितृगोत्रे मृता ये वै मातृपक्षे च ये मृताः ।\nतेषामत्र कृतः पिंडो भवेदक्षयतृप्तिदः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004113077, "chapter_id": 24113, "verse_number": "४-६२-७८", "content_sanskrit": "पत्नीवर्गे मृता ये वै मित्रवर्गे च ये मृताः ।\nते सर्वे तृप्तिमायांति तर्पिता वार्षभध्वजे ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004113078, "chapter_id": 24113, "verse_number": "४-६२-७९", "content_sanskrit": "ब्रह्मक्षत्रविशां वंशे शूद्रवंशेंऽत्यजेषु च ।\nयेषां नामगृहीत्वात्र दीयते ते समुद्धृताः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004113079, "chapter_id": 24113, "verse_number": "४-६२-८०", "content_sanskrit": "तिर्यग्योनि मृता ये वै ये पिशाचत्वमागताः ।\nतेप्यूर्ध्वगतिमायांति तृप्ताः कापिलधारिके ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004113080, "chapter_id": 24113, "verse_number": "४-६२-८१", "content_sanskrit": "ये तु मानुषलोकेस्मिन्पितरो मर्त्ययोनयः ।\nते दिव्ययोनयः स्युर्वै मधुस्रवसि तर्पिताः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004113081, "chapter_id": 24113, "verse_number": "४-६२-८२", "content_sanskrit": "ये दिव्यलोके पितरः पुण्यैर्देवत्वमागताः ।\nते ब्रह्मलोके गच्छंति तृप्तास्तीर्थे वृषध्वजे ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004113082, "chapter_id": 24113, "verse_number": "४-६२-८३", "content_sanskrit": "कृते क्षीरमयं तीर्थं त्रेतायां मधुमत्पुनः ।\nद्वापरे सर्पिषा पूर्णं कलौ जलमयं भवेत् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004113083, "chapter_id": 24113, "verse_number": "४-६२-८४", "content_sanskrit": "सीमाबहिर्गतमपि ज्ञेयं तीर्थमिदं शुभम् ।\nमध्ये वाराणसि श्रेष्ठं मम सान्निध्यतो नरैः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004113084, "chapter_id": 24113, "verse_number": "४-६२-८५", "content_sanskrit": "काशीस्थितैर्यतो दर्शि ध्वजो मेषवृषलांछनः ।\nवृषध्वजेन नाम्नातः स्थास्याम्यत्र पितामहाः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004113085, "chapter_id": 24113, "verse_number": "४-६२-८६", "content_sanskrit": "पितामहेन सहितो गदाधरसमन्वितः ।\nरविणा पार्षदैः सार्धं तुष्टये वः पितामहाः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004113086, "chapter_id": 24113, "verse_number": "४-६२-८७", "content_sanskrit": "इति यावद्वरं दत्ते पितृभ्यो वृषभध्वजः ।\nतावन्नदी समागत्य प्रणम्येशं व्यजिज्ञपत् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004113087, "chapter_id": 24113, "verse_number": "४-६२-८८", "content_sanskrit": "नंदिकेश्वर उवाच ।\nविहितः स्यदनः सज्जस्ततोस्तु विजयोदयः ।\nअष्टौ कंठीरवा यत्र यत्रोक्ष्णामष्टकं शुभम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004113088, "chapter_id": 24113, "verse_number": "४-६२-८९", "content_sanskrit": "यत्रेभाः परिभांत्यष्टौ यत्राष्टौ जविनो हयाः ।\nमनः संयमनं यत्र कशापाणि व्यवस्थितम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004113089, "chapter_id": 24113, "verse_number": "४-६२-९०", "content_sanskrit": "गंगायमुनयोरीषे चक्रे पवनदेवता ।\nसायंप्रातर्मये चक्रे छत्रं द्यौर्मंडलं शुचि ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004113090, "chapter_id": 24113, "verse_number": "४-६२-९१", "content_sanskrit": "तारावलीमयाः कीला आहेया उपनायकाः ।\nश्रुतयो मार्गदर्शिन्यः स्मृतयो रथगुप्तयः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004113091, "chapter_id": 24113, "verse_number": "४-६२-९२", "content_sanskrit": "दक्षिणाधूर्दृढा यत्र मखा यत्राभिरक्षकाः ।\nआसनं प्रणवो यत्र गायत्रीपादपीठभूः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004113092, "chapter_id": 24113, "verse_number": "४-६२-९३", "content_sanskrit": "सांगा व्याहृतयो यत्र शुभा सोपानवीथिकाः ।\nसूर्याचंद्रमसौ यत्र सततं द्वाररक्षकौ ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004113093, "chapter_id": 24113, "verse_number": "४-६२-९४", "content_sanskrit": "अग्निर्मकरतुंडश्च रथभूः कौमुदीमयी ।\nध्वजदंडो महामेरुः पताका हस्करप्रभा ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004113094, "chapter_id": 24113, "verse_number": "४-६२-९५", "content_sanskrit": "स्वयं वाग्देवता यत्र चंचच्चामरधारिणी ।\nस्कंद उवाच ।\nशैलादिनेति विज्ञप्तो देवदेव उमापतिः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004113095, "chapter_id": 24113, "verse_number": "४-६२-९६", "content_sanskrit": "कृतनीराजनविधिरष्टभिर्देवमातृभिः ।\nपिनाकपाणिरुत्तस्थौ दत्तहस्तोथ शार्ङ्गिणा ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004113096, "chapter_id": 24113, "verse_number": "४-६२-९७", "content_sanskrit": "निनादो दिव्यवाद्यानां रोदसी पर्यपूरयत् ।\nगीतमंगलगीर्भिश्च चारणैरनुवर्धितः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004113097, "chapter_id": 24113, "verse_number": "४-६२-९८", "content_sanskrit": "तेन दिव्यनिनादेन बधिरीकृतदिङ्मुखाः ।\nआहूता इव आजग्मुर्विष्वग्भुवनवासिनः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004113098, "chapter_id": 24113, "verse_number": "४-६२-९९", "content_sanskrit": "देवाकोट्यस्त्रयस्त्रिंशद्गणाः कोट्ययुतद्वयम् ।\nनवकोट्यस्तु चामुंडा भैरव्यः कोटिसंमिताः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004113099, "chapter_id": 24113, "verse_number": "४-६२-१००", "content_sanskrit": "षडाननाः कुमाराश्च मयूरवरवाहनाः ।\nममानुगाः समायाताः कोटयोष्टौ महाबलाः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004113100, "chapter_id": 24113, "verse_number": "४-६२-१०१", "content_sanskrit": "आययुः कोटयः सप्त स्फुरत्परशुपाणयः ।\nपिचंडिला महावेगा विघ्नविघ्ना गजाननाः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004113101, "chapter_id": 24113, "verse_number": "४-६२-१०२", "content_sanskrit": "षडशीतिसहस्राणि मुनयो ब्रह्मवादिनः ।\nतावतोपि समाजग्मुस्तत्रत्ये गृहमेधिनः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004113102, "chapter_id": 24113, "verse_number": "४-६२-१०३", "content_sanskrit": "नागानां कोटयस्तिस्रः पातालतलवासिनाम् ।\nदानवानां च दैत्यानां द्वे द्वे कोटी शिवात्मनाम् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004113103, "chapter_id": 24113, "verse_number": "४-६२-१०४", "content_sanskrit": "गंधर्वा नियुतान्यष्टौ कोट्यर्धं यक्षरक्षसाम् ।\nविद्याधराणामयुतं नियुतद्वयसंयुतम् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004113104, "chapter_id": 24113, "verse_number": "४-६२-१०५", "content_sanskrit": "तथा षष्टिसहस्राणि दिव्याश्चाप्सरसः शुभाः ।\nगोमातरोऽष्टौ लक्षाणि सुपर्णान्ययुतानि षट् ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004113105, "chapter_id": 24113, "verse_number": "४-६२-१०६", "content_sanskrit": "सागराः सप्त संप्राप्ता नानारत्नोपदप्रदाः ।\nसरितां च सहस्राणि त्रीणि पंचायुतानि च ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004113106, "chapter_id": 24113, "verse_number": "४-६२-१०७", "content_sanskrit": "गिरयोऽष्टौ सहस्राणि वनस्पतिशतत्रयम् ।\nआजग्मुर्दिग्गजा अष्टौ यत्र देवः पिनाकधृक् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004113107, "chapter_id": 24113, "verse_number": "४-६२-१०८", "content_sanskrit": "एतैः समेतः संतुष्टः परिष्टुत इतस्ततः ।\nश्रीकंठो रथमारुह्य काशीं प्राविशदुत्तमाम् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004113108, "chapter_id": 24113, "verse_number": "४-६२-१०९", "content_sanskrit": "स गिरींद्रसुतस्त्र्यक्षो मुदां धाम मुदां खनिः ।\nकाशीं प्रैक्षिष्ट संहृष्टस्त्रिविष्टप समुत्कटाम् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7004113109, "chapter_id": 24113, "verse_number": "४-६२-११०", "content_sanskrit": "स्कंद उवाच ।\nश्रुत्वाख्यानमिदं पुण्यं कोटिजन्माघनाशनम् ।\nपठित्वा पाठयित्वा च शिवसायुज्यमाप्नुयात् ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7004113110, "chapter_id": 24113, "verse_number": "४-६२-१११", "content_sanskrit": "श्राद्धकाले विशेषेण पठनीयं प्रयत्नतः ।\nअक्षयं तद्भवेच्छ्राद्धं पितृतुष्टिकरं परम् ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7004113111, "chapter_id": 24113, "verse_number": "४-६२-११२", "content_sanskrit": "वृषभध्वज माहात्म्यं पठित्वा शिवसन्निधौ ।\nप्रत्यहं वर्षमात्रं तु ह्यपुत्रः पुत्रवान्भवेत् ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7004113112, "chapter_id": 24113, "verse_number": "४-६२-११३", "content_sanskrit": "विश्वेशितुः संप्रवेशो यः काश्यां समुदाहृतः ।\nपरमानंदकंदस्य बीजमेतत्सुनिश्चितम् ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7004113113, "chapter_id": 24113, "verse_number": "४-६२-११४", "content_sanskrit": "पठित्वैतन्मुदाख्यानं प्रविशेद्यो नवं गृहम् ।\nस सर्वसौख्यनिलयो भवेदेव न संशयः ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7004113114, "chapter_id": 24113, "verse_number": "४-६२-११५", "content_sanskrit": "त्रैलोक्यानंदजनकमेतदाख्यानमुत्तमम् ।\nअस्य श्रवणमात्रेण विश्वेशः संप्रसीदति ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7004113115, "chapter_id": 24113, "verse_number": "४-६२-११६", "content_sanskrit": "अलभ्यलाभो देवस्य जातोत्र हि यतः परः ।\nततः काशी प्रवेशाख्यं जप्यमाख्यानमुत्तमम् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7004113116, "chapter_id": 24113, "verse_number": "४-६२-११७", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीति साहस्र्यां संहितायां चतुर्थे काशीखंडे उत्तरार्द्धे वृषभध्वजप्रादुर्भावोनाम द्विषष्टितमोऽध्यायः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}]