[{"id": 7006370000, "chapter_id": 26370, "verse_number": "२-२६-१", "content_sanskrit": "वैशम्पायन उवाच\nस नन्दगोपस्य गृहं प्रविष्टः सह केशवः ।\nगोपवृद्धान् समानीय प्रोवाचामितदक्षिणः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006370001, "chapter_id": 26370, "verse_number": "२-२६-२", "content_sanskrit": "कृष्णं चैवाब्रवीत् प्रीत्या रौहिणेयेन सङ्गतम् ।\nश्वः पुरीं मथुरां तात गमिष्यामः सुखाय वै ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006370002, "chapter_id": 26370, "verse_number": "२-२६-३", "content_sanskrit": "यास्यन्ति च व्रजाः सर्वे गोपालाः सपरिग्रहाः ।\nकंसाज्ञया समुचितं करमादाय वार्षिकम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006370003, "chapter_id": 26370, "verse_number": "२-२६-४", "content_sanskrit": "समृद्धस्तत्र कंसस्य भविष्यति धनुर्महः ।\nतं द्रक्ष्यथ समृद्धं च स्वजनैश्च समेष्यथ ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006370004, "chapter_id": 26370, "verse_number": "२-२६-५", "content_sanskrit": "पितरं वसुदेवं च सततं दुःखभाजनम् ।\nदीनं पुत्रवधश्रान्तं युवामद्य समेष्यथः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006370005, "chapter_id": 26370, "verse_number": "२-२६-६", "content_sanskrit": "सततं पीड्यमानं च कंसेनाशुभबुद्धिना ।\nदशान्ते शोषितं वृद्धं दुःखैः शिथिलतां गतम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006370006, "chapter_id": 26370, "verse_number": "२-२६-७", "content_sanskrit": "कंसस्य भयसंत्रस्तं भवद्भ्यां च विना कृतम् ।\nदह्यमानं दिवा रात्रौ सोत्कण्ठेनान्तरात्मना ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006370007, "chapter_id": 26370, "verse_number": "२-२६-८", "content_sanskrit": "तां च द्रक्ष्यसि गोविन्द पुत्रैरमृदितस्तनीम् ।\nदेवकीं देवसंकाशां सीदन्तीं विहतप्रभाम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006370008, "chapter_id": 26370, "verse_number": "२-२६-९", "content_sanskrit": "पुत्रशोकेन शुष्यन्तीं त्वद्दर्शनपरायणाम् ।\nवियोगशोकसंतप्तां विवत्सामिव सौरभीम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006370009, "chapter_id": 26370, "verse_number": "२-२६-१०", "content_sanskrit": "उपप्लुतेक्षणां दीनां नित्यं मलिनवाससम् ।\nस्वर्भानुवदनग्रस्तां शशाङ्कस्य प्रभामिव ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006370010, "chapter_id": 26370, "verse_number": "२-२६-११", "content_sanskrit": "त्वद्दर्शनपरां नित्यं तवागमनकाङ्क्षिणीम् ।\nत्यत्प्रवृत्तेन शोकेन सीदन्तीं वै तपस्विनीम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006370011, "chapter_id": 26370, "verse_number": "२-२६-१२", "content_sanskrit": "त्वत्प्रलापेष्वकुशला त्वया बाल्ये वियोजिताम् ।\nअरूपज्ञां तव विभो वक्त्रस्यास्येन्दुवर्चसः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006370012, "chapter_id": 26370, "verse_number": "२-२६-१३", "content_sanskrit": "यदि त्वां जनयित्वा सा देवकी तात तप्यते ।\nअपत्यार्थो नु कस्तस्या वरं ह्येवानपत्यता ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006370013, "chapter_id": 26370, "verse_number": "२-२६-१४", "content_sanskrit": "अपुत्राणां हि नारीणामेकः शोको विधीयते ।\nसपुत्रा त्वफले पुत्रे धिक्प्रजातेन तप्यते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006370014, "chapter_id": 26370, "verse_number": "२-२६-१५", "content_sanskrit": "त्वं तु शक्रसमः पुत्रो यस्यात्तवत्सदृशो गुणैः ।\nपरेषामप्यभयदो न सा शोचितुमर्हति ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006370015, "chapter_id": 26370, "verse_number": "२-२६-१६", "content_sanskrit": "वृद्धौ तवाम्बापितरौ परभृत्यत्वमागतौ ।\nभर्त्सितौ त्वत्कृते नित्यं कंसेनाशुभबुद्धिना ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006370016, "chapter_id": 26370, "verse_number": "२-२६-१७", "content_sanskrit": "यदि ते देवकी मान्या पृथिवीवात्मधारिणी ।\nतां शोकसलिले मग्नामुत्तारयितुमर्हसि ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006370017, "chapter_id": 26370, "verse_number": "२-२६-१८", "content_sanskrit": "तं च वृद्धं प्रियसुतं वसुदेवं सुखोचितम् ।\nपुत्रयोगेन संयोज्य कृष्ण धर्ममवाप्स्यसि ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006370018, "chapter_id": 26370, "verse_number": "२-२६-१९", "content_sanskrit": "यथा नागः सुदुर्वृत्तो दमितो यमुनाह्रदे ।\nविमूलः स कृतः शैलो यथा वै भूधरस्त्वया ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006370019, "chapter_id": 26370, "verse_number": "२-२६-२०", "content_sanskrit": "दर्पोत्सिक्तश्च बलवानरिष्टो विनिपातितः ।\nपरप्राणहरः केशी दुष्टात्मा च हयो हतः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006370020, "chapter_id": 26370, "verse_number": "२-२६-२१", "content_sanskrit": "एतेनैव प्रयत्नेन वृद्धावुद्धृत्य दुःखितौ ।\nयथा धर्ममवाप्नोषि तत्कृष्ण परिचिन्त्यताम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006370021, "chapter_id": 26370, "verse_number": "२-२६-२२", "content_sanskrit": "निर्भर्त्स्यमानो यैर्दृष्टः पिता ते कंससंसदि ।\nते सर्वे चक्रुरश्रूणि नेत्रैर्दुःखान्विता भृशम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006370022, "chapter_id": 26370, "verse_number": "२-२६-२३", "content_sanskrit": "गर्भावकर्तनादीनि दुःखानि सुबहून्यपि ।\nमाता ते देवकी कृष्ण कंसस्य सहतेऽवशा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006370023, "chapter_id": 26370, "verse_number": "२-२६-२४", "content_sanskrit": "मातापितृभ्यां सर्वेण जातेन तनयेन वै ।\nऋणं वै प्रतिकर्तव्यं यथायोगमुदाहृतम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006370024, "chapter_id": 26370, "verse_number": "२-२६-२५", "content_sanskrit": "एवं ते कुर्वतः कृष्ण मातापित्रोरनुग्रहम् ।\nपरित्यजेतां तौ शोकं स्याच्च धर्मस्तवानघ ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006370025, "chapter_id": 26370, "verse_number": "२-२६-२६", "content_sanskrit": "वैशम्पायन उवाच\nकृष्णः सुविदितार्थो वै तमाहामितविक्रमम् ।\nबाढमित्येव तेजस्वी न च क्रोधवशं गतः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006370026, "chapter_id": 26370, "verse_number": "२-२६-२७", "content_sanskrit": "ते च गोपाः समागम्य नन्दगोपपुरःसराः ।\nअक्रूरवचनं श्रुत्वा चेलुः कंसस्य शासनात् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006370027, "chapter_id": 26370, "verse_number": "२-२६-२८", "content_sanskrit": "गमनाय च ते सज्जा बभूवुर्व्रजवासिनः ।\nसज्जं चोपायनं कृत्वा गोपवृद्धाः प्रतस्थिरे ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006370028, "chapter_id": 26370, "verse_number": "२-२६-२९", "content_sanskrit": "करं चानडुहः सर्पिर्महिषांश्चौपनायिकान् ।\nयथासारं यथायूथमुपानीय पयो दधि ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006370029, "chapter_id": 26370, "verse_number": "२-२६-३०", "content_sanskrit": "तं सज्जयित्या कंसस्य करं चोपायनानि च ।\nते सर्वे गोपपतयो गमनायोपतस्थिरे ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006370030, "chapter_id": 26370, "verse_number": "२-२६-३१", "content_sanskrit": "अक्रूरस्य कथाभिश्च सह कृष्णेन जाग्रतः ।\nरौहिणेयतृतीयस्य सा निशा व्यत्यवर्तत ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006370031, "chapter_id": 26370, "verse_number": "२-२६-३२", "content_sanskrit": "ततः प्रभाते विमले पक्षिव्याहारसंकुले ।\nनैशाकरे रश्मिजाले क्षणदाक्षयसंहृते ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006370032, "chapter_id": 26370, "verse_number": "२-२६-३३", "content_sanskrit": "नभस्यरुणसंस्तीर्णे पर्यस्ते ज्योतिषां गणे ।\nप्रत्यूषपवनासारैः क्लेदिते धरणीतले ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006370033, "chapter_id": 26370, "verse_number": "२-२६-३४", "content_sanskrit": "क्षीणाकारासु तारासु सुप्तनिष्प्रतिभासु च ।\nनैशमन्तर्दधे रूपमुद्गच्छति दिवाकरे ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006370034, "chapter_id": 26370, "verse_number": "२-२६-३५", "content_sanskrit": "शीतांशुः शान्तकिरणो निष्प्रभः समपद्यत ।\nएको नाशयते रूपमेको वर्धयते वपुः ॥ ३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006370035, "chapter_id": 26370, "verse_number": "२-२६-३६", "content_sanskrit": "गोभिश्च समकीर्णासु व्रजनिर्याणभूमिषु ।\nमन्थनावर्तपूर्णेषु गर्गरेषु नदत्सु च ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006370036, "chapter_id": 26370, "verse_number": "२-२६-३७", "content_sanskrit": "दामभिर्दम्यमानेषु वत्सेषु तरुणेषु च ।\nगोपैरापूर्यमाणासु घोषरथ्यासु सर्वशः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006370037, "chapter_id": 26370, "verse_number": "२-२६-३८", "content_sanskrit": "तत्रैव गुरुकं भाण्डं शकटारोपितं बहु ।\nत्वरिताः पृष्ठतः कृत्वा जग्मुः स्यन्दनवाहनाः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006370038, "chapter_id": 26370, "verse_number": "२-२६-३९", "content_sanskrit": "कृष्णोऽथ रौहिणेयश्च स चैवामितदक्षिणः ।\nत्रयो रथगता जग्मुस्त्रिलोकपतयो यथा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006370039, "chapter_id": 26370, "verse_number": "२-२६-४०", "content_sanskrit": "अथाह कृष्णमक्रूरो यमुनातीरमाश्रितः ।\nस्यन्दनं चात्र रक्षस्व यत्नं च कुरु वाजिषु ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006370040, "chapter_id": 26370, "verse_number": "२-२६-४१", "content_sanskrit": "हयेभ्यो यवसं दत्त्वा हयभाण्डे रथे तथा ।\nप्रगाढं यत्नमास्थाय क्षणं तात प्रतीक्ष्यताम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006370041, "chapter_id": 26370, "verse_number": "२-२६-४२", "content_sanskrit": "यमुनाया ह्रदे ह्यस्मिन् स्तोष्यामि भुजगेश्वरम् ।\nदिव्यैर्भागवतैर्मन्त्रैः सर्वलोकप्रभुं यतः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006370042, "chapter_id": 26370, "verse_number": "२-२६-४३", "content_sanskrit": "गुह्यं भागवतं देवं सर्वलोकस्य भावनम् ।\nश्रीमत्स्वस्तिकमूर्द्धानं प्रणमिष्यामि भोगिनम् ।\nसहस्रशिरसं देवमनन्तं नीलवाससम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006370043, "chapter_id": 26370, "verse_number": "२-२६-४४", "content_sanskrit": "धर्मदेवस्य तस्याथ यद् विषं प्रभविष्यति ।\nसर्वं तदमृतप्रख्यमशिष्याम्यमरो यथा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006370044, "chapter_id": 26370, "verse_number": "२-२६-४५", "content_sanskrit": "स्वस्तिकायतनं दृष्ट्वा द्विजिह्वं श्रीविभूषितम् ।\nसमाजस्तत्र सर्पाणां शान्त्यर्थं वै भविष्यति ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006370045, "chapter_id": 26370, "verse_number": "२-२६-४६", "content_sanskrit": "आस्तां मां समुदीक्षन्तौ भवन्तौ सङ्गतावुभौ ।\nनिवृत्तो भुजगेन्द्रस्य यावदस्मि ह्रदोत्तमात् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006370046, "chapter_id": 26370, "verse_number": "२-२६-४७", "content_sanskrit": "तमाह कृष्णः संहृष्टो गच्छ धर्मिष्ठ मा चिरम् ।\nआवां खलु न शक्तौ स्वस्त्वया हीनावुपासितम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006370047, "chapter_id": 26370, "verse_number": "२-२६-४८", "content_sanskrit": "स हृदे यमुनायास्तु ममज्जामितदक्षिणः ।\nरसातले स ददृशे नागलोकमिमं यथा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006370048, "chapter_id": 26370, "verse_number": "२-२६-४९", "content_sanskrit": "तस्य मध्ये सहस्रास्यं हेमतालोच्छ्रितध्वजम् ।\nलाङ्गलासक्तहस्ताग्रं मुसलोपाश्रितोदरम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006370049, "chapter_id": 26370, "verse_number": "२-२६-५०", "content_sanskrit": "असिताम्बरसंवीतं पाण्डुरं पाण्डुरासनम् ।\nकुण्डलैकधरं मत्तं सुप्तमम्बुरुहेक्षणम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006370050, "chapter_id": 26370, "verse_number": "२-२६-५१", "content_sanskrit": "भोगोत्करासने शुभ्रे स्वेन देहेन कल्पिते ।\nस्वासीनं स्वस्तिकाभ्यां च वराहाभ्यां महीधरम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006370051, "chapter_id": 26370, "verse_number": "२-२६-५२", "content_sanskrit": "किंचित् सव्यापवृत्तेन मौलिना हेमचूलिना ।\nजातरूपमयैः पद्मैर्मालयाच्छन्नवक्षसम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006370052, "chapter_id": 26370, "verse_number": "२-२६-५३", "content_sanskrit": "रक्तचन्दनदिग्धाङ्गं दीर्घबाहुमरिंदमम् ।\nपद्मनाभसिताभ्राभं भाभिर्ज्वलिततेजसम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006370053, "chapter_id": 26370, "verse_number": "२-२६-५४", "content_sanskrit": "ददर्श भोगिनां नाथं स्थितमेकार्णवेश्वरम् ।\nपूज्यमानं द्विजिह्वेन्द्रैर्वासुकिप्रमुखैः प्रभुम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006370054, "chapter_id": 26370, "verse_number": "२-२६-५५", "content_sanskrit": "कम्बलाश्वतरौ नागौ तौ चामरकरावुभौ ।\nअवीजयेतां तं देवं धर्मासनगतं प्रभुम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006370055, "chapter_id": 26370, "verse_number": "२-२६-५६", "content_sanskrit": "तस्याभ्याशगतो भाति वासुकिः पन्नगेश्वरः ।\nवृतोऽन्यैः सचिवैः सर्पैः कर्कोटकपुरःसरैः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006370056, "chapter_id": 26370, "verse_number": "२-२६-५७", "content_sanskrit": "तं घटैः काञ्चनैर्दिव्यैः पङ्कजच्छन्नमस्तकैः ।\nराजानं स्नापयामासुः स्नातमेकार्णवाम्बुभिः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006370057, "chapter_id": 26370, "verse_number": "२-२६-५८", "content_sanskrit": "तस्योत्सङ्गे घनश्यामं श्रीवत्साच्छादितोरसम् ।\nपीताम्बरधरं विष्णुं सूपविष्टं ददर्श ह ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006370058, "chapter_id": 26370, "verse_number": "२-२६-५९", "content_sanskrit": "अपरं चैव सोमेन तुल्यसंहननं प्रभुम् ।\nसंकर्षणमिवासीनं तं दिव्यं विष्टरं विना ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006370059, "chapter_id": 26370, "verse_number": "२-२६-६०", "content_sanskrit": "स कृष्णं तत्र सहसा व्याहर्तुमुपचक्रमे ।\nतस्य संस्तम्भयामास वाक्यं कृष्णः स्वतेजसा ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006370060, "chapter_id": 26370, "verse_number": "२-२६-६१", "content_sanskrit": "सोऽनुभूय भुजङ्गानां तं भागवतमव्ययम् ।\nउदतिष्ठत्पुनस्तोयाद् विस्मितोऽमितदक्षिणः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006370061, "chapter_id": 26370, "verse_number": "२-२६-६२", "content_sanskrit": "स तौ रथस्थावासीनौ तत्रैव बलकेशवौ ।\nनिरीक्ष्यमाणावन्योन्यं ददर्शाद्भुतरूपिणौ ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006370062, "chapter_id": 26370, "verse_number": "२-२६-६३", "content_sanskrit": "अथामज्जत् पुनस्तत्र तदाक्रूरः कुतूहलात् ।\nइज्यते यत्र देवोऽसौ नीलवासाः सिताननः ॥ ६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006370063, "chapter_id": 26370, "verse_number": "२-२६-६४", "content_sanskrit": "तथैवासीनमुत्सङ्गे सहस्रास्यधरस्य वै ।\nददर्श कृष्णमक्रूरः पूज्यमानं तदा प्रभुम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006370064, "chapter_id": 26370, "verse_number": "२-२६-६५", "content_sanskrit": "भूयश्च सहसोत्थाय तं मन्त्रं मनसा जपन् ।\nरथं तेनैव मार्गेण जगामामितदक्षिणः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006370065, "chapter_id": 26370, "verse_number": "२-२६-६६", "content_sanskrit": "तमाह केशवो हृष्टः स्थितमक्रूरमागमत् ।\nकीदृशं नागलोकस्य वृत्तं भागवते ह्रदे ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006370066, "chapter_id": 26370, "verse_number": "२-२६-६७", "content_sanskrit": "चिरं च भवता कालो व्याक्षेपेण विलम्बितः ।\nमन्ये दृष्टं त्वयाश्चर्यं हृदयं ते यथाचलम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006370067, "chapter_id": 26370, "verse_number": "२-२६-६८", "content_sanskrit": "प्रत्युवाच स तं कृष्णमाश्चर्यं भवता विना ।\nकिं भविष्यति लोकेषु स्थावरेषु चरेषु च ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006370068, "chapter_id": 26370, "verse_number": "२-२६-६९", "content_sanskrit": "तत्राश्चर्यं मया दृष्टं कृष्ण यद् भुवि दुर्लभम् ।\nतदिहापि यथा तत्र पश्यामि च रमामि च ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006370069, "chapter_id": 26370, "verse_number": "२-२६-७०", "content_sanskrit": "संगतश्चापि लोकानामाश्चर्येणेह रूपिणा ।\nअतः परतरं कृष्ण नाश्चर्यं द्रष्टुमुत्सहे ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006370070, "chapter_id": 26370, "verse_number": "२-२६-७१", "content_sanskrit": "तदागच्छ गमिष्यामः कंसराजपुरीं प्रभो ।\nयावन्नास्तं व्रजत्येष दिवसान्ते दिवाकरः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]