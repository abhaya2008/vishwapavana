[{"id": 7000565000, "chapter_id": 20565, "verse_number": "५-२४-१", "content_sanskrit": "शेष उवाच ।\nशत्रुघ्नस्तु क्रुधाविष्टो दंतान्दंतैर्विनिष्पिषन् ।\nहस्तौ धुन्वंल्लेलिहानमधरं जिह्वया सकृत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000565001, "chapter_id": 20565, "verse_number": "५-२४-२", "content_sanskrit": "पुनः पुनस्तान्पप्रच्छ केनाश्वो नीयते मम ।\nप्रतापाग्र्यः केन जितः सर्वशूरशिरोमणिः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000565002, "chapter_id": 20565, "verse_number": "५-२४-३", "content_sanskrit": "सेवकास्ते तदा प्रोचुर्दमनोनाम शत्रुहन् ।\nसुबाहुजः प्रतापाग्र्यं जितवान्हयमाहरत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000565003, "chapter_id": 20565, "verse_number": "५-२४-४", "content_sanskrit": "इति श्रुत्वा हयं नीतं दमनेन स्ववैरिणा ।\nआजगाम स वेगेन यत्राभूद्रणमंडलम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000565004, "chapter_id": 20565, "verse_number": "५-२४-५", "content_sanskrit": "तत्रापश्यत्स शत्रुघ्नो गजान्दीर्णकपोलकान् ।\nपर्वतानिव रक्तोदे मज्जमानान्मदोद्धतान् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000565005, "chapter_id": 20565, "verse_number": "५-२४-६", "content_sanskrit": "हयास्तत्र निजारोहकर्तृभिः सहिताः क्षताः ।\nमृता वीरेण ददृशे शत्रुघ्नेन सुकोपिना ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000565006, "chapter_id": 20565, "verse_number": "५-२४-७", "content_sanskrit": "नरान्रथान्गजान्भग्नान्वीक्षमाणः स शत्रुहा ।\nअतीव चुक्रुधे यद्वत्प्रलये प्रलयार्णवः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000565007, "chapter_id": 20565, "verse_number": "५-२४-८", "content_sanskrit": "पुरतो दमनं वीक्ष्य हयनेतारमुद्भटम् ।\nप्रतापाग्र्यस्य जेतारं तृणीकृत्य निजं बलम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000565008, "chapter_id": 20565, "verse_number": "५-२४-९", "content_sanskrit": "तदा राजा प्रत्युवाच योधान्कोपाकुलेक्षणः ।\nकोऽसौ दमन जेताऽत्र सर्वशस्त्रास्त्रधारकः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000565009, "chapter_id": 20565, "verse_number": "५-२४-१०", "content_sanskrit": "यो वै राजसुतं वीरं रणकर्मविशारदम् ।\nजेष्यत्यस्त्रेण निर्भीतः सज्जीभूतो भवत्वयम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000565010, "chapter_id": 20565, "verse_number": "५-२४-११", "content_sanskrit": "इति वाक्यं समाकर्ण्य पुष्कलः परवीरहा ।\nदमनं जेतुमुद्युक्तो जगाद वचनं त्विदम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000565011, "chapter_id": 20565, "verse_number": "५-२४-१२", "content_sanskrit": "स्वामिन्क्वायं दमनकः क्व तेऽपरिमितं बलम् ।\nजेष्येऽहं त्वत्प्रतापेन गच्छाम्येष महामते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000565012, "chapter_id": 20565, "verse_number": "५-२४-१३", "content_sanskrit": "सेवके मयि युद्धाय स्थिते कैर्नीयते हयः ।\nरघुनाथप्रतापोऽयं सर्वं कृत्यं करिष्यति ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000565013, "chapter_id": 20565, "verse_number": "५-२४-१४", "content_sanskrit": "स्वामिञ्छृणु प्रतिज्ञां मे तव मोदप्रदायिनीम् ।\nविजेष्ये दमनं युद्धे रणकर्मविचक्षणम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000565014, "chapter_id": 20565, "verse_number": "५-२४-१५", "content_sanskrit": "रामचंद्रपदांभोजमध्वास्वादवियोगिनाम् ।\nयदघं तु भवेत्तन्मे दमनं न जयेयदि ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000565015, "chapter_id": 20565, "verse_number": "५-२४-१६", "content_sanskrit": "पुत्रो यो मातृपादान्यत्तीर्थं मत्वा तया सह ।\nविरुद्ध्येत्तत्तमो मह्यं न जयेदमनं यदि ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000565016, "chapter_id": 20565, "verse_number": "५-२४-१७", "content_sanskrit": "अद्य मद्बाणनिर्भिन्न महोरस्को नृपांगजः ।\nअलंकरोतु प्रधने भूतलं शयनेन हि ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000565017, "chapter_id": 20565, "verse_number": "५-२४-१८", "content_sanskrit": "शेष उवाच ।\nइति प्रतिज्ञामाकर्ण्य पुष्कलस्य रघूद्वहः ।\nजहर्ष चित्ते तेजस्वी निदिदेश रणं प्रति ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000565018, "chapter_id": 20565, "verse_number": "५-२४-१९", "content_sanskrit": "आज्ञप्तोऽसौ ययौ सैन्यैर्बहुभिः परिवारितः ।\nयत्रास्ते दमनो राजपुत्रः शूरकुलोद्भवः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000565019, "chapter_id": 20565, "verse_number": "५-२४-२०", "content_sanskrit": "दमनोऽपि तमाज्ञाय ह्यागतं रणमंडले ।\nप्रत्युज्जगाम वीराग्र्यः स्वसैन्यपरिवारितः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000565020, "chapter_id": 20565, "verse_number": "५-२४-२१", "content_sanskrit": "अन्योन्यं तौ संमिलितौ रथस्थौ रथशोभिनौ ।\nसमरे शक्रदैत्यौ किं युद्धार्थं रणमागतौ ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000565021, "chapter_id": 20565, "verse_number": "५-२४-२२", "content_sanskrit": "उवाच पुष्कलस्तं वै राजपुत्रं महाबलम् ।\nराजपुत्र दमनक मां जानीहि समागतम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000565022, "chapter_id": 20565, "verse_number": "५-२४-२३", "content_sanskrit": "स प्रतिज्ञं तु युद्धाय भरतात्मजमुद्भटम् ।\nपुष्कलेन स्वनाम्ना च लक्षितं विद्धिसत्तम ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000565023, "chapter_id": 20565, "verse_number": "५-२४-२४", "content_sanskrit": "रघुनाथपदांभोज नित्यसेवामधुव्रतम् ।\nत्वां जेष्ये शस्त्रसंघेनसज्जीभव महामते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000565024, "chapter_id": 20565, "verse_number": "५-२४-२५", "content_sanskrit": "इति वाक्यं समाकर्ण्य दमनः परवीरहा ।\nप्रत्युवाच हसन्वाग्मी निर्भयोद्दृष्टविक्रमः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000565025, "chapter_id": 20565, "verse_number": "५-२४-२६", "content_sanskrit": "सुबाहुपुत्रं दमनं पितृभक्ति हृताघकम् ।\nविद्धि मामश्वनेतारं शत्रुघ्नस्य महीपतेः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000565026, "chapter_id": 20565, "verse_number": "५-२४-२७", "content_sanskrit": "जयो दैवविसृष्टोऽयं यस्य चालंकरिष्यति ।\nस प्राप्नोति निरीक्षस्व बलं मे रणमूर्धनि ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000565027, "chapter_id": 20565, "verse_number": "५-२४-२८", "content_sanskrit": "इत्युक्त्वा स शरं चापं विधायाकर्णपूरितम् ।\nमुमोच बाणान्निशितान्वैरिप्राणापहारिणः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000565028, "chapter_id": 20565, "verse_number": "५-२४-२९", "content_sanskrit": "ते बाणास्त्वाविलीभूताश्छादयामासुरंबरम् ।\nसूर्यभानुप्रभा यत्र बाणच्छायानिवारिता ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000565029, "chapter_id": 20565, "verse_number": "५-२४-३०", "content_sanskrit": "गजानां कटभित्त्योघे लग्ना सायकसंततिः ।\nअलंकरोति धातूनां रागा इव विचित्रिताः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000565030, "chapter_id": 20565, "verse_number": "५-२४-३१", "content_sanskrit": "पतितास्तत्र दृश्यंते नरा वाहा गजा रथाः ।\nशरव्रातेन नृपतेः सुतेन परिताडिताः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000565031, "chapter_id": 20565, "verse_number": "५-२४-३२", "content_sanskrit": "तद्विक्रांतं समालोक्य पुष्कलः परवीरहा ।\nशराणां छायया व्याप्तं रणमंडलमीक्ष्य च ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000565032, "chapter_id": 20565, "verse_number": "५-२४-३३", "content_sanskrit": "शरासने समाधत्त बाणं वह्न्यभिमंत्रितम् ।\nआचम्य सम्यग्विधिवन्मोचयामास सायकम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000565033, "chapter_id": 20565, "verse_number": "५-२४-३४", "content_sanskrit": "ततोऽग्निप्रादुरभवत्तत्र संग्राममूर्धनि ।\nज्वालाभिर्विलिहन्व्योम प्रलयाग्निरिवोत्थितः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000565034, "chapter_id": 20565, "verse_number": "५-२४-३५", "content_sanskrit": "ततोऽस्य सैन्यं निर्दग्धं त्रासं प्राप्तं रणांगणे ।\nपलायनपरं जातं वह्निज्वालाभिपीडितम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000565035, "chapter_id": 20565, "verse_number": "५-२४-३६", "content_sanskrit": "छत्राणि तु प्रदग्धानि चंद्राकाराणि धन्विनाम् ।\nदृश्यंते जातरूपाभ कांतिधारीणि तत्र ह ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000565036, "chapter_id": 20565, "verse_number": "५-२४-३७", "content_sanskrit": "हया दग्धाः पलायंते केसरेषु च वैरिणाम् ।\nरथा अपि गता दाहं सुकूबरसमन्विताः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000565037, "chapter_id": 20565, "verse_number": "५-२४-३८", "content_sanskrit": "मणिमाणिक्यरत्नानि वहंतः करभास्ततः ।\nपलायंते दहनभू ज्वालामालाभिपीडिताः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000565038, "chapter_id": 20565, "verse_number": "५-२४-३९", "content_sanskrit": "कुत्रचिद्दंतिनो नष्टाः कुत्रचिद्धयसादिनः ।\nकुत्रचित्पत्तयो नष्टा वह्निदग्धकलेवराः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000565039, "chapter_id": 20565, "verse_number": "५-२४-४०", "content_sanskrit": "शराः सर्वे नृपसुतप्रमुक्ताः प्रलयं गताः ।\nआशुशुक्षणिकीलाभिर्भस्मीभूताः समंततः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000565040, "chapter_id": 20565, "verse_number": "५-२४-४१", "content_sanskrit": "तदा स्वसैन्ये दग्धे च दमनो रोषपूरितः ।\nसर्वास्त्रवित्तच्छांत्यर्थं वारुणास्त्रमथा ददे ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000565041, "chapter_id": 20565, "verse_number": "५-२४-४२", "content_sanskrit": "वारुणं वह्निशांत्यर्थं मुक्तं तेन महीभृता ।\nआप्लावयद्बलं तस्य रथवाजिसमाकुलम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000565042, "chapter_id": 20565, "verse_number": "५-२४-४३", "content_sanskrit": "रथा विप्लावितास्तोये दृश्यंते परिपंथिनाम् ।\nगजाश्चापि परिप्लुष्टाः स्वीयाः शांतिमुपागताः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000565043, "chapter_id": 20565, "verse_number": "५-२४-४४", "content_sanskrit": "वह्निश्च शांतिमगमदग्न्यस्त्र परिमोचितः ।\nशांतिमाप बलं स्वीयं वह्निज्वालाभिपीडितम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000565044, "chapter_id": 20565, "verse_number": "५-२४-४५", "content_sanskrit": "कंपिताः शीततोयेन सीत्कुर्वंति च वैरिणः ।\nकरकावृष्टिभिः क्षिप्ता वायुना च प्रपीडिताः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000565045, "chapter_id": 20565, "verse_number": "५-२४-४६", "content_sanskrit": "तदा स्वबलमालोक्य तोयपूरेण पीडितम् ।\nकंपितं क्षुभितं नष्टं वारुणेन विनिर्हृतम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000565046, "chapter_id": 20565, "verse_number": "५-२४-४७", "content_sanskrit": "तदातिकोपताम्राक्षः पुष्कलो भरतात्मजः ।\nवायव्यास्त्रं समाधत्त धनुष्येकं महाशरम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000565047, "chapter_id": 20565, "verse_number": "५-२४-४८", "content_sanskrit": "ततो वायुर्महानासीद्वायव्यास्त्रप्रचोदितः ।\nनाशयामास वेगेन घनानीकमुपस्थितम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000565048, "chapter_id": 20565, "verse_number": "५-२४-४९", "content_sanskrit": "वायुना स्फालिता नागाः परस्परसमाहताः ।\nअश्वाश्च संहतान्योन्यं स्वस्वारोहसमन्विताः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000565049, "chapter_id": 20565, "verse_number": "५-२४-५०", "content_sanskrit": "नराः प्रभंजनोद्धूता मुक्तकेशा निरोजसः ।\nपतंतोऽत्र समीक्ष्यंते वेताला इव भूगताः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000565050, "chapter_id": 20565, "verse_number": "५-२४-५१", "content_sanskrit": "वायुना स्वबलं सर्वं परिभूतं विलोक्य सः ।\nराजपुत्रः पर्वतास्त्रं धनुष्येवं समादधे ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000565051, "chapter_id": 20565, "verse_number": "५-२४-५२", "content_sanskrit": "तदा तु पर्वताः पेतुर्मस्तकोपरि युध्यताम् ।\nवायुः संच्छादितस्तैस्तु न प्रचक्राम कुत्रचित् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000565052, "chapter_id": 20565, "verse_number": "५-२४-५३", "content_sanskrit": "पुष्कलो वज्रसंज्ञं तु समाधत्त शरासने ।\nवज्रेण कृत्तास्ते सर्वे जाताश्च तिलशः क्षणात् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000565053, "chapter_id": 20565, "verse_number": "५-२४-५४", "content_sanskrit": "वज्रं नगान्रजः शेषान्कृत्वा बाणाभिमंत्रितम् ।\nराजपुत्रोरसि प्रोच्चैः पपात स्वनवद्भृशम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000565054, "chapter_id": 20565, "verse_number": "५-२४-५५", "content_sanskrit": "सत्वाकुलितचेतस्को हृदि विद्धः क्षतो भृशम् ।\nविव्यथे बलवान्वीरः कश्मलं परमाप सः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000565055, "chapter_id": 20565, "verse_number": "५-२४-५६", "content_sanskrit": "तं वै कश्मलितं दृष्ट्वा सारथिर्नयकोविदः ।\nअपोवाह रणात्तस्मात्क्रोशमात्रं नरेंद्रजम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000565056, "chapter_id": 20565, "verse_number": "५-२४-५७", "content_sanskrit": "ततो योधा राजसूनोः प्रणष्टाः प्रपलायिताः ।\nगत्वा पुरीं समाचख्युः कश्मलस्थं नृपात्मजम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000565057, "chapter_id": 20565, "verse_number": "५-२४-५८", "content_sanskrit": "पुष्कलो जयमाप्यैवं रणमूर्धनि धर्मवित् ।\nन प्रहर्तुं पुनः शक्तो रघुनाथवचः स्मरन् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000565058, "chapter_id": 20565, "verse_number": "५-२४-५९", "content_sanskrit": "ततो दुंदुभिनिर्घोषो जयशब्दो महानभूत् ।\nसाधुसाध्विति वाचश्च प्रावर्तंत मनोहराः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000565059, "chapter_id": 20565, "verse_number": "५-२४-६०", "content_sanskrit": "हर्षं प्राप स शत्रुघ्नो जयिनं वीक्ष्य पुष्कलम् ।\nप्रशशंस सुमत्यादि मंत्रिभिः परिवारितः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]