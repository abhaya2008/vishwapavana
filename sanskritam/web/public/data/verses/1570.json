[{"id": 2026618, "chapter_id": 1570, "verse_number": "३-२०८-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2026619, "chapter_id": 1570, "verse_number": "३-२०८-१", "content_sanskrit": "ततो युधिष्ठिरो राजा मार्कण्डेयं महाद्युतिम्।\nप्रपच्छ भरतश्रेष्ठ धर्मप्रश्नं स दुर्वचम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2026620, "chapter_id": 1570, "verse_number": "३-२०८-२", "content_sanskrit": "श्रोतुमिच्छामि भगवन्स्त्रीणां माहातम्यमुत्तमम्।\nकथ्यमानं त्वया विप्र सूक्ष्मं धर्म्यं च तत्त्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2026621, "chapter_id": 1570, "verse_number": "३-२०८-३", "content_sanskrit": "प्रत्यक्षमिह विप्रर्षे देवा दृश्यन्ति सत्तम।\nसूर्याचन्द्रमसौ वायुः पृथिवी वह्निरेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2026622, "chapter_id": 1570, "verse_number": "३-२०८-४", "content_sanskrit": "पिता माता च भगवान्गाव एव च सत्तम।\nयच्चान्यदेव विहितं तच्चापि भृगुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2026623, "chapter_id": 1570, "verse_number": "३-२०८-५", "content_sanskrit": "मन्येऽहं गुरुवत्सर्वमेकपत्न्यस्तथा स्त्रियः।\nपतिव्रतानां शुश्रूषा दुष्करा प्रतिभाति मे।\nपतिव्रतानां महात्म्यं वक्तुमर्हसि नः प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2026624, "chapter_id": 1570, "verse_number": "३-२०८-६", "content_sanskrit": "निरुध्य चेन्द्रियग्रामं मनः संरुध्य चानघ।\nपतिं दैवतवच्चापि चिन्तयन्त्य स्थिता हि या ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2026625, "chapter_id": 1570, "verse_number": "३-२०८-७", "content_sanskrit": "भगवन्दुष्करं त्वेतत्प्रतिभाति मम प्रभो।\nमातापित्रोश्च शुश्रूषा स्त्रीणां भर्तरि च द्विज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2026626, "chapter_id": 1570, "verse_number": "३-२०८-८", "content_sanskrit": "स्त्रीणां धर्मात्सुघोराद्धि नान्यं पश्यामि दुष्करम्।\nसाध्वाचाराः स्त्रियो ब्र्हमन्कुर्वन्तीह सदादृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2026627, "chapter_id": 1570, "verse_number": "३-२०८-९", "content_sanskrit": "दुष्करं खलु कुर्वन्ति पितरो मातरश्च वै।\nएकपत्न्यश्च या नार्यो याश् सत्यं वदन्त्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2026628, "chapter_id": 1570, "verse_number": "३-२०८-१०", "content_sanskrit": "कुक्षिणा दशमासांश्च गर्भं संधारयन्ति याः।\nनार्यः कालेन संबूय किमद्भुततरं ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2026629, "chapter_id": 1570, "verse_number": "३-२०८-११", "content_sanskrit": "संशयं परमं प्राप्य वेदनामतुलामपि।\nप्रजायन्ते सुतान्नार्यो दुःखेन महता विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2026630, "chapter_id": 1570, "verse_number": "३-२०८-१२", "content_sanskrit": "पुष्णन्ति चापि महता स्नेहेन द्विजपुङ्गव।\n`चिन्तयन्ति ततश्चापि किंशीलोऽयंभविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2026631, "chapter_id": 1570, "verse_number": "३-२०८-१३", "content_sanskrit": "याश्च क्रूरेषु सर्वेषु वर्तमाना जुगुप्सिताः।\nस्वकर्म कुर्वन्ति सदा दुष्करं तच्च मे मतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2026632, "chapter_id": 1570, "verse_number": "३-२०८-१४", "content_sanskrit": "क्षत्रधर्मसमाचारतत्त्वं व्याख्याहि मे द्विज।\nधर्मः सुदुर्लभो विप्र नृशंसेन महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2026633, "chapter_id": 1570, "verse_number": "३-२०८-१५", "content_sanskrit": "एतदिच्छामि भगवन्प्रश्नं प्रश्नविदांवर।\nश्रोतुं भृगुकुलश्रेष्ठ शुश्रूषे तव सुव्रत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2026634, "chapter_id": 1570, "verse_number": "३-२०८-१६x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2026635, "chapter_id": 1570, "verse_number": "३-२०८-१६", "content_sanskrit": "हन्त तेऽहं समाख्यास्ये प्रश्नमेतं सुदुर्वचम्।\nतत्त्वेन भरतश्रेष्ठ गदतस्तन्निबोध मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2026636, "chapter_id": 1570, "verse_number": "३-२०८-१७", "content_sanskrit": "मातरंश्रेयसीं तात पितृनन्ये तु मेनिरे।\nदुष्करं कुरुते माता विवर्धयति या प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2026637, "chapter_id": 1570, "verse_number": "३-२०८-१८", "content_sanskrit": "तपसा देवतेज्याभिर्वन्दनेन तितिक्षया।\nसुप्रशस्तैरुपायैश्चापीहन्ते पितरः सुतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2026638, "chapter_id": 1570, "verse_number": "३-२०८-१९", "content_sanskrit": "एवं कृच्छ्रेण महता पुत्रं प्राप्य सुदुर्लभम्।\nचिन्तयन्ति सदा वीर कीदृशोऽयं भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2026639, "chapter_id": 1570, "verse_number": "३-२०८-२०", "content_sanskrit": "आशंसते हि पुत्रेषु पिता माता च भारत।\nयशः कीर्तिमथैश्वर्यं तेजो धर्मं तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2026640, "chapter_id": 1570, "verse_number": "३-२०८-२१", "content_sanskrit": "`मातुः पितुश्च राजेन्द्र सततं हितकारिंणोः।\nतयोराशां तु सफलां यः करोति स धर्मवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2026641, "chapter_id": 1570, "verse_number": "३-२०८-२२", "content_sanskrit": "पिता माता च राजेन्द्र तुष्यतो यस् नित्यशः।\nइह प्रेत्य च तस्याथ कीर्तिर्धर्मश्र शाश्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2026642, "chapter_id": 1570, "verse_number": "३-२०८-२३", "content_sanskrit": "नैव यज्ञक्रियाः काश्चिन्न श्राद्धं नोपवासकम्।\nया तु भर्तरि शुश्रूषा तया स्वर्गं जयत्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2026643, "chapter_id": 1570, "verse_number": "३-२०८-२४", "content_sanskrit": "एतत्प्रकरणं राजन्नधिकृत्य युधिष्ठिर।\nपतिव्रतानां नियतं धर्मं चावाहितः शृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2026644, "chapter_id": 1570, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाबारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वयणि अष्टाधिकद्विशततमोऽध्यायः ॥ २०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]