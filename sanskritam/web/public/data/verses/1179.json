[{"id": 2009150, "chapter_id": 1179, "verse_number": "१-१८०-०x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2009151, "chapter_id": 1179, "verse_number": "१-१८०-१", "content_sanskrit": "गङ्गाद्वारं प्रति महान्बभूवर्षिर्महातपाः।\nभरद्वाजो महाप्राज्ञः सततं संशितव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2009152, "chapter_id": 1179, "verse_number": "१-१८०-२", "content_sanskrit": "सोऽभिषेक्तुं गतो गङ्गां पूर्वमेवागतां सतीम्।\nददर्शाप्सरसं तत्र घृताचीमाप्लुतामृषिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2009153, "chapter_id": 1179, "verse_number": "१-१८०-३", "content_sanskrit": "तस्या वायुर्नदीतीरे वसनं व्यहरत्तदा।\nअपकृष्टाम्बरां दृष्ट्वा तामृषिश्चकमे तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2009154, "chapter_id": 1179, "verse_number": "१-१८०-४", "content_sanskrit": "तस्यां संसक्तमनसः कौमारब्रह्मचारिणः।\nचिरस्य रेतश्चस्कन्द तदृषिर्द्रोण आदधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2009155, "chapter_id": 1179, "verse_number": "१-१८०-५", "content_sanskrit": "ततः समभवद्द्रोणः कुमारस्तस्य धीमतः।\nअध्यगीष्ट स वेदांश्च वेदाङ्गानि च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2009156, "chapter_id": 1179, "verse_number": "१-१८०-६", "content_sanskrit": "भरद्वाजस्य तु सखा पृषतो नाम पार्थिवः।\nतस्यापि द्रुपदो नाम तदा समभवत्सुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2009157, "chapter_id": 1179, "verse_number": "१-१८०-७", "content_sanskrit": "स नित्यमाश्रमं गत्वा द्रोणेन सह पार्षतः।\nचिक्रीडाध्ययनं चैव चकार क्षत्रियर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2009158, "chapter_id": 1179, "verse_number": "१-१८०-८", "content_sanskrit": "ततस्तु पृषतेऽतीते स राजा द्रुपदोऽभवत्।\nद्रोणोऽपि रामं शुश्राव दित्सन्तं वसु सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2009159, "chapter_id": 1179, "verse_number": "१-१८०-९", "content_sanskrit": "वनं तु प्रस्थितं रामं भरद्वाजसुतोऽब्रवीत्।\nआगतं वित्तकामं मां विद्धि द्रोणं द्विजोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2009160, "chapter_id": 1179, "verse_number": "१-१८०-१०x", "content_sanskrit": "राम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2009161, "chapter_id": 1179, "verse_number": "१-१८०-१०", "content_sanskrit": "शरीरमात्रमेवाद्य मया समवशेषितम्।\nअस्त्राणि वा शरीरं वा ब्रह्मन्नेकतमं वृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2009162, "chapter_id": 1179, "verse_number": "१-१८०-११x", "content_sanskrit": "द्रोण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2009163, "chapter_id": 1179, "verse_number": "१-१८०-११", "content_sanskrit": "अस्त्राणि चैव सर्वाणि तेषां संहारमेव च।\nप्रयोगं चैव सर्वेषां दातुमर्हति मे भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2009164, "chapter_id": 1179, "verse_number": "१-१८०-१२x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2009165, "chapter_id": 1179, "verse_number": "१-१८०-१२", "content_sanskrit": "तथेत्युक्त्वा ततस्तस्मै प्रददौ भृगुनन्दनः।\nप्रतिगृह्य तदा द्रोणः कृतकृत्योऽभवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2009166, "chapter_id": 1179, "verse_number": "१-१८०-१३", "content_sanskrit": "संप्रहृष्टमना द्रोणो रामात्परमसम्मतम्।\nब्रह्मास्त्रं समनुज्ञाप्य नरेष्वभ्यधिकोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2009167, "chapter_id": 1179, "verse_number": "१-१८०-१४", "content_sanskrit": "ततो द्रुपदमासाद्य भारद्वाजः प्रतापवान्।\nअब्रवीत्पुरुषव्याघ्रः सखायं विद्धि मामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2009168, "chapter_id": 1179, "verse_number": "१-१८०-१५x", "content_sanskrit": "द्रुपद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2009169, "chapter_id": 1179, "verse_number": "१-१८०-१५", "content_sanskrit": "नाश्रोत्रियः श्रोत्रियस्य नारथी रथिनः सखा।\nनाराजा पार्थिवस्यापि सखिपूर्वं किमिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2009170, "chapter_id": 1179, "verse_number": "१-१८०-१६x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2009171, "chapter_id": 1179, "verse_number": "१-१८०-१६", "content_sanskrit": "स विनिश्चित्य मनसा पाञ्चाल्यं प्रति बुद्धिमान्।\nजगाम कुरुमुख्यानां नगरं नागसाह्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2009172, "chapter_id": 1179, "verse_number": "१-१८०-१७", "content_sanskrit": "तस्मै पौत्रान्समादाय वसूनि विविधानि च।\nप्राप्ताय प्रददौ भीष्मः शिष्यान्द्रोणाय धीमते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2009173, "chapter_id": 1179, "verse_number": "१-१८०-१८", "content_sanskrit": "द्रोणः शिष्यांस्ततः पार्थानिदं वचनमब्रवीत्।\nसमानीय तु ताञ्शिष्यान्द्रुपदस्यासुखाय वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2009174, "chapter_id": 1179, "verse_number": "१-१८०-१९", "content_sanskrit": "आचार्यवेतनं किंचिद्धृदि यद्वर्तते मम।\nकृतास्त्रैस्तत्प्रदेयं स्यात्तदृतं वदतानघाः।\nसोऽर्जुनप्रमुखैरुक्तस्तथाऽस्त्विति गुरुस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2009175, "chapter_id": 1179, "verse_number": "१-१८०-२०", "content_sanskrit": "यदा च पाण्डवाः सर्वे कृतास्त्राः कृतनिश्चयाः।\nततो द्रोणोऽब्रवीद्भूयो वेतनार्थमिदं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2009176, "chapter_id": 1179, "verse_number": "१-१८०-२१", "content_sanskrit": "पार्षतो द्रुपदो नाम छत्रवत्यां नरेश्वरः।\nतस्मादाकृष्य तद्राज्यं मम शीघ्रं प्रदीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2009177, "chapter_id": 1179, "verse_number": "१-१८०-२२", "content_sanskrit": "धार्तराष्ट्राश्च ते भीताः पाञ्चालान्पाण्डवादयः।\nधार्तराष्ट्रैश्च सहिताः पुनर्द्रोणेन चोदिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2009178, "chapter_id": 1179, "verse_number": "१-१८०-२३", "content_sanskrit": "यज्ञसेनेन संगम्य कर्णदुर्योधनादयः।\nनिर्जिताः संन्यवर्तन्त तथा ते क्षत्रियर्षभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2009179, "chapter_id": 1179, "verse_number": "१-१८०-२४", "content_sanskrit": "ततः पाण्डुसुताः पञ्च निर्जित्य द्रुपदं युधि।\nद्रोणाय दर्शयामासुर्बद्ध्वा ससचिवं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2009180, "chapter_id": 1179, "verse_number": "१-१८०-२५", "content_sanskrit": "महेन्द्र इव दुर्धर्षो महेन्द्र इव दानवम्।\nमहेन्द्रपुत्रः पाञ्चालं जितवानर्जुनस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2009181, "chapter_id": 1179, "verse_number": "१-१८०-२६", "content_sanskrit": "तद्दृष्ट्वा तु महावीर्यं फल्गुनस्य महौजसः।\nव्यस्मयन्त जनाः सर्वे यज्ञसेनस्य बान्धवाः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2009182, "chapter_id": 1179, "verse_number": "१-१८०-२७x", "content_sanskrit": "द्रोण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2009183, "chapter_id": 1179, "verse_number": "१-१८०-२७", "content_sanskrit": "प्रार्थयामि त्वया सख्यं पुनरेव नराधिप।\nअराजा किल नो राज्ञः सखा भवितुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2009184, "chapter_id": 1179, "verse_number": "१-१८०-२८", "content_sanskrit": "अतः प्रयतितं राज्ये यज्ञसेन त्वया सह।\nराजाऽसि दक्षिणे कूले भागीरथ्याहमुत्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2009185, "chapter_id": 1179, "verse_number": "१-१८०-२९x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2009186, "chapter_id": 1179, "verse_number": "१-१८०-२९", "content_sanskrit": "एवमुक्तो हि पाञ्चाल्यो भारद्वाजेन धीमता।\nउवाचास्त्रविदां श्रेष्ठं द्रोणं ब्राह्मणसत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2009187, "chapter_id": 1179, "verse_number": "१-१८०-३०", "content_sanskrit": "एवं भवतु भद्रं ते भारद्वाज महामते।\nसख्यं तदेव भवतु शश्वद्यदभिमन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2009188, "chapter_id": 1179, "verse_number": "१-१८०-३१", "content_sanskrit": "एवमन्योन्यमुक्त्वा तौ कृत्वा सख्यमनुत्तमम्।\nजग्मतुर्द्रोणपाञ्चाल्यौ यथागतमरिन्दमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2009189, "chapter_id": 1179, "verse_number": "१-१८०-३२", "content_sanskrit": "असत्कारः स तु महान्मुहूर्तमपि तस्य तु।\nनापैति हृदयाद्राज्ञो दुर्मनाः स कृशोऽभवत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2009190, "chapter_id": 1179, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि चैत्ररथपर्वणि अशीत्यधिकशततमोऽध्यायः॥ १८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]