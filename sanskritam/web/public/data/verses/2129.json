[{"id": 2051382, "chapter_id": 2129, "verse_number": "७-५६-०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2051383, "chapter_id": 2129, "verse_number": "७-५६-१", "content_sanskrit": "सुहोत्रं नाम राजानं मृतं सृञ्जय शुश्रुम।\nएकवीरमशक्यं तममरैरभिवीक्षितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2051384, "chapter_id": 2129, "verse_number": "७-५६-२", "content_sanskrit": "यः प्राप्य राज्यं धर्मेण ऋत्विङ्मन्त्रिपुरोहितान्।\nसम्मान्य चात्मनः श्रेयः पृष्ट्वा तेषां मते स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2051385, "chapter_id": 2129, "verse_number": "७-५६-३", "content_sanskrit": "प्रजानां पालनं धर्मो दानमिज्या द्विषज्जयः।\nएतत्सुहोत्रो विज्ञाय धर्म्यमैच्छद्धनागमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2051386, "chapter_id": 2129, "verse_number": "७-५६-४", "content_sanskrit": "धर्मेणाराधयन्देवान्बाणैः शत्रूञ्जयंस्तथा।\nसर्वाण्यपि च भूतानि स्वगुणैरन्वरञ्जयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2051387, "chapter_id": 2129, "verse_number": "७-५६-५", "content_sanskrit": "यो भुक्त्वेमां वसुमतीं म्लेच्छाटविकवर्जिताम्।\nयस्मै ववर्ष पर्जन्यो हिरण्यं परिवत्सरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2051388, "chapter_id": 2129, "verse_number": "७-५६-६", "content_sanskrit": "हैरण्यास्तत्र वाहिन्यः स्वैरिण्यो व्यवहन्पुरा।\nग्राहान्कर्कटकांश्चैव मत्स्यांश्च विविधान्बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2051389, "chapter_id": 2129, "verse_number": "७-५६-७", "content_sanskrit": "कामान्वर्षति पर्जन्यो रूप्याणि विविधानि च।\nसौवर्णान्यप्रमेयाणि वाप्यश्च क्रोशसम्मिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2051390, "chapter_id": 2129, "verse_number": "७-५६-८", "content_sanskrit": "सहस्रं वामनान्कुब्जान्नक्रान्मकरकच्छपान्।\nसौवर्णान्विहितान्दृष्ट्वा ततोऽस्मयत वै तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2051391, "chapter_id": 2129, "verse_number": "७-५६-९", "content_sanskrit": "तत्सुवर्णमपर्यन्तं राजर्षिः कुरुजाङ्गले।\nईजानो वितते यज्ञे ब्राह्मणेभ्यो ह्यमन्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2051392, "chapter_id": 2129, "verse_number": "७-५६-१०", "content_sanskrit": "सोऽश्वमेधसहस्रेण राजसूयशतेन च।\nपुण्यैः क्षत्रिययज्ञैश्च प्रभूतवरदक्षिणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2051393, "chapter_id": 2129, "verse_number": "७-५६-११", "content_sanskrit": "काम्यनैमित्तिकाजस्रैरिष्ट्वेष्टां गतिमाप्तवान्।\nस चेन्ममार सृञ्जय चतुर्भद्रतरस्त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2051394, "chapter_id": 2129, "verse_number": "७-५६-१२", "content_sanskrit": "पुत्रात्पुण्यतरस्तुभ्यं मा पुत्रमनुतप्यथाः।\nअयज्वानमदक्षिण्यमभि श्वैत्येत्युदाहरत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2051395, "chapter_id": 2129, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि अभिमन्युवधपर्वणि षोडशराजकीये षट्पञ्चाशत्तमोऽध्यायः॥ ५६ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-५६-६ हैरण्या हिरण्मयाः ग्राहादयोऽपि। वाहिन्यो नद्यः। स्वैरिण्यः सर्वजनोपभोग्याः॥ ५-५६-५६ षट्पञ्चाशत्तमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]