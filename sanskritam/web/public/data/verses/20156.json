[{"id": 7000156000, "chapter_id": 20156, "verse_number": "१५६-१", "content_sanskrit": "शङ्खह्रदतीर्थवर्णनम् ब्रह्मोवाच शङ्खहृदं नाम तीर्थं यत्र शङ्खगदाधरः ।\nतत्र स्नात्वा च तं दृष्ट्वा मुच्यते भवबन्धनात् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000156001, "chapter_id": 20156, "verse_number": "१५६-२", "content_sanskrit": "तत्रेदं वृत्तमाख्यास्ये भुक्तिमुक्तिप्रदायकम् ।\nपुरा कृतयुगस्याऽऽदौ ब्रह्मणः सामगायिनः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000156002, "chapter_id": 20156, "verse_number": "१५६-३", "content_sanskrit": "ब्रह्माण्डागारसंभूता राक्षसा बहुरूपिणः ।\nब्रह्माणं खादितुं प्राप्ता बलोन्मत्ता धृतायुधाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000156003, "chapter_id": 20156, "verse_number": "१५६-४", "content_sanskrit": "तदाऽहब्रवं विष्णुं रक्षणाय जगद्‌गुरुम् ।\nस विष्णुस्तानि रक्षांसि हन्तुं चक्रेण चोद्यतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000156004, "chapter_id": 20156, "verse_number": "१५६-५", "content_sanskrit": "छित्त्वा चक्रेण रक्षांसि शङ्खमापूरयतदा ।\nनिष्कण्टकं तलं कृत्वा स्वर्गं निर्वैरमेव च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000156005, "chapter_id": 20156, "verse_number": "१५६-६", "content_sanskrit": "ततो हर्षप्रकर्षेण शङ्खमापूरयद्धरिः ।\nततो रक्षांसि सर्वाणि ह्यनीनशुरशेषतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000156006, "chapter_id": 20156, "verse_number": "१५६-७", "content_sanskrit": "यत्रैतद्‌वृत्तमखिलं विष्णुशङ्खप्रभावतः ।\nशङ्खतीर्थं तु तत्प्रोक्तं सर्वक्षेमकरं नृणाम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000156007, "chapter_id": 20156, "verse_number": "१५६-८", "content_sanskrit": "सर्वाभीष्टप्रदं पुण्यं स्मरणान्मङ्गलप्रदम् ।\nआयुरारोग्यजननं लक्ष्मीपुत्रप्रवर्धनम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000156008, "chapter_id": 20156, "verse_number": "१५६-९", "content_sanskrit": "स्मरणात्पठनाद्वाऽपि सर्वकामानवाप्नुयात् ।\nतीर्थानामयुतं तत्र सर्वपापनुदं मुने ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000156009, "chapter_id": 20156, "verse_number": "१५६-१०", "content_sanskrit": "तीर्थान्ययुतसंख्यानि सर्वपापहराणि च ।\nयेषां प्रभावं जानाति वक्तुं देवो महेश्वरः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000156010, "chapter_id": 20156, "verse_number": "१५६-११", "content_sanskrit": "पापक्षयप्रतिनिधिर्नैतेभ्योऽस्त्यपरः क्वचित् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]