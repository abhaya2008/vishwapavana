[{"id": 2147479, "chapter_id": 4190, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2147480, "chapter_id": 4190, "verse_number": "१", "content_sanskrit": "प्रत्यभिज्ञातमात्रोऽथ सद्भिस्तैर्नरपुङ्गवैः ।\nययातिर्दिव्यसंस्थानो बभूव विगतज्वरः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2147481, "chapter_id": 4190, "verse_number": "२", "content_sanskrit": "समारुरोह नृपतिरस्पृशन् वसुधातळम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2147482, "chapter_id": 4190, "verse_number": "३", "content_sanskrit": "दिव्यमाल्याम्बरधरो दिव्याभरणभूषितः ।\nदिव्यगन्धगुणोपेतो न पृथ्वीमस्पृशत् पदा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2147483, "chapter_id": 4190, "verse_number": "४", "content_sanskrit": "ततो वसुमनाः पूर्वमुच्चैरुच्चारयन् वचः ।\nख्यातो दानपतिर्लोके व्याजहार नृपं तदा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2147484, "chapter_id": 4190, "verse_number": "५", "content_sanskrit": "प्राप्तवानस्मि यल्लोके सर्ववर्णेष्वगर्हया ।\nतदप्यथ च दास्यामि तेन संयुज्यतां भवान्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2147485, "chapter_id": 4190, "verse_number": "६", "content_sanskrit": "यत्फलं दानशीलस्य क्षमाशीलस्य यत् फलम् ।\nयच्च मे फलमाधाने तेन संयुज्यतां भवान्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2147486, "chapter_id": 4190, "verse_number": "७", "content_sanskrit": "ततः प्रतर्दनोऽप्याह वाचं क्षत्रियपुङ्गवः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2147487, "chapter_id": 4190, "verse_number": "८", "content_sanskrit": "यथा धर्मरतिर्नित्यं नित्यं युद्धपरायणः ।\nप्राप्तवानस्मि यल्लोके क्षत्रवंशोद्भवं यशः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2147488, "chapter_id": 4190, "verse_number": "९", "content_sanskrit": "वीरशब्दफलं चैव तेन संयुज्यतां भवान् ।\nयथा धर्मे रतिर्नित्यं तेन सत्येन स्वं व्रज\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2147489, "chapter_id": 4190, "verse_number": "१०", "content_sanskrit": "शिबिरौशीनरो धीमानुवाच मधुरां गिरम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2147490, "chapter_id": 4190, "verse_number": "११", "content_sanskrit": "यथा बालेषु नारीषु वैवाह्येषु तथैव च ।\nसङ्गरेषु निपातेषु तथा च व्यसनेषु च\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2147491, "chapter_id": 4190, "verse_number": "१२", "content_sanskrit": "अनृतं नोक्तपूर्वं मे तेन सत्येन स्वं व्रज\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2147492, "chapter_id": 4190, "verse_number": "१३", "content_sanskrit": "यथा प्राणांश्च राज्यं च राजकर्मसुखानि च ।\nत्यजेयं न त्वहं सत्यं तेन सत्येन स्वं व्रज\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2147493, "chapter_id": 4190, "verse_number": "१४", "content_sanskrit": "यथा सत्येन मे धर्मो यथा सत्येन मे यमः ।\nप्रीतः शतक्रतुश्चैव तेन सत्येन स्वं व्रज\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2147494, "chapter_id": 4190, "verse_number": "१५", "content_sanskrit": "अष्टकस्त्वथ राजर्षिः कौशिको माधवीसुतः ।\nअनेकशतयज्वानं वचनं प्राह धर्मवित्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2147495, "chapter_id": 4190, "verse_number": "१६", "content_sanskrit": "शतशः पुण्डरीका मे गोसवा रचिताः प्रभो ।\nक्रतवो वाजपेयाश्च तेषां फलमवाप्नुहि\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2147496, "chapter_id": 4190, "verse_number": "१७", "content_sanskrit": "न मे रत्नानि न धनं न तथाऽन्ये परिच्छदाः ।\nक्रतुष्वनुपयुक्तानि तेन सत्येन स्वं व्रज\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2147497, "chapter_id": 4190, "verse_number": "१८", "content_sanskrit": "यथा यथा हि जल्पन्ति दौहित्रास्तं नराधिपम् ।\nतथा तथा वसुमतीं त्यक्त्वा राजा दिवं ययौ\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2147498, "chapter_id": 4190, "verse_number": "१९", "content_sanskrit": "एवं सर्वैः समस्तैस्तै राजानः सुकृतैस्तदा ।\nययातिं स्वर्गतो भ्रष्टं तारयामासुरञ्जसा\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2147499, "chapter_id": 4190, "verse_number": "२०", "content_sanskrit": "दौहित्राः स्वेन धर्मेण यज्ञदानकृतेन वै ।\nचतुर्षु राजवंशेषु सम्भूताः कुलवर्धनाः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2147500, "chapter_id": 4190, "verse_number": "२१", "content_sanskrit": "मातामहं महाप्राज्ञं दिवमारोपयन्त ते\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2147501, "chapter_id": 4190, "verse_number": "", "content_sanskrit": "राजानः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2147502, "chapter_id": 4190, "verse_number": "२२", "content_sanskrit": "राजधर्मगुणोपेताः सत्यधर्मगुणान्विताः ।\nदौहित्रास्ते वयं राजन् दिवमारोह पार्थिव\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2147503, "chapter_id": 4190, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि एकविंशोत्तरशततमोऽध्यायः ॥१२१॥\nभगवद्यानपर्वणि द्विपञ्चाशोऽध्यायः ॥५२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]