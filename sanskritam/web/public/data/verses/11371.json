[{"id": 50007212, "chapter_id": 11371, "verse_number": "1", "content_sanskrit": "सूत उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50007213, "chapter_id": 11371, "verse_number": "2", "content_sanskrit": "तत्र गोमिथुनं राजा हन्यमानमनाथवत्। दण्डहस्तं च वृषळं ददृशे नृपलाञ्छनम्॥ १/१७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50007214, "chapter_id": 11371, "verse_number": "3", "content_sanskrit": "वृषं मृणालधवळं मेहन्तमिव बिभ्यतम्। वेपमानं पदैकेन सीदन्तं शूद्रपीडितम्॥ १/१७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50007215, "chapter_id": 11371, "verse_number": "4", "content_sanskrit": "गां च धर्मदुघां दीनां भृशं शूद्रपदा हताम्। विवत्सामश्रुवदनां कृशां यवसमिच्छतीम्॥ १/१७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50007216, "chapter_id": 11371, "verse_number": "5", "content_sanskrit": "पप्रच्छ रथमारूढः कार्तस्वरपरिच्छदम्। मेघगम्भीरया वाचा समारोपितकार्मुकः॥ १/१७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50007217, "chapter_id": 11371, "verse_number": "6", "content_sanskrit": "कस्त्वं मच्छरणे लोके बलाद्धंस्यबलौ बली। नरदेवोऽसि वेषेण नटवत् कर्मणाऽद्विजः॥ १/१७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50007218, "chapter_id": 11371, "verse_number": "7", "content_sanskrit": "स त्वं कृष्णे गते दूरं सह गाण्डीवधन्वना। शोच्योऽस्यशोच्यान् रहसि प्रहरन् वधमर्हसि॥ १/१७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50007219, "chapter_id": 11371, "verse_number": "8", "content_sanskrit": "त्वं वा मृणालधवळः पादैर्न्यूनः पदा चरन्। वृषरूपेण किं कश्चिद्देवो नः परिखेदयन्॥ १/१७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50007220, "chapter_id": 11371, "verse_number": "9", "content_sanskrit": "न जातु कौरवेन्द्राणां दोर्दण्डपरिरम्भिते। भूतळे निपतन्त्यस्मिन् विना त्वां प्राणिनां शुचः॥ १/१७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50007221, "chapter_id": 11371, "verse_number": "10", "content_sanskrit": "मा सौरभेयानुशुचो व्येतु ते वृषळाद् भयम्। मा रोदीरम्ब भद्रं ते खलानां मयि शास्तरि॥ १/१७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50007222, "chapter_id": 11371, "verse_number": "11", "content_sanskrit": "यस्य राष्ट्रे प्रजा मातर्हिंस्यन्ते साध्वसाधुभिः। तस्य मत्तस्य नश्यन्ति कीर्तिरायुर्भगो गतिः॥ १/१७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50007223, "chapter_id": 11371, "verse_number": "12", "content_sanskrit": "एष राज्ञः परो धर्मो ह्यार्तानामार्तिनिग्रहः। अत एनं वधिष्यामि भूतद्रुहमसत्तमम्॥ १/१७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50007224, "chapter_id": 11371, "verse_number": "13", "content_sanskrit": "कोऽवृश्चत्तव पादांस्त्रीन् सौरभेय चतुष्पदः। मा भूवंस्त्वादृशा राष्ट्रे राज्ञां कृष्णानुवर्तिनाम्॥ १/१७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50007225, "chapter_id": 11371, "verse_number": "14", "content_sanskrit": "आख्याहि वृष भद्रं वः साधूनामकृतागसाम्। आत्मवैरूप्यकर्तारं पार्थानां कीर्तिदूषणम्। गलेऽनागस्यघं युञ्जन् सर्वतोऽस्य च तद्भयम्॥ १/१७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50007226, "chapter_id": 11371, "verse_number": "15", "content_sanskrit": "अनागस्स्विह भूतेषु य आगस्कृन्निरङ्कुशः। आहर्ताऽस्मि भुजं साक्षादमर्त्यस्यापि साङ्गदम्॥ १/१७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50007227, "chapter_id": 11371, "verse_number": "16", "content_sanskrit": "राज्ञो हि परमो धर्मः स्वधर्मस्यानुपालनम्। शासतोऽन्यान् यथाशास्त्रमनापद्युत्पथानिह॥ १/१७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50007228, "chapter_id": 11371, "verse_number": "17", "content_sanskrit": "धर्म उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50007229, "chapter_id": 11371, "verse_number": "18", "content_sanskrit": "एतद्वः पाण्डवेयानां युक्तमार्ताभयं वचः। येषां गुणगणैः कृष्णो दौत्यादौ भगवान् वृतः॥ १/१७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50007230, "chapter_id": 11371, "verse_number": "19", "content_sanskrit": "न वयं क्लेशबीजानि यतः स्युः पुरुषर्षभ। पुरुषं तं विजानीमो वाक्यभेदविमोहिताः॥ १/१७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50007231, "chapter_id": 11371, "verse_number": "20", "content_sanskrit": "केचिद्वैकल्प्यवचस आहुरात्मानमात्मनः। दैवमन्ये परे कर्म स्वभावमपरे प्रभुम्॥ १/१७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50007232, "chapter_id": 11371, "verse_number": "21", "content_sanskrit": "अप्रतर्क्यादनिर्वाच्यादिति केष्वपि निश्चयः। अत्रानुरूपं राजर्षे विमृश स्वमनीषया॥ १/१७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50007233, "chapter_id": 11371, "verse_number": "22", "content_sanskrit": "एवं धर्मे प्रवदति स सम्राट् द्विजसत्तम। समाहितेन मनसा विदित्वा प्रत्यचष्ट तम्॥ १/१७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50007234, "chapter_id": 11371, "verse_number": "23", "content_sanskrit": "धर्मं ब्रवीषि धर्मज्ञ धर्मोऽसि वृषरूपधृक्। यदधर्मकृतः स्थानं सूचकस्यापि तद् भवेत्॥ १/१७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50007235, "chapter_id": 11371, "verse_number": "24", "content_sanskrit": "अथवा देवमायाया नूनं गतिरगोचरा। चेतसो वचसश्चापि भूतानामिति निश्चयः॥ १/१७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50007236, "chapter_id": 11371, "verse_number": "25", "content_sanskrit": "तपः शौचं दया सत्यमिति पादाः कृते कृताः। अधर्माङ्गैस्त्रयो भग्नाः स्मयसङ्गमदैस्तव॥ १/१७/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50007237, "chapter_id": 11371, "verse_number": "26", "content_sanskrit": "इदानीं धर्म पादस्ते सत्यं निर्वर्तते यतः। तं जिघृक्षत्यधर्मोऽयमनृतेनैधितः कलिः॥ १/१७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50007238, "chapter_id": 11371, "verse_number": "27", "content_sanskrit": "इयं च भूर्भगवता न्यासितोरुभरा सती। श्रीमद्भिस्तत्पदन्यासैः सर्वतः कृतकौतुका॥ १/१७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50007239, "chapter_id": 11371, "verse_number": "28", "content_sanskrit": "शोचन्त्यश्रुकळा साध्वी दुर्भगेवोज्झिताऽधुना। अब्रह्मण्या नृपव्याजाः शूद्रा भोक्ष्यन्ति मामिति॥ १/१७/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50007240, "chapter_id": 11371, "verse_number": "29", "content_sanskrit": "सूत उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50007241, "chapter_id": 11371, "verse_number": "30", "content_sanskrit": "इति धर्मं महीं चैव सान्त्वयित्वा महारथः। निशातमाददे खड्गं कलयेऽधर्महेतवे॥ १/१७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50007242, "chapter_id": 11371, "verse_number": "31", "content_sanskrit": "तं जिघांसुमभिप्रेक्ष्य विहाय नृपलाञ्छनम्। तत्पादमूलं शिरसा समगाद्भयविह्वलः॥ १/१७/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50007243, "chapter_id": 11371, "verse_number": "32", "content_sanskrit": "पतितं पादयोर्वीरः कृपया दीनवत्सलः। शरण्यं नावधीच्छ्लोक्य आह चेदं हसन्निव॥ १/१७/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50007244, "chapter_id": 11371, "verse_number": "33", "content_sanskrit": "राजोवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50007245, "chapter_id": 11371, "verse_number": "34", "content_sanskrit": "न ते गुडाकेशयशोधराणां बद्धाञ्जलेर्भो भयमस्ति किञ्चित्। न वर्तितव्यं भवता कथञ्चित् क्षेत्रे मदीये त्वमधर्मबन्धुः॥ १/१७/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50007246, "chapter_id": 11371, "verse_number": "35", "content_sanskrit": "त्वां वर्तमानं नरदेवदेहेष्वनुप्रवृत्तोऽयमधर्मयूथः। लोभोऽनृतं चौर्यमनार्यमंहो ज्येष्ठा च माया कलहश्च डम्भः॥ १/१७/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50007247, "chapter_id": 11371, "verse_number": "36", "content_sanskrit": "न वर्तितव्यं तदधर्मबन्धो धर्मेण सत्येन च वर्तितव्ये। ब्रह्मावर्ते यत्र यजन्ति यज्ञैः यज्ञेश्वरं ब्रह्मवितानयज्ञाः॥ १/१७/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50007248, "chapter_id": 11371, "verse_number": "37", "content_sanskrit": "यस्मिन् हरिर्भगवानिज्यमान इष्टात्ममूर्तिर्यजतां शं तनोति। कामानमोघान् स्थिरजङ्गमानामन्तर्बहिर्वायुरिवेश आत्मा॥ १/१७/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50007249, "chapter_id": 11371, "verse_number": "38", "content_sanskrit": "परीक्षितैवमादिष्टः स कलिर्जातवेपथुः। तमुद्यतासिमाहेदं दण्डपाणिमिवोद्यतम्॥ १/१७/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50007250, "chapter_id": 11371, "verse_number": "39", "content_sanskrit": "यत्र क्व वाऽथ वत्स्यामि सार्वभौम तवाज्ञया। लक्षये तत्रतत्रापि त्वामात्तेषुशरासनम्॥ १/१७/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50007251, "chapter_id": 11371, "verse_number": "40", "content_sanskrit": "तन्मे धर्मभृतां श्रेष्ठ स्थानं निर्देष्टुमर्हसि। यत्रैव नियतो वत्स्य आतिष्ठंस्तेऽनुशासनम्॥ १/१७/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50007252, "chapter_id": 11371, "verse_number": "41", "content_sanskrit": "सूत उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50007253, "chapter_id": 11371, "verse_number": "42", "content_sanskrit": "अभ्यर्थितस्तदा तस्मै स्थानानि कलयेऽकरोत्। द्यूतं पानं स्त्रियः सूना यत्राधर्मश्चतुर्विधः॥ १/१७/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50007254, "chapter_id": 11371, "verse_number": "43", "content_sanskrit": "पुनश्च याचमानाय जातरूपमदात् प्रभुः। ततोऽनृतं मदः कामो रजो वैरं च पञ्चमम्॥ १/१७/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50007255, "chapter_id": 11371, "verse_number": "44", "content_sanskrit": "अमूनि पञ्च स्थानानि ह्यधर्मप्रभवः कलिः। औत्तरेयेण दत्तानि न्यवसत् तन्निदेशकृत्॥ १/१७/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50007256, "chapter_id": 11371, "verse_number": "45", "content_sanskrit": "अथैतानि न सेवेत बुभूषुः पुरुषः क्वचित्। विशेषतो धर्मशीलो राजा लोकपतिर्गुरुः॥ १/१७/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 50007257, "chapter_id": 11371, "verse_number": "46", "content_sanskrit": "वृषस्य नष्टांस्त्रीन् पादांस्तपः शौचं दयामिति। प्रतिसन्दध आश्वास्य महीं च समवर्धयत्॥ १/१७/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 50007258, "chapter_id": 11371, "verse_number": "47", "content_sanskrit": "स एष एतर्ह्यध्यास्त आसनं पार्थिवोचितम्। पितामहेनोपन्यस्तं राज्ञाऽरण्यं विविक्षता॥ १/१७/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 50007259, "chapter_id": 11371, "verse_number": "48", "content_sanskrit": "आस्तेऽधुना स राजर्षिः कौरवेन्द्रश्रियोल्लसन्। गजाह्वये महाभागश्चक्रवर्ती बृहच्छ्रवाः॥ १/१७/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 50007260, "chapter_id": 11371, "verse_number": "49", "content_sanskrit": "इत्थम्भूतानुभावोऽयमभिमन्युसुतो नृपः। यस्य पालयतः क्षोणीं यूयं सत्राय दीक्षिताः॥ १/१७/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 50007261, "chapter_id": 11371, "verse_number": "50", "content_sanskrit": "॥ इति श्रीमद्भागवते प्रथमस्कन्धे सप्तदशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]