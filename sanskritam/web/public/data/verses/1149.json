[{"id": 2007745, "chapter_id": 1149, "verse_number": "१-१५०-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2007746, "chapter_id": 1149, "verse_number": "१-१५०-१", "content_sanskrit": "द्रुपदस्यापि विप्रर्षे श्रोतुमिच्छामि संभवम्।\nकथं चापि समुत्पन्नः कथमस्त्राण्यवाप्तवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2007747, "chapter_id": 1149, "verse_number": "१-१५०-२", "content_sanskrit": "एतदिच्छामि भगवंस्त्वत्तः श्रोतुं द्विजोत्तम।\nकौतूहलं जन्मसु मे कीर्त्यमानेष्वनेकशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2007748, "chapter_id": 1149, "verse_number": "१-१५०-३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2007749, "chapter_id": 1149, "verse_number": "१-१५०-३", "content_sanskrit": "राजा बभूव पाञ्चालः पुत्रार्थी पुत्रकारणात्।\nवनं गतो महाराजस्तपस्तेपे सुदारुणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2007750, "chapter_id": 1149, "verse_number": "१-१५०-४", "content_sanskrit": "आराधयन्प्रयत्नेन महर्षीन्संशितव्रतान्।\nतस्य संतप्यमानस्य वने मृगगणायुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2007751, "chapter_id": 1149, "verse_number": "१-१५०-५", "content_sanskrit": "कालस्तु सुमहान्राजन्नत्ययात्सुतकारणात्।\nस तु राजा महातेजास्तपस्तीव्रं समाददे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2007752, "chapter_id": 1149, "verse_number": "१-१५०-६", "content_sanskrit": "कंचित्कालं वायुभक्षो निराहारस्तथैव च।\nतथैव तु महाबाहोर्वर्तमानस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2007753, "chapter_id": 1149, "verse_number": "१-१५०-७", "content_sanskrit": "कालस्तस्य महाराज यातो वै नृपसत्तम।\nततो नातिचिरात्काले वसन्ते कामदीपने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2007754, "chapter_id": 1149, "verse_number": "१-१५०-८", "content_sanskrit": "फुल्लाशोकवने चैव प्राणिनां सुमनोहरे।\nनद्यास्तीरं ततो गत्वा गङ्गायाः पद्मलोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2007755, "chapter_id": 1149, "verse_number": "१-१५०-९", "content_sanskrit": "नियमस्थश्च राजासीत्तदा भरतसत्तम।\nततो नातिचिरात्काले वनं तन्मनुजेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2007756, "chapter_id": 1149, "verse_number": "१-१५०-१०", "content_sanskrit": "संप्राप्ता ह्यप्सरा राजन्मेनकेत्यभिविश्रुता।\nपुष्पद्रुमान्सज्जमाना राज्ञो दर्शनमागमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2007757, "chapter_id": 1149, "verse_number": "१-१५०-११", "content_sanskrit": "न ददर्श तु सा राजंस्तत्र स्थानगतं नृपम्।\nदृष्ट्वा चाप्सरसं तां तु शुक्रं राज्ञोऽपतद्भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2007758, "chapter_id": 1149, "verse_number": "१-१५०-१२", "content_sanskrit": "ततः स राजा राजेन्द्र लज्जया नृपतिः स्वयम्।\nपद्भ्यामाक्रमतायुष्मंस्ततस्तु द्रुपदोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2007759, "chapter_id": 1149, "verse_number": "१-१५०-१३", "content_sanskrit": "ततस्तु तपसा तस्य राजर्षेर्भावितात्मनः।\nपुत्रः समभवच्छीघ्रं पदोस्तस्य क्रमेण तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2007760, "chapter_id": 1149, "verse_number": "१-१५०-१४", "content_sanskrit": "तेनास्य ऋषयः सर्वे समागम्य तपोधनाः।\nनाम चुक्रुर्हि विद्वांसो द्रुपदोऽस्त्विति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2007761, "chapter_id": 1149, "verse_number": "१-१५०-१५", "content_sanskrit": "स तस्यैवाश्रमे राजन्भरद्वाजस्य भारत।\nववृधे सुमुखं तत्र कामैः सर्वैर्नृपोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2007762, "chapter_id": 1149, "verse_number": "१-१५०-१६", "content_sanskrit": "पाञ्चालोऽपि हि राजेन्द्र स्वराज्यं गतवान्प्रभुः।\nभरद्वाजस्य विद्यार्थं सुतं दत्वा महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2007763, "chapter_id": 1149, "verse_number": "१-१५०-१७", "content_sanskrit": "स कुमारस्ततो राजन्द्रोणेन सहितो वने।\nवेदांश्चाधिजगे साङ्गान्धनुर्वेदांश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2007764, "chapter_id": 1149, "verse_number": "१-१५०-१८", "content_sanskrit": "परया स मुदा युक्तो विचचार वने सुखम्।\nतस्यैवं वर्तमानस्य वने वनचरैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2007765, "chapter_id": 1149, "verse_number": "१-१५०-१९", "content_sanskrit": "कालेनातिचिराद्राजन्पिता स्वर्गमुपेयिवान्।\nस समागम्य पाञ्चालैः पाञ्चालेष्वभिषेचितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2007766, "chapter_id": 1149, "verse_number": "१-१५०-२०", "content_sanskrit": "प्राप्तश्च राज्यं राजेन्द्र सुहृदां प्रीतिवर्धनः।\nराज्यं ररक्ष धर्मेण यथा चेन्द्रस्त्रिविष्टपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2007767, "chapter_id": 1149, "verse_number": "१-१५०-२१", "content_sanskrit": "एतन्मया ते राजेन्द्र यथावत्परिकीर्तितम्।\nद्रुपदस्य च राजर्षेर्धृष्टद्युम्नस्य जन्म च॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2007768, "chapter_id": 1149, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि पञ्चाशदधिकशततमोऽध्यायः॥ १५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]