[{"id": 2177770, "chapter_id": 4754, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2177771, "chapter_id": 4754, "verse_number": "१", "content_sanskrit": "ततस्ते पुरुषव्याघ्राः सदश्वैरनिलोपमैः ।\nप्रययू राजशार्दूल शिबिरं पुनरेव ह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2177772, "chapter_id": 4754, "verse_number": "२", "content_sanskrit": "अवतीर्य रथेभ्यस्तु त्वरमाणा महारथाः ।\nददृशुर्द्रौपदीं कृष्णामार्तामार्ततराः स्वयम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2177773, "chapter_id": 4754, "verse_number": "३", "content_sanskrit": "तामुपेत्य निरानन्दां दुःखशोकपरायणाम् ।\nपरिवार्योपतिष्ठन्त पाण्डवाः सहकेशवाः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2177774, "chapter_id": 4754, "verse_number": "४", "content_sanskrit": "ततो राज्ञाऽभ्यनुज्ञातो भीमसेनो महाबलः ।\nप्रददौ तं मणिं दिव्यं वचनं चेदमब्रवीत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2177775, "chapter_id": 4754, "verse_number": "", "content_sanskrit": "भीमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2177776, "chapter_id": 4754, "verse_number": "५", "content_sanskrit": "अयं भद्रे तव मणिः पुत्रहन्ता जितश्च ते ।\nउत्तिष्ठ शोकमुत्सृज्य क्षत्रधर्ममनुस्मर\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2177777, "chapter_id": 4754, "verse_number": "६", "content_sanskrit": "प्रयाणे वासुदेवस्य शमार्थमसितेक्षणे ।\nयान्युक्तानि त्वया भीरु वाक्यानि मधुसूदने\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2177778, "chapter_id": 4754, "verse_number": "७", "content_sanskrit": "नैव मे पतयः सन्ति न पुत्रा भ्रातरो न मे ।\nनैव त्वमसि गोविन्द शममिच्छति राजनि\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2177779, "chapter_id": 4754, "verse_number": "८", "content_sanskrit": "उक्तवत्यसि वाक्यानि धीराणि पुरुषोत्तमे ।\nक्षत्रधर्मानुरूपाणि तानि संस्मर्तुमर्हसि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2177780, "chapter_id": 4754, "verse_number": "९", "content_sanskrit": "हतो दुर्योधनः पापो राज्यस्य परिपन्थ्यसौ ।\nदुःशासनस्य रुधिरं प्राशितं तु रणे मया\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2177781, "chapter_id": 4754, "verse_number": "१०", "content_sanskrit": "वैरस्य गतमानृण्यं न स्म वाच्या विवक्षता ।\nजित्वा द्रोणसुतो मुक्तो ब्राह्मण्याद् गौरवेण च\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2177782, "chapter_id": 4754, "verse_number": "११", "content_sanskrit": "यशोऽस्य पतितं देवि शरीरं त्ववशेषितम् ।\nमणिना विप्रमुक्तश्च न्यासितश्चायुधानि च\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2177783, "chapter_id": 4754, "verse_number": "", "content_sanskrit": "द्रौपदी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2177784, "chapter_id": 4754, "verse_number": "१२", "content_sanskrit": "केवलानृण्यमाप्ताऽस्मि गुरुपुत्रो गुरुर्मम ।\nशिरसैनं मणिं राजा ग्रहीतुमनघोऽर्हति\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2177785, "chapter_id": 4754, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2177786, "chapter_id": 4754, "verse_number": "१३", "content_sanskrit": "तं गृहीत्वा ततो राजा शिरस्येवाकरोत् तदा ।\nगुरोरुच्छिष्टमित्येव द्रौपदीवचनादपि\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2177787, "chapter_id": 4754, "verse_number": "१४", "content_sanskrit": "ततो दिव्यं मणिवरं शिरसा धारयन् प्रभुः ।\nशुशुभे च महाराजः सचन्द्र इव पर्वतः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2177788, "chapter_id": 4754, "verse_number": "१५", "content_sanskrit": "उत्तस्थौ पुत्रशोकार्ता ततः कृष्णा मनस्विनी ।\nकृष्णं चापि महाबाहुरन्वपृच्छद् युधिष्ठिरः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2177789, "chapter_id": 4754, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nऐषीकपर्वणि द्रौपदीसान्त्वनं नाम अष्टमोऽध्यायः॥८॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]