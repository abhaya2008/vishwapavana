[{"id": 2026494, "chapter_id": 1567, "verse_number": "३-२०५-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2026495, "chapter_id": 1567, "verse_number": "३-२०५-१", "content_sanskrit": "इक्ष्वाकौ संस्तिते राजञ्शशादः पृथिवीमिमाम्।\nप्राप्तः परमधर्मात्मा सोऽयोध्यायां नृपोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2026496, "chapter_id": 1567, "verse_number": "३-२०५-२", "content_sanskrit": "शशादस्य तु दायाद ककुत्स्थो नाम वीर्यवान्।\nअनेनाश्चापि काकुत्स्थः पृथुश्चानेनसः सुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2026497, "chapter_id": 1567, "verse_number": "३-२०५-३", "content_sanskrit": "विष्वगश्वः पृथोः पुत्रस्तस्मादार्द्रश्च जज्ञिवान्।\nआर्द्रस्य युवनाश्वस्तु श्रावस्तस्तस्य चात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2026498, "chapter_id": 1567, "verse_number": "३-२०५-४", "content_sanskrit": "जज्ञे श्रावस्तको राजा श्रावस्ती येन निर्मिता।\nश्रावस्तस्य तु दायादो बृहदश्वो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2026499, "chapter_id": 1567, "verse_number": "३-२०५-५", "content_sanskrit": "बृहदश्वस् दायादः कुवलाश्व इति स्मृतः।\nकुवलाश्वस्य पुत्राणां सहस्राण्येकविंसतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2026500, "chapter_id": 1567, "verse_number": "३-२०५-६", "content_sanskrit": "सर्वे विद्यासु निष्णाता बलवन्तो दुरासदाः।\nकुवलाश्वश्च पितृतोगुणैरभ्यधिकोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2026501, "chapter_id": 1567, "verse_number": "३-२०५-७", "content_sanskrit": "समये तं तदा राज्ये बृहदश्वोऽभ्यषेचयत्।\nकुवलाश्वं महाराज शूरमुत्तमधार्मिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2026502, "chapter_id": 1567, "verse_number": "३-२०५-८", "content_sanskrit": "पुत्रसंक्रामितश्रीस्तु बृहदश्वो महीपतिः।\nजगाम तपसे धीमांस्तपोवनममित्रहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2026503, "chapter_id": 1567, "verse_number": "३-२०५-९", "content_sanskrit": "अथ शश्वाव राजर्षिं तमुदङ्को नराधिप।\nवनं संप्रस्थितं राजन्बृहदश्वं द्विजोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2026504, "chapter_id": 1567, "verse_number": "३-२०५-१०", "content_sanskrit": "तमुदङ्को महातेजाः सर्वास्त्रविदुषांवरम्।\nन्यवारयदमेयात्मा समासाद्य पुरोत्तमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2026505, "chapter_id": 1567, "verse_number": "३-२०५-११x", "content_sanskrit": "उदङ्क उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2026506, "chapter_id": 1567, "verse_number": "३-२०५-११", "content_sanskrit": "भवता रक्षणं कार्यं तत्तावत्कर्तुमर्हसि।\nनिरुद्विग्रा वयं राजंस्त्वत्प्रदाद्वसेमहि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2026507, "chapter_id": 1567, "verse_number": "३-२०५-१२", "content_sanskrit": "त्वया हि पृथिवी राजन्रक्ष्यमाणा महात्मना।\nभविष्यति निरुद्विग्ना नारण्यं गन्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2026508, "chapter_id": 1567, "verse_number": "३-२०५-१३", "content_sanskrit": "पालन हि महान्धर्मः प्रजानामिह दृश्यते।\nन तथा दृश्यतेऽरण्ये माभूत्ते बुद्धिरीदृशी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2026509, "chapter_id": 1567, "verse_number": "३-२०५-१४", "content_sanskrit": "ईदृशो न हि राजेन्द्र धर्मः क्वचन दृश्यते।\nप्रजानां पालने यत्नः पुरा राजर्षिभिः कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2026510, "chapter_id": 1567, "verse_number": "३-२०५-१५", "content_sanskrit": "रक्षितव्याः प्रजा राज्ञा तास्त्वं रक्षितुमर्हसि।\nनिरुद्विग्नस्तपस्तप्तुं न हि शक्नोमि पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2026511, "chapter_id": 1567, "verse_number": "३-२०५-१६", "content_sanskrit": "ममाश्रमसमीपे वै समेषु मरुधन्वसु।\nसमुद्रवालुकापूर्ण उज्जालक इति स्मृतः।\nबहुयोजनविस्तीर्णो बहुयोजनमायतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2026512, "chapter_id": 1567, "verse_number": "३-२०५-१७", "content_sanskrit": "तत्र रौद्रो दानवेन्द्रो महावीर्यपराक्रमः।\nमधुकैटभयोः पुत्रो धुन्धुर्नाम सुदारुणः।\nअन्तर्भूमिगतो राजन्वसत्यमितविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2026513, "chapter_id": 1567, "verse_number": "३-२०५-१८", "content_sanskrit": "तं निहत्य महाराज वनं त्वं गन्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2026514, "chapter_id": 1567, "verse_number": "३-२०५-१९", "content_sanskrit": "शेते लोकविनाशाय तप आस्थाय दारुणम्।\nत्रिदशानां विनाशाय लोकानां चापि पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2026515, "chapter_id": 1567, "verse_number": "३-२०५-२०", "content_sanskrit": "अवध्यो दैवतानां हि दैत्यानामथ रक्षसाम्।\nनागानामथ यक्षाणां गन्धर्वाणां च सर्वशः।\nअवाप्यस वरं राजन्सर्वलोकपितामहात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2026516, "chapter_id": 1567, "verse_number": "३-२०५-२१", "content_sanskrit": "तं विनाशय भद्रं ते मा ते बुद्धिरतोऽन्यथा।\nप्राप्स्यसे महतीं कीर्तिं शाश्वतीमव्ययां ध्रुवाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2026517, "chapter_id": 1567, "verse_number": "३-२०५-२२", "content_sanskrit": "क्रूरस्य तस्य स्वपतो वालुकान्तर्हितस्य च।\nसंवत्सरस्य पर्यन्ते निःश्वासः संप्रवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2026518, "chapter_id": 1567, "verse_number": "३-२०५-२३", "content_sanskrit": "यदा तदा भूश्चलति सशैलवनकानना।\nतस्य निःश्वासवातेन रज उद्धूयते महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2026519, "chapter_id": 1567, "verse_number": "३-२०५-२४", "content_sanskrit": "आदित्यरथमाश्रित्य सप्ताहं भूमिकम्पनम्।\nसविस्फुलिङ्गं सज्वालं धूममिश्रं सुदारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2026520, "chapter_id": 1567, "verse_number": "३-२०५-२५", "content_sanskrit": "तेन राजन्न शक्नोमि तस्मिन्स्तातुं स्वआंश्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2026521, "chapter_id": 1567, "verse_number": "३-२०५-२६", "content_sanskrit": "तं विनाशय राजेन्द्र लोकानां हितकाम्यया।\nलकाः स्वस्था भविष्यन्ति तस्मिन्विनिहतेऽसुरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2026522, "chapter_id": 1567, "verse_number": "३-२०५-२७", "content_sanskrit": "`धुन्धुनामानमत्युग्रं दानवं धोरविग्रहम्।\nसमरे धोरतुमुले विनाशय महेषुणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2026523, "chapter_id": 1567, "verse_number": "३-२०५-२८", "content_sanskrit": "त्वं हि तस्य विनाशाय पर्याप्त इति मे मतिः।\nतेजसा तव तेजश्च विष्णुराप्यायविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2026524, "chapter_id": 1567, "verse_number": "३-२०५-२९", "content_sanskrit": "विष्णुना च वरो दत्तः पूर्वं मम महीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2026525, "chapter_id": 1567, "verse_number": "३-२०५-३०", "content_sanskrit": "यस्तं महासुरं रौद्रं वधिष्यति महीपतिः।\nतेजस्तद्वैष्णवमिति प्रवेक्ष्यति दुरासदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2026526, "chapter_id": 1567, "verse_number": "३-२०५-३१", "content_sanskrit": "तत्तेजस्त्वंसमाधाय राजेन्द्र भुवि दुःसहम्।\nतं निषूदय संदिष्टो दैत्यं रौद्रपराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2026527, "chapter_id": 1567, "verse_number": "३-२०५-३२", "content_sanskrit": "न हि धुन्धुर्महातेजास्तेजसाऽल्पेन शक्यते।\nनिर्दग्धुं पृथिवीपाल स हि वर्षशतैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2026528, "chapter_id": 1567, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि पञ्चाधिकद्विशततमोऽध्यायः ॥ २०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]