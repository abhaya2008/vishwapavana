[{"id": 5000437000, "chapter_id": 9437, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000437001, "chapter_id": 9437, "verse_number": "६-३०-१", "content_sanskrit": "ततस्तमक्षोभ्यबलं लङ्काधिपतये चराः।\nसुवेले राघवं शैले निविष्टं प्रत्यवेदयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000437002, "chapter_id": 9437, "verse_number": "६-३०-२", "content_sanskrit": "चाराणां रावणः श्रुत्वा प्राप्तं रामं महाबलम्।\nजातोद्वेगोऽभवत् किंचिच्छार्दूलं वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000437003, "chapter_id": 9437, "verse_number": "६-३०-३", "content_sanskrit": "अयथावच्च ते वर्णो दीनश्चासि निशाचर।\nनासि कच्चिदमित्राणां क्रुद्धानां वशमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000437004, "chapter_id": 9437, "verse_number": "६-३०-४", "content_sanskrit": "इति तेनानुशिष्टस्तु वाचं मन्दमुदीरयन्।\nतदा राक्षसशार्दूलं शार्दूलो भयविक्लवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000437005, "chapter_id": 9437, "verse_number": "६-३०-५", "content_sanskrit": "न ते चारयितुं शक्या राजन् वानरपुङ्गवाः।\nविक्रान्ता बलवन्तश्च राघवेण च रक्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000437006, "chapter_id": 9437, "verse_number": "६-३०-६", "content_sanskrit": "नापि सम्भाषितुं शक्याः सम्प्रश्नोऽत्र न लभ्यते।\nसर्वतो रक्ष्यते पन्था वानरैः पर्वतोपमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000437007, "chapter_id": 9437, "verse_number": "६-३०-७", "content_sanskrit": "प्रविष्टमात्रे ज्ञातोऽहं बले तस्मिन् विचारिते।\nबलाद् गृहीतो रक्षोभिर्बहुधास्मि विचारितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000437008, "chapter_id": 9437, "verse_number": "६-३०-८", "content_sanskrit": "जानुभिर्मुष्टिभिर्दन्तैस्तलैश्चाभिहतो भृशम्।\nपरिणीतोऽस्मि हरिभिर्बलमध्ये अमर्षणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000437009, "chapter_id": 9437, "verse_number": "६-३०-९", "content_sanskrit": "परिणीय च सर्वत्र नीतोऽहं रामसंसदि।\nरुधिरस्राविदीनाङ्गो विह्वलश्चलितेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000437010, "chapter_id": 9437, "verse_number": "६-३०-१०", "content_sanskrit": "हरिभिर्वध्यमानश्च याचमानः कृताञ्जलिः।\nराघवेण परित्रातो मा मेति च यदृच्छया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000437011, "chapter_id": 9437, "verse_number": "६-३०-११", "content_sanskrit": "एष शैलशिलाभिस्तु पूरयित्वा महार्णवम्।\nद्वारमाश्रित्य लङ्काया रामस्तिष्ठति सायुधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000437012, "chapter_id": 9437, "verse_number": "६-३०-१२", "content_sanskrit": "गरुडव्यूहमास्थाय सर्वतो हरिभिर्वृतः।\nमां विसृज्य महातेजा लङ्कामेवातिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000437013, "chapter_id": 9437, "verse_number": "६-३०-१३", "content_sanskrit": "पुरा प्राकारमायाति क्षिप्रमेकतरं कुरु।\nसीतां वापि प्रयच्छाशु युद्धं वापि प्रदीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000437014, "chapter_id": 9437, "verse_number": "६-३०-१४", "content_sanskrit": "मनसा तत् तदा प्रेक्ष्य तच्छ्रुत्वा राक्षसाधिपः।\nशार्दूलं सुमहद्वाक्यमथोवाच स रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000437015, "chapter_id": 9437, "verse_number": "६-३०-१५", "content_sanskrit": "यदि मां प्रतियुध्यन्ते देवगन्धर्वदानवाः।\nनैव सीतां प्रदास्यामि सर्वलोकभयादपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000437016, "chapter_id": 9437, "verse_number": "६-३०-१६", "content_sanskrit": "एवमुक्त्वा महातेजा रावणः पुनरब्रवीत्।\nचरिता भवता सेना केऽत्र शूराः प्लवंगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000437017, "chapter_id": 9437, "verse_number": "६-३०-१७", "content_sanskrit": "किंप्रभाः कीदृशाः सौम्य वानरा ये दुरासदाः।\nकस्य पुत्राश्च पौत्राश्च तत्त्वमाख्याहि राक्षस ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000437018, "chapter_id": 9437, "verse_number": "६-३०-१८", "content_sanskrit": "तथात्र प्रतिपत्स्यामि ज्ञात्वा तेषां बलाबलम्।\nअवश्यं खलु संख्यानं कर्तव्यं युद्धमिच्छता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000437019, "chapter_id": 9437, "verse_number": "६-३०-१९", "content_sanskrit": "अथैवमुक्तः शार्दूलो रावणेनोत्तमश्चरः।\nइदं वचनमारेभे वक्तुं रावणसंनिधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000437020, "chapter_id": 9437, "verse_number": "६-३०-२०", "content_sanskrit": "अथर्क्षरजसः पुत्रो युधि राजन् सुदुर्जयः।\nगद‍्गदस्याथ पुत्रोऽत्र जाम्बवानिति विश्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000437021, "chapter_id": 9437, "verse_number": "६-३०-२१", "content_sanskrit": "गद‍्गदस्याथ पुत्रोऽन्यो गुरुपुत्रः शतक्रतोः।\nकदनं यस्य पुत्रेण कृतमेकेन रक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000437022, "chapter_id": 9437, "verse_number": "६-३०-२२", "content_sanskrit": "सुषेणश्चात्र धर्मात्मा पुत्रो धर्मस्य वीर्यवान्।\nसौम्यः सोमात्मजश्चात्र राजन् दधिमुखः कपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000437023, "chapter_id": 9437, "verse_number": "६-३०-२३", "content_sanskrit": "सुमुखो दुर्मुखश्चात्र वेगदर्शी च वानरः।\nमृत्युर्वानररूपेण नूनं सृष्टः स्वयंभुवा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000437024, "chapter_id": 9437, "verse_number": "६-३०-२४", "content_sanskrit": "पुत्रो हुतवहस्यात्र नीलः सेनापतिः स्वयम्।\nअनिलस्य तु पुत्रोऽत्र हनूमानिति विश्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000437025, "chapter_id": 9437, "verse_number": "६-३०-२५", "content_sanskrit": "नप्ता शक्रस्य दुर्धर्षो बलवानङ्गदो युवा।\nमैन्दश्च द्विविदश्चोभौ बलिनावश्विसम्भवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000437026, "chapter_id": 9437, "verse_number": "६-३०-२६", "content_sanskrit": "पुत्रा वैवस्वतस्याथ पञ्च कालान्तकोपमाः।\nगजो गवाक्षो गवयः शरभो गन्धमादनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000437027, "chapter_id": 9437, "verse_number": "६-३०-२७", "content_sanskrit": "दश वानरकोट्यश्च शूराणां युद्धकाङ्क्षिणाम्।\nश्रीमतां देवपुत्राणां शेषं नाख्यातुमुत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000437028, "chapter_id": 9437, "verse_number": "६-३०-२८", "content_sanskrit": "पुत्रो दशरथस्यैष सिंहसंहननो युवा।\nदूषणो निहतो येन खरश्च त्रिशिरास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000437029, "chapter_id": 9437, "verse_number": "६-३०-२९", "content_sanskrit": "नास्ति रामस्य सदृशे विक्रमे भुवि कश्चन।\nविराधो निहतो येन कबन्धश्चान्तकोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000437030, "chapter_id": 9437, "verse_number": "६-३०-३०", "content_sanskrit": "वक्तुं न शक्तो रामस्य गुणान् कश्चिन्नरः क्षितौ।\nजनस्थानगता येन तावन्तो राक्षसा हताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000437031, "chapter_id": 9437, "verse_number": "६-३०-३१", "content_sanskrit": "लक्ष्मणश्चात्र धर्मात्मा मातंगानामिवर्षभः।\nयस्य बाणपथं प्राप्य न जीवेदपि वासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000437032, "chapter_id": 9437, "verse_number": "६-३०-३२", "content_sanskrit": "श्वेतो ज्योतिर्मुखश्चात्र भास्करस्यात्मसम्भवौ।\nवरुणस्याथ पुत्रोऽथ हेमकूटः प्लवंगमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000437033, "chapter_id": 9437, "verse_number": "६-३०-३३", "content_sanskrit": "विश्वकर्मसुतो वीरो नलः प्लवगसत्तमः।\nविक्रान्तो वेगवानत्र वसुपुत्रः स दुर्धरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000437034, "chapter_id": 9437, "verse_number": "६-३०-३४", "content_sanskrit": "राक्षसानां वरिष्ठश्च तव भ्राता विभीषणः।\nप्रतिगृह्य पुरीं लङ्कां राघवस्य हिते रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000437035, "chapter_id": 9437, "verse_number": "६-३०-३५", "content_sanskrit": "इति सर्वं समाख्यातं तथा वै वानरं बलम्।\nसुवेलेऽधिष्ठितं शैले शेषकार्ये भवान् गतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000437036, "chapter_id": 9437, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]