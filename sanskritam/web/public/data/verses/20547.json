[{"id": 7000547000, "chapter_id": 20547, "verse_number": "५-६-१", "content_sanskrit": "शेष उवाच ।\nइत्थं स्वागतसंतुष्टं ब्रह्मचर्यतपोनिधिम् ।\nउवाच मतिमान्वीरः सर्वलोकगुरुर्मुनिम्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000547001, "chapter_id": 20547, "verse_number": "५-६-२", "content_sanskrit": "स्वागतं ते महाभाग कुंभयोने तपोनिधे ।\nत्वद्दर्शनेन सर्वे वै पाविताः सकुटुंबकाः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000547002, "chapter_id": 20547, "verse_number": "५-६-३", "content_sanskrit": "कच्चिन्मतिस्ते वेदेषु शास्त्रेषु परिवर्तते ।\nत्वत्तपोविघ्नकर्ता वै नास्ति भूमंडले क्वचित्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000547003, "chapter_id": 20547, "verse_number": "५-६-४", "content_sanskrit": "लोपामुद्रा महाभाग या च ते धर्मचारिणी ।\nयस्याः पतिव्रता धर्मात्सर्वं भवति शोभनम्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000547004, "chapter_id": 20547, "verse_number": "५-६-५", "content_sanskrit": "अपि शंस महाभाग धर्ममूर्ते कृपानिधे ।\nअलोलुपस्य किं कार्यं करवाणि मुनीश्वर॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000547005, "chapter_id": 20547, "verse_number": "५-६-६", "content_sanskrit": "त्वत्तपोयोगतः सर्वं भवति स्वेच्छया बहु ।\nतथापि मयि कृत्वैव कृपां शंश मुनीश्वरः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000547006, "chapter_id": 20547, "verse_number": "५-६-७", "content_sanskrit": "शेष उवाच ।\nइत्युक्तो लोकगुरुणा राजराजेन धीमता ।\nउवाच रामं लोकेशं विनीततरभाषया॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000547007, "chapter_id": 20547, "verse_number": "५-६-८", "content_sanskrit": "अगस्त्य उवाच ।\nस्वामिंस्तव सुदुर्दर्शं दर्शनं दैवतैरपि ।\nमत्वा समागतं विद्धि राजराज कृपानिधे॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000547008, "chapter_id": 20547, "verse_number": "५-६-९", "content_sanskrit": "हतस्त्वया रावणाख्यस्त्वसुरो लोककंटकः ।\nदिष्ट्याद्य देवाः सुखिनो दिष्ट्या राजा बिभीषणः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000547009, "chapter_id": 20547, "verse_number": "५-६-१०", "content_sanskrit": "राम त्वद्दर्शनान्मेऽद्य गतं वै दुष्कृतं किल ।\nसंपूर्णो मे मनःकोश आनंदेन सुरोत्तम॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000547010, "chapter_id": 20547, "verse_number": "५-६-११", "content_sanskrit": "इत्युक्त्वा स बभूवाशु तूष्णीं कुंभसमुद्भवः ।\nरामसंदर्शनाह्लादविह्वलीकृतमानसः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000547011, "chapter_id": 20547, "verse_number": "५-६-१२", "content_sanskrit": "रामः पप्रच्छ तं भूयो मुनिं ज्ञानविशारदम् ।\nलोकातीतं भवद्भावि सर्वं जानासि सर्वतः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000547012, "chapter_id": 20547, "verse_number": "५-६-१३", "content_sanskrit": "मुने कथय मे सर्वं पृच्छतो हि सुविस्तरम् ।\nकोऽसौ मया हतो यो हि रावणो विबुधार्दनः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000547013, "chapter_id": 20547, "verse_number": "५-६-१४", "content_sanskrit": "कुंभकर्णोऽपि कस्त्वेष का जातिर्वै दुरात्मनः ।\nदेवो दैत्यः पिशाचो वा राक्षसो वा महामुने॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000547014, "chapter_id": 20547, "verse_number": "५-६-१५", "content_sanskrit": "सर्वमाख्याहि सर्वज्ञ सर्वं जानासि विस्तरात् ।\nअतः कथय मे सर्वं कृपां कृत्वा ममोपरि॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000547015, "chapter_id": 20547, "verse_number": "५-६-१६", "content_sanskrit": "इति श्रुत्वा ततो वाक्यं कुंभजन्मा तपोनिधिः ।\nयत्पृष्टं रघुराजेन प्रवक्तुं तत्प्रचक्रमे॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000547016, "chapter_id": 20547, "verse_number": "५-६-१७", "content_sanskrit": "राजन्सृष्टिकरो ब्रह्मा पुलस्त्यस्तत्सुतोऽभवत् ।\nततस्तु विश्रवा जज्ञे वेदविद्याविशारदः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000547017, "chapter_id": 20547, "verse_number": "५-६-१८", "content_sanskrit": "तस्य पत्नीद्वयं जातं पातिव्रत्यचरित्रभृत् ।\nएका मंदाकिनी नाम्नी द्वितीया कैकसी स्मृता॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000547018, "chapter_id": 20547, "verse_number": "५-६-१९", "content_sanskrit": "पूर्वस्यां धनदो जज्ञे लोकपालविलासभृत् ।\nयोऽसौ शिवप्रसादेन लंकावासमचीकरत्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000547019, "chapter_id": 20547, "verse_number": "५-६-२०", "content_sanskrit": "विद्युन्मालिसुतायां तु पुत्रत्रयमभून्महत् ।\nरावणः कुंभकर्णश्च तथा पुण्यो बिभीषणः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000547020, "chapter_id": 20547, "verse_number": "५-६-२१", "content_sanskrit": "राक्षस्युदरजन्मत्वात्संध्यासमयसंभवात् ।\nद्वयोरधर्मनिपुणा मतिरासीन्महामते॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000547021, "chapter_id": 20547, "verse_number": "५-६-२२", "content_sanskrit": "एकदा तु विमानेन पुष्पकेण सुशोभिना ।\nकांचनीयोपकल्पेन किंकिणीजालमालिना॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000547022, "chapter_id": 20547, "verse_number": "५-६-२३", "content_sanskrit": "आरुह्य पितरौ द्रष्टुं प्रायाच्छोभासमन्वितः ।\nस्वगणैः संस्तुतो भूत्वा नानारत्नविभूषणैः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000547023, "chapter_id": 20547, "verse_number": "५-६-२४", "content_sanskrit": "आगत्य पित्रोश्चरणे पतित्वा चिरमात्मजः ।\nहर्षविह्वलितात्मा च रोमांचिततनूरुहः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000547024, "chapter_id": 20547, "verse_number": "५-६-२५", "content_sanskrit": "उवाच मेऽद्य सुदिनं महाभाग्यफलोदयः ।\nयन्मे युष्मत्पदौ दृष्टौ महापुण्यददर्शनौ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000547025, "chapter_id": 20547, "verse_number": "५-६-२६", "content_sanskrit": "इत्यादिभिः स्तुतिपदैः स्तुत्वागान्मंदिरं स्वकम् ।\nपितरावपि संहृष्टौ पुत्रस्नेहाद्बभूवतुः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000547026, "chapter_id": 20547, "verse_number": "५-६-२७", "content_sanskrit": "तं दृष्ट्वा रावणो धीमाञ्जगाद निजमातरम् ।\nकोऽयं पुमान्सुरो वाथ यक्षो वाथ नरोत्तमः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000547027, "chapter_id": 20547, "verse_number": "५-६-२८", "content_sanskrit": "योऽसौ मम पितुःपादौ सन्निषेव्य गतः पुनः ।\nमहाभाग्यनिधिः स्वीयैर्गणैः सुपरिवारितः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000547028, "chapter_id": 20547, "verse_number": "५-६-२९", "content_sanskrit": "केनेदं तपसा लब्धं विमानं वायुवेगधृक् ।\nउद्यानारामलीलादि विलासस्थानमुत्तमम्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000547029, "chapter_id": 20547, "verse_number": "५-६-३०", "content_sanskrit": "शेष उवाच ।\nइति वाक्यं समाकर्ण्य जननी रोषविक्लवा ।\nउवाच पुत्रं विमनाः किंचिन्नेत्रविकारिणी॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000547030, "chapter_id": 20547, "verse_number": "५-६-३१", "content_sanskrit": "रे पुत्र शृणु मद्वाक्यं बहुशिक्षासमन्वितम् ।\nएतस्य जन्मकर्मादि विचारचतुराधिकम्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000547031, "chapter_id": 20547, "verse_number": "५-६-३२", "content_sanskrit": "सपत्न्या मम कुक्षिस्थं विधानं समुपस्थितम् ।\nयेन स्वमातुर्विमलं कुलमुज्ज्वलितं महत्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000547032, "chapter_id": 20547, "verse_number": "५-६-३३", "content_sanskrit": "त्वं तु मत्कुक्षिजः कीटः पापः स्वोदरपूरकः ।\nयथा खरः स्वकं भारं जानाति न च तद्गुणम्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000547033, "chapter_id": 20547, "verse_number": "५-६-३४", "content_sanskrit": "तथा त्वं लक्ष्यसेऽज्ञानी शयनासनभोगवान् ।\nसुप्तो गतः क्वचिद्भ्रष्ट इत्येव तव संभवः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000547034, "chapter_id": 20547, "verse_number": "५-६-३५", "content_sanskrit": "अनेन तपसा लब्धं शिवसंतोषकारिणा ।\nलंकावासो मनोवेगं विमानं राज्यसंपदः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000547035, "chapter_id": 20547, "verse_number": "५-६-३६", "content_sanskrit": "सुधन्या जननी त्वस्य सुभाग्या सुमहोदया ।\nयस्याः पुत्रो निजगुणैर्लब्धवान्महतां पदम्॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000547036, "chapter_id": 20547, "verse_number": "५-६-३७", "content_sanskrit": "इति क्रुधा भाषितमार्तया तया मात्रा स्वयाऽकर्ण्य दुरात्मसत्तमः ।\nरोषं विधायात्मगतं पुनर्वचो जगाद तां निश्चयभृत्तपः प्रति॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000547037, "chapter_id": 20547, "verse_number": "५-६-३८", "content_sanskrit": "रावण उवाच ।\nजनन्याकर्णय वचो मम गर्वसमन्वितम् ।\nरत्नगर्भा त्वमेवासि यस्याः पुत्रास्त्रयो वयम्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000547038, "chapter_id": 20547, "verse_number": "५-६-३९", "content_sanskrit": "कोऽसौ कीटः स धनदः क्व तपः स्वल्पकं पुनः ।\nकालं का किंतु तद्राज्यं स्वल्पसेवकसंयुतम्॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000547039, "chapter_id": 20547, "verse_number": "५-६-४०", "content_sanskrit": "मातः शृणु ममोत्साहात्प्रतिज्ञां करुणान्विते ।\nन केनापि कृतां कर्त्रा महाभाग्ये हि कैकसि॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000547040, "chapter_id": 20547, "verse_number": "५-६-४१", "content_sanskrit": "यद्यहं भुवनं सर्वं वशेन स्थापयामि वै ।\nतपोभिर्दुष्कृतैः कृत्वा ब्रह्मसंतोषकारकैः॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000547041, "chapter_id": 20547, "verse_number": "५-६-४२", "content_sanskrit": "अन्नोदके सदा त्यक्त्वा निद्रां क्रीडां तथा पुनः ।\nचेत्तदा पितृलोकस्य घातात्पापं भवेन्मम॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000547042, "chapter_id": 20547, "verse_number": "५-६-४३", "content_sanskrit": "कुंभकर्णोऽपि कृतवान्विभीषणसमन्वितः ।\nरावणेन सहभ्रात्रेत्युक्त्वागाद्गिरिकाननम्॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]