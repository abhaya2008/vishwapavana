[{"id": 7002920000, "chapter_id": 22920, "verse_number": "९-२०५-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nप्रतिपन्क्रमयोगेन तिथीनां विस्तरः श्रुतः ।\nसरहस्यः समंत्रश्च प्रारंभोद्यापनैः सह ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002920001, "chapter_id": 22920, "verse_number": "९-२०५-२", "content_sanskrit": "नवग्रहमखात्सर्वं होमकर्मावधारितम् ।\nस्नानक्रमश्च विदितो विज्ञाताश्चोत्सवा मया ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002920002, "chapter_id": 22920, "verse_number": "९-२०५-३", "content_sanskrit": "दानधर्मस्त्वशेषेण श्रुतः सर्वार्थदर्शितः ।\nतडागोत्सर्जनविधिर्विदितः पादपोत्सवः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002920003, "chapter_id": 22920, "verse_number": "९-२०५-४", "content_sanskrit": "एवं गतं मम मनो मुह्यते मधुसूदन ।\nव्रतं कथयता कृष्ण तास्ताः संश्रित्य देवताः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002920004, "chapter_id": 22920, "verse_number": "९-२०५-५", "content_sanskrit": "देवानां देवकीपुत्र नानात्वं संप्रदर्शितम् ।\nतिथिक्रमान्कथयता पूजामन्त्रोधिवासनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002920005, "chapter_id": 22920, "verse_number": "९-२०५-६", "content_sanskrit": "व्यासाद्यैर्मुनिभिः सर्वैर्ध्यानयोगपरायणैः ।\nएक एवात्र निर्दिष्टो देवः सर्वगतोऽव्ययः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002920006, "chapter_id": 22920, "verse_number": "९-२०५-७", "content_sanskrit": "वर्णाश्रमाचारधर्मः कस्मान्नात्र प्रदर्शितः ।\nएते महर्षयस्तुष्टाः श्रोतुकामा भवद्वचः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002920007, "chapter_id": 22920, "verse_number": "९-२०५-८", "content_sanskrit": "श्रीकृष्ण उवाच ।\nव्रतदानैकलेशोयं कथितस्तव पार्थिव ।\nविशेषतश्च शक्नोति वक्तुं यदि सरस्वती ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002920008, "chapter_id": 22920, "verse_number": "९-२०५-९", "content_sanskrit": "सर्वस्तरति दुर्गाणि सर्वो भद्राणि पश्यति ।\nवर्णाश्रमाणां सामान्य इति धर्मः प्रकीर्तितः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002920009, "chapter_id": 22920, "verse_number": "९-२०५-१०", "content_sanskrit": "कथितोऽयं व्रतत्वोहो देवानुद्दिश्य यो मया ।\nपरमार्थः स एवोक्तो देवस्तमुपधारय ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002920010, "chapter_id": 22920, "verse_number": "९-२०५-११", "content_sanskrit": "यो ब्रह्मा स हरिः प्रोक्तो यो हरिः स महेश्वरः ।\nमहेश्वरः स्मृतः सूर्यः सूर्यः पावक उच्यते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002920011, "chapter_id": 22920, "verse_number": "९-२०५-१२", "content_sanskrit": "पावकः कार्तिकेयोसौ कार्तिकेयो विनायकः ।\nगौरी लक्ष्मीश्च सावित्री शक्तिभेदाः प्रकीर्तिताः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002920012, "chapter_id": 22920, "verse_number": "९-२०५-१३", "content_sanskrit": "देवं देवीं समुद्दिश्य यः करोति व्रतं नरः ।\nन भेदस्तत्र मंतव्यः शिवशक्तिमयं जगत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002920013, "chapter_id": 22920, "verse_number": "९-२०५-१४", "content_sanskrit": "बहुप्रकारा वसुधा भेदाः साग्न्यनिलांभसाम् ।\nपरमार्थतश्चिंत्यमानो न भेदः प्रतिभासते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002920014, "chapter_id": 22920, "verse_number": "९-२०५-१५", "content_sanskrit": "कञ्चिद्देवं समाश्रित्य करोति किमपि व्रतम् ।\nत्रयीधर्मानुगं पार्थ एकं तत्रापि कारणम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002920015, "chapter_id": 22920, "verse_number": "९-२०५-१६", "content_sanskrit": "यश्चैव ते मया ख्यातो व्रतदानविधिः परः ।\nसफलः स तु विज्ञेयः सदाचारवतां सताम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002920016, "chapter_id": 22920, "verse_number": "९-२०५-१७", "content_sanskrit": "आचारहीनं न पुनंति वेदा यद्यप्यधीताः सह षड्भिरङ्गैः ।\nछंदांस्येनं मृत्युकाले त्यजंति नीडं शकुन्ता इव जातपक्षाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002920017, "chapter_id": 22920, "verse_number": "९-२०५-१८", "content_sanskrit": "कपालस्थं यथा तोयं श्वदृतौ वा यथा पयः ।\nदुष्टं स्यात्स्थानदोषेण वृत्तहीने तथा शुभम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002920018, "chapter_id": 22920, "verse_number": "९-२०५-१९", "content_sanskrit": "वृत्तं यत्नेन संरक्षेद्वित्तमेति प्रयाति च ।\nअहीनो वित्ततो हीनो वृत्ततस्तु हतो हतः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002920019, "chapter_id": 22920, "verse_number": "९-२०५-२०", "content_sanskrit": "एवमाचारधर्मस्य मूलं राजन्कुलस्य च ।\nआचाराद्धि च्युतो जंतुर्न कुलीनो न धार्मिकः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002920020, "chapter_id": 22920, "verse_number": "९-२०५-२१", "content_sanskrit": "किं कुलेनोपदिष्टेन् विपुलेन दुरात्मनाम् ।\nकृमयः किं न जायंते कुसुमेषु सुगंधिषु ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002920021, "chapter_id": 22920, "verse_number": "९-२०५-२२", "content_sanskrit": "हीनजातिप्रसूतोपि शौचाचारसमन्वितः ।\nसर्वधर्मार्थकुशलः सकुलीनः सतां वरः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002920022, "chapter_id": 22920, "verse_number": "९-२०५-२३", "content_sanskrit": "न कुलं कुलमित्याहुराचारः कुलमुच्यते ।\nआचारकुशलो राजन्निह चामुत्र नंदते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002920023, "chapter_id": 22920, "verse_number": "९-२०५-२४", "content_sanskrit": "युधिष्ठिर उवाच ।\nसदाचारमहं कृष्ण श्रोतुमिच्छामि शाश्वतम् ।\nसर्वं धर्ममयः कोऽत्र सदाचारः प्रकीर्तितः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002920024, "chapter_id": 22920, "verse_number": "९-२०५-२५", "content_sanskrit": "श्रीकृष्ण उवाच ।\nआचारप्रभवो धर्मः संतश्चाचारलक्षणाः ।\nसाधूनां च यथा वृत्तं स सदाचार उच्यते ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002920025, "chapter_id": 22920, "verse_number": "९-२०५-२६", "content_sanskrit": "तस्मात्कुर्यादिहाचारं य इच्छेद्गतिमात्मनः ।\nअपि पापशरीरस्य आचारो हंत्यलक्षणम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002920026, "chapter_id": 22920, "verse_number": "९-२०५-२७", "content_sanskrit": "अदृष्टमश्रुतं वेदं पुरुषं धर्मचारिणम् ।\nस्वानि कर्माणि कुर्वाणं तं जनं कुरुते प्रियम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002920027, "chapter_id": 22920, "verse_number": "९-२०५-२८", "content_sanskrit": "ये नास्तिका नैष्ठिकाश्च गुरुशास्त्रातिलंघिनः ।\nअधर्मज्ञा दुराचारास्ते भवंति गतायुषः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002920028, "chapter_id": 22920, "verse_number": "९-२०५-२९", "content_sanskrit": "सर्वलक्षणहीनोपि यः सदाचारवान्नरः ।\nश्रद्दधानोनसूयश्च सर्वान्कामानवाप्नुयात् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002920029, "chapter_id": 22920, "verse_number": "९-२०५-३०", "content_sanskrit": "ब्राह्मे मुहूर्ते बुध्येत धर्मार्थावनुचिन्तयेत् ।\nब्राह्मणानलगो सूर्यान्न मेहेत कदाचन ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002920030, "chapter_id": 22920, "verse_number": "९-२०५-३१", "content_sanskrit": "उदङ्मुखो दिवारात्रावुत्सर्गं दक्षिणामुखः ।\nउत्थायाचम्य तिष्ठेत पूर्वां संध्यां समाहितः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002920031, "chapter_id": 22920, "verse_number": "९-२०५-३२", "content_sanskrit": "एवमेवोत्तरां संध्यां समुपासीत वाग्यतः ।\nनेक्षेतादित्यमुद्यन्तं नास्तं यांतं कदाचन ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002920032, "chapter_id": 22920, "verse_number": "९-२०५-३३", "content_sanskrit": "ऋषयो दीर्घतपसा दीर्घमायुरवाप्नुयुः ।\nउपासते येन पूर्वां द्विजाः संध्यां न पश्चिमाम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002920033, "chapter_id": 22920, "verse_number": "९-२०५-३४", "content_sanskrit": "सर्वांस्तान्धार्मिको राजा शूद्रकर्मणि योजयेत् ।\nआबाधासु यथाकामं कुर्यान्मूत्रपुरीषयोः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002920034, "chapter_id": 22920, "verse_number": "९-२०५-३५", "content_sanskrit": "शिरसा प्रावृतेनैव समास्तीर्य तृणैर्महीम् ।\nग्रामावसथतीर्थानां क्षेत्राणां चैव वर्त्मनि ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002920035, "chapter_id": 22920, "verse_number": "९-२०५-३६", "content_sanskrit": "न मूत्रमधितिष्ठेत न कृष्टे न च गोव्रजे ।\nअन्तर्जलादावसथाद्वल्मीकान्मूषकस्थलात् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002920036, "chapter_id": 22920, "verse_number": "९-२०५-३७", "content_sanskrit": "कृतशौचावशिष्टाश्च वर्जयेत्पञ्च वै मृदः ।\nदेवार्चनादिकार्याणि तथा गुर्वभिवादनम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002920037, "chapter_id": 22920, "verse_number": "९-२०५-३८", "content_sanskrit": "कुर्वीत सम्यगाचम्य तद्वदन्नभुजि क्रियाम् ।\nअफेनशब्दगंधाभिरद्भिरच्छाभिरादरात् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002920038, "chapter_id": 22920, "verse_number": "९-२०५-३९", "content_sanskrit": "आचामेत्प्रयतः सम्यक्प्राङ्मुखोदङ्मुखोऽपि वा ।\nत्रिवर्गसाधने यच्च सदा कार्यं विपश्चिता ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002920039, "chapter_id": 22920, "verse_number": "९-२०५-४०", "content_sanskrit": "तत्सांनिध्ये गृहस्थस्य सिद्धिरत्र परत्र च ।\nपादेन कार्यं पारत्र्यं पादं कुर्याच्च संचये ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002920040, "chapter_id": 22920, "verse_number": "९-२०५-४१", "content_sanskrit": "अर्धेनाहारचरणनित्यनैमित्तिकांतकम् ।\nअर्थस्योपार्जने यत्नः सदा कार्यो विपश्चितैः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002920041, "chapter_id": 22920, "verse_number": "९-२०५-४२", "content_sanskrit": "तत्संसिद्धौ हि सिद्ध्यन्ति धर्मकामादयो नृप ।\nकेशप्रसाधनादर्शदर्शनं दंतधावनम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002920042, "chapter_id": 22920, "verse_number": "९-२०५-४३", "content_sanskrit": "पूर्वाह्न एव कार्याणि देवतानां च पूजनम् ।\nदूरादावसथान्मूत्रं दूरात्पादावसेचनम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002920043, "chapter_id": 22920, "verse_number": "९-२०५-४४", "content_sanskrit": "उच्छिष्टोत्सर्जनं दूरात्सदा कार्यं हितैषिणा ।\nलोष्टमर्दी तृणच्छेदी नखखादी च यो नरः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002920044, "chapter_id": 22920, "verse_number": "९-२०५-४५", "content_sanskrit": "नित्योच्छिष्टः संकरकृन्नेहायुर्विंदते महत् ।\nनग्नां परस्त्रियं नेक्षेन्न पश्येदात्मनः शकृत् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002920045, "chapter_id": 22920, "verse_number": "९-२०५-४६", "content_sanskrit": "उदक्यादर्शनस्पर्शं कुर्यात्संभाषणं न च ।\nनाप्सु मूत्रं पुरीषं वा मैथुनं वा समाचरेत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002920046, "chapter_id": 22920, "verse_number": "९-२०५-४७", "content_sanskrit": "नाधितिष्ठेच्छकृन्मूत्रे केशभस्मकपालिकान् ।\nतुषांगारास्थिशीर्णानि रञ्जुवस्त्रादिकानि च ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002920047, "chapter_id": 22920, "verse_number": "९-२०५-४८", "content_sanskrit": "धारिणो न नमेद्विद्वान्नासनं चापि दापयेत् ।\nब्राह्मणान्प्रणमेद्विद्वानासनं चापि दापयेत् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002920048, "chapter_id": 22920, "verse_number": "९-२०५-४९", "content_sanskrit": "कृतांजलिरुपासीत गच्छंतं पृष्ठतोन्वियात् ।\nन चासीतासने भिन्ने भिन्नं कांस्यं च वर्जयेत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002920049, "chapter_id": 22920, "verse_number": "९-२०५-५०", "content_sanskrit": "नामुक्तकेशैर्भोक्तव्यं न नग्नः स्नानमाचरेत् ।\nस्वप्तव्यं नैव नग्नेन न चोच्छिष्टस्तु संविशेत् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002920050, "chapter_id": 22920, "verse_number": "९-२०५-५१", "content_sanskrit": "उच्छिष्टो न स्पृशेच्छीर्षं सर्वे प्राणास्तदाश्रयाः ।\nकेशग्रहान्प्रहारांश्च शिरस्येतानि वर्जयेत् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002920051, "chapter_id": 22920, "verse_number": "९-२०५-५२", "content_sanskrit": "नान्यत्र पुत्र शिष्याभ्यां शिफया ताडनं स्मृतम् ।\nन पाणिभ्यां संहताभ्यां कंडूयेदात्मनः शिरः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002920052, "chapter_id": 22920, "verse_number": "९-२०५-५३", "content_sanskrit": "न चाभीक्ष्णं शिरःस्नानं कार्यं निष्कारणं नरैः ।\nअप्रशस्तं निशि स्नानं राहोरन्यत्र दर्शनात् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002920053, "chapter_id": 22920, "verse_number": "९-२०५-५४", "content_sanskrit": "न भुक्तोत्तरकालं च न गम्भीरजलाशये ।\nशिरःस्नानं तु तैलेन नांगं किंचिदुपस्पृशेत् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002920054, "chapter_id": 22920, "verse_number": "९-२०५-५५", "content_sanskrit": "तिलपिष्टं च नाश्नीयात्तथास्यायुर्न हीयते ।\nदुष्कृतं न गुरोर्भूयात्क्रुद्धं चैनं प्रसादयेत् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002920055, "chapter_id": 22920, "verse_number": "९-२०५-५६", "content_sanskrit": "परीवादं न शृणुयादन्येषामपि जल्पताम् ।\nसदानुपहतस्तिष्ठेत्प्रशस्ताश्च तथौषधीः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002920056, "chapter_id": 22920, "verse_number": "९-२०५-५७", "content_sanskrit": "गारुडानि च रत्नानि बिभृयात्प्रयतो नरः ।\nसुस्निग्धामलकेशश्च सुगन्धिश्चारुवेषधृक् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002920057, "chapter_id": 22920, "verse_number": "९-२०५-५८", "content_sanskrit": "सिताः सुमनसो हृद्या बिभृयाच्च नरः सदा ।\nकिंचित्परस्वं न हरेन्नाल्पमप्यप्रियं वदेत् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002920058, "chapter_id": 22920, "verse_number": "९-२०५-५९", "content_sanskrit": "प्रियं च नानृतं ब्रूयान्नान्यदोषानुदीरयेत् ।\nनान्याश्रितं तथा वैरं रोचयेत्पुरुषेश्वरः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002920059, "chapter_id": 22920, "verse_number": "९-२०५-६०", "content_sanskrit": "न दुष्टयानमारोहेत्कूलच्छाया न संश्रयेत् ।\nविद्विष्टपतितोन्मत्तबहुवैरादिसंकरैः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002920060, "chapter_id": 22920, "verse_number": "९-२०५-६१", "content_sanskrit": "बंधकीबंधकीभर्तृक्षुद्रानृत कथैः सह ।\nतथातिव्ययशीलैश्च परिवादरतैः शठैः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002920061, "chapter_id": 22920, "verse_number": "९-२०५-६२", "content_sanskrit": "बुधो मैत्रीं न कुर्वीत नैकः पंथानमाश्रयेत् ।\nनावगाहेज्जलौघस्य वेगमग्रे नरेश्वरा ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002920062, "chapter_id": 22920, "verse_number": "९-२०५-६३", "content_sanskrit": "प्रदीप्तं वेश्म न विशेन्नारोहेच्छिखरं तरोः ।\nन हुंकुर्याच्छवं चैव शवगन्धो हि सोमजः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002920063, "chapter_id": 22920, "verse_number": "९-२०५-६४", "content_sanskrit": "न कुर्याद्दन्तसंवर्षं न कुर्याच्चलनासिकाम् ।\nनासंस्पृष्टमुखो ब्रूयाच्छ्वासकासौ च वर्जयेत् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002920064, "chapter_id": 22920, "verse_number": "९-२०५-६५", "content_sanskrit": "नोच्चैर्हसेत्सशब्दं च न मुञ्चेत्पवनं बुधः ।\nनखान्न वादयेच्छिंद्यान्न नखैश्च महीं लिखेत् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002920065, "chapter_id": 22920, "verse_number": "९-२०५-६६", "content_sanskrit": "न श्मश्रु भक्षयेच्चैव न लोष्ठानि च मर्दयेत् ।\nपादेन नाक्रमेत्पादं न पूज्याभिमुखं नयेत ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002920066, "chapter_id": 22920, "verse_number": "९-२०५-६७", "content_sanskrit": "नोच्चासने समासीत गुरोरग्रे कदाचन ।\nतस्मात्सदाचारपरो भवेत्कामचरो न हि ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002920067, "chapter_id": 22920, "verse_number": "९-२०५-६८", "content_sanskrit": "लोकद्वये शुभं प्रेप्सुः प्रेत्य स्वर्गे महीयते ।\nचतुष्पथं चैत्यतरुं श्मशानोपवनानि च ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7002920068, "chapter_id": 22920, "verse_number": "९-२०५-६९", "content_sanskrit": "दुष्टस्त्रीसंनिकर्षं च वर्जयेन्निशि सर्वदा ।\nग्रीष्मवर्षासु चच्छत्री मौनी रात्रौ वनेषु च ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7002920069, "chapter_id": 22920, "verse_number": "९-२०५-७०", "content_sanskrit": "केशास्थिकण्टकामेध्यबलिभस्मतुषांस्तथा ।\nस्नानार्द्रां धरणीं चैव दूरतः परिवर्जयेत् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7002920070, "chapter_id": 22920, "verse_number": "९-२०५-७१", "content_sanskrit": "पंथा देयो ब्राह्मणेभ्यो राजभ्यः स्त्रीभ्य एव च ।\nविद्याधिकस्य गुर्विण्या भारार्तस्य महीयसः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7002920071, "chapter_id": 22920, "verse_number": "९-२०५-७२", "content_sanskrit": "मूकांधबधिराणां च मत्तस्योन्मत्तकस्य च ।\nउपानद्वस्त्रमाल्यं च धृतमन्यैर्न धारयेत् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7002920072, "chapter_id": 22920, "verse_number": "९-२०५-७३", "content_sanskrit": "न हीदृशमनायुष्यं लोके किञ्चन विद्यते ।\nयादृशं पुरुषस्येह परदारोपसेवनम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7002920073, "chapter_id": 22920, "verse_number": "९-२०५-७४", "content_sanskrit": "न चेर्ष्या स्त्रीषु कर्तव्या दारा रक्ष्याः प्रयत्नतः ।\nअनायुष्या भवेदीर्ष्या तस्मात्तां परिवर्जयेत् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7002920074, "chapter_id": 22920, "verse_number": "९-२०५-७५", "content_sanskrit": "मूर्खोन्मत्तव्यसनिनो विरूपान्मानिनस्तथा ।\nहीनांगानधिकांगांश्च विद्याहीनांश्च नाक्षिपेत् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7002920075, "chapter_id": 22920, "verse_number": "९-२०५-७६", "content_sanskrit": "पानीयस्य क्रिया नक्तं तथैव दधिसक्तवः ।\nवर्जनीया महाराज निशीथे भोजनक्रियाः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7002920076, "chapter_id": 22920, "verse_number": "९-२०५-७७", "content_sanskrit": "नोर्ध्वजानुश्चिरं तिष्ठेन्न रहस्यपरो भवेत् ।\nतद्वन्नोपविशेत्प्राज्ञः पादेनाक्रम्य वासनम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7002920077, "chapter_id": 22920, "verse_number": "९-२०५-७८", "content_sanskrit": "न चातिरक्तवासाः स्याच्चित्रासितधरोऽपि वा ।\nन च कुर्याद्विपर्यासं वाससो न विभूषणे ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7002920078, "chapter_id": 22920, "verse_number": "९-२०५-७९", "content_sanskrit": "स्त्रीं कृशां नावजानीयाद्दीर्घमायुर्जिजीविषुः ।\nब्राह्मणं क्षत्रियं सर्वं सर्वे ह्याशीविषोपमाः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7002920079, "chapter_id": 22920, "verse_number": "९-२०५-८०", "content_sanskrit": "हन्यादाशीविषः क्रुद्धो यावत्स्पृशति दंष्ट्रया ।\nक्षत्रियोऽपि दहेत्क्रुद्धो यावत्पश्यति तेजसा ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7002920080, "chapter_id": 22920, "verse_number": "९-२०५-८१", "content_sanskrit": "ब्राह्मणः सकुलं हन्याद्ध्याने नावेक्षितेन च ।\nनातिकल्यं नातिसायं न च मध्यं दिने तथा ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7002920081, "chapter_id": 22920, "verse_number": "९-२०५-८२", "content_sanskrit": "नाज्ञातैः सह गंतव्यं नैकेन बहुभिः सह ।\nनारुंतुदः स्यान्न परोक्षवादी न सही नतः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7002920082, "chapter_id": 22920, "verse_number": "९-२०५-८३", "content_sanskrit": "रोहते चाग्निना दग्धं वनं परशुना हतम् ।\nवचो दुरुक्तबीभत्सं न संरोहति चाशतम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7002920083, "chapter_id": 22920, "verse_number": "९-२०५-८४", "content_sanskrit": "नास्तिक्यं वेदनिंदा च देवतानां च कुत्सनम् ।\nद्वेषस्तंभादिमानस्य क्लैब्यं च परिवर्जयेत् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7002920084, "chapter_id": 22920, "verse_number": "९-२०५-८५", "content_sanskrit": "न ब्राह्मणं परिवदेन्न नक्षत्राणि दर्शयेत् ।\nतिथिं पक्षस्य न ब्रूयाद्ययास्यायुर्न रिष्यते ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7002920085, "chapter_id": 22920, "verse_number": "९-२०५-८६", "content_sanskrit": "तेजो निष्ठीव्य वासश्च परिधायाचमेद्बुधः ।\nजितामित्रो नृपो यश्च बलवान्कर्मतत्परः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7002920086, "chapter_id": 22920, "verse_number": "९-२०५-८७", "content_sanskrit": "तत्र नित्यं वसेत्प्राज्ञः कृतकृत्यः पतौ सुखम् ।\nपौराः सुसंहता यत्र सततन्यायवर्तिनः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7002920087, "chapter_id": 22920, "verse_number": "९-२०५-८८", "content_sanskrit": "यत्र स्त्रियोऽमत्सरिण्यस्तत्र वासः सुखोदयः ।\nयस्मिन्कृषीवला राष्ट्रे प्रायशो नातिभाषिणः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7002920088, "chapter_id": 22920, "verse_number": "९-२०५-८९", "content_sanskrit": "यत्रौषधान्यशेषाणि वसेत्तत्र विचक्षणः ।\nतत्र राजन्न वस्तव्यं यत्रैतत्त्रितयं सदा ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7002920089, "chapter_id": 22920, "verse_number": "९-२०५-९०", "content_sanskrit": "जिगीषुः पूर्ववैरं च जनश्च विरतोत्सवः ।\nतत्र राजन्न वस्तव्यं यत्र नास्ति चतुष्टयम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7002920090, "chapter_id": 22920, "verse_number": "९-२०५-९१", "content_sanskrit": "ऋणप्रदाता वैद्यश्च श्रोत्रियः सजला नदी ।\nअवलोक्यो न चादर्शो मलिनो बुद्धिमत्तरैः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7002920091, "chapter_id": 22920, "verse_number": "९-२०५-९२", "content_sanskrit": "न च रात्रौ महाराज दीर्घराज्यमभीप्सता ।\nहेमकारगृहे चान्नमश्नीयान्न च विश्वसेत् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7002920092, "chapter_id": 22920, "verse_number": "९-२०५-९३", "content_sanskrit": "न च मित्रं प्रकुर्वीत हेमकारं कदाचन ।\nभिन्नभांडं च खट्वां च कुक्कुरं कुक्कुटं तथा ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7002920093, "chapter_id": 22920, "verse_number": "९-२०५-९४", "content_sanskrit": "अप्रशस्तानि चत्वारि ये च वृक्षाः सकंटकाः ।\nभिन्न भांडे बलिः प्रायः खद्वायां चेह निश्चयः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7002920094, "chapter_id": 22920, "verse_number": "९-२०५-९५", "content_sanskrit": "नाश्नंति पितरस्तस्य यत्र कुक्कुरकुक्कटौ ।\nवृक्षमूले पिशाचानां सर्वेषामेव संस्थितिः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7002920095, "chapter_id": 22920, "verse_number": "९-२०५-९६", "content_sanskrit": "अतस्तेषां तले भुजन्नश्नुते पूयशोणितम् ।\nअसंस्कृतान्नभुङ्मूत्रं बालादिप्रभवं स्वयम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7002920096, "chapter_id": 22920, "verse_number": "९-२०५-९७", "content_sanskrit": "सुवासिनीं गुर्विणीं च वृद्धां बालातुरांस्तथा ।\nभोजयेत्संस्कृतान्नेन प्रथमं चरमं गृही ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7002920097, "chapter_id": 22920, "verse_number": "९-२०५-९८", "content_sanskrit": "अघं स केवलं भुंक्ते बद्धगोवाहनादिकम् ।\nयो भुंक्ते च बहिर्ज्येष्ठप्रेक्षतामप्रदाय च ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7002920098, "chapter_id": 22920, "verse_number": "९-२०५-९९", "content_sanskrit": "वैश्वदेवं ततः कुर्याद्यावदाहुतयः क्रमात् ।\nप्रथमां ब्रह्मणे दद्यात्प्रजानां पतये ततः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7002920099, "chapter_id": 22920, "verse_number": "९-२०५-१००", "content_sanskrit": "तृतीयां चैव गुह्येभ्यः कश्यपाय तथा पराम् ।\nततश्चानुमते दद्याद्दत्त्वा गृहबलिं ततः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7002920100, "chapter_id": 22920, "verse_number": "९-२०५-१०१", "content_sanskrit": "पूर्वाख्यातं मया यत्ते नित्यकर्मक्रियाविधौ ।\nदद्यादथ धरित्रीणां दद्यात्तु मणिकत्रयम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7002920101, "chapter_id": 22920, "verse_number": "९-२०५-१०२", "content_sanskrit": "प्राच्यादिक्रमयोगेन इंद्रादीनां बलिं क्षिपेत् ।\nब्रह्मणे चान्तरिक्षाय सूर्याय च यथाक्रमम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7002920102, "chapter_id": 22920, "verse_number": "९-२०५-१०३", "content_sanskrit": "विश्वेभ्यश्चैव देवेभ्यो विश्वभूतेभ्य एव च ।\nकृत्वापसव्यं वायव्यं यक्ष्मैतत्ते निवेदयेत् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7002920103, "chapter_id": 22920, "verse_number": "९-२०५-१०४", "content_sanskrit": "ततश्चाग्रं समुद्धृत्य हंतकारोपकल्पितम् ।\nयथाविधि यथान्यायं ब्राह्मणायोपपादयेत् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7002920104, "chapter_id": 22920, "verse_number": "९-२०५-१०५", "content_sanskrit": "दत्त्वा विधिभ्यो देवेभ्यो गुरुभ्यः सुश्रुताय च ।\nपुण्यगंधांबरधरो माल्यधारी नरेश्वर ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7002920105, "chapter_id": 22920, "verse_number": "९-२०५-१०६", "content_sanskrit": "नैकवस्त्रधरोऽश्नीयान्नार्द्रपादो महीपते ।\nविशुद्धवदनः प्रीतो भुंजीत न विदिड्मुखः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7002920106, "chapter_id": 22920, "verse_number": "९-२०५-१०७", "content_sanskrit": "प्राङ्मुखोदङ्मुखो वापि न चैवान्यमना नरः ।\nकुत्सितेन हतं चैव जुगुप्सावदसंस्कृतम् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7002920107, "chapter_id": 22920, "verse_number": "९-२०५-१०८", "content_sanskrit": "दत्त्वा तु भुंक्ते शिष्टेभ्यः क्षुधितेभ्यस्तथा गृही ।\nप्रशस्तशुद्धपात्रेषु भुञ्जीताकुपितो नृप ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7002920108, "chapter_id": 22920, "verse_number": "९-२०५-१०९", "content_sanskrit": "नासंदीसंस्थिते पात्रे नादेशे च नरेश्वर ।\nना काले नातिसंकीर्णे दत्त्वाग्रं च नरो मही ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7002920109, "chapter_id": 22920, "verse_number": "९-२०५-११०", "content_sanskrit": "अश्नीयात्तन्मयो भूत्वा पूर्वं तु मधुरं रसम् ।\nलवणोग्रौ ततः पश्चात्कटुतीक्ष्णादिकं ततः ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7002920110, "chapter_id": 22920, "verse_number": "९-२०५-१११", "content_sanskrit": "मार्दवं पुरुषोश्नन्वै मध्ये च कठिनाशनम् ।\nअंते पुनर्द्रवाशी च नरो रोगेण मुच्यते ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7002920111, "chapter_id": 22920, "verse_number": "९-२०५-११२", "content_sanskrit": "दिवाधानासु वसति रात्रौ च दधिसक्तुषु ।\nअलक्ष्मीः कोविदारेषु सर्वदैव कृतालया ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7002920112, "chapter_id": 22920, "verse_number": "९-२०५-११३", "content_sanskrit": "अनिंद्यं भक्षयेन्नित्यं वाग्यतोऽन्नमकुत्सयन् ।\nभुक्त्वा सम्यग्यथाचम्य प्राङ्मुखोदङ् मुखोऽपि वा ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7002920113, "chapter_id": 22920, "verse_number": "९-२०५-११४", "content_sanskrit": "यथावत्पुनराचामेत्पाणी प्रक्षाल्य यत्नतः ।\nअभीष्टदेवतानां च कुर्वीत स्मरणं नरः ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7002920114, "chapter_id": 22920, "verse_number": "९-२०५-११५", "content_sanskrit": "प्राणापानसमानानामुदानव्यानयोस्तथा ।\nअन्नपुष्टिकरं चास्तु ममाद्याव्याहतं सुखम् ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7002920115, "chapter_id": 22920, "verse_number": "९-२०५-११६", "content_sanskrit": "अगस्तिरग्निर्वडवानलश्च भुक्तं प्रपात्रं जरयत्वशेषम् ।\nसुखं च मे तत्परिणामसंभव यच्छत्वरोगं खलु वासुदेवः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7002920116, "chapter_id": 22920, "verse_number": "९-२०५-११७", "content_sanskrit": "इत्युच्चार्य स्वहस्तेन पीरमार्ज्य तथोदरम् ।\nअनायासप्रदायीति कुर्यात्कर्माण्यतंद्रितः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7002920117, "chapter_id": 22920, "verse_number": "९-२०५-११८", "content_sanskrit": "संध्यायां पथिकः कश्चित्समागच्छति भारत ।\nपादशौचासनैः प्रह्वः स्वागतोक्त्या च पूजयेत् ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7002920118, "chapter_id": 22920, "verse_number": "९-२०५-११९", "content_sanskrit": "ततश्चान्नप्रदानेन शयनेन च पार्थिव ।\nदिवा तिथौ च विमुखो यदैकं पातकं भवेत् ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7002920119, "chapter_id": 22920, "verse_number": "९-२०५-१२०", "content_sanskrit": "तदेवाष्टगुणं पुंसां सूर्ये हंसमुखे गते ।\nगच्छेच्छय्यामस्फुटितामपि दारुमयीं नृप ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7002920120, "chapter_id": 22920, "verse_number": "९-२०५-१२१", "content_sanskrit": "नाविशालां न वा भग्नां नासमां मलिनां न च ।\nन च जंतुमयीं शय्यां समातिष्ठेदनापदि ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7002920121, "chapter_id": 22920, "verse_number": "९-२०५-१२२", "content_sanskrit": "प्राच्यां दिशि शिरः शस्तं याम्यायामपि भूपते ।\nसदैव स्वपतां पुंसां विपरीतं तु रोगदम् ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7002920122, "chapter_id": 22920, "verse_number": "९-२०५-१२३", "content_sanskrit": "ऋतावुपगमः शस्तः सपत्न्यां ह्यवनीपते ।\nपुण्यर्क्षे च शुभे काले पुत्रा युग्मासु रात्रिषु ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7002920123, "chapter_id": 22920, "verse_number": "९-२०५-१२४", "content_sanskrit": "न चास्नातां स्त्रियं गच्छेद्गर्भिणीं न रजस्वलाम् ।\nनानिष्टां वै न कुपितां नाशस्तां न च रोगिणीम् ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7002920124, "chapter_id": 22920, "verse_number": "९-२०५-१२५", "content_sanskrit": "नादक्षिणां नान्यकामां नाकामां नान्ययोषितम् ।\nसुक्षामामत्यभुक्तां च स्वयं चैभिर्गुणैर्युतः ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7002920125, "chapter_id": 22920, "verse_number": "९-२०५-१२६", "content_sanskrit": "स्नातः सुगन्धधृग्धृष्टो न श्रांतः क्षुधितोऽपि वा ।\nसकामः सानुरागश्च व्यवायं पुरुषो व्रजेत् ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7002920126, "chapter_id": 22920, "verse_number": "९-२०५-१२७", "content_sanskrit": "चतुर्दश्यां तथाष्टम्यां पंचदश्यां च पर्वसु ।\nतैलाभ्यंगं तथा भोगान्योषितश्च विवर्जयेत् ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7002920127, "chapter_id": 22920, "verse_number": "९-२०५-१२८", "content_sanskrit": "क्षुर कर्मणि चांते च स्त्रीसंभोगे च भारत ।\nस्नायीत चैलवान्प्रातः कटभूमिमुपेत्य च ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7002920128, "chapter_id": 22920, "verse_number": "९-२०५-१२९", "content_sanskrit": "गुरोः पतिव्रतानां च तथा यज्ञतपस्विनाम् ।\nपरिवादं न कुर्वीत परिहासेऽपि भारत ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7002920129, "chapter_id": 22920, "verse_number": "९-२०५-१३०", "content_sanskrit": "युगपज्जलमग्निं च बिभृयान्न विचक्षणः ।\nगुरुं देवान्प्रति तथा न च पादौ प्रसारयेत् ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7002920130, "chapter_id": 22920, "verse_number": "९-२०५-१३१", "content_sanskrit": "नाचक्षीत धयंतीं गां जलं नांजलिना पिबेत् ।\nवातातपौ न सेवेत अनुतापं च वर्जयेत् ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7002920131, "chapter_id": 22920, "verse_number": "९-२०५-१३२", "content_sanskrit": "दासं शपेन्न वै क्रुद्धः सर्वबन्धूनमत्सरी ।\nभीताश्वासनकृत्साधुः स्वर्गस्तस्याव्ययं फलम् ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7002920132, "chapter_id": 22920, "verse_number": "९-२०५-१३३", "content_sanskrit": "नोर्ध्वं तु पत्तनद्वारं निरीक्ष्य पर्यटेन्नरः ।\nयुगमात्रं महीपृष्ठे नरो गच्छेद्विलोकयन् ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7002920133, "chapter_id": 22920, "verse_number": "९-२०५-१३४", "content_sanskrit": "शेषाहे त्वपि शेषांश्च वश्यात्मा यो निरस्यति ।\nतस्य धर्मार्थकामानां हानिर्नाल्पापि जायते ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7002920134, "chapter_id": 22920, "verse_number": "९-२०५-१३५", "content_sanskrit": "वृथा मांसं न खादेत पृष्ठमांसं तथैव च ।\nआक्रोशं च विवादं च पैशुन्यं च विवर्जयेत् ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7002920135, "chapter_id": 22920, "verse_number": "९-२०५-१३६", "content_sanskrit": "संयावं कृशरं मांसं शष्कुलीपायसं तथा ।\nआत्मार्थे न प्रकर्तव्यं देवतानां प्रकल्पयेत् ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7002920136, "chapter_id": 22920, "verse_number": "९-२०५-१३७", "content_sanskrit": "अजाश्च नावकर्षेत ता बहिर्धारयंति च ।\nरक्तमाल्यं न धार्यं स्याच्छुक्लं धार्यं तु पंडितैः ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7002920137, "chapter_id": 22920, "verse_number": "९-२०५-१३८", "content_sanskrit": "वर्जयित्वात्र कमलं तथा कुवलयं विभो ।\nरक्तं शिरसि धार्यं च तथा पानेयमित्यपि ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7002920138, "chapter_id": 22920, "verse_number": "९-२०५-१३९", "content_sanskrit": "कांचनीयापि या माला सा न दुष्यति कर्हिचित् ।\nअन्यदेव भवेद्वासः शयनीये नरोत्तम ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7002920139, "chapter_id": 22920, "verse_number": "९-२०५-१४०", "content_sanskrit": "अन्यदर्चासु देवानामन्यद्धार्यं सभासु च ।\nपिप्पलं च वटं चैव शीर्णश्लेष्मांतकं तथा ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7002920140, "chapter_id": 22920, "verse_number": "९-२०५-१४१", "content_sanskrit": "उदुबरं न खादेत भवार्थी पुरुषोत्तमः ।\nपतितैश्च कथांते च च्छेदनं च विवर्जयेत् ॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7002920141, "chapter_id": 22920, "verse_number": "९-२०५-१४२", "content_sanskrit": "पतितः स्यान्नरो राजन्पतितैस्तु सहाचरन् ।\nवृद्धो ज्ञातिस्तथा मित्रं दरिद्रो यो भवेदिह ॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7002920142, "chapter_id": 22920, "verse_number": "९-२०५-१४३", "content_sanskrit": "गृहे वा संस्थापितास्ते गृहवृद्धिमभीप्सता ।\nगृहे पारावता धन्याः शुकाश्च सहसारिकाः ॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7002920143, "chapter_id": 22920, "verse_number": "९-२०५-१४४", "content_sanskrit": "भवंत्येते तथा पापास्तथा वै तिलपायिकाः ।\nआजोक्षा चंदनं वीणा आदर्शो मधुसर्पिषी ॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 7002920144, "chapter_id": 22920, "verse_number": "९-२०५-१४५", "content_sanskrit": "जलाग्नी चैव बिभृयाद्गृहे नित्यमिति स्थितिः ।\nधनुर्वेदे च सततं यत्नः कार्यो नराधिप ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 7002920145, "chapter_id": 22920, "verse_number": "९-२०५-१४६", "content_sanskrit": "हस्तिपृष्ठेऽश्वपृष्ठे च रथचर्यासु चैव हि ।\nयत्नवान्भव राजेन्द्र नयवान्सुखमेधते ॥१४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 7002920146, "chapter_id": 22920, "verse_number": "९-२०५-१४७", "content_sanskrit": "प्रजापालन युक्तश्च न क्षांतिं लभते नृप ।\nयज्ञशास्त्रं च विज्ञाय शब्दशास्त्रं च भारत ॥१४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 7002920147, "chapter_id": 22920, "verse_number": "९-२०५-१४८", "content_sanskrit": "गांधर्वशास्त्रं विज्ञेयं कला ज्ञेयाश्च भारत ।\nपुराणमितिहासं च तथाख्यानानि यानि च ॥१४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 7002920148, "chapter_id": 22920, "verse_number": "९-२०५-१४९", "content_sanskrit": "एष ते लक्षणोद्देश आचारस्य प्रकीर्तितः ।\nशेषाश्च वेद्या वृद्धेभ्यः प्रत्याहार्या नराधिप ॥१४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 7002920149, "chapter_id": 22920, "verse_number": "९-२०५-१५०", "content_sanskrit": "आचारो भूतिजनन आचारः कीर्तिवर्धनः ।\nआचाराद्वर्धते ह्यायुराचारो हंत्यलक्षणम् ॥१५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 7002920150, "chapter_id": 22920, "verse_number": "९-२०५-१५१", "content_sanskrit": "आगमानां हि सर्वेषामाचारः श्रेष्ठ उच्यत ।\nआचारः परमो धर्म आचाराद्वर्धते धनम् ॥१५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}, {"id": 7002920151, "chapter_id": 22920, "verse_number": "९-२०५-१५२", "content_sanskrit": "पुण्यं यशस्यमायुष्यं स्वर्ग्यं स्वस्त्ययनं महत् ।\nसर्ववर्णानुकंपार्थं मयैतत्समुदाहृतम् ॥१५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 152}, {"id": 7002920152, "chapter_id": 22920, "verse_number": "९-२०५-१५३", "content_sanskrit": "आचार एव नरपुंगव सेव्यमानो धर्मार्थकामफलदो भवतीह पुंसाम् ।\nतस्मात्सदैव विदुषावहितेन राजञ्छास्त्रोदितो ह्यनुदिनं परिपालनीयः ॥१५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 153}]