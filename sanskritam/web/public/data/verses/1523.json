[{"id": 2024433, "chapter_id": 1523, "verse_number": "३-१६१-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2024434, "chapter_id": 1523, "verse_number": "३-१६१-१", "content_sanskrit": "आर्ष्टिषेणाश्रमे तस्मिन्मम पूर्वपितामहाः।\nपाण्डोः पुत्रा महात्मान सर्वे दिव्यपराक्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2024435, "chapter_id": 1523, "verse_number": "३-१६१-२", "content_sanskrit": "कियन्तं कालमवसन्पर्वते गन्धमादने।\nकिंच चक्रुर्महावीर्याः सर्वेऽतिबलपौरुषाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2024436, "chapter_id": 1523, "verse_number": "३-१६१-३", "content_sanskrit": "कानि चाभ्यवहार्याणि तत्र तेषां महात्मनाम्।\nवसतां लोकवीराणामासंस्तद्ब्रूहि सत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2024437, "chapter_id": 1523, "verse_number": "३-१६१-४", "content_sanskrit": "विस्तरेण च मे शंस भीमसेनपराक्रमम्।\nयद्यच्चक्रे महाबाहुस्तस्मिन्हैमवते गिरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2024438, "chapter_id": 1523, "verse_number": "३-१६१-५", "content_sanskrit": "न खल्वासीत्पुनर्युद्धं तस् यक्षैर्द्विजोत्तम।\n`धनदाध्युषिते नित्यं वसतस्तत्र पर्वते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2024439, "chapter_id": 1523, "verse_number": "३-१६१-६", "content_sanskrit": "कच्चित्समागमस्तेषामासीद्वैश्रवणस्य च।\nतत्र ह्यायाति धनद आर्ष्टिषेणो यथाऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2024440, "chapter_id": 1523, "verse_number": "३-१६१-७", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं रविस्तरेण तपोधन।\nन हि मे शृण्वतस्तृप्तिरस्ति तेषां विचेष्टितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2024441, "chapter_id": 1523, "verse_number": "३-१६१-८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2024442, "chapter_id": 1523, "verse_number": "३-१६१-८", "content_sanskrit": "एतदात्महितं श्रुत्वा तस्याप्रतिमतेजसः।\nशासनं सततं चक्रुस्तथैव भरतर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2024443, "chapter_id": 1523, "verse_number": "३-१६१-९", "content_sanskrit": "भुञ्जाना मुनिभोज्यानि रसवन्ति फलानि च।\nशुद्धबाणहतानां च मृगाणां पिशितान्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2024444, "chapter_id": 1523, "verse_number": "३-१६१-१०", "content_sanskrit": "मेध्यानि हिमवत्पृष्ठे मधूनि विविधानि च।\nएवं ते न्यवसंस्तत्र पाण्डवा भरतर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2024445, "chapter_id": 1523, "verse_number": "३-१६१-११", "content_sanskrit": "तथा निवसतां तेषां पञ्चमं वर्षमभ्यगात्।\nशृण्वतां लोमशोक्तानि वाक्यानि विविधान्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2024446, "chapter_id": 1523, "verse_number": "३-१६१-१२", "content_sanskrit": "कृत्यकाल उपस्तास्य इति चोक्त्वा घटोत्कचः।\nराक्षसैः सह सर्वैश्च पूर्वमेव गतः प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2024447, "chapter_id": 1523, "verse_number": "३-१६१-१३", "content_sanskrit": "आर्ष्टिषेणाश्रमे तेषां वसतां वै महात्मनाम्।\nअगच्छन्बहवो मासाः पश्यतां महदद्भुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2024448, "chapter_id": 1523, "verse_number": "३-१६१-१४", "content_sanskrit": "तैस्तत्रविहरद्भिश्च रममाणैश्च पाण्डवैः।\nप्रीतिमन्तो महाभागा मुनयश्चारणास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2024449, "chapter_id": 1523, "verse_number": "३-१६१-१५", "content_sanskrit": "आजग्मुः पाण्डवान्द्रष्टुं शुद्धात्मानो यतव्रताः।\nते तैः सह कथां चक्रुर्द्रिव्यां भरतसत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2024450, "chapter_id": 1523, "verse_number": "३-१६१-१६", "content_sanskrit": "ततः कतिपयाहस्सु महाह्रदनिवासिनम्।\nऋद्धिमन्तं महानागं सुपर्णः सहसाऽहरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2024451, "chapter_id": 1523, "verse_number": "३-१६१-१७", "content_sanskrit": "प्राकम्पत महाशैलः प्रामृद्यन्त महाद्रुमाः।\nददृशुः सर्वभूतानि पाणअडवाश्च तदद्भुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2024452, "chapter_id": 1523, "verse_number": "३-१६१-१८", "content_sanskrit": "ततः शैलोत्तमस्याग्रात्पाण्डवान्प्रति मारुतः।\nअवहत्सर्वमाल्यानि गन्धवन्ति शुभानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2024453, "chapter_id": 1523, "verse_number": "३-१६१-१९", "content_sanskrit": "तत्रपुष्पाणि दिव्यानि सुहृद्भिः सह पाण्डवाः।\nददृशुः पञ्चवर्णानि द्रौपदी च यशस्विनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2024454, "chapter_id": 1523, "verse_number": "३-१६१-२०", "content_sanskrit": "भीमसेनं ततः कृष्णा काले वचनमब्रवीत्।\nविविक्ते पर्वतोद्देशे सुखासीनं महाभुजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2024455, "chapter_id": 1523, "verse_number": "३-१६१-२१", "content_sanskrit": "सुपर्णानिलवेगेन श्वसनेन महाबलात्।\nपञ्चवर्णानि पात्यन्ते पुष्पाणि भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2024456, "chapter_id": 1523, "verse_number": "३-१६१-२२", "content_sanskrit": "`दिव्यावर्णानि दिव्यानि दिव्यगन्धवहानि च।\nमदयन्तीव गन्धेन मनो मे भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2024457, "chapter_id": 1523, "verse_number": "३-१६१-२३", "content_sanskrit": "येषां तु दर्शनात्स्पर्शान्सौरभ्याच्च तथैव च।\nनश्यतीव मनोदुःखं ममेदं शत्रुतापन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2024458, "chapter_id": 1523, "verse_number": "३-१६१-२४", "content_sanskrit": "ईदृशैः कुसुमैर्दिव्यैर्दिव्यगन्धवहैः शुभैः।\nदेवतान्यर्चयित्वाऽहमिच्छेयं सङ्गमं त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2024459, "chapter_id": 1523, "verse_number": "३-१६१-२५", "content_sanskrit": "इदं तु पुरुषव्याघ्र विशेषेणाम्बुजं शुभम्।\nगन्धसंस्थानसंपन्नं मम मानसवर्धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2024460, "chapter_id": 1523, "verse_number": "३-१६१-२६", "content_sanskrit": "प्रत्यक्षं सर्वलोकस् नह्यदृश्यत मां प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2024461, "chapter_id": 1523, "verse_number": "३-१६१-२७", "content_sanskrit": "`वासुदेवसहायेन वासुदेवप्रियेण च।\nखाण्डवे सत्यसन्धेन भ्रात्रा तव महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2024462, "chapter_id": 1523, "verse_number": "३-१६१-२८", "content_sanskrit": "गन्धर्वोरगरक्षांसि वासवश्च पराजितः।\nहता मायाविनश्चोग्रा धनुः प्राप्तं च गाण्डिवं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2024463, "chapter_id": 1523, "verse_number": "३-१६१-२९", "content_sanskrit": "तवापि सुमहत्तेजो महद्बाहुबलं च ते।\nअविषह्यमनाधृष्यं शक्रतुल्यपराक्रम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2024464, "chapter_id": 1523, "verse_number": "३-१६१-३०", "content_sanskrit": "त्वद्बाहुबलवेगेन त्रासिताः सर्वराक्षसाः।\nहित्वा शैलं प्रपद्यन्तां भीमसेन दिशो दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2024465, "chapter_id": 1523, "verse_number": "३-१६१-३१", "content_sanskrit": "ततः शैलोत्तमस्याग्रं चित्रमाल्यधरं शिवम्।\nव्यपेतभयसंमोहाः पश्यन्तु सुहृदस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2024466, "chapter_id": 1523, "verse_number": "३-१६१-३२", "content_sanskrit": "एवं प्रणिहितं भीम चिरात्प्रभृतिमे मनः।\nद्रष्टुमिच्छामि शैलाग्रं त्वद्बाहुबलमाश्रिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2024467, "chapter_id": 1523, "verse_number": "३-१६१-३३", "content_sanskrit": "`इच्छामि च नरव्याघ्र पुष्पं प्रत्यक्षमीदृशम्।\nआनीयमानं क्षिप्रं वै त्वया भरतसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2024468, "chapter_id": 1523, "verse_number": "३-१६१-३४", "content_sanskrit": "ततः क्षिप्तमिवात्मानं द्रौपद्या स परंतपः।\nनामृष्यत महाबाहुः प्रहारमिवसद्गजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2024469, "chapter_id": 1523, "verse_number": "३-१६१-३५", "content_sanskrit": "सिंहर्षभगतिः श्रीमानुदारः कनकप्रभः।\nमनस्वी बलवान्दृष्टो मानी भूरश्च पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2024470, "chapter_id": 1523, "verse_number": "३-१६१-३६", "content_sanskrit": "लोहिताक्षः पृथुव्यंसो मत्तवारणविक्रमः।\nसिंहदंष्ट्रो वृषस्कन्धः सालपोत इवोद्गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2024471, "chapter_id": 1523, "verse_number": "३-१६१-३७", "content_sanskrit": "महात्मा चारुसर्वाङ्ग कम्बुग्रीवो महाहनुः।\nरुक्मपृष्ठं धनुः खङ्गं तूणांश्चापि परामृशन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2024472, "chapter_id": 1523, "verse_number": "३-१६१-३८", "content_sanskrit": "सकेसरीव चोत्सिक्तः प्रभिन्न इव वारणः।\nव्यपेतभयसंमोहः शैलमभ्यपतद्बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2024473, "chapter_id": 1523, "verse_number": "३-१६१-३९", "content_sanskrit": "तं मृगेन्द्रमिवायान्तं प्रभिन्नमिव वारणम्।\nददृशुः सर्वभूतानि पार्थं खङ्गधनुर्धरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2024474, "chapter_id": 1523, "verse_number": "३-१६१-४०", "content_sanskrit": "द्रौपद्या वर्धयन्हर्षं गदामादाय पाण्डवः।\nव्यपेतभयसंमोहः शैलराजं समाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2024475, "chapter_id": 1523, "verse_number": "३-१६१-४१", "content_sanskrit": "न ग्लानिर्न च कातर्यं न वैक्लव्यं न मत्सरः।\nकदाचिज्जुषते पार्थमात्मजं मातरिश्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2024476, "chapter_id": 1523, "verse_number": "३-१६१-४२", "content_sanskrit": "तदेकायनमासाद्य विषमं भीमदर्शनम्।\nबहुतालोच्छ्रयं शृङ्गमारुरोह महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2024477, "chapter_id": 1523, "verse_number": "३-१६१-४३", "content_sanskrit": "स किन्नरमहानागमुनिगन्धर्वराक्षसान्।\nहर्षयन्पर्वतस्याग्रमारुरोह महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2024478, "chapter_id": 1523, "verse_number": "३-१६१-४४", "content_sanskrit": "ततो वैश्रवणावासं ददर्श भरतर्षभः।\nकाञ्चनैः स्फाटिकैश्चैव वेश्मभिः समलंकृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2024479, "chapter_id": 1523, "verse_number": "३-१६१-४५", "content_sanskrit": "[प्राकारेण परिक्षिप्तं सौवर्णेन समन्ततः।\nसर्वरत्नद्युतिमता सर्वोद्यानवता तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2024480, "chapter_id": 1523, "verse_number": "३-१६१-४६", "content_sanskrit": "शैलादभ्युच्छ्रयवता चयाट्टालकशोभिना।\nद्वारतोरणनिर्व्यूहध्वजसंवाहशोभिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2024481, "chapter_id": 1523, "verse_number": "३-१६१-४७", "content_sanskrit": "विलासिनीभिरत्यर्थं नृत्यन्तीभिः समन्ततः।\nवायुना धूयमानाभिः पताकाभिरलंकृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2024482, "chapter_id": 1523, "verse_number": "३-१६१-४८", "content_sanskrit": "धनुष्कोटिमवष्टभ्य वक्रभावेन बाहुना।\nपश्यमानः सखेदेन द्रविणाधिपतेः पुरम् ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2024483, "chapter_id": 1523, "verse_number": "३-१६१-४९", "content_sanskrit": "मोदयनसर्वभूतानि गन्धमादनसंभवः।\nसर्वगन्धवहस्तत्र मारुतः सुसुखो ववौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2024484, "chapter_id": 1523, "verse_number": "३-१६१-५०", "content_sanskrit": "चित्रा विविधवर्णाभाश्चित्रमञ्जरिधारिणः।\nअचिन्त्या विविधास्तत्र द्रुमाः परमशोभिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2024485, "chapter_id": 1523, "verse_number": "३-१६१-५१", "content_sanskrit": "रत्नजालपरिक्षिप्तं चित्रमाल्यविभूषितम्।\nराक्षसाधिपतेः स्थानं ददृशे भरतर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2024486, "chapter_id": 1523, "verse_number": "३-१६१-५२", "content_sanskrit": "गदाखङ्गधनुष्पाणिः समभित्यक्तजीवितः।\nभीमसेनो महाबाहुस्तस्थौ गिरिवाचलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2024487, "chapter_id": 1523, "verse_number": "३-१६१-५३", "content_sanskrit": "ततः शङ्खमुपाध्माय द्विषतां रोमहर्षणम्।\nज्याघोषं तलशब्दं च कृत्वा भूतान्यमोहयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2024488, "chapter_id": 1523, "verse_number": "३-१६१-५४", "content_sanskrit": "ततः प्रहृष्टरोमाणस्तं शब्दमभिदुद्रुवुः।\nयक्षराक्षसगन्धर्वाः पाण्डवस्य समीपतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2024489, "chapter_id": 1523, "verse_number": "३-१६१-५५", "content_sanskrit": "गदापरिघनिस्त्रिंशशूलशक्तिपरश्वथाः।\nप्रगृहीता व्यरोचन्त यक्षराक्षसबाहुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2024490, "chapter_id": 1523, "verse_number": "३-१६१-५६", "content_sanskrit": "ततः प्रववृते युद्धं तेषां तस्य च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2024491, "chapter_id": 1523, "verse_number": "३-१६१-५७", "content_sanskrit": "तैः प्रयुक्तान्महामायैः शूलशक्तिपरश्वथान्।\nभल्लैर्भीमः प्रचिच्छेद भीमवेगतरैस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2024492, "chapter_id": 1523, "verse_number": "३-१६१-५८", "content_sanskrit": "अन्तरिक्षगतानां च भूमिष्ठानां च गर्जताम्।\nशरैर्विव्याध गात्राणइ राक्षसानां महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2024493, "chapter_id": 1523, "verse_number": "३-१६१-५९", "content_sanskrit": "`शोणितस्य ततः पेतुर्घनानामिव भारत।\nगात्रेभ्यः प्रच्युता धारा राक्षसानां समन्ततः।\nस लोहितमहावष्टिमभ्यवर्षन्महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2024494, "chapter_id": 1523, "verse_number": "३-१६१-६०", "content_sanskrit": "गदापरिघपाणीनां रक्षसां कायसंभवा।\nकायेभ्यः प्रच्युता धारा राक्षसानां समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2024495, "chapter_id": 1523, "verse_number": "३-१६१-६१", "content_sanskrit": "भीमबाहुबलोत्सृष्टैरायुधैर्यक्षरक्षसाम्।\nविनिकृत्तानि दृश्यन्ते शरीराणि शिरांसि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2024496, "chapter_id": 1523, "verse_number": "३-१६१-६२", "content_sanskrit": "प्रच्छाद्यमानं रक्षोभिः पाण्डवं प्रियदर्शनम्।\nददृशुः सर्वभूतानि सूर्यमभ्रगणैरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2024497, "chapter_id": 1523, "verse_number": "३-१६१-६३", "content_sanskrit": "स रश्मिभिरिवादित्यः शरैररिनिपातिभिः।\nसर्वानार्च्छन्महाबाहुर्बलवान्सत्यविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2024498, "chapter_id": 1523, "verse_number": "३-१६१-६४", "content_sanskrit": "अभितर्जयमानाश्च रुवन्तश् महारवान्।\nसन्नाहं भीमसेनस्य ददृशुः सर्वराक्षसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2024499, "chapter_id": 1523, "verse_number": "३-१६१-६५", "content_sanskrit": "ते हि विक्षतसर्वाङ्गा भीमसेनभयार्दिताः।\nभीममार्तस्वरं चक्रुर्विप्रकीर्णमहायुधाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2024500, "chapter_id": 1523, "verse_number": "३-१६१-६६", "content_sanskrit": "उत्सृज्य ते गदाशूलानसिशक्तिपरश्वथान्।\nदक्षिणां दिशमाजग्मुस्त्रासिता दृढधन्वना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2024501, "chapter_id": 1523, "verse_number": "३-१६१-६७", "content_sanskrit": "तत्र शूलगदापाणिर्व्यूढोरस्को महाभुजः।\nसखा वैश्रवणस्यासीन्मणिमान्नाम राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2024502, "chapter_id": 1523, "verse_number": "३-१६१-६८", "content_sanskrit": "दर्शयन्स प्रतीकारं पौरुषं च महाबलः।\nस तान्दृष्ट्वा परावृत्तान्स्मयमान इवाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2024503, "chapter_id": 1523, "verse_number": "३-१६१-६९", "content_sanskrit": "एकेन बहवः सङ्ख्ये मानुषेण पराजिताः।\nप्राप्य वैश्रवणावासं किं वक्ष्यथ धनेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2024504, "chapter_id": 1523, "verse_number": "३-१६१-७०", "content_sanskrit": "एवमाभाष् तान्सर्वानभ्यवर्तत राक्षसः।\nशक्तिशूलगदापाणिरभ्यधावत्स पाण्डवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2024505, "chapter_id": 1523, "verse_number": "३-१६१-७१", "content_sanskrit": "तमापतन्तं वेगेन प्रभिन्नमिव वारणम्।\nवत्सदन्तैस्त्रिभिः पार्श्वे भीमसेनः समार्दयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2024506, "chapter_id": 1523, "verse_number": "३-१६१-७२", "content_sanskrit": "मणिमानपि संक्रुद्धः प्रगृह्य महतीं गदाम्।\nप्राहिणोद्भीमसेनाय परिगृह्य महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2024507, "chapter_id": 1523, "verse_number": "३-१६१-७३", "content_sanskrit": "विद्युद्रूपां महाघोरामाकाशे महतीं गदाम्।\nशरैर्बहुभिरानर्छद्भीमसेनः शिलाशितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2024508, "chapter_id": 1523, "verse_number": "३-१६१-७४", "content_sanskrit": "प्रत्यहन्यन्त ते सर्वेगदामासाद्य सायकाः।\nन वेगं धारयामासुर्गदावेगस्य वेगिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2024509, "chapter_id": 1523, "verse_number": "३-१६१-७५", "content_sanskrit": "गदायुद्धसमाचारं बुध्यमानः स वीर्यवान्।\nव्यंसयामास तं तस्य प्रहारं भीमविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2024510, "chapter_id": 1523, "verse_number": "३-१६१-७६", "content_sanskrit": "ततः शक्तिं महाघोरां रुक्मदण्डामयस्मयीम्।\nतस्मिन्नेवान्तरे धीमान्प्रचिक्षेप स राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2024511, "chapter_id": 1523, "verse_number": "३-१६१-७७", "content_sanskrit": "सा भुजं भीमनिर्ह्रादा भित्त्वाभीमस् दक्षिणम्।\nसाग्निज्वाला महारौद्रा पपात सहसा भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2024512, "chapter_id": 1523, "verse_number": "३-१६१-७८", "content_sanskrit": "सोऽतिविद्धो महेष्वासः शक्त्याऽमितपराक्रमः।\nगदां जग्राह कौन्तेयो गदायुद्धविशारदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2024513, "chapter_id": 1523, "verse_number": "३-१६१-७९", "content_sanskrit": "रुक्मपट्टपिनद्धां तां शत्रूणां भयवर्धिनीम्।\nप्रगृह्याथ नदन्भीमः शैक्यां सर्वायसीं गदाम्।\nतरसा चाभिदुद्राव मणिमन्तं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2024514, "chapter_id": 1523, "verse_number": "३-१६१-१८०", "content_sanskrit": "दीप्यमानं महाशूलं प्रगृह्य मणिमानपि।\nप्राहिणोद्भीमसेनाय वेगेन महता नदन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2024515, "chapter_id": 1523, "verse_number": "३-१६१-८१", "content_sanskrit": "भङ्क्त्वा शूलं गदाग्रेण गदायुद्धविभागवित्।\nअभिदुद्राव तं तूर्णं गरुत्मानिव पन्नगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2024516, "chapter_id": 1523, "verse_number": "३-१६१-८२", "content_sanskrit": "सोऽन्तरिक्षमवप्लुत्य विधूय सहसा गदाम्।\nप्रचिक्षेप महाबाहुर्विनद्य रणमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2024517, "chapter_id": 1523, "verse_number": "३-१६१-८३", "content_sanskrit": "सेन्द्राशनिरिवेन्द्रेण विसृष्टा वातरहसा।\nहत्वा रक्षः क्षितिं प्राप्य कृत्येव निपपात ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2024518, "chapter_id": 1523, "verse_number": "३-१६१-८४", "content_sanskrit": "तं राक्षसं बीमबलं भीमसेनबलाहतम्।\nददृशुः सर्वभूतानि सिंहेनेव गवांपतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2024519, "chapter_id": 1523, "verse_number": "३-१६१-८५", "content_sanskrit": "तं प्रेक्ष्य निहतं भूमौ हतशेषा निशाचराः।\nभीममार्तस्वरं कृत्वा जग्मुः प्राचजीं दिशं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2024520, "chapter_id": 1523, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि यक्षयुद्धपर्वणि एकषष्ट्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}]