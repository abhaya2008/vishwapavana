[{"id": 2135878, "chapter_id": 3946, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2135879, "chapter_id": 3946, "verse_number": "१", "content_sanskrit": "प्राप्तमप्रतिमं दुःखं रामेण भरतर्षभ ।\nरक्षसा जानकी तस्य हृता भार्या बलीयसा \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2135880, "chapter_id": 3946, "verse_number": "२", "content_sanskrit": "आश्रमाद् राक्षसेन्द्रेण रावणेन दुरात्मना ।\nमायामास्थाय तरसा हत्वा गृध्रं जटायुषम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2135881, "chapter_id": 3946, "verse_number": "३", "content_sanskrit": "प्रत्याजहार तां रामः सुग्रीवबलमाश्रितः।\nबद्ध्वा सेतुं समुद्रस्य दग्ध्वा लङ्कां शितैः शरैः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2135882, "chapter_id": 3946, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2135883, "chapter_id": 3946, "verse_number": "४", "content_sanskrit": "कस्मिन् रामः कुले जातः किंवीर्यः किम्पराक्रमः ।\nरावणः कस्य पुत्रो वा किं वैरं तस्य तेन ह \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2135884, "chapter_id": 3946, "verse_number": "५", "content_sanskrit": "एतन्मे भगवन् सर्वं सम्यगाख्यातुमर्हसि ।\nश्रोतुमिच्छामि चरितं रामस्याक्लिष्टकर्मणः ।\nत्वया प्रत्यक्षतो दृष्टं यथा सर्वमशेषतः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2135885, "chapter_id": 3946, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2135886, "chapter_id": 3946, "verse_number": "६", "content_sanskrit": "अजो नामाभवद् राजा महानिक्ष्वाकुवंशजः।\nतस्य पुत्रो दशरथः शश्वत् स्वाध्यायवान् शुचिः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2135887, "chapter_id": 3946, "verse_number": "७", "content_sanskrit": "अभवंस्तस्य चत्वारः पुत्रा धर्मार्थकोविदाः ।\nरामलक्ष्मणशत्रुघ्ना भरतश्च महाबलः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2135888, "chapter_id": 3946, "verse_number": "८", "content_sanskrit": "रामस्य माता कौसल्या कैकेयी भरतस्य तु ।\nसुतौ लक्ष्मणशत्रुघ्नौ सुमित्रायाः परन्तपौ \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2135889, "chapter_id": 3946, "verse_number": "९", "content_sanskrit": "विदेहराजो जनकः सीता तस्यात्मजा विभो ।\nयां चकार स्वयं त्वष्टा रामस्य महिषीं प्रियाम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2135890, "chapter_id": 3946, "verse_number": "१०", "content_sanskrit": "एतद् रामस्य ते जन्म सीतायाश्च प्रकीर्तितम् ।\nरावणस्यापि ते जन्म व्याख्यास्यामि जनेश्वर \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2135891, "chapter_id": 3946, "verse_number": "११", "content_sanskrit": "पितामहो रावणस्य साक्षाद् देवः प्रजापतिः ।\nस्वयम्भूः सर्वलोकानां प्रभुः स्रष्टा महातपाः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2135892, "chapter_id": 3946, "verse_number": "१२", "content_sanskrit": "पुलस्त्यो नाम तस्यासीन्मानसो दयितः सुतः ।\nतस्य वैश्रवणो नाम गवि पुत्रोऽभवत् प्रभुः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2135893, "chapter_id": 3946, "verse_number": "१३", "content_sanskrit": "पितरं स समुत्सृज्य पितामहमुपस्थितः ।\nतस्य कोपात् पिता राजन् ससर्जात्मानमात्मना ।\nस जज्ञे विश्रवा नाम तस्यात्मार्धेन वै द्विजः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2135894, "chapter_id": 3946, "verse_number": "१४", "content_sanskrit": "प्रतीकाराय सक्रोधस्ततो वैश्रवणस्य वै ।\nपितामहस्तु प्रीतात्मा ददौ वैश्रवणस्य ह ।\nअमरत्वं धनेशत्वं लोकपालत्वमेव च \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2135895, "chapter_id": 3946, "verse_number": "१५", "content_sanskrit": "ईशानेन तथा सख्यं पुत्रं च नलकूबरम् ।\nराजधानीनिवेशं च लङ्कां रक्षोगणान्विताम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2135896, "chapter_id": 3946, "verse_number": "१६", "content_sanskrit": "विमानं पुष्पकं नाम कामगं च ददौ प्रभुः ।\nयक्षाणामाधिपत्यं च राजराजत्वमेव च \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2135897, "chapter_id": 3946, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि रामरावणयोर्जन्मकथने द्विषष्ट्यधिकद्विशततमोऽध्यायः ॥२६२॥\nरामोपाख्यानपर्वणि द्वितीयोऽध्यायः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2135898, "chapter_id": 3946, "verse_number": "", "content_sanskrit": "––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]