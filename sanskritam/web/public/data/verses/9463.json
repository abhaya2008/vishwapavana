[{"id": 5000463000, "chapter_id": 9463, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे षट्पञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000463001, "chapter_id": 9463, "verse_number": "६-५६-१", "content_sanskrit": "तद् दृष्ट्वा सुमहत् कर्म कृतं वानरसत्तमैः।\nक्रोधमाहारयामास युधि तीव्रमकम्पनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000463002, "chapter_id": 9463, "verse_number": "६-५६-२", "content_sanskrit": "क्रोधमूिर्च्छत तरूपस्तु धुन्वन् परमकार्मुकम्।\nदृष्ट्वा तु कर्म शत्रूणां सारथिं वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000463003, "chapter_id": 9463, "verse_number": "६-५६-३", "content_sanskrit": "तत्रैव तावत् त्वरितो रथं प्रापय सारथे।\nएते च बलिनो घ्नन्ति सुबहून् राक्षसान् रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000463004, "chapter_id": 9463, "verse_number": "६-५६-४", "content_sanskrit": "एते च बलवन्तो वा भीमकोपाश्च वानराः।\nद्रुमशैलप्रहरणास्तिष्ठन्ति प्रमुखे मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000463005, "chapter_id": 9463, "verse_number": "६-५६-५", "content_sanskrit": "एतान् निहन्तुमिच्छामि समरश्लाघिनो ह्यहम्।\nएतैः प्रमथितं सर्वं रक्षसां दृश्यते बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000463006, "chapter_id": 9463, "verse_number": "६-५६-६", "content_sanskrit": "ततः प्रचलिताश्वेन रथेन रथिनां वरः।\nहरीनभ्यपतद् दूराच्छरजालैरकम्पनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000463007, "chapter_id": 9463, "verse_number": "६-५६-७", "content_sanskrit": "न स्थातुं वानराः शेकुः किं पुनर्योद‍्धुमाहवे।\nअकम्पनशरैर्भग्नाः सर्व एवाभिदुद्रुवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000463008, "chapter_id": 9463, "verse_number": "६-५६-८", "content_sanskrit": "तान् मृत्युवशमापन्नानकम्पनशरानुगान्।\nसमीक्ष्य हनुमान् ज्ञातीनुपतस्थे महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000463009, "chapter_id": 9463, "verse_number": "६-५६-९", "content_sanskrit": "तं महाप्लवगं दृष्ट्वा सर्वे ते प्लवगर्षभाः।\nसमेत्य समरे वीराः संहृष्टाः पर्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000463010, "chapter_id": 9463, "verse_number": "६-५६-१०", "content_sanskrit": "व्यवस्थितं हनूमन्तं ते दृष्ट्वा प्लवगर्षभाः।\nबभूवुर्बलवन्तो हि बलवन्तमुपाश्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000463011, "chapter_id": 9463, "verse_number": "६-५६-११", "content_sanskrit": "अकम्पनस्तु शैलाभं हनूमन्तमवस्थितम्।\nमहेन्द्र इव धाराभिः शरैरभिववर्ष ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000463012, "chapter_id": 9463, "verse_number": "६-५६-१२", "content_sanskrit": "अचिन्तयित्वा बाणौघान् शरीरे पातितान् कपिः।\nअकम्पनवधार्थाय मनो दध्रे महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000463013, "chapter_id": 9463, "verse_number": "६-५६-१३", "content_sanskrit": "स प्रहस्य महातेजा हनूमान् मारुतात्मजः।\nअभिदुद्राव तद्रक्षः कम्पयन्निव मेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000463014, "chapter_id": 9463, "verse_number": "६-५६-१४", "content_sanskrit": "तस्याथ नर्दमानस्य दीप्यमानस्य तेजसा।\nबभूव रूपं दुर्धर्षं दीप्तस्येव विभावसोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000463015, "chapter_id": 9463, "verse_number": "६-५६-१५", "content_sanskrit": "आत्मानं त्वप्रहरणं ज्ञात्वा क्रोधसमन्वितः।\nशैलमुत्पाटयामास वेगेन हरिपुङ्गवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000463016, "chapter_id": 9463, "verse_number": "६-५६-१६", "content_sanskrit": "गृहीत्वा सुमहाशैलं पाणिनैकेन मारुतिः।\nस विनद्य महानादं भ्रामयामास वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000463017, "chapter_id": 9463, "verse_number": "६-५६-१७", "content_sanskrit": "ततस्तमभिदुद्राव राक्षसेन्द्रमकम्पनम्।\nपुरा हि नमुचिं संख्ये वज्रेणेव पुरंदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000463018, "chapter_id": 9463, "verse_number": "६-५६-१८", "content_sanskrit": "अकम्पनस्तु तद् दृष्ट्वा गिरिशृङ्गं समुद्यतम्।\nदूरादेव महाबाणैरर्धचन्द्रैर्व्यदारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000463019, "chapter_id": 9463, "verse_number": "६-५६-१९", "content_sanskrit": "तं पर्वताग्रमाकाशे रक्षोबाणविदारितम्।\nविकीर्णं पतितं दृष्ट्वा हनूमान् क्रोधमूिर्च्छतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000463020, "chapter_id": 9463, "verse_number": "६-५६-२०", "content_sanskrit": "सोऽश्वकर्णं समासाद्य रोषदर्पान्वितो हरिः।\nतूर्णमुत्पाटयामास महागिरिमिवोच्छ्रितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000463021, "chapter_id": 9463, "verse_number": "६-५६-२१", "content_sanskrit": "तं गृहीत्वा महास्कन्धं सोऽश्वकर्णं महाद्युतिः।\nप्रगृह्य परया प्रीत्या भ्रामयामास संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000463022, "chapter_id": 9463, "verse_number": "६-५६-२२", "content_sanskrit": "प्रधावन्नुरुवेगेन बभञ्ज तरसा द्रुमान्।\nहनूमान् परमक्रुद्धश्चरणैर्दारयन् महीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000463023, "chapter_id": 9463, "verse_number": "६-५६-२३", "content_sanskrit": "गजांश्च सगजारोहान् सरथान् रथिनस्तथा।\nजघान हनुमान् धीमान् राक्षसांश्च पदातिगान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000463024, "chapter_id": 9463, "verse_number": "६-५६-२४", "content_sanskrit": "तमन्तकमिव क्रुद्धं सद्रुमं प्राणहारिणम्।\nहनूमन्तमभिप्रेक्ष्य राक्षसा विप्रदुद्रुवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000463025, "chapter_id": 9463, "verse_number": "६-५६-२५", "content_sanskrit": "तमापतन्तं संक्रुद्धं राक्षसानां भयावहम्।\nददर्शाकम्पनो वीरश्चुक्षोभ च ननाद च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000463026, "chapter_id": 9463, "verse_number": "६-५६-२६", "content_sanskrit": "स चतुर्दशभिर्बाणैर्निशितैर्देहदारणैः।\nनिर्बिभेद महावीर्यं हनूमन्तमकम्पनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000463027, "chapter_id": 9463, "verse_number": "६-५६-२७", "content_sanskrit": "स तथा विप्रकीर्णस्तु नाराचैः शितशक्तिभिः।\nहनूमान् ददृशे वीरः प्ररूढ इव सानुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000463028, "chapter_id": 9463, "verse_number": "६-५६-२८", "content_sanskrit": "विरराज महावीर्यो महाकायो महाबलः।\nपुष्पिताशोकसंकाशो विधूम इव पावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000463029, "chapter_id": 9463, "verse_number": "६-५६-२९", "content_sanskrit": "ततोऽन्यं वृक्षमुत्पाट्य कृत्वा वेगमनुत्तमम्।\nशिरस्याभिजघानाशु राक्षसेन्द्रमकम्पनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000463030, "chapter_id": 9463, "verse_number": "६-५६-३०", "content_sanskrit": "स वृक्षेण हतस्तेन सक्रोधेन महात्मना।\nराक्षसो वानरेन्द्रेण पपात च ममार च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000463031, "chapter_id": 9463, "verse_number": "६-५६-३१", "content_sanskrit": "तं दृष्ट्वा निहतं भूमौ राक्षसेन्द्रमकम्पनम्।\nव्यथिता राक्षसाः सर्वे क्षितिकम्प इव द्रुमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000463032, "chapter_id": 9463, "verse_number": "६-५६-३२", "content_sanskrit": "त्यक्तप्रहरणाः सर्वे राक्षसास्ते पराजिताः।\nलङ्कामभिययुस्त्रासाद् वानरैस्तैरभिद्रुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000463033, "chapter_id": 9463, "verse_number": "६-५६-३३", "content_sanskrit": "ते मुक्तकेशाः सम्भ्रान्ता भग्नमानाः पराजिताः।\nभयाच्छ्रमजलैरङ्गैः प्रस्रवद्भिर्विदुद्रुवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000463034, "chapter_id": 9463, "verse_number": "६-५६-३४", "content_sanskrit": "अन्योन्यं ये प्रमथ्नन्तो विविशुर्नगरं भयात्।\nपृष्ठतस्ते तु सम्मूढाः प्रेक्षमाणा मुहुर्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000463035, "chapter_id": 9463, "verse_number": "६-५६-३५", "content_sanskrit": "तेषु लङ्कां प्रविष्टेषु राक्षसेषु महाबलाः।\nसमेत्य हरयः सर्वे हनूमन्तमपूजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000463036, "chapter_id": 9463, "verse_number": "६-५६-३६", "content_sanskrit": "सोऽपि प्रवृद्धस्तान् सर्वान् हरीन् सम्प्रत्यपूजयत्।\nहनूमान् सत्त्वसम्पन्नो यथार्हमनुकूलतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000463037, "chapter_id": 9463, "verse_number": "६-५६-३७", "content_sanskrit": "विनेदुश्च यथाप्राणं हरयो जितकाशिनः।\nचकृषुश्च पुनस्तत्र सप्राणानेव राक्षसान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000463038, "chapter_id": 9463, "verse_number": "६-५६-३८", "content_sanskrit": "स वीरशोभामभजन्महाकपिः\nसमेत्य रक्षांसि निहत्य मारुतिः।\nमहासुरं भीमममित्रनाशनं\nविष्णुर्यथैवोरुबलं चमूमुखे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000463039, "chapter_id": 9463, "verse_number": "६-५६-३९", "content_sanskrit": "अपूजयन् देवगणास्तदाकपिं\nस्वयं च रामोऽतिबलश्च लक्ष्मणः।\nतथैव सुग्रीवमुखाः प्लवंगमा\nविभीषणश्चैव महाबलस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000463040, "chapter_id": 9463, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे षट्पञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]