[{"id": 2159369, "chapter_id": 4460, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2159370, "chapter_id": 4460, "verse_number": "१", "content_sanskrit": "दौष्यन्तिं भरतं चापि मृतं सृञ्जय शुश्रुम ।\nकर्माण्यसुकराण्यन्यैः कृतवान् यः शिशुर्वने\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2159371, "chapter_id": 4460, "verse_number": "२", "content_sanskrit": "हिमावदातान् यः सिंहान् नखदंष्ट्रायुधान् बली ।\nनिर्वीर्यांस्तरसा कृत्वा विचकर्ष बबन्ध च\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2159372, "chapter_id": 4460, "verse_number": "३", "content_sanskrit": "क्रूरांश्चोग्रबलान् व्याघ्रान् दमयित्वाऽकरोद् वशे ।\nमनःशिलासमायुक्तान् स्वान् कृत्वाऽञ्जनकाशिनः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2159373, "chapter_id": 4460, "verse_number": "४", "content_sanskrit": "व्यालान् द्विपांश्चातिबलांस् त्रिप्रभिन्नान् घनोपमान् ।\nक्रीडमानः सुसङ्क्रुद्धो दमयित्वा विमुञ्चति\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2159374, "chapter_id": 4460, "verse_number": "५", "content_sanskrit": "सुवर्ष्मणां मन्युमतां बलिनां युद्धशालिनाम् ।\nमहिषाणां सुशृङ्गाणां शतान्यदमयद् बलात्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2159375, "chapter_id": 4460, "verse_number": "६", "content_sanskrit": "शरभान् सृमरान् खड्गान् नानासत्त्वानि चाप्यथ ।\nकृच्छ्रप्राणान् वने बद्ध्वा दमयित्वाऽप्यवासृजत्\nतं सर्वदमनेत्याहुः तद्विदस्तेन कर्मणा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2159376, "chapter_id": 4460, "verse_number": "७", "content_sanskrit": "तं प्रत्यषेधज्जननी मा सत्त्वानि व्यनीनशः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2159377, "chapter_id": 4460, "verse_number": "८", "content_sanskrit": "सोऽश्वमेधशतेनेजे यमुनामनु वीर्यवान् ।\nत्रिंशता च सरस्वत्या गङ्गामनु चतुःशतैः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2159378, "chapter_id": 4460, "verse_number": "९", "content_sanskrit": "सोऽश्वमेधसहस्रेण राजसूयशतेन च ।\nपुनरीजे महायज्ञैः समाप्तवरदक्षिणैः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2159379, "chapter_id": 4460, "verse_number": "१०", "content_sanskrit": "अग्निष्टोमातिरात्राणामूक्थ्यविश्वजितां च सः ।\nचातुर्मास्येष्टिसत्राणां सहस्रैश्च सुसम्मतैः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2159380, "chapter_id": 4460, "verse_number": "११", "content_sanskrit": "इष्ट्वा शाकुन्तलो राजा तर्पयित्वा द्विजान् धनैः ।\nसहस्रं यत्र पद्मानां कण्वाय भरतो ददौ\nजाम्बूनदस्य शुद्धस्य कनकस्य महायशाः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2159381, "chapter_id": 4460, "verse_number": "१२", "content_sanskrit": "यस्य यूपाः शतव्यामाः परिणाहेन काञ्चनाः ।\nसहस्रव्याममुद्विद्धाः सैन्द्रैर्देवैः समुच्छ्रिताः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2159382, "chapter_id": 4460, "verse_number": "१३", "content_sanskrit": "स्वलङ्कृतान् भ्राजमानान् सर्वरत्नमनोरमान् ।\nहिरण्मयांश्च द्विरदान् उष्ट्रानश्वानजाविकान्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2159383, "chapter_id": 4460, "verse_number": "१४", "content_sanskrit": "दासीदासं धनं धान्यं गाः सवत्साः पयस्विनीः ।\nग्रामान् गृहाणि क्षेत्राणि विविधांश्च परिच्छदान्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2159384, "chapter_id": 4460, "verse_number": "१५", "content_sanskrit": "कोटीशतायुतं चैव ब्राह्मणेभ्यो ह्यमंसत ।\nचक्रवर्ती ह्यदीनात्मा जेता युद्धेऽजितः परैः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2159385, "chapter_id": 4460, "verse_number": "१६", "content_sanskrit": "स चेन्ममार सृञ्जय चतुर्भद्रतरस्त्वया \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2159386, "chapter_id": 4460, "verse_number": "१७", "content_sanskrit": "पुत्रात् पुण्यतरस्तुभ्यं मा पुत्रमनुतप्यथाः ।\nअयज्वानमदक्षिण्यमधिचैत्येत्युदाहरत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2159387, "chapter_id": 4460, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि पञ्चषष्टितमोऽध्यायः ॥ ६५ ॥\nअभिमन्युवधपर्वणि चतुस्त्रिंशोऽध्यायः ॥ ३४ ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]