[{"id": 7003465000, "chapter_id": 23465, "verse_number": "१०५-१", "content_sanskrit": "अथ क्षीरधेनुदानविधिः ।\nहोतोवाच ।\nक्षीरधेनुं प्रवक्ष्यामि तां निबोध नराधिप ।\nअनुलिप्ते महीपृष्ठे गोमयेन नृपोत्तम ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003465001, "chapter_id": 23465, "verse_number": "१०५-२", "content_sanskrit": "गोचर्ममात्रमानेन कुशानास्तीर्य   सर्वतः ।\nतस्योपरि महाराज न्यसेत्कृष्णाजिनं बुधः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003465002, "chapter_id": 23465, "verse_number": "१०५-३", "content_sanskrit": "तत्र कृत्वा कुण्डलिकां गोमयेन सुविस्तृताम् ।\nक्षीरकुम्भं ततः स्थाप्य चतुर्थांशेन वत्सकम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003465003, "chapter_id": 23465, "verse_number": "१०५-४", "content_sanskrit": "सुवर्णमुखशृङ्गाणि चन्दनागुरुकाणि च।\nप्रशस्तपत्रश्रवणां तिलपात्रोपरि न्यसेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003465004, "chapter_id": 23465, "verse_number": "१०५-५", "content_sanskrit": "मुखं गुडमयं तस्या जिह्वां शर्करया तथा ।\nफलप्रशस्तदशनां मुक्ताफलमयेक्षणाम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003465005, "chapter_id": 23465, "verse_number": "१०५-६", "content_sanskrit": "इक्षुपादां दर्भरोमां सितकम्बलसंवृताम् ।\nताम्रपृष्ठां कांस्यदोहां पट्टसूत्रमयीं शुभाम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003465006, "chapter_id": 23465, "verse_number": "१०५-७", "content_sanskrit": "पुच्छं च नृपशार्दूल नवनीतमयस्तनीम्।\nस्वर्णशृङ्गीं रौप्यखुरां पञ्चरत्नसमन्विताम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003465007, "chapter_id": 23465, "verse_number": "१०५-८", "content_sanskrit": "चत्वारि तिलपात्राणि चतुर्दिक्ष्वपि विन्यसेत् ।\nसप्तधान्ययुतं पात्रे दिक्षु दिक्षु च विन्यसेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003465008, "chapter_id": 23465, "verse_number": "१०५-९", "content_sanskrit": "एवं लक्षणसंयुक्तां क्षीरधेनुं प्रकल्पयेत् ।\nआच्छाद्य वस्त्रयुग्मेन गन्धपुष्पैः समर्चयेत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003465009, "chapter_id": 23465, "verse_number": "१०५-१०", "content_sanskrit": "धूपदीपादिकं कृत्वा ब्राह्मणाय निवेदयेत् ।\nवस्त्रादिभिरलंकृत्य मुद्रिकाकर्णकुण्डलैः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003465010, "chapter_id": 23465, "verse_number": "१०५-११", "content_sanskrit": "पादुकोपानहौ छत्रं दत्त्वा दानं समर्पयेत् ।\nदद्यादनेन मन्त्रेण क्षीरधेनुं प्रयत्नतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003465011, "chapter_id": 23465, "verse_number": "१०५-१२", "content_sanskrit": "आप्यायस्वेति मन्त्रेण वेदोक्तेन विधानतः ।\nआश्रयः सर्वभूतानामित्यादि नरपुङ्गव ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003465012, "chapter_id": 23465, "verse_number": "१०५-१३", "content_sanskrit": "आप्यायस्वेति मन्त्रेण क्षीरधेनुं प्रसादयेत् ।\nप्रतिग्राही पठेन्मन्त्रमेष दानविधिः स्मृतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003465013, "chapter_id": 23465, "verse_number": "१०५-१४", "content_sanskrit": "दीयमानां प्रपश्यन्ति ते यान्ति परमां गतिम् ।\nएतां हेमसहस्रेण शतेनाथ स्वशक्तितः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003465014, "chapter_id": 23465, "verse_number": "१०५-१५", "content_sanskrit": "दत्वा धेनुं महाराज शृणु तस्यापि यत्फलम् ।\nषष्टिवर्षसहस्रं तु इन्द्रलोके महीयते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003465015, "chapter_id": 23465, "verse_number": "१०५-१६", "content_sanskrit": "पित्रादिभिश्च सहितो ब्रह्मणो भवनं व्रजेत् ।\nदिव्यं विमानमारूढो दिव्यस्रगनुलेपनः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003465016, "chapter_id": 23465, "verse_number": "१०५-१७", "content_sanskrit": "क्रीडित्वा सुचिरं कालं विष्णुलोकं स गच्छति ।\nद्वादशादित्यसंकाशे विमानवरमण्डिते ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003465017, "chapter_id": 23465, "verse_number": "१०५-१८", "content_sanskrit": "गीतवादित्रनिर्घोषैरप्सरोभिश्च सेविते ।\nतत्रोष्य विष्णोर्भवने विष्णुसायुज्यमाप्नुयात् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003465018, "chapter_id": 23465, "verse_number": "१०५-१९", "content_sanskrit": "यं इमं शृणुयाद्राजन्पठेद्वा भक्तिभावतः ।\nसर्वपापविनिर्मुक्तो विष्णुलोकं स गच्छति ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]