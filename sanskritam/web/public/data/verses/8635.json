[{"id": 900008445, "chapter_id": 8635, "verse_number": "16.1", "content_sanskrit": "अत्र ‘‘य एषोंऽतरक्षिणि पुरुषो दृश्यत एष आत्मेति..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008446, "chapter_id": 8635, "verse_number": "16.2", "content_sanskrit": "पूर्वपक्षस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008447, "chapter_id": 8635, "verse_number": "16.3", "content_sanskrit": "न च वाच्यमक्ष्यादित्यस्थयोरेकत्वेऽपि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008448, "chapter_id": 8635, "verse_number": "16.4", "content_sanskrit": "तत्र चात्रत्यादित्यस्थस्याग्नित्वे सिद्धे तद्बलेन..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900008449, "chapter_id": 8635, "verse_number": "16.5", "content_sanskrit": "सिद्धान्तस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900008450, "chapter_id": 8635, "verse_number": "16.6", "content_sanskrit": "सूत्रक्रमस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900008451, "chapter_id": 8635, "verse_number": "16.7", "content_sanskrit": "परमतद्वयेऽपीदमन्तस्तद्धर्मेत्यनेन गतार्थम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900008452, "chapter_id": 8635, "verse_number": "16.8", "content_sanskrit": "परसिद्धान्तोऽप्ययुक्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900008453, "chapter_id": 8635, "verse_number": "16.9", "content_sanskrit": "टीकाक्षरार्थस्तु ..", "padaccheda":