[{"id": 50024837, "chapter_id": 11915, "verse_number": "1", "content_sanskrit": "वादजल्पवितण्डानामिति शुद्धं स्वलक्षणम्॥ २३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024838, "chapter_id": 11915, "verse_number": "2", "content_sanskrit": "आनन्दतीर्थमुनिना ब्रह्मतर्कानुसारतः। कथालक्षणमित्युक्तं प्रीत्यर्थं शार्ङ्गधन्वनः॥ २४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024839, "chapter_id": 11915, "verse_number": "3", "content_sanskrit": "सदोदितामितज्ञानपूरवारितहृत्तमाः। नरसिंहः प्रियतमः प्रीयतां पुरुषोत्तमः॥ २५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024840, "chapter_id": 11915, "verse_number": "4", "content_sanskrit": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचितं कथालक्षणं सम्पूर्णम्॥ 【पाठभेदः: BG—॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचितं वादलक्षणं सम्पूर्णम्॥】", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]