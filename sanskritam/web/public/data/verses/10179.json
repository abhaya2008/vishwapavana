[{"id": 6000179000, "chapter_id": 10179, "verse_number": null, "content_sanskrit": "अथ चतुर्थाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000179001, "chapter_id": 10179, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.001.m4a", "display_order": 2}, {"id": 6000179002, "chapter_id": 10179, "verse_number": "९-४-१", "content_sanskrit": "शर्यातिर्मानवो राजन् ब्रह्मिष्ठः सम्बभूव ह।\nयो वा अङ्गिरसां सत्रे द्वितीयमहरध्यगात्॥ ९/४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.002.m4a", "display_order": 3, "topics": [{"text": "वैवस्वतमनुपुत्रस्य शर्यातेः तत्पुत्र्याः सुकन्यायास्तद्भर्तुश्च्यवनऋषेश्च कथा", "range": "१–२६"}]}, {"id": 6000179003, "chapter_id": 10179, "verse_number": "९-४-२", "content_sanskrit": "सुकन्या नाम तस्यासीत् कन्या कमललोचना।\nतया सार्धं वनगतो ह्यगमच्च्यवनाश्रमम्॥ ९/४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.003.m4a", "display_order": 4}, {"id": 6000179004, "chapter_id": 10179, "verse_number": "९-४-३", "content_sanskrit": "सा सखीभिः परिवृता विचिन्वन्त्यङ्घ्रिपान् वने।\nवल्मीकरन्ध्रे ददृशे खद्योते इव ज्योतिषी॥ ९/४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.004.m4a", "display_order": 5}, {"id": 6000179005, "chapter_id": 10179, "verse_number": "९-४-४", "content_sanskrit": "दैवेन चोदिता बाला ज्योतिषी कण्टकेन सा।\nअविध्यन्मुग्धभावेन सुस्रावासृक् ततो बहु॥ ९/४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.005.m4a", "display_order": 6}, {"id": 6000179006, "chapter_id": 10179, "verse_number": "९-४-५", "content_sanskrit": "शकृन्मूत्रनिरोधोऽभूत् सैनिकानां च तत्क्षणात्।\nराजर्षिस्तमुपालभ्य पुरुषान् विस्मितोऽब्रवीत्॥ ९/४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.006.m4a", "display_order": 7}, {"id": 6000179007, "chapter_id": 10179, "verse_number": "९-४-६", "content_sanskrit": "अप्यभद्रं न युष्माभिर्भार्गवस्य विचेष्टितम्।\nव्यक्तं केनापि नस्तस्य कृतमाश्रमदूषणम्॥ ९/४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.007.m4a", "display_order": 8}, {"id": 6000179008, "chapter_id": 10179, "verse_number": "९-४-७", "content_sanskrit": "सुकन्या प्राह पितरं भीता किञ्चित् कृतं मया।\nद्वे ज्योतिषी अजानन्त्या निर्भिन्ने कण्टकेन ते॥ ९/४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.008.m4a", "display_order": 9}, {"id": 6000179009, "chapter_id": 10179, "verse_number": "९-४-८", "content_sanskrit": "दुहितुस्तद्वचः श्रुत्वा शर्यातिर्जातसाध्वसः।\nमुनिं प्रसादयामास वल्मीकान्तर्हितं शनैः॥ ९/४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.009.m4a", "display_order": 10}, {"id": 6000179010, "chapter_id": 10179, "verse_number": "९-४-९", "content_sanskrit": "तदभिप्रायमाज्ञाय प्रादाद् दुहितरं मुनेः।\nकृच्छ्रान्मुक्तस्तमामन्त्र्य पुरं प्रायात् सहानुगः॥ ९/४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.010.m4a", "display_order": 11}, {"id": 6000179011, "chapter_id": 10179, "verse_number": "९-४-१०", "content_sanskrit": "सुकन्या च्यवनं प्राप्य पतिं परमकोपनम्।\nप्रीणयामास चित्तज्ञा अप्रमत्ताऽनुवृत्तिभिः॥ ९/४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.011.m4a", "display_order": 12}, {"id": 6000179012, "chapter_id": 10179, "verse_number": "९-४-११", "content_sanskrit": "कस्यचित् त्वथ कालस्य नासत्यावाश्रमं गतौ।\nतौ पूजयित्वा प्रोवाच वयो मे दत्तमीश्वरौ॥ ९/४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.012.m4a", "display_order": 13}, {"id": 6000179013, "chapter_id": 10179, "verse_number": "९-४-१२", "content_sanskrit": "ग्रहं ग्रहीष्ये सोमस्य यज्ञे वामप्यसोमयोः।\nक्रियतां मे वयो रूपं प्रमदानां यदीप्सितम्॥ ९/४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.013.m4a", "display_order": 14}, {"id": 6000179014, "chapter_id": 10179, "verse_number": "९-४-१३", "content_sanskrit": "बाढमित्यूचतुर्विप्रमभिनन्द्य भिषक्तमौ।\nनिमज्‍जतां भवानस्मिन् ह्रदे सिद्धविनिर्मिते॥ ९/४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.014.m4a", "display_order": 15}, {"id": 6000179015, "chapter_id": 10179, "verse_number": "९-४-१४", "content_sanskrit": "इत्युक्तो जरया ग्रस्तदेहो धमनिसन्ततः।\nह्रदं प्रवेशितोऽश्विभ्यां स्वयं चामज्जतां हृदे॥ ९/४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.015.m4a", "display_order": 16}, {"id": 6000179016, "chapter_id": 10179, "verse_number": "९-४-१५", "content_sanskrit": "पुरुषास्‍त्रय उत्तस्थुरापीच्या वनिताप्रियाः।\nरुग्मस्रजः कुण्डलिनस्तुल्यरूपाः सुवाससः॥ ९/४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.016.m4a", "display_order": 17}, {"id": 6000179017, "chapter_id": 10179, "verse_number": "९-४-१६", "content_sanskrit": "तान्निरीक्ष्य वरारोहा सरूपान् सूर्यवर्चसः।\nअजानती पतिं साध्वी अश्विनौ शरणं ययौ॥ ९/४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.017.m4a", "display_order": 18}, {"id": 6000179018, "chapter_id": 10179, "verse_number": "९-४-१७", "content_sanskrit": "दर्शयित्वा पतिं तस्यै पातिव्रत्येन तोषितौ।\nऋषिमामन्त्र्य ययतुर्विमानेन त्रिविष्टपम्॥ ९/४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.018.m4a", "display_order": 19}, {"id": 6000179019, "chapter_id": 10179, "verse_number": "९-४-१८", "content_sanskrit": "यक्ष्यमाणोऽथ शर्यातिश्च्यवनस्याश्रमं गतः।\nददर्श दुहितुः पार्श्वे पुरुषं सूर्यवर्चसम्॥ ९/४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.019.m4a", "display_order": 20}, {"id": 6000179020, "chapter_id": 10179, "verse_number": "९-४-१९", "content_sanskrit": "राजा दुहितरं प्राह कृतपादाभिवन्दनाम्।\nआशिषश्चाप्रयुञ्जानो नातिप्रीतमना इव॥ ९/४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.020.m4a", "display_order": 21}, {"id": 6000179021, "chapter_id": 10179, "verse_number": "९-४-२०", "content_sanskrit": "चिकीर्षितं ते किमिदं पतिस्त्वया प्रलम्भितो लोकनमस्कृतो मुनिः।\nया त्वं जराग्रस्तमसत्यसम्मतं विहाय जारं भजसेऽमुमध्वगम्॥ ९/४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.021.m4a", "display_order": 22}, {"id": 6000179022, "chapter_id": 10179, "verse_number": "९-४-२१", "content_sanskrit": "कथं मतिस्तेऽम्ब गताऽन्यथाऽसतां मार्गं त्वियं मत्कुलदूषणं त्विदम्।\nबिभर्षि जारं यदपत्रपा कुलं पितुश्च भर्तुश्च नयस्यधस्तमः॥ ९/४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.022.m4a", "display_order": 23}, {"id": 6000179023, "chapter_id": 10179, "verse_number": "९-४-२२", "content_sanskrit": "एवं ब्रुवाणं पितरं स्मयमाना शुचिस्मिता।\nउवाच तात जामाता तवैष भृगुनन्दनः॥ ९/४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.023.m4a", "display_order": 24}, {"id": 6000179024, "chapter_id": 10179, "verse_number": "९-४-२३", "content_sanskrit": "शशंस पित्रे तत्सर्वं वयोरूपाभिलम्भनम्।\nविस्मितः परमप्रीतस्तनयां परिषस्वजे॥ ९/४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.024.m4a", "display_order": 25}, {"id": 6000179025, "chapter_id": 10179, "verse_number": "९-४-२४", "content_sanskrit": "सोमेन याजयन् वीरः ग्रहं सोमस्य चाग्रहीत्।\nअसोमयोरप्यश्विनोश्च्यवनः स्वेन तेजसा॥ ९/४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.025.m4a", "display_order": 26}, {"id": 6000179026, "chapter_id": 10179, "verse_number": "९-४-२५", "content_sanskrit": "हन्तुं तमाददे वज्र सद्योमन्युरमर्षितः।\nसवज्रं स्तम्भयामास भुजमिन्द्रस्य भार्गवः॥ ९/४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.026.m4a", "display_order": 27}, {"id": 6000179027, "chapter_id": 10179, "verse_number": "९-४-२६", "content_sanskrit": "अन्वजानंस्ततः सर्वे ग्रहं सोमस्य चाश्विनोः।\nभिषजाविति यत् पूर्वं सोमाहुत्या बहिष्कृतौ॥ ९/४/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.027.m4a", "display_order": 28}, {"id": 6000179028, "chapter_id": 10179, "verse_number": "९-४-२७", "content_sanskrit": "उत्तानबर्हिरानर्तो भूरिषेण इति त्रयः।\nशर्यातेरभवन् पुत्रा आनर्ताद् रेवतोऽभवत्॥ ९/४/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.028.m4a", "display_order": 29, "topics": [{"text": "शर्यातिप्रपौत्रस्य ककुद्मिनस्तत्पुत्र्या रेवत्याश्च कथा", "range": "२७–३७"}]}, {"id": 6000179029, "chapter_id": 10179, "verse_number": "९-४-२८", "content_sanskrit": "सोऽन्तःसमुद्रे नगरीं विनिर्माय कुशस्थलीम्।\nआस्थितोऽभुङ्क्त विषयानानर्तादीनरिन्दम॥ ९/४/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.029.m4a", "display_order": 30}, {"id": 6000179030, "chapter_id": 10179, "verse_number": "९-४-२९", "content_sanskrit": "तस्य पुत्रशतं जज्ञे ककुद्मिज्येष्ठमुत्तमम्।\nककुद्मी रेवतीं कन्यां स्वामादाय विभुं गतः॥ ९/४/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.030.m4a", "display_order": 31}, {"id": 6000179031, "chapter_id": 10179, "verse_number": "९-४-३०", "content_sanskrit": "पुत्र्या वरं परिप्रष्टुं ब्रह्मलोकमपावृतम्।\nआवर्तमाने गान्धर्वे स्थितोऽलब्धक्षणः क्षणम्॥ ९/४/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.031.m4a", "display_order": 32}, {"id": 6000179032, "chapter_id": 10179, "verse_number": "९-४-३१", "content_sanskrit": "तदन्ते विभुमानम्य स्वाभिप्रायं न्यवेदयत्।\nतच्छ्रुत्वा भगवान् ब्रह्मा प्रहस्य तमुवाच ह॥ ९/४/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.032.m4a", "display_order": 33}, {"id": 6000179033, "chapter_id": 10179, "verse_number": "९-४-३२", "content_sanskrit": "अहो राजन् निरुद्धास्ते कालेन हृदि ये कृताः।\nतत्पुत्रपौत्रनप्तॄणां गोत्राणि च न शृृण्महे॥ ९/४/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.033.m4a", "display_order": 34}, {"id": 6000179034, "chapter_id": 10179, "verse_number": "९-४-३३", "content_sanskrit": "मुहूर्तं शृण्वतोऽश्राव्यं प्रतियातस्य तेऽनघ।\nकालो यातस्‍त्रिनवभिः चतुर्युगविकल्पितः॥ ९/४/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.034.m4a", "display_order": 35}, {"id": 6000179035, "chapter_id": 10179, "verse_number": "९-४-३४", "content_sanskrit": "तद् गच्छ देवदेवांशो बलदेवो महाबलः।\nकन्यारत्नमिदं राजन् नररत्नाय देहि भो॥ ९/४/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.035.m4a", "display_order": 36}, {"id": 6000179036, "chapter_id": 10179, "verse_number": "९-४-३५", "content_sanskrit": "भुवो भारावताराय भगवान् भूतभावनः।\nअवतीर्णो निजांशेन पुण्यश्रवणकीर्तनः॥ ९/४/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.036.m4a", "display_order": 37}, {"id": 6000179037, "chapter_id": 10179, "verse_number": "९-४-३६", "content_sanskrit": "इत्यादिष्टोऽभिवन्द्याजं नृपः स्वपुरमागतः।\nत्यक्तां पुण्यजनत्रासाद् भ्रातृभिर्दिक्ष्ववस्थितैः॥ ९/४/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.037.m4a", "display_order": 38}, {"id": 6000179038, "chapter_id": 10179, "verse_number": "९-४-३७", "content_sanskrit": "सुतां दत्त्वाऽनवद्याङ्गीं बलाय बलशालिने।\nबदर्याख्यं ययौ राजा तप्तुं नारायणाश्रमम्॥ ९/४/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_004/BhP_09.004.038.m4a", "display_order": 39}, {"id": 6000179039, "chapter_id": 10179, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां नवमस्कन्धे चतुर्थाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]