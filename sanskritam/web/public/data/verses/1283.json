[{"id": 2013726, "chapter_id": 1283, "verse_number": "२-२४-१", "content_sanskrit": "ततस्तं निश्चितात्मानं युद्धाय यदुनन्दनः।\nउवाच वाग्मी राजानं जरासन्धमधोक्षजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2013727, "chapter_id": 1283, "verse_number": "२-२४-२", "content_sanskrit": "त्रयाणां केन ते राजन्योद्धुमुत्सहते मनः।\nअस्मदन्यतमेनेह सज्जीभवतु को युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2013728, "chapter_id": 1283, "verse_number": "२-२४-३", "content_sanskrit": "एवमुक्तः स नृपतिर्युद्धं वव्रे महाद्युतिः।\nजरासन्धस्ततो राजा भीमसेनेन मागधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2013729, "chapter_id": 1283, "verse_number": "२-२४-४", "content_sanskrit": "धारयन्तं गदां दिव्यां बलं श्रुत्वा च निर्वृतः।\nअर्जुन वासुदेवं च वजर्यित्वा स मागधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2013730, "chapter_id": 1283, "verse_number": "२-२४-५", "content_sanskrit": "मत्वा देवं गोप इति बालोऽर्जुन इति स्म ह।\nआदाय रोजनां माल्यं मङ्गल्यान्यपराणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2013731, "chapter_id": 1283, "verse_number": "२-२४-६", "content_sanskrit": "धारयन्नगदान्मुख्यान्निर्वृतीर्वेदनानि च।\nउपतस्थे जरासन्धं युयुत्सुं वै पुरोहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2013732, "chapter_id": 1283, "verse_number": "२-२४-७", "content_sanskrit": "कृतस्वस्त्ययनो राजा ब्राह्मणेन यशस्विना।\nसमनह्यज्जरासन्धः क्षात्रं धर्ममनुस्मरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2013733, "chapter_id": 1283, "verse_number": "२-२४-८", "content_sanskrit": "अवमुच्य किरीटं स केशान्समनुमृज्य च।\nउदतिष्ठज्जरासन्धो वेलातिग इवार्णवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2013734, "chapter_id": 1283, "verse_number": "२-२४-९", "content_sanskrit": "उवाच मतिमान्राजा भीमं भीमपराक्रमः।\nभीम योत्स्ये त्वया सार्धं श्रेयसा निर्जितं वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2013735, "chapter_id": 1283, "verse_number": "२-२४-१०", "content_sanskrit": "एवमुक्त्वा जरासन्धो भीमसेनमरिन्दमः।\nप्रत्युद्ययौ महातेजाः शक्रं बल इवासुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2013736, "chapter_id": 1283, "verse_number": "२-२४-११", "content_sanskrit": "ततः संमन्त्र्य कृष्णेन कृतस्वस्त्ययनो बली।\nभीमसेनो जरासन्धमाससाद युयुत्सया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2013737, "chapter_id": 1283, "verse_number": "२-२४-१२", "content_sanskrit": "ततस्तौ नरशार्दूलौ बाहुशस्त्रौ समीयतुः।\nवीरौ परमसंहृष्टावन्योन्यजयकाङ्क्षिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2013738, "chapter_id": 1283, "verse_number": "२-२४-१३", "content_sanskrit": "करग्रहणपूर्वं तु कृत्वा पादाभिवन्दनम्।\nकक्षैः कक्षां विधुन्वानावास्फोटं तत्र चक्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2013739, "chapter_id": 1283, "verse_number": "२-२४-१४", "content_sanskrit": "स्कन्धे दोर्भ्यां समाहत्य निहत्य च मुहुर्मुहुः।\nअङ्गमङ्गैः समाश्लिष्य पुनरास्फालनं च चक्रतुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2013740, "chapter_id": 1283, "verse_number": "२-२४-१५", "content_sanskrit": "चित्रहस्तादिकं कृत्वा सस्फुलिङ्गेन चाशनिम्॥\nगलगण्डाभिघातेन सस्फुलिङ्गेन चाशनिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2013741, "chapter_id": 1283, "verse_number": "२-२४-१६", "content_sanskrit": "बाहुपाशादिकं कृत्वा पादाहतशिरावुभौ।\nउरोहस्तं ततश्चक्रे पूर्णकुम्भौ प्रयुज्य तौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2013742, "chapter_id": 1283, "verse_number": "२-२४-१७", "content_sanskrit": "करसम्पीडनं कृत्वा गर्जन्तौ वारणाविव।\nनर्दन्तौ मेघसङ्काशौ बाहुप्रहरणावुभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2013743, "chapter_id": 1283, "verse_number": "२-२४-१८", "content_sanskrit": "तलेनाहन्यमानौ तु अन्योन्यं कृतवीक्षणौ।\nसिंहाविव सुसंङ्क्रुद्धावाकृष्याकृष्य युध्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2013744, "chapter_id": 1283, "verse_number": "२-२४-१९", "content_sanskrit": "अङ्गेनाङ्गं समापीड्य बाहुभ्यामुभयोरपि।\nआवृत्य बाहुभिश्चापि उदरं च प्रचक्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2013745, "chapter_id": 1283, "verse_number": "२-२४-२०", "content_sanskrit": "उभौ कट्यां सुपार्श्वे तु तक्षवन्तौ च शिक्षितौ।\nअधो हस्तं स्वकण्ठे तूदरस्योरसि चाक्षिपत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2013746, "chapter_id": 1283, "verse_number": "२-२४-२१", "content_sanskrit": "सर्वातिक्रान्तमर्यादं पृष्ठभङ्गं च चक्रतुः।\nसम्पूर्णमूर्च्छां बाहुभ्यां पूर्णकुम्भं प्रचक्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2013747, "chapter_id": 1283, "verse_number": "२-२४-२२", "content_sanskrit": "तृणपीडं यथाकामं पूर्णयोगं समुष्टिकम्।\nएवमादीनि युद्धानि प्रकुर्वन्तौ परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2013748, "chapter_id": 1283, "verse_number": "२-२४-२३", "content_sanskrit": "तयोर्युद्धं ततो द्रष्टुं समेताः पुरवासिनाः।\nब्राह्मणा वणिजश्चैव क्षत्रियाश्च सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2013749, "chapter_id": 1283, "verse_number": "२-२४-२४", "content_sanskrit": "शूद्राश्च नरशार्दूल स्त्रियो वृद्धाश्च सर्वशः।\nनिरन्तरमभूत्तत्र जनौघैरभिसंवृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2013750, "chapter_id": 1283, "verse_number": "२-२४-२५", "content_sanskrit": "तयोरथ भुजाघातान्निग्रहप्रग्रहात्तथा।\nआसीत्सुभीमसम्पातो वज्रपर्वतयोरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2013751, "chapter_id": 1283, "verse_number": "२-२४-२६", "content_sanskrit": "उभौ परमसंहृष्टौ बलेन बलिनां वरौ।\nअन्योन्यस्यान्तरं प्रेप्सू परस्परजयैषिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2013752, "chapter_id": 1283, "verse_number": "२-२४-२७", "content_sanskrit": "शिरोभिरिव तौ मेषौ वृक्षैरिव निशाचरौ।\nपदैरिव शुभावश्वौ तुण्डाभ्यां तित्तिरी इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2013753, "chapter_id": 1283, "verse_number": "२-२४-२८", "content_sanskrit": "तद्भीममुत्सार्य जनं युद्धमासीदुपप्लवे।\nबलिनोः संयुगे राजन्वृत्रवासवयोरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2013754, "chapter_id": 1283, "verse_number": "२-२४-२९", "content_sanskrit": "प्रकर्षणाकर्षणाभ्यामनुकर्षविकर्षणैः।\nआचकर्षतुरन्योन्यं जानुभिश्चावजघ्नतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2013755, "chapter_id": 1283, "verse_number": "२-२४-३०", "content_sanskrit": "ततः शब्देन महता भर्त्सयन्तौ परस्परम्।\nपाषाणसङ्घातनिभैः प्रहारैरभिजघ्नतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2013756, "chapter_id": 1283, "verse_number": "२-२४-३१", "content_sanskrit": "ततो भीमं जरासन्धो जघानोरसि मुष्टिना।\nभीमोषि तं जरासन्धं वक्षस्यभिजघान ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2013757, "chapter_id": 1283, "verse_number": "२-२४-३२", "content_sanskrit": "व्यूढोरस्कौ दीर्घभुजौ नियुद्धकुशलावुभौ।\nबाहुभिः समसज्जोतामायसैः परिघैरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2013758, "chapter_id": 1283, "verse_number": "२-२४-३३", "content_sanskrit": "कार्तिकस्य तु मासस्य प्रवृत्तं प्रथमेऽहनि।\nतदा तद्युद्धमभवद्दिनानि दश पञ्च च।\nअनाहारं दिवारात्रमविश्रान्तमवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2013759, "chapter_id": 1283, "verse_number": "२-२४-३४", "content_sanskrit": "तद्वृत्तं तु त्रयोदश्यां समवेतं महात्मनोः।\nचतुर्दश्यां निशायां तु निवृत्तो मागधः क्लमात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2013760, "chapter_id": 1283, "verse_number": "२-२४-३५", "content_sanskrit": "तं राजानं तथा क्लान्तं दृष्ट्वा राजञ्जनार्दनः।\nउवाच भीमकर्माणं भीमं सम्बोधयन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2013761, "chapter_id": 1283, "verse_number": "२-२४-३६", "content_sanskrit": "क्लान्तः शत्रुर्हि कौन्तेय शक्यः पीडयितुं रणे।\nपीड्यमानो हि कार्त्स्न्येन जह्याज्जीवितमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2013762, "chapter_id": 1283, "verse_number": "२-२४-३७", "content_sanskrit": "तस्मात्तेऽद्यैव कौन्तेय पीडनीयो जनाधिपः।\nसममेतेन युध्यस्व बाहुभ्यां भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2013763, "chapter_id": 1283, "verse_number": "२-२४-३८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2013764, "chapter_id": 1283, "verse_number": "२-२४-३८", "content_sanskrit": "एवमुक्तःस कृष्णेन पाण्डवः परवीरहा।\nजरासन्दस्य तद्रन्ध्रं ज्ञात्वा चक्रे मतिं वधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2013765, "chapter_id": 1283, "verse_number": "२-२४-३९", "content_sanskrit": "ततस्तमजितं जेतुं जरासन्दं वृकोदरः।\nसंरम्भाद्बलिनां श्रेष्ठो जग्राह कुरुनन्दनः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2013766, "chapter_id": 1283, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि जरासन्धवधपर्वणि चतुर्विशोऽध्यायः॥ २४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]