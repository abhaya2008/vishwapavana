[{"id": 7002666000, "chapter_id": 22666, "verse_number": "७-९-१", "content_sanskrit": "सूत उवाच ।\nकालियं तौ पराजित्य भ्रातरौ नृपसेवकौ ।\nगतौ गोपालके राष्ट्रे भूपतिर्दलवाहनः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002666001, "chapter_id": 22666, "verse_number": "७-९-२", "content_sanskrit": "सहस्रचंडिकाहोमे नानाभूपसमागमे ।\nगृहीतौ महिषौ ताभ्यां भूपैरन्यैश्च दुर्जयौ ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002666002, "chapter_id": 22666, "verse_number": "७-९-३", "content_sanskrit": "पूर्वं हि नृपकन्याभ्यां प्रत्यहं बंधनं गतौ ।\nतौ संपूज्य विधानेन ददौ ताभ्यां च कन्यके ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002666003, "chapter_id": 22666, "verse_number": "७-९-४", "content_sanskrit": "देवकीं देशराजाय ब्राह्मीं तस्यानुजाय वै ।\nददौ दुर्गाज्ञया राजा रूपयौवनशालि नीम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002666004, "chapter_id": 22666, "verse_number": "७-९-५", "content_sanskrit": "लक्षावृत्तिं तथा वेश्यां गीतनृत्यविशारदाम् ।\nकन्ययोश्च सखीं रम्यां मेघमल्लाररागिणीम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002666005, "chapter_id": 22666, "verse_number": "७-९-६", "content_sanskrit": "शतं गजान्रथान्पंच हयांश्चैव सहस्रकान् ।\nचत्वारिंशच्च शिबिकाः प्रददौ दलवाहनः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002666006, "chapter_id": 22666, "verse_number": "७-९-७", "content_sanskrit": "बहुद्रव्ययुतां कन्यां दासदासीसमन्विताम् ।\nउदूह्य वेदविधिना प्रापतुश्च महावतीम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002666007, "chapter_id": 22666, "verse_number": "७-९-८", "content_sanskrit": "मलना तां वधूं दृष्ट्वा तस्यै ग्रैवेयकं ददौ ।\nब्राह्म्यै षोडशशृंगारं तथा द्वादशभूषणम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002666008, "chapter_id": 22666, "verse_number": "७-९-९", "content_sanskrit": "राजा च परमानन्दी देशराजाय शूरिणे ।\nददौ दशपुरं रम्यं नानाजननिषेवितम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002666009, "chapter_id": 22666, "verse_number": "७-९-१०", "content_sanskrit": "ऊषतुस्तत्र तौ वीरौ राजमान्यौ महाबलौ ।\nएतस्मिन्नन्तरे जातो देवसिंहो हराज्ञया ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002666010, "chapter_id": 22666, "verse_number": "७-९-११", "content_sanskrit": "जाते तस्मिन्कुमारे तु देवकी गर्भमादधौ ।\nदासश्रुता पतेर्देवी सुषुवे पुत्रमूर्जितम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002666011, "chapter_id": 22666, "verse_number": "७-९-१२", "content_sanskrit": "गौरांगं कमलाक्षं च दीप्यमानं स्वतेजसा ।\nतदानंदमयो देवः शक्रः सुरगणैः सह ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002666012, "chapter_id": 22666, "verse_number": "७-९-१३", "content_sanskrit": "शंखशब्दं चकारोच्चैर्जयशब्दं पुनःपुनः ।\nदिशः प्रफुल्लिताश्चासन्ग्रहाः सर्वे तथा दिवि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002666013, "chapter_id": 22666, "verse_number": "७-९-१४", "content_sanskrit": "आयाता बहवो विप्रा वेदशास्त्रपरायणाः ।\nचक्रुस्ते जातकर्मास्य नामकर्म तथाविधम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002666014, "chapter_id": 22666, "verse_number": "७-९-१५", "content_sanskrit": "रामांशं तं शिशुं ज्ञात्वा प्रसन्नवदनं शुभम् ।\nभाद्रकृष्णतिथौ षष्ठ्यां चन्द्रवारेऽरुणोदये ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002666015, "chapter_id": 22666, "verse_number": "७-९-१६", "content_sanskrit": "संजातः कृत्तिकाभे च पितृवंशयशस्करः ।\nआह्लादनाम्ना ह्यभवत्प्रश्रितश्च महीतले ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002666016, "chapter_id": 22666, "verse_number": "७-९-१७", "content_sanskrit": "मासान्ते च सुते जाते ब्राह्मी पुत्रमजीजनत् ।\nधर्मजांशं तथा गौरं महाबाहुं सुवक्षसम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002666017, "chapter_id": 22666, "verse_number": "७-९-१८", "content_sanskrit": "तदा च ब्राह्मणाः सर्वे दृष्ट्वा बालं शुभाननम् ।\nप्रसन्नवदनं चारुं पद्मचिह्नपदस्थितम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002666018, "chapter_id": 22666, "verse_number": "७-९-१९", "content_sanskrit": "तैर्द्विजैश्च कृतो नाम्ना बलखानिर्महाबलः ।\nवर्षान्ते वत्सजे जातं मूलगंडान्तसंभवः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002666019, "chapter_id": 22666, "verse_number": "७-९-२०", "content_sanskrit": "चामुण्डो देवकिसुतो निजवंशभयंकरः ।\nजनितारं ततस्त्याज्य इत्यूचुर्द्विजसत्तमाः ।\nन तत्याज सुतं राजा बालत्वेऽपि दयापरः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002666020, "chapter_id": 22666, "verse_number": "७-९-२१", "content_sanskrit": "त्रिवर्षांते गते तस्मिन्बलखानौ सुते शुभे ।\nशूद्र्यां जातः शिखंडयंशो रूपणो नाम विश्रुतः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002666021, "chapter_id": 22666, "verse_number": "७-९-२२", "content_sanskrit": "वत्सराजो ययौ देशे गुर्जरे च मदालसाम् ।\nस सुतां च समादाय दिने तस्मिन्समागतः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002666022, "chapter_id": 22666, "verse_number": "७-९-२३", "content_sanskrit": "प्राप्ते तस्मिन्वत्सराजे जम्बुकः स्वबलैर्वृतः ।\nसप्तलक्षैश्च संप्राप्तो बाहुशाली यतेंद्रियः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002666023, "chapter_id": 22666, "verse_number": "७-९-२४", "content_sanskrit": "रुरोध नगरीं सर्वां राज्ञः परिमलस्य वै ।\nत्रिलक्षैश्च माहावत्यै सार्द्धं तौ जग्मतुः पुरात् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002666024, "chapter_id": 22666, "verse_number": "७-९-२५", "content_sanskrit": "माहिष्मतैः सप्तलक्षैः सार्द्धं युद्धमभून्महत् ।\nत्रिरात्रं दारुणं घोरं यमराष्ट्रविवर्द्धनम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002666025, "chapter_id": 22666, "verse_number": "७-९-२६", "content_sanskrit": "शिवस्य वरदानेन भ्रात्रोर्जातः पराजयः ।\nबद्ध्वा तौ जम्बुको राजा लुंठयित्वा महावतीम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002666026, "chapter_id": 22666, "verse_number": "७-९-२७", "content_sanskrit": "वेश्यां लक्षारतिं तस्य तं हतं तद्गजं तथा ।\nग्रैवेयकं तथा हारं मणिरत्नविभूषितम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002666027, "chapter_id": 22666, "verse_number": "७-९-२८", "content_sanskrit": "गृहीत्वा नगरीं सर्वां भस्मयित्वा गृहं ययौ ।\nये गुप्ता भूतले शूरास्ते शेषाश्च तदाऽभवन् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002666028, "chapter_id": 22666, "verse_number": "७-९-२९", "content_sanskrit": "दुर्गेषु यानि रत्नानि तानि प्राप्य मुदा ययौ ।\nलुंठिते नगरे तस्मिन्देवकी गर्भमुत्तमम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002666029, "chapter_id": 22666, "verse_number": "७-९-३०", "content_sanskrit": "कृष्णांशं सप्तमास्यं हि चादधाद्दैवतप्रिया ।\nज्ञात्वा कुलाधमं पुत्रं चामुंडं देवकी सती ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002666030, "chapter_id": 22666, "verse_number": "७-९-३१", "content_sanskrit": "कल्पक्षेत्रं समागम्य कालिंद्यां तमपातयत् ।\nयोजनान्ते गते तस्मित्महीराजपुरोहितः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002666031, "chapter_id": 22666, "verse_number": "७-९-३२", "content_sanskrit": "सामन्तो नाम तं गृह्य श्वशुरालयमाययौ ।\nजातस्तु दशमासान्ते रात्रौ घोरतमोवृते ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002666032, "chapter_id": 22666, "verse_number": "७-९-३३", "content_sanskrit": "भाद्रकृष्णाष्टमीसौम्ये ब्राह्मनक्षत्रसंयुते ।\nप्रादुरासीज्जगन्नाथो देवक्यां च महोत्तमः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002666033, "chapter_id": 22666, "verse_number": "७-९-३४", "content_sanskrit": "श्यामांगः स च पद्माक्ष इंद्रनीलमणिद्युतिः ।\nविमानानां सहस्राणां प्रकाशः समजायत ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002666034, "chapter_id": 22666, "verse_number": "७-९-३५", "content_sanskrit": "विस्मिता जननी तत्र दृष्ट्वा बालं तमद्भुतम् ।\nनगरे च महाश्चर्यं जातं सर्वे समाययुः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002666035, "chapter_id": 22666, "verse_number": "७-९-३६", "content_sanskrit": "उदयः किमहो जातो देवानां सूर्यरूपकः ।\nइत्याश्चर्य्यजुजां तेषां वागुवाचाशरीरिणी ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002666036, "chapter_id": 22666, "verse_number": "७-९-३७", "content_sanskrit": "कृष्णांशो भूतले जातः सर्वानन्दप्रदायकः ।\nस नाम्नोदयसिंहो हि सर्वशत्रुप्रकाशहा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002666037, "chapter_id": 22666, "verse_number": "७-९-३८", "content_sanskrit": "इत्याकाशवचः श्रुत्वा ते परं हर्ष माययुः ।\nयस्मिन्काले सुतो जातस्तदा च मलना सती ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002666038, "chapter_id": 22666, "verse_number": "७-९-३९", "content_sanskrit": "श्यामांगं सुन्दरं बालं सर्वलक्षणलक्षितम् ।\nसुषुवे परमोदारं फाल्गुनांशं शिवाज्ञया ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002666039, "chapter_id": 22666, "verse_number": "७-९-४०", "content_sanskrit": "तदा तु नगरी सर्वा हर्षभूता बभूव ह ।\nषष्ठाहनि सुते जाते ब्रह्मानन्दगुणाकरे ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002666040, "chapter_id": 22666, "verse_number": "७-९-४१", "content_sanskrit": "ब्राह्मी तु सुषुवे पुत्रं पार्षदांशं महाबलम् ।\nश्यामांगं कमलाक्षं च दृढस्कन्धं महाभुजम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002666041, "chapter_id": 22666, "verse_number": "७-९-४२", "content_sanskrit": "ब्राह्मणाश्च तदागत्य जातकर्म ह्यकारयन् ।\nसुखखानिर्द्विजैर्नाम्ना कृतस्तु गणकोत्तमैः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002666042, "chapter_id": 22666, "verse_number": "७-९-४३", "content_sanskrit": "क्रमेण वर्द्धिता बालाः सर्वलोकशिवंकराः ।\nतेषां काली महच्छ्रेष्ठा पितृमातृप्रियंकरी ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002666043, "chapter_id": 22666, "verse_number": "७-९-४४", "content_sanskrit": "तृतीयाब्दे वयः प्राप्ते कृष्णांशे बलवत्तरे ।\nशक्रस्तद्दर्शनकांक्षी हयारूढो जगाम ह ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002666044, "chapter_id": 22666, "verse_number": "७-९-४५", "content_sanskrit": "क्रीडन्स चन्दनारण्ये कृष्णांशो भ्रातृभिः सह ।\nनभस्थं पुरुषं दृष्ट्वा सहस्राक्षं जहास वै ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002666045, "chapter_id": 22666, "verse_number": "७-९-४६", "content_sanskrit": "अश्विनी हरिणी दिव्या उच्चैःश्रवसमन्तिके ।\nगत्वा गर्भमुपादाय स्वगेहं पुनराययौ ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002666046, "chapter_id": 22666, "verse_number": "७-९-४७", "content_sanskrit": "वर्षांतरे च सुषुवे कपोतं तनयं शुभम् ।\nपञ्चाब्दं च समायाते विद्याध्यनमास्थिताः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002666047, "chapter_id": 22666, "verse_number": "७-९-४८", "content_sanskrit": "ब्राह्मणं शिवशर्माणं सर्वविद्याविशारदम् ।\nस्वभक्त्या सेवनं कृत्वा ते चक्रुर्वेदपाठिकाम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002666048, "chapter_id": 22666, "verse_number": "७-९-४९", "content_sanskrit": "अष्टाब्दे चैव कृष्णांशो नामपत्रादिकां क्रियाम् ।\nलिखतां बालकानां च कृष्णांशः श्रेष्ठतामगात् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]