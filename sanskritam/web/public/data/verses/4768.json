[{"id": 2178232, "chapter_id": 4768, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2178233, "chapter_id": 4768, "verse_number": "१", "content_sanskrit": "हतेषु सर्वसैन्येषु पाण्डुपुत्रो युधिष्ठिरः ।\nशुश्रुवे पितरं वृद्धं निर्यान्तं गजसाह्वयात्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2178234, "chapter_id": 4768, "verse_number": "२", "content_sanskrit": "सोऽभ्ययात् पुत्रशोकार्तं पुत्रशोकपरिप्लुतः ।\nशोचमानो महाराज भ्रातृभिः सहितस्ततः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2178235, "chapter_id": 4768, "verse_number": "३", "content_sanskrit": "अन्वीयमानो वीरेण दाशार्हेण महात्मना ।\nयुयुधानेन च तथा तथैव च युयुत्सुना\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2178236, "chapter_id": 4768, "verse_number": "४", "content_sanskrit": "तमन्वयात् सुदुःखार्ता द्रौपदी शोककर्शिता ।\nसह पाञ्चालयोषिद्भिः यास्तत्रासन् समागताः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2178237, "chapter_id": 4768, "verse_number": "५", "content_sanskrit": "सङ्ग्राममनु बृन्दानि स्त्रीणां भरतसत्तम ।\nकुररीणामिवार्तानां क्रोशन्तीनां ददर्श ह\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2178238, "chapter_id": 4768, "verse_number": "६", "content_sanskrit": "ताभिः परिवृतो राजा रुदन्तीभिः समन्ततः ।\nऊर्ध्वबाहुभिरार्ताभिः ब्रुवन्तीभिः प्रियाप्रिये\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2178239, "chapter_id": 4768, "verse_number": "", "content_sanskrit": "स्त्रियः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2178240, "chapter_id": 4768, "verse_number": "७", "content_sanskrit": "धर्मस्ते क्व नु धर्मज्ञ क्व नु साऽद्यानृशंसता ।\nयथाऽवधीः पितॄन् भ्रातॄन् गुरून् पुत्रान् सखीनपि\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2178241, "chapter_id": 4768, "verse_number": "८", "content_sanskrit": "घातयित्वा कथं द्रोणं भीष्मं चापि पितामहम् ।\nमनस्तेऽभून्महाराज हत्वा चापि जयद्रथम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2178242, "chapter_id": 4768, "verse_number": "९", "content_sanskrit": "किं नु राज्येन ते कार्यं पितॄन् भ्रातॄनपश्यतः ।\nअभिमन्युं च दुर्धर्षं द्रौपदेयांश्च भारत\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2178243, "chapter_id": 4768, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2178244, "chapter_id": 4768, "verse_number": "१०", "content_sanskrit": "अतीत्य ताः महाराज क्रोशन्तीः कुररीरिव ।\nववन्दे पितरं ज्येष्ठं धर्मराजो युधिष्ठिरः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2178245, "chapter_id": 4768, "verse_number": "११", "content_sanskrit": "ततोऽभिवाद्य पितरं क्रमेणामित्रकर्शनाः ।\nन्यवेदयन्त नामानि पाण्डवास्तेऽपि सर्वशः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2178246, "chapter_id": 4768, "verse_number": "१२", "content_sanskrit": "तमात्मजान्तकरणं पिता पुत्रवधार्दितः ।\nअप्रीयमाणः शोकार्तः पाण्डवं परिषस्वजे\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2178247, "chapter_id": 4768, "verse_number": "१३", "content_sanskrit": "धर्मराजं परिष्वज्य सान्त्वयित्वा च भारत ।\nदुष्टात्मा भीममन्वैच्छद् दिधक्षुरिव पावकः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2178248, "chapter_id": 4768, "verse_number": "१४", "content_sanskrit": "स कोपपावकस्तस्य शोकवायुसमीरितः ।\nभीमसेनमयं दावं दिदृक्षुरिव दृश्यते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2178249, "chapter_id": 4768, "verse_number": "१५", "content_sanskrit": "तस्य सङ्कल्पमाज्ञाय भीमं प्रत्यशुभं हरिः ।\nभीममाक्षिप्य पाणिभ्यां प्रददौ भीममायसम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2178250, "chapter_id": 4768, "verse_number": "१६", "content_sanskrit": "प्रागेव तु महाबाहुर्बुद्ध्वा तस्येङ्गितं हरिः ।\nसंविधानं महाप्राज्ञस्तत्र चक्रे जनार्दनः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2178251, "chapter_id": 4768, "verse_number": "१७", "content_sanskrit": "उपगृह्यैव बाहुभ्यां राजा स्तम्भमयोमयम् ।\nबभञ्ज बलवान् राजा मन्यमानो वृकोदरम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2178252, "chapter_id": 4768, "verse_number": "१८", "content_sanskrit": "नागायुतसमप्राणः स राजा भीममायसम् ।\nभङ्क्त्वा विमथितोरस्कः सुस्राव रुधिरं मुखात्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2178253, "chapter_id": 4768, "verse_number": "१९", "content_sanskrit": "ततः पपात मेदिन्यां तथैव रुधिरोक्षितः ।\nप्रपुष्पिताग्रशिखरः पारिजात इव द्रुमः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2178254, "chapter_id": 4768, "verse_number": "२०", "content_sanskrit": "पर्यगृह्णीत तं विद्वान् सूतो गावल्गणिस्तदा ।\nमैवमित्यब्रवीच्चैनं शमयन् सान्त्वयन्नपि\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2178255, "chapter_id": 4768, "verse_number": "२१", "content_sanskrit": "हतो भीम इति ज्ञात्वा गतमन्युर्महामनाः ।\nहा हा भीमेति चुक्रोश भूयः शोकसमन्वितः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2178256, "chapter_id": 4768, "verse_number": "२२", "content_sanskrit": "तं विदित्वा गतक्रोधं भीमसेनवधार्दितम् ।\nवासुदेवो वरं पुंसामिदं वचनमब्रवीत्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2178257, "chapter_id": 4768, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2178258, "chapter_id": 4768, "verse_number": "२३", "content_sanskrit": "मा शुचो धृतराष्ट्र त्वं नैव भीमस्त्वया हतः ।\nआयसी प्रतिमा ह्येषा त्वया राजन् निपातिता\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2178259, "chapter_id": 4768, "verse_number": "२४", "content_sanskrit": "त्वां क्रोधवशमापन्नं विदित्वा भरतर्षभ ।\nमयाऽपकृष्टः कौन्तेयो मृत्योर्दंष्ट्रान्तरं गतः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2178260, "chapter_id": 4768, "verse_number": "२५", "content_sanskrit": "न हि ते राजशार्दूल बले तुल्योऽस्ति कश्चन ।\nयः सहेत महाबाहो तव निग्रहणं नरः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2178261, "chapter_id": 4768, "verse_number": "२६", "content_sanskrit": "यथा हि नान्तकं प्राप्य जीवन् मुच्येत कश्चन ।\nएवं बाह्वन्तरं प्राप्य न जीवेदिह कश्चन\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2178262, "chapter_id": 4768, "verse_number": "२७", "content_sanskrit": "तस्मात् पुत्रेण ते या सा प्रतिमा कारिताऽऽयसी ।\nभीमस्य सेयं कौरव्य तवैवोपहृता मया\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2178263, "chapter_id": 4768, "verse_number": "२८", "content_sanskrit": "पुत्रशोकाभिसन्तापाद् धर्मादपहृतं मनः ।\nतव राजेन्द्र तेन त्वं भीमसेनं जिघांससि\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2178264, "chapter_id": 4768, "verse_number": "२९", "content_sanskrit": "न च ते तत् क्षमं राजन् हन्यास्त्वं यद् वृकोदरम् ।\nन हि पुत्रा महाराज जीवेयुस्ते कथञ्चन्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2178265, "chapter_id": 4768, "verse_number": "३०", "content_sanskrit": "तस्माद् यत् कृतमस्माभिर्मन्यमानैः क्षमं तव ।\nअनुमन्यस्व राजेन्द्र मा च शोके मनः कृथाः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2178266, "chapter_id": 4768, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां स्त्रीपर्वणि\nअयोमयभीमप्रतिमाभञ्जनं नाम द्वादशोऽध्यायः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2178267, "chapter_id": 4768, "verse_number": "", "content_sanskrit": "जलप्रदानपर्वणि द्वादशोऽध्यायः ॥१२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]