[{"id": 7004082000, "chapter_id": 24082, "verse_number": "४-३१-१", "content_sanskrit": "अगस्त्य उवाच ।\nसर्वज्ञ हृदयानंद स्कंदस्कंदित तारक ।\nन तृप्तिमधिगच्छामि शृण्वन्वाराणसीकथाम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004082001, "chapter_id": 24082, "verse_number": "४-३१-२", "content_sanskrit": "अनुग्रहो यदि मयि योग्योस्मि श्रवणे यदि ।\nतदा कथय मे नाथ काश्यां भैरव संकथाम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004082002, "chapter_id": 24082, "verse_number": "४-३१-३", "content_sanskrit": "कोसौ भैरवनामात्र काशिपुर्यां व्यवस्थितः ।\nकिं रूपमस्य किं कर्म कानि नामानि चास्य वै ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004082003, "chapter_id": 24082, "verse_number": "४-३१-४", "content_sanskrit": "कथमाराधितश्चैव सिद्धिदः साधकस्य वै ।\nआराधितः कुत्र काले क्षिप्रं सिद्ध्यति भैरवः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004082004, "chapter_id": 24082, "verse_number": "४-३१-५", "content_sanskrit": "स्कंद उवाच ।\nवाराणस्यां महाभाग यथा ते प्रेम वर्तते ।\nतथा न कस्यचिन्मन्ये ततो वक्ष्याम्यशेषतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004082005, "chapter_id": 24082, "verse_number": "४-३१-६", "content_sanskrit": "प्रादुर्भावं भैरवस्य महापातकनाशनम् ।\nयच्छ्रुत्वा काशिवासस्य फलं निर्विघ्रमाप्नुयात् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004082006, "chapter_id": 24082, "verse_number": "४-३१-७", "content_sanskrit": "पाणिभ्यां परितः प्रपीड्य सुदृढं निश्चोत्य निश्चोत्य च ब्रह्मांडं सकलं पचेलिमरसालोच्चैः फलाभं मुहुः ।\nपायंपायमपायतस्त्रिजगतीमुन्मत्तवत्तै रसैर्नृत्यंस्तांडवडंबरेण विधिनापायान्महाभैरवः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004082007, "chapter_id": 24082, "verse_number": "४-३१-८", "content_sanskrit": "कुंभयोने न वेत्त्येव महिमानं महेशितुः ।\nचतुर्भजोपि वैकुंठश्चतुर्वक्त्रोपि विश्वकृत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004082008, "chapter_id": 24082, "verse_number": "४-३१-९", "content_sanskrit": "न चित्रमत्र भूदेव भवमाया दुरत्यया ।\nतया संमोहिताः सर्वे नावयंत्यपि तं परम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004082009, "chapter_id": 24082, "verse_number": "४-३१-१०", "content_sanskrit": "वेदयेद्यदिचात्मानं स एव परमेश्वरः ।\nतदा विंदंति ब्रह्माद्याः स्वेच्छयैव न तं विदुः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004082010, "chapter_id": 24082, "verse_number": "४-३१-११", "content_sanskrit": "स सर्वगोपि नेक्ष्येत स्वात्मारामो महेश्वरः ।\nदेववद्बुध्यते मूढैरतीतो यो मनोगिराम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004082011, "chapter_id": 24082, "verse_number": "४-३१-१२", "content_sanskrit": "पुरा पितामहं विप्र मेरुशृंगे महर्षयः ।\nप्रोचुः प्रणम्य लोकेशं किमेकं तत्त्वमव्ययम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004082012, "chapter_id": 24082, "verse_number": "४-३१-१३", "content_sanskrit": "समा यया महेशस्य मोहितो लोकसंभवः ।\nअविज्ञाय परं भावमात्मानं प्राह वर्पिणम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004082013, "chapter_id": 24082, "verse_number": "४-३१-१४", "content_sanskrit": "जगद्योनिरहं धाता स्वयंभूरेक ईश्वरः ।\nअनादिमदहं ब्रह्म मामनर्च्य न मु च्यते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004082014, "chapter_id": 24082, "verse_number": "४-३१-१५", "content_sanskrit": "प्रवर्तको हि जगतामहमेको निवर्तकः ।\nनान्यो मदधिकः सत्यं कश्चित्कोपि सुरोत्तमाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004082015, "chapter_id": 24082, "verse_number": "४-३१-१६", "content_sanskrit": "तस्यैवं ब्रुवतो धातुः क्रतुर्नारायणांशजः ।\nप्रोवाच प्रहसन्वाक्यं रोषताम्रविलोचनः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004082016, "chapter_id": 24082, "verse_number": "४-३१-१७", "content_sanskrit": "अविज्ञाय परं तत्त्वं किमेतत्प्रतिपाद्यते ।\nअज्ञानं योगयुक्तस्य न चैतदुचितं तव ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004082017, "chapter_id": 24082, "verse_number": "४-३१-१८", "content_sanskrit": "अहं कर्ता हि लोकानां यज्ञो नारायणः परः ।\nन मामनादृत्य विधे जीवनं जगतामज ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004082018, "chapter_id": 24082, "verse_number": "४-३१-१९", "content_sanskrit": "अहमेव परं ज्योतिरहमेव परा गतिः ।\nमत्प्रेरितेन भवता सृष्टिरेषा विधीयते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004082019, "chapter_id": 24082, "verse_number": "४-३१-२०", "content_sanskrit": "एवं विप्र कृतौ मोहात्परस्परजयैषिणौ ।\nपप्रच्छतुः प्रमाणज्ञानागमांश्चतुरोपि तौ ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004082020, "chapter_id": 24082, "verse_number": "४-३१-२१", "content_sanskrit": "विधिक्रतू ऊचतुः ।\nवेदाः प्रमाणं सर्वत्र प्रतिष्ठां परमामिताः ।\nयूयमेव न संदेहः किं तत्त्वं प्रतितिष्ठत ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004082021, "chapter_id": 24082, "verse_number": "४-३१-२२", "content_sanskrit": "श्रुतय ऊचुः ।\nयदि मान्या वयं देवौ सृष्टिस्थितिकरौ विभू ।\nतदा प्रमाणं वक्ष्यामो भवत्संदेहभेदकम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004082022, "chapter_id": 24082, "verse_number": "४-३१-२३", "content_sanskrit": "श्रुत्युक्तमिदमाकर्ण्य प्रोचतुस्तौ श्रुतीः प्रति ।\nयुष्मदुक्तं प्रमाणं नौ किं तत्त्वं सम्यगुच्यताम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004082023, "chapter_id": 24082, "verse_number": "४-३१-२४", "content_sanskrit": "ऋगुवाच ।\nयदंतःस्थानि भूतानि यतः सर्वं प्रवर्तते ।\nयदाहुस्तत्परं तत्त्वं स रुद्रस्त्वेक एव हि ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004082024, "chapter_id": 24082, "verse_number": "४-३१-२५", "content_sanskrit": "यजुरुवाच ।\nयो यज्ञैरखिलैरीशो योगेन च समिज्यते ।\nयेन प्रमाणं हि वयं स एकः सर्वदृक्छिवः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004082025, "chapter_id": 24082, "verse_number": "४-३१-२६", "content_sanskrit": "सामोवाच ।\nयेनेदं भ्रश्यते विश्वं योगिभिर्यो विचिंत्यते ।\nयद्भासा भासते विश्वं स एकस्त्र्यंबकः परः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004082026, "chapter_id": 24082, "verse_number": "४-३१-२७", "content_sanskrit": "अथर्वोवाच ।\nयं प्रपश्यंति देवेशं भक्त्यानुग्रहिणो जनाः ।\nतमाहुरेकं कैवल्यं शंकरं दुःखतस्करम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004082027, "chapter_id": 24082, "verse_number": "४-३१-२८", "content_sanskrit": "श्रुतीरितं निशम्येत्थं तावतीव विमोहितौ ।\nस्मित्वाहतुः क्रतु विधीमोहाध्येनांकितौ मुने ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004082028, "chapter_id": 24082, "verse_number": "४-३१-२९", "content_sanskrit": "कथं प्रमथनाथोसौ रममाणो निरंतरम् ।\nदिगंबरः पितृवने शिवया धूलिधूसरः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004082029, "chapter_id": 24082, "verse_number": "४-३१-३०", "content_sanskrit": "विटंकवेशो जटिलो वृषगोव्यालभूषणः ।\nपरं ब्रह्मत्वमापन्नः क्व च तत्संगवर्जितम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004082030, "chapter_id": 24082, "verse_number": "४-३१-३१", "content_sanskrit": "तदुदीरितमाकर्ण्य प्रणवात्मा सनातनः ।\nअमूर्तो मूर्तिमान्भूत्वा हसमान उवाच तौ ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004082031, "chapter_id": 24082, "verse_number": "४-३१-३२", "content_sanskrit": "प्रणव उवाच ।\nन ह्येष भगवाञ्छक्त्या स्वात्मनो व्यतिरिक्तया ।\nकदाचिद्रमते रुद्रो लीलारूपधरो हरः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004082032, "chapter_id": 24082, "verse_number": "४-३१-३३", "content_sanskrit": "असौ हि भगवानीशः स्वयंज्योतिः सनातनः ।\nआनंदरूपा तस्यैषा शक्तिर्नागंतुकी शिवा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004082033, "chapter_id": 24082, "verse_number": "४-३१-३४", "content_sanskrit": "इत्येवमुक्तेपि तदा मखमूर्तेरजस्य हि ।\nनाज्ञानमगमन्नाशं श्रीकंठस्यैव मायया ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004082034, "chapter_id": 24082, "verse_number": "४-३१-३५", "content_sanskrit": "प्रादुरासीत्ततो ज्योतिरुभयोरंतरे महत् ।\nपूरयन्निजया भासा द्यावाभूम्योर्यदंतरम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004082035, "chapter_id": 24082, "verse_number": "४-३१-३६", "content_sanskrit": "ज्योतिर्मंडलमध्यस्थो ददृशे पुरुषाकृतिः ।\nप्रजज्वालाथ कोपेन ब्रह्मणः पंचमं शिरः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004082036, "chapter_id": 24082, "verse_number": "४-३१-३७", "content_sanskrit": "आवयोरंतरं कोसौ बिभृयात्पुरुषाकृतिम् ।\nविधिः संभावयेद्यावत्तावत्स हि विलोकितः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004082037, "chapter_id": 24082, "verse_number": "४-३१-३८", "content_sanskrit": "स्रष्टा क्षणेन च महान्पुरुषो नीललोहितः ।\nत्रिशूलपाणिर्भालाक्षो नागोडुपविभूषणः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004082038, "chapter_id": 24082, "verse_number": "४-३१-३९", "content_sanskrit": "हिरण्यगर्भस्तं प्राह जाने त्वां चंद्रशेखरम् ।\nभालस्थलान्ममपुरा रुद्रः प्रादुरभूद्भवान् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004082039, "chapter_id": 24082, "verse_number": "४-३१-४०", "content_sanskrit": "रोदनाद्रुद्रनामापि योजितोसि मया पुरा ।\nमामेव शरणं याहि पुत्र रक्षां करोमि ते ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004082040, "chapter_id": 24082, "verse_number": "४-३१-४१", "content_sanskrit": "अथेश्वरः पद्मयोनेः श्रुत्वा गर्ववतीं गिरम् ।\nसकोपतः समुत्पाद्य पुरुषं भैरवाकृतिम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004082041, "chapter_id": 24082, "verse_number": "४-३१-४२", "content_sanskrit": "प्राह पंकजजन्मासौ शास्यस्ते कालभैरव ।\nकालवद्राजसे साक्षात्कालराजस्ततो भवान् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004082042, "chapter_id": 24082, "verse_number": "४-३१-४३", "content_sanskrit": "विश्वं भर्तुं समर्थोऽसि भरणाद्भैरवः स्मृतः ।\nत्वत्तो भेष्यति कालोपि ततस्त्वं कालभैरवः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004082043, "chapter_id": 24082, "verse_number": "४-३१-४४", "content_sanskrit": "आमर्दयिष्यति भवांस्तुष्टो दुष्टात्मनो यतः ।\nआमर्दक इति ख्याति ततः सर्वत्र यास्यति ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004082044, "chapter_id": 24082, "verse_number": "४-३१-४५", "content_sanskrit": "यतः पापानि भक्तानां भक्षयिष्यति तत्क्षणात् ।\nपापभक्षण इत्येव तव नाम भविष्यति ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004082045, "chapter_id": 24082, "verse_number": "४-३१-४६", "content_sanskrit": "या मे मुक्तिपुरी काशी सर्वाभ्योपि गरीयसी ।\nआधिपत्यं च तस्यास्ते कालराज सदैव हि ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004082046, "chapter_id": 24082, "verse_number": "४-३१-४७", "content_sanskrit": "तत्र ये पापकर्तारस्तेषां शास्ता त्वमेव हि ।\nशुभाशुभं न तत्कर्म चित्रगुप्तो लिखिष्यति ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004082047, "chapter_id": 24082, "verse_number": "४-३१-४८", "content_sanskrit": "एतान्वरान्प्रगृह्याऽथ तत्क्षणात्कालभैरवः ।\nवामांगुलिनखाग्रेण चकर्त च शिरो विधेः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004082048, "chapter_id": 24082, "verse_number": "४-३१-४९", "content_sanskrit": "यदंगमपराध्नोति कार्यं तस्यैव शासनम् ।\nअतो येन कृता निंदा तच्छिन्नं पचमं शिरः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004082049, "chapter_id": 24082, "verse_number": "४-३१-५०", "content_sanskrit": "यज्ञमूर्तिधरो विष्णुस्ततस्तुष्टाव शंकरम् ।\nभीतो हिरण्यगर्भोपि जजाप शतरुद्रियम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004082050, "chapter_id": 24082, "verse_number": "४-३१-५१", "content_sanskrit": "आश्वास्य तौ महादेवः प्रीतः प्रणतवत्सलः ।\nप्राह स्वां मूर्तिमपरां भैरवं तं कपर्दिनम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004082051, "chapter_id": 24082, "verse_number": "४-३१-५२", "content_sanskrit": "मान्योऽध्वरोसौ भवता तथा शतधृतिस्त्वयम् ।\nकपालं वैधसं चापि नीललोहित धारय ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004082052, "chapter_id": 24082, "verse_number": "४-३१-५३", "content_sanskrit": "ब्रह्महत्यापनोदाय व्रतं लोकाय दर्शयन् ।\nचर त्वं सततं भिक्षां कापालव्रतमास्थितः ।\nइत्युक्त्वांऽतर्हितो देवस्तेजोरूपस्तदा शिवः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004082053, "chapter_id": 24082, "verse_number": "४-३१-५४", "content_sanskrit": "उत्पाद्य कन्यामेकां तु ब्रह्महत्येति विश्रुताम् ।\nरक्तांबरधरां रक्तां रक्तस्रग्गंधलेपनाम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004082054, "chapter_id": 24082, "verse_number": "४-३१-५५", "content_sanskrit": "दंष्टाकरालवदनां ललज्जिह्वातिभीषणाम् ।\nअंतरिक्षैकपादाग्रां पिबंतीं रुधिरं बहु ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004082055, "chapter_id": 24082, "verse_number": "४-३१-५६", "content_sanskrit": "कर्त्रीं कर्परहस्ताग्रां स्फुरत्पिंगोग्रतारकाम् ।\nगर्जयंतीं महावेगां भैरवस्यापिभीषणाम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004082056, "chapter_id": 24082, "verse_number": "४-३१-५७", "content_sanskrit": "यावद्वाराणसीं दिव्यां पुरीमेष गमिष्यति ।\nतावत्त्वं भीषणे कालमनुगच्छोग्ररूपिणि ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004082057, "chapter_id": 24082, "verse_number": "४-३१-५८", "content_sanskrit": "सर्वत्र ते प्रवेशोस्ति त्यक्त्वा वाराणसीं पुरीम् ।\nनियोज्यतामिति शिवोप्यंतर्धानं गतस्ततः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004082058, "chapter_id": 24082, "verse_number": "४-३१-५९", "content_sanskrit": "तत्सान्निध्याद्भैरवोपि कालोभूत्कालकालतः ।\nस देवदेववाक्येन बिभ्रत्कापालिकं व्रतम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004082059, "chapter_id": 24082, "verse_number": "४-३१-६०", "content_sanskrit": "कपालपाणिर्विश्वात्मा चचार भुवनत्रयम् ।\nनात्याक्षीच्चापि तं देवं ब्रह्महत्या सुदारुणा ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004082060, "chapter_id": 24082, "verse_number": "४-३१-६१", "content_sanskrit": "सत्यलोकेपि वैकुंठे महेंद्रादि पुरीष्वपि ।\nत्रिजगत्पतिरुग्रोपि व्रती त्रिजगतीश्वरः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004082061, "chapter_id": 24082, "verse_number": "४-३१-६२", "content_sanskrit": "प्रतितीर्थं भ्रमन्नापि विमुक्तो ब्रह्महत्यया ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004082062, "chapter_id": 24082, "verse_number": "४-३१-६३", "content_sanskrit": "अनेनैवानुमानेन महिमा त्ववगम्यताम् ।\nब्रह्महत्यापनोदिन्याः काश्याः कलशसंभव ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004082063, "chapter_id": 24082, "verse_number": "४-३१-६४", "content_sanskrit": "संति तीर्थान्यनेकानि बहून्यायतनानि च ।\nअधि त्रिलोकिनो काश्याः कलामर्हंति षोडशीम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004082064, "chapter_id": 24082, "verse_number": "४-३१-६५", "content_sanskrit": "तावद्गर्जंति पापानि ब्रहत्यादिकान्यलम् ।\nयावन्नाम न शृण्वंति काश्याः पापाचलाशनेः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004082065, "chapter_id": 24082, "verse_number": "४-३१-६६", "content_sanskrit": "प्रमथैः सेव्यमानोऽयं त्रिलोकीं विचरन्हरः ।\nकापालिको ययौ देवो नारायणनिकेतनम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004082066, "chapter_id": 24082, "verse_number": "४-३१-६७", "content_sanskrit": "अथायांतं महाकालं त्रिनेत्रं सर्पकुंडलम् ।\nमहादेवांशसंभूतं भैरवं भीषणाकृतिम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004082067, "chapter_id": 24082, "verse_number": "४-३१-६८", "content_sanskrit": "पपात दंडवद्भूमौ दृष्ट्वा तं गरुडध्वजः ।\nदेवाश्च मुनयश्चैव देवनार्यः समंततः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004082068, "chapter_id": 24082, "verse_number": "४-३१-६९", "content_sanskrit": "निपेतुः प्रणिपत्यैनं प्रणतः कमलापतिः ।\nशिरस्यंजलिमारोप्य स्तुत्वा बहुविधैः स्तवैः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004082069, "chapter_id": 24082, "verse_number": "४-३१-७०", "content_sanskrit": "क्षीरोदमथनो तां प्राह पद्मालयां हरिः ।\nप्रिये पश्याऽब्जनयने धन्याऽसि सुभगेनघे ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004082070, "chapter_id": 24082, "verse_number": "४-३१-७१", "content_sanskrit": "धन्योऽहं देवि सुश्रोणि यत्पश्यावो जगत्पतिम् ।\nअयं धाता विधाता च लोकानां प्रभुरीश्वरः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004082071, "chapter_id": 24082, "verse_number": "४-३१-७२", "content_sanskrit": "अनादिः शरणः शांतः परः षड्विंशसंमितः ।\nसर्वज्ञः सर्वयोगीशः सर्वभूतैकनायकः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004082072, "chapter_id": 24082, "verse_number": "४-३१-७३", "content_sanskrit": "सर्वभूतांतरात्माऽयं सर्वेषां सर्वदः सदा ।\nयं विनिद्रा विनिःश्वासाः शांता ध्यानपरायणाः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004082073, "chapter_id": 24082, "verse_number": "४-३१-७४", "content_sanskrit": "धिया पश्यंति हृदये सोयमद्य समीक्ष्यताम् ।\nयं विदुर्वेदतत्त्वज्ञा योगिनो यतमानसाः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004082074, "chapter_id": 24082, "verse_number": "४-३१-७५", "content_sanskrit": "अरूपो रूपवान्भूत्वा सोयमायाति सर्वगः ।\nअहो विचित्रं देवस्य चेष्टितं परमेष्ठिनः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004082075, "chapter_id": 24082, "verse_number": "४-३१-७६", "content_sanskrit": "यस्याख्यां ब्रुवतां नित्यं न देहः सोपि देहधृक् ।\nयं दृष्ट्वा न पुनर्जन्म लभ्यते मानवैर्भुवि ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004082076, "chapter_id": 24082, "verse_number": "४-३१-७७", "content_sanskrit": "सोयमायाति भगवांस्त्र्यंबकः शशिभूषणः ।\nपुंडरीकदलायामे धन्येमेऽद्य विलोचने ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004082077, "chapter_id": 24082, "verse_number": "४-३१-७८", "content_sanskrit": "धिग्धिक्पदं तु देवानां परं दृष्ट्वाऽत्र शंकरम् ।\nलभ्यते यन्न निर्वाणं सर्वदुःखांतकृत्तु यत् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004082078, "chapter_id": 24082, "verse_number": "४-३१-७९", "content_sanskrit": "देवत्वादशुभं किंचिद्देवलोके न विद्यते ।\nदृष्ट्वापि सर्वदेवेशं यन्मुक्तिं न लभामहे ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004082079, "chapter_id": 24082, "verse_number": "४-३१-८०", "content_sanskrit": "एवमुक्त्वा हृषीकेशः संप्रहृष्टतनूरुहः ।\nप्रणिपत्य महादेवमिदमाह वृषध्वजम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004082080, "chapter_id": 24082, "verse_number": "४-३१-८१", "content_sanskrit": "किमिदं देवदेवेन सर्वज्ञेन त्वया विभो ।\nक्रियते जगतां धात्रा सर्वपापहराऽव्यय ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004082081, "chapter_id": 24082, "verse_number": "४-३१-८२", "content_sanskrit": "क्रीडेयं तव देवेश त्रिलोचन महामते ।\nकिं कारणं विरूपाक्ष चेष्टितं ते स्मरार्दन ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004082082, "chapter_id": 24082, "verse_number": "४-३१-८३", "content_sanskrit": "किमर्थं भगवत्र्छंभो भिक्षां चरसि शक्तिप ।\nसंशयो मे जगन्नाथ नतत्रैलोक्यराज्यद ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004082083, "chapter_id": 24082, "verse_number": "४-३१-८४", "content_sanskrit": "एवमुक्तस्ततः शंभुर्विष्णुमेतदुदाहरत् ।\nब्रह्मणस्तु शिरश्छिन्नमंगु्ल्यग्रनखेन ह ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004082084, "chapter_id": 24082, "verse_number": "४-३१-८५", "content_sanskrit": "तदघप्रतिघं विष्णो चराम्येतद्व्रतं शुभम् ।\nएवमुक्तो महेशेन पुंडरीकविलोचनः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004082085, "chapter_id": 24082, "verse_number": "४-३१-८६", "content_sanskrit": "स्मित्वा किंचिन्नतशिराः पुनरेवं व्यजिज्ञपत् ।\nयथेच्छसि तथा क्रीड सर्वविष्टपनायक ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004082086, "chapter_id": 24082, "verse_number": "४-३१-८७", "content_sanskrit": "मायया मां महादेव नच्छादयितुमर्हसि ।\nनाभीकमलकोशात्तु कोटिशः कमलासनान् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004082087, "chapter_id": 24082, "verse_number": "४-३१-८८", "content_sanskrit": "कल्पे कल्पे सृजामीश त्वन्नियोगबलाद्विभो ।\nत्यज मायामिमां देव दुस्तरामकृतात्मभिः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004082088, "chapter_id": 24082, "verse_number": "४-३१-८९", "content_sanskrit": "मदाद्यो महादेव मायया तव मोहिताः ।\nयथावदवगच्छामि चेष्टितं ते शिवापते ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004082089, "chapter_id": 24082, "verse_number": "४-३१-९०", "content_sanskrit": "संहारकाले संप्राप्ते सदेवानखिलान्मुनीन् ।\nलोकान्वर्णाश्रमवतो हरिष्यसि यदा हर ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004082090, "chapter_id": 24082, "verse_number": "४-३१-९१", "content_sanskrit": "तदा क्व ते महादेव पाप ब्रह्मवधादिकम् ।\nपारतंत्र्यं न ते शंभो स्वैरं क्रीडेत्ततो भवान् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004082091, "chapter_id": 24082, "verse_number": "४-३१-९२", "content_sanskrit": "अतीतब्रह्मणामस्थ्नां स्रक्कंठे तव भासते ।\nतदातदा क्वानुगता ब्रह्महत्या तवानघ ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004082092, "chapter_id": 24082, "verse_number": "४-३१-९३", "content_sanskrit": "कृत्वापि सुमहत्पापं त्वां यः स्मरति भावतः ।\nआधारं जगतामीशं तस्य पापं विलीयते ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004082093, "chapter_id": 24082, "verse_number": "४-३१-९४", "content_sanskrit": "यथा तमो न तिष्ठेत संनिधावंशुमालिनः ।\nतथा न भवभक्तस्य पापं तस्य व्रजेत्क्षयम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004082094, "chapter_id": 24082, "verse_number": "४-३१-९५", "content_sanskrit": "यश्चिंतयति पुण्यात्मा तव पादांबुजद्वयम् ।\nब्रह्महत्यादिकमपि पापं तस्य व्रजेत्क्षयम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004082095, "chapter_id": 24082, "verse_number": "४-३१-९६", "content_sanskrit": "तव नामानुरक्ता वाग्यस्य पुंसो जगत्पते ।\nअप्यद्रिकूटतुलितं नैनस्तमनुबाधते ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004082096, "chapter_id": 24082, "verse_number": "४-३१-९७", "content_sanskrit": "रजसा तमसा विवर्धितं क्व नु पापं परितापदायकम् ।\nक्व च ते शिव नाम मंगलं जनजीवातु जगद्रुजापहम् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004082097, "chapter_id": 24082, "verse_number": "४-३१-९८", "content_sanskrit": "यदि जातुचिदंधकद्विषस्तवनामौष्ठपुटाद्विनिःसृतम् ।\nशिवशंकर चंद्रशेखरेत्यसकृत्तस्य न संसृतिः पुनः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004082098, "chapter_id": 24082, "verse_number": "४-३१-९९", "content_sanskrit": "परमात्मन्परंधाम स्वेच्छा विधृत विग्रह ।\nकुतूहलं तवेशेदं क्व पराधीनतेश्वरे ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004082099, "chapter_id": 24082, "verse_number": "४-३१-१००", "content_sanskrit": "अद्य धन्योस्मि देवेश यं न पश्यति योगिनः ।\nपश्यामि तं जगन्मूलं परमेश्वरमक्षयम् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004082100, "chapter_id": 24082, "verse_number": "४-३१-१०१", "content_sanskrit": "अद्य मे परमो लाभस्त्वद्य मे मंगलं परम् ।\nत्वद्दृष्ट्यमृततृप्तस्य तृणं स्वर्गापवर्गदम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004082101, "chapter_id": 24082, "verse_number": "४-३१-१०२", "content_sanskrit": "इत्थं वदति गोविंदे विमला पद्मया तया ।\nमनोरथवती नाम भिक्षापात्रे समर्पिता ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004082102, "chapter_id": 24082, "verse_number": "४-३१-१०३", "content_sanskrit": "भिक्षाटनाय देवोपि निरगात्परया मुदा ।\nदृष्ट्वाऽनुयायिनीं तां तु समाहूय जनार्दनः ।\nसंप्रार्थयद्ब्रह्महत्यां विमुंच त्वं त्रिशूलिनम् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004082103, "chapter_id": 24082, "verse_number": "४-३१-१०४", "content_sanskrit": "ब्रह्महत्योवाच ।\nअनेनापि मिषेणाऽहं संसेव्यामुं वृषध्वजम् ।\nआत्मानं पावयिष्यामि क्व पुनर्भवदर्शनम् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004082104, "chapter_id": 24082, "verse_number": "४-३१-१०५", "content_sanskrit": "सा तत्याज न तत्पार्श्वं व्याहृतापि मुरारिणा ।\nतमूचेऽथ हरिं शंभुः स्मेरास्यो वचनं शुभम् ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004082105, "chapter_id": 24082, "verse_number": "४-३१-१०६", "content_sanskrit": "त्वद्वाक्पीयूषपानेन तृप्तोस्मि बहुमानद ।\nवरं वृणीष्व गोविंद वरदोऽस्मि तवानघ ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004082106, "chapter_id": 24082, "verse_number": "४-३१-१०७", "content_sanskrit": "न माद्यंति यथा भैक्षैर्भिक्षवोप्यतिसंस्कृतैः ।\nयथामानसुधापानैर्नुन्न भिक्षाटनज्वराः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004082107, "chapter_id": 24082, "verse_number": "४-३१-१०८", "content_sanskrit": "महाविष्णुरुवाच ।\nएष एव वरः श्लाघ्यो यदहं देवताधिपम् ।\nपश्यामि त्वां देवदेवं मनोरथपथातिगम् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004082108, "chapter_id": 24082, "verse_number": "४-३१-१०९", "content_sanskrit": "अनभ्रेयं सुधावृष्टिरनायासो महोत्सवः ।\nअयत्नो निधिलाभो यद्वीक्षणं हरते सताम् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7004082109, "chapter_id": 24082, "verse_number": "४-३१-११०", "content_sanskrit": "अवियोगोऽस्तु मे देव त्वदंघ्रियुगलेन वै ।\nएष एव वरः शंभो नान्यं कंचिद्वरं वृणे ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7004082110, "chapter_id": 24082, "verse_number": "४-३१-१११", "content_sanskrit": "ईश्वर उवाच ।\nएवं भवतु तेऽनंत यत्त्वयोक्तं महामते ।\nसर्वेषामपि देवानां वरदस्त्वं भविष्यसि ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7004082111, "chapter_id": 24082, "verse_number": "४-३१-११२", "content_sanskrit": "अनुगृह्येति दैत्यारिं केंद्रादि भुवने चरन् ।\nभेजे विमुक्तिजननीं नाम्ना वाराणसीं पुरीम् ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7004082112, "chapter_id": 24082, "verse_number": "४-३१-११३", "content_sanskrit": "यत्र स्थितानां जंतूनां कलां नार्हंति षोडशीम् ।\nअपि ब्रह्मादि देवानां पदानि विपदां पदम् ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7004082113, "chapter_id": 24082, "verse_number": "४-३१-११४", "content_sanskrit": "वरं वाराणसी वासी जटी मुंडी दिगंबरः ।\nनान्यत्रच्छत्रसंछन्न वसुधामंडलेश्वरः ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7004082114, "chapter_id": 24082, "verse_number": "४-३१-११५", "content_sanskrit": "वरं वाराणसी भिक्षा न लक्षाधिपतान्यतः ।\nलक्षाधीशो विशेद्गर्भं तद्भिक्षाशी न गर्भभाक् ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7004082115, "chapter_id": 24082, "verse_number": "४-३१-११६", "content_sanskrit": "भिक्षापि यत्र भिक्षुभ्यो दत्तामलकसंमिता ।\nसुमेरुणापि तुलिता वाराणस्यां गुरुर्भवेत् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7004082116, "chapter_id": 24082, "verse_number": "४-३१-११७", "content_sanskrit": "वर्षाशनं हि यो दद्यात्काश्यां सीदत्कुटुंबिने ।\nयावंत्यब्दानि तावंति युगानि स दिवीज्यते ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7004082117, "chapter_id": 24082, "verse_number": "४-३१-११८", "content_sanskrit": "वाराणस्यां वर्षभोज्यं यो दद्यान्निरुपायिने ।\nस कदाचित्तृट्क्षुधा नो दुःखं भुंक्ते नरर्षभः ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7004082118, "chapter_id": 24082, "verse_number": "४-३१-११९", "content_sanskrit": "वाराणस्यां निवसतां यत्पुण्यमुपजायते ।\nतदेव संवासयितुः फलं त्वविकलं भवेत् ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7004082119, "chapter_id": 24082, "verse_number": "४-३१-१२०", "content_sanskrit": "ब्रह्महत्यादि पापानि यस्या नाम्नोपि कीर्तनात् ।\nत्यजंति पापिनं काशी सा केनेहोपमीयते ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7004082120, "chapter_id": 24082, "verse_number": "४-३१-१२१", "content_sanskrit": "क्षेत्रे प्रविष्टमात्रेऽथ भैरवे भीषणाकृतौ ।\nहाहेत्युक्त्वा ब्रह्महत्या पातालतलमाविशत् ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7004082121, "chapter_id": 24082, "verse_number": "४-३१-१२२", "content_sanskrit": "कपालब्रह्मणो रुद्रः सर्वेषामेव पश्यताम् ।\nहस्तात्पतितमालोक्य ननर्त परया मुदा ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7004082122, "chapter_id": 24082, "verse_number": "४-३१-१२३", "content_sanskrit": "विधेः कपालं नामुंचत्करमत्यंतदुःसहम् ।\nहरस्य भ्रमतः क्वापि तत्काश्यां क्षणतोऽपतत् ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7004082123, "chapter_id": 24082, "verse_number": "४-३१-१२४", "content_sanskrit": "शूलिनो ब्रह्मणो हत्या नापैति स्म च या क्वचित् ।\nसा काश्यां क्षणतो नष्टा कथं काशी न दुर्लभा ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7004082124, "chapter_id": 24082, "verse_number": "४-३१-१२५", "content_sanskrit": "अतः प्रदक्षिणीकार्या पूजनीया पुरी त्वियम् ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7004082125, "chapter_id": 24082, "verse_number": "४-३१-१२६", "content_sanskrit": "वाराणसीति काशीति महामंत्रमिमं जपम् ।\nयावज्जीवं त्रिसंध्यं तु जंतुर्जातु न जायते ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7004082126, "chapter_id": 24082, "verse_number": "४-३१-१२७", "content_sanskrit": "अविमुक्तं महाक्षेत्रं स्मरन्प्राणांस्तु यस्त्वजेत् ।\nदूरदेशांतरस्थोपि सोपि जातु न जायते ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7004082127, "chapter_id": 24082, "verse_number": "४-३१-१२८", "content_sanskrit": "आनंदकानने यस्य चित्तं संस्मरते सदा ।\nतत्क्षेत्रनामश्रवणान्न स भूयोऽभिजायते ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7004082128, "chapter_id": 24082, "verse_number": "४-३१-१२९", "content_sanskrit": "रुद्रावासे वसेन्नित्यं नरो नियतमानसः ।\nएनसामपि संभारं कृत्वा कालाद्विमुच्यते ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7004082129, "chapter_id": 24082, "verse_number": "४-३१-१३०", "content_sanskrit": "महाश्मशानमासाद्य यदि देवाद्विपद्यते ।\nपुनः श्मशानशयनं न क्वापि लभते पुमान् ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7004082130, "chapter_id": 24082, "verse_number": "४-३१-१३१", "content_sanskrit": "कपालमोचनं काश्यां ये स्मरिष्यंति मानवाः ।\nतेषां विनंक्ष्यति क्षिप्रमिहान्यत्रापि पातकम् ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7004082131, "chapter_id": 24082, "verse_number": "४-३१-१३२", "content_sanskrit": "आगत्य तीर्थप्रवरे स्नानं कृत्वा विधानतः ।\nतर्पयित्वा पितॄन्देवान्मुच्यते ब्रह्महत्यया ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7004082132, "chapter_id": 24082, "verse_number": "४-३१-१३३", "content_sanskrit": "अशाश्वतमिदं ज्ञात्वा वाराणस्यां वसंति ये ।\nदेहांते तत्परं ज्ञानं तेषां दास्यति शंकरः ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7004082133, "chapter_id": 24082, "verse_number": "४-३१-१३४", "content_sanskrit": "इयं काशीपुरी विप्र साक्षाद्रुद्रतनुः परा ।\nअनिर्वाच्या परानंदा दुष्प्राप्येशविरोधिभिः ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7004082134, "chapter_id": 24082, "verse_number": "४-३१-१३५", "content_sanskrit": "अस्यास्तत्त्वमहं जाने शिवभक्तिपरोपि वा ।\nमुच्यंते जंतवोऽत्रैव यथा योगेन योगिनः ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7004082135, "chapter_id": 24082, "verse_number": "४-३१-१३६", "content_sanskrit": "परंपदमियं काशी परानंद इयं पुरी ।\nइयमेव परं ज्ञानं सेव्याऽसौ मोक्षकांक्षिभिः ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7004082136, "chapter_id": 24082, "verse_number": "४-३१-१३७", "content_sanskrit": "अत्रोषित्वापीशभक्तान्विरुणद्धि तु यः कुधीः ।\nपुर्यैद्रुह्यति वा मूढस्तस्यान्यत्रात्र नो गतिः ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7004082137, "chapter_id": 24082, "verse_number": "४-३१-१३८", "content_sanskrit": "कपालमोचनं तीर्थं पुरस्कृत्वा तु भैरवः ।\nतत्रैव तस्थौ भक्तानां भक्षयन्नघसंततिम् ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7004082138, "chapter_id": 24082, "verse_number": "४-३१-१३९", "content_sanskrit": "पापभक्षणमासाद्य कृत्वापापशतान्यपि ।\nकुतो बिभेति पापेभ्यः कालभैरवसेवकः ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7004082139, "chapter_id": 24082, "verse_number": "४-३१-१४०", "content_sanskrit": "आमर्दयति पापानि दुष्टानां च मनोरथान् ।\nआमर्दक इति ख्यातस्ततोऽसौ कालभैरवः ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7004082140, "chapter_id": 24082, "verse_number": "४-३१-१४१", "content_sanskrit": "कलिकालं कलयति सदा काशी निवासिनाम् ।\nअतः ख्यातिं परां प्राप्तः कालभैरवसंज्ञिताम् ॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7004082141, "chapter_id": 24082, "verse_number": "४-३१-१४२", "content_sanskrit": "सदैव यस्य भक्तेभ्यो यमदूताः सुदारुणाः ।\nपरमां भीरुतां प्राप्तास्ततोसौ भैरवः स्मृतः ॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7004082142, "chapter_id": 24082, "verse_number": "४-३१-१४३", "content_sanskrit": "मार्गशीर्षासिताष्टम्यां कालभैरवसंनिधौ ।\nउपोष्य जागरं कुर्वन्महापापैः प्रमुच्यते ॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7004082143, "chapter_id": 24082, "verse_number": "४-३१-१४४", "content_sanskrit": "यत्किंचिदशुभं कर्म कृतं मानुषबुद्धितः ।\nतत्सर्वं विलयं याति कालभैरव दर्शनात् ॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 7004082144, "chapter_id": 24082, "verse_number": "४-३१-१४५", "content_sanskrit": "अनेकजन्मनियुतैर्यत्कृतं जंतुभिस्त्वघम् ।\nतत्सर्वं विलयत्याशु कालभैरव दर्शनात् ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 7004082145, "chapter_id": 24082, "verse_number": "४-३१-१४६", "content_sanskrit": "कृत्वा च विविधां पूजां महासंभारविस्तरैः ।\nनरो मार्गासिताष्टम्यां वार्षिकं विघ्नमुत्सृजेत् ॥१४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 7004082146, "chapter_id": 24082, "verse_number": "४-३१-१४७", "content_sanskrit": "अष्टम्यां च चतुर्दश्यां रविभूमिजवासरे ।\nयात्रां च भैरवीं कृत्वा कृतैः पापैः प्रमुच्यते ॥१४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 7004082147, "chapter_id": 24082, "verse_number": "४-३१-१४८", "content_sanskrit": "कालभैरव भक्तानां सदा काशीनिवासिनाम् ।\nविघ्नं यः कुरुते मूढः स दुर्गतिमवाप्नुयात् ॥१४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 7004082148, "chapter_id": 24082, "verse_number": "४-३१-१४९", "content_sanskrit": "विश्वेश्वरेपि ये भक्ता नो भक्ताः कालभैरवे ।\nकाश्यां ते विघ्नसंघातं लभंते तु पदे पदे ॥१४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 7004082149, "chapter_id": 24082, "verse_number": "४-३१-१५०", "content_sanskrit": "तीर्थे कालोदके स्नात्वा कृत्वा तर्पणमत्वरः ।\nविलोक्य कालराजं च निरयादुद्धरेत्पितॄन् ॥१५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 7004082150, "chapter_id": 24082, "verse_number": "४-३१-१५१", "content_sanskrit": "अष्टौ प्रदक्षिणीकृत्य प्रत्यहं पापभक्षणम् ।\nनरो न पापैर्लिप्येत मनोवाक्कायसंभवैः ॥१५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}, {"id": 7004082151, "chapter_id": 24082, "verse_number": "४-३१-१५२", "content_sanskrit": "तस्मिन्नामर्दके पीठे जप्त्वास्वाभीष्टदेवताम् ।\nषण्मासं सिद्धिमाप्नोति साधको भैरवाज्ञया ॥१५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 152}, {"id": 7004082152, "chapter_id": 24082, "verse_number": "४-३१-१५३", "content_sanskrit": "वाराणस्यामुषित्वा यो भैरवं न भजेन्नरः ।\nतस्य पापानि वर्धंते शुक्लपक्षे यथा शशी ॥१५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 153}, {"id": 7004082153, "chapter_id": 24082, "verse_number": "४-३१-१५४", "content_sanskrit": "यं यं संचितयेत्कामं पापभक्षणसेवया ।\nबलिपूजोपहारैश्च तं तं स समवाप्नुयात् ॥१५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 154}, {"id": 7004082154, "chapter_id": 24082, "verse_number": "४-३१-१५५", "content_sanskrit": "कालराजं न यः काश्यां प्रतिभूताष्टमीकुजम् ।\nभजेत्तस्यक्षयेत्पुण्यं कृष्णपक्षे यथा शशी ॥१५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 155}, {"id": 7004082155, "chapter_id": 24082, "verse_number": "४-३१-१५६", "content_sanskrit": "श्रुत्वाध्यायमिमं पुण्यं ब्रह्महत्यापनोदकम् ।\nभैरवोत्पत्तिसंज्ञं च सर्वपापैः प्रमुच्यते ॥१५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 156}, {"id": 7004082156, "chapter_id": 24082, "verse_number": "४-३१-१५७", "content_sanskrit": "बंधनागारसंस्थोपि प्राप्तोपि विपदं पराम् ।\nप्रादुर्भावं भैरवस्य श्रुत्वा मुच्येत संकटात् ॥१५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 157}]