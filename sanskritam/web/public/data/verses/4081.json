[{"id": 2142959, "chapter_id": 4081, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2142960, "chapter_id": 4081, "verse_number": "१", "content_sanskrit": "अथ तामब्रवीद् दृष्ट्वा नहुषो देवराट् तदा\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2142961, "chapter_id": 4081, "verse_number": "२", "content_sanskrit": "त्रयाणामपि लोकानामहमिन्द्रः शुचिस्मिते ।\nभजस्व मां वरारोहे पतित्वे वरवर्णिनि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2142962, "chapter_id": 4081, "verse_number": "३", "content_sanskrit": "एवमुक्ता तु सा देवी नहुषेण पतिव्रता ।\nप्रावेपत भयोद्विग्ना प्रवाते कदळी यथा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2142963, "chapter_id": 4081, "verse_number": "४", "content_sanskrit": "प्रणम्य सा हि ब्रह्माणं शिरसा तु कृताञ्जलिः ।\nदेवराजमथोवाच नहुषं घोरदर्शनम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2142964, "chapter_id": 4081, "verse_number": "५", "content_sanskrit": "कालमिच्छाम्यहं लब्धुं त्वत्तः कश्चित् सुरेश्वर ।\nन हि विज्ञायते शक्रः कुतः प्राप्तः क्व वाऽऽगतः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2142965, "chapter_id": 4081, "verse_number": "६", "content_sanskrit": "तत्त्वमेतत्तु विज्ञाय यदि न ज्ञायते विभो ।\nततोऽहं त्वामुपस्थास्ये सत्यमेतद् ब्रवीमि ते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2142966, "chapter_id": 4081, "verse_number": "७", "content_sanskrit": "एवमुक्तः स इन्द्राण्या नहुषः प्रीतिमानभूत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2142967, "chapter_id": 4081, "verse_number": "", "content_sanskrit": "नहुषः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2142968, "chapter_id": 4081, "verse_number": "८", "content_sanskrit": "एवं भवतु सुश्रोणि यथा मामिह भाषसे ।\nज्ञात्वा चागमनं कार्यं सत्यमेतदनुस्मर\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2142969, "chapter_id": 4081, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2142970, "chapter_id": 4081, "verse_number": "९", "content_sanskrit": "नहुषेण विसृष्टा सा निश्चक्राम ततः शुभा ।\nबृहस्पतिनिकेतं च सा जगाम यशस्विनी\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2142971, "chapter_id": 4081, "verse_number": "१०", "content_sanskrit": "तस्याः संश्रुत्य च वचो देवाः साग्निपुरोगमाः ।\nमन्त्रयामासुरेकाग्राः शक्रार्थं राजसत्तम\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2142972, "chapter_id": 4081, "verse_number": "११", "content_sanskrit": "देवदेवेन सङ्गम्य विष्णुना प्रभविष्णुना ।\nऊचुश्चैनं समुद्विग्ना वाक्यं वाक्यविशारदाः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2142973, "chapter_id": 4081, "verse_number": "१२", "content_sanskrit": "ब्रह्महत्याभिभूतो वै शक्रः सुरगणेश्वरः ।\nगतिश्च नस्त्वं देवेश पूर्वजो जगतः प्रभुः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2142974, "chapter_id": 4081, "verse_number": "१३", "content_sanskrit": "रक्षार्थं सर्वभूतानां विष्णुत्वमुपजग्मिवान्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2142975, "chapter_id": 4081, "verse_number": "१४", "content_sanskrit": "त्वद्वीर्यान्निहते वृत्रे वासवो ब्रह्महत्यया ।\nवृतः सुरगणश्रेष्ठो मोचध्वं पाकशासनम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2142976, "chapter_id": 4081, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2142977, "chapter_id": 4081, "verse_number": "१५", "content_sanskrit": "तेषां तद्वचनं श्रुत्वा देवानां विष्णुरब्रवीत् ।\nमामेव यजतां शक्रः पावयिष्यामि वज्रिणम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2142978, "chapter_id": 4081, "verse_number": "१६", "content_sanskrit": "पुण्येन हयमेधेन मामिष्ट्वा पाकशसनः ।\nपुनरेष्यति देवानामिन्द्रत्वमकुतोभयः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2142979, "chapter_id": 4081, "verse_number": "१७", "content_sanskrit": "स्वकर्मभिश्च नहुषो नाशं यास्यति दुर्मतिः ।\nकञ्चित् कालमिमं देवा मर्षयध्वमतन्द्रिताः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2142980, "chapter_id": 4081, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2142981, "chapter_id": 4081, "verse_number": "१८", "content_sanskrit": "श्रुत्वा विष्णोः शुभां वाणीं तां सत्याममृतोपमाम् ।\nततः सर्वे सुरगणाः सोपाध्यायमहर्षिभिः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2142982, "chapter_id": 4081, "verse_number": "१९", "content_sanskrit": "यत्र शक्रो भयोद्विग्नस्तं देशमुपचक्रमुः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2142983, "chapter_id": 4081, "verse_number": "२०", "content_sanskrit": "तत्राश्वमेधः सुमहान् महेन्द्रस्य महात्मनः ।\nववृते पावनार्थं वै ब्रह्महत्यापहो नृप\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2142984, "chapter_id": 4081, "verse_number": "२१", "content_sanskrit": "विभज्य ब्रह्महत्यां तु वृक्षेषु च नदीषु च ।\nपर्वतेषु पृथिव्यां च स्त्रीषु चैव युधिष्ठिर\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2142985, "chapter_id": 4081, "verse_number": "२२", "content_sanskrit": "संविभज्य च भूतेषु विसृज्य च नरेश्वर ।\nविज्वरो धूतपाप्मा च वासवोऽभवदात्मवान्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2142986, "chapter_id": 4081, "verse_number": "२३", "content_sanskrit": "अकम्प्यं नहुषं स्थानाद् दृष्ट्वा बलनिषूदनः ।\nतेजोघ्नं सर्वभूतानां वरदानाच्च दुःसहम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2142987, "chapter_id": 4081, "verse_number": "२४", "content_sanskrit": "ततः शचीपतिर्देवः पुनरेव व्यनश्यत ।\nअदृश्यः सर्वभूतानां कालाकाङ्क्षी चचार ह\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2142988, "chapter_id": 4081, "verse_number": "२५", "content_sanskrit": "प्रनष्टे तु ततः शक्रे शची शोकसमन्विता ।\nहा शक्रेति तदा देवी विललाप सुदुःखिता\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2142989, "chapter_id": 4081, "verse_number": "", "content_sanskrit": "इन्द्राणी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2142990, "chapter_id": 4081, "verse_number": "२६", "content_sanskrit": "यदि दत्तं यदि हुतं गुरवस्तोषिता यदि ।\nएकभर्तृकता मेऽस्तु सत्यं यद्यस्ति वा मयि\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2142991, "chapter_id": 4081, "verse_number": "२७", "content_sanskrit": "पुण्यां चेमामहं दिव्यां प्रवृत्तामुत्तरायणे ।\nदेवीं रात्रिं नमस्यामि सिद्ध्यतां मे मनोरथः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2142992, "chapter_id": 4081, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2142993, "chapter_id": 4081, "verse_number": "२८", "content_sanskrit": "प्रयता च निशां देवीमुपातिष्ठत तत्र सा ।\nपतिव्रतात्वात् सत्येन सोपश्रुतिमथाकरोत्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2142994, "chapter_id": 4081, "verse_number": "२९", "content_sanskrit": "यत्रास्ते देवराजोऽसौ तं देशं दर्शयस्व मे ।\nइत्याहोपश्रुतिं देवीं सत्यं सत्येन दृश्यताम् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2142995, "chapter_id": 4081, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि त्रयोदशोऽध्यायः ॥१३॥ सेनोद्योगपर्वणि त्रयोदशोऽध्यायः ॥१३॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]