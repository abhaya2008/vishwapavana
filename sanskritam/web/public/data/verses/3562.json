[{"id": 2119216, "chapter_id": 3562, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2119217, "chapter_id": 3562, "verse_number": "१", "content_sanskrit": "तां तु कृत्वा सभां श्रेष्ठां मयश्चार्जुनमब्रवीत् ।\nएषा सभा सव्यसाचिन् ध्वजाग्र्यश्च भविष्यति\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2119218, "chapter_id": 3562, "verse_number": "२", "content_sanskrit": "भूतानां च महावीर्यो ध्वजाग्रे किङ्करो गणः ।\nतव विष्फारघोषेण मेघवन्निनदिष्यति\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2119219, "chapter_id": 3562, "verse_number": "३", "content_sanskrit": "अयं हि सूर्यसङ्काशो ज्वलनस्य रथोत्तमः ।\nइमे च दिविजाः श्वेता वीर्यवन्तो हयोत्तमाः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2119220, "chapter_id": 3562, "verse_number": "४", "content_sanskrit": "मायामयः कृतो ह्येष ध्वजो वानरलक्षणः ।\nअसज्जमानो वृक्षेषु धूमराशिरिवोच्छ्रितः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2119221, "chapter_id": 3562, "verse_number": "५", "content_sanskrit": "बहुवर्णं हि लक्ष्येत ध्वजं वानरलक्षणम् ।\nध्वजोत्कटं ह्यनवमं युद्धे द्रक्ष्यसि विष्ठितम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2119222, "chapter_id": 3562, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2119223, "chapter_id": 3562, "verse_number": "६", "content_sanskrit": "इत्युक्त्वाऽऽलिङ्ग्य बीभत्सुं विसृष्टः प्रययौ मयः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2119224, "chapter_id": 3562, "verse_number": "७", "content_sanskrit": "ततः प्रवेशनं चक्रे तस्यां राजा युधिष्ठिरः ।\nअयुतं भोजयामास ब्राह्मणानां नराधिपः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2119225, "chapter_id": 3562, "verse_number": "८", "content_sanskrit": "परमान्नेन शुचिना मोदकैश्च फलैस्तथा ।\nकृसरेण च शुद्धेन हविष्येण च सर्वशः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2119226, "chapter_id": 3562, "verse_number": "९", "content_sanskrit": "भक्ष्यप्रकारैर्विविधैर्लेह्यैश्चापि तथा नृपः ।\nचोष्यैश्च विविधै राजन् पेयैश्च बहुविस्तरैः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2119227, "chapter_id": 3562, "verse_number": "१०", "content_sanskrit": "अहतैश्चैव वासोभिर्धनेन च सहस्रशः ।\nतर्पयामास विप्रेन्द्रान् नानादिग्भ्यः समागतान्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2119228, "chapter_id": 3562, "verse_number": "११", "content_sanskrit": "ददौ तेभ्यः सहस्राणि गवां प्रत्येकशः प्रभुः ।\nपुण्याहघोषस्तत्रासीद् दिवस्पृक् कीर्तिवर्धनः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2119229, "chapter_id": 3562, "verse_number": "१२", "content_sanskrit": "वादित्रैर्विविधैर्गन्धैर्माल्यैरुच्चावचैरपि ।\nअपूजयत् कुरुश्रेष्ठो दैवतानि निवेश्य च\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2119230, "chapter_id": 3562, "verse_number": "१३", "content_sanskrit": "तत्र मल्ला नटा हल्लाः सूतमागधवन्दिनः ।\nउपतस्थुर्महात्मानं सप्तरात्रं युधिष्ठिरम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2119231, "chapter_id": 3562, "verse_number": "१४", "content_sanskrit": "तथा स पूतां तां कृत्वा भ्रातृभिः सह पाण्डवः ।\nतस्यां सभायां रम्यायां रेमे शक्रो यथा दिवि\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2119232, "chapter_id": 3562, "verse_number": "१५", "content_sanskrit": "सभायामृषयस्तस्यां पाण्डवैश्च सहासिरे ।\nआसाञ्चक्रुर्नरेन्द्राश्च नानादेश्याः समागताः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2119233, "chapter_id": 3562, "verse_number": "१६", "content_sanskrit": "असितो देवलः सत्यः सुमाली चाप्यथाङ्गिराः ।\nअर्वावसुः सुमित्रश्च मैत्रेयः शौनको बली\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2119234, "chapter_id": 3562, "verse_number": "१७", "content_sanskrit": "आत्रेयः कण्वजठरौ मौद्गल्यो हस्तिकाश्यपौ ।\nबको दाल्भ्यः स्थूलशिराः कृष्णद्वैपायनः शुकः ।\nसुमन्तुर्जैमिनिः पैलो वैशम्पायन एव च\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2119235, "chapter_id": 3562, "verse_number": "१८", "content_sanskrit": "तित्तिरिर्याज्ञवल्क्यश्च संयुक्तो रोमहर्षणः ।\nअप्सुजातश्च धौम्यश्च आणिमाण्डव्यकौशिकौ\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2119236, "chapter_id": 3562, "verse_number": "१९", "content_sanskrit": "दामोष्णीषस्त्रिषवणः पर्णादो घटजानुकः ।\nमौञ्जायनो वायुभक्षः पाराशर्यश्च हारितः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2119237, "chapter_id": 3562, "verse_number": "२०", "content_sanskrit": "शीलवानशनिर्धाता शून्यपालः कृतश्रमः ।\nजातूकर्णः शिखावांश्च प्रलम्बः पारिजातकः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2119238, "chapter_id": 3562, "verse_number": "२१", "content_sanskrit": "पर्वतश्च महाभागो मार्कण्डेयस्तथा मुनिः ।\nपवित्रपाणिः सावर्णिर्वालुकिर्गालवस्तथा\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2119239, "chapter_id": 3562, "verse_number": "२२", "content_sanskrit": "जङ्घाबन्धश्च रैभ्यश्च कोपवेगस्तथा भृगुः ।\nपरिबभ्रश्च कौण्डिन्यो बभ्रुमाली सनातनः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2119240, "chapter_id": 3562, "verse_number": "२३", "content_sanskrit": "कक्षीवानौशिजश्चैव नाचिकेतोऽथ गौतमः ।\nपैङ्गिर्वराहः शुनकः शाण्डिल्यश्च महातपाः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2119241, "chapter_id": 3562, "verse_number": "२४", "content_sanskrit": "कुररो वेणुजङ्घश्च कलापः कठ एव च ।\nशार्ङ्गरस्तैलकुण्ड्यश्च पर्णवल्कस्तथैव च\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2119242, "chapter_id": 3562, "verse_number": "२५", "content_sanskrit": "मुनयो धर्मसहिता जितात्मानो जितेन्द्रियाः ।\nएते चान्ये च बहवो वेदवेदाङ्गपारगाः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2119243, "chapter_id": 3562, "verse_number": "२६", "content_sanskrit": "उपासिरे महात्मानः सभायामृषिसत्तमाः ।\nकथयन्तः कथाः शुभ्राः शुचयो धर्मवत्सलाः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2119244, "chapter_id": 3562, "verse_number": "२७", "content_sanskrit": "तथैव क्षत्रियश्रेष्ठा धर्मराजमुपासिरे ।\nश्रीमांश्च सुमहात्मा च मुञ्जकेतुर्विवर्धनः ।\nसङ्ग्रामजयमुख्याश्चाप्युग्रसेनश्च भारत\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2119245, "chapter_id": 3562, "verse_number": "२८", "content_sanskrit": "क्षेमश्च वसुदानश्च वैदेहश्च कृतक्षणः ।\nकक्षसेनः क्षितिपतिः क्षेमकश्चापराजितः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2119246, "chapter_id": 3562, "verse_number": "२९", "content_sanskrit": "कम्भोजराजः कमठः कम्पनश्च महाबलः ।\nसततं कम्पयामास यवनानेक एव यः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2119247, "chapter_id": 3562, "verse_number": "३०", "content_sanskrit": "यथाऽसुरान् कालकेयान् देवो वज्रधरस्तथा ।\nबलपौरुषसम्पन्नान् कृतास्त्रानमितौजसः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2119248, "chapter_id": 3562, "verse_number": "३१", "content_sanskrit": "जटासुरो भद्रकान्तश्च राजा\nकुणिः पुलिन्दश्च किरातराजः ।\nतथाऽङ्गवङ्गौ सह पुण्ड्रकेण\nपाण्ड्योऽथ राजा सह केरळेन\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2119249, "chapter_id": 3562, "verse_number": "३२", "content_sanskrit": "किरातराजः सुमनाः यवनाधिपतिस्तथा ।\nपाञ्चालश्च विराटश्च द्रुमशल्यः पृथुश्रवाः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2119250, "chapter_id": 3562, "verse_number": "३३", "content_sanskrit": "सुशर्मा चेकितानश्च मुख्यसेनश्च भारत ।\nसुधर्मा चानिरुद्धश्च श्रुतायुश्च महारथः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2119251, "chapter_id": 3562, "verse_number": "३४", "content_sanskrit": "अनूपराजो दुर्धर्षः क्षेमजिच्च सुदक्षिणः ।\nशिशुपालो दशग्रीवः करूशाधिपतिस्तथा\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2119252, "chapter_id": 3562, "verse_number": "३५", "content_sanskrit": "वृष्णीनां चैव दुर्धर्षाः कुमारा देवरूपिणः ।\nआहुकः विपृथुश्चैव गदः सारण एव च ।\nअक्रूरः कृतवर्मा च सात्यकिश्च शिनेः सुतः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2119253, "chapter_id": 3562, "verse_number": "३६", "content_sanskrit": "भीष्मको हृदिकश्चैव द्युमत्सेनश्च वीर्यवान् ।\nकेकयाश्च महेष्वासा यज्ञसेनश्च सोमकिः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2119254, "chapter_id": 3562, "verse_number": "३७", "content_sanskrit": "एते चान्ये च बहवः क्षत्रिया मुख्यसम्मताः ।\nउपासते सभायां स्म कुन्तीपुत्रं युधिष्ठिरम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2119255, "chapter_id": 3562, "verse_number": "३८", "content_sanskrit": "अर्जुनं तूपसङ्गृह्य राजपुत्रा यशस्विनः ।\nशिक्षन्ते स्म धनुर्वेदं रौरवाजिनवाससः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2119256, "chapter_id": 3562, "verse_number": "३९", "content_sanskrit": "तत्रैव शिक्षिताः सर्वे वृष्णिपुत्रा यशस्विनः ।\nप्रद्युम्नो रौक्मिणेयश्च युयुधानश्च सात्यकिः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2119257, "chapter_id": 3562, "verse_number": "४०", "content_sanskrit": "चाणूरो देवरातश्च भोजो भैमरथोऽपि च ।\nशतायुधश्च काळिङ्गो यज्ञसेनश्च मागधः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2119258, "chapter_id": 3562, "verse_number": "४१", "content_sanskrit": "एते चान्ये च बहवो राजपुत्रा महाबलाः ।\nधनञ्जयमुपातिष्ठन् धनुर्वेदचिकीर्षवः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2119259, "chapter_id": 3562, "verse_number": "४२", "content_sanskrit": "धनञ्जयसखा तत्र नित्यमास्ते स तुम्बुरुः ।\nउपासते तमासीनं गन्धर्वाः सप्तविंशतिः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2119260, "chapter_id": 3562, "verse_number": "४३", "content_sanskrit": "चित्रसेनः सहामात्यो गन्धर्वाप्सरसां गणैः ।\nतस्यां सभायामास्ते स्म बहुभिः परिवारितः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2119261, "chapter_id": 3562, "verse_number": "४४", "content_sanskrit": "गीतवादित्रकुशलाः शम्याताळविशारदाः ।\nप्रमाणे च लये स्थाने किन्नराश्च कृतश्रमाः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2119262, "chapter_id": 3562, "verse_number": "४५", "content_sanskrit": "ते चोदितास्तुम्बुरुणा गन्धर्वाः किन्नरैः सह ।\nदिव्यतानेषु गायन्ति गाथा दिव्याश्च भारत\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2119263, "chapter_id": 3562, "verse_number": "४६", "content_sanskrit": "शम्याताळेषु कुशलाः गीतवाद्यविशारदाः ।\nपाण्डवेयानृषींश्चैव रमयन्त उपासते \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2119264, "chapter_id": 3562, "verse_number": "४७", "content_sanskrit": "तस्यां सभायामृषयो राजानश्च पृथग्विधाः ।\nदिवीव देवा देवेशं युधिष्ठिरमुपासते\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2119265, "chapter_id": 3562, "verse_number": "४", "content_sanskrit": "॥ इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि चतुर्थोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2119266, "chapter_id": 3562, "verse_number": "४", "content_sanskrit": "॥ मन्त्रपर्वणि चतुर्थोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2119267, "chapter_id": 3562, "verse_number": "", "content_sanskrit": "—— ०  ——", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]