[{"id": 2186233, "chapter_id": 4954, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2186234, "chapter_id": 4954, "verse_number": "१", "content_sanskrit": "धनिनो वाधना ये च वर्तयन्ति स्वतन्त्रिणः ।\nसुखदुःखागमस्तेषां कः कथं वा पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2186235, "chapter_id": 4954, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2186236, "chapter_id": 4954, "verse_number": "२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nशम्याकेन विमुक्तेन गीतं शान्तिगतेन ह\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2186237, "chapter_id": 4954, "verse_number": "३", "content_sanskrit": "अब्रवीन्मां पुरा कश्चिद्ब्राह्मणस्त्यागमास्थितः ।\nक्लिश्यमानः कुदारेण कुचैलेन बुभुक्षया\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2186238, "chapter_id": 4954, "verse_number": "४", "content_sanskrit": "उत्पन्नमिह लोके वै जन्मप्रभृति मानवम् ।\nविविधान्युपवर्तन्ते दुःखानि च सुखानि च\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2186239, "chapter_id": 4954, "verse_number": "५", "content_sanskrit": "तयोरेकतरे मार्गे यद्येनमभिसंनयेत् ।\nन सुखं प्राप्य संहृष्येन्न दुःखं प्राप्य सञ्ज्वरेत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2186240, "chapter_id": 4954, "verse_number": "६", "content_sanskrit": "न वै चरसि यच्छ्रेय आत्मनो वा यदीहसे ।\nअकामात्मापि हि सदा धुरमुद्यम्य चैव हि\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2186241, "chapter_id": 4954, "verse_number": "७", "content_sanskrit": "अकिञ्चनः परिपतन् सुखमास्वादयिष्यसि ।\nअकिञ्चनः सुखं शेते समुत्तिष्ठति चैव हि\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2186242, "chapter_id": 4954, "verse_number": "८", "content_sanskrit": "आकिञ्चन्यं सुखं लोके पथ्यं शिवमनामयम् ।\nअनमित्रमथो ह्येतद्दुर्लभं सुलभं सताम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2186243, "chapter_id": 4954, "verse_number": "९", "content_sanskrit": "अकिञ्चनस्य शुद्धस्य उपपन्नस्य सर्वशः ।\nअवेक्षमाणस्त्रीँल्लोकान्न तुल्यमुपलक्षये\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2186244, "chapter_id": 4954, "verse_number": "१०", "content_sanskrit": "आकिञ्चन्यं च राज्यं च तुलया समतोलयम् ।\nअत्यरिच्यत दारिद्र्यं राज्यादपि गुणाधिकम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2186245, "chapter_id": 4954, "verse_number": "११", "content_sanskrit": "आकिञ्चन्ये च राज्ये च विशेषः सुमहानयम् ।\nनित्योद्विग्नो हि धनवान्मृत्योरास्यगतो यथा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2186246, "chapter_id": 4954, "verse_number": "१२", "content_sanskrit": "नैवास्याग्निर्न चादित्यो न मृत्युर्न च दस्यवः ।\nप्रभवन्ति धनज्यानिनिर्मुक्तस्य निराशिषः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2186247, "chapter_id": 4954, "verse_number": "१३", "content_sanskrit": "तं वै सदा कामचरमनुपस्तीर्णशायिनम् ।\nबाहूपधानं शाम्यन्तं प्रशंसन्ति दिवौकसः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2186248, "chapter_id": 4954, "verse_number": "१४", "content_sanskrit": "धनवान् क्रोधलोभाभ्यामाविष्टो नष्टचेतनः ।\nतिर्यगीक्षः शुष्कमुखः पापको भ्रुकुटीमुखः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2186249, "chapter_id": 4954, "verse_number": "१५", "content_sanskrit": "निर्दशंश्चाधरोष्ठं च क्रुद्धो दारुणभाषिता ।\nकस्तमिच्छेत् परिद्रष्टुं दातुमिच्छति चेन्महीम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2186250, "chapter_id": 4954, "verse_number": "१६", "content_sanskrit": "श्रिया ह्यभीक्ष्णं संवासो मोहयत्यविचक्षणम् ।\nसा तस्य चित्तं हरति शारदाभ्रमिवानिलः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2186251, "chapter_id": 4954, "verse_number": "१७", "content_sanskrit": "अथैनं रूपमानश्च धनमानश्च विन्दति ।\nअभिजातोऽस्मि सिद्धोऽस्मि नास्मि केवलमानुषः॥\nइत्येभिः कारणैस्तस्य त्रिभिश्चित्तं प्रसिच्यते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2186252, "chapter_id": 4954, "verse_number": "१८", "content_sanskrit": "स प्रसिक्तमना भोगान् विसृज्य पितृसञ्चितान् ।\nपरिक्षीणः परस्वानामादानं साधु मन्यते\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2186253, "chapter_id": 4954, "verse_number": "१९", "content_sanskrit": "तमतिक्रान्तमर्यादमाददानं ततस्ततः ।\nप्रतिषेधन्ति राजानो लुब्धा मृगमिवेषुभिः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2186254, "chapter_id": 4954, "verse_number": "२०", "content_sanskrit": "एवमेतानि दुःखानि तानि तानीह मानवम् ।\nविविधान्युपवर्तन्ते गात्रसंस्पर्शजानि च\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2186255, "chapter_id": 4954, "verse_number": "२१", "content_sanskrit": "तेषां परमदुःखानां बुद्ध्या भैषज्यमाचरेत् ।\nलोकधर्मं समाज्ञाय ध्रुवाणामध्रुवैः सह\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2186256, "chapter_id": 4954, "verse_number": "२२", "content_sanskrit": "नात्यक्त्वा सुखमाप्नोति नात्यक्त्वा विन्दते परम् ।\nनात्यक्त्वा चाभयः शेते त्यक्त्वा सर्वं सुखी भव\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2186257, "chapter_id": 4954, "verse_number": "२३", "content_sanskrit": "इत्येतद्धास्तिनपुरे ब्राह्मणेनोपवर्णितम् ।\nशम्याकेन पुरा मह्यं तस्मात्त्यागः परो मतः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2186258, "chapter_id": 4954, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे तृतीयोऽध्यायः ॥३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]