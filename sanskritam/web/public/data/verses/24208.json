[{"id": 7004208000, "chapter_id": 24208, "verse_number": "५-१-५७-१", "content_sanskrit": "सनत्कुमार उवाच ।\nशृणु व्यास प्रवक्ष्यामि तीर्थमेकमतः परम् ।\nतीर्थानामुत्तमं तीर्थं गयानामेति नामतः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004208001, "chapter_id": 24208, "verse_number": "५-१-५७-२", "content_sanskrit": "तत्र स्नात्वा नरो नित्यं मुच्यते च ऋणत्रयात् ।\nदेवान्पितॄन्समभ्यर्च्य विष्णुलोकं स गच्छति॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004208002, "chapter_id": 24208, "verse_number": "५-१-५७-३", "content_sanskrit": "व्यास उवाच ।\nकीकटेषु गया पुण्या नदी पुण्या पुनः पुना ।\nच्यवनस्याश्रमः पुण्यः पुण्यो राजगिरिस्तथा॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004208003, "chapter_id": 24208, "verse_number": "५-१-५७-४", "content_sanskrit": "स कथं विदितो देशे महाकालवने शुभे ।\nएतद्वेदितुमिच्छामि विस्तरेण तपोधन॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004208004, "chapter_id": 24208, "verse_number": "५-१-५७-५", "content_sanskrit": "सनत्कुमार उवाच ।\nशृणु व्यास कथां पुण्यां पवित्रां पापहारिणीम् ।\nयस्याः श्रवणमात्रेण पितरो यांति सद्गतिम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004208005, "chapter_id": 24208, "verse_number": "५-१-५७-६", "content_sanskrit": "पुरा कृतयुगे पुण्ये युगादिदेवनामतः ।\nराजासीत्स तु धर्मात्मा पुण्यश्रवणकीर्तनः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004208006, "chapter_id": 24208, "verse_number": "५-१-५७-७", "content_sanskrit": "तस्य पालयतः सम्यक्प्रजाः पुत्रानिवौरसान् ।\nबभूवुः सर्वसंपन्ना वर्धमानाः समंततः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004208007, "chapter_id": 24208, "verse_number": "५-१-५७-८", "content_sanskrit": "धर्मश्चतुष्पदो नित्यं यस्मिन्राज्ञि प्रशासति ।\nकालवर्षी च पर्जन्य ऋतवः स्वांगचारिणः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004208008, "chapter_id": 24208, "verse_number": "५-१-५७-९", "content_sanskrit": "बहुसस्यफला पृथ्वी गावश्च बहुदुग्धदाः ।\nवेदवादरता विप्राः क्षत्त्रिया बाहुशालिनः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004208009, "chapter_id": 24208, "verse_number": "५-१-५७-१०", "content_sanskrit": "वैश्या धनपरा नित्यं शूद्राः शुश्रूषणे रताः ।\nवर्णाश्रमरताः सर्वे सर्वे धर्मोपदेशकाः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004208010, "chapter_id": 24208, "verse_number": "५-१-५७-११", "content_sanskrit": "श्रुतिस्मृतिपरो धर्मो हृष्टपुष्टजनाकरः ।\nनाधिव्याध्यभिभूतश्च लक्ष्यते कोऽपि मानवः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004208011, "chapter_id": 24208, "verse_number": "५-१-५७-१२", "content_sanskrit": "दुःशीला दुर्भगा नारी विधवा नैव लक्ष्यते ।\nबहुपुत्राऽल्पपुत्रा च मृतपुत्रा न वंध्यका॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004208012, "chapter_id": 24208, "verse_number": "५-१-५७-१३", "content_sanskrit": "रूपशीलगुणोपेता पतिव्रतपरायणा ।\nनो मार्गः कंटसंकीर्णो दस्युदोषैश्च दूषितः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004208013, "chapter_id": 24208, "verse_number": "५-१-५७-१४", "content_sanskrit": "हूयतां भुज्यतां शश्वद्दीयतां च गृहेगृहे ।\nदयादानतपोहोमजपयज्ञक्रियापराः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004208014, "chapter_id": 24208, "verse_number": "५-१-५७-१५", "content_sanskrit": "जनाः सर्वत्र दृश्यंते सर्वधर्म परायणाः ।\nचतुष्पादचरो धर्मो ह्यधर्मोऽपादविग्रहः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004208015, "chapter_id": 24208, "verse_number": "५-१-५७-१६", "content_sanskrit": "एवं राजा स धर्मात्मा युगादिदेवसंज्ञितः ।\nयेनेयं पालिता पृथ्वी धर्मेण वर्धिताः प्रजाः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004208016, "chapter_id": 24208, "verse_number": "५-१-५७-१७", "content_sanskrit": "अवंत्यां च पुरा व्यास यज्ञकोटिं समाचरत् ।\nतस्मिन्कालेतिविक्रांतस्तुहंडो नाम दानवः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004208017, "chapter_id": 24208, "verse_number": "५-१-५७-१८", "content_sanskrit": "तेन सर्वं वशं नीतं चरा चरमिदंजगत् ।\nघोरं तप्त्वा तपः पुण्यं ब्रह्मलब्धवरः खलः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004208018, "chapter_id": 24208, "verse_number": "५-१-५७-१९", "content_sanskrit": "नैव देवा न यज्ञाश्च वेदमार्गविवर्जिताः ।\nदेवतापूजनं नास्ति स्वधा स्वाहा न दृश्यते॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004208019, "chapter_id": 24208, "verse_number": "५-१-५७-२०", "content_sanskrit": "उत्सन्नो धर्ममार्गोऽयं शाश्वतो वै दुरात्मना ।\nनष्टप्रायाः सुरास्तेन कृताः सर्वे द्विजोत्तमाः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004208020, "chapter_id": 24208, "verse_number": "५-१-५७-२१", "content_sanskrit": "ब्रह्माणं शरणं जग्मुः पितृभिः सह साधुभिः ।\nकिं कुर्मो वा क्व गच्छाम तुहंडेन पराजिताः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004208021, "chapter_id": 24208, "verse_number": "५-१-५७-२२", "content_sanskrit": "इति श्रुत्वा वचस्तेषां ब्रह्मा लोकपितामहः ।\nसमुत्थाय ततः सर्वैर्विष्णुलोकं जगाम ह॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004208022, "chapter_id": 24208, "verse_number": "५-१-५७-२३", "content_sanskrit": "तत्र गत्वा समाराध्य विष्णुं देवगणैः सह ।\nस्तुतिं पुरुषसूक्तेन विष्णोरतुलतेजसः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004208023, "chapter_id": 24208, "verse_number": "५-१-५७-२४", "content_sanskrit": "प्रचक्रुः सर्व एवैते ह्यात्मनोभ्युदयाय च ।\nतदा तेषां शमिच्छन्ती वागुवाचाशरीरिणी॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004208024, "chapter_id": 24208, "verse_number": "५-१-५७-२५", "content_sanskrit": "श्रूयतां भोः सुरश्रेष्ठा भवतां श्रेय उत्तमम् ।\nयूयं यात क्षितौ क्षिप्रं महाकालवनं प्रति॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004208025, "chapter_id": 24208, "verse_number": "५-१-५७-२६", "content_sanskrit": "गुह्याद्गुह्यतरं पुण्यं पवित्रं पापनाशनम् ।\nनो यत्र मायिनां माया प्रकाशयति भूतले॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004208026, "chapter_id": 24208, "verse_number": "५-१-५७-२७", "content_sanskrit": "सर्वतीर्थमयं तीर्थं कोटितीर्थवरप्रदम् ।\nयत्र शिप्रा सरिच्छ्रेष्ठा सर्वकामफलप्रदा॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004208027, "chapter_id": 24208, "verse_number": "५-१-५७-२८", "content_sanskrit": "दैत्यांतकारिणी दिव्या महाकाली कुलेश्वरी ।\nकोटिकोटिगणाकीर्णा मातॄ णां शक्तिवर्धिनी॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004208028, "chapter_id": 24208, "verse_number": "५-१-५७-२९", "content_sanskrit": "यत्र गया महापुण्या फल्गुश्चैव महानदी ।\nपुरुषोत्तमगिरिश्रेष्ठो यत्र बुद्धगया स्मृता॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004208029, "chapter_id": 24208, "verse_number": "५-१-५७-३०", "content_sanskrit": "तथैवाद्यगया ख्याता त्रिषु लोकेषु विश्रुता ।\nविष्णोः षोडशपदीतीर्थं गदाधरविनिर्मितम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004208030, "chapter_id": 24208, "verse_number": "५-१-५७-३१", "content_sanskrit": "सर्वपापहरा पुण्या यत्र प्राची सरस्वती ।\nमहासुरनदी प्रोक्ता यत्र तिष्ठति पुण्यदा॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004208031, "chapter_id": 24208, "verse_number": "५-१-५७-३२", "content_sanskrit": "न्यग्रोधश्चाक्षयो नित्यः पुरा प्रोक्तो महर्षिणा ।\nतत्रैव सा शिला प्रोक्ता प्रेतमोक्षकरी शुभा॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004208032, "chapter_id": 24208, "verse_number": "५-१-५७-३३", "content_sanskrit": "तत्रैव संति ताः सर्वा देवताः पितृकल्पजाः ।\nसर्वाक्षरमयोंकारः सर्वदेवमयो हरिः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004208033, "chapter_id": 24208, "verse_number": "५-१-५७-३४", "content_sanskrit": "सर्वतीर्थमया देवा गयातीर्थमनुत्तमम् ।\nशीघ्रं गच्छत तत्रैव परां सिद्धि मवाप्स्यथ॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004208034, "chapter_id": 24208, "verse_number": "५-१-५७-३५", "content_sanskrit": "यत्र प्रविष्टमात्रेण पितरो निरयस्थिताः ।\nते सर्वे स्वर्गमायांति ब्रह्मभूयाय कल्पते॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]