[{"id": 7003252000, "chapter_id": 23252, "verse_number": "१-५५-१", "content_sanskrit": "सूत उवाच  ।\nसौरं संक्षेपतो वक्ष्ये रथं शशिन एव च  ।\nग्रहणामितरेषां च यथा गच्छति चांबुपः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003252001, "chapter_id": 23252, "verse_number": "१-५५-२", "content_sanskrit": "सौरस्तु ब्रह्मणा सृष्टो रथस्त्वर्थवशेन सः  ।\nसंवत्सरस्यावयवैः कल्पितश्च द्विजर्षभाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003252002, "chapter_id": 23252, "verse_number": "१-५५-३", "content_sanskrit": "त्रिणा भिना तु चक्रेण पंचारेण समन्वितः  ।\nसौवर्णः सर्वदेवानामावासो भास्करस्य तु ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003252003, "chapter_id": 23252, "verse_number": "१-५५-४", "content_sanskrit": "नवयोजनसाहस्रो विस्तारायामतः स्मृतः  ।\nद्विगुणोपि रथोपस्थादीषादण्डः प्रमाणतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003252004, "chapter_id": 23252, "verse_number": "१-५५-५", "content_sanskrit": "असंगौस्तु हयैर्युक्तो यतश्चक्रं ततः स्थितैः  ।\nवाजिनस्तस्य वै सप्त छन्दोभिर्निर्मितास्तु ते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003252005, "chapter_id": 23252, "verse_number": "१-५५-६", "content_sanskrit": "चक्रपक्षे निबद्धास्तु ध्रुवे चाक्षः समर्पितः  ।\nसहाश्वचक्रो भ्रमते सहाक्षो भ्रमते ध्रुवः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003252006, "chapter_id": 23252, "verse_number": "१-५५-७", "content_sanskrit": "अक्षः सहैकचक्रेण भ्रमतेऽसौ ध्रुवेरितः  ।\nप्रेरको ज्योतिषां धीमान् ध्रुवो वै वातरशिमभिः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003252007, "chapter_id": 23252, "verse_number": "१-५५-८", "content_sanskrit": "युगाक्षकोटिसंबद्धौ द्वौ रश्मी स्यन्दनस्य तु  ।\nध्रुवेण भ्रमते रश्मिनिबद्धः स युगाक्षयोः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003252008, "chapter_id": 23252, "verse_number": "१-५५-९", "content_sanskrit": "भ्रमतो मंडलानि स्युः खेचरस्य रथस्य तु  ।\nयुगाक्षकोटी ते तस्य दक्षिणे स्यंदनस्य हि ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003252009, "chapter_id": 23252, "verse_number": "१-५५-१०", "content_sanskrit": "ध्रुवेण प्रगृहीते वै विचक्राश्वे च रज्जुभिः  ।\nभ्रमंतमनुगच्छंति ध्रुवं रश्मी च तावुभौ ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003252010, "chapter_id": 23252, "verse_number": "१-५५-११", "content_sanskrit": "युगाक्षकोटिस्त्वेतस्य वातोर्मिस्यन्दनस्य तु  ।\nकीले सक्ता यथा रज्जुर्भ्रमते सर्वतोदिशम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003252011, "chapter_id": 23252, "verse_number": "१-५५-१२", "content_sanskrit": "भ्राम्यतस्तस्य रश्मी तु मंडलेषूत्तरायणे  ।\nवर्धेते दक्षिणे चैव भ्रमता मंडलानि तु ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003252012, "chapter_id": 23252, "verse_number": "१-५५-१३", "content_sanskrit": "आकृष्येते यदा ते वै ध्रुवेणाधिष्ठिते तदा  ।\nआभ्यंतरस्थः सूर्योथ भ्रमते मंडलानि तु ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003252013, "chapter_id": 23252, "verse_number": "१-५५-१४", "content_sanskrit": "अशीतिमंडलशतं काष्ठयोरंतरं द्वयोः  ।\nध्रुवेण मुच्यमानाभ्यां रश्मिभ्यां पुनरेव तु ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003252014, "chapter_id": 23252, "verse_number": "१-५५-१५", "content_sanskrit": "तथैव बाह्यतः सूर्यो भ्रमते मंडलानि तु  ।\nउद्वेष्टयन् स वेगेन मंडलानि तु गच्छति ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003252015, "chapter_id": 23252, "verse_number": "१-५५-१६", "content_sanskrit": "देवाश्चैव तथा नित्यं मुनयश्च दिवानिशम्  ।\nयजंति सततं देवं भास्करं भवमीश्वरम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003252016, "chapter_id": 23252, "verse_number": "१-५५-१७", "content_sanskrit": "स रथोधिष्ठितो देवैरादित्यैर्मुनिभिस्तथा  ।\nगंधर्वैरप्सरोभिश्च ग्रामणीसर्पराक्षसैः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003252017, "chapter_id": 23252, "verse_number": "१-५५-१८", "content_sanskrit": "एते वसंति वै सूर्ये द्वौ द्वौ मासौ क्रमेण तु  ।\nआप्याययंति चादित्यं तेजोभिर्भास्करं शिवम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003252018, "chapter_id": 23252, "verse_number": "१-५५-१९", "content_sanskrit": "ग्रथितैः स्वैर्वचोभिस्तु स्तुवंति मुनयो रविम्  ।\nगंधर्वाप्सरसश्चैव नृत्यगेयैरुपासते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003252019, "chapter_id": 23252, "verse_number": "१-५५-२०", "content_sanskrit": "ग्रामणीयक्षभूतानि कुर्वतेऽभीषुसंग्रहम्  ।\nसर्पा वहंति वै सूर्यं यातुधानानुयांति च ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003252020, "chapter_id": 23252, "verse_number": "१-५५-२१", "content_sanskrit": "वालखिल्या नयंत्यस्तं परिवार्योदयाद्रविम्  ।\nइत्येते वै वसंतीह द्वौ द्वौ मासौ दिवाकरे ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003252021, "chapter_id": 23252, "verse_number": "१-५५-२२", "content_sanskrit": "मधुश्च माधवश्चैव शुक्रश्च शुचिरेव च  ।\nनभोनभस्यौ विप्रेन्द्रा इषश्चोर्जस्तथैव च ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003252022, "chapter_id": 23252, "verse_number": "१-५५-२३", "content_sanskrit": "सहः सहस्यौ च तथा तपस्यश्च तपः पुनः  ।\nएते द्वादश मासास्तु वर्षं वै मानुषं द्विजाः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003252023, "chapter_id": 23252, "verse_number": "१-५५-२४", "content_sanskrit": "वासंतिकस्तथा ग्रैष्मः शुभो वै वार्षिकस्तथा  ।\nशारदश्च हिमश्चैव शैशिरो ऋतवः स्मृताः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003252024, "chapter_id": 23252, "verse_number": "१-५५-२५", "content_sanskrit": "धाताऽर्यमाऽथ मित्रश्च वरुणश्चेन्द्र एव च  ।\nविवस्वांश्चैव पूषा च पर्जन्योंशुर्भगस्तथा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003252025, "chapter_id": 23252, "verse_number": "१-५५-२६", "content_sanskrit": "त्वष्टा विष्णुः पुलस्त्यश्च पुलहश्चत्रिरेव च  ।\nवसिष्ठश्चाङ्गिगश्चैव भृगुर्बुद्धिमतां वरः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003252026, "chapter_id": 23252, "verse_number": "१-५५-२७", "content_sanskrit": "भारद्वाजो गौतमश्च कश्यपश्च क्रतुस्तथा  ।\nजमदग्निः कौशिकश्च वासुकिः कंकणी करः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003252027, "chapter_id": 23252, "verse_number": "१-५५-२८", "content_sanskrit": "तक्षकश्च तथा नाग एलापत्रस्तथा द्विजाः  ।\nशंखपालस्तथा चान्यस्त्वैरावत इति स्मृतः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003252028, "chapter_id": 23252, "verse_number": "१-५५-२९", "content_sanskrit": "धनंजयो महापद्मस्तथा कर्कोटकः स्मृतः  ।\nकंबलोऽश्वतरश्चैव तुंबुरुर्नारदस्तथा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003252029, "chapter_id": 23252, "verse_number": "१-५५-३०", "content_sanskrit": "हाहा हूहूर्मुनिश्रेष्ठा विश्वावसुरनुत्तमः  ।\nउग्रसेनोऽथ सुरुचिरन्यश्चैव परावसुः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003252030, "chapter_id": 23252, "verse_number": "१-५५-३१", "content_sanskrit": "चित्रसेनो महातेजाश्चोर्णायुश्चैव सुव्रताः  ।\nधृतराष्ट्रः सूर्यवर्चा देवी साक्षात्कृतस्थला ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003252031, "chapter_id": 23252, "verse_number": "१-५५-३२", "content_sanskrit": "शुभानना शुबश्रोणिर्दिव्या वै पुंजिकस्थला  ।\nमेनका सहजन्या च प्रम्लोचाऽथ शुचिस्मिता ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003252032, "chapter_id": 23252, "verse_number": "१-५५-३३", "content_sanskrit": "अनुम्लोचा घृताची च विश्वाची चोर्वशी तथा  ।\nपूर्वचित्तिरिति ख्याता देवी साक्षात्तिलोत्तमा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003252033, "chapter_id": 23252, "verse_number": "१-५५-३४", "content_sanskrit": "रंभा चांभोजवदना रथकृद्ग्रामणीः शुभः  ।\nरथौजा रथचित्रश्च सुबाहुर्वै रथस्वनः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003252034, "chapter_id": 23252, "verse_number": "१-५५-३५", "content_sanskrit": "वरुणश्च तथैवान्यः सुषेणः सेनजिच्छुभः  ।\nतार्क्ष्यश्चारिष्टनेमिश्च क्षतजित्सत्यजित्तथा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003252035, "chapter_id": 23252, "verse_number": "१-५५-३६", "content_sanskrit": "रक्षो हेतिः प्रहेतिश्च पौरुषेयो वधस्तथा  ।\nसर्पो व्याघ्रः पुनश्चापो वातो विद्युद्दिवाकरः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003252036, "chapter_id": 23252, "verse_number": "१-५५-३७", "content_sanskrit": "ब्रह्मोपेतश्च रक्षेन्द्रो यज्ञोपेतस्तथैव च  ।\nएते देवादयः सर्वे वसंत्यर्के क्रमेण तु ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003252037, "chapter_id": 23252, "verse_number": "१-५५-३८", "content_sanskrit": "स्थानाभिमानिनो ह्येते गणा द्वादश सप्तकाः  ।\nधात्रादिविष्णुपर्यंता देवा द्वादश कीर्तिताः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003252038, "chapter_id": 23252, "verse_number": "१-५५-३९", "content_sanskrit": "आदित्यं परमं भानुं भाभिराप्याययंति ते  ।\nपुलस्त्याद्याः कौशिकांता मुनयो मुनिसत्तमाः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003252039, "chapter_id": 23252, "verse_number": "१-५५-४०", "content_sanskrit": "द्वादशैव स्तवैर्भानुं स्तुवन्ति च यथाक्रमम्  ।\nनागाश्चाश्वतरान्तास्तु वासुकिप्रमुखाः शुभाः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003252040, "chapter_id": 23252, "verse_number": "१-५५-४१", "content_sanskrit": "द्वादशैव महादेवं वहंत्येवं यताक्रमम्  ।\nक्रमेण सूर्यवर्चान्तास्तुंबुरु प्रमुखांबुपम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003252041, "chapter_id": 23252, "verse_number": "१-५५-४२", "content_sanskrit": "गीतैरेनमुपासंते गंधर्वा द्वादशोत्तमाः  ।\nकृतस्थलाद्या रंभांता दिव्याश्चाप्सरसो रविम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003252042, "chapter_id": 23252, "verse_number": "१-५५-४३", "content_sanskrit": "तांडवैः सरसैः सर्वाश्चोपासंते यथाक्रमम्  ।\nदिव्याः सत्यजिदन्ताश्च ग्रामण्यो रथकृन्मुखाः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003252043, "chapter_id": 23252, "verse_number": "१-५५-४४", "content_sanskrit": "द्वादशास्य क्रमेणैव कुर्वतेभीषुसंग्रहम्  ।\nप्रयांति यज्ञोपेतांता रक्षोहेतिमुखाः सह ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003252044, "chapter_id": 23252, "verse_number": "१-५५-४५", "content_sanskrit": "सायुधा द्वादशैवैते राक्षसाश्चा यथाक्रमम्  ।\nधातार्यमा पुलस्त्यश्च पुलहश्च प्रजापतिः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003252045, "chapter_id": 23252, "verse_number": "१-५५-४६", "content_sanskrit": "उरगो वासुकिश्चैव कंकणीकश्च तावुभौ  ।\nतुंबुरुर्नारदश्चैव गंधर्वौ गायतां वरौ ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003252046, "chapter_id": 23252, "verse_number": "१-५५-४७", "content_sanskrit": "कृतस्थलाऽप्सराश्चैव तथा वै पुंजिकस्थला  ।\nग्रामणी रथकृच्चैव रथौजाश्चैव तावुभौ ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003252047, "chapter_id": 23252, "verse_number": "१-५५-४८", "content_sanskrit": "रक्षो हेतिः प्रहेतिश्च यातुधानावुदाहृतौ  ।\nमधुमाधवयोरेष गणो वसति भास्करे ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003252048, "chapter_id": 23252, "verse_number": "१-५५-४९", "content_sanskrit": "वसंति ग्राष्मिकौ मासौ मित्रश्च वरुणश्च ह  ।\nऋषिरत्रिर्वसिष्ठश्च तक्षको नाग एव च ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003252049, "chapter_id": 23252, "verse_number": "१-५५-५०", "content_sanskrit": "मेनका सहजन्या च गंधर्वै च हहाहुहूः  ।\nसुबाहुनामा ग्रामण्यौ रथचित्रश्च तावुभौ ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003252050, "chapter_id": 23252, "verse_number": "१-५५-५१", "content_sanskrit": "पौरुषेयो वधश्चैव यातुधानावुदाहृतौ  ।\nएते वसंति वै सूर्ये मासयोः शुचिशुक्रयोः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003252051, "chapter_id": 23252, "verse_number": "१-५५-५२", "content_sanskrit": "ततः सूर्ये पुनश्चान्या निवसंतीह देवताः  ।\nइन्द्रश्चैव विवस्वांश्च आंगिरा भृगुरेव च ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003252052, "chapter_id": 23252, "verse_number": "१-५५-५३", "content_sanskrit": "एलापत्रस्तथा सर्पः शंखपालश्च तावुभौ  ।\nविश्वावसूग्रसेनौ च वरुणश्च रथस्वनः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003252053, "chapter_id": 23252, "verse_number": "१-५५-५४", "content_sanskrit": "प्रम्लोचा चैव विख्याता अनुम्लोचा च ते उभे  ।\nयातुधानास्तथा सर्पो व्याघ्रश्चैव तु तावुभौ ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003252054, "chapter_id": 23252, "verse_number": "१-५५-५५", "content_sanskrit": "नभोनभस्ययोरेष गणो वसति भास्करे  ।\nपर्जन्यश्चैव पूषा च भरद्वाजोऽथ गौतमः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003252055, "chapter_id": 23252, "verse_number": "१-५५-५६", "content_sanskrit": "धनंजय इरावांश्च सुरुचिः सपरावसुः  ।\nघृताची चाप्सरः श्रेष्ठा विश्वाची चातिशोभना ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003252056, "chapter_id": 23252, "verse_number": "१-५५-५७", "content_sanskrit": "सेनजिच्च सुषेणश्च सेनानीर्ग्रामणीश्च तौ  ।\nआपो वातश्च तावेचौ यातुधानावुभौ स्मृतौ ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003252057, "chapter_id": 23252, "verse_number": "१-५५-५८", "content_sanskrit": "वसंत्येते तु वै सूर्ये मास ऊर्ज इषे च ह  ।\nहैमंतिकौ तु द्वौ मासौ वसंति च दिवाकरे ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003252058, "chapter_id": 23252, "verse_number": "१-५५-५९", "content_sanskrit": "अंशुर्भगश्च द्वावेतौ कश्यपश्च क्रतुः सह  ।\nभुजंगश्च महापद्मः सर्पः कर्कोटकस्तथा ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003252059, "chapter_id": 23252, "verse_number": "१-५५-६०", "content_sanskrit": "चित्रसेनश्च गन्धर्व ऊर्णायुश्चैव तावुभौ  ।\nउर्वशी पूर्वचित्तिश्च तथैवाप्सरसावुभे ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003252060, "chapter_id": 23252, "verse_number": "१-५५-६१", "content_sanskrit": "तार्क्ष्यश्चारिष्टनेमिश्च सेनानीर्ग्रामणीश्च तौ  ।\nविद्युद्दिवाकरश्चोभौ यातुधानावुदाहृतौ ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003252061, "chapter_id": 23252, "verse_number": "१-५५-६२", "content_sanskrit": "सहे चैव सहस्ये च वसंत्येते दिवाकरे  ।\nततः शौशीरयोश्चापि मासयोर्निवसंति वै ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003252062, "chapter_id": 23252, "verse_number": "१-५५-६३", "content_sanskrit": "त्वष्टा विष्णुर्जमदग्निर्विश्वामित्रस्तथैव च  ।\nकाद्रवेयौ तथा नागौ कंबलाश्वतरावुभौ ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003252063, "chapter_id": 23252, "verse_number": "१-५५-६४", "content_sanskrit": "धृतराष्ट्रः सगंधर्वः सूर्यवर्चास्तथैव च  ।\nतिलोत्तमाप्सराश्चैव देवी रंभा मनोहरा ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003252064, "chapter_id": 23252, "verse_number": "१-५५-६५", "content_sanskrit": "रथजित्सत्यजिच्चैव ग्रामम्यौ लोकविश्रुतौ  ।\nब्रह्मोपेतस्तथा रक्षो यज्ञोपेतश्च यः स्मृतः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003252065, "chapter_id": 23252, "verse_number": "१-५५-६६", "content_sanskrit": "एते देवा वसंत्यर्के द्वौ द्वौ मासौ क्रमेण तु  ।\nस्थानाभिमानिनो ह्येते गणा द्वादश सप्तकाः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003252066, "chapter_id": 23252, "verse_number": "१-५५-६७", "content_sanskrit": "सूर्यमाप्याययंत्येते तेजसा तेज उत्तमम्  ।\nग्रथितैः स्वैर्वचोभिस्तु स्तुवंति मुनयो रविम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003252067, "chapter_id": 23252, "verse_number": "१-५५-६८", "content_sanskrit": "गंधर्वाप्सरसश्चैव नृत्यगेयैरुपासते  ।\nग्रामणीयक्षभूतानि कुर्वतेभीषुसंग्रहम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003252068, "chapter_id": 23252, "verse_number": "१-५५-६९", "content_sanskrit": "सर्पा वहंति वै सूर्यं यातु धानानुयांति वै  ।\nवालखिल्या नयंत्यस्तं परिवार्योदयाद्रविम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003252069, "chapter_id": 23252, "verse_number": "१-५५-७०", "content_sanskrit": "एतेषामेव देवानां यथा तेजो यथा तपः  ।\nयता योगं यथा मन्त्रं यथा धर्मं यथा बलम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003252070, "chapter_id": 23252, "verse_number": "१-५५-७१", "content_sanskrit": "तथा तपत्यसौ सूर्यस्तेषामिद्धस्तु तेजसा  ।\nइत्येते वै वसंतीह द्वौ द्वौ मासौ दिवाकरे ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003252071, "chapter_id": 23252, "verse_number": "१-५५-७२", "content_sanskrit": "ऋषयो देवगंधर्वपन्नगाप्सरसां गणाः  ।\nग्रामण्यश्च तथा यक्षा यातुधानाश्च मुख्यतः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003252072, "chapter_id": 23252, "verse_number": "१-५५-७३", "content_sanskrit": "एते तपन्ति वर्षंति भांति वांति सृजंति च  ।\nभूतानामशुभं कर्म व्यपोहन्तीह कीर्तिताः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003252073, "chapter_id": 23252, "verse_number": "१-५५-७४", "content_sanskrit": "मानवानां शुभं ह्येते हरंति च दुरात्मनाम्  ।\nदुरितं सुप्रचाराणां व्यपोहंति क्वचित् क्वचित् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003252074, "chapter_id": 23252, "verse_number": "१-५५-७५", "content_sanskrit": "विमाने च स्थिता दिव्ये कामगे वातरंहसि  ।\nएते सहैव सूर्येण भ्रमंति दिवसानुगाः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003252075, "chapter_id": 23252, "verse_number": "१-५५-७६", "content_sanskrit": "वर्षन्तश्च तपंतश्च ह्लादयंतश्च वै द्विजाः  ।\nगोपायंतीह भूतानि सर्वाणि ह्यामनुक्षयात् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003252076, "chapter_id": 23252, "verse_number": "१-५५-७७", "content_sanskrit": "स्थानाबिमानिनामेतत्स्थानं मन्वन्तरेषु वै  ।\nअतीतानागतानां वै वर्तंते सांप्रतं च ये ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003252077, "chapter_id": 23252, "verse_number": "१-५५-७८", "content_sanskrit": "एते वसंति वै सूर्ये सप्तकास्ते चतुर्दश  ।\nचतुर्दशसु सर्वेषु गणा मन्वंतरेष्विह ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003252078, "chapter_id": 23252, "verse_number": "१-५५-७९", "content_sanskrit": "संक्षेपाद्विस्तराच्चैव यतावृत्तं यथाश्रुतम्  ।\nकथितं मुनिशार्दूला देवदेवस्य धीमतः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003252079, "chapter_id": 23252, "verse_number": "१-५५-८०", "content_sanskrit": "एते देवा वसंत्यर्के द्वौद्वौ मासौ क्रमेण तु  ।\nस्थानाभिमानिनो ह्येते गणा द्वादश सप्तकाः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003252080, "chapter_id": 23252, "verse_number": "१-५५-८१", "content_sanskrit": "इत्येष एकचक्रेण सूर्यस्तूर्णं रथेन तु  ।\nहरितैरक्षरैरश्वैः सर्पतेऽसौ दिवाकरः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003252081, "chapter_id": 23252, "verse_number": "१-५५-८२", "content_sanskrit": "अहोरात्रं रथेनासावेक चक्रणे तु भ्रमन्  ।\nसप्तद्वीपसमुद्रा गां सप्तभिः सर्पते दिवि ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}]