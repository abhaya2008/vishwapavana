[{"id": 2070258, "chapter_id": 2473, "verse_number": "११-७-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2070259, "chapter_id": 2473, "verse_number": "११-७-१", "content_sanskrit": "अहोऽभिहितमाख्यान भवता तत्त्वदर्शिना।\nभूय एव तु मे हर्षः श्रोतुं वागमृतं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2070260, "chapter_id": 2473, "verse_number": "११-७-२x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2070261, "chapter_id": 2473, "verse_number": "११-७-२", "content_sanskrit": "शृणु भूयः प्रवक्ष्यामि मार्गस्यैतस्य विस्तरम्।\nयच्छ्रुत्वा विप्रमुच्यन्ते संसाराद्वि विचक्षणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2070262, "chapter_id": 2473, "verse_number": "११-७-३", "content_sanskrit": "यथा तु पुरुषो राजन्दीर्घमध्वानमास्थितः।\nक्वचित्क्वचिच्छ्रमस्थानं कुरुते वासमेव वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2070263, "chapter_id": 2473, "verse_number": "११-७-४", "content_sanskrit": "एवं संसारपर्याये गर्भवासेषु भारत।\nकुर्वन्ति दुर्बुधा वासं मुच्यन्ते तत्र पण्डिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2070264, "chapter_id": 2473, "verse_number": "११-७-५", "content_sanskrit": "तस्मादध्वानमेवैतमाहुः शास्त्रविदो जनाः।\nयत्तत्संसारगहनं वनमाहुर्मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2070265, "chapter_id": 2473, "verse_number": "११-७-६", "content_sanskrit": "सोयं लोकसमावर्तो मर्त्यानां भरतर्षभ।\nचराणां स्थावराणां च न गृध्येत्तत्र पाण्डितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2070266, "chapter_id": 2473, "verse_number": "११-७-७", "content_sanskrit": "शारीरा मानसाश्चैव मर्त्यानां व्याधयश्च ये।\nप्रत्यक्षाश्च परोक्षाश्च ते व्यालाः कथिता बुधैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2070267, "chapter_id": 2473, "verse_number": "११-७-८", "content_sanskrit": "क्लिश्यमानाश्च तैर्नित्यं मार्यमाणाश्च भारत।\nस्वकर्मभिर्महाव्यालैर्नोद्विजन्त्यल्पबुद्धयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2070268, "chapter_id": 2473, "verse_number": "११-७-९", "content_sanskrit": "अथापि तैर्विमुच्येत व्याधिभिः पुरुषो नृप।\nआवृणोत्येव तं पश्चाज्जरा रूपविनाशिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2070269, "chapter_id": 2473, "verse_number": "११-७-१०", "content_sanskrit": "शब्दरूपरसस्पर्शगन्धैश्च विविधैरपि।\nमज्जमानं महापङ्के निरालम्बे समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2070270, "chapter_id": 2473, "verse_number": "११-७-११", "content_sanskrit": "संवत्सरर्तवो मासाः पक्षाहोरात्रसन्धयः।\nक्रमेणास्य प्रवृज्जन्ति रूपमायुस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2070271, "chapter_id": 2473, "verse_number": "११-७-१२", "content_sanskrit": "एते कालस्य विधयो नैताञ्जानान्ति दुर्बुधाः।\nधात्राऽभिलिखितान्याहुः सर्वभूतानि कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2070272, "chapter_id": 2473, "verse_number": "११-७-१३", "content_sanskrit": "रथः शरीरं भूतानां सत्वमाहुस्तु सारथिम्।\nइन्द्रियाणि हयानाहुः कर्मबुद्विस्तु रश्मयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2070273, "chapter_id": 2473, "verse_number": "११-७-१४", "content_sanskrit": "तेषां हयानां यो वेगं धावतामनु धावति।\nसतु संसारचक्रेऽस्मिंश्चक्रवत्परिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2070274, "chapter_id": 2473, "verse_number": "११-७-१५", "content_sanskrit": "यस्तान्संयमते बुद्ध्या संयतो न निवर्तते।\nयस्तु संसारचक्रेऽस्मिंश्चक्रवत्परिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2070275, "chapter_id": 2473, "verse_number": "११-७-१६", "content_sanskrit": "[भ्रममाणा न मुह्यन्ति संसारे न भ्रमन्ति ते।\nसंसारे भ्रमतां राजन्दुःखमेतद्धि जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2070276, "chapter_id": 2473, "verse_number": "११-७-१७", "content_sanskrit": "तस्पादस्य निवृत्त्यर्थं यत्नमेवाचरेद्बुधः।\nउपेक्षा नात्र कर्तव्या शतशाखः प्रवर्धते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2070277, "chapter_id": 2473, "verse_number": "११-७-१८", "content_sanskrit": "यतेन्द्रियो नरो राजन्क्रोधलोभनिराकृतः।\nसन्तुष्टः सत्यवादी यः स शान्तिमधिगच्छति॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2070278, "chapter_id": 2473, "verse_number": "११-७-१९", "content_sanskrit": "याम्यमाहू रथं ह्येनं मुह्यन्ते येन दुर्बुधाः।\nस चैतत्प्राप्नुयाद्राजन्यत्त्वं प्राप्तो नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2070279, "chapter_id": 2473, "verse_number": "११-७-२०", "content_sanskrit": "अनुतर्षुलमेवैतद्दुःखं भवति मारिष।\nराज्यनाशः सुहृन्नाशः सुतनाशश्च भारत।\nसाधुः परमदुःखानां दुःखभैषज्यमारभेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2070280, "chapter_id": 2473, "verse_number": "११-७-२१", "content_sanskrit": "ज्ञानौषधमवाप्येह दूरपारं महौषधम्।\nछिन्द्याद्दुःखमहाव्याधिं नरः संयतमानसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2070281, "chapter_id": 2473, "verse_number": "११-७-२२", "content_sanskrit": "न विक्रमो न चाप्यर्थो न मित्रं न सुहृज्जनः।\nतस्मान्मोचयते दुःखाद्यथात्मा स्थिरनिश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2070282, "chapter_id": 2473, "verse_number": "११-७-२३", "content_sanskrit": "तस्मान्मैत्रं समास्थाय शीलमापदि भारत।\nदमस्त्यागोऽप्रमादश्च ते त्रयो ब्रह्मणो हयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2070283, "chapter_id": 2473, "verse_number": "११-७-२४", "content_sanskrit": "शीलरश्मिसमायुक्ते स्थितो यो मानसे रथे।\nत्यक्त्वा मृत्युभयं राजन्ब्रह्मलोकं स गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2070284, "chapter_id": 2473, "verse_number": "११-७-२५", "content_sanskrit": "अभयं सर्वभूतेभ्यो यो ददाति महीपते।\nस गच्छति परं स्थानं विष्णोः पदमनामयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2070285, "chapter_id": 2473, "verse_number": "११-७-२६", "content_sanskrit": "न तत्क्रतुसहस्रेण नोपवासैश्च नित्यशः।\nअभयस्य च दानेन यत्फलं प्राप्नुयान्नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2070286, "chapter_id": 2473, "verse_number": "११-७-२७", "content_sanskrit": "न ह्यात्मनः प्रियतरं किञ्चिद्भूतेषु निश्चितम्।\nअनिष्टं सर्वभूतानां मरणं नाम भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2070287, "chapter_id": 2473, "verse_number": "११-७-२८", "content_sanskrit": "तस्मात्सर्वेषु भूतेषु दया कार्या विपश्चिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2070288, "chapter_id": 2473, "verse_number": "११-७-२९", "content_sanskrit": "नानायोगसमायुक्ता बुद्धिजालेन संवृताः।\nअसूक्ष्मदृष्टयो मन्दा भ्राम्यन्ते तत्रतत्र ह।\nसुसूक्ष्मदृष्टयो राजन्व्रजन्ति ब्रह्मसाम्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2070289, "chapter_id": 2473, "verse_number": "११-७-३०", "content_sanskrit": "एवं ज्ञात्वा महाप्राज्ञ स तेषामौर्ध्वदैहिकम्।\nकर्तुमर्हति तेनैव फल प्राप्स्यति वै भवान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2070290, "chapter_id": 2473, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते स्त्रीपर्वणि जलप्रदानिकपर्वणि सप्तमोऽध्यायः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]