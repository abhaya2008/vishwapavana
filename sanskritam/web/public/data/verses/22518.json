[{"id": 7002518000, "chapter_id": 22518, "verse_number": "१-१८०-१", "content_sanskrit": "गंगा पुण्या महादेवी यमुना नर्मदा नदी ।\nगौतमी चापि कावेरी वरुणा देविका तथा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002518001, "chapter_id": 22518, "verse_number": "१-१८०-२", "content_sanskrit": "सर्वग्रहपतिं देवं लोकेशं लोकनायकम् ।\nपूजयंति सदा नद्यः सूर्यसद्भावभाविताः ।\nशांतिं कुर्वंतु ते नित्यं सूर्यध्यानैकमानसाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002518002, "chapter_id": 22518, "verse_number": "१-१८०-३", "content_sanskrit": "निरंजना नाम नदी शोणश्चापि महानदः ।\nमंदाकिनी च परमा तथा सन्निहिता शुभा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002518003, "chapter_id": 22518, "verse_number": "१-१८०-४", "content_sanskrit": "एताश्चान्याश्च बहवो भुवि दिव्यंतरिक्षके ।\nसूर्यार्चनरता नद्यः कुर्वंतु तव शांतिकम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002518004, "chapter_id": 22518, "verse_number": "१-१८०-५", "content_sanskrit": "महावैश्रवणो देवो यक्षराजो महर्षिकः ।\nयक्षकोटिपरीवारो यक्षसंख्येयसंयुतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002518005, "chapter_id": 22518, "verse_number": "१-१८०-६", "content_sanskrit": "महाविभवसंपन्नः सूर्यपादार्चने रतः ।\nसूर्यध्यानैकपरमः सूर्यभावेन भावितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002518006, "chapter_id": 22518, "verse_number": "१-१८०-७", "content_sanskrit": "शांतिं करोतु ते प्रीतः पद्मपत्रायतेक्षणः ।\nमाणिभद्रो महायक्षो मणिरत्नविभूषितः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002518007, "chapter_id": 22518, "verse_number": "१-१८०-८", "content_sanskrit": "मनोहरेण हारेण कंठलग्नेन राजते ।\nयक्षिणीयक्षकन्याभिः परिवारितविग्रहः ।\nसूर्यार्चनसमासक्तः करोतु तव शांतिकम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002518008, "chapter_id": 22518, "verse_number": "१-१८०-९", "content_sanskrit": "सुचिरो नाम यक्षेंद्रो मणिकुडल भूषितः ।\nललाटे हेमपटलप्रबद्धेन विराजते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002518009, "chapter_id": 22518, "verse_number": "१-१८०-१०", "content_sanskrit": "बहुयक्षसमाकीर्णो यक्षैर्नमितविग्रहः ।\nसूर्यपूजापरो युक्तः करोतु तव शांतिकम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002518010, "chapter_id": 22518, "verse_number": "१-१८०-११", "content_sanskrit": "पांचिको नाम यक्षेंद्रः कंठाभरणभूषितः ।\nकुक्कुटेन विचित्रेण बहुरत्नान्वितेन तु ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002518011, "chapter_id": 22518, "verse_number": "१-१८०-१२", "content_sanskrit": "यक्षवृन्दसमाकीर्णो यक्षकोटिसमन्वितः ।\nसूर्यार्चनकरः श्रीमान्करोतु तव शांतिकम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002518012, "chapter_id": 22518, "verse_number": "१-१८०-१३", "content_sanskrit": "धृतराष्ट्रो महातेजा नानायक्षाधिपः खग ।\nदिव्यपट्टः शुक्लच्छत्रो मणिकांचनभूषितः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002518013, "chapter_id": 22518, "verse_number": "१-१८०-१४", "content_sanskrit": "सूर्यभक्तः सूर्यरतः सूर्यपूजापरायणः ।\nसूर्यप्रसादसंपन्नः करोतु तव शांतिकम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002518014, "chapter_id": 22518, "verse_number": "१-१८०-१५", "content_sanskrit": "विरूपाक्षश्च यक्षेंद्रः श्वेतवासा महाद्युतिः ।\nनानाकांचनमालाभिरुपशोभितकंधरः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002518015, "chapter_id": 22518, "verse_number": "१-१८०-१६", "content_sanskrit": "सूर्यपूजापरो भक्तः कंजाक्षः कंजसन्निभः ।\nतेजसादित्यसंकाशः करोतु तव शांतिकम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002518016, "chapter_id": 22518, "verse_number": "१-१८०-१७", "content_sanskrit": "अंतीरक्षगता यक्षा ये यक्षाः स्वर्गगामिनः ।\nनानारूपधरा यक्षाः सूर्यभक्ता दृढव्रताः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002518017, "chapter_id": 22518, "verse_number": "१-१८०-१८", "content_sanskrit": "तद्भक्तास्तद्गमनसः सूर्यपूजासमुत्सुकाः ।\nशांतिं कुर्वंतु ते हृष्टाः शांताः शांतिपरायणाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002518018, "chapter_id": 22518, "verse_number": "१-१८०-१९", "content_sanskrit": "यक्षिण्यो विविधाकारास्तथा यक्षकुमारकाः ।\nयक्षकन्या महाभागाः सूर्याराधनतत्पराः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002518019, "chapter_id": 22518, "verse_number": "१-१८०-२०", "content_sanskrit": "शांतिं स्वस्त्ययनं क्षेमं बलं कल्याणमुत्तमम् ।\nसिद्धिं चाशु प्रयच्छंतु नित्यं च सुसमाहिताः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002518020, "chapter_id": 22518, "verse_number": "१-१८०-२१", "content_sanskrit": "पर्वताः सर्वतः सर्वे वृक्षाश्चैव महर्द्धिकाः ।\nसूर्यभक्ताः सदा सर्वे शांतिं कुर्वंतु ते सदा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002518021, "chapter_id": 22518, "verse_number": "१-१८०-२२", "content_sanskrit": "सागराः सर्वतः सर्वे गृहारण्यानि कृत्स्नशः ।\nसूर्यस्याराधनपराः कुर्वंतु तव शांतिकम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002518022, "chapter_id": 22518, "verse_number": "१-१८०-२३", "content_sanskrit": "राक्षसाः सर्वतः सर्वे घोररूपा महाबलाः ।\nस्थलजा राक्षसा ये तु अंतरिक्षगताश्च ये ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002518023, "chapter_id": 22518, "verse_number": "१-१८०-२४", "content_sanskrit": "पाताले राक्षसा ये तु नित्यं सूर्यार्चने रताः ।\nशांतिं कुर्वंतु ते सर्वे तेजसा नित्यदीपिताः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002518024, "chapter_id": 22518, "verse_number": "१-१८०-२५", "content_sanskrit": "प्रेताः प्रेतगणाः सर्वे ये प्रेताः सर्वतोमुखाः ।\nअतिदीप्ताश्च ये प्रेता ये प्रेता रुधिराशनाः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002518025, "chapter_id": 22518, "verse_number": "१-१८०-२६", "content_sanskrit": "अंतरिक्षे च ये प्रेतास्तथा ये स्वर्गवासिनः ।\nपाताले भूतले वापि ये प्रेताः कामरूपिणः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002518026, "chapter_id": 22518, "verse_number": "१-१८०-२७", "content_sanskrit": "एकचक्रो रथो यस्य यस्तु देवो वृषध्वजः ।\nतेजसा तस्य देवस्य शांतिं कुर्वंतु ते सदा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002518027, "chapter_id": 22518, "verse_number": "१-१८०-२८", "content_sanskrit": "ये पिशाचा महावीर्या वृद्धिमंतो महाबलाः ।\nनानारूपधराः सर्वे सर्वे च गुणवत्तराः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002518028, "chapter_id": 22518, "verse_number": "१-१८०-२९", "content_sanskrit": "अंतरिक्षे पिशाचा ये स्वर्गे ये च महाबलाः ।\nपाताले भूतले ये च बहुरूपा मनोजवाः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002518029, "chapter_id": 22518, "verse_number": "१-१८०-३०", "content_sanskrit": "यस्याहं सारथिर्वीर यस्य त्वं तुरगः सदा ।\nतेजसा तस्य देवस्य शांतिं कुर्वंतु तेऽञ्जसा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002518030, "chapter_id": 22518, "verse_number": "१-१८०-३१", "content_sanskrit": "अपस्मारग्रहाः सर्वे सर्वे चापि ज्वरग्रहाः ।\nये च स्वर्गस्थिताः सर्वे भूमिगा ये ग्रहोत्तमाः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002518031, "chapter_id": 22518, "verse_number": "१-१८०-३२", "content_sanskrit": "पाताले तु ग्रहा ये च ये ग्रहाः सर्वतो गताः ।\nदक्षिणे किरणे यस्य सूर्यस्य च स्थितो हरिः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002518032, "chapter_id": 22518, "verse_number": "१-१८०-३३", "content_sanskrit": "हरो यस्य सदा वामे ललाटे कंजजः स्थितः ।\nतेजसा तस्य देवस्य शांतिं कुर्वंतु ते सदा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002518033, "chapter_id": 22518, "verse_number": "१-१८०-३४", "content_sanskrit": "इति देवादयः सर्वे सूर्ययज्ञविधायिनः ।\nकुर्वंतु जगतः शांतिं सूर्यभक्तेषु सर्वदा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002518034, "chapter_id": 22518, "verse_number": "१-१८०-३५", "content_sanskrit": "जयः सूर्याय देवाय तमोहंत्रे विवस्वते ।\nजयप्रदाय सूर्याय भास्कराय नमोस्तु ते ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002518035, "chapter_id": 22518, "verse_number": "१-१८०-३६", "content_sanskrit": "ग्रहोत्तमाय देवाय जयः कल्याणकारिणे ।\nजयः पद्मविकाशाय बुधरूपाय ते नमः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002518036, "chapter_id": 22518, "verse_number": "१-१८०-३७", "content_sanskrit": "जयः दीप्तिविधानाय जयः शांतिविधायिने ।\nतमोघ्नाय जयायैव अजिताय नमोनमः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002518037, "chapter_id": 22518, "verse_number": "१-१८०-३८", "content_sanskrit": "जयार्क जयदीप्तीश सहस्रकिरणोज्ज्वल ।\nजय निर्मितलोकस्त्वमजिताय नमोनमः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002518038, "chapter_id": 22518, "verse_number": "१-१८०-३९", "content_sanskrit": "गायत्रीदेहरूपाय सावित्रीदयिताय च ।\nधराधराय सूर्याय मार्तंडाय नमोनमः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002518039, "chapter_id": 22518, "verse_number": "१-१८०-४०", "content_sanskrit": "सुमंतुरुवाच ।\nएवं हि कुर्वतः शांतिमरुणस्य महीपते ।\nश्रेयसे वैनतेयस्य गरुडस्य महात्मनः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002518040, "chapter_id": 22518, "verse_number": "१-१८०-४१", "content_sanskrit": "एतस्मिन्नेव काले तु सुपर्णः पत्रवानभूत् ।\nतेजसा बुधसंकाशो वलेन हरिणा समः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002518041, "chapter_id": 22518, "verse_number": "१-१८०-४२", "content_sanskrit": "संपूर्णावयवो राजन्यथापूर्वं तथाभवत् ।\nप्रसादाद्देवदेवस्य भास्करस्य महात्मनः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002518042, "chapter_id": 22518, "verse_number": "१-१८०-४३", "content_sanskrit": "एवमन्येऽपि राजेंद्र मानवा ये च रोगिणः ।\nअस्मित्कृतेऽग्निकार्ये तु विरुजास्ते भवंति हि ।\nतस्माद्यत्नेन कर्तव्यमग्निकार्यं विधानतः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002518043, "chapter_id": 22518, "verse_number": "१-१८०-४४", "content_sanskrit": "करणीयं च राजेंद्र मानवैश्च प्ररोगिभिः ।\nअस्मिन्कृते अग्निकाये विरुजास्ते भवंति हि ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002518044, "chapter_id": 22518, "verse_number": "१-१८०-४५", "content_sanskrit": "ग्रहो पघाते दुर्भिक्ष उत्पातेषु च कृत्स्नशः ।\nअवर्षमाणे पर्जन्ये लक्षहोमसमन्वितः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002518045, "chapter_id": 22518, "verse_number": "१-१८०-४६", "content_sanskrit": "पूजयित्वा प्रसूक्तं तु ध्यात्वा वीरं प्रयत्नतः ।\nवारुणैश्च तथा सूक्तैर्होमं कुर्याद्विचक्षणः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002518046, "chapter_id": 22518, "verse_number": "१-१८०-४७", "content_sanskrit": "चेतसा सुप्रसन्नेन सर्पिषा मधुना सह ।\nतिलैर्यवैश्च सहितैः पायसं मधुना तथा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002518047, "chapter_id": 22518, "verse_number": "१-१८०-४८", "content_sanskrit": "इदं च शांतिकं कुर्याद्बलिं दयात्प्रयत्नतः ।\nएवं कृते श्रियं देवा वर्षंते कामना नृणाम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002518048, "chapter_id": 22518, "verse_number": "१-१८०-४९", "content_sanskrit": "इत्येवं शांतिकाध्यायं यः पठेच्छृणुयादपि ।\nविधिना सर्वलोकस्तु ध्यायमानो दिवाकरम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002518049, "chapter_id": 22518, "verse_number": "१-१८०-५०", "content_sanskrit": "स विजित्य रणे शत्रुं मानं च परमं लभेत् ।\nअक्षयं मोदते कालमतिरस्कृतशासनः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002518050, "chapter_id": 22518, "verse_number": "१-१८०-५१", "content_sanskrit": "व्याधिभिर्नाभिभूयेत पुत्रपौत्रैः प्रतिष्ठितः ।\nभवेदादित्यसदृशस्तेजसा प्रभया तथा ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002518051, "chapter_id": 22518, "verse_number": "१-१८०-५२", "content_sanskrit": "यानुद्दिश्य पठेद्वीर वाचको मानवो भुवि ।\nन पीड्यते च तै रोगैर्वातपित्तकफात्मकैः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002518052, "chapter_id": 22518, "verse_number": "१-१८०-५३", "content_sanskrit": "नाकाले मरणं तस्य न सर्पैश्चापि दश्यते ।\nन विषं क्रमते देहे न जडांध्यं न मूकता ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002518053, "chapter_id": 22518, "verse_number": "१-१८०-५४", "content_sanskrit": "न चोत्पत्ति भयं तस्य नाभिचारकजं भवेत् ।\nये रोगा ये महोत्पाता येऽहयश्च महाविषाः ।\nते सर्वे प्रशमं यांति श्रवणादस्य भारत ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002518054, "chapter_id": 22518, "verse_number": "१-१८०-५५", "content_sanskrit": "यत्पुण्यं सर्व तीर्थानां गंगादीनां विशेषतः ।\nतत्पुण्यं कोटिगुणितं प्राप्नोति श्रवणादिभिः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002518055, "chapter_id": 22518, "verse_number": "१-१८०-५६", "content_sanskrit": "दशानां राजसूयानामन्येषां च विशेषतः ।\nजीवेद्वर्षशतं साग्रं सर्वव्याधिविवर्जितः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002518056, "chapter_id": 22518, "verse_number": "१-१८०-५७", "content_sanskrit": "गोघ्नश्चैव कृतघ्नश्च ब्रह्महा गुरुतल्पगः ।\nशरणागतदीनार्तमित्रविश्रभघातकः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002518057, "chapter_id": 22518, "verse_number": "१-१८०-५८", "content_sanskrit": "दुष्टः पापसमाचारः पितृहा मातृहा तथा ।\nश्रवणादस्य पापेभ्यो मुच्यते नात्र संशयः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002518058, "chapter_id": 22518, "verse_number": "१-१८०-५९", "content_sanskrit": "इतिहासमिमं पुण्यमग्निकार्यमनुत्तमम् ।\nन दद्यात्कस्यचिद्वीर मूर्खस्य कलुषात्मनः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002518059, "chapter_id": 22518, "verse_number": "१-१८०-६०", "content_sanskrit": "सूर्यभक्ते सदा देयं सूर्येण कथितं पुरा ।\nअरुणस्य महाबाहो गरुडस्यारुणेन च ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002518060, "chapter_id": 22518, "verse_number": "१-१८०-६१", "content_sanskrit": "गरुडेन पुरा प्रोक्तं भोजकानां महात्मनाम् ।\nसूर्यशर्मसुखादीनां शाकद्वीपे महीपते ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002518061, "chapter_id": 22518, "verse_number": "१-१८०-६२", "content_sanskrit": "तैश्चापि कथितं पुण्यं मुनेर्व्यासस्य धीमतः ।\nतेनापि कथितं पुण्यं सर्वपापभयापहम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]