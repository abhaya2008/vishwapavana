[
  {
    "id": 20010880,
    "chapter_id": 6678,
    "verse_number": "6.1",
    "content_sanskrit": "स गङ्गाद्वारमासाद्य सहितस्तैर्महर्षिभिः । ददर्श हिमवत्पादात्पतन्तीममरापगाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20010881,
    "chapter_id": 6678,
    "verse_number": "6.2",
    "content_sanskrit": "हरिपादसरोजन्महंसीं वेगवतीं सिताम् । स्वादीयोरससंपूर्णां गगनद्रुममञ्जरीम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20010882,
    "chapter_id": 6678,
    "verse_number": "6.3",
    "content_sanskrit": "वीचिस्फटिकसोपानपदवीं देवतापुरः । पृतनां धर्मराजस्य बलं पापस्य मथ्नतीम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20010883,
    "chapter_id": 6678,
    "verse_number": "6.4",
    "content_sanskrit": "शितिकण्ठशिरोमालां हिमाद्रेर्हारवल्लरीम् । काञ्चीं मुक्तामयीमुर्व्यास्सागरस्याभिसारिकाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20010884,
    "chapter_id": 6678,
    "verse_number": "6.5",
    "content_sanskrit": "गिरिराजहिमोत्पीडसंपर्कादिव शीतलाम् । मधुरां मृडमौलीन्दुसुधासंकलनादिव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20010885,
    "chapter_id": 6678,
    "verse_number": "6.6",
    "content_sanskrit": "कठिनाद्रिशिलापृष्ठलुठनादिव निर्मलाम् । लघुमप्यलघूल्लोलदलिताद्रितटद्रुमाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20010886,
    "chapter_id": 6678,
    "verse_number": "6.7",
    "content_sanskrit": "क्वचिद् गैरिकपङ्केन सलिलं लोहितीकृतम् । पादक्रान्तिद्रवेणेव पद्मनाभस्य बिभ्रतीम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20010887,
    "chapter_id": 6678,
    "verse_number": "6.8",
    "content_sanskrit": "क्वचिच्चटुलतामुक्तैः कीर्णां पुष्पैर्विकासिभिः । तरलभ्रमरारूढैस्तनुमैन्द्रीमिवेक्षणैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20010888,
    "chapter_id": 6678,
    "verse_number": "6.9",
    "content_sanskrit": "क्वचिन्निमज्जदारण्यद्विपदानाम्बुकर्बुराम् । 'एत्याश्लिष्टाभिवादेशे कालिन्द्या हार्दमुक्तया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20010889,
    "chapter_id": 6678,
    "verse_number": "6.10",
    "content_sanskrit": "कृतभक्तभवध्वंसामुरगेन्द्रविभूषिताम् । सर्वावदातां नृत्यन्तीं रुद्रमूर्तिमिवोद्भवाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20010890,
    "chapter_id": 6678,
    "verse_number": "6.11",
    "content_sanskrit": "पश्यन्तं तमुवाचेदं फल्गुनं गाथिनन्दनः । बीभत्सो पश्य पश्येमां गङ्गां सर्वसरिद्वराम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20010891,
    "chapter_id": 6678,
    "verse_number": "6.12",
    "content_sanskrit": "दृष्ट्वालं खलु च स्पृष्ट्वा नदीरन्यानयाच्युताः । कमण्डलोः पदान्मूर्ध्नो धातुर्विष्णोरुमापतेः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20010892,
    "chapter_id": 6678,
    "verse_number": "6.13",
    "content_sanskrit": "अपमित्य तपोवित्तैरस्या भागं भगीरथः । निनीषुः स्वपितॄन् नाकं ययाचे चन्द्रशेखरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20010893,
    "chapter_id": 6678,
    "verse_number": "6.14",
    "content_sanskrit": "तस्थुरप्राप्य ये नाकं चिराय सगरात्मजाः । तमतिक्रम्य ते तस्थुरस्या वारिभिरुक्षिताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20010894,
    "chapter_id": 6678,
    "verse_number": "6.15",
    "content_sanskrit": "पायं पायं पयोमुष्या मनुष्याः पुण्यकृत्तमाः । पीयूषमिव तुष्यन्ति पीत्वा पीत्वा दिवौकसः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20010895,
    "chapter_id": 6678,
    "verse_number": "6.16",
    "content_sanskrit": "शिवयाक्रुश्यमानोपि चोरंकारं शिवस्सदा । एनां जटाटवीगूढां न मुञ्चति कदाचन ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20010896,
    "chapter_id": 6678,
    "verse_number": "6.17",
    "content_sanskrit": "कथंकारं जटारण्ये गङ्गे बंभ्रम्यसे विभोः । असूययेति पृच्छन्तीं गौरीं प्रतिवदत्यसौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20010897,
    "chapter_id": 6678,
    "verse_number": "6.18",
    "content_sanskrit": "बंभ्रम्येहं यथाकारं गौरीभर्तुर्जटावने । बंभ्रम्येहं तथाकारं सुखिता दुःखितापि वा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20010898,
    "chapter_id": 6678,
    "verse_number": "6.19",
    "content_sanskrit": "तीरेषु निवसन्त्यस्याः पिबन्तोत्यमृतं पयः । भुञ्जानाः फलमूलानि स्वादुङ्कारं महर्षयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20010899,
    "chapter_id": 6678,
    "verse_number": "6.20",
    "content_sanskrit": "तीर्थदर्शं कृतस्नानः पुष्पवेदं कृतोच्चयः । तृप्यत्यस्य गतस्तीरमतिपुण्यं मुनिव्रजः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20010900,
    "chapter_id": 6678,
    "verse_number": "6.21",
    "content_sanskrit": "यावज्जीवंयजन्ते ये ददतेऽधीयते च यान् । सकृदस्यां नराः स्नातास्सुकृतैरतिशेरते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20010901,
    "chapter_id": 6678,
    "verse_number": "6.22",
    "content_sanskrit": "यावद्वेदन्तदाहत्य समिधस्सकुशा वयम् । पवित्राणां पवित्रेत्र निवसाम कृतश्रमाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20010902,
    "chapter_id": 6678,
    "verse_number": "6.23",
    "content_sanskrit": "इति तस्य वचः श्रुत्वा पार्थस्सह महर्षिभिः । गङ्गाद्वारवनोद्देशं मुदितोभिन्यविक्षत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20010903,
    "chapter_id": 6678,
    "verse_number": "6.24",
    "content_sanskrit": "ब्राह्मणेभ्यो ददावन्नं बहु तत्र धनञ्जयः । भुक्त्वा चोदरपूरं ते ददुस्तस्मै मुदाशिषः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20010904,
    "chapter_id": 6678,
    "verse_number": "6.25",
    "content_sanskrit": "यथा वर्षति कूपप्रं नदपूरञ्च वासवः । तथा स पूरयन् बालान् वयस्थांश्चौदनं ददौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20010905,
    "chapter_id": 6678,
    "verse_number": "6.26",
    "content_sanskrit": "चेलक्नोपं घनैरिन्द्रे वर्षत्यर्के तपत्यपि । अशीतालुष्णुष्णालुः पार्थः पर्यचरन्मुनीन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20010906,
    "chapter_id": 6678,
    "verse_number": "6.27",
    "content_sanskrit": "समूलकाषं कषतस्तरसा तीरपादपान् । कल्लोलानुद्वहन्तीं ते 'जाह्नवीं ददृशुर्मुदा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20010907,
    "chapter_id": 6678,
    "verse_number": "6.28",
    "content_sanskrit": "शुष्कपेषं स्म पिंषन्ति तत्रापूपीयतण्डुलान् । प्रीणन्तः पृथिवीदेवान् पार्थस्य परिचारकाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20010908,
    "chapter_id": 6678,
    "verse_number": "6.29",
    "content_sanskrit": "जीवग्राहं महीदेवान् माहेयीरपि गृह्णतः । समूलघातमारण्यान् पार्थः पापमृगानहन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20010909,
    "chapter_id": 6678,
    "verse_number": "6.30",
    "content_sanskrit": "कुर्वन्नकृतकारं स लोकोत्तरपराक्रमः । राक्षसेष्वपि तीक्ष्णेषुरस्तावि मुनिभिर्मुदा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20010910,
    "chapter_id": 6678,
    "verse_number": "6.31",
    "content_sanskrit": "महेषुघातं हत्वा स निशाटानटतो वने । भूतानामहरद्भीतिं रामो दाशरथिर्यथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20010911,
    "chapter_id": 6678,
    "verse_number": "6.32",
    "content_sanskrit": "पिष्टैर्गङ्गापयःपेषं कृतान्नीवारतण्डुलैः । तवापूपान् द्विजातिभ्यः पार्थस्त्वादीयसो ददौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20010912,
    "chapter_id": 6678,
    "verse_number": "6.33",
    "content_sanskrit": "हस्तग्राहं द्विजानन्धान् स वृद्धांश्च गृहीतवान् । विष्टरेषु च सृष्टेषु पाणिवर्तमवर्तयत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20010913,
    "chapter_id": 6678,
    "verse_number": "6.34",
    "content_sanskrit": "अजस्रमर्थिनः पार्थो धनपोषं पुपोष'यः । द्विजान् स्वपोषं सोऽपुष्णात्तीर्थेष्विति किमुच्यते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20010914,
    "chapter_id": 6678,
    "verse_number": "6.35",
    "content_sanskrit": "गोपोषं गव्यतोऽपुष्णात् हयपोषं हयीयतः । सुवर्णपोषं सावर्णिसमस्स्वर्णीयतश्च सः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20010915,
    "chapter_id": 6678,
    "verse_number": "6.36",
    "content_sanskrit": "पलाशैः पेशलश्शालां मुनीनामाबबन्ध सः । बबन्ध च तरुस्कन्धस्तंभवन्धं प्रदाय गाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20010916,
    "chapter_id": 6678,
    "verse_number": "6.37",
    "content_sanskrit": "वराहबन्धं बद्ध्वा स निहतान् पिशिताशनान् । भोजयिष्यन् वयःश्रेणिमगशाखास्वलम्बयत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20010917,
    "chapter_id": 6678,
    "verse_number": "6.38",
    "content_sanskrit": "जीवनाशमिमामास्म नश्यन्निति सदैक्षत । वनेचरीस्स माहेयीर्मुनीनामग्निहोत्रिणाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20010918,
    "chapter_id": 6678,
    "verse_number": "6.39",
    "content_sanskrit": "ऊर्ध्वशोषं नगान् शुष्कानन्विष्योन्मूल्य चालयन् । पार्थः पुरुषवाहं स्म वहत्येधर्धये सताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20010919,
    "chapter_id": 6678,
    "verse_number": "6.40",
    "content_sanskrit": "किरीटिवारुणास्त्रेण कृष्णैर्भागीरथीजलैः । ऊर्ध्वपूरमपूर्यन्त कलशा मुनिसद्मसु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20010920,
    "chapter_id": 6678,
    "verse_number": "6.41",
    "content_sanskrit": "गुरुपित्रर्चमानर्च पाण्डुपुत्रो महामुनीन् । ते च तं गुरुपित्रावमवन्ति स्म दिवानिशम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20010921,
    "chapter_id": 6678,
    "verse_number": "6.42",
    "content_sanskrit": "तर्पयित्वेप्सितैरन्नैर्बुभुक्षून् स सदातिथीन् । फलोपदंशं मूलानि खादयामास कानिश्चित् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20010922,
    "chapter_id": 6678,
    "verse_number": "6.43",
    "content_sanskrit": "दुह्यति स्म द्विजातिभ्यो यो यस्तत्राधमः पुमान् । वाणघातं पृथासूनुस्तं तं निन्ये यमक्षयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20010923,
    "chapter_id": 6678,
    "verse_number": "6.44",
    "content_sanskrit": "वहत्सु दिवसेष्वेवं कदाचित् कुरुनन्दनः । शय्योत्थायन्निशापाये गाङ्गं जलमगाहत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20010924,
    "chapter_id": 6678,
    "verse_number": "6.45",
    "content_sanskrit": "स तु तत्र निमग्नस्सन् कदाचिन्नागकन्यया । बाहूपपीडमालिङ्ग्य रसातलमनियत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20010925,
    "chapter_id": 6678,
    "verse_number": "6.46",
    "content_sanskrit": "चिकीर्षुरग्निकार्यं स ज्वलितं तत्र पावकम् । साधनानि च सर्वाणि तस्यास्सद्मनि दृष्टवान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20010926,
    "chapter_id": 6678,
    "verse_number": "6.47",
    "content_sanskrit": "आशङ्कमानो होमेन हर्षयित्वा हुताशनम् । स तां पार्श्वगतां नम्रां पप्रच्छेति स्मितोत्तरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20010927,
    "chapter_id": 6678,
    "verse_number": "6.48",
    "content_sanskrit": "का त्वं कथय कल्याणि स्नान्तं भागीरथे जले । भुजाभ्यामुपकर्ष मामनैषीश्च कुतो गृहम् ? ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20010928,
    "chapter_id": 6678,
    "verse_number": "6.49",
    "content_sanskrit": "इत्युक्ता सा बभाषे तमस्त्यैरावतवंशजः । कौरव्यो नाम नागेन्द्रस्तस्यापत्यमुलूप्यहम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20010929,
    "chapter_id": 6678,
    "verse_number": "6.50",
    "content_sanskrit": "स्नातुकामं विलोक्य त्वा साहं कामवशंगता । त्वामद्येच्छामि निर्वेष्टुमुपरोधं निजालये ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20010930,
    "chapter_id": 6678,
    "verse_number": "6.51",
    "content_sanskrit": "निपीडयितुमिच्छामि द्वयेन स्तनकुंभयोः । भुजयन्त्रोपरोधं त्वां कुन्तीपुत्र प्रसीद मे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20010931,
    "chapter_id": 6678,
    "verse_number": "6.52",
    "content_sanskrit": "ह्य एवाहमपश्यन्त्वामासीनं मुनिभिस्सह । मायावृततनुर्भूत्वा चरन्ती जाह्नवीतटे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20010932,
    "chapter_id": 6678,
    "verse_number": "6.53",
    "content_sanskrit": "अजानामर्जुनञ्च त्वां पृष्ट्या गूढदेहया । अङ्गुल्युत्क्षेपमाख्यातं प्रियसख्या परिज्ञया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20010933,
    "chapter_id": 6678,
    "verse_number": "6.54",
    "content_sanskrit": "इत्युक्त्वा जघनोन्मर्द्दमालिङ्गन्तीमुवाच ताम् । प्रत्याश्लेषेण मन्देन नन्दयन्निन्द्रनन्दनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20010934,
    "chapter_id": 6678,
    "verse_number": "6.55",
    "content_sanskrit": "भद्रे सदृशमेवेदं भावं बध्नासि यन्मयि । दासीभावो हि कामस्य यूनामन्योन्यदर्शनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20010935,
    "chapter_id": 6678,
    "verse_number": "6.56",
    "content_sanskrit": "ताम्राधरे विशालाक्षि संहतोरु पृथुस्तनि । ममापि तव रूपेण न चित्तं नापकृष्यते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20010936,
    "chapter_id": 6678,
    "verse_number": "6.57",
    "content_sanskrit": "प्रायश्चित्तमकार्यस्य प्रारब्धं किन्तु संप्रति । वार्षिकं ब्रह्मचर्यं मे याति नौ प्रतिकूलताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20010937,
    "chapter_id": 6678,
    "verse_number": "6.58",
    "content_sanskrit": "व्रतकालमतीत्य त्वां ततो रमयितास्म्यहम् । आगत्य हृदयोत्पीडमुल्लुपि भव निर्वृता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20010938,
    "chapter_id": 6678,
    "verse_number": "6.59",
    "content_sanskrit": "इत्युक्त्वा सा बभाषे तमिदानीमिन्द्रनन्दन । यदि नारमयिष्यो मा मयास्यं व्यसुतामहम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20010939,
    "chapter_id": 6678,
    "verse_number": "6.60",
    "content_sanskrit": "तदाश्रिता सुरक्षाख्यमपि तेस्ति व्रतं यदि । व्रतान्तराविरुद्धश्च तदेव परिपालय ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20010940,
    "chapter_id": 6678,
    "verse_number": "6.61",
    "content_sanskrit": "केशग्राहं नखच्छेदं रदखण्डञ्च पार्थिवः । रमयन् कुरु मा स्वस्थां द्विसेनां योधयन्निव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20010941,
    "chapter_id": 6678,
    "verse_number": "6.62",
    "content_sanskrit": "एवमुक्तस्तथेत्युक्त्वा सोग्रजस्य स्मरन् गिरः । गान्धर्वेणोपयेमे तां विधिना करुणानिधिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20010942,
    "chapter_id": 6678,
    "verse_number": "6.63",
    "content_sanskrit": "वक्षोविमर्दभुग्राग्रवक्षोजैरुपगूह्नैः । दन्तप्रान्ताधरोल्लीढरसै रधरपीडनैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20010943,
    "chapter_id": 6678,
    "verse_number": "6.64",
    "content_sanskrit": "विविधैश्च रदच्छेदैश्चुंबनैश्च विचक्षणः । पार्थः प्रह्लादयामास रमयन्नथ तां प्रियाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20010944,
    "chapter_id": 6678,
    "verse_number": "6.65",
    "content_sanskrit": "इरावदाख्यमुत्पाद्य स तस्यां गुणिनं सुतम् । नागेन्द्रगेहादन्येद्युस्तां समाश्वास्य निरंयौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20010945,
    "chapter_id": 6678,
    "verse_number": "6.66",
    "content_sanskrit": "गत्वाथ कथयित्वा सः स्वस्यादर्शनकारणम् । परमं विस्मयं निन्ये परिपृष्टवतो मुनीन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20010946,
    "chapter_id": 6678,
    "verse_number": "6.67",
    "content_sanskrit": "तस्मादेकदिनात्प्रासमस्मभ्यं पार्थ तिष्ठसे । गोपो वा तर्षमेकाहं वत्सेभ्यः पाययन्निति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "avatarnika": ""
  },
  {
    "id": 20010947,
    "chapter_id": 6678,
    "verse_number": "6.68",
    "content_sanskrit": "साधु साध्विति तैरुक्तः परोपकरणप्रियैः । स ननन्द सतां वृत्तं सत्संवादैर्हि शुद्ध्यति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "avatarnika": ""
  },
  {
    "id": 20010948,
    "chapter_id": 6678,
    "verse_number": "6.69",
    "content_sanskrit": "द्युसिन्धुतीर्थावस्कन्दं स्नात्वा तत्र वसन्नसौ । हिमाचलगुहावेशमध्यास्त सुशिलासनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "avatarnika": ""
  },
  {
    "id": 20010949,
    "chapter_id": 6678,
    "verse_number": "6.70",
    "content_sanskrit": "सोपचित्य सुपुष्पौघमनुपातं लतां लताम् । मुनीनापादमापादं नम्रोन्निवदसेवत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "avatarnika": ""
  },
  {
    "id": 20010950,
    "chapter_id": 6678,
    "verse_number": "6.71",
    "content_sanskrit": "अलंकृत्याग्निहोत्राणि कुसुमैस्ते तदाहृतैः । समिधि द्व्यङ्गुलोत्कर्षं हुतायां जुहुवुर्हविः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "avatarnika": ""
  },
  {
    "id": 20010951,
    "chapter_id": 6678,
    "verse_number": "6.72",
    "content_sanskrit": "स नामग्राहमाहूय मुनिभिः स्वकुमारवत् । नियुक्तस्तानतन्द्रालुरप्रीणात् परिचर्यया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "avatarnika": ""
  },
  {
    "id": 20010952,
    "chapter_id": 6678,
    "verse_number": "6.73",
    "content_sanskrit": "पृच्छन्तीभ्यस्स्वकान्ताभ्यो नामादेशमकीर्तयत् । जितात्मरूपं सव्रीला गन्धर्वास्तं गिरौ स्थिताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 73,
    "avatarnika": ""
  },
  {
    "id": 20010953,
    "chapter_id": 6678,
    "verse_number": "6.74",
    "content_sanskrit": "अतीतव्रतकालन्तु तमुल्बूपी कदाचन । अश्वस्यन्त्यन्तिकं प्राप्य ययाचे विजने रतिम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74,
    "avatarnika": ""
  },
  {
    "id": 20010954,
    "chapter_id": 6678,
    "verse_number": "6.75",
    "content_sanskrit": "सोवक् ताम्मदनार्ता किमुच्चैःकारं ब्रवीषि'मा । शृणुयुर्मुनयः केचिदिह संवादमावयोः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 75,
    "avatarnika": ""
  },
  {
    "id": 20010955,
    "chapter_id": 6678,
    "verse_number": "6.76",
    "content_sanskrit": "प्रत्यूचे सा तमित्युक्ता शनैःकृत्य ब्रवीषि किम् ? विजनेत्र मनोयोनिं धिक्कृत्वा किञ्च जल्पसि ? ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 76,
    "avatarnika": ""
  },
  {
    "id": 20010956,
    "chapter_id": 6678,
    "verse_number": "6.77",
    "content_sanskrit": "तिर्यक्कारमतिक्रूरं व्रतकालमसि स्थितः । तिर्य्येक्कृत्यातितीर्थेस्यास्तिर्यक्कृत्वा तपांसि च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 77,
    "avatarnika": ""
  },
  {
    "id": 20010957,
    "chapter_id": 6678,
    "verse_number": "6.78",
    "content_sanskrit": "कन्दर्पबाणविद्धां मां स्वयमन्तिकमागताम् । उरस्तःकारमालिङ्ग्य खामिन्सपदि जीवय ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 78,
    "avatarnika": ""
  },
  {
    "id": 20010958,
    "chapter_id": 6678,
    "verse_number": "6.79",
    "content_sanskrit": "बाहू शिरोधितःकृत्य कृत्योरस्तः स्तनावपि । त्वामालिङ्गितुमिच्छामि मुखतोभावमास्स्व मे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 79,
    "avatarnika": ""
  },
  {
    "id": 20010959,
    "chapter_id": 6678,
    "verse_number": "6.80",
    "content_sanskrit": "मुखतो भूयतामेवं ब्रुवाणां रहसि प्रियाम् । सस्वजे मुखतोभूत्वा स दयार्द्रोपि निर्दयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 80,
    "avatarnika": ""
  },
  {
    "id": 20010960,
    "chapter_id": 6678,
    "verse_number": "6.81",
    "content_sanskrit": "अन्वग्भावं परिष्वक्ता तेनान्वग्भूय सस्वजे । सापि तं पुरुषेऽमन्दे तूष्णींभूयासते स्त्रियः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 81,
    "avatarnika": ""
  },
  {
    "id": 20010961,
    "chapter_id": 6678,
    "verse_number": "6.82",
    "content_sanskrit": "हारयष्टिं विनाकृत्य निर्दयाश्लेषखण्डिताम् । तिलकञ्च विनाकृत्वा श्रमाम्बुकणिकाभृतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 82,
    "avatarnika": ""
  },
  {
    "id": 20010962,
    "chapter_id": 6678,
    "verse_number": "6.83",
    "content_sanskrit": "विस्रंसितघनग्रन्थीन्नानाकारञ्च कुन्तलान् । उत्कूजितमणिश्रेणिं द्वैधंकारञ्च मेखलाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 83,
    "avatarnika": ""
  },
  {
    "id": 20010963,
    "chapter_id": 6678,
    "verse_number": "6.84",
    "content_sanskrit": "उलूपी रमयामास ततस्तं प्राणनायकम् । प्रययौ च तमापृच्छ्य विनाभूय कथञ्चन ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 84,
    "avatarnika": ""
  },
  {
    "id": 20010964,
    "chapter_id": 6678,
    "verse_number": "6.85",
    "content_sanskrit": "गतायामर्जुनस्तस्यां तपोवनमुपेयिवान् । शक्नुवन् धृष्णुवन् जानन्नभिराधयितुं मुनीन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 85,
    "avatarnika": ""
  },
  {
    "id": 20010965,
    "chapter_id": 6678,
    "verse_number": "6.86",
    "content_sanskrit": "निशाचरादिभिर्योद्धुमग्लायन् समरेषु सः । व्याघ्रादीन् जघटे हन्तुमरण्यानीषु कार्मुकी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 86,
    "avatarnika": ""
  },
  {
    "id": 20010966,
    "chapter_id": 6678,
    "verse_number": "6.87",
    "content_sanskrit": "महर्षयस्तमाश्रित्य यष्टुमारेभिरे मखैः । धनानि लेभिरे दातुं प्राक्रमन्त तपस्यितुम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 87,
    "avatarnika": ""
  },
  {
    "id": 20010967,
    "chapter_id": 6678,
    "verse_number": "6.88",
    "content_sanskrit": "सर्वातिथीन् भोजयितुं सेहिरे भूयसान्धसा । धनहीना हि नार्हन्ति सन्तोषयितुमर्थिनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 88,
    "avatarnika": ""
  },
  {
    "id": 20010968,
    "chapter_id": 6678,
    "verse_number": "6.89",
    "content_sanskrit": "बभूव द्रविणं तेषां दातुं भोक्तुञ्च सर्पिषः । प्रबभूवुश्च ते दातुं भोक्तुं च धनमुन्नताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 89,
    "avatarnika": ""
  },
  {
    "id": 20010969,
    "chapter_id": 6678,
    "verse_number": "6.90",
    "content_sanskrit": "सर्वेषु तीर्थेष्वापात्यानाप्लाव्यान् पाण्डवो द्विजान् । भव्यान्नृग्यजुषे साम्नां गेयानप्यभ्यराधयत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 90,
    "avatarnika": ""
  },
  {
    "id": 20010970,
    "chapter_id": 6678,
    "verse_number": "6.91",
    "content_sanskrit": "एकदा तु द्विजानेवमुवाच सह गच्छतः । रमणीये वनोद्देशे विहरन् हरिसारथिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 91,
    "avatarnika": ""
  },
  {
    "id": 20010971,
    "chapter_id": 6678,
    "verse_number": "6.92",
    "content_sanskrit": "अनुगन्तुं यतीर्मातॄर्मृगैस्त्र स्तनन्धयैः । स्नेहेन चलितं भाव्यं युष्माकं तेषु दृष्टिभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 92,
    "avatarnika": ""
  },
  {
    "id": 20010972,
    "chapter_id": 6678,
    "verse_number": "6.93",
    "content_sanskrit": "प्रियेण शृङ्गकोणेन मृदुकण्डूयिता मृगी । तिष्ठन्ती मीलिताक्षीयं सत्कार्या वा विलोचनैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 93,
    "avatarnika": ""
  },
  {
    "id": 20010973,
    "chapter_id": 6678,
    "verse_number": "6.94",
    "content_sanskrit": "इह प्रयातो हरिणः कुलायादयमुत्थितः । प्रियया मुग्धया मृग्या पश्यतार्भकयुक्तया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 94,
    "avatarnika": ""
  },
  {
    "id": 20010974,
    "chapter_id": 6678,
    "verse_number": "6.95",
    "content_sanskrit": "पतिताः पादपेभ्योमी शकुनाश्शिञ्जिताः कलम् । अन्तरिक्षं चलत्पक्षबन्धनीरन्ध्रपङ्क्तयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 95,
    "avatarnika": ""
  },
  {
    "id": 20010975,
    "chapter_id": 6678,
    "verse_number": "6.96",
    "content_sanskrit": "शाखाभुजाभ्यामाश्लिष्टा प्रत्याश्लिष्टा लतातनुम् । मात्यारूढेव पुष्पास्यं पुष्पास्येनेवचुंबितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 96,
    "avatarnika": ""
  },
  {
    "id": 20010976,
    "chapter_id": 6678,
    "verse_number": "6.97",
    "content_sanskrit": "अध्यासितास्समाः पृथ्वीस्तथातिशयिताश्शिलाः । धन्याः फलादितोयाढ्यं वनमध्युषिता नराः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 97,
    "avatarnika": ""
  },
  {
    "id": 20010977,
    "chapter_id": 6678,
    "verse_number": "6.98",
    "content_sanskrit": "चुंबदन्योन्यमालिङ्गदगस्कन्धमधिष्ठितम् । लभते मिथुनं शाखामृगयोरिह संमुदम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 98,
    "avatarnika": ""
  },
  {
    "id": 20010978,
    "chapter_id": 6678,
    "verse_number": "6.99",
    "content_sanskrit": "मधुरभ्रमरालापा विकासिकुसुमानना । रमणं रमणीवेयमनुजीर्णा लता तरुम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 99,
    "avatarnika": ""
  },
  {
    "id": 20010979,
    "chapter_id": 6678,
    "verse_number": "6.100",
    "content_sanskrit": "गृह्यमानमहामीनैर्दाशैराक्रुष्टवागुरैः । वनादाराद्विभातीयमापगा विमलोदका ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 100,
    "avatarnika": ""
  },
  {
    "id": 20010980,
    "chapter_id": 6678,
    "verse_number": "6.101",
    "content_sanskrit": "अतिथीनर्चितुं गोघ्नानीहमानैर्महर्षिभिः । पूतं तपोवनमिदं भासते समया वनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 101,
    "avatarnika": ""
  },
  {
    "id": 20010981,
    "chapter_id": 6678,
    "verse_number": "6.102",
    "content_sanskrit": "व्याघ्राणां शयिता भीमा दृश्यतेद्रेरियं गुहा । सलोमरुधिरैःकीर्णा विविधैर्मृगचर्मभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 102,
    "avatarnika": ""
  },
  {
    "id": 20010982,
    "chapter_id": 6678,
    "verse_number": "6.103",
    "content_sanskrit": "गतं केसरिणामेतत् घोरमुर्वीधरस्थलम् । नखभिन्नेभकुम्भालिमुक्तमुक्ताच्छटाचितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 103,
    "avatarnika": ""
  },
  {
    "id": 20010983,
    "chapter_id": 6678,
    "verse_number": "6.104",
    "content_sanskrit": "सुगन्धम्मदसेकेनदलितं वनदन्तिनाम् । सल्लकीपल्लवच्छेद्युतमेतन्महीतलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 104,
    "avatarnika": ""
  },
  {
    "id": 20010984,
    "chapter_id": 6678,
    "verse_number": "6.105",
    "content_sanskrit": "रमणीयानि वस्तूनि द्विजेभ्यो दर्शयन्निति । विजहार स तैस्सार्धं कदाचन कदाचन ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 105,
    "avatarnika": ""
  },
  {
    "id": 20010985,
    "chapter_id": 6678,
    "verse_number": "6.106",
    "content_sanskrit": "अथैकदापृच्छच स कौशिकादीन् महामुनीन् हैमवतीषु भूमिषु । तीर्थानि सर्वाणि निषेवमाणश्चचार विप्रेषु धनानि वर्षन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 106,
    "avatarnika": ""
  },
  {
    "id": 20010986,
    "chapter_id": 6678,
    "verse_number": "6.107",
    "content_sanskrit": "क्षेत्रापणेषु द्रविणैरनन्तैस्सन्तर्प्यमाणैरवनीसुरेषु । प्रीत्या समस्तश्रुतिशास्त्रवित्सु स चिक्रिये पुण्यमतीतसंख्यम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 107,
    "avatarnika": ""
  },
  {
    "id": 20010987,
    "chapter_id": 6678,
    "verse_number": "6.108",
    "content_sanskrit": "तीर्थान्युदीच्यान्यतिपावनानि प्राच्यानि च प्राज्यमतिर्निषेव्य । अङ्गादिराष्ट्राण्यतिसृत्य पार्थश्शूर्पाकरं रामपुरञ्जगाम ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 108,
    "avatarnika": ""
  },
  {
    "id": 20010988,
    "chapter_id": 6678,
    "verse_number": "6.109",
    "content_sanskrit": "प्रदक्षिणीकृत्य महेन्द्रमद्रिं गोदावरीं प्राप्य कृताभिषेकः । कवेरकन्यार्णवसङ्गमेऽसौ सन्तर्प्य देवर्षिपितॄञ्जहर्ष ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 109,
    "avatarnika": ""
  },
  {
    "id": 20010989,
    "chapter_id": 6678,
    "verse_number": "6.110",
    "content_sanskrit": "ततः किरीटी मणलूरपत्तनं पयोधितीरेण ययौ शनैश्शनैः । तरङ्गवातैश्श्रितचन्दनाचलैर्विंलुप्यमानश्रमवारिशीकरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 110,
    "avatarnika": ""
  },
  {
    "id": 20010990,
    "chapter_id": 6678,
    "verse_number": "6.111",
    "content_sanskrit": "प्रतिपद्य स तन्मणलूरपुरं कृततद्गततीर्थविगाहविधिः । परिपूर्णमनोरथविप्रसृतः प्रसितो विषयेषु बभूव सुखी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 111,
    "avatarnika": ""
