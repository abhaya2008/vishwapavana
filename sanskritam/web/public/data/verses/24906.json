[{"id": 7004906000, "chapter_id": 24906, "verse_number": "७-१-८९-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेद्वरारोहे कपालीश्वरमुत्तमम् ।\nरुद्रं तृतीयं पापघ्नं नीलरुद्रस्यपूर्वतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004906001, "chapter_id": 24906, "verse_number": "७-१-८९-२", "content_sanskrit": "बुधेश्वरात्पश्चिमतो धनुषां सप्तके स्थितम् ।\nछिन्नं मया पुरा देवि ब्रह्मणः पंचमं शिरः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004906002, "chapter_id": 24906, "verse_number": "७-१-८९-३", "content_sanskrit": "तत्कपालं करे लग्नं प्रभासक्षेत्रमागतः ।\nततो वर्षसहस्रं तु संस्थितः क्षेत्रमध्यतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004906003, "chapter_id": 24906, "verse_number": "७-१-८९-४", "content_sanskrit": "कपालधारी दिग्वासाः कपाली तेन च स्मृतः ।\nतन्मया पूजितं लिंगं वर्षाणामयुतं प्रिये ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004906004, "chapter_id": 24906, "verse_number": "७-१-८९-५", "content_sanskrit": "कपालिरूपमास्थाय कपालीशस्ततः स्मृतः ।\nसर्वपापहरो नृणां दर्शनात्स्पर्शनादपि ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004906005, "chapter_id": 24906, "verse_number": "७-१-८९-६", "content_sanskrit": "मया तत्र नियुक्ता वै रक्षार्थं शूलपाणयः ।\nगणाः सहस्रशो देवि पापिनां दुष्टचेतसाम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004906006, "chapter_id": 24906, "verse_number": "७-१-८९-७", "content_sanskrit": "तस्मात्सर्वप्रयत्नेन सम्यक्छ्रद्धासमन्वितः ।\nपूजयेत्तं महादेवं कपालिनमनामयम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004906007, "chapter_id": 24906, "verse_number": "७-१-८९-८", "content_sanskrit": "हिरण्यं तत्र दातव्यं ब्राह्मणे वेदपारगे ।\nपूजयित्वा विधानेन सम्यक्तत्पुरुषाणुना ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004906008, "chapter_id": 24906, "verse_number": "७-१-८९-९", "content_sanskrit": "जन्मप्रभृति यत्पापं प्राणिभिः समुपार्जितम् ।\nषडशीतिमुखे दृष्ट्वा तल्लिंगं तु व्यपोहति ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004906009, "chapter_id": 24906, "verse_number": "७-१-८९-१०", "content_sanskrit": "इति संक्षेपतः प्रोक्तं माहात्म्यं पापनाशनम् ।\nकपालिरुद्रदेवस्य तृतीयस्य वरानने ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004906010, "chapter_id": 24906, "verse_number": "७-१-८९-११", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभासखण्डे प्रथमे प्रभासक्षेत्रमाहात्म्य एकादशरुद्रमाहात्म्ये कपा लीश्वरमाहात्म्यवर्णनंनामैकोननवतितमोऽध्यायः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]