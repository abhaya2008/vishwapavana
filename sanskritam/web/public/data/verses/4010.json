[{"id": 2139062, "chapter_id": 4010, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2139063, "chapter_id": 4010, "verse_number": "१", "content_sanskrit": "प्रत्याख्यातस्तु पाञ्चाल्या कीचकः काममूर्च्छितः ।\nप्रविश्य राजभवनं भगिन्यास्त्वग्रतः स्थितः\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2139064, "chapter_id": 4010, "verse_number": "२", "content_sanskrit": "सोऽभिवीक्ष्य सुकेशान्तां सुदेष्णां भगिनीं प्रियम् ।\nअमर्यादेन कामेन स्वचित्तेऽभिपरिप्लुतः\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2139065, "chapter_id": 4010, "verse_number": "३", "content_sanskrit": "स तु मूर्ध्न्यञ्जलिं कृत्वा भगिन्याश्चरणावुभौ ।\nसम्मोहाभिहतस्तूर्णं वातोद्भूत इवार्णवः\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2139066, "chapter_id": 4010, "verse_number": "४", "content_sanskrit": "प्रोवाच च सुदुःखार्तो भगिनीं निःश्वसन् मुहुः ।\nअव्यक्तमृदुना नाम्ना शुष्यमाणः पुनः पुनः\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2139067, "chapter_id": 4010, "verse_number": "५", "content_sanskrit": "यथा सुदेष्णे सैरन्ध्र्या सङ्गच्छेयं सकामया ।\nतथा शीघ्रं कुरष्वाद्य माऽहं प्राणान् प्रहासिषम्\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2139068, "chapter_id": 4010, "verse_number": "६", "content_sanskrit": "यदीयमनवद्याङ्गी न मामद्याभिकाङ्क्षते ।\nचेतसाऽभिप्रसन्नेन गतोऽस्म्यद्य यमालयम्\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2139069, "chapter_id": 4010, "verse_number": "७", "content_sanskrit": "तमुवाच परिष्वज्य सुदेष्णा भ्रातरं प्रियम्\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2139070, "chapter_id": 4010, "verse_number": "८", "content_sanskrit": "शरणागतेयं सुश्रोणी मया दत्ताभया च सा ।\nशुभाचारा च भद्रं ते नैनां वक्तुमिहोत्सहे\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2139071, "chapter_id": 4010, "verse_number": "९", "content_sanskrit": "नैषा च शक्या ह्यन्येन स्प्रष्टुं दुष्टेन चेतसा ।\nगन्धर्वाः किल पञ्चैनां रक्षन्ति रमयन्ति च\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2139072, "chapter_id": 4010, "verse_number": "१०", "content_sanskrit": "एवमेषा ममाचष्ट तथा प्रथमसङ्गमे\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2139073, "chapter_id": 4010, "verse_number": "११", "content_sanskrit": "तथैव गजनासोरूः सत्यमाह ममान्तिके ।\nतेऽपि क्रुद्धा महात्मानो नाशयेयुर्हि जीवितम्\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2139074, "chapter_id": 4010, "verse_number": "१२", "content_sanskrit": "राजा चैव समीक्ष्यैनां सम्मोहं गतवानिह ।\nमया च सत्यवचनैरनुनीतो महीपतिः\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2139075, "chapter_id": 4010, "verse_number": "१३", "content_sanskrit": "सोऽप्येनामनिशं दृष्ट्वा मनसैवाभ्यनन्दत ।\nभयाद् गन्धर्वमुख्यानां जीवितस्योपघातिनाम्\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2139076, "chapter_id": 4010, "verse_number": "१४", "content_sanskrit": "मनसाऽपि ततस्त्वेनां न चिन्तयति पार्थिवः\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2139077, "chapter_id": 4010, "verse_number": "१५", "content_sanskrit": "ते हि क्रुद्धा महात्मानो गरुडानिलतेजसः ।\nदहेयुरपि लोकांस्त्रीन् युगान्तेष्विव भास्करः\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2139078, "chapter_id": 4010, "verse_number": "१६", "content_sanskrit": "सैरन्ध्र्या ह्येतदाख्यातं मम तेषां महद्बलम् ।\nतव चाहमिदं गुह्यं स्नेहादाख्यामि बन्धुवत्\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2139079, "chapter_id": 4010, "verse_number": "१७", "content_sanskrit": "मा गमिष्यसि वै कृच्छ्रां गतिं परमदुर्गमाम् ।\nबलिनस्ते रुजं कुर्युः कुलस्य च धनस्य च\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2139080, "chapter_id": 4010, "verse_number": "१८", "content_sanskrit": "तस्मादस्यां मनः कर्तुं यदि प्राणाः प्रियास्तव ।\nमा चिन्तयेथा मा गास्त्वं मत्प्रियं च यदीच्छसि\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2139081, "chapter_id": 4010, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2139082, "chapter_id": 4010, "verse_number": "१९", "content_sanskrit": "एवमुक्तस्तु दुष्टात्मा भगिनीं कीचकोऽब्रवीत्\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2139083, "chapter_id": 4010, "verse_number": "२०", "content_sanskrit": "गन्धर्वाणां शतं चापि सहस्रमयुतानि वा ।\nअहमेको हनिष्यामि गन्धर्वान् पञ्च किं पुनः\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2139084, "chapter_id": 4010, "verse_number": "२१", "content_sanskrit": "न च त्वमभिजानीषे स्त्रीणां गुह्यमनुत्तमम् ।\nपुत्रं वा किल पौत्रं वा भ्रातरं वा वराननम्\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2139085, "chapter_id": 4010, "verse_number": "२२", "content_sanskrit": "रहसीह नरं दृष्ट्वा नानागन्धविभूषितम्\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2139086, "chapter_id": 4010, "verse_number": "२३", "content_sanskrit": "योनिरुत्स्विद्यते स्त्रीणामसतीनामिति श्रुतम्\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2139087, "chapter_id": 4010, "verse_number": "२४", "content_sanskrit": "मां निरीक्ष्यानुलिप्ताङ्गं सर्वाभरणभूषितम् ।\nवशमेष्यति सैरन्ध्री मन्मथेन प्रपीडिता\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2139088, "chapter_id": 4010, "verse_number": "२५", "content_sanskrit": "सा त्वं दृष्ट्वा नयस्वैनां जीवितं मे यदीच्छसि\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2139089, "chapter_id": 4010, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2139090, "chapter_id": 4010, "verse_number": "२६", "content_sanskrit": "एवमुक्ता सुदेष्णा तु शोकेनाभिप्रपीडिता ।\nअहो दुःखमहो कृच्छ्रमहो पापमिति स्म ह\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2139091, "chapter_id": 4010, "verse_number": "२७", "content_sanskrit": "प्रारुदद् भृशदुःखार्ता विषादं तस्य वीक्ष्य सा\t ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2139092, "chapter_id": 4010, "verse_number": "२८", "content_sanskrit": "पाताळेषु पतत्येष विलपन् बडवामुखे ।\nत्वत्कृते विनशिष्यन्ति भ्रातरः सुहृदश्च मे\t ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2139093, "chapter_id": 4010, "verse_number": "२९", "content_sanskrit": "किं नु शक्यं मया कर्तुं यत् त्वमेवमभीप्सितः ।\nन च श्रेयोऽभिजानीषे काममेवानुवर्तसे\t ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2139094, "chapter_id": 4010, "verse_number": "३०", "content_sanskrit": "ध्रुवं गतायुस्त्वं पाप यदेवं काममोहितः ।\nअकर्तव्ये हि मां पापे नियुनङ्क्षि नराधम\t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2139095, "chapter_id": 4010, "verse_number": "३१", "content_sanskrit": "अपि चैतत् पुरा प्रोक्तं निपुणैर्मनुजोत्तमैः ।\nएकस्तु कुरुते पापं स्वजातिस्तेन हन्यते\t ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2139096, "chapter_id": 4010, "verse_number": "३२", "content_sanskrit": "गतस्त्वं धर्मराजस्य विषयं नात्र संशयः ।\nअदूषितमिमं सर्वं स्वजनं घातयिष्यसि\t ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2139097, "chapter_id": 4010, "verse_number": "३३", "content_sanskrit": "एतत्तु मे दुःखतरं येनाहं भ्रातृसौहृदात् ।\nविदितार्था भविष्यामि तुष्टो भव कुलक्षयात्\t ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2139098, "chapter_id": 4010, "verse_number": "३४", "content_sanskrit": "गच्छ शीघ्रमितस्त्वं हि स्वमेव भवनं शुभम् ।\nकिञ्चित् कार्यं समुद्दिश्य सुरामन्नं च कारय\t ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2139099, "chapter_id": 4010, "verse_number": "३५", "content_sanskrit": "कृते चान्ने सुरायां च प्रेषयिष्यसि मे पुनः ।\nतामहं प्रेषयिष्यामि मध्वन्नार्थं तवान्तिकम्\t ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2139100, "chapter_id": 4010, "verse_number": "३६", "content_sanskrit": "ततः सम्प्रेषितामेनां विजने निरवग्रहाम् ।\nसान्त्वयेथा यथान्यायं यदि सा च सहिष्यति\t ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2139101, "chapter_id": 4010, "verse_number": "३७", "content_sanskrit": "सद्यः कृतमिदं सर्वं शेषमत्रानुचिन्तय\t ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2139102, "chapter_id": 4010, "verse_number": "३८", "content_sanskrit": "सुदेष्णयैवमुक्तस्तु कीचकः कालचोदितः ।\nत्वरमाणः प्रचक्राम स्वगृहं राजवेश्मनः\t ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2139103, "chapter_id": 4010, "verse_number": "३९", "content_sanskrit": "आगम्य च गृहं रम्यं सुरामन्नं चकार ह ।\nअजैडकं च सुकृतं बहूंश्चोच्चावचान् मृगान्\t ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2139104, "chapter_id": 4010, "verse_number": "४०", "content_sanskrit": "भक्ष्यांश्च विविधाकारान् बहूंश्चोच्चावचांस्तदा ।\nकारयामास कुशलैरन्नपानं सुसंस्कृतम्\t ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2139105, "chapter_id": 4010, "verse_number": "४१", "content_sanskrit": "त्वरावान् कालपाशेन कण्ठे बद्धः पशुर्यथा ।\nनाबबुध्यत मूढात्मा मरणं समुपस्थितम्\t ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2139106, "chapter_id": 4010, "verse_number": "४२", "content_sanskrit": "सम्पाकायां सुरायां तु कृते चान्ने सुसंस्कृते ।\nकीचकः पुनरागम्य सुदेष्णां वाक्यमब्रवीत्\t ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2139107, "chapter_id": 4010, "verse_number": "४३", "content_sanskrit": "मधु मांसं बहुविधं भक्ष्याश्च विविधाः कृताः ।\nसुदेष्णे ब्रूहि सैरन्ध्रीं यथा सा मे गृहं व्रजेत्\t ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2139108, "chapter_id": 4010, "verse_number": "४४", "content_sanskrit": "केनचित्त्वद्य कार्येण त्वर शीघ्रं मम प्रियम्\t ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2139109, "chapter_id": 4010, "verse_number": "४५", "content_sanskrit": "अहं हि शरणं देवं प्रपद्ये वृषभध्वजम् ।\nसमागमं मे सैरन्ध्र्या मरणं वा दिशेदिति\t ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2139110, "chapter_id": 4010, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2139111, "chapter_id": 4010, "verse_number": "४६", "content_sanskrit": "सा तमाह विनिःश्वस्य प्रतिगच्छ स्वकं गृहम् ।\nएषाऽहमपि सैरन्ध्रीं सुरार्थे तूर्णमादिशे\t ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2139112, "chapter_id": 4010, "verse_number": "४७", "content_sanskrit": "एवमुक्तस्तु पापात्मा कीचकस्त्वरितं पुनः ।\nस्वगृहं प्राविशत् तूर्णं सैरन्ध्रीगतमानसः\t ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2139113, "chapter_id": 4010, "verse_number": "४८", "content_sanskrit": "कीचकं तु गतं ज्ञात्वा त्वरमाणं स्वकं गृहम् ।\nसैरन्ध्रीं तत आहूय सुदेष्णा वाक्यमब्रवीत्\t ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2139114, "chapter_id": 4010, "verse_number": "४९", "content_sanskrit": "गच्छ सैरन्ध्रि मत्प्रीत्यै कीचकस्य निवेशनम् ।\nसुरामानय सुश्रोणि तृषिताऽहं विलासिनि\t ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2139115, "chapter_id": 4010, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2139116, "chapter_id": 4010, "verse_number": "५०", "content_sanskrit": "सुदेष्णयैवमुक्ता सा निःश्वसन्ती नृपात्मजा ।\nअब्रवीच्छोकसन्तप्ता नाहं तत्र व्रजामि वै\t ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2139117, "chapter_id": 4010, "verse_number": "५१", "content_sanskrit": "सूतपुत्रो हि मां भद्रे कामात्मा चाभिमन्यते ।\nन गच्छेयमहं तस्य राजपुत्रि निवेशनम्\t ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2139118, "chapter_id": 4010, "verse_number": "५२", "content_sanskrit": "त्वमेव भद्रे जानासि यथा स निरपत्रपः\t ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2139119, "chapter_id": 4010, "verse_number": "५३", "content_sanskrit": "समयश्च कृतो भद्रे त्वया प्रथमसङ्गमे ।\nतथा निवसमानायां यथाऽहं नान्यचारिणी\t ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2139120, "chapter_id": 4010, "verse_number": "५४", "content_sanskrit": "कीचकस्तु सुकेशान्ते मूढो मदनदर्पितः ।\nस मामिह गतां दृष्ट्वा व्यवस्यति निराकृतः\t ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2139121, "chapter_id": 4010, "verse_number": "५५", "content_sanskrit": "कथं नु वै तत्र गतां मर्षयेन्मामबान्धवाम्\t ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2139122, "chapter_id": 4010, "verse_number": "५६", "content_sanskrit": "बह्व्यः सन्ति तव प्रेष्या राजपुत्रि वशानुगाः ।\nअन्यां प्रेषय कैकेयि संरक्ष्याऽहमिह त्वया\t ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2139123, "chapter_id": 4010, "verse_number": "५७", "content_sanskrit": "कीचकस्यालयं देवि न यामि भयकम्पिता ।\nयद्यस्त्यन्यच्च ते कर्म करोम्यतिसुदुष्करम्\t ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2139124, "chapter_id": 4010, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2139125, "chapter_id": 4010, "verse_number": "५८", "content_sanskrit": "एवमुक्ता तु पाञ्चाल्या दैवयोगेन कैकयी ।\nतां विराटस्य महिषी क्रुद्धा भूयोऽन्वशासत\t ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2139126, "chapter_id": 4010, "verse_number": "५९", "content_sanskrit": "कीचकं चैव गच्छ त्वं बलात्कारेण चोदिता ।\nनास्ति मेऽन्या त्वया तुल्या सा मे शीघ्रतरं व्रज\t ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2139127, "chapter_id": 4010, "verse_number": "६०", "content_sanskrit": "अवश्यं त्वेव गन्तव्यं किमर्थं मां विवक्षसि ।\nशीघ्रं गच्छ त्वरस्वेति मत्प्रीतिवशमाचर\t ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2139128, "chapter_id": 4010, "verse_number": "६१", "content_sanskrit": "न हीदृशो मम भ्राता किं त्वं समभिशङ्कसे\t ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2139129, "chapter_id": 4010, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2139130, "chapter_id": 4010, "verse_number": "६२", "content_sanskrit": "उक्त्वा चैनां बलाच्चैव विनियुज्य प्रभुत्वतः ।\nभाजनं प्रददौ चास्यै सापिधानं हिरण्मयम्\t ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2139131, "chapter_id": 4010, "verse_number": "६३", "content_sanskrit": "या सुरा जातमन्था च तामानय सुरामिति\t ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2139132, "chapter_id": 4010, "verse_number": "६४", "content_sanskrit": "सा शङ्कमाना रुदती वेपन्ती द्रुपदात्मजा ।\nदैवतेभ्यो नमस्कृत्य श्वशुरेभ्यस्तथाऽब्रवीत्\t ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2139133, "chapter_id": 4010, "verse_number": "६५", "content_sanskrit": "यथाहं पाण्डुपुत्रेभ्यः पञ्चभ्यो नाऽन्यचारिणी ।\nतेन सत्येन मां दृष्ट्वा कीचको मा वशं नयेत्\t ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2139134, "chapter_id": 4010, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि अष्टादशोऽध्यायः ॥१८॥ कीचकवधपर्वणि तृतीयोऽध्यायः ॥३॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}]