[{"id": 2097606, "chapter_id": 3090, "verse_number": "१३-२२०-१", "content_sanskrit": "उमोवाच।\nभगवन्देवदेवेश मम प्रीतिविवर्धन।\n`जात्यन्धाश्चैव दृश्यन्ते जाता वा नष्टचक्षुषः।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2097607, "chapter_id": 3090, "verse_number": "१३-२२०-२x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2097608, "chapter_id": 3090, "verse_number": "१३-२२०-२", "content_sanskrit": "हन्त ते कथयिष्यामि शृणु कल्याणि कारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2097609, "chapter_id": 3090, "verse_number": "१३-२२०-३", "content_sanskrit": "ये पुरा कामकारेणि परवेश्मसु लोलुपाः।\nपरस्त्रियोऽभिवीक्षन्ते दुष्टेनैव स्वचक्षुषाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2097610, "chapter_id": 3090, "verse_number": "१३-२२०-४", "content_sanskrit": "अन्धीकुर्वन्ति यन्मर्त्यान्क्रोधलोभसमन्विताः।\nलक्षणज्ञाश्च रूपेषु अयथावत्प्रदर्शकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2097611, "chapter_id": 3090, "verse_number": "१३-२२०-५", "content_sanskrit": "एवं युक्तसमाचाराः कालधर्मवशास्तु ते।\nदण्डिता यमदण्डेन निरयस्थाश्चिरं प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2097612, "chapter_id": 3090, "verse_number": "१३-२२०-६", "content_sanskrit": "यदि चेन्मानुषं जन्म लभेरंस्ते तथापि वा।\nस्वभावतो वा जाता वा अन्धा एव भवन्ति ते।\nअक्षिरोगयुता वाऽपि नास्ति तत्र विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2097613, "chapter_id": 3090, "verse_number": "१३-२२०-७x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2097614, "chapter_id": 3090, "verse_number": "१३-२२०-७", "content_sanskrit": "मुखरोगयुताः केचिद्दृश्यन्ते सततं नराः।\nदन्तकण्ठकपोलस्थैर्व्याधिभिर्बहुपीडिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2097615, "chapter_id": 3090, "verse_number": "१३-२२०-८", "content_sanskrit": "आदिप्रभृति वै मर्त्या जाता वाऽप्यथ कारणात्।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2097616, "chapter_id": 3090, "verse_number": "१३-२२०-९x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2097617, "chapter_id": 3090, "verse_number": "१३-२२०-९", "content_sanskrit": "हन्त ते कथयिष्यामि शृणु देवि समाहिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2097618, "chapter_id": 3090, "verse_number": "१३-२२०-१०", "content_sanskrit": "कुवक्तारस्तु ये देवि जिह्वया कटुकं भृशम्।\nअसत्यं परुषं घोरं गुरून्प्रति परान्प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2097619, "chapter_id": 3090, "verse_number": "१३-२२०-११", "content_sanskrit": "जिह्वाबाधां तदाऽन्येषां कुर्वते कोपकारणात्।\nप्रायशोऽनृतभूयिष्ठा नराः कार्यवशेन वा।\nतेषां जिह्वाप्रदेशस्था व्याधयः सम्भवन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2097620, "chapter_id": 3090, "verse_number": "१३-२२०-१२", "content_sanskrit": "कुश्रोतारस्तु ये चार्यं परेषां कर्णनाशकाः।\nकर्णरोगान्बहुविधाँल्लभन्ते ते पुनर्भवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2097621, "chapter_id": 3090, "verse_number": "१३-२२०-१३", "content_sanskrit": "दन्तरोगशिरोरोगकर्णरोगास्तथैव च।\nअन्ये दुःखाश्रिता दोषाः सर्वे चात्मकृतं फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2097622, "chapter_id": 3090, "verse_number": "१३-२२०-१४x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2097623, "chapter_id": 3090, "verse_number": "१३-२२०-१४", "content_sanskrit": "पीड्यन्ते सततं देव मानुषेष्वेव केचन।\nकुक्षिपक्षाश्रितैर्दोषैर्व्याधिभिश्चोदराश्रितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2097624, "chapter_id": 3090, "verse_number": "१३-२२०-१५", "content_sanskrit": "तीक्ष्णिशूलैश्च पीड्यन्ते नरा दुःखपरिप्लुताः।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2097625, "chapter_id": 3090, "verse_number": "१३-२२०-१६x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2097626, "chapter_id": 3090, "verse_number": "१३-२२०-१६", "content_sanskrit": "ये पुरा मनुजा देवि कामक्रोधवशा भृशम्।\nआत्मार्थमेव चाहारं भुञ्जन्ते निरपेक्षकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2097627, "chapter_id": 3090, "verse_number": "१३-२२०-१७", "content_sanskrit": "अभक्ष्याहारदानैश्च विश्वस्तानां विषप्रदाः।\nअभक्ष्यभक्षदाश्चैव शौचमङ्गलवर्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2097628, "chapter_id": 3090, "verse_number": "१३-२२०-१८", "content_sanskrit": "मांसयुक्तसमाचाराः पुनर्जन्मनि शोभने।\nकथञ्चित्प्राप्य मानुष्यं तत्र ते व्याधिपीडिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2097629, "chapter_id": 3090, "verse_number": "१३-२२०-१९", "content_sanskrit": "तैस्तैर्बहुविधाकारैर्व्याधिभिर्दुःखसंश्रिताः।\nभवन्त्येवं तथा देवि यथा चैवं तथा कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2097630, "chapter_id": 3090, "verse_number": "१३-२२०-२०x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2097631, "chapter_id": 3090, "verse_number": "१३-२२०-२०", "content_sanskrit": "दृश्यन्ते सततं देव व्याधिभिर्मेहनाश्रितैः।\nपीड्यमानास्तथा मर्त्या अश्मरीशर्करादिभिः।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2097632, "chapter_id": 3090, "verse_number": "१३-२२०-२१x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2097633, "chapter_id": 3090, "verse_number": "१३-२२०-२१", "content_sanskrit": "ये पुरा मनुजा देवि परदारप्रधर्षकाः।\nतिर्यग्योनिषु धूर्ता वै मैथुनार्थं चरन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2097634, "chapter_id": 3090, "verse_number": "१३-२२०-२२", "content_sanskrit": "कामदोषेणि ये धूर्ताः कन्यासु विधवासु च।\nबलात्कारेण गच्छन्ति रूपदर्पसमन्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2097635, "chapter_id": 3090, "verse_number": "१३-२२०-२३", "content_sanskrit": "तादृशा मरणं पुनर्जन्मनि शोभने।\nयदि चेन्मानुषं जन्म लभेरंस्ते तथाविधाः।\nमेहनस्थैस्तथा घोरैः पीड्यन्ते व्यधिभिः प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2097636, "chapter_id": 3090, "verse_number": "१३-२२०-२४x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2097637, "chapter_id": 3090, "verse_number": "१३-२२०-२४", "content_sanskrit": "भगवन्मानुषाः केचिद्दृश्यन्ते शोषिणः कृशाः।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2097638, "chapter_id": 3090, "verse_number": "१३-२२०-२५x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2097639, "chapter_id": 3090, "verse_number": "१३-२२०-२५", "content_sanskrit": "ये पुरा मनुजा देवि मांसलुब्धाः सुलोलुपाः।\nआत्मार्थे स्वादुगृद्धाश्च परभोगोपतापिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2097640, "chapter_id": 3090, "verse_number": "१३-२२०-२६", "content_sanskrit": "अभ्यसूयाश्चोपतापाः परभोगेषु ये नराः।\nएवं युक्तसमाचाराः पुनर्जन्मनि शोभने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2097641, "chapter_id": 3090, "verse_number": "१३-२२०-२७", "content_sanskrit": "शेषव्याधियुतास्तत्र नरा धमनिसंतताः।\nभवन्त्येव नरा देवि पापकर्मोपभोगिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2097642, "chapter_id": 3090, "verse_number": "१३-२२०-२८x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2097643, "chapter_id": 3090, "verse_number": "१३-२२०-२८", "content_sanskrit": "भगवन्मानुषाः केचित्क्लिश्यन्ते कण्ठरोगिणः।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2097644, "chapter_id": 3090, "verse_number": "१३-२२०-२९x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2097645, "chapter_id": 3090, "verse_number": "१३-२२०-२९", "content_sanskrit": "ये पुरा मनुजा देवि परेषां रूपनाशनाः।\nआघातवधबन्धैश्च वृथा दण्डेन मोहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2097646, "chapter_id": 3090, "verse_number": "१३-२२०-३०", "content_sanskrit": "इष्टनाशकरा ये तु अपथ्याहारदा नराः।\nचिकित्सका वा दुष्टास्च द्वेषलोभसमन्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2097647, "chapter_id": 3090, "verse_number": "१३-२२०-३१", "content_sanskrit": "निर्दयाः प्राणिहिंसायां मलदाश्चित्तनाशनाः।\nएवंयुक्तसमाचाराः पुनर्जन्मनि शोभने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2097648, "chapter_id": 3090, "verse_number": "१३-२२०-३२", "content_sanskrit": "यदि वै मानुषं जन्म लभेरंस्तेषु दुःखिताः।\nअत्र ते क्लेशसंयुक्ताः कण्ठरोगशतैर्वृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2097649, "chapter_id": 3090, "verse_number": "१३-२२०-३३", "content_sanskrit": "केचित्त्वग्दोषसंयुक्ता व्रणकुष्ठैश्च संयुताः।\nश्वित्रकुष्ठयुता वाऽपि बहुधा कृच्छ्रसंयुताः।\nभवन्त्येव नरा देवि यथा तेन कृतं फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2097650, "chapter_id": 3090, "verse_number": "१३-२२०-३४x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2097651, "chapter_id": 3090, "verse_number": "१३-२२०-३४", "content_sanskrit": "भगवन्मानुषाः केचिदङ्गहीनाश्च पङ्गव।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2097652, "chapter_id": 3090, "verse_number": "१३-२२०-३५x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2097653, "chapter_id": 3090, "verse_number": "१३-२२०-३५", "content_sanskrit": "ये पुरा मनुजा देवि लोभमोहसमावृताः।\nप्राणिनां प्राणहिंसार्थमङ्गविघ्नं प्रकुर्वते।\nशस्त्रेणोत्कृत्य वा देवि प्राणिनां चेष्टनाशकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2097654, "chapter_id": 3090, "verse_number": "१३-२२०-३६", "content_sanskrit": "एवं युक्तसमाचाराः पुनर्जन्मनि शोभने।\nतदङ्गहीना वै प्रेत्य भवन्त्येव न संशयः।\nस्वभावतो वा जाता वा पङ्गवश्च भवन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2097655, "chapter_id": 3090, "verse_number": "१३-२२०-३७x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2097656, "chapter_id": 3090, "verse_number": "१३-२२०-३७", "content_sanskrit": "भगवन्मानुषाः केचिद्ग्रन्थिभिः पिलकैस्तथा।\nक्लिश्यमानाः प्रदृश्यन्ते तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2097657, "chapter_id": 3090, "verse_number": "१३-२२०-३८x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2097658, "chapter_id": 3090, "verse_number": "१३-२२०-३८", "content_sanskrit": "ये पुरा मनुजा देवि ग्रन्थिभेदकरा नृणाम्।\nमुष्टिप्रहारपरुषा नृशंसाः पापकारिणः।\nपाटकास्तोटकाश्चैव शूलतुन्नास्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2097659, "chapter_id": 3090, "verse_number": "१३-२२०-३९", "content_sanskrit": "एवंयुक्तसमाचाराः पुनर्जन्मनि शोभने।\nग्रन्थिभिः पिलकैश्चैव क्लिश्यन्ते भृशदुःखिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2097660, "chapter_id": 3090, "verse_number": "१३-२२०-४०x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2097661, "chapter_id": 3090, "verse_number": "१३-२२०-४०", "content_sanskrit": "भगवन्मानुषाः केचित्पादरोगसमन्विताः।\nदृश्यन्ते सततं देव तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2097662, "chapter_id": 3090, "verse_number": "१३-२२०-४१x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2097663, "chapter_id": 3090, "verse_number": "१३-२२०-४१", "content_sanskrit": "ये पुरा मनुजा देवि क्रोधलोभसमन्विताः।\nमनुजा देवतास्थानं स्वपादैर्भ्रंशयन्त्युत।\nजानुभिः पार्ष्णिभिश्चैव प्राणिहिंसां प्रकुर्वते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2097664, "chapter_id": 3090, "verse_number": "१३-२२०-४२", "content_sanskrit": "एवंयुक्तसमाचाराः पुनर्जन्मनि शोभने।\nपादरोगैर्बहुविधैर्बाध्यन्ते विपदादिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2097665, "chapter_id": 3090, "verse_number": "१३-२२०-४३x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2097666, "chapter_id": 3090, "verse_number": "१३-२२०-४३", "content_sanskrit": "भगवन्मानुषाः केचिद्दृश्यन्ते बहवो भुवि।\nवातजैः पित्तजै रोगैर्युगपत्सान्निपातकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2097667, "chapter_id": 3090, "verse_number": "१३-२२०-४४", "content_sanskrit": "रोगैर्बहुविधैर्देव क्लिश्यमानाः सुदुःखिताः।\nअसमस्तैः समस्तैश्च आढ्या वा दुर्गतास्तथा।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2097668, "chapter_id": 3090, "verse_number": "१३-२२०-४५x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2097669, "chapter_id": 3090, "verse_number": "१३-२२०-४५", "content_sanskrit": "तदहं ते प्रवक्ष्यामि शृणु कल्याणि कारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2097670, "chapter_id": 3090, "verse_number": "१३-२२०-४६", "content_sanskrit": "ये पुरा मनुजा देवि त्वासुरं भावमाश्रिताः।\nस्ववशाः कोपनपरा गुरुविद्वेषिणस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2097671, "chapter_id": 3090, "verse_number": "१३-२२०-४७", "content_sanskrit": "परेषां दुःखजनका मनोवाक्कायकर्मभिः।\nछिन्दन्भिन्दन्स्तुदन्नेव नित्यं प्राणिषु निर्दयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2097672, "chapter_id": 3090, "verse_number": "१३-२२०-४८", "content_sanskrit": "एवंयुक्तसमाचाराः पुनर्जन्मनि शोभने।\nयदि वै मानुषं जन्म लभेरंस्ते तथाविधाः।\nतत्र ते बहुभिर्घोरैस्तप्यन्ते व्याधिभिः प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2097673, "chapter_id": 3090, "verse_number": "१३-२२०-४९", "content_sanskrit": "केचिद्वातादिसंयुक्ताः केचित्काससमन्विताः।\nज्वरातिसारतृष्णाभिः पीड्यमानास्तथा परे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2097674, "chapter_id": 3090, "verse_number": "१३-२२०-५०", "content_sanskrit": "पादगुल्मैश्च बहुभिः श्लेष्मदोषसमन्विताः।\nपादरोगैश्च विविधैर्व्रणकुष्ठभगंदरैः।\nआढ्या वा दुर्गता वाऽपि दृश्यन्ते व्याधिपीडिताः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2097675, "chapter_id": 3090, "verse_number": "१३-२२०-५१", "content_sanskrit": "एवमात्मकृतं कर्म भुञ्जन्ते तत्रतत्र ते।\nअभिभूतुं न शक्यं हि केनचित्स्वकृतं फलम्।\nइति ते कथितं देवि भूयः श्रोतुं किमिच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2097676, "chapter_id": 3090, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि विंशत्यधिकद्विशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]