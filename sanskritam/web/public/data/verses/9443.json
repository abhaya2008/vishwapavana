[{"id": 5000443000, "chapter_id": 9443, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे षट्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000443001, "chapter_id": 9443, "verse_number": "६-३६-१", "content_sanskrit": "तत् तु माल्यवतो वाक्यं हितमुक्तं दशाननः।\nन मर्षयति दुष्टात्मा कालस्य वशमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000443002, "chapter_id": 9443, "verse_number": "६-३६-२", "content_sanskrit": "स बद्‍ध्वा भ्रुकुटिं वक्त्रे क्रोधस्य वशमागतः।\nअमर्षात् परिवृत्ताक्षो माल्यवन्तमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000443003, "chapter_id": 9443, "verse_number": "६-३६-३", "content_sanskrit": "हितबुद्ध्या यदहितं वचः परुषमुच्यते।\nपरपक्षं प्रविश्यैव नैतच्छ्रोत्रगतं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000443004, "chapter_id": 9443, "verse_number": "६-३६-४", "content_sanskrit": "मानुषं कृपणं राममेकं शाखामृगाश्रयम्।\nसमर्थं मन्यसे केन त्यक्तं पित्रा वनाश्रयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000443005, "chapter_id": 9443, "verse_number": "६-३६-५", "content_sanskrit": "रक्षसामीश्वरं मां च देवानां च भयंकरम्।\nहीनं मां मन्यसे केन अहीनं सर्वविक्रमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000443006, "chapter_id": 9443, "verse_number": "६-३६-६", "content_sanskrit": "वीरद्वेषेण वा शङ्के पक्षपातेन वा रिपोः।\nत्वयाहं परुषाण्युक्तो परप्रोत्साहनेन वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000443007, "chapter_id": 9443, "verse_number": "६-३६-७", "content_sanskrit": "प्रभवन्तं पदस्थं हि परुषं कोऽभिभाषते।\nपण्डितः शास्त्रतत्त्वज्ञो विना प्रोत्साहनेन वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000443008, "chapter_id": 9443, "verse_number": "६-३६-८", "content_sanskrit": "आनीय च वनात् सीतां पद्महीनामिव श्रियम्।\nकिमर्थं प्रतिदास्यामि राघवस्य भयादहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000443009, "chapter_id": 9443, "verse_number": "६-३६-९", "content_sanskrit": "वृतं वानरकोटीभिः ससुग्रीवं सलक्ष्मणम्।\nपश्य कैश्चिदहोभिश्च राघवं निहतं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000443010, "chapter_id": 9443, "verse_number": "६-३६-१०", "content_sanskrit": "द्वन्द्वे यस्य न तिष्ठन्ति दैवतान्यपि संयुगे।\nस कस्माद् रावणो युद्धे भयमाहारयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000443011, "chapter_id": 9443, "verse_number": "६-३६-११", "content_sanskrit": "द्विधा भज्येयमप्येवं न नमेयं तु कस्यचित्।\nएष मे सहजो दोषः स्वभावो दुरतिक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000443012, "chapter_id": 9443, "verse_number": "६-३६-१२", "content_sanskrit": "यदि तावत् समुद्रे तु सेतुर्बद्धो यदृच्छया।\nरामेण विस्मयः कोऽत्र येन ते भयमागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000443013, "chapter_id": 9443, "verse_number": "६-३६-१३", "content_sanskrit": "स तु तीर्त्वार्णवं रामः सह वानरसेनया।\nप्रतिजानामि ते सत्यं न जीवन् प्रतियास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000443014, "chapter_id": 9443, "verse_number": "६-३६-१४", "content_sanskrit": "एवं ब्रुवाणं संरब्धं रुष्टं विज्ञाय रावणम्।\nव्रीडितो माल्यवान् वाक्यं नोत्तरं प्रत्यपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000443015, "chapter_id": 9443, "verse_number": "६-३६-१५", "content_sanskrit": "जयाशिषा तु राजानं वर्धयित्वा यथोचितम्।\nमाल्यवानभ्यनुज्ञातो जगाम स्वं निवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000443016, "chapter_id": 9443, "verse_number": "६-३६-१६", "content_sanskrit": "रावणस्तु सहामात्यो मन्त्रयित्वा विमृश्य च।\nलङ्कायास्तु तदा गुप्तिं कारयामास राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000443017, "chapter_id": 9443, "verse_number": "६-३६-१७", "content_sanskrit": "व्यादिदेश च पूर्वस्यां प्रहस्तं द्वारि राक्षसम्।\nदक्षिणस्यां महावीर्यौ महापार्श्वमहोदरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000443018, "chapter_id": 9443, "verse_number": "६-३६-१८", "content_sanskrit": "पश्चिमायामथ द्वारि पुत्रमिन्द्रजितं तदा।\nव्यादिदेश महामायं राक्षसैर्बहुभिर्वृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000443019, "chapter_id": 9443, "verse_number": "६-३६-१९", "content_sanskrit": "उत्तरस्यां पुरद्वारि व्यादिश्य शुकसारणौ।\nस्वयं चात्र गमिष्यामि मन्त्रिणस्तानुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000443020, "chapter_id": 9443, "verse_number": "६-३६-२०", "content_sanskrit": "राक्षसं तु विरूपाक्षं महावीर्यपराक्रमम्।\nमध्यमेऽस्थापयद् गुल्मे बहुभिः सह राक्षसैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000443021, "chapter_id": 9443, "verse_number": "६-३६-२१", "content_sanskrit": "एवं विधानं लङ्कायां कृत्वा राक्षसपुंगवः।\nकृतकृत्यमिवात्मानं मन्यते कालचोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000443022, "chapter_id": 9443, "verse_number": "६-३६-२२", "content_sanskrit": "विसर्जयामास ततः स मन्त्रिणो\nविधानमाज्ञाप्य पुरस्य पुष्कलम्।\nजयाशिषा मन्त्रिगणेन पूजितो\nविवेश सोऽन्तःपुरमृद्धिमन्महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000443023, "chapter_id": 9443, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे षट्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]