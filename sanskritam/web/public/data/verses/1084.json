[{"id": 2004267, "chapter_id": 1084, "verse_number": "१-८५-०x", "content_sanskrit": "अष्टक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2004268, "chapter_id": 1084, "verse_number": "१-८५-१", "content_sanskrit": "चरन्गृहस्थः कथमेति धर्मा-\nन्कथं भिक्षुः कथमाचार्यकर्मा।\nवानप्रस्थः सत्पथे सन्निविष्टो\nबहून्यस्मिन्संप्रति वेदयन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2004269, "chapter_id": 1084, "verse_number": "१-८५-२x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2004270, "chapter_id": 1084, "verse_number": "१-८५-२", "content_sanskrit": "आहूताध्यायी गुरुकर्मस्वचोद्यः\nपूर्वोत्थायी चरमं चोपशायी।\nमृदुर्दान्तो धृतिमानप्रमत्तः\nस्वाध्याशीलः सिध्यति ब्रह्मचारी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2004271, "chapter_id": 1084, "verse_number": "१-८५-३", "content_sanskrit": "धर्मागतं प्राप्य धनं यजेत\nदद्यात्सदैवातिथीन्भोजयेच्च।\nअनाददानश्च परैरदत्तं\nसैषा गृहस्थोपनिषत्पुराणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2004272, "chapter_id": 1084, "verse_number": "१-८५-४", "content_sanskrit": "स्ववीर्यजीवी वृजिनान्निवृत्तो\nदाता परेभ्यो न परोपतापी।\nतादृङ्मुनिः सिद्धिमुपैति मुख्यां\nवसन्नरण्ये नियताहारचेष्टः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2004273, "chapter_id": 1084, "verse_number": "१-८५-५", "content_sanskrit": "अशिल्पजीवी गुणवांश्चैव नित्यं\nजितेन्द्रियः सर्वतो विप्रयुक्तः।\nअनोकशायी लघुरल्पप्रसार-\nश्चरन्देशानेकचरः स भिक्षुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2004274, "chapter_id": 1084, "verse_number": "१-८५-६", "content_sanskrit": "रात्र्या यया वाऽभिजिताश्च लोका\nभवन्ति कामाभिजिताः सुखाश्च।\nतामेव रात्रिं प्रयतेत विद्वा-\nनरण्यसंस्थो भवितुं यतात्मा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2004275, "chapter_id": 1084, "verse_number": "१-८५-७", "content_sanskrit": "दशैव पूर्वान्दश चापरांश्च\nज्ञातीनथात्मानमथैकविंशम्।\nअरण्यवासी सुकृते दधाति\nविमुच्यारण्ये स्वशरीरधातून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2004276, "chapter_id": 1084, "verse_number": "१-८५-८x", "content_sanskrit": "अष्टक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2004277, "chapter_id": 1084, "verse_number": "१-८५-८", "content_sanskrit": "कतिस्विदेव मुनयः कति मौनानि चाप्युत।\nभवन्तीति तदाचक्ष्व श्रोतुमिच्छामहे वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2004278, "chapter_id": 1084, "verse_number": "१-८५-९x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2004279, "chapter_id": 1084, "verse_number": "१-८५-९", "content_sanskrit": "अरण्ये वसतो यस्य ग्रामो भवति पृष्ठतः।\nग्रामे वा वसतोऽरण्यं स मुनिः स्याज्जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2004280, "chapter_id": 1084, "verse_number": "१-८५-१०x", "content_sanskrit": "अष्टक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2004281, "chapter_id": 1084, "verse_number": "१-८५-१०", "content_sanskrit": "कथंस्विद्वसतोऽरण्ये ग्रामो भवति पृष्ठतः।\nग्रामे वा वसतोऽरण्यं कथं भवति पृष्ठतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2004282, "chapter_id": 1084, "verse_number": "१-८५-११x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2004283, "chapter_id": 1084, "verse_number": "१-८५-११", "content_sanskrit": "न ग्राम्यमुपयुञ्जीत य आरण्यो मुनिर्भवेत्।\nतथास्य वसतोऽरण्ये ग्रामो भवति पृष्ठतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2004284, "chapter_id": 1084, "verse_number": "१-८५-१२", "content_sanskrit": "अनग्निरनिकेतश्चाप्यगोत्रचरणो मुनिः।\nकौपीनाच्छादनं यावत्तावदिच्छेच्च चीवरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2004285, "chapter_id": 1084, "verse_number": "१-८५-१३", "content_sanskrit": "यावत्प्राणाभिसन्धानं तावदिच्छेच्च भोजनम्।\nतथाऽस्य वसतो ग्रामेऽरण्यं भवति पृष्ठतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2004286, "chapter_id": 1084, "verse_number": "१-८५-१४", "content_sanskrit": "यस्तु कामान्परित्यज्य त्यक्तकर्मा जितेन्द्रियः।\nआतिष्ठेच्च मुनिर्मौनं स लोके सिद्धिमाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2004287, "chapter_id": 1084, "verse_number": "१-८५-१५", "content_sanskrit": "धौतदन्तं कृत्तनखं सदा स्नातमलङ्कृतम्।\nअसितं सितकर्माणं कस्तमर्हति नार्चितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2004288, "chapter_id": 1084, "verse_number": "१-८५-१६", "content_sanskrit": "तपसा कर्शितः क्षामः क्षीणमांसास्थिशोणितः।\nस च लोकमिमं जित्वा लोकं विजयते परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2004289, "chapter_id": 1084, "verse_number": "१-८५-१७", "content_sanskrit": "यदा भवति निर्द्वन्द्वो मुनिर्मौनं समास्थितः।\nअथ लोकमिमं जित्वा लोकं विजयते परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2004290, "chapter_id": 1084, "verse_number": "१-८५-१८", "content_sanskrit": "आस्येन तु यदाऽहारं गोवन्मृगयते मुनिः।\nअथास्य लोकः सर्वोऽयं सोऽमृतत्वाय कल्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2004291, "chapter_id": 1084, "verse_number": "१-८५-१९", "content_sanskrit": "सामान्यधर्मः सर्वेषां क्रोधो लोभो द्रुहाऽक्षमा।\nविहाय मत्सरं शाठ्यं दर्पं दम्भं च पैशुनम्।\nक्रोधं लोभं ममत्वं च यस्य नास्ति स धर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2004292, "chapter_id": 1084, "verse_number": "१-८५-२०x", "content_sanskrit": "अष्टक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2004293, "chapter_id": 1084, "verse_number": "१-८५-२०", "content_sanskrit": "नित्याशनो ब्रह्मचारी गृहस्थो वनगो मुनिः।\nनाधर्ममशनात्प्राप्येत्कथं ब्रूहीह पृच्छते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2004294, "chapter_id": 1084, "verse_number": "१-८५-२१x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2004295, "chapter_id": 1084, "verse_number": "१-८५-२१", "content_sanskrit": "अष्टौ ग्रासा मुनेः प्रोक्ताः षोडशारण्यवासिनः।\nद्वात्रिंशत्तु गृहस्थस्य अमितं ब्रह्मचारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2004296, "chapter_id": 1084, "verse_number": "१-८५-२२", "content_sanskrit": "इत्येवं कारणैर्ज्ञेयमष्टकैतच्छुभाशुभम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2004297, "chapter_id": 1084, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि पञ्चाशीतितमोऽध्यायः॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]