[{"id": 2051628, "chapter_id": 2142, "verse_number": "७-६९-०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2051629, "chapter_id": 2142, "verse_number": "७-६९-१", "content_sanskrit": "पुथुं वैन्यं च राजानं मृतं सृञ्जय शुश्रुम।\nयमब्यषिञ्चत्सम्मन्त्र्य राजसूये महर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2051630, "chapter_id": 2142, "verse_number": "७-६९-२", "content_sanskrit": "अयं नः प्रथयिष्येत सर्वानित्यभवत्पृथुः।\nक्षतान्नस्त्रास्यते सर्वानत्येवं क्षत्रियोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2051631, "chapter_id": 2142, "verse_number": "७-६९-३", "content_sanskrit": "पृथुं वैन्यं प्रजा दृष्ट्वा रक्ताः स्मेति यदब्रुवन्।\nततो राजेति नामास्य अनुरागादजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2051632, "chapter_id": 2142, "verse_number": "७-६९-४", "content_sanskrit": "अकृष्टपच्या पृथिवी आसीद्वैन्यस्य कामधुक्।\nसर्वाः समादुघा गावः पुटकेपुटके मधु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2051633, "chapter_id": 2142, "verse_number": "७-६९-५", "content_sanskrit": "आसन्हिरण्मया वृक्षाः सुखस्पर्शाः सुखावहाः।\nतेषां चीरxx संवीताः प्रजास्तेष्वेव शेरते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2051634, "chapter_id": 2142, "verse_number": "७-६९-६", "content_sanskrit": "फलान्यमृतकल्पानि स्वादूनि च मधूनि च।\nतेषामासीत्तदाऽऽहारो निराहाराश्च नाभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2051635, "chapter_id": 2142, "verse_number": "७-६९-७", "content_sanskrit": "अरोगाः सर्वसिद्धार्था मनुष्या ह्यकुतोभयाः।\nन्यवसन्त यथाकामं वृक्षेषु च गुहासु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2051636, "chapter_id": 2142, "verse_number": "७-६९-८", "content_sanskrit": "प्रविभागो न राष्ट्राणां पुराणां चाभवत्तदा।\nयथासुखं यथाकामं तथैता मुदिताः प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2051637, "chapter_id": 2142, "verse_number": "७-६९-९", "content_sanskrit": "तस्य संस्तम्भिता ह्यापः समुद्रमभियास्यतः।\nपर्वताश्च ददुर्मार्गं ध्वजभङ्गश्च नाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2051638, "chapter_id": 2142, "verse_number": "७-६९-१०", "content_sanskrit": "तं वनस्पतयः शैला देवासुरनरोरगाः।\nसप्तर्षयः पुण्यजना गन्धर्वाप्सरसोऽपि च।\nपितरश्च सुखासीनमभिगम्येदमब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2051639, "chapter_id": 2142, "verse_number": "७-६९-११", "content_sanskrit": "सम्राडसि क्षत्रियोऽसि राजा गोप्ता पिताऽसि नः।\nदेह्यस्मभ्यं महाराज प्रभुः सन्नीप्सितान्वरान्।\nयैर्वयं शाश्वतं तृप्ता वर्तयिष्यामहे सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2051640, "chapter_id": 2142, "verse_number": "७-६९-१२", "content_sanskrit": "`विज्ञापितः प्रजाभिस्तु प्रजानां हितकाम्यया।\nधनुर्गृह्य पृषत्कांश्च वसुधामाद्रवद्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2051641, "chapter_id": 2142, "verse_number": "७-६९-१३", "content_sanskrit": "ततो वैन्यभयाद्राजन्गौर्भूत्वा प्राद्रवन्मही।\nतां पृथुर्धनुरादाय द्रवन्तीमन्वसारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2051642, "chapter_id": 2142, "verse_number": "७-६९-१४", "content_sanskrit": "सा लोकान्ब्रह्मलोकादीन्गत्वा वैन्यभयार्दिता।\nसा ददर्शाग्रतो वैन्यं कार्मुकोद्यतपाणिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2051643, "chapter_id": 2142, "verse_number": "७-६९-१५", "content_sanskrit": "ज्वलद्भिर्विशिखैर्बाणैर्दीप्ततेजःसमद्युतिम्।\nमहायोगं महात्मानं दुर्धर्षममरैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2051644, "chapter_id": 2142, "verse_number": "७-६९-१६", "content_sanskrit": "अलभन्ती परित्राणं वैन्यमेवाभ्यपद्यत।\nकृताञ्जलिपुटा राजन्पूज्यं लोकैस्त्रिभिस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2051645, "chapter_id": 2142, "verse_number": "७-६९-१७", "content_sanskrit": "उवाच चैनं नाधर्म्यं स्त्रीवधं कर्तुमर्हसि।\nकथं धारयिता चासि प्रजा राजन्मया विना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2051646, "chapter_id": 2142, "verse_number": "७-६९-१८x", "content_sanskrit": "पृथुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2051647, "chapter_id": 2142, "verse_number": "७-६९-१८", "content_sanskrit": "एकस्यार्थाय यो हन्यादात्मनो वा परस्य वा।\nएकं प्राणान्बहून्वापि प्राणिनां नास्ति पातकं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2051648, "chapter_id": 2142, "verse_number": "७-६९-१९", "content_sanskrit": "यस्मिंस्तु निहते भद्रे बहवः सुखमेधते।\nतस्मिन्हते त्वधं नास्ति पातकं नोपभुज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2051649, "chapter_id": 2142, "verse_number": "७-६९-२०", "content_sanskrit": "सोऽहं पालनिमित्तं त्वां बधिष्यामि वसुंधरे।\nयदि चेद्वचनादद्य न करिष्यसि मे प्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2051650, "chapter_id": 2142, "verse_number": "७-६९-२१", "content_sanskrit": "त्वां निहत्य तु बाणेन मच्छासनपराङ्मुखीम्।\nआत्मानं प्रथयित्वाऽहं प्रजा धारयिता स्वयं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2051651, "chapter_id": 2142, "verse_number": "७-६९-२२", "content_sanskrit": "सुखं वचनमास्थाय मम धर्मभृतां वरे।\nस़ञ्जीवय प्रजा नित्यं शक्ता ह्यसि वसुन्धरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2051652, "chapter_id": 2142, "verse_number": "७-६९-२३", "content_sanskrit": "दुहितृत्वं च मे गच्छ एवमेतन्महाशरम्।\nनियच्छेयं त्वदर्थाय उद्यतं घोरदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2051653, "chapter_id": 2142, "verse_number": "७-६९-२४x", "content_sanskrit": "भूमिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2051654, "chapter_id": 2142, "verse_number": "७-६९-२४", "content_sanskrit": "सर्वमेतन्महाराज विधास्यासि परन्तप।\nवत्सं त्वं पश्य राजन्वै क्षरेयं येन वत्सला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2051655, "chapter_id": 2142, "verse_number": "७-६९-२५", "content_sanskrit": "समां तु कुरु सर्वज्ञ मां तु धर्मभृतां वर।\nयथा विष्यन्दमानं वै क्षीरं सर्वत्र भावये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2051656, "chapter_id": 2142, "verse_number": "७-६९-२६x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2051657, "chapter_id": 2142, "verse_number": "७-६९-२६", "content_sanskrit": "तत उत्सारयामास शिलाजालानि सर्वशः।\nपृथुर्वैन्यस्तदा राजा तेन शैला विवर्धिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2051658, "chapter_id": 2142, "verse_number": "७-६९-२७", "content_sanskrit": "न हि पूर्वनिसर्गे वै विषमे वसुधातले।\nप्रविभागः पुराणां वा ग्रामाणां वा महीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2051659, "chapter_id": 2142, "verse_number": "७-६९-२८", "content_sanskrit": "न सस्यानि न गोरक्ष्यं न कृषिर्न वणिक्पथः।\nवैन्यात्प्रभृति राजेन्दर सर्वस्यैतस्य सम्भवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2051660, "chapter_id": 2142, "verse_number": "७-६९-२९", "content_sanskrit": "यत्रयत्र च साम्यं तु भूमावासीत्किलानघ।\nतत्रतत्र प्रजास्तात निवासमभिरोचयन्।\nकृच्छ्रेण च महाराज इत्येवमनुशुश्रुम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2051661, "chapter_id": 2142, "verse_number": "७-६९-३०", "content_sanskrit": "तथेत्युक्त्वा पुनर्वैन्यो गृहीत्वाऽऽजगवं धनुः।\nशरांश्चाप्रतिमान्घोरांश्चिन्तयित्वाऽब्रवीन्महीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2051662, "chapter_id": 2142, "verse_number": "७-६९-३१x", "content_sanskrit": "पृथुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2051663, "chapter_id": 2142, "verse_number": "७-६९-३१", "content_sanskrit": "एह्येहि वसुधे क्षिप्रं क्षरैभ्यः काङ्क्षितं पयः।\nमच्छसनातिगां वै त्वां प्रमथिष्याम्यहं शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2051664, "chapter_id": 2142, "verse_number": "७-६९-३२x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2051665, "chapter_id": 2142, "verse_number": "७-६९-३२", "content_sanskrit": "तथोक्ता साऽत्मनः श्रेयश्चिन्तयित्वाऽब्रवीत्पृथुम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2051666, "chapter_id": 2142, "verse_number": "७-६९-३२x", "content_sanskrit": "भूमिरुवाच।\nवत्सं पात्राणि दोग्धॄंश्च क्षीराणि च समादिश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2051667, "chapter_id": 2142, "verse_number": "७-६९-३३", "content_sanskrit": "ततो दास्याम्यहं भद्र सर्वं यस्य यथेप्सितम्।\nदुहितृत्वे च मां वीर सङ्कल्पयितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2051668, "chapter_id": 2142, "verse_number": "७-६९-३४x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2051669, "chapter_id": 2142, "verse_number": "७-६९-३४", "content_sanskrit": "तथेत्युक्त्वा पृथुः सर्वं विधानमकरोद्वशी।\nततो भूतनिकायास्तां वसुधां दुदुहुस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2051670, "chapter_id": 2142, "verse_number": "७-६९-३५", "content_sanskrit": "तां वनस्पतयः पूर्वं समुत्तस्थुर्दुधुक्षवः।\nसाऽतिष्ठद्वत्सला वत्सं दोग्धृपात्राणि चेच्छती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2051671, "chapter_id": 2142, "verse_number": "७-६९-३६", "content_sanskrit": "वत्सोऽभूत्पुष्पितः सालः प्लक्षो दोग्धाऽभवत्तदा।\nछिन्नप्ररोहणं दुग्धं पात्रमौदुम्बरं शुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2051672, "chapter_id": 2142, "verse_number": "७-६९-३७", "content_sanskrit": "उदयः पर्वतो वत्सो मेरुर्दोग्धा महागिरिः।\nरत्नान्योषधयो दुग्धं पात्रमस्तमयं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2051673, "chapter_id": 2142, "verse_number": "७-६९-३८", "content_sanskrit": "`देवानां वत्स इन्द्रोऽभूत्पात्रं दारुमयं तथा।\nदोग्धा च सविता देवो दुग्धमूर्जस्करं प्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2051674, "chapter_id": 2142, "verse_number": "७-६९-३९", "content_sanskrit": "असुरा दुदुहुर्मायामयःपात्रे तु तां तदा।\nदोग्धा द्विमूर्धा तत्रासीद्वत्सश्चासीद्विरोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2051675, "chapter_id": 2142, "verse_number": "७-६९-४०", "content_sanskrit": "कृषिं च सस्यं च नरा दुदुहुः पृथिवीतले।\nस्वायंभुवो मनुर्वत्सस्तेषां दोग्धाऽभवत्पृथुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2051676, "chapter_id": 2142, "verse_number": "७-६९-४१", "content_sanskrit": "अलाबुपात्रे च तथा विषं दुग्धा वसुन्धरा।\nधृतराष्ट्रोऽभवद्दोग्धा तेषां वत्सस्तु तक्षकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2051677, "chapter_id": 2142, "verse_number": "७-६९-४२", "content_sanskrit": "सप्तर्षिभिर्ब्रह्म दुग्धा तथा चाक्लिष्टकर्मभिः।\nदोग्धा बृहस्पतिः पात्रं छन्दो वत्सश्च सोमराट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2051678, "chapter_id": 2142, "verse_number": "७-६९-४३", "content_sanskrit": "अन्तर्धानं चामपात्रे दुग्धा पुण्यजनैर्विराट्।\nदोग्धा वैश्रवणस्तेषां वत्सश्चासीद्वृषध्वजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2051679, "chapter_id": 2142, "verse_number": "७-६९-४४", "content_sanskrit": "पुण्यगन्धान्पद्मपात्रे गन्धर्वाप्सरसोऽदुहन्।\nवत्सश्चित्ररथस्तेषां दोग्धा विश्वरुचिः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2051680, "chapter_id": 2142, "verse_number": "७-६९-४५", "content_sanskrit": "स्वधां रजतपात्रेषु दुदुहुः पितरश्च ताम्।\nवत्सो वैवस्वतस्तेषां यमो दोग्धान्तकस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2051681, "chapter_id": 2142, "verse_number": "७-६९-४६", "content_sanskrit": "एवं निकायैस्तैर्दुग्धा पयोऽभीष्टं हि सा विराट्।\nयैर्वर्तयन्ति ते ह्यद्य पात्रैर्वत्सैश्च नित्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2051682, "chapter_id": 2142, "verse_number": "७-६९-४७", "content_sanskrit": "यज्ञैश्च विविधैरिष्ट्वा पृथुर्वैन्यः प्रतापवान्।\nसन्तर्पयित्वा भूतानि सर्वैः कामैर्मनःप्रियैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2051683, "chapter_id": 2142, "verse_number": "७-६९-४८", "content_sanskrit": "हैरण्यानकरोद्राजा ये केचित्पार्थिवा भुवि।\nतान्ब्राह्मणेभ्यः प्रायच्छदश्वमेधे महामखे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2051684, "chapter_id": 2142, "verse_number": "७-६९-४९", "content_sanskrit": "स षष्टिं गोसहस्राणि षष्टिं नागशतानि च।\nसौवर्णानकरोद्राजा ब्राह्मणेभ्यश्च तान्ददौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2051685, "chapter_id": 2142, "verse_number": "७-६९-५०", "content_sanskrit": "इमां च पृथिवीं सर्वां मणिरत्नविभूषिताम्।\nसौवर्णीमकरोद्राजा ब्राह्मणेभ्यश्च तां ददौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2051686, "chapter_id": 2142, "verse_number": "७-६९-५१", "content_sanskrit": "स चेन्ममार सृञ्जय चतुर्भद्रतरस्त्वया।\nपुत्रात्पुण्यतरस्तुभ्यं मा पुत्रमनुतप्यथाः।\nअयज्वानमदक्षिण्यमभि श्वैत्येत्युदाहरत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2051687, "chapter_id": 2142, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि अभिमन्युवधपर्वणि षोडशराजकीये एकोनसप्ततितमोऽध्यायः॥ ६९ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-६९-१ ध्वजभङ्गस्तोरणादिना॥ ५-६९-३९ द्विमूर्धा शुक्रोऽभूत् इति क.ङ.ड.पाठः॥ ५-६९-४३ विराट् पृथिवी। वत्सश्चासीत्कुवेरकः इति.पाठः॥ ५-६९-४४ दोग्धा वसुरपि प्रभुः इति क.ङ.ड.पाठः॥ ५-६९-४५ वत्सोऽत्र वत्सरस्तेषां क.ङ.पाठः॥ ५-६९-४६ निवर्तयन्ति ते रुद्रादिष्टे वैन्येन सर्वशः इति क. पाठः। यैर्वर्तयन्ति ते तृप्तादिष्टे वैन्येन सर्वशः इति ङ. पाठः। ये वर्षयन्ति ते पात्रैः वत्सैर्दोग्धैश्च नित्यशः इति ङ. पाठः॥ ५-६९-४८ पार्थिवाः पृथ्वीसंवन्धिपदार्थाः॥ ५-६९-६९ एकोनसप्ततितमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]