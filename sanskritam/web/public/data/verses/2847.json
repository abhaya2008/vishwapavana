[{"id": 2087060, "chapter_id": 2847, "verse_number": "१२-३५२-०x", "content_sanskrit": "`भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2087061, "chapter_id": 2847, "verse_number": "१२-३५२-१", "content_sanskrit": "नाम्नां निरुक्तं वक्ष्यामि शृणुष्वैकाग्रमानसः।\nसूर्याचन्द्रमसौ शश्वत्केशैर्मे अंशुसंज्ञितैः।\nबोधयंस्तापयंश्चैव जगदुत्तिष्ठते पृथक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2087062, "chapter_id": 2847, "verse_number": "१२-३५२-२", "content_sanskrit": "बोधनात्तापनाच्चैव जगतो हर्षणं भवेत्।\nअग्नीषोमकृतैरेभिः कर्मभिः पाण्डुनन्दन।\nहृषीकेशोऽहमीशानो वरदो लोकभावनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2087063, "chapter_id": 2847, "verse_number": "१२-३५२-३", "content_sanskrit": "इलोपहूतं गेहेषु हरे भागं क्रतुष्वहम्।\nवर्णो मे हरितः श्रेष्ठस्तस्माद्धरिरहं स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2087064, "chapter_id": 2847, "verse_number": "१२-३५२-४", "content_sanskrit": "धामसारो हि लोकानामृतं चैव विचारितम्।\nऋतधामा ततो विप्रैः सद्यश्चाहं प्रकीर्तितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2087065, "chapter_id": 2847, "verse_number": "१२-३५२-५", "content_sanskrit": "नष्टां च धरणीं पूर्वमविन्दं वै गुहागताम्।\nगोविन्द इति तेनाहं देवैर्वाग्भिरभिष्टुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2087066, "chapter_id": 2847, "verse_number": "१२-३५२-६", "content_sanskrit": "शिपिविष्टेति चाख्यायां हीनरोमा च यो भवेत्।\nतेनाविष्ट तु यत्किंचिच्छिपिविष्टेति च स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2087067, "chapter_id": 2847, "verse_number": "१२-३५२-७", "content_sanskrit": "यास्को मामृपिरव्यग्रो नैकयज्ञेषु गीतवान्।\nशिपिविष्ट इति ह्यस्माद्गुह्यनामधरो ह्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2087068, "chapter_id": 2847, "verse_number": "१२-३५२-८", "content_sanskrit": "स्तुत्वा मां शिपिविष्टेति यास्क ऋषिरुदारधीः।\nमत्प्रसादादधो नष्टं निरुक्तमभिजग्मिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2087069, "chapter_id": 2847, "verse_number": "१२-३५२-९", "content_sanskrit": "न हि जातो न जायेयं न जनिष्ये कदाचन।\nक्षेत्रज्ञः सर्वभूतानां तस्मादहमजं स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2087070, "chapter_id": 2847, "verse_number": "१२-३५२-१०", "content_sanskrit": "नोक्तपूर्वं मया क्षुद्रमश्लीलं वा कदाचन।\nऋता ब्रह्मसुता सा मे सत्यदेवी सरस्वती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2087071, "chapter_id": 2847, "verse_number": "१२-३५२-११", "content_sanskrit": "सच्चासच्चैव कौन्तेय मया वेशितमात्मनि।\nपौष्करे ब्रह्मसदने सत्यं मासृषयो विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2087072, "chapter_id": 2847, "verse_number": "१२-३५२-१२", "content_sanskrit": "सत्वान्न च्युतपूर्वोऽहं सत्यं वै विद्धि मत्कुतम्।\nजन्मनीहाभवेत्सत्वं पौर्विकं मे धनंजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2087073, "chapter_id": 2847, "verse_number": "१२-३५२-१३", "content_sanskrit": "निराशीः कर्मसंयुक्तः सत्वतश्चाप्यकल्मषः।\nसात्वतज्ञानगदृष्टोऽहं सत्वतामिति सात्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2087074, "chapter_id": 2847, "verse_number": "१२-३५२-१४", "content_sanskrit": "कृषाणि मेदिनीं पार्थ भूत्वा कार्ष्णायसो महान्।\nकृष्णो वर्णश्च मे यस्मात्तस्मात्कृषणोऽहमर्जुन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2087075, "chapter_id": 2847, "verse_number": "१२-३५२-१५", "content_sanskrit": "मया संश्लेषिता भूमिरद्भिर्व्योम च वायुना।\nवायुश्च तेजसा सार्धं वैकुण्ठत्वं ततो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2087076, "chapter_id": 2847, "verse_number": "१२-३५२-१६", "content_sanskrit": "निर्वाणं परमं ब्रह्म धर्मोऽसौ पर उच्यते।\nतस्मान्न च्युतपूर्वोऽहमच्युतस्तेन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2087077, "chapter_id": 2847, "verse_number": "१२-३५२-१७", "content_sanskrit": "पृथिवीनभसी चोभे विश्रुते विश्वतोमुखे।\nतयोः संधारणार्थं हि मामधोक्षजमञ्जसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2087078, "chapter_id": 2847, "verse_number": "१२-३५२-१८", "content_sanskrit": "निरुक्तं वेदविदुपो वेदशब्दार्थचिन्तकाः।\nते मां गायन्ति प्राग्वंशे अधोक्षज इति स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2087079, "chapter_id": 2847, "verse_number": "१२-३५२-१९", "content_sanskrit": "शब्द एकमतैरेप व्याहृतः परमर्षिभिः।\nनान्यो ह्यधोक्षजो लोके ऋते नारायणं प्रभुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2087080, "chapter_id": 2847, "verse_number": "१२-३५२-२०", "content_sanskrit": "धृतं ममार्चिषो लोके जन्तूनां प्राणधारणम्।\nघृतार्चिरहमव्यग्रैर्वेदज्ञैः परिकीर्तितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2087081, "chapter_id": 2847, "verse_number": "१२-३५२-२१", "content_sanskrit": "त्रयो हि धातवः ख्याताः कर्मजा इति ये स्मृताः।\nपित्तं श्लेष्मा च वायुश्च एष संघात उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2087082, "chapter_id": 2847, "verse_number": "१२-३५२-२२", "content_sanskrit": "एतैश्च धार्यते जन्तुरेतैः क्षीणैश्च क्षीयते।\nआयुर्वेदविदस्तस्मात्रिधातुं मां प्रचक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2087083, "chapter_id": 2847, "verse_number": "१२-३५२-२३", "content_sanskrit": "वृषो हि भगवान्धर्मः ख्यातो लोकेषु भारत।\nनेघण्टुकपदाख्याने विद्धि मां वृषमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2087084, "chapter_id": 2847, "verse_number": "१२-३५२-२४", "content_sanskrit": "कपिर्वराहः श्रेष्ठश्च धर्मश्च वृष उच्यते।\nत्समाद्वृषाकपिं प्राह कश्यपो मां प्रजापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2087085, "chapter_id": 2847, "verse_number": "१२-३५२-२५", "content_sanskrit": "न चादिं न मध्यं तथा चैव नान्तं\nकदाचिद्विमन्ते द्विजा मे सुराश्च।\nअनाद्यो ह्यमध्यस्तथा चाप्यनन्तः।\nप्रगीतोऽहमीशो विभूर्लोकसाक्षी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2087086, "chapter_id": 2847, "verse_number": "१२-३५२-२६", "content_sanskrit": "शुचीनि श्रवणीयानि शृणोमीह धनंजय।\nन च पापानि गृह्णामि ततोऽहं वै शुचिश्रवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2087087, "chapter_id": 2847, "verse_number": "१२-३५२-२७", "content_sanskrit": "एकशृङ्गः पुरा भूत्वा वराहो नन्दिवर्धनः।\nइमां चोद्धृतवान्भूमिमेकशृङ्गस्ततो ह्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2087088, "chapter_id": 2847, "verse_number": "१२-३५२-२८", "content_sanskrit": "तथैवासं त्रिककुदो वाराहं रूपमास्थितः।\nत्रिककुत्तेन विख्यातः शरीरस्य तु मापनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2087089, "chapter_id": 2847, "verse_number": "१२-३५२-२९", "content_sanskrit": "निरिञ्च इति यत्प्रोक्तं कापिल ज्ञानचिन्तकैः।\nस प्रजापतिरेवाहं चेतनात्सर्वलोककृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2087090, "chapter_id": 2847, "verse_number": "१२-३५२-३०", "content_sanskrit": "विद्यासहायवन्तं मामादित्यस्थं सनातनम्।\nकपिलं प्राहुराचार्याः साङ्ख्या निश्चितनिश्चयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2087091, "chapter_id": 2847, "verse_number": "१२-३५२-३१", "content_sanskrit": "हिरण्यगर्भो द्युतिमान्य एष च्छन्दसि स्तुतः।\nयोगैः संपूज्यते नित्यं स एवाहं विभुः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2087092, "chapter_id": 2847, "verse_number": "१२-३५२-३२", "content_sanskrit": "एकविंशतिसाहस्रं ऋग्वेदं मां प्रचक्षते।\nसहस्रशाखं यत्साम ये वै वेदविदो जनाः।\nगायन्त्यारण्यके विप्रा मद्भक्तास्ते हि दुर्लभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2087093, "chapter_id": 2847, "verse_number": "१२-३५२-३३", "content_sanskrit": "षट्पञ्चाशतमष्टौ च सप्तत्रिंशतमित्यत।\nयस्मिञ्शाखा यजुर्वेदे सोहमाध्वर्यवे स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2087094, "chapter_id": 2847, "verse_number": "१२-३५२-३४", "content_sanskrit": "पञ्चकल्पमथर्वाणं कृत्याभिः परिबृंहितम्।\nकल्पयन्ति हि मां विप्रा अथर्वाणविदस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2087095, "chapter_id": 2847, "verse_number": "१२-३५२-३५", "content_sanskrit": "शाखाभेदाश्च ये केचिद्याश्च शाखासु गीतयः।\nस्वरवर्णसमुच्चाराः सर्वांस्तान्विद्धि मत्कृतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2087096, "chapter_id": 2847, "verse_number": "१२-३५२-३६", "content_sanskrit": "यत्तद्धयशिरः पार्थ समुदेति वरप्रदम्।\nसोहमेवोत्तरे भागे क्रमाक्षरविभागवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2087097, "chapter_id": 2847, "verse_number": "१२-३५२-३७", "content_sanskrit": "रामादेशितमार्गेण मत्प्रसादान्महात्मना।\nपाञ्चालेन क्रमः प्राप्तस्तस्माद्भूतात्सनातनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2087098, "chapter_id": 2847, "verse_number": "१२-३५२-३८", "content_sanskrit": "बाभ्रव्यगोत्रः स बभौ प्रथमं क्रमपारगः।\nनारायणाद्वरं लब्ध्वा प्राप्य योगमनुत्तमम्।\nक्रमं प्रणीय शिक्षां च प्रणयित्वा स गालवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2087099, "chapter_id": 2847, "verse_number": "१२-३५२-३९", "content_sanskrit": "पुण्डरीकोऽथ राजा च ब्रह्मदत्तः प्रतापवान्।\nजातीमरणजं दुःखं स्मृत्वास्मृत्वा पुनः पुनः।\nसप्तजातिषु मुख्यत्वाद्योगाना संपदं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2087100, "chapter_id": 2847, "verse_number": "१२-३५२-४०", "content_sanskrit": "पुराऽहमात्मजः पार्थ प्रथितः कारणान्तरे।\nधर्मस्य कुरुशार्दूल ततोऽहं धर्मजः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2087101, "chapter_id": 2847, "verse_number": "१२-३५२-४१", "content_sanskrit": "नरनारायणौ पूर्वं तपस्तेपतुरव्ययम्।\nधर्मयानं समारूढौ पर्वते गन्धमादने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2087102, "chapter_id": 2847, "verse_number": "१२-३५२-४२", "content_sanskrit": "तत्कालसमये चैव दक्षयज्ञो बभूव ह।\nन चैवाकल्पयद्भागं दक्षो रुद्रस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2087103, "chapter_id": 2847, "verse_number": "१२-३५२-४३", "content_sanskrit": "ततो दधीचिवचनाद्दक्षयज्ञमपाहरत्।\nससर्ज शूलं कोपेन प्रज्वलन्तं मुहुर्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2087104, "chapter_id": 2847, "verse_number": "१२-३५२-४४", "content_sanskrit": "तच्छूलं भस्मसात्कृत्वा दक्षयज्ञं सविस्तरम्।\nआवयोः सहसाऽगच्छद्वदर्याश्रममन्तिकात्।\nवेगेन महता पार्थ पतन्नारायणोरसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2087105, "chapter_id": 2847, "verse_number": "१२-३५२-४५", "content_sanskrit": "तत्तस्यतेजसाऽऽविष्टाः केशा नारायणस्य ह।\nबभूवुर्मुञ्जवर्णास्तु ततोऽहं मुञ्जकेशवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2087106, "chapter_id": 2847, "verse_number": "१२-३५२-४६", "content_sanskrit": "तच्च शूलं विनिर्धूतं हुंकारेण महात्मना।\nजगाम शंकरकरं नारायणसमाहतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2087107, "chapter_id": 2847, "verse_number": "१२-३५२-४७", "content_sanskrit": "अथ रुद्र उपाधावत्तावृषी तपसाऽन्वितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2087108, "chapter_id": 2847, "verse_number": "१२-३५२-४८", "content_sanskrit": "तत एनं समुद्धूतं कण्ठे जग्राह पाणिना।\nनारायणः स विश्वात्मा तेनास्य शितिकण्ठता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2087109, "chapter_id": 2847, "verse_number": "१२-३५२-४९", "content_sanskrit": "अथ रुद्रविघातार्थमिषीकां नर उद्धरन्।\nमन्त्रैश्च संयुयोजाशु सोऽभवत्परशुर्महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2087110, "chapter_id": 2847, "verse_number": "१२-३५२-५०", "content_sanskrit": "क्षिप्तश्च सहसा तेन खण्डनं प्राप्तवांस्तदा।\nततोऽहं खण्डपरशुः स्मृतः परशुखण्डनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2087111, "chapter_id": 2847, "verse_number": "१२-३५२-५१", "content_sanskrit": "`रुद्रस्य भागं प्रददुर्भागमुच्छेषणं पुनः।\nश्रुतिरप्यत्र भवति वेदैरुक्तस्तथा पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2087112, "chapter_id": 2847, "verse_number": "१२-३५२-५२", "content_sanskrit": "उच्छेपणभागो वै रुद्रस्तस्योच्छेपणेन होतव्यमिति सर्वे गम्यरूपेण तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2087113, "chapter_id": 2847, "verse_number": "१२-३५२-५३x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2087114, "chapter_id": 2847, "verse_number": "१२-३५२-५३", "content_sanskrit": "अस्मिन्युद्धे तु वार्ष्णेय त्रैलोक्यशमने तदा।\nको जय प्राप्तवांस्तत्र शंसैतन्मे जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2087115, "chapter_id": 2847, "verse_number": "१२-३५२-५४x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2087116, "chapter_id": 2847, "verse_number": "१२-३५२-५४", "content_sanskrit": "तयोः संरब्धयोर्युद्धे रुद्रनारायणात्मनोः।\nउद्विग्राः सहसा कृत्स्नाः सर्वे लोकास्तदाऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2087117, "chapter_id": 2847, "verse_number": "१२-३५२-५५", "content_sanskrit": "नागृह्णात्पाव्नकः शुभ्रं मूखेषु सुहुतं हविः।\nवेदा न प्रतिभान्ति स्म ऋषीणां भावितात्मनां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2087118, "chapter_id": 2847, "verse_number": "१२-३५२-५६", "content_sanskrit": "देवान्रजस्तमश्चैव समाविविशतुस्तदा।\nवसुधा संचकम्पे च नभश्च विपफाल ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2087119, "chapter_id": 2847, "verse_number": "१२-३५२-५७", "content_sanskrit": "निष्प्रभाणि च तेजांसि ब्रह्मा चैवासनच्युतः।\nअगाच्छोपं समुद्रश्च हिमवांश्च व्यशीर्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2087120, "chapter_id": 2847, "verse_number": "१२-३५२-५८", "content_sanskrit": "तस्मिन्नेवं समुत्पन्ने निमित्ते पाण्डुनन्दन।\nब्रह्मा वृतो देवगणार्ऋषिभिश्च महात्मभिः।\nआजगामाशु तं देशं यत्र युद्धमवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2087121, "chapter_id": 2847, "verse_number": "१२-३५२-५९", "content_sanskrit": "सोऽञ्जलिप्रग्रहो भूत्वा चतुर्वक्रो निरुक्तगः।\nउवाच वचनं रुद्रं लोकानामस्तु वै शिवम्।\nत्यजायुधानि विश्वेश जगतो हितकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2087122, "chapter_id": 2847, "verse_number": "१२-३५२-६०", "content_sanskrit": "यदक्षरमथाव्यक्तमीशं लोकस्य भावनम्।\nकूटस्थं कर्तृनिर्द्वन्द्वमकर्तेति च यं विदुः।\nव्यक्तिभावगतस्यास्य एका मूर्तिरियं शुभा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2087123, "chapter_id": 2847, "verse_number": "१२-३५२-६१", "content_sanskrit": "नरो नारायणश्चैव जातौ धर्मकुलोद्वहौ।\nतपसा महता युक्तौ देवश्रेष्ठौ महाव्रतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2087124, "chapter_id": 2847, "verse_number": "१२-३५२-६२", "content_sanskrit": "अहं प्रसादजस्तस्य कुतश्चित्कारणान्तरे।\nत्वं चैव क्रोधजस्तात पूर्वसर्गे सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2087125, "chapter_id": 2847, "verse_number": "१२-३५२-६३", "content_sanskrit": "मया च सार्धं वरद विबुधैश्च महर्षिभिः।\nप्रसादयाशु लोकानां शान्तिर्भवतु माचिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2087126, "chapter_id": 2847, "verse_number": "१२-३५२-६४", "content_sanskrit": "ब्रह्मणा त्वेवमुक्तस्तु रुद्रः क्रोधाग्निमुत्सृजन्।\nप्रसादयामास ततो देवं नारायणं प्रभुम्।\nशरणं च जगामाद्यं वरेण्यं वरदं हरिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2087127, "chapter_id": 2847, "verse_number": "१२-३५२-६५", "content_sanskrit": "ततोऽथ वरदो देवो जितक्रोधो जितेन्द्रियः।\nप्रीतिमानभवत्तत्र रुद्रेण सह संगतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2087128, "chapter_id": 2847, "verse_number": "१२-३५२-६६", "content_sanskrit": "ऋषिभिर्ब्रह्मणा चैव विबुधैश्च सुपूजितः।\nउवाच देवमीशानमीशः स जगतो हरिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2087129, "chapter_id": 2847, "verse_number": "१२-३५२-६७", "content_sanskrit": "यस्त्वां वेत्ति स मां वेत्ति यस्त्वामनु स मामनु।\nनावयोरन्तरं किंचिन्मा तेऽभूद्वुद्धिरन्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2087130, "chapter_id": 2847, "verse_number": "१२-३५२-६८", "content_sanskrit": "अद्यप्रभृति श्रीवत्सः शूलाङ्को मे भवत्वयम्।\nमम पाण्यङ्कितश्चापि श्रीकण्ठस्त्वं भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2087131, "chapter_id": 2847, "verse_number": "१२-३५२-६९x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2087132, "chapter_id": 2847, "verse_number": "१२-३५२-६९", "content_sanskrit": "एवंलक्षणमुत्पाद्य परस्परकृतं तदा।\nसख्यं चैवातुलं कृत्वा रुद्रेण सहितावृषी।\nतपस्तेपतुरव्यग्रौ विसृज्य त्रिदिवौकसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2087133, "chapter_id": 2847, "verse_number": "१२-३५२-७०", "content_sanskrit": "एष ते कथितः पार्थ नारायणजयो मृधे।\nनामानि चैव गुह्यानि निरुक्तानि च भारत।\nऋषिभिः कथितानीह यानि संकीर्तितानि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2087134, "chapter_id": 2847, "verse_number": "१२-३५२-७१", "content_sanskrit": "एवं बहुविधै रूपैश्चरामीह वसुंधराम्।\nब्रह्मलोकं च कौन्येय गोलोकं च सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2087135, "chapter_id": 2847, "verse_number": "१२-३५२-७२", "content_sanskrit": "मया त्वं रक्षितो युद्धे महान्तं प्राप्तवाञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2087136, "chapter_id": 2847, "verse_number": "१२-३५२-७३", "content_sanskrit": "यस्तु ते सोग्रतो याति युद्धे संप्रत्युपस्थिते।\nतं विद्धि रुद्रं कौन्तेय देवदेवं कपर्दिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2087137, "chapter_id": 2847, "verse_number": "१२-३५२-७४", "content_sanskrit": "कालः स एव विहितः क्रोधजेति मया तव।\nनिहतांस्तेन वै पूर्वं हतवानसि यान्रिपून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2087138, "chapter_id": 2847, "verse_number": "१२-३५२-७५", "content_sanskrit": "अप्रमेयप्रभावं तं देवदेवमुमापतिम्।\nनमस्व देवं प्रयतो विश्वेशं हरमक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2087139, "chapter_id": 2847, "verse_number": "१२-३५२-७६", "content_sanskrit": "यश्च ते कथितः पूर्वं क्रोधजेति पुनः पुनः।\nतस्य प्रभाव एवाग्रे यच्छ्रुतं ते धनंजय॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2087140, "chapter_id": 2847, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि नारायणीये द्विपञ्चाशदधिकत्रिशततमोऽध्यायः॥ ३५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}]