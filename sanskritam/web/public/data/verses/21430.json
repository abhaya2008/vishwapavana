[{"id": 7001430000, "chapter_id": 21430, "verse_number": "७-१-३-१", "content_sanskrit": "ब्रहमोवाच ।\nयतो वाचो निवर्तंते अप्राप्य मनसा सह ।\nआनंदं यस्य वै विद्वान्न बिभेति कुतश्चन॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001430001, "chapter_id": 21430, "verse_number": "७-१-३-२", "content_sanskrit": "यस्मात्सर्वमिदं ब्रह्मविष्णुरुद्रेन्द्रपूर्वकम् ।\nसह भूतेन्द्रियैः सर्वैः प्रथमं संप्रसूयते॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001430002, "chapter_id": 21430, "verse_number": "७-१-३-३", "content_sanskrit": "कारणानां च यो धाता ध्याता परमकारणम् ।\nन संप्रसूयते ऽन्यस्मात्कुतश्चन कदाचन॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001430003, "chapter_id": 21430, "verse_number": "७-१-३-४", "content_sanskrit": "सर्वैश्वर्येण संपन्नो नाम्ना सर्वेश्वरः स्वयम् ।\nसर्वैर्मुमुक्षुभिर्ध्येयश्शंभुराकाशमध्यगः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001430004, "chapter_id": 21430, "verse_number": "७-१-३-५", "content_sanskrit": "यो ऽग्रे मां विदधे पुत्रं ज्ञानं च प्रहिणोति मे ।\nतत्प्रसादान्मयालब्धं प्राजापत्यमिदं पदम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001430005, "chapter_id": 21430, "verse_number": "७-१-३-६", "content_sanskrit": "ईशो वृक्ष इव स्तब्धो य एको दिवि तिष्ठति ।\nयेनेदमखिलं पूर्णं पुरुषेण महात्मना॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001430006, "chapter_id": 21430, "verse_number": "७-१-३-७", "content_sanskrit": "एको बहूनां जंतूनां निष्क्रियाणां च सक्रियः ।\nय एको बहुधा बीजं करोति स महेश्वरः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001430007, "chapter_id": 21430, "verse_number": "७-१-३-८", "content_sanskrit": "जीवैरेभिरिमांल्लोकान्सर्वानीशो य ईशते ।\nय एको भागवान्रुद्रो न द्वितीयो ऽस्ति कश्चन॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001430008, "chapter_id": 21430, "verse_number": "७-१-३-९", "content_sanskrit": "सदा जनानां हृदये संनिविष्टो ऽपि यः परैः ।\nअलक्ष्यो लक्षयन्विश्वमधितिष्ठति सर्वदा॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001430009, "chapter_id": 21430, "verse_number": "७-१-३-१०", "content_sanskrit": "यस्तु कालात्प्रमुक्तानि कारणान्यखिलान्यपि ।\nअनन्तशक्तिरेवैको भगवानधितिष्ठति॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001430010, "chapter_id": 21430, "verse_number": "७-१-३-११", "content_sanskrit": "न यस्य दिवसो रात्रिर्न समानो न चाधिकः ।\nस्वभाविकी पराशक्तिर्नित्या ज्ञानक्रिये अपि॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001430011, "chapter_id": 21430, "verse_number": "७-१-३-१२", "content_sanskrit": "यदिदं क्षरमव्यक्तं यदप्यमृतमक्षरम् ।\nतावुभावक्षरात्मानावेको देवः स्वयं हरः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001430012, "chapter_id": 21430, "verse_number": "७-१-३-१३", "content_sanskrit": "ईशते तदभिध्यानाद्योजनासत्त्वभावनः ।\nभूयो ह्यस्य पशोरन्ते विश्वमाया निवर्तते॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001430013, "chapter_id": 21430, "verse_number": "७-१-३-१४", "content_sanskrit": "यस्मिन्न भासते विद्युन्न सूर्यो न च चन्द्रमाः ।\nयस्य भासा विभातीदमित्येषा शाश्वती श्रुतिः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001430014, "chapter_id": 21430, "verse_number": "७-१-३-१५", "content_sanskrit": "एको देवो महादेवो विज्ञेयस्तु महेश्वरः ।\nन तस्य परमं किंचित्पदं समधिगम्यते॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001430015, "chapter_id": 21430, "verse_number": "७-१-३-१६", "content_sanskrit": "अयमादिरनाद्यन्तस्स्वभावादेव निर्मलः ।\nस्वतन्त्रः परिपूर्णश्च स्वेच्छाधीनश्चराचरः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001430016, "chapter_id": 21430, "verse_number": "७-१-३-१७", "content_sanskrit": "अप्राकृतवपुः श्रीमांल्लक्ष्यलक्षणवर्जितः ।\nअयं मुक्तो मोचकश्च ह्यकालः कालचोदकः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001430017, "chapter_id": 21430, "verse_number": "७-१-३-१८", "content_sanskrit": "सर्वोपरिकृतावासस्सर्वावासश्च सर्ववित् ।\nषड्विधाध्वमयस्यास्य सर्वस्य जगतः पतिः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001430018, "chapter_id": 21430, "verse_number": "७-१-३-१९", "content_sanskrit": "उत्तरोत्तरभूतानामुत्तरश्च निरुत्तरः ।\nअनन्तानन्तसन्दोहमकरंदमधुव्रतः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001430019, "chapter_id": 21430, "verse_number": "७-१-३-२०", "content_sanskrit": "अखंडजगदंडानां पिंडीकरणपंडितः ।\nऔदार्यवीर्यगांभीर्यमाधुर्यमकरालयः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001430020, "chapter_id": 21430, "verse_number": "७-१-३-२१", "content_sanskrit": "नैवास्य सदृशं वस्तु नाधिकं चापि किंचन ।\nअतुलः सर्वभूतानां राजराजश्च तिष्ठति॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001430021, "chapter_id": 21430, "verse_number": "७-१-३-२२", "content_sanskrit": "अनेन चित्रकृत्येन प्रथमं सृज्यते जगत् ।\nअंतकाले पुनश्चेदं तस्मिन्प्रलयमेष्यते॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001430022, "chapter_id": 21430, "verse_number": "७-१-३-२३", "content_sanskrit": "अस्य भूतानि वश्यानि अयं सर्वनियोजकः ।\nअयं तु परया भक्त्या दृश्यते नान्यथा क्वचित्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001430023, "chapter_id": 21430, "verse_number": "७-१-३-२४", "content_sanskrit": "व्रतानि सर्वदानानि तपांसि नियमास्तथा ।\nकथितानि पुरा सद्भिर्भावार्थं नात्र संशयः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001430024, "chapter_id": 21430, "verse_number": "७-१-३-२५", "content_sanskrit": "हरिश्चाहं च रुद्रश्च तथान्ये च सुरासुराः ।\nतपोभिरुग्रैरद्यापि तस्य दर्शनकांक्षिणः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001430025, "chapter_id": 21430, "verse_number": "७-१-३-२६", "content_sanskrit": "अदृश्यः पतितैर्मूढैर्दुर्जनैरपि कुत्सितैः ।\nभक्तैरन्तर्बहिश्चापि पूज्यः संभाष्य एव च॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001430026, "chapter_id": 21430, "verse_number": "७-१-३-२७", "content_sanskrit": "तदिदं त्रिविधं रूपं स्थूलं सूक्ष्मं ततः परम् ।\nअस्मदाद्यमरैर्दृश्यं स्थूलं सूक्ष्मं तु योगिभिः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001430027, "chapter_id": 21430, "verse_number": "७-१-३-२८", "content_sanskrit": "ततः परं तु यन्नित्यं ज्ञानमानंदमव्ययम् ।\nतन्निष्ठैस्तत्परैर्भक्तैर्दृश्यं तद्व्रतमाश्रितैः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001430028, "chapter_id": 21430, "verse_number": "७-१-३-२९", "content_sanskrit": "बहुनात्र किमुक्तेन गुह्याद्गुह्यतरं परम् ।\nशिवे भक्तिर्न सन्देहस्तया युक्तो विमुच्यते॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001430029, "chapter_id": 21430, "verse_number": "७-१-३-३०", "content_sanskrit": "प्रसादादेव सा भक्तिः प्रसादो भक्तिसंभवः ।\nयथा चांकुरतो बीजं बीजतो वा यथांकुरः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001430030, "chapter_id": 21430, "verse_number": "७-१-३-३१", "content_sanskrit": "प्रसादपूर्विका एव पशोस्सर्वत्र सिद्धयः ।\nस एव साधनैरन्ते सर्वैरपि च साध्यते॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001430031, "chapter_id": 21430, "verse_number": "७-१-३-३२", "content_sanskrit": "प्रसादसाधनं धर्मस्स च वेदेन दर्शितः ।\nतदभ्यासवशात्साम्यं पूर्वयोः पुण्यपापयोः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001430032, "chapter_id": 21430, "verse_number": "७-१-३-३३", "content_sanskrit": "साम्यात्प्रसादसंपर्को धर्मस्यातिशयस्ततः ।\nधर्मातिशयमासाद्य पशोः पापपरिक्षयः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001430033, "chapter_id": 21430, "verse_number": "७-१-३-३४", "content_sanskrit": "एवं प्रक्षीणपापस्य बहुभिर्जन्मभिः क्रमात् ।\nसांबे सर्वेश्वरे भक्तिर्ज्ञानपूर्वा प्रजायते॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001430034, "chapter_id": 21430, "verse_number": "७-१-३-३५", "content_sanskrit": "भावानुगुणमीशस्य प्रसादो व्यतिरिच्यते ।\nप्रसादात्कर्मसंत्यागः फलतो न स्वरूपतः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001430035, "chapter_id": 21430, "verse_number": "७-१-३-३६", "content_sanskrit": "तस्मात्कर्मफलत्यागाच्छिवधर्मान्वयः शुभः ।\nस च गुर्वनपेक्षश्च तदपेक्ष इति द्विधा॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001430036, "chapter_id": 21430, "verse_number": "७-१-३-३७", "content_sanskrit": "तत्रानपेक्षात्सापेक्षो मुख्यः शतगुणाधिकः ।\nशिवधर्मान्वयस्यास्य शिवज्ञानसमन्वयः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001430037, "chapter_id": 21430, "verse_number": "७-१-३-३८", "content_sanskrit": "ज्ञनान्वयवशात्पुंसः संसारे दोषदर्शनम् ।\nततो विषयवैराग्यं वैराग्याद्भावसाधनम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001430038, "chapter_id": 21430, "verse_number": "७-१-३-३९", "content_sanskrit": "भावसिद्ध्युपपन्नस्य ध्याने निष्ठा न कर्मणि ।\nज्ञानध्यानाभियुक्तस्य पुंसो योगः प्रवर्तते॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001430039, "chapter_id": 21430, "verse_number": "७-१-३-४०", "content_sanskrit": "योगेन तु परा भक्तिः प्रसादस्तदनंतरम् ।\nप्रसादान्मुच्यते जंतुर्मुक्तः शिवसमो भवेत्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001430040, "chapter_id": 21430, "verse_number": "७-१-३-४१", "content_sanskrit": "अनुग्रहप्रकारस्य क्रमो ऽयमविवक्षितः ।\nयादृशी योग्यता पुंसस्तस्य तादृगनुग्रहः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001430041, "chapter_id": 21430, "verse_number": "७-१-३-४२", "content_sanskrit": "गर्भस्थो मुच्यते कश्चिज्जायमानस्तथापरः ।\nबालो वा तरुणो वाथ वृद्धो वा मुच्यते परः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001430042, "chapter_id": 21430, "verse_number": "७-१-३-४३", "content_sanskrit": "तिर्यग्योनिगतः कश्चिन्मुच्यते नारको ऽपरः ।\nअपरस्तु पदं प्राप्तो मुच्यते स्वपदक्षये॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001430043, "chapter_id": 21430, "verse_number": "७-१-३-४४", "content_sanskrit": "कश्चित्क्षीणपदो भूत्वा पुनरावर्त्य मुच्यते ।\nकश्चिदध्वगतस्तस्मिन् स्थित्वास्थित्वा विमुच्यते॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001430044, "chapter_id": 21430, "verse_number": "७-१-३-४५", "content_sanskrit": "तस्मान्नैकप्रकारेण नराणां मुक्तिरिष्यते ।\nज्ञानभावानुरूपेण प्रसादेनैव निर्वृतिः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001430045, "chapter_id": 21430, "verse_number": "७-१-३-४६", "content_sanskrit": "तस्मादस्य प्रसादार्थं वाङ्मनोदोषवर्जिताः ।\nध्यायंतश्शिवमेवैकं सदारतनयाग्नयः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001430046, "chapter_id": 21430, "verse_number": "७-१-३-४७", "content_sanskrit": "तन्निष्ठास्तत्परास्सर्वे तद्युक्तास्तदुपाश्रयाः ।\nसर्वक्रियाः प्रकुर्वाणास्तमेव मनसागताः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001430047, "chapter_id": 21430, "verse_number": "७-१-३-४८", "content_sanskrit": "दीर्घसूत्रसमारब्धं दिव्यवर्षसहस्रकम् ।\nसत्रांते मंत्रयोगेन वायुस्तत्र गमिष्यति॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001430048, "chapter_id": 21430, "verse_number": "७-१-३-४९", "content_sanskrit": "स एव भवतः श्रेयः सोपायं कथयिष्यति ।\nततो वाराणसी पुण्या पुरी परमशोभना॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001430049, "chapter_id": 21430, "verse_number": "७-१-३-५०", "content_sanskrit": "गंतव्या यत्र विश्वेशो देव्या सह पिनाकधृक् ।\nसदा विहरति श्रीमान् भक्तानुग्रहकारणात्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001430050, "chapter_id": 21430, "verse_number": "७-१-३-५१", "content_sanskrit": "तत्राश्चर्यं महद्दृष्ट्वा मत्समीपं गमिष्यथ ।\nततो वः कथयिष्यामि मोक्षोपाय द्विजोत्तमाः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001430051, "chapter_id": 21430, "verse_number": "७-१-३-५२", "content_sanskrit": "येनैकजन्मना मुक्तिर्युष्मत्करतले स्थिता ।\nअनेकजन्मसंसारबंधनिर्मोक्षकारिणी॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001430052, "chapter_id": 21430, "verse_number": "७-१-३-५३", "content_sanskrit": "एतन्मनोमयं चक्रं मया सृष्टं विसृज्यते ।\nयत्रास्य शीर्यते नेमिः स देशस्तपसश्शुभः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001430053, "chapter_id": 21430, "verse_number": "७-१-३-५४", "content_sanskrit": "इत्युक्त्वा सूर्यसंकाशं चक्रं दृष्ट्वा मनोमयम् ।\nप्रणिपत्य महादेवं विससर्ज पितामहः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001430054, "chapter_id": 21430, "verse_number": "७-१-३-५५", "content_sanskrit": "ते ऽपि हृष्टतरा विप्राः प्रणम्य जगतां प्रभुम् ।\nप्रययुस्तस्य चक्रस्य यत्र नेमिरशीर्यत॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001430055, "chapter_id": 21430, "verse_number": "७-१-३-५६", "content_sanskrit": "चक्रं तदपि संक्षिप्तं श्लक्ष्णं चारुशिलातले ।\nविमलस्वादुपानीये निजपात वने क्वचित्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001430056, "chapter_id": 21430, "verse_number": "७-१-३-५७", "content_sanskrit": "तद्वनं तेन विख्यातं नैमिषं मुनिपूजितम् ।\nअनेकयक्षगंधर्वविद्याधरसमाकुलम्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001430057, "chapter_id": 21430, "verse_number": "७-१-३-५८", "content_sanskrit": "अष्टादश समुद्रस्य द्वीपानश्नन्पुरूरवाः ।\nविलासवशमुर्वश्या यातो दैवेन चोदितः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001430058, "chapter_id": 21430, "verse_number": "७-१-३-५९", "content_sanskrit": "अक्रमेण हरन्मोहाद्यज्ञवाटं हिरण्मयम् ।\nमुनिभिर्यत्र संक्रुद्धैः कुशवज्रैर्निपातितः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001430059, "chapter_id": 21430, "verse_number": "७-१-३-६०", "content_sanskrit": "विश्वं सिसृक्षमाणा वै यत्र विश्वसृजः पुरा ।\nसत्रमारेभिरे दिव्यं ब्रह्मज्ञा गार्हपत्यगाः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001430060, "chapter_id": 21430, "verse_number": "७-१-३-६१", "content_sanskrit": "ऋषिभिर्यत्र विद्वद्भिः शब्दार्थन्यायकोविदैः ।\nशक्तिप्रज्ञाक्रियायोगैर्विधिरासीदनुष्ठितः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001430061, "chapter_id": 21430, "verse_number": "७-१-३-६२", "content_sanskrit": "यत्र वेदविदो नित्यं वेदवादबहिष्कृतान् ।\nवादजल्पबलैर्घ्नंति वचोभिरतिवादिनः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001430062, "chapter_id": 21430, "verse_number": "७-१-३-६३", "content_sanskrit": "स्फटिकमयमहीभृत्पादजाभ्यश्शिलाभ्यः प्रसरदमृतकल्पस्स्वच्छपानीयरम्यम् ।\nअतिरसफलवृक्षप्रायमव्यालसत्त्वं तपस उचितमासीन्नैमिषं तन्मुनीनाम्॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]