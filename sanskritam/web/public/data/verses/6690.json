    "display_order": 94,
    "avatarnika": ""
  },
  {
    "id": 20012342,
    "chapter_id": 6690,
    "verse_number": "18.95",
    "content_sanskrit": "परिक्लृप्यमानविविधप्रसाधनं क्रियमाणसाधुगृहदेवतार्चनम् । परिपच्यमानहविरन्नसङ्कुलं परितर्प्यमाणवसुधासुधाशनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 95,
    "avatarnika": ""
  },
  {
    "id": 20012343,
    "chapter_id": 6690,
    "verse_number": "18.96",
    "content_sanskrit": "उपनीयमानशिववस्तुसञ्चयं परिकीर्त्यमानबहुपुण्यकृज्जनम् । परिमृज्यमानपृथुरत्नदर्पणं परिभूष्यमाणतरुणीपरम्परम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
