[
  {
    "id": 20012248,
    "chapter_id": 6690,
    "verse_number": "18.1",
    "content_sanskrit": "गतवतीन्द्रसुते तु तपस्सुतः श्रुतपराशरसूनुसुभाषितः । शुचमपास्य ददद्धृदये धृतिं वसुमतीमवति स्म सहाऽनुजैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20012249,
    "chapter_id": 6690,
    "verse_number": "18.2",
    "content_sanskrit": "जयवियोगजदुःखमहाभरं सह कथञ्चिदमी दधतो नयन् । कृतगुणातिशयोत्तरतत्कथाकलकलध्वनयोदिवसाश्च तम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20012250,
    "chapter_id": 6690,
    "verse_number": "18.3",
    "content_sanskrit": "हलिहरी परिभूय भुजौजसा तदनुजामपहृत्य च फल्गुनः । अयमुपैति तया सहितः पुरीमितिकथाऽथ कदाचिदगात्पुरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20012251,
    "chapter_id": 6690,
    "verse_number": "18.4",
    "content_sanskrit": "श्रुतियुगं सुहृदामधिनोत्तदा जयकथाजलजन्मरवो द्वयम् । नयनयुग्ममपि द्वयमुच्छ्रितं पवनजं बलधूलिकपिध्वजौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20012252,
    "chapter_id": 6690,
    "verse_number": "18.5",
    "content_sanskrit": "अथ विचिन्त्य समं हरिणार्जुनो द्रुपदजासदनं विनयानताम् । व्रजवधूसहितामनयद्वधूं तदतिशोभनवेषविभूषिताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20012253,
    "chapter_id": 6690,
    "verse_number": "18.6",
    "content_sanskrit": "सहजरूपविशेषविनम्रताहृतचराचरलोचनचेतना । व्रजवधूसहिता विजयप्रिया सवनसेनभुवो भवनं ययौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20012254,
    "chapter_id": 6690,
    "verse_number": "18.7",
    "content_sanskrit": "व्रजवधूभिरमोपगतान्नतां कलितबर्हकचां वनमालिनीम् । प्रकरणेन सुरूपतया च तामतुलयाऽऽक्रलयद् द्रुपदात्मजा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20012255,
    "chapter_id": 6690,
    "verse_number": "18.8",
    "content_sanskrit": "द्रुपदजाऽऽनक्रदुन्दुभिनन्दने ददृशतुः कुतुकादितरेतरम् । प्रकटितश्रुतरूपविशेषया स्फुटशरन्नलिनीसदृशा दृशा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20012256,
    "chapter_id": 6690,
    "verse_number": "18.9",
    "content_sanskrit": "हलिगदाधरयोस्सदृशी वधूर्वदत केयमिति व्रजयोषितः । द्रुपदनन्दनयाऽभिहितास्तदा शिरसि सङ्ग्रथिताञ्जलयोऽब्रुवन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20012257,
    "chapter_id": 6690,
    "verse_number": "18.10",
    "content_sanskrit": "सकलराजसहस्ररुचा हृता सरदसंख्यगुना हरिसूनुना । अवरजा भगिनीयमवेयतां हलधराच्युतयोरिव राजिते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20012258,
    "chapter_id": 6690,
    "verse_number": "18.11",
    "content_sanskrit": "इति निशम्य वचो व्रजयोषितां प्रमुदिता सुतरां द्रुपदात्मजा । घनतरस्तनरुद्धपयोधरामसृसमासुसमां परिषस्वजे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20012259,
    "chapter_id": 6690,
    "verse_number": "18.12",
    "content_sanskrit": "अभिदधौ च चिराय धनञ्जयं सुदति तोषय स्वस्वजनं गुणैः । सकलहंसगणं कुसुमैः स्फुटैर्नवशरन्नलिनीव दिवाकरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20012260,
    "chapter_id": 6690,
    "verse_number": "18.13",
    "content_sanskrit": "अथ पृथाभवनं प्रणिनाय तां प्रमुदितप्रमदाजनसङ्कुलम् । कमलिनी कमलामिव पार्षतीं सशफरीलसितं सरसीजलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20012261,
    "chapter_id": 6690,
    "verse_number": "18.14",
    "content_sanskrit": "अथ निशम्य पृथा वसुदेवजां भुजबलेन हतां विजयेन ताम् । तुलितसीरसुदर्शनहेतिना स्मितमुखेन्दुरशोभत वीरसूः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20012262,
    "chapter_id": 6690,
    "verse_number": "18.15",
    "content_sanskrit": "धवलवाहवधूमुखदर्शने तुलितशारदपूर्णविधूदये । परिचचाल पृथास्मितफेनिला जलनिधेरिव वीचिपरम्परा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20012263,
    "chapter_id": 6690,
    "verse_number": "18.16",
    "content_sanskrit": "अथ पृथाचरणारुणपद्मयोर्द्वयमवन्दत दुश्च्यवनस्नुषा । निखिलवीरनरेन्द्रकुटुम्बिनी नतिपतत्कबरीकुसुमार्चितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20012264,
    "chapter_id": 6690,
    "verse_number": "18.17",
    "content_sanskrit": "सपदि सा समजिघ्रदजानुजां कचभरेऽसितबर्हसितस्रजि । असिचदङ्गधृतामुपगूह्य च क्षरतिचक्षुररोजपयः कणैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20012265,
    "chapter_id": 6690,
    "verse_number": "18.18",
    "content_sanskrit": "पृथुधियाऽपि मुहुः पृथया तदा प्रथितनिष्णतयाऽपि च कृष्णया । स्खलितमाल्यकर्म सुशोभनः प्रियजनागमने खलु संभ्रमः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20012266,
    "chapter_id": 6690,
    "verse_number": "18.19",
    "content_sanskrit": "अविरताप्लवलेपनभूषणवसनविभ्रमणाकुलयौवतः । अदनतुन्दिलबालजरज्जनः प्रववृतेऽथ पृथागृह उत्सवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20012267,
    "chapter_id": 6690,
    "verse_number": "18.20",
    "content_sanskrit": "अथ निशम्य तथागतमर्जुनं समदनौ च हलायुधमाधवौ । नरपतिः प्रचचाल वरासनाद्रुत इव प्रमदार्णववीचिभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20012268,
    "chapter_id": 6690,
    "verse_number": "18.21",
    "content_sanskrit": "स निर्याच्चरया सवृकोदरः सनकुलस्सहदेवयुतः पुरात् । जयबलाच्युतकामविलोकनाकुतुकपूरितपौरजनावृतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20012269,
    "chapter_id": 6690,
    "verse_number": "18.22",
    "content_sanskrit": "उभयपार्श्वधृतामलचामरो धृतसितातपवारणमस्तकः । मणिमयाखिलभूषणभासुरो रथमलङ्कुरुते स्म युधिष्ठिरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20012270,
    "chapter_id": 6690,
    "verse_number": "18.23",
    "content_sanskrit": "सुचिरदृष्टमिवैक्षत तं तदा सततदृष्टमपि क्षितिपं जनः । परिचये नवमेव हि कल्पते मधुरवस्तु न जातु पुरातनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20012271,
    "chapter_id": 6690,
    "verse_number": "18.24",
    "content_sanskrit": "रथपदाति तुरङ्गम तङ्गजव्यतिकरोत्थपराग तनुस्तदा । अजितमीक्षितुमुत्सुकमुन्मनाः पतिमजं तमधावदिव क्षितिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20012272,
    "chapter_id": 6690,
    "verse_number": "18.25",
    "content_sanskrit": "अथ महीपति' रेकरथे स्थितान् बलमुकुन्दमनोजधनञ्जयान् । 'अलभत प्रमदाद्विलोकयन् विपुलदीर्घविलोचनताफलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20012273,
    "chapter_id": 6690,
    "verse_number": "18.26",
    "content_sanskrit": "हलिहरिप्रमुखाश्च पृथासुतं दृष्टशुरस्तनिमेषविलोचनाः । क्षुभितसम्मददुग्धपयोनिधिग्रथितफेननिभोल्लसितस्मिताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20012274,
    "chapter_id": 6690,
    "verse_number": "18.27",
    "content_sanskrit": "हलधरप्रमुखाश्च'युधिष्ठिरप्रभृतयश्च विलोक्य परस्परम् । युगपदेव रथादवनिं ययुर्ध्वनिभदाभरणाभिहता इव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20012275,
    "chapter_id": 6690,
    "verse_number": "18.28",
    "content_sanskrit": "परतरौ पुरुषौ नरतां गतौ सकलमानुषमस्तकनम्ययोः । हलिहरी नृपतेस्सुकृतात्मनश्चरणपङ्कजयोः प्रणिपेततुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20012276,
    "chapter_id": 6690,
    "verse_number": "18.29",
    "content_sanskrit": "स्वभुजयन्त्रनिरुद्धनती क्रमात् सपदि तौ स यदा परिषस्वजे । पुलकवान् मुकुलायितलोचनश्चरणयोः स्म तदा नमतोऽस्य तौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20012277,
    "chapter_id": 6690,
    "verse_number": "18.30",
    "content_sanskrit": "पुलकितावयवः परिषस्वजे बलबलावरजाववनीपतिः । मुकुलिताङ्गचयः कनकाचलो हिमहरिन्मणिभूमिधराविव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20012278,
    "chapter_id": 6690,
    "verse_number": "18.31",
    "content_sanskrit": "हलधराच्युतयोरुपगूहने तदनुभूतिरसेन युधिष्ठिरः । तदभवन्नु तदङ्गसुधातसीकुसुमसोदरदीधितिरञ्जितः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20012279,
    "chapter_id": 6690,
    "verse_number": "18.32",
    "content_sanskrit": "असदृशीन्नतिमाचरतो युवां किमिति दासजनेन जगत्पती । क्षितिमितौ क्षितिभारजिहीर्षया कलितकोमलमानुषविग्रहौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20012280,
    "chapter_id": 6690,
    "verse_number": "18.33",
    "content_sanskrit": "यदि मयि प्रणयः करुणाऽथवा चरणभाजि पितृष्वसुरात्मजे । पदसरोजरजःपरमाणुभिश्छुरयतं प्रणतस्य शिरो मम ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20012281,
    "chapter_id": 6690,
    "verse_number": "18.34",
    "content_sanskrit": "इति वदन् वसुदेवकुमारयोः प्रणिपपात पदाब्जचतुष्टये । प्रणयभङ्गभयस्तिमितो नृपो नखरुचिच्छुरितांशुशिखामणिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20012282,
    "chapter_id": 6690,
    "verse_number": "18.35",
    "content_sanskrit": "अतिपवित्रमपि स्वत एव तौ स्थितवतोऽवनिरेणुभृतः पुरः । नरपतेरपवित्रयतां वपुस्सकलपापहरैरुपगूहनैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
