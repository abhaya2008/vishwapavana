  {
    "id": 20012283,
    "chapter_id": 6690,
    "verse_number": "18.36",
    "content_sanskrit": "घनभुजान्तरपीडितवल्लभक्षितिरजःस्तनचन्दनधूसरम् । क्षितिभृतं कुपिताविव तौ तदा भृशमपीडयतां धरणीधरौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20012284,
    "chapter_id": 6690,
    "verse_number": "18.37",
    "content_sanskrit": "नतपदं परिचुम्बितमस्तकं नरपतिस्तमित्थमथाब्रवीत् । गुह इव त्वमुमावृषभध्वजौ सुखय वत्स चिरं पितराविति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20012285,
    "chapter_id": 6690,
    "verse_number": "18.38",
    "content_sanskrit": "श्रितपादमर्जुननवाम्बुधरं स्मृतवानथ क्षितिभृदङ्कभुवा । बहुबाष्पमुच्छलनेत्रपयः शिशिरं चिरस्य हरितं मिलितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20012286,
    "chapter_id": 6690,
    "verse_number": "18.39",
    "content_sanskrit": "अमृतायमानतनुसंघटनद्रुतचित्तसिन्धुपरिवाहमिव । श्रमवारिशीकरचयं दधतः प्रथमोच्चमावथ पृथातनयौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20012287,
    "chapter_id": 6690,
    "verse_number": "18.40",
    "content_sanskrit": "कनकावदातमरुणाब्जदृशं पृथुबाहुमध्यमुरुदीर्घभुजम् । अवलोक्य तेन तद्वपुर्मदनं हरिरुक्मिणीहृदयवासगृहम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20012288,
    "chapter_id": 6690,
    "verse_number": "18.41",
    "content_sanskrit": "व्रतकर्शिताय परिपूजयते मधुसूदनाय यमुमासहितः । करुणारसस्त्रपितरूढतनुर्विततार दग्धमपि सूनुमजः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20012289,
    "chapter_id": 6690,
    "verse_number": "18.42",
    "content_sanskrit": "मुषितेन येन निजवल्लभया परिवर्धितेन तरुणीभवता । किल शम्बरस्तदभिधाविदितं विनिहत्य सा निजगृहे जगृहे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20012290,
    "chapter_id": 6690,
    "verse_number": "18.43",
    "content_sanskrit": "कुपितेन येन तनुनिर्द्दहनादचलात्मजानयनभल्लशतैः । शकलीकृतेव निगमप्रथितां बहुभेदतां वहसि रुद्रतनुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20012291,
    "chapter_id": 6690,
    "verse_number": "18.44",
    "content_sanskrit": "अतनूकृतस्त्रिणयनेन च यो नयनाशुशुक्षणिशिखावलिभिः । अकरोदनर्घतनुमम्बिकया तममर्षपूर्णहृदयो नियतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20012292,
    "chapter_id": 6690,
    "verse_number": "18.45",
    "content_sanskrit": "बलिभीम्योरिव महाबलयोरभिरूपयोर्नकुलमन्मथयोः । परमाबबन्ध हृदयं प्रणयं गुणतुल्यता हि हृदयं हरति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20012293,
    "chapter_id": 6690,
    "verse_number": "18.46",
    "content_sanskrit": "बलकृष्णजिष्णुमदनास्त्वरितं क्षितिपालभीमयमदत्तकराः । पतयो दिशामिव करम्बितदिक्पतिपाणयोऽथ रथमारुरुहुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20012294,
    "chapter_id": 6690,
    "verse_number": "18.47",
    "content_sanskrit": "स्वयमेव नेतुमथ रामकेशवौ प्रणयी नृपः प्रवयणं समाददे । सहसा हसन्नपजहार तद्धरिर्धरणीपतिस्तमथ विष्वगैक्षत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20012295,
    "chapter_id": 6690,
    "verse_number": "18.48",
    "content_sanskrit": "अपहृत्य भीमधृतमुष्णवारणं नृपतेरुपर्युपरि मस्तकं दधौ । निजदेहकान्तिपरिपूर्णमण्डलं मणिमौलिरश्मिशबलीकृतं बलः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20012296,
    "chapter_id": 6690,
    "verse_number": "18.49",
    "content_sanskrit": "स्मयमानवक्त्रकमलस्मितोऽन्तरा बलकृष्णधर्मपवमानजन्मनः । वलमानपाणिशतपत्रपेशलं समवीजयद्विजय एव चामरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20012297,
    "chapter_id": 6690,
    "verse_number": "18.50",
    "content_sanskrit": "कुसुमावलीसुरभिकेशकाननो परिवर्तयन् युवजनस्य मानसम् । स्थितवानभादमरवैद्यनन्दनौ मदनोऽन्तरेण मधुमाधवाविव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20012298,
    "chapter_id": 6690,
    "verse_number": "18.51",
    "content_sanskrit": "लसदातपत्रसितफेनमण्डला तुरगोर्मिभृद्धरिपदादुपेयुषी । अविशद्गभीरनिनदाऽथ वाहिनी पुरगोपुरान्तरसुमेरुकन्दरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20012299,
    "chapter_id": 6690,
    "verse_number": "18.52",
    "content_sanskrit": "अथ सौधमारुरुहुरात्तसंभ्रमाः पुरयोषितस्सपदि सामिभूषिताः । बलकृष्णजिष्णुमदनावलोकनाकुतुकस्फुटस्तिमितनेत्रकोटयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20012300,
    "chapter_id": 6690,
    "verse_number": "18.53",
    "content_sanskrit": "परिषिक्तमृष्टमणिमेदिनीतनुः कुसुमोपहारपरिधानधारिणी । कुचचक्रवालनिभसौधमण्डला व्यवहारतुल्यशुभतूर्यनिस्वना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20012301,
    "chapter_id": 6690,
    "verse_number": "18.54",
    "content_sanskrit": "अथ सा विलोक्य सवधूजयश्रियं नगरी चिरस्य सबलाच्युतस्मरम् । लसदुद्यतध्वजपटाग्रपाणिना मुदिता समाह्वयदिवार्जुनं मुहुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20012302,
    "chapter_id": 6690,
    "verse_number": "18.55",
    "content_sanskrit": "स रथोऽधिरूढपुरुषोत्तमाष्टकस्सुपृथुः कथञ्चन हयैरनीयत । अधिराजवीथि भरभुग्नकन्धरैरतिदीर्घपौरनयनोत्सवप्रदैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20012303,
    "chapter_id": 6690,
    "verse_number": "18.56",
    "content_sanskrit": "युवलोकलोचनहरातिसुन्दरप्रतिभूषिताभरणगात्रयष्टयः अधिरुह्य सौधशिखराणि सुभ्रुवस्तरसाऽथ वासवसुताय तस्थिरे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20012304,
    "chapter_id": 6690,
    "verse_number": "18.57",
    "content_sanskrit": "धृतयावकद्रवनवांशुमत्प्रभैरतिलोहितद्युतिभिरङ्घ्रिपङ्कजैः । हिमबिन्दुसुन्दरनखाङ्गुलीदलैरतिमञ्जुशिञ्जितमनोज्ञहंसकैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20012305,
    "chapter_id": 6690,
    "verse_number": "18.58",
    "content_sanskrit": "अमलीमसैरधिकसूक्ष्मतान्वितैः प्रकटीकृतोरुजघनोरुमण्डलैः । कृतसर्वलोकनयनप्रवृत्तिभिस्ततिमद्भिरम्बरमयैरिवाम्बरैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20012306,
    "chapter_id": 6690,
    "verse_number": "18.59",
    "content_sanskrit": "परमाणुभिस्तदपि कौतुकाचलस्फुटलोकलोचनशतावलोकितैः । वलिभङ्गुरै रुचिररोमराजितैरुदरैर्गभीरशुभनाभिमण्डलैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20012307,
    "chapter_id": 6690,
    "verse_number": "18.60",
    "content_sanskrit": "गुरुगैरिकप्रतिमकुङ्कुमारुणैः शरदभ्रराजिनिभहारयष्टिभिः । कृतभूरिपुण्यजनतावलम्बितैः पृथिवीधरैरिव कुचैः पृथून्नतैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20012308,
    "chapter_id": 6690,
    "verse_number": "18.61",
    "content_sanskrit": "व्यतिकीर्णरत्नवलयाङ्गदप्रभैः स्मरचित्रकौसुमधनुर्धरैरिव । धृतिविभ्रमश्रमजलार्द्रचन्दनैः कटिषु क्रमेण कृतविश्रमैर्भुजैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20012309,
    "chapter_id": 6690,
    "verse_number": "18.62",
    "content_sanskrit": "शितिपत्रभङ्गमृगशावकाङ्कितैः स्मितचन्द्रिकाधवलगण्डमण्डलैः । श्रितहारयष्टिवलयोडुमण्डलैः कबरीनिशामृतमरीचिमर्युखैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20012310,
    "chapter_id": 6690,
    "verse_number": "18.63",
    "content_sanskrit": "अतिसूक्ष्मवातचलिताधरांशुकक्षणदृष्टनष्टरुचिरोरुमण्डला । पुलक'च्छुटोच्छ्वसितनीवितुल्यताकरणक्कणत्कनकपाणिभूषणा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20012311,
    "chapter_id": 6690,
    "verse_number": "18.64",
    "content_sanskrit": "स्फुरितान्तरालवलिनाभिमण्डला प्रथमानपार्श्वभुजमूलविभ्रमा । कचबन्धनोन्नमितबाहुवल्लिकाविवृताद्रपाणिजपदोन्नतस्तनी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20012312,
    "chapter_id": 6690,
    "verse_number": "18.65",
    "content_sanskrit": "मृदुहासभासुरकपोलकुण्डला विपुलायतेक्षणविलंबितश्रुतिः । बलकृष्णजिष्णुमदनेक्षणत्वराधृतभूषणाऽपि विरराज काचन ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20012313,
    "chapter_id": 6690,
    "verse_number": "18.66",
    "content_sanskrit": "इह किं कुरङ्गनयना न कुर्वते शिथिलत्वमप्युपगतेन काचन । रशनागुणेन सुदृढं बबन्ध यत् सह मानसानि नयनानि कामिनाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20012314,
    "chapter_id": 6690,
    "verse_number": "18.67",
    "content_sanskrit": "मणिपादभूषणमिवापदे दधत्सकलं प्रसाधनमदभ्रसम्भ्रमम् । स्वदिदृक्षया निकटवर्ति यौवतं सदयं तदा नरवरैर्निरीक्षितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "avatarnika": ""
  },
  {
    "id": 20012315,
    "chapter_id": 6690,
    "verse_number": "18.68",
    "content_sanskrit": "'रुचिपूर्णशुक्लशितिरक्तताप्रभाप्रतिपूर्णशुक्लशितिरक्तरश्मिभिः । नयनैस्तृपा परिपपुःप्रसारितैर्नगराबला बलवलानुजस्मरान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "avatarnika": ""
  },
  {
    "id": 20012316,
    "chapter_id": 6690,
    "verse_number": "18.69",
    "content_sanskrit": "मखभुञ्मनुष्यपशुचित्तमोहनैः सततं धृतैस्सुरभितादिभिशुभैः । तरुणीरविध्यदुपसृत्य चित्तभूरपरोक्ष एव विषयेषुभिस्तदा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "avatarnika": ""
  },
  {
    "id": 20012317,
    "chapter_id": 6690,
    "verse_number": "18.70",
    "content_sanskrit": "पुरयोषितः कुमुदषण्डपाण्डुरं पुरतो विलोचनमरीचिसञ्चयम् । व्यकिरन्ननन्तशतपत्रनेत्रयोश्शयनाय सूनुमुदधिं पयोमयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "avatarnika": ""
  },
  {
    "id": 20012318,
    "chapter_id": 6690,
    "verse_number": "18.71",
    "content_sanskrit": "ददुरिन्दुकुन्दकुमुदोदरत्विषि स्फुटितातसीकुसुमनीलवाससि । वनमालिनि स्फुरितबर्हशेखरे नयनानि नीलनयना हलायुधे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "avatarnika": ""
  },
  {
    "id": 20012319,
    "chapter_id": 6690,
    "verse_number": "18.72",
    "content_sanskrit": "कुरुराजपत्तनकुरङ्गचक्षुषामवगाह्य नेत्रशफरीपरम्परा । हलचक्रहेतितनुक्रान्तिजाह्नवीयमुनाजलव्यतिकरं व्यकुर्वत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "avatarnika": ""
  },
  {
    "id": 20012320,
    "chapter_id": 6690,
    "verse_number": "18.73",
    "content_sanskrit": "वनमालयोरसि शिखण्डमालया शिरसि स्फुरत्करुणयाऽवलोकयन् । हरिरीक्षणानि हृदयानि चाहरद्दरिणीदृशां दुरितसन्ततीरपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 73,
    "avatarnika": ""
  },
  {
    "id": 20012321,
    "chapter_id": 6690,
    "verse_number": "18.74",
    "content_sanskrit": "सुदृशः श्रमाम्बुसरसीजलाप्लुताः पुरुषं पुराणमपचिन्वते पुरा । पृथुलोचनाञ्जलिपुटापवर्जितद्युतिनीलरक्तसितपद्मपङ्क्तिभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74,
    "avatarnika": ""
  },
  {
    "id": 20012322,
    "chapter_id": 6690,
    "verse_number": "18.75",
    "content_sanskrit": "नवनीतदुग्धदधिगोपकन्यकावसनापहारमयरम्यशैशवः । स किलैति कृष्ण इति कीर्तितो विभुः सुदतीः स्म लज्जयति सस्मितेक्षितैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 75,
    "avatarnika": ""
  },
  {
    "id": 20012323,
    "chapter_id": 6690,
    "verse_number": "18.76",
    "content_sanskrit": "स्फुटितातसीकुसुमनीलविग्रहं कनकप्रभापटलपीतवाससम् । स्फुटिताब्जरागहरिनीलगुम्फितस्फुरदंशुशारकटीतुन्‌द्वन्धनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 76,
    "avatarnika": ""
  },
  {
    "id": 20012324,
    "chapter_id": 6690,
    "verse_number": "18.77",
    "content_sanskrit": "अरुणाश्मरश्मिचितहेमनूपुरद्युतिमण्डलीशबलपादपङ्कजम् । समुदारशङ्खकिणरुग्मभूषणश्रितजान्वतीतभुजदण्डमण्डितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 77,
    "avatarnika": ""
  },
  {
    "id": 20012325,
    "chapter_id": 6690,
    "verse_number": "18.78",
    "content_sanskrit": "स्मितधामधौतनवहारनायकीकृतकौस्तुभद्युतिचिताधरप्रभम् । मकराननश्रवणभूषणांशुमत्करभिन्नबाहुशिखराद्रिमस्तकम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 78,
    "avatarnika": ""
  },
  {
    "id": 20012326,
    "chapter_id": 6690,
    "verse_number": "18.79",
    "content_sanskrit": "तुलितेन्द्रनीलमणिदर्पणश्रियोर्दधतं द्वयं विमलयोः कपोलयोः । परिचुम्बदम्बुधिसुताधरप्रभानिभकर्णिकारुणमणिप्रभाक्तयोः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 79,
    "avatarnika": ""
  },
  {
    "id": 20012327,
    "chapter_id": 6690,
    "verse_number": "18.80",
    "content_sanskrit": "अपनिद्रकोकनदकान्तलोचनं 'ललितायतोन्नतनताग्रनासिकम् । दधतं दृगब्जमधुपाङ्गने भ्रुवौ सुललाटिकाङ्कितललाटपट्टकम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 80,
    "avatarnika": ""
  },
  {
    "id": 20012328,
    "chapter_id": 6690,
    "verse_number": "18.81",
    "content_sanskrit": "कुटिलालिनीलकचबन्धनस्फुरद्वहुपुष्पकर्व्वरशिखण्डशेखरम् । अवलोक्य तं न ततृपुः पुराङ्गनाः पुरुषं पुराणमपि पूर्णयौवनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 81,
    "avatarnika": ""
  },
  {
    "id": 20012329,
    "chapter_id": 6690,
    "verse_number": "18.82",
    "content_sanskrit": "दुरितान्धकारनुदमंशुमालिनं शिशिरद्युतिं शमिततापमच्युतम् । अरविन्दिनीकुमुदिनीवदङ्गनाः प्रतिपद्य हर्षमतुलं प्रपेदिरे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 82,
    "avatarnika": ""
  },
  {
    "id": 20012330,
    "chapter_id": 6690,
    "verse_number": "18.83",
    "content_sanskrit": "मृदुमारुतेरितदुकूलपल्लवाः स्तनमण्डलस्तवकभारभङ्गुराः । चिकुरद्विरेफनिकुरुम्बचुम्बितस्मयमानवक्त्रसुमनोमनोहराः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 83,
    "avatarnika": ""
  },
  {
    "id": 20012331,
    "chapter_id": 6690,
    "verse_number": "18.84",
    "content_sanskrit": "फलसंश्रयाय भवतोऽङ्गनालताः दरधृतबाहुविटपाग्रपातितान् । शुभलाजपुष्पनिकरानवाकिरन् बलकेशवार्जुनमनोजमूर्धसु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 84,
    "avatarnika": ""
  },
  {
    "id": 20012332,
    "chapter_id": 6690,
    "verse_number": "18.85",
    "content_sanskrit": "परिभूषितानि रमणैर्यथापदं करजैर्मयूरपदकादिभिः कृतैः । शिवलाजवर्षसमुदस्तदोर्लतास्तनमण्डलानि सुदृशोऽप्यवृण्वत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 85,
    "avatarnika": ""
  },
  {
    "id": 20012333,
    "chapter_id": 6690,
    "verse_number": "18.86",
    "content_sanskrit": "हरिनीलशैलसमभासि चाऽच्युते शुकमेचके च शतमन्युनन्दने । कनकोज्वले च मदने रराजिरे न शशिप्रभे हलिनि लाजवृष्टयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 86,
    "avatarnika": ""
  },
  {
    "id": 20012334,
    "chapter_id": 6690,
    "verse_number": "18.87",
    "content_sanskrit": "नगरेन्दिराधवललोचनांशवः पुरदेवताहसितदन्तरश्मयः । शिवसस्यबीजनिकराङ्कुरोद्गमां क्षुभितोत्सवाम्बुनिधिफेनविन्दवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 87,
    "avatarnika": ""
  },
  {
    "id": 20012335,
    "chapter_id": 6690,
    "verse_number": "18.88",
    "content_sanskrit": "सुतवत्सलाम्बरगतावलोकयन् बलसूदनेक्षणसहस्रभानवः । सदपत्यदर्शनरसादुपागताः पितुरादिमस्य शशिनः परिग्रहाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 88,
    "avatarnika": ""
  },
  {
    "id": 20012336,
    "chapter_id": 6690,
    "verse_number": "18.89",
    "content_sanskrit": "कुसुमायिता शिरसि कान्तकुन्तलैः कपिकेतुमापुरबलाचलाजकाः । अदयोपगूढविदलद्गुणच्युतस्तनकुम्भहारमणयो जयश्रियः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 89,
    "avatarnika": ""
  },
  {
    "id": 20012337,
    "chapter_id": 6690,
    "verse_number": "18.90",
    "content_sanskrit": "अवलम्ब्य राममुरविद्विषोः करौ रुरुचे रथादवतरन्युधिष्ठिरः । अथ पार्वतीरमणपद्मनाभयोः खमहाविमानत इव प्रजापतिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 90,
    "avatarnika": ""
  },
  {
    "id": 20012338,
    "chapter_id": 6690,
    "verse_number": "18.91",
    "content_sanskrit": "प्रथमाश्विमन्मथकरावलम्बिना द्विपतां बलं दिव इव स्थलं पुरा । कृतपाणिना नकुलरौक्मिणेययोस्तनयेन तस्य जुजुषे रथात्ततः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 91,
    "avatarnika": ""
  },
  {
    "id": 20012339,
    "chapter_id": 6690,
    "verse_number": "18.92",
    "content_sanskrit": "सहधर्मराजमरुदश्विनन्दनः सहरौहिणेयहरिरुक्मिणीसुतः । पुरुहूतसूनुरुपसेदिवानथ प्रथमानमङ्गलशतं पृथागृहम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
