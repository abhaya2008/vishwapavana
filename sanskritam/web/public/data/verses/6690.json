  {
    "id": 20012345,
    "chapter_id": 6690,
    "verse_number": "18.98",
    "content_sanskrit": "रतिजीवितेशजयहस्तिमस्तकैः स्तनशातकुम्भकलशैरलङ्कृतम् । स्मरपत्तनोपवनवल्लिभिः स्फुरत्सुतलप्रवालरुचिभिश्च बाहुभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 98,
    "avatarnika": ""
  },
  {
    "id": 20012346,
    "chapter_id": 6690,
    "verse_number": "18.99",
    "content_sanskrit": "हरिचन्दनच्छुरितहारकन्धरैर्मणिकुण्डलोल्लसितगण्डमण्डलैः । तिलकाङ्कितार्धशशिलेशलालितैर्धृतमाल्यगन्धकचबन्धबन्धुरैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 99,
    "avatarnika": ""
  },
  {
    "id": 20012347,
    "chapter_id": 6690,
    "verse_number": "18.100",
    "content_sanskrit": "सुमनः शिलीमुखमहास्रविभ्रमस्मितबध्यमानयुवलोकमानसैः । नवनागवल्लिरसपूरितप्रभद्विजवर्णकीर्णदशनांशुराजिभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 100,
    "avatarnika": ""
  },
  {
    "id": 20012348,
    "chapter_id": 6690,
    "verse_number": "18.101",
    "content_sanskrit": "तिलपुष्पकान्तिहरनासिकापुटैर्ललितभ्रुभिर्वलितलोचनोत्पलैः । स्नपितैरिव प्रचुरकान्तिवारिभिर्वदनैश्च भूषितमधीरचक्षुषाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 101,
    "avatarnika": ""
  },
  {
    "id": 20012349,
