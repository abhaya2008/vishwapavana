  {
    "id": 20012344,
    "chapter_id": 6690,
    "verse_number": "18.97",
    "content_sanskrit": "'ससरोजषण्डमिव पाणिभिः पदैः समहेन्दुवृन्दमिव सुन्दरैर्मुखैः । सरथावलीव जघनैर्नतभ्रुवां ससुजातरम्भमिव पीवरोरुभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
