  {
    "id": 20012341,
    "chapter_id": 6690,
    "verse_number": "18.94",
    "content_sanskrit": "बहुरोचनामलयजाम्बुश्रौतसन्मणिभूलसत्कनकभाण्डमण्डलम् । दधिशङ्खरुच्यसुफलाक्षतादिमद्धृतसर्वधान्यतपनीयभाजनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
