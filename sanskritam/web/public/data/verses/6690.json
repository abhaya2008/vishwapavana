  {
    "id": 20012340,
    "chapter_id": 6690,
    "verse_number": "18.93",
    "content_sanskrit": "स्फुटपुण्डरीकविहिताननोल्लसत्कनकोदकुम्भशतशोभितं पुरम् । शुभपुष्पदामसितरत्नतोरणद्युतिपूरभास्वरसनीडभूतलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 93,
    "avatarnika": ""
