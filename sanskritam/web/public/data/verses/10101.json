[{"id": 6000101000, "chapter_id": 10101, "verse_number": null, "content_sanskrit": "अथ षष्ठाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000101001, "chapter_id": 10101, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_006/BhP_05.006.001.m4a", "display_order": 2}, {"id": 6000101002, "chapter_id": 10101, "verse_number": "५-६-१", "content_sanskrit": "न नूनं भगवन्नात्मरामाणां योगसमीरितज्ञानावभर्जितकर्मबीजानामैश्वर्याणि पुनः क्लेशदानि भवितुमर्हन्ति यदृच्छयोपगतानि॥ ५/६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_006/BhP_05.006.002.m4a", "display_order": 3, "topics": [{"text": "अवशिष्टऋषभचरित्रकथनम्", "range": "१–७"}]}, {"id": 6000101003, "chapter_id": 10101, "verse_number": null, "content_sanskrit": "शुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_006/BhP_05.006.003.m4a", "display_order": 4}, {"id": 6000101004, "chapter_id": 10101, "verse_number": "५-६-२", "content_sanskrit": "सत्यमुक्तं किन्त्विह वा एके मनसो विस्रम्भमनवस्थानस्य घटकिराट इव न सङ्गच्छन्ति॥ ५/६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_006/BhP_05.006.004.m4a", "display_order": 5}, {"id": 6000101005, "chapter_id": 10101, "verse_number": null, "content_sanskrit": "तथा चोक्तम्—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_006/BhP_05.006.005.m4a", "display_order": 6}, {"id": 6000101006, "chapter_id": 10101, "verse_number": "५-६-३", "content_sanskrit": "न कुर्यात्कस्यचित्सख्यं मनसि ह्यनवस्थिते।\nयद्विस्रम्भाच्चिराच्चीर्णं चस्कन्द तप ऐश्वरम्॥ ५/६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_006/BhP_05.006.006.m4a", "display_order": 7}, {"id": 6000101007, "chapter_id": 10101, "verse_number": "५-६-४", "content_sanskrit": "नित्यं ददाति कामस्य च्छिद्रं तमनु येऽरयः।\nयोगिनः कृतमैत्रस्य पत्युर्जायेव पुंश्चली॥ ५/६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_006/BhP_05.006.007.m4a", "display_order": 8}, {"id": 6000101008, "chapter_id": 10101, "verse_number": "५-६-५", "content_sanskrit": "कामो मन्युर्मदो लोभः शोकमोहभयादयः।\nकर्मबन्धश्च यन्मूलः स्वीकुर्यात्को नु तद्बुधः॥ ५/६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_006/BhP_05.006.008.m4a", "display_order": 9}, {"id": 6000101009, "chapter_id": 10101, "verse_number": "५-६-६", "content_sanskrit": "अथैवमखिललोकपालललामो विलक्षणो जडवदवधूतवेषभाषाचरितैरविलक्षितभगवत्प्रभावो योगिनां साम्परायविधिमनुशिक्षयन्स्वकलेवरं जिहासुरात्मन्यात्मानमसंव्यवहितमनर्थान्तर-भावेनान्वीक्षमाण उपरतानुवृत्तिरुपरराम॥ ५/६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_006/BhP_05.006.009.m4a", "display_order": 10}, {"id": 6000101010, "chapter_id": 10101, "verse_number": "५-६-८", "content_sanskrit": "तस्य ह वा एवं मुक्तलिङ्गस्य भगवत ऋषभस्य योगमायावसानो देह इमां जगतीमभिमानाभासेन चङ्क्रममाण एकदा तु काङ्कटकर्णाटकाद्दक्षिणकर्णाटकान् देशान् यदृच्छयोपगतः कुटचाचलोपवने आस्यकृताश्मकवल उन्माद इव मुक्तमूर्द्धजोऽसंवीत एव विचचार॥ ५/६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_006/BhP_05.006.010.m4a", "display_order": 11, "topics": [{"text": "तस्य जडवदवधूतवेषेण नानादेशेषु संचरणम्", "range": "८"}]}, {"id": 6000101011, "chapter_id": 10101, "verse_number": "५-६-९", "content_sanskrit": "अथ समीरवेगविधुतवेणुनिर्घर्षणजातो दावानलस्तद्वनमालेलिहानः सह तेन ददाह॥ ५/६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_006/BhP_05.006.011.m4a", "display_order": 12, "topics": [{"text": "दावाग्निप्रवेशः", "range": "९"}]}, {"id": 6000101012, "chapter_id": 10101, "verse_number": "५-६-१०", "content_sanskrit": "यस्य किलानुचरितमुपाकर्ण्य काङ्कटकर्णाटकानां दक्षिणकर्णाटकानां राजार्हनामोपशिक्ष्य कलावधर्म उत्कृष्यमाणे भवितव्येन विमोहितः स्वधर्मपथमकुतोभयमपहाय कुपथं पाखण्डमसमञ्जसं निजमनीषया मन्दः सम्प्रवर्तयिष्यते॥ ५/६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_006/BhP_05.006.012.m4a", "display_order": 13, "topics": [{"text": "दावाग्नेः बहिरागत्य ऋषभः वासुदेवोऽस्मि इत्यब्रवीत्, तच्छ्रुत्वा अर्हन् सर्वत्र पाषण्डमतं प्रथयाञ्चकार", "range": "१०–२०"}]}, {"id": 6000101013, "chapter_id": 10101, "verse_number": "५-६-११", "content_sanskrit": "येन ह वा कलौ मनुजापसदा देवमायाविमोहिताः स्वविधिनियोगशौचाचारविहीना देवहेलनादीन्यपव्रतानि निजेच्छया गृह्णाना अस्नानानाचमनाशौचकेशोल्लुञ्चनादीनि कलिनाऽधर्मबहुलेनोपहतधियो ब्रह्मब्राह्मणयज्ञपुरुषलोकविदूषकाः प्रायेण भविष्यन्ति॥ ५/६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_006/BhP_05.006.013.m4a", "display_order": 14}, {"id": 6000101014, "chapter_id": 10101, "verse_number": "५-६-१२", "content_sanskrit": "तैरपि ह्यर्वाक्तनया निजलोकयात्रयान्धपरम्परयाऽत एवानास्थास्तमस्यन्धे स्वयमेव प्रपतिष्यन्ति॥ ५/६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_006/BhP_05.006.014.m4a", "display_order": 15}, {"id": 6000101015, "chapter_id": 10101, "verse_number": "५-६-१३", "content_sanskrit": "अयमवतारो रजसोपप्लुतकैवल्योपशिक्षणार्थस्तस्यानुगुणान् श्लोकान्गायन्ति॥ ५/६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_006/BhP_05.006.015.m4a", "display_order": 16}, {"id": 6000101016, "chapter_id": 10101, "verse_number": "५-६-१४", "content_sanskrit": "अहो भुवः सप्तसमुद्रवत्या द्वीपेषु वर्षेष्वधिपुण्यमेतत्।\nगायन्ति यत्रत्यजना मुरारेः कर्माणि भद्राण्यवतारवन्ति॥ ५/६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_006/BhP_05.006.016.m4a", "display_order": 17}, {"id": 6000101017, "chapter_id": 10101, "verse_number": "५-६-१५", "content_sanskrit": "अहोऽनुवंशो यशसाऽवदातः प्रैयव्रतो यत्र पुमान् पुराणः।\nकृतावतारः पुरुषः स आद्यश्चचार धर्मं यदकर्महेतुम्॥ ५/६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_006/BhP_05.006.017.m4a", "display_order": 18}, {"id": 6000101018, "chapter_id": 10101, "verse_number": "५-६-१६", "content_sanskrit": "को न्वस्य काष्ठामपरोऽनुगच्छेन्मनोरथेनाप्यभवाय योगी।\nयद्योगमायां स्पृहयन्त्युदस्तां महत्तमा येन कृतप्रयत्नाः॥ ५/६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_006/BhP_05.006.018.m4a", "display_order": 19}, {"id": 6000101019, "chapter_id": 10101, "verse_number": "५-६-१७", "content_sanskrit": "इति ह स्म सकललोकदेवब्राह्मणगवां परमगुरोर्भगवत ऋषभाख्यस्य विशुद्धाचरितं पुंसां समस्तदुश्चरिताभिहरणं परममहामङ्गलायनमिदमनु श्रद्धयोपचितयाऽनुशृृणोत्याश्रावयत्यवहितो भगवति तस्मिन्वासुदेवे एकान्ततो भक्तिरनयोरपि समनुवर्तते॥ ५/६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_006/BhP_05.006.019.m4a", "display_order": 20}, {"id": 6000101020, "chapter_id": 10101, "verse_number": "५-६-१८", "content_sanskrit": "यस्यामेव कवय आत्मानमविरतविविधवृजिनसंसारपरितापोपतप्यमानमनुसवनं स्नापयन्तस्तयैव परया निर्वृत्या ह्यापवर्गिकमात्यन्तिकं परमपुरुषार्थमपि स्वयमासादितं नैवाद्रियन्ते भागवतत्वेनैव परिसमाप्तसर्वार्थाः॥ ५/६/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_006/BhP_05.006.020.m4a", "display_order": 21}, {"id": 6000101021, "chapter_id": 10101, "verse_number": "५-६-१९", "content_sanskrit": "राजन् पतिर्गुरुरलं भवतां यदूनां देवप्रियः कुलपतिः क्‍व च किङ्करो वः।\nअस्त्वेवमङ्ग भगवान् भजतां मुकुन्दो मुक्तिं ददाति कर्हिचित्स्म न भक्तियोगम्॥ ५/६/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_006/BhP_05.006.021.m4a", "display_order": 22}, {"id": 6000101022, "chapter_id": 10101, "verse_number": "५-६-२०", "content_sanskrit": "नित्यानुभूतनिजलाभनिवृत्ततृष्णः श्रेयस्यतद्रचनया चिरसुप्तबुद्धेः।\nलोकस्य यः करुणयाऽभयमात्मलोकमाख्यान्नमो भगवते ऋषभाय तस्मै॥ ५/६/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_006/BhP_05.006.022.m4a", "display_order": 23}, {"id": 6000101023, "chapter_id": 10101, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां पञ्चमस्कन्धे षष्ठाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]