[{"id": 2210492, "chapter_id": 5502, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2210493, "chapter_id": 5502, "verse_number": "१", "content_sanskrit": "कोऽसौ नकुलरूपेण शिरसा काञ्चनेन ह ।\nप्राह मानुषया वाचा ह्येतत् पृष्टो वदस्व मे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2210494, "chapter_id": 5502, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2210495, "chapter_id": 5502, "verse_number": "", "content_sanskrit": "एतत्पूर्वं न पृष्टोऽहं न चास्माभिः प्रभाषितम् ।\nश्रूयतां नकुलो योऽसौ यथा वाक् चास्य मानुषी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2210496, "chapter_id": 5502, "verse_number": "३", "content_sanskrit": "श्राद्धं सङ्कल्पयामास जमदग्निः पुरा किल ।\nहोमधेनुस्तमागच्छत् स्वयं चापि दुदोह ताम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2210497, "chapter_id": 5502, "verse_number": "४", "content_sanskrit": "तत् क्षीरं स्थापयामास हेमभाण्डे शुभे शुचौ ।\nतच्च क्रोधः स्वरूपेण पिठरं पर्यधर्षयत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2210498, "chapter_id": 5502, "verse_number": "५", "content_sanskrit": "जिज्ञासुस्तमृषिश्रेष्ठं किं कुर्याद् विप्रिये कृते ।\nइति सञ्चिन्त्य दुर्मेधा धर्षयामास तत् पयः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2210499, "chapter_id": 5502, "verse_number": "६", "content_sanskrit": "तमाज्ञाय मुनिः क्रोधं नैवास्मै चुकुपे ततः ।\nस तु क्रोधस्तमासाद्य प्राञ्जलिर्मूर्तिमान् स्थितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2210500, "chapter_id": 5502, "verse_number": "७", "content_sanskrit": "जितोऽस्मीति भृगुश्रेष्ठं भृगवो ह्यतिरोषणाः ।\nलोके मिथ्याप्रवादोऽयं यत् त्वयाऽस्मि पराजितः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2210501, "chapter_id": 5502, "verse_number": "८", "content_sanskrit": "सोऽयं त्वयि स्थितो ह्यद्य क्षमावति महात्मनि ।\nबिभेमि तपसः साधो प्रसादं कुरु मे प्रभो ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2210502, "chapter_id": 5502, "verse_number": "", "content_sanskrit": "जमदग्निः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2210503, "chapter_id": 5502, "verse_number": "९", "content_sanskrit": "सम्यग् दृष्टोऽसि मे क्रोध गच्छ त्वं विगतज्वरः ।\nन ममापकृतं तेऽद्य न मन्युर्विद्यते त्वयि ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2210504, "chapter_id": 5502, "verse_number": "१०", "content_sanskrit": "यानुद्दिश्य तु सङ्कल्पः पयसोऽद्य कृतो मया ।\nपितरस्ते महाभागास्तेभ्यो बुद्ध्यस्व गम्यताम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2210505, "chapter_id": 5502, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2210506, "chapter_id": 5502, "verse_number": "११", "content_sanskrit": "इत्युक्तो जातसन्त्रासस्तत्रैवान्तरधीयत ।\nपितॄणामभिषङ्गात् तु नकुलत्वमुपागतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2210507, "chapter_id": 5502, "verse_number": "१२", "content_sanskrit": "स तान् प्रसादयामास शापस्यान्तो भवेदिति ।\nतैश्चाप्युक्तो यदा धर्मं क्षेप्स्यसे मोक्ष्यसे तदा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2210508, "chapter_id": 5502, "verse_number": "१३", "content_sanskrit": "इत्युक्तो यज्ञियान् देशान् धर्मारण्यानि चैव ह ।\nजुगुप्सन् परिधावन् स तं यज्ञं समुपासदत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2210509, "chapter_id": 5502, "verse_number": "१४", "content_sanskrit": "धर्मपुत्रमथाक्षिप्य सक्तुप्रस्थेन तेन सः ।\nमुक्तशापस्ततः क्रोधो धर्मो ह्यासीद् युधिष्ठिरः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2210510, "chapter_id": 5502, "verse_number": "१५", "content_sanskrit": "एवमेतद् यथा वृत्तं तस्य यज्ञे महात्मनः ।\nपश्यतां चापि नस्तत्र नकुलोऽन्तर्हितस्तदा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2210511, "chapter_id": 5502, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि नकुलस्वरूपकथनं नाम षण्णवतितमोऽध्यायः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]