[{"id": 2042245, "chapter_id": 1941, "verse_number": "५-१८६-०x", "content_sanskrit": "राम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2042246, "chapter_id": 1941, "verse_number": "५-१८६-१", "content_sanskrit": "प्रत्यक्षमेतल्लोकानां सर्वेषामेव भामिनि ।\nयथाशक्त्या मया युद्धं कृतं वै पौरुषं परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2042247, "chapter_id": 1941, "verse_number": "५-१८६-२", "content_sanskrit": "न चैवमपि शक्नोमि भीष्मं शस्त्रभृतां वरम् ।\nविशेषयितुमत्यर्थमुत्तमास्त्राणि दर्शयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2042248, "chapter_id": 1941, "verse_number": "५-१८६-३", "content_sanskrit": "एषा मे परमा शक्तिरेतन्मे परमं बलम् ।\nयथेष्टं गम्यतां भद्रे किमन्यद्वा करोमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2042249, "chapter_id": 1941, "verse_number": "५-१८६-४", "content_sanskrit": "भीष्ममेव प्रपद्यस्व न तेऽन्या विद्यते गतिः ।\nनिर्जितो ह्यस्मि भीष्मेण महास्त्राणि प्रमुञ्चता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2042250, "chapter_id": 1941, "verse_number": "५-१८६-५", "content_sanskrit": "एवमुक्त्वा ततो रामो विनिःश्वस्य महामनाः ।\nतूष्मीमासीत्ततः कनक्या प्रोवाच भृगुनन्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2042251, "chapter_id": 1941, "verse_number": "५-१८६-६", "content_sanskrit": "भगवन्नेवमेवैतद्यथाऽऽह भगवांस्तथा ।\nअजेयो युधि भीष्मोऽयमपि देवैरुदारधीः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2042252, "chapter_id": 1941, "verse_number": "५-१८६-७", "content_sanskrit": "यथाशक्ति यथोत्साहं मम कार्यं कृतं त्वया ।\nअनिवार्यं रणे वीर्यमस्त्राणि विविधानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2042253, "chapter_id": 1941, "verse_number": "५-१८६-८", "content_sanskrit": "ने चैव शक्यते युद्धे विशेषयितुमन्ततः ।\nन चाहमेनं यास्यामि पुनर्भीष्मं कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2042254, "chapter_id": 1941, "verse_number": "५-१८६-९", "content_sanskrit": "गमिष्यामि तु तत्राहं यत्र भीष्मं तपोधन ।\nसमरे पातयिष्यामि स्वयमेव भृगूद्वह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2042255, "chapter_id": 1941, "verse_number": "५-१८६-१०", "content_sanskrit": "एवमुक्त्वा ययौ कन्या रोषव्याकुललोचना ।\nतापस्ये धृतसंकल्पा सा मे चिन्तयती वधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2042256, "chapter_id": 1941, "verse_number": "५-१८६-११", "content_sanskrit": "ततो महेन्द्रं सहितैरमुनिभिर्भृगुसत्तमः ।\nयथाऽऽगतं तथा सोऽगन्मामुपामन्त्र्य भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2042257, "chapter_id": 1941, "verse_number": "५-१८६-१२", "content_sanskrit": "ततो रथं समारुह्य स्तूयमानो द्विजातिभिः ।\nप्रविश्य नगरं मात्रे सत्यवत्यै न्यवेदयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2042258, "chapter_id": 1941, "verse_number": "५-१८६-१३", "content_sanskrit": "यथावृत्तं महाराज सा च मां प्रत्यनन्दत।\nपुरुषांश्चादिशं प्राज्ञान्कन्यावृत्तान्तकर्मणि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2042259, "chapter_id": 1941, "verse_number": "५-१८६-१४", "content_sanskrit": "दिवसे दिवसे ह्यस्या गतिजल्पितचेष्टितम् ।\nप्रत्याहरंश्च मे युक्ताः स्थिताः प्रियहिते सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2042260, "chapter_id": 1941, "verse_number": "५-१८६-१५", "content_sanskrit": "यदैव हि वनं प्रायात्सा कन्या तपसे धृता।\nतदैव व्यथितो दीनो गतचेता इवाभवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2042261, "chapter_id": 1941, "verse_number": "५-१८६-१६", "content_sanskrit": "न हि मां क्षत्रियः कश्चिद्वीर्येण व्यजयद्युधि ।\nऋते ब्रह्मविदस्तात तपसा संशितव्रतात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2042262, "chapter_id": 1941, "verse_number": "५-१८६-१७", "content_sanskrit": "अपि चैतन्मया राजन्नारदेऽपि निवेदितम् ।\nव्यासे चैव तथा कार्यं तौ चोभौ मामवोचताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2042263, "chapter_id": 1941, "verse_number": "५-१८६-१८", "content_sanskrit": "न विषादस्त्वया कार्यो भीष्म काशिसुतां प्रति।\nदैवं पुरुषकारेण को निवर्तितुमुत्सहेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2042264, "chapter_id": 1941, "verse_number": "५-१८६-१९", "content_sanskrit": "सा कन्या तु महाराज प्रविश्याश्रममण्डलम् ।\nयमुनातीरमाश्रित्य तपस्तेपेऽतिमानुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2042265, "chapter_id": 1941, "verse_number": "५-१८६-२०", "content_sanskrit": "निराहारा कृशा रूक्षा जटिला मलपङ्किनी ।\nषण्मासान्वायुभक्षा च स्थाणुभूता तपोधना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2042266, "chapter_id": 1941, "verse_number": "५-१८६-२१", "content_sanskrit": "यमुनाजलमाश्रित्य संवत्सरमथाऽपरम् ।\nउदवासं निराहारा पारयामास भामिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2042267, "chapter_id": 1941, "verse_number": "५-१८६-२२", "content_sanskrit": "शीर्णपर्णेन चैकेन पारयामास सा परम् ।\nसंवत्सरं तीव्रकोपा पादाङ्गुष्ठाग्रधिष्ठिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2042268, "chapter_id": 1941, "verse_number": "५-१८६-२३", "content_sanskrit": "एवं द्वादश वर्षाणि तापयामास रोदसी ।\nनिवर्त्यमानापि च सा ज्ञातिभिर्नैव शक्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2042269, "chapter_id": 1941, "verse_number": "५-१८६-२४", "content_sanskrit": "ततोऽगमद्वत्सभूमिं सिद्धचारणसेविताम् ।\nआश्रमं पुण्यशीलानां तापसानां महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2042270, "chapter_id": 1941, "verse_number": "५-१८६-२५", "content_sanskrit": "तत्र पुण्येषु तीर्थेषु साऽऽप्लुताङ्गी दिवानिशम् ।\nव्यचरत्काशिकन्या सा यथाकामविचारिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2042271, "chapter_id": 1941, "verse_number": "५-१८६-२६", "content_sanskrit": "नन्दाश्रमे महाराज तथोलूकाश्रमे शुभे ।\nच्यवनस्याश्रमे चैव ब्रह्मणः स्थान एव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2042272, "chapter_id": 1941, "verse_number": "५-१८६-२७", "content_sanskrit": "त्रयागे देवयजने देवारण्येषु चैव ह ।\nभोगवत्यां महाराज कौशिकस्याश्रमे तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2042273, "chapter_id": 1941, "verse_number": "५-१८६-२८", "content_sanskrit": "माण्डव्यस्याश्रमे राजन्दिलीपस्याश्रमे तथा ।\nरामह्रदे च कौरव्य पैलगर्गस्य चाश्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2042274, "chapter_id": 1941, "verse_number": "५-१८६-२९", "content_sanskrit": "एतेषु तीर्थेषु तदा काशिकन्या विशांपते ।\nआप्लावयत गात्राणि व्रतमास्थाय दुष्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2042275, "chapter_id": 1941, "verse_number": "५-१८६-३०", "content_sanskrit": "तामब्रवीच्च कौरव्य मम माता जले स्थिता ।\nकिमर्थं क्लिश्यसे भद्रे तथ्यमेव वदस्व मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2042276, "chapter_id": 1941, "verse_number": "५-१८६-३१", "content_sanskrit": "सैनामथाब्रवीद्राजन्कृताञ्जलिरनिन्दिता\nभीष्मेण समरे रामो निर्जितश्चारुलोचनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2042277, "chapter_id": 1941, "verse_number": "५-१८६-३२", "content_sanskrit": "कोऽन्यस्तमुत्सहेञ्जेतुमुद्यतेषुं महीपतिः ।\nसाहं भीष्मविनाशाय तपस्तप्स्ये सुदारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2042278, "chapter_id": 1941, "verse_number": "५-१८६-३३", "content_sanskrit": "विचरामि महीं देवि यथा हन्यामहं नृपम् ।\nएतद्व्रतफलं देवि परमस्मिन्यथा हि मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2042279, "chapter_id": 1941, "verse_number": "५-१८६-३४", "content_sanskrit": "ततोऽब्रवीत्सागरगा जिह्मं चरसि भामिनि।\nनैष कामोऽनवद्याङ्गि शक्यः प्राप्तुं त्वयाऽबले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2042280, "chapter_id": 1941, "verse_number": "५-१८६-३५", "content_sanskrit": "यदि भीष्मविनाशाय काश्ये चरसि वै व्रतम्।\nव्रतस्था च शरीरं त्वं यदि नाम विमोक्ष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2042281, "chapter_id": 1941, "verse_number": "५-१८६-३६", "content_sanskrit": "नदी भविष्यसि शुभे कुटिला वार्षिकोदका।\nदुस्तीर्था न तु विज्ञेया वार्षिकी नाष्टमासिकी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2042282, "chapter_id": 1941, "verse_number": "५-१८६-३७", "content_sanskrit": "भीमग्राहवती घोरा सर्वभूतभयंकरी ।\nएवमुक्त्वा ततो राजन्काशिकन्यां न्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2042283, "chapter_id": 1941, "verse_number": "५-१८६-३८", "content_sanskrit": "माता मम महाभागा स्मयमानेव भामिनी ।\nकदाचिदष्टमे मासि कदाचिद्दशमे तथा।\nन प्राश्नीतोदकमपि पुनः सा वरवर्णिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2042284, "chapter_id": 1941, "verse_number": "५-१८६-३९", "content_sanskrit": "सा वत्सभूमिं कौरव्य तीर्थलोभात्ततस्ततः ।\nपतिता परिधावन्ती पुनः काशिपतेः सुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2042285, "chapter_id": 1941, "verse_number": "५-१८६-४०", "content_sanskrit": "सा नदी वत्सभूम्यां तु प्रथिताम्बेति भारत ।\nवार्षिकी ग्राहबहुला दुस्तीर्था कुटिला तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2042286, "chapter_id": 1941, "verse_number": "५-१८६-४१", "content_sanskrit": "सा कन्या तपसा तेन देहार्धेन व्यजायत ।\nनदी च राजन्वत्सेषु कन्या चैवाभवत्तदा ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2042287, "chapter_id": 1941, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि अम्बोपाख्यानपर्वणि षडशीत्यधिकशततमोऽध्याय- ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]