[{"id": 7000600000, "chapter_id": 20600, "verse_number": "५-५९-१", "content_sanskrit": "शेष उवाच ।\nअथ नावा समुत्तीर्य जाह्नवीं लक्ष्मणस्तदा ।\nजानकीं परतस्तीरे हस्ते धृत्वा वनं ययौ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000600001, "chapter_id": 20600, "verse_number": "५-५९-२", "content_sanskrit": "सा चलंती पथि तदा शुष्यद्वदनलक्षिता ।\nकंटकक्षतसत्पादा स्खलंती च पदे पदे॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000600002, "chapter_id": 20600, "verse_number": "५-५९-३", "content_sanskrit": "लक्ष्मणस्तां महाघोरे विपिने दुःखदायिनि ।\nप्रवेशयामास तदा राघवाज्ञाविधायकः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000600003, "chapter_id": 20600, "verse_number": "५-५९-४", "content_sanskrit": "यत्र वृक्षा महाघोरा बर्बूलाः खदिरा घनाः ।\nश्लेष्मातकाश्चिंचिणीकाः शुष्का दावेन वह्निना॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000600004, "chapter_id": 20600, "verse_number": "५-५९-५", "content_sanskrit": "कोटरस्था महासर्पाः फूत्कुर्वंति सुकोपिताः ।\nघूका घूत्कुर्वते यत्र लोकचित्तभयंकराः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000600005, "chapter_id": 20600, "verse_number": "५-५९-६", "content_sanskrit": "व्याघ्राः सिंहाः सृगालाश्च द्वीपिनोऽतिभयंकराः ।\nदृश्यंते यत्र सरला मनुष्यादाः सुकोपनाः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000600006, "chapter_id": 20600, "verse_number": "५-५९-७", "content_sanskrit": "महिषाः सूकरा दुष्टा दंष्ट्रा द्वयविलक्षिताः ।\nकुर्वंति प्राणिनां तापं मानसस्य मदोद्धुराः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000600007, "chapter_id": 20600, "verse_number": "५-५९-८", "content_sanskrit": "ईदृग्वनं प्रपश्यंती भयेनोपगतज्वरा ।\nकंटकैर्दष्टचरणा लक्ष्मणं वाक्यमब्रवीत्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000600008, "chapter_id": 20600, "verse_number": "५-५९-९", "content_sanskrit": "जानक्युवाच ।\nवीरर्षिमुनिसंसेव्या नाश्रमान्नेत्रसौख्यदान् ।\nनाहं पश्यामि नो तेषां पत्नीश्च सुतपोधनाः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000600009, "chapter_id": 20600, "verse_number": "५-५९-१०", "content_sanskrit": "पश्यामि केवलं घोरान्पक्षिणः शुष्कवृक्षकान् ।\nदावानलेन तत्सर्वं दह्यमानमिदं वनम्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000600010, "chapter_id": 20600, "verse_number": "५-५९-११", "content_sanskrit": "त्वां च पश्यामि दुःखार्तमश्रुपूर्णाकुलेक्षणम् ।\nशकुनेतरसाहस्रं भवेन्मम पदे पदे॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000600011, "chapter_id": 20600, "verse_number": "५-५९-१२", "content_sanskrit": "तन्मे कथय वीराग्र्य कथं मुक्ता महात्मना ।\nरामेण दुष्टहृदया क्षिप्रं कथय मे हि तत्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000600012, "chapter_id": 20600, "verse_number": "५-५९-१३", "content_sanskrit": "इति वाक्यं समाकर्ण्य लक्ष्मणः शोककर्शितः ।\nसंरुद्धबाष्पवदनो न किंचित्प्रोक्तवांस्तदा॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000600013, "chapter_id": 20600, "verse_number": "५-५९-१४", "content_sanskrit": "तदेव विपिनं घोरं गच्छंती लक्ष्मणान्विता ।\nपुनरप्याह तं वीरं दुःखार्ता पश्यती मुखम्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000600014, "chapter_id": 20600, "verse_number": "५-५९-१५", "content_sanskrit": "तदापि स न तां वक्ति किमपि प्रेक्षुलोलुपः ।\nतदा सात्यंतनिर्बंधं चकार परिपृच्छती॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000600015, "chapter_id": 20600, "verse_number": "५-५९-१६", "content_sanskrit": "आग्रहेण यदा पृष्टो लक्ष्मणः सीतया तदा ।\nरुद्धकंठो मुहुः शोचन्नवदत्त्यागसंभवम्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000600016, "chapter_id": 20600, "verse_number": "५-५९-१७", "content_sanskrit": "तद्वाक्यं पविना तुल्यं निशम्य मुनिसत्तम ।\nसुलताकृत्तमूलेव बभूवाकल्पवर्जिता॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000600017, "chapter_id": 20600, "verse_number": "५-५९-१८", "content_sanskrit": "तदैव पृथिवी तां न जग्राह तनयामिमाम् ।\nरामो विपापिनीं सीतां न जह्यादिति शंकिनी॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000600018, "chapter_id": 20600, "verse_number": "५-५९-१९", "content_sanskrit": "पतितां तां तु वैदेहीं दृष्ट्वा सौमित्रिरुत्सुकः ।\nपल्लवाग्र्यसमीरेण संज्ञितां तु चकार सः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000600019, "chapter_id": 20600, "verse_number": "५-५९-२०", "content_sanskrit": "संज्ञां प्राप्ता ह्युवाचेदं मा हास्यं कुरु देवर ।\nकथं मां पापरहितां त्यजते स रघूद्वहः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000600020, "chapter_id": 20600, "verse_number": "५-५९-२१", "content_sanskrit": "एवं बहुविलप्याथ लक्ष्मणं दुःखसंयुतम् ।\nसंवीक्ष्यमू र्च्छिता भूमौ पपात परिदुःखिता॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000600021, "chapter_id": 20600, "verse_number": "५-५९-२२", "content_sanskrit": "मुहूर्तेनापि संज्ञां सा प्राप्य दुःखपरिप्लुता ।\nजगाद रामचरणौ स्मंरती शोकविक्षता॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000600022, "chapter_id": 20600, "verse_number": "५-५९-२३", "content_sanskrit": "रघुनाथो महाबुद्धिस्त्यजते मां कथं महान् ।\nयो मदर्थे पयोराशिं बद्धवान्वानरैर्युतः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000600023, "chapter_id": 20600, "verse_number": "५-५९-२४", "content_sanskrit": "स कथं मां महावीरो निष्पापां रजकोक्तितः ।\nत्यजिष्यति ममैवात्र दैवं तु प्रतिकूलितम्॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000600024, "chapter_id": 20600, "verse_number": "५-५९-२५", "content_sanskrit": "एवं वदन्ती पुनरपि मूर्च्छां प्राप्ता विदेहजा ।\nमूर्च्छितां तां समीक्ष्याथ रुरोद विकृतस्वरः॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000600025, "chapter_id": 20600, "verse_number": "५-५९-२६", "content_sanskrit": "पुनः संज्ञामवाप्यैवं सौमित्रिं निजगाद सा ।\nदुःखातुरं वीक्षमाणा रुद्धकंठं सुदुःखिता॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000600026, "chapter_id": 20600, "verse_number": "५-५९-२७", "content_sanskrit": "सौमित्रे गच्छ रामं त्वं धर्ममूर्तिं यशोनिधिम् ।\nमद्वाक्यमेवैतद्ब्रूयाः समक्षं तपसां निधेः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000600027, "chapter_id": 20600, "verse_number": "५-५९-२८", "content_sanskrit": "मां तत्याज भवान्यद्वै जानन्नपि विपापिनीम् ।\nकुलस्य सदृशं किं वा शास्त्रज्ञानस्य तत्फलम्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000600028, "chapter_id": 20600, "verse_number": "५-५९-२९", "content_sanskrit": "नित्यं तव पदे रक्तां त्वदुच्छिष्टभुजं हि माम् ।\nभवांस्तत्याज तत्सर्वं मम दैवं तु कारणम्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000600029, "chapter_id": 20600, "verse_number": "५-५९-३०", "content_sanskrit": "कल्याणं तव सर्वत्र भूयाद्वीरवरोत्तम ।\nअहं तावद्वने त्वां हि स्मरंती प्राणधारिका॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000600030, "chapter_id": 20600, "verse_number": "५-५९-३१", "content_sanskrit": "मनसा कर्मणा वाचा भवानेव ममोत्तमः ।\nअन्ये तुच्छीकृताः सर्वे मनसा रघुवंशज॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000600031, "chapter_id": 20600, "verse_number": "५-५९-३२", "content_sanskrit": "भवेभवे भवानेव पतिर्भूयान्महीश्वर ।\nत्वत्पदस्मरणानेक हतपापा सतीश्वरी॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000600032, "chapter_id": 20600, "verse_number": "५-५९-३३", "content_sanskrit": "श्वश्रूजनं ब्रूहि सर्वं मत्संदेशं रघूत्तम ।\nत्यक्ता वने महाघोरे रामेण निरघा सती॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000600033, "chapter_id": 20600, "verse_number": "५-५९-३४", "content_sanskrit": "स्मरामि चरणौ युष्मद्वने मृगगणैर्युते ।\nअंतर्वत्नी वने त्यक्ता रामेण सुमहात्मना॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000600034, "chapter_id": 20600, "verse_number": "५-५९-३५", "content_sanskrit": "सौमित्रे शृणु मद्वाक्यं भद्रं भूयाद्रघूत्तमे ।\nइदानीं संत्यजे प्राणान्रामवीर्यं सुरक्षती॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000600035, "chapter_id": 20600, "verse_number": "५-५९-३६", "content_sanskrit": "त्वं रामवचनं तथ्यं यत्करोषि शुभं तव ।\nपरतंत्त्रेण तत्कार्यं रामपादाब्जसेविना॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000600036, "chapter_id": 20600, "verse_number": "५-५९-३७", "content_sanskrit": "गच्छ त्वं राम सविधे शिवाः पंथान एव ते ।\nममोपरि कृपा कार्या स्मर्तव्याहं कदा कदा॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000600037, "chapter_id": 20600, "verse_number": "५-५९-३८", "content_sanskrit": "इत्युक्त्वा मूर्च्छिता भूमौ पपात पुरतस्तदा ।\nलक्ष्मणो दुःखमापेदे वीक्ष्य मूर्च्छितजानकीम्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000600038, "chapter_id": 20600, "verse_number": "५-५९-३९", "content_sanskrit": "वीजयामास वासोग्रैः संज्ञां प्राप्तां प्रकृत्य च ।\nसौमित्रिः सांत्वयामास वचनैर्मधुरैर्मुहुः॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000600039, "chapter_id": 20600, "verse_number": "५-५९-४०", "content_sanskrit": "लक्ष्मण उवाच ।\nएष गच्छामि रामं वै गत्वा शंसामि सर्वशः ।\nसमीपे ते मुनेरस्ति वाल्मीकेराश्रमो महान्॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000600040, "chapter_id": 20600, "verse_number": "५-५९-४१", "content_sanskrit": "इत्युक्त्वा तां परिक्रम्य दुःखितो बाष्पपूरितः ।\nमुंचन्नश्रुकलां दुःखाद्ययौ रामं महीपतिम्॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000600041, "chapter_id": 20600, "verse_number": "५-५९-४२", "content_sanskrit": "जानकी देवरं यांतं वीक्ष्य विस्मितलोचना ।\nहसत्ययं महाभागो लक्ष्मणो देवरो मम॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000600042, "chapter_id": 20600, "verse_number": "५-५९-४३", "content_sanskrit": "कथं मां प्राणतः प्रेष्ठां विपापां राघवोऽत्यजत् ।\nइति संचिंतयंती सा तमैक्षदनिमेषणा॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000600043, "chapter_id": 20600, "verse_number": "५-५९-४४", "content_sanskrit": "जाह्नवीं सर्वथोत्तीर्णां ज्ञात्वा सत्यं स्वहापनम् ।\nपतिता प्राणसंदेहं प्राप्ता मूर्च्छां गता तदा॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000600044, "chapter_id": 20600, "verse_number": "५-५९-४५", "content_sanskrit": "तदा हंसाः स्वपक्षाभ्यां जलमानीय सर्वतः ।\nसिषिचुर्मधुरो वायुर्ववौ पुष्पसुगंधिमान्॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000600045, "chapter_id": 20600, "verse_number": "५-५९-४६", "content_sanskrit": "करिणः पुष्करैः स्वीयैर्जलपूर्णैः समंततः ।\nव्याप्तं शरीरं रजसा क्षालयंत इवागताः॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000600046, "chapter_id": 20600, "verse_number": "५-५९-४७", "content_sanskrit": "मृगास्तदंतिकं प्राप्य संतस्थुर्विस्मितेक्षणाः ।\nनगाः पुष्पयुता आसंस्तत्कालं मधुना विना॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000600047, "chapter_id": 20600, "verse_number": "५-५९-४८", "content_sanskrit": "एतस्मिन्समये वृत्ते संज्ञां प्राप्य तदा सती ।\nविललाप सुदुःखार्ता रामरामेति जल्पती॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000600048, "chapter_id": 20600, "verse_number": "५-५९-४९", "content_sanskrit": "हा नाथ दीनबंधो हे करुणामयसंनिधे ।\nअपराधादृते मां त्वं कथं त्यजसि वै वने॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000600049, "chapter_id": 20600, "verse_number": "५-५९-५०", "content_sanskrit": "इत्येवमादिभाषंती विलपंती मुहुर्मुहुः ।\nइतस्ततः प्रपश्यंती संमूर्च्छंती पुनःपुनः॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000600050, "chapter_id": 20600, "verse_number": "५-५९-५१", "content_sanskrit": "तदा स्वशिष्यैर्भगवान्वाल्मीकिः संगतो वनम् ।\nशुश्राव रुदितं तत्र करुणास्वरभाषितम्॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000600051, "chapter_id": 20600, "verse_number": "५-५९-५२", "content_sanskrit": "शिष्यान्प्रति जगादाथ पश्यंतु वनमध्यतः ।\nको रोदिति महाघोरे विपिने दुःखितस्वरः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000600052, "chapter_id": 20600, "verse_number": "५-५९-५३", "content_sanskrit": "ते प्रयुक्ताश्च मुनिना संजग्मुर्यत्र जानकी ।\nरामरामेति भाषंती बाष्पपूरपरिप्लुता॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000600053, "chapter_id": 20600, "verse_number": "५-५९-५४", "content_sanskrit": "तां दृष्ट्वा स्त्रियमौत्सुक्याद्वाल्मीकिं प्रत्यगुर्मुनिम् ।\nश्रुत्वा तदीरितं वाक्यं जगामासौ ततो मुनिः॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000600054, "chapter_id": 20600, "verse_number": "५-५९-५५", "content_sanskrit": "दृष्ट्वा तं तपसां राशिं जानकी पतिदेवता ।\nनमोस्तु मुनये वेदमूर्तये व्रतवार्धये॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000600055, "chapter_id": 20600, "verse_number": "५-५९-५६", "content_sanskrit": "इत्युक्तवंतीं तां सीतामाशीर्भिरभ्यनंदयत् ।\nभर्त्रा सह चिरंजीव पुत्रौ प्राप्नुहि शोभनौ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000600056, "chapter_id": 20600, "verse_number": "५-५९-५७", "content_sanskrit": "कासि त्वं किं वने घोरे संगतासि किमीदृशी ।\nसर्वं मे शंस जानीयां तव दुःखस्य कारणम्॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000600057, "chapter_id": 20600, "verse_number": "५-५९-५८", "content_sanskrit": "सा तदा प्रत्युवाचेमं रामस्य महिला मुनिम् ।\nनिःश्वसंती करुणया गिरासंजातवेपथुः॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000600058, "chapter_id": 20600, "verse_number": "५-५९-५९", "content_sanskrit": "शृणु मे वाक्यमर्थोक्तं सर्वदुःखस्य कारणम् ।\nजानीहि मां भूमिपते रघुनाथस्य सेवकीम्॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000600059, "chapter_id": 20600, "verse_number": "५-५९-६०", "content_sanskrit": "अपराधं विना त्यक्ता न जाने तत्र कारणम् ।\nलक्ष्मणो मां विमुच्यात्र गतवान्राघवाज्ञया॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000600060, "chapter_id": 20600, "verse_number": "५-५९-६१", "content_sanskrit": "इत्युक्त्वाश्रुकलापूर्णं बिभ्रतीं मुखपंकजम् ।\nवाल्मीकिः सांत्वयन्प्राह जानकीं कमलेक्षणाम्॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000600061, "chapter_id": 20600, "verse_number": "५-५९-६२", "content_sanskrit": "वाल्मीकिं मां विजानीहि पितुस्तव गुरुं मुनिम् ।\nदुःखं मा कुरु वैदेहि ह्यागच्छ मम चाश्रमम्॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000600062, "chapter_id": 20600, "verse_number": "५-५९-६३", "content_sanskrit": "भिन्नस्थाने पितुर्गेहं जानीहि पतिदेवते ।\nईदृशे कर्मणि मम रोषोस्त्वेव महीपतेः॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000600063, "chapter_id": 20600, "verse_number": "५-५९-६४", "content_sanskrit": "एवं वचः समाकर्ण्य जानकी पतिदेवता ।\nदुःखपूर्णाश्रुवदना किंचित्सुखमवाप सा॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000600064, "chapter_id": 20600, "verse_number": "५-५९-६५", "content_sanskrit": "शेष उवाच ।\nवाल्मीकिः सांत्वयित्वैनां दुःखपूराकुलेक्षणाम् ।\nनिनाय स्वाश्रमं पुण्यं तापसीवृन्दपूरितम्॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000600065, "chapter_id": 20600, "verse_number": "५-५९-६६", "content_sanskrit": "सा गच्छंती पृष्ठतोऽस्य वाल्मीकेस्तपसां निधेः ।\nरराजेंदोः पृष्ठतो वै तारकेव मनोहरा॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000600066, "chapter_id": 20600, "verse_number": "५-५९-६७", "content_sanskrit": "वाल्मीकिः प्राप्य च स्वीयमाश्रमं मुनिपूरितम् ।\nतापसीः प्रतिसंचख्यौ जानकीं स्वाश्रमं गताम्॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000600067, "chapter_id": 20600, "verse_number": "५-५९-६८", "content_sanskrit": "वैदेही तापसीः सर्वा नमश्चक्रे महामनाः ।\nपरस्परं प्रहृषिताः परिरंभं समाचरन्॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000600068, "chapter_id": 20600, "verse_number": "५-५९-६९", "content_sanskrit": "वाल्मीकिर्निजशिष्यान्स प्रत्युवाच तपोनिधिः ।\nरच्यतां बत जानक्याः पर्णशाला मनोरमा॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000600069, "chapter_id": 20600, "verse_number": "५-५९-७०", "content_sanskrit": "इत्युक्तं वाक्यमाकर्ण्य वाल्मीकेः सुमनोरमम् ।\nव्यरचन्पत्रकैः शालां दारुभिः सुमनोहराम्॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000600070, "chapter_id": 20600, "verse_number": "५-५९-७१", "content_sanskrit": "तत्रावसद्धि वैदेही पतिव्रतपरायणा ।\nवाल्मीकेः परिचर्यां च कुर्वंती फलभक्षिका॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000600071, "chapter_id": 20600, "verse_number": "५-५९-७२", "content_sanskrit": "जपंती रामरामेति मनसा वचसा स्वयम् ।\nनिनाय दिवसांस्तत्र जानकी पतिदेवता॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000600072, "chapter_id": 20600, "verse_number": "५-५९-७३", "content_sanskrit": "काले सासूत पूत्रौ द्वौ मनोहरवपुर्धरौ ।\nरामचंद्र प्रतिनिधी ह्यश्विनाविव जानकी॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000600073, "chapter_id": 20600, "verse_number": "५-५९-७४", "content_sanskrit": "तच्छ्रुत्वा तु मुनिर्हृष्टो जानक्याः पुत्रसंभवम् ।\nचकार जातकर्मादि संस्कारान्मंत्रवित्तमः॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000600074, "chapter_id": 20600, "verse_number": "५-५९-७५", "content_sanskrit": "कुशैर्लवैश्च वाल्मीकिर्मुनिः कर्माणि चाचरत् ।\nतन्नाम्ना पुत्रयोराख्या कुशो लव इति स्फुटा॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000600075, "chapter_id": 20600, "verse_number": "५-५९-७६", "content_sanskrit": "वाल्मीकिर्यत्र विरजा मंगलं तद्यथाचरत् ।\nअत्यंतं हृष्टचित्ता सा बभूव कमलेक्षणा॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000600076, "chapter_id": 20600, "verse_number": "५-५९-७७", "content_sanskrit": "तद्दिने लवणं हत्वा शत्रुघ्नः स्वल्पसैनिकः ।\nआगमच्चाश्रमे चास्य वाल्मीकेर्निशि शोभने॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000600077, "chapter_id": 20600, "verse_number": "५-५९-७८", "content_sanskrit": "तदा वाल्मीकिना शिष्टः शत्रुघ्नो रघुनायकम् ।\nमा शंस जानकीपुत्रौ कथयिष्याम्यहं पुरः॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000600078, "chapter_id": 20600, "verse_number": "५-५९-७९", "content_sanskrit": "जानकीपुत्रकौ तत्र ववृधाते मनोरमौ ।\nकंदमूलफलैः पुष्टौ व्यदधादुन्मदौ वरौ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000600079, "chapter_id": 20600, "verse_number": "५-५९-८०", "content_sanskrit": "शुक्लप्रतिपदायाश्च शशीव सुमनोहरौ ।\nकालेन संस्कृतौ जातावुपनीतौ मनोहरौ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000600080, "chapter_id": 20600, "verse_number": "५-५९-८१", "content_sanskrit": "उपनीयमुनिर्वेदं सांगमध्यापयत्सुतौ ।\nसरहस्यं धनुर्वेदं रामायणमपाठयत्॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000600081, "chapter_id": 20600, "verse_number": "५-५९-८२", "content_sanskrit": "वाल्मीकिना च धनुषी दत्ते स्वर्णसुभूषिते ।\nअभेद्ये सगुणे श्रेष्ठे वैरिवृंदविदारणे॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000600082, "chapter_id": 20600, "verse_number": "५-५९-८३", "content_sanskrit": "इषुधी बाणसंपूर्णौ अक्षये करवालके ।\nचर्माण्यभेद्यानि ददौ जानक्यात्मजयोस्तदा॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000600083, "chapter_id": 20600, "verse_number": "५-५९-८४", "content_sanskrit": "धनुर्धरौ धनुर्वेदपारगावाश्रमे मुदा ।\nचरंतौ तत्र रेजाते अश्विनाविव शोभनौ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000600084, "chapter_id": 20600, "verse_number": "५-५९-८५", "content_sanskrit": "जानकी वीक्ष्य पुत्रौ द्वौ खड्गचर्मधरौ वरौ ।\nपरमं हर्षमापन्ना विरहोद्भवमत्यजत्॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000600085, "chapter_id": 20600, "verse_number": "५-५९-८६", "content_sanskrit": "एष ते कथितो विप्र जानक्याः पुत्रसंभवः ।\nअतः शृणुष्व यद्वृत्तं वीरबाहुविकृंतनम्॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}]