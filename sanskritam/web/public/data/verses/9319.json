[{"id": 5000319000, "chapter_id": 9319, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे सप्तचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000319001, "chapter_id": 9319, "verse_number": "४-४७-१", "content_sanskrit": "दर्शनार्थं तु वैदेह्याः सर्वतः कपिकुञ्जराः।\nव्यादिष्टाः कपिराजेन यथोक्तं जग्मुरञ्जसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000319002, "chapter_id": 9319, "verse_number": "४-४७-२", "content_sanskrit": "ते सरांसि सरित्कक्षानाकाशं नगराणि च।\nनदीदुर्गांस्तथा देशान् विचिन्वन्ति समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000319003, "chapter_id": 9319, "verse_number": "४-४७-३", "content_sanskrit": "सुग्रीवेण समाख्याताः सर्वे वानरयूथपाः।\nतत्र देशान् विचिन्वन्ति सशैलवनकाननान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000319004, "chapter_id": 9319, "verse_number": "४-४७-४", "content_sanskrit": "विचित्य दिवसं सर्वे सीताधिगमने धृताः।\nसमायान्ति स्म मेदिन्यां निशाकालेषु वानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000319005, "chapter_id": 9319, "verse_number": "४-४७-५", "content_sanskrit": "सर्वर्तुकांश्च देशेषु वानराः सफलद्रुमान्।\nआसाद्य रजनीं शय्यां चक्रुः सर्वेष्वहःसु ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000319006, "chapter_id": 9319, "verse_number": "४-४७-६", "content_sanskrit": "तदहः प्रथमं कृत्वा मासे प्रस्रवणं गताः।\nकपिराजेन संगम्य निराशाः कपिकुञ्जराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000319007, "chapter_id": 9319, "verse_number": "४-४७-७", "content_sanskrit": "विचित्य तु दिशं पूर्वां यथोक्तां सचिवैः सह।\nअदृष्ट्वा विनतः सीतामाजगाम महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000319008, "chapter_id": 9319, "verse_number": "४-४७-८", "content_sanskrit": "दिशमप्युत्तरां सर्वां विविच्य स महाकपिः।\nआगतः सह सैन्येन भीतः शतबलिस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000319009, "chapter_id": 9319, "verse_number": "४-४७-९", "content_sanskrit": "सुषेणः पश्चिमामाशां विविच्य सह वानरैः।\nसमेत्य मासे पूर्णे तु सुग्रीवमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000319010, "chapter_id": 9319, "verse_number": "४-४७-१०", "content_sanskrit": "तं प्रस्रवणपृष्ठस्थं समासाद्याभिवाद्य च।\nआसीनं सह रामेण सुग्रीवमिदमब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000319011, "chapter_id": 9319, "verse_number": "४-४७-११", "content_sanskrit": "विचिताः पर्वताः सर्वे वनानि गहनानि च।\nनिम्नगाः सागरान्ताश्च सर्वे जनपदाश्च ये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000319012, "chapter_id": 9319, "verse_number": "४-४७-१२", "content_sanskrit": "गुहाश्च विचिताः सर्वा याश्च ते परिकीर्तिताः।\nविचिताश्च महागुल्मा लताविततसंतताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000319013, "chapter_id": 9319, "verse_number": "४-४७-१३", "content_sanskrit": "गहनेषु च देशेषु दुर्गेषु विषमेषु च।\nसत्त्वान्यतिप्रमाणानि विचितानि हतानि च।\nये चैव गहना देशा विचितास्ते पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000319014, "chapter_id": 9319, "verse_number": "४-४७-१४", "content_sanskrit": "उदारसत्त्वाभिजनो हनूमान्\nस मैथिलीं ज्ञास्यति वानरेन्द्र।\nदिशं तु यामेव गता तु सीता\nतामास्थितो वायुसुतो हनूमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000319015, "chapter_id": 9319, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे सप्तचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]