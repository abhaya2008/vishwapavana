[{"id": 40019704, "chapter_id": 9319, "verse_number": "1", "content_sanskrit": "शिरस्यञ्जलिमाधायकैकेय्यानन्दवर्धनः । बभाषेभरतोज्येष्ठंरामंसत्यपराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40019705, "chapter_id": 9319, "verse_number": "2", "content_sanskrit": "पूजितामामिकामातादत्तंराज्यमिदंमम । तद्ददामिपुनस्तुभ्यंयथात्वमददामम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40019706, "chapter_id": 9319, "verse_number": "3", "content_sanskrit": "धुरमेकाकिनान्यस्तांवृषभेणबलीयसा । किशोरवद्गुरुंभारं न वोढुमहमुत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40019707, "chapter_id": 9319, "verse_number": "4", "content_sanskrit": "वारिवेगेनमहताभिन्नस्सेतुरिवक्षरन् । दुर्बन्धनमिदंमन्येराज्यच्छ्रिदमसम्वृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40019708, "chapter_id": 9319, "verse_number": "5", "content_sanskrit": "गतिंखरइवाश्वस्यहंसस्येव च वायसः । नान्वेतुमुत्सहेराम तवमार्गमरिन्दम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40019709, "chapter_id": 9319, "verse_number": "6", "content_sanskrit": "यथाचारोपितोवृक्षोजातश्चार्न्न्तिवेशने । महांश्चसुदुरारोहोमहास्कन्दःप्रशाखवान् ॥ शीर्येतपुष्पितोभूत्वा न फलानिप्रदर्शयन् । तस्यनानुभवेदर्थंयस्यहेतोस्सरोपितः ॥ एषोपमामहाबाहोत्वमर्थंवेत्तुमर्हसि । यद्यस्मान्मनुजेन्द्रत्वंभर्ताभृत्यान्नशाधिहि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40019710, "chapter_id": 9319, "verse_number": "7", "content_sanskrit": "यथाचारोपितोवृक्षोजातश्चार्न्न्तिवेशने । महांश्चसुदुरारोहोमहास्कन्दःप्रशाखवान् ॥ शीर्येतपुष्पितोभूत्वा न फलानिप्रदर्शयन् । तस्यनानुभवेदर्थंयस्यहेतोस्सरोपितः ॥ एषोपमामहाबाहोत्वमर्थंवेत्तुमर्हसि । यद्यस्मान्मनुजेन्द्रत्वंभर्ताभृत्यान्नशाधिहि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40019711, "chapter_id": 9319, "verse_number": "8", "content_sanskrit": "यथाचारोपितोवृक्षोजातश्चार्न्न्तिवेशने । महांश्चसुदुरारोहोमहास्कन्दःप्रशाखवान् ॥ शीर्येतपुष्पितोभूत्वा न फलानिप्रदर्शयन् । तस्यनानुभवेदर्थंयस्यहेतोस्सरोपितः ॥ एषोपमामहाबाहोत्वमर्थंवेत्तुमर्हसि । यद्यस्मान्मनुजेन्द्रत्वंभर्ताभृत्यान्नशाधिहि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40019712, "chapter_id": 9319, "verse_number": "9", "content_sanskrit": "जगदद्याभिषिक्तंत्वामनुपश्यतुराघव । प्रतपन्तमिवादित्यंमध्याह्नेदीप्ततेजसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40019713, "chapter_id": 9319, "verse_number": "10", "content_sanskrit": "तूर्यसङ्घान्तिर्घोषैःकाञ्चीनूपुरनिःस्वनैः । मधुरैर्गीतशब्दैश्चप्रतिबुध्यस्वशेष्व च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40019714, "chapter_id": 9319, "verse_number": "11", "content_sanskrit": "यावदावर्ततेचक्रंयावती च वसुन्धरा । तावत्त्वमिहलोकस्यस्वामित्वमनुवर्तय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40019715, "chapter_id": 9319, "verse_number": "12", "content_sanskrit": "भरतस्यवच्श्रुत्वारामःपरपुरञ्जयः । तथेतिप्रतिजग्राहनिषसादासनेशुभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40019716, "chapter_id": 9319, "verse_number": "13", "content_sanskrit": "ततश्शत्रुघ्नवचनान्निपुणाःश्मश्रुवर्धनाः । सुखहस्ताःसुशीघ्राश्चराघवंपर्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40019717, "chapter_id": 9319, "verse_number": "14", "content_sanskrit": "पूर्वंतुभरतेस्नातेलक्ष्मणे च महाबले । सुग्रीवेवानरेन्द्रे च राक्षसेन्द्रेविभीषणे ॥ विशोधितजटस्स्नातश्चित्रमाल्यानुलेपनः । महार्हवसनोपेतस्तस्थौतत्रश्रियाज्वलन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40019718, "chapter_id": 9319, "verse_number": "15", "content_sanskrit": "पूर्वंतुभरतेस्नातेलक्ष्मणे च महाबले । सुग्रीवेवानरेन्द्रे च राक्षसेन्द्रेविभीषणे ॥ विशोधितजटस्स्नातश्चित्रमाल्यानुलेपनः । महार्हवसनोपेतस्तस्थौतत्रश्रियाज्वलन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40019719, "chapter_id": 9319, "verse_number": "16", "content_sanskrit": "प्रतिकर्म च रामस्यकारयामासवीर्यवान । लक्ष्मणस्य च लक्ष्मीवानिक्ष्वाकुकुलवर्धनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40019720, "chapter_id": 9319, "verse_number": "17", "content_sanskrit": "प्रतिकर्मचसीतायास्सर्वादशरथस्त्रियः । आत्मनैवतदाचक्रुर्मनस्विन्योमनोहरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40019721, "chapter_id": 9319, "verse_number": "18", "content_sanskrit": "ततोवानरपत्नीनांसर्वासामेवशोभनम् । चकारयत्नात्कौसल्याप्रहृष्टापुत्रवत्सला ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40019722, "chapter_id": 9319, "verse_number": "19", "content_sanskrit": "तत: श्शत्रुघ्नवचनात्सुमन्त्रोनामसारथिः । योजयित्वाभिचक्रामरथंसर्वाङ्गशोभनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40019723, "chapter_id": 9319, "verse_number": "20", "content_sanskrit": "अर्कमण्डलसङ्काशंदिव्यंदृष्टवारथंस्थितम् । आरुरोहमहाबाहूरामःपरपुरंञ्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40019724, "chapter_id": 9319, "verse_number": "21", "content_sanskrit": "सुग्रीवोहनुमांश्चैवमहेन्द्रसदृशद्युती । स्नातौदिव्यनिभैर्वस्त्रैर्जग्मतुश्शुभकुण्डलौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40019725, "chapter_id": 9319, "verse_number": "22", "content_sanskrit": "सर्वाभरणजुष्टाश्चयुयुस्तश्शुभकुण्डलाः । सुग्रीवपत्नयःसीता च द्रष्टुंनगरमुत्सुकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40019726, "chapter_id": 9319, "verse_number": "23", "content_sanskrit": "अयोध्यायांतुसचिवाराज्ञोदशरथस्य च । पुरोहितंपुरस्कृत्यमन्त्रयामासुरर्थवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40019727, "chapter_id": 9319, "verse_number": "24", "content_sanskrit": "अशोकोविजयश्चैवसिद्धार्थश्चसमाहिताः । मन्त्रयन्रामवृध्यर्थंबुध्यर्थंनगरस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40019728, "chapter_id": 9319, "verse_number": "25", "content_sanskrit": "सर्वमेवाभिषेकार्थंजयार्हस्यमहात्मनः । कर्तुमर्हथरामस्ययद्यन्मङ्गलपूर्वकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40019729, "chapter_id": 9319, "verse_number": "26", "content_sanskrit": "इतितेमन्त्रिणस्सर्वेसन्दिश्य च पुरोहितम् । नगरान्निर्ययुस्तूर्णंरामदर्शनबुद्धयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40019730, "chapter_id": 9319, "verse_number": "27", "content_sanskrit": "हरियुक्तंसहस्राक्षोरथमिन्द्रइवानघः । प्रययौरथमास्थायरामोनगरमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40019731, "chapter_id": 9319, "verse_number": "28", "content_sanskrit": "जग्राहभरतोरमशीन्शत्रुघ्नश्चत्रमाददे । लक्ष्मणोव्यजनंतस्यमूर्ध्निसम्पर्यवीजयत् ॥ श्वेतं च वालव्यजनंजगृहेपरितस्स्थितः । अपरंचन्द्रसङ्काशंराक्षसेन्द्रोविभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40019732, "chapter_id": 9319, "verse_number": "29", "content_sanskrit": "जग्राहभरतोरमशीन्शत्रुघ्नश्चत्रमाददे । लक्ष्मणोव्यजनंतस्यमूर्ध्निसम्पर्यवीजयत् ॥ श्वेतं च वालव्यजनंजगृहेपरितस्स्थितः । अपरंचन्द्रसङ्काशंराक्षसेन्द्रोविभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40019733, "chapter_id": 9319, "verse_number": "30", "content_sanskrit": "ऋषिसङ्घैस्तदाकाशेदेवैश्चसमरुद्गणैः । स्तूयमास्यरामस्यशुश्रुवमधुरध्वनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40019734, "chapter_id": 9319, "verse_number": "31", "content_sanskrit": "ततःशत्रुञ्जयंनामकुञ्जरंपर्वतोपमम् । आरुरोहमहातेजास्सुग्रीवःप्लवगर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40019735, "chapter_id": 9319, "verse_number": "32", "content_sanskrit": "नवनागसहस्राणिययुरास्थायवानराः । मानुषंविग्रहंकृत्वासर्वाभरणभूषिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40019736, "chapter_id": 9319, "verse_number": "33", "content_sanskrit": "शङ्खशब्दप्रणादैश्चदुन्दुभीनां च निस्स्वनैः । प्रययौपुरुषव्याघ्रस्तांपुरींहर्म्यमालिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40019737, "chapter_id": 9319, "verse_number": "34", "content_sanskrit": "ददृशुस्तेसमायान्तंराघवंसपुरस्सरम् । विराजमानंवपुषारथेनातिरथंतदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40019738, "chapter_id": 9319, "verse_number": "35", "content_sanskrit": "तेवर्थयित्वाकाकुत्स्थंरामेणप्रतिनन्दिताः । अनुजग्मुर्महात्मानंभ्रातृभिःपरिवारितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40019739, "chapter_id": 9319, "verse_number": "36", "content_sanskrit": "अमात्यैर्ब्राह्मणैश्चैवतथाप्रकृतिभिर्ववृतः । श्रियाविरुरुचेरामोनक्षत्ररिवचन्द्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40019740, "chapter_id": 9319, "verse_number": "37", "content_sanskrit": "स पुरोगामिभिस्तूर्यैस्तालस्वस्तिकपाणिभिः । प्रव्याहरद्भिर्मुदितैर्मङ्गलानिवृतोययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40019741, "chapter_id": 9319, "verse_number": "38", "content_sanskrit": "अक्षतंजातरूपं च गावःकन्यास्सहद्विजाः । नरामोदकहस्ताश्चरामस्यपुरतोययुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40019742, "chapter_id": 9319, "verse_number": "39", "content_sanskrit": "सख्यं च रामस्सुग्रीवेप्रभावंचानिलात्मजे । वानराणां च तत्कर्मह्याचचक्षेऽऽथमन्त्रिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40019743, "chapter_id": 9319, "verse_number": "40", "content_sanskrit": "श्रुत्वा च विस्मयंजग्मुरयोध्यापुरवासिनः । वानराणां च ततकर्मराक्षसानां च तद्बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40019744, "chapter_id": 9319, "verse_number": "41", "content_sanskrit": "विभीषणस्यसम्योगमाचचक्षेऽथमन्त्रिणाम् । द्युतिमानेतदाख्यायरामोवानरसम्युतः ॥ हृष्टपुष्टजनाकीर्णमयोध्यांप्रविवेशसः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40019745, "chapter_id": 9319, "verse_number": "42", "content_sanskrit": "ततोह्यभ्युच्छ्रयन्पौराःपताकाश्चगृहेगृहे ॥ ऐक्ष्वाकुध्युषितंरम्यमाससादपितुर्गृहम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40019746, "chapter_id": 9319, "verse_number": "43", "content_sanskrit": "अथाब्रवीद्राजपुत्रोभरतंधर्मिणांवरम् ॥ अर्धोपहितयावाचामधुरंरघुनन्दनः । पितुर्भवनमासाद्यप्रविश्य च महात्मनः ॥ कौसल्यां च सुमित्रां च कैकेयीमभिवाद्य च ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40019747, "chapter_id": 9319, "verse_number": "44", "content_sanskrit": "अथाब्रवीद्राजपुत्रोभरतंधर्मिणांवरम् ॥ अर्धोपहितयावाचामधुरंरघुनन्दनः । पितुर्भवनमासाद्यप्रविश्य च महात्मनः ॥ कौसल्यां च सुमित्रां च कैकेयीमभिवाद्य च ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40019748, "chapter_id": 9319, "verse_number": "45", "content_sanskrit": "यच्छमद्भवनंश्रेष्ठंसाशोकवनिकंमहत् ॥ मुक्तावैदूर्यसङ्कीर्णंसुग्रीवायनिवेदय ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 40019749, "chapter_id": 9319, "verse_number": "46", "content_sanskrit": "तस्यतद्वचनंश्रुत्वाभरतस्सत्यविक्रमः ॥ हस्तेगृहीत्वासुग्रीवंप्रविवेशतमालयम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 40019750, "chapter_id": 9319, "verse_number": "47", "content_sanskrit": "तत: स्स्सैलप्रदीपांश्चपर्यङ्कास्तरणानि च ॥ गृहीत्वाविविशुःक्षिप्रंशत्रुघ्नेप्रचोदिताः ।", "padac