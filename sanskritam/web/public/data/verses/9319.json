h": "", "audio_url": null, "display_order": 95}, {"id": 40019799, "chapter_id": 9319, "verse_number": "96", "content_sanskrit": "राज्यंदशसहस्राणिप्राप्यवर्षाणिराघवः । शताश्वमेधानाजह्रेसदश्वान् भूरिदक्षिणान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 40019800, "chapter_id": 9319, "verse_number": "97", "content_sanskrit": "आजानुलम्बिबाहुस्समहावक्षाःप्रतापवान् । लक्ष्मणानुचरोरामःशशासपृथिवीमिमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 40019801, "chapter_id": 9319, "verse_number": "98", "content_sanskrit": "राघवश्चापिधर्मात्माप्राप्यराज्यमनुत्तमम् । ईजेबहुविधैर्यज्ञैससुतभ्रातृबान्धवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 40019802, "chapter_id": 9319, "verse_number": "99", "content_sanskrit": "स पर्यदेवन्विधवा न च व्यालकृतंभयम् । न व्याधिजंभयंचासीद्रामेराज्यंप्रशासति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 40019803, "chapter_id": 9319, "verse_number": "100", "content_sanskrit": "निर्दस्युरभवल्लोकोनानर्थंकश्चिदस्पृशत् । न च स्मवृद्धाबालानांप्रेतकार्याणिकुर्वते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 40019804, "chapter_id": 9319, "verse_number": "101", "content_sanskrit": "सर्वंमुदितमेवासीत्सर्वोधर्मपरोऽभवत् । राममेवानुपश्यन्तोनाभ्यहिंसन् परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 40019805, "chapter_id": 9319, "verse_number": "102", "content_sanskrit": "आसन्वर्षसहस्राणितथापुत्रसहस्रिणः । निरामयाविशोकाश्चरामेराज्यंप्रशासति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 40019806, "chapter_id": 9319, "verse_number": "103", "content_sanskrit": "रामोरामोराम: इतिप्रजानामभवन्कथाः । रामभूतंजगदभूद्रामेराज्यंप्रशासति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 40019807, "chapter_id": 9319, "verse_number": "104", "content_sanskrit": "नित्यपुष्पानित्यफलान्तरवस्तत्रनिर्व्रणाः । कामवर्षी च पर्जन्यस्सुखस्पर्शश्चमारुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 40019808, "chapter_id": 9319, "verse_number": "105", "content_sanskrit": "ब्राह्मणाःक्षत्रियावैश्याश्शूद्रालोभविवर्जिताः । स्वकर्मसुप्रवर्तन्तेतुष्टास्स्वैरेवकर्मभिः ॥ आसन्प्रजाधर्मपरारामेशासतिनानृताः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 40019809, "chapter_id": 9319, "verse_number": "106", "content_sanskrit": "सर्वेलक्षणसम्पन्नास्सर्वेधर्मपरायणाः ॥ दशवर्षसहस्राणिदशवर्षशतानि च भ्रातृभि: सहितःश्रीमानरामोराज्यमकारयत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 40019810, "chapter_id": 9319, "verse_number": "107", "content_sanskrit": "धन्यंयशस्यमायुष्यंराज्ञां च वियावहम् ॥ आदिकाव्यमिदंचार्षंपुरावाल्मीकिनाकृतम् । पठेध्यःशृणुयाल्लोकेनरःपापात्प्रमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 40019811, "chapter_id": 9319, "verse_number": "108", "content_sanskrit": "धन्यंयशस्यमायुष्यंराज्ञां च वियावहम् ॥ आदिकाव्यमिदंचार्षंपुरावाल्मीकिनाकृतम् । पठेध्यःशृणुयाल्लोकेनरःपापात्प्रमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 40019812, "chapter_id": 9319, "verse_number": "109", "content_sanskrit": "पुत्रकामश्चपुत्रान्वैधनकामोधनानि च । लभतेमनुजोलोकेश्रुत्वारामाभिषेचनम् ॥ महींविजयतेराजारिपूंश्चाप्यधितिष्ठति ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 40019813, "chapter_id": 9319, "verse_number": "110", "content_sanskrit": "राघवेणयथामातासुमित्रालक्ष्मणेन च ॥ भरतेन च कैकेयीजीवपुत्रास्तथास्त्रियः । भविष्यन्तिसदानन्दाःपुत्रपौत्रसमन्विताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 40019814, "chapter_id": 9319, "verse_number": "111", "content_sanskrit": "राघवेणयथामातासुमित्रालक्ष्मणेन च ॥ भरतेन च कैकेयीजीवपुत्रास्तथास्त्रियः । भविष्यन्तिसदानन्दाःपुत्रपौत्रसमन्विताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 40019815, "chapter_id": 9319, "verse_number": "112", "content_sanskrit": "श्रुत्वारामायणमिदंदीर्घमायुश्चविन्दति । रामस्यविजयंचैवसर्वमक्लिष्टकर्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 40019816, "chapter_id": 9319, "verse_number": "113", "content_sanskrit": "शृणोति य इदंकाव्यंपुरावाल्मीकिनाकृतम् । श्रद्धधानोजितक्रोधोदुर्गाण्यतितरत्यसौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 40019817, "chapter_id": 9319, "verse_number": "114", "content_sanskrit": "समागम्यप्रवासान्तेरमन्तेसहबान्धवैः । शृण्वन्ति य इदंकाव्यंपुरावाल्मीकिनाकृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 40019818, "chapter_id": 9319, "verse_number": "115", "content_sanskrit": "तेप्रार्थितान्वरान्सर्वान्प्राप्नुवन्तीहराघवात् । श्रवणेनसुरास्सर्वेप्रीयन्तेसम्प्रशृण्वताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 40019819, "chapter_id": 9319, "verse_number": "116", "content_sanskrit": "विनायकाश्चशाम्यन्तिगृहेतिष्ठन्तियस्यवै । विजयेतमहींराजाप्रवासीस्वस्तिमान्भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 40019820, "chapter_id": 9319, "verse_number": "117", "content_sanskrit": "स्त्रियोरजस्वला्श्रुत्वापुत्रान्सूयुरनुत्तमान् । पूजयंश्चपठंश्चैवमितिहासंपुरातनम् ॥ सर्वपापैःप्रमुच्येतदीर्घमायुरवाप्नुयात् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 40019821, "chapter_id": 9319, "verse_number": "118", "content_sanskrit": "प्रणम्यशिरसानित्यंश्रोतव्यंक्षत्रियैर्द्विजात् ॥ ऐश्वर्यंपुत्रलाभाश्चभविष्यति न संशयः । रामायणमिदंकृत्स्नंशृण्वतःपठतस्सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 40019822, "chapter_id": 9319, "verse_number": "119", "content_sanskrit": "प्रणम्यशिरसानित्यंश्रोतव्यंक्षत्रियैर्द्विजात् ॥ ऐश्वर्यंपुत्रलाभाश्चभविष्यति न संशयः । रामायणमिदंकृत्स्नंशृण्वतःपठतस्सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 40019823, "chapter_id": 9319, "verse_number": "120", "content_sanskrit": "प्रीयतेसततंरामस्सहिविष्णुस्सनातनः । आदिदेवोमहाबाहुर्हरिन्नारायणःप्रभुः ॥ साक्षाद्रामोरघुश्रेष्ठश्शेषोलक्ष्मणउच्यते ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 40019824, "chapter_id": 9319, "verse_number": "121", "content_sanskrit": "एवमेतत्पुरावृत्तमाख्यानंभद्रमस्तुवः ॥ प्रव्याहरतविस्रब्धंबलंविष्णोःप्रवर्थताम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 40019825, "chapter_id": 9319, "verse_number": "122", "content_sanskrit": "देवाश्चसर्वेतुष्यन्तिग्रहणाच्छ्रवणात्तथा ॥ रामायणस्यश्रवणेतुष्यन्तिपितस्सदा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 40019826, "chapter_id": 9319, "verse_number": "123", "content_sanskrit": "भक्त्यारामस्ययेचेमांसंसितामृषिणाकृताम् ॥ येलिखन्ती ह च नरास्तेषांवासस्त्रिविष्टपे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 40019827, "chapter_id": 9319, "verse_number": "124", "content_sanskrit": "कुटुम्बवृद्धिंधनधान्यवृद्धिंस्त्रियश्चमुख्यास्सुखमुत्तमं च । श्रुत्वाशुभंकाव्यमिदंमहार्थंप्राप्नोतिसर्वांभुविचार्थसिद्धम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}]