[{"id": 2167906, "chapter_id": 4603, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2167907, "chapter_id": 4603, "verse_number": "१", "content_sanskrit": "सहदेवं तदा क्रुद्धं निघ्नन्तं तव वाहिनीम् ।\nदुःशासनो महाराज भ्राता भ्रातरमभ्ययात्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2167908, "chapter_id": 4603, "verse_number": "२", "content_sanskrit": "तौ समेतौ महारङ्गे दृष्ट्वा तत्र नराधिपाः ।\nसिंहनादरवांश्चक्रुर्वासांस्यादुधुवुश्च ह\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2167909, "chapter_id": 4603, "verse_number": "३", "content_sanskrit": "तत्र भारत रुष्टेन तव पुत्रेण धन्विना ।\nपाण्डुपुत्रस्त्रिभिर्बाणैर्वक्षस्यभिहतो भृशम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2167910, "chapter_id": 4603, "verse_number": "४", "content_sanskrit": "सहदेवस्ततो राजन् नाराचैस्तु तवात्मजम् ।\nविव्याधोरसि सप्तत्या सारथिं चेषुभिस्त्रिभिः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2167911, "chapter_id": 4603, "verse_number": "५", "content_sanskrit": "दुःशासनस्ततश्चापं छित्त्वा राजन् महाहवे ।\nसहदेवं त्रिसप्तत्या बाह्वोरुरसि चार्पयत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2167912, "chapter_id": 4603, "verse_number": "६", "content_sanskrit": "सहदेवस्ततः क्रुद्धः खड्गमुद्यम्य मारिष ।\nआविध्य व्यसृजत् तूर्णं तव पुत्ररथं प्रति\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2167913, "chapter_id": 4603, "verse_number": "७", "content_sanskrit": "समार्गणगुणं चापं द्विधा कृत्वा महानसिः ।\nनिपपात ततो भूमौ च्युतः सर्प इवाम्बरात्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2167914, "chapter_id": 4603, "verse_number": "८", "content_sanskrit": "अथान्यद्धनुरादाय माद्रेयः क्रोधमूर्छितः ।\nदुःशासनाय चिक्षेप बाणमन्तकरं परम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2167915, "chapter_id": 4603, "verse_number": "९", "content_sanskrit": "तमापतन्तं वेगेन यमदण्डमिवापरम् ।\nखड्गेन शितधारेण द्विधा चिच्छेद कौरवः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2167916, "chapter_id": 4603, "verse_number": "१०", "content_sanskrit": "ततस्तं निशितं खड्गं प्राविध्यत् तस्य सत्वरम् ।\nधनुश्चान्यत् समादाय शरं जग्राह वीर्यवान्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2167917, "chapter_id": 4603, "verse_number": "११", "content_sanskrit": "तमापतन्तं वेगेन निस्त्रिंशं निशितैः शरैः ।\nसमरेऽपातयद् धृष्टः सहदेवो हसन्निव\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2167918, "chapter_id": 4603, "verse_number": "१२", "content_sanskrit": "ततो बाणांश्चतुष्षष्टिं तव पुत्रो महारथः ।\nसहदेवरथे तूर्णं प्रेषयामास भारत\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2167919, "chapter_id": 4603, "verse_number": "१३", "content_sanskrit": "शरानापततस्तूर्णं समरे तान् सुवेगिनः ।\nएकैकं पञ्चभिर्बाणैर्माद्रेयस्तु समाच्छिनत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2167920, "chapter_id": 4603, "verse_number": "१४", "content_sanskrit": "तान् निवार्य ततो बाणैः सहदेवः प्रतापवान् ।\nशतसङ्ख्यांस्ततो बाणान् प्रेषयामास संयुगे\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2167921, "chapter_id": 4603, "verse_number": "१५", "content_sanskrit": "तान् बाणांस्तव पुत्रोऽपि छित्त्वैकैकं त्रिभिस्त्रिभिः ।\nननाद सुमहानादं नादयानो वसुन्धराम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2167922, "chapter_id": 4603, "verse_number": "१६", "content_sanskrit": "ततो दुःशासनो राजन् द्वाभ्यां पाण्डुसुतं रणे ।\nसारथिं नवभिर्बाणैर्माद्रेयस्य समाचिनोत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2167923, "chapter_id": 4603, "verse_number": "१७", "content_sanskrit": "ततः क्रुद्धो महाराज सहदेवः प्रतापवान् ।\nसमधत्त शरं घोरं मृत्युकालान्तकोपमम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2167924, "chapter_id": 4603, "verse_number": "१८", "content_sanskrit": "विकृष्य बलवच्चापं तव पुत्राय सोऽसृजत्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2167925, "chapter_id": 4603, "verse_number": "१९", "content_sanskrit": "स तं निर्भिद्य वेगेन भित्त्वा च कवचं महत् ।\nप्राविशद् धरणीं तूर्णं वल्मीकमिव पन्नगः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2167926, "chapter_id": 4603, "verse_number": "२०", "content_sanskrit": "स मुमोह ततः पुत्रस्तव राजन् महाबलः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2167927, "chapter_id": 4603, "verse_number": "२१", "content_sanskrit": "मूढं चैनं समालक्ष्य सारथिस्त्वरितो रणात् ।\nअपोवाह सुसन्त्रस्तो वध्यमानं शितैः शरैः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2167928, "chapter_id": 4603, "verse_number": "२२", "content_sanskrit": "पराजित्य रणे तं तु पाण्डवः पाण्डुपूर्वज ।\nदुर्योधनबलं बाणैः प्रामथद् वै समन्ततः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2167929, "chapter_id": 4603, "verse_number": "२३", "content_sanskrit": "पिपीलिकापुटं राजन् यथा मृद्नन् नरो रुषा ।\nतथा सा कौरवी सेना मृदिता तेन भारत\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2167930, "chapter_id": 4603, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nसहदेवयुद्धवर्णनं नाम त्रयोविंशोऽध्यायः ॥२३॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]