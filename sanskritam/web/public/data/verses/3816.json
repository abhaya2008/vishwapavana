[{"id": 2130503, "chapter_id": 3816, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2130504, "chapter_id": 3816, "verse_number": "१", "content_sanskrit": "ततस्तानि महार्हाणि दिव्यानि भरतर्षभ ।\nबहूनि बहुरूपाणि विरजांसि समाददे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2130505, "chapter_id": 3816, "verse_number": "", "content_sanskrit": "एतस्मिन्नन्तरे राजन् युधिष्ठिरसमीपतः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2130506, "chapter_id": 3816, "verse_number": "२", "content_sanskrit": "ततो वायुर्महान् शीघ्रो नीचैः शर्करकर्षणः ।\nप्रादुरासीत् खरस्पर्शः सङ्ग्राममभिचोदयन्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2130507, "chapter_id": 3816, "verse_number": "३", "content_sanskrit": "पपात महती चोल्का सनिर्घाता महाभया।\nनिष्प्रभश्चाभवत् सूर्यश्छन्नरश्मिस्तमोवृतः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2130508, "chapter_id": 3816, "verse_number": "४", "content_sanskrit": "निर्घातश्चाभवद् भीमो भीमे विक्रममास्थिते ।\nचचाल पृथिवी चापि पांसुवर्षं पपात च \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2130509, "chapter_id": 3816, "verse_number": "५", "content_sanskrit": "सलोहिता दिशश्चासन् खरवाचो मृगद्विजाः ।\nतमोवृतमभूत् सर्वं न प्राज्ञायत किञ्चन\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2130510, "chapter_id": 3816, "verse_number": "", "content_sanskrit": "अन्ये च बहवो भीमा उत्पातास्तत्र जज्ञिरे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2130511, "chapter_id": 3816, "verse_number": "६", "content_sanskrit": "तदद्भुतमभिप्रेक्ष्य धर्मपुत्रो युधिष्ठिरः ।\nउवाच वदतां श्रेष्ठः कोऽस्मानभिभविष्यति\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2130512, "chapter_id": 3816, "verse_number": "७", "content_sanskrit": "सज्जीभवत भद्रं वः पाण्डवा युद्धदुर्मदाः ।\nयथारूपाणि पश्यामि स्वभ्यग्रो नः पराक्रमः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2130513, "chapter_id": 3816, "verse_number": "८", "content_sanskrit": "एवमुक्त्वा ततो राजा वीक्षाञ्चक्रे समन्ततः ।\nअपश्यमानो भीमं तु धर्मपुत्रो युधिष्ठिरः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2130514, "chapter_id": 3816, "verse_number": "९", "content_sanskrit": "ततः कृष्णां यमौ चापि समीपस्थावरिन्दमः ।\nपप्रच्छ भ्रातरं भीमं भीमकर्माणमाहवे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2130515, "chapter_id": 3816, "verse_number": "१०", "content_sanskrit": "कच्चित् क्व भीमः पाञ्चालि किञ्चित् कृत्यं चिकीर्षति ।\nकृतवानपि वा वीरः साहसं साहसप्रियः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2130516, "chapter_id": 3816, "verse_number": "११", "content_sanskrit": "इमे ह्यकस्मादुत्पाता महासमरदर्शनाः ।\nदर्शयन्तो भयं तीव्रं प्रादुर्भूताः समन्ततः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2130517, "chapter_id": 3816, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2130518, "chapter_id": 3816, "verse_number": "१२", "content_sanskrit": "तं तथावादिनं कृष्णा प्रत्युवाच मनस्विनी ।\nप्रिया प्रियं चिकीर्षन्ती महिषी चारुहासिनी\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2130519, "chapter_id": 3816, "verse_number": "१३", "content_sanskrit": "यत्तत् सौगन्धिकं राजन्नाहृतं मातरिश्वना ।\nतन्मया भीमसेनस्य प्रीतयाऽद्योपपादितम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2130520, "chapter_id": 3816, "verse_number": "१४", "content_sanskrit": "अपि चोक्तो मया वीरो यदि पश्येर्बहून्यपि ।\nतानि सर्वाण्युपादाय शीघ्रमागम्यतामिति\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2130521, "chapter_id": 3816, "verse_number": "१५", "content_sanskrit": "स तु नूनं महाबाहुः प्रियार्थं मम पाण्डवः ।\nप्रागुदीचीं दिशं राजंस्तान्याहर्तुमितो गतः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2130522, "chapter_id": 3816, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2130523, "chapter_id": 3816, "verse_number": "१६", "content_sanskrit": "उक्तस्त्वेवं तया राजा यमाविदमथाब्रवीत् ।\nगच्छाम सहितास्तूर्णं येन यातो वृकोदरः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2130524, "chapter_id": 3816, "verse_number": "१७", "content_sanskrit": "वहन्तु राक्षसा विप्रान् यथाश्रान्तान् यथाकृशान् ।\nत्वमप्यमरसङ्काश वह कृष्णां घटोत्कच \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2130525, "chapter_id": 3816, "verse_number": "१८", "content_sanskrit": "व्यक्तं दूरमितो भीमः प्रविष्ट इति मे मतिः ।\nचिरं च तस्य कालोऽयं स च वायुसमो जवे\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2130526, "chapter_id": 3816, "verse_number": "१९", "content_sanskrit": "तरस्वी वैनतेयस्य सदृशो भुवि लङ्घने ।\nउत्पतेदपि वा(चा)काशं निपतेच्च यथेच्छकम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2130527, "chapter_id": 3816, "verse_number": "२०", "content_sanskrit": "तमन्वियाम भवतां प्रभावाद् रजनीचराः ।\nपुराऽसौ नापराध्नोति सिद्धानां ब्रह्मवादिनाम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2130528, "chapter_id": 3816, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2130529, "chapter_id": 3816, "verse_number": "२१", "content_sanskrit": "तथेत्युक्त्वा तु ते सर्वे हैडिम्बप्रमुखास्तदा ।\nउद्देशज्ञाः कुबेरस्य नळिन्या भरतर्षभ\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2130530, "chapter_id": 3816, "verse_number": "२२", "content_sanskrit": "आदाय पाण्डवांश्चैव तांश्च विप्राननेकशः ।\nलोमशेनैव सहिताः प्रययुः प्रीतमानसाः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2130531, "chapter_id": 3816, "verse_number": "२३", "content_sanskrit": "ते सर्वे त्वरिता गत्वा ददृशुः शुभकाननाम् ।\nपद्मसौगन्धिकवतीं नळिनीं सुमनोरमाम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2130532, "chapter_id": 3816, "verse_number": "२४", "content_sanskrit": "तं च भीमं महात्मानं तस्यास्तीरे मनस्विनम् ।\nददृशुर्निहतांश्चैव यक्षांश्च विपुलेक्षणान्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2130533, "chapter_id": 3816, "verse_number": "२५", "content_sanskrit": "भिन्नकायाक्षिबाहूरून् सञ्चूर्णितशिरोधरान् ।\nतं च भीमं महात्मानं तस्यास्तीरे व्यवस्थितम्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2130534, "chapter_id": 3816, "verse_number": "", "content_sanskrit": "सक्रोधं स्तब्धनयनं सन्दष्टदशनच्छदम् ।\nउद्यम्य च गदां दोर्भ्यां नदीतीरेष्ववस्थितम् ।\nप्रजासङ्क्षेपसमये दण्डहस्तमिवोन्तकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2130535, "chapter_id": 3816, "verse_number": "२६", "content_sanskrit": "तं दृष्ट्वा धर्मराजस्तु परिष्वज्य पुनः पुनः ।\nउवाच श्लक्ष्णया वाचा कौन्तेय किमिदं कृतम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2130536, "chapter_id": 3816, "verse_number": "२७", "content_sanskrit": "साहसं बत भद्रं ते देवानामथ चाप्रियम् ।\nपुनरेवं न कर्तव्यं मम चेदिच्छसि प्रियम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2130537, "chapter_id": 3816, "verse_number": "२८", "content_sanskrit": "अनुशिष्य तु कोन्तेयं पद्मानि परिगृह्य च ।\nतस्यामेव नळिन्यां तु विजह्रुरमरोपमाः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2130538, "chapter_id": 3816, "verse_number": "२९", "content_sanskrit": "एतस्मिन्नेव काले तु प्रगृहीतशिलायुधाः ।\nप्रादुरासन् महाकायास्तस्योद्यानस्य रक्षिणः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2130539, "chapter_id": 3816, "verse_number": "३०", "content_sanskrit": "ते दृष्ट्वा धर्मराजानं महर्षिं चापि लोमशम् ।\nनकुलं सहदेवं च तथान्यान् ब्राह्मणर्षभान्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2130540, "chapter_id": 3816, "verse_number": "३१", "content_sanskrit": "विनयेन नताः सर्वे प्रणिपेतुश्च भारत ।\nसान्त्विता धर्मराजेन प्रसेदुः क्षणदाचराः \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2130541, "chapter_id": 3816, "verse_number": "३२", "content_sanskrit": "विदिताश्च कुबेरस्य तत्र ते कुरुपुङ्गवाः ।\nऊषुर्नातिचिरं कालं रममाणाः कुरूद्वहाः ।\nप्रतीक्षमाणा बीभत्सुं गन्धमादनसानुषु \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2130542, "chapter_id": 3816, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि एकपञ्चाशदधिकशततमोऽध्यायः ॥ १५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2130543, "chapter_id": 3816, "verse_number": "", "content_sanskrit": "॥ इति तीर्थयात्रापर्वणि सप्ताधिकशततमोऽध्यायः ॥१०७॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]