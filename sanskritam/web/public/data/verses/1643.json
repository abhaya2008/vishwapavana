[{"id": 2029450, "chapter_id": 1643, "verse_number": "३-२८१-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2029451, "chapter_id": 1643, "verse_number": "३-२८१-१", "content_sanskrit": "ततोऽविदूरे नलिनीं रप्रभूतकमलोत्पलाम्।\nसीताहरणदुःखार्तः पम्पां रामः समासदत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2029452, "chapter_id": 1643, "verse_number": "३-२८१-२", "content_sanskrit": "मारुतेन सुशीतेन सुखेनामृतगन्धिना।\nसेव्यमानो वने तस्मिञ्जगाम मनसा प्रियाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2029453, "chapter_id": 1643, "verse_number": "३-२८१-३", "content_sanskrit": "विललाप सराजेन्द्रस्तत्रकान्तानुस्मरन्।\nकामबाणाभिसंतप्तं सौमित्रिस्तमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2029454, "chapter_id": 1643, "verse_number": "३-२८१-४", "content_sanskrit": "न त्वामेवंविधो भावः स्प्रष्टुमर्हति मानद।\nआत्मवन्तमिव व्याधिः पुरुषंवृद्धसेविनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2029455, "chapter_id": 1643, "verse_number": "३-२८१-५", "content_sanskrit": "प्रवृत्तिरुपलब्धा ते वैदेह्या रावणस्य च।\nतां त्वं पुरुषकारेण बुद्ध्या चैवोपपादय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2029456, "chapter_id": 1643, "verse_number": "३-२८१-६", "content_sanskrit": "अभिगच्छाव सुग्रीवं शैलस्थं हरिपुङ्गवम्।\nमयि शिष्ये च भृत्ये च सहाये च समाश्वस ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2029457, "chapter_id": 1643, "verse_number": "३-२८१-७", "content_sanskrit": "एवं बहुविधैर्वाक्यैर्लक्ष्मणेन स राघवः।\nउक्तः प्रकृतिमापेदे कार्ये चानन्तरोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2029458, "chapter_id": 1643, "verse_number": "३-२८१-८", "content_sanskrit": "निषेव्य वारि पम्पायास्तर्पयित्वा पितृनपि।\nप्रतस्थतुरभौ वीरौ भ्रातरौ रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2029459, "chapter_id": 1643, "verse_number": "३-२८१-९", "content_sanskrit": "तावृश्यमूकमभ्येत्य बहुमूलफलद्रुमम्।\nगिर्यग्रे वानरान्पञ्वीरौ ददृशतुस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2029460, "chapter_id": 1643, "verse_number": "३-२८१-१०", "content_sanskrit": "सुग्रीवः प्रेषयामास सचिवं वानरं तयोः।\nबुद्धिमन्तं हनूमन्तं हिमवन्तमिव स्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2029461, "chapter_id": 1643, "verse_number": "३-२८१-११", "content_sanskrit": "तेन संभाष्य पूर्वं तौ सुग्रीवमभिजग्मतुः।\nरसख्यं वानरराजेन चक्रे रामस्तदा नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2029462, "chapter_id": 1643, "verse_number": "३-२८१-१२", "content_sanskrit": "`ततः सीतां हृतां श्रुत्वा सुग्रीवो वालिना कृतम्।\nदुःखमाख्यातवान्सर्वं रामायामिततेजसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2029463, "chapter_id": 1643, "verse_number": "३-२८१-१३", "content_sanskrit": "तद्वासो दर्शयामास तस् कार्ये निवेदिते।\nवानराणां तु यत्सीता ह्रियमाणा व्यपासृजत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2029464, "chapter_id": 1643, "verse_number": "३-२८१-१४", "content_sanskrit": "तत्प्रत्ययकरं लब्ध्वा सुग्रीवं प्लवगाधिपम्।\nपृथिव्यां वानरैश्वर्ये स्वयंरामोऽभ्यषेचयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2029465, "chapter_id": 1643, "verse_number": "३-२८१-१५", "content_sanskrit": "प्रतिजज्ञे चकाकुत्स्थः समरे वालिनो वधम्।\nसुग्रीवश्चापि वैदेह्याः पुनरानयनं नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2029466, "chapter_id": 1643, "verse_number": "३-२८१-१६", "content_sanskrit": "इत्येवं समयं कृत्वाविश्वास्य च परस्परम्।\nअभ्येत्य सर्वकिष्किन्धां तस्थुर्युद्धाभिकाङ्क्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2029467, "chapter_id": 1643, "verse_number": "३-२८१-१७", "content_sanskrit": "सुग्रीवः प्राप्यकिष्किन्धां ननादौघनिभस्वनः।\nनसाय् तन्ममृषे वाली तारा तं प्रत्यषेधयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2029468, "chapter_id": 1643, "verse_number": "३-२८१-१८", "content_sanskrit": "यथानदतिसुग्रीवो बलवानेष वानरः।\nमन्ये चाश्रयवान्प्राप्तो न त्वं निष्क्रान्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2029469, "chapter_id": 1643, "verse_number": "३-२८१-१९", "content_sanskrit": "हेममाली ततो वाली तारां ताराधिपाननाम्।\nप्रोवाच वचनं वाग्मी तां वानरपतिः पतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2029470, "chapter_id": 1643, "verse_number": "३-२८१-२०", "content_sanskrit": "सर्वभूतरुतज्ञा शृणु सर्वं कपीश्वर ॥\nकेन चाश्रयवान्प्राप्तो ममैप भ्रातृगन्धिकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2029471, "chapter_id": 1643, "verse_number": "३-२८१-२१", "content_sanskrit": "चिन्तयित्वा मुहूर्तं तु तारा ताराधिपप्रभा।\nपतिमित्यब्रवीत्प्राज्ञा शृणु सर्वं कपीश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2029472, "chapter_id": 1643, "verse_number": "३-२८१-२२", "content_sanskrit": "हृतदारो महासत्वोरामो दशरथात्मजः।\nरतुल्यारिमित्रतां प्राप्तः सुग्रीवेण धनुर्धरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2029473, "chapter_id": 1643, "verse_number": "३-२८१-२३", "content_sanskrit": "भ्राता चास्य महाबाहुः सौमित्रिरपराजितः।\nलक्ष्मणो नाम मेधावी स्थितः कार्यार्थसिद्धये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2029474, "chapter_id": 1643, "verse_number": "३-२८१-२४", "content_sanskrit": "मैन्दश्च द्विविदश्चापि हनूमांश्चानिलात्मजः।\nजाम्बवानृक्षराजश्च सुग्रीवसचिवाः स्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2029475, "chapter_id": 1643, "verse_number": "३-२८१-२५", "content_sanskrit": "सर्व एते महात्मानो बुद्धिमन्तो महाबलाः।\nअलं तव विनाशाय रामवीर्यव्यपाश्रयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2029476, "chapter_id": 1643, "verse_number": "३-२८१-२६", "content_sanskrit": "तस्यास्तदाक्षिप्य वचो हितमुक्तं कपीश्वरः।\nपर्यशङ्कत तामीर्षुः सुग्रीवगतमानसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2029477, "chapter_id": 1643, "verse_number": "३-२८१-२७", "content_sanskrit": "तारां परुषमुक्त्वा तु निर्जगाम गुहामुखात्।\nस्थितं माल्यवतोऽभ्याशे सुग्रीवं सोभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2029478, "chapter_id": 1643, "verse_number": "३-२८१-२८", "content_sanskrit": "असकृत्त्वं मया क्लीव निर्जितो जीवितप्रियः।\nमुक्तो गच्छसि दुर्बुद्धे कथंकारं रणे पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2029479, "chapter_id": 1643, "verse_number": "३-२८१-२९", "content_sanskrit": "इत्युक्तः प्राहसुग्रीवो भ्रातरं हेतुमद्वचः।\nप्राप्तकालममित्रघ्नं रामं सम्बोधयन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2029480, "chapter_id": 1643, "verse_number": "३-२८१-३०", "content_sanskrit": "हृतराज्यस्य मे राजन्हृतदारस्य च त्वया।\nकिं मे जीवितसामर्थ्यमिति विद्धि समागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2029481, "chapter_id": 1643, "verse_number": "३-२८१-३१", "content_sanskrit": "एवमुक्त्वाबहुविधं ततस्तौ सन्निपेततुः।\nसमरे वालिसुग्रीवौ सालतालशिलायुधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2029482, "chapter_id": 1643, "verse_number": "३-२८१-३२", "content_sanskrit": "उभौ जघ्नतुरन्योन्यमुभौ भूमौ निपेततुः।\nउभौ ववल्गतुश्चित्रं मुष्टिभिश्च निजघ्नतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2029483, "chapter_id": 1643, "verse_number": "३-२८१-३३", "content_sanskrit": "उभौ रुधिरसंसिक्तौ नखदन्तपरिक्षतौ।\nशुशुभाते तदा वीरौ पुष्पिताविव किंशुकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2029484, "chapter_id": 1643, "verse_number": "३-२८१-३४", "content_sanskrit": "न विशेषस्तयोर्युद्धे यदा कश्चन दृश्यते।\nसुग्रीवस् तदा मालां हनुमान्कण्ठ आसजत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2029485, "chapter_id": 1643, "verse_number": "३-२८१-३५", "content_sanskrit": "स मालया तदा वीरः शुशुभे कण्ठसक्तया।\nश्रीमानिव महाशैलो मलयो मेघमालया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2029486, "chapter_id": 1643, "verse_number": "३-२८१-३६", "content_sanskrit": "कृतचिह्नं तु सुग्रीवं रामो दृष्ट्वा महाधनुः।\nविचकर्ष धनुःश्रेष्ठं वालिमुद्दिश्य लक्षयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2029487, "chapter_id": 1643, "verse_number": "३-२८१-३७", "content_sanskrit": "विष्फारस्तस् धनुषो यन्त्रस्येव तदा बभौ।\nवितत्रास तदा वाली शरेणाभिहतो हृदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2029488, "chapter_id": 1643, "verse_number": "३-२८१-३८", "content_sanskrit": "स भिन्नहृदयो वाली वक्राच्छोणितमुद्वमन्।\nददर्शावस्थितं रामं ततः सौमित्रिणा सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2029489, "chapter_id": 1643, "verse_number": "३-२८१-३९", "content_sanskrit": "गर्हयित्वास काकुत्स्थं पपात भुवि मूर्च्छितः।\nतारा ददर्श तं भूमौ तारापतिमिव च्युतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2029490, "chapter_id": 1643, "verse_number": "३-२८१-४०", "content_sanskrit": "हते वालिनि सुग्रीवः किष्किन्धां प्रत्यपद्यत।\nतां तारापतिमुखीं तारां निपतितेश्वराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2029491, "chapter_id": 1643, "verse_number": "३-२८१-४१", "content_sanskrit": "रामस्तु चतुरो मासान्पृष्ठे माल्यवतः शुभे।\nनिवासमकरोद्धीमान्सुग्रीवेणाभ्युपस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2029492, "chapter_id": 1643, "verse_number": "३-२८१-४२", "content_sanskrit": "रावणोऽपिपुरीं गत्वालङ्कां कामबलात्कृतः।\nसीतां निवेशयामास भवने नन्दनोपमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2029493, "chapter_id": 1643, "verse_number": "३-२८१-४३", "content_sanskrit": "अशोकवनिकाभ्यासे तापसास्रमसन्निभे।\nभर्तृस्मरणतन्वङ्गी तापसीवेषधारिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2029494, "chapter_id": 1643, "verse_number": "३-२८१-४४", "content_sanskrit": "उपवासतपःशीला ततः सा पृथुलेक्षणा।\nउवास दुःखवसतिं फलमूलकृताशना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2029495, "chapter_id": 1643, "verse_number": "३-२८१-४५", "content_sanskrit": "दिदेश राक्षसीस्तत्ररक्षणे राक्षसाधिपः।\nप्रासासिशूलपरशुमुद्गरालातधारिणीः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2029496, "chapter_id": 1643, "verse_number": "३-२८१-४६", "content_sanskrit": "द्व्यक्षीं त्र्यक्षीं ललाटक्षीं दीर्घजिह्वामजिह्विकाम्।\nत्रिस्तनीमेकपादां च त्रिजटामेकलोचनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2029497, "chapter_id": 1643, "verse_number": "३-२८१-४७", "content_sanskrit": "एताश्चान्याश्च दीप्ताक्ष्यः करभोत्कटमूर्धजाः।\nपरिवार्यासते सीतां दिवारात्रमतन्द्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2029498, "chapter_id": 1643, "verse_number": "३-२८१-४८", "content_sanskrit": "तास्तु तामायतापाङ्गीं पिशाच्यो दारुणस्वराः।\nतर्जयन्ति सदा रौद्राः परुषव्यञ्जनस्वराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2029499, "chapter_id": 1643, "verse_number": "३-२८१-४९", "content_sanskrit": "खादाम पाटयामैनां तिलशः प्रविभज्यताम्।\nयेयं भर्तारमस्माकमवमत्येह जीवति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2029500, "chapter_id": 1643, "verse_number": "३-२८१-५०", "content_sanskrit": "इत्येवं परिभर्त्सन्तीस्त्रासयानाः पुनः पुनः।\nभर्तृशोकसमाविष्टा निःश्वस्येदमुवाच ताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2029501, "chapter_id": 1643, "verse_number": "३-२८१-५१", "content_sanskrit": "आर्याः खादत मां शीघ्रं न मे लोभोस्ति जीविते।\nविना तं पुण्डरीकाक्षं नीलकुञ्चितमूर्धजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2029502, "chapter_id": 1643, "verse_number": "३-२८१-५२", "content_sanskrit": "अद्यैवाहं निराहारा जीवितप्रियवर्जिता।\nशोषयिष्यामि गात्राणि बल्ली तलगता यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2029503, "chapter_id": 1643, "verse_number": "३-२८१-५३", "content_sanskrit": "न त्वन्यमभिगच्छेयं पुमांसं राघवादृते।\nइति जानीत सत्यं मेक्रियतां यदनन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2029504, "chapter_id": 1643, "verse_number": "३-२८१-५४", "content_sanskrit": "तस्यास्तद्वचनं श्रुत्वा राक्षस्यस्ताः खरस्वनाः।\nआख्यातुं राक्षसेन्द्राय जन्मुस्तत्सर्वमादितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2029505, "chapter_id": 1643, "verse_number": "३-२८१-५५", "content_sanskrit": "गतासु तासु सर्वासु त्रिजटा नाम राक्षसी।\nसान्त्वयामास वैदेहीं धर्मज्ञा प्रियवादिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2029506, "chapter_id": 1643, "verse_number": "३-२८१-५६", "content_sanskrit": "सीते वक्ष्यामि ते किंचिद्विश्वासं करु मे सखि।\nभयं त्वं त्यज वामोरु शृणु चेदं वचो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2029507, "chapter_id": 1643, "verse_number": "३-२८१-५७", "content_sanskrit": "अविन्ध्यो नाम मेधावी वृद्धो राक्षसपुङ्गवः।\nस रामस्य हितान्वेषी त्वदर्थे मामचूचुदत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2029508, "chapter_id": 1643, "verse_number": "३-२८१-५८", "content_sanskrit": "सीता मद्वचनाद्वाच्या समाश्वास्य प्रसाद्य च।\nभर्ता तेकुशली रामोलक्ष्मणानुगतो बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2029509, "chapter_id": 1643, "verse_number": "३-२८१-५९", "content_sanskrit": "सख्यं वानरराजेन शक्रप्रतिमतेजसा।\nकृतवान्राघवः श्रीमांस्त्वदर्थे च समुद्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2029510, "chapter_id": 1643, "verse_number": "३-२८१-६०", "content_sanskrit": "मा च ते भूद्भयं भीरु रावणाल्लोकगर्हितात्।\nनलकूबरशापेन रक्षिता ह्यसि नन्दिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2029511, "chapter_id": 1643, "verse_number": "३-२८१-६१", "content_sanskrit": "शप्तो ह्येष पुरा पापो वधूं रम्भां परामृशन्।\nन शक्रोत्यवशां नारीमुपैतुमजितेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2029512, "chapter_id": 1643, "verse_number": "३-२८१-६२", "content_sanskrit": "क्षिप्रमेष्यति ते भर्ता सुग्रीवेणाभिरक्षितः।\nसौमित्रिसहितो धीमांस्त्वां चेतो मोक्षयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2029513, "chapter_id": 1643, "verse_number": "३-२८१-६३", "content_sanskrit": "स्वप्ना हि सुमहाघोरा दृष्टा मेऽनिष्टदर्शनाः।\nविनाशायास्य दुर्बुद्धेः पौलस्त्यस्य कुलस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2029514, "chapter_id": 1643, "verse_number": "३-२८१-६४", "content_sanskrit": "दारुणो ह्येष दुष्टात्मा क्षुद्रकर्मा निशाचरः।\nस्वभावाच्छीलदोषेण सर्वेषां भयवर्धनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2029515, "chapter_id": 1643, "verse_number": "३-२८१-६५", "content_sanskrit": "स्पर्धते सर्वदेवैर्यः कालोपहतचेतनः।\nमया विनासलिङ्गानि स्वप्ने दृष्टानि तस्य वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2029516, "chapter_id": 1643, "verse_number": "३-२८१-६६", "content_sanskrit": "तैलाभिषिक्तो विकचो मज्जनप्के दशाननः।\nअसकृत्स्वरयुक्ते तु रथे नृत्यन्निव स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2029517, "chapter_id": 1643, "verse_number": "३-२८१-६७", "content_sanskrit": "कुम्भकर्णादयश्चेमे नग्नाः पतितमूर्धजाः।\nगच्छन्ति दक्षिणामाशां रक्तमाल्यानुलेपनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2029518, "chapter_id": 1643, "verse_number": "३-२८१-६८", "content_sanskrit": "श्वेतातपत्रः सोष्णीषः शुक्लमाल्यानुलेपनः।\nश्वेतपर्वतमारूढ एक एव विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2029519, "chapter_id": 1643, "verse_number": "३-२८१-६९", "content_sanskrit": "सचिवाश्चास्य चत्वारः शुक्लमाल्यानुलेपनाः।\nश्वेतपर्वतमारूढा मोक्ष्यन्तेऽस्मान्महाभयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2029520, "chapter_id": 1643, "verse_number": "३-२८१-७०", "content_sanskrit": "रामस्यास्त्रेण पृथिवी परिक्षिप्ता ससागरा।\nयशसा पृथिवीं कृत्स्नां पूरयिष्यति ते पतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2029521, "chapter_id": 1643, "verse_number": "३-२८१-७१", "content_sanskrit": "हस्तिसक्थिसमारूढो भुञ्जानो मधुपायसम्।\nलक्ष्मणश्च मया दृष्टो दिधक्षुः सर्वतो दिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2029522, "chapter_id": 1643, "verse_number": "३-२८१-७२", "content_sanskrit": "रुदती रुधिरार्द्राङ्गी व्याघ्रेण परिरक्षिता।\nअसकृत्त्वं मया दृष्टा गच्छन्ती दिशमुत्तराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2029523, "chapter_id": 1643, "verse_number": "३-२८१-७३", "content_sanskrit": "हर्षमेष्यसि वैदेहि क्षिप्रं भर्त्रा समन्विता।\nराघवेण सहभ्रात्रा सीते त्वमचिरादिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2029524, "chapter_id": 1643, "verse_number": "३-२८१-७४", "content_sanskrit": "इत्येतन्मृगशावाक्षी तच्छ्रुत्वा त्रिजटावचः।\nबभूवाशावती बाला पुनर्भर्तृसमागमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2029525, "chapter_id": 1643, "verse_number": "३-२८१-७५", "content_sanskrit": "तावदभ्यागता रौद्र्यः पिशाच्यस्ताःसुदारुणाः।\nददृशुस्तां त्रिजटया सहासीनां यथापुरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2029526, "chapter_id": 1643, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि रामोपाख्यानपर्वणि एकाशीत्यधिकद्विशततमोऽध्यायः ॥ २८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}]