[{"id": 5000604000, "chapter_id": 9604, "verse_number": "७-६९-१", "content_sanskrit": "तच्छ्रुत्वा भाषितं तस्य शत्रुघ्नस्य महात्मनः ।\nक्रोधामाहारयत्तीव्रं तिष्ठ तिष्ठेति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000604001, "chapter_id": 9604, "verse_number": "७-६९-२", "content_sanskrit": "पाणौ पाणिं विनिष्पिष्य दन्तान्कटकटाय्य च ।\nलवणो रघुशार्दूलमाह्वयामास चासकृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000604002, "chapter_id": 9604, "verse_number": "७-६९-३", "content_sanskrit": "तं ब्रुवाणं तथा वाक्यं लवणं घोरदर्शनम् ।\nशत्रुघ्नो देवशत्रुघ्न इदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000604003, "chapter_id": 9604, "verse_number": "७-६९-४", "content_sanskrit": "न शत्रुघ्नस्तथा जातो यथा ऽन्ये निर्जितास्त्वया ।\nतदद्य बाणाभिहतो व्रज त्वं यमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000604004, "chapter_id": 9604, "verse_number": "७-६९-५", "content_sanskrit": "ऋषयो ऽप्यद्य पापात्मन्मया त्वां निहतं रणे ।\nपश्यन्तु विप्रा विद्वांसस्त्रिदशा इव रावणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000604005, "chapter_id": 9604, "verse_number": "७-६९-६", "content_sanskrit": "त्वयि मद्बाणनिर्दग्धे पतिते ऽद्य निशाचर ।\nपुरे जनपदे चापि क्षेममेव भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000604006, "chapter_id": 9604, "verse_number": "७-६९-७", "content_sanskrit": "अद्य मद्बाहुनिष्क्रान्तः शरो वज्रनिभाननः ।\nप्रवेक्ष्यते ते हृदयं पद्ममंशुरिवार्कजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000604007, "chapter_id": 9604, "verse_number": "७-६९-८", "content_sanskrit": "एवमुक्तो महावृक्षं लवणः क्रोधमूर्च्छितः ।\nशत्रुघ्नोरसि चिक्षेप स च तं शतधाच्छिनत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000604008, "chapter_id": 9604, "verse_number": "७-६९-९", "content_sanskrit": "तद्दृष्ट्वा विफलं कर्म राक्षसः पुनरेव तु ।\nपादपान्सुबहून्गृह्य शत्रुघ्नायासृजद्बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000604009, "chapter_id": 9604, "verse_number": "७-६९-१०", "content_sanskrit": "शत्रुघ्नश्चापि तेजस्वी वृक्षानापततो बहून् ।\nत्रिभिश्चतुर्भिरेकैकं चिच्छेद नतपर्वभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000604010, "chapter_id": 9604, "verse_number": "७-६९-११", "content_sanskrit": "ततो बाणमयं वर्षं व्यसृजद्राक्षसोरसि ।\nशत्रुघ्नो वीर्यसम्पन्नो विव्यथे न स राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000604011, "chapter_id": 9604, "verse_number": "७-६९-१२", "content_sanskrit": "ततः प्रहस्य लवणो वृक्षमुद्यम्य वीर्यवान् ।\nशिरस्यभ्यहनच्छूरं स्रस्ताङ्गः स मुमोह वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000604012, "chapter_id": 9604, "verse_number": "७-६९-१३", "content_sanskrit": "तस्मिन्निपतिते वीरे हाहाकारो महानभूत् ।\nऋषीणां देवसङ्घानां गन्धर्वाप्सरसां तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000604013, "chapter_id": 9604, "verse_number": "७-६९-१४", "content_sanskrit": "तमवज्ञाय तु हतं शत्रुघ्नं भुवि पातितम् ।\nरक्षो लब्धान्तरमपि न विवेश स्वमालयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000604014, "chapter_id": 9604, "verse_number": "७-६९-१५", "content_sanskrit": "नापि शूलं प्रजग्राह तं दृष्ट्वा भुवि पातितम् ।\nततो हत इति ज्ञात्वा तान्भक्षान्समुदावहत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000604015, "chapter_id": 9604, "verse_number": "७-६९-१६", "content_sanskrit": "मुहूर्ताल्लब्धसञ्ज्ञस्तु पुनस्तस्थौ धृतायुधः ।\nशत्रुघ्नो वै पुरद्वारि ऋषिभिः सम्प्रपूजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000604016, "chapter_id": 9604, "verse_number": "७-६९-१७", "content_sanskrit": "ततो दिव्यममोघं तं जग्राह शरमुत्तमम् ।\nज्वलन्तं तेजसा घोरं पूरयन्तं दिशो दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000604017, "chapter_id": 9604, "verse_number": "७-६९-१८", "content_sanskrit": "वज्राननं वज्रवेगं मेरुमन्दरसन्निभम् ।\nनतं पर्वसु सर्वेषु संयुगेष्वपराजितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000604018, "chapter_id": 9604, "verse_number": "७-६९-१९", "content_sanskrit": "असृक्चन्दनदिग्धाङ्गं चारुपत्रं पतत्रिणम् ।\nदानवेन्द्राचलेन्द्राणामसुराणां च दारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000604019, "chapter_id": 9604, "verse_number": "७-६९-२०", "content_sanskrit": "तं दीप्तमिव कालाग्निं युगान्ते समुपस्थिते ।\nदृष्ट्वा सर्वाणि भूतानि परित्रासमुपागमन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000604020, "chapter_id": 9604, "verse_number": "७-६९-२१", "content_sanskrit": "सदेवासुरगन्धर्वं मुनिभिः साप्सरोगणम् ।\nजगद्धि सर्वमस्वस्थं पितामहमुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000604021, "chapter_id": 9604, "verse_number": "७-६९-२२", "content_sanskrit": "उवाच देवदेवेशं वरदं प्रपितामहम् ।\nदेवानां भयसंमोहो लोकानां सङ्क्षयं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000604022, "chapter_id": 9604, "verse_number": "७-६९-२३", "content_sanskrit": "नेदृशं दृष्टपूर्वं च न श्रुतं प्रपितामह ।\nदेवानां भयसम्मोहो लोकानां सङ्क्षयं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000604023, "chapter_id": 9604, "verse_number": "७-६९-२४", "content_sanskrit": "तेषां तद्वचनं श्रुत्वा ब्रह्मा लोकपितामहः ।\nभयकारणमाचष्ट लोकानामभयङ्करः ।\nउवाच मधुरां वाणीं शृणुध्वं सर्वदेवताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000604024, "chapter_id": 9604, "verse_number": "७-६९-२५", "content_sanskrit": "वधाय लवणस्याजौ शरः शत्रुघ्नधारितः ।\nतेजसा तस्य सम्मूढाः सर्वे स्मः सुरसत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000604025, "chapter_id": 9604, "verse_number": "७-६९-२६", "content_sanskrit": "एष पूर्वस्य देवस्य लोककर्तुः सनातनः ।\nशरस्तेजोमयो वत्सा येन वै भयमागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000604026, "chapter_id": 9604, "verse_number": "७-६९-२७", "content_sanskrit": "एष वै कैटभस्यार्थे मधुनश्च महाशरः ।\nसृष्टो महात्मना तेन वधार्थे दैत्ययोस्तयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000604027, "chapter_id": 9604, "verse_number": "७-६९-२८", "content_sanskrit": "एक एव प्रजानाति विष्णुस्तेजोमयं शरम् ।\nएषा एव तनुः पूर्वा विष्णोस्तस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000604028, "chapter_id": 9604, "verse_number": "७-६९-२९", "content_sanskrit": "इतो गच्छत पश्यध्वं वध्यमानं महात्मना ।\nरामानुजेन वीरेण लवणं राक्षसोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000604029, "chapter_id": 9604, "verse_number": "७-६९-३०", "content_sanskrit": "तस्य ते देवदेवस्य निशम्य वचनं सुराः ।\nआजग्मुर्यत्र युध्येते शत्रुघ्नलवणावुभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000604030, "chapter_id": 9604, "verse_number": "७-६९-३१", "content_sanskrit": "तं शरं दिव्यसङ्काशं शत्रुघ्नकरधारितम् ।\nददृशुः सर्वभूतानि युगान्ताग्निमिवोत्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000604031, "chapter_id": 9604, "verse_number": "७-६९-३२", "content_sanskrit": "अकाशमावृतं दृष्ट्वा देवैर्हि रघुनन्दनः ।\nसिंहनादं भृशं कृत्वा ददर्श लक्षणं पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000604032, "chapter_id": 9604, "verse_number": "७-६९-३३", "content_sanskrit": "आहूतश्च पुनस्तेन शत्रुघ्नेन महात्मना ।\nलवणः क्रोधसंयुक्तो युद्धाय समुपस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000604033, "chapter_id": 9604, "verse_number": "७-६९-३४", "content_sanskrit": "आकर्णात्स विकृष्याथ तद्धनुर्धन्विनां वरः ।\nतं मुमोच महाबाणं लवणस्य महोरसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000604034, "chapter_id": 9604, "verse_number": "७-६९-३५", "content_sanskrit": "उरस्तस्य विदार्याशु प्रविवेश रसातलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000604035, "chapter_id": 9604, "verse_number": "७-६९-३६", "content_sanskrit": "गत्वा रसातलं दिव्यः शरो विबुधपूजितः ।\nपुनरेवागमत्तूर्णमिक्ष्वाकुकुलनन्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000604036, "chapter_id": 9604, "verse_number": "७-६९-३७", "content_sanskrit": "शत्रुघ्नशरनिर्भिन्नो लवणः स निशाचरः ।\nपपात सहसा भूमौ वज्राहत इवाचलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000604037, "chapter_id": 9604, "verse_number": "७-६९-३८", "content_sanskrit": "तच्च शूलं महत्तेन हते लवणराक्षसे ।\nपश्यतां सर्वदेवानां रुद्रस्य वशमन्वगात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000604038, "chapter_id": 9604, "verse_number": "७-६९-३९", "content_sanskrit": "एकेषुपातेन भृशं निपात्य लोकत्रयस्यापि रघुप्रवीरः ।\nविनिर्बभावुत्तमचापबाणस्तमः प्रणुद्येव सहस्ररश्मिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000604039, "chapter_id": 9604, "verse_number": "७-६९-४०", "content_sanskrit": "ततो हि देवा ऋषिपन्नगाश्च प्रपूजिरे ह्यप्सरसश्च सर्वाः ।\nदिष्ट्या जयो दाशरथेरवाप्तस्त्यक्त्वा भयं सर्प इव प्रशान्तः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000604040, "chapter_id": 9604, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे एकोनसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]