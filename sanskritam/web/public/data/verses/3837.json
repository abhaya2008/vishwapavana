[{"id": 2131395, "chapter_id": 3837, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2131396, "chapter_id": 3837, "verse_number": "१", "content_sanskrit": "ततोऽश्मवर्षं सुमहत् प्रादुरासीत् समन्ततः ।\nनगमात्रैः शिलाखण्डैस्तन्मां दृढमपीडयत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2131397, "chapter_id": 3837, "verse_number": "२", "content_sanskrit": "तदहं वज्रसङ्काशैर्महेन्द्रास्त्रप्रचोदितैः ।\nअचूर्णयं वेगवद्भिः शरजालैर्महाहवे\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2131398, "chapter_id": 3837, "verse_number": "३", "content_sanskrit": "चूर्ण्यमानेऽश्मवर्षे तु पावकः समजायत ।\nतत्राश्मचूर्णा न्यपतन् पावकप्रकरा इव \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2131399, "chapter_id": 3837, "verse_number": "४", "content_sanskrit": "ततोऽश्मवर्षे विहते जलवर्षं महत्तरम् ।\nधाराभिरक्षमात्राभिः प्रादुरासीन्ममान्तिके\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2131400, "chapter_id": 3837, "verse_number": "५", "content_sanskrit": "नभसः प्रच्युता धारास्तिग्मवीर्याः सहस्रशः ।\nआवृण्वन् सर्वतो व्योम दिशश्चोपदिशस्तथा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2131401, "chapter_id": 3837, "verse_number": "६", "content_sanskrit": "धाराणां च निपातेन वायोर्विस्फूर्जितेन च ।\nगर्जितेन च दैत्यानां न प्राज्ञायत किञ्चन\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2131402, "chapter_id": 3837, "verse_number": "७", "content_sanskrit": "धारा दिवि च सम्बद्धा वसुधायां च सर्वशः ।\nव्यामोहयन्त मां तत्र निपतन्त्योऽनिशं भुवि\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2131403, "chapter_id": 3837, "verse_number": "८", "content_sanskrit": "तत्रोपदिष्टमिन्द्रेण दिव्यमस्त्रं विशोषणम् ।\nदीप्तं प्राहिणवं घोरमशुष्यत् तेन तज्जलम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2131404, "chapter_id": 3837, "verse_number": "९", "content_sanskrit": "हतेऽश्मवर्षे च मया जलवर्षे च शोषिते ।\nमुमुचुर्दानवा मायामग्निं वायुं च भारत\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2131405, "chapter_id": 3837, "verse_number": "१०", "content_sanskrit": "ततोऽहमग्निं व्यधमं सलिलास्त्रेण सर्वशः ।\nशैलेन च महास्त्रेण वायोर्वेगमधारयम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2131406, "chapter_id": 3837, "verse_number": "११", "content_sanskrit": "तस्यां प्रतिहतायां तु(ते) दानवा युद्धदुर्मदाः ।\nप्राकुर्वन् विविधां मायां यौगपद्येन भारत\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2131407, "chapter_id": 3837, "verse_number": "१२", "content_sanskrit": "ततो वर्षं प्रादुरभूत् सुमहल्लोमहर्षणम् ।\nअस्त्राणां घोररूपाणामग्नेर्वायोस्तथाऽश्मनाम् ।\nसा तु मायामयी वृष्टिः पीडयामास मां युधि\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2131408, "chapter_id": 3837, "verse_number": "१३", "content_sanskrit": "अथ घोरं तमस्तीव्रं प्रादुरासीत् समन्ततः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2131409, "chapter_id": 3837, "verse_number": "१४", "content_sanskrit": "तमसा संवृते लोके घोरेणावरणेन च ।\nतुरगा विमुखाश्चासन् प्रास्खलच्चापि मातलिः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2131410, "chapter_id": 3837, "verse_number": "१५", "content_sanskrit": "हस्ताद्धिरण्म(श्म)यश्चास्य प्रतोदः प्रापतद् भुवि ।\nअसकृच्चाह मां भीतः किं करिष्याम इत्यपि\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2131411, "chapter_id": 3837, "verse_number": "१६", "content_sanskrit": "मां च भीराविशत् तीव्रा तस्मिन् विगतचेतसि ।\nस च मां विगतज्ञानः सन्त्रस्तमिदमब्रवीत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2131412, "chapter_id": 3837, "verse_number": "", "content_sanskrit": "मातलिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2131413, "chapter_id": 3837, "verse_number": "१७", "content_sanskrit": "सुराणामसुराणां च सङ्ग्रामः सुमहानभूत् ।\nअमृतार्थं पुरा पार्थ स च दृष्टो मयाऽनघ \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2131414, "chapter_id": 3837, "verse_number": "१८", "content_sanskrit": "शम्बरस्य वधे चापि सङ्ग्रामः सुमहानभूत् ।\nसारथ्यं देवराजस्य तत्रापि कृतवानहम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2131415, "chapter_id": 3837, "verse_number": "१९", "content_sanskrit": "तथैव वृत्रस्य वधे सङ्गृहीता हया मया ।\nवैरोचनेर्महायुद्धं दृष्टं चापि सुदारुणम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2131416, "chapter_id": 3837, "verse_number": "२०", "content_sanskrit": "एते मया महाघोराः सङ्ग्रामाः पर्युपासिताः ।\nन चापि विगतज्ञानोऽभूतपूर्वोऽस्मि पाण्डव \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2131417, "chapter_id": 3837, "verse_number": "२१", "content_sanskrit": "पितामहेन संहारः प्रजानां विहितो ध्रुवम् ।\nन हि युद्धमिदं युक्तमन्यत्र जगतः क्षयात्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2131418, "chapter_id": 3837, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2131419, "chapter_id": 3837, "verse_number": "२२", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा संस्तभ्यात्मानमात्मना ।\n(मोहयिष्यन्दानवानामहं मायाबलं महत्)\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2131420, "chapter_id": 3837, "verse_number": "२३", "content_sanskrit": "अब्रुवं मातलिं भीतं पश्य मे भुजयोर्बलम् ।\nअस्त्राणां च प्रभावं वै धनुषो गाण्डिवस्य च\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2131421, "chapter_id": 3837, "verse_number": "२४", "content_sanskrit": "अद्यास्त्रमाययैतेषां मायामेतां सुदारुणाम् ।\nविनिहन्मि तमश्चोग्रं मा भैः सूत स्थिरो भव \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2131422, "chapter_id": 3837, "verse_number": "२५", "content_sanskrit": "एवमुक्त्वाऽहमसृजमस्त्रमायां नराधिप ।\nमोहनीं सर्वशत्रूणां(भूतानां) हिताय त्रिदिवौकसाम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2131423, "chapter_id": 3837, "verse_number": "२६", "content_sanskrit": "पीड्यमानासु मायासु तासु तास्वसुरोत्तमाः ।\nपुनर्बहुविधा मायाः प्राकुर्वन्नमितौजसः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2131424, "chapter_id": 3837, "verse_number": "२७", "content_sanskrit": "पुनः प्रकाशमभवत् तमसा ग्रस्यते पुनः ।\nभवत्यदर्शनो लोकः पुनरप्सु निमज्जति\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2131425, "chapter_id": 3837, "verse_number": "२८", "content_sanskrit": "सुसङ्गृहीतैर्हरिभिः प्रकाशे सति मातलिः ।\nव्यचरत् स्यन्दनाग्र्येण सङ्ग्रामे रो(लो)महर्षणे\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2131426, "chapter_id": 3837, "verse_number": "२९", "content_sanskrit": "ततः परिपतन्त्युग्रा(पर्यपतन्नुग्रा) निवातकवचा मयि ।\nतानहं विवरं दृष्ट्वा प्राहिण्वं यमसादनम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2131427, "chapter_id": 3837, "verse_number": "३०", "content_sanskrit": "वर्तमाने तथा युद्धे निवातकवचान्तके ।\nनापश्यं सहसा सर्वान् दानवान् माययाऽऽवृतान्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2131428, "chapter_id": 3837, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि षट्षट्यधिकशततमोऽध्यायः ॥१६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2131429, "chapter_id": 3837, "verse_number": "", "content_sanskrit": "यक्षयुद्धपर्वणि त्रयोदशोऽध्यायः ॥१३॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]