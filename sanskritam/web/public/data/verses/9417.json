[{"id": 5000417000, "chapter_id": 9417, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे दशमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000417001, "chapter_id": 9417, "verse_number": "६-१०-१", "content_sanskrit": "ततः प्रत्युषसि प्राप्ते प्राप्तधर्मार्थनिश्चयः।\nराक्षसाधिपतेर्वेश्म भीमकर्मा विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000417002, "chapter_id": 9417, "verse_number": "६-१०-२", "content_sanskrit": "शैलाग्रचयसंकाशं शैलशृङ्गमिवोन्नतम्।\nसुविभक्तमहाकक्षं महाजनपरिग्रहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000417003, "chapter_id": 9417, "verse_number": "६-१०-३", "content_sanskrit": "मतिमद्भिर्महामात्रैरनुरक्तैरधिष्ठितम्।\nराक्षसैराप्तपर्याप्तैः सर्वतः परिरक्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000417004, "chapter_id": 9417, "verse_number": "६-१०-४", "content_sanskrit": "मत्तमातङ्गनिःश्वासैर्व्याकुलीकृतमारुतम्।\nशङ्खघोषमहाघोषं तूर्यसम्बाधनादितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000417005, "chapter_id": 9417, "verse_number": "६-१०-५", "content_sanskrit": "प्रमदाजनसम्बाधं प्रजल्पितमहापथम्।\nतप्तकाञ्चननिर्यूहं भूषणोत्तमभूषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000417006, "chapter_id": 9417, "verse_number": "६-१०-६", "content_sanskrit": "गन्धर्वाणामिवावासमालयं मरुतामिव।\nरत्नसंचयसम्बाधं भवनं भोगिनामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000417007, "chapter_id": 9417, "verse_number": "६-१०-७", "content_sanskrit": "तं महाभ्रमिवादित्यस्तेजोविस्तृतरश्मिवान्।\nअग्रजस्यालयं वीरः प्रविवेश महाद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000417008, "chapter_id": 9417, "verse_number": "६-१०-८", "content_sanskrit": "पुण्यान् पुण्याहघोषांश्च वेदविद्भिरुदाहृतान्।\nशुश्राव सुमहातेजा भ्रातुर्विजयसंश्रितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000417009, "chapter_id": 9417, "verse_number": "६-१०-९", "content_sanskrit": "पूजितान् दधिपात्रैश्च सर्पिभिः सुमनोक्षतैः।\nमन्त्रवेदविदो विप्रान् ददर्श स महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000417010, "chapter_id": 9417, "verse_number": "६-१०-१०", "content_sanskrit": "स पूज्यमानो रक्षोभिर्दीप्यमानं स्वतेजसा।\nआसनस्थं महाबाहुर्ववन्दे धनदानुजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000417011, "chapter_id": 9417, "verse_number": "६-१०-११", "content_sanskrit": "स राजदृष्टिसम्पन्नमासनं हेमभूषितम्।\nजगाम समुदाचारं प्रयुज्याचारकोविदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000417012, "chapter_id": 9417, "verse_number": "६-१०-१२", "content_sanskrit": "स रावणं महात्मानं विजने मन्त्रिसंनिधौ।\nउवाच हितमत्यर्थं वचनं हेतुनिश्चितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000417013, "chapter_id": 9417, "verse_number": "६-१०-१३", "content_sanskrit": "प्रसाद्य भ्रातरं ज्येष्ठं सान्त्वेनोपस्थितक्रमः।\nदेशकालार्थसंवादि दृष्टलोकपरावरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000417014, "chapter_id": 9417, "verse_number": "६-१०-१४", "content_sanskrit": "यदाप्रभृति वैदेही सम्प्राप्तेह परंतप।\nतदाप्रभृति दृश्यन्ते निमित्तान्यशुभानि नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000417015, "chapter_id": 9417, "verse_number": "६-१०-१५", "content_sanskrit": "सस्फुलिङ्गः सधूमार्चिः सधूमकलुषोदयः।\nमन्त्रसंधुक्षितोऽप्यग्निर्न सम्यगभिवर्धते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000417016, "chapter_id": 9417, "verse_number": "६-१०-१६", "content_sanskrit": "अग्निष्टेष्वग्निशालासु तथा ब्रह्मस्थलीषु च।\nसरीसृपाणि दृश्यन्ते हव्येषु च पिपीलिकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000417017, "chapter_id": 9417, "verse_number": "६-१०-१७", "content_sanskrit": "गवां पयांसि स्कन्नानि विमदा वरकुञ्जराः।\nदीनमश्वाः प्रहेषन्ते नवग्रासाभिनन्दिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000417018, "chapter_id": 9417, "verse_number": "६-१०-१८", "content_sanskrit": "खरोष्ट्राश्वतरा राजन् भिन्नरोमाः स्रवन्ति च।\nन स्वभावेऽवतिष्ठन्ते विधानैरपि चिन्तिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000417019, "chapter_id": 9417, "verse_number": "६-१०-१९", "content_sanskrit": "वायसाः संघशः क्रूरा व्याहरन्ति समन्ततः।\nसमवेताश्च दृश्यन्ते विमानाग्रेषु संघशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000417020, "chapter_id": 9417, "verse_number": "६-१०-२०", "content_sanskrit": "गृध्राश्च परिलीयन्ते पुरीमुपरि पिण्डिताः।\nउपपन्नाश्च संध्ये द्वे व्याहरन्त्यशिवं शिवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000417021, "chapter_id": 9417, "verse_number": "६-१०-२१", "content_sanskrit": "क्रव्यादानां मृगाणां च पुरीद्वारेषु संघशः।\nश्रूयन्ते विपुला घोषाः सविस्फूर्जितनिःस्वनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000417022, "chapter_id": 9417, "verse_number": "६-१०-२२", "content_sanskrit": "तदेवं प्रस्तुते कार्ये प्रायश्चित्तमिदं क्षमम्।\nरोचये वीर वैदेही राघवाय प्रदीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000417023, "chapter_id": 9417, "verse_number": "६-१०-२३", "content_sanskrit": "इदं च यदि वा मोहाल्लोभाद् वा व्याहृतं मया।\nतत्रापि च महाराज न दोषं कर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000417024, "chapter_id": 9417, "verse_number": "६-१०-२४", "content_sanskrit": "अयं हि दोषः सर्वस्य जनस्यास्योपलक्ष्यते।\nरक्षसां राक्षसीनां च पुरस्यान्तःपुरस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000417025, "chapter_id": 9417, "verse_number": "६-१०-२५", "content_sanskrit": "प्रापणे चास्य मन्त्रस्य निवृत्ताः सर्वमन्त्रिणः।\nअवश्यं च मया वाच्यं यद् दृष्टमथवा श्रुतम्।\nसम्प्रधार्य यथान्यायं तद् भवान् कर्तुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000417026, "chapter_id": 9417, "verse_number": "६-१०-२६", "content_sanskrit": "इति स्वमन्त्रिणां मध्ये भ्राता भ्रातरमूचिवान्।\nरावणं रक्षसां श्रेष्ठं पथ्यमेतद् विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000417027, "chapter_id": 9417, "verse_number": "६-१०-२७", "content_sanskrit": "हितं महार्थं मृदु हेतुसंहितं\nव्यतीतकालायतिसम्प्रतिक्षमम्।\nनिशम्य तद्वाक्यमुपस्थितज्वरः\nप्रसङ्गवानुत्तरमेतदब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000417028, "chapter_id": 9417, "verse_number": "६-१०-२८", "content_sanskrit": "भयं न पश्यामि कुतश्चिदप्यहं\nन राघवः प्राप्स्यति जातु मैथिलीम्।\nसुरैः सहेन्द्रैरपि संगरे कथं\nममाग्रतः स्थास्यति लक्ष्मणाग्रजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000417029, "chapter_id": 9417, "verse_number": "६-१०-२९", "content_sanskrit": "इत्येवमुक्त्वा सुरसैन्यनाशनो\nमहाबलः संयति चण्डविक्रमः।\nदशाननो भ्रातरमाप्तवादिनं\nविसर्जयामास तदा विभीषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000417030, "chapter_id": 9417, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे दशमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]