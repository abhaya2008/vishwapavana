[{"id": 7006431000, "chapter_id": 26431, "verse_number": "२-९१-१", "content_sanskrit": "जनमेजय उवाच\nभानुमत्यापहरणं विजयं केशवस्य च ।\nछालिक्यनयनं चैव देवलोकान्महामुने ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006431001, "chapter_id": 26431, "verse_number": "२-९१-२", "content_sanskrit": "क्रीडां च सागरे दिव्यां वृष्णीनामतितेजसाम् ।\nअश्रौषं परमाश्चर्यं मुने धर्मभृतां वर ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006431002, "chapter_id": 26431, "verse_number": "२-९१-३", "content_sanskrit": "वज्रनाभवधो ह्युक्तो निकुम्भवधकीर्तने ।\nतन्मे कौतूहलं श्रोतुं प्रसादाद् भवतो मुने ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006431003, "chapter_id": 26431, "verse_number": "२-९१-४", "content_sanskrit": "वैशम्पायन उवाच\nहन्त ते वर्तयिष्यामि वज्रनाभवधं नृप ।\nविजयं चैव कामस्य साम्बस्यैव च भारत ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006431004, "chapter_id": 26431, "verse_number": "२-९१-५", "content_sanskrit": "मेरोः सानौ नरपते तपश्चक्रे महासुरः ।\nवज्रनाभ इति ख्यातो निश्चितः समितिंजयः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006431005, "chapter_id": 26431, "verse_number": "२-९१-६", "content_sanskrit": "तस्य तुष्टो महातेजा ब्रह्मा लोकपितामहः ।\nवरेण च्छन्दयामास तपसा परितोषितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006431006, "chapter_id": 26431, "verse_number": "२-९१-७", "content_sanskrit": "अवध्यत्वं स देवेभ्यो वव्रे दानवसत्तमः ।\nपुरं वज्रपुरं चापि सर्वरत्नमयं शुभम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006431007, "chapter_id": 26431, "verse_number": "२-९१-८", "content_sanskrit": "स्वच्छन्देन प्रवेशश्च न वायोरपि भारत ।\nअचिन्तितेन कामानामुपपत्तिर्नराधिप ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006431008, "chapter_id": 26431, "verse_number": "२-९१-९", "content_sanskrit": "शाखानगरमुख्यानां संवाहानां शतानि च ।\nनगरस्याप्रमेयस्य समन्ताज्जनमेजय ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006431009, "chapter_id": 26431, "verse_number": "२-९१-१०", "content_sanskrit": "तथा तदभवत् तस्य वरदानेन भारत ।\nउवास वज्रनगरे वज्रनाभो महासुरः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006431010, "chapter_id": 26431, "verse_number": "२-९१-११", "content_sanskrit": "कोटिशो वरलब्धं तमसुराः परिवार्य ते ।\nऊषुर्वज्रपुरे राजन् संवाहेषु तथैव च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006431011, "chapter_id": 26431, "verse_number": "२-९१-१२", "content_sanskrit": "शाखानगरमुख्येषु रम्येषु च नराधिप ।\nहृष्टपुष्टप्रमुदिता नृप देवस्य शत्रवः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006431012, "chapter_id": 26431, "verse_number": "२-९१-१३", "content_sanskrit": "वज्रनाभोऽथ दुष्टात्मा वरदानेन दर्पितः ।\nपुरस्य चात्मनश्चैव जगद् बाधितुमुद्यतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006431013, "chapter_id": 26431, "verse_number": "२-९१-१४", "content_sanskrit": "महेन्द्रमब्रवीद् गत्वा देवलोकं विशाम्पते ।\nअहमीशितुमिच्छामि त्रैलोक्यं पाकशासन ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006431014, "chapter_id": 26431, "verse_number": "२-९१-१५", "content_sanskrit": "अथवा मे प्रयच्छस्व युद्धं देवगणेश्वर ।\nसामान्यं हि जगत्कृत्स्नं काश्यपानां महात्मनाम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006431015, "chapter_id": 26431, "verse_number": "२-९१-१६", "content_sanskrit": "स बृहस्पतिना सार्द्धं मन्त्रयित्वा महेश्वरः ।\nवज्रनाभं सुरश्रेष्ठः प्रोवाच कुरुवंशज ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006431016, "chapter_id": 26431, "verse_number": "२-९१-१७", "content_sanskrit": "सत्रेषु दीक्षितः सौम्य कश्यपो नः पिता मुनिः ।\nतस्मिन् वृत्ते यथान्याय्यं तथा स हि करिष्यति ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006431017, "chapter_id": 26431, "verse_number": "२-९१-१८", "content_sanskrit": "ततः स पितरं गत्वा कश्यपं दानवोऽब्रवीत् ।\nयथोक्तं देवराजेन तमुवाचाथ कश्यपः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006431018, "chapter_id": 26431, "verse_number": "२-९१-१९", "content_sanskrit": "सत्रे वृत्ते करिष्यामि यथा न्याय्यं भविष्यति ।\nत्वं तु वज्रपुरे पुत्र वस गच्छ समाहितः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006431019, "chapter_id": 26431, "verse_number": "२-९१-२०", "content_sanskrit": "एवमुक्ते वज्रनाभः स्वमेव नगरं गतः ।\nमहेन्द्रोऽपि ययौ देवो द्वारकां द्वारशालिनीम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006431020, "chapter_id": 26431, "verse_number": "२-९१-२१", "content_sanskrit": "गत्वा चान्तर्हितो देवो वासुदेवमथाब्रवीत् ।\nवज्रनाभस्य वृत्तान्तं तमुवाच जनार्दनः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006431021, "chapter_id": 26431, "verse_number": "२-९१-२२", "content_sanskrit": "शौरेरुपस्थितो देव वाजिमेधो महाक्रतुः ।\nतस्मिन् वृत्ते वज्रनाभं पातयिष्यामि वासव ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006431022, "chapter_id": 26431, "verse_number": "२-९१-२३", "content_sanskrit": "तत्रोपायं प्रवेशे तु चिन्तयावः सतां गते ।\nनानिच्छया प्रवेशोऽस्ति तत्र वायोरपि प्रभो ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006431023, "chapter_id": 26431, "verse_number": "२-९१-२४", "content_sanskrit": "ततो गतो देवराजो वासुदेवेन सत्कृतः ।\nवाजिमेधे च सम्प्राप्ते वसुदेवस्य भारत ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006431024, "chapter_id": 26431, "verse_number": "२-९१-२५", "content_sanskrit": "तस्मिन् यज्ञे वर्तमाने प्रवेशार्थं सुरोत्तमौ ।\nचिन्तयामासतुर्वीरौ देवराजाच्युतावुभौ ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006431025, "chapter_id": 26431, "verse_number": "२-९१-२६", "content_sanskrit": "तत्र यज्ञे वर्तमाने सुनाट्येन नटस्तदा ।\nमहर्षीस्तोषयामास भद्रनामेति नामतः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006431026, "chapter_id": 26431, "verse_number": "२-९१-२७", "content_sanskrit": "तं वरेण मुनिश्रेष्ठाश्छन्दयामासुरात्मवत् ।\nस वव्रे तु नटो भद्रो वरं देवेश्वरोपमः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006431027, "chapter_id": 26431, "verse_number": "२-९१-२८", "content_sanskrit": "देवेन्द्रकृष्णच्छन्देन सरस्वत्या प्रचोदितः ।\nप्रणिपत्य मुनिश्रेष्ठानश्वमेधे समागतान् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006431028, "chapter_id": 26431, "verse_number": "२-९१-२९", "content_sanskrit": "नट उवाच\nभोज्यो द्विजानां सर्वेषां भवेयं मुनिसत्तमाः ।\nसप्तद्वीपां च पृथिवीं विचरेयमिमामहम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006431029, "chapter_id": 26431, "verse_number": "२-९१-३०", "content_sanskrit": "प्रसिद्धाकाशगमनः शक्नुवंश्च विशेषतः ।\nअवध्यः सर्वभूतानां स्थावरा ये च जङ्गमाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006431030, "chapter_id": 26431, "verse_number": "२-९१-३१", "content_sanskrit": "यस्य यस्य च वेषेण प्रविशेयमहं खलु ।\nमृतस्य जीवतो वापि भाव्येनोत्पादितस्य वा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006431031, "chapter_id": 26431, "verse_number": "२-९१-३२", "content_sanskrit": "सतूर्यस्तादृशः स्यां वै जरारोगविवर्जितः ।\nतुष्येयुर्मुनयो नित्यमन्ये च मम सर्वदा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006431032, "chapter_id": 26431, "verse_number": "२-९१-३३", "content_sanskrit": "एवमस्त्विति सम्प्रोक्तो ब्राह्मणैर्नृपते नटः ।\nसप्तद्वीपां वसुमतीं पर्यटत्यमरोपमः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006431033, "chapter_id": 26431, "verse_number": "२-९१-३४", "content_sanskrit": "पुराणि दानवेन्द्राणामुत्तरांश्च कुरूंस्तथा ।\nभद्राश्वान् केतुमालांश्च कालाम्रद्वीपमेव च ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006431034, "chapter_id": 26431, "verse_number": "२-९१-३५", "content_sanskrit": "पर्वणीषु तु सर्वासु द्वारकां यदुमण्डिताम् ।\nआयाति वरदत्तः स लोकवीरो महानटः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006431035, "chapter_id": 26431, "verse_number": "२-९१-३६", "content_sanskrit": "ततो हंसान् धार्तराष्ट्रान् देवलोकनिवासिनः ।\nउवाच भगवाञ्छक्रः सान्त्वयित्वा सुरेश्वरः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006431036, "chapter_id": 26431, "verse_number": "२-९१-३७", "content_sanskrit": "भवन्तो भ्रातरोऽस्माकं काश्यपा देवपक्षिणः ।\nविमानवाहा देवानां सुकृतीनां तथैव च ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006431037, "chapter_id": 26431, "verse_number": "२-९१-३८", "content_sanskrit": "देवानामस्ति कर्तव्यं कार्यं शत्रुवधान्वितम् ।\nतत्कर्तव्यं न मन्त्रश्च भेत्तव्यो वः कथंचन ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006431038, "chapter_id": 26431, "verse_number": "२-९१-३९", "content_sanskrit": "न कुर्वतां देवताज्ञामुग्रो दण्डः पतेदपि ।\nसर्वत्राप्रतिषिद्धं वो गमनं हंससत्तमाः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006431039, "chapter_id": 26431, "verse_number": "२-९१-४०", "content_sanskrit": "गत्वा प्रवेश्यमन्येषां वज्रनाभपुरोत्तमम् ।\nइतोऽन्तःपुरवापीषु चरध्वमुचितं हि वः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006431040, "chapter_id": 26431, "verse_number": "२-९१-४१", "content_sanskrit": "तस्यास्ति कन्यारत्नं हि त्रैलोक्यातिशयं शुभम् ।\nनाम्ना प्रभावती नाम चन्द्राभेव प्रभावती ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006431041, "chapter_id": 26431, "verse_number": "२-९१-४२", "content_sanskrit": "वरदानेन सा लब्धा मात्रा किल वरानना ।\nहैमवत्या महादेव्याः सकाशादिति नः श्रुतम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006431042, "chapter_id": 26431, "verse_number": "२-९१-४३", "content_sanskrit": "स्वयंवरा च सा कन्या बन्धुभिः स्थापिता सती ।\nआत्मेच्छया पतिं हंसा वरयिष्यति शोभना ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006431043, "chapter_id": 26431, "verse_number": "२-९१-४४", "content_sanskrit": "तद्भवद्भिर्गुणा वाच्याः प्रद्युम्नस्य महात्मनः ।\nसद्भूताः कुलरूपस्य शीलस्य वयसस्तथा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006431044, "chapter_id": 26431, "verse_number": "२-९१-४५", "content_sanskrit": "यदा सा रक्तभावा च वज्रनाभसुता सती ।\nतस्याः सकाशात् संदेशो नयितव्यः समाधिना ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006431045, "chapter_id": 26431, "verse_number": "२-९१-४६", "content_sanskrit": "प्रद्युम्नस्य पुनस्तस्मादानयध्वं तथैव च ।\nस्वबुद्ध्या प्राप्तकालं च संविधेयं हितं मम ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006431046, "chapter_id": 26431, "verse_number": "२-९१-४७", "content_sanskrit": "नेत्रवक्त्रप्रसादश्च कर्तव्यस्तत्र सर्वथा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006431047, "chapter_id": 26431, "verse_number": "२-९१-४८", "content_sanskrit": "तथा तथा गुणा वाच्याः प्रद्युम्नस्य महात्मनः ।\nयथा यथा प्रभावत्या मनस्तत्र भवेत् स्थितम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006431048, "chapter_id": 26431, "verse_number": "२-९१-४९", "content_sanskrit": "वृत्तान्तश्चानुदिवसं प्रदेयो मम सर्वथा ।\nद्वारवत्यां च कृष्णस्य भ्रातुर्मम यवीयसः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006431049, "chapter_id": 26431, "verse_number": "२-९१-५०", "content_sanskrit": "तावद्यत्नश्च कर्तव्यः प्रद्युम्नो यावदात्मवित् ।\nपर्यावर्तेद् वरारोहां वज्रनाभसुतां विभुः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006431050, "chapter_id": 26431, "verse_number": "२-९१-५१", "content_sanskrit": "अवध्यास्ते तु देवानां ब्रह्मणो वरदर्पिताः ।\nदेवपुत्रैर्हि हन्तव्याः प्रद्युम्नप्रमुखैर्युधि ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006431051, "chapter_id": 26431, "verse_number": "२-९१-५२", "content_sanskrit": "नटो दत्तवरस्तस्य वेषमास्थाय यादवाः ।\nप्रद्युम्नाद्या गमिष्यन्ति वज्रनाभविनाशनाः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006431052, "chapter_id": 26431, "verse_number": "२-९१-५३", "content_sanskrit": "एतच्च सर्वं कर्तव्यमन्यच्च सर्वमेव हि ।\nप्राप्तकालं विधातव्यमस्माकं प्रियकाम्यया ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006431053, "chapter_id": 26431, "verse_number": "२-९१-५४", "content_sanskrit": "प्रवेशस्तत्र देवानां नास्ति हंसाः कथंचन ।\nवज्रनाभेप्सिते तत्र प्रदेशे खलु सर्वथा ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]