[{"id": 7004285000, "chapter_id": 24285, "verse_number": "५-२-६३-१", "content_sanskrit": "श्रीहर उवाच ।\nधनुःसाहस्रनामानमीश्वरं शृणु पार्वति ।\nत्रिषष्टिसंख्यकं दिव्यं दर्शनात्पापनाशनम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004285001, "chapter_id": 24285, "verse_number": "५-२-६३-२", "content_sanskrit": "विदूरथोनाम नृपः ख्यातकीर्त्तिरभूद्भुवि ।\nतस्य पुत्रद्वयं जातं सुनीतिः सुमतिस्तथा॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004285002, "chapter_id": 24285, "verse_number": "५-२-६३-३", "content_sanskrit": "एकदा तु वनं यातो मृगयां स विदूरथः ।\nददर्श गर्त्तं सुमहद्भूमेर्मुखमिवोद्गतम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004285003, "chapter_id": 24285, "verse_number": "५-२-६३-४", "content_sanskrit": "तं दृष्ट्वा चिंतयामास किमेतदिति पार्थिवः ।\nपातालविवरं मन्ये वडवानलसंनिभम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004285004, "chapter_id": 24285, "verse_number": "५-२-६३-५", "content_sanskrit": "चिंतयन्निव तत्रासौ ददर्श विजने वने ।\nब्राह्मणं सुव्रतं नाम तपस्विनमकल्मषम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004285005, "chapter_id": 24285, "verse_number": "५-२-६३-६", "content_sanskrit": "स तं पप्रच्छ नृपतिः किमेतदिति भो द्विज॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004285006, "chapter_id": 24285, "verse_number": "५-२-६३-७", "content_sanskrit": "ब्राह्मण उवाच ।\nदानवः सुमहावीर्यो वसत्युग्रो रसातले ।\nकुजंभोनाम विख्यातो भिनत्ति वसुधामिमाम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004285007, "chapter_id": 24285, "verse_number": "५-२-६३-८", "content_sanskrit": "तमजित्वा कथं राज्यं भोक्ष्यसे वसुधाधिप ।\nतेन विध्वंसिता विप्रा रात्रौ निःसृत्य पार्थिव॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004285008, "chapter_id": 24285, "verse_number": "५-२-६३-९", "content_sanskrit": "उपद्रुतास्तथा देशा ध्वस्ताश्चैव तथाश्रमाः ।\nआप्याययति दैत्योऽयं सबली मुशलायुधः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004285009, "chapter_id": 24285, "verse_number": "५-२-६३-१०", "content_sanskrit": "यदि त्वं घातयस्येनं पातालांतरगोचरम् ।\nततः समस्तवसुधापतिरेव भविष्यसि॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004285010, "chapter_id": 24285, "verse_number": "५-२-६३-११", "content_sanskrit": "इति विप्र वचः श्रुत्वा मंत्रयामास पार्थिवः ।\nमंत्रिभिः सहितोऽमोघं श्रुत्वा मुशलमद्रिजे॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004285011, "chapter_id": 24285, "verse_number": "५-२-६३-१२", "content_sanskrit": "तं मंत्रं क्रियमाणं तु सूनुभ्यां सह मंत्रिभिः ।\nतत्पार्श्ववर्त्तिनी कन्या शुश्रावाथ मुदावती॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004285012, "chapter_id": 24285, "verse_number": "५-२-६३-१३", "content_sanskrit": "ततः कतिपयाहे तु तां कन्यां जलजेक्षणाम् ।\nजहारोपवनाद्दैत्यः कुजंभः स्वसखीवृताम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004285013, "chapter_id": 24285, "verse_number": "५-२-६३-१४", "content_sanskrit": "एतच्छ्रुत्वा महीपालः क्रोधपर्याकुलेक्षणः ।\nउवाच पुत्रौ जानेऽहं सकुजंभो महासुरः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004285014, "chapter_id": 24285, "verse_number": "५-२-६३-१५", "content_sanskrit": "दृष्ट्वा भूमौ पुरा गत्तें तत्र संशयिते मयि ।\nकथितो द्विजमुख्येन मया पृष्टेन पुत्रकौ॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004285015, "chapter_id": 24285, "verse_number": "५-२-६३-१६", "content_sanskrit": "स हन्यतां सोऽपहर्त्ता मुदावत्याः सुदुर्मतिः ।\nप्रस्थितौ नृपभक्त्याथ स्वसैन्यपरिवारितौ॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004285016, "chapter_id": 24285, "verse_number": "५-२-६३-१७", "content_sanskrit": "तौ सुतौ तत्र संप्राप्तौ पाताले पितृशासनात् ।\nयुयुधाते कुजंभेन स्वशक्त्या सेनया वृतौ॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004285017, "chapter_id": 24285, "verse_number": "५-२-६३-१८", "content_sanskrit": "ततः परिघनिस्त्रिंशशक्तिशूलपरश्वधैः ।\nबाणैश्चिरतरं युद्धं तेषामासीत्सदारुणम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004285018, "chapter_id": 24285, "verse_number": "५-२-६३-१९", "content_sanskrit": "ततो मायाबलवता तेन दैत्येन तत्क्षणात् ।\nअमोघेनाद्वितीयेन मुशलेन वरानने॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004285019, "chapter_id": 24285, "verse_number": "५-२-६३-२०", "content_sanskrit": "हत सैन्यौ रणे बद्धौ राजपुत्रौ महाबलौ॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004285020, "chapter_id": 24285, "verse_number": "५-२-६३-२१", "content_sanskrit": "ततः श्रुत्वा महीपालो विवर्णवदनोऽभवत् ।\nबद्धपुत्रः परामार्त्तिं जगाम गिरिपुत्रिके॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004285021, "chapter_id": 24285, "verse_number": "५-२-६३-२२", "content_sanskrit": "रुरोद बहुधात्यर्थं पुत्रस्नेहेन पार्थिवः ।\nततो विलपतस्तस्य मार्कंडेयो महामुनिः ।\nअनेकसृष्टिसंहारदृष्टकार्यपरावरः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004285022, "chapter_id": 24285, "verse_number": "५-२-६३-२३", "content_sanskrit": "उदितादित्यसंकाशः सप्तकल्पानुगो वशी ।\nआजगाम नृपाभ्याशे विलपंतं ददर्श सः ।\nराजानं कथयामास त्रिकालज्ञो महामुनिः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004285023, "chapter_id": 24285, "verse_number": "५-२-६३-२४", "content_sanskrit": "मा शुचस्त्वं महीपाल क्षत्त्रियोऽसि दृढव्रतः ।\nक्व शोक क्व महीपालो दुर्जयो लोकपालवत्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004285024, "chapter_id": 24285, "verse_number": "५-२-६३-२५", "content_sanskrit": "शोकं कुपुरुषाचीर्णं त्यज त्वं राजसत्तम ।\nउद्यमं कुरु राजेंद्र कुजंभं घातयिष्यसि॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004285025, "chapter_id": 24285, "verse_number": "५-२-६३-२६", "content_sanskrit": "नात्युच्चं मेरुशिखरं नातिनीचं रसातलम् ।\nव्यवसायः सखा यस्य नास्ति दूरे महोदधिः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004285026, "chapter_id": 24285, "verse_number": "५-२-६३-२७", "content_sanskrit": "महाकालवने लिंगमाराधय समाहितः ।\nरूपेश्वरस्य देवस्य पार्श्वे दक्षिणतः स्थितम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004285027, "chapter_id": 24285, "verse_number": "५-२-६३-२८", "content_sanskrit": "धनुःसाहस्रतुल्यं तु मुशलस्य निवारणम् ।\nधनुः प्राप्स्यसि राजेंद्र कुजंभं विनिपातय॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004285028, "chapter_id": 24285, "verse_number": "५-२-६३-२९", "content_sanskrit": "धनुःसाहस्रहस्तैस्तु रक्षितं योधसत्तमैः ।\nलिंगं देवासुरैर्युद्धे सहस्राक्षेण सेवितम् ।\nइंद्रेण च धनुर्लब्धं जंभो वै येन पातितः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004285029, "chapter_id": 24285, "verse_number": "५-२-६३-३०", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा स राजाथ विदूरथः ।\nजगाम त्वरितो देवि महाकालवनं शुभम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004285030, "chapter_id": 24285, "verse_number": "५-२-६३-३१", "content_sanskrit": "ददर्श तत्र तल्लिंगं पूजयामास भक्तितः ।\nतस्य तुष्टस्तदा देवो ददौ दिव्यं धनुस्तदा॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004285031, "chapter_id": 24285, "verse_number": "५-२-६३-३२", "content_sanskrit": "धनुःसाहस्रतुल्यं च मुशलस्य निवारणम् ।\nधनुर्लब्ध्वा तदा राजा बद्धगोधांगुलित्रवान् ।\nजगाम धीरः पातालं तेन गर्तेन सत्वरम्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004285032, "chapter_id": 24285, "verse_number": "५-२-६३-३३", "content_sanskrit": "ततो ज्यास्वनमत्युग्रं स चक्रे पार्थिवस्तदा ।\nयेन पातालमखिलमासीदापूरितांतरम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004285033, "chapter_id": 24285, "verse_number": "५-२-६३-३४", "content_sanskrit": "ततो ज्यास्वनमाकर्ण्य कुजंभो दानवेश्वरः ।\nआजगामातिकोपेन स्वसैन्यपरिवारितः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004285034, "chapter_id": 24285, "verse_number": "५-२-६३-३५", "content_sanskrit": "ततो युद्धमभूत्तस्य सह राज्ञा वरानने ।\nदिनानि त्रीणि स यदा योधितस्तेन दानवः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004285035, "chapter_id": 24285, "verse_number": "५-२-६३-३६", "content_sanskrit": "ततः कोपपरीतात्मा मुशलायाभ्यधावत ।\nगंधैर्माल्यैस्तथा धूपैः पूज्यमानः स तिष्ठति॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004285036, "chapter_id": 24285, "verse_number": "५-२-६३-३७", "content_sanskrit": "यावद्गृह्णाति मुशलं तावत्सा च मुदावती ।\nपस्पर्श चंदनव्याजैरनेकैश्च पुनःपुनः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004285037, "chapter_id": 24285, "verse_number": "५-२-६३-३८", "content_sanskrit": "ततः स गत्वा युयुधे मुसलेनासुरेश्वरः ।\nतदा मुसलपातास्ते धनुषा निष्प्रभीकृताः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004285038, "chapter_id": 24285, "verse_number": "५-२-६३-३९", "content_sanskrit": "धनुर्ज्याघातशब्देन पतिते भूतले तदा ।\nगतो वैवस्वतं लोकं कुजंभोनाम दानवः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004285039, "chapter_id": 24285, "verse_number": "५-२-६३-४०", "content_sanskrit": "ततोऽपतत्पुष्पवृष्टिस्तस्योपरि महीपतेः ।\nजगुर्गंधर्वपतयो देववाद्यानि सस्वनुः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004285040, "chapter_id": 24285, "verse_number": "५-२-६३-४१", "content_sanskrit": "स चापि राजा तं हत्वा पुत्रौ लब्ध्वा सुतां तदा ।\nमुदावतीं मुदा युक्तो हर्षगद्गदनिर्भरः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004285041, "chapter_id": 24285, "verse_number": "५-२-६३-४२", "content_sanskrit": "पुत्राभ्यां सहितो देवि सुसंपूर्णमनोरथः ।\nसांतःपुरपरीवारः पुनरायाद्वरानने॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004285042, "chapter_id": 24285, "verse_number": "५-२-६३-४३", "content_sanskrit": "महाकालवने रम्ये यत्र तल्लिंगमुत्तमम् ।\nपूजयामास रत्नैश्च वस्त्रैराभरणैस्तथा॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004285043, "chapter_id": 24285, "verse_number": "५-२-६३-४४", "content_sanskrit": "ततः स पूजितो देवैः शक्रेण च पुनःपुनः ।\nअस्य लिंगस्य माहात्म्याद्धनुः प्राप्तं नृपेण ३॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004285044, "chapter_id": 24285, "verse_number": "५-२-६३-४५", "content_sanskrit": "कुजंभोऽपि हतो दैत्यो देवविद्वेषकारकः ।\nधनुःसाहस्रनामायमतः ख्यातिं गमिष्यति॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004285045, "chapter_id": 24285, "verse_number": "५-२-६३-४६", "content_sanskrit": "भक्त्या ये पूजयिष्यंति धनुःसाहस्रमीश्वरम् ।\nयास्यन्ति शत्रवस्तेषां क्षयं नैवात्र संशयः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004285046, "chapter_id": 24285, "verse_number": "५-२-६३-४७", "content_sanskrit": "अर्चिते देवदेवेशे धनुःसाहस्रिके शिवे ।\nअर्चिताः सर्वदेवाः स्युर्वरदाश्च न संशयः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004285047, "chapter_id": 24285, "verse_number": "५-२-६३-४८", "content_sanskrit": "प्रातर्मध्येऽपराह्णे च धनुःसाहस्रकं शिवम् ।\nये नमन्ति नरा नित्यं न ते नरकभोगिनः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004285048, "chapter_id": 24285, "verse_number": "५-२-६३-४९", "content_sanskrit": "तीर्थानां च यथा गंगा रक्षिता योधसत्तमैः ।\nतथायं रक्षको देवो नाम्ना धनुःसहस्रकः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004285049, "chapter_id": 24285, "verse_number": "५-२-६३-५०", "content_sanskrit": "तत्र गंगादितीर्थानि विद्यन्ते विविधानि च ।\nसुरहस्यातिपुण्यानि सद्यः पापहराणि च॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004285050, "chapter_id": 24285, "verse_number": "५-२-६३-५१", "content_sanskrit": "तेषां फलं विनिर्दिष्टं ये पश्यन्ति तु भक्तितः ।\nधनुःसाहस्रकं नाम सदा शत्रुक्षयंकरम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004285051, "chapter_id": 24285, "verse_number": "५-२-६३-५२", "content_sanskrit": "एष ते कथितो देवि प्रभावः पापना शनः ।\nधनुःसाहस्रदेवस्य देवं पशुपतिं शृणु॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]