[{"id": 2072791, "chapter_id": 2538, "verse_number": "१२-४३-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2072792, "chapter_id": 2538, "verse_number": "१२-४३-१", "content_sanskrit": "ततो विसर्जयामास सर्वास्ताः प्रकृतीर्नृपः।\nविविशुश्चाभ्यनुज्ञाता यथास्वानि गृहाणि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2072793, "chapter_id": 2538, "verse_number": "१२-४३-२", "content_sanskrit": "ततो युधिष्ठिरो राजा भीमं भीमपराक्रमम्।\nसान्त्वयन्नब्रवीच्छ्रीमानर्जुनं यमजौ तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2072794, "chapter_id": 2538, "verse_number": "१२-४३-३", "content_sanskrit": "शत्रुभिर्विविधैः शस्त्रैः क्षतदेहा महारणे।\nश्रान्ता भवन्तः सुभृशं तापिताः शोकमन्युभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2072795, "chapter_id": 2538, "verse_number": "१२-४३-४", "content_sanskrit": "अरण्ये दुःखवसतिर्मत्कृते भरतर्षभाः।\nभवद्भिरनुभूता हि यथा कापुरुषैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2072796, "chapter_id": 2538, "verse_number": "१२-४३-५", "content_sanskrit": "यथासुखं यथाजोषं जयोऽयमनुभूयताम्।\nविश्रान्ताँल्लब्धविश्वासाञ्श्वः समेताऽस्मि वः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2072797, "chapter_id": 2538, "verse_number": "१२-४३-६", "content_sanskrit": "ततो दुर्योधनगृहं प्रासादैरुपशोभितम्।\nबहुरत्नसमाकीर्णं दासीदाससमाकुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2072798, "chapter_id": 2538, "verse_number": "१२-४३-७", "content_sanskrit": "धृतराष्ट्राभ्यनुज्ञातं भ्रात्रा दत्तं वृकोदरः।\nप्रतिपेदे महाबाहुर्मन्दिरं मघवानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2072799, "chapter_id": 2538, "verse_number": "१२-४३-८", "content_sanskrit": "यथा दुर्योधनगृहं तथा दुःशासनस्य तु।\nप्रासादभालासंयुक्तं हेमतोरणभूषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2072800, "chapter_id": 2538, "verse_number": "१२-४३-९", "content_sanskrit": "दासीदाससुसंपूर्णं प्रभूतधनधान्यवत्।\nप्रतिपेदे महाबाहुरर्जुनो राजशासनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2072801, "chapter_id": 2538, "verse_number": "१२-४३-१०", "content_sanskrit": "दुर्मर्षणस्य भवनं दुःशासनगृहाद्वरम्।\nकुबेरभवनप्रख्यं मणिहेमविभूषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2072802, "chapter_id": 2538, "verse_number": "१२-४३-११", "content_sanskrit": "नकुलाय वरार्हाय कर्शिताय महावने।\nददौ प्रीतो महाराज धर्मपुत्रो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2072803, "chapter_id": 2538, "verse_number": "१२-४३-१२", "content_sanskrit": "दुर्मुखस्य च वेश्माग्र्यं श्रीमत्कनकभूषणम्।\nपूर्णपझदलाक्षीणां स्त्रीणां शयनसंकुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2072804, "chapter_id": 2538, "verse_number": "१२-४३-१३", "content_sanskrit": "प्रददौ सहदेवाय संततं प्रियकारिणे।\nमुमुदे तच्च लब्ध्वाऽसौ कैलासं धनदो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2072805, "chapter_id": 2538, "verse_number": "१२-४३-१४", "content_sanskrit": "युयुत्सुर्विदुरश्चैव सञ्जयश्च विशांपते।\nसुधर्मा चैव धौम्यश्च यथा स्वाञ्जग्मुरालयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2072806, "chapter_id": 2538, "verse_number": "१२-४३-१५", "content_sanskrit": "सह सात्यकिना शौरिरर्जुनस्य निवेशनम्।\nविवेश पुरुषव्याघ्रो व्याघ्रो गिरिगुहामिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2072807, "chapter_id": 2538, "verse_number": "१२-४३-१६", "content_sanskrit": "तत्र भक्ष्यान्नपानैस्ते मुदिताः सुसुखोषिताः।\nसुखप्रबद्धा राजानमुपतस्थुर्युधिष्ठिरम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2072808, "chapter_id": 2538, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि त्रिचत्वारिंशोऽध्यायः॥ ४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]