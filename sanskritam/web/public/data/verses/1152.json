[{"id": 2007865, "chapter_id": 1152, "verse_number": "१-१५३-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2007866, "chapter_id": 1152, "verse_number": "१-१५३-१", "content_sanskrit": "श्रुत्वा पाण्डुसुतान्वीरान्बलोद्रिक्तान्महौजसः।\nधृतराष्ट्रो महीपालश्चिन्तामगमदातुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2007867, "chapter_id": 1152, "verse_number": "१-१५३-२", "content_sanskrit": "तत आहूय मन्त्रज्ञं राजशास्त्रार्थवित्तमम्।\nकणिकं मन्त्रिणां श्रेष्ठं धृतराष्ट्रऽब्रवीद्वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2007868, "chapter_id": 1152, "verse_number": "१-१५३-३", "content_sanskrit": "उत्सक्ताः पाण्डवा नित्यं तेभ्योऽसूये द्विजोत्तम।\nतत्र मे निश्चिततमं सन्धिविग्रहकारणम्।\nकणिक त्वं ममाचक्ष्व करिष्ये वचनं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2007869, "chapter_id": 1152, "verse_number": "१-१५३-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2007870, "chapter_id": 1152, "verse_number": "१-१५३-४", "content_sanskrit": "दुर्योधनोऽथ शकुनिः कर्णदुःशासनावपि।\nकणिकं ह्युपसंगृह्य मन्त्रिणं सौबलस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2007871, "chapter_id": 1152, "verse_number": "१-१५३-५", "content_sanskrit": "पप्रच्छुर्भरतश्रेष्ठ पाण्डवान्प्रति नैकधा।\nप्रबुद्धाः पाण्डवा नित्यं सर्वे तेभ्यस्त्रसामहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2007872, "chapter_id": 1152, "verse_number": "१-१५३-६", "content_sanskrit": "अनूनं सर्वपक्षाणां यद्भवेत्क्षेमकारकम्।\nभारद्वाज तदाचक्ष्व करिष्यामः कथं वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2007873, "chapter_id": 1152, "verse_number": "१-१५३-७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2007874, "chapter_id": 1152, "verse_number": "१-१५३-७", "content_sanskrit": "स प्रसन्नमनास्तेन परिपृष्टो द्विजोत्तमः।\nउवाच वचनं तीक्ष्णं राजशास्त्रार्थदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2007875, "chapter_id": 1152, "verse_number": "१-१५३-८x", "content_sanskrit": "कणिक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2007876, "chapter_id": 1152, "verse_number": "१-१५३-८", "content_sanskrit": "शृणु राजन्निदं तत्र प्रोच्यमानं मयानघ।\nन मेऽभ्यसूया कर्तव्या श्रुत्वैतत्कुरुसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2007877, "chapter_id": 1152, "verse_number": "१-१५३-९", "content_sanskrit": "नित्यमुद्यतदण्डः स्यान्नित्यं विवृतपौरुषः।\nअच्छिद्रश्छिद्रदर्शी स्यात्परेषां विवरानुगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2007878, "chapter_id": 1152, "verse_number": "१-१५३-१०", "content_sanskrit": "नित्यमुद्यतदण्डाद्धि भऋशमुद्विजते जनः।\nतस्मात्सर्वाणि कार्याणि दण्डेनैव विधारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2007879, "chapter_id": 1152, "verse_number": "१-१५३-११", "content_sanskrit": "नास्य च्छिद्रं परः पश्येच्छिद्रेण परमन्वियात्।\nगूहेत्कूर्म इवाङ्गानि रक्षेद्विवरमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2007880, "chapter_id": 1152, "verse_number": "१-१५३-१२", "content_sanskrit": "नित्यं च ब्राह्मणाः पूज्या नृपेण हितमिच्छता।\nसृष्टो नृपो हि विप्रामां पालने दुष्टनिग्रहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2007881, "chapter_id": 1152, "verse_number": "१-१५३-१३", "content_sanskrit": "उभाब्यां वर्धते धर्मो धर्मवृद्ध्या जितावुभौ।\nलोकश्चायं परश्चैव ततो धर्मं समाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2007882, "chapter_id": 1152, "verse_number": "१-१५३-१४", "content_sanskrit": "कृतापराधं पुरुषं दृष्ट्वा यः क्षमते नृपः।\nतेनावमानमाप्नोति पापं चेह परत्र च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2007883, "chapter_id": 1152, "verse_number": "१-१५३-१५", "content_sanskrit": "यो विभूतिमवाप्योच्चै राज्ञो विकुरुतेऽधमः।\nतमानयित्वा हत्वा च दद्याद्धीनाय तद्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2007884, "chapter_id": 1152, "verse_number": "१-१५३-१६", "content_sanskrit": "नो चेद्धुरि नियुक्ता ये स्थास्यन्ति वशमात्मनः।\nराजा नियुञ्ज्यात्पुरुषानाप्तान्धर्मार्थकोविदान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2007885, "chapter_id": 1152, "verse_number": "१-१५३-१७", "content_sanskrit": "ये नियुक्तास्तथा केचिद्राष्ट्रं वा यदि वा पुरम्।\nग्रामं जनपदं वापि बाधेयुर्यदि वा न वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2007886, "chapter_id": 1152, "verse_number": "१-१५३-१८", "content_sanskrit": "परीक्षणार्थं विसृजेदानतांश्छन्नरूपिणः।\nपरीक्ष्य पापकं जह्याद्धनमादाय सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2007887, "chapter_id": 1152, "verse_number": "१-१५३-१९", "content_sanskrit": "नासम्यक्कृत्यकारी स्यादुपक्रम्य कदाचन।\nकण्टको ह्यपि दुश्छिन्न आस्रावं जनयेच्चिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2007888, "chapter_id": 1152, "verse_number": "१-१५३-२०", "content_sanskrit": "वधमेव प्रशंसन्ति शत्रूणामपकारिणाम्।\nसुविदीर्णं सुविक्रान्तं सुयुद्धं सुपलायितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2007889, "chapter_id": 1152, "verse_number": "१-१५३-२१", "content_sanskrit": "आपद्यापदि काले कुर्वीत न विचारयेत्।\nनावज्ञेयो रिपुस्तात दुर्बलोऽपि कथं चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2007890, "chapter_id": 1152, "verse_number": "१-१५३-२२", "content_sanskrit": "अल्पोऽप्यग्निर्वनं कृत्स्नं दहत्याश्रयसंश्रयात्।\nअन्धः स्यादन्धवेलायां बाधिर्यमपि चाश्रयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2007891, "chapter_id": 1152, "verse_number": "१-१५३-२३", "content_sanskrit": "कुर्यात्तृणमयं चापं शयीत मृगशायिकाम्।\nसान्त्वादिभिरुपायैस्तु हन्याच्छत्रुं वशे स्थितं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2007892, "chapter_id": 1152, "verse_number": "१-१५३-२४", "content_sanskrit": "दया न तस्मिन्कर्तव्या शरणागत इत्युत।\nनिरुद्विग्नो हि भवति न हताज्जायते भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2007893, "chapter_id": 1152, "verse_number": "१-१५३-२५", "content_sanskrit": "हन्यादमित्रं दानेन तथा पूर्वापकारिणम्।\nहन्यात्त्रीन्पञ्च सप्तेति परपक्षस्य सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2007894, "chapter_id": 1152, "verse_number": "१-१५३-२६", "content_sanskrit": "मूलमेवादितश्छिन्द्यात्परपक्षस्य नित्यशः।\nततः सहायांस्तत्पक्षान्सर्वांश्च तदनन्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2007895, "chapter_id": 1152, "verse_number": "१-१५३-२७", "content_sanskrit": "छिन्नमूले ह्यधिष्ठाने सर्वे तज्जीविनो हताः।\nकथं नु शाखास्तिष्ठेरंश्छिन्नमूले वनस्पतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2007896, "chapter_id": 1152, "verse_number": "१-१५३-२८", "content_sanskrit": "एकाग्रः स्यादविवृतो नित्यं विवरदर्शकः।\nराजन्नित्यं सपत्नेषु नित्योद्विग्नः समाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2007897, "chapter_id": 1152, "verse_number": "१-१५३-२९", "content_sanskrit": "अग्न्याधानेन यज्ञेन काषायेण जटाजिनैः।\nलोकान्विश्वासयित्वैव ततो लुम्पेद्यथा वृकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2007898, "chapter_id": 1152, "verse_number": "१-१५३-३०", "content_sanskrit": "अङ्कुशं शोचमित्याहुरर्थानामुपधारणे।\nआनाम्य फलितां शाखां पक्वं पक्वं प्रशातयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2007899, "chapter_id": 1152, "verse_number": "१-१५३-३१", "content_sanskrit": "फलार्थोऽयं समारम्भो लोके पुंसां विपश्चिताम्।\nवहेदमित्रं स्कन्धेन यावत्कालस्य पर्ययः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2007900, "chapter_id": 1152, "verse_number": "१-१५३-३२", "content_sanskrit": "ततः प्रत्यागते काले भिन्द्याद्धृटमिवाश्मनि।\nअमित्रो न विमोक्तव्यः कृपणं बह्वपि ब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2007901, "chapter_id": 1152, "verse_number": "१-१५३-३३", "content_sanskrit": "कृपा न तस्मिन्कर्तव्या हन्यादेवापकारिणम्।\nहन्यादमित्रं सान्त्वेन तथा दानेन वा पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2007902, "chapter_id": 1152, "verse_number": "१-१५३-३४", "content_sanskrit": "तथैव भेददण्डाभ्यां सर्वोपायैः प्रशातयेत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2007903, "chapter_id": 1152, "verse_number": "१-१५३-३४x", "content_sanskrit": "धृतराष्ट्र उवाच।\nकथं सान्त्वेन दानेन भेदैर्दण्डेन वा पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2007904, "chapter_id": 1152, "verse_number": "१-१५३-३५", "content_sanskrit": "अमित्रः शक्यते हन्तुं तन्मे ब्रूहि यथातथम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2007905, "chapter_id": 1152, "verse_number": "१-१५३-३५x", "content_sanskrit": "कणिक उवाच।\nशृणु राजन्यथा वृत्तं वने निवसतः पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2007906, "chapter_id": 1152, "verse_number": "१-१५३-३६", "content_sanskrit": "जम्बुकस्य महाराज नीतिशास्त्रार्थदर्शिनः।\nअथ कश्चित्कृतप्रज्ञः शृगालः स्वार्थपण्डितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2007907, "chapter_id": 1152, "verse_number": "१-१५३-३७", "content_sanskrit": "सखिभिर्न्यवसत्सार्धं व्याघ्राखुवृकबभ्रुभिः।\nतेऽपश्यन्विपिने तस्मिन्बलिनं मृगयूथपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2007908, "chapter_id": 1152, "verse_number": "१-१५३-३८", "content_sanskrit": "अशक्ता ग्रहणे तस्य ततो मन्त्रममन्त्रयन्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2007909, "chapter_id": 1152, "verse_number": "१-१५३-३८x", "content_sanskrit": "जम्बुक उवाच।\nअसकृद्यतितो ह्येष हन्तुं व्याघ्र वने त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2007910, "chapter_id": 1152, "verse_number": "१-१५३-३९", "content_sanskrit": "युवा वै जवसंपन्नो बुद्धिशाली न शक्यते।\nमूषिकोऽस्य शयानस्य चरणौ भक्षयत्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2007911, "chapter_id": 1152, "verse_number": "१-१५३-४०", "content_sanskrit": "अथैनं भक्षितैः पादैर्व्याघ्रो गृह्णातु वै ततः।\nततो वै भक्षयिष्यामः सर्वे मुदितमानसाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2007912, "chapter_id": 1152, "verse_number": "१-१५३-४१", "content_sanskrit": "जम्बुकस्य तु तद्वाक्यं तथा चक्रः समाहिताः।\nमूषिकाभक्षितैः पादैर्मृगं व्याघ्रोऽवधीत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2007913, "chapter_id": 1152, "verse_number": "१-१५३-४२", "content_sanskrit": "दृष्ट्वैवाचेष्टमानं तु भूमौ मृगकलेवरम्।\nस्नात्वाऽऽगच्छत भद्रं वोरक्षामीत्याह जम्बुकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2007914, "chapter_id": 1152, "verse_number": "१-१५३-४३", "content_sanskrit": "शृगालवचनात्तेऽपि गताः सर्वे नदीं ततः।\nस चिन्तापरमो भूत्वा तस्थौ तत्रैव जम्बुकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2007915, "chapter_id": 1152, "verse_number": "१-१५३-४४", "content_sanskrit": "अथाजगाम पूर्वं तु स्नात्वा व्याघ्रो महाबलः।\nददर्श जम्बुकं चैव चिन्ताकुलितमानसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2007916, "chapter_id": 1152, "verse_number": "१-१५३-४५x", "content_sanskrit": "व्याघ्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2007917, "chapter_id": 1152, "verse_number": "१-१५३-४५", "content_sanskrit": "किं शोचसि महाप्राज्ञ त्वं नो बुद्धिमतां वरः।\nअशित्वा पिशितान्यद्य विहरिष्यामहे वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2007918, "chapter_id": 1152, "verse_number": "१-१५३-४६x", "content_sanskrit": "जम्बुक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2007919, "chapter_id": 1152, "verse_number": "१-१५३-४६", "content_sanskrit": "शृणु मे त्वं महाबाहो यद्वाक्यं मूषिकोऽब्रवीत्।\nधिग्बलं मृगराजस्य मयाद्यायं मृगो हतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2007920, "chapter_id": 1152, "verse_number": "१-१५३-४७", "content_sanskrit": "मद्बाहुबलमाश्रित्य तृप्तिमद्य गमिष्यति।\nतस्यैवं गर्जितं श्रुत्वा ततो भक्ष्यं न रोचये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2007921, "chapter_id": 1152, "verse_number": "१-१५३-४८x", "content_sanskrit": "व्याघ्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2007922, "chapter_id": 1152, "verse_number": "१-१५३-४८", "content_sanskrit": "ब्रवीति यदि स ह्येवं काले ह्यस्मि प्रबोधितः।\nस्वबाहुबलमाश्रित्य हनिष्येऽहं वनेचरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2007923, "chapter_id": 1152, "verse_number": "१-१५३-४९", "content_sanskrit": "खादिष्ये तत्र मांसानि इत्युक्त्वा प्रस्थितोवनम्।\nएतस्मिन्नेव काले तु मूषिकोऽप्याजगाम ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2007924, "chapter_id": 1152, "verse_number": "१-१५३-५०", "content_sanskrit": "तमागतमभिप्रेक्ष्य शृगालोऽप्यब्रवीद्वचः।\nशृणु मीषिक भद्रं ते नकुलो यदिहाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2007925, "chapter_id": 1152, "verse_number": "१-१५३-५१", "content_sanskrit": "मृगमांसं न खादेयं गरमेतन्न रोचते।\nमूषिकं भक्षयिष्यामि तद्भवाननुमन्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2007926, "chapter_id": 1152, "verse_number": "१-१५३-५२", "content_sanskrit": "तच्छ्रुत्वा मूषिको वाक्यं संत्रस्तः प्रगतो बिलम्।\nततः स्नात्वा स वै तत्र आजगाम वृको नपृ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2007927, "chapter_id": 1152, "verse_number": "१-१५३-५३", "content_sanskrit": "तमागतमिदं वाक्यमब्रवीज्जम्बुकस्तदा।\nमृगराजो हि संक्रुद्धो न ते साधु भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2007928, "chapter_id": 1152, "verse_number": "१-१५३-५४", "content_sanskrit": "सकलत्रस्त्विहायाति कुरुष्व यदनन्तरम्।\nएवं संचोदितस्तेन जम्बुकेन तदा वृकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2007929, "chapter_id": 1152, "verse_number": "१-१५३-५५", "content_sanskrit": "ततोऽवलुम्पनं कृत्वा प्रयातः पिशिताशनः।\nएतस्मिन्नेव काले तु नकुलोऽप्याजगाम ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2007930, "chapter_id": 1152, "verse_number": "१-१५३-५६", "content_sanskrit": "तमुवाच महाराज नकुलं जम्बुको वने।\nस्वबाहुबलमाश्रित्य निर्जितास्तेऽन्यतो गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2007931, "chapter_id": 1152, "verse_number": "१-१५३-५७", "content_sanskrit": "मम दत्वा नियुद्धं त्वं भुङ्क्ष्व मांसं यथेप्सितम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2007932, "chapter_id": 1152, "verse_number": "१-१५३-५७x", "content_sanskrit": "नकुल उवाच।\nमृगराजो वृकश्चैव बुद्धिमानपि मूषिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2007933, "chapter_id": 1152, "verse_number": "१-१५३-५८", "content_sanskrit": "निर्जिता यत्त्वया वीरास्तस्माद्वीरतरो भवान्।\nन त्वयाप्युत्सहे योद्धुमित्युक्त्वा सोऽप्युपागमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2007934, "chapter_id": 1152, "verse_number": "१-१५३-५९x", "content_sanskrit": "कणिक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2007935, "chapter_id": 1152, "verse_number": "१-१५३-५९", "content_sanskrit": "एवं तेषु प्रयातेषु जम्बुको हृष्टमानसः।\nखादति स्म तदा मांसमेकः सन्मन्त्रनिश्चयात्।\nएवं समाचरन्नित्यं सुखमेधेत भूपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2007936, "chapter_id": 1152, "verse_number": "१-१५३-६०", "content_sanskrit": "भयेन भेदयेद्भीरुं शूरमञ्जलिकर्मणा।\nलुब्धमर्थप्रदानेन समं न्यूनं तथौजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2007937, "chapter_id": 1152, "verse_number": "१-१५३-६१", "content_sanskrit": "एवं ते कथितं राजन् शृणु चाप्यपरं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2007938, "chapter_id": 1152, "verse_number": "१-१५३-६२", "content_sanskrit": "पुत्रः सखा वा भ्राता वा पिता वा यदि वा गुरुः।\nरिपुस्यानेषु वर्तन्तो हन्तव्या भूतिमिच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2007939, "chapter_id": 1152, "verse_number": "१-१५३-६३", "content_sanskrit": "शपथेनाप्यरिं हन्यादर्थदानेन वा पुनः।\nविषेण मायया वापि नोपेक्षेते कथंचन।\nउभौ चेत्संशयोपेतौ श्रद्धवांस्तत्र वर्धते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2007940, "chapter_id": 1152, "verse_number": "१-१५३-६४", "content_sanskrit": "गुरोरप्यवलिप्तस्य कार्याकार्यमजानतः।\nउत्पथं प्रतिपन्नस्य न्याय्यं भवति शासनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2007941, "chapter_id": 1152, "verse_number": "१-१५३-६५", "content_sanskrit": "क्रुद्धोऽप्यक्रुद्धरूपः स्यात्स्मितपूर्वाभिभाषिता।\nन चैनं क्रोधसंदीप्तं विद्यात्कश्चित्कथंचन।\nन चाप्यन्यमपध्वंसेत्कदाचित्कोपसंयुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2007942, "chapter_id": 1152, "verse_number": "१-१५३-६६", "content_sanskrit": "प्रहरिष्यन्प्रियं ब्रूयात्प्रहरन्नपि भारत।\nप्रहृत्य च प्रियं ब्रूयाच्छोचन्निव रुदन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2007943, "chapter_id": 1152, "verse_number": "१-१५३-६७", "content_sanskrit": "आश्वासयेच्चापि परं सान्त्वधर्मार्थवृत्तिभिः।\nअथ तं प्रहरेत्काले तथा विचलितं पथि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2007944, "chapter_id": 1152, "verse_number": "१-१५३-६८", "content_sanskrit": "अपि घोरापराधस्य धर्ममाश्रित्य तिष्ठतः।\nस हि प्रच्छाद्यते दोषः शैलो मेघैरिवासितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2007945, "chapter_id": 1152, "verse_number": "१-१५३-६९", "content_sanskrit": "यः स्यादनुप्राप्तवधस्तस्यागारं प्रदीपयेत्।\nअधनान्नास्तिकांश्चोरान्विषकर्मसु योजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2007946, "chapter_id": 1152, "verse_number": "१-१५३-७०", "content_sanskrit": "प्रत्युत्थानासनाद्येन संप्रदानेन केनचित्।\nअतिविश्रब्धघाती स्यात्तीक्ष्णंदष्ट्रो निमग्नकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2007947, "chapter_id": 1152, "verse_number": "१-१५३-७१", "content_sanskrit": "अशङ्कितेभ्यः शङ्केत शङ्कितेभ्यश्च सर्वशः।\nअशङ्क्याद्भयमुत्पन्नमपि मूलं निकृन्तति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2007948, "chapter_id": 1152, "verse_number": "१-१५३-७२", "content_sanskrit": "न विश्वसेदविश्वस्ते विश्वस्ते नातिविश्वसेत्।\nविश्वासाद्भयमुत्पन्नं मूलान्यपि निकृन्तति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2007949, "chapter_id": 1152, "verse_number": "१-१५३-७३", "content_sanskrit": "चारः सुविहितः कार्य आत्मनश्च परस्य वा।\nपाषण्डांस्तापसादींश्च परराष्ट्रेषु योजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2007950, "chapter_id": 1152, "verse_number": "१-१५३-७४", "content_sanskrit": "उद्यानेषु विहारेषु देवतायतनेषु च।\nपानागारेषु रथ्यासु सर्वतीर्थेषु चाप्यथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2007951, "chapter_id": 1152, "verse_number": "१-१५३-७५", "content_sanskrit": "चत्वरेषु च कूपेषु पर्वतेषु वनेषु च।\nसमवायेषु सर्वेषु सरित्सु च विचारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2007952, "chapter_id": 1152, "verse_number": "१-१५३-७६", "content_sanskrit": "वाचा भृशं विनीतः स्याद्धृदयेन तथा क्षुरः।\nस्मितपूर्वाभिभाषी स्यात्सृष्टो रौद्रस्य कर्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2007953, "chapter_id": 1152, "verse_number": "१-१५३-७७", "content_sanskrit": "अञ्जलिः शपथः सान्त्वं शिरसा पादवन्दनम्।\nआशाकरणमित्येवं कर्तव्यं भूतिमिच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2007954, "chapter_id": 1152, "verse_number": "१-१५३-७८", "content_sanskrit": "सुपुष्पितः स्यादफलः फलवान्स्याद्दुरारुहः।\nआमः स्यात्पक्वसङ्काशो नच जीर्येत कर्हिचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2007955, "chapter_id": 1152, "verse_number": "१-१५३-७९", "content_sanskrit": "त्रिवर्गे त्रिविधा पीडा ह्यनुबन्धास्तथैव च।\nअनुबन्धाः शुभा ज्ञेयाः पीडास्तु परिवर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2007956, "chapter_id": 1152, "verse_number": "१-१५३-८०", "content_sanskrit": "धर्मं विचरतः पीडा सापि द्वाभ्यां नियच्छति।\nअर्थं चाप्यर्थलुब्धस्य कामं चातिप्रवर्तिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2007957, "chapter_id": 1152, "verse_number": "१-१५३-८१", "content_sanskrit": "अगर्वितात्मा युक्तश्च सान्त्वयुक्तोऽनसूयिता।\nअवेक्षितार्थः शुद्धात्मा मन्त्रयीत द्विजैः सहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2007958, "chapter_id": 1152, "verse_number": "१-१५३-८२", "content_sanskrit": "कर्मणा येन केनैव मृदुना दारुणेन च।\nउद्धरेद्दीनमात्मानं समर्थो धर्ममाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2007959, "chapter_id": 1152, "verse_number": "१-१५३-८३", "content_sanskrit": "न संशयमनारुह्य नरो भद्राणि पश्यति।\nसंशयं पुनरारुह्य यदि जीवति पश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2007960, "chapter_id": 1152, "verse_number": "१-१५३-८४", "content_sanskrit": "यस्य बुद्धिः परिभवेत्तमतीतेन सान्त्वयेत्।\nअनागतेन दुर्बुद्धिं प्रत्युत्पन्नेन पण्डितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2007961, "chapter_id": 1152, "verse_number": "१-१५३-८५", "content_sanskrit": "योऽरिणा सह सन्धाय शयीत कृतकृत्यवत्।\nस वृक्षाग्रे यथा सुप्तः पतितः प्रतिबुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2007962, "chapter_id": 1152, "verse_number": "१-१५३-८६", "content_sanskrit": "मन्त्रसंवरणे यत्नः सदा कार्योऽनसूयता।\nआकारमभिरक्षेत चारेणाप्यनुपालितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2007963, "chapter_id": 1152, "verse_number": "१-१५३-८७", "content_sanskrit": "न रात्रौ मन्त्रयेद्विद्वान्न च कैश्चिदुपासितः।\nप्रासादाग्रे शिलाग्रे वा विशाले विजनेपि वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2007964, "chapter_id": 1152, "verse_number": "१-१५३-८८", "content_sanskrit": "समन्तात्तत्र पश्यद्भिः सहाप्तैरेव मन्त्रयेत्।\nनैव संवेशयेत्तत्र मन्त्रवेश्मनि शारिकाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2007965, "chapter_id": 1152, "verse_number": "१-१५३-८९", "content_sanskrit": "शुकान्वा शारिका वापि बालमूर्खजडानपि।\nप्रविष्टानपि निर्वास्य मन्त्रयेद्धार्मिकैर्द्विजैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2007966, "chapter_id": 1152, "verse_number": "१-१५३-९०", "content_sanskrit": "नीतिज्ञैर्न्यायशास्त्रज्ञैरितिहासे सुनिष्ठितैः।\nरक्षां मन्त्रस्य निश्छिद्रां मन्त्रान्ते निश्चयेत्स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2007967, "chapter_id": 1152, "verse_number": "१-१५३-९१", "content_sanskrit": "वीरोपवर्णितात्तस्माद्धर्मार्थाभ्यामथात्मना।\nएकेन वाथ विप्रेण ज्ञातबुद्धिर्विनिश्चयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2007968, "chapter_id": 1152, "verse_number": "१-१५३-९२", "content_sanskrit": "तृतीयेन न चान्येन व्रजेन्निश्चयमात्मवान्।\nषट्कर्णश्छिद्यते मन्त्र इति नीतिषु पठ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2007969, "chapter_id": 1152, "verse_number": "१-१५३-९३", "content_sanskrit": "निःसृतो नाशयेन्मन्त्रो हस्तप्राप्तामपि श्रियम्।\nस्वमतं च परेषां च विचार्य च पुनःपुनः।\nगुणवद्वाक्यमादद्यान्नैव तृप्येद्विचक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2007970, "chapter_id": 1152, "verse_number": "१-१५३-९४", "content_sanskrit": "नाच्छित्वा परमर्माणि नाकृत्वा कर्म दारुणम्।\nनाहत्वा मत्स्यघातीव प्राप्नोति महतीं श्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2007971, "chapter_id": 1152, "verse_number": "१-१५३-९५", "content_sanskrit": "कर्शितं व्याधितं क्लिन्नमपानीयमघासकम्।\nपरिविश्वस्तमन्दं च प्रहर्तव्यमरेर्बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2007972, "chapter_id": 1152, "verse_number": "१-१५३-९६", "content_sanskrit": "नार्थिकोऽर्थिनमभ्येति कृतार्थे नास्ति सङ्गतम्।\nतस्मात्सर्वाणि साध्यानि सावशेषाणि कारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2007973, "chapter_id": 1152, "verse_number": "१-१५३-९७", "content_sanskrit": "संग्रहे विग्रहे चैव यत्नः कार्योऽनसूयता।\nउत्साहश्चापि यत्नेन कर्तव्यो भूतिमिच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2007974, "chapter_id": 1152, "verse_number": "१-१५३-९८", "content_sanskrit": "नास्य कृत्यानि बुध्येरन्मित्राणि रिपवस्तथा।\nआरब्धान्येव पश्येरन्सुपर्यवसितान्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2007975, "chapter_id": 1152, "verse_number": "१-१५३-९९", "content_sanskrit": "भीतवत्संविधातव्यं यावद्भयमनागतम्।\nआगतं तु भयं दृष्ट्वा प्रहर्तव्यमभीतवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2007976, "chapter_id": 1152, "verse_number": "१-१५३-१००", "content_sanskrit": "दैवेनोपहतं शत्रुमनुगृह्णाति यो नरः।\nस मृत्युमुपगृह्णाति गर्भमश्वतरी यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2007977, "chapter_id": 1152, "verse_number": "१-१५३-१०१", "content_sanskrit": "अनागतं हि बुध्येत यच्च कार्यं पुरः स्थितम्।\nन तु बुद्धिक्षयात्किंचिदतिक्रामेत्प्रयोजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2007978, "chapter_id": 1152, "verse_number": "१-१५३-१०२", "content_sanskrit": "उत्साहश्चापि यत्नेन कर्तव्यो भूतिमिच्छता।\nविभज्य देशकालौ च दैवं धर्मादयस्त्रयः।\nनैःश्रेयसौ तु तौ ज्ञेयौ देशकालाविति स्थितिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2007979, "chapter_id": 1152, "verse_number": "१-१५३-१०३", "content_sanskrit": "तालवत्कुरुते मूलं बालः शत्रुरुपेक्षितः।\nगहनेऽग्निरिवोत्सृष्टः क्षिप्रं संजायते महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2007980, "chapter_id": 1152, "verse_number": "१-१५३-१०४", "content_sanskrit": "अग्निस्तोकमिवात्मानं सन्धुक्षयति यो नरः।\nस वर्धमानो ग्रसते महान्तमपि संचयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2007981, "chapter_id": 1152, "verse_number": "१-१५३-१०५", "content_sanskrit": "आदावेव ददानीति प्रियं ब्रूयान्निरर्थकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2007982, "chapter_id": 1152, "verse_number": "१-१५३-१०६", "content_sanskrit": "आशां कालवतीं कुर्यात्कालं विघ्नेन योजयेत्।\nविघ्नं निमित्ततो ब्रूयान्निमित्तं वाऽपि हेतुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2007983, "chapter_id": 1152, "verse_number": "१-१५३-१०७", "content_sanskrit": "क्षुरो भूत्वा हरेत्प्राणान्निशितः कालसाधनः।\nप्रतिच्छन्नो लोमहारी द्विषतां परिकर्तनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2007984, "chapter_id": 1152, "verse_number": "१-१५३-१०८", "content_sanskrit": "पाण्डवेषु यथान्यायमन्येषु च कुरूद्वह।\nवर्तमानो न मज्जेस्त्वं तथा कृत्यं समाचर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2007985, "chapter_id": 1152, "verse_number": "१-१५३-१०९", "content_sanskrit": "सर्वकल्याणसंपन्नो विशिष्ट इति निश्चयः।\nतस्मात्त्वं पाण्डुपुत्रेभ्यो रक्षात्मानं नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2007986, "chapter_id": 1152, "verse_number": "१-१५३-११०", "content_sanskrit": "भ्रातृव्या बलवन्तस्ते पाण्डुपुत्रा नराधिप।\nपश्चात्तापो यथा न स्यात्तथा नीतिर्विधीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2007987, "chapter_id": 1152, "verse_number": "१-१५३-१११x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2007988, "chapter_id": 1152, "verse_number": "१-१५३-१११", "content_sanskrit": "एवमुक्त्वा संप्रतस्थे कणिकः स्वगृहं ततः।\nधृतराष्ट्रोऽपि कौरव्यः शोकार्तः समपद्यत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2007989, "chapter_id": 1152, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि त्रिपञ्चाशदधिकशततमोऽध्यायः॥ १५३ ॥ ॥ समाप्तं च संभवपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}]