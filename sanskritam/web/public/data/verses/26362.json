[{"id": 7006362000, "chapter_id": 26362, "verse_number": "२-१८-१", "content_sanskrit": "वैशम्पायन उवाच\nमहे प्रतिहते शक्रः सक्रोधस्त्रिदशेश्वरः ।\nसंवर्तकं नाम गणं तोयदानामथाब्रवीत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006362001, "chapter_id": 26362, "verse_number": "२-१८-२", "content_sanskrit": "भो बलाहकमातङ्गाः श्रूयतां मम भाषितम् ।\nयदि वो मत्प्रियं कार्यं राजभक्तिपुरस्कृतम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006362002, "chapter_id": 26362, "verse_number": "२-१८-३", "content_sanskrit": "एते वृन्दावनगता दामोदरपरायणाः ।\nनन्दगोपादयो गोपा विद्विषन्ति ममोत्सवम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006362003, "chapter_id": 26362, "verse_number": "२-१८-४", "content_sanskrit": "आजीवो यः परस्तेषां गोपत्यं च यतः स्मृतम् ।\nता गावः सप्तरात्रेण पीड्यन्तां वर्षमारुतैः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006362004, "chapter_id": 26362, "verse_number": "२-१८-५", "content_sanskrit": "ऐरावतगतश्चाहं स्वयमेवाम्बु दारुणम् ।\nस्रक्ष्यामि वृष्टिं वातं च वज्राशनिसमप्रभम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006362005, "chapter_id": 26362, "verse_number": "२-१८-६", "content_sanskrit": "भवद्भिश्चण्डवर्षेण चरता मारुतेन च ।\nहतास्ताः सव्रजा गावस्त्यक्ष्यन्ति भुवि जीवितम्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006362006, "chapter_id": 26362, "verse_number": "२-१८-७", "content_sanskrit": "एवमाज्ञापयामास सर्वाञ्जलधरान् प्रभुः ।\nप्रत्याहते वै कृष्णेन शासने पाकशासनः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006362007, "chapter_id": 26362, "verse_number": "२-१८-८", "content_sanskrit": "ततस्ते जलदाः कृष्णा घोरनादा भयावहाः ।\nआकाशं छादयामासुः सर्वतः पर्वतोपमाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006362008, "chapter_id": 26362, "verse_number": "२-१८-९", "content_sanskrit": "विद्युत्सम्पातजननाः शक्रचापविभूषिताः ।\nतिमिरावृतमाकाशं चक्रुस्ते जलदास्तदा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006362009, "chapter_id": 26362, "verse_number": "२-१८-१०", "content_sanskrit": "गजा इवान्यसंयुक्ताः केचिन्मकरवर्चसः ।\nनागा इवान्ये गगने चेरुर्जलदपुङ्गवाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006362010, "chapter_id": 26362, "verse_number": "२-१८-११", "content_sanskrit": "तेऽन्योन्यं वपुषा बद्धा नागयूथायुतोपमाः ।\nदुर्दिनं विपुलं चक्रुश्छादयन्तो नभस्तलम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006362011, "chapter_id": 26362, "verse_number": "२-१८-१२", "content_sanskrit": "नृहस्तनागहस्ताभ्यां वेणूनां चैव सर्वतः ।\nधाराभिस्तुल्यरूपाभिर्ववृषुस्ते बलाहकाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006362012, "chapter_id": 26362, "verse_number": "२-१८-१३", "content_sanskrit": "समुद्रं मेनिरे तं हि खमारूढं नृचक्षुषः ।\nदुर्विगाह्यमपर्यन्तमगाधं दुर्दिनं महत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006362013, "chapter_id": 26362, "verse_number": "२-१८-१४", "content_sanskrit": "नैवापतन् वै खगमा दुद्रुवुर्मृगजातयः ।\nपर्वताभेषु मेघेषु खे नन्दन्तु समन्ततः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006362014, "chapter_id": 26362, "verse_number": "२-१८-१५", "content_sanskrit": "नष्टसूर्येन्दुसदृशैर्मेघैर्नभसि दारुणैः ।\nअतिवृष्टेन लोकस्य विरूपमभवद् वपुः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006362015, "chapter_id": 26362, "verse_number": "२-१८-१६", "content_sanskrit": "मेघौघैर्निष्प्रभाकारमदृश्यग्रहतारकम् ।\nचन्द्रसूर्यांशुरहितं खं बभूवातिनिष्प्रभम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006362016, "chapter_id": 26362, "verse_number": "२-१८-१७", "content_sanskrit": "वारिणा मेघमुक्तेन मुच्यमानेन चासकृत् ।\nआबभौ सर्वतस्तत्र भूमिस्तोयमयी यथा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006362017, "chapter_id": 26362, "verse_number": "२-१८-१८", "content_sanskrit": "विनेदुर्बर्हिणस्तत्र तोककल्परुताः खगाः ।\nविवृद्धिं निम्नगा याताः प्लवगाः सम्प्लवं गताः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006362018, "chapter_id": 26362, "verse_number": "२-१८-१९", "content_sanskrit": "गर्जितेन च मेघानां पर्जन्यनिनदेन च ।\nतर्जितानीव कम्पन्ते तृणानि तरुभिः सह ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006362019, "chapter_id": 26362, "verse_number": "२-१८-२०", "content_sanskrit": "प्राप्तोऽन्तकालो लोकानां व्यक्तमेकार्णवा मही ।\nइति गोपगणा वाक्यं व्याहरन्ति भयार्दिताः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006362020, "chapter_id": 26362, "verse_number": "२-१८-२१", "content_sanskrit": "तेनोत्पाताम्बुवर्षेण गावो विप्रहता भृशम् ।\nहम्भारवैः क्रन्दमाना न चेलुः स्तम्भितोपमाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006362021, "chapter_id": 26362, "verse_number": "२-१८-२२", "content_sanskrit": "निष्कम्पसक्थिचरणा निष्प्रयत्नखुराननाः ।\nहृष्टरोमार्द्रतनवः क्षामकुक्षिपयोधराः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006362022, "chapter_id": 26362, "verse_number": "२-१८-२३", "content_sanskrit": "काश्चित् प्राणाञ्जहुः श्रान्ता निपेतुः काश्चिदातुराः ।\nकाश्चित्सवत्साः पतिता गावः शीकरवेजिताः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006362023, "chapter_id": 26362, "verse_number": "२-१८-२४", "content_sanskrit": "काश्चिदाक्रम्य क्रोडेन वत्सांस्तिष्ठन्ति मातरः ।\nविमुखाः श्रान्तसक्थ्यश्च निराहाराः कृशोदराः ।\nपेतुरार्ता वेपमाना गावो वर्षपराजिताः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006362024, "chapter_id": 26362, "verse_number": "२-१८-२५", "content_sanskrit": "वत्साश्चोन्मुखका बाला दामोदरमुखाः स्थिताः ।\nत्राहीति वदनैर्दीनैः कृष्णमूचुरिवार्दिताः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006362025, "chapter_id": 26362, "verse_number": "२-१८-२६", "content_sanskrit": "गवां तत् कदनं दृष्ट्वा दुर्दिनागमजं महत् ।\nगोपांश्चासन्ननिधनान् कृष्णः कोपं समादधे ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006362026, "chapter_id": 26362, "verse_number": "२-१८-२७", "content_sanskrit": "स चिन्तयित्वा संरब्धो दृष्टो योगो मयेति च ।\nआत्मानमात्मना वाक्यमिदमूचे प्रियंवदः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006362027, "chapter_id": 26362, "verse_number": "२-१८-२८", "content_sanskrit": "अद्याहमिममुत्पाट्य सकाननवनं गिरिम् ।\nकल्पयेयं गवां स्थानं वर्षत्राणाय दुर्धरम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006362028, "chapter_id": 26362, "verse_number": "२-१८-२९", "content_sanskrit": "अयं धृतो मया शैलः पृथ्वीगृहनिभोपमः ।\nत्रास्यते सव्रजा गा वै मद्वश्यश्च भविष्यति ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006362029, "chapter_id": 26362, "verse_number": "२-१८-३०", "content_sanskrit": "एवं स चिन्तयित्वा तु कृष्णः सत्यपराक्रमः ।\nबाह्वोर्बलं दर्शयिष्यन् समीपं तं महीधरम् ।\nदोर्भ्यामुत्पाटयामास कृष्णो गिरिरिवापरः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006362030, "chapter_id": 26362, "verse_number": "२-१८-३१", "content_sanskrit": "स धृतः संगतो मेघैर्गिरिः सव्येन पाणिना ।\nगृहभावं गतस्तत्र गृहाकारेण वर्चसा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006362031, "chapter_id": 26362, "verse_number": "२-१८-३२", "content_sanskrit": "भूमेरुत्पाट्यमानस्य तस्य शैलस्य सानुषु ।\nशिलाः प्रशिथिलाश्चेलुर्विनिष्पेतुश्च पादपाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006362032, "chapter_id": 26362, "verse_number": "२-१८-३३", "content_sanskrit": "शिखरैर्घूर्णमानैश्च सीदमानैश्च पादपैः ।\nविधूतैश्चोच्छ्रितैः शृङ्गैरगमः खगमोऽभवत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006362033, "chapter_id": 26362, "verse_number": "२-१८-३४", "content_sanskrit": "चलत्प्रस्रवणैः पार्श्वैर्मेघोघैरेकतां गतैः ।\nभिद्यमानाश्मनिचयश्चचाल धरणीधरः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006362034, "chapter_id": 26362, "verse_number": "२-१८-३५", "content_sanskrit": "न मेघानां प्रवृष्टानां न शैलस्याश्मवर्षिणः ।\nविविदुस्ते जना रूपं वायोस्तस्य च गर्जतः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006362035, "chapter_id": 26362, "verse_number": "२-१८-३६", "content_sanskrit": "मेघैः सशैलसंस्थानैर्नीलैः प्रस्रवणार्पितैः ।\nमिश्रीकृत इवाभाति गिरिरुद्दामबर्हवान् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006362036, "chapter_id": 26362, "verse_number": "२-१८-३७", "content_sanskrit": "आप्लुतोऽयं गिरिः पक्षैरिति विद्याधरोरगाः ।\nगन्धर्वाप्सरसश्चैव वाचो मुञ्चन्ति सर्वशः ॥ ३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006362037, "chapter_id": 26362, "verse_number": "२-१८-३८", "content_sanskrit": "सहस्ततलविन्यस्तो मुक्तमूलः क्षितेस्तलात् ।\nरीतीर्निर्वर्तयामास काञ्चनाञ्जनराजतीः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006362038, "chapter_id": 26362, "verse_number": "२-१८-३९", "content_sanskrit": "कानिचिच्छिथिलानीव संच्छिन्नार्द्धानि कानिचित् ।\nगिरेर्मेघप्रविष्टानि तस्य शृङ्गाणि चाभवन् ॥३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006362039, "chapter_id": 26362, "verse_number": "२-१८-४०", "content_sanskrit": "गिरिणा कम्पमानेन कम्पितानां तु शाखिनाम् ।\nपुष्पमुच्चावचं भूमौ व्यशीर्यत समन्ततः ॥ ४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006362040, "chapter_id": 26362, "verse_number": "२-१८-४१", "content_sanskrit": "निःसृताः पृथुमूर्धानः स्वस्तिकार्धविभूषिताः ।\nद्विजिह्वपततः क्रुद्धाः खेचराः खे समन्ततः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006362041, "chapter_id": 26362, "verse_number": "२-१८-४२", "content_sanskrit": "आर्तिं जग्मुः खगगणा वर्षेण च भयेन च ।\nउत्पत्त्योत्पस्य गगनात् पुनः पेतुरवाङ्मुखाः ॥४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006362042, "chapter_id": 26362, "verse_number": "२-१८-४३", "content_sanskrit": "रेसुरारोषिताः सिंहाः सजला इव तोयदाः ।\nगर्गरा इव मथ्यन्तो नेदुः शार्दूलपुङ्गवाः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006362043, "chapter_id": 26362, "verse_number": "२-१८-४४", "content_sanskrit": "विषमैश्च समीभूतैः समैश्चात्यन्तदुर्गमैः ।\nव्यावृत्तदेहः च गिरिरन्य एवोपलक्ष्यते ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006362044, "chapter_id": 26362, "verse_number": "२-१८-४५", "content_sanskrit": "अतिवृष्टस्य तैर्मेघैस्तस्य रूपं बभूव ह ।\nस्तम्भितस्येव रुद्रेण त्रिपुरस्य विहायसि ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006362045, "chapter_id": 26362, "verse_number": "२-१८-४६", "content_sanskrit": "बाहुदण्डेन कृष्णस्य विधृतं सुमहत्तदा ।\nनीलाभ्रपटलच्छन्नं तद्गिरिच्छत्रमाबभौ ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006362046, "chapter_id": 26362, "verse_number": "२-१८-४७", "content_sanskrit": "स्वप्नायमानो जलदैर्निमीलितगुहामुखः ।\nबाहूपधाने कृष्णस्य प्रसुप्त इव खे गिरिः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006362047, "chapter_id": 26362, "verse_number": "२-१८-४८", "content_sanskrit": "निर्विहङ्गरुतैर्वृक्षैर्निर्मयूररुतैर्वनैः ।\nनिरालम्ब इवाभाति गिरिः स्वशिखरैर्वृतः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006362048, "chapter_id": 26362, "verse_number": "२-१८-४९", "content_sanskrit": "पर्यस्तैर्घूर्णमानैश्च प्रचलद्भिश्च सानुभिः ।\nसज्वराणीव शैलस्य वनानि शिखराणि च ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006362049, "chapter_id": 26362, "verse_number": "२-१८-५०", "content_sanskrit": "उत्तमाङ्गगतास्तस्य मेघाः पवनवाहनाः ।\nत्वर्यमाणा महेन्द्रेण तोयं मुमुचुरक्षयम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006362050, "chapter_id": 26362, "verse_number": "२-१८-५१", "content_sanskrit": "स लम्बमानः कृष्णस्य भुजाग्रे सघनो गिरिः ।\nचक्रारूढ इवाभाति देशो नृपतिपीडितः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006362051, "chapter_id": 26362, "verse_number": "२-१८-५२", "content_sanskrit": "स मेघनिचयस्तस्थौ गिरिं तं परिवार्य ह ।\nपुरं पुरस्कृत्य यथा स्फीतो जनपदो महान् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006362052, "chapter_id": 26362, "verse_number": "२-१८-५३", "content_sanskrit": "निवेश्य तं करे शैलं तोलयित्वा च सस्मितम् ।\nप्रोवाच गोप्ता गोपानां प्रजापतिरिव स्थितः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006362053, "chapter_id": 26362, "verse_number": "२-१८-५४", "content_sanskrit": "एतद् दैवैरसम्भाव्यं दिव्येन विधिना मया ।\nकृतं गिरिगृहं गोपा निर्वातं शरणं गवाम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006362054, "chapter_id": 26362, "verse_number": "२-१८-५५", "content_sanskrit": "क्षिप्रं विशन्तु यूथानि गवामिह हि शान्तये ।\nनिर्वातेषु च देशेषु निवसन्तु यथासुखम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006362055, "chapter_id": 26362, "verse_number": "२-१८-५६", "content_sanskrit": "यथाश्रेष्ठं यथायूथं यथासारं यथासुखम् ।\nविभज्यतामयं देशः कृतं वर्षनिवारणम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006362056, "chapter_id": 26362, "verse_number": "२-१८-५७", "content_sanskrit": "शैलोत्पाटनभूरेषा महती निर्मिता मया ।\nपञ्चक्रोशप्रमाणेन क्रोशैकविस्तरो महान् ।\nत्रैलोक्यमप्युत्सहते रक्षितुं किं पुनर्व्रजम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006362057, "chapter_id": 26362, "verse_number": "२-१८-५८", "content_sanskrit": "ततः किलकिलाशब्दो गवां हम्भारवैः सह ।\nगोपानां तुमुलो जज्ञे मेघनादश्च बाह्यतः ॥५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006362058, "chapter_id": 26362, "verse_number": "२-१८-५९", "content_sanskrit": "प्राविशन्त ततो गावो गोपैर्यूथप्रकल्पिताः ।\nतस्य शैलस्य विपुलं प्रदरं गह्वरोदरम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006362059, "chapter_id": 26362, "verse_number": "२-१८-६०", "content_sanskrit": "कृष्णोऽपि मूले शैलस्य शैलस्तम्भ इवोच्छ्रितः ।\nदधारैकेन हस्तेन शैलं प्रियमिवातिथिम् ॥ 2.18.६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006362060, "chapter_id": 26362, "verse_number": "२-१८-६१", "content_sanskrit": "ततो व्रजस्य भाण्डानि युक्तानि शकटानि च ।\nविविशुर्वर्षभीतास्ते तद् गृहं गिरिनिर्मितम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006362061, "chapter_id": 26362, "verse_number": "२-१८-६२", "content_sanskrit": "अतिदैवं तु कृष्णस्य दृष्ट्वा तत् कर्म वज्रभृत् ।\nमिथ्याप्रतिज्ञो जलदान् वारयामास वै विभुः ॥ ६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006362062, "chapter_id": 26362, "verse_number": "२-१८-६३", "content_sanskrit": "सप्तरात्रे तु निर्वृत्ते धरण्यां विगतोत्सवः ।\nजगाम संवृतो मेघैर्वृत्रहा स्वर्गमुत्तमम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006362063, "chapter_id": 26362, "verse_number": "२-१८-६४", "content_sanskrit": "निवृत्ते सप्तरात्रं तु निष्प्रयत्ने शतक्रतौ ।\nगताभ्रे विमले व्योम्नि दिवसे दीप्तभास्करे ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006362064, "chapter_id": 26362, "verse_number": "२-१८-६५", "content_sanskrit": "गावस्तेनैव मार्गेण परिजग्मुर्यथागतम् ।\nस्वं च स्थानं ततो घोषः प्रत्ययात् पुनरेव सः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006362065, "chapter_id": 26362, "verse_number": "२-१८-६६", "content_sanskrit": "कृष्णोऽपि तं गिरिश्रेष्ठं स्वस्थाने स्थावरात्मवान् ।\nप्रीतो निवेशयामास शिवाय वरदो विभुः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]