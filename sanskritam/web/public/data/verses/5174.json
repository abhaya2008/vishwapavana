[{"id": 2195858, "chapter_id": 5174, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2195859, "chapter_id": 5174, "verse_number": "१", "content_sanskrit": "ततो वज्रं सहस्राक्षो दृष्ट्वा सक्तं वरायुधम् ।\nऋषींश्च दृष्ट्वा सहसा सुपर्णमिदमब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2195860, "chapter_id": 5174, "verse_number": "२", "content_sanskrit": "न ते सुपर्ण पश्यामि प्रभावं तेन योधये ।\nइत्युक्ते न मया रक्षा शक्या कर्तुमतोऽन्यथा ।\nइदं वज्रं मया सार्धं निवृत्तं हि यथागतम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2195861, "chapter_id": 5174, "verse_number": "३", "content_sanskrit": "ततः सहस्रनयने निवृत्ते गरुडस्तथा ।\nकद्रूमभ्यगमत् तूर्णममृतं गृह्य भारत\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2195862, "chapter_id": 5174, "verse_number": "", "content_sanskrit": "गरुडः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2195863, "chapter_id": 5174, "verse_number": "४", "content_sanskrit": "तदाहृतं मया शीघ्रममृतं जननीकृते ।\nअदासी सा भवत्वद्य विनता धर्मचारिणी\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2195864, "chapter_id": 5174, "verse_number": "", "content_sanskrit": "कद्रूः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2195865, "chapter_id": 5174, "verse_number": "५", "content_sanskrit": "स्वागतं स्वाहृतं चेदममृतं विनतात्मज ।\nअदासी जननी तेऽद्य पुत्र कामवशा शुभा ।\nएवमुक्ते तदा सा च सम्प्राप्ता विनता गृहम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2195866, "chapter_id": 5174, "verse_number": "६", "content_sanskrit": "उपनीय यथान्यायं विहगो बलिनांवरः ।\nस्मृत्वा निकृत्या विजयं मातुः सम्प्रतिपद्य च\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2195867, "chapter_id": 5174, "verse_number": "७", "content_sanskrit": "वधं च भुजगेन्द्राणां ये वालास्तस्य वाजिनः ।\nबभूवुरसितप्रख्या निकृत्या वै जितं तया\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2195868, "chapter_id": 5174, "verse_number": "८", "content_sanskrit": "तामुवाच ततो न्याय्यं विहगो बलिनांवरः ।\nउज्जहारामृतं तूर्णमुत्पपात च रंहसा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2195869, "chapter_id": 5174, "verse_number": "९", "content_sanskrit": "तद्गृहीत्वाऽमृतं तूर्णं प्रयान्तमपराजितम् ।\nकद्रूर्भुजङ्गजननी सुपर्णमिदमब्रवीत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2195870, "chapter_id": 5174, "verse_number": "१०", "content_sanskrit": "किमर्थं वैनतेय त्वमाहृत्यामृतमुत्तमम् ।\nपुनर्हरसि दुर्बुद्धे मा जातु वृजिनं कृथाः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2195871, "chapter_id": 5174, "verse_number": "", "content_sanskrit": "सुपर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2195872, "chapter_id": 5174, "verse_number": "११", "content_sanskrit": "अमृताहरणं मेऽद्य यत्कृतं जननीकृते ।\nभवत्या वचनादेतदाहरामृतमित्युत\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2195873, "chapter_id": 5174, "verse_number": "१२", "content_sanskrit": "आहृतं तदिदं शीघ्रं मुक्ता च जननी मम ।\nहराम्येष पुनस्तत्र यत एतन्मयाऽऽहृतम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2195874, "chapter_id": 5174, "verse_number": "१३", "content_sanskrit": "यदि मां भवती ब्रूयादमृतं मे च दीयताम् ।\nतथा कुर्यां न वा कुर्यां न हि त्वममृतक्षमा ।\nमया धर्मेण सत्येन विनता च समुद्धृता\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2195875, "chapter_id": 5174, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2195876, "chapter_id": 5174, "verse_number": "१४", "content_sanskrit": "ततो गत्वाऽथ गरुडः पुरन्दरमुवाच ह ।\nइदं मया वृत्रहन्तर्हृतं तेऽमृतमुत्तमम् ।\nमात्रर्थे हि तथैवेदं गृहाणामृतमाहृतम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2195877, "chapter_id": 5174, "verse_number": "१५", "content_sanskrit": "माता च मम देवेश दासीत्वमुपजग्मुषी ।\nभुजङ्गमानां मातुर्वै सा मुक्ताऽमृतदर्शनात्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2195878, "chapter_id": 5174, "verse_number": "१६", "content_sanskrit": "एतच्छ्रुत्वा सहस्राक्षः सुपर्णमनुमन्यते ।\nउवाच च मुदा युक्तो दिष्ट्या दिष्ट्येति वासवः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2195879, "chapter_id": 5174, "verse_number": "१७", "content_sanskrit": "ऋषयो ये सहस्राक्षमुपासन्ति सुरैः सह ।\nते सर्वे च मुदा युक्ता विश्वेदेवास्तथैव च\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2195880, "chapter_id": 5174, "verse_number": "१८", "content_sanskrit": "ततस्तमृषयः सर्वे देवाश्च भरतर्षभ ।\nऊचुः पुरन्दरं हृष्टा गरुडो लभतां वरम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2195881, "chapter_id": 5174, "verse_number": "१९", "content_sanskrit": "ततः शचीपतिर्वाक्यमुवाच प्रहसन्निव ।\nजनिष्यति हृषीकेशः स्वयमेवैष पक्षिराट्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2195882, "chapter_id": 5174, "verse_number": "२०", "content_sanskrit": "केशवः पुण्डरीकाक्षः शूरपुत्रस्य वेश्मनि ।\nस्वयं धर्मस्य रक्षार्थं विभज्य भुजगाशन\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2195883, "chapter_id": 5174, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2195884, "chapter_id": 5174, "verse_number": "२१", "content_sanskrit": "एष ते पाण्डवश्रेष्ठ गरुडोऽथ पतत्रिराट् ।\nसुपर्णो वैनतेयश्च कीर्तितो भद्रमस्तु ते\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2195885, "chapter_id": 5174, "verse_number": "२२", "content_sanskrit": "तदेतद् ददतां श्रेष्ठ मयाऽऽख्यानं प्रकीर्तितम् ।\nसुपर्णस्य महाबाहो किं भूयः कथयामि ते\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2195886, "chapter_id": 5174, "verse_number": "२६", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे गरुडोपाख्याने सुपर्णवरलाभो नाम पञ्चविंशोऽध्यायः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2195887, "chapter_id": 5174, "verse_number": "", "content_sanskrit": "॥ सौपर्णं समाप्तम् ॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]