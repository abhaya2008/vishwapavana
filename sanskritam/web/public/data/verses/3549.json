[{"id": 2118514, "chapter_id": 3549, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2118515, "chapter_id": 3549, "verse_number": "१", "content_sanskrit": "ततः सुभद्रा सौभद्रं केशवस्य प्रिया स्वसा ।\nजयन्तमिव पौलोमी द्युतिमन्तमजीजनत् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2118516, "chapter_id": 3549, "verse_number": "२", "content_sanskrit": "दीर्घबाहुं महासत्वं वृषभाक्षमरिन्दमम् ।\nसुभद्रा सुषुवे वीरमभिमन्युं नरर्षभम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2118517, "chapter_id": 3549, "verse_number": "३", "content_sanskrit": "अभीश्च मन्युमांश्चैव ततस्तमरिमर्दनम् ।\nअभिमन्युरिति प्राहुरार्जुनिं ब्राह्मणर्षभाः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2118518, "chapter_id": 3549, "verse_number": "४", "content_sanskrit": "स सात्वत्यामतिरथः सम्बभूव धनञ्जयात् ।\nमखे निर्मथ्यमानाद्वा शमीगर्भाद्धुताशनः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2118519, "chapter_id": 3549, "verse_number": "५", "content_sanskrit": "यस्मिञ्जाते महाबाहुः कुन्तीपुत्रो युधिष्ठिरः ।\nअयुतं गा द्विजातिभ्यः प्रादान्निष्कांश्च तावतः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2118520, "chapter_id": 3549, "verse_number": "६", "content_sanskrit": "लालितो वासुदेवस्य बाल्यात् प्रभृति चाभवत् ।\nपितॄणां चैव सर्वेषां प्रजानामिव चन्द्रमाः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2118521, "chapter_id": 3549, "verse_number": "७", "content_sanskrit": "जन्मप्रभृति कृष्णस्तु चक्रे तस्य क्रियाः शुभाः ।\nस चापि ववृधे बालः शुक्लपक्षे यथा शशी \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2118522, "chapter_id": 3549, "verse_number": "८", "content_sanskrit": "चतुष्पादं दशविधं धनुर्वेदमरिन्दम ।\nअर्जुनाद् वेद वेदज्ञात् सकलं दिव्यमानुषम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2118523, "chapter_id": 3549, "verse_number": "९", "content_sanskrit": "विज्ञानेष्वपि शस्त्राणां सौष्ठवे च महाबलः ।\nक्रियास्वपि च सर्वासु विशेषानभ्यशिक्षयत् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2118524, "chapter_id": 3549, "verse_number": "१०", "content_sanskrit": "आगमे च प्रयोगे च चक्रे तुल्यमिवात्मनः ।\nतुतोष पुत्रं सौभद्रं प्रेक्षमाणो धनञ्जयः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2118525, "chapter_id": 3549, "verse_number": "११", "content_sanskrit": "सर्वसंहननोपेतं सर्वलक्षणलक्षितम् ।\nदुर्धर्षमृषभस्कन्धं व्यात्ताननमिवान्तकम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2118526, "chapter_id": 3549, "verse_number": "१२", "content_sanskrit": "सिंहदर्पं महेष्वासं मत्तमातङ्गविक्रमम् ।\nमेघदुन्दुभिनिर्घोषं पूर्णचन्द्रनिभाननम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2118527, "chapter_id": 3549, "verse_number": "१३", "content_sanskrit": "कृष्णस्य सदृशं शौर्ये वीर्ये रूपे तथाऽऽकृतौ ।\nददर्श पुत्रं बीभत्सुर्जयन्तं मघवानिव \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2118528, "chapter_id": 3549, "verse_number": "१४", "content_sanskrit": "पूर्वमेव तु पाञ्चाली पञ्चभिः पतिभिः शुभा ।\nलेभे पञ्च सुतान् वीरान् श्रेष्ठान् पञ्चानलानिव \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2118529, "chapter_id": 3549, "verse_number": "१५", "content_sanskrit": "युधिष्ठिरात् प्रतिविन्ध्यं सुतसोमं वृकोदरात् ।\nअर्जुनात् श्रुतकीर्तिं च शतानीकं च नाकुलिम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2118530, "chapter_id": 3549, "verse_number": "१६", "content_sanskrit": "सहदेवात् श्रुतक्रियमेतान् पञ्च महारथान् ।\nपाञ्चाली सुषुवे वीरान् आदित्यानदितिर्यथा \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2118531, "chapter_id": 3549, "verse_number": "१७", "content_sanskrit": "शास्त्रतः प्रतिविन्ध्यं तमूचुर्विप्रा युधिष्ठिरम् ।\nपरप्रहरणज्ञाने प्रतिविन्ध्यो भवत्वयम् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2118532, "chapter_id": 3549, "verse_number": "१८", "content_sanskrit": "सुतसोमसहस्रे तु सोमार्कसमतेजसम् ।\nसुतसोमं महाप्राज्ञं सुषुवे भीमसेनतः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2118533, "chapter_id": 3549, "verse_number": "१९", "content_sanskrit": "श्रुतं कर्म महत् कृत्वा निवृत्तेन किरीटिना ।\nजातः पुत्रस्तथेत्येवं श्रुतकीर्तिः ततोऽभवत् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2118534, "chapter_id": 3549, "verse_number": "२०", "content_sanskrit": "शतानीकस्य राजर्षेः कौरव्यस्य महात्मनः ।\nचक्रे पुत्रं सनामानं नकुलः कीर्तिवर्धनः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2118535, "chapter_id": 3549, "verse_number": "२१", "content_sanskrit": "ततस्त्वजीजनत् कृष्णा नक्षत्रे वह्निदैवते ।\nसहदेवात् सुतं तस्मात् श्रुतसेनेति तं विदुः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2118536, "chapter_id": 3549, "verse_number": "२२", "content_sanskrit": "एकवर्षान्तरास्त्वेवं द्रौपदेया यशस्विनः ।\nअन्वजायन्त राजेन्द्र परस्परहिते रताः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2118537, "chapter_id": 3549, "verse_number": "२३", "content_sanskrit": "जातकर्माण्यानुपूर्व्याच्चूडोपनयनानि च ।\nचकार विधिवद् धौम्यस्तेषां भरतसत्तम \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2118538, "chapter_id": 3549, "verse_number": "२४", "content_sanskrit": "कृत्वा तु वेदाध्ययनं ततः सुचरितव्रताः ।\nजगृहुः सर्वमिष्वस्त्रमर्जुनाद् दिव्यमानुषम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2118539, "chapter_id": 3549, "verse_number": "२५", "content_sanskrit": "दिव्यगर्भोपमैः पुत्रैर्व्यूढोरस्कैर्महाबलैः ।\nअन्विता राजशार्दूल पाण्डवा मुदमाप्नुवन् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2118540, "chapter_id": 3549, "verse_number": "२२८", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nअष्टविंशत्यधिकद्विशततमोऽध्यायः ॥२२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2118541, "chapter_id": 3549, "verse_number": "४", "content_sanskrit": "॥ इति हरणहारिकपर्वणि चतुर्थोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2118542, "chapter_id": 3549, "verse_number": "", "content_sanskrit": "॥ समाप्तं हरणहारिकपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]