[{"id": 5000531000, "chapter_id": 9531, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे चतुर्विंशत्यधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000531001, "chapter_id": 9531, "verse_number": "६-१२४-१", "content_sanskrit": "पूर्णे चतुर्दशे वर्षे पञ्चम्यां लक्ष्मणाग्रजः।\nभरद्वाजाश्रमं प्राप्य ववन्दे नियतो मुनिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000531002, "chapter_id": 9531, "verse_number": "६-१२४-२", "content_sanskrit": "सोऽपृच्छदभिवाद्यैनं भरद्वाजं तपोधनम्।\nशृणोषि कच्चिद् भगवन् सुभिक्षानामयं पुरे।\nकच्चित् स युक्तो भरतो जीवन्त्यपि च मातरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000531003, "chapter_id": 9531, "verse_number": "६-१२४-३", "content_sanskrit": "एवमुक्तस्तु रामेण भरद्वाजो महामुनिः।\nप्रत्युवाच रघुश्रेष्ठं स्मितपूर्वं प्रहृष्टवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000531004, "chapter_id": 9531, "verse_number": "६-१२४-४", "content_sanskrit": "आज्ञावशत्वे भरतो जटिलस्त्वां प्रतीक्षते।\nपादुके ते पुरस्कृत्य सर्वं च कुशलं गृहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000531005, "chapter_id": 9531, "verse_number": "६-१२४-५", "content_sanskrit": "त्वां पुरा चीरवसनं प्रविशन्तं महावनम्।\nस्त्रीतृतीयं च्युतं राज्याद् धर्मकामं च केवलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000531006, "chapter_id": 9531, "verse_number": "६-१२४-६", "content_sanskrit": "पदातिं त्यक्तसर्वस्वं पितृनिर्देशकारिणम्।\nसर्वभोगैः परित्यक्तं स्वर्गच्युतमिवामरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000531007, "chapter_id": 9531, "verse_number": "६-१२४-७", "content_sanskrit": "दृष्ट्वा तु करुणापूर्वं ममासीत् समितिंजय।\nकैकेयीवचने युक्तं वन्यमूलफलाशिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000531008, "chapter_id": 9531, "verse_number": "६-१२४-८", "content_sanskrit": "साम्प्रतं तु समृद्धार्थं समित्रगणबान्धवम्।\nसमीक्ष्य विजितारिं च ममाभूत् प्रीतिरुत्तमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000531009, "chapter_id": 9531, "verse_number": "६-१२४-९", "content_sanskrit": "सर्वं च सुखदुःखं ते विदितं मम राघव।\nयत् त्वया विपुलं प्राप्तं जनस्थाननिवासिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000531010, "chapter_id": 9531, "verse_number": "६-१२४-१०", "content_sanskrit": "ब्राह्मणार्थे नियुक्तस्य रक्षतः सर्वतापसान्।\nरावणेन हृता भार्या बभूवेयमनिन्दिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000531011, "chapter_id": 9531, "verse_number": "६-१२४-११", "content_sanskrit": "मारीचदर्शनं चैव सीतोन्मथनमेव च।\nकबन्धदर्शनं चैव पम्पाभिगमनं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000531012, "chapter_id": 9531, "verse_number": "६-१२४-१२", "content_sanskrit": "सुग्रीवेण च ते सख्यं यत्र वाली हतस्त्वया।\nमार्गणं चैव वैदेह्याः कर्म वातात्मजस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000531013, "chapter_id": 9531, "verse_number": "६-१२४-१३", "content_sanskrit": "विदितायां च वैदेह्यां नलसेतुर्यथा कृतः।\nयथा चादीपिता लङ्का प्रहृष्टैर्हरियूथपैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000531014, "chapter_id": 9531, "verse_number": "६-१२४-१४", "content_sanskrit": "सपुत्रबान्धवामात्यः सबलः सहवाहनः।\nयथा च निहतः संख्ये रावणो बलदर्पितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000531015, "chapter_id": 9531, "verse_number": "६-१२४-१५", "content_sanskrit": "यथा च निहते तस्मिन् रावणे देवकण्टके।\nसमागमश्च त्रिदशैर्यथा दत्तश्च ते वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000531016, "chapter_id": 9531, "verse_number": "६-१२४-१६", "content_sanskrit": "सर्वं ममैतद् विदितं तपसा धर्मवत्सल।\nसम्पतन्ति च मे शिष्याः प्रवृत्त्याख्याः पुरीमितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000531017, "chapter_id": 9531, "verse_number": "६-१२४-१७", "content_sanskrit": "अहमप्यत्र ते दद्मि वरं शस्त्रभृतां वर।\nअर्घ्यं प्रतिगृहाणेदमयोध्यां श्वो गमिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000531018, "chapter_id": 9531, "verse_number": "६-१२४-१८", "content_sanskrit": "तस्य तच्छिरसा वाक्यं प्रतिगृह्य नृपात्मजः।\nबाढमित्येव संहृष्टः श्रीमान् वरमयाचत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000531019, "chapter_id": 9531, "verse_number": "६-१२४-१९", "content_sanskrit": "अकालफलिनो वृक्षाः सर्वे चापि मधुस्रवाः।\nफलान्यमृतगन्धीनि बहूनि विविधानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000531020, "chapter_id": 9531, "verse_number": "६-१२४-२०", "content_sanskrit": "भवन्तु मार्गे भगवन्नयोध्यां प्रति गच्छतः।\nतथेति च प्रतिज्ञाते वचनात् समनन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000531021, "chapter_id": 9531, "verse_number": "६-१२४-२१", "content_sanskrit": "अभवन् पादपास्तत्र स्वर्गपादपसंनिभाः।\nनिष्फलाः फलिनश्चासन् विपुष्पाः पुष्पशालिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000531022, "chapter_id": 9531, "verse_number": "६-१२४-२२", "content_sanskrit": "शुष्काः समग्रपत्रास्ते नगाश्चैव मधुस्रवाः।\nसर्वतो योजनास्तिस्रो गच्छतामभवंस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000531023, "chapter_id": 9531, "verse_number": "६-१२४-२३", "content_sanskrit": "ततः प्रहृष्टाः प्लवगर्षभास्ते\nबहूनि दिव्यानि फलानि चैव।\nकामादुपाश्नन्ति सहस्रशस्ते\nमुदान्विताः स्वर्गजितो यथैव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000531024, "chapter_id": 9531, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे चतुर्विंशत्यधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]