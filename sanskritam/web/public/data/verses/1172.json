[{"id": 2008884, "chapter_id": 1172, "verse_number": "१-१७३-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2008885, "chapter_id": 1172, "verse_number": "१-१७३-१", "content_sanskrit": "तयोर्दुःखितयोर्वाक्यमतिमात्रं निशम्य तु।\nततो दुःखपरीताङ्गी कन्या तावभ्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2008886, "chapter_id": 1172, "verse_number": "१-१७३-२", "content_sanskrit": "किमेवं भृशदुःखार्तौ रोरूयेतामनाथवत्।\nममापि श्रूयतां वाक्यं श्रुत्वा च क्रियतां क्षमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2008887, "chapter_id": 1172, "verse_number": "१-१७३-३", "content_sanskrit": "धर्मतोऽहं परित्याज्या युवयोर्नात्र संशयः।\nत्यक्तव्यां मां परित्यज्य त्राहि सर्वं मयैकया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2008888, "chapter_id": 1172, "verse_number": "१-१७३-४", "content_sanskrit": "इत्यर्थमिष्यतेऽपत्यं तारयिष्यति मामिति।\nअस्मिन्नुपस्थिते काले तरध्वं प्लववन्मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2008889, "chapter_id": 1172, "verse_number": "१-१७३-५", "content_sanskrit": "इह वा तारयेद्दुर्गादुत वा प्रेत्य भारत।\nसर्वथा तारयेत्पुत्रः पुत्र इत्युच्यते बुधैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2008890, "chapter_id": 1172, "verse_number": "१-१७३-६", "content_sanskrit": "आकाङ्क्षन्ते च दौहित्रान्मयि नित्यं पितामहाः।\nतत्स्वयं वै परित्रास्ये रक्षन्ती जीवितं पितुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2008891, "chapter_id": 1172, "verse_number": "१-१७३-७", "content_sanskrit": "भ्राता च मम बालोऽयं गते लोकममुं त्वयि।\nअचिरेणैव कालेन विनश्येत न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2008892, "chapter_id": 1172, "verse_number": "१-१७३-८", "content_sanskrit": "तातेपि हि गते स्वर्गं विनष्टे च ममानुजे।\nपिण्डः पितॄणां व्युच्छिद्येत्तत्तेषां विप्रियं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2008893, "chapter_id": 1172, "verse_number": "१-१७३-९", "content_sanskrit": "पित्रा त्यक्ता तथा मात्रा भ्रात्रा चाहमसंशयम्।\nदुःखाद्दुःखतरं प्राप्य म्रियेयमतथोचिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2008894, "chapter_id": 1172, "verse_number": "१-१७३-१०", "content_sanskrit": "त्वयि त्वरोगे निर्मुक्तो माता भ्राता च मे शिशुः।\nसन्तानश्चैव पिण्डश्च प्रतिष्ठास्यत्यसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2008895, "chapter_id": 1172, "verse_number": "१-१७३-११", "content_sanskrit": "आत्मा पुत्रः सखी भार्या कृच्छ्रं तु दुहिता किल।\nस कृच्छ्रान्मोचयात्मानं मां च धर्मे नियोजया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2008896, "chapter_id": 1172, "verse_number": "१-१७३-१२", "content_sanskrit": "अनाथा कृपणा बाला यत्र क्वचन गामिनी।\nभविष्यामि त्वया तात विहीना कृपणा सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2008897, "chapter_id": 1172, "verse_number": "१-१७३-१३", "content_sanskrit": "अथवाहं करिष्यामि कुलस्यास्य विमोचनम्।\nफलसंस्था भविष्यामि कृत्वा कर्म सुदुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2008898, "chapter_id": 1172, "verse_number": "१-१७३-१४", "content_sanskrit": "अथवा यास्यसे तत्र त्यक्त्वा मां द्विजसत्तम।\nपीडिताऽहं भविष्यामि तदवेक्षस्व मामपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2008899, "chapter_id": 1172, "verse_number": "१-१७३-१५", "content_sanskrit": "तदस्मदर्थं धर्मार्थं प्रसवार्थं च सत्तम।\nआत्मानं परिरक्षस्व त्यक्तव्यां मां च संत्यज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2008900, "chapter_id": 1172, "verse_number": "१-१७३-१६", "content_sanskrit": "अवश्यकरणीये च मा त्वां कालोत्यगादयम्।\nकिं त्वतः परमं दुःखं यद्वयं स्वर्गते त्वयि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2008901, "chapter_id": 1172, "verse_number": "१-१७३-१७", "content_sanskrit": "याचमानाः परादन्नं परिधावेमहि श्ववत्।\nत्वयि त्वरोगे निर्मुक्ते क्लेशादस्मात्सबान्धवे।\nअमृतेव सती लोके भविष्यामि सुखान्विता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2008902, "chapter_id": 1172, "verse_number": "१-१७३-१८", "content_sanskrit": "इतः प्रदाने देवाश्च पितरश्चेति नः श्रुतम्।\nत्वया दत्तेन तोयेन भविष्यति हिताय वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2008903, "chapter_id": 1172, "verse_number": "१-१७३-१९", "content_sanskrit": "इत्येतदुभयं तात निशाम्य तव यद्धितम्।\nतद्व्यवस्य तथाम्बाया हितं स्वस्य सुतस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2008904, "chapter_id": 1172, "verse_number": "१-१७३-२०", "content_sanskrit": "मातापित्रोश्च पुत्रास्तु भवितारो गुणान्विताः।\nन तु पुत्रस्य पितरो पुनर्जातु भविष्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2008905, "chapter_id": 1172, "verse_number": "१-१७३-२१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2008906, "chapter_id": 1172, "verse_number": "१-१७३-२१", "content_sanskrit": "एवं बहुविधं तस्या निशम्य परिदेवितम्।\nपिता माता च सा चैव कन्या प्ररुरुदुस्त्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2008907, "chapter_id": 1172, "verse_number": "१-१७३-२२", "content_sanskrit": "ततः प्ररुदितान्सर्वान्निशम्याथ सुतस्तदा।\nउत्फुल्लनयनो बालः कलमव्यक्तमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2008908, "chapter_id": 1172, "verse_number": "१-१७३-२३", "content_sanskrit": "मा पिता रुद मा मातर्मा स्वसस्त्विति चाब्रवीत्।\nप्रहसन्निव सर्वांस्तानेकैकमनुसर्पति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2008909, "chapter_id": 1172, "verse_number": "१-१७३-२४", "content_sanskrit": "ततः स तृणमादाय प्रहृष्टः पुनरब्रवीत्।\nअनेनाहं हनिष्यामि राक्षसं पुरुषादकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2008910, "chapter_id": 1172, "verse_number": "१-१७३-२५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2008911, "chapter_id": 1172, "verse_number": "१-१७३-२५", "content_sanskrit": "तथापि तेषां दुःखेन परीतानां निशम्य तत्।\nबालस्य वाक्यमव्यक्तं हर्षः समभवन्महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2008912, "chapter_id": 1172, "verse_number": "१-१७३-२६", "content_sanskrit": "अयं काल इति ज्ञात्वा कुन्ती समुपसृत्य तान्।\nगतासूनमृतेनेव जीवयन्तीदमब्रवीत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2008913, "chapter_id": 1172, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि बकवधपर्वणि त्रिसप्तत्यधिकशततमोऽध्यायः॥ १७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]