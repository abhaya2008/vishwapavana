[{"id": 7006595000, "chapter_id": 26595, "verse_number": "३-१३४-१", "content_sanskrit": "हरिवंशे वर्णितानां वृत्तान्तानां संग्रहः वैशम्पायन उवाच हरिवंशेऽत्र वृत्तान्ताः प्रकीर्त्यन्ते क्रमोदिताः ।\nतत्रादावादिसर्गस्तु भूतसर्गस्ततः परः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006595001, "chapter_id": 26595, "verse_number": "३-१३४-२", "content_sanskrit": "पृथोर्वैन्यस्य चाख्यानं मनूनां कीर्तनं तथा ।\nवैवस्वतकुलोत्पत्तिर्धुन्धुमारकथा तथा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006595002, "chapter_id": 26595, "verse_number": "३-१३४-३", "content_sanskrit": "गालवोत्पत्तिरिक्ष्वाकुवंशस्याप्यनुकीर्तनम् ।\nपितृकल्पस्तथोत्पत्तिः सोमस्य च बुधस्य च ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006595003, "chapter_id": 26595, "verse_number": "३-१३४-४", "content_sanskrit": "अमावसोरन्वयस्य कीर्तनं कीर्तिवर्धनम् ।\nच्युतिंप्रतिष्ठे शक्रस्य प्रसवः क्षत्रवृद्धजः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006595004, "chapter_id": 26595, "verse_number": "३-१३४-५", "content_sanskrit": "दिवोदासप्रतिष्ठा च त्रिशङ्कोः क्षत्रियस्य च ।\nययातिचरितं चैव पूरुवंशस्य कीर्तनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006595005, "chapter_id": 26595, "verse_number": "३-१३४-६", "content_sanskrit": "कीर्तनं कृष्णसम्भूतेः स्यमन्तकमणेस्तथा ।\nसंक्षेपात्कीर्तिता विष्णोः प्रादुर्भावास्ततः परम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006595006, "chapter_id": 26595, "verse_number": "३-१३४-७", "content_sanskrit": "तारकामययुद्धं च ब्रह्मलोकस्य वर्णनम् ।\nयोगनिद्रासमुत्थानं विष्णोर्वाक्यं च वेधसः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006595007, "chapter_id": 26595, "verse_number": "३-१३४-८", "content_sanskrit": "पृथ्वीवाक्यं च देवानामंशावतरणं तथा ।\nततो नारदवाक्यं च स्वप्नगर्भविधिस्तथा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006595008, "chapter_id": 26595, "verse_number": "३-१३४-९", "content_sanskrit": "आर्यास्तवः पुनः कृष्णसमुत्पत्तिः प्रपञ्चतः ।\nगोव्रजे गमनं विष्णोः शकटस्य निवर्तनम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006595009, "chapter_id": 26595, "verse_number": "३-१३४-१०", "content_sanskrit": "पूतनाया वधो भङ्गो यमलार्जुनयोरपि ।\nवृकसंदर्शानं चैव बृन्दावननिवेशनम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006595010, "chapter_id": 26595, "verse_number": "३-१३४-११", "content_sanskrit": "प्रावृषो वर्णनं चापि यमुनाह्रददर्शनम् ।\nकालियस्यापि दमनं धेनुकस्य च भञ्जनम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006595011, "chapter_id": 26595, "verse_number": "३-१३४-१२", "content_sanskrit": "प्रलम्बनिधनं चैव शरद्वर्णनमेव च ।\nगिरियज्ञप्रवृत्तिश्च गोवर्धनविधारणम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006595012, "chapter_id": 26595, "verse_number": "३-१३४-१३", "content_sanskrit": "गोविन्दस्याभिषेकं च गोपीसंक्रीडनं तथा ।\nरिष्टासुरस्य निधनमकूरप्रेषणं तथा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006595013, "chapter_id": 26595, "verse_number": "३-१३४-१४", "content_sanskrit": "अन्धकस्य च वाक्यानि केशिनो निधनं तथा ।\nअक्रूरागमनं चैव नागलोकस्य दर्शनम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006595014, "chapter_id": 26595, "verse_number": "३-१३४-१५", "content_sanskrit": "धनुर्भङ्गस्य कथनं कंसवाक्यमतः परम् ।\nकुवलयापीडवधश्चाणूरान्ध्रवधस्तथा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006595015, "chapter_id": 26595, "verse_number": "३-१३४-१६", "content_sanskrit": "कंसस्य निधनं चापि विलापः कंसयोषिताम् ।\nउग्रसेनाभिषेकश्च यादवाश्वासनं तथा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006595016, "chapter_id": 26595, "verse_number": "३-१३४-१७", "content_sanskrit": "प्रत्यागतिर्गुरुकुलादथोक्ता रामकृष्णयोः ।\nमथुरायाश्चोपरोधो जरासंधनिवर्तनम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006595017, "chapter_id": 26595, "verse_number": "३-१३४-१८", "content_sanskrit": "विकद्रुवाक्यं रामस्य दर्शनं भाषणं तथा ।\nगोमन्तारोहणं चापि जरासंधगतिस्तथा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006595018, "chapter_id": 26595, "verse_number": "३-१३४-१९", "content_sanskrit": "गोमन्तस्य गिरेर्दाहः करवीरपुरे गतिः ।\nशृगालस्य वधस्तत्र मथुरागमनं ततः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006595019, "chapter_id": 26595, "verse_number": "३-१३४-२०", "content_sanskrit": "यमुनाकर्षणं चैव मथुरापक्रमस्तथा ।\nउपायेन वधः कालयवनस्य प्रकीर्तितः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006595020, "chapter_id": 26595, "verse_number": "३-१३४-२१", "content_sanskrit": "निर्माणं द्वारवत्यास्तु रुक्मिणीहरणं तथा ।\nविवाहश्चैव रुक्मिण्या रुक्मिणो निधनं तथा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006595021, "chapter_id": 26595, "verse_number": "३-१३४-२२", "content_sanskrit": "बलदेवाह्निकं पुण्यं बलमाहात्म्यमेव च ।\nनरकस्य वधः पारिजातस्य हरणं तथा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006595022, "chapter_id": 26595, "verse_number": "३-१३४-२३", "content_sanskrit": "द्वारवत्या विशेषेण पुनर्निर्माणकीर्तनम् ।\nद्वारकायां प्रवेशश्च सभायां च प्रवेशनम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006595023, "chapter_id": 26595, "verse_number": "३-१३४-२४", "content_sanskrit": "नारदस्य च वाक्यानि वृष्णिवंशानुकीर्तनम् ।\nषट्पुरस्य वधाख्यानमन्धकस्य निबर्हणम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006595024, "chapter_id": 26595, "verse_number": "३-१३४-२५", "content_sanskrit": "समुद्रयात्रा कृष्णस्य जलक्रीडाकुतूहलम् ।\nतथा भैमप्रवीराणां मधुपानप्रवर्तकम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006595025, "chapter_id": 26595, "verse_number": "३-१३४-२६", "content_sanskrit": "ततश्छालिक्यगान्धर्वसमुदाहरणं हरेः ।\nभानोश्च दुहितुर्भानुमत्या हरणकीर्तनम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006595026, "chapter_id": 26595, "verse_number": "३-१३४-२७", "content_sanskrit": "शम्बरस्य वथश्चैव धन्योपाख्यानमेव च ।\nवासुदेवस्य माहात्म्यं बाणयुद्धं प्रपञ्चितम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006595027, "chapter_id": 26595, "verse_number": "३-१३४-२८", "content_sanskrit": "भविष्यं पुष्करं चैव प्रपञ्चेनैव कीर्तितम् ।\nवाराहं नारसिंहं च वामनं बहुविस्तरम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006595028, "chapter_id": 26595, "verse_number": "३-१३४-२९", "content_sanskrit": "कैलासयात्रा कृष्णस्य पौण्ड्रकस्य वधस्ततः ।\nहंसस्य डिम्भकस्यैव वधश्चैव प्रकीर्तितः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006595029, "chapter_id": 26595, "verse_number": "३-१३४-३०", "content_sanskrit": "पुरत्रयस्य संहार इति वृत्तान्तसंग्रहः ।\nकथितो नृपशार्दूल सर्वपापप्रणाशनः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006595030, "chapter_id": 26595, "verse_number": "३-१३४-३१", "content_sanskrit": "वृत्तान्तं शृणुयाद्यस्तु सायंप्रातः समाहितः ।\nस याति वैष्णवं धाम लब्धकामः कुरूद्वह ।\nधन्यं यशस्यमायुष्यं भुक्तिमुक्तिफलप्रदम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]