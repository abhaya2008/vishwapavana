[{"id": 2106426, "chapter_id": 3310, "verse_number": "१६-३९-१", "content_sanskrit": "वैशम्पायन उवाच।\nतेषु चोपनिवृत्तेषु पाण्डवेषु यदृच्छया।\nदेवर्षिर्नारदो राजन्नाजगाम युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2106427, "chapter_id": 3310, "verse_number": "१६-३९-२", "content_sanskrit": "तमभ्यर्च्य महाबाहुः कुरुराजो युधिष्ठिरः।\nआसीनं परिविश्वस्तं प्रोवाच वदतांवरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2106428, "chapter_id": 3310, "verse_number": "१६-३९-३", "content_sanskrit": "चिरात्तु नानुपश्यामि भगवन्तमुपस्थितम्।\nकच्चित्ते कुशलं विप्र शुभं वा प्रत्युपस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2106429, "chapter_id": 3310, "verse_number": "१६-३९-४", "content_sanskrit": "के देशाः परिदृष्टास्ते किं च कार्यं करोमि ते।\nतद्ब्रूहि द्विजमुख्यस्त्वं ह्यस्माकं च प्रियोऽतिथिः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2106430, "chapter_id": 3310, "verse_number": "१६-३९-५x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2106431, "chapter_id": 3310, "verse_number": "१६-३९-५", "content_sanskrit": "चिरदृष्टोसि मेऽत्येवमागतोऽहं तपोवनात्।\nपरिदृष्टानि तीर्थानि गङ्गा चैव मया नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2106432, "chapter_id": 3310, "verse_number": "१६-३९-६x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2106433, "chapter_id": 3310, "verse_number": "१६-३९-६", "content_sanskrit": "वदन्ति पुरुषा मेऽद्य गङ्गातीरनिवासिनः।\nधृतराष्ट्रं महात्मानमास्थितं परमं तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2106434, "chapter_id": 3310, "verse_number": "१६-३९-७", "content_sanskrit": "अपि दृष्टस्त्वया तत्र कुशली स कुरूद्वहः।\nगान्धारी च पृथा चैव सूतपुत्रश्च संजयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2106435, "chapter_id": 3310, "verse_number": "१६-३९-८", "content_sanskrit": "कथं च वर्तते चाद्य पिता मम स पार्थिवः।\nश्रोतुमिच्छामि भगवन्यदि दृष्टस्त्वया नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2106436, "chapter_id": 3310, "verse_number": "१६-३९-९x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2106437, "chapter_id": 3310, "verse_number": "१६-३९-९", "content_sanskrit": "स्थिरीभूय महाराज शृणु वृत्तं यथातथम्।\nयथाश्रुतं च दृष्टं च मया तस्मिंस्तपोवने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2106438, "chapter_id": 3310, "verse_number": "१६-३९-१०", "content_sanskrit": "वनवासनिवृत्तेषु भवत्सु कुरुनन्दन।\nकुरुक्षेत्रात्पिता तुभ्य गङ्गाद्वारं ययौ नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2106439, "chapter_id": 3310, "verse_number": "१६-३९-११", "content_sanskrit": "गान्धार्या सहितो धीमान्वध्वा कुन्त्या समन्वितः।\nसंजयेन च सूतेन साग्निहोत्रः सयाजकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2106440, "chapter_id": 3310, "verse_number": "१६-३९-१२", "content_sanskrit": "आतस्थे स तपस्तीव्रं पिता तव तपोधनः।\nअग्निं मुखे समाधाय वायुभक्षोऽभवन्मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2106441, "chapter_id": 3310, "verse_number": "१६-३९-१३", "content_sanskrit": "वने स मुनिभिः सर्वैः पूज्यमानो महातपाः।\nत्वगस्थिमात्रशेषः स षण्मासानभवन्नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2106442, "chapter_id": 3310, "verse_number": "१६-३९-१४", "content_sanskrit": "गान्धारी तु जलाहारी कुन्ती मासोपवासिनी।\nसंजयः षष्ठभुक्तेन वर्तयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2106443, "chapter_id": 3310, "verse_number": "१६-३९-१५", "content_sanskrit": "अग्नींस्तु याजकास्तत्र जुहुवुर्विधिवत्प्रभो।\nदृश्यतोऽदृश्यतश्चैव वने तस्मिन्नृपस्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2106444, "chapter_id": 3310, "verse_number": "१६-३९-१६", "content_sanskrit": "अनिकेतोथ राजा स बभूव वनगोचरः।\nते चापि सहिते देव्यौ संजयश्च तमन्वयुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2106445, "chapter_id": 3310, "verse_number": "१६-३९-१७", "content_sanskrit": "संजयो नृपतेर्नेता समेषु विषमेषु च।\nगान्धार्याश्च पृथा चैव चक्षुरासीदनिन्दिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2106446, "chapter_id": 3310, "verse_number": "१६-३९-१८", "content_sanskrit": "ततः कदाचिद्गङ्गायाः कच्छे स नृपसत्तमः।\nगङ्गायामाप्लुतो धीमानाश्रमाभिमुखो ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2106447, "chapter_id": 3310, "verse_number": "१६-३९-१९", "content_sanskrit": "अथ वायुः समुद्भुतो दावाग्निरभवन्महान्।\nददाह तद्वनं सर्वं परिगृह्य समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2106448, "chapter_id": 3310, "verse_number": "१६-३९-२०", "content_sanskrit": "दह्यत्सु मृगयूथेषु द्विजिह्वेषु समन्ततः।\nवराहाणां च यूथेषु संश्रयत्सु जलाशयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2106449, "chapter_id": 3310, "verse_number": "१६-३९-२१", "content_sanskrit": "सम्प्रदीप्ते वने तस्मिन्प्राप्ते व्यसन उत्तमे।\nनिराहारतया राजा मन्दप्राणविचेष्टितः।\nअसमर्थोऽपसरणे सुकृशे मातरौ च ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2106450, "chapter_id": 3310, "verse_number": "१६-३९-२२", "content_sanskrit": "ततः स नृपतिर्दृष्ट्वा वह्निमायान्तमन्तिकात्।\nइदमाह ततः सूतं संजयं जयतांवरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2106451, "chapter_id": 3310, "verse_number": "१६-३९-२३", "content_sanskrit": "गच्छ संजय यत्राग्निर्न त्वां दहति कर्हिचित्।\nवयमत्राग्निना युक्ता गमिष्यामः परां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2106452, "chapter_id": 3310, "verse_number": "१६-३९-२४", "content_sanskrit": "तमुवाच किलोद्विग्नः संजयो वदतांवरः।\nराजन्मृत्युरनिष्टोऽयं भविता ते वृथाऽग्निना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2106453, "chapter_id": 3310, "verse_number": "१६-३९-२५", "content_sanskrit": "न चोपायं प्रपश्यामि मोक्षणे जातवेदसः।\nयदत्रानन्तरं कार्यं तद्भवान्वक्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2106454, "chapter_id": 3310, "verse_number": "१६-३९-२६", "content_sanskrit": "इत्युक्तः संजयेनेदं पुनराह स पार्थिवः।\nनैष मृत्युरनिष्टो नो निःसृतानां गृहात्स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2106455, "chapter_id": 3310, "verse_number": "१६-३९-२७", "content_sanskrit": "जलमग्निस्तथा वायुरथवाऽपि विकर्षणम्।\nतापसानां प्रशस्यं ते गच्च संजय माचिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2106456, "chapter_id": 3310, "verse_number": "१६-३९-२८", "content_sanskrit": "इत्युक्त्वा संजयं राजा समाधाय मनस्तथा।\nप्राङ्मुखः सह गान्धार्या कुन्त्या चोपाविशत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2106457, "chapter_id": 3310, "verse_number": "१६-३९-२९", "content_sanskrit": "संजयस्तं तथा दृष्ट्वा प्रदक्षिणमथाकरोत्।\nउवाच चैनं मेधावी युङ्क्ष्वात्मानमिति प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2106458, "chapter_id": 3310, "verse_number": "१६-३९-३०", "content_sanskrit": "ऋषिपुत्रो मनीषी स राज चक्रेऽस्य तद्वचः।\nसन्निरुध्येन्द्रियग्राममासीत्काष्ठोपमस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2106459, "chapter_id": 3310, "verse_number": "१६-३९-३१", "content_sanskrit": "गान्धारी च महाभागा जननी च पृथा तव।\nदावाग्निना समायुक्ते स च राजा पिता तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2106460, "chapter_id": 3310, "verse_number": "१६-३९-३२", "content_sanskrit": "संजयस्तु महाप्राज्ञस्तस्माद्दावादमुच्यत।\nगङ्गाकूले मया दृष्टस्तापसैः परिवारितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2106461, "chapter_id": 3310, "verse_number": "१६-३९-३३", "content_sanskrit": "स तानामन्त्र्य तेजस्वी निवेद्यैतच्च सर्वशः।\nप्रययौ संजयो धीमान्हिमवन्तं महीधरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2106462, "chapter_id": 3310, "verse_number": "१६-३९-३४", "content_sanskrit": "एवं स निधनं प्राप्तः कुरुराजो महामनाः।\nगान्धारी च पृथा चैव जनन्यौ ते विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2106463, "chapter_id": 3310, "verse_number": "१६-३९-३५", "content_sanskrit": "यदृच्छयाऽनुव्रजता मया राज्ञः कलेवरम्।\nतयोश्च देव्योरुभयोर्मया दृष्टानि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2106464, "chapter_id": 3310, "verse_number": "१६-३९-३६", "content_sanskrit": "ततस्तपोवने तस्मिन्समाजग्मुस्तपोधनाः।\nश्रुत्वा राज्ञस्तदा निष्ठां न त्वशोचन्गतीश्च ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2106465, "chapter_id": 3310, "verse_number": "१६-३९-३७", "content_sanskrit": "तत्राश्रौषमहं सर्वमेतत्पुरुषसत्तम।\nयथा च नृपतिर्दग्धो देव्यौ ते चेति पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2106466, "chapter_id": 3310, "verse_number": "१६-३९-३८", "content_sanskrit": "न शोचितव्यं राजेन्द्र स्वर्गस्थः पृथिवीपतिः।\nप्राप्तवानग्निसंयोगं गान्धारी जननी च ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2106467, "chapter_id": 3310, "verse_number": "१६-३९-३९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2106468, "chapter_id": 3310, "verse_number": "१६-३९-३९", "content_sanskrit": "एतच्छ्रुत्वा च सर्वेषां पाण्डवानां महात्मनाम्।\nनिर्याणं धृतराष्ट्रस्य शोकः समभवन्महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2106469, "chapter_id": 3310, "verse_number": "१६-३९-४०", "content_sanskrit": "अन्तःपुराणां च तदा महानार्तस्वरोऽभवत्।\nपौराणां च महाराज श्रुत्वा राज्ञस्तदा गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2106470, "chapter_id": 3310, "verse_number": "१६-३९-४१", "content_sanskrit": "अहो धिगिति राजा तु विक्रुश्य भृशदुःखितः।\nऊर्ध्वबाहुः स्मरन्मातुः प्ररुरोद युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2106471, "chapter_id": 3310, "verse_number": "१६-३९-४२", "content_sanskrit": "भीमसेनपुरोगाश्च भ्रातरः सर्व एव ते।\n`रुरुदुर्दुःखसंतप्ता वर्णयन्तः पृथां तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2106472, "chapter_id": 3310, "verse_number": "१६-३९-४३", "content_sanskrit": "अन्तःपुरेषु च तदा सुमहान्रुदितस्वनः।\nप्रादुरासीन्महाराज पृथां श्रुत्वा तथागताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2106473, "chapter_id": 3310, "verse_number": "१६-३९-४४", "content_sanskrit": "तं च वृद्धं तथा दग्धं हतपुत्रं नराधिपम्।\nअन्वशोचन्त ते सर्वे गान्धारीं च तपस्विनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2106474, "chapter_id": 3310, "verse_number": "१६-३९-४५", "content_sanskrit": "तस्मिन्नुपरते शब्दे मुहूर्तादिव भारत।\nनिगृह्य बाष्पं धैर्येण धर्मराजोऽब्रवीदिदम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2106475, "chapter_id": 3310, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्रमवासिकपर्वणि नारदागमनपर्वणि एकोनचत्वारिंशोऽध्यायः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]