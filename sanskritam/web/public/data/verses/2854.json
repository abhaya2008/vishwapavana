[{"id": 2087497, "chapter_id": 2854, "verse_number": "१२-३५९-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2087498, "chapter_id": 2854, "verse_number": "१२-३५९-१", "content_sanskrit": "साख्यं योगः पाञ्चरात्रं वेदारण्यकमेव च।\nज्ञानान्येतानि ब्रह्मर्षे लोकेषु प्रचरन्ति ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2087499, "chapter_id": 2854, "verse_number": "१२-३५९-२", "content_sanskrit": "किमेतान्येकनिष्ठानिं पृथङ्निष्ठानि वा मुने।\nप्रब्रूहि वै मया पृष्टः प्रवृत्तिं च यथाक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2087500, "chapter_id": 2854, "verse_number": "१२-३५९-३", "content_sanskrit": "`कथं वैकारिको गच्छेत्पुरुषः पुरुषोत्तमम्।\nवदस्व त्वं मया पृष्टः प्रवृत्तिं च यथाक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2087501, "chapter_id": 2854, "verse_number": "१२-३५९-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2087502, "chapter_id": 2854, "verse_number": "१२-३५९-४", "content_sanskrit": "जज्ञे बहुज्ञं परमत्युदारं\nयं द्वीपमध्ये सुतमात्मवन्तम्।\nपराशरात्सत्यवती महर्षि\nतस्मै नमोऽज्ञानतमोनुदाय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2087503, "chapter_id": 2854, "verse_number": "१२-३५९-५", "content_sanskrit": "पितामहाद्यं प्रवदन्ति षष्ठं\nमहर्षिमार्षेयविभूतियुक्तम्।\nनारायणस्यांशजमेकपुत्रं\nद्वैपायनं वेदमहानिधानम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2087504, "chapter_id": 2854, "verse_number": "१२-३५९-६", "content_sanskrit": "तमादिकालेषु महाविभूति\nर्नारायणो ब्रह्म महानिधानम्।\nससर्ज पुत्रार्थमुदारतेजा\nव्यासं महात्मानमजं पुराणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2087505, "chapter_id": 2854, "verse_number": "१२-३५९-७x", "content_sanskrit": "जनमेजाय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2087506, "chapter_id": 2854, "verse_number": "१२-३५९-७", "content_sanskrit": "त्वयैव कथितः पूर्वं संभवो द्विजसत्तम।\nवसिष्ठस्य सुतः शक्तिः शक्तिपुत्रः पराशरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2087507, "chapter_id": 2854, "verse_number": "१२-३५९-८", "content_sanskrit": "पराशरस्य दायादः कृष्णद्वैपायनो मुनिः।\nभूयो नारायणसुतं त्वमेवैनं प्रभाषसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2087508, "chapter_id": 2854, "verse_number": "१२-३५९-९", "content_sanskrit": "किमतः पूर्वकं जन्म व्यासस्यामिततेजसः।\nकथयस्वोत्तममते जन्म नारायणोद्भवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2087509, "chapter_id": 2854, "verse_number": "१२-३५९-१०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2087510, "chapter_id": 2854, "verse_number": "१२-३५९-१०", "content_sanskrit": "वेदार्थवेत्तुव्यासस्य धर्मिष्ठस्य तपोनिधेः।\nगुरोर्मे ज्ञाननिष्ठस्य हिमवत्पाद आसतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2087511, "chapter_id": 2854, "verse_number": "१२-३५९-११", "content_sanskrit": "कृत्वा भारतमाख्यानं तपः श्रान्तस्य धीमतः।\nशुश्रूषां तत्परा राजन्कृतवन्तो वयं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2087512, "chapter_id": 2854, "verse_number": "१२-३५९-१२", "content_sanskrit": "सुमन्तुर्जैमिनिश्चैव पैलश्च सुदृढव्रतः।\nअहं चतुर्थः शिष्यो वै शुको व्यासात्मजस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2087513, "chapter_id": 2854, "verse_number": "१२-३५९-१३", "content_sanskrit": "एभिः परिवृतो व्यासः शिष्यैः पञ्चभिरुत्तमैः।\nशुशुभे हिमवत्पादे भूतैर्भूतपतिर्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2087514, "chapter_id": 2854, "verse_number": "१२-३५९-१४", "content_sanskrit": "वेदानावर्तयन्साङ्गान्भारतार्थांश्च सर्वशः।\nतमेकमनसं दान्तं युक्ता वयमुपास्महे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2087515, "chapter_id": 2854, "verse_number": "१२-३५९-१५", "content_sanskrit": "कथान्तरेऽथकस्मिंश्चित्पृष्टोऽस्माभिर्द्विजोत्तमः।\nवेदार्थान्भारतार्थांश्च जन्म नारायणात्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2087516, "chapter_id": 2854, "verse_number": "१२-३५९-१६", "content_sanskrit": "स पूर्वमुक्त्वा वेदार्थान्भारतार्थांश्च तत्त्ववित्।\nनारायणादिदं जन्म व्याहर्तुमुपचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2087517, "chapter_id": 2854, "verse_number": "१२-३५९-१७", "content_sanskrit": "शृणुध्वमाख्यानवरमिदमार्षेयमुत्तमम्।\nआदिकालोद्भवं विप्रास्तपसाऽधिगतं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2087518, "chapter_id": 2854, "verse_number": "१२-३५९-१८", "content_sanskrit": "प्राप्ते प्रजाविसर्गे वै सप्तमे पद्मसंभवे।\nनारायणो महायोगी शभाशुभविवर्जितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2087519, "chapter_id": 2854, "verse_number": "१२-३५९-१९", "content_sanskrit": "ससृजे नाभितः पूर्वं ब्रह्माणममितप्रभः।\nततः स प्रादुरभवदथैनं वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2087520, "chapter_id": 2854, "verse_number": "१२-३५९-२०", "content_sanskrit": "मम त्वं नाभितो जातः प्रजासर्गकरः प्रभुः।\nसृज प्रजास्त्वं विविधा ब्रह्मन्सजडपण्डिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2087521, "chapter_id": 2854, "verse_number": "१२-३५९-२१", "content_sanskrit": "स एवमुक्तो विमुखश्चिन्ताव्याकुलमानसः।\nप्रणम्य वरदं देवमुवाच हरिमीश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2087522, "chapter_id": 2854, "verse_number": "१२-३५९-२२", "content_sanskrit": "का शक्तिर्मम देवेश प्रजाः स्रष्टुं नमोस्तु ते।\nअप्रज्ञावानहं देव विधत्स्व यदनन्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2087523, "chapter_id": 2854, "verse_number": "१२-३५९-२३", "content_sanskrit": "स एवमुक्तो भगवान्भूत्वाऽथान्तर्हितस्ततः।\nचिन्तयामास देवेशो बुद्धिं बुद्धिमतांवरः।\nस्वरूपिणी ततो बुद्धिरुपतस्थे हरिं प्रभुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2087524, "chapter_id": 2854, "verse_number": "१२-३५९-२४", "content_sanskrit": "योगेन चैनां निर्योगः स्वयं नियुयुजे तदा।\nस तामैश्वर्ययोगस्थां बुद्धिं गतिमतीं सतीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2087525, "chapter_id": 2854, "verse_number": "१२-३५९-२५", "content_sanskrit": "उवाच वचनं देवो बुद्धिं वै प्रभुरव्ययः।\nब्रह्माणं प्रविशस्वेति लोकसृष्ट्यर्थसिद्धये।\nततस्तमीश्वरादिष्टा बुद्धिः क्षिप्रं विवेश सा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2087526, "chapter_id": 2854, "verse_number": "१२-३५९-२६", "content_sanskrit": "अथैनं बुद्धिसंयुक्तं पुनः स ददृशे हरिः।\nभूयश्चैव वचः प्राह सृजेमा विविधाः प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2087527, "chapter_id": 2854, "verse_number": "१२-३५९-२७", "content_sanskrit": "बाढमित्येव कृत्वाऽसौ यथाऽऽज्ञां शिरसा हरेः।\nएवमुक्त्वा स भगवांस्तत्रैवान्तरधायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2087528, "chapter_id": 2854, "verse_number": "१२-३५९-२८", "content_sanskrit": "प्राप चैनं मुहूर्तेन स्वं स्थानं देवसंज्ञितम्।\nतां चैव प्रकृतिं प्राप्य एकीभावगतोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2087529, "chapter_id": 2854, "verse_number": "१२-३५९-२९", "content_sanskrit": "अथास्य बुद्धिरभवत्पुनरन्या तदा किल।\nसृष्टाः प्रजा इमाः सर्वा ब्रह्मणा परमेष्ठिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2087530, "chapter_id": 2854, "verse_number": "१२-३५९-३०", "content_sanskrit": "दैत्यदानवगन्धर्वरक्षोगणसमाकुला।\nजाता हीयं वसुमती भाराक्रान्ता तपस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2087531, "chapter_id": 2854, "verse_number": "१२-३५९-३१", "content_sanskrit": "बहवो बलिनः पृथ्व्यां दैत्यदानवराक्षसाः।\nभविष्यन्ति तपोयुक्ता वरानप्राप्स्यन्ति चोत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2087532, "chapter_id": 2854, "verse_number": "१२-३५९-३२", "content_sanskrit": "अवश्यमेव तैः सर्वैर्वरदानेन दर्पितैः।\nबाधितव्याः सुरगणा ऋषयश्च तपोधनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2087533, "chapter_id": 2854, "verse_number": "१२-३५९-३३", "content_sanskrit": "तत्र न्याय्यमिदं कर्तुं भारावतरणं मया।\nअथ नानासमुद्भूतैर्वसुधायां यथाक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2087534, "chapter_id": 2854, "verse_number": "१२-३५९-३४", "content_sanskrit": "निग्रहेण च पापानां साधूनां प्रग्रहेण च।\nइदं तपस्विनी सत्या धारयिष्यति मेदिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2087535, "chapter_id": 2854, "verse_number": "१२-३५९-३५", "content_sanskrit": "मया ह्येषा हि ध्रियते पातालस्थेन भोगिना।\nतस्मात्पृथ्व्याः परित्राणं करिष्ये संभवं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2087536, "chapter_id": 2854, "verse_number": "१२-३५९-३६", "content_sanskrit": "एवं स चिन्तयित्वा तु भगवान्मघधुसूदनः।\nरुपाण्यनेकान्यसृजत्प्रादुर्भावभवाय सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2087537, "chapter_id": 2854, "verse_number": "१२-३५९-३७", "content_sanskrit": "वाराहं नारसिहं च वामनं मानुषं तथा।\nएभिर्मया निहन्तव्याः दुर्विनीताः सुरारयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2087538, "chapter_id": 2854, "verse_number": "१२-३५९-३८", "content_sanskrit": "अथ भूयो जगत्स्रष्टा भोःशब्देनानुनादयन्।\nसरस्वतीमुच्चचार तत्र सारस्वतोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2087539, "chapter_id": 2854, "verse_number": "१२-३५९-३९", "content_sanskrit": "अपान्तरतमा नाम सुतो वाक्संभवः प्रभोः।\nभूतभव्यभविष्यज्ञः सत्यवादी दृढव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2087540, "chapter_id": 2854, "verse_number": "१२-३५९-४०", "content_sanskrit": "तमुवाच नतं मूर्ध्ना देवानामादिवरव्ययः।\nवेदाख्याने श्रुतिः कार्या त्वया मतिमतांवर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2087541, "chapter_id": 2854, "verse_number": "१२-३५९-४१", "content_sanskrit": "तस्मात्कुरु यथाज्ञप्तं ममैतद्वचनं मुने।\nतेन भिन्नास्तदा वेदा मनोः स्वायंभुवेन्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2087542, "chapter_id": 2854, "verse_number": "१२-३५९-४२", "content_sanskrit": "ततस्तुतोष भगवान्हरिस्तेनास्य कर्मणा।\nतपसा च सुतप्तेन यमेन नियमेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2087543, "chapter_id": 2854, "verse_number": "१२-३५९-४३", "content_sanskrit": "मन्वन्तरेषु पुत्र त्वमेवं लोकप्रवर्तकः।\nभविष्यस्यचलो ब्रह्मन्नप्रधृष्यश्च नित्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2087544, "chapter_id": 2854, "verse_number": "१२-३५९-४४", "content_sanskrit": "पुनस्तिष्ये च संप्राप्ते कुरवो नाम भारताः।\nभविष्यन्ति महात्मानो राजानः प्रथिता भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2087545, "chapter_id": 2854, "verse_number": "१२-३५९-४५", "content_sanskrit": "तेषां त्वत्तः प्रसूतानां कुलभेदो भविष्यति।\nपरस्परविनाशार्थं त्वामृते द्विजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2087546, "chapter_id": 2854, "verse_number": "१२-३५९-४६", "content_sanskrit": "तत्राप्यनेकधा वेदान्भेत्स्यसे तपसाऽन्वितः।\nकृष्णे युगे च संप्राप्ते कृष्णवर्णो भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2087547, "chapter_id": 2854, "verse_number": "१२-३५९-४७", "content_sanskrit": "धर्माणां विविधानां च कर्ता ज्ञानकरस्तथा।\nभविष्यसि तपोयुक्तो न च रागाद्विमोक्ष्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2087548, "chapter_id": 2854, "verse_number": "१२-३५९-४८", "content_sanskrit": "वीतरागश्च पुत्रस्ते परमात्मा भविष्यति।\nमहेश्वरप्रसादेन नैतद्वचनमन्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2087549, "chapter_id": 2854, "verse_number": "१२-३५९-४९", "content_sanskrit": "यं मानसं वै प्रवदन्ति विप्राः\nपितामहस्योत्तमबुद्धियुक्तम्।\nवसिष्ठमग्र्यं च तपोनिधानं\nयस्यातिसूर्यं व्यरिरिच्यते भाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2087550, "chapter_id": 2854, "verse_number": "१२-३५९-५०", "content_sanskrit": "तस्यान्वपे चापि ततो महर्षिः\nपराशरो नाम महाप्रभावः।\nपिता स ते वेदनिधिर्वरिष्ठो\nमहातपा वै तपसो निवासः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2087551, "chapter_id": 2854, "verse_number": "१२-३५९-५१", "content_sanskrit": "कानीनगर्भः पितृकन्यकायां\nतस्मादृषेस्त्वं भविता च पुत्रः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2087552, "chapter_id": 2854, "verse_number": "१२-३५९-५२", "content_sanskrit": "भूतभव्यभविष्याणां ज्ञानानां वेत्स्यसे गतिम्।\nये ह्यतिक्रान्तकाः पूर्वं सहस्रसुगपर्ययाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2087553, "chapter_id": 2854, "verse_number": "१२-३५९-५३", "content_sanskrit": "तांश्च सर्वान्मयोद्दिष्टान्द्रक्ष्यसे तपसाऽन्वितः।\nपुनर्द्रक्ष्यसि चानेकसहस्रयुगपर्ययान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2087554, "chapter_id": 2854, "verse_number": "१२-३५९-५४", "content_sanskrit": "अनादिनिधनं लोके चक्रहस्तं च मां मुने।\nअनुध्यानान्मम मुने नैतद्वचनमन्यथा।\nभविष्यति महासत्व ख्यातिश्चाप्यतुला तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2087555, "chapter_id": 2854, "verse_number": "१२-३५९-५५", "content_sanskrit": "* शनैश्चरः सूर्यपुत्रो भविष्यति मनुर्महान्।\nतस्मिन्मन्वन्तरे चैव मन्वादिगणपूर्वकः।\nत्वमेव भविता वत्स मत्प्रसादान्न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2087556, "chapter_id": 2854, "verse_number": "१२-३५९-५६", "content_sanskrit": "[यत्किंचिद्विद्यते लोके सर्वं तन्मद्विचेष्टितम्।\nअन्यो ह्यन्यं चिन्तयति स्वच्छन्दं विदधाम्यहम्॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2087557, "chapter_id": 2854, "verse_number": "१२-३५९-५७", "content_sanskrit": "एवं सारस्वतमृषिमपांतरतमं तथा।\nयुक्त्वा वचनमीशानः साधयस्वेत्यथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2087558, "chapter_id": 2854, "verse_number": "१२-३५९-५८", "content_sanskrit": "सोहं तस्य प्रसादेन देवस्य हरिमेधसः।\nअपांतरतमो नाम्ना ततो जातोऽऽज्ञया हरेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2087559, "chapter_id": 2854, "verse_number": "१२-३५९-५९", "content_sanskrit": "पुनश्च जातो विख्यातो वसिष्ठकुलनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2087560, "chapter_id": 2854, "verse_number": "१२-३५९-६०", "content_sanskrit": "तदेतत्कथितं जन्म मया पूर्वकमात्ममः।\nनारायणप्रसादेन तदा नारायणांशजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2087561, "chapter_id": 2854, "verse_number": "१२-३५९-६१", "content_sanskrit": "मया हि सुमहत्तप्तं तपः परमदारुणम्।\nपुरा मतिमतां श्रेष्ठाः परमेण समाधिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2087562, "chapter_id": 2854, "verse_number": "१२-३५९-६२", "content_sanskrit": "एतद्वः कथितं सर्वं यन्मां पृच्छत पुत्रकाः।\nपूर्वजन्म भविष्यं च भक्तानां स्नेहतो मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2087563, "chapter_id": 2854, "verse_number": "१२-३५९-६३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2087564, "chapter_id": 2854, "verse_number": "१२-३५९-६३", "content_sanskrit": "एष ते कथितः पूर्वः संभवोऽस्मद्गुरोर्नृप।\nव्यासस्याक्लिष्टमनसो यथा पृष्टः पुनः शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2087565, "chapter_id": 2854, "verse_number": "१२-३५९-६४", "content_sanskrit": "साङ्ख्यं योगः पाञ्चरात्रं वेदाः पाशुपतं तथा।\nज्ञानान्येतानि राजर्षे विद्धि नानामतानि वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2087566, "chapter_id": 2854, "verse_number": "१२-३५९-६५", "content_sanskrit": "साङ्ख्यस्य वक्ता कपिलः परमर्षिः स उच्यते।\nहिरण्यगर्भो योगस्य वेत्ता नान्यः पुरातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2087567, "chapter_id": 2854, "verse_number": "१२-३५९-६६", "content_sanskrit": "अपांतपतमाश्चैव वेदाचार्यः स उच्यते।\nप्राचीनगर्भं तमृषिं प्रवदन्तीह केचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2087568, "chapter_id": 2854, "verse_number": "१२-३५९-६७", "content_sanskrit": "उमापतिर्भूतपतिः श्रीकण्ठो ब्रह्मणः सुतः।\nउक्तवानिदमव्यग्रो ज्ञानं पाशुपतं शिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2087569, "chapter_id": 2854, "verse_number": "१२-३५९-६८", "content_sanskrit": "पाञ्चरात्रस्य कृत्स्नस्य वक्ता तु भगवान्स्वयम्।\nसर्वेषु च नृपश्रेष्ठ ज्ञानेष्वेतेषु दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2087570, "chapter_id": 2854, "verse_number": "१२-३५९-६९", "content_sanskrit": "यथागमं यथाज्ञानं निष्ठा नारायणः प्रभुः।\nन चैनमेवं जानन्ति तमोभूता विशांपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2087571, "chapter_id": 2854, "verse_number": "१२-३५९-७०", "content_sanskrit": "तमेव शास्त्रकर्तारं प्रवदन्ति मनीषिणः।\nनिष्ठां नारायणमृषिं नान्योस्तीति च वादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2087572, "chapter_id": 2854, "verse_number": "१२-३५९-७१", "content_sanskrit": "निःसंशयेषु सर्वेषु नित्यं वसति वै हरिः।\nससंशयान्हेतुबलान्नाध्यावसति माधवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2087573, "chapter_id": 2854, "verse_number": "१२-३५९-७२", "content_sanskrit": "पाञ्चरात्रविदो ये तु यथाक्रमपरा नृप।\nएकान्तभावोपगतास्ते हरिं प्रविशन्ति वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2087574, "chapter_id": 2854, "verse_number": "१२-३५९-७३", "content_sanskrit": "साङ्ख्यं च योगं च सनातने द्वे\nवेदाश्च सर्वे निखिलेन राजन्।\nसर्वैः समस्तैर्ऋषिभिर्निरुक्तो\nनारायणो विश्वमिदं पुराणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2087575, "chapter_id": 2854, "verse_number": "१२-३५९-७४", "content_sanskrit": "शुभाशुभं कर्म समीरितं य\nत्प्रवर्तते सर्वलोकेषु किंचित्।\nतस्मादृपेस्तद्भवतीति विद्या\nद्दिव्यन्तरिक्षे भुवि चाप्सु चेति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2087576, "chapter_id": 2854, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि नारायणीये एकोनषष्ट्यधिकत्रिशततमोऽध्यायः॥ ३५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}]