[{"id": 900010092, "chapter_id": 8774, "verse_number": "1.1", "content_sanskrit": "राम रामेति रामेति रमे रामे मनोरमे । इत्युमायै शंकरोक्तं मूलरामं सदा भजे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900010093, "chapter_id": 8774, "verse_number": "1.2", "content_sanskrit": "अद्वैतिनां जगन्मिथ्यात्ववादभङ्गः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900010094, "chapter_id": 8774, "verse_number": "1.3", "content_sanskrit": "अद्वैतमहाचार्याणां परस्परं विरोधोद्घाटनम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900010095, "chapter_id": 8774, "verse_number": "1.4", "content_sanskrit": "स्वप्नस्य भगवत्सृष्टत्वं सत्यत्वं तदधीनतिरोधानकत्वम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900010096, "chapter_id": 8774, "verse_number": "1.5", "content_sanskrit": "बृहन्तो ह्यस्मिन् गुणाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900010097, "chapter_id": 8774, "verse_number": "1.6", "content_sanskrit": "स्मृतिरपि प्रमाणमेव", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900010098, "chapter_id": 8774, "verse_number": "1.7", "content_sanskrit": "जीवेश्वरभेदे प्रत्यक्ष अनुमानमपि प्रमाणम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900010099, "chapter_id": 8774, "verse_number": "1.8", "content_sanskrit": "न चाभेदे कश्चिदागमः सन्ति च भेदे सर्वागमाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900010100, "chapter_id": 8774, "verse_number": "1.9", "content_sanskrit": "सर्वस्य स्वरुपं सर्वव्यावृत्ततया अनुभूयते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900010101, "chapter_id": 8774, "verse_number": "1.10", "content_sanskrit": "भेदस्य धर्मिस्वरूपत्वं", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900010102, "chapter_id": 8774, "verse_number": "1.11", "content_sanskrit": "भेदस्य धर्मिस्वरूपत्वं", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900010103, "chapter_id": 8774, "verse_number": "1.12", "content_sanskrit": "विशेषो नाम कथित: सोSस्ति वस्तुष्वशेषत:", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900010104, "chapter_id": 8774, "verse_number": "1.13", "content_sanskrit": "सत्यं ज्ञानं - तत्त्वमसि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900010105, "chapter_id": 8774, "verse_number": "1.14", "content_sanskrit": "न्यायसुधामण्डनस्य तृतीयो भागः समाप्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]