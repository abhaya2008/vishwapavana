[{"id": 7005475000, "chapter_id": 25475, "verse_number": "१-४५-१", "content_sanskrit": "सूत उवाच ।\nएतद् ब्रह्माण्डमाख्यातं चतुर्दशविधं महत् ।\nअतः परं प्रवक्ष्यामि भूर्लोकस्यास्य निर्णयम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005475001, "chapter_id": 25475, "verse_number": "१-४५-२", "content_sanskrit": "जम्बुद्वीपः प्रधानोऽयं प्लक्षः शाल्मलिरेव च ।\nकुशः क्रौञ्चश्च शाकश्च पुष्करश्चैव सप्तमः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005475002, "chapter_id": 25475, "verse_number": "१-४५-३", "content_sanskrit": "एते सप्त महाद्वीपाः समुद्रैः सप्तभिर्वृताः ।\nद्वीपाद् द्वीपो महानुक्तः सागरादपि सागरः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005475003, "chapter_id": 25475, "verse_number": "१-४५-४", "content_sanskrit": "क्षारोदेक्षुरसोदश्च सुरोदश्च घृतोदकः ।\nदध्योदः क्षीरसलिलः स्वादूदश्चेति सागराः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005475004, "chapter_id": 25475, "verse_number": "१-४५-५", "content_sanskrit": "पञ्चाशत्‌कोटिविस्तीर्णा ससमुद्रा धरा स्मृता ।\nद्वीपैश्च सप्तभिर्युक्ता योजनानां समासतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005475005, "chapter_id": 25475, "verse_number": "१-४५-६", "content_sanskrit": "जम्बूद्वीपः समस्तानां द्वीपानां मध्यतः शुभः ।\nतस्य मध्ये महामेरुर्विश्रुतः कनकप्रभः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005475006, "chapter_id": 25475, "verse_number": "१-४५-७", "content_sanskrit": "चतुरशीतिसाहस्रो योजनैस्तस्य चोच्छ्रयः ।\nप्रविष्टः षोडशाधस्ताद्‌द्वात्रिंशन्मूर्ध्नि विस्तृतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005475007, "chapter_id": 25475, "verse_number": "१-४५-८", "content_sanskrit": "मूले षोडशसाहस्रो विस्तारस्तस्य सर्वतः ।\nभूपद्मस्यास्य शैलोऽसौ कर्णिकात्वेन संस्थितः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005475008, "chapter_id": 25475, "verse_number": "१-४५-९", "content_sanskrit": "हिमवान् हेमकूटश्च निषधश्चास्य दक्षिणे ।\nनीलः श्वेतश्च श्रृङ्गी च उत्तरे वर्षपर्वताः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005475009, "chapter_id": 25475, "verse_number": "१-४५-१०", "content_sanskrit": "लक्षप्रमाणौ द्वौ मध्ये दशहीनास्तथा परे ।\nसहस्रद्वितयोच्छ्रायास्तावद्विस्तारिणश्च ते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005475010, "chapter_id": 25475, "verse_number": "१-४५-११", "content_sanskrit": "भारतं दक्षिणं वर्षं ततः किंपुरुषं स्मृतम् ।\nहरिवर्षं तथैवान्यन्मेरोर्दक्षिणतो द्विजाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005475011, "chapter_id": 25475, "verse_number": "१-४५-१२", "content_sanskrit": "रम्यकं चोत्तरं वर्षं तस्यैवानु हिरण्मयम् ।\nउत्तरे कुरवश्चैव यथैते भारतास्तथा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005475012, "chapter_id": 25475, "verse_number": "१-४५-१३", "content_sanskrit": "नवसाहस्रमेकैकमेतेषां द्विजसत्तमाः ।\nइलावृतं च तन्मध्ये तन्मध्ये मेरुरुच्छ्रितः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005475013, "chapter_id": 25475, "verse_number": "१-४५-१४", "content_sanskrit": "मेरोश्चतुर्द्धशं तत्र नवसाहस्रविस्तृतम् ।\nइलावृतं महाभागाश्चत्वारस्तत्र पर्वताः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005475014, "chapter_id": 25475, "verse_number": "१-४५-१५", "content_sanskrit": "विष्कम्भा रचिता मेरोर्योजनायुतमुच्छ्रिताः ।\nपूर्वेण मन्दरो नाम दक्षिणे गन्धमादनः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005475015, "chapter_id": 25475, "verse_number": "१-४५-१६", "content_sanskrit": "विपुलः पश्चिमे पार्श्वे सुपार्श्वश्चोत्तरः स्मृतः ।\nकदम्बस्तेषु जम्बुश्च पिप्पलो वट एव च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005475016, "chapter_id": 25475, "verse_number": "१-४५-१७", "content_sanskrit": "जम्बूद्वीपस्य सा जम्बूर्नामहेतुर्महर्षयः ।\nमहागजप्रमाणानि जम्ब्वास्तस्याः फलानि च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005475017, "chapter_id": 25475, "verse_number": "१-४५-१८", "content_sanskrit": "पतन्ति भूभृतः पृष्ठे शीर्यमाणानि सर्वतः ।\nरसेन तस्याः प्रख्याता तत्र जम्बूनदी गिरौ ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005475018, "chapter_id": 25475, "verse_number": "१-४५-१९", "content_sanskrit": "सरित् प्रवर्त्तते चापि पीयते तत्र वासिभिः ।\nन स्वेदो न च दौर्गन्ध्यं न जरा नेन्द्रियक्षयः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005475019, "chapter_id": 25475, "verse_number": "१-४५-२०", "content_sanskrit": "तत्पानात् सुस्थमनसां नराणां तत्र जायते ।\nतत्तीरमृद्रसं प्राप्य वायुना सुविशोषितम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005475020, "chapter_id": 25475, "verse_number": "१-४५-२१", "content_sanskrit": "जाम्बूनदाख्यं भवति सुवर्णं सिद्धभूषणम् ।\nभद्राश्वः पूर्वतो मेरोः केतुमालश्च पश्चिमे ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005475021, "chapter_id": 25475, "verse_number": "१-४५-२२", "content_sanskrit": "वर्षे द्वे तु मुनिश्रेष्ठास्तयोर्मध्ये इलावृतम् ।\nवनं चैत्ररथं पूर्वं दक्षिणे गन्धमादनम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005475022, "chapter_id": 25475, "verse_number": "१-४५-२३", "content_sanskrit": "वैभ्राजं पश्चिमे विद्यादुत्तरे सवितुर्वनम् ।\nअरुणोदं महाभद्रमसितोदं च मानसम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005475023, "chapter_id": 25475, "verse_number": "१-४५-२४", "content_sanskrit": "सरांस्येतानि चत्वारि देवयोग्यानि सर्वदा ।\nसितान्तश्च कुमुद्वांश्च कुरुरी माल्यवांस्तथा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005475024, "chapter_id": 25475, "verse_number": "१-४५-२५", "content_sanskrit": "वैकङ्को मणिशैलश्च वृक्षवांश्चाचलोत्तमाः ।\nमहानीलोऽथ रुचकः सबिन्दुर्मन्दरस्तथा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005475025, "chapter_id": 25475, "verse_number": "१-४५-२६", "content_sanskrit": "वेणुमांश्चैव मेघश्च निषधो देवपर्वतः ।\nइत्येते देवरचिताः सिद्धावासाः प्रकीर्त्तिताः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005475026, "chapter_id": 25475, "verse_number": "१-४५-२७", "content_sanskrit": "अरुणोदस्य सरसः पूर्वतः केसराचलः ।\nत्रिकूटशिखरश्चैव पतङ्गो रुचकस्तथा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005475027, "chapter_id": 25475, "verse_number": "१-४५-२८", "content_sanskrit": "निषधो वसुधारश्च कलिङ्गस्त्रिशिखः शुभः ।\nसमूलो वसुधारश्च कुरवश्चैव सानुमान् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005475028, "chapter_id": 25475, "verse_number": "१-४५-२९", "content_sanskrit": "ताम्रातश्च विशालश्च कुमुदो वेणुपर्वतः ।\nएकश्रृङ्गो महाशैलो गजशैलः पिशाचकः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005475029, "chapter_id": 25475, "verse_number": "१-४५-३०", "content_sanskrit": "पञ्चशैलोऽथ कैलासो हिमवांशचाचलोत्तमः ।\nइत्येते देवचरिता उत्कटाः पर्वतोत्तमाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005475030, "chapter_id": 25475, "verse_number": "१-४५-३१", "content_sanskrit": "महाभद्रस्य सरसो दक्षिणे केसराचलः ।\nशिखिवासश्च वैदूर्यः कपिलो गन्धमादनः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005475031, "chapter_id": 25475, "verse_number": "१-४५-३२", "content_sanskrit": "जारुधिश्च सुगन्धिश्च श्रीश्रृङ्गश्चाचलोत्तमः ।\nसुपार्श्वश्च सुपक्षश्च कङ्कः कपिल एव च ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005475032, "chapter_id": 25475, "verse_number": "१-४५-३३", "content_sanskrit": "पिञ्जरो भद्रशैलश्च सुसशश्च महाबलः ।\nअञ्जनो मधुमांस्तद्वत् चित्रश्रृड्गो महालयः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005475033, "chapter_id": 25475, "verse_number": "१-४५-३४", "content_sanskrit": "सहस्रशिखरश्चैव पाण्डुरः कृष्ण एव च ।\nपारिजातो महाशैलस्तथैव कपिलोदर ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005475034, "chapter_id": 25475, "verse_number": "१-४५-३५", "content_sanskrit": "सुषेणः पुण्डरीकश्च महामेघस्तथैव च ।\nएते पर्वतराजानः सिद्धगन्धर्वसेविताः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005475035, "chapter_id": 25475, "verse_number": "१-४५-३६", "content_sanskrit": "असितोदस्य सरसः पश्चिमे केसराचलः ।\nशङ्खकूटोऽथ वृषभो हंसो नागस्तथैव च ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005475036, "chapter_id": 25475, "verse_number": "१-४५-३७", "content_sanskrit": "कालाञ्जनः शुक्रशैलो नीलः कमल एव च ।\nपारिजातो महाशैल शैलः कनक एव च ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005475037, "chapter_id": 25475, "verse_number": "१-४५-३८", "content_sanskrit": "पुष्पकश्च सुमेघश्च वाराहो विरजास्तथा ।\nमयूरः कपिलश्चैव महाकपिल एव च ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005475038, "chapter_id": 25475, "verse_number": "१-४५-३९", "content_sanskrit": "इत्येते देवगन्धर्वसिद्धसङ्घनिषेविताः ।\nसरसो मानसस्येह उत्तरे केसराचलाः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005475039, "chapter_id": 25475, "verse_number": "१-४५-४०", "content_sanskrit": "एतेषां शैलमुख्यानामन्तरेषु यथाक्रमम् ।\nसन्ति चैवान्तरद्रोण्यः सरांसि च वनानि च ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005475040, "chapter_id": 25475, "verse_number": "१-४५-४१", "content_sanskrit": "वसन्ति तत्र मुनयः सिद्धाश्च ब्रह्मभाविताः ।\nप्रसन्नाः शान्तरजसः सर्वदुः खविवर्जिताः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]