[{"id": 2113126, "chapter_id": 3435, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2113127, "chapter_id": 3435, "verse_number": "१", "content_sanskrit": "एवमुक्तस्तया राजा तां देवीं वाक्यमब्रवीत् ।\nधर्मविद् धर्मसंयुक्तमिदं वचनमुत्तमम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2113128, "chapter_id": 3435, "verse_number": "२", "content_sanskrit": "एवमेतद् वरारोहे व्युषिताश्वश्चकार ह ।\nत्वया यथोक्तं कल्याणि स ह्यासीदमरोपमः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2113129, "chapter_id": 3435, "verse_number": "३", "content_sanskrit": "अथ त्विमं प्रवक्ष्यामि धर्मं चैव निबोध मे ।\nपुराणमृषिभिर्दृष्टं सर्वधर्मभृतां वरैः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2113130, "chapter_id": 3435, "verse_number": "४", "content_sanskrit": "अनावृताः किल पुरा स्त्रियो ह्यासन् वराङ्गने ।\nकामचारप्रचारिण्यः स्वतन्त्राश्चारुहासिनि \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2113131, "chapter_id": 3435, "verse_number": "५", "content_sanskrit": "तासां व्युच्चरमाणानां कौमारात् सुभगे पतीन् ।\nनासीदधर्मस्तु तदा स हि धर्मः सनातनः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2113132, "chapter_id": 3435, "verse_number": "६", "content_sanskrit": "तं चैव धर्मं धर्मज्ञे तिर्यग्येनिगताः प्रजाः ।\nपालयन्ति वरारोहे यथावदसितेक्षणे \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2113133, "chapter_id": 3435, "verse_number": "७", "content_sanskrit": "उत्तरेष्वपि रम्भोरु कुरुष्वद्यापि वर्तते ।\nस्त्रीणामनुग्रहो धर्मः स एव हि सनातनः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2113134, "chapter_id": 3435, "verse_number": "८", "content_sanskrit": "नाग्निस्तृप्यति काष्ठानां नापगानां महोदधिः ।\nनान्तकः सर्वभूतानां न पुंसां वामलोचना \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2113135, "chapter_id": 3435, "verse_number": "९", "content_sanskrit": "एवं तृष्णा तु नारीणां पुरुषम्पुरुषं प्रति ।\nअगम्यागमनं स्त्रीणां न निमित्तं कृतं शुभे \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2113136, "chapter_id": 3435, "verse_number": "१०", "content_sanskrit": "पुत्रं वा किल पौत्रं वा कासांचिद् भ्रातरं तथा ।\nरहसीह नरं दृष्ट्वा योनिरुत्क्लिद्यते स्त्रियाः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2113137, "chapter_id": 3435, "verse_number": "११", "content_sanskrit": "एतत् स्वाभाविकं स्त्रीणामनिमित्तं तु तद् भवेत् ।\nअस्मिंस्तु नचिराल्लोके मर्यादेयं यशस्विनि \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2113138, "chapter_id": 3435, "verse_number": "१२", "content_sanskrit": "स्थापिता येन यस्माच्च तन्मे विस्तरशः शृणु ।\nबभूवोद्दालको नाम महर्षिरिति नः श्रुतम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2113139, "chapter_id": 3435, "verse_number": "१३", "content_sanskrit": "श्वेतकेतुरिति ख्यातः पुत्रस्तस्याभवन्मुनिः ।\nमर्यादा स्थापिता येन मानुषेषु विशेषतः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2113140, "chapter_id": 3435, "verse_number": "१४", "content_sanskrit": "कोपात् कमलपत्राक्षि यदर्थं तन्निबोध मे ।\nश्वेतकेतोः पिता देवि तप उग्रं समास्थितः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2113141, "chapter_id": 3435, "verse_number": "१५", "content_sanskrit": "ग्रीष्मे पञ्चतपा भूत्वा वर्षास्वासारगोऽभवत् ।\nशिशिरे सलिलस्थायी सह पत्न्या महातपाः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2113142, "chapter_id": 3435, "verse_number": "१६", "content_sanskrit": "उद्दालकं तपस्यन्तं नियमेन समाहितम् ।\nतस्य पुत्रः श्वेतकेतुः परिचर्यां चचार ह \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2113143, "chapter_id": 3435, "verse_number": "१७", "content_sanskrit": "अभ्यगच्छद् द्विजः कश्चिद् वलीपलितसन्ततः ।\nतं दृष्ट्वैव मुनिः श्रेष्ठः पूजयामास शास्त्रतः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2113144, "chapter_id": 3435, "verse_number": "१८", "content_sanskrit": "स्वागतेन च पाद्येन मृदुवाक्यैश्च भारत ।\nशाकमूलफलाद्यैश्च वन्यैरन्यैरपूजयत् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2113145, "chapter_id": 3435, "verse_number": "१९", "content_sanskrit": "क्षुत्पिपासाश्रमैरार्तः पूजितस्तु महर्षिणा ।\nविश्रान्तो मुनिमासाद्य पर्यपृच्छद् द्विजस्तदा \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2113146, "chapter_id": 3435, "verse_number": "२०", "content_sanskrit": "उद्दालक महर्षे त्वं सत्यं मे ब्रूहि माऽनृतम् ।\nऋषिपुत्रः कुमारोऽयं दर्शनीयो विशेषतः ।\nतव पुत्रमिमं मन्ये कृतकृत्योऽसि तद् वद \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2113147, "chapter_id": 3435, "verse_number": "", "content_sanskrit": "उद्दालकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2113148, "chapter_id": 3435, "verse_number": "२१", "content_sanskrit": "मम पत्नी महाप्राज्ञ कुशिकस्य सुता मता ।\nछायेवानपगा पत्नी मम नित्यमनुव्रता \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2113149, "chapter_id": 3435, "verse_number": "२२", "content_sanskrit": "अरुन्धतीव पत्नीनां तपसा कर्शितस्तनी ।\nअस्यां जातः श्वेतकेतुर्मम पुत्रो महातपाः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2113150, "chapter_id": 3435, "verse_number": "२३", "content_sanskrit": "वेदवेदाङ्गविद् विप्र मच्छासनपरायणः ।\nलोकज्ञः सर्वलोकेषु विश्रुतः सत्यवाग् घृणी \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2113151, "chapter_id": 3435, "verse_number": "", "content_sanskrit": "द्विजः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2113152, "chapter_id": 3435, "verse_number": "२४", "content_sanskrit": "अपूर्वी भार्यया चार्थी वृद्धोऽहं मन्दचाक्षुषः ।\nपित्र्यादृणादनिर्मुक्तः पूर्वमेव कृतः स्त्रियः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2113153, "chapter_id": 3435, "verse_number": "२५", "content_sanskrit": "प्रजारणी तु पत्नी ते कुलशीलसमाधिनी ।\nसदृशी मम गोत्रेण वहाम्येनां क्षमस्व वै \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2113154, "chapter_id": 3435, "verse_number": "", "content_sanskrit": "पाण्डुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2113155, "chapter_id": 3435, "verse_number": "२६", "content_sanskrit": "इत्युक्त्वा मृगशाबाक्षीं चीरकृष्णजिनाम्बराम् ।\nयष्ट्याधारः स्रस्तगात्रो मन्दचक्षुरबुद्धिमान्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2113156, "chapter_id": 3435, "verse_number": "२७", "content_sanskrit": "स्वव्यापाराक्षमो श्रेष्ठामचित्तामात्मनि द्विजः ।\nश्वेतकेतोः किल पुरा समक्षं मातरं पितुः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2113157, "chapter_id": 3435, "verse_number": "२८", "content_sanskrit": "जग्राह ब्राह्मणः पाणौ गच्छाव इति चाब्रवीत् ।\nऋषिपुत्रस्ततः कोपं चकारामर्षितस्तदा \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2113158, "chapter_id": 3435, "verse_number": "२९", "content_sanskrit": "स मातरं तथा दृष्ट्वा नीयमानां बलादिव ।\nतपसा दीप्तवीर्यो हि श्वेतकेतुर्न चक्षमे\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2113159, "chapter_id": 3435, "verse_number": "३०", "content_sanskrit": "सङ्गृह्य मातरं हस्ते श्वेतकेतुरभाषत ।\nदुर्ब्राह्मण विमुञ्च त्वं मातरं मे पतिव्रताम् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2113160, "chapter_id": 3435, "verse_number": "३१", "content_sanskrit": "अयं पिता मे ब्रह्मर्षिः क्षमावान् ब्रह्मवित्तमः ।\nशापानुग्रहयोः शक्तः तूष्णीम्भूतो महाव्रतः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2113161, "chapter_id": 3435, "verse_number": "३२", "content_sanskrit": "तस्य पत्नी शमोपेता मम माता विशेषतः ।\nपतिव्रतां तपोयुक्तां साध्वाचारैरलङ्कृताम् ।\nप्राणदानेन ते ब्रह्मन् मातृभूतां विमुञ्च मे \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2113162, "chapter_id": 3435, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2113163, "chapter_id": 3435, "verse_number": "३३", "content_sanskrit": "एवमुक्त्वा तु याचन्तं विमुञ्चेति मुहुर्मुहुः ।\nप्रत्यवोचद् द्विजो राजन् अप्रगल्भमिदं वचः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2113164, "chapter_id": 3435, "verse_number": "३४", "content_sanskrit": "अपत्यार्थी श्वेतकेतो वृद्धोऽहं मन्दचाक्षुषः ।\nपिता ते ऋणनिर्मुक्तः त्वया पुत्रेण काश्यपः \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2113165, "chapter_id": 3435, "verse_number": "३५", "content_sanskrit": "ऋणादहमनिर्मुक्तो वृद्धोऽहं विगतस्पृहः ।\nमम को दास्यति सुतां कन्यां सम्प्राप्तयौवनाम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2113166, "chapter_id": 3435, "verse_number": "३६", "content_sanskrit": "प्रजारणीमिमां पत्नीं विमुञ्च त्वं महातपाः ।\nएकया प्रजया प्रीतो मातरं ते ददाम्यहम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2113167, "chapter_id": 3435, "verse_number": "३७", "content_sanskrit": "एवमुक्तः श्वेतकेतुर्लज्जया क्रोधमेयिवान् ।\nतं क्रुद्धं वै पिता ज्ञात्वा श्वतकेतुमुवाच ह \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2113168, "chapter_id": 3435, "verse_number": "३८", "content_sanskrit": "मा तात कोपं कार्षीस्त्वमेष धर्मः सनातनः ।\nअनावृता हि वर्णानां सर्वेषामङ्गना भुवि \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2113169, "chapter_id": 3435, "verse_number": "३९", "content_sanskrit": "यथा गावः स्थितास्तात स्वेस्वे वर्णे तथा प्रजाः ।\nतथैव वै कुटुम्बेषु न प्रापद्यन्त कर्हिचित् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2113170, "chapter_id": 3435, "verse_number": "४०", "content_sanskrit": "ऋतुकाले तु सम्प्राप्ते भर्तारं न जहुस्तदा ।\nएवमुक्तो महाबाहुः श्वेतकेतुर्न चक्षमे \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2113171, "chapter_id": 3435, "verse_number": "४२", "content_sanskrit": "चकारैव च मर्यादामिमां स्त्रीपुंसयोर्भुवि ।\nमानुषेष्वसितापाङ्गे न त्वेवान्येषु जन्तुषु \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2113172, "chapter_id": 3435, "verse_number": "४३", "content_sanskrit": "तदाप्रभृति मर्यादा स्थापितेयमिति श्रुतिः ।\nव्युच्चरन्त्याः पतिं नार्या अद्यप्रभृति पातकम् ।\nभ्रूणहत्यासमं पापं भविष्यत्यसुखावहम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2113173, "chapter_id": 3435, "verse_number": "", "content_sanskrit": "पाण्डुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2113174, "chapter_id": 3435, "verse_number": "४४", "content_sanskrit": "अद्याप्यनुविधीयन्ते कामद्वेषविवर्जिताः ।\nउत्तरेषु महाभागे कुरुष्वेवं यशस्विनि \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2113175, "chapter_id": 3435, "verse_number": "४५", "content_sanskrit": "पुराणदृष्टो धर्मोऽयं पूज्यते च महर्षिभिः ।\nभार्यां तथा व्युच्चरतः कौमारीं ब्रह्मचारिणीम् \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2113176, "chapter_id": 3435, "verse_number": "४६", "content_sanskrit": "पतिव्रतामेतदेव भविता पातकं भुवि ।\nपत्या नियुक्ता या चैव पत्न्यपत्यार्थमेव च \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2113177, "chapter_id": 3435, "verse_number": "४७", "content_sanskrit": "न करिष्यति तस्याश्च भविष्यत्येतदेव हि ।\nइति तेन पुरा भीरु मर्यादा स्थापिताऽबले \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2113178, "chapter_id": 3435, "verse_number": "४८", "content_sanskrit": "उद्दालकस्य पुत्रेण धर्मे वै श्वेतकेतुना ।\nतेन भूयस्ततो दृष्टं यस्मिन्नर्थे निबोध तत्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2113179, "chapter_id": 3435, "verse_number": "४९", "content_sanskrit": "नियुक्ता पतिना भार्या यद्यपत्यस्य कारणात् ।\nन कुर्यात् तत्तथा भीरु सैनः सुमहदाप्नुयात् \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2113180, "chapter_id": 3435, "verse_number": "५०", "content_sanskrit": "सौदासेन च रम्भोरु नियुक्ताऽपत्यकर्मणि ।\nमदयन्ती जगामर्षिं वसिष्ठमिति नः श्रुतम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2113181, "chapter_id": 3435, "verse_number": "५१", "content_sanskrit": "तस्माल्लेभेऽथ सा पुत्रमश्मकं नाम भामिनि ।\nभार्या कल्माषपादस्य भर्तुः प्रियहितैषिणी \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2113182, "chapter_id": 3435, "verse_number": "५२", "content_sanskrit": "अस्माकमपि वै जन्म विदितं कमलेक्षणे ।\nकृष्णद्वैपायनाद् भीरु कुरूणां वंशवृद्धये \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2113183, "chapter_id": 3435, "verse_number": "५३", "content_sanskrit": "तस्मादेतानि सर्वाणि कारणानि निरीक्ष्य तु ।\nसम्प्रधार्य मयोक्तं यत् तत् त्वं वै कर्तुमर्हसि \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2113184, "chapter_id": 3435, "verse_number": "५४", "content_sanskrit": "ऋतावृतौ राजपुत्रि स्त्रिया भर्ता शुभेक्षणे ।\nनातिवर्त्य इति त्वेवं धर्मं धर्मविदो विदुः \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2113185, "chapter_id": 3435, "verse_number": "५५", "content_sanskrit": "शेषेष्वन्येषु कालेषु स्वातन्त्र्यं स्त्री किलार्हति ।\nधर्मं चैव जनाः सन्तः पुराणं परिचक्षते \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2113186, "chapter_id": 3435, "verse_number": "५६", "content_sanskrit": "भर्ता स्त्रियं राजपुत्रि शुभं वा यदि वाऽशुभम् ।\nकार्यं नियुव्ज्यात् सुश्रोणि कर्तव्यं तदकालिकम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2113187, "chapter_id": 3435, "verse_number": "५७", "content_sanskrit": "विशेषतः पुत्रगृध्नुर्हतः प्रजननात् स्वयम् ।\nयथाऽहमनवद्याङ्गि पुत्रदर्शनलालसः \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2113188, "chapter_id": 3435, "verse_number": "५८", "content_sanskrit": "अयं रक्ताङ्गुलितळः पद्मपत्रनिभःशुभः ।\nप्रसादनार्थं सुश्रोणि शिरस्यभ्युद्यतोऽञ्जलिः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2113189, "chapter_id": 3435, "verse_number": "५९", "content_sanskrit": "मन्नियोगात् सुकेशान्ते मत्तः श्रेयस्करैर्द्विजैः ।\nअपत्यानि विशिष्टानि कैश्चिदुत्पादयाबले ।\nत्वत्कृतेऽहं पृथुश्रोणि गच्छेयं पुत्रिणां गतिम्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2113190, "chapter_id": 3435, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2113191, "chapter_id": 3435, "verse_number": "६०", "content_sanskrit": "एवमुक्ता ततः कुन्ती पाण्डुं परपुरञ्जयम् ।\nप्रत्युवाच वरारोहा भर्तुः प्रियचिकीर्षया \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2113192, "chapter_id": 3435, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2113193, "chapter_id": 3435, "verse_number": "६१", "content_sanskrit": "अधर्मः सुमहानेष स्त्रीणां भरतसत्तम ।\nयत् प्रसादयते भर्ता प्रसाद्यः क्षत्रियर्षभ \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2113194, "chapter_id": 3435, "verse_number": "६२", "content_sanskrit": "शृणु चेदं महाबाहो मम प्रीतिकरं वचः ।\nपितृवेश्मन्यहं बाला नियुक्ताऽतिथिभोजने \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2113195, "chapter_id": 3435, "verse_number": "६३", "content_sanskrit": "उग्रं पर्यचरं पूर्वं ब्राह्मणं संशितव्रतम् ।\nनिगूढनिश्चयं धर्मे यं तं दुर्वाससं विदुः \t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2113196, "chapter_id": 3435, "verse_number": "६४", "content_sanskrit": "तमुग्रं संशितात्मानं सर्वयत्नैरतोषयम् ।\nस मे ह्याचारसंयुक्तमाचष्ट भगवान् ऋषिः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2113197, "chapter_id": 3435, "verse_number": "६५", "content_sanskrit": "मन्त्रग्रामं च मे प्रादादब्रवीच्चैव मामिदम् ।\nयंयं देवं त्वमेतेन मन्त्रेणावाहयिष्यसि\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2113198, "chapter_id": 3435, "verse_number": "६६", "content_sanskrit": "अकामो वा सकामो वा स भविष्यति ते वशम् ।\nइत्युक्ताऽहं तदा तेन पितृवेश्मनि भारत\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2113199, "chapter_id": 3435, "verse_number": "६७", "content_sanskrit": "ब्राह्मणस्य वचस्तथ्यं तस्य कालोऽयमागतः ।\nअनुज्ञाता त्वया देवमाह्वयेयं परन्तप \t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2113200, "chapter_id": 3435, "verse_number": "६८", "content_sanskrit": "यां मे विद्यां महाराज अददात् स महायशाः ।\nपरावरज्ञो मेधावी कृपयाऽभिपरिप्लुतः \t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2113201, "chapter_id": 3435, "verse_number": "६९", "content_sanskrit": "तयाऽऽहूतः सुरः पुत्रं प्रदास्यति सुरोपमम् ।\nअनपत्यकृतं यस्ते शोकं हि व्यपनेष्यति \t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2113202, "chapter_id": 3435, "verse_number": "११४", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nचतुर्दशाधिकशततमोऽध्यायः ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2113203, "chapter_id": 3435, "verse_number": "६२", "content_sanskrit": "॥ इति सम्भवपर्वणि द्विषष्टितमोऽध्यायः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2113204, "chapter_id": 3435, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}]