[{"id": 7003229000, "chapter_id": 23229, "verse_number": "१-३२-१", "content_sanskrit": "सनत्कुमार उवाच  ।\nकथं भव प्रसादेन देवदारुवनौकसः  ।\nप्रपन्नाः शरणं देवं वक्तुमर्हसि मे प्रभो ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003229001, "chapter_id": 23229, "verse_number": "१-३२-२", "content_sanskrit": "शैलादिरुवाच  ।\nतानुवाच महाभागान्भगवानात्मभूः स्वयम्  ।\nदेवदारुवनस्थांस्तु तपसा पावकप्रभान् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003229002, "chapter_id": 23229, "verse_number": "१-३२-३", "content_sanskrit": "पितामह उवाच  ।\nएष देवो महादेवो विज्ञेयस्तु महेश्वरः  ।\nन तस्मात्परमं किंचित्पदं सम धिगम्यते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003229003, "chapter_id": 23229, "verse_number": "१-३२-४", "content_sanskrit": "देवानां च ऋषीणां च पितॄणां चैव स प्रभुः  ।\nसहस्रयुगपर्यंते पुलये सर्वदेहिनः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003229004, "chapter_id": 23229, "verse_number": "१-३२-५", "content_sanskrit": "संहरत्येष भगवान् कालो भूत्वा महेश्वरः  ।\nएष चैव प्रजाः सर्वाः सृजत्येकः स्वतेजसा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003229005, "chapter_id": 23229, "verse_number": "१-३२-६", "content_sanskrit": "एष चक्री च वज्री च श्रीवत्सकृतलक्षणः  ।\nयोगी कृतयुगे चैव त्रेतायां क्रतु रुच्यते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003229006, "chapter_id": 23229, "verse_number": "१-३२-७", "content_sanskrit": "द्वापरे चैव कालाग्निर्धमकेतुः कलौ स्मृतः  ।\nरुद्रस्य मूर्तयस्त्वेता येऽभिध्यायांति पंडिताः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003229007, "chapter_id": 23229, "verse_number": "१-३२-८", "content_sanskrit": "चतुरस्रं बहिश्चांतरष्टास्रं पिंडिकाश्रये  ।\nवृत्तं सुदर्शनं योग्यमेवं लिङ्गं प्रपूजयेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003229008, "chapter_id": 23229, "verse_number": "१-३२-९", "content_sanskrit": "तमो ह्यग्नी रजो ब्रह्मा सत्त्वं विष्णुः प्रकाशकम्  ।\nमूर्तिरेका स्थिता चास्य मूर्तयः परिकीर्तिताः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003229009, "chapter_id": 23229, "verse_number": "१-३२-१०", "content_sanskrit": "यत्र तिष्ठति तद्ब्रह्म योगेन तु समन्वितम्  ।\nतस्माद्धि देवदेवेशमीशानं प्रभुमव्ययम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003229010, "chapter_id": 23229, "verse_number": "१-३२-११", "content_sanskrit": "आराधयंति विप्रेंद्रा जितक्रोधा जितोंद्रियाः  ।\nलिंगं कृत्वा यथान्यायं सर्वलक्षणसंयुतम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003229011, "chapter_id": 23229, "verse_number": "१-३२-१२", "content_sanskrit": "अंगुष्ठमात्रं सुशुभं सुवृत्तं सर्वसंमतम्  ।\nसमनाभं तथाष्टास्रं षोडशास्रमतापि वा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003229012, "chapter_id": 23229, "verse_number": "१-३२-१३", "content_sanskrit": "सुवृत्तं मंडलं दिव्यं सर्वकामफलप्रदम्  ।\nवेदिका द्विगुणा तस्य समा वा सर्वसंमता ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003229013, "chapter_id": 23229, "verse_number": "१-३२-१४", "content_sanskrit": "गोमुखी च त्रिभागैका वेद्या लक्षणसयुता  ।\nपट्टिका च समंताद्वै यवमात्रा द्विजोत्तमाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003229014, "chapter_id": 23229, "verse_number": "१-३२-१५", "content_sanskrit": "सौवर्णं राजतं शैलं कृत्वा ताम्रमयं तथा  ।\nवेदिकायाश्च विस्तारं त्रिगुणं वै समन्ततः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003229015, "chapter_id": 23229, "verse_number": "१-३२-१६", "content_sanskrit": "वर्तुलं चतुरस्रं वा षडस्रं वा त्रिरस्रकम्  ।\nसमंतान्निर्व्रणं शुभ्रं लक्षणैस्तत्सुलीक्षितम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003229016, "chapter_id": 23229, "verse_number": "१-३२-१७", "content_sanskrit": "प्रतिष्ठाप्य यथान्यायं पूजालक्षणसंयुतम्  ।\nकलशं स्थापयेत्तस्य वेदिमध्ये तथा द्विजाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003229017, "chapter_id": 23229, "verse_number": "१-३२-१८", "content_sanskrit": "सहिरण्यं सबीजं च ब्रह्मभिश्चाभिमंत्रितम्  ।\nसेचयेच्च ततो लिंगं पवित्रैः पञ्चभिः शुभैः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003229018, "chapter_id": 23229, "verse_number": "१-३२-१९", "content_sanskrit": "पूजयेच्च यथालाभं ततः सिद्धिमवाप्स्यथ  ।\nसमाहिताः पूजयध्वं सपुत्राः सह बंधुभिः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003229019, "chapter_id": 23229, "verse_number": "१-३२-२०", "content_sanskrit": "सर्वे प्रांजलयो भूत्वा शूलपाणिं प्रपद्यत  ।\nततो द्रक्ष्यथ देवेशं दुर्दर्शमकृतात्मभिः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003229020, "chapter_id": 23229, "verse_number": "१-३२-२१", "content_sanskrit": "यं दृष्ट्वा सर्वमज्ञानमधर्मश्च प्रणश्यति  ।\nततः प्रदक्षिणं कृत्वा ब्रह्माणममितौजसम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003229021, "chapter_id": 23229, "verse_number": "१-३२-२२", "content_sanskrit": "संप्रस्थिता वनौकास्ते देवदारुवनं ततः  ।\nआराधयितुमारब्धा ब्रह्मणा कथितं यथा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003229022, "chapter_id": 23229, "verse_number": "१-३२-२३", "content_sanskrit": "स्थंडिलेषु विचित्रेषु पर्वतानां गुहासु च  ।\nनदीनां च विविक्तेषु पुलिनेषु शुभेषु च ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003229023, "chapter_id": 23229, "verse_number": "१-३२-२४", "content_sanskrit": "शैवालशोभनाः केचित्केचिदंतर्जलेशयाः  ।\nकेचिद्दर्भावकाशास्तु पादांगुष्ठाग्रधिष्ठिताः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003229024, "chapter_id": 23229, "verse_number": "१-३२-२५", "content_sanskrit": "दंतोलूखलिनस्त्वन्ये अश्मकुट्टास्तथा परे  ।\nस्थानवीरासनास्त्वन्ये मृगचर्यारताः परे ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003229025, "chapter_id": 23229, "verse_number": "१-३२-२६", "content_sanskrit": "कालं नयांति तपसा पूजया च महाधियः  ।\nएवं संवत्सरे पूर्णे वसंते समुपस्थिते ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003229026, "chapter_id": 23229, "verse_number": "१-३२-२७", "content_sanskrit": "ततस्तेषां प्रसादार्थं भक्तानामनुकंपया  ।\nदेवः कृतयुगे तस्मिन्गिरौ हिमवतः शुभे ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003229027, "chapter_id": 23229, "verse_number": "१-३२-२८", "content_sanskrit": "देवदारुवनं प्राप्तः प्रसन्नः परमेश्वरः  ।\nभस्मपांसूपदिग्धांगो नग्नो विकृतलक्षणः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003229028, "chapter_id": 23229, "verse_number": "१-३२-२९", "content_sanskrit": "उल्मुकव्यग्रहस्तश्च रक्तपिंगललोचनः  ।\nक्वचिच्चहसते रौद्रं क्वचिद्गायति विस्मितः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003229029, "chapter_id": 23229, "verse_number": "१-३२-३०", "content_sanskrit": "क्वचिन्नृत्यति श्रृंगारं क्वचिद्रौति मुहुर्मुहुः  ।\nआश्रमे ह्यटते भैक्ष्यं याचते च पुनः पुनः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003229030, "chapter_id": 23229, "verse_number": "१-३२-३१", "content_sanskrit": "मायां कृत्वा तथारूपां देवस्तद्वनमागतः  ।\nततस्ते मुनयः सर्वे तुष्टुवुश्च समाहिताः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003229031, "chapter_id": 23229, "verse_number": "१-३२-३२", "content_sanskrit": "अद्भिर्विविधमाल्यैश्च धूपैर्गन्धैस्तथैव च  ।\nसपत्नीका महाभागाः सपुत्राः सपरिच्छदाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003229032, "chapter_id": 23229, "verse_number": "१-३२-३३", "content_sanskrit": "मुनयस्ते तथा वाग्भिरीश्वरं चेदमब्रुन्  ।\nअज्ञानाद्देवदेवेश यदस्माभिरनुष्ठितम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003229033, "chapter_id": 23229, "verse_number": "१-३२-३४", "content_sanskrit": "कर्मणा मनसा वाचा तत्सर्वं क्षंतुमर्हसि  ।\nचरितानि विचित्राणी गुह्यानि गहनानि च ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003229034, "chapter_id": 23229, "verse_number": "१-३२-३५", "content_sanskrit": "ब्रह्मादीनां च देवानां दुर्विज्ञे यानि ते हर  ।\nअगतिं ते न जानीमो गतिं नैव च नैव च ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003229035, "chapter_id": 23229, "verse_number": "१-३२-३६", "content_sanskrit": "विश्वेश्वर महादेव योसि सोसि नमोस्तु ते  ।\nस्तुवंति त्वां महात्मानो देवदेवं महेश्वरम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003229036, "chapter_id": 23229, "verse_number": "१-३२-३७", "content_sanskrit": "नमो भवाय भव्याय भावनायोद्भवाय च  ।\nअनंतबलवीर्याय भूतानां पतये नमः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003229037, "chapter_id": 23229, "verse_number": "१-३२-३८", "content_sanskrit": "संहर्त्रे च पिशंगाय अव्ययाय व्ययाय च  ।\nगंगासलिलधाराय आधाराय गुणात्मने ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003229038, "chapter_id": 23229, "verse_number": "१-३२-३९", "content_sanskrit": "त्र्यंबकाय त्रिनेत्राय त्रिशूलवरधारिणे  ।\nकंदर्पाय हुताशाय नमोस्तु परमात्मने ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003229039, "chapter_id": 23229, "verse_number": "१-३२-४०", "content_sanskrit": "शंकराय वृषांकाय गणानां पतये नमः  ।\nदंडहस्ताय कालाय पाशहस्ताय वै नमः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003229040, "chapter_id": 23229, "verse_number": "१-३२-४१", "content_sanskrit": "वेदमंत्रप्रधानाय शतजिह्वाय वै नमः  ।\nभूतं भव्यं भविष्यं च स्थावरं जंगमं च यत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003229041, "chapter_id": 23229, "verse_number": "१-३२-४२", "content_sanskrit": "तव देहात्समुत्पन्नं देव सर्वमिदं जगत्  ।\nपासि हंसि च भद्रं ते प्रसीद भगवंस्ततः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003229042, "chapter_id": 23229, "verse_number": "१-३२-४३", "content_sanskrit": "अज्ञानाद्यदि विज्ञानाद्यत्किंचित्कुरुते नरः  ।\nतत्सर्वं भगवानेव कुरुते योगमायया ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003229043, "chapter_id": 23229, "verse_number": "१-३२-४४", "content_sanskrit": "एवं स्तुत्वा तु मुनयः प्रहृष्टैरंतरात्मभिः  ।\nयाचन्त तपसा युक्तः पश्यामस्त्वां यथापुरा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003229044, "chapter_id": 23229, "verse_number": "१-३२-४५", "content_sanskrit": "ततो देवः प्रसन्नात्मा स्वमेवास्थाय शंकरः  ।\nरूपं त्र्यक्षं च संद्रष्टुं दिव्यं चक्षुरदात्प्रभुः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003229045, "chapter_id": 23229, "verse_number": "१-३२-४६", "content_sanskrit": "लब्धदृष्ट्या तया दृष्ट्वा देवदेवं त्रियंबकम्  ।\nपुनस्तुष्टुवुरीशानं देवदारुवनौकसः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]