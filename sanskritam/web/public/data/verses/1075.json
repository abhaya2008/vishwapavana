[{"id": 2003878, "chapter_id": 1075, "verse_number": "१-७६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2003879, "chapter_id": 1075, "verse_number": "१-७६-१", "content_sanskrit": "ययातिः स्वपुरं प्राप्य महेन्द्रपुरसंनिभम्।\nप्रविश्यान्तःपुरं तत्र देवयानीं न्यवेशयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2003880, "chapter_id": 1075, "verse_number": "१-७६-२", "content_sanskrit": "देवयान्याश्चानुमते सुतां तां वृषपर्वणः।\nअशोकवनिकाभ्याशे गृहं कृत्वा न्यवेशयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2003881, "chapter_id": 1075, "verse_number": "१-७६-३", "content_sanskrit": "वृतां दासीसहस्रेण शर्मिष्ठां वार्षपर्वणीम्।\nवासोभरन्नपानैश्च संविभज्य सुसत्कृताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2003882, "chapter_id": 1075, "verse_number": "१-७६-४", "content_sanskrit": "देवयान्या तु सहितः स नृपो नहुषात्मजः।\nप्रीत्या परमया युक्तो मुमुदे शाश्वतीः समाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2003883, "chapter_id": 1075, "verse_number": "१-७६-५", "content_sanskrit": "अशोकवनिकामध्ये देवयानी समागता।\nशर्मिष्ठया सा क्रीडित्वा रमणीये मनोरमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2003884, "chapter_id": 1075, "verse_number": "१-७६-६", "content_sanskrit": "तत्रैव तां तु निर्दिश्य राज्ञा सह ययौ गृहम्।\nएवमेव सह प्रीत्या बहु कालं मुमोद च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2003885, "chapter_id": 1075, "verse_number": "१-७६-७", "content_sanskrit": "विजहार बहूनब्दान्देववन्मुदितः सुखी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2003886, "chapter_id": 1075, "verse_number": "१-७६-८", "content_sanskrit": "ऋतुकाले तु संप्राप्ते देवयानी वराङ्गना।\nलेभे गर्भं प्रथमतः कुमारं च व्यजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2003887, "chapter_id": 1075, "verse_number": "१-७६-९", "content_sanskrit": "गते वर्षसहस्रे तु शर्मिष्ठा वार्षपर्वणी।\nददर्श यौवनं प्राप्ता ऋतुं सा चान्वचिन्तयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2003888, "chapter_id": 1075, "verse_number": "१-७६-१०", "content_sanskrit": "शुद्धा स्नाता तु शर्मिष्ठा सर्वालङ्कारशोभिता।\nअशोकशाखामालम्ब्य सुपुष्पस्तबकैर्वृताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2003889, "chapter_id": 1075, "verse_number": "१-७६-११", "content_sanskrit": "आदर्शे मुखमुद्वीक्ष्य भर्तुर्दर्शनलालसा।\nशोकमोहसमाविष्टा वचनं चेदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2003890, "chapter_id": 1075, "verse_number": "१-७६-१२", "content_sanskrit": "अशोक शोकापनुद शोकोपहतचेतसाम्।\nत्वन्नामानं कुरुष्वाद्य प्रियसंदर्शनेन माम्।\nएवमुक्तवती सा तु शर्मिष्ठा पुनरब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2003891, "chapter_id": 1075, "verse_number": "१-७६-१३", "content_sanskrit": "ऋतुकालश्च संप्राप्तो न च मेऽस्ति वृतः पतिः।\nकिं प्राप्तं किं नु कर्तव्यं किं वा कृत्वा सुखं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2003892, "chapter_id": 1075, "verse_number": "१-७६-१४", "content_sanskrit": "देवयानी प्रजाताऽसौ वृथाऽहं प्राप्तयौवना।\nयथा तया वृतो भर्ता तथैवाहं वृणोमि तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2003893, "chapter_id": 1075, "verse_number": "१-७६-१५", "content_sanskrit": "राज्ञा पुत्रफलं देयमिति मे निश्चिता मतिः।\nअपीदानीं स धर्मात्मा ईयान्मे दर्शनं रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2003894, "chapter_id": 1075, "verse_number": "१-७६-१६", "content_sanskrit": "केशैर्बध्या तु राजानं याचेऽहं सदृशं पतिम्।\nस्पृहेदिदं देवयानी पुत्रमीक्ष्य पुनःपुनः।\nक्रीडन्नन्तःपुरे तस्याः क्वचित्क्षणमवाप्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2003895, "chapter_id": 1075, "verse_number": "१-७६-१७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2003896, "chapter_id": 1075, "verse_number": "१-७६-१७", "content_sanskrit": "अथ निष्क्रम्य राजाऽसौ तस्मिन्काले यदृच्छया।\nअशोकवनिकाभ्याशे शर्मिष्ठां प्राप तिष्ठतीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2003897, "chapter_id": 1075, "verse_number": "१-७६-१८", "content_sanskrit": "तमेकं रहिते दृष्ट्वा शर्मिष्ठा चारुहासिनी।\nप्रत्युद्गम्याञ्जलिं कृत्वा राजानं वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2003898, "chapter_id": 1075, "verse_number": "१-७६-१९x", "content_sanskrit": "शर्मिष्ठोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2003899, "chapter_id": 1075, "verse_number": "१-७६-१९", "content_sanskrit": "सोमस्येन्द्रस्य विष्णोर्वा यमस्य वरुणस्य वा।\nतव वा नाहुष गृहे कः स्त्रियं द्रष्टुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2003900, "chapter_id": 1075, "verse_number": "१-७६-२०", "content_sanskrit": "रूपाभिजनशीलैर्हि त्वं राजन्वेत्थ मां सदा।\nसा त्वां याचे प्रसाद्याहमृतुं देहि नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2003901, "chapter_id": 1075, "verse_number": "१-७६-२१x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2003902, "chapter_id": 1075, "verse_number": "१-७६-२१", "content_sanskrit": "वेद्मि त्वां शीलसंपन्नां दैत्यकन्यामनिन्दिताम्।\nरूपं च ते न पश्यामि सूच्यग्रमपि निन्दितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2003903, "chapter_id": 1075, "verse_number": "१-७६-२२", "content_sanskrit": "तदाप्रभृति दृष्ट्वा त्वां स्मराम्यनिशमुत्तमे।\nअब्रवीदुशना काव्यो देवयानीं यदाऽवहम्।\nनेयमाह्वयितव्या ते शयने वार्षपर्वणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2003904, "chapter_id": 1075, "verse_number": "१-७६-२३", "content_sanskrit": "देवयान्याः प्रियं कृत्वा शर्मिष्ठामपि पोषय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2003905, "chapter_id": 1075, "verse_number": "१-७६-२४x", "content_sanskrit": "शर्मिष्ठोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2003906, "chapter_id": 1075, "verse_number": "१-७६-२४", "content_sanskrit": "न नर्मयुक्तमनृतं हिनस्ति\nन स्त्रीषु राजन्न विवाहकाले।\nप्राणात्यये सर्वधनापहारे\nपञ्चानृतान्याहुरपातकानि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2003907, "chapter_id": 1075, "verse_number": "१-७६-२५", "content_sanskrit": "पृष्टं तु साक्ष्ये प्रवदन्तमन्यथा\nवदन्ति मिथ्या पतितं नरेन्द्र।\nएकार्थतायां तु समाहितायां\nमिथ्या वदन्तं ह्यनृतं हिनस्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2003908, "chapter_id": 1075, "verse_number": "१-७६-२६", "content_sanskrit": "अनृतं नानृतं स्त्रीषु परिहासविवाहयोः।\nआत्मप्राणार्थघाते च तदेवोत्तमतां व्रजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2003909, "chapter_id": 1075, "verse_number": "१-७६-२७x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2003910, "chapter_id": 1075, "verse_number": "१-७६-२७", "content_sanskrit": "राजा प्रमाणं भूतानां स नश्येत मृषा वदन्।\nअर्थकृच्छ्रमपि प्राप्य न मिथ्या कर्तुमुत्सहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2003911, "chapter_id": 1075, "verse_number": "१-७६-२८x", "content_sanskrit": "शर्मिष्ठोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2003912, "chapter_id": 1075, "verse_number": "१-७६-२८", "content_sanskrit": "समावेतौ मतो राजन्पतिः सख्याश्च यः पतिः।\nसमं विवाहमित्याहुः सख्या मेऽसि वृतः पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2003913, "chapter_id": 1075, "verse_number": "१-७६-२९", "content_sanskrit": "सह दत्तास्मि काव्येन देवयान्या मनीषिणा।\nपूज्या पोषयितव्येति न मृषा कर्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2003914, "chapter_id": 1075, "verse_number": "१-७६-३०", "content_sanskrit": "सुवर्णमणिमुक्तानि वस्त्राण्याभरणानि च।\nयाचितॄणां ददासि त्वं गोभूम्यादीनि यानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2003915, "chapter_id": 1075, "verse_number": "१-७६-३१", "content_sanskrit": "बहिःस्थं दानमित्युक्तं न शरीराश्रितं नृप।\nदुष्करं पुत्रदानं च आत्मदानं च दुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2003916, "chapter_id": 1075, "verse_number": "१-७६-३२", "content_sanskrit": "शरीरदानात्तत्सर्वं दत्तं भवति मारिष।\nयस्य यस्य यथा कामस्तस्य तस्य ददाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2003917, "chapter_id": 1075, "verse_number": "१-७६-३३", "content_sanskrit": "इत्युक्त्वा नगरे राजंस्त्रिकालं घोषितं त्वया।\nत्वयोक्तमनृतं राजन्वृथा घोषितमेव वा।\nतत्सत्यं कुरु राजेन्द्र यथा वैश्रवणस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2003918, "chapter_id": 1075, "verse_number": "१-७६-३४x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2003919, "chapter_id": 1075, "verse_number": "१-७६-३४", "content_sanskrit": "दातव्यं याचमानेभ्य इति मे व्रतमाहितम्।\nत्वं च याचसि मां कामं ब्रूहि किं करवाणि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2003920, "chapter_id": 1075, "verse_number": "१-७६-३५", "content_sanskrit": "धनं वा यदि वा किंचिद्राज्यं वाऽपि शुचिस्मिते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2003921, "chapter_id": 1075, "verse_number": "१-७६-३५x", "content_sanskrit": "शर्मिष्ठोवाच।\nअधर्मात्पाहि मां राजन्धर्मं च प्रतिपादय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2003922, "chapter_id": 1075, "verse_number": "१-७६-३६", "content_sanskrit": "नान्यं वृणे पुत्रकामा पुत्रात्परतरं न च।\nत्वत्तोऽपत्यवती लोके चरेयं धर्ममुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2003923, "chapter_id": 1075, "verse_number": "१-७६-३७", "content_sanskrit": "त्रय एवाधना राजन्भार्या दासस्तथा सुतः।\nयत्ते समधिगच्छन्ति यस्यैते तस्य तद्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2003924, "chapter_id": 1075, "verse_number": "१-७६-३८", "content_sanskrit": "पुत्रार्थं भर्तृपोषार्थं स्त्रियः सृष्टाः स्वयंभुवा।\nअपतिर्वापि या कन्या अनपत्या च या भवेत्।\nतासां जन्म वृथा लोके गतिस्तासां न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2003925, "chapter_id": 1075, "verse_number": "१-७६-३९", "content_sanskrit": "देवयान्या भुजिष्याऽस्मि वश्या च तव भार्गवी।\nसा चाहं च त्वया राजन्भजनीये भजस्व माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2003926, "chapter_id": 1075, "verse_number": "१-७६-४०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2003927, "chapter_id": 1075, "verse_number": "१-७६-४०", "content_sanskrit": "एवमुक्तस्तु राजा स तथ्यमित्यभिजज्ञिवान्।\nपूजयामास शर्मिष्ठां धर्मं च प्रत्यपादयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2003928, "chapter_id": 1075, "verse_number": "१-७६-४१", "content_sanskrit": "स समागम्य शर्मिष्ठां यथा काममवाप्य च।\nअन्योन्यं चाभिसंपूज्य जग्मतुस्तौ यथागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2003929, "chapter_id": 1075, "verse_number": "१-७६-४२", "content_sanskrit": "तस्मिन्समागमे सुभ्रूः शर्मिष्ठा चारुहासिनी।\nलेभे गर्भं प्रथमतस्तस्मान्नृपतिसत्तमात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2003930, "chapter_id": 1075, "verse_number": "१-७६-४३", "content_sanskrit": "प्रयज्ञे च ततः काले राजन्राजीवलोचना।\nकुमारं देवगर्भाभं राजीवनिभलोचनम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2003931, "chapter_id": 1075, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि षट्सप्ततितमोऽध्यायः॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]