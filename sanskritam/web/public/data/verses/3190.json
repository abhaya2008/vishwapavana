[{"id": 2101560, "chapter_id": 3190, "verse_number": "१४-४६-१", "content_sanskrit": "ब्रह्मोवाच।\nएवमेतेन मार्गेण पूर्वोक्तेन यथाविधि।\nअधीतवान्यथाशक्ति तथैव ब्रह्मचर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2101561, "chapter_id": 3190, "verse_number": "१४-४६-२", "content_sanskrit": "स्वधर्मनिरतो विद्वान्सर्वेन्द्रिययतो मुनिः।\nगुरोः प्रियहिते युक्तः सत्यधर्मपरः शुचिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2101562, "chapter_id": 3190, "verse_number": "१४-४६-३", "content_sanskrit": "गुरुणा समनुज्ञातो भुञ्जीतान्नमकुत्सयन्।\nहविष्यभैक्ष्यभुक् चापि स्थानासनविहारवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2101563, "chapter_id": 3190, "verse_number": "१४-४६-४", "content_sanskrit": "द्विकालमग्निं जुह्वानः शुचिर्भूत्वा समाहितः।\nधारयीत सदा दण्डं बैल्वं पालाशमेव वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2101564, "chapter_id": 3190, "verse_number": "१४-४६-५", "content_sanskrit": "क्षौमं कार्पासिकं वाऽपि मृगाजिनमथापि वा।\nसर्वं काषायरक्तं वा वासो वाऽपि द्विजस्य ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2101565, "chapter_id": 3190, "verse_number": "१४-४६-६", "content_sanskrit": "मेखला च भवेन्मौञ्जी जटो नित्योदकस्तथा।\nयज्ञोपवीती स्वाध्यायी अलुप्तनियतव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2101566, "chapter_id": 3190, "verse_number": "१४-४६-७", "content_sanskrit": "पूताभिश्च तथैवाद्भिः सदा दैवततर्पणम्।\nभावेन नियतः कुर्वन्ब्रह्मचारी प्रशस्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2101567, "chapter_id": 3190, "verse_number": "१४-४६-८", "content_sanskrit": "एवं युक्तो जयेत्स्वर्गमूर्ध्वरेताः समाहितः।\nन संसरति जातीषु परमं स्थानमाश्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2101568, "chapter_id": 3190, "verse_number": "१४-४६-९", "content_sanskrit": "संस्कृतः सर्वसंस्कारैस्तथैव ब्रह्मचर्यवान्।\nग्रामान्निष्क्रम्य चारण्ये मुनिः प्रव्रजितो वसेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2101569, "chapter_id": 3190, "verse_number": "१४-४६-१०", "content_sanskrit": "चर्मवल्कलसंवासी सायं प्रातरुपस्पृशेत्।\nअरण्यगोचरो नित्यं न ग्रामं प्रविशेत्पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2101570, "chapter_id": 3190, "verse_number": "१४-४६-११", "content_sanskrit": "अर्चयन्नतिथीन्काले दद्याच्चापि प्रतिश्रयम्।\nफलपत्रावरैर्मूलैः श्यामाकेन च वर्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2101571, "chapter_id": 3190, "verse_number": "१४-४६-१२", "content_sanskrit": "स नित्यमुदकं वायुं सर्वं वानेयमाश्रयेत्।\nप्राश्नीयादानुपूर्व्येण यथादीक्षमतन्द्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2101572, "chapter_id": 3190, "verse_number": "१४-४६-१३", "content_sanskrit": "समूलफलशाकाद्यैरर्चेदतिथिमागतम्।\nयद्भक्षः स्यात्ततो दद्याद्भिक्षां नित्यमतन्द्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2101573, "chapter_id": 3190, "verse_number": "१४-४६-१४", "content_sanskrit": "देवतातिथिपूर्वं च सदा प्राश्नीत वाग्यतः।\nअस्कन्दितमनाश्चैव लघ्वाशी देवताश्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2101574, "chapter_id": 3190, "verse_number": "१४-४६-१५", "content_sanskrit": "दान्तो मैत्रः क्षमायुक्तः कशाञ्शमश्रु च धारयन्।\nजुह्वन्स्वाध्यायशीलश्च सत्यधर्मपरायणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2101575, "chapter_id": 3190, "verse_number": "१४-४६-१६", "content_sanskrit": "न्यस्तदेहः सदा दक्षो वननित्यः समाहितः।\nएवं युक्तो जयेत्स्वर्गं वानप्रस्थो जितेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2101576, "chapter_id": 3190, "verse_number": "१४-४६-१७", "content_sanskrit": "गृहस्थो ब्रह्मचारी च वानप्रस्थोऽथवा पुनः।\nय इच्छेन्मोक्षमास्थातुमुत्तमां वृत्तिमाश्रयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2101577, "chapter_id": 3190, "verse_number": "१४-४६-१८", "content_sanskrit": "अभयं सर्वभूतेभ्यो दत्त्वा नैष्कर्म्यमाचरेत्।\nसर्वभूतहितो मैत्रः सर्वेन्द्रिययतो मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2101578, "chapter_id": 3190, "verse_number": "१४-४६-१९", "content_sanskrit": "अयाचितमसंक्लृप्तमुपपन्नं यदृच्छया।\nकृत्वा प्राह्णे चरेद्भैक्ष्यं विधूमे भुक्तवज्जने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2101579, "chapter_id": 3190, "verse_number": "१४-४६-२०", "content_sanskrit": "वृत्ते शरावसम्पाते भैक्ष्यं लिप्सेत मोक्षवित्।\nलाभेन च न हृष्येत नालाभे विमना भवेत्।\nन चातिभिक्षां भिक्षेत केवलं प्राणयात्रिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2101580, "chapter_id": 3190, "verse_number": "१४-४६-२१", "content_sanskrit": "यात्रार्थी कालमाकाङ्क्षंश्चरेद्भैक्ष्यं समाहितः।\nलाभं साधारणं नेच्छेन्न भुञ्जीताभिपूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2101581, "chapter_id": 3190, "verse_number": "१४-४६-२२", "content_sanskrit": "अभिपूजितलाभाद्वि विजुगुप्सेत भिक्षुकः।\nभुक्तान्यन्नानि तिक्तानि कषायकटुकानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2101582, "chapter_id": 3190, "verse_number": "१४-४६-२३", "content_sanskrit": "नास्वादयीत भुञ्जानो रसांश्च मधुरांस्तथा।\nयात्रामात्रं च भुञ्जीत केवलं प्राणधारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2101583, "chapter_id": 3190, "verse_number": "१४-४६-२४", "content_sanskrit": "असंरोधेन भूतानां वृत्तिं लिप्सेत मोक्षवित्।\nन चान्यमन्नं लिप्सेत भिक्षमाणः कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2101584, "chapter_id": 3190, "verse_number": "१४-४६-२५", "content_sanskrit": "न सन्निकाशयेद्धर्मं विविक्ते चारजाश्चरेत्।\nशून्यागारमण्यं वा वृक्षमूलं नदीं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2101585, "chapter_id": 3190, "verse_number": "१४-४६-२६", "content_sanskrit": "प्रतिश्रयार्थं सेवेत पार्वतीं वा पुनर्गुहाम्।\nग्रामैकरात्रिको ग्रीष्मे वर्षास्वेकत्र वा वसेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2101586, "chapter_id": 3190, "verse_number": "१४-४६-२७", "content_sanskrit": "अध्वा सूर्येणि निर्दिष्टः कीटवच्च चरेन्महीम्।\nदयार्तं चैव भूतानां समीक्ष्य पृथिवीं चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2101587, "chapter_id": 3190, "verse_number": "१४-४६-२८", "content_sanskrit": "सञ्चयांश्च न कुर्वीत स्नेहवासं च वर्जयेत्।\nपूताभिरद्भिर्नित्यं वै कार्यं कुर्वीत मोक्षवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2101588, "chapter_id": 3190, "verse_number": "१४-४६-२९", "content_sanskrit": "उपस्पृशेदुद्दृताभिरद्भिश्च पुरुषः सदा।\nअहिंसा ब्रह्मचर्यं च सत्यमार्जवमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2101589, "chapter_id": 3190, "verse_number": "१४-४६-३०", "content_sanskrit": "अक्रोधश्चानसूया च दमो नित्यमपैशुनम्।\nअष्टस्वेतेषु युक्तः स्याद्व्रतेषु नियतेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2101590, "chapter_id": 3190, "verse_number": "१४-४६-३१", "content_sanskrit": "अपापमशठं वृत्तमजिह्मं नित्यमाचरेत्।\nजोषयेत सदा भोज्यं ग्रासमागतमस्पृहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2101591, "chapter_id": 3190, "verse_number": "१४-४६-३२", "content_sanskrit": "यात्रामात्रं च भुञ्जीत केवलं प्राणयात्रिकम्।\nधर्मलब्धमथाश्नीयान्न काममनुवर्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2101592, "chapter_id": 3190, "verse_number": "१४-४६-३३", "content_sanskrit": "ग्रासादाच्छादनादन्यन्न गृह्णीयात्कथञ्चन।\nयावदाहारयेत्तावत्प्रतिगृह्णीत नाधिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2101593, "chapter_id": 3190, "verse_number": "१४-४६-३४", "content_sanskrit": "परेभ्यो न प्रतिग्राह्यं न च देयं कदाचन।\nदैन्यभावाच्च भूतानां संविभज्य सदा बुधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2101594, "chapter_id": 3190, "verse_number": "१४-४६-३५", "content_sanskrit": "नाददीत परस्वानि न गृह्णीयान्न याचयेत्।\nन किञ्चिद्विषयं भुक्त्वा स्पृहयेत्तस्य वै पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2101595, "chapter_id": 3190, "verse_number": "१४-४६-३६", "content_sanskrit": "मृदमापस्तथाऽन्नानि पत्रपुष्पफलानि च।\nअसंवृतानि गृह्णीयात्प्रवृत्तानि च कार्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2101596, "chapter_id": 3190, "verse_number": "१४-४६-३७", "content_sanskrit": "न शिल्पजीविकां जीवेद्द्विरन्नं नोत कामयेत्।\nन द्वेष्टा नोपदेष्टा च भवेच्च निरुपस्कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2101597, "chapter_id": 3190, "verse_number": "१४-४६-३८", "content_sanskrit": "श्रद्धापूतानि भुञ्जीत निमित्तानि च वर्जयेत्।\nमुधावृत्तिरसक्तश्च सर्वभूतैरसंधितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2101598, "chapter_id": 3190, "verse_number": "१४-४६-३९", "content_sanskrit": "आशीर्युक्तानि सर्वाणि हिंसायुक्तानि यानि च।\nलोकसङ्ग्रहधर्मं च नैव कुर्यान्न कारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2101599, "chapter_id": 3190, "verse_number": "१४-४६-४०", "content_sanskrit": "सर्वभावानतिक्रम्य लघुमात्रः परिव्रजेत्।\nसमः सर्वेषु भूतेषु स्थावरेषु चरेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2101600, "chapter_id": 3190, "verse_number": "१४-४६-४१", "content_sanskrit": "परं नोद्वेजयेत्कञ्चिन्न च कस्यचिदुद्विजेत्।\nविश्वास्यः सर्वभूतानामग्र्यो मोक्षविदुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2101601, "chapter_id": 3190, "verse_number": "१४-४६-४२", "content_sanskrit": "अनागतं च न ध्यायेन्नातीतमनुचिन्तयेत्।\nवर्तमानमुपेक्षेत कालाकाङ्क्षी समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2101602, "chapter_id": 3190, "verse_number": "१४-४६-४३", "content_sanskrit": "न चक्षुषा न मनसा न वाचा दूषयेत्क्वचित्।\nन प्रत्यक्षं परोक्षं वा किञ्चिद्दुष्टं समाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2101603, "chapter_id": 3190, "verse_number": "१४-४६-४४", "content_sanskrit": "इन्द्रियाण्युपसंहृत्य कूर्मोऽङ्गानीव सर्वशः।\nक्षीणेन्द्रियमनोबुद्धिर्निरीहः सर्वतत्त्ववित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2101604, "chapter_id": 3190, "verse_number": "१४-४६-४५", "content_sanskrit": "निर्द्वन्द्वो निर्नमस्कारो निःस्वाहाकार एव च।\nनिर्ममो निरहङ्कारो निर्योगक्षेम आत्मवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2101605, "chapter_id": 3190, "verse_number": "१४-४६-४६", "content_sanskrit": "निराशीर्निर्गुणः शान्तो निरासक्तो निराश्रयः।\nआत्मसङ्गी च तत्त्वज्ञो मुच्यते नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2101606, "chapter_id": 3190, "verse_number": "१४-४६-४७", "content_sanskrit": "अपादपाणिपृष्ठं तदशिरस्कमनूदरम्।\nअभिन्नगुणकर्माणं केवलं विमलं स्थिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2101607, "chapter_id": 3190, "verse_number": "१४-४६-४८", "content_sanskrit": "अगन्धमरसस्पर्शमरूपाशब्दमेव च।\nअनुगम्यमनासक्तममांसमपि चैव यत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2101608, "chapter_id": 3190, "verse_number": "१४-४६-४९", "content_sanskrit": "निशअचिन्तमव्ययं दिव्यं गृहस्थमपि सर्वदा।\nसर्वभूतस्थमात्मानं ये पश्यन्ति न ते मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2101609, "chapter_id": 3190, "verse_number": "१४-४६-५०", "content_sanskrit": "न तत्र क्रमते बुद्धिर्नेन्द्रियाणि न देवताः।\nवेदा यज्ञाश्च लोकाश्च न तपो न व्रतानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2101610, "chapter_id": 3190, "verse_number": "१४-४६-५१", "content_sanskrit": "यत्र ज्ञानवतां प्राप्तिलिङ्गग्रहणा स्मृता।\nतस्मादलिङ्गधर्मज्ञो धर्मतत्त्वमुपाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2101611, "chapter_id": 3190, "verse_number": "१४-४६-५२", "content_sanskrit": "गूढधर्माश्रितो विद्वान्विज्ञानचरितं चरेत्।\nअमूढो मूढरूपेण चरेद्धर्ममदूषयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2101612, "chapter_id": 3190, "verse_number": "१४-४६-५३", "content_sanskrit": "यथैनमवमन्येरन्परे सततमेव हि।\nतथावृत्तश्चरेच्छान्तः सतां धर्मानकुत्सयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2101613, "chapter_id": 3190, "verse_number": "१४-४६-५४", "content_sanskrit": "य एवं वृत्तसम्पन्नः स मुनिः श्रेष्ठ उच्यते।\nइन्द्रियाणीन्द्रियार्थांश्च महाभूतानि पञ्च च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2101614, "chapter_id": 3190, "verse_number": "१४-४६-५५", "content_sanskrit": "मनो बुद्धिरहङ्कारमव्यक्तं पुरुषं तथा।\nएतत्सर्वं प्रसङ्ख्याय यथावत्तत्त्वनिश्चयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2101615, "chapter_id": 3190, "verse_number": "१४-४६-५६", "content_sanskrit": "ततः स्वर्गमवाप्नोति विमुक्तः सर्वबन्धनैः।\nएतावदन्तवेलायां परिसङ्ख्याय तत्त्ववित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2101616, "chapter_id": 3190, "verse_number": "१४-४६-५७", "content_sanskrit": "ध्यायेदेकान्तमास्थाय मुच्यतेऽथ निराश्रयः।\nनिर्मुक्तः सर्वसङ्गेभ्यो वायुराकाशगो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2101617, "chapter_id": 3190, "verse_number": "१४-४६-५८", "content_sanskrit": "क्षीणकोशो निरातङ्कस्तथेदं प्राप्नुयात्परम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2101618, "chapter_id": 3190, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि षट्चत्वारिंशोऽध्यायः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]