[{"id": 6000086000, "chapter_id": 10086, "verse_number": null, "content_sanskrit": "अथ द्वाविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000086001, "chapter_id": 10086, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.001.m4a", "display_order": 2}, {"id": 6000086002, "chapter_id": 10086, "verse_number": "४-२२-१", "content_sanskrit": "जनेषु प्रगृणत्स्वेवं पृथुं पृथुलविक्रमम्।\nतत्रोपजग्मुर्मुनयश्चत्वारः सूर्यवर्चसः॥ ४/२२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.002.m4a", "display_order": 3, "topics": [{"text": "पृथुगृहं प्रति सनत्कुमारगमनम्, पृथुना ऋषिपूजनम्", "range": "१–१६"}]}, {"id": 6000086003, "chapter_id": 10086, "verse_number": "४-२२-३", "content_sanskrit": "तांस्तु सिद्धेश्वरान् राजा व्योम्नोऽवतरतोऽर्चिषा। लोकानपापान् कुर्वन्त्या सानुगोऽचष्ट लक्षितान् २\nतद्दर्शनोद्गतप्राणान् प्रत्यादित्सुरिवोत्थितः। ससदस्यानुगो वैन्य इन्द्रियेशो गुणानिव॥ ४/२२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.003.m4a", "display_order": 4}, {"id": 6000086004, "chapter_id": 10086, "verse_number": "४-२२-४", "content_sanskrit": "गौरवाद्यन्त्रितः सभ्यः प्रश्रयानतकन्धरः।\nविधिवत् पूजयाञ्चक्रे गृहीतार्घ्यार्हणासनान्॥ ४/२२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.004.m4a", "display_order": 5}, {"id": 6000086005, "chapter_id": 10086, "verse_number": "४-२२-५", "content_sanskrit": "तत्पादशौचसलिलैर्मार्जितालकबन्धनः।\nतत्र शीलवतां वृत्तिमाचरन् मानयन्निव॥ ४/२२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.005.m4a", "display_order": 6}, {"id": 6000086006, "chapter_id": 10086, "verse_number": "४-२२-६", "content_sanskrit": "हाटकासन आसीनान् स्वधिष्ण्येष्विव पावकान्।\nश्रद्धासंयमसम्पन्नः प्रीतः प्राह भवाग्रजान्॥ ४/२२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.006.m4a", "display_order": 7}, {"id": 6000086007, "chapter_id": 10086, "verse_number": null, "content_sanskrit": "पृथुरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.007.m4a", "display_order": 8}, {"id": 6000086008, "chapter_id": 10086, "verse_number": "४-२२-७", "content_sanskrit": "अहो आचरितं कृष्णे मङ्गलं मङ्गलायनाः।\nयस्य वो दर्शनं ह्यासीद् दुर्दर्शानां कुयोगिनः॥ ४/२२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.008.m4a", "display_order": 9}, {"id": 6000086009, "chapter_id": 10086, "verse_number": "४-२२-८", "content_sanskrit": "किं तस्य दुर्लभतरमिह लोके परत्र च।\nयस्य विप्राः प्रसीदन्ति शिवो विष्णुश्च सानुगः॥ ४/२२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.009.m4a", "display_order": 10}, {"id": 6000086010, "chapter_id": 10086, "verse_number": "४-२२-९", "content_sanskrit": "नैव लक्षयते लोको लोकान् पर्यटतोऽपि यान्।\nयथा सर्वदृशं सर्व आत्मानं येऽस्य हेतवः॥ ४/२२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.010.m4a", "display_order": 11}, {"id": 6000086011, "chapter_id": 10086, "verse_number": "४-२२-१०", "content_sanskrit": "अधना अपि ते धन्याः साधवो गृहमेधिनः।\nयद्गृहा अर्हवर्याम्बुतृणभूमिसुवाग्धराः॥ ४/२२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.011.m4a", "display_order": 12}, {"id": 6000086012, "chapter_id": 10086, "verse_number": "४-२२-११", "content_sanskrit": "व्यालालयद्रुमा ह्येते संसिद्धाखिलसंपदः।\nयद्गृहास्तीर्थपादीयपादतीर्थविवर्जिताः॥ ४/२२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.012.m4a", "display_order": 13}, {"id": 6000086013, "chapter_id": 10086, "verse_number": "४-२२-१२", "content_sanskrit": "स्वागतं वो द्विजश्रेष्ठा यद् व्रतानि मुमुक्षवः।\nचरन्ति श्रद्धया धीरा बाला एव बृहन्ति वै॥ ४/२२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.013.m4a", "display_order": 14}, {"id": 6000086014, "chapter_id": 10086, "verse_number": "४-२२-१३", "content_sanskrit": "कच्चिन्नः कुशलं नाथा इन्द्रियार्थार्थवेदिनाम्।\nव्यसनावाप एतस्मिन् पतितानां स्वकर्मभिः॥ ४/२२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.014.m4a", "display_order": 15}, {"id": 6000086015, "chapter_id": 10086, "verse_number": "४-२२-१४", "content_sanskrit": "भवत्सु कुशलप्रश्न आत्मारामेषु नेष्यते।\nकुशलाकुशला यत्र न सन्ति मतिवृत्तयः॥ ४/२२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.015.m4a", "display_order": 16}, {"id": 6000086016, "chapter_id": 10086, "verse_number": "४-२२-१५", "content_sanskrit": "तदहं कृतविश्रम्भः सुहृदोऽत्र तपस्विनाम्।\nसंपृच्छे भव एतस्मिन् क्षेमः केनाञ्जसा भवेत्॥ ४/२२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.016.m4a", "display_order": 17}, {"id": 6000086017, "chapter_id": 10086, "verse_number": "४-२२-१६", "content_sanskrit": "व्यक्तं ह्यात्मवतामात्मा भगवानात्मभावनः।\nस्वानामनुग्रहायेमां सिद्धरूपी चरत्यजः॥ ४/२२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.017.m4a", "display_order": 18}, {"id": 6000086018, "chapter_id": 10086, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.018.m4a", "display_order": 19}, {"id": 6000086019, "chapter_id": 10086, "verse_number": "४-२२-१७", "content_sanskrit": "पृथोस्तत्सूक्तमाकर्ण्य सारं सुष्ठु मितं मधु।\nस्मयमान इव प्रीत्या कुमारः प्रत्युवाच ह॥ ४/२२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.019.m4a", "display_order": 20, "topics": [{"text": "सनत्कुमारेण पृथुराजाय ज्ञानोपदेशः", "range": "१७–४३"}]}, {"id": 6000086020, "chapter_id": 10086, "verse_number": null, "content_sanskrit": "सनत्कुमार उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.020.m4a", "display_order": 21}, {"id": 6000086021, "chapter_id": 10086, "verse_number": "४-२२-१८", "content_sanskrit": "साधु पुष्टं महाराज सर्वभूतहितात्मना।\nभवता विदुषा चापि साधूनां गतिरीदृशी॥ ४/२२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.021.m4a", "display_order": 22}, {"id": 6000086022, "chapter_id": 10086, "verse_number": "४-२२-१९", "content_sanskrit": "सङ्गमः खलु साधूनामुभयेषां सुसंमतः।\nयत्सम्भाषणसंप्रश्नः सर्वेषां वितनोति शम्॥ ४/२२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.022.m4a", "display_order": 23}, {"id": 6000086023, "chapter_id": 10086, "verse_number": "४-२२-२०", "content_sanskrit": "अस्त्येव राजन् भवतो मधुद्विषः पादारविन्देऽस्य गुणानुवादने।\nरतिः सदा या विधुनोति नैष्ठिकी कामं कषायं मलमन्तरात्मनः॥ ४/२२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.023.m4a", "display_order": 24}, {"id": 6000086024, "chapter_id": 10086, "verse_number": "४-२२-२१", "content_sanskrit": "शास्‍त्रेष्वियानेव सुनिश्चितो नृणां क्षेमस्य सम्यग्विमृशेषु हेतुः।\nअसङ्ग आत्मव्यतिरिक्तवस्तुनि दृढा रतिर्ब्रह्मणि निर्गुणे च या॥ ४/२२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.024.m4a", "display_order": 25}, {"id": 6000086025, "chapter_id": 10086, "verse_number": "४-२२-२२", "content_sanskrit": "तच्छ्रद्धया भगवद्धर्मचर्यया जिज्ञासयाऽऽध्यात्मिकयोगनिष्ठया।\nयोगेश्वरोपासनया च नित्यं पुण्यश्रवःकथया पुण्यया च॥ ४/२२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.025.m4a", "display_order": 26}, {"id": 6000086026, "chapter_id": 10086, "verse_number": "४-२२-२३", "content_sanskrit": "अर्थेन्द्रियारामगुणेष्वतृष्णया तत्सम्मतानामपरिग्रहेण च।\nविविक्तरुच्या परितोष आत्मन् विना हरेर्गुणपीयूषपानात्॥ ४/२२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.026.m4a", "display_order": 27}, {"id": 6000086027, "chapter_id": 10086, "verse_number": "४-२२-२४", "content_sanskrit": "अहिंसया पारमहंस्यचर्यया स्मृत्या मुकुन्दाचरिताग्र्यसीधुना।\nयमैरकामैर्नियमैरभिध्यया निरीहया द्वन्द्वतितिक्षया च॥ ४/२२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.027.m4a", "display_order": 28}, {"id": 6000086028, "chapter_id": 10086, "verse_number": "४-२२-२५", "content_sanskrit": "हरेर्मुहुस्तत्परकर्णपूरया गुणाभिधानेन विजृम्भमाणया।\nभक्त्या ह्यसङ्गः सदसत्परात्मनि स्यान्निर्गुणे ब्रह्मणि चाञ्जसा रतिः॥ ४/२२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.028.m4a", "display_order": 29}, {"id": 6000086029, "chapter_id": 10086, "verse_number": "४-२२-२६", "content_sanskrit": "यदा रतिर्ब्रह्मणि नैष्ठिकी पुमानाचार्यवान् ज्ञानविरागरंहसा।\nदहत्यबीजं हृदयं जीवकोशं पञ्चात्मकं योनिमिवोत्थितोऽग्निः॥ ४/२२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.029.m4a", "display_order": 30}, {"id": 6000086030, "chapter_id": 10086, "verse_number": "४-२२-२७", "content_sanskrit": "दग्धाशयो मुक्तसमस्ततद्गुणो नैवात्मनो बहिरन्तर्विचष्टे।\nपरात्मनोर्यद् व्यवधानं पुरस्तात् स्वप्ने यथाऽपुरुषस्तद्विनाशे॥ ४/२२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.030.m4a", "display_order": 31}, {"id": 6000086031, "chapter_id": 10086, "verse_number": "४-२२-२८", "content_sanskrit": "आत्मानमिन्द्रियार्थं च परं यदुभयोरपि।\nसत्याशय उपाधौ वै पुमान् पश्यति नान्यदा॥ ४/२२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.031.m4a", "display_order": 32}, {"id": 6000086032, "chapter_id": 10086, "verse_number": "४-२२-२९", "content_sanskrit": "निमित्ते सति सर्वत्र जलादावपि पूरुषः।\nआत्मनश्च परस्यापि भिदां पश्यति नान्यदा॥ ४/२२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.032.m4a", "display_order": 33}, {"id": 6000086033, "chapter_id": 10086, "verse_number": "४-२२-३०", "content_sanskrit": "इन्द्रियैर्विषयाकृष्टैराक्षिप्तं ध्यायतो मनः।\nचेतनां हरते बुद्धेः स्तुम्बस्तोयमिव ह्रदात्॥ ४/२२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.033.m4a", "display_order": 34}, {"id": 6000086034, "chapter_id": 10086, "verse_number": "४-२२-३१", "content_sanskrit": "भ्रश्यत्यनु स्मृतिश्चित्तं ज्ञानभ्रंशः स्मृतिक्षये।\nतद्रोधं कवयः प्राहुरात्मापह्नवमात्मनः॥ ४/२२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.034.m4a", "display_order": 35}, {"id": 6000086035, "chapter_id": 10086, "verse_number": "४-२२-३२", "content_sanskrit": "नातः परतरो लोके पुंसः स्वार्थव्यतिक्रमः।\nयद्यस्त्यन्यस्य प्रेयस्त्वमात्मनः स्वव्यतिक्रमात्॥ ४/२२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.035.m4a", "display_order": 36}, {"id": 6000086036, "chapter_id": 10086, "verse_number": "४-२२-३३", "content_sanskrit": "अथेन्द्रियार्थाभिध्यानं सर्वार्थापह्नवो नृणाम्।\nस्रंसितो ज्ञानविज्ञानाद् येनाविशति मुग्धताम्॥ ४/२२/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.036.m4a", "display_order": 37}, {"id": 6000086037, "chapter_id": 10086, "verse_number": "४-२२-३४", "content_sanskrit": "न कुर्यात् कर्हिचित् सङ्गं तमस्तीव्रं तितीर्षुणा।\nधर्मार्थकाममोक्षाणां यदत्यन्तविघातकम्॥ ४/२२/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.037.m4a", "display_order": 38}, {"id": 6000086038, "chapter_id": 10086, "verse_number": "४-२२-३५", "content_sanskrit": "तत्रापि मोक्ष एवार्थ आत्यन्तिकतयेष्यते।\nत्रैवर्ग्यार्थो यतो नित्यं कृतान्तभयसंयुतः॥ ४/२२/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.038.m4a", "display_order": 39}, {"id": 6000086039, "chapter_id": 10086, "verse_number": "४-२२-३६", "content_sanskrit": "परावरे च ये भावा गुणव्यतिकरादनु।\nन तेषां विद्यते क्षेम ईशविध्वंसिताशिषाम्॥ ४/२२/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.039.m4a", "display_order": 40}, {"id": 6000086040, "chapter_id": 10086, "verse_number": "४-२२-३७", "content_sanskrit": "मनोमात्रमिदं विश्वं यथा स्वप्ने मनःक्रिया।\nक्रिया च वासनामात्रं साऽनीहायां प्रलीयते॥ ४/२२/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.040.m4a", "display_order": 41}, {"id": 6000086041, "chapter_id": 10086, "verse_number": "४-२२-३८", "content_sanskrit": "आत्मा त्वनीहया साक्षात्स्वयंज्योतिः प्रसिध्यति।\nएवं व्युदस्यात्ममायां भिदामुपरमेन्मुनिः॥ ४/२२/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.041.m4a", "display_order": 42}, {"id": 6000086042, "chapter_id": 10086, "verse_number": "४-२२-३९", "content_sanskrit": "न यत्र निद्रा मूर्च्छा वा नार्थदृक् च मनोरथः।\nनानुवृत्तिर्न प्रलयस्तद् ब्रह्म विजितात्मनः॥ ४/२२/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.042.m4a", "display_order": 43}, {"id": 6000086043, "chapter_id": 10086, "verse_number": "४-२२-४०", "content_sanskrit": "तत्त्वं नरेन्द्र जगतामथ तस्थुषां च देहेन्द्रियासुधिषणात्मभिरावृतानाम्।\nयः क्षेत्रवित् त्वमनयोर्हृदि विष्वगाधिः प्रत्यक् चकास्ति भगवांस्तमवैहि सोऽस्ति॥ ४/२२/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.043.m4a", "display_order": 44}, {"id": 6000086044, "chapter_id": 10086, "verse_number": "४-२२-४१", "content_sanskrit": "यस्मिन्निदं सदसदात्मतया विभाति मायाविवेकविधुतिः स्रजि वाऽहिबुद्धिः।\nतं नित्यमुक्तपरिशुद्धविबुद्धतत्त्वं प्रत्यूढकर्मकलिलप्रकृतिं प्रपद्ये॥ ४/२२/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.044.m4a", "display_order": 45}, {"id": 6000086045, "chapter_id": 10086, "verse_number": "४-२२-४२", "content_sanskrit": "यत्पादपङ्कजपलाशविलासभक्त्या कर्माशयग्रथितमुद्ग्रथयन्ति सन्तः।\nतत्त्वं न तद् द्विमतयोऽपि विरुद्धमार्गस्रोतोगुणास्तमरणं व्रज वासुदेवम्॥ ४/२२/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.045.m4a", "display_order": 46}, {"id": 6000086046, "chapter_id": 10086, "verse_number": "४-२२-४३", "content_sanskrit": "कृच्छ्रो महानिह भवार्णवमप्लवेशाः षड्वर्गनक्रमसुखेन तितीर्षन्ति।\nतत् त्वं हरेर्भगवतो भजनीयमङ्घ्रिं कृत्वोडुपं व्यसनमुत्तर दुस्तरार्णम्॥ ४/२२/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.046.m4a", "display_order": 47}, {"id": 6000086047, "chapter_id": 10086, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.047.m4a", "display_order": 48}, {"id": 6000086048, "chapter_id": 10086, "verse_number": "४-२२-४४", "content_sanskrit": "स एवं ब्रह्मपुत्रेण कुमारेणात्ममेधसा।\nदर्शितात्मगतिः सम्यक् प्रशस्योवाच तं नृपः॥ ४/२२/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.048.m4a", "display_order": 49, "topics": [{"text": "सनत्कुमारवर्णनम्", "range": "४४–५१"}]}, {"id": 6000086049, "chapter_id": 10086, "verse_number": null, "content_sanskrit": "पृथुरुवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.049.m4a", "display_order": 50}, {"id": 6000086050, "chapter_id": 10086, "verse_number": "४-२२-४५", "content_sanskrit": "कृतो मेऽनुग्रहः पूर्वं हरिणाऽऽर्तानुकम्पिना।\nतमापादयितुं ब्रह्मन् भगवन् यूयमागताः॥ ४/२२/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.050.m4a", "display_order": 51}, {"id": 6000086051, "chapter_id": 10086, "verse_number": "४-२२-४६", "content_sanskrit": "निष्पादितं च कार्त्स्न्येन भगवद्भिर्घृणालुभिः।\nसाधुदत्तं हि सर्वं मे आत्मना सह किं ददे॥ ४/२२/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.051.m4a", "display_order": 52}, {"id": 6000086052, "chapter_id": 10086, "verse_number": "४-२२-४७", "content_sanskrit": "प्राणा दाराः सुता ब्रह्मन् गृहाश्च सपरिग्रहाः।\nरायो मही बलं कोश इति सर्वं निवेदितम्॥ ४/२२/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.052.m4a", "display_order": 53}, {"id": 6000086053, "chapter_id": 10086, "verse_number": "४-२२-४८", "content_sanskrit": "सेनापत्यं च राज्यं च दण्डनेतृत्वमेव च।\nसर्वलोकाधिपत्यं च वेदशास्‍त्रविदर्हति॥ ४/२२/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.053.m4a", "display_order": 54}, {"id": 6000086054, "chapter_id": 10086, "verse_number": "४-२२-४९", "content_sanskrit": "स्वमेव ब्राह्मणो भुङ्क्ते स्वं वस्ते स्वं ददाति च।\nतस्यैवानुग्रहेणान्नं भुञ्‍जते क्षत्रियादयः॥ ४/२२/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.054.m4a", "display_order": 55}, {"id": 6000086055, "chapter_id": 10086, "verse_number": "४-२२-५०", "content_sanskrit": "यैरीदृशी भगवतो गतिरात्मवाद एकान्ततो निगमिभिः प्रतिपादिता नः।\nतुष्यन्त्वदभ्रकरुणाः स्वकृतेन नित्यं को नाम तत् प्रतिकरोति विनोदपात्रम्॥ ४/२२/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.055.m4a", "display_order": 56}, {"id": 6000086056, "chapter_id": 10086, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.056.m4a", "display_order": 57}, {"id": 6000086057, "chapter_id": 10086, "verse_number": "४-२२-५१", "content_sanskrit": "त आत्मयोगपतय आदिराजेन पूजिताः।\nशीलं तदीयं शंसन्तः खेऽभूवन् मिषतां नृणाम्॥ ४/२२/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.057.m4a", "display_order": 58}, {"id": 6000086058, "chapter_id": 10086, "verse_number": "४-२२-५२", "content_sanskrit": "वैन्यस्तु धुर्यो महतां संस्थित्याध्यात्मशिक्षया।\nआप्तकाममिवात्मानं मेन आत्मन्यवस्थितः॥ ४/२२/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.058.m4a", "display_order": 59, "topics": [{"text": "पृथोराध्यात्मजीवनम्", "range": "५२–६६"}]}, {"id": 6000086059, "chapter_id": 10086, "verse_number": "४-२२-५३", "content_sanskrit": "कर्माणि च यथाकालं यथादेशं यथाबलम्।\nयथोचितं यथावित्तमकरोद् ब्रह्मसात्कृतम्॥ ४/२२/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.059.m4a", "display_order": 60}, {"id": 6000086060, "chapter_id": 10086, "verse_number": "४-२२-५४", "content_sanskrit": "फलं ब्रह्मणि विन्यस्य निर्विषङ्गः समाहितः।\nकर्माध्यक्षं च मन्वान आत्मानं प्रकृतेः परम्॥ ४/२२/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.060.m4a", "display_order": 61}, {"id": 6000086061, "chapter_id": 10086, "verse_number": "४-२२-५५", "content_sanskrit": "गृहेषु वर्तमानोऽपि स साम्राज्यश्रियाऽन्वितः।\nनासज्जतेन्द्रियार्थेषु निरहंमतिरर्कवत्॥ ४/२२/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.061.m4a", "display_order": 62}, {"id": 6000086062, "chapter_id": 10086, "verse_number": "४-२२-५६", "content_sanskrit": "एवमध्यात्मयोगेन कर्माण्यनुसमाचरन्।\nपुत्रानुत्पादयामास पञ्चार्चिष्यात्मसम्मतान्॥ ४/२२/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.062.m4a", "display_order": 63}, {"id": 6000086063, "chapter_id": 10086, "verse_number": "४-२२-५७", "content_sanskrit": "विजिताश्वं धूमकेशं हर्यक्षं द्रविणं वृकम्।\nसर्वेषां लोकपालानां दधारैकः पृथग् गुणान्॥ ४/२२/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.063.m4a", "display_order": 64}, {"id": 6000086064, "chapter_id": 10086, "verse_number": "४-२२-५८", "content_sanskrit": "गोपीथाय जगत्सृष्टेः काले स्वे स्वेऽच्युतात्मकः।\nमनोवाङ्मूर्तिभिः सौम्यैर्गुणैः संरञ्जयन् प्रजाः॥ ४/२२/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.064.m4a", "display_order": 65}, {"id": 6000086065, "chapter_id": 10086, "verse_number": "४-२२-५९", "content_sanskrit": "राजेत्यधान्नामधेयं सोमराज इवापरः।\nसूर्यवद् विसृजन् गृह्णन् प्रतपंश्च भुवो वसु॥ ४/२२/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.065.m4a", "display_order": 66}, {"id": 6000086066, "chapter_id": 10086, "verse_number": "४-२२-६०", "content_sanskrit": "दुर्धर्षस्तेजसेवाग्निर्महेन्द्र इव दुर्जयः।\nतितिक्षया धरित्रीव द्यौरिवाभीष्टदो नृणाम्॥ ४/२२/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.066.m4a", "display_order": 67}, {"id": 6000086067, "chapter_id": 10086, "verse_number": "४-२२-६१", "content_sanskrit": "वर्षति स्म यथाकामैः पर्जन्य इव तर्पयन्।\nसमुद्र इव दुर्बोधः सत्येनाचलराडिव॥ ४/२२/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.067.m4a", "display_order": 68}, {"id": 6000086068, "chapter_id": 10086, "verse_number": "४-२२-६२", "content_sanskrit": "धर्मराडिव शिक्षायामाश्चर्ये हिमवानिव।\nकुबेर इव कोशाढ्यो गुप्तार्थो वरुणो यथा॥ ४/२२/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.068.m4a", "display_order": 69}, {"id": 6000086069, "chapter_id": 10086, "verse_number": "४-२२-६३", "content_sanskrit": "मातरिश्वेव सर्वात्मा बलेन महतौजसा।\nअविषह्यतया देवो भगवान् भूतराडिव॥ ४/२२/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.069.m4a", "display_order": 70}, {"id": 6000086070, "chapter_id": 10086, "verse_number": "४-२२-६४", "content_sanskrit": "कन्दर्प इव सौन्दर्ये मनस्वी मृगराडिव।\nवात्सल्ये मनुवन्नॄणां प्रभुत्वे भगवानजः॥ ४/२२/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.070.m4a", "display_order": 71}, {"id": 6000086071, "chapter_id": 10086, "verse_number": "४-२२-६५", "content_sanskrit": "बृहस्पतिर्ब्रह्मवादे आत्मतत्त्वे स्वयं हरिः।\nभक्त्या गोगुरुविप्रेषु विष्वक्सेनानुवर्तिषु॥ ४/२२/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.071.m4a", "display_order": 72}, {"id": 6000086072, "chapter_id": 10086, "verse_number": "४-२२-६६", "content_sanskrit": "ह्रिया प्रश्रयशीलाभ्यामात्मतुल्यः परोद्यमे।\nकीर्त्योर्ध्वगीतया पुम्भिस्‍त्रैलोक्ये तत्र तत्र ह॥ ४/२२/६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.072.m4a", "display_order": 73}, {"id": 6000086073, "chapter_id": 10086, "verse_number": "४-२२-६७", "content_sanskrit": "प्रविष्टः कर्णरन्ध्रेषु स्‍त्रीणां रामः सतामिव॥ ४/२२/६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_022/BhP_04.022.073.m4a", "display_order": 74}, {"id": 6000086074, "chapter_id": 10086, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां चतुर्थस्कन्धे द्वाविंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}]