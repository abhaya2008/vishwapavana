[{"id": 7001719000, "chapter_id": 21719, "verse_number": "१-१०५-१", "content_sanskrit": "ब्रह्मोवाच ।\nशृणु वत्स प्रवक्ष्यामि पुराणं वामनाभिधम् ।\nत्रिविक्रमचरित्राढ्यं दशसाहस्रसंख्यकम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001719001, "chapter_id": 21719, "verse_number": "१-१०५-२", "content_sanskrit": "कूर्मकल्पसमाख्यानं वर्गत्रयकथानम् ।\nभागद्वयसमायुक्तं वक्तृश्रोतृशुभावहम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001719002, "chapter_id": 21719, "verse_number": "१-१०५-३", "content_sanskrit": "पुराणप्रश्नः प्रथमं ब्रह्मशीर्षच्छिदा ततः ।\nकपालमोचनाख्यानं दक्षयज्ञविहिंसनम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001719003, "chapter_id": 21719, "verse_number": "१-१०५-४", "content_sanskrit": "हरस्य कालरूपाख्या कामस्य दहनं ततः ।\nप्रह्लादनारायणयोर्युद्धं देवासुराहवः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001719004, "chapter_id": 21719, "verse_number": "१-१०५-५", "content_sanskrit": "सुकेश्यर्कसमाख्यानं ततो भुवनकोशकम् ।\nततः काम्यव्रताख्यानं श्रीदुर्गाचरितं ततः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001719005, "chapter_id": 21719, "verse_number": "१-१०५-६", "content_sanskrit": "तपतीचरितं पश्चात्कुरुक्षेत्रस्य वर्णनम् ।\nसत्यामाहात्म्यमतुलं पार्वतीजन्मकीर्तनम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001719006, "chapter_id": 21719, "verse_number": "१-१०५-७", "content_sanskrit": "तपस्तस्या विवाहश्च गौर्युपाख्यानकं ततः ।\nततः कौशिक्युपाख्यानं कुमारचरितं ततः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001719007, "chapter_id": 21719, "verse_number": "१-१०५-८", "content_sanskrit": "ततोऽन्धकवधाख्यानंसाध्योपाख्यानकंततः ।\nजाबालिचरितं पश्चादरजायाः कथाद्भुता ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001719008, "chapter_id": 21719, "verse_number": "१-१०५-९", "content_sanskrit": "अंधकेशरयोर्युद्धं गणत्वं चांधकस्य च ।\nमरुतां जन्मकथनं बलेश्च चरितं ततः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001719009, "chapter_id": 21719, "verse_number": "१-१०५-१०", "content_sanskrit": "ततस्तु लक्ष्म्याश्चरितं त्रैविक्रममतः परम् ।\nप्रह्लादतीर्थयात्रायां प्रोच्यंतेऽथ कथाः शुभाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001719010, "chapter_id": 21719, "verse_number": "१-१०५-११", "content_sanskrit": "ततश्च धुन्धु चरितं प्रेतोपाख्यानकं ततः ।\nनक्षत्रपुरुषाख्यानं श्रीदामचरितं ततः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001719011, "chapter_id": 21719, "verse_number": "१-१०५-१२", "content_sanskrit": "त्रिविक्रमचरित्रांते ब्रह्मप्रोक्तः स्तवोत्तमः ।\nप्रह्लादबलिसंवादे सुतले हरिशंसनम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001719012, "chapter_id": 21719, "verse_number": "१-१०५-१३", "content_sanskrit": "इत्येष पूर्वभागोऽस्य पुराणस्य तवोदितः ।\nशृण्णतोऽस्योत्तरं भागं बृहद्वामनसंज्ञकम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001719013, "chapter_id": 21719, "verse_number": "१-१०५-१४", "content_sanskrit": "माहेश्वरी भागवती सौरी गाणेश्वरी तथा ।\nचतस्रः संहिताश्चात्र पृथक् साहस्रसंख्यया ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001719014, "chapter_id": 21719, "verse_number": "१-१०५-१५", "content_sanskrit": "माहेश्वर्यां तु कृष्णस्य तद्भक्तानां च कीर्तनम् ।\nभागवत्यां जगन्मातुखतारकथाद्भुता ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001719015, "chapter_id": 21719, "verse_number": "१-१०५-१६", "content_sanskrit": "सौर्यां सूर्यस्य महिमा गदितः पापनाशनः ।\nगाणेश्वर्यां गणेशस्य चरितं च महेशितुः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001719016, "chapter_id": 21719, "verse_number": "१-१०५-१७", "content_sanskrit": "इत्येतद्वामनं नाम पुराणं सुविचित्रकम् ।\nपुलस्त्येन समाख्यातं नारदाय महात्मने ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001719017, "chapter_id": 21719, "verse_number": "१-१०५-१८", "content_sanskrit": "ततो नारदतः प्राप्तं व्यासेन सुमहात्मना ।\nव्यासात्तु लब्धवांश्चैतत् तच्छिष्यो रोमहर्षणः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001719018, "chapter_id": 21719, "verse_number": "१-१०५-१९", "content_sanskrit": "स चाख्यास्यति विप्रेभ्यो नैमिषीयेभ्य एव च ।\nएवं परंपराप्राप्तं पुराणं वामनं शुभम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001719019, "chapter_id": 21719, "verse_number": "१-१०५-२०", "content_sanskrit": "ये पठंति च शृण्वंति तेऽपि यांति परां गतिम् ।\nलिखित्वैतत्पुराणं तु यः शरद्विषुवेऽर्पयेत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001719020, "chapter_id": 21719, "verse_number": "१-१०५-२१", "content_sanskrit": "विप्राय वेदविदुषे घृतधेनुसमन्वितम् ।\nस समुद्धृत्य नरकान्नयेत्स्वर्गं पितॄन्स्वकान् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001719021, "chapter_id": 21719, "verse_number": "१-१०५-२२", "content_sanskrit": "देहांते भुक्तभोगोऽसौ याति विष्णोः परं पदम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]