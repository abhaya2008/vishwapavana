[{"id": 50024856, "chapter_id": 11919, "verse_number": "1", "content_sanskrit": "अतोऽज्ञासम्भवादेव नाधिकार्यैक्यवादिनाम्॥ १५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024857, "chapter_id": 11919, "verse_number": "2", "content_sanskrit": "अतो नाज्ञातमिति च विषयो विषयान्तरे। अज्ञाभावात् फलं कस्य योगः शशनृशृङ्गयोः॥ १६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}]