[{"id": 2149477, "chapter_id": 4235, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2149478, "chapter_id": 4235, "verse_number": "१", "content_sanskrit": "अचलो वृषकश्चैव सहितौ भ्रातरावुभौ ।\nरथौ तव दुराधर्षौ शत्रून् विध्वंसयिष्यतः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2149479, "chapter_id": 4235, "verse_number": "२", "content_sanskrit": "बलवन्तौ नरव्याघ्रौ दृढक्रोधौ प्रहारिणौ ।\nगान्धारमुख्यौ तरुणौ दर्शनीयौ महाबलौ\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2149480, "chapter_id": 4235, "verse_number": "३", "content_sanskrit": "सखा ते दयितो नित्यं य एष रणकर्कशः ।\nउत्साहयति राजंस्त्वां विग्रहे पाण्डवैः सह\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2149481, "chapter_id": 4235, "verse_number": "४", "content_sanskrit": "परुषः कत्थनोऽतीव कर्णो वैकर्तनस्तव ।\nमन्त्री नेता च बन्धुश्च मानी चात्यन्तमुच्छ्रितः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2149482, "chapter_id": 4235, "verse_number": "५", "content_sanskrit": "एष नैव रथः कर्णो न चाप्यतिरथो रणे\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2149483, "chapter_id": 4235, "verse_number": "६", "content_sanskrit": "विमुक्तः कवचेनैष सहजेन विचेतनः ।\nकुण्डलाभ्यां च दिव्याभ्यां विमुक्तः सततं घृणी\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2149484, "chapter_id": 4235, "verse_number": "७", "content_sanskrit": "अभिशापाच्च रामस्य ब्राह्मण्यस्य च भाषणात् ।\nकरणानां वियोगाच्च तेन मेऽर्धरथो मतः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2149485, "chapter_id": 4235, "verse_number": "८", "content_sanskrit": "नैषोऽर्जुनं समासाद्य पुनर्जीवन् विमोक्ष्यते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2149486, "chapter_id": 4235, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2149487, "chapter_id": 4235, "verse_number": "९", "content_sanskrit": "ततोऽब्रवीत् पुनर्द्रोणः सर्वशस्त्रभृतां वरः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2149488, "chapter_id": 4235, "verse_number": "१०", "content_sanskrit": "एवमेतद् यदात्थ त्वं न मिथ्याऽस्ति कथञ्चन ।\nरणे रणेऽभिमानी च विमुखश्चापि दृश्यते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2149489, "chapter_id": 4235, "verse_number": "११", "content_sanskrit": "घृणी कर्णः प्रमादी च तेन मेऽर्धरथो मतः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2149490, "chapter_id": 4235, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2149491, "chapter_id": 4235, "verse_number": "१२", "content_sanskrit": "एतच्छ्रुत्वा तु राधेयः क्रोधादुद्वृत्तलोचनः ।\nउवाच भीष्मं राधेयः तुदन् वाग्भिः प्रतोदवत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2149492, "chapter_id": 4235, "verse_number": "१३", "content_sanskrit": "पितामह यथेष्टं मां वाक्छरैरवकृन्तसि ।\nअनागसं सदा द्वेषाद् एवमेव पदे पदे\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2149493, "chapter_id": 4235, "verse_number": "१४", "content_sanskrit": "मर्षयामि च तत् सर्वं दुर्योधनकृतेन वै ।\nत्वं तु मां मन्यसेऽशक्तं यथा कापुरुषं तथा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2149494, "chapter_id": 4235, "verse_number": "१५", "content_sanskrit": "भवानर्धरथो मह्यं मतो वै नात्र संशयः ।\nसर्वस्य जगतश्चैव गाङ्गेय न मृषा वदे\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2149495, "chapter_id": 4235, "verse_number": "१६", "content_sanskrit": "कुरूणामहितो नित्यं न च राजाऽवबुध्यते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2149496, "chapter_id": 4235, "verse_number": "१७", "content_sanskrit": "को हि नाम समानेषु राजसूदात्तकर्मसु ।\nतेजोवधमिमं कुर्याद् बिभेदयिषुराहवे\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2149497, "chapter_id": 4235, "verse_number": "१८", "content_sanskrit": "यथा त्वं गुणविद्वेषादपवादं चिकीर्षसि\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2149498, "chapter_id": 4235, "verse_number": "१९", "content_sanskrit": "न हायनैर्न पलितैर्न वित्तैर्न च बन्धुभिः ।\nमहारथत्वं सङ्ख्यातुं शक्यं क्षत्रस्य कौरव\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2149499, "chapter_id": 4235, "verse_number": "२०", "content_sanskrit": "बलज्येष्ठं स्मृतं क्षत्रं मन्त्रज्येष्ठा द्विजातयः ।\nधनज्येष्ठाः स्मृता वैश्याः शूद्रास्तु वयसाऽधिकाः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2149500, "chapter_id": 4235, "verse_number": "२१", "content_sanskrit": "यथेच्छकं स्वयं ब्रूया रथानतिरथांस्तथा ।\nकामद्वेषसमायुक्तो मोहात् त्वाकुरुते भवान्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2149501, "chapter_id": 4235, "verse_number": "२२", "content_sanskrit": "दुर्योधन महाबाहो साधु सम्यगवेक्ष्यताम् ।\nत्यज्यतां दुष्टभावोऽयं भीष्मः किल्बिषकृत् तव\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2149502, "chapter_id": 4235, "verse_number": "२३", "content_sanskrit": "भिन्ना हि सेना नृपते दुःसन्धेया भवत्युत ।\nमौलाऽपि पुरुषव्याघ्र किमु नाना समुत्थिता\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2149503, "chapter_id": 4235, "verse_number": "२४", "content_sanskrit": "एषां द्वेषः समुत्पन्नो योधानां युधि भारत ।\nतेजोवधो नः क्रियते प्रत्यक्षेण विशेषतः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2149504, "chapter_id": 4235, "verse_number": "२५", "content_sanskrit": "रथानां क्व च विज्ञानं क्व च भीष्मोऽल्पचेतनः ।\nअहमावारयिष्यामि पाण्डवानामनीकिनीम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2149505, "chapter_id": 4235, "verse_number": "२६", "content_sanskrit": "आसाद्य माममोघेषुं गमिष्यन्ति दिशो दश ।\nपाण्डवाः सह पाञ्चालाः शार्दूलं वृषभा इव\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2149506, "chapter_id": 4235, "verse_number": "२७", "content_sanskrit": "क्व च युद्धं विमर्दो वा मन्त्राः सुव्याहृतास्तथा ।\nक्व च भीष्मो गतवया मन्दात्मा कालचोदितः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2149507, "chapter_id": 4235, "verse_number": "२८", "content_sanskrit": "एकाकी स्पर्धते नित्यं सर्वेण जगता सह ।\nन चान्यं पुरुषं कञ्चिन्मन्यते मोघदर्शनः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2149508, "chapter_id": 4235, "verse_number": "२९", "content_sanskrit": "श्रोतव्यं खलु वृद्धानामिति शास्त्रनिदर्शनम् ।\nन त्वेव ह्यतिवृद्धानां पुनर्बाला हि ते मताः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2149509, "chapter_id": 4235, "verse_number": "३०", "content_sanskrit": "अहमेको हनिष्यामि पाण्डवान् नात्र संशयः ।\nसुयुद्धे राजशार्दूल यशो भीष्मं गमिष्यति\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2149510, "chapter_id": 4235, "verse_number": "३१", "content_sanskrit": "कृतः सेनापतिस्त्वेष त्वया भीष्मो नराधिप ।\nसेनापतौ यशो गन्ता न तु योधान् कथञ्चन\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2149511, "chapter_id": 4235, "verse_number": "३२", "content_sanskrit": "नाहं जीवति गाङ्गेये योत्स्ये राजन् कथञ्चन ।\nहते भीष्मे तु योद्धास्मि सर्वैरेव महारथैः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2149512, "chapter_id": 4235, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि षट्षष्ट्युत्तरशततमोऽध्यायः ॥१६६॥ रथातिरथसङ्ख्यानपर्वणि चतुर्थोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]