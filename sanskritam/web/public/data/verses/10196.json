[{"id": 6000196000, "chapter_id": 10196, "verse_number": null, "content_sanskrit": "अथ एकविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "topics": [{"text": "विदर्भवंशं चेदिवंशं चोक्त्वा सङ्ग्रहेण श्रीकृष्णरामाद्युत्पत्तिकथनम्", "range": null}]}, {"id": 6000196001, "chapter_id": 10196, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.001.m4a", "display_order": 2}, {"id": 6000196002, "chapter_id": 10196, "verse_number": "९-२१-१", "content_sanskrit": "तस्यां विदर्भोऽजनयत् पुत्रौ नाम्ना कुशक्रथौ।\nतृतीयं रोमपादं च वैदर्भकुलनन्दनम्॥ ९/२१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.002.m4a", "display_order": 3}, {"id": 6000196003, "chapter_id": 10196, "verse_number": "९-२१-२", "content_sanskrit": "रोमपादसुतो बभ्रुर्बभ्रोः कृतिरजायत।\nकुशिकस्तत्सुतस्तस्माच्चेदिश्चैद्यादयो यतः॥ ९/२१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.003.m4a", "display_order": 4}, {"id": 6000196004, "chapter_id": 10196, "verse_number": "९-२१-३", "content_sanskrit": "क्रथस्य कुन्तिः पुत्रोऽभूद् बलिस्तस्याथ निर्वृतिः।\nततो दशार्हनामाऽथ तस्य व्योमः सुतस्ततः॥ ९/२१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.004.m4a", "display_order": 5}, {"id": 6000196005, "chapter_id": 10196, "verse_number": "९-२१-४", "content_sanskrit": "जीमूतो विकृतिस्तस्य ततो भीमरथः सुतः।\nततो नवरथः पुत्रो जातो दशरथस्ततः॥ ९/२१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.005.m4a", "display_order": 6}, {"id": 6000196006, "chapter_id": 10196, "verse_number": "९-२१-५", "content_sanskrit": "करम्भिः शकुनेः पुत्रो देवरातस्तदात्मजः।\nदेवक्षत्रस्ततस्तस्य मधुः कुरुवशादनुः॥ ९/२१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.006.m4a", "display_order": 7}, {"id": 6000196007, "chapter_id": 10196, "verse_number": "९-२१-६", "content_sanskrit": "पुरुहोत्रस्त्वनोः पुत्रस्तस्यायुः सात्वतस्ततः।\nभजमानो भजिर्दिव्यो वृष्णिर्देवावृधोऽन्धकः॥ ९/२१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.007.m4a", "display_order": 8}, {"id": 6000196008, "chapter_id": 10196, "verse_number": "९-२१-७", "content_sanskrit": "सात्वतस्य सुताः सप्त महाभोजश्च मारिष।\nभजमानस्य निम्लोचिः किङ्किणो धृष्टिरेव च॥ ९/२१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.008.m4a", "display_order": 9}, {"id": 6000196009, "chapter_id": 10196, "verse_number": "९-२१-८", "content_sanskrit": "एकस्यामात्मजाः पत्न्यामन्यस्यां च त्रयः सुताः। शताजिच्च सहस्राजिदयुताजिदिति प्रभो।\nबभ्रुर्देवावृधसुतस्तयोः श्लोकं पठन्त्यमुम्॥ ९/२१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.009.m4a", "display_order": 10}, {"id": 6000196010, "chapter_id": 10196, "verse_number": "९-२१-९", "content_sanskrit": "यथैव शृणुमो दूरात् सम्पश्यामस्तथाऽन्तिकात्।\nबभ्रुः श्रेष्ठो मनुष्याणां देवैर्देवावृधः समः॥ ९/२१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.010.m4a", "display_order": 11}, {"id": 6000196011, "chapter_id": 10196, "verse_number": "९-२१-१०", "content_sanskrit": "पुरुषाः पञ्चषष्टिश्च षट्‌सहस्राणि चाष्ट च।\nयेऽमृतत्वमनुप्राप्ता बभ्रोर्देवावृधादपि॥ ९/२१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.011.m4a", "display_order": 12}, {"id": 6000196012, "chapter_id": 10196, "verse_number": "९-२१-११", "content_sanskrit": "महाभोजोऽतिधर्मात्मा भोजा आसन् तदन्वये॥ ९/२१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.012.m4a", "display_order": 13}, {"id": 6000196013, "chapter_id": 10196, "verse_number": "९-२१-१२", "content_sanskrit": "वृष्णेः सुमित्रः पुत्रोऽभूद् युधाजिच्च परन्तप।\nशिनिस्तस्यानमित्रश्च निम्नोऽभूदनमित्रतः॥ ९/२१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.013.m4a", "display_order": 14}, {"id": 6000196014, "chapter_id": 10196, "verse_number": "९-२१-१३", "content_sanskrit": "सत्राजितः प्रसेनश्च निम्नस्याप्यासतुः सुतौ।\nअनमित्रसुतो योऽन्यः शिनिस्तस्य च सत्यकः॥ ९/२१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.014.m4a", "display_order": 15}, {"id": 6000196015, "chapter_id": 10196, "verse_number": "९-२१-१४", "content_sanskrit": "युयुधानः सात्यकिर्वै जयस्तस्य कुणिस्ततः।\nयुगन्धरोऽनमित्रस्य पृश्निः पुत्रोऽपरस्ततः॥ ९/२१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.015.m4a", "display_order": 16}, {"id": 6000196016, "chapter_id": 10196, "verse_number": "९-२१-१५", "content_sanskrit": "श्वफल्कश्चित्ररथश्चैव गान्दिन्यां तु श्वफल्कतः।\nअक्रूरप्रमुखा आसन् पुत्रा द्वादश विश्रुताः॥ ९/२१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.016.m4a", "display_order": 17}, {"id": 6000196017, "chapter_id": 10196, "verse_number": "९-२१-१६", "content_sanskrit": "आसङ्गः सारमेयश्च मृदुरो मृदुवद्गिरिः।\nधर्मो विधृष्टकर्मा च क्षेत्रोपेक्षोऽरिमर्दनः॥ ९/२१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.017.m4a", "display_order": 18}, {"id": 6000196018, "chapter_id": 10196, "verse_number": "९-२१-१७", "content_sanskrit": "शत्रुघ्नो गन्धमोदाह्वः प्रतिबाहुश्च द्वादश।\nतेषां स्वसा सुचाराख्या द्वावक्रूरसुतावपि॥ ९/२१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.018.m4a", "display_order": 19}, {"id": 6000196019, "chapter_id": 10196, "verse_number": "९-२१-१८", "content_sanskrit": "देववानुपदेवश्च तथा चित्ररथात्मजाः।\nपृथुर्विपृथुनामाद्या बहवो वृष्णिनन्दनाः॥ ९/२१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.019.m4a", "display_order": 20}, {"id": 6000196020, "chapter_id": 10196, "verse_number": "९-२१-१९", "content_sanskrit": "कुकुरो भजमानश्च शुचिः कम्बलबर्हिषः।\nकुकुरस्य सुतो धृष्णुर्विलोमा तनयस्ततः॥ ९/२१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.020.m4a", "display_order": 21}, {"id": 6000196021, "chapter_id": 10196, "verse_number": "९-२१-२०", "content_sanskrit": "कपोतरोमा तस्यानुः सखा यस्य च तुम्बुरुः।\nअनोश्च दुन्दुभिस्तस्य दरिद्योतः पुनर्वसुः॥ ९/२१/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.021.m4a", "display_order": 22}, {"id": 6000196022, "chapter_id": 10196, "verse_number": "९-२१-२१", "content_sanskrit": "तस्याहुकश्चाहुकी च कन्या द्वावाहुकात्मजौ।\nदेवकश्चोग्रसेनश्च चत्वारो देवकात्मजाः॥ ९/२१/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.022.m4a", "display_order": 23}, {"id": 6000196023, "chapter_id": 10196, "verse_number": "९-२१-२२", "content_sanskrit": "देववानुपदेवश्च सुदेवो देववर्धनः।\nतेषां स्वसारः सप्तासन् धृतदेवादयो नृप॥ ९/२१/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.023.m4a", "display_order": 24}, {"id": 6000196024, "chapter_id": 10196, "verse_number": "९-२१-२३", "content_sanskrit": "शान्तिदेवोपदेवा च श्रीदेवा देवरक्षिता।\nसहदेवा देवकी च वसुदेव उवाह ताः॥ ९/२१/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.024.m4a", "display_order": 25}, {"id": 6000196025, "chapter_id": 10196, "verse_number": "९-२१-२४", "content_sanskrit": "कंसः सुनामा न्यग्रोधः कङ्कः शङ्कुः सुभूस्तथा।\nराष्ट्रपालोऽब्दसृष्टिश्च तृष्टिमानौग्रसेनयः॥ ९/२१/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.025.m4a", "display_order": 26}, {"id": 6000196026, "chapter_id": 10196, "verse_number": "९-२१-२५", "content_sanskrit": "कंसा कंसवती कङ्का सुरभू राष्ट्रपालिका।\nऔग्रसेना दुहितरो वसुदेवानुजस्‍त्रियः॥ ९/२१/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.026.m4a", "display_order": 27}, {"id": 6000196027, "chapter_id": 10196, "verse_number": "९-२१-२६", "content_sanskrit": "शूरो विदूरथादासीद् भजमानसुतात् ततः।\nशिनिस्तस्मात् स्वयम्भोजो हृदिकस्तत्सुतो मतः॥ ९/२१/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.027.m4a", "display_order": 28}, {"id": 6000196028, "chapter_id": 10196, "verse_number": "९-२१-२७", "content_sanskrit": "देवबाहुः शतधनुः कृतवर्मेति तत्सुताः।\nदैवमीढस्य शूरस्य मारिषा नाम पत्न्यभूत्॥ ९/२१/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.028.m4a", "display_order": 29}, {"id": 6000196029, "chapter_id": 10196, "verse_number": "९-२१-२८", "content_sanskrit": "तस्यां सञ्जनयामास दशपुत्रानकल्मषान्।\nवसुदेवं देवभागं देवश्रवसमानकम्॥ ९/२१/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.029.m4a", "display_order": 30}, {"id": 6000196030, "chapter_id": 10196, "verse_number": "९-२१-२९", "content_sanskrit": "सृञ्जयं श्यामकं कङ्कमनीकं वत्सकं वृकम्।\nदेवदुन्दुभयो नेदुरानका यस्य जन्मनि॥ ९/२१/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.030.m4a", "display_order": 31}, {"id": 6000196031, "chapter_id": 10196, "verse_number": "९-२१-३०", "content_sanskrit": "वसुदेवं हरेः स्थानं वदन्त्यानकदुन्दुभिम्।\nपृथा च श्रुतदेवा च श्रुतकीर्तिः श्रुतश्रवाः॥ ९/२१/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.031.m4a", "display_order": 32}, {"id": 6000196032, "chapter_id": 10196, "verse_number": "९-२१-३१", "content_sanskrit": "राजाधिदेवी चैतेषां भगिन्यः पञ्चकन्यकाः।\nकुन्तेः सख्युः पिता शूरो ह्यपुत्रस्य पृथामदात्॥ ९/२१/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.032.m4a", "display_order": 33}, {"id": 6000196033, "chapter_id": 10196, "verse_number": "९-२१-३२", "content_sanskrit": "सा च दुर्वाससो विद्यां देवहूतिं प्रतोषितात्।\nतस्या वीर्यपरीक्षार्थमाजुहाव रविं शुचिः॥ ९/२१/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.033.m4a", "display_order": 34}, {"id": 6000196034, "chapter_id": 10196, "verse_number": "९-२१-३३", "content_sanskrit": "तदैवोपागतं देवं वीक्ष्य विस्मितमानसा।\nप्रत्ययार्थं प्रयुक्ता मे याहि देव क्षमस्व मे॥ ९/२१/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.034.m4a", "display_order": 35}, {"id": 6000196035, "chapter_id": 10196, "verse_number": "९-२१-३४", "content_sanskrit": "अमोघं देवसंदर्शमाधास्ये त्वयि चात्मजम्।\nयोनिर्यथा न दुष्येत कर्ताऽहं ते सुमध्यमे॥ ९/२१/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.035.m4a", "display_order": 36}, {"id": 6000196036, "chapter_id": 10196, "verse_number": "९-२१-३५", "content_sanskrit": "इति तस्यां समाधाय गर्भं सूर्यो दिवं गतः।\nसद्यः कुमारः संजज्ञे द्वितीय इव भास्करः॥ ९/२१/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.036.m4a", "display_order": 37}, {"id": 6000196037, "chapter_id": 10196, "verse_number": "९-२१-३६", "content_sanskrit": "तं साऽत्यजन्नदीतोये कृच्छ्राल्लोकस्य बिभ्यती।\nप्रपितामहस्तामुवाह पाण्डुर्वै सत्यविक्रमः॥ ९/२१/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.037.m4a", "display_order": 38}, {"id": 6000196038, "chapter_id": 10196, "verse_number": "९-२१-३७", "content_sanskrit": "श्रुतदेवां तु कारूशो वृद्धशर्मा समग्रहीत्।\nयस्यामभूद् दन्तवक्र ऋषिशप्तो दितेः सुतः॥ ९/२१/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.038.m4a", "display_order": 39}, {"id": 6000196039, "chapter_id": 10196, "verse_number": "९-२१-३८", "content_sanskrit": "कैकेयो धृष्टकेतुश्च श्रुतकीर्तिमविन्दत।\nसन्तर्दनादयस्तस्याः पञ्चासुः कैकयाः सुताः॥ ९/२१/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.039.m4a", "display_order": 40}, {"id": 6000196040, "chapter_id": 10196, "verse_number": "९-२१-३९", "content_sanskrit": "राजाधिदेव्यामावन्त्यौ जयत्सेनोऽजनिष्ट ह।\nदमघोषश्चेदिराजः श्रुतश्रवसमग्रहीत्॥ ९/२१/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.040.m4a", "display_order": 41}, {"id": 6000196041, "chapter_id": 10196, "verse_number": "९-२१-४०", "content_sanskrit": "शिशुपालः सुतस्तस्याः कथितस्तस्य सम्भवः।\nदेवभागस्य कंसायां चित्रकेतुबृहद्बलौ॥ ९/२१/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.041.m4a", "display_order": 42}, {"id": 6000196042, "chapter_id": 10196, "verse_number": "९-२१-४१", "content_sanskrit": "कंसवत्यां देवश्रवसः सुवीर इषुमांस्तथा।\nकङ्कायामानकाज्जातः सत्यजित् पुरुजित् तथा॥ ९/२१/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.042.m4a", "display_order": 43}, {"id": 6000196043, "chapter_id": 10196, "verse_number": "९-२१-४२", "content_sanskrit": "सृञ्जयो राष्ट्रपाल्यां तु वृषदुर्मर्षणादिकान्।\nहरिकेशहिरण्याक्षौ सुरभूम्यां तु श्यामकः॥ ९/२१/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.043.m4a", "display_order": 44}, {"id": 6000196044, "chapter_id": 10196, "verse_number": "९-२१-४३", "content_sanskrit": "मित्रकेश्यामप्सरसि वृकादीन् वत्सकस्तथा।\nतक्षपुष्करसालादीनुर्वश्यां वृक आदधे॥ ९/२१/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.044.m4a", "display_order": 45}, {"id": 6000196045, "chapter_id": 10196, "verse_number": "९-२१-४४", "content_sanskrit": "सुमित्रार्जुनबाणादीननीकात् तु सुदामनी।\nकङ्कश्च कर्णिकायां वै ऋतधामजयावपि॥ ९/२१/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.045.m4a", "display_order": 46}, {"id": 6000196046, "chapter_id": 10196, "verse_number": "९-२१-४५", "content_sanskrit": "पौरवी रोहिणी भद्रा मदिरा रोचना इला।\nदेवकीप्रमुखा आसन् पत्न्य आनकदुन्दुभेः॥ ९/२१/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.046.m4a", "display_order": 47}, {"id": 6000196047, "chapter_id": 10196, "verse_number": "९-२१-४६", "content_sanskrit": "बलं गदं सारणं च दुर्मदं विपुलं ध्रुवम्।\nवसुदेवस्तु रोहिण्यां कृतधीरुदपादयत्॥ ९/२१/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.047.m4a", "display_order": 48}, {"id": 6000196048, "chapter_id": 10196, "verse_number": "९-२१-४७", "content_sanskrit": "सुभद्रो भद्रबाहुश्च दुर्मदो भद्र एव च।\nपौरव्यास्तनया ह्येते भूताद्या द्वादशाभवन्॥ ९/२१/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.048.m4a", "display_order": 49}, {"id": 6000196049, "chapter_id": 10196, "verse_number": "९-२१-४८", "content_sanskrit": "नन्दोपनन्दकृतकशूराद्या मदिरात्मजाः।\nभद्राख्या केशिनं त्वेकं कौसल्या कुलनन्दनम्॥ ९/२१/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.049.m4a", "display_order": 50}, {"id": 6000196050, "chapter_id": 10196, "verse_number": "९-२१-४९", "content_sanskrit": "रोचनायां ततो जाता हस्तहेमाङ्गदादयः।\nइलायां पुरुवल्कादीन् यदुमुख्यानजीजनत्॥ ९/२१/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.050.m4a", "display_order": 51}, {"id": 6000196051, "chapter_id": 10196, "verse_number": "९-२१-५०", "content_sanskrit": "त्रिपृष्ठो धृतदेवायां जात आनकदुन्दुभेः।\nशान्तिदेवात्मजा राजन् प्रश्रमप्रश्रितादयः॥ ९/२१/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.051.m4a", "display_order": 52}, {"id": 6000196052, "chapter_id": 10196, "verse_number": "९-२१-५१", "content_sanskrit": "राजानः कल्पवर्षाद्या उपदेव्याः सुता दश।\nवसुहंससुधन्वाद्याः श्रीदेवायाश्च षट् सुताः॥ ९/२१/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.052.m4a", "display_order": 53}, {"id": 6000196053, "chapter_id": 10196, "verse_number": "९-२१-५२", "content_sanskrit": "देवरक्षितया लब्धा नव चात्र गदादयः।\nवसुदेवः सुतानष्टावादधे सहदेवया॥ ९/२१/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.053.m4a", "display_order": 54}, {"id": 6000196054, "chapter_id": 10196, "verse_number": "९-२१-५३", "content_sanskrit": "पुरुवत्समृदुमुख्यान् साक्षाद्धर्मो वसूनिव।\nवसुदेवस्तु देवक्यामष्टपुत्रानजीजनत्॥ ९/२१/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.054.m4a", "display_order": 55}, {"id": 6000196055, "chapter_id": 10196, "verse_number": "९-२१-५४", "content_sanskrit": "कीर्तिमन्तं सुषेणं च भद्रसेनमुदारधीः।\nऋजुं संमर्दनं भद्रं सङ्कर्षणमहीश्वरम्॥ ९/२१/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.055.m4a", "display_order": 56}, {"id": 6000196056, "chapter_id": 10196, "verse_number": "९-२१-५५", "content_sanskrit": "अष्टमस्तु तयोरासीत् स्वयमेव हरिः किल।\nसुभद्रा च महाभागा तव राजन् पितामही॥ ९/२१/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.056.m4a", "display_order": 57}, {"id": 6000196057, "chapter_id": 10196, "verse_number": "९-२१-५६", "content_sanskrit": "यदा यदा हि धर्मस्य क्षयो वृद्धिश्च पाप्मनः।\nतदा तु भगवानीश आत्मानं सृजते हरिः॥ ९/२१/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.057.m4a", "display_order": 58}, {"id": 6000196058, "chapter_id": 10196, "verse_number": "९-२१-५७", "content_sanskrit": "न ह्यस्य जन्मनो हेतुः कर्मणां वा महीपते।\nआत्ममायां विनेशस्य परस्य द्रष्टुरात्मनः॥ ९/२१/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.058.m4a", "display_order": 59}, {"id": 6000196059, "chapter_id": 10196, "verse_number": "९-२१-५८", "content_sanskrit": "यन्मायाचेष्टितं पुंसः स्थित्युत्पत्त्यप्ययाय हि।\nअनुग्रहस्तन्निवृत्तेरात्मलाभाय चेष्यते॥ ९/२१/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.059.m4a", "display_order": 60}, {"id": 6000196060, "chapter_id": 10196, "verse_number": "९-२१-५९", "content_sanskrit": "अक्षौहिणीनां पतिभिरसुरैर्नृपलाञ्छनैः।\nभुव आक्रम्यमाणाया अभावाय कृतोद्यमः॥ ९/२१/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.060.m4a", "display_order": 61}, {"id": 6000196061, "chapter_id": 10196, "verse_number": "९-२१-६०", "content_sanskrit": "कर्माण्यपरिमेयानि मनसाऽपि सुरेश्वरैः।\nसह सङ्कर्षणश्चक्रे भगवान् मधुसूदनः॥ ९/२१/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.061.m4a", "display_order": 62}, {"id": 6000196062, "chapter_id": 10196, "verse_number": "९-२१-६१", "content_sanskrit": "कलौ जनिष्यमाणानां दुःखशोकतमोनुदम्।\nअनुग्रहाय भूतानां सुपुण्यं व्यतनोद् यशः॥ ९/२१/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.062.m4a", "display_order": 63}, {"id": 6000196063, "chapter_id": 10196, "verse_number": "९-२१-६२", "content_sanskrit": "यस्मिन् सत्कर्णपीयूषे यशस्तीर्थवरेऽसकृत्।\nश्रोत्राञ्जलिरुपस्पृश्य धुनुते कर्मवासनाः॥ ९/२१/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.063.m4a", "display_order": 64}, {"id": 6000196064, "chapter_id": 10196, "verse_number": "९-२१-६३", "content_sanskrit": "भोजवृष्ण्यन्धकमधुशूरसेनदशार्हकैः।\nश्लाघनीयेहितः शश्वत् कुरुसृञ्जयपाण्डुभिः॥ ९/२१/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.064.m4a", "display_order": 65}, {"id": 6000196065, "chapter_id": 10196, "verse_number": "९-२१-६४", "content_sanskrit": "स्निग्धस्मितेक्षितोदारैर्वाक्यैर्विक्रमलीलया।\nनृलोकं रमयामास मूर्त्या सर्वाङ्गरम्यया॥ ९/२१/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.065.m4a", "display_order": 66}, {"id": 6000196066, "chapter_id": 10196, "verse_number": "९-२१-६५", "content_sanskrit": "यस्याननं मकरकुण्डलचारुकर्णभ्राजत्कपोलसुभगं सविलासहासम्।\nनित्योत्सवं न ततृपुर्दृशिभिः पिबन्त्यो नार्यो नराश्च मुदिताः कुपिता निमेश्च॥ ९/२१/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.066.m4a", "display_order": 67}, {"id": 6000196067, "chapter_id": 10196, "verse_number": "९-२१-६६", "content_sanskrit": "जातो गतः पितृगृहाद् व्रजमेधितोऽत्र हत्वा रिपून् सुतशतानि कृतोरुदारः।\nउत्पाद्य तेषु पुरुषः क्रतुभिः समीजे आत्मानमात्मनिगमं प्रथयन् जनेषु॥ ९/२१/६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.067.m4a", "display_order": 68}, {"id": 6000196068, "chapter_id": 10196, "verse_number": "९-२१-६७", "content_sanskrit": "पृथ्व्याः स वै गुरुभरं क्षपयन् कुरूणामन्तःसमुत्थकलिना युधि भूपबन्धम्।\nदृष्ट्या विधूय विजये जयमुद्विघुष्य प्रोच्योद्धवाय च परं समगात् स्वधाम॥ ९/२१/६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_021/BhP_09.021.068.m4a", "display_order": 69}, {"id": 6000196069, "chapter_id": 10196, "verse_number": null, "content_sanskrit": "इति श्रीमद्भागवते वैयासिक्यां संहितायां नवमस्कन्धे एकविंशाध्यायः॥\nइति नवमस्कन्धः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}]