[{"id": 7000676000, "chapter_id": 20676, "verse_number": "६-१९-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nश्रीशैलः पर्वतो रम्यः कुत्र तिष्ठति नारद ।\nकिं तत्र वर्त्तते तीर्थं कस्य देवस्य पूजनम् ।\nकस्यां दिशि समाख्यातो लोकेषु च वदाधुना ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000676001, "chapter_id": 20676, "verse_number": "६-१९-२", "content_sanskrit": "नारद उवाच ।\nशृणु राजन्प्रवक्ष्यामि श्रीशैलं पर्वतोत्तमम् ।\nयं श्रुत्वा मुच्यते लोको बालहत्यादि पातकात् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000676002, "chapter_id": 20676, "verse_number": "६-१९-३", "content_sanskrit": "तत्पर्वतवनं रम्यं मुनिभिश्चोपसेवितम् ।\nनानाद्रुमलताकीर्णं नानापुष्पोपशोभितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000676003, "chapter_id": 20676, "verse_number": "६-१९-४", "content_sanskrit": "हंसकोकिलनादैश्च मयूरध्वनिनादितम् ।\nश्रीवृक्षैश्च कपित्थैश्च शिरीषै राजवृक्षकैः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000676004, "chapter_id": 20676, "verse_number": "६-१९-५", "content_sanskrit": "पारिजातकपुष्पैश्च कदंबोदुंबरैस्तथा ।\nनानापुष्पैः सुगंधाढ्यैर्वासितं तद्वनं गिरौ ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000676005, "chapter_id": 20676, "verse_number": "६-१९-६", "content_sanskrit": "सर्वाभिरृषिपत्नीभिः सशिष्याभिः सुसेवितम् ।\nकेचिदभ्यासयुक्ताश्च केचिद्व्याख्यानतत्पराः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000676006, "chapter_id": 20676, "verse_number": "६-१९-७", "content_sanskrit": "केचिदूर्ध्वभुजास्तत्र अंगुष्ठाग्रैः स्थिताः परे ।\nशिवध्यानरताः केचित्केचिद्विष्णुपरायणाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000676007, "chapter_id": 20676, "verse_number": "६-१९-८", "content_sanskrit": "निराहाराश्च केप्यत्र केचित्पर्णाशने रताः ।\nकंदमूलफलाहाराः केचिन्मौनव्रताः स्थिताः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000676008, "chapter_id": 20676, "verse_number": "६-१९-९", "content_sanskrit": "एकपादाः स्थिताः केचित्केचित्पद्मासने स्थिताः ।\nकेचिच्चैव निराहारास्तपस्तेपुः सुदुष्करम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000676009, "chapter_id": 20676, "verse_number": "६-१९-१०", "content_sanskrit": "आश्रमाणि च पुण्यानि नद्यश्च विविधाः शुभाः ।\nदेवखातान्यनेकानि तडागानि बहूनि च ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000676010, "chapter_id": 20676, "verse_number": "६-१९-११", "content_sanskrit": "पर्वतोऽयं महाराज दृश्यते किल सर्वतः ।\nमल्लिकार्जुनको राजन्यत्र तिष्ठति नित्यशः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000676011, "chapter_id": 20676, "verse_number": "६-१९-१२", "content_sanskrit": "तच्चैव शिखरं रम्यं पर्वतोपरि सेवितम् ।\nशृंगदर्शनमात्रेण मुक्तिरेव न संशयः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000676012, "chapter_id": 20676, "verse_number": "६-१९-१३", "content_sanskrit": "दक्षिणां दिशमाश्रित्य वर्त्तते पर्वतोत्तमः ।\nअत्र गंगा महद्रम्या पातालेति समाश्रिता ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000676013, "chapter_id": 20676, "verse_number": "६-१९-१४", "content_sanskrit": "तत्र च स्नानमात्रेण महापापैः प्रमुच्यते ।\nश्रीशैलशिखरं दृष्ट्वा वाराणस्यां मृतौ ध्रुवम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000676014, "chapter_id": 20676, "verse_number": "६-१९-१५", "content_sanskrit": "केदारे ह्युदकं पीत्वा पुनर्जन्म न विद्यते ।\nतापसानां महत्स्थानं योगिनां च तथैव च ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000676015, "chapter_id": 20676, "verse_number": "६-१९-१६", "content_sanskrit": "तस्मात्सर्वप्रयत्नेन दर्शनं तस्य कारयेत् ।\nअयं विज्ञानदेवोऽसौ महापातकनाशनः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000676016, "chapter_id": 20676, "verse_number": "६-१९-१७", "content_sanskrit": "सिद्धपुरं च नगरं रम्यं स्वर्गसुखावहम् ।\nनित्यमप्सरसो यत्र गायंति च रमंति च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000676017, "chapter_id": 20676, "verse_number": "६-१९-१८", "content_sanskrit": "अतः पर्वताराजोऽयं दर्शने सौख्यकारकः ।\nतस्य तैर्दर्शनं कार्यं मुक्तिमिच्छंति ये नराः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]