[{"id": 5000369000, "chapter_id": 9369, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000369001, "chapter_id": 9369, "verse_number": "५-३०-१", "content_sanskrit": "हनुमानपि विक्रान्तः सर्वं शुश्राव तत्त्वतः।\nसीतायास्त्रिजटायाश्च राक्षसीनां च तर्जितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000369002, "chapter_id": 9369, "verse_number": "५-३०-२", "content_sanskrit": "अवेक्षमाणस्तां देवीं देवतामिव नन्दने।\nततो बहुविधां चिन्तां चिन्तयामास वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000369003, "chapter_id": 9369, "verse_number": "५-३०-३", "content_sanskrit": "यां कपीनां सहस्राणि सुबहून्ययुतानि च।\nदिक्षु सर्वासु मार्गन्ते सेयमासादिता मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000369004, "chapter_id": 9369, "verse_number": "५-३०-४", "content_sanskrit": "चारेण तु सुयुक्तेन शत्रोः शक्तिमवेक्षता।\nगूढेन चरता तावदवेक्षितमिदं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000369005, "chapter_id": 9369, "verse_number": "५-३०-५", "content_sanskrit": "राक्षसानां विशेषश्च पुरी चेयं निरीक्षिता।\nराक्षसाधिपतेरस्य प्रभावो रावणस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000369006, "chapter_id": 9369, "verse_number": "५-३०-६", "content_sanskrit": "यथा तस्याप्रमेयस्य सर्वसत्त्वदयावतः।\nसमाश्वासयितुं भार्यां पतिदर्शनकांक्षिणीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000369007, "chapter_id": 9369, "verse_number": "५-३०-७", "content_sanskrit": "अहमाश्वासयाम्येनां पूर्णचन्द्रनिभाननाम्।\nअदृष्टदुःखां दुःखस्य न ह्यन्तमधिगच्छतीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000369008, "chapter_id": 9369, "verse_number": "५-३०-८", "content_sanskrit": "यदि ह्यहं सतीमेनां शोकोपहतचेतनाम्।\nअनाश्वास्य गमिष्यामि दोषवद् गमनं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000369009, "chapter_id": 9369, "verse_number": "५-३०-९", "content_sanskrit": "गते हि मयि तत्रेयं राजपुत्री यशस्विनी।\nपरित्राणमपश्यन्ती जानकी जीवितं त्यजेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000369010, "chapter_id": 9369, "verse_number": "५-३०-१०", "content_sanskrit": "यथा च स महाबाहुः पूर्णचन्द्रनिभाननः।\nसमाश्वासयितुं न्याय्यः सीतादर्शनलालसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000369011, "chapter_id": 9369, "verse_number": "५-३०-११", "content_sanskrit": "निशाचरीणां प्रत्यक्षमक्षमं चाभिभाषितम्।\nकथं नु खलु कर्तव्यमिदं कृच्छ्रगतो ह्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000369012, "chapter_id": 9369, "verse_number": "५-३०-१२", "content_sanskrit": "अनेन रात्रिशेषेण यदि नाश्वास्यते मया।\nसर्वथा नास्ति संदेहः परित्यक्ष्यति जीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000369013, "chapter_id": 9369, "verse_number": "५-३०-१३", "content_sanskrit": "रामस्तु यदि पृच्छेन्मां किं मां सीताब्रवीद्वचः।\nकिमहं तं प्रतिब्रूयामसम्भाष्य सुमध्यमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000369014, "chapter_id": 9369, "verse_number": "५-३०-१४", "content_sanskrit": "सीतासंदेशरहितं मामितस्त्वरया गतम्।\nनिर्दहेदपि काकुत्स्थः क्रोधतीव्रेण चक्षुषा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000369015, "chapter_id": 9369, "verse_number": "५-३०-१५", "content_sanskrit": "यदि वोद्योजयिष्यामि भर्तारं रामकारणात्।\nव्यर्थमागमनं तस्य ससैन्यस्य भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000369016, "chapter_id": 9369, "verse_number": "५-३०-१६", "content_sanskrit": "अन्तरं त्वहमासाद्य राक्षसीनामवस्थितः।\nशनैराश्वासयाम्यद्य संतापबहुलामिमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000369017, "chapter_id": 9369, "verse_number": "५-३०-१७", "content_sanskrit": "अहं ह्यतितनुश्चैव वानरश्च विशेषतः।\nवाचं चोदाहरिष्यामि मानुषीमिह संस्कृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000369018, "chapter_id": 9369, "verse_number": "५-३०-१८", "content_sanskrit": "यदि वाचं प्रदास्यामि द्विजातिरिव संस्कृताम्।\nरावणं मन्यमाना मां सीता भीता भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000369019, "chapter_id": 9369, "verse_number": "५-३०-१९", "content_sanskrit": "अवश्यमेव वक्तव्यं मानुषं वाक्यमर्थवत्।\nमया सान्त्वयितुं शक्या नान्यथेयमनिन्दिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000369020, "chapter_id": 9369, "verse_number": "५-३०-२०", "content_sanskrit": "सेयमालोक्य मे रूपं जानकी भाषितं तथा।\nरक्षोभिस्त्रासिता पूर्वं भूयस्त्रासमुपैष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000369021, "chapter_id": 9369, "verse_number": "५-३०-२१", "content_sanskrit": "ततो जातपरित्रासा शब्दं कुर्यान्मनस्विनी।\nजानाना मां विशालाक्षी रावणं कामरूपिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000369022, "chapter_id": 9369, "verse_number": "५-३०-२२", "content_sanskrit": "सीतया च कृते शब्दे सहसा राक्षसीगणः।\nनानाप्रहरणो घोरः समेयादन्तकोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000369023, "chapter_id": 9369, "verse_number": "५-३०-२३", "content_sanskrit": "ततो मां सम्परिक्षिप्य सर्वतो विकृताननाः।\nवधे च ग्रहणे चैव कुर्युर्यत्नं महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000369024, "chapter_id": 9369, "verse_number": "५-३०-२४", "content_sanskrit": "तं मां शाखाः प्रशाखाश्च स्कन्धांश्चोत्तमशाखिनाम्।\nदृष्ट्वा च परिधावन्तं भवेयुः परिशङ्किताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000369025, "chapter_id": 9369, "verse_number": "५-३०-२५", "content_sanskrit": "मम रूपं च सम्प्रेक्ष्य वने विचरतो महत्।\nराक्षस्यो भयवित्रस्ता भवेयुर्विकृतस्वराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000369026, "chapter_id": 9369, "verse_number": "५-३०-२६", "content_sanskrit": "ततः कुर्युः समाह्वानं राक्षस्यो रक्षसामपि।\nराक्षसेन्द्रनियुक्तानां राक्षसेन्द्रनिवेशने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000369027, "chapter_id": 9369, "verse_number": "५-३०-२७", "content_sanskrit": "ते शूलशरनिस्त्रिंशविविधायुधपाणयः।\nआपतेयुर्विमर्देऽस्मिन् वेगेनोद्वेगकारणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000369028, "chapter_id": 9369, "verse_number": "५-३०-२८", "content_sanskrit": "संरुद्धस्तैस्तु परितो विधमे राक्षसं बलम्।\nशक्नुयां न तु सम्प्राप्तुं परं पारं महोदधेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000369029, "chapter_id": 9369, "verse_number": "५-३०-२९", "content_sanskrit": "मां वा गृह्णीयुरावृत्य बहवः शीघ्रकारिणः।\nस्यादियं चागृहीतार्था मम च ग्रहणं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000369030, "chapter_id": 9369, "verse_number": "५-३०-३०", "content_sanskrit": "हिंसाभिरुचयो हिंस्युरिमां वा जनकात्मजाम्।\nविपन्नं स्यात् ततः कार्यं रामसुग्रीवयोरिदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000369031, "chapter_id": 9369, "verse_number": "५-३०-३१", "content_sanskrit": "उद्देशे नष्टमार्गेऽस्मिन् राक्षसैः परिवारिते।\nसागरेण परिक्षिप्ते गुप्ते वसति जानकी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000369032, "chapter_id": 9369, "verse_number": "५-३०-३२", "content_sanskrit": "विशस्ते वा गृहीते वा रक्षोभिर्मयि संयुगे।\nनान्यं पश्यामि रामस्य सहायं कार्यसाधने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000369033, "chapter_id": 9369, "verse_number": "५-३०-३३", "content_sanskrit": "विमृशंश्च न पश्यामि यो हते मयि वानरः।\nशतयोजनविस्तीर्णं लङ्घयेत महोदधिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000369034, "chapter_id": 9369, "verse_number": "५-३०-३४", "content_sanskrit": "कामं हन्तुं समर्थोऽस्मि सहस्राण्यपि रक्षसाम्।\nन तु शक्ष्याम्यहं प्राप्तुं परं पारं महोदधेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000369035, "chapter_id": 9369, "verse_number": "५-३०-३५", "content_sanskrit": "कामं हन्तुं समर्थोऽस्मि सहस्राण्यपि रक्षसाम्।\nन तु शक्ष्याम्यहं प्राप्तुं परं पारं महोदधेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000369036, "chapter_id": 9369, "verse_number": "५-३०-३६", "content_sanskrit": "एष दोषो महान् हि स्यान्मम सीताभिभाषणे।\nप्राणत्यागश्च वैदेह्या भवेदनभिभाषणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000369037, "chapter_id": 9369, "verse_number": "५-३०-३७", "content_sanskrit": "भूताश्चार्था विरुध्यन्त देशकालविरोधिताः।\nविक्लवं दूतमासाद्य तमः सूर्योदये यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000369038, "chapter_id": 9369, "verse_number": "५-३०-३८", "content_sanskrit": "अर्थानर्थान्तरे बुद्धिर्निश्चितापि न शोभते।\nघातयन्ति हि कार्याणि दूताः पण्डितमानिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000369039, "chapter_id": 9369, "verse_number": "५-३०-३९", "content_sanskrit": "न विनश्येत् कथं कार्यं वैक्लव्यं न कथं मम।\nलङ्घनं च समुद्रस्य कथं नु न वृथा भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000369040, "chapter_id": 9369, "verse_number": "५-३०-४०", "content_sanskrit": "कथं नु खलु वाक्यं मे शृणुयान्नोद्विजेत च।\nइति संचिन्त्य हनुमांश्चकार मतिमान् मतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000369041, "chapter_id": 9369, "verse_number": "५-३०-४१", "content_sanskrit": "राममक्लिष्टकर्माणं सुबन्धुमनुकीर्तयन्।\nनैनामुद्वेजयिष्यामि तद‍्बन्धुगतचेतनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000369042, "chapter_id": 9369, "verse_number": "५-३०-४२", "content_sanskrit": "इक्ष्वाकूणां वरिष्ठस्य रामस्य विदितात्मनः।\nशुभानि धर्मयुक्तानि वचनानि समर्पयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000369043, "chapter_id": 9369, "verse_number": "५-३०-४३", "content_sanskrit": "श्रावयिष्यामि सर्वाणि मधुरां प्रब्रुवन् गिरम्।\nश्रद्धास्यति यथा सीता तथा सर्वं समादधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000369044, "chapter_id": 9369, "verse_number": "५-३०-४४", "content_sanskrit": "इति स बहुविधं महाप्रभावो\nजगतिपतेः प्रमदामवेक्षमाणः।\nमधुरमवितथं जगाद वाक्यं\nद्रुमविटपान्तरमास्थितो हनूमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000369045, "chapter_id": 9369, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]