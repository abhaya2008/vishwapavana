[{"id": 2061764, "chapter_id": 2319, "verse_number": "८-४०-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2061765, "chapter_id": 2319, "verse_number": "८-४०-१", "content_sanskrit": "दुर्योधनस्ततः कर्णमुपेत्य भरतर्षभ।\nअब्रवीन्मद्रराजं च तथैवान्यान्महारथान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2061766, "chapter_id": 2319, "verse_number": "८-४०-२", "content_sanskrit": "यदृच्छयाऽयमव्यग्रो धर्मः परमकः सखा।\nसुखिनः क्षत्रियाः कर्ण लभन्ते युद्धमीदृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2061767, "chapter_id": 2319, "verse_number": "८-४०-३", "content_sanskrit": "यादृशं क्षत्रियैः शूरैः शूराणां दीव्यतां युधि।\nइष्टं भवति राधेय तदिदं समुपस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2061768, "chapter_id": 2319, "verse_number": "८-४०-४", "content_sanskrit": "हत्वा तु पाण्डवान्युद्धे स्थिरामुर्वीं प्रशासथ।\nनिहता वा परैर्युद्धे वीरलोकानवाप्स्यथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2061769, "chapter_id": 2319, "verse_number": "८-४०-५", "content_sanskrit": "दुर्योधनस्य वचनं श्रुत्वा तत्क्षत्रियर्षभाः।\nसिंहनादानुदक्रोशन्वादित्राणि च जघ्निरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2061770, "chapter_id": 2319, "verse_number": "८-४०-६", "content_sanskrit": "तस्मिन्प्रमुदिते सैन्ये त्वदीये भरतर्षभ।\nहर्षयंस्तावकान्योधान्द्रौणिर्विचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2061771, "chapter_id": 2319, "verse_number": "८-४०-७", "content_sanskrit": "प्रत्यक्षं सर्वसैन्यानां भवतां चापि पश्यताम्।\nन्यस्तशस्त्रो मम पिता धृष्टद्युम्नेन पातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2061772, "chapter_id": 2319, "verse_number": "८-४०-८", "content_sanskrit": "स तेनाहममर्षेण पित्रर्थे चापि भारत।\nधृष्टद्युम्नमहत्वाऽहं न विमोक्ष्यामि दंशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2061773, "chapter_id": 2319, "verse_number": "८-४०-९", "content_sanskrit": "कृत्वाऽनृतां प्रतिज्ञां वो नास्मि प्राप्ता महत्फलम्।\nअर्जुनं भीमसेनं च यश्च मां प्रतियोत्स्यति।\nसर्वांस्तान्प्रमथिष्यामि इति मे निश्चिता मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2061774, "chapter_id": 2319, "verse_number": "८-४०-१०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2061775, "chapter_id": 2319, "verse_number": "८-४०-१०", "content_sanskrit": "एवमुक्ते ततः सर्वा हर्षिता भारती चमूः।\nअभ्यवर्तत कौन्तेयांस्तथा तां चापि पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2061776, "chapter_id": 2319, "verse_number": "८-४०-११", "content_sanskrit": "स सन्निपातो रथयूथपानां\nमहाहवे भारत लोभनीये।\nजनक्षयः कालयुगान्तकल्पः\nप्रावर्तताग्रे कुरुसृञ्जयानाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2061777, "chapter_id": 2319, "verse_number": "८-४०-१२", "content_sanskrit": "ततः प्रवृत्ते युधि सम्प्रहारे\nभूतानि सर्वाणि सदैवतानि।\nआसन्समेतानि सहाप्सरोभि--\nनिरीक्षतीभिर्युधि वीरसङ्घान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2061778, "chapter_id": 2319, "verse_number": "८-४०-१३", "content_sanskrit": "दिव्यैश्च गन्धैः परमैश्च पुष्पै--\nरन्यैश्च रत्नैर्विविधैर्नराग्र्याः।\nरणेषु कर्मोद्वहताः प्रहृष्टा-\nननन्दयन्नप्सरसः प्रहृष्टाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2061779, "chapter_id": 2319, "verse_number": "८-४०-१४", "content_sanskrit": "समीरणस्तांस्तु निषेव्य गन्धा--\nन्निषेवते तानपि योधमुख्यान्।\nनिषेव्यमाणास्त्वनिलेन योधाः\nपरस्परं चुक्रुशुराजिमध्ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2061780, "chapter_id": 2319, "verse_number": "८-४०-१५", "content_sanskrit": "तथा तु तस्मिंस्तुमुले प्रवृत्ते\nदुर्योधनः क्रोधममृष्यमाणः।\n`अवेभ्य भीमं बलमध्यसंस्थः\nसमार्पयत्क्षुद्रकाणां शतेन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2061781, "chapter_id": 2319, "verse_number": "८-४०-१६", "content_sanskrit": "दुःशासनश्चित्रसेनश्च वीर--\nस्तथोलूकः कितवः सौबलश्च।\nगजानीकैः सर्वतो भीमसेनं\nतथाविषक्तं सहसैवाभ्यगच्छन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2061782, "chapter_id": 2319, "verse_number": "८-४०-१७", "content_sanskrit": "तमापतन्तं सम्प्रेक्ष्य गजानीकं वृकोदरः।\nदुर्योधनं महाबाहुः शरवर्षैरवाकिरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2061783, "chapter_id": 2319, "verse_number": "८-४०-१८", "content_sanskrit": "दुर्योधनं ततो भीमः सायकैर्वज्रसन्निभैः।\nपाण्डवो विमुखीकृत्य गजानभ्यद्रवद्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2061784, "chapter_id": 2319, "verse_number": "८-४०-१९", "content_sanskrit": "ततः पावकसङ्काशैर्भीमबाणैरवक्रगैः।\nशलभैरिव नागांस्तानर्दयामास पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2061785, "chapter_id": 2319, "verse_number": "८-४०-२०", "content_sanskrit": "ततः कुञ्जरयूथानि भीमसेनो महाबलः।\nव्यधमन्निशितैर्बाणैर्महावातो घनानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2061786, "chapter_id": 2319, "verse_number": "८-४०-२१", "content_sanskrit": "नित्यमत्ताश्च मातङ्गाः शूरैर्मत्तैरधिष्ठिताः।\nआरोहकैर्महामात्रैस्तोमराङ्कुरापाणिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2061787, "chapter_id": 2319, "verse_number": "८-४०-२२", "content_sanskrit": "सुवर्णजालैः प्रच्छन्ना मणिजालैश्च कुञ्जराः।\nरूप्यजाम्बूनदाभासः क्षुरमालाभ्यलङ्कृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2061788, "chapter_id": 2319, "verse_number": "८-४०-२३", "content_sanskrit": "वध्यमानाः शरै राजन्भीमसेनेन ते गजाः।\nविभिन्नहृदयाः केचित्तत्रैवाभ्यपतन्भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2061789, "chapter_id": 2319, "verse_number": "८-४०-२४", "content_sanskrit": "निपतद्भिर्महावेगैर्हेमभाण्डविभूषितैः।\nअशोभत महाराज धातुचित्रैरिवाचलैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2061790, "chapter_id": 2319, "verse_number": "८-४०-२५", "content_sanskrit": "दीप्ताभरणवद्भिश्च गजपृष्ठनिपातितैः।\nसङ्गरः शुशुभे राजन्क्षीणपुण्यैरिवामरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2061791, "chapter_id": 2319, "verse_number": "८-४०-२६", "content_sanskrit": "महापरिघसङ्काशौ चन्दनागरुरूषितौ।\nअपश्यं भीमसेनस्य धनुर्विक्षिपतो भुजौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2061792, "chapter_id": 2319, "verse_number": "८-४०-२७", "content_sanskrit": "तस्य ज्यातलनिर्घोषमस्यतः सव्यदक्षिणम्।\nतं श्रुत्वाऽभ्यद्रवन्नागा भीमसेनभयार्दिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2061793, "chapter_id": 2319, "verse_number": "८-४०-२८", "content_sanskrit": "तस्य भीमस्य तत्कर्म राजन्नेकस्य धीमतः।\nअपश्याम महाराज तद्भूतमिवाभवत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2061794, "chapter_id": 2319, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तदशदिवसयुद्धे चत्वारिंशोऽध्यायः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]