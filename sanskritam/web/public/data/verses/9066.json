[{"id": 5000066000, "chapter_id": 9066, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे षट्षष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000066001, "chapter_id": 9066, "verse_number": "१-६६-१", "content_sanskrit": "ततः प्रभाते विमले कृतकर्मा नराधिपः।\nविश्वामित्रं महात्मानमाजुहाव सराघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000066002, "chapter_id": 9066, "verse_number": "१-६६-२", "content_sanskrit": "तमर्चयित्वा धर्मात्मा शास्त्रदृष्टेन कर्मणा।\nराघवौ च महात्मानौ तदा वाक्यमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000066003, "chapter_id": 9066, "verse_number": "१-६६-३", "content_sanskrit": "भगवन् स्वागतं तेऽस्तु किं करोमि तवानघ।\nभवानाज्ञापयतु मामाज्ञाप्यो भवता ह्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000066004, "chapter_id": 9066, "verse_number": "१-६६-४", "content_sanskrit": "एवमुक्तः स धर्मात्मा जनकेन महात्मना।\nप्रत्युवाच मुनिश्रेष्ठो वाक्यं वाक्यविशारदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000066005, "chapter_id": 9066, "verse_number": "१-६६-५", "content_sanskrit": "पुत्रौ दशरथस्येमौ क्षत्रियौ लोकविश्रुतौ।\nद्रष्टुकामौ धनुःश्रेष्ठं यदेतत्त्वयि तिष्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000066006, "chapter_id": 9066, "verse_number": "१-६६-६", "content_sanskrit": "एतद् दर्शय भद्रं ते कृतकामौ नृपात्मजौ।\nदर्शनादस्य धनुषो यथेष्टं प्रतियास्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000066007, "chapter_id": 9066, "verse_number": "१-६६-७", "content_sanskrit": "एवमुक्तस्तु जनकः प्रत्युवाच महामुनिम्।\nश्रूयतामस्य धनुषो यदर्थमिह तिष्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000066008, "chapter_id": 9066, "verse_number": "१-६६-८", "content_sanskrit": "देवरात इति ख्यातो निमेर्ज्येष्ठो महीपतिः।\nन्यासोऽयं तस्य भगवन् हस्ते दत्तो महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000066009, "chapter_id": 9066, "verse_number": "१-६६-९", "content_sanskrit": "दक्षयज्ञवधे पूर्वं धनुरायम्य वीर्यवान्।\nविध्वंस्य त्रिदशान् रोषात् सलीलमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000066010, "chapter_id": 9066, "verse_number": "१-६६-१०", "content_sanskrit": "यस्माद् भागार्थिनो भागं नाकल्पयत मे सुराः।\nवरांगानि महार्हाणि धनुषा शातयामि वः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000066011, "chapter_id": 9066, "verse_number": "१-६६-११", "content_sanskrit": "ततो विमनसः सर्वे देवा वै मुनिपुंगव।\nप्रसादयन्त देवेशं तेषां प्रीतोऽभवद् भवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000066012, "chapter_id": 9066, "verse_number": "१-६६-१२", "content_sanskrit": "प्रीतियुक्तस्तु सर्वेषां ददौ तेषां महात्मनाम्।\nतदेतद् देवदेवस्य धनूरत्नं महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000066013, "chapter_id": 9066, "verse_number": "१-६६-१३", "content_sanskrit": "न्यासभूतं तदा न्यस्तमस्माकं पूर्वजे विभौ।\nअथ मे कृषतः क्षेत्रं लांगलादुत्थिता ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000066014, "chapter_id": 9066, "verse_number": "१-६६-१४", "content_sanskrit": "क्षेत्रं शोधयता लब्धा नाम्ना सीतेति विश्रुता।\nभूतलादुत्थिता सा तु व्यवर्धत ममात्मजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000066015, "chapter_id": 9066, "verse_number": "१-६६-१५", "content_sanskrit": "वीर्यशुल्केति मे कन्या स्थापितेयमयोनिजा।\nभूतलादुत्थितां तां तु वर्धमानां ममात्मजाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000066016, "chapter_id": 9066, "verse_number": "१-६६-१६", "content_sanskrit": "वरयामासुरागत्य राजानो मुनिपुंगव।\nतेषां वरयतां कन्यां सर्वेषां पृथिवीक्षिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000066017, "chapter_id": 9066, "verse_number": "१-६६-१७", "content_sanskrit": "वीर्यशुल्केति भगवन् न ददामि सुतामहम्।\nततः सर्वे नृपतयः समेत्य मुनिपुंगव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000066018, "chapter_id": 9066, "verse_number": "१-६६-१८", "content_sanskrit": "मिथिलामप्युपागम्य वीर्यं जिज्ञासवस्तदा।\nतेषां जिज्ञासमानानां शैवं धनुरुपाहृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000066019, "chapter_id": 9066, "verse_number": "१-६६-१९", "content_sanskrit": "न शेकुर्ग्रहणे तस्य धनुषस्तोलनेऽपि वा।\nतेषां वीर्यवतां वीर्यमल्पं ज्ञात्वा महामुने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000066020, "chapter_id": 9066, "verse_number": "१-६६-२०", "content_sanskrit": "प्रत्याख्याता नृपतयस्तन्निबोध तपोधन।\nततः परमकोपेन राजानो मुनिपुंगव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000066021, "chapter_id": 9066, "verse_number": "१-६६-२१", "content_sanskrit": "अरुन्धन् मिथिलां सर्वे वीर्यसंदेहमागताः।\nआत्मानमवधूतं मे विज्ञाय नृपपुंगवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000066022, "chapter_id": 9066, "verse_number": "१-६६-२२", "content_sanskrit": "रोषेण महताविष्टाः पीडयन् मिथिलां पुरीम्।\nततः संवत्सरे पूर्णे क्षयं यातानि सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000066023, "chapter_id": 9066, "verse_number": "१-६६-२३", "content_sanskrit": "साधनानि मुनिश्रेष्ठ ततोऽहं भृशदुःखितः।\nततो देवगणान् सर्वांस्तपसाहं प्रसादयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000066024, "chapter_id": 9066, "verse_number": "१-६६-२४", "content_sanskrit": "ददुश्च परमप्रीताश्चतुरंगबलं सुराः।\nततो भग्ना नृपतयो हन्यमाना दिशो ययुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000066025, "chapter_id": 9066, "verse_number": "१-६६-२५", "content_sanskrit": "अवीर्या वीर्यसंदिग्धाः सामात्याः पापकारिणः।\nतदेतन्मुनिशार्दूल धनुः परमभास्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000066026, "chapter_id": 9066, "verse_number": "१-६६-२६", "content_sanskrit": "रामलक्ष्मणयोश्चापि दर्शयिष्यामि सुव्रत।\nयद्यस्य धनुषो रामः कुर्यादारोपणं मुने।\nसुतामयोनिजां सीतां दद्यां दाशरथेरहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000066027, "chapter_id": 9066, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे षट्षष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]