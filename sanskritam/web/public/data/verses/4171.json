[{"id": 2146891, "chapter_id": 4171, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2146892, "chapter_id": 4171, "verse_number": "१", "content_sanskrit": "इयं भोगवती नाम पुरी वासुकिपालिता ।\nयादृशी देवराजस्य पुरी वर्याऽमरावती\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2146893, "chapter_id": 4171, "verse_number": "२", "content_sanskrit": "एष शेषः स्थितो नागो येनेदं धार्यते सदा ।\nतपसा लोकमुख्येन प्रभावमहिता मही\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2146894, "chapter_id": 4171, "verse_number": "३", "content_sanskrit": "श्वेतोच्चयनिभाकारो नानाविधविभूषणः ।\nसहस्रं धारयन् मूर्ध्ना ज्वालाजिह्वो महाबलः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2146895, "chapter_id": 4171, "verse_number": "४", "content_sanskrit": "इह नानाविधाकारा नानाविधविभूषणाः ।\nकाश्यपस्य सुता नागा निवसन्ति गतव्यथाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2146896, "chapter_id": 4171, "verse_number": "५", "content_sanskrit": "मणिस्वस्तिकचक्राङ्ककमण्डलुकलक्षणाः ।\nसहस्रसङ्ख्या बलिनः सर्वे रौद्राः स्वभावतः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2146897, "chapter_id": 4171, "verse_number": "६", "content_sanskrit": "सहस्रशिरसः केचित् केचित् पञ्चशताननाः ।\nशतशीर्षास्तथा केचित् केचित् त्रिशिरसोऽपि च\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2146898, "chapter_id": 4171, "verse_number": "७", "content_sanskrit": "त्रिपञ्चशिरसः केचित् केचित् सप्तमुखास्तथा ।\nमहाबला महाकायाः पन्नगा भोगभोगिनः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2146899, "chapter_id": 4171, "verse_number": "८", "content_sanskrit": "बहूनीह सहस्राणि प्रयुतान्यर्बुदानि च ।\nनागानामेकवंशानां यथाश्रेष्ठं तु मे शृणु\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2146900, "chapter_id": 4171, "verse_number": "९", "content_sanskrit": "वासुकिस्तक्षकश्चैव कार्कोटकधनञ्जयौ ।\nकालीयो नहुषश्चैव कम्बलाश्वतरावुभौ\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2146901, "chapter_id": 4171, "verse_number": "१०", "content_sanskrit": "बाह्यकुण्डो मणिर्नागः तथैवापूरणः खगः ।\nवामनश्चैलपत्रश्च कुकुरः कुकुणस्तथा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2146902, "chapter_id": 4171, "verse_number": "११", "content_sanskrit": "आर्यको नन्दकश्चैव तथा शलकपोतकौ ।\nकैलासकः पिञ्जरको नागश्चैरावतस्तथा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2146903, "chapter_id": 4171, "verse_number": "१२", "content_sanskrit": "सुदामनो दधिमुखः शङ्खो नन्दोपनन्दकौ ।\nआप्तः कोटरकश्चैव शिखण्डी निष्ठुरस्तथा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2146904, "chapter_id": 4171, "verse_number": "१३", "content_sanskrit": "तित्तिरिर्हस्तिभद्रश्च कुमुदो माल्यपिण्डकः ।\nद्वौ पद्मौ पुण्डरीकश्च पुष्पो मुद्गरपर्णकः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2146905, "chapter_id": 4171, "verse_number": "१४", "content_sanskrit": "करवीरः पीठकरः संवृत्तो वृत्त एव च ।\nपिण्डारो बिल्वपत्रश्च मूषिकादः शिरीषकः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2146906, "chapter_id": 4171, "verse_number": "१५", "content_sanskrit": "दिलीपः शङ्खशीर्षश्च ज्योतिष्कोऽथापराजितः ।\nकौरव्यो धृतराष्ट्रश्च कुहकः कुशकस्तथा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2146907, "chapter_id": 4171, "verse_number": "१६", "content_sanskrit": "विरजा धारणश्चैव सुबाहुर्मुखरो जयः ।\nबधिरश्च विकुण्डश्च विरथः सुरथस्तथा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2146908, "chapter_id": 4171, "verse_number": "१७", "content_sanskrit": "एते चान्ये च बहवः काश्यपस्यात्मजाः स्मृताः ।\nमातले पश्य यद्यत्र कश्चित् ते रोचते वरः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2146909, "chapter_id": 4171, "verse_number": "", "content_sanskrit": "कण्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2146910, "chapter_id": 4171, "verse_number": "१८", "content_sanskrit": "मातलिस्त्वेवमव्यग्रः सततं सन्निरीक्ष्य वै ।\nपप्रच्छ नारदं तत्र प्रीतिमानिव चाभवत्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2146911, "chapter_id": 4171, "verse_number": "", "content_sanskrit": "मातलिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2146912, "chapter_id": 4171, "verse_number": "१९", "content_sanskrit": "स्थितो य एष पुरतः कौरव्यस्यार्यकस्य तु ।\nद्युतिमान् दर्शनीयश्च कस्यैष कुलनन्दनः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2146913, "chapter_id": 4171, "verse_number": "२०", "content_sanskrit": "कः पिता जननी चास्य कतमस्यैष भोगिनः ।\nवंशस्य कस्यैष महान् केतुभूत इव स्थितः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2146914, "chapter_id": 4171, "verse_number": "२१", "content_sanskrit": "प्रणिधानेन धैर्येण रूपेण वयसा च मे ।\nमनः प्रविष्टो देवर्षे गुणकेश्याः पतिर्वरः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2146915, "chapter_id": 4171, "verse_number": "", "content_sanskrit": "कण्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2146916, "chapter_id": 4171, "verse_number": "२२", "content_sanskrit": "मातलिं प्रीतमनसं दृष्ट्वा सुमुखदर्शनात् ।\nनिवेदयामास तदा माहात्म्यं जन्म कर्म च\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2146917, "chapter_id": 4171, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2146918, "chapter_id": 4171, "verse_number": "२३", "content_sanskrit": "ऐरावतकुले जातः सुमुखो नाम नागराट् ।\nआर्यकस्य मतः पौत्रो दौहित्रो मेनकस्य च\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2146919, "chapter_id": 4171, "verse_number": "२४", "content_sanskrit": "एतस्य हि पिता नागः चिकुरो नाम मातले ।\nनचिराद् वैनतेयेन पञ्चत्वमुपपादितः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2146920, "chapter_id": 4171, "verse_number": "", "content_sanskrit": "कण्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2146921, "chapter_id": 4171, "verse_number": "२५", "content_sanskrit": "ततोऽब्रवीत् प्रीतमना मातलिर्नारदं वचः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2146922, "chapter_id": 4171, "verse_number": "२६", "content_sanskrit": "एष मे रुचिरस्तात जामाता भुजगोत्तमः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2146923, "chapter_id": 4171, "verse_number": "२७", "content_sanskrit": "क्रियतामत्र यत्नो हि प्रीतिमानस्म्यनेन वै ।\nअस्य नागपतेर्दातुं प्रियां दुहितरं मुने\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2146924, "chapter_id": 4171, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि द्व्यधिकशततमोऽध्यायः ॥१०२॥\nभगवद्यानपर्वणि त्रयस्त्रिंशोऽध्यायः ॥३३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]