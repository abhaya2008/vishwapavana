[{"id": 2010966, "chapter_id": 1224, "verse_number": "१-२२५-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2010967, "chapter_id": 1224, "verse_number": "१-२२५-१", "content_sanskrit": "भीष्मः शान्तनवो विद्वान्द्रोणश्च भगवानृषिः।\nहितं च परमं सत्यमब्रूतां वाक्यमुत्तमम्।\nहितं च परमं वाक्यं त्वं च सत्यं ब्रवीषि माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2010968, "chapter_id": 1224, "verse_number": "१-२२५-२", "content_sanskrit": "यथैव पाण्डोस्ते वीराः कुन्तीपुत्रा महारथाः।\nतथैव धर्मतः सर्वे मम पुत्रा न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2010969, "chapter_id": 1224, "verse_number": "१-२२५-३", "content_sanskrit": "यथैव मम पुत्राणामिदं राज्यं विधीयते।\nतथैव पाण्डुपुत्राणामिदं राज्यं न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2010970, "chapter_id": 1224, "verse_number": "१-२२५-४", "content_sanskrit": "क्षत्तरानय गच्छैतान्सह मात्रा सुसत्कृतान्।\nतया च देवरूपिण्या कृष्णया सह भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2010971, "chapter_id": 1224, "verse_number": "१-२२५-५", "content_sanskrit": "दिष्ट्या जीवन्ति ते पार्था दिष्ट्या जीवति सा पृथा।\nदिष्ट्या द्रुपदकन्यां च लब्धवन्तो महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2010972, "chapter_id": 1224, "verse_number": "१-२२५-६", "content_sanskrit": "दिष्ट्या वर्धामहे सर्वे दिष्ट्या शान्तः पुरोचनः।\nदिष्ट्या मम परं दुःखमपनीतं महाद्युते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2010973, "chapter_id": 1224, "verse_number": "१-२२५-७", "content_sanskrit": "त्वमेव गत्वा विदुर तानिहानय मा चिरम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2010974, "chapter_id": 1224, "verse_number": "१-२२५-७x", "content_sanskrit": "वैशम्पायन उवाच।\nएवमुक्तस्ततः क्षत्ता रथमारुह्य शीघ्रगम्।\nआगात्कतिपयाहोभिः पाञ्चालान्राजधर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2010975, "chapter_id": 1224, "verse_number": "१-२२५-८", "content_sanskrit": "ततो जगाम विदुरो धृतराष्ट्रस्य शासनात्।\nसकाशं यज्ञसेनस्य पाण्डवानां च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2010976, "chapter_id": 1224, "verse_number": "१-२२५-९", "content_sanskrit": "समुपादाय रत्नानि वसूनि विविधानि च।\nद्रौपद्याः पाण्डवानां च यज्ञसेनस्य चैव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2010977, "chapter_id": 1224, "verse_number": "१-२२५-१०", "content_sanskrit": "तत्र गत्वा स धर्मज्ञः सर्वशास्त्रविशारदः।\nद्रुपदं न्यायतो राजन्संयुक्तमुपतस्थिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2010978, "chapter_id": 1224, "verse_number": "१-२२५-११", "content_sanskrit": "स चापि प्रतिजग्राह धर्मेण विदुरं ततः।\nचक्रतुश्च यथान्यायं कुशलप्रश्नसंविदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2010979, "chapter_id": 1224, "verse_number": "१-२२५-१२", "content_sanskrit": "ददर्श पाण्डवांस्तत्र वासुदेवं च भारत।\nस्नेहात्परिष्वज्य स तान्पप्रच्छानामयं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2010980, "chapter_id": 1224, "verse_number": "१-२२५-१३", "content_sanskrit": "तैश्चाप्यमितबुद्दिः स पूजितो हि यथाक्रमम्।\nवचनाद्धृतराष्ट्रस्य स्नेहयुक्तं पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2010981, "chapter_id": 1224, "verse_number": "१-२२५-१४", "content_sanskrit": "पप्रच्छानामयं राजंस्ततस्तान्पाण्डुनन्दनान्।\nप्रददौ चापि रत्नानि विविधानि वसूनि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2010982, "chapter_id": 1224, "verse_number": "१-२२५-१५", "content_sanskrit": "पाण्डवानां च कुन्त्याश्च द्रौपद्याश्च विशांपते।\nद्रुपदस्य च पुत्राणां यथा दत्तानि कौरवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2010983, "chapter_id": 1224, "verse_number": "१-२२५-१६", "content_sanskrit": "प्रोवाच चामितमतिः प्रश्रितं विनयान्वितः।\nद्रुपदं पाण्डुपुत्राणां सन्निधौ केशवस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2010984, "chapter_id": 1224, "verse_number": "१-२२५-१७x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2010985, "chapter_id": 1224, "verse_number": "१-२२५-१७", "content_sanskrit": "राजञ्छृणु सहामात्यः सपुत्रश्च वचो मम।\nधृतराष्ट्रः सपुत्रस्त्वां सहामात्यः सबान्धवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2010986, "chapter_id": 1224, "verse_number": "१-२२५-१८", "content_sanskrit": "अब्रवीत्कुशलं राजन्प्रीयमाणः पुनःपुनः।\nप्रीतिमांस्ते दृढं चापि संबन्धेन नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2010987, "chapter_id": 1224, "verse_number": "१-२२५-१९", "content_sanskrit": "तथा भीष्मः शान्तनवः कौरवैः सह सर्वशः।\nकुशलं त्वां महाप्राज्ञः सर्वतः परिपृच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2010988, "chapter_id": 1224, "verse_number": "१-२२५-२०", "content_sanskrit": "भारद्वाजो महाप्राज्ञो द्रोणः प्रियसखस्तव।\nसमाश्लेषमुपेत्य त्वां कुशलं परिपृच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2010989, "chapter_id": 1224, "verse_number": "१-२२५-२१", "content_sanskrit": "धृतराष्ट्रश्च पाञ्चाल्य त्वया संबन्धमेयिवान्।\nकृतार्थं मन्यतेत्मानं तथा सर्वेऽपि कौरवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2010990, "chapter_id": 1224, "verse_number": "१-२२५-२२", "content_sanskrit": "न तथा राज्यसंप्राप्तिस्तेषां प्रीतिकरी मता।\nयथा संबन्धकं प्राप्य यज्ञसेन त्वया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2010991, "chapter_id": 1224, "verse_number": "१-२२५-२३", "content_sanskrit": "एतद्विदित्वा तु भवान्प्रस्थापयतु पाण्डवान्।\nद्रष्टुं हि पाण्डुपुत्रांश्च त्वरन्ति कुरवो भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2010992, "chapter_id": 1224, "verse_number": "१-२२५-२४", "content_sanskrit": "विप्रोषिता दीर्घकालमेते चापि नरर्षभाः।\nउत्सुका नगरं द्रष्टुं भविष्यन्ति तथा पृथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2010993, "chapter_id": 1224, "verse_number": "१-२२५-२५", "content_sanskrit": "कृष्णामपि च पाञ्चालीं सर्वाः कुरुवरस्त्रियः।\nद्रष्टुकामाः प्रतीक्ष्ते पुरं च विषयाश्च नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2010994, "chapter_id": 1224, "verse_number": "१-२२५-२६", "content_sanskrit": "स भवान्पाण्डुपुत्राणामाज्ञापयतु मा चिरम्।\nगमनं सहदाराणामेतदत्र मतं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2010995, "chapter_id": 1224, "verse_number": "१-२२५-२७", "content_sanskrit": "निसृष्टेषु त्वया राजन्पाण्डवेषु महात्मसु।\nततोऽहं प्रेषयिष्यामि धृतराष्ट्रस्य शीघ्रगान्।\nआगमिष्यन्ति कौन्तेयाः कुन्ती च सह कृष्णया॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2010996, "chapter_id": 1224, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि विदुरागमनराज्यलाभपर्वणि पञ्चविंशत्यधिकद्विशततमोऽध्यायः॥ २२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]