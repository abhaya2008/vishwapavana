[{"id": 2004147, "chapter_id": 1080, "verse_number": "१-८१-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2004148, "chapter_id": 1080, "verse_number": "१-८१-१", "content_sanskrit": "स्वर्गतः स तु राजेन्द्रो निवसन्देववेश्मनि।\nपूजितस्त्रिदशैः साध्यैर्मरुद्भिर्वसुभिस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2004149, "chapter_id": 1080, "verse_number": "१-८१-२", "content_sanskrit": "देवलोकं ब्रह्मलोकं संचरन्पुण्यकृद्वशी।\nअवसत्पृथिवीपालो दीर्घकालमिति श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2004150, "chapter_id": 1080, "verse_number": "१-८१-३", "content_sanskrit": "स कदाचिन्नृपश्रेष्ठो ययातिः शक्रमागमत्।\nकथान्ते तत्र शक्रेण स पृष्टः पृथिवीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2004151, "chapter_id": 1080, "verse_number": "१-८१-४x", "content_sanskrit": "शक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2004152, "chapter_id": 1080, "verse_number": "१-८१-४", "content_sanskrit": "यदा स पूरुस्तव रूपेण राज-\nञ्जरां गृहीत्वा प्रचचार भूमौ।\nतदा च राज्यं संप्रदायैव तस्मै\nत्वया किमुक्तः कथयेह सत्यम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2004153, "chapter_id": 1080, "verse_number": "१-८१-५x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2004154, "chapter_id": 1080, "verse_number": "१-८१-५", "content_sanskrit": "गङ्गायमुनयोर्मध्ये कृत्स्नोयं विषयस्तव।\nमध्ये पृथिव्यास्त्वं राजा भ्रातरोऽन्त्याधिपास्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2004155, "chapter_id": 1080, "verse_number": "१-८१-६", "content_sanskrit": "न च कुर्यान्नरो दैन्यं शाठ्यं क्रोधं तथैव च।\nजैहयं च मत्सरं वैरं सर्वत्रेदं न कारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2004156, "chapter_id": 1080, "verse_number": "१-८१-७", "content_sanskrit": "मातरं पितरं ज्येष्ठं विद्वांसं च तपोधनम्।\nक्षमावन्तं च राजेन्द्र नावमन्येत बुद्धिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2004157, "chapter_id": 1080, "verse_number": "१-८१-८", "content_sanskrit": "ळशक्तस्तु क्षमते नित्यमशक्तः क्रुध्यते नरः।\nदुर्जनः सुजनं द्वेष्टि दुर्बलो बलवत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2004158, "chapter_id": 1080, "verse_number": "१-८१-९", "content_sanskrit": "रूपवन्तमरूपी च धनवन्तं च निर्धनः।\nअकर्मी कर्मिणं द्वेष्टि धार्मिकं च नधार्मिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2004159, "chapter_id": 1080, "verse_number": "१-८१-१०", "content_sanskrit": "निर्गुणो गुणवन्तं च पुत्रैतत्कलिलक्षणम्।\nविपरीतं च राजेन्द्र एतेषु कृतलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2004160, "chapter_id": 1080, "verse_number": "१-८१-११", "content_sanskrit": "ब्राह्मणो वाथ वा राजा वैश्यो वा शूद्र एव वा।\nप्रशस्तेषु प्रसक्ताश्चेत्प्रशस्यन्ते यशस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2004161, "chapter_id": 1080, "verse_number": "१-८१-१२", "content_sanskrit": "तस्मात्प्रशस्ते राजेन्द्र नरः सक्तमना भवेत्।\nअलोकज्ञा ह्यप्रशस्ता भ्रातरस्ते ह्यबुद्धयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2004162, "chapter_id": 1080, "verse_number": "१-८१-१३", "content_sanskrit": "अन्त्याधिपतयः सर्वे ह्यभवन्गुरुशासनात्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2004163, "chapter_id": 1080, "verse_number": "१-८१-१३x", "content_sanskrit": "इन्द्र उवाच।\nत्वं हि धर्मविदो राजन्कत्थसे धर्मसुत्तमम्।\nकथयस्व पुनर्मेऽद्य लोकवृत्तान्तमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2004164, "chapter_id": 1080, "verse_number": "१-८१-१४x", "content_sanskrit": "ययातिरुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2004165, "chapter_id": 1080, "verse_number": "१-८१-१४", "content_sanskrit": "अक्रोधनः क्रोधनेभ्यो विशिष्ट-\nस्तथा तितिक्षुरतितिक्षोर्विशिष्टः।\nअमानुषेभ्यो मानुषाश्च प्रधाना\nविद्वांस्तथैवाविदुषः प्रधानः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2004166, "chapter_id": 1080, "verse_number": "१-८१-१५", "content_sanskrit": "आक्रुश्यमानो नाकोशेन्मन्युरेव तितिक्षतः।\nआक्रोष्टारं निर्दहति सुकृतं चास्य विन्दति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2004167, "chapter_id": 1080, "verse_number": "१-८१-१६", "content_sanskrit": "नारुन्तुदः स्यान्न नृशंसवादी\nन हीनतः परमभ्याददीत।\nययाऽस्य वाचा पर उद्विजेत\nन तां वदेद्रुशतीं पापलोक्याम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2004168, "chapter_id": 1080, "verse_number": "१-८१-१७", "content_sanskrit": "अरुन्तुदं पुरुषं तीक्ष्णवाचं\nवाक्कण्टकैर्वितुदन्तं मनुष्यन्।\nविद्यादलक्ष्मीकतमं जनानां\nमुखे निबद्धां निर्ऋतिं वहन्तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2004169, "chapter_id": 1080, "verse_number": "१-८१-१८", "content_sanskrit": "सद्भिः पुरस्तादभिपूजितः स्या-\nत्सद्भिस्तथा पृष्ठतो रक्षितः स्यात्।\nसदाऽसतामतिवादांस्तितिक्षे-\nत्सतां वृत्तं चाददीतार्यवृत्तः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2004170, "chapter_id": 1080, "verse_number": "१-८१-१९", "content_sanskrit": "वाक्सायका वदनान्निष्पतन्ति\nयैराहतः शोचति रात्र्यहानि।\nपरस्य ये मर्मसु संपतन्ति\nतान्पण्डितो नावसृजेत्परेषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2004171, "chapter_id": 1080, "verse_number": "१-८१-२०", "content_sanskrit": "नहीदृशं संवननं त्रिषु लोकेषु विद्यते।\nदया मैत्री च भूतेषु दानं च मधुरा च वाक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2004172, "chapter_id": 1080, "verse_number": "१-८१-२१", "content_sanskrit": "तस्मात्सान्त्वं सदा वाच्यं न वाच्यं परुषं क्वचित्।\nपूज्यान्संपूजयेद्दद्यान्न च याचेत्कदाचन॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2004173, "chapter_id": 1080, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि एकाशीतितमोऽध्यायः॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]