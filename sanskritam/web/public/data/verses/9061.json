[{"id": 5000061000, "chapter_id": 9061, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे एकषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000061001, "chapter_id": 9061, "verse_number": "१-६१-१", "content_sanskrit": "विश्वामित्रो महातेजाः प्रस्थितान् वीक्ष्य तानृषीन्।\nअब्रवीन्नरशार्दूल सर्वांस्तान् वनवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000061002, "chapter_id": 9061, "verse_number": "१-६१-२", "content_sanskrit": "महाविघ्नः प्रवृत्तोऽयं दक्षिणामास्थितो दिशम्।\nदिशमन्यां प्रपत्स्यामस्तत्र तप्स्यामहे तपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000061003, "chapter_id": 9061, "verse_number": "१-६१-३", "content_sanskrit": "पश्चिमायां विशालायां पुष्करेषु महात्मनः।\nसुखं तपश्चरिष्यामः सुखं तद्धि तपोवनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000061004, "chapter_id": 9061, "verse_number": "१-६१-४", "content_sanskrit": "एवमुक्त्वा महातेजाः पुष्करेषु महामुनिः।\nतप उग्रं दुराधर्षं तेपे मूलफलाशनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000061005, "chapter_id": 9061, "verse_number": "१-६१-५", "content_sanskrit": "एतस्मिन्नेव काले तु अयोध्याधिपतिर्महान्।\nअम्बरीष इति ख्यातो यष्टुं समुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000061006, "chapter_id": 9061, "verse_number": "१-६१-६", "content_sanskrit": "तस्य वै यजमानस्य पशुमिन्द्रो जहार ह।\nप्रणष्टे तु पशौ विप्रो राजानमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000061007, "chapter_id": 9061, "verse_number": "१-६१-७", "content_sanskrit": "पशुरभ्याहृतो राजन् प्रणष्टस्तव दुर्नयात्।\nअरक्षितारं राजानं घ्नन्ति दोषा नरेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000061008, "chapter_id": 9061, "verse_number": "१-६१-८", "content_sanskrit": "प्रायश्चित्तं महद्ध्येतन्नरं वा पुरुषर्षभ।\nआनयस्व पशुं शीघ्रं यावत् कर्म प्रवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000061009, "chapter_id": 9061, "verse_number": "१-६१-९", "content_sanskrit": "उपाध्यायवचः श्रुत्वा स राजा पुरुषर्षभः।\nअन्वियेष महाबुद्धिः पशुं गोभिः सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000061010, "chapter_id": 9061, "verse_number": "१-६१-१०", "content_sanskrit": "देशाञ्जनपदांस्तांस्तान् नगराणि वनानि च।\nआश्रमाणि च पुण्यानि मार्गमाणो महीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000061011, "chapter_id": 9061, "verse_number": "१-६१-११", "content_sanskrit": "स पुत्रसहितं तात सभार्यं रघुनन्दन।\nभृगुतुंगे समासीनमृचीकं संददर्श ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000061012, "chapter_id": 9061, "verse_number": "१-६१-१२", "content_sanskrit": "तमुवाच महातेजाः प्रणम्याभिप्रसाद्य च।\nमहर्षिं तपसा दीप्तं राजर्षिरमितप्रभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000061013, "chapter_id": 9061, "verse_number": "१-६१-१३", "content_sanskrit": "पृष्ट्वा सर्वत्र कुशलमृचीकं तमिदं वचः।\nगवां शतसहस्रेण विक्रीणीषे सुतं यदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000061014, "chapter_id": 9061, "verse_number": "१-६१-१४", "content_sanskrit": "पशोरर्थे महाभाग कृतकृत्योऽस्मि भार्गव।\nसर्वे परिगता देशा यज्ञियं न लभे पशुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000061015, "chapter_id": 9061, "verse_number": "१-६१-१५", "content_sanskrit": "दातुमर्हसि मूल्येन सुतमेकमितो मम।\nएवमुक्तो महातेजा ऋचीकस्त्वब्रवीद् वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000061016, "chapter_id": 9061, "verse_number": "१-६१-१६", "content_sanskrit": "नाहं ज्येष्ठं नरश्रेष्ठ विक्रीणीयां कथंचन।\nऋचीकस्य वचः श्रुत्वा तेषां माता महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000061017, "chapter_id": 9061, "verse_number": "१-६१-१७", "content_sanskrit": "उवाच नरशार्दूलमम्बरीषमिदं वचः।\nअविक्रेयं सुतं ज्येष्ठं भगवानाह भार्गवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000061018, "chapter_id": 9061, "verse_number": "१-६१-१८", "content_sanskrit": "ममापि दयितं विद्धि कनिष्ठं शुनकं प्रभो।\nतस्मात् कनीयसं पुत्रं न दास्ये तव पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000061019, "chapter_id": 9061, "verse_number": "१-६१-१९", "content_sanskrit": "प्रायेण हि नरश्रेष्ठ ज्येष्ठाः पितृषु वल्लभाः।\nमातॄणां च कनीयांसस्तस्माद् रक्ष्ये कनीयसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000061020, "chapter_id": 9061, "verse_number": "१-६१-२०", "content_sanskrit": "उक्तवाक्ये मुनौ तस्मिन् मुनिपत्न्यां तथैव च।\nशुनःशेपः स्वयं राम मध्यमो वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000061021, "chapter_id": 9061, "verse_number": "१-६१-२१", "content_sanskrit": "पिता ज्येष्ठमविक्रेयं माता चाह कनीयसम्।\nविक्रेयं मध्यमं मन्ये राजपुत्र नयस्व माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000061022, "chapter_id": 9061, "verse_number": "१-६१-२२", "content_sanskrit": "अथ राजा महाबाहो वाक्यान्ते ब्रह्मवादिनः।\nहिरण्यस्य सुवर्णस्य कोटिभी रत्नराशिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000061023, "chapter_id": 9061, "verse_number": "१-६१-२३", "content_sanskrit": "गवां शतसहस्रेण शुनःशेपं नरेश्वरः।\nगृहीत्वा परमप्रीतो जगाम रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000061024, "chapter_id": 9061, "verse_number": "१-६१-२४", "content_sanskrit": "अम्बरीषस्तु राजर्षी रथमारोप्य सत्वरः।\nशुनःशेपं महातेजा जगामाशु महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000061025, "chapter_id": 9061, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे एकषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]