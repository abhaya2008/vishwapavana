[{"id": 6000334000, "chapter_id": 10334, "verse_number": null, "content_sanskrit": "अथ द्वितीयाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000334001, "chapter_id": 10334, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.001.m4a", "display_order": 2}, {"id": 6000334002, "chapter_id": 10334, "verse_number": "१२-२-१", "content_sanskrit": "ततश्चानुदिनं धर्मः सत्यं शौचं क्षमा दया।\nकालेन बलिना राजन् नङ्‍क्ष्यन्त्यायुर्बलं स्मृतिः॥ १२/२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.002.m4a", "display_order": 3, "topics": [{"text": "कलियुगदोषकथनम्", "range": "१–१६"}]}, {"id": 6000334003, "chapter_id": 10334, "verse_number": "१२-२-२", "content_sanskrit": "वित्तमेव कलौ नॄणां जन्माचारगुणोदयाः।\nधर्मन्यायव्यवस्थायां कारणं बलमेव हि॥ १२/२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.003.m4a", "display_order": 4}, {"id": 6000334004, "chapter_id": 10334, "verse_number": "१२-२-३", "content_sanskrit": "दाम्पत्येऽभिरुचिर्हेतुर्मायैव व्यावहारिके।\nस्त्रीत्वे पुंस्त्वे चातिरतिर्विप्रत्वे सूत्रमेव हि॥ १२/२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.004.m4a", "display_order": 5}, {"id": 6000334005, "chapter_id": 10334, "verse_number": "१२-२-४", "content_sanskrit": "लिङ्गमेवाश्रमख्यातावन्योन्यापत्तिकारणम्।\nअवृत्त्यन्यायदौर्बल्ये पाण्डित्ये चापलं वचः॥ १२/२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.005.m4a", "display_order": 6}, {"id": 6000334006, "chapter_id": 10334, "verse_number": "१२-२-५", "content_sanskrit": "अनाढ्यतैवासाधुत्वे साधुत्वे दम्भ एव तु।\nस्वीकार एव चोद्वाहे स्नानमेव प्रसाधनम्॥ १२/२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.006.m4a", "display_order": 7}, {"id": 6000334007, "chapter_id": 10334, "verse_number": "१२-२-६", "content_sanskrit": "दूरे वार्यटनं तीर्थं लावण्ये केशधारणम्।\nउदरम्भरता स्वार्थः सत्यत्वे धार्ष्ट्यमेव हि॥ १२/२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.007.m4a", "display_order": 8}, {"id": 6000334008, "chapter_id": 10334, "verse_number": "१२-२-७", "content_sanskrit": "दाक्ष्यं कुटुम्बभरणे यशोर्थं धर्मसेवनम्।\nएवं प्रजाभिर्दुष्टाभिराकीर्णे क्षितिमण्डले॥ १२/२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.008.m4a", "display_order": 9}, {"id": 6000334009, "chapter_id": 10334, "verse_number": "१२-२-८", "content_sanskrit": "ब्रह्मविट्क्षत्रशूद्राणां यो बली भविता नृपः।\nप्रजा हि लुब्धै राजन्यैर्निर्घृणैर्दस्युधर्मभिः॥ १२/२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.009.m4a", "display_order": 10}, {"id": 6000334010, "chapter_id": 10334, "verse_number": "१२-२-९", "content_sanskrit": "आच्छिन्नदारद्रविणा यास्यन्ति गिरिकाननम्।\nशाकमूलामिषक्षौद्रफलपुष्पादिभोजनाः॥ १२/२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.010.m4a", "display_order": 11}, {"id": 6000334011, "chapter_id": 10334, "verse_number": "१२-२-१०", "content_sanskrit": "अनावृष्ट्या विनङ्क्ष्‍यन्ति दुर्भिक्षाकरपीडिताः।\nशीतवातातपप्रावृड्ढिमैरन्योन्यतः प्रजाः॥ १२/२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.011.m4a", "display_order": 12}, {"id": 6000334012, "chapter_id": 10334, "verse_number": "१२-२-११", "content_sanskrit": "क्षुत्तृषाव्याधिभिश्चैव सन्तप्यन्ते च चिन्तया।\nत्रिंशद्विंशतिवर्षाणि परमायुः कलौ नृणाम्॥ १२/२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.012.m4a", "display_order": 13}, {"id": 6000334013, "chapter_id": 10334, "verse_number": "१२-२-१२", "content_sanskrit": "क्षीयमाणेषु देहेषु देहिनां कलिदोषतः।\nवर्णाश्रमवतां धर्मे नष्टे वेदपथे नृणाम्॥ १२/२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.013.m4a", "display_order": 14}, {"id": 6000334014, "chapter_id": 10334, "verse_number": "१२-२-१३", "content_sanskrit": "पाखण्डप्रचुरे धर्मे दस्युप्रायेषु राजसु।\nचौर्यानृतवृथाहिंसानानावृत्तिषु वै नृषु॥ १२/२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.014.m4a", "display_order": 15}, {"id": 6000334015, "chapter_id": 10334, "verse_number": "१२-२-१४", "content_sanskrit": "शूद्रप्रायेषु वर्णेषु छागप्रायासु धेनुषु।\nगृहप्रायेष्वाश्रमेषु योनिप्रायेषु बन्धुषु॥ १२/२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.015.m4a", "display_order": 16}, {"id": 6000334016, "chapter_id": 10334, "verse_number": "१२-२-१५", "content_sanskrit": "अणुप्रायेष्वौषधीषु शमिप्रायेषु स्थास्नुषु।\nविद्युत्प्रायेषु मेघेषु शून्यप्रायेषु सद्मसु॥ १२/२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.016.m4a", "display_order": 17}, {"id": 6000334017, "chapter_id": 10334, "verse_number": "१२-२-१६", "content_sanskrit": "इत्थं कलौ गतप्राये जनेषु परधर्मसु।\nधर्मत्राणाय सत्त्वेन भगवानवतरिष्यति॥ १२/२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.017.m4a", "display_order": 18}, {"id": 6000334018, "chapter_id": 10334, "verse_number": "१२-२-१७", "content_sanskrit": "चराचरगुरोर्विष्णोरीश्वरस्याखिलात्मनः।\nधर्मत्राणाय साधूनां जन्म कर्मापनुत्तये॥ १२/२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.018.m4a", "display_order": 19, "topics": [{"text": "कलेरन्ते कल्क्यवतारः", "range": "१७–२२"}]}, {"id": 6000334019, "chapter_id": 10334, "verse_number": "१२-२-१८", "content_sanskrit": "शम्बलग्राममुख्यस्य ब्राह्मणस्य महात्मनः।\nभवने विष्णुयशसः कल्किः प्रादुर्भविष्यति॥ १२/२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.019.m4a", "display_order": 20}, {"id": 6000334020, "chapter_id": 10334, "verse_number": "१२-२-१९", "content_sanskrit": "अश्वमाशुगमारुह्य देवदत्तं जगत्पतिः।\nअसिनाऽसाधुदमनमष्टैश्वर्यगुणान्वितः॥ १२/२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.020.m4a", "display_order": 21}, {"id": 6000334021, "chapter_id": 10334, "verse_number": "१२-२-२०", "content_sanskrit": "विचरन्नसिमान् क्षोण्यां हयेनाप्रतिमद्युतिः।\nनृपलिङ्गच्छदो दस्यून् कोटिशो निहनिष्यति॥ १२/२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.021.m4a", "display_order": 22}, {"id": 6000334022, "chapter_id": 10334, "verse_number": "१२-२-२१", "content_sanskrit": "अथ तेषां भविष्यन्ति मनांसि विशदानि वै।\nवासुदेवाङ्गरागातिपुण्यगन्धानिलस्पृशाम्॥ १२/२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.022.m4a", "display_order": 23}, {"id": 6000334023, "chapter_id": 10334, "verse_number": "१२-२-२२", "content_sanskrit": "पौरजानपदानां वै हतेष्वखिलदस्युषु।\nतेषां प्रजाविसर्गश्च स्थविष्ठः सम्भविष्यति॥ १२/२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.023.m4a", "display_order": 24}, {"id": 6000334024, "chapter_id": 10334, "verse_number": "१२-२-२३", "content_sanskrit": "वासुदेवे भगवति सत्त्वमूर्तौ हृदि स्थिते। यदाऽवतीर्णो भगवान् कल्की धर्मपतिर्हरिः।\nकृतं भविष्यति तदा प्रजासूतिश्च सात्विकी॥ १२/२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.024.m4a", "display_order": 25, "topics": [{"text": "ततः कृतयुगारम्भः", "range": "२३–४४"}]}, {"id": 6000334025, "chapter_id": 10334, "verse_number": "१२-२-२४", "content_sanskrit": "यदा चन्द्रश्च सूर्यश्च तथा तिष्ये बृहस्पतिः।\nएकराशौ समेष्यन्ति तदा भवति तत् कृतम्॥ १२/२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.025.m4a", "display_order": 26}, {"id": 6000334026, "chapter_id": 10334, "verse_number": "१२-२-२५", "content_sanskrit": "येऽतीता वर्तमाना ये ये भविष्यन्ति पार्थिवाः।\nते त उद्देशतः प्रोक्ता वंशजाः सूर्यसोमयोः॥ १२/२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.026.m4a", "display_order": 27}, {"id": 6000334027, "chapter_id": 10334, "verse_number": "१२-२-२६", "content_sanskrit": "आरभ्य भवतो जन्म यावन्नन्दाभिषेचनम्।\nएतद् वर्षसहस्रं तु शतं पञ्चदशोत्तरम्॥ १२/२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.027.m4a", "display_order": 28}, {"id": 6000334028, "chapter_id": 10334, "verse_number": "१२-२-२७", "content_sanskrit": "सप्तर्षीणां तु यौ पूर्वौ दृश्येते उदितौ दिवि।\nतयोस्तु मध्ये नक्षत्रं दृश्यते यत् समं निशि॥ १२/२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.028.m4a", "display_order": 29}, {"id": 6000334029, "chapter_id": 10334, "verse_number": "१२-२-२८", "content_sanskrit": "तेनैते ऋषयो युक्तास्तिष्ठन्त्यब्दशतं नृणाम्।\nते त्वदीये द्विजाः काले अधुना चाश्रिता मघाम्॥ १२/२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.029.m4a", "display_order": 30}, {"id": 6000334030, "chapter_id": 10334, "verse_number": "१२-२-२९", "content_sanskrit": "विष्णोर्भगवतो भागः कृष्णाख्योऽसौ दिवं गतः।\nतदाऽविशत् कलिर्लोकं पापे यद् रमते जनः॥ १२/२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.030.m4a", "display_order": 31}, {"id": 6000334031, "chapter_id": 10334, "verse_number": "१२-२-३०", "content_sanskrit": "यावत् स पादपद्माभ्यां स्पृशन्नास्ते रमापतिः।\nतावत् कलिर्वै पृथिवीं पराक्रान्तुं न चाशकत्॥ १२/२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.031.m4a", "display_order": 32}, {"id": 6000334032, "chapter_id": 10334, "verse_number": "१२-२-३१", "content_sanskrit": "यदा देवर्षयः सप्त मघासु विचरन्ति हि।\nतदा प्रवृत्तस्तु कलिर्द्वादशाब्दशतात्मकः॥ १२/२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.032.m4a", "display_order": 33}, {"id": 6000334033, "chapter_id": 10334, "verse_number": "१२-२-३२", "content_sanskrit": "यदा मघाभ्यो यास्यन्ति पूर्वाषाढां महर्षयः।\nतदा नन्दात् प्रभृत्येष कलिर्वृद्धिं गमिष्यति॥ १२/२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.033.m4a", "display_order": 34}, {"id": 6000334034, "chapter_id": 10334, "verse_number": "१२-२-३३", "content_sanskrit": "यस्मिन् कृष्णो दिवं यातस्तस्मिन्नेव तदाऽहनि।\nप्रतिपन्नं कलियुगमिति प्राहुः पुराविदः॥ १२/२/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.034.m4a", "display_order": 35}, {"id": 6000334035, "chapter_id": 10334, "verse_number": "१२-२-३४", "content_sanskrit": "दिव्याब्दानां सहस्रे तु प्रतियाते पुनः कृतम्।\nभविष्यति यदा नॄणां मन आत्मप्रकाशकम्॥ १२/२/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.035.m4a", "display_order": 36}, {"id": 6000334036, "chapter_id": 10334, "verse_number": "१२-२-३५", "content_sanskrit": "इत्येवं मानवो वंशो यथा संख्यायते भुवि।\nतथा विट्-शूद्रविप्राणां वंशा ज्ञेया युगेयुगे॥ १२/२/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.036.m4a", "display_order": 37}, {"id": 6000334037, "chapter_id": 10334, "verse_number": "१२-२-३६", "content_sanskrit": "एतेषां नामलिङ्गानां पुरुषाणां महात्मनाम्।\nकथामात्रावशिष्टानां कीर्तिरेव स्थिता भुवि॥ १२/२/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.037.m4a", "display_order": 38}, {"id": 6000334038, "chapter_id": 10334, "verse_number": "१२-२-३७", "content_sanskrit": "देवापिः शन्तनोर्भ्राता मनुश्चेक्ष्वाकुवंशजः।\nकलापग्राम आसाते महायोगबलान्वितौ॥ १२/२/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.038.m4a", "display_order": 39}, {"id": 6000334039, "chapter_id": 10334, "verse_number": "१२-२-३८", "content_sanskrit": "ताविहैत्य कलेरन्ते वासुदेवानुशिक्षितौ।\nवर्णाश्रमयुतं धर्मं पूर्ववत् प्रथयिष्यतः॥ १२/२/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.039.m4a", "display_order": 40}, {"id": 6000334040, "chapter_id": 10334, "verse_number": "१२-२-३९", "content_sanskrit": "कृतं त्रेता द्वापरं च कलिश्चेति चतुर्युगम्।\nअनेन क्रमयोगेन भुवि प्राणिषु वर्तते॥ १२/२/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.040.m4a", "display_order": 41}, {"id": 6000334041, "chapter_id": 10334, "verse_number": "१२-२-४०", "content_sanskrit": "राजन्नेते मया प्रोक्ता नरदेवास्तथा परे।\nभूमौ ममत्वं कृत्वाऽन्ते हित्वेमां निधनं गताः॥ १२/२/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.041.m4a", "display_order": 42}, {"id": 6000334042, "chapter_id": 10334, "verse_number": "१२-२-४१", "content_sanskrit": "कृमिविड्‌भस्मसञ्ज्ञान्ते राजनाम्नोऽपि यस्य च।\nभूतध्रुङ् मनुते स्वार्थं किं वेद निरयो यतः॥ १२/२/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.042.m4a", "display_order": 43}, {"id": 6000334043, "chapter_id": 10334, "verse_number": "१२-२-४२", "content_sanskrit": "कथं सेयमखण्डा भूः पूर्वैर्मत्पुरुषैर्धृता।\nमत्पुत्रस्य च पौत्रस्य मत्पूर्वा वंशजस्य च॥ १२/२/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.043.m4a", "display_order": 44}, {"id": 6000334044, "chapter_id": 10334, "verse_number": "१२-२-४३", "content_sanskrit": "तेजोऽबन्नात्मकं कायं गृहीत्वाऽऽत्मतया मुधा।\nमहीं ममतया चोभौ हित्वाऽन्तेऽदर्शनं गताः॥ १२/२/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.044.m4a", "display_order": 45}, {"id": 6000334045, "chapter_id": 10334, "verse_number": "१२-२-४४", "content_sanskrit": "ये ये भूपतयो राजन् भुञ्जते भुवमोजसा।\nकालेन ते कृताः सर्वे कथामात्राः कथासु वै॥ १२/२/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_002/BhP_12.002.045.m4a", "display_order": 46}, {"id": 6000334046, "chapter_id": 10334, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां द्वादशस्कन्धे द्वितीयाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]