[{"id": 2040941, "chapter_id": 1909, "verse_number": "५-१५४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2040942, "chapter_id": 1909, "verse_number": "५-१५४-१", "content_sanskrit": "वासुदेवस्य तद्वाक्यमनुस्मृत्य युधिष्ठिरः।\nपुनः पप्रच्छ वार्ष्णेयं कथं मन्दोऽऽब्रवीदिदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2040943, "chapter_id": 1909, "verse_number": "५-१५४-२", "content_sanskrit": "अस्मिन्नभ्यागते काले किंच नः क्षममच्युत ।\nकथं च वर्तमाना वै स्वधर्मान्न च्यवेमहि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2040944, "chapter_id": 1909, "verse_number": "५-१५४-३", "content_sanskrit": "दुर्योधनस्य कर्णस्य शकुनेः सौबलस्य च ।\nवासुदेव मतज्ञोऽसि मम सभ्रातृकस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2040945, "chapter_id": 1909, "verse_number": "५-१५४-४", "content_sanskrit": "विदुरस्यापि तद्वाक्यं श्रुतं भीष्मस्य चोभयोः ।\nकुन्त्याश्च विपुलप्रज्ञ प्रज्ञा कार्त्स्न्येन ते श्रुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2040946, "chapter_id": 1909, "verse_number": "५-१५४-५", "content_sanskrit": "सर्वमेतदतिक्रम्य विचार्य च पुनः पुनः ।\nक्षमं यन्नो महाबाहो तद्ब्रवीह्यविचारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2040947, "chapter_id": 1909, "verse_number": "५-१५४-६", "content_sanskrit": "श्रुत्वैतद्धर्मराजस्य धर्मार्थसहितं वचः।\nमेघदुन्दुभिनिर्घोषः कृष्णो वाक्यमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2040948, "chapter_id": 1909, "verse_number": "५-१५४-७", "content_sanskrit": "उक्तवानस्मि यद्वाक्यं धर्मार्थसहितं हितम्।\nन तु तन्निकृतिप्रज्ञे कौरव्ये प्रतितिष्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2040949, "chapter_id": 1909, "verse_number": "५-१५४-८", "content_sanskrit": "न च भीष्मस्य दुर्मेधाः शृणोति विदुरस्य वा।\nमम वा भाषितं किंचित्सर्वमेवातिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2040950, "chapter_id": 1909, "verse_number": "५-१५४-९", "content_sanskrit": "नैष कामयते धर्मं नैष कामयते यशः ।\nजितं स मन्यते सर्वं दुरात्मा कर्णमाश्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2040951, "chapter_id": 1909, "verse_number": "५-१५४-१०", "content_sanskrit": "बन्धमाज्ञापयामास मम चापि सुयोधनः ।\nन च तं लब्धवान्कामं दुरात्मा पापनिश्चयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2040952, "chapter_id": 1909, "verse_number": "५-१५४-११", "content_sanskrit": "न च भीष्मो न च द्रोणो युक्तं तत्राहतुर्वचः।\nसर्वे तमनुवर्तन्ते ऋते विदुरमुच्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2040953, "chapter_id": 1909, "verse_number": "५-१५४-१२", "content_sanskrit": "शकुनिः सौबलश्चैव कर्णदुःशासनावपि ।\nत्वय्ययुक्तान्यभाषन्त मूढा मूढममर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2040954, "chapter_id": 1909, "verse_number": "५-१५४-१३", "content_sanskrit": "किंच तेन मयोक्तेन यान्यभाषत कौरवः ।\nसंक्षेपेण दुरात्मासौ न युक्तं त्वयि वर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2040955, "chapter_id": 1909, "verse_number": "५-१५४-१४", "content_sanskrit": "पार्थिवेषु न सर्वेषु य इमे तव सैनिकाः।\nयत्पापं यन्न कल्याणं सर्वं तस्मिन्प्रतिष्ठितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2040956, "chapter_id": 1909, "verse_number": "५-१५४-१५", "content_sanskrit": "न चापि वयमत्यर्थं परित्यागेन कर्हिचित्।\nकौरवैः शममिच्छामस्तत्र युद्धमनन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2040957, "chapter_id": 1909, "verse_number": "५-१५४-१६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2040958, "chapter_id": 1909, "verse_number": "५-१५४-१६", "content_sanskrit": "तच्छ्रुत्वा पार्थिवाः सर्वे वासुदेवस्य भाषितम्।\nअब्रुवन्तो मुखं राज्ञः समुदैक्षन्त भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2040959, "chapter_id": 1909, "verse_number": "५-१५४-१७", "content_sanskrit": "युधिष्ठिरस्त्वभिप्रायमभिलक्ष्य महीक्षिताम् ।\nयोगमाज्ञापयामास भीमार्जुनयमैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2040960, "chapter_id": 1909, "verse_number": "५-१५४-१८", "content_sanskrit": "ततः किलकिलाभूतमनीकं पाण्डवस्य ह।\nआज्ञापिते तदा योगे समहृष्यन्त सैनिकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2040961, "chapter_id": 1909, "verse_number": "५-१५४-१९", "content_sanskrit": "अवध्यानां वधं पश्यन्धर्मराजो युधिष्ठिरः।\nनिश्वसन्भीमसेनं च विजयं चेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2040962, "chapter_id": 1909, "verse_number": "५-१५४-२०", "content_sanskrit": "यदर्थं वनवासश्च प्राप्तं दुःखं च यन्मया।\nसोयमस्मानुपैत्येव परोऽनर्थः प्रयत्नतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2040963, "chapter_id": 1909, "verse_number": "५-१५४-२१", "content_sanskrit": "यस्मिन्यत्नः कृतोऽस्माभिः स नो हीनः प्रयत्नतः।\nअकृते तु प्रयत्नेऽस्मानुपावृत्तः कलिर्महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2040964, "chapter_id": 1909, "verse_number": "५-१५४-२२", "content_sanskrit": "कथं ह्यवध्यैः सङ्ग्रामः कार्यः सह भविष्यति।\nकथं हत्वा गुरून्वृद्धान्विजयो नो भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2040965, "chapter_id": 1909, "verse_number": "५-१५४-२३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2040966, "chapter_id": 1909, "verse_number": "५-१५४-२३", "content_sanskrit": "तच्छ्रुत्वा धर्मराजस्य सव्यसाची परन्तपः।\nयदुक्तं वासुदेवेन श्रावयामास तद्वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2040967, "chapter_id": 1909, "verse_number": "५-१५४-२४", "content_sanskrit": "उक्तवान्देवकीपुत्रः कुन्त्याश्च विदुरस्य च ।\nवचनं तत्त्वया राजन्निखिलेनावधारितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2040968, "chapter_id": 1909, "verse_number": "५-१५४-२५", "content_sanskrit": "न च तौ वक्ष्यतोऽधर्ममिति मे नैष्ठिकी मतिः।\nनापि युक्तं च कौन्तेय निवर्तितुमयुध्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2040969, "chapter_id": 1909, "verse_number": "५-१५४-२६", "content_sanskrit": "तच्छ्रुत्वा वासुदेवोऽपि सव्यसाचिवचस्तदा ।\nस्मयमानोऽब्रवीद्वाक्यं पार्थमेवमिति ब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2040970, "chapter_id": 1909, "verse_number": "५-१५४-२७", "content_sanskrit": "ततस्ते धृतसंकल्पा युद्धाय सह सैनिकाः।\nपाण्डवेया महाराज तां रात्रिं सुखमावसन् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2040971, "chapter_id": 1909, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि सैन्यनिर्याणपर्वणि चतुःपञ्चशदधिकशततमोऽध्यायाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]