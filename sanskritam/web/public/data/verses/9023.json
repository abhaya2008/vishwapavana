[{"id": 5000023000, "chapter_id": 9023, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे त्रयोविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000023001, "chapter_id": 9023, "verse_number": "१-२३-१", "content_sanskrit": "प्रभातायां तु शर्वर्यां विश्वामित्रो महामुनिः ।\nअभ्यभाषत काकुत्स्थं शयानं पर्णसंस्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000023002, "chapter_id": 9023, "verse_number": "१-२३-२", "content_sanskrit": "कौसल्या सुप्रजा राम पूर्वा संध्या प्रवर्तते ।\nउत्तिष्ठ नरशार्दूल कर्तव्यं दैवमाह्निकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000023003, "chapter_id": 9023, "verse_number": "१-२३-३", "content_sanskrit": "तस्यर्षेः परमोदारं वचः श्रुत्वा नरोत्तमौ ।\nस्नात्वा कृतोदकौ वीरौ जेपतुः परमं जपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000023004, "chapter_id": 9023, "verse_number": "१-२३-४", "content_sanskrit": "कृताह्निकौ महावीर्यौ विश्वामित्रं तपोधनम् ।\nअभिवाद्यातिसंहृष्टौ गमनायाभितस्थतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000023005, "chapter_id": 9023, "verse_number": "१-२३-५", "content_sanskrit": "तौ प्रयान्तौ महावीर्यौ दिव्यां त्रिपथगां नदीम् ।\nददृशाते ततस्तत्र सरय्वाः संगमे शुभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000023006, "chapter_id": 9023, "verse_number": "१-२३-६", "content_sanskrit": "तत्राश्रमपदं पुण्यमृषीणां भावितात्मनाम् ।\nबहुवर्षसहस्राणि तप्यतां परमं तपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000023007, "chapter_id": 9023, "verse_number": "१-२३-७", "content_sanskrit": "तं दृष्ट्वा परमप्रीतौ राघवौ पुण्यमाश्रमम् ।\nऊचतुस्तं महात्मानं विश्वामित्रमिदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000023008, "chapter_id": 9023, "verse_number": "१-२३-८", "content_sanskrit": "कस्यायमाश्रमः पुण्यः को न्वस्मिन्वसते पुमान् ।\nभगवञ्श्रोतुमिच्छावः परं कौतूहलं हि नौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000023009, "chapter_id": 9023, "verse_number": "१-२३-९", "content_sanskrit": "तयोस्तद्वचनं श्रुत्वा प्रहस्य मुनिपुङ्गवः ।\nअब्रवीच्छ्रूयतां राम यस्यायं पूर्व आश्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000023010, "chapter_id": 9023, "verse_number": "१-२३-१०", "content_sanskrit": "कन्दर्पो मूर्तिमानासीत्काम इत्युच्यते बुधैः ।\nतपस्यन्तमिह स्थाणुं नियमेन समाहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000023011, "chapter_id": 9023, "verse_number": "१-२३-११", "content_sanskrit": "कृतोद्वाहं तु देवेशं गच्छन्तं समरुद्गणम् ।\nधर्षयामास दुर्मेधा हुंकृतश्च महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000023012, "chapter_id": 9023, "verse_number": "१-२३-१२", "content_sanskrit": "अवध्यातश्च रुद्रेण चक्षुषा रघुनन्दन ।\nव्यशीर्यन्त शरीरात् स्वात् सर्वगात्राणि दुर्मतेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000023013, "chapter_id": 9023, "verse_number": "१-२३-१३", "content_sanskrit": "तस्य गात्रं हतं तत्र निर्दग्धस्य महात्मना ।\nअशरीरः कृतः कामः क्रोधाद् देवेश्वरेण ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000023014, "chapter_id": 9023, "verse_number": "१-२३-१४", "content_sanskrit": "अनङ्ग इति विख्यातस्तदा प्रभृति राघव ।\nस चाङ्गविषयः श्रीमान् यत्राङ्गं स मुमोच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000023015, "chapter_id": 9023, "verse_number": "१-२३-१५", "content_sanskrit": "तस्यायमाश्रमः पुण्यस्तस्येमे मुनयः पुरा ।\nशिष्या धर्मपरा वीर तेषां पापं न विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000023016, "chapter_id": 9023, "verse_number": "१-२३-१६", "content_sanskrit": "इहाद्य रजनीं राम वसेम शुभदर्शन ।\nपुण्ययोः सरितोर्मध्ये श्वस्तरिष्यामहे वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000023017, "chapter_id": 9023, "verse_number": "१-२३-१७", "content_sanskrit": "अभिगच्छामहे सर्वे शुचयः पुण्यमाश्रमम् ।\nइह वासः परोऽस्माकं सुखं वस्त्यामहे निशाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000023018, "chapter_id": 9023, "verse_number": "१-२३-१८", "content_sanskrit": "स्नाताश्च कृतजप्याश्च हुतहव्या नरोत्तम ।\nतेषां संवदतां तत्र तपोदीर्घेण चक्षुषा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000023019, "chapter_id": 9023, "verse_number": "१-२३-१९", "content_sanskrit": "विज्ञाय परमप्रीता मुनयो हर्षमागमन् ।\nअर्घ्यं पाद्यं तथाऽऽतिथ्यं निवेद्य कुशिकात्मजे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000023020, "chapter_id": 9023, "verse_number": "१-२३-२०", "content_sanskrit": "रामलक्ष्मणयोः पश्चादकुर्वन्नतिथिक्रियाम् ।\nसत्कारं समनुप्राप्य कथाभिरभिरञ्जयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000023021, "chapter_id": 9023, "verse_number": "१-२३-२१", "content_sanskrit": "यथार्हमजपन् संध्यामृषयस्ते समाहिताः ।\nतत्र वासिभिरानीता मुनिभिः सुव्रतैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000023022, "chapter_id": 9023, "verse_number": "१-२३-२२", "content_sanskrit": "न्यवसन् सुसुखं तत्र कामाश्रमपदे तथा ।\nकथाभिरभिरामभिरभिरमौ नृपात्मजौ ।\nरमयामास धर्मात्मा कौशिको मुनिपुङ्गवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000023023, "chapter_id": 9023, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे त्रयोविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]