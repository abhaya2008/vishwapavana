[{"id": 7000601000, "chapter_id": 20601, "verse_number": "५-६०-१", "content_sanskrit": "शेष उवाच ।\nशत्रुघ्नो निजवीराणां छिन्नान्बाहून्निरीक्षयन् ।\nउवाच तान्सुकुपितो रोषसंदंशिताधरः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000601001, "chapter_id": 20601, "verse_number": "५-६०-२", "content_sanskrit": "केन वीरेण वो बाहुकृंतनं समकारि भोः ।\nतस्याहं बाहू कृंतामि देवगुप्तस्य वै भटाः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000601002, "chapter_id": 20601, "verse_number": "५-६०-३", "content_sanskrit": "न जानाति महामूढो रामचंद्र बलं महत् ।\nइदानीं दर्शयिष्यामि पराक्रांत्या बलं स्वकम्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000601003, "chapter_id": 20601, "verse_number": "५-६०-४", "content_sanskrit": "स कुत्र वर्तते वीरो हयः कुत्र मनोरमः ।\nको वाऽगृह्णात्सुप्तसर्पान्मूढो ज्ञात्वा पराक्रमम्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000601004, "chapter_id": 20601, "verse_number": "५-६०-५", "content_sanskrit": "इति ते कथिता वीरा विस्मिता दुःखिता भृशम् ।\nरामचंद्र प्रतिनिधिं बालकं समशंसत॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000601005, "chapter_id": 20601, "verse_number": "५-६०-६", "content_sanskrit": "स श्रुत्वा रोषताम्राक्षो बालकेन हयग्रहम् ।\nसेनान्यं वै कालजितमाज्ञापयद्युयुत्सुकः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000601006, "chapter_id": 20601, "verse_number": "५-६०-७", "content_sanskrit": "सेनानीः सकलां सेनां व्यूहयस्व ममाज्ञया ।\nरिपुः संप्रति गंतव्यो महाबलपराक्रमः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000601007, "chapter_id": 20601, "verse_number": "५-६०-८", "content_sanskrit": "नायं बालो हरिर्नूनं भविष्यति हयंधरः ।\nअथवा त्रिपुरारिः स्यान्नान्यथा मद्धयापहृत्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000601008, "chapter_id": 20601, "verse_number": "५-६०-९", "content_sanskrit": "अवश्यं कदनं भाविसैन्यस्य बलिनो महत् ।\nस्वच्छंदचरितैः खेलन्नास्ते निर्भयधीः शिशुः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000601009, "chapter_id": 20601, "verse_number": "५-६०-१०", "content_sanskrit": "तत्र गंतव्यमस्माभिः सन्नद्धै रिपुदुर्जयैः ।\nएतन्निशम्य वचनं शत्रुघ्नस्य ससैन्यपः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000601010, "chapter_id": 20601, "verse_number": "५-६०-११", "content_sanskrit": "सज्जीचकार सेनां तां दुर्व्यूढां चतुरंगिणीम् ।\nसज्जां तां शत्रुजिद्दृष्ट्वा चतुरंगयुतां वराम्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000601011, "chapter_id": 20601, "verse_number": "५-६०-१२", "content_sanskrit": "आज्ञापयत्ततो गंतुं यत्र बालो हयंधरः ।\nसा चचाल तदा सेना चतुरंगसमन्विता॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000601012, "chapter_id": 20601, "verse_number": "५-६०-१३", "content_sanskrit": "कंपयंती महीभागं त्रासयंती रिपून्बलात् ।\nसेनानीस्तं ददर्शाथ बालकं रामरूपिणम्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000601013, "chapter_id": 20601, "verse_number": "५-६०-१४", "content_sanskrit": "विचार्य रामप्रतिममब्रवीद्वचनं हितम् ।\nबाल मुंच हयश्रेष्ठं रामस्य बलशालिनः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000601014, "chapter_id": 20601, "verse_number": "५-६०-१५", "content_sanskrit": "सेनानीः कालजिन्नाम तस्य भूपस्य दुर्मदः ।\nत्वां रामप्रतिमं दृष्ट्वा कृपा मे हृदि जायते॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000601015, "chapter_id": 20601, "verse_number": "५-६०-१६", "content_sanskrit": "अन्यथा तव मे दौस्थ्याज्जीवितं न भविष्यति ।\nएतद्वाक्यं समाकर्ण्य शत्रुघ्नस्य भटस्य हि॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000601016, "chapter_id": 20601, "verse_number": "५-६०-१७", "content_sanskrit": "जहास किंचिदाकोपादुवाच च वचोद्भुतम् ।\nगच्छ मुक्तोसि तं रामं कथयस्व हयग्रहम्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000601017, "chapter_id": 20601, "verse_number": "५-६०-१८", "content_sanskrit": "त्वत्तो बिभेमि नो शूर वाक्येन नयशालिना ।\nममात्र गणना नास्ति त्वादृशाः कोटयो यदि॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000601018, "chapter_id": 20601, "verse_number": "५-६०-१९", "content_sanskrit": "मातृपादप्रसादेन तूलीभूता न संशयः ।\nकालजित्तव यन्नाम मात्राकारि मनोज्ञया॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000601019, "chapter_id": 20601, "verse_number": "५-६०-२०", "content_sanskrit": "पक्वबिंबफलस्येव वर्णतो न च वीर्यतः ।\nदर्शयस्वाधुना वीर्यं स्वनामबलचिह्नितः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000601020, "chapter_id": 20601, "verse_number": "५-६०-२१", "content_sanskrit": "मां कालं तव संजित्य सत्यनामा भविष्यसि ।\nशेष उवाच ।\nस वाक्यैः पविनातुल्यैर्भिन्नः सुभटशेखरः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000601021, "chapter_id": 20601, "verse_number": "५-६०-२२", "content_sanskrit": "चुकोप हृदयेऽत्यतं जगाद वचनं पुनः ।\nकस्मिन्कुले समुत्पत्तिः किं नामासि च बालक ।\nत्वन्नाम नाभिजानामि कुलं शीलं वयस्तथा॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000601022, "chapter_id": 20601, "verse_number": "५-६०-२३", "content_sanskrit": "पादचारं रथस्थोऽहमधर्मेण कथं जये ।\nतदात्यंतं प्रकुपितो जगाद वचनं पुनः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000601023, "chapter_id": 20601, "verse_number": "५-६०-२४", "content_sanskrit": "कुलेन किं च शीलेन नाम्ना वा सुमनोहृदा ।\nलवोऽहं लवतः सर्वाञ्जेष्यामि रिपुसैनिकान्॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000601024, "chapter_id": 20601, "verse_number": "५-६०-२५", "content_sanskrit": "इदानीं त्वामपि भटं करिष्ये पादचारिणम् ।\nइत्थमुक्त्वा धनुः सज्यं चकार स लवो बली॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000601025, "chapter_id": 20601, "verse_number": "५-६०-२६", "content_sanskrit": "टंकारयामास तदा वीरानाकंपयन्हृदि ।\nवाल्मीकिं प्रथमं स्मृत्वा जानकीं मातरं लवः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000601026, "chapter_id": 20601, "verse_number": "५-६०-२७", "content_sanskrit": "मुमोच बाणान्निशितान्सद्यः प्राणापहारिणः ।\nकालजित्स्वधनुः कृत्वा सज्यं कोपसमन्वितः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000601027, "chapter_id": 20601, "verse_number": "५-६०-२८", "content_sanskrit": "ताडयामास जवनो लवं रणविशारदः ।\nतद्बाणाञ्छतधा छित्त्वा क्षणाद्वेगात्कुशानुजः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000601028, "chapter_id": 20601, "verse_number": "५-६०-२९", "content_sanskrit": "सेनान्यं विरथं चक्रे वसुभिः स्वशरोत्तमैः ।\nविरथो गजमानीतमारुरोह भटैर्निजैः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000601029, "chapter_id": 20601, "verse_number": "५-६०-३०", "content_sanskrit": "मदोन्मत्तं महावेगं सप्तधा प्रस्रवान्वितम् ।\nगजारूढं तु तं दृष्ट्वा दशभिर्धनुषोगतैः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000601030, "chapter_id": 20601, "verse_number": "५-६०-३१", "content_sanskrit": "बाणैर्विव्याध विहसन्सर्वान्रिपुगणाञ्जयी ।\nकालजित्तस्य वीर्यं तु दृष्ट्वा विस्मितमानसः॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000601031, "chapter_id": 20601, "verse_number": "५-६०-३२", "content_sanskrit": "गदां मुमोच महतीं महायस विनिर्मिताम् ।\nआपतंतीं गदां वेगाद्भारायुतविनिर्मिताम्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000601032, "chapter_id": 20601, "verse_number": "५-६०-३३", "content_sanskrit": "त्रिधा चिच्छेद तरसा क्षुरप्रैः सकुशानुजः ।\nपरिघं निशितं घोरं वैरिप्राणहरोदितम्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000601033, "chapter_id": 20601, "verse_number": "५-६०-३४", "content_sanskrit": "मुक्तं पुनस्तेन लवश्चिच्छेद तरसान्वितः ।\nछित्त्वा तत्परिघं घोरं कोपादारक्तलोचनः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000601034, "chapter_id": 20601, "verse_number": "५-६०-३५", "content_sanskrit": "गजोपस्थे समारूढं मन्यमानश्चुकोप ह ।\nतत्क्षणादच्छिनत्तस्य शुंडां खड्गेन दंतिनः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000601035, "chapter_id": 20601, "verse_number": "५-६०-३६", "content_sanskrit": "दंतयोश्चरणौ धृत्वा रुरोह गजमस्तके ।\nमुकुटं शतधा कृत्वा कवचं तु सहस्रधा॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000601036, "chapter_id": 20601, "verse_number": "५-६०-३७", "content_sanskrit": "केशेष्वाकृष्य सेनान्यं पातयामास भूतले ।\nपातितः स गजोपस्थात्सेनानीः कुपितः पुनः॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000601037, "chapter_id": 20601, "verse_number": "५-६०-३८", "content_sanskrit": "हृदये ताडयामास मुष्टिना वज्रमुष्टिना ।\nस आहतो मुष्टिभिस्तु क्षुरप्रान्निशिताञ्छरान्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000601038, "chapter_id": 20601, "verse_number": "५-६०-३९", "content_sanskrit": "मुमोच हृदये क्षिप्रं कुंडलीकृतधन्ववान् ।\nस रराज रणोपांते कुंडलीकृत चापवान्॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000601039, "chapter_id": 20601, "verse_number": "५-६०-४०", "content_sanskrit": "शिरस्त्रं कवचं बिभ्रदभेद्यं शरकोटिभिः ।\nस विद्धः सायकैस्तीक्ष्णैस्तं हंतुं खड्गमाददे॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000601040, "chapter_id": 20601, "verse_number": "५-६०-४१", "content_sanskrit": "दशन्रोषात्स्वदशनान्निःश्वसन्नुच्छ्वसन्मुहुः ।\nखड्गहस्तं समायांतं शूरं सेनापतिं लवः॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000601041, "chapter_id": 20601, "verse_number": "५-६०-४२", "content_sanskrit": "चिच्छेद भुजमध्यं तु स खड्गः पाणिरापतत् ।\nछिन्नं खड्गधरं हस्तं वीक्ष्य कोपाच्चमूपतिः॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000601042, "chapter_id": 20601, "verse_number": "५-६०-४३", "content_sanskrit": "वामेन गदया हंतुं प्रचक्राम भुजेन तम् ।\nसोऽपि च्छिन्नो भुजस्तस्य सांगदस्तीक्ष्णसायकैः॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000601043, "chapter_id": 20601, "verse_number": "५-६०-४४", "content_sanskrit": "तदा प्रकुपितो वीरः पादाभ्यामहनल्लवम् ।\nलवः पादाहतस्तस्य न चचाल रणांगणे॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000601044, "chapter_id": 20601, "verse_number": "५-६०-४५", "content_sanskrit": "स्रजाहतो द्विप इव चरणच्छेदनं व्यधात् ।\nतदापि तं मौलिनासौ प्रहर्तुमुपचक्रमे॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000601045, "chapter_id": 20601, "verse_number": "५-६०-४६", "content_sanskrit": "तदा लवश्चमूनाथं मन्यमानोऽधिपौरुषम् ।\nकरवालं समादाय करे कालानलोपमम्॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000601046, "chapter_id": 20601, "verse_number": "५-६०-४७", "content_sanskrit": "अच्छिनच्छिर एतस्य महामुकुटशोभितम् ।\nहाहाकारो महानासीच्चमूनाथे निपातिते॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000601047, "chapter_id": 20601, "verse_number": "५-६०-४८", "content_sanskrit": "सैनिकाः परिसंक्रुद्धा लवं हंतुं समागताः ।\nलवस्तान्स्वशराघातैः पलायनपरान्व्यधात्॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000601048, "chapter_id": 20601, "verse_number": "५-६०-४९", "content_sanskrit": "छिन्नाभिन्नांगकाः केचिद्गता केचिद्रणांगणात् ।\nस निवार्याखिलान्योधान्विजगाह चमूं मुदा॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000601049, "chapter_id": 20601, "verse_number": "५-६०-५०", "content_sanskrit": "वाराह इव निःश्वस्य प्रलये सुमहार्णवम् ।\nगजा भिन्ना द्विधा जाता मौक्तिकैः पूरिता मही॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000601050, "chapter_id": 20601, "verse_number": "५-६०-५१", "content_sanskrit": "दुर्गमाभूद्भटाग्र्याणां पर्वतैर्व्यापृता यथा ।\nअश्वाः कनकपल्याणा रुचिरारत्नराजिताः॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000601051, "chapter_id": 20601, "verse_number": "५-६०-५२", "content_sanskrit": "अपतन्रुधिराप्लुष्टे ह्रदे बल सुशोभिताः ।\nरथिनः करमध्यस्थ धनुर्दंडसुशोभिनः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000601052, "chapter_id": 20601, "verse_number": "५-६०-५३", "content_sanskrit": "रथोपस्थे निपतिताः स्वर्गगा इव वै सुराः ।\nसंदष्टौष्ठपुटा वक्त्र भ्रमल्लक्ष्मीविलक्षिताः॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000601053, "chapter_id": 20601, "verse_number": "५-६०-५४", "content_sanskrit": "पतितास्तत्र दृश्यंते वीरा रणविशारदाः ।\nसुस्राव शोणितसरिद्धयमस्तककच्छपा॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000601054, "chapter_id": 20601, "verse_number": "५-६०-५५", "content_sanskrit": "महाप्रवाहललिता वैरिणां भयकारिका ।\nकेषांचिद्बाहविश्छिन्नाः केषां पादा विकर्तिता॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000601055, "chapter_id": 20601, "verse_number": "५-६०-५६", "content_sanskrit": "केषां कर्णाश्च नासाश्च केषां कवचकुंडले ।\nएवं तु कदनं जातं सेनान्यां पतिते रणे॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000601056, "chapter_id": 20601, "verse_number": "५-६०-५७", "content_sanskrit": "सर्वे निपतिता वीरा न केचिज्जीवितास्ततः ।\nलवो जयं रणे प्राप्य वैरिवृंदं विजित्य च॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000601057, "chapter_id": 20601, "verse_number": "५-६०-५८", "content_sanskrit": "अन्यागमनशंकायां मनः कुर्वन्नवैक्षत ।\nकेचिदुर्वरिता युद्धाद्भाग्येन न रणे मृताः॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000601058, "chapter_id": 20601, "verse_number": "५-६०-५९", "content_sanskrit": "शत्रुघ्नं सविधे जग्मुः शंसितुं वृत्तमद्भुतम् ।\nगत्वा ते कथयामासुर्यथावृत्तं रणांगणे॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000601059, "chapter_id": 20601, "verse_number": "५-६०-६०", "content_sanskrit": "कालजिन्निधनं बालाच्चित्रकारि रणोद्यमम् ।\nतच्छ्रुत्वा विस्मयं प्राप्तः शत्रुघ्नस्तानुवाच ह॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000601060, "chapter_id": 20601, "verse_number": "५-६०-६१", "content_sanskrit": "हसन्रोषाद्दशन्दंतान्बालग्राह हयं स्मरन् ।\nरे वीराः किं मदोन्मत्ता यूयं किं वा छलग्रहाः॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000601061, "chapter_id": 20601, "verse_number": "५-६०-६२", "content_sanskrit": "किं वा वैकल्यमायातं कालजिन्मरणं कथम् ।\nयः संख्ये वैरिवृंदानां दारुणः समितिंजयः॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000601062, "chapter_id": 20601, "verse_number": "५-६०-६३", "content_sanskrit": "तं कथं बालको जीयाद्यमस्यापि दुरासदम् ।\nशत्रुघ्नवाक्यं संश्रुत्य वीराः प्रोचुरसृक्प्लुताः॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000601063, "chapter_id": 20601, "verse_number": "५-६०-६४", "content_sanskrit": "नास्माकं मदमत्तादि न च्छलो न च देवनम् ।\nकालजिन्मरणं सत्यं लवाज्जानीहि भूपते॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000601064, "chapter_id": 20601, "verse_number": "५-६०-६५", "content_sanskrit": "बलं च कृत्स्नं मथितं बालेनातुलशौंडिना ।\nअतः परं तु यत्कार्यं ये प्रेष्या नृवरोत्तमाः॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000601065, "chapter_id": 20601, "verse_number": "५-६०-६६", "content_sanskrit": "बालं ज्ञात्वा भवान्नात्र करोतु बलसाहसम् ।\nइति श्रुत्वा वचस्तेषां वीराणां शत्रुहा तदा॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000601066, "chapter_id": 20601, "verse_number": "५-६०-६७", "content_sanskrit": "सुमतिं च मतिश्रेष्ठमुवाच रणकारणे॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}]