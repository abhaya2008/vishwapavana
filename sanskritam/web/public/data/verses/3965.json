[{"id": 2136791, "chapter_id": 3965, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2136792, "chapter_id": 3965, "verse_number": "१", "content_sanskrit": "एवमेतन्महाबाहो रामेणामिततेजसा ।\nप्राप्तं व्यसनमत्युग्रं वनवासकृतं पुरा \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2136793, "chapter_id": 3965, "verse_number": "२", "content_sanskrit": "मा शुचः पुरुषव्याघ्र क्षत्रियोऽसि परन्तप ।\nबाहुवीर्याश्रिते मार्गे वर्तसे पुरुषर्षभ ।\nन हि ते वृजिनं किञ्चिद् वर्तते परमण्वपि \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2136794, "chapter_id": 3965, "verse_number": "३", "content_sanskrit": "अस्मिन् मार्गे निषीदेयुः सेन्द्रा अपि सुरासुराः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2136795, "chapter_id": 3965, "verse_number": "४", "content_sanskrit": "संहत्य निहतो वृत्रो मरुद्भिर्वज्रपाणिना ।\nनमुचिश्चैव दुर्धर्षो दीर्घजिह्वा च राक्षसी \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2136796, "chapter_id": 3965, "verse_number": "५", "content_sanskrit": "सहायवति सर्वार्थाः सन्तिष्ठन्तीह सर्वशः ।\nकिं नु तस्याजितं सङ्खे यस्य भ्राता धनञ्जयः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2136797, "chapter_id": 3965, "verse_number": "६", "content_sanskrit": "अयं च बलिनां श्रेष्ठो भीमो भीमपराक्रमः ।\nयुवानौ च महेष्वासौ वीरौ माद्रवतीसुतौ ।\nएभिः सहायैः कस्मात् त्वं विषीदसि परन्तप \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2136798, "chapter_id": 3965, "verse_number": "७", "content_sanskrit": "य इमे वज्रिणः सेनां जयेयुः समरुद्गणाम् ।\nत्वमप्येभिर्महेष्वासैः सहायैर्देवरूपिभिः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2136799, "chapter_id": 3965, "verse_number": "८", "content_sanskrit": "विजेष्यसे रणे सर्वानमित्रान् भरतर्षभ \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2136800, "chapter_id": 3965, "verse_number": "९", "content_sanskrit": "इतश्च त्वमिमां पश्य सैन्धवेन दुरात्मना ।\nबलिना वीर्यमत्तेन हृतामेभिर्महात्मभिः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2136801, "chapter_id": 3965, "verse_number": "१०", "content_sanskrit": "आनीतां द्रौपदीं कृष्णां कृत्वा कर्म सुदुष्करम् ।\nजयद्रथं च राजानं विजितं वशमागतम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2136802, "chapter_id": 3965, "verse_number": "११", "content_sanskrit": "असहायेन रामेण वैदेही पुनराहृता ।\nहत्वा सङ्खे दशग्रीवं राक्षसं भीमविक्रमम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2136803, "chapter_id": 3965, "verse_number": "१२", "content_sanskrit": "यस्य शाखामृगा मित्राण्यक्षाः कालमुखास्तथा ।\nजात्यन्तरगता राजन्नेतद् बुद्ध्याऽनुचिन्तय \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2136804, "chapter_id": 3965, "verse_number": "१३", "content_sanskrit": "तस्मात् स त्वं कुरुश्रेष्ठ मा शुचो भरतर्षभ ।\nत्वद्विधा हि महात्मानो न शोचन्ति परन्तप \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2136805, "chapter_id": 3965, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2136806, "chapter_id": 3965, "verse_number": "१४", "content_sanskrit": "एवमाश्वासितो राजा मार्कण्डेयेन धीमता ।\nत्यक्त्वा दुःखमदीनात्मा पुनरप्येनमब्रवीत् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2136807, "chapter_id": 3965, "verse_number": "१५", "content_sanskrit": "श्रुत्वा रामायणं सर्वं त्यक्त्वा दुःखं युधिष्ठिरः ।\nमार्कण्डेयं पुनः प्राह भ्रातृभिः सह सम्मतैः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2136808, "chapter_id": 3965, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि रामोपाख्यानपर्वणि युधिष्ठिराश्वासने द्व्यशीत्यधिकद्विशततमोऽध्यायः ॥२८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2136809, "chapter_id": 3965, "verse_number": "२१", "content_sanskrit": "रामोपाख्यानपर्वणि एकविंशोऽध्यायः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2136810, "chapter_id": 3965, "verse_number": "", "content_sanskrit": "॥ समाप्तं रामोपाख्यानपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2136811, "chapter_id": 3965, "verse_number": "", "content_sanskrit": "––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]