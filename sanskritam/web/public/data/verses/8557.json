[{"id": 900007404, "chapter_id": 8557, "verse_number": "138.1", "content_sanskrit": "ॐ अनुबन्धादिभ्यश्च ॐ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900007405, "chapter_id": 8557, "verse_number": "138.2", "content_sanskrit": "दोषा अनादिसम्बद्धास्ते मुक्तिपरिपन्थिनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900007406, "chapter_id": 8557, "verse_number": "138.3", "content_sanskrit": "सर्वे त एते जीवेषु दृश्यन्ते तारतम्यतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900007407, "chapter_id": 8557, "verse_number": "138.4", "content_sanskrit": "ऋजूनामेक एवास्ति परमोत्साहवर्जनम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900007408, "chapter_id": 8557, "verse_number": "138.5", "content_sanskrit": "स गुणाल्पत्वमात्रत्वान्नर्जुत्वेन विरुध्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900007409, "chapter_id": 8557, "verse_number": "138.6", "content_sanskrit": "अतो विष्णौ परा भक्तिस्तद्भक्तेषु रमादिषु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900007410, "chapter_id": 8557, "verse_number": "138.7", "content_sanskrit": "स्वादरः सर्वजन्तूनां संसिद्धो हि स्वभावतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900007411, "chapter_id": 8557, "verse_number": "138.8", "content_sanskrit": "न कदाचित्त्यजेत्तं च क्रमेणैनं विवर्धयेत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900007412, "chapter_id": 8557, "verse_number": "138.9", "content_sanskrit": "तत्तमोऽन्धं व्रजेद्विष्णुसमत्वं योऽनुपश्यति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900007413, "chapter_id": 8557, "verse_number": "138.10", "content_sanskrit": "तेन सम्प्रोक्तगुणसंयुतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900007414, "chapter_id": 8557, "verse_number": "138.11", "content_sanskrit": "द्वेषाद्यन्मुक्तिकथनं श्रुतिवाक्यविरोधि तत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900007415, "chapter_id": 8557, "verse_number": "138.12", "content_sanskrit": "इत्यादिश्रुतिसन्दर्भाद्द्वेषिणस्तम ईयते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}]