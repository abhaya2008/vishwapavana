[{"id": 2121794, "chapter_id": 3611, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2121795, "chapter_id": 3611, "verse_number": "१", "content_sanskrit": "सा केशवमहामात्रैर्महेन्द्रप्रमुखैः सभा ।\nशुशुभे वृष्णिशार्दूलैः सिंहैरिव गिरेर्गुहा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2121796, "chapter_id": 3611, "verse_number": "२", "content_sanskrit": "अथासनगतान् सर्वानुवाच विबुधाधिपः ।\nशुभया हर्षयन् वाचा महेन्द्रस्तान् महायशाः ।\nकुकुरान्धकमुख्यांश्च तं च राजानमाहुकम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2121797, "chapter_id": 3611, "verse_number": "३", "content_sanskrit": "यदर्थं जन्म कृष्णस्य मानुषेषु महात्मनः ।\nयत् कृतं वासुदेवेन तद् वक्ष्यामि समासतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2121798, "chapter_id": 3611, "verse_number": "४", "content_sanskrit": "अयं शतसहस्राणि दानवानामरिन्दमः ।\nनिहत्य पुण्डरीकाक्षः पाताळविवरं ययौ ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2121799, "chapter_id": 3611, "verse_number": "५", "content_sanskrit": "यच्च नाधिगतं पूर्वैः प्रह्लादबलिशम्बरैः ।\nतदिदं शौरिणा वित्तं प्रापितं भवतामिह ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2121800, "chapter_id": 3611, "verse_number": "६", "content_sanskrit": "सपाशं मुरमाक्रम्य पाञ्जजन्यं तु धीमता ।\nशिलासङ्घानतिक्रम्य निसुम्भः सगणो हतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2121801, "chapter_id": 3611, "verse_number": "७", "content_sanskrit": "हयग्रीवश्च विक्रान्तो दानवो निहतो बली ।\nमथितश्च मृधे भौमः कुण्डले चाहृते पुनः ।\nप्राप्तं च दिवि देवेषु केशवेन महद्यशः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2121802, "chapter_id": 3611, "verse_number": "८", "content_sanskrit": "वीतशोकभयाबाधाः कृष्णबाहुबलाश्रयाः ।\nयजन्तु विविधैः सोमैर्मखैरन्धकवृष्णयः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2121803, "chapter_id": 3611, "verse_number": "९", "content_sanskrit": "पुनर्बाणवधे शौरिमादित्या वसुभिः सह ।\nमन्मुखाऽभिगमिष्यन्ति साध्याश्च मधुसूदनम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2121804, "chapter_id": 3611, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2121805, "chapter_id": 3611, "verse_number": "१०", "content_sanskrit": "एवमुक्त्वा ततः सर्वानामन्त्र्य कुकुरान्धकान् ।\nसस्वजे रामकृष्णौ च वसुदेवं च वासवः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2121806, "chapter_id": 3611, "verse_number": "११", "content_sanskrit": "प्रद्युम्नसाम्बनिशठान् अनिरुद्धं च सारणम् ।\nबभ्रुं झल्लिं गदं भानुं चारुदेष्णं च वृत्रहा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2121807, "chapter_id": 3611, "verse_number": "१२", "content_sanskrit": "सत्कृत्य सारणाक्रूरौ पुनराभाष्य सात्यकिम् ।\nसस्वजे वृष्णिराजानमाहुकं कुकुराधिपम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2121808, "chapter_id": 3611, "verse_number": "१३", "content_sanskrit": "भोजं च कृतवर्माणमन्यांश्चान्धकवृष्णिषु ।\nआमन्त्र्य देवप्रवरो वासवो वासवानुजम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2121809, "chapter_id": 3611, "verse_number": "१४", "content_sanskrit": "ततः श्वेताचलप्रख्यं गजमैरावतं प्रभुः ।\nपश्यतां सर्वभूतानामारुरोह शचीपतिः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2121810, "chapter_id": 3611, "verse_number": "१५", "content_sanskrit": "पृथिवीं चान्तरिक्षं च दिवं च वरवारणम् ।\nमुखाडम्बरनिर्घोषैः पूरयन्तमिवासकृत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2121811, "chapter_id": 3611, "verse_number": "१६", "content_sanskrit": "हैमयन्त्रमहाकक्ष्यं हिरण्मयविषाणिनम् ।\nमनोहरकुथास्तीर्णं सर्वरत्नविभूषितम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2121812, "chapter_id": 3611, "verse_number": "१७", "content_sanskrit": "अनेकशतरत्नाभिः पताकाभिरलङ्कृतम् ।\nनित्यस्रुतमदस्रावं क्षरन्तमिव तोयदम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2121813, "chapter_id": 3611, "verse_number": "१८", "content_sanskrit": "दिशागजं महामात्रं काञ्चनस्रजमास्थितः ।\nप्रबभौ मन्दराग्रस्थः प्रतपन् भानुमानिव ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2121814, "chapter_id": 3611, "verse_number": "१९", "content_sanskrit": "ततो वज्रमयं भीमं प्रगृह्य परमाङ्कुशम् ।\nययौ बलवता सार्धं पावकेन शचीपतिः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2121815, "chapter_id": 3611, "verse_number": "२०", "content_sanskrit": "तं करेणुगजव्रातैर्विमानैश्च मरुद्गणाः ।\nपृष्ठतोऽनुययुः प्रीताः कुबेरवरुणग्रहाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2121816, "chapter_id": 3611, "verse_number": "२१", "content_sanskrit": "स वायुपथमास्थाय वैश्वानरपथं गतः ।\nप्राप्य सूर्यपथं देवस्तत्रैवान्तरधीयत ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2121817, "chapter_id": 3611, "verse_number": "२२", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां सभापर्वणि\nत्रिपञ्चाशोऽध्यायः ॥५३॥\n॥ अर्घाभिहरणपर्वणि द्वाविंशोध्यायः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2121818, "chapter_id": 3611, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]