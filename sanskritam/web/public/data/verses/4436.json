[{"id": 2158612, "chapter_id": 4436, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2158613, "chapter_id": 4436, "verse_number": "१", "content_sanskrit": "बालमत्यन्तसुखिनं स्वबाहुबलदर्पितम् ।\nयुद्धेष्वकुशलं वीरं कुलपुत्रं तनुत्यजम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2158614, "chapter_id": 4436, "verse_number": "२", "content_sanskrit": "गाहमानमनीकानि किशोराश्वैस्त्रिहायनैः ।\nअपि यौधिष्ठिरात् सैन्यादेकोऽप्यनुपतन् रथी\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2158615, "chapter_id": 4436, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2158616, "chapter_id": 4436, "verse_number": "४", "content_sanskrit": "युधिष्ठिरो भीमसेनः शिखण्डी सात्यकिर्यमौ ।\nधृष्टद्युम्नो विराटश्च द्रुपदः केकयास्तथा\t॥३॥\nधृष्टकेतुश्च संरब्धा मत्स्याश्चान्वपतन् रणे ।\nतेनैव तु पथा याताः पितरो मातुलैः सह\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2158617, "chapter_id": 4436, "verse_number": "५", "content_sanskrit": "अन्वधावन् परीप्सन्तो व्यूढानीकाः प्रहारिणः ।\nतान् दृष्ट्वा द्रवतः शूरांस्त्वदीया विमुखाऽभवन्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2158618, "chapter_id": 4436, "verse_number": "६", "content_sanskrit": "ततस्तद् विमुखं दृष्ट्वा तव सूनोर्महद् बलम् ।\nजामाता तव तेजस्वी विष्टम्भयिषुराद्रवत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2158619, "chapter_id": 4436, "verse_number": "७", "content_sanskrit": "सैन्धवस्य तु यो राज्ञः पुत्रो राजा जयद्रथः ।\nस पुत्रगृद्धिनः पार्थान् सहसैन्यानवारयत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2158620, "chapter_id": 4436, "verse_number": "८", "content_sanskrit": "उग्रधन्वा महेष्वासो दिव्यमस्त्रमुदीरयन् ।\nवार्धक्षत्रिरवासेधत् प्रभिन्नानिव कुञ्जरान्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2158621, "chapter_id": 4436, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2158622, "chapter_id": 4436, "verse_number": "९", "content_sanskrit": "अतिभारमहं मन्ये सैन्धवे सञ्जयाहितम् ।\nयदेकः पाण्डवान् क्रुद्धान् पुत्रगृद्धीनवारयत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2158623, "chapter_id": 4436, "verse_number": "१०", "content_sanskrit": "अत्यद्भुतमहं मन्ये बलं शौर्यं च सैन्धवे ।\nतस्य प्रब्रूहि मे वीर्यं कर्म चोग्रं महात्मनः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2158624, "chapter_id": 4436, "verse_number": "११", "content_sanskrit": "किं दत्तं हुतमिष्टं वा स्वधीतमथवा तपः ।\nदमो वा ब्रह्मचर्यं वा सूत यच्चास्य सत्तम\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2158625, "chapter_id": 4436, "verse_number": "१२", "content_sanskrit": "देवं कतममाराध्य विष्णुमीशानमग्निजम् ।\nसिन्धुराट् तनये सक्तान् क्रुद्धः पार्थानवारयत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2158626, "chapter_id": 4436, "verse_number": "१३", "content_sanskrit": "नैवं कृतं महत् कर्म भीष्मेणाज्ञासिषं तथा ।\nसिन्धुराट्तनयस्त्वेको यथा पार्थानवारयत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2158627, "chapter_id": 4436, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2158628, "chapter_id": 4436, "verse_number": "१४", "content_sanskrit": "द्रौपदीहरणे यत् तद् भीमसेनेन निर्जितः ।\nमानात् स तप्तवान् राजन् वरार्थी सुमहत् तपः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2158629, "chapter_id": 4436, "verse_number": "१५", "content_sanskrit": "इन्द्रियाणीन्द्रियार्थेभ्यः प्रियेभ्यः सन्निवर्त्य सः ।\nक्षुत्पिपासातपसहः कृशो धमनिसन्ततः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2158630, "chapter_id": 4436, "verse_number": "१६", "content_sanskrit": "देवमाराधयच्छर्वं गृणन् ब्रह्म सनातनम् ।\nभक्तानुकम्पी भगवांस्तस्मिंश्चक्रे ततो दयाम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2158631, "chapter_id": 4436, "verse_number": "१९", "content_sanskrit": "तस्य चाल्पेन कालेन नियमेन सुतोषितः ।\nप्रीतो महेश्वरस्तस्मै वरं चेमं ददौ तथा\t॥१७॥\nस्वप्नान्तेऽथ ययावेनं हरः सिन्धुपतेः सुतम् ।\nवरं वृणीष्व प्रीतोऽस्मि जयद्रथ किमिच्छसि\t॥१८॥\nएवमुक्तस्तु शर्वेण सिन्धुराजो जयद्रथः ।\nउवाच प्रणतो रुद्रः प्राञ्जलिर्नियतात्मवान् ।\nपाण्डवेयानहं सङ्खे भीमवीर्यपराक्रमान्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2158632, "chapter_id": 4436, "verse_number": "२०", "content_sanskrit": "वारयेयं रथेनैकः समस्तानिति भारत \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2158633, "chapter_id": 4436, "verse_number": "२१", "content_sanskrit": "एवमुक्तस्तु देवेशो जयद्रथमथाब्रवीत् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2158634, "chapter_id": 4436, "verse_number": "२२", "content_sanskrit": "ददामि ते वरं सौम्य विना पार्थं जयद्रथ ।\nवारयिष्यसि सङ्ग्रामे चतुरः पाण्डुनन्दनान्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2158635, "chapter_id": 4436, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2158636, "chapter_id": 4436, "verse_number": "२३", "content_sanskrit": "एवमस्त्विति देवेशमुक्त्वाऽऽगात् स्वपुरं तदा ।\nतेनोक्तस्तमृते पार्थं जयं तस्मै वरं ददौ\nएकाहमिति राजेन्द्र तत्रैवादर्शनं ययौ\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2158637, "chapter_id": 4436, "verse_number": "२४", "content_sanskrit": "स तेन वरदानेन परमास्त्रबलेन च ।\nएकः संवारयामास पाण्डवानामनीकिनीम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2158638, "chapter_id": 4436, "verse_number": "२५", "content_sanskrit": "तस्य ज्यातळघोषेण क्षत्रियान् भयमाविशत् ।\nपरेषां तव सैन्यस्य हर्षः परमकोऽभवत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2158639, "chapter_id": 4436, "verse_number": "२६", "content_sanskrit": "दृष्ट्वा तं क्षत्रिया भारं सैन्धवे महदर्पितम् ।\nउत्क्रुश्याभ्यद्रवन् राजन् येन यौधिष्ठिरं बलम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2158640, "chapter_id": 4436, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां द्रोणपर्वणि एकचत्वारिंशोऽध्यायः ॥ ४१ ॥\nअभिमन्युवधपर्वणि दशमोऽध्यायः ॥ १० ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]