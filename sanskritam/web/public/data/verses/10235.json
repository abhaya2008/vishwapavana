[{"id": 6000235000, "chapter_id": 10235, "verse_number": null, "content_sanskrit": "अथ एकोनचत्वारिंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000235001, "chapter_id": 10235, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.001.m4a", "display_order": 2}, {"id": 6000235002, "chapter_id": 10235, "verse_number": "१०-३९-१", "content_sanskrit": "स्तुवतस्तस्य भगवान् दर्शयित्वा जले वपुः।\nभूयः समाहरत् कृष्णो नटो नाट्यमिवात्मनः॥ १०/३९/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.002.m4a", "display_order": 3, "topics": [{"text": "श्रीकृष्णस्य मधुरापुरीप्रवेशः", "range": "१–२३"}]}, {"id": 6000235003, "chapter_id": 10235, "verse_number": "१०-३९-२", "content_sanskrit": "सोऽपि चान्तर्हितं वीक्ष्य जलादुन्मज्ज्य सत्वरः।\nकृत्वा चावश्यकं सर्वं विस्मितो रथमाविशत्॥ १०/३९/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.003.m4a", "display_order": 4}, {"id": 6000235004, "chapter_id": 10235, "verse_number": "१०-३९-३", "content_sanskrit": "तमपृच्छद् हृषीकेशः किं ते दृष्टमिहाद्भुतम्।\nभूमौ वियति तोये वा तथा त्वां लक्षयामहे॥ १०/३९/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.004.m4a", "display_order": 5}, {"id": 6000235005, "chapter_id": 10235, "verse_number": null, "content_sanskrit": "अक्रूर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.005.m4a", "display_order": 6}, {"id": 6000235006, "chapter_id": 10235, "verse_number": "१०-३९-४", "content_sanskrit": "अद्भुतानीह यावन्ति भूमौ वियति वा जले।\nत्वयि विश्वात्मके तानि किं मेऽदृष्टं विपश्यतः॥ १०/३९/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.006.m4a", "display_order": 7}, {"id": 6000235007, "chapter_id": 10235, "verse_number": "१०-३९-५", "content_sanskrit": "यत्राद्भुतानि सर्वाणि भूमौ वियति वा जले।\nतं त्वाऽनुपश्यतो ब्रह्मन् किं मे दृष्टमिहाद्भुतम्॥ १०/३९/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.007.m4a", "display_order": 8}, {"id": 6000235008, "chapter_id": 10235, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.008.m4a", "display_order": 9}, {"id": 6000235009, "chapter_id": 10235, "verse_number": "१०-३९-६", "content_sanskrit": "इत्युक्त्वा चोदयामास स्यन्दनं गान्दिनीसुतः।\nमधुरामनयद् रामं कृष्णं चैव दिनात्यये॥ १०/३९/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.009.m4a", "display_order": 10}, {"id": 6000235010, "chapter_id": 10235, "verse_number": "१०-३९-७", "content_sanskrit": "मार्गे ग्रामजना राजंस्तत्र तत्रोपसङ्गताः।\nवसुदेवसुतौ वीक्ष्य प्रीता दृष्टिं न चाददुः॥ १०/३९/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.010.m4a", "display_order": 11}, {"id": 6000235011, "chapter_id": 10235, "verse_number": "१०-३९-८", "content_sanskrit": "तावद् व्रजौकसस्तात नन्दगोपादयोऽग्रतः।\nपुरोपवनमासाद्य प्रतीक्षन्तोऽवतस्थिरे॥ १०/३९/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.011.m4a", "display_order": 12}, {"id": 6000235012, "chapter_id": 10235, "verse_number": "१०-३९-९", "content_sanskrit": "तान् समेत्याह भगवानक्रूरं जगदीश्वरः।\nगृहीत्वा पाणिना पाणिं प्रश्रितं प्रहसन्निव॥ १०/३९/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.012.m4a", "display_order": 13}, {"id": 6000235013, "chapter_id": 10235, "verse_number": "१०-३९-१०", "content_sanskrit": "भवान् प्रविशतामग्रे सहयानः पुरीं गृहम्।\nवयं त्विहावमुच्याथ तावद् द्रक्ष्यामहे पुरीम्॥ १०/३९/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.013.m4a", "display_order": 14}, {"id": 6000235014, "chapter_id": 10235, "verse_number": null, "content_sanskrit": "अक्रूर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.014.m4a", "display_order": 15}, {"id": 6000235015, "chapter_id": 10235, "verse_number": "१०-३९-११", "content_sanskrit": "नाहं भवद्भ्यां रहितः प्रवेक्ष्ये मधुरां प्रभो।\nत्यक्तुं नार्हसि मां नाथ भक्तं ते भक्तवत्सल॥ १०/३९/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.015.m4a", "display_order": 16}, {"id": 6000235016, "chapter_id": 10235, "verse_number": "१०-३९-१२", "content_sanskrit": "आगच्छ याम गेहान्नः सनाथान् कुर्वधोक्षज।\nसाग्रजः सह गोपालैः सुहृद्भिश्च सुहृत्तम॥ १०/३९/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.016.m4a", "display_order": 17}, {"id": 6000235017, "chapter_id": 10235, "verse_number": "१०-३९-१३", "content_sanskrit": "पुनीहि पादरजसा गृहान् नो गृहमेधिनाम्।\nयच्छौचेनातितृप्यन्ति पितरः साग्नयः सुराः॥ १०/३९/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.017.m4a", "display_order": 18}, {"id": 6000235018, "chapter_id": 10235, "verse_number": "१०-३९-१४", "content_sanskrit": "अवनिज्याङ्घ्रियुगलमासीच्छ्लाघ्यो बलिर्मखे।\nऐश्वर्यमतुलं लेभे गतिं चैकान्तिनां तु या॥ १०/३९/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.018.m4a", "display_order": 19}, {"id": 6000235019, "chapter_id": 10235, "verse_number": "१०-३९-१५", "content_sanskrit": "आपस्तेऽङ्घ्र्यवनेजन्यस्‍त्रीँल्लोकान् शुचयोऽपुनन्।\nशिरसाऽधत्त याः शर्वः स्वर्याताः सगरात्मजाः॥ १०/३९/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.019.m4a", "display_order": 20}, {"id": 6000235020, "chapter_id": 10235, "verse_number": "१०-३९-१६", "content_sanskrit": "देवदेव जगन्नाथ पुण्यश्रवणकीर्तन।\nयदूत्तमोत्तमश्लोक नारायण नमोऽस्तु ते॥ १०/३९/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.020.m4a", "display_order": 21}, {"id": 6000235021, "chapter_id": 10235, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.021.m4a", "display_order": 22}, {"id": 6000235022, "chapter_id": 10235, "verse_number": "१०-३९-१७", "content_sanskrit": "आयास्ये भवतो गेहमहमार्यसमन्वितः।\nयदुवर्गद्रुहं हत्वा वितरिष्ये सुहृत्प्रियम्॥ १०/३९/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.022.m4a", "display_order": 23}, {"id": 6000235023, "chapter_id": 10235, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.023.m4a", "display_order": 24}, {"id": 6000235024, "chapter_id": 10235, "verse_number": "१०-३९-१८", "content_sanskrit": "एवमुक्तो भगवता सोऽक्रूरो विमना इव।\nपुरीं प्रविश्य कंसाय कर्मावेद्य गृहं ययौ॥ १०/३९/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.024.m4a", "display_order": 25}, {"id": 6000235025, "chapter_id": 10235, "verse_number": "१०-३९-१९", "content_sanskrit": "ततोऽपराह्णे भगवान् कृष्णः सङ्कर्षणान्वितः।\nमधुरां प्राविशद् गोपैर्दिदृक्षुः परिवारितः॥ १०/३९/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.025.m4a", "display_order": 26}, {"id": 6000235026, "chapter_id": 10235, "verse_number": "१०-३९-२०", "content_sanskrit": "ददर्श तां स्फाटिकतुङ्गगोपुरां बृहत्स्फुरद्धेमकपाटतोरणाम्।\nताम्रारकोष्ठां परिखादुरासदामुद्यानरम्योपवनालिशोभिताम्॥ १०/३९/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.026.m4a", "display_order": 27}, {"id": 6000235027, "chapter_id": 10235, "verse_number": "१०-३९-२१", "content_sanskrit": "सौवर्णशृङ्गाटकहर्म्यनिष्कुटैः श्रेणीसभाभिर्भवनैरुपस्कृताम्।\nवैढूर्यवज्रामलनीलविद्रुमैर्मुक्ताहरिद्भिर्वलभीषु वेदिषु॥ १०/३९/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.027.m4a", "display_order": 28}, {"id": 6000235028, "chapter_id": 10235, "verse_number": "१०-३९-२२", "content_sanskrit": "जुष्टेषु जालामुखरन्ध्रकुट्टिमेष्वाविष्टपारावतबर्हिनादिताम्।\nसंसिक्तरथ्यापणमार्गचत्वरां प्रकीर्णमाल्याङ्कुरलाजतण्डुलाम्॥ १०/३९/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.028.m4a", "display_order": 29}, {"id": 6000235029, "chapter_id": 10235, "verse_number": "१०-३९-२३", "content_sanskrit": "आपूर्णकुम्भैर्दधिचन्दनोक्षितैः प्रसूनदीपावलिभिः सपल्लवैः।\nसवृन्तरम्भाक्रमुकैः सकेतुभिः स्वलङ्कृतद्वारगृहां सपट्टिकैः॥ १०/३९/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.029.m4a", "display_order": 30}, {"id": 6000235030, "chapter_id": 10235, "verse_number": "१०-३९-२४", "content_sanskrit": "तां सम्प्रविष्टौ वसुदेवनन्दनौ वृतौ वयस्यैर्नरदेववर्त्मना।\nद्रष्टुं समीयुस्त्वरिताः पुरस्‍त्रियो हर्म्याणि चैवारुरुहुर्नृपोत्सुकाः॥ १०/३९/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.030.m4a", "display_order": 31, "topics": [{"text": "मधुरापुरस्त्रीणां श्रीकृष्णदर्शने प्रेमातिशयवर्णनम्", "range": "२४–२९"}]}, {"id": 6000235031, "chapter_id": 10235, "verse_number": "१०-३९-२५", "content_sanskrit": "काश्चिद् विपर्यक्कृतवस्‍त्रभूषणा विस्मृत्य चैकं युगलेष्वथापराः।\nकृतैकवस्‍त्रश्रवणैकनूपुरा नाङ्क्त्वा द्वितीयं त्वपराश्च लोचनम्॥ १०/३९/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.031.m4a", "display_order": 32}, {"id": 6000235032, "chapter_id": 10235, "verse_number": "१०-३९-२६", "content_sanskrit": "अश्नन्त्य एकास्तदपास्य सोत्सवा अभ्यज्यमाना अकृतोपमज्जनाः।\nस्वपन्त्य उत्थाय निशम्य निःस्वनं निपाययन्त्योऽर्भमपोह्य मातरः॥ १०/३९/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.032.m4a", "display_order": 33}, {"id": 6000235033, "chapter_id": 10235, "verse_number": "१०-३९-२७", "content_sanskrit": "मनांसि तासामरविन्दलोचनः प्रगल्भलीलाहसितावलोकनैः।\nजहार मत्तद्विरदेन्द्रविक्रमो दृशां ददच्छ्रीरमणो महोत्सवम्॥ १०/३९/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.033.m4a", "display_order": 34}, {"id": 6000235034, "chapter_id": 10235, "verse_number": "१०-३९-२८", "content_sanskrit": "दृष्ट्वा मुहुः श्रुतमनुद्रुतचेतसस्तं तत्प्रेक्षणोत्स्मितसुधोक्षणलब्धमानाः।\nआनन्दमूर्तिमुपगुह्य दृशात्मलब्धं हृष्यत्त्वचो जहुरनन्तमरिन्दमाधिम्॥ १०/३९/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.034.m4a", "display_order": 35}, {"id": 6000235035, "chapter_id": 10235, "verse_number": "१०-३९-२९", "content_sanskrit": "प्रासादशिखरारूढाः प्रीत्युत्फुल्लमुखाम्बुजाः।\nअभ्यवर्षन् सौमनस्यैः प्रमदा बलकेशवौ॥ १०/३९/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.035.m4a", "display_order": 36}, {"id": 6000235036, "chapter_id": 10235, "verse_number": "१०-३९-३०", "content_sanskrit": "दध्यक्षतैः सोदपात्रैः स्रग्गन्धैरभ्युपायनैः।\nतावानर्चुः प्रमुदितास्तत्र तत्र द्विजातयः॥ १०/३९/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.036.m4a", "display_order": 37, "topics": [{"text": "श्रीकृष्णेन रजकस्य वधः", "range": "३०–३६"}]}, {"id": 6000235037, "chapter_id": 10235, "verse_number": "१०-३९-३१", "content_sanskrit": "रजकं कञ्चिदायान्तं रङ्गकारं गदाग्रजः।\nदृष्ट्वाऽयाचत वासांसि धौतान्यत्युत्तमानि च॥ १०/३९/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.037.m4a", "display_order": 38}, {"id": 6000235038, "chapter_id": 10235, "verse_number": "१०-३९-३२", "content_sanskrit": "देह्यावयोः समुचितान्यङ्ग वासांसि चार्हतोः।\nभविष्यति परं श्रेयो दातुस्ते नात्र संशयः॥ १०/३९/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.038.m4a", "display_order": 39}, {"id": 6000235039, "chapter_id": 10235, "verse_number": "१०-३९-३३", "content_sanskrit": "स याचितो भगवता परिपूर्णेन सर्वतः।\nसाक्षेपं रुषितः प्राह भृत्यो राज्ञः सुदुर्मदः॥ १०/३९/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.039.m4a", "display_order": 40}, {"id": 6000235040, "chapter_id": 10235, "verse_number": "१०-३९-३४", "content_sanskrit": "ईदृशान्येव वासांसि नित्यं गिरिवनेचराः।\nपरिधत्त किमुद्वृत्ता राजद्रव्याण्यभीप्सथ॥ १०/३९/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.040.m4a", "display_order": 41}, {"id": 6000235041, "chapter_id": 10235, "verse_number": "१०-३९-३५", "content_sanskrit": "याताशु बालिशा मैवं प्रार्थ्यं यदि जिजीविषा।\nबध्नन्ति घ्नन्ति लुम्पन्ति दृप्तं राजकुलानि हि॥ १०/३९/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.041.m4a", "display_order": 42}, {"id": 6000235042, "chapter_id": 10235, "verse_number": "१०-३९-३६", "content_sanskrit": "इत्थं विकत्थमानस्य कुपितो देवकीसुतः।\nरजकस्य कराग्रेण शिरः कायादपाहरत्॥ १०/३९/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.042.m4a", "display_order": 43}, {"id": 6000235043, "chapter_id": 10235, "verse_number": "१०-३९-३७", "content_sanskrit": "तस्यानुजीविनः सर्वे वासःकोशान् विसृज्य वै।\nदुद्रुवुः सर्वतो मार्गे वासांसि जगृहेऽच्युतः॥ १०/३९/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.043.m4a", "display_order": 44, "topics": [{"text": "वायकसुदामभ्यां वरदानम्", "range": "३७–५१"}]}, {"id": 6000235044, "chapter_id": 10235, "verse_number": "१०-३९-३८", "content_sanskrit": "वसित्वाऽऽत्मप्रिये वस्‍त्रे कृष्णः सङ्कर्षणस्तथा।\nशेषाण्यादत्त गोपेभ्यो विसृज्य भुवि कानिचित्॥ १०/३९/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.044.m4a", "display_order": 45}, {"id": 6000235045, "chapter_id": 10235, "verse_number": "१०-३९-३९", "content_sanskrit": "ततस्तु वायकः प्रीतस्तयोर्वेषमकल्पयत्।\nविचित्रवर्णैः शैलेयैराकल्पैरनुरूपतः॥ १०/३९/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.045.m4a", "display_order": 46}, {"id": 6000235046, "chapter_id": 10235, "verse_number": "१०-३९-४०", "content_sanskrit": "नानालक्षणवेषाभ्यां कृष्णरामौ विरेजतुः।\nस्वलङ्कृतौ बालगजौ पर्वणीव सितेतरौ॥ १०/३९/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.046.m4a", "display_order": 47}, {"id": 6000235047, "chapter_id": 10235, "verse_number": "१०-३९-४१", "content_sanskrit": "तस्य प्रसन्नो भगवान् प्रादात् सारूप्यमात्मनः।\nश्रियं च परमां लोके बलैश्वर्यस्मृतीन्द्रियम्॥ १०/३९/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.047.m4a", "display_order": 48}, {"id": 6000235048, "chapter_id": 10235, "verse_number": "१०-३९-४२", "content_sanskrit": "ततः सुदाम्नो भवनं मालाकारस्य जग्मतुः।\nतौ दृष्ट्वा स समुत्थाय ननाम शिरसा भुवि॥ १०/३९/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.048.m4a", "display_order": 49}, {"id": 6000235049, "chapter_id": 10235, "verse_number": "१०-३९-४३", "content_sanskrit": "तयोरासनमानीय पाद्यं चाथार्हणादिभिः।\nपूजां सानुगयोश्चक्रे स्रक्ताम्बूलानुलेपनैः॥ १०/३९/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.049.m4a", "display_order": 50}, {"id": 6000235050, "chapter_id": 10235, "verse_number": "१०-३९-४४", "content_sanskrit": "प्राह नः सार्थकं जन्म पावितं च कुलं प्रभो।\nपितृदेवर्षयो मह्यं तुष्टा ह्यागमनेन वाम्॥ १०/३९/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.050.m4a", "display_order": 51}, {"id": 6000235051, "chapter_id": 10235, "verse_number": "१०-३९-४५", "content_sanskrit": "भवन्तौ किल विश्वस्य जगतः कारणं परम्।\nअवतीर्णाविहांशेन क्षेमाय च भवाय च॥ १०/३९/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.051.m4a", "display_order": 52}, {"id": 6000235052, "chapter_id": 10235, "verse_number": "१०-३९-४६", "content_sanskrit": "न हि वां विषमा दृष्टिः सुहृदोर्जगदात्मनोः।\nसमयोः सर्वभूतेषु भजन्तं भजतोरपि॥ १०/३९/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.052.m4a", "display_order": 53}, {"id": 6000235053, "chapter_id": 10235, "verse_number": "१०-३९-४७", "content_sanskrit": "शाध्याज्ञापय मां भृत्यं किमहं करवाणि वाम्।\nपुंसोऽत्यनुग्रहो ह्येष भवद्भिर्यन्नियुज्यते॥ १०/३९/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.053.m4a", "display_order": 54}, {"id": 6000235054, "chapter_id": 10235, "verse_number": "१०-३९-४८", "content_sanskrit": "इत्यभिप्रेत्य राजेन्द्र सुदामा प्रीतमानसः।\nशस्तैः सुगन्धैः कुसुमैर्माला विरचिता ददौ॥ १०/३९/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.054.m4a", "display_order": 55}, {"id": 6000235055, "chapter_id": 10235, "verse_number": "१०-३९-४९", "content_sanskrit": "ताभिः स्वलङ्कृतौ प्रीतौ कृष्णरामौ सहानुगौ।\nप्रणताय प्रपन्नाय ददतुर्वरदौ वरान्॥ १०/३९/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.055.m4a", "display_order": 56}, {"id": 6000235056, "chapter_id": 10235, "verse_number": "१०-३९-५०", "content_sanskrit": "सोऽपि वव्रेऽचलां भक्तिं तस्मिन्नेवाखिलात्मनि।\nतद्भक्तेषु च सौहार्दं भूतेषु च दयां पराम्॥ १०/३९/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.056.m4a", "display_order": 57}, {"id": 6000235057, "chapter_id": 10235, "verse_number": "१०-३९-५१", "content_sanskrit": "इति तस्मै वरं दत्वा श्रियं चान्वयवर्धिनीम्।\nबलमायुर्यशः कान्तिं निर्जगाम सहाग्रजः॥ १०/३९/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_039/BhP_10.039.057.m4a", "display_order": 58}, {"id": 6000235058, "chapter_id": 10235, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे एकोनचत्वारिंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]