[{"id": 2163858, "chapter_id": 4533, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2163859, "chapter_id": 4533, "verse_number": "१", "content_sanskrit": "ततो दुर्योधनो राजा द्रोणेनैवं प्रचोदितः ।\nअमर्षवशमापन्नो युद्धायैव मनो दधे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2163860, "chapter_id": 4533, "verse_number": "२", "content_sanskrit": "अब्रवीच्च तदा कर्णं पुत्रो दुर्योधनस्तव ।\nपश्य कृष्णसहायेन पाण्डवेन किरीटिना ।\nआचार्यविहितं व्यूहं भिन्नं देवैः सुदुर्भिदम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2163861, "chapter_id": 4533, "verse_number": "३", "content_sanskrit": "तव व्यायच्छमानस्य द्रोणस्य च महात्मनः ।\nमिषतां योधमुख्यानां सैन्धवो विनिपातितः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2163862, "chapter_id": 4533, "verse_number": "४", "content_sanskrit": "पश्य राधेय राजानः पृथिव्यां प्रवरा युधि ।\nपार्थेनैकेन निहताः सिंहेनेवेतरा मृगाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2163863, "chapter_id": 4533, "verse_number": "५", "content_sanskrit": "मम व्यायच्छमानस्य समरे शत्रुसूदन ।\nअल्पावशेषं सैन्यं मे कृतं शक्रात्मजेन ह\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2163864, "chapter_id": 4533, "verse_number": "६", "content_sanskrit": "कथं ह्यनिच्छमानस्य द्रोणस्य युधि फल्गुनः ।\nभिन्द्यात् सुदुर्भिदं व्यूहं यतमानोऽपि संयुगे\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2163865, "chapter_id": 4533, "verse_number": "७", "content_sanskrit": "प्रियो हि फल्गुनो नित्यमाचार्यस्य महात्मनः ।\nततोऽस्य दत्तवान् द्वारं नयुद्धेनारिमर्दन\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2163866, "chapter_id": 4533, "verse_number": "८", "content_sanskrit": "अभयं सैन्धवस्याजौ दत्त्वा द्रोणः परन्तपः ।\nप्रादात् किरीटिने द्वारं पश्यन् निर्गुणतां मम\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2163867, "chapter_id": 4533, "verse_number": "९", "content_sanskrit": "यद्यदास्यमनुज्ञां वै पूर्वमेव गृहान् प्रति ।\nसिन्धुराजस्य समरे नाभविष्यज्जनक्षयः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2163868, "chapter_id": 4533, "verse_number": "१०", "content_sanskrit": "जयद्रथो जीवितार्थी गच्छमानो गृहान् प्रति ।\nमयानार्येण संरुद्धो द्रोणात् प्राप्याभयं रणे\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2163869, "chapter_id": 4533, "verse_number": "११", "content_sanskrit": "अद्य मे भ्रातरः क्षीणाश्चित्रसेनादयो युधि ।\nभीमसेनं समासाद्य पश्यतां नो दुरात्मनाम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2163870, "chapter_id": 4533, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2163871, "chapter_id": 4533, "verse_number": "१२", "content_sanskrit": "आचार्यं मा विगर्हस्व शक्त्या युद्ध्यत्यसौ द्विजः ।\nअजय्यान् पाण्डवान् मन्ये द्रोणेनास्त्रविदा मृधे\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2163872, "chapter_id": 4533, "verse_number": "१३", "content_sanskrit": "तथा ह्येनमतिक्रम्य प्रविष्टः श्वेतवाहनः ।\nदैवदृष्टोऽन्यथाभावो न मन्ये विद्यते क्वचित्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2163873, "chapter_id": 4533, "verse_number": "१४", "content_sanskrit": "ततो नो युद्ध्यमानानां परं शक्त्या सुयोधन ।\nसैन्धवो निहतो राजन् दैवमत्र परं स्मृतम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2163874, "chapter_id": 4533, "verse_number": "१५", "content_sanskrit": "परं यत्नं कुर्वतां च त्वया सार्धं रणाजिरे ।\nहत्वास्माकं पौरुषं हि दैवं पश्चात्करोति नः ।\nसततं चेष्टमानानां निकृत्या विक्रमेण च\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2163875, "chapter_id": 4533, "verse_number": "१६", "content_sanskrit": "दैवोपसृष्टः पुरुषो यत् कर्म कुरुते क्वचित् ।\nकृतं कृतं स्म तत् तस्य दैवेन विनिहन्यते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2163876, "chapter_id": 4533, "verse_number": "१७", "content_sanskrit": "यत् कर्तव्यं मनुष्येण व्यवसायवता सता ।\nतत्कार्यमविशङ्केन सिद्धिर्दैवे प्रतिष्ठिता\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2163877, "chapter_id": 4533, "verse_number": "१८", "content_sanskrit": "निकृत्या निकृताः पार्था विषयोगैश्च भारत ।\nदग्धा जतुगृहे चापि द्यूतेन च पराजिताः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2163878, "chapter_id": 4533, "verse_number": "१९", "content_sanskrit": "राजनीतिं व्यपाश्रित्य प्रहिताश्चैव काननम् ।\nयत्नेन च कृतं यत् ते दैवेन विनिपातितम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2163879, "chapter_id": 4533, "verse_number": "२०", "content_sanskrit": "युद्ध्यस्व यत्नमास्थाय मृत्युं कृत्वा निवर्तनम् ।\nयततस्तव तेषां च दैवं मार्गेण यास्यति\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2163880, "chapter_id": 4533, "verse_number": "२१", "content_sanskrit": "न तेषां मतिपूर्वं हि सुकृतं दृश्यते क्वचित् ।\nदुष्कृतं तव वा वीर बुद्ध्या हीनं कुरूद्वह\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2163881, "chapter_id": 4533, "verse_number": "२२", "content_sanskrit": "दैवं प्रमाणं सर्वस्य सुकृतस्येतरस्य वा ।\nअनन्यकर्म दैवं हि जागर्ति स्वपतामपि\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2163882, "chapter_id": 4533, "verse_number": "२३", "content_sanskrit": "बहूनि तव सैन्यानि योधाश्च बहवस्तथा ।\nन तथा पाण्डुपुत्राणामेवं युद्धमवर्तत\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2163883, "chapter_id": 4533, "verse_number": "२४", "content_sanskrit": "तैरल्पैर्बहवो यूयं क्षयं नीताः प्रहारिणः ।\nशङ्के दैवस्य तत्कर्म पौरुषं येन नाशितम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2163884, "chapter_id": 4533, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2163885, "chapter_id": 4533, "verse_number": "२५", "content_sanskrit": "एवं सम्भाषमाणानां बहु तत्तज्जनाधिप ।\nपाण्डवानामनीकानि समदृश्यन्त संयुगे\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2163886, "chapter_id": 4533, "verse_number": "२६", "content_sanskrit": "ततः प्रववृते युद्धं व्यतिषक्तरथद्विपम् ।\nतावकानां परैः सार्धं राजन् दुर्मन्त्रिते तव\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2163887, "chapter_id": 4533, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि अष्टत्रिंशदधिकशततमोऽध्यायः ॥ १३८ ॥\nघटोत्कचवधपर्वणि षष्ठोऽध्यायः ॥ ६ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]