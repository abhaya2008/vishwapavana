[{"id": 2055125, "chapter_id": 2206, "verse_number": "७-१३३-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2055126, "chapter_id": 2206, "verse_number": "७-१३३-१", "content_sanskrit": "अत्यद्भुतमहं मन्ये भीमसेनस्य विक्रमम्।\nयत्कर्णं योधयामास समरे लघुविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2055127, "chapter_id": 2206, "verse_number": "७-१३३-२", "content_sanskrit": "त्रिदशानपि वा युक्तान्सर्वशस्त्रधरान्युधि।\nवारयेद्यो रणे कर्णः सयक्षासुरमानुषान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2055128, "chapter_id": 2206, "verse_number": "७-१३३-३", "content_sanskrit": "स कथं पाण्डवं युद्धे भ्राजमानमिव श्रिया।\nनातरत्संयुगे तात तन्ममाचक्ष्व सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2055129, "chapter_id": 2206, "verse_number": "७-१३३-४", "content_sanskrit": "कथं च युद्धं सम्भूतं तयोः प्राणदुरोदरे।\nअत्र मन्ये समायत्तो जयो वाऽजय एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2055130, "chapter_id": 2206, "verse_number": "७-१३३-५", "content_sanskrit": "कर्णं प्राप्य रणे सूत मम पुत्रः सुयोधनः।\nजेतुमुत्सहते पार्थान्सगोविन्दान्ससात्वतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2055131, "chapter_id": 2206, "verse_number": "७-१३३-६", "content_sanskrit": "श्रुत्वा तु निर्जितं कर्णमसकृद्भीमकर्मणा।\nभीमसेनेन समरे मोह आविशतीव माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2055132, "chapter_id": 2206, "verse_number": "७-१३३-७", "content_sanskrit": "विनष्टान्कौरवान्मन्ये मम पुत्रस्य दुर्नयैः।\nनहि कर्णो महेष्वासान्पार्थाञ्जेष्यति सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2055133, "chapter_id": 2206, "verse_number": "७-१३३-८", "content_sanskrit": "कृतवान्यानि युद्धानि कर्णः पाण्डुसुतैः सह।\nसर्वत्र पाण्डवाः कर्णमजयंस्ते रणाजिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2055134, "chapter_id": 2206, "verse_number": "७-१३३-९", "content_sanskrit": "अजेयाः पाण्डवास्तात देवैरपि सवासवैः।\nन च तद्बुध्यते मन्दः पुत्रो दुर्योधनो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2055135, "chapter_id": 2206, "verse_number": "७-१३३-१०", "content_sanskrit": "धनं धनेश्वरस्येव हृत्वा पार्थस्य मे सुतः।\nमधुप्रेप्सुरिवाबुद्धिः प्रपातं नावबुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2055136, "chapter_id": 2206, "verse_number": "७-१३३-११", "content_sanskrit": "निकृत्या निकृतिप्रज्ञो राज्यं हृत्वा महात्मनाम्।\nजितमित्येव मन्वानः पाण्डवानवमन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2055137, "chapter_id": 2206, "verse_number": "७-१३३-१२", "content_sanskrit": "पुत्रस्नेहाभिभूतेन मया चाप्यकृतात्मना।\nधर्मे स्थिता महात्मानो निकृताः पाण्डुनन्दनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2055138, "chapter_id": 2206, "verse_number": "७-१३३-१३", "content_sanskrit": "शमकामः ससोदर्यो दीर्घप्रेक्षी युधिष्ठिरः।\nअशक्त इति मत्वा तु मम पुत्रैर्निराकृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2055139, "chapter_id": 2206, "verse_number": "७-१३३-१४", "content_sanskrit": "तानि दुःखान्यनेकानि विप्रकारांश्च सर्वशः।\nहृदि कृत्वा महाबाहुर्भीमोऽयुध्यत सूतजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2055140, "chapter_id": 2206, "verse_number": "७-१३३-१५", "content_sanskrit": "तस्मान्मे सञ्जय ब्रूहि कर्णभीमौ यथा रणे।\nअयुध्येतां युधांश्रेष्ठौ परस्परवधैषिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2055141, "chapter_id": 2206, "verse_number": "७-१३३-१६x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2055142, "chapter_id": 2206, "verse_number": "७-१३३-१६", "content_sanskrit": "शृणु राजन्यथावृत्तं सङ्ग्रामं कर्णभीमयोः।\nपरस्परवधप्रेप्स्वोर्वनकुञ्जरयोरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2055143, "chapter_id": 2206, "verse_number": "७-१३३-१७", "content_sanskrit": "राजन्वैकर्तनो भीमं क्रुद्धः क्रुद्धमरिन्दमम्।\nपराक्रान्तं पराक्रम्य विव्याध त्रिंशता शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2055144, "chapter_id": 2206, "verse_number": "७-१३३-१८", "content_sanskrit": "महावेगैः प्रसन्नाग्रैः शातकुम्भपरिष्कृतैः।\nनातरद्भरतश्रेष्ठ भीमं वैकर्तनः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2055145, "chapter_id": 2206, "verse_number": "७-१३३-१९", "content_sanskrit": "तस्यास्यतो धनुर्भीमश्चकर्त विशिखैस्त्रिभिः।\nरथनीडाच्च यन्तारं भल्लेनापातयत्क्षितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2055146, "chapter_id": 2206, "verse_number": "७-१३३-२०", "content_sanskrit": "स काङ्क्षन्भीमसेनस्य वधं वैकर्तनो भृशम्।\nशक्तिं कनकवैदूर्यचित्रदण्डां परामृशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2055147, "chapter_id": 2206, "verse_number": "७-१३३-२१", "content_sanskrit": "प्रगृह्य च महाशक्तिं कालरात्रिमिवापराम्।\nसमुत्क्षिप्य च राधेयः सन्धाय च महाबलः।\nचिक्षेप भीमसेनाय जीवितान्तकरीमिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2055148, "chapter_id": 2206, "verse_number": "७-१३३-२२", "content_sanskrit": "शक्तिं विसृज्य राधेयः पुरन्दर इवाशनिम्।\nननाद सुमहानादं बलवान्सूतनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2055149, "chapter_id": 2206, "verse_number": "७-१३३-२३", "content_sanskrit": "तं च नादं ततः श्रुत्वा पुत्रास्ते हर्षिताऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2055150, "chapter_id": 2206, "verse_number": "७-१३३-२४", "content_sanskrit": "शक्तिं वियति चिच्छेद भीमः सप्तभिराशुगैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2055151, "chapter_id": 2206, "verse_number": "७-१३३-२५", "content_sanskrit": "छित्त्वा शक्तिं ततो भीमो निर्मुक्तोरगसन्निभाम्।\nमार्गमाणामिव प्राणान्सूतपुत्रस्य मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2055152, "chapter_id": 2206, "verse_number": "७-१३३-२६", "content_sanskrit": "प्राहिणोत्कृतसंरम्भः शरान्बर्हिणवाससः।\nस्वर्णपुङ्खाञ्शिलाधौतान्यमदण्डोपमान्मृधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2055153, "chapter_id": 2206, "verse_number": "७-१३३-२७", "content_sanskrit": "कर्णोऽप्यन्यद्धनुर्गृह्य हेमपृष्ठं दुरासदम्।\nविकृष्य तन्महच्चापं व्यसृजत्सायकांस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2055154, "chapter_id": 2206, "verse_number": "७-१३३-२८", "content_sanskrit": "तान्पाण्डुपुत्रश्चिच्छेद नवभिर्नतपर्वभिः।\nवसुषेणेन निर्मुक्तान्नव राजन्महाशरान्।\nछित्त्वा भीमो महाराज नादं सिंह इवानदत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2055155, "chapter_id": 2206, "verse_number": "७-१३३-२९", "content_sanskrit": "तौ वृषाविव नर्दन्तौ बलिनौ वासितान्तरे।\nशार्दूलाविव चान्योन्यमामिषार्थेऽभ्यगर्जताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2055156, "chapter_id": 2206, "verse_number": "७-१३३-३०", "content_sanskrit": "अन्योन्यं प्रजिहीर्षन्तावन्योन्यस्यान्तरैषिणौ।\nअन्योन्यमभिवीक्षन्तौ गोष्ठेष्विव महर्षभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2055157, "chapter_id": 2206, "verse_number": "७-१३३-३१", "content_sanskrit": "महागजाविवसाद्य विषाणाग्रैः परस्परम्।\nशरैः पूर्णायतोत्सृष्टैरन्योन्यमभिजघ्नतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2055158, "chapter_id": 2206, "verse_number": "७-१३३-३२", "content_sanskrit": "निर्दहन्तौ महाराज शस्त्रवृष्ट्या परस्परम्।\nअन्योन्यमभिवीक्षन्तौ कोपाद्विवृतलोचनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2055159, "chapter_id": 2206, "verse_number": "७-१३३-३३", "content_sanskrit": "प्रहसन्तौ तथाऽन्योन्यं भर्त्सयन्तौ मुहुर्मुहुः।\nशङ्खशब्दं च कुर्वाणौ युयुधाते परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2055160, "chapter_id": 2206, "verse_number": "७-१३३-३४", "content_sanskrit": "तस्य भीमः पुनश्चापं मुष्टौ चिच्छेद मारिष।\nशङ्खवर्णांश्च तानश्वान्बाणैर्निन्ये यमक्षयम्।\nसारथिं च तथाप्यस्य रथनीडादपातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2055161, "chapter_id": 2206, "verse_number": "७-१३३-३५", "content_sanskrit": "ततो वैकर्तनः कर्णश्चिन्तां प्राप दुरत्ययाम्।\nस च्छाद्यमानः समरे हताश्वो हतसारथिः।\nमोहितः शरजालेन कर्तव्यं नाभ्यपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2055162, "chapter_id": 2206, "verse_number": "७-१३३-३६", "content_sanskrit": "तथा कृच्छ्रगतं दृष्ट्वा कर्णं दुर्योधनो नृपः।\nवेपमान इव क्रोधाद्व्यादिदेशाथ दुर्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2055163, "chapter_id": 2206, "verse_number": "७-१३३-३७", "content_sanskrit": "गच्छ दुर्जय राधेयं पुरा ग्रसति पाण्डवः।\nजहि तूबरकं क्षिप्रं कर्णस्य बलमादधत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2055164, "chapter_id": 2206, "verse_number": "७-१३३-३८", "content_sanskrit": "एवमुक्तस्तथेत्युक्त्वा तव पुत्रं तवात्मजः।\nअभ्यद्रवद्भीमसेनं व्यासक्तं विकिरञ्छरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2055165, "chapter_id": 2206, "verse_number": "७-१३३-३९", "content_sanskrit": "स भीमं नवभिर्बाणैरश्वानष्टभिरार्दयत्।\nषङ्भिः सूतं त्रिभिः केतं पुनस्तं चापि सप्तभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2055166, "chapter_id": 2206, "verse_number": "७-१३३-४०", "content_sanskrit": "भीमसेनोऽपि सङ्क्रुद्धः साश्वयन्तारमाशुगैः।\nदुर्जयं भिन्नमर्माणमनयद्यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2055167, "chapter_id": 2206, "verse_number": "७-१३३-४१", "content_sanskrit": "बाढं हतं क्षितौ क्षुण्णं वेष्टमानं यथोरगम्।\nरुदन्नार्तस्तव सुतं कर्णश्चक्रे प्रदक्षिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2055168, "chapter_id": 2206, "verse_number": "७-१३३-४२", "content_sanskrit": "स तु तं विरथं कृत्वा स्मयन्नत्यन्तवैरिणम्।\nसमाचिनोद्बाणगणैः शतघ्नीभिश्च शङ्कुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2055169, "chapter_id": 2206, "verse_number": "७-१३३-४३", "content_sanskrit": "तथाप्यतिरथः कर्णो भिद्यमानोऽस्य सायकैः।\nन जहौ समरे भीमं क्रुद्धरूपं परन्तपः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2055170, "chapter_id": 2206, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्दशदिवसयुद्धे त्रयस्त्रिंशदधिकशततमोऽध्यायः॥ १३३ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१३३-४ प्राणदुरोदरे प्राणद्युते॥ ५-१३३-१३३ त्रयस्त्रिंशदधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]