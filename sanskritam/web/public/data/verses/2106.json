[{"id": 2050524, "chapter_id": 2106, "verse_number": "७-३३-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2050525, "chapter_id": 2106, "verse_number": "७-३३-१", "content_sanskrit": "पूर्वमस्मासु भग्नेषु फल्गुगेनामितौजसा।\nद्रोणे च मोघसङ्कल्पे रक्षिते च युधिष्ठिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2050526, "chapter_id": 2106, "verse_number": "७-३३-२", "content_sanskrit": "सर्वे विध्वस्तकवचास्तावका युधि निर्जिताः।\nरजस्वला भृशोद्विग्ना वीक्षमाणा दिशो दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2050527, "chapter_id": 2106, "verse_number": "७-३३-३", "content_sanskrit": "अवहारं ततः कृत्वा भारद्वाजस्य सम्मते।\nलब्धलक्षैः शरैर्भिन्ना भृशावहसिता रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2050528, "chapter_id": 2106, "verse_number": "७-३३-४", "content_sanskrit": "श्लाघमानेषु भूतेषु फल्गुनस्यामितान्गुणान्।\nकेशवस्य च सौहार्दे कीर्त्यमानेऽर्जुनं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2050529, "chapter_id": 2106, "verse_number": "७-३३-५", "content_sanskrit": "अभिशस्ता इवाभूवन्ध्यानमूकत्वमास्थिताः।\nततः प्रभातसमये द्रोणं द्रुयोधनोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2050530, "chapter_id": 2106, "verse_number": "७-३३-६", "content_sanskrit": "प्रणयादभिमानाच्च द्विषद्वृद्ध्या च दुर्मनाः।\nशृण्वतां सर्वयोधानां संरब्धो वाक्यकोविदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2050531, "chapter_id": 2106, "verse_number": "७-३३-७", "content_sanskrit": "नूनं वयं वध्यपक्षे भवतो द्विजसत्तम।\nतथाहि नाग्रहीः प्राप्तं समीपेऽद्य युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2050532, "chapter_id": 2106, "verse_number": "७-३३-८", "content_sanskrit": "इच्छतस्ते न मुच्येत चक्षुःप्राप्तो रणे रिपुः।\nजिघृक्षतो रक्ष्यमाणः सामरैरपि पाण्डवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2050533, "chapter_id": 2106, "verse_number": "७-३३-९", "content_sanskrit": "वरं दत्त्वा मम प्रीतः पश्चाद्विकृतवानसि।\nआशाभङ्गं न कुर्वन्ति भक्तस्यार्याः कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2050534, "chapter_id": 2106, "verse_number": "७-३३-१०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2050535, "chapter_id": 2106, "verse_number": "७-३३-१०", "content_sanskrit": "ततोऽप्रीतस्तथोक्तः सन्भारद्वाजोऽब्रवीन्नृपम्।\nनार्हसे मां तथा ज्ञातुं घटमानं तव प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2050536, "chapter_id": 2106, "verse_number": "७-३३-११", "content_sanskrit": "ससुरासुरगन्धर्वाः सयक्षोरगराक्षसाः।\nनालं लोका रणे जेतुं पाल्यमानं किरीटिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2050537, "chapter_id": 2106, "verse_number": "७-३३-१२", "content_sanskrit": "विश्वसृग्यत्र गोविन्दः पृतनानीस्तथाऽर्जुनः।\nतत्र कस्य बलं क्रामेदन्यत्र त्र्यम्बकात्प्रभोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2050538, "chapter_id": 2106, "verse_number": "७-३३-१३", "content_sanskrit": "सत्यं तात ब्रवीम्यद्य नैतज्जात्वन्यथा भवेत्।\nअद्यैकं प्रवरं कञ्चित्पातयिष्ये महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2050539, "chapter_id": 2106, "verse_number": "७-३३-१४", "content_sanskrit": "चक्रब्यूहं विधास्यामि योऽभेद्यस्त्रिदशैरपि।\nयोगेन केनचिद्राजन्नर्जुनस्त्वपनीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2050540, "chapter_id": 2106, "verse_number": "७-३३-१५", "content_sanskrit": "न ह्यज्ञातमसाध्यं वा तस्य सङ्ख्येऽस्ति किञ्चन।\nतेन ह्युपात्तं सकलं सर्वज्ञानमितस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2050541, "chapter_id": 2106, "verse_number": "७-३३-१६", "content_sanskrit": "द्रोणेन व्याहृते त्वेवं संशप्तकगणाः पुनः।\nआह्वयन्नर्जुनं सङ्ख्ये दक्षिणामभितो दिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2050542, "chapter_id": 2106, "verse_number": "७-३३-१७", "content_sanskrit": "ततोऽर्जुनस्याथ परैः सार्धं समभवद्रणः।\nतादृशो यादृशो नान्यः श्रुतो दृष्टोपि वा क्वचित्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2050543, "chapter_id": 2106, "verse_number": "७-३३-१८", "content_sanskrit": "तत्र द्रोणेन विहितो व्यूहो राजन्व्यरोचत।\nचरन्मध्यन्दिने सूर्यः प्रतपन्निव दुर्दृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2050544, "chapter_id": 2106, "verse_number": "७-३३-१९", "content_sanskrit": "तं चाभिमन्युर्वचनात्पितुर्ज्येष्ठस्य भारत।\nबिभेद दुर्भिदं सङ्ख्ये चक्रव्यूहमनेकधा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2050545, "chapter_id": 2106, "verse_number": "७-३३-२०", "content_sanskrit": "स कृत्वा दुष्करं कर्म हत्वा वीरान्सहस्रशः।\nराजपुत्रशतं हत्वा कौसल्यं च बृहद्बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2050546, "chapter_id": 2106, "verse_number": "७-३३-२१", "content_sanskrit": "महारथं शल्यपुत्रं पौत्रं ते लक्ष्मणं तथा।\nषट्सु वीरेषु संसक्तो दौःशासनिवशं गतः।\nसौभद्रः पृथिवीपाल जहौ प्राणान्परन्तप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2050547, "chapter_id": 2106, "verse_number": "७-३३-२२", "content_sanskrit": "वयं परमसंहृष्टाः पाण्डवाः शोककर्शिताः।\nसौभद्रे निहते राजन्नवहारमकुर्महि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2050548, "chapter_id": 2106, "verse_number": "७-३३-२३x", "content_sanskrit": "`जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2050549, "chapter_id": 2106, "verse_number": "७-३३-२३", "content_sanskrit": "समरोद्युक्तकर्माणः कर्मभिर्व्यञ्जितश्रमाः।\nसकृष्णाः पाण्डवाः पञ्च देवैरपि दुरासदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2050550, "chapter_id": 2106, "verse_number": "७-३३-२४", "content_sanskrit": "शश्वत्कर्मान्वयैर्बुद्ध्या प्रकृत्या यशसा श्रिया।\nन भूतो भविता वापि कृष्णस्य सदृशः पुमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2050551, "chapter_id": 2106, "verse_number": "७-३३-२५", "content_sanskrit": "सत्यधर्मतपोदानैर्द्विजपूजादिभिर्गुणैः।\nसदेहस्त्रिदिवं प्राप्तो राजा किल युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2050552, "chapter_id": 2106, "verse_number": "७-३३-२६", "content_sanskrit": "युगान्ते चान्तकश्चैव जामदग्न्यश्च कीर्तिमान्।\nरणस्थो भीमसेनश्च कथ्यन्ते सदृशास्त्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2050553, "chapter_id": 2106, "verse_number": "७-३३-२७", "content_sanskrit": "प्रतिज्ञाकर्मदक्षस्य रणे गाण्डीवधन्वनः।\nउपमां नाधिगच्छामि पार्थस्य सदृशीं क्षितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2050554, "chapter_id": 2106, "verse_number": "७-३३-२८", "content_sanskrit": "गुरुवात्सल्यमत्यन्तं नैभृत्यं विनयो दमः।\nनकुले त्वाभिरूप्यं च शौर्यं च नियतानि षट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2050555, "chapter_id": 2106, "verse_number": "७-३३-२९", "content_sanskrit": "श्रुतमाधुर्यगाम्भीर्यसत्त्वरूपपराक्रमैः।\nसदृशो देवयोर्वीरः सहदेवः किलाश्विनोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2050556, "chapter_id": 2106, "verse_number": "७-३३-३०", "content_sanskrit": "ये च कृष्णे गुणाः स्फीताः पाण्डवेषु च ये गुणाः।\nअभिमन्यौ किलैकस्था दृश्यन्ते ते गुणाः शुभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2050557, "chapter_id": 2106, "verse_number": "७-३३-३१", "content_sanskrit": "युधिष्ठिरस्य शौर्येण कृष्णस्य चरितेन च।\nकर्मणा भीमसेनस्य सदृशं भीमकर्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2050558, "chapter_id": 2106, "verse_number": "७-३३-३२", "content_sanskrit": "धनञ्जयस्य रूपेण विक्रमेण शुभेन च।\nविनये सहदेवस्य सदृशं नकुलस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2050559, "chapter_id": 2106, "verse_number": "७-३३-३३", "content_sanskrit": "अभिमन्युं द्विजश्रेष्ठ सौभद्रमपराजितम्।\nश्रोतुमिच्छामि कार्त्स्न्येन कथमायोधने हतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2050560, "chapter_id": 2106, "verse_number": "७-३३-३४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2050561, "chapter_id": 2106, "verse_number": "७-३३-३४", "content_sanskrit": "अभिमन्युं हतं श्रुत्वा धृतराष्ट्रो जनाधिपः।\nविस्तरेण महाराज पर्यपृच्छत्स सञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2050562, "chapter_id": 2106, "verse_number": "७-३३-३५x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2050563, "chapter_id": 2106, "verse_number": "७-३३-३५", "content_sanskrit": "पुत्रं पुरुषसिंहस्य सञ्जयाप्राप्तयौवनम्।\nरणे विनिहतं श्रुत्वा भृशं मे दीर्यते मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2050564, "chapter_id": 2106, "verse_number": "७-३३-३६", "content_sanskrit": "दारुणः क्षत्रधर्मोऽयं विहितो धर्मकर्तृभिः।\nयत्र राज्येप्सवः शूरा बाले शस्त्रमपातयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2050565, "chapter_id": 2106, "verse_number": "७-३३-३७", "content_sanskrit": "बालमत्यन्तसुखिनं विचरन्तमभीतवत्।\nकृतास्त्रा बहवो जघ्नुर्ब्रूहि गावल्गणे कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2050566, "chapter_id": 2106, "verse_number": "७-३३-३८", "content_sanskrit": "बिबित्सता रथानीकं सौभद्रेणामितौजसा।\nविक्रीडितं यथा सङ्ख्ये तन्ममाचक्ष्व सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2050567, "chapter_id": 2106, "verse_number": "७-३३-३९x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2050568, "chapter_id": 2106, "verse_number": "७-३३-३९", "content_sanskrit": "यन्मां पृच्छसि राजेन्द्र सौभद्रस्य निपातनम्।\nतत्ते कार्त्स्न्येन वक्ष्यामि शृणु राजन्समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2050569, "chapter_id": 2106, "verse_number": "७-३३-४०", "content_sanskrit": "विक्रीडितं कुमारेण यथानीकं बिभित्सता।\nआरुग्णाश्च यथा वीरा दुःसाध्याश्चापि विप्लुवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2050570, "chapter_id": 2106, "verse_number": "७-३३-४१", "content_sanskrit": "दावाग्न्यभिपरीतानां भूरिगुल्मतृणद्रुमे।\nवनौकसामिवारण्ये त्वदीयानामभूद्भयम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2050571, "chapter_id": 2106, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि अभिमन्युवधपर्वणि त्रयस्त्रिंशोऽध्यायः॥ ३३ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-३३-२ रजस्वला धूलिव्याप्ताः॥ ५-३३-९ विकृतवानन्यथा कृतवान्॥ ५-३३-१५ कलाभिः सहितं सकलम्। इतोऽस्मत्तः। ततोऽन्यतः॥ ५-३३-२१ षट्सु द्रोणद्रौणिकृपकर्णभोजशल्येषु॥ ५-३३-२८ नैभृत्यं कृतकर्तव्याप्रकाशनम्॥ ५-३३-३६ धर्मकर्तृभिर्मन्वादिभिः॥ ५-३३-३३ त्रयस्त्रिंशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]