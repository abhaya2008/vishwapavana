[{"id": 7004104000, "chapter_id": 24104, "verse_number": "४-५३-१", "content_sanskrit": "अगस्तिरुवाच ।\nअपूवेंयं कथा ख्याता ब्रह्मणो ब्रह्मवित्तम ।\nकिं चकार पुनः शंभुस्तत्र ब्रह्मण्यपि स्थिते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004104001, "chapter_id": 24104, "verse_number": "४-५३-२", "content_sanskrit": "स्कंद उवाच ।\nशृण्वगस्त्य महाभाग काश्यां ब्रह्मण्यपिस्थिते ।\nगिरिशश्चिंतयामास भृशमुद्विग्नमानसः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004104002, "chapter_id": 24104, "verse_number": "४-५३-३", "content_sanskrit": "पुरी सा यादृशी काशी वशीकरणभूमिका ।\nन तादृशीदृशीहासीत्क्वचिन्मे प्रायशो ध्रुवम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004104003, "chapter_id": 24104, "verse_number": "४-५३-४", "content_sanskrit": "यो यो याति पुरीं तां तु स स तत्रैव तिष्ठति ।\nअभूवन्ननुयोगिन्योऽयोगिन्यः काशिसंगताः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004104004, "chapter_id": 24104, "verse_number": "४-५३-५", "content_sanskrit": "अकिंचित्करतां प्राप्तः स सहस्रकरोप्यरम् ।\nविधिर्विधानदक्षोपि न मे स सविधोभवत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004104005, "chapter_id": 24104, "verse_number": "४-५३-६", "content_sanskrit": "चिंतयन्निति देवेशो गणानारहूय भूरिशः ।\nप्रेषयामास भो यात क्षिप्रं वाराणसीं पुरीम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004104006, "chapter_id": 24104, "verse_number": "४-५३-७", "content_sanskrit": "किं कुर्वंति तु योगिन्यः किं करोति स भानुमान् ।\nगत्वा वित्त त्वरायुक्ता विधिश्च विदधाति किम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004104007, "chapter_id": 24104, "verse_number": "४-५३-८", "content_sanskrit": "नामग्राहं ततःऽप्रैषीद्बहुमान पुरःसरम् ।\nशंकुकर्ण महाकाल घटाकर्ण महोदर ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004104008, "chapter_id": 24104, "verse_number": "४-५३-९", "content_sanskrit": "सोमनंदिन्नंदिषेण काल पिंगल कुक्कुट ।\nकुंडोदर मयूराक्ष बाण गोकर्ण तारक ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004104009, "chapter_id": 24104, "verse_number": "४-५३-१०", "content_sanskrit": "तिलपर्ण स्मृलकर्ण दृमिचंड प्रभामय ।\nसुकेश विंदते छाग कपर्दिन्पिंगलाक्षक ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004104010, "chapter_id": 24104, "verse_number": "४-५३-११", "content_sanskrit": "वीरभद्र किराताख्य चतुर्मुख निकुंभक ।\nपंचाक्षभारभूताख्य त्र्यक्ष क्षेमक लांगलिन् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004104011, "chapter_id": 24104, "verse_number": "४-५३-१२", "content_sanskrit": "विराध सुमुखाषाढे भवंतो मम सूनवः ।\nयथेमौ स्कंदहेरंबौ नैगमेयो यथा त्वयम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004104012, "chapter_id": 24104, "verse_number": "४-५३-१३", "content_sanskrit": "यथा शाखविशाखौ च यथेमौ नंदिभृंगिणौ ।\nभवत्सु विद्यमानेषु महाविक्रमशालिषु ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004104013, "chapter_id": 24104, "verse_number": "४-५३-१४", "content_sanskrit": "काशीप्रवृत्तिं नो जाने दिवोदासनृपस्य च ।\nयोगिन्यर्कविधीनां च तद्द्वौ यातं भवत्स्वमू ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004104014, "chapter_id": 24104, "verse_number": "४-५३-१५", "content_sanskrit": "शंकुकर्णमहाकालौ कालस्यापि प्रकंपनौ ।\nज्ञातुं वाराणसीवार्तामायातं चत्वरान्वितौ ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004104015, "chapter_id": 24104, "verse_number": "४-५३-१६", "content_sanskrit": "कृतप्रतिज्ञौ तो तूर्णं प्राप्य वाराणसीं पुरीम् ।\nशंकुकर्णमहाकालौ विस्मृत्य शांभवीं गिरम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004104016, "chapter_id": 24104, "verse_number": "४-५३-१७", "content_sanskrit": "यथैंद्रजालिकीं दृष्ट्वा मायामिह विचक्षणः ।\nक्षणेन मोहमायाति काशीं वीक्ष्य तथैव तौ ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004104017, "chapter_id": 24104, "verse_number": "४-५३-१८", "content_sanskrit": "अहो मोहस्य माहात्म्यमहो भाग्यविपर्ययः ।\nनिर्वाणराशिं यत्काशीं प्राप्य यांत्यन्यतोऽबुधाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004104018, "chapter_id": 24104, "verse_number": "४-५३-१९", "content_sanskrit": "तत्यजे यैरियं काशी महाशीर्वादभूभिका ।\nतेषां करतलान्मुक्तिः प्राप्तापि परितो गता ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004104019, "chapter_id": 24104, "verse_number": "४-५३-२०", "content_sanskrit": "यत्र सर्वावभृथतः स्नानमात्रं विशिष्यते ।\nअप्युष्णीकृतपानीयैस्तां काशीं कः परित्यजेत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004104020, "chapter_id": 24104, "verse_number": "४-५३-२१", "content_sanskrit": "यत्रैकपुष्पदानेन शिवलिंगस्य मूर्धनि ।\nदशसौवर्णिकं पुण्यं कस्तां काशीं परित्यजेत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004104021, "chapter_id": 24104, "verse_number": "४-५३-२२", "content_sanskrit": "यत्र दंडप्रणामेन अप्येकेन शिवाग्रतः ।\nतुच्छमेंद्रपदंप्राहुस्तां काशीं को विमुंचति ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004104022, "chapter_id": 24104, "verse_number": "४-५३-२३", "content_sanskrit": "यत्रैकद्विजमात्रं तु भोजयित्वा यथेच्छया ।\nवाजपेयाधिकं पुण्यं तां काशीं को विमुंचति ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004104023, "chapter_id": 24104, "verse_number": "४-५३-२४", "content_sanskrit": "एकां गां यत्र दत्त्वा वै विधिवद्ब्राह्मणाय वै ।\nलभेदयुत गोपुण्यं कस्तां काशीं त्यजेत्सुधीः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004104024, "chapter_id": 24104, "verse_number": "४-५३-२५", "content_sanskrit": "एकलिंगं प्रतिष्ठाप्य यत्र संस्थापितं भवेत् ।\nअपि त्रैलोक्यमखिलं तां काशीं कः समुज्झति ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004104025, "chapter_id": 24104, "verse_number": "४-५३-२६", "content_sanskrit": "परिनिश्चित्य तावित्थं लिंगे संस्थाप्य पुण्यदे ।\nतत्रैव संस्थितिं प्राप्तौ काशीं नाद्यापि मुंचतः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004104026, "chapter_id": 24104, "verse_number": "४-५३-२७", "content_sanskrit": "शंकुकर्णेश्वरं लिंगं शंकुकर्ण ग णार्चितम् ।\nदृष्ट्वा न जायते जंतुर्जातु मातुर्महोदरे ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004104027, "chapter_id": 24104, "verse_number": "४-५३-२८", "content_sanskrit": "विश्वेशाद्वायुदिग्भागे शंकुकर्णेश्वरं नरः ।\nसंपूज्य न विशेदत्र घोरे संसारसागरे ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004104028, "chapter_id": 24104, "verse_number": "४-५३-२९", "content_sanskrit": "महाकालेश्वरं लिंगं महाकालगणार्चितम् ।\nअर्चयित्वा च नत्वा च स्तुत्वा कालभयं कुतः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004104029, "chapter_id": 24104, "verse_number": "४-५३-३०", "content_sanskrit": "स्कंद उवाच ।\nशंकुकर्णे महाकाले चिरंतन विलंबिते ।\nज्ञात्वा सर्वज्ञनाथोथ प्राहैपीदपरौ गणौ ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004104030, "chapter_id": 24104, "verse_number": "४-५३-३१", "content_sanskrit": "घंटाकर्ण त्वमागच्छ महोदर महामते ।\nकाशीं यातं युवां तूर्णं ज्ञातुं तत्रत्य चेष्टितम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004104031, "chapter_id": 24104, "verse_number": "४-५३-३२", "content_sanskrit": "इत्यगस्ते गणौ तौ तु गत्वा काशीं महापुरीम् ।\nव्यावृत्याद्यापि नो यातौ क्वापि तत्रैव संस्थितौ ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004104032, "chapter_id": 24104, "verse_number": "४-५३-३३", "content_sanskrit": "घंटाकर्णेश्वरं लिंगं घंटाकर्ण गणोत्तमः ।\nकाश्यां संस्थाप्य विधिवत्स्वयं तत्रैव निर्वृतः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004104033, "chapter_id": 24104, "verse_number": "४-५३-३४", "content_sanskrit": "कुंडं तत्रैव संस्थाप्य लिंगस्नपनकर्मणे ।\nनाद्यापि स त्यजेत्काशीं ध्यायंल्लिंगं तथैव हि ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004104034, "chapter_id": 24104, "verse_number": "४-५३-३५", "content_sanskrit": "महोदरोपि तत्प्राच्यां शिवध्यानपरायणः ।\nमहोदरेश्वरं लिंगं ध्यायेदद्यापि कुंभज ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004104035, "chapter_id": 24104, "verse_number": "४-५३-३६", "content_sanskrit": "महोदरेश्वरं दृष्ट्वा वाराणस्यां द्विजोत्तम ।\nकदाचिदपि वै मातुः प्रविशेन्नौदरीं दरीम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004104036, "chapter_id": 24104, "verse_number": "४-५३-३७", "content_sanskrit": "घंटाकर्ण ह्रदे स्नात्वा दृष्ट्वा व्यासेश्वरं विभुम् ।\nयत्र कुत्र विपन्नोपि वाराणस्यां मृतो भवेत् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004104037, "chapter_id": 24104, "verse_number": "४-५३-३८", "content_sanskrit": "घंटाकर्णे महातीर्थे श्राद्धं कृत्वा विधानतः ।\nअपि दुर्गतिमापन्नानुद्धरेत्सप्तपूर्वजान् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004104038, "chapter_id": 24104, "verse_number": "४-५३-३९", "content_sanskrit": "निमज्ज्याद्यापि तत्कुंडे क्षण योवहितो भवेत् ।\nविश्वेश्वरमहापूजा घंटारावाञ्शृणोति सः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004104039, "chapter_id": 24104, "verse_number": "४-५३-४०", "content_sanskrit": "वदंति पितरः काश्यां घंटाकर्णेमलेजले ।\nदाता तिलोदकस्यापि वंशे नः कोपि जायते ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004104040, "chapter_id": 24104, "verse_number": "४-५३-४१", "content_sanskrit": "यद्वंश्या मुनयः काश्यां घंटाकर्णे महाह्रदे ।\nकृतोदकक्रियाः प्राप्ताः परां सिद्धिं घटोद्भव ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004104041, "chapter_id": 24104, "verse_number": "४-५३-४२", "content_sanskrit": "स्कंद उवाच ।\nघंटाकर्णे गणे याते प्रयाते च महोदरे ।\nविसिस्माय स्मरद्वेष्टा मौलिमांदोलयन्मुहुः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004104042, "chapter_id": 24104, "verse_number": "४-५३-४३", "content_sanskrit": "उवाच च मनस्येव हरः स्मित्वा पुनःपुनः ।\nमहामोहनविद्यासि काशि त्वां पर्यवैम्यहम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004104043, "chapter_id": 24104, "verse_number": "४-५३-४४", "content_sanskrit": "पुराविदः प्रशंसंति त्वां महामोहहारिणीम् ।\nकाशींत्विति न जानंति महामोहनभूरियम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004104044, "chapter_id": 24104, "verse_number": "४-५३-४५", "content_sanskrit": "प्रेषयिष्याम्यहं सर्वान्भवती मोहयिष्यति ।\nइति सम्यग्विजानामि काशि त्वां मोहनोषधिम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004104045, "chapter_id": 24104, "verse_number": "४-५३-४६", "content_sanskrit": "तथापि प्रेषयिष्यामि यावान्मेस्ति परिच्छदः ।\nनोद्यमाद्विरमंतीह ज्ञानिनः साध्यकर्मणि ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004104046, "chapter_id": 24104, "verse_number": "४-५३-४७", "content_sanskrit": "नोद्यमाद्विरतिः कार्या क्वापि कार्ये विचक्षणैः ।\nप्रतिकूलोपि खिद्येत विधिस्तत्सततोद्यमात् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004104047, "chapter_id": 24104, "verse_number": "४-५३-४८", "content_sanskrit": "शीतोष्णभानू स्वर्भानु ग्रस्तावपि नभोंगणे ।\nगतिं न त्यजतोद्यापि प्रक्रांतव्य कृतोद्यमौ ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004104048, "chapter_id": 24104, "verse_number": "४-५३-४९", "content_sanskrit": "एकत्र हंति कार्याणि प्रातिकूल्याद्विधिर्मुहुः ।\nएकत्रकरणीयानि सेत्स्यंत्यत्र भृशोद्यमात् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004104049, "chapter_id": 24104, "verse_number": "४-५३-५०", "content_sanskrit": "दैवं पूर्वकृतं कर्म कथ्यते नेतरत्पुनः ।\nतन्निराकरणे यत्नः स्वयं कार्यो विपश्चिता ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004104050, "chapter_id": 24104, "verse_number": "४-५३-५१", "content_sanskrit": "भाजनोपस्थितं दैवाद्भोज्यं नास्यं स्वयं विशेत् ।\nहस्तवक्त्रोद्यमात्तच्च प्रविशेदौदरीं दरीम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004104051, "chapter_id": 24104, "verse_number": "४-५३-५२", "content_sanskrit": "इत्युद्यमं समर्थ्येशो निश्चितं दैवजित्वरम् ।\nपुनश्च प्रेषयांचक्रे गणान्पंचमहारयान् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004104052, "chapter_id": 24104, "verse_number": "४-५३-५३", "content_sanskrit": "सोमनंदी नंदिषेणः कालपिंगलकुक्कुटाः ।\nतेद्यापि न निवर्तंते काश्यां जीवामृता यथा ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004104053, "chapter_id": 24104, "verse_number": "४-५३-५४", "content_sanskrit": "तेपि स्वनाम्ना लिंगानि शंभुसंतुष्टि काम्यया ।\nप्रतिष्ठाप्य स्थिताः काश्यां विश्वनिर्वाणजन्मनि ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004104054, "chapter_id": 24104, "verse_number": "४-५३-५५", "content_sanskrit": "सोमनंदीश्वरं दृष्ट्वा लिंगं नंदवने परम् ।\nसोमलोके परानंदं प्राप्नुयाद्भक्तिमान्नरः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004104055, "chapter_id": 24104, "verse_number": "४-५३-५६", "content_sanskrit": "तदुत्तरे विलोक्याथ नंदिषेणेश्वरं नरः ।\nआनंदसेनां संप्राप्य जयेन्मृत्युमपि क्षणात् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004104056, "chapter_id": 24104, "verse_number": "४-५३-५७", "content_sanskrit": "कालेश्वरं महालिंगं गंगायाः पश्चिमोत्तरे ।\nप्रणम्य कालपाशेन नो बध्येत कदाचन ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004104057, "chapter_id": 24104, "verse_number": "४-५३-५८", "content_sanskrit": "पिंगलेश्वरमभ्यर्च्य कालेशात्किंचिदुत्तरे ।\nलभते पिंगलज्ञानं येन तन्मयतां व्रजेत् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004104058, "chapter_id": 24104, "verse_number": "४-५३-५९", "content_sanskrit": "कुक्कुटेश्वर लिंगस्य येत्र भक्तिं वितन्वते ।\nकुक्कुटांडाकृतेस्तस्य न ते गर्भमवाप्नुयुः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004104059, "chapter_id": 24104, "verse_number": "४-५३-६०", "content_sanskrit": "स्कंद उवाच ।\nसोमनंदि प्रभृतिषु मुने पंचगणेष्वपि ।\nआनंदकाननं प्राप्य स्थितेषु स्थाणुरब्रवीत् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004104060, "chapter_id": 24104, "verse_number": "४-५३-६१", "content_sanskrit": "कार्यमस्माकमेवैतद्यदि सम्यग्विमृश्यते ।\nअनेनोपाधिनाप्येते तत्र तिष्ठंतु मामकाः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004104061, "chapter_id": 24104, "verse_number": "४-५३-६२", "content_sanskrit": "प्रमथेषु प्रविष्टेषु मायावीर्यमहत्स्वपि ।\nअहमेव प्रविष्टोस्मि वाराणस्यां न संशयः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004104062, "chapter_id": 24104, "verse_number": "४-५३-६३", "content_sanskrit": "क्रमेण प्रेषयिष्यामि योस्ति मे स्वपरिच्छदः ।\nतत्र सर्वेषु यातेषु ततो यास्याम्यहं पुनः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004104063, "chapter_id": 24104, "verse_number": "४-५३-६४", "content_sanskrit": "संप्रधार्येति हृदये देवदेवेन शूलिना ।\nप्रैषिष्ट प्रमथानां तु ततो गणचतुष्टयम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004104064, "chapter_id": 24104, "verse_number": "४-५३-६५", "content_sanskrit": "कुंडोदरो मयूराख्यो बाणो गोकर्ण एव च ।\nमायाबलं समाश्रित्य काशीं प्रविविशुर्गणाः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004104065, "chapter_id": 24104, "verse_number": "४-५३-६६", "content_sanskrit": "कृत्वोपायशतं तैस्तु दिवोदासस्य संभ्रमे ।\nयदैकोपि समर्थो न तदा तत्रैव संस्थितम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004104066, "chapter_id": 24104, "verse_number": "४-५३-६७", "content_sanskrit": "अपराधशतेष्वीशः केन तुष्यति कर्मणा ।\nसंप्रधार्येति ते चक्रुर्लिंगाराधनमुत्तमम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004104067, "chapter_id": 24104, "verse_number": "४-५३-६८", "content_sanskrit": "एकस्मिञ्शांभवे लिंगे विधिनात्र समर्चिते ।\nक्षमेत्त्र्यक्षोपराधानां शतं मोक्षं च यच्छति ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004104068, "chapter_id": 24104, "verse_number": "४-५३-६९", "content_sanskrit": "न तुष्यति तथा शंभुर्यज्ञदानतपोव्रतैः ।\nयथा तुष्येत्सकृल्लिंगे विधिनाभ्यर्चिते सति ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004104069, "chapter_id": 24104, "verse_number": "४-५३-७०", "content_sanskrit": "लिंगार्चनविधानज्ञो लिंगार्चनरतः सदा ।\nत्र्यक्ष एव स विज्ञेयः साक्षाद्द्व्यक्षोपि मानवः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004104070, "chapter_id": 24104, "verse_number": "४-५३-७१", "content_sanskrit": "न गोशतप्रदानेन न स्वर्णशतदानतः ।\nतत्फलं लभ्यते पुंभिर्यत्सकृल्लिंगपूजनात् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004104071, "chapter_id": 24104, "verse_number": "४-५३-७२", "content_sanskrit": "अश्वमेधादिभिर्यागैर्न तत्फलमवाप्यते ।\nयत्फलं लभ्यते मर्त्यैर्नित्यं लिंगप्रपूजनात् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004104072, "chapter_id": 24104, "verse_number": "४-५३-७३", "content_sanskrit": "स्नापयित्वा विधानेन यो लिंगस्नपनोदकम् ।\nत्रिः पिबेत्त्रिविधं पापं तस्येहाशु प्रणश्यति ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004104073, "chapter_id": 24104, "verse_number": "४-५३-७४", "content_sanskrit": "लिंग स्नपनवार्भिर्यः कुर्यान्मूर्ध्न्यभिषेचनम् ।\nगंगास्नानफलं तस्य जायतेत्र विपाप्मनः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004104074, "chapter_id": 24104, "verse_number": "४-५३-७५", "content_sanskrit": "लिंगं समर्चितं दृष्ट्वा यः कुर्यात्प्रणतिं सकृत् ।\nसंदेहो जायते तस्य पुनर्देहनिबंधने ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004104075, "chapter_id": 24104, "verse_number": "४-५३-७६", "content_sanskrit": "लिंगं यः स्थापयेद्भक्त्या सप्तजन्मकृतादघात् ।\nमुच्यते नात्र संदेहो विशुद्धः स्वर्गभाग्भवेत् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004104076, "chapter_id": 24104, "verse_number": "४-५३-७७", "content_sanskrit": "विचार्येति गणैः काश्यां स्वामिद्रोहोपशांतये ।\nप्रतिष्ठितानि लिंगानि महापातकभिंद्यपि ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004104077, "chapter_id": 24104, "verse_number": "४-५३-७८", "content_sanskrit": "कुंडोदरेश्वरं लिंगं दृष्ट्वा लोलार्कसन्निधौ ।\nसर्वपापविनिर्मुक्तः शिवलोके महीयते ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004104078, "chapter_id": 24104, "verse_number": "४-५३-७९", "content_sanskrit": "कुंडोदरेश्वराल्लिंगात्प्रतीच्यामसिरोधसि ।\nमयूरेश्वरमभ्यर्च्य न गर्भं प्रतिपद्यते ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004104079, "chapter_id": 24104, "verse_number": "४-५३-८०", "content_sanskrit": "मयूरेशप्रतीच्यां च लिंगं बाणेश्वरं महत् ।\nतस्य दर्शनमात्रेण सर्वैः पापैः प्रमुच्यते ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004104080, "chapter_id": 24104, "verse_number": "४-५३-८१", "content_sanskrit": "गोकर्णेशं महालिंगमंतर्गेहस्य पश्चिमे ।\nद्वारे समर्च्य वै काश्यां न विघ्नैरभिभूयते ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004104081, "chapter_id": 24104, "verse_number": "४-५३-८२", "content_sanskrit": "गोकर्णेश्वर भक्तस्य पंचत्व समये सति ।\nज्ञानभ्रंशो न जायेत क्वचिदप्यंतमृच्छतः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004104082, "chapter_id": 24104, "verse_number": "४-५३-८३", "content_sanskrit": "स्कंद उवाच ।\nचिरयत्सुगणेष्वेषु चतुर्ष्वपिगणेश्वरः ।\nमहिमानं महत्त्वं तु तत्काश्याः पर्यवर्णयत् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004104083, "chapter_id": 24104, "verse_number": "४-५३-८४", "content_sanskrit": "वैष्णव्या मायया विश्वं भ्राम्येतात्र ययाखिलम् ।\nध्रुवं मूर्तिमती सैषा काशी विश्वैकमोहिनी ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004104084, "chapter_id": 24104, "verse_number": "४-५३-८५", "content_sanskrit": "अपास्य सोदरान्दारान्पुत्रं क्षेत्रं गृहं वसु ।\nअप्यंगीकृत्य निधनं सर्वे काशीमुपासते ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004104085, "chapter_id": 24104, "verse_number": "४-५३-८६", "content_sanskrit": "मरणादपि नो काश्यां भयं यत्र मनागपि ।\nगणास्तत्र तु तिष्ठंतः कुतो मत्तोपि बिभ्यति ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004104086, "chapter_id": 24104, "verse_number": "४-५३-८७", "content_sanskrit": "मरणं मंगलं यत्र विभूतिर्यत्र भूषणम् ।\nकौपीनं यत्र कौशेयं काशी कुत्रोपमीयते ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004104087, "chapter_id": 24104, "verse_number": "४-५३-८८", "content_sanskrit": "निर्वाणरमणी यत्र रंकं वाऽरंकमेव वा ।\nब्राह्मणं वा श्वपाकं वा वृणीते प्रांत्यभूषणम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004104088, "chapter_id": 24104, "verse_number": "४-५३-८९", "content_sanskrit": "मृतानां यत्र जंतूनां निर्वाणपदमृच्छताम् ।\nकोट्यंशेनापि न समा अपि शक्रादयः सुराः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004104089, "chapter_id": 24104, "verse_number": "४-५३-९०", "content_sanskrit": "यत्र काश्यां मृतो जंतुर्ब्रह्मनारायणादिभिः ।\nप्रबद्ध मूर्धांजलिभिर्नमस्येतातियत्नतः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004104090, "chapter_id": 24104, "verse_number": "४-५३-९१", "content_sanskrit": "यत्र काश्यां शवत्वेपि जंतुर्नाशुचितां व्रजेत् ।\nअतस्तत्कर्णसंस्पर्शं करोम्यहमपि स्वयम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004104091, "chapter_id": 24104, "verse_number": "४-५३-९२", "content_sanskrit": "यस्तु काशीति काशीति द्विस्त्रिर्जपति पुण्यवान् ।\nअपि सर्वपवित्रेभ्यः स पवित्रतरो महान् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004104092, "chapter_id": 24104, "verse_number": "४-५३-९३", "content_sanskrit": "येन काशी हृदि ध्याता येन काशीह सेविता ।\nतेनाहं हृदि संध्यातस्तेनाहं सेवितः सदा ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004104093, "chapter_id": 24104, "verse_number": "४-५३-९४", "content_sanskrit": "काशीं यः सेवते जंतुर्निर्विकल्पेन चेतसा ।\nतमहं हृदये नित्यं धारयामि प्रयत्नतः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004104094, "chapter_id": 24104, "verse_number": "४-५३-९५", "content_sanskrit": "स्वयं वस्तुमशक्तोपि वासयेत्तीर्थवासिनम् ।\nअप्येकमपि मूल्येन स वस्तुःफलभाग्ध्रुवम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004104095, "chapter_id": 24104, "verse_number": "४-५३-९६", "content_sanskrit": "काश्यां वसंति ये धीरा आपंचत्व विनिश्चयाः ।\nजीवन्मुक्तास्तु ते ज्ञेया वंद्याः पूज्यास्त एव हि ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004104096, "chapter_id": 24104, "verse_number": "४-५३-९७", "content_sanskrit": "इत्थं विमृश्य बहुशः स्थाणुर्वाराणसीगुणान् ।\nगणानन्यान्समाहूय प्राहिणोत्प्रीतिपूर्वकम् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004104097, "chapter_id": 24104, "verse_number": "४-५३-९८", "content_sanskrit": "तारकत्वं समागच्छ गच्छाति स्वच्छमानस ।\nदिवोदासो वृषावासो यामधीष्टे वरां पुरीम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004104098, "chapter_id": 24104, "verse_number": "४-५३-९९", "content_sanskrit": "तिलपर्ण स्धूलकर्ण दृमिचंड प्रभामय ।\nसुकेश विंदते छाग कपर्दिन्पिंगलाक्षक ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004104099, "chapter_id": 24104, "verse_number": "४-५३-१००", "content_sanskrit": "वीरभद्र किराताख्य चतुर्मुख निकुंभक ।\nपंचाक्ष भारभूताख्य त्र्यक्ष क्षेमकलांगलिन् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004104100, "chapter_id": 24104, "verse_number": "४-५३-१०१", "content_sanskrit": "विराध सुमुखाषाढे यांतु सर्वे पृथक्पृथक् ।\nएते गणा महाभागाः स्वामिभक्ता दृढव्रताः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004104101, "chapter_id": 24104, "verse_number": "४-५३-१०२", "content_sanskrit": "कृत्वा माया बहुविधा बहुरूपा विचक्षणाः ।\nअनिमेषेक्षणास्तस्थुः क्षोणीशच्छिद्रकांक्षिणः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004104102, "chapter_id": 24104, "verse_number": "४-५३-१०३", "content_sanskrit": "अपरुज्ञात तच्छिद्रा विद्रावितयशोधनाः ।\nआः किमेतदहोजातं निनिंदुः स्वमितीह ते ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004104103, "chapter_id": 24104, "verse_number": "४-५३-१०४", "content_sanskrit": "गणा ऊचुः ।\nधिगस्मान्स्वामिना नित्यं कृतसंभावनान्मुहुः ।\nमनुष्यमात्रमप्यत्र यैरेकं न वशीकृतम् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004104104, "chapter_id": 24104, "verse_number": "४-५३-१०५", "content_sanskrit": "बहुमानेन दानेन सौहार्देन महीयसा ।\nकृतप्रसादांस्त्र्यक्षेण धिङ्नस्तत्कार्यवंचकान् ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004104105, "chapter_id": 24104, "verse_number": "४-५३-१०६", "content_sanskrit": "का गतिर्नो भवित्रीह स्वामिकृत्यप्रमादिनाम् ।\nअंधं तमोमये लोके ध्रुवं वासो भविष्यति ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004104106, "chapter_id": 24104, "verse_number": "४-५३-१०७", "content_sanskrit": "अकृतस्वामिकार्याणामहो जीवितधारिणाम् ।\nअक्षतेंद्रियवृत्तीनां दुर्गतिश्च पदे पदे ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004104107, "chapter_id": 24104, "verse_number": "४-५३-१०८", "content_sanskrit": "लब्धसंभावनानां च न्यक्कृतस्वामिकर्मणाम् ।\nभृत्यानां भूरिभाजां च भंगुराः स्युर्मनोरथाः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004104108, "chapter_id": 24104, "verse_number": "४-५३-१०९", "content_sanskrit": "अनिष्पादितकार्यार्था ये मुखं प्रेक्षयंत्यहो ।\nअपत्रपाः पुरो भर्तुस्तैर्भूर्भारवतीत्वियम् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7004104109, "chapter_id": 24104, "verse_number": "४-५३-११०", "content_sanskrit": "नाद्रीणां न समुद्राणां न द्रुमाणां महीयसाम् ।\nभूतधात्र्यास्तथा भारो यथा स्वामिद्रुहां महान् ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7004104110, "chapter_id": 24104, "verse_number": "४-५३-१११", "content_sanskrit": "अहो पौराणिकी गाथा स्मृतास्माभिरनिंदिता ।\nतदर्थमवलंब्येह स्थास्यामः कृतनिश्चयाः ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7004104111, "chapter_id": 24104, "verse_number": "४-५३-११२", "content_sanskrit": "अनाकलितपुण्यानां परिक्षीणधनायुषाम् ।\nसर्वोपायविहीनानां गतिर्वाराणसीपुरी ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7004104112, "chapter_id": 24104, "verse_number": "४-५३-११३", "content_sanskrit": "अपुण्यभारखिन्नानां पश्चात्तापमुपेयुषाम् ।\nविष्वगूर्ध्वगतीनां च गतिर्वाराणसीपुरी ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7004104113, "chapter_id": 24104, "verse_number": "४-५३-११४", "content_sanskrit": "स्वामिद्रुहः कृतघ्नाश्च ये च विश्रंभघातकाः ।\nतेषां क्वापि गतिर्नास्ति मुक्त्वा वाराणसीं पुरीम् ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7004104114, "chapter_id": 24104, "verse_number": "४-५३-११५", "content_sanskrit": "इत्थं निश्चित्य गाथार्थं प्रमथा अवतस्थिरे ।\nअविज्ञातस्वरूपाश्च दिवोदासेन भूभुजा ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7004104115, "chapter_id": 24104, "verse_number": "४-५३-११६", "content_sanskrit": "न बुबोध स भूपालो नितरां बुद्धिमानपि ।\nविबुधान्विविधाकारैः स्थितानीशप्रभावतः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7004104116, "chapter_id": 24104, "verse_number": "४-५३-११७", "content_sanskrit": "चित्रं न चित्रगुप्तोपि वेत्ति वाराणसीस्थितान् ।\nजंतून्का गणनान्येषां मर्त्यलोकनिवासिनाम् ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7004104117, "chapter_id": 24104, "verse_number": "४-५३-११८", "content_sanskrit": "अविच्छिन्न प्रभावाणामपरिच्छिन्न तेजसाम् ।\nकृतलिंगप्रतिष्ठानां नांतं प्राप्नोति धर्मराट् ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7004104118, "chapter_id": 24104, "verse_number": "४-५३-११९", "content_sanskrit": "इति ते प्रमथाः सर्वे घटोद्भव महामुने ।\nकृतलिंगार्चनाः काशीं नाद्याप्युज्झंति शर्मदाम् ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7004104119, "chapter_id": 24104, "verse_number": "४-५३-१२०", "content_sanskrit": "तारकेशं महालिंगं तारकाख्यो गणोत्तमः ।\nतारकज्ञानदं पुंसां मुनेऽद्यापि समर्चयेत् ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7004104120, "chapter_id": 24104, "verse_number": "४-५३-१२१", "content_sanskrit": "तारकेश्वरलिंगस्य कृत्वा भक्तिसुनिश्चलाम् ।\nसुखेन तारकज्ञानं लभ्यते तैर्नरोत्तमैः ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7004104121, "chapter_id": 24104, "verse_number": "४-५३-१२२", "content_sanskrit": "तिलपर्णेश्वरं लिंगं तिलपर्ण प्रतिष्ठितम् ।\nतिलप्रमाणमप्यत्र दृष्ट्वा पापं न संभवेत् ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7004104122, "chapter_id": 24104, "verse_number": "४-५३-१२३", "content_sanskrit": "स्थूलकर्णेश्वरं लिंगं परिपूज्य नरोत्तमः ।\nन दुर्गतिमवाप्नोति पुण्यमाप्नोति चोत्तमम् ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7004104123, "chapter_id": 24104, "verse_number": "४-५३-१२४", "content_sanskrit": "दृमिचंडेश्वरं लिंगं तथा लिंगं प्रभामयम् ।\nआराध्य तत्प्रतीच्यां च न पापैरभिभूयते ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7004104124, "chapter_id": 24104, "verse_number": "४-५३-१२५", "content_sanskrit": "प्रभामयेश्वरं लिंगं दृष्ट्वान्यत्रापि संस्थितः ।\nप्रभामयेन यानेन शिवलोके व्रजेत्सुधीः ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7004104125, "chapter_id": 24104, "verse_number": "४-५३-१२६", "content_sanskrit": "सुकेशेश्वरमभ्यर्च्य हरिकेशवने नरः ।\nषाट्कौशिकमयं देहं धारयेन्न पुनःपुनः ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7004104126, "chapter_id": 24104, "verse_number": "४-५३-१२७", "content_sanskrit": "विंदतीशं नरोभ्यर्च्य भीमचंडी समीपतः ।\nत्यक्त्वा प्रचंडमप्येनो मोक्षं विंदति शाश्वतम् ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7004104127, "chapter_id": 24104, "verse_number": "४-५३-१२८", "content_sanskrit": "छागलेशं महालिंगं पित्रीश्वरसमीपगम् ।\nविलोक्य पशुवत्कोपि न पापं प्राकृतं स्पृशेत् ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7004104128, "chapter_id": 24104, "verse_number": "४-५३-१२९", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीति साहस्र्यां संहितायां चतुर्थे काशीखण्डे उत्तरार्द्धे वाराणसीवर्णनं गणप्रेषणं नाम त्रिपंचाशत्तमोऽध्यायः ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}]