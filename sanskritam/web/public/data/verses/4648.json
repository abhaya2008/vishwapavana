[{"id": 2170882, "chapter_id": 4648, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2170883, "chapter_id": 4648, "verse_number": "समाप्तिः", "content_sanskrit": "इति स्म कृष्णवचनात्प्रत्युच्चार्य युधिष्ठिरम् ।\nबभूव विमनाः पार्थ किञ्चित्कृत्वेव पातकम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2170884, "chapter_id": 4648, "verse_number": "२", "content_sanskrit": "ततोऽब्रवीद् वासुदेवः प्रहसन्निव पाण्डवम् ।\nकथं नाम भवेदेतद् यदि त्वं पार्थ धर्मजम् ।\nअसिना तीक्ष्णधारेण हन्या धर्मे व्यवस्थितम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2170885, "chapter_id": 4648, "verse_number": "३", "content_sanskrit": "त्वमित्युक्त्वैव राजानमेवं कश्मलमाविशः ।\nहत्वा तु नृपतिं पार्थ अकरिष्यः किमुत्तरम् ।\nएवं सुदुर्विदो धर्मो मन्दप्रज्ञैर्विशेषतः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2170886, "chapter_id": 4648, "verse_number": "४", "content_sanskrit": "स भवान् धर्मभीरुत्वाद् ध्रुवमैष्यन्महत्तमः ।\nनरकं घोररूपं च भ्रातुर्ज्येष्ठस्य वै वधात्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2170887, "chapter_id": 4648, "verse_number": "५", "content_sanskrit": "स त्वं धर्मभृतां श्रेष्ठं राजानं धर्मसंहितम् ।\nप्रसादय कुरुश्रेष्ठमेतदत्र मतं मम\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2170888, "chapter_id": 4648, "verse_number": "६", "content_sanskrit": "प्रसाद्य भक्त्या राजानं प्रीतं चैव युधिष्ठिरम् ।\nप्रयावस्त्वरिता योद्धुं सूतपुत्ररथं प्रति\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2170889, "chapter_id": 4648, "verse_number": "७", "content_sanskrit": "हत्वा सुदुर्जयं कर्णं त्वमद्य निशितैः शरैः ।\nविपुलां प्रीतिमाधत्स्व धर्मपुत्रस्य मानद\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2170890, "chapter_id": 4648, "verse_number": "८", "content_sanskrit": "एतदत्र महाबाहो प्राप्तकालं मतं मम ।\nएवं कृते कृतं चैव तव कार्यं भविष्यति\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2170891, "chapter_id": 4648, "verse_number": "९", "content_sanskrit": "ततोऽर्जुनो महाराज लज्जया वै समन्वितः ।\nधर्मराजस्य चरणौ प्रपेदे शिरसाऽनघ\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2170892, "chapter_id": 4648, "verse_number": "१०", "content_sanskrit": "उवाच भरतश्रेष्ठ प्रसीदेति पुनः पुनः ।\nक्षमस्व राजन् यत्प्रोक्तं धर्मकामेन भीरुणा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2170893, "chapter_id": 4648, "verse_number": "११", "content_sanskrit": "पादयोः पतितं दृष्ट्वा धर्मराजो युधिष्ठिरः ।\nधनञ्जयममित्रघ्नं रुदन्तं भरतर्षभ\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2170894, "chapter_id": 4648, "verse_number": "१२", "content_sanskrit": "उत्थाप्य भ्रातरं राजा धर्मराजो धनञ्जयम् ।\nसमाश्लिष्य च सस्नेहं प्ररुरोद महीपतिः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2170895, "chapter_id": 4648, "verse_number": "१३", "content_sanskrit": "रुदित्वा तु चिरं कालं भ्रातरौ सुमहाद्युती ।\nकृतशौचौ नरव्याघ्रौ प्रीतिमन्तौ बभूवतुः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2170896, "chapter_id": 4648, "verse_number": "१४", "content_sanskrit": "तत आश्लिष्य स प्रेम्णा मूर्ध्नि चाघ्राय पाण्डवम् ।\nप्रीत्या परमया युक्तः प्रस्मयंश्चाब्रवीज्जयम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2170897, "chapter_id": 4648, "verse_number": "१५", "content_sanskrit": "कर्णेन मे महाबाहो सर्वसैन्यस्य पश्यतः ।\nकवचं च ध्वजश्चैव धनुः शक्तिर्हया गदा ।\nशरैः कृत्ता महेष्वास यतमानस्य संयुगे\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2170898, "chapter_id": 4648, "verse_number": "१६", "content_sanskrit": "सोऽहं ज्ञात्वा रणे तस्य कर्म कर्णस्य फल्गुन ।\nव्यवसीदामि दुःखेन न च मे जीवितं प्रियम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2170899, "chapter_id": 4648, "verse_number": "१७", "content_sanskrit": "तमद्य यदि वै वीर न हनिष्यसि सूतजम् ।\nप्राणानेव परित्यक्ष्ये जीवितार्थो हि को मम\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2170900, "chapter_id": 4648, "verse_number": "१८", "content_sanskrit": "एवमुक्तः प्रत्युवाच विजयो भरतर्षभ ।\nसत्येन ते शपे राजन् प्रसादेन तवैव च\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2170901, "chapter_id": 4648, "verse_number": "१९", "content_sanskrit": "भीमेन च नरश्रेष्ठ यमाभ्यां च महीपते\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2170902, "chapter_id": 4648, "verse_number": "२०", "content_sanskrit": "यथाद्य समरे कर्णं हनिष्यामि हतोऽथ वा ।\nमहीतळे पतिष्यामि सत्येनायुधमालभे\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2170903, "chapter_id": 4648, "verse_number": "२१", "content_sanskrit": "एवमाभाष्य राजानमब्रीन्माधवं वचः ।\nअद्य कर्णं रणे कृष्ण सूदयिष्ये न संशयः ।\nतदनुध्याहि भद्रं ते वधं तस्य दुरात्मनः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2170904, "chapter_id": 4648, "verse_number": "२२", "content_sanskrit": "एवमुक्तोऽब्रवीत् पार्थं केशवो राजसत्तम ।\nशक्तोऽसि भरतश्रेष्ठ हन्तुं कर्णं महाबलम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2170905, "chapter_id": 4648, "verse_number": "२३", "content_sanskrit": "एवं चापि हि मे कामो नित्यमेव महारथ ।\nकथं भवान् रणे कर्णं निहन्यादिति मे मतिः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2170906, "chapter_id": 4648, "verse_number": "२४", "content_sanskrit": "भूयश्चोवाच मतिमान् माधवो धर्मनन्दनम् ।\nयुधिष्ठिरेमं बीभत्सुं त्वं सान्त्वयितुमर्हसि ।\nअनुज्ञातुं च कर्णस्य वधायाद्य दुरात्मनः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2170907, "chapter_id": 4648, "verse_number": "२५", "content_sanskrit": "श्रुत्वा ह्ययमहं चैव त्वां कर्णशरपीडितम् ।\nप्रवृत्तिं ज्ञातुमायाताविह पाण्डवनन्दन\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2170908, "chapter_id": 4648, "verse_number": "२६", "content_sanskrit": "दिष्ट्यासि राजन् निरुजो दिष्ट्या न ग्रहणं गतः ।\nपरिसान्त्वय बीभत्सुं जयमाशाधि चानघ\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2170909, "chapter_id": 4648, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2170910, "chapter_id": 4648, "verse_number": "२७", "content_sanskrit": "एह्येहि पार्थ बीभत्सो मां परिष्वज्य पाण्डव ।\nवक्तव्यमुक्तोऽस्म्यहितं त्वया क्षान्तं च तन्मया\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2170911, "chapter_id": 4648, "verse_number": "२८", "content_sanskrit": "अहं त्वामनुजानामि जहि कर्णं धनञ्जय ।\nमन्युं च मा कृथाः पार्थ यन्मयोक्तोऽसि दारुणम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2170912, "chapter_id": 4648, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2170913, "chapter_id": 4648, "verse_number": "२९", "content_sanskrit": "ततो धनञ्जयो राजन् शिरसा प्रणतस्तदा ।\nपादौ जग्राह पाणिभ्यां भ्रातुर्ज्येष्ठस्य मारिष\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2170914, "chapter_id": 4648, "verse_number": "३०", "content_sanskrit": "समुत्थाप्य ततो राजा परिष्वज्य च पीडितम् ।\nमूर्ध्न्युपाघ्राय चैवैनमिदं पुनरुवाच ह\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2170915, "chapter_id": 4648, "verse_number": "३१", "content_sanskrit": "धनञ्जय महाबाहो मानितोऽस्मि दृढं त्वया ।\nमाहात्म्यं विजयं चैव भूयः प्राप्नुहि शाश्वतम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2170916, "chapter_id": 4648, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2170917, "chapter_id": 4648, "verse_number": "३२", "content_sanskrit": "अद्य तं पापकर्माणं सानुबन्धं रणे शरैः ।\nनयाम्यन्तं समासाद्य राधेयं बलगर्वितम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2170918, "chapter_id": 4648, "verse_number": "३३", "content_sanskrit": "येन त्वं पीडितो बाणैर्दृढमायम्य कार्मुकम् ।\nतस्याद्य कर्मणः कर्णः फलं प्राप्स्यति दारुणम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2170919, "chapter_id": 4648, "verse_number": "३४", "content_sanskrit": "अद्य त्वामहमेष्यामि कर्णं हत्वा महीपते ।\nसभाजयितुमाक्रन्दादिति सत्यं ब्रवीमि ते\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2170920, "chapter_id": 4648, "verse_number": "३५", "content_sanskrit": "नाहत्वा विनिवर्तेऽहं कर्णमद्य रणाजिरात् ।\nइति सत्येन ते पादौ स्पृशामि जगतीपते\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2170921, "chapter_id": 4648, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2170922, "chapter_id": 4648, "verse_number": "समाप्तिः", "content_sanskrit": "इति ब्रुवाणं सुमनाः किरीटिनं\nयुधिष्ठिरः प्राह वचो बृहत्तरम् ।\nयशोऽक्षयं जीवितमीप्सितं ते\nजयं सदा वीर्यमरिक्षयं तदा\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2170923, "chapter_id": 4648, "verse_number": "३७", "content_sanskrit": "प्रयाहि वृद्धिं च दिशन्तु देवता\nयथाहमिच्छामि तवास्तु तत्तथा ।\nप्रयाहि शीघ्रं जहि कर्णमाहवे\nपुरन्दरो वृत्रमिवात्मवृद्धये\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2170924, "chapter_id": 4648, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nधर्मराजार्जुनसंवादे अर्जुनसान्त्वनवचनं नाम अष्टषष्टितमोऽध्यायः ॥६८॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]