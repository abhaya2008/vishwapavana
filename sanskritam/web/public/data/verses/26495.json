[{"id": 7006495000, "chapter_id": 26495, "verse_number": "३-३४-१", "content_sanskrit": "भगवता यज्ञवराहेण पृथिव्याः उद्धारः वैशम्पायन उवाच जगदण्डमिदं पूर्वमासीत् सर्वं हिरण्मयम् ।\nप्रजापतेर्मूर्तिमयमित्येवं वैदिकी श्रुतिः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006495001, "chapter_id": 26495, "verse_number": "३-३४-२", "content_sanskrit": "ततो वर्षसहस्रान्ते बिभेदोर्ध्वमुखं विभुः ।\nलोकसंजननार्थाय बिभेदाण्डं पुनः पुनः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006495002, "chapter_id": 26495, "verse_number": "३-३४-३", "content_sanskrit": "भूयोऽष्टधा बिभेदाण्डं प्रभुर्वै लोकयोनिकृत् ।\nचकार जगतश्चात्र विभागं सर्वभागवित् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006495003, "chapter_id": 26495, "verse_number": "३-३४-४", "content_sanskrit": "यच्छिद्रमूर्ध्वमाकाशं परा सुकृतिनां गतिः ।\nविहितं विश्वयोगेन यदधस्तद् रसातलम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006495004, "chapter_id": 26495, "verse_number": "३-३४-५", "content_sanskrit": "यदण्डमकरोत् पूर्वं देवलोकसिसृक्षया ।\nसमन्तादष्टधा यानि च्छिद्राणि कृतवांस्तु सः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006495005, "chapter_id": 26495, "verse_number": "३-३४-६", "content_sanskrit": "विदिशस्ता दिशः सर्वा मनसैवाकरोद् द्विधा ।\nनानारागविरागाणि यान्यण्डशकलानि वै ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006495006, "chapter_id": 26495, "verse_number": "३-३४-७", "content_sanskrit": "बहुवर्णधराश्चित्रा बभूवुस्ते बलाहकाः ।\nयदण्डमध्ये स्कन्नं तदृतमासीत् समाहितम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006495007, "chapter_id": 26495, "verse_number": "३-३४-८", "content_sanskrit": "जातरूपं तदभवत् तत् सर्वं पृथिवीतले ।\nतस्य क्लेदार्णवौघेन प्राच्छाद्यत समन्ततः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006495008, "chapter_id": 26495, "verse_number": "३-३४-९", "content_sanskrit": "पृथिवी निखिला राजन् युगान्ते सागरैरिव ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006495009, "chapter_id": 26495, "verse_number": "३-३४-१०", "content_sanskrit": "यच्चाण्डमकरोत् पूर्वं देवलोकचिकीर्षया ।\nतत्र तत्सलिलं स्कन्नं सोऽभवत् काञ्चनोगिरिः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006495010, "chapter_id": 26495, "verse_number": "३-३४-११", "content_sanskrit": "तेनाम्भसा प्लुताः सर्वा दिशश्चोपदिशस्तथा ।\nअन्तरिक्षं च नाकं च यच्चान्यत् किंचिदन्तरम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006495011, "chapter_id": 26495, "verse_number": "३-३४-१२", "content_sanskrit": "यत्र यत्र जलं स्कन्नं तत्र तत्र स्थितो गिरिः ।\nशैलैः समस्तैर्गहना विषमा मेदिनी भवत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006495012, "chapter_id": 26495, "verse_number": "३-३४-१३", "content_sanskrit": "ते सपर्वतजालौघैर्बहुयोजनविस्तृतैः ।\nपीडिता गुरुभिर्देवी पृथिवी व्यथिताभवत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006495013, "chapter_id": 26495, "verse_number": "३-३४-१४", "content_sanskrit": "महीतले भूरि जलं दिव्यं नारायणात्मकम् ।\nहिरण्मयं समुद्दिष्टं तेजो विमलरूपितम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006495014, "chapter_id": 26495, "verse_number": "३-३४-१५", "content_sanskrit": "अशक्ता वै धारयितुमधः सा प्रविवेश ह ।\nपीड्यमाना भगवतस्तेजसा तेन सा क्षितिः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006495015, "chapter_id": 26495, "verse_number": "३-३४-१६", "content_sanskrit": "पृथिवीं विशतीं दृष्ट्वा तामधो मधुसूदनः ।\nउद्धारार्थं मनश्चक्रे लोकानां हितकाम्यया ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006495016, "chapter_id": 26495, "verse_number": "३-३४-१७", "content_sanskrit": "श्रीभगवानुवाच मत्तेज एव बलवत् समासाद्य तपस्विनी ।\nरसातलं विशेद् देवी पङ्के गौरिव दुर्बला ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006495017, "chapter_id": 26495, "verse_number": "३-३४-१८", "content_sanskrit": "धरण्युवाच त्रिविक्रमायामितविक्रमाय महानृसिंहाय चतुर्भुजाय ।\nश्रीशार्ङ्गचक्रासिगदाधराय नमोऽस्तु तस्मै पुरुषोत्तमाय ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006495018, "chapter_id": 26495, "verse_number": "३-३४-१९", "content_sanskrit": "त्वयाऽऽत्मना धार्यते वै त्वया संह्रियते जगत् ।\nत्वं धारयसि भूतानां भुवनं त्वं बिभर्षि च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006495019, "chapter_id": 26495, "verse_number": "३-३४-२०", "content_sanskrit": "यत्त्वया धार्यते किंचित्तेजसा च बलेन च ।\nततस्तव प्रसादेन मया पश्चात् तु धार्यते ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006495020, "chapter_id": 26495, "verse_number": "३-३४-२१", "content_sanskrit": "त्यया धृतं धारयामि नाधृतं धारयाम्यहम् ।\nन हि तद् विद्यते रूपं यत्त्वया न तु धार्यते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006495021, "chapter_id": 26495, "verse_number": "३-३४-२२", "content_sanskrit": "त्वमेव कुरुषे वीर नारायण युगे युगे ।\nमम भारावतरणं जगतो हितकाम्यया ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006495022, "chapter_id": 26495, "verse_number": "३-३४-२३", "content_sanskrit": "तवैव तेजसाऽऽक्रान्तां रसातलतलं गताम् ।\nत्रायस्व मां सुरश्रेष्ठ त्वामेव शरणं गताम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006495023, "chapter_id": 26495, "verse_number": "३-३४-२४", "content_sanskrit": "दानवैः पीड्यमानाहं राक्षसैश्च दुरात्मभिः ।\nत्वामेव शरणं नित्यमुपयामि सनातनम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006495024, "chapter_id": 26495, "verse_number": "३-३४-२५", "content_sanskrit": "तावन्मेऽस्ति भयं भूयो यावन्न त्वां ककुद्मिनम् ।\nशरणं यामि मनसा शतशोऽप्युपलक्षये ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006495025, "chapter_id": 26495, "verse_number": "३-३४-२६", "content_sanskrit": "श्रीभगवानुवाच मा भैर्धरणि कल्याणि शान्तिं व्रज समाहिता ।\nएष त्वामुचितं स्थानमानयामि मनीषितम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006495026, "chapter_id": 26495, "verse_number": "३-३४-२७", "content_sanskrit": "वैशम्पायन उवाच ततो महात्मा मनसा दिव्यं रूपमचिन्तयत् ।\nकिं नु रूपमहं कृत्वा उद्धरामि वसुन्धराम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006495027, "chapter_id": 26495, "verse_number": "३-३४-२८", "content_sanskrit": "जले निमग्नां धरणीं येनाहं वै समुद्धरे ।\nइत्येवं चिन्तयित्वा तु देवस्त्वत्करणे मतिम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006495028, "chapter_id": 26495, "verse_number": "३-३४-२९", "content_sanskrit": "जलक्रीडारुचिस्तस्माद् वाराहं रूपमस्मरत् ।\nहरिरुद्धरणे युक्तस्तदाभूदस्य भूमिभृत् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006495029, "chapter_id": 26495, "verse_number": "३-३४-३०", "content_sanskrit": "अधृष्यं सर्वभूतानां वाङ्मयं ब्रह्मसम्मितम् ।\nदशयोजनविस्तारमुच्छ्रितं शतयोजनम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006495030, "chapter_id": 26495, "verse_number": "३-३४-३१", "content_sanskrit": "नीलमेघप्रतीकाशं मेघस्तनितनिःस्वनम् ।\nमहागिरेः संहननं श्वेतदीप्तोग्रदंष्ट्रिणम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006495031, "chapter_id": 26495, "verse_number": "३-३४-३२", "content_sanskrit": "विद्युदग्निप्रतीकाशमादित्यसमतेजसम् ।\nपीनवृत्तायतस्कन्धं दृप्तशार्दूलगामिनम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006495032, "chapter_id": 26495, "verse_number": "३-३४-३३", "content_sanskrit": "पीनोन्ततकटीदेशं वृषलक्षणपूजितम् ।\nरूपमास्थाय विपुलं वाराहममितं हरिः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006495033, "chapter_id": 26495, "verse_number": "३-३४-३४", "content_sanskrit": "पृथिव्युद्धरणार्थाय प्रविवेश रसातलम् ।\nवेदपादो यूपदंष्ट्रः क्रतुदन्तश्चितीमुखः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006495034, "chapter_id": 26495, "verse_number": "३-३४-३५", "content_sanskrit": "वराह प्रतिमा - खजुराहो अग्निजिह्वो दर्भरोमा ब्रह्मशीर्षो महातपाः ।\nअहोरात्रेक्षणधरो वेदाङ्गश्रुतिभूषणः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006495035, "chapter_id": 26495, "verse_number": "३-३४-३६", "content_sanskrit": "वराह मुख - खजुराहो आज्यनासः स्रुवातुण्डः सामघोषस्वरो महान् ।\nसत्यधर्ममयः श्रीमान् क्रमविक्रमसत्कृतः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006495036, "chapter_id": 26495, "verse_number": "३-३४-३७", "content_sanskrit": "क्रियासत्रमहाघोणः पशुजानुर्मखाकृतिः ।\nउद्गात्रान्त्रो होमलिङ्गो बीजौषधिमहाफलः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006495037, "chapter_id": 26495, "verse_number": "३-३४-३८", "content_sanskrit": "वाय्वन्तरात्मा मन्त्रस्पृग् विक्रमः सोमशोणितः ।\nवेदीस्कन्धो हविर्गन्धो हव्यकव्यातिवेगवान् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006495038, "chapter_id": 26495, "verse_number": "३-३४-३९", "content_sanskrit": "प्राग्वंशकायो द्युतिमान् नानादीक्षाभिरर्चितः ।\nदक्षिणाहृदयो योगी महासत्रमयो महान् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006495039, "chapter_id": 26495, "verse_number": "३-३४-४०", "content_sanskrit": "उपाकर्मोष्ठरुचकः प्रवर्ग्यावर्तभूषणः ।\nनानाछन्दोगतिपथो गुह्योपनिषदासनः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006495040, "chapter_id": 26495, "verse_number": "३-३४-४१", "content_sanskrit": "छायापत्नीसहायो वै मणिशृङ्ग इवोच्छ्रितः ।\nभूत्वा यज्ञवराहोऽसौ युगपत्प्राविशद् गुरुः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006495041, "chapter_id": 26495, "verse_number": "३-३४-४२", "content_sanskrit": "अद्भिः संछादितामुर्वीं स तामार्च्छत् प्रजापतिः ।\nरसातलतले मग्नां पातालान्तरसंश्रयाम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006495042, "chapter_id": 26495, "verse_number": "३-३४-४३", "content_sanskrit": "प्रभुर्लोकहितार्थाय दंष्ट्राग्रेणोज्जहार गाम् ।\nततः स्वस्थानमानीय पृथिवीं पृथिवीधरः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006495043, "chapter_id": 26495, "verse_number": "३-३४-४४", "content_sanskrit": "मुमोच पूर्वं सहसा धारयित्वा धराधरः ।\nततो जगाम निर्वाणं मेदिनी तस्य धारणात् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006495044, "chapter_id": 26495, "verse_number": "३-३४-४५", "content_sanskrit": "चकार च नमस्कारं तस्मै देवाय शम्भवे ।\nएवं यज्ञवराहेण भूत्वा भूतहितार्थिना ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006495045, "chapter_id": 26495, "verse_number": "३-३४-४६", "content_sanskrit": "उद्धृता पृथिवी देवी लोकानां हितकाम्यया ।\nअथोद्धृत्य क्षितिं देवो जगतः स्थापनेच्छया ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006495046, "chapter_id": 26495, "verse_number": "३-३४-४७", "content_sanskrit": "पृथिवीप्रविभागाय मनश्चक्रेऽम्बुजेक्षणः ।\nरसातलगतामेवं विचिन्त्य स सुरोत्तमः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006495047, "chapter_id": 26495, "verse_number": "३-३४-४८", "content_sanskrit": "ततो विभुः प्रवरवराहरूपधृग् वृषाकपिः प्रसभमथैकदंष्ट्रया ।\nसमुद्धरन् धरणिमतुल्यविक्रमो महायशाः सकलहितार्थमच्युतः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]