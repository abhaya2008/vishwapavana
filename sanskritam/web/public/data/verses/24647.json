[{"id": 7004647000, "chapter_id": 24647, "verse_number": "६-१०९-१", "content_sanskrit": "ईश्वर उवाच ।\nएतत्ते सर्वमाख्यातं यत्पृष्टोऽस्मि वरानने ।\nसर्वेषामेव तीर्थानां सारं तीर्थसमुच्चयम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004647001, "chapter_id": 24647, "verse_number": "६-१०९-२", "content_sanskrit": "एतेष्वहं वरारोहे सर्वेष्वेव व्यवस्थितः ।\nनाम्ना चान्येषु तीर्थेषु त्रिदशानां हितार्थतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004647002, "chapter_id": 24647, "verse_number": "६-१०९-३", "content_sanskrit": "यो मामेतेषु तीर्थेषु स्नात्वा पश्यति मानवः ।\nकीर्तयेत्कीर्तनान्नाम्ना स नूनं मोक्षमाप्नुयात् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004647003, "chapter_id": 24647, "verse_number": "६-१०९-४", "content_sanskrit": "श्रीदेव्युवाच ।\nयेषु तीर्थेषु यन्नाम कीर्तनीयं तव प्रभो ।\nतत्कार्त्स्येन मम ब्रूहि यच्चहं तव वल्लभा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004647004, "chapter_id": 24647, "verse_number": "६-१०९-५", "content_sanskrit": "ईश्वर उवाच ।\nवाराणस्यां महादेवं प्रयागे च महेश्वरम् ।\nनैमिषे देवदेवं च गयायां प्रपितामहम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004647005, "chapter_id": 24647, "verse_number": "६-१०९-६", "content_sanskrit": "कुरुक्षेत्रे विदुः स्थाणुं प्रभासे शशिशेखरम् ।\nपुष्करे तु ह्यजागन्धिं विश्वं विश्वेश्वरे तथा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004647006, "chapter_id": 24647, "verse_number": "६-१०९-७", "content_sanskrit": "अट्टहासे महानादं महेन्द्रे च महाव्रतम् ।\nउज्जयिन्यां महाकालं मरुकोटे महोत्कटम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004647007, "chapter_id": 24647, "verse_number": "६-१०९-८", "content_sanskrit": "शंकुकर्णे महातेजं गोकर्णे च महाबलम् ।\nरुद्रकोट्यां महायोगं महालिंगं स्थलेश्वरे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004647008, "chapter_id": 24647, "verse_number": "६-१०९-९", "content_sanskrit": "हर्षिते च तथा हर्षं वृषभं वृषभध्वजे ।\nकेदारे चैव ईशानं शर्वं मध्यमकेश्वरे ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004647009, "chapter_id": 24647, "verse_number": "६-१०९-१०", "content_sanskrit": "सुपर्णाक्षं सहस्राक्षे सुसूक्ष्मं कार्तिकेश्वरे ।\nभवं वस्त्रापथे देवि ह्युग्रं कनखले तथा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004647010, "chapter_id": 24647, "verse_number": "६-१०९-११", "content_sanskrit": "भद्रकर्णे शिवं चैव दण्डके दण्डिनं तथा ।\nऊर्ध्वरेतं त्रिदण्डायां चण्डीशं कृमिजांगले ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004647011, "chapter_id": 24647, "verse_number": "६-१०९-१२", "content_sanskrit": "कृत्तिवासं तथैकाम्रे छागलेये कपर्दिनम् ।\nकालिञ्जरे नीलकण्ठं श्रीकण्ठं मण्डलेश्वरे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004647012, "chapter_id": 24647, "verse_number": "६-१०९-१३", "content_sanskrit": "विजयं चैव काश्मीरे जयन्तं मरुकेश्वरे ।\nहरिश्चन्द्रे हरं चैव पुरश्चन्द्रे च शंकरम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004647013, "chapter_id": 24647, "verse_number": "६-१०९-१४", "content_sanskrit": "जटिं वामेश्वरे विन्द्यात्सौम्यं वै कुक्कुटेश्वरे ।\nभूतेश्वरं भस्मगात्रे ओंकारेऽमरकण्टकम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004647014, "chapter_id": 24647, "verse_number": "६-१०९-१५", "content_sanskrit": "त्र्यंबकं च त्रिसंध्यायां विरजायां त्रिलोचनम् ।\nदीप्तमर्केश्वरे ज्ञेयं नेपाले पशुपालकम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004647015, "chapter_id": 24647, "verse_number": "६-१०९-१६", "content_sanskrit": "यमलिंगं च दुष्कर्णे कपाली करवीरके ।\nजागेश्वरे त्रिशूली च श्रीशैले त्रिपुरांतकम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004647016, "chapter_id": 24647, "verse_number": "६-१०९-१७", "content_sanskrit": "रोहणं तु अयोध्यायां पाताले हाटकेश्वरम् ।\nकारोहणे नकुलीशं देविकायामुमापतिम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004647017, "chapter_id": 24647, "verse_number": "६-१०९-१८", "content_sanskrit": "भैरवे भैरवाकारममरं पूर्वसागरे ।\nसप्तगोदावरे भीमं स्वयंभूर्निर्मलेश्वरे ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004647018, "chapter_id": 24647, "verse_number": "६-१०९-१९", "content_sanskrit": "कर्णिकारे गणाध्यक्षं कैलासे तु गणाधिपम् ।\nगंगाद्वारे हिमस्थानं जल लिंगे जलप्रियम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004647019, "chapter_id": 24647, "verse_number": "६-१०९-२०", "content_sanskrit": "अनलं वाडवेऽग्नौ च भीमं बदरिकाश्रमे ।\nश्रेष्ठे कोटीश्वरं चैव वाराहं विन्ध्यपर्वते ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004647020, "chapter_id": 24647, "verse_number": "६-१०९-२१", "content_sanskrit": "हेमकूटे विरूपाक्षं भूर्भुवं गन्धमादने ।\nलिंगेश्वरे च वरदं लंकायां च नरांतकम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004647021, "chapter_id": 24647, "verse_number": "६-१०९-२२", "content_sanskrit": "अष्टषष्टिरियं देवि तवाख्याता विशेषतः ।\nपठतां शृण्वतां वापि सर्वपातकनाशिनी ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004647022, "chapter_id": 24647, "verse_number": "६-१०९-२३", "content_sanskrit": "तस्मात्सर्वप्रयत्नेन कीर्तनीया विचक्षणैः ।\nकालत्रयेऽपि शुचिभिर्विशेषाच्छिवदीक्षितैः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004647023, "chapter_id": 24647, "verse_number": "६-१०९-२४", "content_sanskrit": "लिखितापि वरारोहे यस्यैषा तिष्ठते गृहे ।\nन तत्र जायते दोषो भूतप्रेतसमुद्भवः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004647024, "chapter_id": 24647, "verse_number": "६-१०९-२५", "content_sanskrit": "न व्याधेर्न च सर्पाणां न चौराणां वरानने ।\nनान्येषां भूभुजादीनां कदाचिदपि कुत्रचित् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]