[{"id": 5000003000, "chapter_id": 9003, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे तृतीयः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000003001, "chapter_id": 9003, "verse_number": "१-३-१", "content_sanskrit": "श्रुत्वा वस्तु समग्रं तद्धर्मार्थसहितं हितम् ।\nव्यक्तमन्वेषते भूयो यद् वृत्तं तस्य धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000003002, "chapter_id": 9003, "verse_number": "१-३-२", "content_sanskrit": "उपस्पृश्योदकं सम्यङ्मुनिः स्थित्वा कृताञ्जलिः ।\nप्राचीनाग्रेषु दर्भेषु धर्मेणान्वेषते गतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000003003, "chapter_id": 9003, "verse_number": "१-३-३", "content_sanskrit": "रामलक्ष्मणसीताभी राज्ञा दशरथेन च ।\nसभार्येण सराष्ट्रेण यत् प्राप्तं तत्र तत्त्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000003004, "chapter_id": 9003, "verse_number": "१-३-४", "content_sanskrit": "हसितं भाषितं चैव गतिर्यावच्च चेष्टितम् ।\nतत् सर्वं धर्मवीर्येण यथावत् संप्रपश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000003005, "chapter_id": 9003, "verse_number": "१-३-५", "content_sanskrit": "स्त्रीतृतीयेन च तथा यत् प्राप्तं चरता वने ।\nसत्यसन्धेन रामेण तत् सर्वं चान्ववैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000003006, "chapter_id": 9003, "verse_number": "१-३-६", "content_sanskrit": "ततः पश्यति धर्मात्मा तत् सर्वं योगमास्थितः ।\nपुरा यत् तत्र निर्वृत्तं पाणावामलकं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000003007, "chapter_id": 9003, "verse_number": "१-३-७", "content_sanskrit": "तत् सर्वं तत्त्वतो दृष्ट्वा धर्मेण स महामतिः ।\nअभिरामस्य रामस्य तत् सर्वं कर्तुमुद्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000003008, "chapter_id": 9003, "verse_number": "१-३-८", "content_sanskrit": "कामार्थगुणसंयुक्तं धर्मार्थगुणविस्तरम् ।\nसमुद्रमिव रत्नाढ्यं सर्वश्रुतिमनोहरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000003009, "chapter_id": 9003, "verse_number": "१-३-९", "content_sanskrit": "स यथा कथितं पूर्वं नारदेन महात्मना ।\nरघुवंशस्य चरितं चकार भगवान् मुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000003010, "chapter_id": 9003, "verse_number": "१-३-१०", "content_sanskrit": "जन्म रामस्य सुमहद्वीर्यं सर्वानुकूलताम् ।\nलोकस्य प्रियतां क्षान्तिं सौम्यतां सत्यशीलताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000003011, "chapter_id": 9003, "verse_number": "१-३-११", "content_sanskrit": "नाना चित्राः कथाश्चान्या विश्वामित्रसहायने ।\nजानक्याश्च विवाहं च धनुषश्च विभेदनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000003012, "chapter_id": 9003, "verse_number": "१-३-१२", "content_sanskrit": "रामरामविवादं च गुणान् दाशरथेस्तथा ।\nतथाभिषेकं रामस्य कैकेय्या दुष्टभावताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000003013, "chapter_id": 9003, "verse_number": "१-३-१३", "content_sanskrit": "विघातं चाभिषेकस्य रामस्य च विवासनम् ।\nराज्ञः शोकं विलापं च परलोकस्य चाश्रयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000003014, "chapter_id": 9003, "verse_number": "१-३-१४", "content_sanskrit": "प्रकृतीनां विषादं च प्रकृतीनां विसर्जनम् ।\nनिषादाधिपसंवादं सूतोपावर्तनं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000003015, "chapter_id": 9003, "verse_number": "१-३-१५", "content_sanskrit": "गङ्गायाश्चापि संतारं भरद्वाजस्य दर्शनम् ।\nभरद्वाजाभ्यनुज्ञानाच्चित्रकूटस्य दर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000003016, "chapter_id": 9003, "verse_number": "१-३-१६", "content_sanskrit": "वास्तुकर्म निवेशं च भरतागमनं तथा ।\nप्रसादनं च रामस्य पितुश्च सलिलक्रियाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000003017, "chapter_id": 9003, "verse_number": "१-३-१७", "content_sanskrit": "पादुकाग्र्याभिषेकं च नन्दिग्रामनिवासनम् ।\nदण्डकारण्यगमनं विराधस्य वधं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000003018, "chapter_id": 9003, "verse_number": "१-३-१८", "content_sanskrit": "दर्शनं शरभङ्गस्य सुतीक्ष्णेन समागमम्\nअनसूयासमाख्यां च अङ्गरागस्य चार्पणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000003019, "chapter_id": 9003, "verse_number": "१-३-१९", "content_sanskrit": "दर्शनं चाप्यगस्त्यस्य धनुषो ग्रहणं तथा ।\nशूर्पणख्याश्च संवादं विरूपकरणं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000003020, "chapter_id": 9003, "verse_number": "१-३-२०", "content_sanskrit": "वधं खरत्रिशिरसोरुत्थानं रावणस्य च ।\nमारीचस्य वधं चैव वैदेह्या हरणं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000003021, "chapter_id": 9003, "verse_number": "१-३-२१", "content_sanskrit": "राघवस्य विलापं च गृध्रराजनिबर्हणम् ।\nकबन्धदर्शनं चैव पम्पायाश्चापि दर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000003022, "chapter_id": 9003, "verse_number": "१-३-२२", "content_sanskrit": "शबरीदर्शनं चैव फलमूलाशनं तथा ।\nप्रलापं चैव पम्पायां हनूमद्दर्शनं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000003023, "chapter_id": 9003, "verse_number": "१-३-२३", "content_sanskrit": "ऋष्यमूकस्य गमनं सुग्रीवेण समागमम् ।\nप्रत्ययोत्पादनं सख्यं वालिसुग्रीवविग्रहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000003024, "chapter_id": 9003, "verse_number": "१-३-२४", "content_sanskrit": "वालिप्रमथनं चैव सुग्रीवप्रतिपादनम्\nताराविलापं समयं वर्षरात्रनिवासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000003025, "chapter_id": 9003, "verse_number": "१-३-२५", "content_sanskrit": "कोपं राघवसिंहस्य बलानामुपसंग्रहम्\nदिशः प्रस्थापनं चैव पृथिव्याश्च निवेदनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000003026, "chapter_id": 9003, "verse_number": "१-३-२६", "content_sanskrit": "अङ्गुलीयकदानं च ऋक्षस्य बिलदर्शनम्\nप्रायोपवेशनं चैव संपातेश्चापि दर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000003027, "chapter_id": 9003, "verse_number": "१-३-२७", "content_sanskrit": "पर्वतारोहणं चैव सागरस्यापि लङ्घनम्\nसमुद्रवचनाच्चैव मैनाकस्य च दर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000003028, "chapter_id": 9003, "verse_number": "१-३-२८", "content_sanskrit": "राक्षसीतर्जनं चैव च्छायाग्राहस्य दर्शनम्\nसिंहिकायाश्च निधनं लङ्कामलयदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000003029, "chapter_id": 9003, "verse_number": "१-३-२९", "content_sanskrit": "रात्रौ लङ्काप्रवेशं च एकस्यापि विचिन्तनम्\nआपानभूमिगमनमवरोधस्य दर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000003030, "chapter_id": 9003, "verse_number": "१-३-३०", "content_sanskrit": "दर्शनं रावणस्यापि पुष्पकस्य च दर्शनम्\nअशोकवनिकायानं सीतायाश्चापि दर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000003031, "chapter_id": 9003, "verse_number": "१-३-३१", "content_sanskrit": "अभिज्ञानप्रदानं च सीतायाश्चापि भाषणम्\nराक्षसीतर्जनं चैव त्रिजटास्वप्नदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000003032, "chapter_id": 9003, "verse_number": "१-३-३२", "content_sanskrit": "मणिप्रदानं सीताया वृक्षभङ्गं तथैव च\nराक्षसीविद्रवं चैव किंकराणां निबर्हणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000003033, "chapter_id": 9003, "verse_number": "१-३-३३", "content_sanskrit": "ग्रहणं वायुसूनोश्च लङ्कादाहाभिगर्जनम्\nप्रतिप्लवनमेवाथ मधूनां हरणं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000003034, "chapter_id": 9003, "verse_number": "१-३-३४", "content_sanskrit": "राघवाश्वासनं चैव मणिनिर्यातनं तथा\nसंगमं च समुद्रेण नलसेतोश्च बन्धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000003035, "chapter_id": 9003, "verse_number": "१-३-३५", "content_sanskrit": "प्रतारं च समुद्रस्य रात्रौ लङ्कावरोधनम्\nविभीषणेन संसर्गं वधोपायनिवेदनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000003036, "chapter_id": 9003, "verse_number": "१-३-३६", "content_sanskrit": "कुम्भकर्णस्य निधनं मेघनादनिबर्हणम्\nरावणस्य विनाशं च सीतावाप्तिमरेः पुरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000003037, "chapter_id": 9003, "verse_number": "१-३-३७", "content_sanskrit": "बिभीषणाभिषेकं च पुष्पकस्य च दर्शनम्\nअयोध्यायाश्च गमनं भरद्वाजसमागमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000003038, "chapter_id": 9003, "verse_number": "१-३-३८", "content_sanskrit": "प्रेषणं वायुपुत्रस्य भरतेन समागमम्\nरामाभिषेकाभ्युदयं सर्वसैन्यविसर्जनम्\nस्वराष्ट्ररञ्जनं चैव वैदेह्याश्च विसर्जनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000003039, "chapter_id": 9003, "verse_number": "१-३-३९", "content_sanskrit": "अनागतं च यत् किंचिद् रामस्य वसुधातले\nतच्चकारोत्तरे काव्ये वाल्मीकिर्भगवानृषिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000003040, "chapter_id": 9003, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे तृतीयः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]