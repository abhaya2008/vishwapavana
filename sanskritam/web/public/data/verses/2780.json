[{"id": 2083426, "chapter_id": 2780, "verse_number": "१२-२८५-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2083427, "chapter_id": 2780, "verse_number": "१२-२८५-१", "content_sanskrit": "धन्याधन्या इति जनाः सर्वेऽस्मान्प्रवदन्त्युत।\nन दुःखिततरः कश्चित्पुमानस्माभिरस्ति ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2083428, "chapter_id": 2780, "verse_number": "१२-२८५-२", "content_sanskrit": "लोकसंभावितैर्दुःखं यत्प्राप्तं कुरुसत्तम।\nप्राप्य जातिं मनुष्येषु देवैरपि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2083429, "chapter_id": 2780, "verse_number": "१२-२८५-३", "content_sanskrit": "कदा वयं करिष्यामः संन्यासं दुःखभेषजम्।\nदुःखमेतच्छरीराणां धारणं कुरुसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2083430, "chapter_id": 2780, "verse_number": "१२-२८५-४", "content_sanskrit": "विमुक्ताः सप्तदशभिर्हेतुभूतैश्च पञ्चभिः।\nइन्द्रियार्थैर्गुणैश्चैव अष्टाभिश्च पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2083431, "chapter_id": 2780, "verse_number": "१२-२८५-५", "content_sanskrit": "न गच्छन्ति पुनर्भावं मुनयः संशितव्रताः।\nकदा वयं गमिष्यामो राज्यं हित्वा परंतप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2083432, "chapter_id": 2780, "verse_number": "१२-२८५-६x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2083433, "chapter_id": 2780, "verse_number": "१२-२८५-६", "content_sanskrit": "नास्त्यनन्तं महाराज सर्वं सङ्ख्यानगोचरम्।\nपुनर्भावोपि संख्यातो नास्ति किंचिदिहाचलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2083434, "chapter_id": 2780, "verse_number": "१२-२८५-७", "content_sanskrit": "न चापि गम्यते राजन्नैष दोषः प्रसङ्गतः।\nउद्योगादेव धर्मज्ञाः कालेनैव गमिष्यथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2083435, "chapter_id": 2780, "verse_number": "१२-२८५-८", "content_sanskrit": "नेशेऽयं सततं देही नृपते पुण्यपापयोः।\nतत एव समुत्थेन तमसा रुध्यतेऽपि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2083436, "chapter_id": 2780, "verse_number": "१२-२८५-९", "content_sanskrit": "यथाञ्जनमयो वायुः पुनर्मानःशिलं रजः।\nअनुप्रविश्य तद्वर्णो दृश्यते रञ्जयन्दिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2083437, "chapter_id": 2780, "verse_number": "१२-२८५-१०", "content_sanskrit": "तथा कर्मफलैर्देही रञ्जितस्तमसा वृतः।\nविवर्णो वर्णमाश्रित्य देहेषु परिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2083438, "chapter_id": 2780, "verse_number": "१२-२८५-११", "content_sanskrit": "ज्ञानेन हि यदा जन्तुरज्ञानप्रभवं तमः।\nव्यपोहति तदा ब्रह्म प्रकाशेत सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2083439, "chapter_id": 2780, "verse_number": "१२-२८५-१२", "content_sanskrit": "अयत्नसाध्यं मुनयो वदन्ति\nचे चापि मुक्तास्तदुपासितव्याः।\nत्वया च लोकेन च सामरेण\nतस्मान्न शाम्यन्ति महर्षिसङ्घाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2083440, "chapter_id": 2780, "verse_number": "१२-२८५-१३", "content_sanskrit": "अस्मिन्नर्थे पुरा गीतं शृणुष्वैकमना नृप।\nयथा दैत्येन वृत्रेण भ्रष्टैश्वर्येण चेष्टितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2083441, "chapter_id": 2780, "verse_number": "१२-२८५-१४", "content_sanskrit": "निर्जितेनासहायेन हृतराज्येन भारत।\nअशोचता शत्रुमध्ये बुद्धिमास्थाय केवलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2083442, "chapter_id": 2780, "verse_number": "१२-२८५-१५", "content_sanskrit": "भ्रष्टैश्वर्यं पुरा वृत्रमुशना वाक्यमब्रवीत्।\nकच्चित्पराजितस्याद्य न व्यथा तेऽस्ति दानव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2083443, "chapter_id": 2780, "verse_number": "१२-२८५-१६x", "content_sanskrit": "वृत्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2083444, "chapter_id": 2780, "verse_number": "१२-२८५-१६", "content_sanskrit": "सत्येन तपसा चैव विदित्वा संक्षयं ह्यहम्।\nन शोचामि न हृष्यामि भूतानामागतिं गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2083445, "chapter_id": 2780, "verse_number": "१२-२८५-१७", "content_sanskrit": "कालसंचोदिता जीवा मज्जन्ति नरकेऽवशाः।\nपरिहृष्टानि सर्वाणि दिव्यान्याहुर्मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2083446, "chapter_id": 2780, "verse_number": "१२-२८५-१८", "content_sanskrit": "क्षपयित्वा तु तं कालं गणितं कालचोदिताः।\nसावशेषेण कालेन संधावन्ति पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2083447, "chapter_id": 2780, "verse_number": "१२-२८५-१९", "content_sanskrit": "तिर्यग्योनिसहस्राणि गत्वा नरकमेव च।\nनिर्गच्छन्त्यवशा जीवाः कालबन्धनबन्धनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2083448, "chapter_id": 2780, "verse_number": "१२-२८५-२०", "content_sanskrit": "एवं संसरमाणानि ह्यहं भूतानि दृष्टवान्।\nयथा कर्म तथा लाभ इति शास्त्रनिदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2083449, "chapter_id": 2780, "verse_number": "१२-२८५-२१", "content_sanskrit": "तिर्यग्गच्छन्ति नरकं मानुष्यं दैवमेव च।\nसुखदुःखे प्रिये द्वेष्ये चरित्वा पूर्वमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2083450, "chapter_id": 2780, "verse_number": "१२-२८५-२२", "content_sanskrit": "कृतान्तविधिसंयुक्तः सर्वो लोकः प्रपद्यते।\nगतं गच्छन्ति चाध्वानं सर्वभूतानि सर्वदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2083451, "chapter_id": 2780, "verse_number": "१२-२८५-२३", "content_sanskrit": "कालसङ्ख्यानसङ्ख्येयं सृष्टिस्थितिपरायणम्।\nतं भाषमाणं भगवानुशना प्रत्यभाषत।\nइमान्दुष्टप्रलापांस्त्वं तात कस्मात्प्रभाषते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2083452, "chapter_id": 2780, "verse_number": "१२-२८५-२४x", "content_sanskrit": "वृत्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2083453, "chapter_id": 2780, "verse_number": "१२-२८५-२४", "content_sanskrit": "प्रत्यक्षमेतद्भवतस्तथाऽन्येषां मनीषिणाम्।\nमया यज्जयलुब्धेन पुरा तप्तं महत्तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2083454, "chapter_id": 2780, "verse_number": "१२-२८५-२५", "content_sanskrit": "गन्धानादाय भूतानां रसांश्च विविधानपि।\nअवर्धं त्रीन्समाक्रम्य लोकान्वै स्वेन तेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2083455, "chapter_id": 2780, "verse_number": "१२-२८५-२६", "content_sanskrit": "ज्वालामालापरिक्षिप्तो वैहायसगतिस्तथा।\nअजेयः सर्वभूतानामासं नित्यमपेतभीः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2083456, "chapter_id": 2780, "verse_number": "१२-२८५-२७", "content_sanskrit": "ऐश्वर्यं तपसा प्राप्तं भ्रष्टं तच्च स्वकर्मभिः।\nधृतिमास्थाय भगवन्न शोचामि ततस्त्वहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2083457, "chapter_id": 2780, "verse_number": "१२-२८५-२८", "content_sanskrit": "युयुत्सता महेन्द्रेण पुरा सार्धं महात्मना।\nततो मे भगवान्दृष्टो हरिर्नारायणः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2083458, "chapter_id": 2780, "verse_number": "१२-२८५-२९", "content_sanskrit": "वैकुण्ठः पुरुषोऽनन्तः शुक्लो विष्णुः सनातनः।\nमुञ्जकेशो हरिश्मश्रुः सर्वभूतपितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2083459, "chapter_id": 2780, "verse_number": "१२-२८५-३०", "content_sanskrit": "नूनं तु तस्य तपसः सावशेषं ममास्ति वै।\nयदहं प्रष्टुमिच्छामि भवन्तं कर्मणः फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2083460, "chapter_id": 2780, "verse_number": "१२-२८५-३१", "content_sanskrit": "ऐश्वर्यं वै महद्ब्रह्मन्वर्णे कस्मिन्प्रतिष्ठितम्।\nनिवर्तते चापि पुनः कथमैश्वर्यमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2083461, "chapter_id": 2780, "verse_number": "१२-२८५-३२", "content_sanskrit": "भवन्ति कस्माद्भूतानि प्रवर्तन्ते यथा पुनः।\nकिं वा फलं परं प्राप्य जीवस्तिष्ठति शाश्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2083462, "chapter_id": 2780, "verse_number": "१२-२८५-३३", "content_sanskrit": "केन वा कर्मणा शक्यमथ ज्ञानेन केन वा।\nब्रह्मर्षे तत्फलं प्राप्तुं तन्मे व्याख्यातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2083463, "chapter_id": 2780, "verse_number": "१२-२८५-३४", "content_sanskrit": "इतीदमुक्तः स मुनिस्तदानीं\nप्रत्याह यत्तच्छृणु राजसिंह।\nमयोच्यमानं पुरुषर्षभ त्व\nमनन्यचित्तः सह सोदरीयैः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2083464, "chapter_id": 2780, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि पञ्चाशीत्यधिकद्विशततमोऽध्यायः॥ २८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]