[{"id": 50018233, "chapter_id": 11617, "verse_number": "1", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50018234, "chapter_id": 11617, "verse_number": "2", "content_sanskrit": "कदाचिद् देवकापुत्रो रामशैनेयसंयुतः। सेव्यमानः सभायां वै नानादेशेश्वरैर्नृपैः॥ १०/५६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50018235, "chapter_id": 11617, "verse_number": "3", "content_sanskrit": "पाञ्चालराजं द्रुपदं बालैः कुन्तीसुतैर्मृधे। बद्धं शुश्राव कौरव्य ब्राह्मणैः सत्रयाजिभिः॥ १०/५६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50018236, "chapter_id": 11617, "verse_number": "4", "content_sanskrit": "तच्छ्रुत्वा हृष्टहृदयः कृतवर्माणमच्युतः। नगरं हस्तिनपुरं प्रेषयामास वेदितुम्॥ १०/५६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50018237, "chapter_id": 11617, "verse_number": "5", "content_sanskrit": "स गत्वा हस्तिनपुरं वृद्धं कुरुपितामहम्। ददर्श द्रोणविदुरधृतराष्ट्रकृपैर्युतम्॥ १०/५६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50018238, "chapter_id": 11617, "verse_number": "6", "content_sanskrit": "युधिष्ठिरं च राजानं चतुर्भिर्भ्रातृभिर्वृतम्। सभाजयमास भृशं कुन्तीं च हृदिकात्मजः॥ १०/५६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50018239, "chapter_id": 11617, "verse_number": "7", "content_sanskrit": "युधिष्ठिरोऽपि पप्रच्छ सानुगं कंसमर्दनम्। हतं च कालयवनं जरासन्धं च निर्जितम्॥ १०/५६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50018240, "chapter_id": 11617, "verse_number": "8", "content_sanskrit": "वासुदेवं च निहतं करवीरपुरेश्वरम्। द्वारवत्याश्च करणं नगर्या वरुणालये॥ १०/५६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50018241, "chapter_id": 11617, "verse_number": "9", "content_sanskrit": "हतौ च हंसडिभिकौ ब्रह्मदत्तं च दुर्जयम्। श्रुत्वा हार्दिक्यवचनाद् याथार्थ्येन युधिष्ठिरः॥ १०/५६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50018242, "chapter_id": 11617, "verse_number": "10", "content_sanskrit": "मेने त्र्यैलोक्यसाम्राज्यं स्वहस्तगतमक्षयम्। सभाजितश्च हार्दिक्यः सुखसम्भाषणादिभिः॥ १०/५६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50018243, "chapter_id": 11617, "verse_number": "11", "content_sanskrit": "पाण्डुपुत्रैस्तथा कुन्त्या सौहार्दस्नुतबाष्पया। हार्दिक्यस्ताननुज्ञाप्य बान्धवान् पृथया सह॥ १०/५६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50018244, "chapter_id": 11617, "verse_number": "12", "content_sanskrit": "मातृष्वसेयान् धर्मज्ञानभिवन्द्य यथावयः। गाङ्गेयेनाभ्यनुज्ञातो धृतराष्ट्रेण चानघ॥ १०/५६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50018245, "chapter_id": 11617, "verse_number": "13", "content_sanskrit": "विदुरेणाङ्गराजेन द्रोणेन च कृपेण च। प्राज्ञेनाचार्यपुत्रेण तथा दुर्योधनेन च॥ १०/५६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50018246, "chapter_id": 11617, "verse_number": "14", "content_sanskrit": "कृतवर्माऽभ्यनुज्ञातो निर्गत्य गजसाह्वयात्। द्वारकां वृष्णिनिलयामाजगाम दिनात्यये॥ १०/५६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50018247, "chapter_id": 11617, "verse_number": "15", "content_sanskrit": "स प्रविश्य सभां दिव्यामनेकनृपसेविताम्। दृष्ट्वा गोविन्दमासीनं काञ्चने परमासने॥ १०/५६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50018248, "chapter_id": 11617, "verse_number": "16", "content_sanskrit": "वीजच्चामरसङ्घातसहितं वनमालिनम्। आचचष्टेऽखिलं तस्य यथादृष्टं यथाश्रुतम्॥ १०/५६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50018249, "chapter_id": 11617, "verse_number": "17", "content_sanskrit": "वृत्तान्तं कौरवेयाणां नगरे गजसाह्वये॥ १०/५६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50018250, "chapter_id": 11617, "verse_number": "18", "content_sanskrit": "तदाकर्ण्य हरिः सर्वं वृत्तान्तं जगदीश्वरः। पौरुषं पाण्डुपुत्राणां बभूवानन्दनिर्भरः॥ १०/५६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50018251, "chapter_id": 11617, "verse_number": "19", "content_sanskrit": "इति श्रीमद्भागवते दशमस्कन्धे षट्पञ्चाशत्तमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]