[{"id": 2013569, "chapter_id": 1280, "verse_number": "२-२१-१", "content_sanskrit": "वासुदेव उवाच॥\nएष पार्थ महान्भाति पशुमान्नित्यमम्बुमान्।\nनिरामयः सुवेश्माढ्यो निवेशो मागधः शुभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2013570, "chapter_id": 1280, "verse_number": "२-२१-२", "content_sanskrit": "वैहारो विपुलः शैलो वाराहो वृषभस्तथा।\nतथा ऋषिगिरिस्तात शुभाश्चैत्यकपञ्चमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2013571, "chapter_id": 1280, "verse_number": "२-२१-३", "content_sanskrit": "एते पञ्चमहाशृङ्गाः पर्वताः शीतलद्रुमाः।\nरक्षन्तीवाभिसंहत्य संहताङ्गा गिरिव्रजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2013572, "chapter_id": 1280, "verse_number": "२-२१-४", "content_sanskrit": "पुष्पवेष्टितशाखाग्रैर्गन्धवद्भिर्मनोहरैः।\nनिगूढा इव लोध्राणां वनैः कामिजनप्रियैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2013573, "chapter_id": 1280, "verse_number": "२-२१-५", "content_sanskrit": "यत्र दीर्घतमा नाम ऋषिः परमन्त्रितः।\nशूद्रायां गौतमो यत्र महात्मा संशितव्रतः।\nऔशीनर्यामजनयत्काक्षीवाद्यान्सुतान्मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2013574, "chapter_id": 1280, "verse_number": "२-२१-६", "content_sanskrit": "गौतमः प्रणयात्तस्माद्यथाऽसौ तत्र सद्मनि।\nभजते मागधं वंशं स नृपाणामनुग्रहः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2013575, "chapter_id": 1280, "verse_number": "२-२१-७", "content_sanskrit": "अङ्गवङ्गादयश्चैव राजानः सुमहाबलाः।\nगौतमक्षयमभ्येत्य रमन्ते स्म पुरार्जुन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2013576, "chapter_id": 1280, "verse_number": "२-२१-८", "content_sanskrit": "वनराजीस्तु पश्येमाः पिप्लानां मनोरमाः।\nलोघ्राणां च शुभाः पार्थ गौतमौकः समीपजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2013577, "chapter_id": 1280, "verse_number": "२-२१-९", "content_sanskrit": "अर्बुदः शक्रवापी च पन्नगौ शत्रुतापनौ।\nस्वस्तिकस्यालयश्चात्र मणिनागस्य चोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2013578, "chapter_id": 1280, "verse_number": "२-२१-१०", "content_sanskrit": "अपारिहार्या मेघानां मागधा मनुना कृताः।\nकौशिको मणिमांश्चैव चक्राते चाप्यनुग्रहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2013579, "chapter_id": 1280, "verse_number": "२-२१-११", "content_sanskrit": "पाण्डरे विपुले चैव तथा वाराहकेऽपि च।\nचैत्यके चज गिरिश्रेष्ठे मादङ्गे च शिलोच्चये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2013580, "chapter_id": 1280, "verse_number": "२-२१-१२", "content_sanskrit": "एतेषु पर्वतेन्द्रेषु सर्वसिद्धसमालयाः।\nयतीनामाश्रमाश्चैव मुनीनां च महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2013581, "chapter_id": 1280, "verse_number": "२-२१-१३", "content_sanskrit": "वृषभस्य तमालस्य महावीर्यस्य वै तथा।\nगन्धर्वरक्षसां चैव नागानां च तथाऽऽलयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2013582, "chapter_id": 1280, "verse_number": "२-२१-१४", "content_sanskrit": "कक्षीवतस्तपोवीर्यात्तपोदा इति विश्रुताः।\nपुण्यतीर्थाश्च ते सर्वे सिद्धानां चैव कीर्तिताः।\nमणेश्च दर्शनादेव भद्रं शिवमवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2013583, "chapter_id": 1280, "verse_number": "२-२१-१५", "content_sanskrit": "एवं प्राप्य पुरं रम्यं दुराधर्पं समन्ततः॥\nअर्थसिद्धिं त्वनुपमां जरासन्धोऽभिमन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2013584, "chapter_id": 1280, "verse_number": "२-२१-१६", "content_sanskrit": "वयमासादने तस्य दर्पमद्य हरेम हि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2013585, "chapter_id": 1280, "verse_number": "२-२१-१६x", "content_sanskrit": "वैशम्पायन उवाच।\nएवमुक्त्वा ततः सर्वे भ्रातरो विपुलौजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2013586, "chapter_id": 1280, "verse_number": "२-२१-१७", "content_sanskrit": "वार्ष्णेयः पाण्डवौ चैव प्रतस्थुर्मागधं पुरम्।\nहृष्टपुष्टजनोपेतं चातुर्वर्ण्यसमाकुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2013587, "chapter_id": 1280, "verse_number": "२-२१-१८", "content_sanskrit": "स्फीतोत्सवमनाधृष्यमासेदुश्च गिरिव्रजतम्।\nततो द्वारमनासाद्य पुरस्य गिरिमुच्छ्रितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2013588, "chapter_id": 1280, "verse_number": "२-२१-१९", "content_sanskrit": "बार्हद्रथैः पूज्यमानं तथा नगरवासिभिः।\nमागधानां तु रुचिरं चैत्यकान्तरमाद्रवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2013589, "chapter_id": 1280, "verse_number": "२-२१-२०", "content_sanskrit": "यत्र मांसादमृषभमाससाद बृहद्रथः।\nतं हत्वा मासतालाभिस्तिस्रो भेरीकारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2013590, "chapter_id": 1280, "verse_number": "२-२१-२१", "content_sanskrit": "स्वपुरे स्थापयामास तेन चानह्य चर्मणा।\nयत्र ताः प्राणदन्भेर्यो दिव्यपुष्पावचूर्णिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2013591, "chapter_id": 1280, "verse_number": "२-२१-२२", "content_sanskrit": "भङ्क्त्वा भेरीत्रयं तेऽपि चैत्यप्राकारमाद्रवन्।\nद्वारतोऽभिमुखाः सर्वे ययुर्नानायुधास्तधा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2013592, "chapter_id": 1280, "verse_number": "२-२१-२३", "content_sanskrit": "मागधानां सुरुचिरं चैत्यकं तं समाद्रवन्।\nशिरसीव समाघ्नन्तो जरासन्धं जिघांस्वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2013593, "chapter_id": 1280, "verse_number": "२-२१-२४", "content_sanskrit": "स्थिरं सुविपुलं शृङ्गं सुमहत्तत्पुरातनम्।\nअर्चितं गन्धमाल्यैश्च सततं सुप्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2013594, "chapter_id": 1280, "verse_number": "२-२१-२५", "content_sanskrit": "विपुलैर्बाहुभिर्वीरस्तेऽभिहत्याभ्यपातयन्।\nततस्ते मागधं हृष्टाः पुरं प्रविविशुस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2013595, "chapter_id": 1280, "verse_number": "२-२१-२६", "content_sanskrit": "एतस्मिन्नेव काले तु ब्राह्मणा वेदपारगाः।\nदृष्ट्वा तु दुर्निमित्तानि जरासन्धमदर्शयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2013596, "chapter_id": 1280, "verse_number": "२-२१-२७", "content_sanskrit": "पर्युग्न्यकुर्वंश्च नृपं द्विरदस्थं पुरोहिताः।\nततस्तच्छान्तये राजा जरासन्धः प्रतापवान्।\nदीक्षितो नियमस्थोऽसावुपवासपरोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2013597, "chapter_id": 1280, "verse_number": "२-२१-२८", "content_sanskrit": "स्नातकव्रतिनस्ते तु बाहुशस्त्रा निरायुधाः।\nयुयुत्सवः प्रविविशुर्जरासन्धेन भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2013598, "chapter_id": 1280, "verse_number": "२-२१-२९", "content_sanskrit": "भक्ष्यमाल्यापणानां च ददृशुः श्रियमुत्तमाम्।\nस्फीतां सर्वगुणोपेतां सर्वकामसमृद्धिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2013599, "chapter_id": 1280, "verse_number": "२-२१-३०", "content_sanskrit": "तां तु दृष्ट्वा समृद्धिं ते वीथ्यां तस्यां नरोत्तमाः।\nराजमार्गेण गच्छन्तः कृष्णभीमधनञ्जयाः।\nबलाद्गृहीत्वा माल्यानि मालाकारान्महाबलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2013600, "chapter_id": 1280, "verse_number": "२-२१-३१", "content_sanskrit": "कर्पूरशृङ्गं कोष्ठं च सफलं चान्तरापणे।\nवैश्याद्बलाद्गृहीत्वा ते विहृत्य च महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2013601, "chapter_id": 1280, "verse_number": "२-२१-३२", "content_sanskrit": "विरागवसनाः सर्वे स्रग्विणो मृष्टकुण्डलाः।\nनिवेशनमथाजग्मुर्जरासन्धस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2013602, "chapter_id": 1280, "verse_number": "२-२१-३३", "content_sanskrit": "गोवासमिव वीक्षन्तः सिंहा हैमवता यथा।\nशालस्तम्भनिभास्तेषां चन्दनागुरुरूषिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2013603, "chapter_id": 1280, "verse_number": "२-२१-३४", "content_sanskrit": "अशोभन्त महाराज बाहवो युद्धशालिनाम्।\nतान्दृष्ट्वा द्विरदप्रख्याञ्शालस्कन्दानिवोद्गतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2013604, "chapter_id": 1280, "verse_number": "२-२१-३५", "content_sanskrit": "व्यूढोरस्कान्मागधानां विस्मयः समपद्यत।\nअद्वारेणाभ्यवस्कन्द्य विविशुर्मागधालयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2013605, "chapter_id": 1280, "verse_number": "२-२१-३६", "content_sanskrit": "ते त्वतीत्य जनाकीर्णाः कक्षास्तिस्रो नरर्षभाः।\nअहङ्कारेण राजानमुपतस्थुर्गतव्यथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2013606, "chapter_id": 1280, "verse_number": "२-२१-३७", "content_sanskrit": "भो शब्देनैव राजानमुचुस्ते तु महारथाः।\nतान्पाद्यमधुपर्कार्हान्गवार्हान्सत्कृतिं गतान्।\nप्रत्युत्थाय जरासन्ध उपतस्थे यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2013607, "chapter_id": 1280, "verse_number": "२-२१-३८", "content_sanskrit": "उवाच चैतान्राजाऽसौ स्वागतं वोस्त्विति प्रभुः।\nमौनमासीत्तदा पार्थभीमयोर्जनमेजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2013608, "chapter_id": 1280, "verse_number": "२-२१-३९", "content_sanskrit": "तेषां मध्ये महाबुद्धिः कृष्णो वचनमब्रवीत्।\nवक्तुं नायाति राजेन्द्र एतयोर्नियमस्थयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2013609, "chapter_id": 1280, "verse_number": "२-२१-४०", "content_sanskrit": "अर्वाङ्निशीथात्परतस्त्वाया सार्धं वदिष्यतः।\nयज्ञागारे स्थापयित्वा राजा राजगृहं वदिष्यतः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2013610, "chapter_id": 1280, "verse_number": "२-२१-४१", "content_sanskrit": "ततोऽर्धरात्रे सम्प्राप्ते यातो यत्र स्थिता द्विजाः।\nतस्य ह्येतद्व्रतं राजन्बभूव भुवि विश्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2013611, "chapter_id": 1280, "verse_number": "२-२१-४२", "content_sanskrit": "स्नातकान्ब्राह्मणान्प्राप्ताञ्श्रुत्वा स समितिञ्जयः।\nअप्यर्धरात्रे नृपतिः प्रत्युद्गच्छति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2013612, "chapter_id": 1280, "verse_number": "२-२१-४३", "content_sanskrit": "तांस्त्वपूर्वेण वेषेण दृष्ट्वा स नृपसत्तमः।\nउपतस्थे जरान्धो विस्मितश्चाभवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2013613, "chapter_id": 1280, "verse_number": "२-२१-४४", "content_sanskrit": "ते तु दृष्ट्वैव राजानं जरासन्धं नरर्षभाः।\nइदमूचुरमित्रघ्नाः सर्वे भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2013614, "chapter_id": 1280, "verse_number": "२-२१-४५", "content_sanskrit": "स्वस्त्यस्तु कुशलं राजन्निति तत्र व्यवस्थिताः।\nतं नृपं नृपशार्दूल प्रेक्षमाणाः परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2013615, "chapter_id": 1280, "verse_number": "२-२१-४६", "content_sanskrit": "तानब्रवीञ्जरासन्धस्तथा पाण्डवयादवान्।\nआस्यतामिति राजेन्द्र ब्राह्मणच्छद्मसंवृतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2013616, "chapter_id": 1280, "verse_number": "२-२१-४७", "content_sanskrit": "अथोपविविशुः सर्वे त्रयस्ते पुरुषर्षभाः।\nसम्प्रदीप्तास्त्रयो लक्ष्म्या महाध्वर इवाग्नयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2013617, "chapter_id": 1280, "verse_number": "२-२१-४८", "content_sanskrit": "तानुवाच जरासन्धः सत्यसन्धो नराधिपः।\nविगर्हमाणः कौरव्य वेषग्रहणवैकृतान्॥\nन स्नातकव्रता विप्रा वहिर्माल्यानुलेपनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2013618, "chapter_id": 1280, "verse_number": "२-२१-४९", "content_sanskrit": "भवन्तीति नृलोकेऽस्मिन्विदितं मम सर्वशः।\nके यूयं पुष्पवन्तश्च भुजैर्ज्याकृतलक्षणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2013619, "chapter_id": 1280, "verse_number": "२-२१-५०", "content_sanskrit": "बिभ्रतः क्षात्रमोजश्च ब्राह्मण्यं प्रतिजानथ।\nएवं विरागवसना बहिर्माल्यानुलेपनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2013620, "chapter_id": 1280, "verse_number": "२-२१-५१", "content_sanskrit": "क्षत्रिया एव लोकेऽस्मिन्विदिता मम सर्वशः॥\nसत्यं वदत के यूयं सत्यं राजसु शोभते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2013621, "chapter_id": 1280, "verse_number": "२-२१-५२", "content_sanskrit": "चैत्यकस्य गिरेः शृङ्गं भित्त्वा किमिह सद्मनि।\nअद्वारेण प्रविष्टाः स्थ निर्भया राजकिल्विषात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2013622, "chapter_id": 1280, "verse_number": "२-२१-५३", "content_sanskrit": "वदध्वं वाचि वीर्यं च ब्राह्मणस्य विशेषतः।\nकर्म चैतद्विलिङ्गस्थं किं वोऽद्य प्रसमीक्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2013623, "chapter_id": 1280, "verse_number": "२-२१-५४", "content_sanskrit": "एवं च मामुपास्थाय कस्माच्च विधिर्नाहणाम्।\nप्रणीतां नानुगृह्णीत कार्यं किं वाऽस्मदागमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2013624, "chapter_id": 1280, "verse_number": "२-२१-५५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2013625, "chapter_id": 1280, "verse_number": "२-२१-५५", "content_sanskrit": "एवमुक्ते ततः कृष्णः प्रत्युवाच महामनाः।\nस्निग्धगमभीरया वाचा वाक्यं वाक्यविशारदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2013626, "chapter_id": 1280, "verse_number": "२-२१-५६x", "content_sanskrit": "कृष्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2013627, "chapter_id": 1280, "verse_number": "२-२१-५६", "content_sanskrit": "स्नातकान्ब्राह्मणान्राजन्विद्ध्यस्मांस्त्वं नराधिप।\nस्नातकव्रतिनो राजन्ब्राह्मणाः क्षत्रिया विशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2013628, "chapter_id": 1280, "verse_number": "२-२१-५७", "content_sanskrit": "विशेषनियमाश्चैषामविशेषाश्च सन्त्युत।\nविशेषवांश्च सततं क्षत्रियः श्रियमृच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2013629, "chapter_id": 1280, "verse_number": "२-२१-५८", "content_sanskrit": "पुष्पवत्सु ध्रुवा श्रीश्च पुष्पवन्तस्ततो वयम्।\nक्षत्रियो बाहुवीर्यस्तु न तथा वाक्यवीर्यवान्॥\nअम्प्रगल्भं वचस्तस्य तस्माद्बार्हद्रथेरितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2013630, "chapter_id": 1280, "verse_number": "२-२१-५९", "content_sanskrit": "स्ववीर्यं क्षत्रियाणां तु बाह्वोर्धाता न्यवेशयत्।\nतद्दिदृक्षसि चेद्राजन्द्रष्टास्यद्य न संशयटः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2013631, "chapter_id": 1280, "verse_number": "२-२१-६०", "content_sanskrit": "अद्वारेण रिम्पोर्गेहं द्वारेण सुहृदो गृहान्।\nप्रविशन्ति नरा धीरा द्वाराण्येतानि धर्मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2013632, "chapter_id": 1280, "verse_number": "२-२१-६१", "content_sanskrit": "कार्यवन्तो गृहानेत्य शत्रुतो नार्हणां वयम्।\nप्रतिगृह्णीम् तद्विद्वि एतन्नः शाश्वतं व्रतम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2013633, "chapter_id": 1280, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि जरासन्धवधपर्वणि एकविंशोऽध्यायः॥ २१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]