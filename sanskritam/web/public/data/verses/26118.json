[{"id": 7006118000, "chapter_id": 26118, "verse_number": "३-१३-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nइति स्तुतः स भगवान् स्वपूत्रेण दयानिधिः ।\nमेधगंभीरया वाचा प्रोवाच मधुसूदनः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006118001, "chapter_id": 26118, "verse_number": "३-१३-२", "content_sanskrit": "सृज ब्रह्मन्निमान्देवान्मत्प्रसादात्क्रमेण च ।\nयथा वै प्राक्क्षणेतद्वत्सृज सर्वं महाप्रभो ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006118002, "chapter_id": 26118, "verse_number": "३-१३-३", "content_sanskrit": "नास्ति प्रयोजनं तेन तव मत्प्रीतये सृज ।\nएवमुक्तस्तु हारिणा ब्रह्मा स्तुत्वा हरिं परम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006118003, "chapter_id": 26118, "verse_number": "३-१३-४", "content_sanskrit": "सृष्टिं कर्तुं मनो दध्रे प्रीणयन्नेव माधवम् ।\nमहत्तत्वात्मको ब्रह्मा वायुं जीवभिमानिनम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006118004, "chapter_id": 26118, "verse_number": "३-१३-५", "content_sanskrit": "आदौ ससर्ज गरुड पुरुषात्मा स एव च ।\nततो दक्षिणहस्तात्तु ब्रह्माणीं भारन्ती तथा ॥६।\n(१३.५)असृजत्ते महाभागे अव्यक्तस्य नियामिके ।\nवामहस्तात्सत्यपुत्रो महत्तत्वात्मकोऽनलः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006118005, "chapter_id": 26118, "verse_number": "३-१३-६", "content_sanskrit": "ब्रह्मणो दक्षिणाद्धस्तादहङ्कारात्मको हरः ।\nआदौ शेषस्ततो जज्ञे गरुडतदनन्तरम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006118006, "chapter_id": 26118, "verse_number": "३-१३-७", "content_sanskrit": "तदनन्तरजो रुद्रः स एवं सृष्टवान्प्रभुः ।\nस्वोत्पत्त्यनन्तरं ब्रह्मा दशवर्षान्महाप्रभुः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006118007, "chapter_id": 26118, "verse_number": "३-१३-८", "content_sanskrit": "वायुमुत्त्पाद्रयामास वत्सरानन्तरे प्रभुः ।\nगायत्रीं जनयामास वायोरुत्पत्त्यनन्तरम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006118008, "chapter_id": 26118, "verse_number": "३-१३-९", "content_sanskrit": "संवत्सरानन्तरे तु भारतीमसृजत्प्रभुः ।\nभारत्यनन्तरं शें दिव्यसाहस्रवत्सरात् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006118009, "chapter_id": 26118, "verse_number": "३-१३-१०", "content_sanskrit": "अनन्तरं संबभूव गरुडस्तु ततः परम् ।\nदिव्यसाहस्रवर्षात्तु तथा रुद्रञ्च सृष्टवान् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006118010, "chapter_id": 26118, "verse_number": "३-१३-११", "content_sanskrit": "शेषस्यानन्तरं देवीं वारुणीं च महाप्रभुः ।\nदशवर्षानन्तरं तु ह्यसृजत्कमलासनः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006118011, "chapter_id": 26118, "verse_number": "३-१३-१२", "content_sanskrit": "गरुडानन्तरं देवीं सौपर्णीमसृजत्प्रभुः ।\nदशवर्षानन्तरं च पार्वतीं च तथैव सः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006118012, "chapter_id": 26118, "verse_number": "३-१३-१३", "content_sanskrit": "पार्वत्यनन्तरं चन्द्रं मनस्तत्त्वनियामकम् ।\nदशवर्षानन्तरं तु वासवं ह्यसृजत्ततः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006118013, "chapter_id": 26118, "verse_number": "३-१३-१४", "content_sanskrit": "अभिमानी दक्षिणस्य बाहोश्च परमेष्ठिनः ।\nदशवर्षानन्तरं तु शची तामसृजत्प्रभुः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006118014, "chapter_id": 26118, "verse_number": "३-१३-१५", "content_sanskrit": "इन्द्रस्यानन्तरं कामं त्रिंशद्वर्षादनन्तरम् ।\nअसृजद्वामबाहोश्चमनस्तत्वाभिमानिनम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006118015, "chapter_id": 26118, "verse_number": "३-१३-१६", "content_sanskrit": "तदनन्तरजां देवीं दशवर्षादनन्तरम् ।\nरतिं स जनयामास कामभार्यां महाप्रभुः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006118016, "chapter_id": 26118, "verse_number": "३-१३-१७", "content_sanskrit": "कामस्याप्यभिमानी तु स एव परिकीर्तितः ।\nब्रह्माहङ्कारिकं प्राणं कार्योत्पत्तेरनन्तरम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006118017, "chapter_id": 26118, "verse_number": "३-१३-१८", "content_sanskrit": "दशवर्षानन्तरं तु निर्ममे नासिक ततः ।\nतस्य भार्यां नासिकस्यः पञ्चवर्षादनन्तरम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006118018, "chapter_id": 26118, "verse_number": "३-१३-१९", "content_sanskrit": "निर्ममे नासिकां वामां ब्रह्मा लोकपितामहः ।\nअहङ्कारादनु ब्रह्मा सज्ञानं च बृहस्पतिम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006118019, "chapter_id": 26118, "verse_number": "३-१३-२०", "content_sanskrit": "निर्ममे च वर्षयुग्मपञ्चवर्षादनन्तरम् ।\nपञ्चवर्षानन्तरं तु तारां भार्यां विनिर्ममे ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006118020, "chapter_id": 26118, "verse_number": "३-१३-२१", "content_sanskrit": "गुरोरनन्तरं ब्रह्मा पञ्चविंशादनन्तरम् ।\nस्वायंभुवं मनुं चैव निर्ममे मनसा विभुः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006118021, "chapter_id": 26118, "verse_number": "३-१३-२२", "content_sanskrit": "पञ्चवर्षानन्तरं तु शतरूपां विनिर्ममे ।\nशतरूपानन्तरं तु विंशद्वर्षदिनान्तरम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006118022, "chapter_id": 26118, "verse_number": "३-१३-२३", "content_sanskrit": "दक्षः शिष्यात्मको जज्ञे दक्षिणाङ्गुष्ठतः प्रभोः ।\nपञ्चवर्षानन्तरं तु वामाङ्गुष्ठाच्चतुर्मुखः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006118023, "chapter_id": 26118, "verse_number": "३-१३-२४", "content_sanskrit": "प्रसूतिमसृजद्ब्रह्मा सृष्ट्यर्थं परमादरात् ।\nदक्षस्यानन्तरं ब्रह्मा पञ्चविंशादनन्तरम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006118024, "chapter_id": 26118, "verse_number": "३-१३-२५", "content_sanskrit": "निर्ममे ह्यनिरुद्धं च मध्यमाङ्गुलिपर्वतः ।\nपञ्चवर्षानन्तरं तु ससर्ज भगवानजः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006118025, "chapter_id": 26118, "verse_number": "३-१३-२६", "content_sanskrit": "विराजसंज्ञकां भार्यां मध्यमाङ्गुलिपर्वतः ।\nअनिरुद्धानन्तर तु शतवर्षादनन्तरम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006118026, "chapter_id": 26118, "verse_number": "३-१३-२७", "content_sanskrit": "निर्ममे प्रवहं वायुं कनिष्ठाङ्गुलिपर्वतः ।\nदशवर्षानन्तरं तु प्रवाहीं निर्ममे प्रभुः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006118027, "chapter_id": 26118, "verse_number": "३-१३-२८", "content_sanskrit": "कनिष्ठाङ्गुलिपर्वाच्च वामदेवं न संशयः ।\nप्रवहानन्तरं तब्रह्मा शतवर्षादनन्तरम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006118028, "chapter_id": 26118, "verse_number": "३-१३-२९", "content_sanskrit": "यमं विनिर्ममे पृष्ठादष्टवर्षादनन्तरम् ।\nतद्भार्यां शामलां देवीं तस्मादेव महाप्रभुः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006118029, "chapter_id": 26118, "verse_number": "३-१३-३०", "content_sanskrit": "यमस्यानन्तरं चन्द्रं त्रिंशद्वर्षादनन्तरम् ।\nअसृजद्दक्षिणाच्छोत्राच्छोत्रतत्त्वनियामकम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006118030, "chapter_id": 26118, "verse_number": "३-१३-३१", "content_sanskrit": "नववर्षानन्तरं तु रोहिणीसमृजत्प्रभुः ।\nवामश्रोत्राच्च गरुडं वामश्रोत्राभिमानिनम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006118031, "chapter_id": 26118, "verse_number": "३-१३-३२", "content_sanskrit": "चन्द्रस्यानन्तरं सूर्यं विंशद्वर्षादनन्तरम् ।\nसम्यग्विनिर्ममे ब्रह्मा दक्षिणाक्ष्णश्च देवताम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006118032, "chapter_id": 26118, "verse_number": "३-१३-३३", "content_sanskrit": "वामाक्ष्णो निर्ममे संज्ञां षड्वर्षानन्तरं प्रभुः ।\nसूर्यस्यानन्तरं ब्रह्मा शतवर्षादनन्तरम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006118033, "chapter_id": 26118, "verse_number": "३-१३-३४", "content_sanskrit": "रसनेन्द्रियाच्च वरुणं निर्ममे तस्य मानिनम् ।\nविंशद्वर्षानन्तरं तु तस्मादेवेद्रियात्प्रभुः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006118034, "chapter_id": 26118, "verse_number": "३-१३-३५", "content_sanskrit": "गङ्गां विनिर्ममे ब्रह्मा रसनेन्द्रियदेवताम् ।\nवरुणस्यानन्तरं तु दशवर्षादनन्तरम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006118035, "chapter_id": 26118, "verse_number": "३-१३-३६", "content_sanskrit": "उत्संगान्निर्ममे ब्रह्मा नारदं भगवत्प्रियम् ।\nनारदस्यानन्तरं तु षष्टिवर्षादनन्तरम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006118036, "chapter_id": 26118, "verse_number": "३-१३-३७", "content_sanskrit": "अग्निं विनिर्ममे ब्रह्मात्वगिन्द्रियतः प्रभुः ।\nअतो वागभिमानी सं पञ्चवर्षादनन्तरम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006118037, "chapter_id": 26118, "verse_number": "३-१३-३८", "content_sanskrit": "स्वाहां विनिर्ममे ब्रह्मा तामाहुर्मन्त्रदेवताम् ।\nअग्नेरनन्तरं वीन्द्र भृगुं ब्रह्मर्षिसत्तमम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006118038, "chapter_id": 26118, "verse_number": "३-१३-३९", "content_sanskrit": "दशवर्षानन्तरं तु भ्रुवोर्मध्याद्विनिर्ममे ।\nसंवत्सरानन्तरं तु भृगुभार्यां विनिर्ममे ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006118039, "chapter_id": 26118, "verse_number": "३-१३-४०", "content_sanskrit": "भृगोरनन्तरं ब्रह्मा शतवर्षादनन्तरम् ।\nकश्यपञ्जनयामास मनसा च स्वयं प्रभुः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006118040, "chapter_id": 26118, "verse_number": "३-१३-४१", "content_sanskrit": "संवत्सरानन्तरं तु अदितिं निर्ममे प्रभुः ।\nकश्यपानन्तरं चात्रिं दशवर्षादनन्तरम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006118041, "chapter_id": 26118, "verse_number": "३-१३-४२", "content_sanskrit": "अत्रेरनन्तरं ब्रह्मा दशवर्षादनन्तरम् ।\nअजीजनद्भरद्वाजं वसिष्ठ तदनतरम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006118042, "chapter_id": 26118, "verse_number": "३-१३-४३", "content_sanskrit": "दशवर्षानन्तरं तु तेषां भार्याः क्रमेण तु ।\nसंवत्सरानन्तरेण असृजत्कमलासनः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006118043, "chapter_id": 26118, "verse_number": "३-१३-४४", "content_sanskrit": "वसिष्ठस्यानन्तरं तु गौतमं ह्यसृजत्प्रभुः ।\nदशवर्षानन्तरेण जमदग्निं ततोऽसृजत् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006118044, "chapter_id": 26118, "verse_number": "३-१३-४५", "content_sanskrit": "दशवर्षानन्तरेण मनुर्वैवस्वतोऽभवत् ।\nमनोरनन्तरं जज्ञे शतवर्षादनन्तरम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006118045, "chapter_id": 26118, "verse_number": "३-१३-४६", "content_sanskrit": "विष्वक्सेनो महाभागो वायुपुत्रो महाबलः ।\nतस्माच्चतुर्दशे वर्षे गणपो ह्यभवद्विभोः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006118046, "chapter_id": 26118, "verse_number": "३-१३-४७", "content_sanskrit": "तदनन्तरजो वीन्द्र अष्टवर्षादनन्तरम् ।\nधनपो ह्यभवत्तत्र तद्भार्या वत्सरे परे ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006118047, "chapter_id": 26118, "verse_number": "३-१३-४८", "content_sanskrit": "विष्वक्सेनानन्तरं तु दशवर्षादनन्तरम् ।\nजयादीन्भ गवद्भक्तान्सृष्टवान् कमलासनः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006118048, "chapter_id": 26118, "verse_number": "३-१३-४९", "content_sanskrit": "जयाद्यानन्तरं ब्रह्मा वल्लाद्याः कर्मदेवताः ।\nशतवर्षानन्तरं तु सृष्टवाञ्छिववाहनम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006118049, "chapter_id": 26118, "verse_number": "३-१३-५०", "content_sanskrit": "कर्मदेवानन्तरं तु त्रिंशद्वर्षादनन्तरम् ।\nपर्जन्यमसृज्ब्रह्मा मन्त्रयन्त्राभिमानिनम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006118050, "chapter_id": 26118, "verse_number": "३-१३-५१", "content_sanskrit": "पर्जन्यानन्तरं ब्रह्मा दशवर्षादनन्तरम् ।\nपुष्करं जनयामास कर्मतत्त्वाभिमानिनम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006118051, "chapter_id": 26118, "verse_number": "३-१३-५२", "content_sanskrit": "एवं विनिर्ममे ब्रह्मा मत्प्रसादात्खगेश्वर ।\nएवं ज्ञात्वा मोक्षमेति नान्यथा तु कथञ्चन ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]