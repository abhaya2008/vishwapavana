[{"id": 7001327000, "chapter_id": 21327, "verse_number": "४-१७-१", "content_sanskrit": "ऋषय ऊचुः ।\nमहाकालसमाह्वस्थज्योतिर्लिंगस्य रक्षिणः ।\nभक्तानां महिमानं च पुनर्ब्रूहि महामते॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001327001, "chapter_id": 21327, "verse_number": "४-१७-२", "content_sanskrit": "सूत उवाच ।\nशृणुतादरतो विप्रो भक्तरक्षाविधायिनः ।\nमहाकालस्य लिंगस्य माहात्म्यं भक्तिवर्द्धनम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001327002, "chapter_id": 21327, "verse_number": "४-१७-३", "content_sanskrit": "उज्जयिन्यामभूद्राजा चन्द्रसेनाह्वयो महान् ।\nसर्वशास्त्रार्थतत्त्वज्ञश्शिवभक्तो जितेन्द्रियः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001327003, "chapter_id": 21327, "verse_number": "४-१७-४", "content_sanskrit": "तस्याभवत्सखा राज्ञो मणिभद्रो गणो द्विजाः ।\nगिरीशगणमुख्यश्च सर्वलोकनमस्कृतः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001327004, "chapter_id": 21327, "verse_number": "४-१७-५", "content_sanskrit": "एकदा स गणेन्द्रो हि प्रसन्नास्यो महामणिम् ।\nमणिभद्रो ददौ तस्मै चिंतामणिमुदारधीः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001327005, "chapter_id": 21327, "verse_number": "४-१७-६", "content_sanskrit": "स वै मणिः कौस्तुभवद्द्योतमानोर्कसन्निभः ।\nध्यातो दृष्टः श्रुतो वापि मंगलं यच्छति ध्रुवम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001327006, "chapter_id": 21327, "verse_number": "४-१७-७", "content_sanskrit": "तस्य कांतितलस्पृष्टं कांस्यं ताम्रमयं त्रपु ।\nपाषाणादिकमन्यद्वा द्रुतं भवति हाटकम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001327007, "chapter_id": 21327, "verse_number": "४-१७-८", "content_sanskrit": "स तु चिन्तामणिं कंठे बिभ्रद्राजा शिवाश्रयः ।\nचन्द्रसेनो रराजाति देवमध्येव भानुमान्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001327008, "chapter_id": 21327, "verse_number": "४-१७-९", "content_sanskrit": "श्रुत्वा चिन्तामणिग्रीवं चन्द्रसेनं नृपोत्तमम् ।\nनिखिलाः क्षितिराजानस्तृष्णाक्षुब्धहृदोऽभवन्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001327009, "chapter_id": 21327, "verse_number": "४-१७-१०", "content_sanskrit": "नृपा मत्सरिणस्सर्वे तं मणिं चन्द्रसेनतः ।\nनानोपायैरयाचंत देवलब्धमबुद्धयः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001327010, "chapter_id": 21327, "verse_number": "४-१७-११", "content_sanskrit": "सर्वेषां भूभृतां याञ्चा चन्द्रसेनेन तेन वै ।\nव्यर्थीकृता महाकालदृढभक्तेन भूसुराः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001327011, "chapter_id": 21327, "verse_number": "४-१७-१२", "content_sanskrit": "ते कदर्थीकृतास्सर्वे चन्द्रसेनेन भूभृता ।\nराजानस्सर्वदेशानां संरम्भं चक्रिरे तदा॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001327012, "chapter_id": 21327, "verse_number": "४-१७-१३", "content_sanskrit": "अथ ते सर्वराजानश्चतुरंगबलान्विताः ।\nचन्द्रसेनं रणे जेतुं संबभूवुः किलोद्यताः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001327013, "chapter_id": 21327, "verse_number": "४-१७-१४", "content_sanskrit": "ते तु सर्वे समेता वै कृतसंकेतसंविदः ।\nउज्जयिन्याश्चतुर्द्वारं रुरुधुर्बहुसैनिकाः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001327014, "chapter_id": 21327, "verse_number": "४-१७-१५", "content_sanskrit": "संरुध्यमानां स्वपुरीं दृष्ट्वा निखिल राजभिः ।\nतमेव शरणं राजा महाकालेश्वरं ययौ॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001327015, "chapter_id": 21327, "verse_number": "४-१७-१६", "content_sanskrit": "निर्विकल्पो निराहारस्स नृपो दृढनिश्चयः ।\nसमानर्च महाकालं दिवा नक्तमनन्यधीः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001327016, "chapter_id": 21327, "verse_number": "४-१७-१७", "content_sanskrit": "ततस्स भगवाञ्छंभुर्महाकालः प्रसन्नधीः ।\nतं रक्षितुमुपायं वै चक्रे तं शृणुतादरात्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001327017, "chapter_id": 21327, "verse_number": "४-१७-१८", "content_sanskrit": "तदैव समये गोपि काचित्तत्र पुरोत्तमे ।\nचरंती सशिशुर्विप्रा महाकालांतिकं ययौ॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001327018, "chapter_id": 21327, "verse_number": "४-१७-१९", "content_sanskrit": "पञ्चाब्दवयसं बालं वहन्ती गतभर्तृका ।\nराज्ञा कृतां महाकालपूजां सापश्यदादरात्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001327019, "chapter_id": 21327, "verse_number": "४-१७-२०", "content_sanskrit": "सा दृष्ट्वा सुमहाश्चर्यां शिवपूजां च तत्कृताम् ।\nप्रणिपत्य स्वशिविरं पुनरेवाभ्यपद्यत॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001327020, "chapter_id": 21327, "verse_number": "४-१७-२१", "content_sanskrit": "तत्सर्वमशेषेण स दृष्ट्वा बल्लवीसुतः ।\nकुतूहलेन तां कर्त्तुं शिवपूजां मनोदधे॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001327021, "chapter_id": 21327, "verse_number": "४-१७-२२", "content_sanskrit": "आनीय हृद्यं पाषाणं शून्ये तु शिविरांतरे ।\nअविदूरे स्वशिबिराच्छिवलिगं स भक्तितः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001327022, "chapter_id": 21327, "verse_number": "४-१७-२३", "content_sanskrit": "गन्धालंकारवासोभिर्धूपदीपाक्षतादिभिः ।\nविधाय कृत्रिमैर्द्रव्यैर्नैवेद्यं चाप्यकल्पयत्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001327023, "chapter_id": 21327, "verse_number": "४-१७-२४", "content_sanskrit": "भूयोभूयस्समभ्यर्च्य पत्रैः पुष्पैर्मनोरमैः ।\nनृत्यं च विविधं कृत्वा प्रणनाम पुनःपुनः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001327024, "chapter_id": 21327, "verse_number": "४-१७-२५", "content_sanskrit": "एतस्मिन्समये पुत्रं शिवासक्तसुचेतसम् ।\nप्रणयाद्गोपिका सा तं भोजनाय समाह्वयत्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001327025, "chapter_id": 21327, "verse_number": "४-१७-२६", "content_sanskrit": "यदाहूतोऽपि बहुशश्शिवपूजाक्तमानसः ।\nबालश्च भोजनं नैच्छत्तदा तत्र ययौ प्रसूः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001327026, "chapter_id": 21327, "verse_number": "४-१७-२७", "content_sanskrit": "तं विलोक्य शिवस्याग्रे निषण्णं मीलितेक्षणम् ।\nचकर्ष पाणिं संगृह्य कोपेन समताडयत्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001327027, "chapter_id": 21327, "verse_number": "४-१७-२८", "content_sanskrit": "आकृष्टस्ताडितश्चापि नागच्छत्स्वसुतो यदा ।\nतां पूजां नाशयामास क्षिप्त्वा लिंगं च दूरतः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001327028, "chapter_id": 21327, "verse_number": "४-१७-२९", "content_sanskrit": "हाहेति दूयमानं तं निर्भर्त्स्य स्वसुतं च सा ।\nपुनर्विवेश स्वगृहं गोपी क्रोधसमन्विता॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001327029, "chapter_id": 21327, "verse_number": "४-१७-३०", "content_sanskrit": "मात्रा विनाशितां पूजां दृष्ट्वा देवस्य शूलिनः ।\nदेवदेवेति चुक्रोश निपपात स बालकः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001327030, "chapter_id": 21327, "verse_number": "४-१७-३१", "content_sanskrit": "प्रनष्टसंज्ञः सहसा स बभूव शुचाकुलः ।\nलब्धसंज्ञो मुहूर्तेन चक्षुषी उदमीलयत्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001327031, "chapter_id": 21327, "verse_number": "४-१७-३२", "content_sanskrit": "तदैव जातं शिबिरं महाकालस्य सुन्दरम् ।\nददर्श स शिशुस्तत्र शिवानुग्रहतोऽचिरात्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001327032, "chapter_id": 21327, "verse_number": "४-१७-३३", "content_sanskrit": "हिरण्मयबृहद्द्वारं कपाटवरतोरणम् ।\nमहार्हनीलविमलवज्रवेदीविराजितम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001327033, "chapter_id": 21327, "verse_number": "४-१७-३४", "content_sanskrit": "संतप्तहेमकलशैर्विचित्रैर्बहुभिर्युतम् ।\nप्रोद्भासितमणिस्तंभैर्बद्धस्फटिकभूतलैः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001327034, "chapter_id": 21327, "verse_number": "४-१७-३५", "content_sanskrit": "तन्मध्ये रत्नलिंगं हि शंकरस्य कृपानिधे ।\nस्वकृतार्चनसंयुक्तमपश्यद्गोपिकासुतः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001327035, "chapter_id": 21327, "verse_number": "४-१७-३६", "content_sanskrit": "स दृष्ट्वा सहसोत्थाय शिशुर्विस्मितमानसः ।\nसंनिमग्न इवासीद्वै परमानंदसागरे॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001327036, "chapter_id": 21327, "verse_number": "४-१७-३७", "content_sanskrit": "ततः स्तुत्वा स गिरिशं भूयोभूयः प्रणम्य च ।\nसूर्ये चास्तं गते बालो निर्जगाम शिवालयात्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001327037, "chapter_id": 21327, "verse_number": "४-१७-३८", "content_sanskrit": "अथापश्यत्स्वशिबिरं पुरंदरपुरोपमम् ।\nसद्यो हिरण्मयीभूतं विचित्रं परमोज्ज्वलम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001327038, "chapter_id": 21327, "verse_number": "४-१७-३९", "content_sanskrit": "सोन्तर्विवेश भवनं सर्वशोभासमन्वितम् ।\nमणिहेमगणाकीर्ण मोदमानो निशामुखे॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001327039, "chapter_id": 21327, "verse_number": "४-१७-४०", "content_sanskrit": "तत्रापश्यत्स्वजननीं स्वपंतीं दिव्यलक्षणाम् ।\nरत्नालंकारदीप्तांगीं साक्षात्सुरवधूमिव॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001327040, "chapter_id": 21327, "verse_number": "४-१७-४१", "content_sanskrit": "अथो स तनयो विप्राश्शिवानुग्रहभाजनम् ।\nजवेनोत्थापयामास मातरं सुखविह्वलः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001327041, "chapter_id": 21327, "verse_number": "४-१७-४२", "content_sanskrit": "सोत्थिताद्भुतमालक्ष्यापूर्वं सर्वमिवाभवत् ।\nमहानंदसुमग्ना हि सस्वजे स्वसुतं च तम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001327042, "chapter_id": 21327, "verse_number": "४-१७-४३", "content_sanskrit": "श्रुत्वा पुत्रमुखात्सर्वं प्रसादं गिरिजापतेः ।\nप्रभुं विज्ञापयामास यो भजत्यनिशं शिवम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001327043, "chapter_id": 21327, "verse_number": "४-१७-४४", "content_sanskrit": "स राजा सहसागत्य समाप्तनियमो निशि ।\nददर्श गोपिकासूनोः प्रभावं शिवतोषणम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001327044, "chapter_id": 21327, "verse_number": "४-१७-४५", "content_sanskrit": "दृष्ट्वा महीपतिस्सर्वं तत्सामात्यपुरोहितः ।\nआसीन्निमग्नो विधृतिः परमानंदसागरे॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001327045, "chapter_id": 21327, "verse_number": "४-१७-४६", "content_sanskrit": "प्रेम्णा वाष्पजलं मुञ्चञ्चन्द्रसेनो नृपो हि सः ।\nशिवनामोच्चरन्प्रीत्या परिरेभे तमर्भकम्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001327046, "chapter_id": 21327, "verse_number": "४-१७-४७", "content_sanskrit": "महामहोत्सवस्तत्र प्रबभूवाद्भुतो द्विजाः ।\nमहेशकीर्तनं चक्रुस्सर्वे च सुखविह्वलाः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001327047, "chapter_id": 21327, "verse_number": "४-१७-४८", "content_sanskrit": "एवमत्यद्भुताचाराच्छिवमाहात्म्यदर्शनात् ।\nपौराणां सम्भ्रमाच्चैव सा रात्रिः क्षणतामगात्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001327048, "chapter_id": 21327, "verse_number": "४-१७-४९", "content_sanskrit": "अथ प्रभाते युद्धाय पुरं संरुध्य संस्थिताः ।\nराजानश्चारवक्त्रेभ्यश्शुश्रुवुश्चरितं च तत्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001327049, "chapter_id": 21327, "verse_number": "४-१७-५०", "content_sanskrit": "ते समेताश्च राजानः सर्वे येये समागताः ।\nपरस्परमिति प्रोचुस्तच्छ्रुत्वा चकित अति॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001327050, "chapter_id": 21327, "verse_number": "४-१७-५१", "content_sanskrit": "राजान ऊचुः ।\nअयं राजा चन्द्रसेनश्शिवभक्तोति दुर्जयः ।\nउज्जयिन्या महाकालपुर्याः पतिरनाकुलः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001327051, "chapter_id": 21327, "verse_number": "४-१७-५२", "content_sanskrit": "ईदृशाश्शिशवो यस्य पुर्य्यां संति शिवव्रताः ।\nस राजा चन्द्रसेनस्तु महाशंकरसेवकः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001327052, "chapter_id": 21327, "verse_number": "४-१७-५३", "content_sanskrit": "नूनमस्य विरोधेन शिवः क्रोधं करिष्यति ।\nतत्क्रोधाद्धि वयं सर्वे भविष्यामो विनष्टकाः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001327053, "chapter_id": 21327, "verse_number": "४-१७-५४", "content_sanskrit": "तस्मादनेन राज्ञा वै मिलापः कार्य एव हि ।\nएवं सति महेशानः करिष्यति कृपां पराम्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001327054, "chapter_id": 21327, "verse_number": "४-१७-५५", "content_sanskrit": "सूत उवाच ।\nइति निश्चित्य ते भूपास्त्यक्तवैरास्सदाशयाः ।\nसर्वे बभूवुस्सुप्रीता न्यस्तशस्त्रास्त्रपाणयः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001327055, "chapter_id": 21327, "verse_number": "४-१७-५६", "content_sanskrit": "विविशुस्ते पुरीं रम्यां महाकालस्य भूभृतः ।\nमहाकालं समानर्चुश्चंद्रसेनानुमोदिताः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001327056, "chapter_id": 21327, "verse_number": "४-१७-५७", "content_sanskrit": "ततस्ते गोपवनिता गेहं जग्मुर्महीभृतः ।\nप्रसंशंतश्च तद्भाग्यं सर्वे दिव्यमहोदयम्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001327057, "chapter_id": 21327, "verse_number": "४-१७-५८", "content_sanskrit": "ते तत्र चन्द्रसेनेन प्रत्युद्गम्याभिपूजिताः ।\nमहार्हविष्टरगताः प्रत्यनंदन्सुविस्मिताः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001327058, "chapter_id": 21327, "verse_number": "४-१७-५९", "content_sanskrit": "गोपसूनोः प्रसादात्तत्प्रादुर्भूतं शिवालयम् ।\nसंवीक्ष्य शिवलिंगं च शिवे चकुः परां मतिम्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001327059, "chapter_id": 21327, "verse_number": "४-१७-६०", "content_sanskrit": "ततस्ते गोपशिशवे प्रीता निखिलभूभुजः ।\nददुर्बहूनि वस्तूनि तस्मै शिवकृपार्थिनः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001327060, "chapter_id": 21327, "verse_number": "४-१७-६१", "content_sanskrit": "येये सर्वेषु देशेषु गोपास्तिष्ठंति भूरिशः ।\nतेषां तमेव राजानं चक्रिरे सर्वपार्थिवाः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001327061, "chapter_id": 21327, "verse_number": "४-१७-६२", "content_sanskrit": "अथास्मिन्नन्तरे सर्वैस्त्रिदशैरभिपूजितः ।\nप्रादुर्बभूव तेजस्वी हनूमान्वानरेश्वरः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001327062, "chapter_id": 21327, "verse_number": "४-१७-६३", "content_sanskrit": "ते तस्याभिगमादेव राजानो जातसंभ्रमाः ।\nप्रत्युत्थाय नमश्चकुर्भक्तिनम्रात्ममूर्तयः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001327063, "chapter_id": 21327, "verse_number": "४-१७-६४", "content_sanskrit": "तेषां मध्ये समासीनः पूजितः प्लवगेश्वरः ।\nगोपात्मजं तमालिंग्य राज्ञो वीक्ष्येदमब्रवीत्॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001327064, "chapter_id": 21327, "verse_number": "४-१७-६५", "content_sanskrit": "हनूमानुवाच ।\nसर्वे शृण्वन्तु भद्रं वो राजानो ये च देहिनः ।\nऋते शिवं नान्यतमो गतिरस्ति शरीरिणाम्॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001327065, "chapter_id": 21327, "verse_number": "४-१७-६६", "content_sanskrit": "एवं गोपसुतो दिष्ट्या शिवपूजां विलोक्य च ।\nअमंत्रेणापि संपूज्य शिवं शिवमवाप्तवान्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001327066, "chapter_id": 21327, "verse_number": "४-१७-६७", "content_sanskrit": "एष भक्तवरश्शंभोर्गोपानां कीर्तिवर्द्धनः ।\nइह भुक्त्वाखिलान्भोगानंते मोक्षमवाप्स्यति॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001327067, "chapter_id": 21327, "verse_number": "४-१७-६८", "content_sanskrit": "अस्य वंशेऽष्टमो भावी नन्दो नाम महायशाः ।\nप्राप्स्यते तस्य पुत्रत्वं कृष्णो नारायणस्स्वयम्॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001327068, "chapter_id": 21327, "verse_number": "४-१७-६९", "content_sanskrit": "अद्यप्रभृति लोकेस्मिन्नेष गोप कुमारकः ।\nनाम्ना श्रीकर इत्युच्चैर्लोकख्यातिं गमिष्यति॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001327069, "chapter_id": 21327, "verse_number": "४-१७-७०", "content_sanskrit": "सूत उवाच ।\nएवमुक्त्वाञ्जनीसूनुः शिवरूपो हरीश्वरः ।\nसर्वान्राज्ञश्चन्द्रसेनं कृपादृष्ट्या ददर्श ह॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001327070, "chapter_id": 21327, "verse_number": "४-१७-७१", "content_sanskrit": "अथ तस्मै श्रीकराय गोपपुत्राय धीमते ।\nउपादिदेश सुप्रीत्या शिवाचारं शिवप्रियम्॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001327071, "chapter_id": 21327, "verse_number": "४-१७-७२", "content_sanskrit": "हनूमानथ सुप्रीतः सर्वेषां पश्यतां द्विजः ।\nचन्द्रसेनं श्रीकरं च तत्रैवान्तरधी यत॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001327072, "chapter_id": 21327, "verse_number": "४-१७-७३", "content_sanskrit": "तं सर्वे च महीपालास्संहृष्टाः प्रतिपूजिताः ।\nचन्द्रसेनं समामंत्र्य प्रतिजग्मुर्यथागतम्॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001327073, "chapter_id": 21327, "verse_number": "४-१७-७४", "content_sanskrit": "श्रीकरोपि महातेजा उपदिष्टो हनूमता ।\nब्राह्मणैस्सहधर्मज्ञैश्चक्रे शम्भोस्समर्हणम्॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001327074, "chapter_id": 21327, "verse_number": "४-१७-७५", "content_sanskrit": "चन्द्रसेनो महाराजः श्रीकरो गोपबालकः ।\nउभावपि परप्रीत्या महाकालं च भेजतुः॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001327075, "chapter_id": 21327, "verse_number": "४-१७-७६", "content_sanskrit": "कालेन श्रीकरस्सोपि चन्द्रसेनश्च भूपतिः ।\nसमाराध्य महाकालं भेजतुः परमं पदम्॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001327076, "chapter_id": 21327, "verse_number": "४-१७-७७", "content_sanskrit": "एवंविधो महाकालश्शिवलिंगस्सतां गतिः ।\nसर्वथा दुष्टहंता च शंकरो भक्तवत्सलः॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001327077, "chapter_id": 21327, "verse_number": "४-१७-७८", "content_sanskrit": "इदं पवित्रं परमं रहस्यं सर्वसौख्यदम् ।\nआख्यानं कथितं स्वर्ग्यं शिवभक्तिविवर्द्धनम्॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}]