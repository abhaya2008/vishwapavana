[{"id": 5000432000, "chapter_id": 9432, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे पञ्चविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000432001, "chapter_id": 9432, "verse_number": "६-२५-१", "content_sanskrit": "सबले सागरं तीर्णे रामे दशरथात्मजे।\nअमात्यौ रावणः श्रीमानब्रवीच्छुकसारणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000432002, "chapter_id": 9432, "verse_number": "६-२५-२", "content_sanskrit": "समग्रं सागरं तीर्णं दुस्तरं वानरं बलम्।\nअभूतपूर्वं रामेण सागरे सेतुबन्धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000432003, "chapter_id": 9432, "verse_number": "६-२५-३", "content_sanskrit": "सागरे सेतुबन्धं तं न श्रद्दध्यां कथंचन।\nअवश्यं चापि संख्येयं तन्मया वानरं बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000432004, "chapter_id": 9432, "verse_number": "६-२५-४", "content_sanskrit": "भवन्तौ वानरं सैन्यं प्रविश्यानुपलक्षितौ।\nपरिमाणं च वीर्यं च ये च मुख्याः प्लवंगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000432005, "chapter_id": 9432, "verse_number": "६-२५-५", "content_sanskrit": "मन्त्रिणो ये च रामस्य सुग्रीवस्य च सम्मताः।\nये पूर्वमभिवर्तन्ते ये च शूराः प्लवंगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000432006, "chapter_id": 9432, "verse_number": "६-२५-६", "content_sanskrit": "स च सेतुर्यथा बद्धः सागरे सलिलार्णवे।\nनिवेशं च यथा तेषां वानराणां महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000432007, "chapter_id": 9432, "verse_number": "६-२५-७", "content_sanskrit": "रामस्य व्यवसायं च वीर्यं प्रहरणानि च।\nलक्ष्मणस्य च वीरस्य तत्त्वतो ज्ञातुमर्हथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000432008, "chapter_id": 9432, "verse_number": "६-२५-८", "content_sanskrit": "कश्च सेनापतिस्तेषां वानराणां महात्मनाम्।\nतच्च ज्ञात्वा यथातत्त्वं शीघ्रमागन्तुमर्हथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000432009, "chapter_id": 9432, "verse_number": "६-२५-९", "content_sanskrit": "इति प्रतिसमादिष्टौ राक्षसौ शुकसारणौ।\nहरिरूपधरौ वीरौ प्रविष्टौ वानरं बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000432010, "chapter_id": 9432, "verse_number": "६-२५-१०", "content_sanskrit": "ततस्तद् वानरं सैन्यमचिन्त्यं लोमहर्षणम्।\nसंख्यातुं नाध्यगच्छेतां तदा तौ शुकसारणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000432011, "chapter_id": 9432, "verse_number": "६-२५-११", "content_sanskrit": "तत् स्थितं पर्वताग्रेषु निर्झरेषु गुहासु च।\nसमुद्रस्य च तीरेषु वनेषूपवनेषु च।\nतरमाणं च तीर्णं च तर्तुकामं च सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000432012, "chapter_id": 9432, "verse_number": "६-२५-१२", "content_sanskrit": "निविष्टं निविशच्चैव भीमनादं महाबलम्।\nतद‍्बलार्णवमक्षोभ्यं ददृशाते निशाचरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000432013, "chapter_id": 9432, "verse_number": "६-२५-१३", "content_sanskrit": "तौ ददर्श महातेजाः प्रतिच्छन्नौ विभीषणः।\nआचचक्षे स रामाय गृहीत्वा शुकसारणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000432014, "chapter_id": 9432, "verse_number": "६-२५-१४", "content_sanskrit": "तस्यैतौ राक्षसेन्द्रस्य मन्त्रिणौ शुकसारणौ।\nलङ्कायाः समनुप्राप्तौ चारौ परपुरंजय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000432015, "chapter_id": 9432, "verse_number": "६-२५-१५", "content_sanskrit": "तौ दृष्ट्वा व्यथितौ रामं निराशौ जीविते तथा।\nकृताञ्जलिपुटौ भीतौ वचनं चेदमूचतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000432016, "chapter_id": 9432, "verse_number": "६-२५-१६", "content_sanskrit": "आवामिहागतौ सौम्य रावणप्रहितावुभौ।\nपरिज्ञातुं बलं सर्वं तदिदं रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000432017, "chapter_id": 9432, "verse_number": "६-२५-१७", "content_sanskrit": "तयोस्तद् वचनं श्रुत्वा रामो दशरथात्मजः।\nअब्रवीत् प्रहसन् वाक्यं सर्वभूतहिते रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000432018, "chapter_id": 9432, "verse_number": "६-२५-१८", "content_sanskrit": "यदि दृष्टं बलं सर्वं वयं वा सुसमाहिताः।\nयथोक्तं वा कृतं कार्यं छन्दतः प्रतिगम्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000432019, "chapter_id": 9432, "verse_number": "६-२५-१९", "content_sanskrit": "अथ किंचिददृष्टं वा भूयस्तद् द्रष्टुमर्हथः।\nविभीषणो वा कात्स्‍‍र्न्येन पुनः संदर्शयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000432020, "chapter_id": 9432, "verse_number": "६-२५-२०", "content_sanskrit": "न चेदं ग्रहणं प्राप्य भेतव्यं जीवितं प्रति।\nन्यस्तशस्त्रौ गृहीतौ च न दूतौ वधमर्हथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000432021, "chapter_id": 9432, "verse_number": "६-२५-२१", "content_sanskrit": "प्रच्छन्नौ च विमुञ्चेमौ चारौ रात्रिंचरावुभौ।\nशत्रुपक्षस्य सततं विभीषण विकर्षिणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000432022, "chapter_id": 9432, "verse_number": "६-२५-२२", "content_sanskrit": "प्रविश्य महतीं लङ्कां भवद्‍भ्यां धनदानुजः।\nवक्तव्यो रक्षसां राजा यथोक्तं वचनं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000432023, "chapter_id": 9432, "verse_number": "६-२५-२३", "content_sanskrit": "यद् बलं त्वं समाश्रित्य सीतां मे हृतवानसि।\nतद् दर्शय यथाकामं ससैन्यश्च सबान्धवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000432024, "chapter_id": 9432, "verse_number": "६-२५-२४", "content_sanskrit": "श्वः काल्ये नगरीं लङ्कां सप्राकारां सतोरणाम्।\nरक्षसां च बलं पश्य शरैर्विध्वंसितं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000432025, "chapter_id": 9432, "verse_number": "६-२५-२५", "content_sanskrit": "क्रोधं भीममहं मोक्ष्ये ससैन्ये त्वयि रावण।\nश्वः काल्ये वज्रवान् वज्रं दानवेष्विव वासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000432026, "chapter_id": 9432, "verse_number": "६-२५-२६", "content_sanskrit": "इति प्रतिसमादिष्टौ राक्षसौ शुकसारणौ।\nजयेति प्रतिनन्द्यैनं राघवं धर्मवत्सलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000432027, "chapter_id": 9432, "verse_number": "६-२५-२७", "content_sanskrit": "आगम्य नगरीं लङ्कामब्रूतां राक्षसाधिपम्।\nविभीषणगृहीतौ तु वधार्थं राक्षसेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000432028, "chapter_id": 9432, "verse_number": "६-२५-२८", "content_sanskrit": "दृष्ट्वा धर्मात्मना मुक्तौ रामेणामिततेजसा।\nएकस्थानगता यत्र चत्वारः पुरुषर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000432029, "chapter_id": 9432, "verse_number": "६-२५-२९", "content_sanskrit": "लोकपालसमाः शूराः कृतास्त्रा दृढविक्रमाः।\nरामो दाशरथिः श्रीमाल्ँलक्ष्मणश्च विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000432030, "chapter_id": 9432, "verse_number": "६-२५-३०", "content_sanskrit": "सुग्रीवश्च महातेजा महेन्द्रसमविक्रमः।\nएते शक्ताः पुरीं लङ्कां सप्राकारां सतोरणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000432031, "chapter_id": 9432, "verse_number": "६-२५-३१", "content_sanskrit": "उत्पाट्य संक्रामयितुं सर्वे तिष्ठन्तु वानराः।\nयादृशं तद्धि रामस्य रूपं प्रहरणानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000432032, "chapter_id": 9432, "verse_number": "६-२५-३२", "content_sanskrit": "वधिष्यति पुरीं लङ्कामेकस्तिष्ठन्तु ते त्रयः।\nरामलक्ष्मणगुप्ता सा सुग्रीवेण च वाहिनी।\nबभूव दुर्धर्षतरा सर्वैरपि सुरासुरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000432033, "chapter_id": 9432, "verse_number": "६-२५-३३", "content_sanskrit": "प्रहृष्टयोधा ध्वजिनी महात्मनां\nवनौकसां सम्प्रति योद्धुमिच्छताम्।\nअलं विरोधेन शमो विधीयतां\nप्रदीयतां दाशरथाय मैथिली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000432034, "chapter_id": 9432, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे पञ्चविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]