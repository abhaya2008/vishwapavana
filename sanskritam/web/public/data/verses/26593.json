[{"id": 7006593000, "chapter_id": 26593, "verse_number": "३-१३२-१", "content_sanskrit": "जनमेजय उवाच भगवन् केन विधिना श्रोतव्यं भारतं बुधैः ।\nफलं किं के च देवाश्च पूज्या वै पारणेष्विह ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006593001, "chapter_id": 26593, "verse_number": "३-१३२-२", "content_sanskrit": "देयं समाप्ते भगवन् किं च पर्वणि पर्वणि ।\nवाचकः कीदृशश्चात्र यष्टव्यस्तद् ब्रवीहि मे ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006593002, "chapter_id": 26593, "verse_number": "३-१३२-३", "content_sanskrit": "वैशम्पायन उवाच शृणु राजन् विधिमिमं फलं यच्चापि भारतात् ।\nश्रुताद् भवति राजेन्द्र यत् त्वं मामनुपृच्छसि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006593003, "chapter_id": 26593, "verse_number": "३-१३२-४", "content_sanskrit": "दिवि देवा महीपाल क्रीडार्थमवनिं गताः ।\nकृत्वा कार्यमिदं चैव ततश्च दिवमागताः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006593004, "chapter_id": 26593, "verse_number": "३-१३२-५", "content_sanskrit": "हन्त यत् ते प्रवक्ष्यामि तच्छृणुष्व समाहितः ।\nऋषीणां देवतानां च सम्भवं वसुधातले ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006593005, "chapter_id": 26593, "verse_number": "३-१३२-६", "content_sanskrit": "अत्र रुद्रास्तथा साध्या विश्वेदेवाश्च शाश्वताः ।\nआदित्याश्चाश्विनौ देवौ लोकपाला महर्षयः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006593006, "chapter_id": 26593, "verse_number": "३-१३२-७", "content_sanskrit": "गुह्यकाश्च सगन्धर्वा नागा विद्याधरास्तथा ।\nसिद्धा धर्मः स्वयम्भूश्च मुनिः कात्यायनो वरः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006593007, "chapter_id": 26593, "verse_number": "३-१३२-८", "content_sanskrit": "गिरयः सागरा नद्यस्तथैवाप्सरसां गणाः ।\nग्रहाः संवत्सराश्चैव अयनान्यृतवस्तथा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006593008, "chapter_id": 26593, "verse_number": "३-१३२-९", "content_sanskrit": "स्थावरं जङ्गमं चैव जगत् सर्वं सुरासुरम् ।\nभारते भरतश्रेष्ठ एकस्थमिह दृश्यते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006593009, "chapter_id": 26593, "verse_number": "३-१३२-१०", "content_sanskrit": "तेषां श्रुतिप्रतिष्ठानां नामकर्मानुकीर्तनात् ।\nकृत्वापि पातकं घोरं सद्यो मुच्येत मानवः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006593010, "chapter_id": 26593, "verse_number": "३-१३२-११", "content_sanskrit": "इतिहासमिमं श्रुत्वा यथावदनुपूर्वशः ।\nसंयतात्मा शुचिर्भूत्वा पारं गत्वा च भारते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006593011, "chapter_id": 26593, "verse_number": "३-१३२-१२", "content_sanskrit": "तेषां शृणु त्वं श्राद्धानि श्रुत्वा भारत भारतम् ।\nब्राह्मणेभ्यो यथाशक्त्या भक्त्या च भरतर्षभ ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006593012, "chapter_id": 26593, "verse_number": "३-१३२-१३", "content_sanskrit": "महादानानि देयानि रत्नानि विविधानि च ।\nगावः कांस्योपदोहाश्च कन्याश्चैव स्वलंकृताः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006593013, "chapter_id": 26593, "verse_number": "३-१३२-१४", "content_sanskrit": "सर्वकामगुणोपेता यानानि विविधानि च ।\nभाजनानि विचित्राणि भूमिर्वासांसि काञ्चनम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006593014, "chapter_id": 26593, "verse_number": "३-१३२-१५", "content_sanskrit": "वाहनानि च देयानि हया मत्ताश्च वारणाः ।\nशयनं शिबिकाश्चैव स्यन्दनाश्च स्वलंकृताः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006593015, "chapter_id": 26593, "verse_number": "३-१३२-१६", "content_sanskrit": "यद् यद् गृहे वरं किंचिद् यद् यदस्ति महद्वसु ।\nतत् तद् देयं द्विजातिभ्य आत्मा दाराश्च सूनवः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006593016, "chapter_id": 26593, "verse_number": "३-१३२-१७", "content_sanskrit": "श्रद्धया परया दद्यात् क्रमशस्तस्य पारगः ।\nशक्तितः सुमना हृष्टः शुश्रूषुरविकम्पनः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006593017, "chapter_id": 26593, "verse_number": "३-१३२-१८", "content_sanskrit": "सत्यार्जवरतो यत्तः शुचिः शौचपरायणः ।\nश्रद्दधानो जितक्रोधो यथा सिद्ध्यति तच्छ्रृणु ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006593018, "chapter_id": 26593, "verse_number": "३-१३२-१९", "content_sanskrit": "शुचिः शीलान्विताचारः शुक्लवासा जितेन्द्रियः ।\nसंस्कृतः सर्वशास्त्रज्ञः श्रद्दधानोऽनसूयकः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006593019, "chapter_id": 26593, "verse_number": "३-१३२-२०", "content_sanskrit": "रूपवान् सुभगो दान्तः सत्यवादी जितेन्द्रियः ।\nदानमानग्रहीता च कार्यो भवति वाचकः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006593020, "chapter_id": 26593, "verse_number": "३-१३२-२१", "content_sanskrit": "अविलम्बमनायस्तमद्रुतं घोरमूर्जितम् ।\nअसंसक्ताक्षरपदं न च भावसमन्वितम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006593021, "chapter_id": 26593, "verse_number": "३-१३२-२२", "content_sanskrit": "त्रिषष्टिवर्णसंयुक्तमष्टस्थानसमीरितम् ।\nवाचयेद् वाचकः स्वस्थः स्वाधीनः सुसमाहितः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006593022, "chapter_id": 26593, "verse_number": "३-१३२-२३", "content_sanskrit": "नारायणं नमस्कृत्य नरं चैव नरोत्तमम् ।\nदेवीं सरस्वतीं व्यासं ततो जयमुदीरयेत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006593023, "chapter_id": 26593, "verse_number": "३-१३२-२४", "content_sanskrit": "ईदृशाद्वाचकाद्राजञ्च्छ्रुत्वा भारत भारतम् ।\nनियमस्थः शुचिः श्रोता शृण्वन्स फलमश्नुते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006593024, "chapter_id": 26593, "verse_number": "३-१३२-२५", "content_sanskrit": "पारणं प्रथमं प्राप्य द्विजान् कामैश्च तर्पयेत् ।\nअग्निष्टोमस्य यागस्य फलं वै लभते नरः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006593025, "chapter_id": 26593, "verse_number": "३-१३२-२६", "content_sanskrit": "अप्सरोगणसंकीर्णं विमानं लभते महत् ।\nप्रहृष्टः स तु देवैश्च दिवं याति समाहितः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006593026, "chapter_id": 26593, "verse_number": "३-१३२-२७", "content_sanskrit": "द्वितीयं पारणं प्राप्य अतिरात्रफलं लभेत् ।\nसर्वरत्नमयं दिव्यं विमानमधिरोहति ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006593027, "chapter_id": 26593, "verse_number": "३-१३२-२८", "content_sanskrit": "दिव्यमाल्याम्बरधरो दिव्यगन्धविभूषितः ।\nदिव्याङ्गदधरो नित्यं देवलोके महीयते ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006593028, "chapter_id": 26593, "verse_number": "३-१३२-२९", "content_sanskrit": "तृतीयं पारणं प्राप्य द्वादशाहफलं लभेत् ।\nवसत्यमरसंकाशो वर्षाण्ययुतशो दिवि ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006593029, "chapter_id": 26593, "verse_number": "३-१३२-३०", "content_sanskrit": "चतुर्थं वाजपेयस्य पञ्चमे द्विगुणं फलम् ।\nउदितादित्यसंकाशं ज्वलन्तमनलोपमम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006593030, "chapter_id": 26593, "verse_number": "३-१३२-३१", "content_sanskrit": "विमानं विबुधैः सार्धमारुह्य दिवि गच्छति ।\nवर्षायुतानि भवने शक्रस्य दिवि मोदते ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006593031, "chapter_id": 26593, "verse_number": "३-१३२-३२", "content_sanskrit": "षष्ठे द्विगुणमस्तीति सप्तमे त्रिगुणं फलम् ।\nकैलासशिखराकारं वैदूर्यमणिवेदिकम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006593032, "chapter_id": 26593, "verse_number": "३-१३२-३३", "content_sanskrit": "परिक्षिप्तं च बहुधा मणिविद्रुमभूषितम् ।\nविमानं समधिष्ठाय कामगं साप्सरोगणम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006593033, "chapter_id": 26593, "verse_number": "३-१३२-३४", "content_sanskrit": "सर्वांल्लोकान् विचरते द्वितीय इव भास्करः ।\nअष्टमे राजसूयस्य पारणे लभते फलम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006593034, "chapter_id": 26593, "verse_number": "३-१३२-३५", "content_sanskrit": "चन्द्रोदयनिभं रम्यं विमानमधिरोहति ।\nचन्द्ररश्मिप्रतीकाशैर्हयैर्युक्तं मनोजवैः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006593035, "chapter_id": 26593, "verse_number": "३-१३२-३६", "content_sanskrit": "सेव्यमानो वरस्त्रीणां चन्द्रकान्ततरैर्मुखैः ।\nमेखलानां निनादेन नूपुराणां च निःस्वनैः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006593036, "chapter_id": 26593, "verse_number": "३-१३२-३७", "content_sanskrit": "अङ्के परमनारीणां सुखं सुप्तो विबुध्यते ।\nनवमं क्रतुराजस्य वाजिमेधस्य भारत ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006593037, "chapter_id": 26593, "verse_number": "३-१३२-३८", "content_sanskrit": "काञ्चनस्तम्भनिर्व्यूहं वैदूर्यकृतवेदिकम् ।\nजाम्बूनदमयैर्दिव्यैर्गवाक्षैः सर्वतो वृतम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006593038, "chapter_id": 26593, "verse_number": "३-१३२-३९", "content_sanskrit": "सेवितं चाप्सरसंघैर्गन्धर्वैर्दिविचारिभिः ।\nविमानं समधिष्ठाय श्रिया परमया ज्वलन् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006593039, "chapter_id": 26593, "verse_number": "३-१३२-४०", "content_sanskrit": "दिव्यमाल्याम्बरधरो दिव्यचन्दनभूषितः ।\nमोदते दैवतैः सार्धं दिवि देव इवापर ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006593040, "chapter_id": 26593, "verse_number": "३-१३२-४१", "content_sanskrit": "दशमं पारणं प्राप्य द्विजातीनभिवन्द्य च ।\nकिङ्किणीजालनिर्घोषं पताकाध्वजशोभितम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006593041, "chapter_id": 26593, "verse_number": "३-१३२-४२", "content_sanskrit": "रत्नवेदिकसंकाशं वैदूर्यमणितोरणम् ।\nहेमजालपरिक्षिप्तं प्रवालवलभीमुखम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006593042, "chapter_id": 26593, "verse_number": "३-१३२-४३", "content_sanskrit": "गन्धर्वैर्गीतकुशलैरप्सरोभिर्निषेवितम् ।\nविमानं सुकृतावासं सुखेनैवोपपद्यते॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006593043, "chapter_id": 26593, "verse_number": "३-१३२-४४", "content_sanskrit": "मुकुटेनार्कवर्णेन जाम्बूनदविभूषणः ।\nदिव्यचन्दनदिग्धाङ्गो दिव्यमाल्यविभूषितः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006593044, "chapter_id": 26593, "verse_number": "३-१३२-४५", "content_sanskrit": "दिव्याँल्लोकान् प्रचरति दिव्यैर्भोगैः समन्वितः ।\nविबुधानां प्रसादेन श्रिया परमया युतः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006593045, "chapter_id": 26593, "verse_number": "३-१३२-४६", "content_sanskrit": "अथ वर्षगणानेवं स्वर्गलोके महीयते ।\nततो गन्धर्वसहितः सहस्राण्येकविंशतिः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006593046, "chapter_id": 26593, "verse_number": "३-१३२-४७", "content_sanskrit": "पुरंदरपुरे रम्ये शक्रेण सह मोदते ।\nदिव्ययानविमानेषु लोकेषु विविधेषु च ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006593047, "chapter_id": 26593, "verse_number": "३-१३२-४८", "content_sanskrit": "दिव्यनारीगणाकीर्णो निवसत्यमरो यथा ।\nततः सूर्यस्य भवने चन्द्रस्य भवने तथा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006593048, "chapter_id": 26593, "verse_number": "३-१३२-४९", "content_sanskrit": "शिवस्य भवने राजन् विष्णोर्याति सलोकताम् ।\nएवमेतन्महाराज नात्र कार्या विचारणा॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006593049, "chapter_id": 26593, "verse_number": "३-१३२-५०", "content_sanskrit": "श्रद्दधानेन वै भाव्यमेवमाह गुरुर्मम ।\nवाचकस्य तु दातव्यं मनसा यद् यदिच्छति ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006593050, "chapter_id": 26593, "verse_number": "३-१३२-५१", "content_sanskrit": "हस्त्यश्वरथयानादि वाहनं च विशेषतः ।\nकटके कुण्डले चैव ब्रह्मसूत्रं तथापरम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006593051, "chapter_id": 26593, "verse_number": "३-१३२-५२", "content_sanskrit": "वस्त्रं चैव विचित्रं च गन्धं चैवं विशेषतः ।\nदेववत् पूजयेत्तं तु विष्णुलोकमवाप्नुयात् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006593052, "chapter_id": 26593, "verse_number": "३-१३२-५३", "content_sanskrit": "अतः परं प्रवक्ष्यामि यानि देयानि भारते ।\nवाच्यमानेऽथ विप्रेभ्यो राजन् पर्वणि पर्वणि ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006593053, "chapter_id": 26593, "verse_number": "३-१३२-५४", "content_sanskrit": "जातिं देशं च सत्यं च माहात्म्यं भरतर्षभ ।\nधर्मवृत्तिं च विज्ञाय ब्राह्मणानां नराधिप ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006593054, "chapter_id": 26593, "verse_number": "३-१३२-५५", "content_sanskrit": "स्वस्ति वाच्यं द्विजैरादौ ततः कार्यं प्रवर्तयेत् ।\nसमाप्तपर्वणि ततः स्वशक्त्या तर्पयेद् द्विजान् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006593055, "chapter_id": 26593, "verse_number": "३-१३२-५६", "content_sanskrit": "आदौ तु वाचकं चैव वस्त्रगन्धसमन्वितम् ।\nविधिवद् भोजयेद् राजन् मधुपायससंयुतम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006593056, "chapter_id": 26593, "verse_number": "३-१३२-५७", "content_sanskrit": "ततो मूलफलप्रायं पायसं मधुसर्पिषा ।\nआस्तीके भोजयेद् राजन् दद्याच्चैव गुडौदनम्॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006593057, "chapter_id": 26593, "verse_number": "३-१३२-५८", "content_sanskrit": "अपूपैश्चैव पूपैश्च मोदकैश्च समन्वितम् ।\nसभापर्वणि राजेन्द्र हविष्यं भोजयेद् द्विजान् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006593058, "chapter_id": 26593, "verse_number": "३-१३२-५९", "content_sanskrit": "आरण्यके मूलफलैस्तर्पयेच्च द्विजोत्तमान् ।\nअरणीपर्व आसाद्य जलकुम्भान् प्रदापयेत् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006593059, "chapter_id": 26593, "verse_number": "३-१३२-६०", "content_sanskrit": "तर्पणानि च मुख्यानि वन्यमूलफलानि च ।\nसर्वकामगुणोपेतं विप्रेभ्योऽन्नं प्रदापयेत् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006593060, "chapter_id": 26593, "verse_number": "३-१३२-६१", "content_sanskrit": "विराटपर्वणि तथा वासांसि विविधानि च ।\nउद्योगे भरतश्रेष्ठ सर्वकामगुणान्वितम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006593061, "chapter_id": 26593, "verse_number": "३-१३२-६२", "content_sanskrit": "भोजनं भोजयेद् विप्रान् गन्धमाल्यैरलकृतान् ।\nभीष्मपर्वणि राजेन्द्र दत्त्वा यानमनुत्तमम् ।\nततः सर्वगुणोपेतमन्नं दद्यात् सुसंस्कृतम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006593062, "chapter_id": 26593, "verse_number": "३-१३२-६३", "content_sanskrit": "द्रोणपर्वणि विप्रेभ्यो भोजनं परमार्चितम् ।\nशराश्च देया राजेन्द्र चापान्यसिवरांस्तथा ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006593063, "chapter_id": 26593, "verse_number": "३-१३२-६४", "content_sanskrit": "कर्णपर्वण्यपि तथा भोजनं सार्वकामिकम् ।\nविप्रेभ्यः संस्कृतं सम्यग् दद्यात् संयतमानसः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006593064, "chapter_id": 26593, "verse_number": "३-१३२-६५", "content_sanskrit": "शल्यपर्वणि राजेन्द्र मोदकैः सगुडौदनैः ।\nअपूपैस्तर्पयेच्चैव सर्वमन्नं प्रदापयेत् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006593065, "chapter_id": 26593, "verse_number": "३-१३२-६६", "content_sanskrit": "गदापर्वण्यपि तथा मुद्गमिश्रं प्रदापयेत् ।\nस्त्रीपर्वणि तथा रत्नैस्तर्पयेत् तु द्विजोत्तमान् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006593066, "chapter_id": 26593, "verse_number": "३-१३२-६७", "content_sanskrit": "घृतौदनं पुरस्ताच्च ऐषीके दापयेत् पुनः ।\nततः सर्वगुणोपेतमन्नं दद्यात् सुसंस्कृतम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006593067, "chapter_id": 26593, "verse_number": "३-१३२-६८", "content_sanskrit": "शान्तिपर्वण्यपि गते हविष्यं भोजयेद्द्विजान् ।\nआश्वमेधिकमासाद्य भोजनं सार्वकामिकम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006593068, "chapter_id": 26593, "verse_number": "३-१३२-६९", "content_sanskrit": "तथाऽऽश्रमनिवासे तु हविष्यं भोजयेद् द्विजान् ।\nमौसले सार्वगुणिकं गन्धमाल्यानुलेपनम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006593069, "chapter_id": 26593, "verse_number": "३-१३२-७०", "content_sanskrit": "महाप्रास्थानिके तद्वत् सर्वकामगुणान्वितम् ।\nस्वर्गपर्वण्यपि तथा हविष्यं भोजयेद् द्विजान् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006593070, "chapter_id": 26593, "verse_number": "३-१३२-७१", "content_sanskrit": "हरिवंशसमाप्तौ तु सहस्रं भोजयेद् द्विजान् ।\nगामेकां निष्कसंयुक्तां ब्राह्मणाय निवेदयेत् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006593071, "chapter_id": 26593, "verse_number": "३-१३२-७२", "content_sanskrit": "तदर्धेनापि दातव्या दरिद्रेणापि पार्थिव ।\nप्रतिपर्वसमाप्तौ तु पुस्तकं वै विचक्षणः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006593072, "chapter_id": 26593, "verse_number": "३-१३२-७३", "content_sanskrit": "सुवर्णेन च संयुक्तं वाचकाय निवेदयेत् ।\nहरिवंशे पर्वणि च पायसं तत्र भोजयेत् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006593073, "chapter_id": 26593, "verse_number": "३-१३२-७४", "content_sanskrit": "श्लोकं वा श्लोकपादं वा अक्षरं वा नृपात्मज ।\nशृणुयादेकचित्तस्तु स विप्णुदयितो भवेत् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006593074, "chapter_id": 26593, "verse_number": "३-१३२-७५", "content_sanskrit": "व्यासं चैव सपत्नीकं पूजयेच्च यथाविधि ।\nलक्ष्मीनारायणं देवं पूजितं तं च पूजयेत् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006593075, "chapter_id": 26593, "verse_number": "३-१३२-७६", "content_sanskrit": "वाचकं पूजयेद् यस्तु भूमिवस्त्रसुधेनुभिः ।\nविष्णुः सम्पूजितस्तेन स साक्षाद् देवकीसुतः॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006593076, "chapter_id": 26593, "verse_number": "३-१३२-७७", "content_sanskrit": "पारणे पारणे राजन् यथावद् भरतर्षभ ।\nसमाप्य सर्वाः प्रयतः संहिताः शास्त्रकोविदः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006593077, "chapter_id": 26593, "verse_number": "३-१३२-७८", "content_sanskrit": "शुभे देशे निवेश्याथ क्षौमवस्त्राभिसंवृतः ।\nशुक्लाम्बरधरः श्रीमाञ्छुचिर्भूत्वा स्वलंकृतः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006593078, "chapter_id": 26593, "verse_number": "३-१३२-७९", "content_sanskrit": "अर्चयेत् तं यथान्यायं गन्धमाल्यैः पृथक् पृथक् ।\nसंहितापुस्तकान् राजन् प्रयतः शिष्टसम्मतः॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006593079, "chapter_id": 26593, "verse_number": "३-१३२-८०", "content_sanskrit": "भक्ष्यैर्भोज्यैश्च पेयैश्च कामैश्च विविधैः शुभैः ।\nहिरण्यं गां च वस्त्रं च दक्षिणामथ दापयेत् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006593080, "chapter_id": 26593, "verse_number": "३-१३२-८१", "content_sanskrit": "सर्वत्र त्रिपलं स्वर्णं दातव्यं प्रणतात्मना ।\nतदर्धं पादशेषं वा वित्तशाठ्यविवर्जितम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006593081, "chapter_id": 26593, "verse_number": "३-१३२-८२", "content_sanskrit": "यद् यदेवात्मनोऽभीष्टं तत् तद् देयं द्विजातये ।\nसर्वथा तोषयेत् भक्त्या वाचकं गुरुमात्मनः ।\nदेवताः कीर्तयेत् सर्वा नरनारायणौ तथा ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006593082, "chapter_id": 26593, "verse_number": "३-१३२-८३", "content_sanskrit": "ततो गन्धैश्च माल्यैश्च स्वलंकृतद्विजोत्तमान् ।\nतर्पयेद् विविधैः कामैर्दानैश्चोच्चावचैस्तथा॥ ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006593083, "chapter_id": 26593, "verse_number": "३-१३२-८४", "content_sanskrit": "अतिरात्रस्य यज्ञस्य फलं प्राप्नोति मानवः ।\nप्राप्नुयाच्च क्रतुफलं तथा पर्वणि पर्वणि ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006593084, "chapter_id": 26593, "verse_number": "३-१३२-८५", "content_sanskrit": "वाचको भरतश्रेष्ठ व्यक्ताक्षरपदस्वरः ।\nभविष्यं श्रावयेद् विप्रान् भारतं भरतर्षभ ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006593085, "chapter_id": 26593, "verse_number": "३-१३२-८६", "content_sanskrit": "भुक्तवत्सु द्विजेन्द्रेषु यथावत् सम्प्रदापयेत् ।\nवाचकं भरतश्रेष्ठ भोजयित्वा स्वलंकृतम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006593086, "chapter_id": 26593, "verse_number": "३-१३२-८७", "content_sanskrit": "वाचके परितुष्टे तु शुभा प्रीतिरनुत्तमा ।\nब्राह्मणेषु च तुष्टेषु प्रसन्नाः सर्वदेवताः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006593087, "chapter_id": 26593, "verse_number": "३-१३२-८८", "content_sanskrit": "ततो हि भरणं कार्यं द्विजानां भरतर्षभ ।\nसर्वकामैर्यथान्यायं साधुभिश्च यथाक्रमम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006593088, "chapter_id": 26593, "verse_number": "३-१३२-८९", "content_sanskrit": "इत्येष विधिरुद्दिष्टो मया ते द्विपदां वर ।\nश्रद्दधानेन वै भाव्यं यन्मां त्वं परिपृच्छसि ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006593089, "chapter_id": 26593, "verse_number": "३-१३२-९०", "content_sanskrit": "भारतश्रवणे राजन् पारणे च नृपोत्तम ।\nसदा यत्नवता भाव्यं श्रेयस्तु परमिच्छता ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006593090, "chapter_id": 26593, "verse_number": "३-१३२-९१", "content_sanskrit": "भारतं शृणुयान्नित्यं भारतं परिकीर्तयेत् ।\nभारतं भवने यस्य तस्य हस्तगतो जयः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7006593091, "chapter_id": 26593, "verse_number": "३-१३२-९२", "content_sanskrit": "भारतं परमं पुण्यं भारते विविधाः कथाः ।\nभारतं सेव्यते देवैर्भारतं परिकीर्तयेत् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7006593092, "chapter_id": 26593, "verse_number": "३-१३२-९३", "content_sanskrit": "भारतं सर्वशास्त्राणामुत्तमं भरतर्षभ ।\nभारतात् प्राप्यते मोक्षस्तत्त्वमेतद् ब्रवीमि ते ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7006593093, "chapter_id": 26593, "verse_number": "३-१३२-९४", "content_sanskrit": "महाभारतमाख्यानं क्षितिं गां च सरस्वतीम् ।\nब्राह्मणं केशवं चापि कीर्तयन् नावसीदति ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7006593094, "chapter_id": 26593, "verse_number": "३-१३२-९५", "content_sanskrit": "वेदे रामायणे पुण्ये भारते भरतर्षभ ।\nआदौ चान्ते च मध्ये च हरिः सर्वत्र गीयते ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7006593095, "chapter_id": 26593, "verse_number": "३-१३२-९६", "content_sanskrit": "यत्र विष्णुकथा दिव्याः श्रुतयश्च सनातनाः ।\nतच्छ्रोतव्यं मनुष्येण परं पदमिहेच्छता ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7006593096, "chapter_id": 26593, "verse_number": "३-१३२-९७", "content_sanskrit": "एतत् पवित्रं परममेतद् धर्मनिदर्शनम् ।\nएतत् सर्वगुणोपेतं श्रोतव्यं भूतिमिच्छता ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7006593097, "chapter_id": 26593, "verse_number": "३-१३२-९८", "content_sanskrit": "क्रियतेऽसारसंसारे वाञ्छितस्यैव कारणम् ।\nहरिवंशस्य श्रवणमिति द्वैपायनोऽब्रवीत् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7006593098, "chapter_id": 26593, "verse_number": "३-१३२-९९", "content_sanskrit": "अश्वमेधसहस्रेण वाजपेयशतैस्तथा ।\nयत् फलं प्राप्यते पुंभिस्तद्धरेर्वंशपारणात् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7006593099, "chapter_id": 26593, "verse_number": "३-१३२-१००", "content_sanskrit": "अजरममरमेकं ध्येयमाद्यन्तशून्यं सगुणमगुणमाद्यं स्थूलमत्यन्तसूक्ष्मम् ।\nनिरुपममनुमेयं योगिनां ज्ञानगम्यं त्रिभुवनगुरुमीशं त्वां प्रपन्नोऽस्मि विष्णो ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7006593100, "chapter_id": 26593, "verse_number": "३-१३२-१०१", "content_sanskrit": "सर्वस्तरतु दुर्गाणि सर्वो भद्राणि पश्यतु ।\nसर्वेषां वाञ्छिता अर्था भवन्त्वस्य च पारणात् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}]