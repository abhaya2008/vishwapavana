[{"id": 2010181, "chapter_id": 1204, "verse_number": "१-२०५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2010182, "chapter_id": 1204, "verse_number": "१-२०५-१", "content_sanskrit": "अजिनानि विधुन्वन्तः करकाश्च द्विजर्षभाः।\nऊचुस्ते भीर्न कर्तव्या वयं योत्स्यामहे परान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2010183, "chapter_id": 1204, "verse_number": "१-२०५-२", "content_sanskrit": "तानेवं वदतो विप्रानर्जुनः प्रहसन्निव।\nउवाच प्रेक्षका भूत्वा यूयं तिष्ठत पार्श्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2010184, "chapter_id": 1204, "verse_number": "१-२०५-३", "content_sanskrit": "अहमेनानजिह्माग्रैः शतशो विकिरञ्छरैः।\nवारयिष्यामि संक्रुद्धान्मन्त्रैराशीविषानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2010185, "chapter_id": 1204, "verse_number": "१-२०५-४", "content_sanskrit": "इति तद्धनुरानम्य शुल्कावाप्तं महाबलः।\nभ्रात्रा भीमेन सहितस्तस्थौ गिरिरिवाचलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2010186, "chapter_id": 1204, "verse_number": "१-२०५-५", "content_sanskrit": "ततः कर्णमुखान्दृष्ट्वा क्षत्रियान्युद्धदुर्मदान्।\nसंपेततुरभीतौ तौ गजौ प्रतिगजानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2010187, "chapter_id": 1204, "verse_number": "१-२०५-६", "content_sanskrit": "ऊचुश्च वाचः परुषास्ते राजानो युयुत्सवः।\nआहवे हि द्विजस्यापि वधो दृष्टो युयुत्सतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2010188, "chapter_id": 1204, "verse_number": "१-२०५-७", "content_sanskrit": "इत्येवमुक्त्वा राजानः सहसा दुद्रुवुर्द्विजान्।\nततः कर्णो महातेजा जिष्णुं प्रति ययौ रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2010189, "chapter_id": 1204, "verse_number": "१-२०५-८", "content_sanskrit": "युद्धार्थी वासिताहेतोर्गजः प्रतिगजं यथा।\nभीमसेनं ययौ शल्यो मद्राणामीश्वरो बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2010190, "chapter_id": 1204, "verse_number": "१-२०५-९", "content_sanskrit": "दुर्योधनादयः सर्वे ब्राह्मणैः सह संगताः।\nमृदुपूर्वमयत्नेन प्रत्ययुध्यंस्तदाऽऽहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2010191, "chapter_id": 1204, "verse_number": "१-२०५-१०", "content_sanskrit": "ततोऽर्जुनः प्रत्यविध्यदापतन्तं शितैः शरैः।\nकर्णं वैकर्तनं श्रीमान्विकृष्य बलवद्धनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2010192, "chapter_id": 1204, "verse_number": "१-२०५-११", "content_sanskrit": "तेषां शराणां वेगेन शितानां तिग्मतेजसाम्।\nविमुह्यमानो राधेयो यत्नात्तमनुधावति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2010193, "chapter_id": 1204, "verse_number": "१-२०५-१२", "content_sanskrit": "तावुभावप्यनिर्देश्यौ लाघवाज्जयतां वरौ।\nअयुध्येतां सुसंरब्धावन्योन्यविजिगीषिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2010194, "chapter_id": 1204, "verse_number": "१-२०५-१३", "content_sanskrit": "कृते प्रतिकृतं पश्य पश्य बाहुबलं च मे।\nइति शूरार्थवचनैरभाषेतां परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2010195, "chapter_id": 1204, "verse_number": "१-२०५-१४", "content_sanskrit": "ततोऽर्जुनस्य भुजयोर्वीर्यमप्रतिमं भुवि।\nज्ञात्वा वैकर्तनः कर्णः संरब्धः समयोधयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2010196, "chapter_id": 1204, "verse_number": "१-२०५-१५", "content_sanskrit": "अर्जुनेन प्रयुक्तांस्तान्बाणान्वेगवतस्तदा।\nप्रतिहत्य ननादोच्चैः सैन्यानि तदपूजयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2010197, "chapter_id": 1204, "verse_number": "१-२०५-१६x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2010198, "chapter_id": 1204, "verse_number": "१-२०५-१६", "content_sanskrit": "तुष्यामि ते विप्रमुख्य भुजवीयर्स्य संयुगे।\nअविषादस्य चैवास्य शस्त्रास्त्रविजयस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2010199, "chapter_id": 1204, "verse_number": "१-२०५-१७", "content_sanskrit": "किं त्वं साक्षाद्धनुर्वेदो रामो वा विप्रसत्तम।\nअथ साक्षाद्धरिहयः साक्षाद्वा विष्णुरच्युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2010200, "chapter_id": 1204, "verse_number": "१-२०५-१८", "content_sanskrit": "आत्मप्रच्छादनार्थं वै बाहुवीर्यमुपाश्रितः।\nविप्ररूपं विधायेदं मन्ये मां प्रतियुध्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2010201, "chapter_id": 1204, "verse_number": "१-२०५-१९", "content_sanskrit": "न हि मामाहवे क्रुद्धमन्यः साक्षाच्छचीपतेः।\nपुमान्योधयितुं शक्तः पाण्डवाद्वा किरीटिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2010202, "chapter_id": 1204, "verse_number": "१-२०५-२०", "content_sanskrit": "दग्धा जतुगृहे सर्वे पाण्डवाः सार्जुनास्तदा।\nविनार्जुनं वा समरे मां निहन्तुमशक्नुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2010203, "chapter_id": 1204, "verse_number": "१-२०५-२१", "content_sanskrit": "तमेवंवादिनं तत्र फाल्गुनः प्रत्यभाषत।\nनास्मि कर्ण धनुर्वेदो नास्मि रामः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2010204, "chapter_id": 1204, "verse_number": "१-२०५-२२", "content_sanskrit": "ब्राह्मणोऽस्मि युधां श्रेष्ठः सर्वशस्त्रभृतां वरः।\nब्राह्मे पौरन्दरे चास्त्रे निष्ठितोगुरुशासनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2010205, "chapter_id": 1204, "verse_number": "१-२०५-२३", "content_sanskrit": "स्थितोऽस्म्यद्य रणे जेतुं त्वां वै वीर स्थिरो भव।\nनिर्जितोऽस्मीति वा ब्रूहि ततो व्रज यथासुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2010206, "chapter_id": 1204, "verse_number": "१-२०५-२४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2010207, "chapter_id": 1204, "verse_number": "१-२०५-२४", "content_sanskrit": "एवमुक्त्वाऽथ कर्णस्य धनुश्चिच्छेद पाण्डवः।\nततोऽन्यद्धनुरादाय संयोद्धुं सन्दधे शरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2010208, "chapter_id": 1204, "verse_number": "१-२०५-२५", "content_sanskrit": "दृष्ट्वा तच्चापि कौन्तेयश्छित्वा तद्धनुराशुगैः।\nतथा वैकर्तनं कर्णं बिभेद समरेऽर्जुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2010209, "chapter_id": 1204, "verse_number": "१-२०५-२६", "content_sanskrit": "ततः कर्णस्तु राधेयः छिन्नछन्वा महाबलः।\nशरैरतीव विद्धाङ्गः पलायनमथाकरोत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2010210, "chapter_id": 1204, "verse_number": "१-२०५-२७", "content_sanskrit": "पुनरायान्मुहूर्तेन गृहीत्वा सशरं धनुः।\nववर्ष शरवर्षाणि पार्थं वैकर्तनस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2010211, "chapter_id": 1204, "verse_number": "१-२०५-२८", "content_sanskrit": "तानि वै शरजालानि कौन्तेयोऽभ्यहनच्छरैः।\nज्ञात्वा सर्वाञ्शरान्घोरान्कर्णोऽदावद्द्रुतं बहिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2010212, "chapter_id": 1204, "verse_number": "१-२०५-२९", "content_sanskrit": "ब्राह्मं तेजस्तदाऽजय्यं मन्यमानो महारथः।\nअपरस्मिन्वनोद्देशे वीरौ शल्यवृकोदरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2010213, "chapter_id": 1204, "verse_number": "१-२०५-३०", "content_sanskrit": "बलिनौ युद्धसंपन्नौ विद्यया च बलेन च।\nअन्योन्यमाह्वयन्तौ तु मत्ताविव महागजौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2010214, "chapter_id": 1204, "verse_number": "१-२०५-३१", "content_sanskrit": "मुष्टिभिर्जानुभिश्चैव निघ्नन्तावितरेतरम्।\nप्रकर्षणाकर्षणयोरभ्याकर्षविकर्षणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2010215, "chapter_id": 1204, "verse_number": "१-२०५-३२", "content_sanskrit": "आचकर्षतुरन्योन्यं मुष्टिभिश्चापि जघ्नतुः।\nततश्चटचटाशब्दः सुघोरो ह्यभवत्तयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2010216, "chapter_id": 1204, "verse_number": "१-२०५-३३", "content_sanskrit": "पाषाणसंपातनिभैः प्रहारैरभिजघ्नतुः।\nमुहूर्तं तौ तदाऽन्योन्यं समरे पर्यकर्षताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2010217, "chapter_id": 1204, "verse_number": "१-२०५-३४", "content_sanskrit": "ततो भीमः समुत्क्षिप्य बाहुभ्यां शल्यमाहवे।\nअपातयत्कुरुश्रेष्ठो ब्राह्मणा जहसुस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2010218, "chapter_id": 1204, "verse_number": "१-२०५-३५", "content_sanskrit": "तत्राश्चर्यं भीमसेनश्चकार पुरुषर्षभः।\nयच्छल्यं पातितं भूमौ नावधीद्बलिनं बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2010219, "chapter_id": 1204, "verse_number": "१-२०५-३६", "content_sanskrit": "पातिते भीमसेनेन शल्ये कर्णे च शङ्किते।\nविस्मयः परमो जज्ञे सर्वेषां पश्यतां नृणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2010220, "chapter_id": 1204, "verse_number": "१-२०५-३७", "content_sanskrit": "ततो राजसमूहस्य पश्यतो वृक्षमारुजत्।\nततस्तु भीमं संज्ञाभिर्वारयामास धर्मराट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2010221, "chapter_id": 1204, "verse_number": "१-२०५-३८", "content_sanskrit": "आकारज्ञस्तथा भ्रातुः पाण्डवोऽपि न्यवर्तत।\nधर्मराजश्च कौरव्य दुर्योधनममर्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2010222, "chapter_id": 1204, "verse_number": "१-२०५-३९", "content_sanskrit": "अयोधयत्सभामध्ये पश्यतां वै महीक्षिताम्।\nततो दुर्योधनस्तं तु ह्यवज्ञाय युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2010223, "chapter_id": 1204, "verse_number": "१-२०५-४०", "content_sanskrit": "नायोधयत्तदा तेन बलवान्वै सुयोधनः।\nएतस्मिन्नन्तरेऽविध्यद्बाणेनानतपर्वणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2010224, "chapter_id": 1204, "verse_number": "१-२०५-४१", "content_sanskrit": "दुर्योधनममित्रघ्नं धर्मराजो युधिष्ठिरः।\nततो दुर्योधनः क्रुद्धो दण्डाहत इवोरगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2010225, "chapter_id": 1204, "verse_number": "१-२०५-४२", "content_sanskrit": "प्रत्ययुध्यत राजानं यत्नं परममास्थितः।\nछित्त्वा राजा धनुः सज्यं धार्तराष्ट्रस्य संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2010226, "chapter_id": 1204, "verse_number": "१-२०५-४३", "content_sanskrit": "अभ्यवर्षच्छरौघैस्तं स हित्वा प्राद्रवद्रणम्।\nदुःशासनस्तु संक्रुद्धः सहदेवेन पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2010227, "chapter_id": 1204, "verse_number": "१-२०५-४४", "content_sanskrit": "युद्ध्वा च सुचिरं कालं सहदेवेन निर्जितः।\nउत्सृज्य च धनुः सङ्ख्ये जानुभ्यामवनीं गतः।\nउत्थाय सोऽभिदुद्राव सोसिं जग्राह चर्म च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2010228, "chapter_id": 1204, "verse_number": "१-२०५-४५", "content_sanskrit": "विकर्णचित्रसेनाभ्यां निगृहीतश्च कौरवः।\nमा युद्धमिति कौरव्य ब्राह्मणेनाबलेन वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2010229, "chapter_id": 1204, "verse_number": "१-२०५-४६", "content_sanskrit": "दुःसहो नकुलश्चोभौ युद्धं कर्तुं समुद्यतै।\nतौ दृष्ट्वा कौरवा युद्धं वाक्यमूचुर्महाबलौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2010230, "chapter_id": 1204, "verse_number": "१-२०५-४७", "content_sanskrit": "निवर्तन्तां भवन्तो वै कुतो विप्रेषु क्रूरता।\nदुर्बला ब्राह्मणाश्चेमे भवन्तो वै महाबलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2010231, "chapter_id": 1204, "verse_number": "१-२०५-४८", "content_sanskrit": "द्वावत्र ब्राह्मणौ क्रूरौ वाय्विन्द्रसदृशौ बले।\nये वा के वा नमस्तेभ्यो गच्छामः स्वपुरं वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2010232, "chapter_id": 1204, "verse_number": "१-२०५-४९", "content_sanskrit": "एवं संभाषमाणास्ते न्यवर्तन्ताथ कौरवाः।\nजहृषुर्ब्राह्मणास्तत्र समेतास्तत्र सङ्घशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2010233, "chapter_id": 1204, "verse_number": "१-२०५-५०", "content_sanskrit": "बहुशस्ते ततस्तत्र क्षत्रिया रणमूर्धनि।\nप्रेक्षमाणास्तथाऽतिष्ठन्ब्राह्मणांश्च समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2010234, "chapter_id": 1204, "verse_number": "१-२०५-५१", "content_sanskrit": "ब्राह्मणाश्च जयं प्राप्ताः कन्यामादाय निर्ययुः।\nविजिते भीमसेनेन शल्ये कर्णे च निर्जिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2010235, "chapter_id": 1204, "verse_number": "१-२०५-५२", "content_sanskrit": "दुर्योधने चापयाते तथा दुःशासने रणात्।\nशङ्किताः सर्वराजानः परिवव्रुर्वृकोदरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2010236, "chapter_id": 1204, "verse_number": "१-२०५-५३", "content_sanskrit": "ऊचुश्च सहितास्तत्र साध्विमौ ब्राह्मणर्षभौ।\nविज्ञायेतां क्वजन्मानौ क्वनिवासौ तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2010237, "chapter_id": 1204, "verse_number": "१-२०५-५४", "content_sanskrit": "को हि राधासुतं कर्णं शक्तो योधयितुं रणे।\nअन्यत्र रामाद्द्रोणाद्वा पाण्डवाद्वा किरीटिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2010238, "chapter_id": 1204, "verse_number": "१-२०५-५५", "content_sanskrit": "कृष्णाद्वा देवकीपुत्रात्कृपाद्वापि शरद्वतः।\nको वा दुर्योधनं शक्तः प्रतियोथयितुं रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2010239, "chapter_id": 1204, "verse_number": "१-२०५-५६", "content_sanskrit": "तथैव मद्राधिपतिं शल्यं बलवतांवरम्।\nबलदेवादृते वीरात्पाण्डवाद्वा वृकोदरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2010240, "chapter_id": 1204, "verse_number": "१-२०५-५७", "content_sanskrit": "वीराद्दुर्योधनाद्वाऽन्यः शक्तः पातयितुं रणे।\nक्रियतामवहारोऽस्माद्युद्धाद्ब्राह्मणसंवृतात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2010241, "chapter_id": 1204, "verse_number": "१-२०५-५८", "content_sanskrit": "ब्राह्मणा हि सदा रक्ष्याः सापराधाऽपिनित्यदा।\nअथैनानुपलभ्येह पुनर्योत्स्याम हृष्टवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2010242, "chapter_id": 1204, "verse_number": "१-२०५-५९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2010243, "chapter_id": 1204, "verse_number": "१-२०५-५९", "content_sanskrit": "तांस्तथावादिनः सर्वान्प्रसमीक्ष्य क्षितीश्वरान्।\nअथान्यान्पुरुषांश्चापि कृत्वा तत्कर्म संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2010244, "chapter_id": 1204, "verse_number": "१-२०५-६०", "content_sanskrit": "तत्कर्म भीमस्य समीक्ष्य कृष्णः\nकुन्तीसुतौ तौ परिशङ्कमानः।\nनिवारयामास महीपतींस्ता-\nन्धर्मेण लब्धेत्यनुनीय सर्वान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2010245, "chapter_id": 1204, "verse_number": "१-२०५-६१", "content_sanskrit": "एवं ते विनिवृत्तास्तु युद्धाद्युद्धविशारदाः।\nयथावासं ययुः सर्वे विस्मिता राजसत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2010246, "chapter_id": 1204, "verse_number": "१-२०५-६२", "content_sanskrit": "वृत्तो ब्रह्मोत्तरो रङ्गः पाञ्चाली ब्राह्मणैर्वृता।\nइति ब्रुवन्तः प्रययुर्ये तत्रासन्समागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2010247, "chapter_id": 1204, "verse_number": "१-२०५-६३", "content_sanskrit": "ब्राह्मणैस्तु प्रतिच्छन्नौ रौरवाजिनवासिभिः।\nकृच्छ्रेण जग्मतुस्तौ तु भीमसेनधनञ्जयौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2010248, "chapter_id": 1204, "verse_number": "१-२०५-६४", "content_sanskrit": "विमुक्तौ जनसंबाधाच्छत्रुभिः परिविक्षतौ।\nकृष्णयानुगतौ तत्र नृवीरौ तौ विरेजतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2010249, "chapter_id": 1204, "verse_number": "१-२०५-६५", "content_sanskrit": "पौर्णमास्यां घनैर्मुक्तौ चन्द्रसूर्याविवोदितौ।\nतेषां माता बहुविधं विनाशं पर्यचिन्तयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2010250, "chapter_id": 1204, "verse_number": "१-२०५-६६", "content_sanskrit": "अनागच्छत्सु पुत्रेषु भैक्षकाले च लिङ्घिते।\nधार्तराष्ट्रैर्हताश्च स्युर्विज्ञाय कुरुपुङ्गवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2010251, "chapter_id": 1204, "verse_number": "१-२०५-६७", "content_sanskrit": "मायान्वितैर्वा रक्षोभिः सुघोरैर्दृढवैरिभिः।\nविपरीतं मतं जातं व्यासस्यापि महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2010252, "chapter_id": 1204, "verse_number": "१-२०५-६८", "content_sanskrit": "इत्येवं चिन्तयामासं सुतस्नेहावृता पृथा।\nततः सुप्तजनप्राये दुर्दिने मेघसंप्लुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2010253, "chapter_id": 1204, "verse_number": "१-२०५-६९", "content_sanskrit": "महत्यथापराह्णे तु घनैः सूर्य इवावृतः।\nब्राह्मणैः प्राविशत्तत्र जिष्णुर्भार्गववेश्म तत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2010254, "chapter_id": 1204, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि स्वयंवरपर्वणि प़ञ्चाधिकद्विशततमोऽध्यायः॥ २०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}]