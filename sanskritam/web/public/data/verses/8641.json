[{"id": 900008495, "chapter_id": 8641, "verse_number": "22.1", "content_sanskrit": "यद्यप्यक्षरशब्दो वर्णेषु लोकतः प्रसिद्धः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008496, "chapter_id": 8641, "verse_number": "22.2", "content_sanskrit": "अथवा स्वरूपध्वंस इव शरीरवियोगेऽपि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008497, "chapter_id": 8641, "verse_number": "22.3", "content_sanskrit": "केचित्तु न्यायविवरणेऽविनाशित्वं प्रवृत्तिनिमित्तमिति नाभिप्रेतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008498, "chapter_id": 8641, "verse_number": "22.4", "content_sanskrit": "अत्र ‘‘स होवाच एतद्वै तदक्षरं गार्गि ब्राह्मणा अभिवदंत्यस्थूल’’ ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900008499, "chapter_id": 8641, "verse_number": "22.5", "content_sanskrit": "पूर्वपक्षस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900008500, "chapter_id": 8641, "verse_number": "22.6", "content_sanskrit": "सिद्धान्तस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900008501, "chapter_id": 8641, "verse_number": "22.7", "content_sanskrit": "न चाकाशपदस्य प्रसिद्ध्यनुसरणे भूताकाशपरता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900008502, "chapter_id": 8641, "verse_number": "22.8", "content_sanskrit": "दर्वीहोमा यथैवान्ये प्रकृतेर्विकृतेरपि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900008503, "chapter_id": 8641, "verse_number": "22.9", "content_sanskrit": "प्रतिसम्बन्धिना तुल्यदेशे सम्बन्धिनि स्थितेः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900008504, "chapter_id": 8641, "verse_number": "22.10", "content_sanskrit": "अत्तृत्वानशनयोरविरोधस्तु..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900008505, "chapter_id": 8641, "verse_number": "22.11", "content_sanskrit": "अन्ये तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900008506, "chapter_id": 8641, "verse_number": "22.12", "content_sanskrit": "सिद्धान्तोऽप्ययुक्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900008507, "chapter_id": 8641, "verse_number": "22.13", "content_sanskrit": "एतेन यत्केचिज्जडं प्रधानमेवाक्षरमिति पूर्वपक्षयंति तदपि निरस्तम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]