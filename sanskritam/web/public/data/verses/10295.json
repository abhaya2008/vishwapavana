[{"id": 6000295000, "chapter_id": 10295, "verse_number": null, "content_sanskrit": "अथ एकोनशततमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000295001, "chapter_id": 10295, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_099/BhP_10.099.001.m4a", "display_order": 2}, {"id": 6000295002, "chapter_id": 10295, "verse_number": "१०-९९-१", "content_sanskrit": "ततः पर्वण्युपावृत्ते प्रचण्डः पांसुवर्षणः।\nभीमो वायुरभूद् राजन् पूयगन्धश्च सर्वशः॥ १०/९९/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_099/BhP_10.099.002.m4a", "display_order": 3, "topics": [{"text": "पर्वणि बलरामेन बल्वलबधः", "range": "१–६"}]}, {"id": 6000295003, "chapter_id": 10295, "verse_number": "१०-९९-२", "content_sanskrit": "ततोऽमेध्यमयं वर्षं बल्वलेन विनिर्मितम्।\nअभवद् यज्ञशालायां सोऽप्यदृश्यत शूलधृक्॥ १०/९९/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_099/BhP_10.099.003.m4a", "display_order": 4}, {"id": 6000295004, "chapter_id": 10295, "verse_number": "१०-९९-३", "content_sanskrit": "तं विलोक्य बृहत्कायं भिन्नाञ्जनचयोपमम्।\nतप्तताम्रशिखाश्मश्रुदंष्ट्रोग्रभ्रुकुटीमुखम्॥ १०/९९/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_099/BhP_10.099.004.m4a", "display_order": 5}, {"id": 6000295005, "chapter_id": 10295, "verse_number": "१०-९९-४", "content_sanskrit": "सस्मार मुसलं रामः परसैन्यविमर्दनम्।\nहलं च दैत्यदमनं तौ तूर्णमुपतस्थतुः॥ १०/९९/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_099/BhP_10.099.005.m4a", "display_order": 6}, {"id": 6000295006, "chapter_id": 10295, "verse_number": "१०-९९-५", "content_sanskrit": "तमाकृष्य हलाग्रेण बल्वलं गगनेचरम्।\nमुसलेनाहनत् क्रुद्धो मूर्ध्नि ब्रह्मद्रुहं बलः॥ १०/९९/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_099/BhP_10.099.006.m4a", "display_order": 7}, {"id": 6000295007, "chapter_id": 10295, "verse_number": "१०-९९-६", "content_sanskrit": "सोऽपतद् बलनिर्भिण्णललाटोऽसृक् समुत्सृजन्।\nमुञ्चन्नार्तस्वरं शैलो यथा वज्रहतोऽसुरः॥ १०/९९/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_099/BhP_10.099.007.m4a", "display_order": 8}, {"id": 6000295008, "chapter_id": 10295, "verse_number": "१०-९९-७", "content_sanskrit": "संस्तुत्य मुनयो रामं प्रयुज्यापि तथाऽऽशिषः।\nअभ्यषिञ्चन् महार्हाभिर्वृत्रघ्नं विबुधा यथा॥ १०/९९/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_099/BhP_10.099.008.m4a", "display_order": 9, "topics": [{"text": "पुनस्तीर्थयात्राप्रकारः", "range": "७–२२"}]}, {"id": 6000295009, "chapter_id": 10295, "verse_number": "१०-९९-८", "content_sanskrit": "वैजयन्तीं ददुर्मालां श्रीधामाम्लानपङ्कजाम्।\nरामाय वाससी दिव्ये दिव्यान्याभरणानि च॥ १०/९९/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_099/BhP_10.099.009.m4a", "display_order": 10}, {"id": 6000295010, "chapter_id": 10295, "verse_number": "१०-९९-९", "content_sanskrit": "अथ तैरभ्यनुज्ञातः कौशिकीमेत्य ब्राह्मणैः।\nस्नात्वा सरोवरमगाद् यतः सरयुरास्रवत्॥ १०/९९/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_099/BhP_10.099.010.m4a", "display_order": 11}, {"id": 6000295011, "chapter_id": 10295, "verse_number": "१०-९९-१०", "content_sanskrit": "स्रोतेन सरयूं प्रायात् प्रयागमुपगम्य सः।\nस्नात्वा सन्तर्प्य देवादीन् जगाम पुलहाश्रमम्॥ १०/९९/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_099/BhP_10.099.011.m4a", "display_order": 12}, {"id": 6000295012, "chapter_id": 10295, "verse_number": "१०-९९-११", "content_sanskrit": "गोमतीं गण्डकीं स्नात्वा विपाशां शोणमाप्लुतः।\nगयां गत्वा पितॄनिष्ट्वा गङ्गासागरसङ्गमम्॥ १०/९९/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_099/BhP_10.099.012.m4a", "display_order": 13}, {"id": 6000295013, "chapter_id": 10295, "verse_number": "१०-९९-१२", "content_sanskrit": "उपस्पृश्य महेन्द्राद्रौ रामं दृष्ट्वाऽभिवन्द्य तम्।\nसप्तगोदावरीं वेणीं पम्पां भीमरथीं तथा॥ १०/९९/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_099/BhP_10.099.013.m4a", "display_order": 14}, {"id": 6000295014, "chapter_id": 10295, "verse_number": "१०-९९-१३", "content_sanskrit": "स्कन्दं दृष्ट्वा ययौ रामः श्रीशैलं गिरिशालयम्।\nद्रुमिलेषु महापुण्यं दृष्ट्वाऽद्रिं वेङ्कटं प्रभुः॥ १०/९९/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_099/BhP_10.099.014.m4a", "display_order": 15}, {"id": 6000295015, "chapter_id": 10295, "verse_number": "१०-९९-१४", "content_sanskrit": "कामकोष्ठीं पुरीं काञ्चीं कावेरीं च सरिद्वराम्।\nश्रीरङ्गाख्यं महापुण्यं यत्र सन्निहितो हरिः॥ १०/९९/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_099/BhP_10.099.015.m4a", "display_order": 16}, {"id": 6000295016, "chapter_id": 10295, "verse_number": "१०-९९-१५", "content_sanskrit": "ऋषभाद्रिं हरेः क्षेत्रं दक्षिणां मधुरां तथा।\nसमुद्रसेतुमगमन्महापातकनाशनम्॥ १०/९९/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_099/BhP_10.099.016.m4a", "display_order": 17}, {"id": 6000295017, "chapter_id": 10295, "verse_number": "१०-९९-१६", "content_sanskrit": "तत्रायुतमदाद् धेनूर्ब्राह्मणेभ्यो हलायुधः।\nकृतमालां ताम्रपर्णीं मलयं च कुलाचलम्॥ १०/९९/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_099/BhP_10.099.017.m4a", "display_order": 18}, {"id": 6000295018, "chapter_id": 10295, "verse_number": "१०-९९-१७", "content_sanskrit": "तथाऽगस्त्यं समासीनं नमस्कृत्याभिवाद्य च।\nयोजितस्तेन चाशीर्भिरनुज्ञातो गतोऽर्णवम्॥ १०/९९/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_099/BhP_10.099.018.m4a", "display_order": 19}, {"id": 6000295019, "chapter_id": 10295, "verse_number": "१०-९९-१८", "content_sanskrit": "दक्षिणं तत्र कन्याख्यां दुर्गां देवीं ददर्श सः।\nततः फल्गुनमासाद्य पञ्चाप्सरमनुत्तमम्॥ १०/९९/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_099/BhP_10.099.019.m4a", "display_order": 20}, {"id": 6000295020, "chapter_id": 10295, "verse_number": "१०-९९-१९", "content_sanskrit": "विष्णुः सन्निहितो यत्र स्नात्वाऽस्पर्शद् गवायुतम्।\nस्यानन्दूरं हरेः स्थानं यत्र सन्निहितो हरिः॥ १०/९९/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_099/BhP_10.099.020.m4a", "display_order": 21}, {"id": 6000295021, "chapter_id": 10295, "verse_number": "१०-९९-२०", "content_sanskrit": "ततोऽतिव्रज्य भगवान् केरलादींस्‍त्रिगर्तकान्।\nगोकर्णाख्यं शिवक्षेत्रं सान्निध्यं यत्र धूर्जटेः॥ १०/९९/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_099/BhP_10.099.021.m4a", "display_order": 22}, {"id": 6000295022, "chapter_id": 10295, "verse_number": "१०-९९-२१", "content_sanskrit": "तत्र द्वैपायनं दृष्ट्वा शूर्पाकारमगाद् बलः।\nतापीं पयोष्णीं निर्विन्ध्यामुपस्पृश्याथ दण्डकम्॥ १०/९९/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_099/BhP_10.099.022.m4a", "display_order": 23}, {"id": 6000295023, "chapter_id": 10295, "verse_number": "१०-९९-२२", "content_sanskrit": "प्रविश्य रेवामगमद् यत्र माहिष्मती पुरी।\nअनुतीर्थमुपस्पृश्य प्रभासं पुनरागमत्॥ १०/९९/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_099/BhP_10.099.023.m4a", "display_order": 24}, {"id": 6000295024, "chapter_id": 10295, "verse_number": "१०-९९-२३", "content_sanskrit": "श्रुत्वा द्विजैस्तु कथितं कुरुपाण्डवसंयुगम्।\nसर्वराजन्यनिधनं भारमेतद् हृतं भुवः॥ १०/९९/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_099/BhP_10.099.024.m4a", "display_order": 25, "topics": [{"text": "भीमदुर्योधनयोर्गदायुद्धसमये कुरुक्षेत्रप्रातिः", "range": "२३–२८"}]}, {"id": 6000295025, "chapter_id": 10295, "verse_number": "१०-९९-२४", "content_sanskrit": "स भीमदुर्योधनयोर्गदाभ्यां युध्यतो रणम्।\nवारयिष्यन् विशसनं जगाम यदुनन्दनः॥ १०/९९/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_099/BhP_10.099.025.m4a", "display_order": 26}, {"id": 6000295026, "chapter_id": 10295, "verse_number": "१०-९९-२५", "content_sanskrit": "युधिष्ठरस्तु तं दृष्ट्वा यमौ कृष्णार्जुनावपि।\nअभिवन्द्याभवंस्तूष्णीं किं विवक्षुरिहागतः॥ १०/९९/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_099/BhP_10.099.026.m4a", "display_order": 27}, {"id": 6000295027, "chapter_id": 10295, "verse_number": "१०-९९-२६", "content_sanskrit": "गदापाणी उभौ दृष्ट्वा संरब्धौ विजयेषिणौ।\nमण्डलानि विचित्राणि चरन्ताविदमब्रवीत्॥ १०/९९/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_099/BhP_10.099.027.m4a", "display_order": 28}, {"id": 6000295028, "chapter_id": 10295, "verse_number": "१०-९९-२७", "content_sanskrit": "युवां तुल्यबलौ वीरौ हे राजन् हे वृकोदर।\nएकं प्राणाधिकं मन्य उतैकं शिक्षयाऽधिकम्॥ १०/९९/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_099/BhP_10.099.028.m4a", "display_order": 29}, {"id": 6000295029, "chapter_id": 10295, "verse_number": "१०-९९-२८", "content_sanskrit": "तस्मादेकतरस्येह युवयोः समवीर्ययोः।\nन लक्ष्यते जयोऽन्यो वा विरमत्वफलो रणः॥ १०/९९/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_099/BhP_10.099.029.m4a", "display_order": 30}, {"id": 6000295030, "chapter_id": 10295, "verse_number": "१०-९९-२९", "content_sanskrit": "न तद्वाक्यं जगृहतुर्बद्धवैरौ नृपार्थवत्।\nअनुस्मरन्तावन्योन्यं दुरुक्तं दुष्कृतानि च॥ १०/९९/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_099/BhP_10.099.030.m4a", "display_order": 31, "topics": [{"text": "अनादृतहितवचनस्य तस्य द्वारकागमनम्", "range": "२९–३१"}]}, {"id": 6000295031, "chapter_id": 10295, "verse_number": "१०-९९-३०", "content_sanskrit": "दिष्टं तदनुमन्वानो रामो द्वारवतीं ययौ।\nउग्रसेनादिभिः प्रीतैर्ज्ञातिभिः समुपागतः॥ १०/९९/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_099/BhP_10.099.031.m4a", "display_order": 32}, {"id": 6000295032, "chapter_id": 10295, "verse_number": "१०-९९-३१", "content_sanskrit": "ईदृग्विधान्यसङ्ख्यानि बलस्य बलशालिनः। अनन्तस्याप्रेमयस्य कर्माण्यद्भुतकर्मणः।\nशृणवन् गृणंश्च तद्भक्त्या विष्णोः स दयितो भवेत्॥ १०/९९/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_099/BhP_10.099.032.m4a", "display_order": 33}, {"id": 6000295033, "chapter_id": 10295, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्ध एकोनशततमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]