[{"id": 5000458000, "chapter_id": 9458, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे एकपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000458001, "chapter_id": 9458, "verse_number": "६-५१-१", "content_sanskrit": "तेषां तु तुमुलं शब्दं वानराणां महौजसाम्।\nनर्दतां राक्षसैः सार्धं तदा शुश्राव रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000458002, "chapter_id": 9458, "verse_number": "६-५१-२", "content_sanskrit": "स्निग्धगम्भीरनिर्घोषं श्रुत्वा तं निनदं भृशम्।\nसचिवानां ततस्तेषां मध्ये वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000458003, "chapter_id": 9458, "verse_number": "६-५१-३", "content_sanskrit": "यथासौ सम्प्रहृष्टानां वानराणामुपस्थितः।\nबहूनां सुमहान् नादो मेघानामिव गर्जताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000458004, "chapter_id": 9458, "verse_number": "६-५१-४", "content_sanskrit": "सुव्यक्तं महती प्रीतिरेतेषां नात्र संशयः।\nतथाहि विपुलैर्नादैश्चुक्षुभे लवणार्णवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000458005, "chapter_id": 9458, "verse_number": "६-५१-५", "content_sanskrit": "तौ तु बद्धौ शरैस्तीक्ष्णैर्भ्रातरौ रामलक्ष्मणौ।\nअयं च सुमहान् नादः शङ्कां जनयतीव मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000458006, "chapter_id": 9458, "verse_number": "६-५१-६", "content_sanskrit": "एवं च वचनं चोक्त्वा मन्त्रिणो राक्षसेश्वरः।\nउवाच नैर्ऋतांस्तत्र समीपपरिवर्तिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000458007, "chapter_id": 9458, "verse_number": "६-५१-७", "content_sanskrit": "ज्ञायतां तूर्णमेतेषां सर्वेषां च वनौकसाम्।\nशोककाले समुत्पन्ने हर्षकारणमुत्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000458008, "chapter_id": 9458, "verse_number": "६-५१-८", "content_sanskrit": "तथोक्तास्ते सुसम्भ्रान्ताः प्राकारमधिरुह्य च।\nददृशुः पालितां सेनां सुग्रीवेण महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000458009, "chapter_id": 9458, "verse_number": "६-५१-९", "content_sanskrit": "तौ च मुक्तौ सुघोरेण शरबन्धेन राघवौ।\nसमुत्थितौ महाभागौ विषेदुः सर्वराक्षसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000458010, "chapter_id": 9458, "verse_number": "६-५१-१०", "content_sanskrit": "संत्रस्तहृदयाः सर्वे प्राकारादवरुह्य ते।\nविवर्णा राक्षसा घोरा राक्षसेन्द्रमुपस्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000458011, "chapter_id": 9458, "verse_number": "६-५१-११", "content_sanskrit": "तदप्रियं दीनमुखा रावणस्य च राक्षसाः।\nकृत्स्नं निवेदयामासुर्यथावद् वाक्यकोविदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000458012, "chapter_id": 9458, "verse_number": "६-५१-१२", "content_sanskrit": "यौ ताविन्द्रजिता युद्धे भ्रातरौ रामलक्ष्मणौ।\nनिबद्धौ शरबन्धेन निष्प्रकम्पभुजौ कृतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000458013, "chapter_id": 9458, "verse_number": "६-५१-१३", "content_sanskrit": "विमुक्तौ शरबन्धेन दृश्येते तौ रणाजिरे।\nपाशानिव गजौ छित्त्वा गजेन्द्रसमविक्रमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000458014, "chapter_id": 9458, "verse_number": "६-५१-१४", "content_sanskrit": "तच्छ्रुत्वा वचनं तेषां राक्षसेन्द्रो महाबलः।\nचिन्ताशोकसमाक्रान्तो विवर्णवदनोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000458015, "chapter_id": 9458, "verse_number": "६-५१-१५", "content_sanskrit": "घोरैर्दत्तवरैर्बद्धौ शरैराशीविषोपमैः।\nअमोघैः सूर्यसंकाशैः प्रमथ्येन्द्रजिता युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000458016, "chapter_id": 9458, "verse_number": "६-५१-१६", "content_sanskrit": "तदस्त्रबन्धमासाद्य यदि मुक्तौ रिपू मम।\nसंशयस्थमिदं सर्वमनुपश्याम्यहं बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000458017, "chapter_id": 9458, "verse_number": "६-५१-१७", "content_sanskrit": "निष्फलाः खलु संवृत्ताः शराः पावकतेजसः।\nआदत्तं यैस्तु संग्रामे रिपूणां जीवितं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000458018, "chapter_id": 9458, "verse_number": "६-५१-१८", "content_sanskrit": "एवमुक्त्वा तु संक्रुद्धो निःश्वसन्नुरगो यथा।\nअब्रवीद् रक्षसां मध्ये धूम्राक्षं नाम राक्षसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000458019, "chapter_id": 9458, "verse_number": "६-५१-१९", "content_sanskrit": "बलेन महता युक्तो रक्षसां भीमविक्रम।\nत्वं वधायाशु निर्याहि रामस्य सह वानरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000458020, "chapter_id": 9458, "verse_number": "६-५१-२०", "content_sanskrit": "एवमुक्तस्तु धूम्राक्षो राक्षसेन्द्रेण धीमता।\nपरिक्रम्य ततः शीघ्रं निर्जगाम नृपालयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000458021, "chapter_id": 9458, "verse_number": "६-५१-२१", "content_sanskrit": "अभिनिष्क्रम्य तद् द्वारं बलाध्यक्षमुवाच ह।\nत्वरयस्व बलं शीघ्रं किं चिरेण युयुत्सतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000458022, "chapter_id": 9458, "verse_number": "६-५१-२२", "content_sanskrit": "धूम्राक्षवचनं श्रुत्वा बलाध्यक्षो बलानुगः।\nबलमुद्योजयामास रावणस्याज्ञया भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000458023, "chapter_id": 9458, "verse_number": "६-५१-२३", "content_sanskrit": "ते बद्धघण्टा बलिनो घोररूपा निशाचराः।\nविनद्यमानाः संहृष्टा धूम्राक्षं पर्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000458024, "chapter_id": 9458, "verse_number": "६-५१-२४", "content_sanskrit": "विविधायुधहस्ताश्च शूलमुद‍्ग‍रपाणयः।\nगदाभिः पट्टिशैर्दण्डैरायसैर्मुसलैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000458025, "chapter_id": 9458, "verse_number": "६-५१-२५", "content_sanskrit": "परिघैर्भिन्दिपालैश्च भल्लैः पाशैः परश्वधैः।\nनिर्ययू राक्षसा घोरा नर्दन्तो जलदा यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000458026, "chapter_id": 9458, "verse_number": "६-५१-२६", "content_sanskrit": "रथैः कवचिनस्त्वन्ये ध्वजैश्च समलंकृतैः।\nसुवर्णजालविहितैः खरैश्च विविधाननैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000458027, "chapter_id": 9458, "verse_number": "६-५१-२७", "content_sanskrit": "हयैः परमशीघ्रैश्च गजैश्चैव मदोत्कटैः।\nनिर्ययुर्नैर्ऋतव्याघ्रा व्याघ्रा इव दुरासदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000458028, "chapter_id": 9458, "verse_number": "६-५१-२८", "content_sanskrit": "वृकसिंहमुखैर्युक्तं खरैः कनकभूषितैः।\nआरुरोह रथं दिव्यं धूम्राक्षः खरनिःस्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000458029, "chapter_id": 9458, "verse_number": "६-५१-२९", "content_sanskrit": "स निर्यातो महावीर्यो धूम्राक्षो राक्षसैर्वृतः।\nहसन् वै पश्चिमद्वाराद्धनूमान् यत्र तिष्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000458030, "chapter_id": 9458, "verse_number": "६-५१-३०", "content_sanskrit": "रथप्रवरमास्थाय खरयुक्तं खरस्वनम्।\nप्रयान्तं तु महाघोरं राक्षसं भीमदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000458031, "chapter_id": 9458, "verse_number": "६-५१-३१", "content_sanskrit": "अन्तरिक्षगताः क्रूराः शकुनाः प्रत्यषेधयन्।\nरथशीर्षे महाभीमो गृध्रश्च निपपात ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000458032, "chapter_id": 9458, "verse_number": "६-५१-३२", "content_sanskrit": "ध्वजाग्रे ग्रथिताश्चैव निपेतुः कुणपाशनाः।\nरुधिरार्द्रो महान् श्वेतः कबन्धः पतितो भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000458033, "chapter_id": 9458, "verse_number": "६-५१-३३", "content_sanskrit": "विस्वरं चोत्सृजन्नादान् धूम्राक्षस्य निपातितः।\nववर्ष रुधिरं देवः संचचाल च मेदिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000458034, "chapter_id": 9458, "verse_number": "६-५१-३४", "content_sanskrit": "प्रतिलोमं ववौ वायुर्निर्घातसमनिःस्वनः।\nतिमिरौघावृतास्तत्र दिशश्च न चकाशिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000458035, "chapter_id": 9458, "verse_number": "६-५१-३५", "content_sanskrit": "स तूत्पातांस्ततो दृष्ट्वा राक्षसानां भयावहान्।\nप्रादुर्भूतान् सुघोरांश्च धूम्राक्षो व्यथितोऽभवत्।\nमुमुहू राक्षसाः सर्वे धूम्राक्षस्य पुरःसराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000458036, "chapter_id": 9458, "verse_number": "६-५१-३६", "content_sanskrit": "ततः सुभीमो बहुभिर्निशाचरै-\nर्वृतोऽभिनिष्क्रम्य रणोत्सुको बली।\nददर्श तां राघवबाहुपालितां\nमहौघकल्पां बहु वानरीं चमूम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000458037, "chapter_id": 9458, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे एकपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]