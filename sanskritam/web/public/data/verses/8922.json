[{"id": 40004624, "chapter_id": 8922, "verse_number": "1", "content_sanskrit": "प्रतिबुद्धो मुहूर्तेन शोकोपहतचेतनः। अथ राजा दशरथस्सचिन्तामभ्यपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40004625, "chapter_id": 8922, "verse_number": "2", "content_sanskrit": "रामलक्ष्मणयोश्चैव विवासा द्वासवोपमम्। आविवेशोपसर्गस्तं तम स्सूर्यमिवासुरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40004626, "chapter_id": 8922, "verse_number": "3", "content_sanskrit": "सभार्ये निर्गते रामे कौसल्यां कोशलेश्वरः। विवक्षुरसितापाङ्गां स्मृत्वा दुष्कृतमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40004627, "chapter_id": 8922, "verse_number": "4", "content_sanskrit": "स राजा रजनीं षष्ठीं रामे प्रव्राजिते वनम्। अर्धरात्रे दशरथ स्संस्मरन् दुष्कृतं कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40004628, "chapter_id": 8922, "verse_number": "5", "content_sanskrit": "स राजा पुत्रशोकार्तः स्मृत्वा दुष्कृतमात्मनः। कौसल्यां पुत्रशोकार्तामिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40004629, "chapter_id": 8922, "verse_number": "6", "content_sanskrit": "यदाचरति कल्याणि शुभं वा यदि वाऽशुभम्। तदेव लभते भद्रे कर्ता कर्मजमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40004630, "chapter_id": 8922, "verse_number": "7", "content_sanskrit": "गुरुलाघवमर्थानामारम्भे कर्मणां फलम्। दोषं वा यो न जानाति न बाल इति होच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40004631, "chapter_id": 8922, "verse_number": "8", "content_sanskrit": "कश्चिदाम्रवणं छित्त्वा पलाशां श्च निषिञ्चति। पुष्पं दृष्ट्वा फले गृध्नु स्स शोचति फलागमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40004632, "chapter_id": 8922, "verse_number": "9", "content_sanskrit": "अविज्ञाय फलं यो हि कर्म त्वेवानुधावति। स शोचेत्फलवेलायां यथा किंशुकसेचकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40004633, "chapter_id": 8922, "verse_number": "10", "content_sanskrit": "सोऽहमाम्रवणं छित्वा पलाशांश्च न्यषेचयम्। रामं फलागमे त्यक्त्वा पश्चाच्छोचामि दुर्मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40004634, "chapter_id": 8922, "verse_number": "11", "content_sanskrit": "लब्धशब्देन कौसल्ये कुमारेण धनुष्मता। कुमारश्शब्दवेधीति मया पापमिदं कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40004635, "chapter_id": 8922, "verse_number": "12", "content_sanskrit": "तदिदं मेऽनुसंम्प्राप्तं देवि दुःखं स्वयं कृतम्। सम्मोहादिह बालेन यथा स्याद्भक्षितं विषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40004636, "chapter_id": 8922, "verse_number": "13", "content_sanskrit": "यथान्यः पुरुषः कश्चित्पलाशैर्मोहितो भवेत्। एवं ममाऽप्यविज्ञातं शब्दवेध्यमयं फलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40004637, "chapter_id": 8922, "verse_number": "14", "content_sanskrit": "देव्यनूढा त्वमभवो युवराजो भवाम्यहम्। ततः प्रावृडनुप्राप्ता मदकामविवर्धिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40004638, "chapter_id": 8922, "verse_number": "15", "content_sanskrit": "उपास्य च रसान्भौमां स्तप्त्वा च जगदंशुभिः। परेताचरितां भीमां रविराविशते दिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40004639, "chapter_id": 8922, "verse_number": "16", "content_sanskrit": "उष्णमन्तर्दधे सद्य स्स्निग्धा ददृशिरे घनाः। ततो जहृषिरे सर्वे भेकसारङ्गबर्हिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40004640, "chapter_id": 8922, "verse_number": "17", "content_sanskrit": "क्लिन्न पक्षोत्तरास्स्नाताः कृच्छ्रादिव पतत्रिणः। वृष्टिवातावधूताग्रान्पादपानभिपेदिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40004641, "chapter_id": 8922, "verse_number": "18", "content_sanskrit": "पतितेनाम्भसाच्छन्नः पतमानेन चासकृत्। आबभौ मत्तसारङ्गस्तोयराशिरिवाचलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40004642, "chapter_id": 8922, "verse_number": "19", "content_sanskrit": "पाण्डुरारुणवर्णानि स्रोतांसि विमलान्यपि। सुस्रुवुर्गिरिधातुभ्यस्सभस्मानि भुजङ्गवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40004643, "chapter_id": 8922, "verse_number": "20", "content_sanskrit": "आकुलारुण तोयानि स्रोतांसि विमलान्यपि। उन्मार्गजलवाहिनी बभूवुर्जलदागमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40004644, "chapter_id": 8922, "verse_number": "21", "content_sanskrit": "तस्मिन्नतिसुखे काले धनुष्मानिषुमान्रथी। व्यायामकृतसङ्कल्पस्सरयूमन्वगां नदीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40004645, "chapter_id": 8922, "verse_number": "22", "content_sanskrit": "निपाने महिषं रात्रौ गजं वाऽभ्यागतं नदीम्। अन्यं वा श्वापदं कञ्चिज्जिघांसु रजितेन्द्रियः। तस्मिं स्तत्राहमेकान्ते रात्रौ विवृतकार्मुकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40004646, "chapter_id": 8922, "verse_number": "23", "content_sanskrit": "तत्राहं संवृतं वन्यं हतवांस्तीरमागतम्। अन्यं चापि मृगं हिंस्रं शब्दं श्रुत्वाऽभ्युपागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40004647, "chapter_id": 8922, "verse_number": "24", "content_sanskrit": "अथान्धकारे त्वश्रौषं जले कुम्भस्य पूर्यतः। अचक्षुर्विषये घोषं वारणस्येव नर्दतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40004648, "chapter_id": 8922, "verse_number": "25", "content_sanskrit": "ततोऽहं शरमुधृत्य दीप्तमाशीविषोपमम्। शब्दं प्रति गजप्रेप्सुरभिलक्ष्य त्वपातयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40004649, "chapter_id": 8922, "verse_number": "26", "content_sanskrit": "अमुञ्चं निशितं बाणमहमाशीविषोपमम्। तत्र वागुषसि व्यक्ता प्रादुरासीद्वनौकसः ॥ हाहेति पततस्तोये बाणाभिहतमर्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40004650, "chapter_id": 8922, "verse_number": "27", "content_sanskrit": "अमुञ्चं निशितं बाणमहमाशीविषोपमम्। तत्र वागुषसि व्यक्ता प्रादुरासीद्वनौकसः ॥ हाहेति पततस्तोये बाणाभिहतमर्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40004651, "chapter_id": 8922, "verse_number": "28", "content_sanskrit": "तस्मिन्निपतिते बाणे वागभूत्तत्र मानुषी। कथमस्मद्विधे शस्त्रं निपतेत्तु तपस्विनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40004652, "chapter_id": 8922, "verse_number": "29", "content_sanskrit": "प्रविविक्तां नदीं रात्रावुदाहाऽरोहमागतः। इषुणाऽभिहतः केन कस्य वा किं कृतं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40004653, "chapter_id": 8922, "verse_number": "30", "content_sanskrit": "ऋषेर्हिन्यस्तदण्डस्य वने वन्येन जीवतः। कथं नु शस्रेण वधो मद्विधस्य विधीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40004654, "chapter_id": 8922, "verse_number": "31", "content_sanskrit": "जटाभारधरस्यैव वल्कलाजिनवाससः। को वधेन ममर्थी स्यात्किंवाऽस्यापकृतं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40004655, "chapter_id": 8922, "verse_number": "32", "content_sanskrit": "एवं निष्फलमारब्धं केवलानर्थसंहितम्। न कश्चित्साधु मन्येत यथैव गुरुतल्पगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40004656, "chapter_id": 8922, "verse_number": "33", "content_sanskrit": "नाहं तथाऽनु शोचामि जीवितक्षयमात्मनः। मातरं पितरं चोभावनुशोचामि मद्वधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40004657, "chapter_id": 8922, "verse_number": "34", "content_sanskrit": "तदेतन्मिथुनं वृद्धं चिरकालभृतं मया। मयि पञ्चत्वमापन्ने कां वृत्तिं वर्तयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40004658, "chapter_id": 8922, "verse_number": "35", "content_sanskrit": "वृद्धै च मतापितरावहं चैकेषुणा हता। केन स्मनिहता स्सर्वे सुबालेनाकृतात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40004659, "chapter_id": 8922, "verse_number": "36", "content_sanskrit": "तां गिरं करुणां श्रुत्वा मम धर्मानुकाङ्क्षिणः। कराभ्यां सशरं चापं व्यथितस्यापतद्भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40004660, "chapter_id": 8922, "verse_number": "37", "content_sanskrit": "तस्याहं करुणं श्रुत्वा निशि लालवतो बहु। सम्भ्रान्त श्शोकवेगेन भृशमासं विचेतनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40004661, "chapter_id": 8922, "verse_number": "38", "content_sanskrit": "तं देशमहमागम्य दीनसत्त्वस्सुदुर्मनाः। अपश्यमिषुणा तीरे सरय्वास्तापसं हतम् ॥ अवकीर्ण जटाभारं प्रविद्धकलशोदकम्। पांसुशोणितदिग्धाङ्गं शयानं शल्यपीडितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40004662, "chapter_id": 8922, "verse_number": "39", "content_sanskrit": "तं देशमहमागम्य दीनसत्त्वस्सुदुर्मनाः। अपश्यमिषुणा तीरे सरय्वास्तापसं हतम् ॥ अवकीर्ण जटाभारं प्रविद्धकलशोदकम्। पांसुशोणितदिग्धाङ्गं शयानं शल्यपीडितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40004663, "chapter_id": 8922, "verse_number": "40", "content_sanskrit": "स मामुद्वीक्ष्य नेत्राभ्यां त्रस्तमस्वस्थचेतसम्। इत्युवाच ततः क्रूरं दिधक्षन्निव तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40004664, "chapter_id": 8922, "verse_number": "41", "content_sanskrit": "किं तवापकृतं राजन्वने निवसता मया। जिहीर्षुरम्भो गुर्वुर्थं यदहं ताडितस्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40004665, "chapter_id": 8922, "verse_number": "42", "content_sanskrit": "एकेन खलु बाणेन मर्मण्यभिहते मयि। द्वावन्धौ निहतौ वृद्धौ माता जनयिता च मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40004666, "chapter_id": 8922, "verse_number": "43", "content_sanskrit": "तौ कथं दुर्बलावन्धौ मत्प्रतीक्षौ पिपासितौ। चिरमाशाकृतां तृष्णां कष्टां सन्धारयिष्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40004667, "chapter_id": 8922, "verse_number": "44", "content_sanskrit": "न नूनं तपसो वास्ति फलयोगश्श्रुतस्य वा। पिता यन्मां न जानाति शयानं पतितं भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40004668, "chapter_id": 8922, "verse_number": "45", "content_sanskrit": "जानन्नपि च किं कुर्यादशक्तिरपरिक्रमः। भिद्यमानमिवाशक्त स्त्रतुमन्यो नगो नगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 40004669, "chapter_id": 8922, "verse_number": "46", "content_sanskrit": "पितुस्त्वमेव मे गत्वा शीघ्रमाचक्ष्य राघव। न त्वामनुदहेत्क्रुद्धो वनं वह्निरिवैधितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 40004670, "chapter_id": 8922, "verse_number": "47", "content_sanskrit": "इयमेकपदी राजन्यतो मे पितुराश्रमः। तं प्रसादय गत्वा त्वं न त्वां स कुपितश्शपेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 40004671, "chapter_id": 8922, "verse_number": "48", "content_sanskrit": "विशल्यं कुरु मां राजन्मर्म मे निशितश्शरः। रुणद्धि मृदुसोत्सेधं तीरमम्बुरयो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 40004672, "chapter_id": 8922, "verse_number": "49", "content_sanskrit": "सशल्यः क्लिश्यते प्राणैर्विशल्यो विनशिष्यति। इति मामविशच्चिन्ता तस्य शल्यापकर्षणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 40004673, "chapter_id": 8922, "verse_number": "50", "content_sanskrit": "दुःखितस्य च दीनस्य मम शोकातुरस्य च। लक्षयामास हृदये चिन्तां मुनिसुतस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 40004674, "chapter_id": 8922, "verse_number": "51", "content_sanskrit": "ताम्यमानस्स मां कृच्छ्रादुवाच परमार्तवत्। सीदमानो विवृत्ताङ्गो वेष्टमानो गतः क्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 40004675, "chapter_id": 8922, "verse_number": "52", "content_sanskrit": "संस्तभ्य शोकं धैर्येण स्थिरचित्तो भवाम्यहम्। ब्रह्महत्याकृतं पापं हृदयादपनीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 40004676, "chapter_id": 8922, "verse_number": "53", "content_sanskrit": "न द्विजातिरहं राजन्मा भूत्ते मनसो व्यथा। शूद्रायामस्मि वैश्येन जातो जनपदाधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]