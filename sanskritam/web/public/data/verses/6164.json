[
  {
    "id": 16764001,
    "chapter_id": 6164,
    "verse_number": "16.1",
    "content_sanskrit": "श्रीभगवानुवाच —",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "base_unit_id": "BG_C16_V01"
  },
  {
    "id": 16764002,
    "chapter_id": 6164,
    "verse_number": "16.2",
    "content_sanskrit": "अहिंसा सत्यमक्रोधस्त्यागः शान्तिरपैशुनम् ।\nदया भूतेष्वलोलुप्त्वं मार्दवं ह्रीरचापलम् ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "base_unit_id": "BG_C16_V02"
  },
  {
    "id": 16764003,
    "chapter_id": 6164,
    "verse_number": "16.3",
    "content_sanskrit": "तेजः क्षमा धृतिः शौचमद्रोहो नातिमानिता ।\nभवन्ति सम्पदं दैवीमभिजातस्य भारत ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "base_unit_id": "BG_C16_V03"
  },
  {
    "id": 16764004,
    "chapter_id": 6164,
    "verse_number": "16.4",
    "content_sanskrit": "दम्भो दर्पोऽतिमानश्च क्रोधः पारुष्यमेव च ।\nअज्ञानं चाभिजातस्य पार्थ सम्पदमासुरीम् ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "base_unit_id": "BG_C16_V04"
  },
  {
    "id": 16764005,
    "chapter_id": 6164,
    "verse_number": "16.5",
    "content_sanskrit": "दैवी सम्पद्विमोक्षाय निबन्धायासुरी मता ।\nमा शुचः सम्पदं दैवीमभिजातोऽसि पाण्डव ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "base_unit_id": "BG_C16_V05"
  },
  {
    "id": 16764006,
    "chapter_id": 6164,
    "verse_number": "16.6",
    "content_sanskrit": "द्वौ भूतसर्गौ लोकेऽस्मिन्दैव आसुर एव च ।\nदैवो विस्तरशः प्रोक्त आसुरं पार्थ मे शृणु ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "base_unit_id": "BG_C16_V06"
  },
  {
    "id": 16764007,
    "chapter_id": 6164,
    "verse_number": "16.7",
    "content_sanskrit": "प्रवृत्तिं च निवृत्तिं च जना न विदुरासुराः ।\nन शौचं नापि चाचारो न सत्यं तेषु विद्यते ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "base_unit_id": "BG_C16_V07"
  },
  {
    "id": 16764008,
    "chapter_id": 6164,
    "verse_number": "16.8",
    "content_sanskrit": "असत्यमप्रतिष्ठं ते जगदाहुरनीश्वरम् ।\nअपरस्परसम्भूतं किमन्यत्कामहैतुकम् ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "base_unit_id": "BG_C16_V08"
  },
  {
    "id": 16764009,
    "chapter_id": 6164,
    "verse_number": "16.9",
    "content_sanskrit": "एतां दृष्टिमवष्टभ्य नष्टात्मानोऽल्पबुद्धयः ।\nप्रभवन्त्युग्रकर्माणः क्षयाय जगतोऽहिताः ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "base_unit_id": "BG_C16_V09"
  },
  {
    "id": 16764010,
    "chapter_id": 6164,
    "verse_number": "16.10",
    "content_sanskrit": "काममाश्रित्य दुष्पूरं दम्भमानमदान्विताः ।\nमोहाद्गृहीत्वासद्ग्राहान्प्रवर्तन्तेऽशुचिव्रताः ॥ १० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "base_unit_id": "BG_C16_V10"
  },
  {
    "id": 16764011,
    "chapter_id": 6164,
    "verse_number": "16.11",
    "content_sanskrit": "चिन्तामपरिमेयां च प्रलयान्तामुपाश्रिताः ।\nकामोपभोगपरमा एतावदिति निश्चिताः ॥ ११ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "base_unit_id": "BG_C16_V11"
  },
  {
    "id": 16764012,
    "chapter_id": 6164,
    "verse_number": "16.12",
    "content_sanskrit": "आशापाशशतैर्बद्धाः कामक्रोधपरायणाः ।\nईहन्ते कामभोगार्थमन्यायेनार्थसञ्चयान् ॥ १२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "base_unit_id": "BG_C16_V12"
  },
  {
    "id": 16764013,
    "chapter_id": 6164,
    "verse_number": "16.13",
    "content_sanskrit": "इदमद्य मया लब्धमिदं प्राप्स्ये मनोरथम् ।\nइदमस्तीदमपि मे भविष्यति पुनर्धनम् ॥ १३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "base_unit_id": "BG_C16_V13"
  },
  {
    "id": 16764014,
    "chapter_id": 6164,
    "verse_number": "16.14",
    "content_sanskrit": "असौ मया हतः शत्रुर्हनिष्ये चापरानपि ।\nईश्वरोऽहमहं भोगी सिद्धोऽहं बलवान्सुखी ॥ १४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "base_unit_id": "BG_C16_V14"
  },
  {
    "id": 16764015,
    "chapter_id": 6164,
    "verse_number": "16.15",
    "content_sanskrit": "आढ्योऽभिजनवानस्मि\nकोऽन्योऽस्ति सदृशो मया ।\nयक्ष्ये दास्यामि मोदिष्य\nइत्यज्ञानविमोहिताः ॥ १५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "base_unit_id": "BG_C16_V15"
  },
  {
    "id": 16764016,
    "chapter_id": 6164,
    "verse_number": "16.16",
    "content_sanskrit": "अनेकचित्तविभ्रान्ता मोहजालसमावृताः ।\nप्रसक्ताः कामभोगेषु पतन्ति नरकेऽशुचौ ॥ १६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "base_unit_id": "BG_C16_V16"
  },
  {
    "id": 16764017,
    "chapter_id": 6164,
    "verse_number": "16.17",
    "content_sanskrit": "आत्मसम्भाविताः स्तब्धा धनमानमदान्विताः ।\nयजन्ते नामयज्ञैस्ते दम्भेनाविधिपूर्वकम् ॥ १७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "base_unit_id": "BG_C16_V17"
  },
  {
    "id": 16764018,
    "chapter_id": 6164,
    "verse_number": "16.18",
    "content_sanskrit": "अहङ्कारं बलं दर्पं कामं क्रोधं च संश्रिताः ।\nमामात्मपरदेहेषु प्रद्विषन्तोऽभ्यसूयकाः ॥ १८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "base_unit_id": "BG_C16_V18"
  },
  {
    "id": 16764019,
    "chapter_id": 6164,
    "verse_number": "16.19",
    "content_sanskrit": "तानहं द्विषतः क्रूरान्संसारेषु नराधमान् ।\nक्षिपाम्यजस्रमशुभानासुरीष्वेव योनिषु ॥ १९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "base_unit_id": "BG_C16_V19"
  },
  {
    "id": 16764020,
    "chapter_id": 6164,
    "verse_number": "16.20",
    "content_sanskrit": "आसुरीं योनिमापन्ना\nमूढा जन्मनि जन्मनि ।\nमामप्राप्यैव कौन्तेय\nततो यान्त्यधमां गतिम् ॥ २० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "base_unit_id": "BG_C16_V20"
  },
  {
    "id": 16764021,
    "chapter_id": 6164,
    "verse_number": "16.21",
    "content_sanskrit": "त्रिविधं नरकस्येदं द्वारं नाशनमात्मनः ।\nकामः क्रोधस्तथा लोभस्तस्मादेतत्त्रयं त्यजेत् ॥ २१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "base_unit_id": "BG_C16_V21"
  },
  {
    "id": 16764022,
    "chapter_id": 6164,
    "verse_number": "16.22",
    "content_sanskrit": "एतैर्विमुक्तः कौन्तेय तमोद्वारैस्त्रिभिर्नरः ।\nआचरत्यात्मनः श्रेयस्ततो याति परां गतिम् ॥ २२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "base_unit_id": "BG_C16_V22"
  },
  {
    "id": 16764023,
    "chapter_id": 6164,
    "verse_number": "16.23",
    "content_sanskrit": "यः शास्त्रविधिमुत्सृज्य\nवर्तते कामकारतः ।\nन स सिद्धिमवाप्नोति\nन सुखं न परां गतिम् ॥ २३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "base_unit_id": "BG_C16_V23"
  },
  {
    "id": 16764024,
    "chapter_id": 6164,
    "verse_number": "16.24",
    "content_sanskrit": "तस्माच्छास्त्रं प्रमाणं ते\nकार्याकार्यव्यवस्थितौ ।\nज्ञात्वा शास्त्रविधानोक्तं\nकर्म कर्तुमिहार्हसि ॥ २४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "base_unit_id": "BG_C16_V24"
  }
]