[{"id": 7006121000, "chapter_id": 26121, "verse_number": "३-१६-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nमहालक्ष्म्याः स्वरूपं च अवतारान्खगेश्वर ।\nशृणु सम्यङ्महाभाग तज्ज्ञानस्य विनिर्णयम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006121001, "chapter_id": 26121, "verse_number": "३-१६-२", "content_sanskrit": "ईशादन्यस्य जगतो ह्यात्मो लोचन एव तु ।\nविषयीकुरुते तत्स्याज्ज्ञानं लक्ष्म्याः प्रकीर्तितम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006121002, "chapter_id": 26121, "verse_number": "३-१६-३", "content_sanskrit": "नित्यावियोगिनी देवी हरिपादैकसंश्रया ।\nनित्यमुक्ता नित्यबुद्धा महालक्ष्मीः प्रकीर्तिता ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006121003, "chapter_id": 26121, "verse_number": "३-१६-४", "content_sanskrit": "मूलस्य च हरेर्भार्या लक्ष्मीः संप्रकीर्तिता ।\nपुंसो हिभार्या प्रकृतिः प्रकृतेश्चा भिमानिनी ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006121004, "chapter_id": 26121, "verse_number": "३-१६-५", "content_sanskrit": "सृष्टिं कर्तुं गुणान्वीन्द्र पुरुषेण सह प्रभो ।\nतमः पानं तथा कर्तुं प्रकृत्याख्या तदाभवत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006121005, "chapter_id": 26121, "verse_number": "३-१६-६", "content_sanskrit": "वासुदेवस्य भार्या तु माया नाम्नी प्रकीर्तिता ।\nसंकर्षणस्य भार्या तु जयेति परिकीर्तिता ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006121006, "chapter_id": 26121, "verse_number": "३-१६-७", "content_sanskrit": "अनिरुद्धस्य भार्या तु शान्ता नाम्नीति कीर्तिता ।\nकृतिः प्रद्युम्नभार्यापिं सृष्टिं कर्तुं बभूवह ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006121007, "chapter_id": 26121, "verse_number": "३-१६-८", "content_sanskrit": "विष्णुपत्नी कीर्तिता च श्रीदेवी सत्त्वमानिनी ।\nतमोभिमानिनी दुर्गा कन्यकेति प्रकीर्तिता ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006121008, "chapter_id": 26121, "verse_number": "३-१६-९", "content_sanskrit": "कृष्णावतारे कन्येव नन्दपुत्रानुजा हि सा ।\nरजोभिमानिभूदेवी भार्या सा सूकरस्य च ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006121009, "chapter_id": 26121, "verse_number": "३-१६-१०", "content_sanskrit": "वेदाभिमानिनी वीन्द्र अन्नपूर्णा प्रकीर्तिता ।\nनारायणस्य भार्या तु लक्ष्मीरूपा त्वजा स्मृता ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006121010, "chapter_id": 26121, "verse_number": "३-१६-११", "content_sanskrit": "यज्ञाख्यस्य हरेर्भार्या दक्षिणा संप्रकीर्तिता ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006121011, "chapter_id": 26121, "verse_number": "३-१६-१२", "content_sanskrit": "जयन्ती वृषभस्यैव पत्नी संपरिकीर्तिता ।\nविदेहपुत्री सीता तु रामभार्या प्रकीर्तिता ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006121012, "chapter_id": 26121, "verse_number": "३-१६-१३", "content_sanskrit": "रुक्मिणीसत्यभामा च भार्ये कृष्णस्य कीर्तिते ।\nइत्यादिका ह्यनन्ताश्चाप्यावताराः पृथग्विधाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006121013, "chapter_id": 26121, "verse_number": "३-१६-१४", "content_sanskrit": "रमायाः संति विप्रेन्द्र भेदहीनाः परस्परम् ।\nअनन्तानन्तगुणकाद्विष्णोर्न्यूनाः प्रकीर्तिताः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006121014, "chapter_id": 26121, "verse_number": "३-१६-१५", "content_sanskrit": "अथ ब्रह्मा च वायुश्च श्रियः कोटिगुणाधमौ ।\nवक्ष्ये च ब्रह्मणो रूपं शृणु पक्षीन्द्रसत्तम ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006121015, "chapter_id": 26121, "verse_number": "३-१६-१६", "content_sanskrit": "वासुदेवात्समुत्पन्नो मायायां च खगेश्वर ।\nस एव पुरुषोनाम विरिञ्च इति कीर्तितः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006121016, "chapter_id": 26121, "verse_number": "३-१६-१७", "content_sanskrit": "अनिरुद्धात्तु शान्तायां महत्तत्त्वतनुस्त्वभूत् ।\nतदा महान्विरिञ्चेति संज्ञामाप खगेश्वर ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006121017, "chapter_id": 26121, "verse_number": "३-१६-१८", "content_sanskrit": "रजसात्र समुत्पन्नो मायायां वासुदेवतः ।\nविधिसंज्ञो विरिञ्चः स ज्ञातव्यः पक्षिसत्तम ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006121018, "chapter_id": 26121, "verse_number": "३-१६-१९", "content_sanskrit": "ब्रह्माण्डान्तः पद्मनाभो यो जातः कमलासनः ।\nस चर्तुमुखसंज्ञां चाप्यवाप खगसत्तम ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006121019, "chapter_id": 26121, "verse_number": "३-१६-२०", "content_sanskrit": "एवं चत्वारिरूपाणि ब्रह्मणः कीर्तितानि च ।\nवायोर्नामानि वक्ष्येहं शृणु पक्षीन्द्रसत्तम ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006121020, "chapter_id": 26121, "verse_number": "३-१६-२१", "content_sanskrit": "संकर्षणाच्च गरुड जयायां यो वभूव ह ।\nस वायुः प्रथमो ज्ञेयो प्रधान इति कीर्तितः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006121021, "chapter_id": 26121, "verse_number": "३-१६-२२", "content_sanskrit": "लोकचेष्टाप्रदत्वात्स सूत्रनाम्नापि कीर्तितः ।\nबदरीस्थस्य विष्णोश्च धैर्येण स्तवनाय सः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006121022, "chapter_id": 26121, "verse_number": "३-१६-२३", "content_sanskrit": "धृतिरूपं ययौ वायुस्तस्माद्धृतिरिति स्मृतः ।\nयोग्यानां हरिभक्तानां धृतिरूपेण संस्थितः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006121023, "chapter_id": 26121, "verse_number": "३-१६-२४", "content_sanskrit": "यतो हृदि स्थितो वायुस्ततो वै धृतिसंज्ञकः ।\nसर्वेषां च दृदि स्थित्वा स्मरते सर्वदा हरिम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006121024, "chapter_id": 26121, "verse_number": "३-१६-२५", "content_sanskrit": "अतो वायुःस्थितिर्नाम बभूव खगसत्तम ।\nअथवा वायुरेवैकः श्वेतद्वीपगतं हरिम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006121025, "chapter_id": 26121, "verse_number": "३-१६-२६", "content_sanskrit": "सदा स्मरति वै वीन्द्र अतोसौ स्मृतिसंज्ञकः ।\nसर्वेषां च हृदिस्थित्वा ज्ञातो विष्णोरुदीरणात् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006121026, "chapter_id": 26121, "verse_number": "३-१६-२७", "content_sanskrit": "अतो मे मुक्तिनामाभूद्वायुरेव न संशयः ।\nज्ञानद्वारेण भक्तानां मुक्तिदो मदनुज्ञया ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006121027, "chapter_id": 26121, "verse_number": "३-१६-२८", "content_sanskrit": "यतो सौ वायुरेवैको मुक्तिनामा भूवह ।\nविष्णौ भक्तिं वर्ध्यति भक्तानां हृदि संस्थितः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006121028, "chapter_id": 26121, "verse_number": "३-१६-२९", "content_sanskrit": "अतोसौ विष्णुभक्तश्च कीर्तितो नात्र संशयः ।\nएषोसौ सर्वजीवानां चित्तसंज्ञानमेव च ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006121029, "chapter_id": 26121, "verse_number": "३-१६-३०", "content_sanskrit": "चित्तरूपो यतो वायुरतश्चित्तमिति स्मृतः ।\nप्रभुः प्रभूणां गरुड सोदराणां च सर्वशः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006121030, "chapter_id": 26121, "verse_number": "३-१६-३१", "content_sanskrit": "अतस्तु वायुरेवैको महाप्रभुरिति स्मृतः ।\nसर्वेषां च हृहि स्थित्वा बलं पश्यति सत्तम ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006121031, "chapter_id": 26121, "verse_number": "३-१६-३२", "content_sanskrit": "अतो बलमिति ह्याख्यामवाप विनतासुत ।\nसर्वेषां च हृदि स्थित्वा पुत्रपौत्रादिकैर्जनैः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006121032, "chapter_id": 26121, "verse_number": "३-१६-३३", "content_sanskrit": "याजनं कुरुते नित्यमतोसौ यष्टृसंज्ञकः ।\nअनन्तकल्पमारभ्य वायुपर्यन्तमेव च ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006121033, "chapter_id": 26121, "verse_number": "३-१६-३४", "content_sanskrit": "वक्रत्वं नास्ति योगस्य ऋजुर्योग्य इति स्मृतः ।\nयोगस्य वक्रता नाम काम्यता हरिपूजने ।\nईशरुद्रादिकानां च काम्येन हरिपूजनम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006121034, "chapter_id": 26121, "verse_number": "३-१६-३५", "content_sanskrit": "कस्यचित्त्वथ पक्षीन्द्र ह्यतस्त्वनृजवः स्मृताः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006121035, "chapter_id": 26121, "verse_number": "३-१६-३६", "content_sanskrit": "ऋष्यादीनां च मध्येपि काम्येन हरिपूजनम् ।\nअतो न ऋजवो ज्ञेया मनुष्याणां च का कथा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006121036, "chapter_id": 26121, "verse_number": "३-१६-३७", "content_sanskrit": "यावत्काम्यसपर्यां वै न जहाति नरोत्तमः ।\nतथा ऋष्यादयश्चैव मोक्षस्य परिपन्थिनीम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006121037, "chapter_id": 26121, "verse_number": "३-१६-३८", "content_sanskrit": "अनादिकालमारभ्य कर्मजन्या च वासना ।\nमोक्षाधिकारिणः सर्वे कुर्वते कस्य पूजनम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006121038, "chapter_id": 26121, "verse_number": "३-१६-३९", "content_sanskrit": "नष्टप्रायं च तत्सर्वं गुरोः संज्ञानबोधकात् ।\nप्राप्ययोगं समाचर्य अन्ते मोक्षमवाप्नुयात् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006121039, "chapter_id": 26121, "verse_number": "३-१६-४०", "content_sanskrit": "काम्येन पूजनं विष्णोरैश्वर्यं प्रददाति च ।\nज्ञानं च विपरीतं स्यात्तेन यात्यधरं तमः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006121040, "chapter_id": 26121, "verse_number": "३-१६-४१", "content_sanskrit": "तदेव विपरीतं चेज्ज्ञानाय परिकीर्तितम् ।\nशिलायां विष्णुबुद्धिस्तु विष्णुबुद्धिर्द्विजे तथा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006121041, "chapter_id": 26121, "verse_number": "३-१६-४२", "content_sanskrit": "सलिले तीर्थबुद्धिस्तु रोणुकायां तथैव च ।\nशिवे सूर्ये पण्मुखे च विष्णुबुद्धिः खगेश्वर ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006121042, "chapter_id": 26121, "verse_number": "३-१६-४३", "content_sanskrit": "इत्याद्यमखिलं ज्ञानं विपरीतमिति स्मृतम् ।\nशिलाद्येषु च सर्वेषु ऐक्येनव विचिन्तनम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006121043, "chapter_id": 26121, "verse_number": "३-१६-४४", "content_sanskrit": "विष्णुबुद्धिरिति प्रोक्तं न तु तत्रस्थवेदनम् ।\nअनाद्यनन्तकालेपि काम्येन हरिपूजनम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006121044, "chapter_id": 26121, "verse_number": "३-१६-४५", "content_sanskrit": "यतो नास्ति ततो वायुरृजुर्योग्यः प्रकीर्तितः ।\nअन्येषां सर्वदा नास्ति अतो न ऋजवः स्मृताः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006121045, "chapter_id": 26121, "verse_number": "३-१६-४६", "content_sanskrit": "हरिं दर्शयते वापि अपरोक्षेण सर्वदा ।\nमोक्षाधिकारिणां काले अतः प्रज्ञेति कथ्यते ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006121046, "chapter_id": 26121, "verse_number": "३-१६-४७", "content_sanskrit": "परोक्षेणापि सर्वेषां हरिं दर्शयते सदा ।\nअतो वायुः सदा वीन्द्र ज्ञानमित्येव कीर्तितः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006121047, "chapter_id": 26121, "verse_number": "३-१६-४८", "content_sanskrit": "हिताहितोपदेष्टृत्वाद्भक्तानां हृदये स्थितः ।\nततश्च गुरुसंज्ञां चाप्यवाप स च मारुतः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006121048, "chapter_id": 26121, "verse_number": "३-१६-४९", "content_sanskrit": "योगिनां हृदये स्थित्वा सध्यायति हरिं परम् ।\nपार्थक्येनापि तं ध्यायन्महाध्यातेति स स्मृतः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006121049, "chapter_id": 26121, "verse_number": "३-१६-५०", "content_sanskrit": "यद्योग्यतानुसारेण विजानाति परं हरिम् ।\nरुद्रादौ विद्यमानांश्च गुणाञ्जानाति सर्वदा ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006121050, "chapter_id": 26121, "verse_number": "३-१६-५१", "content_sanskrit": "अतो वै विज्ञनामासौ प्रोक्तो हि खगसत्तम ।\nकाम्यानां कर्मणां त्यागाद्विराग इति स स्मृतः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006121051, "chapter_id": 26121, "verse_number": "३-१६-५२", "content_sanskrit": "अथवायोगिनां नित्यं हृदि स्थित्वा स मारुतः ।\nवैराग्यं संजनयति विराग इति स स्मृतः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006121052, "chapter_id": 26121, "verse_number": "३-१६-५३", "content_sanskrit": "देवानां पुण्यपापाभ्यां सुखमेवोत्तरोत्तरम् ।\nतत्सुखं तूत्तरेषां च वायुपर्यन्तमेव च ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006121053, "chapter_id": 26121, "verse_number": "३-१६-५४", "content_sanskrit": "देवानां च ऋषीणां च उत्तमानां नृणां तथा ।\nसुखांशं जनयेद्वायुर्यतोतः सुखसंज्ञकः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006121054, "chapter_id": 26121, "verse_number": "३-१६-५५", "content_sanskrit": "भुनक्ति सर्वदा वीद्रं तत्र मुख्यस्तु मारुतः ।\nदुः खशोकादिकं किञ्चिद्देवानां भवति प्रभो ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006121055, "chapter_id": 26121, "verse_number": "३-१६-५६", "content_sanskrit": "तच्चासुरावेशवशादित्यवेहि न संशयः ।\nतज्जीवस्य भवेत्किञ्चिद्दैत्यानां क्रमशो भवेत् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006121056, "chapter_id": 26121, "verse_number": "३-१६-५७", "content_sanskrit": "यतः कलिश्चाधिकः स्यादतो दुः खीति स स्मृतः ।\nदैत्यानां पुण्यपापाभ्यां दुः ख मेवोत्तरोत्तरम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006121057, "chapter_id": 26121, "verse_number": "३-१६-५८", "content_sanskrit": "तद्दुः खमुत्तरेषां च कलिपर्यन्तमेव च ।\nभुनक्ति सर्वदा वीन्द्र ततः कलिरिति स्मृतः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006121058, "chapter_id": 26121, "verse_number": "३-१६-५९", "content_sanskrit": "सुखहर्षादिकं किं चिद्दैत्यानां भवति प्रभो ।\nदेवावेशो भवेत्तस्य नात्र कार्या विचारणा ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006121059, "chapter_id": 26121, "verse_number": "३-१६-६०", "content_sanskrit": "देवानां निरयो नास्ति दैत्यानां विनतासुत ।\nसुखस्वरूपं तन्नास्ति विषयोत्थमपि द्विज ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006121060, "chapter_id": 26121, "verse_number": "३-१६-६१", "content_sanskrit": "विषयोत्थं किञ्चिदपि देवावेशादुदीरितम् ।\nतमो नास्त्येव देवानां दुः खं नास्ति स्वरूपतः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006121061, "chapter_id": 26121, "verse_number": "३-१६-६२", "content_sanskrit": "विषयोत्थं महादुः खं देवानां नास्ति सर्वदा ।\nदुः खशोकादिकं किं चिदसुरावेशतो भवेत् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006121062, "chapter_id": 26121, "verse_number": "३-१६-६३", "content_sanskrit": "अतः कलिः सदा दुः खी सुखी वायुस्तु सर्वदा ।\nमनुष्याणा मृषीणां च सुखं दुः खं खगेश्वर ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006121063, "chapter_id": 26121, "verse_number": "३-१६-६४", "content_sanskrit": "भवेत्तत्पुण्यिपापाभ्यां पुण्यभोगी च मारुतः ।\nकष्टभङ्गः कलिलयो नात्र कार्या विचारणा ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006121064, "chapter_id": 26121, "verse_number": "३-१६-६५", "content_sanskrit": "प्राणादिसुखपर्यन्ता अंशा एकोनविंशतिः ।\nप्रविष्टाः संति लोकेषु पृथक्संति खगेश्वर ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006121065, "chapter_id": 26121, "verse_number": "३-१६-६६", "content_sanskrit": "मारुतरेवतारांश्च शृणु पक्षीन्द्रसत्तम ।\nचतुर्दशसु चन्द्रेषु द्वितीयौयो विरोचनः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006121066, "chapter_id": 26121, "verse_number": "३-१६-६७", "content_sanskrit": "स वायुरिति संप्रोक्त इन्द्रादीनां खगेश्वर ।\nहरितत्त्वेषु सर्वेषु स विष्वग्याव्यतेक्षणः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006121067, "chapter_id": 26121, "verse_number": "३-१६-६८", "content_sanskrit": "अतो रोचननामासौ मरुदंशः प्रकीर्तितः रामावतारे हनुमान्रामकार्यार्थसाधकः ।\nस एव भीमसेनस्तु जातो भूम्यां महाबलः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006121068, "chapter_id": 26121, "verse_number": "३-१६-६९", "content_sanskrit": "कृष्णावतारे विज्ञेयो मरुदंशः प्रकीर्तितः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006121069, "chapter_id": 26121, "verse_number": "३-१६-७०", "content_sanskrit": "मणिमान्नाम दैत्यस्तु संराख्यो भविष्यति ।\nसर्वेषां संकरं यस्तु करिष्यति न संशयः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006121070, "chapter_id": 26121, "verse_number": "३-१६-७१", "content_sanskrit": "तेन संकरनामासौ भविष्यति खगेश्वर ।\nधर्मान्भागवतान्सर्वान्विनाशयति सर्वथा ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006121071, "chapter_id": 26121, "verse_number": "३-१६-७२", "content_sanskrit": "तदा भूमौ वासुदेवो भविष्यति न संशयः ।\nयज्ञार्थैः सदृशो यस्य नास्ति लोके चतुर्दशे ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006121072, "chapter_id": 26121, "verse_number": "३-१६-७३", "content_sanskrit": "अतः स प्रज्ञया पूर्णो भविष्यति न संशयः ।\nअवतारास्त्रयो वायोर्मतं भागवताभिधम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006121073, "chapter_id": 26121, "verse_number": "३-१६-७४", "content_sanskrit": "स्थापनं दुष्टदमनं द्वयमेव प्रयोजनम् ।\nनान्यत्प्रयोजनं वायोस्तथा वैरोचनात्मके ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006121074, "chapter_id": 26121, "verse_number": "३-१६-७५", "content_sanskrit": "अवतारत्रये वीन्द्र दुः खं गर्भादिसंभवम् ।\nनास्ति नास्त्येव वायोस्तु तथा वैरोचनादिके ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006121075, "chapter_id": 26121, "verse_number": "३-१६-७६", "content_sanskrit": "शुक्रशोणितसंबन्धो ह्यवतारचतुष्टये ।\nनास्ति नास्त्येव पक्षीन्द्र यतो नास्त्यशुभं ततः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006121076, "chapter_id": 26121, "verse_number": "३-१६-७७", "content_sanskrit": "पूर्वं गर्भं समाशोष्य समये प्रभवस्य च ।\nप्रादुर्भवति देवेशी ह्यवतारचतुष्टये ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006121077, "chapter_id": 26121, "verse_number": "३-१६-७८", "content_sanskrit": "त्रयोविंशतिरूपाणां वायोश्चैव खगेश्वर ।\nरूपैरृजुस्वरूपैश्च ब्रह्मणः परमेष्ठिनः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006121078, "chapter_id": 26121, "verse_number": "३-१६-७९", "content_sanskrit": "सत्यमेव न संदेहो नित्यानन्दसुखादिषु ।\nएवमेव विजानीयान्नान्यथा तु कथञ्चन ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006121079, "chapter_id": 26121, "verse_number": "३-१६-८०", "content_sanskrit": "एतस्य श्रवणादेव मोक्षं यान्ति न संशयः ।\nतदनन्तरजान्वक्ष्ये शृणु पक्षीन्द्रसत्तम ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006121080, "chapter_id": 26121, "verse_number": "३-१६-८१", "content_sanskrit": "कृतौ प्रद्युम्नतश्चैव समुत्पन्ने खगेश्वर ।\nस्त्रियौ द्वे यमले चैव तयोर्मध्ये तु यद्यिका ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006121081, "chapter_id": 26121, "verse_number": "३-१६-८२", "content_sanskrit": "वाणीतिसंज्ञकां वीन्द्र ब्रह्माणीसंज्ञकां विदुः ।\nपुरुषाख्यविरिञ्चस्य भार्या सावित्रिका मता ।\nचतुर्मुखस्य भार्या तु कीर्तिता सा सरस्वती ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006121082, "chapter_id": 26121, "verse_number": "३-१६-८३", "content_sanskrit": "एवं त्रिरूपं विज्ञेयं वाण्याश्च खगसत्तम ।\nवक्ष्येऽवतारान् भारत्याः समाहितमनाः शृणु ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006121083, "chapter_id": 26121, "verse_number": "३-१६-८४", "content_sanskrit": "सर्ववेदाभिमानित्वात्सर्ववेदात्मिका स्मृता ।\nमहाध्यातुश्च वायोस्तु भार्यासा परिकीर्तिता ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006121084, "chapter_id": 26121, "verse_number": "३-१६-८५", "content_sanskrit": "ज्ञानरूपस्य वायोस्तु भार्या सा परिकीर्तिता ।\nसदा सुखस्वरूपत्वाद्भारती तु सुखात्मिका ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006121085, "chapter_id": 26121, "verse_number": "३-१६-८६", "content_sanskrit": "सुखस्वरूप वायोस्तु भार्या सा परिकीर्तिता ।\nगुरुस्तु वायुरेवोक्तस्तस्मिन् भक्तियुता सती ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006121086, "chapter_id": 26121, "verse_number": "३-१६-८७", "content_sanskrit": "ततस्तु भारती नित्या गुरुभक्तिरिति स्मृता ।\nमहागुरोर्हि वायोश्च भार्या वै परिकीर्तिता ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006121087, "chapter_id": 26121, "verse_number": "३-१६-८८", "content_sanskrit": "हरौ स्नेहयुतत्वाच्च हरिप्रीतिरिति स्मृता ।\nधृतिरूपस्य वायोश्च भार्या सा परिकीर्तिता ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006121088, "chapter_id": 26121, "verse_number": "३-१६-८९", "content_sanskrit": "सर्वमन्त्राभिमानित्वात्सर्वमन्त्रात्मिका स्मृता ।\nमहाप्रभोश्च वायोश्च भार्या वै सा प्रकीर्तिता ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006121089, "chapter_id": 26121, "verse_number": "३-१६-९०", "content_sanskrit": "भुज्यन्ते सर्वभोगास्तु विष्णुप्रीत्यर्थमेवच ।\nअतस्तु भारती ज्ञेया भुजिनाम्ना प्रकीर्तिता ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006121090, "chapter_id": 26121, "verse_number": "३-१६-९१", "content_sanskrit": "चित्ररूपस्य वायोस्तु भार्या सा परिकीर्तिता ।\nरोचनेन्द्रस्य भार्या च श्रद्धाख्या परिकीर्तिता ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7006121091, "chapter_id": 26121, "verse_number": "३-१६-९२", "content_sanskrit": "हनुमांश्च तदा जज्ञे त्रेतायां पक्षिसत्तम ।\nतदा शिवाख्यविप्राच्च जज्ञे सा भारती स्मृता ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7006121092, "chapter_id": 26121, "verse_number": "३-१६-९३", "content_sanskrit": "न केवलं भारती साशच्याद्यैश्चैव संयुता ।\nतस्मिन्संजनिताः सर्वाः प्रापुर्योगं स्वभर्तृभिः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7006121093, "chapter_id": 26121, "verse_number": "३-१६-९४", "content_sanskrit": "अन्यगेति च विज्ञेया कन्या तन्मतिसंज्ञिका ।\nत्रेतान्ते सैव पक्षीन्द्र शच्याद्यैश्चैव संयुता ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7006121094, "chapter_id": 26121, "verse_number": "३-१६-९५", "content_sanskrit": "दमयन्त्यनलाज्जाता इन्द्रसेनेति चोच्यते ।\nनलं नन्दयते यस्मात्तस्माच्च नलनन्दिनी ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7006121095, "chapter_id": 26121, "verse_number": "३-१६-९६", "content_sanskrit": "तत्र स्वभर्तृसंयोगं नैव चाप खगेश्वर ।\nतत्रान्यगात्वं विज्ञेयं पुरुषस्थेन वायुना ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7006121096, "chapter_id": 26121, "verse_number": "३-१६-९७", "content_sanskrit": "किञ्चित्कालं तथा स्थित्वा कन्यैव मृति माप सा ।\nशच्यादिसंयुता सैव द्रुपदस्य महात्मनः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7006121097, "chapter_id": 26121, "verse_number": "३-१६-९८", "content_sanskrit": "वेदिमध्यात्समुद्भूता भीमसेनार्थमेव च ।\nतत्रान्यगात्वं नास्त्येव योगश्च सह भर्तृभिः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7006121098, "chapter_id": 26121, "verse_number": "३-१६-९९", "content_sanskrit": "केवला भारती ज्ञेया काशिराजस्य कन्यका ।\nकाली नाम्ना तु सा ज्ञेया भीमसेनप्रिया सदा ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7006121099, "chapter_id": 26121, "verse_number": "३-१६-१००", "content_sanskrit": "वाच्यादिभिः संयुतैवद्रौपदी द्रुपदात्मजा ।\nदेहं त्यक्त्वाविशिष्टैव कारटीग्रामसंज्ञकै ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7006121100, "chapter_id": 26121, "verse_number": "३-१६-१०१", "content_sanskrit": "संकरस्य गृहे वीन्द्र भविष्यति कलौ युगे ।\nवायोस्तृतीयरूपार्थं सा कन्यैव मृतिं गता ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7006121101, "chapter_id": 26121, "verse_number": "३-१६-१०२", "content_sanskrit": "इत्याद्या वायुभार्याश्च ब्रह्मभार्याश्च सतम ।\nस्वभर्तृभ्यां च पक्षीन्द्र गुणैश्चैव शताधमाः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}]