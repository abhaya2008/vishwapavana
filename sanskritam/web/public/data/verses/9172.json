[{"id": 5000172000, "chapter_id": 9172, "verse_number": "२-९५-१", "content_sanskrit": "अथ शैलाद्विनिष्क्रम्य मैथिलीं कोसलेश्वर: ।\nअदर्शयच्छुभजलां रम्यां मन्दाकिनीं नदीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000172001, "chapter_id": 9172, "verse_number": "२-९५-२", "content_sanskrit": "अब्रवीच्च वरारोहां चारुचन्द्रनिभाननाम् ।\nविदेहराजस्य सुतां रामो राजीवलोचन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000172002, "chapter_id": 9172, "verse_number": "२-९५-३", "content_sanskrit": "विचित्रपुलिनां रम्यां हंससारससेविताम् ।\nकमलैरुपसम्पन्नां पश्य मन्दाकिनीं नदीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000172003, "chapter_id": 9172, "verse_number": "२-९५-४", "content_sanskrit": "नानाविधैस्तीररुहैर्वृतां पुष्पफलद्रुमै: ।\nराजन्तीं राजराजस्य नलिनीमिव सर्वत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000172004, "chapter_id": 9172, "verse_number": "२-९५-५", "content_sanskrit": "मृगयूथनिपीतानि कलुषाम्भांसि साम्प्रतम् ।\nतीर्थानि रमणीयानि रतिं सञ्जनयन्ति मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000172005, "chapter_id": 9172, "verse_number": "२-९५-६", "content_sanskrit": "जटाजिनधरा: काले वल्कलोत्तरवासस: ।\nऋषयस्त्ववगाहन्ते नदीं मन्दाकिनीं प्रिये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000172006, "chapter_id": 9172, "verse_number": "२-९५-७", "content_sanskrit": "आदित्यमुपतिष्ठन्ते नियमादूर्द्ध्वबाहव: ।\nएते परे विशालाक्षि मुनय: संशितव्रता: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000172007, "chapter_id": 9172, "verse_number": "२-९५-८", "content_sanskrit": "मारुतोद्धूतशिखरै: प्रनृत्त इव पर्वत: ।\nपादपै: पत्ऺत्रपुष्पाणि सृजद्भिरभितो नदीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000172008, "chapter_id": 9172, "verse_number": "२-९५-९", "content_sanskrit": "क्वचिन्मणिनिकाशोदां क्वचित्पुलिनशालिनीम् ।\nक्वचित्सिद्धजनाकीर्णां पश्य मन्दाकिनीं नदीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000172009, "chapter_id": 9172, "verse_number": "२-९५-१०", "content_sanskrit": "निर्द्धूतान् वायुना पश्य विततान् पुष्पसञ्चयान् ।\nपोप्लूयमानानपरान् पश्य त्वं जलमध्यगान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000172010, "chapter_id": 9172, "verse_number": "२-९५-११", "content_sanskrit": "तांश्चातिवल्गुवचसो रथाङ्गाह्वयना द्विजा: ।\nअधिरोहन्ति कल्याणि विकूजन्त: शुभा गिर: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000172011, "chapter_id": 9172, "verse_number": "२-९५-१२", "content_sanskrit": "दर्शनं चित्र कूटस्य मन्दाकिन्याश्च शोभने ।\nअधिकं पुरवासाच्च मन्ये च तव दर्शनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000172012, "chapter_id": 9172, "verse_number": "२-९५-१३", "content_sanskrit": "विधूतकलुषै: सिद्धैस्तपोदमशमान्वितै: ।\nनित्यविक्षोभितजलां विगाहस्व मया सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000172013, "chapter_id": 9172, "verse_number": "२-९५-१४", "content_sanskrit": "सखीवच्च विगाहस्व सीते मन्दाकिनीं नदीम् ।\nकमलान्यवमज्जन्ती पुष्कराणि च भामिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000172014, "chapter_id": 9172, "verse_number": "२-९५-१५", "content_sanskrit": "त्वं पौरजनवद्व्यालानयोध्यामिव पर्वतम् ।\nमन्यस्व वनिते नित्यं सरयूवदिमां नदीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000172015, "chapter_id": 9172, "verse_number": "२-९५-१६", "content_sanskrit": "लक्ष्मणश्चापि धर्मात्मा मन्निदेशे व्यवस्थित: ।\nत्वं चानुकूला वैदेहि प्रीतिं जनयथो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000172016, "chapter_id": 9172, "verse_number": "२-९५-१७", "content_sanskrit": "उपस्पृशंस्त्रिषवणं मधुमूलफलाशन: ।\nनायोध्यायै न राज्याय स्पृहये ऽद्य त्वया सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000172017, "chapter_id": 9172, "verse_number": "२-९५-१८", "content_sanskrit": "इमां हि रम्यां मृगयूथशालिनीं निपीततोयां गजसिंहवानरै: ।\nसुपुष्पितै: पुष्पधरैरलङ्कृतां न सो ऽस्ति य: स्यादगतक्लम: सुखी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000172018, "chapter_id": 9172, "verse_number": "२-९५-१९", "content_sanskrit": "इतीव रामो बहुसङ्गतं वच: प्रियासहाय: सरितं प्रति ब्रुवन् ।\nचचार रम्यं नयनाञ्जनप्रभं स चित्रकूटं रघुवंशवर्द्धन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000172019, "chapter_id": 9172, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदयोध्याकाण्डे पञ्चनवतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]