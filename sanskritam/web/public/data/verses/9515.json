[{"id": 5000515000, "chapter_id": 9515, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे अष्टाधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000515001, "chapter_id": 9515, "verse_number": "६-१०८-१", "content_sanskrit": "अथ संस्मारयामास मातली राघवं तदा।\nअजानन्निव किं वीर त्वमेनमनुवर्तसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000515002, "chapter_id": 9515, "verse_number": "६-१०८-२", "content_sanskrit": "विसृजास्मै वधाय त्वमस्त्रं पैतामहं प्रभो।\nविनाशकालः कथितो यः सुरैः सोऽद्य वर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000515003, "chapter_id": 9515, "verse_number": "६-१०८-३", "content_sanskrit": "ततः संस्मारितो रामस्तेन वाक्येन मातलेः।\nजग्राह स शरं दीप्तं निःश्वसन्तमिवोरगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000515004, "chapter_id": 9515, "verse_number": "६-१०८-४", "content_sanskrit": "यं तस्मै प्रथमं प्रादादगस्त्यो भगवानृषिः।\nब्रह्मदत्तं महद् बाणममोघं युधि वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000515005, "chapter_id": 9515, "verse_number": "६-१०८-५", "content_sanskrit": "ब्रह्मणा निर्मितं पूर्वमिन्द्रार्थममितौजसा।\nदत्तं सुरपतेः पूर्वं त्रिलोकजयकांक्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000515006, "chapter_id": 9515, "verse_number": "६-१०८-६", "content_sanskrit": "यस्य वाजेषु पवनः फले पावकभास्करौ।\nशरीरमाकाशमयं गौरवे मेरुमन्दरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000515007, "chapter_id": 9515, "verse_number": "६-१०८-७", "content_sanskrit": "जाज्वल्यमानं वपुषा सुपुङ्खं हेमभूषितम्।\nतेजसा सर्वभूतानां कृतं भास्करवर्चसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000515008, "chapter_id": 9515, "verse_number": "६-१०८-८", "content_sanskrit": "सधूममिव कालाग्निं दीप्तमाशीविषोपमम्।\nनरनागाश्ववृन्दानां भेदनं क्षिप्रकारिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000515009, "chapter_id": 9515, "verse_number": "६-१०८-९", "content_sanskrit": "द्वाराणां परिघाणां च गिरीणां चापि भेदनम्।\nनानारुधिरदिग्धाङ्गं मेदोदिग्धं सुदारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000515010, "chapter_id": 9515, "verse_number": "६-१०८-१०", "content_sanskrit": "वज्रसारं महानादं नानासमितिदारुणम्।\nसर्ववित्रासनं भीमं श्वसन्तमिव पन्नगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000515011, "chapter_id": 9515, "verse_number": "६-१०८-११", "content_sanskrit": "कङ्कगृध्रबकानां च गोमायुगणरक्षसाम्।\nनित्यभक्षप्रदं युद्धे यमरूपं भयावहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000515012, "chapter_id": 9515, "verse_number": "६-१०८-१२", "content_sanskrit": "नन्दनं वानरेन्द्राणां रक्षसामवसादनम्।\nवाजितं विविधैर्वाजैश्चारुचित्रैर्गरुत्मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000515013, "chapter_id": 9515, "verse_number": "६-१०८-१३", "content_sanskrit": "तमुत्तमेषुं लोकानामिक्ष्वाकुभयनाशनम्।\nद्विषतां कीर्तिहरणं प्रहर्षकरमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000515014, "chapter_id": 9515, "verse_number": "६-१०८-१४", "content_sanskrit": "अभिमन्त्र्य ततो रामस्तं महेषुं महाबलः।\nवेदप्रोक्तेन विधिना संदधे कार्मुके बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000515015, "chapter_id": 9515, "verse_number": "६-१०८-१५", "content_sanskrit": "तस्मिन् संधीयमाने तु राघवेण शरोत्तमे।\nसर्वभूतानि संत्रेसुश्चचाल च वसुंधरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000515016, "chapter_id": 9515, "verse_number": "६-१०८-१६", "content_sanskrit": "स रावणाय संक्रुद्धो भृशमायम्य कार्मुकम्।\nचिक्षेप परमायत्तः शरं मर्मविदारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000515017, "chapter_id": 9515, "verse_number": "६-१०८-१७", "content_sanskrit": "स वज्र इव दुर्धर्षो वज्रिबाहुविसर्जितः।\nकृतान्त इव चावार्यो न्यपतद् रावणोरसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000515018, "chapter_id": 9515, "verse_number": "६-१०८-१८", "content_sanskrit": "स विसृष्टो महावेगः शरीरान्तकरः परः।\nबिभेद हृदयं तस्य रावणस्य दुरात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000515019, "chapter_id": 9515, "verse_number": "६-१०८-१९", "content_sanskrit": "रुधिराक्तः स वेगेन शरीरान्तकरः शरः।\nरावणस्य हरन् प्राणान् विवेश धरणीतलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000515020, "chapter_id": 9515, "verse_number": "६-१०८-२०", "content_sanskrit": "स शरो रावणं हत्वा रुधिरार्द्रकृतच्छविः।\nकृतकर्मा निभृतवत् स तूणीं पुनराविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000515021, "chapter_id": 9515, "verse_number": "६-१०८-२१", "content_sanskrit": "तस्य हस्ताद्धतस्याशु कार्मुकं तत् ससायकम्।\nनिपपात सह प्राणैर्भ्रश्यमानस्य जीवितात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000515022, "chapter_id": 9515, "verse_number": "६-१०८-२२", "content_sanskrit": "गतासुर्भीमवेगस्तु नैर्ऋतेन्द्रो महाद्युतिः।\nपपात स्यन्दनाद् भूमौ वृत्रो वज्रहतो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000515023, "chapter_id": 9515, "verse_number": "६-१०८-२३", "content_sanskrit": "तं दृष्ट्वा पतितं भूमौ हतशेषा निशाचराः।\nहतनाथा भयत्रस्ताः सर्वतः सम्प्रदुद्रुवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000515024, "chapter_id": 9515, "verse_number": "६-१०८-२४", "content_sanskrit": "नर्दन्तश्चाभिपेतुस्तान् वानरा द्रुमयोधिनः।\nदशग्रीववधं दृष्ट्वा वानरा जितकाशिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000515025, "chapter_id": 9515, "verse_number": "६-१०८-२५", "content_sanskrit": "अर्दिता वानरैर्हृष्टैर्लङ्कामभ्यपतन् भयात्।\nहताश्रयत्वात् करुणैर्बाष्पप्रस्रवणैर्मुखैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000515026, "chapter_id": 9515, "verse_number": "६-१०८-२६", "content_sanskrit": "ततो विनेदुः संहृष्टा वानरा जितकाशिनः।\nवदन्तो राघवजयं रावणस्य च तद्वधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000515027, "chapter_id": 9515, "verse_number": "६-१०८-२७", "content_sanskrit": "अथान्तरिक्षे व्यनदत् सौम्यस्त्रिदशदुन्दुभिः।\nदिव्यगन्धवहस्तत्र मारुतः सुसुखो ववौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000515028, "chapter_id": 9515, "verse_number": "६-१०८-२८", "content_sanskrit": "निपपातान्तरिक्षाच्च पुष्पवृष्टिस्तदा भुवि।\nकिरन्ती राघवरथं दुरावापा मनोहरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000515029, "chapter_id": 9515, "verse_number": "६-१०८-२९", "content_sanskrit": "राघवस्तवसंयुक्ता गगने च विशुश्रुवे।\nसाधुसाध्विति वागग्र्या देवतानां महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000515030, "chapter_id": 9515, "verse_number": "६-१०८-३०", "content_sanskrit": "आविवेश महान् हर्षो देवानां चारणैः सह।\nरावणे निहते रौद्रे सर्वलोकभयंकरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000515031, "chapter_id": 9515, "verse_number": "६-१०८-३१", "content_sanskrit": "ततः सकामं सुग्रीवमङ्गदं च विभीषणम्।\nचकार राघवः प्रीतो हत्वा राक्षसपुंगवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000515032, "chapter_id": 9515, "verse_number": "६-१०८-३२", "content_sanskrit": "ततः प्रजग्मुः प्रशमं मरुद‍्गणा\nदिशः प्रसेदुर्विमलं नभोऽभवत्।\nमही चकम्पे न च मारुतो ववौ\nस्थिरप्रभश्चाप्यभवद् दिवाकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000515033, "chapter_id": 9515, "verse_number": "६-१०८-३३", "content_sanskrit": "ततस्तु सुग्रीवविभीषणाङ्गदाः\nसुहृद्विशिष्टाः सहलक्ष्मणस्तदा।\nसमेत्य हृष्टा विजयेन राघवं\nरणेऽभिरामं विधिनाभ्यपूजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000515034, "chapter_id": 9515, "verse_number": "६-१०८-३४", "content_sanskrit": "स तु निहतरिपुः स्थिरप्रतिज्ञः\nस्वजनबलाभिवृतो रणे बभूव।\nरघुकुलनृपनन्दनो महौजा-\nस्त्रिदशगणैरभिसंवृतो महेन्द्रः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000515035, "chapter_id": 9515, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे अष्टाधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]