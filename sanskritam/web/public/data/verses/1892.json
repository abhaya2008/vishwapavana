[{"id": 2040322, "chapter_id": 1892, "verse_number": "५-१३७-०x", "content_sanskrit": "कुन्त्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2040323, "chapter_id": 1892, "verse_number": "५-१३७-१", "content_sanskrit": "अर्जुनं केशव ब्रूयास्त्वयि जाते स्म सूतके।\nउपोपविष्टा नारीभिराश्रमे परिवारिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2040324, "chapter_id": 1892, "verse_number": "५-१३७-२", "content_sanskrit": "अथान्तरिक्षे वागासीद्दिव्यरूपा मनोरमा ।\nसहस्राक्षसमः कुन्ति भविष्यत्येष ते सुतः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2040325, "chapter_id": 1892, "verse_number": "५-१३७-३", "content_sanskrit": "एष जेष्यति सङ्ग्रामे कुरून्सर्वान्समागतान्।\nभीमसेनद्वितीयश्च लोकमुद्वर्तयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2040326, "chapter_id": 1892, "verse_number": "५-१३७-४", "content_sanskrit": "पुत्रस्ते पृथिवीं जेता यशश्चास्य दिवं स्पृशेत्।\nहत्वा कुरूंश्च सङ्ग्रामे वासुदेवसहायवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2040327, "chapter_id": 1892, "verse_number": "५-१३७-५", "content_sanskrit": "पित्र्यमंशं प्रनष्टं च पुनरप्युद्धरिष्यति ।\nभ्रातृभिः सहितः श्रीमांस्त्रीन्मेधानाहरिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2040328, "chapter_id": 1892, "verse_number": "५-१३७-६", "content_sanskrit": "स सत्यसन्धो बीभत्सुः सव्यसाची यथाच्युत ।\nतथा त्वमेव जानासि बलवन्तं दुरासदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2040329, "chapter_id": 1892, "verse_number": "५-१३७-७", "content_sanskrit": "तथा तदस्तु दाशार्ह यथा वागभ्यभाषत ।\nधर्मश्चेदस्ति वार्ष्णेय तथा सत्यं भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2040330, "chapter_id": 1892, "verse_number": "५-१३७-८", "content_sanskrit": "त्वं चापि तत्तथा कृष्ण सर्वं संपादयिष्यसि ।\nनाहं तदभ्यसूयामि यथा वागभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2040331, "chapter_id": 1892, "verse_number": "५-१३७-९", "content_sanskrit": "नमो धर्माय महते धर्मो धारयति प्रजाः ।\nएतद्धनञ्जयो वाच्यो नित्योद्युक्तो वृकोदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2040332, "chapter_id": 1892, "verse_number": "५-१३७-१०", "content_sanskrit": "यदर्थं क्षत्रिया सूते तस्य कालोऽयमागतः।\nन हि वैरं समासाद्य सीदन्ति पुरुषर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2040333, "chapter_id": 1892, "verse_number": "५-१३७-११", "content_sanskrit": "विदिता ते सदा बुद्धिर्भीमस्य न स शाम्यति।\nयावदन्तं न कुरुते शत्रूणां शत्रुकर्शनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2040334, "chapter_id": 1892, "verse_number": "५-१३७-१२", "content_sanskrit": "तावदेव महापबाहुर्निशासु न सुखं लभेत्।\nसर्वधऱ्मविशेषज्ञां स्नुषां पाण्डोर्महात्मनः ।\nव्रूया माधव कल्याणीं कृष्ण कृष्णां यशस्विनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2040335, "chapter_id": 1892, "verse_number": "५-१३७-१३", "content_sanskrit": "युक्तमेतन्महाभागे कुले जाते यशस्विनि ।\nयन्मे पुत्रेषु सर्वेषु यथावत्त्वमवर्तिथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2040336, "chapter_id": 1892, "verse_number": "५-१३७-१४", "content_sanskrit": "माद्रीपुत्रौ च वक्तव्यौ क्षत्रधर्मरतावुभौ ।\nविक्रमेणार्जितान्भोगान्वृणीतं जीवितादपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2040337, "chapter_id": 1892, "verse_number": "५-१३७-१५", "content_sanskrit": "विक्रमाधिगता ह्यर्थाः क्षत्रधर्मेण जीवतः ।\nमनो मनुष्यस्य सदा प्रीणन्ति पुरुषोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2040338, "chapter_id": 1892, "verse_number": "५-१३७-१६", "content_sanskrit": "यच्च वः प्रेक्षमाणानां सर्वधर्मोपचायिनाम्।\nपाञ्चाली परुषाण्युक्तका को नु तत्क्षन्तुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2040339, "chapter_id": 1892, "verse_number": "५-१३७-१७", "content_sanskrit": "न राज्यहरणं दुःखं द्यूते चापि पराजयः।\nप्रव्राजनं सुतानां वा न मे तद्दुःखकारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2040340, "chapter_id": 1892, "verse_number": "५-१३७-१८", "content_sanskrit": "यत्र सा बृहती श्यामा सभायां रुदती तदा।\nअश्रौषीत्परुषा वाचस्तन्मे दुःखतरं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2040341, "chapter_id": 1892, "verse_number": "५-१३७-१९", "content_sanskrit": "स्त्रीधर्मिणी वरारोहा क्षत्रधर्मरता सदा।\nनाध्यगच्छत्तदा नाथं कृष्णा नाथवती सती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2040342, "chapter_id": 1892, "verse_number": "५-१३७-२०", "content_sanskrit": "तं वै ब्रूहि महाबाहो सर्वशस्त्रभृतां वरम् ।\nअर्जुनं पुरुषव्याघ्रं द्रौपद्याः पदवीं चर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2040343, "chapter_id": 1892, "verse_number": "५-१३७-२१", "content_sanskrit": "विदितं हि तवात्यन्तं क्रूद्धाविव यमान्तकौ ।\nभीमार्जुनौ नयेतां हि देवानपि परां गतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2040344, "chapter_id": 1892, "verse_number": "५-१३७-२२", "content_sanskrit": "तयोश्चैतदवज्ञानं यत्सा कृष्णा सभागता।\nदुःशासनश्च यद्भीमं कटुकान्यभ्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2040345, "chapter_id": 1892, "verse_number": "५-१३७-२३", "content_sanskrit": "पश्यतां कुरुवीराणां तच्च संस्मारयेः पुनः ।\nपाण्डवान्कुशलं पृच्छेः सपुत्रान्कृष्णया सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2040346, "chapter_id": 1892, "verse_number": "५-१३७-२४", "content_sanskrit": "मां वै कुशलिनीं ब्रूयास्तेषु भूयो जनार्दन ।\nअरिष्टं गच्छ पन्थानं पुत्रान्मे प्रतिपालय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2040347, "chapter_id": 1892, "verse_number": "५-१३७-२५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2040348, "chapter_id": 1892, "verse_number": "५-१३७-२५", "content_sanskrit": "अभिवाद्याथ तां कृष्णः कृत्वा चापि प्रदक्षिणम्।\nनिश्चक्राम महाबाहुः सिंहखेलगतिस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2040349, "chapter_id": 1892, "verse_number": "५-१३७-२६", "content_sanskrit": "ततो विसर्जयामास भीष्मादीन्कुरुपुङ्गवान्।\nआरोप्याथ रथे कर्णं प्रायात्सात्यकिना सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2040350, "chapter_id": 1892, "verse_number": "५-१३७-२७", "content_sanskrit": "ततः प्रयाते दाशार्हे कुरवः सङ्गता मिथः ।\nजजल्पुर्महदाश्चर्यं केशवे परमाद्भुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2040351, "chapter_id": 1892, "verse_number": "५-१३७-२८", "content_sanskrit": "प्रमूढा पृथिवी सर्वा मृत्युपाशवशीकृता ।\nदुर्योधनस्य बालिश्यान्नैतदस्तीति चाब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2040352, "chapter_id": 1892, "verse_number": "५-१३७-२९", "content_sanskrit": "ततो निर्याय नगरात्प्रययौ पुरुषोत्तमः ।\nमन्त्रयामास च तदा कर्णेन सुचिरं सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2040353, "chapter_id": 1892, "verse_number": "५-१३७-३०", "content_sanskrit": "विसर्जयित्वा राधेयं सर्वयादवनन्दनः।\nततो जवेन महता तूर्णमश्वानचोदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2040354, "chapter_id": 1892, "verse_number": "५-१३७-३१", "content_sanskrit": "ते पिबन्त इवाकाशं दारुकेण प्रचोदिताः ।\nहया जग्मुर्महावेगा मनोमारुतरंहसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2040355, "chapter_id": 1892, "verse_number": "५-१३७-३२", "content_sanskrit": "ते व्यतीत्य महाध्वानं क्षिप्रं श्येना इवाशुगाः ।\nउच्चैर्जग्मुरुपप्लाव्यं शार्ङ्गधन्वानमावहन् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2040356, "chapter_id": 1892, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि सप्तत्रिंशदधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]