[{"id": 5000101000, "chapter_id": 9101, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे चतुर्विंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000101001, "chapter_id": 9101, "verse_number": "२-२४-१", "content_sanskrit": "तं समीक्ष्य व्यवसितं पितुर्निर्देशपालने।\nकौसल्या बाष्पसंरुद्धा वचो धर्मिष्ठमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000101002, "chapter_id": 9101, "verse_number": "२-२४-२", "content_sanskrit": "अदृष्टदुःखो धर्मात्मा सर्वभूतप्रियंवदः।\nमयि जातो दशरथात् कथमुञ्छेन वर्तयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000101003, "chapter_id": 9101, "verse_number": "२-२४-३", "content_sanskrit": "यस्य भृत्याश्च दासाश्च मृष्टान्यन्नानि भुञ्जते।\nकथं स भोक्ष्यते रामो वने मूलफलान्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000101004, "chapter_id": 9101, "verse_number": "२-२४-४", "content_sanskrit": "क एतच्छ्रद्दधेच्छ्रुत्वा कस्य वा न भवेद् भयम्।\nगुणवान् दयितो राज्ञः काकुत्स्थो यद् विवास्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000101005, "chapter_id": 9101, "verse_number": "२-२४-५", "content_sanskrit": "नूनं तु बलवाँल्लोके कृतान्तः सर्वमादिशन्।\nलोके रामाभिरामस्त्वं वनं यत्र गमिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000101006, "chapter_id": 9101, "verse_number": "२-२४-६", "content_sanskrit": "अयं तु मामात्मभवस्तवादर्शनमारुतः।\nविलापदुःखसमिधो रुदिताश्रुहुताहुतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000101007, "chapter_id": 9101, "verse_number": "२-२४-७", "content_sanskrit": "चिन्ताबाष्पमहाधूमस्तवागमनचिन्तजः।\nकर्शयित्वाधिकं पुत्र निःश्वासायाससम्भवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000101008, "chapter_id": 9101, "verse_number": "२-२४-८", "content_sanskrit": "त्वया विहीनामिह मां शोकाग्निरतुलो महान्।\nप्रधक्ष्यति यथा कक्ष्यं चित्रभानुर्हिमात्यये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000101009, "chapter_id": 9101, "verse_number": "२-२४-९", "content_sanskrit": "कथं हि धेनुः स्वं वत्सं गच्छन्तमनुगच्छति।\nअहं त्वानुगमिष्यामि यत्र वत्स गमिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000101010, "chapter_id": 9101, "verse_number": "२-२४-१०", "content_sanskrit": "यथा निगदितं मात्रा तद् वाक्यं पुरुषर्षभः।\nश्रुत्वा रामोऽब्रवीद् वाक्यं मातरं भृशदुःखिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000101011, "chapter_id": 9101, "verse_number": "२-२४-११", "content_sanskrit": "कैकेय्या वञ्चितो राजा मयि चारण्यमाश्रिते।\nभवत्या च परित्यक्तो न नूनं वर्तयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000101012, "chapter_id": 9101, "verse_number": "२-२४-१२", "content_sanskrit": "भर्तुः किल परित्यागो नृशंसः केवलं स्त्रियाः।\nस भवत्या न कर्तव्यो मनसापि विगर्हितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000101013, "chapter_id": 9101, "verse_number": "२-२४-१३", "content_sanskrit": "यावज्जीवति काकुत्स्थः पिता मे जगतीपतिः।\nशुश्रूषा क्रियतां तावत् स हि धर्मः सनातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000101014, "chapter_id": 9101, "verse_number": "२-२४-१४", "content_sanskrit": "एवमुक्ता तु रामेण कौसल्या शुभदर्शना।\nतथेत्युवाच सुप्रीता राममक्लिष्टकारिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000101015, "chapter_id": 9101, "verse_number": "२-२४-१५", "content_sanskrit": "एवमुक्तस्तु वचनं रामो धर्मभृतां वरः।\nभूयस्तामब्रवीद् वाक्यं मातरं भृशदुःखिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000101016, "chapter_id": 9101, "verse_number": "२-२४-१६", "content_sanskrit": "मया चैव भवत्या च कर्तव्यं वचनं पितुः।\nराजा भर्ता गुरुः श्रेष्ठः सर्वेषामीश्वरः प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000101017, "chapter_id": 9101, "verse_number": "२-२४-१७", "content_sanskrit": "इमानि तु महारण्ये विहृत्य नव पञ्च च।\nवर्षाणि परमप्रीत्या स्थास्यामि वचने तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000101018, "chapter_id": 9101, "verse_number": "२-२४-१८", "content_sanskrit": "एवमुक्ता प्रियं पुत्रं बाष्पपूर्णानना तदा।\nउवाच परमार्ता तु कौसल्या सुतवत्सला ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000101019, "chapter_id": 9101, "verse_number": "२-२४-१९", "content_sanskrit": "आसां राम सपत्नीनां वस्तुं मध्ये न मे क्षमम्।\nनय मामपि काकुत्स्थ वनं वन्यां मृगीमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000101020, "chapter_id": 9101, "verse_number": "२-२४-२०", "content_sanskrit": "यदि ते गमने बुद्धिः कृता पितरपेक्षया।\nतां तथा रुदतीं रामो रुदन् वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000101021, "chapter_id": 9101, "verse_number": "२-२४-२१", "content_sanskrit": "जीवन्त्या हि स्त्रिया भर्ता दैवतं प्रभुरेव च।\nभवत्या मम चैवाद्य राजा प्रभवति प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000101022, "chapter_id": 9101, "verse_number": "२-२४-२२", "content_sanskrit": "न ह्यनाथा वयं राज्ञा लोकनाथेन धीमता।\nभरतश्चापि धर्मात्मा सर्वभूतप्रियंवदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000101023, "chapter_id": 9101, "verse_number": "२-२४-२४", "content_sanskrit": "भवतीमनुवर्तेत स हि धर्मरतः सदा।\nदारुणश्चाप्ययं शोको यथैनं न विनाशयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000101024, "chapter_id": 9101, "verse_number": "२-२४-२५", "content_sanskrit": "राज्ञो वृद्धस्य सततं हितं चर समाहिता।\nव्रतोपवासनिरता या नारी परमोत्तमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000101025, "chapter_id": 9101, "verse_number": "२-२४-२६", "content_sanskrit": "भर्तारं नानुवर्तेत सा च पापगतिर्भवेत्।\nभर्तुः शुश्रूषया नारी लभते स्वर्गमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000101026, "chapter_id": 9101, "verse_number": "२-२४-२७", "content_sanskrit": "अपि या निर्नमस्कारा निवृत्ता देवपूजनात्।\nशुश्रूषामेव कुर्वीत भर्तुः प्रियहिते रता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000101027, "chapter_id": 9101, "verse_number": "२-२४-२८", "content_sanskrit": "एष धर्मः स्त्रिया नित्यो वेदे लोके श्रुतः स्मृतः।\nअग्निकार्येषु च सदा सुमनोभिश्च देवताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000101028, "chapter_id": 9101, "verse_number": "२-२४-२९", "content_sanskrit": "पूज्यास्ते मत्कृते देवि ब्राह्मणाश्चैव सत्कृताः।\nएवं कालं प्रतीक्षस्व ममागमनकांक्षिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000101029, "chapter_id": 9101, "verse_number": "२-२४-३०", "content_sanskrit": "नियता नियताहारा भर्तृशुश्रूषणे रता।\nप्राप्स्यसे परमं कामं मयि पर्यागते सति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000101030, "chapter_id": 9101, "verse_number": "२-२४-३१", "content_sanskrit": "यदि धर्मभृतां श्रेष्ठो धारयिष्यति जीवितम्।\nएवमुक्ता तु रामेण बाष्पपर्याकुलेक्षणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000101031, "chapter_id": 9101, "verse_number": "२-२४-३२", "content_sanskrit": "कौसल्या पुत्रशोकार्ता रामं वचनमब्रवीत्।\nगमने सुकृतां बुद्धिं न ते शक्नोमि पुत्रक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000101032, "chapter_id": 9101, "verse_number": "२-२४-३३", "content_sanskrit": "विनिवर्तयितुं वीर नूनं कालो दुरत्ययः।\nगच्छ पुत्र त्वमेकाग्रो भद्रं तेऽस्तु सदा विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000101033, "chapter_id": 9101, "verse_number": "२-२४-३४", "content_sanskrit": "पुनस्त्वयि निवृत्ते तु भविष्यामि गतक्लमा।\nप्रत्यागते महाभागे कृतार्थे चरितव्रते।\nपितुरानृण्यतां प्राप्ते स्वपिष्ये परमं सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000101034, "chapter_id": 9101, "verse_number": "२-२४-३५", "content_sanskrit": "कृतान्तस्य गतिः पुत्र दुर्विभाव्या सदा भुवि।\nयस्त्वां संचोदयति मे वच आविध्य राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000101035, "chapter_id": 9101, "verse_number": "२-२४-३६", "content_sanskrit": "गच्छेदानीं महाबाहो क्षेमेण पुनरागतः।\nनन्दयिष्यसि मां पुत्र साम्ना श्लक्ष्णेन चारुणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000101036, "chapter_id": 9101, "verse_number": "२-२४-३७", "content_sanskrit": "अपीदानीं स कालः स्याद् वनात् प्रत्यागतं पुनः।\nयत् त्वां पुत्रक पश्येयं जटावल्कलधारिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000101037, "chapter_id": 9101, "verse_number": "२-२४-३८", "content_sanskrit": "तथा हि रामं वनवासनिश्चितं\nददर्श देवी परमेण चेतसा।\nउवाच रामं शुभलक्षणं वचो\nबभूव च स्वस्त्ययनाभिकांक्षिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000101038, "chapter_id": 9101, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे चतुर्विंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]