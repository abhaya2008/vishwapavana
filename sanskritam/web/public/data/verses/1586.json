[{"id": 2027275, "chapter_id": 1586, "verse_number": "३-२२४-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2027276, "chapter_id": 1586, "verse_number": "३-२२४-१", "content_sanskrit": "आपस्य मुदिता भार्या सा चास्य परमाप्रिया।\nभूपतिं भूतकर्तारं जनयामास पावकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2027277, "chapter_id": 1586, "verse_number": "३-२२४-२", "content_sanskrit": "भूतानां साऽपि सर्वेषां यं प्राहुः पावकं पतिम्।\nआत्मा भुवनकर्ता च सोऽध्वरेषु द्विजातिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2027278, "chapter_id": 1586, "verse_number": "३-२२४-३", "content_sanskrit": "महतां चैव भूतानां सर्वेषामिह यः पतिः।\nभगवान्स महातेजा नित्यं चरति पावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2027279, "chapter_id": 1586, "verse_number": "३-२२४-४", "content_sanskrit": "अग्निर्गृहपतिर्नाम नित्यं यज्ञेषु पूज्यते।\nआज्यं वहतियो हव्यं सर्वलोकस् पावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2027280, "chapter_id": 1586, "verse_number": "३-२२४-५", "content_sanskrit": "अपांगर्भो महाभागः सत्वभुग्यो महाद्भुतः।\nभूपतिर्भूतकर्ता च महतः पतिरुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2027281, "chapter_id": 1586, "verse_number": "३-२२४-६", "content_sanskrit": "मता वहन्तो हव्यानि तस्याग्नेरप्रजाऽभवन्।\nअग्निष्टोमस्तु नियतः क्रतुश्रेष्ठो भवत्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2027282, "chapter_id": 1586, "verse_number": "३-२२४-७", "content_sanskrit": "[स वह्निः प्रथमो नित्यं देवैरन्विष्यते प्रभुः]।\nआयान्तं नियतं दृष्ट्वाप्रविवेशार्णवं भयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2027283, "chapter_id": 1586, "verse_number": "३-२२४-८", "content_sanskrit": "देवास्तं नाधिगच्छन्ति मार्गमाणा यथातथम्।\nदृष्ट्वा त्वग्निरथर्वाणं ततो वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2027284, "chapter_id": 1586, "verse_number": "३-२२४-९", "content_sanskrit": "देवानां वह हव्यं त्वमहं वीर सुदुर्बलः।\nअथ त्वं गच्छ मध्वक्षं प्रियमेतत्कुरुष्व मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2027285, "chapter_id": 1586, "verse_number": "३-२२४-१०", "content_sanskrit": "प्रेष्य चाग्निरथर्वाणमन्यं देशं ततोऽगमत्।\nमत्स्यास्तस्य समाचख्युः क्रुद्धस्तानग्निरब्रवीत्।\nभक्ष्या वै विविधैर्भावैर्भविष्यथ शरीरिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2027286, "chapter_id": 1586, "verse_number": "३-२२४-११", "content_sanskrit": "अथर्वाणं तथा चापि हव्यवाहोऽब्रवीद्वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2027287, "chapter_id": 1586, "verse_number": "३-२२४-१२", "content_sanskrit": "अनुनीयमानो हि भृशं देववाक्यान्वितेन सः।\nनैच्छद्वोढुं हवि सर्वं शरीरं चापि सोऽत्यजत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2027288, "chapter_id": 1586, "verse_number": "३-२२४-१३", "content_sanskrit": "स तच्छरीरं संत्यज्य प्रविवेश धरां तदा।\nभूमिं स्पृष्ट्वाऽसृजद्भ्रातून्पृथक्पृथगतीव हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2027289, "chapter_id": 1586, "verse_number": "३-२२४-१४", "content_sanskrit": "आस्यात्सुगन्धं तेजश्च अस्थिभ्यो देवदारु च।\nश्लेष्मणः स्फाटिकं तस् पित्तान्मारकतं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2027290, "chapter_id": 1586, "verse_number": "३-२२४-१५", "content_sanskrit": "वातात्कृष्णायसं तस्य त्रिभिरेतैर्बहु प्रजाः।\nत्वचस्तस्याभ्रपटलं स्नायुजं चापि विद्रुमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2027291, "chapter_id": 1586, "verse_number": "३-२२४-१६", "content_sanskrit": "शरीरास्थिविधाश्चान्ये धातवोऽस्याभवन्नृप।\nएवं कृत्वा शरीरं च परमे तपसि स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2027292, "chapter_id": 1586, "verse_number": "३-२२४-१७", "content_sanskrit": "भृग्वङ्गिरादिभिर्भूयस्तपसोत्थापितस्तदा।\nभृशं जज्वाल तेजस्वी तपसाऽऽप्याधितः शिखी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2027293, "chapter_id": 1586, "verse_number": "३-२२४-१८", "content_sanskrit": "दृष्ट्वा ऋषीनभयाच्चापि प्रविवेश महार्णवम्।\nतस्मिन्नष्टे जगद्भीतमथर्वाणमथाश्रितम्।\nअर्चयामासुरेवैनमथर्वाणं सुरादयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2027294, "chapter_id": 1586, "verse_number": "३-२२४-१९", "content_sanskrit": "अथर्वाणं श्रिताँल्लोकानात्मन्यालोच्य पावकः।\nमिषतां सर्वभूतानामुन्ममज्ज महार्णवात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2027295, "chapter_id": 1586, "verse_number": "३-२२४-२०", "content_sanskrit": "एवमग्निर्भगवता नष्टः पूर्वमथर्वणा।\nआहूतः सर्वूतानां हव्यं वहति सर्वदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2027296, "chapter_id": 1586, "verse_number": "३-२२४-२१", "content_sanskrit": "एवं त्वजनयद्धिष्ण्यान्वेदोक्तान्विबुधान्बहून्।\nविचरन्विविधान्देशान्भ्रममाणस्तु तत्र वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2027297, "chapter_id": 1586, "verse_number": "३-२२४-२२", "content_sanskrit": "सिन्धुवर्ज्याः पञ्च नद्यो देविकाऽथ सरस्वती।\nगङ्गा च शतकुम्भा च सरयू गण्डसाह्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2027298, "chapter_id": 1586, "verse_number": "३-२२४-२३", "content_sanskrit": "चर्मण्वती मही चैव मेध्या मेधासृतिस्तदा।\nइरावती वेत्रवती नद्यतिस्रोऽथ कौशिकी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2027299, "chapter_id": 1586, "verse_number": "३-२२४-२४", "content_sanskrit": "तमसा नर्मदा चैव नदी गोदावरी तथा।\nवेण्णा प्रवेणी भीमा च मरुदा चैव भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2027300, "chapter_id": 1586, "verse_number": "३-२२४-२५", "content_sanskrit": "भारती सुप्रयोगा च कावेरी मज्जुरा तथा।\nतुङ्गवेणा कृष्णवेणा कपिला शोण एव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2027301, "chapter_id": 1586, "verse_number": "३-२२४-२६", "content_sanskrit": "एता नद्यस्तु धिष्ण्यानां मातरो याः प्रकीर्तिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2027302, "chapter_id": 1586, "verse_number": "३-२२४-२७", "content_sanskrit": "अद्भुतस्य प्रिया भार्या तस्याः पुत्रो विडूरथः।\nयावन्तः पावकाः प्रोक्ताः सोमास्तावन्त एव तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2027303, "chapter_id": 1586, "verse_number": "३-२२४-२८", "content_sanskrit": "अत्रेश्चाप्यन्वये जाता ब्रह्मणो मानसाः प्रजाः।\nअग्निः पुत्रान्स्रष्टुकामस्तानेवात्मन्यधारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2027304, "chapter_id": 1586, "verse_number": "३-२२४-२९", "content_sanskrit": "तस्य तद्ब्रह्मणः कायान्निर्हरन्ति हुताशनाः।\nएवमेते महात्मानः कीर्तितास्तेऽग्नयो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2027305, "chapter_id": 1586, "verse_number": "३-२२४-३०", "content_sanskrit": "अप्रमेया यथोत्पन्नाः श्रीमन्तस्तिमिरापहाः।\nअद्भुतस्त तु माहात्म्यं यथा वेदेषु कीर्तितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2027306, "chapter_id": 1586, "verse_number": "३-२२४-३१", "content_sanskrit": "तादृशं विद्धि सर्वेषामेको ह्येषु हुताशनः।\nएक एवैष भगवान्विज्ञेयः प्रथमोऽङ्गिराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2027307, "chapter_id": 1586, "verse_number": "३-२२४-३२", "content_sanskrit": "बहुधा निःसृतः कायाज्ज्योतिष्टोमः क्रतुर्वथा।\nइत्येष वंशः सुमहानग्नीनां कीर्तितो मया।\nपावको विविधैर्मन्त्रैर्हव्यं वहति देहिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2027308, "chapter_id": 1586, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीन्ममहाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि चतुर्विंसत्यधिकद्विशततमोऽध्यायः ॥ २२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]