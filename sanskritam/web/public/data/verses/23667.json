[{"id": 7003667000, "chapter_id": 23667, "verse_number": "१-२-५४-१", "content_sanskrit": "नारद उवाच ।\nममापि पार्थ तत्रास्ति मूर्तिर्ब्राह्मणकाम्यया ।\nतत्र नाहं त्यजाम्यंग च्छत्रदण्डविभूषिताम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003667001, "chapter_id": 23667, "verse_number": "१-२-५४-२", "content_sanskrit": "कार्तिकस्य तु या शुक्ला भवत्येकादशी शुभा ।\nतस्यां मदर्चनं कृत्वा कलिदोषैर्विमुच्यते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003667002, "chapter_id": 23667, "verse_number": "१-२-५४-३", "content_sanskrit": "अर्जुन उवाच ।\nबाल्यात्प्रभृति संदेहो ममायं हृदि वर्तते ।\nपृच्छतस्तं च मे विप्र न क्रोधं कर्तुमर्हसि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003667003, "chapter_id": 23667, "verse_number": "१-२-५४-४", "content_sanskrit": "सदा त्वं मोक्षधर्मेषु परिनिष्ठां परां गतः ।\nसर्वभूतसमो दांतो रागद्वेषविवर्जितः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003667004, "chapter_id": 23667, "verse_number": "१-२-५४-५", "content_sanskrit": "त्यक्तनिंदास्तुतिर्मौनी मोक्षस्थः परिकीर्त्यसे ।\nत्वं च नारद लोकेषु वायुवच्चपलो मुने ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003667005, "chapter_id": 23667, "verse_number": "१-२-५४-६", "content_sanskrit": "सौदामिनीव विचरन्दृश्यसे प्राज्ञसंमतः ।\nसदा कलिकरो लोके निर्दयः सर्वप्राणिषु ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003667006, "chapter_id": 23667, "verse_number": "१-२-५४-७", "content_sanskrit": "बहूनां हि सहस्राणि देवगंधर्वरक्षसाम् ।\nराज्ञां मुनीन्द्रदैत्यानां कलेर्नष्टानि तेऽभवन् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003667007, "chapter_id": 23667, "verse_number": "१-२-५४-८", "content_sanskrit": "कस्मात्तदेषा चेष्टा ते संदेहं मे हर द्विज ।\nसंदेहान्न सुखं शेते बाणविद्धो मृगो यथा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003667008, "chapter_id": 23667, "verse_number": "१-२-५४-९", "content_sanskrit": "सूत उवाच ।\nशौनकेदं वचः श्रुत्वा फाल्गुनान्नारदो मुनिः ।\nप्रहसन्निव बाभ्रव्यवदनं स निरैक्षत ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003667009, "chapter_id": 23667, "verse_number": "१-२-५४-१०", "content_sanskrit": "स च बाभ्रव्यनामा वै हारीतस्यान्वयोद्भवः ।\nब्राह्मणो नारदमुनेः समीपे वर्तते सदा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003667010, "chapter_id": 23667, "verse_number": "१-२-५४-११", "content_sanskrit": "स च ज्ञात्वा महाबुद्धिर्नारदस्य मनीषितम् ।\nप्रहसन्निव प्रोवाच फाल्गुनं स्निग्धया गिरा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003667011, "chapter_id": 23667, "verse_number": "१-२-५४-१२", "content_sanskrit": "बाभ्रव्य उवाच ।\nसत्यमेतद्यथात्थ त्वं नारदं प्रति पांडव ।\nसर्वोऽपि चात्र वृत्तांते संशयं याति मानवः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003667012, "chapter_id": 23667, "verse_number": "१-२-५४-१३", "content_sanskrit": "तदहं ते प्रवक्ष्यामि यथा कृष्णान्मया श्रुतम् ।\nस्तोककालांतरे पूर्वं सर्वं यादवनंदनः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003667013, "chapter_id": 23667, "verse_number": "१-२-५४-१४", "content_sanskrit": "महीसागरयात्रायां कृष्णस्तत्राययौ प्रभुः ।\nउग्रसेनेन सहितो वसुदेवेन बभ्रुणा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003667014, "chapter_id": 23667, "verse_number": "१-२-५४-१५", "content_sanskrit": "रामेण रौक्मिणेयेन युयुधानादिभिस्तदा ।\nस च ज्ञात्वा ज्ञातिसमं महीसागरसंगमे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003667015, "chapter_id": 23667, "verse_number": "१-२-५४-१६", "content_sanskrit": "पिंडदानादिकं कृत्वा दत्त्वा दानानि भूरिशः ।\nगुहेश्वरादिलिंगानि यत्नतः प्रतिपूज्य च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003667016, "chapter_id": 23667, "verse_number": "१-२-५४-१७", "content_sanskrit": "स्नानं कृत्वा कोटितीर्थे जयादित्यं समर्च्य च ।\nपूजयन्नारदमुनिं युक्तः कृष्णो महामनाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003667017, "chapter_id": 23667, "verse_number": "१-२-५४-१८", "content_sanskrit": "उग्रसेनेन राज्ञा वै पूर्वजेन जटायुना ।\nमदादिविप्रमुख्यानां बहूनां चोपशृण्वताम् ।\nउग्रसेनो महाराजः कृष्णं प्रोवाच संसदि ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003667018, "chapter_id": 23667, "verse_number": "१-२-५४-१९", "content_sanskrit": "उग्रसेन उवाच ।\nकृष्ण प्रक्ष्यामि त्वामेकं संशयं वद तं मम ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003667019, "chapter_id": 23667, "verse_number": "१-२-५४-२०", "content_sanskrit": "योऽयं नाम महाबुद्धिर्नारदो विश्ववंदितः ।\nकस्मादेषोऽतिचपलो वायुवद्भ्रमते जगत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003667020, "chapter_id": 23667, "verse_number": "१-२-५४-२१", "content_sanskrit": "कलिप्रियश्च कस्माद्वा कस्मात्त्वय्यतिप्रीतिमान् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003667021, "chapter_id": 23667, "verse_number": "१-२-५४-२२", "content_sanskrit": "श्रीकृष्ण उवाच ।\nसत्यं राजंस्त्वया पृष्टमेतत्सर्वं वदामि ते ।\nदक्षेण तु पुरा शप्तो नारदो मुनिसत्तमः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003667022, "chapter_id": 23667, "verse_number": "१-२-५४-२३", "content_sanskrit": "सृष्टिमार्गांस्तु तान्वीक्ष्य नारदेन विचालितान् ।\nनावस्थानं च लोकेषु भ्रमतस्ते भविष्यति ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003667023, "chapter_id": 23667, "verse_number": "१-२-५४-२४", "content_sanskrit": "पैशुन्य वक्ता च तथा द्वितीयानां प्रचालनात् ।\nइति शापद्वयं प्राप्य द्विविधात्मजचालनात् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003667024, "chapter_id": 23667, "verse_number": "१-२-५४-२५", "content_sanskrit": "निराकर्तुं समर्थोऽपि मुनिर्मेने तथैव तत् ।\nएतावान्साधुवादो हि यतश्च क्षमते स्वयम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003667025, "chapter_id": 23667, "verse_number": "१-२-५४-२६", "content_sanskrit": "विनाशकालं चावेक्ष्य कलिं वर्धयते यतः ।\nसत्यं च वक्ति तस्मात्स न च पापेन लिप्यते ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003667026, "chapter_id": 23667, "verse_number": "१-२-५४-२७", "content_sanskrit": "भ्रमतोऽपि च सर्वत्र नास्य यस्मात्पृथङ्मनः ।\nध्येयाद्भवति नैव स्याद्भ्रमदोषस्ततोस्य च ।\nयच्च प्रीतिर्मयि तस्य परमा तच्छृणुष्व च ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003667027, "chapter_id": 23667, "verse_number": "१-२-५४-२८", "content_sanskrit": "अहं हि सर्वदा स्तौमि नारदं देवदर्शनम् ।\nमहेंद्रगदितेनैव स्तोत्रेण शृणु तन्नृप ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003667028, "chapter_id": 23667, "verse_number": "१-२-५४-२९", "content_sanskrit": "श्रुतचारित्रयोर्जाता यस्याहंता न विद्यते ।\nअगुप्तश्रुत चारित्रं नारदं तं नमाम्यहम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003667029, "chapter_id": 23667, "verse_number": "१-२-५४-३०", "content_sanskrit": "अरतिक्रोधचापल्ये भयं नैतानि यस्य च ।\nअदीर्घसूत्रं धीरं च नारदं तं नमाम्यहम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003667030, "chapter_id": 23667, "verse_number": "१-२-५४-३१", "content_sanskrit": "कामाद्वा यदि वा लोभाद्वाचं यो नान्यथा वदेत् ।\nउपास्यं सर्वजंतूनां नारदं तं नमाम्यहम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003667031, "chapter_id": 23667, "verse_number": "१-२-५४-३२", "content_sanskrit": "अध्यात्मगतितत्त्वज्ञं क्षांतं शक्तं जितेंद्रियम् ।\nऋजुं यथार्थ वक्तारं नारदं तं नमाम्यहम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003667032, "chapter_id": 23667, "verse_number": "१-२-५४-३३", "content_sanskrit": "तेजसा यशसा बुद्ध्या नयेन विनयेन च ।\nजन्मना तपसा वृद्धं नारदं तं नमाम्यहम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003667033, "chapter_id": 23667, "verse_number": "१-२-५४-३४", "content_sanskrit": "सुखशीलं सुखं वेषं सुभोजं स्वाचरं शुभम् ।\nसुचक्षुषं सुवाक्यं च नारदं तं नमाम्यहम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003667034, "chapter_id": 23667, "verse_number": "१-२-५४-३५", "content_sanskrit": "कल्याणं कुरुते गाढं पापं यस्य न विद्यते ।\nन प्रीयते परानर्थे यो ऽसौ तं नौमि नारदम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003667035, "chapter_id": 23667, "verse_number": "१-२-५४-३६", "content_sanskrit": "वेदस्मृतिपुराणोक्तधर्मे यो नित्यमास्थितः ।\nप्रियाप्रियविमुक्तं तं नारदं प्रणमाम्यहम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003667036, "chapter_id": 23667, "verse_number": "१-२-५४-३७", "content_sanskrit": "अशनादिष्वलिप्तं च पंडितं नालसं द्विजम् ।\nबहुश्रुतं चित्रकथं नारदं प्रणमाम्यहम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003667037, "chapter_id": 23667, "verse_number": "१-२-५४-३८", "content_sanskrit": "नार्थे क्रोधे च कामे च भूतपूर्वोऽस्य विभ्रमः ।\nयेनैते नाशिता दोषा नारदं तं नमाम्यहम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003667038, "chapter_id": 23667, "verse_number": "१-२-५४-३९", "content_sanskrit": "वीतसंमोहदोषो यो दृढभक्तिश्च श्रेयसि ।\nसुनयं सत्रपं तं च नारदं प्रणमाम्यहम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003667039, "chapter_id": 23667, "verse_number": "१-२-५४-४०", "content_sanskrit": "असक्तः सर्वसंगेषु यः सक्तात्मेति लक्ष्यते ।\nअदीर्घसंशंयो वाग्ग्मी नारदं तं नमाम्यहम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003667040, "chapter_id": 23667, "verse_number": "१-२-५४-४१", "content_sanskrit": "न त्यजत्यागमं किंचिद्यस्तपो नोपजीवति ।\nअवंध्यकालो यस्यात्मा तमहं नौमि नारदम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003667041, "chapter_id": 23667, "verse_number": "१-२-५४-४२", "content_sanskrit": "कृतश्रमं कृतप्रज्ञं न च तृप्तं समाधितः ।\nनित्यं यत्नात्प्रमत्तं च नारदं तं नमाम्यहम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003667042, "chapter_id": 23667, "verse_number": "१-२-५४-४३", "content_sanskrit": "न हृष्यत्यर्थलाभेन योऽलाभे न व्यथत्यपि ।\nस्थिरबुद्धिरसक्तात्मा तमहं नौमि नारदम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003667043, "chapter_id": 23667, "verse_number": "१-२-५४-४४", "content_sanskrit": "तं सर्वगुणसंपन्नं दक्षं शुचिमकातरम् ।\nकालज्ञं च नयज्ञं च शरणं यामि नारदम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003667044, "chapter_id": 23667, "verse_number": "१-२-५४-४५", "content_sanskrit": "इमं स्तवं नारदस्य नित्यं राजन्पठाम्यहम् ।\nतेन मे परमा प्रीतिं करोति मुनिसत्तमः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003667045, "chapter_id": 23667, "verse_number": "१-२-५४-४६", "content_sanskrit": "अन्योपि यः शुचिर्भूत्वा नित्यमेतां स्तुतिं जपेत् ।\nअचिरात्तस्य देवर्षिः प्रसादं कुरुते परम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003667046, "chapter_id": 23667, "verse_number": "१-२-५४-४७", "content_sanskrit": "एतान्गुणान्नारदस्य त्वमथाकर्ण्य पार्थिव ।\nजप नित्यं स्तवं पुण्यं प्रीतस्ते भविता मुनिः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003667047, "chapter_id": 23667, "verse_number": "१-२-५४-४८", "content_sanskrit": "बाभ्रव्य उवाच ।\nइति कृष्णमुखाच्छ्रुत्वा नारदस्य गुणान्नृपः ।\nबभूव परमप्री तश्चक्रे तच्च तथा वचः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003667048, "chapter_id": 23667, "verse_number": "१-२-५४-४९", "content_sanskrit": "ततो नारदमानर्च दत्त्वा दानं च पुष्कलम् ।\nनारदीयद्विजाग्र्याणां नारदः प्रीयतामिति ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003667049, "chapter_id": 23667, "verse_number": "१-२-५४-५०", "content_sanskrit": "ययौ द्वारवतीं कृष्णः सभ्रातृजातिबांधवः ।\nतीर्थयात्रामिमां कृत्वा विधिवत्पुरुषोत्तमः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003667050, "chapter_id": 23667, "verse_number": "१-२-५४-५१", "content_sanskrit": "तथा त्वमपि कौरव्य नारदस्य गुणानिमान् ।\nश्रुत्वा श्रद्धामयो भूत्वा शृणु कृत्यं यदत्र च ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003667051, "chapter_id": 23667, "verse_number": "१-२-५४-५२", "content_sanskrit": "कार्तिके शुक्लद्वादश्यां प्रबोधिन्यामसौ मुनिः ।\nविष्णोर्ध्यानसमाधेश्च प्रबुद्धो जायते सदा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003667052, "chapter_id": 23667, "verse_number": "१-२-५४-५३", "content_sanskrit": "तस्मिन्दिने नारदेन निर्मितेऽत्रैव कूपके ।\nस्नानं कृत्वा प्रयत्नेन श्राद्धं कुर्यात्समाहितः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003667053, "chapter_id": 23667, "verse_number": "१-२-५४-५४", "content_sanskrit": "तपो दानं जपश्चात्र कूपे भवति चाक्षयम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003667054, "chapter_id": 23667, "verse_number": "१-२-५४-५५", "content_sanskrit": "इदं विष्ण्विति मंत्रेण ततो विष्णुं प्रबोधयेत् ।\nनारदं च मुनिं पश्चान्मन्त्रेणानेन पांडव ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003667055, "chapter_id": 23667, "verse_number": "१-२-५४-५६", "content_sanskrit": "योगनिद्रा यथा त्यक्ता हरिणा मुनिसत्तम ।\nतथा लोकोपकाराय भवानपि परित्यज ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003667056, "chapter_id": 23667, "verse_number": "१-२-५४-५७", "content_sanskrit": "इति मंत्रेण चोत्थाप्य नारदं परिपूजयेत् ।\nकृष्णप्रोदितया स्तुत्या छत्रधोत्रार्चनैः शुभैः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003667057, "chapter_id": 23667, "verse_number": "१-२-५४-५८", "content_sanskrit": "शक्त्या द्विजानां देयं च छत्रं धोत्रं कमंडलुम् ।\nप्रणम्य ब्राह्मणान्भक्त्या नारदः प्रीयतामिति ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003667058, "chapter_id": 23667, "verse_number": "१-२-५४-५९", "content_sanskrit": "एवं कृते प्रसादात्स मुनेः पापेन मुच्यते ।\nजायते न कलिस्तस्य न चासौख्यं भवेदिह ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003667059, "chapter_id": 23667, "verse_number": "१-२-५४-६०", "content_sanskrit": "इति श्रीस्कान्दे महापुराण एकाशीतिसाहस्र्यां संहितायां प्रथमे माहेश्वरखण्डे कौमारिकाखण्डे नारदमाहात्म्यवर्णनंनाम चतुःपंचाशत्तमोऽध्यायः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]