[{"id": 2049092, "chapter_id": 2078, "verse_number": "७-१-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2049093, "chapter_id": 2078, "verse_number": "७-१-१", "content_sanskrit": "रथस्थं पुरुषव्याघ्रं दृष्टा कर्णमवस्थितम्।\nहृष्टो दुर्योधनो राजन्निदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2049094, "chapter_id": 2078, "verse_number": "७-१-२", "content_sanskrit": "सनाथमिव मन्येऽहं भवता पालितं बलम्।\nअत्र किं नु समर्थं यद्धितं तत्सम्प्रधार्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2049095, "chapter_id": 2078, "verse_number": "७-१-३x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2049096, "chapter_id": 2078, "verse_number": "७-१-३", "content_sanskrit": "ब्रूहि नः पुरुषव्याघ्र त्वं हि प्राज्ञतमो नृषु।\nयथा चार्थपतिः कृत्यं पश्यते न तथेतरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2049097, "chapter_id": 2078, "verse_number": "७-१-४", "content_sanskrit": "ते स्म सर्वे तव वचः श्रोतुकामा नरेश्वर।\nनान्याय्यं हि भवान्वाक्यं ब्रूयादिति मतिर्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2049098, "chapter_id": 2078, "verse_number": "७-१-५x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2049099, "chapter_id": 2078, "verse_number": "७-१-५", "content_sanskrit": "भीष्मः सेनाप्रणेताऽऽसीद्वयसा विक्रमेण च।\nश्रुतेन चोपसम्पन्नः सर्वैर्योधगणैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2049100, "chapter_id": 2078, "verse_number": "७-१-६", "content_sanskrit": "तेनातियशसा कर्ण घ्नता शत्रुगणान्मम।\nसुयुद्धेन दशाहानि पालिताः स्मो महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2049101, "chapter_id": 2078, "verse_number": "७-१-७", "content_sanskrit": "तस्मिन्नसुकरं कर्म कृतवत्यास्थिते दिवम्।\nकं तु सेनाप्रणेतारं मन्यसे तदनन्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2049102, "chapter_id": 2078, "verse_number": "७-१-८", "content_sanskrit": "न विना नायकं सेना मुहूर्तमपि तिष्ठति।\n`आहवेषु विशेषेण भ्रष्टनेत्रेष्विवाञ्जनम्।\nआहवेष्वाहवश्रेष्ठ नेतृहीनेव नौर्जले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2049103, "chapter_id": 2078, "verse_number": "७-१-९", "content_sanskrit": "यथा ह्यकर्णधारा नौ रथश्चासारथिर्यथा।\nद्रवेद्यथेष्टं तद्वत्स्यादृते सेनापतिं बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2049104, "chapter_id": 2078, "verse_number": "७-१-१०", "content_sanskrit": "अदेशिको यथा सार्थः सर्वः कृच्छ्रं समृच्छति।\nअनायका तथा सेना सर्वान्दोषान्समर्च्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2049105, "chapter_id": 2078, "verse_number": "७-१-११", "content_sanskrit": "स भावन्वीक्ष्य सर्वेषु मामकेषु महात्मसु।\nपश्य सेनापतिं युक्तमनु शान्तनवादिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2049106, "chapter_id": 2078, "verse_number": "७-१-१२", "content_sanskrit": "यं हि सेनाप्रमेतारं भवान्वक्ष्यति संयुगे।\nतं वयं सहिताः सर्वे करिष्यामो न संशयः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2049107, "chapter_id": 2078, "verse_number": "७-१-१३x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2049108, "chapter_id": 2078, "verse_number": "७-१-१३", "content_sanskrit": "सर्व एव महात्मान इमे पुरुषसत्तमाः।\nसेनापतित्वमर्हन्ति नात्र कार्या विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2049109, "chapter_id": 2078, "verse_number": "७-१-१४", "content_sanskrit": "कुलसंहननज्ञानैर्बलविक्रमबुद्धिभिः।\nयुक्ताः श्रुतज्ञा धीमन्त आहवेष्वनिवर्तिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2049110, "chapter_id": 2078, "verse_number": "७-१-१५", "content_sanskrit": "युगपन्न तु ते शक्याः कर्तुं सर्वे पुरःसराः।\nएक एव तु कर्तव्यो यस्मिन्वैशेषिका गुणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2049111, "chapter_id": 2078, "verse_number": "७-१-१६", "content_sanskrit": "अन्योन्यस्पर्धिनां ह्येषां यद्येकं त्वं करिष्यसि।\nशेषा विमनसो व्यक्तं न योत्स्यन्ति हितास्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2049112, "chapter_id": 2078, "verse_number": "७-१-१७", "content_sanskrit": "अयं च सर्वयोधानामाचार्यः स्थिवरो गुरुः।\nयुक्तः सेनापतिः कर्तुं द्रोणः शस्त्रभृतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2049113, "chapter_id": 2078, "verse_number": "७-१-१८", "content_sanskrit": "को हि तिष्ठति दुर्धर्षे द्रोणे शस्त्रभृतां वरे।\nसेनापतिःस्यादन्योस्माच्छुक्राङ्गिरसदर्शनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2049114, "chapter_id": 2078, "verse_number": "७-१-१९", "content_sanskrit": "न च सोऽप्यस्ति ते योधः सर्वराजसु भारत।\nद्रोणं यः समरे यान्तमनुयास्यति संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2049115, "chapter_id": 2078, "verse_number": "७-१-२०", "content_sanskrit": "एष सेनाप्रणेतॄणामेष शस्त्रभृतामपि।\nएष बुद्धिमतां चैव श्रेष्ठो राजन्गुरुस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2049116, "chapter_id": 2078, "verse_number": "७-१-२१", "content_sanskrit": "एवं दुर्योधनाचार्यमाशु सेनापतिं कुरु।\nजिगीषन्तो सुरान्सङ्ख्ये कार्तिकेयमिवामराः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2049117, "chapter_id": 2078, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि द्रोणाभिषेकपर्वणि पञ्चमोऽध्यायः॥ ५ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१-८ नेता कर्णधारः॥ ५-१-१० अदेशिकोऽग्रेसररहितः। ५-१-१४ संहननं शरीरम्॥ ५-१-१८ शुक्राङ्गिरसदर्शनाच्छुक्रबृहस्पतितुल्यात्। ५-१-५ पञ्चमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]