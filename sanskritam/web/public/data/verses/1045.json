[{"id": 2002197, "chapter_id": 1045, "verse_number": "१-४६-०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2002198, "chapter_id": 1045, "verse_number": "१-४६-१", "content_sanskrit": "एतच्छ्रुत्वा जरत्कारुर्भृशं शोकपरायणः।\nउवाच तान्पितॄन्दुःखाद्बाष्पसंदिग्धया गिरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2002199, "chapter_id": 1045, "verse_number": "१-४६-२x", "content_sanskrit": "जरत्कारुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2002200, "chapter_id": 1045, "verse_number": "१-४६-२", "content_sanskrit": "मम पूर्वे भवन्तो वै पितरः सपितामहाः।\nतद्ब्रूत यन्मया कार्यं भवतां प्रियकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2002201, "chapter_id": 1045, "verse_number": "१-४६-३", "content_sanskrit": "अहमेव जरत्कारुः किल्बिषी भवतां सुतः।\nते दण्डं धारयत मे दुष्कृतेरकृतात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2002202, "chapter_id": 1045, "verse_number": "१-४६-४x", "content_sanskrit": "पितर ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2002203, "chapter_id": 1045, "verse_number": "१-४६-४", "content_sanskrit": "पुत्र दिष्ट्याऽसि संप्राप्त इमं देशं यदृच्छया।\nकिमर्थं च त्वया ब्रह्मन्न कृतो दारसङ्ग्रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2002204, "chapter_id": 1045, "verse_number": "१-४६-५x", "content_sanskrit": "जरत्कारुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2002205, "chapter_id": 1045, "verse_number": "१-४६-५", "content_sanskrit": "ममायं पितरो नित्यं हृद्यर्थः परिवर्तते।\nऊर्ध्वरेताः शरीरं वै प्रापयेयममुत्र वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2002206, "chapter_id": 1045, "verse_number": "१-४६-६", "content_sanskrit": "न दारान्वै करिष्येऽहमिति मे भावितं मनः।\nएवं दृष्ट्वा तु भवतः शकुन्तानिव लम्बतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2002207, "chapter_id": 1045, "verse_number": "१-४६-७", "content_sanskrit": "मया निवर्तिता बुद्धिर्ब्रह्मचर्यात्पितामहाः।\nकरिष्ये वः प्रियं कामं निवेक्ष्येऽहमसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2002208, "chapter_id": 1045, "verse_number": "१-४६-८", "content_sanskrit": "सनाम्नीं यद्यहं कन्यामुपलप्स्ये कदाचन।\nभविष्यति च या काचिद्भैक्ष्यवत्स्वयमुद्यता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2002209, "chapter_id": 1045, "verse_number": "१-४६-९", "content_sanskrit": "प्रतिग्रहीता तामस्मि न भरेयं च यामहम्।\nएवंविधमहं कुर्यां निवेशं प्राप्नुयां यदि।\nअन्यथा न करिष्येऽहं सत्यमेतत्पितामहाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2002210, "chapter_id": 1045, "verse_number": "१-४६-१०", "content_sanskrit": "तत्र चोत्पत्स्यते जन्तुर्भवतां तारणाय वै।\nशाश्वताश्चाव्ययाश्चैव तिष्ठन्तु पितरो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2002211, "chapter_id": 1045, "verse_number": "१-४६-११x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2002212, "chapter_id": 1045, "verse_number": "१-४६-११", "content_sanskrit": "एवमुक्त्वा तु स पितॄंश्चचार पृथिवी मुनिः।\nन च स्म लभते भार्यां वृद्धोऽयमिति शानक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2002213, "chapter_id": 1045, "verse_number": "१-४६-१२", "content_sanskrit": "यदा निर्वेदमापन्नः पितृभिश्चोदिस्तथा।\nतदाऽरण्यं स गत्वोच्चैश्चुक्रोश भृशदुःखितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2002214, "chapter_id": 1045, "verse_number": "१-४६-१३", "content_sanskrit": "सत्वरण्यगतः प्राज्ञः पितॄणा हितकाम्यया।\nउवाच कन्यां याचामि तिस्रो वाचः शनैरिमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2002215, "chapter_id": 1045, "verse_number": "१-४६-१४", "content_sanskrit": "यानि भूतानि सन्तीह स्थावराणि चराणि च।\nअन्तर्हितानि वा यानि तानि शृण्वन्तु मे वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2002216, "chapter_id": 1045, "verse_number": "१-४६-१५", "content_sanskrit": "उग्रे तपसि वर्तन्तं पितरश्चोदयन्ति माम्।\nनिविशस्वेति दुःखार्ताः सन्तानस्य चिकीर्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2002217, "chapter_id": 1045, "verse_number": "१-४६-१६", "content_sanskrit": "निवेशायाखिलां भूमिं कन्याभैक्ष्यं चरामि भोः।\nदरिद्रो दुःखशीलश्च पितृभिः सन्नियोजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2002218, "chapter_id": 1045, "verse_number": "१-४६-१७", "content_sanskrit": "यस्य कन्याऽस्ति भूतस्य ये मयेह प्रकीर्तिताः।\nते मे कन्यां प्रयच्छन्तु चरतः सर्वतोदिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2002219, "chapter_id": 1045, "verse_number": "१-४६-१८", "content_sanskrit": "मम कन्या सनाम्नी या भैक्ष्यवच्चोदिता भवेत्।\nभरेयं चैव यां नाहं तां मे कन्यां प्रयच्छत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2002220, "chapter_id": 1045, "verse_number": "१-४६-१९", "content_sanskrit": "ततस्ते पन्नगा ये वै जरत्कारौ समाहिताः।\nतामादाय प्रवृत्तिं ते वासुकेः प्रत्यवेदयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2002221, "chapter_id": 1045, "verse_number": "१-४६-२०", "content_sanskrit": "तेषां श्रुत्वा स नागेन्द्रस्तां कन्यां समलङ्कृताम्।\nप्रगृह्यारण्यमगमत्समीपं तस्य पन्नगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2002222, "chapter_id": 1045, "verse_number": "१-४६-२१", "content_sanskrit": "तत्र तां भैक्ष्यवत्कन्यां प्रादात्तस्मै महात्मने।\nनागेन्द्रो वासुकिर्ब्रह्मन्न स तां प्रत्यगृह्णत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2002223, "chapter_id": 1045, "verse_number": "१-४६-२२", "content_sanskrit": "असनामेति वै मत्वा भरणे चाविचारिते।\nमोक्षभावे स्थितश्चापि मन्दीभूतः परिग्रहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2002224, "chapter_id": 1045, "verse_number": "१-४६-२३", "content_sanskrit": "ततो नाम स कन्यायाः पप्रच्छ भृगुनन्दन।\nवासुकिं भरणं चास्या न कुर्यामित्युवाच ह॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2002225, "chapter_id": 1045, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि षट्चत्वारिंशोऽध्यायः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]