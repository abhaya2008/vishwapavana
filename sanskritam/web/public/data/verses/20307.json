[{"id": 7000307000, "chapter_id": 20307, "verse_number": "१-६१-१", "content_sanskrit": "द्विजाऊचुः ।\nतुलसीपुष्पमाहात्म्यं श्रुतं त्वत्तो हरेः शुभम् ।\nतस्या स्तोत्रं कृतं पुण्यं श्रोतुमिच्छामहे वयम्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000307001, "chapter_id": 20307, "verse_number": "१-६१-२", "content_sanskrit": "व्यास उवाच ।\nपुरा स्कंदपुराणे च यन्मया कीर्तितं द्विजाः ।\nकथयामि पुराणं च पुरतो मोक्षहेतवे॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000307002, "chapter_id": 20307, "verse_number": "१-६१-३", "content_sanskrit": "शतानंद मुनेः शिष्याः सर्वे ते संशितव्रताः ।\nप्रणिपत्य गुरुं विप्राः पप्रच्छुः पुण्यतो हितम्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000307003, "chapter_id": 20307, "verse_number": "१-६१-४", "content_sanskrit": "पूर्वं ब्रह्ममुखान्नाथ यच्छ्रुतं तुलसीस्तवम् ।\nतद्वयं श्रोतुमिच्छामस्त्वत्तो ब्रह्मविदांवर॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000307004, "chapter_id": 20307, "verse_number": "१-६१-५", "content_sanskrit": "शतानंद उवाच ।\nनामोच्चारे कृते तस्याः प्रीणात्यसुरदर्पहा ।\nपापानि विलयं यांति पुण्यं भवति चाक्षयम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000307005, "chapter_id": 20307, "verse_number": "१-६१-६", "content_sanskrit": "सा कथं तुलसी लोकैः पूज्यते वंद्यते नहि ।\nदर्शनादेव यस्यास्तु दानं कोटिगवां भवेत्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000307006, "chapter_id": 20307, "verse_number": "१-६१-७", "content_sanskrit": "धन्यास्ते मानवा लोके यद्गृहे विद्यते कलौ ।\nसालग्रामशिलार्थं तु तुलसी प्रत्यहं क्षितौ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000307007, "chapter_id": 20307, "verse_number": "१-६१-८", "content_sanskrit": "तुलसीं ये विचिन्वंति धन्यास्ते करपल्लवाः ।\nकेशवार्थं कलौ ये च रोपयंतीह भूतले॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000307008, "chapter_id": 20307, "verse_number": "१-६१-९", "content_sanskrit": "किं करिष्यति संरुष्टो यमोपि सह किंकरैः ।\nतुलसीदलेन देवेशः पूजितो येन दुःखहा॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000307009, "chapter_id": 20307, "verse_number": "१-६१-१०", "content_sanskrit": "तीर्थयात्रादिगमनैः फलैः सिध्यति किन्नरः ।\nस्नाने दाने तथा ध्याने प्राशने केशवार्चने॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000307010, "chapter_id": 20307, "verse_number": "१-६१-११", "content_sanskrit": "तुलसी दहते पापं कीर्तने रोपणे कलौ ।\nतुलस्यमृतजन्मासि सदा त्वं केशवप्रिये॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000307011, "chapter_id": 20307, "verse_number": "१-६१-१२", "content_sanskrit": "केशवार्थं चिनोमि त्वां वरदा भव शोभने ।\nत्वदंगसंभवैर्नित्यं पूजयामि यथाहरिम्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000307012, "chapter_id": 20307, "verse_number": "१-६१-१३", "content_sanskrit": "तथा कुरु पवित्रांगि कलौ मलविनाशिनि ।\nमंत्रेणानेन यः कुर्याद्विचित्य तुलसीदलम्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000307013, "chapter_id": 20307, "verse_number": "१-६१-१४", "content_sanskrit": "पूजनं वासुदेवस्य लक्षकोटिगुणं भवेत् ।\nप्रभावं तव देवेशि गायंति सुरसत्तमाः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000307014, "chapter_id": 20307, "verse_number": "१-६१-१५", "content_sanskrit": "मुनयः सिद्धगंधर्वाः पाताले नागराट्स्वयम् ।\nन ते प्रभावं जानंति देवताः केशवादृते॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000307015, "chapter_id": 20307, "verse_number": "१-६१-१६", "content_sanskrit": "गुणानां परिमाणं तु कल्पकोटिशतैरपि ।\nकृष्णानंदात्समुद्भूता क्षीरोदमथनोद्यमे॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000307016, "chapter_id": 20307, "verse_number": "१-६१-१७", "content_sanskrit": "उत्तमांगे पुरा येन तुलसी विष्णुना धृता ।\nप्राप्यैतानि त्वया देवि विष्णोरंगानि सर्वशः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000307017, "chapter_id": 20307, "verse_number": "१-६१-१८", "content_sanskrit": "पवित्रता त्वया प्राप्ता तुलसीं त्वां नमाम्यहम् ।\nत्वदंगसंभवैः पत्रैः पूजयामि यथा हरिम्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000307018, "chapter_id": 20307, "verse_number": "१-६१-१९", "content_sanskrit": "तथा कुरुष्व मेऽविघ्नं यतो यामि परां गतिम् ।\nरोपिता गोमतीतीरे स्वयं कृष्णेन पालिता॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000307019, "chapter_id": 20307, "verse_number": "१-६१-२०", "content_sanskrit": "जगद्धिताय तुलसी गोपीनां हितहेतवे ।\nवृंदावने विचरता सेविता विष्णुना स्वयम्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000307020, "chapter_id": 20307, "verse_number": "१-६१-२१", "content_sanskrit": "गोकुलस्य विवृद्ध्यर्थं कंसस्य निधनाय च ।\nवसिष्ठवचनात्पूर्वं रामेण सरयूतटे॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000307021, "chapter_id": 20307, "verse_number": "१-६१-२२", "content_sanskrit": "राक्षसानां वधार्थाय रोपिता त्वं जगत्प्रिये ।\nरोपिता तपसो वृद्ध्यै तुलसीं त्वां नमाम्यहम्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000307022, "chapter_id": 20307, "verse_number": "१-६१-२३", "content_sanskrit": "वियोगे वासुदेवस्य ध्यात्वा त्वां जनकात्मजा ।\nअशोकवनमध्ये तु प्रियेण सह संगता॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000307023, "chapter_id": 20307, "verse_number": "१-६१-२४", "content_sanskrit": "शङ्करार्थं पुरा देवि पार्वत्या त्वं हिमालये ।\nरोपिता तपसो वृद्ध्यै तुलसीं त्वां नमाम्यहम्॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000307024, "chapter_id": 20307, "verse_number": "१-६१-२५", "content_sanskrit": "सर्वाभिर्देवपत्नीभिः किन्नरैश्चापि नंदने ।\nदुःस्वप्ननाशनार्थाय सेविता त्वं नमोस्तु ते॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000307025, "chapter_id": 20307, "verse_number": "१-६१-२६", "content_sanskrit": "धर्मारण्ये गयायां च सेविता पितृभिः स्वयम् ।\nसेविता तुलसी पुण्या आत्मनो हितमिच्छता॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000307026, "chapter_id": 20307, "verse_number": "१-६१-२७", "content_sanskrit": "रोपिता रामचंद्रेण सेविता लक्ष्मणेन च ।\nपालिता सीतया भक्त्या तुलसी दंडके वने॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000307027, "chapter_id": 20307, "verse_number": "१-६१-२८", "content_sanskrit": "त्रैलोक्यव्यापिनी गंगा यथा शास्त्रेषु गीयते ।\nतथैव तुलसी देवी दृश्यते सचराचरे॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000307028, "chapter_id": 20307, "verse_number": "१-६१-२९", "content_sanskrit": "ऋश्यमूके च वसता कपिराजेन सेविता ।\nतुलसी वालिनाशाय तारासंगम हेतवे॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000307029, "chapter_id": 20307, "verse_number": "१-६१-३०", "content_sanskrit": "प्रणम्य तुलसीदेवीं सागरोत्क्रमणं कृतम् ।\nकृतकार्यः प्रहृष्टश्च हनूमान्पुनरागतः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000307030, "chapter_id": 20307, "verse_number": "१-६१-३१", "content_sanskrit": "तुलसीग्रहणं कृत्वा विमुक्तो याति पातकैः ।\nअथवा मुनिशार्दूल ब्रह्महत्यां व्यपोहति॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000307031, "chapter_id": 20307, "verse_number": "१-६१-३२", "content_sanskrit": "तुलसीपत्रगलितं यस्तोयं शिरसा वहेत् ।\nगंगास्नानमवाप्नोति दशधेनुफलप्रदम्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000307032, "chapter_id": 20307, "verse_number": "१-६१-३३", "content_sanskrit": "प्रसीद देवि देवेशि प्रसीद हरिवल्लभे ।\nक्षीरोदमथनोद्भूते तुलसि त्वां नमाम्यहम्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000307033, "chapter_id": 20307, "verse_number": "१-६१-३४", "content_sanskrit": "द्वादश्यां जागरे रात्रौ यः पठेत्तुलसीस्तवम् ।\nद्वात्रिंशदपराधांश्च क्षमते तस्य केशवः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000307034, "chapter_id": 20307, "verse_number": "१-६१-३५", "content_sanskrit": "यत्पापं यौवने बाल्ये कौमारे वार्द्धके कृतम् ।\nतत्सर्वं विलयं याति तुलसीस्तव पाठतः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000307035, "chapter_id": 20307, "verse_number": "१-६१-३६", "content_sanskrit": "प्रीतिमायाति देवेशस्तुष्टो लक्ष्मीं प्रयच्छति ।\nकुरुते शत्रुनाशं च सुखं विद्यां प्रयच्छति॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000307036, "chapter_id": 20307, "verse_number": "१-६१-३७", "content_sanskrit": "तुलसीनाममात्रेण देवा यच्छंति वांछितम् ।\nगर्ह्याणमपि देवेशो मुक्तिं यच्छति देहिनाम्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000307037, "chapter_id": 20307, "verse_number": "१-६१-३८", "content_sanskrit": "तुलसी स्तवसंतुष्टा सुखं वृद्धिं ददाति च ।\nउद्गतं हेलया विद्धि पापं यमपथे स्थितम्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000307038, "chapter_id": 20307, "verse_number": "१-६१-३९", "content_sanskrit": "यस्मिन्गृहे च लिखितो विद्यते तुलसीस्तवः ।\nनाशुभं विद्यते तस्य शुभमाप्नोति निश्चितम्॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000307039, "chapter_id": 20307, "verse_number": "१-६१-४०", "content_sanskrit": "सर्वं च मंगलं तस्य नास्ति किंचिदमंगलम् ।\nसुभिक्षं सर्वदा तस्य धनं धान्यं च पुष्कलम्॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000307040, "chapter_id": 20307, "verse_number": "१-६१-४१", "content_sanskrit": "निश्चला केशवे भक्तिर्न वियोगश्च वैष्णवैः ।\nजीवति व्याधिनिर्मुक्तो नाधर्मे जायते मतिः॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000307041, "chapter_id": 20307, "verse_number": "१-६१-४२", "content_sanskrit": "द्वादश्यां जागरे रात्रौ यः पठेत्तुलसीस्तवम् ।\nतीर्थकोटिसहस्रैस्तु यत्फलं लक्षकोटिभिः॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000307042, "chapter_id": 20307, "verse_number": "१-६१-४३", "content_sanskrit": "तत्फलं समवाप्नोति पठित्वा तुलसीस्तवम्॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]