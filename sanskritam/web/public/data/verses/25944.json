[{"id": 7005944000, "chapter_id": 25944, "verse_number": "१-१२७-१", "content_sanskrit": "ब्रह्मोवाच । माघमासे शुक्लपक्षे सूर्यर्क्षेण युत पुरा ।\nएकादशी तथा चैका भीमेन समुपोषिता ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005944001, "chapter_id": 25944, "verse_number": "१-१२७-२", "content_sanskrit": "आश्चर्य तु व्रतं कृत्वा पितॄणामनृणोऽभवत ।\nभीमद्वादशी विख्याता प्राणिनां पुण्यवर्धिनी ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005944002, "chapter_id": 25944, "verse_number": "१-१२७-३", "content_sanskrit": "नक्षत्रेण विनाप्येषा ब्रह्महत्यादि नशयेत् ।\nविनिहन्ति महापापं कुनृपो विषयं यथा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005944003, "chapter_id": 25944, "verse_number": "१-१२७-४", "content_sanskrit": "कुपुत्त्रस्तु कुलं यद्वत्कुभार्या च पतिं यथा ।\nअधर्मं च यथा धर्मः कुमन्त्री च यथा नृपम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005944004, "chapter_id": 25944, "verse_number": "१-१२७-५", "content_sanskrit": "अज्ञानेन यथा ज्ञानं शौचमाशौचकं यथा ।\nअश्रद्धया यथा श्रद्धा सत्यञ्चैवानृतैर्यथा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005944005, "chapter_id": 25944, "verse_number": "१-१२७-६", "content_sanskrit": "हिमं यथोष्णमाहन्यादनर्थं चार्थसंचयः ।\nयथा प्रकर्तिनाद्दानं तपो वै विस्मयाद्यथा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005944006, "chapter_id": 25944, "verse_number": "१-१२७-७", "content_sanskrit": "अशिक्षया यथा पुत्रो गावो दूरगतैर्यथा ।\nक्रोधेन च यथा शान्तिर्यथा वित्तमवद्धनात् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005944007, "chapter_id": 25944, "verse_number": "१-१२७-८", "content_sanskrit": "ज्ञानेनैयथा विद्या निष्कामेन यथा फलम् ।\nतथैव पापनाशाय प्रोक्तेयं द्वादशी शुभा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005944008, "chapter_id": 25944, "verse_number": "१-१२७-९", "content_sanskrit": "ब्रह्महत्या सुरा पान स्तेयं गुर्वङ्नागमः ।\nयुगपत्तुप्रजातानिहन्ति त्रिपुष्करम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005944009, "chapter_id": 25944, "verse_number": "१-१२७-१०", "content_sanskrit": "न चापि नैमिषं क्षेत्रं कुरुक्षेत्रं प्रभासकम। ।\nकालिन्दी यमुना गङ्गा न चैव न सरस्वती ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005944010, "chapter_id": 25944, "verse_number": "१-१२७-११", "content_sanskrit": "चैव सर्वतीर्थानि एकादश्याः समानि हि ।\nन दानं न जपो होमो न चान्यत्सुकृतं क्रचित् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005944011, "chapter_id": 25944, "verse_number": "१-१२७-१२", "content_sanskrit": "एकतः पृथिवीदानमेकतो हरिवासरः ।\nततोऽप्येका महापुण्या इयमेकादशी वरा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005944012, "chapter_id": 25944, "verse_number": "१-१२७-१३", "content_sanskrit": "अस्मिन्वराहपुरुषं कृत्वा देवं तु हाटकम् ।\nघटोपरि नवे पात्रे कृत्वा वै ताम्रभाजने ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005944013, "chapter_id": 25944, "verse_number": "१-१२७-१४", "content_sanskrit": "सर्वबीजभृते विप्राः सितवस्त्रावगण्ठिते ।\nसहिरण्यप्रदीपाद्यैः कृत्वा पूजां प्रयत्ननः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005944014, "chapter_id": 25944, "verse_number": "१-१२७-१५", "content_sanskrit": "वराहाय नमः पादौ क्रोडाकृतये नमः कटम ।\nनाभिं गंभीरघोषया उरः श्रीवत्सधारिणे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005944015, "chapter_id": 25944, "verse_number": "१-१२७-१६", "content_sanskrit": "बाहुं सहस्रशिरसे ग्रीवां सर्वेश्वराय च ।\nमुखं सर्वात्मने पूज्यं ललाटं प्रभवाय च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005944016, "chapter_id": 25944, "verse_number": "१-१२७-१७", "content_sanskrit": "केशाः शतमयूखाय पूज्या देवस्य चक्रिणः ।\nविधिना पूजयित्वा तु कृत्वा जागरणं निशि ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005944017, "chapter_id": 25944, "verse_number": "१-१२७-१८", "content_sanskrit": "श्रुत्वा पुराणं देवस्य माहात्म्यप्रतिपादकम् ।\nप्रातर्विप्राय दत्त्वा च याचकाय शुभाय तत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005944018, "chapter_id": 25944, "verse_number": "१-१२७-१९", "content_sanskrit": "कनकक्रोडसहितं सन्निवेद्य परिच्छदम् ।\nपश्चात्तु पारणं कुर्यान्नातितृप्तः सकृद्व्रतः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005944019, "chapter_id": 25944, "verse_number": "१-१२७-२०", "content_sanskrit": "एवं कृत्वा नरो विद्यान्न भूय स्तनपो भवेत् ।\nउपोष्यैकादशीं पुण्यां मुच्यते वै ऋणत्रयात् ।\nमनोऽभिलषितावाप्तिः कृत्वा सर्वव्रतादिकम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]