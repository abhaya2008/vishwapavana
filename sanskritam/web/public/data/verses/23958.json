[{"id": 7003958000, "chapter_id": 23958, "verse_number": "३-१-२१-१", "content_sanskrit": "श्रीसूत उवाच ।\nजटा तीर्थाभिधे तीर्थे सर्वपातकनाशने ।\nस्नानं कृत्वा विशुद्धात्मा लक्ष्मीतीर्थं ततो व्रजेत्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003958001, "chapter_id": 23958, "verse_number": "३-१-२१-२", "content_sanskrit": "यंयं कामं समुद्दिश्य लक्ष्मीतीर्थे द्विजोत्तमाः ।\nस्नानं समाचरेन्मर्त्यस्तंतं कामं समश्नुते॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003958002, "chapter_id": 23958, "verse_number": "३-१-२१-३", "content_sanskrit": "महादारिद्र्यशमनं महाधान्यसमृद्धिदम् ।\nमहादुःखप्रशमनं महासंपद्विवर्धनम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003958003, "chapter_id": 23958, "verse_number": "३-१-२१-४", "content_sanskrit": "अत्र स्नात्वा धर्मपुत्रो महदैश्वर्यमाप्तवान् ।\nइन्द्रप्रस्थे वसन्पूर्वं श्रीकृष्णेन प्रचोदितः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003958004, "chapter_id": 23958, "verse_number": "३-१-२१-५", "content_sanskrit": "ऋषय ऊचुः ।\nयथैश्वर्यं धर्मपुत्रो लक्ष्मीतीर्थे निमज्जनात् ।\nआप्तवान्कृष्णवचनात्तन्नो ब्रूहि महामुने॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003958005, "chapter_id": 23958, "verse_number": "३-१-२१-६", "content_sanskrit": "श्रीसूत उवाच ।\nइन्द्रप्रस्थे पुरा विप्रा धृतराष्ट्रेण चोदिताः ।\nन्यवसन्पांडवाः पंच महाबलपराक्रमाः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003958006, "chapter_id": 23958, "verse_number": "३-१-२१-७", "content_sanskrit": "इन्द्रप्रस्थं ययौ कृष्णः कदाचित्तान्निरीक्षितुम् ।\nतमागतमेभिप्रेक्ष्य पांडवास्ते समुत्सुकाः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003958007, "chapter_id": 23958, "verse_number": "३-१-२१-८", "content_sanskrit": "स्वगृहं प्रापयामासुर्मुदा परमया युताः ।\nकञ्चित्कालमसौ कृष्णस्तत्रावात्सीत्पुरोत्तमे॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003958008, "chapter_id": 23958, "verse_number": "३-१-२१-९", "content_sanskrit": "कदाचित्कृष्णमाहूय पूजयित्वा युधिष्ठिरः ।\nपप्रच्छ पुंडरीकाक्षं वासुदेवं जगत्पतिम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003958009, "chapter_id": 23958, "verse_number": "३-१-२१-१०", "content_sanskrit": "युधिष्ठिर उवाच ।\nकृष्णकृष्ण महाप्राज्ञ येन धर्मेण मानवाः ।\nलभंते महदैश्वर्यं तन्नो ब्रूहि महामते ।\nइत्युक्तो धर्मपुत्रेण कृष्णः प्राह युधिष्ठिरम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003958010, "chapter_id": 23958, "verse_number": "३-१-२१-११", "content_sanskrit": "श्रीकृष्ण उवाच ।\nधर्मपुत्र महाभाग गन्धमादनपर्वते॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003958011, "chapter_id": 23958, "verse_number": "३-१-२१-१२", "content_sanskrit": "लक्ष्मी तीर्थमिति ख्यातमस्त्यैश्वर्यैककारणम् ।\nतत्र स्नानं कुरुष्व त्वमैश्वर्यं ते भविष्यति॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003958012, "chapter_id": 23958, "verse_number": "३-१-२१-१३", "content_sanskrit": "तत्र स्नानेन वर्धंते धनधान्यसमृद्धयः ।\nसर्वे सपत्ना नश्यंति क्षात्रमेषां विवर्द्धते॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003958013, "chapter_id": 23958, "verse_number": "३-१-२१-१४", "content_sanskrit": "तीर्थे सस्नुः पुरा देवा लक्ष्मीनामनि पुण्यदे ।\nअलभन्त्सर्वमैश्वर्यं तेन पुण्येन धर्मज॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003958014, "chapter_id": 23958, "verse_number": "३-१-२१-१५", "content_sanskrit": "असुरांश्च महावीर्यान्समरे जघ्नुरंजसा ।\nमही लक्ष्मीश्च धर्मश्च तत्तीर्थस्नायिनां नृणाम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003958015, "chapter_id": 23958, "verse_number": "३-१-२१-१६", "content_sanskrit": "भविष्यत्यचिरादेव संशयं मा कृथा इह ।\nतपोभिः क्रतुभिर्दानैराशीर्वादैश्च पांडव॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003958016, "chapter_id": 23958, "verse_number": "३-१-२१-१७", "content_sanskrit": "ऐश्वर्यं प्राप्यते यद्वल्लक्ष्मीतीर्थनिमज्जनात् ।\nसर्वपापानि नश्यंति विप्रा यांति लयं सदा॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003958017, "chapter_id": 23958, "verse_number": "३-१-२१-१८", "content_sanskrit": "व्याधयश्च विनश्यंति लक्ष्मीतीर्थनिषेवणात् ।\nश्रेयः सुविपुलं लोके लभ्यते नात्र संशयः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003958018, "chapter_id": 23958, "verse_number": "३-१-२१-१९", "content_sanskrit": "स्नानमात्रेण वै लक्ष्म्यास्तीर्थेऽस्मि न्धर्मनंदन ।\nरंभामप्सरसां श्रेष्ठां लब्धवानवधो नृपः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003958019, "chapter_id": 23958, "verse_number": "३-१-२१-२०", "content_sanskrit": "स्नात्वात्र तीर्थे पुण्ये तु कुबेरो नरवाहनः ।\nस महापद्ममुख्यानां निधीनां नायकोऽ भवत्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003958020, "chapter_id": 23958, "verse_number": "३-१-२१-२१", "content_sanskrit": "तस्मात्त्वमपि राजेंद्र लक्ष्मीतीर्थे शुभप्रदे ।\nस्नात्वा वृकोदरमुखैरनुजैरपि संवृतः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003958021, "chapter_id": 23958, "verse_number": "३-१-२१-२२", "content_sanskrit": "लप्स्यसे महतीं लक्ष्मीं जेष्यसे च रिपूनपि ।\nसंदेहो नात्र कर्तव्यः पैतृष्वसेय धर्मज॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003958022, "chapter_id": 23958, "verse_number": "३-१-२१-२३", "content_sanskrit": "इत्युक्तो धर्मपुत्रोऽयं कृष्णेनाद्भुतदर्शनः ।\nसानुजः प्रययौ शीघ्रं गन्धमादनपर्वतम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003958023, "chapter_id": 23958, "verse_number": "३-१-२१-२४", "content_sanskrit": "लक्ष्मी तीर्थं ततो गत्वा महदैश्वर्यकारणम् ।\nसस्नौ युधिष्ठिरस्तत्र सानुजो नियमान्वितः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003958024, "chapter_id": 23958, "verse_number": "३-१-२१-२५", "content_sanskrit": "लक्ष्मतीर्थस्य तोये स सर्वपातकनाशने ।\nसानुजो मासमेकं तु सस्नौ नियमपूर्वकम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003958025, "chapter_id": 23958, "verse_number": "३-१-२१-२६", "content_sanskrit": "गोभूतिलहिरण्यादीन्ब्राह्मणेभ्यो ददौ बहून् ।\nसानुजो धर्मपुत्रोऽसाविंद्रप्रस्थं ययौ ततः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003958026, "chapter_id": 23958, "verse_number": "३-१-२१-२७", "content_sanskrit": "राजसूयक्रतुं कर्तुं तत एच्छद्युधिष्ठिरः ।\nकृष्णं समाह्वयामास यियक्षुर्धर्मनंदनं॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003958027, "chapter_id": 23958, "verse_number": "३-१-२१-२८", "content_sanskrit": "कृष्णो धर्मजदूतेन समाहूतः ससंभ्रमः ।\nचतुर्भिरश्वैः संयुक्तं रथमा रुह्य वेगिनम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003958028, "chapter_id": 23958, "verse_number": "३-१-२१-२९", "content_sanskrit": "सत्यभामासहचर इंद्रप्रस्थं समाययौ ।\nतमागतं समालोक्य प्रमोदाद्धर्मनंदनः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003958029, "chapter_id": 23958, "verse_number": "३-१-२१-३०", "content_sanskrit": "न्यवेदयत्स कृष्णाय राजसूयोद्यमं तदा ।\nअन्वमन्यत कृष्णोपि तथैव क्रियतामिति॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003958030, "chapter_id": 23958, "verse_number": "३-१-२१-३१", "content_sanskrit": "वाक्यं च युक्तिसंयुक्तं धर्मपुत्रमभाषत ।\nपैतृष्वस्रेय धर्मात्मञ्च्छृणु पथ्यं वचो मम॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003958031, "chapter_id": 23958, "verse_number": "३-१-२१-३२", "content_sanskrit": "दुष्करो राजसूयोऽयं सर्वैरपि महीश्वरैः ।\nअनेकशतपादातरथकुंजरवाजिमान्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003958032, "chapter_id": 23958, "verse_number": "३-१-२१-३३", "content_sanskrit": "महीपतिरिमं यज्ञं कर्तुमर्हति नेतरः ।\nदिशो दश विजेतव्या प्रथमं वलिना त्वया॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003958033, "chapter_id": 23958, "verse_number": "३-१-२१-३४", "content_sanskrit": "पराजितेभ्यः शत्रुभ्यो गृहीत्वा करमुत्तमम् ।\nतेन कांचनजातेन कर्तव्योऽयं क्रतूत्तमः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003958034, "chapter_id": 23958, "verse_number": "३-१-२१-३५", "content_sanskrit": "रोचये युक्तिविदहं न हि त्वां भीषयामि भोः ।\nअतः क्रतुसमारंभात्पूर्वं दिग्विजयं कुरु॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003958035, "chapter_id": 23958, "verse_number": "३-१-२१-३६", "content_sanskrit": "ततो धर्मात्मजः श्रुत्वा कृष्णस्य वचनं हितम् ।\nप्रशंसन्देवकीपुत्रमाजुहाव निजानुजान्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003958036, "chapter_id": 23958, "verse_number": "३-१-२१-३७", "content_sanskrit": "आहूय चतुरो भ्रातॄन्धर्मजः प्राह हर्षयन् ।\nअयि भीम महाबाहो बहुवीर्य धनंजय॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003958037, "chapter_id": 23958, "verse_number": "३-१-२१-३८", "content_sanskrit": "यमौ च सुकुमागंगौ शत्रुसंहारदीक्षितौ ।\nचिकीर्षामि महायज्ञं राजसूयमनुत्तमम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003958038, "chapter_id": 23958, "verse_number": "३-१-२१-३९", "content_sanskrit": "स च सर्वान्रणे जित्वा कर्तव्यः पृथिवीपतीन् ।\nअतो विजेतुं भूपालांश्चत्वरोऽपि ससैनिकाः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003958039, "chapter_id": 23958, "verse_number": "३-१-२१-४०", "content_sanskrit": "दिशश्चतस्रो गच्छंतु भवंतो वीर्यवत्तराः ।\nयुष्माभिराहतैर्द्रव्यैः करिष्यामि महाक्रतुम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003958040, "chapter_id": 23958, "verse_number": "३-१-२१-४१", "content_sanskrit": "इत्युक्ताः सादरं सर्वे वृकोदरमुखास्तदा ।\nप्रसन्नवदना भूत्वा धर्मपुत्रानुजाः पुरात्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003958041, "chapter_id": 23958, "verse_number": "३-१-२१-४२", "content_sanskrit": "राज्ञां जयाय सर्वासु निर्ययुर्दिक्षु पांडवाः ।\nते सर्वे नृपतीञ्जित्वा चतुर्दिक्षु स्थितान्बहून्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003958042, "chapter_id": 23958, "verse_number": "३-१-२१-४३", "content_sanskrit": "स्ववशे स्थापयित्वा तान्नृपतीन्पांडुनंदनाः ।\nतैर्दत्तं बहुधा द्रव्यमसंख्यातमनुत्तमम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003958043, "chapter_id": 23958, "verse_number": "३-१-२१-४४", "content_sanskrit": "आदाय स्वपुरं तूर्णमाययुः कृष्णसंश्रयाः ।\nभीमः समाययौ तत्र महाबलपराक्रमः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003958044, "chapter_id": 23958, "verse_number": "३-१-२१-४५", "content_sanskrit": "शतभारसुवर्णानि समादाय पुरोत्तमम् ।\nसहस्रं भारमादाय सुवर्णानां ततोऽर्जुनः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003958045, "chapter_id": 23958, "verse_number": "३-१-२१-४६", "content_sanskrit": "शक्रप्रस्थं समायातो महाबलपराक्रमः ।\nशतभारं सुवर्णानां प्रगृह्य नकुलस्तथा॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003958046, "chapter_id": 23958, "verse_number": "३-१-२१-४७", "content_sanskrit": "समागतो महातेजाः शक्रप्रस्थं पुरोत्तमम् ।\nदत्तान्विभीषणेनाथ स्वर्णतालांश्चतुर्दश॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003958047, "chapter_id": 23958, "verse_number": "३-१-२१-४८", "content_sanskrit": "दाक्षिणात्यमहीपानां गृहीत्वा धनसंचयम् ।\nसहदेवोपि सहसा समा यातो निजां पुरीम्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003958048, "chapter_id": 23958, "verse_number": "३-१-२१-४९", "content_sanskrit": "लक्षकोटिसहस्राणि लक्षकोटिशतान्यपि ।\nसुवर्णानि ददौ कृष्णो धर्मपुत्राय यादवः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003958049, "chapter_id": 23958, "verse_number": "३-१-२१-५०", "content_sanskrit": "स्वानुजैराहृतैरेवमसं ख्यातैर्महाधनैः ।\nकृष्णदत्तैरसंख्यातैर्धनैरपि युधिष्ठिरः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003958050, "chapter_id": 23958, "verse_number": "३-१-२१-५१", "content_sanskrit": "कृष्णाश्रयोऽयजद्विप्रा राजसूयेन पांडवः ।\nतस्मिन्यागे ददौ द्रव्यं ब्राह्मणेभ्यो यथेष्टतः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003958051, "chapter_id": 23958, "verse_number": "३-१-२१-५२", "content_sanskrit": "अन्नानि प्रददौ तत्र ब्राह्मणेभ्यो युधिष्ठिरः ।\nवस्त्राणि गाश्च भूमिं च भूषणानि ददौ तथा॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003958052, "chapter_id": 23958, "verse_number": "३-१-२१-५३", "content_sanskrit": "अर्थिनः परितुष्यंति यावता कांचनादिना ।\nततोपि द्विगुणं तेभ्यो दापयामास धर्मजः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003958053, "chapter_id": 23958, "verse_number": "३-१-२१-५४", "content_sanskrit": "इयंति दत्तान्यर्थिभ्यो धनानि विविधान्यपि ।\nइतीयत्तां परिच्छेत्तुं न शक्ता ब्रह्मकोटयः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003958054, "chapter_id": 23958, "verse_number": "३-१-२१-५५", "content_sanskrit": "अर्थिभिर्दीयमानानि दृष्ट्वा तत्र धनानि वै ।\nसर्वस्वमप्यहो राज्ञा दत्तमित्यब्रवीज्जनः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003958055, "chapter_id": 23958, "verse_number": "३-१-२१-५६", "content_sanskrit": "दृष्ट्वा कोशास्तथा नंताननंतमणिकांचनान्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003958056, "chapter_id": 23958, "verse_number": "३-१-२१-५७", "content_sanskrit": "स्वल्पं हि दत्तमर्थिभ्य इत्यवोचञ्जनास्तदा ।\nइष्ट्वैवं राजसूयेन धर्मपुत्रः सहानुजः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003958057, "chapter_id": 23958, "verse_number": "३-१-२१-५८", "content_sanskrit": "बहुवित्तसमृद्धः सन्रेमे तत्र पुरोत्तमे ।\nलक्ष्मीतीर्थस्य माहात्म्याद्धर्मपुत्रो युधिष्ठिरः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003958058, "chapter_id": 23958, "verse_number": "३-१-२१-५९", "content_sanskrit": "लेभे सर्वमिदं विप्रा अहो तीर्थस्य वैभवम् ।\nइदं तीर्थं महापुण्यं महा दारिद्यनाशनम्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003958059, "chapter_id": 23958, "verse_number": "३-१-२१-६०", "content_sanskrit": "धनधान्यप्रदं पुंसां महापातकनाशनम् ।\nमहानरकसंहर्तृ महादुःखनिवर्तकम्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003958060, "chapter_id": 23958, "verse_number": "३-१-२१-६१", "content_sanskrit": "मोक्षदं स्वर्गदं नित्यं महाऋण विमोचनम् ।\nसुकलत्रप्रदं पुंसां सुपुत्रप्रदमेव च॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003958061, "chapter_id": 23958, "verse_number": "३-१-२१-६२", "content_sanskrit": "एतत्तीर्थसमं तीर्थं न भूतं न भविष्यति ।\nएतद्वः कथितं विप्रा लक्ष्मीतीर्थस्य वैभवम्॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003958062, "chapter_id": 23958, "verse_number": "३-१-२१-६३", "content_sanskrit": "दुःस्वप्ननाशनं पुण्यं सर्वाभीष्टप्रसाधकम् ।\nयः पठेदिममध्यायं शृणुते वा सभक्तिकम्॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003958063, "chapter_id": 23958, "verse_number": "३-१-२१-६४", "content_sanskrit": "धनधान्यसमृद्धः स्यात्स नरो नास्ति संशयः ।\nभुक्त्वेह सकलान्भोगान्देहांते मुक्तिमाप्नुयात्॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]