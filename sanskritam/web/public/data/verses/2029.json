[{"id": 2046318, "chapter_id": 2029, "verse_number": "६-७८-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2046319, "chapter_id": 2029, "verse_number": "६-७८-१", "content_sanskrit": "ततो दुर्योधनो राजा महोत्प्रत्यागतस्मृतिः ।\nशरवर्षैः पुनर्भीमं प्रत्यवारयदच्युतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2046320, "chapter_id": 2029, "verse_number": "६-७८-२", "content_sanskrit": "एकीभूतास्ततश्चैव तव पुत्रा महारथाः ।\nसमेत्य समरे भीमं योधयामासुरुद्यताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2046321, "chapter_id": 2029, "verse_number": "६-७८-३", "content_sanskrit": "भीमसेनोऽपि समरे संप्राप्य स्वरथं पुनः ।\nसमारुह्य महाबाहुर्ययौ येन तवात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2046322, "chapter_id": 2029, "verse_number": "६-७८-४", "content_sanskrit": "प्रगृह्य च महावेगं परासुकरणं दृढम् ।\nसज्यं शरासनं सङ्ख्ये शरैर्विव्याध ते सुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2046323, "chapter_id": 2029, "verse_number": "६-७८-५", "content_sanskrit": "ततो दुर्योधनो राजा भीमसेनं महाबलम् ।\nनाराचेन सुतीक्ष्णेन भृशं मर्मण्यताडयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2046324, "chapter_id": 2029, "verse_number": "६-७८-६", "content_sanskrit": "सोऽतिविद्धो महेष्वासस्तव पुत्रेण धन्विना ।\nक्रोधसंरक्तनयनो वेगेनाक्षिप्य कार्मुकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2046325, "chapter_id": 2029, "verse_number": "६-७८-७", "content_sanskrit": "दुर्योधनं त्रिभिर्बाणैर्बाह्वोरुरसि चार्पयत् ।\nस तत्र शुशुभे राजा शिखरैर्गिरिराडिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2046326, "chapter_id": 2029, "verse_number": "६-७८-८", "content_sanskrit": "तौ दष्ट्वा समरे क्रुद्धौ विनिघ्नन्तौ परस्परम् ।\nदुर्योधनानुजाः सर्वे शूराः संत्यक्तजीविताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2046327, "chapter_id": 2029, "verse_number": "६-७८-९", "content_sanskrit": "संस्मृत्य मन्त्रितं पूर्वं निग्रहे भीमकर्मणः ।\nनिश्चयं परमं कृत्वा निग्रहीतुं प्रचक्रमुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2046328, "chapter_id": 2029, "verse_number": "६-७८-१०", "content_sanskrit": "तानापतत एवाजौ भीमसेनो महाबलः ।\nप्रत्युद्ययौ महाराज गजः प्रतिगजानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2046329, "chapter_id": 2029, "verse_number": "६-७८-११", "content_sanskrit": "भृशं क्रुद्धश्च तेजस्वी नाराचेन समार्पयत् ।\nचित्रसेनं महाराज तव पुत्रं महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2046330, "chapter_id": 2029, "verse_number": "६-७८-१२", "content_sanskrit": "तथेतरांस्तव सुतांस्ताडयामास भारत ।\nशरैर्बहुविधैः सङ्ख्ये रुक्मपुङ्खैः सुतेजनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2046331, "chapter_id": 2029, "verse_number": "६-७८-१३", "content_sanskrit": "ततः संप्रेक्ष्य पुत्रैस्ते भीमसेनं समावृतम् ।\nअभिमन्युप्रभृतयस्ते द्वदश महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2046332, "chapter_id": 2029, "verse_number": "६-७८-१४", "content_sanskrit": "प्रेषिता धर्मराजेन भीमसेनपदानुगाः ।\nप्रतिजग्मुर्महाराज तव पुत्रान्महाबलान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2046333, "chapter_id": 2029, "verse_number": "६-७८-१५", "content_sanskrit": "दृष्ट्वा रथस्थांस्ताञ्शूरान्सूर्याग्निसमतेजसः ।\nसर्वानेव महेष्वासान्भ्राजमानाञ्श्रिया वृतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2046334, "chapter_id": 2029, "verse_number": "६-७८-१६", "content_sanskrit": "महाहवे दीष्यमानान्सुवर्णमकुटोञ्ज्वलान्।\nतत्यजुः समरे भीमं तव पुत्रा महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2046335, "chapter_id": 2029, "verse_number": "६-७८-१७", "content_sanskrit": "तान्नामृष्यत कौन्तेयो जीवमाना गता इति ।\nअन्वीय च पुनः सर्वांस्तव पुत्रानपीडयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2046336, "chapter_id": 2029, "verse_number": "६-७८-१८", "content_sanskrit": "अथाभिमन्युः समरे भीमसेनेन संगतः ।\nपार्षतेन च ते सर्वे कैकया द्रौपदीसुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2046337, "chapter_id": 2029, "verse_number": "६-७८-१९", "content_sanskrit": "तादृष्ट्वा समरे क्रुद्धांस्तव सैन्ये महारथाः।\nदुर्योधनप्रभृतयः प्रगृहीतशरासनाः।\nभृशमर्श्वैः प्रजवितैः प्रययुर्यत्र ते रथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2046338, "chapter_id": 2029, "verse_number": "६-७८-२०", "content_sanskrit": "अपराह्णे महाराज प्रावर्तत महारणः।\nतावकानां च बलिनां परेषां चैव भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2046339, "chapter_id": 2029, "verse_number": "६-७८-२१", "content_sanskrit": "अभिमन्युर्विकर्णस्य हयान्हत्वा महाहवे।\nअथैनं पञ्चविंशत्या क्षुद्रकाणां समार्पयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2046340, "chapter_id": 2029, "verse_number": "६-७८-२२", "content_sanskrit": "हताश्वं रथमुत्सृज्य विकर्णस्तु महारथः ।\nआरुरोह रथं राजंश्चित्रसेनस्य भारत ।\nयोधयामास समरे तदद्भुतमिवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2046341, "chapter_id": 2029, "verse_number": "६-७८-२३", "content_sanskrit": "स्थितावेकरथे तौ तु भ्रातरौ कुलवर्धनौ।\nआर्जिनिः शरजालेन च्छादयामास भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2046342, "chapter_id": 2029, "verse_number": "६-७८-२४", "content_sanskrit": "चित्रसेनो विकर्णश्च कार्ष्णिं पञ्चभिरायसैः ।\nविव्यधाते न चाकम्पत्कार्ष्णिर्मेरुरिव स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2046343, "chapter_id": 2029, "verse_number": "६-७८-२५", "content_sanskrit": "दुःशासनस्तु समरे केकयान्पञ्च मारिप ।\nयोधयामास राजेन्द्र तदद्भुतमिवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2046344, "chapter_id": 2029, "verse_number": "६-७८-२६", "content_sanskrit": "द्रौपदेया रणे क्रुद्धा दुर्योधनमवारयन् ।\nशरैराशीविषाकारैः पुत्रं तव विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2046345, "chapter_id": 2029, "verse_number": "६-७८-२७", "content_sanskrit": "पुत्रोऽपि तव दुर्धर्षो द्रौपद्यास्तनयान्रणे ।\nसायकैर्निशितै राजन्नाजघान पृथक्पृथक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2046346, "chapter_id": 2029, "verse_number": "६-७८-२८", "content_sanskrit": "तैश्चापि विद्धः शुशुभे रुधिरेम समुक्षितः ।\nगिरिः प्रस्रवणैर्यद्वद्गैरिकादिविमिश्रितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2046347, "chapter_id": 2029, "verse_number": "६-७८-२९", "content_sanskrit": "भीष्मोऽपि समरे राजन्पाण्डवानामनीकिनीम् ।\nकालयामास बलवान्पालः पशुगणानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2046348, "chapter_id": 2029, "verse_number": "६-७८-३०", "content_sanskrit": "ततो गाण्डीवनिर्घोषः प्रादुरासीद्विशांपते ।\nदक्षिणेन वरूथिन्याः पार्थस्यरीन्विनिघ्नतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2046349, "chapter_id": 2029, "verse_number": "६-७८-३१", "content_sanskrit": "उत्तस्थुः समरे तत्र कबन्धानि समन्ततः।\nकुरूणां चैव सैन्येषु पाण्डवानां च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2046350, "chapter_id": 2029, "verse_number": "६-७८-३२", "content_sanskrit": "शोणितोदं शरावर्तं गजद्वीपं हयोर्मिणम् ।\nरथनौभिर्नरव्याघ्राः प्रतेरुः सैन्यसागरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2046351, "chapter_id": 2029, "verse_number": "६-७८-३३", "content_sanskrit": "छिन्नहस्ता विकवचा विदेहाश्च नरोत्तमाः ।\nदृश्यन्ते पतितास्तत्र शतशोऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2046352, "chapter_id": 2029, "verse_number": "६-७८-३४", "content_sanskrit": "निहतैर्मत्तमातङ्गैः शोणितौघपरिप्लुतैः ।\nभूर्भाति भरतश्रेष्ठ पर्वतैराचिता यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2046353, "chapter_id": 2029, "verse_number": "६-७८-३५", "content_sanskrit": "तत्राद्भुतमपश्याम तव तेषां च भारत ।\nन तत्रासीत्पुमान्कश्चिद्यो युद्धं नाभिकाङ्क्षति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2046354, "chapter_id": 2029, "verse_number": "६-७८-३६", "content_sanskrit": "एवं युयुधिरे वीराः प्रार्थयाना महद्यशः।\nतावकाः पाण्डवैः सार्धमाकाङ्क्षन्तो जयं युधि ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2046355, "chapter_id": 2029, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि षष्ठदिवसयुद्धे अष्टसप्ततितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]