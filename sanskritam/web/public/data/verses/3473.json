[{"id": 2114961, "chapter_id": 3473, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2114962, "chapter_id": 3473, "verse_number": "१", "content_sanskrit": "तेन विक्रमता तूर्णमूरुवेगसमीरितः ।\nप्रववावनिलो राजन् शुचिः शुक्रागमे यथा \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2114963, "chapter_id": 3473, "verse_number": "२", "content_sanskrit": "स मृद्नन् पुष्पितांश्चैव फलिनश्च वनस्पतीन् ।\nआरुजन् दारुगुल्मांश्च पथस्तस्य समीपगान् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2114964, "chapter_id": 3473, "verse_number": "३", "content_sanskrit": "तथा वृक्षान् भञ्जमानो जगामामितविक्रमः ।\nतस्य वेगेन पञ्चानां मूर्च्छेव समजायत \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2114965, "chapter_id": 3473, "verse_number": "४", "content_sanskrit": "असकृच्चापि सन्तीर्य दूरपारं भुजप्लवैः ।\nपथा प्रच्छन्नमासाद्य धार्तराष्ट्रभयात् तदा \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2114966, "chapter_id": 3473, "verse_number": "५", "content_sanskrit": "कृच्छ्रेण मातरं ह्येकां सुकुमारीं यशस्विनीम् ।\nअवहत् तत्र पृष्ठेन रोधस्सु विषमेषु च \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2114967, "chapter_id": 3473, "verse_number": "६", "content_sanskrit": "आगम्य च वनोद्देशमल्पमूलफलोदकम् ।\nक्रूरपक्षिमृगं घोरं सायं समुपचक्रमुः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2114968, "chapter_id": 3473, "verse_number": "७", "content_sanskrit": "घोरा समभवत् सन्ध्या दारुणा मृगपक्षिणः ।\nअप्रकाशा दिशः सर्वाः वातैरासन्ननार्तवैः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2114969, "chapter_id": 3473, "verse_number": "८", "content_sanskrit": "ते श्रमेण च कौन्तेयास्तृषया च प्रपीडिताः ।\nनाशक्नुवंस्ततो गन्तुं निद्रया च प्रवृद्धया \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2114970, "chapter_id": 3473, "verse_number": "९", "content_sanskrit": "शीर्णपर्णफलैर्वृक्षैर्बहुगुल्मक्षपद्रुमैः ।\nभग्नायतनभूयिष्ठे श्वदंष्ट्रिबहुले सदा \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2114971, "chapter_id": 3473, "verse_number": "१०", "content_sanskrit": "न्यविशन्त हि ते तत्र निरास्वादे महावने ।\nरात्र्यामेव गतास्तत्र चतुर्विंशतियोजनम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2114972, "chapter_id": 3473, "verse_number": "११", "content_sanskrit": "अथ तृष्णापरिम्लाना कुन्ती वचनमब्रवीत् ।\nमाता सती पाण्डवानां पञ्चानां मध्यतः स्थिता ।\nतृषया परितप्ताऽस्मि अनाथेव महावने \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2114973, "chapter_id": 3473, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2114974, "chapter_id": 3473, "verse_number": "१२", "content_sanskrit": "तच्छ्रुत्वा भीमसेनस्तु मातृवाक्यमुदीरितम् ।\nकारुण्येन मनश्चक्रे गमनायाथ स त्वरन्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2114975, "chapter_id": 3473, "verse_number": "१३", "content_sanskrit": "ततो भीमो वनं घोरं प्रविश्य विजनं महत् ।\nन्यग्रोधं विपुलच्छायं रमणीयमुपाद्रवत् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2114976, "chapter_id": 3473, "verse_number": "१४", "content_sanskrit": "तत्र निक्षिप्य तान् सर्वानुवाच भरतर्षभः ।\nपानीयं मृगये यावत् तावद् विश्रम्यतामिह \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2114977, "chapter_id": 3473, "verse_number": "१५", "content_sanskrit": "एते रुवन्ति मधुरं सारसा जलचारिणः ।\nध्रुवमत्र जलस्थानमर्हतीति मतिर्मम \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2114978, "chapter_id": 3473, "verse_number": "१६", "content_sanskrit": "अनुज्ञातः स गच्छेति भ्रात्रा ज्येष्ठेन भारत ।\nजगाम तत्र यत्र स्म रुवन्ति जलचारिणः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2114979, "chapter_id": 3473, "verse_number": "१७", "content_sanskrit": "अपश्यत् पद्मिनीषण्डमण्डितं स सरोवरम् ।\nस तत्र पीत्वा पानीयं स्नात्वा च भरतर्षभः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2114980, "chapter_id": 3473, "verse_number": "१८", "content_sanskrit": "उत्तरीयेण पानीयमाजहार परन्तपः ।\nपङ्कजानामनेकैश्च पत्रैर्बद्ध्वा जलाशयात् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2114981, "chapter_id": 3473, "verse_number": "१९", "content_sanskrit": "गव्यूतिमात्रादादाय त्वरितो मातरं प्रति ।\nस सुप्तां मातरं प्रेक्ष्य भ्रातॄंश्च वसुधातळे ।\nभृशं दुःखपरीतात्मा विललाप वृकोदरः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2114982, "chapter_id": 3473, "verse_number": "", "content_sanskrit": "भीमसेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2114983, "chapter_id": 3473, "verse_number": "२०", "content_sanskrit": "शयनेषु परार्घ्येषु प्रसुप्ता वारणावते ।\nनाधिजग्मुस्तदा निद्रां तेऽद्य सुप्ता महीतळे \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2114984, "chapter_id": 3473, "verse_number": "२१", "content_sanskrit": "स्वसारं वसुदेवस्य शत्रुसङ्घविमर्दिनः ।\nभोजराजसुतां कुन्तीं सर्वलक्षणपूजिताम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2114985, "chapter_id": 3473, "verse_number": "२२", "content_sanskrit": "स्नुषां विचित्रवीर्यस्य पाण्डोर्भार्यां महात्मनः ।\nप्रासादशयनां नित्यं पुण्डरीकान्तरप्रभाम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2114986, "chapter_id": 3473, "verse_number": "२३", "content_sanskrit": "सुकुमारतरां स्त्रीणां महार्हशयनोचिताम् ।\nशयानामद्य पश्यामि पृथिव्यां हन्त भो विधे \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2114987, "chapter_id": 3473, "verse_number": "२४", "content_sanskrit": "धर्मादिन्द्राच्च वायोश्च सुषुवे या सुतानिमान् ।\nसेयं भूमौ परिश्रान्ता शेते प्राकृतवद् यथा\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2114988, "chapter_id": 3473, "verse_number": "२५", "content_sanskrit": "अयं नीलाम्बुदप्रख्यो नरेष्वप्रतिमो भुवि ।\nशेते प्राकृतवद् भूमौ ततो दुःखतरं नु किम् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2114989, "chapter_id": 3473, "verse_number": "२६", "content_sanskrit": "इमौ नीलोत्पलश्यामौ नरेष्वप्रतिमौ भुवि ।\nअश्विनाविव देवानामाश्विनौ रूपसम्पदा \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2114990, "chapter_id": 3473, "verse_number": "२७", "content_sanskrit": "तौ तु प्राकृतवच्चोभौ प्रसुप्तौ धरणीतळे ।\nज्ञातयो यस्य नैव स्युर्विषमाः कुलपांसनाः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2114991, "chapter_id": 3473, "verse_number": "२८", "content_sanskrit": "स जीवेत् सुखितो लोके ग्रामद्रुम इवैकलः ।\nएको वृक्षो हि यो ग्रामे भवेत् पर्णफलान्वितः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2114992, "chapter_id": 3473, "verse_number": "२९", "content_sanskrit": "चैत्यो भवति निर्ज्ञातिरर्चनीयः सुपूजितः ।\nयेषां च बहवः शूरा ज्ञातयो धर्मवत्सलाः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2114993, "chapter_id": 3473, "verse_number": "३०", "content_sanskrit": "ते जीवन्ति चिरं कालं भवन्ति च निरामयाः ।\nबलवन्तः समृद्धार्था पितृबान्धवनन्दनाः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2114994, "chapter_id": 3473, "verse_number": "३१", "content_sanskrit": "जीवन्त्यन्योन्यमाश्रित्य द्रुमाः काननजा इव ।\nवयं च धृतराष्ट्रेण सपुत्रेण दुरात्मना \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2114995, "chapter_id": 3473, "verse_number": "३२", "content_sanskrit": "विवासिताश्च दग्धाश्च क्षत्तुर्बुद्धिपराक्रमात् ।\nतस्मान्मुक्ता वयं दाहादिमं वृक्षमुपाश्रिताः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2114996, "chapter_id": 3473, "verse_number": "३३", "content_sanskrit": "कां दिशं प्रतिपत्स्यामः प्राप्ताः क्लेशमनुत्तमम् ।\nनातिदूरेण नगरं वनादस्माद्धि लक्षये \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2114997, "chapter_id": 3473, "verse_number": "३४", "content_sanskrit": "जागर्तव्ये स्वपन्तीमे हन्त जागर्म्यहं स्वयम् ।\nप्राश्यन्तीमे जलं पश्चात् प्रतिबुद्धा जितक्लमाः ।\nइति भीमो विनिश्चित्य जजागार स्वयं तदा \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2114998, "chapter_id": 3473, "verse_number": "१५२", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nद्विपञ्चाशदधिकशततमोऽध्यायः ॥१५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2114999, "chapter_id": 3473, "verse_number": "१०", "content_sanskrit": "॥ इति जतुगृहदाहपर्वणि दशमोऽध्यायः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2115000, "chapter_id": 3473, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2115001, "chapter_id": 3473, "verse_number": "", "content_sanskrit": "॥ जतुगृहदाहपर्व समाप्तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]