[{"id": 2110614, "chapter_id": 3392, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2110615, "chapter_id": 3392, "verse_number": "१", "content_sanskrit": "ययातिः स्वपुरं गत्वा पताकाभिरलङ्कृतम् ।\nप्रविश्यान्तःपुरं राजा देवयानीं न्यवेशयत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2110616, "chapter_id": 3392, "verse_number": "२", "content_sanskrit": "देवयान्याश्चानुमते सुतां तां वृषपर्वणः ।\nअशोकवनिकाभ्याशे गृहं कृत्वा न्यवेशयत् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2110617, "chapter_id": 3392, "verse_number": "३", "content_sanskrit": "वृतां दासीसहस्रेण शर्मिष्ठामसुरायणीम् ।\nवासोभिरन्नपानैश्च संविभज्य सुसत्कृताम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2110618, "chapter_id": 3392, "verse_number": "४", "content_sanskrit": "देवयान्याऽपि सहितो ययातिर्नहुषात्मजः ।\nप्रीत्या परमया युक्तो मुमुदे शाश्वतीः समाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2110619, "chapter_id": 3392, "verse_number": "५", "content_sanskrit": "अशोकवनिकामध्ये देवयानी समागता ।\nशर्मिष्ठया सा क्रीडित्वा रमणीये मनोरमे\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2110620, "chapter_id": 3392, "verse_number": "६", "content_sanskrit": "तत्रैव तां तु निर्दिश्य राज्ञा सह ययौ गृहम् ।\nएवमेव सह प्रीत्या मुमुदे बहुकालतः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2110621, "chapter_id": 3392, "verse_number": "७", "content_sanskrit": "विजहार बहून् वर्षान् देववन्मुमुदे भृशम् ।\nऋतुकाले तु सम्प्राप्ते देवयानी शुचिस्मिता \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2110622, "chapter_id": 3392, "verse_number": "८", "content_sanskrit": "लेभे गर्भं वर्षसहस्रे तु कुमारं चाप्यजायत ।\nगते वर्षसहस्रे तु शर्मिष्ठा वार्षपर्वणी\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2110623, "chapter_id": 3392, "verse_number": "९", "content_sanskrit": "सा तु काले ऋतुस्नाता भर्तारं समचिन्तयत् ।\nशुद्धा स्नाता तु शर्मिष्ठा सर्वालङ्कारभूषिता \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2110624, "chapter_id": 3392, "verse_number": "१०", "content_sanskrit": "अशोकशाखामालम्व्य सुपुष्पैः स्तबकैर्वृताम् ।\nआदर्शे मुखमुद्वीक्ष्य भर्तुर्दर्शनलालसा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2110625, "chapter_id": 3392, "verse_number": "११", "content_sanskrit": "शोकमोहसमाविष्टा वचनं चेदमब्रवीत् ।\nअशोक शोकापनुद शोकोपहतचेतनाम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2110626, "chapter_id": 3392, "verse_number": "१२", "content_sanskrit": "त्वन्नामानं कुरु क्षिप्रं प्रियसन्दर्शनेन माम् ।\nएवमुक्तवती सा तु शर्मिष्ठा पुनरब्रवीत् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2110627, "chapter_id": 3392, "verse_number": "१३", "content_sanskrit": "ऋतुकालश्च सम्प्राप्तो न च भर्ताऽस्ति कश्चन ।\nकिं प्राप्तं किं नु कर्तव्यं किं वा कृत्वा कृतं भवेत् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2110628, "chapter_id": 3392, "verse_number": "१४", "content_sanskrit": "देवयानी प्रजाता सा वृथाऽहं प्राप्तयौवना ।\nदेवयानी पुण्यतमा यस्या भर्ता हि नाहुषः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2110629, "chapter_id": 3392, "verse_number": "१५", "content_sanskrit": "यथा तस्या भवेद् भर्ता ममाप्येष तथा भवेत् ।\nराज्ञा पुत्रफलं देयमिति मे निश्चिता मतिः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2110630, "chapter_id": 3392, "verse_number": "१६", "content_sanskrit": "अपीदानीं स धर्मात्मा इयान्मे दर्शनं नृपः\nकेशे बद्ध्वा तु राजानं याचेऽहं सदृशं पतिम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2110631, "chapter_id": 3392, "verse_number": "१७", "content_sanskrit": "गृहे मुदा देवयानीपुत्रमीक्ष्य पुनः पुनः ।\nक्रीडन्नन्तःपुरे तस्याः कञ्चित् क्षणमवाप सः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2110632, "chapter_id": 3392, "verse_number": "१८", "content_sanskrit": "अथ निष्क्रम्य राजा स तस्मिन् काले यदृच्छया ।\nअशोकवनिकाभ्याशे शर्मिष्ठां प्रेक्ष्य तिष्ठतीम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2110633, "chapter_id": 3392, "verse_number": "१९", "content_sanskrit": "दृश्ट्वा तमेकं रहसि शर्मिष्ठा चारुहासिनी ।\nप्रत्युद्गम्याञ्जलिं कृत्वा राजानं वाक्यमब्रवीत् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2110634, "chapter_id": 3392, "verse_number": "२०", "content_sanskrit": "सोमस्येन्द्रस्य विष्णोर्वा यमस्य धनदस्य च\nतव वा नाहुष कुले कः स्त्रियं स्प्रष्टुमर्हति \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2110635, "chapter_id": 3392, "verse_number": "२१", "content_sanskrit": "रूपाभिजनशीलैर्हि त्वं राजन् वेत्थ मां सदा ।\nत्वां याचे सम्प्रसाद्याहं ऋतुं देहि नराधिप\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2110636, "chapter_id": 3392, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2110637, "chapter_id": 3392, "verse_number": "२२", "content_sanskrit": "वेद्मि त्वां शीलसम्पन्नां वेद्मि कन्यामनिन्दिताम् ।\nरूपेण ते न पश्यामि सूच्यग्रमपि निन्दितम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2110638, "chapter_id": 3392, "verse_number": "२३", "content_sanskrit": "तदाप्रभृति दृष्ट्वा त्वां स्मराम्यनिशमुत्तमे ।\nअब्रवीदुशना काव्यो देवयानीं यदा वहेः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2110639, "chapter_id": 3392, "verse_number": "२४", "content_sanskrit": "नेयमाह्वयितव्या ते शयने वाऽन्यथाऽपि वा ।\nदेवयान्याः प्रियं कृत्वा शर्मिष्ठामपि पोषय\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2110640, "chapter_id": 3392, "verse_number": "", "content_sanskrit": "शर्मिष्ठा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2110641, "chapter_id": 3392, "verse_number": "२५", "content_sanskrit": "न नर्मयुक्तमनृतं हिनस्ति\nन स्त्रीषु राजन्न विवाहकाले ।\nप्राणात्यये सर्वधनातिपाते\nपञ्चानृतान्याहुरपातकानि\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2110642, "chapter_id": 3392, "verse_number": "२६", "content_sanskrit": "पृष्टस्तु साक्ष्ये प्रवदन्तमन्यथा\nवदन्ति मिथ्योपचितं नरेन्द्र ।\nएकार्थतायां च समाहितायां\nमिथ्या वदन्तं ह्यनृतं हिनस्ति\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2110643, "chapter_id": 3392, "verse_number": "२७", "content_sanskrit": "अनृतं नानृतं स्त्रीषु परिहासविवाहयोः ।\nआत्मप्राणार्थघातेपु तदेवोत्तमतां व्रजेत् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2110644, "chapter_id": 3392, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2110645, "chapter_id": 3392, "verse_number": "२८", "content_sanskrit": "राजा प्रमाणं भूतानां स नश्येदनृतं वदन् ।\nअर्थकृच्छ्रमपि प्राप्य न मृषा कर्तुमुत्सहे\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2110646, "chapter_id": 3392, "verse_number": "", "content_sanskrit": "शर्मिष्ठा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2110647, "chapter_id": 3392, "verse_number": "२९", "content_sanskrit": "उभौ हि च पती लोके पतिः सख्याः पतिश्च यः ।\nसमं विवाहमित्याहुः सख्या मेऽसि पतिर्वृतः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2110648, "chapter_id": 3392, "verse_number": "३०", "content_sanskrit": "त्रय एवाधना राजन् भार्या दासस्तथा सुतः ।\nयत् ते समधिगच्छन्ति यस्यैते तस्य तद्धनम् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2110649, "chapter_id": 3392, "verse_number": "३१", "content_sanskrit": "सह दत्तास्मि काव्येन देययान्या मनीषिणा ।\nपूज्या पोषयितव्येति न मृषा कर्तुमर्हसि\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2110650, "chapter_id": 3392, "verse_number": "३२", "content_sanskrit": "सुवर्णमणिमुक्तानि वस्त्राण्यभरणानि च ।\nयाचितॄणां ददासि त्वं गोभूम्यादीनि यानि च\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2110651, "chapter_id": 3392, "verse_number": "३३", "content_sanskrit": "बहिःस्थं दानमित्युक्तं न शरीराश्रितं नृप ।\nपुष्कळं पुत्रदानं च आत्मदानं च मारिष \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2110652, "chapter_id": 3392, "verse_number": "३४", "content_sanskrit": "शरीरदानात् तत्सर्वं दत्तं भवति मारिष ।\nयस्य यस्य यथा कामस्तस्य तस्य ददाम्यहम् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2110653, "chapter_id": 3392, "verse_number": "३५", "content_sanskrit": "इत्युक्त्वा नगरे राजंस्त्रिकालं घोषितं त्वया ।\nअनृतं त्वयोक्तं राजेन्द्र वृथा घोषितमेय च ।\nतत् सत्यं कुरु राजेन्द्र यथा वैश्रवणस्तथा\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2110654, "chapter_id": 3392, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2110655, "chapter_id": 3392, "verse_number": "३६", "content_sanskrit": "दास्यामि याचते नित्यमिति मे व्रतमाहितम् ।\nत्वं च याचसि मां कामं ब्रूहि किं करवाणि ते ।\nधनं वा यदि वा किञ्चिद् राज्यं वाऽपि शुचिस्मिते\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2110656, "chapter_id": 3392, "verse_number": "", "content_sanskrit": "शर्मिष्ठा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2110657, "chapter_id": 3392, "verse_number": "३८", "content_sanskrit": "अधर्मात् त्राहि मां राजन् धर्मे च प्रतिपादय ।\nनान्यं वृणे पुत्रकामा पुत्रात् परतरं न च\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2110658, "chapter_id": 3392, "verse_number": "३९", "content_sanskrit": "त्वत्तोऽपत्यवती लोके चरेयं धर्ममुत्तमम् ।\nपुत्रार्थं भर्तृपोषार्थं स्त्रियः सृष्टाः स्वयम्भुवा\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2110659, "chapter_id": 3392, "verse_number": "४०", "content_sanskrit": "अपतिश्चापि या कन्या अनपत्या च या भवेत् ।\nतस्या जन्म वृथा लोके गतिस्तस्या न विद्यते \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2110660, "chapter_id": 3392, "verse_number": "४१", "content_sanskrit": "देवयान्या भुजिष्याऽस्मि वश्या च तव भार्गवी ।\nसा चाहं च त्वया राजन् भरणीये भजस्व माम् \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2110661, "chapter_id": 3392, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2110662, "chapter_id": 3392, "verse_number": "४२", "content_sanskrit": "एवमुक्तस्तु राजा स तथ्यमित्येव जज्ञिवान् ।\nकाव्याच्च देवयान्याश्च भीतो धर्मभयादपि\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2110663, "chapter_id": 3392, "verse_number": "४३", "content_sanskrit": "पूजयामास शर्मिष्ठां धर्मे च प्रत्यपादयत् ।\nऋत्विक्पुरोहिताचार्यैर्मन्त्रिभिश्चापि संवृतः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2110664, "chapter_id": 3392, "verse_number": "४४", "content_sanskrit": "विवाहं विधिवत् कृत्वा दत्वा ब्राह्मणदक्षिणाम् ।\nपुण्ये नक्षत्रसंयोगे मुहूर्ते विप्रपूजिते \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2110665, "chapter_id": 3392, "verse_number": "४५", "content_sanskrit": "समागम्य च शर्मिष्ठां यथा काममवाप्य च ।\nअन्योन्यं पूजयित्वा तु जग्मतुस्तौ यथागतम् \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2110666, "chapter_id": 3392, "verse_number": "४६", "content_sanskrit": "तस्मिन् समागमे सुभ्रूः शर्मिष्ठा चारुहासिनी ।\nलेभे गर्भं प्रथमतस्तस्माद् राजर्षिसत्तमात् \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2110667, "chapter_id": 3392, "verse_number": "४७", "content_sanskrit": "प्रजज्ञे च ततः काले क्रियाः कृत्वा विशेषतः ।\nकुमारं देवगर्भाभं राजीवनिभलोचनम् \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2110668, "chapter_id": 3392, "verse_number": "७१", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nएकसप्ततितमोऽध्यायः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2110669, "chapter_id": 3392, "verse_number": "१९", "content_sanskrit": "॥ सम्भवपर्वणि एकोनविंशोऽध्यायः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]