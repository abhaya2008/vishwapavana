[{"id": 7005829000, "chapter_id": 25829, "verse_number": "१-१२-१", "content_sanskrit": "हरिरुवाच ।\nपूजानुक्रमसिद्ध्यर्थं पूजानुक्रम उच्ते।\nॐ नम इत्यादौ संस्मृतिः परमात्मनः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005829001, "chapter_id": 25829, "verse_number": "१-१२-२", "content_sanskrit": "यं रं वं लमिति कायशुद्धिः ।\nॐ नम इति चतुर्भुजात्मनिर्माणम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005829002, "chapter_id": 25829, "verse_number": "१-१२-३", "content_sanskrit": "ॐ नमो भगवते वांसुंदेवयं ॐ नमो नारायणाय नमः ।\nॐ पुरुषोत्तमाय नमः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005829003, "chapter_id": 25829, "verse_number": "१-१२-४", "content_sanskrit": "नमस्ते पुण्डरीकाक्ष नमस्ते विश्वभावन ।\nसुब्रह्मण्य नमस्तेऽस्तु महापुरुष पूर्वज ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005829004, "chapter_id": 25829, "verse_number": "१-१२-५", "content_sanskrit": "होमकर्मणि चैतेषां स्वाहान्तमुपकल्पयेत् ।\nएवं जप्त्वा विधानेन शतमष्टोत्तरं तथा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005829005, "chapter_id": 25829, "verse_number": "१-१२-६", "content_sanskrit": "अर्घं दत्त्वा जितं तेन प्रणामं च पुनः पनः।\nततोऽग्नावपि सम्पूज्यं तं यजेत यथाविधि ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005829006, "chapter_id": 25829, "verse_number": "१-१२-७", "content_sanskrit": "देवदेवं स्वबीजेन अंगादिभिरथाच्युतम् ।\nपूर्वमुल्लिख्य चाभ्युक्ष्य प्रणवेन तु मन्त्रवित् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005829007, "chapter_id": 25829, "verse_number": "१-१२-८", "content_sanskrit": "भ्रामयित्वानलं कुंडे पूजयेच्च शुभैः फलैः ।\nपूर्वं तत्सकलं ध्यात्वा मण्डले मनसा न्यसेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005829008, "chapter_id": 25829, "verse_number": "१-१२-९", "content_sanskrit": "वासुदेवाख्यतत्त्वेन हुत्वा चाष्टोत्तरं तम्।\nसंकर्षणादिबीजेन यजेत्षट्कं तथैव च ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005829009, "chapter_id": 25829, "verse_number": "१-१२-१०", "content_sanskrit": "त्रयं त्रयं तथांगानामेकैकान्दिक्‌पतींस्तथा ।\nपूर्णाहुतिं तथैवांते दद्यात्सम्यगुपस्थितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005829010, "chapter_id": 25829, "verse_number": "१-१२-११", "content_sanskrit": "वागतीते परे तत्त्वे आत्मानं च लयं नयेत् ।\nउपविश्य पुनर्मुद्रां दर्शयित्वा नमेत्पुनः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005829011, "chapter_id": 25829, "verse_number": "१-१२-१२", "content_sanskrit": "नित्यमेवंविधं होमं नैमित्तं द्विगुणं भवेत् ।\nगच्छगच्छ परं स्थानं यत्र देवो निरञ्जनः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005829012, "chapter_id": 25829, "verse_number": "१-१२-१३", "content_sanskrit": "गच्छन्तु देवताः सर्वाः स्वस्थानस्थितिहेतवे ।\nसुदर्शनः श्रीहरिश्च अच्युतः स त्रिविक्रमः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005829013, "chapter_id": 25829, "verse_number": "१-१२-१४", "content_sanskrit": "चतुर्भुजो वासुदेवः षष्ठः प्रद्युम्न एव।\nसंकर्षणः पुरुषोऽथ नवव्यूहो दशात्मकः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005829014, "chapter_id": 25829, "verse_number": "१-१२-१५", "content_sanskrit": "अनिरुद्धो द्वादशात्मा अथ ऊर्द्धमनन्तकः ।\nएते एकादिभिश्चक्रैर्विज्ञेया लक्षिताः सुराः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005829015, "chapter_id": 25829, "verse_number": "१-१२-१६", "content_sanskrit": "चक्रांकितैः पूजितः स्यान्द्रृहे रक्षेत्सदानवैः ।\nॐ चक्राय स्वाहा, ॐ विचक्राय स्वाहा, ॐ सुचक्राय स्वाहा, ॐ महाचक्राय स्वाहा, ॐ महाचक्राय असुरान्तकृत्‌ हुं फट् ॐ हुं सहस्त्रार हुं फट् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005829016, "chapter_id": 25829, "verse_number": "१-१२-१७", "content_sanskrit": "द्वारकाचक्रपूजेयं गृहे रक्षाकरी शुभा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]