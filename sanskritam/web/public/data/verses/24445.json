[{"id": 7004445000, "chapter_id": 24445, "verse_number": "५-३-१३९-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nततो गच्छेन्महाराज सोमतीर्थमनुत्तमम् ।\nयत्र सोमस्तपस्तप्त्वा नक्षत्रपथमास्थितः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004445001, "chapter_id": 24445, "verse_number": "५-३-१३९-२", "content_sanskrit": "तत्र तीर्थे तु यः स्नायादाचम्य विधिपूर्वकम् ।\nकृतजाप्यो रविं ध्यायेत्तस्य पुण्यफलं शृणु॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004445002, "chapter_id": 24445, "verse_number": "५-३-१३९-३", "content_sanskrit": "ऋग्वेदयजुर्वेदाभ्यां सामवेदेन भारत ।\nजपतो यत्फलं प्रोक्तं गायत्र्या चात्र तत्फलम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004445003, "chapter_id": 24445, "verse_number": "५-३-१३९-४", "content_sanskrit": "तत्र तीर्थे तु यो भक्त्या ब्राह्मणान् भोजयेच्छुचिः ।\nतेन सम्यग्विधानेन कोटिर्भवति भोजिता॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004445004, "chapter_id": 24445, "verse_number": "५-३-१३९-५", "content_sanskrit": "पादुकोपानहौ छत्रं वस्त्रकम्बलवाजिनः ।\nयो दत्ते विप्रमुख्याय तस्य तत्कोटिसंमितम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004445005, "chapter_id": 24445, "verse_number": "५-३-१३९-६", "content_sanskrit": "सहस्रं तु सहस्राणामनृचां यस्तु भोजयेत् ।\nएकस्य मन्त्रयुक्तस्य कलां नार्हति षोडशीम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004445006, "chapter_id": 24445, "verse_number": "५-३-१३९-७", "content_sanskrit": "एवं तु भोजयेत्तत्र बह्वृचं वेदपारगम् ।\nशाखान्तर्गमथाध्वर्युं छन्दोगं वा समाप्तिगम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004445007, "chapter_id": 24445, "verse_number": "५-३-१३९-८", "content_sanskrit": "अग्निहोत्रसहस्रस्य यत्फलं प्राप्यते बुधैः ।\nसमं तद्वेदविदुषा तीर्थे सोमस्य तत्फलम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004445008, "chapter_id": 24445, "verse_number": "५-३-१३९-९", "content_sanskrit": "भोजयेद्यः शतं तेषां सहस्रं लभते नरः ।\nएकस्य योगयुक्तस्य तत्फलं कवयो विदुः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004445009, "chapter_id": 24445, "verse_number": "५-३-१३९-१०", "content_sanskrit": "संनिरुध्येन्द्रियग्रामं यत्रयत्र वसेन्मुनिः ।\nतत्रतत्र कुरुक्षेत्रं नैमिषं पुष्कराणि च॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004445010, "chapter_id": 24445, "verse_number": "५-३-१३९-११", "content_sanskrit": "तस्मात्सर्वप्रयत्नेन ग्रहणे चन्द्रसूर्ययोः ।\nसंक्रान्तौ च व्यतीपाते योगी भोज्यो विशेषतः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004445011, "chapter_id": 24445, "verse_number": "५-३-१३९-१२", "content_sanskrit": "संन्यासं कुरुते यस्तु तत्र तीर्थे युधिष्ठिर ।\nविमानेन महाभागाः स याति त्रिदिवं नरः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004445012, "chapter_id": 24445, "verse_number": "५-३-१३९-१३", "content_sanskrit": "सोमस्यानुचरो भूत्वा तेनैव सह मोदते॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]