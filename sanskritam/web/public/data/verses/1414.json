[{"id": 2019882, "chapter_id": 1414, "verse_number": "३-५२-०x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2019883, "chapter_id": 1414, "verse_number": "३-५२-१", "content_sanskrit": "तेभ्यः प्रतिज्ञाय नलः करिष्य इति भारत।\nअथैतान्परिपप्रच्छ कृताञ्जलिरुपस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2019884, "chapter_id": 1414, "verse_number": "३-५२-२", "content_sanskrit": "के वै भवन्तः कश्चासौ यस्याहं दूत ईप्सितः।\nकिंच तत्रमया कार्यं कथयध्वं यथातथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2019885, "chapter_id": 1414, "verse_number": "३-५२-३", "content_sanskrit": "एवमुक्ते नैषधेन मघवानभ्यभाषत।\nअमरान्वै निबोधास्मान्दमयन्त्यर्थमागतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2019886, "chapter_id": 1414, "verse_number": "३-५२-४", "content_sanskrit": "अहमिन्द्रोऽयमग्निश्च तथैवायमपांपतिः।\nशरीरान्तकरो नॄणां यमोऽयमपि पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2019887, "chapter_id": 1414, "verse_number": "३-५२-५", "content_sanskrit": "त्वं वै समागतानस्मान्दमयन्त्यै निवेदय।\nलोकपाला महेन्द्राद्याः समायान्ति दिदृक्षवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2019888, "chapter_id": 1414, "verse_number": "३-५२-६", "content_sanskrit": "प्राप्तुमिच्छन्ति देवास्त्वां शक्रोऽग्निर्वरुणो यमः।\nतेषामन्यतमं देवं पतित्वे वरयस्व ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2019889, "chapter_id": 1414, "verse_number": "३-५२-७", "content_sanskrit": "एवमुक्तः स शक्रेण नलः प्राञ्जलिरब्रवीत्।\nएकार्थसमवेतं मां न प्रेषयितुमर्हथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2019890, "chapter_id": 1414, "verse_number": "३-५२-८", "content_sanskrit": "कथ हि जातसंकल्पः स्त्रियमुत्सृजते पुमान्।\nपरार्थमीदृशं वक्तं तद्वै पश्यामरेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2019891, "chapter_id": 1414, "verse_number": "३-५२-९", "content_sanskrit": "`एवमुक्तो नैषधेन मघवान्पुनरब्रवीत्।\nकरिष्य इतिसंश्रुत्य पूर्वमस्मासु नैषध।\nन करिष्यसि कस्मात्त्वं व्रज नैषध माचिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2019892, "chapter_id": 1414, "verse_number": "३-५२-१०", "content_sanskrit": "`स वै त्वमागतानस्मान्दमयन्त्यै निवेदय।\nश्रेयसा योक्ष्यसे हि त्वं कुर्वन्नमरशासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2019893, "chapter_id": 1414, "verse_number": "३-५२-११x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2019894, "chapter_id": 1414, "verse_number": "३-५२-११", "content_sanskrit": "एवमुक्तः स देवैस्तैर्नैषधः पुनरब्रवीत्।\nसुरक्षितानि वेश्मानि प्रवेष्टुं कथमुत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2019895, "chapter_id": 1414, "verse_number": "३-५२-१२", "content_sanskrit": "प्रवेक्ष्यसीति तं शक्रः पुनरेवाभ्यभाषत।\nजगाम स तथेत्युक्त्वा दमयन्त्या निवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2019896, "chapter_id": 1414, "verse_number": "३-५२-१३", "content_sanskrit": "ददर्श तत्र वैदर्भीं सखीगणसमावृताम्।\nदेदीप्यमानां वपुषा श्रिया च वरवर्णिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2019897, "chapter_id": 1414, "verse_number": "३-५२-१४", "content_sanskrit": "अतीव सुकुमाराङ्गीं तनुमध्यां सुलोचनाम्।\nआक्षिपन्तीमिव च तां शशिनं स्वेन तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2019898, "chapter_id": 1414, "verse_number": "३-५२-१५", "content_sanskrit": "तस्य दृष्ट्वैव ववृधे कामस्तां चारुहासिनीम्।\nसत्यं चिकीर्षमाणस्तुधारयामास हृच्छयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2019899, "chapter_id": 1414, "verse_number": "३-५२-१६", "content_sanskrit": "ततस्ता नैषधं दृष्ट्वा संभ्रान्ताः परमाङ्गनाः।\nआसनेभ्यः समुत्पेतुस्तेजसा तस्य धर्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2019900, "chapter_id": 1414, "verse_number": "३-५२-१७", "content_sanskrit": "प्रशशंसुश्च मुप्रीता नलं ता विस्मयान्विताः।\nन चैनमभ्यभाषन्त मनोभिस्त्वभ्यपूजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2019901, "chapter_id": 1414, "verse_number": "३-५२-१८", "content_sanskrit": "अहो रूपमहो कान्तिरहो धैर्यं महात्मनः।\nकोऽयं देवोऽथवा यक्षो गन्धर्वो वा भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2019902, "chapter_id": 1414, "verse_number": "३-५२-१९", "content_sanskrit": "न तास्तं शक्नुवन्ति स्म व्याहर्तुमपि किंचन।\nतेजसा धर्षितास्तस्य लज्जावत्यो वराङ्गनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2019903, "chapter_id": 1414, "verse_number": "३-५२-२०", "content_sanskrit": "अथैनं स्मयमानेव स्मितपूर्वाभिभाषिणी।\nदमयन्ती नलं वीरमभ्यभाषत विस्मिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2019904, "chapter_id": 1414, "verse_number": "३-५२-२१", "content_sanskrit": "कस्त्वं सर्वानवद्याङ्ग मम हृच्छयवर्धन।\nप्राप्तोस्यमरवद्वीर ज्ञातुमिच्छामि तेऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2019905, "chapter_id": 1414, "verse_number": "३-५२-२२", "content_sanskrit": "कथमागमनं चेह कथं चासि न लक्षितः।\nसुरक्षितं हि मे वेश्म राजा चैवोग्रशासनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2019906, "chapter_id": 1414, "verse_number": "३-५२-२३", "content_sanskrit": "एवमुक्तस्तु वैदर्भ्या नलस्तां प्रत्युवाच ह।\nनलं मां विद्धि कल्याणि देवदूतमिहागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2019907, "chapter_id": 1414, "verse_number": "३-५२-२४", "content_sanskrit": "देवास्त्वां प्राप्तुमिच्छन्ति शक्रोऽग्निर्वरुणो यमः।\nतेषामन्यतमं देवं पतिं वरय शोभने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2019908, "chapter_id": 1414, "verse_number": "३-५२-२५", "content_sanskrit": "तेषामेव प्रभावेण प्रविष्टोऽहमलक्षितः।\nप्रविशन्तं न मां कश्चिदपश्यन्नाप्यवारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2019909, "chapter_id": 1414, "verse_number": "३-५२-२६", "content_sanskrit": "एतदर्थमहं भद्रे प्रेषितः सुरसत्तमैः।\nएतच्छ्रुत्वा शुभे बुद्धिं प्रकुरुष्व यथेच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2019910, "chapter_id": 1414, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि नलोपाख्यानपर्वणि द्विपञ्चाशोऽध्यायः ॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]