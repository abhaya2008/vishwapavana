[{"id": 7004052000, "chapter_id": 24052, "verse_number": "४-१-१", "content_sanskrit": "श्रीगणेशाय नमः ।\nतं मन्महे महेशानं महेशानप्रियार्भकम् ।\nगणेशानं करिगणेशानाननमनामयम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004052001, "chapter_id": 24052, "verse_number": "४-१-२", "content_sanskrit": "भूमिष्ठापि न यात्रभूस्त्रिदिवतोप्युच्चैरधःस्थापि या या बद्धा भुवि मुक्तिदास्युरमृतं यस्यां मृता जंतवः ।\nया नित्यं त्रिजगत्पवित्रतटिनी तीरे सुरैः सेव्यते सा काशी त्रिपुरारिराजनगरी पायादपायाज्जगत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004052002, "chapter_id": 24052, "verse_number": "४-१-३", "content_sanskrit": "नमस्तस्मै महेशाय यस्य संध्यात्त्रयच्छलात् ।\nयातायातं प्रकुर्वंति त्रिजगत्पतयोऽनिशम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004052003, "chapter_id": 24052, "verse_number": "४-१-४", "content_sanskrit": "अष्टादशपुराणानां कर्त्ता सत्यवतीसुतः ।\nसूताग्रे कथयामास कथां पापापनोदिनीम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004052004, "chapter_id": 24052, "verse_number": "४-१-५", "content_sanskrit": "श्रीव्यास उवाच ।\nकदाचिन्नारदः श्रीमान्स्नात्वा श्रीनर्मदांभसि ।\nश्रीमदोंकारमभ्यर्च्य सर्वदं सर्वदेहिनाम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004052005, "chapter_id": 24052, "verse_number": "४-१-६", "content_sanskrit": "व्रजन्विलोकयांचक्रे पुरोविंध्यं धराधरम् ।\nसंसारतापसंहारि रेवावारिपरिष्कृतम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004052006, "chapter_id": 24052, "verse_number": "४-१-७", "content_sanskrit": "द्वैरूप्येणापि कुर्वंतं स्थावरेण चरेण च ।\nसाभिख्येन यथार्थाख्यामुच्चैर्वसु मतीमिमाम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004052007, "chapter_id": 24052, "verse_number": "४-१-८", "content_sanskrit": "रसालयं रसालैस्तैरशोकैः शोकहारिणाम् ।\nतालैस्तमालेर्हिंतालैः सालैः सर्वत्रशालितम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004052008, "chapter_id": 24052, "verse_number": "४-१-९", "content_sanskrit": "खपुरैः खपुराकारं श्रीफलं श्रीफलैः किल ।\nगुरुश्रियंत्वगुरुभिः कपिपिंगं कपित्थकैः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004052009, "chapter_id": 24052, "verse_number": "४-१-१०", "content_sanskrit": "वनश्रियः कुचाकारैर्लकुचैश्च मनोहरम् ।\nसुधाफलसमारंभि रंभाभिः परिभासितम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004052010, "chapter_id": 24052, "verse_number": "४-१-११", "content_sanskrit": "सुरंगैश्चापि नारंगैरंगमंडपवच्छियः ।\nवानीरैश्चापि जंबीरैर्बीजपूरैः प्रपूरितम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004052011, "chapter_id": 24052, "verse_number": "४-१-१२", "content_sanskrit": "अनिलालोल कंकोल वल्लीहल्ली सकायितम् ।\nलवलीलवलीलाभिर्लास्यलीलालयं किल ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004052012, "chapter_id": 24052, "verse_number": "४-१-१३", "content_sanskrit": "मंदांदोलितकर्पूर कदलीदल संज्ञया ।\nविश्रमाय श्रमापन्नानाहूयंतमिवाध्वगान् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004052013, "chapter_id": 24052, "verse_number": "४-१-१४", "content_sanskrit": "पुन्नागमिव पुन्नागपल्लवैःकरपल्लवैः ।\nकलयंतमिवाऽलोलैर्मल्लिकास्तबकस्तनम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004052014, "chapter_id": 24052, "verse_number": "४-१-१५", "content_sanskrit": "विदीर्णदाडिमैः स्वांतं दर्शयंतं तु रागवत् ।\nमाधवीं धवरूपेण श्लिष्यंतमिव कानने ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004052015, "chapter_id": 24052, "verse_number": "४-१-१६", "content_sanskrit": "उदुंबरैरंबरगैरनंतफलमालितैः ।\nब्रह्मांडकोटीर्बिभ्रंतमनंतमिव सर्वतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004052016, "chapter_id": 24052, "verse_number": "४-१-१७", "content_sanskrit": "पनसैर्वनासाभैः शुकनासैः पलाशकैः ।\nपलाशनाद्विरहिणां पत्रत्यक्तैरिवावृतम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004052017, "chapter_id": 24052, "verse_number": "४-१-१८", "content_sanskrit": "कदंबवादिनो नीपान्दृष्ट्वा कंटकितैरिव ।\nसमंततो भ्राजमानं कदंबककदंबकैः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004052018, "chapter_id": 24052, "verse_number": "४-१-१९", "content_sanskrit": "नमेरुभिश्च मेरूच्चशिखरैरिव राजितम् ।\nराजादनैश्च मदनैः सदनैरिव कामिनाम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004052019, "chapter_id": 24052, "verse_number": "४-१-२०", "content_sanskrit": "तटेतटेपटुवटैरुच्चैःपटकुटी वृतम् ।\nकुटजस्तबकैर्भांतमधिष्ठितबकैरिव ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004052020, "chapter_id": 24052, "verse_number": "४-१-२१", "content_sanskrit": "करमर्दैः करीरैश्च करजैश्चकरंबकैः ।\nसहस्रकरवद्भांतमर्थिप्रत्युद्गतैः करैः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004052021, "chapter_id": 24052, "verse_number": "४-१-२२", "content_sanskrit": "नीराजितमिवोद्दीपैराजचंपककोरकैः ।\nसपुष्पशाल्मलीभिश्च जितपद्माकरश्रियम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004052022, "chapter_id": 24052, "verse_number": "४-१-२३", "content_sanskrit": "क्वचिच्चलदलैरुच्चैः क्वचित्कांचनकेतकैः ।\nकृतमालैर्न क्तमालैः शोभमानं क्वचित्क्वचित् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004052023, "chapter_id": 24052, "verse_number": "४-१-२४", "content_sanskrit": "कर्कंधु बंधुजीवैश्च पुत्रजीवैर्विराजितम् ।\nसतिंदुकेंगुदीभिश्च करुणैःकरुणालयम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004052024, "chapter_id": 24052, "verse_number": "४-१-२५", "content_sanskrit": "गलन्मधू ककुसुमैर्धरारूपधरंहरम् ।\nस्वहस्तमुक्तमुक्ताभिरर्चयंतमिवानिशम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004052025, "chapter_id": 24052, "verse_number": "४-१-२६", "content_sanskrit": "सर्जार्जुनांजनैर्बीजैर्व्यजनैर्वीज्यमानवत् ।\nनारिकेलैः सखर्जूरैर्धृतच्छत्रमिवांबरे ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004052026, "chapter_id": 24052, "verse_number": "४-१-२७", "content_sanskrit": "अमंदैः पिचुमंदैश्च मंदारैः कोविदारकैः ।\nपाटलातिंतिणीघोंटाशाखोटैः करहाटकैः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004052027, "chapter_id": 24052, "verse_number": "४-१-२८", "content_sanskrit": "उद्दंडैश्चापि शेहुंडैरेरंडैर्गुडपुष्पकैः ।\nबकुलैस्तिलकैश्चैव तिलकांकितमस्तकम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004052028, "chapter_id": 24052, "verse_number": "४-१-२९", "content_sanskrit": "अक्षैः प्लक्षैः शल्लकीभिर्देवदारुहरिद्रुमैः ।\nसदाफलसदापुष्प वृक्षवल्लीविराजितम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004052029, "chapter_id": 24052, "verse_number": "४-१-३०", "content_sanskrit": "एलालवंग मरिचकुलुं जनवनावृतम् ।\nजंब्वाम्रातकभल्लातशेलुश्रीपर्णिवर्णितम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004052030, "chapter_id": 24052, "verse_number": "४-१-३१", "content_sanskrit": "शाकशंखवनैरम्यं चदनैरक्तचंदनैः ।\nहरीतकीकर्णिकार धात्रीवनविभूषणम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004052031, "chapter_id": 24052, "verse_number": "४-१-३२", "content_sanskrit": "द्राक्षावल्लीनागवल्लीकणावल्लीशतावृतम् ।\nमल्लिकायूथिकाकुंदम दयंती सुगंधिनम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004052032, "chapter_id": 24052, "verse_number": "४-१-३३", "content_sanskrit": "भ्रमद्भ्रमरमालाभिर्मालतीभिरलंकृतम् ।\nअलिच्छलागतंकृष्णं गोपीरंतुमनेकशः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004052033, "chapter_id": 24052, "verse_number": "४-१-३४", "content_sanskrit": "नानामृगगणाकीर्णं नानापक्षिविनादितम् ।\nनानासरित्सरः स्रोतः पल्वलैः परितो वृतम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004052034, "chapter_id": 24052, "verse_number": "४-१-३५", "content_sanskrit": "तुच्छश्रियः स्वर्गभूमीः परिहायागतैरिव ।\nनानासुरनिकायैश्च विष्वग्भोगेच्छयोषितम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004052035, "chapter_id": 24052, "verse_number": "४-१-३६", "content_sanskrit": "उत्सृजंतमिवार्घ्यं वै पत्रपुष्पैरितस्ततः ।\nकेकिकेकारवैर्दूरात्कुर्वंतं स्वागतं किल ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004052036, "chapter_id": 24052, "verse_number": "४-१-३७", "content_sanskrit": "अथ सूर्यशताभासं नभसि द्योतितांबरम् ।\nनारदं दृष्टवाञ्छैलो दूरात्प्रत्युज्जगाम तम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004052037, "chapter_id": 24052, "verse_number": "४-१-३८", "content_sanskrit": "ब्रह्मसूनुवपुस्तेजो दूरीकृतदरीतमाः ।\nतमागच्छंतमालोक्य मानसं तम उज्जहौ ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004052038, "chapter_id": 24052, "verse_number": "४-१-३९", "content_sanskrit": "ब्रह्मतेजःसमुद्भूत साध्वसः साधुस त्क्रियः ।\nकठिनोपि परित्यज्य धत्ते मृदुलतां किल ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004052039, "chapter_id": 24052, "verse_number": "४-१-४०", "content_sanskrit": "दृष्ट्वा मृदुलतां तस्य द्वैरूप्येपि स नारदः ।\nमुमुदे सुतरां संतः प्रश्रयग्राह्यमानसाः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004052040, "chapter_id": 24052, "verse_number": "४-१-४१", "content_sanskrit": "गृहानायांतमालोक्य गुरुंवाऽगुरुमेव वा ।\nयोऽगुरुर्नम्रतां धत्ते स गुरुर्न गुरुर्गुरुः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004052041, "chapter_id": 24052, "verse_number": "४-१-४२", "content_sanskrit": "तं प्रत्युच्चैः शिराःसोपि विनम्रतरकंधरः ।\nशैलस्त्विलामिलन्मौलिः प्रणनाम महामुनिम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004052042, "chapter_id": 24052, "verse_number": "४-१-४३", "content_sanskrit": "तमुत्थाप्य कराग्राभ्यामाशीर्भिरभिनंद्य च ।\nतदुद्दिष्टासनं भेजे मनसोपि समुच्छ्रितम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004052043, "chapter_id": 24052, "verse_number": "४-१-४४", "content_sanskrit": "स दध्नामधुनाज्येन नीरार्द्राक्षतदूर्व या ।\nतिलैः कुशैः प्रसूनैस्तमष्टांगार्घ्यैरपूजयत् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004052044, "chapter_id": 24052, "verse_number": "४-१-४५", "content_sanskrit": "गृहीतार्घ्यंकिल श्रांतं पादसंवाहनादिभिः ।\nगतश्रममथालोक्य बभाषे ऽवनतो गिरिः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004052045, "chapter_id": 24052, "verse_number": "४-१-४६", "content_sanskrit": "अद्य सद्यः परिहृतं त्वदंघ्रिरजसारजः ।\nत्वदंगसंगिमहसा सहसाऽप्यांतरंतमः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004052046, "chapter_id": 24052, "verse_number": "४-१-४७", "content_sanskrit": "सफलर्धिरहं चाद्य सुदिवाद्यच मे मुने ।\nप्राक्कृतैः सुकृतैरद्य फलितं मे चिरार्जितैः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004052047, "chapter_id": 24052, "verse_number": "४-१-४८", "content_sanskrit": "धराधरत्वं कुलिषुमान्यं मेऽद्य भविष्यति ।\nइति श्रुत्वा तदा किंचिदुच्छुस्य स्थितवान्मुनिः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004052048, "chapter_id": 24052, "verse_number": "४-१-४९", "content_sanskrit": "पुनरूचे कुलिवरः संभ्रमाप न्नमानसः ।\nउच्छ्वासकारणं ब्रह्मन्ब्रूहि सर्वार्थकोविद ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004052049, "chapter_id": 24052, "verse_number": "४-१-५०", "content_sanskrit": "अदृष्टं तव नोदृष्टं यदिष्टंविष्टपत्रये ।\nअनुक्रोशोत्र मयिचेदुच्यतां प्रणतोस्म्यहम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004052050, "chapter_id": 24052, "verse_number": "४-१-५१", "content_sanskrit": "त्वदागमनजानन्दसंदोहैर्मे दुरारवः ।\nअलं न वक्तुमसकृत्तथाप्येकं वदाम्यहम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004052051, "chapter_id": 24052, "verse_number": "४-१-५२", "content_sanskrit": "धराधरणसामर्थ्यं मेर्वादौ पूर्वपूरुषैः ।\nवर्ण्यते समुदायात्तदहमेको दधे धराम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004052052, "chapter_id": 24052, "verse_number": "४-१-५३", "content_sanskrit": "गौरीगुरुत्वाद्धिमवानादिपत्याच्च भूभृताम् ।\nसंबंधित्वात्पशुपतेः स एको मान्यभृत्सताम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004052053, "chapter_id": 24052, "verse_number": "४-१-५४", "content_sanskrit": "नमेरुः स्वर्णपूर्णत्वाद्रत्नसानुतयाथवा ।\nसुरसद्मतयावापि क्वापि मान्यो मतो मम ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004052054, "chapter_id": 24052, "verse_number": "४-१-५५", "content_sanskrit": "परं शतं न किंशैला इलाकलनकेलयः ।\nइह संति सतां मान्या मान्यास्ते तु स्वभूमिषु ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004052055, "chapter_id": 24052, "verse_number": "४-१-५६", "content_sanskrit": "मन्देहदेहसंदेहादुदयैकदयाश्रितः ।\nनिषधो नौषधिधरोऽप्यस्तोप्यस्तमितप्रभः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004052056, "chapter_id": 24052, "verse_number": "४-१-५७", "content_sanskrit": "नीलश्च नीलीनिलयो मन्दरो मन्दलोचनः ।\nसर्पालयः समलयो रायं नावैति रैवतः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004052057, "chapter_id": 24052, "verse_number": "४-१-५८", "content_sanskrit": "हेमकूटत्रिकूटाद्याः कूटोत्तरपदास्तुते ।\nकिष्किंधक्रौंचसह्याद्या भारसह्या न ते भुवः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004052058, "chapter_id": 24052, "verse_number": "४-१-५९", "content_sanskrit": "इति विंध्यवचः श्रुत्वा नारदोऽचिन्तयद्धृदि ।\nअखर्वगर्वसंसर्गो न महत्त्वाय कल्पते ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004052059, "chapter_id": 24052, "verse_number": "४-१-६०", "content_sanskrit": "श्रीशैलमुख्याः किंशैलानेह संत्यमलश्रियः ।\nयेषां शिखरमात्रादि दर्शनं मुक्तये सताम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004052060, "chapter_id": 24052, "verse_number": "४-१-६१", "content_sanskrit": "अद्यास्य बलमालोक्यमिति ध्यात्वाब्रवीन्मुनिः ।\nसत्यमुक्तं हि भवता गि रिसारंविवृण्वता ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004052061, "chapter_id": 24052, "verse_number": "४-१-६२", "content_sanskrit": "परं शैलेषु शैलेंद्रो मेरुस्त्वामवमन्यते ।\nमया निःश्वसितं चैतत्त्वयि चापि निवेदितम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004052062, "chapter_id": 24052, "verse_number": "४-१-६३", "content_sanskrit": "अथवा मद्विधानां हि केयं चिंता महात्मनाम् ।\nस्वस्त्यस्तु तुभ्यमित्युक्त्वा ययौ स व्योमवर्त्मनि ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004052063, "chapter_id": 24052, "verse_number": "४-१-६४", "content_sanskrit": "गते मुनौ निनिंदस्वमतीवोद्विग्नमानसः ।\nचिन्तामवाप महतीं विंध्यो र्वंध्यमनोरथः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004052064, "chapter_id": 24052, "verse_number": "४-१-६५", "content_sanskrit": "विंध्य उवाच ।\nधिग्जीवितंशास्त्रकलोज्झितस्य धिग्जीवितं चोद्यमवर्जितस्य ।\nधिग्जीवितं ज्ञातिपराजितस्य धिग्जीवितं व्यथर्मनोरथस्य ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004052065, "chapter_id": 24052, "verse_number": "४-१-६६", "content_sanskrit": "कथं भुनक्ति स दिवा कथं रात्रौ स्वपित्यहो ।\nरहः शर्म कथं तस्य यस्याभिभवनं रिपोः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004052066, "chapter_id": 24052, "verse_number": "४-१-६७", "content_sanskrit": "अहोदवाग्निदवथुस्तथामां न स बाधते ।\nबाधते तु यथा चित्ते चिन्तासंतापसंततिः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004052067, "chapter_id": 24052, "verse_number": "४-१-६८", "content_sanskrit": "युक्तमुक्तं पुराविद्भिश्चिन्तामूर्तिः सुदारुणा ।\nन भेषजैर्लंघनैर्वा न चान्यैरुपशाम्यति ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004052068, "chapter_id": 24052, "verse_number": "४-१-६९", "content_sanskrit": "चिन्ताज्वरो मनुष्याणां क्षुधांनिद्रांबलं हरेत् ।\nरूपमुत्साहबुद्धिं श्री जीवितं च न संशयः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004052069, "chapter_id": 24052, "verse_number": "४-१-७०", "content_sanskrit": "ज्वरो व्यतीते षडहे जीर्णज्वर इहोच्यते ।\nअसौ चिन्ताज्वरस्तीव्रः प्रत्यहं नवतां व्रजेत् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004052070, "chapter_id": 24052, "verse_number": "४-१-७१", "content_sanskrit": "धन्यो धन्वतरिर्नात्र चरकश्चरतीह न ।\nनासत्यावपिनाऽ सत्यावत्र चिन्ताज्वरे किल ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004052071, "chapter_id": 24052, "verse_number": "४-१-७२", "content_sanskrit": "किं करोमि क्व गच्छामि कथं मेरुं जयाम्यहम् ।\nउत्प्लुत्य तस्य शिरसि पतामि न पताम्यतः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004052072, "chapter_id": 24052, "verse_number": "४-१-७३", "content_sanskrit": "शक्रं कोपयता पूर्वमस्मद्गोत्रेण केनचित् ।\nपक्षहीनः कृतो यत्र धिगपक्षस्यचेष्टितम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004052073, "chapter_id": 24052, "verse_number": "४-१-७४", "content_sanskrit": "अथवा स कथं मेरुस्तथोच्चैः स्पर्द्धते मया ।\nभूमेर्भारभृतःप्रायो भवंति भ्रांति भूमयः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004052074, "chapter_id": 24052, "verse_number": "४-१-७५", "content_sanskrit": "अलीकवाक्त्वमथवा संभाव्यं नारदे कथम् ।\nब्रह्मचारिणि वेदज्ञे सत्यलोकनिवासिनि ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004052075, "chapter_id": 24052, "verse_number": "४-१-७६", "content_sanskrit": "युक्तायुक्तविचारोथ मादृशेनोपयुज्यते ।\nपराक्रमेष्वशक्तानां विचारं गाहते मनः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004052076, "chapter_id": 24052, "verse_number": "४-१-७७", "content_sanskrit": "अथवा चिन्तनैरेतैः किंव्यर्थैर्विश्वकारकम् ।\nविश्वेशं शरणं यायां समे बुद्धिं प्रदास्यति ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004052077, "chapter_id": 24052, "verse_number": "४-१-७८", "content_sanskrit": "अनाथनाथः सर्वेषां विश्वनाथो हि गीयते ।\nक्षणं मनसि संचित्य भवेदित्थमसंशयम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004052078, "chapter_id": 24052, "verse_number": "४-१-७९", "content_sanskrit": "एतदेव करिष्यामि नेष्टं कालविलंबनम् ।\nविचक्षणैरुपेक्ष्यौ न वर्द्धमानौ परामयौ ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004052079, "chapter_id": 24052, "verse_number": "४-१-८०", "content_sanskrit": "मेरुं प्रदक्षिणीकुर्यान्नित्यमेव दिवाकरः ।\nसग्रहर्क्षगणो नूनं मन्यमानो बलाधिकम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004052080, "chapter_id": 24052, "verse_number": "४-१-८१", "content_sanskrit": "इति निश्चित्य विन्ध्याद्रिर्ववृधे स मृधेक्षणः ।\nअनंतगगनस्यांतं कुर्वद्भिः शिखरैरिव ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004052081, "chapter_id": 24052, "verse_number": "४-१-८२", "content_sanskrit": "कैश्चित्सार्द्धं विरोधो न कर्तव्यः केनचित्क्वचित् ।\nकर्तव्यश्चेत्प्रयत्नेन यथा नोपहसेज्जनः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004052082, "chapter_id": 24052, "verse_number": "४-१-८३", "content_sanskrit": "निरुध्य ब्राध्नमध्वानं कृतकृत्य इवाद्रिराट् ।\nस्वस्थोऽभवद्भवाधीना प्राणिनां हि भविष्यता ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004052083, "chapter_id": 24052, "verse_number": "४-१-८४", "content_sanskrit": "यमद्ययमकर्तासौ दक्षिणं प्रक्रमिष्यति ।\nसकुलीनः स च श्रीमान्समहान्महितः स च ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004052084, "chapter_id": 24052, "verse_number": "४-१-८५", "content_sanskrit": "यावत्स्वश क्तिं शक्तोपि न दर्शयति कर्हिचित् ।\nतावत्स लंघ्यः सर्वेषां ज्वलनो दारुगो यथा ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}]