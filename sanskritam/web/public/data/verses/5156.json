[{"id": 2195433, "chapter_id": 5156, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2195434, "chapter_id": 5156, "verse_number": "१", "content_sanskrit": "आनृशंसस्य धर्मस्य गुणान् भक्तजनस्य च ।\nश्रोतुमिच्छामि कार्त्स्न्येन तन्मे ब्रूहि पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2195435, "chapter_id": 5156, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2195436, "chapter_id": 5156, "verse_number": "२", "content_sanskrit": "विषये काशिराजस्य ग्रामान्निष्क्रम्य लुब्धकः ।\nसविषं काण्डमादाय मृगयामास वै मृगम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2195437, "chapter_id": 5156, "verse_number": "३", "content_sanskrit": "तत्र चामिषलुब्धेन लुब्धकेन महावने ।\nअविदूरे मृगं दृष्ट्वा बाणः प्रतिसमाहितः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2195438, "chapter_id": 5156, "verse_number": "४", "content_sanskrit": "तेन दुर्वारितास्त्रेण निमित्तचपलेषुणा ।\nमहावनतरुर्विद्धो मृगं तत्र जिघांसता\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2195439, "chapter_id": 5156, "verse_number": "५", "content_sanskrit": "स तीक्ष्णविषदिग्धेन शरेणातिबलात्कृतः ।\nउत्सृज्य फलपत्राणि पादपः शोषमागतः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2195440, "chapter_id": 5156, "verse_number": "६", "content_sanskrit": "तस्मिन् वृक्षे तथाभूते कोटरेषु चिरोषितः ।\nन जहाति शुको वासं तस्य भक्त्या वनस्पतेः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2195441, "chapter_id": 5156, "verse_number": "७", "content_sanskrit": "निष्प्रचारो निराहारो ग्लानः शिथिलवागपि ।\nकृतज्ञः सह वृक्षेण धर्मात्मा स व्यशुष्यत\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2195442, "chapter_id": 5156, "verse_number": "८", "content_sanskrit": "तमुदारं महासत्त्वमतिमानुषचेष्टितम् ।\nसमदुःखसुखं ज्ञात्वा विस्मितः पाकशासनः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2195443, "chapter_id": 5156, "verse_number": "९", "content_sanskrit": "ततश्चिन्तामुपगतः शक्रः कथमयं द्विजः ।\nतिर्यग्योनावसम्भाव्यमानृशंस्यं समास्थितः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2195444, "chapter_id": 5156, "verse_number": "१०", "content_sanskrit": "अथ वा नात्र चित्रं हीत्यभवद् वासवस्य तु ।\nप्राणिनामपि सर्वेषां सर्वं सर्वत्र दृश्यते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2195445, "chapter_id": 5156, "verse_number": "११", "content_sanskrit": "ततो ब्राह्मणवेषेण मानुषं रूपमास्थितः ।\nअवतीर्य महीं शक्रस्तं पक्षिणमुवाच ह\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2195446, "chapter_id": 5156, "verse_number": "१२", "content_sanskrit": "शुक भोः पक्षिणांश्रेष्ठ दाक्षेयी सुप्रजास्त्वया ।\nपृच्छे त्वा शुष्कमेतं वै कस्मान्न त्यजसि द्रुमम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2195447, "chapter_id": 5156, "verse_number": "१३", "content_sanskrit": "अथ पृष्टः शुकः प्राह मूर्ध्ना समभिवाद्य तम् ।\nस्वागतं देवराजाय विज्ञातस्तपसा मया\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2195448, "chapter_id": 5156, "verse_number": "१४", "content_sanskrit": "ततो दशशताक्षेण साधु साध्विति भाषितम् ।\nअहो विज्ञानमित्येवं तपसा पूजितस्ततः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2195449, "chapter_id": 5156, "verse_number": "१५", "content_sanskrit": "तमेवं शुभकर्माणं शुकं परमधार्मिकम् ।\nविजानन्नपि तां प्राप्तिं पप्रच्छ बलसूदनः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2195450, "chapter_id": 5156, "verse_number": "१६", "content_sanskrit": "निष्पत्रमफलं शुष्कमशरण्यं पतत्रिणाम् ।\nकिमर्थं सेवसे वृक्षं यदा महदिदं वनम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2195451, "chapter_id": 5156, "verse_number": "१७", "content_sanskrit": "अन्येऽपि बहवो वृक्षाः पत्रसञ्छन्नकोटराः ।\nशुभाः पर्याप्तसञ्चारा विद्यन्तेऽस्मिन् महावने\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2195452, "chapter_id": 5156, "verse_number": "१८", "content_sanskrit": "गतायुषमसामर्थ्यं क्षीणसारं हतश्रियम् ।\nविमृश्य प्रज्ञया धीर जहीमं ह्यस्थिरं द्रुमम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2195453, "chapter_id": 5156, "verse_number": "१९", "content_sanskrit": "तदुपश्रुत्य धर्मात्मा शुकः शक्रेण भाषितम् ।\nसुदीर्घमभिनिःश्वस्य दीनो वाक्यमुवाच ह\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2195454, "chapter_id": 5156, "verse_number": "२०", "content_sanskrit": "अनतिक्रमणीयानि दैवतानि शचीपते ।\nयत्राभवत् तव प्रश्नस्तन्निबोध सुराधिप\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2195455, "chapter_id": 5156, "verse_number": "२१", "content_sanskrit": "अस्मिन्नहं द्रुमे जातः साधुभिश्च गुणैर्युतः ।\nबालभावे च सङ्गुप्तः शत्रुभिश्च न धर्षितः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2195456, "chapter_id": 5156, "verse_number": "२२", "content_sanskrit": "किमनुक्रोशवैफल्यमुत्पादयसि मेऽनघ ।\nआनृशंस्येऽनुरक्तस्य भक्तस्यानुगतस्य च\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2195457, "chapter_id": 5156, "verse_number": "२३", "content_sanskrit": "अनुक्रोशो हि साधूनां सुमहद्धर्मलक्षणम् ।\nअनुक्रोशश्च साधूनां सदा प्रीतिं प्रयच्छति\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2195458, "chapter_id": 5156, "verse_number": "२४", "content_sanskrit": "त्वमेव दैवतैः सर्वैः पृच्छ्यसे धर्मसंशयान् ।\nअतस्त्वं देव देवानामाधिपत्ये प्रतिष्ठितः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2195459, "chapter_id": 5156, "verse_number": "२५", "content_sanskrit": "नार्हसि त्वं सहस्राक्ष त्याजयित्वेह भक्तितः ।\nसमर्थमुपजीव्येमं त्यजेयं कथमद्य वै\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2195460, "chapter_id": 5156, "verse_number": "२६", "content_sanskrit": "तस्य वाक्येन सौम्येन हर्षितः पाकशासनः ।\nशुकं प्रोवाच धर्मात्माऽऽनृशंस्येन तोषितः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2195461, "chapter_id": 5156, "verse_number": "२७", "content_sanskrit": "वरं वृणीष्वेति तदा स च वव्रे वरं शुकः ।\nआनृशंस्यपरो नित्यं तस्य वृक्षस्य सम्भवम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2195462, "chapter_id": 5156, "verse_number": "२८", "content_sanskrit": "विदित्वा च दृढां भक्तिं तां शुके शीलसम्पदम् ।\nप्रीतः क्षिप्रमथो वृक्षममृतेनावसिक्तवान्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2195463, "chapter_id": 5156, "verse_number": "२९", "content_sanskrit": "ततः फलानि पत्राणि शाखाश्चापि मनोरमाः ।\nशुकस्य दृढभक्तित्वाच्छ्रीमत्त्वं चाप स द्रुमः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2195464, "chapter_id": 5156, "verse_number": "३०", "content_sanskrit": "शुकश्च कर्मणा तेन आनृशंस्यकृतेन ह ।\nआयुषोऽन्ते महाराज प्राप शक्रसलोकताम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2195465, "chapter_id": 5156, "verse_number": "३१", "content_sanskrit": "एवमेव मनुष्येन्द्र भक्तिमन्तं समाश्रितः ।\nसर्वार्थसिद्धिं लभते शुकं प्राप्य यथा द्रुमः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2195466, "chapter_id": 5156, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामनुशासनपर्वणि दानधर्मे शुकवासवसंवादे आनृशंस्यशिक्षणकथनं नाम सप्तमोऽध्यायः ॥७॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]