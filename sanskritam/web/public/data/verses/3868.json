[{"id": 2132919, "chapter_id": 3868, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2132920, "chapter_id": 3868, "verse_number": "१", "content_sanskrit": "युधिष्ठिरो धर्मराजः पप्रच्छ भरतर्षभ ।\nमार्कण्डेयं तपोवृद्धं दीर्घायुषमकल्मषम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2132921, "chapter_id": 3868, "verse_number": "२", "content_sanskrit": "विदितास्तव धर्मज्ञ देवदानवराक्षसाः ।\nराजवंशाश्च विविधा ऋषिवंशाश्च शाश्वताः ।\nन तेऽस्त्यविदितं किञ्चिद् अस्मिँल्लोके द्विजर्षभ\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2132922, "chapter_id": 3868, "verse_number": "३", "content_sanskrit": "कथं वेत्सि मुने वंशान् मनुष्योरगरक्षसाम् ।\nसुपर्णकिन्नराणां च यक्षाणां च महौजसाम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2132923, "chapter_id": 3868, "verse_number": "४", "content_sanskrit": "एतदिच्छामि भगवन् तत्त्वेन कथितं द्विज\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2132924, "chapter_id": 3868, "verse_number": "५", "content_sanskrit": "कुवलाश्व इति ख्यात इक्ष्वाकुरपराजितः ।\nकथं नामविपर्यासाद् धुन्धुमारत्वमागतः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2132925, "chapter_id": 3868, "verse_number": "६", "content_sanskrit": "एतदिच्छामि तत्त्वेन ज्ञातुं भार्गवसत्तम ।\nविपर्यस्तं यथा नाम कुवलाश्वस्य धीमतः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2132926, "chapter_id": 3868, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2132927, "chapter_id": 3868, "verse_number": "७", "content_sanskrit": "हन्त ते कथयिष्यामि शृणु राजन् युधिष्ठिर ।\nधर्मिष्ठमिदमाख्यानं धुन्धुमारस्य तच्छृणु\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2132928, "chapter_id": 3868, "verse_number": "८", "content_sanskrit": "यथा स राजा एक्ष्वाकः कुवलाश्वो महीपतिः ।\nधुन्धुमारत्वमगमत् तच्छृणुष्व महीपते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2132929, "chapter_id": 3868, "verse_number": "९", "content_sanskrit": "महर्षिर्विश्रुतस्तात उदङ्क इति भारत ।\nमरुधन्वसु रम्येषु आश्रमस्तस्य कौरव\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2132930, "chapter_id": 3868, "verse_number": "१०", "content_sanskrit": "उदङ्कस्तु महातेजाः तपोऽतप्यत् सुदुश्चरम् ।\nआरिराधयिषुर्विष्णुं बहून् वर्षगणान् विभो\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2132931, "chapter_id": 3868, "verse_number": "११", "content_sanskrit": "तस्य प्रीतः स भगवान् साक्षाद् दर्शनमेयिवान् ।\nदृष्ट्वा महर्षिर्विष्णुं तु तुष्टाव विविधैः स्तवैः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2132932, "chapter_id": 3868, "verse_number": "१२", "content_sanskrit": "त्वया देव प्रजाः सर्वाः ससुरासुरमानवाः ।\nस्थावराणि च भूतानि जङ्गमानि च सर्वशः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2132933, "chapter_id": 3868, "verse_number": "१३", "content_sanskrit": "ब्रह्म वेदाश्च वेद्यं च त्वया सृष्टं महाद्युते ।\nशिरस्ते गगनं देव नेत्रे शशिदिवाकरौ\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2132934, "chapter_id": 3868, "verse_number": "१४", "content_sanskrit": "निःश्वासः पवनश्चापि तेजोऽग्निश्च तवाच्युत ।\nबाहवस्ते दिशः सर्वाः कुक्षिश्चापि महार्णवः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2132935, "chapter_id": 3868, "verse_number": "१५", "content_sanskrit": "ऊरू ते पर्वता देव खं नाभिर्मधुसूदन ।\nपादौ ते पृथिवी चैव रोमाण्योषधयस्तव\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2132936, "chapter_id": 3868, "verse_number": "१६", "content_sanskrit": "इन्द्रसोमाग्निवरुणा देवासुरमहोरगाः ।\nप्रह्वास्त्वामुपतिष्ठन्ति स्तुवन्तो विविधैः स्तवैः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2132937, "chapter_id": 3868, "verse_number": "१७", "content_sanskrit": "त्वया व्याप्तानि सर्वाणि भूतानि भुवनेश्वर ।\nयोगिनः सुमहावीर्याः स्तुवन्ति त्वां महर्षयः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2132938, "chapter_id": 3868, "verse_number": "१८", "content_sanskrit": "त्वयि तुष्टे जगच्छान्तं त्वयि क्रुद्धे महद्भयम् ।\nभयानामपनेताऽसि त्वमेकः पुरुषोत्तम\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2132939, "chapter_id": 3868, "verse_number": "१९", "content_sanskrit": "देवानां मानुषाणां च सर्वभूतसुखावहः ।\nत्रिभिर्विक्रमणैर्देव त्रयो लोकास्त्वया वृताः ।\nअसुराणां समृद्धानां विनाशश्च त्वया कृतः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2132940, "chapter_id": 3868, "verse_number": "२०", "content_sanskrit": "तव विक्रमणैर्देवा निर्वाणमगमन् परम् ।\nपराभवं च दैत्येन्द्राः त्वयि क्रुद्धे महाद्युते\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2132941, "chapter_id": 3868, "verse_number": "२१", "content_sanskrit": "त्वं हि कर्ता विकर्ता च भूतानामिह सर्वशः ।\nआराधयित्वा त्वां देवाः सुखमेधन्ति नित्यशः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2132942, "chapter_id": 3868, "verse_number": "२२", "content_sanskrit": "एवं स्तुतो हृषीकेश उदङ्केन महात्मना ।\nउदङ्कमब्रवीद् विष्णुः प्रीतस्तेऽहं वरं वृणु\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2132943, "chapter_id": 3868, "verse_number": "", "content_sanskrit": "उदङ्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2132944, "chapter_id": 3868, "verse_number": "२३", "content_sanskrit": "पर्याप्तो मे वरो ह्येष यदहं दृष्टवान् हरिम् ।\nपुरुषं शाश्वतं दिव्यं स्रष्टारं जगतः प्रभुम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2132945, "chapter_id": 3868, "verse_number": "२४", "content_sanskrit": "प्रीतस्तेऽहमलौल्येन भक्त्या च द्विजसत्तम ।\nअवश्यं हि त्वया विद्वन् मत्तो ग्राह्यो वरो द्विज\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2132946, "chapter_id": 3868, "verse_number": "२५", "content_sanskrit": "एवं सञ्चोद्यमानस्तु वरेण हरिणा तदा ।\nउदङ्कः प्राञ्जलिर्वव्रे वरं भरतसत्तम\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2132947, "chapter_id": 3868, "verse_number": "", "content_sanskrit": "उदङ्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2132948, "chapter_id": 3868, "verse_number": "२६", "content_sanskrit": "यदि मे भगवान् प्रीतः पुण्डरीकनिभेक्षण ।\nधर्मे सत्ये दमे चैव बुद्धिर्भवतु मे सदा\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2132949, "chapter_id": 3868, "verse_number": "२७", "content_sanskrit": "अभ्यासश्च भवेद् भक्त्या त्वयि नित्यं महेश्वर\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2132950, "chapter_id": 3868, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2132951, "chapter_id": 3868, "verse_number": "२८", "content_sanskrit": "सर्वमेतद्धि भविता मत्प्रसादात् तव द्विज ।\nप्रतिभास्यति योगश्च येन युक्तो दिवौकसाम् ।\nत्रयाणामपि लोकानां महत् कार्यं करिष्यसि\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2132952, "chapter_id": 3868, "verse_number": "२९", "content_sanskrit": "उत्सादनार्थं लोकानां धुन्धुर्नाम महासुरः ।\nतपस्यति तपो घोरं शृणु यस्तं हनिष्यति\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2132953, "chapter_id": 3868, "verse_number": "३०", "content_sanskrit": "बृहदश्व इति ख्यातो भविष्यति महीपतिः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2132954, "chapter_id": 3868, "verse_number": "३१", "content_sanskrit": "तस्य पुत्रः शुचिर्दान्तः कुवलाश्व इति श्रुतः ।\nस योगबलमास्थाय मामकं पार्थिवोत्तमः ।\nशासनात् तव विप्रर्षे धुन्धुमारो भविष्यति\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2132955, "chapter_id": 3868, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2132956, "chapter_id": 3868, "verse_number": "३२", "content_sanskrit": "उदङ्कमेवमुक्त्वा तु विष्णुरन्तरधीयत\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2132957, "chapter_id": 3868, "verse_number": "३३", "content_sanskrit": "इक्ष्वाकौ संस्थिते राजन् शशादः पृथिवीमिमाम् ।\nप्राप्तः परमधर्मात्मा सोऽयोध्यायां नृपोऽभवत्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2132958, "chapter_id": 3868, "verse_number": "३४", "content_sanskrit": "शशादस्य तु दायादः ककुत्स्थ नाम वीर्यवान् ।\nअनेनाश्चापि काकुत्स्थः पृथुश्चानेनसः सुतः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2132959, "chapter_id": 3868, "verse_number": "३५", "content_sanskrit": "विष्वगश्वः पृथोः पुत्रः तस्मादार्द्रस्तु जज्ञिवान् ।\nआर्द्राद् युवनाश्वस्तु श्राव(स्त?)स्तस्य चात्मजः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2132960, "chapter_id": 3868, "verse_number": "३६", "content_sanskrit": "जज्ञे श्राव्यस्ततो राजा श्रावस्ती येन निर्मिता ।\nश्राव्यस्तस्य तु दायादो बृहदश्वो महाबलः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2132961, "chapter_id": 3868, "verse_number": "३७", "content_sanskrit": "बृहदश्वसुतश्चापि कुवलाश्व इति स्मृतः ।\nकुवलाश्वस्य पुत्राणां साहस्राण्येकविंशतिः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2132962, "chapter_id": 3868, "verse_number": "३८", "content_sanskrit": "सर्वे विद्यासु निष्णाता बलवन्तो दुरासदाः ।\nकुवलाश्वश्च पितृतो गुणैरभ्यधिकोऽभवत्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2132963, "chapter_id": 3868, "verse_number": "३९", "content_sanskrit": "समये तं ततो राज्ये बृहदश्वोऽभ्यषेचयत् ।\nकुवलाश्वं महाराज शूरमुत्तमधार्मिकम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2132964, "chapter_id": 3868, "verse_number": "४०", "content_sanskrit": "पुत्रसङ्क्रामितश्रीस्तु बृहदश्वो महीपतिः ।\nजगाम तपसे धीमान् तपोवनममित्रहा\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2132965, "chapter_id": 3868, "verse_number": "४१", "content_sanskrit": "अथ शुश्राव राजर्षिं तमुदङ्को युधिष्ठिर ।\nवनं सम्प्रस्थितं राजन् बृहदश्वं द्विजोत्तमः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2132966, "chapter_id": 3868, "verse_number": "४२", "content_sanskrit": "तमुदङ्को महातेजाः सर्वास्त्रविदुषां वरम् ।\nन्यवारयदमेयात्मा समासाद्य पुरोत्तमे\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2132967, "chapter_id": 3868, "verse_number": "", "content_sanskrit": "उदङ्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2132968, "chapter_id": 3868, "verse_number": "४३", "content_sanskrit": "भवता रक्षणं कार्यं तत् तावत् कर्तुमर्हसि ।\nनिरुद्विग्ना वयं राजन् त्वत्प्रसादाद् वसेमहि\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2132969, "chapter_id": 3868, "verse_number": "४४", "content_sanskrit": "त्वया हि पृथिवी राजन् रक्ष्यमाणा महात्मना ।\nभविष्यति निरुद्विग्ना नारण्यं गन्तुमर्हसि\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2132970, "chapter_id": 3868, "verse_number": "४५", "content_sanskrit": "पालने हि महान् धर्मः प्रजानामिह दृश्यते ।\nन तथा दृश्यतेऽरण्ये मा भूत् ते बुद्धिरीदृशी\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2132971, "chapter_id": 3868, "verse_number": "४६", "content_sanskrit": "ईदृशो न च राजेन्द्र धर्मः क्वचन दृश्यते ।\nप्रजानां पालने यो वै पुरा राजर्षिभिः कृतः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2132972, "chapter_id": 3868, "verse_number": "४७", "content_sanskrit": "रक्षितव्याः प्रजा राज्ञा तास्त्वं रक्षितुमर्हसि ।\nनिरुद्विग्नस्तपस्तप्तुं न हि शक्नोमि पार्थिव\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2132973, "chapter_id": 3868, "verse_number": "४८", "content_sanskrit": "ममाश्रमसमीपे हि समेषु मरुधन्वसु ।\nसमुद्रवालुकापूर्ण उज्जानक इति स्मृतः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2132974, "chapter_id": 3868, "verse_number": "४९", "content_sanskrit": "बहुयोजनविस्तीर्णो बहुयोजनमायतः ।\nतत्र रौद्रो दानवेन्द्रो महावीर्यपराक्रमः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2132975, "chapter_id": 3868, "verse_number": "५०", "content_sanskrit": "मधुकैटभयोः पुत्रो धुन्धुर्नाम महासुरः ।\nअन्तर्भूमिगतो राजन् वसत्यमितविक्रमः ।\nतं निहत्य महाराज वनं त्वं गन्तुमर्हसि\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2132976, "chapter_id": 3868, "verse_number": "५१", "content_sanskrit": "शेते स लोकनाशाय तप आस्थाय दारुणम् ।\nत्रिदशानां विनाशाय लोकानां चापि पार्थिव\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2132977, "chapter_id": 3868, "verse_number": "५२", "content_sanskrit": "अवध्यो दैवतानां हि दैत्यानामथ रक्षसाम् ।\nनागानामथ यक्षाणां गन्धर्वाणां च सर्वशः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2132978, "chapter_id": 3868, "verse_number": "५३", "content_sanskrit": "अवाप्य स वरं राजन् सर्वलोकपितामहात्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2132979, "chapter_id": 3868, "verse_number": "५४", "content_sanskrit": "तं विनाशय भद्रं ते मा ते बुद्धिरतोऽन्यथा ।\nप्राप्स्यसे महतीं कीर्तिं शाश्वतीमव्ययां ध्रुवाम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2132980, "chapter_id": 3868, "verse_number": "५५", "content_sanskrit": "क्रूरस्य स्वपतस्तस्य वालुकान्तर्हितस्य वै ।\nसंवत्सरस्य पर्यन्ते निःश्वासः सम्प्रवर्तते\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2132981, "chapter_id": 3868, "verse_number": "५६", "content_sanskrit": "यदा तदा भूश्चलति सशैलवनकानना ।\nतस्य निःश्वासवातेन रज उद्धूयते महत्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2132982, "chapter_id": 3868, "verse_number": "५७", "content_sanskrit": "आदित्यपथमाश्रित्य सप्ताहं भूमिकम्पनम् ।\nसविस्फुलिङ्गं सज्वालं सधूमं ह्यग्निदारुणम् ।\nन तेन राजन् शक्नोमि तस्मिन् स्थातुं स्वाश्रमे\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2132983, "chapter_id": 3868, "verse_number": "५८", "content_sanskrit": "तं विनाशय राजेन्द्र लोकानां हितकाम्यया ।\nलोकाः स्वस्था भवन्त्वद्य तस्मिन् विनिहते युधि\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2132984, "chapter_id": 3868, "verse_number": "५९", "content_sanskrit": "धुन्धुनामानमत्युग्रं दानवं घोरविग्रहम् ।\nसमरे घोरतुमुले विनाशाय महेषुणा\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2132985, "chapter_id": 3868, "verse_number": "६०", "content_sanskrit": "त्वं हि तस्य विनाशाय पर्याप्त इति मे मतिः ।\nतेजसा तव तेजश्च विष्णुराप्याययिष्यति\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2132986, "chapter_id": 3868, "verse_number": "६१", "content_sanskrit": "विष्णुना च वरो दत्तो मम पूर्वं तु तद्वधे\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2132987, "chapter_id": 3868, "verse_number": "६२", "content_sanskrit": "यस्तं महासुरं रौद्रं वधिष्यति महीपतिः ।\nतेजस्तद्वैष्णवमिति प्रवेक्ष्यति दुरासदम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2132988, "chapter_id": 3868, "verse_number": "६३", "content_sanskrit": "तत् तेजस्त्वं समाधाय राजेन्द्र भव दुःसहः ।\nतं निषूदय सन्दिष्टो दैत्यं रौद्रप्रराक्रमम्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2132989, "chapter_id": 3868, "verse_number": "६४", "content_sanskrit": "न हि धुन्धुर्महातेजाः तेजसाऽल्पेन शक्यते ।\nनिर्दग्धुं पृथिवीपाल स हि वर्षशतैरपि\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2132990, "chapter_id": 3868, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nवनपर्वणि एकोननवत्यधिकशततमोऽध्यायः ॥१८९॥\n॥ इति मार्कण्डेयसमास्यापर्वणि चतुर्दशोऽध्यायः ॥१४॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]