[{"id": 2027112, "chapter_id": 1581, "verse_number": "३-२१९-०x", "content_sanskrit": "व्याध उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2027113, "chapter_id": 1581, "verse_number": "३-२१९-१", "content_sanskrit": "एवं शप्तोऽहमृषिणा तदा द्विजबरोत्तम।\nअहं प्रासादयमृषिं गिरा वाक्यविशारदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2027114, "chapter_id": 1581, "verse_number": "३-२१९-२", "content_sanskrit": "अजानता मयाऽकार्यमिदमद्य कृतं मुने।\nक्षन्तुमर्हसि तत्सर्वं प्रसीद भगवन्निति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2027115, "chapter_id": 1581, "verse_number": "३-२१९-३x", "content_sanskrit": "ऋषिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2027116, "chapter_id": 1581, "verse_number": "३-२१९-३", "content_sanskrit": "नान्यथा भविता शाप एवमेतदसंशयम्।\nआनृशंस्यात्त्वंहकिंचित्कर्ताऽनुग्रहमद्य ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2027117, "chapter_id": 1581, "verse_number": "३-२१९-४", "content_sanskrit": "शूद्रयोन्यां वर्तमानो धर्मज्ञो हि भविष्यसि।\nमातापित्रोश् शुश्रूषां करिष्यसि न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2027118, "chapter_id": 1581, "verse_number": "३-२१९-५", "content_sanskrit": "तयोः शुश्रूषया सिद्धिं महतीं समवाप्स्यसि।\nजातिस्मरश् भविता स्वर्गं चैव गमिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2027119, "chapter_id": 1581, "verse_number": "३-२१९-६", "content_sanskrit": "`भूत्वाच धार्मिको व्याधः पित्रोः शुश्रूषणे रतः।\nशापक्षये तु निर्वृत्ते भविताऽसि पुनर्द्विजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2027120, "chapter_id": 1581, "verse_number": "३-२१९-७", "content_sanskrit": "एवं शप्तः पुरा तेन ऋषिणाऽस्म्युग्रतेजसा।\nप्रसादश्च कृतस्तेन ममैव द्विपदांवर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2027121, "chapter_id": 1581, "verse_number": "३-२१९-८", "content_sanskrit": "शरं चोद्धृतवानस्मि तस्य वै द्विजसत्तम।\nआश्रमं च मया नीतो न च प्राणैर्व्ययुज्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2027122, "chapter_id": 1581, "verse_number": "३-२१९-९", "content_sanskrit": "एतत्ते सर्वमाख्यातं यथा मम पुराऽभवत्।\nअभितश्चापि गन्तव्यो मया स्वर्गो द्विजोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2027123, "chapter_id": 1581, "verse_number": "३-२१९-१०x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2027124, "chapter_id": 1581, "verse_number": "३-२१९-१०", "content_sanskrit": "एवमेतानि पुरुषा दुःखानि च सुखानि च।\nआप्नुवन्ति महाबुद्धे नोत्कण्ठां कर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2027125, "chapter_id": 1581, "verse_number": "३-२१९-११", "content_sanskrit": "दुष्करं हि कृतंकर्म जानता जातिमात्मनः।\n[लोकवृत्तान्ततत्त्वज्ञ नित्यं धर्मपरायण ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2027126, "chapter_id": 1581, "verse_number": "३-२१९-१२", "content_sanskrit": "कर्मदोषाच्च वै विद्वन्नात्मजातिकृतेन वै।\nकंचित्कालं मृष्यतां वै ततोसि भविता द्विजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2027127, "chapter_id": 1581, "verse_number": "३-२१९-१३", "content_sanskrit": "सांप्रतं च मतो मेऽसि ब्राह्मणो नात्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2027128, "chapter_id": 1581, "verse_number": "३-२१९-१४", "content_sanskrit": "ब्राह्मणः पतनीयेषु वर्तमानो विकर्मसु।\nदाम्भिक्वो दुष्कृतप्रायः शूद्रेण सदृशो भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2027129, "chapter_id": 1581, "verse_number": "३-२१९-१५", "content_sanskrit": "यस्तु शूद्रो दमे सत्ये धर्मे च सततोत्थितः।\nतं ब्राह्मणमहं मन्ये वृत्तेन हि भवेद्द्विजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2027130, "chapter_id": 1581, "verse_number": "३-२१९-१६", "content_sanskrit": "कर्मदोषेण विषमां गतिमाप्तोसि दारुणाम्।\nक्षीणदोषमहं मन्ये चाभितस्त्वां नरोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2027131, "chapter_id": 1581, "verse_number": "३-२१९-१७", "content_sanskrit": "कर्तुमर्हसि नोत्कण्ठां त्वद्विधा ह्यविषादिनः।\nलोकवृत्तान्ततत्वज्ञा नित्यं धर्मपरायणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2027132, "chapter_id": 1581, "verse_number": "३-२१९-१८x", "content_sanskrit": "व्याध उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2027133, "chapter_id": 1581, "verse_number": "३-२१९-१८", "content_sanskrit": "प्रज्ञया मानसं दुःखं हन्याच्छारीरमौषधैः।\nएतद्विज्ञानसामर्थ्यं न बालै समतामियात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2027134, "chapter_id": 1581, "verse_number": "३-२१९-१९", "content_sanskrit": "अनिष्टसंप्रयोगाच्च विप्रयोगात्प्रयिस्य च।\nमनुष्या मानसैर्दुःखैर्युज्यन्ते चाल्पबुद्धयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2027135, "chapter_id": 1581, "verse_number": "३-२१९-२०", "content_sanskrit": "गुणैर्भूतानि युज्यन्ते वियुज्यन्ते तथैव च।\nसर्वाणि नैतदेकस्य शोकस्थानं हि विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2027136, "chapter_id": 1581, "verse_number": "३-२१९-२१", "content_sanskrit": "अनिष्टनान्वितं पश्यंस्तथा क्षिप्रं विरज्यते।\nततश्च प्रतिकुर्वन्ति यदि पश्यन्त्युपक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2027137, "chapter_id": 1581, "verse_number": "३-२१९-२२", "content_sanskrit": "शोचतो न भवेत्किंचित्केवलं परितप्यते।\nपरित्यजन्ति ये दुःखं सुखं वाऽप्युभयं नराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2027138, "chapter_id": 1581, "verse_number": "३-२१९-२३", "content_sanskrit": "त एव सुखमेधन्ते ज्ञानतृप्ता मनीषिणः।\nअसंतोषपरा मूढाः संतोषं यानति पण्डिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2027139, "chapter_id": 1581, "verse_number": "३-२१९-२४", "content_sanskrit": "असंतोषस्य नास्त्यन्तस्तुष्टिस्तु परमं सुखम्।\nन शोचन्ति गताध्वानः पश्यन्तः परमां गतिं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2027140, "chapter_id": 1581, "verse_number": "३-२१९-२५", "content_sanskrit": "न विषादे मनः कार्यं विषादो विषमुत्तमम्।\nमारयत्यकृतप्रज्ञं बालं क्रुद्ध इवोरगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2027141, "chapter_id": 1581, "verse_number": "३-२१९-२६", "content_sanskrit": "यंविषादोऽभिभवति विषमे समुपस्थिते।\nतेजसा तस् हीनस्य पुरुषार्थो न विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2027142, "chapter_id": 1581, "verse_number": "३-२१९-२७", "content_sanskrit": "अवश्यं क्रियमाणस् कर्मणो दृश्यते फलम्।\nन हि निर्वेदमागम्य किंचित्प्राप्नोति शोभनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2027143, "chapter_id": 1581, "verse_number": "३-२१९-२८", "content_sanskrit": "अथाप्युपायं पश्येत दुःखस् परिमोक्षणे।\nअशोचन्नारभेतैव युक्तश्चाव्यसनी भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2027144, "chapter_id": 1581, "verse_number": "३-२१९-२९", "content_sanskrit": "भूतेष्वभावं संचिन्त्य ये तु बुद्धेः परं गताः।\nन शोचन्ति कृतप्रज्ञाः पश्यन्तः परमां गतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2027145, "chapter_id": 1581, "verse_number": "३-२१९-३०", "content_sanskrit": "न शोचामि रमे विद्वन्कालाकाङ्क्षी स्थितोस्म्यहम्।\nएतैर्निदर्शनैर्ब्रह्मन्नावसीदामि सत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2027146, "chapter_id": 1581, "verse_number": "३-२१९-३१x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2027147, "chapter_id": 1581, "verse_number": "३-२१९-३१", "content_sanskrit": "कृतप्रज्ञोसि मेधावी बुद्धिश्च विपुला तव।\nपापान्निवृत्तोसि सदा ज्ञानवृद्धोसि धर्मवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2027148, "chapter_id": 1581, "verse_number": "३-२१९-३२", "content_sanskrit": "आपृच्छे त्वां स्वस्ति तेऽस्तु धर्मस्त्वां परिरक्षतु।\nअप्रमादस्तु कर्तव्यो धर्मे धर्मभृतांवर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2027149, "chapter_id": 1581, "verse_number": "३-२१९-३३x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2027150, "chapter_id": 1581, "verse_number": "३-२१९-३३", "content_sanskrit": "बाढमित्येव तं व्याधः कृताञ्जलिरुवाच ह।\nप्रदक्षिणमथो कृत्वा प्रस्थितो द्विजसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2027151, "chapter_id": 1581, "verse_number": "३-२१९-३४", "content_sanskrit": "स तु गत्वाद्विजः सर्वां शुश्रूषां कृतवांस्तदा।\nमातापितृभ्यामन्धाभ्यां यथान्यायं सुसंशितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2027152, "chapter_id": 1581, "verse_number": "३-२१९-३५", "content_sanskrit": "एतत्ते सर्वमाख्यातं निखिलेन युधिष्ठिर।\nपृष्टवानसि यं तात धर्मं धर्मभृतांवर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2027153, "chapter_id": 1581, "verse_number": "३-२१९-३६", "content_sanskrit": "पतिव्रताया माहात्म्यं ब्राह्मणस्य च सत्तम।\nमातापित्रोश्च शुश्रूषा धर्मव्याधेन कीर्तिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2027154, "chapter_id": 1581, "verse_number": "३-२१९-३७x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2027155, "chapter_id": 1581, "verse_number": "३-२१९-३७", "content_sanskrit": "अत्यद्भुतमिदं ब्रह्मन्धर्माख्यानमनुत्तमम्।\nसर्वधर्मविदांश्रेष्ठ कथितं मुनिसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2027156, "chapter_id": 1581, "verse_number": "३-२१९-३८", "content_sanskrit": "सुखश्राव्यतया विद्वन्मुहूर्त इव मे गतः।\nन हि तृप्तोस्मि भगवञ्शृण्वानो धर्ममुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2027157, "chapter_id": 1581, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि एकोनिविंशत्यधिकद्विशततमोऽध्यायः ॥ २१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]