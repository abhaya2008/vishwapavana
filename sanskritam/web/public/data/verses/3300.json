[{"id": 2106104, "chapter_id": 3300, "verse_number": "१६-२९-१", "content_sanskrit": "वैशम्पायन उवाच।\nततस्तु राजन्नेतेषामाश्रमे पुण्यकर्मणाम्।\nशिवा नक्षत्रसम्पन्ना सा व्यतीयाय शर्वरी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2106105, "chapter_id": 3300, "verse_number": "१६-२९-२", "content_sanskrit": "ततस्तत्र कथाश्चासंस्तेषां धर्मार्थलक्षणाः।\nविचित्रपदसञ्चारा नानाश्रुतिभिरन्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2106106, "chapter_id": 3300, "verse_number": "१६-२९-३", "content_sanskrit": "पाण्डवास्त्वभितो मातुर्धरण्यां सुषुपुस्तदा।\nउत्सृज्य तु महार्हाणि शयनानि नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2106107, "chapter_id": 3300, "verse_number": "१६-२९-४", "content_sanskrit": "यदाहारोऽभकवद्राजा धृतराष्ट्रो महामनाः।\nतदाहारा नृवींरास्ते न्यवसंस्तां निशां तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2106108, "chapter_id": 3300, "verse_number": "१६-२९-५", "content_sanskrit": "व्यतीतायां तु शर्वर्यां कृतपौर्वाह्णिकक्रियः।\nभ्रातृभिः सहितो राजा ददर्शाश्रममण्डलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2106109, "chapter_id": 3300, "verse_number": "१६-२९-६", "content_sanskrit": "सान्तः पुरपरीवारः सभृत्यः सपुरोहितः।\nयथासुखं यथोद्देशं धृतराष्ट्राभ्यनुज्ञया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2106110, "chapter_id": 3300, "verse_number": "१६-२९-७", "content_sanskrit": "ददर्श तत्र वेदीश्च सम्प्रज्वलितपावकाः।\nकृताभिषेकैर्मुनिभिर्हुताग्निभिरुपस्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2106111, "chapter_id": 3300, "verse_number": "१६-२९-८", "content_sanskrit": "वानेयपुष्पनिकरैराज्यधूमोद्गमैरपि।\nब्राह्मेण वपुषा युक्ता युक्ता मुनिगणस्य ताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2106112, "chapter_id": 3300, "verse_number": "१६-२९-९", "content_sanskrit": "मृगयूथैरनुद्विग्नैस्तत्रतत्र समाश्रितैः।\nअशङ्कितैः पक्षिगणैः प्रगीतैरिव च प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2106113, "chapter_id": 3300, "verse_number": "१६-२९-१०", "content_sanskrit": "केकाभिर्नीलकण्ठानां दात्यूहानां च कूजितैः।\nकोकिलानां कुहुरवैः सुखैः श्रुतिमनोहरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2106114, "chapter_id": 3300, "verse_number": "१६-२९-११", "content_sanskrit": "प्राधीतद्विजघोषैश्च क्वचित्क्वचिदलङ्कृतम्।\nफलमूलसमाहारैर्महद्भिश्चोपशोभितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2106115, "chapter_id": 3300, "verse_number": "१६-२९-१२", "content_sanskrit": "ततः स राजा प्रददौ तापसार्थमुपाहृतान्।\nकलशान्काञ्चनान्राजंस्तथैवौदुम्बरानपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2106116, "chapter_id": 3300, "verse_number": "१६-२९-१३", "content_sanskrit": "अजिनानि प्रवेणीश्च स्रुक्स्रुवं च महीपतिः।\nकमण्डलूंश्चि स्थालीश्च पिठराणि च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2106117, "chapter_id": 3300, "verse_number": "१६-२९-१४", "content_sanskrit": "भाजनानि च लौहानि पात्रीश्च विविधा नृप।\nयद्यदिच्छति यावच्च यदन्यदपि काङ्क्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2106118, "chapter_id": 3300, "verse_number": "१६-२९-१५", "content_sanskrit": "एवं स राजा धर्मात्मा परीत्याश्रममण्डलम्।\nवसु विश्राण्य तत्सर्वं पुनरायान्महीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2106119, "chapter_id": 3300, "verse_number": "१६-२९-१६", "content_sanskrit": "कृताह्निकं च राजानं धृतराष्ट्रं महीपतिम्।\nददर्शासीनमव्यग्रं गान्धारीसहितं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2106120, "chapter_id": 3300, "verse_number": "१६-२९-१७", "content_sanskrit": "मातरं चाविदूरस्थां शिष्यवत्प्रणतां स्थिताम्।\nकुन्तीं ददर्श धर्मात्मा शिष्टाचारसमन्विताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2106121, "chapter_id": 3300, "verse_number": "१६-२९-१८", "content_sanskrit": "स तमभ्यर्च्य राजानं नाम संश्राव्य चात्मनः।\nनिषीदेत्यभ्यनुज्ञातो वृस्यामुपविवेश ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2106122, "chapter_id": 3300, "verse_number": "१६-२९-१९", "content_sanskrit": "भीमसेनादयश्चैव पाण्डव भरतर्षभ।\nअभिवाद्योपसङ्गृह्य निषेदुः पार्थिवाज्ञया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2106123, "chapter_id": 3300, "verse_number": "१६-२९-२०", "content_sanskrit": "स तैः परिवृतो राजा शुशुभेऽतीव कौरवः।\nबिभ्रद्ब्राह्मीं श्रियं दीप्तां देवैरिव बृहस्पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2106124, "chapter_id": 3300, "verse_number": "१६-२९-२१", "content_sanskrit": "तथा तेषूपविष्टेषु समाजग्मुर्महर्षयः।\nशतयूपप्रभृतयः कुरुक्षेत्रनिवासिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2106125, "chapter_id": 3300, "verse_number": "१६-२९-२२", "content_sanskrit": "व्यासश्च भगवान्विप्रो देवर्षिगणसेवितः।\nवृतः शिष्यैर्महातेजा दर्शयामास पार्थिवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2106126, "chapter_id": 3300, "verse_number": "१६-२९-२३", "content_sanskrit": "ततः स राजा कौरव्यः कुन्तीपुत्रश्च धर्मराट्।\nभीमसेनादयश्चैव प्रत्युत्थायाभ्यवादयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2106127, "chapter_id": 3300, "verse_number": "१६-२९-२४", "content_sanskrit": "समागतस्ततो व्यासः शतयूपादिभिर्वृतः।\nधृतराष्ट्रं महीपालमास्यतामित्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2106128, "chapter_id": 3300, "verse_number": "१६-२९-२५", "content_sanskrit": "वरं तु विष्टरं कौश्यं कृष्णाजिनकुशोत्तरम्।\nप्रतिपेदे तदा व्यासस्तदर्थमुपकल्पितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2106129, "chapter_id": 3300, "verse_number": "१६-२९-२६", "content_sanskrit": "ते च सर्वे द्विजश्रेष्ठा विष्टरेषु समन्ततः।\nद्वैपायनाभ्यनुज्ञाता निषेदुर्विपुलौजसः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2106130, "chapter_id": 3300, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्रमवासिकपर्वणि आश्रमवासपर्वणि एकोनत्रिंशोऽध्यायः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]