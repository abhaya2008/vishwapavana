[{"id": 2127130, "chapter_id": 3726, "verse_number": "", "content_sanskrit": "दमयन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2127131, "chapter_id": 3726, "verse_number": "१", "content_sanskrit": "गच्छ केशिनि जानीहि क एष रथसारथिः ।\nउपविष्टो रथोपस्थे विकृतो ह्रस्वबाहुकः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2127132, "chapter_id": 3726, "verse_number": "२", "content_sanskrit": "अभ्येत्य कुशलं भद्रे मृदुपूर्वं समाहिता ।\nपृच्छेथाः पुरुषं ह्येनं यथातत्वमनिन्दिते\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2127133, "chapter_id": 3726, "verse_number": "३", "content_sanskrit": "अत्र मे महती शङ्का भवेदेष नळो नृपः ।\nतथा मनसि मे तुष्टिर्हृदयस्य च निर्वृतिः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2127134, "chapter_id": 3726, "verse_number": "४", "content_sanskrit": "ब्रूयाश्चैनं कथान्ते त्वं पर्णादवचनं यथा ।\nप्रतिवाक्यं च सुश्रोणि बुद्ध्येथास्त्वमनिन्दिते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2127135, "chapter_id": 3726, "verse_number": "५", "content_sanskrit": "एवं समाहिता गत्वा दूती वाक्यमथाब्रवीत् ।\nदमयन्त्यपि कल्याणी प्रासादस्थाऽन्ववैक्षत \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2127136, "chapter_id": 3726, "verse_number": "", "content_sanskrit": "केशिनी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2127137, "chapter_id": 3726, "verse_number": "६", "content_sanskrit": "स्वागतं ते मनुष्येन्द्र कुशलं ते ब्रवीम्यहम् ।\nदमयन्त्या वचःसौम्य निबोध भरतर्षभ\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2127138, "chapter_id": 3726, "verse_number": "७", "content_sanskrit": "कदा वै प्रस्थिता यूयं किमर्थमिह चागताः ।\nतत्त्वं ब्रूहि यथान्यायं वैदर्भी श्रोतुमिच्छति\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2127139, "chapter_id": 3726, "verse_number": "", "content_sanskrit": "नळः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2127140, "chapter_id": 3726, "verse_number": "८", "content_sanskrit": "श्रुतः स्वयंवरो राज्ञा कौसलेन यशस्विना ।\nद्वितीयो दमयन्त्या वै श्वोभूत इति भामिनि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2127141, "chapter_id": 3726, "verse_number": "९", "content_sanskrit": "श्रुत्वा तं प्रस्थितो राजा शतयोजनयायिभिः ।\nहयैर्वातजवैर्मुख्यैरहमस्य च सारथिः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2127142, "chapter_id": 3726, "verse_number": "", "content_sanskrit": "केशिनी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2127143, "chapter_id": 3726, "verse_number": "१०", "content_sanskrit": "अथ योऽसौ तृतीयो वः स कुतः कस्य वा पुनः ।\nत्वं च कस्य कुतश्चेदं त्वयि कर्म समाहितम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2127144, "chapter_id": 3726, "verse_number": "", "content_sanskrit": "बाहुकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2127145, "chapter_id": 3726, "verse_number": "११", "content_sanskrit": "पुण्यश्लोकस्य वै सूतो वार्ष्णेय इति विश्रुतः ।\nस नळे विद्रुते भद्रे भार्गस्वरिमुपस्थितः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2127146, "chapter_id": 3726, "verse_number": "१२", "content_sanskrit": "अहमप्यन्नकुशलः सूतत्वे च विनिष्ठितः ।\nऋतुपर्णेन सारथ्ये भोजने च वृतः स्वयम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2127147, "chapter_id": 3726, "verse_number": "", "content_sanskrit": "केशिनी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2127148, "chapter_id": 3726, "verse_number": "१३", "content_sanskrit": "अथ जानाति वार्ष्णेयः क्वनु राजा गतो नळः ।\nकथं च त्वयि वै तेन कथितं स्यात् तु बाहुक\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2127149, "chapter_id": 3726, "verse_number": "", "content_sanskrit": "बाहुकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2127150, "chapter_id": 3726, "verse_number": "१४", "content_sanskrit": "इहैव पुत्रौ निक्षिप्य नळस्य शुभकर्मणः ।\nगतस्ततो यथाकामं नैष जानाति नैषधम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2127151, "chapter_id": 3726, "verse_number": "१५", "content_sanskrit": "न चान्यः पुरुषः कश्चिन् नळं वेत्ति यशस्विनि ।\nगूढश्चरति लोकेऽस्मिन् नष्टरूपो महीपतिः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2127152, "chapter_id": 3726, "verse_number": "१६", "content_sanskrit": "आत्मैव तु नळं वेत्ति या च सा तदनन्तरा ।\nन चैव तानि लिङ्गानि नळं शंसन्ति कर्हिचित्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2127153, "chapter_id": 3726, "verse_number": "", "content_sanskrit": "केशिनी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2127154, "chapter_id": 3726, "verse_number": "१७", "content_sanskrit": "योऽसावायोध्यां गतवान् प्रथमं ब्राह्मणस्तदा ।\nइमानि नारीवाक्यानि कथयानः पुनः पुनः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2127155, "chapter_id": 3726, "verse_number": "१८", "content_sanskrit": "क्वनु त्वं कितवच्छित्त्वा वस्त्रार्धं प्रस्थितो मम ।\nउत्सृज्य विपिने सुप्तामनुरक्तां प्रियां प्रिय\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2127156, "chapter_id": 3726, "verse_number": "१९", "content_sanskrit": "सा वै यथा समादिष्टा तत्राऽऽस्ते त्वत्प्रियैषिणी ।\nदह्यमाना दिवारात्रं वस्त्रार्धेनाभिसंवृता\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2127157, "chapter_id": 3726, "verse_number": "२०", "content_sanskrit": "तस्या रुदन्त्याः सततं तेन दुःखेन पार्थिव ।\nप्रसादं कुरु वै वीर प्रतिवाक्यं प्रयच्छ च \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2127158, "chapter_id": 3726, "verse_number": "२१", "content_sanskrit": "तस्यास्तत्प्रियमाख्यानं प्रब्रवीहि महामते ।\nतदेव वाक्यं वैदर्भी श्रोतुमिच्छन्त्यनिन्दिता\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2127159, "chapter_id": 3726, "verse_number": "२२", "content_sanskrit": "एतच्छ्रुत्वा प्रतिवचस्तस्य दत्तं त्वया किल ।\nयत्पुरा तत्पुनस्त्वत्तो वैदर्भी श्रोतुमिच्छति\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2127160, "chapter_id": 3726, "verse_number": "", "content_sanskrit": "बृहदश्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2127161, "chapter_id": 3726, "verse_number": "२३", "content_sanskrit": "एवमुक्तस्य केशिन्या नळस्य कुरुनन्दन ।\nहृदयं व्यथितं चासीद् अश्रुपूर्णे च लोचने\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2127162, "chapter_id": 3726, "verse_number": "२४", "content_sanskrit": "स निगृह्यात्मनो दुःखं दह्यमानो महीपतिः\nबाष्पसन्दिग्धया वाचा पुनरेवेदमब्रवीत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2127163, "chapter_id": 3726, "verse_number": "", "content_sanskrit": "बाहुकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2127164, "chapter_id": 3726, "verse_number": "२५", "content_sanskrit": "वैषम्यमपि सम्प्राप्ता गोपायन्ति कुलस्त्रियः ।\nआत्मानमात्मना सत्यो जितःस्वर्गो न संशयः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2127165, "chapter_id": 3726, "verse_number": "२६", "content_sanskrit": "रहिता भर्तृभिश्चापि न क्रुध्यन्ति कदाचन ।\nप्राणांश्चारित्रकवचा धारयन्तीह सत्स्त्रियः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2127166, "chapter_id": 3726, "verse_number": "२७", "content_sanskrit": "विषमस्थेन मूढेन परिभ्रष्टसुखेन च ।\nयत् सा तेन परित्यक्ता तत्र न क्रोद्धुमर्हति\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2127167, "chapter_id": 3726, "verse_number": "२८", "content_sanskrit": "प्राणयात्रां परिप्रेप्सोः शकुनैर्हृतवाससः ।\nआधिभिर्दह्यमानस्य श्यामा न क्रोद्धुमर्हति\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2127168, "chapter_id": 3726, "verse_number": "२९", "content_sanskrit": "सत्कृताऽसत्कृता वाऽपि पतिं दृष्ट्वा तथागतम् ।\nभ्रष्टराज्यं श्रिया हीनं क्षुधितं व्यसनाप्लुतम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2127169, "chapter_id": 3726, "verse_number": "३०", "content_sanskrit": "एवं ब्रुवाणस्तद्वाक्यं नळः परमदुःखितः ।\nन बाष्पमशकत् सोढुं प्ररुरोद च भारत\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2127170, "chapter_id": 3726, "verse_number": "३१", "content_sanskrit": "ततः सा केशिनी गत्वा दमयन्त्यै न्यवेदयत् ।\nतत् सर्वं कथितं चैव विकारं चैव भामिनी\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2127171, "chapter_id": 3726, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nवनपर्वणि अष्टषष्टितमोऽध्यायः ॥६८॥ तीर्थयात्रापर्वणि चतुर्विंशोऽध्यायः ॥२४॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]