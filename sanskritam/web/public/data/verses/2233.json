[{"id": 2056811, "chapter_id": 2233, "verse_number": "७-१६०-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2056812, "chapter_id": 2233, "verse_number": "७-१६०-१", "content_sanskrit": "तथा परुषितं दृष्ट्वा सूतपुत्रेण मातुलम्।\nखङ्गमुद्यम्य वेगेन द्रौणिरभ्यपतद्द्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2056813, "chapter_id": 2233, "verse_number": "७-१६०-२", "content_sanskrit": "ततः परमसङ्क्रुद्धः सिंहो मत्तमिव द्विपम्।\nप्रेक्षतः कुरुराजस्य द्रौणिः कर्णं समभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2056814, "chapter_id": 2233, "verse_number": "७-१६०-३x", "content_sanskrit": "अश्वत्थामोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2056815, "chapter_id": 2233, "verse_number": "७-१६०-३", "content_sanskrit": "यदर्युनगुणांस्तथ्यान्कीर्तयानं नराधम।\nशूरं द्वेषात्सुदुर्बुद्धे त्वं भर्त्सयसि मातुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2056816, "chapter_id": 2233, "verse_number": "७-१६०-४", "content_sanskrit": "विकत्थमानः शौर्येण सर्वलोकधनुर्धरम्॥\nदर्पोत्सेधगृहीतोऽद्य न कञ्चिद्गणयन्मृधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2056817, "chapter_id": 2233, "verse_number": "७-१६०-५", "content_sanskrit": "क्व ते वीर्यं क्व चास्त्राणि यं त्वां निर्जित्य संयुगे।\nगाण्डीवधन्वा हतवान्प्रेक्षतस्ते जयद्रथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2056818, "chapter_id": 2233, "verse_number": "७-१६०-६", "content_sanskrit": "येन साक्षान्महादेवो योधितः समरे पुरा।\nतमिच्छसि वृथा जेतुं सूताधम मनोरथैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2056819, "chapter_id": 2233, "verse_number": "७-१६०-७", "content_sanskrit": "यं हि कृष्णेन सहितं सर्वशस्त्रभृतां वरम्।\nजेतुं न शक्ताः सहिताः सेन्द्रा अपि सुरासुराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2056820, "chapter_id": 2233, "verse_number": "७-१६०-८", "content_sanskrit": "लोकैकवीरमजितमर्जुनं सूत संयुगे।\nकिं पुनस्त्वं सुदुर्बुद्धे सहैभिर्वसुधाधिपैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2056821, "chapter_id": 2233, "verse_number": "७-१६०-९", "content_sanskrit": "कर्ण पश्य सुदुर्बुद्धे तिष्ठेदानीं नराधम।\nएष तेऽद्य शिरः कायादुद्धरामि सुदुर्मते॥\nसञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2056822, "chapter_id": 2233, "verse_number": "७-१६०-१०", "content_sanskrit": "तमुद्यतं तु वेगेन राजा दुर्योधनः स्वयम्।\nन्यवारयन्महातेजाः कृपश्च द्विपदां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2056823, "chapter_id": 2233, "verse_number": "७-१६०-११x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2056824, "chapter_id": 2233, "verse_number": "७-१६०-११", "content_sanskrit": "शूरोऽयं समरश्लाघी दुर्मतिश्च द्विजाधमः।\nआसादयतु मद्वीर्यं मुञ्चेमं कुरुसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2056825, "chapter_id": 2233, "verse_number": "७-१६०-१२x", "content_sanskrit": "अश्वत्थामोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2056826, "chapter_id": 2233, "verse_number": "७-१६०-१२", "content_sanskrit": "तैवतत्क्षम्यतेऽस्माभिः सूतात्मज सुदुर्मते।\nदर्पमुत्सिक्तमेतत्ते फल्गुनो नाशयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2056827, "chapter_id": 2233, "verse_number": "७-१६०-१३x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2056828, "chapter_id": 2233, "verse_number": "७-१६०-१३", "content_sanskrit": "अश्वत्थामन्प्रसीदस्व क्षन्तुमर्हसि मानद।\nकोपः खलु न कर्तव्यः सूतपुत्रं कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2056829, "chapter_id": 2233, "verse_number": "७-१६०-१४", "content_sanskrit": "त्वयि कर्णे कृपे द्रोणे मद्रराजेऽथ सौबले।\nमहत्कार्यं समासक्तं प्रसीद द्विजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2056830, "chapter_id": 2233, "verse_number": "७-१६०-१५", "content_sanskrit": "एते ह्यभिमुखाः सर्वे राधेयेन युयुत्सवः।\nआयान्ति पाण्डवा ब्रह्मन्नाह्वयन्तः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2056831, "chapter_id": 2233, "verse_number": "७-१६०-१६x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2056832, "chapter_id": 2233, "verse_number": "७-१६०-१६", "content_sanskrit": "प्रसाद्यमानस्तु ततो राज्ञा द्रौणिर्महामनाः।\nप्रससाद महाराज क्रोधवेगसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2056833, "chapter_id": 2233, "verse_number": "७-१६०-१७", "content_sanskrit": "ततः कृपोऽप्युवाचेदमाचार्यः सुमहामनाः।\nसौम्यस्वभावाद्राजनेन्द्र क्षिप्रमागतमार्दवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2056834, "chapter_id": 2233, "verse_number": "७-१६०-१८x", "content_sanskrit": "कृप उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2056835, "chapter_id": 2233, "verse_number": "७-१६०-१८", "content_sanskrit": "तवैतत्क्षम्यतेऽस्माभिः सूतात्मज सुदुर्मते।\nदर्पमुत्सिक्तमेतत्ते फल्गुनो नाशयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2056836, "chapter_id": 2233, "verse_number": "७-१६०-१९x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2056837, "chapter_id": 2233, "verse_number": "७-१६०-१९", "content_sanskrit": "ततस्ते पाण्डवा राजन्पाञ्चालाश्च यशस्विनः।\nआजग्मुः सहिताः कर्णं तर्जयन्तः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2056838, "chapter_id": 2233, "verse_number": "७-१६०-२०", "content_sanskrit": "कर्णोऽपि रथिनां श्रेष्ठश्चापमुद्यम्य वीर्यवान्।\nकौरवाग्र्यैः परिवृतः शक्रो देवगणैरिव।\nपर्यतिष्ठत तेजस्वी स्वबाहुबलमाश्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2056839, "chapter_id": 2233, "verse_number": "७-१६०-२१", "content_sanskrit": "ततः प्रववृते युद्धं कर्णस्य सह पाण्डवैः।\nभीषणं सुमहाराज सिंहनादविराजितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2056840, "chapter_id": 2233, "verse_number": "७-१६०-२२", "content_sanskrit": "ततस्ते पाण्डवा राजन्पाञ्चालाश्च यशस्विनः।\nदृष्ट्वा कर्णं महाबाहुमुच्चैः शब्दमथानदन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2056841, "chapter_id": 2233, "verse_number": "७-१६०-२३", "content_sanskrit": "अयं कर्णः कुतः कर्णस्तिष्ठ कर्ण महारणे।\nयुध्यस्व सहितोऽस्माभिर्दुरात्मन्पुरुषाधम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2056842, "chapter_id": 2233, "verse_number": "७-१६०-२४", "content_sanskrit": "अन्ये तु दृष्ट्वा राधेयं क्रोधरक्रेक्षणाऽब्रुवन्।\nहन्यतामयमुत्सिक्तः सूतपुत्रोऽल्पचेतनः।\nसर्वैः पार्थिवशार्दूलैर्नानेनार्थोऽस्ति जीवता।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2056843, "chapter_id": 2233, "verse_number": "७-१६०-२५", "content_sanskrit": "अत्यन्तवैरी पार्थानां सततं पापपूरुषः।\nएष मूलमनर्थानां दुर्योधनमते स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2056844, "chapter_id": 2233, "verse_number": "७-१६०-२६", "content_sanskrit": "घ्नतैनमिति जल्पन्तः क्षत्रियाः समुपाद्रवन्।\nमहता शरवर्षेण च्छादयन्तो महारथाः।\nवधार्थं सूतपुत्रस्य पाण्डवेयेन चोदिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2056845, "chapter_id": 2233, "verse_number": "७-१६०-२७", "content_sanskrit": "तांस्तु सर्वांस्तथा दृष्ट्वा धावमानान्महारथान्।\nन विव्यथे सूतपुत्रो न च त्रासमगच्छत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2056846, "chapter_id": 2233, "verse_number": "७-१६०-२८", "content_sanskrit": "दृष्ट्वा सागस्कल्पं तमुद्धूतं सैन्यसागरम्।\nपिप्रीषुस्तव पुत्राणां सङ्ग्रामेष्वपराजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2056847, "chapter_id": 2233, "verse_number": "७-१६०-२९", "content_sanskrit": "सायकौधेन बलवान्क्षिप्रकारी महाबलः।\nवारयामास तत्सैन्यं समन्ताद्भरतर्पभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2056848, "chapter_id": 2233, "verse_number": "७-१६०-३०", "content_sanskrit": "ततस्तु शरवर्षेण पार्थिवास्तमवारयन्।\nधनुम्पि ते विधुन्वानाः शतशोऽथ सहस्रशः।\nअयोधयन्त राधेयं शक्रं दैत्यगणा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2056849, "chapter_id": 2233, "verse_number": "७-१६०-३१", "content_sanskrit": "शरवर्पं तु तत्कर्णः पार्थिवैः समुदीरितम्।\nशरवर्षेण महता समन्ताद्व्यकिरत्प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2056850, "chapter_id": 2233, "verse_number": "७-१६०-३२", "content_sanskrit": "तद्युद्धमभवत्तेषां कृतप्रतिकृतैषिणाम्।\nयथा देवासुरे युद्धे शक्रस्य सह दानैवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2056851, "chapter_id": 2233, "verse_number": "७-१६०-३३", "content_sanskrit": "तत्राद्भुतमपश्याम सूतपुत्रस्य लाघवम्।\nयदेनं सर्वतो यत्ता नाप्नुवन्ति परे युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2056852, "chapter_id": 2233, "verse_number": "७-१६०-३४", "content_sanskrit": "निवार्य च शरौघांस्तान्पार्थिवानां महारथः।\nयुगेष्वीषासु च्छत्रेषु ध्वजेषु च हयेषु च।\nआत्मनामाङ्कितान्घोरान्राधेयः प्राहिणोच्छरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2056853, "chapter_id": 2233, "verse_number": "७-१६०-३५", "content_sanskrit": "ततस्ते व्याकुलीभूता राजानः कर्णपीडिताः।\nबभ्रुमुस्तत्र तत्रैव गावः शीतार्दिता इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2056854, "chapter_id": 2233, "verse_number": "७-१६०-३६", "content_sanskrit": "हयानां वध्यमानानां गजानां रथिनां तथा।\nतत्रतत्राभ्यवेक्षाम सङ्घान्कर्णेन ताडितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2056855, "chapter_id": 2233, "verse_number": "७-१६०-३७", "content_sanskrit": "शिरोभिः पतितै राजन्बाहुभिश्च समन्ततः।\nआस्तीर्णा वसुधा सर्वा शूराणामनिवर्तिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2056856, "chapter_id": 2233, "verse_number": "७-१६०-३८", "content_sanskrit": "हतैश्च हन्यमानैश्च निष्टनद्भिश्च सर्वशः।\nबभूवायोधनं रौद्रं वैवस्वतपुरोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2056857, "chapter_id": 2233, "verse_number": "७-१६०-३९", "content_sanskrit": "ततो दुर्योधनो राजा दृष्ट्वा कर्णस्य विक्रमम्।\nअश्वत्थामानमासाद्य वाक्यमेतदुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2056858, "chapter_id": 2233, "verse_number": "७-१६०-४०", "content_sanskrit": "युध्यतेऽसौ रणे कर्णो दंशितः सर्वपार्थिवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2056859, "chapter_id": 2233, "verse_number": "७-१६०-४१", "content_sanskrit": "पश्यैतां द्रवतीं सेनां कर्णसायकपीडिताम्।\nकार्तिकेयेन विध्वस्तामासुरीं पृतनामिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2056860, "chapter_id": 2233, "verse_number": "७-१६०-४२", "content_sanskrit": "दृष्ट्वैतां निर्जितां सेनां रणे कर्णेन धीमता।\nअभियात्येष बीभत्सुः सूतपुत्रजिघांसया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2056861, "chapter_id": 2233, "verse_number": "७-१६०-४३", "content_sanskrit": "तद्यथा प्रेक्षमाणानां सूतपुत्रं महारथम्।\nन हन्यात्पाण्डवः सङ्ख्ये तथा नीतिर्विधीयतां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2056862, "chapter_id": 2233, "verse_number": "७-१६०-४४", "content_sanskrit": "ततो द्रौणिः कृपः शल्यो हार्दिक्यश्च महारथः।\nप्रत्युद्ययुस्तदा पार्थं सूतपुत्रपरीप्सया।\nआयान्तं वीक्ष्य कौन्तेयं शक्रं दैत्यचमूमिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2056863, "chapter_id": 2233, "verse_number": "७-१६०-४५", "content_sanskrit": "बीभत्सुरपि राजेन्द्र पाञ्चालैरभिसंवृतः।\nप्रत्युद्ययौ तदा कर्णं यथा वृत्रं शतक्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2056864, "chapter_id": 2233, "verse_number": "७-१६०-४६x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2056865, "chapter_id": 2233, "verse_number": "७-१६०-४६", "content_sanskrit": "संरब्धं फल्गुनं दृष्ट्वा कालान्तकयमोपमम्।\nकर्णो वैकर्तनः सूत प्रत्यपद्यत्किमुत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2056866, "chapter_id": 2233, "verse_number": "७-१६०-४७", "content_sanskrit": "यो ह्यस्पर्धत पार्थेन नित्यमेव महारथः।\nआशंसते च बीभत्सुं युद्धे जेतुं सुदारुणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2056867, "chapter_id": 2233, "verse_number": "७-१६०-४८", "content_sanskrit": "स तु तं सहसा प्राप्तं नित्यमत्यन्तवैरिणम्।\nकर्णो वैकर्तनः सूत किमुत्तरमपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2056868, "chapter_id": 2233, "verse_number": "७-१६०-४९x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2056869, "chapter_id": 2233, "verse_number": "७-१६०-४९", "content_sanskrit": "आयान्तं पाण्डव दृष्ट्वा गजं प्रतिगजो यथा।\nअसम्भ्रान्तो रणे कर्णः प्रत्युदीयाद्धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2056870, "chapter_id": 2233, "verse_number": "७-१६०-५०", "content_sanskrit": "तमापतन्तं वेगेन वैकर्तनमजिह्मगैः।\nछादयामास पार्थोऽथ कर्णस्तु विजयं शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2056871, "chapter_id": 2233, "verse_number": "७-१६०-५१", "content_sanskrit": "स कर्णं शरजालेन च्छादयामास पाण़्डवः।\nततः कर्णः सुसंरब्धः शरैस्त्रिभिरविध्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2056872, "chapter_id": 2233, "verse_number": "७-१६०-५२", "content_sanskrit": "तस्य तल्लाघवं पार्थो नामृष्यत महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2056873, "chapter_id": 2233, "verse_number": "७-१६०-५३", "content_sanskrit": "तस्मै बाणाञ्शिलाधौतान्प्रसन्नाग्रानजिह्मगान्।\nप्राहिणोत्सूतपुत्राय त्रिशतं शत्रुतापनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2056874, "chapter_id": 2233, "verse_number": "७-१६०-५४", "content_sanskrit": "विव्याध चैनं संरब्धो बाणेनैकेन वीर्यवान्।\nसव्ये भुजाग्रे बलवान्नाराचेन हसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2056875, "chapter_id": 2233, "verse_number": "७-१६०-५५", "content_sanskrit": "तस्य विद्धस्य बाणेन कराच्चापं पपात ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2056876, "chapter_id": 2233, "verse_number": "७-१६०-५६", "content_sanskrit": "पुनरादाय तच्चापं निमेषार्धान्महाबलः।\nछादयामास बाणौघैः फल्गुनं कृतहस्तवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2056877, "chapter_id": 2233, "verse_number": "७-१६०-५७", "content_sanskrit": "शरवृष्टिं तु तां मुक्तां सूतपुत्रेण भारत।\nव्यधमच्छरवर्षेण स्मयन्निव धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2056878, "chapter_id": 2233, "verse_number": "७-१६०-५८", "content_sanskrit": "तौ परस्परमासाद्य शरवर्षेण पार्थिव।\nछादयेतां महेष्वासौ कृतप्रतिकृतैषिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2056879, "chapter_id": 2233, "verse_number": "७-१६०-५९", "content_sanskrit": "तदद्भुतं महद्युद्धं कर्णपाण्डवयोर्मृधे।\nक्रुद्धयोर्वासिताहेतोर्वन्ययोर्गजयोरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2056880, "chapter_id": 2233, "verse_number": "७-१६०-६०", "content_sanskrit": "ततः पार्थो महेष्वासो दृष्ट्वा कर्णस्य विक्रमम्।\nमुष्टिदेशे धनुस्तस्य चिच्छेद त्वरयाऽन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2056881, "chapter_id": 2233, "verse_number": "७-१६०-६१", "content_sanskrit": "अश्वांश्च चतुरो भल्लैरनयद्यमसादनम्।\nसारथेश्च शिसः कायादहरच्छत्रुतापनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2056882, "chapter_id": 2233, "verse_number": "७-१६०-६२", "content_sanskrit": "अथैनं छिन्नधन्वानं हताश्वं हतसारथिम्।\nविव्याध सायकैः पार्थश्चतुर्भिः पाण्डुनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2056883, "chapter_id": 2233, "verse_number": "७-१६०-६३", "content_sanskrit": "हताश्वात्तु रथात्तूर्णमवप्लुत्य नरर्षभः।\nआरुरोह रथं तूर्णं कृपस्य शरपीडितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2056884, "chapter_id": 2233, "verse_number": "७-१६०-६४", "content_sanskrit": "स नुन्नोऽर्जुनबाणौघैराचितः शल्यको यथा।\nजीवितार्थमभिप्रेप्सुः कृपस्य रथमारुहत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2056885, "chapter_id": 2233, "verse_number": "७-१६०-६५", "content_sanskrit": "राधेयं निर्जितं दृष्ट्वा तावका भरतर्षभ।\nधनञ्जयशरैर्नुन्नाः प्राद्रवन्त दिशो दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2056886, "chapter_id": 2233, "verse_number": "७-१६०-६६", "content_sanskrit": "द्रवतस्तान्समालोक्य राजा दुर्योधनो नृप।\nनिवर्तयामास तदा वाक्यमेतदुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2056887, "chapter_id": 2233, "verse_number": "७-१६०-६७", "content_sanskrit": "अलं द्रुतेन वः शूरास्तिष्ठध्वं क्षत्रियर्षभाः।\nएष पार्थवधायाहं स्वयं गच्छामि संयुगे।\nअहं पार्थान्हनिष्यामि सपाञ्चालान्ससोमकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2056888, "chapter_id": 2233, "verse_number": "७-१६०-६८", "content_sanskrit": "अद्य मे युध्यमानस्य सह गाण्डीवधन्वना।\nद्रक्ष्यन्ति विक्रमं पार्थाः कालस्येव युगक्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2056889, "chapter_id": 2233, "verse_number": "७-१६०-६९", "content_sanskrit": "अद्य मद्बाणजालानि विमुक्तानि सहस्रशः।\nद्रक्ष्यन्ति समरे योधाः शलभानामिवायतीः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2056890, "chapter_id": 2233, "verse_number": "७-१६०-७०", "content_sanskrit": "अद्य बाणमयं वर्षं सृजतो मम धन्विनः।\nजीमूतस्येव घर्मान्ते द्रक्ष्यन्ति युधि सैनिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2056891, "chapter_id": 2233, "verse_number": "७-१६०-७१", "content_sanskrit": "जेष्याम्यद्य रणे पार्थं सायकैर्नतपर्वभिः।\nतिष्ठध्वं समरे शूरा भयं त्यजत फल्गुनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2056892, "chapter_id": 2233, "verse_number": "७-१६०-७२", "content_sanskrit": "न हि मद्वीर्यमासाद्य फल्गुनः प्रसहिष्यति।\nयथा वेलां समासाद्य सागरो मकरालयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2056893, "chapter_id": 2233, "verse_number": "७-१६०-७३", "content_sanskrit": "इत्युक्त्वा प्रययौ राजा सैन्येन महता वृतः।\nफल्गुनं प्रतिदुर्धर्षः क्रोधात्संरक्तलोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2056894, "chapter_id": 2233, "verse_number": "७-१६०-७४", "content_sanskrit": "तं प्रयान्तं महाबाहुं दृष्ट्वा शारद्वतस्तदा।\nअश्वत्थामानमासाद्य वाक्यमेतदुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2056895, "chapter_id": 2233, "verse_number": "७-१६०-७५", "content_sanskrit": "एष राजा महाबाहुरमर्षी क्रोधमूर्च्छितः।\nपतङ्गवृत्तिमास्थाय फल्गुनं योद्धुमिच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2056896, "chapter_id": 2233, "verse_number": "७-१६०-७६", "content_sanskrit": "यावन्नः पश्यमानानां प्राणान्पार्थेन संगतः।\nन जह्यात्पुरुषव्याघ्रस्तावद्वारय कौरवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2056897, "chapter_id": 2233, "verse_number": "७-१६०-७७", "content_sanskrit": "यावत्फल्गुनबाणानां गोचरं नाद्य गच्छति।\nकौरवः पार्थिवो वीरस्तावद्वारय संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2056898, "chapter_id": 2233, "verse_number": "७-१६०-७८", "content_sanskrit": "यावत्पार्थशरैर्घोरैर्निर्मुक्तोरगसन्निभैः।\nन भस्मीक्रियते राजा तावद्युद्धान्निवार्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2056899, "chapter_id": 2233, "verse_number": "७-१६०-७९", "content_sanskrit": "अयुक्तमिव पश्यामि तिष्ठत्स्वस्मासु मानद।\nस्वयं युद्धाय यद्राजा पार्थं यात्यसहायवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2056900, "chapter_id": 2233, "verse_number": "७-१६०-८०", "content_sanskrit": "दुर्लभं जीवितं मन्ये कौरव्यस्य किरीटिना।\nयुध्यमानस्य पार्थेन शार्दूलेनेव हस्तिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2056901, "chapter_id": 2233, "verse_number": "७-१६०-८१", "content_sanskrit": "मातुलेनैवमुक्तस्तु द्रौणिः शस्त्रभृतां वरः।\nदुर्योधनमिदं वाक्यं त्वरितः समभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2056902, "chapter_id": 2233, "verse_number": "७-१६०-८२", "content_sanskrit": "मयि जीवति गान्धारे न युद्धं गन्तुमर्हसि।\nमामनादृत्य कौरव्य तव नित्यं हितैषिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2056903, "chapter_id": 2233, "verse_number": "७-१६०-८३", "content_sanskrit": "न हि सम्भ्रमः कार्यः पार्थस्य विजयं प्रति।\nअहमावारयिष्यामि पार्थं तिष्ठ सुयोधन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2056904, "chapter_id": 2233, "verse_number": "७-१६०-८४x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2056905, "chapter_id": 2233, "verse_number": "७-१६०-८४", "content_sanskrit": "आचार्यः पाण्डुपुत्रान्वै पुत्रवत्परिरक्षति।\nत्वमप्युपेक्षां कुरुषे तेषु नित्यं द्विजोत्तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2056906, "chapter_id": 2233, "verse_number": "७-१६०-८५", "content_sanskrit": "मम वा मन्दभाग्यत्वान्मन्दस्ते विक्रमो युधि।\nधर्मराजप्नियार्थं वा द्रौपद्या वा न विद्म तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2056907, "chapter_id": 2233, "verse_number": "७-१६०-८६", "content_sanskrit": "धिगस्तु मम लुब्धस्य यत्कृते सर्वबान्धवाः।\nसुखार्हाः परमं दुःखं प्राप्नुवन्त्यपराजिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2056908, "chapter_id": 2233, "verse_number": "७-१६०-८७", "content_sanskrit": "को हि शस्त्रविदां मुख्यो महेश्वरसमो युधि।\nशत्रुं न क्षपयेच्छक्तो यो न स्याद्गौतमीसुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2056909, "chapter_id": 2233, "verse_number": "७-१६०-८८", "content_sanskrit": "अश्वत्थामन्प्रसीदस्व नाशयैतान्ममाहितान्।\nतवास्त्रगोचरे शक्ताः स्थातुं देवा न दानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2056910, "chapter_id": 2233, "verse_number": "७-१६०-८९", "content_sanskrit": "पाञ्चालान्सोमकांश्चैव जहि द्रौणे सहानुगान्।\nवयं शेषान्हनिष्यामस्त्वयैव परिरक्षिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2056911, "chapter_id": 2233, "verse_number": "७-१६०-९०", "content_sanskrit": "एते हि सोमका विप्र पाञ्चालाश्च यशस्विनः।\nमम सैन्येषु सङ्क्रुद्धा विचरन्ति दवाग्निवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2056912, "chapter_id": 2233, "verse_number": "७-१६०-९१", "content_sanskrit": "तान्वारय महाबाहो केकयांश्च नरोत्तम।\nपुरा कुर्वन्ति निःशेषं रक्ष्यमाणाः किरीटिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2056913, "chapter_id": 2233, "verse_number": "७-१६०-९२", "content_sanskrit": "अश्वत्थामंस्त्वरायुक्तो याहि शीघ्रमरिन्दम।\nआदौ वा यदि वा पश्चात्तवेदं कर्म मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2056914, "chapter_id": 2233, "verse_number": "७-१६०-९३", "content_sanskrit": "त्वमुत्पन्नो महाबाहो पाञ्चालानां वधं प्रति।\nकरिष्यसि जगत्सर्वमपाञ्चालं किलोद्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2056915, "chapter_id": 2233, "verse_number": "७-१६०-९४", "content_sanskrit": "एवं सिद्धाऽब्रुवन्वाचो भविष्यति च तत्तथा।\nतस्मात्त्वं पुरुषव्याघ्र पाञ्चालाञ्जहि सानुगान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2056916, "chapter_id": 2233, "verse_number": "७-१६०-९५", "content_sanskrit": "न तेऽस्त्रगोचरे शक्ताः स्थातुं देवाः सवासवाः।\nकिमु पार्थाः सपाञ्चालाः सत्यमेतद्ब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2056917, "chapter_id": 2233, "verse_number": "७-१६०-९६", "content_sanskrit": "न त्वां समर्थाः सङ्ग्रामे पाण्डवाः सह सोमकैः।\nबलाद्योधयितुं वीर सत्यमेतद्ब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2056918, "chapter_id": 2233, "verse_number": "७-१६०-९७", "content_sanskrit": "गच्छगच्छ महाबाहो न नः कालात्ययो भवेत्।\nइयं हि द्रवते सेना पार्तसायकपीडिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2056919, "chapter_id": 2233, "verse_number": "७-१६०-९८", "content_sanskrit": "शक्तो ह्यसि महाबाहो दिव्येन स्वेन तेजसा।\nनिग्रहे पाण्डुपुत्राणां पाञ्चालानां च मानद॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2056920, "chapter_id": 2233, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि घटोत्कचवधपर्वणि चतुर्दशरात्रियुद्धे षष्ट्यधिकशततमोऽध्यायः॥ १६० ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१६०-४ कञ्चिद्धनुर्धरं नगणयन्नित्यन्वयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}]