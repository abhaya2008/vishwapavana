[{"id": 2078384, "chapter_id": 2664, "verse_number": "१२-१६९-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2078385, "chapter_id": 2664, "verse_number": "१२-१६९-१", "content_sanskrit": "गिरं तां मधुरां श्रुत्वा गौतमो विस्मितस्तदा।\nकौतूहलान्वितो राजन्राजधर्माणमैक्षत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2078386, "chapter_id": 2664, "verse_number": "१२-१६९-२x", "content_sanskrit": "राजधर्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2078387, "chapter_id": 2664, "verse_number": "१२-१६९-२", "content_sanskrit": "भोः काश्यपस्य पुत्रोऽहं माता दाक्षायणी मम।\nसती त्वं च गुणोपेतः स्वागतं ते द्विजोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2078388, "chapter_id": 2664, "verse_number": "१२-१६९-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2078389, "chapter_id": 2664, "verse_number": "१२-१६९-३", "content_sanskrit": "तस्मै दत्त्वा स सत्कारं विधिदृष्टेन कर्मणा।\nशालपुष्पमयीं दिव्यां बृसीं समुपकल्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2078390, "chapter_id": 2664, "verse_number": "१२-१६९-४", "content_sanskrit": "भगीरथरथाक्रान्तदेशान्गङ्गानिषेवितान्।\nये चरन्ति महामीनास्तांश्च तस्यान्वकल्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2078391, "chapter_id": 2664, "verse_number": "१२-१६९-५", "content_sanskrit": "वह्निं चापि सुसंदीप्तं मीनांश्चापि सुपीवरान्।\nस गौतमायातिथये न्यवेदयत काश्यपिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2078392, "chapter_id": 2664, "verse_number": "१२-१६९-६", "content_sanskrit": "भुक्तवन्तं च तं विप्रं प्रीतात्मानं महामनाः।\nश्रमापनयनार्थं स पक्षाभ्यामभ्यवीजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2078393, "chapter_id": 2664, "verse_number": "१२-१६९-७", "content_sanskrit": "तनो विश्रान्तमासीनं गोत्रवृत्तमपृच्छत।\nसोऽब्रवीद्गौतमोऽस्मीति ब्राह्मणोस्मीत्युदाहरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2078394, "chapter_id": 2664, "verse_number": "१२-१६९-८", "content_sanskrit": "तस्मै पर्णमयं दिव्यं दिव्यपुष्पाधिवासितम्।\nगन्धाढ्यं शयनं प्रादात्स शिश्ये तत्र वै सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2078395, "chapter_id": 2664, "verse_number": "१२-१६९-९", "content_sanskrit": "अपोपविष्टं शयने गौतमं वाक्यवित्तमः।\nपप्रच्छ काश्यपिर्वाग्मी किमागमनमित्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2078396, "chapter_id": 2664, "verse_number": "१२-१६९-१०", "content_sanskrit": "ततोऽब्रवीद्गौतमस्तं दरिद्रोऽहं महामते।\nसमुद्रगमनाकाङ्क्षी द्रव्यार्थमिति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2078397, "chapter_id": 2664, "verse_number": "१२-१६९-११", "content_sanskrit": "तं काश्यपोऽब्रवीत्प्रीत्या नोत्कण्ठां कर्तुमर्हसि।\nकृतकार्यो द्विजश्रेष्ठ सद्रव्यो यास्यसे गृहान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2078398, "chapter_id": 2664, "verse_number": "१२-१६९-१२", "content_sanskrit": "चतुर्विधा ह्यर्थगतिर्बृहस्पतिमतं यथा।\nमित्रं विद्या हिरण्यं च बुद्धिश्चेति बुधेप्सिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2078399, "chapter_id": 2664, "verse_number": "१२-१६९-१३", "content_sanskrit": "प्रादुर्भूतोऽस्मि ते मित्रं सुहृत्त्वं च महत्तरम्।\nसोऽहं तथा यतिष्यामि भविष्यसि यथार्थवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2078400, "chapter_id": 2664, "verse_number": "१२-१६९-१४", "content_sanskrit": "ततः प्रभातसमये सुखं पृष्ट्वाऽब्रवीदिदम्।\nगच्छ सौम्य पथाऽनेन कृतकृत्यो भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2078401, "chapter_id": 2664, "verse_number": "१२-१६९-१५", "content_sanskrit": "इतस्त्रियोजनं गत्वा राक्षसाधिपतिर्महान्।\nविरूपाक्ष इति ख्यातः सखा मम महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2078402, "chapter_id": 2664, "verse_number": "१२-१६९-१६", "content_sanskrit": "तं गच्छ द्विजमुख्य त्वं स मद्वाक्यप्रचोदितः।\nकामानभीप्सितांस्तुभ्यं दाता नास्त्यत्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2078403, "chapter_id": 2664, "verse_number": "१२-१६९-१७", "content_sanskrit": "इत्युक्तः प्रययौ राजन्गौतमो विगतक्लमः।\nफलान्यमृतकल्पानि भक्षयानो यथेष्टतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2078404, "chapter_id": 2664, "verse_number": "१२-१६९-१८", "content_sanskrit": "चन्दनागुरुमुख्यानि पत्रत्वचवनानि च।\nतस्मिन्पथि महाराज सेवमानो द्रुतं ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2078405, "chapter_id": 2664, "verse_number": "१२-१६९-१९", "content_sanskrit": "ततो मनुव्रजं नाम नगरं शैलतोरणम्।\nशैलप्राकारवप्रं च शैलयन्त्रार्गलं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2078406, "chapter_id": 2664, "verse_number": "१२-१६९-२०", "content_sanskrit": "विदितश्चाभवत्तस्य राक्षसेन्द्रस्य धीमतः।\nप्रहितः सुहृदा राजन्प्रीयमाणः प्रियातिथिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2078407, "chapter_id": 2664, "verse_number": "१२-१६९-२१", "content_sanskrit": "ततः स राक्षसेन्द्रः स्वान्प्रेष्यानाह युधिष्ठिर।\nगौतमो नगरद्वाराच्छीघ्रमानीयतामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2078408, "chapter_id": 2664, "verse_number": "१२-१६९-२२", "content_sanskrit": "तस्मात्पुरवरात्तूर्णं पुरुषाः श्वेतवेष्टनाः।\nगौतमेत्यभिभाषन्तः पुरद्वारमुपागमन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2078409, "chapter_id": 2664, "verse_number": "१२-१६९-२३", "content_sanskrit": "ते तमूचुर्महाराज राजप्रेष्यास्तदा द्विजम्।\nत्वरस्व तूर्णमागच्छ राजा त्वां द्रष्टुमिच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2078410, "chapter_id": 2664, "verse_number": "१२-१६९-२४", "content_sanskrit": "राक्षसाधिपतिर्वीरो विरूपाक्ष इति श्रुतः।\nस त्वां त्वरति वै द्रष्टुं तत्क्षिप्रं संविधीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2078411, "chapter_id": 2664, "verse_number": "१२-१६९-२५", "content_sanskrit": "ततः स प्राद्रवद्विप्रो विस्मयाद्विगतक्लमः।\nगौतमः परमर्द्धि तां पश्यन्परमविस्मितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2078412, "chapter_id": 2664, "verse_number": "१२-१६९-२६", "content_sanskrit": "तैरेव सहितो राज्ञो वेश्म तूर्णमुपाद्रवत्।\nदर्शनं राक्षसेन्द्रस्य काङ्क्षमाणो द्विजस्तदा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2078413, "chapter_id": 2664, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि एकोनसप्तत्यधिकशततमोऽध्यायः॥ १६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]