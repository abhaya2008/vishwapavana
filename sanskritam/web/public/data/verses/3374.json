[{"id": 2109347, "chapter_id": 3374, "verse_number": "", "content_sanskrit": "शौनकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2109348, "chapter_id": 3374, "verse_number": "१", "content_sanskrit": "भृगुवंशात् प्रभृत्येतत् त्वया मे कथितं महत् ।\nआख्यानमखिलं तात भृशं प्रीतोऽस्मि तेऽनघ\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2109349, "chapter_id": 3374, "verse_number": "२", "content_sanskrit": "प्रवक्ष्ये चैव यत् त्वाऽहं यथावत् सूतनन्दन ।\nयाः कथा व्याससम्प्रोक्ताः ताश्च भूयः प्रचक्ष्व मे \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2109350, "chapter_id": 3374, "verse_number": "३", "content_sanskrit": "तस्मिन् परमदुष्प्रापे सर्पसत्रे महात्मनः ।\nकर्मान्तरेषु विधिवत् सदस्यानां तथा कवे \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2109351, "chapter_id": 3374, "verse_number": "४", "content_sanskrit": "या बभूवुः कथाश्चित्रा येष्वर्थेषु यथातथम् ।\nत्वत्त इच्छाम्यहं श्रोतुं सूत त्वं वै विचक्ष्व नः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2109352, "chapter_id": 3374, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2109353, "chapter_id": 3374, "verse_number": "५", "content_sanskrit": "कर्मान्तरेष्वकथयन् द्विजा वेदाश्रयाः कथाः ।\nव्यासस्तु भगवान् नित्यमब्रवीद् भारतं महत् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2109354, "chapter_id": 3374, "verse_number": "", "content_sanskrit": "शौनकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2109355, "chapter_id": 3374, "verse_number": "६", "content_sanskrit": "महाभारतमत्यन्तं पाण्डवानां यशस्करम् ।\nजनमेजयेन पृष्टो यत् कृष्णद्वैपायनस्तदा \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2109356, "chapter_id": 3374, "verse_number": "७", "content_sanskrit": "श्रावयामास विधिवत् तदा कर्मान्तरेषु सः ।\nतामहं विधिवत् पुण्यां श्रोतुमिच्छामि वै कथाम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2109357, "chapter_id": 3374, "verse_number": "८", "content_sanskrit": "मनस्सागरसम्भूतां महर्षेः पुण्यकर्मणः ।\nकथयस्व सतां श्रेष्ठ परं कौतूहलं हि नः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2109358, "chapter_id": 3374, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2109359, "chapter_id": 3374, "verse_number": "९", "content_sanskrit": "हन्त ते कथयिष्यामि महदाख्यानमुत्तमम् ।\nकृष्णद्वैपायनमतं महाभारतमद्भुतम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2109360, "chapter_id": 3374, "verse_number": "१०", "content_sanskrit": "तच्छ्रुणुष्वोत्तममते कथ्यमानं मया द्विज ।\nशंसितुं तन्मनोहर्षो ममापीह प्रवर्धते \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2109361, "chapter_id": 3374, "verse_number": "११", "content_sanskrit": "श्रुत्वा तु सर्पसत्राय दीक्षितं जनमेजयम् ।\nअभ्यागच्छद् ऋषिर्विद्वान् कृष्णद्वैपायनस्तदा \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2109362, "chapter_id": 3374, "verse_number": "१२", "content_sanskrit": "जनयामास यं काळी शक्तेः पुत्रात् पराशरात् ।\nकन्यैव यमुनाद्वीपे पाण्डवानां पितामहम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2109363, "chapter_id": 3374, "verse_number": "१३", "content_sanskrit": "जातमात्रश्च यः सद्यो ववृधे वेदवित्तमः ।\nवेदांश्चाधिजगे साङ्गानितिहासांश्च सर्वशः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2109364, "chapter_id": 3374, "verse_number": "१४", "content_sanskrit": "यं नाति तपसा कश्चिन् न वेदाध्ययनेन च ।\nन व्रतैर्नोपवासेन न प्रशान्त्या न मन्युना \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2109365, "chapter_id": 3374, "verse_number": "१५", "content_sanskrit": "विव्यासैकं चतुर्घा यो वेदं वेदविदां वरः ।\nपरावरज्ञो ब्रह्मर्षिः कविः सत्यव्रतः शुचिः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2109366, "chapter_id": 3374, "verse_number": "१६", "content_sanskrit": "यः पाण्डुं धृतराष्ट्रं च विदुरं चाप्यजीजनत् ।\nशन्तनोः सन्ततिं सन्नमुद्धरिष्यन् महातपाः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2109367, "chapter_id": 3374, "verse_number": "१७", "content_sanskrit": "जनमेजयस्य राजर्षेः तस्मिन् सत्रे महात्मनः ।\nविवेश शिष्यैः सहितो वेदवेदाङ्गपारगैः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2109368, "chapter_id": 3374, "verse_number": "१८", "content_sanskrit": "तत्र राजानमासीनं ददर्श जनमेजयम् ।\nवृतं सदस्यैर्बहुभिर्देवैरिव शतक्रतुम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2109369, "chapter_id": 3374, "verse_number": "१९", "content_sanskrit": "तथा मूर्धावसिक्तैश्च नानाजनपदेश्वरैः ।\nऋत्विग्भिर्देवकल्पैश्च कुशलैर्यज्ञसंस्तरे \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2109370, "chapter_id": 3374, "verse_number": "२०", "content_sanskrit": "जनमेजयस्तु राजर्षिर्दृष्ट्वा तमृषिमागतम् ।\nसगणोऽभ्युद्यतस्तूर्णं ततो भारतसत्तमः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2109371, "chapter_id": 3374, "verse_number": "२१", "content_sanskrit": "काञ्चनं विष्टरं तस्मै स एव नृपतिः स्वयम् ।\nआसनं कल्पयामास यथा शक्रो बृहस्पतेः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2109372, "chapter_id": 3374, "verse_number": "२२", "content_sanskrit": "तत्रोपविष्टं वरदं देवर्षिगणपूजितम् ।\nपूजयामास राजेन्द्रः शास्त्रदृष्टेन कर्मणा \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2109373, "chapter_id": 3374, "verse_number": "२३", "content_sanskrit": "पाद्यमाचमनीयं च राज्यं गां च विधानतः ।\nपितामहाय कृष्णाय तदर्हाय न्यवेदयत् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2109374, "chapter_id": 3374, "verse_number": "२४", "content_sanskrit": "प्रतिगृह्य च तां पूजां पाण्डवाज्जनमेजयात् ।\nगां चैव समनुज्ञाय मुनिः प्रीतोऽभवत् तदा \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2109375, "chapter_id": 3374, "verse_number": "२५", "content_sanskrit": "तथा सम्पूजयित्वा तु यत्नेन प्रपितामहम् ।\nउपोपविश्य प्रीतात्मा पर्यपृच्छदनामयम् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2109376, "chapter_id": 3374, "verse_number": "२६", "content_sanskrit": "भगवानपि तं दृष्ट्वा कुशलं परिवेद्य च ।\nसदस्यैः पूजितः सर्वैः सदस्यानभ्यपूजयत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2109377, "chapter_id": 3374, "verse_number": "२७", "content_sanskrit": "ततस्तं सहितं सर्वैः कथान्ते जनमेजयः ।\nइममर्थं कुरुश्रेष्ठः पर्यपृच्छत् कृताञ्जलिः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2109378, "chapter_id": 3374, "verse_number": "२८", "content_sanskrit": "कुरूणां पाण्डवानां च भवान् प्रत्यक्षदर्शिवान् ।\nतेषां चरितमिच्छामि कथ्यमानमिह त्वया \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2109379, "chapter_id": 3374, "verse_number": "२९", "content_sanskrit": "कथं च भगवन् भेदस्तेषामासीन्महात्मनाम् ।\nतच्च युद्धं कथमभूत् भूतान्तकरणं महत् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2109380, "chapter_id": 3374, "verse_number": "३०", "content_sanskrit": "पितामहानां सर्वेषां दैवेनाविष्टचेतसाम् ।\nइच्छामि तत्वतः श्रोतुं भगवन् कुशलो ह्यसि \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2109381, "chapter_id": 3374, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2109382, "chapter_id": 3374, "verse_number": "३१", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा कृष्णद्वैपायनस्तदा ।\nशशास शिष्यमासीनं वैशम्पायनमन्तिकात् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2109383, "chapter_id": 3374, "verse_number": "३२", "content_sanskrit": "कुरूणां पाण्डवानां च यथा भेदोऽभवत् पुरा ।\nत्वमस्मै सर्वमाचक्ष्व यन्मत्तः श्रुतवानसि \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2109384, "chapter_id": 3374, "verse_number": "३३", "content_sanskrit": "गुरोर्वचनमाज्ञाय स तु विप्रर्षभस्तदा ।\nआचचक्षे ततः सर्वमितिहासं पुरातनम् \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2109385, "chapter_id": 3374, "verse_number": "३४", "content_sanskrit": "राज्ञे तस्मै सदस्येभ्यः क्षत्रियेभ्यश्च सर्वशः ।\nभेदं राज्यविनाशं च कुरुपाण्डवयोस्तदा \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2109386, "chapter_id": 3374, "verse_number": "१", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि त्रिपञ्चाशोऽध्यायः ॥५३॥ ॥ सम्भवपर्वणि प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]