[{"id": 2086046, "chapter_id": 2831, "verse_number": "१२-३३६-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2086047, "chapter_id": 2831, "verse_number": "१२-३३६-१", "content_sanskrit": "एतच्छ्रुत्वा गुरोर्वाक्यं व्यासशिष्या महौजसः।\nअन्योन्यं हृष्टमनसः परिषस्वजिरे तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2086048, "chapter_id": 2831, "verse_number": "१२-३३६-२", "content_sanskrit": "उक्ताः स्मो यद्भगवता तदात्वायतिसंहितम्।\nतन्नो मनसि संरूढं करिष्यामस्तथा च तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2086049, "chapter_id": 2831, "verse_number": "१२-३३६-३", "content_sanskrit": "अन्योन्यं संविभाष्यैवं सुप्रीतमनसः पुनः।\nविज्ञापयन्ति स्म गुरुं पुनर्वाक्यविशारदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2086050, "chapter_id": 2831, "verse_number": "१२-३३६-४", "content_sanskrit": "शैलादस्मान्महीं गन्तुं काङ्क्षितं नो महामुने।\nवेदाननेकधा कर्तुं यदि ते रुचितं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2086051, "chapter_id": 2831, "verse_number": "१२-३३६-५", "content_sanskrit": "शिष्याणां वचनं श्रुत्वा पराशरसुतः प्रभुः।\nप्रत्युवाच ततो वाक्यं धर्मार्थसहितं हितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2086052, "chapter_id": 2831, "verse_number": "१२-३३६-६", "content_sanskrit": "क्षितिं वा देवलोकं वा गम्यतां यदि रोचते।\nअप्रमादश्च वः कार्यो ब्रह्म हि प्रचुरच्छलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2086053, "chapter_id": 2831, "verse_number": "१२-३३६-७", "content_sanskrit": "तेऽनुज्ञातास्ततः सर्वे गुरुणा सत्यवादिना।\nजग्मुः प्रदक्षिणं कृत्वा व्यासं मूर्ध्नाऽभिवाद्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2086054, "chapter_id": 2831, "verse_number": "१२-३३६-८", "content_sanskrit": "अवतीर्य महीं तेऽथ चातुर्होत्रमकल्पयन्।\nसंयाजयन्तो विप्रांश्च राजन्यांश्च विशस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2086055, "chapter_id": 2831, "verse_number": "१२-३३६-९", "content_sanskrit": "पूज्यमाना द्विजैर्नित्यं मोदमाना गृहे रताः।\nयाजनाध्यापनरताः श्रीमन्तो लोकविश्रुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2086056, "chapter_id": 2831, "verse_number": "१२-३३६-१०", "content_sanskrit": "अवतीर्णेषु शिष्येषु व्यासः पुत्रसहायवान्।\nतूष्णीं ध्यानपरो धीमानेकान्ते समुपाविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2086057, "chapter_id": 2831, "verse_number": "१२-३३६-११", "content_sanskrit": "`एतस्मिन्नेव काले तु देवर्षिर्नारदस्तथा।\nहिमवन्तमगं द्रष्टुं सिद्धचारणसेवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2086058, "chapter_id": 2831, "verse_number": "१२-३३६-१२", "content_sanskrit": "तं ददर्शाश्रमपदे नारदः सुमहातपाः।\nअथैनमब्रवीत्काले मधुराक्षरया गिरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2086059, "chapter_id": 2831, "verse_number": "१२-३३६-१३", "content_sanskrit": "भोभो महर्षे वासिष्ठ ब्रह्मघोषो न वर्तते।\nएको ध्यानपरस्तूष्णीं किमास्से चिन्तयन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2086060, "chapter_id": 2831, "verse_number": "१२-३३६-१४", "content_sanskrit": "ब्रह्मघोषैर्विरहितः पर्वतोऽयं न शोभते।\nरजसा तमसा चैव सोमः सोपप्लवो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2086061, "chapter_id": 2831, "verse_number": "१२-३३६-१५", "content_sanskrit": "न भ्राजते यथापूर्वं निषादानामिवालयः।\nदेवर्षिगणजुष्टोऽपि वेदध्वनिविनाकृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2086062, "chapter_id": 2831, "verse_number": "१२-३३६-१६", "content_sanskrit": "ऋषयश्च हि देवाश्च गन्धर्वाश्च महौजसः।\nवियुक्ता ब्रह्मघोषेण न भ्राजन्ते यथा पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2086063, "chapter_id": 2831, "verse_number": "१२-३३६-१७", "content_sanskrit": "नारदस्य वचः श्रुत्वा कृष्णद्वैपायनोऽब्रवीत्।\nमहर्षे यत्त्वया प्रोक्तं वेदवादविचक्षण॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2086064, "chapter_id": 2831, "verse_number": "१२-३३६-१८", "content_sanskrit": "एतन्मनोऽनुकूलं मे भवानर्हसि भाषितुम्।\nसर्वज्ञः सर्वदर्शी च सर्वत्र च कुतूहली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2086065, "chapter_id": 2831, "verse_number": "१२-३३६-१९", "content_sanskrit": "त्रिषु लोकेषु यद्वृत्तं सर्वं तव मते स्थितम्।\nतदाज्ञापय विप्रर्षे ब्रूहि किं करवाणि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2086066, "chapter_id": 2831, "verse_number": "१२-३३६-२०", "content_sanskrit": "यन्मया समनुष्ठेयं ब्रह्मर्षे तदुदाहर।\nवियुक्तस्येह शिष्यैर्मे नातिहृष्टमिदं मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2086067, "chapter_id": 2831, "verse_number": "१२-३३६-२१x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2086068, "chapter_id": 2831, "verse_number": "१२-३३६-२१", "content_sanskrit": "अनाम्नायमला वेदा ब्राह्मणस्याव्रतं मलम्।\nमलं पृथिव्या बाह्वीकाः स्त्रीणां कौतूहलं मलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2086069, "chapter_id": 2831, "verse_number": "१२-३३६-२२", "content_sanskrit": "अधीयतां भवान्वेदान्सार्घं पुत्रेण धीमता।\nविधुन्वन्ब्रह्मघोषेण रक्षोभयकृतं तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2086070, "chapter_id": 2831, "verse_number": "१२-३३६-२३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2086071, "chapter_id": 2831, "verse_number": "१२-३३६-२३", "content_sanskrit": "नारदस्य वचः श्रुत्वा व्यासः परमधर्मवित्।\nतथेत्युक्त्वाऽथ संहृष्टो वेदाभ्यासे दृढव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2086072, "chapter_id": 2831, "verse_number": "१२-३३६-२४", "content_sanskrit": "`* उवाच च महाप्राज्ञं नारदं पुनरेव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2086073, "chapter_id": 2831, "verse_number": "१२-३३६-२५", "content_sanskrit": "मलं पृथिव्या बाह्लीका इत्युक्तमधुना त्वया।\nकीदृशाश्चैव वाह्लीका ब्रूहि मे वदतां वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2086074, "chapter_id": 2831, "verse_number": "१२-३३६-२६x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2086075, "chapter_id": 2831, "verse_number": "१२-३३६-२६", "content_sanskrit": "अस्यां पृथिव्यां चत्वारो देशाः पापजनैर्वृताः।\nयुगन्धरस्तु प्रथमस्तथा भूतिलकः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2086076, "chapter_id": 2831, "verse_number": "१२-३३६-२७", "content_sanskrit": "अच्युतच्छल इत्युक्तस्तृतीयः पारकृत्तमः।\nचतुर्थस्तु महापापो बाह्लीक इति संज्ञितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2086077, "chapter_id": 2831, "verse_number": "१२-३३६-२८", "content_sanskrit": "भृगोष्ट्रगर्दभक्षीरं पिबन्त्यस्य युगन्धरे।\nएवकर्णास्तु दृश्यन्ते जना वै ह्यच्युतस्थले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2086078, "chapter_id": 2831, "verse_number": "१२-३३६-२९", "content_sanskrit": "मेहन्ति च मलं पापा विसृजन्ति जलेषु वै।\nनित्यं भूतिलकेत्यन्नं तज्जलं च पिबन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2086079, "chapter_id": 2831, "verse_number": "१२-३३६-३०", "content_sanskrit": "हरिबाह्यास्तु बाहीका न स्मरन्ति हरिं क्वचित्।\nऐहलौकिकमोक्षं ते मांसशोणितवर्धनाः।\nवृथा जाता भविष्यन्ति बाह्लीका इति विश्रुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2086080, "chapter_id": 2831, "verse_number": "१२-३३६-३१", "content_sanskrit": "पुष्कराहारनिरताः पिशाचा यदभाषते।\nमुसुण्ठीं परिगृह्योग्रां तच्छृणुष्व महामुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2086081, "chapter_id": 2831, "verse_number": "१२-३३६-३२", "content_sanskrit": "ब्राह्मणीं बहुपुत्रां तां पुष्करे स्नातुमागताम्।\nयुगन्धरे पयः पीत्वा ह्युचिता ह्यच्युतस्थले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2086082, "chapter_id": 2831, "verse_number": "१२-३३६-३३", "content_sanskrit": "तथा भूतिलके स्नात्वा बाह्लीकांश्च निरीक्ष्य वै।\nआगताऽसि तथा स्नातुं कथं स्वर्गं न गच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2086083, "chapter_id": 2831, "verse_number": "१२-३३६-३४", "content_sanskrit": "इत्युक्त्वा ब्राह्मणीभाण्डं पोथयित्वा मुसुण्ठिना।\nउवाच क्रोधताम्राक्षी पिशाची तीर्थपालिका॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2086084, "chapter_id": 2831, "verse_number": "१२-३३६-३५", "content_sanskrit": "एतत्तु ते दिवावृत्तं रात्रौ वृत्तमथान्यथा।\nगच्छ बाह्लीकसंसर्गादशुचित्वं न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2086085, "chapter_id": 2831, "verse_number": "१२-३३६-३६", "content_sanskrit": "यद्द्विषन्ति महात्मानं न स्मरन्ति जनार्दनम्।\nन तेषां पुण्यतीर्थेषु गतिः संसर्गिणामपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2086086, "chapter_id": 2831, "verse_number": "१२-३३६-३७", "content_sanskrit": "उद्युक्ता ब्राह्मणी भीता प्रतियाता सुतैः सह।\nस्वदेहस्था जजापैवं सपुत्रा ध्यानतत्परा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2086087, "chapter_id": 2831, "verse_number": "१२-३३६-३८", "content_sanskrit": "अनन्तस्य हरेः शुद्धं नाम वै द्वादशाक्षरम्।\nवत्सरत्रितये पूर्णे ब्राह्मणी पुनरागता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2086088, "chapter_id": 2831, "verse_number": "१२-३३६-३९", "content_sanskrit": "सपुत्रा पुष्करद्वारं पिशाच्याह तथागतम्।\nनमस्ते ब्राह्मणि शुभे पूताऽहं तव दर्शनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2086089, "chapter_id": 2831, "verse_number": "१२-३३६-४०", "content_sanskrit": "कुरु तीर्थाभिषेकं च सपुत्रा पापवर्जिता।\nहरेर्नाम्ना च मां साध्वी जलेन स्प्रष्टुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2086090, "chapter_id": 2831, "verse_number": "१२-३३६-४१", "content_sanskrit": "इत्युक्ता ब्राह्मणी हृष्टा पुत्रैः सह शुभव्रता।\nजलेन प्रोक्षयामास द्वादशाक्षरसंयुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2086091, "chapter_id": 2831, "verse_number": "१२-३३६-४२", "content_sanskrit": "तत्क्षणादभवच्छुद्धा पिशाची दिव्यरूपिणी।\nअप्सरा ह्यभवद्दिव्या गता स्वर्लोकमुत्तभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2086092, "chapter_id": 2831, "verse_number": "१२-३३६-४३", "content_sanskrit": "ब्राह्मणी चैव कालेन वासुदेवपरायणा।\nसपुत्रा चागता स्थानमच्युतस्य शुभं परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2086093, "chapter_id": 2831, "verse_number": "१२-३३६-४४", "content_sanskrit": "एतत्ते कथितं विद्वन्मुने कालोऽयमागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2086094, "chapter_id": 2831, "verse_number": "१२-३३६-४५", "content_sanskrit": "गमिष्येऽहं महाप्राज्ञ आगमिष्यामि वै पुनः।\nइत्युक्त्वा स जगामाथ नारदो वदतांवरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2086095, "chapter_id": 2831, "verse_number": "१२-३३६-४६", "content_sanskrit": "द्वैपायनस्तु भगवांस्तच्छ्रुत्वा मुनिसत्तमात्।\nशुकेन सह पुत्रेण वेदाभ्यासमथाकरोत्।\nस्वरेणोच्चैः सशैक्ष्येण लोकानापूरयन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2086096, "chapter_id": 2831, "verse_number": "१२-३३६-४७", "content_sanskrit": "तयोरभ्यसतोरेव नानाधर्मप्रवादिनोः।\nवातोऽतिमात्रं प्रववौ समुद्रानिलवेजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2086097, "chapter_id": 2831, "verse_number": "१२-३३६-४८", "content_sanskrit": "ततोऽनध्याय इति तं व्यासः पुत्रमवारयत्।\nशुको वारितमात्रस्तु कौतूहलसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2086098, "chapter_id": 2831, "verse_number": "१२-३३६-४९", "content_sanskrit": "अपृच्छत्पितरं ब्रह्मन्कुतो वायुरभूदयम्।\nआख्यातुमर्हति भवान्वायोः सर्वं विचेष्टितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2086099, "chapter_id": 2831, "verse_number": "१२-३३६-५०", "content_sanskrit": "शुकस्यैतद्वचः श्रुत्वा व्यासः परमधर्मवित्।\nअनध्यायनिमित्तेऽस्मिन्निदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2086100, "chapter_id": 2831, "verse_number": "१२-३३६-५१", "content_sanskrit": "दिव्यं ते चक्षुरुत्पन्नं स्वस्थं ते निश्चलं मनः।\nतमसा रजसा चापि त्यक्तः सत्वे व्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2086101, "chapter_id": 2831, "verse_number": "१२-३३६-५२", "content_sanskrit": "आदर्शे रस्वामिव च्छायां पश्यस्यात्मानमात्मना।\nन्यस्यात्मनि स्वयं चेतो बुद्ध्या समनुचिन्तय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2086102, "chapter_id": 2831, "verse_number": "१२-३३६-५३", "content_sanskrit": "देवयानपथो विष्णुः पितृयानपथो रविः।\nद्वावेतौ प्रेत्य पन्थानौ दिवं चाधश्च गच्छतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2086103, "chapter_id": 2831, "verse_number": "१२-३३६-५४", "content_sanskrit": "पृथिव्यामन्तरिक्षे च यत्र संवान्ति वायवः।\nसप्तैते वायुमार्गा वै तान्निबोधानुपूर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2086104, "chapter_id": 2831, "verse_number": "१२-३३६-५५", "content_sanskrit": "तत्र देवगणाः साध्याः संबभूवुर्महाबलाः।\nतेषामप्यभवत्पुत्रः समानो नाम दुर्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2086105, "chapter_id": 2831, "verse_number": "१२-३३६-५६", "content_sanskrit": "उदानस्तस्य पुत्रोऽभूद्व्यानस्तस्याभवत्सुतः।\nअपानश्च ततो ज्ञेयः प्राणश्चापि तताऽपरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2086106, "chapter_id": 2831, "verse_number": "१२-३३६-५७", "content_sanskrit": "अनपत्योऽभवत्प्राणो दुर्घर्षः शत्रुतापनः।\nपृथक्कर्माणि तेषां तु प्रवक्ष्यामि यथातथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2086107, "chapter_id": 2831, "verse_number": "१२-३३६-५८", "content_sanskrit": "प्राणिनां सर्वतो वायुश्रेष्टां वर्तयते पृथक्।\nप्राणनाच्चैव भूतानां प्राण इत्यभिधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2086108, "chapter_id": 2831, "verse_number": "१२-३३६-५९", "content_sanskrit": "प्रेरयत्यभ्रसंघातान्धूमजांश्चोष्मजांश्च यः।\nप्रथमः प्रथमे मार्गे आवहो नाम योऽनिलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2086109, "chapter_id": 2831, "verse_number": "१२-३३६-६०", "content_sanskrit": "अम्बरे स्नेहमभ्रेभ्यस्तटिद्भ्यश्च महाद्युतिः।\nप्रवहो नाम संवाति द्वितीयश्च सतोयदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2086110, "chapter_id": 2831, "verse_number": "१२-३३६-६१", "content_sanskrit": "उदयं ज्योतिषां शश्वत्सोमादीनां करोति यः।\nअन्तर्देहेषु चोदानं यं वदन्ति मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2086111, "chapter_id": 2831, "verse_number": "१२-३३६-६२", "content_sanskrit": "यश्चतुर्भ्यः समुद्रेभ्यो वायुर्धारयते जलम्।\nउद्धृत्याददते चापो जीमूतेभ्योऽम्बरेऽनिलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2086112, "chapter_id": 2831, "verse_number": "१२-३३६-६३", "content_sanskrit": "योऽद्भिः संयोज्य जीमूतान्पर्जन्याय प्रयच्छति।\nउद्वहो नाम वर्षिष्ठस्तृतीयः स सदागतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2086113, "chapter_id": 2831, "verse_number": "१२-३३६-६४", "content_sanskrit": "समुह्यमाना बहुधा येन नीताः पृथग्घनाः।\nवर्षमोक्षकृतारम्भास्ते भवन्ति घनाघनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2086114, "chapter_id": 2831, "verse_number": "१२-३३६-६५", "content_sanskrit": "संहता येन चाविद्धा भवन्ति नदनान्तराः।\nरक्षणार्थाय संभूता मेघत्वमुपश्यान्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2086115, "chapter_id": 2831, "verse_number": "१२-३३६-६६", "content_sanskrit": "योऽसौ वहति देवानां विमानानि विहायसा।\nचतुर्थः संवहो नाम वायुः स गिरिमर्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2086116, "chapter_id": 2831, "verse_number": "१२-३३६-६७", "content_sanskrit": "येन वेगवता तूर्णं रूक्षेणारुजता रसान्।\nवायुना विहता मेघा न भवन्ति बलाहकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2086117, "chapter_id": 2831, "verse_number": "१२-३३६-६८", "content_sanskrit": "दारुणोत्पातसंचारो नभसः स्तनयित्नुमान्।\nपञ्चमः स महावेगो विवहो नाम मारुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2086118, "chapter_id": 2831, "verse_number": "१२-३३६-६९", "content_sanskrit": "यस्मिन्पारिप्लवा दिव्या भवन्त्यापो विहायसा।\nपुण्यं चाकाशगङ्गायास्तोयं विष्टभ्य तिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2086119, "chapter_id": 2831, "verse_number": "१२-३३६-७०", "content_sanskrit": "दूरात्प्रतिहतो यस्मिन्नेकरश्मिर्दिवाकरः।\nयो निरंशुः सहस्रस्य येन भाति वसुंधरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2086120, "chapter_id": 2831, "verse_number": "१२-३३६-७१", "content_sanskrit": "यस्मादाप्यायते सोमो योनिर्दिव्योऽमृतस्य यः।\nषष्ठः पिरवहो नाम स वायुर्जयतांवरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2086121, "chapter_id": 2831, "verse_number": "१२-३३६-७२", "content_sanskrit": "सर्वप्राणभृतां प्राणान्योऽनुकाले निरस्यति।\nयस्य वर्त्मानुवर्तेते मृत्युवैवस्वतावुभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2086122, "chapter_id": 2831, "verse_number": "१२-३३६-७३", "content_sanskrit": "सम्यगन्वीक्षतां बुद्ध्या शान्तयाऽध्यात्मचिन्तकाः।\nध्यानाभ्यासाभिरामाणां योऽमृतत्वाय कल्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2086123, "chapter_id": 2831, "verse_number": "१२-३३६-७४", "content_sanskrit": "यं समासाद्य वेगेन दिशामन्तं प्रपेदिरे।\nदक्षस्य दशपुत्राणां सहस्राणि प्रजापतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2086124, "chapter_id": 2831, "verse_number": "१२-३३६-७५", "content_sanskrit": "येन सृष्टः पराभूतो यात्येव न निवर्तते।\nपरावहो नाम परो वायुः स दुरतिक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2086125, "chapter_id": 2831, "verse_number": "१२-३३६-७६", "content_sanskrit": "एवमेतेऽदितेः पुत्रा मारुताः परमाद्भुताः।\nअनारतं ते संवान्ति सर्वगाः सर्वधारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2086126, "chapter_id": 2831, "verse_number": "१२-३३६-७७", "content_sanskrit": "एतत्तु महदाश्चर्यं यदयं पर्वतोत्तमः।\nकम्पितः सहसा तेन वायुनाऽतिप्रवायता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2086127, "chapter_id": 2831, "verse_number": "१२-३३६-७८", "content_sanskrit": "विष्णोर्निः श्वासवातोऽयं यदा वेगसमीरितः।\nसहसोदीर्यते तात जगत्प्रव्यथते तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2086128, "chapter_id": 2831, "verse_number": "१२-३३६-७९", "content_sanskrit": "तस्माद्ब्रह्मविदो ब्रह्म नाधीयन्तेऽतिवायति।\nवायोर्वायुभयं ह्युक्तं ब्रह्म तत्पीडितं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2086129, "chapter_id": 2831, "verse_number": "१२-३३६-८०", "content_sanskrit": "एतावदुक्त्वा वचनं पराशरसुतः प्रभुः।\nउक्त्वा पुत्रमधीष्वेति व्योमगङ्गामगात्तदा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2086130, "chapter_id": 2831, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि षट्त्रिंशदधिकत्रिशततमोऽध्यायः॥ ३३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}]