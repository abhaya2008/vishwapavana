[{"id": 2034993, "chapter_id": 1755, "verse_number": "४-७८-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2034994, "chapter_id": 1755, "verse_number": "४-७८-१", "content_sanskrit": "ततस्त्रयोदशे वर्षे निवृत्ते पञ्च पाण्डवाः।\nउपप्लाव्ये विराटस्य वासं चक्रुः पुरोत्तमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2034995, "chapter_id": 1755, "verse_number": "४-७८-२", "content_sanskrit": "दूतान्मित्रेषु सर्वेषु ज्ञातिसंबन्धिकेष्वपि।\nप्रेषयामास कौन्तेयो विराटश्च महीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2034996, "chapter_id": 1755, "verse_number": "४-७८-३", "content_sanskrit": "तेषु तत्रोपविष्टेषु प्रेषितेषु ततस्ततः ।\nतत्रागमन्महाबाहुर्वनमाली बलानुजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2034997, "chapter_id": 1755, "verse_number": "४-७८-४", "content_sanskrit": "तस्मिन्काले निशम्याथ दूतवाक्यं जनार्दनः।\nदयितं स्वस्त्रियं पुत्रं सुभद्रायाः सुमानितम्।\nअभिमन्युं समादाय रामेण सहितस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2034998, "chapter_id": 1755, "verse_number": "४-७८-५", "content_sanskrit": "सर्वयादवमुख्यैश्च संवृतः परवीरहा।\nशङ्खदुन्दुभिनिर्घोषैर्विराटनगरं ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2034999, "chapter_id": 1755, "verse_number": "४-७८-६", "content_sanskrit": "कृतवर्मा च हार्दिक्यो युयुधानश्च सात्यकिः।\nअनाधृष्टिस्तथाऽक्रूरः सांबो निशठ एव च।\nप्रद्युम्नश्च महाबाहुरुल्मुकश्च महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2035000, "chapter_id": 1755, "verse_number": "४-७८-७", "content_sanskrit": "अभिमन्युमुपादाय सह मात्रा परन्तपाः।\nकृष्णेन सहिताः सर्वे पाण्डवान्द्रष्टुमागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2035001, "chapter_id": 1755, "verse_number": "४-७८-८", "content_sanskrit": "इन्द्रसेनादयश्चैव रथैस्तैः सुसमाहितैः ।\nउपेयुः सहिताः सर्वे परिसंवत्सरोषिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2035002, "chapter_id": 1755, "verse_number": "४-७८-९", "content_sanskrit": "दशनागसहस्राणि हयानां द्विगुणं तथा।\nरथानां नियुतं पूर्णं निखर्वं च पदातयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2035003, "chapter_id": 1755, "verse_number": "४-७८-१०", "content_sanskrit": "वृष्ण्यन्धकाश्च शतशो भोजाश्च परमौजसः।\nअन्युर्वृष्णिशार्दूलं वासुदेवं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2035004, "chapter_id": 1755, "verse_number": "४-७८-११", "content_sanskrit": "वासुदेवं तथाऽऽयान्तं श्रुत्वा पाण्डुसुतास्तदा।\nमात्स्येन सहिताः सर्वे प्रत्युद्याता जनार्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2035005, "chapter_id": 1755, "verse_number": "४-७८-१२", "content_sanskrit": "शङ्खदुन्दुभिनिर्घोषैर्मङ्गलैश्च जनार्दनम् ।\nववन्दुर्मुदिताः सर्वे पादयोस्तस्य पाण्डवाः।\nमात्स्येन सहिताः सर्वे आनन्दाश्रुपरिप्लुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2035006, "chapter_id": 1755, "verse_number": "४-७८-१३x", "content_sanskrit": "पाण्डवा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2035007, "chapter_id": 1755, "verse_number": "४-७८-१३", "content_sanskrit": "तव कृष्ण प्रसादाद्वै वर्षाण्येतानि सर्वशः।\nत्रयोदशोपि दाशार्ह यथा स समयः कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2035008, "chapter_id": 1755, "verse_number": "४-७८-१४", "content_sanskrit": "उषिताः स्मो जगन्नाथ त्वं नाथो नो जनार्दन।\nरक्षस्व देवदेवेश त्वामार्य शरणं गताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2035009, "chapter_id": 1755, "verse_number": "४-७८-१५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2035010, "chapter_id": 1755, "verse_number": "४-७८-१५", "content_sanskrit": "तान्वन्दूमानान्सहसा परिष्वज्य जनार्दनः।\nविराटस्य सहायांस्तान्सर्वयादवसंवृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2035011, "chapter_id": 1755, "verse_number": "४-७८-१६", "content_sanskrit": "यथार्हं पूजयामास मुदा परमया युतः।\nवृष्णिवीराश्च तान्सर्वान्यथार्हं प्रतिपेदिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2035012, "chapter_id": 1755, "verse_number": "४-७८-१७", "content_sanskrit": "कृष्णा च देवकीपुत्रं ववन्दे पादयोस्तथा।\nतामुद्यम्य सुकेशान्तां नयने परिमृज्य च ।\nउवाच वाक्यं देवेशः सर्वयादवसन्निधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2035013, "chapter_id": 1755, "verse_number": "४-७८-१८", "content_sanskrit": "मा शोकं कुरु कल्याणि धार्तराष्ट्रान्समाहितान्।\nअचिराद्धातयित्वाऽहं पार्थेन सहितः क्षितिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2035014, "chapter_id": 1755, "verse_number": "४-७८-१९", "content_sanskrit": "युधिष्ठिराय दास्यामि यातु ते मानसो ज्वरः।\nअभिमन्युना च पार्थेनरौक्मिणेयेन ते शपे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2035015, "chapter_id": 1755, "verse_number": "४-७८-२०", "content_sanskrit": "सत्यमेतद्वचो मह्यमवैहि त्वमनिन्दिते।\nइत्युक्त्वा तां विसृज्याथ प्रीयमाणो युधिष्ठिरम्।\nअन्वास्त वृष्णिशार्दूलः सह वृष्ण्यन्धकैस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2035016, "chapter_id": 1755, "verse_number": "४-७८-२१", "content_sanskrit": "काशिराजश्च शैब्यश्च भजमानौ युधिष्ठिरम्।\nअक्षौहिणीभ्यां सहितावागतौ पृथिवीपती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2035017, "chapter_id": 1755, "verse_number": "४-७८-२२", "content_sanskrit": "अक्षौहिणीभिः पाञ्चालस्तिसृभिश्च महाबलः।\nद्रौपद्याश्च सुता वीराः शिखण्डी चापराजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2035018, "chapter_id": 1755, "verse_number": "४-७८-२३", "content_sanskrit": "धृष्टद्युम्नश्च दुर्धर्षः सर्वशस्त्रभृतांवरः।\nउपप्लाव्यं ययुः शीघ्रं पाण्डवार्थे महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2035019, "chapter_id": 1755, "verse_number": "४-७८-२४", "content_sanskrit": "ततः शतसहस्राणि प्रयुतान्यर्बुदानि च।\nसमीपमभिवर्तन्ते योधा यौधिष्ठिरं बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2035020, "chapter_id": 1755, "verse_number": "४-७८-२५", "content_sanskrit": "समुद्रमिव धर्मान्ते स्रोतःश्रेष्ठाः पृथक्पृथक्।\nआपूरयन्महीपाला यज्वानो भूरिदक्षिणैः ।\nवेदावभृथसंपन्नाः शूराः सर्वे तनुत्यजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2035021, "chapter_id": 1755, "verse_number": "४-७८-२६", "content_sanskrit": "तानागतानभिप्रेक्ष्य पार्थो ज्ञानभृतां वरः।\nपूजयामास विधिवद्यथार्हं राजसत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2035022, "chapter_id": 1755, "verse_number": "४-७८-२७", "content_sanskrit": "पारिबर्हं ददौ कृष्णः पाण्डवानां महात्मनाम्।\nस्त्रियो वासांसि रत्नानि पृथक्पृथगनेकशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2035023, "chapter_id": 1755, "verse_number": "४-७८-२८", "content_sanskrit": "राजानो राजपुत्राश्च निवृत्ते समये तथा।\nयथांर्ह पाण्डवश्रेष्ठैरवर्तन्ताभिपूजिताः।\nआसन्प्रहृष्टमनसः पारिबर्हं ददुस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2035024, "chapter_id": 1755, "verse_number": "४-७८-२९", "content_sanskrit": "सर्वेषु समवेतेषु राजभिर्वृष्णिभिः सह।\nविवाहो विधवद्राजन्ववृधे कुरुमात्स्ययोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2035025, "chapter_id": 1755, "verse_number": "४-७८-३०", "content_sanskrit": "ततः शङ्खा मृदङ्गाश्च गोमुखा डिण्डिमास्तदा।\nअभिमन्योर्विवाहे तु नेदुर्मात्स्यस्य वेश्मनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2035026, "chapter_id": 1755, "verse_number": "४-७८-३१", "content_sanskrit": "उच्चावचान्मृगाञ्जघ्नुर्मेध्यांश्च शतशस्तथा।\nभक्ष्यान्नभोज्यपानानि प्रभूतान्यभ्यहारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2035027, "chapter_id": 1755, "verse_number": "४-७८-३२", "content_sanskrit": "गायनाख्यानशीलाश्च नटा वैतालिकास्तथा।\nस्तुवन्तस्तानुपातिष्ठन्सूताश्च सह मागधैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2035028, "chapter_id": 1755, "verse_number": "४-७८-३३", "content_sanskrit": "स्त्रियो वृद्धास्तरुण्यश्च उत्सवे तस्य मङ्गले।\nद्रौपद्यन्तःपुरे चैव विराटस्य गृहे स्त्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2035029, "chapter_id": 1755, "verse_number": "४-७८-३४", "content_sanskrit": "सुदेष्णां तु पुरस्कृत्य मत्स्यानामपि च स्त्रियः।\nआजग्मुश्चारुपीनाङ्ग्यः सुमृष्टमणिकुण्डलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2035030, "chapter_id": 1755, "verse_number": "४-७८-३५", "content_sanskrit": "वर्णोपपन्नास्ता नार्यो रूपवन्तयः स्वलंकृताः।\nसर्वासामभवत्कृष्णा रूपेण वपुषाऽधिका ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2035031, "chapter_id": 1755, "verse_number": "४-७८-३६", "content_sanskrit": "परिवार्योत्तरां श्लाघ्यां राजपुत्रीमलंकृताम्।\nसुतामिव महेन्द्रस्य पुरस्कृत्योपतस्थिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2035032, "chapter_id": 1755, "verse_number": "४-७८-३७", "content_sanskrit": "भृङ्गारुं तु समादाय सौवर्णं जलपूरितम्।\nपार्थस्य हस्ते सहसा सुतामिन्दीवरेक्षणाम्।\nस्नुषार्थं प्राक्षिपद्वारि विराटो वाहिनीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2035033, "chapter_id": 1755, "verse_number": "४-७८-३८", "content_sanskrit": "तां प्रत्यगृह्णाकौन्तेयः सुतस्यार्थे महामनाः ।\nसौभद्राश्चानवद्याङ्गो विराटतनयां तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2035034, "chapter_id": 1755, "verse_number": "४-७८-३९", "content_sanskrit": "तत्रातिष्ठद्गृहीत्वा तु रूपमिन्द्रास्य धारयन्।\nस्नुषां तां परिगृह्णानः कुन्तीपुत्रो युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2035035, "chapter_id": 1755, "verse_number": "४-७८-४०", "content_sanskrit": "द्रुपदश्च विराटश्च शिखण्डी च महाबलः ।\nयुयुधानश्च शैब्यश्च धृष्टद्युम्नश्च सात्यकिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2035036, "chapter_id": 1755, "verse_number": "४-७८-४१", "content_sanskrit": "सप्तैतेऽक्षौहिणीपाला यज्वानो भूरिदक्षिणाः ।\nपाण्डवं परिवार्यैते निवेशं चक्रिरे तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2035037, "chapter_id": 1755, "verse_number": "४-७८-४२", "content_sanskrit": "तत्रस्थायां तु सेनायां मात्स्यो धर्मभृतांवरः ।\nप्रीतो दुहितरं गृह्य प्रददावभिमन्यवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2035038, "chapter_id": 1755, "verse_number": "४-७८-४३", "content_sanskrit": "प्रतिगृह्योत्तरां पार्थः पुरस्कृत्य जनार्दनम् ।\nविवाहं कारयामास सौभद्रस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2035039, "chapter_id": 1755, "verse_number": "४-७८-४४", "content_sanskrit": "ततो विवाहो ववृधे स्फीतः सर्वगुणान्वितः ।\nसौभद्रस्याद्भुतं कर्म पितुस्तव पितुस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2035040, "chapter_id": 1755, "verse_number": "४-७८-४५", "content_sanskrit": "धौम्यः शिष्यैः परिवृतो जुहावाग्नौ विधानतः ।\nअग्निं प्रदक्षिणीकुर्वन्सौभद्रः पाणिमग्रहीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2035041, "chapter_id": 1755, "verse_number": "४-७८-४६", "content_sanskrit": "ततः पार्थाय संहृष्टो मात्स्यराजो धनं महत्।\nतस्मै शतसहस्राणि हयानां वातरंहसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2035042, "chapter_id": 1755, "verse_number": "४-७८-४७", "content_sanskrit": "द्वे च नागशते मुख्ये धनं बहुविधं तदा।\nप्रादान्मात्स्यपतिर्हृष्टः कन्याधनमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2035043, "chapter_id": 1755, "verse_number": "४-७८-४८", "content_sanskrit": "पारिबर्हं च पार्थेभ्यः प्रददौ मत्स्यपुङ्गवः ।\nकृष्णेन सह कौन्तेयः प्रत्यगृह्णात्प्रभूतवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2035044, "chapter_id": 1755, "verse_number": "४-७८-४९", "content_sanskrit": "कृते विवाहे तु तदा धर्मपुत्रो युधिष्ठिरः।\nब्राह्मणेभ्यो ददौ वित्तं यदुपाहरदच्युतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2035045, "chapter_id": 1755, "verse_number": "४-७८-५०", "content_sanskrit": "गोसहस्राणि वस्त्राणि रत्नानि विविधानि च।\nभूषणानि च सर्वाणि यानानि शयनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2035046, "chapter_id": 1755, "verse_number": "४-७८-५१", "content_sanskrit": "नागरान्प्रीतिभिर्दिव्यैस्तर्पयामास भूपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2035047, "chapter_id": 1755, "verse_number": "४-७८-५२", "content_sanskrit": "तन्महोत्सवसंकाशं हृष्टपुष्टजनाकुलम्।\nनगरं मत्स्यराजस्य शुशुभे भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2035048, "chapter_id": 1755, "verse_number": "४-७८-५३", "content_sanskrit": "पुरोहितैरमात्यैश्च पौरैर्जानपदैः सह।\nविराटो नृपतिः श्रीमान्सौभद्रायाभिमन्यवे ।\nतां सुतामुत्तरां दत्त्वा मुमुदे परमं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2035049, "chapter_id": 1755, "verse_number": "४-७८-५४x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2035050, "chapter_id": 1755, "verse_number": "४-७८-५४", "content_sanskrit": "वृत्ते विवाहे हृष्टात्मा यदुवाच युधिष्ठिरः।\nतत्सर्वं कथयस्वेह कृतवन्तो यदुत्तरम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2035051, "chapter_id": 1755, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसाहस्त्रिकायां संहितायां वैयासिक्यां विराटपर्वणि वैवाहिकपर्वणि अष्टसप्ततितमोऽध्यायः ॥ ॥ वैवाहिकपर्व समाप्तम् ॥ ५ ॥ ॥ समाप्तं च विराटपर्व ॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]