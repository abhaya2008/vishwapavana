[{"id": 7004681000, "chapter_id": 24681, "verse_number": "६-१४३-१", "content_sanskrit": "सूत उवाच ।\nतथान्योऽपि च तत्रास्ति देवश्चित्रेश्वरो द्विजाः ।\nचित्रपीठस्य मध्यस्थश्चित्रसौख्यप्रदो नृणाम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004681001, "chapter_id": 24681, "verse_number": "६-१४३-२", "content_sanskrit": "यं दृष्ट्वा पूजयित्वा च स्नापयित्वाथवा नरः ।\nमुच्यते परदारोत्थैः पातकैश्चोपपातकैः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004681002, "chapter_id": 24681, "verse_number": "६-१४३-३", "content_sanskrit": "धर्षयित्वा गुरोः पत्नीं कन्यां वा निजवंशजाम् ।\nनीचां वा व्रतयुक्तां वा कामासक्तेन चेतसा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004681003, "chapter_id": 24681, "verse_number": "६-१४३-४", "content_sanskrit": "चैत्रशुक्लचतुर्दश्यां यस्तं पूजयते नरः ।\nस तत्पापं निहत्याशु स्वर्गलोकं ततो व्रजेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004681004, "chapter_id": 24681, "verse_number": "६-१४३-५", "content_sanskrit": "तथा चित्रांगदस्तत्र जाबालिसहितो नृपः ।\nकुमार्या सहितः सार्द्धं नग्नया तत्समुत्थया ।\nसन्तिष्ठते तदग्रे तु शप्तो जाबालिना पुरा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004681005, "chapter_id": 24681, "verse_number": "६-१४३-६", "content_sanskrit": "त्रयाणामपि यस्तेषां तस्मिन्नहनि निर्वपेत् ।\nस इष्टां लभते नारीं सिद्धिं च मनसि स्थिताम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004681006, "chapter_id": 24681, "verse_number": "६-१४३-७", "content_sanskrit": "ऋषय ऊचुः ।\nकस्माज्जाबालिना शप्तः पूर्वं चित्रांगदो युवा ।\nसा च तत्तनया कस्मात्कुमारी वस्त्रवर्जिता ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004681007, "chapter_id": 24681, "verse_number": "६-१४३-८", "content_sanskrit": "अद्यापि तिष्ठते तत्र विरुद्धं रूपमाश्रिता ।\nजनहास्य करं नित्यं तस्मात्सूत वदस्व नः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004681008, "chapter_id": 24681, "verse_number": "६-१४३-९", "content_sanskrit": "सूत उवाच ।\nआर्सोत्पूर्वं मुनिर्नाम्ना जाबालिरिति विश्रुतः ।\nकौमारब्रह्मचर्येण येन चीर्णं तपः सदा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004681009, "chapter_id": 24681, "verse_number": "६-१४३-१०", "content_sanskrit": "हाटकेश्वरजं क्षेत्रं समासाद्य स सद्द्विजाः ।\nबाल्येऽपि वयसि प्राप्ते समारेभे महत्तपः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004681010, "chapter_id": 24681, "verse_number": "६-१४३-११", "content_sanskrit": "कृच्छ्रचांद्रायणादीनि पाराकाणि शनैःशनैः ।\nकुर्वता तेन ते देवाः संनीता भयगोचरम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004681011, "chapter_id": 24681, "verse_number": "६-१४३-१२", "content_sanskrit": "ततः शक्रादयो देवाः संत्रस्ता मेरुमूर्धनि ।\nमिलित्वा चक्रिरे मंत्रं तस्य विघ्नकृते मिथः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004681012, "chapter_id": 24681, "verse_number": "६-१४३-१३", "content_sanskrit": "यद्यस्य तपसो वृद्धिरेवं यास्यति नित्यशः ।\nच्यावयिष्यति तन्नूनं स्वर्गराज्याच्छतक्रतुम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004681013, "chapter_id": 24681, "verse_number": "६-१४३-१४", "content_sanskrit": "तस्माद्गच्छतु रंभाख्या तत्पार्श्वे ऽप्सरसां वरा ।\nब्रह्मचर्यविघाताय तस्यर्षेर्भावितात्मनः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004681014, "chapter_id": 24681, "verse_number": "६-१४३-१५", "content_sanskrit": "ब्रह्मचर्यं तपोमूलं यतः संकीर्तितं द्विजैः ।\nतस्याभावात्परिक्लेशः केवलं न फलं व्रते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004681015, "chapter_id": 24681, "verse_number": "६-१४३-१६", "content_sanskrit": "एवं ते निश्चयं कृत्वा समाहूय ततः परम् ।\nरंभामूचुर्महेंद्रेण सर्वे देवास्तदादरात् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004681016, "chapter_id": 24681, "verse_number": "६-१४३-१७", "content_sanskrit": "गच्छ शीघ्रं महाभागे जाबालिर्यत्र तिष्ठति ।\nहाटकेश्वरजे क्षेत्रे तपोविघ्नाय तस्य वै ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004681017, "chapter_id": 24681, "verse_number": "६-१४३-१८", "content_sanskrit": "ते ते भावाः प्रयोक्तव्याः कथास्तास्ता मनोहराः ।\nवर्धयंती तथा चित्ते तस्य कामं निरर्गलम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004681018, "chapter_id": 24681, "verse_number": "६-१४३-१९", "content_sanskrit": "रंभोवाच ।\nस मुनिर्न विजानाति कामधर्मं सुरेश्वर ।\nअरसज्ञं कथं देव करिष्यामि स्मरान्वितम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004681019, "chapter_id": 24681, "verse_number": "६-१४३-२०", "content_sanskrit": "इन्द्र उवाच ।\nएष यास्यति मद्वाक्याद्वसंतस्तस्य सन्निधौ ।\nअस्य संदर्शनादेव भविष्यति स सस्मरः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004681020, "chapter_id": 24681, "verse_number": "६-१४३-२१", "content_sanskrit": "तस्माद्गच्छ द्रुतं तत्र सहानेन वरानने ।\nसंसिद्धिर्जायते येन देवकृत्यं भवेद्द्रुतम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004681021, "chapter_id": 24681, "verse_number": "६-१४३-२२", "content_sanskrit": "अथ सा तं प्रणम्योच्चैः प्रस्थिता धरणीतलम् ।\nवसंतेन समायुक्ता जाबालिर्यत्र तिष्ठति ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004681022, "chapter_id": 24681, "verse_number": "६-१४३-२३", "content_sanskrit": "अथाकस्मादशोकस्य संजातः पुष्पसंचयः ।\nतिलकस्य च चूतस्य मंजर्यः समुपस्थिताः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004681023, "chapter_id": 24681, "verse_number": "६-१४३-२४", "content_sanskrit": "शिशिरे च सरोजानि विकासं प्रापुरेव हि ।\nववौ च सुरभिर्वायुर्दाक्षिणात्यः सुकामदः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004681024, "chapter_id": 24681, "verse_number": "६-१४३-२५", "content_sanskrit": "एतस्मिन्नंतरे प्राप्ता रंभा तत्र वराप्सराः ।\nसलिलाशयतीरस्थो जाबालिर्यत्र तिष्ठति ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004681025, "chapter_id": 24681, "verse_number": "६-१४३-२६", "content_sanskrit": "अक्षमालाधृतकरो जपन्मंत्रमनेकधा ।\nअभीष्टं श्रद्धया युक्तो विधाय पितृतर्पणम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004681026, "chapter_id": 24681, "verse_number": "६-१४३-२७", "content_sanskrit": "अथ संपश्यतस्तस्य मुक्त्वा वस्त्रपरिग्रहम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004681027, "chapter_id": 24681, "verse_number": "६-१४३-२८", "content_sanskrit": "स्नानार्थं तज्जलं साऽथ प्रविवेश वराप्सराः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004681028, "chapter_id": 24681, "verse_number": "६-१४३-२९", "content_sanskrit": "विवस्त्रां तां समालोक्य सोऽपि यौवनशालिनीम् ।\nयाम्यानिलेन च स्पृष्टः कामस्य वशगो ऽभवत् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004681029, "chapter_id": 24681, "verse_number": "६-१४३-३०", "content_sanskrit": "ततस्तस्याभवत्कंपस्तत्क्षणादेव सन्मुने ।\nअक्षमाला कराग्राच्च पपात धरणीतले ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004681030, "chapter_id": 24681, "verse_number": "६-१४३-३१", "content_sanskrit": "पुलकः सर्वगात्रेषु संजज्ञेऽतीव दारुणः ।\nअश्रुपाताः पतंति स्म कोष्णाः प्लावितभूतलाः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004681031, "chapter_id": 24681, "verse_number": "६-१४३-३२", "content_sanskrit": "अथ तं क्षुभितं ज्ञात्वा चित्तज्ञा सा वराप्सराः ।\nनिर्गत्य सलिलात्तस्माच्चक्रे वस्त्रपरिग्रहम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004681032, "chapter_id": 24681, "verse_number": "६-१४३-३३", "content_sanskrit": "ततस्तस्यांतिके गत्वा प्रणिपत्य कृतादरा ।\nप्रोवाच मधुरं वाक्यं वर्द्धंती तस्य तन्मतम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004681033, "chapter_id": 24681, "verse_number": "६-१४३-३४", "content_sanskrit": "आश्रमे सकलं ब्रह्मन्कच्चित्ते कुशलं मुने ।\nस्वाध्याये तपसि प्राज्ञ शिष्येषु मृगपक्षिषु ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004681034, "chapter_id": 24681, "verse_number": "६-१४३-३५", "content_sanskrit": "मुनिरुवाच ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004681035, "chapter_id": 24681, "verse_number": "६-१४३-३६", "content_sanskrit": "कुशलं मे वरारोहे सर्वत्रैवाधुना स्थितम् ।\nविशेषेणात्र संप्राप्ता सर्वलक्षणलक्षिता ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004681036, "chapter_id": 24681, "verse_number": "६-१४३-३७", "content_sanskrit": "का त्वं वद महाभागे मम मन्मथवर्धनी ।\nकिं देवी वासुरी वा किं पन्नगी किं तु मानुषी ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004681037, "chapter_id": 24681, "verse_number": "६-१४३-३८", "content_sanskrit": "निवेदय शरीरे मे किं न पश्यसि वेपथुम् ।\nनिरर्गलश्च रोमांचो बाष्पपूरश्च नेत्रजः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004681038, "chapter_id": 24681, "verse_number": "६-१४३-३९", "content_sanskrit": "रंभोवाच ।\nकिं ते गात्रस्वभावोऽयम् किं वान्यो व्याधिसंभवः ।\nकच्चिदेव न ते स्वास्थ्यं प्रपश्यामि शरीरजम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004681039, "chapter_id": 24681, "verse_number": "६-१४३-४०", "content_sanskrit": "मुनिरुवाच ।\nन मे गात्रस्वभावो न व्याधिभिश्च सुलोचने ।\nशृणुष्व कारणं कृत्स्नं येनेदृक्संस्थितं वपुः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004681040, "chapter_id": 24681, "verse_number": "६-१४३-४१", "content_sanskrit": "यावती वर्तते वेला तव दर्शनसंभवा ।\nतावत्कालमिदं रूपं मम गात्रसमुद्भवम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004681041, "chapter_id": 24681, "verse_number": "६-१४३-४२", "content_sanskrit": "तदहं मन्मथाविष्टो दर्शनात्तव शोभने ।\nब्रह्मचर्यपरोपीत्थं महाव्रतधरोऽपि च ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004681042, "chapter_id": 24681, "verse_number": "६-१४३-४३", "content_sanskrit": "रंभोवाच॥यद्येवं ब्राह्मणश्रेष्ठ मां भजस्व यथासुखम् ।\nनात्र कश्चिद्भवेद्दोषः पण्यनारी यतोऽस्म्यहम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004681043, "chapter_id": 24681, "verse_number": "६-१४३-४४", "content_sanskrit": "साधारणा वयं विप्र यतः सृष्टाः स्वयंभुवा ।\nसर्वेषामेव लोकानां विशेषेण द्विजन्मनाम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004681044, "chapter_id": 24681, "verse_number": "६-१४३-४५", "content_sanskrit": "अहं चापि समालोक्य त्वां मुने मन्मथोपमम् ।\nहता कामशरैस्तीक्ष्णैर्न च गंतुं समुत्सहे ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004681045, "chapter_id": 24681, "verse_number": "६-१४३-४६", "content_sanskrit": "मया दृष्टाः सुराः पूर्वं यक्षा विद्याधरास्तथा ।\nसिद्धाश्च किंनरा नागा गुह्यकाः किमु मानुषाः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004681046, "chapter_id": 24681, "verse_number": "६-१४३-४७", "content_sanskrit": "नेदृग्रूपं वपुस्तेषामेकस्यापि विलोकितम् ।\nमध्ये ब्राह्मणशार्दूल तस्माद्भक्तां भजस्व माम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004681047, "chapter_id": 24681, "verse_number": "६-१४३-४८", "content_sanskrit": "यो नारीं कामसंतप्तां स्वयं प्राप्तां परित्यजेत् ।\nस मूर्खः पच्यते घोरे नरके शाश्वतीः समाः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004681048, "chapter_id": 24681, "verse_number": "६-१४३-४९", "content_sanskrit": "एवमुक्त्वा तया सोऽथ परिष्वक्तो महामुनिः ।\nअनिच्छन्नपि वाक्येन हृदयेन च सस्पृहः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004681049, "chapter_id": 24681, "verse_number": "६-१४३-५०", "content_sanskrit": "ततो लतानि कुंजे तं समानीय मुनीश्वरम् ।\nकामशास्त्रोदितैर्भावै रराम कृत्रिमैर्मुनिम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004681050, "chapter_id": 24681, "verse_number": "६-१४३-५१", "content_sanskrit": "एवं तया समं तत्र स्थितो यावद्दिनक्षयम् ।\nकामधर्मसमासक्तः संत्यक्ताशेषकर्मकः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004681051, "chapter_id": 24681, "verse_number": "६-१४३-५२", "content_sanskrit": "ततो निष्कामतां प्राप्तो लज्जया परिवारितः ।\nविससर्ज च तां रंभां शौचं चक्रे ततः परम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004681052, "chapter_id": 24681, "verse_number": "६-१४३-५३", "content_sanskrit": "सापि तेन विनिर्मुक्ता कृतकृत्या विलासिनी ।\nप्रहृष्टा प्रययौ तत्र यत्र देवाः सवासवाः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004681053, "chapter_id": 24681, "verse_number": "६-१४३-५४", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां सहितायां षष्ठे नागरखण्डे हाटकेश्वरक्षेत्रमाहात्म्ये जाबालिक्षोभणोनाम त्रिचत्वारिंशदुत्तरशततमोऽध्यायः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]