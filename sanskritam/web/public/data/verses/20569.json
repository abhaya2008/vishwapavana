[{"id": 7000569000, "chapter_id": 20569, "verse_number": "५-२८-१", "content_sanskrit": "शेष उवाच ।\nअथ पुत्रं समालोक्य पतितं व्यसुमुद्धतम् ।\nविललाप भृशं राजा सुतदुःखेन दुःखितः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000569001, "chapter_id": 20569, "verse_number": "५-२८-२", "content_sanskrit": "मूर्ध्नि संताडयामास पाणिभ्यामतिदुःखितः ।\nकम्पमानो भृशं चाश्रूण्यमुञ्चन्नयनाब्जयोः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000569002, "chapter_id": 20569, "verse_number": "५-२८-३", "content_sanskrit": "गृहीत्वा पतितं वक्त्रं चंद्रबिंबमनोरमम् ।\nपुष्कलेषु क्षतासृग्भिः क्लिन्नं कुंडलशोभितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000569003, "chapter_id": 20569, "verse_number": "५-२८-४", "content_sanskrit": "कुटिलभ्रूयुगं श्रेष्ठं संदष्टाधरपल्लवम् ।\nस चुंबन्मुखपद्मेन विलपन्निदमब्रवीत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000569004, "chapter_id": 20569, "verse_number": "५-२८-५", "content_sanskrit": "हा पुत्र वीर कथमुत्सुकचेतसं मां ।\nकिं नेक्षसे विशदनेत्रयुगेन शूर ।\nकिं मद्विनोदकथयारहितस्त्वमेव ।\nरोषोदधिप्लुतमनाः किल लक्ष्यसे च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000569005, "chapter_id": 20569, "verse_number": "५-२८-६", "content_sanskrit": "वद पुत्र कथं मां त्वं प्रब्रूषे न हसन्पुनः ।\nअमृतैर्मधुरास्वादैर्विनोदयसि पुत्रक ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000569006, "chapter_id": 20569, "verse_number": "५-२८-७", "content_sanskrit": "शत्रुघ्नाश्वं गृहाण त्वं सितचामरशोभितम् ।\nस्वर्णपत्रेण शोभाढ्यं त्यज निद्रां महामते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000569007, "chapter_id": 20569, "verse_number": "५-२८-८", "content_sanskrit": "एष प्रतापविशदः प्रतापाग्र्यः परंतपः ।\nधनुर्बिभ्रत्पुरो भाति पुष्कलः परवीरहा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000569008, "chapter_id": 20569, "verse_number": "५-२८-९", "content_sanskrit": "एनं वारय सत्तीक्ष्णैर्बाणैः कोदंडनिर्गतैः ।\nकथं त्वं रणमध्ये वै शेते वीरविमोहितः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000569009, "chapter_id": 20569, "verse_number": "५-२८-१०", "content_sanskrit": "हस्तिनः पत्तयश्चैव रथारूढा भयार्दिताः ।\nशरणं त्वां समायांति तानीक्षस्व महामते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000569010, "chapter_id": 20569, "verse_number": "५-२८-११", "content_sanskrit": "पुत्र त्वया विना सोढुं कथं शक्तो रणांगणे ।\nशत्रुघ्नसायकांस्तीक्ष्णांश्चंडकोदंडनिर्गतान् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000569011, "chapter_id": 20569, "verse_number": "५-२८-१२", "content_sanskrit": "अतो मां तु त्वया हीनं को वा पालयितुं क्षमः ।\nयदि त्यक्ष्यसि निद्रा त्वं जयायाहं क्षमस्तदा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000569012, "chapter_id": 20569, "verse_number": "५-२८-१३", "content_sanskrit": "इत्थं विलप्य सुभृशं तताड हृदयं स्वकम् ।\nबहुशः पाणिना राजा पुत्रदुःखेन दुःखितः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000569013, "chapter_id": 20569, "verse_number": "५-२८-१४", "content_sanskrit": "तदा विचित्र दमनौ स्व स्व स्यंदनसंस्थितौ ।\nपितुश्चरणयोर्नत्वा ऊचतुः समयोचितम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000569014, "chapter_id": 20569, "verse_number": "५-२८-१५", "content_sanskrit": "राजन्नस्मासु जीवत्सु किं दुःखं हृदि तद्वद ।\nवीराणां प्रधने मृत्युर्वांच्छितो जायते महान् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000569015, "chapter_id": 20569, "verse_number": "५-२८-१६", "content_sanskrit": "धन्योऽयं बत चित्रांगो यो वीर भुवि शोभते ।\nसकिरीटस्तु संदष्टदंतच्छदयुगः प्रभुः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000569016, "chapter_id": 20569, "verse_number": "५-२८-१७", "content_sanskrit": "कथयाशु किमद्यैव कुर्वस्ते कार्यमीप्सितम् ।\nशत्रुघ्नवाहिनीं सर्वां हन्व आवामनाथिनीम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000569017, "chapter_id": 20569, "verse_number": "५-२८-१८", "content_sanskrit": "अद्यैव पुष्कलं भ्रातुर्वधकारिणमाहवे ।\nपातयावो रथाच्छित्त्वा शिरोमुकुटमंडितम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000569018, "chapter_id": 20569, "verse_number": "५-२८-१९", "content_sanskrit": "त्यज शोकं सुदुःखार्तः कथं भासि महामते ।\nआज्ञापयावां मानार्ह कुरु युद्धे मतिं तथा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000569019, "chapter_id": 20569, "verse_number": "५-२८-२०", "content_sanskrit": "इति वाक्यं समाकर्ण्य पुत्रयोर्वीरमानिनोः ।\nशोकं त्यक्त्वा महाराजो युद्धाय मतिमादधात् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000569020, "chapter_id": 20569, "verse_number": "५-२८-२१", "content_sanskrit": "तावपि प्रतियोद्धारं वांच्छंतौ रणदुर्मदौ ।\nजग्मतुः कटके शत्रोरनंतभटपूरिते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000569021, "chapter_id": 20569, "verse_number": "५-२८-२२", "content_sanskrit": "रिपुतापेन दमनो नीलरत्नेन चेतरः ।\nयुयुधाते रणे वीरौ प्रावृषीव बलाहकौ ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000569022, "chapter_id": 20569, "verse_number": "५-२८-२३", "content_sanskrit": "राजा कनकसन्नद्धे रथे मणिविचित्रिते ।\nरत्नकूबरशोभाढ्ये तिष्ठंश्चापधरो बली ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000569023, "chapter_id": 20569, "verse_number": "५-२८-२४", "content_sanskrit": "ययौ योद्धुं तु शत्रुघ्नं वीरकोटभिरावृतम् ।\nतृणीकुर्वन्महावीरान्धनुर्विद्याविशारदान् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000569024, "chapter_id": 20569, "verse_number": "५-२८-२५", "content_sanskrit": "तं योद्धुमागतं दृष्ट्वा सुबाहुं रोषपूरितम् ।\nपुत्रनाशेन कुर्वंतं सर्वसैन्यवधादिकम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000569025, "chapter_id": 20569, "verse_number": "५-२८-२६", "content_sanskrit": "शत्रुघ्नपार्श्वसंचारी हनूमांस्तमुपाद्रवत् ।\nनखायुधो महानादं कुर्वन्मेघ इवाहवे ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000569026, "chapter_id": 20569, "verse_number": "५-२८-२७", "content_sanskrit": "सुबाहुस्तं हनूमंतमागच्छंतं महारवम् ।\nउवाच प्रहसन्वाक्यं रोषपूरितलोचनः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000569027, "chapter_id": 20569, "verse_number": "५-२८-२८", "content_sanskrit": "क्व गतः पुष्कलो हत्वा मत्पुत्रं रणमंडले ।\nपातयाम्यद्य तस्याशु शिरो ज्वलितकुंडलम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000569028, "chapter_id": 20569, "verse_number": "५-२८-२९", "content_sanskrit": "क्व शत्रुघ्नो वाहपालः क्व च रामः कुतो भटाः ।\nप्राणहंतारमायांतं पश्यंतु प्रधने तु माम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000569029, "chapter_id": 20569, "verse_number": "५-२८-३०", "content_sanskrit": "इति तद्वाक्यमाकर्ण्य हनूमान्निजगाद तम् ।\nशत्रुघ्नो लवणच्छेत्ता वर्तते सैन्यपालकः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000569030, "chapter_id": 20569, "verse_number": "५-२८-३१", "content_sanskrit": "स कथं प्रधने युध्येत्सेवकेऽग्रे स्थिते नृप ।\nमां विजित्य रणे तं च त्वं गंतासि नरर्षभ ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000569031, "chapter_id": 20569, "verse_number": "५-२८-३२", "content_sanskrit": "इत्युक्तवंतं तरसा विव्याध दशसायकैः ।\nहृदि वानरमत्युग्रं पर्वताग्र्यमिवस्थितम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000569032, "chapter_id": 20569, "verse_number": "५-२८-३३", "content_sanskrit": "सबाणानागतांस्तांश्च गृहीत्वा करसंपुटे ।\nचूर्णयामास तिलशः शितान्वैरिविदारणान् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000569033, "chapter_id": 20569, "verse_number": "५-२८-३४", "content_sanskrit": "चूर्णयित्वा शरांस्तांस्तु निनदन्घनगर्जितैः ।\nपुच्छेनावेष्ट्य तस्योच्चै रथं निन्ये महाबलः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000569034, "chapter_id": 20569, "verse_number": "५-२८-३५", "content_sanskrit": "तदा तं नृपवर्योऽसावाकाशे स्थित एव सः ।\nलांगूलं ताडयामास शिताग्रैः सायकैर्मुहुः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000569035, "chapter_id": 20569, "verse_number": "५-२८-३६", "content_sanskrit": "स ताडितस्तु पुच्छाग्रे शरैः सन्नतपर्वभिः ।\nमुमोच तद्रथं दिव्यं कनकेन विचित्रितम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000569036, "chapter_id": 20569, "verse_number": "५-२८-३७", "content_sanskrit": "स मुक्तस्तेन तरसा शरैस्तीक्ष्णैर्जघान तम् ।\nहनूमंतं कपिवरं रोषसंपूरितेक्षणः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000569037, "chapter_id": 20569, "verse_number": "५-२८-३८", "content_sanskrit": "हनूमान्बाणविच्छिन्नः सर्वत्ररुधिराप्लुतः ।\nमहारोषं समाधत्त नृपोपरि कपीश्वरः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000569038, "chapter_id": 20569, "verse_number": "५-२८-३९", "content_sanskrit": "गृहीत्वा तस्य दंष्ट्राभी रथं हयसमन्वितम् ।\nचूर्णयामस वेगेन तदद्भुतमिवाभवत् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000569039, "chapter_id": 20569, "verse_number": "५-२८-४०", "content_sanskrit": "स्वरथं भज्यमानं तु दृष्ट्वा राजा त्वरन्बली ।\nअन्यं रथं समास्थाय युयुधे तं महाबलम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000569040, "chapter_id": 20569, "verse_number": "५-२८-४१", "content_sanskrit": "पुच्छे मुखेऽथोरसि च भुजे चरणयोर्नृपः ।\nजघान शरसंधानकोविदः परमास्त्रवित् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000569041, "chapter_id": 20569, "verse_number": "५-२८-४२", "content_sanskrit": "तदा क्रुद्धः कपिवरस्ताडयामास वक्षसि ।\nपादेनोत्प्लुत्य वेगेन राज्ञः सुभटशोभिनः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000569042, "chapter_id": 20569, "verse_number": "५-२८-४३", "content_sanskrit": "स पदा प्रहतो भूमौ पपात किल मूर्च्छितः ।\nमुखाद्वमन्नसृक्चोष्णं श्वासपूरप्रवेपितः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000569043, "chapter_id": 20569, "verse_number": "५-२८-४४", "content_sanskrit": "तदा प्रकुपितोऽत्यंतं हनूमान्प्रधनांगणे ।\nअश्वान्वीरान्गजांश्चापि चूर्णयामास वेगतः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000569044, "chapter_id": 20569, "verse_number": "५-२८-४५", "content_sanskrit": "तदा सुकेतुस्तद्भ्राता तथा लक्ष्मीनिधिर्नृपः ।\nउभावपि सुसन्नद्धौ युद्धाय समुपस्थितौ ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000569045, "chapter_id": 20569, "verse_number": "५-२८-४६", "content_sanskrit": "राजानं मूर्च्छितं दृष्ट्वा प्रपलाय्य गता नराः ।\nइतस्ततो बाणसंघैः क्षताः पुष्कलवर्षितैः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000569046, "chapter_id": 20569, "verse_number": "५-२८-४७", "content_sanskrit": "तद्भज्यमानं स्वबलं वीक्ष्य राजात्मजो बली ।\nदमनः स्तंभयामास सेतुर्वार्धिमिवोच्चलम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000569047, "chapter_id": 20569, "verse_number": "५-२८-४८", "content_sanskrit": "तदा तु मूर्च्छितो राजा स्वप्नमेकं ददर्श ह ।\nरणमध्ये कपिवरप्रपदाघातताडितः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000569048, "chapter_id": 20569, "verse_number": "५-२८-४९", "content_sanskrit": "रामचंद्रस्त्वयोध्यायां सरयूतीरमंडपे ।\nब्राह्मणैर्याज्ञिकश्रेष्ठैर्बहुभिः परिवारितः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000569049, "chapter_id": 20569, "verse_number": "५-२८-५०", "content_sanskrit": "तत्र ब्रह्मादयो देवास्तत्र ब्रह्मांडकोटयः ।\nकृतप्राञ्जलयस्तं वै स्तुवंति स्तुतिभिर्मुहुः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000569050, "chapter_id": 20569, "verse_number": "५-२८-५१", "content_sanskrit": "रामं श्यामं सुनयनं मृगशृंगपरिग्रहम् ।\nगायंति नारदाद्याश्च वीणोल्लसितपाणयः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000569051, "chapter_id": 20569, "verse_number": "५-२८-५२", "content_sanskrit": "नृत्यंत्यप्सरसस्तत्र घृताची मेनकादयः ।\nवेदा मूर्तिधरा भूत्वा उपतिष्ठंति राघवम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000569052, "chapter_id": 20569, "verse_number": "५-२८-५३", "content_sanskrit": "यच्च किंचिद्वस्तुजातं सर्वशोभासमन्वितम् ।\nतस्य दातारमखिलं भक्तानां भोगदायकम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000569053, "chapter_id": 20569, "verse_number": "५-२८-५४", "content_sanskrit": "इत्येवमादिसंपश्यञ्जाग्रत्संज्ञामवाप सः ।\nब्रह्मशापहतज्ञानः किं दृष्टमिति वै वदन् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000569054, "chapter_id": 20569, "verse_number": "५-२८-५५", "content_sanskrit": "उत्थाय प्रययौ पद्भ्यां शत्रुघ्नचरणं प्रति ।\nभृत्यकोटिपरीवारो रथकोटिपरीवृतः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000569055, "chapter_id": 20569, "verse_number": "५-२८-५६", "content_sanskrit": "सुकेतुं तु समाहूय विचित्रं दमनं तथा ।\nयुद्धं कर्तुं समुद्युक्तान्वारयामास धर्मवित् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000569056, "chapter_id": 20569, "verse_number": "५-२८-५७", "content_sanskrit": "उवाच तान्महाराजो धर्मात्मा धर्मसंयुतः ।\nभ्रातःपुत्रौ शृणुत मे वाक्यं धर्मसमन्वितम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000569057, "chapter_id": 20569, "verse_number": "५-२८-५८", "content_sanskrit": "मा युद्धं कुरुत क्षिप्रमनयस्तु महानभूत् ।\nयद्रामचंद्रवाहं त्वमगृह्णाद्दमनोर्ज्जितम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000569058, "chapter_id": 20569, "verse_number": "५-२८-५९", "content_sanskrit": "एष रामः परंब्रह्म कार्यकारणतः परम् ।\nचराचरजगत्स्वामी न मानुषवपुर्धरः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000569059, "chapter_id": 20569, "verse_number": "५-२८-६०", "content_sanskrit": "एतद्धि ब्रह्मविज्ञानमधुना ज्ञातवानहम् ।\nपुरासितांगशापेन हृतज्ञानधनोऽनघाः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000569060, "chapter_id": 20569, "verse_number": "५-२८-६१", "content_sanskrit": "अहं पुरा तीर्थयात्रां गतस्तत्त्वविवित्सया ।\nतत्रानेके मया दृष्टा मुनयो धर्मवित्तमाः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000569061, "chapter_id": 20569, "verse_number": "५-२८-६२", "content_sanskrit": "असितांगं मुनिमहं गतवाञ्ज्ञातुमिच्छया ।\nतदा प्रोवाच मां विप्रः कृपां कृत्वा ममोपरि ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000569062, "chapter_id": 20569, "verse_number": "५-२८-६३", "content_sanskrit": "योऽसावयोध्याधिपतिः स परब्रह्मशब्दितः ।\nतस्य या जानकी देवी साक्षात्सा चिन्मयी स्मृता ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000569063, "chapter_id": 20569, "verse_number": "५-२८-६४", "content_sanskrit": "एनं तु योगिनः साक्षादुपासते यमादिभिः ।\nदुस्तरा पारसंसारवारिधिं संतितीर्षवः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000569064, "chapter_id": 20569, "verse_number": "५-२८-६५", "content_sanskrit": "स्मृतमात्रो महापापहारी स गरुडध्वजः ।\nय एनं सेवते विद्वान्स संसारं तरिष्यति ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000569065, "chapter_id": 20569, "verse_number": "५-२८-६६", "content_sanskrit": "तदाहमहसं विप्रं कोऽयं रामस्तु मानुषः ।\nकेयं सा जानकी देवी हर्षशोकसमाकुला ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000569066, "chapter_id": 20569, "verse_number": "५-२८-६७", "content_sanskrit": "अजन्मनः कथं जन्म अकर्तुः कृत्यमत्र किम् ।\nजन्मदुःखजरातीतं कथयस्व मुने मम ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000569067, "chapter_id": 20569, "verse_number": "५-२८-६८", "content_sanskrit": "इत्युक्तवंतं मां क्रुद्धः शशाप स मुनीश्वरः ।\nअज्ञात्वा तत्स्वरूपं त्वं प्रतिब्रूषे ममाधम ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000569068, "chapter_id": 20569, "verse_number": "५-२८-६९", "content_sanskrit": "एनं निंदसि रामं त्वं मानुषोऽयमिदं हसन् ।\nतस्मात्त्वं तत्त्वसंमूढो भविष्यस्युदरंभरिः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000569069, "chapter_id": 20569, "verse_number": "५-२८-७०", "content_sanskrit": "तदाहं तस्य चरणावगृह्णं सदया युतः ।\nदृष्ट्वा मे विनयं मां तु प्रावोचत्करुणानिधिः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000569070, "chapter_id": 20569, "verse_number": "५-२८-७१", "content_sanskrit": "त्वं रामस्य मखे विघ्नं करिष्यसि यदा नृप ।\nतदा हनूमानंघ्रिं त्वां ताडयिष्यति वेगतः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000569071, "chapter_id": 20569, "verse_number": "५-२८-७२", "content_sanskrit": "तदा त्वं ज्ञास्यसे राजन्नान्यथा स्वमनीषया ।\nपुराहमुक्तस्तेनैवं तद्दृष्टमधुना मया ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000569072, "chapter_id": 20569, "verse_number": "५-२८-७३", "content_sanskrit": "यदा मां हनुमान्क्रुद्धस्ताडयामास वक्षसि ।\nतदाऽदर्शं रमानाथं पूर्णब्रह्मस्वरूपिणम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000569073, "chapter_id": 20569, "verse_number": "५-२८-७४", "content_sanskrit": "तस्मादश्वं तु शोभाढ्यमानयंतु महाबलाः ।\nधनानि चैव वासांसि राज्यं चेदं समर्पये ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000569074, "chapter_id": 20569, "verse_number": "५-२८-७५", "content_sanskrit": "रामं दृष्ट्वा कृतार्थः स्यामहं यज्ञेति पुण्यदे ।\nआनयंतु हयं मह्यं रोचते तु तदर्पणम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}]