[{"id": 2207763, "chapter_id": 5431, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2207764, "chapter_id": 5431, "verse_number": "१", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nनारदस्य च संवादमृषेर्देवतमस्य च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2207765, "chapter_id": 5431, "verse_number": "", "content_sanskrit": "देवतमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2207766, "chapter_id": 5431, "verse_number": "२", "content_sanskrit": "जन्तोः सञ्जायमानस्य किं नु पूर्वं प्रवर्तते ।\nप्राणोऽपानः समानो वा व्यानो वोदान एव च ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2207767, "chapter_id": 5431, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2207768, "chapter_id": 5431, "verse_number": "३", "content_sanskrit": "येनायं सृज्यते जन्तुस्ततोऽन्यः पूर्वमेति तम् ।\nप्राणद्वन्द्वं च विज्ञेयं तिर्यगूर्ध्वं गतं च यत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2207769, "chapter_id": 5431, "verse_number": "", "content_sanskrit": "देवतमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2207770, "chapter_id": 5431, "verse_number": "४", "content_sanskrit": "केनायं सृज्यते जन्तुः कश्चान्यः पूर्वमेति तम् ।\nप्राणद्वन्द्वं च मे ब्रूहि तिर्यगूर्ध्वं च निश्चयात् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2207771, "chapter_id": 5431, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2207772, "chapter_id": 5431, "verse_number": "५", "content_sanskrit": "सङ्कल्पाज्जायते हर्षः शब्दादपि च जायते ।\nरसात् सञ्जायते चापि रूपादपि च जायते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2207773, "chapter_id": 5431, "verse_number": "६", "content_sanskrit": "स्पर्शात् सञ्जायते चापि गन्धादपि च जायते ।\nएतद्रूपमुदानस्य हर्षो मिथुनमन्तरा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2207774, "chapter_id": 5431, "verse_number": "७", "content_sanskrit": "कामात् सञ्जायते शुक्लः कामात् सञ्जायते रजः ।\nसमानव्यानजनिते समाने शुक्लशोणिते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2207775, "chapter_id": 5431, "verse_number": "८", "content_sanskrit": "शुक्लाच्छोणितसंसृष्टात् पूर्वं प्राणः प्रवर्तते ।\nप्राणेन विकृते शुक्ले ततोऽपानः प्रवर्तते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2207776, "chapter_id": 5431, "verse_number": "९", "content_sanskrit": "शुक्लात् सञ्जायते चापि रसादपि च जायते ।\nप्राणापानाविमौ द्वन्द्वमर्वाक् चोर्ध्वं च गच्छतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2207777, "chapter_id": 5431, "verse_number": "१०", "content_sanskrit": "व्यानः समानश्चैवोभौ वह्निश्चैव प्रवर्तते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2207778, "chapter_id": 5431, "verse_number": "११", "content_sanskrit": "अग्निर्वै देवताः सर्वा इति देवस्य शासनात् ।\nसञ्जायते हि प्राणेषु ज्ञानं बुद्धिसमन्वितम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2207779, "chapter_id": 5431, "verse_number": "१२", "content_sanskrit": "तस्य धूमः तमो रूपं रजो भस्म सुरेतसः ।\nसत्त्वं सञ्जायते तस्य यत्र प्रक्षिप्यते हविः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2207780, "chapter_id": 5431, "verse_number": "१३", "content_sanskrit": "हविः समानो व्यानश्च इति यज्ञविदो विदुः ।\nप्राणापानवाज्यभागौ तयोर्मध्ये हुताशनः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2207781, "chapter_id": 5431, "verse_number": "१४", "content_sanskrit": "एतद् रूपमुदानस्य परमं ब्राह्मणा विदुः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2207782, "chapter_id": 5431, "verse_number": "१५", "content_sanskrit": "निर्द्वन्द्वमिति यत्त्वेतत् तन्मे निगदतः शृणु ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2207783, "chapter_id": 5431, "verse_number": "१६", "content_sanskrit": "अहोरात्रमिदं द्वन्द्वं तयोर्मध्ये हुताशनः ।\nएतद् रूपमुदानस्य परमं ब्राह्मणा विदुः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2207784, "chapter_id": 5431, "verse_number": "१७", "content_sanskrit": "उभे चैवायने द्वन्द्वं तयोर्मध्ये हुताशनः ।\nएतद् रूपमुदानस्य परमं ब्राह्मणा विदुः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2207785, "chapter_id": 5431, "verse_number": "१८", "content_sanskrit": "उभे सत्यानृते द्वन्द्वं तयोर्मध्ये हुताशनः ।\nएतद् रूपमुदानस्य परमं ब्राह्मणा विदुः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2207786, "chapter_id": 5431, "verse_number": "१९", "content_sanskrit": "उभे शुभाशुभे द्वन्द्वं तयोर्मध्ये हुताशनः ।\nएतद् रूपमुदानस्य परमं ब्राह्मणा विदुः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2207787, "chapter_id": 5431, "verse_number": "२०", "content_sanskrit": "सच्चासच्चैव तद् द्वन्द्वं तयोर्मध्ये हुताशनः ।\nएतद् रूपमुदानस्य परमं ब्राह्मणा विदुः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2207788, "chapter_id": 5431, "verse_number": "२१", "content_sanskrit": "पूर्वं समानो व्यानोऽथ व्यस्यते किं न कर्मकृत् ।\nतृतीयं तु समानेन पुनरेव व्यवस्यते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2207789, "chapter_id": 5431, "verse_number": "२२", "content_sanskrit": "शान्त्यर्थं वामदेवश्च शान्तिर्ब्रह्म सनातनम् ।\nएतद् रूपमुदानस्य परमं ब्राह्मणा विदुः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2207790, "chapter_id": 5431, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि अनुगीतासु नारददेवतमसंवादो नाम पञ्चविंशोऽध्यायः ॥२५॥\nअनुगीतापर्वणि दशमोऽध्यायः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2207791, "chapter_id": 5431, "verse_number": "", "content_sanskrit": "––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]