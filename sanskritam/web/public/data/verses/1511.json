[{"id": 2023899, "chapter_id": 1511, "verse_number": "३-१४९-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2023900, "chapter_id": 1511, "verse_number": "३-१४९-१", "content_sanskrit": "एतच्छ्रुत्वा वचस्तस्य वानरेन्द्रस्य धीमतः।\nभीमसेनस्तदा वीरः प्रोवाचामितविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2023901, "chapter_id": 1511, "verse_number": "३-१४९-२x", "content_sanskrit": "भीम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2023902, "chapter_id": 1511, "verse_number": "३-१४९-२", "content_sanskrit": "को भवान्किंनिमित्तं वा वानरं वपुराश्रितः।\nब्राह्मणानन्तरो वर्णः क्षत्रियस्त्वाऽनुपृच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2023903, "chapter_id": 1511, "verse_number": "३-१४९-३", "content_sanskrit": "कौरवः सोमवंशीयः कुन्त्या गर्भेण धारितः।\nपाण्डवो वायुतनयो भीमसेन इति श्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2023904, "chapter_id": 1511, "verse_number": "३-१४९-४", "content_sanskrit": "स वाक्यं भीमसेनस्य स्मितेन प्रतिगृह्य तत्।\nहनुमान्वायुतनयो वायुपुत्रमभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2023905, "chapter_id": 1511, "verse_number": "३-१४९-५", "content_sanskrit": "वानरोऽहं न ते मार्गं प्रदास्यामि यथोप्सितम्।\nसाधु गच्छ निवर्तस्व मा त्वं प्राप्स्यसि वैशसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2023906, "chapter_id": 1511, "verse_number": "३-१४९-६x", "content_sanskrit": "भीमसेन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2023907, "chapter_id": 1511, "verse_number": "३-१४९-६", "content_sanskrit": "वैशसं वाऽस्तु यद्वान्यन्न त्वां रपृच्चामि वानर।\nप्रयच्छ मार्गमुत्तिष्ठ मा मत्तः प्राप्स्यसे व्यथाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2023908, "chapter_id": 1511, "verse_number": "३-१४९-७x", "content_sanskrit": "हनूमानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2023909, "chapter_id": 1511, "verse_number": "३-१४९-७", "content_sanskrit": "नास्ति शक्तिर्ममोत्थातुं जरया क्लेशितो ह्यहम्।\nयद्यवश्यं प्रयातव्यं लङ्घयित्वा प्रयाहि माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2023910, "chapter_id": 1511, "verse_number": "३-१४९-८x", "content_sanskrit": "भीम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2023911, "chapter_id": 1511, "verse_number": "३-१४९-८", "content_sanskrit": "निर्गुणः परमात्मा तु देहं ते व्याप्य तिष्ठते।\nतमहं ज्ञानविज्ञेयं नावमन्ये न लङ्घये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2023912, "chapter_id": 1511, "verse_number": "३-१४९-९", "content_sanskrit": "यद्यागमैर्न विद्यां च तमहं भूतभावनम्।\nक्रमेयं त्वां गिरिं चैव हनीमानिव सागरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2023913, "chapter_id": 1511, "verse_number": "३-१४९-१०x", "content_sanskrit": "हनूमानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2023914, "chapter_id": 1511, "verse_number": "३-१४९-१०", "content_sanskrit": "क एष हनुमान्नाम सागरो येन लङ्घितः।\nपृच्चामि त्वां नरश्रेष्ठ कथ्यतां यदि शक्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2023915, "chapter_id": 1511, "verse_number": "३-१४९-११x", "content_sanskrit": "भीम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2023916, "chapter_id": 1511, "verse_number": "३-१४९-११", "content_sanskrit": "भ्राता मम गुणश्लाघ्यो बुद्धिसत्वबलान्वितः।\nरामायणेऽतिविख्यातः श्रीमान्वानरपुङ्गवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2023917, "chapter_id": 1511, "verse_number": "३-१४९-१२", "content_sanskrit": "रामपत्नीकृते येन शतयोजनविस्तृतः।\nसागरः प्लवगेन्द्रेण क्रमेणैकेन लङ्घितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2023918, "chapter_id": 1511, "verse_number": "३-१४९-१३", "content_sanskrit": "स मे भ्राता महावीर्यस्तुल्योऽहं तस् तेजसा।\nबले पराक्रमे युद्धे शक्तोऽहं तव निग्रहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2023919, "chapter_id": 1511, "verse_number": "३-१४९-१४", "content_sanskrit": "`इमं देशमनुप्राप्तः कारणेनास्मि केनचित्।\nउत्तिष्ठ देहि मे मार्गं पश्य मे चाद्य पौरुषम्।\nमच्छासनमकुर्वाणं त्वां वा नेष्ये यमक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2023920, "chapter_id": 1511, "verse_number": "३-१४९-१५x", "content_sanskrit": "वैशम्पायन उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2023921, "chapter_id": 1511, "verse_number": "३-१४९-१५", "content_sanskrit": "विज्ञाय तं बलोन्मत्तं बाहुवीर्येण दर्पितम्।\nहृदयेनावहस्यैनं हनूमान्वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2023922, "chapter_id": 1511, "verse_number": "३-१४९-१६", "content_sanskrit": "प्रसीद नास्ति मे शक्तिरुत्थातुं जरयाऽनघ।\nममानुकम्पया त्वेतत्पुच्छमुत्सार्य गम्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2023923, "chapter_id": 1511, "verse_number": "३-१४९-१७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2023924, "chapter_id": 1511, "verse_number": "३-१४९-१७", "content_sanskrit": "[एवमुक्ते हनुमता हीनवीर्यपराक्रमम्।\nमनसाऽचिनतयद्भीमः स्वबाहुबलदर्पितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2023925, "chapter_id": 1511, "verse_number": "३-१४९-१८", "content_sanskrit": "पुच्छे प्रगृह्य तरसा हीनवीर्यपराक्रमम्।\nसालोक्यमन्तकस्यैनं नयाम्यद्येह वानरम् ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2023926, "chapter_id": 1511, "verse_number": "३-१४९-१९", "content_sanskrit": "सावज्ञमथ वामेन स्मयञ्जग्राह पाणिना।\nन चाशकच्चालयितुं भीमः पुच्छं महाकपेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2023927, "chapter_id": 1511, "verse_number": "३-१४९-२०", "content_sanskrit": "उच्चिक्षेप पुनर्दोर्भ्यामिन्द्रायुधमिवोच्छ्रितम्।\nनोद्धर्तुमशकद्भीमो दोर्भ्यामपि महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2023928, "chapter_id": 1511, "verse_number": "३-१४९-२१", "content_sanskrit": "उत्क्षिप्तभ्रूर्विवृत्ताक्षः संहतभ्रकुटीमुखः।\nस्विन्नगात्रोऽभवद्भीमो न चोद्धर्तुंशशाक तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2023929, "chapter_id": 1511, "verse_number": "३-१४९-२२", "content_sanskrit": "यत्नवानपि तु श्रीमाँल्लाङ्गूलोद्धरणे ततः।\nकपेः पार्श्वगतो भीमस्तस्थौ व्रीडडानताननः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2023930, "chapter_id": 1511, "verse_number": "३-१४९-२३", "content_sanskrit": "प्रणिपत्य च कौन्तेयः प्राञ्जलिर्वाक्यमब्रवीत्।\nप्रसीद कपिशार्दूल दुरुक्तं क्षम्यतां मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2023931, "chapter_id": 1511, "verse_number": "३-१४९-२४", "content_sanskrit": "सिद्धो वा यदि वा देवो गन्धर्वो वाऽथ गुह्यकः।\nपृष्टः सन्को मया ब्रूहि कस्त्वं वानररूपधृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2023932, "chapter_id": 1511, "verse_number": "३-१४९-२५", "content_sanskrit": "न चेद्गुह्यं महाबाहो श्रोतव्यं चेद्भवेन्मम।\nशिष्यवत्त्वां तु पृच्छामि उपपन्नोऽस्मि तेऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2023933, "chapter_id": 1511, "verse_number": "३-१४९-२६x", "content_sanskrit": "हनूमानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2023934, "chapter_id": 1511, "verse_number": "३-१४९-२६", "content_sanskrit": "यत्ते मम परिज्ञाने कौतूहलमरिंदम।\nतत्सर्वमखिलेन त्वं शृणु पाण्डवनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2023935, "chapter_id": 1511, "verse_number": "३-१४९-२७", "content_sanskrit": "अहं केसरिणः क्षेत्रे वायुना जगदायुषा।\nजातः कमलपत्राक्ष हनूमान्नाम वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2023936, "chapter_id": 1511, "verse_number": "३-१४९-२८", "content_sanskrit": "सूर्यपुत्रं च सुग्रीवं शक्रपुत्रं च वालिनम्।\nसर्ववानरराजानौ सर्ववानरयूथपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2023937, "chapter_id": 1511, "verse_number": "३-१४९-२९", "content_sanskrit": "उपतस्थुर्महावीर्या मम चामित्रकर्शन।\nसुग्रीवेणाभवत्प्रीतिरनिलस्याग्निना यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2023938, "chapter_id": 1511, "verse_number": "३-१४९-३०", "content_sanskrit": "निकृतः स ततो भ्रात्रा कस्मिंश्चित्कारणान्तरे।\nऋश्यमूके मया सार्धं सुग्रीवो न्यवसच्चिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2023939, "chapter_id": 1511, "verse_number": "३-१४९-३१", "content_sanskrit": "अथ दाशरथिर्वीरो रामो नाम महाबलः।\nविष्णुर्मानुषरूपेण चचार वसुधातलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2023940, "chapter_id": 1511, "verse_number": "३-१४९-३२", "content_sanskrit": "स पितुः प्रियमन्विच्छन्सहभार्यः सहानुजः।\nसधनुर्धन्विनांश्रेष्ठो दण्डकारण्यमाश्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2023941, "chapter_id": 1511, "verse_number": "३-१४९-३३", "content_sanskrit": "तस्य भार्या जनस्थानाच्छलेनापहृता बलात्।\nराक्षसेन्द्रेण बलिना रावणेन दुरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2023942, "chapter_id": 1511, "verse_number": "३-१४९-३४", "content_sanskrit": "सुवर्णरत्नचित्रेण मृगरूपेण रक्षसा।\nवञ्चयित्वा नरव्याघ्रं मारीचेन तदाऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2023943, "chapter_id": 1511, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि एकोनपञ्चाशदधिकशततमोऽध्यायः ॥ १४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]