[{"id": 7001429000, "chapter_id": 21429, "verse_number": "७-१-२-१", "content_sanskrit": "सूत उवाच ।\nपुरा कालेन महता कल्पेतीते पुनःपुनः ।\nअस्मिन्नुपस्थिते कल्पे प्रवृत्ते सृष्ठिकर्मणि॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001429001, "chapter_id": 21429, "verse_number": "७-१-२-२", "content_sanskrit": "प्रतिष्ठितायां वार्तायां प्रबुद्धासु प्रजासु च ।\nमुनीनां षट्कुलीयानां ब्रुवतामितरेतरम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001429002, "chapter_id": 21429, "verse_number": "७-१-२-३", "content_sanskrit": "इदं परमिदं नेति विवादस्सुमहानभूत् ।\nपरस्य दुर्निरूपत्वान्न जातस्तत्र निश्चयः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001429003, "chapter_id": 21429, "verse_number": "७-१-२-४", "content_sanskrit": "ते ऽभिजग्मुर्विधातारं द्रष्टुं ब्रह्माणमव्ययम् ।\nयत्रास्ते भगवान् ब्रह्मा स्तूयमानस्सुरासुरैः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001429004, "chapter_id": 21429, "verse_number": "७-१-२-५", "content_sanskrit": "मेरुशृंगे शुभे रम्ये देवदानवसंकुले ।\nसिद्धचारणसंवादे यक्षगंधर्वसेविते॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001429005, "chapter_id": 21429, "verse_number": "७-१-२-६", "content_sanskrit": "विहंगसंघसंघुष्टे मणिविद्रुमभूषिते ।\nनिकुंजकंदरदरीगृहानिर्झरशोभिते॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001429006, "chapter_id": 21429, "verse_number": "७-१-२-७", "content_sanskrit": "तत्र ब्रह्मवनं नाम नानामृगसमाकुलम् ।\nदशयोजनविस्तीर्णं शतयोजनमायतम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001429007, "chapter_id": 21429, "verse_number": "७-१-२-८", "content_sanskrit": "सुरसामलपानीयपूर्णरम्यसरोवरम् ।\nमत्तभ्रमरसंछन्नरम्यपुष्पितपादपम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001429008, "chapter_id": 21429, "verse_number": "७-१-२-९", "content_sanskrit": "तरुणादित्यसंकाशं तत्र चारु महत्पुरम् ।\nदुर्धर्षबलदृप्तानां दैत्यदानवरक्षसाम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001429009, "chapter_id": 21429, "verse_number": "७-१-२-१०", "content_sanskrit": "तप्तजांबूनदमयं प्रांशुप्राकारतोरणम् ।\nनिर्व्यूहवलभीकूटप्रतोलीशतमंडितम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001429010, "chapter_id": 21429, "verse_number": "७-१-२-११", "content_sanskrit": "महार्हमणिचित्राभिर्लेलिहानमिवांबरम् ।\nमहाभवनकोटीभिरनेकाभिरलंकृतम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001429011, "chapter_id": 21429, "verse_number": "७-१-२-१२", "content_sanskrit": "तस्मिन्निवसति ब्रह्मा सभ्यैः सार्धं प्रजापतिः ।\nतत्र गत्वा महात्मानं साक्षाल्लोकपितामहम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001429012, "chapter_id": 21429, "verse_number": "७-१-२-१३", "content_sanskrit": "दद्दशुर्मुनयो देवा देवर्षिगणसेवितम् ।\nशुद्धचामीकरप्रख्यं सर्वाभरणभूषितम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001429013, "chapter_id": 21429, "verse_number": "७-१-२-१४", "content_sanskrit": "प्रसन्नवदनं सौम्यं पद्मपत्रायतेक्षणम् ।\nदिव्यकांतिसमायुक्तं दिव्यगंधानुलेपनम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001429014, "chapter_id": 21429, "verse_number": "७-१-२-१५", "content_sanskrit": "दिव्यशुक्लांबरधरं दिव्यमालाविभूषितम् ।\nसुरासुरेन्द्रयोगींद्रवंद्यमानपदांबुजम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001429015, "chapter_id": 21429, "verse_number": "७-१-२-१६", "content_sanskrit": "सर्वलक्षणयुक्तांग्या लब्धचामरहस्तया ।\nभ्राजमानं सरस्वत्या प्रभयेव दिवाकरम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001429016, "chapter_id": 21429, "verse_number": "७-१-२-१७", "content_sanskrit": "तं दृष्ट्वा मुनयस्सर्वे प्रसन्नवदनेक्षणाः ।\nशिरस्यंजलिमाधाय तुष्टुवुस्सुरपुंगवम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001429017, "chapter_id": 21429, "verse_number": "७-१-२-१८", "content_sanskrit": "मुनय ऊचुः ।\nनमस्त्रिमूर्तये तुभ्यं सर्गस्थित्यंतहेतवे ।\nपुरुषाय पुराणाय ब्रह्मणे परमात्मने॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001429018, "chapter_id": 21429, "verse_number": "७-१-२-१९", "content_sanskrit": "नमः प्रधानदेहाय प्रधानक्षोभकारिणे ।\nत्रयोविंशतिभेदेन विकृतायाविकारिणे॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001429019, "chapter_id": 21429, "verse_number": "७-१-२-२०", "content_sanskrit": "नमो ब्रह्माण्डदेहाय ब्रह्मांडोदरवर्तिने ।\nतत्र संसिद्धकार्याय संसिद्धकरणाय च॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001429020, "chapter_id": 21429, "verse_number": "७-१-२-२१", "content_sanskrit": "नमोस्तु सर्वलोकाय सर्वलोकविधायिने ।\nसर्वात्मदेहसंयोग वियोगविधिहेतवे॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001429021, "chapter_id": 21429, "verse_number": "७-१-२-२२", "content_sanskrit": "त्वयैव निखिलं सृष्टं संहृतं पालितं जगत् ।\nतथापि मायया नाथ न विद्मस्त्वां पितामह॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001429022, "chapter_id": 21429, "verse_number": "७-१-२-२३", "content_sanskrit": "सूत उवाच ।\nएवं ब्रह्मा महाभागैर्महर्षिभिरभिष्टुतः ।\nप्राह गंभीरया वाचा मुनीन् प्रह्लादयन्निव॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001429023, "chapter_id": 21429, "verse_number": "७-१-२-२४", "content_sanskrit": "ब्रह्मोवाच ।\nऋषयो हे महाभागा महासत्त्वा महौजसः ।\nकिमर्थं सहितास्सर्वे यूयमत्र समागताः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001429024, "chapter_id": 21429, "verse_number": "७-१-२-२५", "content_sanskrit": "तमेवंवादिनं देवं ब्रह्माणं ब्रह्मवित्तमाः ।\nवाग्भिर्विनयगर्भाभिस्सर्वे प्रांजलयो ऽब्रुवन्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001429025, "chapter_id": 21429, "verse_number": "७-१-२-२६", "content_sanskrit": "मुनय ऊचुः ।\nभगवन्नंधकारेण महता वयमावृताः ।\nखिन्ना विवदमानाश्च न पश्यामो ऽत्र यत्परम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001429026, "chapter_id": 21429, "verse_number": "७-१-२-२७", "content_sanskrit": "त्वं हि सर्वजगद्धाता सर्वकारणकारणम् ।\nत्वया ह्यविदितं नाथ नेह किंचन विद्यते॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001429027, "chapter_id": 21429, "verse_number": "७-१-२-२८", "content_sanskrit": "कः पुमान् सर्वसत्त्वेभ्यः पुराणः पुरुषः परः ।\nविशुद्धः परिपूर्णश्च शाश्वतः परमेश्वरः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001429028, "chapter_id": 21429, "verse_number": "७-१-२-२९", "content_sanskrit": "केनैव चित्रकृत्येन प्रथमं सृज्यते जगत् ।\nतत्त्वं वद महाप्राज्ञ स्वसंदेहापनुत्तये॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001429029, "chapter_id": 21429, "verse_number": "७-१-२-३०", "content_sanskrit": "एवं पृष्टस्तदा ब्रह्मा विस्मयस्मेरवीक्षणः ।\nदेवानां दानवानां च मुनीनामपि सन्निधौ॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001429030, "chapter_id": 21429, "verse_number": "७-१-२-३१", "content_sanskrit": "उत्थाय सुचिरं ध्यात्वा रुद्र इत्युद्धरन् गिरिम् ।\nआनंदक्लिन्नसर्वांगः कृतांजलिरभाषत॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]