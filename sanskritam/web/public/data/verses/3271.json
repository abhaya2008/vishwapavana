[{"id": 2105292, "chapter_id": 3271, "verse_number": "१५-९-१", "content_sanskrit": "वैशम्पायन उवाच।\nप्रविश्य त्वर्जुनो राजन्नाश्रमं सत्यवादिनः।\nददर्शासीनमेकान्तो मुनिं सत्यवतीसुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2105293, "chapter_id": 3271, "verse_number": "१५-९-२", "content_sanskrit": "स तमासाद्य धर्मज्ञमुपतस्थे महाव्रतम्।\nअर्जुनोस्मीति नामास्तै निवेद्याभ्यवदत्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2105294, "chapter_id": 3271, "verse_number": "१५-९-३", "content_sanskrit": "स्वागतं तेऽस्त्विति प्राह मुनिः सत्यवतीसुतः।\nआस्यतामिति होवाच प्रसन्नात्मा महामुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2105295, "chapter_id": 3271, "verse_number": "१५-९-४", "content_sanskrit": "तमप्रतीतमनसं निःश्वसन्तं पुनःपुनः।\nनिर्विष्णमनसं दृष्ट्वा पार्थं व्यासोऽब्रवीदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2105296, "chapter_id": 3271, "verse_number": "१५-९-५", "content_sanskrit": "नखकेशदशाकुंभवारिणा किं समुक्षितः।\nआवीरजानुगमनं ब्राह्मणो वा हतस्त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2105297, "chapter_id": 3271, "verse_number": "१५-९-६", "content_sanskrit": "युद्धे पराजितो वाऽसि दतश्रीरिव लक्ष्यसे।\nन त्वां प्रभिन्नं जानामि किमिदं भरतर्षभ।\nश्रोतव्यं चेन्मया पार्थ क्षश्रिप्रमाख्यातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2105298, "chapter_id": 3271, "verse_number": "१५-९-७x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2105299, "chapter_id": 3271, "verse_number": "१५-९-७", "content_sanskrit": "यः स मेघवपुः श्रीमान्बृहत्पङ्कजलोचनः।\nस कृष्णः सह रामेण त्यक्त्वा देहं दिवं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2105300, "chapter_id": 3271, "verse_number": "१५-९-८", "content_sanskrit": "`तदनुस्मृत्य संमोहं तदा शोकं महामते।\nप्रयामि सर्वदा मह्यं मुमूर्षा चोपजायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2105301, "chapter_id": 3271, "verse_number": "१५-९-९", "content_sanskrit": "तद्वाक्यस्पर्शनालोकसुखं चामृतसन्निभम्।\nसंस्मृत्य देवदेवस्य प्रमुह्यित्यमृतात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2105302, "chapter_id": 3271, "verse_number": "१५-९-१०", "content_sanskrit": "मौसले वृष्णिवीराणां विनाशो ब्रह्मशापजः।\nबभूव वीरान्तकरः प्रभासे रोमहर्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2105303, "chapter_id": 3271, "verse_number": "१५-९-११", "content_sanskrit": "एते शूरा महात्मानः सिंहदर्पा महाबलाः।\nभोजवृष्ण्यन्धका ब्रह्मन्नन्योन्यं तैर्हतं युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2105304, "chapter_id": 3271, "verse_number": "१५-९-१२", "content_sanskrit": "गदापरिघशक्तीनां सहाः परिघबाहवः।\nत एरकाभिर्निहताः पश्य कालस्य पर्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2105305, "chapter_id": 3271, "verse_number": "१५-९-१३", "content_sanskrit": "हतं पञ्चशतं तेषां सहस्रं बाहुशालिनाम्।\nनिधनं समनुप्राप्तं समासाद्येतरेतरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2105306, "chapter_id": 3271, "verse_number": "१५-९-१४", "content_sanskrit": "पुनःपुनर्न मृष्यामि विनाशममितौजसाम्।\nचिन्तयानो यदूनां च कृष्णस्य च यशस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2105307, "chapter_id": 3271, "verse_number": "१५-९-१५", "content_sanskrit": "शोषणं सागरस्येव मन्दरस्येव चालनम्।\nनभसः पतनं चैव शैत्यमग्नेस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2105308, "chapter_id": 3271, "verse_number": "१५-९-१६", "content_sanskrit": "अश्रद्धेयमहं मन्ये विनाशं शार्ङ्गधन्वनः।\nन चेह स्थातुमिच्छामि लोके कृष्णविनाकृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2105309, "chapter_id": 3271, "verse_number": "१५-९-१७", "content_sanskrit": "इतः कष्टतरं चान्यच्छृणु तद्वै तपोधन।\nमनो मे दीर्यते येन चिन्तयानस्य वै मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2105310, "chapter_id": 3271, "verse_number": "१५-९-१८", "content_sanskrit": "पश्यतो वृष्णिदाराश्च मम ब्रह्मन्सहस्रशः।\nआभीरैरभिभूयाजौ हृताः पञ्चनदालयैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2105311, "chapter_id": 3271, "verse_number": "१५-९-१९", "content_sanskrit": "धनुरादाय तत्राहं नाशकं तस्य पूरणे।\nयथापुरा च मे वीर्यं भुजयोर्न तथाऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2105312, "chapter_id": 3271, "verse_number": "१५-९-२०", "content_sanskrit": "अस्त्राणि मे प्रनष्टानि विविधानि महामुने।\nशराश्च क्षयमापन्नाः क्षणेनैव समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2105313, "chapter_id": 3271, "verse_number": "१५-९-२१", "content_sanskrit": "पुरुषस्चाप्रमेयात्मा शङ्खचक्रगदाधरः।\nचतुर्भुजः पीतवासाः श्यामः पद्मदलेक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2105314, "chapter_id": 3271, "verse_number": "१५-९-२२", "content_sanskrit": "यश्च याति पुरस्तान्मे रथस्य सुमहाद्युतिः।\nप्रदहन्रिपुसैन्यानि न पश्याम्यहमद्य तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2105315, "chapter_id": 3271, "verse_number": "१५-९-२३", "content_sanskrit": "येन पूर्वं प्रदग्धानि शत्रुसैन्यानि तेजसा।\nशरैर्गाण्डीवनिर्मुक्तैरहं पश्चादशातयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2105316, "chapter_id": 3271, "verse_number": "१५-९-२४", "content_sanskrit": "तमपश्यन्विषीदामि घूर्णामीव च सत्तम।\nपरिनिर्विण्णचेताश्च शान्तिं नोपलभेऽपि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2105317, "chapter_id": 3271, "verse_number": "१५-९-२५", "content_sanskrit": "`देवकीनन्दनं देवं वासुदेवमजं प्रभुम्।\nविना जनार्दनं वीरं नाहं जीवितुमुत्सहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2105318, "chapter_id": 3271, "verse_number": "१५-९-२६", "content_sanskrit": "श्रुत्वैव हि गतं विष्णुं ममापि मुमुहुर्दिशः।\nप्रनष्टज्ञातिवीर्यस्य शून्यस्य परिधावतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2105319, "chapter_id": 3271, "verse_number": "१५-९-२७", "content_sanskrit": "उपदेष्टुं मम श्रेयो भवानर्हति सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2105320, "chapter_id": 3271, "verse_number": "१५-९-२८x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2105321, "chapter_id": 3271, "verse_number": "१५-९-२८", "content_sanskrit": "`देवांशा देवभूतेन सम्भूतास्ते गतास्सह।\nधर्मव्यवस्थारक्षार्थं देवेन समुपेक्षिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2105322, "chapter_id": 3271, "verse_number": "१५-९-२९", "content_sanskrit": "ब्रह्मशापविनिर्दग्धा वृष्ण्यन्धकसमहारथाः।\nविनष्टाः कुरुशार्दूल न ताञ्शोचितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2105323, "chapter_id": 3271, "verse_number": "१५-९-९", "content_sanskrit": "भवितव्यं तथा तच्च दिष्टमेतन्महात्मनाम्।\nउपेक्षितं च कृष्णेन शक्तेनापि व्यपोहितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2105324, "chapter_id": 3271, "verse_number": "१५-९-३१", "content_sanskrit": "त्रैलोक्यमपि गोविन्दः कृत्स्नं स्थावरजङ्गमम्।\nप्रसहेदन्यथा कर्तुं कुतः शापं महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2105325, "chapter_id": 3271, "verse_number": "१५-९-३२", "content_sanskrit": "`स्त्रियश्च ताः पुरा शप्ताः प्रभासे कुपितेन वै।\nअष्टावक्रेण मुनिना तदर्थं त्वद्बलक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2105326, "chapter_id": 3271, "verse_number": "१५-९-३३", "content_sanskrit": "रथस्य पुरतो याति यः स चक्रगदाधरः।\nतव स्नेहात्पुराणर्षिर्वासुदेवश्चतुर्भुजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2105327, "chapter_id": 3271, "verse_number": "१५-९-३४", "content_sanskrit": "कृत्वा भारावतरणं पृथिव्याः पृथुलोचनः।\nमोक्षयित्वा तनुं प्राप्तः कृष्णः स्वस्थानमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2105328, "chapter_id": 3271, "verse_number": "१५-९-३५", "content_sanskrit": "त्वयाऽपीह महत्कर्म देवानां पुरुषर्षभ।\nकृतं भीमसहायेन यमाभ्यां च महाभुज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2105329, "chapter_id": 3271, "verse_number": "१५-९-३६", "content_sanskrit": "कृतकृत्यांश्च वो मन्ये संसिद्धान्कुरुपुङ्गव।\nगमनं प्राप्तकालं व इदं श्रेयस्करं विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2105330, "chapter_id": 3271, "verse_number": "१५-९-३७", "content_sanskrit": "बलं बुद्धिश्च तेजश्च प्रतिपत्तिश्च भारत।\nभवन्ति भवकालेषु विपद्यन्ते विपर्यये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2105331, "chapter_id": 3271, "verse_number": "१५-९-३८", "content_sanskrit": "कालमूलमिदं सर्वं जगद्बीजं धनंजय।\nकाल एव समादत्ते पुनरेव यदृच्छया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2105332, "chapter_id": 3271, "verse_number": "१५-९-३९", "content_sanskrit": "स एव बलवान्भूत्वा पुनर्भवति दुर्बलः।\nस एवेशश्च भूत्वेह परैराज्ञाप्यते पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2105333, "chapter_id": 3271, "verse_number": "१५-९-४०", "content_sanskrit": "कृतकृत्यानि चास्त्राणि गतान्यद्य यथागतम्।\nपुनरेष्यन्ति ते हस्तं यदा कालो भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2105334, "chapter_id": 3271, "verse_number": "१५-९-४१", "content_sanskrit": "कालो गन्तुं गतिं मुख्यां भवतामपि भारत।\nएतच्छ्रेयो हि वो मन्ये परमं भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2105335, "chapter_id": 3271, "verse_number": "१५-९-४२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2105336, "chapter_id": 3271, "verse_number": "१५-९-४२", "content_sanskrit": "एतद्वचनमाज्ञाय व्यासस्यामिततेजसः।\nअनुज्ञातो ययौ पार्थो नगरं नागसाह्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2105337, "chapter_id": 3271, "verse_number": "१५-९-४३", "content_sanskrit": "प्रविश्य च पुरीं वीरः समासाद्य युधिष्ठिरम्।\nआचष्ट तद्यथावृत्तं वृष्ण्यन्धककुलं प्रति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2105338, "chapter_id": 3271, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसाहस्रयां संहितायां वैयासिक्यां मौसलपर्वणि नवमोध्यायः॥ ९ ॥ ॥ मौसलपर्व समाप्तम् ॥ -------- अस्यानन्तरं महाप्रस्थानिकं पर्व भविष्यति तस्यायमाद्यः श्लोकः। जनमेजय उवाच। एवं वृष्ण्यन्धककुले श्रुत्वा मौसलमाहवम्। पाण्डवाः किमकुर्वन्त तथा कृष्णे दिवं गते॥ १ ॥ इदं मौसलपर्व कुंभघोणस्थेन टी.आर्. कृष्णाचार्येण टी. आर्. व्यासाचार्येण च मुम्बय्यां निर्णयसागरमुद्रायन्त्रे मुद्रापितम्। शकाब्दाः १८३२ सन १९१०.", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]