[{"id": 7002641000, "chapter_id": 22641, "verse_number": "६-१९-१", "content_sanskrit": "चित्रकूटे च नृपती रूपदत्त इति श्रुतः ।\nवने मृगप्रसंगेन वनान्तरमुपाययौ ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002641001, "chapter_id": 22641, "verse_number": "६-१९-२", "content_sanskrit": "मध्याह्ने सरसस्तीरे मुनिपुत्रो ददर्श सः ।\nचिन्वतीं पद्मकुसुमं रूपयौवनशालिनीम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002641002, "chapter_id": 22641, "verse_number": "६-१९-३", "content_sanskrit": "तस्या नेत्रे स्वयं नेत्रे चैकीभूते समागते ।\nएतस्मिन्नंतरे विप्रस्तत्र प्राप्तो ददर्श तौ ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002641003, "chapter_id": 22641, "verse_number": "६-१९-४", "content_sanskrit": "तस्य दर्शनमात्रेण नृपतेर्ज्ञानमागतम् ।\nविनयावनतो राजा धर्मं पप्रच्छ चोत्तमम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002641004, "chapter_id": 22641, "verse_number": "६-१९-५", "content_sanskrit": "तमुवाच मुनिर्द्धीमान्दयाधर्मप्रपोषणम्  ।\nनिर्भयस्य समं दानं न भूतं न भविष्यति ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002641005, "chapter_id": 22641, "verse_number": "६-१९-६", "content_sanskrit": "अनर्हान्दण्डमादद्यादर्हपूजाफलं भजेत् ।\nमित्रता गोद्विजे नित्यं समता दंडनिग्रहे ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002641006, "chapter_id": 22641, "verse_number": "६-१९-७", "content_sanskrit": "सत्यता सुरपूजायां दमता गुरुपूजने ।\nमृदुता दानसमये संतुष्टिर्निंद्यकर्मणि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002641007, "chapter_id": 22641, "verse_number": "६-१९-८", "content_sanskrit": "इत्युक्त्वा स मुनिः पुत्रीं तस्मै दत्त्वा गृहं ययौ ।\nराजापि च तया सार्द्धं वटमूलेऽशयिष्ट वै ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002641008, "chapter_id": 22641, "verse_number": "६-१९-९", "content_sanskrit": "तदा तु राक्षसः कश्चित्तत्पत्नीभक्षणोत्सुकः ।\nबोधयामास नृपतिं बलिं तस्मै स भूपतिः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002641009, "chapter_id": 22641, "verse_number": "६-१९-१०", "content_sanskrit": "दानार्थं चैव क्रव्यादे सप्तवर्षात्मकं द्विजम् ।\nसमयं कृतवान्राजा सत्येन स्वगृहं ययौ ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002641010, "chapter_id": 22641, "verse_number": "६-१९-११", "content_sanskrit": "अमात्यैः संमतं कृत्वा स्वर्णलक्षं ददौ द्विजे ।\nमध्यं बालं पुरस्कृत्य राक्षसाय बलिं ददौ ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002641011, "chapter_id": 22641, "verse_number": "६-१९-१२", "content_sanskrit": "मृत्युकाले द्विजसुतो विहस्योच्चै रुरोद ह ।\nकथं हास्यं कृतं तेन तत्पश्चाद्रोदनं कथम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002641012, "chapter_id": 22641, "verse_number": "६-१९-१३", "content_sanskrit": "इति श्रुत्वा नृपः प्राह शृणु वैतालिक द्विज ।\nज्येष्ठपुत्रं पितुर्हृद्यं मातृहृद्यमवर्यकम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002641013, "chapter_id": 22641, "verse_number": "६-१९-१४", "content_sanskrit": "ज्ञात्वा स मध्यमः पुत्रो राजानं शरणं ययौ ।\nनिर्दयी रूपसेनश्च पत्नीकल्याणभिक्षुकः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002641014, "chapter_id": 22641, "verse_number": "६-१९-१५", "content_sanskrit": "खङ्गहस्तं नृपं ज्ञात्वा जहास शिवतत्परः ।\nराक्षसाय शरीरं मे प्राप्तमस्माद्रुरोद ह ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]