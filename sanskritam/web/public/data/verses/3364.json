[{"id": 2108990, "chapter_id": 3364, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2108991, "chapter_id": 3364, "verse_number": "१", "content_sanskrit": "गतमात्रं तु भर्तारं जरत्कारुरवेदयत् ।\nभ्रातुस्त्वरितमागम्य यथातथ्यं तपोधन \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2108992, "chapter_id": 3364, "verse_number": "२", "content_sanskrit": "तदा स भुजगश्रेष्ठः श्रुत्वा सुमहदप्रियम् ।\nउवाच भगिनीं दीनां तथा दीनतरः स्वयम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2108993, "chapter_id": 3364, "verse_number": "", "content_sanskrit": "वासुकिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2108994, "chapter_id": 3364, "verse_number": "३", "content_sanskrit": "जानासि भद्रे यत् कार्यं प्रदाने कारणं च यत् ।\nपन्नगानां हितार्थाय पुत्रः स्यात् ते ततो यदि \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2108995, "chapter_id": 3364, "verse_number": "४", "content_sanskrit": "स सर्पसत्रात् किल नो मोक्षयिष्यति वीर्यवान् ।\nएवं पितामहः पूर्वम् उक्तवान् मां सुरैः सह\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2108996, "chapter_id": 3364, "verse_number": "५", "content_sanskrit": "अप्यस्ति गर्भः सुभगे तस्मात् ते मुनिसत्तमात् ।\nन चेच्छाम्यफलं तस्य दारकर्म मनीषिणः\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2108997, "chapter_id": 3364, "verse_number": "६", "content_sanskrit": "कामं च मम न न्याय्यं प्रष्टुं त्वां कार्यमीदृशम् ।\nकिन्तु कार्यगरीयस्त्वात् तस्मादहमचूचुदम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2108998, "chapter_id": 3364, "verse_number": "७", "content_sanskrit": "दुर्वासतां विदित्वा च भर्तुस्तेऽतितपस्विनः ।\nनैनमन्वागमिष्यामि कदाचिद्धि शपेत् स माम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2108999, "chapter_id": 3364, "verse_number": "८", "content_sanskrit": "आचक्ष्व भद्रे भर्तुस्त्वं सर्वमेव विचेष्टितम् ।\nशल्यमुद्धर मे घोरमिदं हृदयसंस्थितम्\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2109000, "chapter_id": 3364, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2109001, "chapter_id": 3364, "verse_number": "९", "content_sanskrit": "जरत्कारुस्ततो वाक्यम् इत्युक्ता प्रत्युवाच ह ।\nआश्वासयन्ती सन्तप्तं वासुकिं पन्नगोत्तमम्\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2109002, "chapter_id": 3364, "verse_number": "", "content_sanskrit": "जरत्कारुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2109003, "chapter_id": 3364, "verse_number": "१०", "content_sanskrit": "पृष्टो मयाऽपत्यहेतोः स महात्मा महातपाः ।\nअस्तीत्युदरमुद्दिश्य ममेदं गतवांश्च सः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2109004, "chapter_id": 3364, "verse_number": "११", "content_sanskrit": "स्वैरेष्वपि ततो नाहं स्मरामि वितथं क्वचित् ।\nउक्तपूर्वं कुतो वाक्यं साम्पराये स वक्ष्यति\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2109005, "chapter_id": 3364, "verse_number": "१२", "content_sanskrit": "न सन्तापस्त्वया कार्यः कार्यं प्रति भुजङ्गमे ।\nउत्पत्स्यति हि मे पुत्रो ज्वलनार्कसमद्युतिः\t ॥ १२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2109006, "chapter_id": 3364, "verse_number": "१३", "content_sanskrit": "इत्युक्त्वा हि स मां भ्रातर्गतो भर्ता तपोधनः ।\nतस्माद् व्येतु परं दुःखं तवेदं मनसि स्थितम्\t ॥ १३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2109007, "chapter_id": 3364, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2109008, "chapter_id": 3364, "verse_number": "१४", "content_sanskrit": "एतच्छ्रुत्वा स नागेन्द्रो वासुकिः परया मुदा ।\nएवमस्त्विति तद्वाक्यं भगिन्याः प्रत्यगृह्णत \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2109009, "chapter_id": 3364, "verse_number": "१५", "content_sanskrit": "सान्त्वमानार्थदानैश्च पूजया चानुरूपया ।\nसोदर्यां पूजयामास स्वसारं पन्नगोत्तमः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2109010, "chapter_id": 3364, "verse_number": "१६", "content_sanskrit": "ततः प्रववृधे गर्भो वैश्वानरसमप्रभः ।\nयथा सोमो द्विजश्रेष्ठ शुक्लपक्षोदितो दिवि \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2109011, "chapter_id": 3364, "verse_number": "१७", "content_sanskrit": "यथाकालं तु सा ब्रह्मन् प्रजज्ञे भुजगस्वसा ।\nकुमारं देवगर्भाभं पितृमातृभयापहम् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2109012, "chapter_id": 3364, "verse_number": "१८", "content_sanskrit": "ववृधे स च तत्रैव नागराजनिवेशने ।\nवेदांश्चाधिजगौ साङ्गान् भार्गवच्यवनाद् द्विजात् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2109013, "chapter_id": 3364, "verse_number": "१९", "content_sanskrit": "चरितव्रतो बाल एव बुद्धिसत्त्वसमन्वितः ।\nनाम तस्याभवत् ख्यातं लोकेष्वस्तीक इत्युत \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2109014, "chapter_id": 3364, "verse_number": "२०", "content_sanskrit": "अस्तीत्युक्त्वा गतो यस्मात् पिता गर्भस्थमेव तम् ।\nएवं तस्मादिदं तस्य नामास्तीकेति विश्रुतम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2109015, "chapter_id": 3364, "verse_number": "२१", "content_sanskrit": "स बाल एव तत्रस्थः चरन्नमितबुद्धिमान् ।\nगृहे पन्नगराजस्य प्रयत्नात्पर्यरक्ष्यत \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2109016, "chapter_id": 3364, "verse_number": "२२", "content_sanskrit": "भगवानिव देवेशः शूलपाणिरिव प्रभुः ।\nविवर्धमानः सर्वांस्तान् पन्नगानभ्यहर्षयत् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2109017, "chapter_id": 3364, "verse_number": "४३", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nत्रिचत्वारिंशोऽध्यायः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2109018, "chapter_id": 3364, "verse_number": "४१", "content_sanskrit": "॥ आस्तीकपर्वणि एकत्रिंशोऽध्यायः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]