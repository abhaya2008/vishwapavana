[{"id": 2078933, "chapter_id": 2677, "verse_number": "१२-१८२-०x", "content_sanskrit": "भरद्वाज उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2078934, "chapter_id": 2677, "verse_number": "१२-१८२-१", "content_sanskrit": "त एते धातवः पञ्च ब्रह्मा यानसृजत्पुरा।\nआवृता यैरिमे लोका महाभूताभिसंज्ञिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2078935, "chapter_id": 2677, "verse_number": "१२-१८२-२", "content_sanskrit": "यदाऽसृजत्सहस्राणि भूतानां स महामतिः।\nपञ्चानामेव भूतत्वं कथं समुपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2078936, "chapter_id": 2677, "verse_number": "१२-१८२-३x", "content_sanskrit": "भृगुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2078937, "chapter_id": 2677, "verse_number": "१२-१८२-३", "content_sanskrit": "अमितानां महाशब्दो भूतानां याति संभवम्।\nततस्तेषां महाभूतशब्दोऽयमुपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2078938, "chapter_id": 2677, "verse_number": "१२-१८२-४", "content_sanskrit": "चेष्टा वायुः खमाकाशमूष्माऽग्निः सलिलं द्रवः।\nपृथिवी चात्र संघातः शरीरं पाञ्चभौतिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2078939, "chapter_id": 2677, "verse_number": "१२-१८२-५", "content_sanskrit": "इत्येतैः पञ्चभिर्भूतैर्युक्तं स्थावरजङ्गमम्।\nश्रोत्रं घ्राणं रमः स्पर्शो दृष्टिश्चेन्द्रियसंज्ञिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2078940, "chapter_id": 2677, "verse_number": "१२-१८२-६x", "content_sanskrit": "भरद्वाज उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2078941, "chapter_id": 2677, "verse_number": "१२-१८२-६", "content_sanskrit": "पञ्चभिर्यदि भूतैस्तु यक्ताः स्थावरजङ्गमाः।\nस्थावराणां न दृश्यन्ते शरीरे पञ्च धातवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2078942, "chapter_id": 2677, "verse_number": "१२-१८२-७", "content_sanskrit": "अनूष्मणामचेष्टानां घनानां चैव तत्त्वतः।\nवृक्षा नोपलभ्यन्ते शरीरे पञ्च धातवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2078943, "chapter_id": 2677, "verse_number": "१२-१८२-८", "content_sanskrit": "न शृणुन्ते न पश्यन्ति न गन्धरसवेदिनः।\nन चस्पर्शं विजानन्ति ते कथं पाञ्चभौतिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2078944, "chapter_id": 2677, "verse_number": "१२-१८२-९", "content_sanskrit": "अद्रवत्वादनग्नित्वादभूतित्वादवायुतः।\nआकाशस्याप्रमेयत्वाद्वृक्षाणां नास्ति भौतिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2078945, "chapter_id": 2677, "verse_number": "१२-१८२-१०x", "content_sanskrit": "भृगुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2078946, "chapter_id": 2677, "verse_number": "१२-१८२-१०", "content_sanskrit": "घनानामपि वृक्षाणामाकाशोऽस्ति न संशयः।\nतेषां पुष्पफलव्यक्तिर्नित्यं समुपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2078947, "chapter_id": 2677, "verse_number": "१२-१८२-११", "content_sanskrit": "ऊष्मतो म्लायते वर्णं त्वक्फलं पुष्पमेव च।\nम्लायते शीर्यते चापि स्पर्शस्तेनात्र विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2078948, "chapter_id": 2677, "verse_number": "१२-१८२-१२", "content_sanskrit": "वाय्वग्न्यशनिनिष्पेषैः फलं पुष्पं विशीर्यते।\nश्रोत्रेण गृह्यते शब्दस्तस्माच्छृण्वन्ति पादपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2078949, "chapter_id": 2677, "verse_number": "१२-१८२-१३", "content_sanskrit": "वल्ली वेष्टयते वृक्षं सर्वतश्चैव गच्छति।\nन ह्यदृष्टेश्च मार्गोऽस्ति तस्मात्पश्यन्ति पादपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2078950, "chapter_id": 2677, "verse_number": "१२-१८२-१४", "content_sanskrit": "पुण्यापुण्यैस्तथा गन्धैर्धूपैश्च विविधैरपि।\nअरोगाः पुष्पिताः सन्ति तस्माज्जिघ्रन्ति पादपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2078951, "chapter_id": 2677, "verse_number": "१२-१८२-१५", "content_sanskrit": "पादैः सलिलपानाच्च व्याधीनां चापि दर्शनात्।\nव्याधिप्रतिक्रियत्वाच्च विद्यते रसनं द्रुमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2078952, "chapter_id": 2677, "verse_number": "१२-१८२-१६", "content_sanskrit": "वक्रेणोत्पलनालेन यथोर्ध्वं जलमाददेत्।\nतथा पवनसंयुक्तः पादैः पिबति पादपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2078953, "chapter_id": 2677, "verse_number": "१२-१८२-१७", "content_sanskrit": "सुखदुःखयोश्च ग्रहणाच्छिन्नस्य च विरोहणात्।\nजीवं पश्यामि वृक्षाणामचैतन्यं न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2078954, "chapter_id": 2677, "verse_number": "१२-१८२-१८", "content_sanskrit": "तेन तज्जलमादत्तं जरयत्यग्निमारुतौ।\nआहारपरिणामाच्च स्नेहो वृद्धिश्च जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2078955, "chapter_id": 2677, "verse_number": "१२-१८२-१९", "content_sanskrit": "जङ्गमानां च सर्वेषां शरीरे पञ्च धातवः।\nप्रत्येकशः प्रभिद्यन्ते यैः शरीरं विचेष्टते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2078956, "chapter_id": 2677, "verse_number": "१२-१८२-२०", "content_sanskrit": "त्वक्च मांसं तथाऽस्थीनि मज्जा स्नायुश्च पञ्चमम्।\nइत्येतदिह संघातं शरीरे पृथिवीमयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2078957, "chapter_id": 2677, "verse_number": "१२-१८२-२१", "content_sanskrit": "तेजो ह्यग्निस्तथा क्रोधश्चक्षुरूष्मा तथैव च।\nअग्निर्जरयते यच्च पञ्चाग्नेयाः शरीरिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2078958, "chapter_id": 2677, "verse_number": "१२-१८२-२२", "content_sanskrit": "श्रोत्रं घ्राणं तथाऽऽस्यं च हृदयं कोष्ठमेव च।\nआकाशात्प्राणिनामेते शरीरे पञ्च धातवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2078959, "chapter_id": 2677, "verse_number": "१२-१८२-२३", "content_sanskrit": "श्लेष्मा पित्तमथ स्वेदो वसा शोणितमेव च।\nइत्यापः पञ्चधा देहे भवन्ति प्राणिनां सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2078960, "chapter_id": 2677, "verse_number": "१२-१८२-२४", "content_sanskrit": "प्राणात्प्राणयते प्राणी व्यानाद्व्यायच्छते तथा।\nगच्छत्यपाने वाक्चैव समानने समः स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2078961, "chapter_id": 2677, "verse_number": "१२-१८२-२५", "content_sanskrit": "उदानादुच्छ्वसिति च प्रतिभेदाच्च भाषते।\nइत्येते वायवः पञ्च चेष्टयन्तीह देहिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2078962, "chapter_id": 2677, "verse_number": "१२-१८२-२६", "content_sanskrit": "भूमेर्गन्धगुणान्वेत्ति रसं चाद्भ्यः शरीरवान्।\nज्योतेः पश्यति रूपाणि स्पर्शं वेत्ति च वायुतः।\n`शब्दं शृणोति च तदैवाकाशात्तु शरीरवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2078963, "chapter_id": 2677, "verse_number": "१२-१८२-२७", "content_sanskrit": "गन्धः स्पर्शो रसो रूपं शब्दश्चात्र गुणाः स्मृताः।\nतस्य गन्धस्य वक्ष्यामि विस्तराभिहितान्गुणान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2078964, "chapter_id": 2677, "verse_number": "१२-१८२-२८", "content_sanskrit": "इष्टश्चानिष्टगन्धश्च मधुरः कटुरेव च।\nनिर्हारी संहतः स्निग्धो रूक्षो विशद एव च।\nएवं नवविधो ज्ञेयः पार्थिवो गन्धविस्तरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2078965, "chapter_id": 2677, "verse_number": "१२-१८२-२९", "content_sanskrit": "ज्योतिः पश्यति चक्षुर्भ्यां स्पर्शं वेत्ति च वायुना।\nशब्दः स्पर्शश्च रूपं च रसश्चापि गुणाः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2078966, "chapter_id": 2677, "verse_number": "१२-१८२-३०", "content_sanskrit": "रसज्ञानं तु वक्ष्यामि तन्मे निगदतः शृणु।\nरसो बहुविधः प्रोक्तः सूरिभिः प्रथितात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2078967, "chapter_id": 2677, "verse_number": "१२-१८२-३१", "content_sanskrit": "मधुरो लवणस्तिक्तः कषायोऽम्लः कटुस्तथा।\nएवं षङ्किधविस्तारो रसो वारिमयः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2078968, "chapter_id": 2677, "verse_number": "१२-१८२-३२", "content_sanskrit": "शब्दः स्पर्शश्च रूपं च त्रिगुणं ज्योतिरुच्यते।\nज्योतिः पश्यति रूपाणि रूपं च बहुधा स्मृतम्।\nह्रस्वो दीर्घस्तथा स्थूलश्चतुरस्रोऽणुवृत्तवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2078969, "chapter_id": 2677, "verse_number": "१२-१८२-३३", "content_sanskrit": "शुक्लः कृष्णस्तथा रक्तः पीतो नीलारुणस्तथा।\nकठिनश्चिक्कणः श्लक्ष्णः पिच्छिलो मृदुदारुणः।\nएवं द्वादशविस्तारो ज्योतीरूपगुणः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2078970, "chapter_id": 2677, "verse_number": "१२-१८२-३४", "content_sanskrit": "शब्दस्पर्शौ च विज्ञेयौ द्विगुणो वायुरित्युत।\nवायव्यस्तु गुणः स्पर्शः स्पर्शश्च बहुधा स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2078971, "chapter_id": 2677, "verse_number": "१२-१८२-३५", "content_sanskrit": "उष्णः शीतः सुखो दुःखः स्निग्धो विशद एव च।\nतथा खरो मृदू रूक्षो लघुर्गुरुतरोऽपि च।\nएवं द्वादशधा स्पर्शो व्याव्यो गुण उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2078972, "chapter_id": 2677, "verse_number": "१२-१८२-३६", "content_sanskrit": "तत्रैकगुणमाकाशं शब्द इत्येव तत्स्मृतम्।\nतस्य शब्दस्य वक्ष्यामि विस्तरं विविधात्मकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2078973, "chapter_id": 2677, "verse_number": "१२-१८२-३७", "content_sanskrit": "षड्ज ऋषभगान्धारौ मध्यमो धैवतस्तथा।\nपञ्चमश्चापि विज्ञेयस्तथा चापि निषादवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2078974, "chapter_id": 2677, "verse_number": "१२-१८२-३८", "content_sanskrit": "एष सप्तविधः प्रोक्तः शब्द आकाशसंभवः।\nत्र्यैस्वर्येण तु सर्वत्र स्थितोऽपि पटहादिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2078975, "chapter_id": 2677, "verse_number": "१२-१८२-३९", "content_sanskrit": "[मृदङ्गभेरीशङ्खानां स्तनयित्नो रथस्य च।\nयः कश्चिच्छ्रूयते शब्दः प्राणिनो प्राणिनोऽपि वा।\nएतेषामेव सर्वेषां विषये संप्रकीर्तितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2078976, "chapter_id": 2677, "verse_number": "१२-१८२-४०", "content_sanskrit": "एवं बहुविधाकारः शब्द आकाशसंभवः।\nआकाशजं शब्दमाहुरेभिर्वायुगुणैः सह॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2078977, "chapter_id": 2677, "verse_number": "१२-१८२-४१", "content_sanskrit": "अव्याहतैश्चेतयने न वेत्ति विषमस्थितैः।\nआप्याय्यन्ते च ते नित्यं धातवस्तैस्तु धातुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2078978, "chapter_id": 2677, "verse_number": "१२-१८२-४२", "content_sanskrit": "आपोऽग्निर्मारुतश्चैव नित्यं जाग्रति देहिषु।\nमूलमेते शरीरस्य व्याप्य प्राणानिह स्थिता॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2078979, "chapter_id": 2677, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि द्व्यशीत्यधिकशततमोऽध्यायः॥ १८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]