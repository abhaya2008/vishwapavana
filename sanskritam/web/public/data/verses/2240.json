[{"id": 2057185, "chapter_id": 2240, "verse_number": "७-१६७-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2057186, "chapter_id": 2240, "verse_number": "७-१६७-१", "content_sanskrit": "भूरिस्तु समरे राजञ्शैनेयं रथिनां वरम्।\nआपतन्तमपासेधत्प्रयाणादिव कुञ्जरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2057187, "chapter_id": 2240, "verse_number": "७-१६७-२", "content_sanskrit": "अथैनं सात्यकिः क्रुद्धः पञ्चभिर्निशितैः शरैः।\nविव्याध हृदये तस्य प्रास्रवत्तस्य शोणितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2057188, "chapter_id": 2240, "verse_number": "७-१६७-३", "content_sanskrit": "तथैव कौरवो युद्धे शैनेयं युद्धदुर्मदम्।\nदशिभिर्निशितैस्तीक्ष्णैरविध्यत भुजान्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2057189, "chapter_id": 2240, "verse_number": "७-१६७-४", "content_sanskrit": "तावन्योन्यं महाराज ततक्षाते शरैर्भृशम्।\nक्रोधसंरक्तनयनौ क्रोधाद्विष्फार्य कार्मुके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2057190, "chapter_id": 2240, "verse_number": "७-१६७-५", "content_sanskrit": "तयोरासीन्महाराज शस्त्रवृष्टिः सुदारुणा।\nक्रुद्धयोः सायकमुचोर्यमान्तकनिकाशयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2057191, "chapter_id": 2240, "verse_number": "७-१६७-६", "content_sanskrit": "तावन्योन्यं शरैः राजन्सञ्छाद्य समवस्थितौ।\nमुहूर्तं चैव तद्युद्धं समरूपमिवाभावत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2057192, "chapter_id": 2240, "verse_number": "७-१६७-७", "content_sanskrit": "ततः क्रुद्धो महाराज शैनेयः प्रहसन्निव।\nधनुश्चिच्छेद समरे कौरव्यस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2057193, "chapter_id": 2240, "verse_number": "७-१६७-८", "content_sanskrit": "अथैनं छिन्नधन्वानं नवभिर्निशितैः शरैः।\nविव्याध हृदये तूर्णं तिष्ठतिष्ठेति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2057194, "chapter_id": 2240, "verse_number": "७-१६७-९", "content_sanskrit": "सोऽतिविद्धो बलवता शत्रुणा शत्रुतापनः।\nधनुरन्यत्समादाय सात्वतं प्रत्यविध्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2057195, "chapter_id": 2240, "verse_number": "७-१६७-१०", "content_sanskrit": "स विद्ध्वा सात्वतं बाणैस्त्रिभिरेव विशाम्पते।\nधनुश्चिच्छेद भल्लेन सुतीक्ष्णेन हसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2057196, "chapter_id": 2240, "verse_number": "७-१६७-११", "content_sanskrit": "छिन्नधन्वा महाराज सात्यकिः क्रोधमूर्च्छितः।\nप्रजहार महावेगां शक्तिं तस्य महोरसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2057197, "chapter_id": 2240, "verse_number": "७-१६७-१२", "content_sanskrit": "स तु शक्त्या विभिन्नाङ्गो निपपात रथोत्तमात्।\nलोहिताङ्ग इवाकाशाद्दीप्तरश्मिर्यदृच्छया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2057198, "chapter_id": 2240, "verse_number": "७-१६७-१३", "content_sanskrit": "तं तु दृष्ट्वा हतं शूरमश्वत्थामा महारथः।\nअभ्यधावत वेगेन शैनेयं प्रति संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2057199, "chapter_id": 2240, "verse_number": "७-१६७-१४", "content_sanskrit": "तिष्ठतिष्ठेति चाभाष्य शैनेयं स नराधिप।\nअभ्यवर्षच्छरौघेण मेरुं वृष्ट्या यथाम्बुदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2057200, "chapter_id": 2240, "verse_number": "७-१६७-१५", "content_sanskrit": "तमापतन्तं संरब्धं शैनेयस्य रथं प्रति।\nघटोत्कचोऽब्रवीद्राजन्नाहं मुक्त्वा महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2057201, "chapter_id": 2240, "verse_number": "७-१६७-१६", "content_sanskrit": "तिष्ठतिष्ठ न मे जीवन्द्रोणपुत्र गमिष्यसि।\nएष त्वां निहनिष्यामि महिषं मृगराडिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2057202, "chapter_id": 2240, "verse_number": "७-१६७-१७", "content_sanskrit": "युद्धश्रद्धामहं तेऽद्य विनेष्यामि रणाजिरे।\nइत्युक्त्वा क्रोधताम्राक्षो राक्षसः परवीरहा।\nद्रोणिमभ्यद्रवत्क्रुद्धो गजेन्द्रमिव केसरी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2057203, "chapter_id": 2240, "verse_number": "७-१६७-१८", "content_sanskrit": "रथाक्षमात्रैरिषुभिरभ्यवर्षद्धटोत्कचः।\nरथिनामृषभं द्रौणिं धाराभिरिव तोयदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2057204, "chapter_id": 2240, "verse_number": "७-१६७-१९", "content_sanskrit": "शरवृष्टिं तु तां प्राप्तां शरैराशीविषोपमैः।\nशातयामास समरे तरसा द्रौणिरुत्स्मयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2057205, "chapter_id": 2240, "verse_number": "७-१६७-२०", "content_sanskrit": "ततः शरशतैस्तीक्ष्णैर्मर्मभेदिभिराशुगैः।\nसमाचिनोद्राक्षसेन्द्रं घटोत्कचमरिन्दमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2057206, "chapter_id": 2240, "verse_number": "७-१६७-२१", "content_sanskrit": "स शरैराचितस्तेन राक्षसो रणमूर्धनि।\nव्यकाशत महाराज श्वाविच्छललतो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2057207, "chapter_id": 2240, "verse_number": "७-१६७-२२", "content_sanskrit": "ततः क्रोधसमाविष्टो भैमसेनिः प्रतापवान्।\nशरैरवचकर्तोग्रैर्द्रौणिं वज्राशनिप्रभैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2057208, "chapter_id": 2240, "verse_number": "७-१६७-२३", "content_sanskrit": "क्षुरप्रैरर्धचन्द्रैश्च नाराचैः सशिलीमुखैः।\nवराहकर्णैर्नालीकैर्विकर्णैश्चाभ्यवीवृषत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2057209, "chapter_id": 2240, "verse_number": "७-१६७-२४", "content_sanskrit": "तां शस्त्रवृष्टिमतुलां वज्राशनिसमस्वनाम्।\nपतन्तीमुपरि क्रुद्धो द्रौणिरव्यथितेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2057210, "chapter_id": 2240, "verse_number": "७-१६७-२५", "content_sanskrit": "सुदुःसहां शरैर्घोरैर्दिव्यास्त्रप्रतिमन्त्रितैः।\nव्यधमत्सुमहातेजा महाभ्राणीव मारुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2057211, "chapter_id": 2240, "verse_number": "७-१६७-२६", "content_sanskrit": "ततोऽन्तरिक्षे बाणानां सङ्ग्रामोऽन्य इवाभवत्।\nघोररूपो महाराज योधानां हर्षवर्धनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2057212, "chapter_id": 2240, "verse_number": "७-१६७-२७", "content_sanskrit": "ततोऽस्त्रसन्धर्षकृतैर्विस्फुलिङ्गैः समन्ततः।\nवमौ निशामुखे व्योम खद्योतैरिव संवृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2057213, "chapter_id": 2240, "verse_number": "७-१६७-२८", "content_sanskrit": "स मार्गणगणैर्द्रौणिर्दिशः प्रच्छाद्य सर्वतः.\nप्रियार्थं तव पुत्राणां राक्षसं समवाकिरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2057214, "chapter_id": 2240, "verse_number": "७-१६७-२९", "content_sanskrit": "ततः प्रववृते युद्धं द्रौणिराक्षसयोर्मृधे।\nविगाढे रजनीमध्ये शक्रप्रह्लादयोरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2057215, "chapter_id": 2240, "verse_number": "७-१६७-३०", "content_sanskrit": "ततो घटोत्कचो बाणैर्दशभिर्द्रौणिमाहवे।\nजघानोरसि सङ्क्रुद्धः कालज्वलनसन्निभैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2057216, "chapter_id": 2240, "verse_number": "७-१६७-३१", "content_sanskrit": "स तैरभ्यायतैर्विद्धो राक्षसेन महाबलः।\nचचाल समरे द्रौणिर्वातनुन्न इव द्रुमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2057217, "chapter_id": 2240, "verse_number": "७-१६७-३२", "content_sanskrit": "स मोहं समरे प्राप्तो ध्वजयष्टिं समाश्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2057218, "chapter_id": 2240, "verse_number": "७-१६७-३३", "content_sanskrit": "ततो हाहाकृतं सैन्यं तव सर्वं जनाधिप।\nहतं स्म मेनिरे सर्वे द्रोणसूनुं जनाधिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2057219, "chapter_id": 2240, "verse_number": "७-१६७-३४", "content_sanskrit": "तं तु दृष्ट्वा तथावस्थमश्वत्थामानमाहवे।\nपाञ्चालाः सृञ्जयाश्चैव सिंहनादं प्रचक्रिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2057220, "chapter_id": 2240, "verse_number": "७-१६७-३५", "content_sanskrit": "प्रतिलभ्य ततः संज्ञामश्वत्थामा महाबलः।\nधनुः प्रपीड्य वामेन करेणामित्रकर्शनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2057221, "chapter_id": 2240, "verse_number": "७-१६७-३६", "content_sanskrit": "मुमोचाकर्णपूर्णेन धनुषा शरमुत्तमम्।\nयमदण़्डोपमं घोरमुद्दिश्याशु घटोत्कचम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2057222, "chapter_id": 2240, "verse_number": "७-१६७-३७", "content_sanskrit": "स भित्त्वा हृदयं तस्य राक्षसस्य शरोत्तमः।\nविवेश वसुधामुग्रः सपुङ्खः पृथिवीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2057223, "chapter_id": 2240, "verse_number": "७-१६७-३८", "content_sanskrit": "सोऽतिविद्धो महाराज रथोपस्थ उपाविशत्।\nराक्षसेन्द्रः पुबलवान्द्रौणिना रणशालिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2057224, "chapter_id": 2240, "verse_number": "७-१६७-३९", "content_sanskrit": "दृष्ट्वा विमूढं हैडिम्बं सारथिस्तु रणाजिरात्।\nद्रौणेः सकाशात्सम्भ्रान्तस्त्वपनिन्येत्वरान्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2057225, "chapter_id": 2240, "verse_number": "७-१६७-४०", "content_sanskrit": "तथा तु समरे विद्ध्वा राक्षसेन्द्रं घटोत्कचम्।\nननाद सुमहानादं द्रोणपुत्रो महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2057226, "chapter_id": 2240, "verse_number": "७-१६७-४१", "content_sanskrit": "पूजितस्तव पुत्रैश्च सर्वयोधैश्च भारत।\nवपुषाऽतिप्रजज्वाल मध्याह्न इव भास्करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2057227, "chapter_id": 2240, "verse_number": "७-१६७-४२", "content_sanskrit": "भीमसेनं तु युध्यन्तं भारद्वाजरथं प्रति।\nस्वयं दुर्योधनो राजा प्रत्यविध्यच्छितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2057228, "chapter_id": 2240, "verse_number": "७-१६७-४३", "content_sanskrit": "तं भीमसेनो दशभिः शरैर्विव्याध मारिष।\nदुर्योधनोऽपि विंशत्या शराणां प्रत्यविध्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2057229, "chapter_id": 2240, "verse_number": "७-१६७-४४", "content_sanskrit": "तौ सायकैरवच्छिन्नावदृश्येतां रणाजिरे।\nमेघजालसमाच्छन्नौ नभसीवेन्दुभास्करौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2057230, "chapter_id": 2240, "verse_number": "७-१६७-४५", "content_sanskrit": "अथ दुर्योधनो राजा भीमं विव्याध पत्रिभिः।\nपञ्चभिर्भरतश्रेष्ठ तिष्ठतिष्ठेति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2057231, "chapter_id": 2240, "verse_number": "७-१६७-४६", "content_sanskrit": "तस्य भीमो धनुश्छित्त्वा ध्वजं च दशभिः शरैः।\nविव्याध कौरवश्रेष्ठं नवत्या नतपर्वणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2057232, "chapter_id": 2240, "verse_number": "७-१६७-४७", "content_sanskrit": "ततो दुर्योधनः क्रुद्धो भनुरन्यन्महत्तरम्।\nगृहीत्वा भरतश्रेष्ठो भीमसेनं शितैः शरैः।\nअपीडयद्रणमुखे पश्यतां सर्वधन्विनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2057233, "chapter_id": 2240, "verse_number": "७-१६७-४८", "content_sanskrit": "तान्निहत्य शरान्भीमो दुर्योधनधनुश्च्युतान्।\nकौरवं पञ्चविंशत्या क्षुद्रकाणां समार्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2057234, "chapter_id": 2240, "verse_number": "७-१६७-४९", "content_sanskrit": "दुर्योधनस्तु सङ्क्रुद्धो भीमसेनस्य मारिष।\nक्षुरप्रेण धनुश्छित्त्वा दशभिः प्रत्यविध्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2057235, "chapter_id": 2240, "verse_number": "७-१६७-५०", "content_sanskrit": "अथान्यद्धनुरादाय भीमसेनो महाबलः।\nविव्याध नृपतिं तूर्णं सप्तभिर्निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2057236, "chapter_id": 2240, "verse_number": "७-१६७-५१", "content_sanskrit": "तदप्यस्य धनुः क्षिप्रं चिच्छेद लघुहस्तवत्।\nद्वितीयं च तृतीयं च चतुर्थं पञ्चमं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2057237, "chapter_id": 2240, "verse_number": "७-१६७-५२", "content_sanskrit": "आत्तमात्तं महाराज भीमस्य धनुराच्छिनत्।\nतव पुत्रो महाराज जितकाशी मदोत्कटः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2057238, "chapter_id": 2240, "verse_number": "७-१६७-५३", "content_sanskrit": "स तथा भिद्यमानेषु कार्मुकेषु पुनः पुनः।\nशक्तिं चिक्षेप समरे सर्वपारशवीं शुभाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2057239, "chapter_id": 2240, "verse_number": "७-१६७-५४", "content_sanskrit": "मृत्योरिव स्वसारं हि दीप्तां वह्निशिखामिव।\nसीमन्तमिव कुर्वन्तीं नभसोऽग्निसमप्रभाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2057240, "chapter_id": 2240, "verse_number": "७-१६७-५५", "content_sanskrit": "अप्राप्तामेव तां शक्तिं त्रिधा चिच्छेद कौरवः।\nपश्यतः सर्वलोकस्य भीमस्य च महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2057241, "chapter_id": 2240, "verse_number": "७-१६७-५६", "content_sanskrit": "ततो भीमो महाराज गदां गुर्वीं महाप्रभाम्।\nचिक्षेपाविध्य वेगेन दुर्योधनरथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2057242, "chapter_id": 2240, "verse_number": "७-१६७-५७", "content_sanskrit": "ततः सा सहसा वाहांस्तव पुत्रस्य संयुगे।\nसारथिं च गदा गुर्वी ममर्दास्य रथं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2057243, "chapter_id": 2240, "verse_number": "७-१६७-५८", "content_sanskrit": "पुत्रस्तु तव राजेन्द्र भीमाद्भीतः प्रणश्य च।\nआरुरोह रथं चान्यं नन्दकस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2057244, "chapter_id": 2240, "verse_number": "७-१६७-५९", "content_sanskrit": "ततो भीमो हतं मत्वा तव पुत्रं महारथम्।\nसिंहनादं महच्चक्रे तर्जयन्निशि कौरवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2057245, "chapter_id": 2240, "verse_number": "७-१६७-६०", "content_sanskrit": "तावकाः सैनिकाश्चापि मेनिरे निहतं नृपम्।\nततोऽतिचुक्रुशुः सर्वे ते हाहेति समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2057246, "chapter_id": 2240, "verse_number": "७-१६७-६१", "content_sanskrit": "तेषां तु निनदं श्रुत्वा त्रस्तानां सर्वयोधिनाम्।\nभीमसेनस्य नादं च श्रुत्वा राजन्महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2057247, "chapter_id": 2240, "verse_number": "७-१६७-६२", "content_sanskrit": "ततो युधिष्ठिरो राजा हतं मत्वा सुयोधनम्।\nअभ्यवर्तत वेगेन यत्र पार्थो वृकोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2057248, "chapter_id": 2240, "verse_number": "७-१६७-६३", "content_sanskrit": "पाञ्चलाः केकया मात्स्याः सृञ्जयाश्च विशाम्पते।\nसर्वोद्योगेनाभिजग्मुद्रोणमेव युयुत्सया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2057249, "chapter_id": 2240, "verse_number": "७-१६७-६४", "content_sanskrit": "तत्रासीत्सुमहद्युद्धं द्रोणस्याथ परैः सह।\nघोरे तमसि मग्नानां निघ्नतामितरेतरम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2057250, "chapter_id": 2240, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि घटोत्कचवधपर्वणि चतुर्दशरात्रियुद्धे सप्तषष्ट्यधिक शततमोऽध्यायः॥ १६७ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१६७-१ प्रयाणाद्यानस्थानात्। प्रवणादिति पाठे प्रवणं प्रकृष्टं वनं जलम्॥ ५-१६७-२ तस्य सात्यकेः। तस्य तस्माद्धृदयात्॥ ५-१६७-१२ लोहिताङ्गः कुजः। यदृच्छया दैवेनेत्यभूतोपमा॥ ५-१६७-१६ महिषमसुरम्। महिषं षण्मुखो यथा इति घ.ङ.झ.पाठः॥ ५-१६७-२१ श्वाविच्छल्यकः। शललतः शललीभिः॥ ५-१६७-५८ प्रणश्य निलीनो भूत्वा॥ ५-१६७-१६७ सप्तषष्ट्यधिकशततमोऽध्यायः॥ १६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]