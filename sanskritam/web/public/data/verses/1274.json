[{"id": 2013370, "chapter_id": 1274, "verse_number": "२-१५-१", "content_sanskrit": "युधिष्ठिर उवाच।\nउक्तं त्वया बुद्धिमता यन्नान्यो वक्तुमर्हति।\nसंशयानां हि निर्मोक्ता त्वन्नान्यो विद्यते भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2013371, "chapter_id": 1274, "verse_number": "२-१५-२", "content_sanskrit": "गृहे गृहे हि राजानः स्वस्य स्वस्य प्रियङ्कराः।\nन च साम्राज्यमाप्तास्ते सम्रादशब्दो हि कृच्छ्रभाक्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2013372, "chapter_id": 1274, "verse_number": "२-१५-३", "content_sanskrit": "कथं परानुभावज्ञः स्वं प्रशंसितुमर्हति।\nपरेण समवेतस्तु यः प्रशस्यः स पूज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2013373, "chapter_id": 1274, "verse_number": "२-१५-४", "content_sanskrit": "विशाला बहुला भूमिर्बहुरत्नसमाचिता।\nदूरं गत्वा विजानाति श्रेयो वृष्णिकुलोद्वह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2013374, "chapter_id": 1274, "verse_number": "२-१५-५", "content_sanskrit": "शममेव परं मन्ये शमात्क्षेमं भवेन्मम।\nआरम्भे पारमेष्ठ्यं तु न प्राप्यमिति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2013375, "chapter_id": 1274, "verse_number": "२-१५-६", "content_sanskrit": "एवमेते हि जानन्ति कुले जाता मनस्विनः।\nकश्चित्कदाचिदेतेषां भवेच्छ्रेष्ठो जनार्दन।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2013376, "chapter_id": 1274, "verse_number": "२-१५-७", "content_sanskrit": "वयं यैव महाभाग जरासन्धभयात्तदा।\nशङ्किताः स्म महाभाग द्वौरात्म्यात्तस्य चानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2013377, "chapter_id": 1274, "verse_number": "२-१५-८", "content_sanskrit": "अहं हि तव दुर्धर्ष भुजवीर्याश्रयः प्रभो।\nनात्मानं बलिनं मन्ये त्वयि तस्माद्विशङ्किते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2013378, "chapter_id": 1274, "verse_number": "२-१५-९", "content_sanskrit": "त्वत्सकाशाच्च रामाच्च भीमसेनाच्च माधव।\nअर्जुनाद्वा महाबाहो हन्तुं शक्यो नवेति वै।\nएवं जानन्हि वार्ष्णेय विमृशामि पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2013379, "chapter_id": 1274, "verse_number": "२-१५-१०", "content_sanskrit": "त्वं मे प्रमाणभूतोऽसि सर्वकार्येषु केशव।\nतच्छ्रुत्वा चाब्रवीद्भीमो वाक्यं वाक्यविशारदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2013380, "chapter_id": 1274, "verse_number": "२-१५-११x", "content_sanskrit": "भीम उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2013381, "chapter_id": 1274, "verse_number": "२-१५-११", "content_sanskrit": "अनारम्भपरो राजा वल्मीक इव सीदति।\nदुर्बलश्चानुपायेन बलिनं योऽधितिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2013382, "chapter_id": 1274, "verse_number": "२-१५-१२", "content_sanskrit": "अतन्द्रितश्च प्रायेण दुर्बलो बलिनं रिपुम्।\nजयेत्सम्यक्प्रयोगेण नीत्याऽर्थानात्मनो हितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2013383, "chapter_id": 1274, "verse_number": "२-१५-१३", "content_sanskrit": "कृष्णे नयो मयि बलं जयः पार्थे धनञ्जये।\nमागधं साधयिष्याम इष्टिं त्रय इवाग्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2013384, "chapter_id": 1274, "verse_number": "२-१५-१४", "content_sanskrit": "त्वद्बुद्धिबलमाश्रित्य सर्वं प्राप्स्यति धर्मराद।\nजयोऽस्माकं हि गोविन्द येषां नाथो भवान्सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2013385, "chapter_id": 1274, "verse_number": "२-१५-१५x", "content_sanskrit": "कृष्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2013386, "chapter_id": 1274, "verse_number": "२-१५-१५", "content_sanskrit": "अर्थानारभते बालो नानुबन्धमवेक्षते।\nतस्मादरिं न मृष्यन्ति बालमर्थपरायणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2013387, "chapter_id": 1274, "verse_number": "२-१५-१६", "content_sanskrit": "जित्वा जय्यान्यौवनाश्विः पालनाच्च भगीरथः।\nकार्तवीर्यस्तपोवीर्याद्बलात्तु भरतो विभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2013388, "chapter_id": 1274, "verse_number": "२-१५-१७", "content_sanskrit": "ऋद्ध्या मरुत्तस्तान्पश्च सम्राजस्त्वनुशुश्रुम।\nसर्वान्वंश्याननुमृशन्नैते सन्ति युगे युगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2013389, "chapter_id": 1274, "verse_number": "२-१५-१८", "content_sanskrit": "साम्राज्यमिच्छतस्ते तु सर्वाकारं युधिष्ठिर।\nनिग्राह्यलक्षणं प्राप्तिर्धर्मार्थनयलक्षणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2013390, "chapter_id": 1274, "verse_number": "२-१५-१९", "content_sanskrit": "बार्हद्रथो नरासन्धस्तद्विद्धि भरतर्षभ।\nन चैनं प्रत्यत्युद्ध्यन्त कुलान्येकशतं नृपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2013391, "chapter_id": 1274, "verse_number": "२-१५-२०", "content_sanskrit": "तस्मादिह बलादेव साम्राज्यं कुरुते हि सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2013392, "chapter_id": 1274, "verse_number": "२-१५-२१", "content_sanskrit": "रत्नभाजो हि राजानो जरासन्धमुपासते।\nन च तुष्यति तेनापि बाल्यादनयमास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2013393, "chapter_id": 1274, "verse_number": "२-१५-२२", "content_sanskrit": "मूर्धाभिषिक्तं नृपतिं प्रधानपुरुषो बलात्।\nआदत्ते न च नो दृष्टोऽभागः पुरुषतः क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2013394, "chapter_id": 1274, "verse_number": "२-१५-२३", "content_sanskrit": "एवं सर्वान्वशे चक्रे जरासन्धः शतावरान्।\nतं दुर्बलतरो राजा कथं पार्थ उपैष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2013395, "chapter_id": 1274, "verse_number": "२-१५-२४", "content_sanskrit": "तण्डुलप्रस्थके राजा कपर्दिनमुपासते।\nप्रोक्षितानां प्रमृष्टानां राज्ञां पशुपतेर्गृहे।\nपशूनामिव प्रमृष्टानां राज्ञां पशुपतेर्गृहे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2013396, "chapter_id": 1274, "verse_number": "२-१५-२५", "content_sanskrit": "क्षत्रियः शस्त्रमरणो यदा भवति सत्कृतः।\nततः स्म मागधं सङ्ख्ये प्रतिबाधेम यद्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2013397, "chapter_id": 1274, "verse_number": "२-१५-२६", "content_sanskrit": "षडशीतिः समानीताः शेषा राजंश्चतुर्दश।\nजरासन्धेन राजानस्ततः क्रूरं प्रवर्त्स्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2013398, "chapter_id": 1274, "verse_number": "२-१५-२७", "content_sanskrit": "प्राप्नुयात्स यशो दीप्तं तत्र यो विघ्नमाचरेत्।\nजयेद्यश्च जरासन्धं स सम्राण्णियतं भवेत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2013399, "chapter_id": 1274, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि मन्त्रपर्वणि पञ्चदशोऽध्यायः॥ २५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]