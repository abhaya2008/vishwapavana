[{"id": 2010411, "chapter_id": 1210, "verse_number": "१-२११-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2010412, "chapter_id": 1210, "verse_number": "१-२११-१", "content_sanskrit": "ततस्ते पाण्डवाः सर्वे पाञ्चाल्यश्च महायशाः।\nप्रत्युथाय महात्मानं कृष्णं सर्वेऽभ्यवादयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2010413, "chapter_id": 1210, "verse_number": "१-२११-२", "content_sanskrit": "प्रतिनन्द्य स तां पूजां पृष्ट्वा कुशलमन्ततः।\nआसने काञ्चने शुद्धे निषसाद महामनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2010414, "chapter_id": 1210, "verse_number": "१-२११-३", "content_sanskrit": "अनुज्ञातास्तु ते सर्वे कृष्णेनामिततेजसा।\nआसनेषु महार्हेषु निषेदुर्द्विपदां वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2010415, "chapter_id": 1210, "verse_number": "१-२११-४", "content_sanskrit": "ततो मुहूर्तान्मधुरां वाणीमुच्चार्य पार्षतः।\nपप्रच्छ तं महात्मानं द्रौपद्यर्थं विशांपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2010416, "chapter_id": 1210, "verse_number": "१-२११-५", "content_sanskrit": "कथमेका बहूनां स्यान्न च स्याद्धर्मसंकरः।\nएतन्मे भगवान्सर्वं प्रब्रवीतु यथातथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2010417, "chapter_id": 1210, "verse_number": "१-२११-६x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2010418, "chapter_id": 1210, "verse_number": "१-२११-६", "content_sanskrit": "अस्मिन्धर्मे विप्रलब्धे लोकवेदविरोधके।\nयस्य यस्य मतं यद्यच्छ्रोतुमिच्छामि तस्य तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2010419, "chapter_id": 1210, "verse_number": "१-२११-७x", "content_sanskrit": "द्रुपद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2010420, "chapter_id": 1210, "verse_number": "१-२११-७", "content_sanskrit": "अधर्मोऽयं मम मतो विरुद्धो लोकवेदयोः।\nन ह्येका विद्यते पत्नी बहूनां द्विजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2010421, "chapter_id": 1210, "verse_number": "१-२११-८", "content_sanskrit": "न चाप्याचरितः पूर्वैरयं धर्मो महात्मभिः।\nन चाप्यधर्मो विद्वद्भिश्चरितव्यः कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2010422, "chapter_id": 1210, "verse_number": "१-२११-९", "content_sanskrit": "ततोऽहं न करोम्येनं व्यवसायं क्रियां प्रति।\nधर्मः सदैव संदिग्धः प्रतिभाति हि मे त्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2010423, "chapter_id": 1210, "verse_number": "१-२११-१०x", "content_sanskrit": "धृष्टद्युम्न उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2010424, "chapter_id": 1210, "verse_number": "१-२११-१०", "content_sanskrit": "यवीयसः कथं भार्यां ज्येष्ठो भ्राता द्विजर्षभ।\nब्रह्मन्समभिवर्तेत सद्वृत्तः संस्तपोधन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2010425, "chapter_id": 1210, "verse_number": "१-२११-११", "content_sanskrit": "न तु धर्मस्य सूक्ष्मत्वाद्गतिं विद्मः कथंचन।\nअधर्मो धर्म इति वा व्यवसायो न शक्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2010426, "chapter_id": 1210, "verse_number": "१-२११-१२", "content_sanskrit": "कर्तुमस्मद्विधैर्ब्रह्मंस्ततोऽयं न व्यवस्यते।\nपञ्चानां महिषी कृष्णा भवत्विति कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2010427, "chapter_id": 1210, "verse_number": "१-२११-१३x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2010428, "chapter_id": 1210, "verse_number": "१-२११-१३", "content_sanskrit": "न मे वागनृतं प्राह नाधर्मे धीयते मतिः।\nवर्तते हि मनो मेऽत्र नैषोऽधर्मः कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2010429, "chapter_id": 1210, "verse_number": "१-२११-१४", "content_sanskrit": "श्रूयते हि पुराणेऽपि जटिला नाम गौतमी।\nऋषीनध्यासितवती सप्त धर्मभृतां वरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2010430, "chapter_id": 1210, "verse_number": "१-२११-१५", "content_sanskrit": "तथैव मुनिजा वार्क्षी तपोभिर्भावितात्मनः।\nसंगताभूद्दश भ्रातॄनकेन्म्नः प्रचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2010431, "chapter_id": 1210, "verse_number": "१-२११-१६", "content_sanskrit": "गुरोर्हि वचनं प्राहुर्धर्म्यं धर्मज्ञसत्तम।\nगुरूणां चैव सर्वेषां माता परमको गुरुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2010432, "chapter_id": 1210, "verse_number": "१-२११-१७", "content_sanskrit": "सा चाप्युक्तवती वाचं भैक्षवद्भुज्यतामिति।\nतस्मादेतदहं मन्ये परं धर्मं द्विजोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2010433, "chapter_id": 1210, "verse_number": "१-२११-१८x", "content_sanskrit": "कुन्त्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2010434, "chapter_id": 1210, "verse_number": "१-२११-१८", "content_sanskrit": "एतमेतद्यथा प्राह धर्मचारी युधिष्ठिरः।\nभुज्यतां भ्रातृभिः सार्धमित्यर्जुनमचोदयम्।\nअनृतान्मे भयं तीव्रं मुच्येऽहमनृतात्कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2010435, "chapter_id": 1210, "verse_number": "१-२११-१९x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2010436, "chapter_id": 1210, "verse_number": "१-२११-१९", "content_sanskrit": "अनृतान्मोक्ष्यसे भद्रे धर्मश्चैव सनातनः।\nननु वक्ष्यामि सर्वेषां पाञ्चाल शृमु मे स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2010437, "chapter_id": 1210, "verse_number": "१-२११-२०", "content_sanskrit": "यथाऽयं विहितो धर्मो यतश्चायं सनातनः।\nयथा च प्राह कौन्तेयस्तथा धर्मो न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2010438, "chapter_id": 1210, "verse_number": "१-२११-२१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2010439, "chapter_id": 1210, "verse_number": "१-२११-२१", "content_sanskrit": "तत उत्थाय भगवान्व्यासो द्वैपायनः प्रभुः।\nकरे गृहीत्वा राजानं राजवेश्म समाविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2010440, "chapter_id": 1210, "verse_number": "१-२११-२२", "content_sanskrit": "पाण्डवाश्चापि कुन्ती च धृष्टद्युम्नश्च पार्षतः।\nविविशुस्तेऽपि तत्रैव प्रतीक्षन्ते स्म तावुभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2010441, "chapter_id": 1210, "verse_number": "१-२११-२३", "content_sanskrit": "ततो द्वैपायनस्त्समै नरेन्द्राय महात्मने।\nआचख्यौ तद्यथा धर्मो बहूनामेकपत्निता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2010442, "chapter_id": 1210, "verse_number": "१-२११-२४", "content_sanskrit": "यथा च ते ददुश्चैव राजपुत्र्याः पुरा वरम्।\nधर्माद्यास्तपसा तुष्टाः पञ्चपत्नीत्वमीश्वराः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2010443, "chapter_id": 1210, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि वैवाहिकपर्वणि एकादशाधिकद्विशततमोऽध्यायः॥ २११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]