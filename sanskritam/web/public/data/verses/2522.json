[{"id": 2072045, "chapter_id": 2522, "verse_number": "१२-२७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2072046, "chapter_id": 2522, "verse_number": "१२-२७-१", "content_sanskrit": "ज्ञातिशोकाभितप्तस्य प्राणानिष्टांस्त्यजिष्यतः।\nज्येष्ठस्य पाण्डुपुत्रस्य व्यासः शोकमपानुदत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2072047, "chapter_id": 2522, "verse_number": "१२-२७-२x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2072048, "chapter_id": 2522, "verse_number": "१२-२७-२", "content_sanskrit": "अत्राप्युदाहरन्तीमभितिहासं पुरातनम्।\nअश्मगीतं नरव्याघ्र तन्निबोध युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2072049, "chapter_id": 2522, "verse_number": "१२-२७-३", "content_sanskrit": "अश्मानं ब्राह्मणं प्राज्ञं वैदेहो जनको नृपः।\nसंशयं परिपप्रच्छ दुःखशोकसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2072050, "chapter_id": 2522, "verse_number": "१२-२७-४x", "content_sanskrit": "जनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2072051, "chapter_id": 2522, "verse_number": "१२-२७-४", "content_sanskrit": "आगमे यदि वाऽपाये ज्ञातीनां द्रविणस्य च।\nनरेण प्रतिपत्तव्यं कल्याणं कथमिच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2072052, "chapter_id": 2522, "verse_number": "१२-२७-५x", "content_sanskrit": "अश्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2072053, "chapter_id": 2522, "verse_number": "१२-२७-५", "content_sanskrit": "उत्पन्नमिममात्मानं नरस्यानन्तरं ततः।\nतानितान्यनुवर्तन्ते दुःखानि च सुखानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2072054, "chapter_id": 2522, "verse_number": "१२-२७-६", "content_sanskrit": "तेषामन्यतरापत्तौ यद्यदेवोपसेवते।\nतदस्य चेतनामाशु हरत्यभ्रमिवानिलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2072055, "chapter_id": 2522, "verse_number": "१२-२७-७", "content_sanskrit": "अभिजातोऽस्मि सिद्धोऽस्मि नास्मि केवलमानुषः।\nइत्येभिर्हेतुभिस्तस्य त्रिभिश्चित्तं प्रसिच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2072056, "chapter_id": 2522, "verse_number": "१२-२७-८", "content_sanskrit": "संप्रसक्तमना भोगान्विसृज्य पितृसंचितान्।\nपरिक्षीणः परस्वानामादानं साधु मन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2072057, "chapter_id": 2522, "verse_number": "१२-२७-९", "content_sanskrit": "तमतिक्रान्तमर्यादमाददानमसांप्रतम्।\nप्रतिषेधन्ति राजानो लुब्धा मृगमिवेषुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2072058, "chapter_id": 2522, "verse_number": "१२-२७-१०", "content_sanskrit": "ये च विंशतिवर्षा वा त्रिंशद्वर्षाश्च मानवाः।\nपरेण ते वर्षशतान्न भविष्यन्ति पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2072059, "chapter_id": 2522, "verse_number": "१२-२७-११", "content_sanskrit": "तेषां परमदुःखानां बुद्ध्या भैषज्यमाचरेत्।\nसर्वप्राणभृतां वृत्तं प्रेक्षमाणस्ततस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2072060, "chapter_id": 2522, "verse_number": "१२-२७-१२", "content_sanskrit": "मानसानां पुनर्योनिर्दुःखानां चित्तविभ्रमः।\nअनिष्टोपनिपातो वा तृतीयं नोपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2072061, "chapter_id": 2522, "verse_number": "१२-२७-१३", "content_sanskrit": "एवमेतानि दुःखानि तानि तानीह मानवम्।\nविविधान्युपवर्तन्ते तथा संस्पर्शजान्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2072062, "chapter_id": 2522, "verse_number": "१२-२७-१४", "content_sanskrit": "जरामृत्यू हि भूतानां खादितारौ वृकाविव।\nबलिनां दुर्बलानां च ह्रस्वानां महतामपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2072063, "chapter_id": 2522, "verse_number": "१२-२७-१५", "content_sanskrit": "न कश्चिज्जात्वतिक्रामेज्जरामृत्यू हि मानवः।\nअपि सागरपर्यन्तां विजित्येमां वसुंधराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2072064, "chapter_id": 2522, "verse_number": "१२-२७-१६", "content_sanskrit": "सुखं वा यदि वा दुःखं भूतानां पर्युपस्थितम्।\nप्राप्तव्यमवशैः सर्वं परिहारो न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2072065, "chapter_id": 2522, "verse_number": "१२-२७-१७", "content_sanskrit": "पूर्वे वयसि मध्ये वाऽप्युत्तरे वा नराधिप।\nअवर्जनीयास्तेऽर्था वै काङ्क्षिता ये ततोऽन्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2072066, "chapter_id": 2522, "verse_number": "१२-२७-१८", "content_sanskrit": "अप्रियैः सह संयोगो विप्रयोगश्च सुप्रियैः।\nअर्थानर्थौ सुखं दुःखं विधानमनुवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2072067, "chapter_id": 2522, "verse_number": "१२-२७-१९", "content_sanskrit": "प्रादुर्भावश्च भूतानां देहत्यागस्तथैव च।\nप्राप्तिव्यायामयोगश्च सर्वमेतत्प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2072068, "chapter_id": 2522, "verse_number": "१२-२७-२०", "content_sanskrit": "गन्धवर्णरसस्पर्शा निवर्तन्ते स्वभावतः।\nतथैव सुखदुःखानि विधानमनुवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2072069, "chapter_id": 2522, "verse_number": "१२-२७-२१", "content_sanskrit": "आसनं शयनं यानमुत्थानं पानभोजनम्।\nनियतं सर्वभूतानां कालेनैव भवत्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2072070, "chapter_id": 2522, "verse_number": "१२-२७-२२", "content_sanskrit": "वैद्याश्चाप्यातुराः सन्ति बलवन्तश्च दुर्बलाः।\nस्त्रीमन्तश्चापरे षण्ढा विचित्रः कालपर्ययः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2072071, "chapter_id": 2522, "verse_number": "१२-२७-२३", "content_sanskrit": "कुले जन्म तथा वीर्यमारोग्यं रूपमेव च।\nसौभाग्यमुपभोगश्च भवितव्येन लभ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2072072, "chapter_id": 2522, "verse_number": "१२-२७-२४", "content_sanskrit": "सन्ति पुत्राः सुबहवो दरिद्राणामनिच्छताम्।\nनास्ति पुत्रः समृद्धानां विचित्रं विधिचेष्टितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2072073, "chapter_id": 2522, "verse_number": "१२-२७-२५", "content_sanskrit": "व्याधिरग्निर्जलं शस्त्रं बुभुक्षाश्चापदो विषम।\nज्वरश्च मरणं जन्तोरुच्चाच्च पतनं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2072074, "chapter_id": 2522, "verse_number": "१२-२७-२६", "content_sanskrit": "निर्याणे यस्य यद्दिष्टं तेन गच्छति सेतुना।\nदृश्यते नाप्यतिक्रामन्न निष्क्रान्तोऽथवा पुनः।\nदृश्यते चाप्यतिक्रामन्न निग्राह्योऽथवा पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2072075, "chapter_id": 2522, "verse_number": "१२-२७-२७", "content_sanskrit": "दृश्यते हि युवैवेह विनश्यन्वसुमान्नरः।\nदरिद्रश्च परिक्लिष्टः शतवर्षो जरान्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2072076, "chapter_id": 2522, "verse_number": "१२-२७-२८", "content_sanskrit": "अकिञ्चनाश्च दृश्यन्ते पुरुषाश्चिरजीविनः।\nसमृद्धे च कुले जाता विनश्यन्ति पतङ्गवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2072077, "chapter_id": 2522, "verse_number": "१२-२७-२९", "content_sanskrit": "प्रायेण श्रीमतां लोके भोक्तुं शक्तिर्न विद्यते।\nदरिद्राणां तु भूयिष्ठं काष्ठमश्मा हि जीर्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2072078, "chapter_id": 2522, "verse_number": "१२-२७-३०", "content_sanskrit": "अहमेतत्करोमीति मन्यते कालनोदितः।\nयद्यदिष्टमसंतोषाहुरात्मा पापमाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2072079, "chapter_id": 2522, "verse_number": "१२-२७-३१", "content_sanskrit": "मृगयाक्षाः स्त्रियः पानं प्रसङ्गा निन्दिता बुधैः।\nदृश्यन्ते पुरुषाश्चात्र संप्रयुक्ता बहुश्रुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2072080, "chapter_id": 2522, "verse_number": "१२-२७-३२", "content_sanskrit": "इति कालेन सर्वार्थानीप्सितानीप्सितानिह।\nस्पृशन्ति सर्वभूतानि निमित्तं नोपलभ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2072081, "chapter_id": 2522, "verse_number": "१२-२७-३३", "content_sanskrit": "वायुमाकाशमग्निं च चन्द्रादित्यावहः क्षपे।\nज्योतींषि सरितः शैलान्कः करोति बिभतिं च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2072082, "chapter_id": 2522, "verse_number": "१२-२७-३४", "content_sanskrit": "शीतमुष्णं तथा वर्षं कालेन परिवर्तते।\nएवमेव मनुष्याणां सुखदुःखे नरर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2072083, "chapter_id": 2522, "verse_number": "१२-२७-३५", "content_sanskrit": "नौषधानि न शस्त्राणि न होमा न पुनर्जपाः।\nत्रायन्ते मृत्युनोपेतं जरया चापि मानवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2072084, "chapter_id": 2522, "verse_number": "१२-२७-३६", "content_sanskrit": "यथा काष्ठं च काष्ठं च समेयातां महोदधौ।\nसमेत्य च व्यपेयातां तद्वद्भूतसमागमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2072085, "chapter_id": 2522, "verse_number": "१२-२७-३७", "content_sanskrit": "ये च निष्परुषैरुक्तगीतवाद्यैरुपस्थिताः।\nये चानाथाः परान्नादाः कालस्तेषु समक्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2072086, "chapter_id": 2522, "verse_number": "१२-२७-३८", "content_sanskrit": "मातापितृसहस्राणि पुत्रदारशतानि च।\nसंसारेष्वनुभूतानि कस्य ते कस्य वा वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2072087, "chapter_id": 2522, "verse_number": "१२-२७-३९", "content_sanskrit": "नैवास्य कश्चिद्भविता नायं भवति कस्यचित्।\nपथि संगतमेवेदं दारबन्धुसुहृज्जनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2072088, "chapter_id": 2522, "verse_number": "१२-२७-४०", "content_sanskrit": "क्वासे क्व च गमिष्यामि कोऽन्वहं किमिहास्थितः।\nकस्मात्किमनुशोचेयमित्येवं स्थापयेन्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2072089, "chapter_id": 2522, "verse_number": "१२-२७-४१", "content_sanskrit": "अनित्ये प्रियसंवासे संसारे चक्रवद्गतौ।\nपथि संगतमेवैतद्धाता माता पिता सखा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2072090, "chapter_id": 2522, "verse_number": "१२-२७-४२", "content_sanskrit": "न दृष्टपूर्वं प्रत्यक्षं परलोकं विदुर्बुधाः।\nआगमांस्त्वनतिक्रम्य श्रद्धातव्यं बुभूषता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2072091, "chapter_id": 2522, "verse_number": "१२-२७-४३", "content_sanskrit": "कुर्वीत पितृदैवत्यं धर्म्याणि च समाचरेत्।\nयजेच्च विद्वान्विधिवत्रिवर्गं चाप्युपाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2072092, "chapter_id": 2522, "verse_number": "१२-२७-४४", "content_sanskrit": "सन्निमज्जेज्जगदिदं गम्भीरे कालसागरे।\nजरामृत्युमहाग्राहे न कश्चिदवबुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2072093, "chapter_id": 2522, "verse_number": "१२-२७-४५", "content_sanskrit": "आयुर्वेदमधीयानाः केवलं सपरिग्रहाः।\nदृश्यन्ते बहवो वैद्या व्याधिभिः समबिप्लुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2072094, "chapter_id": 2522, "verse_number": "१२-२७-४६", "content_sanskrit": "ते पिबन्तः कषायांश्च सर्पीषि विविधानि च।\nन मृत्युमतिवर्तन्ते वेलामिव महोदधिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2072095, "chapter_id": 2522, "verse_number": "१२-२७-४७", "content_sanskrit": "रसायनविदश्चैव सुप्रयुक्तरसायनाः।\nदृश्यन्ते जरया भग्ना नागा नागैरिवोत्तमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2072096, "chapter_id": 2522, "verse_number": "१२-२७-४८", "content_sanskrit": "तथैव तपसोपेताः स्वाध्यायाध्ययने रताः।\nदातारो यज्ञशीलाश्च न तरन्ति जरान्तकौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2072097, "chapter_id": 2522, "verse_number": "१२-२७-४९", "content_sanskrit": "न ह्यहानि निवर्तन्ते न मासा न पुनः समाः।\nजातानां सर्वभूतानां न पुनर्वै समागमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2072098, "chapter_id": 2522, "verse_number": "१२-२७-५०", "content_sanskrit": "सोऽयं विपुलमध्वानं कालेन ध्रुवमध्रुवः।\nस्रोतसैव समभ्येति सर्वभूतनिषेवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2072099, "chapter_id": 2522, "verse_number": "१२-२७-५१", "content_sanskrit": "देहो वा जीविताद्व्येति देही वाऽप्येति देहतः।\nपथि संगतमेवेदं दारैरन्यैश्च बन्धुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2072100, "chapter_id": 2522, "verse_number": "१२-२७-५२", "content_sanskrit": "नायमत्यन्तसंवासो लभ्यते जातु केनचित्।\nअपि स्वेन शरीरेण किमुतान्येन केनचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2072101, "chapter_id": 2522, "verse_number": "१२-२७-५३", "content_sanskrit": "क्वनु तेऽद्य पिता राजन्क्वनु तेऽद्य पितामहाः।\nन त्वं पश्यसि तानद्य न त्वां पश्यन्ति तेऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2072102, "chapter_id": 2522, "verse_number": "१२-२७-५४", "content_sanskrit": "न चैव पुरुषो द्रष्टा स्वर्गस्य नरकस्य च।\nआगमस्तु सतां चक्षुर्नृपते तमिहाचर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2072103, "chapter_id": 2522, "verse_number": "१२-२७-५५", "content_sanskrit": "चरितब्रह्मचर्यो हि प्रजायेत यजेत च।\nपितृदेवमनुष्याणामानृण्यादनसूयकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2072104, "chapter_id": 2522, "verse_number": "१२-२७-५६", "content_sanskrit": "स यज्ञशीलः प्रजने निविष्टः\nप्राग्ब्रह्मचारी प्रविभक्तभैक्षः।\nआराधयेत्स्वर्गमिमं च लोकं\nपरं च मुक्त्वा हृदयव्यलीकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2072105, "chapter_id": 2522, "verse_number": "१२-२७-५७", "content_sanskrit": "सम्यक्स्वधर्मं चरतो नृपस्य\nद्रव्याणि चाभ्याहरतो यथावत्।\nप्रवृद्धचक्रस्य यशोऽभिवर्धते\nसर्वेषु लोकेषु चराचरेषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2072106, "chapter_id": 2522, "verse_number": "१२-२७-५८", "content_sanskrit": "इत्येवमाकर्ण्य विदेहराजो\nवाक्यं समग्रं परिपूर्णहेतु।\nअश्मानमामन्त्र्य विशुद्धबुद्धि\nर्ययौ गृहं स्वं प्रति शान्तशोकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2072107, "chapter_id": 2522, "verse_number": "१२-२७-५९", "content_sanskrit": "तथा त्वमप्यद्य विमुच्य शोक\nमुत्तिष्ठ शक्रोपम हर्षमेहि।\nक्षात्रेण धर्मेण मही जिता ते\nतां भुङ्क्ष्व कुन्तीसुत मावमंस्थाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2072108, "chapter_id": 2522, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि सप्तविंशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]