[{"id": 40015930, "chapter_id": 9237, "verse_number": "1", "content_sanskrit": "घोरेणशरबन्धेनबद्धौदशरथात्मजौ । निःश्वसन्तौयथानागौशयानौरुधिरोक्षितौ ॥ सर्वेतेवानरश्रेष्ठास्ससुग्रीवामहाबलाः । परिवार्यमहात्मानौतस्थुश्शोकपरिप्लुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40015931, "chapter_id": 9237, "verse_number": "2", "content_sanskrit": "घोरेणशरबन्धेनबद्धौदशरथात्मजौ । निःश्वसन्तौयथानागौशयानौरुधिरोक्षितौ ॥ सर्वेतेवानरश्रेष्ठास्ससुग्रीवामहाबलाः । परिवार्यमहात्मानौतस्थुश्शोकपरिप्लुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40015932, "chapter_id": 9237, "verse_number": "3", "content_sanskrit": "एतस्मिन्नन्तरेरामःप्रत्यबुध्यतवीर्यवान् । स्थिरत्वात्सत्त्वयोगाच्चशरैस्सन्दानितोऽपिसन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40015933, "chapter_id": 9237, "verse_number": "4", "content_sanskrit": "ततोदृष्टवासरुधिरंनिषण्णंगाढमर्पितम् । भ्रातरंदीनवदनंपर्यदेवयदातुरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40015934, "chapter_id": 9237, "verse_number": "5", "content_sanskrit": "किंनुमेसीतयाकार्यंकिंकार्यंजीवितेनवा । शयानंयोऽद्यपश्यामिभ्रातरंयुधिनिर्जितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40015935, "chapter_id": 9237, "verse_number": "6", "content_sanskrit": "शक्यासीतासमानारीमर्त्यलोकेविचिन्वता । नलक्ष्मणसमोभ्रातासचिवस्साम्पपरायिकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40015936, "chapter_id": 9237, "verse_number": "7", "content_sanskrit": "परित्यक्षाम्यहंप्राणान्वानराणांतुपश्याताम् । यदिपञ्चत्वमापन्नस्सुमित्रानन्दवर्धनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40015937, "chapter_id": 9237, "verse_number": "8", "content_sanskrit": "किंनुवक्ष्यामिकौसल्यांमातरंकिंनुकैकयीम् । कथमम्बांसुमित्रांचपुत्रदर्शनलालसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40015938, "chapter_id": 9237, "verse_number": "9", "content_sanskrit": "विवत्सांवेपमानांचक्रोशन्तींकुररीमिव । कथमाश्वासयिष्यामियदियास्यामितंविना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40015939, "chapter_id": 9237, "verse_number": "10", "content_sanskrit": "कथंवक्ष्यामिशत्रुघ्नंभरतंचयशस्विनम् । मयासहवनंयातोविनातेनापुनमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40015940, "chapter_id": 9237, "verse_number": "11", "content_sanskrit": "उपालम्बंनशक्ष्यामिसोढुंबतसुमित्रया । इहैवदेहंत्यक्ष्यामिनहिजीवितुमुत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40015941, "chapter_id": 9237, "verse_number": "12", "content_sanskrit": "धिङ्मांदुष्कृतकर्माणमनार्यंमत्कृतेह्यसौ । लक्ष्मणःपतितश्शेतेशरतल्पेगतासुवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40015942, "chapter_id": 9237, "verse_number": "13", "content_sanskrit": "त्वंनित्यंसुविषण्णंमामाश्वासयसिलक्ष्मण । गतासुर्नाद्यशक्तोऽसिमामार्तमभिभाषितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40015943, "chapter_id": 9237, "verse_number": "14", "content_sanskrit": "येनाद्यबहवोयुद्धेनिहताराक्षसाविनिपातिताः । तस्यामेवाद्यशूरस्त्वंशेषेविनिहतःपरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40015944, "chapter_id": 9237, "verse_number": "15", "content_sanskrit": "शयानःशरतल्पेऽस्मिन् सशोणितपरिप्लुतः । शरजालैचशितोभासिभास्करोऽस्तमिवव्रजन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40015945, "chapter_id": 9237, "verse_number": "16", "content_sanskrit": "बाणाभिहतमर्मत्वान्नशक्नोत्यभिभाषितुम् । रुजाचाब्रुवतोऽप्यस्यदृष्टिरागेणसूच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40015946, "chapter_id": 9237, "verse_number": "17", "content_sanskrit": "यथैवमांवनंयान्तमनुयातोमहाद्युतिः । अहमप्यनुयास्यामितथैवैनंयमक्ष्यम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40015947, "chapter_id": 9237, "verse_number": "18", "content_sanskrit": "इष्टबन्धुजनोनित्यंमांचनित्यमनुव्रतः । इमामद्यगतोऽवस्थांममानार्यस्यदुर्नयैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40015948, "chapter_id": 9237, "verse_number": "19", "content_sanskrit": "सुरुष्टेनापिवीरेणलक्ष्मणेननसंस्मरे । परुषंविप्रियंवापिश्रावितंनकदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40015949, "chapter_id": 9237, "verse_number": "20", "content_sanskrit": "विससर्जैकवेगेनपञ्चबाणशतानियः । इष्वस्त्रष्वधिकस्तस्मात्कार्तवीर्याच्चलक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40015950, "chapter_id": 9237, "verse_number": "21", "content_sanskrit": "अस्स्रैरस्त्राणियोहन्याच्छक्रस्यापिमहात्मनः । सोऽयमुर्व्यांहतश्शेतेमहार्हशयनोचितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40015951, "chapter_id": 9237, "verse_number": "22", "content_sanskrit": "तच्चमिथ्याप्रलप्तंमांप्रधक्ष्यतिनसंशयः । यन्मयानकृतोराजाराक्षसानांविभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40015952, "chapter_id": 9237, "verse_number": "23", "content_sanskrit": "अस्मिन्मुहूर्तेसुग्रीव प्रतियातुमितोऽर्हसि । मत्वाहीनंराजन् रावणोऽभिद्रवेद्बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40015953, "chapter_id": 9237, "verse_number": "24", "content_sanskrit": "अङ्गदंतुपुरस्कत्यससैन्यस्सपरिच्छदम् । सागरंतरसुग्रीव नीलेनचनलेनच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40015954, "chapter_id": 9237, "verse_number": "25", "content_sanskrit": "कृतंहनुमताकार्यंयदन्यैर्दुष्करंरणे । ऋक्षराजेनतुष्यामिगोलाङ्गूलाधिपेनच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40015955, "chapter_id": 9237, "verse_number": "26", "content_sanskrit": "अङ्गदेनकृतंकर्ममैन्देनद्विविदेनच । युद्धंकेसरिणासङ् ख्येघोरंसम्पातिनाकृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40015956, "chapter_id": 9237, "verse_number": "27", "content_sanskrit": "गवयेनगवाक्षेणशरभेणगजेनच । अन्यैश्चहरिभिर्युद्धंमदर्थेत्यक्तजीवितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40015957, "chapter_id": 9237, "verse_number": "28", "content_sanskrit": "नचातिक्रमितुंशक्यंदैवंसुग्रीव मानुषैः । यत्तुशक्यंवयस्येनसुहृदाचपरन्तप ॥ कृतंसुग्रीव तत्सर्वंभवताधर्मभीरुणा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40015958, "chapter_id": 9237, "verse_number": "29", "content_sanskrit": "मित्रकार्यंकृतमिदंभवद्भिर्वानरर्षभाः ॥ अनुज्ञातामयासर्वेयथेष्टंगन्तुमर्हथ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40015959, "chapter_id": 9237, "verse_number": "30", "content_sanskrit": "शुश्रुवुस्तस्यतेसर्वेवानराःपरिदेवनम् ॥ वर्तयाञ्चक्रूरश्रूणिनेत्रैःकृष्णेतरेक्षणाः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40015960, "chapter_id": 9237, "verse_number": "31", "content_sanskrit": "ततस्सर्वाण्यनीकानिस्थापयित्वाविभीषणः ॥ आजगामगदापाणिस्त्वरितंयत्रराघवः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40015961, "chapter_id": 9237, "verse_number": "32", "content_sanskrit": "तंदृष्टवात्वरितंयान्तंनीलाञ्जनचयोपमम् ॥ वानरादुद्रुवुस्सर्वेमन्यमानास्तुरावणिम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]