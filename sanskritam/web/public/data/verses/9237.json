[{"id": 5000237000, "chapter_id": 9237, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे एकचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000237001, "chapter_id": 9237, "verse_number": "३-४१-१", "content_sanskrit": "आज्ञप्तो रावणेनेत्थं प्रतिकूलं च राजवत्।\nअब्रवीत् परुषं वाक्यं निःशङ्को राक्षसाधिपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000237002, "chapter_id": 9237, "verse_number": "३-४१-२", "content_sanskrit": "केनायमुपदिष्टस्ते विनाशः पापकर्मणा।\nसपुत्रस्य सराज्यस्य सामात्यस्य निशाचर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000237003, "chapter_id": 9237, "verse_number": "३-४१-३", "content_sanskrit": "कस्त्वया सुखिना राजन् नाभिनन्दति पापकृत्।\nकेनेदमुपदिष्टं ते मृत्युद्वारमुपायतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000237004, "chapter_id": 9237, "verse_number": "३-४१-४", "content_sanskrit": "शत्रवस्तव सुव्यक्तं हीनवीर्या निशाचर।\nइच्छन्ति त्वां विनश्यन्तमुपरुद्धं बलीयसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000237005, "chapter_id": 9237, "verse_number": "३-४१-५", "content_sanskrit": "केनेदमुपदिष्टं ते क्षुद्रेणाहितबुद्धिना।\nयस्त्वामिच्छति नश्यन्तं स्वकृतेन निशाचर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000237006, "chapter_id": 9237, "verse_number": "३-४१-६", "content_sanskrit": "वध्याः खलु न वध्यन्ते सचिवास्तव रावण।\nये त्वामुत्पथमारूढं न निगृह्णन्ति सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000237007, "chapter_id": 9237, "verse_number": "३-४१-७", "content_sanskrit": "अमात्यैः कामवृत्तो हि राजा कापथमाश्रितः।\nनिग्राह्यः सर्वथा सद्भिः स निग्राह्यो न गृह्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000237008, "chapter_id": 9237, "verse_number": "३-४१-८", "content_sanskrit": "धर्ममर्थं च कामं च यशश्च जयतां वर।\nस्वामिप्रसादात् सचिवाः प्राप्नुवन्ति निशाचर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000237009, "chapter_id": 9237, "verse_number": "३-४१-९", "content_sanskrit": "विपर्यये तु तत्सर्वं व्यर्थं भवति रावण।\nव्यसनं स्वामिवैगुण्यात् प्राप्नुवन्तीतरे जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000237010, "chapter_id": 9237, "verse_number": "३-४१-१०", "content_sanskrit": "राजमूलो हि धर्मश्च यशश्च जयतां वर।\nतस्मात् सर्वास्ववस्थासु रक्षितव्या नराधिपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000237011, "chapter_id": 9237, "verse_number": "३-४१-११", "content_sanskrit": "राज्यं पालयितुं शक्यं न तीक्ष्णेन निशाचर।\nन चातिप्रतिकूलेन नाविनीतेन राक्षस ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000237012, "chapter_id": 9237, "verse_number": "३-४१-१२", "content_sanskrit": "ये तीक्ष्णमन्त्राः सचिवा भुज्यन्ते सह तेन वै।\nविषमेषु रथाः शीघ्रं मन्दसारथयो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000237013, "chapter_id": 9237, "verse_number": "३-४१-१३", "content_sanskrit": "बहवः साधवो लोके युक्तधर्ममनुष्ठिताः।\nपरेषामपराधेन विनष्टाः सपरिच्छदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000237014, "chapter_id": 9237, "verse_number": "३-४१-१४", "content_sanskrit": "स्वामिना प्रतिकूलेन प्रजास्तीक्ष्णेन रावण।\nरक्ष्यमाणा न वर्धन्ते मेषा गोमायुना यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000237015, "chapter_id": 9237, "verse_number": "३-४१-१५", "content_sanskrit": "अवश्यं विनशिष्यन्ति सर्वे रावण राक्षसाः।\nयेषां त्वं कर्कशो राजा दुर्बुद्धिरजितेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000237016, "chapter_id": 9237, "verse_number": "३-४१-१६", "content_sanskrit": "तदिदं काकतालीयं घोरमासादितं मया।\nअत्र त्वं शोचनीयोऽसि ससैन्यो विनशिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000237017, "chapter_id": 9237, "verse_number": "३-४१-१७", "content_sanskrit": "मां निहत्य तु रामोऽसावचिरात् त्वां वधिष्यति।\nअनेन कृतकृत्योऽस्मि म्रिये चाप्यरिणा हतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000237018, "chapter_id": 9237, "verse_number": "३-४१-१८", "content_sanskrit": "दर्शनादेव रामस्य हतं मामवधारय।\nआत्मानं च हतं विद्धि हृत्वा सीतां सबान्धवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000237019, "chapter_id": 9237, "verse_number": "३-४१-१९", "content_sanskrit": "आनयिष्यसि चेत् सीतामाश्रमात् सहितो मया।\nनैव त्वमपि नाहं वै नैव लङ्का न राक्षसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000237020, "chapter_id": 9237, "verse_number": "३-४१-२०", "content_sanskrit": "निवार्यमाणस्तु मया हितैषिणा\nन मृष्यसे वाक्यमिदं निशाचर।\nपरेतकल्पा हि गतायुषो नरा\nहितं न गृह्णन्ति सुहृद्भिरीरितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000237021, "chapter_id": 9237, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे एकचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]