[
  {
    "id": 20131398,
    "chapter_id": 7005,
    "verse_number": "23.1",
    "content_sanskrit": "अथ त्रयोविंशो ऽध्यायः",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20131399,
    "chapter_id": 7005,
    "verse_number": "23.2",
    "content_sanskrit": "विशेषयेत्कलाः सर्वा यस्मात्तस्मात्तु वैशिकः । वेशोपचारे साधुर्वा वैशिकः परिकीर्तितः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20131400,
    "chapter_id": 7005,
    "verse_number": "23.3",
    "content_sanskrit": "यो हि सर्वकलोपेतः सर्वशिल्पविचक्षणः । स्त्रीचित्तग्रहणाभिज्ञो वैशिकः स भवेत्पुमान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20131401,
    "chapter_id": 7005,
    "verse_number": "23.4",
    "content_sanskrit": "गुणस्तस्य तु विज्ञेयाः स्वशरीरसमुत्थिताः । आहार्याः सहजाश्चैव त्रयस्त्रिंशत्समासतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20131402,
    "chapter_id": 7005,
    "verse_number": "23.5",
    "content_sanskrit": "शास्त्रविच्छिल्पसंपन्नो रूपवान् प्रियदर्शनः । विक्रान्तो धृतिमांश्चैव वयोवेषकुलान्वितः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20131403,
    "chapter_id": 7005,
    "verse_number": "23.6",
    "content_sanskrit": "सुरभिर्मधुरस्त्यागि सहिष्णुरविकत्थनः । अशङ्कितः प्रियाभाषी चतुरः शुभदः शुचिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20131404,
    "chapter_id": 7005,
    "verse_number": "23.7",
    "content_sanskrit": "कामोपचारकुशलो दक्षिणो देशकालवित् । अदीनवाक्यः स्मितवान् वाग्मी दक्षः प्रियंवदः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20131405,
    "chapter_id": 7005,
    "verse_number": "23.8",
    "content_sanskrit": "स्त्रीलुब्धाः संविभागी च श्रद्धधानो दृढस्मृतिः । गम्यासु चाप्यविस्रम्भी मानी चेति हि वैशिकः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20131406,
    "chapter_id": 7005,
    "verse_number": "23.9",
    "content_sanskrit": "अनुयुक्तः शुचिर्दक्षो दक्षिणः प्रतिपत्तिमान् । भवेच्चित्राभिधायी च वयस्यस्तस्य तद्गुणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20131407,
    "chapter_id": 7005,
    "verse_number": "23.10",
    "content_sanskrit": "विज्ञानगुणसंपना कथिनी लिङ्गिनी तथा । प्रातिवेश्या सखी दासी कुमारी कारुशिल्पिनी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20131408,
    "chapter_id": 7005,
    "verse_number": "23.11",
    "content_sanskrit": "धात्री पाषण्डिनी चैव तथा रङ्गोपजीविनी । प्रोत्साहने ऽथकुशला मधुरकथा दक्षिणाथकालज्ञा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20131409,
    "chapter_id": 7005,
    "verse_number": "23.12",
    "content_sanskrit": "लडहा संवृतमन्त्रा दूती त्वेभिर्गुणैः कार्या । तयाप्युत्साहनं कार्यं नानादर्शितकारणम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20131410,
    "chapter_id": 7005,
    "verse_number": "23.13",
    "content_sanskrit": "यथोक्तकथनं चैव तथा भावप्रदर्शनम् । न जडं रूपसम्पन्नं नार्थवन्तं न चातुरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20131411,
    "chapter_id": 7005,
    "verse_number": "23.14",
    "content_sanskrit": "दूतं वाऽप्यथवा दूतीं बुधः कुर्यात्कदाचन । कुलभोगधनाधिक्यैः कृत्वाधिकविकत्थनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20131412,
    "chapter_id": 7005,
    "verse_number": "23.15",
    "content_sanskrit": "दूती निवेदयेत्काममर्थांश्चैवानुवर्णयेत् । न चाकामप्रवृत्तायाः कृद्धाया वापि सङ्गमः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20131413,
    "chapter_id": 7005,
    "verse_number": "23.16",
    "content_sanskrit": "नानुपायः प्रकर्तव्यो दूत्या हि पुरुषाश्रयः । उत्सवे रत्रिसञ्चार उद्द्याने मित्रवेश्मनि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20131414,
    "chapter_id": 7005,
    "verse_number": "23.17",
    "content_sanskrit": "धात्रिगृहेषु सख्या वा तथा चैव निमन्त्रणे । व्याधितव्यपदेशेन शुन्यागारनिवेशने ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20131415,
    "chapter_id": 7005,
    "verse_number": "23.18",
    "content_sanskrit": "कार्यः समागमो नॄणां स्त्रीभिः प्रथमसङ्गमे । एवं समागमं कृत्वा सोपायं विधिपूर्वकम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20131416,
    "chapter_id": 7005,
    "verse_number": "23.19",
    "content_sanskrit": "अनुरक्ता विरक्ता वा लिङ्गाकारैस्तु लक्षयेत् । स्वभावभावातिशयैर्नारी या मदनाश्रया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20131417,
    "chapter_id": 7005,
    "verse_number": "23.20",
    "content_sanskrit": "करोति निभृतां लीलां नित्यं सा मदनातुरा । सखीमध्ये गुणान् ब्रूते स्वधनं च प्रयच्छति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20131418,
    "chapter_id": 7005,
    "verse_number": "23.21",
    "content_sanskrit": "पूजयत्यस्य मित्राणि द्वेष्टि शत्रुजनं सदा । गमागमे सखीनां या हृष्टा भवति चाधिकम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20131419,
    "chapter_id": 7005,
    "verse_number": "23.22",
    "content_sanskrit": "तुष्यत्यस्य कथाभिस्तु सस्नेहं च निरीक्षते । सुप्ते तु पश्चात् स्वपिति चुम्बिता प्रतिचुम्बति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20131420,
    "chapter_id": 7005,
    "verse_number": "23.23",
    "content_sanskrit": "उत्तिष्ठत्यपि पूर्वं च तथा क्लेशसहापि च । उत्सवे मुदिता या च व्यसने या च दुःखिता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20131421,
    "chapter_id": 7005,
    "verse_number": "23.24",
    "content_sanskrit": "एवंविधैर्गुणैर्युक्ता त्वनुरक्ता तु सा स्मृता । विरक्तायास्तु चिन्हानि चुम्बिता नाभिचुम्बति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20131422,
    "chapter_id": 7005,
    "verse_number": "23.25",
    "content_sanskrit": "इति भारतीये नाट्यशास्त्रे त्रयोविंशः",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  }
]