[{"id": 2195673, "chapter_id": 5167, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2195674, "chapter_id": 5167, "verse_number": "१", "content_sanskrit": "विनता तु तथेत्युक्त्वा कृतसंशपथा पणे ।\nकद्रूरपि तथेत्युक्त्वा पुत्रानिदमुवाच ह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2195675, "chapter_id": 5167, "verse_number": "२", "content_sanskrit": "मया कृतः पणः पुत्रा मिथो विनतया सह ।\nउच्चैःश्रवसि गान्धर्वे तच्छृणुध्वं भुजङ्गमाः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2195676, "chapter_id": 5167, "verse_number": "३", "content_sanskrit": "अब्रवं नैकवर्णं तं सैकवर्णमथाब्रवीत् ।\nजिता दासी भवेत् पुत्राः सा वाऽहं वा न संशयः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2195677, "chapter_id": 5167, "verse_number": "४", "content_sanskrit": "एकवर्णश्च वाजी स चन्द्रकोकनदप्रभः ।\nसाऽहं दासी भविष्यामि जिता पुत्रा न संशयः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2195678, "chapter_id": 5167, "verse_number": "५", "content_sanskrit": "ते यूयमश्वप्रवरमाविशध्वमतन्द्रिताः ।\nसर्वे त्वेकं बालधिगा बाला भूत्वाञ्जनप्रभाः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2195679, "chapter_id": 5167, "verse_number": "", "content_sanskrit": "सर्पाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2195680, "chapter_id": 5167, "verse_number": "६", "content_sanskrit": "निकृत्या न जयः श्रेयान् मातः सत्या गिरः शृणु ।\nआयत्यां च तदात्वे च न च धर्मोऽत्र विद्यते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2195681, "chapter_id": 5167, "verse_number": "७", "content_sanskrit": "सा त्वं धर्मादपेतं वै कालस्यैव हितं वचः ।\nनिकृत्या विजयं मातर्मा स्म कार्षीः कथञ्चन\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2195682, "chapter_id": 5167, "verse_number": "८", "content_sanskrit": "यद्यधर्मेण विजयं वयं काङ्क्षामहे क्वचित् ।\nत्वया नाम निवार्याः स्म मा कुरुध्वमिति ब्रुवा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2195683, "chapter_id": 5167, "verse_number": "९", "content_sanskrit": "सा त्वमस्मानपि सतो विपापानृजुबुद्धिनः ।\nकल्मषेणाभिसंयोक्तुं काङ्क्षसे लोभमोहिता\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2195684, "chapter_id": 5167, "verse_number": "१०", "content_sanskrit": "ते वयं त्वां परित्यज्य द्रविष्याम दिशो दश ।\nयत्र वाक्यं न ते मातः पुनः श्रोष्याम ईदृशम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2195685, "chapter_id": 5167, "verse_number": "११", "content_sanskrit": "गुरोरप्यवलिप्तस्य कार्याकार्यमजानतः ।\nउत्पथं प्रतिपन्नस्य परित्यागो विधीयते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2195686, "chapter_id": 5167, "verse_number": "", "content_sanskrit": "कद्रूः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2195687, "chapter_id": 5167, "verse_number": "१२", "content_sanskrit": "शृणोमि विविधा वाचो हेतुमत्यः समीरिताः ।\nवक्रगा मन्निकृत्यर्थं तदहं वो न रोचये\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2195688, "chapter_id": 5167, "verse_number": "१३", "content_sanskrit": "न च तत्पणितं मन्दाः शक्यं जेतुमतोऽन्यथा ।\nजिते निकृत्या श्रुत्वैतत्क्षेमं कुरुत पुत्रकाः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2195689, "chapter_id": 5167, "verse_number": "१४", "content_sanskrit": "श्वोऽहं प्रभातसमये जिता धर्मेण पुत्रकाः ।\nशैलूषिणी भविष्यामि विनताया न संशयः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2195690, "chapter_id": 5167, "verse_number": "१५", "content_sanskrit": "इह चामुत्र चार्थाय पुत्रानिच्छन्ति मातरः ।\nसेयमीहा विपन्ना मे युष्मानासाद्य सङ्गतान्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2195691, "chapter_id": 5167, "verse_number": "१६", "content_sanskrit": "इह वा तारयेत् पुत्रः प्रेत्य वा तारयेत् पितॄन् ।\nनात्र चित्रं भवेत् किञ्चित् पुनातीति च पुत्रता\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2195692, "chapter_id": 5167, "verse_number": "१७", "content_sanskrit": "ते यूयं तारणार्थाय मम पुत्रा मनोजवाः ।\nआविशध्वं हयश्रेष्ठं बाला भूत्वाऽञ्जनप्रभाः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2195693, "chapter_id": 5167, "verse_number": "१८", "content_sanskrit": "जानाम्यधर्मं सकलं विजिता विनता भवेत् ।\nनिकृत्या दासभावस्तु युष्मानप्यवपीडयेत्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2195694, "chapter_id": 5167, "verse_number": "१९", "content_sanskrit": "निकृत्या विजयो वेति दासत्वं वा पराभवे ।\nउभयं निश्चयं कृत्वा जयो वै धार्मिको वरः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2195695, "chapter_id": 5167, "verse_number": "२०", "content_sanskrit": "यद्यप्यधर्मो विजयो युष्मानेव स्पृशेत् पुनः ।\nगुरोर्वचनमास्थाय धर्मो वा सम्भविष्यति\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2195696, "chapter_id": 5167, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे गरुडोपाख्याने कद्रुसर्पसंवादो नाम अष्टादशोऽध्यायः ॥१८॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]