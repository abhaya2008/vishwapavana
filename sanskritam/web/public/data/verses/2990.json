[{"id": 2093290, "chapter_id": 2990, "verse_number": "१३-१२०-१", "content_sanskrit": "`युधिष्ठिर उवाच।\nकः फेनपेति नाम्नाऽसौ कथं वा भक्षितः पुरा।\nमृत उज्जीवितः कस्मात्कथं गोलोकमाश्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2093291, "chapter_id": 2990, "verse_number": "१३-१२०-२", "content_sanskrit": "विरुद्वे मानुषे लोके तथा समयवर्त्मसु।\nक्रते दैवं हि दुष्प्रपं मानुषेषु विशेषतः।\nसंशयो मे महानत्र तन्मे व्याख्यातुमर्हसि॥ भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2093292, "chapter_id": 2990, "verse_number": "१३-१२०-३", "content_sanskrit": "श्रूयते भार्गवे वंशे सुमित्रो नाम भारत।\nवेदाध्ययनसम्पन्नो विपुले तपसि स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2093293, "chapter_id": 2990, "verse_number": "१३-१२०-४", "content_sanskrit": "वानप्रस्थाश्रमे युक्तः स्वकर्मनिरतः सदा।\nविनयाचारतत्वज्ञः सर्वधर्मार्थकोविदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2093294, "chapter_id": 2990, "verse_number": "१३-१२०-५", "content_sanskrit": "यत्नात्त्रिषवणस्नायी संध्योपासनतत्परः।\nअग्निहोत्ररतः क्षान्तो जपञ्जुह्वच्च नित्यदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2093295, "chapter_id": 2990, "verse_number": "१३-१२०-६", "content_sanskrit": "पितृदेवांश्च नियतमतिर्थींश्च स पूजयन्।\nप्राणसन्धारणार्थं च यत्किंचिदुपहारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2093296, "chapter_id": 2990, "verse_number": "१३-१२०-७", "content_sanskrit": "गिरिस्त्रिशिखरो नाम यतः प्रभवते नदी।\nकुलजेति पुराणेषु विश्रुता रुद्रनिर्मिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2093297, "chapter_id": 2990, "verse_number": "१३-१२०-८", "content_sanskrit": "तस्यास्तीरे समे देशे पुष्पमालासमाकुले।\nवन्यौषधिद्रुमोपेते नानापक्षिमृगायुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2093298, "chapter_id": 2990, "verse_number": "१३-१२०-९", "content_sanskrit": "व्यपेतदंशमशके ध्वाङ्क्षगृध्रैरसेविते।\nकृष्णदर्भतृणप्राये सुरम्ये ज्योतिरश्मिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2093299, "chapter_id": 2990, "verse_number": "१३-१२०-१०", "content_sanskrit": "सर्वोन्नतैः समैः श्यामैर्याज्ञीयैस्तरुभिर्वृते।\nतत्राश्रमपदं पुण्यं भृगूणामभवत्पुरा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2093300, "chapter_id": 2990, "verse_number": "१३-१२०-११", "content_sanskrit": "उवास तत्र नियतः सुमित्रो नाम भार्गवः।\nयथोद्दिष्टेन पूर्वेषां भृगूणां साधुवर्त्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2093301, "chapter_id": 2990, "verse_number": "१३-१२०-१२", "content_sanskrit": "तस्मा आङ्गिरसः कश्चिद्ददौ गां शर्करीं शुभाम्।\nवर्षासु पश्चिमे मासि पौर्णमास्यां शुचिव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2093302, "chapter_id": 2990, "verse_number": "१३-१२०-१३", "content_sanskrit": "स तां लब्ध्वा धर्मशीलश्चिन्तयामास तत्परः।\nसुमित्रः परया भक्त्या जननीमिव मातरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2093303, "chapter_id": 2990, "verse_number": "१३-१२०-१४", "content_sanskrit": "तेन सन्धुक्ष्यमाणा सा रोहिणी कामरूपिणी।\nप्रवृद्धिमगमच्छ्रेष्ठा प्राणतश्च सुदर्शना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2093304, "chapter_id": 2990, "verse_number": "१३-१२०-१५", "content_sanskrit": "सिराविमुक्तपार्श्वान्ता विपुलां कान्तिमुद्वहत्।\nश्यामपार्श्वान्तपृष्ठा सा सुरभिर्मधुपिङ्गला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2093305, "chapter_id": 2990, "verse_number": "१३-१२०-१६", "content_sanskrit": "बृहती सूक्ष्मरोमान्ता रूपोदग्रा तनुत्वचा।\nकृष्णपुच्छा श्वेतवक्त्रा समवृत्तपयोधरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2093306, "chapter_id": 2990, "verse_number": "१३-१२०-१७", "content_sanskrit": "पृष्ठोन्नता पूर्वनता शङ्कुकर्णी सुलोचना।\nदीर्घजिह्वा ह्रस्वशृङ्गी सम्पूर्णदशनान्तरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2093307, "chapter_id": 2990, "verse_number": "१३-१२०-१८", "content_sanskrit": "मांसाधिकगलान्ता सा प्रसन्ना शुभदर्शना।\nनित्यं शमयुता स्निग्धा सम्पूर्णोदात्तनिस्वना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2093308, "chapter_id": 2990, "verse_number": "१३-१२०-१९", "content_sanskrit": "प्राजापत्यैर्गवां नित्यं प्रशस्तैर्लक्षणैर्युता।\nयौवनस्थेव वनिता शुशुभे रूपशोभया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2093309, "chapter_id": 2990, "verse_number": "१३-१२०-२०", "content_sanskrit": "वृषेणोपगता सा तु कल्या मधुरदर्शना।\nमिथुनं जनयामास तुल्यरूपमिवात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2093310, "chapter_id": 2990, "verse_number": "१३-१२०-२१", "content_sanskrit": "संवर्धयामास स तां सवत्सां भार्गवो मुनिः।\nतयोः प्रजाधिसंसर्गात्सहस्रं च गवामभूत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2093311, "chapter_id": 2990, "verse_number": "१३-१२०-२२", "content_sanskrit": "गवां जातिसहस्राणि सम्भूतानि परस्परम्।\nऋषभाणां च राजेन्द्र नैवान्तः प्रतिदृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2093312, "chapter_id": 2990, "verse_number": "१३-१२०-२३", "content_sanskrit": "तैराश्रमपदं रम्यमरण्यं चैव सर्वशः।\nसमाकुलं समभवन्मेघैरिव नभस्थलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2093313, "chapter_id": 2990, "verse_number": "१३-१२०-२४", "content_sanskrit": "कानि चित्पद्मवर्णानि किंशुकाभानि कानिचित्।\nरुक्मवर्णानि चान्यानि चन्द्रांशुसदृशानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2093314, "chapter_id": 2990, "verse_number": "१३-१२०-२५", "content_sanskrit": "तथा राजतवर्णानि कानिचिल्लोहितानि वै।\nनीललोहितताम्राणि कृष्णानि कपिलानि च।\nनानारागविचित्राणि यूथानि कुलयूथप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2093315, "chapter_id": 2990, "verse_number": "१३-१२०-२६", "content_sanskrit": "न च क्षीरं सुतस्नेहाद्वत्सानामुपजीवति।\nभार्गवः केवलं चासीद्गवां प्राणायने रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2093316, "chapter_id": 2990, "verse_number": "१३-१२०-२७", "content_sanskrit": "तथा शुश्रूषतस्तस्य गवां हितमवेक्षतः।\nव्यतीयात्सुमाहान्कालो वत्सोच्छिष्टेन वर्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2093317, "chapter_id": 2990, "verse_number": "१३-१२०-२८", "content_sanskrit": "क्षुत्पिपासापरिश्रान्तः सततं प्रस्रवं गवाम्।\nवत्सैरुच्छिष्टमुदितं बहुक्षीरतया बहु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2093318, "chapter_id": 2990, "verse_number": "१३-१२०-२९", "content_sanskrit": "पीतवांस्तेन नामास्य फेनपेत्यभिविश्रुतम्।\nगौतमस्याभिनिष्पन्नमेवं नाम युधिष्ठिर॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2093319, "chapter_id": 2990, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि विंशत्यधिकशततमोऽध्यायः॥ १२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]