[{"id": 40018732, "chapter_id": 9293, "verse_number": "1", "content_sanskrit": "स तेनतुतदाक्रोधात्काकुत्स्थेनार्दितोरणे । रावणस्समरश्लाघिमहाक्रोधामुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40018733, "chapter_id": 9293, "verse_number": "2", "content_sanskrit": "स दीप्तनयनोरोषाच्चापमायाम्यवीर्यवान् । अभ्यर्दयत्सुसङ्कृद्धोराघवंपरमाहवे ॥ बाणधारसहस्रैस्तैस्सतोयदइवाम्बरात् । राघवंरावणोबाणैस्तटकमिवपूरयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40018734, "chapter_id": 9293, "verse_number": "3", "content_sanskrit": "स दीप्तनयनोरोषाच्चापमायाम्यवीर्यवान् । अभ्यर्दयत्सुसङ्कृद्धोराघवंपरमाहवे ॥ बाणधारसहस्रैस्तैस्सतोयदइवाम्बरात् । राघवंरावणोबाणैस्तटकमिवपूरयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40018735, "chapter_id": 9293, "verse_number": "4", "content_sanskrit": "पूरितःशरजालेनधनुर्मुक्तेनसम्युगे । महागिरिरिवाकम्प्यःकाकुत्स्थो न प्रकम्पते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40018736, "chapter_id": 9293, "verse_number": "5", "content_sanskrit": "स शरैश्शरजालानिवारयन् समरेस्थितः । गभस्तीनिवसूर्यस्यप्रतिजग्राहवीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40018737, "chapter_id": 9293, "verse_number": "6", "content_sanskrit": "ततश्शरसहस्राणिक्षिप्रहस्तोनिशाचरः । निजघानोरसिक्रुद्धोराघवस्यमहात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40018738, "chapter_id": 9293, "verse_number": "7", "content_sanskrit": "स शोणितसमादिग्धस्समरेलक्ष्मणाग्रजः । दृष्टःफुल्लइवारण्येसुमहान् किंशुकद्रुमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40018739, "chapter_id": 9293, "verse_number": "8", "content_sanskrit": "शराभिघातसम्रब्दःसोऽभिजग्राहसायकान् । काकुत्स्थ: सुमहातेजायुगान्तादित्यतेजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40018740, "chapter_id": 9293, "verse_number": "9", "content_sanskrit": "ततोऽन्योन्यंसुसम्रब्धौतावुभौरामरावणौ । शरान्धकारेसमरेनोपलक्ष्यतांतदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40018741, "chapter_id": 9293, "verse_number": "10", "content_sanskrit": "ततःक्रोधसमाविष्टोरामोदशरथात्मजः । उवाचरावणंवीरःप्रहस्यपरुषंवचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40018742, "chapter_id": 9293, "verse_number": "11", "content_sanskrit": "ममभार्याजनस्थानादज्ञानाद्राक्षसाधम । हृतातेविवशायस्मात्तस्मात्त्वंनासिवीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40018743, "chapter_id": 9293, "verse_number": "12", "content_sanskrit": "मयाविरहितांदीनांवर्तमानांमहावने । वैदेहींप्रसभंहृत्वाशूरोऽहमितिमन्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40018744, "chapter_id": 9293, "verse_number": "13", "content_sanskrit": "स्त्रीषुशूरविनाथासुपरदाराभिमर्शक । कृत्वाकापुरुषंकर्मशूरोऽहमितिमन्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40018745, "chapter_id": 9293, "verse_number": "14", "content_sanskrit": "भिन्नमर्यादनिर्लज्ज चारित्रेष्वनवस्थित । दर्पान्मृत्युमुपादायशूरोऽहमितिमन्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40018746, "chapter_id": 9293, "verse_number": "15", "content_sanskrit": "शूरेणधनदभ्रात्राबलैःसमुदितेन च । श्लाघनीयंमहत्कर्मयशस्यं च कृतंत्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40018747, "chapter_id": 9293, "verse_number": "16", "content_sanskrit": "उत्सेकानाभिपन्नस्यगर्हितस्याहितस्य च । कर्मणःप्राप्नुहीदानांतस्याद्यसुमहत्फलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40018748, "chapter_id": 9293, "verse_number": "17", "content_sanskrit": "शूरोऽहमितिचात्मानमवगच्छसिदुर्मते । नैवलज्जास्तितेसीतांचौरवद्वृपकर्षतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40018749, "chapter_id": 9293, "verse_number": "18", "content_sanskrit": "यदिमत्सन्निधौसीताधर्षितास्यात्त्वयाबलात् । भ्रातरंतुखरंपश्येस्तदामत्सायकैर्हतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40018750, "chapter_id": 9293, "verse_number": "19", "content_sanskrit": "दिष्ट्यासिममदुष्टात्मश्चक्षुर्विषयमागतः । अद्यत्वांसायकैस्तीक्ष्णैर्नयामियमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40018751, "chapter_id": 9293, "verse_number": "20", "content_sanskrit": "अद्यतेमच्छरैश्चिन्नंशिरोज्वलितकुण्डलम् । क्रव्यादाव्यपकर्षन्तुविकीर्णंरणपांसुषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40018752, "chapter_id": 9293, "verse_number": "21", "content_sanskrit": "निपत्योरसिगृध्रास्तेक्षितौक्षिप्तस्यरावण । पिबन्तुरुधिरंतर्षाद्बाणशल्यान्तरोत्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40018753, "chapter_id": 9293, "verse_number": "22", "content_sanskrit": "अद्यमद्बाणभिन्नस्यगतासोःपतितस्यते । कर्षन्त्वन्त्राणिपतगागरुत्मन्तइवोरगान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40018754, "chapter_id": 9293, "verse_number": "23", "content_sanskrit": "इत्येवं स वदन्वीरोरामश्शत्रुनिबर्हणः । राक्षसेन्द्रंसमीपस्थंशरवर्षैरवाकिरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40018755, "chapter_id": 9293, "verse_number": "24", "content_sanskrit": "बभूवद्विगुणंवीर्यंबलंहर्षश्चसंयुगे । रामस्यास्त्रबलंचैवशत्रोर्निधनकाङ्क्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40018756, "chapter_id": 9293, "verse_number": "25", "content_sanskrit": "प्रादुर्भभूवुरस्त्राणिसर्वाणिविदितात्मनः । प्रहर्षाच्चमहातेजाश्शीघ्रहस्ततरोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40018757, "chapter_id": 9293, "verse_number": "26", "content_sanskrit": "शुभान्येतानिचिह्नानिविज्ञायात्मगतानिसः । भूयएवार्दयद्रामोरावणंराक्षसान्तकृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40018758, "chapter_id": 9293, "verse_number": "27", "content_sanskrit": "हरीणांचाश्मनिकरैश्शरवर्षाच्चराघवात् । हन्यमानोदशग्रीवोविघूर्णहृदयोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40018759, "chapter_id": 9293, "verse_number": "28", "content_sanskrit": "यदा च शस्त्रंनारेभे न चकर्षशरासनम् । नास्यप्रत्यकरोवदीर्यंविक्लबेनान्तरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40018760, "chapter_id": 9293, "verse_number": "29", "content_sanskrit": "क्षिप्ताःश्चाशुशरास्तेनशस्त्राणिविविधानि च । मरणार्थायवर्तन्तेमृत्युकालोऽभ्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40018761, "chapter_id": 9293, "verse_number": "30", "content_sanskrit": "सूतस्तुरथनेतास्यतदवस्थंनिरीक्ष्यतम् । शनैर्युद्धासम्भ्रान्तोरथंतस्यापवाहयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]