[{"id": 5000293000, "chapter_id": 9293, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे एकविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000293001, "chapter_id": 9293, "verse_number": "४-२१-१", "content_sanskrit": "ततो निपतितां तारां च्युतां तारामिवाम्बरात्।\nशनैराश्वासयामास हनुमान् हरियूथपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000293002, "chapter_id": 9293, "verse_number": "४-२१-२", "content_sanskrit": "गुणदोषकृतं जन्तुः स्वकर्म फलहेतुकम्।\nअव्यग्रस्तदवाप्नोति सर्वं प्रेत्य शुभाशुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000293003, "chapter_id": 9293, "verse_number": "४-२१-३", "content_sanskrit": "शोच्या शोचसि कं शोच्यं दीनं दीनानुकम्पसे।\nकश्च कस्यानुशोच्योऽस्ति देहेऽस्मिन् बुद‍्बुदोपमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000293004, "chapter_id": 9293, "verse_number": "४-२१-४", "content_sanskrit": "अङ्गदस्तु कुमारोऽयं द्रष्टव्यो जीवपुत्रया।\nआयत्यां च विधेयानि समर्थान्यस्य चिन्तय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000293005, "chapter_id": 9293, "verse_number": "४-२१-५", "content_sanskrit": "जानास्यनियतामेवं भूतानामागतिं गतिम्।\nतस्माच्छुभं हि कर्तव्यं पण्डिते नेह लौकिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000293006, "chapter_id": 9293, "verse_number": "४-२१-६", "content_sanskrit": "यस्मिन् हरिसहस्राणि शतानि नियुतानि च।\nवर्तयन्ति कृताशानि सोऽयं दिष्टान्तमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000293007, "chapter_id": 9293, "verse_number": "४-२१-७", "content_sanskrit": "यदयं न्यायदृष्टार्थः सामदानक्षमापरः।\nगतो धर्मजितां भूमिं नैनं शोचितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000293008, "chapter_id": 9293, "verse_number": "४-२१-८", "content_sanskrit": "सर्वे च हरिशार्दूलाः पुत्रश्चायं तवाङ्गदः।\nहर्यृक्षपतिराज्यं च त्वत्सनाथमनिन्दिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000293009, "chapter_id": 9293, "verse_number": "४-२१-९", "content_sanskrit": "ताविमौ शोकसंतप्तौ शनैः प्रेरय भामिनि।\nत्वया परिगृहीतोऽयमङ्गदः शास्तु मेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000293010, "chapter_id": 9293, "verse_number": "४-२१-१०", "content_sanskrit": "संततिश्च यथा दृष्टा कृत्यं यच्चापि साम्प्रतम्।\nराज्ञस्तत् क्रियतां सर्वमेष कालस्य निश्चयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000293011, "chapter_id": 9293, "verse_number": "४-२१-११", "content_sanskrit": "संस्कार्यो हरिराजस्तु अङ्गदश्चाभिषिच्यताम्।\nसिंहासनगतं पुत्रं पश्यन्ती शान्तिमेष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000293012, "chapter_id": 9293, "verse_number": "४-२१-१२", "content_sanskrit": "सा तस्य वचनं श्रुत्वा भर्तृव्यसनपीडिता।\nअब्रवीदुत्तरं तारा हनूमन्तमवस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000293013, "chapter_id": 9293, "verse_number": "४-२१-१३", "content_sanskrit": "अङ्गदप्रतिरूपाणां पुत्राणामेकतः शतम्।\nहतस्याप्यस्य वीरस्य गात्रसंश्लेषणं वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000293014, "chapter_id": 9293, "verse_number": "४-२१-१४", "content_sanskrit": "न चाहं हरिराज्यस्य प्रभवाम्यङ्गदस्य वा।\nपितृव्यस्तस्य सुग्रीवः सर्वकार्येष्वनन्तरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000293015, "chapter_id": 9293, "verse_number": "४-२१-१५", "content_sanskrit": "नह्येषा बुद्धिरास्थेया हनूमन्नङ्गदं प्रति।\nपिता हि बन्धुः पुत्रस्य न माता हरिसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000293016, "chapter_id": 9293, "verse_number": "४-२१-१६", "content_sanskrit": "नहि मम हरिराजसंश्रयात्\nक्षमतरमस्ति परत्र चेह वा।\nअभिमुखहतवीरसेवितं\nशयनमिदं मम सेवितुं क्षमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000293017, "chapter_id": 9293, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे एकविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]