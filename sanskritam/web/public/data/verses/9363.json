[{"id": 5000363000, "chapter_id": 9363, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे चतुर्विंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000363001, "chapter_id": 9363, "verse_number": "५-२४-१", "content_sanskrit": "ततः सीतां समस्तास्ता राक्षस्यो विकृताननाः।\nपरुषं परुषानर्हामूचुस्तद्वाक्यमप्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000363002, "chapter_id": 9363, "verse_number": "५-२४-२", "content_sanskrit": "किं त्वमन्तःपुरे सीते सर्वभूतमनोरमे।\nमहार्हशयनोपेते न वासमनुमन्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000363003, "chapter_id": 9363, "verse_number": "५-२४-३", "content_sanskrit": "मानुषी मानुषस्यैव भार्यात्वं बहु मन्यसे।\nप्रत्याहर मनो रामान्नैवं जातु भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000363004, "chapter_id": 9363, "verse_number": "५-२४-४", "content_sanskrit": "त्रैलोक्यवसुभोक्तारं रावणं राक्षसेश्वरम्।\nभर्तारमुपसंगम्य विहरस्व यथासुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000363005, "chapter_id": 9363, "verse_number": "५-२४-५", "content_sanskrit": "मानुषी मानुषं तं तु राममिच्छसि शोभने।\nराज्याद् भ्रष्टमसिद्धार्थं विक्लवन्तमनिन्दिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000363006, "chapter_id": 9363, "verse_number": "५-२४-६", "content_sanskrit": "राक्षसीनां वचः श्रुत्वा सीता पद्मनिभेक्षणा।\nनेत्राभ्यामश्रुपूर्णाभ्यामिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000363007, "chapter_id": 9363, "verse_number": "५-२४-७", "content_sanskrit": "यदिदं लोकविद्विष्टमुदाहरत संगताः।\nनैतन्मनसि वाक्यं मे किल्बिषं प्रतितिष्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000363008, "chapter_id": 9363, "verse_number": "५-२४-८", "content_sanskrit": "न मानुषी राक्षसस्य भार्या भवितुमर्हति।\nकामं खादत मां सर्वा न करिष्यामि वो वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000363009, "chapter_id": 9363, "verse_number": "५-२४-९", "content_sanskrit": "दीनो वा राज्यहीनो वा यो मे भर्ता स मे गुरुः।\nतं नित्यमनुरक्तास्मि यथा सूर्यं सुवर्चला ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000363010, "chapter_id": 9363, "verse_number": "५-२४-१०", "content_sanskrit": "यथा शची महाभागा शक्रं समुपतिष्ठति।\nअरुन्धती वसिष्ठं च रोहिणी शशिनं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000363011, "chapter_id": 9363, "verse_number": "५-२४-११", "content_sanskrit": "लोपामुद्रा यथागस्त्यं सुकन्या च्यवनं यथा।\nसावित्री सत्यवन्तं च कपिलं श्रीमती यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000363012, "chapter_id": 9363, "verse_number": "५-२४-१२", "content_sanskrit": "सौदासं मदयन्तीव केशिनी सगरं यथा।\nनैषधं दमयन्तीव भैमी पतिमनुव्रता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000363013, "chapter_id": 9363, "verse_number": "५-२४-१३", "content_sanskrit": "तथाहमिक्ष्वाकुवरं रामं पतिमनुव्रता।\nसीताया वचनं श्रुत्वा राक्षस्यः क्रोधमूर्च्छिताः।\nभर्त्सयन्ति स्म परुषैर्वाक्यै रावणचोदिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000363014, "chapter_id": 9363, "verse_number": "५-२४-१४", "content_sanskrit": "अवलीनः स निर्वाक्यो हनुमान् शिंशपाद्रुमे।\nसीतां संतर्जयन्तीस्ता राक्षसीरशृणोत् कपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000363015, "chapter_id": 9363, "verse_number": "५-२४-१५", "content_sanskrit": "तामभिक्रम्य संरब्धा वेपमानां समन्ततः।\nभृशं संलिलिहुर्दीप्तान् प्रलम्बान् दशनच्छदान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000363016, "chapter_id": 9363, "verse_number": "५-२४-१६", "content_sanskrit": "ऊचुश्च परमक्रुद्धाः प्रगृह्याशु परश्वधान्।\nनेयमर्हति भर्तारं रावणं राक्षसाधिपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000363017, "chapter_id": 9363, "verse_number": "५-२४-१७", "content_sanskrit": "सा भर्त्स्यमाना भीमाभी राक्षसीभिर्वरांगना।\nसा बाष्पमपमार्जन्ती शिंशपां तामुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000363018, "chapter_id": 9363, "verse_number": "५-२४-१८", "content_sanskrit": "ततस्तां शिंशपां सीता राक्षसीभिः समावृता।\nअभिगम्य विशालाक्षी तस्थौ शोकपरिप्लुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000363019, "chapter_id": 9363, "verse_number": "५-२४-१९", "content_sanskrit": "तां कृशां दीनवदनां मलिनाम्बरवासिनीम्।\nभर्त्सयाञ्चक्रिरे भीमा राक्षस्यस्ताः समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000363020, "chapter_id": 9363, "verse_number": "५-२४-२०", "content_sanskrit": "ततस्तु विनता नाम राक्षसी भीमदर्शना।\nअब्रवीत् कुपिताकारा कराला निर्णतोदरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000363021, "chapter_id": 9363, "verse_number": "५-२४-२१", "content_sanskrit": "सीते पर्याप्तमेतावद् भर्तुः स्नेहः प्रदर्शितः।\nसर्वत्रातिकृतं भद्रे व्यसनायोपकल्पते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000363022, "chapter_id": 9363, "verse_number": "५-२४-२२", "content_sanskrit": "परितुष्टास्मि भद्रं ते मानुषस्ते कृतो विधिः।\nममापि तु वचः पथ्यं ब्रुवन्त्याः कुरु मैथिलि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000363023, "chapter_id": 9363, "verse_number": "५-२४-२३", "content_sanskrit": "रावणं भज भर्तारं भर्तारं सर्वरक्षसाम्।\nविक्रान्तमापतन्तं च सुरेशमिव वासवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000363024, "chapter_id": 9363, "verse_number": "५-२४-२४", "content_sanskrit": "दक्षिणं त्यागशीलं च सर्वस्य प्रियवादिनम्।\nमानुषं कृपणं रामं त्यक्त्वा रावणमाश्रय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000363025, "chapter_id": 9363, "verse_number": "५-२४-२५", "content_sanskrit": "दिव्यांगरागा वैदेहि दिव्याभरणभूषिता।\nअद्यप्रभृति लोकानां सर्वेषामीश्वरी भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000363026, "chapter_id": 9363, "verse_number": "५-२४-२६", "content_sanskrit": "अग्नेः स्वाहा यथा देवी शची वेन्द्रस्य शोभने।\nकिं ते रामेण वैदेहि कृपणेन गतायुषा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000363027, "chapter_id": 9363, "verse_number": "५-२४-२७", "content_sanskrit": "एतदुक्तं च मे वाक्यं यदि त्वं न करिष्यसि।\nअस्मिन् मुहूर्ते सर्वास्त्वां भक्षयिष्यामहे वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000363028, "chapter_id": 9363, "verse_number": "५-२४-२८", "content_sanskrit": "अन्या तु विकटा नाम लम्बमानपयोधरा।\nअब्रवीत् कुपिता सीतां मुष्टिमुद्यम्य तर्जती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000363029, "chapter_id": 9363, "verse_number": "५-२४-२९", "content_sanskrit": "बहून्यप्रतिरूपाणि वचनानि सुदुर्मते।\nअनुक्रोशान्मृदुत्वाच्च सोढानि तव मैथिलि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000363030, "chapter_id": 9363, "verse_number": "५-२४-३०", "content_sanskrit": "न च नः कुरुषे वाक्यं हितं कालपुरस्कृतम्।\nआनीतासि समुद्रस्य पारमन्यैर्दुरासदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000363031, "chapter_id": 9363, "verse_number": "५-२४-३१", "content_sanskrit": "रावणान्तःपुरे घोरे प्रविष्टा चासि मैथिलि।\nरावणस्य गृहे रुद्धा अस्माभिस्त्वभिरक्षिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000363032, "chapter_id": 9363, "verse_number": "५-२४-३२", "content_sanskrit": "न त्वां शक्तः परित्रातुमपि साक्षात् पुरंदरः।\nकुरुष्व हितवादिन्या वचनं मम मैथिलि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000363033, "chapter_id": 9363, "verse_number": "५-२४-३३", "content_sanskrit": "अलमश्रुनिपातेन त्यज शोकमनर्थकम्।\nभज प्रीतिं प्रहर्षं च त्यजन्ती नित्यदैन्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000363034, "chapter_id": 9363, "verse_number": "५-२४-३४", "content_sanskrit": "सीते राक्षसराजेन परिक्रीड यथासुखम्।\nजानीमहे यथा भीरु स्त्रीणां यौवनमध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000363035, "chapter_id": 9363, "verse_number": "५-२४-३५", "content_sanskrit": "यावन्न ते व्यतिक्रामेत् तावत् सुखमवाप्नुहि।\nउद्यानानि च रम्याणि पर्वतोपवनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000363036, "chapter_id": 9363, "verse_number": "५-२४-३६", "content_sanskrit": "सह राक्षसराजेन चर त्वं मदिरेक्षणे।\nस्त्रीसहस्राणि ते देवि वशे स्थास्यन्ति सुन्दरि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000363037, "chapter_id": 9363, "verse_number": "५-२४-३७", "content_sanskrit": "रावणं भज भर्तारं भर्तारं सर्वरक्षसाम्।\nउत्पाट्य वा ते हृदयं भक्षयिष्यामि मैथिलि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000363038, "chapter_id": 9363, "verse_number": "५-२४-३८", "content_sanskrit": "यदि मे व्याहृतं वाक्यं न यथावत् करिष्यसि।\nततश्चण्डोदरी नाम राक्षसी क्रूरदर्शना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000363039, "chapter_id": 9363, "verse_number": "५-२४-३९", "content_sanskrit": "भ्रामयन्ती महच्छूलमिदं वचनमब्रवीत्।\nइमां हरिणशावाक्षीं त्रासोत्कम्पपयोधराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000363040, "chapter_id": 9363, "verse_number": "५-२४-४०", "content_sanskrit": "रावणेन हृतां दृष्ट्वा दौर्हृदो मे महानयम्।\nयकृत्प्लीहं महत् क्रोडं हृदयं च सबन्धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000363041, "chapter_id": 9363, "verse_number": "५-२४-४१", "content_sanskrit": "गात्राण्यपि तथा शीर्षं खादेयमिति मे मतिः।\nततस्तु प्रघसा नाम राक्षसी वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000363042, "chapter_id": 9363, "verse_number": "५-२४-४२", "content_sanskrit": "कण्ठमस्या नृशंसायाः पीडयामः किमास्यते।\nनिवेद्यतां ततो राज्ञे मानुषी सा मृतेति ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000363043, "chapter_id": 9363, "verse_number": "५-२४-४३", "content_sanskrit": "नात्र कश्चन संदेहः खादतेति स वक्ष्यति।\nततस्त्वजामुखी नाम राक्षसी वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000363044, "chapter_id": 9363, "verse_number": "५-२४-४४", "content_sanskrit": "विशस्येमां ततः सर्वान् समान् कुरुत पिण्डकान्।\nविभजाम ततः सर्वा विवादो मे न रोचते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000363045, "chapter_id": 9363, "verse_number": "५-२४-४५", "content_sanskrit": "पेयमानीयतां क्षिप्रं माल्यं च विविधं बहु।\nततः शूर्पणखा नाम राक्षसी वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000363046, "chapter_id": 9363, "verse_number": "५-२४-४६", "content_sanskrit": "अजामुख्या यदुक्तं वै तदेव मम रोचते।\nसुरा चानीयतां क्षिप्रं सर्वशोकविनाशिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000363047, "chapter_id": 9363, "verse_number": "५-२४-४७", "content_sanskrit": "मानुषं मांसमास्वाद्य नृत्यामोऽथ निकुम्भिलाम्।\nएवं निर्भर्त्स्यमाना सा सीता सुरसुतोपमा।\nराक्षसीभिर्विरूपाभिर्धैर्यमुत्सृज्य रोदिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000363048, "chapter_id": 9363, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे चतुर्विंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]