[{"id": 2135292, "chapter_id": 3930, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2135293, "chapter_id": 3930, "verse_number": "१", "content_sanskrit": "दुर्योधनं मोक्षयित्वा पाण्डुपुत्रा महाबलाः ।\nकिमकार्षुर्वने तस्मिंस्तन्ममाख्यातुमर्हसि \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2135294, "chapter_id": 3930, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2135295, "chapter_id": 3930, "verse_number": "२", "content_sanskrit": "ततः शयानं कौन्तेयं रात्रौ द्वैतवने मृगाः ।\nस्वप्नान्ते दर्शयामासुर्बाष्पकण्ठा युधिष्ठिरम् ।\nतानब्रवीत् स राजेन्द्रो वेपमानान् कृताञ्जलीन् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2135296, "chapter_id": 3930, "verse_number": "३", "content_sanskrit": "ब्रूत यद्वक्तुकामाः स्थः के भवन्तः किमिष्यते \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2135297, "chapter_id": 3930, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2135298, "chapter_id": 3930, "verse_number": "४", "content_sanskrit": "एवमुक्ताः पाण्डवेन कौन्तेयेन यशस्विना ।\nप्रत्यब्रुवन् मृगास्तत्र हतशेषा युधिष्ठिरम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2135299, "chapter_id": 3930, "verse_number": "", "content_sanskrit": "मृगाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2135300, "chapter_id": 3930, "verse_number": "५", "content_sanskrit": "वयं मृगा द्वैतवने हतशिष्टास्तु भारत ।\nनोत्सीदेम महाभाग क्रियतां वासपर्ययः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2135301, "chapter_id": 3930, "verse_number": "६", "content_sanskrit": "भवतो भ्रातरः शूराः सर्व एवास्त्रकोविदाः ।\nकुलान्यल्पावशिष्टानि कृतवन्तो वनौकसाम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2135302, "chapter_id": 3930, "verse_number": "७", "content_sanskrit": "बीजभूता वयं केचिदवशिष्टा महामते ।\nविवर्धेमहि राजेन्द्र प्रसादात् ते युधिष्ठिर \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2135303, "chapter_id": 3930, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2135304, "chapter_id": 3930, "verse_number": "८", "content_sanskrit": "तान् वेपमानान् वित्रस्तान् बीजमात्रावशेषितान् ।\nमृगान् दृष्ट्वा सुदुःखार्तो धर्मराजो युधिष्ठिरः ।\nतांस्तथेत्यब्रवीद् राजा सर्वभूतहिते रतः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2135305, "chapter_id": 3930, "verse_number": "९", "content_sanskrit": "यथा भवन्तो ब्रुवते करिष्यामि च तत् तथा \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2135306, "chapter_id": 3930, "verse_number": "१०", "content_sanskrit": "इत्येवं प्रतिबुद्धः स रात्र्यन्ते राजसत्तमः ।\nअब्रवीत् सहितान् भ्रातॄन् दयापन्नो मृगान् प्रति \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2135307, "chapter_id": 3930, "verse_number": "११", "content_sanskrit": "उक्तं रात्रौ मृगैरस्मि स्वप्नान्ते हतशेषितैः ।\nअनुभूताः स्म भद्रं ते दया नः क्रियतामिति \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2135308, "chapter_id": 3930, "verse_number": "१२", "content_sanskrit": "ते सत्यमाहुः कर्तव्या दयाऽस्माभिर्वनौकसाम् ।\nसाष्टमासं हि नो वर्षं यदेनानु(तदु)पयुञ्ज्महे \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2135309, "chapter_id": 3930, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2135310, "chapter_id": 3930, "verse_number": "१३", "content_sanskrit": "त्वदधीना वयं राजन् मा त्वमस्मान् विचारय ।\nयत्रैव मन्यसे पार्थ तत्र गच्छामहे वयम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2135311, "chapter_id": 3930, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2135312, "chapter_id": 3930, "verse_number": "१४", "content_sanskrit": "पुनर्बहुमृगं रम्यं काम्यकं काननोत्तमम् ।\nमरुभूमेः शिरःस्थानं तृणबिन्दुसरः प्रति ।\nतत्रेमां वसतिं शिष्टां विहरन्तो रमेमहि \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2135313, "chapter_id": 3930, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2135314, "chapter_id": 3930, "verse_number": "१५", "content_sanskrit": "इत्युक्तास्ते महात्मानः पाण्डवेन महात्मना ।\nततस्ते पाण्डवाः शीघ्रं प्रययुर्धर्मकोविदाः ।\nब्राह्मणैः सहिता राजन् तत्रासन् समागताः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2135315, "chapter_id": 3930, "verse_number": "१६", "content_sanskrit": "इन्द्रसेनादिभिश्चैव प्रेष्यैरनुगतास्तदा \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2135316, "chapter_id": 3930, "verse_number": "१७", "content_sanskrit": "ते यात्वा सुसुखैर्मार्गैः स्वन्नैः शुचिजलान्वितैः ।\nददृशुः काम्यकं पुण्यमाश्रमं तापसैर्युतम् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2135317, "chapter_id": 3930, "verse_number": "१८", "content_sanskrit": "विविशुस्ते स्म कौरव्या वृता विप्रर्षभैस्तदा ।\nतद्वनं भरतश्रेष्ठाः स्वर्गं सुकृतिनो यथा \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2135318, "chapter_id": 3930, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि मृगस्वप्नोद्भवपर्वणि काम्यकप्रवेशे सप्तचत्वारिंशदधिकद्विशततमोऽध्यायः ॥२४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2135319, "chapter_id": 3930, "verse_number": "", "content_sanskrit": "॥ समाप्तं मृगस्वप्नोद्भवपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]