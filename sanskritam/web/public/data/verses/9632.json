[{"id": 5000632000, "chapter_id": 9632, "verse_number": "७-९७-१", "content_sanskrit": "वाल्मीकिनैवमुक्तस्तु राघवः प्रत्यभाषत ।\nप्राञ्जलिर्जगतो मध्ये दृष्ट्वा तां वरवर्णिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000632001, "chapter_id": 9632, "verse_number": "७-९७-२", "content_sanskrit": "एवमेतन्महाभाग यथा वदसि धर्मवित् ।\nप्रत्ययस्तु मम ब्रह्मंस्तव वाक्यैरकल्मषैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000632002, "chapter_id": 9632, "verse_number": "७-९७-३", "content_sanskrit": "प्रत्ययस्तु पुरा वृत्तो वैदेह्याः सुरसन्निधौ ।\nशपथस्तु कृतस्तत्र तेन वेश्म प्रवेशिता ।\nलोकापवादो बलवान्येन त्यक्ता हि मैथिली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000632003, "chapter_id": 9632, "verse_number": "७-९७-४", "content_sanskrit": "सेयं लोकभयाद्ब्रह्मन्नपापेत्यभिजानता ।\nपरित्यक्ता मया सीता तद्भावन्क्षन्तुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000632004, "chapter_id": 9632, "verse_number": "७-९७-५", "content_sanskrit": "जानामि चेमौ पुत्रौ मे यमजातौ कुशीलवौ ।\nशुद्धायां जगतो मध्ये मैथिल्यां प्रीतिरस्तु मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000632005, "chapter_id": 9632, "verse_number": "७-९७-६", "content_sanskrit": "अभिप्रायं तु विज्ञाय रामस्य सुरसत्तमाः ।\nसीतायाः शपथे तस्मिन् महेन्द्राद्या महौजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000632006, "chapter_id": 9632, "verse_number": "७-९७-७", "content_sanskrit": "पितामहं पुरस्कृत्य सर्व एव समागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000632007, "chapter_id": 9632, "verse_number": "७-९७-८", "content_sanskrit": "आदित्या वसवो रुद्रा ह्यश्विनौ समरुद्गणाः ।\nगन्धर्वाप्सरसश्चैव सर्व एव समागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000632008, "chapter_id": 9632, "verse_number": "७-९७-९", "content_sanskrit": "साध्याश्च विश्वेदेवाश्च सर्वे च परमर्षयः ।\nनागाः सुपर्णाः सिद्धाश्च ते सर्वे हृष्टमानसाः ।\nसीताशपथसम्भ्रान्ताः सर्व एव समागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000632009, "chapter_id": 9632, "verse_number": "७-९७-१०", "content_sanskrit": "दृष्ट्वा देवानृषींश्चैव राघवः पुनरब्रवीत् ।\nप्रत्ययो मे नरश्रेष्ठा ऋषिवाक्यैरकल्मषैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000632010, "chapter_id": 9632, "verse_number": "७-९७-११", "content_sanskrit": "शुद्धायां जगतो मध्ये वैदेह्यां प्रीतिरस्तु मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000632011, "chapter_id": 9632, "verse_number": "७-९७-१२", "content_sanskrit": "ततो वायुः शुभः पुण्यो दिव्यगन्धो मनोरमः ।\nतज्जनौघं सुरश्रेष्ठो ह्लादयामास सर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000632012, "chapter_id": 9632, "verse_number": "७-९७-१३", "content_sanskrit": "तदद्भुतमिवाचिन्त्यं निरैक्षन्त समागताः ।\nमानवाः सर्वराष्ट्रेभ्यः पूर्वं कृतयुगे यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000632013, "chapter_id": 9632, "verse_number": "७-९७-१४", "content_sanskrit": "सर्वान्समागतान्दृष्ट्वा सीता काषायवासिनी ।\nअब्रवीत्प्राञ्जलिर्वाक्यमधोदृष्टिरवाङ्मुखी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000632014, "chapter_id": 9632, "verse_number": "७-९७-१५", "content_sanskrit": "यथा ऽहं राघवादन्यं मनसापि न चिन्तये ।\nतथा मे माधवी देवी विवरं दातुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000632015, "chapter_id": 9632, "verse_number": "७-९७-१६", "content_sanskrit": "मनसा कर्मणा वाचा यथा रामं समर्चये ।\nतथा मे माधवी देवी विवरं दातुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000632016, "chapter_id": 9632, "verse_number": "७-९७-१७", "content_sanskrit": "यथैतत्सत्यमुक्तं मे वेद्मि रामात्परं न च ।\nतथा मे माधवी देवी विवरं दातुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000632017, "chapter_id": 9632, "verse_number": "७-९७-१८", "content_sanskrit": "तथा शपन्त्यां वैदेह्यां प्रादुरासीत्तदद्भुतम् ।\nभूतलादुत्थितं दिव्यं सिंहासनमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000632018, "chapter_id": 9632, "verse_number": "७-९७-१९", "content_sanskrit": "ध्रियमाणं शिरोभिस्तु नागैरमितविक्रमैः ।\nदिव्यं दिव्येन वपुषा दिव्यरत्नविभूषितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000632019, "chapter_id": 9632, "verse_number": "७-९७-२०", "content_sanskrit": "तस्मिंस्तु धरणी देवी बाहुभ्यां गृह्य मैथिलीम् ।\nस्वागतेनाभिनन्द्यैनामासने चोपवेशयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000632020, "chapter_id": 9632, "verse_number": "७-९७-२१", "content_sanskrit": "तामासनगतां दृष्ट्वा प्रविशन्तीं रसातलम् ।\nपुष्पवृष्टिरविच्छिन्ना दिव्या सीतामवाकिरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000632021, "chapter_id": 9632, "verse_number": "७-९७-२२", "content_sanskrit": "साधुकारश्च सुमहान्देवानां सहसोत्थितः ।\nसाधु साध्विति वै सीते यस्यास्ते शीलमीदृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000632022, "chapter_id": 9632, "verse_number": "७-९७-२३", "content_sanskrit": "एवं बहुविधा वाचो ह्यन्तरिक्षगताः सुराः ।\nव्याजह्रुर्हृष्टमनसो दृष्ट्वा सीताप्रवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000632023, "chapter_id": 9632, "verse_number": "७-९७-२४", "content_sanskrit": "यज्ञवाटगताश्चापि मुनयः सर्व एव ते ।\nराजानश्च नरव्याघ्रा विस्मयान्नोपरेमिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000632024, "chapter_id": 9632, "verse_number": "७-९७-२५", "content_sanskrit": "अन्तरिक्षे च भूमौ च सर्वे स्थावरजङ्गमाः ।\nदानवाश्च महाकायाः पाताले पन्नगाधिपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000632025, "chapter_id": 9632, "verse_number": "७-९७-२६", "content_sanskrit": "केचिद्विनेदुः संहृष्टाः केचिद्ध्यानपरायणाः ।\nकेचिद्रामं निरीक्षन्ते केचित्सीतामचेतनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000632026, "chapter_id": 9632, "verse_number": "७-९७-२७", "content_sanskrit": "सीताप्रवेशनं दृष्ट्वा तेषामासीत्समागमः ।\nतन्मुहूर्तमिवात्यर्थं समं सम्मोहितं जगत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000632027, "chapter_id": 9632, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे सप्तनवतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]