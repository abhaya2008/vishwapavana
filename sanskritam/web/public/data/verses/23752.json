[{"id": 7003752000, "chapter_id": 23752, "verse_number": "२-१-३६-१", "content_sanskrit": "अथ वराहकृतधरण्युद्धरणक्रमः ।\nभरद्वाज उवाच ।\nपुरा निशात्यये धातुः प्रबुद्धो मधुसूदनः ।\nपुनः प्रवृत्तिं भूतानामन्वियेष धिया भृशम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003752001, "chapter_id": 23752, "verse_number": "२-१-३६-२", "content_sanskrit": "विना वसुमतीमन्ये भूतौघधरणक्षमाः ।\nन भवन्तीति हृदये तर्कस्तस्याजनिष्ट च ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003752002, "chapter_id": 23752, "verse_number": "२-१-३६-३", "content_sanskrit": "अपश्यत्प्रणिधानेन महीं पातालगोचराम् ।\nअतिमात्रभयोद्विग्नां परीतां महताम्बुना ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003752003, "chapter_id": 23752, "verse_number": "२-१-३६-४", "content_sanskrit": "प्रतिपेदे तदा रूपं भूसमुद्धरणोचितम् ।\nउपकर्मोष्ठमनलजिह्वं प्रणवघोषणम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003752004, "chapter_id": 23752, "verse_number": "२-१-३६-५", "content_sanskrit": "चतुराम्नायचरणं प्रायश्चित्तखुरांचितम् ।\nप्राग्वंशकायं विलसद्दर्भरोमावलीयुतम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003752005, "chapter_id": 23752, "verse_number": "२-१-३६-६", "content_sanskrit": "प्रवर्ग्यावर्तसंपन्नं दक्षिणाग्न्युदरान्वितम् ।\nस्रुक्तुण्डमखिलैः सर्वैः संविभक्तांगसन्धिकम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003752006, "chapter_id": 23752, "verse_number": "२-१-३६-७", "content_sanskrit": "दिव्यसूक्तसटाजालं परत्रह्मशिरस्तथा ।\nहव्यकव्यरयोपेतं विशुद्धपशुजानुकम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003752007, "chapter_id": 23752, "verse_number": "२-१-३६-८", "content_sanskrit": "उक्तात्युक्तादिकच्छन्दोमार्गमंत्र बलान्वितम् ।\nसर्वयज्ञमयं दिव्यं वाराहं रूपमास्थितः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003752008, "chapter_id": 23752, "verse_number": "२-१-३६-९", "content_sanskrit": "अन्वेष्टुं धरणीमब्धेर्विवेश सलिलांतरम् ।\nदंष्ट्राबालशशांकोत्थलसत्कांतिचयैर्हठात् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003752009, "chapter_id": 23752, "verse_number": "२-१-३६-१०", "content_sanskrit": "कल्पांतसमयस्फीतं तमिस्रमपसारयन् ।\nअभिभूतांबुभृद्घोषैर्मुहुर्ब्रह्माण्डकन्दराम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003752010, "chapter_id": 23752, "verse_number": "२-१-३६-११", "content_sanskrit": "निनादमुखरां कुर्वन्गाढैर्घुरुघुरुस्वनैः ।\nखुरप्रखुरविन्यासैर्जर्जरीकृतविग्रहम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003752011, "chapter_id": 23752, "verse_number": "२-१-३६-१२", "content_sanskrit": "इतस्ततो विलुठयन्नुरगाणामधीश्वरम् ।\nतीव्रैर्निःश्वासपवनैरापातालं सरित्पतेः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003752012, "chapter_id": 23752, "verse_number": "२-१-३६-१३", "content_sanskrit": "प्रापयन्नतलस्पर्शमन्तरं दर्शनीयताम् ।\nअतिदीर्घेण पात्रेण मग्नोन्मग्नेन वारिधेः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003752013, "chapter_id": 23752, "verse_number": "२-१-३६-१४", "content_sanskrit": "संक्षोभितानि पाथांसि कुर्वन्नन्तर्ययौ तदा ।\nसप्तपातालमूलाधः स्थितां तोये भयाकुलाम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003752014, "chapter_id": 23752, "verse_number": "२-१-३६-१५", "content_sanskrit": "वेपमानां समालोक्य धरणीं हृष्टमानसः ।\nतामारोप्य स्वदंष्ट्राग्रमुन्ममज्ज सरित्पतेः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003752015, "chapter_id": 23752, "verse_number": "२-१-३६-१६", "content_sanskrit": "संस्तूयमानो मुनिभिर्जनलोकनिवासिभिः ।\nतस्मिन्नुद्वहति प्रेम्णा देवे वसुमतीं क्षणम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003752016, "chapter_id": 23752, "verse_number": "२-१-३६-१७", "content_sanskrit": "प्रतिसारा बभूवाधो वारिधेमर्ङ्गलोचिता ।\nतदुत्तारणवेलायां वराहवपुषोऽर्जुन ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003752017, "chapter_id": 23752, "verse_number": "२-१-३६-१८", "content_sanskrit": "गम्भीरघोषैरम्भोधिः प्राप मंगलतूर्यताम् ।\nउद्वृत्तवीचिविक्षिप्तशीकरासारसंगतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003752018, "chapter_id": 23752, "verse_number": "२-१-३६-१९", "content_sanskrit": "भेजे मुक्ताफलचयो मंगलाक्षतविभ्रमम् ।\nउदूढा तेन देवेन सा बभौ सलिलाप्लुता ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003752019, "chapter_id": 23752, "verse_number": "२-१-३६-२०", "content_sanskrit": "गाढरागसमुत्पन्नस्वेदक्लिन्नतनूरिव ।\nइत्थमुद्धृत्य भगवान्महीं पातालमूलतः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003752020, "chapter_id": 23752, "verse_number": "२-१-३६-२१", "content_sanskrit": "सुदृढं स्थापयामास मध्येऽम्बुनिधिपाथसाम् ।\nतेनोद्धृतायां मेदिन्यां पूर्णं तद्भूनभोन्तरे ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003752021, "chapter_id": 23752, "verse_number": "२-१-३६-२२", "content_sanskrit": "जलं तत्कृतमर्यादाऽव्यवच्छिन्नमभूत्तदा ।\nसंस्थाप्य पृथिवीमित्थं तदीयाधारसिद्धये ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003752022, "chapter_id": 23752, "verse_number": "२-१-३६-२३", "content_sanskrit": "दिग्गजानहिराजं च कमठं च न्यवेशयत् ।\nतेषामपि च सर्वेषामाधारत्वेन सादरम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003752023, "chapter_id": 23752, "verse_number": "२-१-३६-२४", "content_sanskrit": "अव्यक्तरूपां स्वां शक्तिं युयोज च दयानिधिः ।\nततो धरां समुद्धृत्य स्थितं किटितनुं हरिम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003752024, "chapter_id": 23752, "verse_number": "२-१-३६-२५", "content_sanskrit": "तुष्टुवुः सनकाद्यास्तं जनलोकनिवासिनः ।\nतदा वराहवपुषमाराध्य पुरुषोत्तमम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003752025, "chapter_id": 23752, "verse_number": "२-१-३६-२६", "content_sanskrit": "तदाज्ञया जगद्ब्रह्मा यथापूर्वमकल्पयत् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003752026, "chapter_id": 23752, "verse_number": "२-१-३६-२७", "content_sanskrit": "अर्जुन उवाच ।\nकल्पान्तसलिले मग्ना कथं तिष्ठति भूरियम् ।\nसप्तपाताललोकाधः किमाधारा महामुने ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003752027, "chapter_id": 23752, "verse_number": "२-१-३६-२८", "content_sanskrit": "कल्पकालः कियानेष स्यात्तद्वृत्तिश्च कीदृशी ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003752028, "chapter_id": 23752, "verse_number": "२-१-३६-२९", "content_sanskrit": "अथ कल्पवृत्तांतवर्णनपूर्वकं श्वेतवराहावतारवर्णनम् ।\nएतद्विस्तार्य सकलं मम ब्रह्मन्मुने वद ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003752029, "chapter_id": 23752, "verse_number": "२-१-३६-३०", "content_sanskrit": "भरद्वाज उवाच ।\nविनाडिकानां षष्ट्या स्यान्नाडिकैका दिनं भवेत् ।\nतत्षष्ट्या दिवसास्त्रिंशन्मासः पक्षद्वयात्मकः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003752030, "chapter_id": 23752, "verse_number": "२-१-३६-३१", "content_sanskrit": "मासौ द्वावृतुरित्युक्तस्तैः षङ्भिर्वत्सरो भवेत् ।\nअयनद्वितयाकारः शीतवर्षोष्णसंश्रयः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003752031, "chapter_id": 23752, "verse_number": "२-१-३६-३२", "content_sanskrit": "देवासुराणामन्योयमहोरात्रं विपर्ययात् ।\nउत्तरं दक्षिणे भानोरयने ते यथाक्रमम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003752032, "chapter_id": 23752, "verse_number": "२-१-३६-३३", "content_sanskrit": "मानुषाब्दैः खखव्योमखाक्षिपावकसागरैः ।\nमहायुगं भवेत्पार्थ कृताद्याकारसंयुतम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003752033, "chapter_id": 23752, "verse_number": "२-१-३६-३४", "content_sanskrit": "सप्तत्या सैकया कालो युगानामन्तरं मनोः ।\nअस्मिञ्छ्वेतवराहाख्ये कल्पे जातान्मनूञ्छृणु ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003752034, "chapter_id": 23752, "verse_number": "२-१-३६-३५", "content_sanskrit": "स्वायंभुवः स्यात्प्रथमस्ततः स्वारोचिषो मनुः ।\nउत्तमस्तामसाख्यश्च रैवतश्चाक्षुषाह्वयः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003752035, "chapter_id": 23752, "verse_number": "२-१-३६-३६", "content_sanskrit": "एते गताः प्राङ्मनवः षट्सेन्द्रसुरतापसाः ।\nवैवस्वतो वर्ततेऽद्य सप्तमो मनुरर्जुन ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003752036, "chapter_id": 23752, "verse_number": "२-१-३६-३७", "content_sanskrit": "आदित्यवसुरुद्राद्यास्तत्काले देवतागणाः ।\nइष्ट्वाश्वमेधशतकं तेजस्वी प्राप शक्रताम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003752037, "chapter_id": 23752, "verse_number": "२-१-३६-३८", "content_sanskrit": "विश्वामित्रोऽहमत्रिश्च जमदग्निश्च कश्यपः ।\nवसिष्ठो गौतमश्चैव ते वै सप्तर्षयोऽर्जुन ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003752038, "chapter_id": 23752, "verse_number": "२-१-३६-३९", "content_sanskrit": "इक्ष्वाकुप्रमुखाः शूरा मनुपुत्रा महाबलाः ।\nअवनिं पालयामासुर्नित्यं धर्मपरायणाः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003752039, "chapter_id": 23752, "verse_number": "२-१-३६-४०", "content_sanskrit": "सूर्यदक्षब्रह्मधर्मरुद्राणां पञ्च सूनवः ।\nसावर्णिरौच्यभौमाद्या भविष्यन्मनुसप्तकम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003752040, "chapter_id": 23752, "verse_number": "२-१-३६-४१", "content_sanskrit": "चतुर्दश विधातुस्ते भवन्ति मनवोऽहनि ।\nतत्कल्पसंज्ञं तस्यान्ते निशा स्यात्तत्समा शृणु ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003752041, "chapter_id": 23752, "verse_number": "२-१-३६-४२", "content_sanskrit": "दिनावसानसमये ब्रह्मणः पाण्डुनन्दन ।\nजायतेऽवग्रहो घोरः पृथिव्यां शतवार्षिकः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003752042, "chapter_id": 23752, "verse_number": "२-१-३६-४३", "content_sanskrit": "तस्मिन्नवग्रहे पृथ्व्यां नीरसायां धनञ्जय ।\nचतुर्विधानि भूतानि समायान्ति परिक्षयम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003752043, "chapter_id": 23752, "verse_number": "२-१-३६-४४", "content_sanskrit": "तदा तप्तशिखाकारैरुपेतो घर्मदीधितिः ।\nमयूखैरग्निसदृशैर्वमद्भिः पावकच्छटाः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003752044, "chapter_id": 23752, "verse_number": "२-१-३६-४५", "content_sanskrit": "विनष्टग्रामनगरशैलवृक्षादिकानना ।\nकूर्मपृष्ठोपमोर्वी स्यात्तप्तायःपिण्डसन्निभा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003752045, "chapter_id": 23752, "verse_number": "२-१-३६-४६", "content_sanskrit": "ततो विधातुर्गात्रेभ्यः समुत्पन्ना महाघनाः ।\nआच्छादयन्तो गगनं गर्जितध्वानबन्धुराः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003752046, "chapter_id": 23752, "verse_number": "२-१-३६-४७", "content_sanskrit": "सितपीतारुणश्यामाश्चित्रवर्णाश्च भीषणाः ।\nशैलेभसौधवृक्षादिनानारूपसमन्विताः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003752047, "chapter_id": 23752, "verse_number": "२-१-३६-४८", "content_sanskrit": "ते शताब्दमितं कालं महावृष्टिं वितन्वते ।\nतेनाम्भसा शमं याति सूर्योद्भूतो महानलः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003752048, "chapter_id": 23752, "verse_number": "२-१-३६-४९", "content_sanskrit": "भूयश्च शतवर्षाणि वर्षन्त्युग्रं महाघनाः ।\nतदम्भसा समुद्वेला विकृतिं यान्ति वार्द्धयः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003752049, "chapter_id": 23752, "verse_number": "२-१-३६-५०", "content_sanskrit": "कल्पान्ताम्बुदनिर्मुक्तं लोकान्व्याप्नोति तज्जलम् ।\nभूर्भुवःस्वर्महर्लोकानावृणोति तमो महत् ।\nतदा निमग्ना सलिले मही पातालमूलगा ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003752050, "chapter_id": 23752, "verse_number": "२-१-३६-५१", "content_sanskrit": "अनष्टा कथमप्यास्ते ब्रह्मशक्त्यवलम्बिता ।\nअथ निःश्वाससंभूतो मारुतो ब्रह्मणोऽर्जुन ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003752051, "chapter_id": 23752, "verse_number": "२-१-३६-५२", "content_sanskrit": "उत्सारयति तान्सर्वान्कल्पान्तोत्थान्महाघनान् ।\nएवं प्रवृद्धः पवनः शतसंवत्सरात्मकम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003752052, "chapter_id": 23752, "verse_number": "२-१-३६-५३", "content_sanskrit": "कालं निरन्तरं वाति दुर्निवाररयोत्थितः ।\nतमुग्रमनिलं हित्वा हरेर्नाभिसरोरुहे ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003752053, "chapter_id": 23752, "verse_number": "२-१-३६-५४", "content_sanskrit": "योगनिद्रामवाप्नोति तस्मिन्पाथसि पद्मभूः ।\nयोगनिद्रानुषक्तस्य याति तस्य जगद्विभोः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003752054, "chapter_id": 23752, "verse_number": "२-१-३६-५५", "content_sanskrit": "तावती शर्वरी पार्थ दिनं यावत्प्रमाणकम् ।\nनिशायां समतीतायामुत्थितो वेगवान्पुनः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003752055, "chapter_id": 23752, "verse_number": "२-१-३६-५६", "content_sanskrit": "सृजप्यखिलजन्तून्वै पूर्ववच्छासनाद्धरेः ।\nकल्पेकल्पे समुचितै रूपैः पाति जगद्धरिः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003752056, "chapter_id": 23752, "verse_number": "२-१-३६-५७", "content_sanskrit": "अस्मिन्कल्पे श्वेतवर्णां प्राप्तवान्यज्ञपोत्रिताम् ।\nवराहवपुषा देवो विहरन्नवनीतले ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003752057, "chapter_id": 23752, "verse_number": "२-१-३६-५८", "content_sanskrit": "स्वपूर्वनियतावासं प्रपेदे वेंकटाचलम् ।\nस्वामिपुष्करिणीतीरे चरंश्चिरमधोक्षजः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003752058, "chapter_id": 23752, "verse_number": "२-१-३६-५९", "content_sanskrit": "भक्त्या परमया युक्तमपश्यज्जलजासनम् ।\nसंपूज्य प्रार्थयामास ब्रह्मा तं भूतभावनम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003752059, "chapter_id": 23752, "verse_number": "२-१-३६-६०", "content_sanskrit": "पुरातनीं निजां स्वामिन्भज दिव्यां तनूमिति ।\nगृहीत्वानुनयं तस्य त्यक्त्वा तां सूकराकृतिम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003752060, "chapter_id": 23752, "verse_number": "२-१-३६-६१", "content_sanskrit": "अनन्यभजनीयां स्वां प्राप विश्वात्मिकां तनुम् ।\nतथास्थितं गिरौ तत्र कृत्वाप्युत्साहमूर्जितम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003752061, "chapter_id": 23752, "verse_number": "२-१-३६-६२", "content_sanskrit": "द्रष्टुं न शेकुः सर्वेऽपि कालेन बहुनापि च ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003752062, "chapter_id": 23752, "verse_number": "२-१-३६-६३", "content_sanskrit": "अर्जुन उवाच ।\nदर्शनस्मरणादीनां हरिरित्थमगोचरः ।\nकथं प्रत्यक्षतां प्राप मानुषाणां महामुने ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003752063, "chapter_id": 23752, "verse_number": "२-१-३६-६४", "content_sanskrit": "भाग्यभूतोऽथ जगतां यः को वाऽराध्य तं विभुम् ।\nइह प्रकाशयामास कथामेतां निवेदय ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003752064, "chapter_id": 23752, "verse_number": "२-१-३६-६५", "content_sanskrit": "हरिकथाश्रवणं दुरितापहं कथयतां सकलागमविद्भवान् ।\nसुकृतिनां ननु संप्रति धुर्यता मुनिवरेण्य ममाद्य समागता ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003752065, "chapter_id": 23752, "verse_number": "२-१-३६-६६", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां द्वितीये वैष्णवखण्डे श्रीवेंकटाचलमाहात्म्ये सुवर्णमुखरीमाहात्म्यप्रशंसायां वराहावतारकीर्तनं नाम षट्त्रिंशोऽध्यायः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]