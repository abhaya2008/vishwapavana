[{"id": 2212590, "chapter_id": 5530, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2212591, "chapter_id": 5530, "verse_number": "१", "content_sanskrit": "न मां प्रीणयते राज्यं त्वय्येवं दुःखिते नृप ।\nधिङ्मामस्तु सुदुर्बुद्धिं राज्यलुब्धं प्रमादिनम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2212592, "chapter_id": 5530, "verse_number": "२", "content_sanskrit": "वने भवन्तं दुःखार्तमुपवासकृशं नृप ।\nयताहारं भूमिशयं नाविन्दं भ्रातृभिः सह\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2212593, "chapter_id": 5530, "verse_number": "३", "content_sanskrit": "अहोऽस्मि वञ्चितो मूढो भवता गूढबुद्धिना ।\nविश्वासयित्वा पूर्वं मां यदि त्वमिदमुक्तवान्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2212594, "chapter_id": 5530, "verse_number": "४", "content_sanskrit": "किं मे राज्येन भोगैर्वा किं यज्ञैः किं फलेन वा ।\nयस्य मे त्वं महीपाल दुःखान्येवमवाप्तवान्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2212595, "chapter_id": 5530, "verse_number": "५", "content_sanskrit": "पीडितं चापि जानामि राज्यमात्मानमेव च ।\nअनेन वचसा तेऽद्य दुःखितोऽस्मि जनेश्वर\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2212596, "chapter_id": 5530, "verse_number": "६", "content_sanskrit": "भवान् पिता भवान् माता भवान् नः परमो गुरुः ।\nभवता विप्रहीणा हि क्व नु तिष्ठामहे वयम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2212597, "chapter_id": 5530, "verse_number": "७", "content_sanskrit": "औरसो भवतः पुत्रो युयुत्सुस्तरुणोऽपि सन् ।\nअस्तु राजा महाराज यं चान्यं मन्यते भवान्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2212598, "chapter_id": 5530, "verse_number": "८", "content_sanskrit": "अहं वनं गमिष्यामि भवान् राज्यं प्रशास्त्विदम् ।\nन मामयशसा दग्धं भूयस्त्वं दग्धुमर्हसि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2212599, "chapter_id": 5530, "verse_number": "९", "content_sanskrit": "नाहं राजा भवान् राजा भवता परवानहम् ।\nकथं गुरुं महाराजम् अनुज्ञातुमिहोत्सहे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2212600, "chapter_id": 5530, "verse_number": "१०", "content_sanskrit": "न मन्युरिह नः कश्चित् सुयोधनकृते नृप ।\nभवितव्यं तथा तद्धि वयं ते चैव मोहिताः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2212601, "chapter_id": 5530, "verse_number": "११", "content_sanskrit": "वयं हि पुत्रा भवतो यथा दुर्योधनादयः ।\nगान्धारी चैव कुन्ती च निर्विशेषे मते मम\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2212602, "chapter_id": 5530, "verse_number": "१२", "content_sanskrit": "यद्येवमपि मां राजन् परित्यज्य गमिष्यसि ।\nपृष्ठतस्त्वनुयास्यामि सत्येनात्मानमालभे\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2212603, "chapter_id": 5530, "verse_number": "१३", "content_sanskrit": "इयं हि वसुसम्पूर्णा मही सागरमेखला ।\nभवता विप्रहीणस्य न मे प्रीतिकरी भवेत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2212604, "chapter_id": 5530, "verse_number": "१४", "content_sanskrit": "भवदीयमिदं सर्वं शिरसा त्वां प्रसादये ।\nत्वदधीनाः स्म राजेन्द्र व्येतु ते मानसो ज्वरः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2212605, "chapter_id": 5530, "verse_number": "१५", "content_sanskrit": "भवितव्यमनुप्राप्तं मन्ये त्वेतज्जनाधिप ।\nदिष्ट्या शुश्रूषमाणस्त्वां मोक्ष्यामि मनसो ज्वरम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2212606, "chapter_id": 5530, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2212607, "chapter_id": 5530, "verse_number": "१६", "content_sanskrit": "तापस्ये मे मनस्तात वर्तते कुरुनन्दन ।\nउचितं हि कुलेऽस्माकम् अरण्यगमनं प्रभो\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2212608, "chapter_id": 5530, "verse_number": "१७", "content_sanskrit": "चिरमस्म्युषितः पुत्र चिरं शुश्रूषितस्त्वया ।\nवृद्धं मामभ्यनुज्ञातुं राजन्नर्हसि मा चिरम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2212609, "chapter_id": 5530, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2212610, "chapter_id": 5530, "verse_number": "१८", "content_sanskrit": "एवमुक्त्वा वेपमानं पाण्डुपुत्रं कृताञ्जलिम् ।\nउवाच विदुरं राजा धृतराष्ट्रोऽम्बिकासुतः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2212611, "chapter_id": 5530, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2212612, "chapter_id": 5530, "verse_number": "१९", "content_sanskrit": "सञ्जयं च महामात्रं कृपं चापि महारथम् ।\nअनुनेतुमिहेच्छामि भवद्भिः पृथिवीपतिम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2212613, "chapter_id": 5530, "verse_number": "२०", "content_sanskrit": "म्लायते हि मनस्तात मुखं च परिशुष्यति ।\nवयसा च प्रकृष्टेन व्यायामेनाप्यनेन च\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2212614, "chapter_id": 5530, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2212615, "chapter_id": 5530, "verse_number": "२१", "content_sanskrit": "इत्युक्त्वा स तु धर्मात्मा वृद्धो राजा कुरूद्वहः ।\nगान्धारीं शिश्रिये धीमान् सहसैव गतासुवत्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2212616, "chapter_id": 5530, "verse_number": "२२", "content_sanskrit": "(तं तु दृष्ट्वा तथाऽऽसीनं निश्चेष्टं कुरुपार्थिवम् ।)\nआर्तिं राजा ययौ तूर्णं कौन्तेयः परवीरहा\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2212617, "chapter_id": 5530, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2212618, "chapter_id": 5530, "verse_number": "२३", "content_sanskrit": "यस्य नागसहस्रेण दशसङ्ख्येन वै बलम् ।\nसोऽयं नारीं समाश्रित्य शेते राजा गतासुवत्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2212619, "chapter_id": 5530, "verse_number": "२४", "content_sanskrit": "आयसी प्रतिमा येन भीमसेनस्य वै पुरा ।\nचूर्णीकृता बलवता स बलार्थेऽश्रयत् स्त्रियम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2212620, "chapter_id": 5530, "verse_number": "२५", "content_sanskrit": "धिगस्तु मामधर्मज्ञं धिग् बुद्धिं धिग् बहुश्रुतम् ।\nयत्कृते पृथिवीपालः शेतेऽयमतथोचितः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2212621, "chapter_id": 5530, "verse_number": "२६", "content_sanskrit": "अहमप्युपवत्स्यामि यथैवायं गुरुर्मम ।\nयदि राजा न भुङ्क्तेऽयं गान्धारी च यशस्विनी\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2212622, "chapter_id": 5530, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2212623, "chapter_id": 5530, "verse_number": "२७", "content_sanskrit": "ततोऽस्य पाणिना राजा जलशीतेन पाण्डवः ।\nउरो मुखं चैव शनैः पर्यमार्जत धर्मवित्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2212624, "chapter_id": 5530, "verse_number": "२८", "content_sanskrit": "तेन रत्नौषधिमता पुण्येन सुखगन्धिना ।\nपाणिस्पर्शेन राज्ञस्तु तथा सुखमवाप ह\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2212625, "chapter_id": 5530, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nआश्रमवासिकपर्वणि युधिष्ठिरधृतराष्ट्रसंवादो नाम षष्ठोऽध्यायः ॥६॥\nआश्रमवासपर्वणि षष्ठोऽध्यायः ॥६॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]