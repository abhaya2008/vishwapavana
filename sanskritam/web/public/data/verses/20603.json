[{"id": 7000603000, "chapter_id": 20603, "verse_number": "५-६२-१", "content_sanskrit": "शेष उवाच ।\nमूर्च्छितं मारुतिं श्रुत्वा शत्रुघ्नः शोकमाययौ ।\nकिंकर्तव्यं मया संख्ये बालकोऽयं महाबलः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000603001, "chapter_id": 20603, "verse_number": "५-६२-२", "content_sanskrit": "स्वयं रथे हेममये तिष्ठन्वीरवरैः सह ।\nयोद्धुं प्रागाल्लवो यत्र विचित्ररणकोविदः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000603002, "chapter_id": 20603, "verse_number": "५-६२-३", "content_sanskrit": "लवं ददर्श शिशुतां प्राप्तं राममिव क्षितौ ।\nधनुर्बाणकरं वीरान्क्षिपंतं रणमूर्धनि॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000603003, "chapter_id": 20603, "verse_number": "५-६२-४", "content_sanskrit": "विचारयामास तदा कोऽयं रामस्वरूपधृक् ।\nनीलोत्पलदलश्यामं वपुर्बिभ्रन्मनोहरम्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000603004, "chapter_id": 20603, "verse_number": "५-६२-५", "content_sanskrit": "एष वै देहतनुजा सुतो भवति नान्यथा ।\nअस्मान्विजित्य समरे यास्यते मृगराडिव॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000603005, "chapter_id": 20603, "verse_number": "५-६२-६", "content_sanskrit": "अस्माकं नो जयो भाव्यः शक्त्या विरहितात्मनाम् ।\nअशक्ताः किं करिष्यामः समरे रणकोविदाः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000603006, "chapter_id": 20603, "verse_number": "५-६२-७", "content_sanskrit": "इत्येवं स विचार्याथ बालकं तु वचोऽब्रवीत् ।\nरणे कुतुककर्तारं वीरकोटिनिपातकम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000603007, "chapter_id": 20603, "verse_number": "५-६२-८", "content_sanskrit": "कस्त्वं बाल रणेऽस्माकं वीरान्पातयसि क्षितौ ।\nन जानीषे बलं राज्ञो रामस्य दनुजार्दिनः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000603008, "chapter_id": 20603, "verse_number": "५-६२-९", "content_sanskrit": "का ते माता पिता कस्ते सुभाग्यो जयमाप्तवान् ।\nनाम किं विश्रुतं लोके जानीयां ते महाबल॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000603009, "chapter_id": 20603, "verse_number": "५-६२-१०", "content_sanskrit": "मुञ्च वाहः कथं बद्धः शिशुत्वात्तत्क्षमामि ते ।\nआयाहि रामं वीक्षस्व दास्यते बहुलं तव॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000603010, "chapter_id": 20603, "verse_number": "५-६२-११", "content_sanskrit": "इत्युक्तो बालको वीरो वचः शत्रुघ्नमावदत् ।\nकिं ते नाम्नाथ पित्रा वा कुलेन वयसा तथा॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000603011, "chapter_id": 20603, "verse_number": "५-६२-१२", "content_sanskrit": "युध्यस्व समरे वीर चेत्त्वं बलयुतो भवेः ।\nकुशं वीरं नमस्कृत्य पादयोर्याहि नान्यथा॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000603012, "chapter_id": 20603, "verse_number": "५-६२-१३", "content_sanskrit": "भ्राता रामस्य वीरो भूर्नावयोर्बलिनां वरः ।\nवाहं विमोचय बलाच्छक्तिस्ते विद्यते यदि॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000603013, "chapter_id": 20603, "verse_number": "५-६२-१४", "content_sanskrit": "इत्युक्त्वा शरसंधानं कृत्वा प्राहरदुद्भटः ।\nहृदये मस्तके चैव भुजयो रणमंडले॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000603014, "chapter_id": 20603, "verse_number": "५-६२-१५", "content_sanskrit": "तदा प्रकुपितो राजा धनुः सज्यमथाकरोत् ।\nनादयन्मेघगंभीरं त्रासयन्निव बालकम्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000603015, "chapter_id": 20603, "verse_number": "५-६२-१६", "content_sanskrit": "बाणानपरिसंख्यातान्मुमोच बलिनां वरः ।\nबालो बलेन चिच्छेद सर्वांस्तान्सायकव्रजान्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000603016, "chapter_id": 20603, "verse_number": "५-६२-१७", "content_sanskrit": "लवस्यानेकधा मुक्तैर्बाणैर्व्याप्तं महीतलम् ।\nव्यतीपाते प्रदत्तस्य दानस्येवाक्षयं गताः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000603017, "chapter_id": 20603, "verse_number": "५-६२-१८", "content_sanskrit": "ते बाणा व्योमसकलं व्याप्नुवंल्लवसंधिताः ।\nसूर्यमंडलमासाद्य प्रवर्तंते समंततः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000603018, "chapter_id": 20603, "verse_number": "५-६२-१९", "content_sanskrit": "मारुतो नाविशद्यत्र बाणपंजरगोचरे ।\nमनुष्याणां तु का वार्ता क्षणजीवितशंसिनाम्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000603019, "chapter_id": 20603, "verse_number": "५-६२-२०", "content_sanskrit": "तद्बाणान्विस्तृतान्दृष्ट्वा शत्रुघ्नो विस्मयं गतः ।\nअच्छिनच्छतसाहस्रं बाणमोचनकोविदः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000603020, "chapter_id": 20603, "verse_number": "५-६२-२१", "content_sanskrit": "ताञ्छिन्नान्सायकान्सर्वान्स्वीयान्दृष्ट्वा कुशानुजः ।\nधनुश्चिच्छेद तरसा शत्रुघ्नस्य महीपतेः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000603021, "chapter_id": 20603, "verse_number": "५-६२-२२", "content_sanskrit": "सोऽन्यद्धनुरुपादाय यावन्मुंचति सायकान् ।\nतावद्बभंज सरथं सायकैः शितपर्वभिः॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000603022, "chapter_id": 20603, "verse_number": "५-६२-२३", "content_sanskrit": "करस्थमच्छिनच्चापं सुदृढं गुणपूरितम् ।\nतत्कर्मापूजयन्वीरा रणमंडलवर्तिनः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000603023, "chapter_id": 20603, "verse_number": "५-६२-२४", "content_sanskrit": "सच्छिन्नधन्वा विरथो हताश्वो हतसारथिः ।\nअन्यं रथं समास्थाय ययौ योद्धुं लवं बलात्॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000603024, "chapter_id": 20603, "verse_number": "५-६२-२५", "content_sanskrit": "अनेकबाणनिर्भिन्नः स्रवद्रक्तकलेवरः ।\nपुष्पितः किंशुक इव शुशुभे रणमध्यगः॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000603025, "chapter_id": 20603, "verse_number": "५-६२-२६", "content_sanskrit": "शत्रुघ्नबाणप्रहतः परं कोपमुपागमत् ।\nबाणसंधानचतुरः कुंडलीकृत चापवान्॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000603026, "chapter_id": 20603, "verse_number": "५-६२-२७", "content_sanskrit": "विशीर्णकवचं देहं शिरोमुकुटवर्जितम् ।\nस्रवद्रक्तपरिप्लुष्टं शत्रुघ्नस्य चकार सः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000603027, "chapter_id": 20603, "verse_number": "५-६२-२८", "content_sanskrit": "तदा रामानुजः क्रुद्धो दशबाणाञ्छिताग्रकान् ।\nमुमोच प्राणसंहारकारकान्कुपितो भृशम्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000603028, "chapter_id": 20603, "verse_number": "५-६२-२९", "content_sanskrit": "स तांस्तांस्तिलशः कृत्वा बाणैर्निशितपर्वभिः ।\nताडयामास हृदये शत्रुघ्नस्याष्टभिः शरैः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000603029, "chapter_id": 20603, "verse_number": "५-६२-३०", "content_sanskrit": "अत्यंतं बाणपीडार्तो लवं बलिनमुत्स्मरन् ।\nदुःसहं मन्यमानस्तं शरान्मुंचन्नभूत्तदा॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000603030, "chapter_id": 20603, "verse_number": "५-६२-३१", "content_sanskrit": "तदा लवेन तीक्ष्णेन हृदि भिन्नो विशालके ।\nअर्धचंद्रसमानेन तीक्ष्णपर्वसुशोभिना॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000603031, "chapter_id": 20603, "verse_number": "५-६२-३२", "content_sanskrit": "स विद्धो हृदि बाणेन पीडां प्राप्तः सुदारुणाम् ।\nपपात स्यंदनोपस्थे धनुःपाणिः सुशोभितः॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000603032, "chapter_id": 20603, "verse_number": "५-६२-३३", "content_sanskrit": "शत्रुघ्नं मूर्छितं दृष्ट्वा नृपाश्च सुरथादयः ।\nदुद्रुवुर्लवमुद्युक्ता जयप्राप्त्यै रणे तदा॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000603033, "chapter_id": 20603, "verse_number": "५-६२-३४", "content_sanskrit": "सुरथो विमलो वीरो राजा वीरमणिस्तथा ।\nसुमदो रिपुतापाद्याः परिवव्रुश्च संयुगे॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000603034, "chapter_id": 20603, "verse_number": "५-६२-३५", "content_sanskrit": "केचित्क्षुरप्रैर्मुसलैः केचिद्बाणैः सुदारुणैः ।\nप्रासैः परशुभिः केचित्सर्वतः प्राहरन्नृपाः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000603035, "chapter_id": 20603, "verse_number": "५-६२-३६", "content_sanskrit": "तानधर्मेण युद्धोत्कान्दृष्ट्वा वीरशिरोमणिः ।\nदशभिर्दशभिर्बाणैस्ताडयामास संयुगे॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000603036, "chapter_id": 20603, "verse_number": "५-६२-३७", "content_sanskrit": "ते बाणवर्षविहता रणमध्ये सुकोपनाः ।\nकेचित्पलायिताः केचिन्मुमुहुर्युद्धमंडले॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000603037, "chapter_id": 20603, "verse_number": "५-६२-३८", "content_sanskrit": "तावत्स राजा शत्रुघ्नो मूर्च्छां संत्यज्य संगरे ।\nलवं प्रायान्महावीरं योद्धुं बलसमन्वितः॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000603038, "chapter_id": 20603, "verse_number": "५-६२-३९", "content_sanskrit": "आगत्य तं लवं प्राह धन्योसि शिशुसन्निभः ।\nन बालस्त्वं सुरः कश्चिच्छलितुं मां समागतः॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000603039, "chapter_id": 20603, "verse_number": "५-६२-४०", "content_sanskrit": "केनापि नहि वीरेण पातितो रणमंडले ।\nत्वयाहं प्रापितो मूर्च्छां समक्षं मम पश्यतः॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000603040, "chapter_id": 20603, "verse_number": "५-६२-४१", "content_sanskrit": "इदानीं पश्य मे वीर्यं त्वां संख्ये पातयाम्यहम् ।\nसहस्व बाणमेकं त्वं मापलायस्व बालक॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000603041, "chapter_id": 20603, "verse_number": "५-६२-४२", "content_sanskrit": "इत्युक्त्वा समरे बालं शरमेकं समाददे ।\nयमवक्त्रसमं घोरं लवणो येन घातितः॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000603042, "chapter_id": 20603, "verse_number": "५-६२-४३", "content_sanskrit": "संधाय बाणं जाज्वल्यं हृदि भेत्तुं मनो दधत् ।\nलवं वीरसहस्राणां वह्निवत्सर्वदाहकम्॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000603043, "chapter_id": 20603, "verse_number": "५-६२-४४", "content_sanskrit": "तं बाणं प्रज्वलंतं स द्योतयंतं दिशो दश ।\nदृष्ट्वा सस्मार बलिनं कुशं वैरिनिपातिनम्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000603044, "chapter_id": 20603, "verse_number": "५-६२-४५", "content_sanskrit": "यद्यस्मिन्समये वीरो भ्राता स्याद्बलवान्मम ।\nतदा शत्रुघ्नवशता न मे स्याद्भयमुल्बणम्॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000603045, "chapter_id": 20603, "verse_number": "५-६२-४६", "content_sanskrit": "एवं तर्कयतस्तस्य लवस्य च महात्मनः ।\nहृदि लग्नो महाबाणो घोरः कालानलोपमः॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000603046, "chapter_id": 20603, "verse_number": "५-६२-४७", "content_sanskrit": "मूर्च्छां प्राप तदा वीरो भूपसायकसंहतः ।\nसंगरे सर्ववीराणां शिरोभिः समलंकृते॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]