[{"id": 2038244, "chapter_id": 1833, "verse_number": "५-७८-०x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2038245, "chapter_id": 1833, "verse_number": "५-७८-१", "content_sanskrit": "एवमेतन्महाबाहो यथा वदसि पाण्डव।\nपाण्डवानां कुरूणां च प्रतिपत्स्ये निरामयम्।\nसर्वं त्विदं ममायत्तं बीभत्सो कर्मणोर्द्वयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2038246, "chapter_id": 1833, "verse_number": "५-७८-२", "content_sanskrit": "क्षेत्रं हि रसवच्छुद्धं कर्मणैवोपपादितम्।\nऋते वर्षान्न कौन्तेय जातु निर्वर्तयेत्फलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2038247, "chapter_id": 1833, "verse_number": "५-७८-३", "content_sanskrit": "तत्र वै पौरुषं ब्रूयुरासेकं यत्र कारितम्।\nतत्र चापि ध्रुवं पश्येच्छोषणं दैवकारितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2038248, "chapter_id": 1833, "verse_number": "५-७८-४", "content_sanskrit": "तदिदं निश्चित्तं बुद्ध्या पूर्वैरपि महात्मभिः ।\nदैवे च मानुषे चैव संयुक्तं लोककारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2038249, "chapter_id": 1833, "verse_number": "५-७८-५", "content_sanskrit": "अहं हि तत्करिष्यामि परं पुरुषकारतः ।\nदेवं तु न मया शक्यं कर्म कर्तुं कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2038250, "chapter_id": 1833, "verse_number": "५-७८-६", "content_sanskrit": "स हि धर्मं च लोकं च त्यक्त्वा चरति दुर्मतिः।\nन हि सन्तप्यते तेन तथारूपेण कर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2038251, "chapter_id": 1833, "verse_number": "५-७८-७", "content_sanskrit": "तथापि बुद्धिं पापिष्ठां वर्धयन्त्यस्य मन्त्रिणः ।\nशकुनिः सूतपुत्रश्च भ्राता दुःशासनस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2038252, "chapter_id": 1833, "verse_number": "५-७८-८", "content_sanskrit": "स हि त्यागेन राज्यस्य न शमं समुपैष्यति।\nअन्तरेण वधं पार्थ सानुबन्धः सुयोधनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2038253, "chapter_id": 1833, "verse_number": "५-७८-९", "content_sanskrit": "न चापि प्रणिपातेन त्यक्तुमिच्छति धर्मराट् ।\nयाच्यमानश्च राज्यं स न प्रजास्यति दुर्मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2038254, "chapter_id": 1833, "verse_number": "५-७८-१०", "content_sanskrit": "न तु मन्ये स तद्वाच्यो यद्युधिष्ठिरशातनम् ।\nउक्तं प्रयोजनं यत्तु धर्मराजेन भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2038255, "chapter_id": 1833, "verse_number": "५-७८-११", "content_sanskrit": "तथा पापस्तु तत्सर्वं न करिष्यति कौरवः ।\nतस्मिंश्चाक्रियमाणेऽसौ लोके वध्यो भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2038256, "chapter_id": 1833, "verse_number": "५-७८-१२", "content_sanskrit": "मम चापि स वध्यो हि जगतश्चापि भारत ।\nतेन कौमारके यूयं सर्वे विप्रकृताः सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2038257, "chapter_id": 1833, "verse_number": "५-७८-१३", "content_sanskrit": "विप्रलुप्तं च वो राज्यं नृशंसेन दुरात्मना।\nन चोपशाम्यते पापः श्रियं दृष्ट्वा युधिष्ठिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2038258, "chapter_id": 1833, "verse_number": "५-७८-१४", "content_sanskrit": "असकृच्चाप्यहं तेन त्वत्कृते पार्थ भेदितः ।\nन मया तद्गृहीतं च पापं तस्य चिकीर्षेतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2038259, "chapter_id": 1833, "verse_number": "५-७८-१५", "content_sanskrit": "जानासि हि महाबाहो त्वमप्यस्य परं मतम्।\nप्रियं चिकीर्षमाणं च धर्मराजस्य मामपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2038260, "chapter_id": 1833, "verse_number": "५-७८-१६", "content_sanskrit": "संजानंस्तस्य चात्मानं मम चैव परं मतम्।\nअजानन्निव मां कस्मादर्जुनाद्याभिशङ्कसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2038261, "chapter_id": 1833, "verse_number": "५-७८-१७", "content_sanskrit": "यच्चापि परमं दिव्यं तच्चाप्यनुगतं त्वया।\nविधानं विहितं पार्थ कथं शर्म भवेत्परैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2038262, "chapter_id": 1833, "verse_number": "५-७८-१८", "content_sanskrit": "यत्तु वाचा मया शक्यं कर्मणा वाऽपि पाण्डव ।\nकरिष्ये तदहं पार्थ न त्वाशंसे शमं परैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2038263, "chapter_id": 1833, "verse_number": "५-७८-१९", "content_sanskrit": "कथं गोहरणे ह्युक्तो नैतच्छर्म तथा हितम् ।\nयाच्यमानो हि भीष्मेण संवत्सरगतेऽध्वनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2038264, "chapter_id": 1833, "verse_number": "५-७८-२०", "content_sanskrit": "तदैव ते पराभूता यदा सङ्कल्पितास्त्वया।\nलवशः क्षणशश्चापि न च तुष्टः सुयोधनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2038265, "chapter_id": 1833, "verse_number": "५-७८-२१", "content_sanskrit": "सर्वथा तु मया कार्यं धर्मराजस्य शासनम् ।\nविभाव्यं तस्य भूयश्च कर्म पापं दुरात्मनः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2038266, "chapter_id": 1833, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि अष्टसप्ततितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]