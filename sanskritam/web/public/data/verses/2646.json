[{"id": 2077617, "chapter_id": 2646, "verse_number": "१२-१५१-०x", "content_sanskrit": "शौनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2077618, "chapter_id": 2646, "verse_number": "१२-१५१-१", "content_sanskrit": "तस्मात्तेऽहं प्रवक्ष्यामि धर्ममावृतचेतसे।\nश्रीमन्महाबलस्तुष्टः स्वयं धर्ममवेक्षसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2077619, "chapter_id": 2646, "verse_number": "१२-१५१-२", "content_sanskrit": "पुरस्ताद्दारुणे भूत्वा सुचित्रतरमेव तत्।\nअनुगृह्णाति भूतानि स्वेन वृत्तेन पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2077620, "chapter_id": 2646, "verse_number": "१२-१५१-३", "content_sanskrit": "कृत्स्ने नूनं सदसती इति लोको व्यवस्यति।\nयत्र त्वं तादृशो भूत्वा धर्ममेवानुपश्यसि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2077621, "chapter_id": 2646, "verse_number": "१२-१५१-४", "content_sanskrit": "दर्पं हित्वा पुनश्चापि भोगांश्च तप आस्थितः।\nइत्येतदभिभूतानामद्भुतं जनमेजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2077622, "chapter_id": 2646, "verse_number": "१२-१५१-५", "content_sanskrit": "योऽदुर्बलो भवेद्दाता कृपणो वा तपोधनः।\nअनाश्चर्यं तदित्याहुर्नातिदूरेण वर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2077623, "chapter_id": 2646, "verse_number": "१२-१५१-६", "content_sanskrit": "तप एव हि कार्पण्यं समग्रमसमीक्षितम्।\nतच्चेत्समीक्षयैव स्याद्भवेत्तस्मिंस्तपो गुणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2077624, "chapter_id": 2646, "verse_number": "१२-१५१-७", "content_sanskrit": "यज्ञो दानं दया वेदाः सत्यं च पृथिवीपते।\nपञ्चैतानि पवित्राणि षष्ठं सुचरितं तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2077625, "chapter_id": 2646, "verse_number": "१२-१५१-८", "content_sanskrit": "तदेव राज्ञां परमं पवित्रं जनमेजय।\nतेन सम्यग्गृहीतेन श्रेयांसं धर्ममाप्स्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2077626, "chapter_id": 2646, "verse_number": "१२-१५१-९", "content_sanskrit": "पुण्यदेशाभिगमनं पवित्रं परमं स्मृतम्।\nअत्राप्युदाहरन्तीमां गाथां गीतां ययातिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2077627, "chapter_id": 2646, "verse_number": "१२-१५१-१०", "content_sanskrit": "यो मर्त्यः प्रतिपद्येत आयुर्जीवेन वा पुनः।\nयज्ञमेकं ततः कृत्वा तत्संन्यस्य तपश्चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2077628, "chapter_id": 2646, "verse_number": "१२-१५१-११", "content_sanskrit": "पुण्यमाहुः कुरुक्षेत्रं कुरुक्षेत्रात्सरस्वतीम्।\nसरस्वत्याश्च तीर्थानि तीर्थेभ्यश्च पृथूदकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2077629, "chapter_id": 2646, "verse_number": "१२-१५१-१२", "content_sanskrit": "यत्रावगाह्य स्थित्वा च नैनं श्वोमरणं तपेत्।\nमहासरः पुष्कराणि प्रभासोत्तरमानसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2077630, "chapter_id": 2646, "verse_number": "१२-१५१-१३", "content_sanskrit": "कालोदकं च गन्तासि लब्धायुर्जीविते पुनः।\nसरस्वतीदृषद्वत्योः सेवमानोऽनुसंज्वरेत्।\nस्वाध्यायशील एतेषु सर्वेष्वेवमुपस्पृशेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2077631, "chapter_id": 2646, "verse_number": "१२-१५१-१४", "content_sanskrit": "त्यागधर्मं पवित्राणां संन्यासं मनुरब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2077632, "chapter_id": 2646, "verse_number": "१२-१५१-१५", "content_sanskrit": "अत्राप्युदाहरन्तीमाः गाथाः सत्यवता कृताः।\nयथा कुमारः सत्यो वै नैव पुण्यो न पापकृत।\nन ह्यस्ति सर्वभूतेषु दुःखमस्मिन्कुतः सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2077633, "chapter_id": 2646, "verse_number": "१२-१५१-१६", "content_sanskrit": "एवं प्रकृतिभूतानां सर्वसंसर्गयायिनाम्।\nत्यजतां जीवितं प्रायो निवृत्ते पुण्यपापके।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2077634, "chapter_id": 2646, "verse_number": "१२-१५१-१७", "content_sanskrit": "यत्त्वेव राज्ञो ज्यायिष्ठं कार्याणां तद्ब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2077635, "chapter_id": 2646, "verse_number": "१२-१५१-१८", "content_sanskrit": "बलेन संविभागैश्च जय स्वर्गं पुनीष्व च।\nयस्यैव बलमोजश्च स धर्मस्य प्रभुर्नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2077636, "chapter_id": 2646, "verse_number": "१२-१५१-१९", "content_sanskrit": "ब्राह्मणानां सुखार्थं त्वं पर्येहि पृथिवीमिमाम्।\nयथैवैतान्पुरा क्षेप्सीस्तथैवैतान्प्रसादय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2077637, "chapter_id": 2646, "verse_number": "१२-१५१-२०", "content_sanskrit": "अपि धिक्क्रियमाणोऽपि तर्ज्यमानोऽप्यनेकधा।\nआत्मनो दर्शनं विद्वान्नाहर्ताऽस्मीति मा क्रुधः।\nघटमानः स्वकार्येषु कुरु निःश्रेयसं परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2077638, "chapter_id": 2646, "verse_number": "१२-१५१-२१", "content_sanskrit": "हिमाग्निघोरसदृशो राजा भवति कश्चन।\nलाङ्गलाशिकल्पो वा भवेदन्यः परंतपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2077639, "chapter_id": 2646, "verse_number": "१२-१५१-२२", "content_sanskrit": "न विशेषेण गन्तव्यमचिकित्सेन वा पुनः।\nन जातु नाहमस्मीति प्रसक्तव्यमसाधुषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2077640, "chapter_id": 2646, "verse_number": "१२-१५१-२३", "content_sanskrit": "विकर्मणा तप्यमानः पापात्पापः प्रमुच्यते।\nनैतत्कुर्या पुनरिति द्वितीयात्परिमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2077641, "chapter_id": 2646, "verse_number": "१२-१५१-२४", "content_sanskrit": "चरिष्ये धर्ममेवेति तृतीयात्परिमुच्यते।\nशुचिस्तीर्थान्यनुचरन्बहुत्वात्परिमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2077642, "chapter_id": 2646, "verse_number": "१२-१५१-२५", "content_sanskrit": "कल्याणमनुकर्तव्यं पुरुषेण बुभूषता।\nये सुगन्धीनि सेवन्ते तथागन्धा भवन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2077643, "chapter_id": 2646, "verse_number": "१२-१५१-२६", "content_sanskrit": "ये दुर्गन्धीनि सेवन्ते तथागन्धा भवन्ति ये।\nतपश्चर्यापरः सत्यं पापाद्विपरिमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2077644, "chapter_id": 2646, "verse_number": "१२-१५१-२७", "content_sanskrit": "संवत्सरमुपास्याग्निमभिशस्तः प्रमुच्यते।\nत्रीणि वर्षाण्युपास्याग्निं भ्रूणहा विप्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2077645, "chapter_id": 2646, "verse_number": "१२-१५१-२८", "content_sanskrit": "महासरः पुष्कराणि प्रभासोत्तरमानसे।\nअभ्येत्य योजनशतं भ्रूणहा विप्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2077646, "chapter_id": 2646, "verse_number": "१२-१५१-२९", "content_sanskrit": "यावतः प्राणिनो हन्यात्तज्जातीयांस्तु तावतः।\nप्रमीयमाणानुन्मोच्य प्राणिहा विप्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2077647, "chapter_id": 2646, "verse_number": "१२-१५१-३०", "content_sanskrit": "अपि चाप्सु निमज्जेत जपंस्त्रिरघमर्षणम्।\nयथाऽश्वमेधावभृथस्तथा तन्मनुरब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2077648, "chapter_id": 2646, "verse_number": "१२-१५१-३१", "content_sanskrit": "क्षिप्रं प्रणुदते पापं सत्कारं लभते तथा।\nअपि चैनं प्रसीदन्ति भूतानि जडमूकवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2077649, "chapter_id": 2646, "verse_number": "१२-१५१-३२", "content_sanskrit": "बृहस्पतिं देवगुरुं सुरासुराः\nसमेत्य सर्वे नृपते त्वयुज्जत।\nधर्मे फलं हेतुकृते महर्षे\nतथेतरस्मिन्नरके पापलोक्ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2077650, "chapter_id": 2646, "verse_number": "१२-१५१-३३", "content_sanskrit": "उभे तु यस्य सुकृते भवेतां\nकिं तत्तयोस्तत्र जयोत्तरं स्यात्।\nआचक्ष्व तत्कर्मफलं महर्षे\nकथं पापं नुदते धर्मशीलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2077651, "chapter_id": 2646, "verse_number": "१२-१५१-३४x", "content_sanskrit": "बृहस्पतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2077652, "chapter_id": 2646, "verse_number": "१२-१५१-३४", "content_sanskrit": "कृत्वा पापं पूर्वमबुद्धिपूर्वं\nपुण्यानि चेत्कुरुते बुद्धिपूर्वम्।\nस तत्पापं नुदते कर्मशीलो\nवासो यथा मलिनं क्षारयुक्त्या॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2077653, "chapter_id": 2646, "verse_number": "१२-१५१-३५", "content_sanskrit": "पापं कृत्वा हि मन्येत नाहमस्तीति पुरुषः।\nचिकीर्षेदेव कल्याणं श्रद्दधानोऽनसूयकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2077654, "chapter_id": 2646, "verse_number": "१२-१५१-३६", "content_sanskrit": "छिद्राणि वसनस्येव साधुना संवृणोति सः।\nयः पापं पुरुषः कृत्वा कल्याणमभिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2077655, "chapter_id": 2646, "verse_number": "१२-१५१-३७", "content_sanskrit": "आदित्यः पुनरुद्यन्वा तमः सर्वं व्यपोहति।\nकल्याणमाचरन्नेवं सर्वपापं व्यपोहति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2077656, "chapter_id": 2646, "verse_number": "१२-१५१-३८x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2077657, "chapter_id": 2646, "verse_number": "१२-१५१-३८", "content_sanskrit": "एवमुक्त्वा तु राजानमिन्द्रोतो जनमेजयम्।\nयाजयामास विधिवद्वाजिमेधेन शौनकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2077658, "chapter_id": 2646, "verse_number": "१२-१५१-३९", "content_sanskrit": "ततः स राजा व्यपनीतकल्मषः\nश्रिया युतः प्रज्वलितोऽनुरूपया।\nविवेश राज्यं स्वममित्रकर्शनो\nयथा दिवं पूर्णवपुर्निशाकरः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2077659, "chapter_id": 2646, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि एकपञ्चाशदधिकशततमोऽध्यायः॥ १५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]