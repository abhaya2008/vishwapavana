[{"id": 2028317, "chapter_id": 1613, "verse_number": "३-२५१-०x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2028318, "chapter_id": 1613, "verse_number": "३-२५१-१", "content_sanskrit": "राजन्नद्यावगच्छामि तवैव लघुसत्वताम्।\n`अल्पत्वं च तथा बुद्धेः कार्याणामविवेकिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2028319, "chapter_id": 1613, "verse_number": "३-२५१-२", "content_sanskrit": "किमत्र चित्रं धर्मज्ञ मोक्षितः पाण्डवैरसि।\nसद्यो वशं समापन्नः शत्रूणां शत्रुकर्शन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2028320, "chapter_id": 1613, "verse_number": "३-२५१-३", "content_sanskrit": "सेनाजीवैश्च कौरव्य तथा विषयवासिभिः।\nअज्ञातैर्यदि वा ज्ञातैः कर्तव्यं नृपतेः प्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2028321, "chapter_id": 1613, "verse_number": "३-२५१-४", "content_sanskrit": "प्रायः प्रधानाः पुरुषाः क्षोभयित्वाऽरिवाहिनीम्।\nनिगृह्यन्ते चयुद्धेषु मोक्ष्यन्ते च स्वसैनिकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2028322, "chapter_id": 1613, "verse_number": "३-२५१-५", "content_sanskrit": "सेनाजीवाश्च ये राज्ञां विषये सन्ति मानवाः।\nतैः संगम्य नृपार्थाय यतितव्यं यथातथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2028323, "chapter_id": 1613, "verse_number": "३-२५१-६", "content_sanskrit": "यद्येवं पाण्डवै राजन्भवद्विषयवासिभिः।\nयदृच्छया मोक्षितोऽसि कतत्रका परिदेवना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2028324, "chapter_id": 1613, "verse_number": "३-२५१-७", "content_sanskrit": "न चैतत्साधु यद्राजन्पाण्डवास्त्वां नृपोत्तमम्।\nस्वसेनया संप्रयान्तं नानुयान्ति स्म पृष्ठतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2028325, "chapter_id": 1613, "verse_number": "३-२५१-८", "content_sanskrit": "शूराश्च बलवन्तश्च संयुगेष्वपलायिनः।\nभवतस्ते सभायां वै प्रेष्यतां पूर्वमागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2028326, "chapter_id": 1613, "verse_number": "३-२५१-९", "content_sanskrit": "पाण्डवेयानि रत्नानि त्वमद्याप्युपभुञ्जसे।\nसत्वस्थान्पाण्डवान्पश्य न ते प्रायमुपाविशन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2028327, "chapter_id": 1613, "verse_number": "३-२५१-१०", "content_sanskrit": "`तदलं ते महाबाहो विषादं कर्तुमीदृशम्।\nउत्तिष्ठ रराजन्भद्रं ते न चिन्तां कर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2028328, "chapter_id": 1613, "verse_number": "३-२५१-११", "content_sanskrit": "अवश्यमेव नृपते राज्ञो विषयवासिभिः।\nप्रियाण्याचरितव्यानि तत्र का परिदेवना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2028329, "chapter_id": 1613, "verse_number": "३-२५१-१२", "content_sanskrit": "मद्वाक्यमेतद्राजेन्द्र यद्येवं न करिष्यसि।\nस्थास्यामीह भवत्पादौ शुश्रूषन्नरिमर्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2028330, "chapter_id": 1613, "verse_number": "३-२५१-१३", "content_sanskrit": "नोत्सहे जीवितुमहं त्वद्विहीनो नरर्षभः।\nप्रायोपविष्टस्तु तथा राज्ञां हास्यो भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2028331, "chapter_id": 1613, "verse_number": "३-२५१-१४x", "content_sanskrit": "वैशंबायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2028332, "chapter_id": 1613, "verse_number": "३-२५१-१४", "content_sanskrit": "एवमुक्तस्तु कर्णेन राजा दुर्योधनस्तदा।\nनैवोत्थातुं मनश्चक्रे स्वर्गाय कृतनिश्चयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2028333, "chapter_id": 1613, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि घोषयात्रापर्वणि एकपञ्चाशदधिकद्विशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]