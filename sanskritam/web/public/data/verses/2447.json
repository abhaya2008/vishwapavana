[{"id": 2069102, "chapter_id": 2447, "verse_number": "९-६५-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2069103, "chapter_id": 2447, "verse_number": "९-६५-१", "content_sanskrit": "अधिष्ठितः पदा मूर्ध्नि भग्नसक्थो महीं गतः।\nशौटीर्यमानी पुत्रो मे किमभाषत सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2069104, "chapter_id": 2447, "verse_number": "९-६५-२", "content_sanskrit": "अत्यर्थं कोपनो राजा जावैरश्च पाण्डुषु।\nव्यसनं परमं प्राप्तः किमाह परमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2069105, "chapter_id": 2447, "verse_number": "९-६५-३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2069106, "chapter_id": 2447, "verse_number": "९-६५-३", "content_sanskrit": "शृणु राजन्प्रवक्ष्यामि यथावृत्तं नराधिप।\nराज्ञा यदुक्तं मग्नेन तस्मिन्व्यसनसागरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2069107, "chapter_id": 2447, "verse_number": "९-६५-४", "content_sanskrit": "भग्नसक्थो नृपो राजन्पांसुना सोऽवकुण्ठितः।\nयमयन्मूर्धजांस्तत्र वीक्ष्य चैव दिशो दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2069108, "chapter_id": 2447, "verse_number": "९-६५-५", "content_sanskrit": "केशान्नियस्य यत्नेन निःश्वसन्नुरगो यथा।\nसंरम्भाश्रुपरीताब्यां नेत्राभ्यामभिवीक्ष्य माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2069109, "chapter_id": 2447, "verse_number": "९-६५-६", "content_sanskrit": "बाहू धरण्यां निष्पिष्य सुदुर्मत्त इव द्विपः।\nप्रकीर्णान्मूर्धजान्धुन्वन्दन्तैर्दन्तानुपस्पृशन्।\nगर्हयन्पाण्डवं ज्येष्ठं निःश्वस्येदमथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2069110, "chapter_id": 2447, "verse_number": "९-६५-७", "content_sanskrit": "भीष्मे शान्तनवे नाथे कर्णे शस्त्रभृतां वरे।\nगौतमे शकुनौ चापि द्रोणे चास्त्रभृतां वरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2069111, "chapter_id": 2447, "verse_number": "९-६५-८", "content_sanskrit": "अश्वत्थाम्नि यथा शल्ये शूरे च कृतवर्मणि।\nअन्येष्वपि च शूरेषु न्यस्तभारो महात्मसु।\nइमामवस्थां प्राप्तोऽस्मि कालो हि दुरतिक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2069112, "chapter_id": 2447, "verse_number": "९-६५-९", "content_sanskrit": "एकादशचमूभर्ता सोऽहमेतां दशां गतः।\nकालं प्राप्य महाबाहो न कश्चिदतिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2069113, "chapter_id": 2447, "verse_number": "९-६५-१०", "content_sanskrit": "आख्यातव्यं मदीयानां येऽस्मिञ्जीवन्ति संयुगे।\nयथाऽहं भीमसेनेन व्युत्क्रम्य समयं हतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2069114, "chapter_id": 2447, "verse_number": "९-६५-११", "content_sanskrit": "बहूनि सुनृशंसानि कृतानि खलु पाण्डवैः।\nभूरिश्रवसि कर्णे च भीष्मे द्रोणे च धीमति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2069115, "chapter_id": 2447, "verse_number": "९-६५-१२", "content_sanskrit": "इदं च गर्हितं कर्म नृशंसैः पाण्डवैः कृतम्।\nयेन ते वाच्यतां सत्सु गमिष्यन्तीति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2069116, "chapter_id": 2447, "verse_number": "९-६५-१३", "content_sanskrit": "का प्रीतिः सत्वयुक्तस्य कृत्वोपाधिकृतं जयम्।\nको वा समयभेत्तारं बुधः सम्मन्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2069117, "chapter_id": 2447, "verse_number": "९-६५-१४", "content_sanskrit": "अधर्मेण जयं लब्ध्वा को नु हृष्येत पण्डितः।\nयथा संहृष्यते पापः पाण्डुपुत्रो वृकोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2069118, "chapter_id": 2447, "verse_number": "९-६५-१५", "content_sanskrit": "किन्नु चित्रमितस्त्वद्य भग्नसक्थस्य यन्मम।\nक्रुद्धेन भीमसेनेन पादेन मृदितं शिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2069119, "chapter_id": 2447, "verse_number": "९-६५-१६", "content_sanskrit": "प्रतपन्तं श्रिया जुष्टं वर्तमानं च बन्धुषु।\nएवं कुर्यान्नरो यो हि स वै स़ञ्जय पूरुषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2069120, "chapter_id": 2447, "verse_number": "९-६५-१७", "content_sanskrit": "अभिज्ञौ युद्धधर्मस्य मम माता पिता च यौ।\nतौ हि सञ्जय दुःखार्तौ विज्ञाप्यौ वचनाद्वि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2069121, "chapter_id": 2447, "verse_number": "९-६५-१८", "content_sanskrit": "इष्टं भृत्या भृताः सम्यग्भूः प्रशास्ता ससागरा।\nमूर्ध्नि स्थितममित्राणां जीवतामेव स़ञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2069122, "chapter_id": 2447, "verse_number": "९-६५-१९", "content_sanskrit": "दत्ता दाया यथाशक्ति मित्राणां च प्रियं कृतम्।\nअमित्रा बाधिताः सर्वे को नु स्वन्ततरो मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2069123, "chapter_id": 2447, "verse_number": "९-६५-२०", "content_sanskrit": "मानिता बान्धवाः सर्वे मान्यः सम्पूजितो जनः।\nत्रितयं सेवितं सर्वं को नु स्वन्ततरो मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2069124, "chapter_id": 2447, "verse_number": "९-६५-२१", "content_sanskrit": "आज्ञप्तं नृपमुख्येषु मानः प्राप्तः सुदुर्लभः।\nआजानेयैस्तथा यातं को नु स्वन्ततरो मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2069125, "chapter_id": 2447, "verse_number": "९-६५-२२", "content_sanskrit": "यातानि परराष्ट्राणि नृपा भुक्ताश्च दासवत्।\nप्रियेभ्यः प्रकृतं साधु को नु स्वन्ततरो मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2069126, "chapter_id": 2447, "verse_number": "९-६५-२३", "content_sanskrit": "अधीतं विधिवद्दत्तं प्राप्तमायुर्निरामयम्।\nस्वधर्मेण जिता लोकाः को नु स्वन्ततरो मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2069127, "chapter_id": 2447, "verse_number": "९-६५-२४", "content_sanskrit": "दिष्ट्या नाहं जितः सङ्ख्ये परान्प्रेष्यवदाश्रितः।\nदिष्ट्या मे विपुला लक्ष्मीर्मृते त्वन्यगता विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2069128, "chapter_id": 2447, "verse_number": "९-६५-२५", "content_sanskrit": "यदिष्टं क्षत्रबन्धूनां स्वधर्ममनुतिष्ठताम्।\nनिधनं तन्मया प्राप्तं को नु स्वन्ततरो मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2069129, "chapter_id": 2447, "verse_number": "९-६५-२६", "content_sanskrit": "दिष्ट्या नाहं परावृत्तो वैरात्प्राकृतवञ्जितः।\nदिष्ट्या न विमतिं काञ्चिद्भजित्वा तु पराजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2069130, "chapter_id": 2447, "verse_number": "९-६५-२७", "content_sanskrit": "सुप्तं वाऽथ प्रमत्तं वा यथा हन्याद्विषेण वा।\nएवं व्युत्क्रान्तधर्मेण व्युत्क्रम्य समयं हतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2069131, "chapter_id": 2447, "verse_number": "९-६५-२८", "content_sanskrit": "अश्चत्थामा महाभागः कृतवर्मा च सात्वतः।\nकृपः शारद्वतश्चैव वक्तव्या वचनान्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2069132, "chapter_id": 2447, "verse_number": "९-६५-२९", "content_sanskrit": "अधर्मेण प्रवृत्तानां पाण्डवानामनेकशः।\nविश्वासं समयघ्नानां न यूयं गन्तुमर्हथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2069133, "chapter_id": 2447, "verse_number": "९-६५-३०", "content_sanskrit": "वार्तिकांश्चाब्रवीद्राजा पुत्रस्ते सत्यविक्रमः।\nअधर्माद्भीमसेनेन निहतोऽहं यथा रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2069134, "chapter_id": 2447, "verse_number": "९-६५-३१", "content_sanskrit": "सोऽहं द्रोणं स्वर्गगतं कर्णशल्यावुभौ तथा।\nवृषसेनं महावीर्यं शकुनिं चापि सौबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2069135, "chapter_id": 2447, "verse_number": "९-६५-३२", "content_sanskrit": "जलसन्धं महावीर्यं भगदत्तं च पार्थिवम्।\nसोमदत्तं महेष्वासं सैन्धवं च जयद्रथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2069136, "chapter_id": 2447, "verse_number": "९-६५-३३", "content_sanskrit": "दुऋशासनपुरोगांश्च भ्रातॄनात्मसमांस्तथा।\nदौःशासनिं च विक्रान्तं लक्ष्मणं चात्मजावुभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2069137, "chapter_id": 2447, "verse_number": "९-६५-३४", "content_sanskrit": "एतांश्चान्यांश्च सुबहून्मदीयांश्च सहस्रशः।\nपृष्ठतोऽनुगमिष्यामि सार्थहीनो यथाऽध्वगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2069138, "chapter_id": 2447, "verse_number": "९-६५-३५", "content_sanskrit": "कथं भ्रातॄन्हताञ्श्रुत्वा भर्तारं च स्वसा मम।\nरोरूयामाणा दुःखार्ता दुःशला सा भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2069139, "chapter_id": 2447, "verse_number": "९-६५-३६", "content_sanskrit": "स्नुषाभिः प्रस्नुषाभिश्च वृद्धो राजा पिता मम।\nगान्धारीसहितश्चैव का गतिं प्रतिपत्स्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2069140, "chapter_id": 2447, "verse_number": "९-६५-३७", "content_sanskrit": "नूनं लक्ष्मणमाताऽपि हतपुत्रा हतेश्वरा।\nविनाशं यास्यति क्षिप्रं कल्याणी पृथुलोचना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2069141, "chapter_id": 2447, "verse_number": "९-६५-३८", "content_sanskrit": "यदि जानाति चार्वाकः परिव्राद्वाग्विशारदः।\nकरिष्यति महाभागो ध्रुवं चापचितिं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2069142, "chapter_id": 2447, "verse_number": "९-६५-३९", "content_sanskrit": "समन्तप़ञ्चके पुण्ये त्रिषु लोकेषु विश्रुते।\nअहं निधनमासाद्य लोकान्प्राप्स्यामि शाश्वतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2069143, "chapter_id": 2447, "verse_number": "९-६५-४०", "content_sanskrit": "ततो जनसहस्राणि बाष्पपूर्णानि दिशो दश॥\nससागरवना घोरा पृथिवी सचराचरा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2069144, "chapter_id": 2447, "verse_number": "९-६५-४१", "content_sanskrit": "चचालाथ सनिर्हादा दिशश्चैवाविलाऽभवन्॥\nते द्रोणपुत्रमासाद्य यथावृत्तं न्यवेदयन्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2069145, "chapter_id": 2447, "verse_number": "९-६५-४२", "content_sanskrit": "व्यवहारं गदायुद्धे पार्थिवस्य च पातनम्॥\nतदाख्याय ततः सर्वे द्रोणपुत्रस्य भारत।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2069146, "chapter_id": 2447, "verse_number": "९-६५-४३", "content_sanskrit": "`वादिका दुःखसन्तप्ताः शोकोपहतचेतसः।\nध्यात्वा च सुचिरं कालं जग्मुरार्ता यथागतम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2069147, "chapter_id": 2447, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि गदायुद्धपर्वणि पञ्चषष्टितमोऽध्यायः॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]