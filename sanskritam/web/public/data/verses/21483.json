[{"id": 7001483000, "chapter_id": 21483, "verse_number": "७-२-२१-१", "content_sanskrit": "कृष्ण उवाच ।\nभगवञ्छ्रोतुमिच्छामि शिवाश्रमनिषेविणाम् ।\nशिवशास्त्रोदितं कर्म नित्यनैमित्तिकं तथा॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001483001, "chapter_id": 21483, "verse_number": "७-२-२१-२", "content_sanskrit": "उपमन्युरुवाच ।\nप्रातरुत्थाय शयनाद्ध्यात्वा देवं सहाम्बया ।\nविचार्य कार्यं निर्गच्छेद्गृहादभ्युदिते ऽरुणे॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001483002, "chapter_id": 21483, "verse_number": "७-२-२१-३", "content_sanskrit": "अबाधे विजने देशे कुर्यादावश्यकं ततः ।\nकृत्वा शौचं विधानेन दंतधावनमाचरेत्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001483003, "chapter_id": 21483, "verse_number": "७-२-२१-४", "content_sanskrit": "अलाभे दंतकाष्ठानामष्टम्यादिदिनेषु च ।\nअपां द्वादशगण्डूषैः कुर्यादास्यविशोधनम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001483004, "chapter_id": 21483, "verse_number": "७-२-२१-५", "content_sanskrit": "आचम्य विधिवत्पश्चाद्वारुणं स्नानमाचरेत् ।\nनद्यां वा देवखाते वा ह्रदे वाथ गृहे ऽपि वा॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001483005, "chapter_id": 21483, "verse_number": "७-२-२१-६", "content_sanskrit": "स्नानद्रव्याणि तत्तीरे स्थापयित्वा बहिर्मलम् ।\nव्यापोह्य मृदमालिप्य स्नात्वा गोमयमालिपेत्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001483006, "chapter_id": 21483, "verse_number": "७-२-२१-७", "content_sanskrit": "स्नात्वा पुनः पुनर्वस्त्रं त्यक्त्वावाथ विशोध्य च ।\nसुस्नातो नृपवद्भूयः शुद्धं वासो वसीत च॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001483007, "chapter_id": 21483, "verse_number": "७-२-२१-८", "content_sanskrit": "मलस्नानं सुगंधाद्यैः स्नानं दन्तविशोधनम् ।\nन कुर्याद्ब्रह्मचारी च तपस्वी विधवा तथा॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001483008, "chapter_id": 21483, "verse_number": "७-२-२१-९", "content_sanskrit": "सोपवीतश्शिखां बद्धा प्रविश्य च जलांतरम् ।\nअवगाह्य समाचांतो जले न्यस्येत्त्रिमंडलम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001483009, "chapter_id": 21483, "verse_number": "७-२-२१-१०", "content_sanskrit": "सौम्ये मग्नः पुनर्मंत्रं जपेच्छक्त्या शिवं स्मरेत् ।\nउत्थायाचम्य तेनैव स्वात्मानमभिषेचयेत्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001483010, "chapter_id": 21483, "verse_number": "७-२-२१-११", "content_sanskrit": "गोशृंगेण सदर्भेण पालाशेन दलेन वा ।\nपाद्मेन वाथ पाणिभ्यां पञ्चकृत्वस्त्रिरेव वा॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001483011, "chapter_id": 21483, "verse_number": "७-२-२१-१२", "content_sanskrit": "उद्यानादौ गृहे चैव वर्धन्या कलशेन वा ।\nअवगाहनकाले ऽद्भिर्मंत्रितैरभिषेचयेत्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001483012, "chapter_id": 21483, "verse_number": "७-२-२१-१३", "content_sanskrit": "अथ चेद्वारुणं कर्तुमशक्तः शुद्धवाससा ।\nआर्द्रेण शोधयेद्देहमापादतलमस्तकम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001483013, "chapter_id": 21483, "verse_number": "७-२-२१-१४", "content_sanskrit": "आग्नेयं वाथ वा मांत्रं कुर्यात्स्नानं शिवेन वा ।\nशिवचिंतापरं स्नानं युक्तस्यात्मीयमुच्यते॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001483014, "chapter_id": 21483, "verse_number": "७-२-२१-१५", "content_sanskrit": "स्वसूत्रोक्तविधानेन मंत्राचमनपूर्वकम् ।\nआचरेद्ब्रह्मयज्ञांतं कृत्वा देवादितर्पणम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001483015, "chapter_id": 21483, "verse_number": "७-२-२१-१६", "content_sanskrit": "मंडलस्थं महादेवं ध्यात्वाभ्यर्च्य यथाविधि ।\nदद्यादर्घ्यं ततस्तस्मै शिवायादित्यरूपिणे॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001483016, "chapter_id": 21483, "verse_number": "७-२-२१-१७", "content_sanskrit": "अथ वैतत्स्वसूत्रोक्तं कृत्वा हस्तौ विशोधयेत् ।\nकरन्यासं ततः कृत्वा सकलीकृतविग्रहः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001483017, "chapter_id": 21483, "verse_number": "७-२-२१-१८", "content_sanskrit": "वामहस्तगतांभोभिर्गंधसिद्धार्थकान्वितैः ।\nकुशपुंजेन वाभ्युक्ष्य मूलमंत्रसमन्वितैः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001483018, "chapter_id": 21483, "verse_number": "७-२-२१-१९", "content_sanskrit": "आपोहिष्ठादिभिर्मन्त्रैः शेषमाघ्राय वै जलम् ।\nवामनासापुटेनैव देवं संभावयेत्सितम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001483019, "chapter_id": 21483, "verse_number": "७-२-२१-२०", "content_sanskrit": "अर्घमादाय देहस्थं सव्यनासापुटेन च ।\nकृष्णवर्णेन बाह्यस्थं भावयेच्च शिलागतम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001483020, "chapter_id": 21483, "verse_number": "७-२-२१-२१", "content_sanskrit": "तर्पयेदथ देवेभ्य ऋषिभिश्च विशेषतः ।\nभूतेभ्यश्च पितृभ्यश्च दद्यादर्घ्यं यथाविधि॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001483021, "chapter_id": 21483, "verse_number": "७-२-२१-२२", "content_sanskrit": "रक्तचंदनतोयेन हस्तमात्रेण मंडलम् ।\nसुवृत्तं कल्पयेद्भूमौ रक्तचूर्णाद्यलंकृतम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001483022, "chapter_id": 21483, "verse_number": "७-२-२१-२३", "content_sanskrit": "तत्र संपूजयेद्भानुं स्वकीयावरणैः सह ।\nस्वखोल्कायेति मंत्रेण सांगतस्सुखसिद्धये॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001483023, "chapter_id": 21483, "verse_number": "७-२-२१-२४", "content_sanskrit": "पुनश्च मंडलं कृत्वा तदंगैः परिपूज्य च ।\nतत्र स्थाप्य हेमपात्रं मागधप्रस्थसंमितम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001483024, "chapter_id": 21483, "verse_number": "७-२-२१-२५", "content_sanskrit": "पूरयेद्गंधतोयेन रक्तचंदनयोगिना ।\nरक्तपुष्पैस्तिलैश्चैव कुशाक्षतसमन्वितैः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001483025, "chapter_id": 21483, "verse_number": "७-२-२१-२६", "content_sanskrit": "दूर्वापामार्गगव्यैश्च केवलेन जलेन वा ।\nजानुभ्यां धरणीं गत्वा नत्वा देवं च मंडले॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001483026, "chapter_id": 21483, "verse_number": "७-२-२१-२७", "content_sanskrit": "कृत्वा शिरसि तत्पात्रं दद्यादर्घ्यं शिवाय तत् ।\nअथवांजलिना तोयं सदर्भं मूलविद्यया॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001483027, "chapter_id": 21483, "verse_number": "७-२-२१-२८", "content_sanskrit": "उत्क्षिपेदम्बरस्थाय शिवायादित्यमूर्तये ।\nकृत्वा पुनः करन्यासं करशोधनपूर्वकम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001483028, "chapter_id": 21483, "verse_number": "७-२-२१-२९", "content_sanskrit": "बुद्ध्वेशानादिसद्यांतं पञ्चब्रह्ममयं शिवम् ।\nगृहीत्वा भसितं मन्त्रैर्विमृज्याङ्गानि संस्पृशेत्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001483029, "chapter_id": 21483, "verse_number": "७-२-२१-३०", "content_sanskrit": "या दिनांतैश्शिरोवक्त्रहृद्गुह्यचरणान्क्रमात् ।\nततो मूलेन सर्वांगमालभ्य वसनान्तरम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001483030, "chapter_id": 21483, "verse_number": "७-२-२१-३१", "content_sanskrit": "परिधाय द्विराचम्य प्रोक्ष्यैकादशमन्त्रितैः ।\nजलैराच्छाद्य वासो ऽयद्द्विराचम्य शिवं स्मरेत्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001483031, "chapter_id": 21483, "verse_number": "७-२-२१-३२", "content_sanskrit": "पुनर्न्यस्तकरो मन्त्री त्रिपुंड्रं भस्मना लिखेत् ।\nअवक्रमाय तं व्यक्तं ललाटे गन्धवारिणा॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001483032, "chapter_id": 21483, "verse_number": "७-२-२१-३३", "content_sanskrit": "वृत्तं वा चतुरस्रं वा बिन्दुमर्धेन्दुमेव वा ।\nललाटे यादृशं पुण्ड्रं लिखितं भस्मना पुनः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001483033, "chapter_id": 21483, "verse_number": "७-२-२१-३४", "content_sanskrit": "तादृशं भुजयोर्मूर्ध्नि स्तनयोरंतरे लिखेत् ।\nसर्वांगोद्धूलनं चैव न समानं त्रिपुण्ड्रकैः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001483034, "chapter_id": 21483, "verse_number": "७-२-२१-३५", "content_sanskrit": "तस्मात्त्रिपुण्ड्रमेवैकं लिखेदुद्धूलनं विना ।\nरुद्राक्षान्धारयेद्मूर्ध्नि कंठे श्रोते करे तथा॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001483035, "chapter_id": 21483, "verse_number": "७-२-२१-३६", "content_sanskrit": "सुवर्णवर्णमच्छिन्नं शुभं नान्यैर्धृतं शुभम् ।\nविप्रादीनां क्रमाच्छ्रेष्ठं पीतं रक्तमथासितम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001483036, "chapter_id": 21483, "verse_number": "७-२-२१-३७", "content_sanskrit": "तदलाभे यथालाभं धारणीयमदूषितम् ।\nतत्रापि नोत्तरं नीचैर्धार्यं नीचमथोत्तरैः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001483037, "chapter_id": 21483, "verse_number": "७-२-२१-३८", "content_sanskrit": "नाशुचिर्धारयेदक्षं सदा कालेषु धारयेत् ।\nइत्थं त्रिसंध्यमथवा द्विसंध्यं सकृदेव वा॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001483038, "chapter_id": 21483, "verse_number": "७-२-२१-३९", "content_sanskrit": "कृत्वा स्नानादिकं शक्त्या पूजयेत्परमेश्वरम् ।\nप्रजास्थानं समासाद्य बद्ध्वा रुचिरमासनम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001483039, "chapter_id": 21483, "verse_number": "७-२-२१-४०", "content_sanskrit": "ध्यायेद्देवं च देवीं च प्राङ्मुखो वाप्युदङ्मुखः ।\nश्वेतादीन्नकुलीशांतांस्तच्छिष्यान्प्रणमेद्गुरुम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001483040, "chapter_id": 21483, "verse_number": "७-२-२१-४१", "content_sanskrit": "पुनर्देवं शिवं नत्वा ततो नामाष्टकं जपेत् ।\nशिवो महेश्वरश्चैव रुद्रो विष्णुः पितामहः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001483041, "chapter_id": 21483, "verse_number": "७-२-२१-४२", "content_sanskrit": "संसारवैद्यस्सर्वज्ञः परमात्मेति चाष्टकम् ।\nअथवा शिवमेवैकं जपित्वैकादशाधिकम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001483042, "chapter_id": 21483, "verse_number": "७-२-२१-४३", "content_sanskrit": "जिह्वाग्रे तेजसो राशिं ध्यात्वाव्याध्यादिशांतये ।\nप्रक्षाल्य चरणौ कृत्वा करौ चंदनचर्चितौ॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001483043, "chapter_id": 21483, "verse_number": "७-२-२१-४४", "content_sanskrit": "प्रकुर्वीत करन्यासं करशोधनपूर्वकम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]