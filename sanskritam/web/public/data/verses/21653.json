[{"id": 7001653000, "chapter_id": 21653, "verse_number": "१-३९-१", "content_sanskrit": "सनक उवाच ।\nभूयः शृणुष्व विप्रेन्द्र माहात्म्यं परमेष्ठिनः ।\nसर्वपापहरं पुण्यं भुक्तिमुक्तिप्रदं नृणाम् 1.39.॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001653001, "chapter_id": 21653, "verse_number": "१-३९-२", "content_sanskrit": "अहो हरिकथालोके पापघ्न पुण्यदायिनी ।\nशृण्वतां वदतां चैव तद्भक्तानां विशेषतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001653002, "chapter_id": 21653, "verse_number": "१-३९-३", "content_sanskrit": "हरिभक्तिरसास्वादमुदिता ये नरोत्तमाः ।\nनमस्करोम्यहं तेभ्यो यत्सङ्गान्मुक्तिभाग्नरः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001653003, "chapter_id": 21653, "verse_number": "१-३९-४", "content_sanskrit": "हरिभक्तिपरा ये तु हरिनामपरायणाः ।\nदुर्वृत्ता वा सुवृत्ता वा तेभ्यो नित्यं नमो नमः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001653004, "chapter_id": 21653, "verse_number": "१-३९-५", "content_sanskrit": "संसारसागरं तर्तुं य इच्छेन्मुनिपुङ्गव ।\nस भजेद्धरिभक्तानां भक्तान्वै पापहारिणः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001653005, "chapter_id": 21653, "verse_number": "१-३९-६", "content_sanskrit": "दृष्टः स्मृतः पूजितो वा ध्यातः प्रणमितोऽपि वा ।\nसमुद्धरति गोविन्दो दुस्तराद्भवसागरात् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001653006, "chapter_id": 21653, "verse_number": "१-३९-७", "content_sanskrit": "स्वपन् भुञ्जन् व्रजंस्तिष्ठन्नतिष्ठंश्च वदंस्तथा ।\nचिन्तयेद्यो हरेर्नाम तस्मै नित्यं नमो नमः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001653007, "chapter_id": 21653, "verse_number": "१-३९-८", "content_sanskrit": "अहो भाग्यमहो भाग्यं विष्णुभक्तिरतात्मनाम् ।\nयेषां मुक्तिः करस्थैव योगिनामपि दुर्लभा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001653008, "chapter_id": 21653, "verse_number": "१-३९-९", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nवदतां शृण्वतां चैव सर्वपापप्रणाशनम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001653009, "chapter_id": 21653, "verse_number": "१-३९-१०", "content_sanskrit": "आसीत् पुरा महीपालः सोमवंशसमुद्भवः ।\nजयध्वज इति ख्यातो नारायणपरायणः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001653010, "chapter_id": 21653, "verse_number": "१-३९-११", "content_sanskrit": "विष्णोर्देवालये नित्यं सम्मार्जनपरायणः ।\nदीपदानरतश्चैव सर्वभूतदयापरः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001653011, "chapter_id": 21653, "verse_number": "१-३९-१२", "content_sanskrit": "स कदाचिन्महीपालो रेवातीरे मनोरमे ।\nविचित्रकुसुमोपेतं कृतवान्विष्णुमन्दिरम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001653012, "chapter_id": 21653, "verse_number": "१-३९-१३", "content_sanskrit": "स तत्र नृपशार्दूलः सदा सम्मार्जने रतः ।\nदीपदानपरश्चैव विशेषेण हरिप्रियः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001653013, "chapter_id": 21653, "verse_number": "१-३९-१४", "content_sanskrit": "हरिनामपरो नित्यं हरिसंसक्तमानसः ।\nहरिप्रणामनिरतो हरिभक्तजनप्रियः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001653014, "chapter_id": 21653, "verse_number": "१-३९-१५", "content_sanskrit": "वीतिहोत्र इति ख्यातो ह्यासीत्तस्य पुरोहितः ।\nजयध्वजस्य चरितं दृष्ट्वा विस्मयमागतः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001653015, "chapter_id": 21653, "verse_number": "१-३९-१६", "content_sanskrit": "कदाचिदुपविष्टं तं राजानं विष्णुतत्परम् ।\nअपृच्छद्वीतिहोत्रस्तु वेदवेदाङ्गपारगः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001653016, "chapter_id": 21653, "verse_number": "१-३९-१७", "content_sanskrit": "वीतिहोत्र उवाच ।\nराजन्परमधर्मज्ञ हरिभक्तिपरायण ।\nविष्णुभक्तिमतां पुंसां श्रेष्ठोऽसि भरतर्षभ ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001653017, "chapter_id": 21653, "verse_number": "१-३९-१८", "content_sanskrit": "सम्मार्जनपरो नित्यं दीपदानरतस्तथा ।\nतन्मे वद महाभाग किं त्वया विदितं फलम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001653018, "chapter_id": 21653, "verse_number": "१-३९-१९", "content_sanskrit": "संपादनेन वर्त्तीनां तैल संपादनेन च ।\nसंयुक्तोऽसि सदा भद्र यद्विष्णोर्गृहमार्जने ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001653019, "chapter_id": 21653, "verse_number": "१-३९-२०", "content_sanskrit": "कर्माण्यन्यानि सन्त्येव विष्णोः प्रीतिकराणि च ।\nतथापि किं महाभाग एतयोः सततोद्यतः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001653020, "chapter_id": 21653, "verse_number": "१-३९-२१", "content_sanskrit": "सर्वात्मना महापुण्यं नरेश विदितं च यत् ।\nतद् ब्रूहि मे गुह्यतमं प्रीतिर्मयि तवास्ति चेत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001653021, "chapter_id": 21653, "verse_number": "१-३९-२२", "content_sanskrit": "पुरोधसैवमुक्तस्तु प्रहसन्स जयध्वजः ।\nविनयावनतो भूत्वा प्रोवाचेदं कृताञ्जलि ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001653022, "chapter_id": 21653, "verse_number": "१-३९-२३", "content_sanskrit": "जयध्वज उवाच ।\nशृणुष्व विप्रशार्दूल मयैवाचरितं पुरा ।\nजातिस्मरत्वाज्जानामि श्रोतॄणां विस्मयप्रदम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001653023, "chapter_id": 21653, "verse_number": "१-३९-२४", "content_sanskrit": "आसीत्पुरा कृतयुगे ब्रह्मन्स्वारोचिषेऽन्तरे ।\nरैवतो नाम विप्रेन्द्रो वेदवेदाङ्गपारगः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001653024, "chapter_id": 21653, "verse_number": "१-३९-२५", "content_sanskrit": "अयाज्ययाजकश्चैव सदैव ग्रामयाजकः ।\nपिशुनो निष्ठुरश्चैव ह्यपण्यानां च विक्रयी ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001653025, "chapter_id": 21653, "verse_number": "१-३९-२६", "content_sanskrit": "निषिद्धकर्माचरणात्परित्यक्तः स बन्धुभिः ।\nदरिद्रो दुःखितश्चैव शीर्णाङ्गो व्याधितोऽभवत् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001653026, "chapter_id": 21653, "verse_number": "१-३९-२७", "content_sanskrit": "स कदाचिद्धनार्थं तु पृथिव्यां पर्यटन् द्विजः ।\nममार नर्मदातीरे श्वासकासप्रपीडितः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001653027, "chapter_id": 21653, "verse_number": "१-३९-२८", "content_sanskrit": "तस्मिन्मृते तस्य भार्या नाम्ना बन्धुमती मुने ।\nकामचारपरा सा तु परित्यक्ता च बन्धुभिः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001653028, "chapter_id": 21653, "verse_number": "१-३९-२९", "content_sanskrit": "तस्यां जातोऽस्मि चण्डालो दण्डकेतुरिति श्रुतः ।\nमहापापरतो नित्यं ब्रह्मद्वेषपरायणः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001653029, "chapter_id": 21653, "verse_number": "१-३९-३०", "content_sanskrit": "परदारपरद्र व्यलोलुपो जन्तुहिंसकः ।\nगावश्च विप्रा बहवो निहता मृगपक्षिणः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001653030, "chapter_id": 21653, "verse_number": "१-३९-३१", "content_sanskrit": "मेरुतुल्यसुवर्णानि बहून्यपहृतानि च ।\nमद्यपानरतो नित्यं बहुशो मार्गरोधकृत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001653031, "chapter_id": 21653, "verse_number": "१-३९-३२", "content_sanskrit": "पशुपक्षिमृगादीनां जन्तूनामन्तकोपमः ।\nकदाचित्कामसन्तप्तो गन्तुकामो रतिं स्त्रियः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001653032, "chapter_id": 21653, "verse_number": "१-३९-३३", "content_sanskrit": "शून्यं विष्णुगृहं दृष्ट्वा प्रविष्टश्च स्त्रिया सह ।\nनिशि रामोपभोगार्थं शयितं तत्र कामिना ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001653033, "chapter_id": 21653, "verse_number": "१-३९-३४", "content_sanskrit": "ब्रह्मन्स्ववस्त्रप्रान्तेन कियद्देशः प्रमार्जितः ।\nयावन्त्यः पांशुकणिकास्तत्र सम्मार्जिता द्विज ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001653034, "chapter_id": 21653, "verse_number": "१-३९-३५", "content_sanskrit": "तावज्जन्मकृतं पापं तदैव क्षयमागतम् ।\nप्रदीपः स्थापितस्तत्र सुरतार्थं द्विजोत्तम ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001653035, "chapter_id": 21653, "verse_number": "१-३९-३६", "content_sanskrit": "तेनापि मम दुष्कर्म निःशेषं क्षयमागतम् ।\nएवं स्थिते विष्णुगृहे ह्यागताः पुरपालकाः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001653036, "chapter_id": 21653, "verse_number": "१-३९-३७", "content_sanskrit": "जारोऽयमिति मां तां च हतवन्तः प्रसह्य वै ।\nआवां निहत्य ते सर्वे निवृत्ताः पुररक्षकाः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001653037, "chapter_id": 21653, "verse_number": "१-३९-३८", "content_sanskrit": "यदा तदैव सम्प्राप्ता विष्णुदूताश्चतुर्भुजाः ।\nकिरीटकुण्डलधरा वनमालाविभूषिताः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001653038, "chapter_id": 21653, "verse_number": "१-३९-३९", "content_sanskrit": "तैस्तु स्रंपेरितावावां विष्णुदूतैरकल्मषैः ।\nदिव्यं विमानमारुह्य सर्वभोगसमन्वितम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001653039, "chapter_id": 21653, "verse_number": "१-३९-४०", "content_sanskrit": "दिव्यदेहधरौ भूत्वा विष्णुलोकमुपागतौ ।\nतत्र स्थित्वा ब्रह्मकल्पशतं साग्रं द्विजोत्तम ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001653040, "chapter_id": 21653, "verse_number": "१-३९-४१", "content_sanskrit": "दिव्यभोगसमायुक्तौ तावत्कालं दिवि स्थितौ ।\nततश्च भूभिभागेषु देवयोगेषु वै क्रमात् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001653041, "chapter_id": 21653, "verse_number": "१-३९-४२", "content_sanskrit": "तेन पुण्यप्रभावेण यदूनां वंशसंभवः ।\nतेनैव मेऽच्युता संपत्तथा राज्यमकण्टकम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001653042, "chapter_id": 21653, "verse_number": "१-३९-४३", "content_sanskrit": "ब्रह्मन्कृत्वोपभोगार्थमेवं श्रेयो ह्यवाप्तवान् ।\nभक्त्या कुर्वन्ति ये सन्तस्तेषां पुण्यं न वेद्म्यहम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001653043, "chapter_id": 21653, "verse_number": "१-३९-४४", "content_sanskrit": "तस्मात्संमार्जने नित्यं दीपदाने च सत्तम ।\nयतिष्ये परया भक्त्या ह्यहं जातिस्मरो यतः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001653044, "chapter_id": 21653, "verse_number": "१-३९-४५", "content_sanskrit": "यः पूजयेज्जगन्नाथमेकाकी विगतस्पृहः ।\nसर्वपापविनिर्मुक्तः प्रयाति परमं पदम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001653045, "chapter_id": 21653, "verse_number": "१-३९-४६", "content_sanskrit": "अवशेनापि यत्कर्म कृत्वेमां श्रियमागतः ।\nभक्तिमद्भिः प्रशान्तैश्च किं पुनः सम्यगर्चनात् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001653046, "chapter_id": 21653, "verse_number": "१-३९-४७", "content_sanskrit": "इति भूपवचः श्रुत्वा वीतिहोत्रो द्विजोत्तमः ।\nअनन्ततुष्टिमापन्नो हरिपूजापरोऽभवत् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001653047, "chapter_id": 21653, "verse_number": "१-३९-४८", "content_sanskrit": "तस्माच्छृणुष्व विप्रेन्द्र देवो नारायणोऽव्ययः ।\nज्ञानतोऽज्ञानतो वापि पूजकानां विमुक्तिदः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001653048, "chapter_id": 21653, "verse_number": "१-३९-४९", "content_sanskrit": "अनित्या बान्धवाः सर्वे विभवो नैव शाश्वतः ।\nनित्यं सन्निहितो मृत्युः कर्तव्यो धर्मसङ्ग्रहः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001653049, "chapter_id": 21653, "verse_number": "१-३९-५०", "content_sanskrit": "अज्ञो लोको वृथा गर्वं करिष्यति महोद्धतः ।\nकायः सन्निहितापायो धनादीनां किमुच्यते ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001653050, "chapter_id": 21653, "verse_number": "१-३९-५१", "content_sanskrit": "जन्मकोटिसहस्रेषु पुण्यं यैः समुपार्जितम् ।\nतेषां भक्तिर्भवेच्छुद्धा देवदेवे जनार्दने ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001653051, "chapter_id": 21653, "verse_number": "१-३९-५२", "content_sanskrit": "सुलभं जाह्नवीस्नानं तथैवातिथिपूजनम् ।\nसुलभाः सर्वयज्ञाश्च विष्णुभक्तिः सुदुर्लभा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001653052, "chapter_id": 21653, "verse_number": "१-३९-५३", "content_sanskrit": "दुर्लभा तुलसीसेवा दुर्लभः सङ्गमः सताम् ।\nसर्वभूतदया वापि सुलभा यस्य कस्यचित् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001653053, "chapter_id": 21653, "verse_number": "१-३९-५४", "content_sanskrit": "सत्सङ्गस्तुलसीसेवा हरिभक्तिश्च दुर्लभा ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001653054, "chapter_id": 21653, "verse_number": "१-३९-५५", "content_sanskrit": "दुर्लभं प्राप्य मानुष्यं न तथा गमयेद् बुधः ।\nअर्चयेद्धि जगन्नाथं सारमेतद् द्विजोत्तम ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001653055, "chapter_id": 21653, "verse_number": "१-३९-५६", "content_sanskrit": "तर्त्तुं यदीच्छति जनो दुस्तरं भवसागरम् ।\nहरिभक्तिपरो भूयादेतदेव रसायनम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001653056, "chapter_id": 21653, "verse_number": "१-३९-५७", "content_sanskrit": "भ्रातराश्रय गोविन्दं मा विलम्बं कुरु प्रिय ।\nआसन्नमेव नगरं कृतान्तस्य हि दृश्यते ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001653057, "chapter_id": 21653, "verse_number": "१-३९-५८", "content_sanskrit": "नारायणं जगद्योनिं सर्वकारणकारणम् ।\nसमर्चयस्व विप्रेन्द्र यदि मुक्तिमभीप्ससि ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001653058, "chapter_id": 21653, "verse_number": "१-३९-५९", "content_sanskrit": "सर्वाधारं सर्वयोनिं सर्वान्तर्यामिणं विभुम् ।\nये प्रपन्ना महात्मानस्ते कृतार्था न संशयः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001653059, "chapter_id": 21653, "verse_number": "१-३९-६०", "content_sanskrit": "ते वन्द्यास्ते प्रपूज्याश्च नमस्कार्या विशेषतः ।\nयेऽचयन्ति महाविष्णुं प्रणतार्तिप्रणाशनम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001653060, "chapter_id": 21653, "verse_number": "१-३९-६१", "content_sanskrit": "ये विष्णुभक्ता निष्कामा यजन्ति परमेश्वरम् ।\nत्रिःसप्तकुलसंयुक्तास्ते यान्ति हरिमन्दिरम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001653061, "chapter_id": 21653, "verse_number": "१-३९-६२", "content_sanskrit": "विष्णुभक्ताय यो दद्यान्निष्कामाय महात्मने ।\nपानीयं वा फलं वापि स एव भगवत्प्रियः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001653062, "chapter_id": 21653, "verse_number": "१-३९-६३", "content_sanskrit": "विष्णुभक्तिपराणां तु शुश्रूषां कुर्वते तु ये ।\nते यान्ति विष्णुभुवनं यावदाभूतसंप्लवम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001653063, "chapter_id": 21653, "verse_number": "१-३९-६४", "content_sanskrit": "ये यजन्ति स्पृहाशून्या हरिभक्तान् हरिं तथा ।\nत एव भुवनं सर्वं पुनन्ति स्वाङिघ्रपांशुना ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001653064, "chapter_id": 21653, "verse_number": "१-३९-६५", "content_sanskrit": "देवपूजापरो यस्य गृहे वसति सर्वदा ।\nतत्रैव सर्वदेवाश्च तिष्ठन्ति श्रीहरिस्तथा ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001653065, "chapter_id": 21653, "verse_number": "१-३९-६६", "content_sanskrit": "पूज्यमाना च तुलसी यस्य तिष्ठति वेश्मनि ।\nतत्र सर्वाणि श्रेयांसि वर्द्धन्त्यहरहर्द्विज ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001653066, "chapter_id": 21653, "verse_number": "१-३९-६७", "content_sanskrit": "शालग्रामशिलारूपी यत्र तिष्ठति केशवः ।\nन बाधन्ते ग्रहास्तत्र भूतवेतालकादयः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001653067, "chapter_id": 21653, "verse_number": "१-३९-६८", "content_sanskrit": "शालग्रामशिला यत्र तत्तीर्थं तत्तपोवनम् ।\nयतः सन्निहितस्तत्र भगवान्मधुसूदनः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001653068, "chapter_id": 21653, "verse_number": "१-३९-६९", "content_sanskrit": "यद् गृहे नास्ति देवर्षे शालग्रामशिलार्चनम् ।\nश्मशानसदृशं विद्यात्तद् गृहं शुभवर्जितम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001653069, "chapter_id": 21653, "verse_number": "१-३९-७०", "content_sanskrit": "पुराणन्यायमीमांसाधर्मशास्राणि च द्विज ।\nसाङ्गा वेदास्तथा सर्वे विष्णो रूपं प्रकीर्तितम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001653070, "chapter_id": 21653, "verse_number": "१-३९-७१", "content_sanskrit": "भक्त्या कुर्वन्ति ये विष्णोः प्रदक्षिणचतुष्टयम् ।\nतेऽपि यान्ति परं स्थानं सर्वकर्मनिबर्हणम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]