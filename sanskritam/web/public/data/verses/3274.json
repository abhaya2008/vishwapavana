[{"id": 2105401, "chapter_id": 3274, "verse_number": "१६-३-१", "content_sanskrit": "वैशम्पायन उवाच।\nयुधिष्ठिरस्य नृपतेर्दुर्योधनपितुस्तदा।\nनान्तरं दद्दशू राज्ये पुरुषाः प्रणयं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2105402, "chapter_id": 3274, "verse_number": "१६-३-२", "content_sanskrit": "यदा तु कौरवो राजा पुत्रं सस्मार बालिशम्।\nतदा भीमं हृदा राजन्नपध्याति स पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2105403, "chapter_id": 3274, "verse_number": "१६-३-३", "content_sanskrit": "कौरवश्चैव भीमश्च हृदाऽन्योन्यमवर्तताम्।\nध्यायन्तौ श्लक्ष्णया वाचा त्वन्योन्यमभितिष्टितां", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2105404, "chapter_id": 3274, "verse_number": "१६-३-४", "content_sanskrit": "अप्रकाशं व्यलीकानि चकारास्य वृकोदरः।\nआज्ञां प्रत्यहरच्चापि कृतकैः पुरुषैः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2105405, "chapter_id": 3274, "verse_number": "१६-३-५", "content_sanskrit": "स्मरन्दुर्मन्त्रितं तस्य वृत्तान्यप्यस्य कानिचित्।\n`असकृच्चाप्युवाचेदं हतास्ते मन्दचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2105406, "chapter_id": 3274, "verse_number": "१६-३-६", "content_sanskrit": "अथ भीमः सुहृन्मध्ये बाहुशब्दं तथाऽकरोत्।\nसंश्रवे धृतराष्ट्रस्य गान्धार्याश्चाप्यमर्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2105407, "chapter_id": 3274, "verse_number": "१६-३-७", "content_sanskrit": "स्मृत्वा दुर्योधनं शत्रुं कर्णदुःखासनावपि।\nप्रोवाचेदं सुसंरब्धो भीमः सपरुषं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2105408, "chapter_id": 3274, "verse_number": "१६-३-८", "content_sanskrit": "अन्धस्य नृपतेः पुत्रा मया परिघवाहुना।\nनीता लोकममुं सर्वे नानाशस्त्रास्त्रयोधिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2105409, "chapter_id": 3274, "verse_number": "१६-३-९", "content_sanskrit": "इमौ तौ परिघप्रख्यौ भुजौ मम दुरासदौ।\nययोरन्तरमासाद्य धार्तराष्ट्राः क्षयं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2105410, "chapter_id": 3274, "verse_number": "१६-३-१०", "content_sanskrit": "ताविमौ चन्दनेनाकौ वन्दनीयौ च मे भुजौ।\nयाभ्यां दुर्योधनो नीतः क्षयं ससुतबान्धवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2105411, "chapter_id": 3274, "verse_number": "१६-३-११", "content_sanskrit": "एतास्चान्याश्च विविधाः शल्यभुता नराधिपः।\nवृकोदरस्य ता वाचः श्रुत्वा निर्वेदमागमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2105412, "chapter_id": 3274, "verse_number": "१६-३-१२", "content_sanskrit": "सा च बुद्धिमती देवी कालपर्यायवेदिनी।\nगान्धारी सर्वधर्मज्ञा तान्यलीकानि शुश्रुवे।\n`कुन्तीं वर्या तु संवीक्ष्य शापे नास्याकरोन्मति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2105413, "chapter_id": 3274, "verse_number": "१६-३-१३", "content_sanskrit": "ततः पञ्चदशे वर्षे समतीते नराधिपः।\nराजा निर्वेदमापेदे भीमवाग्बाणपीडितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2105414, "chapter_id": 3274, "verse_number": "१६-३-१४", "content_sanskrit": "`सुखासक्तं कृच्छ्रपरं ज्ञात्वा चैव युधिष्ठिरम्।\nतपोयोगात्तपस्तप्तुं मनश्चक्रे महामतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2105415, "chapter_id": 3274, "verse_number": "१६-३-१५", "content_sanskrit": "नान्वबुध्यत तद्राजा कुन्तीपुत्रो युधिष्ठिरः।\nश्वेताश्वोवाऽथकुन्ती वा द्रौपदी वा यशस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2105416, "chapter_id": 3274, "verse_number": "१६-३-१६", "content_sanskrit": "माद्रीपुत्रौ च भीमस्य मतं तावन्ववर्तताम्।\nराज्ञस्तु चित्तं रक्षन्तौ नोचतुः स्वयमप्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2105417, "chapter_id": 3274, "verse_number": "१६-३-१७", "content_sanskrit": "ततः समानयामास धृतराष्ट्रः सुहृज्जनम्।\nबाष्पसंदिग्धमत्यर्थमिदमाह च तान्भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2105418, "chapter_id": 3274, "verse_number": "१६-३-१८", "content_sanskrit": "विदितं भवतामेतद्यथा वृत्तः कुरुक्षयः।\nममापराधात्तत्सर्वमिति ज्ञेयं तु कौरवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2105419, "chapter_id": 3274, "verse_number": "१६-३-१९", "content_sanskrit": "योऽहं दुष्टमतिं मन्दो ज्ञातीनां भयवर्धनम्।\nदुर्योधनं कौरवाणामाधइपत्येऽभ्यषेचयम्।\nयच्चाहं वासुदेवस्य नाश्रौषं वाक्यमर्थवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2105420, "chapter_id": 3274, "verse_number": "१६-३-२०", "content_sanskrit": "वध्यतां साध्वयं पापः सामात्य इति दुर्मतिः।\nपुत्रस्नेहाभिभूतस्तु हितमुक्तो मनीषिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2105421, "chapter_id": 3274, "verse_number": "१६-३-२१", "content_sanskrit": "विदुरेणाथ भीष्मेण द्रोणेन च कृपेण च।\nपदेपदे भगवता व्यासेन च महात्मना।\nसंजयेनाथ गान्धार्या तदिदं तप्यते मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2105422, "chapter_id": 3274, "verse_number": "१६-३-२२", "content_sanskrit": "यच्चाहं पाण्डुपुत्रेषु गुणवत्सु महात्मसु।\nन न्यस्तवाञ्श्रियं दीप्तां पितृपैतामहीमिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2105423, "chapter_id": 3274, "verse_number": "१६-३-२३", "content_sanskrit": "विनाशं पश्यमानो हि सर्वराज्ञां गदाग्रजः।\nएतच्छ्रेयस्तु परमममन्यत जनार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2105424, "chapter_id": 3274, "verse_number": "१६-३-२४", "content_sanskrit": "सोहमेतान्यलीकानि दुर्वृत्तान्यात्मनस्तदा।\nहृदये शल्यभूतानि धारयामि सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2105425, "chapter_id": 3274, "verse_number": "१६-३-२५", "content_sanskrit": "विशेषतस्तु दह्यामि वर्षे पञ्चदशेऽद्य वै।\nअस्य पापस्य शुद्ध्यर्थं नियतोस्मि सुदुर्मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2105426, "chapter_id": 3274, "verse_number": "१६-३-२६", "content_sanskrit": "चतुर्थे नियते काले कदाचिदपि चाष्टमे।\nतृष्णाविनयनं भुञ्जे गान्धारी वेद तन्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2105427, "chapter_id": 3274, "verse_number": "१६-३-२७", "content_sanskrit": "करोत्याहारमिति मां सर्वः परिजनः सदा।\nयुधिष्ठिरभयादेति भृशं तप्यति पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2105428, "chapter_id": 3274, "verse_number": "१६-३-२८", "content_sanskrit": "भूमौ शये जप्यपरो दर्भष्वजिनसंवृतः।\nनियमव्यपदेशेन गान्धारी च यशस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2105429, "chapter_id": 3274, "verse_number": "१६-३-२९", "content_sanskrit": "अहं पुत्रशतं वीरं सङ्ग्रामेष्वपलायिनम्।\nनानुतप्ये हतं तत्र क्षत्रधर्मं हि तं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2105430, "chapter_id": 3274, "verse_number": "१६-३-३०", "content_sanskrit": "इत्युक्त्वा धर्मराजानमभ्यभाषत कौरवः।\nभद्रं ते यादवीमातर्वचश्चेदं निबोध मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2105431, "chapter_id": 3274, "verse_number": "१६-३-३१", "content_sanskrit": "सुखमध्युषितः पुत्र त्वया सुपरिपालितः।\nमया दानानि दत्तानि श्राद्धानि च पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2105432, "chapter_id": 3274, "verse_number": "१६-३-३२", "content_sanskrit": "प्रकृष्टं च मया पुत्र पुण्यं चीर्णं यथाबलम्।\nगान्धारी हतपुत्रेयं धैर्येणोदीक्षते च माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2105433, "chapter_id": 3274, "verse_number": "१६-३-३३", "content_sanskrit": "द्रौपद्या ह्यपकर्तारस्तव चैश्वर्यहारिणः।\nसमतीता नृशंसास्ते स्वधर्मेण हता युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2105434, "chapter_id": 3274, "verse_number": "१६-३-३४", "content_sanskrit": "न तेषु प्रतिकर्तव्यं पश्यामि कुरुनन्दन।\nसर्वे शस्त्रजिताँल्लोकान्गतास्तेऽभिमुखं हताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2105435, "chapter_id": 3274, "verse_number": "१६-३-३५", "content_sanskrit": "आत्मनस्तु हितं पुण्यं प्रतिकर्तव्यमद्य ते।\nगान्धार्याश्चैव राजेन्द्र तदनुज्ञातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2105436, "chapter_id": 3274, "verse_number": "१६-३-३६", "content_sanskrit": "त्वं तु शस्त्रभृतां श्रेष्ठः सततं धर्मवत्सलः।\nराजा गुरुः प्राणभृतां तस्मादेतद्ब्रवीम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2105437, "chapter_id": 3274, "verse_number": "१६-३-३७", "content_sanskrit": "अनुज्ञातस्त्वया वीर संश्रयेयं वनान्यहम्।\nचीरवल्कलभृद्राजन्गान्धार्या सहितोऽनया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2105438, "chapter_id": 3274, "verse_number": "१६-३-३८", "content_sanskrit": "तवाशिषः प्रयुञ्जानो भविष्यामि वनेचरः।\nउचितं नः कुले तात सर्वेषां भरतर्षभ।\nपुत्रेष्वैश्चर्यमाधाय वयसोन्ते वनं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2105439, "chapter_id": 3274, "verse_number": "१६-३-३९", "content_sanskrit": "तत्राहं वायुभक्षो वा निराहारोपि वा वसन्।\nपत्न्या सहानया वीर चरिष्यामि तपः परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2105440, "chapter_id": 3274, "verse_number": "१६-३-४०", "content_sanskrit": "त्वं चापि फलभाक्तात तपसः पार्थिवो ह्यसि।\nफलभाजो हि राजानः कल्याणस्येतरस्य वा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2105441, "chapter_id": 3274, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्रमवासिकपर्वणि आश्रमवासपर्वणि तृतीयोऽध्यायः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]