[{"id": 2150495, "chapter_id": 4264, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2150496, "chapter_id": 4264, "verse_number": "१", "content_sanskrit": "प्रभातायां तु शर्वर्यां पुनरेव सुतस्तव ।\nमध्ये सर्वस्य सैन्यस्य पितामहमपृच्छत\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2150497, "chapter_id": 4264, "verse_number": "२", "content_sanskrit": "पाण्डवेयस्य गाङ्गेय यदेतत् सैन्यमुत्तमम् ।\nप्रभूतनरनागाश्वं महारथसमाकुलम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2150498, "chapter_id": 4264, "verse_number": "३", "content_sanskrit": "भीमार्जुनप्रभृतिभिर्महेष्वासैर्महात्मभिः ।\nलोकपालसमैर्गुप्तं धृष्टद्युम्नपुरोगमैः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2150499, "chapter_id": 4264, "verse_number": "४", "content_sanskrit": "अप्रधृष्यमनावार्यमुद्धूतमिव सागरम् ।\nसेनासागरमक्षोभ्यमपि देवैर्महाहवे\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2150500, "chapter_id": 4264, "verse_number": "५", "content_sanskrit": "केन कालेन गाङ्गेय क्षपयेथा महाद्युते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2150501, "chapter_id": 4264, "verse_number": "६", "content_sanskrit": "आचार्यो वा महेष्वासः कृपो वा सुमहाबलः ।\nकर्णो वा समरश्लाघी द्रौणिर्वा द्विजसत्तमः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2150502, "chapter_id": 4264, "verse_number": "७", "content_sanskrit": "दिव्यास्त्रविदुषः सर्वे भवन्तो हि बले मम\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2150503, "chapter_id": 4264, "verse_number": "८", "content_sanskrit": "एतदिच्छाम्यहं ज्ञातुं परं कौतूहलं हि मे ।\nहृदि नित्यं महाबाहो वक्तुमर्हसि तन्मम\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2150504, "chapter_id": 4264, "verse_number": "९", "content_sanskrit": "अनेनाहं विधानेन सन्नद्धः सततोत्थितः ।\nक्षपयेयं महत् सैन्यं केन कालेन भारत\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2150505, "chapter_id": 4264, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2150506, "chapter_id": 4264, "verse_number": "१०", "content_sanskrit": "अनुरूपं कुरुश्रेष्ठ त्वय्येतद् पृथिवीपते ।\nबलाबलममित्राणां तेषां यदिह पृच्छसि\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2150507, "chapter_id": 4264, "verse_number": "११", "content_sanskrit": "शृणु राजन् मम रणे या शक्तिः परमा भवेत् ।\nशस्त्रवीर्यं रणे यच्च भुजयोश्च महाभुज\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2150508, "chapter_id": 4264, "verse_number": "१२", "content_sanskrit": "आर्जवेनैव युद्धेन योद्धव्य इतरो जनः ।\nमायायुद्धेन मायावी इत्येतद् धर्मनिश्चितम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2150509, "chapter_id": 4264, "verse_number": "१३", "content_sanskrit": "हन्यामहं महाभाग पाण्डवानामनीकिनीम् ।\nदिवसे दिवसे कृत्वा भागान् भागाधिकं मम\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2150510, "chapter_id": 4264, "verse_number": "१४", "content_sanskrit": "राज्ञां तु दशसाहस्रं कृत्वा भागं महाद्युते ।\nसहस्रं रथिनामेकमेकभागो मतो मम\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2150511, "chapter_id": 4264, "verse_number": "१५", "content_sanskrit": "अनेनाहं विधानेन सन्नद्धः सततोत्थितः ।\nक्षपयेयं महत् सैन्यं कालेनानेन भारत\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2150512, "chapter_id": 4264, "verse_number": "१६", "content_sanskrit": "मुञ्चेयं यदि शस्त्राणि महान्ति समरे स्थितः ।\nशतसाहस्रघातीनि हन्यां मासेन भारत\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2150513, "chapter_id": 4264, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2150514, "chapter_id": 4264, "verse_number": "१७", "content_sanskrit": "श्रुत्वा भीष्मस्य तद्वाक्यं राजा दुर्योधनस्ततः ।\nपर्यपृच्छत राजेन्द्र द्रोणमङ्गिरसां वरम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2150515, "chapter_id": 4264, "verse_number": "१८", "content_sanskrit": "आचार्य केन कालेन पाण्डुपुत्रस्य सैनिकान् ।\nनिहन्या इति तं द्रोणः प्रत्युवाच हसन्निव\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2150516, "chapter_id": 4264, "verse_number": "१९", "content_sanskrit": "स्थविरोऽस्मि महाबाहो मन्दप्राणविचेष्टितः ।\nशस्त्राग्निना निर्दहेयं पाण्डवानामनीकिनीम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2150517, "chapter_id": 4264, "verse_number": "२०", "content_sanskrit": "यथा भीष्मः शान्तनवो मासेनेति मतिर्मम ।\nएषा मे परमा शक्तिरेतन्मे परमं बलम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2150518, "chapter_id": 4264, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2150519, "chapter_id": 4264, "verse_number": "२१", "content_sanskrit": "द्वाभ्यामेव तु मासाभ्यां कृपः शारद्वतोऽब्रवीत् ।\nद्रौणिस्तु दशरात्रेण प्रतिजज्ञे बलक्षयम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2150520, "chapter_id": 4264, "verse_number": "२२", "content_sanskrit": "कर्णस्तु पञ्चरात्रेण प्रतिजज्ञे महास्त्रवित्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2150521, "chapter_id": 4264, "verse_number": "२३", "content_sanskrit": "तच्छ्रुत्वा सूतपुत्रस्य वाक्यं सागरगासुतः ।\nजहास सस्वनं हासं वाक्यं चेदमुवाच ह\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2150522, "chapter_id": 4264, "verse_number": "२४", "content_sanskrit": "न हि यावद् रणे पार्थं बाणशङ्खधनुर्धरम् ।\nवासुदेवसमायुक्तं रथेनोद्यन्तमुद्यतम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2150523, "chapter_id": 4264, "verse_number": "२५", "content_sanskrit": "समागच्छसि राधेय त्वं नैवमवमन्यसे ।\nशक्यमेवं च भूयश्च त्वया वक्तुं यथेष्टतः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2150524, "chapter_id": 4264, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि पञ्चनवत्युत्तरशततमोऽध्यायः ॥१९५॥\nअम्बोपाख्यानपर्वणि पञ्चविंशोऽध्यायः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]