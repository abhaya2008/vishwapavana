[{"id": 5000639000, "chapter_id": 9639, "verse_number": "७-१०४-१", "content_sanskrit": "शृणु राजन्महासत्व यदर्थमहमागतः ।\nपितामहेन देवेन प्रेषितो ऽस्मि महाबल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000639001, "chapter_id": 9639, "verse_number": "७-१०४-२", "content_sanskrit": "तवाहं पूर्वसद्भावे पुत्रः परपुरञ्जय ।\nमायासम्भावितो वीर कालः सर्वसमाहरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000639002, "chapter_id": 9639, "verse_number": "७-१०४-३", "content_sanskrit": "पितामहश्च भगवानाह लोकपतिः प्रभुः ।\nसमयस्ते कृतः सौम्य लोकान्सम्परिरक्षितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000639003, "chapter_id": 9639, "verse_number": "७-१०४-४", "content_sanskrit": "सङ्क्षिप्य हि पुरा लोकान्मायया स्वयमेव हि ।\nमहार्णवे शयानो ऽप्सु मां त्वं पूर्वमजीजनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000639004, "chapter_id": 9639, "verse_number": "७-१०४-५", "content_sanskrit": "भोगवन्तं ततो नागमनन्तमुदकेशयम् ।\nमायया जनयित्वा त्वं द्वौ च सत्त्वौ महाबलौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000639005, "chapter_id": 9639, "verse_number": "७-१०४-६", "content_sanskrit": "मधुं च कैटभं चैव ययोरस्थिचयैर्वृता ।\nइयं पर्वतसम्बाधा मेदिनी चाभवन्मही ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000639006, "chapter_id": 9639, "verse_number": "७-१०४-७", "content_sanskrit": "पद्मे दिव्ये ऽर्कसङ्काशे नाभ्यामुत्पाद्य मामपि ।\nप्राजापत्यं त्वया कर्म मयि सर्वं निवेशितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000639007, "chapter_id": 9639, "verse_number": "७-१०४-८", "content_sanskrit": "सो ऽहं सन्न्यस्तभारो हि त्वामुपासे जगत्पतिम् ।\nरक्षां विधत्स्व भूतेषु मम तेजस्करो भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000639008, "chapter_id": 9639, "verse_number": "७-१०४-९", "content_sanskrit": "ततस्त्वमपि दुर्धर्षात्तस्माद्भावात्सनातनात् ।\nरक्षार्थं सर्वभूतानां विष्णुत्वमुपजग्मिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000639009, "chapter_id": 9639, "verse_number": "७-१०४-१०", "content_sanskrit": "अदित्यां वीर्यवान्पुत्रो भ्रातऽणां वीर्यवर्धनः ।\nसमुत्पन्नेषु कृत्येषु तेषां साह्याय कल्पसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000639010, "chapter_id": 9639, "verse_number": "७-१०४-११", "content_sanskrit": "स त्वं वित्रास्यमानासु प्रजासु जगतां वर ।\nरावणस्य वधाकाङ्क्षी मानुषेषु मनो ऽदधाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000639011, "chapter_id": 9639, "verse_number": "७-१०४-१२", "content_sanskrit": "दश वर्षसहस्राणि दश वर्षशतानि च ।\nकृत्वा वासस्य नियतिं स्वयमेवात्मना पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000639012, "chapter_id": 9639, "verse_number": "७-१०४-१३", "content_sanskrit": "स त्वं मनोमयः पुत्रः पूर्णायुर्मानुषेष्विह ।\nकालो ऽयं ते नरश्रेष्ठ समीपमुपवर्तितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000639013, "chapter_id": 9639, "verse_number": "७-१०४-१४", "content_sanskrit": "यदि भूयो महाराज प्रजा इच्छस्युपासितुम् ।\nवस वा वीर भद्रं त एवमाह पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000639014, "chapter_id": 9639, "verse_number": "७-१०४-१५", "content_sanskrit": "अथ वा विजिगीषा ते सुरलोकाय राघव ।\nसनाथा विष्णुना देवा भवन्तु विगतज्वराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000639015, "chapter_id": 9639, "verse_number": "७-१०४-१६", "content_sanskrit": "श्रुत्वा पितामहेनोक्तं वाक्यं कालसमीरितम् ।\nराघवः प्रहसन्वाक्यं सर्वसंहारमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000639016, "chapter_id": 9639, "verse_number": "७-१०४-१७", "content_sanskrit": "श्रुत्वा मे देवदेवस्य वाक्यं परममद्भुतम् ।\nप्रीतिर्हि महती जाता तवागमनसम्भवा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000639017, "chapter_id": 9639, "verse_number": "७-१०४-१८", "content_sanskrit": "त्रयाणामपि लोकानां कार्यार्थं मम सम्भवः ।\nभद्रं ते ऽस्तु गमिष्यामि यत एवाहमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000639018, "chapter_id": 9639, "verse_number": "७-१०४-१९", "content_sanskrit": "हद्गतो ह्यसि सम्प्राप्तो न मे तत्र विचारणा ।\nमया हि सर्वकृत्येषु देवानां वशवर्तिनाम् ।\nस्थातव्यं सर्वसंहार यथा ह्याह पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000639019, "chapter_id": 9639, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे चतुरधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]