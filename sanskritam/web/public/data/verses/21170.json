[{"id": 7001170000, "chapter_id": 21170, "verse_number": "२-३-१८-१", "content_sanskrit": "॥ ब्रह्मोवाच  ।\nतत्र गत्वा स्मरो गर्वी शिवमायाविमोहितः ।\nमोहकस्समधोश्चादौ धर्मं विस्तारयन्स्थितः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001170001, "chapter_id": 21170, "verse_number": "२-३-१८-२", "content_sanskrit": "वसंतस्य च यो धर्म्मः प्रससार स सर्वतः ।\nतपस्थाने महेशस्यौषधिप्रस्थे मुनीश्वर॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001170002, "chapter_id": 21170, "verse_number": "२-३-१८-३", "content_sanskrit": "वनानि च प्रफुल्लानि पादपानां महामुने ।\nआसन्विशेषतस्तत्र तत्प्रभावान्मुनीश्वर॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001170003, "chapter_id": 21170, "verse_number": "२-३-१८-४", "content_sanskrit": "पुष्पाणि सहकाराणामशोकवनिकासु वै ।\nविरेजुस्सुस्मरोद्दीपकाराणि सुरभीण्यपि॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001170004, "chapter_id": 21170, "verse_number": "२-३-१८-५", "content_sanskrit": "कैरवाणि च पुष्पाणि भ्रमराकलितानि च ।\nबभूबुर्मदनावेशकराणि च विशेषतः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001170005, "chapter_id": 21170, "verse_number": "२-३-१८-६", "content_sanskrit": "सकामोद्दीपनकरं कोकिलाकलकूजितम् ।\nआसीदति सुरम्यं हि मनोहरमतिप्रियम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001170006, "chapter_id": 21170, "verse_number": "२-३-१८-७", "content_sanskrit": "भ्रमराणां तथा शब्दा विविधा अभवन्मुने ।\nमनोहराश्च सर्वेषां कामोद्दीपकरा अपि॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001170007, "chapter_id": 21170, "verse_number": "२-३-१८-८", "content_sanskrit": "चंद्रस्य विशदा कांतिर्विकीर्णा हि समंतत ।\nकामिनां कामिनीनां च दूतिका इव साभवत्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001170008, "chapter_id": 21170, "verse_number": "२-३-१८-९", "content_sanskrit": "मानिनां प्रेरणायासीत्तत्काले कालदीपिका ।\nमारुतश्च सुखः साधो ववौ विरहिणोऽप्रियः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001170009, "chapter_id": 21170, "verse_number": "२-३-१८-१०", "content_sanskrit": "एवं वसंतविस्तारो मदनावेशकारकः ।\nवनौकसां तदा तत्र मुनीनां दुस्सहोऽत्यभूत्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001170010, "chapter_id": 21170, "verse_number": "२-३-१८-११", "content_sanskrit": "अचेतसामपि तदा कामासक्तिरभून्मुने ।\nसुचेतासां हि जीवानां सेति किं वर्ण्यते कथा॥१ ॥ ॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001170011, "chapter_id": 21170, "verse_number": "२-३-१८-१२", "content_sanskrit": "एवं चकार स मधुस्स्वप्रभावं सुदुस्सहम् ।\nसर्वेषा चैव जीवानां कामोद्दीपनकारकः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001170012, "chapter_id": 21170, "verse_number": "२-३-१८-१३", "content_sanskrit": "अकालनिमितं तात मधोर्वीक्ष्य हरस्तदा ।\nआश्चर्य्यं परमं मेने स्वलीलात्ततनुः प्रभुः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001170013, "chapter_id": 21170, "verse_number": "२-३-१८-१४", "content_sanskrit": "अथ लीलाकरस्तत्र तपः परमदुष्करम् ।\nतताप स वशीशो हि हरो दुःखहरः प्रभुः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001170014, "chapter_id": 21170, "verse_number": "२-३-१८-१५", "content_sanskrit": "वसंते प्रसृते तत्र कामो रतिसमन्वितः ।\nचूतं बाणं समाकृष्य स्थितस्तद्वामपार्श्वतः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001170015, "chapter_id": 21170, "verse_number": "२-३-१८-१६", "content_sanskrit": "स्वप्रभावं वितस्तार मोहयन्सकलाञ्जनान् ।\nरत्यायुक्तं तदा कामं दृष्ट्वा को वा न मोहितः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001170016, "chapter_id": 21170, "verse_number": "२-३-१८-१७", "content_sanskrit": "एवं प्रवृत्तसुरतौ शृंगारोऽपि गणैस्सह ।\nहावभावयुतस्तत्र प्रविवेश हरांतिकम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001170017, "chapter_id": 21170, "verse_number": "२-३-१८-१८", "content_sanskrit": "मदनः प्रकटस्तत्र न्यवसच्चित्तगो बहिः ।\nन दृष्टवांस्तदा शंभोश्छिद्रं येन प्रविश्यते॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001170018, "chapter_id": 21170, "verse_number": "२-३-१८-१९", "content_sanskrit": "यदा चाप्राप्तविवरस्तस्मिन्योगिवरे स्मरः ।\nमहादेवस्तदा सोऽभून्महाभयविमोहितः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001170019, "chapter_id": 21170, "verse_number": "२-३-१८-२०", "content_sanskrit": "ज्वलज्ज्वालाग्निसंकाशं भालनेत्रसमन्वितम् ।\nध्यानस्थं शंकरं को वा समासादयितुं क्षमः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001170020, "chapter_id": 21170, "verse_number": "२-३-१८-२१", "content_sanskrit": "एतस्मिन्नंतरे तत्र सखीभ्यां संयुता शिवा ।\nजगाम शिवपूजार्थं नीत्वा पुष्पाण्यनेकशः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001170021, "chapter_id": 21170, "verse_number": "२-३-१८-२२", "content_sanskrit": "पृथिव्यां यादृशं लोकैस्सौंदर्यं वर्ण्यते महत् ।\nतत्सर्वमधिकं तस्यां पार्वत्यामस्ति निश्चितम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001170022, "chapter_id": 21170, "verse_number": "२-३-१८-२३", "content_sanskrit": "आर्तवाणि सुपुष्पाणि धृतानि च तया यदा ।\nतत्सौंदर्यं कथं वर्ण्यमपि वर्षशतैरपि॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001170023, "chapter_id": 21170, "verse_number": "२-३-१८-२४", "content_sanskrit": "यदा शिवसमीपे तु गता सा पर्वतात्मजा ।\nतदैव शंकरो ध्यानं त्यक्त्वा क्षणमवस्थितः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001170024, "chapter_id": 21170, "verse_number": "२-३-१८-२५", "content_sanskrit": "तच्छिद्रं प्राप्य मदनः प्रथमं हर्षणेन तु ।\nबाणेन हर्षयामास पार्श्वस्थं चन्द्रशेखरम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001170025, "chapter_id": 21170, "verse_number": "२-३-१८-२६", "content_sanskrit": "शृंगारैश्च तदा भावैस्सहिता पार्वती हरम् ।\nजगाम कामसाहाय्ये मुने सुरभिणा सह॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001170026, "chapter_id": 21170, "verse_number": "२-३-१८-२७", "content_sanskrit": "तदेवाकृष्य तच्चापं रुच्यर्थं शूलधारिणः ।\nद्रुतं पुष्पशरं तस्मै स्मरोऽमुंचत्सुसंयतः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001170027, "chapter_id": 21170, "verse_number": "२-३-१८-२८", "content_sanskrit": "यथा निरंतरं नित्यमागच्छति तथा शिवम् ।\nतन्नमस्कृत्य तत्पूजां कृत्वा तत्पुरतः स्थिता॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001170028, "chapter_id": 21170, "verse_number": "२-३-१८-२९", "content_sanskrit": "सा दृष्टा पार्वती तत्र प्रभुणा गिरिशेन हि ।\nविवृण्वती तदांगानि स्त्रीस्वभावात्सुलज्जया॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001170029, "chapter_id": 21170, "verse_number": "२-३-१८-३०", "content_sanskrit": "सुसंस्मृत्य वरं तस्या विधिदत्तं पुरा प्रभुः ।\nशिवोपि वर्णयामास तदंगानि मुदा मुने॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001170030, "chapter_id": 21170, "verse_number": "२-३-१८-३१", "content_sanskrit": "शिव उवाच ।\nकि मुखं किं शशांकश्च किं नेत्रे चोत्पले च किम् ।\nभ्रुकुट्यौ धनुषी चैते कंदर्पस्य महात्मनः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001170031, "chapter_id": 21170, "verse_number": "२-३-१८-३२", "content_sanskrit": "अधरः किं च बिंबं किं किं नासा शुकचंचुका ।\nकिं स्वरः कोकिलालापः किं मध्यं चाथ वेदिका॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001170032, "chapter_id": 21170, "verse_number": "२-३-१८-३३", "content_sanskrit": "किं गतिर्वर्ण्यते ह्यस्याः किं रूपं वर्ण्यते मुहुः ।\nपुष्पाणि किं च वर्ण्यंते वस्त्राणि च तथा पुनः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001170033, "chapter_id": 21170, "verse_number": "२-३-१८-३४", "content_sanskrit": "लालित्यं चारु यत्सृष्टौ तदेकत्र विनिर्मितम् ।\nसर्वथा रमणीयानि सर्वांगानि न संशयः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001170034, "chapter_id": 21170, "verse_number": "२-३-१८-३५", "content_sanskrit": "अहो धन्यतरा चेयं पार्वत्यद्भुतरूपिणी ।\nएतत्समा न त्रैलोक्ये नारी कापि सुरूपिणी॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001170035, "chapter_id": 21170, "verse_number": "२-३-१८-३६", "content_sanskrit": "सुलावण्यानिधिश्चेयमद्भुतांगानि बिभ्रती ।\nविमोहिनी मुनीनां च महासुखविवर्द्धिनी॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001170036, "chapter_id": 21170, "verse_number": "२-३-१८-३७", "content_sanskrit": "॥ ब्रह्मोवाच  ।\nइत्येवं वर्णयित्वा तु तदंगानि मुहुर्मुहुः ।\nविधिदत्तवराध्यासाद्धरस्तु विरराम ह॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001170037, "chapter_id": 21170, "verse_number": "२-३-१८-३८", "content_sanskrit": "हस्तं वस्त्रांतरे यावदचालयत शंकरः ।\nस्त्रीस्वभावाच्च सा तत्र लज्जिता दूरतो गता॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001170038, "chapter_id": 21170, "verse_number": "२-३-१८-३९", "content_sanskrit": "विवृण्वती निजांगानि पश्यंती च मुहुर्मुहुः ।\nसुवीक्षणैर्महामोदात्सुस्मिताभूच्छिवा मुने॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001170039, "chapter_id": 21170, "verse_number": "२-३-१८-४०", "content_sanskrit": "एवं चेष्टां तदा दृष्ट्वा शंभुर्मोहमुपागतः ।\nउवाच वचनं चैवं महालीलो महेश्वरः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001170040, "chapter_id": 21170, "verse_number": "२-३-१८-४१", "content_sanskrit": "अस्या दर्शनमात्रेण महानंदो भवत्यलम् ।\nयदालिंगनमेनस्याः कुर्य्यां किन्तु ततस्सुखम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001170041, "chapter_id": 21170, "verse_number": "२-३-१८-४२", "content_sanskrit": "क्षणमात्रं विचार्य्येत्थं संपूज्य गिरिजां ततः ।\nप्रबुद्धस्य महायोगी सुविरक्तो जगाविति॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001170042, "chapter_id": 21170, "verse_number": "२-३-१८-४३", "content_sanskrit": "किं जातं चरितं चित्रं किमहं मोहमागतः ।\nकामेन विकृतश्चाद्य भूत्वापि प्रभुरीश्वरः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001170043, "chapter_id": 21170, "verse_number": "२-३-१८-४४", "content_sanskrit": "ईश्वरोहं यदीच्छेयं परांगस्पर्शनं खलु ।\nतर्हि कोऽन्योऽक्षमः क्षुद्रः किं किं नैव करिष्यति॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001170044, "chapter_id": 21170, "verse_number": "२-३-१८-४५", "content_sanskrit": "एवं वैराग्यमासाद्य पर्य्यंकासादनं च तत् ।\nवारयामास सर्वात्मा परेशः किं पतेदिह॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]