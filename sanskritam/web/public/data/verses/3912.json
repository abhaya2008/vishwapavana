[{"id": 2134759, "chapter_id": 3912, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2134760, "chapter_id": 3912, "verse_number": "१", "content_sanskrit": "गन्धर्वैस्तु महाराज भग्ने कर्णे महारथे ।\nसम्प्राद्रवच्चमूः सर्वा धार्तराष्ट्रस्य पश्यतः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2134761, "chapter_id": 3912, "verse_number": "२", "content_sanskrit": "तान् दृष्ट्वा द्रवतः सर्वान् धार्तराष्ट्रान् पराङ्मुखान् ।\nदुर्योधनो महाराजो नासीत् तत्र पराङ्मुखः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2134762, "chapter_id": 3912, "verse_number": "३", "content_sanskrit": "तामापतन्तीं सम्प्रेक्ष्य गन्धर्वाणां महाचमूम् ।\nमहता शरवर्षेण सोऽभ्यवर्षदरिन्दमः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2134763, "chapter_id": 3912, "verse_number": "४", "content_sanskrit": "अचिन्त्य शरवर्षं तु गन्धर्वास्तस्य तं रथम् ।\nदुर्योधनं जिघांसन्तः समन्तात् पर्यवारयन् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2134764, "chapter_id": 3912, "verse_number": "५", "content_sanskrit": "युगमीषां वरूथं च तथैव ध्वजसारथी ।\nअश्वांस्त्रिवेणुं तल्पं च तिलशो व्यधमञ्छरैः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2134765, "chapter_id": 3912, "verse_number": "६", "content_sanskrit": "दुर्योधनं चित्रसेनो विरथं पतितं भुवि ।\nअभिद्रुत्य महाबाहुर्जीवग्राहमथाग्रहीत् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2134766, "chapter_id": 3912, "verse_number": "७", "content_sanskrit": "तस्मिन् गृहीते राजेन्द्र स्थितं दुःशासनं रथे ।\nपर्यगृह्णन्त गन्धर्वाः परिवार्य समन्ततः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2134767, "chapter_id": 3912, "verse_number": "८", "content_sanskrit": "विविंशतिं चित्रसेनमादायान्ये विदुद्रुवुः ।\nविन्दानुविन्दावपरे राजदारांश्च सर्वशः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2134768, "chapter_id": 3912, "verse_number": "९", "content_sanskrit": "सैन्यं तद्धार्तराष्ट्रस्य गन्धर्वैः समभिद्रुतम् ।\nपूर्वं प्रभग्नैः सहिताः पाण्डवानभ्ययुस्तदा \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2134769, "chapter_id": 3912, "verse_number": "१०", "content_sanskrit": "शकटापणवैश्या(वेशा)श्च यानयुग्यं च सर्वशः ।\nशरणं पाण्डवान् जग्मुर्ह्रियमाणे महीपतौ \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2134770, "chapter_id": 3912, "verse_number": "", "content_sanskrit": "दुर्योधनामात्याः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2134771, "chapter_id": 3912, "verse_number": "११", "content_sanskrit": "प्रियदर्शी महाबाहुर्धार्तराष्ट्रो महाबलः ।\nगन्धर्वैर्ह्रियते राजा पार्थास्तमनुधावत \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2134772, "chapter_id": 3912, "verse_number": "१२", "content_sanskrit": "दुःशासनो दुर्विषहो दुर्मुखो दुर्जयस्तथा ।\nबद्ध्वा ह्रियन्ते गन्धर्वै राजदाराश्च सर्वशः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2134773, "chapter_id": 3912, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2134774, "chapter_id": 3912, "verse_number": "समाप्तिः", "content_sanskrit": "इति दुर्योधनामात्याः क्रोशन्तो राजगृद्धिनः ।\nआर्ता दीनास्ततः सर्वे युधिष्ठिरमुपागमन् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2134775, "chapter_id": 3912, "verse_number": "१४", "content_sanskrit": "तांस्तथा व्यथितान् दीनान् भिक्षमाणान् युधिष्ठिरम् ।\nवृद्धान् दुर्योधनामात्यान् भीमसेनोऽभ्यभाषत \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2134776, "chapter_id": 3912, "verse_number": "१५", "content_sanskrit": "अन्यथा वर्तमानानामर्थो जातोऽयमन्यथा ।\nअस्माभिर्यदनुष्ठेयं गन्धर्वैस्तदनुष्ठितम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2134777, "chapter_id": 3912, "verse_number": "१६", "content_sanskrit": "दुर्मन्त्रितमिदं तावद् राज्ञो दुर्द्यूतदेविनः ।\nदीनान् दुर्योधनस्यास्मान् द्रष्टुकामस्य दुर्मतेः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2134778, "chapter_id": 3912, "verse_number": "१७", "content_sanskrit": "द्वेष्टारमन्ये क्लीबस्य पातयन्तीति नः श्रुतम् ।\nइदं कृतं नः प्रत्यक्षं तदेतदतिमानुषम् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2134779, "chapter_id": 3912, "verse_number": "१८", "content_sanskrit": "दिष्ट्या लोके पुमानस्ति कश्चिदस्मत्प्रिये स्थितः ।\nयेनास्माकं हृतो भार आसीनानां सुखावहः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2134780, "chapter_id": 3912, "verse_number": "१९", "content_sanskrit": "शीतवातातपसहांस्तपसा चैव कर्शितान् ।\nसमस्थो विषमस्थान् हि द्रष्टुमिच्छति दुर्मतिः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2134781, "chapter_id": 3912, "verse_number": "२०", "content_sanskrit": "अधर्मचारिणस्तस्य कौरव्यस्य दुरात्मनः ।\nये शीलमनुवर्तन्ते ते पश्यन्ति पराभवम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2134782, "chapter_id": 3912, "verse_number": "२१", "content_sanskrit": "अधर्मो हि कृतस्तेन येनैतदुपलक्षितम् ।\nअनृशंसास्तु कौन्तेयास्तत् प्रत्यक्षं ब्रवीमि वः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2134783, "chapter_id": 3912, "verse_number": "२२", "content_sanskrit": "एवं ब्रुवाणं कौन्तेयं भीमसेनमपस्वरम् ।\nन कालः परुषस्यायमिति राजाभ्यभाषत \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2134784, "chapter_id": 3912, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि घोषयात्रापर्वणि दुर्योधनादिहरणे एकत्रिंशदधिकद्विशततमोऽध्यायः ॥२३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2134785, "chapter_id": 3912, "verse_number": "७", "content_sanskrit": "॥ घोषयात्रापर्वणि सप्तमोऽध्यायः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]