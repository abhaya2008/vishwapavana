[{"id": 2042524, "chapter_id": 1949, "verse_number": "५-१९४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2042525, "chapter_id": 1949, "verse_number": "५-१९४-१", "content_sanskrit": "एतच्छ्रुत्वा तु कौन्तेयः सर्वान्भ्रातॄनुपह्वरे।\nआहूय भरतश्रेष्ठ इदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2042526, "chapter_id": 1949, "verse_number": "५-१९४-२x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2042527, "chapter_id": 1949, "verse_number": "५-१९४-२", "content_sanskrit": "धार्तराष्ट्रस्य सैन्येषु ये चारपुरुषा मम।\nते प्रवृत्तिं प्रयच्छन्ति ममेमां व्युषितां निशाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2042528, "chapter_id": 1949, "verse_number": "५-१९४-३", "content_sanskrit": "दुर्योधनः किलापृच्छदापगेयं महाव्रतम् ।\nकेन कालेन पाण्डूनां हन्याः सैन्यमिति प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2042529, "chapter_id": 1949, "verse_number": "५-१९४-४", "content_sanskrit": "मासेनेति च तेनोक्तो धार्तराष्ट्रः सुदुर्मतिः।\nतावता चापि कालेन द्रोणोपि प्रतिजज्ञिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2042530, "chapter_id": 1949, "verse_number": "५-१९४-५", "content_sanskrit": "गौतमो द्विगुणं कालमुक्तवानिति नः श्रुतम् ।\nद्रौणिस्तु दशरात्रेण प्रतिजज्ञे महास्त्रवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2042531, "chapter_id": 1949, "verse_number": "५-१९४-६", "content_sanskrit": "तथा दिव्यास्त्रवित्कर्णः संपृष्टः कुरुसंसदि ।\nपञ्चभिर्दिवसैर्हन्तुं ससैन्यं प्रतिजज्ञिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2042532, "chapter_id": 1949, "verse_number": "५-१९४-७", "content_sanskrit": "तस्मादहमपीच्छामि श्रोतुमर्जुन ते वचः।\nकालेन कियता शत्रून्क्षपयेरिति फाल्गुन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2042533, "chapter_id": 1949, "verse_number": "५-१९४-८", "content_sanskrit": "एवमुक्तो गुडाकेशः पार्थिवेन धनञ्जयः ।\nवासुदेवं समीक्ष्येदं वचनं प्रत्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2042534, "chapter_id": 1949, "verse_number": "५-१९४-९", "content_sanskrit": "सर्व एते महात्मानः कृतास्त्राश्चित्रयोधिनः ।\nअसंशयं महाराज हन्युरेव न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2042535, "chapter_id": 1949, "verse_number": "५-१९४-१०", "content_sanskrit": "अपैतु ते मनस्तापो यथा सत्यं ब्रवीम्यहम् ।\nहन्यामेकरथेनैव वासुदेवसहायवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2042536, "chapter_id": 1949, "verse_number": "५-१९४-११", "content_sanskrit": "सामरानपि लोकांस्त्रीन्सर्वान्स्थावरजङ्गमान् ।\nभूतं भव्यं भविष्यं च निमेषादिति मे मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2042537, "chapter_id": 1949, "verse_number": "५-१९४-१२", "content_sanskrit": "`यावदिच्छेद्धरिरयं तावदस्ति न चान्यथा।\nयत्तद्धोरं पशुपतिः प्रादादस्त्रं महन्मम।\nकैराते द्वन्द्वयुद्धे तु तदिदं मयि वर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2042538, "chapter_id": 1949, "verse_number": "५-१९४-१३", "content_sanskrit": "यद्युगान्ते पशुपतिः सर्वभूतानि संहरन् ।\nप्रयुङ्क्ते पुरुषव्याघ्र तदिदं मयि वर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2042539, "chapter_id": 1949, "verse_number": "५-१९४-१४", "content_sanskrit": "तन्न जानाति गाङ्गेयो न द्रोणो न च गौतमः ।\nन च द्रोणसुतो राजन्कुत एव तु सूतजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2042540, "chapter_id": 1949, "verse_number": "५-१९४-१५", "content_sanskrit": "न तु युक्तं रणे हन्तुं दिव्यैरस्त्रैः पृथग्जनम् ।\nआर्जवेनैव युद्धेन विजेष्यामो वयं परान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2042541, "chapter_id": 1949, "verse_number": "५-१९४-१६", "content_sanskrit": "तथेमे पुरुषव्याघ्राः सहायास्तव पार्थिव ।\nसर्वे दिव्यास्त्रविद्वांसः सर्वे युद्धाभिकाङ्क्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2042542, "chapter_id": 1949, "verse_number": "५-१९४-१७", "content_sanskrit": "वेदान्तावभृथस्नाताः सर्व एतेऽपराजिताः ।\nनिहन्युः समरे सेनां देवानामपि पाण्डव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2042543, "chapter_id": 1949, "verse_number": "५-१९४-१८", "content_sanskrit": "शिखण्डी युयुधानश्च धृष्टद्युम्नश्च पार्षतः ।\nभीमसेनो यमौ चोभौ युधामन्यूत्तमौजसौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2042544, "chapter_id": 1949, "verse_number": "५-१९४-१९", "content_sanskrit": "विराटद्रुपदौ चोभौ भीष्मद्रोणसमौ युधि।\nशङ्खश्चैव महाबाहुर्हैडिम्बश्च महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2042545, "chapter_id": 1949, "verse_number": "५-१९४-२०", "content_sanskrit": "पुत्रोऽस्याञ्जनपर्वा तु महाबलपराक्रमः ।\nशैनेयश्च महाबाहुः सहायो रणकेविदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2042546, "chapter_id": 1949, "verse_number": "५-१९४-२१", "content_sanskrit": "अभिमन्युश्च बलवान्द्रौपद्याः पञ्च चात्मजाः ।\nस्वयं चापि समर्थोसि त्रेलोक्योत्सादनेपि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2042547, "chapter_id": 1949, "verse_number": "५-१९४-२२", "content_sanskrit": "क्रोधाद्यं पुरुषं पश्येस्तथा शक्रसमद्युते।\nस क्षिप्रं नभवेद्व्यक्तमिति त्वां वेद्मि कौरव ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2042548, "chapter_id": 1949, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि अम्बोपाख्यनपर्वणि चतुर्नवत्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]