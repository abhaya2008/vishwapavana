[{"id": 2196116, "chapter_id": 5181, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2196117, "chapter_id": 5181, "verse_number": "१", "content_sanskrit": "त्वयापगेय नामानि श्रुतानीह जगत्पतेः ।\nपितामहेशाय विभो नामान्याचक्ष्व शम्भवे ।\nबभ्रवे विश्वमायाय महाभाग्यं च तत्त्वतः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2196118, "chapter_id": 5181, "verse_number": "२", "content_sanskrit": "सुरासुरगुरौ देवे शङ्करेऽव्यक्तयोनये\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2196119, "chapter_id": 5181, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2196120, "chapter_id": 5181, "verse_number": "३", "content_sanskrit": "अशक्तोऽहं गुणान् वक्तुं महादेवस्य धीमतः ।\nयो हि सर्वगतो देवो न च सर्वत्र दृश्यते \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2196121, "chapter_id": 5181, "verse_number": "४", "content_sanskrit": "ब्रह्मविष्णुसुरेशानां स्रष्टा यः प्रभुरेव च ।\nब्रह्मादयः पिशाचान्ता यं हि देवा उपासते \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2196122, "chapter_id": 5181, "verse_number": "५", "content_sanskrit": "प्रकृतीनां परत्वेन पुरुषस्य च यः परः ।\nचिन्त्यते यो योगविद्भिर्ऋषिभिस्तत्त्वदर्शिभिः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2196123, "chapter_id": 5181, "verse_number": "६", "content_sanskrit": "अक्षरं परमं प्राहुरसच्च सदसच्च यः ।\nप्रकृतिं पुरुषं चैव क्षोभयित्वा स्वतेजसा \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2196124, "chapter_id": 5181, "verse_number": "७", "content_sanskrit": "ब्रह्माणमसृजत् तस्माद् देवदेवः प्रजापतिः ।\nको हि शक्तो गुणान् वक्तुं देवदेवस्य धीमतः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2196125, "chapter_id": 5181, "verse_number": "८", "content_sanskrit": "गर्भजन्मजरायुक्तो मर्त्यो मृत्युसमन्वितः ।\nको हि शक्तो भवं ज्ञातुं मद्विधः परमेश्वरम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2196126, "chapter_id": 5181, "verse_number": "९", "content_sanskrit": "ऋते नारायणात् पुत्र शङ्खचक्रगदाधरात् ।\nएष विद्वान् यदुश्रेष्ठो विष्णुः परमदुर्जयः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2196127, "chapter_id": 5181, "verse_number": "१०", "content_sanskrit": "दिव्यचक्षुर्महातेजा वीक्ष्यते योगचक्षुषा ।\nरुद्रभक्त्या तु कृष्णेन जगद् व्याप्तं महात्मना\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2196128, "chapter_id": 5181, "verse_number": "११", "content_sanskrit": "तं प्रसाद्य तदा देवं बदर्यां किल भारत ।\nअर्थात् प्रियतरत्वं च सर्वलोकेषु वै तदा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2196129, "chapter_id": 5181, "verse_number": "१२", "content_sanskrit": "प्राप्तवानेव राजेन्द्र सुवर्णाक्षान्महेश्वरात् ।\nपूर्णं वर्षसहस्रं तु तप्तवानेष माधवः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2196130, "chapter_id": 5181, "verse_number": "१३", "content_sanskrit": "प्रसाद्य वरदं देवं चराचरगुरुं शिवम् ।\nयुगे युगे तु कृष्णेन तोषितो वै महेश्वरः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2196131, "chapter_id": 5181, "verse_number": "१४", "content_sanskrit": "भक्त्या परमया राजन् प्रीतश्चैव महात्मनः ।\nऐश्वर्यं यादृशं तस्य जगद्योनेर्महात्मनः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2196132, "chapter_id": 5181, "verse_number": "१५", "content_sanskrit": "तदयं दृष्टवान् साक्षात् पुत्रार्थे हरिरच्युत ।\nयस्मात् परतरं चैव नान्यं पश्यामि भारत\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2196133, "chapter_id": 5181, "verse_number": "१६", "content_sanskrit": "व्याख्यातुं देवदेवस्य शक्तो नामान्यशेषतः ।\nएष शक्तो महाबाहुर्वक्तुं भगवतो गुणान् ।\nविभूतिं चैव कार्त्स्न्येन सत्यां माहेश्वरीं नृप\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2196134, "chapter_id": 5181, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे द्वात्रिंशोऽध्यायः ॥३२॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]