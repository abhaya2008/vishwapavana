[{"id": 2136862, "chapter_id": 3967, "verse_number": "१", "content_sanskrit": "अथ मद्राधिपो राजा नारदेन समागतः ।\nउपविष्टः सभामध्ये कथायोगेन भारत \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2136863, "chapter_id": 3967, "verse_number": "२", "content_sanskrit": "ततोऽभिगम्य तीर्थानि सर्वाण्येवाश्रमांस्तथा ।\nआजगाम पितुर्वेश्म सावित्री सह मन्त्रिभिः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2136864, "chapter_id": 3967, "verse_number": "३", "content_sanskrit": "नारदेन सहासीनं सा दृष्ट्वा पितरं तदा(शुभा)।\nउभयोरेव शिरसा चक्रे पादाभिवादनम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2136865, "chapter_id": 3967, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2136866, "chapter_id": 3967, "verse_number": "४", "content_sanskrit": "क्व गताऽभूत् सुतेयं ते कुतश्चैवागता नृप ।\nकिमर्थं युवतीं भर्त्रे न चैनां सम्प्रयच्छसि \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2136867, "chapter_id": 3967, "verse_number": "", "content_sanskrit": "अश्वपतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2136868, "chapter_id": 3967, "verse_number": "५", "content_sanskrit": "कार्येण खल्वनेनैव प्रेषिताद्यैव चागता ।\nएतस्याः शृणु देवर्षे भर्तारं योऽनया वृतः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2136869, "chapter_id": 3967, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2136870, "chapter_id": 3967, "verse_number": "६", "content_sanskrit": "सा ब्रूहि विस्तरेणेति पित्रा सञ्चोदिता शुभा ।\nतदैव तस्य वचनं प्रतिगृह्येदमब्रवीत् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2136871, "chapter_id": 3967, "verse_number": "", "content_sanskrit": "सावित्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2136872, "chapter_id": 3967, "verse_number": "७", "content_sanskrit": "आसीच्छाल्वेषु धर्मात्मा क्षत्रियः पृथिवीपतिः ।\nद्युमत्सेन इति ख्यातः पश्चाच्चान्धो बभूव ह\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2136873, "chapter_id": 3967, "verse_number": "८", "content_sanskrit": "विनष्टचक्षुषस्तस्य बालपुत्रस्य धीमतः ।\nसामन्तेन हृतं राज्यं छिद्रेऽस्मिन् पूर्ववैरिणा\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2136874, "chapter_id": 3967, "verse_number": "९", "content_sanskrit": "स बालवत्सया सार्धं भार्यया प्रस्थितो वनम् ।\nमहारण्यं गतश्चापि तपस्तेपे महाव्रतः\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2136875, "chapter_id": 3967, "verse_number": "१०", "content_sanskrit": "तस्य पुत्रः पुरे जातः संवृद्धश्च तपोवने ।\nसत्यवाननुरूपो मे भर्तेति मनसा वृतः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2136876, "chapter_id": 3967, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2136877, "chapter_id": 3967, "verse_number": "११", "content_sanskrit": "अहो बत महत् पापं सावित्र्या नृपते कृतम् ।\nअजानन्त्या यदनया गुणवान् सत्यवान् वृतः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2136878, "chapter_id": 3967, "verse_number": "१२", "content_sanskrit": "सत्यं वदत्यस्य पिता सत्यं माता प्रभाषते ।\nतथास्य ब्राह्मणाश्चक्रुर्नामैतत् सत्यवानिति \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2136879, "chapter_id": 3967, "verse_number": "१३", "content_sanskrit": "बालस्याश्वाः प्रियाश्चास्य करोत्यश्वांश्च मृन्मयान् ।\nचित्रेऽपि विलिखत्यश्वांश्चित्राश्व इति चोच्यते \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2136880, "chapter_id": 3967, "verse_number": "", "content_sanskrit": "राजा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2136881, "chapter_id": 3967, "verse_number": "१४", "content_sanskrit": "अपीदानीं स तेजस्वी बुद्धिमान् वा नृपात्मजः ।\nक्षमावानपि वा शूरः सत्यवान् पितृवत्सलः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2136882, "chapter_id": 3967, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2136883, "chapter_id": 3967, "verse_number": "१५", "content_sanskrit": "विवस्वानिव तेजस्वी बृहस्पतिसमो मतौ ।\nमहेन्द्र इव वीरश्च वसुधेव समन्वितः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2136884, "chapter_id": 3967, "verse_number": "", "content_sanskrit": "अश्वपतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2136885, "chapter_id": 3967, "verse_number": "१६", "content_sanskrit": "अपि राजात्मजो दाता ब्रह्मण्यश्चापि सत्यवान् ।\nरूपवानप्युदारो वाऽप्यथवा प्रियदर्शनः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2136886, "chapter_id": 3967, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2136887, "chapter_id": 3967, "verse_number": "१७", "content_sanskrit": "साङ्कृते रन्तिदेवस्य स्वशक्त्या दानतः समः।\nबह्मण्यः सत्यवादी च शिबिरौशीनरो यथा \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2136888, "chapter_id": 3967, "verse_number": "१८", "content_sanskrit": "ययातिरिव चोदारः सोऽभ(म)वत् प्रियदर्शनः ।\nरूपेणान्यतमोऽश्विभ्यां द्युमत्सेनसुतो बली \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2136889, "chapter_id": 3967, "verse_number": "१९", "content_sanskrit": "स वदान्यः स तेजस्वी स धीमान् स क्षमान्वितः ।\nस दान्तः स मृदुः शूरः स सत्यः संयतेन्द्रियः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2136890, "chapter_id": 3967, "verse_number": "२०", "content_sanskrit": "स मैत्रः सोऽनसूयश्च स ह्रीमान् द्युतिमांश्च सः ।\nनित्यशश्चार्जवं तस्मिन् स्थितिस्तस्यैव च ध्रुवा ।\nसङ्क्षेपतस्तपोवृद्धैः शीलवृद्धैश्च कथ्यते \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2136891, "chapter_id": 3967, "verse_number": "", "content_sanskrit": "अश्वपतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2136892, "chapter_id": 3967, "verse_number": "२१", "content_sanskrit": "गुणैरुपेतं सर्वैस्तं भगवन् प्रब्रवीषि मे ।\nदोषानप्यस्य मे ब्रूहि यदि सन्तीह केचन \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2136893, "chapter_id": 3967, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2136894, "chapter_id": 3967, "verse_number": "२२", "content_sanskrit": "एको दोषोऽस्ति नान्योऽस्य सोऽद्यप्रभृति सत्यवान् ।\nसंवत्सरेण क्षीणायुर्देहन्यासं करिष्यति \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2136895, "chapter_id": 3967, "verse_number": "", "content_sanskrit": "एक एवास्य दोषो हि गुणानाक्रम्य तिष्ठति ।\nस च दोषः प्रयत्नेन न शक्यमतिवर्तितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2136896, "chapter_id": 3967, "verse_number": "", "content_sanskrit": "राजा/अश्वपतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2136897, "chapter_id": 3967, "verse_number": "२३", "content_sanskrit": "एहि सावित्रि गच्छस्व अन्यं वरय शोभने ।\nतस्य दोषो महानेको गुणानाक्रम्य च स्थितः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2136898, "chapter_id": 3967, "verse_number": "२४", "content_sanskrit": "यथा मे भगवानाह नारदो देवसत्कृतः ।\nसंवत्सरेण सोऽल्पायुर्देहन्यासं करिष्यति \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2136899, "chapter_id": 3967, "verse_number": "", "content_sanskrit": "सावित्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2136900, "chapter_id": 3967, "verse_number": "२५", "content_sanskrit": "सकृदम्भो निपतति सकृत् कन्या प्रदीयते ।\nसकृदाह ददानीति त्रीण्येतानि सकृत्सकृत् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2136901, "chapter_id": 3967, "verse_number": "२६", "content_sanskrit": "दीर्घायुरथवाल्पायुः सगुणो निर्गुणोऽपि वा ।\nसकृद् वृतो मया भर्ता न द्वितीयं वृणोम्यहम् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2136902, "chapter_id": 3967, "verse_number": "२७", "content_sanskrit": "मनसा निश्चयं कृत्वा ततो वाचाऽभिधीयते ।\nक्रियते कर्मणा पश्चात् प्रमाणं मे मनस्ततः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2136903, "chapter_id": 3967, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2136904, "chapter_id": 3967, "verse_number": "२८", "content_sanskrit": "स्थिरा बुद्धिर्नरश्रेष्ठ सावित्र्या दुहितुस्तव ।\nनैषा वारयितुं शक्या धर्मादस्मात् कथञ्चन \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2136905, "chapter_id": 3967, "verse_number": "२९", "content_sanskrit": "विलम्बो नात्र कर्तव्यो निश्चिते कर्मणि ध्रुवम् ।\nनान्यस्मिन् पुरुषे सन्ति ये सत्यवति वै गुणाः ।\nप्रदानमेव तस्मान्मे रोचते दुहितुस्तव \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2136906, "chapter_id": 3967, "verse_number": "", "content_sanskrit": "राजा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2136907, "chapter_id": 3967, "verse_number": "३०", "content_sanskrit": "अविचाल्यं तदुक्तं यत् तथ्यं भगवता वचः।\nकरिष्याम्येतदेवं च गुरुर्हि भगवान् मम \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2136908, "chapter_id": 3967, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2136909, "chapter_id": 3967, "verse_number": "३१", "content_sanskrit": "अविघ्नमस्तु सावित्र्याः प्रदाने दुहितुस्तव ।\nसाधयिष्याम्यहं तावत् सर्वेषां भद्रमस्तु वः \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2136910, "chapter_id": 3967, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2136911, "chapter_id": 3967, "verse_number": "३२", "content_sanskrit": "एवमुक्त्वा समुत्पत्य नारदस्त्रिदिवं गतः।\nराजापि दुहितुः सज्जं वैवाहिकमकारयत् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2136912, "chapter_id": 3967, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि पतिव्रतामाहात्म्यपर्वणि सावित्र्युपाख्याने त्र्यशीत्यधिकद्विशततमोऽध्यायः॥२८३॥\nसावित्र्युपाख्यानपर्वणि द्वितीयोऽध्यायः ॥२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]