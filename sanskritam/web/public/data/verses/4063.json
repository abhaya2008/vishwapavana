[{"id": 2142167, "chapter_id": 4063, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2142168, "chapter_id": 4063, "verse_number": "१", "content_sanskrit": "प्रदाय वस्त्राणि किरीटमाली\nविराटगेहे मुदितः सखीभ्यः ।\nकृत्वा महत् कर्म तदाऽऽजिमध्ये\nदिदृक्षया सोऽभिजगाम पार्थम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2142169, "chapter_id": 4063, "verse_number": "२", "content_sanskrit": "सम्प्रेक्षमाणस्त्वथ धर्मराजं\nपप्रच्छ पार्थोऽथ स भीमसेनम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2142170, "chapter_id": 4063, "verse_number": "३", "content_sanskrit": "किं धर्मराजो हि यथा पुरा मां\nमुखं प्रतिच्छाद्य न चाह किञ्चित्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2142171, "chapter_id": 4063, "verse_number": "४", "content_sanskrit": "तमेवमुक्त्वा प्रतिशङ्कमानं\nदृष्ट्वाऽर्जुनं भीमसेनं च राजा ।\nतत्राब्रवीत् तावभिवीक्ष्य राजा\nयुधिष्टिरस्तत् परिमृज्य रक्तम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2142172, "chapter_id": 4063, "verse_number": "५", "content_sanskrit": "दुरात्मना त्वय्यभिपूज्यमाने\nविराटराजेन हतोऽस्मि पार्थ ।\nतस्मात् प्रहाराद् रुधिरस्य बिन्दून्\nप्रास्यन्न चेमे पृथिवीं स्पृशेयुः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2142173, "chapter_id": 4063, "verse_number": "समाप्तिः", "content_sanskrit": "इति प्रतिच्छाद्य मुखं ततोऽहं\nमन्युं नियच्छन्नुपतिष्ट आसम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2142174, "chapter_id": 4063, "verse_number": "७", "content_sanskrit": "क्रुद्धे तु वीरे त्वयि चाप्रतीते\nराजा विराटो न लभेत शर्म ।\nअजानता तेन च शौर्यमग्र्यं\nछन्नस्य ते पार्थ बलं च वीर्यम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2142175, "chapter_id": 4063, "verse_number": "८", "content_sanskrit": "इदं विराटेन मयि प्रयुक्तं\nत्वां वीक्षमाणो न गतोऽस्मि हर्षम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2142176, "chapter_id": 4063, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2142177, "chapter_id": 4063, "verse_number": "९", "content_sanskrit": "तेनाप्रमेयेन महाबलेन\nतस्मिंस्तथोक्ते शममास्थितेन ।\nतं भीमसेनो बलवानमर्षी\nधनञ्जयं क्रुद्ध उवाच वाक्यम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2142178, "chapter_id": 4063, "verse_number": "१०", "content_sanskrit": "न पार्थ नित्यं क्षमकालमाह\nबृहस्पतिर्ज्ञानवतां वरिष्ठः ।\nक्षमी हि सर्वैः परिभूयते हि\nयथा भुजङ्गो विषवीर्यहीनः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2142179, "chapter_id": 4063, "verse_number": "", "content_sanskrit": "विराटमद्यैव निहत्य शीघ्रं सपुत्रपौत्रं सकुलं ससैन्यम् ।\nयोक्ष्यामहे धर्मसुतं तु राज्ये अद्यैव शीघ्रं त्वरतैष मात्स्यः\t ॥११", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2142180, "chapter_id": 4063, "verse_number": "१२", "content_sanskrit": "अनेन पाञ्चालसुताऽथ कृष्णा\nउपेक्षिता कीचकेनानुयाता ।\nतस्मादयं नार्हति राजशब्दं\nराजा भव त्वं नृप पार्थवीर्यात्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2142181, "chapter_id": 4063, "verse_number": "१३", "content_sanskrit": "राजा कुरूणां च युधिष्ठिरोऽयं\nमत्स्येषु राजा भवतु प्रतीतः ।\nतं मत्स्यदेहं शतधा भिनद्मि\nकुम्भं घनेनेव यथाऽम्बुपूर्णम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2142182, "chapter_id": 4063, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2142183, "chapter_id": 4063, "verse_number": "१४", "content_sanskrit": "भवतः क्षमया चैव सर्वे दोषाश्च नोऽभवन्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2142184, "chapter_id": 4063, "verse_number": "१५", "content_sanskrit": "तस्मादेनं च हत्वा वै सबलं सहबान्धवम् ।\nपश्चाच्चैव कुरून् सर्वान् हनिष्यामो न संशयः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2142185, "chapter_id": 4063, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2142186, "chapter_id": 4063, "verse_number": "१६", "content_sanskrit": "भीमसेनश्च ये चान्ये तथैवेति तमब्रुवन्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2142187, "chapter_id": 4063, "verse_number": "१७", "content_sanskrit": "तमब्रवीद् धर्मसुतो महात्मा\nक्षमी वदान्यः कुपितं च भीमम् ।\nन प्रत्युपस्थास्यति चेत् सदारः\nप्रसादने सम्यगथास्तु वध्यः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2142188, "chapter_id": 4063, "verse_number": "१८", "content_sanskrit": "न हन्तव्यो दुरात्माऽयं विराटश्चापि तेऽर्जुन ।\nश्वः प्रभाते प्रवेक्ष्यामः सभां सिंहासनेष्विह\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2142189, "chapter_id": 4063, "verse_number": "१९", "content_sanskrit": "राजवेषेण संयुक्तान् यदि तत्र न मंस्यते ।\nपश्चाद् वध्यामहे सर्वान् विराटेन सबान्धवान्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2142190, "chapter_id": 4063, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2142191, "chapter_id": 4063, "verse_number": "समाप्तिः", "content_sanskrit": "इतिकर्तव्यतां सर्वे मन्त्रयित्वाऽथ पाण्डवाः ।\nन्यवसंश्चैव तां रात्रिं पाण्डवा धर्मवत्सलाः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2142192, "chapter_id": 4063, "verse_number": "२१", "content_sanskrit": "पुत्रेण सह मात्स्यस्तु सम्प्रहृष्टो नराधिपः ।\nतां रात्रिमवसद् धीमान् समाश्वस्तेन चेतसा\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2142193, "chapter_id": 4063, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि एकसप्ततितमोऽध्यायः ॥७१॥\nगोग्रहणपर्वणि चतुश्चत्वारिंशोऽध्यायः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2142194, "chapter_id": 4063, "verse_number": "", "content_sanskrit": "॥ समाप्तं गोग्रहणपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2142195, "chapter_id": 4063, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]