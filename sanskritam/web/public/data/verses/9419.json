[{"id": 40023025, "chapter_id": 9419, "verse_number": "1", "content_sanskrit": "कस्यचित्त्वथ कालस्य युधाजित्केकयो नृपः । स्वगुरुं प्रेषयामास राघवाय महात्मने । गार्ग्यमङ्गिरसः पुत्रं ब्रह्मर्षिममितप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40023026, "chapter_id": 9419, "verse_number": "2", "content_sanskrit": "दश चाश्वसहस्राणि प्रीतिदानमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40023027, "chapter_id": 9419, "verse_number": "3", "content_sanskrit": "कम्बलानि च रत्नानि चित्रवस्त्रमथोत्तमम् । रामाय प्रददौ राजा शुभान्याभरणानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40023028, "chapter_id": 9419, "verse_number": "4", "content_sanskrit": "श्रुत्वा तु राघवो धीमान्महर्षिं गार्ग्यमागतम् । मातुलस्याश्वपतिनः प्रहितं तन्महाधनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40023029, "chapter_id": 9419, "verse_number": "5", "content_sanskrit": "प्रत्युद्गम्य च काकुत्स्थः क्रोशमात्रं सहानुजः । गार्ग्यं सम्पूजयामास यथा शक्रो बृहस्पतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40023030, "chapter_id": 9419, "verse_number": "6", "content_sanskrit": "तथा सम्पूज्य तमृषिं तद्धनं प्रतिगृह्य च । पृष्ट्वा प्रतिपदं सर्वं कुशलं मातुलस्य च । उपविष्टं महाभागं रामः प्रष्टुं प्रचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40023031, "chapter_id": 9419, "verse_number": "7", "content_sanskrit": "किमाह मातुलो वाक्यं यदर्थं भगवानिह । प्राप्तो वाक्यविदां श्रेष्ठः साक्षादिव बृहस्पतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40023032, "chapter_id": 9419, "verse_number": "8", "content_sanskrit": "रामस्य भाषितं श्रुत्वा महर्षिः कार्यविस्तरम् । वक्तुमद्भुतसङ्काशं राघवायोपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40023033, "chapter_id": 9419, "verse_number": "9", "content_sanskrit": "मातुलस्ते महाबाहो वाक्यमाह नरर्षभः । युधाजित्प्रीतिसंयुक्तं श्रूयतां यदि रोचते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40023034, "chapter_id": 9419, "verse_number": "10", "content_sanskrit": "अयं गन्धर्वविषयः फलमूलोपशोभितः । सिन्धोरुभयतः पार्श्वे देशः परमशोभनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40023035, "chapter_id": 9419, "verse_number": "11", "content_sanskrit": "तं च रक्षन्ति गन्धर्वाः सायुधा युद्धकोविदाः । शैलूषस्य सुता वीर त्रिकोट्यो वै महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40023036, "chapter_id": 9419, "verse_number": "12", "content_sanskrit": "तान्विनिर्जित्य काकुत्स्थ गन्धर्वनगरं शुभम् । निवेशय महाबोहो स्वे पुरे सुसमाहिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40023037, "chapter_id": 9419, "verse_number": "13", "content_sanskrit": "अन्यस्य न गतिस्तत्र देशः परमशोभनः । रोचतां ते महाबाहो नाहं त्वामहितं वदे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40023038, "chapter_id": 9419, "verse_number": "14", "content_sanskrit": "तच्छ्रुत्वा राघवः प्रीतो महर्षेर्मातुलस्य च । उवाच बाढमित्येव भरतं चान्ववैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40023039, "chapter_id": 9419, "verse_number": "15", "content_sanskrit": "सो ऽब्रवीद्राघवः प्रीतः साञ्जलिप्रग्रहो द्विजम् । इमौ कुमारौ तं देशं ब्रह्मर्षे विचरिष्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40023040, "chapter_id": 9419, "verse_number": "16", "content_sanskrit": "भरतस्यात्मजौ वीरौ तक्षः पुष्कल एव च । मातुलेन सुगुप्तौ तु धर्मेण सुसमाहितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40023041, "chapter_id": 9419, "verse_number": "17", "content_sanskrit": "भरतं चाग्रतः कृत्वा कुमारौ सबलानुगौ । निहत्य गन्धर्वसुतान्द्वे पुरे विभजिष्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40023042, "chapter_id": 9419, "verse_number": "18", "content_sanskrit": "निवेश्य ते पुरवरे आत्मजौ सन्निवेश्य च । आगमिष्यति मे भूयः सकाशमतिधार्मिकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40023043, "chapter_id": 9419, "verse_number": "19", "content_sanskrit": "ब्रह्मर्षिमेवमुक्त्वा तु भरतं सबलानुगम् । आज्ञापयामास तदा कुमारौ चाभ्यषेचयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40023044, "chapter_id": 9419, "verse_number": "20", "content_sanskrit": "नक्षत्रेण च सौम्येन पुरस्कृत्याङ्गिरस्सुतम् । भरतः सह सैन्येन कुमाराभ्यां विनिर्ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40023045, "chapter_id": 9419, "verse_number": "21", "content_sanskrit": "सा सेना शक्रयुक्तेव नगरान्निर्ययावथ । राघवानुगता दूरं दुराधर्षा सुरैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40023046, "chapter_id": 9419, "verse_number": "22", "content_sanskrit": "मांसादानि च सत्त्वानि रक्षांसि सुमहान्ति च । अनुजग्मुर्हि भरतं रुधिरस्य पिपासया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40023047, "chapter_id": 9419, "verse_number": "23", "content_sanskrit": "भूतग्रामाश्च बहवो मांसभक्षाः सुदारुणाः । गन्धर्वपुत्रमांसानि भोक्तुकामाः सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40023048, "chapter_id": 9419, "verse_number": "24", "content_sanskrit": "सिंहव्याघ्रवराहाणां खेचराणां च पक्षिणाम् । बहूनि वै सहस्राणि सेनाया ययुरग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40023049, "chapter_id": 9419, "verse_number": "25", "content_sanskrit": "अध्यर्धमासमुषिता पथि सेना निरामया । हृष्टपुष्टजनाकीर्णा केकयं समुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]