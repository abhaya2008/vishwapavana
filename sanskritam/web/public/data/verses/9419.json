[{"id": 5000419000, "chapter_id": 9419, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे द्वादशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000419001, "chapter_id": 9419, "verse_number": "६-१२-१", "content_sanskrit": "स तां परिषदं कृत्स्नां समीक्ष्य समितिंजयः।\nप्रचोदयामास तदा प्रहस्तं वाहिनीपतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000419002, "chapter_id": 9419, "verse_number": "६-१२-२", "content_sanskrit": "सेनापते यथा ते स्युः कृतविद्याश्चतुर्विधाः।\nयोधा नगररक्षायां तथा व्यादेष्टुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000419003, "chapter_id": 9419, "verse_number": "६-१२-३", "content_sanskrit": "स प्रहस्तः प्रणीतात्मा चिकीर्षन् राजशासनम्।\nविनिक्षिपद् बलं सर्वं बहिरन्तश्च मन्दिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000419004, "chapter_id": 9419, "verse_number": "६-१२-४", "content_sanskrit": "ततो विनिक्षिप्य बलं सर्वं नगरगुप्तये।\nप्रहस्तः प्रमुखे राज्ञो निषसाद जगाद च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000419005, "chapter_id": 9419, "verse_number": "६-१२-५", "content_sanskrit": "विहितं बहिरन्तश्च बलं बलवतस्तव।\nकुरुष्वाविमनाः क्षिप्रं यदभिप्रेतमस्ति ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000419006, "chapter_id": 9419, "verse_number": "६-१२-६", "content_sanskrit": "प्रहस्तस्य वचः श्रुत्वा राजा राज्यहितैषिणः।\nसुखेप्सुः सुहृदां मध्ये व्याजहार स रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000419007, "chapter_id": 9419, "verse_number": "६-१२-७", "content_sanskrit": "प्रियाप्रिये सुखे दुःखे लाभालाभे हिताहिते।\nधर्मकामार्थकृच्छ्रेषु यूयमर्हथ वेदितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000419008, "chapter_id": 9419, "verse_number": "६-१२-८", "content_sanskrit": "सर्वकृत्यानि युष्माभिः समारब्धानि सर्वदा।\nमन्त्रकर्मनियुक्तानि न जातु विफलानि मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000419009, "chapter_id": 9419, "verse_number": "६-१२-९", "content_sanskrit": "ससोमग्रहनक्षत्रैर्मरुद्भिरिव वासवः।\nभवद्भिरहमत्यर्थं वृतः श्रियमवाप्नुयाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000419010, "chapter_id": 9419, "verse_number": "६-१२-१०", "content_sanskrit": "अहं तु खलु सर्वान् वः समर्थयितुमुद्यतः।\nकुम्भकर्णस्य तु स्वप्नान् नेममर्थमचोदयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000419011, "chapter_id": 9419, "verse_number": "६-१२-११", "content_sanskrit": "अयं हि सुप्तः षण्मासान् कुम्भकर्णो महाबलः।\nसर्वशस्त्रभृतां मुख्यः स इदानीं समुत्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000419012, "chapter_id": 9419, "verse_number": "६-१२-१२", "content_sanskrit": "इयं च दण्डकारण्याद् रामस्य महिषी प्रिया।\nरक्षोभिश्चरितोद्देशादानीता जनकात्मजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000419013, "chapter_id": 9419, "verse_number": "६-१२-१३", "content_sanskrit": "सा मे न शय्यामारोढुमिच्छत्यलसगामिनी।\nत्रिषु लोकेषु चान्या मे न सीतासदृशी तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000419014, "chapter_id": 9419, "verse_number": "६-१२-१४", "content_sanskrit": "तनुमध्या पृथुश्रोणी शरदिन्दुनिभानना।\nहेमबिम्बनिभा सौम्या मायेव मयनिर्मिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000419015, "chapter_id": 9419, "verse_number": "६-१२-१५", "content_sanskrit": "सुलोहिततलौ श्लक्ष्णौ चरणौ सुप्रतिष्ठितौ।\nदृष्ट्वा ताम्रनखौ तस्या दीप्यते मे शरीरजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000419016, "chapter_id": 9419, "verse_number": "६-१२-१६", "content_sanskrit": "हुताग्नेरर्चिसंकाशामेनां सौरीमिव प्रभाम्।\nउन्नसं विमलं वल्गु वदनं चारुलोचनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000419017, "chapter_id": 9419, "verse_number": "६-१२-१७", "content_sanskrit": "पश्यंस्तदवशस्तस्याः कामस्य वशमेयिवान्।\nक्रोधहर्षसमानेन दुर्वर्णकरणेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000419018, "chapter_id": 9419, "verse_number": "६-१२-१८", "content_sanskrit": "शोकसंतापनित्येन कामेन कलुषीकृतः।\nसा तु संवत्सरं कालं मामयाचत भामिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000419019, "chapter_id": 9419, "verse_number": "६-१२-१९", "content_sanskrit": "प्रतीक्षमाणा भर्तारं राममायतलोचना।\nतन्मया चारुनेत्रायाः प्रतिज्ञातं वचः शुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000419020, "chapter_id": 9419, "verse_number": "६-१२-२०", "content_sanskrit": "श्रान्तोऽहं सततं कामाद् यातो हय इवाध्वनि।\nकथं सागरमक्षोभ्यं तरिष्यन्ति वनौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000419021, "chapter_id": 9419, "verse_number": "६-१२-२१", "content_sanskrit": "बहुसत्त्वझषाकीर्णं तौ वा दशरथात्मजौ।\nअथवा कपिनैकेन कृतं नः कदनं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000419022, "chapter_id": 9419, "verse_number": "६-१२-२२", "content_sanskrit": "दुर्ज्ञेयाः कार्यगतयो ब्रूत यस्य यथामति।\nमानुषान्नो भयं नास्ति तथापि तु विमृश्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000419023, "chapter_id": 9419, "verse_number": "६-१२-२३", "content_sanskrit": "तदा देवासुरे युद्धे युष्माभिः सहितोऽजयम्।\nते मे भवन्तश्च तथा सुग्रीवप्रमुखान् हरीन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000419024, "chapter_id": 9419, "verse_number": "६-१२-२४", "content_sanskrit": "परे पारे समुद्रस्य पुरस्कृत्य नृपात्मजौ।\nसीतायाः पदवीं प्राप्य सम्प्राप्तौ वरुणालयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000419025, "chapter_id": 9419, "verse_number": "६-१२-२५", "content_sanskrit": "अदेया च यथा सीता वध्यौ दशरथात्मजौ।\nभवद्भिर्मन्त्र्यतां मन्त्रः सुनीतं चाभिधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000419026, "chapter_id": 9419, "verse_number": "६-१२-२६", "content_sanskrit": "नहि शक्तिं प्रपश्यामि जगत्यन्यस्य कस्यचित्।\nसागरं वानरैस्तीर्त्वा निश्चयेन जयो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000419027, "chapter_id": 9419, "verse_number": "६-१२-२७", "content_sanskrit": "तस्य कामपरीतस्य निशम्य परिदेवितम्।\nकुम्भकर्णः प्रचुक्रोध वचनं चेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000419028, "chapter_id": 9419, "verse_number": "६-१२-२८", "content_sanskrit": "यदा तु रामस्य सलक्ष्मणस्य\nप्रसह्य सीता खलु सा इहाहृता।\nसकृत् समीक्ष्यैव सुनिश्चितं तदा\nभजेत चित्तं यमुनेव यामुनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000419029, "chapter_id": 9419, "verse_number": "६-१२-२९", "content_sanskrit": "सर्वमेतन्महाराज कृतमप्रतिमं तव।\nविधीयेत सहास्माभिरादावेवास्य कर्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000419030, "chapter_id": 9419, "verse_number": "६-१२-३०", "content_sanskrit": "न्यायेन राजकार्याणि यः करोति दशानन।\nन स संतप्यते पश्चान्निश्चितार्थमतिर्नृपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000419031, "chapter_id": 9419, "verse_number": "६-१२-३१", "content_sanskrit": "अनुपायेन कर्माणि विपरीतानि यानि च।\nक्रियमाणानि दुष्यन्ति हवींष्यप्रयतेष्विव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000419032, "chapter_id": 9419, "verse_number": "६-१२-३२", "content_sanskrit": "यः पश्चात् पूर्वकार्याणि कर्माण्यभिचिकीर्षति।\nपूर्वं चापरकार्याणि स न वेद नयानयौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000419033, "chapter_id": 9419, "verse_number": "६-१२-३३", "content_sanskrit": "चपलस्य तु कृत्येषु प्रसमीक्ष्याधिकं बलम्।\nछिद्रमन्ये प्रपद्यन्ते क्रौञ्चस्य खमिव द्विजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000419034, "chapter_id": 9419, "verse_number": "६-१२-३४", "content_sanskrit": "त्वयेदं महदारब्धं कार्यमप्रतिचिन्तितम्।\nदिष्ट्या त्वां नावधीद् रामो विषमिश्रमिवामिषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000419035, "chapter_id": 9419, "verse_number": "६-१२-३५", "content_sanskrit": "तस्मात् त्वया समारब्धं कर्म ह्यप्रतिमं परैः।\nअहं समीकरिष्यामि हत्वा शत्रूंस्तवानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000419036, "chapter_id": 9419, "verse_number": "६-१२-३६", "content_sanskrit": "अहमुत्सादयिष्यामि शत्रूंस्तव निशाचर।\nयदि शक्रविवस्वन्तौ यदि पावकमारुतौ।\nतावहं योधयिष्यामि कुबेरवरुणावपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000419037, "chapter_id": 9419, "verse_number": "६-१२-३७", "content_sanskrit": "गिरिमात्रशरीरस्य महापरिघयोधिनः।\nनर्दतस्तीक्ष्णदंष्ट्रस्य बिभीयाद् वै पुरंदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000419038, "chapter_id": 9419, "verse_number": "६-१२-३८", "content_sanskrit": "पुनर्मां स द्वितीयेन शरेण निहनिष्यति।\nततोऽहं तस्य पास्यामि रुधिरं काममाश्वस ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000419039, "chapter_id": 9419, "verse_number": "६-१२-३९", "content_sanskrit": "वधेन वै दाशरथेः सुखावहं\nजयं तवाहर्तुमहं यतिष्ये।\nहत्वा च रामं सह लक्ष्मणेन\nखादामि सर्वान् हरियूथमुख्यान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000419040, "chapter_id": 9419, "verse_number": "६-१२-४०", "content_sanskrit": "रमस्व कामं पिब चाग्र्यवारुणीं\nकुरुष्व कार्याणि हितानि विज्वरः।\nमया तु रामे गमिते यमक्षयं\nचिराय सीता वशगा भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000419041, "chapter_id": 9419, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे द्वादशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]