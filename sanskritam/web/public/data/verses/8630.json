[{"id": 900008390, "chapter_id": 8630, "verse_number": "11.1", "content_sanskrit": "अत्र त्रीणि दर्शनानि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008391, "chapter_id": 8630, "verse_number": "11.2", "content_sanskrit": "न च पूर्वपक्षेऽग्निसूक्तस्याग्निपरत्वाच्छान्दोग्यस्य", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008392, "chapter_id": 8630, "verse_number": "11.3", "content_sanskrit": "यद्वा मतद्वयेऽपि वाक्यद्वयमप्युदाहरणम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008393, "chapter_id": 8630, "verse_number": "11.4", "content_sanskrit": "तृतीयेऽपि ‘‘कम्पनात्, शब्दादेव प्रमितः’’", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900008394, "chapter_id": 8630, "verse_number": "11.5", "content_sanskrit": "अत्र ज्योतिः किमग्निः किं वा विष्णुरिति चिन्ता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900008395, "chapter_id": 8630, "verse_number": "11.6", "content_sanskrit": "नन्वेवं सावकाशलिङ्गस्य सावकाशश्रुत्यैव ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900008396, "chapter_id": 8630, "verse_number": "11.7", "content_sanskrit": "एवं च तत्रेत्थं पूर्वपक्षः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900008397, "chapter_id": 8630, "verse_number": "11.8", "content_sanskrit": "यद्वा सुधानुसारेणात्रापि ‘‘सावकाशश्रुतिप्रकरणयोः’’ ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900008398, "chapter_id": 8630, "verse_number": "11.9", "content_sanskrit": "सिद्धान्तस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900008399, "chapter_id": 8630, "verse_number": "11.10", "content_sanskrit": "एवं सूक्तान्तरेष्वपि द्रष्टव्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900008400, "chapter_id": 8630, "verse_number": "11.11", "content_sanskrit": "न चैवमत्रत्यसिद्धान्तेनैवान्तरधिकरणादिपूर्वपक्षाणां..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]