[{"id": 7005156000, "chapter_id": 25156, "verse_number": "७-१-३३९-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेन्महादेवि कूपं त्रैलोक्यविश्रुतम् ।\nदेविकायास्तटे रम्ये हुंकारेणैव पूर्यते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005156001, "chapter_id": 25156, "verse_number": "७-१-३३९-२", "content_sanskrit": "ततोऽधस्तात्पुनर्याति सलिलं तत्र भामिनि ।\nतण्डीनाम पुरा प्रोक्तो देविकातटमास्थितः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005156002, "chapter_id": 25156, "verse_number": "७-१-३३९-३", "content_sanskrit": "तपस्तेपे महादेवि शिवभक्तिपरायणः ।\nतस्यैवं तप्यमानस्य तस्मिन्देशे वरानने ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005156003, "chapter_id": 25156, "verse_number": "७-१-३३९-४", "content_sanskrit": "आजगाम मृगो वृद्धस्तं देशमन्ध दृक्प्रिये ।\nस पपात महागर्ते अगाधे जलवर्जिते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005156004, "chapter_id": 25156, "verse_number": "७-१-३३९-५", "content_sanskrit": "तं दृष्ट्वा कृपयाविष्टः स मुनिर्मौनमास्थितः ।\nहुंकारं कुरुते तत्र भूयोभूयश्च भामिनि ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005156005, "chapter_id": 25156, "verse_number": "७-१-३३९-६", "content_sanskrit": "अथ हुंकारशब्देन तस्य गर्तः प्रपूरितः ।\nततो मृगो विनिष्क्रांतः कृच्छ्रेण सलिलात्प्रिये ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005156006, "chapter_id": 25156, "verse_number": "७-१-३३९-७", "content_sanskrit": "मानुषं रूपमाश्रित्य तमृषिं पर्यपृच्छत ।\nविस्मयं परमं गत्वा काम्यदं कर्मणः फलम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005156007, "chapter_id": 25156, "verse_number": "७-१-३३९-८", "content_sanskrit": "मृगत्वे पतितश्चात्र नरो भूत्वा विनिर्गतः ।\nसोऽब्रवीत्तस्य माहात्म्यं सलिलस्य द्विजोत्तमः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005156008, "chapter_id": 25156, "verse_number": "७-१-३३९-९", "content_sanskrit": "अतोऽहं नरतां प्राप्तो नान्यदस्तीह कारणम् ।\nततस्तत्सलिलं भूयः प्रविष्टं धरणीतले ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005156009, "chapter_id": 25156, "verse_number": "७-१-३३९-१०", "content_sanskrit": "ततो हुंकृतवान्भूयः स ऋषिः कौतुकान्वितः ।\nआपूरितः पुनः कूपः सलिलेन पुरा यथा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005156010, "chapter_id": 25156, "verse_number": "७-१-३३९-११", "content_sanskrit": "ततः स कृतवान्स्नानं तथा च पितृतर्पणम् ।\nमत्वा तीर्थवरं तत्र ततः प्राप्तः परां गतिम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005156011, "chapter_id": 25156, "verse_number": "७-१-३३९-१२", "content_sanskrit": "अद्यापि हुंकृते तस्मिन्सलिलौघः प्रवर्तते ।\nतत्र गत्वा नरो भक्त्या अपि पापरतोऽपि यः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005156012, "chapter_id": 25156, "verse_number": "७-१-३३९-१३", "content_sanskrit": "न मानुष्यं पुनर्जन्म प्राप्नोति जगतीतले ।\nतत्र स्नात्वा शुचिर्भूत्वा यः श्राद्धं कुरुते नरः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005156013, "chapter_id": 25156, "verse_number": "७-१-३३९-१४", "content_sanskrit": "मुच्यते सर्वपापेभ्यः पितृलोके महीयते ।\nकुलानि तारयेत्सप्त अतीताऽनागतानि च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]