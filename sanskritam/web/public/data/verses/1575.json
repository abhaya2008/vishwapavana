[{"id": 2026855, "chapter_id": 1575, "verse_number": "३-२१३-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2026856, "chapter_id": 1575, "verse_number": "३-२१३-१", "content_sanskrit": "धर्मव्याधस्तु निपुणं पुनरेव युधिष्ठिर।\nविप्रर्षभमुवाचेदं सर्वधर्मभृतांवर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2026857, "chapter_id": 1575, "verse_number": "३-२१३-२", "content_sanskrit": "श्रुतिप्रमाणो धर्मोऽयमिति वृद्धानुशासनम्।\nसूक्ष्मा गतिर्हि धर्मस् बहुशाखा ह्यनन्तिका ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2026858, "chapter_id": 1575, "verse_number": "३-२१३-३", "content_sanskrit": "प्राणान्तिके विवाहे च वक्तव्यमनृतं भवेत्।\nअनृतेन भवेत्सत्यं सत्येनैवानृतं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2026859, "chapter_id": 1575, "verse_number": "३-२१३-४", "content_sanskrit": "यद्भूतहितमत्यन्तं तत्सत्यमिति धारणा।\nविपर्ययकृतोऽधर्मः पश्य धर्मस्य सूक्ष्मताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2026860, "chapter_id": 1575, "verse_number": "३-२१३-५", "content_sanskrit": "यत्करोत्यशुभं कर्म शुभं वा यदि सत्तम।\nअवश्यं तत्समाप्नोति पुरुषो नात्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2026861, "chapter_id": 1575, "verse_number": "३-२१३-६", "content_sanskrit": "विषमां च दशां प्राप्तो देवान्गर्हति वै भृशम्।\nआत्मृनः कर्मदोषेण न विजानात्यपण्डितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2026862, "chapter_id": 1575, "verse_number": "३-२१३-७", "content_sanskrit": "मूढो नैकृतिकश्चापि चपलश्च द्विजोत्तम।\n`न शुभं कर्म बध्नाति पुरुषं पाषनिश्चयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2026863, "chapter_id": 1575, "verse_number": "३-२१३-८", "content_sanskrit": "सुखदुःखविपर्यासो यदा समुपपद्यते।\nनैनं प्रज्ञा सुनीतं वा त्रायते नैव पौरुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2026864, "chapter_id": 1575, "verse_number": "३-२१३-९", "content_sanskrit": "यो यमिच्छेद्यथा कामं तं तं कामं स आप्नुयात्।\nयदि स्यादपराधीनं पौरुषस् क्रियाफलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2026865, "chapter_id": 1575, "verse_number": "३-२१३-१०", "content_sanskrit": "संयताश्चापि दक्षाश्च मतिमन्तश्च मानवाः।\nदृश्यन्ते निष्फलाः सन्तः प्रहीणाः सर्वकर्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2026866, "chapter_id": 1575, "verse_number": "३-२१३-११", "content_sanskrit": "भूतानामपरः कश्चिद्धिंसायां सततोत्थितः।\nवञ्चनायां च लोकस्य स सुखेनैव युज्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2026867, "chapter_id": 1575, "verse_number": "३-२१३-१२", "content_sanskrit": "अचेष्टमपि चासीनं श्रीः कंचिदुपतिष्ठति।\nकश्चित्कर्माणि कुर्वन्हि न प्राप्यमधिगच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2026868, "chapter_id": 1575, "verse_number": "३-२१३-१३", "content_sanskrit": "देवानिष्ट्वा तपस्तप्त्वा कृपणैः पुत्रगृध्नुभिः।\nदशमासधृता गर्भा जायन्ते कुलपांसनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2026869, "chapter_id": 1575, "verse_number": "३-२१३-१४", "content_sanskrit": "अपरे धनधान्यैश्च भोगैश्च पितृसंचितैः।\nविपुलैरभिजायन्ते लब्धास्तैरेव मङ्गलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2026870, "chapter_id": 1575, "verse_number": "३-२१३-१५", "content_sanskrit": "`न देहजा मनुष्याणां व्याधयो द्विजसत्तम।\nकर्मजा हि मनुष्याणां रोगा नास्त्यत्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2026871, "chapter_id": 1575, "verse_number": "३-२१३-१६", "content_sanskrit": "आधिभिश्चैव बाध्यन्ते व्यालैः क्षुद्रमृगा इव।\nव्याधयो विनिवार्यन्ते मृगा व्याधैरिव द्विज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2026872, "chapter_id": 1575, "verse_number": "३-२१३-१७", "content_sanskrit": "येषामस्ति च भोक्तव्यं ग्रहणीरोगपीडिताः।\nन शक्नुवन्ति ते भोक्तुं चेष्टितं पूर्वकर्मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2026873, "chapter_id": 1575, "verse_number": "३-२१३-१८", "content_sanskrit": "अपरे बाहुबलिनः क्लिश्यन्ति बहवो जनाः।\nदुःखेन चाधिगच्छनति भोजनं द्विजसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2026874, "chapter_id": 1575, "verse_number": "३-२१३-१९", "content_sanskrit": "इति लोकमनाक्रन्दं देहशङ्कापरिप्लुतम्।\nस्रोतसाऽसकृदाक्षिप्तं ह्रियमाणं बलीयसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2026875, "chapter_id": 1575, "verse_number": "३-२१३-२०", "content_sanskrit": "न म्रियेयुर्न जीर्यैयुः सर्वे स्युः सर्वकामिकाः।\nनाप्रियं प्रतिपश्येयुर्विधिश्च यदि नो भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2026876, "chapter_id": 1575, "verse_number": "३-२१३-२१", "content_sanskrit": "उपर्युपरि लोकस्य सर्वो गन्तुं समीहते।\nयतते च यथाथक्ति न च तद्वर्तते तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2026877, "chapter_id": 1575, "verse_number": "३-२१३-२२", "content_sanskrit": "बहवः संप्रदृश्यन्ते तुल्यनक्षत्रमङ्गलाः।\nमहत्तु फलवैषम्यं दृश्यते कर्मसिद्धिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2026878, "chapter_id": 1575, "verse_number": "३-२१३-२३", "content_sanskrit": "न केचिदीशते ब्रह्मन्स्वयंग्राह्यस्य सत्तम।\nकर्मणां प्राकृतानां वै इह सिद्धिः प्रदृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2026879, "chapter_id": 1575, "verse_number": "३-२१३-२४", "content_sanskrit": "तथा श्रुतिरियंब्रह्मञ्जीवः किल सनातनः।\nशरीरमध्रुवं लोके सर्वेषां प्राणिनामिह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2026880, "chapter_id": 1575, "verse_number": "३-२१३-२५", "content_sanskrit": "वध्यमाने शरीरे तु देहनाशो भवत्युत।\nजीवः संक्रमतेऽन्यत्रकर्मबनधनिबन्धनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2026881, "chapter_id": 1575, "verse_number": "३-२१३-२६x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2026882, "chapter_id": 1575, "verse_number": "३-२१३-२६", "content_sanskrit": "कथं धर्मविदांश्रेष्ठ जीवो भवति शाश्वतः।\nएतदिच्छाम्यहं ज्ञातुं तत्त्वेन वदतांवर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2026883, "chapter_id": 1575, "verse_number": "३-२१३-२७x", "content_sanskrit": "व्याध उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2026884, "chapter_id": 1575, "verse_number": "३-२१३-२७", "content_sanskrit": "न जीवनाशोस्ति हि देहभेदे\nमिथ्यैतदाहुर्म्रियतीति मूढाः।\nजीवस्तु देहान्तरितः प्रयाति\nदशार्धतैवास् शरीरभेदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2026885, "chapter_id": 1575, "verse_number": "३-२१३-२८", "content_sanskrit": "अन्यो हि नाश्नाति कृतं हि कर्म\nमनुष्यलोके मनुजस् कश्चित्।\nयत्तेन किंचिद्धि कृतंहि कर्म\nतदश्नुते नास्ति कृतस्य नाशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2026886, "chapter_id": 1575, "verse_number": "३-२१३-२९", "content_sanskrit": "सुपुण्यशीला हि भवन्ति पुण्या\nनराधमाः पापकृतो भवन्ति।\nनरोऽनुयातस्त्विह कर्मभिः स्वै-\nस्ततः समुत्पद्यति भावितस्तैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2026887, "chapter_id": 1575, "verse_number": "३-२१३-३०x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2026888, "chapter_id": 1575, "verse_number": "३-२१३-३०", "content_sanskrit": "कथं संभवते योनौ कथं वा पुण्यपापयोः।\nजातीः पुण्या ह्यपुण्याश् कथं गच्छति सत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2026889, "chapter_id": 1575, "verse_number": "३-२१३-३१x", "content_sanskrit": "व्याध उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2026890, "chapter_id": 1575, "verse_number": "३-२१३-३१", "content_sanskrit": "गर्भाधानसमायुक्तं कर्मेदं संप्रदृश्यते।\nसमासेन तु ते क्षिप्रं प्रवक्ष्यामि द्विजोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2026891, "chapter_id": 1575, "verse_number": "३-२१३-३२", "content_sanskrit": "यथा संभृतसंभारः पुनरेव प्रजायते।\nशुभकृच्छुभयोनीषु पापकृत्पापयोनिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2026892, "chapter_id": 1575, "verse_number": "३-२१३-३३", "content_sanskrit": "शुभैः प्रयोगैर्देवत्वंव्यामिश्रैर्मानुषो भवेत्।\nमोहनीयैर्वियोनीषु त्वधोगामी च किल्बिषैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2026893, "chapter_id": 1575, "verse_number": "३-२१३-३४", "content_sanskrit": "जातिमृत्युजरादुःखैः सततं समभिद्रुतः।\nसंसारे पच्यमानश्च दोषैरात्मकृतैर्नरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2026894, "chapter_id": 1575, "verse_number": "३-२१३-३५", "content_sanskrit": "तिर्यग्योनिसहस्राणि गत्वा नरकमेव च।\nजीवाः संपरिवर्तन्ते कर्मबन्धनिबन्धनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2026895, "chapter_id": 1575, "verse_number": "३-२१३-३६", "content_sanskrit": "जन्तुस्तु कर्मभिस्तैस्तैः स्वकृतैः प्रेत्य दुःखितः।\nतद्दुःखप्रतिघातार्थमपुण्यां योनिमाप्नुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2026896, "chapter_id": 1575, "verse_number": "३-२१३-३७", "content_sanskrit": "ततः कर्म समादत्ते पुनरन्यन्नवं बहु।\nपच्यते तु पुनस्तेन भुक्त्वाऽपथ्यमिवातुरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2026897, "chapter_id": 1575, "verse_number": "३-२१३-३८", "content_sanskrit": "अजस्रमेव दुःखार्तोऽदुःखितः सुखिसंज्ञितः।\nततो निवृत्तबन्धत्वात्कर्मणामुदयादपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2026898, "chapter_id": 1575, "verse_number": "३-२१३-३९", "content_sanskrit": "परिक्रामति संसारे चक्रवद्बहुवेदनः।\nस चेन्निवृत्तबन्धस्तु विशुद्धश्चापि कर्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2026899, "chapter_id": 1575, "verse_number": "३-२१३-४०", "content_sanskrit": "तपोयोगसमारम्भं कुरुते द्विजसत्तम।\nकर्मभिर्बहुभिश्चापि लोकानश्नाति कर्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2026900, "chapter_id": 1575, "verse_number": "३-२१३-४१", "content_sanskrit": "[स चेन्निवृत्तबन्धस्तु विशुद्धश्चापि कर्मभिः।]\nप्राप्नोति सुकृताँल्लोकान्यत्रगत्वा न शोचति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2026901, "chapter_id": 1575, "verse_number": "३-२१३-४२", "content_sanskrit": "पापं कुर्वनपुण्यवृत्तः पुण्यस्यान्तं न गच्छति।\n`पुण्यं कुर्वन्पुण्यवृत्तः पुण्यस्यान्तं न गच्छति।\nतस्मात्पुण्यं यतेत्कर्तुं वर्जयीत च पापकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2026902, "chapter_id": 1575, "verse_number": "३-२१३-४३", "content_sanskrit": "अनसूयुः कृतज्ञश्च कल्याणान्येव सेवते।\nसुखानि धर्ममर्थं च स्वर्गं च लभते नरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2026903, "chapter_id": 1575, "verse_number": "३-२१३-४४", "content_sanskrit": "संस्कृतस्य च दान्तस् नियतस्य यतात्मनः।\nप्राज्ञास्यानन्तरा वृत्तिरिहि लोके परत्र च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2026904, "chapter_id": 1575, "verse_number": "३-२१३-४५", "content_sanskrit": "सतां धऱ्मेण वर्तेत क्रियां शिष्टवदाचरेत्।\nअसंक्लेशेन लोकस्य वृत्तिं लिप्सेत वै द्विजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2026905, "chapter_id": 1575, "verse_number": "३-२१३-४६", "content_sanskrit": "सन्ति ह्यागमविज्ञानाः शिष्टाः शास्त्रे विचक्षणाः।\nस्वधर्मेण क्रिया लोके कुर्वाणास्ते ह्यसंकराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2026906, "chapter_id": 1575, "verse_number": "३-२१३-४७", "content_sanskrit": "प्राज्ञो धर्मेण रमते धर्मं चैवोपजीवति।\nतस्माद्धर्मादवाप्तेन धनन द्विजसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2026907, "chapter_id": 1575, "verse_number": "३-२१३-४८", "content_sanskrit": "तस्यैव सिंचते मूलं गुणान्पश्यति यत्र वै।\nधर्मात्मा भवति ह्येवं चित्तं चास्य प्रसीदति।\nस मित्रजनसंतुष्ट इह प्रेत्य च नन्दति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2026908, "chapter_id": 1575, "verse_number": "३-२१३-४९", "content_sanskrit": "शब्दं स्पर्शं तथा रूपं गन्धानिष्टांस्च सत्तम।\nप्रभुत्वं लभते चापि धर्मस्यैतत्फलं विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2026909, "chapter_id": 1575, "verse_number": "३-२१३-५०", "content_sanskrit": "धरमस्य च पलं लब्ध्वा न तुष्यति महाद्विज।\nअतुष्यमाणो निर्वेदमादत्ते ज्ञानचक्षुषा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2026910, "chapter_id": 1575, "verse_number": "३-२१३-५१", "content_sanskrit": "प्रज्ञाचक्षुर्नर इह दोषं नैवानुरुध्यते।\nविरज्ये यथाकामं न च धर्मं विमुञ्चति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2026911, "chapter_id": 1575, "verse_number": "३-२१३-५२", "content_sanskrit": "फलत्यागे च यतते दृष्ट्वा लोकं क्रियात्मकम्।\nततो मोक्षे प्रयतते नानुपायादुपायतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2026912, "chapter_id": 1575, "verse_number": "३-२१३-५३", "content_sanskrit": "एवं निर्वेदमादत्ते पापं कर्म जहाति च।\nधार्मिकश्चापि भवति मोक्षं च लभते परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2026913, "chapter_id": 1575, "verse_number": "३-२१३-५४", "content_sanskrit": "तपो निःश्रेयसं जन्तोस्तस्य मूलं शमो दमः।\nतेन सर्वानवाप्नोति कामान्यान्मनसेच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2026914, "chapter_id": 1575, "verse_number": "३-२१३-५५", "content_sanskrit": "इन्द्रियाणां निरोधेन सत्येन च दमेन च।\nब्रह्मणः पदमाप्नोति यत्परं द्विजसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2026915, "chapter_id": 1575, "verse_number": "३-२१३-५६x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2026916, "chapter_id": 1575, "verse_number": "३-२१३-५६", "content_sanskrit": "इन्द्रियाणीति यान्याहुः कानि तानि यतव्रत।\nनिग्रहश्च कथं कार्यो निग्रहस्य च किं फलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2026917, "chapter_id": 1575, "verse_number": "३-२१३-५७", "content_sanskrit": "कथं च फलमाप्नोति तेषां धर्मभृतांवर।\nएतदिच्छामि तत्त्वेन धर्मं ज्ञातुं सुधार्मिक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2026918, "chapter_id": 1575, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमस्यापर्वणि त्रयोदशाधिकद्विशततमोऽध्याः ॥ २१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]