[{"id": 2164260, "chapter_id": 4540, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2164261, "chapter_id": 4540, "verse_number": "१", "content_sanskrit": "तथा परुषितं दृष्ट्वा सूतपुत्रेण मातुलम् ।\nखड्गमुद्यम्य वेगेन द्रौणिरभ्यपतद् द्रुतम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2164262, "chapter_id": 4540, "verse_number": "", "content_sanskrit": "अश्वत्थामा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2164263, "chapter_id": 4540, "verse_number": "२", "content_sanskrit": "कर्ण पश्य सुदुर्बुद्धे तिष्ठेदानीं नराधम ।\nएष तेऽद्य शिरः कायादुद्धरामि सुदुर्मते\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2164264, "chapter_id": 4540, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2164265, "chapter_id": 4540, "verse_number": "३", "content_sanskrit": "तमुत्पतन्तं वेगेन राजा दुर्योधनः स्वयम् ।\nन्यवारयन् महाराज कृपश्च द्विपदां वरः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2164266, "chapter_id": 4540, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2164267, "chapter_id": 4540, "verse_number": "४", "content_sanskrit": "शूरोऽयं समरश्लाघी दुर्मतिश्च द्विजाधमः ।\nआसादयतु मद्वीर्यं मुञ्चेमं कुरुसत्तम\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2164268, "chapter_id": 4540, "verse_number": "", "content_sanskrit": "अश्वत्थामा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2164269, "chapter_id": 4540, "verse_number": "५", "content_sanskrit": "तवैतत् क्षम्यतेऽस्माभिः सूतात्मज सुदुर्मते ।\nदर्पमुत्सिक्तमेतत् ते फल्गुनो नाशयिष्यति\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2164270, "chapter_id": 4540, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2164271, "chapter_id": 4540, "verse_number": "६", "content_sanskrit": "अश्वत्थामन् प्रसीदस्व क्षन्तुमर्हसि मानद ।\nकोपः खलु न कर्तव्यः सूतपुत्रे कथञ्चन\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2164272, "chapter_id": 4540, "verse_number": "७", "content_sanskrit": "त्वयि कर्णे कृपे द्रोणे मद्रराजेऽथ सौबले ।\nमहत्कार्यं समायत्तं प्रसीद द्विजसत्तम\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2164273, "chapter_id": 4540, "verse_number": "८", "content_sanskrit": "एते ह्यभिमुखाः सर्वे राधेयेन युयुत्सवः ।\nआयान्ति पाण्डवा ब्रह्मन्नाह्वयन्तः समन्ततः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2164274, "chapter_id": 4540, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2164275, "chapter_id": 4540, "verse_number": "९", "content_sanskrit": "कर्णोऽपि रथिनां श्रेष्ठश्चापमुद्यम्य वीर्यवान् ।\nकौरवाग्र्यैः परिवृतः शक्रो देवगणैरिव ।\nपर्यतिष्ठत तेजस्वी स्वबाहुबलमाश्रितः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2164276, "chapter_id": 4540, "verse_number": "१०", "content_sanskrit": "ततः प्रववृते युद्धं कर्णस्य सह पाण्डवैः ।\nसंरब्धस्य महाराज सिंहनादविनादितम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2164277, "chapter_id": 4540, "verse_number": "११", "content_sanskrit": "ततस्ते पाण्डवा राजन् पाञ्चालाश्च यशस्विनः ।\nदृष्ट्वा कर्णं महाबाहुमुच्चैः शब्दमथानदन्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2164278, "chapter_id": 4540, "verse_number": "१२", "content_sanskrit": "अयं कर्णः कुतः कर्णस्तिष्ठ कर्ण महारणे ।\nयुद्ध्यस्व सहितोऽस्माभिर्दुरात्मन् पुरुषाधम\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2164279, "chapter_id": 4540, "verse_number": "१३", "content_sanskrit": "अन्ये तु दृष्ट्वा राधेयं क्रोधरक्तेक्षणाब्रुवन् ।\nहन्यतामयमुत्सिक्तः सूतपुत्रोऽल्पचेतनः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2164280, "chapter_id": 4540, "verse_number": "१४", "content_sanskrit": "सर्वैः पार्थिवशार्दूलैर्नानेनार्थोऽस्ति जीवता ।\nअत्यन्तवैरी पार्थानां सततं पापपूरुषः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2164281, "chapter_id": 4540, "verse_number": "१५", "content_sanskrit": "एष मूलं ह्यनर्थानां दुर्योधनमते स्थितः ।\nहतैनमिति जल्पन्तः क्षत्रियाः समुपाद्रवन्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2164282, "chapter_id": 4540, "verse_number": "१६", "content_sanskrit": "महता शरवर्षेण छादयन्तो महारथाः ।\nवधार्थं सूतपुत्रस्य पाण्डवेयेन चोदिताः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2164283, "chapter_id": 4540, "verse_number": "१७", "content_sanskrit": "तांस्तु सर्वांस्तथा दृष्ट्वा धावमानान् महारथान् ।\nन विव्यथे सूतपुत्रो न च त्रासमगच्छत\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2164284, "chapter_id": 4540, "verse_number": "१८", "content_sanskrit": "दृष्ट्वा नगरकल्पं तमुद्धूतं सैन्यसागरम् ।\nपिप्रीषुस्तव पुत्राणां सङ्ग्रामेष्वपराजितः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2164285, "chapter_id": 4540, "verse_number": "१९", "content_sanskrit": "सायकौघेन बलवान् क्षिप्रकारी महाबलः ।\nवारयामास तत् सैन्यं समन्ताद् भरतर्षभ\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2164286, "chapter_id": 4540, "verse_number": "२०", "content_sanskrit": "ततस्तु शरवर्षेण पार्थिवास्तमवारयन् ।\nधनूंषि ते विधुन्वानाः शतशोऽथ सहस्रशः ।\nअयोधयन्त राधेयं शक्रं दैत्यगणा इव\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2164287, "chapter_id": 4540, "verse_number": "२१", "content_sanskrit": "शरवर्षं तु तत् कर्णः पार्थिवैः समुदीरितम् ।\nशरवर्षेण महता समन्ताद् व्यकिरत् प्रभो\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2164288, "chapter_id": 4540, "verse_number": "२२", "content_sanskrit": "तद्युद्धमभवत् तेषां कृतप्रतिकृतैषिणाम् ।\nयथा देवासुरे युद्धे शक्रस्य सह दानवैः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2164289, "chapter_id": 4540, "verse_number": "२३", "content_sanskrit": "तत्राद्भुतमपश्याम सूतपुत्रस्य लाघवम् ।\nयदेनं समरे यत्ता नाप्नुवन्त परे युधि\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2164290, "chapter_id": 4540, "verse_number": "", "content_sanskrit": "निवार्य च शरौघांस्तान् पार्थिवानां महारथः ।\nयुगेष्वीषासु छत्रेषु ध्वजेषु च हयेषु च ।\nआत्मनामाङ्कितान् बाणान् राधेयः प्राहिणोच्छितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2164291, "chapter_id": 4540, "verse_number": "२५", "content_sanskrit": "ततस्ते व्याकुलीभूता राजानः कर्णपीडिताः ।\nबभ्रमुस्तत्र तत्रैव गावः शीतार्दिता इव\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2164292, "chapter_id": 4540, "verse_number": "२६", "content_sanskrit": "हयानां वध्यमानानां गजानां रथिनां तथा ।\nतत्र तत्राभ्यवेक्षामः सङ्घान् कर्णेन पातितान्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2164293, "chapter_id": 4540, "verse_number": "२७", "content_sanskrit": "शिरोभिः पतितै राजन् बाहुभिश्च समन्ततः ।\nआस्तीर्णा वसुधा सर्वा शूराणामनिवर्तिनाम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2164294, "chapter_id": 4540, "verse_number": "२८", "content_sanskrit": "हतैश्च हन्यमानैश्च निष्टनद्भिश्च सर्वशः ।\nबभूवायोधनं रौद्रं वैवस्वतपुरोपमम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2164295, "chapter_id": 4540, "verse_number": "२९", "content_sanskrit": "ततो दुर्योधनो राजा दृष्ट्वा कर्णस्य विक्रमम् ।\nअश्वत्थामानमासाद्य तदा वाक्यमुवाच ह\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2164296, "chapter_id": 4540, "verse_number": "३०", "content_sanskrit": "युद्ध्यतेऽसौ रणे कर्णो दंसितः सर्वपार्थिवैः ।\nपश्यैतां द्रवतीं सेनां कर्णसायकपीडिताम् ।\nकार्त्तिकेयेन विध्वस्तामासुरीं पृतनामिव\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2164297, "chapter_id": 4540, "verse_number": "३१", "content_sanskrit": "दृष्ट्वैतां निर्जितां सेनां रणे कर्णेन धीमता ।\nअभियात्येष बीभत्सुः सूतपुत्रजिघांसया\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2164298, "chapter_id": 4540, "verse_number": "३२", "content_sanskrit": "तद्यथा पश्यमानानां सूतपुत्रं महारथम् ।\nन हन्यात् पाण्डवः सङ्खे तथा नीतिर्विधीयताम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2164299, "chapter_id": 4540, "verse_number": "३३", "content_sanskrit": "ततो द्रौणिः कृपः शल्यो हार्दिक्यश्च महारथः ।\nप्रत्युद्ययुस्तदा पार्थं सूतपुत्रपरीप्सया\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2164300, "chapter_id": 4540, "verse_number": "३४", "content_sanskrit": "आयान्तं दृश्य कौन्तेयं वृत्रं देवचमूमिव ।\nप्रत्युद्ययौ तदा कर्णो यथा शक्रः प्रतापवान्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2164301, "chapter_id": 4540, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2164302, "chapter_id": 4540, "verse_number": "३५", "content_sanskrit": "संरब्धं फल्गुनं दृष्ट्वा कालान्तकयमोपमम् ।\nकर्णो वैकर्तनः सूत प्रत्यपद्यत् किमुत्तरम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2164303, "chapter_id": 4540, "verse_number": "३६", "content_sanskrit": "स ह्यस्पर्धत पार्थेन नित्यमेव महारथः ।\nआशंसते च बीभत्सुं युद्धे जेतुं सुदारुणे\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2164304, "chapter_id": 4540, "verse_number": "३७", "content_sanskrit": "स तु तं सहसा प्राप्तं नित्यमत्यन्तवैरिणम् ।\nकर्णो वैकर्तनः सूत किमुत्तरमपद्यत\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2164305, "chapter_id": 4540, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2164306, "chapter_id": 4540, "verse_number": "३८", "content_sanskrit": "आयान्तं पाण्डवं दृष्ट्वा गजः प्रतिगजं यथा ।\nअसम्भ्रान्ततरः कर्णः प्रत्युदीयाद् धनञ्जयम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2164307, "chapter_id": 4540, "verse_number": "३९", "content_sanskrit": "तमापतन्तं वेगेन वैकर्तनमजिह्मगैः ।\nवारयामास तेजस्वी पाण्डवः शत्रुतापनः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2164308, "chapter_id": 4540, "verse_number": "४०", "content_sanskrit": "तं कर्णः शरजालेन छादयामास मारिष ।\nविव्याध च सुसङ्क्रुद्धः शरैस्त्रिभिरजिह्मगैः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2164309, "chapter_id": 4540, "verse_number": "४१", "content_sanskrit": "तस्य तल्लाघवं पार्थो नामृष्यत महाबलः ।\nतस्मै बाणान् शिलाधौतान् प्रसन्नाग्रानजिह्मगान्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2164310, "chapter_id": 4540, "verse_number": "४२", "content_sanskrit": "प्राहिणोत् सूतपुत्राय त्रिंशतं शत्रुतापनः ।\nविव्याध चैनं संरब्धो बाणेनैकेन वीर्यवान्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2164311, "chapter_id": 4540, "verse_number": "४३", "content_sanskrit": "सव्ये भुजाग्रे बलवान् नाराचेन हसन्निव ।\nतस्य विद्धस्य वेगेन कराच्चापं पपात ह\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2164312, "chapter_id": 4540, "verse_number": "४४", "content_sanskrit": "पुनरादाय तच्चापं निमेषार्धान्महाबलः ।\nछादयामास बाणौघैः फल्गुनं कृतहस्तवत्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2164313, "chapter_id": 4540, "verse_number": "४५", "content_sanskrit": "शरवृष्टिं तु तां मुक्तां सूतपुत्रेण भारत ।\nव्यधमच्छरवर्षेण स्मयन्निव धनञ्जयः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2164314, "chapter_id": 4540, "verse_number": "४६", "content_sanskrit": "तौ परस्परमासाद्य शरवर्षेण पार्थिव ।\nछादयेतां महेष्वासौ कृतप्रतिकृतैषिणौ\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2164315, "chapter_id": 4540, "verse_number": "४७", "content_sanskrit": "तदद्भुतमभूद् युद्धं कर्णपाण्डवयोर्मृधे ।\nक्रुद्धयोर्वासिताहेतोर्वन्ययोर्गजयोरिव\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2164316, "chapter_id": 4540, "verse_number": "४८", "content_sanskrit": "ततः पार्थो महेष्वासो दृष्ट्वा कर्णस्य विक्रमम् ।\nमुष्टिदेशे धनुस्तस्य चिच्छेद त्वरयाऽन्वितः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2164317, "chapter_id": 4540, "verse_number": "४९", "content_sanskrit": "अश्वांश्च चतुरो भल्लैरनयद् यमसादनम् ।\nसारथेश्च शिरः कायादहरच्छत्रुतापनः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2164318, "chapter_id": 4540, "verse_number": "५०", "content_sanskrit": "अथैनं छिन्नधन्वानं हताश्वं हतसारथिम् ।\nविव्याध सायकैः पार्थश्चतुर्भिः पाण्डुनन्दनः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2164319, "chapter_id": 4540, "verse_number": "५१", "content_sanskrit": "हताश्वात् तु रथात् तूर्णमवप्लुत्य नरर्षभः ।\nआरुरोह रथं तूर्णं कृपस्य शरपीडितः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2164320, "chapter_id": 4540, "verse_number": "५२", "content_sanskrit": "राधेयं निर्जितं दृष्ट्वा तावका भरतर्षभ ।\nधनञ्जयशरैर्नुन्नाः प्राद्रवन्त दिशो दश\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2164321, "chapter_id": 4540, "verse_number": "५३", "content_sanskrit": "द्रवतस्तान् समालोक्य राजा दुर्योधनो नृप ।\nनिवर्तयामास तदा वाक्यं चेदमुवाच ह\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2164322, "chapter_id": 4540, "verse_number": "५४", "content_sanskrit": "अलं द्रुतेन वः शूरास्तिष्ठध्वं क्षत्रियर्षभाः ।\nएष पार्थवधायाहं स्वयं गच्छामि संयुगे ।\nअहं पार्थान् हनिष्यामि सपाञ्चालान् ससोमकान्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2164323, "chapter_id": 4540, "verse_number": "५५", "content_sanskrit": "अद्य मे युद्ध्यमानस्य सह गाण्डीवधन्वना ।\nद्रक्ष्यन्ति विक्रमं पार्थाः कालस्येव युगक्षये\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2164324, "chapter_id": 4540, "verse_number": "५६", "content_sanskrit": "अद्य मद्बाणजालानि विमुक्तानि सहस्रशः ।\nद्रक्ष्यन्ति समरे योधाः शलभानामिवायतीः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2164325, "chapter_id": 4540, "verse_number": "५७", "content_sanskrit": "अद्य बाणमयं वर्षं सृजतो मम धन्विनः ।\nजीमूतस्येव घर्मान्ते द्रक्ष्यन्ति युधि सैनिकाः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2164326, "chapter_id": 4540, "verse_number": "५८", "content_sanskrit": "जेष्याम्यद्य रणे पार्थं सायकैर्नतपर्वभिः ।\nतिष्ठध्वं समरे शूरा भयं त्यजत फल्गुनात्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2164327, "chapter_id": 4540, "verse_number": "५९", "content_sanskrit": "न हि मद्वीर्यमासाद्य फल्गुनः प्रसहिष्यति ।\nयथा वेलां समासाद्य सागरो मकरालयः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2164328, "chapter_id": 4540, "verse_number": "६०", "content_sanskrit": "इत्युक्त्वा प्रययौ राजा सैन्येन महता वृतः ।\nफल्गुनं प्रति दुर्धर्षः क्रोधसंरक्तलोचनः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2164329, "chapter_id": 4540, "verse_number": "६१", "content_sanskrit": "तं प्रयान्तं महाबाहुं दृष्ट्वा शारद्वतस्तदा ।\nअश्वत्थामानमासाद्य वाक्यमेतदुवाच ह\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2164330, "chapter_id": 4540, "verse_number": "६२", "content_sanskrit": "एष राजा महाबाहुरमर्षी क्रोधमूर्च्छितः ।\nपतङ्गवृत्तिमास्थाय फल्गुनं योद्धुमिच्छति\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2164331, "chapter_id": 4540, "verse_number": "६३", "content_sanskrit": "यावन्नः पश्यमानानां प्राणान् पार्थेन सङ्गतः ।\nन जह्यात् पुरुषव्याघ्रस्तावद् वारय कौरवम्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2164332, "chapter_id": 4540, "verse_number": "६४", "content_sanskrit": "यावत् फल्गुनबाणानां गोचरं नाधिगच्छति ।\nकौरवः पार्थिवो वीरस्तावद् वारय तं द्रुतम्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2164333, "chapter_id": 4540, "verse_number": "६५", "content_sanskrit": "यावत् पार्थशरैर्घोरैर्निर्मुक्तोरगसन्निभैः ।\nन भस्मीक्रियते राजा तावद् युद्धान्निवार्यताम्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2164334, "chapter_id": 4540, "verse_number": "६६", "content_sanskrit": "अयुक्तमिव पश्यामि तिष्ठत्स्वस्मासु मानद ।\nस्वयं युद्धाय यद् राजा पार्थं यात्यसहायवान्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2164335, "chapter_id": 4540, "verse_number": "६७", "content_sanskrit": "दुर्लभं जीवितं मन्ये कौरव्यस्य किरीटिना ।\nयुद्ध्यमानस्य पार्थेन शार्दूलेनेव हस्तिनः\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2164336, "chapter_id": 4540, "verse_number": "६८", "content_sanskrit": "मातुलेनैवमुक्तस्तु द्रौणिः शस्त्रभृतां वरः ।\nदुर्योधनमिदं वाक्यं त्वरितं समभाषत\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2164337, "chapter_id": 4540, "verse_number": "६९", "content_sanskrit": "मयि जीवति गान्धारे न युद्धं गन्तुमर्हसि ।\nमामनादृत्य कौरव्य तव नित्यं हितैषिणम्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2164338, "chapter_id": 4540, "verse_number": "७०", "content_sanskrit": "न हि ते सम्भ्रमः कार्यः पार्थस्य विजयं प्रति ।\nअहमावारयिष्यामि पार्थं तिष्ठ सुयोधन\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2164339, "chapter_id": 4540, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2164340, "chapter_id": 4540, "verse_number": "७१", "content_sanskrit": "आचार्यः पाण्डुपुत्रान् वै पुत्रवत् परिरक्षति ।\nत्वमप्युपेक्षां कुरुषे तेषु नित्यं द्विजोत्तम\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2164341, "chapter_id": 4540, "verse_number": "७२", "content_sanskrit": "मम वा मन्दभाग्यत्वान्मन्दस्ते विक्रमो युधि ।\nधर्मराजप्रियार्थं वा द्रौपद्या वा न विद्म तत्\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2164342, "chapter_id": 4540, "verse_number": "७३", "content_sanskrit": "धिगस्तु मम लुब्धस्य यत्कृते सर्वबान्धवाः ।\nसुखार्हाः परमं दुःखं प्राप्नुवन्त्यपराजिताः\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2164343, "chapter_id": 4540, "verse_number": "७४", "content_sanskrit": "को हि शस्त्रभृतां मुख्यो महेश्वरसमो युधि ।\nशत्रून्न क्षपयेच्छक्तो यो न स्याद् गौतमीसुतः\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2164344, "chapter_id": 4540, "verse_number": "७५", "content_sanskrit": "अश्वत्थामन् प्रसीदस्व नाशयैतान् ममाहितान् ।\nतवास्त्रगोचरे शक्ताः स्थातुं देवापि नानघ\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2164345, "chapter_id": 4540, "verse_number": "७६", "content_sanskrit": "पाञ्चालान् सोमकांश्चैव जहि द्रौणे सहानुगान् ।\nवयं शेषान् हनिष्यामस्त्वयैव परिरक्षिताः\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2164346, "chapter_id": 4540, "verse_number": "७७", "content_sanskrit": "एते हि सोमका विप्र पाञ्चालाश्च यशस्विनः ।\nमम सैन्येषु संरब्धा विचरन्ति दवाग्निवत्\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2164347, "chapter_id": 4540, "verse_number": "७८", "content_sanskrit": "तान् वारय महाबाहो केकयांश्च नरोत्तम ।\nपराकुर्वन्ति निःशेषं रक्ष्यमाणाः किरीटिना\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2164348, "chapter_id": 4540, "verse_number": "७९", "content_sanskrit": "आदौ वा यदि वा पश्चात्तवेदं कर्म मारिष ।\nत्वमुत्पन्नो महाबाहो पाञ्चालानां वधं प्रति\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2164349, "chapter_id": 4540, "verse_number": "८०", "content_sanskrit": "करिष्यसि जगत् सर्वमपाञ्चालं किलाच्युत ।\nएवं सिद्धाब्रुवन् वाचो भविष्यति च तत्तथा\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2164350, "chapter_id": 4540, "verse_number": "८१", "content_sanskrit": "न तेऽस्त्रगोचरे शक्ताः स्थातुं देवाः सवासवाः ।\nकिमु पार्थाः सपाञ्चालाः सत्यमेतद् वचो मम\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2164351, "chapter_id": 4540, "verse_number": "८२", "content_sanskrit": "न त्वां समर्था संग्रामे पाण्डवाः सह सोमकैः ।\nबलाद् योधयितुं वीर सत्यमेतद् ब्रवीमि ते \t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2164352, "chapter_id": 4540, "verse_number": "८३", "content_sanskrit": "गच्छ गच्छ महाबाहो न नः कालात्ययो भवेत् ।\nइयं हि द्रवते सेना पार्थसायकपीडिता \t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2164353, "chapter_id": 4540, "verse_number": "८४", "content_sanskrit": "शक्तो ह्यसि महाबाहो दिव्येन स्वेन तेजसा ।\nनिग्रहे पाण्डुपुत्राणां पाञ्चालानां च मानद \t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2164354, "chapter_id": 4540, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि पञ्चचत्वारिंशदधिकशततमोऽध्यायः ॥ १४५ ॥\nघटोत्कचवधपर्वणि द्वादशोऽध्यायः ॥ १२ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}]