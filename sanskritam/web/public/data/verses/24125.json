[{"id": 7004125000, "chapter_id": 24125, "verse_number": "४-७४-१", "content_sanskrit": "स्कंद उवाच ।\nशृणु वातापि संहर्तः काश्यां पातकतंकिनी ।\nपद्मकल्पे तु या वृत्ता दमनस्य द्विजन्मनः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004125001, "chapter_id": 24125, "verse_number": "४-७४-२", "content_sanskrit": "भारद्वाजस्य तनयो दमनो नाम नामतः ।\nकृतमौंजीविधिः सोथ विद्याजातं प्रगृह्य च ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004125002, "chapter_id": 24125, "verse_number": "४-७४-३", "content_sanskrit": "संसारदुःखबहुलं जीवितं चापि चंचलम् ।\nविज्ञाय दमनो विद्वान्निर्जगाम गृहान्निजात् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004125003, "chapter_id": 24125, "verse_number": "४-७४-४", "content_sanskrit": "कांचिद्दिशं समालंब्य निर्वेदं परमं गतः ।\nप्रत्याश्रमं प्रतिनगं प्रत्यब्धि प्रतिकाननम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004125004, "chapter_id": 24125, "verse_number": "४-७४-५", "content_sanskrit": "प्रतितीर्थं प्रतिनदि स बभ्राम तपोयुतः ।\nयावंत्यायतनानीह तिष्ठंति परितो भुवम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004125005, "chapter_id": 24125, "verse_number": "४-७४-६", "content_sanskrit": "अध्युवास स तावंति संयतेंद्रियमानसः ।\nपरं न मनसः स्थैर्यं क्वापि प्रापि च तेन वै ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004125006, "chapter_id": 24125, "verse_number": "४-७४-७", "content_sanskrit": "मनोरथोपदेष्टा च कुत्रचित्क्वापि नेक्षितः ।\nकदाचिद्दैवयोगात्स दमनो नाम तापसः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004125007, "chapter_id": 24125, "verse_number": "४-७४-८", "content_sanskrit": "रेवातटे निरैक्षिष्ट तीर्थं चामरकंटकम् ।\nमहदायतनं पुण्यमोंकारस्यापि तत्र वै ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004125008, "chapter_id": 24125, "verse_number": "४-७४-९", "content_sanskrit": "दृष्ट्वा हृष्टमना आसीच्चेतः स्थैर्यमवाप ह ।\nअथ पाशुपतांस्तत्र स निरीक्ष्य तपोधनान् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004125009, "chapter_id": 24125, "verse_number": "४-७४-१०", "content_sanskrit": "विभूतिभूषिततनून्कृतलिंगसमर्चनान् ।\nविहितप्राणयात्रांश्च कृतागमविचारणान् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004125010, "chapter_id": 24125, "verse_number": "४-७४-११", "content_sanskrit": "स्वस्थोपविष्टान्स्वपुरोरग्रतोऽचलमानसान् ।\nप्रणम्योपाविशत्तत्र तदाचार्यस्य सन्निधौ ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004125011, "chapter_id": 24125, "verse_number": "४-७४-१२", "content_sanskrit": "प्रबद्धहस्तयुगलः प्रणमतरकंधरः ।\nअथ पाशुपताचार्यो गर्गो नाम महामुनिः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004125012, "chapter_id": 24125, "verse_number": "४-७४-१३", "content_sanskrit": "वार्धकेन समाक्रांतस्तपसा कृशविग्रहः ।\nशंभोराराधनेनिष्ठः श्रेष्ठः सर्वतपस्विषु ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004125013, "chapter_id": 24125, "verse_number": "४-७४-१४", "content_sanskrit": "पप्रच्छ दमनं चेति कस्त्वं कस्मादिहागतः ।\nतरुणोपि विरक्तोसि कुतस्तद्वद सत्तम ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004125014, "chapter_id": 24125, "verse_number": "४-७४-१५", "content_sanskrit": "इति प्रणयपूर्वं स निशम्य दमनोऽब्रवीत् ।\nभगोः पाशुपताचार्य सर्वज्ञाराधनप्रिय ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004125015, "chapter_id": 24125, "verse_number": "४-७४-१६", "content_sanskrit": "कथयामि यथार्थं ते निजचेतोविचेष्टितम् ।\nअहं ब्राह्मणदायादो वेदशास्त्रकृतश्रमः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004125016, "chapter_id": 24125, "verse_number": "४-७४-१७", "content_sanskrit": "संसारासारतां ज्ञात्वा वानप्रस्थमशिश्रियम् ।\nअनेनैव शरीरेण महासिद्धिमभीप्सता ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004125017, "chapter_id": 24125, "verse_number": "४-७४-१८", "content_sanskrit": "स्नातं बहुषु तीर्थेषु मंत्रा जप्तास्तु कोटिशः ।\nदेवताः सेविता बह्व्यो हवनं च कृतं बहु ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004125018, "chapter_id": 24125, "verse_number": "४-७४-१९", "content_sanskrit": "शुश्रूषिताश्च गुरवो बहवो बह्वनेहसम् ।\nमहाश्मशानेषु निशा भूयस्योप्यतिवाहिताः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004125019, "chapter_id": 24125, "verse_number": "४-७४-२०", "content_sanskrit": "शिखराणि गिरींद्राणां मया चाध्युषितान्यहो ।\nदिव्यौषधि सहस्राणि मया संसाधितान्यपि ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004125020, "chapter_id": 24125, "verse_number": "४-७४-२१", "content_sanskrit": "रसायनानि बहुशः सेवितानि मया पुनः ।\nमहासाहसमालंब्य सिद्धाध्युषितकंदराः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004125021, "chapter_id": 24125, "verse_number": "४-७४-२२", "content_sanskrit": "मया प्रविष्टा बहुशः कृतांतवदनोपमाः ।\nतपश्चापि महत्तप्तं बहुभिर्नियमैर्यमैः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004125022, "chapter_id": 24125, "verse_number": "४-७४-२३", "content_sanskrit": "परं किंचित्क्वचिन्नैक्षि सिद्ध्यंकुरमपि प्रभो ।\nइदानीं त्वामनुप्राप्य महीं पर्यटता मया ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004125023, "chapter_id": 24125, "verse_number": "४-७४-२४", "content_sanskrit": "मनसः स्थैर्यमापन्नमिव संप्राप्तसिद्धिना ।\nअवश्यं त्वन्मुखांभोजाद्यद्वचो निःसरिष्यति ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004125024, "chapter_id": 24125, "verse_number": "४-७४-२५", "content_sanskrit": "तेनैव महती सिद्धिर्भवित्री मम नान्यथा ।\nतद्ब्रूहि सूपदेशं च कथं सिद्धिर्भवेन्मम ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004125025, "chapter_id": 24125, "verse_number": "४-७४-२६", "content_sanskrit": "अनेनैव शरीरेण पार्थिवेन प्रथीयसी ।\nदमनस्य निशम्येति गर्गाचार्यो वचस्तदा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004125026, "chapter_id": 24125, "verse_number": "४-७४-२७", "content_sanskrit": "प्रत्यक्षदृष्टं प्रोवाच महदाश्चर्यमुत्तमम् ।\nसर्वेषां शृण्वतां तत्र शिष्याणां स्थिरचेतसाम् ।\nमुमुक्षूणां धृतवतां महापाशुपतं व्रतम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004125027, "chapter_id": 24125, "verse_number": "४-७४-२८", "content_sanskrit": "गर्ग उवाच ।\nअनेनैवेह देहेन यदि त्वं सिद्धिकामुकः ।\nशृणुष्वावहितो भूत्वा तदा ते कथयाम्यहम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004125028, "chapter_id": 24125, "verse_number": "४-७४-२९", "content_sanskrit": "अविमुक्ते महाक्षेत्रे सर्वसिद्धिप्रदे सताम् ।\nधर्मार्थकाममोक्षाख्य रत्नानां परमाकरे ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004125029, "chapter_id": 24125, "verse_number": "४-७४-३०", "content_sanskrit": "समाश्रितानां जंतूनां सर्वेषां सर्वकर्मणाम् ।\nशलभानां प्रदीपाभे तमःस्तोम महाद्विपि ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004125030, "chapter_id": 24125, "verse_number": "४-७४-३१", "content_sanskrit": "कर्मभूरुह दावाग्नौ संसाराब्ध्यौर्वशोचिपि ।\nनिर्वाणलक्ष्मी क्षीराब्धौ सुखसंकेतसद्मनि ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004125031, "chapter_id": 24125, "verse_number": "४-७४-३२", "content_sanskrit": "दीर्घनिद्रा प्रसुप्तानां परमोद्बोधदायिनि ।\nयातायातश्रमापन्नप्राणिमार्गमहीरुहि ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004125032, "chapter_id": 24125, "verse_number": "४-७४-३३", "content_sanskrit": "अनेकजन्मजनित महापापाद्रिवज्रिणि ।\nनामोच्चारकृतां पुंसां महाश्रेयो विधायिनि ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004125033, "chapter_id": 24125, "verse_number": "४-७४-३४", "content_sanskrit": "विश्वेशितुः परेधाम्नि सीम्नि स्वर्गापवर्गयोः ।\nस्वर्धुनी लोलकल्लोला नित्यक्षालित भूतले ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004125034, "chapter_id": 24125, "verse_number": "४-७४-३५", "content_sanskrit": "एवंविधे महाक्षेत्रे सर्वदुःखौघहारिणि ।\nप्रत्यक्षं मम यद्वृत्तं तद्ब्रवीमि महामते ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004125035, "chapter_id": 24125, "verse_number": "४-७४-३६", "content_sanskrit": "यत्र कालभयं नास्ति यत्र नास्त्येनसो भयम् ।\nतत्क्षेत्रमहिमानं कः सम्यग्वर्णयितुं क्षमः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004125036, "chapter_id": 24125, "verse_number": "४-७४-३७", "content_sanskrit": "तीर्थानि यानि लोकेस्मिञ्जंतूनामघहान्यहो ।\nतानि सर्वाणि शुद्ध्यर्थं काशीमायांति नित्यशः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004125037, "chapter_id": 24125, "verse_number": "४-७४-३८", "content_sanskrit": "अपि काश्यां वसेद्यस्तु सर्वाशी सर्वविक्रयी ।\nस यां गतिं लभेन्मर्त्यो यज्ञैर्दानैर्न सान्यतः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004125038, "chapter_id": 24125, "verse_number": "४-७४-३९", "content_sanskrit": "रागबीजसमुद्भूतः संसारविटपो महान् ।\nदीर्घस्वाप कुठारेण च्छिन्नः काश्यां न वर्धते ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004125039, "chapter_id": 24125, "verse_number": "४-७४-४०", "content_sanskrit": "सर्वेषामूषराणां तु काशी परम ऊषरः ।\nवप्तुर्बीजमिदं तस्मिन्नुप्तं नैव प्ररोहति ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004125040, "chapter_id": 24125, "verse_number": "४-७४-४१", "content_sanskrit": "स्मरिष्यंतीह ये काशीमवश्यं तेपि साधवः ।\nतेप्यघौघ विनिर्मुक्ता यास्यंति गतिमुत्तमाम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004125041, "chapter_id": 24125, "verse_number": "४-७४-४२", "content_sanskrit": "विभूतिः सर्वलोकानां सत्यादीनां सुभंगुरा ।\nअभंगुरा विमुक्तस्य सा तु लभ्या शिवाज्ञया ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004125042, "chapter_id": 24125, "verse_number": "४-७४-४३", "content_sanskrit": "कृमिकीटपतंगानामविमुक्ते तनुत्यजाम् ।\nविभूतिर्दृश्यते या सा क्वास्ति ब्रह्मांडमंडले ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004125043, "chapter_id": 24125, "verse_number": "४-७४-४४", "content_sanskrit": "वाराणसी यदा प्राप्ता कदाचित्कालपर्ययात् ।\nस उपायो विधातव्यो येन नो निष्क्रमो बहिः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004125044, "chapter_id": 24125, "verse_number": "४-७४-४५", "content_sanskrit": "पूर्वतो मणिकर्णीशो ब्रह्मेशो दक्षिणे स्थितः ।\nपश्चिमे चैव गोकर्णो भारभूतस्तथोत्तरे ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004125045, "chapter_id": 24125, "verse_number": "४-७४-४६", "content_sanskrit": "इत्येतदुत्तमं क्षेत्रमविमुक्ते महाफलम् ।\nमणिकर्णी ह्रदे स्नात्वा दृष्ट्वा विश्वेश्वरंविभुम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004125046, "chapter_id": 24125, "verse_number": "४-७४-४७", "content_sanskrit": "क्षेत्रं प्रदक्षिणीकृत्य राजसूयफलं लभेत् ।\nतत्र श्राद्धप्रदातुश्च मुच्यंते प्रपितामहाः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004125047, "chapter_id": 24125, "verse_number": "४-७४-४८", "content_sanskrit": "अविमुक्त समं क्षेत्रमपि ब्रह्मांडगोलके ।\nन विद्यते क्वचित्सत्यं सत्यं साधकसिद्धिदम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004125048, "chapter_id": 24125, "verse_number": "४-७४-४९", "content_sanskrit": "रक्षंति सततं क्षेत्रं यत्र पाशासिपाणयः ।\nमहापारिषदा उग्राः क्रूरेभ्योऽक्रूरबुद्धयः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004125049, "chapter_id": 24125, "verse_number": "४-७४-५०", "content_sanskrit": "प्राग्द्वारमट्टहासश्च गणकोटिपरीवृतः ।\nरक्षेदहर्निशं क्षेत्रं दुर्वृत्तेभ्यो विभीषणः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004125050, "chapter_id": 24125, "verse_number": "४-७४-५१", "content_sanskrit": "तथैव भूतधात्रीशः क्षेत्रदक्षिणरक्षकः ।\nगोकर्णः पश्चिमद्वारं पाति कोटिगणावृतः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004125051, "chapter_id": 24125, "verse_number": "४-७४-५२", "content_sanskrit": "उदग्द्वारं तथा रक्षेद्घंटाकर्णो महागणः ।\nऐशंकोणं छागवक्त्रो भीषणो वह्निदिग्दलम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004125052, "chapter_id": 24125, "verse_number": "४-७४-५३", "content_sanskrit": "रक्षः काष्ठां शंकुकर्णो दृमिचंडो मरुद्दिशम् ।\nइत्थं क्षेत्रं सदा पांति गणा एतेऽति भास्वराः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004125053, "chapter_id": 24125, "verse_number": "४-७४-५४", "content_sanskrit": "कालाक्षोरण भद्रस्तु कौलेयः कालकंपनः ।\nएते पूर्वेण रक्षंति गंगापारे स्थिता गणाः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004125054, "chapter_id": 24125, "verse_number": "४-७४-५५", "content_sanskrit": "वीरभद्रो नभश्चैव कर्दमालिप्तविग्रहः ।\nस्थूलकर्णो महाबाहुरसिपारे व्यवस्थिताः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004125055, "chapter_id": 24125, "verse_number": "४-७४-५६", "content_sanskrit": "विशालाक्षो महाभीमः कुंडोदरमहोदरौ ।\nरक्षंति पश्चिमद्वारं देहलीदेशसंस्थिताः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004125056, "chapter_id": 24125, "verse_number": "४-७४-५७", "content_sanskrit": "नंदिसेनश्च पंचालः खरपादकरंटकः ।\nआनंदोगोपको बभ्रू रक्षंति वरणातटे ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004125057, "chapter_id": 24125, "verse_number": "४-७४-५८", "content_sanskrit": "तस्मिन्क्षेत्रे महापुण्ये लिंगमोंकारसंज्ञकम् ।\nतत्र सिद्धिं परां प्राप्ता देहेनानेन साधकाः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004125058, "chapter_id": 24125, "verse_number": "४-७४-५९", "content_sanskrit": "कपिलश्चैव सावर्णिः श्रीकंठः पिगलोंशुमान् ।\nएते पाशुपताः सिद्धास्तल्लिंगाराधनेन हि ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004125059, "chapter_id": 24125, "verse_number": "४-७४-६०", "content_sanskrit": "एकदा तस्य लिंगस्य कृत्वा पंचापिपूजनम् ।\nनृत्यतः सहुडुत्कारं तस्मिंल्लिंगे लयं ययुः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004125060, "chapter_id": 24125, "verse_number": "४-७४-६१", "content_sanskrit": "अन्यच्च ते प्रवक्ष्यामि तत्र यद्वृत्तमद्भुतम् ।\nनिशामय महाबुद्धे दमन द्विजसत्तम ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004125061, "chapter_id": 24125, "verse_number": "४-७४-६२", "content_sanskrit": "एका भेकी मुने तत्र चरंती लिंग सन्निधौ ।\nप्रदक्षिणं सदा कुर्यान्निर्माल्याक्षतभक्षिणी ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004125062, "chapter_id": 24125, "verse_number": "४-७४-६३", "content_sanskrit": "सा तत्र मृत्युं न प्राप शिवनिर्माल्यभक्षणात् ।\nक्षेत्रादन्यत्र मरणं जातं तस्यास्तदेनसः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004125063, "chapter_id": 24125, "verse_number": "४-७४-६४", "content_sanskrit": "वरं विषमपिप्राश्यं शिवस्वं नैव भक्षयेत् ।\nविषमेकाकिनं हंति थिवस्वं पुत्रपौवकम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004125064, "chapter_id": 24125, "verse_number": "४-७४-६५", "content_sanskrit": "शिवस्य परिपुष्टांगाः स्पर्शनीया न साधुभिः ।\nतेन कर्मविपाकेन ततस्ते रौरवौकसः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004125065, "chapter_id": 24125, "verse_number": "४-७४-६६", "content_sanskrit": "कश्चित्काकः समालोक्य मंडूकीं तामितस्ततः ।\nपोप्लूयमानामादाय चंच्वा क्षेत्राद्बहिर्गतः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004125066, "chapter_id": 24125, "verse_number": "४-७४-६७", "content_sanskrit": "वर्षाभ्वी तेन सा क्षिप्ता काकेन क्षेत्रबाह्यतः ।\nअथ सा कालतो भेकी तत्रैव क्षेत्रसत्तमे ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004125067, "chapter_id": 24125, "verse_number": "४-७४-६८", "content_sanskrit": "प्रदक्षिणीकरणतो लिंगस्यस्पर्शनादपि ।\nपुण्यापुण्यवतीजाता कन्यापुष्पबटोर्गृहे ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004125068, "chapter_id": 24125, "verse_number": "४-७४-६९", "content_sanskrit": "शुभावयवसंस्थाना शुभलक्षणलक्षिता ।\nपरं गृध्रमुखी जाता निर्माल्याक्षतभक्षणात् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004125069, "chapter_id": 24125, "verse_number": "४-७४-७०", "content_sanskrit": "सम्यग्गीतरहस्यज्ञा नितरां मधुरस्वरा ।\nसप्तस्वरास्त्रयो ग्रामा मूर्च्छनास्त्वैकविंशतिः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004125070, "chapter_id": 24125, "verse_number": "४-७४-७१", "content_sanskrit": "ताना एकोनपंचाश ताला एकोत्तरंशतम् ।\nरागाः षडेव तेषां तु पंचपंचापि चांगनाः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004125071, "chapter_id": 24125, "verse_number": "४-७४-७२", "content_sanskrit": "षड्विंशद्रागरागिण्य इति रागि मुदावहाः ।\nदेशकाल विभेदेन पंचषष्टिस्तथा पराः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004125072, "chapter_id": 24125, "verse_number": "४-७४-७३", "content_sanskrit": "यावंत एव तालाः स्यु रागास्तावंत एव हि ।\nइति गीतोपनिषदा प्रत्यहं सा शुभव्रता ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004125073, "chapter_id": 24125, "verse_number": "४-७४-७४", "content_sanskrit": "माधवी मधुरालापा सदोंकारं समर्चयेत् ।\nप्राप्याप्यनर्घ्यतारुण्यं सा तु पुष्पबटोः सुता ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004125074, "chapter_id": 24125, "verse_number": "४-७४-७५", "content_sanskrit": "प्राग्जन्मवासनायोगादोंकारं बह्वमंस्त वै ।\nस्वभाव चंचलं चेतस्तस्यास्तल्लिंग सेवनात् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004125075, "chapter_id": 24125, "verse_number": "४-७४-७६", "content_sanskrit": "दमनस्थैर्यमगमद्योगेनेव महात्मनः ।\nन दिवा बाधयांचक्रे क्षुत्तृण्निद्रा क्षपा सुताम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004125076, "chapter_id": 24125, "verse_number": "४-७४-७७", "content_sanskrit": "अतंद्रितमना आसीत्सा तल्लिंग निरीक्षणे ।\nअक्ष्णोर्निमेषा यावंतस्तस्या आसन्दिवानिशम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004125077, "chapter_id": 24125, "verse_number": "४-७४-७८", "content_sanskrit": "तावत्कालस्तया साध्व्या महान्विघ्नोऽनुमीयते ।\nनिमेषांतरितः कालो यो यो व्यथोंगतो मम ।\nलिंगानवेक्षणात्तत्र प्रायश्चित्तं कथं भवेत ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004125078, "chapter_id": 24125, "verse_number": "४-७४-७९", "content_sanskrit": "इति संचितयंत्येव सेवां तत्याज नोंकृतेः ।\nजलाभिलाषिणी सा तु लिंगनामामृतं पिबेत् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004125079, "chapter_id": 24125, "verse_number": "४-७४-८०", "content_sanskrit": "नान्य द्दिदृक्षिणी तस्या अक्षिणी श्रुतिगे अपि ।\nविहाय लिंगमोंकारं हृद्विहायः स्थितं सताम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004125080, "chapter_id": 24125, "verse_number": "४-७४-८१", "content_sanskrit": "तस्याः शब्दग्रहौ नान्य शब्दग्रहणतत्परौ ।\nअतीव निपुणौ जातौ तत्सन्माल्यकरौकरौ ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004125081, "chapter_id": 24125, "verse_number": "४-७४-८२", "content_sanskrit": "नान्यत्र चरणौ तस्याश्चरतः सुखवांछया ।\nत्यक्त्वोंकाराजिरक्षोणीं क्षुण्णां निर्वाणपद्मया ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004125082, "chapter_id": 24125, "verse_number": "४-७४-८३", "content_sanskrit": "ओंकारं प्रणवं सारं परब्रह्मप्रकाशकम् ।\nशब्दब्रह्मत्रयीरूपं नादबिंदुकलालयम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004125083, "chapter_id": 24125, "verse_number": "४-७४-८४", "content_sanskrit": "सदक्षरं चादिरूपं विश्वरूपं परावरम् ।\nवरं वरेण्यं वरदं शाश्वतं शांतमीश्वरम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004125084, "chapter_id": 24125, "verse_number": "४-७४-८५", "content_sanskrit": "सर्वलोकैकजनकं सर्वलोकैकरक्षकम् ।\nसर्वलोकैकसंहर्तृ सर्वलोकैकवंदितम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004125085, "chapter_id": 24125, "verse_number": "४-७४-८६", "content_sanskrit": "आद्यंतरहितं नित्यं र्शिवं शंकरमव्ययम् ।\nएकगुणत्रयातीतं भक्तस्वांतकृतास्पदम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004125086, "chapter_id": 24125, "verse_number": "४-७४-८७", "content_sanskrit": "निरुपाधिं निराकारं निर्विकारं निरंजनम् ।\nनिर्मलं निरहंकारं निष्प्रपंचं निजोदयम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004125087, "chapter_id": 24125, "verse_number": "४-७४-८८", "content_sanskrit": "स्वात्माराममनंतं च सर्वगं सर्वदर्शिनम् ।\nसर्वदं सर्वभोक्तारं सर्वं सर्वसुखास्पदम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004125088, "chapter_id": 24125, "verse_number": "४-७४-८९", "content_sanskrit": "वागिंद्रियं तदीयं च प्रोच्चरत्तदहर्निशम् ।\nनामांतरं न गृह्णाति क्वचिदन्यस्यकस्यचित् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004125089, "chapter_id": 24125, "verse_number": "४-७४-९०", "content_sanskrit": "एतन्नामाक्षररसं रसयंती दिवानिशम् ।\nरसना नैव जानाति तस्या अन्यद्रसांतरम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004125090, "chapter_id": 24125, "verse_number": "४-७४-९१", "content_sanskrit": "संमार्जनं रंगमालाः प्रासादं परितः सदा ।\nविदध्यान्माधवी तत्र तथार्चा पात्रशोधनम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004125091, "chapter_id": 24125, "verse_number": "४-७४-९२", "content_sanskrit": "तत्र पाशुपता ये वै प्रणवेशार्चने रताः ।\nतांश्च शुश्रूषयेन्नित्यं पितृबुद्ध्याति भक्तितः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004125092, "chapter_id": 24125, "verse_number": "४-७४-९३", "content_sanskrit": "वैशाखस्य चतुर्दश्यामेकदा सा तु माधवी ।\nरात्रौ जागरणं कृत्वा दिवोपवसान्विता ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004125093, "chapter_id": 24125, "verse_number": "४-७४-९४", "content_sanskrit": "यात्रामिलितभक्तेषु प्रातर्यातेषु सर्वतः ।\nसंमार्जनादिकं कृत्वा लिंगमभ्यर्च्य हर्षतः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004125094, "chapter_id": 24125, "verse_number": "४-७४-९५", "content_sanskrit": "गायंती मधुरं गीतं नृत्यंती निजलीलया ।\nध्यायंती लिंगमोंकारं तत्र लिंगे लयं ययौ ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004125095, "chapter_id": 24125, "verse_number": "४-७४-९६", "content_sanskrit": "अनेनैव शरीरेण पार्थिवेन महामतिः ।\nअस्मदाचार्यमुख्यानां पश्यतां च तपस्विनाम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004125096, "chapter_id": 24125, "verse_number": "४-७४-९७", "content_sanskrit": "प्रादुर्बभूव यल्लिंगाज्ज्योतिर्जटिलितांबरम् ।\nतत्र ज्योतिषि सा बाला ज्योतिर्मय्यपि साप्यभूत् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004125097, "chapter_id": 24125, "verse_number": "४-७४-९८", "content_sanskrit": "राधशुक्लचतुर्दश्यामद्यापि क्षेत्रवासिनः ।\nतत्र यात्रां प्रकुर्वंति महोत्सवपुरःसराः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004125098, "chapter_id": 24125, "verse_number": "४-७४-९९", "content_sanskrit": "तत्र जागरणं कृत्वा चतुर्दश्यामुपोषिताः ।\nप्राप्नुवंति परं ज्ञानं यत्रकुत्रापि वै मृताः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004125099, "chapter_id": 24125, "verse_number": "४-७४-१००", "content_sanskrit": "ब्रह्मांडोदर मध्ये तु यानि तीर्थानि सर्वतः ।\nतानि वैशाखभूतायामायांत्योंकृति दर्शने ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004125100, "chapter_id": 24125, "verse_number": "४-७४-१०१", "content_sanskrit": "लिंगाग्रे श्रीमुखी नाम्नी गुहास्ति परमोत्तमा ।\nपातालस्य च तद्द्वारं तत्र सिद्धा वसंति हि ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004125101, "chapter_id": 24125, "verse_number": "४-७४-१०२", "content_sanskrit": "तिष्ठेयुः पंचरात्रं ये गुहायां तत्र सुव्रताः ।\nते नागकन्याः पश्यंति ब्रूयुस्ताश्च शुभाशुभम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004125102, "chapter_id": 24125, "verse_number": "४-७४-१०३", "content_sanskrit": "कंदरोत्तरदिग्भागे तत्र कूपो रसोदकः ।\nआषण्मासं च तत्पीत्वा पिबेद्ब्रह्मरसायनम् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004125103, "chapter_id": 24125, "verse_number": "४-७४-१०४", "content_sanskrit": "तत्र नादेश्वरं लिंगं दृष्ट्वा नादनिदानभूः ।\nसर्वनादात्मकं विश्वं तच्छ्रवो गोचरी भवेत् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004125104, "chapter_id": 24125, "verse_number": "४-७४-१०५", "content_sanskrit": "तत्र मत्स्योदरीं स्नात्वा स्वर्धुनीं वरुणाप्लुताम् ।\nकृतकृत्यो भवेज्जंतुर्नैव शोचति कुत्रचित् ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004125105, "chapter_id": 24125, "verse_number": "४-७४-१०६", "content_sanskrit": "असंख्याता गताः सिद्धिमोंकारेश्वरसेवकाः ।\nपार्थिवेनैव देहेन दिव्यभूतेन तत्क्षणात् ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004125106, "chapter_id": 24125, "verse_number": "४-७४-१०७", "content_sanskrit": "अविमुक्तं परं क्षेत्रं ब्रह्मांडादपि सर्वतः ।\nततोपि पर ओंकार उक्तो मत्स्योदरी तटे ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004125107, "chapter_id": 24125, "verse_number": "४-७४-१०८", "content_sanskrit": "प्रणवेशोंऽग यैः काश्यां न नतो नापि चार्चितः ।\nकिमर्थं ते समुत्पन्ना मातृतारुण्यहारिणः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004125108, "chapter_id": 24125, "verse_number": "४-७४-१०९", "content_sanskrit": "यदा प्रभृति विश्वेशो मंदरादागतोऽभवत् ।\nतस्मिन्नानंद गहने तदाप्रभृति सत्तम ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7004125109, "chapter_id": 24125, "verse_number": "४-७४-११०", "content_sanskrit": "सर्वाण्यायतनान्याशु साब्धीनि स गिरीण्यपि ।\nस नदीनि स तीर्थानि स द्वीपानि ययुस्ततः ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7004125110, "chapter_id": 24125, "verse_number": "४-७४-१११", "content_sanskrit": "इदानीं मम भाग्येन स्मारितोहं त्वया मुने ।\nअहमप्यागमिष्यामि यामः काशीं शनैः शनैः ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7004125111, "chapter_id": 24125, "verse_number": "४-७४-११२", "content_sanskrit": "एतेपि मम शिष्या ये महापाशुपतव्रताः ।\nकाशीं यियासवस्तेपि यतः सर्वे मुमुक्षवः ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7004125112, "chapter_id": 24125, "verse_number": "४-७४-११३", "content_sanskrit": "अपि वार्धकमासाद्य यैः काशी नैव शीलिता ।\nमानुषे दुर्लभे नष्टे कुतस्तेषां महासुखम् ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7004125113, "chapter_id": 24125, "verse_number": "४-७४-११४", "content_sanskrit": "यावन्नेंद्रिय वैकल्यं यावन्नैवायुषः क्षयः ।\nतावत्सेव्यं प्रयत्नेन शंभोरानंदकाननम् ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7004125114, "chapter_id": 24125, "verse_number": "४-७४-११५", "content_sanskrit": "य आनंदवनं शंभोः शिश्रियुः श्रीनिकेतनम् ।\nअचलाश्रीर्न मुंचेत्तान्महासौख्यैकशेवधीन् ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7004125115, "chapter_id": 24125, "verse_number": "४-७४-११६", "content_sanskrit": "इत्याख्याय कथां रम्यां गर्गः पाशुपतोत्तमः ।\nभारद्वाजेन सहितः प्राप वाराणसीं पुरीम् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7004125116, "chapter_id": 24125, "verse_number": "४-७४-११७", "content_sanskrit": "दमनोपि हि धर्मात्मा गर्गाचार्येण संयुतः ।\nआराध्य श्रीमदोंकारं तस्मिंल्लिंगे लयं गतः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7004125117, "chapter_id": 24125, "verse_number": "४-७४-११८", "content_sanskrit": "स्कंद उवाच ।\nइल्वलारे परं स्थानमोंकारमविमुक्तके ।\nतत्र सिद्धिपरां जग्मुः साधका बहुशो मुने ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7004125118, "chapter_id": 24125, "verse_number": "४-७४-११९", "content_sanskrit": "कलौ कलुषचित्तानां पुरो नाख्येयमेव हि ।\nप्रणवेश्वरमाहात्म्यं नास्तिकानां विशेषतः ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7004125119, "chapter_id": 24125, "verse_number": "४-७४-१२०", "content_sanskrit": "ये निंदंति महादेवं क्षेत्रं निंदंति येऽधियः ।\nपुराणं ये च निंदंति ते संभाष्या न कुत्रचित् ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7004125120, "chapter_id": 24125, "verse_number": "४-७४-१२१", "content_sanskrit": "ओंकारसदृशं लिंगं न क्वचिज्जगतीतले ।\nइति गौर्यै समाख्यातं देवदेवेन निश्चितम् ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7004125121, "chapter_id": 24125, "verse_number": "४-७४-१२२", "content_sanskrit": "इममध्यायमाकर्ण्य नरस्तद्गतमानसः ।\nविमुक्तः सर्वपापेभ्यः शिवलोकमवाप्नुयात् ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7004125122, "chapter_id": 24125, "verse_number": "४-७४-१२३", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीति साहस्र्यां संहितायां चतुर्थेकाशीखंड उत्तरार्ध ओंकारमाहात्म्यं नाम चतुःसप्ततितमोऽध्यायः ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}]