[{"id": 2207596, "chapter_id": 5427, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2207597, "chapter_id": 5427, "verse_number": "१", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nदम्पत्योः पार्थ संवादमभयं नाम नामतः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2207598, "chapter_id": 5427, "verse_number": "२", "content_sanskrit": "ब्राह्मणी ब्राह्मणं कञ्चित् ज्ञानविज्ञानपारगम् ।\nदृष्ट्वा विविक्त आसीनं भार्या भर्तारमब्रवीत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2207599, "chapter_id": 5427, "verse_number": "", "content_sanskrit": "ब्राह्मणी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2207600, "chapter_id": 5427, "verse_number": "३", "content_sanskrit": "कं नु लोकं गमिष्यामि त्वामहं पतिमाश्रिता ।\nन्यस्तकर्माणमासीनं कीनाशमविचक्षणम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2207601, "chapter_id": 5427, "verse_number": "४", "content_sanskrit": "भार्याः पतिकृतान् लोकान् आप्नुवन्तीह नः श्रुतम् ।\nत्वामहं पतिमासाद्य कां गमिष्यामि वै गतिम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2207602, "chapter_id": 5427, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2207603, "chapter_id": 5427, "verse_number": "५", "content_sanskrit": "एवमुक्तः स शान्तात्मा तामुवाच हसन्निव\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2207604, "chapter_id": 5427, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2207605, "chapter_id": 5427, "verse_number": "६", "content_sanskrit": "सुभगे नाभ्यसूयामि वाक्यस्यास्य तवानघे\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2207606, "chapter_id": 5427, "verse_number": "७", "content_sanskrit": "ग्राह्यं दृश्यं तथा श्राव्यं यदिदं कर्म विद्यते ।\nएतदेव व्यवस्यन्ति कर्म कर्मेति कर्मिणः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2207607, "chapter_id": 5427, "verse_number": "८", "content_sanskrit": "मोहमेव निगच्छन्ति कर्मिणो ज्ञानवर्जिताः ।\nनैष्कर्म्यं न च लोकेऽस्मिन् मौर्तमित्युपलभ्यते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2207608, "chapter_id": 5427, "verse_number": "९", "content_sanskrit": "कर्मणा मनसा वाचा शुभं वा यदि वाऽशुभम् ।\nजन्मादि मूर्तिभेदाद्वै कर्म भूतेषु वर्तते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2207609, "chapter_id": 5427, "verse_number": "१०", "content_sanskrit": "रक्षोभिर्वध्यमानेषु दृश्यादृश्येषु कर्मसु ।\nआत्मस्थमात्मना तेन दृष्टमायतनं मया\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2207610, "chapter_id": 5427, "verse_number": "११", "content_sanskrit": "यत्र तद् ब्रह्म निर्द्वन्द्वं यत्र सोमः सहाग्निना ।\nव्यवायं कुरुते नित्यं धीरो भूतानि धारयन्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2207611, "chapter_id": 5427, "verse_number": "१२", "content_sanskrit": "यत्र ब्रह्मादयो युक्ताः तदक्षरमुपासते ।\nविद्वांसः सुव्रता यत्र शान्तात्मानो जितेन्द्रियाः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2207612, "chapter_id": 5427, "verse_number": "१३", "content_sanskrit": "घ्राणेन न तदाघ्रेयं न चास्वाद्यं च जिह्वया ।\nस्पर्शनेन च तत्स्पृश्यं मनसा नावगम्यते\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2207613, "chapter_id": 5427, "verse_number": "१४", "content_sanskrit": "चक्षुषा न विषह्यं च यत् किञ्चिच्छ्रवणात् परम् ।\nअगन्धरसमस्पर्शम् अरूपं शब्दवर्जितम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2207614, "chapter_id": 5427, "verse_number": "१५", "content_sanskrit": "यतः प्रवर्तते तन्त्रं यत्र च प्रतितिष्ठति ।\nततः प्रवर्तते तन्त्रं तत्र च प्रतितिष्ठति\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2207615, "chapter_id": 5427, "verse_number": "१६", "content_sanskrit": "प्राणोपानः समानश्च व्यानश्चोदान एव च ।\nतत एव प्रवर्तन्ते तमेव प्रविशन्ति च\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2207616, "chapter_id": 5427, "verse_number": "१७", "content_sanskrit": "समानव्यानयोर्मध्ये प्राणापानौ विचेरतुः ।\nतस्मिन् सुप्ते प्रलीयन्ते समानो व्यान एव च\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2207617, "chapter_id": 5427, "verse_number": "१८", "content_sanskrit": "अपानप्राणयोर्मध्ये उदानो व्याप्य तिष्ठति ।\nतस्माच्छयानं पुरुषं प्राणापानौ न मुञ्चतः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2207618, "chapter_id": 5427, "verse_number": "१९", "content_sanskrit": "प्राणो नोपहते यत्तु तमुदानं प्रचक्षते ।\nतस्मात् तपो व्यवस्यन्ति तद्भवं ब्रह्मवादिनः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2207619, "chapter_id": 5427, "verse_number": "२०", "content_sanskrit": "तेषामन्योन्यभक्तानां सर्वेषां देहचारिणाम् ।\nअग्निर्वैश्वानरो मध्ये सप्तधा विहितोऽन्तरा\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2207620, "chapter_id": 5427, "verse_number": "२१", "content_sanskrit": "घ्राणं जिह्वा च चक्षुश्च त्वक् च श्रोत्रं च पञ्चमी ।\nमनो बुद्धिश्च सप्तैता जिह्वा वैश्वानरार्चिषः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2207621, "chapter_id": 5427, "verse_number": "२२", "content_sanskrit": "ध्रेयं पेयं च दृश्यं च स्पृश्यं श्राव्यं तथैव च ।\nमन्तव्यमवबोद्धव्यं ताः सप्त समिधो मताः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2207622, "chapter_id": 5427, "verse_number": "२३", "content_sanskrit": "घ्राता भक्षयिता द्रष्टा स्प्रष्टा श्रोता च पञ्चमः ।\nमन्ता बोद्धा च सप्तैते भवन्ति परमर्त्विजः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2207623, "chapter_id": 5427, "verse_number": "२४", "content_sanskrit": "ध्रेये पेये च दृश्ये च स्पृश्ये श्राव्ये तथैव च ।\nमन्तव्येऽप्यवबोद्धव्ये सुभगे पश्य सर्वदा\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2207624, "chapter_id": 5427, "verse_number": "२५", "content_sanskrit": "हवींष्यग्निषु होतारः सप्तधा सप्त सप्तषु ।\nसम्यक् प्रक्षिप्य विद्वांसो जनयन्ति स्वयोनिषु\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2207625, "chapter_id": 5427, "verse_number": "२६", "content_sanskrit": "पृथिवी वायुराकाशमापो ज्योतिश्च पञ्चमम् ।\nमनो बुद्धिश्च सप्तैते योनिरित्येव शब्दिताः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2207626, "chapter_id": 5427, "verse_number": "२७", "content_sanskrit": "हविर्गता गुणाः सर्वे प्रविशन्त्यग्निमुन्मुखम् ।\nअन्तर्वासमुषित्वा च जायन्ते स्वासु योनिषु\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2207627, "chapter_id": 5427, "verse_number": "२८", "content_sanskrit": "तत्रैव च निरुद्ध्यन्ते प्रलये भूतभावने ।\nततः सञ्जायते गन्धः ततः सञ्जायते रसः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2207628, "chapter_id": 5427, "verse_number": "२९", "content_sanskrit": "ततः सञ्जायते रूपं ततः स्पर्शोऽभिजायते ।\nततः सञ्जायते शब्दः संशयस्तत्र जायते\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2207629, "chapter_id": 5427, "verse_number": "३०", "content_sanskrit": "ततः सञ्जायते निष्ठा जन्मैतत् सप्तधा विदुः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2207630, "chapter_id": 5427, "verse_number": "३१", "content_sanskrit": "अनेनैव प्रकारेण प्रगृहीताः पुरातनैः ।\nपूर्णाहुतिभिरापूर्णास्तैः पूर्यन्ते महाजनाः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2207631, "chapter_id": 5427, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nआश्वमेधिकपर्वणि पञ्चप्राणे स्थिता(?) कथननाम एकविंशोऽध्यायः ॥२१॥\nअनुगीतापर्वणि षष्ठोऽध्यायः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]