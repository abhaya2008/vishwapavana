[{"id": 900008271, "chapter_id": 8625, "verse_number": "6.1", "content_sanskrit": "आद्यसूत्रे ब्रह्मशब्देन जीवादिव्यावर्तकगुणपूर्तिं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008272, "chapter_id": 8625, "verse_number": "6.2", "content_sanskrit": "अत्र ब्रह्मणि समन्वयो न युक्तो युक्तो वेति चिन्ता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008273, "chapter_id": 8625, "verse_number": "6.3", "content_sanskrit": "पूर्वपक्षस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008274, "chapter_id": 8625, "verse_number": "6.4", "content_sanskrit": "सिद्धान्तस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900008275, "chapter_id": 8625, "verse_number": "6.5", "content_sanskrit": "अवाच्यत्वाज्ञेयत्वादिश्रुतिस्त्वप्रसिद्धत्वाभिप्रायेति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900008276, "chapter_id": 8625, "verse_number": "6.6", "content_sanskrit": "अत एव वाच्यत्वस्य श्रुतत्वादित्यर्थस्येक्षतिसूत्र एव विवक्षितत्वात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900008277, "chapter_id": 8625, "verse_number": "6.7", "content_sanskrit": "अत्राद्यसूत्रेऽनुषक्तेन तदित्यनेन सामानाधिकरण्यायाशब्दमिति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900008278, "chapter_id": 8625, "verse_number": "6.8", "content_sanskrit": "यद्यप्यत्र ‘‘स एतस्मात्’’ इति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900008279, "chapter_id": 8625, "verse_number": "6.9", "content_sanskrit": "न च परेषामिवास्माकमिदमधिकरणं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900008280, "chapter_id": 8625, "verse_number": "6.10", "content_sanskrit": "सूत्रक्रमस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900008281, "chapter_id": 8625, "verse_number": "6.11", "content_sanskrit": "अन्ये तु ‘‘सदेव सोम्येदमग्र आसीत्’’", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900008282, "chapter_id": 8625, "verse_number": "6.12", "content_sanskrit": "तत्र किं विशिष्टस्य परिणामित्वमेतद्वाक्यबोध्यमिति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900008283, "chapter_id": 8625, "verse_number": "6.13", "content_sanskrit": "किञ्चास्मन्मते आनन्दमयस्तत् ब्रह्मैवेत्यादिरूपेण ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900008284, "chapter_id": 8625, "verse_number": "6.14", "content_sanskrit": "किञ्चात्मन ईक्षारूपस्य न स्वरूपेणेक्षितृत्वम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900008285, "chapter_id": 8625, "verse_number": "6.15", "content_sanskrit": "एतेन इदमधिकरणं प्रधानादेर्जडस्य हेतुत्वनिरासकमिति केषाञ्चित्पक्षोप्यपास्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900008286, "chapter_id": 8625, "verse_number": "6.16", "content_sanskrit": "यादवप्रकाशीये तु ‘‘स्वाप्ययात्’’ इत्यस्य ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900008287, "chapter_id": 8625, "verse_number": "6.17", "content_sanskrit": "ननु न विशिष्टमीक्षितृ येन जिज्ञास्यत्वायोगः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]