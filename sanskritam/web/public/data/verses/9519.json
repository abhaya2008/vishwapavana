[{"id": 5000519000, "chapter_id": 9519, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे द्वादशाधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000519001, "chapter_id": 9519, "verse_number": "६-११२-१", "content_sanskrit": "ते रावणवधं दृष्ट्वा देवगन्धर्वदानवाः।\nजग्मुः स्वैः स्वैर्विमानैस्ते कथयन्तः शुभाः कथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000519002, "chapter_id": 9519, "verse_number": "६-११२-२", "content_sanskrit": "रावणस्य वधं घोरं राघवस्य पराक्रमम्।\nसुयुद्धं वानराणां च सुग्रीवस्य च मन्त्रितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000519003, "chapter_id": 9519, "verse_number": "६-११२-३", "content_sanskrit": "अनुरागं च वीर्यं च मारुतेर्लक्ष्मणस्य च।\nपतिव्रतात्वं सीताया हनूमति पराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000519004, "chapter_id": 9519, "verse_number": "६-११२-४", "content_sanskrit": "कथयन्तो महाभागा जग्मुर्हृष्टा यथागतम्।\nराघवस्तु रथं दिव्यमिन्द्रदत्तं शिखिप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000519005, "chapter_id": 9519, "verse_number": "६-११२-५", "content_sanskrit": "अनुज्ञाप्य महाबाहुर्मातलिं प्रत्यपूजयत्।\nराघवेणाभ्यनुज्ञातो मातलिः शक्रसारथिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000519006, "chapter_id": 9519, "verse_number": "६-११२-६", "content_sanskrit": "दिव्यं तं रथमास्थाय दिवमेवोत्पपात ह।\nतस्मिंस्तु दिवमारूढे सरथे रथिनां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000519007, "chapter_id": 9519, "verse_number": "६-११२-७", "content_sanskrit": "राघवः परमप्रीतः सुग्रीवं परिषस्वजे।\nपरिष्वज्य च सुग्रीवं लक्ष्मणेनाभिवादितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000519008, "chapter_id": 9519, "verse_number": "६-११२-८", "content_sanskrit": "पूज्यमानो हरिगणैराजगाम बलालयम्।\nअथोवाच स काकुत्स्थः समीपपरिवर्तिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000519009, "chapter_id": 9519, "verse_number": "६-११२-९", "content_sanskrit": "सौमित्रिं सत्त्वसम्पन्नं लक्ष्मणं दीप्ततेजसम्।\nविभीषणमिमं सौम्य लङ्कायामभिषेचय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000519010, "chapter_id": 9519, "verse_number": "६-११२-१०", "content_sanskrit": "अनुरक्तं च भक्तं च तथा पूर्वोपकारिणम्।\nएष मे परमः कामो यदिमं रावणानुजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000519011, "chapter_id": 9519, "verse_number": "६-११२-११", "content_sanskrit": "लङ्कायां सौम्य पश्येयमभिषिक्तं विभीषणम्।\nएवमुक्तस्तु सौमित्री राघवेण महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000519012, "chapter_id": 9519, "verse_number": "६-११२-१२", "content_sanskrit": "तथेत्युक्त्वा सुसंहृष्टः सौवर्णं घटमाददे।\nतं घटं वानरेन्द्राणां हस्ते दत्त्वा मनोजवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000519013, "chapter_id": 9519, "verse_number": "६-११२-१३", "content_sanskrit": "व्यादिदेश महासत्त्वान् समुद्रसलिलं तदा।\nअतिशीघ्रं ततो गत्वा वानरास्ते मनोजवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000519014, "chapter_id": 9519, "verse_number": "६-११२-१४", "content_sanskrit": "आगतास्तु जलं गृह्य समुद्राद् वानरोत्तमाः।\nततस्त्वेकं घटं गृह्य संस्थाप्य परमासने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000519015, "chapter_id": 9519, "verse_number": "६-११२-१५", "content_sanskrit": "घटेन तेन सौमित्रिरभ्यषिञ्चद् विभीषणम्।\nलङ्कायां रक्षसां मध्ये राजानं रामशासनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000519016, "chapter_id": 9519, "verse_number": "६-११२-१६", "content_sanskrit": "विधिना मन्त्रदृष्टेन सुहृद‍्गणसमावृतम्।\nअभ्यषिञ्चस्तदा सर्वे राक्षसा वानरास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000519017, "chapter_id": 9519, "verse_number": "६-११२-१७", "content_sanskrit": "प्रहर्षमतुलं गत्वा तुष्टुवू राममेव हि।\nतस्यामात्या जहृषिरे भक्ता ये चास्य राक्षसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000519018, "chapter_id": 9519, "verse_number": "६-११२-१८", "content_sanskrit": "दृष्ट्वाभिषिक्तं लङ्कायां राक्षसेन्द्रं विभीषणम्।\nराघवः परमां प्रीतिं जगाम सहलक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000519019, "chapter_id": 9519, "verse_number": "६-११२-१९", "content_sanskrit": "स तद् राज्यं महत् प्राप्य रामदत्तं विभीषणः।\nसान्त्वयित्वा प्रकृतयस्ततो राममुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000519020, "chapter_id": 9519, "verse_number": "६-११२-२०", "content_sanskrit": "दध्यक्षतान् मोदकांश्च लाजाः सुमनसस्तथा।\nआजह्रुरथ संहृष्टाः पौरास्तस्मै निशाचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000519021, "chapter_id": 9519, "verse_number": "६-११२-२१", "content_sanskrit": "स तान् गृहीत्वा दुर्धर्षो राघवाय न्यवेदयत्।\nमङ्गल्यं मङ्गलं सर्वं लक्ष्मणाय च वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000519022, "chapter_id": 9519, "verse_number": "६-११२-२२", "content_sanskrit": "कृतकार्यं समृद्धार्थं दृष्ट्वा रामो विभीषणम्।\nप्रतिजग्राह तत् सर्वं तस्यैव प्रतिकाम्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000519023, "chapter_id": 9519, "verse_number": "६-११२-२३", "content_sanskrit": "ततः शैलोपमं वीरं प्राञ्जलिं प्रणतं स्थितम्।\nउवाचेदं वचो रामो हनूमन्तं प्लवङ्गमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000519024, "chapter_id": 9519, "verse_number": "६-११२-२४", "content_sanskrit": "अनुज्ञाप्य महाराजमिमं सौम्य विभीषणम्।\nप्रविश्य नगरीं लङ्कां कौशलं ब्रूहि मैथिलीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000519025, "chapter_id": 9519, "verse_number": "६-११२-२५", "content_sanskrit": "वैदेह्यै मां च कुशलं सुग्रीवं च सलक्ष्मणम्।\nआचक्ष्व वदतां श्रेष्ठ रावणं च हतं रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000519026, "chapter_id": 9519, "verse_number": "६-११२-२६", "content_sanskrit": "प्रियमेतदिहाख्याहि वैदेह्यास्त्वं हरीश्वर।\nप्रतिगृह्य तु संदेशमुपावर्तितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000519027, "chapter_id": 9519, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे द्वादशाधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]