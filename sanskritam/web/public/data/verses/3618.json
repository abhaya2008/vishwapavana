[{"id": 2122024, "chapter_id": 3618, "verse_number": "", "content_sanskrit": "शिशुपालः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2122025, "chapter_id": 3618, "verse_number": "१", "content_sanskrit": "त्वामहं हंसधर्माणं ये चान्ये वसुधाधिपाः ।\nनिहन्म भीष्म सङ्क्रुद्धाः पक्षिणस्तमिवाण्डजम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2122026, "chapter_id": 3618, "verse_number": "२", "content_sanskrit": "केशवेन कृतं यत्तज्जरासन्धवधे तदा ।\nभीमसेनार्जुनाभ्यां च कस्तत् साध्विति पश्यति ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2122027, "chapter_id": 3618, "verse_number": "३", "content_sanskrit": "अद्वारेण प्रविष्टेन च्छद्मना ब्रह्मवादिना ।\nदृष्टः प्रभावः कृष्णेन जरासन्धस्य धीमतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2122028, "chapter_id": 3618, "verse_number": "४", "content_sanskrit": "येन धर्मात्मनाऽऽत्मानं ब्राह्मण्यमभिजानता ।\nइषितं पाद्यमग्रे तद् दातुमस्मै दुरात्मने ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2122029, "chapter_id": 3618, "verse_number": "५", "content_sanskrit": "भुज्यतामिति तेनोक्ताः कृष्णभीमधनञ्जयाः ।\nजरासन्धेन कौरव्य कृष्णेन विकृतं कृतम् ।\nस चायं जगतः कर्ता यथैनं भीष्म मन्यसे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2122030, "chapter_id": 3618, "verse_number": "६", "content_sanskrit": "स कस्मात् ब्राह्मणं सम्यग् आत्मानमवगच्छति ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2122031, "chapter_id": 3618, "verse_number": "७", "content_sanskrit": "स मे बहुमतो राजा जरासन्धो महाबलः ।\nयोऽनेन युद्धं नेयेष गोपाल इति संयुगे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2122032, "chapter_id": 3618, "verse_number": "८", "content_sanskrit": "इदं चाश्चर्यभूतं मे यदीमे पाण्डवास्त्वया ।\nअपकृष्टाः सतां मार्गान्मन्यन्ते तच्च साध्विति ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2122033, "chapter_id": 3618, "verse_number": "९", "content_sanskrit": "अथवा नैतदाश्चर्यं येषां त्वमसि भारत ।\nस्त्रीसधर्माऽपविद्धश्च सर्वार्थानां प्रदर्शकः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2122034, "chapter_id": 3618, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2122035, "chapter_id": 3618, "verse_number": "१०", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा रूक्षाद् रूक्षतरं बहु ।\nचुकोप बलिनां श्रेष्ठो भीमसेनः प्रतापवान् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2122036, "chapter_id": 3618, "verse_number": "११", "content_sanskrit": "तस्य पद्मप्रतीकाशे स्वभावायतविस्तृते ।\nभूयः कोपात् सुसंरक्ते सम्बभूवतुरक्षिणी ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2122037, "chapter_id": 3618, "verse_number": "१२", "content_sanskrit": "त्रिशिखां भ्रुकुटीं चास्य ददृशुः सर्वपार्थिवाः ।\nललाटस्थां त्रिकूटस्थां गङ्गां त्रिपथगामिव ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2122038, "chapter_id": 3618, "verse_number": "१३", "content_sanskrit": "दन्तान् सन्दशतश्चास्य कोपाद् ददृशुराननम् ।\nयुगान्ते सर्वभूतानि कालस्येव दिधक्षतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2122039, "chapter_id": 3618, "verse_number": "१४", "content_sanskrit": "उत्पतन्तं तु वेगेन जग्राहैनं मनस्विनम् ।\nभीष्म एव महाबाहुर्महासेनमिवेश्वरः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2122040, "chapter_id": 3618, "verse_number": "१५", "content_sanskrit": "तस्य भीमस्य भीष्मेण वार्यमाणस्य भारत ।\nगुरोर्बहुविधैर्वाक्यैः क्रोधः प्रशमनं ययौ ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2122041, "chapter_id": 3618, "verse_number": "१६", "content_sanskrit": "नातिचक्राम भीष्मस्य स हि वाक्यमरिन्दमः ।\nसमुद्भूतो घनापाये वेलामिव महोदधिः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2122042, "chapter_id": 3618, "verse_number": "१७", "content_sanskrit": "शिशुपालस्तु सङ्क्रुद्धे भीमसेने परन्तपे ।\nनाकम्पत महावीर्य्यः पौरुषे मतिमास्थितः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2122043, "chapter_id": 3618, "verse_number": "१८", "content_sanskrit": "उत्पतन्नात्मवेगेन पुनः पुनररिन्दमः ।\nन स तं चिन्तयामास सिंहः क्षुद्रमृगं यथा ।\nप्रहसंश्चाब्रवीद् वाक्यं चेदिराजः प्रतापवान् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2122044, "chapter_id": 3618, "verse_number": "१९", "content_sanskrit": "भीमसेनमुवाचेदं भीष्मो मतिमतां वरः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2122045, "chapter_id": 3618, "verse_number": "२०", "content_sanskrit": "नैषा चेदिपतेर्बुद्धिर्यया त्वाऽऽह्वयतेऽच्युतम् ।\nभीमसेन महाबाहो कृष्णस्यैव विनिश्चयः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2122046, "chapter_id": 3618, "verse_number": "२", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि षष्टितमोऽध्यायः ॥६०॥\n॥ शिशुपालवधपर्वणि द्वितीयोऽध्यायः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]