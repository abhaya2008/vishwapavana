[{"id": 2128326, "chapter_id": 3751, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2128327, "chapter_id": 3751, "verse_number": "१", "content_sanskrit": "ततो जगाम कौरव्य सोऽगस्त्यो भिक्षितुं वसु ।\nश्रुतर्वाणं महीपालं यं वेदाभ्यधिकं नृपैः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2128328, "chapter_id": 3751, "verse_number": "२", "content_sanskrit": "स विदित्वा तु नृपतिः कुम्भयोनिमुपागतम् ।\nविषयान्ते सहामात्यः प्रत्यगृह्णात् सुसत्कृतम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2128329, "chapter_id": 3751, "verse_number": "३", "content_sanskrit": "तस्मै चार्घ्यं यथान्यायमानीय पृथिवीपतिः ।\nप्राञ्जलिः प्रणतो भूत्वा पप्रच्छागमनं प्रति\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2128330, "chapter_id": 3751, "verse_number": "", "content_sanskrit": "अगस्त्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2128331, "chapter_id": 3751, "verse_number": "४", "content_sanskrit": "वित्तार्थिनमनुप्राप्तं विद्धि मां पृथिवीपते ।\nयथाशक्त्यविहिंस्यान्यान् संविभागं प्रयच्छ मे\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2128332, "chapter_id": 3751, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2128333, "chapter_id": 3751, "verse_number": "५", "content_sanskrit": "तत आयव्ययौ पूर्णो तस्मै राजा न्यवेदयत् ।\nअतो विद्वन्नुपादत्स्व यदत्राभ्यधिकं वसु\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2128334, "chapter_id": 3751, "verse_number": "६", "content_sanskrit": "तत आयव्ययौ दृष्ट्वा समौ सममतिर्द्विजः ।\nसर्वथा प्राणिनां पीडामुपादानादमन्यत\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2128335, "chapter_id": 3751, "verse_number": "७", "content_sanskrit": "स श्रुतर्वाणमादाय वार्ध्यश्वमगमत् ततः ।\nस च तौ विषयस्यान्ते प्रत्यगृह्णाद् यथाविधि\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2128336, "chapter_id": 3751, "verse_number": "८", "content_sanskrit": "तयोरर्घ्यं च पाद्यं च वार्ध्यश्वः प्रत्यवेदयत् ।\nअनुज्ञाप्य च पप्रच्छ प्रयोजनमुपक्रमे\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2128337, "chapter_id": 3751, "verse_number": "", "content_sanskrit": "अगस्त्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2128338, "chapter_id": 3751, "verse_number": "९", "content_sanskrit": "वित्तकामाविह प्राप्तौ वार्ध्यश्व पृथिवीपते ।\nयथाशक्त्यविहिंस्यान्यान् संविभागं प्रयच्छ नौ\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2128339, "chapter_id": 3751, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2128340, "chapter_id": 3751, "verse_number": "१०", "content_sanskrit": "तत आयव्ययौ पूर्णौ जामाताऽस्य न्यवेदयत् ।\nततो ज्ञात्वा समादत्तां यदत्राप्यतिरिच्यते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2128341, "chapter_id": 3751, "verse_number": "११", "content_sanskrit": "तत आयव्ययौ दृष्ट्वा समौ सममतिर्द्विजः ।\nसर्वथा प्राणिनां पीडामुपादानादमन्यत\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2128342, "chapter_id": 3751, "verse_number": "१२", "content_sanskrit": "पौरुकुत्सं ततो जग्मुः त्रसदस्युं महाधनम् ।\nअगस्त्यश्च श्रुतर्वा च वार्ध्यश्वश्च महीपतिः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2128343, "chapter_id": 3751, "verse_number": "१३", "content_sanskrit": "त्रसदस्युस्तु तान् सर्वान् प्रत्यगृह्णाद् यथाविधि ।\nअभिगम्य महाराज विषयान्ते स चादृतः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2128344, "chapter_id": 3751, "verse_number": "१४", "content_sanskrit": "अर्चयित्वा यथान्यायमैक्ष्वाको राजसत्तमः ।\nसमाश्वस्तांस्ततोऽपृच्छत् प्रयोजनमुपक्रमे\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2128345, "chapter_id": 3751, "verse_number": "", "content_sanskrit": "अगस्त्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2128346, "chapter_id": 3751, "verse_number": "१५", "content_sanskrit": "वित्तकामानिह प्राप्तान् विद्धि नः पृथिवीपते ।\nयथाशक्त्यविहिंस्यान्यान् संविभागं प्रयच्छ नः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2128347, "chapter_id": 3751, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2128348, "chapter_id": 3751, "verse_number": "१६", "content_sanskrit": "तत आयव्ययौ दृष्ट्वा तेषां राजा न्यवेदयत् ।\nततो ज्ञात्वा समादद्ध्वं यदत्र व्यतिरिच्यते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2128349, "chapter_id": 3751, "verse_number": "१७", "content_sanskrit": "तत आयव्ययौ दृष्ट्वा तस्यापि स मुनिस्तदा ।\nसर्वथा प्राणिनां पीडामुपादानादमन्यत\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2128350, "chapter_id": 3751, "verse_number": "१८", "content_sanskrit": "ततः सर्वे समेत्याथ ते नृपास्तं महामुनिम् ।\nइदमूचुर्महाराज समवेक्ष्य परस्परम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2128351, "chapter_id": 3751, "verse_number": "१९", "content_sanskrit": "अयं वै दानवो ब्रह्मन् वसुमानिल्वलो भुवि ।\nतमभिक्रम्य सर्वेऽद्य वयं याचामहे वसु\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2128352, "chapter_id": 3751, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2128353, "chapter_id": 3751, "verse_number": "२०", "content_sanskrit": "तेषां तदासीदुचितमिल्वलस्यार्थभिक्षणम् ।\nततस्ते सहिता राजन्निल्वलं समुपाद्रवन्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2128354, "chapter_id": 3751, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nवनपर्वणि त्रिनवतितमोऽध्यायः ॥९३॥\n॥ तीर्थयात्रापर्वणि एकोनपञ्चाशोऽध्यायः ॥४९॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]