[{"id": 7001411000, "chapter_id": 21411, "verse_number": "६-७-१", "content_sanskrit": "ईश्वर उवाच ।\nस्ववामे चतुरस्रं तु मण्डलं परिकल्पयेत् ।\nओमित्यभ्यर्च्य तस्मिंस्तु शंखमस्त्रोपशोभितम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001411001, "chapter_id": 21411, "verse_number": "६-७-२", "content_sanskrit": "स्थाप्य साधारकं तं तु प्रणवेनार्चयेत्ततः ।\nआपूर्य्य शुद्धतोयेन चन्दनादिसुगंधिना॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001411002, "chapter_id": 21411, "verse_number": "६-७-३", "content_sanskrit": "अभ्यर्च्य गन्धपुष्पाद्यैः प्रणवेन च सप्तधा ।\nअभिमंत्र्य ततस्तस्मिन्धेनुमुद्रां प्रदर्शयेत्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001411003, "chapter_id": 21411, "verse_number": "६-७-४", "content_sanskrit": "शंखमुद्रां च पुरतश्चतुरस्रं प्रकल्पयेत् ।\nतदन्तरेर्द्धचन्द्रं च त्रिकोणं च तदन्तरे॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001411004, "chapter_id": 21411, "verse_number": "६-७-५", "content_sanskrit": "षट्कोणं वृत्तमेवेदं मण्डलं परिकल्पयेत् ।\nअभ्यर्च्य गंधपुष्पाद्यैः प्रणवेनाथ मध्यतः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001411005, "chapter_id": 21411, "verse_number": "६-७-६", "content_sanskrit": "साधारमर्घ्यपात्रं च स्थाप्य गंधादिनार्चयेत् ।\nआपूर्य्य शुद्धतोयेन तस्मिन्पात्रे विनिःक्षिपेत्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001411006, "chapter_id": 21411, "verse_number": "६-७-७", "content_sanskrit": "कुशाग्राण्यक्षताश्चैव यवव्रीहितिलानपि ।\nआज्यसिद्धार्थ पुष्पाणि भसितं च वरानने॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001411007, "chapter_id": 21411, "verse_number": "६-७-८", "content_sanskrit": "सद्योजातादिभिर्मंत्रैः षडंगैः प्रणवेन च ।\nअभ्यर्च्य गंधपुष्पाद्यैरभिमंत्र्य च वर्मणा॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001411008, "chapter_id": 21411, "verse_number": "६-७-९", "content_sanskrit": "अवगुंण्ठ्यास्त्रमंत्रेण संरक्षार्थं प्रदर्शयेत् ।\nधेनुमुद्रां च तेनैव प्रोक्षयेदस्त्रमंत्रतः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001411009, "chapter_id": 21411, "verse_number": "६-७-१०", "content_sanskrit": "स्वात्मानं गंधपुष्पादिपूजोपकरणान्यपि ।\nपद्मस्येशानदिक्पद्मं प्रणवोच्चारपूर्वकम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001411010, "chapter_id": 21411, "verse_number": "६-७-११", "content_sanskrit": "गुर्वासनाय नम इत्यासनं परिकल्पयेत् ।\nगुरोर्मूर्तिं च तत्रैव कल्प येदुपदेशतः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001411011, "chapter_id": 21411, "verse_number": "६-७-१२", "content_sanskrit": "प्रणवं गुं गुरुभ्योन्ते नमः प्रोच्यापि देशिकम् ।\nसमावाह्य ततो ध्यायेद्दक्षिणाभिमुखं स्थितम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001411012, "chapter_id": 21411, "verse_number": "६-७-१३", "content_sanskrit": "सुप्रसन्नमुखं सौम्यं शुद्धस्फटिकनिर्मलम् ।\nवरदाभयहस्तं च द्विनेत्रं शिवविग्रहम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001411013, "chapter_id": 21411, "verse_number": "६-७-१४", "content_sanskrit": "एवं ध्यात्वा यजेद्गन्धपुष्पादिभिरनुक्रमात् ।\nपद्मस्य नैरृते पद्मे गणपत्यासनोपरि॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001411014, "chapter_id": 21411, "verse_number": "६-७-१५", "content_sanskrit": "मूर्तिम्प्रकल्प्य तत्रैव गणानां त्वेति मंत्रतः ।\nसमावाह्य ततो देवं ध्यायेदेका ग्रमानसः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001411015, "chapter_id": 21411, "verse_number": "६-७-१६", "content_sanskrit": "रक्तवर्णं महाकायं सर्वाभरणभूषितम् ।\nपाशांकुशेष्टदशनान्दधानङ्करपङ्कजैः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001411016, "chapter_id": 21411, "verse_number": "६-७-१७", "content_sanskrit": "गजाननम्प्रभुं सर्वविघ्नौघघ्नमुपासितुः ।\nएवन्ध्यात्वा यजेद्गन्धपुष्पाद्यैरुपचारकैः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001411017, "chapter_id": 21411, "verse_number": "६-७-१८", "content_sanskrit": "कदलीनारिकेलाम्रफललड्डुकपूर्वकम् ।\nनैवेद्यं च समर्प्याथ नमस्कुर्याद्गजाननम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001411018, "chapter_id": 21411, "verse_number": "६-७-१९", "content_sanskrit": "पद्मस्य वायुदिक्पद्मे संकल्प्य स्कान्दमासनम् ।\nस्कन्दमूर्तिम्प्रकल्प्याथ स्कन्दमावाहयेद्बुधः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001411019, "chapter_id": 21411, "verse_number": "६-७-२०", "content_sanskrit": "उच्चार्य्य स्कन्दगायत्रीं ध्यायेदथ कुमारकम् ।\nउद्यदादित्यसंकाशं मयूरवरवाहनम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001411020, "chapter_id": 21411, "verse_number": "६-७-२१", "content_sanskrit": "चतुर्भुजमुदाराङ्गं मुकुटादिविभूषितम् ।\nवरदाभयहस्तं च शक्तिकुक्कुटधारिणम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001411021, "chapter_id": 21411, "verse_number": "६-७-२२", "content_sanskrit": "एवन्ध्यात्वाऽथ गंधाद्यैरुपचारैरनुक्रमात् ।\nसंपूज्य पूर्वद्वारस्य दक्षशाखामुपाश्रितम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001411022, "chapter_id": 21411, "verse_number": "६-७-२३", "content_sanskrit": "अन्तःपुराधिपं साक्षान्नन्दिनं सम्यगर्चयेत् ।\nचामीकराचलप्रख्यं सर्वाभरणभूषितम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001411023, "chapter_id": 21411, "verse_number": "६-७-२४", "content_sanskrit": "बालेन्दुमुकुटं सौम्यं त्रिनेत्रं च चतुर्भुजम् ।\nदीप्तशूलमृगीटंकहेमवेत्रधरं विभुम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001411024, "chapter_id": 21411, "verse_number": "६-७-२५", "content_sanskrit": "चन्द्रबिम्बाभवदनं हरिवक्त्रमथापि वा ।\nउत्तरस्यान्तथा तस्य भार्यां च मरुतां सुताम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001411025, "chapter_id": 21411, "verse_number": "६-७-२६", "content_sanskrit": "सुयशां सुव्रतामम्बापादमण्डनतत्पराम् ।\nसंपूज्य विधिवद्गन्धपुष्पाद्यैरुपचारकैः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001411026, "chapter_id": 21411, "verse_number": "६-७-२७", "content_sanskrit": "ततस्संप्रोक्षयेत्पद्मं सास्त्रशं खोदबिन्दुभिः ।\nकल्पयेदासनं पश्चादाधारादि यथाक्रमात्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001411027, "chapter_id": 21411, "verse_number": "६-७-२८", "content_sanskrit": "आधारशक्तिं कल्याणीं श्यामां ध्यायेदधो भुवि ।\nतस्याः पुरस्तादुत्कंठमनन्तं कुंडलाकृतिम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001411028, "chapter_id": 21411, "verse_number": "६-७-२९", "content_sanskrit": "धवलं पंचफणिनं लेलिहानमिवाम्बरम् ।\nतस्योपर्यासनं भद्रं कंठीरवचतुष्पदम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001411029, "chapter_id": 21411, "verse_number": "६-७-३०", "content_sanskrit": "धर्मो ज्ञानं च वैराग्यमैश्वर्यं च पदानि वै ।\nआग्नेयादिश्वेतपीतरक्तश्यामानि वर्णतः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001411030, "chapter_id": 21411, "verse_number": "६-७-३१", "content_sanskrit": "अधर्मादीनि पूर्वादीन्युत्तरां तान्यनुक्रमात् ।\nराजावर्तमणिप्रख्यान्यस्य गात्राणि भावयेत्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001411031, "chapter_id": 21411, "verse_number": "६-७-३२", "content_sanskrit": "अधोर्द्ध्वच्छदनं पश्चात्कंदं नालं च कण्टकान् ।\nदलादिकं कर्णिकाञ्च विभाव्य क्रमशोऽर्चयेत्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001411032, "chapter_id": 21411, "verse_number": "६-७-३३", "content_sanskrit": "दलेषु सिद्धयश्चाष्टौ केसरेषु च शक्तिकाः ।\nरुद्रा वामादयस्त्वष्टौ पूर्वादिपरितः क्रमात्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001411033, "chapter_id": 21411, "verse_number": "६-७-३४", "content_sanskrit": "कर्णिकायां च वैराग्यं बीजेषु नव शक्तयः ।\nवामाद्या एव पूर्वादि तदन्तश्च मनोन्मनी॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001411034, "chapter_id": 21411, "verse_number": "६-७-३५", "content_sanskrit": "कन्दे शिवात्मको धर्मो नाले ज्ञानं शिवाश्रयम् ।\nकर्णिकोपरि वाह्नेयं मंडलं सौरमैन्दवम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001411035, "chapter_id": 21411, "verse_number": "६-७-३६", "content_sanskrit": "आत्मविद्या शिवाख्यं च तत्त्वत्रयमतः परम् ।\nसर्वासनोपरि सुखं विचित्रकुसुमोज्ज्वलम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001411036, "chapter_id": 21411, "verse_number": "६-७-३७", "content_sanskrit": "परव्योमावकाशाख्यं विद्ययातीव भास्वरम् ।\nपरिकल्प्यासनं मूर्त्तेः पुष्पविन्यास पूर्वकम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001411037, "chapter_id": 21411, "verse_number": "६-७-३८", "content_sanskrit": "आधारशक्तिमारभ्य शुद्धविद्यासनावधि ।\nओंकारादिचतुर्थ्यंतं नाममन्त्रं नमोन्तकम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001411038, "chapter_id": 21411, "verse_number": "६-७-३९", "content_sanskrit": "उच्चार्य पूजयेद्विद्वान्सर्वत्रैवं विधिक्रमः ।\nअङ्गवक्त्रकलाभेदात्पंचब्रह्माणि पूर्ववत्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001411039, "chapter_id": 21411, "verse_number": "६-७-४०", "content_sanskrit": "विन्यसेत्क्रमशो मूर्त्तौ तत्तन्मुद्राविचक्षणः ।\nआवाहयेत्ततो देवं पुष्पाञ्जलिपुटस्थितः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001411040, "chapter_id": 21411, "verse_number": "६-७-४१", "content_sanskrit": "सद्योजातम्प्रपद्यामीत्यारभ्योमन्तमुच्चरन् ।\nआधारोत्थितनादं तु द्वादशग्रन्धिभेदतः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001411041, "chapter_id": 21411, "verse_number": "६-७-४२", "content_sanskrit": "ब्रह्मरन्धांतमुच्चार्य ध्यायेदोंकारगोचरम् ।\nशुद्धस्फटिकसंकाशं देवं निष्कलमक्षरम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001411042, "chapter_id": 21411, "verse_number": "६-७-४३", "content_sanskrit": "कारणं सर्वलोकानां सर्वलोकमयं परम् ।\nअन्तर्बहिः स्थितं व्याप्य ह्यणोरल्पं महत्तमम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001411043, "chapter_id": 21411, "verse_number": "६-७-४४", "content_sanskrit": "भक्तानामप्रयत्नेन दृश्यमीश्वरमव्ययम् ।\nब्रह्मेन्द्रविष्णुरुद्राद्यैरपि देवैरगोचरम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001411044, "chapter_id": 21411, "verse_number": "६-७-४५", "content_sanskrit": "वेदसारञ्च विद्वद्भिरगोचरमिति श्रुतम् ।\nआविर्मध्यान्तरहितं भेषजं भवरोगिणाम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001411045, "chapter_id": 21411, "verse_number": "६-७-४६", "content_sanskrit": "समाहितेन मनसा ध्यात्वैवं परमेश्वरम् ।\nआवाहनं स्थापनं च सन्निरोधं निरीक्षणम्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001411046, "chapter_id": 21411, "verse_number": "६-७-४७", "content_sanskrit": "नमस्कारं च कुर्वीत बध्वा मुद्राः पृथक्पृथक् ।\nध्यायेत्सदाशिवं साक्षाद्देवं सकलनिष्कलम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001411047, "chapter_id": 21411, "verse_number": "६-७-४८", "content_sanskrit": "शुद्धस्फटिकसंकाशं प्रसन्नं शीतलद्युतिम् ।\nविद्युद्वलयसंकाशं जटामुकुटभूषितम्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001411048, "chapter_id": 21411, "verse_number": "६-७-४९", "content_sanskrit": "शार्दूलचर्मवसनं किंचित्स्मितमुखाम्बुजम् ।\nरक्तपद्मदलप्रख्यपाणिपादतलाधरम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001411049, "chapter_id": 21411, "verse_number": "६-७-५०", "content_sanskrit": "सर्वलक्षणसम्पन्नं सर्वाभरणभूषितम् ।\nदिव्या युधकरैर्युक्तं दिव्यगन्धानुलेपनम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001411050, "chapter_id": 21411, "verse_number": "६-७-५१", "content_sanskrit": "पञ्चवक्त्रन्दशभुजञ्चन्द्रखण्डशिखामणिम् ।\nअस्य पूर्वमुखं सौम्यं बालार्कसदृशप्रभम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001411051, "chapter_id": 21411, "verse_number": "६-७-५२", "content_sanskrit": "त्रिलोचनारविन्दाढ्यं बालेन्दुकृतशेखरम् ।\nदक्षिणं नीलजीमूतसमानरुचिरप्रभम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001411052, "chapter_id": 21411, "verse_number": "६-७-५३", "content_sanskrit": "भ्रुकुटीकुटिलं घोरं रक्तवृत्तत्रिलोचनम् ।\nदंष्ट्रा करालं दुष्प्रेक्ष्यं स्फुरिताधरपल्लवम्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001411053, "chapter_id": 21411, "verse_number": "६-७-५४", "content_sanskrit": "उत्तरं विद्रुमप्रख्यं नीलालकविभूषितम् ।\nसद्विलासन्त्रिनयनं चन्द्रार्द्धकृतशेखरम्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001411054, "chapter_id": 21411, "verse_number": "६-७-५५", "content_sanskrit": "पश्चिमम्पूर्णचन्द्राभं लोचनत्रितयोज्ज्वलम् ।\nचन्द्रलेखाधरं सौम्यं मन्दस्मितमनोहरम्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001411055, "chapter_id": 21411, "verse_number": "६-७-५६", "content_sanskrit": "पञ्चमं स्फटिकप्रख्यमिन्दुरेखासमुज्ज्वलम् ।\nअतीवसौम्यमुत्फुल्ललोचनत्रितयोज्ज्वलम्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001411056, "chapter_id": 21411, "verse_number": "६-७-५७", "content_sanskrit": "दक्षिणे शूलपरशुवज्रखड्गानलोज्ज्वलम्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001411057, "chapter_id": 21411, "verse_number": "६-७-५८", "content_sanskrit": "पूर्व्वे पिनाकनाराचघण्टा पाशांकुशोज्ज्वलम् ।\nनिवृत्त्याजानुपर्य्यंतमानाभि च प्रतिष्ठया॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001411058, "chapter_id": 21411, "verse_number": "६-७-५९", "content_sanskrit": "आकण्ठं विद्यया तद्वदाललाटं तु शान्तया ।\nतदूर्ध्वं शान्त्यतीताख्यकलया परया तथा॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001411059, "chapter_id": 21411, "verse_number": "६-७-६०", "content_sanskrit": "पञ्चाध्वव्यापिनं तस्मात्कलापञ्चकविग्रहम् ।\nईशानमुकुटं देवम्पुरुषाख्यम्पुरातनम्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001411060, "chapter_id": 21411, "verse_number": "६-७-६१", "content_sanskrit": "अघोरहृदयं तद्वद्वामगुह्यं महेश्वरम् ।\nसद्योजातं च तन्मूर्तिमष्टत्रिंशत्कलामयम्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001411061, "chapter_id": 21411, "verse_number": "६-७-६२", "content_sanskrit": "मातृकामयमीशानम्पञ्चब्रह्ममयन्तथा ।\nओंकाराख्यमयं चैव हंसन्यासमयन्तथा॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001411062, "chapter_id": 21411, "verse_number": "६-७-६३", "content_sanskrit": "पञ्चाक्षरमयन्देवं षडक्षरमयन्तथा ।\nअङ्गषट्कमयञ्चैव जातिषट्कसमन्वितम्॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001411063, "chapter_id": 21411, "verse_number": "६-७-६४", "content_sanskrit": "एवन्ध्यात्वाथ मद्वामभागे त्वां च मनोन्मनीम् ।\nगौरी मिमाय मन्त्रेण प्रणवाद्येन भक्तितः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001411064, "chapter_id": 21411, "verse_number": "६-७-६५", "content_sanskrit": "आवाह्य पूर्ववत्कुर्यान्नमस्कारांतमी श्वरि ।\nध्यायेत्ततस्त्वां देवेशि समाहितमना मुनिः॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001411065, "chapter_id": 21411, "verse_number": "६-७-६६", "content_sanskrit": "प्रफुल्लोत्पलपत्राभां विस्तीर्णायतलोचनाम् ।\nपूर्णचन्द्राभवदनान्नील कुंचितमूर्द्धजाम्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001411066, "chapter_id": 21411, "verse_number": "६-७-६७", "content_sanskrit": "नीलोत्पलदलप्रख्याञ्चन्द्रार्धकृतशेखराम् ।\nअतिवृत्तघनोत्तुंगस्निग्धपीनपयोधराम्॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001411067, "chapter_id": 21411, "verse_number": "६-७-६८", "content_sanskrit": "तनुमध्याम्पृथुश्रोणीम्पीतसूक्ष्मतराम्बराम् ।\nसर्वाभरणसम्पन्नां ललाटतिलकोज्ज्वलाम्॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001411068, "chapter_id": 21411, "verse_number": "६-७-६९", "content_sanskrit": "विचित्रपुष्पसंकीर्णकेशपाशोपशोभिताम् ।\nसर्वतोऽनुगुणाकारां किंचिल्लज्जानताननाम्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001411069, "chapter_id": 21411, "verse_number": "६-७-७०", "content_sanskrit": "हेमारविन्दं विलसद्दधानां दक्षिणे करे ।\nचण्डवच्चामरं हस्तं न्यस्यासीनां सुखासने॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001411070, "chapter_id": 21411, "verse_number": "६-७-७१", "content_sanskrit": "एवम्मान्त्वां च देवेशि ध्यात्वा नियतमानसः ।\nस्नापयेच्छंखतोयेन प्रणवप्रोक्षणक्रमात्॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001411071, "chapter_id": 21411, "verse_number": "६-७-७२", "content_sanskrit": "भवे भवे नातिभव इति पाद्यम्प्रकल्पयेत् ।\nवामाय नम इत्युक्त्वा दद्यादाचमनीयकम्॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001411072, "chapter_id": 21411, "verse_number": "६-७-७३", "content_sanskrit": "ज्येष्ठाय नम इत्युक्त्वा शुभ्रवस्त्रम्प्रकल्पयेत् ।\nश्रेष्ठाय नम इत्युक्त्वा दद्याद्यज्ञोपवीतकम्॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001411073, "chapter_id": 21411, "verse_number": "६-७-७४", "content_sanskrit": "रुद्राय नम इत्युक्त्वा पुनराचमनीयकम् ।\nकालाय नम इत्युक्त्वा गन्धन्दद्यात्सुसंस्कृतम्॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001411074, "chapter_id": 21411, "verse_number": "६-७-७५", "content_sanskrit": "कलाविकरणाय नमोऽक्षतं च परिकल्पयेत् ।\nबलविकरणाय नम इति पुष्पाणि दापयेत्॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001411075, "chapter_id": 21411, "verse_number": "६-७-७६", "content_sanskrit": "बलाय नम इत्युक्त्वा धूपन्दद्यात्प्र यत्नतः ।\nबलप्रमथनायेति सुदीपं चैव दापयेत्॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001411076, "chapter_id": 21411, "verse_number": "६-७-७७", "content_sanskrit": "ब्रह्मभिश्च षडंगैश्च ततो मातृकया सह ।\nप्रणवेन शिवेनैव शक्तियुक्तेन च क्रमात्॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001411077, "chapter_id": 21411, "verse_number": "६-७-७८", "content_sanskrit": "मुद्राः प्रदर्शयेन्मह्यन्तुभ्यञ्च वरवर्णिनि ।\nमयि प्रकल्पयेत्पूर्वमुपचारांस्ततस्त्वयि॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001411078, "chapter_id": 21411, "verse_number": "६-७-७९", "content_sanskrit": "यदा त्वयि प्रकुर्वीत स्त्रीलिंगं योजयेत्तदा ।\nइयानेव हि भेदोऽस्ति नान्यः पार्वति कश्चन॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001411079, "chapter_id": 21411, "verse_number": "६-७-८०", "content_sanskrit": "एवन्ध्यानम्पूजनं च कृत्वा सम्यग्विधानतः ।\nममावरणपूजां च प्रारभेत विचक्षणः॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}]