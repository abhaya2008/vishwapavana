[{"id": 6000138000, "chapter_id": 10138, "verse_number": null, "content_sanskrit": "अथ एकोनविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "topics": [{"text": "पूर्वाध्याये कश्यपेन दित्यै विहितं पुमपत्योत्पादकं वैष्णवव्रतं विस्तरतो ज्ञातुमिच्छुना परीक्षिता पृष्टेन शुकाचार्येण सप्रकारं तत्कथनम्", "range": null}]}, {"id": 6000138001, "chapter_id": 10138, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_019/BhP_06.019.001.m4a", "display_order": 2}, {"id": 6000138002, "chapter_id": 10138, "verse_number": "६-१९-१", "content_sanskrit": "व्रतं पुंसवनं ब्रह्मन् भवता यदुदीरितम्।\nतस्य वेदितुमिच्छामो येन विष्णुः प्रसीदति॥ ६/१९/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_019/BhP_06.019.002.m4a", "display_order": 3}, {"id": 6000138003, "chapter_id": 10138, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_019/BhP_06.019.003.m4a", "display_order": 4}, {"id": 6000138004, "chapter_id": 10138, "verse_number": "६-१९-२", "content_sanskrit": "शुक्ले मार्गशिरे पक्षे योषिद् भर्तुरनुज्ञया।\nआरभेत व्रतमिदं सार्वकामिकमादितः॥ ६/१९/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_019/BhP_06.019.004.m4a", "display_order": 5}, {"id": 6000138005, "chapter_id": 10138, "verse_number": "६-१९-३", "content_sanskrit": "निशम्य मरुतां जन्म ब्राह्मणाननुमन्त्र्य च।\nस्नात्वा शुक्लदती शुक्ले वसीतालङ्कृताम्बरे॥ ६/१९/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_019/BhP_06.019.005.m4a", "display_order": 6}, {"id": 6000138006, "chapter_id": 10138, "verse_number": "६-१९-४", "content_sanskrit": "पूजयेत् प्रातराशात् प्राक् भगवन्तं श्रिया सह। उपचारैः षोडशभिरुपतिष्ठेत मन्त्रतः।\nनमस्ते निरपेक्षाय पूर्णकाम नमोऽस्तु ते। महाविभूतिपतये नमः सकलसिद्धये॥ ६/१९/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_019/BhP_06.019.006.m4a", "display_order": 7}, {"id": 6000138007, "chapter_id": 10138, "verse_number": "६-१९-५", "content_sanskrit": "यतस्त्वं कृपया भूत्या तेजसा महतौजसा।\nजुष्ट ईश गुणैः सर्वैः स्तुतोऽसि भगवान् विभुः॥ ६/१९/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_019/BhP_06.019.007.m4a", "display_order": 8}, {"id": 6000138008, "chapter_id": 10138, "verse_number": "६-१९-६", "content_sanskrit": "विष्णुपत्नि महामाये महापुरुषलक्षणे।\nप्रीयेथा मे महाभागे लोकमातर्नमोऽस्तु ते॥ ६/१९/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_019/BhP_06.019.008.m4a", "display_order": 9}, {"id": 6000138009, "chapter_id": 10138, "verse_number": "६-१९-७", "content_sanskrit": "ओं नमो भगवते महापुरुषाय महानुभावाय महाविभूतिपतये सह महाविभूतिभिः बलिमुपाहरामि इति।\nअनेनाहरहर्मन्त्रेण विष्णोरावाहन-अर्घ्य-पाद्योपस्पर्शन-स्नान-वास-उपवीत-भूषण-गन्ध-पुष्प-धूप-दीपोपहाराद्युपचारांश्च समाहित उपाहरेत्॥ ६/१९/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_019/BhP_06.019.009.m4a", "display_order": 10}, {"id": 6000138010, "chapter_id": 10138, "verse_number": "६-१९-८", "content_sanskrit": "हविश्शेषं तु जुहुयादनले द्वादशाहुतीः।\nओं नमो भगवते महापुरुषाय महाविभूतिपतये स्वाहेति।\nश्रियं विष्णुं च वरदावाशिषां प्रभवावुभौ।\nभक्‍त्या संपूजयेन्नित्यं यदीच्छेत् सर्वसम्पदः॥ ६/१९/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_019/BhP_06.019.010.m4a", "display_order": 11}, {"id": 6000138011, "chapter_id": 10138, "verse_number": "६-१९-९", "content_sanskrit": "प्रणमेद् दण्डवद् भूमौ भक्तिप्रह्वेण चेतसा।\nदशवारं जपेन्मन्त्रं ततः स्तोत्रमुदीरयेत्॥ ६/१९/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_019/BhP_06.019.011.m4a", "display_order": 12}, {"id": 6000138012, "chapter_id": 10138, "verse_number": "६-१९-१०", "content_sanskrit": "युवां तु विश्वस्य विभू जगतः कारणं परम्।\nइयं हि प्रकृतिः सूक्ष्मा मायाशक्तिर्दुरत्यया॥ ६/१९/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_019/BhP_06.019.012.m4a", "display_order": 13}, {"id": 6000138013, "chapter_id": 10138, "verse_number": "६-१९-११", "content_sanskrit": "तस्या अधीश्वरः साक्षात् त्वमेकः पुरुषः परः।\nत्वं सर्वयज्ञ इज्येयं क्रियेयं फलभुग् भवान्॥ ६/१९/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_019/BhP_06.019.013.m4a", "display_order": 14}, {"id": 6000138014, "chapter_id": 10138, "verse_number": "६-१९-१२", "content_sanskrit": "गुणव्यक्तिरियं देवी व्यञ्जको गुणभुग् भवान्।\nत्वं हि सर्वशरीरात्मा श्रीः शरीरेन्द्रियाशया॥ ६/१९/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_019/BhP_06.019.014.m4a", "display_order": 15}, {"id": 6000138015, "chapter_id": 10138, "verse_number": "६-१९-१३", "content_sanskrit": "नामरूपे भगवती प्रत्ययस्त्वमपाश्रयः। यथा युवां त्रिलोकस्य वरदौ परमेष्ठिनौ।\nतथेमा उत्तमश्लोक सन्तु सत्या महाशिषः॥ ६/१९/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_019/BhP_06.019.015.m4a", "display_order": 16}, {"id": 6000138016, "chapter_id": 10138, "verse_number": "६-१९-१४", "content_sanskrit": "इत्यभिष्टूय वरदं श्रीनिवासं श्रिया सह।\nतन्निस्सार्योपहरणं दत्त्वाऽऽचमनमर्चयेत्॥ ६/१९/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_019/BhP_06.019.016.m4a", "display_order": 17}, {"id": 6000138017, "chapter_id": 10138, "verse_number": "६-१९-१५", "content_sanskrit": "ततः स्तुवाना स्तोत्रेण भक्तिप्रह्वेण चेतसा।\nयज्ञोच्छिष्टमवघ्राय पुनरभ्यर्चयेद्धरिम्॥ ६/१९/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_019/BhP_06.019.017.m4a", "display_order": 18}, {"id": 6000138018, "chapter_id": 10138, "verse_number": "६-१९-१६", "content_sanskrit": "पतिं च परया भक्त्या महापुरुषचेतसा।\nप्रियैस्तैस्तैरुपनमेत् प्रेमशीलः स्वयं पतिः॥ ६/१९/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_019/BhP_06.019.018.m4a", "display_order": 19}, {"id": 6000138019, "chapter_id": 10138, "verse_number": "६-१९-१७", "content_sanskrit": "बिभृयात् सर्वकर्माणि पत्न्या उच्चावचानि च।\nकृतमेकतरेणापि दम्पत्योरुभयोरपि॥ ६/१९/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_019/BhP_06.019.019.m4a", "display_order": 20}, {"id": 6000138020, "chapter_id": 10138, "verse_number": "६-१९-१८", "content_sanskrit": "पत्न्यां कुर्यादनर्हायां पतिरेव समाहितः।\nविष्णोर्व्रतमिदं बिभ्रन्न विहन्यात् कथञ्चन॥ ६/१९/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_019/BhP_06.019.020.m4a", "display_order": 21}, {"id": 6000138021, "chapter_id": 10138, "verse_number": "६-१९-१९", "content_sanskrit": "विप्रान् स्‍त्रियो वरवतीः स्रग्गन्धबलिमण्डनैः।\nअर्चेदहरहर्भक्त्या देवं नियममास्थिता॥ ६/१९/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_019/BhP_06.019.021.m4a", "display_order": 22}, {"id": 6000138022, "chapter_id": 10138, "verse_number": "६-१९-२०", "content_sanskrit": "उद्वास्य देवं स्वे धाम्नि तन्निवेदितमग्रतः।\nअद्यादात्मविशुध्यर्थं सर्वकामाप्तये तथा॥ ६/१९/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_019/BhP_06.019.022.m4a", "display_order": 23}, {"id": 6000138023, "chapter_id": 10138, "verse_number": "६-१९-२१", "content_sanskrit": "एतेन पूजाविधिना मासान् द्वादश हायनम्।\nनीत्वा चोपरमेत् साध्वी कार्तिके चरमेऽहनि॥ ६/१९/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_019/BhP_06.019.023.m4a", "display_order": 24}, {"id": 6000138024, "chapter_id": 10138, "verse_number": "६-१९-२२", "content_sanskrit": "श्वो भूतेऽप उपस्पृश्य कृष्णमभ्यर्च्य पूर्ववत्। पयःशृृतेन जुहुयाच्चरुणा सह सर्पिषा।\nपाकयज्ञविधानेन द्वादशैवाहुतीः पतिः॥ ६/१९/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_019/BhP_06.019.024.m4a", "display_order": 25}, {"id": 6000138025, "chapter_id": 10138, "verse_number": "६-१९-२३", "content_sanskrit": "ब्राह्मणान् भोजयेद् भक्त्या त्वन्नाद्यैर्द्वादशात्मवित्।\nतेभ्यो दद्यात्तिलान् राजन् सोदपात्रानिडान्वितान्॥ ६/१९/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_019/BhP_06.019.025.m4a", "display_order": 26}, {"id": 6000138026, "chapter_id": 10138, "verse_number": "६-१९-२४", "content_sanskrit": "आशिषः शिरसाऽऽदाय द्विजैः प्रीतैः समीरिताः।\nप्रणम्य शिरसा भक्त्या भुञ्जीत तदनुज्ञया॥ ६/१९/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_019/BhP_06.019.026.m4a", "display_order": 27}, {"id": 6000138027, "chapter_id": 10138, "verse_number": "६-१९-२५", "content_sanskrit": "आचार्यमग्रतः कृत्वा वाग्यतः सुसमाहितः।\nदद्यात् पत्न्यै चरोः शेषं सुप्रजास्त्वं सुसौभगम्॥ ६/१९/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_019/BhP_06.019.027.m4a", "display_order": 28}, {"id": 6000138028, "chapter_id": 10138, "verse_number": "६-१९-२६", "content_sanskrit": "एतच्चरित्वा विधिवद् व्रतं विभोरभीप्सितार्थं लभते पुमानिह।\nस्‍त्रीर्वा तदास्थाय लभेत सौभगं श्रियं प्रजां जीवपतिं यशो गृहान्॥ ६/१९/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_019/BhP_06.019.028.m4a", "display_order": 29}, {"id": 6000138029, "chapter_id": 10138, "verse_number": "६-१९-२७", "content_sanskrit": "कन्याऽपि विन्देत समग्रलक्षणं पतिं त्ववीरा हतकिल्बिषा गतिम्।\nमृतप्रजा जीवसुतान् धनेश्वरी सुदुर्भगा सुभगा रूपमग्र्यम्॥ ६/१९/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_019/BhP_06.019.029.m4a", "display_order": 30}, {"id": 6000138030, "chapter_id": 10138, "verse_number": "६-१९-२८", "content_sanskrit": "विन्देद् विरूपा विरुजो विमुच्यते य आमयावीन्द्रियदेहकल्पः।\nएतत् पठन्नभ्युदये च कर्मण्यनन्ततृप्तिं पितृदेवतानाम्॥ ६/१९/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_019/BhP_06.019.030.m4a", "display_order": 31}, {"id": 6000138031, "chapter_id": 10138, "verse_number": "६-१९-२९", "content_sanskrit": "तुष्टाः प्रयच्छन्ति समस्तकामान् होमावसाने हुतभुक् श्रीहरिश्च।\nराजन् महन्मरुतां जन्म पुण्यं दितेर्व्रतं चाभिहितं महत् ते॥ ६/१९/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_019/BhP_06.019.031.m4a", "display_order": 32}, {"id": 6000138032, "chapter_id": 10138, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां षष्ठस्कन्धे एकोनविंशाध्यायः॥\n॥समाप्तोऽयं षष्ठः स्कन्धः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]