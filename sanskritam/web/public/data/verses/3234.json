[{"id": 2103003, "chapter_id": 3234, "verse_number": "१४-९०-१", "content_sanskrit": "वैशम्पायन उवाच।\nश्रपयित्वा पशूनन्यान्विधिवद्द्विजसत्तमाः।\nतं तुरङ्गं यथाशास्त्रमालभन्त द्विजातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2103004, "chapter_id": 3234, "verse_number": "१४-९०-२", "content_sanskrit": "ततः संज्ञप्य तुरगंक विधिवद्याजकर्षभाः।\nउपसंवेशयांचक्रुस्ततस्तां द्रुपदात्मजाम्।\nकलाभिस्तिसृभी राजन्यथाविधि मनस्विनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2103005, "chapter_id": 3234, "verse_number": "१४-९०-३", "content_sanskrit": "उद्धृत्य तु वपां तस्य यथाशास्त्रं द्विजातयः।\nश्रपयामासुरव्यग्रा विधिवद्भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2103006, "chapter_id": 3234, "verse_number": "१४-९०-४", "content_sanskrit": "तं वपाधूमगन्धं तु धर्मराजः सहानुजैः।\nउपाजिघ्रद्यथासास्त्रं सर्वपापापहं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2103007, "chapter_id": 3234, "verse_number": "१४-९०-५", "content_sanskrit": "शिष्टान्यङ्गानि यान्यासंस्तस्याश्वस्य नराधिप।\nतान्यग्रौ जुहुवुर्धीराः समस्ताः षोडशर्त्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2103008, "chapter_id": 3234, "verse_number": "१४-९०-६", "content_sanskrit": "संस्थाप्यैवं तस्य राज्ञस्तं यज्ञं शक्रतेजसः।\nव्यासः सशिष्यो भगवान्वर्धयामास तं नृपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2103009, "chapter_id": 3234, "verse_number": "१४-९०-७", "content_sanskrit": "ततो युधिष्ठिरः प्रादात्सदस्येभ्यो यथाविधि।\nकोटीः सहस्रं निष्काणां व्यासाय तु वसुंधराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2103010, "chapter_id": 3234, "verse_number": "१४-९०-८", "content_sanskrit": "प्रतिगृह्य धरां राजन्व्यासः सत्यवतीसुतः।\nअब्रवीद्भरतश्रेष्ठं धर्मराजं युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2103011, "chapter_id": 3234, "verse_number": "१४-९०-९", "content_sanskrit": "वसुधा भवतस्त्वेषां संन्यस्ता राजसत्तम।\nनिष्क्रयो दीयतां मह्यं ब्राह्मणा हि धनार्थिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2103012, "chapter_id": 3234, "verse_number": "१४-९०-१०", "content_sanskrit": "युधिष्ठिरस्तु तान्विप्रान्प्रत्युवाच महामनाः।\nभ्रातृभिः सहितो धीमान्मध्ये राज्ञां महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2103013, "chapter_id": 3234, "verse_number": "१४-९०-११", "content_sanskrit": "अश्वमेधे महायज्ञे पृथिवी दक्षिणा स्मृता।\nअर्जुनेन जिता चेयमृत्विग्भ्यः प्रापिता मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2103014, "chapter_id": 3234, "verse_number": "१४-९०-१२", "content_sanskrit": "वनं प्रवेक्ष्ये विप्राग्र्या विभजध्वं महीमिमाम्।\nचतुर्धा पृथिवीं कृत्वा चातुर्होत्रप्रमाणतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2103015, "chapter_id": 3234, "verse_number": "१४-९०-१३", "content_sanskrit": "नाहमादातुमिच्छामि ब्रह्मस्वं द्विजसत्तमाः॥\nइदं नित्यं मनो विप्रा भ्रातॄणां चैव मे सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2103016, "chapter_id": 3234, "verse_number": "१४-९०-१४", "content_sanskrit": "इत्युक्तवति तस्मिंस्तु भ्रातरो द्रौपदी च सा।\nएवमेतदिति प्राहुस्तदभूद्रोमहर्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2103017, "chapter_id": 3234, "verse_number": "१४-९०-१५", "content_sanskrit": "ततोऽन्तरिक्षे वागासीत्साधुसाध्विति भारत।\nतथैव द्विजसङ्घानां शंसतां विबभौ स्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2103018, "chapter_id": 3234, "verse_number": "१४-९०-१६", "content_sanskrit": "द्वैपायनस्तथा कृष्णः पुनरेव युधिष्ठिरम्।\nप्रोवाच मध्ये विप्राणामिदं सम्पूजयन्मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2103019, "chapter_id": 3234, "verse_number": "१४-९०-१७", "content_sanskrit": "दत्तैषा भवता मह्यं तां ते प्रतिददाम्यहम्।\nहिरण्यं दीयतामेभ्यो ब्राह्मणेभ्यो धराऽस्तु ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2103020, "chapter_id": 3234, "verse_number": "१४-९०-१८", "content_sanskrit": "ततोऽब्रवीद्वासुदेवो धर्मराजं युधिष्ठिरम्।\nयथाऽऽह भगवान्व्यासस्तथा त्वं कर्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2103021, "chapter_id": 3234, "verse_number": "१४-९०-१९", "content_sanskrit": "इत्युक्तः स कुरुश्रेष्ठः प्रीतात्मा भ्रातृभिः सह।\nकोटिं कोटिं गवां प्रादाद्दक्षिणां त्रिगुणीकृताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2103022, "chapter_id": 3234, "verse_number": "१४-९०-२०", "content_sanskrit": "न करिष्यति तल्लोके कश्चिदन्यो नराधिपः।\nयत्कृतं कुरुराजेन मरुत्तस्यानुकुर्वता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2103023, "chapter_id": 3234, "verse_number": "१४-९०-२१", "content_sanskrit": "प्रतिगृह्य तु तद्द्रव्यं कृष्णद्वैपायनो मुनिः।\nऋत्विग्भ्यः प्रददौ विद्वांश्चतुर्धा व्यभजंश्च ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2103024, "chapter_id": 3234, "verse_number": "१४-९०-२२", "content_sanskrit": "धरण्या निष्क्रयं दत्त्वा तद्धिरण्यं युधिष्ठिरः।\nदूतपापो जितस्वर्गो मुमुदे भ्रातृभिः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2103025, "chapter_id": 3234, "verse_number": "१४-९०-२३", "content_sanskrit": "ऋत्विजस्तमपर्यन्तं सुवर्णनिचयं तथा।\nव्यभजन्त द्विजातिभ्यो यथोत्साहं यथासुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2103026, "chapter_id": 3234, "verse_number": "१४-९०-२४", "content_sanskrit": "यज्ञवाटे च यत्किञ्चिद्धिरण्यं सवि भूषणम्।\nतोरणानि च यूपांश्च घटान्पात्रीस्तथेष्टकाः।\nयुधिष्ठिराभ्यनुज्ञाताः सर्वं तद्व्यभजन्द्विजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2103027, "chapter_id": 3234, "verse_number": "१४-९०-२५", "content_sanskrit": "अनन्तरं द्विजातिभ्यः क्षत्रिया जह्रिरे वसु।\nतथा विट्शूद्रसङ्घाश्च तथाऽन्ये म्लेच्छजातयः।\n`कालेन महता जह्रुस्तत्सुवर्णं ततस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2103028, "chapter_id": 3234, "verse_number": "१४-९०-२६", "content_sanskrit": "ततस्ते ब्राह्मणाः सर्वे मुदिता जग्मुरालयान्।\nतर्पिता वसुना तेन धर्मिराजेन धीमिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2103029, "chapter_id": 3234, "verse_number": "१४-९०-२७", "content_sanskrit": "स्वमंशं भगवान्व्यासः कुन्त्यै पादाभिवादितः।\nप्रददौ तस्य महतो हिरण्यस्य महाद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2103030, "chapter_id": 3234, "verse_number": "१४-९०-२८", "content_sanskrit": "श्वशुरात्प्रीतिदायं तं प्राप्य सा प्रीतमानसा।\nचकार पुण्यकं तेन सुमहत्सङ्घशः पृथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2103031, "chapter_id": 3234, "verse_number": "१४-९०-२९", "content_sanskrit": "गत्वा त्ववभृथं राजा विपाप्मा भ्रातृभिः सह।\nसभाज्यमानः शुशुभे महेन्द्रस्त्रिदशैरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2103032, "chapter_id": 3234, "verse_number": "१४-९०-३०", "content_sanskrit": "पाण़्डवाश्च महीपालैः समेतैरभिसंवृताः।\nअशोभन्त महाराज ग्रहस्तारागणैरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2103033, "chapter_id": 3234, "verse_number": "१४-९०-३१", "content_sanskrit": "राजभ्योपि ततः प्रादाद्रत्नानि विविधानि च।\nगजानश्वानलङ्कारान्त्रियो वासांसि काञ्चनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2103034, "chapter_id": 3234, "verse_number": "१४-९०-३२", "content_sanskrit": "तद्धनौघमपर्यन्तं पार्थः पार्थिवमण्डले।\nविसृजञ्शुशुभे राजन्यथा वैश्रवणस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2103035, "chapter_id": 3234, "verse_number": "१४-९०-३३", "content_sanskrit": "आनीय च तथा वीरं राजानं बभ्रुवाहनम्।\nप्रदाय विपुलं वित्तं गृहात्प्रास्थापयनत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2103036, "chapter_id": 3234, "verse_number": "१४-९०-३४", "content_sanskrit": "दुःशलायाश्च तं पौत्रं बालकं भरतर्षभ।\nस्वराज्येऽथ पितुर्धामान्स्वसुः प्रीत्या न्वयेशयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2103037, "chapter_id": 3234, "verse_number": "१४-९०-३५", "content_sanskrit": "नृपतींश्चैव तान्सर्वान्सुविभक्तान्सुपूजितान्।\nप्रस्थापयामास वशी कुरुराजो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2103038, "chapter_id": 3234, "verse_number": "१४-९०-३६", "content_sanskrit": "गोविन्दं च महात्मानं बलदेवं महाबलम्।\nतथाऽन्यान्वृष्णिवीरांश्च प्रद्युम्नाद्यान्सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2103039, "chapter_id": 3234, "verse_number": "१४-९०-३७", "content_sanskrit": "पूजयित्वा महाराज यथाविधि महाद्युतिः।\nभ्रातृभिः सहितो राजा प्रास्थापरयदरिंदमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2103040, "chapter_id": 3234, "verse_number": "१४-९०-३८", "content_sanskrit": "एवं बभूव यज्ञः स धर्मिराजस्य धीमतः।\nबह्वन्नधनरत्नौघः सुरामैरेयसागरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2103041, "chapter_id": 3234, "verse_number": "१४-९०-३९", "content_sanskrit": "सर्पिःपङ्का ह्रदा यत्र बभूवुश्चान्नपर्वताः।\nरसालकर्दमा नद्यो बभूवुर्भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2103042, "chapter_id": 3234, "verse_number": "१४-९०-४०", "content_sanskrit": "भक्ष्यखाण्डवरागाणां क्रियतां भुज्यतां तथा।\nपशूनां वध्यतां चैव नान्तं ददृशिरे जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2103043, "chapter_id": 3234, "verse_number": "१४-९०-४१", "content_sanskrit": "मत्तप्रमत्तमुदितं सुप्रीतयुवतीजनम्।\nमृदङ्गशङ्खनादैस्च मनोरममभूत्तदा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2103044, "chapter_id": 3234, "verse_number": "१४-९०-४२", "content_sanskrit": "दीयतां भुज्यतां चापि तत्र शब्दो महानभूत्।\nदीयतां दीयतां चेति दिवारात्रमवारितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2103045, "chapter_id": 3234, "verse_number": "१४-९०-४३", "content_sanskrit": "तं महोत्सवसंकाशं हृष्टपुष्टजनाकुलम्।\nकथयन्ति स्म पुरुषा नानादेशनिवासिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2103046, "chapter_id": 3234, "verse_number": "१४-९०-४४", "content_sanskrit": "वर्षित्वा धनधाराभिः कामै रत्नै रसैस्तथा।\nविपाप्मा भरतश्रेष्ठः कृतार्थः प्राविशत्पुरम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2103047, "chapter_id": 3234, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि नवतितमोऽध्यायः॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]