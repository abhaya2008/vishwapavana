[{"id": 2012294, "chapter_id": 1251, "verse_number": "१-२५२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2012295, "chapter_id": 1251, "verse_number": "१-२५२-१", "content_sanskrit": "तौ रथाभ्यां रथश्रेष्ठौ दावस्योभयतः स्थितौ।\nदिक्षु सर्वासु भूतानां चक्राते कदनं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2012296, "chapter_id": 1251, "verse_number": "१-२५२-२", "content_sanskrit": "यत्र यत्र च दृश्यन्ते प्राणिनः खाण्डवालयाः।\nपलायन्तः प्रवीरौ तौ तत्रतत्राभ्यधावताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2012297, "chapter_id": 1251, "verse_number": "१-२५२-३", "content_sanskrit": "छिद्रं न स्म प्रपश्यन्ति रथयोराशुचारिणोः।\nआविद्धावेव दृश्येते रथिनौ तौ रथोत्तमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2012298, "chapter_id": 1251, "verse_number": "१-२५२-४", "content_sanskrit": "खाण्डवे दह्यमाने तु भूतान्यथ सहस्रशः।\nउत्पेतुर्भैरवान्नादान्विनदन्तः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2012299, "chapter_id": 1251, "verse_number": "१-२५२-५", "content_sanskrit": "दग्धैकदेशा बहवो निष्टप्ताश्च तथाऽपरे।\nस्फुटिताक्षा विशीर्णाश्च विप्लुताश्च तथाऽपरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2012300, "chapter_id": 1251, "verse_number": "१-२५२-६", "content_sanskrit": "समालिङ्ग्य सुतानन्ये पितॄन्भ्रातॄनथाऽपरे।\nत्यक्तुं न शेकुः स्नेहेन तत्रैव निधनं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2012301, "chapter_id": 1251, "verse_number": "१-२५२-७", "content_sanskrit": "सन्दष्टदशनाश्चान्ये समुत्पेतुरनेकशः।\nततस्तेऽतीव घूर्णन्तः पुनरग्नौ प्रपेदिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2012302, "chapter_id": 1251, "verse_number": "१-२५२-८", "content_sanskrit": "दग्धपक्षाक्षिचरणा विचेष्टन्तो महीतले।\nतत्रतत्र स्म दृश्यन्ते विनश्यन्तः शरीरिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2012303, "chapter_id": 1251, "verse_number": "१-२५२-९", "content_sanskrit": "जलाशयेषु तप्तेषु क्वाथ्यमानेषु वह्निना।\nगतसत्वाः स्म दृश्यन्ते कूर्ममत्स्याः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2012304, "chapter_id": 1251, "verse_number": "१-२५२-१०", "content_sanskrit": "शरीरैरपरे दीप्तैर्देहवन्त इवाग्नयः।\nअदृश्यन्त वने तत्र प्राणिनः प्राणिसंक्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2012305, "chapter_id": 1251, "verse_number": "१-२५२-११", "content_sanskrit": "कांश्चिदुत्पततः पार्थः शरैः संछिद्य खण्डशः।\nपातयामास विहगान्प्रदीप्ते वसुरेतसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2012306, "chapter_id": 1251, "verse_number": "१-२५२-१२", "content_sanskrit": "ते शराचितसर्वाङ्गा निनदन्तो महारवान्।\nऊर्ध्वमुत्पत्य वेगेन निपेतुः खाण्डवे पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2012307, "chapter_id": 1251, "verse_number": "१-२५२-१३", "content_sanskrit": "शरैरभ्याहतानां च सङ्घशः स्म वनौकसाम्।\nविरावः शुश्रुवे घोरः समुद्रस्येव मथ्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2012308, "chapter_id": 1251, "verse_number": "१-२५२-१४", "content_sanskrit": "वह्नेश्चापि प्रदीप्तस्य खमुत्पेतुर्महार्चिषः।\nजनयामासुरुद्वेगं सुमहान्तं दिवौकसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2012309, "chapter_id": 1251, "verse_number": "१-२५२-१५", "content_sanskrit": "तेनार्चिषा सुसन्तप्ता देवाः सर्षिपुरोगमाः।\nततो जग्मुर्महात्मानः सर्व एव दिवौकसः।\nशतक्रतुं सहस्राक्षं देवेशमसुरार्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2012310, "chapter_id": 1251, "verse_number": "१-२५२-१६x", "content_sanskrit": "देवा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2012311, "chapter_id": 1251, "verse_number": "१-२५२-१६", "content_sanskrit": "किं न्विमे मानवाः सर्वे दह्यन्ते चित्रभानुना।\nकच्चिन्न संक्षयः प्राप्तो लोकानाममरेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2012312, "chapter_id": 1251, "verse_number": "१-२५२-१७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2012313, "chapter_id": 1251, "verse_number": "१-२५२-१७", "content_sanskrit": "तच्छ्रुत्वा वृत्रहा तेभ्यः स्वयमेवान्ववेक्ष्य च।\nखाण्डवस्य विमोक्षार्थं प्रययौ हरिवाहनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2012314, "chapter_id": 1251, "verse_number": "१-२५२-१८", "content_sanskrit": "महता रथबृन्देन नानारूपेण वासवः।\nआकाशं समवाकीर्य प्रववर्ष सुरेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2012315, "chapter_id": 1251, "verse_number": "१-२५२-१९", "content_sanskrit": "ततोऽक्षमात्रा व्यसृजन्धाराः शतसहस्रशः।\nचोदिता देवराजेन जलदाः खाण्डवं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2012316, "chapter_id": 1251, "verse_number": "१-२५२-२०", "content_sanskrit": "असंप्राप्तास्तु ता धारास्तेजसा जातवेदसः।\nख एव समुशुष्यन्त नकाश्चित्पावकं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2012317, "chapter_id": 1251, "verse_number": "१-२५२-२१", "content_sanskrit": "ततो नमुचिहा क्रुद्धो भृशमर्चिष्मतस्तदा।\nपुनरेव महामेघैरम्भांसि व्यसृजद्बहु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2012318, "chapter_id": 1251, "verse_number": "१-२५२-२२", "content_sanskrit": "अर्चिर्धाराभिसंबद्धं धूमविद्युत्समाकुलम्।\nबभूव तद्वनं घोरं स्तनयित्नुसमाकुलम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2012319, "chapter_id": 1251, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि खाण्डवदाहपर्वणि द्विपञ्चाशदधिकद्विशततमोऽध्यायः॥ २५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]