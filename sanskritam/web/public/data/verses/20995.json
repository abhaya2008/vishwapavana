[{"id": 7000995000, "chapter_id": 20995, "verse_number": "४-१-१", "content_sanskrit": "मैत्रेय उवाच।\nभगवन्यन्नरैः कार्य्यं साधुकर्मण्यवस्थितैः ।\nतन्मह्यं गुरुणाख्यातं नित्यनैमित्तिकात्मकम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000995001, "chapter_id": 20995, "verse_number": "४-१-२", "content_sanskrit": "वर्णधर्मास्तथाख्याता धर्मा ये चाश्रमेषु च ।\nश्रोतुमिच्छाम्यहं वंशं राज्ञां तद्ब्रूहि मे गुरो ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000995002, "chapter_id": 20995, "verse_number": "४-१-३", "content_sanskrit": "श्रीपराशर उवाच ।\nमैत्रेय श्रूयतामयमनेकयज्वशूरवीरधीरभूपालालंकृतो ब्रह्मादिर्मानवो वंशः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000995003, "chapter_id": 20995, "verse_number": "४-१-४", "content_sanskrit": "तदस्य वंशस्यानुपूर्वीमश्षोवंशपापप्रणाशनाय मैत्रेयैतां कथां शृणु ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000995004, "chapter_id": 20995, "verse_number": "४-१-५", "content_sanskrit": "तद्यथा सकलजगतामादिरनादिभूतस्स ऋग्यजुस्सामादिमयो भगवान् विष्णुस्तस्य ब्रह्मणो मर्त्तं रूपं हिरण्यगर्भो ब्रह्मांडभूतो ब्रह्मा भगवान् प्राग्बभूव ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000995005, "chapter_id": 20995, "verse_number": "४-१-६", "content_sanskrit": "ब्रह्मणश्च दक्षिणांगुष्ठजन्मा दक्षप्रजापतिः दक्षस्याप्यदितिरदितेर्विवस्वान् विवस्वतो मनुः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000995006, "chapter_id": 20995, "verse_number": "४-१-७", "content_sanskrit": "मनोरिक्ष्वाकुनृगधृष्टशर्यातिनरिष्यंतप्रांशुनाभगदिष्टकरूषपृषध्राख्या दश पुत्रा बभूवुः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000995007, "chapter_id": 20995, "verse_number": "४-१-८", "content_sanskrit": "इष्ठिं च मित्रावरुणयोर्मनुः पुत्रकामश्चकार ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000995008, "chapter_id": 20995, "verse_number": "४-१-९", "content_sanskrit": "तत्र तावदह्नुते होतुरपचारादिला नाम कन्या बभूव ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000995009, "chapter_id": 20995, "verse_number": "४-१-१०", "content_sanskrit": "सैव च मित्रावरुणयोः प्रसादात्सुद्युम्नो नाम मनोः पुत्रो मैत्रेय आसीत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000995010, "chapter_id": 20995, "verse_number": "४-१-११", "content_sanskrit": "पुनश्चेश्वरकोपात्स्त्री सती सा तु सोमसूनोर्बुधस्याश्रमसमीपे बभ्राम ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000995011, "chapter_id": 20995, "verse_number": "४-१-१२", "content_sanskrit": "सानुरागाच्च तस्यां बुधः पुरूरवसमात्मजमुत्पादयामास ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000995012, "chapter_id": 20995, "verse_number": "४-१-१३", "content_sanskrit": "जातेपि तस्मिन्नमिततेजोभिः परमर्षिभिरिष्टिमय ऋङ्मयो यजुर्मयस्साममयोथर्वणमयस्सर्ववेदमयो मनोमयो ज्ञानमयो न किंचिन्मयोन्नमयो भगवान् यज्ञपुरुषस्वरूपी सुद्युम्नस्य पुंस्त्वमभिलषद्भिर्यथावदिष्टस्तत्प्रसादादिला पुनरपि सुद्युम्नोऽभवत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000995013, "chapter_id": 20995, "verse_number": "४-१-१४", "content_sanskrit": "तस्याप्युत्कलगयविनतास्त्रयः पुत्रा बभूवुः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000995014, "chapter_id": 20995, "verse_number": "४-१-१५", "content_sanskrit": "सुद्युम्नस्तु स्त्रीपूर्वकत्वाद्रा ज्यभागं न लेभे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000995015, "chapter_id": 20995, "verse_number": "४-१-१६", "content_sanskrit": "तत्पित्रा तु वसिष्ठवचनात्प्रतिष्ठानं नाम नगरं सुद्युम्नाय दत्तं तच्चासौ पुरूरवसे प्रादात् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000995016, "chapter_id": 20995, "verse_number": "४-१-१७", "content_sanskrit": "तदन्वयाश्च क्षत्त्रियास्सर्वै दिक्ष्वभवन् ।\nपृषध्रस्तु मनुपुत्रो गुरुगोवधाच्छूद्र त्वमगमत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000995017, "chapter_id": 20995, "verse_number": "४-१-१८", "content_sanskrit": "मनोः पुत्रः करूषः करूषात्कारूषाः क्षत्त्रिया महाबलपराक्रमा बभूवः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000995018, "chapter_id": 20995, "verse_number": "४-१-१९", "content_sanskrit": "दिष्टपुत्रस्तु नाभागो वैश्यतामगमत्तस्माद्बलंधनः पुत्रोभवत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000995019, "chapter_id": 20995, "verse_number": "४-१-२०", "content_sanskrit": "बलंधनाद्वत्सप्रीतिरुदारकीर्त्तिः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000995020, "chapter_id": 20995, "verse_number": "४-१-२१", "content_sanskrit": "वत्सप्रीतेः प्रांशुरभवत् ॥२१॥", "padaccheda": "", "anvaya": 