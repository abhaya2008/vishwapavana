ing_english": "", "audio_url": null, "display_order": 54}, {"id": 7000995054, "chapter_id": 20995, "verse_number": "४-१-५५", "content_sanskrit": "ततश्च कृशाश्वो नाम पुत्रोभवत् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000995055, "chapter_id": 20995, "verse_number": "४-१-५६", "content_sanskrit": "सोमदत्तः कृशाश्वाज्जज्ञे योश्वमेधानां शतमाजहार ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000995056, "chapter_id": 20995, "verse_number": "४-१-५७", "content_sanskrit": "तत्पुत्रो जनमेजयः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000995057, "chapter_id": 20995, "verse_number": "४-१-५८", "content_sanskrit": "जनमेजयात्सुमतिः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000995058, "chapter_id": 20995, "verse_number": "४-१-५९", "content_sanskrit": "एते वैशालिका भूभृतः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000995059, "chapter_id": 20995, "verse_number": "४-१-६०", "content_sanskrit": "श्लोकोप्यत्र गीयते ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000995060, "chapter_id": 20995, "verse_number": "४-१-६१", "content_sanskrit": "तृणबिंदोः प्रसादेन सर्वे वैशालिका नृपाः ।\nदीर्घायुषो महात्मानो वीर्यवंतोतिधार्मिकाः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000995061, "chapter_id": 20995, "verse_number": "४-१-६२", "content_sanskrit": "शर्यातेः कन्या सुकन्यानामाभवत् यामुपयेमे च्यवनः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000995062, "chapter_id": 20995, "verse_number": "४-१-६३", "content_sanskrit": "आनर्त्तनामा परमधार्मिकश्शर्यातिपुत्रोभवत् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000995063, "chapter_id": 20995, "verse_number": "४-१-६४", "content_sanskrit": "आनर्त्तृस्यापि रेवतनामा पुत्रो जज्ञे योसावानर्त्तविषयं बुभुजे पुरीं च कुशस्थलीमध्युवास ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000995064, "chapter_id": 20995, "verse_number": "४-१-६५", "content_sanskrit": "रेवतस्यापि रैवतः पुत्रः ककुद्मिनामा धर्मात्मा भ्रोतृशतस्य ज्योष्ठोऽभवत् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000995065, "chapter_id": 20995, "verse_number": "४-१-६६", "content_sanskrit": "तस्य रेवतीनाम कन्याभवत् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000995066, "chapter_id": 20995, "verse_number": "४-१-६७", "content_sanskrit": "स तामादाय कस्योयमर्हतीति भगवंतमब्जयोनिं प्रष्टुं ब्रह्मलोकं जगाम ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000995067, "chapter_id": 20995, "verse_number": "४-१-६८", "content_sanskrit": "तावच्च ब्रह्मणॐतिके हाहाहूहूसंज्ञाभ्यां गंधर्वाभ्यामतितानं नाम दिव्यं गांधर्वमगीयत ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000995068, "chapter_id": 20995, "verse_number": "४-१-६९", "content_sanskrit": "तच्च त्रिमार्गपरिवृत्तैरनेकयुगपरिवृत्तिं तिष्ठन्नपि रैवतश्शृण्वन्मुहूर्त्तमिव मेने ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000995069, "chapter_id": 20995, "verse_number": "४-१-७०", "content_sanskrit": "गीतावसाने च भगवंतमब्जयोनिं प्रणम्य रैवतः कन्यायोग्यं वरमपृच्छत् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000995070, "chapter_id": 20995, "verse_number": "४-१-७१", "content_sanskrit": "ततश्चासौ भगवानकथयत्कथय योभिमतस्ते वर इति ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000995071, "chapter_id": 20995, "verse_number": "४-१-७२", "content_sanskrit": "पुनश्च प्रणम्य भगवते तस्मै यथाभिमतानात्मनस्स वरान् कथयामास ।\nक एषां भगवतोभिमत इति यस्मै कन्यामिमां प्रयच्छामीति ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000995072, "chapter_id": 20995, "verse_number": "४-१-७३", "content_sanskrit": "ततः किंचिदवनतशिरास्सस्मितं भगवानब्जयोनिराह ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000995073, "chapter_id": 20995, "verse_number": "४-१-७४", "content_sanskrit": "य एते भवतोभिमता नैतेषां सांप्रतं पुत्रपौत्रापत्यापत्यसंततिरस्त्यवनीतले ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000995074, "chapter_id": 20995, "verse_number": "४-१-७५", "content_sanskrit": "बहूनि तवात्रैव गांधर्वं शृण्वतश्चतुर्यगान्यतीतानि सांप्रतं ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000995075, "chapter_id": 20995, "verse_number": "४-१-७६", "content_sanskrit": "महीतलेष्टाविंशतितममनोश्चतुर्युगमतीतप्रायं वर्तते ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000995076, "chapter_id": 20995, "verse_number": "४-१-७७", "content_sanskrit": "आसन्नो हि कलिः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000995077, "chapter_id": 20995, "verse_number": "४-१-७८", "content_sanskrit": "अन्यस्मै कन्यारत्नमिदं भवतैकाकिनाभिमताय देयम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000995078, "chapter_id": 20995, "verse_number": "४-१-७९", "content_sanskrit": "भवतोपि पुत्रमित्त्रकलत्रमंत्रिभृत्यबंधुबलकोशादयस्समस्ताः कालेनैतेनात्यंतमतीताः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000995079, "chapter_id": 20995, "verse_number": "४-१-८०", "content_sanskrit": "ततः पुनरप्युत्पन्नसाध्वसो राजा भगवंतं प्रणम्य पप्रच्छ ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000995080, "chapter_id": 20995, "verse_number": "४-१-८१", "content_sanskrit": "भगवन्नेवमवस्थिते म येयं कस्मै देयेति ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000995081, "chapter_id": 20995, "verse_number": "४-१-८२", "content_sanskrit": "ततस्स भगवान् किंचिदवनम्रकंधरः कृतांजलिर्भूत्वा सर्वलोकगुरुरंभोजयोनिराह ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000995082, "chapter_id": 20995, "verse_number": "४-१-८३", "content_sanskrit": "ब्रह्मोवाच ।\nन ह्यादिमध्यांतमजस्य यस्य विद्मो वयं सर्वमयस्य धातुः ।\nन च स्वरूपं न परं स्वभावं न चैव सारं परमेश्वरस्य ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000995083, "chapter_id": 20995, "verse_number": "४-१-८४", "content_sanskrit": "कलामुहूर्त्तादिमयश्च कालो न यद्विभूतेः परिणामहेतुः ।\nअजन्मनाशस्य सदैकमूर्त्तेरनामरूपस्य सनातनस्य ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000995084, "chapter_id": 20995, "verse_number": "४-१-८५", "content_sanskrit": "यस्य प्रसादादहमच्युतस्य मूर्त्तिः प्रजासृष्टिकरॐतकारी ।\nक्रोधाच्च रुद्र ः! स्थितिहेतुभूतो यस्माच्च मध्ये पुरुषः परस्मात् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000995085, "chapter_id": 20995, "verse_number": "४-१-८६", "content_sanskrit": "तद्रू पमास्थाय सृजत्य जोयः स्थितौ च योऽसौ पुरुषस्वरूपी ।\nरुद्र स्वरूपेण च योत्ति विश्वं धत्ते तथानंतवपुस्समस्तम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000995086, "chapter_id": 20995, "verse_number": "४-१-८७", "content_sanskrit": "पाकाय योग्नित्वमुपैति लोकान्बिभर्त्ति पृथ्वीवपुख्ययात्मा ।\nशक्रादिरूपी परिपाति विश्वमर्केंदुरूपश्च तमो हिनस्ति ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000995087, "chapter_id": 20995, "verse_number": "४-१-८८", "content_sanskrit": "करोति चेष्टाश्श्वसनस्वरूपी लोकस्य तृप्तिं च जलान्नरूपी ।\nददाति विश्वस्थितिसंस्थितस्तु सर्वावकाशं च नभस्स्वरूपी ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000995088, "chapter_id": 20995, "verse_number": "४-१-८९", "content_sanskrit": "यस्सृज्यते सर्गकृदात्मनैव यः पाल्यते पालयिता च देवः ।\nविश्वात्मकस्संहृयतेंतकारी पृथक् त्रयस्यास्य च योव्ययात्मा ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000995089, "chapter_id": 20995, "verse_number": "४-१-९०", "content_sanskrit": "यस्मिञ्जगद्यो जगदेतदाद्यो यं चाश्रितोस्मिञ्जगति स्वयंभूः ।\nस सर्वभूतप्रभवो धरित्र्! यां स्वांश्नो पुष्णुर्नृप तेऽवतीर्णः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000995090, "chapter_id": 20995, "verse_number": "४-१-९१", "content_sanskrit": "कुशस्थली या तव भूप रम्या पुरी पुराभूदमरावतीव ।\nसा द्वारका संप्रति तत्र चास्ते स केशवांशो बलदेवनामा ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000995091, "chapter_id": 20995, "verse_number": "४-१-९२", "content_sanskrit": "तस्मै त्वमेनां तनयां नरेंद्र प्रयच्छ मायामनुजाय जायाम् ।\nश्लाघ्यो वेरोसौ तनया तवेयं स्त्रीरत्नभूता सदृशो हि योगः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000995092, "chapter_id": 20995, "verse_number": "४-१-९३", "content_sanskrit": "श्रीपराशर उवाच ।\nइतीरितोसौ कमलोद्भवेन भुवं समासाद्य पतिः प्रजानाम् ।\nददर्श ह्रस्वान् पुरुषान् विरूपानल्पौजसस्स्वल्पविवेकवीर्यान् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000995093, "chapter_id": 20995, "verse_number": "४-१-९४", "content_sanskrit": "कुशस्थलीं तां च पुरीमुपेत्य दृष्ट्वान्यरूपां प्रददौ स कन्याम् ।\nसीरायुधाय स्फटिकाचलाभवक्षस्थलायातुलधीर्नरेंद्र ः! ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000995094, "chapter_id": 20995, "verse_number": "४-१-९५", "content_sanskrit": "उच्चप्रमाणामिति तामवेक्ष्य स्वलांगलाग्रेण च तालकेतुः ।\nविनम्रयामास ततश्च सापि बभूव सद्यो वनिता यथान्या ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000995095, "chapter_id": 20995, "verse_number": "४-१-९६", "content_sanskrit": "तां रेवतीं रैवतभूपकन्यां सीरायुधोऽसौ विधिनोपयेमे ।\nदत्त्वाथ कन्यां स नृपो जगाम हेमालयं वै तपसे धृतात्मा ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}]