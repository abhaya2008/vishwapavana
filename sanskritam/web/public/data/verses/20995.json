29, "chapter_id": 20995, "verse_number": "४-१-३०", "content_sanskrit": "तस्मादप्यविक्षित् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000995030, "chapter_id": 20995, "verse_number": "४-१-३१", "content_sanskrit": "अविक्षितोप्यतिबलपराक्रमः पुत्रो मरुत्तो नामाऽभवत् ।\nयस्येमावद्यापि श्लोकौ गीयेत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000995031, "chapter_id": 20995, "verse_number": "४-१-३२", "content_sanskrit": "मरुत्तस्य यथा यज्ञस्तथा कस्याभवद्भुवि ।\nसर्वं हिरण्मयं यस्य यज्ञवस्त्वतिशोभनम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000995032, "chapter_id": 20995, "verse_number": "४-१-३३", "content_sanskrit": "अमाद्यदिंद्र स्सोमेन दक्षिणाभिर्द्विजातयः ।\nमरुतः परिवेष्टारस्सदस्याश्च दिवौकसः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000995033, "chapter_id": 20995, "verse_number": "४-१-३४", "content_sanskrit": "स मरुत्तश्चक्रवर्त्ती नरिष्यंतनामानं पुत्रमवाप ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000995034, "chapter_id": 20995, "verse_number": "४-१-३५", "content_sanskrit": "तस्माच्च दमः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000995035, "chapter_id": 20995, "verse_number": "४-१-३६", "content_sanskrit": "दमस्य पुत्रो राजवर्धनो जज्ञे ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000995036, "chapter_id": 20995, "verse_number": "४-१-३७", "content_sanskrit": "राजवर्द्धनात्सुवृद्धिः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit"