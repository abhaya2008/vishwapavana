[
  {
    "id": 20006346,
    "chapter_id": 6637,
    "verse_number": "7.1",
    "content_sanskrit": "अनुगिरमृतुभिर्वितायमानामथ स विलोकयितुं वनान्तलक्ष्मीम् । निरगमदभिराद्धुमदृतानां भवति महत्सु न निष्फलः प्रयासः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20006347,
    "chapter_id": 6637,
    "verse_number": "7.2",
    "content_sanskrit": "दधति सुमनसो वनानि बह्वीर्युवतियुता यदवः प्रयातुमीषुः । मनसिमहास्त्रमन्यथामी न कुसुमपञ्चकमलं विसोढुम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20006348,
    "chapter_id": 6637,
    "verse_number": "7.3",
    "content_sanskrit": "अवसमधिगम्य तं हरन्तयो हृदयमयत्नकृतोज्वलस्वरूपाः । अवनिषु पदमङ्गनास्तदानीं न्यदधत विभ्रमसम्पदोऽङगनासु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20006349,
    "chapter_id": 6637,
    "verse_number": "7.4",
    "content_sanskrit": "नखरुचिरचिन्द्रचापं ललितगतेषु गतागतं दधाना । मुखरितवलयं पृथौ नितम्बे भुजलतिका मुहुरस्खलत्तरुण्याः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20006350,
    "chapter_id": 6637,
    "verse_number": "7.5",
    "content_sanskrit": "अतियपरिणाह्ववान्वितेने बहुतरमर्पितकिङ्किणीकः । अलघुनि जघनस्थलेऽपरस्या ध्वनिमधिकं कलमेखलाकलापः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20006351,
    "chapter_id": 6637,
    "verse_number": "7.6",
    "content_sanskrit": "गुरुनिबिडनितम्बबिम्बभाराक्रमणनिपीडितमङ्गनाजनस्य । चरणयुगमसुस्रुवत्पदेषु स्वरसमसक्तमलक्तकच्छलेन ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20006352,
    "chapter_id": 6637,
    "verse_number": "7.7",
    "content_sanskrit": "तव सपदि समीपमानये तामहमिति तस्य मयाग्रतोऽभ्यधायि । अतिरभसाकृतालघुप्रतिज्ञामनृतगिरं गुणगौरि मा कृथा माम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20006353,
    "chapter_id": 6637,
    "verse_number": "7.8",
    "content_sanskrit": "न च सुतनु न वेद्मि यन्महीयानसुनिरसस्तव निश्चयः परेण । वितथयति न जानातु मद्वचोऽसाविति च तथापि सखीषु मेऽभिमानः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20006354,
    "chapter_id": 6637,
    "verse_number": "7.9",
    "content_sanskrit": "सततमनभिभाषणं मया ते परिणमितं भवतीमनानयन्तया । त्वयि तदिति विरोधनिश्चितायां भवति भवत्वसुहृज्जनः सकामः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20006355,
    "chapter_id": 6637,
    "verse_number": "7.10",
    "content_sanskrit": "गतधृतिरवलम्बितुं बतासूननलमनालपनादहं भवत्याः । प्रणयति यदि न प्रसादबुद्धिर्भव मम मानिनि जीविते दयालुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20006356,
    "chapter_id": 6637,
    "verse_number": "7.11",
    "content_sanskrit": "प्रियमिति वनिता नितान्तमागःस्मरणसरोषषकषायिताक्षी । चरणगतसखीवचोऽनुरोधात्किल कथमप्यनुकूलयाञ्चकार ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20006357,
    "chapter_id": 6637,
    "verse_number": "7.12",
    "content_sanskrit": "द्रुतपदमिति मा वयस्य यासिर्ननु सुतनुं परिपालयानुयान्तीम् । नहि न विदितखेदमेदतीयस्तनजघनोद्वहने तवापि चेतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20006358,
    "chapter_id": 6637,
    "verse_number": "7.13",
    "content_sanskrit": "इति वदति सखीजनेऽनुरागाद्दयिततमामपरश्चिरं प्रतीक्ष्य । तदनुगमवशादनायतानि न्यधित मिमान इवावनिं पदानि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20006359,
    "chapter_id": 6637,
    "verse_number": "7.14",
    "content_sanskrit": "यदि मयि लघिमानमागतायां तव धृतिरस्ति गतास्मि सम्प्रतीयम् । द्रुततरपदपातमापपात प्रियमिति कोपपदेन कापि संख्या ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20006360,
    "chapter_id": 6637,
    "verse_number": "7.15",
    "content_sanskrit": "अविरलपुलकः सह व्रजन्त्याः प्रतिपदमेकतरः स्तनस्तरुण्याः । घटितविघटितः प्रियस्य वक्षस्तटभुवि कन्दुकविभ्रमं बभार ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20006361,
    "chapter_id": 6637,
    "verse_number": "7.16",
    "content_sanskrit": "अशिथिलमपरावसज्य कण्ठे दृढपरिरब्धबृहद्बहिस्तनेन । हृषिततनुरुहा भुजेन भर्तृर्मृदुममृदु व्यतिविद्धमेकबाहुं ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20006362,
    "chapter_id": 6637,
    "verse_number": "7.17",
    "content_sanskrit": "मुहुरसुसममाध्नती नितान्तं प्रणदितकाञ्चि नितम्बमण्डलेन । विषमितपृथुहारयष्टि तिर्यक्कुचमितरं तदुरस्थले निपीड्य ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20006363,
    "chapter_id": 6637,
    "verse_number": "7.18",
    "content_sanskrit": "गुरुतरकलनूपुरानुनादं सललितनर्तितवामपादपद्मा । इतरदतिलोलमादधाना पदमथ मन्मथमन्थरं जगाम ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20006364,
    "chapter_id": 6637,
    "verse_number": "7.19",
    "content_sanskrit": "लधुललितपदं तदंसपीठद्वयनिहितोभयपाणिपल्लवान्या । सकठिनकुचचूचुकप्रणोदं प्रियमबला सविलासमन्विनाय ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20006365,
    "chapter_id": 6637,
    "verse_number": "7.20",
    "content_sanskrit": "जघनमेलघपीवरोरु कृच्छ्रादुरुनिबिरीसनितम्बभारखेदि । दयिततमशिरोधरावलम्बिस्वभुजलताविभवेन काचिदूहे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20006366,
    "chapter_id": 6637,
    "verse_number": "7.21",
    "content_sanskrit": "अनुवपुरपरेण बाहुमूलप्रहितभुजाकलितस्तनेन निन्ये । निहितदशनवाससा कपोले विषमवितीर्णपदं बलादिवान्या ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20006367,
    "chapter_id": 6637,
    "verse_number": "7.22",
    "content_sanskrit": "अनुवनमसितभ्रुवः सखीभिः सह पदवीमपरः पुरोगतायाः । उरसि सरसरागपदलेखाप्रतिमतयानुययावसंशयानः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20006368,
    "chapter_id": 6637,
    "verse_number": "7.23",
    "content_sanskrit": "मदनरसमहौघपूर्णनाभीह्रदपरिवाहितरोमराजयस्ताः । सरित इव सविभ्रमप्रयातप्रणदितहंसकभूषणा विरेजुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20006369,
    "chapter_id": 6637,
    "verse_number": "7.24",
    "content_sanskrit": "श्रुतिपथमधुराणि सारसानामनुनदि सुश्रुविरे रुतानि ताभिः । विदधति जनतामनःशरव्यव्यधपटुमन्मथचापनादशङ्काम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20006370,
    "chapter_id": 6637,
    "verse_number": "7.25",
    "content_sanskrit": "मधुमथनवधूरिवाह्वयन्ति भ्रमरकुलानि जगुर्यदुत्सुकानि । तदभिनयमिवावलिर्वनानामतनुत नूतनपल्लवाङुगुलीभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20006371,
    "chapter_id": 6637,
    "verse_number": "7.26",
    "content_sanskrit": "असकलकलिकाकुलीकृतालिस्खलनविकीर्णविकासिकेशराणाम् । मरुदवनिरुहां रजो वधूभ्यः मुपहरन्विचकार कोरकाणि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20006372,
    "chapter_id": 6637,
    "verse_number": "7.27",
    "content_sanskrit": "उपवनपवनानुपातदक्षैरलिभिरलाभि यदङ्गनाजनस्य । परिमलविषयस्तदुन्नतानामनुगमने खलु सम्पदोऽग्रतःस्थाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20006373,
    "chapter_id": 6637,
    "verse_number": "7.28",
    "content_sanskrit": "रथचरणधराङ्गनाकराब्जव्यतिकरसम्पदुपात्तसौमनस्याः । जगति सुमनसस्तदादि नूनं दधति परिस्फुटमर्थतोऽभिधानम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20006374,
    "chapter_id": 6637,
    "verse_number": "7.29",
    "content_sanskrit": "अभिमुखपतितैर्गुणप्रकर्षादवजितमुद्धतिमुज्वलां दधानैः । तरुकिसलयजालमग्रहस्तैः प्रसभमनीयत भङ्गमङ्गनानां ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20006375,
    "chapter_id": 6637,
    "verse_number": "7.30",
    "content_sanskrit": "मुदितमधुभुजो भुजेन शाखाश्चलितविशृङ्खलशङ्खकं धुवत्याः । तरुरतिशायितापराङ्गनायाः शिरसि मुदेव मुमोच पुष्पवर्षम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20006376,
    "chapter_id": 6637,
    "verse_number": "7.31",
    "content_sanskrit": "अनवरतरसेन रागभाजा करजपरिक्षतिलब्धसंस्तवेन । सपदि तरुणपल्लवेन वध्वा विगतदयं खलु खण्डितेन मम्ले ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20006377,
    "chapter_id": 6637,
    "verse_number": "7.32",
    "content_sanskrit": "प्रियमभिकुसुमोद्यतस्य बाहोर्नवनखमण्डनचारु मूलमन्या । मुहुरितरकराहितेन पीनस्तनतटरोधि तिरोदधेऽंशुकेन ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20006378,
    "chapter_id": 6637,
    "verse_number": "7.33",
    "content_sanskrit": "विततवलिविभाव्यपाण्डुलेखाकृतपरभाघविलीनरोमराजिः । कृशमपि कृशतां पुनर्नयन्ती विपुलतरोन्मुखलोचनावलग्नं ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20006379,
    "chapter_id": 6637,
    "verse_number": "7.34",
    "content_sanskrit": "प्रसकलकुचबन्धुरोद्धुरोरःप्रसभविभिभिन्नतनूत्तरीयबन्धा । अनमवदुदरोच्छ्वसद्दुकूलस्फुटतरलक्ष्यगभीरनाबिमूला ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20006380,
    "chapter_id": 6637,
    "verse_number": "7.35",
    "content_sanskrit": "व्यवहितमविजानाती किलान्तवर्णभुवि वल्लभमाभिमुख्यभाजम् । अधिविटपि सलीलमग्रपुष्पग्रहणपदेन चिरं विलम्ब्य काचित् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20006381,
    "chapter_id": 6637,
    "verse_number": "7.36",
    "content_sanskrit": "अथ किल कथिते सखीभिरत्र क्षणमपरेव ससंभ्रमा भवन्ती । शिथिलितकुसुमाकुलाग्रपाणिः प्रतिपदसंयमितांशुकावृताङ्गी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20006382,
    "chapter_id": 6637,
    "verse_number": "7.37",
    "content_sanskrit": "कृतभयपरितोषसन्निपातं सचकितसस्मितवक्त्रवारिजश्रीः । मनसिजगुरुतत्क्षणोपदिष्टं किमपि रासेन रसन्तरं भजन्ती ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20006383,
    "chapter_id": 6637,
    "verse_number": "7.38",
    "content_sanskrit": "अवनदवदनेन्दुरिच्छतीव व्यवधिमधीरतया यदस्थितास्मै । अहरत सुतरामतोऽस्य चेतः स्फुटमभिभूषयति स्त्रियस्त्रपैव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20006384,
    "chapter_id": 6637,
    "verse_number": "7.39",
    "content_sanskrit": "किसलयशकलेष्ववाचनीयाः पुलकिनि केवलमङ्गकेनिधेयाः । नखपदलिपयोऽपि दीपितार्थाः प्रणिदधिरे दयितैरनङ्गलेखाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20006385,
    "chapter_id": 6637,
    "verse_number": "7.40",
    "content_sanskrit": "कृतकृतकरुषा सखीमपास्य त्वमकुशलेति कयाचिदात्मनैव । अभिमतमभि साभिलाषमाविष्कृतभुजमूलमबन्धि मूर्ध्नि माला ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20006386,
    "chapter_id": 6637,
    "verse_number": "7.41",
    "content_sanskrit": "अभिमुखमुपयाति मा स्म किञ्चित्त्वमभिदधाः पटले मधुव्रतानाम् । मधुसुरभिमुखाब्जगन्धलब्धेरधिकमधित्वदनेन मा निपाति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20006387,
    "chapter_id": 6637,
    "verse_number": "7.42",
    "content_sanskrit": "सरजसमकरन्दनिर्भरासु प्रसवविभूतिषु भूरुहां विरक्तः । ध्रुवममृतपनामवाञ्छयासावधरममुं मधुपस्तवाजिहीते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20006388,
    "chapter_id": 6637,
    "verse_number": "7.43",
    "content_sanskrit": "इति वदति सखीजने निमीलद्विगुणितसान्द्रतराक्षिपक्ष्ममाला । अपदतलिभयेन भर्तुरङ्गं भवति हि विक्लवता गुणोऽङ्गनानाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20006389,
    "chapter_id": 6637,
    "verse_number": "7.44",
    "content_sanskrit": "मुखकमलकमुन्नमय्य यूना यदभिनवोढवधूर्बलादचुम्बि । तदपि न किल बालपल्लवाग्रग्रहयापरया विविदे विदग्धसक्या ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20006390,
    "chapter_id": 6637,
    "verse_number": "7.45",
    "content_sanskrit": "व्रततिविततिभिस्तिरोहितायां प्रतियुवतौ वदनं प्रियः प्रियायाः । यदधयदधरावलोपनृत्यत्करवलयस्वनितेन तद्विवव्रे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20006391,
    "chapter_id": 6637,
    "verse_number": "7.46",
    "content_sanskrit": "विलसितमनुकुर्वती पुरस्ताद्धरणिरुहाधिरुहो वधूर्लतायाः । रमणमृजुतया पुरः सखीनामकलितचापलदोषमालिलिङ्ग ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20006392,
    "chapter_id": 6637,
    "verse_number": "7.47",
    "content_sanskrit": "सललिकमवलम्ब्य पाणिनांसे सहचरमुच्छ्रतगुच्छवाञ्छयान्या । सकलकलभकुम्भविभ्रमाभ्यामुरसि रसादवतस्तरे स्तनाभ्यां ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20006393,
    "chapter_id": 6637,
    "verse_number": "7.48",
    "content_sanskrit": "मृदुचरणतलाग्रदुःस्थितत्वादसहतरा कुचकुम्भयोर्भरस्य । उपरिनिरवलम्बनं प्रियस्य न्यपतदथोच्चतरोच्चिचीषयान्या ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20006394,
    "chapter_id": 6637,
    "verse_number": "7.49",
    "content_sanskrit": "उपरिजतरुजानि याजमानां कुशलतया परिरम्भलोलुपोऽन्यः । प्रथितपृथुपयोधरां गृहाण स्वयमिति मुग्धवधूमुदास दोर्भ्याम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20006395,
    "chapter_id": 6637,
    "verse_number": "7.50",
    "content_sanskrit": "इदमिदमिति भूरुहां प्रसूनैर्मुहुरतिलोभयता पुरःपुरोऽन्या । अनुरहसमनायि नायकेन त्वरयति रन्तुमहो जनं मनोभूः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20006396,
    "chapter_id": 6637,
    "verse_number": "7.51",
    "content_sanskrit": "विजनमिति बलादमुं गृहीत्वा क्षणमथ वीक्ष्य विपक्षमन्तिकोऽन्या । अभिपतितुमना लघुत्वभीतेरभवदमुञचति वल्लभेऽतिगुर्वी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20006397,
    "chapter_id": 6637,
    "verse_number": "7.52",
    "content_sanskrit": "अधिरजनि जगाम धाम तस्याः प्रियतमयेति रुषा स्रजावनद्धः । पदमपि चलितुं युवा न सेहे किमिव न शक्तिहरं ससाध्वसानां ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20006398,
    "chapter_id": 6637,
    "verse_number": "7.53",
    "content_sanskrit": "न खलु वयममुष्य दानयोग्याः पिबति च पाति च यासकौ रहस्त्वां । व्रज विचपममुं ददस्व तस्यै भवतु यतः सदृशोश्चिराय योगः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20006399,
    "chapter_id": 6637,
    "verse_number": "7.54",
    "content_sanskrit": "तव कितव किमाहितैर्वृथा नः क्षितिरुहपल्लवपुष्पकर्णपूरैः । ननु जनविदितैर्भवद्व्यलीकैश्चिरपरिपूरितमेव कर्णयुग्मम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20006400,
    "chapter_id": 6637,
    "verse_number": "7.55",
    "content_sanskrit": "मुहुरुपहसितामिवालिनादैर्वितरसि नः कालिकां किमर्थमेनाम् । वसतिमुपगतेन धाम्नि तस्याः शठ कलिरेष महांस्त्वयाद्य दत्तः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20006401,
    "chapter_id": 6637,
    "verse_number": "7.56",
    "content_sanskrit": "इति गदितवती रुषा जघान स्फुरितमनोरमपक्ष्मकेशरेण । श्रवणनियमितेन कान्तमन्या सममसिताम्बुरुहेण चक्षुषा च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20006402,
    "chapter_id": 6637,
    "verse_number": "7.57",
    "content_sanskrit": "विनयति सुदृशो दृशः परागं प्रणयिनि कौसुममाननानिलेन । तदहितयुवतेरभीक्ष्णमक्ष्णोर्द्वयमपि रोषरझोभिरापुपूरे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20006403,
    "chapter_id": 6637,
    "verse_number": "7.58",
    "content_sanskrit": "स्फुचमिदमभिचारमन्त्र एव प्रतियुवतेरभिधानमङ्गनानाम् । वरतनुरमुनोपहूय पत्या मृदुकुसुमेन यदाहताप्यमूर्च्छत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20006404,
    "chapter_id": 6637,
    "verse_number": "7.59",
    "content_sanskrit": "समदनमवतंसितेऽद्कर्णं प्रणयवता कुसुमे सुमध्यमायाः । व्रजदपि लघुतां बभूव भारः सपदि हिरण्मयमण्डनं सपत्न्याः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20006405,
    "chapter_id": 6637,
    "verse_number": "7.60",
    "content_sanskrit": "अवजितमधुना तवाहमक्ष्णो रुचितयेत्यवनम्य लज्जयेव । श्रवणकुवलयं विलासवत्या भ्रमररुतैरुपकर्णमाचचक्षे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20006406,
    "chapter_id": 6637,
    "verse_number": "7.61",
    "content_sanskrit": "अवचितकुसुमा विहाय वल्लीर्युवतीषु कोमलमाल्यमालिनीषु । पदमुपदधिरे कुलान्यलीनां न परिचयो मलिनात्मनां प्रधानम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20006407,
    "chapter_id": 6637,
    "verse_number": "7.62",
    "content_sanskrit": "श्लथशिरसिजपातभारादिव नितरां नतिमद्भिरंसभागैः । मुकुलितनयनैर्मुखारविन्दैर्घनमहतामिव पक्ष्मणां भरेण ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20006408,
    "chapter_id": 6637,
    "verse_number": "7.63",
    "content_sanskrit": "अदिकमरुणिमानमुद्वहद्भिर्विकसदशीतमरीचिरशमिजालैः । परिचितपरिचुम्बनाभियोगादपगतकुङ्कुमरेणुभिः कपोलैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20006409,
    "chapter_id": 6637,
    "verse_number": "7.64",
    "content_sanskrit": "अवसितललितक्रियेण बाह्वोर्ललिततरेण तनीयसा युगेन । सरसकिसलयानुरञ्जितैर्वा करकमलैः पुनरुक्तरक्तभाभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20006410,
    "chapter_id": 6637,
    "verse_number": "7.65",
    "content_sanskrit": "स्मरसरसमुरःस्थलेन पत्युर्विनिमयसंक्रमिताङ्गरागरागैः । भृशमतिशयखेदसम्पदेव स्तनयुगलैरितरेतरं निषण्णैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20006411,
    "chapter_id": 6637,
    "verse_number": "7.66",
    "content_sanskrit": "अतनुकुचभरानतेन भूयः श्रमजनितानतिना शरीरकेण । अनुचितगतिसादनिःसहत्वं कलभकरोरुभिरूरुभिर्दधानैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20006412,
    "chapter_id": 6637,
    "verse_number": "7.67",
    "content_sanskrit": "अपगतनवयावकैश्चिराय क्षितिगमनेन पुनर्वितीर्णरागैः । कथमपि चरणोत्पलैश्चलद्भिर्भृशाविनिवेशात्परस्परस्य ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "avatarnika": ""
  },
  {
    "id": 20006413,
    "chapter_id": 6637,
    "verse_number": "7.68",
    "content_sanskrit": "मुहुरिति वनविभ्रमाभिषङ्गादतमि तदा नितरां नितम्बिनीभिः । मृदुतरतनवोऽनलसाः प्रकृत्या चिरमपि ताः किमुत प्रयासभाजः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "avatarnika": ""
  },
  {
    "id": 20006414,
    "chapter_id": 6637,
    "verse_number": "7.69",
