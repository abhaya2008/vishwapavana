[{"id": 7003466000, "chapter_id": 23466, "verse_number": "१०६-१", "content_sanskrit": "अथ दधिधेनुदान माहात्म्यम् ।\nहोतोवाच ।\nदधिधेनोर्महाराज विधानं शृणु सांप्रतम् ।\nअनुलिप्ते महीभागे गोमयेन नराधिपः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003466001, "chapter_id": 23466, "verse_number": "१०६-२", "content_sanskrit": "गोचर्ममात्रं तु पुनः पुष्पप्रकरशोभिते ।\nकुशैरास्तीर्य वसुधां कृष्णाजिनकुशोत्तरीम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003466002, "chapter_id": 23466, "verse_number": "१०६-३", "content_sanskrit": "दधिकुम्भं तु संस्थाप्य सप्तधान्यचयोपरि ।\nचतुर्थांशेन वत्सं तु सौवर्णं मुखमण्डितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003466003, "chapter_id": 23466, "verse_number": "१०६-४", "content_sanskrit": "आच्छाद्य वस्त्रयुग्मेन पुष्पगन्धैस्तु पूजिताम् ।\nब्राह्मणाय कुलीनाय साधुवृत्ताय धीमते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003466004, "chapter_id": 23466, "verse_number": "१०६-५", "content_sanskrit": "क्षमादिगुणयुक्ताय दद्यात्तां दधिधेनुकाम् ।\nपुच्छदेशोपविष्टस्तु मुद्रिकाकर्णभूषणैः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003466005, "chapter_id": 23466, "verse_number": "१०६-६", "content_sanskrit": "पादुकोपानहौ छत्रं दत्त्वा मंत्रमिमं पठेत् ।\nदधिक्राव्णेति मंत्रेण दद्याद्धेनुं सुपूजिताम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003466006, "chapter_id": 23466, "verse_number": "१०६-७", "content_sanskrit": "एवं दधिमयीं धेनुं दत्त्वा राजर्षिसत्तम ।\nएकाहारी दिनं तिष्ठेद्दध्ना च नृपनन्दन ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003466007, "chapter_id": 23466, "verse_number": "१०६-८", "content_sanskrit": "यजमानो वसेद्राजंस्त्रिरात्रं च द्विजोत्तमः ।\nदीयमानां प्रपश्यन्ति ते यान्ति परमं पदम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003466008, "chapter_id": 23466, "verse_number": "१०६-९", "content_sanskrit": "य इदं शृणुयाद्भक्त्या श्रावयेद्वापि मानवः ।\nसोऽश्वमेधफलं प्राप्य विष्णुलोकं च गच्छति ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]