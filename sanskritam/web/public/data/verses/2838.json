[{"id": 2086420, "chapter_id": 2838, "verse_number": "१२-३४३-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2086421, "chapter_id": 2838, "verse_number": "१२-३४३-१", "content_sanskrit": "स एवमुक्तो द्विपदां वरिष्ठो\nनारायणेनोत्तमपूरुषेण।\nजगाद वाक्यं द्विपदां वरिष्ठं\nनारायणं लोकहिताधिवासम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2086422, "chapter_id": 2838, "verse_number": "१२-३४३-२x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2086423, "chapter_id": 2838, "verse_number": "१२-३४३-२", "content_sanskrit": "यदर्थमात्मप्रभवेह जन्म\nत्वयोत्तमं धर्मगृहे चतुर्धा।\nतत्साध्यतां लोकहितार्थमद्य\nगच्छामि द्रष्टुं प्रकृतिं तवाद्याम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2086424, "chapter_id": 2838, "verse_number": "१२-३४३-३", "content_sanskrit": "वेदाः स्वधीता मम लोकनाथ\nतप्तं तपो नानृतमुक्तपूर्वम्।\nपूजां गुरूणां सततं करोमि\nपरस्य गुह्यं न तु भिन्नपूर्वम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2086425, "chapter_id": 2838, "verse_number": "१२-३४३-४", "content_sanskrit": "गुप्तानि चत्वारि यथागमं मे\nशत्रौ च मित्रे च समोस्मि नित्यम्।\nतं चादिदेवं सततं प्रपन्न\nएकान्तभावेन वृणोभ्यजस्रम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2086426, "chapter_id": 2838, "verse_number": "१२-३४३-५", "content_sanskrit": "एभिर्विशेषैः परिशृद्धसत्वः\nकस्मान्न पश्येयमनन्तमीशम्।\nतत्पारमेष्ठ्यस्य वचो निशम्य\nनारायणः शाश्वतधर्मगोप्ता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2086427, "chapter_id": 2838, "verse_number": "१२-३४३-६", "content_sanskrit": "गच्छेति तं नारदमुक्तबान्स\nसंपूजयित्वा विधिवत्क्रियाभिः।\nततो विसृष्टः परमेष्ठिपुत्रः\nसोऽभ्यर्चयित्वा तमृषिं पुराणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2086428, "chapter_id": 2838, "verse_number": "१२-३४३-७", "content_sanskrit": "खमुत्पपातोत्तमयोगयुक्त\nस्ततोऽधिमेरौ सहसा निलिल्ये।\nतत्रावतस्थे च मुनिर्मुर्हुत\nमेकान्तमासाद्य गिरेः स शृङ्क्ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2086429, "chapter_id": 2838, "verse_number": "१२-३४३-८", "content_sanskrit": "आलोकयन्नुत्तरपश्चिमेन\nददर्श चाप्यद्भुतमुक्तरूपम्।\nक्षीरोदधेर्योत्तरतो हि द्वीपः\nश्वेतः स नाम्ना प्रथितो विशालः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2086430, "chapter_id": 2838, "verse_number": "१२-३४३-९", "content_sanskrit": "मेरोः सहस्रैः स हि योजनानां\nद्वात्रिंशतोर्ध्वं कविभिर्निरुक्तः।\nअनिन्द्रियाश्चानशनाश्च तत्र\nनिष्पन्दहीनाः सुसुगन्धिनस्ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2086431, "chapter_id": 2838, "verse_number": "१२-३४३-१०", "content_sanskrit": "श्वेताः पुमांसो गतसर्वपापा\nश्चक्षुर्मुषः पापकृतां नराणाम्।\nवज्रास्थिकायाः सममानोन्माना\nदिव्यावयवरूपाः शुभसारोपेताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2086432, "chapter_id": 2838, "verse_number": "१२-३४३-११", "content_sanskrit": "छत्राकृतिशीर्षा मेघौघनिनादाः\nसममुष्कचतुष्का राजीवच्छदपादाः।\nषष्ठ्या दन्तैर्युक्ताः शुक्लैरष्टाभिर्दंष्ट्राभिर्ये\nजिह्वाभिर्ये विश्ववक्रंलेलिह्यन्ते सूर्यप्रख्यम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2086433, "chapter_id": 2838, "verse_number": "१२-३४३-१२", "content_sanskrit": "देवं भक्त्या विश्वोत्पन्नं\nयस्मात्सर्वे लोकाः संप्रसूताः।\nसर्वगात्राश्च सूक्ष्माः सहाङ्गका\nवेदा धर्मा मुनयः शान्ता देवाः\nसर्वे तस्य निसर्ग इति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2086434, "chapter_id": 2838, "verse_number": "१२-३४३-१३x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2086435, "chapter_id": 2838, "verse_number": "१२-३४३-१३", "content_sanskrit": "अनिन्द्रिया निराहारा अनिष्पन्दाः सुगन्धिनः।\nकथं ते पुरुषा जाताः का तेषां गतिरुत्तमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2086436, "chapter_id": 2838, "verse_number": "१२-३४३-१४", "content_sanskrit": "ये च मुक्ता भवन्तीह नरा भरतसत्तम।\nतेषां लक्षणमेतद्धि तच्छ्वेतद्द्वीपवासिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2086437, "chapter_id": 2838, "verse_number": "१२-३४३-१५", "content_sanskrit": "तस्मान्मे संशयं छिन्धि परं कौतूहलं हि मे।\nत्वं हि सर्वकथारामस्त्वां चैवोपाश्रिता वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2086438, "chapter_id": 2838, "verse_number": "१२-३४३-१६x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2086439, "chapter_id": 2838, "verse_number": "१२-३४३-१६", "content_sanskrit": "विस्तीर्णैषा कथा राजञ्श्रुता मे पितृसन्निधौ।\nयैषा तव हि वक्तव्या कथासारो हि सा मता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2086440, "chapter_id": 2838, "verse_number": "१२-३४३-१७", "content_sanskrit": "`शन्तनोः कथयामास नारदो मुनिसत्तमः।\nराज्ञा पृष्टः पुरा प्राह तत्राहं श्रुतवान्पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2086441, "chapter_id": 2838, "verse_number": "१२-३४३-१८", "content_sanskrit": "राजोपरिचरो नाम बभूवाधिपतिर्भुवः।\nआखण़्डलसखः ख्यातो भक्तो नारायणं हरिं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2086442, "chapter_id": 2838, "verse_number": "१२-३४३-१९", "content_sanskrit": "धार्मिको नित्यभक्तश्च पितुर्नित्यमतन्द्रितः।\nसाम्राज्यं तेन संप्राप्तं नारायणवरात्पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2086443, "chapter_id": 2838, "verse_number": "१२-३४३-२०", "content_sanskrit": "सात्वतं विधिमास्थाय प्राक्सूर्यमुखनिःसृतम्।\nपूजयामास देवेशं तच्छेषेण पितामहान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2086444, "chapter_id": 2838, "verse_number": "१२-३४३-२१", "content_sanskrit": "पितृशेषेण विप्रांश्च संविभज्याश्रितांश्च सः।\nशेषान्नभुक्सत्यपरः सर्वभूतेष्वहिंसकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2086445, "chapter_id": 2838, "verse_number": "१२-३४३-२२", "content_sanskrit": "सर्वभावेन भक्तः स देवदेवं जनार्दनम्।\nअनादिमध्यनिधनं लोककर्तारमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2086446, "chapter_id": 2838, "verse_number": "१२-३४३-२३", "content_sanskrit": "तस्य नारायणे भक्तिं वहतोऽमित्रकर्शिनः।\nएकशय्यासनं देवो दत्तवान्देवराट् स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2086447, "chapter_id": 2838, "verse_number": "१२-३४३-२४", "content_sanskrit": "आत्मराज्यं धनं चैव कलत्रं वाहनं तथा।\nयत्तद्भागवतं सर्वमिति तत्प्रेषितं सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2086448, "chapter_id": 2838, "verse_number": "१२-३४३-२५", "content_sanskrit": "काम्यनैमित्तिका राजन्यज्ञियाः परमक्रियाः।\nसर्वाः सात्वतमास्थाय विधिं चक्रे समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2086449, "chapter_id": 2838, "verse_number": "१२-३४३-२६", "content_sanskrit": "पाञ्चरात्रविदो मुख्यास्तस्य गेहे महात्मनः।\nवरान्नं भगवत्प्रोक्तं भुञ्जते वाऽग्रभोजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2086450, "chapter_id": 2838, "verse_number": "१२-३४३-२७", "content_sanskrit": "तस्य प्रशासतो राज्यं धर्मेणामित्रघातिनः।\nनानृता वाक्समभवन्मनो दुष्टं न चाभवत्।\nन च कायेन कृतवान्स पापं परमण्वपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2086451, "chapter_id": 2838, "verse_number": "१२-३४३-२८", "content_sanskrit": "ये हि ते ऋषयः ख्याताः सप्त चित्रशिखण्डिनः।\nतैरेकमतिभिर्भूत्वा यत्प्रोक्तं शास्त्रमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2086452, "chapter_id": 2838, "verse_number": "१२-३४३-२९", "content_sanskrit": "वेदैश्चतुर्भिः समितं कृतं मेरौ महागिरौ।\nआस्यैः सप्तभिरुद्गीर्णं लोकधर्ममनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2086453, "chapter_id": 2838, "verse_number": "१२-३४३-३०", "content_sanskrit": "मरीचिरत्र्यङ्गिरसौ पुलस्त्यः पुलहः क्रतुः।\nवसिष्ठश्च महातेजास्ते हि चित्रशिखण्डिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2086454, "chapter_id": 2838, "verse_number": "१२-३४३-३१", "content_sanskrit": "सप्त प्रकृतयो ह्येतास्तथा स्वायंभुवोऽष्टमः।\nएताभिर्धार्यते लोकस्ताभ्याः शास्त्रं विनिःसृतं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2086455, "chapter_id": 2838, "verse_number": "१२-३४३-३२", "content_sanskrit": "एकाग्रमनसो दान्ता मुनयः संयमे रताः।\nभूतभव्यभविष्यज्ञाः सत्यधर्मपरायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2086456, "chapter_id": 2838, "verse_number": "१२-३४३-३३", "content_sanskrit": "इदं श्रेय इदं ब्रह्म इदं हितमनुत्तमम्।\nलोकान्संचिन्त्य मनसा ततः शास्त्रं प्रचक्रिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2086457, "chapter_id": 2838, "verse_number": "१२-३४३-३४", "content_sanskrit": "तत्र धर्मार्थकामा हि मोक्षः पश्चाच्च कीर्तितः।\nमर्यादा विविधाश्चैव दिवि भूमौ च संस्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2086458, "chapter_id": 2838, "verse_number": "१२-३४३-३५", "content_sanskrit": "आराध्य तपसा देवं हरिं नारायणं प्रभुम्।\nदिव्यं वर्षसहस्रं वै सर्वे ते ऋषिभिः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2086459, "chapter_id": 2838, "verse_number": "१२-३४३-३६", "content_sanskrit": "नारायणानुशिष्टा हि तदा देवी सरस्वती।\nविवेश तानृषीन्सर्वाल्लोँकानां हितकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2086460, "chapter_id": 2838, "verse_number": "१२-३४३-३७", "content_sanskrit": "ततः प्रवर्तिता सम्यक्तपोविद्भिर्द्विजातिभिः।\nशब्दे चार्थे च हेतौ च एषा प्रथमसर्गजा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2086461, "chapter_id": 2838, "verse_number": "१२-३४३-३८", "content_sanskrit": "आदावेव हि तच्छास्त्रमोंकारस्वरपूजितम्।\nऋषिभिः श्रावितं तत्र यत्र कारुणिकोह्यसौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2086462, "chapter_id": 2838, "verse_number": "१२-३४३-३९", "content_sanskrit": "ततः प्रसन्नो भगवाननिर्दिष्टशरीरगः।\nऋषीनुवाच तान्सर्वानदृश्यः पुरुषोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2086463, "chapter_id": 2838, "verse_number": "१२-३४३-४०", "content_sanskrit": "कृतं शतसहस्रं हि श्लोकानां हितमुत्तमम्।\nलोकतन्त्रस्य कृत्स्नस्य यस्माद्धर्मः प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2086464, "chapter_id": 2838, "verse_number": "१२-३४३-४१", "content_sanskrit": "प्रवृत्तौ च निवृत्तौ च यस्मादेतद्भविष्यति।\nयजुर्ऋक्सामभिर्जुष्टमथर्वाङ्गिरसैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2086465, "chapter_id": 2838, "verse_number": "१२-३४३-४२", "content_sanskrit": "यथाप्रमाणं हिं मया कृतो ब्रह्म प्रसादतः।\nरुद्रश्च क्रोधजो विप्रा यूयं प्रकृतयस्तथा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2086466, "chapter_id": 2838, "verse_number": "१२-३४३-४३", "content_sanskrit": "सूर्याचन्द्रमसौ वायुर्भूमिरापोऽग्निरेव च।\nसर्वे च नक्षत्रगणा यच्च भूताभिशब्दितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2086467, "chapter_id": 2838, "verse_number": "१२-३४३-४४", "content_sanskrit": "अधिकारेषु वर्तन्ते यथास्वं ब्रह्मवादिनः।\nसर्वे प्रमाणं हि यथा तथा तच्छास्त्रमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2086468, "chapter_id": 2838, "verse_number": "१२-३४३-४५", "content_sanskrit": "भविष्यति प्रमाणं वै एतन्मदनुशासनम्।\nतस्मात्प्रवक्ष्यते धर्मान्मनुः स्वायंभुवः स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2086469, "chapter_id": 2838, "verse_number": "१२-३४३-४६", "content_sanskrit": "उशना बृहस्पतिश्चैव यदोत्पन्नौ भविष्यतः।\nतदा प्रवक्ष्यतः शास्त्रं युष्मन्मतिभिरुद्धृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2086470, "chapter_id": 2838, "verse_number": "१२-३४३-४७", "content_sanskrit": "स्वायंभुवेषु धर्मेषु शास्त्रे चोशनसा कृते।\nबृहस्पतिमते चैव लोकेषु प्रतिचारिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2086471, "chapter_id": 2838, "verse_number": "१२-३४३-४८", "content_sanskrit": "युष्मत्कृतमिदं शास्त्रं प्रजापालो वसुस्ततः।\nबृहस्पतिसकाशाद्वै प्राप्स्यते द्विजसत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2086472, "chapter_id": 2838, "verse_number": "१२-३४३-४९", "content_sanskrit": "स हि मद्भावनिरतो मद्भक्तश्च भविष्यति।\nतेन शास्त्रेण लोकेषु क्रियाः सर्वाः करिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2086473, "chapter_id": 2838, "verse_number": "१२-३४३-५०", "content_sanskrit": "एतद्धि युष्मच्छास्त्राणां शास्त्रमुत्तमसंज्ञितम्।\nएतदर्थ्यं च धर्म्यं च रहस्यं चैतदुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2086474, "chapter_id": 2838, "verse_number": "१२-३४३-५१", "content_sanskrit": "अस्य प्रवर्तनाच्चैव प्रजावन्तो भविष्यथ।\nस च राजश्रिया युक्तो भविष्यति महान्वसुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2086475, "chapter_id": 2838, "verse_number": "१२-३४३-५२", "content_sanskrit": "संस्थिते तु नृपे तस्मिञ्शास्त्रमेतत्सनातनम्।\nअन्तर्धास्यति तत्सर्वमेतद्वः कथितं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2086476, "chapter_id": 2838, "verse_number": "१२-३४३-५३", "content_sanskrit": "एतावदुक्त्वा वचनमदृश्यः पुरुषोत्तमः।\nविसृज्य तानृषीन्सर्वान्कामपि प्रसृतो दिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2086477, "chapter_id": 2838, "verse_number": "१२-३४३-५४", "content_sanskrit": "ततस्ते लोकपितरः सर्वलोकार्थचिन्तकाः।\nप्रावर्तयन्त तच्छास्त्रं धर्मयोनिं सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2086478, "chapter_id": 2838, "verse_number": "१२-३४३-५५", "content_sanskrit": "उत्पन्नेऽङ्गिरसे चैव युगे प्रथमकल्पिते।\nसाङ्गोपनिषदं शास्त्रं स्थापयित्वा बृहस्पतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2086479, "chapter_id": 2838, "verse_number": "१२-३४३-५६", "content_sanskrit": "जग्मुर्यथेप्सितं सर्वलोकानां सर्वधर्मप्रवर्तकाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2086480, "chapter_id": 2838, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि त्रिचत्वारिंशदधिकत्रिशततमोऽध्यायः॥ ३४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]