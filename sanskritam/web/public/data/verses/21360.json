[{"id": 7001360000, "chapter_id": 21360, "verse_number": "५-७-१", "content_sanskrit": "सनत्कुमार उवाच ।\nअथ पापैर्नरा यांति यमलोकं चतुर्विधैः ।\nसंत्रासजननं घोरं विवशास्सर्वदेहिनः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001360001, "chapter_id": 21360, "verse_number": "५-७-२", "content_sanskrit": "गर्भस्थैर्जायमानैश्च बालैस्तरुणमध्यमैः ।\nस्त्रीपुन्नपुंसकैर्जीवैर्ज्ञातव्यं सर्वजंतुषु॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001360002, "chapter_id": 21360, "verse_number": "५-७-३", "content_sanskrit": "शुभाशुभफलं चात्र देहिनां संविचार्यते ।\nचित्रगुप्तादिभिस्सर्वैर्वसिष्ठप्रमुखैस्तथा॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001360003, "chapter_id": 21360, "verse_number": "५-७-४", "content_sanskrit": "न केचित्प्राणिनस्संति ये न यांति यमक्षयम् ।\nअवश्यं हि कृतं कर्म भोक्तव्यं तद्विचार्य्यताम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001360004, "chapter_id": 21360, "verse_number": "५-७-५", "content_sanskrit": "तत्र ये शुभकर्माणस्सौम्यचित्ता दयान्विताः ।\nते नरा यांति सौम्येन पूर्वं यमनिकेतनम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001360005, "chapter_id": 21360, "verse_number": "५-७-६", "content_sanskrit": "ये पुनः पापकर्म्माणः पापा दानविवर्जिताः ।\nते घोरेण पथा यांति दक्षिणेन यमालयम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001360006, "chapter_id": 21360, "verse_number": "५-७-७", "content_sanskrit": "षडशीतिसहस्राणि योजनानामतीत्य तत् ।\nवैवस्वतपुरं ज्ञेयं नानारूपमवस्थितम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001360007, "chapter_id": 21360, "verse_number": "५-७-८", "content_sanskrit": "समीपस्थमिवाभाति नराणां पुण्यकर्मणाम् ।\nपापिनामतिदूरस्थं पथा रौद्रेण गच्छताम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001360008, "chapter_id": 21360, "verse_number": "५-७-९", "content_sanskrit": "तीक्ष्णकंटकयुक्तेन शर्कराविचितेन च ।\nक्षुरधारानिभैस्तीक्ष्णैः पाषाणै रचितेन च॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001360009, "chapter_id": 21360, "verse_number": "५-७-१०", "content_sanskrit": "क्वचित्पंकेन महता उरुतोकैश्च पातकैः ।\nलोहसूचीनिभैर्दर्भैस्सम्पन्नेन पथा क्वचित्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001360010, "chapter_id": 21360, "verse_number": "५-७-११", "content_sanskrit": "तटप्रायातिविषमैः पर्वतैर्वृक्षसंकुलैः ।\nप्रतप्तांगारयुक्तेन यांति मार्गेण दुःखिताः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001360011, "chapter_id": 21360, "verse_number": "५-७-१२", "content_sanskrit": "क्वचिद्विषमगर्तैश्च क्वचिल्लोष्टैस्सुदुष्करैः ।\nसुतप्तवालुकाभिश्च तथा तीक्ष्णैश्च शंकुभिः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001360012, "chapter_id": 21360, "verse_number": "५-७-१३", "content_sanskrit": "अनेक शाखाविततैर्व्याप्तं वंशवनैः क्वचित् ।\nकष्टेन तमसा मार्गे नानालम्बेन कुत्रचित्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001360013, "chapter_id": 21360, "verse_number": "५-७-१४", "content_sanskrit": "अयश्शृंगाटकैस्तीक्ष्णैः क्वचिद्दावाग्निना पुनः ।\nक्वचित्तप्तशिलाभिश्च क्वचिद्व्याप्तं हिमेन च॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001360014, "chapter_id": 21360, "verse_number": "५-७-१५", "content_sanskrit": "क्वचिद्वालुकया व्याप्तमाकंठांतः प्रवेशया ।\nक्वचिद्दुष्टाम्बुना व्याप्तं क्वचिच्च करिषाग्निना॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001360015, "chapter_id": 21360, "verse_number": "५-७-१६", "content_sanskrit": "क्वचित्सिंहैर्वृकैर्व्याघ्रैर्मशकैश्च सुदारुणैः ।\nक्वचिन्महाजलौकाभिः क्वचिच्चाजगरैस्तथा॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001360016, "chapter_id": 21360, "verse_number": "५-७-१७", "content_sanskrit": "मक्षिकाभिश्च रौद्राभिः क्वचित्सर्पैर्विषोल्बणैः ।\nमत्तमातंगयूथैश्च बलोन्मत्तैः प्रमाथिभिः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001360017, "chapter_id": 21360, "verse_number": "५-७-१८", "content_sanskrit": "पंथानमुल्लिखद्भिश्च सूकरैस्तीक्ष्णदंष्ट्रिभिः ।\nतीक्ष्णशृंगैश्च महिषैस्सर्वभूतैश्च श्वापदैः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001360018, "chapter_id": 21360, "verse_number": "५-७-१९", "content_sanskrit": "डाकिनीभिश्च रौद्राभिर्विकरालैश्च राक्षसैः ।\nव्याधिभिश्च महाघोरैः पीड्यमाना व्रजंति हि॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001360019, "chapter_id": 21360, "verse_number": "५-७-२०", "content_sanskrit": "महाधूलिविमिश्रेण महाचण्डेन वायुना ।\nमहापाषाणवर्षेण हन्यमाना निराश्रयाः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001360020, "chapter_id": 21360, "verse_number": "५-७-२१", "content_sanskrit": "क्वचिद्विद्युत्प्रपातेन दह्यमाना व्रजन्ति च ।\nमहता बाणवर्षेण विध्यमानाश्च सर्वतः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001360021, "chapter_id": 21360, "verse_number": "५-७-२२", "content_sanskrit": "पतद्भिर्वज्रपातैश्च उल्कापातैश्च दारुणैः ।\nप्रदीप्तांगारवर्षेण दह्यमानाश्च संति हि॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001360022, "chapter_id": 21360, "verse_number": "५-७-२३", "content_sanskrit": "महता पांसुवर्षेण पूर्यमाणा रुदंति च ।\nमहामेघरवैर्घोरैस्त्रस्यंते च मुहुर्मुहुः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001360023, "chapter_id": 21360, "verse_number": "५-७-२४", "content_sanskrit": "निशितायुधवर्षेण भिद्यमानाश्च सर्वतः ।\nमहाक्षाराम्बुधाराभिस्सिच्यमाना व्रजंति च॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001360024, "chapter_id": 21360, "verse_number": "५-७-२५", "content_sanskrit": "महीशीतेन मरुता रूक्षेण परुषेण च ।\nसमंताद्बाध्यमानाश्च शुष्यंते संकुचन्ति च॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001360025, "chapter_id": 21360, "verse_number": "५-७-२६", "content_sanskrit": "इत्थं मार्गेण रौद्रेण पाथेयरहितेन च ।\nनिरालम्बेन दुर्गेण निर्जलेन समंततः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001360026, "chapter_id": 21360, "verse_number": "५-७-२७", "content_sanskrit": "विषमेणैव महता निर्जनापाश्रयेण च ।\nतमोरूपेण कष्टेन सर्वदुष्टाश्रयेण च॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001360027, "chapter_id": 21360, "verse_number": "५-७-२८", "content_sanskrit": "नीयंते देहिनस्सर्वे ये मूढाः पापकर्मिणः ।\nयमदूतैर्महाघोरैस्तदाज्ञाकारिभिर्बलात्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001360028, "chapter_id": 21360, "verse_number": "५-७-२९", "content_sanskrit": "एकाकिनः पराधीना मित्रबन्धुविवर्जिताः ।\nशोचंतस्स्वानि कर्म्माणि रुदंतश्च मुहुर्मुहुः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001360029, "chapter_id": 21360, "verse_number": "५-७-३०", "content_sanskrit": "प्रेता भूत्वा विवस्त्राश्च शुष्ककंठौष्ठतालुकाः ।\nअसौम्या भयभीताश्च दह्यमानाः क्षुधान्विताः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001360030, "chapter_id": 21360, "verse_number": "५-७-३१", "content_sanskrit": "बद्धाश्शृंखलया केचिदुत्ता नपादका नराः ।\nकृष्यंते कृष्यमाणाश्च यमदूतैर्बलोत्कटैः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001360031, "chapter_id": 21360, "verse_number": "५-७-३२", "content_sanskrit": "उरसाधोमुखाश्चान्ये घृष्यमाणास्सुदुःखिताः ।\nकेशपाशनि बंधेन संस्कृष्यंते च रज्जुना॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001360032, "chapter_id": 21360, "verse_number": "५-७-३३", "content_sanskrit": "ललाटे चांकुशेनान्ये भिन्ना दुष्यंति देहिनः ।\nउत्तानाः कंटकपथा क्वचिदंगारवर्त्मना॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001360033, "chapter_id": 21360, "verse_number": "५-७-३४", "content_sanskrit": "पश्चाद्बाहुनिबद्धाश्च जठरेण प्रपीडिताः ।\nपूरिताश्शृंखलाभिश्च हस्तयोश्च सुकीलिताः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001360034, "chapter_id": 21360, "verse_number": "५-७-३५", "content_sanskrit": "ग्रीवापाशेन कृष्यंते प्रयांत्यन्ये सुदुःखिताः ।\nजिह्वांकुशप्रवेशेन रज्ज्वाकृष्यन्त एव ते॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001360035, "chapter_id": 21360, "verse_number": "५-७-३६", "content_sanskrit": "नासाभेदेन रज्ज्वा च त्वाकृश्यन्ते तथापरे ।\nभिन्नाः कपोलयो रज्ज्वाकृष्यंतेऽन्ये तथौष्ठयोः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001360036, "chapter_id": 21360, "verse_number": "५-७-३७", "content_sanskrit": "छिन्नाग्रपादहस्ताश्च च्छिन्नकर्णोष्ठनासिकाः ।\nसंछिन्नशिश्नवृषणाः छिन्नभिन्नांगसंधयः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001360037, "chapter_id": 21360, "verse_number": "५-७-३८", "content_sanskrit": "आभिद्यमानाः कुंतैश्च भिद्यमानाश्च सायकैः ।\nइतश्चेतश्च धावंतः क्रंदमाना निराश्रयाः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001360038, "chapter_id": 21360, "verse_number": "५-७-३९", "content_sanskrit": "मुद्गरैर्लोहदण्डैश्च हन्यमाना मुहुर्मुहुः ।\nकंटकैर्विविधैर्घोरैर्ज्वलनार्कसमप्रभैः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001360039, "chapter_id": 21360, "verse_number": "५-७-४०", "content_sanskrit": "भिन्दिपालैर्विभियंते स्रवतः पूयशोणितम् ।\nशकृता कृमिदिग्धाश्च नीयंते विवशा नराः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001360040, "chapter_id": 21360, "verse_number": "५-७-४१", "content_sanskrit": "याचमानाश्च सलिलमन्नं वापि बुभुक्षिताः ।\nछायां प्रार्थयमानाश्च शीतार्ताश्चानलं पुनः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001360041, "chapter_id": 21360, "verse_number": "५-७-४२", "content_sanskrit": "दानहीनाः प्रयांत्येवं प्रार्थयंतस्सुखं नराः ।\nगृहीतदान पाथेयास्सुखं यांति यमालयम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001360042, "chapter_id": 21360, "verse_number": "५-७-४३", "content_sanskrit": "एवं न्यायेन कष्टेन प्राप्ताः प्रेतपुरं यदा ।\nप्रज्ञापितास्ततो दूतैर्निवेश्यंते यमाग्रतः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001360043, "chapter_id": 21360, "verse_number": "५-७-४४", "content_sanskrit": "तत्र ये शुभकर्म्माणस्तांस्तु सम्मानयेद्यमः ।\nस्वागतासनदानेन पाद्यार्घ्येण प्रियेण च॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001360044, "chapter_id": 21360, "verse_number": "५-७-४५", "content_sanskrit": "धन्या यूयं महात्मानो निगमोदितकारिणः ।\nयैश्च दिव्यसुखार्थाय भवद्भिस्सुकृतं कृतम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001360045, "chapter_id": 21360, "verse_number": "५-७-४६", "content_sanskrit": "दिव्यं विमानमारुह्य दिव्यस्त्रीभोगभूषितम् ।\nस्वर्गं गच्छध्वममलं सर्वकामसमन्वितम्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001360046, "chapter_id": 21360, "verse_number": "५-७-४७", "content_sanskrit": "तत्र भुक्त्वा महाभोगानंते पुण्यस्य संक्षयात् ।\nयत्किंचिदल्पमशुभं पुनस्तदिह भोक्ष्यथ॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001360047, "chapter_id": 21360, "verse_number": "५-७-४८", "content_sanskrit": "धर्म्मात्मानो नरा ये च मित्रभूत्वा इवात्मनः ।\nसौम्यं सुखं प्रपश्यंति धर्मराजत्वमेव च॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001360048, "chapter_id": 21360, "verse_number": "५-७-४९", "content_sanskrit": "ये पुनः क्रूरकर्म्माणस्ते पश्यंति भयानकम् ।\nदंष्ट्राकरालवदनं भृकुटीकुटिलेक्षणम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001360049, "chapter_id": 21360, "verse_number": "५-७-५०", "content_sanskrit": "ऊर्ध्वकेशं महाश्मश्रुमूर्ध्वप्रस्फुरिताधरम् ।\nअष्टादशभुजं क्रुद्धं नीलांजनचयोपमम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001360050, "chapter_id": 21360, "verse_number": "५-७-५१", "content_sanskrit": "सर्वायुधोद्धतकरं सर्वदण्डेन तर्जयन् ।\nमहामहिषमारूढं दीप्ताग्निसमलोचनम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001360051, "chapter_id": 21360, "verse_number": "५-७-५२", "content_sanskrit": "रक्तमाल्यांबरधरं महामेरुमिवोच्छ्रितम् ।\nप्रलयाम्बुदनिर्घोषं पिबन्निव महोदधिम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001360052, "chapter_id": 21360, "verse_number": "५-७-५३", "content_sanskrit": "ग्रसंतमिव शैलेन्द्रमुद्गिरंतमिवानलम् ।\nमृत्युश्चैव समीपस्थः कालानलसमप्रभुः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001360053, "chapter_id": 21360, "verse_number": "५-७-५४", "content_sanskrit": "कालश्चांजनसंकाशः कृतांतश्च भयानकः ।\nमारीचोग्रमहामारी कालरात्रिश्च दारुणा॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001360054, "chapter_id": 21360, "verse_number": "५-७-५५", "content_sanskrit": "विविधा व्याधयः कुष्ठा नानारूपा भयावहाः ।\nशक्तिशूलांकुशधराः पाशचक्रासिपाणयः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001360055, "chapter_id": 21360, "verse_number": "५-७-५६", "content_sanskrit": "वजतुंडधरा रुद्रा क्षुरतूणधनुर्द्धराः ।\nनानायुधधरास्सर्वे महावीरा भयंकराः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001360056, "chapter_id": 21360, "verse_number": "५-७-५७", "content_sanskrit": "असंख्याता महावीराः कालाञ्जनसमप्रभाः ।\nसर्वायुधोद्यतकरा यमदूता भयानकाः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001360057, "chapter_id": 21360, "verse_number": "५-७-५८", "content_sanskrit": "अनेन परिचारेण वृतं तं घोरदर्शनम् ।\nयमं पश्यंति पापिष्ठाश्चित्रगुप्तं च भीषणम्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001360058, "chapter_id": 21360, "verse_number": "५-७-५९", "content_sanskrit": "निर्भर्त्सयति चात्यंतं यमस्तान्पापकर्म्मणः ।\nचित्रगुप्तश्च भगवान्धर्म्मवाक्यैः प्रबोधयेत्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]