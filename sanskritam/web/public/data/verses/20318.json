[{"id": 7000318000, "chapter_id": 20318, "verse_number": "१-७२-१", "content_sanskrit": "व्यास उवाच ।\nदिव्यं रथं समास्थाय धनुर्हस्तो बलैर्युतः ।\nगत्वा च माधवं संख्ये देवासुरगणाग्रतः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000318001, "chapter_id": 20318, "verse_number": "१-७२-२", "content_sanskrit": "क्रोधेन महताविष्टो मधुर्निर्जरमर्दनः ।\nअब्रवीत्परुषं वाक्यमव्ययं हरिमीश्वरम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000318002, "chapter_id": 20318, "verse_number": "१-७२-३", "content_sanskrit": "नारायण न जानासि युद्धधर्ममितः कथम् ।\nअन्यायाद्दुर्वधोपायं कृत्वा नष्टो न शोचसि॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000318003, "chapter_id": 20318, "verse_number": "१-७२-४", "content_sanskrit": "अनेन पंकयोगेन व्यवहारा कृतस्य च ।\nसुरत्वं चोपनष्टं स्यादन्यसृष्टिं करोम्यहम्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000318004, "chapter_id": 20318, "verse_number": "१-७२-५", "content_sanskrit": "त्वामेव निहनिष्यामि सह देवगणैरिह ।\nइत्युक्त्वा धनुरादाय जघान विशिखैर्विभुम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000318005, "chapter_id": 20318, "verse_number": "१-७२-६", "content_sanskrit": "माधवस्तान्बिभेदाथ शरैर्वज्रसमप्रभैः ।\nबहुभिस्सर्वगात्रेषु जघान च मधुं ततः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000318006, "chapter_id": 20318, "verse_number": "१-७२-७", "content_sanskrit": "मायया छादितः सोभूद्दैत्यस्तं सुरसत्तमाः ।\nये वै शूराश्च रुद्राद्यास्त्रिदशास्सत्त्वधारिणः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000318007, "chapter_id": 20318, "verse_number": "१-७२-८", "content_sanskrit": "देव्यो नानाविधाश्चापि सायुधा वाहनान्विताः ।\nसेनान्यो गणपा देवा लोकेश हरविष्णवः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000318008, "chapter_id": 20318, "verse_number": "१-७२-९", "content_sanskrit": "अन्ये ग्रहादयो देवाः सर्वे युध्यन्ति संगताः ।\nविनष्टाश्च तदा देवा मधोर्वै मायया ध्रुवम्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000318009, "chapter_id": 20318, "verse_number": "१-७२-१०", "content_sanskrit": "संमुखे विमुखे चैव शरशक्त्यृष्टिवृष्टिभिः ।\nपतंति सहसा देवा भूमौ शस्त्राभिपीडिताः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000318010, "chapter_id": 20318, "verse_number": "१-७२-११", "content_sanskrit": "एतस्मिन्नंतरे विष्णुर्गृहीत्वा च सुदर्शनम् ।\nअसुरान्मायया देवान्जघान रणमूर्धनि॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000318011, "chapter_id": 20318, "verse_number": "१-७२-१२", "content_sanskrit": "अथ तेषां शिरांस्येष छित्वा चैव सहस्रशः ।\nपातयामास देवेशो दैत्यानां च सुरात्मनाम्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000318012, "chapter_id": 20318, "verse_number": "१-७२-१३", "content_sanskrit": "एवमन्यान्विभुर्दैत्यान्द्रावयामास संगरात् ।\nतं दृष्ट्वा मुनयो देवाः सर्वे विस्मयमाययुः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000318013, "chapter_id": 20318, "verse_number": "१-७२-१४", "content_sanskrit": "कर्णे कर्णे प्रजल्पंते देवा मुनिगणास्तथा ।\nसदा देवैकगोप्ता च हरिरव्यय ईश्वरः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000318014, "chapter_id": 20318, "verse_number": "१-७२-१५", "content_sanskrit": "सर्वसाक्षी त्वयं देवो दैत्यजिष्णुर्युगे युगे ।\nकथं हंति सुरान्सर्वान्कल्पांत इह जायते॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000318015, "chapter_id": 20318, "verse_number": "१-७२-१६", "content_sanskrit": "एतस्मिन्नंतरे दूरे मधुर्मायां प्रयोजिता ।\nहररूपधरो भूत्वा अब्रवीद्धरिमव्ययम्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000318016, "chapter_id": 20318, "verse_number": "१-७२-१७", "content_sanskrit": "दैत्यानामग्रतः पाप रणे देवान्समंततः ।\nहत्वा किं ते शिवं चाद्य धर्मकीर्ति यशो गुणाः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000318017, "chapter_id": 20318, "verse_number": "१-७२-१८", "content_sanskrit": "महतोन्मत्तभावेन न जानासि परान्स्वकान् ।\nअतस्त्वां निशितैर्बाणैर्नयामि यमसादनम्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000318018, "chapter_id": 20318, "verse_number": "१-७२-१९", "content_sanskrit": "एवमुक्त्वा शरैरुग्रैर्जघान केशवं रणे ।\nनिचकर्त शरांस्तांस्तु माधवो वाक्यमब्रवीत्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000318019, "chapter_id": 20318, "verse_number": "१-७२-२०", "content_sanskrit": "जानामि त्वां रणे दैत्यं हररूपधरं प्रियम् ।\nशूरं शूरविकर्माणं मधुं मायानियोजितम्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000318020, "chapter_id": 20318, "verse_number": "१-७२-२१", "content_sanskrit": "मिथ्यालोकं प्रदास्यामि पातयित्वा रणाजिरे ।\nएतस्मिन्नंतरे तीक्ष्णैः शरैर्विव्याध संयुगे॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000318021, "chapter_id": 20318, "verse_number": "१-७२-२२", "content_sanskrit": "जटिलं वृषकेतुं च वृषभस्थं महेश्वरम् ।\nतयोर्युद्धमतीवासीद्देवदानवयोस्तदा॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000318022, "chapter_id": 20318, "verse_number": "१-७२-२३", "content_sanskrit": "परस्परं भिंदतोश्च प्राप्तान्प्राप्तान्शरान्शरैः ।\nक्षुरप्रेण धनुस्तस्य चिच्छेद हरिरव्ययः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000318023, "chapter_id": 20318, "verse_number": "१-७२-२४", "content_sanskrit": "ततश्च पातयामास घोटकं वृषरूपिणम् ।\nस दैत्यश्शूलहस्तोथ प्रदुद्राव जगत्पतिम्॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000318024, "chapter_id": 20318, "verse_number": "१-७२-२५", "content_sanskrit": "भ्रामयित्वा ततः शूलं जघान परमेश्वरम् ।\nत्रिभिश्चिच्छेद बाणैश्च शूलं कालानलप्रभम्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000318025, "chapter_id": 20318, "verse_number": "१-७२-२६", "content_sanskrit": "ततः क्रूरो महाबाहुर्मधुर्मायातिमायिकः ।\nदेवीरूपं समास्थाय सिंहस्थः प्रययौ हरिः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000318026, "chapter_id": 20318, "verse_number": "१-७२-२७", "content_sanskrit": "शरैर्बहुविधैर्विष्णुं जघानैवाब्रवीद्वचः ।\nस्वामी तु मे सुरश्रेष्ठ त्वयैव पातितो युधि॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000318027, "chapter_id": 20318, "verse_number": "१-७२-२८", "content_sanskrit": "अहं त्वां च हनिष्यामि सुतौ स्कंदविनायकौ ।\nउक्तवंतं च दैतेयं जघान बहुमार्गणैः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000318028, "chapter_id": 20318, "verse_number": "१-७२-२९", "content_sanskrit": "स पपात महीपृष्ठे गतासुर्लोहितोद्गिरः ।\nपितरौ निहतौ दृष्ट्वा मायाबद्धो महाबलः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000318029, "chapter_id": 20318, "verse_number": "१-७२-३०", "content_sanskrit": "स्कंदः शक्तिं समादाय प्रायाद्योधयितुं हरिम् ।\nततो धाताऽब्रवीद्वाक्यं स्कंदं मोहप्रपीडितम्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000318030, "chapter_id": 20318, "verse_number": "१-७२-३१", "content_sanskrit": "पश्य ते पितरौ दूरे पश्यंतौ युद्धमीदृशम् ।\nअंतरिक्षे भ्रमंतौ च संस्थितौ लोकसाक्षिणौ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000318031, "chapter_id": 20318, "verse_number": "१-७२-३२", "content_sanskrit": "एतच्छ्रुत्वा ततो दृष्ट्वा तत्रैवांतरधीयत ।\nततो धुंधुश्च सुंधुश्च भ्रातरावतिदर्पितौ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000318032, "chapter_id": 20318, "verse_number": "१-७२-३३", "content_sanskrit": "वधं प्रति हरेर्युद्धे पेततुर्गरुडोपरि ।\nखड्गहस्तं च धुंधुं च सगदं सुंधुमेव च॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000318033, "chapter_id": 20318, "verse_number": "१-७२-३४", "content_sanskrit": "चिच्छेद नंदकेनैकं गदया सादयत्परम् ।\nपेततुस्तौ धरापृष्ठे प्रवीरौ क्षतविक्षतौ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000318034, "chapter_id": 20318, "verse_number": "१-७२-३५", "content_sanskrit": "मधुस्तदागतस्तूर्णमंतर्धानं तमोवृतः ।\nपातयामास विष्णौ च मायया शतपर्वतान्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000318035, "chapter_id": 20318, "verse_number": "१-७२-३६", "content_sanskrit": "ततस्तान्पर्वतांश्छित्वा तमसोऽन्तर्गतो युधि ।\nक्रोधात्सुदर्शनेनैव शिरश्छित्वा निपातितः॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000318036, "chapter_id": 20318, "verse_number": "१-७२-३७", "content_sanskrit": "ततो ब्रह्मादिभिर्देवैश्शंभुना त्रिदशैरपि ।\nमधुसूदन इतिख्यातिर्विष्णोर्लोकेषु कारिता॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]