[{"id": 2211339, "chapter_id": 5510, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2211340, "chapter_id": 5510, "verse_number": "१", "content_sanskrit": "विप्रयोगे शरीरस्य सेन्द्रियस्य विशेषतः ।\nअन्तरा वर्तमानस्य गतिः प्राणस्य कीदृशी ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2211341, "chapter_id": 5510, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2211342, "chapter_id": 5510, "verse_number": "२", "content_sanskrit": "शुभाशुभकृतं सर्वं प्राप्नोतीह फलं नरः ।\nन तु सर्वस्य भूतस्य पञ्चत्वं विद्यते नृप ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2211343, "chapter_id": 5510, "verse_number": "३", "content_sanskrit": "पञ्चत्वं पाण्डवश्रेष्ठ भूरिभूतिकरं नृणाम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2211344, "chapter_id": 5510, "verse_number": "४", "content_sanskrit": "तेषां पञ्च महायज्ञान् ये कुर्वन्ति द्विजोत्तमः ।\nपञ्चत्वं पञ्चभिर्भूतैर्वियोगं सम्प्रचक्षते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2211345, "chapter_id": 5510, "verse_number": "", "content_sanskrit": "न जायते न म्रियते पुरुषः शाश्वतः सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2211346, "chapter_id": 5510, "verse_number": "६", "content_sanskrit": "प्रायेण मरणं नाम पापिनामेव पाण्डव ।\nयेषां तु न गतिः पुण्या तेषां मरणमुच्यते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2211347, "chapter_id": 5510, "verse_number": "७", "content_sanskrit": "प्रायेणाकृतकृत्यस्तु मृत्योरुद्विजते जनः ।\nकृतकृत्याः प्रतीक्षन्ते मृत्युं प्रियमिवातिथिम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2211348, "chapter_id": 5510, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2211349, "chapter_id": 5510, "verse_number": "८", "content_sanskrit": "पञ्च यज्ञाः कथं देव क्रियन्तेऽत्र द्विजातिभिः ।\nतेषां नाम च देवेश कर्तुमर्हस्यशेषतः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2211350, "chapter_id": 5510, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2211351, "chapter_id": 5510, "verse_number": "९", "content_sanskrit": "शृणु पञ्च महायज्ञान् कीर्त्यमानान् युधिष्ठिर ।\nयैरेव ब्रह्मसालोक्यं लभन्ते गृहमेधिनः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2211352, "chapter_id": 5510, "verse_number": "१०", "content_sanskrit": "ऋषियज्ञं ब्रह्मयज्ञं भूतयज्ञं च पाण्डव ।\nनृयज्ञं पितृयज्ञं च पञ्च यज्ञान् प्रचक्षते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2211353, "chapter_id": 5510, "verse_number": "११", "content_sanskrit": "तर्पणं ऋषियज्ञः स्यात् स्वाध्यायो ब्रह्मयज्ञकम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2211354, "chapter_id": 5510, "verse_number": "१२", "content_sanskrit": "भूतयज्ञो बलिर्ज्ञेयो नृयज्ञोऽतिथिपूजनम् ।\nपितॄनुद्दिश्य यत्कर्म पितृयज्ञः प्रकीर्तितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2211355, "chapter_id": 5510, "verse_number": "१३", "content_sanskrit": "हुतं चाप्यहुतं चैव तथा प्रहुतमेव च ।\nप्राशितं बलिदानं च पाकयज्ञान् प्रचक्षते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2211356, "chapter_id": 5510, "verse_number": "१४", "content_sanskrit": "वैश्वदेवादयो होमा हुतमित्युच्यते बुधैः ।\nअहुतं च भवेद्दत्तं प्रहुतं ब्राह्मणाशितम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2211357, "chapter_id": 5510, "verse_number": "१५", "content_sanskrit": "प्राणाग्निहोत्रहोमं च प्राशितं विधिवद् विदुः ।\nबलिकर्म च राजेन्द्र पाकयज्ञाः प्रकीर्तिताः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2211358, "chapter_id": 5510, "verse_number": "१६", "content_sanskrit": "केचित् पञ्च महायज्ञान् पाकयज्ञान् प्रचक्षते ।\nअपरे ब्रह्मयज्ञादीन् महायज्ञविदो विदुः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2211359, "chapter_id": 5510, "verse_number": "१७", "content_sanskrit": "सर्व एते महायज्ञाः सर्वथा परिकीर्तिताः ।\nबुभुक्षितान् ब्राह्मणांस्तु यथाशक्ति न हापयेत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2211360, "chapter_id": 5510, "verse_number": "१८", "content_sanskrit": "अहन्यहनि ये त्वेतान् अकृत्वा भुञ्जते स्वयम् ।\nकेवलं मलमश्नन्ति ते नरा न च संशयः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2211361, "chapter_id": 5510, "verse_number": "१९", "content_sanskrit": "तस्मात् स्नात्वा द्विजो विद्वान् कुर्यादेतान् दिने दिने ।\nअतोऽन्यथा तु भुञ्जन् वै प्रायश्चित्ती भवेद् द्विजः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2211362, "chapter_id": 5510, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2211363, "chapter_id": 5510, "verse_number": "२०", "content_sanskrit": "देवदेव नमस्तेऽस्तु त्वद्भक्तस्य जनार्दन ।\nवक्तुमर्हसि देवेश स्नानस्य च विधिं मम ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2211364, "chapter_id": 5510, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2211365, "chapter_id": 5510, "verse_number": "२१", "content_sanskrit": "शृणु पाण्डव तत्सर्वं पवित्रं पापनाशनम् ।\nस्नात्वा येन विधानेन मुच्यन्ते किल्बिषाद् द्विजाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2211366, "chapter_id": 5510, "verse_number": "२२", "content_sanskrit": "मृदं च गोमयं चैव तिलान् दर्भांस्तथैव च ।\nपुष्पाण्यपि यथालाभमादाय तु जलं व्रजेत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2211367, "chapter_id": 5510, "verse_number": "२३", "content_sanskrit": "नद्यां सत्यां न च स्नायादन्यत्र द्विजसत्तमः ।\nसति प्रभूते पयसि नाल्पे स्नायात् कदाचन ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2211368, "chapter_id": 5510, "verse_number": "२४", "content_sanskrit": "गत्वोदकसमीपं तु शुचौ देशे मनोरमे ।\nततो मृद्गोमयादीनि तत्रावेक्ष्य विनिक्षिपेत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2211369, "chapter_id": 5510, "verse_number": "२५", "content_sanskrit": "बहिः प्रक्षाल्य पादौ च द्विराचम्य प्रयत्नतः ।\nप्रक्षिणं समावृत्य नमस्कुर्यात्तु तज्जलम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2211370, "chapter_id": 5510, "verse_number": "२६", "content_sanskrit": "न च प्रक्षालयेत् तीरमद्भिर्विद्वान् कदाचन ।\nन च पादेन वा हन्याद्धस्तेनान्येन तज्जलम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2211371, "chapter_id": 5510, "verse_number": "२७", "content_sanskrit": "सर्वदेवमया ह्यापो मन्मयाः पाण्डुनन्दन ।\nतस्मात् तास्तु न हन्तव्यास्त्वद्भिः प्रक्षालयेत् स्थळम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2211372, "chapter_id": 5510, "verse_number": "२८", "content_sanskrit": "केवलं प्रथमं मज्जेन्नाङ्गानि विमृजेद् बुधः ।\nतत् तीर्थं स समासाद्य कुर्यादाचमनं पुनः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2211373, "chapter_id": 5510, "verse_number": "२९", "content_sanskrit": "गोकर्णाकृतिवत् कृत्वा करं त्रिः प्रपिबेज्जलम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2211374, "chapter_id": 5510, "verse_number": "३०", "content_sanskrit": "द्विस्तत् परिमृजेद् वक्त्रं पादावभ्युक्ष्य चात्मनः ।\nशीर्षण्यांस्तु ततः प्राणान् सकृदेव तु संस्पृशेत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2211375, "chapter_id": 5510, "verse_number": "३१", "content_sanskrit": "बाहू द्वौ च ततः स्पृष्ट्वा हृदयं नाभिमेव च ।\nप्रत्यङ्गमुदकं स्पृष्ट्वा मूर्धानं तु ततः स्पृशेत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2211376, "chapter_id": 5510, "verse_number": "३२", "content_sanskrit": "आपः पुनन्त्वित्युक्त्वा च पुनराचमनं चरेत् ।\nसोङ्कारव्याहृतीर्वाऽपि सदसस्पतिमित्यृचम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2211377, "chapter_id": 5510, "verse_number": "३३", "content_sanskrit": "आचम्य मृत्तिकाः प्रश्चात् त्रिधाकृत्य समालभेत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2211378, "chapter_id": 5510, "verse_number": "३४", "content_sanskrit": "(ऋचेदं विष्णुरित्यङ्गमुत्तमाधममध्यमम् ।\nआलभ्य वारुणैः सूक्तैर्नमस्कृत्य जलं ततः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2211379, "chapter_id": 5510, "verse_number": "३५", "content_sanskrit": "स्रवन्त्यां चेत् प्रतिस्रोतः प्रत्यर्कं चान्यवारिषु ।\nमज्जेदोमित्युदाहृत्य न च विक्षोभयेज्जलम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2211380, "chapter_id": 5510, "verse_number": "३६", "content_sanskrit": "गोमयं च त्रिधा कृत्वा जले पूर्वं समालभेत् ।)\nसव्याहृतिं सप्रणवां गायत्रीं च पुनर्जपेत् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2211381, "chapter_id": 5510, "verse_number": "३७", "content_sanskrit": "पुनराचमनं कृत्वा मद्गतेनान्तरात्मना ।\nआपोहिष्ठेति तिसृभिर्दर्भपूतेन वारिणा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2211382, "chapter_id": 5510, "verse_number": "३८", "content_sanskrit": "तथा तरत्समन्दीभिः सिञ्चेच्चतसृभिः क्रमात् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2211383, "chapter_id": 5510, "verse_number": "३९", "content_sanskrit": "गोसूक्तेनाश्वसूक्तेन शुद्धवर्णे(र्गे)ण चाप्यथ ।\nवैष्णवैर्वारुणैः सूक्तैः सावित्रैरिन्द्रदेवतैः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2211384, "chapter_id": 5510, "verse_number": "४०", "content_sanskrit": "वामदैव्येन चात्मानमन्यैर्मन्मयसामभिः ।\nस्थित्वाऽन्तःसलिले सूक्तं जपेद्वाचाऽघमर्षणम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2211385, "chapter_id": 5510, "verse_number": "४१", "content_sanskrit": "सव्याहृतीकां सप्रणवां गायत्रीं वा ततो जपेत् ।\nआश्वासमुक्तान् प्रणवं जपेद् वा मामनुस्मरन् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2211386, "chapter_id": 5510, "verse_number": "४२", "content_sanskrit": "उत्प्लुत्य तीरमासाद्य धौते शुक्ले च वाससी ।\nशुद्धे चाच्छादयेत् कक्षेऽनुकुर्यात् परिपाशकम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2211387, "chapter_id": 5510, "verse_number": "४३", "content_sanskrit": "पाशेन बद्ध्वा कक्षे यत् कुरुते कर्म वैदिकम् ।\nराक्षसा दानवा दैत्यास्तद् विलुम्पन्ति हर्षिताः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2211388, "chapter_id": 5510, "verse_number": "४४", "content_sanskrit": "तस्मात् सर्वप्रयत्नेन कच्छपाशे न धारयेत् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2211389, "chapter_id": 5510, "verse_number": "४५", "content_sanskrit": "ततः प्रक्षाल्य पादौ द्वौ हस्तौ चैव मृदा शनैः ।\nआचम्य पुनराचामेत् ततः सावित्रिया द्विजः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2211390, "chapter_id": 5510, "verse_number": "४६", "content_sanskrit": "प्राङ्मुखोदङ्मुखो वाऽपि ध्यायन् वेदान् समाहितः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2211391, "chapter_id": 5510, "verse_number": "४७", "content_sanskrit": "जले जलगतः शुद्धः स्थल एव स्थले स्थितः ।\nउभयत्र स्थितस्तस्माद् आचामेदात्मशुद्धये ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2211392, "chapter_id": 5510, "verse_number": "४८", "content_sanskrit": "दर्भेषु दर्भपाणिः सन् प्राङ्मुखः सुसमाहितः ।\nप्राणायामांस्ततः कुर्यात् मद्गतेनान्तरात्मना ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2211393, "chapter_id": 5510, "verse_number": "४९", "content_sanskrit": "सहस्रकृत्वः सावित्रीं शतकृत्वस्तु वा जपेत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2211394, "chapter_id": 5510, "verse_number": "५०", "content_sanskrit": "समाप्ते तु जपे तस्मिन् सावित्र्या चाभिमन्त्र्य च ।\nमन्देहानां विनाशाय रक्षसां विक्षिपेज्जलम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2211395, "chapter_id": 5510, "verse_number": "५१", "content_sanskrit": "उद्वर्गोऽसीत्यथाचान्तः प्रायश्चित्तजलं क्षिपेत् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2211396, "chapter_id": 5510, "verse_number": "५२", "content_sanskrit": "अथादाय सुपुष्पाणि तोयान्यञ्जलिना द्विजः ।\nप्रक्षिप्य प्रतिसूर्यं च व्योममुद्रां प्रकल्पयेत् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2211397, "chapter_id": 5510, "verse_number": "५३", "content_sanskrit": "ततो द्वादशकृत्वस्तु सूर्यस्यैकाक्षरं जपेत् ।\nततः षडक्षरादीनि त्रिः कृत्वः परिवर्तयेत् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2211398, "chapter_id": 5510, "verse_number": "५४", "content_sanskrit": "प्रदक्षिणं परामृज्य मुद्रया स्वमुखं तया ।\nऊर्ध्वबाहुस्ततो भूत्वा सूर्यमीक्षेत् समाहितः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2211399, "chapter_id": 5510, "verse_number": "५५", "content_sanskrit": "तन्मण्डलस्थं मां ध्यायेत् तेजोमूर्तिं चतुर्भुजम् ।\nउदुत्यं च जपेन्मन्त्रं चित्रं तच्चक्षुरित्यपि ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2211400, "chapter_id": 5510, "verse_number": "५६", "content_sanskrit": "सावित्रीं च यथाशक्ति जप्त्वा सूक्तं च मामकम् ।\nमन्मयानि च सामानि पुरुषव्रतमेव च ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2211401, "chapter_id": 5510, "verse_number": "५७", "content_sanskrit": "ततश्चालोकयेदर्कं हंसःशुचिषदित्यृचा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2211402, "chapter_id": 5510, "verse_number": "५८", "content_sanskrit": "प्रदक्षिणं समावृत्य नमस्कृत्य दिवाकरम् ।\nततस्तु तर्पयेदद्भिर्मां ब्रह्माणं च शङ्करम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2211403, "chapter_id": 5510, "verse_number": "५९", "content_sanskrit": "प्रजापतिं च देवांश्च तथा देवमुनीनपि ।\nसाङ्गानपि तथा वेदानितिहासान् क्रतूंस्तथा ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2211404, "chapter_id": 5510, "verse_number": "६०", "content_sanskrit": "पुराणानि च दिव्यानि कुलान्यप्सरसां तथा ।\nऋतून् संवत्सरांश्चैव कालान् कालात्मकं तथा ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2211405, "chapter_id": 5510, "verse_number": "६१", "content_sanskrit": "भूतग्रामांश्च भूतानि सरितः सागरांस्तथा ।\nशैलान् शैलस्थितान् देवान् ओषधीः सवनस्पतीः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2211406, "chapter_id": 5510, "verse_number": "६२", "content_sanskrit": "तर्पयेदुपवीती तु प्रत्येकं तृप्यतामिति ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2211407, "chapter_id": 5510, "verse_number": "६३", "content_sanskrit": "अन्वारभ्य च सव्येन पाणिना दक्षिणेन तु ।\nनिवीती तर्पयेत् पश्चाद् ऋषीन् मन्त्रकृतस्तथा ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2211408, "chapter_id": 5510, "verse_number": "६४", "content_sanskrit": "मरीच्यादिमुनींश्चैव नारदान्तान् समाहितः ।\nप्राचीनावीत्यथैतांस्तु तर्पयेद् देवताः पितॄन् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2211409, "chapter_id": 5510, "verse_number": "६५", "content_sanskrit": "ततस्तु कव्यवाडग्निं सोमं वैवस्वतं तथा ।\nततश्चार्यमणं चापि अग्निष्वात्तांस्तथैव च ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2211410, "chapter_id": 5510, "verse_number": "६६", "content_sanskrit": "सोमपांश्चैव दर्भेषु सतिलैरेव वारिभिः ।\nतृप्यतामिति पश्चात्तु स्वपितॄंस्तर्पयेत् पुनः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2211411, "chapter_id": 5510, "verse_number": "६७", "content_sanskrit": "पितॄन् पितामहांश्चैव तथैव प्रपितामहान् ।\nपितामहीः तथा चापि तथैव प्रपितामहीः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2211412, "chapter_id": 5510, "verse_number": "६८", "content_sanskrit": "तथा पितृष्वसॄश्चैव मातृष्वसॄस्तथैव च ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2211413, "chapter_id": 5510, "verse_number": "६९", "content_sanskrit": "मातरं चात्मनश्चैव तथा मातामहीमपि ।\nमातुर्मातामहीं चैव गुरुमाचार्यमेव च ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2211414, "chapter_id": 5510, "verse_number": "७०", "content_sanskrit": "उपाध्यायान् सखीन् बन्धून् शिष्यर्त्विग्ज्ञातिपुत्रकान् ।\nप्रमीतानानृशंस्यार्थं तर्पयेत् तानमत्सरः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2211415, "chapter_id": 5510, "verse_number": "७१", "content_sanskrit": "तर्पयित्वा तथाऽऽचम्य स्नानवस्त्रं प्रपीडयेत् ।\nवृद्धिं भृत्यजनस्याहुः स्नानं पानं च तद्विदः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2211416, "chapter_id": 5510, "verse_number": "७२", "content_sanskrit": "अतर्पयित्वा तान् पूर्वं स्नानवस्त्रं न पीडयेत् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2211417, "chapter_id": 5510, "verse_number": "७३", "content_sanskrit": "पीडयेच्चेत् पुरा मोहाद् देवाः सर्षिगणास्तथा ।\nपितरश्च निराशास्ते शप्त्वा यान्ति यथागतम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2211418, "chapter_id": 5510, "verse_number": "७४", "content_sanskrit": "प्रक्षाल्य च मृदा पादावाचम्य प्रयतः पुनः ।\nदर्भेषु दर्भपाणिः सन् स्वाध्यायं तु समारभेत् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2211419, "chapter_id": 5510, "verse_number": "७५", "content_sanskrit": "वेदमादौ समारभ्य ततोपर्युपरि क्रमात् ।\nयदधीते स्वयं शक्त्या तत् स्वाध्यायं प्रचक्षते ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2211420, "chapter_id": 5510, "verse_number": "७६", "content_sanskrit": "ऋचं वाथ यजुर्वाऽपि सामगाथामथापि च ।\nइतिहासपुराणानि यथाशक्ति न हापयेत् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2211421, "chapter_id": 5510, "verse_number": "७७", "content_sanskrit": "उत्थाय तु नमस्कृत्य दिशो दिग्देवता अपि ।\nब्रह्माणं च ततश्चाग्निं पृथिवीमोषधीस्तथा ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2211422, "chapter_id": 5510, "verse_number": "७८", "content_sanskrit": "वाचं वाचस्पतिं चैव मां चैव सरितस्तथा ।\nनमस्कृत्वा तथाऽद्भिस्तु प्रणवादि च पूजयेत् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2211423, "chapter_id": 5510, "verse_number": "७९", "content_sanskrit": "ततो नमोऽद्भ्य इत्युक्त्वा नमस्कुर्यात्तु तज्जलम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2211424, "chapter_id": 5510, "verse_number": "८०", "content_sanskrit": "घृणिः सूर्यस्तथाऽऽदित्यस्त्रिः स्वमूर्ध्नि ततो जलैः ।\nसिक्त्वाऽवलोकयेदर्कं प्रणवेन समाहितः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2211425, "chapter_id": 5510, "verse_number": "८१", "content_sanskrit": "ततो मामर्चयेत् पुष्पैर्मत्प्रियैरेव नित्यशः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2211426, "chapter_id": 5510, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2211427, "chapter_id": 5510, "verse_number": "८२", "content_sanskrit": "त्वत्प्रियाणि प्रसूनानि त्वदनिष्टानि माधव ।\nसर्वाण्याचक्ष्व देवेश त्वद्भक्तस्य ममाच्युत ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2211428, "chapter_id": 5510, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2211429, "chapter_id": 5510, "verse_number": "८३", "content_sanskrit": "शणुष्वावहितो राजन् पुष्पाणि प्रियकृन्ति मे ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2211430, "chapter_id": 5510, "verse_number": "८४", "content_sanskrit": "कुमुदं करवीरं च चणकं चम्पकं तथा ।\nमल्लिका जातिपुष्पं च नन्द्यावर्तं च नन्दिकम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2211431, "chapter_id": 5510, "verse_number": "८५", "content_sanskrit": "पलाशपुष्पपत्राणि दूर्वा भृङ्गकमेव च ।\nवनमाला च राजेन्द्र मत्प्रियाणि विशेषतः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2211432, "chapter_id": 5510, "verse_number": "८६", "content_sanskrit": "सर्वेषामपि पुष्पाणां सहस्रगुणमुत्पलम् ।\nतस्मात् पद्मं तथा राजन् पद्मात्तु शतपत्रकम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2211433, "chapter_id": 5510, "verse_number": "८७", "content_sanskrit": "तस्मात् सहस्रपत्रं तु पुण्डरीकं ततः परम् ।\nपुण्डरीकसहस्रात्तु तुलसी गुणतोऽधिका ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2211434, "chapter_id": 5510, "verse_number": "८८", "content_sanskrit": "बकपुष्पं ततः तस्मात् सौवर्णं तु ततोऽधिकम् ।\nसौवर्णात्तु प्रसूनाच्च मत्प्रियं नास्ति पाण्डव ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2211435, "chapter_id": 5510, "verse_number": "८९", "content_sanskrit": "पुष्पालाभे तुलस्यास्तु पत्रैर्मामर्चयेद् बुधः ।\nपत्रालाभे तु शाखाभिः शाखालाभे शिफाफलैः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2211436, "chapter_id": 5510, "verse_number": "९०", "content_sanskrit": "शिफालाभे मृदा तत्र भक्तिमानर्चयेत माम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2211437, "chapter_id": 5510, "verse_number": "", "content_sanskrit": "(येन केन प्रकारेण तुलसीदलपूर्वकैः ।\nपुष्पैः फलैर्वाऽप्यन्नाद्यैर्मदाराधनमुत्तमम् ॥९१॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2211438, "chapter_id": 5510, "verse_number": "९२", "content_sanskrit": "वर्जनीयानि पुष्पाणि शृणु राजन् समाहितः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2211439, "chapter_id": 5510, "verse_number": "९३", "content_sanskrit": "किङ्किणी मुनिपुष्पं च दुत्तूरं पाटलं तथा ।\nतथाऽतिमुक्तकं चैव पुन्नागं नक्तमालिकाम् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2211440, "chapter_id": 5510, "verse_number": "९४", "content_sanskrit": "यौधिकं क्षीरिकापुष्पं निर्गुण्डी लाङ्गुली जपा ।\nकर्णिकारं तथाऽशोकं शाल्मलीपुष्पमेव च ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2211441, "chapter_id": 5510, "verse_number": "९५", "content_sanskrit": "ककुभाः कोविदारश्च वैभीतकमथापि च ।\nकुरण्टकप्रसूनं च कल्पकं लाङ्गली तथा ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2211442, "chapter_id": 5510, "verse_number": "९६", "content_sanskrit": "अङ्कोलं गिरिकर्णी च नीलान्येव च सर्वशः ।\nएकवर्णानि चान्यानि सर्वाण्येव विवर्जयेत् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2211443, "chapter_id": 5510, "verse_number": "९७", "content_sanskrit": "अर्कपुष्पाणि वर्ज्यानि चार्कपत्रस्थितानि च ।\nव्याघातपिचुमन्दानि सर्वाण्येव विवर्जयेत् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2211444, "chapter_id": 5510, "verse_number": "९८", "content_sanskrit": "अन्यैस्तु शुक्लपत्रैश्च गन्धवद्भिर्नराधिप ।\nअवर्ज्यैस्तैर्यथालाभं मद्भक्तो मां समर्चयेत् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2211445, "chapter_id": 5510, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2211446, "chapter_id": 5510, "verse_number": "९९", "content_sanskrit": "कथं त्वमर्चनीयोऽसि मूर्तयः कीदृशास्तु ते ।\nवैखानसाः कथं ब्रूयुः कथं वा पाञ्चरात्रिकाः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2211447, "chapter_id": 5510, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2211448, "chapter_id": 5510, "verse_number": "१००", "content_sanskrit": "शृणु पाण्डव तत्सर्वमर्चनाक्रममात्मनः ।\nस्थण्डिले पद्मकं कृत्वा चाष्टपत्रं सकर्णिकम् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2211449, "chapter_id": 5510, "verse_number": "१०१", "content_sanskrit": "अष्टाक्षरविधानेन ह्यथवा द्वादशाक्षरैः ।\nवैदिकैरथवा मन्त्रैर्मम सूक्तेन वा पुनः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2211450, "chapter_id": 5510, "verse_number": "१०२", "content_sanskrit": "स्थापितं मां ततस्तस्मिन्नर्चयित्वा विचक्षणः ।\nपुरुषं च ततः सत्यमच्युतं च युधिष्ठिर ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2211451, "chapter_id": 5510, "verse_number": "१०३", "content_sanskrit": "अनिरुद्धं च मां प्राहुर्वैखानसविदो जनाः ।\nअन्ये त्वेवं विजानन्ति मां राजन् पाञ्चरात्रिकाः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2211452, "chapter_id": 5510, "verse_number": "१०४", "content_sanskrit": "वासुदेवं च राजेन्द्र सङ्कर्षणमथापि वा ।\nप्रद्युम्नमनिरुद्धं च चतुर्मूर्तिं प्रचक्षते ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2211453, "chapter_id": 5510, "verse_number": "१०५", "content_sanskrit": "एताश्चान्याश्च राजेन्द्र सञ्ज्ञाभेदेन मूर्तयः ।\nविद्ध्यनर्थान्तरा एवं मामेवं चार्चयेद् बुधः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2211454, "chapter_id": 5510, "verse_number": "", "content_sanskrit": "(अत्यन्तभेदरहितं गुणपूर्णं सदैव हि ॥१०६॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2211455, "chapter_id": 5510, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2211456, "chapter_id": 5510, "verse_number": "१०७", "content_sanskrit": "त्वद्भक्ताः कीदृशा देव कानि तेषां व्रतानि च ।\nएतत् कथय देवेश त्वद्भक्तस्य ममाच्युत ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2211457, "chapter_id": 5510, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2211458, "chapter_id": 5510, "verse_number": "१०८", "content_sanskrit": "अनन्यदेवताभक्ता ये मद्भक्तजनप्रियाः ।\nमामेव शरणं प्राप्तास्ते मद्भक्ताः प्रकीर्तिताः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2211459, "chapter_id": 5510, "verse_number": "१०९", "content_sanskrit": "स्वर्ग्याण्यपि यशस्यानि मत्प्रियाणि विशेषतः ।\nमद्भक्तः पाण्डवश्रेष्ठ व्रतानीमानि धारयेत् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2211460, "chapter_id": 5510, "verse_number": "११०", "content_sanskrit": "नान्यदाच्छादयेद् वस्त्रं मद्भक्तो जलतारणे ।\nस्वस्थस्तु न दिवा स्वप्येन्मधुमांसानि वर्जयेत् ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2211461, "chapter_id": 5510, "verse_number": "१११", "content_sanskrit": "प्रदक्षिणं व्रजेद् विप्रान् गामश्वत्थं हुताशनम् ।\nन धावेत् पतिते वर्षे नाग्रभिक्षां च लोपयेत् ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2211462, "chapter_id": 5510, "verse_number": "११२", "content_sanskrit": "प्रत्यक्षलवणं नाद्यात् शोभाञ्जनकरञ्जनौ ।\nग्रासमुष्टिं गवे दद्याद् धान्याम्लं चैव वर्जयेत् ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2211463, "chapter_id": 5510, "verse_number": "११३", "content_sanskrit": "तथा पर्युषितं चापि पक्वं परगृहागतम् ।\nनिवेदितं च यद् द्रव्यं तत् प्रयत्नेन वर्जयेत् ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2211464, "chapter_id": 5510, "verse_number": "११४", "content_sanskrit": "विभीतककरञ्जानां छायां दूरात् तु वर्जयेत् ।\nविप्रदेवपरीवादं न वदेत् पीडितोऽपि सन् ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2211465, "chapter_id": 5510, "verse_number": "११५", "content_sanskrit": "सात्विका राजसाश्चापि तामसाश्चापि पाण्डव ।\nमामर्चयन्ति मद्भक्तास्तेषामीदृग्विधा गतिः ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2211466, "chapter_id": 5510, "verse_number": "११६", "content_sanskrit": "तामसास्तिमिरं यान्ति राजसा रज एव तत् ।\nसात्विकाः सत्वसम्पन्नाः सत्वमेव प्रयान्ति ते ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2211467, "chapter_id": 5510, "verse_number": "११७", "content_sanskrit": "ये सिद्धाः सन्ति साङ्ख्येन योगसत्वबलेन च ।\nनभस्यादित्यचन्द्राभ्यां पश्यन्ति पदविस्तरम् ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2211468, "chapter_id": 5510, "verse_number": "११८", "content_sanskrit": "एकस्तम्भे नवद्वारे त्रिस्थूणे पञ्चधातुके ।\nएतस्मिन् देहनगरे राजसस्तु सदा भवेत् ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2211469, "chapter_id": 5510, "verse_number": "११९", "content_sanskrit": "उदिते सवितर्याप्यक्रियायुक्तस्य धीमतः ।\nचतुर्वेदविदश्चापि देहे षड् वृषलाः स्मृताः ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2211470, "chapter_id": 5510, "verse_number": "१२०", "content_sanskrit": "क्षत्रियाः सप्त विज्ञेया वैश्यास्त्वष्टौ प्रकीर्तिताः ।\nनियताः पाण्डवश्रेष्ठ शूद्राणामेकविंशतिः ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2211471, "chapter_id": 5510, "verse_number": "१२१", "content_sanskrit": "कामः क्रोधश्च लोभश्च मोहश्च मद एव च ।\nमहामोहश्च इत्येते देहे षड् वृषलाः स्मृताः ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2211472, "chapter_id": 5510, "verse_number": "१२२", "content_sanskrit": "गर्वः स्तम्भो ह्यहङ्कार ईर्ष्या च द्रोह एव च ।\nपारुष्यं क्रूरता चेति सप्तैते क्षत्रियाः स्मृताः ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2211473, "chapter_id": 5510, "verse_number": "१२३", "content_sanskrit": "तीक्ष्णता निकृतिर्माया शाठ्यं डम्भो ह्यनार्जवम् ।\nपैशुन्यमनृतं चैव वैश्यास्त्वष्टौ प्रकीर्तिताः ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2211474, "chapter_id": 5510, "verse_number": "१२४", "content_sanskrit": "तृष्णा बुभुक्षा निद्रा च ह्यालस्यं चाघृणाऽदया ।\nआधिश्चापि विषादश्च प्रमादो हीनसत्वता ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 2211475, "chapter_id": 5510, "verse_number": "१२५", "content_sanskrit": "भयं विक्लबता जाड्यं पापकं मन्युरेव च ।\nआशा चाश्रद्दधानत्वमनवस्थाप्यमन्त्रणम् ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 2211476, "chapter_id": 5510, "verse_number": "१२६", "content_sanskrit": "अशौचं मलिनत्वं च शूद्रा ह्येते प्रकीर्तिताः ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 2211477, "chapter_id": 5510, "verse_number": "१२७", "content_sanskrit": "यस्मिन्नेते न दृश्यन्ते स वै ब्राह्मण उच्यते ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 2211478, "chapter_id": 5510, "verse_number": "१२८", "content_sanskrit": "येषु येषु हि भावेषु यत्कालं वर्तते द्विजः ।\nतत्तत्कालं स विज्ञेयो ब्राह्मणो ज्ञानदुर्बलः ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 2211479, "chapter_id": 5510, "verse_number": "१२९", "content_sanskrit": "प्राणानायम्य यत्काले यो मां चापि विचिन्तयेत् ।\nतत्काले वै द्विजो ज्ञेयः शेषकाले ह्यथेतरः ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 2211480, "chapter_id": 5510, "verse_number": "१३०", "content_sanskrit": "तस्मात्तु सात्विको भूत्वा शुचिः क्रोधविवर्जितः ।\nमामर्चयेत्तु सततं मत्प्रियत्वं यदीच्छति ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 2211481, "chapter_id": 5510, "verse_number": "१३१", "content_sanskrit": "अलोलजिह्वः समुपस्थितो धृतिं\nनिधाय चक्षुर्युगमात्रमेव च ।\nमनश्च वाचं च निगृह्य चञ्चलं\nभयान्निवृत्तो मम भक्त उच्यते ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 2211482, "chapter_id": 5510, "verse_number": "१३२", "content_sanskrit": "ईदृशा ध्यानिनो ये तु ब्राह्मणा नियतेन्द्रियाः ।\nतेषां श्राद्धेषु तृप्यन्ति तेन तृप्ताः पितामहाः ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 2211483, "chapter_id": 5510, "verse_number": "१३३", "content_sanskrit": "धर्मो जयति नाधर्मः सत्यं जयति नानृतम् ।\nक्षमा जयति न क्रोधः क्षमावान् ब्राह्मणो भवेत् ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 2211484, "chapter_id": 5510, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि वैष्णवधर्मशास्त्रे भक्तलक्षणकथनं नाम चतुरधिकशततमोऽध्यायः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}]