[{"id": 2042918, "chapter_id": 1959, "verse_number": "६-८-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2042919, "chapter_id": 1959, "verse_number": "६-८-१", "content_sanskrit": "वर्षाणां चैव नामानि पर्वतानां च संजय।\nआचक्ष्व मे यथातत्त्वं ये च पर्वतवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2042920, "chapter_id": 1959, "verse_number": "६-८-२x", "content_sanskrit": "संजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2042921, "chapter_id": 1959, "verse_number": "६-८-२", "content_sanskrit": "दक्षिणेन तु श्वेतस्य नीलस्यैवोत्तरेण तु।\nवर्षं रमणकं नाम जायन्ते तत्र मानवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2042922, "chapter_id": 1959, "verse_number": "६-८-३", "content_sanskrit": "शुक्लाभिजनसंपन्नाः सर्वे सुप्रियदर्शनाः।\nनिःसपत्नाश्च ते सर्वे जायन्ते तत्र मानवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2042923, "chapter_id": 1959, "verse_number": "६-८-४", "content_sanskrit": "दशवर्षसहस्राणि शतानि दश पञ्च च।\nजीवन्ति ते महाराज नित्यं मुदितमानसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2042924, "chapter_id": 1959, "verse_number": "६-८-५", "content_sanskrit": "दक्षिणे शृङ्गिणश्चैव श्वेतस्याथोत्तरेण तु।\nवर्षं हिरण्मयं नाम यत्र हैरण्वती नदी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2042925, "chapter_id": 1959, "verse_number": "६-८-६", "content_sanskrit": "यत्र चायं महाराज पक्षिराट् पतगोत्तमः।\nयक्षानुगा महाराज धनिनः प्रियदर्शनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2042926, "chapter_id": 1959, "verse_number": "६-८-७", "content_sanskrit": "महाबलास्तत्र जना राजन्मुदितमानसाः।\nएकादशसहस्राणि वर्षाणां ते जनाधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2042927, "chapter_id": 1959, "verse_number": "६-८-८", "content_sanskrit": "आयुःप्रमाणं जीवन्ति शतानि दश पञ्च च।\nश्रृङ्गाणि वै श्रृङ्गवतस्त्रीण्येव मनुजाधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2042928, "chapter_id": 1959, "verse_number": "६-८-९", "content_sanskrit": "एकं मणिमयं तत्र तथैकं रौक्ममद्भुतम् ।\nसर्वरत्नमयं चैकं भवनैरुपशोभितम् ।\nतत्र स्वयंप्रभा देवी नित्यं वसति शाण्डिली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2042929, "chapter_id": 1959, "verse_number": "६-८-१०", "content_sanskrit": "उत्तरेण तु श्रृङ्गस्य समुद्रान्ते जनाधिप ।\nवर्षमैरावतं नाम तस्माच्छृङ्गवतः परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2042930, "chapter_id": 1959, "verse_number": "६-८-११", "content_sanskrit": "न तत्र सूर्यस्तपति न जीर्यन्ते च मानवाः ।\nचन्द्रमाश्च सनक्षत्रो ज्योतिर्भूत इवावृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2042931, "chapter_id": 1959, "verse_number": "६-८-१२", "content_sanskrit": "पद्मप्रभाः पद्मवर्णाः पद्मपत्रनिभेक्षणाः ।\nपद्मपत्रसुगन्धाश्च जायन्ते तत्र मानवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2042932, "chapter_id": 1959, "verse_number": "६-८-१३", "content_sanskrit": "अनिष्पन्दा इष्टगन्धा निराहारा जितेन्द्रियाः ।\nदेवलोकच्युताः सर्वे तथा विरजसो नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2042933, "chapter_id": 1959, "verse_number": "६-८-१४", "content_sanskrit": "त्रयोदशसहस्राणि वर्षाणां ते जनाधिप ।\nआयुःप्रमाणं जीवन्ति नरा भरतसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2042934, "chapter_id": 1959, "verse_number": "६-८-१५", "content_sanskrit": "क्षीरोदस्य समुद्रस्य तथैवोत्तरतः प्रभुः ।\nहरिर्वसति वैकुण्ठः शकटे कनकोञ्ज्वले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2042935, "chapter_id": 1959, "verse_number": "६-८-१६", "content_sanskrit": "अष्टचक्रं हि तद्यानं भूतयुक्तं मनोजवम् ।\nअग्निवर्णं महातेजो जाम्बूनदविभूषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2042936, "chapter_id": 1959, "verse_number": "६-८-१७", "content_sanskrit": "स प्रभुः सर्वभूतानां विभुश्च भरतर्षभ ।\nसंक्षेपो विस्तरश्चैव कर्ता कारयिता तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2042937, "chapter_id": 1959, "verse_number": "६-८-१८", "content_sanskrit": "पृथिव्यापस्तथाऽऽकाशं वायुस्तेजश्च पार्थिव ।\nस यज्ञः सर्वभूतनामास्यं तस्य हुताशनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2042938, "chapter_id": 1959, "verse_number": "६-८-१९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2042939, "chapter_id": 1959, "verse_number": "६-८-१९", "content_sanskrit": "एवमुक्तः संजयेन धृतराष्ट्रो महामनाः।\nध्यानमन्वगमद्राजा पुत्रान्प्रति जनाधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2042940, "chapter_id": 1959, "verse_number": "६-८-२०", "content_sanskrit": "स विचिन्त्य महातेजाः पुनरेवाब्रवीद्वचः।\nअसंशयं सूतपुत्र कालः संक्षिपते जगत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2042941, "chapter_id": 1959, "verse_number": "६-८-२१", "content_sanskrit": "सृजते च पुनः सर्वं नेह विद्यति शाश्वतम् ।\nनरो नारायणश्चैव सर्वज्ञः सर्वभूतहृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2042942, "chapter_id": 1959, "verse_number": "६-८-२२", "content_sanskrit": "देवा वैकुण्ठ इत्याद्दुर्वेदा विष्णुरिति प्रभुम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2042943, "chapter_id": 1959, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि जम्बूखण़्डविनिर्माणपर्वणि अष्टमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]