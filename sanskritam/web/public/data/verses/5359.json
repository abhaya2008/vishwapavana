[{"id": 2204559, "chapter_id": 5359, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2204560, "chapter_id": 5359, "verse_number": "१", "content_sanskrit": "भगवन् देवदेवेश श्रुतं मे परमं हितम् ।\nआत्मनो जातिसम्बन्धं ब्रूहि स्त्रीपुरुषान्तरे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2204561, "chapter_id": 5359, "verse_number": "२", "content_sanskrit": "स्त्रीप्राणः पुरुषप्राण एकः स पृथगेव वा ।\nएष मे संशयो देव तं मे छेत्तुं त्वमर्हसि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2204562, "chapter_id": 5359, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2204563, "chapter_id": 5359, "verse_number": "३", "content_sanskrit": "तदहं ते प्रवक्ष्यामि शृणु सर्वं समाहिता ।\nपुंस्त्वं स्त्रीत्वमिति प्राणे स्थितिर्नास्ति शुभेक्षणे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2204564, "chapter_id": 5359, "verse_number": "४", "content_sanskrit": "निर्विकारी सदा चात्मा स्त्रीत्वं पुंस्त्वं न चात्मनि ।\nकर्मप्रकारेण तथा जात्यां जात्यां प्रजायते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2204565, "chapter_id": 5359, "verse_number": "५", "content_sanskrit": "अकर्ता चाविकारी च नित्यश्च पुरुषः स्मृतः ।\nस्त्रीशरीरकृतं कर्म स्त्रीभावेनोपभुज्यते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2204566, "chapter_id": 5359, "verse_number": "६", "content_sanskrit": "पुरुषेण कृतं कर्म पुरुषेणैव भुज्यते ।\nएवं प्रसज्यते लोके भावैकत्वेन भूयशः ।\nशरीरं कर्मनानात्वाद् दृश्यते विपरीतवत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2204567, "chapter_id": 5359, "verse_number": "७", "content_sanskrit": "कृत्वा तु पौरुषं कर्म स्त्री पुमानपि जायते ।\nस्त्रीभावयुक् पुमान्कृत्वा कर्मणा प्रमदा भवेत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2204568, "chapter_id": 5359, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2204569, "chapter_id": 5359, "verse_number": "८", "content_sanskrit": "भगवन् सर्वलोकेश यद्यात्मा न करोति चेत् ।\nकोऽन्यः कर्मकरस्तत्र देहे तद् वक्तुमर्हसि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2204570, "chapter_id": 5359, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2204571, "chapter_id": 5359, "verse_number": "९", "content_sanskrit": "शृणु भामिनि कर्तारमात्माऽयं नैव कर्मकृत् ।\nप्रकृत्या गुणयुक्तेन क्रियते कर्म नित्यशः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2204572, "chapter_id": 5359, "verse_number": "१०", "content_sanskrit": "शरीरं प्राणिनां लोके यथा पित्थकफानिलैः ।\nव्याप्तमेव त्रिभिर्दोषैस्तथा व्याप्तं गुणैस्त्रिभिः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2204573, "chapter_id": 5359, "verse_number": "११", "content_sanskrit": "सत्वं रजस्तम इति गुणास्त्वेते शरीरिणः ।\nप्रकाशात्मकमेतेषां सत्वं सततमिष्यते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2204574, "chapter_id": 5359, "verse_number": "१२", "content_sanskrit": "रजो दुःखत्मकं तत्र तमो मोहात्मकं स्मृतम् ।\nत्रिभिरेतैर्गुणैः सर्वं लोके कर्म प्रवर्तते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2204575, "chapter_id": 5359, "verse_number": "१३", "content_sanskrit": "सत्यं प्राणिदया शौचं श्रेयः प्रीतिः क्षमा दमः ।\nएवमादि तथाऽन्यच्च कर्म सात्विकमिष्यते\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2204576, "chapter_id": 5359, "verse_number": "१४", "content_sanskrit": "दाक्ष्यं कर्मपरत्वं च लोभो भोगविधिं प्रति ।\nकळत्रसङ्गो माधुर्यं नित्यमैश्वर्यलुब्धता ।\nरजसश्चोद्भवं चैतत् कर्म नानाविधं सदा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2204577, "chapter_id": 5359, "verse_number": "१५", "content_sanskrit": "अनृतं चैव पारुष्यं श्रुतिविद्वेषता भृशम् ।\nहिंसापरत्वं नास्तिक्यं निद्रालस्यभयानि च ।\nतमसश्चोद्भवं चैतत् कर्म पापयुतं सदा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2204578, "chapter_id": 5359, "verse_number": "१६", "content_sanskrit": "तस्माद् गुणमयः सर्वः कार्यारम्भः शुभाशुभः ।\nतस्मादात्मानमव्यग्रं विद्ध्यकर्तारमव्ययम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2204579, "chapter_id": 5359, "verse_number": "१७", "content_sanskrit": "सात्विकाः पुण्यलोकेषु राजसा मानुषे पदे ।\nतिर्यग्योनौ च नरके तिष्ठेयुस्तामसा नराः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2204580, "chapter_id": 5359, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2204581, "chapter_id": 5359, "verse_number": "१८", "content_sanskrit": "किमर्थमात्मा भिन्नेऽस्मिन् देहे शस्त्रेण वा हते ।\nस्वयं प्रणश्यते देही तन्मे शंसितुमर्हसि\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2204582, "chapter_id": 5359, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2204583, "chapter_id": 5359, "verse_number": "१९", "content_sanskrit": "तदहं ते प्रवक्ष्यामि शृणु कल्याणि कारणम् ।\nएतन्नैयायिकैश्चापि मुह्यते सूक्ष्मबुद्धिभिः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2204584, "chapter_id": 5359, "verse_number": "२०", "content_sanskrit": "कर्मक्षये तु सम्प्राप्ते प्राणिनां जन्मधारिणाम् ।\nउपद्रवो भवेद् देहे येन केनापि हेतुना\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2204585, "chapter_id": 5359, "verse_number": "२१", "content_sanskrit": "तन्निमित्तं शरीरी तु शरीरं प्राप्तसङ्क्षयम् ।\nअपयाति परित्यज्य ततः कर्मवशेन सः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2204586, "chapter_id": 5359, "verse_number": "२२", "content_sanskrit": "देहहानौ भवेदात्मा वेदनाभिर्न चाल्यते ।\nतिष्ठेत् कर्मफलं यावद् व्रजेत् कर्मक्षये पुनः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2204587, "chapter_id": 5359, "verse_number": "२३", "content_sanskrit": "आदिप्रभृति लोकेऽस्मिन्नेवमात्मगतिः स्मृता ।\nएतत्ते कथितं देवि किं भूयः श्रोतुमिच्छसि\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2204588, "chapter_id": 5359, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे पुंस्त्वादिकथनं नाम दशाधिकद्विशततमोऽध्यायः ॥२१०॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]