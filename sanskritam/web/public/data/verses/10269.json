[{"id": 6000269000, "chapter_id": 10269, "verse_number": null, "content_sanskrit": "अथ त्रिसप्ततितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000269001, "chapter_id": 10269, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_073/BhP_10.073.001.m4a", "display_order": 2}, {"id": 6000269002, "chapter_id": 10269, "verse_number": "१०-७३-१", "content_sanskrit": "तन्मुखैर्वचनं श्रुत्वा वसुदेवो महामनाः।\nतानृषीन् ऋत्विजो वव्रे मूर्ध्नाऽऽनम्योपसृत्य च॥ १०/७३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_073/BhP_10.073.002.m4a", "display_order": 3, "topics": [{"text": "वसुदेवः ऋषिन् ऋत्विजो वव्रे", "range": "१–९"}]}, {"id": 6000269003, "chapter_id": 10269, "verse_number": "१०-७३-२", "content_sanskrit": "त एवमृषयो राजन् वृता धर्मेण धार्मिकम्।\nतस्मिन्नयाजयन् क्षेत्रे मखैरुत्तमकल्पकैः॥ १०/७३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_073/BhP_10.073.003.m4a", "display_order": 4}, {"id": 6000269004, "chapter_id": 10269, "verse_number": "१०-७३-३", "content_sanskrit": "तद्दीक्षायां प्रवृत्तायां वृष्णयः पुष्करस्रजः।\nस्नाताः सुवाससो राजन् राजानः सुष्ठ्वलङ्कृताः॥ १०/७३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_073/BhP_10.073.004.m4a", "display_order": 5}, {"id": 6000269005, "chapter_id": 10269, "verse_number": "१०-७३-४", "content_sanskrit": "तन्महिष्यश्च मुदिता निष्ककण्ठ्यः सुवाससः।\nदीक्षाशालामुपाजग्मुरालिप्ता वस्तुपाणयः॥ १०/७३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_073/BhP_10.073.005.m4a", "display_order": 6}, {"id": 6000269006, "chapter_id": 10269, "verse_number": "१०-७३-५", "content_sanskrit": "नेदुर्मृदङ्गपटहशङ्खभेर्यानकादयः। ननृतुर्नटनर्तक्यस्तुष्टुवुः सूतमागधाः।\nजगुः सुकण्ठ्यो गन्धर्व्यः सुगीतं सहभर्तृकाः॥ १०/७३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_073/BhP_10.073.006.m4a", "display_order": 7}, {"id": 6000269007, "chapter_id": 10269, "verse_number": "१०-७३-६", "content_sanskrit": "तमभ्यषिञ्चन् विधिवद् भक्तमव्यग्रमृत्विजः।\nपत्नीभिरष्टादशभिः सोमराजमिवोडुभिः॥ १०/७३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_073/BhP_10.073.007.m4a", "display_order": 8}, {"id": 6000269008, "chapter_id": 10269, "verse_number": "१०-७३-७", "content_sanskrit": "ताभिर्दुकूलवलयहारनूपुरकुण्डलैः।\nस्वलङ्कृताभिर्विभवैर्दीक्षितोऽजिनसंवृतः॥ १०/७३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_073/BhP_10.073.008.m4a", "display_order": 9}, {"id": 6000269009, "chapter_id": 10269, "verse_number": "१०-७३-८", "content_sanskrit": "तस्यर्त्विजो महाराज नूत्नकौशेयवाससः।\nसप्तादश विरेजुस्ते यथा वृत्रहणोऽध्वरे॥ १०/७३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_073/BhP_10.073.009.m4a", "display_order": 10}, {"id": 6000269010, "chapter_id": 10269, "verse_number": "१०-७३-९", "content_sanskrit": "तदा रामश्च कृष्णश्च स्वैः स्वैर्बन्धुभिरन्वितौ।\nरेजतुः स्वसुतैर्दारैर्जीवेशौ स्वविभूतिभिः॥ १०/७३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_073/BhP_10.073.010.m4a", "display_order": 11}, {"id": 6000269011, "chapter_id": 10269, "verse_number": "१०-७३-१०", "content_sanskrit": "ईजेऽनुयज्ञविधिना अग्निहोत्रादिलक्षणैः।\nप्राकृतैर्वैकृतैर्यज्ञैर्द्रव्यज्ञानक्रियेश्वरम्॥ १०/७३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_073/BhP_10.073.011.m4a", "display_order": 12, "topics": [{"text": "ते साङ्गं यज्ञमकुर्वन्", "range": "१०"}]}, {"id": 6000269012, "chapter_id": 10269, "verse_number": "१०-७३-११", "content_sanskrit": "अथर्त्विग्भ्योऽददात् काले यथाम्नातं सुदक्षिणाः।\nस्वलङ्कृतेभ्योऽलङ्कृत्य गोभूकन्या महाधनाः॥ १०/७३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_073/BhP_10.073.012.m4a", "display_order": 13, "topics": [{"text": "ऋषीणां गोभूकन्यादिदानम्", "range": "११–१७"}]}, {"id": 6000269013, "chapter_id": 10269, "verse_number": "१०-७३-१२", "content_sanskrit": "पत्नीसंयाजावभृथैश्चरित्वाऽथ महर्षयः।\nसस्नू रामह्रदे विप्रा यजमानपुरस्सराः॥ १०/७३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_073/BhP_10.073.013.m4a", "display_order": 14}, {"id": 6000269014, "chapter_id": 10269, "verse_number": "१०-७३-१३", "content_sanskrit": "स्नातोऽलङ्कारवासांसि वन्दिभ्योऽदात् तथा स्‍त्रियः।\nततः स्वलङ्कृतान् वर्णानाश्वभ्योऽन्नेन पूजयत्॥ १०/७३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_073/BhP_10.073.014.m4a", "display_order": 15}, {"id": 6000269015, "chapter_id": 10269, "verse_number": "१०-७३-१४", "content_sanskrit": "बन्धून् सदारान् ससुतान् पारिबर्हेण भूयसा।\nविदर्भकोसलकुरून् काशिकैकेयसृञ्जयान्॥ १०/७३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_073/BhP_10.073.015.m4a", "display_order": 16}, {"id": 6000269016, "chapter_id": 10269, "verse_number": "१०-७३-१५", "content_sanskrit": "सदस्यर्त्विक्सुरगणा नृभूतपितृचारणाः।\nश्रीनिकेतमनुप्राप्य शंसन्तः प्रययुः क्रतुम्॥ १०/७३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_073/BhP_10.073.016.m4a", "display_order": 17}, {"id": 6000269017, "chapter_id": 10269, "verse_number": "१०-७३-१६", "content_sanskrit": "धृतराष्ट्रोऽनुजो द्रोणो भीष्मो द्रौणिः कृपस्तथा।\nनारदो भगवान् व्यासः सुहृत्सम्बन्धिबान्धवाः॥ १०/७३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_073/BhP_10.073.017.m4a", "display_order": 18}, {"id": 6000269018, "chapter_id": 10269, "verse_number": "१०-७३-१७", "content_sanskrit": "बन्धून् परिष्वज्य यदून् सौहृदक्लिन्नचेतसः।\nययुर्विरहकृच्छ्रेण स्वदेशांश्चापरे जनाः॥ १०/७३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_073/BhP_10.073.018.m4a", "display_order": 19}, {"id": 6000269019, "chapter_id": 10269, "verse_number": "१०-७३-१८", "content_sanskrit": "नन्दस्तु सह गोपालैर्महत्या पूजयाऽर्चितः।\nकृष्णरामोग्रसेनाद्यैर्न्यवसद् बन्धुवत्सलः॥ १०/७३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_073/BhP_10.073.019.m4a", "display_order": 20}, {"id": 6000269020, "chapter_id": 10269, "verse_number": "१०-७३-१९", "content_sanskrit": "वसुदेवोऽञ्जसोत्तीर्य मनोरथमहार्णवम्।\nसुहृद्वृतः प्रीतमना नन्दमाह करे स्पृशन्॥ १०/७३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_073/BhP_10.073.020.m4a", "display_order": 21}, {"id": 6000269021, "chapter_id": 10269, "verse_number": null, "content_sanskrit": "वसुदेव उवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_073/BhP_10.073.021.m4a", "display_order": 22}, {"id": 6000269022, "chapter_id": 10269, "verse_number": "१०-७३-२०", "content_sanskrit": "भ्रातरीशकृतः पाशो नृणां यः स्नेहसञ्ज्ञितः।\nतं दुस्त्यजमहं मन्ये सुराणामपि योगिनाम्॥ १०/७३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_073/BhP_10.073.022.m4a", "display_order": 23, "topics": [{"text": "वसुदेवनन्दगोपसम्भाषणम्", "range": "२०–२७"}]}, {"id": 6000269023, "chapter_id": 10269, "verse_number": "१०-७३-२१", "content_sanskrit": "अस्मास्वप्रतिकल्पोऽयं यत् कृतं ज्ञानसत्तमैः।\nमैत्र्यर्पिताऽफला वापि न निवर्तेत कर्हिचित्॥ १०/७३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_073/BhP_10.073.023.m4a", "display_order": 24}, {"id": 6000269024, "chapter_id": 10269, "verse_number": "१०-७३-२२", "content_sanskrit": "प्रागकल्पास्तु कुशलं भ्रातर्वो नाचरेमहि।\nअधुना श्रीमदान्धाक्षा न पश्यामः पुरः सतः॥ १०/७३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_073/BhP_10.073.024.m4a", "display_order": 25}, {"id": 6000269025, "chapter_id": 10269, "verse_number": "१०-७३-२३", "content_sanskrit": "मा राज्यश्रीरभूत् पुंसः श्रेयस्कामस्य मानद।\nस्वजनान् भृत्यबन्धून् वा न पश्यति ययाऽन्धदृक्॥ १०/७३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_073/BhP_10.073.025.m4a", "display_order": 26}, {"id": 6000269026, "chapter_id": 10269, "verse_number": "१०-७३-२४", "content_sanskrit": "एवं सौहृदशैथिल्यचित्त आनकदुन्दुभिः।\nरुरोद तत्कृतां मैत्रीं स्मरन्नश्रुविलोचनः॥ १०/७३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_073/BhP_10.073.026.m4a", "display_order": 27}, {"id": 6000269027, "chapter_id": 10269, "verse_number": "१०-७३-२५", "content_sanskrit": "नन्दस्तु सख्युः प्रियकृत्प्रेम्णा गोविन्दरामयोः।\nअद्य श्व इति मासांस्‍त्रीन् यदुभिर्मानितोऽवसत्॥ १०/७३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_073/BhP_10.073.027.m4a", "display_order": 28}, {"id": 6000269028, "chapter_id": 10269, "verse_number": "१०-७३-२६", "content_sanskrit": "ततः कामैः पूर्यमाणः सव्रजः सहबान्धवः।\nपरार्घ्याभरणक्षौमनानानर्घ्यपरिच्छदैः॥ १०/७३/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_073/BhP_10.073.028.m4a", "display_order": 29}, {"id": 6000269029, "chapter_id": 10269, "verse_number": "१०-७३-२७", "content_sanskrit": "वसुदेवोग्रसेनाभ्यां कृष्णार्जुनबलादिभिः।\nआदाय पारिबर्हं तं यापितो यदुभिर्ययौ॥ १०/७३/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_073/BhP_10.073.029.m4a", "display_order": 30}, {"id": 6000269030, "chapter_id": 10269, "verse_number": "१०-७३-२८", "content_sanskrit": "तदा गोप्यश्च गोपाश्च गोविन्दचरणाम्बुजे।\nमनः क्षिप्तं पुनर्हर्तुमनीशा मधुरां ययुः॥ १०/७३/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_073/BhP_10.073.030.m4a", "display_order": 31}, {"id": 6000269031, "chapter_id": 10269, "verse_number": "१०-७३-२९", "content_sanskrit": "द्रोणो भीष्मोऽङ्गराजश्च बाह्लीकविदुरादयः।\nसपुत्रो धृतराष्ट्रश्च जग्मुः स्वं स्वं निकेतनम्॥ १०/७३/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_073/BhP_10.073.031.m4a", "display_order": 32}, {"id": 6000269032, "chapter_id": 10269, "verse_number": "१०-७३-३०", "content_sanskrit": "अन्ये च सर्वराजानो देवयात्रार्थमागताः।\nगते मासत्रये भूयः स्वानेव विषयान् ययुः॥ १०/७३/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_073/BhP_10.073.032.m4a", "display_order": 33}, {"id": 6000269033, "chapter_id": 10269, "verse_number": "१०-७३-३१", "content_sanskrit": "पाण्डवाश्च महात्मानः पृथा च नृपसत्तम।\nअनुज्ञाताः केशवेन बाष्पगद्गदभाषिणः॥ १०/७३/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_073/BhP_10.073.033.m4a", "display_order": 34}, {"id": 6000269034, "chapter_id": 10269, "verse_number": "१०-७३-३२", "content_sanskrit": "शक्रप्रस्थं ययुः सर्वे स्वजनैः परिवारिताः। बन्धुषु प्रतियातेषु वृष्णयः कृष्णदेवताः।\nपरिवार्य हृषीकेशं ययुर्द्वारावतीं पुरीम्॥ १०/७३/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_073/BhP_10.073.034.m4a", "display_order": 35}, {"id": 6000269035, "chapter_id": 10269, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे त्रिसप्ततितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]