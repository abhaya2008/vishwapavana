[{"id": 7003691000, "chapter_id": 23691, "verse_number": "१-३-१२-१", "content_sanskrit": "ब्रह्मोवाच ।\nइति संभाषमाणे तु महर्षौ मुनि सेविते ।\nविजहौ गिरिजा शंकां शिवभक्तवधाश्रिताम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003691001, "chapter_id": 23691, "verse_number": "१-३-१२-२", "content_sanskrit": "अथांतरिक्षादुदभूद्वाणी कर्णमनोहरा ।\nमा गमः शैलकन्ये त्वं पापनिप्कृतिकारणात् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003691002, "chapter_id": 23691, "verse_number": "१-३-१२-३", "content_sanskrit": "गंगा च यमुना सिंधुर्गोदापि च सरस्वती ।\nनर्मदा सा च कावेरी शोणः शोणनदी च सा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003691003, "chapter_id": 23691, "verse_number": "१-३-१२-४", "content_sanskrit": "अत्रैव नव तीर्थानि संभवंतु शिलातले ।\nत्वत्खड्गदारिते देवि कुरु तत्राघमर्षणम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003691004, "chapter_id": 23691, "verse_number": "१-३-१२-५", "content_sanskrit": "अस्मिन्नाश्वियुजे मासि ज्येष्ठानक्षत्र आगते ।\nनिमज्य खड्गतीर्थे त्वं सलिंगा मासमावस ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003691005, "chapter_id": 23691, "verse_number": "१-३-१२-६", "content_sanskrit": "निवर्त्य सावनं मासमत्र दिक्पालसंमितम् ।\nततः पाणिस्थितं लिंगं लब्ध्वा पापविशोधनम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003691006, "chapter_id": 23691, "verse_number": "१-३-१२-७", "content_sanskrit": "प्रतिष्ठापय तीर्थाग्रे लोकानुग्रहकारणात् ।\nउत्तीर्य तीर्थवर्येऽस्मिन्स्नात्वा लिंगेऽर्चिते शिवे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003691007, "chapter_id": 23691, "verse_number": "१-३-१२-८", "content_sanskrit": "तापत्रयोपशांतिश्च त्रैलोक्यस्य न संशयः ।\nसर्वपापहरं लिंगं स्थावरं तीर्थसन्निधौ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003691008, "chapter_id": 23691, "verse_number": "१-३-१२-९", "content_sanskrit": "स्थापय स्थिरया भक्त्या सदालोकहिताय च ।\nनक्षत्रे वैश्वदैवत्ये देवक्याः संगमाचर ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003691009, "chapter_id": 23691, "verse_number": "१-३-१२-१०", "content_sanskrit": "महोत्सवसमायुक्तं यावद्दशदिनावधि ।\nकृत्वा चावभृथं पुण्यनक्षत्रे वह्निदैवते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003691010, "chapter_id": 23691, "verse_number": "१-३-१२-११", "content_sanskrit": "सायमभ्यर्च्य विधिवच्छोणाचलवपुर्मम ।\nततस्ते दर्शयिष्यामि तैजसं रूपमात्मनः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003691011, "chapter_id": 23691, "verse_number": "१-३-१२-१२", "content_sanskrit": "एतत्कृतं ते लोकानां रक्षायै संभविष्यति ।\nइति तद्वचनं श्रुत्वा महर्षिवचनं च सा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003691012, "chapter_id": 23691, "verse_number": "१-३-१२-१३", "content_sanskrit": "उभयं कर्तुमारेभे तपसा शैलकन्यका ।\nखङ्गेन दारयामास शिलातलमनाकुला ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003691013, "chapter_id": 23691, "verse_number": "१-३-१२-१४", "content_sanskrit": "उदजृंभत तीर्थानां नवकं तत्र तत्क्षणात् ।\nतस्य कण्ठस्थितं लिगं ध्यायन्ती पर्वतात्मजा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003691014, "chapter_id": 23691, "verse_number": "१-३-१२-१५", "content_sanskrit": "तीर्थे ममज्ज तस्मिन्सा मुनीनामभ्यनुज्ञया ।\nतीर्थानां नवकं तत्र संजातं स्फटिकप्रभम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003691015, "chapter_id": 23691, "verse_number": "१-३-१२-१६", "content_sanskrit": "अंतर्वसतितः कांत्या मेचकीकृतमंजसा ।\nवसंत्यां शैलकन्यायां तीर्थे त्रिंशद्दिनं त्वथ ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003691016, "chapter_id": 23691, "verse_number": "१-३-१२-१७", "content_sanskrit": "शम्भोर्विरहसंतप्तं मनश्चंचलतां ययौ ।\nतत्र श्रिया सरोजानि चक्षुषोत्पलकाननम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003691017, "chapter_id": 23691, "verse_number": "१-३-१२-१८", "content_sanskrit": "मंदस्मितेन कुमुदं ससर्ज सलिलस्य सा ।\nदेव्यास्तेनोदवासेन लोकास्तु निरुपद्रवाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003691018, "chapter_id": 23691, "verse_number": "१-३-१२-१९", "content_sanskrit": "कृतार्थास्सहसा जातास्तत्तत्कालफलान्विताः ।\nमासांते सा समुत्तीर्य कृत्वा देव्युत्सवं तथा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003691019, "chapter_id": 23691, "verse_number": "१-३-१२-२०", "content_sanskrit": "कार्तिके मासि नक्षत्रे कृत्तिकाख्ये निशोदये ।\nपूजयित्वा तपःसिद्धैरुपचारैर्बहूदयैः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003691020, "chapter_id": 23691, "verse_number": "१-३-१२-२१", "content_sanskrit": "अरुणाद्रिमयं लिंगं तुष्टाव जगदंबिका ।\nनमस्ते विश्वरूपाय शोणाचलवपुर्भृते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003691021, "chapter_id": 23691, "verse_number": "१-३-१२-२२", "content_sanskrit": "तेजोमयाद्रिलिंगाय सर्वपाततकनाशिने ।\nब्रह्मणा विष्णुना च त्वं दुष्परिच्छेद्यवैभवः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003691022, "chapter_id": 23691, "verse_number": "१-३-१२-२३", "content_sanskrit": "अग्निरूपोऽपि सञ्छांतो लोकानुग्रहक्लृप्तये ।\nशक्त्या च तत्त्वसंघातकरः कालानलाकृतिः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003691023, "chapter_id": 23691, "verse_number": "१-३-१२-२४", "content_sanskrit": "अद्रिश्रेष्ठारुणाद्रीश रूपलावण्यवारिधे ।\nविचित्ररूपमेतत्ते वेदवेद्यसुरार्चितम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003691024, "chapter_id": 23691, "verse_number": "१-३-१२-२५", "content_sanskrit": "तेजसां देव सर्वेषां बीजभूतं निगद्यसे ।\nदिव्यं हि परमं तेजस्तव देव महेश्वर ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003691025, "chapter_id": 23691, "verse_number": "१-३-१२-२६", "content_sanskrit": "यत्पुरा ब्रह्मणा दृष्टं विष्णुना च विचिन्वता ।\nअद्य पूतास्मि देवेश तव संदर्शनादहम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003691026, "chapter_id": 23691, "verse_number": "१-३-१२-२७", "content_sanskrit": "तेजो दर्शय मे दिव्यं सर्वदोषहरं परम् ।\nप्रार्थयंत्यां तदा देव्यामरुणाद्रिमयः शिवः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003691027, "chapter_id": 23691, "verse_number": "१-३-१२-२८", "content_sanskrit": "आविर्बभूव तेजोभिरापूर्य भुवनांतरम् ।\nकोटिसूर्योदयप्रख्यं तुल्यं पूर्णेंदुकोटिभिः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003691028, "chapter_id": 23691, "verse_number": "१-३-१२-२९", "content_sanskrit": "कालाग्निकोटिसंकाशं तेजः परमदृश्यत ।\nप्रणम्य परया भक्त्या मुनिभिः सार्धमंबिका ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003691029, "chapter_id": 23691, "verse_number": "१-३-१२-३०", "content_sanskrit": "विस्मयाक्रांतहृदया ननंद नलिनेक्षणा ।\nअथ तेजोनिधेस्तस्मादरुणाद्रिः समुत्थितः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003691030, "chapter_id": 23691, "verse_number": "१-३-१२-३१", "content_sanskrit": "हिरण्मयोऽब्रवीद्वाचं पुरुषः कलकन्धरः ।\nप्रसन्नोऽस्मि तपोभिस्ते स्थानेषु मम कल्पितैः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003691031, "chapter_id": 23691, "verse_number": "१-३-१२-३२", "content_sanskrit": "तेजोमयमिदं रूपमीक्षितं च त्वयाधुना ।\nकारणैर्बहुभिर्लोकान्रक्षेथास्त्वं जगन्मयि ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003691032, "chapter_id": 23691, "verse_number": "१-३-१२-३३", "content_sanskrit": "तपांसि कुरुषे भूमौ किमन्यत्प्रार्थितं तव ।\nमल्लोचनत्विषा तेद्य तमोराशिः समुत्थितः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003691033, "chapter_id": 23691, "verse_number": "१-३-१२-३४", "content_sanskrit": "अशेषो हि प्रशांतोऽभूत्तेजसोऽस्य निरीक्षणात् ।\nअयं तु महिषो दुष्टो मद्भक्तिं लिंगपूजकः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003691034, "chapter_id": 23691, "verse_number": "१-३-१२-३५", "content_sanskrit": "जग्राह सहसा ह्येतत्तस्य लिंगं गले स्थितम् ।\nअनेन भक्षितं तच्च नास्तिकस्योपदेशतः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003691035, "chapter_id": 23691, "verse_number": "१-३-१२-३६", "content_sanskrit": "अकरोन्मय्यविश्वासं लिंगरूपे गले स्थिते ।\nक्रमेण सोपि संप्राप्तो मुनिजन्म मनोहरम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003691036, "chapter_id": 23691, "verse_number": "१-३-१२-३७", "content_sanskrit": "मामेवाभ्यर्चयन्ध्यायन्गणनाथत्वमावसन् ।\nपूर्वजन्मनि भक्तोऽयं महिषोपि त्वया हतः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003691037, "chapter_id": 23691, "verse_number": "१-३-१२-३८", "content_sanskrit": "चिरं मल्लिंगधृग्यस्मात्सिद्धिरस्यापि देव्यतः ।\nशिवलिंगेष्वविश्वासः शिवभक्तावमाननम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003691038, "chapter_id": 23691, "verse_number": "१-३-१२-३९", "content_sanskrit": "न कर्त्तव्यं सदा भक्तैस्तस्माद्वै मुक्तिकांक्षिभिः ।\nदीक्षया रहितं लिगं येन संधार्यते बलात् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003691039, "chapter_id": 23691, "verse_number": "१-३-१२-४०", "content_sanskrit": "न तादृशं फलं दत्ते वज्रवत्तं निहंति च ।\nन दोषस्तत्र किंचित्ते शोणाचलनिरीक्षणात् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003691040, "chapter_id": 23691, "verse_number": "१-३-१२-४१", "content_sanskrit": "सफला नयनावाप्तिः सर्वदोषविनाशनात् ।\nत्वत्पुत्रस्तन्यदानेन धात्र्योपकृतमात्मजे ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003691041, "chapter_id": 23691, "verse_number": "१-३-१२-४२", "content_sanskrit": "त्वामपीतकुचां चक्रे वत्सलां भक्तरक्षिणीम् ।\nनक्षत्रे कृत्तिकाख्येऽत्र तव सन्निधिलोभतः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003691042, "chapter_id": 23691, "verse_number": "१-३-१२-४३", "content_sanskrit": "प्रायश्चित्ताभिधानेन भवापीतकुचाभिधा ।\nपूजाशेषं समाधाय भक्तानुग्रहहेतवे ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003691043, "chapter_id": 23691, "verse_number": "१-३-१२-४४", "content_sanskrit": "भज मां करुणामूर्तिरपीतकुचनायिका ।\nइति देवस्य वचनमाकर्ण्यात्यंतशीतलम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003691044, "chapter_id": 23691, "verse_number": "१-३-१२-४५", "content_sanskrit": "प्रणम्य प्रार्थितवती प्रोवाच च तमंबिका ।\nदेवदेव प्रसादेन त्वयानुग्रहशालिना ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003691045, "chapter_id": 23691, "verse_number": "१-३-१२-४६", "content_sanskrit": "एतत्ते दर्शितं तेजो दृष्टं देवैश्च मानवैः ।\nप्रत्यक्षं कृत्तिकामासि मद्व्रतांतमहोत्सवे ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003691046, "chapter_id": 23691, "verse_number": "१-३-१२-४७", "content_sanskrit": "नक्षत्रे कृत्तिकाख्येऽस्मिंस्तेजस्ते दृश्यतां परम् ।\nतद्वीक्षितमिदं तेजः परमं प्रतिवत्सरम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003691047, "chapter_id": 23691, "verse_number": "१-३-१२-४८", "content_sanskrit": "दृष्ट्वा समस्तैर्दुरितैर्मुच्यतां सर्वजंतवः ।\nतथेति देवदेवेन प्रोचेऽथांतर्दधे गिरौ ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003691048, "chapter_id": 23691, "verse_number": "१-३-१२-४९", "content_sanskrit": "प्रदक्षिणं चकारैनं सखीभिः सा ततोंऽबिका ।\nघनश्यामलया कांत्या परितो जृंभमाणया ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003691049, "chapter_id": 23691, "verse_number": "१-३-१२-५०", "content_sanskrit": "अरुणाद्रिमयं लिंगं चक्रे मरकतप्रभम् ।\nमंदं चरन्ती जाताभिः प्रभाभिः पादपद्मयोः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003691050, "chapter_id": 23691, "verse_number": "१-३-१२-५१", "content_sanskrit": "तस्तार परितो भूमिं पद्मपत्रैः सपल्लवैः ।\nप्रफुल्लकनकांभोजनीलोत्पलदलोत्करैः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003691051, "chapter_id": 23691, "verse_number": "१-३-१२-५२", "content_sanskrit": "अर्चयन्तीव शोणाद्रिमभितो दृष्टिकांतिभिः ।\nइन्द्रादिलोकपालानामंगनाभिर्निषेविता ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003691052, "chapter_id": 23691, "verse_number": "१-३-१२-५३", "content_sanskrit": "प्रसादिता मातृगणैर्गंधदानविभूषणैः ।\nछत्रचामरभृंगारतालवृन्तफलाचिकाः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003691053, "chapter_id": 23691, "verse_number": "१-३-१२-५४", "content_sanskrit": "वहन्तीभिः सुरस्त्रीभिर्वृता मुनिवधूयुता ।\nप्रदक्षिणं चकारैनमरुणाद्रिं स्वयंप्रभम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003691054, "chapter_id": 23691, "verse_number": "१-३-१२-५५", "content_sanskrit": "कांक्षन्ती शिवसायुज्यं विवाहाग्निमिवाद्रिजा ।\nतस्यां प्रदक्षिणं भक्त्या कुर्वाणायां पदेपदे ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003691055, "chapter_id": 23691, "verse_number": "१-३-१२-५६", "content_sanskrit": "प्रेषिता शंभुना देवाः परिवव्रुः सुरेश्वराः ।\nसरस्वतीसमं धात्रा विष्णुना च समं रमा ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003691056, "chapter_id": 23691, "verse_number": "१-३-१२-५७", "content_sanskrit": "सर्वदिक्पालकांताभिः समेता शैलबालिका ।\nनिरुन्धतीव देवेन्द्रं सलिलैर्वरदानतः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003691057, "chapter_id": 23691, "verse_number": "१-३-१२-५८", "content_sanskrit": "अद्रिनाथस्वरूपस्य शीतत्वमिव कुर्वती ।\nतपस्ययाऽविनाभावाद्देवस्येव कृतस्मृतिः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003691058, "chapter_id": 23691, "verse_number": "१-३-१२-५९", "content_sanskrit": "दुष्करस्योदवासस्य बोधयन्तीव साधुताम् ।\nऋषीणां देवमानानामुपदेष्टुमिव क्रमात् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003691059, "chapter_id": 23691, "verse_number": "१-३-१२-६०", "content_sanskrit": "क्रीडामिव पुराभ्यस्तां तपसापि च संगता ।\nआत्मानं विरहोत्तप्तामात्मस्थं तादृश शिवम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003691060, "chapter_id": 23691, "verse_number": "१-३-१२-६१", "content_sanskrit": "संचिंत्य चोभयोः कर्तुं शीतलत्वं जले स्थिता ।\nतीर्थानामिव सर्वेषामुद्भूतानां शिलातले ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003691061, "chapter_id": 23691, "verse_number": "१-३-१२-६२", "content_sanskrit": "आधिक्यमथ लोकस्य वक्तुकामा स्वयं स्थिता ।\nदुरितघ्नं च पंचाग्निमर्थावासं सुदुष्करम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003691062, "chapter_id": 23691, "verse_number": "१-३-१२-६३", "content_sanskrit": "अधिगम्य तपस्तस्य शांतिं कर्तुमिव स्थिता ।\nमहिषासुरकंठोत्थरक्तधारापरिप्लुतम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003691063, "chapter_id": 23691, "verse_number": "१-३-१२-६४", "content_sanskrit": "क्षालयंतीव लिंगं तदमलैस्तीर्थवारिभिः ।\nअरुणाख्यं पुरं रम्यं निर्मितं विश्वकर्मणा ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003691064, "chapter_id": 23691, "verse_number": "१-३-१२-६५", "content_sanskrit": "अपीतकुचनाथेशशोणाद्रीश्वरतुष्टये ।\nशृंगेषु यस्य सौधेषु वसन्त्यो वारयोषितः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003691065, "chapter_id": 23691, "verse_number": "१-३-१२-६६", "content_sanskrit": "अधःकृताभ्रतडितो जिगीषंतीव चामरीः ।\nयत्तुंगसौधशृंगाग्रे गायंतीर्वारयोषितः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003691066, "chapter_id": 23691, "verse_number": "१-३-१२-६७", "content_sanskrit": "सिद्धचारणगंधर्वविद्याधरविराजितम् ।\nअष्टापदरथाक्रांतमष्टवीथिविराजितम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003691067, "chapter_id": 23691, "verse_number": "१-३-१२-६८", "content_sanskrit": "अष्टापदपथाकारमष्टदिक्पालपूजितम् ।\nअष्टसिद्धियुतैः सिद्धैरष्टमूर्तिपदाश्रयैः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003691068, "chapter_id": 23691, "verse_number": "१-३-१२-६९", "content_sanskrit": "अष्टांगभक्तियुक्तैस्तैर्युक्तमष्टांगबुद्धिभिः ।\nचातुर्वर्ण्यगुणोपेतमुपवर्णं परिष्कृतम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003691069, "chapter_id": 23691, "verse_number": "१-३-१२-७०", "content_sanskrit": "लसत्सुवर्णदुवर्णशालामालासमास्थितम् ।\nशंखदुंदुभिनिस्साणमृदंगमुरजादिभिः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003691070, "chapter_id": 23691, "verse_number": "१-३-१२-७१", "content_sanskrit": "वीणावेणुमुखैस्तालैः सालापैरुपरंजितम् ।\nब्रह्मघोषनिनादेन महर्षीणां शिवात्मनाम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003691071, "chapter_id": 23691, "verse_number": "१-३-१२-७२", "content_sanskrit": "सेवितव्यं दिने दिव्यसमदर्शवृषध्वजम् ।\nनवरत्नप्रभाजालैर्नवग्रहसमोदयैः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003691072, "chapter_id": 23691, "verse_number": "१-३-१२-७३", "content_sanskrit": "निशादिवसयोरेवं दर्शयन्निव सर्वदा ।\nविष्णुः स्थितश्च तं प्रीत्या सिषेवे पुरतो विभुम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003691073, "chapter_id": 23691, "verse_number": "१-३-१२-७४", "content_sanskrit": "शक्रः सुरगणैः सार्धं सहस्राक्षः समाययौ ।\nपपात दिव्यगंधाढ्या पुष्पवृष्टिः समंततः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003691074, "chapter_id": 23691, "verse_number": "१-३-१२-७५", "content_sanskrit": "व्योमगंगाजलोत्संगशीतलो मरुदाववौ ।\nअतीव सौरभामोदवासिताखिलदिङ्मुखः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003691075, "chapter_id": 23691, "verse_number": "१-३-१२-७६", "content_sanskrit": "कनकांकितशृंगाग्रपरिधूतवनावलिः ।\nदर्पसंभ्रमसंनद्धो ननाद वृषभो मुहुः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003691076, "chapter_id": 23691, "verse_number": "१-३-१२-७७", "content_sanskrit": "वसंतप्रमुखाः सर्वे सहर्षमृतवः पुरः ।\nअसेवंत प्रियकरैः पुष्पैः स्वयमथोचितैः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003691077, "chapter_id": 23691, "verse_number": "१-३-१२-७८", "content_sanskrit": "गणैश्च विविधाकाराः सिद्धाश्च परमर्षयः ।\nसुराश्च कुतुकोपेताः समागच्छन्दिदृक्षवः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003691078, "chapter_id": 23691, "verse_number": "१-३-१२-७९", "content_sanskrit": "कुंकुमक्षोदसंमिश्रकर्पूररजसान्वितः ।\nचर्यामुष्टिमहासारः समकीर्यत सर्वतः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003691079, "chapter_id": 23691, "verse_number": "१-३-१२-८०", "content_sanskrit": "अथ मृदंगकमर्दलझल्लरीपटहदुंदुभितालसमन्वितैः ।\nजलजकीचककाहलनिस्वनैः सुरकृतैर्भुवन समपूरयन् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003691080, "chapter_id": 23691, "verse_number": "१-३-१२-८१", "content_sanskrit": "सुरवधूजननृत्तनिरंतरोल्लुलिततुंबरुगायनगीतिभिः ।\nअभिवृतो मुनिदेवगणान्वितो वृषगतः समदर्शि वृषध्वजः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003691081, "chapter_id": 23691, "verse_number": "१-३-१२-८२", "content_sanskrit": "सरसमेत्य शिवः करुणानिधिर्नतमुखीमपि तामपलज्जया ।\nललितमंकमनंगरिपुः शिवां धृतिमहानधिरोप्य जहर्ष सः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003691082, "chapter_id": 23691, "verse_number": "१-३-१२-८३", "content_sanskrit": "ललितया निजया प्रिययान्वितः सुरमुनींद्रसमाजसमावृतः ।\nललितमप्सरसां मुहुरादरान्नटनमैक्षत गीतिसमन्वितम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003691083, "chapter_id": 23691, "verse_number": "१-३-१२-८४", "content_sanskrit": "अथ शिवः सुरराजसमर्पिताञ्छुभपटीरमुखानिलसौरभान् ।\nहिमगिरिप्रहितांश्च समग्रहीन्मृगमदैः सह गंधसमुच्चयान् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003691084, "chapter_id": 23691, "verse_number": "१-३-१२-८५", "content_sanskrit": "समनुलेपितहारसुमंडितावभिगतौ सिततां समलंकृतौ ।\nस्वयमपीतकुचाकुचकुड्मलावरणरंभणचञ्चलसत्करौ ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003691085, "chapter_id": 23691, "verse_number": "१-३-१२-८६", "content_sanskrit": "कठिनतुंगघनस्तनकोरकस्थगितमंगलगंधमनोहराम् ।\nगिरिसुतामधिगम्य शिवः स्वयं विरहतापमशेषमपाकरोत् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003691086, "chapter_id": 23691, "verse_number": "१-३-१२-८७", "content_sanskrit": "अथ विनोदशतैरुपलक्षितां निजवियोगजताप कृशान्विताम् ।\nअरुणशैलपतिः स्वयमद्रिजां वरमभीप्सितमर्थय चेत्यशात् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003691087, "chapter_id": 23691, "verse_number": "१-३-१२-८८", "content_sanskrit": "सकुतुकं प्रणिपत्य नगात्मजा पुररिपुं भुवनत्रयगुप्तये ।\nइममयाचत शोणगिरीश्वरं वरमुदारमनुग्रहसंमुदम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003691088, "chapter_id": 23691, "verse_number": "१-३-१२-८९", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां प्रथमे माहश्वरखण्डेऽरुणाचलमाहात्म्ये पूर्वार्धे देव्याः शिवसमागमवर्णनंनाम द्वादशोऽध्यायः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}]