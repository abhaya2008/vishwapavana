[{"id": 5000620000, "chapter_id": 9620, "verse_number": "७-८५-१", "content_sanskrit": "लक्ष्मणस्य तु तद्वाक्यं श्रुत्वा शत्रुनिबर्हणः ।\nवृत्रघातमशेषेण कथयेत्याह सुव्रत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000620001, "chapter_id": 9620, "verse_number": "७-८५-२", "content_sanskrit": "राघवेणैवमुक्तस्तु सुमित्रानन्दवर्धनः ।\nभूय एव कथां दिव्यां कथयामास सुव्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000620002, "chapter_id": 9620, "verse_number": "७-८५-३", "content_sanskrit": "सहस्राक्षवचः श्रुत्वा सर्वेषां च दिवौकसाम् ।\nविष्णुर्देवानुवाचेदं सर्वानिन्द्रपुरोगमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000620003, "chapter_id": 9620, "verse_number": "७-८५-४", "content_sanskrit": "पूर्वं सौहृदबद्धो ऽस्मि वृत्रस्य ह महात्मनः ।\nतेन युष्मत्प्रियार्थं हि नाहं हन्मि महासुरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000620004, "chapter_id": 9620, "verse_number": "७-८५-५", "content_sanskrit": "अवश्यं करणीयं च भवतां सुखमुत्तमम् ।\nतस्मादुपायमाख्यास्ये येन वृत्रो निहन्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000620005, "chapter_id": 9620, "verse_number": "७-८५-६", "content_sanskrit": "त्रिधाभूतं करिष्यामि ह्यात्मानं सुरसत्तमाः ।\nतेन वृत्रं सहस्राक्षो वधिष्यति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000620006, "chapter_id": 9620, "verse_number": "७-८५-७", "content_sanskrit": "एकांशो वासवं यातु द्वितीयो वज्रमेव तु ।\nतृतीयो भूतलं शक्रस्तदा वृत्रं वधिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000620007, "chapter_id": 9620, "verse_number": "७-८५-८", "content_sanskrit": "तथा ब्रुवति देवेशे देवा वाक्यमथाब्रुवन् ।\nएवमेतन्न सन्देहो यथा वदसि दैत्यहन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000620008, "chapter_id": 9620, "verse_number": "७-८५-९", "content_sanskrit": "भद्रं ते ऽस्तु गमिष्यामो वृत्रासुरवधैषिणः ।\nभजस्व परमोदार वासवं स्वेन तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000620009, "chapter_id": 9620, "verse_number": "७-८५-१०", "content_sanskrit": "ततः सर्वे महात्मानः सहस्राक्षपुरोगमाः ।\nतदारण्यमुपाक्रामन्यत्र वृत्रो महासुरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000620010, "chapter_id": 9620, "verse_number": "७-८५-११", "content_sanskrit": "ते पश्यंस्तेजसा भूतं तप्यन्तमसुरोत्तमम् ।\nपिबन्तमिव लोकांस्त्रीन्निर्दहन्तमिवाम्बरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000620011, "chapter_id": 9620, "verse_number": "७-८५-१२", "content_sanskrit": "दृष्ट्वैव चासुरश्रेष्ठं देवास्त्रासमुपागमन् ।\nकथमेनं वधिष्यामः कथं न स्यात्पराजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000620012, "chapter_id": 9620, "verse_number": "७-८५-१३", "content_sanskrit": "तेषां चिन्तयतां तत्र सहस्राक्षः पुरन्दरः ।\nवज्रं प्रगृह्य पाणिभ्यां प्राहिणोद्वृत्रमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000620013, "chapter_id": 9620, "verse_number": "७-८५-१४", "content_sanskrit": "कालाग्निनेव घोरेण तप्तेनैव महार्चिषा ।\nपतता वृत्रशिरसा जगत्ऺत्रासमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000620014, "chapter_id": 9620, "verse_number": "७-८५-१५", "content_sanskrit": "असम्भाव्यं वधं तस्य वृत्रस्य विबुधाधिपः ।\nचिन्तयानो जगामाशु लोकस्यान्तं महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000620015, "chapter_id": 9620, "verse_number": "७-८५-१६", "content_sanskrit": "तमिन्द्रं ब्रह्महत्या ऽ ऽशु गच्छन्तमनुगच्छति ।\nअपतच्चास्य गात्रेषु तमिन्द्रं दुःखमाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000620016, "chapter_id": 9620, "verse_number": "७-८५-१७", "content_sanskrit": "हतारयः प्रनष्टेन्द्रा देवाः साग्निपुरोगमाः ।\nविष्णुं त्रिभुवनेशानं मुहुर्मुहुरपूजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000620017, "chapter_id": 9620, "verse_number": "७-८५-१८", "content_sanskrit": "त्वं गतिः परमेशान पूर्वजो जगतः पिता ।\nरक्षार्थं सर्वभूतानां विष्णुत्वमुपजग्मिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000620018, "chapter_id": 9620, "verse_number": "७-८५-१९", "content_sanskrit": "हतश्चायं त्वया वृत्रो ब्रह्महत्या च वासवम् ।\nबाधते सुरशार्दूल मोक्षं तस्या विनिर्दिश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000620019, "chapter_id": 9620, "verse_number": "७-८५-२०", "content_sanskrit": "तेषां तद्वचनं श्रुत्वा देवानां विष्णुरब्रवीत् ।\nमामेव यजतां शक्रः पावयिष्यामि वज्रिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000620020, "chapter_id": 9620, "verse_number": "७-८५-२१", "content_sanskrit": "पुण्येन हयमेधेन मामिष्ट्वा पाकशासनः ।\nपुनरेष्यति देवानामिन्द्रत्वमकुतोभयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000620021, "chapter_id": 9620, "verse_number": "७-८५-२२", "content_sanskrit": "एवं सन्दिश्य तां वाणीं देवानाममृतोपमाम् ।\nजगाम विष्णुर्देवेशः स्तूयमानस्त्रिविष्टपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000620022, "chapter_id": 9620, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे पञ्चाशीतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]