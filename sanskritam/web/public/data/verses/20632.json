[{"id": 7000632000, "chapter_id": 20632, "verse_number": "५-९१-१", "content_sanskrit": "नारद उवाच ।\nदेवशर्मा महाप्राज्ञः समं सुमनसा तया ।\nतीर्थे कनखले पुण्ये गंगायामतिविश्रुते ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000632001, "chapter_id": 20632, "verse_number": "५-९१-२", "content_sanskrit": "वैशाखे विधिना स्नानं चक्रे मेषस्थिते रवौ ।\nपूजयामास विधिवन्मधुसूदनमच्युतम् ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000632002, "chapter_id": 20632, "verse_number": "५-९१-३", "content_sanskrit": "यमैः सनियमैर्युक्तः शक्त्या किंचिद्ददौ ततः ।\nहविष्यभुग्भूमिशायी ब्रह्मचर्यव्रतस्थितः ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000632003, "chapter_id": 20632, "verse_number": "५-९१-४", "content_sanskrit": "कृच्छ्रादि तपसा क्षामो ध्यायन्नारायणं हृदि ।\nतत्र प्राप्य स वैशाखीं दत्वा मधुतिलादिकम् ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000632004, "chapter_id": 20632, "verse_number": "५-९१-५", "content_sanskrit": "विप्रेभ्यो भोजनं दत्वा भक्त्या धेनुं सदक्षिणाम् ।\nअच्छिद्रं प्रार्थयामास तत्र स्नानस्य भूसुरान् ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000632005, "chapter_id": 20632, "verse_number": "५-९१-६", "content_sanskrit": "सापि साध्वी च सुश्रोणी पतिभक्तिपरायणा ।\nपतिं शुश्रूषते नित्यं स्नात्वा संपूज्य केशवम् ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000632006, "chapter_id": 20632, "verse_number": "५-९१-७", "content_sanskrit": "तौ दंपती ततो यातौ स्वगेहं साधुहर्षितम् ।\nकृतकृत्यावथात्मानौ मन्यमानावसंशयम् ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000632007, "chapter_id": 20632, "verse_number": "५-९१-८", "content_sanskrit": "तेन पुण्यप्रभावेण कालेन कियता किल ।\nबभूवुरमितास्तस्य धनधान्यानि संपदः ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000632008, "chapter_id": 20632, "verse_number": "५-९१-९", "content_sanskrit": "तनया विनयोपेताश्चत्वारः श्रुतिकोविदाः ।\nधर्मज्ञा वैष्णवा नित्यं पितृमातृपरायणाः ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000632009, "chapter_id": 20632, "verse_number": "५-९१-१०", "content_sanskrit": "बभूवुरमितप्रज्ञाः पुरुषार्थाय बोधिताः ।\nविख्याता विधितत्त्वज्ञा ब्रह्मज्ञा ब्रह्मतत्पराः ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000632010, "chapter_id": 20632, "verse_number": "५-९१-११", "content_sanskrit": "समग्रगुणसंपन्नाः संप्रतिष्ठंति कीर्तयः ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000632011, "chapter_id": 20632, "verse_number": "५-९१-१२", "content_sanskrit": "तौ दंपती सुतसमग्रसमृद्धसौख्यं पुण्योदयं समुपयुज्य ततश्चिरेण ।\nस्थानं परं परममीयतुरस्य भक्त्या श्रीमाधवे च सुकृतस्य नृपप्रसादात् ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000632012, "chapter_id": 20632, "verse_number": "५-९१-१३", "content_sanskrit": "यथैव माधवः साक्षाद्विद्यालक्ष्मी धवः स्मृतः ।\nतथैव माधवो मासो मधुसूदनवल्लभः ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000632013, "chapter_id": 20632, "verse_number": "५-९१-१४", "content_sanskrit": "इदं माधवमाहात्म्यं किंचित्संक्षेपतोऽनघ ।\nमया ते कथितं वीर यत्पुरा च पितुः श्रुतम् ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]