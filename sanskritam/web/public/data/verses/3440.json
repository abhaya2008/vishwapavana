[{"id": 2113427, "chapter_id": 3440, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2113428, "chapter_id": 3440, "verse_number": "१", "content_sanskrit": "कुन्तीपुत्रेषु जातेषु धृतराष्ट्रात्मजेषु च ।\nमद्रराजसुता पाण्डुमिदं वचनमब्रवीत् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2113429, "chapter_id": 3440, "verse_number": "२", "content_sanskrit": "न मेऽस्ति त्वयि सन्तानो विगुणोऽपि नराधिप ।\nमम जातो वनस्थाया ह्यवरत्वात् कथञ्चन \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2113430, "chapter_id": 3440, "verse_number": "३", "content_sanskrit": "गान्धार्याश्चापि पुत्राणां शतं जज्ञे महात्मनाम् ।\nतत्रापि नैव बलवद् दुःखं मम विशाम्पते\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2113431, "chapter_id": 3440, "verse_number": "४", "content_sanskrit": "इदं तु मे महद्दुःखं तुल्यतायामपुत्रता ।\nदिष्ट्या त्विदानीं भर्तुर्मे कुन्त्यामप्यस्ति सन्ततिः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2113432, "chapter_id": 3440, "verse_number": "५", "content_sanskrit": "यदि त्वपत्यसन्तानं कुन्ती राजसुता मयि ।\nकुर्यादनुग्रहो मे स्यात् तव चैव हितं भवेत् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2113433, "chapter_id": 3440, "verse_number": "६", "content_sanskrit": "न सहेयं सपत्नीत्वात् कुन्तीं वक्तुं सुतान् प्रति ।\nयदि तु त्वं प्रसन्नो मे स्वयमेनां प्रचोदय\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2113434, "chapter_id": 3440, "verse_number": "", "content_sanskrit": "पाण्डुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2113435, "chapter_id": 3440, "verse_number": "७", "content_sanskrit": "ममाप्येष सदा माद्रि हृद्यर्थः परिवर्तते ।\nन तु त्वां प्रसहे वक्तुमिष्टानिष्टाभिकाङ्क्षया\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2113436, "chapter_id": 3440, "verse_number": "८", "content_sanskrit": "तव त्वनुमतो राज्ञि प्रयतिष्ये यथासुखम् ।\nआशंसे नचिरात् कुन्ती वचो मे प्रतिपत्स्यते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2113437, "chapter_id": 3440, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2113438, "chapter_id": 3440, "verse_number": "९", "content_sanskrit": "ततः कुन्तीं पुनः पाण्डुरेकान्त इदमब्रवीत् ।\nअनुगृह्णीष्व कल्याणि मद्रराजसुतामपि\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2113439, "chapter_id": 3440, "verse_number": "१०", "content_sanskrit": "कुलस्य मम सन्तानं लोकस्य च कुरु प्रियम् ।\nमम वा पिण्डलाभाय पूर्वेषां च महात्मनाम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2113440, "chapter_id": 3440, "verse_number": "११", "content_sanskrit": "मत्प्रियार्थं च कल्याणि कुरु कल्याणमुत्तमम् ।\nकुलस्य पिण्डवृद्धिश्च कुलस्य कुलसन्ततिः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2113441, "chapter_id": 3440, "verse_number": "१२", "content_sanskrit": "मम चेष्टस्य निर्वृत्तिः तव चापि परं यशः ।\nयशसोऽर्थाय चैव त्वं कुरु कर्म सुदुष्करम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2113442, "chapter_id": 3440, "verse_number": "१३", "content_sanskrit": "प्राप्य देवादपत्यं च यज्ञैरिष्ट्वा सहस्रशः ।\nतथा मन्त्रविदो विप्रान् तपस्तप्त्वा सुदुष्करम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2113443, "chapter_id": 3440, "verse_number": "१४", "content_sanskrit": "गुरूनभ्युपगच्छन्ति यशसोऽर्थाय भामिनि ।\nतथा ब्रह्मर्षयः पूर्वे ब्राह्मणाश्च तपोधनाः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2113444, "chapter_id": 3440, "verse_number": "१५", "content_sanskrit": "चक्रुरुच्चावचं कर्म यशसोऽर्थाय दुष्करम् ।\nतथा राजर्षयो वीरा मनुवैन्यादयः पृथक् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2113445, "chapter_id": 3440, "verse_number": "१६", "content_sanskrit": "यशोर्थं धर्मयुक्तानि चक्रुः कर्माणि शोभने ।\nयशसा त्वं प्लवेनैव तारयैनामनिन्दिते \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2113446, "chapter_id": 3440, "verse_number": "१७", "content_sanskrit": "अपत्यसंविभागेन परां कीर्तिमवाप्स्यसि ।\nधर्म्यं वै धर्मशास्त्रोक्तं यथा वदसि तत् तथा \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2113447, "chapter_id": 3440, "verse_number": "१८", "content_sanskrit": "तस्मादनुग्रहं माद्र्याः कुरुष्व वरवर्णिनि ।\nभर्तुस्तु वचनं श्रुत्वा कुन्ती भर्तृहितैषिणी\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2113448, "chapter_id": 3440, "verse_number": "१९", "content_sanskrit": "मन्त्रग्रामं ददौ तस्यै यथाविधि शुचिस्मिता ।\nएवमुक्त्वाऽब्रवीत् स्नेहात् सकृच्चिन्तय दैवतम् ।\nतत्र ते भविताऽपत्यमनुरूपमसंशयम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2113449, "chapter_id": 3440, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2113450, "chapter_id": 3440, "verse_number": "२०", "content_sanskrit": "कुन्त्या मन्त्रे कृते तस्मिन् विधिदृष्टेन कर्मणा ।\nततो राजसुता स्नाता शयने संविवेश ह\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2113451, "chapter_id": 3440, "verse_number": "२१", "content_sanskrit": "ततो माद्री विचार्यैका जगाम मनसाऽश्विनौ ।\nतथा च माद्र्यपत्यार्थे प्रायुङ्क्त बलिमुत्तमम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2113452, "chapter_id": 3440, "verse_number": "२२", "content_sanskrit": "तावागम्य सुतौ तस्यां जनयामासतुर्यमौ ।\nजातौ च तावपि यमौ वागुवाचाद्भुतोपमौ\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2113453, "chapter_id": 3440, "verse_number": "२३", "content_sanskrit": "धर्मतो भक्तितश्चैव शीलेन विनयैस्तथा ।\nरूपसत्त्वगुणश्रेष्ठावेताविति नराधिप\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2113454, "chapter_id": 3440, "verse_number": "२४", "content_sanskrit": "भासतस्तेजसाऽत्यर्थं रूपद्रविणसम्पदा ।\nकुन्तीमथ पुनः पाण्डुर्माद्र्यर्थे समचोदयत् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2113455, "chapter_id": 3440, "verse_number": "२५", "content_sanskrit": "तमुवाच पतिं राजन् रहस्युक्ता सती तदा ।\nयुक्ता सकृद् द्वन्द्वमेषा लेभे तेनास्मि वञ्चिता \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2113456, "chapter_id": 3440, "verse_number": "२६", "content_sanskrit": "बिभेम्यस्याः परिभवान्नारीणां मतिरीदृशी ।\nनाज्ञासिषमहं मूढा द्वन्द्वाह्वाने द्वयं फलम् ।\nतस्मान्नाहं नियोक्तव्या त्वयैषोऽस्तु वरो मम\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2113457, "chapter_id": 3440, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2113458, "chapter_id": 3440, "verse_number": "२७", "content_sanskrit": "एवं पाण्डुसुताः पञ्च देवदत्ता महाबलाः ।\nसम्भूताः कीर्तिमन्तस्ते कुरुवंशविवर्धनाः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2113459, "chapter_id": 3440, "verse_number": "२८", "content_sanskrit": "देवौजसः सत्त्ववन्तः सर्वशास्त्रविशारदाः ।\nदिव्यसंहननाः सर्वे सर्वे भास्वरमूर्तयः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2113460, "chapter_id": 3440, "verse_number": "२९", "content_sanskrit": "सर्वलक्षणसम्पन्नाः सोमवत् प्रियदर्शनाः ।\nसिंहदर्पा महेष्वासाः सिंहविक्रान्तगामिनः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2113461, "chapter_id": 3440, "verse_number": "३०", "content_sanskrit": "सिंहक्षीबा मनुष्येन्द्रा ववृधुर्भीमदर्शनाः ।\nविवर्धमानास्ते तत्र पुण्ये हैमवते गिरो\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2113462, "chapter_id": 3440, "verse_number": "३१", "content_sanskrit": "विस्मयं जनयामासुर्महर्षीणां समेयुषाम् ।\nनामानि चक्रिरे तेषां शतशृङ्गनिवासिनः \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2113463, "chapter_id": 3440, "verse_number": "३२", "content_sanskrit": "ऋषयः कर्मतश्चैव रूपतः स्नेहतस्तथा ।\nयुधिष्ठिर इति ज्येष्ठं द्वितीयं भीम इत्यपि \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2113464, "chapter_id": 3440, "verse_number": "३३", "content_sanskrit": "तृतीयमर्जुन इति कुन्तीपुत्रानकल्पयन् ।\nपूर्वजं नकुलं चेति सहदेवं ततः परम् \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2113465, "chapter_id": 3440, "verse_number": "३४", "content_sanskrit": "ऊचुर्माद्रीसुतावेवं महाभागास्तपस्विनः ।\nएकवर्षान्तरास्त्वेते परस्परमरिन्दमाः \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2113466, "chapter_id": 3440, "verse_number": "३५", "content_sanskrit": "अन्ववर्धन्त पार्थाश्च यमौ पुत्रौ तथैव च ।\nते च पञ्च शतं चैव कुरुवंशविवर्धनाः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2113467, "chapter_id": 3440, "verse_number": "३६", "content_sanskrit": "सर्वे ववृधिरे राजन् कालेनाप्स्विव नीरजाः ।\nजातमात्रानुपादाय शतशृङ्गनिवासिनः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2113468, "chapter_id": 3440, "verse_number": "३८", "content_sanskrit": "पाण्डोः पुत्रानमन्यन्त तापसाः स्वानिवात्मजान् ।\nततस्तु वृष्णयः सर्वे वसुदेवपुरोगमाः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2113469, "chapter_id": 3440, "verse_number": "३९", "content_sanskrit": "पाण्डुः शापभयाद् भीतः शतशृङ्गमुपेयिवान् ।\nतत्रैव मुनिभिः सार्धं तापसोऽभूत् तपस्विभिः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2113470, "chapter_id": 3440, "verse_number": "४०", "content_sanskrit": "शाकमूलफलाहारः तपस्वी नियतेन्द्रियः ।\nध्यानयोगपरो राजा बभूवेति च वादकाः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2113471, "chapter_id": 3440, "verse_number": "४१", "content_sanskrit": "प्रब्रुवन्ति स्म बहवः तच्छ्रुत्वा शोककर्शिताः ।\nपाण्डोः प्रीतिसमायुक्ताः कदा श्रोष्याम सत्कथाः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2113472, "chapter_id": 3440, "verse_number": "४२", "content_sanskrit": "इत्येवं कथयन्तस्ते वृष्णयः सह बान्धवैः ।\nपाण्डोः पुत्रागमं श्रुत्वा सर्वे हर्षसमन्विताः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2113473, "chapter_id": 3440, "verse_number": "४३", "content_sanskrit": "सभाजयन्तस्तेऽन्योन्यं वसुदेवं वचोऽब्रुवन् ।\nन भवेरन् क्रियाहीनाः पाण्डोः पुत्रा महाबलाः ।\nपाण्डोः प्रियहितान्वेषी प्रेषय त्वं पुरोहितम् \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2113474, "chapter_id": 3440, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2113475, "chapter_id": 3440, "verse_number": "४४", "content_sanskrit": "वसुदेवस्तथेत्युक्त्वा विससर्ज पुरोहितम् ।\nयुक्तानि च कुमाराणां पारिबर्हाण्यनेकशः \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2113476, "chapter_id": 3440, "verse_number": "४५", "content_sanskrit": "कुन्तीं माद्रीं च सन्दिश्य दासीदासपरिच्छदम् ।\nगावो रौप्यं हिरण्यं च प्रेषयामास भारत \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2113477, "chapter_id": 3440, "verse_number": "४६", "content_sanskrit": "तानि सर्वाणि सङ्गृह्य प्रययौ स पुरोहितः ।\nतमागतं द्विजश्रेष्ठं काश्यपं वै पुरोहितम् \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2113478, "chapter_id": 3440, "verse_number": "४७", "content_sanskrit": "पूजयामास विधिवत् पाण्डुः परपुरञ्जयः ।\nपृथा माद्री च संहृष्टे वसुदेवं प्रशंसताम् \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2113479, "chapter_id": 3440, "verse_number": "४८", "content_sanskrit": "ततः पाण्डुः क्रियाः सर्वाः पाण्डवान् समकारयत् ।\nगर्भाधानादिकृत्यानि चौलोपनयनानि च\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2113480, "chapter_id": 3440, "verse_number": "४९", "content_sanskrit": "काश्यपः कृतवान् सर्वमुपाकर्म च भारत ।\nचौलोपनयनादूर्ध्वमृषभाक्षा यशस्विनः \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2113481, "chapter_id": 3440, "verse_number": "५०", "content_sanskrit": "वैदिकाध्ययने सर्वे समपद्यन्त पारगाः ।\nशर्य्यातेः प्रथितः पुत्रः शुको नाम परन्तपः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2113482, "chapter_id": 3440, "verse_number": "५१", "content_sanskrit": "येन सागरपर्यन्ता धनुषा निर्जिता मही ।\nअश्वमेधशतैरिष्ट्वा स महात्मा महामखैः \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2113483, "chapter_id": 3440, "verse_number": "५२", "content_sanskrit": "आराध्य देवताः सर्वाः पितॄनपि महामतिः ।\nशतशृङ्गे तपस्तेपे शाकमूलफलाशनः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2113484, "chapter_id": 3440, "verse_number": "५३", "content_sanskrit": "तेनोपकरणश्रेष्ठैः शिक्षया चोपबृंहिताः ।\nतत्प्रसादाद् धनुर्वेदे समपद्यन्त पारगाः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2113485, "chapter_id": 3440, "verse_number": "५४", "content_sanskrit": "गदायां पारगो भीमः तोमरेषु युधिष्ठिरः ।\nअसिचर्मणि निष्णातौ यमौ सत्यवतां वरौ\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2113486, "chapter_id": 3440, "verse_number": "५५", "content_sanskrit": "धनुर्वेदे गतः पारं सव्यसाची परन्तपः ।\nशुकेन समनुज्ञातो मत्समोऽयमिति प्रभो\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2113487, "chapter_id": 3440, "verse_number": "५६", "content_sanskrit": "अनुज्ञाय ततो राजा शक्तिं खङ्गं तथा शरान् ।\nधनुश्च ददतां श्रेष्ठः तालमात्रं महाप्रभम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2113488, "chapter_id": 3440, "verse_number": "५७", "content_sanskrit": "विपाठक्षुरनाराचान् गृध्रपत्रैरलङ्कृतान् ।\nददौ पार्थाय संहृष्टो महोरगसमप्रभान् \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2113489, "chapter_id": 3440, "verse_number": "५८", "content_sanskrit": "अवाप्य सर्वशस्त्राणि मुदितो वासवात्मजः ।\nमेने सर्वान् महीपालानपर्याप्तान् स्वतेजसः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2113490, "chapter_id": 3440, "verse_number": "५९", "content_sanskrit": "एकवर्षान्तरास्त्वेते परस्परमरिन्दमाः ।\nअन्ववर्धन्त पार्थाश्च माद्रीपुत्रौ तथैव च\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2113491, "chapter_id": 3440, "verse_number": "६०", "content_sanskrit": "ते च पञ्च शतं चैव कुरुवंशविवर्धनाः ।\nसर्वे ववृधुरल्पेन कालेनाप्स्विव पङ्कजाः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2113492, "chapter_id": 3440, "verse_number": "११९", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nएकोनविंशत्यधिकशततमोऽध्यायः ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2113493, "chapter_id": 3440, "verse_number": "६७", "content_sanskrit": "॥ इति सम्भवपर्वणि सप्तषष्टितमोऽध्यायः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2113494, "chapter_id": 3440, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]