[{"id": 2200218, "chapter_id": 5263, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2200219, "chapter_id": 5263, "verse_number": "१", "content_sanskrit": "सुरभ्यास्तु तदा देव्याः कीर्तिर्लक्ष्मीः सरस्वती ।\nमेधा च प्रवरा देवी याश्चतस्रोऽभिविश्रुताः\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2200220, "chapter_id": 5263, "verse_number": "२", "content_sanskrit": "पृथग्गोभ्यः किमेताः स्युरुताहो गोषु संश्रिताः ।\nदेवाः के वाऽऽश्रिता गोषु तन्मे ब्रूहि पितामह\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2200221, "chapter_id": 5263, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2200222, "chapter_id": 5263, "verse_number": "३", "content_sanskrit": "यं देवं संश्रिता गावस्तं देवं देवसञ्ज्ञितम् ।\nयद्यद्देवाश्रितं दैवं तत्तद्दैवं द्विजा विदुः\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2200223, "chapter_id": 5263, "verse_number": "४", "content_sanskrit": "सर्वेषामेव देवानां पूर्वं किल समुद्भवे ।\nअमृतार्थे सुरपतिः सुरभिं समुपस्थितः\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2200224, "chapter_id": 5263, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2200225, "chapter_id": 5263, "verse_number": "५", "content_sanskrit": "इच्छेयममृतं दत्तं त्वया देवि रसाधिकम् ।\nत्वत्प्रसादाच्छिवं मह्यममरत्वं भवेदिति\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2200226, "chapter_id": 5263, "verse_number": "", "content_sanskrit": "सुरभिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2200227, "chapter_id": 5263, "verse_number": "६", "content_sanskrit": "वत्सो भूत्वा सुरपते पिबस्व प्रस्रवं मम ।\nततोऽमरत्वमपि तत्स्थानमैन्द्रमवाप्स्यसि\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2200228, "chapter_id": 5263, "verse_number": "७", "content_sanskrit": "न च ते वृत्रहन् युद्धे व्यथाऽरिभ्यो भविष्यति ।\nबलार्थमात्मनः शक्र प्रस्रवं पिब मे विभो\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2200229, "chapter_id": 5263, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2200230, "chapter_id": 5263, "verse_number": "८", "content_sanskrit": "ततोऽधयत् स्तनं तस्याः सुरभ्याः सुरसत्तमः ।\nअमरत्वं सुरूपत्वं बलं च पदमुत्तमम्\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2200231, "chapter_id": 5263, "verse_number": "९", "content_sanskrit": "पुरन्दरोऽमृतं पीत्वा प्रहृष्टः समुपस्थितः ।\nपुत्रोऽहं तव भद्रं ते ब्रूहि किं करवाणि ते\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2200232, "chapter_id": 5263, "verse_number": "", "content_sanskrit": "सुरभिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2200233, "chapter_id": 5263, "verse_number": "१०", "content_sanskrit": "कृतं पुत्र त्वया सर्वमुपयाहि त्रिविष्टपम् ।\nपालयस्व सुरान् सर्वान् जहि ये सुरशत्रवः\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2200234, "chapter_id": 5263, "verse_number": "११", "content_sanskrit": "न च गोब्राह्मणेऽवज्ञा कार्या ते शान्तिमिच्छता ।\nगोब्राह्मणस्य निःश्वासः शोषयेदपि देवताः\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2200235, "chapter_id": 5263, "verse_number": "१२", "content_sanskrit": "गोब्राह्मणप्रियो नित्यं स्वस्तिशब्दमुदाहरन् ।\nपृथिव्यामन्तरिक्षे च नाकपृष्टे च विक्रमेत्\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2200236, "chapter_id": 5263, "verse_number": "१३", "content_sanskrit": "यच्च तेऽन्यद् भवेत् कृत्यं तन्मे ब्रूयाः समासतः ।\nतत्ते सर्वं करिष्यामि सत्यैनैतद् ब्रवीमि ते\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2200237, "chapter_id": 5263, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2200238, "chapter_id": 5263, "verse_number": "१४", "content_sanskrit": "इच्छेयं गोषु नियतं वस्तुं देवि ब्रवीमि ते ।\nएभिः सुरगणैः सार्धं ममानुग्रहमाचर\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2200239, "chapter_id": 5263, "verse_number": "", "content_sanskrit": "सुरभिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2200240, "chapter_id": 5263, "verse_number": "१५", "content_sanskrit": "गवां शरीरं प्रत्यक्षमेतत् कौशिक लक्षये ।\nयो यत्रोत्सहते वस्तुं स तत्र वसतां सुरः\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2200241, "chapter_id": 5263, "verse_number": "१६", "content_sanskrit": "सर्वं पवित्रं परमं गवां गात्रं सुपूजितम् ।\nतथा कुरुष्व भद्रं ते यया त्वं शक्र मन्यसे\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2200242, "chapter_id": 5263, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2200243, "chapter_id": 5263, "verse_number": "१७", "content_sanskrit": "तस्यास्तद्वचनं श्रुत्वा सुरभ्याः सुरसत्तमः ।\nसह सर्वैः सुरगणैरभजत् सौरभीं प्रजाम्\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2200244, "chapter_id": 5263, "verse_number": "१८", "content_sanskrit": "शृङ्गे वक्त्रे च जिह्वायां देवराजः समाविशत् ।\nसर्वच्छिद्रेषु पवनः पादेषु मरुतां गणाः\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2200245, "chapter_id": 5263, "verse_number": "१९", "content_sanskrit": "ककुदं सर्वगो रुद्रः कुक्षौ चैव हुताशनः ।\nसरस्वतीं स्तनेष्वग्र्या श्रीः पुरीषे जगत्प्रिया\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2200246, "chapter_id": 5263, "verse_number": "२०", "content_sanskrit": "मूत्रे कीर्तिः सुमहती मेधा पयसि शाश्वती ।\nवक्त्रे सोमश्च वै देवो हृदये भगवान् यमः\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2200247, "chapter_id": 5263, "verse_number": "२१", "content_sanskrit": "धर्मः पुच्छे क्रिया लोम्नि भास्करश्चक्षुषी श्रितः ।\nसिद्धा सन्धिषु सिद्धिश्च तपस्तेजश्च चेष्टने\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2200248, "chapter_id": 5263, "verse_number": "२२", "content_sanskrit": "एवं सर्वे सुरगणा नियता गात्रवर्त्मसु ।\nमहती देवता गावो ब्राह्मणैः परिसंस्कृताः\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2200249, "chapter_id": 5263, "verse_number": "२३", "content_sanskrit": "गामाश्रयन्ति सहिता देवा हि प्रभविष्णवः ।\nकिमन्यत् सर्वकामेन न विदध्याद् भवान् प्रियम्\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2200250, "chapter_id": 5263, "verse_number": "२४", "content_sanskrit": "भावतः परया भक्त्या पूजयस्व नरेश्वर ।\nगावस्तु परमं लोके पवित्रं पावनं हविः\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2200251, "chapter_id": 5263, "verse_number": "२५", "content_sanskrit": "निपात्य भर्जितं स्वर्गाद् भार्गवः फेनपः किल ।\nस्वर्गोः प्राणान् पुनर्लब्ध्वा प्रीतो गोलोकमाश्रितः\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2200252, "chapter_id": 5263, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे देवानां सुरभिशरीरप्रवेशो नाम चतुर्दशाधिकशततमोऽध्यायः ॥११४॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]