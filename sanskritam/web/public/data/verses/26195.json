[{"id": 7006195000, "chapter_id": 26195, "verse_number": "२-२३-१", "content_sanskrit": "वसिष्ठ उवाच तपस्विनं तदा राममेकाग्रमनसं भवे ।\nरहस्येकान्तनिरतं नियतं शंसितव्रतम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006195001, "chapter_id": 26195, "verse_number": "२-२३-२", "content_sanskrit": "श्रुत्वा तमृषयः सर्वे तपोनिर्धूतकल्मषाः ।\nज्ञानकर्मवयोवृद्धा महान्तः शंसितव्रताः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006195002, "chapter_id": 26195, "verse_number": "२-२३-३", "content_sanskrit": "दिदृक्षवः समाजग्मुः कुतूहलसमन्विताः ।\nख्यापयन्तस्तपः श्रेष्ठं तस्य राजन्महात्मनः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006195003, "chapter_id": 26195, "verse_number": "२-२३-४", "content_sanskrit": "भृग्वत्रिक्रतुजाबालिवामदेवमृकण्डवः ।\nसंभावयन्तस्ते रामं मुनयो वृद्धसंमताः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006195004, "chapter_id": 26195, "verse_number": "२-२३-५", "content_sanskrit": "आजग्मुराश्रमं तस्य रामस्य तपसस्तपः ।\nदूरादेव महान्तस्ते पुण्यक्षेत्रनिवासिनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006195005, "chapter_id": 26195, "verse_number": "२-२३-६", "content_sanskrit": "गरीयः सर्वलोकेषु तपोऽग्र्यं ज्ञानमेव च ।\nप्रशस्य तस्य ते सर्वेप्रययुः स्वं स्वमाश्रमम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006195006, "chapter_id": 26195, "verse_number": "२-२३-७", "content_sanskrit": "एवं प्रवर्त्ततस्तस्य रामस्य भगवाञ्छिवः ।\nप्रसन्नचेता नितरां बभूव नृपसत्तम ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006195007, "chapter_id": 26195, "verse_number": "२-२३-८", "content_sanskrit": "जिज्ञासुस्तस्य भगवान् भक्तिमात्मनि शङ्करः ।\nमृगव्याधवपुर्भूत्वा ययौ राजंस्तदन्तिकम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006195008, "chapter_id": 26195, "verse_number": "२-२३-९", "content_sanskrit": "भिन्नाञ्जनचयप्रख्यो रक्तान्तायतलोचनः ।\nशरचापधरः प्रांशुर्वज्रसंहननो युवा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006195009, "chapter_id": 26195, "verse_number": "२-२३-१०", "content_sanskrit": "उत्तुङ्गहनुबाह्वंसः पिङ्गलश्मश्रुमूर्द्धजः ।\nमांसविस्रवसागन्धी सर्वप्राणिविहिंसकः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006195010, "chapter_id": 26195, "verse_number": "२-२३-११", "content_sanskrit": "सकण्टकुलतास्पर्शक्षतारूषितविग्रहः ।\nसामटक्संचर्वमाणश्च मांसखण्डमनेकशः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006195011, "chapter_id": 26195, "verse_number": "२-२३-१२", "content_sanskrit": "मांसभारद्वयालंबिविधानानतकन्धरः ।\nआरुजंस्तरसा वृक्षानूरुवेगेन संघशः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006195012, "chapter_id": 26195, "verse_number": "२-२३-१३", "content_sanskrit": "अभ्यवर्त्तत तं देशं पादचारीव पर्वतः ।\nआसाद्य सरसस्तस्य तीरं कुसुमितद्रुमम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006195013, "chapter_id": 26195, "verse_number": "२-२३-१४", "content_sanskrit": "न्यदधान्मासभारं च स मूले कस्यचित्तरोः ।\nनिषसाद क्षणन्तत्र तरुच्छायामुपाश्रितः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006195014, "chapter_id": 26195, "verse_number": "२-२३-१५", "content_sanskrit": "तिष्ठन्तं सरसस्तीरे सोऽपश्यद्भृगुनन्दनम् ।\nततः स शीघ्रमुत्थाय समीपमुपसृत्य च ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006195015, "chapter_id": 26195, "verse_number": "२-२३-१६", "content_sanskrit": "रामाय सेषुचापाभ्यां कराभ्यां विदधेंऽजलिम् ।\nसजलांभोदसन्नादगंभीरेण स्वरेण च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006195016, "chapter_id": 26195, "verse_number": "२-२३-१७", "content_sanskrit": "जगाद भृगुशार्दूलं गुहान्तरविसर्पिणा ।\nतोषप्रवर्षव्याधोऽहं वसाम्यस्मिन्महावने ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006195017, "chapter_id": 26195, "verse_number": "२-२३-१८", "content_sanskrit": "ईशोऽहमस्य देशस्य सप्राणितरुवीरुधः ।\nचरामि समचित्तात्मा नानासत्त्वा मिषाशनः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006195018, "chapter_id": 26195, "verse_number": "२-२३-१९", "content_sanskrit": "समश्च सर्वभूतेषु न च पित्रादयोऽपि मे ।\nअभक्ष्यागम्यपेयादिच्छन्दवस्तुषु कुत्रचित् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006195019, "chapter_id": 26195, "verse_number": "२-२३-२०", "content_sanskrit": "कृत्याकृत्यविधौचैव न विशेषितधीरहम् ।\nप्रपन्नो नाभिगमनं निवासमपि कस्यचित् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006195020, "chapter_id": 26195, "verse_number": "२-२३-२१", "content_sanskrit": "शक्रस्यापि बलेनाहमनुमन्ये न संशयः ।\nजानते तध्यथा सर्वे देशोऽयं मदुपाश्रयः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006195021, "chapter_id": 26195, "verse_number": "२-२३-२२", "content_sanskrit": "तस्मान्न कश्चिदायाति ममात्रानुमतिं विना ।\nइत्येष मम वृत्तान्तः कार्त्स्न्येन कथितस्तव ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006195022, "chapter_id": 26195, "verse_number": "२-२३-२३", "content_sanskrit": "त्वं च मे ब्रूहि तत्त्वेन निजवृत्तमशेषतः ।\nकस्त्वं कस्मादिहायातः किमर्थमिह धिष्ठितः ।\nउद्यतोऽन्यत्र वा गन्तुं किं वा तव चिकीर्षितम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006195023, "chapter_id": 26195, "verse_number": "२-२३-२४", "content_sanskrit": "वसिष्ठ उवाच इत्येवमुक्तः प्रहसंस्तेन रामो महाद्युतिः ।\nतूष्णीं क्षणमिव स्थित्वा दध्यौ किञ्चिदवाङ्मुखः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006195024, "chapter_id": 26195, "verse_number": "२-२३-२५", "content_sanskrit": "कोऽयमेव दुराधर्षः सजलांभोदनिस्वनः ।\nब्रवीति च गिरोऽत्यर्थं विस्पष्टार्थपदाक्षराः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006195025, "chapter_id": 26195, "verse_number": "२-२३-२६", "content_sanskrit": "किं तु मे महतीं शङ्कां तनुरस्य तनोति वै ।\nविजातिसंश्रयत्वेन रमणीया तथा शराः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006195026, "chapter_id": 26195, "verse_number": "२-२३-२७", "content_sanskrit": "एवं चिन्तयतस्तस्य निमित्तानि शुभानि वै ।\nबभूवुर्भुवि देहे च स्वाभिप्रेतार्थदान्यलम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006195027, "chapter_id": 26195, "verse_number": "२-२३-२८", "content_sanskrit": "ततो विमृश्य बहुशो मनसाभृगुपुङ्गवः ।\nउवाच शनकैर्व्याधं वचनं सूनृताक्षरम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006195028, "chapter_id": 26195, "verse_number": "२-२३-२९", "content_sanskrit": "जामदग्न्योऽस्मि भद्रं ते रामो नाम्ना तु भार्गवः ।\nतपश्चर्तुमिहायातः सांप्रतं गुरुशासनात् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006195029, "chapter_id": 26195, "verse_number": "२-२३-३०", "content_sanskrit": "तपसा सर्वलोकेशं भक्त्या च नियमेन च ।\nआराधयितुमस्मिंस्तु चिरायाहं समुद्यतः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006195030, "chapter_id": 26195, "verse_number": "२-२३-३१", "content_sanskrit": "तस्मात्मर्वेश्वरं सर्वशरण्यमभयप्रदम् ।\nत्रिनेत्रं पापदमनं शङ्करं भक्तवत्सलम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006195031, "chapter_id": 26195, "verse_number": "२-२३-३२", "content_sanskrit": "तपसा तोषयिष्यामि सर्वज्ञं त्रिपुरान्तकम् ।\nआश्रमेऽस्मिनसरस्तीरे नियमं समुपाश्रितः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006195032, "chapter_id": 26195, "verse_number": "२-२३-३३", "content_sanskrit": "भक्तानुकंपी भगवान्यावत्प्रत्यक्षतां हरः ।\nउपैति तावदत्रैव स्थास्यामीति मतिर्मम ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006195033, "chapter_id": 26195, "verse_number": "२-२३-३४", "content_sanskrit": "तस्मादितस्त्वयाद्यैव गन्तुमन्यत्र युज्यते ।\nन चेद्भवति मे हानिः स्वकृतेर्नियमस्य च ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006195034, "chapter_id": 26195, "verse_number": "२-२३-३५", "content_sanskrit": "माननीयोऽथ वाहं ते भक्त्या देशान्तरातिथिः ।\nस्वनिवासमुपायातस्तपस्वी च तथा मुनिः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006195035, "chapter_id": 26195, "verse_number": "२-२३-३६", "content_sanskrit": "त्वतसंनिधौ निवासो मे भवेत्पापाय केवलम् ।\nतव चाप्यसुखोदर्कं मत्समीपनिषेवणम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006195036, "chapter_id": 26195, "verse_number": "२-२३-३७", "content_sanskrit": "स त्वंमदाश्रमोपान्ते परिचङ्क्रमणादिकम् ।\nपरित्यज्य सुखीभूया लोकयोरुभयोरपि ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006195037, "chapter_id": 26195, "verse_number": "२-२३-३८", "content_sanskrit": "वसिष्ठ उवाच इति तस्य वचः श्रुत्वा स भूयो भृगुपुङ्गवम् ।\nउवाच रोषताम्राक्षस्ताम्राक्षमिदमुत्तरम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006195038, "chapter_id": 26195, "verse_number": "२-२३-३९", "content_sanskrit": "ब्रह्मन् किमिदमत्यर्थं समीपे वसतिं मम ।\nपरिगर्हयसे येन कृतघ्नस्येव कांप्रतम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006195039, "chapter_id": 26195, "verse_number": "२-२३-४०", "content_sanskrit": "किं मयापकृतं लोके भवतोऽन्यस्य वा क्वचित् ।\nअनागस्कारिणं दान्तं कोऽवमन्येत नामतः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006195040, "chapter_id": 26195, "verse_number": "२-२३-४१", "content_sanskrit": "सन्निधिः परिहर्त्तव्यो यदि मे विप्रपुङ्गव ।\nदर्शनं सह संवासः संभाषणमथापि च ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006195041, "chapter_id": 26195, "verse_number": "२-२३-४२", "content_sanskrit": "आयुष्मताधुनैवास्मादपसर्त्तव्यमाश्रमात् ।\nस्वसंश्रयं परित्यज्य क्वाहं यास्ये बुभुक्षितः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006195042, "chapter_id": 26195, "verse_number": "२-२३-४३", "content_sanskrit": "स्वाधिवासं परित्यज्य भवता योदितः कथम् ।\nइतोऽन्यस्मिन् गामिष्यामि दूरे नाहं विशेषतः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006195043, "chapter_id": 26195, "verse_number": "२-२३-४४", "content_sanskrit": "गम्यतां भवतान्यत्र स्थीयतामत्र वेच्छया ।\nनाहं चालयितुं शक्यः स्थानादस्मात्कथञ्चन ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006195044, "chapter_id": 26195, "verse_number": "२-२३-४५", "content_sanskrit": "वसिष्ठ उवाच तच्छ्रुत्वा वचनं तस्य किञ्चित्कोपसमन्वितः ।\nतमुवाच पुनर्वाक्यमिदं राजन्भृगूद्वहः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006195045, "chapter_id": 26195, "verse_number": "२-२३-४६", "content_sanskrit": "व्याधजातिरियं क्रूरा सर्वसत्त्वभयावहा ।\nखलकर्मरता नित्यं धिक्कृता सर्वजन्तुभिः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006195046, "chapter_id": 26195, "verse_number": "२-२३-४७", "content_sanskrit": "तस्यां जातोऽसि पापीयान्सर्वप्राणिविहिंसकः ।\nस कथं न परित्याज्यः सुजनैः स्यात्तु दुर्मते ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006195047, "chapter_id": 26195, "verse_number": "२-२३-४८", "content_sanskrit": "तस्माद्विहीनजातीयं विदित्वात्मानमब्यथ ।\nशीघ्रमस्माद्व्रजान्यत्र नात्र कार्या विचारणा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006195048, "chapter_id": 26195, "verse_number": "२-२३-४९", "content_sanskrit": "शरीरत्राणकारुण्यात्समीपं नोपसर्पसि ।\nयथा त्वं कण्टकादीनामसहिष्णुतया व्यथाम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006195049, "chapter_id": 26195, "verse_number": "२-२३-५०", "content_sanskrit": "तथावेहि समस्तानां प्रियाः प्राणाः शरीरिणाम् ।\nव्यथा चाभिहतानां तु विद्यते भवतोऽन्यथा ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006195050, "chapter_id": 26195, "verse_number": "२-२३-५१", "content_sanskrit": "अहिंसा सर्वभूतानामिति धर्मः सनातनः ।\nएतद्विरुद्धाचरणान्नित्यं सद्भिर्विगर्हितः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006195051, "chapter_id": 26195, "verse_number": "२-२३-५२", "content_sanskrit": "आत्मप्राणाभिरक्षार्थं त्वमशेषशरीरिणः ।\nहनिष्यसि कथं सत्सुनाप्नोषि वचनीयताम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006195052, "chapter_id": 26195, "verse_number": "२-२३-५३", "content_sanskrit": "तस्माच्छीघ्रं तु भोगच्छ त्वमेव पुरुषाधम ।\nत्वया मे कृत्यदोषस्य हानिश्च न भविष्यति ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006195053, "chapter_id": 26195, "verse_number": "२-२३-५४", "content_sanskrit": "न चत्स्वयमितो गच्छेश्ततस्तव बलादपि ।\nअपसर्पणताबुद्धिमहमुत्पादये स्फुटम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006195054, "chapter_id": 26195, "verse_number": "२-२३-५५", "content_sanskrit": "क्षणार्द्धमपि ते पाप श्रेयसी नेह संस्थितिः ।\nविरुद्धाचरणो नित्यं धर्मद्रिष्को लभेच्च शाम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006195055, "chapter_id": 26195, "verse_number": "२-२३-५६", "content_sanskrit": "वसिष्ठ उवाच रामस्य वचनं श्रुत्वा प्रीतोऽपि तमिदं वचः ।\nउवाच संक्रुद्ध इव व्याधरूपी पिनाकधृक् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006195056, "chapter_id": 26195, "verse_number": "२-२३-५७", "content_sanskrit": "सर्वमेतदहं मन्यं व्यर्थं व्यवसितं तव ।\nकुतस्त्वं प्रथमो ज्ञानी कुतः शंभुः कुतस्तपः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006195057, "chapter_id": 26195, "verse_number": "२-२३-५८", "content_sanskrit": "कुतस्त्वं क्लिश्यसे मूढ तपसा तेन तेऽधुना ।\nघ्रुवं मिथ्याप्रवृत्तस्य न हि तुष्यति शङ्करः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006195058, "chapter_id": 26195, "verse_number": "२-२३-५९", "content_sanskrit": "विरुद्धलोकाचरणः शंभुस्तस्य वितुष्टये ।\nप्रतपत्यबुधो मर्त्त्यस्त्वां विना कः मुदुर्मते ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006195059, "chapter_id": 26195, "verse_number": "२-२३-६०", "content_sanskrit": "अथ वा च गतं मेऽद्य युक्तमेतदसंशयम् ।\nसंपूज्य पूजकविद्धौ शंभोस्तव च संगमः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006195060, "chapter_id": 26195, "verse_number": "२-२३-६१", "content_sanskrit": "त्वया पूजयितुं युक्तः स एव भुवने रतः ।\nसंपूजकोऽपि तस्य त्वं योग्यो नात्र विचारणा ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006195061, "chapter_id": 26195, "verse_number": "२-२३-६२", "content_sanskrit": "पितामहस्य लोकानां ब्रह्मणः परमेष्ठिनः ।\nशिरश्छित्त्वा पुनः शंभुर्ब्रह्महत्यामवाप्तवान् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006195062, "chapter_id": 26195, "verse_number": "२-२३-६३", "content_sanskrit": "ब्रह्महत्याभिभूतेन प्रायस्त्वं शंभुना द्विज ।\nउपदिष्टोऽसि तत्कर्तुं नोचेदेवं कथं कृथाः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006195063, "chapter_id": 26195, "verse_number": "२-२३-६४", "content_sanskrit": "तादात्म्यगुणसंयोगान्मन्यं रुद्रस्य तेऽधुना ।\nतपः सिद्धिरनुप्राप्ता कोलेनाल्पीयसा मुने ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006195064, "chapter_id": 26195, "verse_number": "२-२३-६५", "content_sanskrit": "प्रायोऽद्य मातरं हत्वा सर्वैलोङ्कैर्निराकृतः ।\nतपोव्याजेन गहने निर्जने संप्रवर्त्तसे ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006195065, "chapter_id": 26195, "verse_number": "२-२३-६६", "content_sanskrit": "गुरुस्त्रीब्रह्महत्योत्थपातकक्षपणाय च ।\nतपश्चरसि नानेन तपसा तत्प्रणश्यति ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006195066, "chapter_id": 26195, "verse_number": "२-२३-६७", "content_sanskrit": "पातकानां किलान्येषां प्रायश्चित्तानि संत्यपि ।\nमातृद्रुहामवेहि त्वं न क्वचित्किल निष्कृतिः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006195067, "chapter_id": 26195, "verse_number": "२-२३-६८", "content_sanskrit": "अहिंसालक्षणो धर्मो लोकेषु यदि ते मतः ।\nस्वहस्तेन कथं राम मातरं कृत्तवानसि ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006195068, "chapter_id": 26195, "verse_number": "२-२३-६९", "content_sanskrit": "कृत्वा मातृवधं घोरं सर्वलोकविगर्हितम् ।\nत्वं पुनर्धार्मिको भूत्वा कामतोऽन्यान्विनिन्दसि ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006195069, "chapter_id": 26195, "verse_number": "२-२३-७०", "content_sanskrit": "पश्यता हसतामोघं आत्मदोषमजानता ।\nअपर्याप्तमहं नन्यं परं दोषविमर्शनाम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006195070, "chapter_id": 26195, "verse_number": "२-२३-७१", "content_sanskrit": "स्वधर्मं यद्यहं त्यक्त्वा वर्त्तेयमकुलोभयम् ।\nतर्हि गर्हय मां कामं निरुप्य मनसा स्वयम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006195071, "chapter_id": 26195, "verse_number": "२-२३-७२", "content_sanskrit": "मातापितृसुतादीनां भरणायैव केवलम् ।\nक्रियते प्राणिहननं निजधर्मतया मया ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006195072, "chapter_id": 26195, "verse_number": "२-२३-७३", "content_sanskrit": "स्वधर्मादामिषेणाहं सकुटुम्बो दिनेदिने ।\nवर्त्तामि सापि मे वृत्तिर्विधात्रा विहिता पुरा ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006195073, "chapter_id": 26195, "verse_number": "२-२३-७४", "content_sanskrit": "मांसेन यावता मे स्यान्नित्यं पित्रादि पोषणम् ।\nहनिष्ये चेत्तदधिकं तर्हि युज्येयमेनसा ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006195074, "chapter_id": 26195, "verse_number": "२-२३-७५", "content_sanskrit": "यावत्पोषणघातेन न वयं स्याम निन्दिताः ।\nतदेतत्संप्रधार्य त्वं निन्दवा मां प्रशंस वा ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006195075, "chapter_id": 26195, "verse_number": "२-२३-७६", "content_sanskrit": "साधु वासाधु वा कर्म यस्य यद्विहितं पुरा ।\nतदेव तेन कर्त्तव्यमापद्यपि कथञ्चन ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006195076, "chapter_id": 26195, "verse_number": "२-२३-७७", "content_sanskrit": "निरूपय स्वभुद्ध्या त्वमात्मनो मम चान्तरम् ।\nअहं तु सर्वभावेन मित्रादिभरणे रतः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006195077, "chapter_id": 26195, "verse_number": "२-२३-७८", "content_sanskrit": "संत्यज्य पितरं वृद्धं विनिहत्य च मातरम् ।\nभूत्वा तु धार्मिकस्त्वं तु तपश्चर्तुमिहागतः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006195078, "chapter_id": 26195, "verse_number": "२-२३-७९", "content_sanskrit": "ये तु मूलविदस्तेषां विस्पष्टं यत्र दर्शनम् ।\nयथाजिह्वं भवेन्नात्र वचसापि समीहितुम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006195079, "chapter_id": 26195, "verse_number": "२-२३-८०", "content_sanskrit": "अहं तु सम्यग्जानामि तव वृत्तमशेषतः ।\nतस्मादलं ते तपसा निष्फलेन भृगूद्वह ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006195080, "chapter_id": 26195, "verse_number": "२-२३-८१", "content_sanskrit": "सुखमिच्छसि चेत्त्यक्त्वा कायक्लेशकरं तपः ।\nयाहि राम त्वमन्यत्र यत्र वा न विदुर्जनाः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}]