[{"id": 7005422000, "chapter_id": 25422, "verse_number": "८८-१", "content_sanskrit": "पुलस्त्य उवाच ।\nद्वितीयं पापशमनं स्तवं वक्ष्यामि ते मुने ।\nयेन सम्यगधीतेन पापं नाशं तु गच्चति ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005422001, "chapter_id": 25422, "verse_number": "८८-२", "content_sanskrit": "मत्स्यं नमस्ये देवेशं कूर्मं गोविन्दमेव च ।\nहयशीर्षं नमस्तेऽहं भवं विष्णुं त्रिविक्रमम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005422002, "chapter_id": 25422, "verse_number": "८८-३", "content_sanskrit": "नमस्ये माधवेशानौ हृषीकशकुमारिणौ ।\nनारायणं नमस्येऽहं नमस्ये गरुडासनम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005422003, "chapter_id": 25422, "verse_number": "८८-४", "content_sanskrit": "ऊर्ध्वकेशं नृसिहं च रुपधारं कुरुध्वजम् ।\nकामपालमखण्डं च नमस्ये ब्राह्मणप्रियम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005422004, "chapter_id": 25422, "verse_number": "८८-५", "content_sanskrit": "अजितं विश्वकर्माणं पुण्डरीकं द्विजप्रियम् ।\nहंसं शंभुं नमस्ये च ब्रह्माणं सप्रजापतिम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005422005, "chapter_id": 25422, "verse_number": "८८-६", "content_sanskrit": "नमस्ये शूलबाहुं च देवं चक्रधरं तथा ।\nशिवं विष्णुं सुवर्णाक्षं गोपतिं पीतवाससम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005422006, "chapter_id": 25422, "verse_number": "८८-७", "content_sanskrit": "नमस्ये च गदापाणिं नमस्ये च कुशेशयम् ।\nअर्धनारीश्वरं देवं नमस्ये पापनाशनम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005422007, "chapter_id": 25422, "verse_number": "८८-८", "content_sanskrit": "गोपालं च सवैकुण्ठं नमस्ये चापराजितम् ।\nनमस्ये विश्वरूपं च सौगन्धिं सर्वदा शिवम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005422008, "chapter_id": 25422, "verse_number": "८८-९", "content_sanskrit": "पाञ्चालिकं हयग्रीवं स्वयम्भुवममरेश्वरम् ।\nनमस्ये पुष्कराक्षं च पयोगन्धिं च केशवम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005422009, "chapter_id": 25422, "verse_number": "८८-१०", "content_sanskrit": "अविमुक्तं च लोलं च ज्येष्ठेशं मध्यमं तथा ।\nउपशान्तं तमस्येऽहं मार्कण्डेयं सजम्बुकम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005422010, "chapter_id": 25422, "verse_number": "८८-११", "content_sanskrit": "नमस्ये पद्मकिरणं नमस्ये वडवामुखम् कर्तिकेयं नमस्येऽहं बाह्लीकं शिखिनं तथा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005422011, "chapter_id": 25422, "verse_number": "८८-१२", "content_sanskrit": "नमस्ये स्थाणुमनघं नमस्ये वनमालिनम् ।\nनमस्ये लाङ्गलीशं च नमस्येऽहं श्रियः पतिम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005422012, "chapter_id": 25422, "verse_number": "८८-१३", "content_sanskrit": "नमस्ये च त्रिनयनं नमस्ये हव्यवाहनम् ।\nनमस्ये च त्रिसौवर्णं नमस्ये शशिभूषणम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005422013, "chapter_id": 25422, "verse_number": "८८-१४", "content_sanskrit": "त्रिणाचिकेतं ब्रह्मेशं नमस्ये शशिभूषणम् ।\nकपर्दिनं नमस्ये च सर्वामयविनाशनम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005422014, "chapter_id": 25422, "verse_number": "८८-१५", "content_sanskrit": "नमस्ये शशिनं सूर्यं ध्रुवं रौद्रं महौजसम् ।\nपद्मनाभं हिरण्याक्षं नमस्ये स्कन्दमव्ययम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005422015, "chapter_id": 25422, "verse_number": "८८-१६", "content_sanskrit": "नमस्ये भीमहंसौ च नमस्ये हाटकेश्वरम् ।\nसदा हंसं नमस्ये च नमस्ये प्राणतर्पणम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005422016, "chapter_id": 25422, "verse_number": "८८-१७", "content_sanskrit": "नमस्ये रुक्मकवचं महायोगिनमीश्वरम् ।\nनमस्ये श्रीनिवासं च नमस्ये पुरुषोत्तमम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005422017, "chapter_id": 25422, "verse_number": "८८-१८", "content_sanskrit": "नमस्ये च चतुर्बाहुं नमस्ये वसुधाधिपम् ।\nवनस्पतिं पशुपतिं नमस्ये प्रभुमव्ययम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005422018, "chapter_id": 25422, "verse_number": "८८-१९", "content_sanskrit": "श्रीकण्ठं वासुदेवं नीलकण्ठं सदण्डिनम् ।\nनमस्ये सर्वमनघं गौरीशं नकुलीश्वरम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005422019, "chapter_id": 25422, "verse_number": "८८-२०", "content_sanskrit": "मनोहरं कृष्णकेशं नमस्ये चक्रपाणिनम् ।\nयशोधरं महाबाहुं नमस्ये च कुशप्रियम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005422020, "chapter_id": 25422, "verse_number": "८८-२१", "content_sanskrit": "भूधरं छादितगदं सुनेत्रं शूलशङ्खिनम् ।\nभद्राक्षं वीरभद्रं च नमस्ये शङ्कुकर्णिकम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005422021, "chapter_id": 25422, "verse_number": "८८-२२", "content_sanskrit": "वृषध्वजं महेशं च विश्वामित्रं शशिप्रभम् ।\nउपेन्द्र चैव गोविन्दं नमस्ते पङ्कजप्रियम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005422022, "chapter_id": 25422, "verse_number": "८८-२३", "content_sanskrit": "सहस्रशिरसं देवं नमस्ये कुन्दमालिनम् ।\nकालाग्निं रुद्रदेवेशं नमस्ये कृत्तिवाससम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005422023, "chapter_id": 25422, "verse_number": "८८-२४", "content_sanskrit": "नमस्ये छागलेशं च नमस्ये पङ्कजासनम् ।\nसहस्राक्षं कोकनदं नमस्ये हरिशंकरम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005422024, "chapter_id": 25422, "verse_number": "८८-२५", "content_sanskrit": "अगस्त्यं गरुडं विष्णुं कपिलं ब्रह्मवाङ्मयम् ।\nसनातनं च ब्रह्माणं नमस्ये ब्रह्मतत्परम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005422025, "chapter_id": 25422, "verse_number": "८८-२६", "content_sanskrit": "अप्रतर्क्यं चतुर्बाहुं सहस्रांशुं तपोमयम् ।\nनमस्ये धर्मराजानं देवं गरुडवाहनम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005422026, "chapter_id": 25422, "verse_number": "८८-२७", "content_sanskrit": "सर्वभूतगतं शान्तं निर्मलं सर्वलक्षणम् ।\nमहायोगिनमव्यक्तं नमस्ये पापनाशनम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005422027, "chapter_id": 25422, "verse_number": "८८-२८", "content_sanskrit": "निरञ्जनं निराकारं निर्गुणं निर्मलं पदम् ।\nनमस्ये पापहन्तारं शरण्यं शरणं व्रजे ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005422028, "chapter_id": 25422, "verse_number": "८८-२९", "content_sanskrit": "एतत् पवित्रं परमं पुराणं प्रोक्तं त्वगस्त्येन महर्षिणा च ।\nधन्यं यशस्यं बहुपापनाशनं संकर्तनात् स्मरणात् संश्रवाच्च  ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]