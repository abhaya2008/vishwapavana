[{"id": 7001097000, "chapter_id": 21097, "verse_number": "२-१-८-१", "content_sanskrit": "ब्रह्मोवाच ।\nएवं तयोर्मुनिश्रेष्ठ दर्शनं कांक्षमाणयोः ।\nविगर्वयोश्च सुरयोः सदा नौ स्थितयोर्मुने॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001097001, "chapter_id": 21097, "verse_number": "२-१-८-२", "content_sanskrit": "दयालुरभवच्छंभुर्दीनानां प्रतिपालकः ।\nगर्विणां गर्वहर्ता च सवेषां प्रभुरव्ययः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001097002, "chapter_id": 21097, "verse_number": "२-१-८-३", "content_sanskrit": "तदा समभवत्तत्र नादो वै शब्दलक्षणः ।\nओमोमिति सुरश्रेष्ठात्सुव्यक्तः प्लुतलक्षणः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001097003, "chapter_id": 21097, "verse_number": "२-१-८-४", "content_sanskrit": "किमिदं त्विति संचिंत्य मया तिष्ठन्महास्वनः ।\nविष्णुस्सर्वसुराराध्यो निर्वैरस्तुष्टचेतसा॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001097004, "chapter_id": 21097, "verse_number": "२-१-८-५", "content_sanskrit": "लिंगस्य दक्षिणे भागे तथापश्यत्सनातनम् ।\nआद्यं वर्णमकाराख्यमुकारं चोत्तरं ततः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001097005, "chapter_id": 21097, "verse_number": "२-१-८-६", "content_sanskrit": "मकारं मध्यतश्चैव नादमंतेऽस्य चोमिति ।\nसूर्यमंडलवद्दृष्ट्वा वर्णमाद्यं तु दक्षिणे॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001097006, "chapter_id": 21097, "verse_number": "२-१-८-७", "content_sanskrit": "उत्तरे पावकप्रख्यमुकारमृषि सत्तम ।\nशीतांशुमण्डलप्रख्यं मकारं तस्य मध्यतः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001097007, "chapter_id": 21097, "verse_number": "२-१-८-८", "content_sanskrit": "तस्योपरि तदाऽपश्यच्छुद्धस्फटिकसुप्रभम् ।\nतुरीयातीतममलं निष्कलं निरुपद्रवम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001097008, "chapter_id": 21097, "verse_number": "२-१-८-९", "content_sanskrit": "निर्द्वंद्वं केवलं शून्यं बाह्याभ्यंतरवर्जितम् ।\nस बाह्यभ्यंतरे चैव बाह्याभ्यंतरसंस्थितम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001097009, "chapter_id": 21097, "verse_number": "२-१-८-१०", "content_sanskrit": "आदिमध्यांतरहितमानंदस्यापिकारणम् ।\nसत्यमानन्दममृतं परं ब्रह्मपरायणम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001097010, "chapter_id": 21097, "verse_number": "२-१-८-११", "content_sanskrit": "कुत एवात्र संभूतः परीक्षावोऽग्निसंभवम् ।\nअधोगमिष्याम्यनलस्तंभस्यानुपमस्य च॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001097011, "chapter_id": 21097, "verse_number": "२-१-८-१२", "content_sanskrit": "वेदशब्दोभयावेशं विश्वात्मानं व्यचिंतयत् ।\nतदाऽभवदृषिस्तत्र ऋषेस्सारतमं स्मृतम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001097012, "chapter_id": 21097, "verse_number": "२-१-८-१३", "content_sanskrit": "तेनैव ऋषिणा विष्णुर्ज्ञातवान्परमेश्वरम् ।\nमहादेवं परं ब्रह्म शब्दब्रह्मतनुं परम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001097013, "chapter_id": 21097, "verse_number": "२-१-८-१४", "content_sanskrit": "चिंतया रहितो रुद्रो वाचो यन्मनसा सह ।\nअप्राप्य तन्निवर्तंते वाच्यस्त्वेकाक्षरेण सः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001097014, "chapter_id": 21097, "verse_number": "२-१-८-१५", "content_sanskrit": "एकाक्षरेण तद्वाक्यमृतं परमकारणम् ।\nसत्यमानन्दममृतं परं ब्रह्म परात्परम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001097015, "chapter_id": 21097, "verse_number": "२-१-८-१६", "content_sanskrit": "एकाक्षरादकाराख्याद्भगवान्बीजकोण्डजः ।\nएकाक्षरादुकाराख्याद्धरिः परमकारणम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001097016, "chapter_id": 21097, "verse_number": "२-१-८-१७", "content_sanskrit": "एकाक्षरान्मकाराख्याद्भगवान्नीललोहितः ।\nसर्गकर्ता त्वकाराख्यो ह्युकाराख्यस्तु मोहकः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001097017, "chapter_id": 21097, "verse_number": "२-१-८-१८", "content_sanskrit": "मकाराख्यस्तु यो नित्यमनुग्रहकरोऽभवत् ।\nमकाराख्यो विभुर्बीजी ह्यकारो बीज उच्यते॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001097018, "chapter_id": 21097, "verse_number": "२-१-८-१९", "content_sanskrit": "उकाराख्यो हरिर्योनिः प्रधानपुरुषेश्वरः ।\nबीजी च बीजं तद्योनिर्नादाख्यश्च महेश्वरः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001097019, "chapter_id": 21097, "verse_number": "२-१-८-२०", "content_sanskrit": "बीजी विभज्य चात्मानं स्वेच्छया तु व्यवस्थितः ।\nअस्य लिंगादभूद्बीजमकारो बीजिनः प्रभोः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001097020, "chapter_id": 21097, "verse_number": "२-१-८-२१", "content_sanskrit": "उकारयोनौ निःक्षिप्तमवर्द्धत समंततः ।\nसौवर्णमभवच्चांडमावेद्य तदलक्षणम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001097021, "chapter_id": 21097, "verse_number": "२-१-८-२२", "content_sanskrit": "अनेकाब्दं तथा चाप्सु दिव्यमंडं व्यवस्थितम् ।\nततो वर्षसहस्रांते द्विधाकृतमजोद्भवम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001097022, "chapter_id": 21097, "verse_number": "२-१-८-२३", "content_sanskrit": "अंडमप्सु स्थितं साक्षाद्व्याघातेनेश्वरेण तु ।\nतथास्य सुशुभं हैमं कपालं चोर्द्ध्वसंस्थितम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001097023, "chapter_id": 21097, "verse_number": "२-१-८-२४", "content_sanskrit": "जज्ञे सा द्यौस्तदपरं पृथिवी पंचलक्षणा ।\nतस्मादंडाद्भवो जज्ञे ककाराख्यश्चतुर्मुखः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001097024, "chapter_id": 21097, "verse_number": "२-१-८-२५", "content_sanskrit": "स स्रष्टा सर्वलोकानां स एव त्रिविधः प्रभुः ।\nएवमोमोमिति प्रोक्तमित्याहुर्यजुषां वराः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001097025, "chapter_id": 21097, "verse_number": "२-१-८-२६", "content_sanskrit": "यजुषां वचनं श्रुत्वा ऋचः समानि सादरम् ।\nएवमेव हरे ब्रह्मन्नित्याहुश्चावयोस्तदा॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001097026, "chapter_id": 21097, "verse_number": "२-१-८-२७", "content_sanskrit": "ततो विज्ञाय देवेशं यथावच्छक्तिसंभवैः ।\nमंत्रं महेश्वरं देवं तुष्टाव सुमहोदयम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001097027, "chapter_id": 21097, "verse_number": "२-१-८-२८", "content_sanskrit": "एतस्मिन्नंतरेऽन्यच्च रूपमद्भुतसुन्दरम् ।\nददर्श च मया सार्द्धं भगवान्विश्वपालकः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001097028, "chapter_id": 21097, "verse_number": "२-१-८-२९", "content_sanskrit": "पंचवक्त्रं दशभुजं गौरकर्पूरवन्मुने ।\nनानाकांति समायुक्तं नानाभूषणभूषितम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001097029, "chapter_id": 21097, "verse_number": "२-१-८-३०", "content_sanskrit": "महोदारं महावीर्यं महापुरुषलणम् ।\nतं दृष्ट्वा परमं रूपं कृतार्थोऽभून्मया हरिः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001097030, "chapter_id": 21097, "verse_number": "२-१-८-३१", "content_sanskrit": "अथ प्रसन्नो भगवान्महेशः परमेश्वरः ।\nदिव्यं शब्दमयं रूपमाख्याय प्रहसन्स्थितः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001097031, "chapter_id": 21097, "verse_number": "२-१-८-३२", "content_sanskrit": "अकारस्तस्य मूर्द्धा हि ललाटो दीर्घ उच्यते ।\nइकारो दक्षिणं नेत्रमीकारो वामलोचनम्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001097032, "chapter_id": 21097, "verse_number": "२-१-८-३३", "content_sanskrit": "उकारो दक्षिणं श्रोत्रमूकारो वाम उच्यते ।\nऋकारो दक्षिणं तस्य कपोलं परमेष्ठिनः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001097033, "chapter_id": 21097, "verse_number": "२-१-८-३४", "content_sanskrit": "वामं कपोलमूकारो लृ लॄ नासापुटे उभे ।\nएकारश्चोष्ठ ऊर्द्ध्वश्च ह्यैकारस्त्वधरो विभोः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001097034, "chapter_id": 21097, "verse_number": "२-१-८-३५", "content_sanskrit": "ओकारश्च तथौकारो दन्तपंक्तिद्वयं क्रमात् ।\nअमस्तु तालुनी तस्य देवदेवस्य शूलिनः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001097035, "chapter_id": 21097, "verse_number": "२-१-८-३६", "content_sanskrit": "कादिपंचाक्षराण्यस्य पञ्च हस्ताश्च दक्षिणे ।\nचादिपंचाक्षराण्येवं पंच हस्तास्तु वामतः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001097036, "chapter_id": 21097, "verse_number": "२-१-८-३७", "content_sanskrit": "टादिपंचाक्षरं पादास्तादिपंचाक्षरं तथा ।\nपकार उदरं तस्य फकारः पार्श्व उच्यते॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001097037, "chapter_id": 21097, "verse_number": "२-१-८-३८", "content_sanskrit": "बकारो वामपार्श्वस्तु भकारः स्कंध उच्यते ।\nमकारो हृदयं शंभोर्महादेवस्य योगिनः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001097038, "chapter_id": 21097, "verse_number": "२-१-८-३९", "content_sanskrit": "यकारादिसकारान्ता विभोर्वै सप्तधातवः ।\nहकारो नाभिरूपो हि क्षकारो घ्राण उच्यते॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001097039, "chapter_id": 21097, "verse_number": "२-१-८-४०", "content_sanskrit": "एवं शब्दमयं रूपमगुणस्य गुणात्मनः ।\nदृष्ट्वा तमुमया सार्द्धं कृतार्थोऽभून्मया हरिः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001097040, "chapter_id": 21097, "verse_number": "२-१-८-४१", "content_sanskrit": "एवं दृष्ट्वा महेशानं शब्दब्रह्मतनुं शिवम् ।\nप्रणम्य च मया विष्णुः पुनश्चापश्यदूर्द्ध्वतः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001097041, "chapter_id": 21097, "verse_number": "२-१-८-४२", "content_sanskrit": "ओंकारप्रभवं मंत्रं कलापंचकसंयुतम् ।\nशुद्धस्फटिकसंकाशं शुभाष्टत्रिंशदक्षरम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001097042, "chapter_id": 21097, "verse_number": "२-१-८-४३", "content_sanskrit": "मेधाकारमभूद्भूयस्सर्वधर्मार्थसाधकम् ।\nगायत्रीप्रभवं मंत्रं सहितं वश्यकारकम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001097043, "chapter_id": 21097, "verse_number": "२-१-८-४४", "content_sanskrit": "चतुर्विंशतिवर्णाढ्यं चतुष्कालमनुत्तमम् ।\nअथ पंचसितं मंत्रं कलाष्टक समायुतम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001097044, "chapter_id": 21097, "verse_number": "२-१-८-४५", "content_sanskrit": "आभिचारिकमत्यर्थं प्रायस्त्रिंशच्छुभाक्षरम् ।\nयजुर्वेदसमायुक्तं पञ्चविंशच्छुभाक्षरम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001097045, "chapter_id": 21097, "verse_number": "२-१-८-४६", "content_sanskrit": "कलाष्टकसमा युक्तं सुश्वेतं शांतिकं तथा ।\nत्रयोदशकलायुक्तं बालाद्यैस्सह लोहितम्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001097046, "chapter_id": 21097, "verse_number": "२-१-८-४७", "content_sanskrit": "बभूवुरस्य चोत्पत्तिवृद्धिसंहारकारणम् ।\nवर्णा एकाधिकाः षष्टिरस्य मंत्रवरस्य तु॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001097047, "chapter_id": 21097, "verse_number": "२-१-८-४८", "content_sanskrit": "पुनर्मृत्युंजयं मन्त्रं पञ्चाक्षरमतः परम् ।\nचिंतामणिं तथा मंत्रं दक्षिणामूर्ति संज्ञकम्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001097048, "chapter_id": 21097, "verse_number": "२-१-८-४९", "content_sanskrit": "ततस्तत्त्वमसीत्युक्तं महावाक्यं हरस्य च ।\nपञ्चमंत्रांस्तथा लब्ध्वा जजाप भगवान्हरिः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001097049, "chapter_id": 21097, "verse_number": "२-१-८-५०", "content_sanskrit": "अथ दृष्ट्वा कलावर्णमृग्यजुस्सामरूपिणम् ।\nईशानमीशमुकुटं पुरुषाख्यं पुरातनम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001097050, "chapter_id": 21097, "verse_number": "२-१-८-५१", "content_sanskrit": "अघोरहृदयं हृद्यं सर्वगुह्यं सदाशिवम् ।\nवामपादं महादेवं महाभोगीन्द्रभूषणम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001097051, "chapter_id": 21097, "verse_number": "२-१-८-५२", "content_sanskrit": "विश्वतः पादवन्तं तं विश्वतोक्षिकरं शिवम् ।\nब्रह्मणोऽधिपति सर्गस्थितिसंहारकारणम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001097052, "chapter_id": 21097, "verse_number": "२-१-८-५३", "content_sanskrit": "तुष्टाव वाग्भिरिष्टाभिस्साम्बं वरदमीश्वरम् ।\nमया च सहितो विष्णुर्भगवांस्तुष्टचेतसा॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]