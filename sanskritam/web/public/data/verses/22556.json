[{"id": 7002556000, "chapter_id": 22556, "verse_number": "२-२-१", "content_sanskrit": "सूत उवाच ।\nइदानीं विस्तरं चैव विभागं रूपमैश्वरम् ।\nवक्ष्ये कल्पानुसारेण मन्वतरशतानुगम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002556001, "chapter_id": 22556, "verse_number": "२-२-२", "content_sanskrit": "आसीत्तमोमयं सर्वमप्रज्ञातमलक्षणम् ।\nतत्र चैको महानासीद्रुद्रः परमकारणम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002556002, "chapter_id": 22556, "verse_number": "२-२-३", "content_sanskrit": "आत्मना स्वयमात्मानं सञ्चित्य भगवान्विभुः ।\nमनः संसृजते पूर्वमहंकारं च पृष्ठतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002556003, "chapter_id": 22556, "verse_number": "२-२-४", "content_sanskrit": "अहंकारात्प्रजानाति महाभूतानि पञ्च च ।\nअष्टौ प्रकृतयः प्रोक्ता विकाराश्चैव षोडश ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002556004, "chapter_id": 22556, "verse_number": "२-२-५", "content_sanskrit": "शब्दः स्पर्शश्च रूपं च रसो गंधस्तथैव च ।\nप्राणोऽपानः समानश्चोदानव्यानौ तथैव च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002556005, "chapter_id": 22556, "verse_number": "२-२-६", "content_sanskrit": "सत्त्वं रजस्तमश्चैव गुणाः प्रोक्तास्तु ते त्रयः ।\nतस्माद्भागवतो ब्रह्मा तस्माद्विष्णुरजायत ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002556006, "chapter_id": 22556, "verse_number": "२-२-७", "content_sanskrit": "ब्रह्मविष्णुमोहनार्थं ततः शंभुस्तु तेजसा ।\nअशरीरो वासुदेवो ह्यनुत्पत्तिरयोनिजः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002556007, "chapter_id": 22556, "verse_number": "२-२-८", "content_sanskrit": "व्यामोहयित्वा तत्सर्वं तेजसाऽमोहयज्जगत् ।\nतस्मात्परतरं नास्ति तस्मात्परतरं न हि ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002556008, "chapter_id": 22556, "verse_number": "२-२-९", "content_sanskrit": "ब्रह्मा विष्णुश्च द्वावेतावुद्भूतौ भगवत्सुतौ ।\nकल्पेकल्पे तु तत्सर्वं सृजतेऽसौ जनं जगत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002556009, "chapter_id": 22556, "verse_number": "२-२-१०", "content_sanskrit": "उपसंहरते चैव नानाभूतानि सर्वशः ।\nद्वासप्ततियुगान्येव मन्वन्तर इति स्मृतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002556010, "chapter_id": 22556, "verse_number": "२-२-११", "content_sanskrit": "चतुर्दश तु तान्येवं कल्प इत्यभिधीयते ।\nदिनैकं ब्रह्मणः प्रोक्तं निशि कल्पस्तथोच्यते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002556011, "chapter_id": 22556, "verse_number": "२-२-१२", "content_sanskrit": "एवं मासश्च वर्षश्च तथा चाष्टशतं द्विजाः ।\nएवं बुद्धीन्द्रियस्यास्य विष्णोश्च निमिषः स्मृतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002556012, "chapter_id": 22556, "verse_number": "२-२-१३", "content_sanskrit": "ब्रह्मादिस्तंबपर्यंतं निमेषश्च ध्रुवस्य वै ।\nनिमेषजीवनं सर्वं सर्वलोकचराचरम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002556013, "chapter_id": 22556, "verse_number": "२-२-१४", "content_sanskrit": "भूर्लोकोऽथ भुवर्लोकः स्वर्लोकश्च प्रकीर्तितः ।\nजनस्तपश्च सत्यं च ब्रह्मलोकश्च सप्तमः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002556014, "chapter_id": 22556, "verse_number": "२-२-१५", "content_sanskrit": "पातालं वितलं तद्धि अतलं तलमेव च ।\nपञ्चमं विद्धि सुतलं सप्तमं च रसातलम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002556015, "chapter_id": 22556, "verse_number": "२-२-१६", "content_sanskrit": "एतेषु सप्तविख्याता अधःपातालवासिनः ।\nतेषामादौ च मध्ये च अंते रुद्रः प्रकीर्तितः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002556016, "chapter_id": 22556, "verse_number": "२-२-१७", "content_sanskrit": "ग्रसते जायते लोकान्क्रीडार्थं तु महेश्वरः ।\nब्रह्मलोकपरीप्सूनां गतिरूर्ध्वं प्रकीर्तिता ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002556017, "chapter_id": 22556, "verse_number": "२-२-१८", "content_sanskrit": "पृथिवीं चांतरिक्षं च दिशश्च विदिशस्तथा ।\nसमुद्राणां गिरीणां च अधस्तिर्यक्प्रसंख्यया ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002556018, "chapter_id": 22556, "verse_number": "२-२-१९", "content_sanskrit": "समुद्राणां च विस्तारं प्रमाणं च ततः शृणु ।\nस्थावराणां च शैलानां देवानां च दिवौकसाम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002556019, "chapter_id": 22556, "verse_number": "२-२-२०", "content_sanskrit": "चतुष्पदानां द्विपदां तथा धर्मैकभाषिणाम् ।\nसहस्रगुणमाख्यातं स्थावराणां प्रकीर्तितम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002556020, "chapter_id": 22556, "verse_number": "२-२-२१", "content_sanskrit": "सहस्रगुणशीलाश्च इत्याह भगवान्मुनिः ।\nऋषिस्तु प्रथमं कुर्वन्प्रकृतिं नाम नामतः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002556021, "chapter_id": 22556, "verse_number": "२-२-२२", "content_sanskrit": "तस्या ब्रह्मा प्रकृत्यास्तु उत्पन्नः सह विष्णुना ।\nतस्माद्बुद्ध्या प्रकुरुते सृष्टिं नैमित्तिकीं द्विजाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002556022, "chapter_id": 22556, "verse_number": "२-२-२३", "content_sanskrit": "तस्मात्स्वयंभुवो ब्रह्मा ब्राह्मणान्समकल्पयत् ।\nपादहीनान्क्षत्रियांश्च तस्माद्धीनांस्तु वैश्यकान् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002556023, "chapter_id": 22556, "verse_number": "२-२-२४", "content_sanskrit": "चतुर्थ पादहीनांश्च आचारेषु बहिष्कृतान् ।\nपृथिवीं चांतरिक्षं च दिशश्चैवाप्यकल्पयत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002556024, "chapter_id": 22556, "verse_number": "२-२-२५", "content_sanskrit": "लोकालोकस्य संस्था च द्वीपानामुदधेस्तथा ।\nसरितां सागराणां च तीर्थान्यायतनानि च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002556025, "chapter_id": 22556, "verse_number": "२-२-२६", "content_sanskrit": "मेघस्तनितनिर्घोषरोहितेंद्रधनूंषि च ।\nउल्कानिर्घातकेतूंश्च ज्योतींष्यायतनानि च ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002556026, "chapter_id": 22556, "verse_number": "२-२-२७", "content_sanskrit": "उत्पन्नं तस्य देहेषु भूयः कालेन पीडयेत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]