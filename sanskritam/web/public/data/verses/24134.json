[{"id": 7004134000, "chapter_id": 24134, "verse_number": "४-८३-१", "content_sanskrit": "राज्ञ्युवाच ।\nअवधेहि धरानाथ कथयामि यथातथम् ।\nव्रतस्यास्य विधानं च फलं चाभीष्टदेवताम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004134001, "chapter_id": 24134, "verse_number": "४-८३-२", "content_sanskrit": "पुरा पुरः श्रीदपत्न्याः श्रीमुख्या ब्रह्मसूनुना ।\nनारदेन सुतार्थिन्या व्रतमेतदुदीरितम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004134002, "chapter_id": 24134, "verse_number": "४-८३-३", "content_sanskrit": "चीर्णं चाथ तया देव्या पुत्रोभून्नलकूबरः ।\nअन्याभिरपि बह्वीभिः पुत्राः प्राप्ता व्रतादितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004134003, "chapter_id": 24134, "verse_number": "४-८३-४", "content_sanskrit": "विधिनाप्यत्र संपूज्या गौरी सर्वविधानवित् ।\nस्तनंधयेन सहिता धयता स्तनमुन्मुखम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004134004, "chapter_id": 24134, "verse_number": "४-८३-५", "content_sanskrit": "मार्गशीर्ष तृतीयायां शुक्लायां कलशोपरि ।\nताम्रपात्रं निधायैकं तंडुलैः परिपूरितम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004134005, "chapter_id": 24134, "verse_number": "४-८३-६", "content_sanskrit": "अविच्छिन्नं नवीनं च रजनीरागरंजितम् ।\nवासः पात्रोपरि न्यस्य सूक्ष्मात्सूक्ष्मतरं परम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004134006, "chapter_id": 24134, "verse_number": "४-८३-७", "content_sanskrit": "तस्योपरि शुभं पद्मं रविरश्मिविकासितम् ।\nतत्कर्णिकाया उपरि चतुःस्वर्णविनिर्मितम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004134007, "chapter_id": 24134, "verse_number": "४-८३-८", "content_sanskrit": "विधिं संपूजयेद्भक्त्या रत्नपट्टाबंरादिभिः ।\nपुष्पैर्नानाविधै रम्यैः फलैर्नारंगमुख्यकैः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004134008, "chapter_id": 24134, "verse_number": "४-८३-९", "content_sanskrit": "सुगंधैश्चंदनाद्यैश्च कर्पूर मृगनाभिभिः ।\nपरमान्नादि नैवेद्यैः पक्वान्नैर्बहुभंगिभिः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004134009, "chapter_id": 24134, "verse_number": "४-८३-१०", "content_sanskrit": "धूपैरगुरुमुख्यैश्च रम्ये कुसुममंडपे ।\nरात्रौ जागरणं कार्यं विनिंद्रैः परमोत्सवैः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004134010, "chapter_id": 24134, "verse_number": "४-८३-११", "content_sanskrit": "हस्तमात्रमिते कुंडे जातवेदस इत्यृचा ।\nघृतेन मधुनाप्लुत्य जुहुयान्मंत्रविद्द्विजः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004134011, "chapter_id": 24134, "verse_number": "४-८३-१२", "content_sanskrit": "सहस्रकमलानां च स्मेराणां स्वयमेव हि ।\nनवप्रसूतां कपिलां सुशीलां च पयस्विनीम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004134012, "chapter_id": 24134, "verse_number": "४-८३-१३", "content_sanskrit": "दद्यादाचार्यवर्याय सालंकारां सलक्षणाम् ।\nउपोष्य दंपती भक्त्या नवांबरविभूषितौ ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004134013, "chapter_id": 24134, "verse_number": "४-८३-१४", "content_sanskrit": "प्रातःस्नात्वा चतुर्थ्यां च संपूज्याचार्यमादृतः ।\nवस्त्रैराभरणैर्माल्यैर्दक्षिणाभिर्मुदान्वितौ ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004134014, "chapter_id": 24134, "verse_number": "४-८३-१५", "content_sanskrit": "सोपस्करां च तां मृर्तिमाचार्याय निवेदयेत् ।\nसमुच्चरन्निमं मंत्रं व्रतकृन्मिथुनं मुदा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004134015, "chapter_id": 24134, "verse_number": "४-८३-१६", "content_sanskrit": "नमो विश्वविधानज्ञे विधे विविधकारिणि ।\nसुतं वंशकरं देहि तुष्टामुष्माद्व्रताच्छुभात् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004134016, "chapter_id": 24134, "verse_number": "४-८३-१७", "content_sanskrit": "सहसं भोजयित्वाथ द्विजानां भक्तिपूर्वकम् ।\nभुक्तशेषेण चान्नेन कुर्याद्वै पारणं ततः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004134017, "chapter_id": 24134, "verse_number": "४-८३-१८", "content_sanskrit": "इत्थमेतद्व्रतं राजंश्चिकीर्षामि त्वया सह ।\nकुरु चैतत्प्रियं मह्यमभीष्टफललब्धये ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004134018, "chapter_id": 24134, "verse_number": "४-८३-१९", "content_sanskrit": "इति भूपालवर्येण श्रुत्वा संहृष्टचेतसा ।\nमुनेव तं समाचीर्णं सांतर्वत्नी बभूव ह ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004134019, "chapter_id": 24134, "verse_number": "४-८३-२०", "content_sanskrit": "तयाथ प्रार्थिता गौरी गर्भिण्या भक्तितोषिता ।\nपुत्रं देहि महामाये साक्षाद्विष्ण्वंशसंभवम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004134020, "chapter_id": 24134, "verse_number": "४-८३-२१", "content_sanskrit": "जातमात्रो व्रजेत्स्वर्गं पुनगयाति चात्र वै ।\nभक्तः सदाशिवेऽत्यर्थं प्रसिद्धः सर्वभूतले ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004134021, "chapter_id": 24134, "verse_number": "४-८३-२२", "content_sanskrit": "विनैव स्तन्यपानेन षोडशाब्दाकृतिः क्षणात् ।\nएवंभूतः सुतो गौरि यथा मे स्यात्तथाकुरु ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004134022, "chapter_id": 24134, "verse_number": "४-८३-२३", "content_sanskrit": "मृडान्यापि तथेत्युक्ता राज्ञी भक्त्यातितुष्टया ।\nअथ कालेन तनयं मूलर्क्षे साप्यजीजनत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004134023, "chapter_id": 24134, "verse_number": "४-८३-२४", "content_sanskrit": "हितैरमात्यैरथ सा विज्ञप्तारिष्टसंस्थिता ।\nदेवि राजार्थिनी चेत्त्वं त्यज दुष्टर्क्षजं सुतम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004134024, "chapter_id": 24134, "verse_number": "४-८३-२५", "content_sanskrit": "सा मंत्रिवाक्यमाकर्ण्य केवलं पतिदेवता ।\nअत्याक्षीत्तं तथा प्राप्तं तनयं नयकोविदा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004134025, "chapter_id": 24134, "verse_number": "४-८३-२६", "content_sanskrit": "धात्रेयिकां समाकार्य प्राहेदं सा नृपांगना ।\nपंचमुद्रे महापीठे विकटा नाम मातृका ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004134026, "chapter_id": 24134, "verse_number": "४-८३-२७", "content_sanskrit": "तदग्रे स्थापयित्वामुं बालं धात्रेयिके वद ।\nगौर्यादत्तः शिशुरसौ तवाग्रे विनिवेदितः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004134027, "chapter_id": 24134, "verse_number": "४-८३-२८", "content_sanskrit": "राज्ञ्या पत्युः प्रियेषिण्या मंत्रिविज्ञप्तिनुन्नया ।\nसापि राज्ञ्युदितं श्रुत्वा शिशुं लास्य शशिप्रभम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004134028, "chapter_id": 24134, "verse_number": "४-८३-२९", "content_sanskrit": "विकटायाः पुरः स्थाप्य गृहं धात्रेयिका गता ।\nअथ सा विकटा देवी समाहूय च योगिनीः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004134029, "chapter_id": 24134, "verse_number": "४-८३-३०", "content_sanskrit": "उवाच नयत क्षिप्रं शिशुं मातृगणाग्रतः ।\nतासामाज्ञां च कुरुत रक्षतामुं प्रयत्नतः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004134030, "chapter_id": 24134, "verse_number": "४-८३-३१", "content_sanskrit": "योगिन्यो विकटावाक्यात्खेचर्यस्ताः क्षणेन तम् ।\nनिन्युर्गगनमार्गेण ब्राह्म्याद्या यत्र मातरः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004134031, "chapter_id": 24134, "verse_number": "४-८३-३२", "content_sanskrit": "प्रणम्य योगिनीवृंदं तं शिशुं सूर्यवर्चसम् ।\nपुरो निधाय मातॄणां प्रोवाच विकटोदितम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004134032, "chapter_id": 24134, "verse_number": "४-८३-३३", "content_sanskrit": "ब्रह्माणी वैष्णवी रौद्री वाराही नारसिंहिका ।\nकौमारी चापि माहेंद्री चामुंडा चैव चंडिका ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004134033, "chapter_id": 24134, "verse_number": "४-८३-३४", "content_sanskrit": "दृष्ट्वा तं बालकं रम्यं विकटाप्रेषितं ततः ।\nपप्रच्छुर्युगपड्डिंभं कस्ते तातः प्रसूश्च कः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004134034, "chapter_id": 24134, "verse_number": "४-८३-३५", "content_sanskrit": "मातृभिश्चेति पुष्टः स यदा किंचिन्न वक्ति च ।\nतदा तद्योगिनीचक्रं प्राह मातृगणस्त्विति ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004134035, "chapter_id": 24134, "verse_number": "४-८३-३६", "content_sanskrit": "राज्ययोग्यो भवत्येष महालक्षणलक्षितः ।\nपुनस्तत्रैव नेतव्यो योगिन्यस्त्वविलंबितम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004134036, "chapter_id": 24134, "verse_number": "४-८३-३७", "content_sanskrit": "पंचमुद्रा महादेवी तिष्ठते यत्र काम्यदा ।\nयस्याः संसेवनान्नृणां निर्वाणश्रीरदूरतः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004134037, "chapter_id": 24134, "verse_number": "४-८३-३८", "content_sanskrit": "सर्वत्रशुभजन्मिन्यां काश्यां मुक्तिः पदेपदे ।\nतथापि सविशेषं हि तत्पीठं सर्वसिद्धिकृत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004134038, "chapter_id": 24134, "verse_number": "४-८३-३९", "content_sanskrit": "तत्पीठसेवनादस्य षोडशाब्दाकृतेः शिशोः ।\nसिद्धिर्भवित्री परमा विश्वेशानुग्रहात्परात् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004134039, "chapter_id": 24134, "verse_number": "४-८३-४०", "content_sanskrit": "एवं मातृगणाशीर्भिर्योगिनीभिः क्षणेन हि ।\nप्रापितो मातृवाक्येन पंचमुद्रांकितं पुनः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004134040, "chapter_id": 24134, "verse_number": "४-८३-४१", "content_sanskrit": "संप्राप्य तन्महापीठं स्वर्गलोकादिहागतः ।\nआनंदकानने दिव्यं तताप विपुलं तपः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004134041, "chapter_id": 24134, "verse_number": "४-८३-४२", "content_sanskrit": "तपसातीव तीव्रेण निश्चलेंद्रियचेतसः ।\nतस्य राजकुमारस्य प्रसन्नोभूदुमाधवः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004134042, "chapter_id": 24134, "verse_number": "४-८३-४३", "content_sanskrit": "आविर्बभूव पुरतो लिंगरूपेण शंकरः ।\nप्रोवाच च प्रसन्नोस्मि वरं ब्रूहि नृपांगज ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004134043, "chapter_id": 24134, "verse_number": "४-८३-४४", "content_sanskrit": "स्कंद उवाच ।\nसर्वज्योतिर्मयं लिंगं पुरतो वीक्ष्य वाङ्मयम् ।\nसप्तपातालमुद्भिद्य स्थितं बृहदनुग्रहात ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004134044, "chapter_id": 24134, "verse_number": "४-८३-४५", "content_sanskrit": "प्रणम्य दंडवद्भूमौ परितुष्टाव धूर्जटिम् ।\nसूक्तैर्जन्मांतराभ्यस्तैः सुहृष्टो रुद्रदेवतैः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004134045, "chapter_id": 24134, "verse_number": "४-८३-४६", "content_sanskrit": "ततः प्रसन्नो भगवान्देवदेवो महेश्वरः ।\nसंतुष्टस्तपसा तस्य प्रोवाच वृषभध्वजः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004134046, "chapter_id": 24134, "verse_number": "४-८३-४७", "content_sanskrit": "देवदेव उवाच ।\nवरं वरय संतप्त तपसा क्लेशितं वपुः ।\nत्वयेदं बालवपुषा वशीकृतं मनो मम ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004134047, "chapter_id": 24134, "verse_number": "४-८३-४८", "content_sanskrit": "शिवोक्तं च समाकर्ण्य वरदानं पुनःपुनः ।\nवरं च प्रार्थयांचक्रे परिहृष्टतनूरुहः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004134048, "chapter_id": 24134, "verse_number": "४-८३-४९", "content_sanskrit": "कुमार उवाच ।\nदेवदेवमहादेव यदि देयो वरो मम ।\nतदत्र भवता स्थेयं भवतापहृता सदा ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004134049, "chapter_id": 24134, "verse_number": "४-८३-५०", "content_sanskrit": "अस्मिंल्लिंगे स्थितः शंभो कुरु भक्तसमीहितम् ।\nविना मुद्रादिकरणं मंत्रेणापि विना विभो ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004134050, "chapter_id": 24134, "verse_number": "४-८३-५१", "content_sanskrit": "दिश सिद्धिं परामत्र दर्शनात्स्पर्शनान्नतेः ।\nअस्य लिंगस्य ये भक्ता मनोवाक्कायकर्मभिः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004134051, "chapter_id": 24134, "verse_number": "४-८३-५२", "content_sanskrit": "सदैवानुग्रहस्तेषु कर्तव्यो वर एष मे ।\nइति तद्व्रतमाकर्ण्य लिंगरूपोवदत्प्रभुः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004134052, "chapter_id": 24134, "verse_number": "४-८३-५३", "content_sanskrit": "एवमस्तु यदुक्तं ते वीरवैष्णव सूनुना ।\nजनेतुर्विष्णुभक्ताच्च राज्ञोऽमित्रज्जितो भवान् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004134053, "chapter_id": 24134, "verse_number": "४-८३-५४", "content_sanskrit": "विष्ण्वंश एवमुत्पन्नो मम भक्तिपरांगज ।\nवीरवीरेश्वरं नाम लिंगमेतत्त्वदाख्यया ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004134054, "chapter_id": 24134, "verse_number": "४-८३-५५", "content_sanskrit": "काश्यां दास्यत्यभीष्टानि भक्तानां चिंतितान्यहो ।\nअस्मिंल्लिंगे सदा वीर स्थास्याम्यद्यदिनावधि ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004134055, "chapter_id": 24134, "verse_number": "४-८३-५६", "content_sanskrit": "दास्यामि च परां सिद्धिमाश्रितेभ्यो न संशयः ।\nपरं न महिमानं मे कलौ कश्चिच्च वेत्स्यति ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004134056, "chapter_id": 24134, "verse_number": "४-८३-५७", "content_sanskrit": "यस्तु वेत्स्यति भाग्येन स परां सिद्धिमाप्स्यति ।\nअत्र जप्तं हुतं दत्तं स्तुतमर्चितमेव वा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004134057, "chapter_id": 24134, "verse_number": "४-८३-५८", "content_sanskrit": "जीर्णोद्धारादिकरणमक्षय्यफलहेतुकम् ।\nत्वं तु राज्यं परं प्राप्य सर्वभूपालदुर्लभम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004134058, "chapter_id": 24134, "verse_number": "४-८३-५९", "content_sanskrit": "भुक्त्वा भोगांश्च विपुलानंते सिद्धिमवाप्स्यसि ।\nपुरी वाराणसी रम्या सर्वस्मिञ्जगतीतले ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004134059, "chapter_id": 24134, "verse_number": "४-८३-६०", "content_sanskrit": "पुण्यस्तत्रापि संभेदः सरितोरसि गंगयोः ।\nततोऽपि च हयग्रीवं तीर्थं चैवाति पुण्यदम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004134060, "chapter_id": 24134, "verse_number": "४-८३-६१", "content_sanskrit": "यत्र विष्णुर्हयग्रीवो भक्तचिंतितमर्पयेत् ।\nहयग्रीवाच्च वै तीर्थाद्गजतीर्थं विशिष्यते ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004134061, "chapter_id": 24134, "verse_number": "४-८३-६२", "content_sanskrit": "यत्र वै स्नानमात्रेण गजदानफलं लभेत् ।\nकोकावराहतीर्थं च पुण्यदं गजतीर्थतः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004134062, "chapter_id": 24134, "verse_number": "४-८३-६३", "content_sanskrit": "कोकावराहमभ्यर्च्य तत्र नो जन्मभाग्जनः ।\nअपि कोकावराहाच्च दिलीपेश्वरसन्निधौ ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004134063, "chapter_id": 24134, "verse_number": "४-८३-६४", "content_sanskrit": "दिलीपतीर्थं सुश्रेष्ठं सद्यः पापहरं परम् ।\nततः सगरतीर्थं च सगरेश समीपतः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004134064, "chapter_id": 24134, "verse_number": "४-८३-६५", "content_sanskrit": "यत्र मज्जन्नरो मज्जेन्न भूयो दुःखसागरे ।\nसप्तसागरतीर्थं च शुभं सगरतीर्थतः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004134065, "chapter_id": 24134, "verse_number": "४-८३-६६", "content_sanskrit": "सप्ताब्धिस्नानजं पुण्यं यत्र स्नात्वा नरो लभेत् ।\nमहोदधीति विख्यातं तीर्थं सप्ताब्धितीर्थतः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004134066, "chapter_id": 24134, "verse_number": "४-८३-६७", "content_sanskrit": "सकृद्यत्राप्लुतो धीमान्दहेदघमहोदधिम् ।\nचौरतीर्थं ततः पुण्यं कपिलेश्वर सन्निधौ ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004134067, "chapter_id": 24134, "verse_number": "४-८३-६८", "content_sanskrit": "पापं सुवर्णचौर्यादि यत्र स्नात्वा क्षयं व्रजेत् ।\nहंसतीर्थ ततोपीड्यं केदारेश्वर सन्निधौ ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004134068, "chapter_id": 24134, "verse_number": "४-८३-६९", "content_sanskrit": "हंस स्वरूपी यत्राहं नयामि ब्रह्मदेहिनः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004134069, "chapter_id": 24134, "verse_number": "४-८३-७०", "content_sanskrit": "ततस्त्रिभुवनाख्यस्य केशवस्याति पुण्यदम् ।\nतीर्थं यत्राप्लुता मर्त्या मर्त्यलोकं विशंति न ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004134070, "chapter_id": 24134, "verse_number": "४-८३-७१", "content_sanskrit": "गोव्याघ्रे श्वर तीर्थं च ततोप्यधिकमेव हि ।\nस्वभाववैरमुत्सृज्य यत्रोभौ सिद्धिमापतुः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004134071, "chapter_id": 24134, "verse_number": "४-८३-७२", "content_sanskrit": "ततोपि हि वरं वीर तीर्थं मांधातुसंज्ञितम् ।\nचक्रवर्तिपदं यत्र प्राप्तं तेन महीभुजा ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004134072, "chapter_id": 24134, "verse_number": "४-८३-७३", "content_sanskrit": "ततोपि मुचुकुंदाख्यं तीर्थं चातीव पुण्यदम् ।\nयत्र स्नातो नरो जातु रिपुभिर्नाभिभूयते ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004134073, "chapter_id": 24134, "verse_number": "४-८३-७४", "content_sanskrit": "पृथु तीर्थं ततोप्युच्चैः श्रेयसां साधनं परम् ।\nपृथ्वीश्वरं यत्र दृष्ट्वा नरः पृथ्वीपतिर्भवेत् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004134074, "chapter_id": 24134, "verse_number": "४-८३-७५", "content_sanskrit": "ततः परशुरामस्य तीर्थं चातीव सिद्धिदम् ।\nयत्र क्षत्रवधात्पापाज्जामदग्न्यो विमुक्तवान् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004134075, "chapter_id": 24134, "verse_number": "४-८३-७६", "content_sanskrit": "अद्यापि क्षत्रवधजं पापं तत्र प्रणश्यति ।\nएकेन स्नानमात्रेण ज्ञानाज्ञानकृतेन च ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004134076, "chapter_id": 24134, "verse_number": "४-८३-७७", "content_sanskrit": "ततोपि श्रेयसां कर्तृ तीर्थं कृष्णाग्रजस्य हि ।\nयत्र सूतवधात्पापाद्बलदेवो विमुक्तवान् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004134077, "chapter_id": 24134, "verse_number": "४-८३-७८", "content_sanskrit": "दिवोदासस्य वै तीर्थं तत्र राज्ञोऽतिमेधसः ।\nतत्र स्नातो नरो जातु न ज्ञानाच्च्यवतेंऽततः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004134078, "chapter_id": 24134, "verse_number": "४-८३-७९", "content_sanskrit": "ततोपि हि महातीर्थं सर्वपापप्रणाशनम् ।\nयत्र भागीरथी साक्षान्मूर्तिरूपेण तिष्ठति ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004134079, "chapter_id": 24134, "verse_number": "४-८३-८०", "content_sanskrit": "स्नात्वा भागीरथी तीर्थे कृत्वा श्राद्धं विधानवित् ।\nदत्त्वा दानं च पात्रेभ्यो न भूयो गर्भभाग्भवेत् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004134080, "chapter_id": 24134, "verse_number": "४-८३-८१", "content_sanskrit": "हरपापं च भो वीर तीर्थं भागीरथीतटे ।\nतत्र स्नात्वा क्षयं यांति महापापकुलान्यपि ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004134081, "chapter_id": 24134, "verse_number": "४-८३-८२", "content_sanskrit": "यो निष्पापेश्वरं लिंगं तत्र पश्यति मानवः ।\nनिष्पापो जायते वीर स तल्लिंगेक्षणात्क्षणात् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004134082, "chapter_id": 24134, "verse_number": "४-८३-८३", "content_sanskrit": "दशाश्वमेधतीर्थं च ततोपि प्रवरं मतम् ।\nदशानामश्वमेधानां यत्र स्नात्वा फलं लभेत् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004134083, "chapter_id": 24134, "verse_number": "४-८३-८४", "content_sanskrit": "ततोपि शुभदं वीर बंदीतीर्थं प्रचक्षते ।\nयत्र स्नातो नरो मुच्येदपि संसारबंधनात् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004134084, "chapter_id": 24134, "verse_number": "४-८३-८५", "content_sanskrit": "हिरण्याक्षेण दैत्येन बहुशो देवताः पुरा ।\nबंदीकृता निगडिता स्तुष्टुवुर्जगदंबिकाम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004134085, "chapter_id": 24134, "verse_number": "४-८३-८६", "content_sanskrit": "ततो विशृंखलीभूतैर्वंदिता यज्जगज्जनिः ।\nतदा प्रभृति बंदीति गीयतेद्यापि मानवैः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004134086, "chapter_id": 24134, "verse_number": "४-८३-८७", "content_sanskrit": "बंदीतीर्थस्तु तत्रैव महानिगडखंडनम् ।\nतत्र स्नातो विमुच्येत सर्वस्मात्कर्मपाशतः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004134087, "chapter_id": 24134, "verse_number": "४-८३-८८", "content_sanskrit": "बंदीतीर्थं महाश्रेष्ठं काशिपुर्यां विशांपते ।\nतत्र स्नातो नरो यायाद्विमुक्तिं देव्यनुग्रहात् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004134088, "chapter_id": 24134, "verse_number": "४-८३-८९", "content_sanskrit": "ततोपि हि श्रेष्ठतरं प्रयागमिति विश्रुतम् ।\nप्रयागमाधवो यत्र सर्वयागफलप्रदः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004134089, "chapter_id": 24134, "verse_number": "४-८३-९०", "content_sanskrit": "क्षोणीवराहतीर्थं च ततोपि शुभदं परम् ।\nतत्र स्नातो नरो जातु तिर्यग्योनिं न गच्छति ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004134090, "chapter_id": 24134, "verse_number": "४-८३-९१", "content_sanskrit": "ततः कालेश्वरं तीर्थं वीरश्रेष्ठतरं परम् ।\nकलिकालौ न बाधेते यत्र स्नातं नरोत्तमम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004134091, "chapter_id": 24134, "verse_number": "४-८३-९२", "content_sanskrit": "अशोकतीर्थं तत्रैव ततोप्यतितरां शुभम् ।\nयत्र स्नातो नरो जातु नापतेच्छोकसागरे ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004134092, "chapter_id": 24134, "verse_number": "४-८३-९३", "content_sanskrit": "ततोति निर्मलतरं शक्रतीर्थं नृपांगज ।\nशुक्रद्वारा न जायेत यत्र स्नातो नरोत्तमः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004134093, "chapter_id": 24134, "verse_number": "४-८३-९४", "content_sanskrit": "ततोऽपि पुण्यदं राजन्भवानीतीर्थमुत्तमम् ।\nयत्र स्नात्वा भवानीशौ दृष्ट्वा नैव पुनर्भवेत् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004134094, "chapter_id": 24134, "verse_number": "४-८३-९५", "content_sanskrit": "प्रभासतीर्थं विख्यातं ततोपि शुभदं नृणाम् ।\nसोमेश्वरस्य पुरतस्तत्र स्नातो न गर्भभाक् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004134095, "chapter_id": 24134, "verse_number": "४-८३-९६", "content_sanskrit": "ततो गरुडतीर्थं च संसारविषनाशनम् ।\nगरुडेशं समभ्यर्च्य तत्र स्नात्वा न शोचति ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004134096, "chapter_id": 24134, "verse_number": "४-८३-९७", "content_sanskrit": "ब्रह्मतीर्थं ततः पुण्यं वीरब्रह्मेश्वरात्पुरः ।\nब्रह्मविद्यामवाप्नोति तत्र स्नानेन मानवः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004134097, "chapter_id": 24134, "verse_number": "४-८३-९८", "content_sanskrit": "ततो वृद्धार्कतीर्थं च विधितीर्थं ततः परम् ।\nतत्राप्लुतो नरो याति रविलोकं सुनिर्मलम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004134098, "chapter_id": 24134, "verse_number": "४-८३-९९", "content_sanskrit": "ततो नृसिंहतीर्थं च महाभयनिवारणम् ।\nकालादपि कुतस्तत्र स्नात्वा परिबिभेति च ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004134099, "chapter_id": 24134, "verse_number": "४-८३-१००", "content_sanskrit": "ततोपि पुण्यदं नृणां तीर्थं चित्ररथेश्वरम् ।\nयत्र स्नात्वा च दत्त्वा च चित्रगुप्तं न पश्यति ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004134100, "chapter_id": 24134, "verse_number": "४-८३-१०१", "content_sanskrit": "धर्मतीर्थं ततः पुण्यं धर्मेश पुरतः स्थितम् ।\nतत्र श्राद्धदिकं कृत्वा पितॄणामनृणो भवेत् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004134101, "chapter_id": 24134, "verse_number": "४-८३-१०२", "content_sanskrit": "विशालतीर्थं विमलं विशालफलदं ततः ।\nतत्र स्नात्वा विशालाक्षी दृष्ट्वा गर्भेन जायते ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004134102, "chapter_id": 24134, "verse_number": "४-८३-१०३", "content_sanskrit": "जरासंधेश तीर्थं च जरासंधेशसन्निधौ ।\nसंसारज्वरपीडाभिस्तत्र स्नातो न मुह्यति ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004134103, "chapter_id": 24134, "verse_number": "४-८३-१०४", "content_sanskrit": "ततोऽपि ललितातीर्थं महासौभाग्यवर्धनम् ।\nस्नात्वार्चयित्वा ललितां न दरिद्रो न दुःखभाक् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004134104, "chapter_id": 24134, "verse_number": "४-८३-१०५", "content_sanskrit": "ततो गौतमतीर्थं च सर्वपापविशोधनम् ।\nस्नात्वा पिंडान्विनिर्वाप्य यत्र शोचति न क्वचित् ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004134105, "chapter_id": 24134, "verse_number": "४-८३-१०६", "content_sanskrit": "गंगाकेशवतीर्थं च तीर्थं चागस्त्य संज्ञकम् ।\nततस्तु योगिनीतीर्थं त्रिसंध्याख्यं ततः परम् ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004134106, "chapter_id": 24134, "verse_number": "४-८३-१०७", "content_sanskrit": "ततस्तु नार्मदं तीर्थं तत आरुंधतेयकम् ।\nवासिष्ठं च ततस्तीर्थं मार्कंण्डेयमनुत्तमम् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004134107, "chapter_id": 24134, "verse_number": "४-८३-१०८", "content_sanskrit": "ज्ञेयान्येतानि तीर्थानि पुण्यदान्युत्तरोत्तरम ।\nखुरकर्तरि संज्ञं च ततस्तीर्थमनुत्तमम् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004134108, "chapter_id": 24134, "verse_number": "४-८३-१०९", "content_sanskrit": "तत्र श्राद्धादिकरणान्नरोमुच्येत किल्बिषैः ।\nततो भगीरथं तीर्थं राजर्षेरतिपुण्यदम् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7004134109, "chapter_id": 24134, "verse_number": "४-८३-११०", "content_sanskrit": "तत्राल्पमपि यच्छेद्यत्कल्पांतेप्यक्षयं हि तत् ।\nएतेभ्योपि हि तीर्थेभ्यो लिंगकोटित्रयादपि ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7004134110, "chapter_id": 24134, "verse_number": "४-८३-१११", "content_sanskrit": "वीरवीरेश्वरं लिंगं महाश्रेष्ठं भविष्यति ।\nवीरतीर्थे नरः स्नात्वा वीरेशं परिपूज्य च ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7004134111, "chapter_id": 24134, "verse_number": "४-८३-११२", "content_sanskrit": "तीर्थेष्वेतेषु सर्वेषु स्नातो भवति नान्यथा ।\nयस्तु वीरेश्वरं लिंगं नक्तमभ्यर्चयिप्यति ।\nतेन त्रिकोटिसंख्यानि लिंगानीहार्चितानि वै ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7004134112, "chapter_id": 24134, "verse_number": "४-८३-११३", "content_sanskrit": "यस्तु कामयते लक्ष्मीं मुक्तिदां भुक्तिदामपि ।\nतेन वीरेश्वरं लिंगं संसेव्यमतियत्नतः ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7004134113, "chapter_id": 24134, "verse_number": "४-८३-११४", "content_sanskrit": "विधायैकं जागरणं नरो वीरेशमर्चयन् ।\nभूतायां नैव गृह्णाति शरीरं पांचभौतिकम् ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7004134114, "chapter_id": 24134, "verse_number": "४-८३-११५", "content_sanskrit": "इदं लिंगं सदाभ्यर्च्यं सिद्धैः संसिद्धिकामुकैः ।\nऐहिकामुष्मिकान्यस्मात्सर्वान्कामान्समर्थयेत् ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7004134115, "chapter_id": 24134, "verse_number": "४-८३-११६", "content_sanskrit": "पंचामृतेन स्नपनं यः करिष्यति मानवः ।\nपलेपले फलं तस्य वीरेशे घटकोटिजम् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7004134116, "chapter_id": 24134, "verse_number": "४-८३-११७", "content_sanskrit": "यदन्यत्र फलं लिंगे कोटिपुष्प प्रदानतः ।\nतदेकेनैव पुष्पेण वीरेशे नात्र संशयः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7004134117, "chapter_id": 24134, "verse_number": "४-८३-११८", "content_sanskrit": "एकामप्याहुतिं दत्त्वा वीरेश्वरसमीपतः ।\nकोटिहोमफलं सम्यङ्नात्र कार्या विचारणा ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7004134118, "chapter_id": 24134, "verse_number": "४-८३-११९", "content_sanskrit": "सिक्थेसिक्थे च नैवैद्यै कोटिसिक्थफलं भवेत् ।\nअत्यल्पमपि वीरेशे कृतमक्षयतां व्रजेत् ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7004134119, "chapter_id": 24134, "verse_number": "४-८३-१२०", "content_sanskrit": "अप्येकं यो महारुद्रं जपेद्वीरेश सन्निधौ ।\nजापयेद्वा भवेत्तस्य कोटिरुद्रफलं ध्रुवम् ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7004134120, "chapter_id": 24134, "verse_number": "४-८३-१२१", "content_sanskrit": "व्रतोत्सर्गादि वीरेशे यत्कृतं व्रतिभिर्नृभिः ।\nतत्कोटिगुणसंख्याकं भवत्येव न संशयः ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7004134121, "chapter_id": 24134, "verse_number": "४-८३-१२२", "content_sanskrit": "कृता अष्टौ नमस्कारा येन वीरेश्वराग्रतः ।\nअष्टकोटि नमस्कारफलं तस्य न संशयः ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7004134122, "chapter_id": 24134, "verse_number": "४-८३-१२३", "content_sanskrit": "सर्वासां संपदां स्थानमिदं लिंगं भविष्यति ।\nवीरश्वेरं न संदेहो वीर मे वरदानतः ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7004134123, "chapter_id": 24134, "verse_number": "४-८३-१२४", "content_sanskrit": "ज्ञानमुत्पत्स्यते पुंसां तारकाख्यं ममाज्ञया ।\nजीवतामेव तत्सेव्यमेतल्लिंगं शुभार्थिभिः ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7004134124, "chapter_id": 24134, "verse_number": "४-८३-१२५", "content_sanskrit": "एतच्छ्रुत्वा पुनः प्राह वीरो मित्रजितः सुतः ।\nप्रणम्य देवदेवेशं परिपूर्णमनोरथः ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7004134125, "chapter_id": 24134, "verse_number": "४-८३-१२६", "content_sanskrit": "तीर्थान्येतानि देवेश यान्युक्तानि ममाग्रतः ।\nकृपया पुनरप्येव तदन्यानि वद प्रभो ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7004134126, "chapter_id": 24134, "verse_number": "४-८३-१२७", "content_sanskrit": "आदिकेशवमारभ्य तत्तीर्थाच्च भगीरथात् ।\nयेषां श्रवणमात्रेण निष्पापो जायते नरः ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7004134127, "chapter_id": 24134, "verse_number": "४-८३-१२८", "content_sanskrit": "इति श्रुत्वा महेशानो महीप तनयोदितम् ।\nपुनस्तीर्थानि गंगायां वक्तुं समुपचक्रमे ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7004134128, "chapter_id": 24134, "verse_number": "४-८३-१२९", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां चतुर्थे काशीखंडे उत्तरार्धे वीरेश्वराविर्भावोनाम त्र्यशीतितमोऽध्यायः ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}]