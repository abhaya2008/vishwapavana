[{"id": 2059096, "chapter_id": 2273, "verse_number": "७-२००-०x", "content_sanskrit": "सञ्जय उवच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2059097, "chapter_id": 2273, "verse_number": "७-२००-१", "content_sanskrit": "ततः स कदनं चक्रे रिपूणां द्रोणनन्दनः।\nयुगान्ते सर्वभूतानां कालसृष्ट इवान्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2059098, "chapter_id": 2273, "verse_number": "७-२००-२", "content_sanskrit": "ध्वजद्रुमं शस्त्रशृङ्गं हतनागमहाशिलम्।\nअश्वकिम्पुरुषाकीर्णं शरासनलतावृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2059099, "chapter_id": 2273, "verse_number": "७-२००-३", "content_sanskrit": "क्रव्यादपक्षिसङ्घुष्टं भूतयक्षणाकुलम्।\nनिहत्य शात्रवान्भल्लैः सोऽचिनोद्देहपर्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2059100, "chapter_id": 2273, "verse_number": "७-२००-४", "content_sanskrit": "ततो वेगेन महता विनद्य स नरर्षभः।\nप्रतिज्ञां श्रावयामास पुनरेव तवात्मजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2059101, "chapter_id": 2273, "verse_number": "७-२००-५", "content_sanskrit": "यदत्र च्छद्मनाऽऽचार्यं धर्मकञ्चुकमास्थितः।\nमुञ्च शस्त्रमिति प्राह कुन्तीपुत्रो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2059102, "chapter_id": 2273, "verse_number": "७-२००-६", "content_sanskrit": "तस्मात्सम्पश्यतस्तस्य द्रावयिष्यानि वाहिनीम्।\nविद्राव्यसर्वान्हन्ताऽस्मि जाल्मं पाञ्चाल्यमेव तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2059103, "chapter_id": 2273, "verse_number": "७-२००-७", "content_sanskrit": "सर्वानेतान्हनिष्यामि यदि योत्स्यन्ति मां रणे।\nसत्यं ते प्रतिजानामि परिवर्तय वाहिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2059104, "chapter_id": 2273, "verse_number": "७-२००-८", "content_sanskrit": "तच्छ्रुत्वा तव पुत्रस्तु वाहिनीं पर्यवर्तयत्।\nसिंहनादेन महता व्यपोह्य सुमहद्भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2059105, "chapter_id": 2273, "verse_number": "७-२००-९", "content_sanskrit": "ततः समागमो राजन्कुरुपाण्डवसेनयोः।\nपुनरेवाभवत्तीव्रः पूर्णसागरयोरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2059106, "chapter_id": 2273, "verse_number": "७-२००-१०", "content_sanskrit": "संरब्धा हि स्थिरीभूता द्रोण पुत्रेण कौरवाः।\nउदग्राः पाण्डुपाञ्चाला द्रोणस्य निधनेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2059107, "chapter_id": 2273, "verse_number": "७-२००-११", "content_sanskrit": "तेषां परमहृष्टानां जयमात्मनि पश्यताम्।\nसंरब्धानां महावेगः प्रादुरासीद्विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2059108, "chapter_id": 2273, "verse_number": "७-२००-१२", "content_sanskrit": "यथा शिलोच्चये शैलः सागरैः सागरो यथा।\nप्रतिहन्येत राजेन्द्र तथाऽसन्कुरुपाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2059109, "chapter_id": 2273, "verse_number": "७-२००-१३", "content_sanskrit": "`चुक्षुभे पृथिवी सर्वा दिशश्च प्रतिसस्वनुः।\nसम्भ्रान्तान्यपि भूतानि जलजान्यपि मारिष।\nते च सर्वे तदा योधाः सम्प्रहृष्टा युयुत्सवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2059110, "chapter_id": 2273, "verse_number": "७-२००-१४", "content_sanskrit": "ततः शङ्खसहस्राणि भेरीणामयुतानि च।\nअवादयन्त संहृष्टाः कुरुपाण्डवसैनिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2059111, "chapter_id": 2273, "verse_number": "७-२००-१५", "content_sanskrit": "यथा निर्मथ्यमानस्य सागरस्य तु निःस्वनः।\nअभवत्तव सैन्यस्य सुमहानद्भुतोपमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2059112, "chapter_id": 2273, "verse_number": "७-२००-१६", "content_sanskrit": "`वर्तमाने तथा शब्दे रौद्रे तस्मिन्भयानके।\nसम्पतत्सु रथौघेषु तव तेषां च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2059113, "chapter_id": 2273, "verse_number": "७-२००-१७", "content_sanskrit": "प्रादुश्चक्रे ततो द्रौणिरस्त्रं नारायणं तदा।\nअभिसन्धाय पाण्डूनां पाञ्चालानां च वाहिनीं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2059114, "chapter_id": 2273, "verse_number": "७-२००-१८", "content_sanskrit": "प्रादुरासंस्ततो बाणा दीप्ताग्राः खे सहस्रशः।\nपाण्डवान्क्षपयिष्यन्तो दीप्तास्यः पन्नगा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2059115, "chapter_id": 2273, "verse_number": "७-२००-१९", "content_sanskrit": "ते दिशः खं च सैन्यं च समावृण्वन्महाहवे।\nमुहूर्ताद्भास्करस्येव लोके राजन्गभस्तयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2059116, "chapter_id": 2273, "verse_number": "७-२००-२०", "content_sanskrit": "तथाऽपरे द्योतमाना ज्योतींषीवामलाम्बरे।\nप्रादुरासन्महाराज कार्ष्णायसमया गुडाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2059117, "chapter_id": 2273, "verse_number": "७-२००-२१", "content_sanskrit": "चतुश्चक्रा द्विचक्राश्च शतघ्नो बहुला गदाः।\nचक्राणि च क्षुरान्तानि मण्डलानीव भास्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2059118, "chapter_id": 2273, "verse_number": "७-२००-२२", "content_sanskrit": "शस्त्राकृतिभिराकीर्णमतीव पुरुषर्षभ।\nदृष्ट्वान्तरिक्षमाविग्नाः पाण्डुपाञ्चालसृञ्जयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2059119, "chapter_id": 2273, "verse_number": "७-२००-२३", "content_sanskrit": "यथायथा ह्ययुध्यन्त पाण्डवानां महारथाः।\nतथातथा तदस्त्रं वै व्यवर्धत जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2059120, "chapter_id": 2273, "verse_number": "७-२००-२४", "content_sanskrit": "वध्यमानास्तदाऽस्त्रेण तेन नारायणेन वै।\nदह्यमानाऽनलेनेव सर्वतोऽभ्यर्दिता रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2059121, "chapter_id": 2273, "verse_number": "७-२००-२५", "content_sanskrit": "यथा हि शिशिरापाये दहेत्कक्षं हुताशनः।\nतथा तदस्त्रं पाण्डूनां ददाह ध्वजिनीं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2059122, "chapter_id": 2273, "verse_number": "७-२००-२६", "content_sanskrit": "आपूर्यमाणेनास्त्रेण सैन्ये क्षीयति च प्रभो।\nजगाम परमं त्रासं धर्मपुत्रो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2059123, "chapter_id": 2273, "verse_number": "७-२००-२७", "content_sanskrit": "द्रवमाणं तु तत्सैन्यं दृष्ट्वा विगतचेतनम्।\nमध्यस्थतां च पार्थस्य धर्मपुत्रोऽब्रवीदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2059124, "chapter_id": 2273, "verse_number": "७-२००-२८", "content_sanskrit": "धृष्टद्युम्न पलायस्व सह पाञ्चालसेनया।\nसात्यके त्वं च गच्छस्व वृष्ण्यन्धकवृतो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2059125, "chapter_id": 2273, "verse_number": "७-२००-२९", "content_sanskrit": "वासुदेवोऽपि धर्मात्मा करिष्यत्यात्मनः क्षमम्।\nश्रेयो ह्युपदिशत्येष लोकस्य किमुतात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2059126, "chapter_id": 2273, "verse_number": "७-२००-३०", "content_sanskrit": "सङ्ग्रामस्तु न कर्तव्यः सर्वसैन्यान्ब्रवीमि वः।\nअहं हि सह सोदर्यैः प्रवेक्ष्ये हव्यवाहनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2059127, "chapter_id": 2273, "verse_number": "७-२००-३१", "content_sanskrit": "भीष्मद्रोणार्णवं तीर्त्वा सङ्ग्रामे भीरुदुस्तरे।\nविमज्जिष्यामि सलिले सगणो द्रौणिगोष्पदे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2059128, "chapter_id": 2273, "verse_number": "७-२००-३२", "content_sanskrit": "कामः सम्पद्यतामस्य बीभत्सोराशु मां प्रति।\nकल्याणवृत्तिराचार्यो मया युधि निपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2059129, "chapter_id": 2273, "verse_number": "७-२००-३३", "content_sanskrit": "येन बालः स सौभद्रो युद्धानामविशारदः।\nसमर्थैर्बहुभिः क्रूरैर्घातितो नाभिपालितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2059130, "chapter_id": 2273, "verse_number": "७-२००-३४", "content_sanskrit": "येन विब्रुवती प्रश्नं तथा कृष्णा सभां गता।\nउपेक्षिता सपुत्रेण दासीभावं नियच्छती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2059131, "chapter_id": 2273, "verse_number": "७-२००-३५", "content_sanskrit": "`रक्षणे च महान्यत्नः सैन्धवस्य कृतो युधि।\nअर्जुनस्य विघातार्थं प्रतिज्ञा येन रक्षिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2059132, "chapter_id": 2273, "verse_number": "७-२००-३६", "content_sanskrit": "व्यूहद्वारि वयं चैव धृता येन जिगीषवः।\nवारितं च महत्सैन्यं प्रविशत्तद्यथाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2059133, "chapter_id": 2273, "verse_number": "७-२००-३७", "content_sanskrit": "जिघांसुर्धार्तराष्ट्रश्च श्रान्तेष्वन्येषु फल्गुनम्।\nकवचेन तथा गुप्तो रक्षार्थं सैन्धवस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2059134, "chapter_id": 2273, "verse_number": "७-२००-३८", "content_sanskrit": "येन ब्रह्मास्त्रविदुषा पाञ्चालाः सत्यजिन्मुखाः।\nकुर्वाणा मज्जये यत्नं समूला विनिपातिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2059135, "chapter_id": 2273, "verse_number": "७-२००-३९", "content_sanskrit": "`ग्रहणे च परो यत्नः कृतस्तेन यथा मम।\nविदितं सर्वमेवैतद्भवतां सर्वयोधिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2059136, "chapter_id": 2273, "verse_number": "७-२००-४०", "content_sanskrit": "येन प्रव्राज्यमानाश्च राज्याद्वयमधर्मतः।\nनिवार्यमाणेनास्माभिरनुगन्तुं तदेषिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2059137, "chapter_id": 2273, "verse_number": "७-२००-४१", "content_sanskrit": "`वनवासान्निवृत्तानां समये च तथा कृते।\nस्नेहश्च दर्शितो नित्यं प्रत्यक्षं वो महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2059138, "chapter_id": 2273, "verse_number": "७-२००-४२", "content_sanskrit": "योऽसावत्यन्तमस्मासु कुर्वाणः सौहृदं परम्।\nहतस्तदर्थे मरणं गमिष्यामि सबान्धवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2059139, "chapter_id": 2273, "verse_number": "७-२००-४३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2059140, "chapter_id": 2273, "verse_number": "७-२००-४३", "content_sanskrit": "एवं ब्रुवति कौन्तेये दाशार्हस्त्वरितस्ततः।\nनिवार्य सैन्यं बाहुभ्यामिदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2059141, "chapter_id": 2273, "verse_number": "७-२००-४४", "content_sanskrit": "शीघ्रं न्यस्यत शस्त्राणि वाहेभ्यश्चावरोहत।\nएष योगोऽत्र विहितः प्रतिघाते महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2059142, "chapter_id": 2273, "verse_number": "७-२००-४५", "content_sanskrit": "द्विपाश्वस्यन्दनेभ्यश्च क्षितिं सर्वेऽवरोहत।\nएवमेतन्न वो हन्यादस्त्रं भूमौ निरायुधान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2059143, "chapter_id": 2273, "verse_number": "७-२००-४६", "content_sanskrit": "यथायथा हि युध्यन्ते योधा ह्यस्त्रमिदं प्रति।\nतथातथा भवन्त्येते कौरवा बलवत्तराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2059144, "chapter_id": 2273, "verse_number": "७-२००-४७", "content_sanskrit": "निक्षेप्स्यन्ति च शस्त्राणि वाहनेभ्योऽवरुह्य ये।\nयेऽञ्जलिं कुर्वते वीर नमस्ति च विवाहनाः।\nतान्नैतदस्त्रं सङ्ग्रामे निहनिष्यति मानवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2059145, "chapter_id": 2273, "verse_number": "७-२००-४८", "content_sanskrit": "ये त्वेतत्प्रतियोत्स्यन्ति मनसाऽपीह केचन।\nनिहनिष्यति तान्सर्वान्रसातलगतानपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2059146, "chapter_id": 2273, "verse_number": "७-२००-४९", "content_sanskrit": "ते वचस्तस्य तच्छ्रुत्वा वासुदेवस्य भारत।\nईषुः सर्वे समुत्स्रष्टुं मनोभिः करणेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2059147, "chapter_id": 2273, "verse_number": "७-२००-५०", "content_sanskrit": "तत उत्स्रष्टुकामांस्तानस्त्राण्यालक्ष्य पाण्डवः।\nभीमसेनोऽब्रवीद्राजन्निदं संहर्षयन्वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2059148, "chapter_id": 2273, "verse_number": "७-२००-५१", "content_sanskrit": "न कथञ्चन शस्त्राणि मोक्तव्यानीह केनचित्।\nअहमावारयिष्यामि द्रोणपुत्रास्त्रमाशुगैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2059149, "chapter_id": 2273, "verse_number": "७-२००-५२", "content_sanskrit": "गदयाऽप्यनया गुर्व्या हेमविग्रहया रणे।\nकालवत्प्रहरिष्यामि द्रौणेरस्त्रं विशातयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2059150, "chapter_id": 2273, "verse_number": "७-२००-५३", "content_sanskrit": "न हि मे विक्रमे तुल्यः कश्चिदस्ति पुमानिह।\nयथैव सवितुस्तुल्यं ज्योतिरन्यन्न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2059151, "chapter_id": 2273, "verse_number": "७-२००-५४", "content_sanskrit": "पश्यतेमौ हि मे बाहू नागराजकरोपमौ।\nसमर्थौ पर्वतस्यापि शैशिरस्य निपातने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2059152, "chapter_id": 2273, "verse_number": "७-२००-५५", "content_sanskrit": "नागायुतसमप्राणो ह्यहमेको नरेष्विह।\nशक्रो यथाऽप्रतिद्वन्द्वो दिवि देवेषु विश्रुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2059153, "chapter_id": 2273, "verse_number": "७-२००-५६", "content_sanskrit": "अद्य पश्यत मे वीर्यं बाह्वोः पीनांसयोर्युधि।\nज्वलमानस्य दीप्तस्य द्रौणेरस्त्रस्य वारणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2059154, "chapter_id": 2273, "verse_number": "७-२००-५७", "content_sanskrit": "यदि नारायणास्त्रस्य प्रतियोद्वा न विद्यते।\nअद्यैतत्प्रतियोत्स्यामि पश्यत्सु कुरुपाण्डुपु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2059155, "chapter_id": 2273, "verse_number": "७-२००-५८", "content_sanskrit": "अर्जुनार्जुन बीभत्सो न न्यस्यं गाण्डिवं त्वया।\nशशाङ्कस्येव ते पङ्को नैर्मल्यं पातयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2059156, "chapter_id": 2273, "verse_number": "७-२००-५९x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2059157, "chapter_id": 2273, "verse_number": "७-२००-५९", "content_sanskrit": "भीम नारायणास्त्रे मे गोषु च ब्राह्मणेषु च।\nएतेषु गाण्डिवं न्यस्यमेतद्धि व्रतमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2059158, "chapter_id": 2273, "verse_number": "७-२००-६०", "content_sanskrit": "एवमुक्तस्ततो भीमो द्रोणपुत्रमरिन्दमम्।\nअभ्ययान्मेघघोषेण रथेनादित्यवर्चसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2059159, "chapter_id": 2273, "verse_number": "७-२००-६१", "content_sanskrit": "`कम्पयन्मेदिनीं सर्वां त्रासयंश्च चमूं तव।\nशङ्खशब्दं महत्कृत्वा भुजशब्दं च पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2059160, "chapter_id": 2273, "verse_number": "७-२००-६२", "content_sanskrit": "तस्य शङ्खस्वनं श्रुत्वा बाहुशब्दं च तावकाः।\nसमन्तात्कोष्ठकीकृत्य शरव्रातैरवाकिरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2059161, "chapter_id": 2273, "verse_number": "७-२००-६३", "content_sanskrit": "स एनमिषुजालेन लघुत्वाच्छीघ्रविक्रमः।\nनिमेषमात्रेणासाद्य कुन्तीपुत्रोऽभ्यवाकिरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2059162, "chapter_id": 2273, "verse_number": "७-२००-६४", "content_sanskrit": "ततो द्रौणिः प्रहस्यैनं द्रवन्तमभिभाष्य च।\nअवाकिरत्प्रदीप्ताग्रैः शरैस्तैरभिमन्त्रितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2059163, "chapter_id": 2273, "verse_number": "७-२००-६५", "content_sanskrit": "पन्नगैरिव दीप्तास्यैर्वमद्भिर्ज्वलनं रणे।\nअवकीर्णोऽभवत्पार्थः स्फुलिङ्गैरिव काञ्चनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2059164, "chapter_id": 2273, "verse_number": "७-२००-६६", "content_sanskrit": "तस्य रूपमभूद्राजन्भीमसेनस्य संयुगे।\nखद्योतैरावृतस्येव पर्वतस्य दिनक्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2059165, "chapter_id": 2273, "verse_number": "७-२००-६७", "content_sanskrit": "तदस्त्रं द्रोणपुत्रस्य तस्मिन्प्रतिसमस्यति।\nअवर्धत महाराज यथाऽग्निरनिलोद्धतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2059166, "chapter_id": 2273, "verse_number": "७-२००-६८", "content_sanskrit": "विवर्धमानमालक्ष्य तदस्त्रं भीमविक्रमम्।\nपाण्डुसैन्यमृते भीमं सुमहद्भयमाविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2059167, "chapter_id": 2273, "verse_number": "७-२००-६९", "content_sanskrit": "ततः शस्त्राणि ते सर्वे समुत्सृज्य महीतले।\nअवारोहन्रथेभ्यश्च हस्त्यश्वेभ्यश्च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2059168, "chapter_id": 2273, "verse_number": "७-२००-७०", "content_sanskrit": "तेषु निक्षिप्तशस्त्रेषु वाहनेभ्यश्च्युतेषु च।\nतदस्त्रवीर्यं विपुलं भीममूर्धन्यथापतत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2059169, "chapter_id": 2273, "verse_number": "७-२००-७१", "content_sanskrit": "हाहाकृतानि भूतानि पाण्डवाश्च विशेषतः।\nभीमसेनमपश्यन्त तेजसा संवृतं तथा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2059170, "chapter_id": 2273, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि नारायणास्त्रमोक्षपर्वणि पञ्चदशदिवसयुद्धे द्विशततमोऽध्यायः॥ २०० ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-२००-२० गुडाः गोलाः हला इति क. क. पाठः॥ ५-२००-४० अस्माभिरस्मदीयैर्विदुरादिभिर्निवार्यमाणेन निषिध्यमानेनापि तद्वनमनुगन्तुं प्रवेष्टुमेषिता अनुमता नतु प्रतिषिद्धा इत्यर्थः॥ ५-२००-२०० द्विशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}]