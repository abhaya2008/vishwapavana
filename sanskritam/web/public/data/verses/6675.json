    "avatarnika": ""
  },
  {
    "id": 20010623,
    "chapter_id": 6675,
    "verse_number": "3.65",
    "content_sanskrit": "महाकालैर्गजव्यूहैरावद्धमददुर्द्दिनैः । भयङ्करं यद्वंशानां कालो मेघंकरो यथा ॥",
