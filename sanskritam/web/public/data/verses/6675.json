    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20010620,
    "chapter_id": 6675,
    "verse_number": "3.62",
    "content_sanskrit": "कूलंकषैर्नभो नद्यास्सौधैर्यद्धवलैरभात् । मिलन्निबिडडिण्डीरपिण्डपाण्डुरितैरिव ॥",
