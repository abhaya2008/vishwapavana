    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20010617,
    "chapter_id": 6675,
    "verse_number": "3.59",
    "content_sanskrit": "ललाटंतपसूर्याभैर्यद्गिरम्मदहेतिभिः । गुप्तं द्विषन्तपैः पार्थैर्दुर्धर्षमभवत् परैः ॥",
