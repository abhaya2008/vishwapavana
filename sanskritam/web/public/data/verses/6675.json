    "avatarnika": ""
  },
  {
    "id": 20010637,
    "chapter_id": 6675,
    "verse_number": "3.79",
    "content_sanskrit": "बहुस्वो यत्र माहेय्यो गोदुहामनभिद्रुहः । चेरुर्वृषयुजोग्रण्यस्तथोक्ष्णां क्षितिभित्खुराः ॥",
