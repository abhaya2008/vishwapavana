    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20010624,
    "chapter_id": 6675,
    "verse_number": "3.66",
    "content_sanskrit": "पतीनां क्षेमकार्यश्च प्रियकार्यश्च योषितः । यत्र क्षेमंकरस्तासां पतयश्च प्रियंकराः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20010625,
    "chapter_id": 6675,
    "verse_number": "3.67",
    "content_sanskrit": "कृत्वाशितंभवं यस्मिन्नन्नपानैर्जनोर्थिनम् । प्रागाशितंभवं प्रीतः स्वजनेन सहौदनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "avatarnika": ""
  },
  {
    "id": 20010626,
    "chapter_id": 6675,
    "verse_number": "3.68",
    "content_sanskrit": "धनञ्जयात्सदोद्विग्ना धनुराम्नायपारगात् । यन्न चोरियतुं 'वित्तमुपजग्मुर्जनङ्गमाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "avatarnika": ""
  },
  {
    "id": 20010627,
    "chapter_id": 6675,
    "verse_number": "3.69",
    "content_sanskrit": "अध्वगा दूरगा यत्र क्षुत्पिपासाश्रमान्तगाः । भूत्वान्वहं नृपं प्रोचुश्शत्रुहन्ता स्ताद् भवानिति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "avatarnika": ""
  },
  {
    "id": 20010628,
    "chapter_id": 6675,
    "verse_number": "3.70",
    "content_sanskrit": "क्लेशपहं यदुद्यानं नीरन्ध्रशिशिरद्रुमम् । तमोपहाश्च नानारुक्मरश्मिजालैर्यदालयाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
