    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20010601,
    "chapter_id": 6675,
    "verse_number": "3.43",
    "content_sanskrit": "नानाकुसुमगन्धान् वानादायचरो मृदुः । उद्यानपवनश्शीतो यत्र नारीस्सुखाकरोत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20010602,
    "chapter_id": 6675,
    "verse_number": "3.44",
    "content_sanskrit": "पुरस्सरैस्सुररूपाणां शूराणामग्रतस्सरैः । अग्रेसरैर्वदान्यानां सुशीलाग्रेसरैर्नरैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20010603,
    "chapter_id": 6675,
    "verse_number": "3.45",
    "content_sanskrit": "पराक्रमे पूर्वसरैर्यशस्करपराक्रमैः । संप्रहारकरैर्नित्यं यन्नृपेष्टकरैर्बभौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20010604,
    "chapter_id": 6675,
    "verse_number": "3.46",
    "content_sanskrit": "तेजस्विनो नरा यत्र दिवाकरकरा इव । 'अमिरामास्तथा नार्यो निशाकरकरा इव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20010605,
    "chapter_id": 6675,
    "verse_number": "3.47",
    "content_sanskrit": "आज्ञया वासुदेवस्य जगदादिकरस्य वै । किंकरेण कृतं त्वष्ट्रा चित्रं चित्रकरेण यत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20010606,
    "chapter_id": 6675,
    "verse_number": "3.48",
    "content_sanskrit": "जङ्घाकरैर्बाहुकरैर्भिषग्भिर्यदरुष्करैः । धनुष्करैस्तथापूर्णं भृत्यैर्बहुकरैरपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20010607,
    "chapter_id": 6675,
    "verse_number": "3.49",
    "content_sanskrit": "कचिल्लिपिकरैर्युक्तं कचिन्नन्दीकरैर्नटैः । कचिद्बलिकरैर्यैच्च कचित् क्षेत्लकरैर्नरैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20010608,
    "chapter_id": 6675,
    "verse_number": "3.50",
    "content_sanskrit": "यत्र कर्मकरीनारीर्दृष्ट्वा कर्मकरा नराः । चाटुकाराः परिष्वज्य विजने जातु रेमिरे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20010609,
    "chapter_id": 6675,
    "verse_number": "3.51",
    "content_sanskrit": "श्लोककारेरितान् श्रुत्वा श्लोकान् पञ्जरवर्तिनः । शब्दकाराश्शुकाः यत्र पापठ्यन्ते स्म वेश्मसु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20010610,
    "chapter_id": 6675,
    "verse_number": "3.52",
    "content_sanskrit": "गाथाकारैश्च कविभिर्वैरकारैश्च योद्धृभिः । सूत्रकारैश्च विद्वद्भिस्सदा यत् पर्यशोभत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20010611,
    "chapter_id": 6675,
    "verse_number": "3.53",
    "content_sanskrit": "नातंभरिर्नरो यस्मिन्नासीत् कश्चिन्मितंपचः । अर्थिकामदुघैः पूर्णैर्नरैः कल्पद्रुमैरिव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20010612,
    "chapter_id": 6675,
    "verse_number": "3.54",
    "content_sanskrit": "यत्रोत्तानशयैर्डिम्भैरहृष्यन्नङ्गमेजयैः । मुष्टिन्धयैर्दन्तस्यैः कुटुम्बिन्यः स्तनन्धयैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20010613,
    "chapter_id": 6675,
    "verse_number": "3.55",
    "content_sanskrit": "सरस्सु पीतपानीयैर्बभौयत् कूलमुद्वहैः । अभ्रंलिहमहाशृङ्गैः ककुबद्भिर्वहंलिहैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20010614,
    "chapter_id": 6675,
    "verse_number": "3.56",
    "content_sanskrit": "पात्रैः प्रस्थंपचैर्द्रोणंपचैर्यत्रालया बभुः । खारिंपचैश्च विमलैरेकवेशनिवेशितैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20010615,
    "chapter_id": 6675,
    "verse_number": "3.57",
    "content_sanskrit": "बहु ब्रह्मकुलं यत्र कवोष्णमनखंपचम् । दत्तं राज्ञा हविर्भुक्त्वा स्वाशिषः 'प्रत्यशिश्रणत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20010616,
    "chapter_id": 6675,
    "verse_number": "3.58",
    "content_sanskrit": "अरुन्तुदालापचणैस्साधु चन्द्रविधुन्तुदैः । धर्मराजभयाद्यन्न प्रविष्टं जातुचित् खलैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
