    "avatarnika": ""
  },
  {
    "id": 20010630,
    "chapter_id": 6675,
    "verse_number": "3.72",
    "content_sanskrit": "जायाघ्ना न नरा यत्र बभूवुस्तिलकालकाः । पाणिरेखाः पतिघ्न्यश्च स्त्रीणां सौराज्यसम्पदा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "avatarnika": ""
  },
  {
    "id": 20010631,
    "chapter_id": 6675,
    "verse_number": "3.73",
    "content_sanskrit": "भेषजं सर्वरोगघ्नमुपदिष्टं भिषग्वरैः । नानाविधं निषेव्यासन्नरोगा यत्र नागराः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
