    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20010621,
    "chapter_id": 6675,
    "verse_number": "3.63",
    "content_sanskrit": "प्रासादेभ्रंकषे यस्य श्लिष्यन्तः कलशस्तनीः । नभःस्थलगतिश्रान्ता विश्राम्यन्ति स्म चारणाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
