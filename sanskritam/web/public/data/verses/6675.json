    "avatarnika": ""
  },
  {
    "id": 20010639,
    "chapter_id": 6675,
    "verse_number": "3.81",
    "content_sanskrit": "सुलक्षमभाजो घासादो यत्र क्रव्याद्विरक्षताः । अधृष्याकृतयो वाहा मण्डयन्ति स्म मन्दुराः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
