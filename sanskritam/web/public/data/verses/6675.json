    "avatarnika": ""
  },
  {
    "id": 20010638,
    "chapter_id": 6675,
    "verse_number": "3.80",
    "content_sanskrit": "आधोरणाकृतविदो यत्रार्द्रविटपिच्छिदः । नागेन्द्रा नगजित्कायास्सम्राजो रेजुरर्चिताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
