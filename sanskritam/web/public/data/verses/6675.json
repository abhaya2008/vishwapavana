    "display_order": 73,
    "avatarnika": ""
  },
  {
    "id": 20010632,
    "chapter_id": 6675,
    "verse_number": "3.74",
    "content_sanskrit": "नकुलस्सहदेवश्च हस्तिघ्नौ यद्वरक्षतुः । महाभुजौ कवाटघ्ना वैकागारिकमण्डलात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74,
    "avatarnika": ""
  },
  {
    "id": 20010633,
    "chapter_id": 6675,
    "verse_number": "3.75",
    "content_sanskrit": "नृपप्रसादलब्धार्थैर्यत्राढ्यंभावुकान्तरान् । पाणिघास्ताडघाद्याश्च सदाऽसेवन्त शिल्पिनः ॥",
    "padaccheda": "",
    "anvaya": "",
