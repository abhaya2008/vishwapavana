    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20010618,
    "chapter_id": 6675,
    "verse_number": "3.60",
    "content_sanskrit": "केचिद्वाचंयमाः केचिद् द्विजाः स्थण्डिलशायिनः । अतपस्यन् यदुद्याने पुण्येपृथ्वीभृतोचिताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
