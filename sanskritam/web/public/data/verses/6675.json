    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20010619,
    "chapter_id": 6675,
    "verse_number": "3.61",
    "content_sanskrit": "सर्वंकषप्रतापानुरागं नृपमुपासितुम् । विविशे यज्ञनैर्नित्यं जंबुद्वीपनिवासिभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
