[
  {
    "id": 20010559,
    "chapter_id": 6675,
    "verse_number": "3.1",
    "content_sanskrit": "ध्यातव्यानि सदा ध्यायन् कर्तव्यानि समाचरन् । रक्षणीयाः प्रजास्सर्वा धर्मराजस्स्म रक्षति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20010560,
    "chapter_id": 6675,
    "verse_number": "3.2",
    "content_sanskrit": "वर्तितव्यं त्वयेतीति राजवृत्तमबोधयन् । महर्षयस्तं व्यासाद्यास्सन्तो हि शरणं सताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20010561,
    "chapter_id": 6675,
    "verse_number": "3.3",
    "content_sanskrit": "जय्या एव द्विषो जेयास्तस्य तेजस्विनोऽभवन् । दान्तदम्यसतो नम्यान्नमतः सततं सतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20010562,
    "chapter_id": 6675,
    "verse_number": "3.4",
    "content_sanskrit": "लोकैर्मातुमशख्योभूत् स 'सयैर्मातुमात्मना । अपूर्वपुण्डरीकाक्षो मायारहितविक्रमः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20010563,
    "chapter_id": 6675,
    "verse_number": "3.5",
    "content_sanskrit": "निर्मद्या गद्यसद्वाचस्साध्वाचर्ये पथि स्थिताः । आचार्यस्य यथा शिष्या यम्यास्तस्याभवन् प्रजाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20010564,
    "chapter_id": 6675,
    "verse_number": "3.6",
    "content_sanskrit": "'तस्य विक्रीणतां राज्ये पण्यं द्रविणसञ्चयम् । निच्छद्मा निरवद्योभूद् व्याहारो वणिजामपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20010565,
    "chapter_id": 6675,
    "verse_number": "3.7",
    "content_sanskrit": "देवानिव नृपानन्यान् विहाय श्रीस्तमाश्रयत् । वर्या वीर्यवतामग्र्यं पद्माक्षं पद्मलक्षणा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20010566,
    "chapter_id": 6675,
    "verse_number": "3.8",
    "content_sanskrit": "वह्यैर्वहद्भिश्शकटैर्धनसञ्चयमित्वरैः । विक्रयप्राप्तवित्तांशैरर्यैश्चर्यस्स शिश्रिये ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20010567,
    "chapter_id": 6675,
    "verse_number": "3.9",
    "content_sanskrit": "सतां कृतोरुपुण्यानां राज्ञस्तस्य च यज्वनः । अजर्यं संगतं जातमन्योन्यस्य समृद्धये ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20010568,
    "chapter_id": 6675,
    "verse_number": "3.10",
    "content_sanskrit": "स सत्यवद्यान् ब्रह्मोद्यान् ब्रह्मभूयं गतान् मुनीन् । अतिपुण्यान् सदा भेजे ब्रह्महत्यामपि घ्नतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20010569,
    "chapter_id": 6675,
    "verse_number": "3.11",
    "content_sanskrit": "जुष्यानित्यान् गिरा स्तुत्यानादृत्यान् हृदयेन च । विवृत्यान्यगुणस्तोकान् संवृत्य स्वमहागुणान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20010570,
    "chapter_id": 6675,
    "verse_number": "3.12",
    "content_sanskrit": "खेयावाधारगंभीरम्मृज्यं शीलामृतोर्मिभिः । मार्ग्यैः परिवृतो भृत्यैस्स दृशयो हृदयं दधे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20010571,
    "chapter_id": 6675,
    "verse_number": "3.13",
    "content_sanskrit": "रुच्यस्सूर्यरुगव्यथ्यो राजसूयार्हतां ययौ । कुप्याकुप्यसुवर्णादिस्फीतोसावमृषोद्यवाक् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20010572,
    "chapter_id": 6675,
    "verse_number": "3.14",
    "content_sanskrit": "राष्ट्रे तस्याखिलं सस्यं कृष्टपच्यमवर्धत । भिद्योद्ध्यवाहोस्रतः पुष्यदीप्तीकृतत्विषः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20010573,
    "chapter_id": 6675,
    "verse_number": "3.15",
    "content_sanskrit": "विपूयमेखलावन्तः प्रगृह्यादि'पदच्छिदः । तोषयन्तो गुरून् गृह्या वेदानध्यैयत द्विजाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20010574,
    "chapter_id": 6675,
    "verse_number": "3.16",
    "content_sanskrit": "महेन्द्रप्रस्थगुहायां पुरि रात्रिनन्दिवं चमूः । राजगुह्या स्थिता दृप्तसन्नद्धानेकयोद्धृका ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20010575,
    "chapter_id": 6675,
    "verse_number": "3.17",
    "content_sanskrit": "कृत्यस्थे सति तत्रेशे कार्ये वर्णाश्रमे स्थितम् । वर्ष्यसीमरसक्षीबसुवृष्यांबुवर्धितैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20010576,
    "chapter_id": 6675,
    "verse_number": "3.18",
    "content_sanskrit": "अमावास्यातमश्यामैर्गजैरश्वैश्च युग्यवान् । अमावास्यापराह्णेषु सोऽर्च्यानर्चितवान् पितॄन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20010577,
    "chapter_id": 6675,
    "verse_number": "3.19",
    "content_sanskrit": "परैरहार्यं तस्यासीद्वीर्यमेवार्कतेजसः । धनं तु सकलं हार्यमिन्दुकान्तेरजायत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20010578,
    "chapter_id": 6675,
    "verse_number": "3.20",
    "content_sanskrit": "अवश्यहाव्यं जुहुवुर्ब्राह्मणास्सोममध्वरे । घनैर्वावमिरासाव्यमाचाम्यं तस्य शासने ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20010579,
    "chapter_id": 6675,
    "verse_number": "3.21",
    "content_sanskrit": "अग्नीनानाय्य पाश्चात्यपौरस्त्यान् 'जुगुपुर्द्विजाः । जनं प्रणाय्यं शासत्सु प्रणाय्याः पाण्डुसूनुषु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20010580,
    "chapter_id": 6675,
    "verse_number": "3.22",
    "content_sanskrit": "पाय्यैर्मिमाना धान्यानि निकाय्यानां प्रसाधकाः । प्रायश्चित्तविशेषाणां बोद्धारः कारकास्तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20010581,
    "chapter_id": 6675,
    "verse_number": "3.23",
    "content_sanskrit": "अग्निचित्याविदश्चित्यं चिन्वन्तोग्निं विचक्षणाः । समूह्यादिभिदोपेतं कुण्डपाय्यादियाजिनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20010582,
    "chapter_id": 6675,
    "verse_number": "3.24",
    "content_sanskrit": "धाय्यादिज्ञाः पुरोडाशं सान्नाय्यमपि जुह्वतः । कृष्णे पर्वणि शुक्रे तु पुरोडाशं यथाविधि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20010583,
    "chapter_id": 6675,
    "verse_number": "3.25",
    "content_sanskrit": "नन्दकास्सुहृदादीनां वर्धकास्सर्वदेहिनाम् । उत्साहिनः प्रजास्सर्वा ररक्षुः पाण्डुनन्दनाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20010584,
    "chapter_id": 6675,
    "verse_number": "3.26",
    "content_sanskrit": "विक्षिपा रिपुचोराणां धर्मज्ञास्सज्जनप्रियाः । किरा धनांबुधाराणां विक्षेप्तारश्च सम्पदाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20010585,
    "chapter_id": 6675,
    "verse_number": "3.27",
    "content_sanskrit": "संप्रहारभुवां प्रस्थाः प्रोद्भमा जलजन्मनाम् । उदेजया विपक्षाणां तेषां विन्दाश्च सम्पदाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20010586,
    "chapter_id": 6675,
    "verse_number": "3.28",
    "content_sanskrit": "ददा गवां दधास्त्रीणां दायाः पशुगणस्य च । धायाश्च धनकोटीनां दानतोषितसज्जनाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20010587,
    "chapter_id": 6675,
    "verse_number": "3.29",
    "content_sanskrit": "ज्वालगात्राः ज्वलाकल्पा दुर्धर्षाचलतेजसः । अवश्यायमिवार्कौघा दहन्तो देहिनामघम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20010588,
    "chapter_id": 6675,
    "verse_number": "3.30",
    "content_sanskrit": "दण्डचस्य पाण्डवे नाये सति दावाग्निवर्चसि । ग्रहग्राहगदादिभ्यो न दुःखं देहिनामभूत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20010589,
    "chapter_id": 6675,
    "verse_number": "3.31",
    "content_sanskrit": "गृहे गृहे नयन् प्रीत्या हायनं हायनं जनः । गायनीभिर्वृतः स्त्रीभिर्गाथकैर्नर्तकैरपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20010590,
    "chapter_id": 6675,
    "verse_number": "3.32",
    "content_sanskrit": "प्रवक्को वनराजीनां घर्माम्बुस्रवक्क्रस्तनः । नखानामलकानाञ्च लवकस्त्रीजनोऽलसत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20010591,
    "chapter_id": 6675,
    "verse_number": "3.33",
    "content_sanskrit": "स कुंभकारैर्गत्वोचे धान्यमायैः कृषीवलैः । कामदस्तन्तुवायैश्च जीवकस्तान् भवानिति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20010592,
    "chapter_id": 6675,
    "verse_number": "3.34",
    "content_sanskrit": "सिंहासनस्थं तं 'लोके वन्दमाने ससंभ्रमे । महीरजः पदं विष्णोश्शलभोत्थमिवानशे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20010593,
    "chapter_id": 6675,
    "verse_number": "3.35",
    "content_sanskrit": "उत्तिष्ठमानस्स सदा परामलभत श्रियम् । तुन्दं परिमृजो लोकः कमर्थं प्रतिपद्यते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20010594,
    "chapter_id": 6675,
    "verse_number": "3.36",
    "content_sanskrit": "बहुप्रदो बुधप्रज्ञो गुणसंख्यस्स देहिनाम् । सामगादीन् द्विजानार्चत् सुरापादीन्निराकरोत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20010595,
    "chapter_id": 6675,
    "verse_number": "3.37",
    "content_sanskrit": "रक्षन् स षष्ठांशहरो विजयध्वमरीमिति । वारवाणहरान् वीरान् न्ययुङ्क्त चतुरोऽनुजान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20010596,
    "chapter_id": 6675,
    "verse_number": "3.38",
    "content_sanskrit": "भुजवीर्यजिताशेषद्विपदत्तकराहराः । पूजार्हं पूजयामासुस्ते तु ज्येष्ठं युधिष्ठिरम् ॥",
