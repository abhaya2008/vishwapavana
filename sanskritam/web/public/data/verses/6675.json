    "avatarnika": ""
  },
  {
    "id": 20010640,
    "chapter_id": 6675,
    "verse_number": "3.82",
    "content_sanskrit": "आसीत् पौरजनो यत्र सुकर्मा धर्मजाज्ञया । अलकालोकजित्वार्थिदावार्थिनां गुणी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
