  },
  {
    "id": 20010597,
    "chapter_id": 6675,
    "verse_number": "3.39",
    "content_sanskrit": "दानवानमदान्धोपि निष्कणेंजपषट्पदः । स्तंबेरम इवापूर्वस्स श्रीमानुन्नतो बभौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20010598,
    "chapter_id": 6675,
    "verse_number": "3.40",
    "content_sanskrit": "स भ्रातृभिस्सहश्वास प्रशासत् पृथिवीमिति । पुरे पुरन्दरप्रख्ये कैलास इव शङ्करः ॥",
