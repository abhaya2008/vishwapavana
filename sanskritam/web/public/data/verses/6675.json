    "display_order": 70,
    "avatarnika": ""
  },
  {
    "id": 20010629,
    "chapter_id": 6675,
    "verse_number": "3.71",
    "content_sanskrit": "कुमारघातिनस्त्रीणां जरतां शीर्षघातिनः । नान्ये च पापा यत्रासन् भीमसेनगदाभयात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
