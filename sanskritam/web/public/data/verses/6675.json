    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20010599,
    "chapter_id": 6675,
    "verse_number": "3.41",
    "content_sanskrit": "सौधपष्ठशयान् दृष्ट्वा यत्न नारीनरान् निशि । गन्धर्वाप्सरसो व्योमचर्यश्चकमिरेतराम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20010600,
    "chapter_id": 6675,
    "verse_number": "3.42",
    "content_sanskrit": "भिक्षाचरा दरिद्रा स्त्रीनॄंश्च सेनाचरान् द्विषः । नाकृतार्थाः कृतार्थाश्च जातु यत्र गता गताः ॥",
