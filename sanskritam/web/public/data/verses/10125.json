[{"id": 6000125000, "chapter_id": 10125, "verse_number": null, "content_sanskrit": "अथ षष्ठाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000125001, "chapter_id": 10125, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.001.m4a", "display_order": 2}, {"id": 6000125002, "chapter_id": 10125, "verse_number": "६-६-१", "content_sanskrit": "ततः प्राचेतसोऽसिक्न्यामनुनीतः स्वयम्भुवा।\nषष्टिं सञ्जनयामास दुहितॄः पितृवत्सलाः॥ ६/६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.002.m4a", "display_order": 3, "topics": [{"text": "दक्षकन्यावंशकथनम्", "range": "१–४२"}]}, {"id": 6000125003, "chapter_id": 10125, "verse_number": "६-६-२", "content_sanskrit": "ददौ स दश धर्माय, कश्यपाय त्रयोदश। कालस्य नयने युक्ताः सप्तविंशतिमिन्दवे।\nभूताङ्गिरःकृशाश्वेभ्यो द्वे द्वे तार्क्ष्यस्य चापराः॥ ६/६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.003.m4a", "display_order": 4}, {"id": 6000125004, "chapter_id": 10125, "verse_number": "६-६-३", "content_sanskrit": "नामधेयान्यमूषां त्वं सापत्यानां च मे शृृणु।\nयासां प्रसूतिप्रभवैर्लोका आपूरितास्‍त्रयः॥ ६/६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.004.m4a", "display_order": 5}, {"id": 6000125005, "chapter_id": 10125, "verse_number": "६-६-४", "content_sanskrit": "भानुर्लम्बा ककुब् जामिर्विश्वा साध्या मरुत्वती।\nवसुर्मुहूर्ता सङ्कल्पा धर्मपत्न्यः सुताञ् शृणु॥ ६/६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.005.m4a", "display_order": 6}, {"id": 6000125006, "chapter_id": 10125, "verse_number": "६-६-५", "content_sanskrit": "भानोस्तु वेदऋषभ इन्द्रसेनस्ततो नृप।\nविद्योत आसील्लम्बायास्ततश्च स्तनयित्नवः॥ ६/६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.006.m4a", "display_order": 7}, {"id": 6000125007, "chapter_id": 10125, "verse_number": "६-६-६", "content_sanskrit": "ककुभः सङ्कटश्चासीत् कीकटस्तनयो यतः।\nभुवो दुर्गाणि जामेयाः स्वर्गो नन्दिस्ततोऽभवत्॥ ६/६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.007.m4a", "display_order": 8}, {"id": 6000125008, "chapter_id": 10125, "verse_number": "६-६-७", "content_sanskrit": "विश्वेदेवास्तु विश्वायाम् अप्रजांस्तान् प्रचक्षते।\nसाध्यो गणस्तु साध्यायाम् अर्थसिद्धिस्तु तत्सुतः॥ ६/६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.008.m4a", "display_order": 9}, {"id": 6000125009, "chapter_id": 10125, "verse_number": "६-६-८", "content_sanskrit": "मरुत्वांश्च जयन्तश्च मरुत्वत्यां बभूवतुः।\nजयन्तो वासुदेवांश उपेन्द्र इति यं विदुः॥ ६/६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.009.m4a", "display_order": 10}, {"id": 6000125010, "chapter_id": 10125, "verse_number": "६-६-९", "content_sanskrit": "मौहूर्तिका देवगणा मुहूर्तायाश्च जज्ञिरे।\nयथाफलं प्रयच्छन्ति भूतानां स्वस्वकालजम्॥ ६/६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.010.m4a", "display_order": 11}, {"id": 6000125011, "chapter_id": 10125, "verse_number": "६-६-१०", "content_sanskrit": "सङ्कल्पायाश्च सङ्कल्पः कामः सङ्कल्पजः स्मृतः।\nवसवोऽष्टौ वसोः पुत्रास्तेषां नामानि मे शृृणु॥ ६/६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.011.m4a", "display_order": 12}, {"id": 6000125012, "chapter_id": 10125, "verse_number": "६-६-११", "content_sanskrit": "द्रोणः प्राणो ध्रुवोऽर्कोऽग्निर्दोषो वस्तुर्विभावसुः।\nद्रोणस्याभिमतेः पत्न्या हर्षशोकभयादयः॥ ६/६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.012.m4a", "display_order": 13}, {"id": 6000125013, "chapter_id": 10125, "verse_number": "६-६-१२", "content_sanskrit": "प्राणस्योर्जस्वती भार्या सह आयुः परोजवः।\nध्रुवस्य भार्या धरणी त्वसूत विविधाः पुरः॥ ६/६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.013.m4a", "display_order": 14}, {"id": 6000125014, "chapter_id": 10125, "verse_number": "६-६-१३", "content_sanskrit": "अर्कस्य वासना भार्या पुत्रास्तर्षादयः स्मृताः।\nअग्नेर्भार्या वसोर्धारा पुत्रा द्रविणकादयः॥ ६/६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.014.m4a", "display_order": 15}, {"id": 6000125015, "chapter_id": 10125, "verse_number": "६-६-१४", "content_sanskrit": "स्कन्दश्च कृत्तिकापुत्रो, ये विशाखादयस्ततः।\nदोषस्य शर्वरी पुत्रः शिंशुमारो हरेः कला॥ ६/६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.015.m4a", "display_order": 16}, {"id": 6000125016, "chapter_id": 10125, "verse_number": "६-६-१५", "content_sanskrit": "वस्तोराङ्गिरसी पुत्रो विश्वकर्मा कृतीपतिः।\nततो मनुश्चाक्षुषोऽभूद् विश्वेशाद्या मनोः सुताः॥ ६/६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.016.m4a", "display_order": 17}, {"id": 6000125017, "chapter_id": 10125, "verse_number": "६-६-१६", "content_sanskrit": "विभावसोरसूतोषा व्युष्टं रोचिषमातपम्।\nपञ्चयामोऽथ भूतानि येन जाग्रति कर्मसु॥ ६/६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.017.m4a", "display_order": 18}, {"id": 6000125018, "chapter_id": 10125, "verse_number": "६-६-१७", "content_sanskrit": "भूतस्य भार्याभूताया रुद्रा एकादश स्मृताः।\nसुरूपाऽसूत भूतस्य भार्या रुद्रांश्च कोटिशः॥ ६/६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.018.m4a", "display_order": 19}, {"id": 6000125019, "chapter_id": 10125, "verse_number": "६-६-१८", "content_sanskrit": "रैवतोऽजो भवो भीमो वाम उग्रो वृषाकपिः। अजैकपादहिर्बुध्न्यो बहुरूपो महानिति।\nरुद्रांश्च पार्षदांश्चान्यान् घोरान् प्रेतविनायकान्॥ ६/६/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.019.m4a", "display_order": 20}, {"id": 6000125020, "chapter_id": 10125, "verse_number": "६-६-१९", "content_sanskrit": "प्रजापतेरङ्गिरसः स्वधा पत्नी पितॄन्, अथ।\nअथर्वाङ्गिरसं वेदं पुत्रत्वे चाकरोत् सती॥ ६/६/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.020.m4a", "display_order": 21}, {"id": 6000125021, "chapter_id": 10125, "verse_number": "६-६-२०", "content_sanskrit": "कृशाश्वोऽर्चिषि भार्यायां धूमकेतुमजीजनत्।\nधिषणायां वेदशिरा देवलं च सुतं मनुम्॥ ६/६/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.021.m4a", "display_order": 22}, {"id": 6000125022, "chapter_id": 10125, "verse_number": "६-६-२१", "content_sanskrit": "तार्क्ष्यस्य विनता कद्रूः पतङ्गी यामिनी इति।\nपतङ्ग्यसूत पतगान्, यामिनी शलभानथ॥ ६/६/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.022.m4a", "display_order": 23}, {"id": 6000125023, "chapter_id": 10125, "verse_number": "६-६-२२", "content_sanskrit": "विनताऽसूत गरुडं साक्षाद् यज्ञेशवाहनम्।\nसूर्यसूतमनूरुं च, कद्रूर्नागाननेकशः॥ ६/६/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.023.m4a", "display_order": 24}, {"id": 6000125024, "chapter_id": 10125, "verse_number": "६-६-२३", "content_sanskrit": "कृत्तिकादीनि नक्षत्राणीन्दोः पत्न्यस्तु भारत। दक्षशापात् सोऽनपत्यस्तासु यक्ष्मग्रहार्दितः।\nपुनः प्रसाद्य तं सोमः कला लेभे क्षयेधिताः॥ ६/६/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.024.m4a", "display_order": 25}, {"id": 6000125025, "chapter_id": 10125, "verse_number": "६-६-२४", "content_sanskrit": "शृणु नामानि लोकानां मातॄणां शङ्कराणि च।\nअथ कश्यपपत्नीनां यत्प्रसूतमिदं जगत्॥ ६/६/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.025.m4a", "display_order": 26}, {"id": 6000125026, "chapter_id": 10125, "verse_number": "६-६-२५", "content_sanskrit": "अदितिर्दितिर्दनुः काष्ठा अरिष्टा सुरसा इला।\nमुनिः क्रोधवशा ताम्रा सुरभिः सरमा तिमिः॥ ६/६/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.026.m4a", "display_order": 27}, {"id": 6000125027, "chapter_id": 10125, "verse_number": "६-६-२६", "content_sanskrit": "तिमेर्यादोगणा आसन् श्वापदाः सरमासुताः। सुरभेर्महिषा गावो ये चान्ये द्विशफा नृप।\nताम्रायाः श्येनगृध्राद्या, मुनेरप्सरसां गणाः॥ ६/६/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.027.m4a", "display_order": 28}, {"id": 6000125028, "chapter_id": 10125, "verse_number": "६-६-२७", "content_sanskrit": "दन्दशूकादयः सर्पा राजन् क्रोधवशात्मजाः।\nइलाया भूरुहाः सर्वे, यातुधानाश्च सौरसाः॥ ६/६/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.028.m4a", "display_order": 29}, {"id": 6000125029, "chapter_id": 10125, "verse_number": "६-६-२८", "content_sanskrit": "अरिष्टायाश्च गन्धर्वाः काष्ठाया द्विशफेतराः।\nसुता दनोरेकषष्टिस्तेषां प्राधानिकं शृणु॥ ६/६/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.029.m4a", "display_order": 30}, {"id": 6000125030, "chapter_id": 10125, "verse_number": "६-६-२९", "content_sanskrit": "द्विमूर्धा शम्बरोऽरिष्टो हयग्रीवो विभावसुः।\nअयोमुखः शङ्कुशिराः स्वर्भानुः कपिलोऽरुणः॥ ६/६/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.030.m4a", "display_order": 31}, {"id": 6000125031, "chapter_id": 10125, "verse_number": "६-६-३०", "content_sanskrit": "पुलोमा वृषपर्वा च एकचक्रोऽनुतापनः।\nधूम्रकेशो विरूपाक्षो विप्रचित्तिस्तु दुर्जयः॥ ६/६/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.031.m4a", "display_order": 32}, {"id": 6000125032, "chapter_id": 10125, "verse_number": "६-६-३१", "content_sanskrit": "स्वर्भानोः सुप्रभां कन्यामुवाह नमुचिः किल।\nवृषपर्वणस्तु शर्मिष्ठां ययातिर्नाहुषो बली॥ ६/६/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.032.m4a", "display_order": 33}, {"id": 6000125033, "chapter_id": 10125, "verse_number": "६-६-३२", "content_sanskrit": "वैश्वानरसुता याश्च चतस्रश्चारुदर्शनाः।\nउपदानवी हयशिराः पुलोमा कालिका तथा॥ ६/६/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.033.m4a", "display_order": 34}, {"id": 6000125034, "chapter_id": 10125, "verse_number": "६-६-३३", "content_sanskrit": "उपदानवीं हिरण्याक्षः क्रतुर्हयशिरां नृप।\nपुलोमां कालिकां च द्वे वैश्वानरसुते नृप॥ ६/६/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.034.m4a", "display_order": 35}, {"id": 6000125035, "chapter_id": 10125, "verse_number": "६-६-३४", "content_sanskrit": "उपयेमे च भगवान् कश्यपो ब्रह्मचोदितः।\nपौलोमाः कालिकेयाश्च दानवा युद्धशालिनः॥ ६/६/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.035.m4a", "display_order": 36}, {"id": 6000125036, "chapter_id": 10125, "verse_number": "६-६-३५", "content_sanskrit": "तयोः षष्टिसहस्राणि यज्ञघ्नांस्ते पितुः पिता।\nजघान स्वर्गतो राजन् एक इन्द्रप्रियङ्करः॥ ६/६/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.036.m4a", "display_order": 37}, {"id": 6000125037, "chapter_id": 10125, "verse_number": "६-६-३६", "content_sanskrit": "विप्रचित्तिः सिंहिकायां शतं चैकमजीजनत्।\nराहुज्येष्ठं केतुशतं ग्रहत्वं य उपागतः॥ ६/६/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.037.m4a", "display_order": 38}, {"id": 6000125038, "chapter_id": 10125, "verse_number": "६-६-३७", "content_sanskrit": "अथातः श्रूयतां वंशो योऽदितेरनुपूर्वशः।\nयत्र नारायणो देवः स्वांशेनावातरद् विभुः॥ ६/६/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.038.m4a", "display_order": 39}, {"id": 6000125039, "chapter_id": 10125, "verse_number": "६-६-३८", "content_sanskrit": "विवस्वानर्यमा पूषा त्वष्टाऽथ सविता भगः।\nधाता विधाता वरुणो मित्रश्शक्र उरुक्रमः॥ ६/६/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.039.m4a", "display_order": 40}, {"id": 6000125040, "chapter_id": 10125, "verse_number": "६-६-३९", "content_sanskrit": "विवस्वतः श्राद्धदेवं संज्ञाऽसूयत वै मनुम्।\nमिथुनं च महाभाग यमं देवं यमीं तथा॥ ६/६/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.040.m4a", "display_order": 41}, {"id": 6000125041, "chapter_id": 10125, "verse_number": "६-६-४०", "content_sanskrit": "सैव भूत्वाऽथ वडवा नासत्यौ सुषुवे भुवि। छाया शनैश्चरं लेभे सावर्णिं च मनुं ततः।\nकन्यां च तपतीं या वै वव्रे संवरणं पतिम्॥ ६/६/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.041.m4a", "display_order": 42}, {"id": 6000125042, "chapter_id": 10125, "verse_number": "६-६-४१", "content_sanskrit": "अर्यम्णो मातृका पत्नी तयोश्चर्षणयः सुताः।\nयत्र वै मानुषी जातिर्ब्रह्मणा चोपकल्पिता॥ ६/६/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.042.m4a", "display_order": 43}, {"id": 6000125043, "chapter_id": 10125, "verse_number": "६-६-४२", "content_sanskrit": "पूषाऽनपत्यः पिष्टादो भग्नदन्तोऽभवत् पुरा।\nयोऽसौ दक्षाय कुपितं जहास विवृतद्विजः॥ ६/६/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.043.m4a", "display_order": 44}, {"id": 6000125044, "chapter_id": 10125, "verse_number": "६-६-४३", "content_sanskrit": "त्वष्टुर्दैत्यानुजा भार्या रचना नाम कन्यका।\nसन्निवेशस्तया जज्ञे विश्वरूपश्च वीर्यवान्॥ ६/६/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.044.m4a", "display_order": 45, "topics": [{"text": "त्वष्टृनामकादादित्यात् विश्वरूपाचार्योत्पत्तिः", "range": "४३–४४"}]}, {"id": 6000125045, "chapter_id": 10125, "verse_number": "६-६-४४", "content_sanskrit": "तं वव्रिरे सुरगणा स्वस्रीयं द्विषतामपि।\nविमतेन परित्यक्ता गुरुणाऽऽङ्गिरसेन यत्॥ ६/६/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_006/BhP_06.006.045.m4a", "display_order": 46}, {"id": 6000125046, "chapter_id": 10125, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां षष्ठस्कन्धे षष्ठाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]