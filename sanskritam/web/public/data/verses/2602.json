[{"id": 2075681, "chapter_id": 2602, "verse_number": "१२-१०७-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2075682, "chapter_id": 2602, "verse_number": "१२-१०७-१", "content_sanskrit": "ब्राह्मणक्षत्रियविशां शूद्राणां च परंतप।\nधर्मवृत्तं च वित्तं च वृत्त्युपायाः फलानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2075683, "chapter_id": 2602, "verse_number": "१२-१०७-२", "content_sanskrit": "राज्ञां वृत्तं च कोशं च कोशसंचयनं जयः।\nअमात्यगुणवृत्तिश्च प्रकृतीनां च वर्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2075684, "chapter_id": 2602, "verse_number": "१२-१०७-३", "content_sanskrit": "षाङ्गुण्यगुणकल्पश्च सेनानीतिस्तथैव च।\nदुष्टस्य च परिज्ञानमदुष्टस्य च लक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2075685, "chapter_id": 2602, "verse_number": "१२-१०७-४", "content_sanskrit": "समहीनाधिकानां च यथावल्लक्षणं च यत्।\nमध्यमस्य च तुष्ट्यर्थं यथा स्थेयं विवर्धता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2075686, "chapter_id": 2602, "verse_number": "१२-१०७-५", "content_sanskrit": "क्षीणग्रहणवृत्तिश्च यथा धर्मं प्रकीर्तितम्।\nलघुनाऽदेशरूपेण ग्रन्थयोगेन भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2075687, "chapter_id": 2602, "verse_number": "१२-१०७-६", "content_sanskrit": "विजिगीषोस्तथा वृत्तमुक्तं चैव तथैव ते।\nगणानां वृत्तिमिच्छामि श्रोतुं मतिमतां वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2075688, "chapter_id": 2602, "verse_number": "१२-१०७-७", "content_sanskrit": "यथा गणाः प्रवर्धन्ते न भिद्यन्ते च भारत।\nअरींश्च विजिगीषन्ते सुहृदः प्राप्नुवन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2075689, "chapter_id": 2602, "verse_number": "१२-१०७-८", "content_sanskrit": "भेदमूलो विनाशो हि गणानामुपलक्षये।\nमन्त्रसंवरणं दुःखं बहूनामिति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2075690, "chapter_id": 2602, "verse_number": "१२-१०७-९", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं निखिलेन परंतप।\nयथा च ते न भिद्येरंस्तच्च मे वद भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2075691, "chapter_id": 2602, "verse_number": "१२-१०७-१०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2075692, "chapter_id": 2602, "verse_number": "१२-१०७-१०", "content_sanskrit": "गणानां च कुलानां च राज्ञां भरतसत्तम।\nवैरसंदीपनावेतौ लोभामर्षौ नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2075693, "chapter_id": 2602, "verse_number": "१२-१०७-११", "content_sanskrit": "लोभमेको हि वृणुते ततोऽमर्षमनन्तरम्।\nततो ह्यमर्षसंयुक्तावन्योन्यजनिताशयौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2075694, "chapter_id": 2602, "verse_number": "१२-१०७-१२", "content_sanskrit": "चारमन्त्रबलादानैः सामदानविभेदनैः।\nक्षयव्ययभयोपायैः प्रकर्षन्तीतरेतरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2075695, "chapter_id": 2602, "verse_number": "१२-१०७-१३", "content_sanskrit": "तत्रादानेन भिद्यन्ते गणाः संघातवृत्तयः।\nभिन्ना विमनसः सर्वे गच्छन्त्यरिवशं भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2075696, "chapter_id": 2602, "verse_number": "१२-१०७-१४", "content_sanskrit": "भेदे गणा विनश्युर्हि भिन्नास्तु सुजयाः परैः।\nतस्मात्संघातयोगेन प्रयतेरन्गणाः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2075697, "chapter_id": 2602, "verse_number": "१२-१०७-१५", "content_sanskrit": "अर्थाश्चैवाधिगम्यन्ते संघातबलपौरुषैः।\nब्राह्माश्च मैत्रीं कुर्वन्ति तेषु संघातवृत्तिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2075698, "chapter_id": 2602, "verse_number": "१२-१०७-१६", "content_sanskrit": "ज्ञानवृद्धाः प्रशंसन्ति शुश्रूषन्तः परस्परम्।\nविनिवृत्ताभिसंधानाः सुखमेधन्ति सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2075699, "chapter_id": 2602, "verse_number": "१२-१०७-१७", "content_sanskrit": "धर्मिष्ठान्व्यवहारांश्च स्थापयन्तश्च शास्त्रतः।\nयथावत्प्रतिपश्यन्तो विवर्धन्ते गणोत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2075700, "chapter_id": 2602, "verse_number": "१२-१०७-१८", "content_sanskrit": "पुत्रान्भ्रातृन्निगृह्णन्तो विनयन्तश्च तान्सदा।\nविनीतांश्च प्रगृह्णन्तो विवर्धन्ते गणोत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2075701, "chapter_id": 2602, "verse_number": "१२-१०७-१९", "content_sanskrit": "चारमन्त्रविधानेषु कोशसंनिचयेषु च।\nनित्ययुक्ता महाबाहो वर्धन्ते सर्वतो गणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2075702, "chapter_id": 2602, "verse_number": "१२-१०७-२०", "content_sanskrit": "प्राज्ञांश्चारान्महोत्साहान्कर्मसु स्थिरपौरुषान्।\nमानयन्तः सदा युक्ता विवर्धन्ते गणा नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2075703, "chapter_id": 2602, "verse_number": "१२-१०७-२१", "content_sanskrit": "द्रव्यवन्तश्च शूराश्च शस्त्रज्ञाः शास्त्रपारगाः।\nकृच्छ्रास्वापत्सु संमूढान्गणाः संतारयन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2075704, "chapter_id": 2602, "verse_number": "१२-१०७-२२", "content_sanskrit": "क्रोधो भेदो भयं दण्डः कर्षणं निग्रहो वधः।\nनयत्यरिवशं सद्यो गणान्भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2075705, "chapter_id": 2602, "verse_number": "१२-१०७-२३", "content_sanskrit": "तस्मान्मानयितव्यास्ते गणमुख्याः प्रधानतः।\nलोकयात्रा समायत्ता भूयसी तेषु पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2075706, "chapter_id": 2602, "verse_number": "१२-१०७-२४", "content_sanskrit": "मन्त्रगुप्तिः प्रधानेषु चारश्चामित्रकर्शण।\nन गणाः कृत्स्नशो मन्त्रं श्रोतुमर्हन्ति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2075707, "chapter_id": 2602, "verse_number": "१२-१०७-२५", "content_sanskrit": "गणमुख्यैस्तु संभूय कार्यं गणहितं मिथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2075708, "chapter_id": 2602, "verse_number": "१२-१०७-२६", "content_sanskrit": "पृथग्गणस्य भिन्नस्य विततस्य ततोऽन्यथा।\nअर्थाः प्रत्यवसीदन्ति तथाऽनर्था भवन्ति व॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2075709, "chapter_id": 2602, "verse_number": "१२-१०७-२७", "content_sanskrit": "तेषामन्योन्यभिन्नानां स्वशक्तिमनुतिष्ठताम्।\nनिग्रहः पण्डितैः कार्यः क्षिप्रमेव प्रधानतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2075710, "chapter_id": 2602, "verse_number": "१२-१०७-२८", "content_sanskrit": "कुलेषु कलहा जाताः कुलवृद्धैरुपेक्षिताः।\nगोत्रस्य नाशं कुर्वन्ति गणभेदस्य कारकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2075711, "chapter_id": 2602, "verse_number": "१२-१०७-२९", "content_sanskrit": "आभ्यन्तरं भयं रक्ष्यमसारं बाह्यतो भयम्।\nआभ्यन्तरं भयं राजन्सद्यो मूलानि कृन्तति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2075712, "chapter_id": 2602, "verse_number": "१२-१०७-३०", "content_sanskrit": "अकस्मात्क्रोधमोहाभ्यां लोभाद्वाऽपि स्वभावजात्।\nअन्योन्यं नाभिभाषन्ते तत्पराभवलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2075713, "chapter_id": 2602, "verse_number": "१२-१०७-३१", "content_sanskrit": "जात्या च सदृशाः सर्वे कुलेन सदृशास्तथ।\nन चोद्योगेन बुद्ध्या वा रूपद्रव्येण वा पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2075714, "chapter_id": 2602, "verse_number": "१२-१०७-३२", "content_sanskrit": "भेदाच्चैव प्रदानाच्च नाम्यन्ते रिपुभिर्गणाः।\nतस्मात्संघातमेवाहुर्गणानां शरणं महत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2075715, "chapter_id": 2602, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि सप्ताधिकसततमोऽध्यायः॥ १०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]