[{"id": 2134837, "chapter_id": 3914, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2134838, "chapter_id": 3914, "verse_number": "१", "content_sanskrit": "युधिष्ठिरवचः श्रुत्वा भीमसेनपुरोगमाः ।\nप्रहृष्टवदनाः सर्वे समुत्तस्थुर्नरर्षभाः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2134839, "chapter_id": 3914, "verse_number": "२", "content_sanskrit": "जाम्बूनदविचित्राणि कवचानि महारथाः ।\nअभेद्यानि ततः सर्वे समनह्यन्त भारत \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2134840, "chapter_id": 3914, "verse_number": "३", "content_sanskrit": "आयुधानि च दिव्यानि विविधानि समादधुः ।\nते दंसिता रथैः सर्वे ध्वजिनः सशरासनाः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2134841, "chapter_id": 3914, "verse_number": "४", "content_sanskrit": "पाण्डवाः प्रत्यदृश्यन्त ज्वलिता इव पावकाः ।\nतान् रथान् साधुसम्पन्नान् संयुक्तान् जवनैर्हयैः ।\nआस्थाय रथशार्दूलाः शीघ्रमेव ययुस्ततः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2134842, "chapter_id": 3914, "verse_number": "५", "content_sanskrit": "ततः कौरवसैन्यानां प्रादुरासीन्महास्वनः ।\nप्रयातान् सहितान् दृष्ट्वा पाण्डुपुत्रान् महारथान् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2134843, "chapter_id": 3914, "verse_number": "६", "content_sanskrit": "जितकाशिनश्च चत्वारस्त्वरिताश्च महारथाः ।\nक्षणेनैव वने तस्मिन् समाजग्मुरभीतवत् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2134844, "chapter_id": 3914, "verse_number": "७", "content_sanskrit": "न्यवर्तन्त ततः सर्वे गन्धर्वा जितकाशिनः ।\nदृष्ट्वा रथागतान् वीरान् पाण्डवांश्चतुरो रणे \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2134845, "chapter_id": 3914, "verse_number": "८", "content_sanskrit": "तांस्तु विभ्राजितान् दृष्ट्वा लोकपालानिवोद्यतान् ।\nव्यूढानीका व्यतिष्ठन्त गन्धर्वा वनचारिणः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2134846, "chapter_id": 3914, "verse_number": "९", "content_sanskrit": "राज्ञस्तु वचनं स्मृत्वा धर्मपुत्रस्य धीमतः ।\nक्रमेण मृदुना युद्धमुपक्रान्तं च भारत \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2134847, "chapter_id": 3914, "verse_number": "१०", "content_sanskrit": "न तु गन्धर्वराजस्य सैनिका मन्दचेतसः ।\nशक्यन्ते मृदुना श्रेयः प्रतिपादयितुं तदा \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2134848, "chapter_id": 3914, "verse_number": "११", "content_sanskrit": "ततस्तान् युधि दुर्धर्षान् सव्यसाची परन्तपः ।\nसान्त्वपूर्वमिदं वाक्यमुवाच खचरान् रणे \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2134849, "chapter_id": 3914, "verse_number": "१२", "content_sanskrit": "विसर्जयत राजानं भ्रातरं मे सुयोधनम् ।\nनैतद् गन्धर्वराजस्य युक्तं कर्म जुगुप्सितम् ।\nपरदाराभिमर्शश्च मानुषैश्च समागमः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2134850, "chapter_id": 3914, "verse_number": "१३", "content_sanskrit": "उत्सृजध्वं महावीर्यान् धृतराष्ट्रसुतानिमान् ।\nदारांश्चैषां विमुञ्चध्वं धर्मराजस्य शासनात् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2134851, "chapter_id": 3914, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2134852, "chapter_id": 3914, "verse_number": "१४", "content_sanskrit": "त एवमुक्ता गन्धर्वाः पाण्डवेन यशस्विना ।\nउत्स्मयन्तस्तदा पार्थमिदं वचनमब्रुवन् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2134853, "chapter_id": 3914, "verse_number": "१५", "content_sanskrit": "एकस्यैव वयं तात कुर्याम वचनं भुवि ।\nयस्य शासनमाज्ञाय चरामो विगतज्वराः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2134854, "chapter_id": 3914, "verse_number": "१६", "content_sanskrit": "तेनैकेन यथाऽऽदिष्टं तथा वर्ताम भारत ।\nन शास्ता विद्यतेऽस्माकमन्यस्तस्मात् सुरेश्वरात् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2134855, "chapter_id": 3914, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2134856, "chapter_id": 3914, "verse_number": "१७", "content_sanskrit": "एवमुक्तः स गन्धर्वैः कुन्तीपुत्रो धनञ्जयः ।\nगन्धर्वान् पुनरेवेदं वचनं प्रत्यभाषत \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2134857, "chapter_id": 3914, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2134858, "chapter_id": 3914, "verse_number": "१८", "content_sanskrit": "यदा साम्ना न मुञ्चध्वं गन्धर्वा धृतराष्ट्रजान् ।\nमोक्षयिष्यामि विक्रम्य स्वयमेव सुयोधनम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2134859, "chapter_id": 3914, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2134860, "chapter_id": 3914, "verse_number": "१९", "content_sanskrit": "एवमुक्त्वा ततः पार्थः सव्यसाची धनञ्जयः ।\nससर्ज निशितान् बाणान् खचरान् खचरान् प्रति \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2134861, "chapter_id": 3914, "verse_number": "२०", "content_sanskrit": "तथैव शरवर्षेण गन्धर्वास्ते बलोत्कटाः ।\nपाण्डवानभ्यवर्तन्त पाण्डवाश्च दिवौकसः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2134862, "chapter_id": 3914, "verse_number": "२१", "content_sanskrit": "ततः सुतुमुलं युद्धं गन्धर्वाणां तरस्विनाम् ।\nबभूव भीमवेगानां पाण्डवानां च भारत \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2134863, "chapter_id": 3914, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि घोषयात्रापर्वणि पाण्डवगन्धर्वयुद्धे त्रयस्त्रिंशदधिकद्विशततमोऽध्यायः ॥२३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2134864, "chapter_id": 3914, "verse_number": "", "content_sanskrit": "घोषयात्रापर्वणि नवमोऽध्यायः ॥९॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]