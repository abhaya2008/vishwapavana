[{"id": 50024313, "chapter_id": 11848, "verse_number": "1", "content_sanskrit": "॥ मेधातिथिः काण्वः। इन्द्रावरुणौ। गायत्री, युवाकुहीति द्वृचौ पादनिचृतौ (इन्द्रःसहस्रेति ह्रसीयसी वा)॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024314, "chapter_id": 11848, "verse_number": "2", "content_sanskrit": "इन्द्रा॒वरु॑णयोर॒हं स॒म्राजो॒रव॒ आ वृ॑णे। ता नो॑ मृळात ई॒दृशे॑॥ १७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024315, "chapter_id": 11848, "verse_number": "3", "content_sanskrit": "गन्ता॑रा॒ हि स्थोऽव॑से॒ हवं॒ विप्र॑स्य॒ माव॑तः। ध॒र्तारा॑ चर्षणी॒नाम्॥ १७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024316, "chapter_id": 11848, "verse_number": "4", "content_sanskrit": "अ॒नु॒का॒मं त॑र्पयेथा॒मिन्द्रा॑वरुण रा॒य आ। ता वां॒ नेदि॑ष्ठमीमहे॥ १७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50024317, "chapter_id": 11848, "verse_number": "5", "content_sanskrit": "यु॒वाकु॒ हि शची॑नां यु॒वाकु॑ सुमती॒नाम्। भू॒याम॑ वाज॒दाव्ना॑म्॥ १७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50024318, "chapter_id": 11848, "verse_number": "6", "content_sanskrit": "इन्द्र॑ः सहस्र॒दाव्नां॒ वरु॑ण॒ः शंस्या॑नाम्। क्रतु॑र्भवत्यु॒क्थ्य॑ः॥ १७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50024319, "chapter_id": 11848, "verse_number": "7", "content_sanskrit": "तयो॒रिदव॑सा व॒यं स॒नेम॒ नि च॑ धीमहि। स्यादु॒त प्र॒रेच॑नम्॥ १७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50024320, "chapter_id": 11848, "verse_number": "8", "content_sanskrit": "इन्द्रा॑वरुण वाम॒हं हु॒वे चि॒त्राय॒ राध॑से। अ॒स्मान्सु जि॒ग्युष॑स्कृतम्॥ १७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50024321, "chapter_id": 11848, "verse_number": "9", "content_sanskrit": "इन्द्रा॑वरुण॒ नू नु वां॒ सिषा॑सन्तीषु धी॒ष्वा। अ॒स्मभ्यं॒ शर्म॑ यच्छतम्॥ १७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50024322, "chapter_id": 11848, "verse_number": "10", "content_sanskrit": "प्र वा॑मश्नोतु सुष्टु॒तिरिन्द्रा॑वरुण॒ यां हु॒वे। यामृ॒धाथे॑ स॒धस्तु॑तिम्॥ १७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]