[{"id": 2037720, "chapter_id": 1815, "verse_number": "५-६०-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2037721, "chapter_id": 1815, "verse_number": "५-६०-१", "content_sanskrit": "सञ्जयस्य वचः श्रुत्वा प्रज्ञाचक्षुर्जनेश्वरः।\nततः सङ्ख्यातुमारेभे तद्वचो गुणदोषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2037722, "chapter_id": 1815, "verse_number": "५-६०-२", "content_sanskrit": "प्रसङ्ख्याय च सौक्ष्म्येण गुणदोषान्विचक्षणः।\nयथावन्मतितत्त्वेन जयकामः सुतान्प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2037723, "chapter_id": 1815, "verse_number": "५-६०-३", "content_sanskrit": "बलाबलं विनिश्चित्य याथातथ्येन बुद्धिमान्।\n`यदा तु मेने भूयिष्ठं तद्वचो गुणदोषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2037724, "chapter_id": 1815, "verse_number": "५-६०-४", "content_sanskrit": "पुनरेव कुरूणां च पाण्डवानां च बुद्धिमान् ।\nशक्तिं शङ्ख्यातुमारेभे तदा वै मनुजाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2037725, "chapter_id": 1815, "verse_number": "५-६०-५", "content_sanskrit": "देवमानुषयोः शक्त्या तेजसा चैव पाण्डवान्।\nकुरूञ्शक्त्याऽल्पतरया दुर्योधनमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2037726, "chapter_id": 1815, "verse_number": "५-६०-६", "content_sanskrit": "दुर्योधनेयं चिन्ता मे शश्वन्न व्युपशाम्यति।\nसत्यं ह्येतदहं मन्ये प्रत्यक्षं नानुमानतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2037727, "chapter_id": 1815, "verse_number": "५-६०-७", "content_sanskrit": "आत्मजेषु परं स्नेहं सर्वभातिनि कुर्वते।\nप्रियामि चैषां कुर्वन्ति यथाशक्ति हितानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2037728, "chapter_id": 1815, "verse_number": "५-६०-८", "content_sanskrit": "एवमेवोपकर्तॄणां प्रायशो लक्षयामहे।\nइच्छन्ति बहुलं सन्तः प्रतिकर्तुं महत्प्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2037729, "chapter_id": 1815, "verse_number": "५-६०-९", "content_sanskrit": "अग्निः साचिव्यर्ता स्यात्खाण्डवे तत्कृतं स्मरन् ।\nअर्जुनस्यापि भीमेऽस्मिन्कुरुपाण्डुसमागमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2037730, "chapter_id": 1815, "verse_number": "५-६०-१०", "content_sanskrit": "जातिगृद्ध्याऽभिपन्नाश्च पाण़्डवानामनेकशः।\nधर्मादयः समेष्यन्ति समाहूता दिवौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2037731, "chapter_id": 1815, "verse_number": "५-६०-११", "content_sanskrit": "भीष्मद्रोणकृपादीनां भयादशनिसन्निभम् ।\nरिरक्षिषन्तः संरभ्यं गमिष्यन्तीति मे मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2037732, "chapter_id": 1815, "verse_number": "५-६०-१२", "content_sanskrit": "ते देवैः सहिताः पार्था न शक्याः प्रतिवीक्षितुम् ।\nमानुषेण नरव्याघ्रा वीर्यवन्तोऽस्त्रपारगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2037733, "chapter_id": 1815, "verse_number": "५-६०-१३", "content_sanskrit": "दुरासदं यस्य दिव्यं गाण्डीवं धनुरुत्तमम् ।\nवारुणौ चाक्षयौ दिव्यौ शरपूर्णौ महेषुधी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2037734, "chapter_id": 1815, "verse_number": "५-६०-१४", "content_sanskrit": "वानरश्च ध्वजे दिव्यो निःसङ्गे धूमवद्गतिः ।\nरथश्च चतुरन्तायां यस्य नास्ति समः क्षितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2037735, "chapter_id": 1815, "verse_number": "५-६०-१५", "content_sanskrit": "महामेघनिभश्चापि निर्घोषः श्रूयते जनैः ।\nमहाशनिसमः शब्दःत शात्रवाणां भयंकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2037736, "chapter_id": 1815, "verse_number": "५-६०-१६", "content_sanskrit": "यं चातिमानुषं वीर्ये कृत्स्नो लोको व्यवस्यति।\nदेवानामपि जेतारं यं विदुः पार्थिवा रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2037737, "chapter_id": 1815, "verse_number": "५-६०-१७", "content_sanskrit": "शतानि पञ्च चैवेषून्यो गृह्णन्नैव दृश्यते।\nनिमेषान्तरमात्रेण मुञ्चन्दूरं च पातयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2037738, "chapter_id": 1815, "verse_number": "५-६०-१८", "content_sanskrit": "यमाह भीष्मो द्रोणश्च कृपो द्रौणिस्तथैव च ।\nमद्रराजस्तथा शल्यो मध्यस्था ये च मानवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2037739, "chapter_id": 1815, "verse_number": "५-६०-१९", "content_sanskrit": "युद्धायावस्थितं पार्थं पार्थिवैरतिमानुषैः ।\nअशक्यं रथशार्दूलं पराजेतुमरिंदमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2037740, "chapter_id": 1815, "verse_number": "५-६०-२०", "content_sanskrit": "क्षिपत्येकेन वेगेन पञ्चबाणशतानि यः।\nसदृशं बाहुवीर्येण कार्तवीर्यस्य पाण्डवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2037741, "chapter_id": 1815, "verse_number": "५-६०-२१", "content_sanskrit": "तमर्जुनं महेष्वासं महेन्द्रोपेन्द्रविक्रमम्।\nनिघ्नन्तमिव पश्याभि विमर्देऽस्मिन्महाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2037742, "chapter_id": 1815, "verse_number": "५-६०-२२", "content_sanskrit": "इत्येवं चिन्तयन्कृत्स्नमहोरात्राणि भारत ।\nअनिद्रो निःसुखश्चास्मि कुरूणां शमचिन्तया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2037743, "chapter_id": 1815, "verse_number": "५-६०-२३", "content_sanskrit": "क्षयोदयोऽयं सुमहान्कुरूणां प्रत्युपस्थितः।\nअस्य चेत्कलहन्यान्तः शमादन्यो न विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2037744, "chapter_id": 1815, "verse_number": "५-६०-२४", "content_sanskrit": "शमो मे रोचते नित्यं पार्थैस्तात न विग्रहः ।\nकुरुभ्यो हि सदा मन्ये पाण्डवाञ्शक्तिमत्तरान् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2037745, "chapter_id": 1815, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि यानसन्धिपर्वणि षष्टितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]