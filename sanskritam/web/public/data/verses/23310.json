[{"id": 7003310000, "chapter_id": 23310, "verse_number": "२-५-१", "content_sanskrit": "ऋषय ऊचुः    ।\nऐक्ष्वाकुरंबरीषो वै वासुदेवपरायणः ।\nपालयामास पृथिवीं विष्णोराज्ञापुरः सरः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003310001, "chapter_id": 23310, "verse_number": "२-५-२", "content_sanskrit": "श्रुतमेतन्महाबुद्धे तत्सर्वं वक्तुमर्हसि ।\nनित्यं तस्य हरेश्चक्रं शत्रुरोगभयादिकम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003310002, "chapter_id": 23310, "verse_number": "२-५-३", "content_sanskrit": "हंतीति श्रूयते लोके धार्मिकस्य महात्मनः ।\nअंबरीषस्य चरितं तत्सर्वं ब्रूहि सत्तम ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003310003, "chapter_id": 23310, "verse_number": "२-५-४", "content_sanskrit": "माहात्म्यमनुभावं च भक्तियोगमनुत्तमम् ।\nयथावच्छ्रोतुमिच्छामः सूत वक्तुं त्वमर्हसि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003310004, "chapter_id": 23310, "verse_number": "२-५-५", "content_sanskrit": "सूत उवाच  ।\nश्रूयतां मुनिशार्दूलाश्चरितं तस्य धीमतः ।\nअंबरीषस्य माहात्म्यं सर्वपापहरं परम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003310005, "chapter_id": 23310, "verse_number": "२-५-६", "content_sanskrit": "त्रिशंकोर्दयिता भार्या सर्वलक्षणशोभिता ।\nअंबरीषस्य जननी नित्यं शौचसमन्विता ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003310006, "chapter_id": 23310, "verse_number": "२-५-७", "content_sanskrit": "योगनिद्रासमारूढं शेषपर्यंकशायिनम् ।\nनारायणं महात्मानं ब्रह्मांडकमलोद्भवम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003310007, "chapter_id": 23310, "verse_number": "२-५-८", "content_sanskrit": "तमसा कालरुद्राख्यं रजसा कनकांडजम् ।\nसत्त्वेन सर्वगं विष्णुं सर्वदेवनमस्कृतम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003310008, "chapter_id": 23310, "verse_number": "२-५-९", "content_sanskrit": "अर्चयामाम सततं वाङ्मनः कायकर्मभिः ।\nमाल्यदानादिकं सर्वं स्वयमेवमचीकरत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003310009, "chapter_id": 23310, "verse_number": "२-५-१०", "content_sanskrit": "गंधादिषेषणं चैव धूपद्रव्यादिकं तथा ।\nभूमेरालेपनादीनि हविषां पचनं तथा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003310010, "chapter_id": 23310, "verse_number": "२-५-११", "content_sanskrit": "तत्कौतुकसमाविष्टा स्वयमेव चकार सा ।\nशुभा पद्मावती नित्यं वाचा नारायणेति वै ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003310011, "chapter_id": 23310, "verse_number": "२-५-१२", "content_sanskrit": "अनंतेत्येव सा नित्यं भाषमाणा पतिव्रता ।\nदशवर्षसहस्राणि तत्परेणांतरात्मना ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003310012, "chapter_id": 23310, "verse_number": "२-५-१३", "content_sanskrit": "अर्चयामास गोविंदं गंधपुष्पादिभिः शुचिः ।\nविष्णुभक्तान्महाभागान् सर्वपापविवर्जितान् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003310013, "chapter_id": 23310, "verse_number": "२-५-१४", "content_sanskrit": "दानमानार्चनैर्नित्यं धनरत्नैरतोषयत् ।\nततः कदाचित्सा देवी द्वादशीं समुपोष्य वै ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003310014, "chapter_id": 23310, "verse_number": "२-५-१५", "content_sanskrit": "हरेरग्रे महाभागा सुष्वाप पतिना सह ।\nतत्र नारायणो देवस्तामाह पुरुषोत्तमः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003310015, "chapter_id": 23310, "verse_number": "२-५-१६", "content_sanskrit": "किमिच्छसि वरं भद्रे मत्तस्त्वम ब्रूहि भामिनि ।\nसा दृष्ट्वा तु वरं वव्रे पुत्रो मे वैष्णवो भवेत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003310016, "chapter_id": 23310, "verse_number": "२-५-१७", "content_sanskrit": "सार्वभौमो महातेजाः स्वकर्मनिरतः शुचिः ।\nतथेत्युक्तवा ददौ तस्यै फलमेकं जनार्दनः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003310017, "chapter_id": 23310, "verse_number": "२-५-१८", "content_sanskrit": "सा प्रबुद्धा फलं दृष्ट्वा भर्त्रे सर्वं न्यवेदयत् ।\nभक्षयामास संहृष्टा फलं तद्गतमानसा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003310018, "chapter_id": 23310, "verse_number": "२-५-१९", "content_sanskrit": "ततः कालेन सा देवी पुत्रं कुलविवर्धनम् ।\nअसूत सा सदाचारं वासुदेवपरायणम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003310019, "chapter_id": 23310, "verse_number": "२-५-२०", "content_sanskrit": "शुभलक्षणसंपन्नं चक्रांकिततनूरुहम् ।\nजातं दृष्ट्वा पिता पुत्रं क्रियाः सर्वाश्चकार वै ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003310020, "chapter_id": 23310, "verse_number": "२-५-२१", "content_sanskrit": "अंबरीष इति ख्यातो लोके समभवत्प्रभुः ।\nपितर्युपरते श्रीमानभिषिक्तो महामुनिः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003310021, "chapter_id": 23310, "verse_number": "२-५-२२", "content_sanskrit": "मंत्रिष्वाधाय राज्यं च तप उग्रंचकार सः ।\nसंवत्सरसहस्रं वै जपन्नारायणं प्रभुम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003310022, "chapter_id": 23310, "verse_number": "२-५-२३", "content_sanskrit": "हृत्पुंडरीकमध्यस्थं सूर्यमंडलमध्यतः ।\nशंखचक्रगदापद्मधारयंतं चतुर्भुजम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003310023, "chapter_id": 23310, "verse_number": "२-५-२४", "content_sanskrit": "शुद्धजांबूनदनिभं ब्रह्मविष्णुशिवात्मकम् ।\nसर्वाभरणसंयुक्तं पीतांबरधरं प्रभुम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003310024, "chapter_id": 23310, "verse_number": "२-५-२५", "content_sanskrit": "श्रीवत्सवक्षसं देवं पुरुषं पुरुषोत्तमम् ।\nततो गरुडमारुह्य सर्वदेवैरभिष्टुतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003310025, "chapter_id": 23310, "verse_number": "२-५-२६", "content_sanskrit": "आजगाम स विश्वात्मा सर्वलोकनमस्कृतः ।\nऐरावतमिवाचिंत्यं कृत्वा वै गरुडंहरिः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003310026, "chapter_id": 23310, "verse_number": "२-५-२७", "content_sanskrit": "स्वयं शक्र इवासीनस्तमाह नृपसत्तमम् ।\nइंद्रोऽहमस्मि भद्रं ते किं ददामि वरं च ते ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003310027, "chapter_id": 23310, "verse_number": "२-५-२८", "content_sanskrit": "सर्वलोकेश्वरोऽहं त्वांरक्षितुं समुपागतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003310028, "chapter_id": 23310, "verse_number": "२-५-२९", "content_sanskrit": "अंबरीष उवाच  ।\nनाहं त्वमाभिसंधाय तप आस्थितवानिह ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003310029, "chapter_id": 23310, "verse_number": "२-५-३०", "content_sanskrit": "त्वया दत्तं च नेष्यामि गच्छ शक्र यथासुखम् ।\nमम नारायणो नाथस्तं नामामि जगत्पतिम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003310030, "chapter_id": 23310, "verse_number": "२-५-३१", "content_sanskrit": "गच्छेद्र माकृथास्त्वत्र मम बुद्धिविलोपनम् ।\nततः प्रहस्य भगवान् स्वरूपमकरोद्वरीः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003310031, "chapter_id": 23310, "verse_number": "२-५-३२", "content_sanskrit": "शार्ङ्गचक्रगदापाणिः खङ्गहस्तो जनार्दनः ।\nगरुडोपरि सर्वात्मा नीलाचल इवापरः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003310032, "chapter_id": 23310, "verse_number": "२-५-३३", "content_sanskrit": "देवगंधर्वसंघैश्च स्तूयमानः समंततः ।\nप्रणम्य स च संतुष्टस्तुष्टाव गरुडध्वजम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003310033, "chapter_id": 23310, "verse_number": "२-५-३४", "content_sanskrit": "प्रसीद लोकनाथेश मम नाथ जनार्दन ।\nकृष्ण विष्णो जगन्नाथ सर्वलोकनमस्कृत ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003310034, "chapter_id": 23310, "verse_number": "२-५-३५", "content_sanskrit": "त्वमादिस्त्वमनादिस्त्वमनंतः पूरुषः प्रभुः ।\nअप्रमेयो विभुर्विष्णुर्गोविंदः कमलेक्षणः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003310035, "chapter_id": 23310, "verse_number": "२-५-३६", "content_sanskrit": "महेश्वरांगजो मध्ये पुष्करः खगमः खगः ।\nकव्यवाहः कपाली त्वं हव्यवाहः प्रभंजनः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003310036, "chapter_id": 23310, "verse_number": "२-५-३७", "content_sanskrit": "आदिदेवः क्रियानंदः परमात्मात्मनी स्थितः  ।\nत्वां प्रपन्नोस्मिगोविंद जय देवकिनंदन ।\nजय देव जगन्नाथ पाहि मां पुष्करेक्षण ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003310037, "chapter_id": 23310, "verse_number": "२-५-३८", "content_sanskrit": "नान्या गतिस्त्वदन्या मे त्वमेव शरणं मम  ।\nसूत उवाच  ।\nतमाह भगवान्विष्णुः किं ते हृदि चिकीर्षितम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003310038, "chapter_id": 23310, "verse_number": "२-५-३९", "content_sanskrit": "तत्सर्वं ते प्रदास्यामि भक्तोसि मम सुव्रत ।\nभक्तिप्रियोऽहं सततं तस्माद्दातुमिहागतः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003310039, "chapter_id": 23310, "verse_number": "२-५-४०", "content_sanskrit": "अंबरीष उवाच  ।\nलोकनाथ परानंद नित्यं मे वर्तते मतिः ।\nवासुदेवपरो नित्यं वाङ्मनः कायकर्मभिः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003310040, "chapter_id": 23310, "verse_number": "२-५-४१", "content_sanskrit": "यथा त्वं देवदेवस्य भवस्य परमात्मनः ।\nतथा भवाम्यहं विष्णो तव देव जनार्दन ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003310041, "chapter_id": 23310, "verse_number": "२-५-४२", "content_sanskrit": "पालियिष्यामि पृथिवीं कृत्वा वै वैष्णवं जगत् ।\nयज्ञहोमार्चनैश्चैव तर्पयामि सुरोत्तमान् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003310042, "chapter_id": 23310, "verse_number": "२-५-४३", "content_sanskrit": "वैष्णवान्पालयिष्यामि निहनिष्यामि शात्रवान् ।\nलोकतापभये भीत इति मे धीयते मतिः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003310043, "chapter_id": 23310, "verse_number": "२-५-४४", "content_sanskrit": "श्रीभगवानुवाच  ।\nएवमस्तु यथेच्छं वै चक्रमेतत्सुदर्शनम् ।\nपुरा रुद्रप्रसादेन लब्धं वै दुर्लभं मया ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003310044, "chapter_id": 23310, "verse_number": "२-५-४५", "content_sanskrit": "ऋषिशापादिकं दुःखं शत्रुरोगादिकं तथा ।\nनिहनिष्यति ते नित्यमित्युक्त्वांतरधीयत ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003310045, "chapter_id": 23310, "verse_number": "२-५-४६", "content_sanskrit": "सूत उवाच  ।\nततः प्रणम्य मुदितो राजा नारायणं प्रभुम् ।\nप्रविश्य नगरीं रम्यामयोध्यां पर्यपालयत् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003310046, "chapter_id": 23310, "verse_number": "२-५-४७", "content_sanskrit": "ब्राह्मणादींश्च वर्णांश्च स्वस्वकर्मण्ययोजत् ।\nनारायणपरो नित्यं विष्णुभक्तानकल्मषान् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003310047, "chapter_id": 23310, "verse_number": "२-५-४८", "content_sanskrit": "पालयामास हृष्टात्मा विशेषेण जनाधिपः ।\nअश्वमेधशतैरिष्ट्वा वाजपेयशतेन च ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003310048, "chapter_id": 23310, "verse_number": "२-५-४९", "content_sanskrit": "पालयामास पृथिवीं सागरावरणामिमाम् ।\nगृहेगृहे हरिस्तस्थौ वेदघोषो गृहेगृहे ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003310049, "chapter_id": 23310, "verse_number": "२-५-५०", "content_sanskrit": "नामघोषो हरेश्चैव यज्ञघोषस्तथैव च ।\nअभवन्नृपशार्दूले तस्मिन् राज्यं प्रशासति ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003310050, "chapter_id": 23310, "verse_number": "२-५-५१", "content_sanskrit": "नासस्या नातृणा भूमिर्न दुर्भिक्षादिभिर्युता ।\nरागहीनाः प्रजा नित्यं सर्वोपद्रववर्जिताः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003310051, "chapter_id": 23310, "verse_number": "२-५-५२", "content_sanskrit": "अंबरीषो महातेजाः पालयामास मेदिनीम् ।\nतस्यैवंवर्तमानस्य कन्या कमललोचना ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003310052, "chapter_id": 23310, "verse_number": "२-५-५३", "content_sanskrit": "श्रीमती नाम विख्याता सर्वलक्षणसंयुता  ।\nप्रदानसमयं प्राप्ता देवमायेव शोभना ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003310053, "chapter_id": 23310, "verse_number": "२-५-५४", "content_sanskrit": "तस्मिन्काले मुनिः श्रीमान्नारदोऽभ्यागतश्चवै ।\nअंबरीषस्य राज्ञो वै पर्वतश्च महामतिः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003310054, "chapter_id": 23310, "verse_number": "२-५-५५", "content_sanskrit": "तावुभावागतौ दृष्ट्वा प्रणिपत्य यथाविधि ।\nअंबरीषो महातेजाः पूजयामास तावृषी ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003310055, "chapter_id": 23310, "verse_number": "२-५-५६", "content_sanskrit": "कन्यां तां रममाणां वै मेघमध्ये शतह्रदाम् ।\nप्राह तां प्रेक्ष्य गवान्नारदः सस्मितस्तदा ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003310056, "chapter_id": 23310, "verse_number": "२-५-५७", "content_sanskrit": "केयं राजन्महाभागा कन्या सुरसुतोपमा ।\nब्रूहि धर्मभृतां श्रेष्ठ सर्वलक्षणशोभिता ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003310057, "chapter_id": 23310, "verse_number": "२-५-५८", "content_sanskrit": "राजोवाच  ।\nदुहितेयं मम विभो श्रीमती नाम नामतः ।\nप्रदानसमयं प्राप्ता वरमन्वेषते शुभा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003310058, "chapter_id": 23310, "verse_number": "२-५-५९", "content_sanskrit": "इत्युक्तो मुनिशार्दूलस्तामैच्छन्नारदो द्विजाः ।\nपर्वतोपि मुनिस्तां वै चकमे मुनिसत्तमाः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003310059, "chapter_id": 23310, "verse_number": "२-५-६०", "content_sanskrit": "अनुज्ञाप्य च राजानं नारदो वाक्यमब्रवीत् ।\nरहस्याहूय धर्मात्मामम देहि सुतामिमाम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003310060, "chapter_id": 23310, "verse_number": "२-५-६१", "content_sanskrit": "पर्वतो हि तथा प्राह राजानं रहसि प्रभुः ।\nतावुभौ सह धर्मात्मा प्रणिपत्य भयार्दितः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003310061, "chapter_id": 23310, "verse_number": "२-५-६२", "content_sanskrit": "उभौ भवंतौ कन्यां मे पार्थयानौ कथं त्वहम् ।\nकरिष्यामि महाप्राज्ञ श्रृणु नारद मे वचः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003310062, "chapter_id": 23310, "verse_number": "२-५-६३", "content_sanskrit": "त्वं च पर्वत मे वाक्यं श्रृणु वक्ष्यामि यत्प्रभो ।\nक्न्येयं युवयोरेकं वरयिष्यति चेच्छुभा ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003310063, "chapter_id": 23310, "verse_number": "२-५-६४", "content_sanskrit": "तस्मै कन्यां प्रयच्छामि नान्यथा शक्तिरस्ति मे ।\nतथेत्युक्त्वा ततो भूयः श्वो यास्याव इति स्म ह ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003310064, "chapter_id": 23310, "verse_number": "२-५-६५", "content_sanskrit": "इत्युक्त्वा मुनिसार्दूलौ जग्मतुः प्रीतिमानसौ ।\nवासुदेवपरौ नित्यमुभौ ज्ञानविदांवरौ ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003310065, "chapter_id": 23310, "verse_number": "२-५-६६", "content_sanskrit": "विष्णु लोकं ततो गत्वा नारदो मुनिसत्तमः ।\nप्रणिपत्य हृषीकेशं वाक्यमेतदुवाच  ।\n॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003310066, "chapter_id": 23310, "verse_number": "२-५-६७", "content_sanskrit": "श्रोतव्यमस्ति भगवन्नाथ नारायण प्रभो ।\nरहसि त्वां प्रवक्ष्यामि नमस्ते भुवनेश्वर ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003310067, "chapter_id": 23310, "verse_number": "२-५-६८", "content_sanskrit": "ततः प्रहस्य गोविंदः सर्वानुत्सार्य तं मुनिम् ।\nब्रूहीत्याह च विश्वात्मा मुनिराह च केशवम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003310068, "chapter_id": 23310, "verse_number": "२-५-६९", "content_sanskrit": "त्वदीयो नृपतिः श्रीमानंबरीषो महीपतिः ।\nतस्य कन्या विशालाक्षी श्रीमती नाम नामतः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003310069, "chapter_id": 23310, "verse_number": "२-५-७०", "content_sanskrit": "परिणेतुमनास्तत्र गतोऽस्मि वचनं श्रृणु ।\nपर्वतोऽयं मुनिः श्रीमांस्तव भृत्यस्तपोनिधिः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003310070, "chapter_id": 23310, "verse_number": "२-५-७१", "content_sanskrit": "तामैच्छत्सोपि भगवन्नावामाह जनाधिपः ।\nअंबरीषो महातेजाः कन्येयं युवयोर्वरम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003310071, "chapter_id": 23310, "verse_number": "२-५-७२", "content_sanskrit": "लावण्ययुक्तं वृणुयाद्यदि तस्मै ददाम्यहम्।। इत्याहावां नृपस्तत्र तथेत्युक्त्वाहमागतः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003310072, "chapter_id": 23310, "verse_number": "२-५-७३", "content_sanskrit": "आगमिष्यामि ते राजन् श्वः प्रभाते गृहं त्विति ।\nआगतोहं जगन्नाथ कर्तुमर्हसि मे प्रियम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003310073, "chapter_id": 23310, "verse_number": "२-५-७४", "content_sanskrit": "वानराननवद्भाति पर्वतस्य मुखं यथा ।\nतथा कुरु जगन्नाथ मम चेदिच्छसि प्रियम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003310074, "chapter_id": 23310, "verse_number": "२-५-७५", "content_sanskrit": "तथेत्युक्त्वा स गोविंदः प्रहस्त मधुसूदनः ।\nत्वयोक्तं च करिष्यामि गच्छ सौम्य यथागतम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003310075, "chapter_id": 23310, "verse_number": "२-५-७६", "content_sanskrit": "एवमुक्त्वा मुनिर्हृष्टः प्रणिपत्य जनार्दनम् ।\nमन्यमानः कृतात्मानं तथाऽयोध्यां जगाम सः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003310076, "chapter_id": 23310, "verse_number": "२-५-७७", "content_sanskrit": "गते मुनिवरे तस्मिन्पर्वतोऽपि महामुनिः ।\nप्रणम्य माधवं हृष्टो रहस्येनमुवाच  ।\n॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003310077, "chapter_id": 23310, "verse_number": "२-५-७८", "content_sanskrit": "वृत्तं तस्य निवेद्याग्रे नारदस्य जगत्पतेः ।\nगोलांगूलमुखं यद्वन्मुखं भाति तथा कुरु ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003310078, "chapter_id": 23310, "verse_number": "२-५-७९", "content_sanskrit": "तच्छ्रुत्वा भगवान्विष्णुस्त्वयोक्तं च करोमि वै ।\nगच्छ शीघ्रमयोध्यां वै मावेदीर्नारदस्य वै ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003310079, "chapter_id": 23310, "verse_number": "२-५-८०", "content_sanskrit": "त्वया मे संविदं तत्र तथेत्युक्त्वा जगाम सः ।\nततो राजा समाज्ञाय प्राप्तौ मुनिवरौ तदा ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003310080, "chapter_id": 23310, "verse_number": "२-५-८१", "content_sanskrit": "मांगल्यैर्विविधैः सर्वामयोध्यां ध्वजमालिनीम् ।\nमडंयामास पुष्पैश्च लाजैर्श्चैव समंततः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003310081, "chapter_id": 23310, "verse_number": "२-५-८२", "content_sanskrit": "अंबुसिक्तगृहद्वारां सिक्तापणमहापथाम् ।\nदिव्यगंधरसोपेतां धूपितां दिव्यधूपकैः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003310082, "chapter_id": 23310, "verse_number": "२-५-८३", "content_sanskrit": "कृत्वा च नगरीं राजा मंडयामास तां सभाम् ।\nदिव्यैर्गंधैस्तथा धूपै रत्नैश्च विविधैस्तथा ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003310083, "chapter_id": 23310, "verse_number": "२-५-८४", "content_sanskrit": "अलंकृतां मणिस्तंभैर्नानामाल्योपशोभिताम् ।\nपरार्ध्यास्तरणोपेतैर्दिव्यैर्भद्रासनैर्वृताम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003310084, "chapter_id": 23310, "verse_number": "२-५-८५", "content_sanskrit": "कृत्वा नृपेंद्रस्तां कन्यां ह्यादाय प्रविवेश ह ।\nसर्वाभरणसंपन्नां श्रीरिवायतलोजनाम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003310085, "chapter_id": 23310, "verse_number": "२-५-८६", "content_sanskrit": "करसंमितमध्यांगीं पंचस्निग्धां शुभाननाम् ।\nस्त्रीभिः परिवृतां दिव्यां श्रीमतीं संश्रितां तदा ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003310086, "chapter_id": 23310, "verse_number": "२-५-८७", "content_sanskrit": "सभा च सा भूपपेः समृद्धा मणिप्रवेकोत्तमरत्नचित्रा ।\nन्यस्ता सना माल्यवती सुबद्धा तामाययुस्ते नरराजवर्गाः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003310087, "chapter_id": 23310, "verse_number": "२-५-८८", "content_sanskrit": "अथापरो ब्रह्मवरात्मजो हि त्रैविद्यविद्यो भगवान्महात्मा ।\nसपर्वतो ब्रह्मविदांव रिष्ठो महामुनिर्नारद आजगाम ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003310088, "chapter_id": 23310, "verse_number": "२-५-८९", "content_sanskrit": "तावगतौ समीक्ष्याथ राजा संभ्रांतमानसः ।\nदिव्यमासनामादाय पूजयामास तावुभौ ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003310089, "chapter_id": 23310, "verse_number": "२-५-९०", "content_sanskrit": "उभौ देवर्षिसिद्धौ ज्ञानविदां वरौ ।\nसमासीनौ महात्मानौ कन्यार्थं मुनिसत्त्मौ ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003310090, "chapter_id": 23310, "verse_number": "२-५-९१", "content_sanskrit": "तावुभौ प्रणिपत्याग्रे कन्यां तां श्रीमतीं शुभाम् ।\nसुतां कमलपत्राक्षीं प्राह राजा यशस्विनीम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003310091, "chapter_id": 23310, "verse_number": "२-५-९२", "content_sanskrit": "अनयोर्यं वरं भद्रे मनसा त्मविहेच्छसि ।\nतस्मै मालामिमांदेहि प्रणिपत्य यथाविधि ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003310092, "chapter_id": 23310, "verse_number": "२-५-९३", "content_sanskrit": "एवमुक्ता तु सा कन्या स्त्रीभिः परिवृता तदा ।\nमालां हिरण्मयीं दिव्यामादाय सुभलोचना ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003310093, "chapter_id": 23310, "verse_number": "२-५-९४", "content_sanskrit": "यत्रासीनौ महात्मानौ तत्रागम्यस्थिता तदा ।\nवीक्षमाणा मुनिश्रेष्ठौ नारदं पर्वतं तथा ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003310094, "chapter_id": 23310, "verse_number": "२-५-९५", "content_sanskrit": "मुनिश्रेष्ठं न पश्यामि नारदं पर्वतं तथा ।\nअनयोर्मध्यतस्त्वेकमूनषोडशवार्षिकम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003310095, "chapter_id": 23310, "verse_number": "२-५-९६", "content_sanskrit": "संभ्रांतमानसा तत्र प्रवातकदली यथा ।\nतस्थौ तामहा राजासौ वत्से किं त्वं करिष्यसि ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003310096, "chapter_id": 23310, "verse_number": "२-५-९७", "content_sanskrit": "अनयोरेक मुद्दिश्य देहि मालामिमां शुभे ।\nसा प्राह पितरं त्रस्ता इमौ तौ नरवानरौ ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003310097, "chapter_id": 23310, "verse_number": "२-५-९८", "content_sanskrit": "मुनिश्रेष्ठं न पश्यामि नारदं पर्वतं तथा ।\nअनयोर्मध्यतस्त्वेकमूनषोडशवार्षिकम् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003310098, "chapter_id": 23310, "verse_number": "२-५-९९", "content_sanskrit": "सर्वाभरणसंपन्नमतसीपुष्पसंनिभम् ।\nदीर्घबाहुं विशालाक्षं तुंगोरस्थमुत्तमम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003310099, "chapter_id": 23310, "verse_number": "२-५-१००", "content_sanskrit": "रेखांकितकटिग्रीवं रक्तांतायलोचनम् ।\nनम्रचापानुकरणपटुभ्रूयुगशोभितम् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003310100, "chapter_id": 23310, "verse_number": "२-५-१०१", "content_sanskrit": "विभक्तत्रिवलीव्यक्तं नाभिव्यक्तशुभोदरम्  ।\nहिरण्यांबरसंवीतं तुंगरत्ननखं शुभम्।। पद्माकारकरं त्वेनं पद्मास्यं पद्मलोचनम् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003310101, "chapter_id": 23310, "verse_number": "२-५-१०२", "content_sanskrit": "सुनासं पद्महृदयं पद्मनाभं श्रिया वृतम् ।\nदंतपंक्तिभिरत्यर्थं कुंदकुड्मलसन्निभैः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003310102, "chapter_id": 23310, "verse_number": "२-५-१०३", "content_sanskrit": "हसंतं मां समालोक्य दक्षिणं च प्रसार्य वै ।\nपाणिं स्थितममुं तत्र पश्यामि शुभमूर्धजम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003310103, "chapter_id": 23310, "verse_number": "२-५-१०४", "content_sanskrit": "संभ्रांतमानसां तत्र वेपतीं कदलीमिव ।\nस्थितां तामाह राजासौ वत्से किं त्वं करिष्यसि ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003310104, "chapter_id": 23310, "verse_number": "२-५-१०५", "content_sanskrit": "एवमुक्ते मुनिः प्राह नारदः संशयंगतः ।\nकियन्तो बाहवस्तस्य कन्ये ब्रूहि यथातथम् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003310105, "chapter_id": 23310, "verse_number": "२-५-१०६", "content_sanskrit": "बाहुद्वयं च पश्यामीत्याह कन्या शुचिस्मिता ।\nप्राह तां पर्वतस्तत्र तस्य वक्षःस्थले शुभे ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003310106, "chapter_id": 23310, "verse_number": "२-५-१०७", "content_sanskrit": "किं पश्यसि च मे ब्रूहि करे किं वास्य पश्यसि ।\nकन्या तमाह मालां वै पंचरूपामनुत्तमाम् ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003310107, "chapter_id": 23310, "verse_number": "२-५-१०८", "content_sanskrit": "वक्षःस्थलेऽस्य पश्यामि करे कार्मुकसायकान् ।\nएवमुक्तौ मुनिश्रेष्ठौ परस्परमनुत्तमौ ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003310108, "chapter_id": 23310, "verse_number": "२-५-१०९", "content_sanskrit": "मनसा चिंतयंतौ मायेयं कस्य चिद्भवेत् ।\nमायावी तस्करो नूनं स्वयमेव जनार्दनः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003310109, "chapter_id": 23310, "verse_number": "२-५-११०", "content_sanskrit": "आगतो न यता कुर्यात्कथमस्मन्मुखं त्विदम् ।\nगोलांगूलत्वमित्येवं चिंतया मास नारदः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003310110, "chapter_id": 23310, "verse_number": "२-५-१११", "content_sanskrit": "पर्वतोपि यथान्यायं वानरत्वं कथं मम ।\nप्राप्तमित्येव मनसा चिंतामापेदिवांस्तथा ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003310111, "chapter_id": 23310, "verse_number": "२-५-११२", "content_sanskrit": "ततो राजा प्रणम्यासौ नारदं पर्वतं तथा ।\nभवद्भ्यां किमिदं तत्र कृतं बुद्धिविमोहजम् ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003310112, "chapter_id": 23310, "verse_number": "२-५-११३", "content_sanskrit": "स्वस्थौ भवंतौ तिष्ठेतां यथा कन्यार्थ मुद्यतौ ।\nएवमुक्तौ मुनिश्रेष्ठौ नृपमूचतुरुल्बणौ ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003310113, "chapter_id": 23310, "verse_number": "२-५-११४", "content_sanskrit": "त्वमेव मोहं कुरुषे नावामिह कथंचन ।\nआवयोरेकमेषा ते वरयत्वेव माचिरम् ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003310114, "chapter_id": 23310, "verse_number": "२-५-११५", "content_sanskrit": "ततः सा कन्यका भूयः प्रणिप्तयेष्टदेवताम् ।\nमायामादाय तिष्ठंतं तयोर्मध्ये समाहितम् ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003310115, "chapter_id": 23310, "verse_number": "२-५-११६", "content_sanskrit": "सर्वाभरणसंयुक्त मतसीपुष्पसन्निभम् ।\nदीर्घबाहुं सुपुष्टांगं कर्णांतायतलोचनम् ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003310116, "chapter_id": 23310, "verse_number": "२-५-११७", "content_sanskrit": "पूर्ववत्पुरुषं दृष्ट्वा मालां तस्मै ददौ हि सा ।\nअनंतरं हि सा कन्या न दृष्टा मनुजैः पुनः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7003310117, "chapter_id": 23310, "verse_number": "२-५-११८", "content_sanskrit": "ततो नादः समभवत् किमेतदिति विस्मितौ ।\nतामादाय गतो विष्णुः स्वस्थानं पुरुषोत्तमः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7003310118, "chapter_id": 23310, "verse_number": "२-५-११९", "content_sanskrit": "पुरा तदर्थमनिशं तपस्तप्त्वा वरांगना ।\nश्रीमती सा समुत्पन्ना सा गता च तथा हरिम् ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7003310119, "chapter_id": 23310, "verse_number": "२-५-१२०", "content_sanskrit": "तावुभौ मुनिशार्दूलौ धिक्कृतावति दुःखितौ ।\nवासुदेवं प्रति तदा जग्मतुर्भवनं हरेः ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7003310120, "chapter_id": 23310, "verse_number": "२-५-१२१", "content_sanskrit": "तावागतौ समीक्ष्याह श्रीमतिं भगवान्हरिः।। मुनिश्रेष्ठौ समायातौ गूहस्वात्मानमत्र वै ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7003310121, "chapter_id": 23310, "verse_number": "२-५-१२२", "content_sanskrit": "तथेत्युक्त्वा च सा देवी प्रहसंती चकार ह ।\nनारदः प्रणिपत्याग्रे प्राह दामोदरं हरिम् ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7003310122, "chapter_id": 23310, "verse_number": "२-५-१२३", "content_sanskrit": "प्रियं हि कृतवानद्य मम त्वं पर्वतस्य हि ।\nत्वमेव नूनं गोविंद कन्यां तां हृतवानासि ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7003310123, "chapter_id": 23310, "verse_number": "२-५-१२४", "content_sanskrit": "विमोह्यावां स्वयं बुद्ध्या प्रतार्य सुरसत्तम  ।\nइत्युक्तः पुरषो विष्णुः पिधाय श्रोत्रमच्युतः ।\nपाणिभ्यां प्राह भगवान् भवद्भ्यां किमुदीरितम् ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7003310124, "chapter_id": 23310, "verse_number": "२-५-१२५", "content_sanskrit": "कामवानपि भावोयं मुनिवृत्तिरहो किल ।\nएवमुक्तो मुनिः प्राह वासुदेवं स नारदः ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7003310125, "chapter_id": 23310, "verse_number": "२-५-१२६", "content_sanskrit": "कर्णमूले मम कथं गोलांगूलमुखं त्विति ।\nकर्णमूले तमाहेदं वानरत्वं कृतं मया ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7003310126, "chapter_id": 23310, "verse_number": "२-५-१२७", "content_sanskrit": "पर्वतस्य मया विद्वन् गोलांगूलमुखं तव ।\nमया तव कृतं तत्र प्रियार्थं नान्यथा त्विति ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7003310127, "chapter_id": 23310, "verse_number": "२-५-१२८", "content_sanskrit": "पर्वतोऽपि तथा प्राह तस्याप्येवं जगादसः ।\nश्रृण्वतोरुभयोस्तत्र प्राह दामोदरो वचः ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7003310128, "chapter_id": 23310, "verse_number": "२-५-१२९", "content_sanskrit": "प्रियं भवद्भ्यां कृतवान् सत्येनात्मानमालभे ।\nनारदः प्राह धर्मात्मा आवयोर्मध्यतः स्थितः ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7003310129, "chapter_id": 23310, "verse_number": "२-५-१३०", "content_sanskrit": "धनुष्मानन्पुरुषः कोन तां हृत्वा गतवान्किल ।\nतच्छ्रुत्वा वासुदेवोऽसौ प्राह तौ मुनिसत्त्मौ ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7003310130, "chapter_id": 23310, "verse_number": "२-५-१३१", "content_sanskrit": "मायाविनो महात्मनो बहवः संति सत्तमाः ।\nतत्र सा श्रीमती नूनमदृष्ट्वा मुनिसत्तमौ ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7003310131, "chapter_id": 23310, "verse_number": "२-५-१३२", "content_sanskrit": "चक्रपाणिरहं नित्यं चतुर्बाहुरिति स्थितः ।\nतां तथा नाहमैच्छं वै भवद्भ्यां विदितं हि तत् ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7003310132, "chapter_id": 23310, "verse_number": "२-५-१३३", "content_sanskrit": "इत्युक्तौ प्रणिपत्यैनमूचतुः प्रीतिमानसौ ।\nकोऽत्र दोषस्तव विभो नारायण जगत्पते ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7003310133, "chapter_id": 23310, "verse_number": "२-५-१३४", "content_sanskrit": "दौरात्म्यं तन्नृपस्यैव मायां हि कृतवानसौ ।\nइत्युक्त्वा जग्मतुस्तस्मान्मुनीनारदपर्वतौ ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7003310134, "chapter_id": 23310, "verse_number": "२-५-१३५", "content_sanskrit": "अंबरीषं समासाद्य शापेनैनमयोजयत् ।\nनारदः पर्वतश्चैव यस्मादावामिहागतौ ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7003310135, "chapter_id": 23310, "verse_number": "२-५-१३६", "content_sanskrit": "आहूय पश्चादन्यस्मै कन्यां त्वं दत्तवानसि ।\nमायायोगेन तस्मात्त्वं तमो ह्यभिभविष्यति ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7003310136, "chapter_id": 23310, "verse_number": "२-५-१३७", "content_sanskrit": "तेन चात्मानमत्यर्थं यथावत्त्वं च वेत्स्यसि ।\nएवं शापेप्रदत्ते तु तमोराशिरथोत्थितः ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7003310137, "chapter_id": 23310, "verse_number": "२-५-१३८", "content_sanskrit": "नृपं प्रति ततश्चक्रं विष्णोः प्रादुरभूत् क्षणात् ।\nचक्रवित्रासितं घोरं तावुभौ तम अभ्यगात् ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7003310138, "chapter_id": 23310, "verse_number": "२-५-१३९", "content_sanskrit": "ततः संत्रस्तसर्वांगौ धावमानौ महामुनी ।\nपृष्ठतश्चक्रमालोक्य तमोराशिं दुरासदम् ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7003310139, "chapter_id": 23310, "verse_number": "२-५-१४०", "content_sanskrit": "कन्यासिद्धिरहो प्राप्ता ह्यावयोरिति वेगितौ ।\nलोकालोकांतमनिशं धावमानौ भयार्दितौ ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7003310140, "chapter_id": 23310, "verse_number": "२-५-१४१", "content_sanskrit": "त्राहित्राहीति गोविंदं भाषमाणौ भयार्दितौ ।\nविष्णुलोकं ततो गत्वा नारायण जगत्पते ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7003310141, "chapter_id": 23310, "verse_number": "२-५-१४२", "content_sanskrit": "वासुदेव हृषीकेश पद्मनाभ जनार्दन ।\nत्राह्यावां पुंडरीकाक्ष नाथोऽसि पुरुषोत्तम ॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7003310142, "chapter_id": 23310, "verse_number": "२-५-१४३", "content_sanskrit": "ततो नारायणश्चिंत्य श्रीमाञ्छ्रीवत्सलांछनः ।\nनिवार्य चक्रं ध्वांतं च भक्तानुग्रहकाम्यया ॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7003310143, "chapter_id": 23310, "verse_number": "२-५-१४४", "content_sanskrit": "अंबरीषश्च मद्भक्तस्तथैतौ मुनिसत्तमौ ।\nअनयोरस्य च तथा हितं कार्यं मयाऽधुना ॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 7003310144, "chapter_id": 23310, "verse_number": "२-५-१४५", "content_sanskrit": "आहूय तत्तमः श्रीमान् गिरा प्रह्लादयन् हरिः ।\nप्रोवाच  ।\nगवान् विष्णुः शृणुतां म इदंवचः ॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 7003310145, "chapter_id": 23310, "verse_number": "२-५-१४६", "content_sanskrit": "ऋषिशापो न चैवासीदन्यथा च वरो मम ।\nदत्तो नृपाय रक्षार्थं नास्ति तस्यान्यथा पुनः ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 7003310146, "chapter_id": 23310, "verse_number": "२-५-१४७", "content_sanskrit": "अंबरीषस्य पुत्रस्यनप्तुः पुत्रो महायशाः ।\nश्रीमान्दसरथो नाम राजा भवति धार्मिकः ॥१४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 7003310147, "chapter_id": 23310, "verse_number": "२-५-१४८", "content_sanskrit": "तस्याहमग्रजः पुत्रो रामनामा भवाम्यहम् ।\nतत्र मे दक्षिणोबाहुर्भरतो नाम वै भवेत् ॥१४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 7003310148, "chapter_id": 23310, "verse_number": "२-५-१४९", "content_sanskrit": "शत्रुघ्नो नाम सव्यश्च शेषोऽसौ लक्ष्मणः स्मृतः ।\nतत्र मां समुपागच्छ गच्छेदानीं नृपं विना ॥१४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 7003310149, "chapter_id": 23310, "verse_number": "२-५-१५०", "content_sanskrit": "मुनिश्रेष्ठौ च हित्वा त्वमिति स्माह च माधवः ।\nएवममुक्तं तमो नाशं तत्क्षणाच्च जगाम वै ॥१४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 7003310150, "chapter_id": 23310, "verse_number": "२-५-१५१", "content_sanskrit": "निवारितं हरेश्चक्रं यथापूर्वमतिष्ठत ।\nमुनिश्रेष्ठौ भयान्मुक्तौ प्रणिपत्य जनार्दनम् ॥१५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}, {"id": 7003310151, "chapter_id": 23310, "verse_number": "२-५-१५२", "content_sanskrit": "निर्गतौ शोकसंतप्तौ ऊचतुस्तौ परस्परम् ।\nअद्यप्रभृति देहांतमावां कन्यापरिग्रहम् ॥१५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 152}, {"id": 7003310152, "chapter_id": 23310, "verse_number": "२-५-१५३", "content_sanskrit": "न करिष्याव इत्युक्त्वा प्रतिज्ञाय च तावृषी ।\nयोगध्यानपरौ शुद्धौ यथापूर्वं व्यवस्थितौ ॥१५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 153}, {"id": 7003310153, "chapter_id": 23310, "verse_number": "२-५-१५४", "content_sanskrit": "अंबरीषश्च राजासौ परिपाल्य च मेदिनीम् ।\nसभृत्यज्ञातिसंपन्नो विष्णुलोकं जगाम वै ॥१५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 154}, {"id": 7003310154, "chapter_id": 23310, "verse_number": "२-५-१५५", "content_sanskrit": "मानार्थमंबरीषस्य तथैव मुनिसिंहयोः ।\nरामो दाशथिर्भूत्वा नात्मवेदीश्वरोऽभवत् ॥१५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 155}, {"id": 7003310155, "chapter_id": 23310, "verse_number": "२-५-१५६", "content_sanskrit": "मुनयश्च तथा सर्वे भृग्वाद्या मुनिसत्तमाः ।\nमाया न कार्या विद्वद्भिरित्याहुः प्रेक्ष्यतं हरिम् ॥१५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 156}, {"id": 7003310156, "chapter_id": 23310, "verse_number": "२-५-१५७", "content_sanskrit": "नारदः पर्वतश्चैव चिरं ज्ञात्वा विचेष्टितम् ।\nमायां विष्णोर्विनिंद्यैव रुद्रभक्तौ बभूवतुः ॥१५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 157}, {"id": 7003310157, "chapter_id": 23310, "verse_number": "२-५-१५८", "content_sanskrit": "एतद्धि कथितंसर्व मया युष्माकमद्य वै ।\nअंबरीषस्य माहात्म्यं मायावित्वं च वै हरेः ॥१५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 158}, {"id": 7003310158, "chapter_id": 23310, "verse_number": "२-५-१५९", "content_sanskrit": "यः पठेच्छृणुयाद्वापि श्रावयेद्वापि मानवः ।\nमायां विसृज्य पुण्यात्मा रुद्रलोकं स गच्छति ॥१५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 159}, {"id": 7003310159, "chapter_id": 23310, "verse_number": "२-५-१६०", "content_sanskrit": "इदं पवित्रं परमं पुण्यं वेदैरुदीरितम् ।\nसायं प्रातः पठेन्नित्यं विष्णोः सायुज्यमाप्नुयात् ॥१५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 160}]