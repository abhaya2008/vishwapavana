[{"id": 2069930, "chapter_id": 2463, "verse_number": "१०-१५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2069931, "chapter_id": 2463, "verse_number": "१०-१५-१", "content_sanskrit": "दृष्टैव मुनिशार्दूलौ तावग्निसमतेजसौ।\n`गाण्डीवधन्वा सञ्चिन्त्य प्राप्तकालं महारथः।\nसञ्जहार शरं दिव्यं त्वरमाणो धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2069932, "chapter_id": 2463, "verse_number": "१०-१५-२", "content_sanskrit": "उवाच वचनं श्रेष्ठस्तावृषी प्राञ्जलिस्तदा।\nप्रमुक्तमस्त्रमस्त्रेण शाम्यतामिति वै मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2069933, "chapter_id": 2463, "verse_number": "१०-१५-३", "content_sanskrit": "संहृते परमास्त्रेऽस्मिन्सर्वानस्मानशेषतः।\nपापकर्मा ध्रुवं द्रौणिः प्रधक्ष्यत्यस्त्रतेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2069934, "chapter_id": 2463, "verse_number": "१०-१५-४", "content_sanskrit": "यदत्र हितमस्माकं लोकानां चैव सर्वथा।\nभवन्तौ देवसङ्काशौ तथा सम्मन्तुमर्हतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2069935, "chapter_id": 2463, "verse_number": "१०-१५-५", "content_sanskrit": "इत्युक्त्वा सञ्जहारास्त्रं पुनरेव धनञ्जयः।\nसंहारो दुष्करस्स्य देवैरपि हि संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2069936, "chapter_id": 2463, "verse_number": "१०-१५-६", "content_sanskrit": "विसृष्टस्य रणे तस्य परमास्त्रस्य सङ्ग्रहे।\nअशक्तः पाण्डवादन्यः साक्षादपि शतक्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2069937, "chapter_id": 2463, "verse_number": "१०-१५-७", "content_sanskrit": "ब्रह्मतेजोद्भवं तद्धि विसृष्टमकृतात्मना।\nन शक्यमावर्तयितुं ब्रह्मचर्यव्रतादृते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2069938, "chapter_id": 2463, "verse_number": "१०-१५-८", "content_sanskrit": "अचीर्णब्रह्मचर्यो यः सृष्ट्वाऽऽवर्यते पुनः।\nतदस्त्रं सानुबन्धस्य मूर्धानं तस्य कृन्तति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2069939, "chapter_id": 2463, "verse_number": "१०-१५-९", "content_sanskrit": "ब्रह्मचारी व्रती चापि दुरवापमवाप्य तत्।\nपरमव्यसनार्तोऽपि नार्जुनोऽस्त्रं व्यमुञ्चत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2069940, "chapter_id": 2463, "verse_number": "१०-१५-१०", "content_sanskrit": "सत्यव्रतधरः शूरो ब्रह्मचारी च पाण़्डवः।\nगुरुवर्ती च तेनास्त्रं सञ्जहारार्जुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2069941, "chapter_id": 2463, "verse_number": "१०-१५-११", "content_sanskrit": "द्रौणिरप्यथ सम्प्रेभ्य सोऽन्तरा तावृषी स्थितौ।\nन शशाक पुनर्घोरमस्त्रं संहर्तुमोजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2069942, "chapter_id": 2463, "verse_number": "१०-१५-१२", "content_sanskrit": "अशक्तः प्रतिसंहारे परमास्त्रस्य संयुगे।\nद्रौणिर्दीनमना राजन्द्वैपायनमभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2069943, "chapter_id": 2463, "verse_number": "१०-१५-१३", "content_sanskrit": "उत्तमव्यसनार्तेन प्राणत्राणमभीप्सुना।\nमयैतदस्त्रमुत्सृष्टं भीमसेनभयान्मुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2069944, "chapter_id": 2463, "verse_number": "१०-१५-१४", "content_sanskrit": "अधर्मश्च कृतोऽनेन धार्तराष्ट्रं जिघांसता।\nमिथ्याचारेण भगवन्भीमसेनेन संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2069945, "chapter_id": 2463, "verse_number": "१०-१५-१५", "content_sanskrit": "अतः सृष्टमिदं ब्रह्मन्मयाऽस्त्रमकृतात्मना।\nतस्य भूयोऽपि संहारं कर्तुं नाहमिहोत्सहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2069946, "chapter_id": 2463, "verse_number": "१०-१५-१६", "content_sanskrit": "निसृष्टं हि मया दिव्यमेतदस्त्रं दुरासदम्।\nअपाण्डवायेति मुने वह्नितेजोऽनुमन्त्र्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2069947, "chapter_id": 2463, "verse_number": "१०-१५-१७", "content_sanskrit": "तदिदं पाण्डवेयानामन्तायैवाभिसंहितम्।\nअद्य पाण्डुसुतान्सर्वाञ्जीविताद्वंशयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2069948, "chapter_id": 2463, "verse_number": "१०-१५-१८", "content_sanskrit": "कृतं पापमिदं ब्रह्मन्रोषाविष्टेन चेतसा।\nवधमाशास्य पार्थानां मयास्त्रं सृजता रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2069949, "chapter_id": 2463, "verse_number": "१०-१५-१९", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2069950, "chapter_id": 2463, "verse_number": "१०-१५-१९", "content_sanskrit": "अस्त्रं ब्रह्मशिरस्तात विद्वान्पार्थो धनञ्जयः।\nउत्सृष्टवानहिंसार्थं न रोषेण तवाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2069951, "chapter_id": 2463, "verse_number": "१०-१५-२०", "content_sanskrit": "अस्त्रमस्त्रेण तु रमे तव संशमयिष्यता।\nविसृष्टमर्जुनेनेदं पुनश्च प्रतिसंहृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2069952, "chapter_id": 2463, "verse_number": "१०-१५-२१", "content_sanskrit": "ब्रह्मास्त्रमप्यवाप्यैतदुपदेशात्पितुस्तव।\nक्षत्रधर्मान्महाबाहुर्नाकम्पत धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2069953, "chapter_id": 2463, "verse_number": "१०-१५-२२", "content_sanskrit": "एवं धृतिमतः साधोः सर्वास्त्रविदुषः सतः।\nसभ्रातृबन्धोः कस्मात्त्वं वधमस्य चिकीर्षसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2069954, "chapter_id": 2463, "verse_number": "१०-१५-२३", "content_sanskrit": "अस्त्रं ब्रह्मशिरो यत्र परमास्त्रेण वध्यते।\nसमा द्वादश पर्जन्यस्तद्राष्ट्रं नाभिवर्षति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2069955, "chapter_id": 2463, "verse_number": "१०-१५-२४", "content_sanskrit": "एतदर्थं महाबाहुः शक्तिमानपि पाण्डवः।\nन विहन्यात्तदस्त्रं तु प्रजाहितचिकीर्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2069956, "chapter_id": 2463, "verse_number": "१०-१५-२५", "content_sanskrit": "पाण्डवास्त्वं च राष्ट्रं च सदा संरक्ष्यमेव नः।\nतस्मात्संहर दिव्यं त्वमस्त्रमेन्महाभुज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2069957, "chapter_id": 2463, "verse_number": "१०-१५-२६", "content_sanskrit": "अरोषस्तव चैवास्तु पार्थाः सन्तु निरामयाः।\nन ह्यधर्मेण राजर्षिः पाण्डवो जेतुमिच्छति।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2069958, "chapter_id": 2463, "verse_number": "१०-१५-२७", "content_sanskrit": "मणिं चैव प्रयच्छाद्य यस्ते शिरसि तिष्ठति।\nएतदादाय ते प्रामान्प्रतिदास्यन्ति पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2069959, "chapter_id": 2463, "verse_number": "१०-१५-२८x", "content_sanskrit": "द्रौणिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2069960, "chapter_id": 2463, "verse_number": "१०-१५-२८", "content_sanskrit": "पाण्डवैर्यानि रत्नानि यच्चान्यत्कौरवैर्धनम्।\nअवाप्तमिह तेभ्योऽयं मणिर्मम विशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2069961, "chapter_id": 2463, "verse_number": "१०-१५-२९", "content_sanskrit": "यमाबध्य भयं नास्ति शस्त्रव्याधिक्षुधाश्रयम्।\nदेवेभ्यो दानवेभ्यो वा नागेभ्यो वा कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2069962, "chapter_id": 2463, "verse_number": "१०-१५-३०", "content_sanskrit": "न च रक्षोगणभयं न तस्करभयं तथा।\nएवंवीर्यो मणिरयं न मे त्याज्यः कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2069963, "chapter_id": 2463, "verse_number": "१०-१५-३१", "content_sanskrit": "यत्तु मे भगवानाह तन्मे कार्यमनन्तरम्।\nअयं मणिरयं चाहमिषीका तु पतिष्यति।\nगर्भेषु पाण्डुपुत्राणामुत्रायास्तथोदरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2069964, "chapter_id": 2463, "verse_number": "१०-१५-३२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2069965, "chapter_id": 2463, "verse_number": "१०-१५-३२", "content_sanskrit": "प्राह द्रोणसुतं तत्र व्यासः परमदुर्मनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2069966, "chapter_id": 2463, "verse_number": "१०-१५-३३", "content_sanskrit": "एवं कुरु न चान्यत्र बुद्धिः कार्या कथञ्चन।\nगर्भेषु पाण्डवेयानां विसृज्यैतदुपारम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2069967, "chapter_id": 2463, "verse_number": "१०-१५-३४", "content_sanskrit": "`तमुवाच हृषीकेशः पाण्डवानां हिते मतः।\nभविष्यमेकमुत्सृज्य गर्भेष्वस्त्रं निपात्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2069968, "chapter_id": 2463, "verse_number": "१०-१५-३५", "content_sanskrit": "अहमेनं ददाम्येषां पिण्डदं कीर्तिवर्धनम्।\nराजर्षिं पुण्यकर्माणमनेकक्रतुयाजिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2069969, "chapter_id": 2463, "verse_number": "१०-१५-३६", "content_sanskrit": "एवं कुरु न चान्या ते बुद्धिः कार्या कथञ्चन।\nआगर्भात्पाण्डवेयानां कृत्वा पातं विनङ्क्ष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2069970, "chapter_id": 2463, "verse_number": "१०-१५-३७", "content_sanskrit": "एवं ब्रुवाणं गोविन्दं वृषभं सर्वसात्वताम्।\nद्रौणिः परमसङ्क्रुद्धः प्रत्युवाचेदमुत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2069971, "chapter_id": 2463, "verse_number": "१०-१५-३८", "content_sanskrit": "नैतदेवं यदात्थ त्वं पक्षपातेन केशव।\nवचनात्पुण्डरीकाक्ष तव मद्वाक्यमन्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2069972, "chapter_id": 2463, "verse_number": "१०-१५-३९", "content_sanskrit": "पतिष्यत्येतदस्त्रं वै गर्भे तस्या मयोद्यतम्।\nविराटदुहितुः कृष्ण यं त्वं रक्षितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2069973, "chapter_id": 2463, "verse_number": "१०-१५-४०x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2069974, "chapter_id": 2463, "verse_number": "१०-१५-४०", "content_sanskrit": "अमोघः परमास्त्रस्य पातस्त्वद्य भविष्यति।\n`अभिमन्योः सृजैषीकां गर्भस्थः शाम्यतां शिशुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2069975, "chapter_id": 2463, "verse_number": "१०-१५-४१", "content_sanskrit": "अहमेनं मृतं जातं जीवयिष्यामि बालकम्।\nस तु गर्भो मृतो जातो दीर्घमायुरवाप्स्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2069976, "chapter_id": 2463, "verse_number": "१०-१५-४२", "content_sanskrit": "`इत्युक्तः प्रत्युवाचैनं द्रोणपुत्रः स्मयन्निव।\nयद्यस्त्रदग्धं गोविन्द जीवयस्येवमस्त्विति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2069977, "chapter_id": 2463, "verse_number": "१०-१५-४३", "content_sanskrit": "ततः परममस्त्रं तु द्रौणिरुद्यतमाहवे।\nद्वैपायनमनादृत्य गर्भेषु प्रमुमोच ह॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2069978, "chapter_id": 2463, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सौप्तिकपर्वणि ऐषीकपर्वणि पञ्चदशोऽध्यायः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]