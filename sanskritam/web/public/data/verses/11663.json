[{"id": 50020502, "chapter_id": 11663, "verse_number": "1", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50020503, "chapter_id": 11663, "verse_number": "2", "content_sanskrit": "सुखं स्वपुर्यां न्यवसद् द्वारकायां श्रियः पतिः। सर्वसम्पत्समृद्धायां जुष्टायां वृष्णिपुङ्गवैः॥ १०/१०२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50020504, "chapter_id": 11663, "verse_number": "3", "content_sanskrit": "स्त्रीभिश्चोत्तमवेषाभिर्नवयौवनकान्तिभिः। कन्दुकैर्हर्म्यसौधेषु क्राडन्तीभिस्तडिद्द्युभिः॥ १०/१०२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50020505, "chapter_id": 11663, "verse_number": "4", "content_sanskrit": "नित्यं सङ्कुलमार्गायां मदच्युद्भिर्मतङ्गजैः। स्वलङ्कृतैर्भटैरश्वै रथैश्च कनकोज्ज्वलैः॥ १०/१०२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50020506, "chapter_id": 11663, "verse_number": "5", "content_sanskrit": "उद्यानोपवनाढ्यायां पुष्पितद्रुमराजिषु। निर्विशद्भृङ्गविहगैर्नादितायां समन्ततः॥ १०/१०२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50020507, "chapter_id": 11663, "verse_number": "6", "content_sanskrit": "रेमे षोडशसाहस्रपत्नीनामेकवल्लभः। तावन्ति बिभ्रद् रूपाणि तद्गेहेषु महर्द्धिषु॥ १०/१०२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50020508, "chapter_id": 11663, "verse_number": "7", "content_sanskrit": "प्रोत्फुल्लोत्पलकल्हारकुमुदाम्भोजरेणुभिः। वासितामलतोयेषु कूजद्द्विजकुलेषु च॥ १०/१०२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50020509, "chapter_id": 11663, "verse_number": "8", "content_sanskrit": "विजहार विगाह्याम्भो ह्वदिनीषु महोदयः। कुचकुङ्कुमलिप्ताङ्गः परिरब्धः स्वयोषिताम्॥ १०/१०२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50020510, "chapter_id": 11663, "verse_number": "9", "content_sanskrit": "उपगीयमानो गन्धर्वैर्मृदङ्गपणवानकान्। वादयद्भिर्मुदा वीणाः सूतमागधवन्दिभिः॥ १०/१०२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50020511, "chapter_id": 11663, "verse_number": "10", "content_sanskrit": "सेव्यमानोऽच्युतस्ताभिर्हसन्तीभिश्च रेचकैः। प्रतिषिञ्चन् विचिक्राडे मुखरः शक्तिभिः स्वयम्॥ १०/१०२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50020512, "chapter_id": 11663, "verse_number": "11", "content_sanskrit": "ताः क्ल्न्निवस्त्रविवृतोरुकुचप्रदेशाः सिञ्चन्त्य उद्धृतबृहत्कबरप्रसूनाः। कान्तस्य चेतनजिहीर्षतयोपगूह्य जातस्मरोत्स्मयलसद्वदना विरेजुः॥ १०/१०२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50020513, "chapter_id": 11663, "verse_number": "12", "content_sanskrit": "कृष्णस्तु तत्स्तनविषज्जितकुङ्कुमस्रक् क्रीडाभिसङ्गतसकुन्तळकुन्दगन्धः। सिञ्चन् मुहुर्युवतिभिः परिषिच्यमानो रेमे करेणुभिरिवेभपतिः परीतः॥ १०/१०२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50020514, "chapter_id": 11663, "verse_number": "13", "content_sanskrit": "गृहेषु तासामनिवार्य ईश्वरो निरस्तसाम्यातिशयो व्यवस्थितः। रेमे रमाभिर्निजसौख्यसम्प्लुतो यथेतरो गार्हकमेधिकांश्चरन्॥ १०/१०२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50020515, "chapter_id": 11663, "verse_number": "14", "content_sanskrit": "इत्थं रमापतिमवाप्य पतिं स्त्रियस्ता ब्रह्मादयोऽपि पदवीं न विदुर्यदीयाम्। भेजुर्मुदाऽविरतमेधितयाऽनुरागहासावलोकनवसङ्गमलज्जयैव॥ १०/१०२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50020516, "chapter_id": 11663, "verse_number": "15", "content_sanskrit": "इति श्रीमद्भागवते दशमस्कन्धे द्व्यधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]