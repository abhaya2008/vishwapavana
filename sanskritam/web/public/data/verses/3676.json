[{"id": 2124903, "chapter_id": 3676, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2124904, "chapter_id": 3676, "verse_number": "१", "content_sanskrit": "एवं स पुरुषव्याघ्र साल्वराजो महारिपुः ।\nयुध्यमानो मया सङ्खे वियदभ्यगमत् पुनः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2124905, "chapter_id": 3676, "verse_number": "२", "content_sanskrit": "ततः शतघ्नीश्च महागदाश्च\nदीप्तान् शूलान्मुसलानसींश्च ।\nचिक्षेप रोषन्मयि मन्दबुद्धिः\nसाल्वो महाराज जयाभिकाङ्क्षी\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2124906, "chapter_id": 3676, "verse_number": "३", "content_sanskrit": "तानाशुगैरापततोऽहमाशु\nनिवार्य तूर्णं खगमान् ख एव ।\nद्विधा त्रिधा वाऽच्छिदमस्त्रमुक्तैः\nततोऽन्तरिक्षे निनदो बभूव\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2124907, "chapter_id": 3676, "verse_number": "४", "content_sanskrit": "ततः शतसहस्र्रेण शराणां नतपर्वणाम् ।\nदारुकं वाजिनश्चैव रथं च समवाकिरत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2124908, "chapter_id": 3676, "verse_number": "५", "content_sanskrit": "ततो बाणवधोत्पीडो दारुको विह्वलन्निव ।\nस्थातव्यमिति तिष्ठामि साल्वबाणप्रपीडितः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2124909, "chapter_id": 3676, "verse_number": "समाप्तिः", "content_sanskrit": "इति तस्य निशम्याहं सारथेः करुणं वचः ।\nअवेक्षमाणो यन्तारमवशं शरपीडितम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2124910, "chapter_id": 3676, "verse_number": "७", "content_sanskrit": "न तस्योरसि नो मूर्ध्नि न काये न भुजद्वये ।\nअन्तरं पाण्डवश्रेष्ठ पश्यामि निचितं शरैः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2124911, "chapter_id": 3676, "verse_number": "८", "content_sanskrit": "स तु बाणवधोत्पीडो व्यसृजद् रुधिरं बहु ।\nअभिवृष्टो यथा मेघैर्गिरिर्गैरिकधातुमान् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2124912, "chapter_id": 3676, "verse_number": "९", "content_sanskrit": "अभीशुहस्तं तं दृष्ट्वा सीदन्तं सारथिं रणे ।\nसंस्तम्भयं महाबाहो साल्वबाणप्रपीडितम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2124913, "chapter_id": 3676, "verse_number": "१०", "content_sanskrit": "अथ मां पुरुषः कश्चित् सौहृदादिव भारत ।\nआहुकस्य वचो वीर तस्यैव परिचारकः ।\nविषण्णासन्नकण्ठेन तन्निबोध युधिष्ठिर \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2124914, "chapter_id": 3676, "verse_number": "११", "content_sanskrit": "द्वारकाधिपतिर्वीर आह त्वामाहुको वचः ।\nकेशवेह विजानीष्व यत्त्वां पितृसखोऽब्रवीत् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2124915, "chapter_id": 3676, "verse_number": "१२", "content_sanskrit": "उपयात्वाद्य साल्वेन द्वारकां वृष्णिनन्दन ।\nविषक्ते त्वयि दुर्धर्ष हतः शूरसुतो बलात्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2124916, "chapter_id": 3676, "verse_number": "१३", "content_sanskrit": "तदलं साधुयुद्धेन निवर्तस्व जनार्दन ।\nद्वारकामेव रक्षस्व कार्यमेतन्महत् तव\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2124917, "chapter_id": 3676, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2124918, "chapter_id": 3676, "verse_number": "१४", "content_sanskrit": "इत्येवं तस्य वचनं श्रुत्वा परमदुर्मनाः ।\nनिश्चयं नाधिगच्छामि कर्तव्यस्येतरस्य वा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2124919, "chapter_id": 3676, "verse_number": "१५", "content_sanskrit": "सात्यकिं बलदेवं च प्रद्युम्नं च महाबलम् ।\nविगर्हे मनसा वीरांस्तच्छ्रुत्वा चाप्रियं वचः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2124920, "chapter_id": 3676, "verse_number": "१६", "content_sanskrit": "अहं हि द्वारकायाश्च पितुश्च कुरुनन्दन ।\nतेषु रक्षां समाधाय प्रयातः सौभपातने ।\nबलदेवो महाबाहुः कच्चिज्जीवति शत्रुहा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2124921, "chapter_id": 3676, "verse_number": "१७", "content_sanskrit": "सात्यकिश्चारुदेष्णश्च रौग्मिणेयश्च वीर्यवान् ।\nसाम्बप्रभृतयश्चैवेत्यहमासं सुदुर्मनाः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2124922, "chapter_id": 3676, "verse_number": "१८", "content_sanskrit": "एतेषु हि नरव्याघ्र जीवत्सु न कथञ्चन ।\nशक्यः शूरसुतो हन्तुमपि वज्रभृता स्वयम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2124923, "chapter_id": 3676, "verse_number": "१९", "content_sanskrit": "हतः शूरसुतो व्यक्तं व्यक्तं ते च परासवः ।\nबलदेवमुखाः सर्व इति मे निश्चिता मतिः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2124924, "chapter_id": 3676, "verse_number": "२०", "content_sanskrit": "सोऽहं सर्वविनाशं तं चिन्तयानो मुहुर्मुहुः ।\nसुविह्वलो महाराज पुनः साल्वमयोधयम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2124925, "chapter_id": 3676, "verse_number": "२१", "content_sanskrit": "ततोऽपश्यं महाराज प्रपतन्तमहं नृप ।\nसौभाच्छूरसुतं वीर ततो मां मोह आविशत्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2124926, "chapter_id": 3676, "verse_number": "२२", "content_sanskrit": "तस्य रूपं प्रपततः पितुर्मम नराधिप ।\nययातेः क्षीणपुण्यस्य स्वर्गादिव महीतळम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2124927, "chapter_id": 3676, "verse_number": "२३", "content_sanskrit": "विशीर्णगलितोष्णीषः प्रकीर्णाम्बरमूर्द्धजः ।\nप्रपतन् दृश्यते ह स्म क्षीणपुण्य इव ग्रहः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2124928, "chapter_id": 3676, "verse_number": "२४", "content_sanskrit": "ततः शार्ङ्गं धनुःश्रेष्ठं करात् प्रपतितं मम ।\nमोहापन्नस्तु कौन्तेय रथोपस्थ उपाविशम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2124929, "chapter_id": 3676, "verse_number": "", "content_sanskrit": "ततो हाहाकृतं सर्वं सैन्यं मे गतचेतनम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2124930, "chapter_id": 3676, "verse_number": "२५", "content_sanskrit": "मां दृष्ट्वा रथनीडस्थं गतासुमिव भारत\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2124931, "chapter_id": 3676, "verse_number": "२६", "content_sanskrit": "प्रसार्य बाहू पततः प्रसार्य चरणावपि ।\nरूपं पितुरपश्यं तत् शकुनेः पततो यथा \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2124932, "chapter_id": 3676, "verse_number": "२७", "content_sanskrit": "तं पतन्तं महाबाहो शूलपट्टसपाणयः ।\nअभिघ्नन्तो भृशं वीर मम चेतो व्यकम्पयन् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2124933, "chapter_id": 3676, "verse_number": "२८", "content_sanskrit": "ततो मुहूर्तात् प्रतिलभ्य संज्ञाम्\nअहं तदा वीर महाविमर्दे ।\nन तत्र सौभं न रिपुं न साल्वं\nपश्यामि वृद्धं पितरं न चापि \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2124934, "chapter_id": 3676, "verse_number": "२९", "content_sanskrit": "ततो ममासीन्मनसि मायेयमिति निश्चितम् ।\nप्रबुद्धोऽस्मि ततो भूयः शतशोऽवाकिरं शरान्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2124935, "chapter_id": 3676, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां वनपर्वणि अष्टदशोऽध्यायः ॥१८॥\n॥ कैरातपर्वणि अष्टमोऽध्यायः ॥८॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]