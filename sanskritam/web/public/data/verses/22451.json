[{"id": 7002451000, "chapter_id": 22451, "verse_number": "१-११३-१", "content_sanskrit": "विष्णुरुवाच ।\nसुरज्येष्ठ पुनर्ब्रूहि यत्पृच्छाम्यहमादितः ।\nयत्फलं समवाप्नोति कारयित्वा रवेर्गृहम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002451001, "chapter_id": 22451, "verse_number": "१-११३-२", "content_sanskrit": "देवार्चां कारयित्वा तु यत्पुण्यं पुरुषोऽश्नुते ।\nपूजयित्वा च विधिवदनुलिप्य च यत्फलम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002451002, "chapter_id": 22451, "verse_number": "१-११३-३", "content_sanskrit": "कानि माल्यानि शस्तानि कानि नार्हति भास्करः ।\nके धूपा भानुदयिताः के वर्ज्याश्च जगत्पतेः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002451003, "chapter_id": 22451, "verse_number": "१-११३-४", "content_sanskrit": "उपचारफलं किं स्यात्किं फलं गीतवादिते ।\nघृतक्षीरादिना यत्तु स्नापिते भास्करे फलम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002451004, "chapter_id": 22451, "verse_number": "१-११३-५", "content_sanskrit": "यथोपलेपनादौ च फलमभ्युक्षितेन तु ।\nदिवाकरगृहे तात तदशेषं वदस्व मे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002451005, "chapter_id": 22451, "verse_number": "१-११३-६", "content_sanskrit": "ब्रह्मोवाच ।\nसाधु वत्स यदेतत्त्वं मार्तण्डस्येह पृच्छसि ।\nशुश्रूषणे विधिं पुण्यं तदिहैकमनाः शृणु ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002451006, "chapter_id": 22451, "verse_number": "१-११३-७", "content_sanskrit": "यस्तु देवालयं भानोर्दार्वं शैलमथापि वा ।\nकारयेन्मृन्मयं चापि तस्य पुण्यफलं शृणु ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002451007, "chapter_id": 22451, "verse_number": "१-११३-८", "content_sanskrit": "अहन्यहनि यज्ञेन यजतो यन्महत्फलम् ।\nप्राप्नोति तत्फलं भानोर्यः कारयति मन्दिरम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002451008, "chapter_id": 22451, "verse_number": "१-११३-९", "content_sanskrit": "कुलानां शतमागामि समतीतं कुलं शतम् ।\nकारयेद्भगवद्धाम स नयेदर्कलोकताम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002451009, "chapter_id": 22451, "verse_number": "१-११३-१०", "content_sanskrit": "सप्तजन्मकृतं पापं स्वल्पं वा यदि वा बहु ।\nभानोरालयविन्यासप्रारम्भादेव नश्यति ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002451010, "chapter_id": 22451, "verse_number": "१-११३-११", "content_sanskrit": "सप्तलोकमयो भानुस्तस्य यः कुरुते गृहम् ।\nप्रतिष्ठां समवाप्नोति स नरः साप्तलौकिकीम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002451011, "chapter_id": 22451, "verse_number": "१-११३-१२", "content_sanskrit": "प्रशस्तदेशभूभागे प्रशस्तं भवनं रवेः ।\nकारयेदक्षयांल्लोकान्स नरः प्रतिपद्यते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002451012, "chapter_id": 22451, "verse_number": "१-११३-१३", "content_sanskrit": "इष्टकाचयविन्यासो यावद्वर्षाणि तिष्ठति ।\nतावद्वर्षसहस्राणि तत्कर्तुर्दिवि संस्थितिः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002451013, "chapter_id": 22451, "verse_number": "१-११३-१४", "content_sanskrit": "प्रतिमां लक्षणवतीं यः कारयति मानवः ।\nदिवाकरस्य तल्लोकमक्षयं प्रतिपद्यते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002451014, "chapter_id": 22451, "verse_number": "१-११३-१५", "content_sanskrit": "षष्टिर्वर्षसहस्राणां सहस्राणि स मोदते ।\nलोके सुमनसां वीर प्रत्येकं मधुसूदन ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002451015, "chapter_id": 22451, "verse_number": "१-११३-१६", "content_sanskrit": "प्रतिष्ठाप्य रवेरर्चां सुप्रशस्ते निवेशने ।\nपुरुषः कृतकृत्योऽस्ति न दोषफलमश्नुते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002451016, "chapter_id": 22451, "verse_number": "१-११३-१७", "content_sanskrit": "ये भविष्यन्ति येऽतीता आकल्पं पुरुषाः कुले ।\nतांस्तारयति संस्थाप्य देवस्य प्रतिमां रवेः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002451017, "chapter_id": 22451, "verse_number": "१-११३-१८", "content_sanskrit": "अनुशिष्टाः किल पुरा यमेन यमकिङ्कराः ।\nपाशदण्डकराः कृष्ण प्रजासंयमनोद्यताः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002451018, "chapter_id": 22451, "verse_number": "१-११३-१९", "content_sanskrit": "यम उवाच ।\nविहरन्तु यथान्यायं नियोगो मेऽनुपाल्यताम् ।\nनाज्ञाभङ्गं करिष्यन्ति भवतां जन्तवः क्वचित् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002451019, "chapter_id": 22451, "verse_number": "१-११३-२०", "content_sanskrit": "केवलं ये जगन्मूलं विवस्वन्तमुपाश्रिताः ।\nभवद्भिः परिहर्तव्यास्तेषां नैवेह संस्थितिः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002451020, "chapter_id": 22451, "verse_number": "१-११३-२१", "content_sanskrit": "ये तु वैवस्वता लोके तच्चित्तास्तत्परायणाः ।\nपूजयन्ति सदा भानुं ते च त्याज्या सुदूरतः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002451021, "chapter_id": 22451, "verse_number": "१-११३-२२", "content_sanskrit": "तिष्ठंश्च प्रस्वपन्गच्छन्नुत्तिष्ठन्स्खलिते क्षुते ।\nसङ्कीर्तयति देवं यः स नस्त्याज्यः सुदूरतः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002451022, "chapter_id": 22451, "verse_number": "१-११३-२३", "content_sanskrit": "नित्यनैमित्तिकैर्देवं ये यजन्ति तु भास्करम् ।\nन चालोक्या भवद्भिस्ते यद्ध्यानं हंति वो गतिम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002451023, "chapter_id": 22451, "verse_number": "१-११३-२४", "content_sanskrit": "ये पुष्पधूपवासोऽभिर्भूषणैश्चापि वल्लभैः ।\nअर्चयन्ति न ते ग्राह्या मत्पितुस्ते परिग्रहाः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002451024, "chapter_id": 22451, "verse_number": "१-११३-२५", "content_sanskrit": "उपलेपनकर्तारः कर्तारो मार्जनस्य ये ।\nअर्कालये परित्याज्यं तेषां त्रिपुरुषं कुलम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002451025, "chapter_id": 22451, "verse_number": "१-११३-२६", "content_sanskrit": "ये वायतनं भानोः कारितं तत्कुलोद्भवः ।\nपुमान्न नावलोक्यो वै भवद्भिर्दुष्टचक्षुषा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002451026, "chapter_id": 22451, "verse_number": "१-११३-२७", "content_sanskrit": "येनार्चा भगवद्भक्त्या मत्पितुः कारिता शुभा ।\nनराणां तत्कुलं वीराः सदा त्याज्यं सुदूरतः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002451027, "chapter_id": 22451, "verse_number": "१-११३-२८", "content_sanskrit": "भवतां भ्रमतां यत्र भानुसंश्रयमुद्रया ।\nन चाज्ञाभङ्गकृत्कश्चिद्भविष्यति नरः क्वचित् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002451028, "chapter_id": 22451, "verse_number": "१-११३-२९", "content_sanskrit": "इत्युक्ताः किङ्करास्तेन यमेन सुमहात्मना ।\nअनाश्रित्य वचः कृष्णः सत्राजितमथो गताः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002451029, "chapter_id": 22451, "verse_number": "१-११३-३०", "content_sanskrit": "तस्य ते तेजसा सर्वे भानोर्भक्तस्य सुव्रत ।\nमोहिताः पतिता भूमौ यथा च विहगा नगात् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002451030, "chapter_id": 22451, "verse_number": "१-११३-३१", "content_sanskrit": "एतां महाफलां योर्चां भानोः कारयते नरः ।\nतवाख्यानं महाबाहो गृहं कारयितुश्च यत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002451031, "chapter_id": 22451, "verse_number": "१-११३-३२", "content_sanskrit": "यज्ञा नराणां पापौघनाशकाः सर्वकामदाः ।\nतथैवेष्टो जगद्भानुः सर्वयज्ञमयो रविः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]