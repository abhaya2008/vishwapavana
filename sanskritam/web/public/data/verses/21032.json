[{"id": 7001032000, "chapter_id": 21032, "verse_number": "५-१४-१", "content_sanskrit": "श्रीपराशर उवाच।\nप्रदोषाग्रे कदाचित्तु रासासक्ते जनार्दने।\nत्रासयन्समदो गोष्ठमरिष्टस्समुपागमत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001032001, "chapter_id": 21032, "verse_number": "५-१४-२", "content_sanskrit": "स तोयतोयदच्छायस्तीक्ष्णशृंगोर्कलोचनः।\nखुराग्रपातैरत्यर्थं दारयन्धरणीतलम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001032002, "chapter_id": 21032, "verse_number": "५-१४-३", "content_sanskrit": "लेलिहानस्सनिष्पेषं जिह्वयोष्ठौ पुनःपुनः।\nसंरंभाविद्धलांगूलः कठिनस्कंधबंधनः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001032003, "chapter_id": 21032, "verse_number": "५-१४-४", "content_sanskrit": "उदग्रककुदाभोगप्रमाणो दुरतिक्रमः।\nविण्मूत्रलिप्तपृष्ठांगो गवामुद्वेगकारकः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001032004, "chapter_id": 21032, "verse_number": "५-१४-५", "content_sanskrit": "प्रलंबकंठोऽतिमुखस्तरुखातांकिताननः।\nपातयन्स गवां गर्भान्दैत्यो वृषभरूपधृक् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001032005, "chapter_id": 21032, "verse_number": "५-१४-६", "content_sanskrit": "सूदयंस्तापसानुग्रो वनानटति यस्सदा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001032006, "chapter_id": 21032, "verse_number": "५-१४-७", "content_sanskrit": "ततस्तमतिघोराक्षमवेक्ष्यातिभयातुराः।\nगोपा गोपस्त्रियश्चैव कृष्णकृष्णेति चुक्रुशुः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001032007, "chapter_id": 21032, "verse_number": "५-१४-८", "content_sanskrit": "सिंहनादं ततश्चक्रे तलशब्दं च केशवः।\nतच्छब्दश्रवणाच्चाऽसौ दामोदरमुपाययौ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001032008, "chapter_id": 21032, "verse_number": "५-१४-९", "content_sanskrit": "अग्रन्यस्तविषाणाग्रः कृष्णकुक्षिकृतेक्षणः ।\nअभ्यधावत दुष्टात्मा कृष्णं वृषभदानवः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001032009, "chapter_id": 21032, "verse_number": "५-१४-१०", "content_sanskrit": "आयांतं दैत्यवृषभं दृष्ट्वा कृष्णो महाबलः।\nन चचाल तदा स्थानादवज्ञास्मितलीलया ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001032010, "chapter_id": 21032, "verse_number": "५-१४-११", "content_sanskrit": "आसन्नं चैव जग्राह ग्राहवन्मधुसूदनः।\nजघान जानुना कुक्षौ विषाणग्रहणाचलम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001032011, "chapter_id": 21032, "verse_number": "५-१४-१२", "content_sanskrit": "तस्य दर्पबलं भंक्त्वा गृहीतस्य विषाणयोः।\nअपीडयदरिष्टस्य कंठं क्लिन्नमिवांबरम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001032012, "chapter_id": 21032, "verse_number": "५-१४-१३", "content_sanskrit": "उत्पाट्य शृंगमेकं तु तेनैवाताडयत्ततः।\nममार स महादैत्यो मुखाच्छोणितमुद्वमन् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001032013, "chapter_id": 21032, "verse_number": "५-१४-१४", "content_sanskrit": "तुष्टुवुर्निहते तस्मिन्दैत्ये गोपा जनार्दनम् ।\nजंभे हते सहस्राक्षं पुरा देवगणा यथा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]