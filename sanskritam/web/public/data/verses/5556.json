[{"id": 2213335, "chapter_id": 5556, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2213336, "chapter_id": 5556, "verse_number": "१", "content_sanskrit": "युधिष्ठिर महाबाहो कच्चित् तात कुशल्यसि ।\nसहितो भ्रातृभिः सर्वैः पौरजानपदैस्तथा\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2213337, "chapter_id": 5556, "verse_number": "२", "content_sanskrit": "ये च त्वामनुजीवन्ति कच्चित् तेऽपि निरामयाः ।\nसचिवा भृत्यवर्गाश्च गुरवश्चैव ते विभो\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2213338, "chapter_id": 5556, "verse_number": "३", "content_sanskrit": "कच्चिद्वर्तसि पौराणीं वृत्तिं राजर्षिसेविताम् ।\nकच्चिदायाननुच्छिद्य कोशस्तेऽभिप्रपूर्यते\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2213339, "chapter_id": 5556, "verse_number": "४", "content_sanskrit": "अरिमध्यस्थमित्रेषु वर्तसे चानुरूपतः ।\nब्रह्मणानग्रहारैर्वा यथावदनुपश्यसि\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2213340, "chapter_id": 5556, "verse_number": "५", "content_sanskrit": "कच्चित् ते परितुष्यन्ति शीलेन भरतर्षभ ।\nशत्रवोऽपि कुतः पौरा भृत्या वा स्वजनोऽपि वा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2213341, "chapter_id": 5556, "verse_number": "६", "content_sanskrit": "कच्चिदर्चसि राजेन्द्र श्रद्धावान् पितृदेवताः ।\nअतिथींश्चान्नपानेन कच्चिदर्हसि भारत\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2213342, "chapter_id": 5556, "verse_number": "७", "content_sanskrit": "कच्चिच्च विषये विप्राः स्वकर्मनिरतास्तव ।\nक्षत्रिया वैश्यवर्णा वा शूद्रा वाऽपि कुटुम्बिनः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2213343, "chapter_id": 5556, "verse_number": "८", "content_sanskrit": "कच्चित् स्त्रीबालवृद्धं ते न शोचति न याचति ।\nजामयः पूजिताः कच्चित् तव गेहे च पार्थिव\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2213344, "chapter_id": 5556, "verse_number": "९", "content_sanskrit": "कच्चिद् राजर्षिवंशोऽयं त्वामासाद्य नराधिप ।\nयथोचितं महाराज यशसो नावसीदति\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2213345, "chapter_id": 5556, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2213346, "chapter_id": 5556, "verse_number": "१०", "content_sanskrit": "इत्येवंवादिनं सन्तं न्यायवत् प्रत्यभाषत ।\nकुशलप्रश्नसंयुक्तं कुशलो वाक्यमब्रवीत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2213347, "chapter_id": 5556, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2213348, "chapter_id": 5556, "verse_number": "११", "content_sanskrit": "अपि ते वर्धते राजन् तपो मन्द्रः शमश्च ते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2213349, "chapter_id": 5556, "verse_number": "१२", "content_sanskrit": "अपि मज्जननी चेयं शुश्रूषुर्विगतक्लमा ।\nअप्यस्याः सफलो राजन् वनवासो भविष्यति\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2213350, "chapter_id": 5556, "verse_number": "१३", "content_sanskrit": "इयं च माता ज्येष्ठा मे शीतवाताध्वकर्शिता ।\nघोरेण तपसा युक्ता देवी कच्चिन्न शोचति\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2213351, "chapter_id": 5556, "verse_number": "१४", "content_sanskrit": "गतान् पुत्रान् महावीर्यान् क्षत्रधर्मपरायणान्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2213352, "chapter_id": 5556, "verse_number": "१५", "content_sanskrit": "नाध्यापयति वा कच्चिद् अस्मान् पापकृतः सदा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2213353, "chapter_id": 5556, "verse_number": "१६", "content_sanskrit": "क्व चासौ विदुरो राजन् नैनं पश्यामहे वयम् ।\nसञ्जयः कुशली चापि कच्चित् तपसि च स्थिरः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2213354, "chapter_id": 5556, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2213355, "chapter_id": 5556, "verse_number": "१७", "content_sanskrit": "इत्युक्तः प्रत्युवाचैनं धृतराष्ट्रो जनाधिपः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2213356, "chapter_id": 5556, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2213357, "chapter_id": 5556, "verse_number": "१८", "content_sanskrit": "कुशली विदुरः पुत्र तपो घोरं समास्थितः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2213358, "chapter_id": 5556, "verse_number": "१९", "content_sanskrit": "वायुभक्षो निराहारः कृशो धमनिसन्ततः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2213359, "chapter_id": 5556, "verse_number": "२०", "content_sanskrit": "कदाचिद् दृश्यते विप्रैः शून्येऽस्मिन् कानने क्वचित्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2213360, "chapter_id": 5556, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2213361, "chapter_id": 5556, "verse_number": "२१", "content_sanskrit": "इत्येवं वदतस्तस्य जटादिग्धमुखः कृशः ।\nदिग्वासा मलदिग्धाङ्गो वनरेणुसमुक्षितः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2213362, "chapter_id": 5556, "verse_number": "", "content_sanskrit": "दूरादालक्षितः क्षत्ता तत्राख्यातो महीपते ।\n(विदुरस्त्वेष धर्मात्मा जनं दृष्ट्वा निवर्तते\t॥२२॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2213363, "chapter_id": 5556, "verse_number": "२३", "content_sanskrit": "निवर्तमानं सहसा जनं दृष्ट्वाऽऽश्रमं प्रति ।\nतमन्वधावन्नृपतिरेक एव युधिष्ठिरः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2213364, "chapter_id": 5556, "verse_number": "२४", "content_sanskrit": "प्रविशन्तं वनं घोरं लक्ष्यालक्ष्यं क्वचित् क्वचित्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2213365, "chapter_id": 5556, "verse_number": "२५", "content_sanskrit": "भो भो विदुर राजाऽहं दयितस्ते युधिष्ठिरः ।\nइति ब्रुवन् नरपतिर्यत्नात् तमनुजग्मिवान्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2213366, "chapter_id": 5556, "verse_number": "२६", "content_sanskrit": "ततो विविक्त एकान्ते तस्थौ बुद्धिमतां वरः ।\nविदुरो वृक्षमाश्रित्य कञ्चित् तस्मिन् वनान्तरे\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2213367, "chapter_id": 5556, "verse_number": "२७", "content_sanskrit": "तं राजा क्षीणभूयिष्ठमाकृतीमात्रसूचितम् ।\nअभिजज्ञे महाबुद्धिं महाबुद्धिर्युधिष्ठिरः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2213368, "chapter_id": 5556, "verse_number": "२८", "content_sanskrit": "युधिष्ठिरोऽहमस्मीति वाक्यमुक्त्वाऽग्रतः स्थितः ।\nविदुरस्याश्रमे राजा स च प्रत्याह सञ्ज्ञया\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2213369, "chapter_id": 5556, "verse_number": "२९", "content_sanskrit": "ततः सोऽनिमिषो भूत्वा राजानं समुदैक्षत ।\nसंयोज्य विदुरस्तस्मिन् दृष्ट्या दृष्टिं समाहितः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2213370, "chapter_id": 5556, "verse_number": "३०", "content_sanskrit": "विवेश विदुरो धीमान् गात्रैर्गात्राणि चैव हि ।\nप्राणान् प्राणेषु च दधद् इन्द्रियाणीन्द्रियेषु च\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2213371, "chapter_id": 5556, "verse_number": "३१", "content_sanskrit": "स योगबलमास्थाय विवेश नृपतेस्तनुम् ।\nविदुरो धर्मराजस्य तेजसा प्रज्वलन्निव\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2213372, "chapter_id": 5556, "verse_number": "३२", "content_sanskrit": "विदुरस्य शरीरं तु तथैव स्तब्धलोचनम् ।\nवृक्षाश्रितं तदा राजा ददर्श गतचेतनम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2213373, "chapter_id": 5556, "verse_number": "३३", "content_sanskrit": "बलस्थमपि चात्मानं मेने बहुगुणं तदा ।\nधर्मराजो महाराजस्तं च सस्मार पाण्डवः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2213374, "chapter_id": 5556, "verse_number": "३४", "content_sanskrit": "पौराणमात्मनः सर्वं भविष्यं च नराधिप ।\nयोगधर्मं महातेजा व्यासेन कथितं तथा\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2213375, "chapter_id": 5556, "verse_number": "३५", "content_sanskrit": "धर्मराजस्तु तत्रैनं सञ्चस्कारयिषुस्तदा ।\nदग्धुकामोऽभवद् विद्वान् अथाकाशे वचोऽब्रवीत्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2213376, "chapter_id": 5556, "verse_number": "", "content_sanskrit": "वाक्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2213377, "chapter_id": 5556, "verse_number": "३६", "content_sanskrit": "भो भो राजन् न दग्धव्यम् एतद्विदुरसञ्ज्ञकम् ।\nकलेवरमिहैतत् ते नैष धर्मः सनातनः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2213378, "chapter_id": 5556, "verse_number": "३७", "content_sanskrit": "लोकवैकर्मणा नाम भविष्यत्यस्य पार्थिव ।\nयतिधर्ममवाप्तोऽसौ न शोच्यो भरतर्षभ\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2213379, "chapter_id": 5556, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2213380, "chapter_id": 5556, "verse_number": "३८", "content_sanskrit": "इत्युक्तो धर्मराजस्तु विनिवृत्य महामनाः ।\nराज्ञो वैचित्रवीर्यस्य तत्सर्वं प्रत्यवेदयत्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2213381, "chapter_id": 5556, "verse_number": "३९", "content_sanskrit": "ततः स राजा धृतिमान् स च सर्वो जनस्तदा ।\nभीमसेनादयश्चैव परं विस्मयमागताः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2213382, "chapter_id": 5556, "verse_number": "४०", "content_sanskrit": "तच्छ्रुत्वा प्रीतिमान् राजन् भूत्वा धर्मजमब्रवीत्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2213383, "chapter_id": 5556, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2213384, "chapter_id": 5556, "verse_number": "४१", "content_sanskrit": "आपो मूलं फलं चैव ममैव प्रतिगृह्यताम् ।\nयदन्नो हि नरो राजन् तदन्नोऽस्यातिथिर्मतः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2213385, "chapter_id": 5556, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2213386, "chapter_id": 5556, "verse_number": "४२", "content_sanskrit": "इत्युक्तः स तथेत्येवं प्राह धर्मात्मजो नृपम् ।\nफलमूलं च बुभुजे राज्ञा दत्तं सहानुजः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2213387, "chapter_id": 5556, "verse_number": "४३", "content_sanskrit": "ततस्ते वृक्षमूलेषु कृतवासपरिग्रहाः ।\nतां रात्रिं न्यवसन् सर्वे फलमूलकृतव्रताः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2213388, "chapter_id": 5556, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्रमवासिकपर्वणि\nविदुरस्य धर्मराजप्रवेशो नाम द्वात्रिंशोऽध्यायः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2213389, "chapter_id": 5556, "verse_number": "", "content_sanskrit": "आश्रमवासपर्वणि द्वात्रिंशोऽध्यायः ॥३२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]