[{"id": 2208037, "chapter_id": 5440, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2208038, "chapter_id": 5440, "verse_number": "१", "content_sanskrit": "नाहं तथा भीरु चरामि लोके\nयथा त्वं मां तर्कयसे स्वबुद्ध्या ।\nविप्रोऽस्मि मुक्तोऽस्मि वनेचरोऽस्मि\nगृहस्थधर्मा ब्रह्मचारी तथाऽस्मि ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2208039, "chapter_id": 5440, "verse_number": "२", "content_sanskrit": "नाहमस्मि यथा मां त्वमीक्षसे चक्षुषा शुभे ।\nमया व्याप्तमिदं सर्वं यत् किञ्चिज्जगतीगतम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2208040, "chapter_id": 5440, "verse_number": "३", "content_sanskrit": "ये केचिदिह वै लोके जङ्गमाः स्थावराश्च ह ।\nतेषामन्तर्गतं विद्धि दारूणामिव पावकम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2208041, "chapter_id": 5440, "verse_number": "४", "content_sanskrit": "राज्यं पृथिव्यां सर्वस्यामथवा यत् त्रिविष्टपे ।\nतन्मे बुद्धिरियं वेत्ति बुद्धिरेव धनं मम ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2208042, "chapter_id": 5440, "verse_number": "५", "content_sanskrit": "एकः पन्था ब्राह्मणानां येन गच्छन्ति तद्विदः ।\nगृहेषु वनवासेषु गुरुवासेषु भिक्षुषु ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2208043, "chapter_id": 5440, "verse_number": "६", "content_sanskrit": "लिङ्गैर्बहुभिरव्यग्रैरेका बुद्धिरुपास्यते ।\nनानालिङ्गाश्रमस्थानां येषां बुद्धिः शमात्मिका ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2208044, "chapter_id": 5440, "verse_number": "७", "content_sanskrit": "ते भावमेकमायान्ति सरितः सागरं यथा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2208045, "chapter_id": 5440, "verse_number": "८", "content_sanskrit": "बुद्ध्याऽयं गम्यते मार्गः शरीरेण न गम्यते ।\nआद्यन्तवन्ति कर्माणि शरीरं कर्मबन्धनम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2208046, "chapter_id": 5440, "verse_number": "९", "content_sanskrit": "तस्मान्मे सुभगे नास्ति परलोककृतं भयम् ।\nमद्भावभावनिरता ममैवात्मानमेष्यति ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2208047, "chapter_id": 5440, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि अनुगीतासु विप्राणां सन्मार्गकथनं नाम चतुःत्रिंशोऽध्यायः ॥३४॥\nअनुगीतापर्वणि एकोनविंशोऽध्यायः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]