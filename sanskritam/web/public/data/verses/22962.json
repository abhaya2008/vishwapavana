[{"id": 7002962000, "chapter_id": 22962, "verse_number": "२-९-१", "content_sanskrit": "नारद उवाच ।\nभूमिदानकृतं पुण्यं पापं तद्धरणेन यत् ।\nपरभूमौ श्राद्धरूपं कूपे कुपदजं तथा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002962001, "chapter_id": 22962, "verse_number": "२-९-२", "content_sanskrit": "अम्बुवीचीभूखननबीजत्यागजमेव च ।\nदीपादिस्थापनात्पापं श्रोतुमिच्छामि यत्नतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002962002, "chapter_id": 22962, "verse_number": "२-९-३", "content_sanskrit": "अन्यद्वा पृथिवीजन्यं पापं यत्प्रश्नतः परम् ।\nयदस्ति तत्प्रतीकारं वद वेदविदां वर ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002962003, "chapter_id": 22962, "verse_number": "२-९-४", "content_sanskrit": "नारायण उवाच ।\nवितस्तिमात्रं भूमिं च यो ददाति च भारते ।\nसन्ध्यापूताय विप्राय स यायाद्विष्णुमन्दिरम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002962004, "chapter_id": 22962, "verse_number": "२-९-५", "content_sanskrit": "भूमिं च सर्वसस्याढ्या ब्राह्मणाय ददाति यः ।\nभूमिरेणुप्रमाणे च वर्षे विष्णुपदे वसेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002962005, "chapter_id": 22962, "verse_number": "२-९-६", "content_sanskrit": "ग्रामं भूमिं च धान्यं च यो ददात्याददाति यः ।\nसर्वपापाद्विनिर्मुक्तौ चोभौ वैकुण्ठवासिनौ ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002962006, "chapter_id": 22962, "verse_number": "२-९-७", "content_sanskrit": "भूमिदानं च तत्काले यः साधुश्चानुमोदते ।\nस प्रयाति च वैकुण्ठं मित्रगोत्रसमन्वितः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002962007, "chapter_id": 22962, "verse_number": "२-९-८", "content_sanskrit": "स्वदत्तां परदत्तां वा ब्रह्मवृत्तिं हरेत्तु यः ।\nकालसूत्रे तिष्ठति स यावच्चन्द्रदिवाकरौ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002962008, "chapter_id": 22962, "verse_number": "२-९-९", "content_sanskrit": "तत्पुत्रपौत्रप्रभृतिर्भूमिहीनः श्रिया हतः ।\nसुखहीनो दरिद्रः स्यादन्ते याति च रौरवम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002962009, "chapter_id": 22962, "verse_number": "२-९-१०", "content_sanskrit": "गवां मार्गं विनिष्कृष्य यश्च सस्यं ददाति सः ।\nदिव्यं वर्षशतं चैव कुम्भीपाके च तिष्ठति ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002962010, "chapter_id": 22962, "verse_number": "२-९-११", "content_sanskrit": "गोष्ठं तडागं निष्कृष्य मार्गं सस्यं ददाति यः ।\nस च तिष्ठत्यसीपत्रे यावदिन्द्राश्चतुर्दश ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002962011, "chapter_id": 22962, "verse_number": "२-९-१२", "content_sanskrit": "न पञ्चपिण्डमुद्धृत्य स्नाति कूपे परस्य यः ।\nप्राप्नोति नरकं चैव न स्नानफलमेव च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002962012, "chapter_id": 22962, "verse_number": "२-९-१३", "content_sanskrit": "कामी भूमौ च रहसि बीजत्यागं करोति यः ।\nस्निग्धरेणुप्रमाणं च वर्षं तिष्ठति रौरवे ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002962013, "chapter_id": 22962, "verse_number": "२-९-१४", "content_sanskrit": "अम्बुवीच्यम्बुखननं यः करोति च मानवः ।\nस याति कृमिदंशं च स्थितिस्तत्र चतुर्युगम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002962014, "chapter_id": 22962, "verse_number": "२-९-१५", "content_sanskrit": "परकीये लुप्तकूपे कूपं मूढः करोति यः ।\nपुष्करिण्यां च लुप्तायां तां ददाति च यो नरः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002962015, "chapter_id": 22962, "verse_number": "२-९-१६", "content_sanskrit": "सर्वं फलं परस्यैव तप्तसूर्मिं व्रजेत्तु सः ।\nतत्र तिष्ठति संतप्तो यावदिद्राश्चतुर्दश ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002962016, "chapter_id": 22962, "verse_number": "२-९-१७", "content_sanskrit": "परकीयतडागे च पङ्कमुद्धृत्य चोत्सृजेत् ।\nरेणुप्रमाणवर्षं च ब्रह्मलोके वसेन्नरः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002962017, "chapter_id": 22962, "verse_number": "२-९-१८", "content_sanskrit": "पिण्डं पित्रे भूतिभर्त्तुर्न प्रदाय च मानवः ।\nश्राद्धं करोति यो मूढो नरकं याति निश्चितम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002962018, "chapter_id": 22962, "verse_number": "२-९-१९", "content_sanskrit": "भूमौ दीपं योऽर्पयति सोऽन्धः सप्तसु जन्मसु ।\nभूमौ शंखं च संस्थाप्य कुष्ठं जन्मान्तरे लभेत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002962019, "chapter_id": 22962, "verse_number": "२-९-२०", "content_sanskrit": "मुक्तामाणिक्यहीरं च सुवर्णं च मणिं तथा ।\nयश्च संस्थापयेद्भूमौ दरिद्रः सप्तजन्मसु ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002962020, "chapter_id": 22962, "verse_number": "२-९-२१", "content_sanskrit": "शिवलिङ्गं शिलामर्च्यां यश्चार्पयति भूतले ।\nशतमन्वन्तरं यावत्कृमिभक्षे स तिष्ठति ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002962021, "chapter_id": 22962, "verse_number": "२-९-२२", "content_sanskrit": "सूक्तं मन्त्रं शिलातोयं पुष्पं च तुलसीदलम् ।\nयश्चार्पयति भूमौ च स तिष्ठेन्नरके युगम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002962022, "chapter_id": 22962, "verse_number": "२-९-२३", "content_sanskrit": "जपमालां पुष्पमालां कर्पूरं रोचनां तथा ।\nयो मूढश्चार्पयेद्भूमौ स याति नरकं ध्रुवम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002962023, "chapter_id": 22962, "verse_number": "२-९-२४", "content_sanskrit": "मुने चन्दनकाष्ठं च रुद्राक्षं कुशमूलकम् ।\nसंस्थाप्य भूमौ नरके वसेन्मन्वन्तरावधि ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002962024, "chapter_id": 22962, "verse_number": "२-९-२५", "content_sanskrit": "पुस्तकं यज्ञसूत्रं च भूमौ संस्थापयेत्तु यः ।\nन भवेद्विप्रयोनौ च तस्य जन्मान्तरे जनिः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002962025, "chapter_id": 22962, "verse_number": "२-९-२६", "content_sanskrit": "ब्रह्महत्यासमं पापमिह वै लभते ध्रुवम् ।\nग्रन्थियुक्तं यज्ञसूत्रं पूज्यं स्यात्सर्ववर्णकैः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002962026, "chapter_id": 22962, "verse_number": "२-९-२७", "content_sanskrit": "यज्ञं कृत्वा तु यो भूमिं क्षीरेण नहि सिञ्चति ।\nस याति तप्तसूर्मिं च संतप्तः सर्वजन्मसु ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002962027, "chapter_id": 22962, "verse_number": "२-९-२८", "content_sanskrit": "भूकम्पे ग्रहणे यो हि करोति खननं भुवः ।\nजन्मान्तरे महापापी सोऽङ्गहीनो भवेद्ध्रुवम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002962028, "chapter_id": 22962, "verse_number": "२-९-२९", "content_sanskrit": "भवनं यत्र सर्वेषां भूमिस्तेन प्रकीर्त्तिता ।\nवसुरत्नं या दधाति वसुधा च वसुन्धरा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002962029, "chapter_id": 22962, "verse_number": "२-९-३०", "content_sanskrit": "हरेरूरौ च या जाता सा चोर्वी परिकीर्त्तिता ।\nधरा धरित्री धरणी सर्वेषां धरणात्तु या ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002962030, "chapter_id": 22962, "verse_number": "२-९-३१", "content_sanskrit": "इज्या च यागभरणात्क्षोणी क्षीणा लये च या ।\nमहालये क्षयं याति क्षितिस्तेन प्रकीर्तिता ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002962031, "chapter_id": 22962, "verse_number": "२-९-३२", "content_sanskrit": "काश्यपी कश्यपस्येयमचला स्थितिरूपतः ।\nविश्वम्भरा तद्धरणाच्चानन्ताऽनन्तरूपतः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002962032, "chapter_id": 22962, "verse_number": "२-९-३३", "content_sanskrit": "पृथ्वी पृधुककन्यात्वाद्विस्तृतत्वान्मही मुने ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]