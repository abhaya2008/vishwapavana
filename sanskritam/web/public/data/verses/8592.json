[{"id": 900007784, "chapter_id": 8592, "verse_number": "173.1", "content_sanskrit": "नात्मेत्युपासना", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900007785, "chapter_id": 8592, "verse_number": "173.2", "content_sanskrit": "स नेति युक्तिस्तत्रापि समेत्युक्तविरुद्धता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900007786, "chapter_id": 8592, "verse_number": "173.3", "content_sanskrit": "यद्यप्युत्कर्षमात्रेण ह्यतद्भावेऽप्युपासना", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900007787, "chapter_id": 8592, "verse_number": "173.4", "content_sanskrit": "उत्कर्षाद्ब्रह्मताध्याने यदि स्यात्फलमञ्जसा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900007788, "chapter_id": 8592, "verse_number": "173.5", "content_sanskrit": "चण्डालो नृप इत्युक्ते नृपश्चण्डाल इत्यपि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900007789, "chapter_id": 8592, "verse_number": "173.6", "content_sanskrit": "पुरतो नरदेवस्य चण्डालो यदि पूज्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900007790, "chapter_id": 8592, "verse_number": "173.7", "content_sanskrit": "अभेदेनैतयोर्ध्याने को विशेषो वचस्यपि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900007791, "chapter_id": 8592, "verse_number": "173.8", "content_sanskrit": "तस्मादपेशलं सर्वमन्यस्य ब्रह्मतावचः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}]