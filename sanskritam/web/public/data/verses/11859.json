[{"id": 50024469, "chapter_id": 11859, "verse_number": "1", "content_sanskrit": "॥ आजीगर्तिः शुनःशेपः। १-४ इन्द्रः, ५-६ उलूखलः, ७-८ फलकौ, ९ सोमः। १-६ अनुष्टुप्, ७-९ गायत्री ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024470, "chapter_id": 11859, "verse_number": "2", "content_sanskrit": "यत्र॒ ग्रावा॑ पृ॒थुबु॑ध्न ऊ॒र्ध्वो भव॑ति॒ सोत॑वे। उ॒लूख॑लसुताना॒मवेद्वि॑न्द्र जल्गुलः॥ २८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024471, "chapter_id": 11859, "verse_number": "3", "content_sanskrit": "यत्र॒ द्वावि॑व ज॒घना॑धिषव॒ण्या॑ कृ॒ता। उ॒लूख॑लसुताना॒मवेद्वि॑न्द्र जल्गुलः॥ २८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024472, "chapter_id": 11859, "verse_number": "4", "content_sanskrit": "यत्र॒ नार्य॑पच्य॒वमु॑पच्य॒वं च॒ शिक्ष॑ते। उ॒लूख॑लसुताना॒मवेद्वि॑न्द्र जल्गुलः॥ २८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50024473, "chapter_id": 11859, "verse_number": "5", "content_sanskrit": "यत्र॒ मन्थां॑ विब॒ध्नते॑ र॒श्मीन्यमि॑त॒वा इ॑व। उ॒लूख॑लसुताना॒मवेद्वि॑न्द्र जल्गुलः॥ २८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50024474, "chapter_id": 11859, "verse_number": "6", "content_sanskrit": "यच्चि॒द्धि त्वं गृ॒हेगृ॑ह॒ उलू॑खलक यु॒ज्यसे॑। इ॒ह द्यु॒मत्त॑मं वद॒ जय॑तामिव दुन्दु॒भिः॥ २८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50024475, "chapter_id": 11859, "verse_number": "7", "content_sanskrit": "उ॒त स्म॑ ते वनस्पते॒ वातो॒ वि वा॒त्यग्र॒मित्। अथो॒ इन्द्रा॑य॒ पात॑वे सु॒नु सोम॑मुलूखल॥ २८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50024476, "chapter_id": 11859, "verse_number": "8", "content_sanskrit": "आ॒य॒जी वा॑ज॒सात॑मा॒ ता ह्यु१॒॑च्चा वि॑जर्भृ॒तः। हरी॑ इ॒वान्धां॑सि॒ बप्स॑ता॥ २८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50024477, "chapter_id": 11859, "verse_number": "9", "content_sanskrit": "उच्छि॒ष्टं च॒म्वो॑र्भर॒ सोमं॑ प॒वित्र॒ आ सृ॑ज। नि धे॑हि॒ गोरधि॑ त्व॒चि॥ २८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]