[{"id": 900008467, "chapter_id": 8638, "verse_number": "19.1", "content_sanskrit": "अत्र यद्यपि वैश्वानरनाम्नः सूत्र एवाग्नाविष्णोः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008468, "chapter_id": 8638, "verse_number": "19.2", "content_sanskrit": "अत्र वैश्वानरः किमग्न्यादिः किं वा ब्रह्मेति चिन्ता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008469, "chapter_id": 8638, "verse_number": "19.3", "content_sanskrit": "न चान्तराद्यधिकरणन्यायेन", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008470, "chapter_id": 8638, "verse_number": "19.4", "content_sanskrit": "सिद्धान्तस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900008471, "chapter_id": 8638, "verse_number": "19.5", "content_sanskrit": "अत्र चाद्यसूत्रे स्वपक्षे श्रुतिरूपस्य साधकस्योक्तिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900008472, "chapter_id": 8638, "verse_number": "19.6", "content_sanskrit": "अन्येतु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]