[{"id": 2035246, "chapter_id": 1763, "verse_number": "५-८-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2035247, "chapter_id": 1763, "verse_number": "५-८-१", "content_sanskrit": "शल्यः श्रुत्वा तु दूतानां सैन्येन महता वृतः।\nअभ्यात्पाण्डवान्राजन्सह पुत्रैर्महारथैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2035248, "chapter_id": 1763, "verse_number": "५-८-२", "content_sanskrit": "तस्य सेनानिवेशोऽभूदध्वर्धमिव योजनम् ।\nतथा हि विपुलां सेनां बिभर्ति स नरर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2035249, "chapter_id": 1763, "verse_number": "५-८-३", "content_sanskrit": "अक्षौहिणीपती राजन्महावीर्यपराक्रमाः।\nविचित्रकवचाः शूरा विचित्रध्वजकार्मुकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2035250, "chapter_id": 1763, "verse_number": "५-८-४", "content_sanskrit": "विचित्राभरणाः सर्वे विचित्ररथवाहनाः ।\nविचित्रस्रग्धराः सर्वे विवित्राम्बरभूषणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2035251, "chapter_id": 1763, "verse_number": "५-८-५", "content_sanskrit": "स्वदेशवेषाभरणा वीराः शतसहस्रशः।\nतस्य सेनाप्रणेतारो बभूवुः क्षत्रियर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2035252, "chapter_id": 1763, "verse_number": "५-८-६", "content_sanskrit": "व्यथयन्निव भूतानि कम्पयन्निव मेदिनीम् ।\nशनैर्विश्रामयन्सेनां स ययौ यत्र पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2035253, "chapter_id": 1763, "verse_number": "५-८-७", "content_sanskrit": "ततो दुर्योधनः श्रुत्वा महात्मानं महारथम् ।\nउपायान्तमभिद्रुत्य स्वयमानर्च भरत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2035254, "chapter_id": 1763, "verse_number": "५-८-८", "content_sanskrit": "कारयामास पूजार्थं तस्य दुर्योधनः सभाः ।\nरमणीयेषु देशेषु रत्नचित्राः स्वलङ्कृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2035255, "chapter_id": 1763, "verse_number": "५-८-९", "content_sanskrit": "शिल्पिभिर्विविधैश्चैव क्रीडास्तत्र प्रयोजिताः ।\nतत्र माल्यानि मांसानि भक्ष्यं पेयं च सत्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2035256, "chapter_id": 1763, "verse_number": "५-८-१०", "content_sanskrit": "कूपाश्च विविधाकारा औदकानि गृहाणि च ॥\nस ताः सभाः समासाद्य पूज्यमानो यथाऽमरः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2035257, "chapter_id": 1763, "verse_number": "५-८-११", "content_sanskrit": "दुर्योधनस्य सचिवैर्देशे देशे समन्ततः ॥\nआजगाम सभामन्यां देवावसथवर्चसम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2035258, "chapter_id": 1763, "verse_number": "५-८-१२", "content_sanskrit": "स तत्र विषयैर्युक्तैः कल्याणैरतिमानुषैः ॥\nमेनेऽभ्यधिकमात्मानमवमेने पुरन्दरम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2035259, "chapter_id": 1763, "verse_number": "५-८-१३", "content_sanskrit": "पप्रच्छ स ततः प्रेष्यान्प्रहृष्टः क्षत्रियर्षभः ॥\nयुधिष्ठिरस्य पुरुषाः केऽत्र चक्रुः सभा इमाः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2035260, "chapter_id": 1763, "verse_number": "५-८-१४", "content_sanskrit": "आनीयन्तां सभाकाराः प्रदेयार्हा हि मे मताः ॥\nप्रदेयमेषां दास्यामि कुन्तीपुत्रोऽनुमन्यताम्। ५-८-१५a` ततः प्रहृष्टं राजानं ज्ञात्वा ते सचिवास्तदा\nदुर्योधनाय तत्सर्वं कथयन्ति स्म विस्मिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2035261, "chapter_id": 1763, "verse_number": "५-८-१६", "content_sanskrit": "संप्रहृष्टो यदा शल्यो दिदित्सुरपि जीवितम् ।\nगूढो दुर्योधनस्तत्र दर्शयामास मातुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2035262, "chapter_id": 1763, "verse_number": "५-८-१७", "content_sanskrit": "तं दृष्ट्वा मद्रराजश्च ज्ञात्वा यत्नं च तस्य तम्।\nपरिष्वज्याब्रवीत्प्रीत इष्टोऽर्थो ध्रियतामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2035263, "chapter_id": 1763, "verse_number": "५-८-१८x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2035264, "chapter_id": 1763, "verse_number": "५-८-१८", "content_sanskrit": "सत्यवाग्भव कल्याण वरो वै मम दीयताम्।\nसर्वसेनाप्रणेता वै भवान्भवितुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2035265, "chapter_id": 1763, "verse_number": "५-८-१९", "content_sanskrit": "यथैव पाण्डवास्तुभ्यं तथैव भवतो ह्यहम्।\nअनुमान्यं च पाल्यं च भक्तं च भज मां विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2035266, "chapter_id": 1763, "verse_number": "५-८-२०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2035267, "chapter_id": 1763, "verse_number": "५-८-२०", "content_sanskrit": "कृतमित्यब्रवीच्छल्यः किमन्यत्क्रियतामिति।\nकृतमित्येव गान्धारिः प्रत्युवाच पुनःपुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2035268, "chapter_id": 1763, "verse_number": "५-८-२१x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2035269, "chapter_id": 1763, "verse_number": "५-८-२१", "content_sanskrit": "गच्छ दुर्योधन पुरं स्वकमेव नरर्षभ ।\nअहं गमिष्ये द्रुष्टुं वै युधिष्ठिरमरिंदमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2035270, "chapter_id": 1763, "verse_number": "५-८-२२", "content_sanskrit": "दृष्ट्वा युधिष्ठिरं राजन्क्षिप्रमेष्ये नराधिप ।\nअवश्यं चापि द्रष्टव्यः पाण्डवः पुरुषर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2035271, "chapter_id": 1763, "verse_number": "५-८-२३x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2035272, "chapter_id": 1763, "verse_number": "५-८-२३", "content_sanskrit": "क्षिप्रामागम्यतां राजन्पाण्डवं वीक्ष्य पार्थिव ।\nत्वय्यधीनाः स्म राजेन्द्र वरदानं स्मरस्व नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2035273, "chapter_id": 1763, "verse_number": "५-८-२४x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2035274, "chapter_id": 1763, "verse_number": "५-८-२४", "content_sanskrit": "क्षिप्रमेष्यामि भद्रं ते गच्छस्व स्वपुरं नृप।\n` दृष्ट्वा तु पाण्डवान्राजन्न मिथ्या कर्तुमुत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2035275, "chapter_id": 1763, "verse_number": "५-८-२५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2035276, "chapter_id": 1763, "verse_number": "५-८-२५", "content_sanskrit": "पर्यष्वजेतामन्योन्यं शल्यदुर्योधनावुभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2035277, "chapter_id": 1763, "verse_number": "५-८-२६", "content_sanskrit": "स तथा शल्यमामन्त्र्य पुरायात्स्वकं पुरम्।\nशल्यो जगाम कौन्तेयानाख्यातुं कर्म तस्य तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2035278, "chapter_id": 1763, "verse_number": "५-८-२७", "content_sanskrit": "उपप्लाव्यं स गत्वा तु स्कन्धावारं प्रविश्य च।\nपाण्डवानथ तान्सर्वाञ्शल्यस्तत्र ददर्श ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2035279, "chapter_id": 1763, "verse_number": "५-८-२८", "content_sanskrit": "चिरात्तु दृष्ट्वा राजानं मातुलं समितिञ्जयम्।\nआसनेभ्यः समुत्पेतुः सर्वे सहयुधिष्ठिराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2035280, "chapter_id": 1763, "verse_number": "५-८-२९", "content_sanskrit": "तथा भीमार्जुनौ हृष्टौ स्वस्त्रीयौ च यमावुभौ ।\nद्रौपदी च सुभद्रा च अभिमन्युश्च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2035281, "chapter_id": 1763, "verse_number": "५-८-३०", "content_sanskrit": "समेत्य च महापाहुं शल्यं पाण्डुसुतस्तदा ।\nपाद्यमर्घ्यं च गां चैव प्रतिग्राह्य पुरोधसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2035282, "chapter_id": 1763, "verse_number": "५-८-३१", "content_sanskrit": "कताञ्जलिरदीनात्मा धर्मात्मा शल्यमब्रवीत्।\nस्वागतं तेऽस्तु वै राजन्नेतदासनमास्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2035283, "chapter_id": 1763, "verse_number": "५-८-३२", "content_sanskrit": "ततो न्यषीदच्छल्यश्च काञ्चने परमासने ।\nतत्र पाद्यथार्घ्यं च न्यवेदयत पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2035284, "chapter_id": 1763, "verse_number": "५-८-३३x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2035285, "chapter_id": 1763, "verse_number": "५-८-३३", "content_sanskrit": "दुःखस्यैतस्य महतो धार्तराष्ट्रकृतस्य वै।\nअवाप्स्यसि फलं राजन्हत्वा शत्रून्परन्तप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2035286, "chapter_id": 1763, "verse_number": "५-८-३४", "content_sanskrit": "विदितं ते महाराज लोकतन्त्रं नराधिप ।\nतस्माल्लोककृतं किञ्चित्तव तात न विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2035287, "chapter_id": 1763, "verse_number": "५-८-३५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2035288, "chapter_id": 1763, "verse_number": "५-८-३५", "content_sanskrit": "निवेद्य चार्घ्यं विधिवन्मद्रराजाय भारत।\nकुशलं पाण्डवोऽपृच्छच्छल्यं सर्वसुखावहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2035289, "chapter_id": 1763, "verse_number": "५-८-३६", "content_sanskrit": "स तैः परिवृतः सर्वैः पाण्डवैर्धर्मचारिभिः ।\nआसने चोपविष्टः स शल्यः पार्थमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2035290, "chapter_id": 1763, "verse_number": "५-८-३७x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2035291, "chapter_id": 1763, "verse_number": "५-८-३७", "content_sanskrit": "कुशलं राजशार्दूल सर्वत्र कुरुनन्दन ।\nअरण्यवासाद्दिष्ट्याऽसि विमुक्तो जयतां वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2035292, "chapter_id": 1763, "verse_number": "५-८-३८", "content_sanskrit": "दुष्करं ते कृतं राजन्निर्जने गहने वने।\nभ्रातृभिः सह कौन्तेय कृष्णाया चानयाऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2035293, "chapter_id": 1763, "verse_number": "५-८-३९", "content_sanskrit": "अज्ञातवासं घोरं च वसता दुष्करं कृतम् ।\nदुःखमेव कुतः सौख्यं राज्यभ्रष्टस्य भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2035294, "chapter_id": 1763, "verse_number": "५-८-४०", "content_sanskrit": "सत्ये तपसि दाने च तव बुद्धिर्युधिष्ठिर ।\nक्षमा दमश्चाहिंसा च सत्यं चैव युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2035295, "chapter_id": 1763, "verse_number": "५-८-४१", "content_sanskrit": "अद्भुतश्च पुनर्लोकस्त्वयि राजन्प्रतिष्ठितः।\nमृदुर्वदान्यो ब्रह्मण्यो दान्तो धर्मपरायणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2035296, "chapter_id": 1763, "verse_number": "५-८-४२", "content_sanskrit": "धर्मास्ते विदिता राजन्बहवो लोकसाक्षिकाः ।\nसर्वं जगदिदं तात विदितं ते परन्तप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2035297, "chapter_id": 1763, "verse_number": "५-८-४३", "content_sanskrit": "मुदितश्च पुनर्लोकस्त्वयि राजन्प्रतिष्ठिते ।\nदिष्ट्या कृच्छ्रमिदं राजन्पारितं भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2035298, "chapter_id": 1763, "verse_number": "५-८-४४", "content_sanskrit": "दिष्ट्या पश्यामि राजेन्द्र धर्मात्मानं सहानुगम्।\nनिस्तीर्णदुष्करं राजंस्त्वां धर्मनिचयं प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2035299, "chapter_id": 1763, "verse_number": "५-८-४५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2035300, "chapter_id": 1763, "verse_number": "५-८-४५", "content_sanskrit": "ततोऽस्याकथयद्राजा दुर्योधनसमागमम्।\nतच्च शुश्रूषितं सर्वं वरदानं च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2035301, "chapter_id": 1763, "verse_number": "५-८-४६x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2035302, "chapter_id": 1763, "verse_number": "५-८-४६", "content_sanskrit": "सुकृतं ते कृतं राजन्प्रहृष्टेनान्तरात्मना ।\nदुर्योधनस्य यद्वीर त्वया वाचा प्रतिश्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2035303, "chapter_id": 1763, "verse_number": "५-८-४७", "content_sanskrit": "एकं त्विच्छामि भद्रं ते क्रियमाणं महीपते ।\nराजन्नकर्तव्यमपि कर्तुमर्हसि सत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2035304, "chapter_id": 1763, "verse_number": "५-८-४८", "content_sanskrit": "मम त्ववेक्षया वीर शृणु विज्ञापयामि ते।\nभवानिह महाराज वासुदेवसमो युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2035305, "chapter_id": 1763, "verse_number": "५-८-४९", "content_sanskrit": "कर्णार्जुनाभ्यां संप्राप्ते द्वैरथे राजसत्तम ।\nकर्णस्य भवता कार्यं सारथ्यं नात्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2035306, "chapter_id": 1763, "verse_number": "५-८-५०", "content_sanskrit": "तत्र पाल्योऽर्जुनो राजन्यदि मत्प्रियमिच्छसि।\nतेजोवधश्च ते कार्यः सौतेरस्मञ्जयावह्नः ।\nअकर्तव्यमपि ह्येतत्कर्मुमर्हसि मातुल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2035307, "chapter_id": 1763, "verse_number": "५-८-५१x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2035308, "chapter_id": 1763, "verse_number": "५-८-५१", "content_sanskrit": "श्रृणु पाण्डव भद्रं ते यद्ब्रवीषि महात्मनः ।\nतेजोवधनिमित्तं मां सूतपुत्रस्य सङ्गमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2035309, "chapter_id": 1763, "verse_number": "५-८-५२", "content_sanskrit": "अहं तस्य भविष्यामि सङ्घ्रामे सारथिर्ध्रुवम्।\nवासुदेवेन हि समं नित्यं मां सोऽभिमन्यतो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2035310, "chapter_id": 1763, "verse_number": "५-८-५३", "content_sanskrit": "तस्याहं कुरुशार्दूल प्रतीपमहितं वचः।\nध्रुवं संकथयिष्यामि योद्धुकामस्य संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2035311, "chapter_id": 1763, "verse_number": "५-८-५४", "content_sanskrit": "यथा स हृतदर्पश्च हृततेजाश्च पाण्डव ।\nभविष्यति सुखं हन्तुं सत्यमेतद्ब्रवीमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2035312, "chapter_id": 1763, "verse_number": "५-८-५५", "content_sanskrit": "एवमेतत्करिष्यामि यथा तात त्वमात्थ माम्।\nयच्चान्यदपि शक्ष्यामि तत्करिष्यामि ते प्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2035313, "chapter_id": 1763, "verse_number": "५-८-५६", "content_sanskrit": "यच्च दुःखं त्वया प्राप्तं द्यूते वै कृष्णया सह।\nपरुषाणि च वाक्यानि सूतपुत्रकृतानि वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2035314, "chapter_id": 1763, "verse_number": "५-८-५७", "content_sanskrit": "जटासुरात्परिक्लेशः कीचकाच्च महाद्युते।\nद्रौपद्याऽधिगतं सर्वं दमयन्त्या यथाऽशुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2035315, "chapter_id": 1763, "verse_number": "५-८-५८", "content_sanskrit": "सर्वं दुःखमिदं वीर सुखोदर्कं भविष्यति।\nनात्र मन्युस्त्वया कार्यो विधिर्हि बलवत्तरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2035316, "chapter_id": 1763, "verse_number": "५-८-५९", "content_sanskrit": "दुःखानि हि महात्मानः प्राप्नुवन्ति युधिष्ठिर।\nदेवैरपि हि दुःखानि प्राप्तानि जगतीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2035317, "chapter_id": 1763, "verse_number": "५-८-६०", "content_sanskrit": "इन्द्रेण श्रूयते राजन्सभार्येण महात्मना ।\nअनुभूतं महद्दुःखं देवराजेन भारत ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2035318, "chapter_id": 1763, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि सेनोद्योगपर्वणि अष्टमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}]