[{"id": 2075378, "chapter_id": 2595, "verse_number": "१२-१००-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2075379, "chapter_id": 2595, "verse_number": "१२-१००-१", "content_sanskrit": "यथा जयार्थिनः सेनां नयन्ति भरतर्षभ।\nईषद्धर्मं प्रपीड्यापि तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2075380, "chapter_id": 2595, "verse_number": "१२-१००-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2075381, "chapter_id": 2595, "verse_number": "१२-१००-२", "content_sanskrit": "सन्त्येव हि स्थिता धर्म उपपत्त्या तथा परे।\nसाध्वाचारतया केचित्तथैवौपयिकादपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2075382, "chapter_id": 2595, "verse_number": "१२-१००-३", "content_sanskrit": "उपायधर्मान्वक्ष्यामि संसिद्धानर्थसिद्धये।\nनिर्मर्यादा दस्यवस्तु भवन्ति परिपन्थिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2075383, "chapter_id": 2595, "verse_number": "१२-१००-४", "content_sanskrit": "तेषां प्रतिविघातार्थं प्रवक्ष्याम्यथ नैगमम्।\nकार्याणां संप्रसिद्ध्यर्थं तानुपायान्निबोध मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2075384, "chapter_id": 2595, "verse_number": "१२-१००-५", "content_sanskrit": "उभे प्रज्ञे वेदितव्ये ऋज्वी वक्रा च भारत।\nजानन्वक्रां न सेवेत प्रतिबाधेत चागताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2075385, "chapter_id": 2595, "verse_number": "१२-१००-६", "content_sanskrit": "अमित्रा एव राजानं भेदेनोपचरन्त्युत।\nतां राजा विकृतिं जानन्यथाऽमित्रान्प्रबाधते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2075386, "chapter_id": 2595, "verse_number": "१२-१००-७", "content_sanskrit": "गजानां पार्थ वर्माणि गोवृषाजगराणि च।\nशल्यकण्टकलोहानि तनुत्राणि मतानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2075387, "chapter_id": 2595, "verse_number": "१२-१००-८", "content_sanskrit": "शातपीतानि शस्त्राणि सन्नाहाः पीतलोहकाः।\nनानारञ्जनरक्ताः स्युः पताकाः केतवश्च ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2075388, "chapter_id": 2595, "verse_number": "१२-१००-९", "content_sanskrit": "ऋष्टयस्तोमराः खङ्गा निशिताश्च परश्वथाः।\nफलकान्यथ चर्माणि प्रतिकल्प्यान्यनेकशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2075389, "chapter_id": 2595, "verse_number": "१२-१००-१०", "content_sanskrit": "अभिनीतानि शस्त्राणि योधाश्च कृतनिश्चयाः।\nचैत्रे वा मार्गशीर्षे वा सेनायोगः प्रशस्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2075390, "chapter_id": 2595, "verse_number": "१२-१००-११", "content_sanskrit": "पक्वसस्या हि पृथिवी भवत्यम्बुमती तदा।\nनैवातिशीतो नात्युष्णः कालो भवति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2075391, "chapter_id": 2595, "verse_number": "१२-१००-१२", "content_sanskrit": "तस्मात्तदा योजयेत परेषां व्यसनेऽथवा।\nएते हि योगाः सेनायाः प्रशस्ताः परबाधने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2075392, "chapter_id": 2595, "verse_number": "१२-१००-१३", "content_sanskrit": "जलवांस्तृणवान्मार्गः समो गम्यः प्रशस्यते।\nचारैः सुविदिताभ्यासः कुशलैर्वनगोचरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2075393, "chapter_id": 2595, "verse_number": "१२-१००-१४", "content_sanskrit": "न ह्यरण्यानि शक्यन्ते गन्तुं मृगगणैरिव।\nतस्मात्सेनासु तानेव योजयन्ति जयार्थिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2075394, "chapter_id": 2595, "verse_number": "१२-१००-१५", "content_sanskrit": "[अग्रतः पुरुषानीकं शक्तं चापि कुलोद्भवम्।]\nआवासस्तोयवान्मार्गः पर्याकाशः प्रशस्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2075395, "chapter_id": 2595, "verse_number": "१२-१००-१६", "content_sanskrit": "पोषामपसर्पाणां प्रतिघातस्तथा भवेत्।\nआकाशं हि वनाभ्याशे मन्यन्ते गुणवत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2075396, "chapter_id": 2595, "verse_number": "१२-१००-१७", "content_sanskrit": "बहुभिर्गुणजातैश्च ये युद्धकुशला जनाः।\n[उपन्यासो भवेत्तत्र बलानां नातिदूरतः॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2075397, "chapter_id": 2595, "verse_number": "१२-१००-१८", "content_sanskrit": "उपन्यासोऽपसर्पाणां पदातीनां च गूहनम्।\nहतशत्रुप्रतीघातमापदर्थं परायणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2075398, "chapter_id": 2595, "verse_number": "१२-१००-१९", "content_sanskrit": "सप्तर्पीन्पृष्ठतः कृत्वा युध्येयुरचला इव।\nअनेन विधिना शत्रूञ्जिगीषेतापि दुर्जयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2075399, "chapter_id": 2595, "verse_number": "१२-१००-२०", "content_sanskrit": "यतो वायुर्यतः सूर्यो यतः सोमस्ततो जयः।\nपूर्वंपूर्वं ज्याय एषां सन्निपाते युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2075400, "chapter_id": 2595, "verse_number": "१२-१००-२१", "content_sanskrit": "अकर्द -मनुदकाममर्यादामलोष्टकाम्।\nअश्वभूमिं प्रशंसन्ति ये युद्धकुशला जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2075401, "chapter_id": 2595, "verse_number": "१२-१००-२२", "content_sanskrit": "समा निरुदकाकाशा रथभूमिः प्रशस्यते।\nनीचद्रुमा महाकक्षा सोदका हस्तियोधिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2075402, "chapter_id": 2595, "verse_number": "१२-१००-२३", "content_sanskrit": "बहुदुर्गा महाकक्षा वेणुवेत्रतिरस्कृता।\nपदातीनां क्षमा भूमिः पर्वतोपवनानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2075403, "chapter_id": 2595, "verse_number": "१२-१००-२४", "content_sanskrit": "पदातिबहुला सेना दृढा भवति भारत।\nरथाश्वबहुला सेना सुदिनेषु प्रशस्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2075404, "chapter_id": 2595, "verse_number": "१२-१००-२५", "content_sanskrit": "पदातिनागबहुला प्रावृट्काले प्रशस्यते।\nगुणानेतान्प्रसंख्याय देशकालौ प्रयोजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2075405, "chapter_id": 2595, "verse_number": "१२-१००-२६", "content_sanskrit": "एवं संचिन्त्य यो याति तिथिनक्षत्रपूजितः।\nविजयं लभते नित्यं सेनां सम्यक्प्रयोजयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2075406, "chapter_id": 2595, "verse_number": "१२-१००-२७", "content_sanskrit": "प्रसुप्तांस्तृषिताञ्श्रान्तान्प्रकीर्णान्नाभिघातयेत्।\nमोक्षे प्रयाणे चलने पानभोजनकालयोः।\nअतिक्षिप्तान्व्यतिक्षिप्तान्निहतान्प्रतनूकृतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2075407, "chapter_id": 2595, "verse_number": "१२-१००-२८", "content_sanskrit": "अविस्रब्धान्कृतारम्भानुपन्यासात्प्रतापितान्।\nबहिश्वरानुपन्यासान्कृतवेश्मानुसारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2075408, "chapter_id": 2595, "verse_number": "१२-१००-२९", "content_sanskrit": "पारम्पर्यागते द्वारे ये केचिदनुवर्तिनः।\nपरिचर्यापरोद्धारो ये च केचन वल्गिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2075409, "chapter_id": 2595, "verse_number": "१२-१००-३०", "content_sanskrit": "अनीकं ये विभिदन्ति भिन्नं संस्थापयन्ति च।\nसमानाशनपानास्ते कार्या द्विगुणवेतनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2075410, "chapter_id": 2595, "verse_number": "१२-१००-३१", "content_sanskrit": "`जातिगोत्रं च विज्ञाय कर्म चानुत्तमं शुभम्।\nसमानदेहरक्षार्थे कार्या द्विगुणवेतनाः।\nत्रिगुणं चतुर्गुणं चैव वेतनं तेषु कारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2075411, "chapter_id": 2595, "verse_number": "१२-१००-३२", "content_sanskrit": "दशाधिपतयः कार्याः शताधिपतयस्तथा।\nततः सहस्राधिपतिं कुर्याच्छूरमतन्द्रितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2075412, "chapter_id": 2595, "verse_number": "१२-१००-३३", "content_sanskrit": "यथा मुख्यान्सन्निपात्य वक्तव्याः संशयामहे।\nयथा जयार्थं संग्रामे न जह्याम परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2075413, "chapter_id": 2595, "verse_number": "१२-१००-३४", "content_sanskrit": "इहैव ते निवर्तन्तां ये च केचन भीरवः।\nन घातयेयुः प्रदरं कुर्वाणास्तुमुले सति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2075414, "chapter_id": 2595, "verse_number": "१२-१००-३५", "content_sanskrit": "[न सन्निपाते प्रदरं वधं वा कुर्युरीदृशाः॥]\nआत्मानं च स्वपक्षं च पालयन्हन्ति संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2075415, "chapter_id": 2595, "verse_number": "१२-१००-३६", "content_sanskrit": "अर्थनाशो वधोऽकीर्तिरयशश्च पलायने।\nअमनोज्ञाऽसुखा वाचः पुरुषस्य पलायतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2075416, "chapter_id": 2595, "verse_number": "१२-१००-३७", "content_sanskrit": "प्रतिध्वस्तोष्ठदन्तस्य न्यस्तसर्वायुधस्य च।\n`हित्वा पलायमानस्य सहायान्प्राणसंशये।\nअमित्रैरवरुद्धस्य द्विषतामस्तु नः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2075417, "chapter_id": 2595, "verse_number": "१२-१००-३८", "content_sanskrit": "मनुष्यापसदा ह्येते ये भवन्ति पराङ्भुखाः।\nराशिवर्धनमात्रास्ते नैव ते प्रेत्य नो इह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2075418, "chapter_id": 2595, "verse_number": "१२-१००-३९", "content_sanskrit": "अमित्रा हृष्टमनसः प्रत्युद्यान्ति पलायिनम्।\nजयिनस्तु नरास्तात मङ्गलैर्वन्दनेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2075419, "chapter_id": 2595, "verse_number": "१२-१००-४०", "content_sanskrit": "यस्य स्म व्यसने राजन्ननुमोदन्ति शत्रवः।\nतदसह्यतरं दुःखं मन्यन्ते मरणादपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2075420, "chapter_id": 2595, "verse_number": "१२-१००-४१", "content_sanskrit": "श्रियं जानीत धर्मस्य मूलं सर्वसुखस्य च।\nया भीरूणां पराख्यातिः शूरस्तामधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2075421, "chapter_id": 2595, "verse_number": "१२-१००-४२", "content_sanskrit": "ते वयं स्वर्गमिच्छन्तः संग्रामे त्यक्तजीविताः।\nजयन्तो वध्यमाना वा प्राप्नुयाम च सद्गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2075422, "chapter_id": 2595, "verse_number": "१२-१००-४३", "content_sanskrit": "एवं संशप्तशपथाः समभित्यक्तजीविताः।\nअमित्रवाहिनीं वीराः प्रतिगाहन्त्यभीरवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2075423, "chapter_id": 2595, "verse_number": "१२-१००-४४", "content_sanskrit": "अग्रतः पुरुषाऽनीकमसिचर्मवतां भवेत्।\nपृष्ठतः शकटानीकं कलत्रं मध्यतस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2075424, "chapter_id": 2595, "verse_number": "१२-१००-४५", "content_sanskrit": "परेषां प्रतिघातार्थं पदातीनां च गूहनम्।\nअपि तस्मिन्पुरे वृद्धा भवेयुर्ये पुरोगमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2075425, "chapter_id": 2595, "verse_number": "१२-१००-४६", "content_sanskrit": "ये पुरस्तादभिमताः सत्ववन्तो मनस्विनः।\nते पूर्वमभिवर्तेरंश्चैतानेवेतरे जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2075426, "chapter_id": 2595, "verse_number": "१२-१००-४७", "content_sanskrit": "अपि चोद्धर्षणं कार्यं भीरूणामपि यत्नतः।\nस्कन्धदर्शनमात्रात्तु तिष्ठेयुर्वा समीपतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2075427, "chapter_id": 2595, "verse_number": "१२-१००-४८", "content_sanskrit": "संहतान्योधयेदल्पान्कामं विस्तारयेद्बहून्।\nसूचीमुखमनीकं स्यादल्पानां बहुभिः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2075428, "chapter_id": 2595, "verse_number": "१२-१००-४९", "content_sanskrit": "संप्रयुक्ते निकृष्टे वा सत्यं वा यदि वाऽनृतम्।\nप्रगृह्य बाहून्क्रोशेत हन्त भग्नाः परे इति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2075429, "chapter_id": 2595, "verse_number": "१२-१००-५०", "content_sanskrit": "आगतं मे मित्रबलं प्रहरध्वमभीतवत्।\nसत्ववन्तो निधावेयुः कुर्वन्तो भैरवान्रवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2075430, "chapter_id": 2595, "verse_number": "१२-१००-५१", "content_sanskrit": "क्ष्वेडाः किलकिलाशब्दाः क्रकचा गोविषाणिकाः।\nभेरीमृदङ्गपणवान्नादयेयुश्च जर्झरान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2075431, "chapter_id": 2595, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि शततमोऽध्यायः॥ १००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]