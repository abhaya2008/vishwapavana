[{"id": 6000055000, "chapter_id": 10055, "verse_number": null, "content_sanskrit": "अथ पञ्चविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000055001, "chapter_id": 10055, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.001.m4a", "display_order": 2}, {"id": 6000055002, "chapter_id": 10055, "verse_number": "३-२५-१", "content_sanskrit": "निर्वेदवादिनीमेवं मनोर्दुहितरं मुनिः।\nदयालुः शालिनीमाह शुक्लाभिव्याहृतं स्मरन्॥ ३/२५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.002.m4a", "display_order": 3, "topics": [{"text": "कर्दमेन देवहूतिं समाश्वास्य तस्यां भगवदंशभूतकपिलनामकतनयोत्पादनम्", "range": "१–८"}]}, {"id": 6000055003, "chapter_id": 10055, "verse_number": null, "content_sanskrit": "ऋषिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.003.m4a", "display_order": 4}, {"id": 6000055004, "chapter_id": 10055, "verse_number": "३-२५-२", "content_sanskrit": "मा खिदो राजपुत्रीत्थमात्मानं प्रत्यनिन्दिते।\nभगवांस्तेऽक्षरो गर्भमदूरात् सम्प्रपत्स्यते॥ ३/२५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.004.m4a", "display_order": 5}, {"id": 6000055005, "chapter_id": 10055, "verse_number": "३-२५-३", "content_sanskrit": "धृतव्रता सुभद्रं ते दमेन नियमेन च।\nतपोद्रविणदानैश्च श्रद्धया चेश्वरं भज॥ ३/२५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.005.m4a", "display_order": 6}, {"id": 6000055006, "chapter_id": 10055, "verse_number": "३-२५-४", "content_sanskrit": "स त्वयाऽऽराधितः शुक्लो वितन्वन् मामकं यशः।\nछेत्ता ते हृदयग्रन्थिमौदर्यो ब्रह्मभावनः॥ ३/२५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.006.m4a", "display_order": 7}, {"id": 6000055007, "chapter_id": 10055, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.007.m4a", "display_order": 8}, {"id": 6000055008, "chapter_id": 10055, "verse_number": "३-२५-५", "content_sanskrit": "देवहूत्यपि सन्देशं गौरवेण प्रजापतेः।\nसम्यक् श्रद्धाय पुरुषं कूटस्थमभजद् गुरुम्॥ ३/२५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.008.m4a", "display_order": 9}, {"id": 6000055009, "chapter_id": 10055, "verse_number": "३-२५-६", "content_sanskrit": "तस्यां बहुतिथे काले भगवान् मधुसूदनः।\nकार्दमं वीर्यमापन्नो जज्ञेऽग्निरिव दारुणि॥ ३/२५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.009.m4a", "display_order": 10}, {"id": 6000055010, "chapter_id": 10055, "verse_number": "३-२५-७", "content_sanskrit": "अवादयंस्तदा व्योम्नि वादित्राणि घनाघनाः।\nगायन्ति तं स्म गन्धर्वा नृत्यन्त्यप्सरसो मुदा॥ ३/२५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.010.m4a", "display_order": 11}, {"id": 6000055011, "chapter_id": 10055, "verse_number": "३-२५-८", "content_sanskrit": "पेतुः सुमनसो दिव्याः खेचरैरपवर्जिताः।\nप्रसेदुश्च दिशः सर्वा अम्भांसि च मनांसि च॥ ३/२५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.011.m4a", "display_order": 12}, {"id": 6000055012, "chapter_id": 10055, "verse_number": "३-२५-९", "content_sanskrit": "तत् कर्दमाश्रमपदं सरस्वत्या परिप्लुतम्।\nस्वयम्भूः सार्धमृषिभिर्मरीच्यादिभिरभ्यगात्॥ ३/२५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.012.m4a", "display_order": 13, "topics": [{"text": "ब्रह्मणा मरीच्यादिभिः सह कर्दमाश्रममेत्य कपिलकर्दमदेवहूतीनां प्रशंसनम्", "range": "९–११"}]}, {"id": 6000055013, "chapter_id": 10055, "verse_number": "३-२५-१०", "content_sanskrit": "भगवन्तं परं ब्रह्म सत्त्वेनांशेन शत्रुहन्।\nतत्त्वसंख्यानविज्ञप्त्यै जातं विद्वानजः स्वराट्॥ ३/२५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.013.m4a", "display_order": 14}, {"id": 6000055014, "chapter_id": 10055, "verse_number": "३-२५-११", "content_sanskrit": "सभाजयन् विशुद्धेन चेतसा तच्चिकीर्षितम्।\nप्रहृष्यमाणैरसुभिः कर्दमं चेदमभ्यधात्॥ ३/२५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.014.m4a", "display_order": 15}, {"id": 6000055015, "chapter_id": 10055, "verse_number": null, "content_sanskrit": "ब्रह्मोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.015.m4a", "display_order": 16}, {"id": 6000055016, "chapter_id": 10055, "verse_number": "३-२५-१२", "content_sanskrit": "त्वया मेऽपचितिस्तात कल्पिता निर्व्यलीकतः।\nयन्मे सञ्जगृहे वाक्यं भवान् मानद मानयन्॥ ३/२५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.016.m4a", "display_order": 17, "topics": [{"text": "कर्दमेन ब्रह्मचोदनया मरीच्यादिभ्यो नवभ्यो महर्षिभ्यः स्वकन्यानवकप्रदानम्", "range": "१२–२५"}]}, {"id": 6000055017, "chapter_id": 10055, "verse_number": "३-२५-१३", "content_sanskrit": "एतावत्येव शुश्रूषा कार्या पितरि पुत्रकैः।\nबाढमित्यनुमन्येत गौरवेण गुरोर्वचः॥ ३/२५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.017.m4a", "display_order": 18}, {"id": 6000055018, "chapter_id": 10055, "verse_number": "३-२५-१४", "content_sanskrit": "इमा दुहितरः सत्यस्तव वत्स सुमध्यमाः।\nसर्गमेताः प्रभावैः स्वैर्बृंहयिष्यन्ति नैकधा॥ ३/२५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.018.m4a", "display_order": 19}, {"id": 6000055019, "chapter_id": 10055, "verse_number": "३-२५-१५", "content_sanskrit": "अतस्त्वमृषिमुख्येभ्यो यथाशीलं यथारुचि।\nआत्मजाः परिदेह्यङ्ग विस्तृणीहि यशो भुवि॥ ३/२५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.019.m4a", "display_order": 20}, {"id": 6000055020, "chapter_id": 10055, "verse_number": "३-२५-१६", "content_sanskrit": "वेदाहमाद्यं पुरुषमवतीर्णं स्वमायया।\nभूतानां शेवधिं देहं बिभ्राणं कपिलं मुनिम्॥ ३/२५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.020.m4a", "display_order": 21}, {"id": 6000055021, "chapter_id": 10055, "verse_number": "३-२५-१७", "content_sanskrit": "ज्ञानविज्ञानयोगेन कर्मणामुद्धरंश्च यः।\nहिरण्यकेशः पद्माक्षः पद्ममुद्रापदाम्बुजः॥ ३/२५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.021.m4a", "display_order": 22}, {"id": 6000055022, "chapter_id": 10055, "verse_number": "३-२५-१८", "content_sanskrit": "एष मानवि ते गर्भं प्रविष्टः कैटभार्दनः।\nअविद्यासंशयग्रन्थिं छित्त्वा गां विचरिष्यति॥ ३/२५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.022.m4a", "display_order": 23}, {"id": 6000055023, "chapter_id": 10055, "verse_number": "३-२५-१९", "content_sanskrit": "अयं सिद्धगणाधीशः साङ्ख्याचार्यैः सुसम्मतः।\nलोके कपिल इत्याख्यां गन्ता ते कीर्तिवर्धनः॥ ३/२५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.023.m4a", "display_order": 24}, {"id": 6000055024, "chapter_id": 10055, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.024.m4a", "display_order": 25}, {"id": 6000055025, "chapter_id": 10055, "verse_number": "३-२५-२०", "content_sanskrit": "तावाश्वास्य जगत्स्रष्टा कुमारैः सह नारदः।\nहंसो हंसेन यानेन स्वधाम प्रत्यपद्यत॥ ३/२५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.025.m4a", "display_order": 26}, {"id": 6000055026, "chapter_id": 10055, "verse_number": "३-२५-२१", "content_sanskrit": "गते शतधृतौ क्षत्तः कर्दमस्तेन चोदितः।\nयथोदितं स्वदुहितॄः प्रादाद् विश्वसृजां ततः॥ ३/२५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.026.m4a", "display_order": 27}, {"id": 6000055027, "chapter_id": 10055, "verse_number": "३-२५-२२", "content_sanskrit": "मरीचये कलां प्रादाद् अनसूयाम् अथात्रये।\nश्रद्धाम् अङ्गिरसेऽयच्छत् पुलस्त्याय हविर्भुवम्॥ ३/२५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.027.m4a", "display_order": 28}, {"id": 6000055028, "chapter_id": 10055, "verse_number": "३-२५-२३", "content_sanskrit": "पुलहाय गतिं युक्तां क्रतवे च क्रियां सतीम्।\nख्यातिं च भृगवेऽयच्छद् वसिष्ठायाप्यरुन्धतीम्॥ ३/२५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.028.m4a", "display_order": 29}, {"id": 6000055029, "chapter_id": 10055, "verse_number": "३-२५-२४", "content_sanskrit": "अथर्वणेऽददाच्छान्तिं यया यज्ञो वितन्यते।\nविप्रर्षभान् कृतोद्वाहान् सदारान् समलालयत्॥ ३/२५/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.029.m4a", "display_order": 30}, {"id": 6000055030, "chapter_id": 10055, "verse_number": "३-२५-२५", "content_sanskrit": "ततस्त ऋषयः क्षत्तः कृतदारा निमन्त्र्य तम्।\nप्रातिष्ठन् नन्दमापन्नाः स्वं स्वमाश्रममण्डलम्॥ ३/२५/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.030.m4a", "display_order": 31}, {"id": 6000055031, "chapter_id": 10055, "verse_number": "३-२५-२६", "content_sanskrit": "स चावतीर्णं त्रियुगमाज्ञाय विबुधर्षभम्।\nविविक्त उपसङ्गम्य प्रणम्य समभाषत॥ ३/२५/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.031.m4a", "display_order": 32, "topics": [{"text": "कर्दमेन रहसि कपिलमेत्य प्रणामस्तवनपूर्वकं तदनुज्ञया यत्याश्रमं स्वीकृत्य वनं प्रति गमनम्, तपसा मोक्षप्राप्तिश्च", "range": "२६–४८"}]}, {"id": 6000055032, "chapter_id": 10055, "verse_number": "३-२५-२७", "content_sanskrit": "अहो पापच्यमानानां निरये स्वैरमङ्गलैः।\nकालेन भूयसा नूनं प्रसीदन्तीह देवताः॥ ३/२५/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.032.m4a", "display_order": 33}, {"id": 6000055033, "chapter_id": 10055, "verse_number": "३-२५-२८", "content_sanskrit": "बहुजन्मविपक्‍वेन सम्यग् योगसमाधिना।\nद्रष्टुं यतन्ते यतयः शून्यागारेषु यत्पदम्॥ ३/२५/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.033.m4a", "display_order": 34}, {"id": 6000055034, "chapter_id": 10055, "verse_number": "३-२५-२९", "content_sanskrit": "स एव भगवानद्य हेलनं नगणय्य नः।\nगृहेषु जातो ग्राम्याणां यः स्वानां पक्षपोषणः॥ ३/२५/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.034.m4a", "display_order": 35}, {"id": 6000055035, "chapter_id": 10055, "verse_number": "३-२५-३०", "content_sanskrit": "स्वीयं वाक्यमृतं कर्तुमवतीर्णोऽसि मे गृहे।\nचिकीर्षुर्भगवन् शर्म भक्तानामभिवर्धनः॥ ३/२५/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.035.m4a", "display_order": 36}, {"id": 6000055036, "chapter_id": 10055, "verse_number": "३-२५-३१", "content_sanskrit": "तान्येव तेऽभिरूपाणि रूपाणि भगवंस्तव।\nयानि यानीह रोचन्ते स्वजनानामरूपिणः॥ ३/२५/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.036.m4a", "display_order": 37}, {"id": 6000055037, "chapter_id": 10055, "verse_number": "३-२५-३२", "content_sanskrit": "त्वां सूरिभिस्तत्त्वबुभुत्सयाऽद्धा सदाऽभिवादार्हणपादपीठम्।\nऐश्वर्यवैराग्ययशोऽवबोधवीर्यश्रिया पूर्णमहं प्रपद्ये॥ ३/२५/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.037.m4a", "display_order": 38}, {"id": 6000055038, "chapter_id": 10055, "verse_number": "३-२५-३३", "content_sanskrit": "परं प्रधानं पुरुषं महान्तं कालं कविं त्रिवृतं लोकपालम्।\nआत्मानुभूत्याऽनुगतप्रपञ्चं स्वच्छन्दशक्तिं कपिलं प्रपद्ये॥ ३/२५/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.038.m4a", "display_order": 39}, {"id": 6000055039, "chapter_id": 10055, "verse_number": "३-२५-३४", "content_sanskrit": "तं त्वाऽभिपृच्छेऽद्य पतिं प्रजानां त्वयाऽवतीर्णेन उताप्तकामः।\nपरिव्राजां पदवीमास्थितोऽहं चरिष्ये त्वां हृदि युञ्जन् विशोकः॥ ३/२५/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.039.m4a", "display_order": 40}, {"id": 6000055040, "chapter_id": 10055, "verse_number": null, "content_sanskrit": "भगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.040.m4a", "display_order": 41}, {"id": 6000055041, "chapter_id": 10055, "verse_number": "३-२५-३५", "content_sanskrit": "मया प्रोक्तं हि लोकस्य प्रमाणं सत्यलौकिके।\nअथाजनि मया तुभ्यं यदवोचमृतं मुने॥ ३/२५/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.041.m4a", "display_order": 42}, {"id": 6000055042, "chapter_id": 10055, "verse_number": "३-२५-३६", "content_sanskrit": "एतन्मे जन्म लोकेऽस्मिन् मुमुक्षूणां दुराशयात्।\nप्रसंख्यानाय तत्त्वानां समत्वायात्मदर्शिनाम्॥ ३/२५/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.042.m4a", "display_order": 43}, {"id": 6000055043, "chapter_id": 10055, "verse_number": "३-२५-३७", "content_sanskrit": "एष आत्मपथोऽव्यक्तो नष्टः कालेन भूयसा।\nतं प्रवर्तयितुं देहमिमं विद्धि मया भृतम्॥ ३/२५/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.043.m4a", "display_order": 44}, {"id": 6000055044, "chapter_id": 10055, "verse_number": "३-२५-३८", "content_sanskrit": "गच्छ कामं मयाऽऽपृष्टो मयि संन्यस्तकर्मणा।\nजित्वा सुदुर्जयं मृत्युममृतत्वाय मां भज॥ ३/२५/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.044.m4a", "display_order": 45}, {"id": 6000055045, "chapter_id": 10055, "verse_number": "३-२५-३९", "content_sanskrit": "मामात्मानं स्वयंज्योतिः सर्वभूतगुहाशयम्।\nआत्मन्येवात्मना वीक्ष्य विशोकोऽभयमृच्छसि॥ ३/२५/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.045.m4a", "display_order": 46}, {"id": 6000055046, "chapter_id": 10055, "verse_number": "३-२५-४०", "content_sanskrit": "विश्वमेतद्धि शास्‍त्रेण विज्ञायात्मानमीश्वरम्।\nमुनिः शान्तमनोवाक्यस्तदा नाख्यात्युपप्लवः॥ ३/२५/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.046.m4a", "display_order": 47}, {"id": 6000055047, "chapter_id": 10055, "verse_number": "३-२५-४१", "content_sanskrit": "मात्र आध्यात्मिकीं विद्यां शमनीं सर्वकर्मणाम्।\nवितरिष्ये यया चासौ भयं चातितरिष्यति॥ ३/२५/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.047.m4a", "display_order": 48}, {"id": 6000055048, "chapter_id": 10055, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.048.m4a", "display_order": 49}, {"id": 6000055049, "chapter_id": 10055, "verse_number": "३-२५-४२", "content_sanskrit": "एवं समुदितस्तेन कपिलेन प्रजापतिः।\nदक्षिणीकृत्य तं प्रीतो वनमेव जगाम ह॥ ३/२५/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.049.m4a", "display_order": 50}, {"id": 6000055050, "chapter_id": 10055, "verse_number": "३-२५-४३", "content_sanskrit": "व्रतं स आस्थितो मौनमात्मैकशरणो मुनिः।\nनिःसङ्गो व्यचरत् क्षोणीमनग्निरनिकेतनः॥ ३/२५/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.050.m4a", "display_order": 51}, {"id": 6000055051, "chapter_id": 10055, "verse_number": "३-२५-४४", "content_sanskrit": "मनो ब्रह्मणि युञ्जानो यत् तत् सदसतः परम्।\nगुणावभासे विगुण एकभक्त्यानुभाविते॥ ३/२५/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.051.m4a", "display_order": 52}, {"id": 6000055052, "chapter_id": 10055, "verse_number": "३-२५-४५", "content_sanskrit": "निरहङ्कृतिर्निर्ममश्च निर्द्वन्द्वः समदृक् स्वदृक्।\nप्रत्यग्रः शान्तधीर्धीरः प्रशान्तोर्मिरिवोदधिः॥ ३/२५/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.052.m4a", "display_order": 53}, {"id": 6000055053, "chapter_id": 10055, "verse_number": "३-२५-४६", "content_sanskrit": "आत्मानं सर्वभूतेषु भगवन्तमवस्थितम्।\nअपश्यत् सर्वभूतानि भगवत्यपि चात्मनि॥ ३/२५/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.053.m4a", "display_order": 54}, {"id": 6000055054, "chapter_id": 10055, "verse_number": "३-२५-४७", "content_sanskrit": "वासुदेवे भगवति सर्वज्ञे प्रत्यगात्मनि।\nपरेण भक्तिभावेन लब्धात्मा मुक्तबन्धनः॥ ३/२५/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.054.m4a", "display_order": 55}, {"id": 6000055055, "chapter_id": 10055, "verse_number": "३-२५-४८", "content_sanskrit": "इच्छाद्वेषविहीनेन सर्वत्र समचेतसा।\nभगवद्भक्तियोगेन प्राप्तो भागवतीं गतिम्॥ ३/२५/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_025/BhP_03.025.055.m4a", "display_order": 56}, {"id": 6000055056, "chapter_id": 10055, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां तृतीयस्कन्धे पञ्चविंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]