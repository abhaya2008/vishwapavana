[{"id": 7006273000, "chapter_id": 26273, "verse_number": "३-२७-१", "content_sanskrit": "अथ नष्टेषु पुत्रेषु शोकानलपरिप्लुतः ।\nविललाप स दैत्येन्द्रो मत्वा जातं कुलक्षयम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006273001, "chapter_id": 26273, "verse_number": "३-२७-२", "content_sanskrit": "हा पुत्रा हा गुणोदारा हा मदेकपरायणाः ।\nहा मन्नेत्रसुधापूरा हा मत्कुलविवर्धनाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006273002, "chapter_id": 26273, "verse_number": "३-२७-३", "content_sanskrit": "हा समस्तसुरश्रेष्ठमदभञ्जनतत्पराः ।\nहा समस्तसुरस्त्रीणामन्तर्मोहनमन्मथाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006273003, "chapter_id": 26273, "verse_number": "३-२७-४", "content_sanskrit": "दिशत प्रीतिवाचं मे ममाङ्के वल्गताधुना ।\nकिमिदानीमिमं तातमवमुच्य सुखं गताः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006273004, "chapter_id": 26273, "verse_number": "३-२७-५", "content_sanskrit": "युष्मान्विना न शोभन्ते मम राज्यानि पुत्रकाः ।\nरिक्तानि मम गेहानि रिक्ता राजसभापि मे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006273005, "chapter_id": 26273, "verse_number": "३-२७-६", "content_sanskrit": "कथमेवं विनिःशेषं हतायूयं दुराशयाः ।\nअप्रधृष्यभुजासत्त्वान्भवतो मत्कुलाङ्कुरान् ।\nकथमेकपदे दुष्टा वनिता संगरेऽवधीत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006273006, "chapter_id": 26273, "verse_number": "३-२७-७", "content_sanskrit": "मम नष्टानि सौख्यानि मम नष्टाः कुलस्त्रियः ।\nइतः परं कुले क्षीणे साहसानि सुखानि च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006273007, "chapter_id": 26273, "verse_number": "३-२७-८", "content_sanskrit": "भवतः सुकृतैर्लब्ध्वा मम पूर्वजनुःकृतैः ।\nनाशोऽयं भवतामद्य जातो नष्टस्ततोऽस्म्यहम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006273008, "chapter_id": 26273, "verse_number": "३-२७-९", "content_sanskrit": "हा हतोऽस्मि विपन्नोऽस्मि मन्दभाग्योऽस्मि पुत्रकाः ।\nइति शोकात्स पर्यस्यन्प्रलपन्मुक्तमूर्धजः ।\nमूर्च्छया लुप्तहृदयो निष्पपात नुपासनात् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006273009, "chapter_id": 26273, "verse_number": "३-२७-१०", "content_sanskrit": "विशुक्रश्च विषङ्गश्च कुटिलाक्षश्च संसदि ।\nभण्डमाश्वासयामासुर्दैवस्य कुटिलक्रमैः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006273010, "chapter_id": 26273, "verse_number": "३-२७-११", "content_sanskrit": "विशुक्र उवाच देवकि प्राकृत इव प्राप्तः शोकस्य वश्यताम् ।\nलपसि त्वे प्रति सुतान्प्राप्तमृत्यून्महाहवे ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006273011, "chapter_id": 26273, "verse_number": "३-२७-१२", "content_sanskrit": "धर्मवान्विहितः पन्था वीराणामेष शाश्वतः ।\nअशोच्यमाहवे मृत्युं प्राप्नुवन्ति यदर्हितम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006273012, "chapter_id": 26273, "verse_number": "३-२७-१३", "content_sanskrit": "एतदेव विनाशाय शल्यवद्बाधते मनः ।\nयत्स्त्री समागत्य हठान्नि हन्ति सुभटान्रणे ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006273013, "chapter_id": 26273, "verse_number": "३-२७-१४", "content_sanskrit": "इत्युक्ते तेन दैत्येन पुत्रशोको व्यमुच्यत ।\nभण्डेन चण्डकालाग्निसदृशः क्रोध आदधे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006273014, "chapter_id": 26273, "verse_number": "३-२७-१५", "content_sanskrit": "स कोशात्क्षिप्रमुद्धृत्य खड्गमुग्रं यमोपमम् ।\nविस्फारिताक्षियुगलो भृशं जज्वाल तेजसा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006273015, "chapter_id": 26273, "verse_number": "३-२७-१६", "content_sanskrit": "इदानीमेव तां दुष्टां खड्गेनानेन खण्डशः ।\nशकलीकृत्य समरे श्रमं प्राप्स्यामि बन्धुभिः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006273016, "chapter_id": 26273, "verse_number": "३-२७-१७", "content_sanskrit": "इति रोषस्खलद्वर्णः श्वसन्निव भुजङ्गमः ।\nखड्गं विधुन्वन्नुत्थाय प्रचचाला तिमत्तवत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006273017, "chapter_id": 26273, "verse_number": "३-२७-१८", "content_sanskrit": "तं निरुध्य च संभ्रान्ताः सर्वे दानवपुङ्गवाः ।\nवाचमूचुरतिक्रोधाज्ज्वलन्तो ललितां प्रति ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006273018, "chapter_id": 26273, "verse_number": "३-२७-१९", "content_sanskrit": "न तदर्थे त्वया कार्यः स्वामिन्संभ्रम ईदृशः ।\nअस्माभिः स्वबलैर्युक्तै रणोत्साहो विधीयते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006273019, "chapter_id": 26273, "verse_number": "३-२७-२०", "content_sanskrit": "भवदाज्ञालवं प्राप्य समस्तभुवनं हठात् ।\nविमर्द्दयितुमीशाः स्मः किमु तां मुग्धभामिनीम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006273020, "chapter_id": 26273, "verse_number": "३-२७-२१", "content_sanskrit": "किं चूषयामः सप्ताब्धीन्क्षोदयामोऽथ वा गिरीन् ।\nअधरोत्तरमेवैतत्त्रैलोक्यं करवाम वा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006273021, "chapter_id": 26273, "verse_number": "३-२७-२२", "content_sanskrit": "छिनदाम सुरान्सर्वान्भिनदाम तदालयान् ।\nपिन्षाम हरित्पालानाज्ञां देहि महामते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006273022, "chapter_id": 26273, "verse_number": "३-२७-२३", "content_sanskrit": "इत्युदीरित माकर्ण्य महाहङ्कारगर्वितम् ।\nउवाच वचनं क्रुद्धः प्रतिघारुणलोचनः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006273023, "chapter_id": 26273, "verse_number": "३-२७-२४", "content_sanskrit": "विशुक्र भवता गत्वा मायान्तार्हितवर्ष्मणा ।\nजयविघ्नं महायन्त्रं कर्त्तव्यं कटके द्विषाम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006273024, "chapter_id": 26273, "verse_number": "३-२७-२५", "content_sanskrit": "इति तस्य वचः श्रुत्वा विशुक्रो रोषरूषितः ।\nमायातिरोहितवपुर्जगाम ललिताबलम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006273025, "chapter_id": 26273, "verse_number": "३-२७-२६", "content_sanskrit": "तस्मिन्प्रयातुमुद्युक्ते सुर्योऽस्तं समुपागतः ।\nपर्यस्तकिरणस्तोमपाटलीकृतदिङ्मुखः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006273026, "chapter_id": 26273, "verse_number": "३-२७-२७", "content_sanskrit": "अनुरागवती संध्या प्रयान्तं भानुमालिनम् ।\nअनुवव्राज पातालकुञ्जे रन्तुमिवोत्सुका ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006273027, "chapter_id": 26273, "verse_number": "३-२७-२८", "content_sanskrit": "वेगात्प्रपततो भानोर्देहसंगात्समुत्थिताः ।\nचरमाब्धेरिव पयःकणास्तारा विरेजिरे ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006273028, "chapter_id": 26273, "verse_number": "३-२७-२९", "content_sanskrit": "अथाससाद बहुलं तमः कज्जलमेचकम् ।\nसार्थं कर्त्तुमिवोद्युक्तं सवर्णस्यासिदुर्धिया ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006273029, "chapter_id": 26273, "verse_number": "३-२७-३०", "content_sanskrit": "मायारथं समारूढो गूढशर्वरसंवृतः ।\nअदृश्यवपुरापेदे ललिताकटकं खलः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006273030, "chapter_id": 26273, "verse_number": "३-२७-३१", "content_sanskrit": "तत्र गत्वा ज्वलज्ज्वालं वह्निप्राकारमण्डलम् ।\nशतयोजनविस्तारामालोकयत्दुर्मतिः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006273031, "chapter_id": 26273, "verse_number": "३-२७-३२", "content_sanskrit": "परितो विभ्रमञ्शालमवकाशमवाप्नुवन् ।\nदक्षिणं द्वारमासाद्य निदध्यौ क्षणमुद्धतः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006273032, "chapter_id": 26273, "verse_number": "३-२७-३३", "content_sanskrit": "तत्रापश्यन्महासत्त्वास्सावधाना धृतायुधाः ।\nआरूढयानाः सनद्धवर्माणो द्वारदेशतः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006273033, "chapter_id": 26273, "verse_number": "३-२७-३४", "content_sanskrit": "स्तंभिनीप्रमुखाः शक्तीर्विशत्यक्षौहिणीयुताः ।\nसर्वदा द्वाररक्षार्थं निर्दिष्टा दण्डनाथया ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006273034, "chapter_id": 26273, "verse_number": "३-२७-३५", "content_sanskrit": "विलोक्य विस्मयाविष्टो विचार्य च चिरं तदा ।\nशालस्य बहिरेवासौ स्थित्वा यन्त्रं समातनोत् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006273035, "chapter_id": 26273, "verse_number": "३-२७-३६", "content_sanskrit": "गव्यूतिमात्रकायामे तत्समानप्रविस्तरे ।\nशिलापट्टे सुमहति प्रालिखद्यन्त्रमुत्तमम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006273036, "chapter_id": 26273, "verse_number": "३-२७-३७", "content_sanskrit": "अष्टदिक्ष्वष्टशूलेन संहाराक्षरमौलिना ।\nअष्टभिर्दैवतैश्चैव युक्तं यन्त्रं समालिखत् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006273037, "chapter_id": 26273, "verse_number": "३-२७-३८", "content_sanskrit": "अलसा कृपणा दीना नितन्द्राच प्रमीलिका ।\nक्लीबा च निरहङ्कारा चेत्यष्टौ देवताः स्मृताः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006273038, "chapter_id": 26273, "verse_number": "३-२७-३९", "content_sanskrit": "देवताष्टकमेतश्च शूलाष्टकपुटोपरि ।\nनियोज्य लिखितं यन्त्रं मायावी सममन्त्रयत् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006273039, "chapter_id": 26273, "verse_number": "३-२७-४०", "content_sanskrit": "पूजां विधाय मन्त्रस्य बलिभिश्छागलादिभिः ।\nतद्यन्त्रं चारिकटके प्राक्षिपत्समरेऽसुरः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006273040, "chapter_id": 26273, "verse_number": "३-२७-४१", "content_sanskrit": "पाकारस्य बहिर्भागे वर्तिना तेन दुर्धिया ।\nक्षिप्तमुल्लङ्घ्य च रणे पपात कटकान्तरे ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006273041, "chapter_id": 26273, "verse_number": "३-२७-४२", "content_sanskrit": "तद्यन्त्रस्य विकारेण कटकस्थास्तुशक्तयः ।\nविमुक्तशस्त्रसंन्यासमास्थिता दीनमानसाः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006273042, "chapter_id": 26273, "verse_number": "३-२७-४३", "content_sanskrit": "किं हतैरसुरैः कार्यं शस्त्राशस्त्रिक्रमैरलम् ।\nजयसिद्धफलं किं वा प्राणिहिंसा च पापदा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006273043, "chapter_id": 26273, "verse_number": "३-२७-४४", "content_sanskrit": "अमराणां कृते कोऽयं किमस्माकं भविष्यति ।\nवृथा कलकलं कृत्वा न फलं युद्धकर्मणा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006273044, "chapter_id": 26273, "verse_number": "३-२७-४५", "content_sanskrit": "का स्वामिनी महाराज्ञी का वासौ दण्डनायिका ।\nका वा सा मन्त्रिणी श्यामा भृत्यत्वं नोऽथ कीदृशम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006273045, "chapter_id": 26273, "verse_number": "३-२७-४६", "content_sanskrit": "इह सर्वाभिरस्माभिर्भृत्यभूताभिरेकिका ।\nवनिता स्वामिनीकृत्ये किं फलं मोक्ष्यते परम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006273046, "chapter_id": 26273, "verse_number": "३-२७-४७", "content_sanskrit": "परेषां मर्मभिदुरैरायुधैर्न प्रयोजनम् ।\nयुद्धं शाम्यतु चास्माकं देहशस्त्रक्षतिप्रदम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006273047, "chapter_id": 26273, "verse_number": "३-२७-४८", "content_sanskrit": "युद्धे च मरणं भावि वृथा स्युर्जीवितानि नः ।\nयुद्धे मृत्युर्भवेदेव इति तत्र प्रमैव का ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006273048, "chapter_id": 26273, "verse_number": "३-२७-४९", "content_sanskrit": "उत्साहेन फलं नास्ति निद्रैवैका सुखावहा ।\nआलस्यसदृशं नास्ति चित्तविश्रान्तिदायकम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006273049, "chapter_id": 26273, "verse_number": "३-२७-५०", "content_sanskrit": "एतादृशीश्च नो ज्ञात्वा सा राज्ञी किं करिष्यति ।\nतस्या राज्ञीत्वमपि नः समवायेन कल्पितम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006273050, "chapter_id": 26273, "verse_number": "३-२७-५१", "content_sanskrit": "एवं चोपेक्षितास्माभिः सा विनष्टबला भवेत् ।\nनष्ट सत्त्वा च सा राज्ञी कान्नः शिक्षां करिष्यति ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006273051, "chapter_id": 26273, "verse_number": "३-२७-५२", "content_sanskrit": "एवमेव रणारंभं विमुच्य विधुतायुधाः ।\nशक्तयो निद्रया द्वारे घूर्णमाना इवाभवन् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006273052, "chapter_id": 26273, "verse_number": "३-२७-५३", "content_sanskrit": "सर्वत्र मान्द्यं कार्येषु महदालस्यमागतम् ।\nशिथिलं चाभवत्सर्वं शक्तीनां कटकं महत् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006273053, "chapter_id": 26273, "verse_number": "३-२७-५४", "content_sanskrit": "जयविघ्नं महायन्त्रमिति कृत्वा स दानवः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006273054, "chapter_id": 26273, "verse_number": "३-२७-५५", "content_sanskrit": "निर्विद्य तत्प्रभावेण कटकं प्रमिमन्थिषुः ।\nद्वितीययुद्धदिवसस्यार्धरात्रे गते सति ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006273055, "chapter_id": 26273, "verse_number": "३-२७-५६", "content_sanskrit": "निस्मृत्य नगराद्भूयस्त्रिंशदक्षौहिणीवृतः ।\nआजगाम पुनर्दैत्यो विशुक्रः कटकं द्विषाम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006273056, "chapter_id": 26273, "verse_number": "३-२७-५७", "content_sanskrit": "अश्रूयन्त ततस्तस्य रणनिःसाणनिस्वनाः ।\nतथापि ता निरुद्योगाः शक्तयः कटकेऽभवन् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006273057, "chapter_id": 26273, "verse_number": "३-२७-५८", "content_sanskrit": "तदा महानुभावत्वाद्विकारैर्विघ्नयन्त्रजैः ।\nअस्पृष्टे मन्त्रिणीदण्डनाथे चिन्तामवा पतुः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006273058, "chapter_id": 26273, "verse_number": "३-२७-५९", "content_sanskrit": "अहो बत महत्कष्टमिदमापतितं भयम् ।\nकस्य वाथ विकारेण सैनिका निर्गतोद्यमाः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006273059, "chapter_id": 26273, "verse_number": "३-२७-६०", "content_sanskrit": "निरस्तायुधसंरंभा निद्रातन्द्राविघूर्णिताः ।\nन मानयन्ति वाक्यानि रार्चयन्ति महेश्वरीम् ।\nऔदासीन्यं वितन्वन्ति शक्तयो निस्पृहा इमाः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006273060, "chapter_id": 26273, "verse_number": "३-२७-६१", "content_sanskrit": "इति ते मन्त्रिणीदण्डनाथे चिन्तापरायणे ।\nचक्रस्यन्दनमारूढे महाराज्ञीं समूचतुः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006273061, "chapter_id": 26273, "verse_number": "३-२७-६२", "content_sanskrit": "मन्त्रिण्युवाच देवि सक्य विकारोऽयं शक्तयो विगतोद्यमाः ।\nन शृण्वन्ति महाराज्ञि तवाज्ञां विश्वपालिताम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006273062, "chapter_id": 26273, "verse_number": "३-२७-६३", "content_sanskrit": "अन्योन्यं च विरक्तास्ताः पराच्यः सर्वकर्मसु ।\nनिद्रातन्द्रामुकुलिता दुर्वाक्यानि वितन्वते ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006273063, "chapter_id": 26273, "verse_number": "३-२७-६४", "content_sanskrit": "का दण्डिनी मन्त्रिणी का महाराज्ञीति का पुनः ।\nयुद्धं च कीदृशमिति क्षेपं भूरि वितन्वते ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006273064, "chapter_id": 26273, "verse_number": "३-२७-६५", "content_sanskrit": "अस्मिन्नेवान्तरे शत्रुरागच्छति महाबलः ।\nउद्दण्डभेरीनिस्वानैर्विभिन्दन्निव रोदसी ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006273065, "chapter_id": 26273, "verse_number": "३-२७-६६", "content_sanskrit": "अत्र यत्प्राप्तरूपं तन्महाराज्ञि प्रपद्यताम् ।\nइत्युक्त्वा सह दण्डिन्या मन्त्रिणी प्रणतिं व्यधात् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006273066, "chapter_id": 26273, "verse_number": "३-२७-६७", "content_sanskrit": "ततः सा ललिता देवी कामेश्वरमुखं प्रति ।\nदत्तदृष्टडिः समहसदतिरक्तरदावलिः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006273067, "chapter_id": 26273, "verse_number": "३-२७-६८", "content_sanskrit": "तस्याः स्मितप्रभापुञ्जे कुञ्जराकृतिमान्मुखे ।\nकटक्रोडगलद्दानः कश्चिदेव व्यजृंभत ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006273068, "chapter_id": 26273, "verse_number": "३-२७-६९", "content_sanskrit": "जपापटलपाटल्यो बालचन्द्रवपुर्धरः ।\nबीजपूरगदामिक्षुचापं शूलं सुदर्शनम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006273069, "chapter_id": 26273, "verse_number": "३-२७-७०", "content_sanskrit": "अब्जपाशोत्पलव्रीहिमञ्जरीवरदां कुशान् ।\nरत्नकुंभं च दशभिः स्वकैर्हस्तैः समुद्वहन् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006273070, "chapter_id": 26273, "verse_number": "३-२७-७१", "content_sanskrit": "तुन्दिलश्चन्द्रचूडालो मन्द्रबृंहितनिस्वनः ।\nसिद्धिलक्ष्मीसमाश्लिष्टः प्रणनाम महेश्वरीम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006273071, "chapter_id": 26273, "verse_number": "३-२७-७२", "content_sanskrit": "तया कृताशीः स महान्गणनाथो गजाननः ।\nजयविघ्नमहायन्त्रंभेत्तुं वेगाद्विनिर्ययौ ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006273072, "chapter_id": 26273, "verse_number": "३-२७-७३", "content_sanskrit": "अन्तरेवहि शालस्य भ्रमद्दन्तावलाननः ।\nनिभृतं कुत्रचिल्लग्नं जयविघ्नं व्यलोकयत् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006273073, "chapter_id": 26273, "verse_number": "३-२७-७४", "content_sanskrit": "स देवो घोरनिर्घातैर्दुःसहैर्दन्तपातनैः ।\nक्षणाच्चूर्मीकरोति स्म जयविघ्नमहाशिलाम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006273074, "chapter_id": 26273, "verse_number": "३-२७-७५", "content_sanskrit": "तत्र स्थिताभिर्दुष्टाभिर्देवताभिः सहैव सः ।\nपरागशेषतां नीत्वा तद्यन्त्रं प्रक्षिपद्दिवि ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006273075, "chapter_id": 26273, "verse_number": "३-२७-७६", "content_sanskrit": "ततः किलकिलारावं कृत्वाऽलस्यविवर्जिताः ।\nउद्यताः समरं कर्तुं शक्तयः शस्त्रपाणयः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006273076, "chapter_id": 26273, "verse_number": "३-२७-७७", "content_sanskrit": "स देतिवदनः कण्ठकलिताकुण्ठनिस्वनः ।\nजययन्त्रं हि तत्सृष्टं तथा रात्रौ व्यनाशयत् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006273077, "chapter_id": 26273, "verse_number": "३-२७-७८", "content_sanskrit": "इमं वृत्तान्तमाकर्ण्य भण्डः स क्षोभमाययौ ।\nससर्जय बहूनात्मरूपान्दन्तावलाननान् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006273078, "chapter_id": 26273, "verse_number": "३-२७-७९", "content_sanskrit": "ते कटक्रोडविगलन्मदसौरभचञ्चलैः ।\nचञ्चरीककुलैरग्रे गीयमानमहोदयाः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006273079, "chapter_id": 26273, "verse_number": "३-२७-८०", "content_sanskrit": "स्फुरद्दाडिमकिञ्जल्कविक्षेपकररोचिषः ।\nसदा रत्नाकरानेकहेलया पातुमुद्यताः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006273080, "chapter_id": 26273, "verse_number": "३-२७-८१", "content_sanskrit": "आमोदप्रमुखा ऋद्धिमुख्यशक्तिनिषेविताः ।\nआमोदश्च प्रमोदश्च मुमुखो दुर्मुखस्तथा ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006273081, "chapter_id": 26273, "verse_number": "३-२७-८२", "content_sanskrit": "अरिघ्नो विघ्नकर्त्ता च षडेते विघ्ननायकाः ।\nते सप्तकोटिसंख्यानां हेरंबाणामधीश्वराः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006273082, "chapter_id": 26273, "verse_number": "३-२७-८३", "content_sanskrit": "ते पुरश्चलितास्तस्य महागणपते रणे ।\nअग्निप्राकारवलयाद्विनिर्गत्य गजाननाः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006273083, "chapter_id": 26273, "verse_number": "३-२७-८४", "content_sanskrit": "क्रोधहुङ्कारतुमुलाः प्रत्य पद्यन्त दानवान् ।\nपुनः प्रचण्डफूत्कारबधिरीकृतविष्टपाः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006273084, "chapter_id": 26273, "verse_number": "३-२७-८५", "content_sanskrit": "पपात दैत्यसैन्येषु गणचक्रचमूगणः ।\nअच्छिदन्निशितैर्बाणैर्गणनाथः स दानवान् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006273085, "chapter_id": 26273, "verse_number": "३-२७-८६", "content_sanskrit": "गणनाथेन तस्याभूद्विशुक्रस्य महौजसः ।\nयुद्धमुद्धतहुङ्कारभिन्नकार्मुकनिःस्वनम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006273086, "chapter_id": 26273, "verse_number": "३-२७-८७", "content_sanskrit": "भ्रुकुटी कुटिले चक्रे दष्टोष्ठमतिपाटलम् ।\nविशुक्रो युधि बिभ्राणः समयुध्यत तेन सः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006273087, "chapter_id": 26273, "verse_number": "३-२७-८८", "content_sanskrit": "शस्त्राघट्टननिस्वानैर्हुंकारैश्च सुरद्विषाम् ।\nदैत्यसप्तिखुरक्रीडत्कुद्दालीकूटनिस्वनैः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006273088, "chapter_id": 26273, "verse_number": "३-२७-८९", "content_sanskrit": "फेत्कारैश्च गचेन्द्राणां भयेनाक्रन्दनैरपि ।\nहेषया च हयश्रेण्या रथचक्रस्वनैरपि ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006273089, "chapter_id": 26273, "verse_number": "३-२७-९०", "content_sanskrit": "धनुषां गुणनिस्स्वानैश्चक्रचीत्करणैरपि ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006273090, "chapter_id": 26273, "verse_number": "३-२७-९१", "content_sanskrit": "शरसात्कारघोषैश्च वीरभाषाकदंबकैः ।\nअट्टहासैर्महेन्द्राणां सिंहनादैश्चभूरिशः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7006273091, "chapter_id": 26273, "verse_number": "३-२७-९२", "content_sanskrit": "क्षुभ्यद्दिगन्तरं तत्र ववृधे युद्धमुद्धतम् ।\nत्रिंशदक्षौहिणी सेना विशुक्रस्य दुरात्मनः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7006273092, "chapter_id": 26273, "verse_number": "३-२७-९३", "content_sanskrit": "प्रत्येकं योधया मासुर्गणनाथा महारथाः ।\nदन्तैर्मर्म विभिन्दन्तो विष्टंयतश्च शुण्डया ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7006273093, "chapter_id": 26273, "verse_number": "३-२७-९४", "content_sanskrit": "क्रोधयन्तः कर्णतालैः पुष्कलावर्त्तकोपमैः ।\nनासाश्वासैश्च परुषैर्विक्षिपन्तः पताकिनीम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7006273094, "chapter_id": 26273, "verse_number": "३-२७-९५", "content_sanskrit": "उरोभिर्मर्दयन्तश्च शैलवप्रसमप्रभैः ।\nपिंषन्तश्च पदाघातैः पीनैर्घ्नन्तस्तथोदरैः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7006273095, "chapter_id": 26273, "verse_number": "३-२७-९६", "content_sanskrit": "विभिन्दन्तश्च शूलेन कृत्तन्तश्चक्रपातनैः ।\nशङ्खस्वनेन महता त्रासयन्तो वरूथिनीम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7006273096, "chapter_id": 26273, "verse_number": "३-२७-९७", "content_sanskrit": "गणनाथमुखोद्भूता गजवक्राः सहस्रशः ।\nधूलीशेषं समस्तं तत्सैन्यं चक्रुर्महोद्यताः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7006273097, "chapter_id": 26273, "verse_number": "३-२७-९८", "content_sanskrit": "अथ क्रोधसमाविष्टो निजसैन्यपुरोगमः ।\nप्रेषयामास देवस्य गजासुर मसौ पुनः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7006273098, "chapter_id": 26273, "verse_number": "३-२७-९९", "content_sanskrit": "प्रचण्डसिंहनादेन गजदैत्येन दुर्धिया ।\nसप्ताक्षौहिणियुक्तेन युयुधे स गणेश्वरः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7006273099, "chapter_id": 26273, "verse_number": "३-२७-१००", "content_sanskrit": "हीयमानं समालोक्य गजासुरभुजाबलम् ।\nवर्धमानं च तद्वीर्यं विशुक्रः प्रपलायितः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7006273100, "chapter_id": 26273, "verse_number": "३-२७-१०१", "content_sanskrit": "स एक एव वीरेद्रः प्रचलन्नाखुवाहनः ।\nसप्ताक्षौहिणिकायुक्तं गजासुरममर्दयत् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7006273101, "chapter_id": 26273, "verse_number": "३-२७-१०२", "content_sanskrit": "गजासुरे च निहते विशुक्रे प्रपलायिते ।\nललितान्तिकमापेदे महागमपतिर्मृधात् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7006273102, "chapter_id": 26273, "verse_number": "३-२७-१०३", "content_sanskrit": "कालरात्रिश्च दैत्यानां सा रात्रिर्विरतिं गता ।\nललिता चाति मुदिता बभूवास्य पराक्रमैः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7006273103, "chapter_id": 26273, "verse_number": "३-२७-१०४", "content_sanskrit": "विततार महाराज्ञीप्रीयमाणा गणेशितुः ।\nसर्वदैवतपूजायाः पूर्वपूज्यत्वमुत्तमम् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}]