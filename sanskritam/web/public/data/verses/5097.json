[{"id": 2192593, "chapter_id": 5097, "verse_number": "", "content_sanskrit": "याज्ञवल्क्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2192594, "chapter_id": 5097, "verse_number": "१", "content_sanskrit": "एते प्रधानस्य गुणास्त्रयः पुरुषसत्तम ।\nकृत्स्नस्य चैव जगतस्तिष्ठन्त्यनपगाः सदा॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2192595, "chapter_id": 5097, "verse_number": "२", "content_sanskrit": "दशधा सहस्रधा चैव तथा शतसहस्रधा ।\nकोटिशश्च करोत्येषप्रत्यगात्मानमात्मना\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2192596, "chapter_id": 5097, "verse_number": "३", "content_sanskrit": "सात्त्विकस्योत्तमं स्थानं राजसस्येह मध्यमम् ।\nतामसस्याधमं स्थानं प्राहुरध्यात्मचिन्तकाः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2192597, "chapter_id": 5097, "verse_number": "४", "content_sanskrit": "केवलेनेह पुण्येन गतिमूर्ध्वामवाप्नुयात् ।\nपुण्यपापेन मानुष्यमधर्मेणाप्यधोगतिम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2192598, "chapter_id": 5097, "verse_number": "५", "content_sanskrit": "द्वन्द्वमेषांत्रयाणां तु सन्निपातं च तत्त्वतः ।\nसत्त्वस्य रजसश्चैव तमसश्च शृणुष्व मे\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2192599, "chapter_id": 5097, "verse_number": "६", "content_sanskrit": "सत्त्वस्य तु रजो दृष्टं रजसश्च तमस्तथा ।\nतमसश्च तथा सत्त्वं सत्त्वस्याव्यक्तमेव च\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2192600, "chapter_id": 5097, "verse_number": "७", "content_sanskrit": "अव्यक्तसत्त्वसंयुक्तो देवलोकमवाप्नुयात् ।\nरजःसत्त्वसमायुक्तो मनुष्येषूपपद्यते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2192601, "chapter_id": 5097, "verse_number": "८", "content_sanskrit": "रजस्तमोभ्यां संयुक्तस्तिर्यग्योनिषु जायते ।\nरजस्तामससत्त्वैश्च युक्तो मानुष्यमाप्नुयात्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2192602, "chapter_id": 5097, "verse_number": "९", "content_sanskrit": "पुण्यपापवियुक्तानां स्थानमाहुर्मनीषिणाम् ।\nशास्वतं चाव्ययं चैव अक्षरं चाभयं च यत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2192603, "chapter_id": 5097, "verse_number": "१०", "content_sanskrit": "ज्ञानिनां सम्भवं श्रेष्ठं स्थानमव्रणमच्युतम् ।\nअतीन्द्रियमबीजं च जन्ममृत्युतमोनुदम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2192604, "chapter_id": 5097, "verse_number": "११", "content_sanskrit": "अव्यक्तस्थं परं यत्तत् पृष्टस्तेऽहं नराधिप ।\nस एषप्रकृतिष्ठो हि तस्थुरित्यभिधीयते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2192605, "chapter_id": 5097, "verse_number": "१२", "content_sanskrit": "अचेतनश्चैष मतः प्रकृतिस्थश्च पार्थिव ।\nएतेनाधिष्ठितश्चैव सृजते संहरत्यपि\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2192606, "chapter_id": 5097, "verse_number": "", "content_sanskrit": "जनकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2192607, "chapter_id": 5097, "verse_number": "१३", "content_sanskrit": "अनादिनिधनावेतावुभावेव महामुने ।\nअमूर्तिमन्तावचलावप्रकम्प्यौ च निर्व्रणौ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2192608, "chapter_id": 5097, "verse_number": "१४", "content_sanskrit": "अग्राह्यावृषिशार्दूल कथमेको ह्यचेतनः ।\nचेतनावांस्तथा चैकःक्षेत्रज्ञ इति भाषितः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2192609, "chapter_id": 5097, "verse_number": "१५", "content_sanskrit": "त्वं हि विप्रेन्द्र कार्त्स्न्येन मोक्षधर्ममुपाससे ।\nसाकल्यं मोक्षधर्मस्य श्रोतुमिच्छामि तत्त्वतः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2192610, "chapter_id": 5097, "verse_number": "१६", "content_sanskrit": "अस्तित्वंकेवलत्वं च विनाभावं तथैव च ।\nतथैवोत्क्रमणस्थानं देहिनोऽपि वियुज्यतः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2192611, "chapter_id": 5097, "verse_number": "१७", "content_sanskrit": "कालेन यद्धिप्राप्नोति स्थानं तद् ब्रूहि मे द्विज ।\nसाङ्ख्यज्ञानं च तत्त्वेन पृथग्योगं तथैव च\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2192612, "chapter_id": 5097, "verse_number": "१८", "content_sanskrit": "अरिष्टानि च तत्त्वेन वक्तुमर्हसि सत्तम।\nविदितं सर्वमेतत्ते पाणावामलकं यथा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2192613, "chapter_id": 5097, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे षट्चत्वारिंशोत्तरशततमोऽध्यायः ॥१४६॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]