[{"id": 7000702000, "chapter_id": 20702, "verse_number": "६-४५-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nमाहात्म्यं विजयायाश्च श्रुतं कृष्ण महत्फलम् ।\nफाल्गुनस्यार्जुने पक्षे यन्नाम्नी तां वदाधुना ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000702001, "chapter_id": 20702, "verse_number": "६-४५-२", "content_sanskrit": "श्रीकृष्ण उवाच ।\nधर्मपुत्र महाभाग शृणु वक्ष्यामितेऽधुना ।\nयोक्ता पृष्टेन मांधात्रा वसिष्ठेन महात्मना ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000702002, "chapter_id": 20702, "verse_number": "६-४५-३", "content_sanskrit": "फाल्गुनस्य विशेषेण विशेषः कथितो नृप ।\nआमलकीव्रतं पुण्यं विष्णुलोकफलप्रदम् ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000702003, "chapter_id": 20702, "verse_number": "६-४५-४", "content_sanskrit": "आमलक्यास्तले गत्वा जागरं तत्र कारयेत् ।\nकृत्वा जागरणं रात्रौ गोसहस्रफलं लभेत् ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000702004, "chapter_id": 20702, "verse_number": "६-४५-५", "content_sanskrit": "मांधातोवाच ।\nआमलकी कदा ह्येषा उत्पन्ना द्विजसत्तम ।\nएतत्सर्वं ममाचक्ष्व परं कौतूहलं हि मे ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000702005, "chapter_id": 20702, "verse_number": "६-४५-६", "content_sanskrit": "कस्मादियं पवित्रा च कस्मात्पापप्रणाशिनी ।\nकस्माज्जागरणं कृत्वा गोसहस्रफलं लभेत् ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000702006, "chapter_id": 20702, "verse_number": "६-४५-७", "content_sanskrit": "वसिष्ठ उवाच ।\nकथयामि महाभाग यथेयमभवत्क्षितौ ।\nआमलकी महावृक्षः सर्वपापप्रणाशनः ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000702007, "chapter_id": 20702, "verse_number": "६-४५-८", "content_sanskrit": "एकार्णवे पुरा जाते नष्टे स्थावरजंगमे ।\nनष्टे देवासुरगणे प्रणष्टोरगराक्षसे ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000702008, "chapter_id": 20702, "verse_number": "६-४५-९", "content_sanskrit": "तत्र देवादिदेवेशः परमात्मा सनातनः ।\nजगाम ब्रह्मपरममात्मनः पदमव्ययम् ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000702009, "chapter_id": 20702, "verse_number": "६-४५-१०", "content_sanskrit": "ततोऽस्य जाग्रतो ब्रह्ममुखाच्छशिसमप्रभः ।\nष्ठीवनाद्बिंदुरुत्पन्नः स भूमौ निपपात ह ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000702010, "chapter_id": 20702, "verse_number": "६-४५-११", "content_sanskrit": "तस्माद्बिंदोः समुत्पन्नः स्वयं धात्री नगो महान् ।\nशाखाप्रशाखाबहुलः फलभारेण नामितः ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000702011, "chapter_id": 20702, "verse_number": "६-४५-१२", "content_sanskrit": "सर्वेषां चैव वृक्षाणामादिरोहः प्रकीर्तितः ।\nब्रह्मणाथ ततः पश्चात्संसृष्टाश्च इमाः प्रजाः ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000702012, "chapter_id": 20702, "verse_number": "६-४५-१३", "content_sanskrit": "देवदानवगंधर्वयक्षराक्षसपन्नगान् ।\nअसृजद्भगवान्देवो महर्षींश्च तथामलान् ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000702013, "chapter_id": 20702, "verse_number": "६-४५-१४", "content_sanskrit": "आजग्मुस्तत्र देवास्ते यत्र धात्री हरिप्रिया ।\nतां दृष्ट्वा ते महाभाग परं विस्मयमागताः ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000702014, "chapter_id": 20702, "verse_number": "६-४५-१५", "content_sanskrit": "न जानीम इमं वृक्षं चिंतयंतोऽभिसंस्थिताः ।\nएवं चिंतयतां तेषां वागुवाचाशरीरिणी ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000702015, "chapter_id": 20702, "verse_number": "६-४५-१६", "content_sanskrit": "आमलकी नगो ह्येष प्रवरो वैष्णवो मतः ।\nअस्य संस्मरणादेव लभेद्गोदानजं फलम् ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000702016, "chapter_id": 20702, "verse_number": "६-४५-१७", "content_sanskrit": "स्पर्शनाद्द्विगुणं पुण्यं त्रिगुणं धारणात्तथा ।\nतस्मात्सर्वप्रयत्नेन सेव्या आमलकी सदा ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000702017, "chapter_id": 20702, "verse_number": "६-४५-१८", "content_sanskrit": "सर्वपापहरा प्रोक्ता वैष्णवी पापनाशिनी ।\nतस्या मूले स्थितो विष्णुस्तदूर्ध्वे च पितामहः ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000702018, "chapter_id": 20702, "verse_number": "६-४५-१९", "content_sanskrit": "स्कंधे च भगवान्रुद्रः संस्थितः परमेश्वरः ।\nशाखासु मुनयः सर्वे प्रशाखासु च देवताः ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000702019, "chapter_id": 20702, "verse_number": "६-४५-२०", "content_sanskrit": "पर्णेषु चासते देवाः पुष्पेषु मरुतस्तथा ।\nप्रजानां पतयः सर्वे फलेष्वेव व्यवस्थिताः ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000702020, "chapter_id": 20702, "verse_number": "६-४५-२१", "content_sanskrit": "सर्वदेवमयी ह्येषा धात्री च कथिता मया ।\nतस्मात्पूज्यतमा ह्येषा विष्णुभक्तिपरायणैः ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000702021, "chapter_id": 20702, "verse_number": "६-४५-२२", "content_sanskrit": "ऋषय ऊचुः ।\nको भवान्न हि जानीमः कस्मात्कारणतां गतः ।\nदेवो वा यदि वा चान्यः कथयस्व यथातथम् ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000702022, "chapter_id": 20702, "verse_number": "६-४५-२३", "content_sanskrit": "वागुवाच ।\nयः कर्ता सर्वभूतानां भुवनानां च सर्वशः ।\nविस्मितान्विदुषः प्रेक्ष्य सोऽहं विष्णुः सनातनः ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000702023, "chapter_id": 20702, "verse_number": "६-४५-२४", "content_sanskrit": "तच्छ्रुत्वा देवदेवस्य भाषितं ब्रह्मणः सुताः ।\nअनादिनिधनं देवं स्तोतुं तत्र प्रचक्रमुः ॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000702024, "chapter_id": 20702, "verse_number": "६-४५-२५", "content_sanskrit": "नमो भूतात्मभूताय आत्मने परमात्मने ।\nअच्युताय नमो नित्यमनंताय नमो नमः ॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000702025, "chapter_id": 20702, "verse_number": "६-४५-२६", "content_sanskrit": "दामोदराय कवये यज्ञेशाय नमो नमः ।\nएवं स्तुतस्तु ऋषिभिस्तुतोष भगवान्हरिः ॥२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000702026, "chapter_id": 20702, "verse_number": "६-४५-२७", "content_sanskrit": "प्रत्युवाच महर्षींस्तानभीष्टं किं ददामि वः ।\nऋषय ऊचुः ।\nयदि तुष्टोऽसि भगवन्नस्माकं हितकाम्यया ॥२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000702027, "chapter_id": 20702, "verse_number": "६-४५-२८", "content_sanskrit": "व्रतं किंचित्समाख्याहि स्वर्गमोक्षफलप्रदम् ।\nधनधान्यप्रदं पुण्यमात्मनस्तुष्टिकारकम् ॥२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000702028, "chapter_id": 20702, "verse_number": "६-४५-२९", "content_sanskrit": "अल्पायासं बहुफलं व्रतानामुत्तमं व्रतम् ।\nकृतेन येन देवेश विष्णुलोके महीयते ॥२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000702029, "chapter_id": 20702, "verse_number": "६-४५-३०", "content_sanskrit": "विष्णुरुवाच ।\nफाल्गुने शुक्लपक्षे तु पुष्येण द्वादशी यदि ।\nभवेत्सा च महापुण्या महापातकनाशिनी ॥३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000702030, "chapter_id": 20702, "verse_number": "६-४५-३१", "content_sanskrit": "विशेषस्तत्र कर्त्तव्यः शृणुध्वं द्विजसत्तमाः ।\nआमलकीं च संप्राप्य जागरं तत्र कारयेत् ॥३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000702031, "chapter_id": 20702, "verse_number": "६-४५-३२", "content_sanskrit": "सर्वपापविनिर्मुक्तो गोसहस्रफलं लभेत् ।\nएतद्वः कथितं विप्रा व्रतानां व्रतमुत्तमम् ।\nअर्चयित्वाच्युतं तस्यां विष्णुलोकान्न मुच्यते ॥३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000702032, "chapter_id": 20702, "verse_number": "६-४५-३३", "content_sanskrit": "ऋषय ऊचुः ।\nव्रतस्यास्य विधिं ब्रूहि परिपूर्णं कथं भवेत् ।\nके मंत्राः के नमस्काराः देवता का प्रकीर्तिता ॥३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000702033, "chapter_id": 20702, "verse_number": "६-४५-३४", "content_sanskrit": "कथं दानं कथं स्नानं कश्च पूजाविधिः स्मृतः ।\nअर्घार्चनस्य मंत्रं तु कथयस्व यथातथम् ॥३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000702034, "chapter_id": 20702, "verse_number": "६-४५-३५", "content_sanskrit": "विष्णुरुवाच ।\nश्रूयतां यो विधिः सम्यग्व्रतस्यास्य द्विजर्षभाः ।\nएकादश्यां निराहारः स्थित्वा चैव परेऽहनि ॥३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000702035, "chapter_id": 20702, "verse_number": "६-४५-३६", "content_sanskrit": "भोक्ष्येऽहं पुंडरीकाक्ष शरणं मे भवाच्युत ।\nइति कृत्वा तु नियमं दंतधावनपूर्वकम् ॥३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000702036, "chapter_id": 20702, "verse_number": "६-४५-३७", "content_sanskrit": "नालपेत्पतितांश्चौरांस्तथा पाषंडिनो नरान् ।\nदुर्वृत्तान्भिन्नमर्यादान्गुरुदारप्रधर्षकान् ॥३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000702037, "chapter_id": 20702, "verse_number": "६-४५-३८", "content_sanskrit": "अपराह्णे ततः स्नानं विधिना कारयेद्बुधः ।\nनद्यां तडागे कूपे वा गृहे वा नियतात्मवान् ॥३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000702038, "chapter_id": 20702, "verse_number": "६-४५-३९", "content_sanskrit": "मृत्तिकालंभनं पूर्वं ततः स्नानं च कारयेत् ।\nअश्वक्रांते रथक्रांते विष्णुक्रांते वसुंधरे ॥३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000702039, "chapter_id": 20702, "verse_number": "६-४५-४०", "content_sanskrit": "मृत्तिके हर मे पापं यन्मया दुष्कृतं कृतम् ॥४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000702040, "chapter_id": 20702, "verse_number": "६-४५-४१", "content_sanskrit": "त्वमंबु सर्वभूतानां जीवनं तनुरक्षकम् ।\nस्वेदजोद्भिज्जजातीनां रसानां पतये नमः ॥४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000702041, "chapter_id": 20702, "verse_number": "६-४५-४२", "content_sanskrit": "स्नातोऽहं सर्वतीर्थेषु ह्रदप्रस्रवणेषु च ।\nनदीषु देवखातेषु इदं स्नानं तु मे भवेत् ॥४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000702042, "chapter_id": 20702, "verse_number": "६-४५-४३", "content_sanskrit": "जामदग्न्यं मुनिं चैव कारयित्वा हिरण्मयम् ।\nमाषकस्य सुवर्णस्य तदर्द्धार्द्धेन वा पुनः ॥४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000702043, "chapter_id": 20702, "verse_number": "६-४५-४४", "content_sanskrit": "गृहमागत्य पूजायाः पूजाहोमं तु कारयेत् ।\nततश्चामलकीं गच्छेत्सर्वोपस्करसंयुतः ॥४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000702044, "chapter_id": 20702, "verse_number": "६-४५-४५", "content_sanskrit": "आमलकीं ततो गत्वा परिशोध्य समंततः ।\nस्थापयेत्सततं कुंभमव्रणं मंत्रपूर्वकम् ॥४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000702045, "chapter_id": 20702, "verse_number": "६-४५-४६", "content_sanskrit": "पंचरत्नसमोपेतं दिव्यगंधाधिवासितम् ।\nछत्रोपानद्युगोपेतं सितचंदनचर्चितम् ॥४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000702046, "chapter_id": 20702, "verse_number": "६-४५-४७", "content_sanskrit": "स्रग्दामलंबितग्रीवं सर्वधूपविधूपितम् ।\nदीपमालाकुलं कुर्यात्सर्वतः सुमनोहरम् ॥४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000702047, "chapter_id": 20702, "verse_number": "६-४५-४८", "content_sanskrit": "तस्योपरि न्यसेत्पात्रं दिव्यलाजैः प्रपूरितम् ।\nपात्रोपरि न्यसेद्देवं जामदग्न्यं महाप्रभम् ॥४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000702048, "chapter_id": 20702, "verse_number": "६-४५-४९", "content_sanskrit": "विशोकाय नमः पादौ जानुनी विश्वरूपिणे ।\nउग्राय च ततोऽप्यूरू कटी दामोदराय च ॥४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000702049, "chapter_id": 20702, "verse_number": "६-४५-५०", "content_sanskrit": "उदरं पद्मनाभाय उरः श्रीवत्सधारिणे ।\nचक्रिणे वामबाहुं च दक्षिणं गदिने नमः ॥५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000702050, "chapter_id": 20702, "verse_number": "६-४५-५१", "content_sanskrit": "वैकुंठाय नमः कंठमास्यं यज्ञमुखाय वै ।\nनासां विशोकनिधये वासुदेवाय चाक्षिणी ॥५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000702051, "chapter_id": 20702, "verse_number": "६-४५-५२", "content_sanskrit": "ललाटं वामनायेति रामायेति भ्रुवौ नमः ।\nसर्वात्मने तु तच्छीर्षं नम इत्यभिपूजयेत् ॥५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000702052, "chapter_id": 20702, "verse_number": "६-४५-५३", "content_sanskrit": "ततो देवाधिदेवाय अर्घं चैव प्रदापयेत् ।\nफलेन चैव शुभ्रेण भक्तियुक्तेन चेतसा ॥५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000702053, "chapter_id": 20702, "verse_number": "६-४५-५४", "content_sanskrit": "ततो जागरणं कुर्याद्भक्तियुक्तेन चेतसा ।\nनृत्यैर्गीतैश्च वादित्रैर्द्धर्माख्यानैः स्तवैरपि ॥५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000702054, "chapter_id": 20702, "verse_number": "६-४५-५५", "content_sanskrit": "वैष्णवैश्च तथाख्यानैः क्षपयेत्सर्वशर्वरीम् ।\nप्रदक्षिणां ततः कुर्याद्धात्र्या वै विष्णुनामभिः ॥५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000702055, "chapter_id": 20702, "verse_number": "६-४५-५६", "content_sanskrit": "अष्टाधिकं शतं चैव अष्टाविंशतिरेव वा ।\nततः प्रभाते समये कृत्वा नीराजनं हरेः ॥५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000702056, "chapter_id": 20702, "verse_number": "६-४५-५७", "content_sanskrit": "ब्राह्मणं पूजयित्वा तु सर्वं तस्मै निवेदयेत् ।\nजामदग्न्य घटे तत्र वस्त्रयुग्ममुपानहौ ॥५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000702057, "chapter_id": 20702, "verse_number": "६-४५-५८", "content_sanskrit": "जामदग्न्यस्वरूपेण प्रीयतां मम केशवः ।\nततश्चामलकीं स्पृष्ट्वा कृत्वा चैव प्रदक्षिणाम् ॥५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000702058, "chapter_id": 20702, "verse_number": "६-४५-५९", "content_sanskrit": "स्नानं कृत्वा विधानेन ब्राह्मणान्भोजयेत्ततः ।\nततश्च स्वयमश्नीयात्कुटुंबेन समावृतः ॥५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000702059, "chapter_id": 20702, "verse_number": "६-४५-६०", "content_sanskrit": "एवं कृतेन यत्पुण्यं तत्सर्वं कथयामि ते ।\nसर्वतीर्थेषु यत्पुण्यं सर्वदानेषु यत्फलम् ॥६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000702060, "chapter_id": 20702, "verse_number": "६-४५-६१", "content_sanskrit": "सर्वयज्ञाधिकं चैव लभते नात्र संशयः ।\nएतद्वः सर्वमाख्यातं व्रतानामुत्तमं व्रतम् ॥६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000702061, "chapter_id": 20702, "verse_number": "६-४५-६२", "content_sanskrit": "एतावदुक्त्वा देवेशस्तत्रैवांतरधीयत ।\nते चापि ऋषयः सर्वे चक्रुः सर्वमशेषतः ॥६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000702062, "chapter_id": 20702, "verse_number": "६-४५-६३", "content_sanskrit": "तथा त्वमपि राजेन्द्र कर्तुमर्हसि सत्तम ।\nव्रतमेतद्दुराधर्षं सर्वपापप्रमोचनम् ॥६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]