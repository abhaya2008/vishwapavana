[{"id": 2039037, "chapter_id": 1853, "verse_number": "५-९८-०x", "content_sanskrit": "कण्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2039038, "chapter_id": 1853, "verse_number": "५-९८-१", "content_sanskrit": "मातलिस्तु व्रजन्मार्गे नारदेन महर्षिणा।\nवरुणं गच्छता द्रष्टुं समागच्छद्यदृच्छया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2039039, "chapter_id": 1853, "verse_number": "५-९८-२", "content_sanskrit": "नारदोऽथाब्रवीदेनं क्व भवान्गन्तुमुद्यतः ।\nस्येन वा सूत कार्येण शासनाद्वा शतक्रतोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2039040, "chapter_id": 1853, "verse_number": "५-९८-३", "content_sanskrit": "मातलिर्नारदेनैवं संपृष्टः पथि गच्छता।\nयथावत्सर्वमाचष्ट स्वकार्यं नारदं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2039041, "chapter_id": 1853, "verse_number": "५-९८-४", "content_sanskrit": "तमुवाचाथ स मुनिर्गच्छावः सहिताविति।\nसलिलेशदिदृक्षार्थमहमप्युद्यतो दिवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2039042, "chapter_id": 1853, "verse_number": "५-९८-५", "content_sanskrit": "अहं ते सर्वमाख्यास्ये दर्शयन्वसुधातलम्।\nदृष्ट्वा तत्र वरं कंचिद्रोचयिष्याव मातले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2039043, "chapter_id": 1853, "verse_number": "५-९८-६", "content_sanskrit": "अवगाह्य तु तौ भूमिमुभौ मातलिनारदौ ।\nददृशाते महात्मानौ लोकपालमपां पतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2039044, "chapter_id": 1853, "verse_number": "५-९८-७", "content_sanskrit": "तत्र देवर्षिसदृशीं पूजां स प्राप नारदः ।\nमहेन्द्रसदृशीं चैव मातलिः प्रत्यपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2039045, "chapter_id": 1853, "verse_number": "५-९८-८", "content_sanskrit": "तावुभौ ग्रीतमनसौ कार्यवन्तौ निवेद्य ह।\nवरुणेनाभ्यनुज्ञातौ नागलोकं विचेरतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2039046, "chapter_id": 1853, "verse_number": "५-९८-९", "content_sanskrit": "नारदः सर्वभूतानामन्तर्भूमिनिवासिनाम् ।\nजानंश्चकार व्याख्यानं यन्तुः सर्वमशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2039047, "chapter_id": 1853, "verse_number": "५-९८-१०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2039048, "chapter_id": 1853, "verse_number": "५-९८-१०", "content_sanskrit": "दृष्टस्ते वरुणः सूत पुत्रपौत्रसमावृतः ।\nपश्योदकपतेः स्थानं सर्वतोभद्रमृद्धिमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2039049, "chapter_id": 1853, "verse_number": "५-९८-११", "content_sanskrit": "एष पुत्रो महाप्रज्ञो वरुणस्येह गोपतेः।\nएष वै शीलवृत्तेन शौचेन च विशिष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2039050, "chapter_id": 1853, "verse_number": "५-९८-१२", "content_sanskrit": "एषोऽस्य पुत्रोऽभिमतः पुष्करः पुष्करेक्षणः ।\nरूपवान्दर्शनीयश्च सोमपुत्र्या वृतः पतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2039051, "chapter_id": 1853, "verse_number": "५-९८-१३", "content_sanskrit": "ज्योत्स्नाकालीति यामाहुर्द्वितीयां रूपतः श्रियम् ।\nअदित्याश्चैव यः पुत्रो ज्येष्ठः श्रेष्ठः कृतः स्मृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2039052, "chapter_id": 1853, "verse_number": "५-९८-१४", "content_sanskrit": "भवनं पश्य वारुण्यं यदेतत्सर्वकाञ्चनम्।\nयत्प्राप्य सुरतां प्राप्ताः सुराः सुरपतेः सखे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2039053, "chapter_id": 1853, "verse_number": "५-९८-१५", "content_sanskrit": "एतानि हृतराज्यानां दैतेयानां स्म मातले ।\nदीप्यमानानि दृश्यन्ते सर्वप्रहरणान्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2039054, "chapter_id": 1853, "verse_number": "५-९८-१६", "content_sanskrit": "अक्षयाणि किलैतानि विवर्तन्ते स्म मातले ।\nअनुभावप्रयुक्तानि सुरैरवजितानि ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2039055, "chapter_id": 1853, "verse_number": "५-९८-१७", "content_sanskrit": "अत्र राक्षसजात्यश्च दैत्यजात्यश्च मातले ।\nदिव्यप्रहरणाश्चासन्पूर्वदैवतनिर्मिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2039056, "chapter_id": 1853, "verse_number": "५-९८-१८", "content_sanskrit": "अग्निरेष महार्चिष्माञ्जागर्ति वारुणे ह्रदे ।\nवैष्णवं चक्रमाविद्धं विधूमेन हविष्मता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2039057, "chapter_id": 1853, "verse_number": "५-९८-१९", "content_sanskrit": "एष गाण्डीमयश्चापो लोकसंहारसंभृतः।\nरक्ष्यते दैवतैर्नित्यं यतस्तद्गाण्डिवं धनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2039058, "chapter_id": 1853, "verse_number": "५-९८-२०", "content_sanskrit": "एष कृत्ये समुत्पन्ने तत्तद्धारयते बलम्।\nसहस्रशतसङ्ख्येन प्राणेन सततं ध्रुवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2039059, "chapter_id": 1853, "verse_number": "५-९८-२१", "content_sanskrit": "अशास्यानपि शास्त्येष रक्षोबन्धुषु राजसु ।\nसृष्टः प्रथमतश्चण्डो ब्रह्मणा ब्रह्मवादिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2039060, "chapter_id": 1853, "verse_number": "५-९८-२२", "content_sanskrit": "एतच्छस्त्रं नरेन्द्राणां महच्चक्रे भासितम् ।\nपुत्राः सलिलराजस्य धारयन्ति महोदयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2039061, "chapter_id": 1853, "verse_number": "५-९८-२३", "content_sanskrit": "एतत्सलिलराजस्य छत्रं छत्रगृहे स्थितम् ।\nसर्वतः सलिलं शीतं जीमूत इव वर्षति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2039062, "chapter_id": 1853, "verse_number": "५-९८-२४", "content_sanskrit": "एतच्छत्रात्परिभ्रष्टं सलिलं सोमनिर्मलम् ।\nतमसा मूर्छितं भाति येन नार्छति दर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2039063, "chapter_id": 1853, "verse_number": "५-९८-२५", "content_sanskrit": "बहून्यद्भुतरूपाणि द्रष्टव्यानीह मातले।\nतव कार्योपरोधस्तु तस्माद्गच्छाव मा चिरम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2039064, "chapter_id": 1853, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वमि अष्टनवतितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]