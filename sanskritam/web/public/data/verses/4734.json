[{"id": 2176546, "chapter_id": 4734, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2176547, "chapter_id": 4734, "verse_number": "१", "content_sanskrit": "ततस्ते प्रययुः सर्वे निवेशाय महीक्षितः ।\nशङ्खान् प्रध्मापयन्तो वै हृष्टाः परिघबाहवः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2176548, "chapter_id": 4734, "verse_number": "२", "content_sanskrit": "पाण्डवान् गच्छतश्चापि शिबिरं नो विशाम्पते ।\nमहेश्वासोऽन्वगात् पश्चात् सात्यकिः सत्यविक्रमः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2176549, "chapter_id": 4734, "verse_number": "३", "content_sanskrit": "धृष्टद्युम्नः शिखण्डी च सृञ्जयश्चापि सर्वशः ।\nसर्वे चान्ये महेष्वासा जग्मुः स्वशिबिराण्युत\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2176550, "chapter_id": 4734, "verse_number": "४", "content_sanskrit": "ततस्ते प्राविशन् पार्था हतत्विषं हतेश्वरम् ।\nदुर्योधनस्य शिबिरं रङ्गवन्निःसृते जने\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2176551, "chapter_id": 4734, "verse_number": "५", "content_sanskrit": "गतोत्सवं पुरमिव हृतनागमिव ह्रदम् ।\nस्त्रीवर्षधरभूयिष्ठं वृद्धामात्यैरधिरिष्ठतम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2176552, "chapter_id": 4734, "verse_number": "६", "content_sanskrit": "तत्रैतान् पर्युपातिष्ठन् दुर्योधनपुरस्सराः ।\nकृताञ्जलिपुटा राजन् काषायमलिनाम्बराः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2176553, "chapter_id": 4734, "verse_number": "७", "content_sanskrit": "शिबिरं समनुप्राप्य कुरुराजस्य पाण्डवाः ।\nअवतेरुर्महाराज रथेभ्यो रथसत्तमाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2176554, "chapter_id": 4734, "verse_number": "८", "content_sanskrit": "ततो गाण्डीवधन्वानमभ्यभाषत केशवः ।\nस्थितः प्रियहिते नित्यमतीव पुरुषर्षभः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2176555, "chapter_id": 4734, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2176556, "chapter_id": 4734, "verse_number": "९", "content_sanskrit": "अवरोपय गाण्डीवमक्षयौ च महेषुधी ।\nततोऽहमवरोक्ष्यामि पश्चाद् भरतसत्तम\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2176557, "chapter_id": 4734, "verse_number": "१०", "content_sanskrit": "स्वयं चैवावरोह त्वमेतच्छ्रेयस्तवानघ\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2176558, "chapter_id": 4734, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2176559, "chapter_id": 4734, "verse_number": "११", "content_sanskrit": "अवारोहत् तदा वीरः पाण्डपुत्रो धनञ्जयः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2176560, "chapter_id": 4734, "verse_number": "१२", "content_sanskrit": "अथ पश्चात्ततः कृष्णो रश्मीनुत्सृज्य वाजिनाम् ।\nअवारोहत मेधावी रथाद् गाण्डीवधन्वनः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2176561, "chapter_id": 4734, "verse_number": "१३", "content_sanskrit": "अथावतीर्णे भूतानामीश्वरो पुरुषोत्तमे ।\nकपिरप्याश्वपाक्रामत् सह देवैर्ध्वजालयैः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2176562, "chapter_id": 4734, "verse_number": "१४", "content_sanskrit": "स दग्धो द्रोणकर्णाभ्यां दिव्यैरस्त्रैर्महारथः ।\nअथ दीप्तोऽग्निनाऽप्याशु प्रजज्वाल महाद्युतिः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2176563, "chapter_id": 4734, "verse_number": "१५", "content_sanskrit": "सोपासङ्गः सतूणीरः साश्वः सयुगबन्धनः ।\nभस्मीभूतोऽभवद् भूमौ रथो गाण्डीवधन्वनः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2176564, "chapter_id": 4734, "verse_number": "१६", "content_sanskrit": "तं दृष्ट्वा भस्मसाद्भूतं तदा पाण्डुसुताः प्रभो ।\nअभवन् विस्मिता राजन्नर्जुनश्चेदमब्रवीत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2176565, "chapter_id": 4734, "verse_number": "१७", "content_sanskrit": "कृताञ्जलिः सप्रणयं प्रणिपत्याभिवाद्य च\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2176566, "chapter_id": 4734, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2176567, "chapter_id": 4734, "verse_number": "१८", "content_sanskrit": "गोविन्द कस्माद् भगवन् रथो दग्धोऽयमग्निना\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2176568, "chapter_id": 4734, "verse_number": "१९", "content_sanskrit": "किमेतन्महदाश्चर्यं भगवन् यदुनन्दन ।\nतन्मे ब्रूहि महाबाहो श्रोतव्यं यदि चेन्मया\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2176569, "chapter_id": 4734, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2176570, "chapter_id": 4734, "verse_number": "२०", "content_sanskrit": "द्रोणकर्णास्त्रनिर्दग्धः पूर्वमेवायमर्जुन ।\nमदधिष्ठितत्वात् समरे न विशीर्णः परन्तप\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2176571, "chapter_id": 4734, "verse_number": "२१", "content_sanskrit": "इदानीं तु विशीर्णोऽयं दग्धो ब्रह्मास्त्रतेजसा ।\nमया विमुक्तः कौन्तेय त्वय्यद्य कृतकर्मणि\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2176572, "chapter_id": 4734, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2176573, "chapter_id": 4734, "verse_number": "२२", "content_sanskrit": "ईषदुत्स्मयमानस्तु भगवान् केशवोऽरिहा ।\nपरिष्वज्य तु राजानं युधिष्ठिरमभाषत\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2176574, "chapter_id": 4734, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2176575, "chapter_id": 4734, "verse_number": "२३", "content_sanskrit": "दिष्ट्या जयसि कौन्तेय दिष्ट्या ते शत्रवो हताः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2176576, "chapter_id": 4734, "verse_number": "२४", "content_sanskrit": "दिष्ट्या गाण्डीवधन्वा च भीमसेनश्च पाण्डवः ।\nत्वं चापि कुशली राजन् माद्रीपुत्रौ च पाण्डवौ\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2176577, "chapter_id": 4734, "verse_number": "२५", "content_sanskrit": "मुक्त वीरक्षयादस्मात् सङ्ग्रामान्निहतद्विषः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2176578, "chapter_id": 4734, "verse_number": "२६", "content_sanskrit": "क्षिप्रमुत्तरकालानि कुरु कर्माणि भारत\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2176579, "chapter_id": 4734, "verse_number": "२७", "content_sanskrit": "उपयातमुपप्लाव्यं सह गाण्डीवधन्वना ।\nआनीय मधुपर्कं मां यत्पुरा त्वमवोचथाः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2176580, "chapter_id": 4734, "verse_number": "२८", "content_sanskrit": "एष भ्राता सखा चैव तव कृष्ण धनञ्जयः ।\nरक्षितव्यो महाबाहो सर्वास्वापत्स्विति प्रभो\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2176581, "chapter_id": 4734, "verse_number": "२९", "content_sanskrit": "तव चैव ब्रुवाणस्य तथेत्येवाहमब्रुवम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2176582, "chapter_id": 4734, "verse_number": "३०", "content_sanskrit": "स सव्यसाची गुप्तस्ते विजयी च नरेश्वर ।\nभ्रातृभिः सह राजेन्द्र शूरः सत्यपराक्रमः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2176583, "chapter_id": 4734, "verse_number": "३१", "content_sanskrit": "मुक्तो वीरक्षयादस्मात् सङ्ग्रामाद् रोमहर्षणात्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2176584, "chapter_id": 4734, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2176585, "chapter_id": 4734, "verse_number": "३२", "content_sanskrit": "एवमुक्तस्तु कृष्णेन धर्मपुत्रो युधिष्ठिरः ।\nहृष्टरोमा महाबाहुः प्रत्युवाच जनार्दनम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2176586, "chapter_id": 4734, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2176587, "chapter_id": 4734, "verse_number": "३३", "content_sanskrit": "प्रयुक्तं द्रोणकर्णाभ्यां ब्रह्मास्त्रमरिसूदन ।\nकस्त्वदन्यः सहेत् साक्षादपि वज्री पुरन्दरः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2176588, "chapter_id": 4734, "verse_number": "३४", "content_sanskrit": "भवतस्तु प्रसादाच्च सङ्ग्रामे बहवो जिताः ।\nमहारणगतः पार्थो यच्च नासीत् पराङ्मुखः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2176589, "chapter_id": 4734, "verse_number": "३५", "content_sanskrit": "तथा तव महाबाहो पर्यायैर्बहुभिर्मया ।\nकर्मणामनुसन्धानात् तेजसश्च गतिः श्रुता\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2176590, "chapter_id": 4734, "verse_number": "३६", "content_sanskrit": "उपप्लाव्ये महर्षिर्मां कृष्णद्वैपायनोऽब्रवीत् ।\nयतो धर्मस्ततः कृष्णो यतः कृष्णस्ततो जयः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2176591, "chapter_id": 4734, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2176592, "chapter_id": 4734, "verse_number": "३७", "content_sanskrit": "एवमुक्तस्ततः कृष्णः प्रत्युवाच युधिष्ठिरम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2176593, "chapter_id": 4734, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2176594, "chapter_id": 4734, "verse_number": "३८", "content_sanskrit": "अक्षौहिण्यो दशाष्टौ च तव तेषां च भारत ।\nन तुल्याश्चार्जुनस्येह बलेन कुरुनन्दन\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2176595, "chapter_id": 4734, "verse_number": "३९", "content_sanskrit": "स एष सर्वाण्यस्त्राणि दिव्यानि प्राप्य शङ्करात् ।\nमत्समो वा विशिष्टो वा रणे त्वमिति पाण्डव\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2176596, "chapter_id": 4734, "verse_number": "४०", "content_sanskrit": "अनुज्ञातः पाण्डुसुतः पुनः प्रत्यागमन्महीम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2176597, "chapter_id": 4734, "verse_number": "४१", "content_sanskrit": "भूतं भव्यं भविष्यच्च अनुजानासि चेत् प्रभो ।\nनिमेषार्धान्नरव्याघ्रो नयेदिति मतिर्मम\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2176598, "chapter_id": 4734, "verse_number": "४२", "content_sanskrit": "द्रोणं भीष्मं कृपं कर्णं द्रोणपुत्रं जयद्रथम् ।\nनिहन्तुं शक्नुयात् क्रुद्धो निमेषार्धाद्धनञ्जयः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2176599, "chapter_id": 4734, "verse_number": "४३", "content_sanskrit": "सदेवासुरगन्धर्वान् सयक्षोरगराक्षसान् ।\nजित्वा लोकान् विजेतुं हि शक्तः किमिह मानुषान्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2176600, "chapter_id": 4734, "verse_number": "४४", "content_sanskrit": "विधिना महितश्चासौ मया सञ्चोदितोऽपि सन् ।\nन चकार मतिं हन्तुं कृतान्तो बलवत्तरः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2176601, "chapter_id": 4734, "verse_number": "४५", "content_sanskrit": "अत्र गीता मया सुष्ठु गिरः सत्या महीपते ।\nदर्शितं मयि सर्वं च तेनासौ जितवान् रिपून्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2176602, "chapter_id": 4734, "verse_number": "४६", "content_sanskrit": "अर्जुनोऽपि महाबाहुर्मया तुल्यो महीपते ।\nस महेश्वरलब्धास्त्रः किं न कुर्याद् विभुः प्रभो\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2176603, "chapter_id": 4734, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2176604, "chapter_id": 4734, "verse_number": "४७", "content_sanskrit": "इत्येवमुक्ते ते वीराः शिबिरं तव भारत ।\nप्रविश्य प्रत्यपद्यन्त कोशरत्नर्धिसञ्चयान्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2176605, "chapter_id": 4734, "verse_number": "४८", "content_sanskrit": "रजतं जातरूपं च मणीनथ च मौक्तिकान् ।\nभूषणान्यथ मुख्यानि कम्बलान्यजिनानि च\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2176606, "chapter_id": 4734, "verse_number": "४९", "content_sanskrit": "दासीदासमसङ्ख्येयं राज्योपकरणानि च\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2176607, "chapter_id": 4734, "verse_number": "५०", "content_sanskrit": "ते प्राप्य धनमक्षय्यं त्वदीयं भरतर्षभ ।\nउदक्रोशन् महेष्वासा नरेन्द्र विजितारयः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2176608, "chapter_id": 4734, "verse_number": "५१", "content_sanskrit": "ते तु वीराः समाश्वस्य वाहनान्यवमुच्य च ।\nअतिष्ठन्त मुहुः सर्वे पाण्डवा विगतज्वराः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2176609, "chapter_id": 4734, "verse_number": "५२", "content_sanskrit": "अथाब्रवीन्महाराज वासुदेवो महायशाः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2176610, "chapter_id": 4734, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2176611, "chapter_id": 4734, "verse_number": "५३", "content_sanskrit": "अस्माभिर्मङ्गलार्थाय वस्तव्यं नगराद् बहिः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2176612, "chapter_id": 4734, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2176613, "chapter_id": 4734, "verse_number": "५४", "content_sanskrit": "जयन्ती यत्र देवी तु तत्र व्रजत माचिरम् ।\nउपपादितमेतन्मे युद्धारम्भोपकल्पितम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2176614, "chapter_id": 4734, "verse_number": "५५", "content_sanskrit": "तथेत्युक्त्वा तु ते सर्वे पाण्डवाः सात्यकिस्तथा ।\nवासुदेवेन सहिता मङ्गलार्थं ययुर्बहिः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2176615, "chapter_id": 4734, "verse_number": "५६", "content_sanskrit": "ते समासाद्य सरितं पुण्यामोघवतीं तदा ।\nन्यवसन्नथ तां रात्रिं पाण्डवा जितशत्रवः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2176616, "chapter_id": 4734, "verse_number": "५७", "content_sanskrit": "युधिष्ठिरस्ततो राजा प्राप्तकालमचिन्तयत्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2176617, "chapter_id": 4734, "verse_number": "५८", "content_sanskrit": "तत्र ते(मे) गमनं प्राप्तं(यः) रोचते तव माधव ।\nगान्धार्याः क्रोधदीप्तायाः प्रशमार्थमरिन्दम\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2176618, "chapter_id": 4734, "verse_number": "५९", "content_sanskrit": "हेतुकारणयुक्तैश्च(स्तै) वाक्यैः कालसमीरितैः ।\nक्षिप्रमेव महाभाग गान्धारीं प्रशमिष्यसि\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2176619, "chapter_id": 4734, "verse_number": "६०", "content_sanskrit": "पितामहश्च भगवान् व्यासस्तत्र भविष्यति\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2176620, "chapter_id": 4734, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2176621, "chapter_id": 4734, "verse_number": "६१", "content_sanskrit": "ततः सम्प्रेषयामासुर्यादवं गजसाह्वयम् ।\nततः प्रायाज्जवेनाशु वासुदेवः प्रतापवान्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2176622, "chapter_id": 4734, "verse_number": "६२", "content_sanskrit": "दारुकं रथमास्थाय यत्र राजाऽम्बिकासुतः ।\nतमूचुः सम्प्रयास्यन्तं शैब्यसुग्रीववाहनम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2176623, "chapter_id": 4734, "verse_number": "", "content_sanskrit": "पाण्डवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2176624, "chapter_id": 4734, "verse_number": "६३", "content_sanskrit": "प्रत्याश्वासय गान्धारीं हतपुत्रां यशस्विनीम्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2176625, "chapter_id": 4734, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2176626, "chapter_id": 4734, "verse_number": "६४", "content_sanskrit": "स प्रायात् पाण्डवैरुक्तस्तत्पुरं सात्वतां वरः ।\nआसिसादयिषुः क्षिप्रं गान्धारीं निहतात्मजाम्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2176627, "chapter_id": 4734, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां गदापर्वणि वासुदेवप्रयाणं नाम द्वात्रिंशोऽध्यायः ॥३२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}]