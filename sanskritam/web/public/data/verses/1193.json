[{"id": 2009814, "chapter_id": 1193, "verse_number": "१-१९५-०x", "content_sanskrit": "गन्धर्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2009815, "chapter_id": 1193, "verse_number": "१-१९४-१", "content_sanskrit": "आश्रमस्था ततः पुत्रमदृश्यन्ती व्यजायत।\nशक्तेः कुलकरं राजन् द्वितीयमिव शक्तिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2009816, "chapter_id": 1193, "verse_number": "१-१९४-२", "content_sanskrit": "जातकर्मादिकास्तस्य क्रियाः स मुनिसत्तमः।\nपौत्रस्य भरतश्रेष्ठ चकार भगवान्स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2009817, "chapter_id": 1193, "verse_number": "१-१९४-३", "content_sanskrit": "परासुः स यतस्तेन वसिष्ठः स्थापितो मुनिः।\nगर्भस्थेन ततो लोके पराशर इति स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2009818, "chapter_id": 1193, "verse_number": "१-१९४-४", "content_sanskrit": "अमन्यत स धर्मात्मा वसिष्ठं पितरं मुनिः।\nजन्मप्रभृति तस्मिंस्तु पितरीवान्ववर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2009819, "chapter_id": 1193, "verse_number": "१-१९४-५", "content_sanskrit": "स तात इति विप्रर्षिं वसिष्ठं प्रत्यभाषत।\nमातुः समक्षं कौन्तेय अदृश्यन्त्याः परन्तप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2009820, "chapter_id": 1193, "verse_number": "१-१९४-६", "content_sanskrit": "तातेति परिपूर्णार्थं तस्य तन्मधुरं वचः।\nअदृश्यन्त्यश्रुपूर्णाक्षी शृण्वती तमुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2009821, "chapter_id": 1193, "verse_number": "१-१९४-७", "content_sanskrit": "मा तात ताततातेति ब्रूह्येनं पितरं पितुः।\nरक्षसा भक्षितस्तात तव तातो वनान्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2009822, "chapter_id": 1193, "verse_number": "१-१९४-८", "content_sanskrit": "मन्यसे यं तु तातेति नैष तातस्तवानघ।\nआर्य एष पिता तस्य पितुस्तव यशस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2009823, "chapter_id": 1193, "verse_number": "१-१९४-९", "content_sanskrit": "स एवमुक्तो दुःखार्तः सत्यवागृषिसत्तमः।\nसर्वलोकविनाशाय मतिं चक्रे महामनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2009824, "chapter_id": 1193, "verse_number": "१-१९४-१०", "content_sanskrit": "तं तथा निश्चितात्मानं स महात्मा महातपाः।\nऋषिर्ब्रह्मविदां श्रष्ठो मैत्रावरुणिरन्त्यधीः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2009825, "chapter_id": 1193, "verse_number": "१-१९४-११", "content_sanskrit": "वसिष्ठो वारयामास हेतुना येन तच्छृणु।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2009826, "chapter_id": 1193, "verse_number": "१-१९४-११x", "content_sanskrit": "वसिष्ठ उवाच।\nकृतवीर्य इति ख्यातो बभूव पृथिवीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2009827, "chapter_id": 1193, "verse_number": "१-१९४-१२", "content_sanskrit": "याज्यो वेदविदां लोके भृगूणां पार्थिवर्षभः।\nस तानग्रभुजस्तात धान्येन च धनेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2009828, "chapter_id": 1193, "verse_number": "१-१९४-१३", "content_sanskrit": "सोमान्ते तर्पयामास विपुलेन विशांपतिः।\nतस्मिन्नृपतिशार्दूले स्वर्यातेऽथ कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2009829, "chapter_id": 1193, "verse_number": "१-१९४-१४", "content_sanskrit": "बभूव तत्कुलेयानां द्रव्यकार्यमुपस्थितम्।\nभृगूणां तु धनं ज्ञात्वा राजानः सर्व एव ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2009830, "chapter_id": 1193, "verse_number": "१-१९४-१५", "content_sanskrit": "याचिष्णवोऽभिजग्मुस्तांस्ततो भार्गवसत्तमान्।\nभूमौ तु निददुः केचिद्भृगवो धनमक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2009831, "chapter_id": 1193, "verse_number": "१-१९४-१६", "content_sanskrit": "ददुः केचिद्द्विजातिभ्यो ज्ञात्वा क्षत्रियतो भयम्।\nभृहवस्तु ददुः केचित्तेषां वित्तं यथेप्सितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2009832, "chapter_id": 1193, "verse_number": "१-१९४-१७", "content_sanskrit": "क्षत्रियाणां तदा तात कारणान्तरदर्शनात्।\nततो महीतलं तात क्षत्रियेण यदृच्छया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2009833, "chapter_id": 1193, "verse_number": "१-१९४-१८", "content_sanskrit": "खनताऽधिगतं वित्तं केनच्चिद्धृगुवेश्मनि।\nतद्वित्तं ददृशुः सर्वे समेताः क्षत्रियर्षभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2009834, "chapter_id": 1193, "verse_number": "१-१९४-१९", "content_sanskrit": "अवमन्य ततः क्रोधाद्भृगूंस्ताञ्छरणगतान्।\nनिजघ्नुः परमेष्वासाः सर्वांस्तान्निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2009835, "chapter_id": 1193, "verse_number": "१-१९४-२०", "content_sanskrit": "आगर्भादवकृन्तन्तश्चेरुः सर्वां वसुन्धराम्।\nतत उच्छिद्यमानेषु भृगुष्वेवं भयात्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2009836, "chapter_id": 1193, "verse_number": "१-१९४-२१", "content_sanskrit": "भृगुपत्न्यो गिरिं दुर्गं हिमवन्तं प्रपेदिरे।\nतासामन्यतमा गर्भं भयाद्दध्रे महौजसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2009837, "chapter_id": 1193, "verse_number": "१-१९४-२२", "content_sanskrit": "ऊरुणैकेन वाभोरूर्भर्तुः कुलविवृद्धये।\nतं गर्भमुपलभ्याशु ब्राह्मण्येका भयार्दिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2009838, "chapter_id": 1193, "verse_number": "१-१९४-२३", "content_sanskrit": "गत्वा वै कथयामास क्षत्रियाणामुपह्वरे।\nततस्ते क्षत्रिया जग्मुस्तं गर्भं हन्तुमुद्यताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2009839, "chapter_id": 1193, "verse_number": "१-१९४-२४", "content_sanskrit": "ददृशुर्ब्राह्मणीं तेऽथ दीप्यमानां स्वतेजसा।\nअथ गर्भः स भित्त्वोरुं ब्राह्मण्या निर्जगाम ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2009840, "chapter_id": 1193, "verse_number": "१-१९४-२५", "content_sanskrit": "मुष्णन्दृष्टीः क्षत्रियाणां मध्याह्न इव भास्करः।\nततश्चक्षुर्विहीनास्ते गिरिदुर्गेषु बभ्रमुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2009841, "chapter_id": 1193, "verse_number": "१-१९४-२६", "content_sanskrit": "ततस्ते मोघसङ्कल्पा भयार्ताः क्षत्रियाः पुनः।\nब्राह्मणीं शरमं जग्मुर्दृष्ट्यर्थं तामनिन्दिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2009842, "chapter_id": 1193, "verse_number": "१-१९४-२७", "content_sanskrit": "ऊचुश्चैनां महाभागां क्षत्रियास्ते विचेतसः।\nज्योतिःप्रहीणा दुःखार्ताः शान्तार्चिष इवाग्नयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2009843, "chapter_id": 1193, "verse_number": "१-१९४-२८", "content_sanskrit": "भगवत्याः प्रसादेन गच्छेत्क्षत्रमनामयम्।\nउपारम्य च गच्छेम सहिताः पापकर्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2009844, "chapter_id": 1193, "verse_number": "१-१९४-२९", "content_sanskrit": "सपुत्रा त्वं प्रसादं नः कर्तुमर्हसि शोभने।\nपुनर्दृष्टिप्रदानेन राज्ञः संत्रातुमर्हसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2009845, "chapter_id": 1193, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिप्रवणि चैत्ररथपर्वणि चतुर्नवत्यधिकशततमोऽध्यायः॥ १९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]