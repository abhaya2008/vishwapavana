[{"id": 2008126, "chapter_id": 1157, "verse_number": "१-१५८-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2008127, "chapter_id": 1157, "verse_number": "१-१५८-१", "content_sanskrit": "ततः सर्वाः प्रकृतयो नगराद्वारणावतात्।\nसर्वमङ्गलसंयुक्ता यथाशास्त्रमतन्द्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2008128, "chapter_id": 1157, "verse_number": "१-१५८-२", "content_sanskrit": "श्रुत्वाऽगतान्पाण्डुपुत्रान्नानायानैः सहस्रशः।\nअभिजग्मुर्नरश्रेष्ठाञ्श्रुत्वैव परया मुदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2008129, "chapter_id": 1157, "verse_number": "१-१५८-३", "content_sanskrit": "ते समासाद्य कौन्तेयान्वारणावतका जनाः।\nकृत्वा जयाशिषः सर्वे परिवार्योपतस्थिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2008130, "chapter_id": 1157, "verse_number": "१-१५८-४", "content_sanskrit": "तैर्वृतः पुरुषव्याघ्रो धर्मराजो युधिष्ठिरः।\nविबभौ देवसङ्काशो वज्रपाणिरिवामरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2008131, "chapter_id": 1157, "verse_number": "१-१५८-५", "content_sanskrit": "सत्कृताश्चैव पौरैस्ते पौरान्सत्कृत्य चानघ।\nअलङ्कृतं जनाकीर्णं विविशुर्वारणावतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2008132, "chapter_id": 1157, "verse_number": "१-१५८-६", "content_sanskrit": "ते प्रविश्य पुरीं वीरास्तूर्णं जग्मुरथो गृहान्।\nब्राह्मणानां महीपाल रतानां स्वेषु कर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2008133, "chapter_id": 1157, "verse_number": "१-१५८-७", "content_sanskrit": "नगराधिकृतानां च गृहाणि रथिनां वराः।\nउपतस्थुर्नरश्रेष्ठा वैश्यशूद्रगृहाण्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2008134, "chapter_id": 1157, "verse_number": "१-१५८-८", "content_sanskrit": "अर्चिताश्च नरैः पौरैः पाण्डवा भरतर्षभ।\nजग्मुरावसथं पश्चात्पुरोचनपुरःसराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2008135, "chapter_id": 1157, "verse_number": "१-१५८-९", "content_sanskrit": "तेभ्यो भक्ष्याणि पानानि शयनानि शुभानि च।\nआसनानि च मुख्यानि प्रददौ स पुरोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2008136, "chapter_id": 1157, "verse_number": "१-१५८-१०", "content_sanskrit": "तत्र ते सत्कृतास्तेन सुमहार्हपरिच्छदाः।\nउपास्यमानाः पुरुषैरूषुः पुरनिवासिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2008137, "chapter_id": 1157, "verse_number": "१-१५८-११", "content_sanskrit": "दशरात्रोषितानां तु तत्र तेषां पुरोचनः।\nनिवेदयामास गृहं शिवाख्यमशिवं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2008138, "chapter_id": 1157, "verse_number": "१-१५८-१२", "content_sanskrit": "तत्र ते पुरुषव्याघ्रा विविशुः सपरिच्छदाः।\nपुरोचनस्य वचनात्कैलासमिव गुह्यकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2008139, "chapter_id": 1157, "verse_number": "१-१५८-१३", "content_sanskrit": "तच्चागारमभिप्रेक्ष्य सर्वधर्मभृतां वरः।\nउवाचाग्नेयमित्येवं भीमसेनं युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2008140, "chapter_id": 1157, "verse_number": "१-१५८-१४", "content_sanskrit": "जिघ्राणोऽस्य वसागन्धं सर्पिर्जतुविमिश्रितम्।\nकृतं हि व्यक्तमाग्नेयमिदं वेश्म परन्तप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2008141, "chapter_id": 1157, "verse_number": "१-१५८-१५", "content_sanskrit": "शणसर्जरसं व्यक्तमानीय गृहकर्मणि।\nमुञ्जबल्वजवंशादिद्रव्यं सर्वं घृतोक्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2008142, "chapter_id": 1157, "verse_number": "१-१५८-१६", "content_sanskrit": "तृणबल्वजकार्पासवंशदारुकटान्यपि।\nआग्नेयान्यत्र क्षिप्तानि परितो वेश्मनस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2008143, "chapter_id": 1157, "verse_number": "१-१५८-१७", "content_sanskrit": "शिल्पिभिः सुकृतं ह्याप्तैर्विनीतैर्वेश्मकर्मणि।\nविश्वस्तं मामयं पापो दग्धुकामः पुरोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2008144, "chapter_id": 1157, "verse_number": "१-१५८-१८", "content_sanskrit": "तथा हि वर्तते मन्दः सुयोधनवशे स्थितः।\nइमां तु तां महाबुद्धिर्विदुरो दृष्टवांस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2008145, "chapter_id": 1157, "verse_number": "१-१५८-१९", "content_sanskrit": "आपदं तेन मां पार्थ स संबोधितवान्पुरा।\nते वयं बोधितास्तेन नित्यमस्मद्धितैषिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2008146, "chapter_id": 1157, "verse_number": "१-१५८-२०", "content_sanskrit": "पित्रा कनीयसा स्नेहाद्बुद्धिमन्तो शिवं गृहम्।\nअनार्यैः सुकृतं गूढैर्दुर्योधनवशानुगैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2008147, "chapter_id": 1157, "verse_number": "१-१५८-२१x", "content_sanskrit": "भीमसेन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2008148, "chapter_id": 1157, "verse_number": "१-१५८-२१", "content_sanskrit": "यदीदं गृहामाग्नेयं विहितं मन्यते भवान्।\nतत्रैव साधु गच्छामो यत्र पूर्वोषिता वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2008149, "chapter_id": 1157, "verse_number": "१-१५८-२२", "content_sanskrit": "दर्शयित्वा पृथग्गन्तुं न कार्यं प्रतिभाति मे।\nअशुभं वा शुभं वा स्यात्तैर्वसाम सहैव तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2008150, "chapter_id": 1157, "verse_number": "१-१५८-२३", "content_sanskrit": "अद्यप्रभृति चास्मासु गतेषु भयविह्वलः।\nरूढमूलो भवेद्राज्ये धार्तराष्ट्रो जनेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2008151, "chapter_id": 1157, "verse_number": "१-१५८-२४", "content_sanskrit": "तदीयं तु भवेद्राज्यं तदीयाश्च जना इमे।\nतस्मात्सहैव वत्स्यामो गलन्यस्तपदा वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2008152, "chapter_id": 1157, "verse_number": "१-१५८-२५", "content_sanskrit": "अस्माकं कालमासाद्य राज्यमाच्छिद्य शत्रुतः।\nअर्थं पैतृकमस्माकं सुखं भोक्ष्याम शाश्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2008153, "chapter_id": 1157, "verse_number": "१-१५८-२६", "content_sanskrit": "धृतराष्ट्रवचोऽस्माभिः किमर्थमनुपाल्यते।\nतेभ्यो भित्त्वाऽन्यथागन्तुं दौर्बल्यं ते कुतो नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2008154, "chapter_id": 1157, "verse_number": "१-१५८-२७", "content_sanskrit": "आपत्सु रक्षिताऽस्माकं विदुरोऽस्ति महामतिः।\nमध्यस्थ एव गाङ्गेयो राज्यभोगपराङ्मुखः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2008155, "chapter_id": 1157, "verse_number": "१-१५८-२८", "content_sanskrit": "बाह्लीकप्रमुखा वृद्धा मध्यस्था एव सर्वदा।\nअस्मदीयो भवेद्द्रोणः फल्गुनप्रेमसंयुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2008156, "chapter_id": 1157, "verse_number": "१-१५८-२९", "content_sanskrit": "तस्मात्सहैव वस्तव्यं न गन्तव्यं कथं नृप।\nअथवास्मासु ते कुर्युः किमशक्ताः पराक्रमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2008157, "chapter_id": 1157, "verse_number": "१-१५८-३०", "content_sanskrit": "क्षुद्राः कपटिनो धूर्ता जाग्रत्सु मनुजेश्वर।\nकिं न कुर्युः पुरा मह्यं किं न दत्तं महाविषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2008158, "chapter_id": 1157, "verse_number": "१-१५८-३१", "content_sanskrit": "आशीविषैर्महाघोरैः सर्पैस्तैः किं न दंशितः।\nप्रमाणकोट्यां संगृह्य निद्रापरवशे मयि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2008159, "chapter_id": 1157, "verse_number": "१-१५८-३२", "content_sanskrit": "सर्पैर्दृष्टिविषैर्गोरैर्गङ्गायां शूलसन्ततौ।\nकिं तैर्न पातितो भूप तदा किं मृतवानहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2008160, "chapter_id": 1157, "verse_number": "१-१५८-३३", "content_sanskrit": "आपत्सु तासु घोरासु दुष्प्रयुक्तासु पापिभिः।\nअस्मानरक्षद्यो देवो जगद्यस्य वशे स्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2008161, "chapter_id": 1157, "verse_number": "१-१५८-३४", "content_sanskrit": "चराचरात्मकं सोऽद्य यातः कुत्र नृपोत्तम।\nयावत्सोढव्यमस्माभिस्तावत्सोढास्मि यत्नतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2008162, "chapter_id": 1157, "verse_number": "१-१५८-३५", "content_sanskrit": "यदा न शक्ष्यतेऽस्माभिस्तदा पश्याम नो हितम्।\nकिं द्रष्टव्यमिहास्माभिर्विगृह्य तरसा बलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2008163, "chapter_id": 1157, "verse_number": "१-१५८-३६", "content_sanskrit": "सान्त्ववादेन दानेन भेदेनापि यतामहे।\nअर्धराज्यस्य संप्राप्त्यै ततो दण्डः प्रशस्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2008164, "chapter_id": 1157, "verse_number": "१-१५८-३७", "content_sanskrit": "तस्मात्सहैव वस्तव्यं तन्मनोर्पितशल्यवत्।\nदर्शयित्वा पृथक् क्वापि न गन्तव्यं सुभीतवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2008165, "chapter_id": 1157, "verse_number": "१-१५८-३८x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2008166, "chapter_id": 1157, "verse_number": "१-१५८-३८", "content_sanskrit": "इह यत्तैर्निराकारैर्वस्तव्यमिति रोचये।\nअप्रमत्तैर्विचिन्वद्भिर्गतिमिष्टां ध्रुवामितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2008167, "chapter_id": 1157, "verse_number": "१-१५८-३९", "content_sanskrit": "यदि विन्देत चाकारमस्माकं स पुरोचनः।\nक्षिप्रकारी ततो भूत्वा प्रसह्यापि दहेत्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2008168, "chapter_id": 1157, "verse_number": "१-१५८-४०", "content_sanskrit": "नायं बिभेत्युपक्रोशादधर्माद्वा पुरोचनः।\nतथा हि वर्तते मन्दः सुयोधनवशे स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2008169, "chapter_id": 1157, "verse_number": "१-१५८-४१", "content_sanskrit": "अपि चायं प्रदग्धेषु भीष्मोऽस्मासु पितामहः।\nकोपं कुर्यात्किमर्थं वा कौरवान्कोपयीत सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2008170, "chapter_id": 1157, "verse_number": "१-१५८-४२", "content_sanskrit": "अथवापीह दग्धेषु भीष्मोऽस्माकं पितामहः।\nधर्म इत्येव कुप्येरन्ये चान्ये कुरुपुङ्गवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2008171, "chapter_id": 1157, "verse_number": "१-१५८-४३", "content_sanskrit": "उपपन्नं तु दग्धेषु कुलवंशानुकीर्तिताः।\nकुप्येरन्यदि धर्मज्ञास्तथान्ये कुरुपुङ्गवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2008172, "chapter_id": 1157, "verse_number": "१-१५८-४४", "content_sanskrit": "वयं तु यदि दाहस्य बिभ्यतः प्रद्रवेमहि।\nस्पशैर्नो घातयेत्सर्वान्राज्यलुब्धः सुयोधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2008173, "chapter_id": 1157, "verse_number": "१-१५८-४५", "content_sanskrit": "अपदस्थान्पदे तिष्ठन्नपक्षान्पक्षसंस्थितः।\nहीनकोशान्महाकोशः प्रयोगैर्घातयेद्ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2008174, "chapter_id": 1157, "verse_number": "१-१५८-४६", "content_sanskrit": "तदस्माभिरिमं पापं तं च पापं सुयोधनम्।\nवञ्चयद्भिर्निवस्तव्यं छन्नं वीर क्वचित्क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2008175, "chapter_id": 1157, "verse_number": "१-१५८-४७", "content_sanskrit": "ते वयं मृगयाशीलाश्चराम वसुधामिमाम्।\nतथा नो विदिता मार्गा भविष्यन्ति पलायतां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2008176, "chapter_id": 1157, "verse_number": "१-१५८-४८", "content_sanskrit": "भौमं च बिलमद्यैव करवाम सुसंवृतम्।\nगूढोद्गतान्न नस्तत्र हुताशः संप्रधक्ष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2008177, "chapter_id": 1157, "verse_number": "१-१५८-४९", "content_sanskrit": "द्रवतोऽत्र यथा चास्मान्न बुध्येत पुरोचनः।\nपौरो वापि जनः कश्चित्तथा कार्यमतन्द्रितैः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2008178, "chapter_id": 1157, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि जतुगृहपर्वणि अष्टपञ्चाशदधिकशततमोऽध्यायः॥ १५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]