[{"id": 7002914000, "chapter_id": 22914, "verse_number": "९-१९९-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nअतः परं प्रवक्ष्यामि तिलशैलं विधानतः ।\nयत्प्रदानान्नरो याति विष्णुलोकमनुत्तमम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002914001, "chapter_id": 22914, "verse_number": "९-१९९-२", "content_sanskrit": "तिलाः पवित्रमतुलं पवित्राणां च पावनम् ।\nविष्णुदेहसमुद्भूतास्तस्मादुत्तमतां गताः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002914002, "chapter_id": 22914, "verse_number": "९-१९९-३", "content_sanskrit": "मधुकैटभनामानावास्तां दितिसुतौ पुरा ।\nमधुना सह तत्राभूद्युद्धं विष्णोरनारतम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002914003, "chapter_id": 22914, "verse_number": "९-१९९-४", "content_sanskrit": "सहस्रं किल वर्षाणां न व्यजीवत दानवः ।\nतत्र स्वेदो महानासीत्क्रुद्धस्याथ गदाभृतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002914004, "chapter_id": 22914, "verse_number": "९-१९९-५", "content_sanskrit": "पतितश्च धरापृष्ठे कणशो लवशस्तथा ।\nसमुत्तस्थुस्तिला माषाः कुशाश्च कुरुनंदन ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002914005, "chapter_id": 22914, "verse_number": "९-१९९-६", "content_sanskrit": "हतश्च हरिणा युद्धे स मधुर्बलिनां वरः ।\nमेदसा तस्य वसुधा रंजिता सकला तदा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002914006, "chapter_id": 22914, "verse_number": "९-१९९-७", "content_sanskrit": "मेदिनीति ततः संज्ञामवापाचल धारिणी ।\nहतेऽथ दैत्यप्रवरे देवास्तोषं परं ययुः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002914007, "chapter_id": 22914, "verse_number": "९-१९९-८", "content_sanskrit": "स्तुतिभिश्च परं स्तुत्वा ऊचुस्त्रिदशपुंगवम् ।\nदेवा ऊचुः ।\nत्वया धृतं जगद्देव त्वया सृष्टं तथैव च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002914008, "chapter_id": 22914, "verse_number": "९-१९९-९", "content_sanskrit": "त्वयीश लीयते सर्वं त्वयैव मधुसूदन ।\nतस्मात्त्वदंगतो जातास्तिलाः संतु जगद्धिताः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002914009, "chapter_id": 22914, "verse_number": "९-१९९-१०", "content_sanskrit": "पालयंतु च देवेश हव्यकव्यानि सर्वदा ।\nदैवे पित्र्ये च सततं नियोज्यास्तत्परैर्नरैः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002914010, "chapter_id": 22914, "verse_number": "९-१९९-११", "content_sanskrit": "नहि दैत्याः पिशाचा वा विप्रं कुर्वंति भारत ।\nतिला यत्रोपयुज्यंते एतच्छीघ्रं विधीयताम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002914011, "chapter_id": 22914, "verse_number": "९-१९९-१२", "content_sanskrit": "श्रुत्वा सुराणां तद्वाक्यं विष्णुस्तानिदमब्रवीत् ।\nतिला भवन्तु रक्षार्थं त्रयाणां जगतामपि ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002914012, "chapter_id": 22914, "verse_number": "९-१९९-१३", "content_sanskrit": "शुक्लपक्षे तु देवानां संप्रदद्यात्तिलोदकम् ।\nकृष्णपक्षे पितॄणां च स्नात्वा श्रद्धासमन्वितः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002914013, "chapter_id": 22914, "verse_number": "९-१९९-१४", "content_sanskrit": "तिलैः सप्ताष्टभिर्वापि समर्पितजलांजलिः ।\nतस्य देवाः सपितरस्तृप्ता यच्छंति शोभनम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002914014, "chapter_id": 22914, "verse_number": "९-१९९-१५", "content_sanskrit": "श्वकाकोपहतं यच्च पतितादिभिरेव च ।\nतिलैरभ्युक्षितं सर्वं पवित्रं स्यान्न संशयः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002914015, "chapter_id": 22914, "verse_number": "९-१९९-१६", "content_sanskrit": "एतैर्मृतैस्तिलैर्यस्तु कृत्वा पर्वतमुत्तमम् ।\nप्रदद्याद्द्विजमुख्याय दानं तस्याक्षयं भवेत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002914016, "chapter_id": 22914, "verse_number": "९-१९९-१७", "content_sanskrit": "उत्तमो दशभिर्द्रोणैर्मध्यमः पंचभिर्मतः ।\nत्रिभिः कनिष्ठो राजेन्द्र तिलशैलः प्रकीर्तितः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002914017, "chapter_id": 22914, "verse_number": "९-१९९-१८", "content_sanskrit": "पूर्ववच्चापरं सर्वं विष्कंभपर्वतादिकम् ।\nदानमन्नं प्रवक्ष्यामि यथावन्नृपसत्तम ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002914018, "chapter_id": 22914, "verse_number": "९-१९९-१९", "content_sanskrit": "यस्मान्मधुवधे विष्णोर्देहस्वेदसमुद्भवाः ।\nतिलाः कुशाश्च माषाश्च तस्माच्छं नो भवत्विह ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002914019, "chapter_id": 22914, "verse_number": "९-१९९-२०", "content_sanskrit": "हव्ये कव्ये च यस्माच्च तिलैरेवाभिमंत्रणम् ।\nभवादुद्धर शैलेंद्र तिलाचल नमोऽस्तु ते ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002914020, "chapter_id": 22914, "verse_number": "९-१९९-२१", "content_sanskrit": "इत्यामंत्र्य च यो दद्यात्तिलाचलमनुत्तमम् ।\nस वैष्णवं पदं याति पुनरावृत्तिदुर्लभम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002914021, "chapter_id": 22914, "verse_number": "९-१९९-२२", "content_sanskrit": "दीर्घायुष्ट्वमवाप्नोति इह लोके परत्र च ।\nपितृभिर्देवगन्धर्वैः पूज्यमानो दिवं व्रजेत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002914022, "chapter_id": 22914, "verse_number": "९-१९९-२३", "content_sanskrit": "पुण्यक्षयादिहाभ्येत्य राजा भवति धार्मिकः ।\nनारी वा तस्य पत्नी स्याद्रूपसौभाग्यसंयुता ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002914023, "chapter_id": 22914, "verse_number": "९-१९९-२४", "content_sanskrit": "दक्षा कुलोद्भवा चैव पुत्रपौत्रसमन्विता ।\nविधानमिदमाकर्ण्य विधिना श्रद्धयान्वितः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002914024, "chapter_id": 22914, "verse_number": "९-१९९-२५", "content_sanskrit": "कपिलादानपुण्यस्य समं फलमवाप्नुयात् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002914025, "chapter_id": 22914, "verse_number": "९-१९९-२६", "content_sanskrit": "दानं तिलाचलसमं यदि चान्यदस्ति तद्भूत शास्त्रनिचयं प्रविचार्य बुद्ध्या ।\nयैर्वर्जिता पितृक्रिया न च होमकर्म तेषां प्रदानमिह किं न करोति शर्म ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]