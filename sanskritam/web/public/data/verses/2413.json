[{"id": 2067105, "chapter_id": 2413, "verse_number": "९-३१-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2067106, "chapter_id": 2413, "verse_number": "९-३१-१", "content_sanskrit": "ततस्तेष्वपयातेषु रथेषु त्रिषु पाण्डवाः।\nतं हदं प्रत्यपद्यन्त यत्र दुर्योधनोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2067107, "chapter_id": 2413, "verse_number": "९-३१-२", "content_sanskrit": "आसाद्य च कुरुश्रेष्ठ तदा द्वैपायनं हदम्।\nस्तम्भितं धार्तराष्ट्रेण दृष्ट्वा तं सलिलाशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2067108, "chapter_id": 2413, "verse_number": "९-३१-३", "content_sanskrit": "वासुदेवमिदं वाक्यमब्रवीत्कुरुनन्दनः।\nपश्येमां धार्तराष्ट्रेण मायामप्सु प्रयोजिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2067109, "chapter_id": 2413, "verse_number": "९-३१-४", "content_sanskrit": "विष्टभ्य सलिलं शेते नास्य मानुषतो भयम्।\nदैवीं मायामिमां कृत्वा सलिलान्तर्गतो ह्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2067110, "chapter_id": 2413, "verse_number": "९-३१-५", "content_sanskrit": "निकृत्या निकृतिप्रज्ञो न मे जीवन्विमोक्ष्यते।\nयद्यस्य समरे साह्यं कुरुते वज्रभृत्स्वयम्।\nतथाप्येनं हतं युद्धे लोका द्रक्ष्यन्ति माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2067111, "chapter_id": 2413, "verse_number": "९-३१-६x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2067112, "chapter_id": 2413, "verse_number": "९-३१-६", "content_sanskrit": "मायाविन इमां मायां मायया जहि भारत।\nमायावी मायया वध्यः सत्यमेतद्युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2067113, "chapter_id": 2413, "verse_number": "९-३१-७", "content_sanskrit": "क्रियाभ्युपायैर्बहुभिर्भायामप्सु प्रयोज्य च।\nजहि त्वं भरतश्रेष्ठ मायात्मानं सुयोधनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2067114, "chapter_id": 2413, "verse_number": "९-३१-८", "content_sanskrit": "क्रियाभ्युपायैरिन्द्रेण निहता दैत्यदानवाः।\nक्रियाभ्युपायैर्बलिभिर्बलिर्बद्धो महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2067115, "chapter_id": 2413, "verse_number": "९-३१-९", "content_sanskrit": "क्रियाभ्युपायपूर्वं वै हिरण्याक्षो महासुरः।\nहिरण्यकशिपुश्चैव क्रिययैव निषूदितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2067116, "chapter_id": 2413, "verse_number": "९-३१-१०", "content_sanskrit": "वृत्रश्च निहतो राजन्क्रिययैव महाबलः।\nतथा पौलस्त्यतनयो रावणो नाम राक्षसः।\nरामेण निहतो राजन्सानुबन्धः सहानुगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2067117, "chapter_id": 2413, "verse_number": "९-३१-११", "content_sanskrit": "क्रियया योगमास्थाय तथा त्वमपि विक्रम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2067118, "chapter_id": 2413, "verse_number": "९-३१-१२", "content_sanskrit": "क्रियाभ्युपायैर्निहतौ मया राजन्पुरातनौ।\nतारकश्च महादैत्यो विप्रचित्तिश्च वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2067119, "chapter_id": 2413, "verse_number": "९-३१-१३", "content_sanskrit": "वातापिरिल्वलश्चैव त्रिशिराश्च तथा विभो।\nसुन्दोपसुन्दावसुरौ क्रिययैव निषूदितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2067120, "chapter_id": 2413, "verse_number": "९-३१-१४", "content_sanskrit": "क्रियाभ्युपायैरिन्द्रेण त्रिदिवं भुज्यते विभो।\nक्रिया बलवती राजन्नान्यत्किंचिद्युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2067121, "chapter_id": 2413, "verse_number": "९-३१-१५", "content_sanskrit": "दैत्याश्च दानवाश्चैव राक्षसाः पार्थिवास्तथा।\nक्रियाभ्युपायैर्निहताः क्रियां तस्मात्समाचर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2067122, "chapter_id": 2413, "verse_number": "९-३१-१६x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2067123, "chapter_id": 2413, "verse_number": "९-३१-१६", "content_sanskrit": "इत्युक्तो वासुदेवेन पाण्डवः संशितव्रतः।\nजलस्थं तं महाराज तव पुत्रं महाबलम्।\nअभ्यभाषत कौन्तेयः प्रहसन्निव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2067124, "chapter_id": 2413, "verse_number": "९-३१-१७", "content_sanskrit": "सुयोधन किमर्थोऽयमारम्भोऽप्सु कृतस्त्वया।\nसर्वं क्षत्रं घातयित्वा स्वकुलं च विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2067125, "chapter_id": 2413, "verse_number": "९-३१-१८", "content_sanskrit": "जलाशयं प्रविष्टोऽद्य वाञ्छञ्जीवितमात्मनः।\nउत्तिष्ठ राजन्युध्यस्व सहास्माभिः सुयोधन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2067126, "chapter_id": 2413, "verse_number": "९-३१-१९", "content_sanskrit": "स ते दर्पो नरश्रेष्ठ स च मानः क्व ते गतः।\nयस्त्वं संस्तभ्य सलिलं भीतो राजन्व्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2067127, "chapter_id": 2413, "verse_number": "९-३१-२०", "content_sanskrit": "सर्वे त्वां शूर इत्येवं जना जल्पन्ति संसदि।\nव्यर्थं तद्भवतो मन्ये शौर्यं सलिलशायिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2067128, "chapter_id": 2413, "verse_number": "९-३१-२१", "content_sanskrit": "उत्तिष्ठ राजन्युध्यस्व क्षत्रियोऽसि कुलोद्भवः।\nकौरवेयो विशेषेण कुलं जन्म च संस्मर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2067129, "chapter_id": 2413, "verse_number": "९-३१-२२", "content_sanskrit": "स कथं कौरवे वंशे प्रशंसञ्जन्म चात्मनः।\nयुद्वात्त्रस्ततरस्तोयं प्रविश्य प्रतितिष्ठसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2067130, "chapter_id": 2413, "verse_number": "९-३१-२३", "content_sanskrit": "अयुद्धेन व्यवस्थानं नैष धर्मः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2067131, "chapter_id": 2413, "verse_number": "९-३१-२४", "content_sanskrit": "अनार्यजुष्टमस्वर्ग्यं रणे राजन्पलायनम्।\nकथं पारमगत्वा हि युद्धे त्वं वै जिजीविषुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2067132, "chapter_id": 2413, "verse_number": "९-३१-२५", "content_sanskrit": "इमान्निपतितान्दृष्ट्वा पुत्रान्भ्रातॄन्पितॄंस्तथा।\nसम्बन्धिनो वयस्यांश्च मातुलान्बान्धवांस्तथा।\nघातयित्वा कथं तात हदे तिष्ठति साम्प्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2067133, "chapter_id": 2413, "verse_number": "९-३१-२६", "content_sanskrit": "शूरमानी न शूरस्त्वं मृषा वदसि भारत।\nशूरोऽहमिति दुर्बुद्धे सर्वलोकस्य शृण्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2067134, "chapter_id": 2413, "verse_number": "९-३१-२७", "content_sanskrit": "न हि शूराः पलायन्ते शत्रून्दृष्ट्वा कथञ्चन।\nब्रूहि वा त्वं यया वृत्त्या शूर त्यजसि सङ्गरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2067135, "chapter_id": 2413, "verse_number": "९-३१-२८", "content_sanskrit": "स त्वमुत्तिष्ठ युध्यस्व विहाय भयमात्मनः।\nघातयित्वा सर्वसैन्यं भ्रातॄंश्चैव सुयोधन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2067136, "chapter_id": 2413, "verse_number": "९-३१-२९", "content_sanskrit": "नेदानीं जीविते बुद्धिः कार्या धर्मचिकीर्षया।\nक्षत्रधर्ममुपाश्रित्य त्वद्विधेन सुयोधन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2067137, "chapter_id": 2413, "verse_number": "९-३१-३०", "content_sanskrit": "यत्तु कर्णमुपाश्रित्य शकुनिं चापि सौबलम्।\nदुःशासनं च मोहात्त्वमात्मानं नावबुद्धवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2067138, "chapter_id": 2413, "verse_number": "९-३१-३१", "content_sanskrit": "तत्पापं सुमहत्कृत्वा प्रतियुध्यस्व भारत।\nकथं हि त्वद्विधो मोहाद्रोचयेत पलायनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2067139, "chapter_id": 2413, "verse_number": "९-३१-३२", "content_sanskrit": "क्व ते तत्पौरुषं यातं क्व च मानः सुयोधन।\nक्व च विक्रान्तता याता क्व च विस्फूर्जितं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2067140, "chapter_id": 2413, "verse_number": "९-३१-३३", "content_sanskrit": "क्व ते कृतास्त्रता याता किं नु शेषे जलाशये।\nस त्वमुत्तिष्ठ युध्यस्व क्षत्रधर्मेण भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2067141, "chapter_id": 2413, "verse_number": "९-३१-३४", "content_sanskrit": "अस्मांस्तु वा पराजित्य प्रशाधि पृथिवीमिमाम्।\nअथवा निहतोस्माभिर्भूमौ स्वप्स्यसि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2067142, "chapter_id": 2413, "verse_number": "९-३१-३५", "content_sanskrit": "एष ते परमो धर्मः सृष्टो धात्रा महात्मना।\nतं कुरुष्व यथातथ्यं पौरुषे स्व व्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2067143, "chapter_id": 2413, "verse_number": "९-३१-३६x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2067144, "chapter_id": 2413, "verse_number": "९-३१-३६", "content_sanskrit": "एवमुक्तो महाराज धर्मपुत्रेण धीमता।\nसलिलस्थस्तव सुत इदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2067145, "chapter_id": 2413, "verse_number": "९-३१-३७", "content_sanskrit": "नैतच्चित्रं महाराज यद्भीः प्राणिनमाविशेत्।\nन च प्राणभयाद्भीतो व्यपयातोऽस्मि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2067146, "chapter_id": 2413, "verse_number": "९-३१-३८", "content_sanskrit": "अरथश्चानिषङ्गी च निहतः पार्ष्णिसारथिः।\nएकश्चाप्यगणः सङ्ख्ये प्रत्याश्वासमरोचयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2067147, "chapter_id": 2413, "verse_number": "९-३१-३९", "content_sanskrit": "न प्राणहेतोर्न भयाश्च विषादाद्विशाम्पते।\nइदमम्भः प्रविष्टोऽस्मि श्रमात्त्विदमनुष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2067148, "chapter_id": 2413, "verse_number": "९-३१-४०", "content_sanskrit": "त्वं चाश्वसिहि कौन्तेय ये चाप्यनुगतास्तव।\nअहमुत्थाय वः सर्वान्प्रतियोत्स्यामि संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2067149, "chapter_id": 2413, "verse_number": "९-३१-४१x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2067150, "chapter_id": 2413, "verse_number": "९-३१-४१", "content_sanskrit": "आश्वस्ता एव सर्वे स्म चिरं त्वां मृगयामहे।\nतदिदानीं समुत्तिष्ठ युध्यस्वेह सुयोधन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2067151, "chapter_id": 2413, "verse_number": "९-३१-४२", "content_sanskrit": "हत्वा वा समरे पार्थान्स्फीतं राज्यमवाप्नुहि।\nनिहतो वा रणेऽस्माभिर्वीरलोकमवाप्स्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2067152, "chapter_id": 2413, "verse_number": "९-३१-४३x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2067153, "chapter_id": 2413, "verse_number": "९-३१-४३", "content_sanskrit": "यदर्थं राज्यमिच्छामि कुरूणां कुरुनन्दन।\nत इमे निहताः सर्वे भ्रातरो मे जनेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2067154, "chapter_id": 2413, "verse_number": "९-३१-४४", "content_sanskrit": "क्षीणरत्नां च पृथिवीं हतक्षत्रियपुङ्गवाम्।\nन ह्युत्सहाम्यहं भोक्तुं विधवामिव योषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2067155, "chapter_id": 2413, "verse_number": "९-३१-४५", "content_sanskrit": "अद्यापि त्वहमाशंसे त्वां विजेतुं युधिष्ठिर।\nभङ्क्त्वा पाञ्चालपाण्डूनामुत्साहं भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2067156, "chapter_id": 2413, "verse_number": "९-३१-४६", "content_sanskrit": "न त्विदानीमहं मन्ये कार्यं युद्धेन कर्हिचित्।\nद्रोणे कर्णे च संशान्ते निहते च पितामहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2067157, "chapter_id": 2413, "verse_number": "९-३१-४७", "content_sanskrit": "अस्त्विदानीमियं राजन्केवला पृथिवी तव।\nअसहायो हि को राजा राज्यमिच्छेत्प्रशासितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2067158, "chapter_id": 2413, "verse_number": "९-३१-४८", "content_sanskrit": "सुहृदस्तादृशान्हत्वा पुत्रान्भ्रातॄन्पितॄनपि।\nभवद्भिश्च हृते राज्ये को नु जीवेत मादृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2067159, "chapter_id": 2413, "verse_number": "९-३१-४९", "content_sanskrit": "अहं वनं गमिष्यामि ह्यजिनैः प्रतिवासितः।\nरतिर्हि नास्ति मे राज्ये हतपक्षस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2067160, "chapter_id": 2413, "verse_number": "९-३१-५०", "content_sanskrit": "हतबान्धवभूयिष्ठा हताश्वा हतकुञ्जरा।\nएषा ते पृथिवी राजन्भुङ्क्षैनां विगतज्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2067161, "chapter_id": 2413, "verse_number": "९-३१-५१", "content_sanskrit": "वनमेव गमिष्यामि वसानो मृगचर्मणी।\nन हि मे निर्जनस्यास्ति जीवितेऽद्य स्पृहा विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2067162, "chapter_id": 2413, "verse_number": "९-३१-५२", "content_sanskrit": "गच्छ त्वं भुङ्क्ष राजेन्द्र पृथिवीं निहतेश्वराम्।\nहतयोधां नष्टरत्नां शीर्णक्षत्रां यथासुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2067163, "chapter_id": 2413, "verse_number": "९-३१-५३x", "content_sanskrit": "[सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2067164, "chapter_id": 2413, "verse_number": "९-३१-५३", "content_sanskrit": "दुर्योधनं तव सुतं सलिलस्थं महायशाः।\nश्रुत्वा तु करुणं वाक्यमभाषत युधिष्ठिरः॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2067165, "chapter_id": 2413, "verse_number": "९-३१-५४x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2067166, "chapter_id": 2413, "verse_number": "९-३१-५४", "content_sanskrit": "आर्तप्रलापान्मा तात सलिलस्थः प्रभाषथाः।\nनैतन्मनसि मे राजन्वाशितं शकुनेरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2067167, "chapter_id": 2413, "verse_number": "९-३१-५५", "content_sanskrit": "यदि वापि समर्थः स्यास्त्वं दानाय सुयोधन।\nनाहमिच्छेयमवनिं त्वया दत्तां प्रशासितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2067168, "chapter_id": 2413, "verse_number": "९-३१-५६", "content_sanskrit": "अधर्मेण न गृह्णीयां त्वया दत्तां महीमिमाम्।\nन हि धर्मः स्मृतो राजन्क्षत्रियस्य प्रतिग्रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2067169, "chapter_id": 2413, "verse_number": "९-३१-५७", "content_sanskrit": "त्वया दत्तां न चेच्छेयं पृथिवीमखिलामहम्।\nत्वां तु युद्धे विनिर्जित्य भोक्ताऽस्मि वसुधामिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2067170, "chapter_id": 2413, "verse_number": "९-३१-५८", "content_sanskrit": "अनीश्वरश्च पृथिवीं कथं त्वं दातुमिच्छसि।\nत्वयेयं पृथिवी राजन्किं न दत्ता तदैव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2067171, "chapter_id": 2413, "verse_number": "९-३१-५९", "content_sanskrit": "धर्मतो याचमानानां प्रशमार्थं कुलस्य नः।\nवार्ष्णेयं प्रथमं राजन्प्रत्याख्याय महाबालम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2067172, "chapter_id": 2413, "verse_number": "९-३१-६०", "content_sanskrit": "किमिदानीं ददासि त्वं को हि ते जित्तविभ्रमः।\nअभियुक्तस्तु को राजा दातुमिच्छेद्धि मेदिनीं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2067173, "chapter_id": 2413, "verse_number": "९-३१-६१", "content_sanskrit": "न त्वमद्य महीं दातुमीशः कौरवनन्दन।\nआच्छेत्तुं वा बलाद्राजन्स कथं दातुमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2067174, "chapter_id": 2413, "verse_number": "९-३१-६२", "content_sanskrit": "मां तु निर्जित्य सङ्ग्रामे पालयेमां वसुन्धराम्।\nसूच्यग्रेणापि यद्भूमेरपि भिद्येत भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2067175, "chapter_id": 2413, "verse_number": "९-३१-६३", "content_sanskrit": "तन्मात्रमपि तन्मह्यं न ददाति पुरा भवान्।\nस कथं पृथिवीमेतां प्रददासि विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2067176, "chapter_id": 2413, "verse_number": "९-३१-६४", "content_sanskrit": "सूच्यग्रं नात्यजः पूर्वं स कथं त्यजसि क्षितिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2067177, "chapter_id": 2413, "verse_number": "९-३१-६५", "content_sanskrit": "एवमैश्वर्यमासाद्य प्रशास्य पृथिवीमिमाम्।\nको हि मूढो व्यवस्येत शत्रोर्दातुं वसुन्धराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2067178, "chapter_id": 2413, "verse_number": "९-३१-६६", "content_sanskrit": "त्वं तु केवलमौर्ख्येण विमूढो नावबुध्यसे।\nपृथिवीं दातुकामोऽपि जीवंस्त्वं नैव मोक्ष्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2067179, "chapter_id": 2413, "verse_number": "९-३१-६७", "content_sanskrit": "अस्मान्वा त्वं पराजित्य प्रशाधि पृथिवीमिमाम्।\nअथवा निहतोऽस्माभिर्व्रज लोकाननुत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2067180, "chapter_id": 2413, "verse_number": "९-३१-६८", "content_sanskrit": "आवयोर्जीवतो राजन्मयि च त्वयि च ध्रुवम्।\nसंशयः सर्वभूतानां विजये नौ भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2067181, "chapter_id": 2413, "verse_number": "९-३१-६९", "content_sanskrit": "जीवितं त्वयि दुष्प्रापं मयि यत्परिवर्तते।\nजीवयेयमहं कामं न तु त्वं जीवितुं क्षमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2067182, "chapter_id": 2413, "verse_number": "९-३१-७०", "content_sanskrit": "दहने हि कृतो यत्नस्त्वयाऽस्मासु विशेषतः।\nआशीविषैर्विषैश्चापि जले जापि प्रवेशनैः।\nत्वया विनिकृता राजन्राज्यस्य हरणेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2067183, "chapter_id": 2413, "verse_number": "९-३१-७१", "content_sanskrit": "अप्रियाणां च वचनैर्द्रौपद्याः कर्षणेन च।\nएतस्मात्कारणात्पाप जीवितं न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2067184, "chapter_id": 2413, "verse_number": "९-३१-७२", "content_sanskrit": "उत्तिष्ठोत्तिष्ठ युध्यस्व युद्धे श्रेयो भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2067185, "chapter_id": 2413, "verse_number": "९-३१-७३", "content_sanskrit": "एवं तु विविधा वाचो जययुक्ताः पुनःपुनः।\nकीर्तयन्ति स्म ते वीरास्तत्रतत्र जनाधिप॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2067186, "chapter_id": 2413, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि ह्रदप्रवेशपर्वणि अष्टादशदिवसयुद्धे एकत्रिंशोऽध्यायः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}]