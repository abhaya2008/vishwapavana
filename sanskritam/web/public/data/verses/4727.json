[{"id": 2176026, "chapter_id": 4727, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2176027, "chapter_id": 4727, "verse_number": "१", "content_sanskrit": "कुरुक्षेत्रं ततो गत्वा दत्त्वा देयांश्च सात्वतः ।\nआश्रमं सुमहद् दिव्यमगमज्जनमेजय\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2176028, "chapter_id": 4727, "verse_number": "२", "content_sanskrit": "मधूकाम्रवनोपेतं प्लक्षन्यग्रोधसङ्कुलम् ।\nचिरबिल्वयुतं पुण्यं पनसार्जुनसङ्कुलम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2176029, "chapter_id": 4727, "verse_number": "३", "content_sanskrit": "तं दृष्ट्वा यादवश्रेष्ठः प्रवरं पुण्यलक्षणम् ।\nपप्रच्छ तानृषीन् सर्वान् कस्यायं ह्याश्रमो वरः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2176030, "chapter_id": 4727, "verse_number": "४", "content_sanskrit": "ते च सर्वे महात्मानमूचू राजन् हलायुधम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2176031, "chapter_id": 4727, "verse_number": "", "content_sanskrit": "ऋषयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2176032, "chapter_id": 4727, "verse_number": "५", "content_sanskrit": "शृणु विस्तरशो राम यस्यायं पूर्वमाश्रमः ।\nअत्र विष्णुः पुरा देवः तप्तवांस्तप उत्तमम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2176033, "chapter_id": 4727, "verse_number": "", "content_sanskrit": "अत्रास्य विधिवद् यज्ञाः सर्वे वृत्ताः पुरातनाः\t॥६।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2176034, "chapter_id": 4727, "verse_number": "७", "content_sanskrit": "अत्रैव ब्राह्मणी वृद्धा कौमारब्रह्मचारिणी ।\nयोगयुक्ता दिवं याता तपोयुक्ता विशाम्पते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2176035, "chapter_id": 4727, "verse_number": "८", "content_sanskrit": "बभूव श्रीमती राजन् शाण्डिल्यस्य महात्मनः ।\nसुता धृतव्रता साध्वी नियता ब्रह्मचारिणी\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2176036, "chapter_id": 4727, "verse_number": "९", "content_sanskrit": "साऽपि प्राप्य परं योगं गत्वा स्वर्गमनुत्तमम् ।\nभुक्त्वाऽऽश्रमेऽश्वमेधस्य फलं फलवतः शुभम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2176037, "chapter_id": 4727, "verse_number": "१०", "content_sanskrit": "गता स्वर्गं महाराज पूजिता च महात्मभिः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2176038, "chapter_id": 4727, "verse_number": "११", "content_sanskrit": "ऋषीणां वचनं श्रुत्वा जगामाश्रममुत्तमम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2176039, "chapter_id": 4727, "verse_number": "१२", "content_sanskrit": "अभिगम्याश्रमं पुण्यं स दृष्ट्वा यदुनन्दनः ।\nऋषींस्तानभिवाद्याथ पार्श्वे हिमवतोऽच्युतः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2176040, "chapter_id": 4727, "verse_number": "१३", "content_sanskrit": "सन्ध्याकर्माणि सर्वाणि निर्वर्त्यारुरुहेऽचलम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2176041, "chapter_id": 4727, "verse_number": "१४", "content_sanskrit": "नातिदूरं ततो गत्वा रामस्तालध्वजो बली ।\nपुण्ये तीर्थवरे स्नात्वा विस्मयं परमं गतः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2176042, "chapter_id": 4727, "verse_number": "१५", "content_sanskrit": "प्रभवं स सरस्वत्याः प्लक्षप्रस्रवणं बलः ।\nसम्प्राप्तः कारपचनं तीर्थप्रवरमुत्तमम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2176043, "chapter_id": 4727, "verse_number": "१६", "content_sanskrit": "हलायुधस्तु तत्रापि दत्त्वा दानं महाबलः ।\nआप्लुतः सलिले शीते तस्माच्चापि जगाम ह\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2176044, "chapter_id": 4727, "verse_number": "१७", "content_sanskrit": "आश्रमं परमप्रीतो मित्रस्य वरुणस्य च\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2176045, "chapter_id": 4727, "verse_number": "१८", "content_sanskrit": "इन्द्राग्नी अर्यमा चैव यत्र प्राक् प्रीतिमाप्नुवन् ।\nतं देशं कारपचनं स तस्मादाजगाम ह\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2176046, "chapter_id": 4727, "verse_number": "१९", "content_sanskrit": "स्नात्वा तत्रापि धर्मात्मा परां तुष्टिमवाप्य च ।\nऋषिभिश्चैव सिद्धैश्च सहितो वै महाबलः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2176047, "chapter_id": 4727, "verse_number": "२०", "content_sanskrit": "उपविष्टः कथाः शुभ्राः शुश्राव यदुनन्दनः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2176048, "chapter_id": 4727, "verse_number": "२१", "content_sanskrit": "तथा तु तिष्ठतां तेषां नारदो भगवान् ऋषिः ।\nआजगामाथ तं देशं यत्र रामो व्यवस्थितः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2176049, "chapter_id": 4727, "verse_number": "२२", "content_sanskrit": "जटामण्डलसंवीतः कुशचीरी महायशाः ।\nहेमदण्डधरो राजन् कमण्डलुधरस्तथा\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2176050, "chapter_id": 4727, "verse_number": "२३", "content_sanskrit": "कर्णपीयूषशब्दां तां गृह्य वीणां मनोरमाम् ।\nनृत्ये गीते च कुशलो देवब्राह्मणपूजकः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2176051, "chapter_id": 4727, "verse_number": "२४", "content_sanskrit": "प्रेरकः कलहानां च नित्यं च कलहप्रियः ।\nतं देशमगमच्छ्रीमान् यत्र रामो हलायुधः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2176052, "chapter_id": 4727, "verse_number": "२५", "content_sanskrit": "प्रत्युत्थाय तु तं रामः पूजयित्वा यतव्रतम् ।\nदेवर्षिं पर्यपृच्छत्तं यथावृत्तं कुरून् प्रति\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2176053, "chapter_id": 4727, "verse_number": "२६", "content_sanskrit": "तदाऽस्याकथयद् राजन् नारदः सर्ववेदवित् ।\nसर्वमेव यथातत्वमतीतं कुरुसङ्क्षयम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2176054, "chapter_id": 4727, "verse_number": "२७", "content_sanskrit": "ततोऽब्रवीद् रौहिणेयो नारदं दीनया गिरा\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2176055, "chapter_id": 4727, "verse_number": "", "content_sanskrit": "रामः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2176056, "chapter_id": 4727, "verse_number": "२८", "content_sanskrit": "किमवस्थं तु तत् क्षत्रं ये च तत्राभवन् नृपाः ।\nश्रुतमेतन्मया पूर्वं सर्वमेव तपोधन\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2176057, "chapter_id": 4727, "verse_number": "२९", "content_sanskrit": "विस्तरश्रवणे जातं कौतूहलमतीव मे\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2176058, "chapter_id": 4727, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2176059, "chapter_id": 4727, "verse_number": "३०", "content_sanskrit": "पूर्वमेव हतो भीष्मो द्रोणः सेनापतिस्तथा ।\nहतो वैकर्तनः कर्णः पुत्राश्चास्य महाबलाः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2176060, "chapter_id": 4727, "verse_number": "३१", "content_sanskrit": "भूरिश्रवा रौहिणेय मद्रराजश्च वीर्यवान् ।\nएते चान्ये च बहवो हतास्तत्र महाबलाः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2176061, "chapter_id": 4727, "verse_number": "३२", "content_sanskrit": "प्रियान् प्राणान् परित्यज्य प्रियार्थं कौरवस्य वै ।\nराजानो राजपुत्राश्च समरेष्वनिवर्तिनः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2176062, "chapter_id": 4727, "verse_number": "३३", "content_sanskrit": "अहतास्तु महाबाहो शृणु ये तत्र माधव\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2176063, "chapter_id": 4727, "verse_number": "३४", "content_sanskrit": "धार्तराष्ट्रे बले शेषाः कृपो भोजश्च वीर्यवान् ।\nअश्वत्थामा च विक्रान्तो भग्नसैन्या दिशो गताः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2176064, "chapter_id": 4727, "verse_number": "३५", "content_sanskrit": "दुर्योधनो हते सैन्ये विद्रुतेषु पदातिषु ।\nह्रदं द्वैपायनं नाम विवेश भृशदुःखितः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2176065, "chapter_id": 4727, "verse_number": "३६", "content_sanskrit": "शयानं धार्तराष्ट्रं तु स्तम्भिते सलिले तदा ।\nपाण्डवाः सह कृष्णेन वाग्भिरुग्राभिरार्दयन्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2176066, "chapter_id": 4727, "verse_number": "३७", "content_sanskrit": "स तुद्यमानो बलवान् वाग्भी राम समन्ततः ।\nउत्थितोऽभूद् ह्रदाद् वीरः प्रगृह्य महतीं गदाम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2176067, "chapter_id": 4727, "verse_number": "३८", "content_sanskrit": "स चाभ्युपागतो युद्धं भीमसेनेन साम्प्रतम् ।\nभविष्यति हि तयोरद्य युद्धं राम सुदारुणम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2176068, "chapter_id": 4727, "verse_number": "३९", "content_sanskrit": "यदि कौतूहलं तेऽस्ति व्रज माधव मा चिरम् ।\nपश्य युद्धं महाघोरं शिष्ययोर्यदि मन्यसे\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2176069, "chapter_id": 4727, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2176070, "chapter_id": 4727, "verse_number": "४०", "content_sanskrit": "स नारदवचः श्रुत्वा तानभ्यर्च्य द्विजर्षभान् ।\nसर्वान् विसर्जयामास ये तेनानुगताः सह\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2176071, "chapter_id": 4727, "verse_number": "४१", "content_sanskrit": "गम्यतां द्वारकां चेति सोऽन्वशादनुयायिनः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2176072, "chapter_id": 4727, "verse_number": "४२", "content_sanskrit": "सोऽवतीर्याचलश्रेष्ठात् प्लक्षप्रस्रवणात् ततः ।\nस तु प्रीतमना रामः श्रुत्वा तीर्थफलं महत्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2176073, "chapter_id": 4727, "verse_number": "४३", "content_sanskrit": "विप्राणामग्रतः श्लोकमगादयमितद्युतिः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2176074, "chapter_id": 4727, "verse_number": "४४", "content_sanskrit": "सरस्वतीवाससमा कुतो रतिः\nसरस्वतीवाससमाः कुतो गुणाः ।\nसरस्वतीहीनविदेशवासिनः\nसदा स्मरिष्यन्ति नदीं सरस्वतीम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2176075, "chapter_id": 4727, "verse_number": "४५", "content_sanskrit": "सरस्वती सर्वनदीषु पुण्या\nसरस्वती लोकसुखावहा च ।\nसरस्वतीं प्राप्य नराः सुदुष्कृताः\nसदा न शोचन्ति परत्र चेह (च)\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2176076, "chapter_id": 4727, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2176077, "chapter_id": 4727, "verse_number": "४६", "content_sanskrit": "ततो मुहुर्मुहुर्भक्त्या प्रेक्षमाणः सरस्वतीम् ।\nहयैर्युक्तं रथं शीघ्रमारुरोह परन्तपः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2176078, "chapter_id": 4727, "verse_number": "४७", "content_sanskrit": "स शीघ्रगामिना तेन रथेन यदुपुङ्गवः ।\nदिदृक्षुरभिसम्प्राप्तः शिष्ययुद्धमुपस्थितम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2176079, "chapter_id": 4727, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां गदापर्वणि सरस्वतीमाहात्म्यं नाम पञ्चविंशोऽध्यायः ॥२५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]