[{"id": 2002597, "chapter_id": 1057, "verse_number": "१-५८-०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2002598, "chapter_id": 1057, "verse_number": "१-५८-१", "content_sanskrit": "इदमत्यद्भुतं चान्यदास्तीकस्यानुशुश्रुम।\nतथा वरैश्छन्द्यमाने राज्ञा पारिक्षितेन हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2002599, "chapter_id": 1057, "verse_number": "१-५८-२", "content_sanskrit": "इन्द्रहस्ताच्च्युतो नागः ख एव यदतिष्ठत।\nततश्चिन्तापरो राजा बभूव जनमेजयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2002600, "chapter_id": 1057, "verse_number": "१-५८-३", "content_sanskrit": "हूयमाने भृशं दीप्ते विधिवद्वसुरेतसि।\nन स्म स प्रापतद्वह्नौ तक्षको भयपीडितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2002601, "chapter_id": 1057, "verse_number": "१-५८-४x", "content_sanskrit": "शौनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2002602, "chapter_id": 1057, "verse_number": "१-५८-४", "content_sanskrit": "किं सूत तेषां विप्राणां मन्त्रग्रामो मनीषिणाम्।\nन प्रत्यभात्तदाऽग्नौ यत्स पपात न तक्षकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2002603, "chapter_id": 1057, "verse_number": "१-५८-५x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2002604, "chapter_id": 1057, "verse_number": "१-५८-५", "content_sanskrit": "तमिन्द्रहस्ताद्वित्रस्तं विसंज्ञं पन्नगोत्तमम्।\nआस्तीकस्तिष्ठ तिष्ठेति वाचस्तिस्रोऽभ्युदैरयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2002605, "chapter_id": 1057, "verse_number": "१-५८-६", "content_sanskrit": "वितस्थे सोऽन्तरिक्षे च हृदयेन विदूयता।\nयथा तिष्ठति वै कश्चित्खं च गां चान्तरा नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2002606, "chapter_id": 1057, "verse_number": "१-५८-७", "content_sanskrit": "ततो राजाब्रवीद्वाक्यं सदस्यैश्चोदितो भृशम्।\nकाममेतद्भवत्वेवं यथास्तीकस्य भाषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2002607, "chapter_id": 1057, "verse_number": "१-५८-८", "content_sanskrit": "समाप्यतामिदं कर्म पन्नगाः सन्त्वनामयाः।\nप्रीयतामयमास्तीकः सत्यं सूतवचोऽस्तु तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2002608, "chapter_id": 1057, "verse_number": "१-५८-९", "content_sanskrit": "ततो हलहलाशब्दः प्रीतिजः समजायत।\nआस्तीकस्य वरे दत्ते तथैवोपरराम च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2002609, "chapter_id": 1057, "verse_number": "१-५८-१०", "content_sanskrit": "स यज्ञः पाण्डवेयस्य राज्ञः पारिक्षितस्य ह।\nप्रीतिमांश्चाभवद्राजा भारतो जनमेजयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2002610, "chapter_id": 1057, "verse_number": "१-५८-११", "content_sanskrit": "ऋत्विग्भ्यः ससदस्येभ्यो ये तत्रासन्समागताः।\nतेभ्यश्च प्रददौ वित्तं शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2002611, "chapter_id": 1057, "verse_number": "१-५८-१२", "content_sanskrit": "लोहिताक्षाय सूताय तथा स्थपतये विभुः।\nयेनोक्तं तस्य तत्राग्रे सर्पसत्रनिवर्तने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2002612, "chapter_id": 1057, "verse_number": "१-५८-१३", "content_sanskrit": "निमित्तं ब्राह्मण इति तस्मै वित्तं ददौ बहु।\nदत्त्वा द्रव्यं यथान्यायं भोजनाच्छादनान्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2002613, "chapter_id": 1057, "verse_number": "१-५८-१४", "content_sanskrit": "प्रीतस्तस्मै नरपतिरप्रमेयपराक्रमः।\nततश्चकारावभृथं विधिदृष्टेन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2002614, "chapter_id": 1057, "verse_number": "१-५८-१५", "content_sanskrit": "आस्तीकं प्रेषयामास गृहानेव सुसंस्कृतम्।\nराजा प्रीतमनाः प्रीतं कृतकृत्यं मनीषिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2002615, "chapter_id": 1057, "verse_number": "१-५८-१६", "content_sanskrit": "पुनरागमनं कार्यमिति चैनं वचोऽब्रवीत्।\nभविष्यसि सदस्यो मे वाजिमेधे महाक्रतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2002616, "chapter_id": 1057, "verse_number": "१-५८-१७", "content_sanskrit": "तथेत्युक्त्वा प्रदुद्राव तदास्तीको मुदा युतः।\nकृत्वा स्वकार्यमतुलं तोषयित्वा च पार्थिवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2002617, "chapter_id": 1057, "verse_number": "१-५८-१८", "content_sanskrit": "स गत्वा परमप्रीतो मातुलं मातरं च ताम्।\nअभिगम्योपसंगृह्य तथा वृत्तं न्यवेदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2002618, "chapter_id": 1057, "verse_number": "१-५८-१९x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2002619, "chapter_id": 1057, "verse_number": "१-५८-१९", "content_sanskrit": "एतच्छ्रुत्वा प्रीयमाणाः समेता\nये तत्रासन्पन्नगा वीतमोहाः।\nआस्तीके वै प्रीतिमन्तो बभूवु-\nरूचुश्चैनं वरमिष्टं वृमीष्व॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2002620, "chapter_id": 1057, "verse_number": "१-५८-२०", "content_sanskrit": "भूयोभूयः सर्वशस्तेऽब्रुवंस्तं\nकिं ते प्रियं करवामाद्य विद्वन्।\nप्रीता वयं मोक्षिताश्चैव सर्वे\nकामं किं ते करवामाद्य वत्स॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2002621, "chapter_id": 1057, "verse_number": "१-५८-२१x", "content_sanskrit": "आस्तीक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2002622, "chapter_id": 1057, "verse_number": "१-५८-२१", "content_sanskrit": "सायं प्रातर्ये प्रसन्नात्मरूपा\nलोके विप्रा मानवा ये परेऽपि।\nधर्माख्यानं ये पठेयुर्ममेदं\nतेषां युष्मन्नैव किंचिद्भयं स्यात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2002623, "chapter_id": 1057, "verse_number": "१-५८-२२", "content_sanskrit": "तैश्चाप्युक्तो भागिनेयः प्रसन्नै-\nरेतत्सत्यं काममेवं वरं ते।\nप्रीत्या युक्ताः कामितं सर्वशस्ते\nकर्तारः स्म प्रवणा भागिनेय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2002624, "chapter_id": 1057, "verse_number": "१-५८-२३", "content_sanskrit": "असितं चार्तिमन्तं च सुनीथं चापि यः स्मरेत्।\nदिवा वा यदि वा रात्रौ नास्य सर्पभयं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2002625, "chapter_id": 1057, "verse_number": "१-५८-२४", "content_sanskrit": "यो जरत्कारुणा जातो जरत्कारौ महावशाः।\nआस्तीकः सर्पसत्रे वः पन्नगान्योऽभ्यरक्षत।\nतं स्मरन्तं महाभागा न मां हिंसितुमर्हथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2002626, "chapter_id": 1057, "verse_number": "१-५८-२५", "content_sanskrit": "सर्पापसर्प भद्रं ते गच्छ सर्प महाविष।\nजनेमेजयस्य यज्ञान्ते आस्तीकवचनं स्मर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2002627, "chapter_id": 1057, "verse_number": "१-५८-२६", "content_sanskrit": "आस्तीकस्य वचः श्रुत्वा यः सर्पो न निवर्तते।\nशतधा भिद्यते मूर्धा शिंशवृक्षफलं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2002628, "chapter_id": 1057, "verse_number": "१-५८-२७x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2002629, "chapter_id": 1057, "verse_number": "१-५८-२७", "content_sanskrit": "स एवमुक्तस्तु तदा द्विजेन्द्रः\nसमागतैस्तैर्भुजगेन्द्रमुख्यैः।\nसंप्राप्य प्रीतिं विपुलां महात्मा\nततो मनो गमनायाथ दध्रे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2002630, "chapter_id": 1057, "verse_number": "१-५८-२८", "content_sanskrit": "इत्येवं नागराजोऽथ नागानां मध्यगस्तदा।\nउक्त्वा सहैव तैः सर्पैः स्वमेव भवनं ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2002631, "chapter_id": 1057, "verse_number": "१-५८-२९", "content_sanskrit": "मोक्षयित्वा तु भुजगान्सर्पसत्राद्द्विजोत्तमः।\nजगाम काले धर्मात्मा दिष्टान्तं पुत्रपौत्रवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2002632, "chapter_id": 1057, "verse_number": "१-५८-३०", "content_sanskrit": "इत्याख्यानं मयास्तीकं यथावत्तव कीर्तितम्।\nयत्कीर्तयित्वा सर्पेभ्यो न भयं विद्यते क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2002633, "chapter_id": 1057, "verse_number": "१-५८-३१x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2002634, "chapter_id": 1057, "verse_number": "१-५८-३१", "content_sanskrit": "यथा कथितवान्ब्रह्मन्प्रमतिः पूर्वजस्तव।\nपुत्राय रुरवे प्रीतः पृच्छते भार्गवोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2002635, "chapter_id": 1057, "verse_number": "१-५८-३२", "content_sanskrit": "यद्वाक्यं श्रुतवांश्चाहं तथा च कथितं मया।\nआस्तीकस्य कवेर्विप्र श्रीमच्चरितमादितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2002636, "chapter_id": 1057, "verse_number": "१-५८-३३", "content_sanskrit": "यन्मां त्वं पृष्टवान्ब्रह्मञ्श्रुत्वा डुण्डुभभाषितम्।\nव्येतु ते सुमहद्ब्रह्मन्कौतूहलमरिन्दम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2002637, "chapter_id": 1057, "verse_number": "१-५८-३४", "content_sanskrit": "श्रुत्वा धर्मिष्ठमाख्यानमास्तीकं पुण्यवर्धनम्।\nसर्वपापविनिर्मुक्तो दीर्घमायुरवाप्नुयात्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2002638, "chapter_id": 1057, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि अष्टपञ्चाशत्तमोऽध्यायः॥ ५८ ॥ ॥ समाप्तं चास्तीकपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]