[{"id": 2019812, "chapter_id": 1412, "verse_number": "३-५०-०x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2019813, "chapter_id": 1412, "verse_number": "३-५०-१", "content_sanskrit": "आसीद्राजा नलो नाम वीरसेनसुतो बली।\nउपपन्नो गुणैरिष्टै रूपवानश्वकोविदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2019814, "chapter_id": 1412, "verse_number": "३-५०-२", "content_sanskrit": "`यज्वा दानपतिर्दक्षः सदा शीलपुरस्कृतः।\nअतिष्ठन्मनुजेन्द्राणां मूर्ध्नि देवपतिर्यथा।\nउपर्युपरि सर्वेषामादित्य इव तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2019815, "chapter_id": 1412, "verse_number": "३-५०-३", "content_sanskrit": "ब्रह्मण्यो वेदविच्छ्ररो निषधेषु महीपतिः।\nअक्षप्रियः सत्यवादी महानक्षौहिणीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2019816, "chapter_id": 1412, "verse_number": "३-५०-४", "content_sanskrit": "ईप्सितो वरनारीणामुदारः संयतेन्द्रियः।\nरक्षिताधन्विनां श्रेष्ठः साक्षादिव मनुः स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2019817, "chapter_id": 1412, "verse_number": "३-५०-५", "content_sanskrit": "तथैवासीद्विदर्भेषु भीमो भीमपराक्रमः।\nशूरः सर्वगुणैर्युक्तः प्रजाकामः स चाप्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2019818, "chapter_id": 1412, "verse_number": "३-५०-६", "content_sanskrit": "स प्रजार्थे परं यत्नमकरोत्सुसमाहितः।\nतमभ्यगच्छद्ब्रह्मर्षिर्दमनो नाम भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2019819, "chapter_id": 1412, "verse_number": "३-५०-७", "content_sanskrit": "तं स भीमः प्रजाकामस्तोषयामास धर्मवित्।\nमहिष्या सह राजेनद्र सत्कारेण सुवर्चसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2019820, "chapter_id": 1412, "verse_number": "३-५०-८", "content_sanskrit": "तस्मै प्रसन्नो दमनः सभार्याय वरं ददौ।\nकन्यारत्नं कुमारांश्च त्रीनुदारान्महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2019821, "chapter_id": 1412, "verse_number": "३-५०-९", "content_sanskrit": "दमयन्तीं दमं दान्तं दमनं च सुवर्चसम्।\nउपपन्नान्गुणैः सर्वैर्भीमान्भीमपराक्रमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2019822, "chapter_id": 1412, "verse_number": "३-५०-१०", "content_sanskrit": "दमयन्ती तु रूपेण तेजसा वपुषा श्रिया।\nसौभाग्येन च लोकेषु यशः प्राप सुमध्यमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2019823, "chapter_id": 1412, "verse_number": "३-५०-११", "content_sanskrit": "अथ तां वसि प्राप्ते दासीनां समलंकृतम्।\nशतं सखीनां च तदा पर्युपास्ते शचीमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2019824, "chapter_id": 1412, "verse_number": "३-५०-१२", "content_sanskrit": "तत्र स्म राजते भैमी सर्वाभरणभूषिता।\nसखीमध्येऽनवद्याङ्गी विद्युत्सौदामनी यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2019825, "chapter_id": 1412, "verse_number": "३-५०-१३", "content_sanskrit": "अतीव रूपसंपन्ना श्रीरिवायतलोचना।\nन देवेषु न यक्षेषु तादृग्रूपवती क्वचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2019826, "chapter_id": 1412, "verse_number": "३-५०-१४", "content_sanskrit": "मानुषेष्वपि चान्येषु दृष्टपूर्वाऽथवा श्रुता।\nचित्तप्रमाथिनी बाला देवानामपि सुन्दरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2019827, "chapter_id": 1412, "verse_number": "३-५०-१५", "content_sanskrit": "नलश्च नरशार्दूलो रूपेणाप्रतिमो भुवि।\nकंदर्प इव रूपेण मूर्तिमानभवत्स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2019828, "chapter_id": 1412, "verse_number": "३-५०-१६", "content_sanskrit": "तस्याः समीपे तु नलं प्रशशंसुः कुतूहलात्।\nनैषधस्य समीपे तु दमयन्तीं पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2019829, "chapter_id": 1412, "verse_number": "३-५०-१७", "content_sanskrit": "तयोरदृष्टः कामोऽभूच्छृण्वतोः सततं गुणान्।\nअन्योन्यं प्रतिकौन्तेय स व्वर्धत हृच्छयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2019830, "chapter_id": 1412, "verse_number": "३-५०-१८", "content_sanskrit": "अशक्नवन्नलः कामं तदा धारयितुं हृदा।\nअन्तःपुरसमीपस्थे वन आस्ते रहोगतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2019831, "chapter_id": 1412, "verse_number": "३-५०-१९", "content_sanskrit": "स ददर्शै ततो हंसाञ्जातरूपपरिच्दान्।\nवने विचरतां तेषामेकं जग्राह पक्षिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2019832, "chapter_id": 1412, "verse_number": "३-५०-२०", "content_sanskrit": "ततो।डन्तरिक्षगो वाचं व्याजहार नलं तदा।\nहन्तव्योस्मि न तेराजन्करिष्यामि तवप्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2019833, "chapter_id": 1412, "verse_number": "३-५०-२१", "content_sanskrit": "दमयन्तीसकाशे त्वां कथयिष्यामि नैषध।\nयथा त्वदन्यं पुरुषं न सा मंस्यति कर्हिचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2019834, "chapter_id": 1412, "verse_number": "३-५०-२२", "content_sanskrit": "`तव चैव यथा भार्या भविष्यति तथाऽनघ।\nविधास्यामि नरव्याघ्र सोऽनुजानातु मां भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2019835, "chapter_id": 1412, "verse_number": "३-५०-२३", "content_sanskrit": "एवमुक्तस्ततो हंसमुत्ससर्ज महीपतिः।\nते तु हंसाः समुत्पत्य विदर्भानगमंस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2019836, "chapter_id": 1412, "verse_number": "३-५०-२४", "content_sanskrit": "विदर्भनगरीं गत्वा दमयन्त्यास्तदान्तिके।\nनिपेतुस्ते गरुत्मन्तः सा ददर्शाथ तान्खगान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2019837, "chapter_id": 1412, "verse_number": "३-५०-२५", "content_sanskrit": "सा तानद्भुतरूपान्वै दृष्ट्वा सखिगणावृता।\nहृष्टा ग्रहीतुं खगमांस्त्वरमाणोपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2019838, "chapter_id": 1412, "verse_number": "३-५०-२६", "content_sanskrit": "अथ हंसा विससृपुः सर्वतः प्रमदावने।\nएकैकशस्तदा कन्यास्तान्हंसान्समुपाद्रवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2019839, "chapter_id": 1412, "verse_number": "३-५०-२७", "content_sanskrit": "दमयन्ती तु यं हंसं समुपाधावदन्तिके।\nस मानुषीं गिरं कृत्वा दमयन्तीमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2019840, "chapter_id": 1412, "verse_number": "३-५०-२८", "content_sanskrit": "दमयन्ति नलो नाम निषधेषु महीपतिः।\nअश्विनोः सदृशो रूपे न समास्तस्य मानुषाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2019841, "chapter_id": 1412, "verse_number": "३-५०-२९", "content_sanskrit": "[कन्दर्प इव रूपेण मूर्तिमानभवत्स्वयम्।]\nतस्य वै यदिभार्या त्वं भवेथा वरवर्णिनि।\nसफलंते भवेज्जन्म रूपं चेदं सुमध्यमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2019842, "chapter_id": 1412, "verse_number": "३-५०-३०", "content_sanskrit": "वयं हि देवगन्धर्वमनुष्योरगराक्षसान्।\nदृष्टवन्तो न चास्माभिर्दृष्टपूर्वस्तथाविधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2019843, "chapter_id": 1412, "verse_number": "३-५०-३१", "content_sanskrit": "त्वं चापि रत्नं नारीणां नरेषु च नलो वरः।\nविशिष्टाया विशिष्टेन संगमो गुणवान्भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2019844, "chapter_id": 1412, "verse_number": "३-५०-३२", "content_sanskrit": "एवमुक्ता तु हंसेन दमयन्ती विशांपते।\nअब्रवीत्तत्र तं हंसं त्वमप्येवं नलं वद ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2019845, "chapter_id": 1412, "verse_number": "३-५०-३३", "content_sanskrit": "तथेत्युक्त्वाऽण्डजः कन्यां विदर्भस्य विशांपते।\nपुनरागम्य निषधान्नले सर्वं न्यवेदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2019846, "chapter_id": 1412, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि नलोपाख्यानपर्वणि पञ्चाशोऽध्यायः ॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]