[{"id": 2128228, "chapter_id": 3748, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2128229, "chapter_id": 3748, "verse_number": "१", "content_sanskrit": "ते तथा सहिता वीरा वसन्तस्तत्रतत्र ह ।\nक्रमेण पृथिवीपाल नैमिशारण्यमागताः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2128230, "chapter_id": 3748, "verse_number": "२", "content_sanskrit": "ततस्तीर्थेषु पुण्येषु गोमत्यां पाण्डवा नृप ।\nकृताभिषेकाः प्रददुर्गाश्च वित्तं च भारत\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2128231, "chapter_id": 3748, "verse_number": "३", "content_sanskrit": "तत्र देवान् पितॄन् विप्रान् तर्पयित्वा पुनः पुनः ।\nकन्यातीर्थेऽश्वतीर्थे च गवां तीर्थे च कौरवाः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2128232, "chapter_id": 3748, "verse_number": "४", "content_sanskrit": "पालकोट्यां वृषप्रस्थे गिरावुष्य च पाण्डवाः ।\nबाहुदायां महीपाल चक्रुः सर्वेऽभिषेचनम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2128233, "chapter_id": 3748, "verse_number": "५", "content_sanskrit": "प्रयागे देवयजने देवानां पृथिवीपते ।\nऊषुराप्लाव्य गात्राणि तपश्चातस्थुरुत्तमम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2128234, "chapter_id": 3748, "verse_number": "६", "content_sanskrit": "गङ्गायमुनयोश्चापि सङ्गमे सत्यसङ्गराः ।\nविपाप्मानो महात्मानो विप्रेभ्यः प्रददुर्वसु\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2128235, "chapter_id": 3748, "verse_number": "७", "content_sanskrit": "तपस्विजनजुष्टां च ततो वेदीं प्रजापतेः ।\nजग्मुः पाण्डुसुता राजन् ब्राह्मणैः सह भारत\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2128236, "chapter_id": 3748, "verse_number": "८", "content_sanskrit": "तत्र ते न्यवसन् वीराः तपश्चातस्थुरुत्तमम् ।\nसन्तर्पयन्तः सततं वन्येन हविषा द्विजान्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2128237, "chapter_id": 3748, "verse_number": "९", "content_sanskrit": "ततो महीधरं जग्मुर्धर्मज्ञेनाभिसत्कृतम् ।\nराजर्षिणा पुण्यकृता गयेनानुपमद्युता\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2128238, "chapter_id": 3748, "verse_number": "१०", "content_sanskrit": "सरो गयशिरो यत्र पुण्या चैव महानदी ।\nऋषिजुष्टं सुपुण्यं तत् तीर्थं ब्रह्मसरोऽतुलम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2128239, "chapter_id": 3748, "verse_number": "११", "content_sanskrit": "अगस्त्यो भगवान् यत्र गतो वैवस्वतं प्रति ।\nउवास च स्वयं यत्र धर्मराजः सनातनः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2128240, "chapter_id": 3748, "verse_number": "१२", "content_sanskrit": "सर्वासां सरितां चैव समुद्भेदो विशांपते ।\nयत्र सन्निहितो नित्यं महादेवः पिनाकधृक्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2128241, "chapter_id": 3748, "verse_number": "१३", "content_sanskrit": "तत्र ते पाण्डवा राजन् चातुर्मास्यैस्तदेजिरे ।\nऋषियज्ञेन महता तत्राक्षयवटो महान्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2128242, "chapter_id": 3748, "verse_number": "१४", "content_sanskrit": "ब्राह्मणास्तत्र शतशः समाजग्मुस्तपोधनाः ।\nवर्तमानेषु वै तस्य चातुर्मास्येषु भारत\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2128243, "chapter_id": 3748, "verse_number": "१५", "content_sanskrit": "तत्र विद्यातपोवृद्धा ब्राह्मणा वेदपारगाः ।\nकथाः प्रचक्रिरे पुण्याः सदसिस्था महात्मनाम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2128244, "chapter_id": 3748, "verse_number": "१६", "content_sanskrit": "तत्र विद्याव्रतस्नातः कौमारं व्रतमास्थितः ।\nशमठोऽकथयद् राजन्नाधूर्तरजसं गयम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2128245, "chapter_id": 3748, "verse_number": "", "content_sanskrit": "शमठः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2128246, "chapter_id": 3748, "verse_number": "१७", "content_sanskrit": "आधूर्तरजसः पुत्रो गयो राजर्षिसत्तमः ।\nपुण्यानि तस्य कर्माणि तानि मे शृणु भारत\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2128247, "chapter_id": 3748, "verse_number": "१८", "content_sanskrit": "यस्य यज्ञो बभूवेह बह्वन्नो बहुदक्षिणः ।\nयत्रान्नपर्वता राजन्नासन् शतसहस्रशः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2128248, "chapter_id": 3748, "verse_number": "१९", "content_sanskrit": "घृतकुल्याश्च दध्नश्च नद्यो बहुशतास्तथा ।\nव्यञ्जनानां प्रवाहाश्च महार्हाणां सहस्रशः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2128249, "chapter_id": 3748, "verse_number": "२०", "content_sanskrit": "अहन्यहनि चाप्येतद् याचतां सम्प्रदीयते ।\nअन्यत्तु ब्राह्मणा राजन् भुञ्जतेऽन्नं सुसंस्कृतम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2128250, "chapter_id": 3748, "verse_number": "२१", "content_sanskrit": "तत्र वै दक्षिणाकाले ब्रह्मघोषा दिवं गताः ।\nन च प्रज्ञायते किञ्चिद् ब्रह्मघोषेण भारत\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2128251, "chapter_id": 3748, "verse_number": "२२", "content_sanskrit": "पुण्येनोच्चरिता राजन् भूर्दिशः खं तथा नृप ।\nआपूर्णमासीच्छब्देन तदप्यासीन्महाद्भुतम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2128252, "chapter_id": 3748, "verse_number": "२३", "content_sanskrit": "तत्र स्म गाथां गायन्ति मनुष्या भरतर्षभ ।\nअन्नपानगुणैस्तृप्ता देशे देशे सुवर्चसः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2128253, "chapter_id": 3748, "verse_number": "२४", "content_sanskrit": "गयस्य यज्ञे के त्वद्य प्राणिनोऽभोक्तुमीप्सवः ।\nयत्र भोजनशेषस्य पर्वताः पञ्चविंशतिः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2128254, "chapter_id": 3748, "verse_number": "२५", "content_sanskrit": "न स्म पूर्वे जनाश्चक्रुर्न करिष्यन्ति चापरे ।\nगयो यदकरोद् यज्ञे राजर्षिरमितद्युतिः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2128255, "chapter_id": 3748, "verse_number": "२६", "content_sanskrit": "कथं नु देवा हविषा गयेन परितर्पिताः ।\nपुनः शक्ष्यन्त्युपादातुमन्यैर्दत्तानि कानिचित्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2128256, "chapter_id": 3748, "verse_number": "२७", "content_sanskrit": "एवंविधाः सुबहवः तस्य यज्ञा महात्मनः ।\nबभूवुरस्य सरसः समीपे कुरुनन्दन\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2128257, "chapter_id": 3748, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि नवतितमोऽध्यायः ॥९०॥ ॥ तीर्थयात्रापर्वणि षट्चत्वारिंशोऽध्यायः ॥४६॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]