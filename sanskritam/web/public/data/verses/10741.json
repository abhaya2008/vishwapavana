[{"id": 50003951, "chapter_id": 10741, "verse_number": "1", "content_sanskrit": "श्रीभगवानुवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50003952, "chapter_id": 10741, "verse_number": "2", "content_sanskrit": "अशोच्यानन्वशोचस्त्वं प्रज्ञावादांश्च भाषसे। गतासूनगतासूंश्च नानुशोचन्ति पण्डिताः॥ २/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50003953, "chapter_id": 10741, "verse_number": "3", "content_sanskrit": "नत्वेवाहं जातु नासं न त्वं नेमे जनाधिपाः। नचैव न भविष्यामः सर्वे वयमतः परम्॥ २/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50003954, "chapter_id": 10741, "verse_number": "4", "content_sanskrit": "देहिनोऽस्मिन् यथा देहे कौमारं यौवनं जरा। तथा देहान्तरप्राप्तिर्धीरस्तत्र न मुह्यति॥ २/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]