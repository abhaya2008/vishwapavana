[{"id": 7000973000, "chapter_id": 20973, "verse_number": "२-१३-१", "content_sanskrit": "श्रीमैत्रेय उवाच ।\nभगवन्! सम्यगाख्यातं यत् पृष्टोऽसि मयाखलम् ।\nभूसमुद्रादिसरितां संस्थानं ग्रहसंस्थितिम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000973001, "chapter_id": 20973, "verse_number": "२-१३-२", "content_sanskrit": "विष्णवाधारं तथा चैतत् त्रैलोक्यं समवस्थितम् ।\nपरमार्थस्तु तेनोक्तो यथाज्ञानं प्रधानतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000973002, "chapter_id": 20973, "verse_number": "२-१३-३", "content_sanskrit": "यत्त्वोतद्भगवानाह भरतस्य महीपतेः ।\nकथयिष्यामि चरितं तन्माख्यातुमर्हसि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000973003, "chapter_id": 20973, "verse_number": "२-१३-४", "content_sanskrit": "भरतः स महीपालः शालग्रामेऽवसत् किल ।\nयोगयुक्तः समाधाय वासुदेवे सदा मनः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000973004, "chapter_id": 20973, "verse_number": "२-१३-५", "content_sanskrit": "पुण्यदेशप्रभावेण ध्यायतश्व सदा हरिम् ।\nकथन्तु नाभवन्मुक्तिर्यदभूत् स द्रिजः पुनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000973005, "chapter_id": 20973, "verse_number": "२-१३-६", "content_sanskrit": "विप्रत्वे च कृतं तेन यद्भूयःसुमहात्मना ।\nभरतेन मुनिश्वेष्ठ! तत् सर्व्वं वक्तुमर्हसि ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000973006, "chapter_id": 20973, "verse_number": "२-१३-७", "content_sanskrit": "पराशार अवाच ।\nशालग्रामे महाभागो भगवन्नयस्तमानसः ।\nस उवास चिरं कालं मैत्रेय! पृथिवीपतिः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000973007, "chapter_id": 20973, "verse_number": "२-१३-८", "content_sanskrit": "अहिंसादिष्वशेषेषु गुणेषु गुणिनां वरः ।\nअवाप परमां काष्ठां मनसश्चापि संयमे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000973008, "chapter_id": 20973, "verse_number": "२-१३-९", "content_sanskrit": "यज्ञेशाच्युत गोविन्द माधवानन्त केशव! ।\nकृष्णा विष्णो ह्टषीकेशेत्याह राजा स केवलम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000973009, "chapter_id": 20973, "verse_number": "२-१३-१०", "content_sanskrit": "नान्यज्जागाद मैत्रेय! किञ्चित् स्वप्नान्तरेऽपि च ।\nएततूपरं तदर्थञ्च विना नान्यदचिन्तयत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000973010, "chapter_id": 20973, "verse_number": "२-१३-११", "content_sanskrit": "समित्-पुष्प-कुशादानं चक्र देवक्रियाकृते ।\nनान्यानि चक्र कर्म्माणि निः सङ्गो योगतापसः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000973011, "chapter_id": 20973, "verse_number": "२-१३-१२", "content_sanskrit": "जगाम सोऽबिषेकार्थमेकदा तु महानदीम् ।\nसस्नौ तत्र तदा चक्र स्नानस्यनन्तरक्रियाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000973012, "chapter_id": 20973, "verse_number": "२-१३-१३", "content_sanskrit": "अथातजगाम तत्तीर्थं जलं पात् पिपासिता ।\nआसन्नप्रसवा ब्रह्मन्नेकैव हरिणी वनात् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000973013, "chapter_id": 20973, "verse_number": "२-१३-१४", "content_sanskrit": "ततः समभवत्तत्र पीतप्राय जले तया ।\nसिंहस्य नादः सुमहान् सर्व्वप्राणिभयङ्करः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000973014, "chapter_id": 20973, "verse_number": "२-१३-१५", "content_sanskrit": "ततः सा सहसा त्रासादाप्लुता निम्नगातटम् ।\nअत्युज्वारोहणेनास्या नद्यां गर्भः पपात सः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000973015, "chapter_id": 20973, "verse_number": "२-१३-१६", "content_sanskrit": "तमुह्ममानं वेगेन वीचिमालापरिप्लुतम् ।\nतजग्राह स नृपो गर्भात् पतितं मृगपोतकम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000973016, "chapter_id": 20973, "verse_number": "२-१३-१७", "content_sanskrit": "गर्भप्रव्युतिदोषेण प्रोत्तुङ्गाक्रमणोन च ।\nमैत्रेय! सापि हरिणी पपात च ममार च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000973017, "chapter_id": 20973, "verse_number": "२-१३-१८", "content_sanskrit": "हरिणीं तां विलोक्याथ विपन्नां नृपतापसः ।\nमृगपोतं समादाय निजमाश्वममागतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000973018, "chapter_id": 20973, "verse_number": "२-१३-१९", "content_sanskrit": "चकारानुदिनञ्चासौ मृगपोतस्यवै नृपः ।\nपोषण पुष्यमाणश्य स तेन वबृधे मुने ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000973019, "chapter_id": 20973, "verse_number": "२-१३-२०", "content_sanskrit": "चचाराश्रमपर्य्यन्तं तृणानि गहनेषु सः ।\nदूरं गत्वा च शाद्दूलत्रासादभ्याययौ पुनः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000973020, "chapter_id": 20973, "verse_number": "२-१३-२१", "content_sanskrit": "प्रातर्गत्वातिदूरञ्च सायमायाद यथाश्वमम् ।\nपुनश्च भरतस्याभूदाश्वमस्योटजाजिरे ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000973021, "chapter_id": 20973, "verse_number": "२-१३-२२", "content_sanskrit": "तस्य तस्मिन्मृगे दूर-समीपपरिवर्त्तिनि ।\nआसीच्चेतः समायुक्तं न ययावन्यतो द्रिज ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000973022, "chapter_id": 20973, "verse_number": "२-१३-२३", "content_sanskrit": "विमुक्तराज्यतनयः प्रोज्झिताशेषबान्धवः ।\nममत्वं स चकारोच्चैस्तस्मिन् हरिणबालके ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000973023, "chapter_id": 20973, "verse_number": "२-१३-२४", "content_sanskrit": "किं वृकैक्भक्षितो व्याघूः किं सिंहेन निपातितः ।\nचिरायमाणे निष्कान्ते तस्यासीदिति मानसम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000973024, "chapter_id": 20973, "verse_number": "२-१३-२५", "content_sanskrit": "एषा वसुमती तस्य खुराग्रक्षतकर्बुरा ।\nप्रीतये मम जातोऽसौ क्व ममैणकबालकः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000973025, "chapter_id": 20973, "verse_number": "२-१३-२६", "content_sanskrit": "विषाणाग्रण मदूबाहुकण्डूयनपरो हि सः ।\nक्षेमेणाभ्यागतोऽरण्यादिपि मां सुखयिष्यति ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000973026, "chapter_id": 20973, "verse_number": "२-१३-२७", "content_sanskrit": "एते लूनशिखास्तस्य दशनैरचिरोदूगतैः ।\nकुशाः कासा विराजन्ते वटवः सामगा इव ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000973027, "chapter_id": 20973, "verse_number": "२-१३-२८", "content_sanskrit": "इत्थं चिरगते तस्मिन् स चक्र मानसं मुनिः ।\nप्रीतिप्रसन्नवदनः पार्श्वस्थे चाभवन्मृगे ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000973028, "chapter_id": 20973, "verse_number": "२-१३-२९", "content_sanskrit": "समाधिभङ्गस्तासीत् तन्ममत्वादृतात्मनः ।\nसन्त्यक्तराज्यभोगर्द्धिखजनस्यापि भूपतेः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000973029, "chapter_id": 20973, "verse_number": "२-१३-३०", "content_sanskrit": "चपलं चपले तस्मिन् दूरगं दूरगामिनि ।\nमृगपतोऽभवज्वित्तं स्थैर्य्यवत्तस्य भूपतेः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000973030, "chapter_id": 20973, "verse_number": "२-१३-३१", "content_sanskrit": "कालेन गच्छता सोऽथ कालञ्चक्र महीपतिः ।\nपितेव सास्त्रं पुत्रेण मृगपोतेन वीक्षितः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000973031, "chapter_id": 20973, "verse_number": "२-१३-३२", "content_sanskrit": "मृगमेव तदाद्राक्षीत् त्यजन् प्राणानसावपि ।\nतन्मयत्वेन मैत्रय! नान्यत् किञ्चिदचिन्तयत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000973032, "chapter_id": 20973, "verse_number": "२-१३-३३", "content_sanskrit": "ततश्व तत्कालकृतां भावनां प्राप्य तादृशीम् ।\nजम्बूमार्गे महारण्ये जातो जातिस्मरो मृगः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000973033, "chapter_id": 20973, "verse_number": "२-१३-३४", "content_sanskrit": "जातिस्मरत्वादुद्रिग्नः संसारस्य द्रिजोत्तम! ।\nविहाय मातरं भूयः शालग्राममुपाययौ ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000973034, "chapter_id": 20973, "verse_number": "२-१३-३५", "content_sanskrit": "शुष्कैस्तृणैस्तथा पर्णौः स कुर्व्वन्नात्मपोषणम् ।\nमृगत्वहतुभूतस्य कर्म्मणो निष्कृतिं ययौ ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000973035, "chapter_id": 20973, "verse_number": "२-१३-३६", "content_sanskrit": "तत्र चोतसृष्टदेहोऽसौ जज्ञ जातिस्मरो द्रिजः ।\nसदाचारवतां शुद्ध योगिनां प्रवरे कुले ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000973036, "chapter_id": 20973, "verse_number": "२-१३-३७", "content_sanskrit": "अर्व्वविज्ञानसम्पन्नः सर्व्वशास्त्रार्थतत्त्ववित् ।\nअपश्यत् स च मैत्रेय! आत्मानं प्रकृतेः परम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000973037, "chapter_id": 20973, "verse_number": "२-१३-३८", "content_sanskrit": "आत्मनोऽधिगतज्ञानो देवादीनि महामुने ।\nसर्व्वभूतान्यभेदेन स ददर्श महामतिः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000973038, "chapter_id": 20973, "verse_number": "२-१३-३९", "content_sanskrit": "न पपाठ गुरुप्रोक्तं कृतोपनयनः श्वुतिम् ।\nन ददर्श च कर्माणि शास्त्रणि जगृहे न च ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000973039, "chapter_id": 20973, "verse_number": "२-१३-४०", "content_sanskrit": "उक्तोऽपि बहुशः किञ्चिड़वाक्यमभाषत ।\nतदप्यसंस्कारगुणां ग्राम्यवाक्योक्तिसंश्रितम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000973040, "chapter_id": 20973, "verse_number": "२-१३-४१", "content_sanskrit": "अपध्वस्तवपुः सोऽपि मलिनाम्बरधृग् द्रिजः ।\nक्लिन्नदन्तान्तरः सर्वैः परिभूतः स नागरैः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000973041, "chapter_id": 20973, "verse_number": "२-१३-४२", "content_sanskrit": "सम्मानना परां हानिं योगर्द्धेः कुरुते यतः ।\nजनेनावमतो योगी योगसिद्धिञ्च विन्दति ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000973042, "chapter_id": 20973, "verse_number": "२-१३-४३", "content_sanskrit": "तस्माज्वरेत वै योगी सतां मार्गमदूषयन् ।\nजना यथावमन्येरन् गच्छयुर्नैव सङ्गतिम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000973043, "chapter_id": 20973, "verse_number": "२-१३-४४", "content_sanskrit": "हिरण्यगर्भवचनं विचिन्त्येत्थं महामतिः ।\nआत्मानं दर्शयामास जडोन्मत्ताकृतिं जने ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000973044, "chapter_id": 20973, "verse_number": "२-१३-४५", "content_sanskrit": "भुहूक्ते कुलम्षव्रीह्मादिशाकं वन्यं फलं कणान् ।\nयदू यदाप्रोति सुबहु तदत्ते कालसंयमम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000973045, "chapter_id": 20973, "verse_number": "२-१३-४६", "content_sanskrit": "पितर्युपरते सोऽथ भ्रातृ-भ्रातृव्य-बान्धवैः ।\nकारितः क्षेत्रकर्मादि कदन्नाहारपोषितः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000973046, "chapter_id": 20973, "verse_number": "२-१३-४७", "content_sanskrit": "स तूक्षपीनावयवो जद़कारी च कर्मणि ।\nसर्वलोकोपकरणां बभूवाहारवेतनः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000973047, "chapter_id": 20973, "verse_number": "२-१३-४८", "content_sanskrit": "तं तादृशमसंस्कारं विप्राकृविचेष्टितम् ।\nक्षत्ता पृषतराजस्य काल्यै पशुमकल्पयत् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000973048, "chapter_id": 20973, "verse_number": "२-१३-४९", "content_sanskrit": "रात्रौ तं समलङकृत्य वैशसस्य विधानतः ।\nअधिष्ठितं महाकाली ज्ञात्वा योगेश्वरं तथा ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000973049, "chapter_id": 20973, "verse_number": "२-१३-५०", "content_sanskrit": "ततः खड गं समादाय निशितं निशि सा तथा ।\nक्षत्तार क्रूरकर्माणमच्छिनत् कण्ठमूलतः ।\nस्वपार्षदयुता देवी पपौ रुधिरमुल्वणम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000973050, "chapter_id": 20973, "verse_number": "२-१३-५१", "content_sanskrit": "ततः सौवीरराजस्य प्रयातस्य महात्मनः ।\nविष्टिकर्ताथ मन्येत विष्टियोग्योऽयमित्यपि ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000973051, "chapter_id": 20973, "verse_number": "२-१३-५२", "content_sanskrit": "तं तादृशमसंस्कारं विप्राकृतिविचेष्टितम् ।\nक्षत्ता सौवीरराजस्य विष्टियोग्यममन्यत ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000973052, "chapter_id": 20973, "verse_number": "२-१३-५३", "content_sanskrit": "स राजा शिविकारूढो गन्तूं कृतमतिर्द्रिज! ।\nबभूवेक्षुमतीतीरे कपिलर्षेर्वराश्रमम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000973053, "chapter_id": 20973, "verse_number": "२-१३-५४", "content_sanskrit": "श्रेयः किमत्र संसारे दुः खप्राये नृणामिति ।\nप्रष्टुं तं मोक्षधर्मज्ञ कपिलाख्यं महामुनिम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000973054, "chapter_id": 20973, "verse_number": "२-१३-५५", "content_sanskrit": "उवाह शिविकां तस्य क्षत्तुर्वचनचोदितः ।\nनृणां विष्टिगृहीतानामन्येषां सोऽपि मध्यगः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000973055, "chapter_id": 20973, "verse_number": "२-१३-५६", "content_sanskrit": "गृहीतो विष्टिना विप्रः सर्वज्ञानैकभाजनम् ।\nजातिस्मणेऽसौ पापस्य क्षयकाम उवाह ताम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000973056, "chapter_id": 20973, "verse_number": "२-१३-५७", "content_sanskrit": "ययौ जड़गतिः सोऽथ युगमात्रवलोकनः ।\nकुर्वन् मतिमतां श्रेष्ठस्तदन्ये त्वरितं ययुः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000973057, "chapter_id": 20973, "verse_number": "२-१३-५८", "content_sanskrit": "विलोक्य नृपतिः सोऽथ विषमां शिबिकागतिम् ।\nकिमेतदित्याह समं गम्यतां शिबिकावहाः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000973058, "chapter_id": 20973, "verse_number": "२-१३-५९", "content_sanskrit": "पुनस्तथैव शिबिकां विलोक्य विषमां हि सः ।\nनृपः किमेतदित्याह भवद भिर्गम्यतेऽन्यथा ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000973059, "chapter_id": 20973, "verse_number": "२-१३-६०", "content_sanskrit": "भूपतेर्वदतस्तस्य श्रुत्वेत्थं बहुशो वचः ।\nशिबिकावाहकाः प्रोचुरयं यातीत्यसत्वरम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000973060, "chapter_id": 20973, "verse_number": "२-१३-६१", "content_sanskrit": "किं श्रान्तोऽस्यल्पमद्वानं त्वयोढा शिहिका मम ।\nकिमायाससहो न त्वं पीनानसि निरीक्ष्यसे ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000973061, "chapter_id": 20973, "verse_number": "२-१३-६२", "content_sanskrit": "नाहं पीवान्न चैवोढा शिबिका भवतो मया ।\nन श्रान्तोऽस्मि न चायासः सोञव्योऽस्ति महीपते ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000973062, "chapter_id": 20973, "verse_number": "२-१३-६३", "content_sanskrit": "प्रत्यक्षं दृश्यसे पीवानद्यांपि शिबिका त्वयि ।\nश्रमश्व भारोदूहने भवत्येव हि देहिनाम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000973063, "chapter_id": 20973, "verse_number": "२-१३-६४", "content_sanskrit": "प्रत्यक्ष भवता भूप! यदू दृष्ट मम तदूद ।\nबलवानबलश्चेति वाच्यं पश्वादू विशेषणम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000973064, "chapter_id": 20973, "verse_number": "२-१३-६५", "content_sanskrit": "त्वयोढ़ा शिबिका चेति त्वय्यद्यापि च संस्थिता ।\nमिथ्यैतदत्र तु भवाञ्छृणोतु वचनं मम ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000973065, "chapter_id": 20973, "verse_number": "२-१३-६६", "content_sanskrit": "भूमौ पादयुगस्यास्था जह्घ पाददूये स्थिते ।\nऊरू जङ्घादूयावस्थौ तदाधारं तथोदरम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000973066, "chapter_id": 20973, "verse_number": "२-१३-६७", "content_sanskrit": "वक्षः स्थलं तथा बाहू स्कन्धौ चोदरसंस्थितौ ।\nस्कन्धाश्रितेयं शिबिका मम भारोऽत्र किकृतः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000973067, "chapter_id": 20973, "verse_number": "२-१३-६८", "content_sanskrit": "शिबिकायां स्थितं चेदं वपुस्त्वदुपलक्षितम् ।\nतत्र त्वमहमप्यत्र प्रोच्यते चेदमन्यथा ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000973068, "chapter_id": 20973, "verse_number": "२-१३-६९", "content_sanskrit": "अहं त्वञ्च तथान्ये च भूतैरुह्माम पार्थिव ।\nगुणप्रवाहपतितो भूतवर्गोऽपि यात्ययम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000973069, "chapter_id": 20973, "verse_number": "२-१३-७०", "content_sanskrit": "कर्मवश्या गुणाश्चैते सत्त्वाद्या- पृथिवीपते! ।\nअविद्यासञ्चितं कर्म्म तज्वाशेषेषु जन्तुषु ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000973070, "chapter_id": 20973, "verse_number": "२-१३-७१", "content_sanskrit": "आत्मा शुद्धोऽक्षरः शान्तो निर्गुणः प्रकृतेः परः ।\nप्रवृद्धयपचयौ नास्य एकस्याखिलजन्तुषु ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000973071, "chapter_id": 20973, "verse_number": "२-१३-७२", "content_sanskrit": "यदा नोपचयस्तस्य न चैवापचये नृप! ।\nतदा पीवानसीतीत्थं कया युत्तया त्वयेरितम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000973072, "chapter_id": 20973, "verse_number": "२-१३-७३", "content_sanskrit": "भू-पाद-जङ्घा-क्ठ्यूरु-जठरादिषु संस्थिते ।\nशिबिकेयं यता स्कन्धे तथा भारः समस्त्वया ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000973073, "chapter_id": 20973, "verse_number": "२-१३-७४", "content_sanskrit": "तदान्यैर्जन्तुभर्भूप! शिबिकोढा न केवलम् ।\nलै-द्रुम-गृहोत्थोऽपि पृथिवीसम्भवोऽपि वा ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000973074, "chapter_id": 20973, "verse_number": "२-१३-७५", "content_sanskrit": "यदा पुसः पृथग्भावः प्राकृतैः कारणौर्नृप! ।\nसोढव्यस्तु तदायासः कथं वा नृपते । मया ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000973075, "chapter_id": 20973, "verse_number": "२-१३-७६", "content_sanskrit": "यदूद्रव्या शिबिका चेयं तदूद्रव्यो भूतसंग्रहः ।\nभवतो मेऽखिलस्यास्य ममत्वेनोपबृ हितः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000973076, "chapter_id": 20973, "verse_number": "२-१३-७७", "content_sanskrit": "एवमुक्त्वाभवन्मैनी स वहञ्छिबिकां द्रिज! ।\nसोऽपि राजावतीर्य्योर्व्यं तत्पादौ जगृहे त्वरन् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000973077, "chapter_id": 20973, "verse_number": "२-१३-७८", "content_sanskrit": "कथ्यतां को भवानत्र जालमरूपधरः स्थितः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000973078, "chapter_id": 20973, "verse_number": "२-१३-७९", "content_sanskrit": "यो भवान् यन्निमित्तं वा यदागमनकारण्म् ।\nतत्सर्वं कथ्यतां विदून्! मह्म शुश्रूषवे त्वया ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000973079, "chapter_id": 20973, "verse_number": "२-१३-८०", "content_sanskrit": "श्रूयतां कोऽहमित्येतदूक्तुं भूप! न शक्यते ।\nउपभोगनिमित्तञ्च सर्वत्र गमनक्रिया ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000973080, "chapter_id": 20973, "verse_number": "२-१३-८१", "content_sanskrit": "सुखदुः खोपभोगौ तु तौ देहाद्यु पपादकौ ।\nधर्माधर्मोद्भवौ भोक्तु जन्तुर्देहादिमृच्छति ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000973081, "chapter_id": 20973, "verse_number": "२-१३-८२", "content_sanskrit": "सर्वस्यैव हि बूपाल! जन्तोः सर्वत्र कारणम् ।\nधर्माधर्मौ यतः कस्मात् कारणां पृच्छयते त्वया ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000973082, "chapter_id": 20973, "verse_number": "२-१३-८३", "content_sanskrit": "धर्माधमां न सन्देहः सर्वकार्य्येषु कारणम् ।\nउपभोगनिमित्तञ्च देहाद्द हान्तरागमः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000973083, "chapter_id": 20973, "verse_number": "२-१३-८४", "content_sanskrit": "यत्त्वैतद भवता प्रोक्त कोऽहमित्येतदात्मनः ।\nवक्तु न शक्यते श्रोतु तन्ममेच्छा ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000973084, "chapter_id": 20973, "verse_number": "२-१३-८५", "content_sanskrit": "योऽस्ति सोऽहमिति ब्रह्मन्! कथं वक्तुं न शक्यते ।\nआत्मन्येष न दोषाय शब्दोऽहमिति यो द्रिज ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000973085, "chapter_id": 20973, "verse_number": "२-१३-८६", "content_sanskrit": "शब्दोऽहमिति दोषाय आत्मन्येष तथैव तत् ।\nअनात्मन्यात्मविज्ञानं शब्दो वा भ्रान्तिलक्षणाः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000973086, "chapter_id": 20973, "verse_number": "२-१३-८७", "content_sanskrit": "जिह्वा ब्रवीत्यहमिति दन्तोष्ठौ तालुक नृप! ।\nएते नाहं यतः सर्वे वाङूनिष्पादनहेतवः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000973087, "chapter_id": 20973, "verse_number": "२-१३-८८", "content_sanskrit": "किंहेतुभिर्वदत्येषा वागेवाहमिति स्वयम् ।\nतथापि वाग् नाहमेतद् वक्तु मित्थं न युज्यते ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000973088, "chapter_id": 20973, "verse_number": "२-१३-८९", "content_sanskrit": "पिण्डः पृथग् यतः पुसः शिरः पाण्यादिलक्षणाः ।\nततोऽहमिति कुत्रैतां संज्ञां राजन्! करोम्यहम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000973089, "chapter_id": 20973, "verse_number": "२-१३-९०", "content_sanskrit": "यद्यन्योऽस्ति परः कोऽपि मत्तः पार्थिवसत्तम! ।\nतदैषोऽहमयञ्चान्यो वक्तुमेवमपीष्यते ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000973090, "chapter_id": 20973, "verse_number": "२-१३-९१", "content_sanskrit": "यदा समस्तदेहेषु पुमानेको व्यवस्थितः ।\nतदा हि को भवान् कोऽहमित्येतद् विफलं वचः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000973091, "chapter_id": 20973, "verse_number": "२-१३-९२", "content_sanskrit": "त्वं राजा शिबिका चेयमिमे वाहाः पुरः सराः ।\nअयञ्च भवतो लोको न सदेतन्नृपोच्यते ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000973092, "chapter_id": 20973, "verse_number": "२-१३-९३", "content_sanskrit": "वृक्षदू दारु ततश्चैयं शिबिका त्वदधिष्ठिता ।\nकिं वृक्षसंज्ञा वास्याः स्याद्दारुसंज्ञाथवा नृप ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000973093, "chapter_id": 20973, "verse_number": "२-१३-९४", "content_sanskrit": "वृक्षारूढो महाराजो नायं वदति ते जनः ।\nन च दारुणि सर्वस्त्वां ब्रवीति शिबिकागतम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000973094, "chapter_id": 20973, "verse_number": "२-१३-९५", "content_sanskrit": "शिबिका दारुसङ्गातो रचनास्थितिसंस्थितः ।\nआन्वष्यतां नृपश्वेष्ठ! तद्भदे शिबिका त्वया ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000973095, "chapter_id": 20973, "verse_number": "२-१३-९६", "content_sanskrit": "एवं छत्रशलाकानां पृथगूभागो विमृश्यताम् ।\nक्व यातं छत्रमित्येष न्यायस्त्वयि तथा मयि ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000973096, "chapter_id": 20973, "verse_number": "२-१३-९७", "content_sanskrit": "पुमान् स्त्री गौरजो वाजी कुञ्जरो विहगस्तरुः ।\nदेहेषु लोकसंज्ञयं विज्ञया कर्म्महेतुषु ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000973097, "chapter_id": 20973, "verse_number": "२-१३-९८", "content_sanskrit": "पुमान्न देवो न नरो न पशुर्न च पादपः ।\nशरीराकृतिबेदास्तु भूपैते कर्म्मयोनयः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000973098, "chapter_id": 20973, "verse_number": "२-१३-९९", "content_sanskrit": "वस्तु राजेति यल्लोके यच्च राजभटात्मकम् ।\nतथान्यज्व नृपेत्थं तन्न सत्सङ्कल्पनामयम् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000973099, "chapter_id": 20973, "verse_number": "२-१३-१००", "content_sanskrit": "यत्तु कालान्तरेणापि नान्यां संज्ञामुपैति वै ।\nपरिणामादिसम्भूतां तदूस्तु नृप! तज्व किम् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000973100, "chapter_id": 20973, "verse_number": "२-१३-१०१", "content_sanskrit": "त्वं राजा सर्व्वलोकस्य पितुः पुत्रो रिपो रिपुः ।\nपत्न्याः पतिः पिता सूनोः किं त्वा भूप! वदाम्यहम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000973101, "chapter_id": 20973, "verse_number": "२-१३-१०२", "content_sanskrit": "त्वं किमेतच्छिरः किं नु ग्रीवा तव तथोदरम् ।\nकिमु पादादिकं त्वं वा तवैतत् किं महीपते ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000973102, "chapter_id": 20973, "verse_number": "२-१३-१०३", "content_sanskrit": "समस्तावयवेभ्यस्त्वं पृथग् भूप! व्यवस्थितः ।\nकोऽहमित्यत्र निपुणो भूत्वा चिन्तय पार्थिव ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000973103, "chapter_id": 20973, "verse_number": "२-१३-१०४", "content_sanskrit": "एवं व्यवस्थिते तत्त्वे मयाहमिति भाषितुम् ।\nपथक् करणनिष्पाद्य शक्यते नपते! कथम् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}]