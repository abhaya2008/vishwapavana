[{"id": 2030562, "chapter_id": 1668, "verse_number": "३-३०६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2030563, "chapter_id": 1668, "verse_number": "३-३०६-१", "content_sanskrit": "सा तु कन्या महाराज ब्राह्मणं संशितव्रतम्।\nतोषयामास शुद्धेन मनसा संशितव्रता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2030564, "chapter_id": 1668, "verse_number": "३-३०६-२", "content_sanskrit": "प्रातरेष्याम्यथेत्युक्त्वा कदाचिद्द्विजसत्तमः।\nतत आयाति राजेन्द्र सायं रात्रावथो पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2030565, "chapter_id": 1668, "verse_number": "३-३०६-३", "content_sanskrit": "तं च सर्वासु वेलासु भक्ष्यभोज्यप्रतिश्रयैः।\nपूजयामास सा कन्या वर्धमानैस्तु सर्वदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2030566, "chapter_id": 1668, "verse_number": "३-३०६-४", "content_sanskrit": "अन्नादिसमुदाचारः शय्यासनकृतस्तथा।\nदिवसेदिवसे तस्य वर्धते न तु हीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2030567, "chapter_id": 1668, "verse_number": "३-३०६-५", "content_sanskrit": "निर्भर्त्सनापवादैश्च तथैवाप्रियया गिरा।\nब्राह्मणस्य पृथा राजन्न चकाराप्रियं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2030568, "chapter_id": 1668, "verse_number": "३-३०६-६", "content_sanskrit": "स्वप्नकाले पुनश्चैति न चैति बहुशो द्विजः।\nसुदुर्लभमपि ह्यन्नं दीयतामिति सोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2030569, "chapter_id": 1668, "verse_number": "३-३०६-७", "content_sanskrit": "कृतमेव च तत्सर्वं यथा तस्मै न्यवेदयत्।\nशिष्यवत्पुत्रवच्चैव स्वसृवच्च सुसंयता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2030570, "chapter_id": 1668, "verse_number": "३-३०६-८", "content_sanskrit": "यथोपजोषं राजेन्द्र द्विजातिप्रवरस्य सा।\nप्रीतिमुत्पादयामास कन्यारत्नमनिन्दिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2030571, "chapter_id": 1668, "verse_number": "३-३०६-९", "content_sanskrit": "तस्यास्तु शीलवृत्तेन तुतोप द्विजसत्तमः।\nअवधानेन भूयोऽस्याः परं यत्नमथाकरोत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2030572, "chapter_id": 1668, "verse_number": "३-३०६-१०", "content_sanskrit": "तां प्रभाते च सायं च पिता पप्रच्छ भारत।\nअपितुष्यतिते पुत्रि ब्राह्मणः परिचर्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2030573, "chapter_id": 1668, "verse_number": "३-३०६-११", "content_sanskrit": "तं सा परममित्येवप्रत्युवाच यशस्विनी।\nततः प्रीतिमवापाग्र्यां कुन्तिभोजो महामनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2030574, "chapter_id": 1668, "verse_number": "३-३०६-१२", "content_sanskrit": "ततः संवत्सरे पूर्णे यदाऽसौ जपतांवरः।\nनापश्यद्दुष्कृतंकिंचित्पृथायाः सौहृदे रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2030575, "chapter_id": 1668, "verse_number": "३-३०६-१३", "content_sanskrit": "ततः प्रीतमना भूत्वा स एनां ब्राह्मणोऽब्रवीत्।\nप्रीतोस्मि परमं भद्रे परिचारेण ते शुभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2030576, "chapter_id": 1668, "verse_number": "३-३०६-१४", "content_sanskrit": "वरान्वृणीष्व क्रल्याणि दूरापान्मानुपैरिह।\nयैस्त्वं सीमन्तिनीः सर्वायशसाऽभिमविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2030577, "chapter_id": 1668, "verse_number": "३-३०६-१५x", "content_sanskrit": "कुन्त्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2030578, "chapter_id": 1668, "verse_number": "३-३०६-१५", "content_sanskrit": "कृतानि मम सर्वाणि सस्या मे वेदवित्तम।\nत्वं प्रसन्नः पिता चैव कृतं विप्र वरैर्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2030579, "chapter_id": 1668, "verse_number": "३-३०६-१६x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2030580, "chapter_id": 1668, "verse_number": "३-३०६-१६", "content_sanskrit": "यदि नेच्छसि मत्तस्त्वं वरं भद्रे शुचिस्मिते।\nइमं मन्त्रं गृहाण त्वमाह्रानाय दिवौकसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2030581, "chapter_id": 1668, "verse_number": "३-३०६-१७", "content_sanskrit": "यंयं देवं त्वमेतेन मन्त्रेणावाहयिष्यसि।\nतेनतेन वशे भद्रे स्थातव्यं ते भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2030582, "chapter_id": 1668, "verse_number": "३-३०६-१८", "content_sanskrit": "अकामो वा सकामो वा स समेष्यति ते वशे।\nविबुधो मन्त्रसंभ्रान्तो वाक्यैर्भृत्य इवानतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2030583, "chapter_id": 1668, "verse_number": "३-३०६-१९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2030584, "chapter_id": 1668, "verse_number": "३-३०६-१९", "content_sanskrit": "न शशक द्वितीयं सा प्रत्याख्यातुमनिन्दिता।\nतं वै द्विजातिप्रवरं तदा शापभयान्नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2030585, "chapter_id": 1668, "verse_number": "३-३०६-२०", "content_sanskrit": "ततस्तामनवद्याङ्गीं ग्राहयामास स द्विजः।\nमन्त्रग्रामं तदा राजन्नथर्वशिरसि श्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2030586, "chapter_id": 1668, "verse_number": "३-३०६-२१", "content_sanskrit": "तं प्रदाय तु राजेन्द्र कुन्तिभोजमुवाच ह।\nउपितोस्मि सुखं राजन्कन्यया परितोपितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2030587, "chapter_id": 1668, "verse_number": "३-३०६-२२", "content_sanskrit": "तवगेहे सुविहितः सदा सुप्रतिपूजितः।\nसाधयिष्यामहे तावदित्युक्त्वाऽन्तरधीयत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2030588, "chapter_id": 1668, "verse_number": "३-३०६-२३", "content_sanskrit": "स तु राजा द्विजं दृष्ट्वा तत्रैवान्तर्हितं तदा।\nबभूव विस्मयाविष्टः पृथां च समपूजयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2030589, "chapter_id": 1668, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि कुण्डलाहरणपर्वणि षडधिकविशततमोऽद्यायः ॥ ३०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]