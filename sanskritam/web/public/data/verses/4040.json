[{"id": 2140916, "chapter_id": 4040, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2140917, "chapter_id": 4040, "verse_number": "१", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा नीतिशास्त्रविशारदः ।\nआचार्यः कुरुवीराणां कृपः शारद्वतोऽब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2140918, "chapter_id": 4040, "verse_number": "२", "content_sanskrit": "सदैव तव राधेय युद्धे क्रूरतरा मतिः ।\nनार्थानां प्रकृतिं वेत्सि नानुबन्धमवेक्षसे\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2140919, "chapter_id": 4040, "verse_number": "३", "content_sanskrit": "नया हि बहवः सन्ति शास्त्राण्याश्रित्य चिन्तिताः ।\nतेषां युद्धं सुपापिष्ठं वेदयन्ति पुराविदः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2140920, "chapter_id": 4040, "verse_number": "४", "content_sanskrit": "देशकालेन संयुक्तं युद्धं विजयदं भवेत् ।\nहीनकालं तदेवेह अनर्थायोपकल्पते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2140921, "chapter_id": 4040, "verse_number": "५", "content_sanskrit": "देशकालेन विक्रान्तं कल्याणाय विधीयते ।\nआनुकूल्येन कार्याणामुत्तरं तु विधीयते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2140922, "chapter_id": 4040, "verse_number": "६", "content_sanskrit": "भारं हि रथकारस्य न व्यवस्यन्ति पण्डिताः ।\nपरिचिन्त्य तु पार्थेन सन्निपातो न नः क्षमः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2140923, "chapter_id": 4040, "verse_number": "७", "content_sanskrit": "एको हि शत्रून् समरे समर्थः प्रतिबाधितुम् ।\nएकः कुरूनभ्यगमद् एकश्चाग्निमतर्पयत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2140924, "chapter_id": 4040, "verse_number": "८", "content_sanskrit": "एकश्च पञ्च वर्षाणि ब्रह्मचर्यमधारयत् ।\nएकः सुभद्रामारोप्य द्वैरथे कृष्णमाह्वयत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2140925, "chapter_id": 4040, "verse_number": "९", "content_sanskrit": "सैन्धवं वनवासे तु जित्वा कृष्णामथानयत् ।\nएकश्च पञ्च वर्षाणि शक्रादस्त्राण्यशिक्षयन्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2140926, "chapter_id": 4040, "verse_number": "१०", "content_sanskrit": "एकः संयमिनीं जित्वा कुरूणामकरोद् यशः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2140927, "chapter_id": 4040, "verse_number": "११", "content_sanskrit": "एको गन्धर्वराजानं चित्रसेनमरिन्दमः ।\nविजिग्ये तरसा सङ्खे सेनां चास्य सुदुर्जयाम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2140928, "chapter_id": 4040, "verse_number": "१२", "content_sanskrit": "पाञ्चाली श्रीमती प्राप्ता क्षत्रं जित्वा स्वयंवरे ।\nआदाय गतवान् पार्थो भवान् क्व नु गतस्तदा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2140929, "chapter_id": 4040, "verse_number": "१३", "content_sanskrit": "तथा निवातकवचाः कालकेयाश्च दानवाः ।\nदैवतैरप्यवध्यास्ते एकेन युधि पातिताः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2140930, "chapter_id": 4040, "verse_number": "१४", "content_sanskrit": "एकः किरातरूपेण स्थितं रुद्रमयोधयन्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2140931, "chapter_id": 4040, "verse_number": "१५", "content_sanskrit": "एकेन हि त्वया कर्ण किं नामेह कृतं पुरा ।\nएकैकेन यथा तेषां भूमिपाला वशे कृताः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2140932, "chapter_id": 4040, "verse_number": "१६", "content_sanskrit": "इन्द्रोऽपि हि न पार्थेन संयुगे योद्धुमर्हति ।\nयस्तेनाशंसते योद्धुं कर्तव्यं तस्य भैषजम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2140933, "chapter_id": 4040, "verse_number": "१७", "content_sanskrit": "आशीविषस्य क्रुद्धस्य पाणिमुद्यम्य दक्षिणम् ।\nअवमृज्य प्रदेशिन्या दंष्ट्रामादातुमिच्छसि\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2140934, "chapter_id": 4040, "verse_number": "१८", "content_sanskrit": "अथवा कुञ्जरं मत्तमेकमेकचरं वने ।\nअनङ्कुशं समारुह्य नगरं यातुमिच्छसि\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2140935, "chapter_id": 4040, "verse_number": "१९", "content_sanskrit": "समिद्धं पावकं चापि घृतमेदोवसाहुतम् ।\nघृताक्तश्चीरवासास्त्वं मध्येनोत्तर्तुमिच्छसि\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2140936, "chapter_id": 4040, "verse_number": "२०", "content_sanskrit": "आत्मानं यः समाबध्य कण्ठे बद्ध्वा तथा शिलाम् ।\nसमुद्रं प्रतरन् दोर्भ्यां तत्र किं कर्ण पौरुषम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2140937, "chapter_id": 4040, "verse_number": "२१", "content_sanskrit": "अकृतास्त्रः कृतास्त्रं वै बलवन्तं सुदुर्बलः ।\nतादृशं कर्ण यः पार्थं योद्धुमिच्छेत् स दुर्मतिः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2140938, "chapter_id": 4040, "verse_number": "२२", "content_sanskrit": "अस्माभिरेव(रेष) निकृतो वर्षाणीह त्रयोदश ।\nसिंहः पाशाद् विमुक्तो वा न शेषं कर्तुमर्हति\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2140939, "chapter_id": 4040, "verse_number": "२३", "content_sanskrit": "एकान्ते पार्थमासीनं कूपेऽग्निमिव संवृतम् ।\nअज्ञानादभ्यवस्कन्द्य प्राप्ताः स्मो भयमुत्तमम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2140940, "chapter_id": 4040, "verse_number": "२४", "content_sanskrit": "उत्सृष्टं तूलराशौ तु एकोऽग्निं शमयेत् कथम् ।\nसह युद्ध्यामहे पार्थमागतं युद्धदुर्मदम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2140941, "chapter_id": 4040, "verse_number": "२५", "content_sanskrit": "यत्तसेनाः पराक्रान्ता व्यूढानीकाः प्रहारिणः ।\nयुद्धायावस्थितं पार्थमागतं पाकशासनिम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2140942, "chapter_id": 4040, "verse_number": "२६", "content_sanskrit": "यत्ताः सर्वे रथश्रेष्ठं परिवार्य समन्ततः ।\nषड्रथाः परिकीर्यन्तां वज्रपाणिमिवासुराः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2140943, "chapter_id": 4040, "verse_number": "२७", "content_sanskrit": "द्रोणो दुर्योधनो भीष्मो भवान् द्रौणिस्तथा वयम् ।\nसर्वे युद्ध्यामहे पार्थं कर्ण मा साहसं कृथाः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2140944, "chapter_id": 4040, "verse_number": "२८", "content_sanskrit": "नह्यसंव्यूह्य समरे पार्थं जेष्यामहे वयम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2140945, "chapter_id": 4040, "verse_number": "२९", "content_sanskrit": "युद्धे व्यवस्थितं पार्थं वज्रपाणिमिवोद्यतम् ।\nषड्रथाः प्रतियुध्येम तिष्ठामश्चेह संहताः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2140946, "chapter_id": 4040, "verse_number": "३०", "content_sanskrit": "व्यूढानीकानि सैन्यानि यत्ताः परमधन्विनः ।\nयुद्ध्यामहेऽर्जुनं सङ्खे दानवा इव वासवम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2140947, "chapter_id": 4040, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि अष्टचत्वारिंशोऽध्यायः ॥४८॥ गोग्रहणपर्वणि एकविंशोऽध्यायः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]