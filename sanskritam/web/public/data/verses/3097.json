[{"id": 2097957, "chapter_id": 3097, "verse_number": "१३-२२७-१", "content_sanskrit": "उमोवाच।\nभगवन्देवदेवेश कर्मणैव शुभाशुभम्।\nयथायोगं फलं जन्तुः प्राप्नोतीति विनिश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2097958, "chapter_id": 3097, "verse_number": "१३-२२७-२", "content_sanskrit": "परेषां विप्रियं कुर्वन्यथा सम्प्राप्नुयाच्छुभम्।\nयद्येतदस्मिंश्चेद्देहे तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2097959, "chapter_id": 3097, "verse_number": "१३-२२७-३x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2097960, "chapter_id": 3097, "verse_number": "१३-२२७-३", "content_sanskrit": "तदप्यस्ति महाभागे अभिसन्धिबलान्नृणम्।\nहितार्थं दुःखमन्येषां कृत्वा सुखमवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2097961, "chapter_id": 3097, "verse_number": "१३-२२७-४", "content_sanskrit": "दण्डयन्भर्त्सयन्राजा जनान्पुण्यमवाप्नुयात्।\nगुरुः सन्तर्जयञ्शिष्यान्भर्ता भृत्यजनान्स्वकान्।\nउन्मार्गप्रतिपन्नांश्च शास्ता धर्मफलं लभेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2097962, "chapter_id": 3097, "verse_number": "१३-२२७-५", "content_sanskrit": "चिकित्सकश्च दुःखानि जनयन्हितमाप्नुयात्।\nयज्ञार्थं पशुहिंसां च कुर्वन्नपि न लिप्यते।\nएवमन्ये सुमनसो हिंसकाः स्वर्गमाप्नुयुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2097963, "chapter_id": 3097, "verse_number": "१३-२२७-६", "content_sanskrit": "एकस्मिन्निहते भद्रे बहवः सुखमाप्नुयुः।\nतस्मिन्हते भवेद्धर्मः कुत एव तु पातकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2097964, "chapter_id": 3097, "verse_number": "१३-२२७-७", "content_sanskrit": "अहिंसतेति हत्वा तु शुद्धे कर्मणि गौरवात्।\nअभिसन्धेरजिह्मत्वाच्छुद्धे धर्मस्य गौरवात्।\nएतत्कृत्वा तु पापेभ्यो न दोषं प्राप्नुयुः क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2097965, "chapter_id": 3097, "verse_number": "१३-२२७-८x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2097966, "chapter_id": 3097, "verse_number": "१३-२२७-८", "content_sanskrit": "चतुर्विधानां जन्तूनां कथं ज्ञानमिह स्मृतम्।\nकृत्रिमं तत्स्वभावं वा तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2097967, "chapter_id": 3097, "verse_number": "१३-२२७-९x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2097968, "chapter_id": 3097, "verse_number": "१३-२२७-९", "content_sanskrit": "स्थावरं जङ्गमं चैव जगद्द्विविधमुच्यते।\nचतस्रो योनयस्तत्र प्रजानां क्रमशो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2097969, "chapter_id": 3097, "verse_number": "१३-२२७-१०", "content_sanskrit": "तेषामुद्भिदजा वृक्षा लतावल्ल्यश्च वीरुधः।\nदंशयूकादयश्चान्ये स्वेदजाः क्रिमिजातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2097970, "chapter_id": 3097, "verse_number": "१३-२२७-११", "content_sanskrit": "पक्षिणश्छिद्कर्णाश्च प्राणिनस्त्वण्डजा मताः।\nमृगव्यालमनुष्यांश्च विद्धि तेषां जरायुजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2097971, "chapter_id": 3097, "verse_number": "१३-२२७-१२", "content_sanskrit": "एवं चतुर्विधां जातिमात्मा संसृत्य तिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2097972, "chapter_id": 3097, "verse_number": "१३-२२७-१३", "content_sanskrit": "स्पर्शेनैकेन्द्रियेणात्मा तिष्ठत्युद्भिदजेषु वै।\nशरीरस्पर्शरूपाभ्यां स्वेदजेष्वपि तिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2097973, "chapter_id": 3097, "verse_number": "१३-२२७-१४", "content_sanskrit": "पञ्चभिश्चेन्द्रियद्वारैर्जीवन्त्यण्डजरायुजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2097974, "chapter_id": 3097, "verse_number": "१३-२२७-१५", "content_sanskrit": "तथा भूम्यम्बुसंयोगाद्भवन्त्युद्भिदजाः प्रिये।\nशीकतोष्णयोस्तु संयोगाज्जायन्ते स्वेदजाः प्रिये।\nअण्डजाश्चापि जायन्ते संयोगात्क्लेदबीजयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2097975, "chapter_id": 3097, "verse_number": "१३-२२७-१६", "content_sanskrit": "शुक्लशोणितसंयोगात्सम्भवन्ति जरायुजाः।\nजरायुजानां सर्वेषां मानुषं पदमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2097976, "chapter_id": 3097, "verse_number": "१३-२२७-१७", "content_sanskrit": "अतःपरं तमोत्पत्तिं शृणु देवि समाहिता।\nद्विविधं हि तमो लोके शार्वरं देहजं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2097977, "chapter_id": 3097, "verse_number": "१३-२२७-१८", "content_sanskrit": "जोतिर्भिश्च तमो लोके नाशं गच्छति शार्वरम्।\nदेहजं तु तमो लोके तैः समस्तैर्न शाम्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2097978, "chapter_id": 3097, "verse_number": "१३-२२७-१९", "content_sanskrit": "तमसस्तस्य नाशार्थं नोपायमधिजग्मिवान्।\nतपश्चचार वलिपुलं लोककर्ता पितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2097979, "chapter_id": 3097, "verse_number": "१३-२२७-२०", "content_sanskrit": "चरतस्तु समुद्भूता वेदाः साङ्गाः सहोत्तराः।\nताँल्लब्ध्वा मुमुदे ब्रह्मा लोकानां हितकाम्यया।\nदेहजं तु तमो घोरमभूत्तैरेव नाशितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2097980, "chapter_id": 3097, "verse_number": "१३-२२७-२१", "content_sanskrit": "कार्याकार्यमिदं चेति वाच्यावाच्यमिदं त्विति।\nयदि चेन्न भवेल्लोके श्रुतं चारित्रदैशिकम्।\nपसुभिर्निर्विशेषं तु चेष्टन्ते मानुषा अपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2097981, "chapter_id": 3097, "verse_number": "१३-२२७-२२", "content_sanskrit": "यज्ञादीनां समारम्भः श्रुतेनैव विधीयते।\nयज्ञस्य फलयोगेन देवलोकः समृद्ध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2097982, "chapter_id": 3097, "verse_number": "१३-२२७-२३", "content_sanskrit": "प्रीतियुक्ताः पुनर्देवा मानुषाणां भवन्त्युत।\nएवं नित्यं प्रवर्धेते रोदसी च परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2097983, "chapter_id": 3097, "verse_number": "१३-२२७-२४", "content_sanskrit": "लोकसन्धारणं तस्माच्छ्रुतमित्यवधारय।\nज्ञानाद्विशिष्टं जन्तूनां नास्ति लोकत्रयेऽपि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2097984, "chapter_id": 3097, "verse_number": "१३-२२७-२५", "content_sanskrit": "सहजं तत्प्रधानं स्यादपरं कृत्रिमं स्मृतम्।\nउभयं यत्र सम्पन्नं भवेत्तत्र तु शोभनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2097985, "chapter_id": 3097, "verse_number": "१३-२२७-२६", "content_sanskrit": "सम्प्रगृह्य श्रुतं सर्वं कृतकृत्यो भवत्युत।\nउपर्युपरि मर्त्यानां देववत्सम्प्रकाशते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2097986, "chapter_id": 3097, "verse_number": "१३-२२७-२७", "content_sanskrit": "कामं क्रोधं भयं दर्पमज्ञानं चैव बुद्धिजम्।\nतच्छ्रुतं नुदति क्षिप्रं यथा वायुर्बलाहकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2097987, "chapter_id": 3097, "verse_number": "१३-२२७-२८", "content_sanskrit": "अल्पमात्रं कृतो धर्मो भवेज्झानवतां महान्।\nमहानपि कृतो धर्मो ह्यज्ञानान्निष्फलो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2097988, "chapter_id": 3097, "verse_number": "१३-२२७-२९", "content_sanskrit": "परावरझो भूतानां ज्ञानवांस्तत्वविद्भवेत्।\nएवं श्रुतफलं सर्वं कथितं ते शुभक्षणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2097989, "chapter_id": 3097, "verse_number": "१३-२२७-३०x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2097990, "chapter_id": 3097, "verse_number": "१३-२२७-३०", "content_sanskrit": "भगवन्मानुषाः केचिज्जातिस्मरणसंयुताः।\nकिमर्थमभिजायन्ते जानन्तः पौर्वदैहिकम्।\nएतन्मे तत्वतो देव मानुषेषु वदस्व भो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2097991, "chapter_id": 3097, "verse_number": "१३-२२७-३१x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2097992, "chapter_id": 3097, "verse_number": "१३-२२७-३१", "content_sanskrit": "तदहं ते प्रवक्ष्यामि शृणु तत्वं समाहिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2097993, "chapter_id": 3097, "verse_number": "१३-२२७-३२", "content_sanskrit": "ये मृताः सहसा मर्त्या जायन्ते सहसा पुनः।\nतेषां पौराणिको बोधः कञ्चित्कालं हि तिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2097994, "chapter_id": 3097, "verse_number": "१३-२२७-३३", "content_sanskrit": "तस्माज्जातिस्मरा लोके जायन्ते बोधसंयुताः।\nतेषां विवर्धतां संज्ञा स्वप्नवत्सा प्रणश्यति।\nपरलोकस्य चास्तित्वे मूढानां कारणं च तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2097995, "chapter_id": 3097, "verse_number": "१३-२२७-३४x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2097996, "chapter_id": 3097, "verse_number": "१३-२२७-३४", "content_sanskrit": "भगवन्मानुषाः केचिन्मृता भूत्वाऽपि सम्प्रति।\nनिवर्तमाना दृश्यन्ते देहेष्वेव पुनर्नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2097997, "chapter_id": 3097, "verse_number": "१३-२२७-३५x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2097998, "chapter_id": 3097, "verse_number": "१३-२२७-३५", "content_sanskrit": "तदहं ते प्रवक्ष्यामि कारणं शृणु शोभने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2097999, "chapter_id": 3097, "verse_number": "१३-२२७-३६", "content_sanskrit": "प्राणैर्वियुज्यमानानां बहुत्वात्प्राणिनां वधे।\nतथैव नामसामान्याद्यमदूता नृणां प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2098000, "chapter_id": 3097, "verse_number": "१३-२२७-३७", "content_sanskrit": "वहन्ति ते क्वचिन्मोहादन्यं मर्त्यं तु यामिकाः।\nनिर्विकारं हि तत्सर्वं यमो वेद कृताकृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2098001, "chapter_id": 3097, "verse_number": "१३-२२७-३८", "content_sanskrit": "तस्मात्संयमनीं प्राप्य यमेनैकेन मोक्षिताः।\nपुनरेव निवर्तन्ते शेषं भोक्तुं स्वकर्मणः।\nस्वकर्मण्यसमाप्ते तु निवर्तन्ते हि मानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2098002, "chapter_id": 3097, "verse_number": "१३-२२७-३९x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2098003, "chapter_id": 3097, "verse_number": "१३-२२७-३९", "content_sanskrit": "भगवन्सुप्तमात्रेण प्राणिनां स्वप्नदर्शनम्।\nकिं तत्स्वभावमन्यद्वा तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2098004, "chapter_id": 3097, "verse_number": "१३-२२७-४०x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2098005, "chapter_id": 3097, "verse_number": "१३-२२७-४०", "content_sanskrit": "सुप्तानां तु मनश्चेष्टा स्वप्न इत्यभिधीयते।\nअनागतमतिक्रान्तं पश्यते सञ्चरन्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2098006, "chapter_id": 3097, "verse_number": "१३-२२७-४१", "content_sanskrit": "निमित्तं च भवेत्तस्मात्प्राणिनां स्वप्नदर्शनम्।\nएतत्ते कथितं देवि भूयः श्रोतु किमिच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2098007, "chapter_id": 3097, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि सप्तविंशत्यधिकद्विशततमोऽध्यायः॥ २२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]