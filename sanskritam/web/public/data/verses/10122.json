[{"id": 6000122000, "chapter_id": 10122, "verse_number": null, "content_sanskrit": "अथ तृतीयाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000122001, "chapter_id": 10122, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.001.m4a", "display_order": 2}, {"id": 6000122002, "chapter_id": 10122, "verse_number": "६-३-१", "content_sanskrit": "निशम्य देवः स्वभटोपवर्णितं प्रत्याह किं तानपि धर्मराजः।\nएवं हताज्ञो विहितान् मुरारेर्नैदेशिकैर्यस्य वशे जनोऽयम्॥ ६/३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.002.m4a", "display_order": 3, "topics": [{"text": "विष्णुदूतकृतं स्वावज्ञानं स्वदूतमुखतो यमेन श्रवणम्", "range": "१–१०"}]}, {"id": 6000122003, "chapter_id": 10122, "verse_number": "६-३-२", "content_sanskrit": "यमस्य देवस्य न दण्डभङ्गः कुतश्चनर्षे श्रुतपूर्व आसीत्।\nएवं मुने वृश्चति लोकसंशयं न हि त्वदन्य इति मे विनिश्चितम्॥ ६/३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.003.m4a", "display_order": 4}, {"id": 6000122004, "chapter_id": 10122, "verse_number": null, "content_sanskrit": "बादरायणिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.004.m4a", "display_order": 5}, {"id": 6000122005, "chapter_id": 10122, "verse_number": "६-३-३", "content_sanskrit": "भगवत्पुरुषै राजन् याम्याः प्रतिहतोद्यमाः।\nपतिं विज्ञापयामासुः यमं संयमनीपतिम्॥ ६/३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.005.m4a", "display_order": 6}, {"id": 6000122006, "chapter_id": 10122, "verse_number": null, "content_sanskrit": "यमदूता ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.006.m4a", "display_order": 7}, {"id": 6000122007, "chapter_id": 10122, "verse_number": "६-३-४", "content_sanskrit": "कति सन्तीह शास्तारो जीवलोकस्य वै प्रभो।\nत्रैविद्यं कुर्वतः कर्म फलाभिव्यक्तिहेतवः॥ ६/३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.007.m4a", "display_order": 8}, {"id": 6000122008, "chapter_id": 10122, "verse_number": "६-३-५", "content_sanskrit": "यदि स्युर्बहवो लोके शास्तारो दण्डधारिणः।\nकस्य स्यातां न वा कस्य मृत्युश्चामृतमेव च॥ ६/३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.008.m4a", "display_order": 9}, {"id": 6000122009, "chapter_id": 10122, "verse_number": "६-३-६", "content_sanskrit": "किन्तु शास्तृबहुत्वे स्याद् बहूनामिह कर्मिणाम्।\nशास्तृत्वमुपचारो हि यथा मण्डलवर्तिनाम्॥ ६/३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.009.m4a", "display_order": 10}, {"id": 6000122010, "chapter_id": 10122, "verse_number": "६-३-७", "content_sanskrit": "अतस्त्वमेको भूतानां सेश्वराणामधीश्वरः।\nशास्ता दण्डधरो नॄणां शुभाशुभविवेचनः॥ ६/३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.010.m4a", "display_order": 11}, {"id": 6000122011, "chapter_id": 10122, "verse_number": "६-३-८", "content_sanskrit": "तस्य ते विहतो दण्डो नृलोके वर्ततेऽधुना।\nचतुर्भिरद्भुतैः सिद्धैराज्ञा ते विप्रलम्भिता॥ ६/३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.011.m4a", "display_order": 12}, {"id": 6000122012, "chapter_id": 10122, "verse_number": "६-३-९", "content_sanskrit": "नीयमानं तवादेशादस्माभिर्यातनागृहम्।\nव्यमोचयन् पातकिनं छित्त्वा पाशान् प्रसह्य ते॥ ६/३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.012.m4a", "display_order": 13}, {"id": 6000122013, "chapter_id": 10122, "verse_number": "६-३-१०", "content_sanskrit": "तांस्ते वेदितुमिच्छामो यदि नो मन्यसे क्षमम्।\nनारायणेत्यभिहिते मा भैरित्याययुर्द्रुतम्॥ ६/३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.013.m4a", "display_order": 14}, {"id": 6000122014, "chapter_id": 10122, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.014.m4a", "display_order": 15}, {"id": 6000122015, "chapter_id": 10122, "verse_number": "६-३-११", "content_sanskrit": "इति देवः स आपृष्टः प्रजासंयमनो यमः।\nप्रीतः स्वदूतान् प्रत्याह स्मरन् पादाम्बुजं हरेः॥ ६/३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.015.m4a", "display_order": 16, "topics": [{"text": "ततः यमेनापि स्वदूतेभ्यः विष्णोरेव सर्वोत्तमत्वकथनम्", "range": "११–३५"}]}, {"id": 6000122016, "chapter_id": 10122, "verse_number": null, "content_sanskrit": "यम उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.016.m4a", "display_order": 17}, {"id": 6000122017, "chapter_id": 10122, "verse_number": "६-३-१२", "content_sanskrit": "परो मदन्यो जगतस्तस्थुषश्च ओतं प्रोतं पटवद् यत्र विश्वम्।\nयदंशतोऽस्य स्थितिजन्मनाशा नस्योतवद् यस्य वशे च लोकः॥ ६/३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.017.m4a", "display_order": 18}, {"id": 6000122018, "chapter_id": 10122, "verse_number": "६-३-१३", "content_sanskrit": "यो नामभिर्वाचि जनं निजायां बध्नाति तन्त्यामिव दामभिर्गाः।\nयस्मै बलिं त इमे नामकर्मभिर्निबन्धबद्धाश्चकिता वहन्ति॥ ६/३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.018.m4a", "display_order": 19}, {"id": 6000122019, "chapter_id": 10122, "verse_number": "६-३-१४", "content_sanskrit": "अहं महेन्द्रो निर्ऋतिः प्रचेताः सोमोऽग्निरीशः पवनोऽर्को विरिञ्चः।\nआदित्यविश्वेवसवोऽथ साध्या मरुद्गणा रुद्रगणाः ससिद्धाः॥ ६/३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.019.m4a", "display_order": 20}, {"id": 6000122020, "chapter_id": 10122, "verse_number": "६-३-१५", "content_sanskrit": "अन्ये च ये विश्वसृजोऽमरेशा भृग्वादयोऽस्पृष्टरजस्तमस्काः।\nयस्येहितं न विदुः स्पृष्टमायाः सत्त्वप्रधाना अपि किं ततोऽन्ये॥ ६/३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.020.m4a", "display_order": 21}, {"id": 6000122021, "chapter_id": 10122, "verse_number": "६-३-१६", "content_sanskrit": "यं वै न गोभिर्मनसाऽसुभिर्वा हृदा गिरा वाऽसुभृतो विचक्षते।\nआत्मानमन्तर्हृदि सन्तमात्मनां चक्षुर्यथैवाकृतयस्ततः परम्॥ ६/३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.021.m4a", "display_order": 22}, {"id": 6000122022, "chapter_id": 10122, "verse_number": "६-३-१७", "content_sanskrit": "तस्यात्मतन्त्रस्य हरेरधीशितुः परस्य मायाऽधिपतेर्महात्मनः।\nप्रायेण दूता इह वै मनोहराश्चरन्ति तद्रूपगुणस्वभावाः॥ ६/३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.022.m4a", "display_order": 23}, {"id": 6000122023, "chapter_id": 10122, "verse_number": "६-३-१८", "content_sanskrit": "भूतानि विष्णोः सुरपूजितानि दुर्दर्शलिङ्गानि महाद्भुतानि।\nरक्षन्ति तद्भक्तिमतः परेभ्यो मत्तश्च मर्त्यानथ सर्वतश्च॥ ६/३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.023.m4a", "display_order": 24}, {"id": 6000122024, "chapter_id": 10122, "verse_number": "६-३-१९", "content_sanskrit": "धर्मं तु साक्षाद् भगवत्प्रणीतं न वै विदुर्ऋषयो नापि देवाः।\nन सिद्धमुख्या असुरा मनुष्याः कुतो नु विद्याधरचारणादयः॥ ६/३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.024.m4a", "display_order": 25}, {"id": 6000122025, "chapter_id": 10122, "verse_number": "६-३-२०", "content_sanskrit": "स्वयम्भूर्नारदः शम्भुः कुमारः कपिलो मनुः।\nप्रह्लादो जनको भीष्मो बलिर्वैयासकिर्वयम्॥ ६/३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.025.m4a", "display_order": 26}, {"id": 6000122026, "chapter_id": 10122, "verse_number": "६-३-२१", "content_sanskrit": "द्वादशैते विजानीमो धर्मं भागवतं भटाः।\nगुह्यं विशुद्धं दुर्बोधं यज्ज्ञात्वाऽमृतमश्नुते॥ ६/३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.026.m4a", "display_order": 27}, {"id": 6000122027, "chapter_id": 10122, "verse_number": "६-३-२२", "content_sanskrit": "एतावानेव लोकेऽस्मिन् पुंसां धर्मः परः स्मृतः।\nभक्तियोगो भगवति तन्नामग्रहणादिभिः॥ ६/३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.027.m4a", "display_order": 28}, {"id": 6000122028, "chapter_id": 10122, "verse_number": "६-३-२३", "content_sanskrit": "नामोच्चारणमाहात्म्यं हरेः पश्यत पुत्रकाः।\nअजामिलोऽपि येनैव मृत्युपाशादमुच्यत॥ ६/३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.028.m4a", "display_order": 29}, {"id": 6000122029, "chapter_id": 10122, "verse_number": "६-३-२४", "content_sanskrit": "एतावताऽलमघनिर्हरणाय पुंसां सङ्कीर्तनं भगवतो गुणकर्मनाम्नाम्।\nविक्रुश्य पुत्रमघवान् यदजामिलोऽपि नारायणेति म्रियमाण इयाय मुक्तिम्॥ ६/३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.029.m4a", "display_order": 30}, {"id": 6000122030, "chapter_id": 10122, "verse_number": "६-३-२५", "content_sanskrit": "प्रायेण वेद तदिदं न महाजनोऽयं देव्या विमोहितमतिर्बत माययाऽलम्।\nत्रय्यां जडीकृतमतिर्मधुपुष्पितायां वैतानिके महति कर्मणि युज्यमानः॥ ६/३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.030.m4a", "display_order": 31}, {"id": 6000122031, "chapter_id": 10122, "verse_number": "६-३-२६", "content_sanskrit": "एवं विमृश्य सुधियो भगवत्यनन्ते सर्वात्मना विदधते खलु भावयोगम्।\nते मे न दण्डमर्हन्त्यथ यद्यमीषां स्यात् पातकं तदपि हन्त्युरुगायवादः॥ ६/३/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.031.m4a", "display_order": 32}, {"id": 6000122032, "chapter_id": 10122, "verse_number": "६-३-२७", "content_sanskrit": "ते देवसिद्धपरिगीतपवित्रगाथा ये साधवः समदृशो भगवत्प्रपन्नाः।\nतान् नोपसीदत हरेर्गदयाऽभिगुप्तान्, नैषां भयं, न च वयं प्रभवाम दण्डे॥ ६/३/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.032.m4a", "display_order": 33}, {"id": 6000122033, "chapter_id": 10122, "verse_number": "६-३-२८", "content_sanskrit": "तानानयध्वमसतो विमुखान् मुकुन्दपादारविन्दमकरन्दरसादजस्रम्।\nनिष्किञ्चनैः परमहंसकुलै रसज्ञैः जुष्टाद् गृहे निरयवर्त्मनि बद्धतृष्णान्॥ ६/३/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.033.m4a", "display_order": 34}, {"id": 6000122034, "chapter_id": 10122, "verse_number": "६-३-२९", "content_sanskrit": "जिह्वा न वक्ति भगवद्गुणनामधेयं चेतश्च न स्मरति तच्चरणारविन्दम्।\nकृष्णाय नो नमति यच्छिर एकदाऽपि तानानयध्वमसतोऽकृतविष्णुकृत्यान्॥ ६/३/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.034.m4a", "display_order": 35}, {"id": 6000122035, "chapter_id": 10122, "verse_number": "६-३-३०", "content_sanskrit": "कृष्णाङ्घ्रिपद्ममधुलिट् न पुनर्विसृष्टमायागुणेषु रमते वृजिनावहेषु।\nअन्यस्तु कामहत आत्मरजः प्रमार्ष्टुमीहेत कर्म, यत एव रजः पुनः स्यात्॥ ६/३/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.035.m4a", "display_order": 36}, {"id": 6000122036, "chapter_id": 10122, "verse_number": "६-३-३१", "content_sanskrit": "तत् क्षम्यतां स भगवान् पुरुषः पुराणो नारायणः स्वपुरुषैर्यदसत्कृतं नः।\nस्वानामहो न विदुषां रचिताञ्जलीनां क्षान्तिर्वरीयसि नमः पुरुषाय भूम्ने॥ ६/३/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.036.m4a", "display_order": 37}, {"id": 6000122037, "chapter_id": 10122, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.037.m4a", "display_order": 38}, {"id": 6000122038, "chapter_id": 10122, "verse_number": "६-३-३२", "content_sanskrit": "इत्थं स्वभर्तृगदितं भगवन्महित्वं संस्मृत्य विस्मितधियो यमकिङ्करास्ते।\nतेनाच्युताश्रयजनं प्रतिशङ्कमाना द्रष्टुं च बिभ्यति ततःप्रभृति स्म राजन्॥ ६/३/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.038.m4a", "display_order": 39}, {"id": 6000122039, "chapter_id": 10122, "verse_number": "६-३-३३", "content_sanskrit": "तस्मात् सङ्कीर्तनं विष्णोर्जगन्मङ्गलमंहसाम्।\nमहतामपि कौरव्य विद्ध्येकान्तविनिष्कृतम्॥ ६/३/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.039.m4a", "display_order": 40}, {"id": 6000122040, "chapter_id": 10122, "verse_number": "६-३-३४", "content_sanskrit": "शृण्वतो गृणतो वीर्याण्युद्दामानि हरेर्मुहुः।\nयथा सुजातया भक्त्या शुध्येन्नात्मा व्रतादिभिः॥ ६/३/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.040.m4a", "display_order": 41}, {"id": 6000122041, "chapter_id": 10122, "verse_number": "६-३-३५", "content_sanskrit": "इतिहासमिमं गुह्यं भगवान् कुम्भसम्भवः।\nकथयामास मलय आसीनो हरिमर्चयन्॥ ६/३/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_003/BhP_06.003.041.m4a", "display_order": 42}, {"id": 6000122042, "chapter_id": 10122, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां षष्ठस्कन्धे तृतीयाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]