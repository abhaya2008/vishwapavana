[{"id": 7001459000, "chapter_id": 21459, "verse_number": "७-१-३२-१", "content_sanskrit": "ऋषय ऊचुः ।\nकिं तच्छ्रेष्टमनुष्ठानं मोक्षो येनपरोक्षितः ।\nतत्तस्य साधनं चाद्य वक्तुमर्हसि मारुत॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001459001, "chapter_id": 21459, "verse_number": "७-१-३२-२", "content_sanskrit": "वायुरुवाच ।\nशैवो हि परमो धर्मः श्रेष्ठानुष्ठानशब्दितः ।\nयत्रापरोक्षो लक्ष्येत साक्षान्मोक्षप्रदः शिवः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001459002, "chapter_id": 21459, "verse_number": "७-१-३२-३", "content_sanskrit": "स तु पञ्चविधो ज्ञेयः पञ्चभिः पर्वभिः क्रमात् ।\nक्रियातपोजपध्यानज्ञानात्मभिरनुत्तरैः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001459003, "chapter_id": 21459, "verse_number": "७-१-३२-४", "content_sanskrit": "तैरेव सोत्तरैस्सिद्धो धर्मस्तु परमो मतः ।\nपरोक्षमपरोक्षं च ज्ञानं यत्र च मोक्षदम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001459004, "chapter_id": 21459, "verse_number": "७-१-३२-५", "content_sanskrit": "परमो ऽपरमश्चोभौ धर्मौ हि श्रुतिचोदितौ ।\nधर्मशब्दाभिधेयेर्थे प्रमाणं श्रुतिरेव नः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001459005, "chapter_id": 21459, "verse_number": "७-१-३२-६", "content_sanskrit": "परमो योगपर्यन्तो धर्मः श्रुतिशिरोगतः ।\nधर्मस्त्वपरमस्तद्वदधः श्रुतिमुखोत्थितः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001459006, "chapter_id": 21459, "verse_number": "७-१-३२-७", "content_sanskrit": "अपश्वात्माधिकारत्वाद्यो धरमः परमो मतः ।\nसाधारणस्ततो ऽन्यस्तु सर्वेषामधिकारतः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001459007, "chapter_id": 21459, "verse_number": "७-१-३२-८", "content_sanskrit": "स चायं परमो धर्मः परधर्मस्य साधनम् ।\nधर्मशास्त्रादिभिस्सम्यक्सांग एवोपबृंहितः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001459008, "chapter_id": 21459, "verse_number": "७-१-३२-९", "content_sanskrit": "शैवो यः परमो धर्मः श्रेष्ठानुष्ठानशब्दितः ।\nइतिहासपुराणाभ्यां कथंचिदुपबृंहितः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001459009, "chapter_id": 21459, "verse_number": "७-१-३२-१०", "content_sanskrit": "शैवागमैस्तु संपन्नः सहांगोपांविस्तरः ।\nतत्संस्काराधिकारैश्च सम्यगेवोपबृंहितः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001459010, "chapter_id": 21459, "verse_number": "७-१-३२-११", "content_sanskrit": "शैवागमो हि द्विविधः श्रौतो ऽश्रौतश्च संस्कृतः ।\nश्रुतिसारमयः श्रौतस्स्वतंत्र इतरो मतः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001459011, "chapter_id": 21459, "verse_number": "७-१-३२-१२", "content_sanskrit": "स्वतंत्रो दशधा पूर्वं तथाष्टादशधा पुनः ।\nकामिकादिसमाख्याभिस्सिद्धः सिद्धान्तसंज्ञितः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001459012, "chapter_id": 21459, "verse_number": "७-१-३२-१३", "content_sanskrit": "श्रुतिसारमयो यस्तु शतकोटिप्रविस्तरः ।\nपरं पाशुपतं यत्र व्रतं ज्ञानं च कथ्यते॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001459013, "chapter_id": 21459, "verse_number": "७-१-३२-१४", "content_sanskrit": "युगावर्तेषु शिष्येत योगाचार्यस्वरूपिणा ।\nतत्रतत्रावतीर्णेन शिवेनैव प्रवर्त्यते॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001459014, "chapter_id": 21459, "verse_number": "७-१-३२-१५", "content_sanskrit": "संक्षिप्यास्य प्रवक्तारश्चत्वारः परमर्षय ।\nरुरुर्दधीचो ऽगस्त्यश्च उपमन्युर्महायशाः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001459015, "chapter_id": 21459, "verse_number": "७-१-३२-१६", "content_sanskrit": "ते च पाशुपता ज्ञेयास्संहितानां प्रवर्तकाः ।\nतत्संततीया गुरवः शतशो ऽथ सहस्रशः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001459016, "chapter_id": 21459, "verse_number": "७-१-३२-१७", "content_sanskrit": "तत्रोक्तः परमो धर्मश्चर्याद्यात्मा चतुर्विधः ।\nतेषु पाशुपतो योगः शिवं प्रत्यक्षयेद्दृढम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001459017, "chapter_id": 21459, "verse_number": "७-१-३२-१८", "content_sanskrit": "तस्माच्छ्रेष्ठमनुष्ठानं योगः पाशुपतो मतः ।\nतत्राप्युपायको युक्तो ब्रह्मणा स तु कथ्यते॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001459018, "chapter_id": 21459, "verse_number": "७-१-३२-१९", "content_sanskrit": "नामाष्टकमयो योगश्शिवेन परिकल्पितः ।\nतेन योगेन सहसा शैवी प्रज्ञा प्रजायते॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001459019, "chapter_id": 21459, "verse_number": "७-१-३२-२०", "content_sanskrit": "प्रज्ञया परमं ज्ञानमचिराल्लभते स्थिरम् ।\nप्रसीदति शिवस्तस्य यस्य ज्ञानं प्रतिष्ठितम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001459020, "chapter_id": 21459, "verse_number": "७-१-३२-२१", "content_sanskrit": "प्रसादात्परमो योगो यः शिवं चापरोक्षयेत् ।\nशिवापरोक्षात्संसारकारणेन वियुज्यते॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001459021, "chapter_id": 21459, "verse_number": "७-१-३२-२२", "content_sanskrit": "ततः स्यान्मुक्तसंसारो मुक्तः शिवसमो भवेत् ।\nब्रह्मप्रोक्त इत्युपायः स एव पृथगुच्यते॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001459022, "chapter_id": 21459, "verse_number": "७-१-३२-२३", "content_sanskrit": "शिवो महेश्वरश्चैव रुद्रो विष्णुः पितामहः ।\nसंसारवैद्यः सर्वज्ञः परमात्मेति मुख्यतः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001459023, "chapter_id": 21459, "verse_number": "७-१-३२-२४", "content_sanskrit": "नामाष्टकमिदं मुख्यं शिवस्य प्रतिपादकम् ।\nआद्यन्तु पञ्चकं ज्ञेयं शान्त्यतीताद्यनुक्रमात्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001459024, "chapter_id": 21459, "verse_number": "७-१-३२-२५", "content_sanskrit": "संज्ञा सदाशिवादीनां पञ्चोपाधिपरिग्रहात् ।\nउपाधिविनिवृत्तौ तु यथास्वं विनिवर्तते॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001459025, "chapter_id": 21459, "verse_number": "७-१-३२-२६", "content_sanskrit": "पदमेव हि तन्नित्यमनित्याः पदिनः स्मृताः ।\nपदानां प्रतिकृत्तौ तु मुच्यन्ते पदिनो यतः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001459026, "chapter_id": 21459, "verse_number": "७-१-३२-२७", "content_sanskrit": "परिवृत्त्यन्तरे भूयस्तत्पदप्राप्तिरुच्यते ।\nआत्मान्तराभिधानं स्याद्यदाद्यं नाम पञ्चकम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001459027, "chapter_id": 21459, "verse_number": "७-१-३२-२८", "content_sanskrit": "अन्यत्तु त्रितयं नाम्नामुपादानादियोगतः ।\nत्रिविधोपाधिवचनाच्छिव एवानुवर्तते॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001459028, "chapter_id": 21459, "verse_number": "७-१-३२-२९", "content_sanskrit": "अनादिमलसंश्लेषः प्रागभावात्स्वभावतः ।\nअत्यंतं परिशुद्धात्मेत्यतो ऽयं शिव उच्यते॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001459029, "chapter_id": 21459, "verse_number": "७-१-३२-३०", "content_sanskrit": "अथवाशेषकल्याणगुणैकधन ईश्वरः ।\nशिव इत्युच्यते सद्भिश्शिवतत्त्वार्थवादिभिः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001459030, "chapter_id": 21459, "verse_number": "७-१-३२-३१", "content_sanskrit": "त्रयोविंशतितत्त्वेभ्यः प्रकृतिर्हि परा मता ।\nप्रकृतेस्तु परं प्राहुः पुरुषं पञ्चविंशकम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001459031, "chapter_id": 21459, "verse_number": "७-१-३२-३२", "content_sanskrit": "यं वेदादौ स्वरं प्राहुर्वाच्यवाचकभावतः ।\nवेदैकवेद्ययाथात्म्याद्वेदान्ते च प्रतिष्ठितः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001459032, "chapter_id": 21459, "verse_number": "७-१-३२-३३", "content_sanskrit": "तस्य प्रकृतिलीनस्य यः परस्स महेश्वरः ।\nतदधीनप्रवृत्तित्वात्प्रकृतेः पुरुषस्य च॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001459033, "chapter_id": 21459, "verse_number": "७-१-३२-३४", "content_sanskrit": "अथवा त्रिगुणं तत्त्वमुपेयमिदमव्ययम् ।\nमायान्तु प्रकृतिं विद्यान्मायिनं तु महेश्वरम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001459034, "chapter_id": 21459, "verse_number": "७-१-३२-३५", "content_sanskrit": "मायाविक्षोभको ऽनंतो महेश्वरसमन्वयात् ।\nकालात्मा परमात्मादिः स्थूलः सूक्ष्मः प्रकीर्तितः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001459035, "chapter_id": 21459, "verse_number": "७-१-३२-३६", "content_sanskrit": "रुद्दुःखं दुःखहेतुर्वा तद्रावयति नः प्रभुः ।\nरुद्र इत्युच्यते सद्भिः शिवः परमकारणम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001459036, "chapter_id": 21459, "verse_number": "७-१-३२-३७", "content_sanskrit": "तत्त्वादिभूतपर्यन्तं शरीरादिष्वतन्द्रितः ।\nव्याप्याधितिष्ठति शिवस्ततो रुद्र इतस्ततः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001459037, "chapter_id": 21459, "verse_number": "७-१-३२-३८", "content_sanskrit": "जगतः पितृभूतानां शिवो मूर्त्यात्मनामपि ।\nपितृभावेन सर्वेषां पितामह उदीरितः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001459038, "chapter_id": 21459, "verse_number": "७-१-३२-३९", "content_sanskrit": "निदानज्ञो यथा वैद्यो रोगस्य विनिवर्तकः ।\nउपायैर्भेषजैस्तद्वल्लयभोगाधिकारतः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001459039, "chapter_id": 21459, "verse_number": "७-१-३२-४०", "content_sanskrit": "संसारस्येश्वरो नित्यं समूलस्य निवर्तकः ।\nसंसारवैद्य इत्युक्तः सर्वतत्त्वार्थवेदिभिः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001459040, "chapter_id": 21459, "verse_number": "७-१-३२-४१", "content_sanskrit": "दशार्थज्ञानसिद्ध्यर्थमिन्द्रियेष्वेषु सत्स्वपि ।\nत्रिकालभाविनो भावान्स्थूलान्सूक्ष्मानशेषतः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001459041, "chapter_id": 21459, "verse_number": "७-१-३२-४२", "content_sanskrit": "अणवो नैव जानन्ति माययैव मलावृताः ।\nअसत्स्वपि च सर्वेषु सर्वार्थज्ञानहेतुषु॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001459042, "chapter_id": 21459, "verse_number": "७-१-३२-४३", "content_sanskrit": "यद्यथावस्थितं वस्तु तत्तथैव सदाशिवः ।\nअयत्नेनैव जानाति तस्मात्सर्वज्ञ उच्यते॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001459043, "chapter_id": 21459, "verse_number": "७-१-३२-४४", "content_sanskrit": "सर्वात्मा परमैरेभिर्गुणैर्नित्यसमन्वयात् ।\nस्वस्मात्परात्मविरहात्परमात्मा शिवः स्वयम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001459044, "chapter_id": 21459, "verse_number": "७-१-३२-४५", "content_sanskrit": "नामाष्टकमिदं चैव लब्ध्वाचार्यप्रसादतः ।\nनिवृत्त्यादिकलाग्रन्थिं शिवाद्यैः पञ्चनामभिः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001459045, "chapter_id": 21459, "verse_number": "७-१-३२-४६", "content_sanskrit": "यथास्वं क्रमशश्छित्वा शोधयित्वा यथागुणम् ।\nगुणितैरेव सोद्धातैरनिरुद्धैरथापि वा॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001459046, "chapter_id": 21459, "verse_number": "७-१-३२-४७", "content_sanskrit": "हृत्कण्ठतालुभ्रूमध्यब्रह्मरन्ध्रसमन्विताम् ।\nछित्त्वा पर्यष्टकाकारं स्वात्मानं च सुषुम्णया॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001459047, "chapter_id": 21459, "verse_number": "७-१-३२-४८", "content_sanskrit": "द्वादशांतःस्थितस्येन्दोर्नीत्वोपरि शिवौजसि ।\nसंहृत्यं वदनं पश्चाद्यथासंस्करणं लयात्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001459048, "chapter_id": 21459, "verse_number": "७-१-३२-४९", "content_sanskrit": "शाक्तेनामृतवर्षेण संसिक्तायां तनौ पुनः ।\nअवतार्य स्वमात्मानममृतात्माकृतिं हृदि॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001459049, "chapter_id": 21459, "verse_number": "७-१-३२-५०", "content_sanskrit": "द्वादशांतःस्थितस्येन्दोः परस्ताच्छ्वेतपंकजे ।\nसमासीनं महादेवं शंकरम्भक्तवत्सलम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001459050, "chapter_id": 21459, "verse_number": "७-१-३२-५१", "content_sanskrit": "अर्धनारीश्वरं देवं निर्मलं मधुराकृतिम् ।\nशुद्धस्फटिकसंकाशं प्रसन्नं शीतलद्युतिम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001459051, "chapter_id": 21459, "verse_number": "७-१-३२-५२", "content_sanskrit": "ध्यात्वा हि मानसे देवं स्वस्थचित्तो ऽथ मानवः ।\nशिवनामाष्टकेनैव भावपुष्पैस्समर्चयेत्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001459052, "chapter_id": 21459, "verse_number": "७-१-३२-५३", "content_sanskrit": "अभ्यर्चनान्ते तु पुनः प्राणानायम्य मानवः ।\nसम्यक्चित्तं समाधाय शार्वं नामाष्टकं जपेत्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001459053, "chapter_id": 21459, "verse_number": "७-१-३२-५४", "content_sanskrit": "नाभौ चाष्टाहुतीर्हुत्वा पूर्णाहुत्या नमस्ततः ।\nअष्टपुष्पप्रदानेन कृत्वाभ्यर्चनमंतिमम्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001459054, "chapter_id": 21459, "verse_number": "७-१-३२-५५", "content_sanskrit": "निवेदयेत्स्वमात्मानं चुलुकोदकवर्त्मना ।\nएवं कृत्वा चिरादेव ज्ञानं पाशुपतं शुभम्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001459055, "chapter_id": 21459, "verse_number": "७-१-३२-५६", "content_sanskrit": "लभते तत्प्रतिष्ठां च वृत्तं चानुत्तमं तथा ।\nयोगं च परमं लब्ध्वा मुच्यते नात्र संशयः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]