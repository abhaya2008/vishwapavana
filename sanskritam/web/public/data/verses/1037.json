[{"id": 2001922, "chapter_id": 1037, "verse_number": "१-३८-०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2001923, "chapter_id": 1037, "verse_number": "१-३८-१", "content_sanskrit": "सर्पाणां तु वचः श्रुत्वा सर्वेषामिति चेति च।\nवासुकेश्च वचः श्रुत्वा एलापत्रोऽब्रवीदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2001924, "chapter_id": 1037, "verse_number": "१-३८-२", "content_sanskrit": "प्रागेव दर्शिता बुद्धिर्मयैषा भुजगोत्तमाः।\nहेयेति यदि वो बुद्धिस्तवापि च तथा प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2001925, "chapter_id": 1037, "verse_number": "१-३८-३", "content_sanskrit": "अस्तु कामं मभाद्यापि बुद्धिः स्मरणमागता।\nतां शृणुध्वं प्रवक्ष्यामि याथातथ्येन पन्नगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2001926, "chapter_id": 1037, "verse_number": "१-३८-४", "content_sanskrit": "न स यज्ञो न भविता न स राजा तथाविधः।\nजनमेजयः पाण्डवेयो यतोऽस्माकं महद्भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2001927, "chapter_id": 1037, "verse_number": "१-३८-५", "content_sanskrit": "दैवेनोपहतो राजन्यो भवेदिह पूरुषः।\nस दैवमेवाश्रयेत नान्यत्तत्र परायणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2001928, "chapter_id": 1037, "verse_number": "१-३८-६", "content_sanskrit": "तदिदं चैवमस्माकं भयं पन्नगसत्तमाः।\nदैवमेवाश्रयामोऽत्र शृणुध्वं च वचो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2001929, "chapter_id": 1037, "verse_number": "१-३८-७", "content_sanskrit": "अहं शापे समुत्सृष्टे समश्रौषं वचस्तदा।\nमातुरुत्सङ्गमारूढो भयात्पन्नगसत्तमाः।\nदेवानां पन्नगश्रेष्ठास्तीक्ष्णास्तीक्ष्ण इति प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2001930, "chapter_id": 1037, "verse_number": "१-३८-८", "content_sanskrit": "शापदुःखाग्नितप्तानां पन्नगानामनामयम्।\nकृपया परयाऽऽविष्टाः प्रार्थयन्तो दिवौकसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2001931, "chapter_id": 1037, "verse_number": "१-३८-९x", "content_sanskrit": "देवा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2001932, "chapter_id": 1037, "verse_number": "१-३८-९", "content_sanskrit": "का हि लब्ध्वा प्रियान्पुत्राञ्शपेदेवं पितामह।\nऋते कद्रूं तीक्ष्णरूपां देवदेव तवाग्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2001933, "chapter_id": 1037, "verse_number": "१-३८-१०", "content_sanskrit": "तथेति च वचस्तस्यास्त्वयाप्युक्तं पितामह।\nइच्छाम एतद्विज्ञातुं कारणं यन्न वारिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2001934, "chapter_id": 1037, "verse_number": "१-३८-११x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2001935, "chapter_id": 1037, "verse_number": "१-३८-११", "content_sanskrit": "बहवः पन्नगास्तीक्ष्णा घोररूपा विषोल्बणाः।\nप्रजानां हितकामोऽहं न च वारितवांस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2001936, "chapter_id": 1037, "verse_number": "१-३८-१२", "content_sanskrit": "ये दन्दशूकाः क्षुद्राश्च पापाचारा विषोल्बणाः।\nतेषां विनाशो भविता न तु ये धर्मचारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2001937, "chapter_id": 1037, "verse_number": "१-३८-१३", "content_sanskrit": "यन्निमित्तं च भविता मोक्षस्तेषां महाभयात्।\nपन्नगानां निबोधध्वं तस्मिन्काले समागते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2001938, "chapter_id": 1037, "verse_number": "१-३८-१४", "content_sanskrit": "यायावरकुले धीमान्भविष्यति महानृषिः।\nजरत्कारुरिति ख्यातस्तपस्वी नियतेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2001939, "chapter_id": 1037, "verse_number": "१-३८-१५", "content_sanskrit": "तस्य पुत्रो जरत्कारोर्भविष्यति तपोधनः।\nआस्तीको नाम यज्ञं स प्रतिषेत्स्यति तं तदा।\nतत्र मोक्ष्यन्ति भुजगा ये भविष्यन्ति धार्मिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2001940, "chapter_id": 1037, "verse_number": "१-३८-१६x", "content_sanskrit": "देवा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2001941, "chapter_id": 1037, "verse_number": "१-३८-१६", "content_sanskrit": "स मुनिप्रवरो ब्रह्मञ्जरत्कारुर्महातपाः।\nकस्यां पुत्रं महात्मानं जनयिष्यति वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2001942, "chapter_id": 1037, "verse_number": "१-३८-१७x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2001943, "chapter_id": 1037, "verse_number": "१-३८-१७", "content_sanskrit": "वासुकेर्भगिनी कन्या समुत्पन्ना सुशोभना।\nतस्मै दास्यति तां कन्यां वासुकिर्भुजगोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2001944, "chapter_id": 1037, "verse_number": "१-३८-१८", "content_sanskrit": "तस्यां जनयिता पुत्रं वेदवेदाङ्गपारगम्।\nसनामायां सनामा स कन्यायां द्विजसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2001945, "chapter_id": 1037, "verse_number": "१-३८-१९x", "content_sanskrit": "एलापत्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2001946, "chapter_id": 1037, "verse_number": "१-३८-१९", "content_sanskrit": "एवमस्त्विति तं देवाः पितामहमथाब्रुवन्।\nउत्क्वैवं वचनं देवान्विरिञ्चिस्त्रिदिवं ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2001947, "chapter_id": 1037, "verse_number": "१-३८-२०", "content_sanskrit": "सोऽहमेवं प्रपश्यामि वासुके भगिनी तव।\nजरत्कारुरिति ख्याता तां तस्मै प्रतिपादय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2001948, "chapter_id": 1037, "verse_number": "१-३८-२१", "content_sanskrit": "भैक्षवद्भिक्षमाणाय नागानां भयशान्तये।\nऋषये सुव्रतायैनामेष मोक्षः श्रुतो मया॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2001949, "chapter_id": 1037, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि अष्टत्रिंशोऽध्यायः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]