[{"id": 2146058, "chapter_id": 4150, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2146059, "chapter_id": 4150, "verse_number": "१", "content_sanskrit": "कुरूणामिह सर्वेषां भवान् सुहृदनुत्तमः ।\nसम्बन्धी दयितो नित्यमुभयोः पक्षयोरपि\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2146060, "chapter_id": 4150, "verse_number": "२", "content_sanskrit": "पाण्डवैर्धार्तराष्ट्राणां प्रतिपाद्यमनामयम् ।\nसमर्थः प्रशमं चैषां कर्तुमर्हसि केशव\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2146061, "chapter_id": 4150, "verse_number": "३", "content_sanskrit": "त्वमितः पुण्डरीकाक्ष सुयोधनममर्षणम् ।\nशान्त्यर्थं भ्रातरं ब्रूया यद्वाच्यमिह शत्रुहन्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2146062, "chapter_id": 4150, "verse_number": "", "content_sanskrit": "त्वया धर्मार्थयुक्तं चेदुक्तं शिवमनामयम् ।\nहितं नादास्यते बालो दिष्टस्य वशमेष्यति ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2146063, "chapter_id": 4150, "verse_number": "४", "content_sanskrit": "धर्म्यमस्मद्धितं चैव कुरूणां यदनामयम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2146064, "chapter_id": 4150, "verse_number": "", "content_sanskrit": "श्रीवासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2146065, "chapter_id": 4150, "verse_number": "५", "content_sanskrit": "एष यास्यामि राजानं धृतराष्ट्रमभीप्सया\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2146066, "chapter_id": 4150, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2146067, "chapter_id": 4150, "verse_number": "६", "content_sanskrit": "ततो व्यपेते तमसि सूर्ये विमल उद्गते ।\nमैत्रे मुहूर्ते सम्प्राप्ते ऋद्धार्चिषि दिवाकरे\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2146068, "chapter_id": 4150, "verse_number": "७", "content_sanskrit": "कौमुदे मासि रेवत्यां शरदन्ते हिमागते ।\nस्फीतसस्यमुखे काले कल्यः सत्ववतां वरः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2146069, "chapter_id": 4150, "verse_number": "८", "content_sanskrit": "मङ्गल्याः पुण्यनिर्घोषा वाचः शृण्वंश्च सूनृताः ।\nब्राह्मणानां प्रतीतानामृषीणामिव वासवः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2146070, "chapter_id": 4150, "verse_number": "९", "content_sanskrit": "कृत्वा पौर्वाह्णिकं कृत्यं स्नातः शुचिरलङ्कृतः ।\nउपतस्थे विवस्वन्तं पावकं च जनार्दनः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2146071, "chapter_id": 4150, "verse_number": "१०", "content_sanskrit": "वृषभं पृष्ठ आलभ्य ब्राह्मणानभिवाद्य च ।\nअग्निं प्रदक्षिणं कृत्वा पश्यन् कल्याणमग्रतः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2146072, "chapter_id": 4150, "verse_number": "११", "content_sanskrit": "तत् प्रतिज्ञाय वचनं पाण्डवस्य जनार्दनः ।\nशिनेर्नप्तारमासीनमभ्यभाषत सात्यकिम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2146073, "chapter_id": 4150, "verse_number": "१२", "content_sanskrit": "रथ आरोप्यतां शङ्खश्चक्रं च गदया सह ।\nउपासङ्गाश्च शक्त्यश्च सर्वप्रहरणानि च\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2146074, "chapter_id": 4150, "verse_number": "१३", "content_sanskrit": "दुर्योधनो हि दुष्टात्मा कर्णश्च सहसौबलः ।\nन च शत्रुरवज्ञेयो दुर्बलोऽपि बलीयसा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2146075, "chapter_id": 4150, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2146076, "chapter_id": 4150, "verse_number": "१४", "content_sanskrit": "ततस्तन्मतमाज्ञाय केशवस्य पुरस्सराः ।\nप्रसस्रुर्योजयिष्यन्तो रथं चक्रगदाभृतः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2146077, "chapter_id": 4150, "verse_number": "१५", "content_sanskrit": "तं दीप्तमिव कालाग्निमाकाशगमिवाध्वगम् ।\nसूर्यचन्द्रप्रकाशाभ्यां चक्राभ्यां समलङ्कृतम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2146078, "chapter_id": 4150, "verse_number": "१६", "content_sanskrit": "अर्धचन्द्रैश्च चन्द्रैश्च मत्स्यैश्च मृगपक्षिभिः ।\nपुष्पैश्च विविधैश्चित्रैर्मणिरत्नैश्च सर्वशः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2146079, "chapter_id": 4150, "verse_number": "१७", "content_sanskrit": "तरुणादित्यसङ्काशं बृहन्तं चारुदर्शनम् ।\nमणिहेमविचित्राङ्गं सुध्वजं सुपताकिनम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2146080, "chapter_id": 4150, "verse_number": "१८", "content_sanskrit": "सूपस्करमनाधृष्यं वैयाघ्रपरिवारणम् ।\nयशोघ्नं प्रत्यमित्राणां बन्धूनां नन्दिवर्धनम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2146081, "chapter_id": 4150, "verse_number": "१९", "content_sanskrit": "वाजिभिः सैन्यसुग्रीवमेघपुष्पबलाहकैः ।\nसूतः सम्पादयाञ्चक्रे सम्पन्नैः सर्वसम्पदा\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2146082, "chapter_id": 4150, "verse_number": "२०", "content_sanskrit": "महिमानं च कृष्णस्य भूय एवाभिवर्धयन् ।\nसुघोषः पतगेन्द्रेण ध्वजेन युयुजे रथः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2146083, "chapter_id": 4150, "verse_number": "२१", "content_sanskrit": "तं मेरुशिखरप्रख्यं मेघदुन्दुभिनिस्वनम् ।\nआरुरोह रथं शौरिर्विमानमिव पुण्यकृत्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2146084, "chapter_id": 4150, "verse_number": "२२", "content_sanskrit": "ततः सात्यकिमारोप्य प्रययौ पुरुषोत्तमः ।\nपृथिवीं चान्तरिक्षं च रथघोषेण नादयन्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2146085, "chapter_id": 4150, "verse_number": "२३", "content_sanskrit": "व्यपेताभ्रघनः कालः क्षणेन समजायत ।\nशिवश्चानुववौ वायुः प्रशान्तमभवद् रजः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2146086, "chapter_id": 4150, "verse_number": "२४", "content_sanskrit": "प्रदक्षिणानुलोमाश्च मङ्गल्या मृगपक्षिणः ।\nप्रयाणे वासुदेवस्य बभूवुरनुयायिनः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2146087, "chapter_id": 4150, "verse_number": "२५", "content_sanskrit": "मङ्गल्यार्थप्रदैः शब्दैरन्ववर्तन्त सर्वशः ।\nसारसाः शतपत्राश्च हंसाश्च मधुसूदनम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2146088, "chapter_id": 4150, "verse_number": "२६", "content_sanskrit": "मन्त्राहुतिमहाहोमैर्हूयमानश्च पावकः ।\nप्रदक्षिणशिखो भूत्वा विधूमः समपद्यत\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2146089, "chapter_id": 4150, "verse_number": "२७", "content_sanskrit": "वसिष्ठो वामदेवश्च भूरिद्युम्नो गयः क्रथः ।\nशुकनारदवाल्मीका मरुत्तः कुशिको भृगुः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2146090, "chapter_id": 4150, "verse_number": "२८", "content_sanskrit": "देवब्रह्मर्षयश्चैव कृष्णं यदुसुखावहम् ।\nप्रदक्षिणमवर्तन्त सहिता वासवानुजम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2146091, "chapter_id": 4150, "verse_number": "२९", "content_sanskrit": "एवमेतैर्महाभागैर्महर्षिगणसाधुभिः ।\nपूजितः प्रययौ कृष्णः कुरूणां सदनं प्रति\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2146092, "chapter_id": 4150, "verse_number": "३०", "content_sanskrit": "देवताभ्यो नमस्कृत्य ब्राह्मणान् स्वस्तिवाच्य च ।\nप्रययौ पुण्डरीकाक्षः सात्यकेन सहाच्युतः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2146093, "chapter_id": 4150, "verse_number": "३१", "content_sanskrit": "तं प्रयान्तमनुप्रायात् कुन्तीपुत्रो युधिष्ठिरः ।\nभीमसेनार्जुनौ चोभौ माद्रीपुत्रौ च पाण्डवौ\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2146094, "chapter_id": 4150, "verse_number": "३२", "content_sanskrit": "चेकितानश्च विक्रान्तो धृष्टकेतुश्च चेदिपः ।\nद्रुपदः काशिराजश्च शिखण्डी च महारथः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2146095, "chapter_id": 4150, "verse_number": "३३", "content_sanskrit": "धृष्टद्युम्नः सपुत्रश्च विराटः केकयैः सह ।\nसंसाधनार्थं प्रययुः क्षत्रियाः क्षत्रियर्षभम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2146096, "chapter_id": 4150, "verse_number": "३४", "content_sanskrit": "ततोऽनुव्रज्य गोविन्दं धर्मराजो युधिष्ठिरः ।\nराज्ञां सकाशे द्युतिमानुवाचेदं वचस्तदा\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2146097, "chapter_id": 4150, "verse_number": "३५", "content_sanskrit": "यो वै न कामान्न भयान्न लोभान्नार्थकारणात् ।\nअन्यायमनुवर्तेत स्थिरबुद्धिरलोलुपः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2146098, "chapter_id": 4150, "verse_number": "३६", "content_sanskrit": "धर्मज्ञो धृतिमान् प्राज्ञः सर्वभूतेषु केशवः ।\nईश्वरः सर्वभूतानां देवदेवः प्रतापवान्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2146099, "chapter_id": 4150, "verse_number": "३७", "content_sanskrit": "तं सर्वगुणसम्पन्नं श्रीवत्सकृतलक्षणम् ।\nसम्परिष्वज्य गोविन्दं सन्देष्टुमुपचक्रमे\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2146100, "chapter_id": 4150, "verse_number": "३८", "content_sanskrit": "या सा बाल्यात् प्रभृत्यस्मान् पर्यवर्धयताबला ।\nउपवासतपःशीला गुरूणां पूजने रता\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2146101, "chapter_id": 4150, "verse_number": "३९", "content_sanskrit": "देवतातिथिपूजासु भृत्यानां पोषणे रता ।\nवत्सला प्रियपुत्रा च माताऽस्माकं जनार्दन\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2146102, "chapter_id": 4150, "verse_number": "४०", "content_sanskrit": "सुयोधनभयाद्या नः स्थापिताऽमित्रकर्शन ।\nमहतो मृत्युसम्बाधाद् दुस्तरान्नौरिवार्णवात्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2146103, "chapter_id": 4150, "verse_number": "४१", "content_sanskrit": "अस्मत्कृते च सततं यया दुःखानि माधव ।\nअनुभूतान्यदुःखार्हां तां स्म पृच्छेरनामयम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2146104, "chapter_id": 4150, "verse_number": "४२", "content_sanskrit": "भृशमाश्वासयेश्चैनां पुत्रशोकपरिप्लुताम् ।\nअभिवाद्य स्वजेथास्त्वं पाण्डवान् परिकीर्तयन्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2146105, "chapter_id": 4150, "verse_number": "४३", "content_sanskrit": "ऊढात्प्रभृति दुःखानि स्वसुतानामरिन्दम ।\nनिकारानतदर्हा च पश्यन्ती दुःखमश्नुते\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2146106, "chapter_id": 4150, "verse_number": "४४", "content_sanskrit": "अपि जातु स कालः स्यात् कृष्णाहं भृशदुःखिताम् ।\nयदेनां मातरं क्लिष्टां सुखे दध्यामरिन्दम\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2146107, "chapter_id": 4150, "verse_number": "४५", "content_sanskrit": "प्रव्रजत्यन्वधावत् सा कृपणा पुत्रगर्धिनी ।\nरुदतीमपहायैनामगच्छामैव यद्वनम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2146108, "chapter_id": 4150, "verse_number": "४६", "content_sanskrit": "सा नूनं म्रियते दुःखैः सा चेज्जीवति केशव ।\nपृथा पुत्राधिभिर्गाढमार्या माता च सत्कृता\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2146109, "chapter_id": 4150, "verse_number": "४७", "content_sanskrit": "अभिवाद्याऽथ सा कुन्ती त्वया मद्वचनाद् विभो ।\nसङ्क्षाम्याथ नमस्कार्या सर्वेषां वचनादपि\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2146110, "chapter_id": 4150, "verse_number": "४८", "content_sanskrit": "धृतराष्ट्रं च कौरव्यं राजानं च वयोधिकम् ।\nभीष्मं द्रोणं कृपं चैव महाराजं च बाह्लिकम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2146111, "chapter_id": 4150, "verse_number": "४९", "content_sanskrit": "द्रौणिं च सोमदत्तं च सर्वांश्च भरतान् प्रति ।\nयथावयो यथास्थानं पूजयस्व जनार्दन\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2146112, "chapter_id": 4150, "verse_number": "५०", "content_sanskrit": "विदुरं च महाप्राज्ञं कुरूणां मन्त्रधारिणम् ।\nअगाधबुद्धिं धर्मज्ञं स्वजेथा मधुसूदन\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2146113, "chapter_id": 4150, "verse_number": "५१", "content_sanskrit": "इत्युक्त्वा केशवं तत्र राज्ञां मध्ये युधिष्ठिरः ।\nअनुज्ञातो निववृते कृष्णं कृत्वा प्रदक्षिणम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2146114, "chapter_id": 4150, "verse_number": "५२", "content_sanskrit": "व्रजन्नेव तु बीभत्सुः सखायं पुरुषर्षभम् ।\nअब्रवीत् परवीरघ्नं दाशार्हमपराजितम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2146115, "chapter_id": 4150, "verse_number": "५३", "content_sanskrit": "यदस्माकं विभो वृत्तं पुरा वै मन्त्रनिश्चये ।\nअर्धराज्यस्य गोविन्द विदितं सर्वराजसु\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2146116, "chapter_id": 4150, "verse_number": "५४", "content_sanskrit": "तच्चेद् दद्युरसङ्गेन सत्कृत्यानवमत्य च ।\nप्रियं मे स्यान्महाबाहो मुच्येरन् महतो भयात्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2146117, "chapter_id": 4150, "verse_number": "५५", "content_sanskrit": "अतश्चेदन्यथा कर्ता धार्तराष्ट्रोऽनुपायवित् ।\nअन्तं नूनं करिष्यामि क्षत्रियाणां जनार्दन\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2146118, "chapter_id": 4150, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2146119, "chapter_id": 4150, "verse_number": "५६", "content_sanskrit": "एवमुक्ते पाण्डवेन समहृष्यद् वृकोदरः ।\nमुहुर्मुहुः क्रोधवशात् प्रावेपत च पाण्डवः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2146120, "chapter_id": 4150, "verse_number": "५७", "content_sanskrit": "वेपमानश्च कौन्तेयः प्राक्रोशन्महतो रवान् ।\nधनञ्जयवचः श्रुत्वा हर्षोत्सिक्तमना भृशम्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2146121, "chapter_id": 4150, "verse_number": "५८", "content_sanskrit": "तस्य तं निनदं श्रुत्वा सम्प्रावेपन्त धन्विनः ।\nवाहनानि च सर्वाणि शकृन्मूत्रे प्रसुस्रुवुः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2146122, "chapter_id": 4150, "verse_number": "५९", "content_sanskrit": "इत्युक्त्वा केशवं तत्र तथा चोक्त्वा विनिश्चयम् ।\nअनुज्ञातो निववृते परिष्वज्य जनार्दनम्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2146123, "chapter_id": 4150, "verse_number": "६०", "content_sanskrit": "तेषु राजसु सर्वेषु निवृत्तेषु जनार्दनः ।\nतूर्णमभ्यगमद् हृष्टः सैन्यसुग्रीववाहनः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2146124, "chapter_id": 4150, "verse_number": "६१", "content_sanskrit": "ते हया वासुदेवस्य दारुकेण प्रचोदिताः ।\nपन्थानमाचेमुरिव ग्रसमाना इवाम्बरम्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2146125, "chapter_id": 4150, "verse_number": "६२", "content_sanskrit": "अथापश्यन्महाबाहुः ऋषीनध्वनि केशवः ।\nब्राह्म्या श्रिया दीप्यमानान् स्थितानुभयतः पथि\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2146126, "chapter_id": 4150, "verse_number": "६३", "content_sanskrit": "सोऽवतीर्य रथात् तूर्णमभिवाद्य जनार्दनः ।\nयथावत् तानृषीन् सर्वान् अभ्यभाषत पूजयन्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2146127, "chapter_id": 4150, "verse_number": "६४", "content_sanskrit": "कच्चिल्लोकेषु कुशलं कच्चिद् धर्मः स्वनुष्ठितः ।\nब्राह्मणानां त्रयो वर्णाः कच्चित् तिष्ठन्ति शासने\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2146128, "chapter_id": 4150, "verse_number": "६५", "content_sanskrit": "पितृदेवातिथिभ्यश्च कच्चित् पूजा स्वनुष्ठिता\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2146129, "chapter_id": 4150, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2146130, "chapter_id": 4150, "verse_number": "६६", "content_sanskrit": "तेभ्यः प्रयुज्य तां पूजां प्रोवाच मधुसूदनः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2146131, "chapter_id": 4150, "verse_number": "६७", "content_sanskrit": "भगवन्तः क्व संसिद्धाः कोऽवधिर्भवतामिह ।\nकिं वा कार्यं भगवतामहं किं करवाणि वः\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2146132, "chapter_id": 4150, "verse_number": "६८", "content_sanskrit": "केनार्थेनोपसम्प्राप्ता भगवन्तो महीतळम्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2146133, "chapter_id": 4150, "verse_number": "६९", "content_sanskrit": "एवमुक्ताः केशवेन मुनयः संशितव्रताः ।\nनारदप्रमुखाः सर्वे प्रत्यनन्दन्त केशवम्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2146134, "chapter_id": 4150, "verse_number": "७०", "content_sanskrit": "अधःशिराः सर्पमाली महर्षिः स हि देवलः ।\nअर्वावसुः सुजानुश्च मैत्रेयः शुनको बली\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2146135, "chapter_id": 4150, "verse_number": "७१", "content_sanskrit": "बको दाल्भ्यः स्थूलशिराः कृष्णद्वैपायनस्तथा ।\nआयोदधौम्यो धौम्यश्च आणिमाण्डव्यकौशिकौ\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2146136, "chapter_id": 4150, "verse_number": "७२", "content_sanskrit": "दामोष्णीषस्त्रिषवणः पर्णादो घटजानुकः ।\nमौञ्जायनो वायुभक्षः पराशर्योऽथ शारिकः\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2146137, "chapter_id": 4150, "verse_number": "७३", "content_sanskrit": "शीलवानशनिर्धाता शून्यपालोऽकृतव्रणः ।\nश्वेतकेतुः कहोळश्च रामश्चैव महातपाः\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2146138, "chapter_id": 4150, "verse_number": "७४", "content_sanskrit": "तमब्रवीज्जामदग्न्य उपेत्य मधुसूदनम् ।\nपरिष्वज्य च गोविन्दं पुराणचरिते सखा\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2146139, "chapter_id": 4150, "verse_number": "७५", "content_sanskrit": "देवर्षयः पुण्यकृतो ब्राह्मणाश्च बहुश्रुताः ।\nराजर्षयश्च मानार्हं मानयन्ति तपस्विनः\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2146140, "chapter_id": 4150, "verse_number": "७६", "content_sanskrit": "देवासुरस्य द्रष्टारः पुराणाश्च महाद्युते ।\nसमेतं पार्थिवं क्षत्रं दिदृक्षन्तश्च सर्वशः\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2146141, "chapter_id": 4150, "verse_number": "७७", "content_sanskrit": "सभासदश्च राजानः त्वां च सत्यं जनार्दनम्\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2146142, "chapter_id": 4150, "verse_number": "७८", "content_sanskrit": "एतन्महत् प्रेक्षणीयं द्रष्टुं गच्छाम केशव ।\nधर्मार्थसहिता वाचः श्रोतुमिच्छाम माधव\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2146143, "chapter_id": 4150, "verse_number": "७९", "content_sanskrit": "त्वयोच्यमानाः कुरुषु राजमध्ये परन्तप\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2146144, "chapter_id": 4150, "verse_number": "८०", "content_sanskrit": "सभायां मधुरा वाचः शुश्रूषन्तस्त्वयेरिताः ।\nकुरूणां प्रतिपत्तिं च श्रोतुमिच्छाम माधव\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2146145, "chapter_id": 4150, "verse_number": "८१", "content_sanskrit": "भीष्मद्रोणादयश्चैव विदुरश्च महामतिः ।\nत्वं च यादवशार्दूल सभायां वै समेष्यथ\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2146146, "chapter_id": 4150, "verse_number": "८२", "content_sanskrit": "तव वाक्यानि सर्वाणि तथा तेषां च माधव ।\nश्रोतुमिच्छाम गोविन्द सत्यानि च शुभानि च\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2146147, "chapter_id": 4150, "verse_number": "८३", "content_sanskrit": "आपृष्टोऽसि महाबाहो पुनर्द्रक्ष्यामहे वयम्\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2146148, "chapter_id": 4150, "verse_number": "८४", "content_sanskrit": "याह्यविघ्नेन वै वीर द्रक्ष्यामस्त्वां सभागतम् ।\nआसीनमासने दिव्ये ज्वलन्तं तेजसाऽच्युत\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2146149, "chapter_id": 4150, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2146150, "chapter_id": 4150, "verse_number": "८५", "content_sanskrit": "प्रयान्तं देवकीपुत्रं परवीररुजो दश ।\nमहारथा महाबाहुमन्वयुः शस्त्रपाणयः\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2146151, "chapter_id": 4150, "verse_number": "८६", "content_sanskrit": "पदातीनां सहस्रं च सादिनां च परन्तप ।\nभोज्यं च विपुलं राजन् प्रेष्याश्च शतशोऽपरे\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2146152, "chapter_id": 4150, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि एकाशीतितमोऽध्यायः ॥८१॥\nभगवद्यानपर्वणि द्वादशोऽध्यायः ॥१२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}]