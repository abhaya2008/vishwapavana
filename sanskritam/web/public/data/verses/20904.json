[{"id": 7000904000, "chapter_id": 20904, "verse_number": "६-२४७-१", "content_sanskrit": "रुद्र उवाच ।\nहत्वाथ यवनं तत्र मुचुकुंदेन धीमता ।\nदत्त्वा तस्मै वरं मुक्तिं निष्क्रांतो यदुनंदनः ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000904001, "chapter_id": 20904, "verse_number": "६-२४७-२", "content_sanskrit": "हतं च यवनं श्रुत्वा जरासंधः सुदुर्मतिः ।\nययुधे रामकृष्णाभ्यां स्वबलेन समावृतः ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000904002, "chapter_id": 20904, "verse_number": "६-२४७-३", "content_sanskrit": "कृष्णेन निहतं सैन्यं सर्वं तस्य दुरात्मनः ।\nस पपात महीपृष्ठे मूर्च्छितो मगधाधिपः ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000904003, "chapter_id": 20904, "verse_number": "६-२४७-४", "content_sanskrit": "चिरेण लब्ध्वा संज्ञां तु विह्वलांगो भयातुरः ।\nन शशाक रणे योद्धुं रामेण मगधेश्वरः ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000904004, "chapter_id": 20904, "verse_number": "६-२४७-५", "content_sanskrit": "विमुखः प्राद्रवत्तूर्णं हतशेषबलानुगः ।\nअजेयाविति तौ मत्वा रामकृष्णौ महाबलौ ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000904005, "chapter_id": 20904, "verse_number": "६-२४७-६", "content_sanskrit": "तयोर्विरोधं त्यक्त्वाथ नगरीं स्वां विवेश ह ।\nअथ तौ वसुदेवस्य तनयौ सह सेनया ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000904006, "chapter_id": 20904, "verse_number": "६-२४७-७", "content_sanskrit": "मथुरां त्यज्य नगरीं प्रविष्टौ द्वारिकां पुरीम् ।\nइंद्रेण प्रेषितो वायुः सभां तत्र दिवौकसाम् ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000904007, "chapter_id": 20904, "verse_number": "६-२४७-८", "content_sanskrit": "कृष्णाय प्रददौ प्रीत्या निर्मितां विश्वकर्मणा ।\nवज्रवैडूर्यरचितां बह्वासनविचित्रिताम् ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000904008, "chapter_id": 20904, "verse_number": "६-२४७-९", "content_sanskrit": "नानारत्नमयैर्दिव्यैः स्वर्णच्छत्रैर्विराजिताम् ।\nतां प्राप्य रम्यां तु सभामुग्रसेनादयो नृपाः ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000904009, "chapter_id": 20904, "verse_number": "६-२४७-१०", "content_sanskrit": "मोदंते नैगमैः सार्द्धं दिवि देवगणा इव ।\nइक्ष्वाकुवंशसंभूतो रैवतो नाम पार्थिवः ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000904010, "chapter_id": 20904, "verse_number": "६-२४७-११", "content_sanskrit": "कन्यां दुहितरं स्वस्य सर्वलक्षणसंयुताम् ।\nरामाय प्रददौ प्रीत्या रेवती नाम नामतः ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000904011, "chapter_id": 20904, "verse_number": "६-२४७-१२", "content_sanskrit": "उपयेमे विधानेन स रामस्तां च रेवतीम् ।\nरमयामास च तया शच्या इव सुरेश्वरः ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000904012, "chapter_id": 20904, "verse_number": "६-२४७-१३", "content_sanskrit": "विदर्भराजो धर्मात्मा भीष्मको नाम धार्मिकः ।\nबभूवुस्तस्य पुत्रास्तु रुक्मप्रभृतयः शुभाः ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000904013, "chapter_id": 20904, "verse_number": "६-२४७-१४", "content_sanskrit": "तेषामवरजा कन्या रुक्मिणी वरवर्णिनी ।\nकमलांशेन संभूता सर्वलक्षणसंयुता ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000904014, "chapter_id": 20904, "verse_number": "६-२४७-१५", "content_sanskrit": "राघवत्वेभवत्सीता रुक्मिणी कृष्णजन्मनि ।\nअन्येष्वेवावतारेषु विष्णोरेषा सहायिनी ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000904015, "chapter_id": 20904, "verse_number": "६-२४७-१६", "content_sanskrit": "हिरण्यक हिरण्याक्षौ संभूतौ द्वापरे पुनः ।\nशिशुपालो दंतवक्त्र इति नाम समन्वितौ ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000904016, "chapter_id": 20904, "verse_number": "६-२४७-१७", "content_sanskrit": "चैद्यान्वये समुद्भूतौ महाबलपराक्रमौ ।\nरुक्मिणी शिशुपालाय दातुमैच्छत्तदात्मजः ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000904017, "chapter_id": 20904, "verse_number": "६-२४७-१८", "content_sanskrit": "तं नेच्छती पतिं सा तु शिशुपालं शुभानना ।\nबाल्यात्प्रभृति वै विष्णुमनुरक्ता दृढव्रता ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000904018, "chapter_id": 20904, "verse_number": "६-२४७-१९", "content_sanskrit": "उद्दिश्य कृष्णं भर्त्तारं सुराणामर्चनं सदा ।\nचकार रुक्मिणी कन्या दानानि विविधानि च ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000904019, "chapter_id": 20904, "verse_number": "६-२४७-२०", "content_sanskrit": "व्रतचर्यापराभूत्वा ध्यायंती पुरुषोत्तमम् ।\nआत्मेशं स्वस्य भर्तारमुवास पितृमंदिरे ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000904020, "chapter_id": 20904, "verse_number": "६-२४७-२१", "content_sanskrit": "कर्त्तुं तां शिशुपालाय विवाहं पार्थिवोत्तमः ।\nचकार यत्नं पुत्रेण रुक्मिणा सविधीमता ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000904021, "chapter_id": 20904, "verse_number": "६-२४७-२२", "content_sanskrit": "पुरोहितसुतं विप्रं प्रेषयामास रुक्मिणी ।\nउद्दिश्य कृष्णं भर्त्तारं स तूर्णं द्वारकां ययौ ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000904022, "chapter_id": 20904, "verse_number": "६-२४७-२३", "content_sanskrit": "समेत्य कृष्णं रामं च ताभ्यां विधिवदर्चितः ।\nएकांते सर्वमाचष्ट रुक्मिणीभाषितं तयोः ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000904023, "chapter_id": 20904, "verse_number": "६-२४७-२४", "content_sanskrit": "तच्छ्रुत्वा रामकृष्णौ तु तेन विप्रेण धीमता ।\nसर्वशस्त्रास्त्रसंपूर्णं रथमाकाशगं प्रभुः ॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000904024, "chapter_id": 20904, "verse_number": "६-२४७-२५", "content_sanskrit": "आरुह्य सूतमुख्येन दारुकेण महात्मना ।\nविदर्भनगरीं तूर्णं जग्मतुः पुरुषोत्तमौ ॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000904025, "chapter_id": 20904, "verse_number": "६-२४७-२६", "content_sanskrit": "राजानः सर्वराष्ट्रेभ्यो विवाहं द्रष्टुमागताः ।\nजरासंधमुखाः सर्वे शिशुपालस्य धीमतः ॥२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000904026, "chapter_id": 20904, "verse_number": "६-२४७-२७", "content_sanskrit": "तस्मिन्नुद्वाहसमये रुक्मिणी रुक्मभूषणा ।\nदुर्गां निःसृतार्चयितुं सखीभिर्नगराद्बहिः ॥२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000904027, "chapter_id": 20904, "verse_number": "६-२४७-२८", "content_sanskrit": "एतस्मिन्नेव काले तु संप्राप्तो देवकीसुतः ।\nरथस्थां तां च जग्राह बलवान्मधुसूदनः ॥२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000904028, "chapter_id": 20904, "verse_number": "६-२४७-२९", "content_sanskrit": "सहसा रथमारोप्य ययौ तूर्णं स्वमालयम् ।\nततः क्रोधसमाविष्टा जरासंधमुखा नृपाः ॥२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000904029, "chapter_id": 20904, "verse_number": "६-२४७-३०", "content_sanskrit": "रुक्मिणा राजपुत्रेण युद्धाय समुपस्थिताः ।\nअनुयाता हरिं क्रुद्धाश्चतुरंगबलान्विताः ॥३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000904030, "chapter_id": 20904, "verse_number": "६-२४७-३१", "content_sanskrit": "बलभद्रो महाबाहुरवरुह्य रथोत्तमात् ।\nलांगलं मुशलं गृह्य निजघान क्षणादरीन् ॥३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000904031, "chapter_id": 20904, "verse_number": "६-२४७-३२", "content_sanskrit": "रथानश्वान्महानागांस्तथा पादचरानपि ।\nलांगलमुशलाम्यां वै निजघान बलाद्रणे ॥३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000904032, "chapter_id": 20904, "verse_number": "६-२४७-३३", "content_sanskrit": "तस्य लांगलपातेन चूर्णिता रथपंक्तयः ।\nनागाश्च पतिता भूमौ वज्रेणेव महीधराः ॥३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000904033, "chapter_id": 20904, "verse_number": "६-२४७-३४", "content_sanskrit": "निर्भिन्नमस्तकाः सर्वे वमंतो रुधिरं बहु ।\nक्षणेनैव हतं सैन्यं बलरामेण वै तदा ॥३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000904034, "chapter_id": 20904, "verse_number": "६-२४७-३५", "content_sanskrit": "साश्वं सनागं सरथं सपदातिं महारणे ।\nसमंतात्समरे तत्र सुस्रुवुः शोणितापगाः ॥३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000904035, "chapter_id": 20904, "verse_number": "६-२४७-३६", "content_sanskrit": "प्रभग्नाः पार्थिवाः सर्वे दुद्रुवुर्भयपीडिताः ।\nकृष्णेन कदनं चक्रे रुक्मी क्रोधवशाद्बली ॥३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000904036, "chapter_id": 20904, "verse_number": "६-२४७-३७", "content_sanskrit": "धनुरुद्यम्य बाणौघैस्ताडयामास शार्ङ्गिणम् ।\nततः प्रहस्य गोविंदः शार्ङ्गमादाय लीलया ॥३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000904037, "chapter_id": 20904, "verse_number": "६-२४७-३८", "content_sanskrit": "जघानैकेनबाणेन रथाश्वांस्तस्य सारथिम् ।\nरथंध्वजं पताकां च चिच्छेद धरणीधरः ॥३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000904038, "chapter_id": 20904, "verse_number": "६-२४७-३९", "content_sanskrit": "विरथः खङ्गमादाय धरण्यां स उपस्थितः ।\nकृष्णस्तु खङ्गं चिच्छेद बाणेनैकेन वीर्यवान् ॥३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000904039, "chapter_id": 20904, "verse_number": "६-२४७-४०", "content_sanskrit": "ततः स मुष्टिमुद्यम्य कृष्णं वक्षस्यताडयत् ।\nतं जग्राह रणे वीरं निबध्य निबिडं हरिः ॥४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000904040, "chapter_id": 20904, "verse_number": "६-२४७-४१", "content_sanskrit": "तीक्ष्णं क्षुरप्रमादाय प्रहसन्मधुसूदनः ।\nशिरसो मुंडनं कृत्वा मुमोच च जनार्दनः ॥४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000904041, "chapter_id": 20904, "verse_number": "६-२४७-४२", "content_sanskrit": "स तु शोकसमाविष्टो निःश्वसन्नुरगो यथा ।\nआविवेश पुरं स्वीयं स तु तत्रैव चावसत् ॥४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]