[{"id": 2077999, "chapter_id": 2655, "verse_number": "१२-१६०-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2078000, "chapter_id": 2655, "verse_number": "१२-१६०-१", "content_sanskrit": "सत्यं धर्मं प्रशंसन्ति विप्रर्षिपितृदेवताः।\nसत्यमिच्छाम्यहं ज्ञातुं तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2078001, "chapter_id": 2655, "verse_number": "१२-१६०-२", "content_sanskrit": "सत्यं किंलक्षणं राजन्कथं वा तदवाप्यते।\nसत्यं प्राप्य भवेत्किंच कथं चैव तदुच्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2078002, "chapter_id": 2655, "verse_number": "१२-१६०-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2078003, "chapter_id": 2655, "verse_number": "१२-१६०-३", "content_sanskrit": "चातुर्वर्ण्यस्य धर्माणां संकरो न प्रशस्यते।\nधर्मः साधारणः सत्यं सर्ववर्णेषु भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2078004, "chapter_id": 2655, "verse_number": "१२-१६०-४", "content_sanskrit": "सत्यं सत्सु सदा धर्मः सत्यं धर्मः सनातनः।\nसत्यमेव नमस्येत सत्यं हि परमा गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2078005, "chapter_id": 2655, "verse_number": "१२-१६०-५", "content_sanskrit": "सत्यं धर्मस्तपोयोगः सत्यं ब्रह्म सनातनम्।\nसत्यं यज्ञः परः प्रोक्तः सर्वं सत्ये प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2078006, "chapter_id": 2655, "verse_number": "१२-१६०-६", "content_sanskrit": "रूपं यदिह सत्यस्य यथावदनुपूर्वशः।\nलक्षणं च प्रवक्ष्यामि सत्यस्येह पराक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2078007, "chapter_id": 2655, "verse_number": "१२-१६०-७", "content_sanskrit": "प्राप्यते च यथा सत्यं तच्च वेत्तुमिहार्हसि।\nसत्यं त्रयोदशावधं सर्वलोकेषु भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2078008, "chapter_id": 2655, "verse_number": "१२-१६०-८", "content_sanskrit": "सत्यं च समता चैव दमश्चैव न संशयः।\nअमात्सर्यं क्षमा चैव ह्रीस्तितिक्षाऽनसूयता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2078009, "chapter_id": 2655, "verse_number": "१२-१६०-९", "content_sanskrit": "त्यागो ध्यानमथार्यत्वं धृतिश्च सततं दया।\nअहिंसा चैव राजेन्द्र सत्याकारास्त्रयोदश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2078010, "chapter_id": 2655, "verse_number": "१२-१६०-१०", "content_sanskrit": "सत्यं नामाव्ययं नित्यमविकारि तथैव च।\nसर्वधर्माविरुद्धं च योगेनैतदवाप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2078011, "chapter_id": 2655, "verse_number": "१२-१६०-११", "content_sanskrit": "आत्मनीष्टे तथाऽनिष्टे रिपौ च समता तथा।\nइच्छाद्वेषं क्षयं प्राप्य कामक्रोधक्षयं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2078012, "chapter_id": 2655, "verse_number": "१२-१६०-१२", "content_sanskrit": "दमी नान्यस्पृहा नित्यं गाम्भीर्यं धैर्यमेव च।\nअशाठ्यं क्रोधदमनं ज्ञानेनैतदवाप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2078013, "chapter_id": 2655, "verse_number": "१२-१६०-१३", "content_sanskrit": "अमात्सर्यं बुधाः प्राहुर्दाने धर्मे च संयमः।\nअवस्थितेन नित्यं च सत्येनामत्सरी भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2078014, "chapter_id": 2655, "verse_number": "१२-१६०-१४", "content_sanskrit": "अक्षमायाः क्षमायाश्च प्रियाणीहाप्रियाणि च।\nक्षमते स तः साधुस्ततः प्राप्नोति सत्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2078015, "chapter_id": 2655, "verse_number": "१२-१६०-१५", "content_sanskrit": "कल्याणं रुते बाढं धीमान्न ग्लायते क्वचित्।\nप्रशान्तवाङ्भना नित्यं ह्रीस्तु धर्मादवाप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2078016, "chapter_id": 2655, "verse_number": "१२-१६०-१६", "content_sanskrit": "धर्मार्थहेतोः क्षमते तितिक्षा धर्म उत्तमः।\nलोकसंग्रहणार्थं वै सा तु धैर्येण लभ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2078017, "chapter_id": 2655, "verse_number": "१२-१६०-१७", "content_sanskrit": "`अनसूया तु गाम्भीर्यं दानेनैतदवाप्यते।\nत्यक्तस्नेहस्य यस्त्यागो विषयाणां तथैव च।\nरागद्वेषप्रहीणस्य त्यागो भवति नान्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2078018, "chapter_id": 2655, "verse_number": "१२-१६०-१८", "content_sanskrit": "`ध्यानं च शाठ्यमित्युक्तं मौनेनैतदवाप्यते।\nआर्यता नाम भूतानां यः करोति प्रयत्नतः।\nशुभं कर्म निराकारो वीतरागस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2078019, "chapter_id": 2655, "verse_number": "१२-१६०-१९", "content_sanskrit": "धृतिर्नाम सुखे दुःखे यया नाप्नोति विक्रियाम्॥\nतां भजेत सदा प्राज्ञो य इच्छेद्भूतिमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2078020, "chapter_id": 2655, "verse_number": "१२-१६०-२०", "content_sanskrit": "सर्वथा क्षमिणा भाव्यं तथा सत्यपरेण च।\nवीतहर्षभयक्रोधो धृतिमाप्नोति पण्डितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2078021, "chapter_id": 2655, "verse_number": "१२-१६०-२१", "content_sanskrit": "अद्रोहः सर्वभूतेषु कर्मणा मनसा गिरा।\nअनुग्रहश्च दानं च सतां धर्मः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2078022, "chapter_id": 2655, "verse_number": "१२-१६०-२२", "content_sanskrit": "एते त्रयोदशाकाराः पृथक्सत्यैकलक्षणाः।\nभजन्ते सत्यमेवेह बृंहयन्ते च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2078023, "chapter_id": 2655, "verse_number": "१२-१६०-२३", "content_sanskrit": "नान्तः शक्यो गुणानां च वक्तुं सत्यस्य पार्थिव।\nअतः सत्यं प्रशंसन्ति विप्राः सपितृदेवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2078024, "chapter_id": 2655, "verse_number": "१२-१६०-२४", "content_sanskrit": "नास्ति सत्यात्परो धर्मो नानृतात्पातकं परम्।\nस्थितिर्हि सत्यं धर्मस्य तस्मात्सत्यं न लोपयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2078025, "chapter_id": 2655, "verse_number": "१२-१६०-२५", "content_sanskrit": "उपैति सत्याद्दानं हि तथा यज्ञाः सदक्षिणाः।\nत्रेताग्निहोत्रं वेदाश्च ये चान्ये धर्मनिश्चयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2078026, "chapter_id": 2655, "verse_number": "१२-१६०-२६", "content_sanskrit": "अश्वमेधसहस्त्रं च सत्यं च तुलया धृतम्।\nअश्वमेधसहस्राद्धि सत्यमेव विशिष्यते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2078027, "chapter_id": 2655, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि षष्ट्यधिकशततमोऽध्यायः॥ १६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]