[{"id": 7003482000, "chapter_id": 23482, "verse_number": "१२२-१", "content_sanskrit": "अथ कोकामुखमाहात्म्यम् ।\nवराह उवाच ।\nगुह्यानां परमं गुह्यं तच्छृणुष्व वसुन्धरे ।\nतिर्यग्योनिगताश्चापि येन मुच्यन्ति किल्बिषात् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003482001, "chapter_id": 23482, "verse_number": "१२२-२", "content_sanskrit": "अष्टम्यां च चतुर्द्दश्यां मैथुनं यो न गच्छति ।\nभुक्त्वा परस्य चान्नानि यश्चैव न विकुत्सति ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003482002, "chapter_id": 23482, "verse_number": "१२२-३", "content_sanskrit": "बाल्ये वयस्यपि च यो मम नित्यमनुव्रतः ।\nयेन केनापि संतुष्टो यो मातापितृपूजकः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003482003, "chapter_id": 23482, "verse_number": "१२२-४", "content_sanskrit": "आयासे जीवति न यः प्रविभागी गुणान्वितः ।\nदाता भोक्ता च कार्येषु स्वतन्त्रो नित्यसंयतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003482004, "chapter_id": 23482, "verse_number": "१२२-५", "content_sanskrit": "विकर्म नाभिकुर्वीत कौमारव्रतसंस्थितः ।\nसर्वभूतदयायुक्तः सत्त्वेन च समन्वितः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003482005, "chapter_id": 23482, "verse_number": "१२२-६", "content_sanskrit": "मत्या च निःस्पृहोऽत्यन्तं परार्थेष्वस्पृहः सदा ।\nईदृग्बुद्धिं समादाय मम लोकाय गच्छति ।\nइमं गुह्यं वरारोहे देवैरपि दुरासदम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003482006, "chapter_id": 23482, "verse_number": "१२२-७", "content_sanskrit": "तच्छृणुष्वानवद्याङ्गि कथ्यमानं मयाऽनघे ।\nजरायुजाण्डजोद्भिज्जस्वेदजानि कदाचन ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003482007, "chapter_id": 23482, "verse_number": "१२२-८", "content_sanskrit": "ये न हिंसन्ति भूतानि शुद्धात्मानो दयापराः।\nयस्तु कोकामुखे देवि ध्रुवं प्राणान्परित्यजेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003482008, "chapter_id": 23482, "verse_number": "१२२-९", "content_sanskrit": "मनसा न चलत्येव मम वल्लभतां व्रजेत् ।\nततो विष्णुवचः श्रुत्वा सा मही संशितव्रता ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003482009, "chapter_id": 23482, "verse_number": "१२२-१०", "content_sanskrit": "वराहरूपिणं देवं प्रत्युवाच वसुन्धरा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003482010, "chapter_id": 23482, "verse_number": "१२२-११", "content_sanskrit": "धरण्युवाच ।\nअहं शिष्या च दासी च भक्ता च त्वयि माधव ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003482011, "chapter_id": 23482, "verse_number": "१२२-१२", "content_sanskrit": "एवं मे परमं गुह्यं त्वद्भक्त्या वक्तुमर्हसि ।\nचक्रं वाराणसीं चैव अट्टहासं च नैमिषम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003482012, "chapter_id": 23482, "verse_number": "१२२-१३", "content_sanskrit": "भद्रकर्णह्रदं चैव हित्वा कोकां प्रशंससि ।\nनगरं च द्विरण्डं च मुकुटं मण्डलेश्वरम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003482013, "chapter_id": 23482, "verse_number": "१२२-१४", "content_sanskrit": "केदारं च ततो मुक्त्वा कि कोकां च प्रशंससि ।\nदेवदारुवनं मुक्त्वा तथा जालेश्वरं विभुम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003482014, "chapter_id": 23482, "verse_number": "१२२-१५", "content_sanskrit": "दुर्गं महाबलं मुक्त्वा किं वै कोकां प्रशंससि ।\nगोकर्णं च ततो मुक्त्वा शुद्धजाल्मेश्वरं तथा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003482015, "chapter_id": 23482, "verse_number": "१२२-१६", "content_sanskrit": "एकलिङ्गं ततो मुक्त्वा किं वा कोकां प्रशंससि ।\nएवं पृष्टस्तथा भक्त्या माधवश्च महाप्रभुः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003482016, "chapter_id": 23482, "verse_number": "१२२-१७", "content_sanskrit": "वराहरूपी भगवान्प्रत्युवाच वसुन्धराम् ।\nश्रीवराह उवाच ।\nएवमेतन्महाभागे यन्मां त्वं भीरु भाषसे ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003482017, "chapter_id": 23482, "verse_number": "१२२-१८", "content_sanskrit": "कथयिष्यामि ते गुह्यं कोका येन विशिष्यते ।\nएते रुद्राश्रिताः क्षेत्रा ये त्वया परिकीर्तिताः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003482018, "chapter_id": 23482, "verse_number": "१२२-१९", "content_sanskrit": "एते पाशुपताश्चैषां कोका भागवतस्य ह ।\nतत्रान्यत्ते प्रवक्ष्यामि महाख्यानं वरानने ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003482019, "chapter_id": 23482, "verse_number": "१२२-२०", "content_sanskrit": "कृतं कोकामुखे चैव मम क्षेत्रे हि सुन्दरि ।\nकश्चिल्लुब्धो मिषाहारश्चरन्वै कोकमण्डले ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003482020, "chapter_id": 23482, "verse_number": "१२२-२१", "content_sanskrit": "तत्राल्पेनाम्बुना युक्ते ह्रदे मत्स्यस्तु तिष्ठति ।\nदृष्ट्वा तं लुब्धकस्तूर्णं बडिशेनाजहार ह ।\nतस्य हस्ताच्च बलवान्मत्स्यस्तूर्णं विनिर्गतः ।\nअथ श्येनस्तु तं हर्त्तुं मन्त्रयित्वा नभश्चरः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003482021, "chapter_id": 23482, "verse_number": "१२२-२२", "content_sanskrit": "निपत्य तं गृहीत्वैव प्रोड्डीनस्त्वरयान्वितः ।\nअशक्तस्य ततो नेतुं मत्स्यः कोकामुखेऽपतत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003482022, "chapter_id": 23482, "verse_number": "१२२-२३", "content_sanskrit": "तत्क्षेत्रस्य प्रभावेण राजपुत्रोऽभवत्प्रभुः ।\nरूपवान् गुणवाञ्छुद्धः कुलेन वयसान्वितः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003482023, "chapter_id": 23482, "verse_number": "१२२-२४", "content_sanskrit": "अथ कालेन तस्यैव मृगव्याधस्य चाङ्गना।\nगृहीत्वा चैव मांसानि गच्छन्ती याति तत्र वै ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003482024, "chapter_id": 23482, "verse_number": "१२२-२५", "content_sanskrit": "एका चिल्ली मांसलुब्धा तद्धस्तान्मांसगर्द्धिनी ।\nआगत्यागत्य तरसा हर्त्तुं समुपचक्रमे ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003482025, "chapter_id": 23482, "verse_number": "१२२-२६", "content_sanskrit": "मृगव्याधा बलान्मांसं हर्तुकामां तु चिल्लिकाम्।\nबाणेनैकेन संहत्य पातिता भुवि तत्क्षणात् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003482026, "chapter_id": 23482, "verse_number": "१२२-२७", "content_sanskrit": "आकाशात्पातिता भद्रे कोकायां मम सन्निधौ ।\nजाता चन्द्रपुरे रम्ये राजपुत्री यशस्विनी ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003482027, "chapter_id": 23482, "verse_number": "१२२-२८", "content_sanskrit": "सा व्यवर्द्धत कन्या तु वयोरूपगुणान्विता ।\nचतुःषष्टिकलायुक्ता पुरुषं सा जुगुप्सति ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003482028, "chapter_id": 23482, "verse_number": "१२२-२९", "content_sanskrit": "रूपवान्गुणवाञ्छूरो युद्धकार्यार्थनिश्चितः ।\nसौम्यश्च पुरुषश्चैव सा च नेति जुगुप्सति ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003482029, "chapter_id": 23482, "verse_number": "१२२-३०", "content_sanskrit": "रूपवान्गुणवाञ्छूरो युदकार्यार्थनिष्ठितः।\nसौम्यं च पुरुषं चैव सर्वानभिजुगुप्सति ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003482030, "chapter_id": 23482, "verse_number": "१२२-३१", "content_sanskrit": "अथ केनचित्कालेन शक आनन्दपूरके।\nसम्बन्धो जायत तयोर्मध्यमे वयसि स्थयोः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003482031, "chapter_id": 23482, "verse_number": "१२२-३२", "content_sanskrit": "तथा तु तौ समासाद्य परस्परमथ क्रमात् ।\nयथान्यायं स विप्रोक्तं विधिदृष्टेन कर्मणा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003482032, "chapter_id": 23482, "verse_number": "१२२-३३", "content_sanskrit": "स वै तथा समं नित्यं सा च तेन समं शुभा ।\nअन्योन्यं रममाणौ तौ मुहूर्तमपि नोज्झतः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003482033, "chapter_id": 23482, "verse_number": "१२२-३४", "content_sanskrit": "गच्छत्येवं बहुतरे काले चैवाप्यनिंदिता ।\nसमप्रेम्णा च संयुक्ता सौह्रदेन च नायकम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003482034, "chapter_id": 23482, "verse_number": "१२२-३५", "content_sanskrit": "भजमाना विनीता च सौहृदाच्च विशेषतः ।\nएवं बहुगतः कालः कामभोगेषु सक्तयोः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003482035, "chapter_id": 23482, "verse_number": "१२२-३६", "content_sanskrit": "राजपुत्रस्तस्तोऽप्यत्र  शकानां नंदवर्द्धनः ।\nतस्या जायत मध्याह्ने शिरोरुगतिपीडिनी ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003482036, "chapter_id": 23482, "verse_number": "१२२-३७", "content_sanskrit": "ये केचिद्भिषजस्तत्र गदेषु कुशलाः शुभे ।\nते तत्रोषधयोगं च चक्रुस्तेनापि वेदना ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003482037, "chapter_id": 23482, "verse_number": "१२२-३८", "content_sanskrit": "ननाश नैव संयातः कालो बहुतिथस्ततः ।\nन सम्बुध्यति चात्मानं विष्णुमायाविमोहितः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003482038, "chapter_id": 23482, "verse_number": "१२२-३९", "content_sanskrit": "पूर्णे हि समये तत्तु उभयोश्च तदन्तरम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003482039, "chapter_id": 23482, "verse_number": "१२२-४०", "content_sanskrit": "तस्य कालः संवृतस्य योऽसौ पूर्वप्रतिस्तवः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003482040, "chapter_id": 23482, "verse_number": "१२२-४१", "content_sanskrit": "अयने गत एतेषां वृत्तं कौतूहलं भुवि ।\nअन्योऽन्यप्रीतियुक्तौ तु नान्योऽन्यं जहतुः क्वचित् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003482041, "chapter_id": 23482, "verse_number": "१२२-४२", "content_sanskrit": "ततः सर्वानवद्याङ्गी भर्त्तारमिदमब्रवीत् ।\nकिमिदं तव भद्रं ते वेदना जायते शिरे ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003482042, "chapter_id": 23482, "verse_number": "१२२-४३", "content_sanskrit": "एतदाचक्ष्व तत्त्वेन यद्यहं च तव प्रिया ।\nबहवो भिषजश्चैव नानाशास्त्रविशारदाः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003482043, "chapter_id": 23482, "verse_number": "१२२-४४", "content_sanskrit": "कुर्वन्ति तव कर्माणि वेदना च न गच्छति ।\nएवं स प्रियया प्रोक्तस्तां प्रियां पुनरब्रवीत् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003482044, "chapter_id": 23482, "verse_number": "१२२-४५", "content_sanskrit": "इदं किं विस्मृता भद्रे सर्वव्याधिसमन्वितम् ।\nयल्लब्धं मानुषत्वं च सुखदुःखसमन्वितम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003482045, "chapter_id": 23482, "verse_number": "१२२-४६", "content_sanskrit": "संसारसागरारूढं नातिप्रष्टुं त्वमर्हसि ।\nतेनैवं भाषिता बाला श्रोतुकामा वरानना ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003482046, "chapter_id": 23482, "verse_number": "१२२-४७", "content_sanskrit": "ततः कदाचिच्छयने सुप्तौ तौ दम्पती किल।\nगते बहुतिथे काले पुनः पप्रच्छ सा प्रियम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003482047, "chapter_id": 23482, "verse_number": "१२२-४८", "content_sanskrit": "कथयस्व तमेवार्थं यन्मया पूर्वपृच्छितम्।\nकिं मां न भाषसे नाथ साभिप्रायं वचस्तव ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003482048, "chapter_id": 23482, "verse_number": "१२२-४९", "content_sanskrit": "गोप्यं वा किंचिदस्तीह किं गोपयसि मे पुरः।\nअवश्यं चैव वक्तव्यं यद्यहं तव वल्लभा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003482049, "chapter_id": 23482, "verse_number": "१२२-५०", "content_sanskrit": "इति निर्बन्धतः पृष्टः स शकाधिपतिर्नृपः।\nतां प्रियां प्रणयात्प्राह बहुमानपुरःसरम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003482050, "chapter_id": 23482, "verse_number": "१२२-५१", "content_sanskrit": "मुच्यतां मानुषं भावं तां जातिं स्मर पौर्विकीम् ।\nअथ कौतूहलं भद्रे श्रवणे पूर्वजन्मनः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003482051, "chapter_id": 23482, "verse_number": "१२२-५२", "content_sanskrit": "मन्मातापितरौ गत्वा प्रसादय शुचिस्मिते।\nमानार्हौ मानयित्वा तौ ययाहं जठरे धृतः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003482052, "chapter_id": 23482, "verse_number": "१२२-५३", "content_sanskrit": "तयोराज्ञां पुरस्कृत्य मानयित्वा यथार्हतः ।\nअथ कोकामुखे गत्वा कथयिष्याम्यसंशयम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003482053, "chapter_id": 23482, "verse_number": "१२२-५४", "content_sanskrit": "स्वपूर्वजन्मवृत्तं तु देवानामपि दुलर्भम् ।\nतत्र ते कथयिष्यामि सर्ववृत्तमनिन्दिते ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003482054, "chapter_id": 23482, "verse_number": "१२२-५५", "content_sanskrit": "ततः सा ह्यनवद्याङ्गी श्वश्रूश्वशुरयोः पुरः ।\nगत्वा गृहीत्वा चरणौ ततस्ताविदमब्रवीत् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003482055, "chapter_id": 23482, "verse_number": "१२२-५६", "content_sanskrit": "किंचिद्विज्ञप्तुकामास्मि  तत्र वामवधीयताम् ।\nभवदाज्ञां पुरस्कृत्य भवद्भ्यामनुमानितौ ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003482056, "chapter_id": 23482, "verse_number": "१२२-५७", "content_sanskrit": "पुण्ये कोकामुखे गन्तुमिच्छावस्तत्र वां गुरू ।\nकार्यगौरवभावेन न निषेध्यौ कथञ्चन ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003482057, "chapter_id": 23482, "verse_number": "१२२-५८", "content_sanskrit": "अद्य यावत्किमपि वां  याचितं न मया क्वचित् ।\nपुरस्ताद्ध्यावयोस्तन्मे याचितं दातुमर्हतः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003482058, "chapter_id": 23482, "verse_number": "१२२-५९", "content_sanskrit": "शिरावेदेनया युक्तः सदा तव सुतो ह्ययम् ।\nमध्याह्ने मृतकल्पो  वै जायते ह्यचिकित्सकम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003482059, "chapter_id": 23482, "verse_number": "१२२-६०", "content_sanskrit": "सुखानि सर्वविषयान्विसृज्य परिपीडितः ।\nकोकामुखं विना कष्टं न निवृत्तं भविष्यति ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003482060, "chapter_id": 23482, "verse_number": "१२२-६१", "content_sanskrit": "कदाचिन्नोक्तपूर्वं ते रहस्यं परमं महत् ।\nत्वरितं गन्तुमिच्छामि विष्णोस्तत्परमं पदम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003482061, "chapter_id": 23482, "verse_number": "१२२-६२", "content_sanskrit": "दम्पतिभ्यां हि मननं रोचतां सर्वथैव हि ।\nततो वधूवचः श्रुत्वा शकानामधिपो नृपः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003482062, "chapter_id": 23482, "verse_number": "१२२-६३", "content_sanskrit": "करेण स्वयमादाय वधूं पुत्रमुवाच ह ।\nकिमिदं चिन्तितं वत्स कोकामुखगमं प्रति ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003482063, "chapter_id": 23482, "verse_number": "१२२-६४", "content_sanskrit": "हस्त्यश्वरथ यानानि स्त्रियश्चाप्सरसोपमाः ।\nसर्वमेतत्तु सप्ताङ्गं कोशकोष्ठादिसंयुतम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003482064, "chapter_id": 23482, "verse_number": "१२२-६५", "content_sanskrit": "शरणं वित्तयो राज्यं त्वयि सर्वं प्रतिष्ठितम् ।\nमित्रं वरासनं चैव गृह्णीष्व सुतसत्तम ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003482065, "chapter_id": 23482, "verse_number": "१२२-६६", "content_sanskrit": "त्वयि प्रतिष्ठिताः प्राणाः सन्तानं च तदुत्तरम् ।\nततः पितुर्वचः श्रुत्वा राजपुत्रो यशस्विनि ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003482066, "chapter_id": 23482, "verse_number": "१२२-६७", "content_sanskrit": "पितुः पादौ गृहीत्वा च प्रोवाच विनयान्वितः ।\nअलं राज्येन कोशेन वाहनेन बलेन वा ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003482067, "chapter_id": 23482, "verse_number": "१२२-६८", "content_sanskrit": "गन्तुमिच्छामि तत्राहं तूर्णं कोकामुखं महत् ।\nशिरोवेदनया युक्तो यदि जीवाम्यहं पितः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003482068, "chapter_id": 23482, "verse_number": "१२२-६९", "content_sanskrit": "तदा राज्यं बलं कोशो ममैवैतन्न सशंयः ।\nतत्रैव गमनान्मह्यं वेदना नाशमेष्यति।६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003482069, "chapter_id": 23482, "verse_number": "१२२-७०", "content_sanskrit": "पुत्रोक्तमवधार्यैव शकानामधिपो नृपः ।\nअनुजज्ञे ततः कोकां गच्छ पुत्र नमोऽस्तु ते ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003482070, "chapter_id": 23482, "verse_number": "१२२-७१", "content_sanskrit": "वणिजश्चैव पौराश्च वैश्याश्चापि वराङ्गनाः ।\nअनुजग्मू राजपुत्रं कोकामुखपथे स्थितम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003482071, "chapter_id": 23482, "verse_number": "१२२-७२", "content_sanskrit": "अथ दीर्घेण कालेन प्राप्तः कोकामुखं त्विदम् ।\nतत्र गत्वा वरारोहा भर्त्तारमिदमब्रवीत् १७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003482072, "chapter_id": 23482, "verse_number": "१२२-७३", "content_sanskrit": "पूर्वपृष्टं मया यत्ते वक्ष्यामीति च मां प्रति ।\nकोकामुखे त्वयाप्युक्तं तदेतन्मम कथ्यताम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003482073, "chapter_id": 23482, "verse_number": "१२२-७४", "content_sanskrit": "निशम्येति प्रियाप्रोक्तं राजपुत्रो यशस्विनि ।\nप्रहस्याह भिया तां तु समालिङ्ग्य वसुन्धरे ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003482074, "chapter_id": 23482, "verse_number": "१२२-७५", "content_sanskrit": "रजनी सम्प्रवृत्तेयं सुखं स्वापो विधीयताम् ।\nश्वः सर्वं कथयिष्यामि यत्ते मनसि वर्त्तते ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003482075, "chapter_id": 23482, "verse_number": "१२२-७६", "content_sanskrit": "प्रभातायां तु शर्वर्यां स्नातौ क्षौमविभूषितौ।\nप्रणम्य शिरसा विष्णुं हस्ते गृह्य ततः प्रियाम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003482076, "chapter_id": 23482, "verse_number": "१२२-७७", "content_sanskrit": "ततः पूर्वोत्तरे पार्श्वे नित्यं यो हृदि तिष्ठति ।\nअस्थीनि दर्शयामास अवशिष्टानि यानि तु ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003482077, "chapter_id": 23482, "verse_number": "१२२-७८", "content_sanskrit": "एतानि मम चास्थानि पूर्वदेहोद्भवानि च।\nअहं पुराभवं मत्स्यः कोकेषु विचरन् जले ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003482078, "chapter_id": 23482, "verse_number": "१२२-७९", "content_sanskrit": "व्याधेन निगृहीतोऽस्मि बडिशेन जलेचरः।\nतद्धस्तान्निर्गतस्तत्र बलेन पतितो भुवि ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003482079, "chapter_id": 23482, "verse_number": "१२२-८०", "content_sanskrit": "श्येनेनामिषलुब्धेन नखैर्विद्धोऽस्मि सुन्दरि ।\nनीत आकाशमार्गेण तस्माच्च पतितोऽत्र वै ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003482080, "chapter_id": 23482, "verse_number": "१२२-८१", "content_sanskrit": "तेन तस्य प्रहारेण जाता शिरसि वेदना ।\nअहमेव विजानामि नान्यो जानाति मां विना ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003482081, "chapter_id": 23482, "verse_number": "१२२-८२", "content_sanskrit": "एतत्ते कथितं भद्रे पूर्वपृष्टं च यत्त्वया ।\nगच्छ सुन्दरि भद्रं ते यत्र ते वर्त्तते मनः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003482082, "chapter_id": 23482, "verse_number": "१२२-८३", "content_sanskrit": "ततः साप्यनवद्याङ्गी रक्तपद्मशुभानना ।\nकरुणं स्वरमादाय भर्त्तारं पुनरब्रवीत् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003482083, "chapter_id": 23482, "verse_number": "१२२-८४", "content_sanskrit": "एतदर्थं मया भद्र गुह्यं नोक्तं तथा स्वकम् ।\nअहं च यादृशी पूर्वमभवं तच्छृणुष्व मे ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003482084, "chapter_id": 23482, "verse_number": "१२२-८५", "content_sanskrit": "क्षुत्पिपासापरिश्रान्ता चिल्ली गगनगामिनी ।\nवृक्षोपरि समासीना भक्ष्यं चैव विचिन्वती ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003482085, "chapter_id": 23482, "verse_number": "१२२-८६", "content_sanskrit": "अथ कश्चिन्मृगव्याधो हत्वा वनचरान्बहून् ।\nसंगृह्य मांसभारान्वै तेन मार्गेण सङ्गतः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003482086, "chapter_id": 23482, "verse_number": "१२२-८७", "content_sanskrit": "स्थापयित्वा मांसभारान्प्रियायाः सविधे स्वयम् ।\nकाष्ठान्यानयितुं यातः क्षुधितो मांसपाचने ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003482087, "chapter_id": 23482, "verse_number": "१२२-८८", "content_sanskrit": "प्रवृत्तोऽग्निमुपादाय तावदुड्डीय  सत्वरम्।\nमांसपिण्डो मया विद्धो दृढैर्वज्रमयैर्नखैः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003482088, "chapter_id": 23482, "verse_number": "१२२-८९", "content_sanskrit": "न च सक्तास्मि संहर्त्तुं  मांसभारप्रपीडिता ।\nअशक्ता दूरगमने सविधे हि व्यवस्थिता ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003482089, "chapter_id": 23482, "verse_number": "१२२-९०", "content_sanskrit": "भक्षयित्वा ततो मांसं व्याधः संहृष्टमानसः ।\nअपश्यन्मांसपिण्डं तु मृगयामास पार्श्वतः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003482090, "chapter_id": 23482, "verse_number": "१२२-९१", "content_sanskrit": "तावद्ददर्श मां तत्र खादन्तीं मांसपिण्डिकाम्।\nततः स धनुरुद्यम्य सशरं च व्यकर्षत ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003482091, "chapter_id": 23482, "verse_number": "१२२-९२", "content_sanskrit": "विद्धा बाणेन मां तत्र भक्षयन्तमिपातयत् ।\nततोऽहं भ्रममाणा वै निश्चेष्टा गतजीविता ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003482092, "chapter_id": 23482, "verse_number": "१२२-९३", "content_sanskrit": "पतितास्म्यवशा भद्र कालतन्त्रे दुरासदे ।\nएतत्क्षेत्रप्रभावेण त्वकामापि नृपात्मजा ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003482093, "chapter_id": 23482, "verse_number": "१२२-९४", "content_sanskrit": "जातास्मि त्वत्प्रिया चापि स्मरन्ती पूर्वजन्म तत् ।\nएतानि पश्य चास्थीनि शेषाणि बहुकालतः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003482094, "chapter_id": 23482, "verse_number": "१२२-९५", "content_sanskrit": "गलितान्यल्पशेषाणि प्राणनाथ समीपतः ।\nएवं सा दर्शयित्वा तु भर्त्तारं पुनरब्रवीत् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003482095, "chapter_id": 23482, "verse_number": "१२२-९६", "content_sanskrit": "आनीतोऽसि मया भद्र स्थानं कोकामुखं प्रति ।\nएतत्क्षेत्रप्रभावेण तिर्यग्योनिगता अपि ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003482096, "chapter_id": 23482, "verse_number": "१२२-९७", "content_sanskrit": "उत्तमे तु कुले जाता मानुषी जातिमाश्रिताः ।\nयं यं प्रवक्ष्यसे धर्मं विष्णुप्रोक्तं यशोधन ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003482097, "chapter_id": 23482, "verse_number": "१२२-९८", "content_sanskrit": "तं तमेव करिष्यामि विष्णुलोके सुखावहम् ।\nततस्तस्या वचः श्रुत्वा लब्धपूर्वस्मृतिर्नृपः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003482098, "chapter_id": 23482, "verse_number": "१२२-९९", "content_sanskrit": "विस्मयं परमं गत्वा साधु साध्वित्यपूजयत् ।\nतस्मिन् क्षेत्रे च यत्कर्म कर्त्तव्यं धर्मसंहितम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003482099, "chapter_id": 23482, "verse_number": "१२२-१००", "content_sanskrit": "तच्छ्रुत्वा कानिचिद्देवी स्वयं चक्रे पतिव्रता ।\nअन्येऽपि सर्वे तच्छ्रुत्वा यस्य यद्रोचते प्रियम् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003482100, "chapter_id": 23482, "verse_number": "१२२-१०१", "content_sanskrit": "तत्तत्सर्वेऽपि कुर्वंति विधिदृष्टेन कर्मणा ।\nतत्र तौ दम्पती द्रव्यमन्नं रत्नं द्विजेषु च ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003482101, "chapter_id": 23482, "verse_number": "१२२-१०२", "content_sanskrit": "ददतुः परमप्रीतौ  पात्रेभ्यश्च यथार्हतः ।\nयेऽन्ये तत्सार्थमासाद्य यातास्तेऽपि वसुन्धरे ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003482102, "chapter_id": 23482, "verse_number": "१२२-१०३", "content_sanskrit": "ब्राह्मणेभ्यो ददुः स्वानि विष्णुभक्त्या यतव्रताः ।\nतत्र स्थित्वा वरारोहे मम कर्मव्यवस्थितः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003482103, "chapter_id": 23482, "verse_number": "१२२-१०४", "content_sanskrit": "तत्क्षेत्रस्य प्रभावेण श्वेतद्वीपमुपागताः ।\nएवं स राजपुत्रोऽपि मम कर्मव्यवस्थितः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003482104, "chapter_id": 23482, "verse_number": "१२२-१०५", "content_sanskrit": "मुक्त्वा तु मानुषं भावं श्वेतद्वीपमुपागतः ।\nसर्वे च पुरुषास्तत्र आत्मनात्मानुदर्शनात् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003482105, "chapter_id": 23482, "verse_number": "१२२-१०६", "content_sanskrit": "( शुक्लाम्बरधरा दिव्यभूषणैश्च विभूषिताः ।\nदीप्तिमन्तो महाकायाः सर्वे च शुभदर्शनाः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003482106, "chapter_id": 23482, "verse_number": "१२२-१०७", "content_sanskrit": "स्त्रियोऽपि दिव्या यत्रत्या दिव्यभूषणभूषिताः ।\nतेजसा दीप्तिमत्यश्च शुद्धसत्त्व विभूषिताः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003482107, "chapter_id": 23482, "verse_number": "१२२-१०८", "content_sanskrit": "मयि शुद्धं परं भावमारूढाः सत्यवर्च्चसः ।\nएतत्ते कथितं देवि कोकामुखमनुत्तमम् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003482108, "chapter_id": 23482, "verse_number": "१२२-१०९", "content_sanskrit": "यत्र मत्स्यश्च चिल्ली च सकामा ये समागताः ।\nकेचिच्चान्द्रायणं कुर्युः केचिच्चैव जलाशनम् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003482109, "chapter_id": 23482, "verse_number": "१२२-११०", "content_sanskrit": "ते च विष्णुमयान्धर्मान्द्विजस्तांस्तान्त्समाचरेत् ।\nबहुधान्यवरं रत्नं दंपत्योऽथ यशस्विनी ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003482110, "chapter_id": 23482, "verse_number": "१२२-१११", "content_sanskrit": "तेऽपि कुर्वन्ति कर्माणि मम भक्ता व्यवस्थिताः ।\nतेऽपि दीर्घेण कालेन अटमाना इतस्ततः ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003482111, "chapter_id": 23482, "verse_number": "१२२-११२", "content_sanskrit": "कुर्वन्तो मम कर्माणि भाव्यं पंचत्वमागताः ।\nततः क्षेत्रप्रभावेण मम कर्मप्रभावतः ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003482112, "chapter_id": 23482, "verse_number": "१२२-११३", "content_sanskrit": "मम चैव प्रसादेन श्वेतद्वीपमुपागतः ।\nएवं स राजपुत्रोऽथ सर्वभूतगुणान्वितः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003482113, "chapter_id": 23482, "verse_number": "१२२-११४", "content_sanskrit": "भुक्त्वा तु मानुषं भावमूर्ध्वशाखोनुतिष्ठति ।\nयोऽसौ परिजनस्तस्य मम कर्मव्यवस्थितः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003482114, "chapter_id": 23482, "verse_number": "१२२-११५", "content_sanskrit": "मानुषं भावमुत्सृज्य मम लोकमुपागतः ।\nसर्वशो द्युतिमांस्तत्र आत्मनानात्मदर्शनात् ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003482115, "chapter_id": 23482, "verse_number": "१२२-११६", "content_sanskrit": "याश्च तत्र स्त्रियः काश्चित्सर्वाश्चोत्पलगन्धिनीः ।\nमायया मतिमन्मुक्ताः सर्वाश्चैव प्रियावृताः ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003482116, "chapter_id": 23482, "verse_number": "१२२-११७", "content_sanskrit": "प्रसादान्मम सुश्रोणि श्वेतद्वीपमुपागताः।\nएष धर्मश्च कीर्तिश्च शक्तिश्चैव महद्यशः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7003482117, "chapter_id": 23482, "verse_number": "१२२-११८", "content_sanskrit": "कर्मणां परमं कर्म तपसां च महत्तपः ।\nआख्यानानां च परमं कृतीनां परमा कृतिः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7003482118, "chapter_id": 23482, "verse_number": "१२२-११९", "content_sanskrit": "धर्माणां च परो धर्मस्तवार्थं कीर्तितो मया ।\nक्रोधनाय न तं दद्यान्मूर्खाय पिशुनाय च ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7003482119, "chapter_id": 23482, "verse_number": "१२२-१२०", "content_sanskrit": "अभक्ताय न तं दद्यादश्रद्धाय शठाय च ।\nदीक्षितायैव दातव्यं सुप्रपन्नाय नित्यशः ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7003482120, "chapter_id": 23482, "verse_number": "१२२-१२१", "content_sanskrit": "पण्डिताय च दातव्यं यश्च शास्त्रविशारदः ।\nएतन्मरणकालेऽपि धारयेद्यः समाहितः ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7003482121, "chapter_id": 23482, "verse_number": "१२२-१२२", "content_sanskrit": "सोऽपि मुच्येत पूतात्मा गर्भाद्योनिभवाद्भयात् ।\nएतत्ते कथितं भद्रे महाख्यानं महौजसम् ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7003482122, "chapter_id": 23482, "verse_number": "१२२-१२३", "content_sanskrit": "य एतेन विधानेन गत्वा कोकामुखं महत् ।\nतेऽपि   यान्ति परां सिद्धिं चिल्लीमत्स्यौ यथा पुरा ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}]