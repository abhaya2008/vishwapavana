[{"id": 2142805, "chapter_id": 4078, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2142806, "chapter_id": 4078, "verse_number": "१", "content_sanskrit": "आख्यानमुत्तममिदमितिहासं पुरातनम् ।\nशृणु मे भ्रातृभिः सार्धं सर्वशत्रुजयावहम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2142807, "chapter_id": 4078, "verse_number": "२", "content_sanskrit": "वृत्रभूतेषु लोकेषु भयमिन्द्रमुपागमत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2142808, "chapter_id": 4078, "verse_number": "३", "content_sanskrit": "अथेन्द्रो हि महातेजाः समेत्य सह दैवतैः ।\nआमन्त्रयत तेजस्वी वृत्रस्य वधकारणात्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2142809, "chapter_id": 4078, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2142810, "chapter_id": 4078, "verse_number": "४", "content_sanskrit": "सर्वं व्याप्तमिदं देवा वृत्रेण जगदव्ययम् ।\nन ह्यस्य सदृशं किञ्चित् प्रतिघातस्य यद् भवेत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2142811, "chapter_id": 4078, "verse_number": "५", "content_sanskrit": "समर्थो ह्यभवं पूर्वमसमर्थोऽस्मि साम्प्रतम् ।\nकथं कुर्याम भद्रं वो दुर्धर्षः स हि मे मतः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2142812, "chapter_id": 4078, "verse_number": "६", "content_sanskrit": "तेजस्वी च महात्मा च युद्धे चामितविक्रमः ।\nग्रसेत् त्रिभुवनं सर्वं सदेवासुरमानुषम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2142813, "chapter_id": 4078, "verse_number": "७", "content_sanskrit": "तस्माद् विनिश्चयमिमं शृणुध्वं त्रिदिवौकसः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2142814, "chapter_id": 4078, "verse_number": "८", "content_sanskrit": "विष्णोः क्षयमुपागम्य समेत्य च महात्मना ।\nतेन सम्मन्त्र्य वेत्स्यामो वधोपायं दुरात्मनः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2142815, "chapter_id": 4078, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2142816, "chapter_id": 4078, "verse_number": "९", "content_sanskrit": "एवमुक्ता मघवता देवाः सर्षिगणास्तदा ।\nशरण्यं शरणं देवं जग्मुर्विष्णुं महाबलम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2142817, "chapter_id": 4078, "verse_number": "१०", "content_sanskrit": "ऊचुश्च सर्वे देवेशं विष्णुं वृत्रभयार्दिताः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2142818, "chapter_id": 4078, "verse_number": "११", "content_sanskrit": "त्रयो लोकास्त्वया क्रान्ताः त्रिभिर्विक्रमणैः पुरा ।\nअमृतं च हृतं विष्णो दैत्याश्च निहता रणे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2142819, "chapter_id": 4078, "verse_number": "१२", "content_sanskrit": "बलिं बद्ध्वा महादैत्यं शक्रो देवाधिपः कृतः ।\nत्वं प्रभुः सर्वलोकानां त्वया सर्वमिदं ततम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2142820, "chapter_id": 4078, "verse_number": "१३", "content_sanskrit": "त्वं हि देवो महादेवः सर्वलोकनमस्कृतः ।\nगतिर्भवसि देवानां सेन्द्राणाममरोत्तम\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2142821, "chapter_id": 4078, "verse_number": "१४", "content_sanskrit": "जगद् व्याप्तमिदं सर्वं वृत्रेणारिनिषूदन\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2142822, "chapter_id": 4078, "verse_number": "", "content_sanskrit": "विष्णुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2142823, "chapter_id": 4078, "verse_number": "१५", "content_sanskrit": "अशक्यकरणीयं मे भवतां हितमुत्तमम् ।\nतस्मादुपायं वक्ष्यामि यथाऽसौ न भविष्यति\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2142824, "chapter_id": 4078, "verse_number": "१६", "content_sanskrit": "गच्छध्वं सर्षिगन्धर्वा यत्रासौ विश्वरूपधृक्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2142825, "chapter_id": 4078, "verse_number": "१७", "content_sanskrit": "साम तस्य प्रयुञ्जध्वं तत एनं विजेष्यथ ।\nभविष्यति जयो देवाः शक्रस्य मम तेजसा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2142826, "chapter_id": 4078, "verse_number": "१८", "content_sanskrit": "अदृश्यश्च प्रवेक्ष्यामि वज्रमेवायुधोत्तमम् ।\nगच्छध्वमृषिभिः सार्धं गन्धर्वैश्च सुरोत्तमाः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2142827, "chapter_id": 4078, "verse_number": "१९", "content_sanskrit": "वृत्रस्य सह शक्रेण सन्धिं कुरुत मा चिरम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2142828, "chapter_id": 4078, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2142829, "chapter_id": 4078, "verse_number": "२०", "content_sanskrit": "एवमुक्ते तु देवेन ऋषयस्त्रिदशास्तदा ।\nययुः समेत्य विभुना शक्रं कृत्वा पुरःसरम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2142830, "chapter_id": 4078, "verse_number": "२१", "content_sanskrit": "समीपमेत्य च तदा सर्व एव दिवौकसः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2142831, "chapter_id": 4078, "verse_number": "२२", "content_sanskrit": "तं तेजसा प्रज्वलितं प्रतपन्तं दिशो दश ।\nग्रसन्तमिव लोकांस्त्रीन् सूर्याचन्द्रमसौ तथा\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2142832, "chapter_id": 4078, "verse_number": "२३", "content_sanskrit": "ददृशुस्ते तपोवृद्धं शक्रेण सह देवताः ।\nऋषयश्च ततोऽभ्येत्य वृत्रमूचुः प्रियं वचः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2142833, "chapter_id": 4078, "verse_number": "", "content_sanskrit": "ऋषयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2142834, "chapter_id": 4078, "verse_number": "२४", "content_sanskrit": "व्याप्तं जगदिदं सर्वं तेजसा तव दुर्जय ।\nन च शक्नोषि निर्जेतुं वासवं भूरिविक्रमम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2142835, "chapter_id": 4078, "verse_number": "२५", "content_sanskrit": "युध्यतोश्चापि वां कालोऽप्यतीतः सुमहानिह ।\nपीड्यन्ते च प्रजाः सर्वाः सदेवासुरमानुषाः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2142836, "chapter_id": 4078, "verse_number": "२६", "content_sanskrit": "सख्यं भवतु ते पुत्र शक्रेण सह नित्यदा ।\nअवाप्स्यति सुखं त्वं च शक्रलोकांश्च शाश्वतान्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2142837, "chapter_id": 4078, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2142838, "chapter_id": 4078, "verse_number": "२७", "content_sanskrit": "ऋषिवाक्यं निशम्याथ वृत्रः स तु महाबलः ।\nउवाच तानृषीन् सर्वान् प्रणम्य शिरसाऽसुरः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2142839, "chapter_id": 4078, "verse_number": "२८", "content_sanskrit": "सर्वे यूयं महाभागा गन्धर्वाश्चैव सर्वशः ।\nयद् ब्रूथ तच्छ्रुतं सर्वं ममापि शृणुतानघाः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2142840, "chapter_id": 4078, "verse_number": "२९", "content_sanskrit": "सन्धिः कथं वै भविता मम शक्रस्य चोभयोः ।\nतेजसो हि द्वयोर्देवाः सख्यं वै भविता कथम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2142841, "chapter_id": 4078, "verse_number": "", "content_sanskrit": "ऋषयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2142842, "chapter_id": 4078, "verse_number": "३०", "content_sanskrit": "सकृत् सतां सङ्गतमीप्सितव्यं\nततः परं भविता भव्यमेव ।\nनातिक्रमेत् सत्पुरुषेण सङ्गतं\nतस्मात् सतां सङ्गतमीप्सितव्यम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2142843, "chapter_id": 4078, "verse_number": "", "content_sanskrit": "दृढं सतां सङ्गतं चापि नित्यं ब्रूयाच्चार्थं ह्यर्थकृच्छ्रेषु धीरः ।\nमहार्थवत् सत्पुरुषेण सङ्गतं तस्मात् सतो न जिघांसेत धीरः\t॥३१", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2142844, "chapter_id": 4078, "verse_number": "३२", "content_sanskrit": "इन्द्रः सतां सम्मतश्च निवासश्च महात्मनाम् ।\nसत्यवादी ह्यदीनश्च धर्मवित् सूक्ष्मनिश्चयः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2142845, "chapter_id": 4078, "verse_number": "३३", "content_sanskrit": "तेन ते सह शक्रेण सन्धिर्भवतु नित्यदा ।\nएवं विश्वासमागच्छ मा ते भूद् बुद्धिरन्यथा\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2142846, "chapter_id": 4078, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2142847, "chapter_id": 4078, "verse_number": "", "content_sanskrit": "महर्षिवचनं श्रुत्वा तानुवाच महाद्युतिः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2142848, "chapter_id": 4078, "verse_number": "", "content_sanskrit": "वृत्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2142849, "chapter_id": 4078, "verse_number": "३४", "content_sanskrit": "अवश्यं भगवन्तो मे माननीयास्तपस्विनः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2142850, "chapter_id": 4078, "verse_number": "३५", "content_sanskrit": "ब्रवीमि यदहं देवाः तत्सर्वं क्रियते यदि ।\nततः सर्वं करिष्यामि यदूचुर्मां द्विजर्षभाः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2142851, "chapter_id": 4078, "verse_number": "३६", "content_sanskrit": "न शुष्केण न चार्द्रेण नाश्मना न च दारुणा ।\nन शस्त्रेण न चास्त्रेण न दिवा नापि वा निशि\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2142852, "chapter_id": 4078, "verse_number": "३७", "content_sanskrit": "वध्यो भवेयं विप्रेन्द्राः शक्रस्य सह दैवतैः ।\nएवं मे रोचते सन्धिः शक्रस्य सह नित्यदा\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2142853, "chapter_id": 4078, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2142854, "chapter_id": 4078, "verse_number": "३८", "content_sanskrit": "बाढमित्येव ऋषयः तमूचुर्भरतर्षभ ।\nएवं वृत्ते तु सन्धाने वृत्रः प्रमुदितोऽभवत्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2142855, "chapter_id": 4078, "verse_number": "३९", "content_sanskrit": "ततः सन्धिं मिथः कृत्वा ऋषयो दीप्ततेजसः ।\nशक्रस्य सह वृत्रेण पुनर्जग्मुर्यथागतम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2142856, "chapter_id": 4078, "verse_number": "४०", "content_sanskrit": "अथ दीर्घस्य कालस्य शक्रः सञ्चिन्त्य भारत ।\nयत्तः सदाऽभवच्चापि क्रुद्धोऽमर्षसमन्वितः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2142857, "chapter_id": 4078, "verse_number": "४१", "content_sanskrit": "वृत्रस्य वधसंयुक्तानुपायानन्वचिन्तयत्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2142858, "chapter_id": 4078, "verse_number": "४२", "content_sanskrit": "अभिसन्धिर्महेन्द्रस्य सन्धिकर्मणि यः कृतः ।\nऋषिभिस्त्वीरितं यच्च महेन्द्रस्तदनुस्मरन्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2142859, "chapter_id": 4078, "verse_number": "४३", "content_sanskrit": "छिद्रान्वेषी समुद्विग्नः सदा वसति देवराट्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2142860, "chapter_id": 4078, "verse_number": "४४", "content_sanskrit": "स कदाचित् समुद्रान्ते तमपश्यन्महासुरम् ।\nसन्ध्याकाल उपावृत्ते मुहूर्ते रम्यदारुणे\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2142861, "chapter_id": 4078, "verse_number": "४५", "content_sanskrit": "ततः सञ्चिन्त्य मघवान् वरदानं महात्मनः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2142862, "chapter_id": 4078, "verse_number": "४६", "content_sanskrit": "सन्ध्येयं वर्तते रौद्रा न रात्रिर्न च वासरः ।\nवृत्रश्चावश्यवध्योऽयं मम सर्वहरो रिपुः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2142863, "chapter_id": 4078, "verse_number": "४७", "content_sanskrit": "यदि वृत्रं न हन्म्यद्य वञ्चयित्वा महासुरम् ।\nमहाबलं महाकायं न मे श्रेयो भविष्यति\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2142864, "chapter_id": 4078, "verse_number": "४८", "content_sanskrit": "एवं सञ्चिन्तयन्नेव शक्रो विष्णुमनुस्मरन् ।\nअथ फेनं तदाऽपश्यत् समुद्रे पर्वतोपमम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2142865, "chapter_id": 4078, "verse_number": "४९", "content_sanskrit": "नायं शुष्को न चार्द्रोऽयं न च शस्त्रमिदं तथा ।\nएनं क्षिपामि वृत्रस्य क्षणादेव नशिष्यति\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2142866, "chapter_id": 4078, "verse_number": "५०", "content_sanskrit": "जग्राह स च तं फेनमिन्द्रो वृत्रनिबर्हणम् ।\nनिगृह्य शक्रो बाहुभ्यां प्राहिणोद् वृत्रमस्तके\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2142867, "chapter_id": 4078, "verse_number": "५१", "content_sanskrit": "सवज्रमथ फेनं तं क्षिप्रं वृत्रे निसृष्टवान् ।\nप्रविश्य फेनं तं विष्णुरथ वृत्रं व्यनाशयत्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2142868, "chapter_id": 4078, "verse_number": "५२", "content_sanskrit": "निहते तु ततो वृत्रे दिशो वितिमिराभवन् ।\nप्रववौ च शिवो वायुः प्रजाश्च जहृषुस्तदा\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2142869, "chapter_id": 4078, "verse_number": "५३", "content_sanskrit": "ततो देवाः सगन्धर्वा यक्षरक्षोमहोरगाः ।\nऋषयश्च महेन्द्रं तमस्तुवन् विविधैः स्तवैः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2142870, "chapter_id": 4078, "verse_number": "५४", "content_sanskrit": "हत्वा शत्रुं प्रहृष्टात्मा वासवः सह दैवतैः ।\nविष्णुं त्रिभुवनश्रेष्ठं पूजयामास धर्मवित्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2142871, "chapter_id": 4078, "verse_number": "५५", "content_sanskrit": "ततो हते महावीर्ये वृत्रे देवभयङ्करे ।\nअनृतेनाभिभूतोऽभूत् शक्रः परमदुर्मनाः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2142872, "chapter_id": 4078, "verse_number": "५६", "content_sanskrit": "त्रैशीर्षयाऽभिभूतश्च स पूर्वं ब्रह्महत्यया ।\nसोऽन्तमाश्रित्य लोकानां नष्टसञ्ज्ञो विचेतनः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2142873, "chapter_id": 4078, "verse_number": "५७", "content_sanskrit": "न प्राज्ञायत देवेन्द्रस्त्वभिभूतः सः कल्मषैः ।\nप्रतिच्छन्नोऽवसच्चाप्सु वेष्टमान इवोरगः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2142874, "chapter_id": 4078, "verse_number": "५८", "content_sanskrit": "ततः प्रनष्टे देवेन्द्रे ब्रह्महत्याभयार्दिते ।\nभूमिः प्रध्वस्तसङ्काशा निर्वृक्षा शुष्ककानना\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2142875, "chapter_id": 4078, "verse_number": "५९", "content_sanskrit": "विच्छिन्नस्रोतसो नद्यः सरांस्यनुदकानि च ।\nसङ्क्षोभश्चापि सत्वानामनावृष्टिकृतोऽभवत्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2142876, "chapter_id": 4078, "verse_number": "६०", "content_sanskrit": "देवाश्चापि भृशं त्रस्ताः तथा सर्वे महर्षयः ।\nअराजकं जगत् सर्वमभिभूतमुपद्रवैः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2142877, "chapter_id": 4078, "verse_number": "६१", "content_sanskrit": "ततो भीताऽभवन् देवाः को नो राजा भवेदिति ।\nदिवि देवर्षयश्चापि देवराजविनाकृताः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2142878, "chapter_id": 4078, "verse_number": "६२", "content_sanskrit": "न स्म कश्चन देवानां राज्ये वै कुरुते मतिम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2142879, "chapter_id": 4078, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि दशमोऽध्यायः ॥१०॥ सेनोद्योगपर्वणि दशमोऽध्यायः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}]