[{"id": 2174436, "chapter_id": 4704, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2174437, "chapter_id": 4704, "verse_number": "१", "content_sanskrit": "ततस्तेष्वपयातेषु रथेषु त्रिषु पाण्डवाः ।\nतं ह्रदं प्रत्यपद्यन्त यत्र दुर्योधनोऽभवत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2174438, "chapter_id": 4704, "verse_number": "२", "content_sanskrit": "आसाद्य तु कुरुश्रेष्ठ तत्र द्वैपायनं ह्रदम् ।\nस्तम्भितं धार्तराष्ट्रेण दृष्ट्वा तं सलिलाशयम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2174439, "chapter_id": 4704, "verse_number": "३", "content_sanskrit": "वासुदेवमिदं वाक्यमब्रवीत् कुरुनन्दनः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2174440, "chapter_id": 4704, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2174441, "chapter_id": 4704, "verse_number": "४", "content_sanskrit": "पश्येमां धार्तराष्ट्रेण मायामप्सु प्रयोजिताम् ।\nविष्टभ्य सलिलं शेते नास्य मानुषतो भयम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2174442, "chapter_id": 4704, "verse_number": "५", "content_sanskrit": "दैवीं मायामिमां कृत्वा सलिलान्तर्गतो ह्ययम् ।\nनिकृत्या निकृतिप्रज्ञो न स जीवन् विमोक्ष्यते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2174443, "chapter_id": 4704, "verse_number": "६", "content_sanskrit": "यद्यस्य समरे साह्यं कुरुते वासवः स्वयम् ।\nतथाऽप्येतं हतं युद्धे लोका द्रक्ष्यन्ति माधव\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2174444, "chapter_id": 4704, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2174445, "chapter_id": 4704, "verse_number": "७", "content_sanskrit": "मायाविन इमां मायां मायया जहि भारत ।\nमायावी मायया वध्यः सत्यमेतद् युधिष्ठिर\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2174446, "chapter_id": 4704, "verse_number": "८", "content_sanskrit": "क्रियाभ्युपायैर्बहुभिः मायामप्सु प्रयोज्य च ।\nजहि त्वं भरतश्रेष्ठ मायात्मानं सुयोधनम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2174447, "chapter_id": 4704, "verse_number": "९", "content_sanskrit": "क्रियाभ्युपायैरिन्द्रेण निहता दैत्यदानवाः ।\nक्रियाभ्युपायैः पूर्वं हि बलिर्बद्धो महात्मना\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2174448, "chapter_id": 4704, "verse_number": "१०", "content_sanskrit": "क्रियाभ्युपायैः पूर्वं हि हिरण्याक्षो महासुरः ।\nहिरण्यकशिपुश्चैव क्रिययैव निषूदितः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2174449, "chapter_id": 4704, "verse_number": "११", "content_sanskrit": "वृत्रश्च निहतो राजन् सानुबन्धः सहानुगः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2174450, "chapter_id": 4704, "verse_number": "१२", "content_sanskrit": "तथा पौलस्त्यतनयो रावणो नाम राक्षसः ।\nरामेण निहतो राजन् सानुबन्धः सहानुगः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2174451, "chapter_id": 4704, "verse_number": "१३", "content_sanskrit": "क्रियया योगमास्थाय तथा त्वमपि विक्रम ।\nक्रियाभ्युपायैर्निहतो यमो नाम महासुरः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2174452, "chapter_id": 4704, "verse_number": "१४", "content_sanskrit": "नरकश्च महावीर्यो विप्रचित्तिश्च वीर्यवान् ।\nवातापिरिल्वलश्चैव त्रिशिराश्च तथा विभो\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2174453, "chapter_id": 4704, "verse_number": "१५", "content_sanskrit": "सुन्दोपसुन्दावसुरौ क्रिययैव निषूदितौ ।\nतारकश्च महादैत्यो ह्यन्धकश्च निषूदितः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2174454, "chapter_id": 4704, "verse_number": "१६", "content_sanskrit": "क्रियाभ्युपायैरिन्द्रेण त्रिदिवं भुज्यते विभो ।\nक्रिया बलवती राजन् नान्यत् किञ्चिद् युधिष्ठिर\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2174455, "chapter_id": 4704, "verse_number": "१७", "content_sanskrit": "दैत्याश्च बहवो राजन् राक्षसाः पार्थिवास्तथा ।\nक्रियाभ्युपायैर्निहताः क्रियां तस्मात् समाचर\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2174456, "chapter_id": 4704, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2174457, "chapter_id": 4704, "verse_number": "१८", "content_sanskrit": "इत्युक्तो वासुदेवेन पाण्डवः संशितव्रतः ।\nजलस्थं तं महाराज तव पुत्रं महारथम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2174458, "chapter_id": 4704, "verse_number": "१९", "content_sanskrit": "अभ्यभाषत कौन्तेयः प्रहसन्निव भारत\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2174459, "chapter_id": 4704, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2174460, "chapter_id": 4704, "verse_number": "२०", "content_sanskrit": "सुयोधन किमर्थोऽयमारम्भोऽप्सु कृतस्त्वया ।\nसर्वक्षत्रं घातयित्वा स्वजनं च विशाम्पते\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2174461, "chapter_id": 4704, "verse_number": "२१", "content_sanskrit": "जलाशयं प्रविष्टोऽद्य वाञ्छन् जीवितमात्मनः ।\nउत्तिष्ठ राजन् युद्धाय सहास्माभिः सुयोधन\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2174462, "chapter_id": 4704, "verse_number": "२२", "content_sanskrit": "क्व ते दर्पो नरश्रेष्ठ स च मानः क्व ते गतः ।\nयस्त्वं संस्तम्भ्य सलिलं राजन् भीतो व्यवस्थितः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2174463, "chapter_id": 4704, "verse_number": "२३", "content_sanskrit": "सर्वे त्वां शूर इत्येवं जना जल्पन्ति संसदि ।\nव्यर्थं तद् भवतो मन्ये शौर्यं सलिलशायिनः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2174464, "chapter_id": 4704, "verse_number": "२४", "content_sanskrit": "उत्तिष्ठ राजन् युध्यस्व क्षत्रियोऽसि कुलोद्भवः ।\nकौरवेयो विशेषेण कुलं जन्म च संस्मर\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2174465, "chapter_id": 4704, "verse_number": "२५", "content_sanskrit": "स कथं कौरवे वंशे प्रशस्तं जन्म चात्मनः ।\nयुद्ध्वा त्रस्तस्ततस्तोयं प्रविश्य प्रतितिष्ठसि\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2174466, "chapter_id": 4704, "verse_number": "२६", "content_sanskrit": "अयुद्धेन व्यवस्थानं नैष धर्मः सनातनः ।\nअनार्यजुष्टमस्वर्ग्यं रणाद् राज्ञः पलायनम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2174467, "chapter_id": 4704, "verse_number": "२७", "content_sanskrit": "कथं पारमगत्वा हि युद्धं त्वं वै जिजीविषुः ।\nइमान् निपतितान् दृष्ट्वा पुत्रान् भ्रातॄन् पितॄन् सखीन्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2174468, "chapter_id": 4704, "verse_number": "२८", "content_sanskrit": "सम्बन्धिनो बान्धवांश्च वयस्यान् मातुलांस्तथा ।\nघातयित्वा कथं तात ह्रदे तिष्ठसि साम्प्रतम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2174469, "chapter_id": 4704, "verse_number": "२९", "content_sanskrit": "शूरमानी न शूरस्त्वं मिथ्या वदसि कौरव ।\nशूरोऽहमिति दुर्बुद्धे सर्वलोकस्य पश्यतः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2174470, "chapter_id": 4704, "verse_number": "३०", "content_sanskrit": "न हि शूराः पलायन्ते शत्रून् दृष्ट्वा कथञ्चन ।\nब्रूहि वा त्वं यया वृत्त्या शूरस्त्यजसि संयुगम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2174471, "chapter_id": 4704, "verse_number": "३१", "content_sanskrit": "स त्वमुत्तिष्ठ युध्यस्व विहाय भयमात्मनः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2174472, "chapter_id": 4704, "verse_number": "३२", "content_sanskrit": "पातयित्वा सर्वसैन्यान् भ्रातॄंश्चैव सुयोधन ।\nनेदानीं जीविते बुद्धिः कार्या धर्मचिकीर्षया\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2174473, "chapter_id": 4704, "verse_number": "३३", "content_sanskrit": "क्षत्रधर्मं समाश्रित्य त्वद्विधेन सुयोधन\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2174474, "chapter_id": 4704, "verse_number": "३४", "content_sanskrit": "यत्तु कर्णमुपाश्रित्य शकुनिं चापि सौबलम् ।\nदुःशासनं च मोहात् त्वमात्मानं नावबुद्धवान्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2174475, "chapter_id": 4704, "verse_number": "३५", "content_sanskrit": "तत् पापं सुमहत् कृत्वा प्रतियुध्यस्व भारत\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2174476, "chapter_id": 4704, "verse_number": "३६", "content_sanskrit": "कथं हि त्वद्विधो मोहाद् रोचयेत पलायनम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2174477, "chapter_id": 4704, "verse_number": "३७", "content_sanskrit": "क्व चैतत् पौरुषं यातं क्व च मानः सुयोधन ।\nक्व च विक्रान्तता याता किं नु शेषे जलाशये\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2174478, "chapter_id": 4704, "verse_number": "३८", "content_sanskrit": "स त्वमुत्तिष्ठ युध्यस्व क्षत्रधर्मेण भारत\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2174479, "chapter_id": 4704, "verse_number": "३९", "content_sanskrit": "अस्मान् वा त्वं पराजित्य प्रशाधि पृथिवीमिमाम् ।\nअथवा निहतोऽस्माभिः भूमौ स्वप्स्यसि भारत\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2174480, "chapter_id": 4704, "verse_number": "४०", "content_sanskrit": "एष ते प्रथमो धर्मः सृष्टो धात्रा महात्मना ।\nतं कुरुष्व यथातथ्यं राजा भव महारथ\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2174481, "chapter_id": 4704, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2174482, "chapter_id": 4704, "verse_number": "४१", "content_sanskrit": "एवमुक्तो महाराज धर्मपुत्रेण धीमता ।\nसलिलस्थस्तव सुत इदं वचनमब्रवीत्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2174483, "chapter_id": 4704, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2174484, "chapter_id": 4704, "verse_number": "४२", "content_sanskrit": "नैतच्चित्रं महाराज यद् भीः प्राणिनमाविशेत् ।\nन च प्राणभयाद् भीतो व्यपयातोऽस्मि भारत\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2174485, "chapter_id": 4704, "verse_number": "४३", "content_sanskrit": "विरथश्चानिषङ्गी च निहतः पार्ष्णिसारथिः ।\nएकश्च विगणः सोऽहं प्रत्याश्वासमरोचयम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2174486, "chapter_id": 4704, "verse_number": "४४", "content_sanskrit": "न प्राणहेतोर्न भयान्न विषादाद् विशाम्पते ।\nइदमम्भः प्रविष्टोऽस्मि श्रमात्त्विदमनुष्ठितम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2174487, "chapter_id": 4704, "verse_number": "४५", "content_sanskrit": "त्वं चाश्वसिहि कौन्तेय ये चाप्यनुगतास्तव ।\nअहमुत्थाय वः सर्वान् प्रतियोद्धास्मि संयुगे\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2174488, "chapter_id": 4704, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2174489, "chapter_id": 4704, "verse_number": "४६", "content_sanskrit": "आश्वस्ताश्च वयं सर्वे चिरं त्वां मृगयामहे ।\nत्वमिदानीं समुत्तिष्ठ युद्धस्वेह सुयोधन\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2174490, "chapter_id": 4704, "verse_number": "४७", "content_sanskrit": "हत्वा च समरे पार्थान् स्फीतं राज्यमावप्नुहि ।\nनिहतो वा रणेऽस्माभिर्वीरलोकं गमिष्यसि\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2174491, "chapter_id": 4704, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2174492, "chapter_id": 4704, "verse_number": "४८", "content_sanskrit": "यदर्थं राज्यमिच्छेयं कुरूणां कुरुनन्दन ।\nत इमे निहताः सर्वे भ्रातरो मे जनेश्वर\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2174493, "chapter_id": 4704, "verse_number": "४९", "content_sanskrit": "क्षीणरत्नां च पृथिवीं हतक्षत्रियपुङ्गवाम् ।\nनैतामिच्छाम्यहं भोक्तुं विधवामिव योषितम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2174494, "chapter_id": 4704, "verse_number": "५०", "content_sanskrit": "अद्यापि त्वहमाशंसे त्वां विजेतुं युधिष्ठिर ।\nभङ्क्त्वा पाञ्चालपाण्डूनामुत्साहं भरतर्षभ\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2174495, "chapter_id": 4704, "verse_number": "५१", "content_sanskrit": "न त्विदानीमहं मन्ये कार्यं युद्धेन केनचित् ।\nद्रोणे कर्णे च संशान्ते निहते च पितामहे\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2174496, "chapter_id": 4704, "verse_number": "५२", "content_sanskrit": "अस्त्विदानीमियं राजन् केवला पृथिवी तव ।\nअसहायो हि को राजा राज्यमिच्छेत् प्रशासितुम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2174497, "chapter_id": 4704, "verse_number": "५३", "content_sanskrit": "सुहृदस्तादृशान् हित्वा पुत्रान् भ्रातॄन् पितॄनपि ।\nभवद्भिश्च हृते राज्ये को नु जीवेत मादृशः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2174498, "chapter_id": 4704, "verse_number": "५४", "content_sanskrit": "अहं वनं गमिष्यामि अजिनैः परिवारितः ।\nरतिर्हि नास्ति मे राज्ये हतपक्षस्य भारत\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2174499, "chapter_id": 4704, "verse_number": "५५", "content_sanskrit": "हतबान्धवभूयिष्ठा हताश्वा हतकुञ्जरा ।\nएषा ते पृथिवी राजन् भुङ्क्ष्वैनां विगतज्वरः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2174500, "chapter_id": 4704, "verse_number": "५६", "content_sanskrit": "वनमेव गमिष्यामि वासितो मृगचर्मणा ।\nन हि मे निर्जितस्यास्ति जीवितेऽद्य स्पृहा विभो\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2174501, "chapter_id": 4704, "verse_number": "५७", "content_sanskrit": "गच्छ त्वं भुङ्क्ष्व राजेन्द्र पृथिवीं निहतद्विषम् ।\nहतयोधां नष्टरत्नां शीर्णक्षत्रां यथासुखम्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2174502, "chapter_id": 4704, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2174503, "chapter_id": 4704, "verse_number": "५८", "content_sanskrit": "दुर्योधनं तव सुतं सलिलस्थं महायशाः ।\nश्रुत्वा तु करुणं वाक्यमभाषत युधिष्ठिरः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2174504, "chapter_id": 4704, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2174505, "chapter_id": 4704, "verse_number": "५९", "content_sanskrit": "आर्तप्रलापं मा तात सलिलस्थः प्रभाषथाः ।\nनैतन्मे रोचते राजन् वाशितं शकुनेरिव\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2174506, "chapter_id": 4704, "verse_number": "६०", "content_sanskrit": "यदि वाऽपि समर्थः स्यास्त्वं दानाय सुयोधन ।\nनाहमिच्छेयमवनिं त्वया दत्तां प्रशासितुम्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2174507, "chapter_id": 4704, "verse_number": "६१", "content_sanskrit": "अधर्मेण न गृह्णीयां त्वया दत्तां महीमिमाम् ।\nन हि धर्मो भवेद् राजन् क्षत्रियस्य प्रतिग्रहः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2174508, "chapter_id": 4704, "verse_number": "६२", "content_sanskrit": "त्वया दत्तां न चेच्छेयं पृथिवीमखिलामपि ।\nत्वां च युद्धे विनिर्जित्य भोक्तास्मि वसुधामिमाम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2174509, "chapter_id": 4704, "verse_number": "६३", "content_sanskrit": "अनीश्वरश्च पृथिवीं कथं त्वं दातुमिच्छसि ।\nत्वयैषा पृथिवी राजन् किं न दत्ता तदैव हि\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2174510, "chapter_id": 4704, "verse_number": "६४", "content_sanskrit": "धर्मतो याचमानस्य शमार्थं च कुलस्य नः ।\nवार्ष्णेयः प्रथमं राजन् प्रत्याख्यातो महाबलः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2174511, "chapter_id": 4704, "verse_number": "६५", "content_sanskrit": "किमिदानीं ददास्यद्य को हि ते चित्तविभ्रमः ।\nअभियुक्तो हि को राजन् दातुमिच्छति मेदिनीम्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2174512, "chapter_id": 4704, "verse_number": "६६", "content_sanskrit": "न त्वमद्य महीं दातुम् ईशः कौरवनन्दन ।\nआच्छेत्तुं वा बलाद् राजन् स कथं दातुमिच्छसि\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2174513, "chapter_id": 4704, "verse_number": "६७", "content_sanskrit": "मां त्वं निर्जित्य सङ्ग्रामे पालयेमां वसुन्धराम्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2174514, "chapter_id": 4704, "verse_number": "६८", "content_sanskrit": "सूच्यग्रेणापि यद् भूमेरपि दीर्येत भारत ।\nतन्मात्रमपि वै मह्यं न ददाति पुरा भवान्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2174515, "chapter_id": 4704, "verse_number": "६९", "content_sanskrit": "स कथं पृथिवीमेनां प्रददासि विशाम्पते ।\nसूच्यग्रं नात्यजः पूर्वं स कथं त्यजसि क्षितिम्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2174516, "chapter_id": 4704, "verse_number": "७०", "content_sanskrit": "एवमैश्वर्यमासाद्य केवलं पृथिवीपते ।\nको नु मूढो व्यवस्येत शत्रोर्दातुं वसुन्धराम्\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2174517, "chapter_id": 4704, "verse_number": "७१", "content_sanskrit": "त्वं तु केवलमौर्ख्येण विमूढो नावबुध्यसे ।\nपृथिवीं दातुकामोऽपि जीवंस्त्वं न विमोक्ष्यसे\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2174518, "chapter_id": 4704, "verse_number": "७२", "content_sanskrit": "अस्मान् वा त्वं पराजित्य प्रशाधि पृथिवीमिमाम् ।\nअथवा निहतोऽस्माभिर्व्रज लोकाननुत्तमान्\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2174519, "chapter_id": 4704, "verse_number": "७३", "content_sanskrit": "आवयोर्जीवतो राजन् मयि च त्वयि च ध्रुवम् ।\nसंशयः सर्वभूतानां विजये नौ भविष्यति\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2174520, "chapter_id": 4704, "verse_number": "७४", "content_sanskrit": "जीवितं तव दुष्प्रापं मयि सम्प्रति वर्तते ।\nजीवयेयमहं पाप न त्वं जीवितुमर्हसि\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2174521, "chapter_id": 4704, "verse_number": "७५", "content_sanskrit": "दहने हि कृतो यत्नः त्वयाऽस्मासु विशेषतः ।\nआशीविषविषैश्चापि जले वाऽपि प्रवेशनैः\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2174522, "chapter_id": 4704, "verse_number": "७६", "content_sanskrit": "त्वया विनिकृता राजन् राज्यस्य हरणेन च\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2174523, "chapter_id": 4704, "verse_number": "७७", "content_sanskrit": "अप्रियाणां च वचनैः द्रौपद्या कर्षणेन च\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2174524, "chapter_id": 4704, "verse_number": "७८", "content_sanskrit": "एतस्मात् कारणात् पाप जीवितं ते न विद्यते ।\nउत्तिष्ठोत्तिष्ठ युध्यस्व तत्ते श्रेयो भविष्यति\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2174525, "chapter_id": 4704, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2174526, "chapter_id": 4704, "verse_number": "७९", "content_sanskrit": "एवं तु विविधा वाचो जययुक्ताः पुनः पुनः ।\nकीर्तयन्ति स्म ते वीराः तत्र तत्र नराधिप\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2174527, "chapter_id": 4704, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां गदापर्वणि द्वितीयोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}]