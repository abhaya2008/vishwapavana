[{"id": 2130544, "chapter_id": 3817, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2130545, "chapter_id": 3817, "verse_number": "१", "content_sanskrit": "तस्मिन् निवसमानोऽथ धर्मराजो युधिष्ठिरः ।\nकृष्णया सहितान् भ्रातॄनित्युवाच सहद्विजान्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2130546, "chapter_id": 3817, "verse_number": "२", "content_sanskrit": "दृष्टानि तीर्थान्यस्माभिः पुण्यानि च शिवानि च ।\nमनसो ह्लादनीयानि वनानि च पृथक्पृथक्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2130547, "chapter_id": 3817, "verse_number": "३", "content_sanskrit": "देवैः पूर्वं विचीर्णानि मुनिभिश्च महात्मभिः ।\nयथाक्रमं विशेषेण द्विजैः सम्पूजितानि च \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2130548, "chapter_id": 3817, "verse_number": "४", "content_sanskrit": "ऋषीणां पूर्वचरितं तथा कर्म विचेष्टितम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2130549, "chapter_id": 3817, "verse_number": "५", "content_sanskrit": "राजर्षीणां च चरितं कथाश्च विविधाः शुभाः ।\nशृण्वानास्तत्र तत्र स्म आश्रमेषु शिवेषु च ।\nअभिषेकं द्विजैः सार्धं कृतवन्तो विशेषतः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2130550, "chapter_id": 3817, "verse_number": "६", "content_sanskrit": "अर्चिताः सततं देवाः पुष्पैरद्भिः सदा च वः ।\nयथालब्धैर्मूलफलैः पितरश्चापि तर्पिताः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2130551, "chapter_id": 3817, "verse_number": "७", "content_sanskrit": "यथाक्रमं विशेषेण लोमशेन प्रभाषितम् ।\nपर्वतेषु च रम्येषु सर्वेषु च सरस्सु च ।\nउदधौ च महापुण्ये सूपस्पृष्टं महात्मभिः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2130552, "chapter_id": 3817, "verse_number": "८", "content_sanskrit": "इला सरस्वती सिन्धुर्यमुना नर्मदा तथा ।\nनानातीर्थेषु रम्येषु सूपस्पृष्टं सह द्विजैः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2130553, "chapter_id": 3817, "verse_number": "९", "content_sanskrit": "गङ्गाद्वारमतिक्रम्य बहवः पर्वताः शुभाः ।\nहिमवान् पर्वतश्चैव नानाद्विजगणायुतः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2130554, "chapter_id": 3817, "verse_number": "१०", "content_sanskrit": "विशाला बदरी दृष्टा नरनारायणाश्रमः ।\nदिव्या पुष्करिणी दृष्टा सिद्धदेवर्षिपूजिता\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2130555, "chapter_id": 3817, "verse_number": "११", "content_sanskrit": "यथाक्रमविशेषेण सर्वाण्यायतनानि च ।\nदर्शितानि द्विजश्रेष्ठा लोमशेन महात्मना\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2130556, "chapter_id": 3817, "verse_number": "१२", "content_sanskrit": "इमं वैश्रवणावासं पुण्यं सिद्धनिषेवितम् ।\nकथं भीम गमिष्यामो गतिरत्र विधीयताम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2130557, "chapter_id": 3817, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2130558, "chapter_id": 3817, "verse_number": "१३", "content_sanskrit": "एवं ब्रुवति राजेन्द्रे वागुवाचाशरीरिणी ।\nन शक्यो दुर्गमो गन्तुमितो वैश्रवणाश्रमः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2130559, "chapter_id": 3817, "verse_number": "१४", "content_sanskrit": "अनेनैव पथा राजन् प्रतिगच्छ यथागतम्।\nनरनारायणस्थानं बदरीत्यभिविश्रुतम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2130560, "chapter_id": 3817, "verse_number": "१५", "content_sanskrit": "तस्माद् यास्यसि कौन्तेय सिद्धचारणसेवितम् ।\nबहुपुष्पफलं रम्यमाश्रमं वृषपर्वणः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2130561, "chapter_id": 3817, "verse_number": "१६", "content_sanskrit": "अतिक्रम्य च तं पार्थ चार्ष्टिषेणाश्रमे वसेः ।\nततो द्रक्ष्यसि कौन्तेय निवेशं धनदस्य च \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2130562, "chapter_id": 3817, "verse_number": "१७", "content_sanskrit": "एतस्मिन्नन्तरे वायुर्दिव्यगन्धवहः शुचिः ।\nसुखप्रह्लादनः शीतः पुष्पवर्षं ववर्ष च \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2130563, "chapter_id": 3817, "verse_number": "१८", "content_sanskrit": "श्रुत्वा तु दिव्यामाकाशाद् वाचं सर्वे विसिस्मियुः ।\nऋषीणां ब्राह्मणानां च पार्थिवानां विशेषतः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2130564, "chapter_id": 3817, "verse_number": "१९", "content_sanskrit": "श्रुत्वा तन्महदाश्चर्यं द्विजो धौम्योऽब्रवीत् तदा ।\nन शक्यमुत्तरं वक्तुमेवं भवतु भारत\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2130565, "chapter_id": 3817, "verse_number": "२०", "content_sanskrit": "ततो युधिष्ठिरो राजा प्रतिजग्राह तद्वचः ।\nप्रत्यागम्य पुनस्तं तु नरनारायणाश्रमम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2130566, "chapter_id": 3817, "verse_number": "२१", "content_sanskrit": "भीमसेनादिभिः सर्वैर्भ्रातृभिः परिवारितः ।\nपाञ्चाल्या ब्राह्मणाश्चैव न्यवसन्त सुखं तदा\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2130567, "chapter_id": 3817, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि लोमशतीर्थयात्रायां पुनर्नरनारायणाश्रमागमने\nद्विपञ्चाशदधिकशततमोऽध्यायः ॥ १५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2130568, "chapter_id": 3817, "verse_number": "१०८", "content_sanskrit": "॥ इति तीर्थयात्रापर्वणि अष्टाधिकशततमोऽध्यायः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2130569, "chapter_id": 3817, "verse_number": "", "content_sanskrit": "॥ समाप्तं तीर्थयात्रापर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]