[{"id": 2138805, "chapter_id": 4006, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2138806, "chapter_id": 4006, "verse_number": "१", "content_sanskrit": "ततः कृष्णा सुकेशी सा दर्शनीया शुचिस्मिता ।\nवेणीकेशान्तमुत्क्षिप्य पीनवृत्तपयोधरा\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2138807, "chapter_id": 4006, "verse_number": "२", "content_sanskrit": "जुगूह दक्षिणे पार्श्वे मृदूनसितलोचना\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2138808, "chapter_id": 4006, "verse_number": "३", "content_sanskrit": "वासश्च परिधायैकं कृष्णं सुमलिनं महत् ।\nकृत्वा वेषं च सैरन्ध्र्याः कृष्णा व्यचरदार्तवत्\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2138809, "chapter_id": 4006, "verse_number": "४", "content_sanskrit": "प्रविष्टा नगरं भीरुः सैरन्ध्रीवेषसंयुता ।\nतां नराः गच्छमानां तु स्त्रियश्च समुपाद्रवत्\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2138810, "chapter_id": 4006, "verse_number": "५", "content_sanskrit": "अपृच्छंस्ते च तां दृष्ट्वा का त्वं किं च चिकीर्षसि\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2138811, "chapter_id": 4006, "verse_number": "६", "content_sanskrit": "सा तानुवाच राजेन्द्र सैरन्ध्य्रहमुपागता ।\nकर्म चेच्छामि वै कर्तुं तस्या या मां भरिष्यसि\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2138812, "chapter_id": 4006, "verse_number": "७", "content_sanskrit": "तस्या वेषेण रूपेण श्लक्ष्णया च गिरा तथा ।\nन च श्रद्धधतां दासीमन्नहेतोरुपस्थिताम्\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2138813, "chapter_id": 4006, "verse_number": "८", "content_sanskrit": "विराटस्य तु कैकेयी भार्या परमसम्मता ।\nआलोकयन्ती ददृशे प्रासादाद् द्रुपदात्मजाम्\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2138814, "chapter_id": 4006, "verse_number": "९", "content_sanskrit": "सा समीक्ष्य तथारूपामनाथामेकवाससीम् ।\nस्त्रीभिश्च पुरुषैश्चापि सर्वतः परिवारिताम्\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2138815, "chapter_id": 4006, "verse_number": "१०", "content_sanskrit": "विराटभार्या तां देवीं कारुण्याज्जातसम्भ्रमा ।\nअप्रेषयत् समीपस्थाः स्त्रियो वृद्धाश्च सम्मताः\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2138816, "chapter_id": 4006, "verse_number": "११", "content_sanskrit": "अनुनीय ततः सर्वा आनयध्वमिहैव ताम् ।\nयदा दृष्टा मया साध्वी कम्पते मे मनस्तदा\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2138817, "chapter_id": 4006, "verse_number": "१२", "content_sanskrit": "तस्माच्छीघ्रमिहानाय्य दर्शयध्वं यदीच्छति\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2138818, "chapter_id": 4006, "verse_number": "१३", "content_sanskrit": "तास्तथोक्ता उपागम्य द्रौपदीं परिसङ्गताः ।\nआनीय सर्वथा त्वेनामब्रुवन् मधुरां गिरम्\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2138819, "chapter_id": 4006, "verse_number": "१४", "content_sanskrit": "भद्रे त्वां द्रष्टुमिच्छन्ती सुदेष्णा हर्म्यभूतळे ।\nस्थिता त्वदर्थं हि वयं त्वत्समीपमुपागताः\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2138820, "chapter_id": 4006, "verse_number": "१५", "content_sanskrit": "त्वदर्थं प्रेषयच्चास्मान् द्रष्टुं तां त्वं यदीच्छसि ।\nआयाह्यस्माभिरेवाद्य रक्ष्यमाणा यथेष्टतः\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2138821, "chapter_id": 4006, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2138822, "chapter_id": 4006, "verse_number": "१६", "content_sanskrit": "तच्छ्रुत्वा द्रौपदी तासां वचनं वाक्यकोविदा ।\nईप्सितार्थातिलाभेन हृष्टा याता गृहोत्तमम्\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2138823, "chapter_id": 4006, "verse_number": "१७", "content_sanskrit": "अथ सा छिन्नपट्टाभ्यां वल्कलाजिनसंवृता ।\nराजवेश्म समागम्य यत्राग्र्यमहिषी स्थिता\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2138824, "chapter_id": 4006, "verse_number": "१८", "content_sanskrit": "सुदेष्णामगमत् कृष्णा राजभार्यां यशस्विनीम्\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2138825, "chapter_id": 4006, "verse_number": "१९", "content_sanskrit": "कृष्णान् केशान् मृदून् दीर्घान् समुद्ग्रथ्यासितेक्षणा ।\nकुञ्चिताग्रान् सुसूक्ष्माग्रान् दर्शनीयान् निबद्ध्य च\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2138826, "chapter_id": 4006, "verse_number": "२०", "content_sanskrit": "जुगूह दक्षिणे पार्श्वे मृदूनसितलोचना\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2138827, "chapter_id": 4006, "verse_number": "२१", "content_sanskrit": "सा प्रविश्य विराटस्य द्रौपद्यन्तःपुरं शुभा ।\nह्रीनिषेवान्विता बाला कम्पमाना लतेव सा\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2138828, "chapter_id": 4006, "verse_number": "२२", "content_sanskrit": "अभिगम्य च सुश्रोणी सर्वलक्षणसंयुता ।\nददर्शावस्थितां हैमे पीठे रत्नपरिच्छदे\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2138829, "chapter_id": 4006, "verse_number": "२३", "content_sanskrit": "रक्तसूक्ष्मांशुकधरां मेघे सौदामिनीमिव ।\nनानावर्णविचित्रां च सर्वाभरणभूषिताम्\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2138830, "chapter_id": 4006, "verse_number": "२४", "content_sanskrit": "सुभ्रूं सुकेशीं सुश्रोणीं कुब्जवामनमध्यगाम् ।\nबहुपुष्पोपकीर्णायां भूम्यां वेदीमिवाध्वरे\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2138831, "chapter_id": 4006, "verse_number": "२५", "content_sanskrit": "सुदेष्णां राजमहिषीं सर्वालङ्कारसंयुताम्\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2138832, "chapter_id": 4006, "verse_number": "२६", "content_sanskrit": "ताः सर्वा द्रौपदीं दृष्ट्वा सन्तप्ताः परमाङ्गनाः ।\nत्वरिताश्चोपतस्थुस्तां सहसोत्थाय चासनात्\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2138833, "chapter_id": 4006, "verse_number": "२७", "content_sanskrit": "निरीक्षमाणास्ताः सर्वाः शचीं देवीमिवागताम् ।\nगूढगुल्फां वरारोहां कृष्णां ताम्रायतेक्षणाम्\t ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2138834, "chapter_id": 4006, "verse_number": "२८", "content_sanskrit": "अतिसर्वानवद्याङ्गीं तनुगात्रीं सुमध्यमाम्\t ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2138835, "chapter_id": 4006, "verse_number": "२९", "content_sanskrit": "नातिह्रस्वां न महतीं जातां बहुतृणे वने ।\nमृगरोहीमिवानिन्द्यां सुकेशीं मृगलोचनाम्\t ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2138836, "chapter_id": 4006, "verse_number": "३०", "content_sanskrit": "मृगरोहीमिवानीतां यूथभ्रष्टामिव द्विपाम् ।\nलक्ष्मीमिव विशालाक्षीं विद्यामिव यशस्विनीम्\t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2138837, "chapter_id": 4006, "verse_number": "३१", "content_sanskrit": "रोहिणीमिव ताराणां दीप्तामग्निशिखामिव ।\nपार्वतीमिव रुद्राणीं वेलामिव महोदधेः\t ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2138838, "chapter_id": 4006, "verse_number": "३२", "content_sanskrit": "सुलभामिव नागीनां मृगीणामिव किन्नरीम् ।\nगङ्गामिव विशुद्धाङ्गीं शारदीमिव शार्वरीम्\t ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2138839, "chapter_id": 4006, "verse_number": "३३", "content_sanskrit": "तामचिन्त्यतमां लोके इलामिव यशस्विनीम् ।\nसावित्रीमिव दुर्धर्षां ब्राह्म्या लक्ष्म्या समन्विताम्\t ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2138840, "chapter_id": 4006, "verse_number": "३४", "content_sanskrit": "सुदेष्णा पर्यपृच्छत् तां विस्मयोत्फुल्ललोचना\t ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2138841, "chapter_id": 4006, "verse_number": "३५", "content_sanskrit": "का त्वं सर्वानवद्याङ्गि कुतोऽसि त्वमिहागता ।\nकस्य वा त्वं विशालाक्षि किं वा ते करवाण्यहम्\t ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2138842, "chapter_id": 4006, "verse_number": "३६", "content_sanskrit": "गूढगुल्फा समानोरूः त्रिगम्भीरा षडुन्नता ।\nरक्ता पञ्चसु रक्तेषु हंसगद्गदभाषिणी\t ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2138843, "chapter_id": 4006, "verse_number": "३७", "content_sanskrit": "सुकेशी सुस्वरा श्यामा पीनश्रोणिपयोधरा ।\nअरालपक्ष्मनयना बिम्बोष्ठी तनुमध्यमा\t ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2138844, "chapter_id": 4006, "verse_number": "३८", "content_sanskrit": "कम्बुग्रीवा गूढसिरा पूर्णचन्द्रनिभानना ।\nदानवी किन्नरी वा त्वं गन्धर्वी वनदेवता\t ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2138845, "chapter_id": 4006, "verse_number": "३९", "content_sanskrit": "अप्सरा वाऽसि नागी वा तारा वा त्वं विलासिनी ।\nअलम्बुसा मिश्रकेशी पुण्डरीकाऽक्षमालिनी\t ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2138846, "chapter_id": 4006, "verse_number": "४०", "content_sanskrit": "तेन तेनैव सम्पन्ना काश्मीरीव तुरङ्गमा ।\nइन्द्राणी त्वथ रुद्राणी स्वाहा वाऽप्यथवा रतिः\t ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2138847, "chapter_id": 4006, "verse_number": "४१", "content_sanskrit": "देवि देवीषु विख्याता ब्रूहि का त्वमिहागता ।\nतव ह्यनुपमं रूपं भूषणैरपि वर्जितम्\t ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2138848, "chapter_id": 4006, "verse_number": "४२", "content_sanskrit": "त्वां सृष्ट्वोपरतं मन्ये लोककर्तारमीश्वरम् ।\nन तृप्यन्ति स्त्रियो दृष्ट्वा का न पुंसां रतिर्भवेत्\t ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2138849, "chapter_id": 4006, "verse_number": "", "content_sanskrit": "द्रौपदी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2138850, "chapter_id": 4006, "verse_number": "४३", "content_sanskrit": "नास्मि देवी न गन्धर्वी न यक्षी न च किन्नरी ।\nसैरन्ध्री नाम मे जातिर्वन्यमूलफलाशना\t ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2138851, "chapter_id": 4006, "verse_number": "४४", "content_sanskrit": "पतीनां प्रेक्षमाणानां कस्मिंश्चित् कारणान्तरे ।\nकेशपक्षे परामृष्टा साऽहं त्रस्ता वनं गता\t ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2138852, "chapter_id": 4006, "verse_number": "४५", "content_sanskrit": "तत्र द्वादशवर्षाणि वन्यमूलफलाशना ।\nचराम्यनिलया सुभ्रु सा तवान्तिकमागता\t ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2138853, "chapter_id": 4006, "verse_number": "४६", "content_sanskrit": "जानामि केशान् ग्रथितुं जानामि ग्रथितुं मणीन् ।\nमल्लिकोत्पलपद्मानां जानामि ग्रथितुं स्रजः\t ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2138854, "chapter_id": 4006, "verse_number": "४७", "content_sanskrit": "सिन्धुवारकजातीनां रचयाम्यवतंसकान्\t ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2138855, "chapter_id": 4006, "verse_number": "४८", "content_sanskrit": "पत्रं मृगाङ्गमगरुं पिङ्क्षे च हरिचन्दनम् ।\nप्रथयिष्यामि चित्राश्च स्रजः परमशोभनाः\t ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2138856, "chapter_id": 4006, "verse_number": "४९", "content_sanskrit": "आराधयं सत्यभामां कृष्णस्य महिषीं प्रियाम् ।\nकृष्णां च भार्यां पार्थानां नारीणामुत्तमां तथा\t ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2138857, "chapter_id": 4006, "verse_number": "५०", "content_sanskrit": "तयाऽस्मि सुभृता चाहमिष्टलाभेन तोषिता ।\nमालिनीति च मे नाम स्वयं देवी चकार ह\t ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2138858, "chapter_id": 4006, "verse_number": "५१", "content_sanskrit": "कृष्णा कमलपत्राक्षी सा मे प्राणसमा सखी\t ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2138859, "chapter_id": 4006, "verse_number": "५२", "content_sanskrit": "न चाहं चिरमिच्छामि क्वचिद् वस्तुं शुभानने ।\nव्रतं किलैतदस्माकं कुलधर्मोऽयमीदृशः\t ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2138860, "chapter_id": 4006, "verse_number": "५३", "content_sanskrit": "यो ह्यस्माकं तु हरेद् द्रव्यं देशं वसनमेव वा ।\nन क्रोद्धव्यं किलास्माभिरस्मद्गुरुरमर्षणः\t ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2138861, "chapter_id": 4006, "verse_number": "५४", "content_sanskrit": "साऽहं वनानि दुर्गाणि तीर्थानि च सरांसि च ।\nशैलांश्च विविधान् रम्यान् सरितश्च समुद्रगाः\t ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2138862, "chapter_id": 4006, "verse_number": "५५", "content_sanskrit": "भर्तृशोकपरीताङ्गी भर्तुश्च ब्रह्मचारिणी ।\nविचरामि महीं दुर्गां यत्रसायंनिवेशना\t ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2138863, "chapter_id": 4006, "verse_number": "५६", "content_sanskrit": "वीरपत्नी यदा देवी चरमाणेषु भर्तृषु ।\nसाऽहं विवत्सा विधिना गन्धमादनपर्वतात्\t ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2138864, "chapter_id": 4006, "verse_number": "५७", "content_sanskrit": "शृणोमि तव सौशील्यं भर्तुर्मधुरभाषिणि\t ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2138865, "chapter_id": 4006, "verse_number": "५८", "content_sanskrit": "माहात्म्यं च ततः श्रुत्वा ब्राह्मणानां समीपतः ।\nत्वामुपस्थातुमिच्छामि ततश्चाहमिहागता\t ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2138866, "chapter_id": 4006, "verse_number": "५९", "content_sanskrit": "गुरवो मम धर्मश्च वायुः शक्रस्तथाऽश्विनौ ।\nतेषां प्रसादाच्च न मां कश्चिद् धर्षयते पुमान्\t ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2138867, "chapter_id": 4006, "verse_number": "", "content_sanskrit": "सुदेष्णा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2138868, "chapter_id": 4006, "verse_number": "६०", "content_sanskrit": "न भरेयमहं भद्रे संशयो मम विद्यते ।\nराजा त्वयं हि त्वां दृष्ट्वा मतिं पापां करिष्यति\t ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2138869, "chapter_id": 4006, "verse_number": "६१", "content_sanskrit": "साऽहं त्वां न क्षमां मन्ये वसन्तीमिह वेश्मनि ।\nएष दोषोऽत्र सुश्रोणि कथं वा भीरु मन्यसे\t ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2138870, "chapter_id": 4006, "verse_number": "६२", "content_sanskrit": "स्थिता राजकुले नार्यो याश्चेमा मम वेश्मनि ।\nत्वामेवैता निरीक्षन्ते विस्मयाद् वरवर्णिनि\t ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2138871, "chapter_id": 4006, "verse_number": "६३", "content_sanskrit": "वृक्षांश्चोपस्थितान् पश्य य इमे मम वेश्मनि ।\nविनमन्ते हि त्वां दृष्ट्वा पुमांसं कं न लोभयेः\t ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2138872, "chapter_id": 4006, "verse_number": "६४", "content_sanskrit": "राजा विराटः सुश्रोणि दृष्ट्वा ते परमं वपुः ।\nमां विहाय वरारोहे त्वां गच्छेत् सर्वचेतसा\t ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2138873, "chapter_id": 4006, "verse_number": "६५", "content_sanskrit": "यं हि त्वमनवद्याङ्गी नरमायतलोचने ।\nसुप्रसन्ना हि वीक्षेथाः स कामवशगो भवेत्\t ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2138874, "chapter_id": 4006, "verse_number": "६६", "content_sanskrit": "सुस्नाताऽलङ्कृता च त्वं यमीक्षेथा हि मानवम् ।\nग्लानिर्न तस्य दुःखं वा न तन्द्रिर्न पराजयः\t ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2138875, "chapter_id": 4006, "verse_number": "६७", "content_sanskrit": "न शोचेन्न च सम्पश्येन्न च क्रुध्येन्नानृतं वदेत्\t ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2138876, "chapter_id": 4006, "verse_number": "६८", "content_sanskrit": "यं त्वं सर्वानवद्याङ्गि भजेथाः समलङ्कृता ।\nन व्याधिर्न जरा तस्य न च तृष्णा न क्षुधा भवेत्\t ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2138877, "chapter_id": 4006, "verse_number": "६९", "content_sanskrit": "यस्य त्वं वशगा सुभ्रु भवेरङ्कगता सती ।\nपञ्चत्वमपि सम्प्राप्तं यं च त्वं पुरुषं स्वजेः\t ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2138878, "chapter_id": 4006, "verse_number": "७०", "content_sanskrit": "बाहुभ्यामनुरूपाभ्यां स जीवेदिति मे मतिः\t ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2138879, "chapter_id": 4006, "verse_number": "७१", "content_sanskrit": "यस्य तु त्वं भवेर्भार्या यं च हृष्टा परिष्वजेः ।\nअतिजीवेत् स सर्वेषु देवेष्विव पुरन्दरः\t ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2138880, "chapter_id": 4006, "verse_number": "७२", "content_sanskrit": "अध्यारोहेद् यथा वृक्षं वधायारुह्य तिष्ठति ।\nराजवेश्मनि लेखाग्र्या ननु स्यास्त्वं तथा मम\t ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2138881, "chapter_id": 4006, "verse_number": "७३", "content_sanskrit": "यथा कर्कटकी गर्भमाधत्ते मृत्युमात्मनः ।\nतथाविधमहं मन्ये तव सुभ्रु समागमम्\t ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2138882, "chapter_id": 4006, "verse_number": "७४", "content_sanskrit": "अनुमानये त्वां सैरन्ध्रि नावमन्ये कथञ्चन ।\nभर्तृशीलभयाद् भद्रे तव वासं न रोचते\t ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2138883, "chapter_id": 4006, "verse_number": "", "content_sanskrit": "सैरन्ध्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2138884, "chapter_id": 4006, "verse_number": "७५", "content_sanskrit": "नाहं शक्या विराटेन नापि चान्येन केनचित् ।\nदेवगन्धर्वयक्षैर्वा द्रष्टुं दुष्टेन चेतसा\t ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2138885, "chapter_id": 4006, "verse_number": "७६", "content_sanskrit": "गन्धर्वाः पालयन्ते मां सुकुल्याः पञ्च सुव्रताः ।\nपुत्रा देवादिदेवानां सूर्यपावकवर्चसः\t ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2138886, "chapter_id": 4006, "verse_number": "७७", "content_sanskrit": "यश्च दुःशीलवान् मर्त्यो मां स्पृशेद् दुष्टचेतसा ।\nस तामेव निशां शीघ्रं शयीत मुसलैर्हतः\t ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2138887, "chapter_id": 4006, "verse_number": "७८", "content_sanskrit": "यस्यापि हि शतं पूर्णं बान्धवानां भवेदिह ।\nसहस्रं वा विशालाक्षि कोटिर्वाऽपि सहस्रिका\t ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2138888, "chapter_id": 4006, "verse_number": "७९", "content_sanskrit": "दुष्टचित्तश्च मां ब्रूयान्न स जीवेत् तवाग्रतः\t ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2138889, "chapter_id": 4006, "verse_number": "८०", "content_sanskrit": "न तस्य त्रिदशा देवा नासुरा न च पन्नगाः ।\nतेभ्यो गन्धर्वराजेभ्यः त्राणं कुर्युरसंशयम्\t ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2138890, "chapter_id": 4006, "verse_number": "८१", "content_sanskrit": "सुतेषु च विसत्वं मे स्वजने बान्धवेषु वा ।\nनाहं शक्या नरैः स्प्रष्टुं न च मे वृत्तमीदृशम्\t ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2138891, "chapter_id": 4006, "verse_number": "८२", "content_sanskrit": "या मे न दद्यादुच्छिष्टं न च पादौ प्रधावयेत् ।\nप्रियै रत्नेन वस्त्रैर्वा गन्धर्वाः पतयो मम\t ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2138892, "chapter_id": 4006, "verse_number": "८३", "content_sanskrit": "यो मां हि पुरुषो गृद्ध्येद् यथाऽन्यां प्राकृतां स्त्रियम् ।\nतामेव स इमां रात्रिं प्रविशेदपरं तनुम्\t ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2138893, "chapter_id": 4006, "verse_number": "८४", "content_sanskrit": "न चाप्यहं चालयितुं शक्या केनचिदङ्गने ।\nदुःखशीला हि गन्धर्वाः ते च मे बलिनः प्रियाः\t ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2138894, "chapter_id": 4006, "verse_number": "८५", "content_sanskrit": "एवं निवसमानायां मयि मा ते भयं हि भूत्\t ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2138895, "chapter_id": 4006, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2138896, "chapter_id": 4006, "verse_number": "८६", "content_sanskrit": "एवमुक्ता तु सैरन्ध्र्या सुदेष्णा वाक्यमब्रवीत्\t ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2138897, "chapter_id": 4006, "verse_number": "८७", "content_sanskrit": "वसेह मयि कल्याणि यदि ते वृत्तमीदृशम् ।\nकश्च ते दातुमुच्छिष्टं पुमानर्हति शोभने\t ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2138898, "chapter_id": 4006, "verse_number": "८८", "content_sanskrit": "प्रधावयेच्च कः पादौ लक्ष्मीं दृष्ट्वैव बुद्धिमान्\t ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2138899, "chapter_id": 4006, "verse_number": "८९", "content_sanskrit": "एवमाचारसम्पन्ना एवं देवपरायणा ।\nवाक् च त्वमसि भूतानां सावित्रीव द्विजन्मनाम्\t ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2138900, "chapter_id": 4006, "verse_number": "९०", "content_sanskrit": "देवतेव हि कल्याणी पूजिता वरवर्णिनी ।\nवस भद्रे मया प्रीता प्रीतिर्हि मम वर्तते\t ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2138901, "chapter_id": 4006, "verse_number": "९१", "content_sanskrit": "सर्वकामैः प्रमुदिता निरुद्विग्नमनाः सुखम्\t ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2138902, "chapter_id": 4006, "verse_number": "९२", "content_sanskrit": "सुदेष्णयैवमुक्ता सा सुप्रीता चारुहासिनी ।\nनिर्विशङ्का विराटस्य विवेशान्तःपुरं तदा\t ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2138903, "chapter_id": 4006, "verse_number": "९३", "content_sanskrit": "याज्ञसेनी सुदेष्णां तु शिश्रूषन्ती विशाम्पते ।\nअवसत् परिचारार्हा सुदुःखं जनमेजय\t ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2138904, "chapter_id": 4006, "verse_number": "९४", "content_sanskrit": "एवं विराटे न्यवसन्त पाण्डवाः\nकृष्णा तथाऽन्तःपुरमेत्य शोभना ।\nअज्ञातचर्यां प्रतिरुद्धमानसा\nयथाऽग्नयो भस्मनि गूढचेतसः\t ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2138905, "chapter_id": 4006, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां विराटपर्वणि चतुर्दशोऽध्यायः ॥१४॥\nवैराटपर्वणि सैरन्ध्रीनिवासो नाम चतुर्दशोऽध्यायः ॥१४॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}]