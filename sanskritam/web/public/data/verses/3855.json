[{"id": 2132105, "chapter_id": 3855, "verse_number": "", "content_sanskrit": "वैशम्पायन उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2132106, "chapter_id": 3855, "verse_number": "१", "content_sanskrit": "निदाघान्तकरः कालः सर्वभूतसुखावहः ।\nतत्रैव वसतां तेषां प्रावृट् समभिपद्यत\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2132107, "chapter_id": 3855, "verse_number": "२", "content_sanskrit": "छादयन्तो महाघोषाः खं दिशश्च बलाहकाः ।\nप्रववर्षुर्दिवारात्रमसिताः सततं तदा\t॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2132108, "chapter_id": 3855, "verse_number": "३", "content_sanskrit": "तापात्ययनिकेताश्च शतशोऽथ सहस्रशः ।\nअपेतार्कप्रभाजालाः सविद्युद्विमलप्रभाः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2132109, "chapter_id": 3855, "verse_number": "४", "content_sanskrit": "विरूढशष्पा धरणी मत्तदंशसरीसृपा ।\nबभूव पयसा सिक्ता शान्ता सर्वमनोरमा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2132110, "chapter_id": 3855, "verse_number": "५", "content_sanskrit": "न स्म प्रज्ञायते किञ्चिदम्भसा समवस्तृते ।\nसमं वा विषमं वापि नद्यो वा स्थावराणि च \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2132111, "chapter_id": 3855, "verse_number": "६", "content_sanskrit": "क्षुब्धतोया महावेगाः श्वसमाना इवाशुगाः ।\nसिन्धवः शोभयाञ्चक्रुः काननानि तपात्यये\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2132112, "chapter_id": 3855, "verse_number": "७", "content_sanskrit": "नदतां काननान्तेषु श्रूयन्ते विविधाः स्वनाः ।\nवृष्टिभिश्च्छाद्यमानानां वराहमृगपक्षिणाम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2132113, "chapter_id": 3855, "verse_number": "८", "content_sanskrit": "स्तोककाः शिखिनश्चैव पुंस्कोकिलगणैः सह ।\nमत्ताः परिपतन्ति स्म दर्दुराश्चैव दर्पिताः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2132114, "chapter_id": 3855, "verse_number": "९", "content_sanskrit": "तथा बहुविधाकारा प्रावृण्मेघानुनादिता ।\nअभ्यतीता शिवा तेषां चरतां मरुधन्वसु\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2132115, "chapter_id": 3855, "verse_number": "१०", "content_sanskrit": "क्रौञ्चहंससमाकीर्णा शरत् प्रमुदिताभवत् ।\nरूढकक्षवनप्रस्था प्रसन्नजलनिम्नगा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2132116, "chapter_id": 3855, "verse_number": "११", "content_sanskrit": "विमलाकाशनक्षत्रा शरत्तेषां शिवाऽभवत् ।\nमृगद्विजसमाकीर्णा पाण्डवानां महात्मनाम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2132117, "chapter_id": 3855, "verse_number": "१२", "content_sanskrit": "दृश्यन्ते शान्तरजसः क्षपा जलदशीतलाः ।\nग्रहनक्षत्रसङ्घैश्च सोमेन च विराजिताः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2132118, "chapter_id": 3855, "verse_number": "१३", "content_sanskrit": "कुमुदैः पुण्डरीकैश्च शीतवारिधराः शिवाः ।\nनदीः पुष्करिणीश्चैव ददृशुः समलङ्कृताः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2132119, "chapter_id": 3855, "verse_number": "१४", "content_sanskrit": "आकाशसङ्काशजलां तीरवानीरसङ्कुलाम् ।\nबभूव चरतां हर्षः पुण्यतीर्थां सरस्वतीम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2132120, "chapter_id": 3855, "verse_number": "१५", "content_sanskrit": "ते वै मुमुदिरे वीराः प्रसन्नसलिलां शिवाम्।\nपश्यन्तो दृढधन्वानः परिपूर्णां सरस्वतीम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2132121, "chapter_id": 3855, "verse_number": "१६", "content_sanskrit": "तेषां पुण्यतमा रात्रिः पर्वसन्धौ स्म शारदी।\nतत्रैव वसतामासीत् कार्तिकी जनमेजय\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2132122, "chapter_id": 3855, "verse_number": "१७", "content_sanskrit": "पुण्यकृद्भिर्महासत्त्वैस्तापसैः सह पाण्डवाः ।\nतत्सर्वे भरतश्रेष्ठाः समूहुर्योगमुत्तमम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2132123, "chapter_id": 3855, "verse_number": "१८", "content_sanskrit": "तमिस्राभ्युदये तस्मिन्धौम्येन सह पाण्डवाः ।\nसूतैः पौरोगवैश्चैव काम्यकं प्रययुर्वनम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2132124, "chapter_id": 3855, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि मार्कण्डेयसमास्यापर्वणि काम्यकवनप्रवेशे षट्सप्तत्यधिकशततमोऽध्यायः ॥ १७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2132125, "chapter_id": 3855, "verse_number": "", "content_sanskrit": "मार्कण्डेयसमास्यापर्वणि प्रथमोऽध्यायः ॥१॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]