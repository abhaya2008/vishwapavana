[{"id": 2108554, "chapter_id": 3351, "verse_number": "", "content_sanskrit": "शौनकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2108555, "chapter_id": 3351, "verse_number": "१", "content_sanskrit": "भुजङ्गमानां शापस्य मात्रा चैव सुतेन च ।\nविनतायास्त्वया प्रोक्तं कारणं सूतनन्दन \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2108556, "chapter_id": 3351, "verse_number": "२", "content_sanskrit": "वरप्रदानं भर्त्रा च कद्रूविनतयोस्तथा ।\nनामनी चैव ते प्रोक्ते पक्षिणोर्वैनतेययोः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2108557, "chapter_id": 3351, "verse_number": "३", "content_sanskrit": "पन्नगानां तु नामानि न कीर्तयसि सूतज\nप्राधान्येनापि नामानि श्रोतुमिच्छामहे वयम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2108558, "chapter_id": 3351, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2108559, "chapter_id": 3351, "verse_number": "४", "content_sanskrit": "बहुत्वान्नामधेयानि भुजङ्गानां तपोधन ।\nन कीर्तयिष्ये सर्वेषां प्राधान्येन तु मे शृणु \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2108560, "chapter_id": 3351, "verse_number": "५", "content_sanskrit": "शेषः प्रथमतो जातो वासुकिस्तदनन्तरम् ।\nऐरावतस्तक्षकश्च कार्कोटकधनञ्जयौ\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2108561, "chapter_id": 3351, "verse_number": "६", "content_sanskrit": "काळियो मणिनागश्च नागश्चापूरणस्तथा ।\nनागस्तथा पञ्चशिरा एलापत्रोऽथ वामनः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2108562, "chapter_id": 3351, "verse_number": "७", "content_sanskrit": "नीलानीलौ तथा नागौ कल्माषशबळौ तथा ।\nआर्यकश्चार्द्रकश्चैव नागौ वै शलपोतकौ\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2108563, "chapter_id": 3351, "verse_number": "८", "content_sanskrit": "सुमना वै दधिमुखस्तथा विमलपिण्डकः ।\nविमलः पिण्डकश्चैव शङ्खो वालशिखस्तथा \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2108564, "chapter_id": 3351, "verse_number": "९", "content_sanskrit": "आप्तः कोटरकश्चैव शङ्खपालशिखिस्तथा ।\nनिष्ठूरको हेमगुहो नहुषः पिङ्गलस्तथा \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2108565, "chapter_id": 3351, "verse_number": "१०", "content_sanskrit": "बाह्यकण्ठो हस्तिबकस्तथा मुद्गरपिण्डकः ।\nकम्बलाश्वतरौ चापि नागः काळिकटस्तथा \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2108566, "chapter_id": 3351, "verse_number": "११", "content_sanskrit": "वृत्तसंवृत्तकौ चापि द्वौ च पद्माविति श्रुतौ ।\nनागः शङ्खणकश्चैव तथा कूष्माण्डकूर्पकौ \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2108567, "chapter_id": 3351, "verse_number": "१२", "content_sanskrit": "क्षेमकश्च महानागो नागः पाण्डरकस्तथा ।\nकरवीरः पुष्पदंष्ट्र एलको बिल्वपिण्डकः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2108568, "chapter_id": 3351, "verse_number": "१३", "content_sanskrit": "मूषिकादः शङ्खशिराः पूर्णदंष्ट्रो हरिद्रकः ।\nकुमुदः कुमुदाक्षश्च तित्तिरिर्हलिकस्तथा \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2108569, "chapter_id": 3351, "verse_number": "१४", "content_sanskrit": "अपराजितो ज्योतिकश्च पन्नगः श्रीवहस्तथा ।\nकौरव्यो धृतराष्ट्रश्च पुष्करः शल्यकस्तथा \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2108570, "chapter_id": 3351, "verse_number": "१५", "content_sanskrit": "विराजश्च सुबाहुश्च शालिपिण्डश्च वीर्यवान् ।\nहस्तिभद्रः पिठरकः मुखरः कोणनाशकः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2108571, "chapter_id": 3351, "verse_number": "१६", "content_sanskrit": "कुञ्जरः कुरकः शैलः तथा नागः प्रभाकरः ।\nकुमुदः कुमुदाक्षश्च तिकिरिर्मध्यतित्तिरिः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2108572, "chapter_id": 3351, "verse_number": "१७", "content_sanskrit": "कर्कराकर्करौ लोहौ कुण्डोदरमहोदरौ ।\nएते प्राधान्यतो नागाः कीर्तिता द्विजसत्तम \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2108573, "chapter_id": 3351, "verse_number": "१८", "content_sanskrit": "बहुत्वान्नामधेयानामितरे नानुकीर्तिताः ।\nएतेषां प्रसवो यश्च प्रसवस्य च सन्ततिः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2108574, "chapter_id": 3351, "verse_number": "१९", "content_sanskrit": "असङ्ख्येयेति मत्त्वा तान् न ब्रवीमि द्विजोत्तम ।\nबहूनि च सहस्राणि प्रयुतान्यर्बुदानि च ।\nअशक्यान्येव सङ्ख्यातुं भुजङ्गानां तपोधन \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2108575, "chapter_id": 3351, "verse_number": "३०", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि त्रिंशोऽध्यायः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2108576, "chapter_id": 3351, "verse_number": "१८", "content_sanskrit": "॥ आस्तीकपर्वणि अष्टादशोऽध्यायः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]