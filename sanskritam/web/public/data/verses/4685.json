[{"id": 2173056, "chapter_id": 4685, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2173057, "chapter_id": 4685, "verse_number": "१", "content_sanskrit": "पतितं प्रेक्ष्य यन्तारं शल्यः शैक्यायसीं गदाम् ।\nआदाय तरसा राजन् तस्थौ गिरिरिवाचलः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2173058, "chapter_id": 4685, "verse_number": "२", "content_sanskrit": "तं दीप्तमिव कालाग्निं पाशहस्तमिवान्तकम् ।\nसशृङ्गमिव कैलासं सवज्रमिव वासवम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2173059, "chapter_id": 4685, "verse_number": "३", "content_sanskrit": "सशूलमिव हि त्र्यक्षं सचक्रमिव चक्रिणम् ।\nसशक्तिमिव सेनान्यं वने मत्तमिव द्विपम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2173060, "chapter_id": 4685, "verse_number": "४", "content_sanskrit": "जवेनाभ्यद्रवद् भीमं प्रगृह्य महतीं गदाम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2173061, "chapter_id": 4685, "verse_number": "५", "content_sanskrit": "ततः शङ्खप्रणादश्च तूर्याणां च सहस्रशः ।\nसिंहनादश्च सञ्जज्ञे शूराणां हर्षवर्धनः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2173062, "chapter_id": 4685, "verse_number": "६", "content_sanskrit": "प्रेक्षन्ते सर्वतस्ते हि योधा मत्ताविव द्विपौ ।\nतावकाश्च परे चैव साधु साध्वित्यपूजयन्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2173063, "chapter_id": 4685, "verse_number": "७", "content_sanskrit": "न हि मद्राधिपादन्यो रामाद्वा यदुनन्दनात् ।\nसोढुमुत्सहते वेगं भीमसेनस्य संयुगे\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2173064, "chapter_id": 4685, "verse_number": "८", "content_sanskrit": "तथा मद्राधिपस्यापि गदावेगं महात्मनः ।\nसोढुमुत्सहते नान्यः पुमान् युधि वृकोदरात्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2173065, "chapter_id": 4685, "verse_number": "९", "content_sanskrit": "गोवृषाविव नर्दन्तौ मण्डलानि विचेरतुः ।\nआवल्गन्तौ गदाहस्तौ मद्रराजवृकोदरौ\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2173066, "chapter_id": 4685, "verse_number": "१०", "content_sanskrit": "मण्डलावर्तमार्गेषु गदाविहरणेषु च ।\nनिर्विशेषमभूद् युद्धं तयोः पुरुषसिंहयोः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2173067, "chapter_id": 4685, "verse_number": "११", "content_sanskrit": "तप्तहेममयैः शुभ्रैः बभूव भयवर्धिनी ।\nअग्निज्वालैरिवाविद्धा पट्टैः शल्यस्य सा गदा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2173068, "chapter_id": 4685, "verse_number": "१२", "content_sanskrit": "तथैव चरतो मार्गान् मण्डलेषु महात्मनः ।\nविद्युदभ्रप्रतीकाशा भीमस्य शुशुभे गदा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2173069, "chapter_id": 4685, "verse_number": "१३", "content_sanskrit": "ताडिता मद्रराजस्य भीमस्य गदया गदा ।\nदीप्यमानेव खे राजन् ससृजे पावकार्चिषः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2173070, "chapter_id": 4685, "verse_number": "१४", "content_sanskrit": "तथा भीमेन शल्यस्य ताडिता गदया गदा ।\nअङ्गारवर्षं मुमुचे तदद्भुतमिवाभवत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2173071, "chapter_id": 4685, "verse_number": "१५", "content_sanskrit": "दन्तैरिव महानागौ शृङ्गैरिव महावृषौ ।\nतौ विरेजतुरन्योन्यं गदाभ्यां सुपरिक्षतौ\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2173072, "chapter_id": 4685, "verse_number": "१६", "content_sanskrit": "तौ गदाभिहतैर्गात्रैः क्षणेन रुधिरोक्षितौ ।\nप्रेक्षणीयतरावास्तां पुष्पिताविव किंशुकौ\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2173073, "chapter_id": 4685, "verse_number": "१७", "content_sanskrit": "गदया मद्रराजेन सव्यं दक्षिणमाहतः ।\nभीमसेनो महाबाहुः न चचालाचलो यथा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2173074, "chapter_id": 4685, "verse_number": "१८", "content_sanskrit": "तथा भीमगदावेगैः ताड्यमानो महुर्मुहुः ।\nशल्यो न विव्यधे धीमान् दन्तिनेव हतो गिरिः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2173075, "chapter_id": 4685, "verse_number": "१९", "content_sanskrit": "शुश्रुवे दिक्षु सर्वासु तयोः पुरुषसिंहयोः ।\nगदानिपातसंह्लादो वज्रयोरिव निस्वनः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2173076, "chapter_id": 4685, "verse_number": "२०", "content_sanskrit": "निवृत्य तु महावीर्यौ समुच्छ्रितगदावुभौ ।\nपुनरन्तरमार्गस्थौ मण्डलानि विचेरतुः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2173077, "chapter_id": 4685, "verse_number": "२१", "content_sanskrit": "तदाऽभ्येत्य पदान्यष्टौ सन्निपातोऽभवत् तयोः ।\nउद्यम्य बाहुदण्डाभ्यामतिमानुषकर्मणोः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2173078, "chapter_id": 4685, "verse_number": "२२", "content_sanskrit": "प्रार्थयानौ तदाऽन्योन्यं मण्डलानि विचेरतुः ।\nक्रियाविशेषं कृतिनौ दर्शयामासतुस्तदा\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2173079, "chapter_id": 4685, "verse_number": "२३", "content_sanskrit": "अभ्युद्यतगदौ वीरौ सशृङ्गाविव पर्वतौ ।\nतावाजघ्नतुरन्योन्यं यथा भूमिचलेऽचलौ\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2173080, "chapter_id": 4685, "verse_number": "२४", "content_sanskrit": "तौ परस्परसंवेगाद् गदाभ्यां च भृशाहतौ ।\nयुगपत् पेततुर्वीरावुभाविन्द्रबली इव\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2173081, "chapter_id": 4685, "verse_number": "२५", "content_sanskrit": "उभयोः सेनयोः शब्दस्तदा हाहाकृतोऽभवत् ।\nभृशं मर्मण्यभिहतावुभावास्तां सुविह्वलौ\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2173082, "chapter_id": 4685, "verse_number": "२६", "content_sanskrit": "ततः स्वरथमारोप्य मद्राणामधिपं रणे ।\nअपोवाह कृपः शल्यं तूर्णमायोधनाद् बहिः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2173083, "chapter_id": 4685, "verse_number": "२७", "content_sanskrit": "जीववद् विह्वलत्वात् तु महापाणिर्वृकोदरः ।\nनिमेषात् पुनरुत्थाय समाह्वयत मद्रपम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2173084, "chapter_id": 4685, "verse_number": "२८", "content_sanskrit": "ततस्तु तावकाः शूरा नानादेशसमागताः ।\nनानावादित्रशब्देन पाण्डुसैन्यमयोधयन्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2173085, "chapter_id": 4685, "verse_number": "२९", "content_sanskrit": "भुजावुद्धृत्य शस्त्रं च शब्देन महता वृताः ।\nअभ्यद्रवन् महाराज दुर्योधनपुरोगमाः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2173086, "chapter_id": 4685, "verse_number": "३०", "content_sanskrit": "तदनीकमभिप्रेक्ष्य ततस्ते पाण्डुनन्दनाः ।\nआययुः सिंहनादेन दुर्योधनवधेप्सया\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2173087, "chapter_id": 4685, "verse_number": "३१", "content_sanskrit": "तेषामापततां तूर्णं पुत्रस्ते भरतर्षभ ।\nप्रासेन चेकितानं च विव्याध हृदये भृशम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2173088, "chapter_id": 4685, "verse_number": "३२", "content_sanskrit": "स पपात रथोपस्थात् तव पुत्रेण ताडितः ।\nरुधिरौघपरिक्लिन्नः प्रविश्य विपुलं तमः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2173089, "chapter_id": 4685, "verse_number": "३३", "content_sanskrit": "चेकितानं हतं दृष्ट्वा पाण्डवेया महारथाः ।\nअसक्तमभ्यवर्षन्त शरवर्षाणि भागशः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2173090, "chapter_id": 4685, "verse_number": "३४", "content_sanskrit": "तावकानामनीकेषु पाण्डवा जितकाशिनः ।\nव्यचरन्त महाराज प्रेक्षणीयाः समन्ततः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2173091, "chapter_id": 4685, "verse_number": "३५", "content_sanskrit": "कृपश्च कृतवर्मा च सौबलश्च महाबलः ।\nअयोधयन् धर्मराजं मद्रराजपुरस्कृताः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2173092, "chapter_id": 4685, "verse_number": "३६", "content_sanskrit": "भारद्वाजस्य हन्तारं भूरिवीर्यसमन्वितम् ।\nदुर्योधनो महाराज धृष्टद्युम्नमयोधयत्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2173093, "chapter_id": 4685, "verse_number": "३७", "content_sanskrit": "त्रिसहस्ररथा राजन् तव पुत्रेण चोदिताः ।\nअयोधयन्त विजयं द्रोणपुत्रपुरस्कृताः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2173094, "chapter_id": 4685, "verse_number": "३८", "content_sanskrit": "विजये धृतसङ्कल्पाः समभित्यक्तजीविताः ।\nप्राविशंस्तावका राजन् हंसा इव महत् सरः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2173095, "chapter_id": 4685, "verse_number": "३९", "content_sanskrit": "ततो युद्धमभूद् घोरं परस्परवधैषिणाम् ।\nअन्योन्यस्तवसंयुक्तमन्योन्यप्रीतिवर्धनम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2173096, "chapter_id": 4685, "verse_number": "४०", "content_sanskrit": "तस्मिन् प्रवृत्ते सङ्ग्रामे राजन् वीरवरक्षये ।\nअनिलेनेरितं घोरमुत्तस्थौ पार्थिवं रजः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2173097, "chapter_id": 4685, "verse_number": "४१", "content_sanskrit": "श्रवणान्नामधेयानां पार्थिवानां च कीर्तनात् ।\nपरान् वयं विजानीमो ये वाऽयुध्यन्नभीतवत्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2173098, "chapter_id": 4685, "verse_number": "४२", "content_sanskrit": "तद्रजः पुरुषव्याघ्र शोणितेन प्रणाशितम् ।\nदिशश्च विमला जाताः तस्मिन् रजसि नाशिते\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2173099, "chapter_id": 4685, "verse_number": "४३", "content_sanskrit": "ततः प्रवृत्ते सङ्ग्रामे घोररूपे समन्ततः ।\nतावकानां परेषां च नासीत् कश्चित् पराङ्मुखः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2173100, "chapter_id": 4685, "verse_number": "४४", "content_sanskrit": "ब्रह्मलोकपरा भूत्वा प्रार्थयन्तो जयं युधि ।\nसुयुद्धेन पराक्रान्ता नराः स्वर्गमभीप्सवः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2173101, "chapter_id": 4685, "verse_number": "४५", "content_sanskrit": "भर्तृपिण्डविमोक्षार्थं मित्रकार्ये च विष्ठिताः ।\nस्वर्गे संसक्तमनसो योधा युयुधिरे तदा\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2173102, "chapter_id": 4685, "verse_number": "४६", "content_sanskrit": "नानारूपाणि शस्त्राणि विसृजन्तो महारथाः ।\nअन्योन्यमभिगर्जन्तः प्रहरन्तः परस्परम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2173103, "chapter_id": 4685, "verse_number": "", "content_sanskrit": "योधाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2173104, "chapter_id": 4685, "verse_number": "४७", "content_sanskrit": "हत वध्यत गृह्णीत प्रहरध्वं निकृन्तत\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2173105, "chapter_id": 4685, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2173106, "chapter_id": 4685, "verse_number": "समाप्तिः", "content_sanskrit": "इति स्म वाचोऽश्रूयन्त तव तेषां च वै बले\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2173107, "chapter_id": 4685, "verse_number": "४९", "content_sanskrit": "ततः शल्यो महाराज धर्मराजं युधिष्ठिरम् ।\nविव्याध निशितैर्बाणैः हन्तुकामो महारथः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2173108, "chapter_id": 4685, "verse_number": "५०", "content_sanskrit": "तस्य पार्थो महाराज नाराचान् वै चतुर्दश ।\nमर्माण्युद्दिश्य मर्मज्ञो निजघान हसन्निव\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2173109, "chapter_id": 4685, "verse_number": "५१", "content_sanskrit": "संवार्य पाण्डवं बाणैः हन्तुकामो महायशाः ।\nविव्याध समरे क्रुद्धो बहुभिः कङ्कपत्रिभिः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2173110, "chapter_id": 4685, "verse_number": "५२", "content_sanskrit": "अथ मद्रो महाराज शरेण नतपर्वणा ।\nयुधिष्ठिरं समाजघ्ने सर्वसैन्यस्य पश्यतः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2173111, "chapter_id": 4685, "verse_number": "५३", "content_sanskrit": "धर्मराजोऽपि सङ्क्रुद्धो मद्रराजं महारथम् ।\nविव्याध निशितैर्बाणैः कङ्कबर्हिणवाजितैः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2173112, "chapter_id": 4685, "verse_number": "५४", "content_sanskrit": "चन्द्रसेनं च सप्तत्या सूतं च नवभिः शरैः ।\nद्युमत्सेनं चतुःषष्ट्या निजघान महाबलः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2173113, "chapter_id": 4685, "verse_number": "५५", "content_sanskrit": "चक्ररक्षे हते शल्यः पाण्डवेन महात्मनः ।\nनिजघान महाराज चेदीन् वै पञ्चविंशतिम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2173114, "chapter_id": 4685, "verse_number": "५६", "content_sanskrit": "सात्यकिं पञ्चविंशत्या भीमसेनं च पञ्चभिः ।\nमाद्रीपुत्रौ च विंशत्या विव्याध निशितैः शरैः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2173115, "chapter_id": 4685, "verse_number": "५७", "content_sanskrit": "एवं विचरतस्तस्य सङ्ग्रामे राजसत्तम ।\nसम्प्रैषयच्छितान् पार्थः शरानाशीविषोपमान्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2173116, "chapter_id": 4685, "verse_number": "५८", "content_sanskrit": "ध्वजाग्रं चास्य समरे कुन्तीपुत्रो युधिष्ठिरः ।\nप्रमुखे युध्यमानस्य भल्लेनापाहरद् रथात्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2173117, "chapter_id": 4685, "verse_number": "५९", "content_sanskrit": "पाण्डुपुत्रेण वै तस्य केतुश्छिन्नो महात्मना ।\nनिपतन्तमपश्याम गिरेः शृङ्गमिवाहतम्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2173118, "chapter_id": 4685, "verse_number": "६०", "content_sanskrit": "ध्वजं निपतितं दृष्ट्वा पाण्डवं चाप्यवस्थितम् ।\nसङ्क्रुद्धो मद्रराजोऽभूद् शरवर्षं मुमोच ह\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2173119, "chapter_id": 4685, "verse_number": "६१", "content_sanskrit": "शल्यः सायकवर्षेण पर्जन्य इव वृष्टिमान् ।\nअभ्यवर्षदमेयात्मा क्षत्रियं क्षत्रियर्षभः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2173120, "chapter_id": 4685, "verse_number": "६२", "content_sanskrit": "सात्यकिं भीमसेनं च माद्रीपुत्रौ च पाण्डवौ ।\nएकैकं दशभिर्विद्ध्वा युधिष्ठिरमपीडयत्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2173121, "chapter_id": 4685, "verse_number": "६३", "content_sanskrit": "तेन बाणमयं जालं विसृष्टं पाण्डवोरसि ।\nअपश्याम महाराज मेघजालमिवोत्थितम्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2173122, "chapter_id": 4685, "verse_number": "६४", "content_sanskrit": "तस्य शल्यो रणे क्रुद्धो बाणैः सन्नतपर्वभिः ।\nदिशः प्रच्छादयामास प्रदिशश्च महारथः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2173123, "chapter_id": 4685, "verse_number": "६५", "content_sanskrit": "ततो युधिष्ठिरो राजा बाणवर्षेण पीडितः ।\nबभूव भृशविक्रान्तो जम्भो वज्रभृता यथा\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2173124, "chapter_id": 4685, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशल्यपर्वणि द्वादशोऽध्यायः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2173125, "chapter_id": 4685, "verse_number": "", "content_sanskrit": "शल्यवधपर्वणि द्वादशोऽध्यायः ॥१२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}]