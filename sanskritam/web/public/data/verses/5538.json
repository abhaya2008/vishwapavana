[{"id": 2212831, "chapter_id": 5538, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2212832, "chapter_id": 5538, "verse_number": "१", "content_sanskrit": "शान्तनुः पालयामास यथावद् वसुधामिमाम् ।\nतथा विचित्रवीर्यश्च भीष्मेण परिपालितः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2212833, "chapter_id": 5538, "verse_number": "२", "content_sanskrit": "पालयामास नस्तातो विदितं वो न संशयः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2212834, "chapter_id": 5538, "verse_number": "३", "content_sanskrit": "यथा च पाण्डुर्भ्राता मे दयितो भवतामभूत् ।\nस चापि पालयमास यथावत्तच्च वेत्थ ह\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2212835, "chapter_id": 5538, "verse_number": "४", "content_sanskrit": "अनन्तरं हि पितरौ अनुज्ञातो युधिष्ठिरः ।\nनात्र किञ्चिन्मृषा जातु भवितेति मतिर्मम\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2212836, "chapter_id": 5538, "verse_number": "५", "content_sanskrit": "(मया च भवतां सम्यक् शुश्रूषा या कृताऽनघाः ।\nअसम्यग् वा महाभागास्तत् क्षन्तव्यमतन्द्रितैः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2212837, "chapter_id": 5538, "verse_number": "", "content_sanskrit": "यदा दुर्योधनेनेदं भुक्तं राज्यमकण्टकम् ।\nअपि तत्र न वो मन्दो दुर्बुद्धिरपराद्धवान्\t॥६॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2212838, "chapter_id": 5538, "verse_number": "७", "content_sanskrit": "तस्यापराधाद् दुर्बुद्धेरभिमानान्महीक्षिताम् ।\nविमर्दः सुमहानासीदनयात् स्वकृतादथ\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2212839, "chapter_id": 5538, "verse_number": "८", "content_sanskrit": "घातिताः कौरवेयाश्च पृथिवी च विनाशिता\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2212840, "chapter_id": 5538, "verse_number": "९", "content_sanskrit": "तन्मया साधु वाऽपीदं यदि वाऽसाधु वै कृतम् ।\nतद्वो हृदि न कर्तव्यं मया बद्धोऽयमञ्जलिः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2212841, "chapter_id": 5538, "verse_number": "१०", "content_sanskrit": "वृद्धोऽयं हतपुत्रोऽयं दुःखितोऽयं नराधिपः ।\nपूर्वराज्ञां च पुत्रोऽयमिति कृत्वाऽनुजानथ\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2212842, "chapter_id": 5538, "verse_number": "११", "content_sanskrit": "इयं च कृपणा वृद्धा हतपुत्रा तपस्विनी ।\nगान्धारी पुत्रशोकार्ता तुल्यं याचति वो मया\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2212843, "chapter_id": 5538, "verse_number": "१२", "content_sanskrit": "हतपुत्राविमौ वृद्धौ विदित्वा दुःखितौ तथा ।\nअनुजानीत भद्रं वो व्रजाव शरणं च वः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2212844, "chapter_id": 5538, "verse_number": "१३", "content_sanskrit": "अयं च कौरवो राजा कुन्तीपुत्रो युधिष्ठिरः ।\nसर्वैर्भवद्भिर्द्रष्टव्यः समेषु विषमेषु च\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2212845, "chapter_id": 5538, "verse_number": "१४", "content_sanskrit": "न जातु विषमं चैव गमिष्यति कदाचन\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2212846, "chapter_id": 5538, "verse_number": "१५", "content_sanskrit": "चत्वारः सचिवा यस्य भ्रातरो विपुलौजसः ।\nलोकपालसमा ह्येते सर्वधर्मार्थदर्शिनः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2212847, "chapter_id": 5538, "verse_number": "१६", "content_sanskrit": "चतुर्णां लोकपालानां मध्ये विपरिवर्तते ।\nब्रह्मेव भगवानेष सर्वभूतजगत्पतिः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2212848, "chapter_id": 5538, "verse_number": "१७", "content_sanskrit": "एवमेव महाबाहुर्भीमार्जुनयमैर्वृतः ।\nयुधिष्ठिरो महातेजा भवतः पालयिष्यति\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2212849, "chapter_id": 5538, "verse_number": "१८", "content_sanskrit": "अवश्यमेव वक्तव्यमिति कृत्वा ब्रवीमि वः ।\nएष न्यासो मया दत्तः सर्वेषां वो युधिष्ठिरः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2212850, "chapter_id": 5538, "verse_number": "१९", "content_sanskrit": "भवन्तो ह्यस्य धीरस्य न्यासभूताः मया कृताः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2212851, "chapter_id": 5538, "verse_number": "२०", "content_sanskrit": "यद्येवं तैः कृतं किञ्चिद् व्यलीकं वा सुतैर्मम ।\nयद्यन्येन मदीयेन तदनुज्ञातुमर्हथ\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2212852, "chapter_id": 5538, "verse_number": "२१", "content_sanskrit": "भवद्भिर्हि न मे मन्युः कृतपूर्वः कथञ्चन ।\nअत्यन्तगुरुभक्तानामेषोऽञ्जलिरिदं नमः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2212853, "chapter_id": 5538, "verse_number": "२२", "content_sanskrit": "तेषामपि विबुद्धीनां लुब्धानां कामचारिणाम् ।\nकृते याचामि वः सर्वान् गान्धारीसहितो द्विजाः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2212854, "chapter_id": 5538, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2212855, "chapter_id": 5538, "verse_number": "२३", "content_sanskrit": "इत्युक्तास्तेन ते सर्वे पौरजानपदा जनाः ।\nनोचुर्बाष्पकलाः किञ्चिद् वीक्षाञ्चक्रुः परस्परम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2212856, "chapter_id": 5538, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nआश्रमवासिकपर्वणि चतुर्दशोऽध्यायः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2212857, "chapter_id": 5538, "verse_number": "", "content_sanskrit": "आश्रमवासपर्वणि चतुर्दशोऽध्यायः ॥१४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]