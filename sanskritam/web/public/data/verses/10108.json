[{"id": 6000108000, "chapter_id": 10108, "verse_number": null, "content_sanskrit": "अथ त्रयोदशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000108001, "chapter_id": 10108, "verse_number": null, "content_sanskrit": "ब्राह्मण उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_013/BhP_05.013.001.m4a", "display_order": 2}, {"id": 6000108002, "chapter_id": 10108, "verse_number": "५-१३-१", "content_sanskrit": "दुरत्ययेऽध्वन्यजया निवेशितो रजस्तमस्सत्त्वविभक्तकर्मदृक्।\nस एष सार्थोऽर्थपरः परिभ्रमन् भवाटवीं याति न शर्म विन्दति॥ ५/१३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_013/BhP_05.013.002.m4a", "display_order": 3, "topics": [{"text": "जडभरतेन रहूगणं प्रति विरक्तेरावश्यकत्वकथनार्थं संसारस्य अटवीत्वेन वर्णनम्", "range": "१–३०"}]}, {"id": 6000108003, "chapter_id": 10108, "verse_number": "५-१३-२", "content_sanskrit": "यस्यामिमे षण्नरदेव दस्यवः स्वार्थं विलुम्पन्ति कुनायकं बलात्।\nगोमायवो यत्र हरन्ति सार्थकं प्रमत्तमाविश्य यथोरणं वृकाः॥ ५/१३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_013/BhP_05.013.003.m4a", "display_order": 4}, {"id": 6000108004, "chapter_id": 10108, "verse_number": "५-१३-३", "content_sanskrit": "प्रभूतवीरुत्तृणगुल्मगह्वरे कठोरदंशैर्मशकैरुपद्रुतः।\nक्‍वचिच्च गन्धर्वपुरं प्रपश्यति क्‍वचित्क्‍वचिच्चासुहरोल्मुकग्रहम्॥ ५/१३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_013/BhP_05.013.004.m4a", "display_order": 5}, {"id": 6000108005, "chapter_id": 10108, "verse_number": "५-१३-४", "content_sanskrit": "निवासतोयद्रविणात्मबुद्धिस्ततस्ततो धावति भो अटव्याम्।\nक्‍वचिच्च वात्योत्थितपांसुधूम्रा दिशो न जानाति रजस्वलाक्षः॥ ५/१३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_013/BhP_05.013.005.m4a", "display_order": 6}, {"id": 6000108006, "chapter_id": 10108, "verse_number": "५-१३-५", "content_sanskrit": "अदृश्यझिल्लीस्वनकर्णमूल उलूकवाग्भिर्व्यथितान्तरात्मा।\nअपुण्यवृक्षान् श्रयते क्षुधाऽर्दितो मरीचितोयान्यभिधावति क्‍वचित्॥ ५/१३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_013/BhP_05.013.006.m4a", "display_order": 7}, {"id": 6000108007, "chapter_id": 10108, "verse_number": "५-१३-६", "content_sanskrit": "क्‍वचिद्वितोयाः सरितोऽभियाति परस्परं खादयते निरन्नः।\nआसाद्य दावं क्‍वचिदग्नितप्तो निर्विद्यते क्‍व च यक्षैर्हृतासुः॥ ५/१३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_013/BhP_05.013.007.m4a", "display_order": 8}, {"id": 6000108008, "chapter_id": 10108, "verse_number": "५-१३-७", "content_sanskrit": "परैर्हृतस्वः क्‍व च निर्विण्णचित्तः शोचन्विमुह्यन्नुपयाति कश्मलम्।\nक्‍वचिच्च गन्धर्वपुरं प्रविष्टः प्रमोदते निर्वृतवन्मुहूर्तम्॥ ५/१३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_013/BhP_05.013.008.m4a", "display_order": 9}, {"id": 6000108009, "chapter_id": 10108, "verse_number": "५-१३-८", "content_sanskrit": "चलन्क्‍वचित्कण्टकशर्कराङ्घ्रिर्नगारुरुक्षुर्विमना इवास्ते।\nपदे पदेऽभ्यन्तरवह्निनाऽर्दितः कौटुम्बिकः क्रुध्यति वै जनाय॥ ५/१३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_013/BhP_05.013.009.m4a", "display_order": 10}, {"id": 6000108010, "chapter_id": 10108, "verse_number": "५-१३-९", "content_sanskrit": "क्‍वचिन्निगीर्णोऽजगराहिना जनो नावैति किञ्चिद्विपिनेऽपविद्धः।\nदष्टः स्म शेते क्‍व च दन्दशूकैरन्धोऽन्धकूपे पतितस्तमिस्रे॥ ५/१३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_013/BhP_05.013.010.m4a", "display_order": 11}, {"id": 6000108011, "chapter_id": 10108, "verse_number": "५-१३-१०", "content_sanskrit": "कर्हि स्म चित्क्षुद्ररसान् विचिन्वंस्तन्मक्षिकाभिर्मथितो विमानः।\nतत्रापि कृच्छ्रात्प्रतिलब्धमन्ये बलाद्विलुम्पन्त्यथ तं ततोऽन्ये॥ ५/१३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_013/BhP_05.013.011.m4a", "display_order": 12}, {"id": 6000108012, "chapter_id": 10108, "verse_number": "५-१३-११", "content_sanskrit": "क्‍वचिच्च शीतातपवातवर्षप्रतिक्रियां कर्तुमनीश आस्ते।\nक्‍वचिन्मिथो विपणन्यच्च किञ्चिद्विक्रेयमृच्छत्युत वित्तशाठ्यात्॥ ५/१३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_013/BhP_05.013.012.m4a", "display_order": 13}, {"id": 6000108013, "chapter_id": 10108, "verse_number": "५-१३-१२", "content_sanskrit": "क्‍वचित्क्‍वचित्क्षीणधनस्तु तस्मिन् शय्यासनस्थानविहारहीनः।\nयावत्परादप्रतिलब्धकामः पारक्यदृष्टिर्लभतेऽवमानम्॥ ५/१३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_013/BhP_05.013.013.m4a", "display_order": 14}, {"id": 6000108014, "chapter_id": 10108, "verse_number": "५-१३-१३", "content_sanskrit": "प्रसज्जति क्‍वापि लताभुजाश्रयस्तदाऽऽश्रयोऽव्यक्तपदं द्विजस्य ह।\nक्‍वचित्कदाचिद्धरिचक्रतस्‍त्रसन् सख्यं विधत्ते बककङ्कगृध्रैः॥ ५/१३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_013/BhP_05.013.014.m4a", "display_order": 15}, {"id": 6000108015, "chapter_id": 10108, "verse_number": "५-१३-१४", "content_sanskrit": "तैर्वञ्चितो हंसकुलं समाविशन्न रोचयञ् शीलमुपैति वानरम्।\nतज्जातिरासेन सुनिर्वृतेन्द्रियः परस्परान्वीक्षणविस्मृतावधिः॥ ५/१३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_013/BhP_05.013.015.m4a", "display_order": 16}, {"id": 6000108016, "chapter_id": 10108, "verse_number": "५-१३-१५", "content_sanskrit": "द्रुमेषु रंस्यन्सुतदारवत्सलो व्यवायदीनो विवशश्चरन्वने।\nक्‍वचित्प्रमादाद्गिरिकन्दरे पतन्वल्लीं गृहीत्वा गजभीत आस्थितः॥ ५/१३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_013/BhP_05.013.016.m4a", "display_order": 17}, {"id": 6000108017, "chapter_id": 10108, "verse_number": "५-१३-१६", "content_sanskrit": "ततः कथञ्चित्प्रतिमुक्त आपदः पुनश्च सार्थं प्रविशत्यरिन्दम।\nअध्वन्यमुष्मिन्नजया निवेशितो भ्रमञ्जनोऽद्यापि न वेद कश्चन॥ ५/१३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_013/BhP_05.013.017.m4a", "display_order": 18}, {"id": 6000108018, "chapter_id": 10108, "verse_number": "५-१३-१७", "content_sanskrit": "अन्योन्यवित्तव्यतिषङ्गवृद्धवैरानुबन्धोऽधिवहन्मिथश्च।\nअध्वन्यमुष्मिन्नुरुकृच्छ्रवित्तबाधोपसर्गैर्विहरन्विपन्नः॥ ५/१३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_013/BhP_05.013.018.m4a", "display_order": 19}, {"id": 6000108019, "chapter_id": 10108, "verse_number": "५-१३-१८", "content_sanskrit": "तांस्तान्विपन्नान् स हि तत्र तत्र विहाय जातं परिगृह्य सार्थः।\nआवर्ततेऽद्यापि न कश्चिदत्र वीराध्वनः पारमुपैति योगम्॥ ५/१३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_013/BhP_05.013.019.m4a", "display_order": 20}, {"id": 6000108020, "chapter_id": 10108, "verse_number": "५-१३-१९", "content_sanskrit": "मनस्विनो निर्जितदिग्गजेन्द्रा ममेति सर्वे भुवि बद्धवैराः।\nमृधे शयीरन्न तु तद्व्रजन्ति यन्न्यस्तदण्डो गतवैरोऽभियाति॥ ५/१३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_013/BhP_05.013.020.m4a", "display_order": 21}, {"id": 6000108021, "chapter_id": 10108, "verse_number": "५-१३-२०", "content_sanskrit": "रहूगण त्वमपि ह्यध्वनोऽस्य संन्यस्तदण्डः कृतभूतमैत्रः।\nअसज्जितात्मा हरिसेवया शितज्ञानासिमादाय तरातिपारम्॥ ५/१३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_013/BhP_05.013.021.m4a", "display_order": 22}, {"id": 6000108022, "chapter_id": 10108, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_013/BhP_05.013.022.m4a", "display_order": 23}, {"id": 6000108023, "chapter_id": 10108, "verse_number": "५-१३-२१", "content_sanskrit": "अहो नृजन्माखिलजन्मशोभनं किं जन्मभिस्त्वपरैरप्यमुष्मिन्।\nन यद्धृषीकेशयशःकृतात्मनां महात्मनां वः प्रचुरः समागमः॥ ५/१३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_013/BhP_05.013.023.m4a", "display_order": 24}, {"id": 6000108024, "chapter_id": 10108, "verse_number": "५-१३-२२", "content_sanskrit": "न ह्यद्भुतं त्वच्चरणाब्जरेणुभिर्हतांहसो भक्तिरधोक्षजेऽमला।\nमौहूर्तिकाद्यस्य समागमाच्च मे दुस्तर्कमूलोऽपहतोऽविवेकः॥ ५/१३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_013/BhP_05.013.024.m4a", "display_order": 25}, {"id": 6000108025, "chapter_id": 10108, "verse_number": "५-१३-२३", "content_sanskrit": "नमो महद्भ्योऽस्तु नमः शिशुभ्यो नमो युवभ्यो नम आवटुभ्यः।\nये ब्राह्मणा गामवधूतलिङ्गाश्चरन्ति तेभ्यः शिवमस्तु राज्ञाम्॥ ५/१३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_013/BhP_05.013.025.m4a", "display_order": 26}, {"id": 6000108026, "chapter_id": 10108, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_013/BhP_05.013.026.m4a", "display_order": 27}, {"id": 6000108027, "chapter_id": 10108, "verse_number": "५-१३-२४", "content_sanskrit": "इत्येवम् उत्तरामातः स वै ब्रह्मर्षिसुतः सिन्धुपतेः परमात्मसत्तत्त्वमविगणितपरमानुभावः परमकारुणिकतयोपदिश्य रहूगणेन सकरुणमभिवन्दितचरणकमलः पूर्णार्णव इव निभृतकरणोर्म्याशयो धरणीमिमां विचचार॥ ५/१३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_013/BhP_05.013.027.m4a", "display_order": 28}, {"id": 6000108028, "chapter_id": 10108, "verse_number": "५-१३-२५", "content_sanskrit": "सौवीरपतिरपि सुजनसमवगतपरमात्मसत्तत्त्वः आत्मन्यविद्याऽध्यारोपितां च देहात्ममतिं विससर्ज।\nएवं नृप भगवदाश्रितानुभावः॥ ५/१३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_013/BhP_05.013.028.m4a", "display_order": 29}, {"id": 6000108029, "chapter_id": 10108, "verse_number": null, "content_sanskrit": "तस्येमान् श्लोकान् गायन्ति—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_013/BhP_05.013.029.m4a", "display_order": 30}, {"id": 6000108030, "chapter_id": 10108, "verse_number": "५-१३-२६", "content_sanskrit": "आर्षभस्येह राजर्षेर्मनसाऽपि महात्मनः।\nनानुवर्त्मार्हति नृपो मक्षिकेव गरुत्मतः॥ ५/१३/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_013/BhP_05.013.030.m4a", "display_order": 31}, {"id": 6000108031, "chapter_id": 10108, "verse_number": "५-१३-२७", "content_sanskrit": "यो दुस्त्यजान् दारसुतान् सुहृद्राज्यं हृदिस्पृशम्।\nजहौ युवैव मलवदुत्तमश्लोकलालसः॥ ५/१३/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_013/BhP_05.013.031.m4a", "display_order": 32}, {"id": 6000108032, "chapter_id": 10108, "verse_number": "५-१३-२८", "content_sanskrit": "यो दुस्त्यजान् क्षितिसुतस्वजनार्थदारान् प्रार्थ्यां श्रियं सुरवरैः सदयावलोकैः।\nनैच्छन्नृपस्तदुचितं महतां मधुद्विट्‌सेवानुरक्तमनसामभवोऽपि फल्गुः॥ ५/१३/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_013/BhP_05.013.032.m4a", "display_order": 33}, {"id": 6000108033, "chapter_id": 10108, "verse_number": "५-१३-२९", "content_sanskrit": "यज्ञाय धर्मपतये विधिनैपुणाय योगाय साङ्ख्यशिरसे प्रकृतीश्वराय।\nनारायणाय हरये नम इत्युदारं गायन्मृगत्वमपि यः समुदाजहार॥ ५/१३/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_013/BhP_05.013.033.m4a", "display_order": 34}, {"id": 6000108034, "chapter_id": 10108, "verse_number": "५-१३-३०", "content_sanskrit": "इदं भागवतसभाजितावदातगुणकर्मणो राजर्षेर्भरतस्यानुचरितं स्वस्त्ययनमायुष्यं धन्यं यशस्यं स्वर्ग्यमापवर्ग्यं चानुशृृणोत्याख्यास्यत्यभिनन्दति च सर्वा ह्येवाशिष आत्मन आशास्ते न काञ्चन परत इति॥ ५/१३/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_013/BhP_05.013.034.m4a", "display_order": 35}, {"id": 6000108035, "chapter_id": 10108, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां पञ्चमस्कन्धे त्रयोदशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]