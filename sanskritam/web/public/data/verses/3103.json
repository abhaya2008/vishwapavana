[{"id": 2098277, "chapter_id": 3103, "verse_number": "१३-२३३-१", "content_sanskrit": "उमोवाच।\nभक्षयन्त्यपरे मांसं वर्जयन्त्यपरे विभो।\nतन्मे वद महादेव भक्ष्याभक्ष्यविनिर्णयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2098278, "chapter_id": 3103, "verse_number": "१३-२३३-२x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2098279, "chapter_id": 3103, "verse_number": "१३-२३३-२", "content_sanskrit": "मांसस्य भक्षणे दोषो यश्चास्याभक्षणे गुणः।\nतदहं कीर्तयिष्यामि तन्निबोध यथातथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2098280, "chapter_id": 3103, "verse_number": "१३-२३३-३", "content_sanskrit": "इष्टं दत्तमधीतं च क्रतवश्च सदक्षिणाः।\nअमांसभक्षणस्यैव कलां नार्हन्ति षोडशीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2098281, "chapter_id": 3103, "verse_number": "१३-२३३-४", "content_sanskrit": "आत्मार्थं यः परप्राणान्हिस्यात्स्वादुफलेप्सया।\nव्यालगृध्रसृगालैश्च राक्षसैश्च समस्तु सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2098282, "chapter_id": 3103, "verse_number": "१३-२३३-५", "content_sanskrit": "यो वृथा नित्यमांसाशी स पुमानधमो भवेत्।\nततः कष्टतरं नास्ति स्वयमाहृत्य भक्षणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2098283, "chapter_id": 3103, "verse_number": "१३-२३३-६", "content_sanskrit": "स्वमांसं परमांसेन यो वर्धयितुमिच्छति।\nउद्विग्नवासं लभते यत्रयत्रत्रोपजायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2098284, "chapter_id": 3103, "verse_number": "१३-२३३-७", "content_sanskrit": "संछेदनं स्वमांसस्य यथा सञ्जनयेद्रुजम्।\nतथैव परमांसेऽपि वेदितव्यं विजानता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2098285, "chapter_id": 3103, "verse_number": "१३-२३३-८", "content_sanskrit": "यस्तु सर्वाणि मांसानि यावज्जीवं न भक्षयेत्।\nस स्वर्गे विपुलं स्थानं लभते नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2098286, "chapter_id": 3103, "verse_number": "१३-२३३-९", "content_sanskrit": "यत्तु वर्षशतं पूर्णं तप्यते परमं तपः।\nयच्चापि वर्जयेन्मांसं सममेतन्न वा समम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2098287, "chapter_id": 3103, "verse_number": "१३-२३३-१०", "content_sanskrit": "न हि प्राणैः प्रियतमं लोके किञ्चन विद्यते।\nतस्मात्प्राणिदया कार्या यथात्मनि तथा परे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2098288, "chapter_id": 3103, "verse_number": "१३-२३३-११", "content_sanskrit": "सर्वे यज्ञा न तत्कुर्युः सर्वे देवाश्च भामिनि।\nयो मांसरसमास्वाद्य पुनर्मासं विवर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2098289, "chapter_id": 3103, "verse_number": "१३-२३३-१२", "content_sanskrit": "इत्येवं मुनयः प्राहुर्मांसस्याभक्षणे गुणाः।\nएवं बहुगुणं देवि नृणां मांसविवर्जनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2098290, "chapter_id": 3103, "verse_number": "१३-२३३-१३", "content_sanskrit": "न शक्नुयाद्यदाऽतीय त्यक्तं मांसं कथञ्चन।\nपुण्यं तन्मासमात्रं वा वर्जनीयं विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2098291, "chapter_id": 3103, "verse_number": "१३-२३३-१४", "content_sanskrit": "न शक्नुयादपि तथा कौमुदीमासमेव च।\nजन्मनक्षत्रतिथिषु सदा पर्वसु रात्रिषु।\nवर्जनीयं तथा मांसं परत्रि हितमिच्छता।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2098292, "chapter_id": 3103, "verse_number": "१३-२३३-१५", "content_sanskrit": "अशक्तः कारणान्मर्त्यो भोक्तुमिच्छेद्विधिं शृणु।\nअनेनि खादन्विधिना कलुषेण न लिप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2098293, "chapter_id": 3103, "verse_number": "१३-२३३-१६", "content_sanskrit": "सूनायां च गतप्राणान्क्रीत्वा न्यायेन भामिनि।\nब्राह्मणातिथिपूजार्थं भोक्तव्यं हितमिच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2098294, "chapter_id": 3103, "verse_number": "१३-२३३-१७", "content_sanskrit": "भैषज्यकारणाद्व्याधौ खादन्पापैर्न लिप्यते।\nपितृशेषं तथैवाश्नन्मांसं नाशुभमृच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2098295, "chapter_id": 3103, "verse_number": "१३-२३३-१८x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2098296, "chapter_id": 3103, "verse_number": "१३-२३३-१८", "content_sanskrit": "गुरुपूजा कथं देव क्रियते धर्मचारिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2098297, "chapter_id": 3103, "verse_number": "१३-२३३-१९x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2098298, "chapter_id": 3103, "verse_number": "१३-२३३-१९", "content_sanskrit": "गुरुपूजां प्रवक्ष्यामि यथावत्तव शोभने।\nकृतज्ञानां परो धर्म इति वेदानुशासनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2098299, "chapter_id": 3103, "verse_number": "१३-२३३-२०", "content_sanskrit": "तस्मात्स्वगुरवः पूज्यास्ते हि पूर्वोपकारिणः।\nगुरूणां च गरीयांसस्त्रयो लोकेषु पूजिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2098300, "chapter_id": 3103, "verse_number": "१३-२३३-२१", "content_sanskrit": "उपाध्यायः पिता माता संपूज्यास्ते विशेषतः।\nये पितुर्भ्रातरो ज्येष्ठा ये च तस्यानुजास्तथा।\nपितुः पिता च सर्वे ते पूजनीयाः पिता तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2098301, "chapter_id": 3103, "verse_number": "१३-२३३-२२", "content_sanskrit": "मातुर्या भगिनी ज्येष्ठा मातुर्या च यवीयसी।\nमातामही च धात्री च सर्वास्ता मातरः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2098302, "chapter_id": 3103, "verse_number": "१३-२३३-२३", "content_sanskrit": "उपाध्यायस्य यः पुत्रो यश्च तस्य भवेद्गुरुः।\nऋत्विग्गुरुः पिता चेति गुरवः सम्प्रकीर्तिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2098303, "chapter_id": 3103, "verse_number": "१३-२३३-२४", "content_sanskrit": "ज्येष्ठो भ्राता नरेन्द्रश्च मातुलः श्वळशुरस्तथा।\nभयत्राता च भर्ता च गुरवस्ते प्रकीर्तिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2098304, "chapter_id": 3103, "verse_number": "१३-२३३-२५", "content_sanskrit": "इत्येष कथितः साध्वि गुरूणां सर्वसङ्ग्रहः।\nअनुवृत्तिं च पूजां च तेषामपि निबोध मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2098305, "chapter_id": 3103, "verse_number": "१३-२३३-२६", "content_sanskrit": "आराध्या मातापितरावुपाध्यायस्तथैव च।\nकथंचिन्नावमन्तव्या नरेण हितमिच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2098306, "chapter_id": 3103, "verse_number": "१३-२३३-२७", "content_sanskrit": "येन प्रीणन्ति पितरस्तेन प्रीतः प्रजापतिः।\nयेन प्रीणाति चेन्माता प्रीताः स्युर्देवमातरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2098307, "chapter_id": 3103, "verse_number": "१३-२३३-२८", "content_sanskrit": "ये प्रीणात्युपाध्यायो ब्रह्मा तेनाभिपूजितः।\nअप्रीतेषु पुनस्तेषु नरो नरकमेति हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2098308, "chapter_id": 3103, "verse_number": "१३-२३३-२९", "content_sanskrit": "गुरूणां वैरनिर्बन्धो न कर्तव्यः कथञ्चन।\nनरः स्वगुरुमप्रीत्या मनसाऽपि न गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2098309, "chapter_id": 3103, "verse_number": "१३-२३३-३०", "content_sanskrit": "न ब्रूयाद्विप्रियं तेषामनिष्टं न प्रवर्तयेत्।\nविगृह्य न वदेत्तेषां समीपे स्पर्धया क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2098310, "chapter_id": 3103, "verse_number": "१३-२३३-३१", "content_sanskrit": "यद्यदिच्छन्ति ते कर्तुमस्वतन्त्रस्तदाचरेत्।\nवेदानुशासनसमं गुरुशासनमिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2098311, "chapter_id": 3103, "verse_number": "१३-२३३-३२", "content_sanskrit": "कलहांश्च विवादांश्च गुरुभिः सह वर्जयेत्।\nकैतवं परिहासांश्च मन्युकामाश्रयाः कथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2098312, "chapter_id": 3103, "verse_number": "१३-२३३-३३", "content_sanskrit": "गुरूणां योऽनहंवादी करोत्याज्ञामतन्द्रितः।\nन तस्मात्सर्वमर्त्येषु विद्यते पुण्यकृत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2098313, "chapter_id": 3103, "verse_number": "१३-२३३-३४", "content_sanskrit": "असूयामपवादं च गुरूणां परिवर्जयेत्।\nतेषां प्रियहितान्वेषी भूत्वा परिचरेत्सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2098314, "chapter_id": 3103, "verse_number": "१३-२३३-३५", "content_sanskrit": "न तद्यज्ञफलं कुर्यात्तपो वाऽऽचरितं महत्।\nयत्कुर्यात्पुरुषस्येह गुरुपूजा सदा कृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2098315, "chapter_id": 3103, "verse_number": "१३-२३३-३६", "content_sanskrit": "अनुवृत्तेर्विना धर्मो नास्ति सर्वाश्रमेष्वपि।\nतस्मात्क्षमावृतः क्षान्तो गुरुवृत्तिं समाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2098316, "chapter_id": 3103, "verse_number": "१३-२३३-३७", "content_sanskrit": "स्वमर्थं स्वशरीरं च गुर्वर्थे संत्यजेद्बुधः।\nविवादं धनहेतोर्वा मोहाद्वा तैर्न रोचयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2098317, "chapter_id": 3103, "verse_number": "१३-२३३-३८", "content_sanskrit": "ब्रह्मचर्यमहिंसा च दानानि विविधानि च।\nगुरुभिः प्रतिषिद्धस्य सर्वमेतपार्थकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2098318, "chapter_id": 3103, "verse_number": "१३-२३३-३९", "content_sanskrit": "उपाध्यायं पितरं मातरं च।\nयेऽभिद्रुह्युर्मनसा कर्मणा वा।\nतेषां पापं भ्रूणहत्याविशिष्टं\nतेभ्यो नान्यः पापकृदस्ति लोके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2098319, "chapter_id": 3103, "verse_number": "१३-२३३-४०x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2098320, "chapter_id": 3103, "verse_number": "१३-२३३-४०", "content_sanskrit": "उपवासविधिं तत्र तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2098321, "chapter_id": 3103, "verse_number": "१३-२३३-४१x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2098322, "chapter_id": 3103, "verse_number": "१३-२३३-४१", "content_sanskrit": "शरीरमलशान्त्यर्थमिन्द्रियोच्छोषणाय च।\nएकभुक्तोपवासैस्तु धारयन्ते व्रतं नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2098323, "chapter_id": 3103, "verse_number": "१३-२३३-४२", "content_sanskrit": "लभन्ते विपुलं धर्मं तथाऽऽहारपरिक्षयात्।\nबहूनामुपरोधं तु न कुर्यादात्मकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2098324, "chapter_id": 3103, "verse_number": "१३-२३३-४३", "content_sanskrit": "जीवोपघातं च तथा स जीवन्धन्य इष्यते।\nतस्मात्पुण्यं लभेन्मर्त्यः स्वयमाहारकर्शनात्।\nतद्गृहस्थैर्यथाशक्ति कर्तव्यमिति निश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2098325, "chapter_id": 3103, "verse_number": "१३-२३३-४४", "content_sanskrit": "उपवासार्दिते काये आपदर्शं पयो जलम्।\nभुञ्जन्न प्रतिघाती स्याद्ब्राह्म्णाननुमान्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2098326, "chapter_id": 3103, "verse_number": "१३-२३३-४५x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2098327, "chapter_id": 3103, "verse_number": "१३-२३३-४५", "content_sanskrit": "ब्रह्मचर्यं कथं देव रक्षितव्यं विजानता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2098328, "chapter_id": 3103, "verse_number": "१३-२३३-४६x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2098329, "chapter_id": 3103, "verse_number": "१३-२३३-४६", "content_sanskrit": "तदहं ते प्रवक्ष्यामि शृणु देवि समाहिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2098330, "chapter_id": 3103, "verse_number": "१३-२३३-४७", "content_sanskrit": "ब्रह्मचर्यं परं शौचं ब्रह्मचर्यं परं तपः।\nकेवलं ब्रह्मचर्येणि प्राप्यते परमं पदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2098331, "chapter_id": 3103, "verse_number": "१३-२३३-४८", "content_sanskrit": "सङ्कल्पाद्दर्शनाच्चैव तद्युक्तवचनादपि।\nसंस्पर्शादथ संयोगात्पञ्चधा रक्षितं व्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2098332, "chapter_id": 3103, "verse_number": "१३-२३३-४९", "content_sanskrit": "व्रतवद्धारितं चैव ब्रह्मचर्यमकल्मषम्।\nनित्यं संरक्षितं तस्य नैष्ठिकानां विधियते।\nतदिष्यते गृहस्थानां कालमुद्दिश्य कारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2098333, "chapter_id": 3103, "verse_number": "१३-२३३-५०", "content_sanskrit": "जन्मनक्षत्रयोगेषु पुण्यवासेषु पर्वसु।\nदेवताधर्मकार्येषु ब्रह्मचर्यव्रतं चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2098334, "chapter_id": 3103, "verse_number": "१३-२३३-५१", "content_sanskrit": "ब्रह्मचर्यव्रतफलं लभेद्दारव्रती सदा।\nशौचमायुस्तथाऽऽरोग्यं लभ्यते ब्रह्मचारिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2098335, "chapter_id": 3103, "verse_number": "१३-२३३-५२x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2098336, "chapter_id": 3103, "verse_number": "१३-२३३-५२", "content_sanskrit": "तीर्थचर्याव्रतं देव क्रियते धर्मकाङ्क्षिभि।\nकानि तीर्थानि लोकेषु तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2098337, "chapter_id": 3103, "verse_number": "१३-२३३-५३x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2098338, "chapter_id": 3103, "verse_number": "१३-२३३-५३", "content_sanskrit": "हन्त ते कथयिष्यामि तीर्थस्नानविधिं प्रिये।\nपावनार्थं च शौचार्थं ब्रह्मणा निर्मितं पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2098339, "chapter_id": 3103, "verse_number": "१३-२३३-५४", "content_sanskrit": "यास्तु लोके महानद्यस्ताः सर्वास्तीर्थसंज्ञिताः।\nतासां प्राक्स्रोतसः श्रेष्ठाः सङ्गमश्च परस्परम्।\nतासां सागरसंयोगो वरिष्ठश्चेति विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2098340, "chapter_id": 3103, "verse_number": "१३-२३३-५५", "content_sanskrit": "तासामुभयतः कूलं तत्रतत्र मनीषिभिः।\nदेवैर्वा सेवितं देवि तत्तीर्थं परमं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2098341, "chapter_id": 3103, "verse_number": "१३-२३३-५६", "content_sanskrit": "समुद्रश्च महातीर्थं पावनं परमं शुभम्।\nतस्य कूलगतास्तीर्था महद्भिश्च समाप्लुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2098342, "chapter_id": 3103, "verse_number": "१३-२३३-५७", "content_sanskrit": "स्रोतसकां पर्वताना च जोषितानां महर्षिभिः।\nअपि कूपं नटाकं वा सेवितुं मुनिभिः प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2098343, "chapter_id": 3103, "verse_number": "१३-२३३-५८", "content_sanskrit": "तत्तु तीर्थमिति ज्ञेयं प्रभावात्तु तपस्विनाम्।\nतदा प्रभृति तीर्थत्वं लेभे लोकहिताय वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2098344, "chapter_id": 3103, "verse_number": "१३-२३३-५९", "content_sanskrit": "एवं तीर्थं भवेद्देवि तस्य स्नानविधिं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2098345, "chapter_id": 3103, "verse_number": "१३-२३३-६०", "content_sanskrit": "जन्मना व्रतभूयिष्ठो गत्वा तीर्थानि काङ्क्षया।\nउपवासत्रयं कुर्यादेकं वा नियमान्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2098346, "chapter_id": 3103, "verse_number": "१३-२३३-६१", "content_sanskrit": "पुण्यमासेवते काले पौर्णमास्यां यथाविधि।\nबहिरेव शुचिर्भूत्वा तत्तीर्थं मन्मना विशेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2098347, "chapter_id": 3103, "verse_number": "१३-२३३-६२", "content_sanskrit": "त्रिराप्लुत्य जलाभ्यासे दत्त्वा ब्राह्मणदक्षिणाम्।\nअभ्यर्च्य देवायतनं ततः प्रायाद्यथागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2098348, "chapter_id": 3103, "verse_number": "१३-२३३-६३", "content_sanskrit": "एतद्विधानं सर्वेषां तीर्थंतीर्थमिति प्रिये।\nसमीपतीर्थस्नानात्तु दूरतीर्थं सुपूजितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2098349, "chapter_id": 3103, "verse_number": "१३-२३३-६४", "content_sanskrit": "आदिप्रभृतिशुद्धस्य तीर्थस्नानं शुभं भवेत्।\nतपोर्थं पापनाशार्थं शौचार्थं तीर्थगाहनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2098350, "chapter_id": 3103, "verse_number": "१३-२३३-६५", "content_sanskrit": "एवं पुण्येषु तीर्थेषु तीर्थस्नानं शुभं भवेत्।\nएतन्नैयमिकं सर्वं सुकृतं कथितं तव॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2098351, "chapter_id": 3103, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मिपर्वणि त्रयस्त्रिंशदधिकद्विशततमोऽध्यायः॥ २३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}]