[{"id": 7006161000, "chapter_id": 26161, "verse_number": "१-२-२२-१", "content_sanskrit": "ऋषय ऊचुः ।\nभूयः सूत महाबुद्धे कथयस्व महात्मनः ।\nमहादेवस्य माहात्म्यं श्रोतुं कौतूहलं च नः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006161001, "chapter_id": 26161, "verse_number": "१-२-२२-२", "content_sanskrit": "कथं दारुवणे देवऋषिसंघनिषेविते ।\nचकार वेषं विकृतं येन बुद्धा महर्षयः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006161002, "chapter_id": 26161, "verse_number": "१-२-२२-३", "content_sanskrit": "ज्ञात्वा च ते महादेवं ततो भ्रांता ह्यचेतसः ।\nआराधयन्प्रसादार्थं नैषां तुष्टः पुनर्भवः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006161003, "chapter_id": 26161, "verse_number": "१-२-२२-४", "content_sanskrit": "एतत्सर्वं यथावृत्तं देवदेवेन चेष्टितम् ।\nतत्सर्वं कथयस्वेह त्वं नो बुद्धिमतां वरः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006161004, "chapter_id": 26161, "verse_number": "१-२-२२-५", "content_sanskrit": "सूत उवाच ।\nश्रूयतामभिधास्यामि धर्ममेतमतंद्रिताः ।\nनिर्म्मितं देवदेवेन भक्तानामनुकंपया ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006161005, "chapter_id": 26161, "verse_number": "१-२-२२-६", "content_sanskrit": "पुरा कृतयुगे विप्राः श्रृंगे हिमवतः शुभे ।\nदेवदारुवनं रम्यं नानाद्रुमलताकुलम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006161006, "chapter_id": 26161, "verse_number": "१-२-२२-७", "content_sanskrit": "बहवो मुनयस्तत्र तपस्यंतो मुनिव्रताः ।\nशैवाल भोजनाः केचित्केचिदंतर्जलेशयाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006161007, "chapter_id": 26161, "verse_number": "१-२-२२-८", "content_sanskrit": "केचिदभ्रावकाशास्तु पादांगुष्ठाग्रधिष्ठिताः ।\nदंतोलूखलिनश्चान्ये त्वश्मकुट्टास्तथा परे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006161008, "chapter_id": 26161, "verse_number": "१-२-२२-९", "content_sanskrit": "स्थानवीरासनाश्चान्ये मृगयर्यारतास्तथा ।\nकालं नयंति तपसा तीव्रेण च महाधियः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006161009, "chapter_id": 26161, "verse_number": "१-२-२२-१०", "content_sanskrit": "ततस्तेषां प्रसादार्थ देवस्तद्वनमागतः ।\nभस्मपांडुरदिग्धांगो नग्नो विकृतलक्षणः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006161010, "chapter_id": 26161, "verse_number": "१-२-२२-११", "content_sanskrit": "विकृतस्रस्तकेशश्च करालदशनस्तथा ।\nउल्मुकव्यग्रहस्तश्च रक्तपिंगललोचनः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006161011, "chapter_id": 26161, "verse_number": "१-२-२२-१२", "content_sanskrit": "शिश्नं सवृषणं तस्य रक्तगैरिकसन्निभम् ।\nमुखमंगारवर्णेन शुक्लेन च विभूषितम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006161012, "chapter_id": 26161, "verse_number": "१-२-२२-१३", "content_sanskrit": "क्वचित्स हसते रौद्रं क्वचिद्गायति विस्मि तः ।\nक्वचिन्नृत्यति श्रृंगारी क्वचिद्रौति मुहुर्मुहुः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006161013, "chapter_id": 26161, "verse_number": "१-२-२२-१४", "content_sanskrit": "नृत्यंत रुरुधुस्तूर्णं पत्न्यस्तेषां विमोहिताः ।\nआश्रमेऽभ्यागतोऽभीक्ष्णं या चते च पुनः पुनः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006161014, "chapter_id": 26161, "verse_number": "१-२-२२-१५", "content_sanskrit": "भार्या कृता तथारूपा तृणाभरणभूषिता ।\nवृषनादं प्रगर्जन्वै खरनादं ननाद च ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006161015, "chapter_id": 26161, "verse_number": "१-२-२२-१६", "content_sanskrit": "तथा वंचितुमा रब्धो हासयन्सर्वदेहिनः ।\nततस्ते मुनयः क्रुद्धाः क्रोधेन कलुषीकृताः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006161016, "chapter_id": 26161, "verse_number": "१-२-२२-१७", "content_sanskrit": "मोहिता मायया सर्वे शपितुं समुपस्थिताः ।\nकरवद्गायसे यस्मात्खरस्तस्माद्भविष्यसि ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006161017, "chapter_id": 26161, "verse_number": "१-२-२२-१८", "content_sanskrit": "राक्षसो वा पिशाचो वा दानवो वाथ वा तथा ।\nयथा वैच्छंस्तथा सर्वे क्रुद्धास्ते मुनयः समम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006161018, "chapter_id": 26161, "verse_number": "१-२-२२-१९", "content_sanskrit": "शेपुः शासैस्तु विविधैस्तं देवं भुवनेश्वरम् ।\nतपांसि तेषां सर्वेषां प्रत्याहन्यंत शंकरे ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006161019, "chapter_id": 26161, "verse_number": "१-२-२२-२०", "content_sanskrit": "यथादित्यप्रकाशेन तारका नभसि स्थिताः ।\nन द्योतंते प्रकाशेन तद्वत्तेजांसि शंकरे ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006161020, "chapter_id": 26161, "verse_number": "१-२-२२-२१", "content_sanskrit": "श्रूयते ऋषिशापेन ब्रह्मणः सुमहात्मनः ।\nसमृद्धः श्रेयसां यौनिर्यज्ञो वै नाशमाप्तवान् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006161021, "chapter_id": 26161, "verse_number": "१-२-२२-२२", "content_sanskrit": "भृगोरपि च शापेन विष्णुः परमवियवान् ।\nप्रादुर्भावान्दश प्राप्तो दुःखितश्च सदा कृतः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006161022, "chapter_id": 26161, "verse_number": "१-२-२२-२३", "content_sanskrit": "इंद्रस्यापि हि धर्मज्ञः शिश्नं सवृषणं पुरा ।\nऋषिणा गौतमेनोर्व्यां क्रुद्धेन विनिपातितम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006161023, "chapter_id": 26161, "verse_number": "१-२-२२-२४", "content_sanskrit": "गर्भवासो वसूनां च शापेन विहित स्तथा ।\nऋषीणां चैव शापेन नहुषः सर्पतां गतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006161024, "chapter_id": 26161, "verse_number": "१-२-२२-२५", "content_sanskrit": "क्षीरोदश्च समुद्रश्च ह्यपेयो ब्राह्मणैः कृतः ।\nधर्मश्चात्र प्रशप्तो वै मांडव्येन महात्मना ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006161025, "chapter_id": 26161, "verse_number": "१-२-२२-२६", "content_sanskrit": "एते चान्ये च बहवो यातनां च समागताः ।\nवर्जयित्वा विरूपाक्षं देवदेवं महेश्वरम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006161026, "chapter_id": 26161, "verse_number": "१-२-२२-२७", "content_sanskrit": "एवं हि मोहितास्तेन न चाबुद्ध्यंत शंकरम् ।\nततस्ते ऋषयः सर्वे परस्परमथाब्रुवन् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006161027, "chapter_id": 26161, "verse_number": "१-२-२२-२८", "content_sanskrit": "न चायं विधिरस्माकं गृहस्थानां विधीयते ।\nब्रह्मचर्य रतानां च वने वा वनवासिनाम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006161028, "chapter_id": 26161, "verse_number": "१-२-२२-२९", "content_sanskrit": "यतीनां वा तथा धर्मो नायं दृष्टः कथंचन ।\nअनयस्तु महानेष येनायं मोहितो द्विजाः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006161029, "chapter_id": 26161, "verse_number": "१-२-२२-३०", "content_sanskrit": "लिंगं प्रपातयस्वैतन्नायं धर्मस्तपस्विनाम् ।\nवदस्व वाचा मधुरं वस्त्रमेकं समाश्रय ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006161030, "chapter_id": 26161, "verse_number": "१-२-२२-३१", "content_sanskrit": "त्याजिते च त्वया लिंगे ततः पूजामवाप्स्यसि ।\nऋषीणां तद्वचः श्रुत्वा भगवान्भगनेत्रहा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006161031, "chapter_id": 26161, "verse_number": "१-२-२२-३२", "content_sanskrit": "उवाच श्लक्ष्णया वाचा प्रहसन्निव शंकरः ।\nन शक्यमिदमस्मा कं लिंगं पातयितुं बलात् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006161032, "chapter_id": 26161, "verse_number": "१-२-२२-३३", "content_sanskrit": "ब्रह्मादिदैवतैः सर्वैः किमुतान्यैस्तपोधनैः ।\nपातयेयमहं चैतल्लिंगं भो द्विजसत्तमाः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006161033, "chapter_id": 26161, "verse_number": "१-२-२२-३४", "content_sanskrit": "आश्रमे तिष्ठ वा गच्छ वाक्यमित्येव तेऽब्रुवन् ।\nएवमुक्तो महादेवः प्रत्दृष्टेन्द्रियचेष्टितः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006161034, "chapter_id": 26161, "verse_number": "१-२-२२-३५", "content_sanskrit": "सर्वेषां पश्यतामेव तत्रैवांतर्दधे प्रभुः ।\nअंतर्हिते भगवति तथा लिंगे कृते भवे ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006161035, "chapter_id": 26161, "verse_number": "१-२-२२-३६", "content_sanskrit": "त्रैलोक्ये सर्वभूतानां प्रादुर्भावो न जायते ।\nव्याकुलं च तदा सर्वं न प्रकाशेत किंचन ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006161036, "chapter_id": 26161, "verse_number": "१-२-२२-३७", "content_sanskrit": "तपते चैव नादित्यो निष्प्रभः पावकस्तथा ।\nनक्षत्राणि ग्रहाश्चैव विपरीता विजज्ञिरे ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006161037, "chapter_id": 26161, "verse_number": "१-२-२२-३८", "content_sanskrit": "संतानार्थ प्रवृत्तानामृषीणां विभवात्मनाम् ।\nक्रतवो न व्यवर्त्तंत ऋतुकालाभिगामिनाम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006161038, "chapter_id": 26161, "verse_number": "१-२-२२-३९", "content_sanskrit": "ते चरति पुनर्द्धर्म्मं निर्ममा निरहंकृताः ।\nनष्टप्रभाववीर्याश्च नष्टतेजस एव च ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006161039, "chapter_id": 26161, "verse_number": "१-२-२२-४०", "content_sanskrit": "धर्मे चैव मतिस्तेषां तदा न व्यवतिष्ठते ।\nते तुसर्वे समागम्य ब्रह्मलोकमुपागताः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006161040, "chapter_id": 26161, "verse_number": "१-२-२२-४१", "content_sanskrit": "ब्रह्मणो भवनं गत्वा दृष्ट्वा पुष्पकसंभवम् ।\nपादयोः पतिताः सर्वे शिववृत्तांतमूचिरे ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006161041, "chapter_id": 26161, "verse_number": "१-२-२२-४२", "content_sanskrit": "विकटः स्तब्धकेशश्च करालदशनस्तथा ।\nउलूकव्यग्रहस्तश्च रक्तपिंगललोचनः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006161042, "chapter_id": 26161, "verse_number": "१-२-२२-४३", "content_sanskrit": "शिश्नं सवृषणं तस्य रक्तं गैरिकमंडितम् ।\nस्नुषाणां च दुहितॄणां पुत्रीणां च विशेषतः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006161043, "chapter_id": 26161, "verse_number": "१-२-२२-४४", "content_sanskrit": "वर्तमानस्ततः पार्श्वे विपरीताभिलाषतः ।\nउन्मत्त इति विज्ञाय सोऽस्माभिरवमानितः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006161044, "chapter_id": 26161, "verse_number": "१-२-२२-४५", "content_sanskrit": "आक्रुष्टस्ताडितश्चापि लिंगं चाप्यस्य चोद्धृतम् ।\nतस्य क्रोधप्रसादार्थं वयं ते शरणं गताः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006161045, "chapter_id": 26161, "verse_number": "१-२-२२-४६", "content_sanskrit": "एतत्कार्यं न जानीमस्तन्नो ब्रूहि पितामह ।\nऋषीणां तद्वचः श्रुत्वा ध्यानाद्विज्ञाय चेश्वरम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006161046, "chapter_id": 26161, "verse_number": "१-२-२२-४७", "content_sanskrit": "प्रत्युवाच ततो ब्रह्मा वाक्यं च सुसमा हितः ।\nएष देवो महादेवो विज्ञेयस्तु महेश्वरः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006161047, "chapter_id": 26161, "verse_number": "१-२-२२-४८", "content_sanskrit": "न तस्य परमं किंचित्पदं समधिगम्यते ।\nदेवानां च ऋषीणां च पितृणां चैव स प्रभुः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006161048, "chapter_id": 26161, "verse_number": "१-२-२२-४९", "content_sanskrit": "सहस्रयुगपर्यंते प्रलये सर्वदेहिनाम् ।\nसंहरत्येष भगवान् कालो भूत्वा महेश्वरः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006161049, "chapter_id": 26161, "verse_number": "१-२-२२-५०", "content_sanskrit": "एष चैव प्रजाः सर्वाः सृजत्येकः स्वतेजसा ।\nएष चिक्री च वक्षोजश्रीवत्सकृतलक्षणः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006161050, "chapter_id": 26161, "verse_number": "१-२-२२-५१", "content_sanskrit": "येगी कृतयुगे चैव त्रेतायां क्रतुरुच्यते ।\nद्वापरे चैव कालाग्निर्धर्मकेतुः कलौ स्मृतः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006161051, "chapter_id": 26161, "verse_number": "१-२-२२-५२", "content_sanskrit": "रुद्रस्य मूर्त्तयस्तिस्रो विज्ञेयाश्चापि पंडितैः ।\nतमो ह्यग्नी रजो ब्रह्मा सत्त्वं विष्णुः प्रकाशकः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006161052, "chapter_id": 26161, "verse_number": "१-२-२२-५३", "content_sanskrit": "मूर्त्तिरेका स्मृता यस्य दिग्वासाश्च शिवाह्वया ।\nयत्र तिष्ठंति तद्ब्रह्मयोगेन तु समन्वितम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006161053, "chapter_id": 26161, "verse_number": "१-२-२२-५४", "content_sanskrit": "तस्माद्देवं देवदेवमी शानं प्रभुमव्ययम् ।\nआराधयत विप्रेन्द्रा जितक्रोधा जितेंद्रियाः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006161054, "chapter_id": 26161, "verse_number": "१-२-२२-५५", "content_sanskrit": "दृष्टं वै यादृशं तस्य लिंगमासीन्महात्मनः ।\nतादृक्प्रतिकृतिं कृत्वा शूलपाणिं प्रपद्यत ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006161055, "chapter_id": 26161, "verse_number": "१-२-२२-५६", "content_sanskrit": "ततो द्रक्ष्यथ देवेशं दुर्दर्शमकृतात्मभिः ।\nयं दृष्ट्वा सर्वमज्ञानमधर्मश्च प्रमश्यति ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006161056, "chapter_id": 26161, "verse_number": "१-२-२२-५७", "content_sanskrit": "ततः प्रदक्षिणं कृत्वा ब्रह्माणममितौजसम् ।\nआस्थिता वीतशोकास्ते देवदारुवने ततः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006161057, "chapter_id": 26161, "verse_number": "१-२-२२-५८", "content_sanskrit": "आराधयितुमारब्धा ब्रह्मणा कथितं यथा ।\nस्थंडिलेषु विचित्रेषु पर्वतेषु गुहासु च ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006161058, "chapter_id": 26161, "verse_number": "१-२-२२-५९", "content_sanskrit": "नदीनां च विचित्रेषु पुलिनेषु शुभेषु च ।\nएवं संवत्सरे पूर्णे वसंते समुपस्थिते ।\nतदेव रूपमास्थाय देवस्तद्वनमागतः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006161059, "chapter_id": 26161, "verse_number": "१-२-२२-६०", "content_sanskrit": "कुसुमितबहुपादपालताकं भ्रमरगणै रुपगीयमानखण्डम् ।\nपरभृतपरिपूर्णचारुशब्दं प्रविशति तद्वनमाश्रमं महेशः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006161060, "chapter_id": 26161, "verse_number": "१-२-२२-६१", "content_sanskrit": "ततस्तं मुनयः सर्वे तुष्टुवुः सुसमाहिताः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006161061, "chapter_id": 26161, "verse_number": "१-२-२२-६२", "content_sanskrit": "अद्भिर्विवधमाल्यैश्च धूपमन्धैस्तथैव च ।\nसपत्नीका महाभागाः सपुत्राः सपरिच्छदाः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006161062, "chapter_id": 26161, "verse_number": "१-२-२२-६३", "content_sanskrit": "मृदु भस्ते तदा वाग्भिर्गिरीशमिदमब्रुवन् ।\nअज्ञानाद्देवदेवस्य यदस्माभिग्नुष्ठितम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006161063, "chapter_id": 26161, "verse_number": "१-२-२२-६४", "content_sanskrit": "कर्मणा मनसा वाचा तत्सर्वं क्षंतुमर्हसि ।\nचरितानि विचित्राणि गुह्यानि गहनानि च ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006161064, "chapter_id": 26161, "verse_number": "१-२-२२-६५", "content_sanskrit": "ब्रह्मादीनां च देवानां दुर्विज्ञेयानि शंकर ।\nस्वागतं ते न जानीमो गतिं नैव च नैव च ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006161065, "chapter_id": 26161, "verse_number": "१-२-२२-६६", "content_sanskrit": "विश्वेश्वर महादेव योऽसि सोऽसि नमोऽस्तु ते ।\nस्तुवंति त्वां महात्मानो देवदेवं महेश्वरम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006161066, "chapter_id": 26161, "verse_number": "१-२-२२-६७", "content_sanskrit": "नमो भवाय भव्याय भावनायोद्भवाय च ।\nअनन्तबलवीर्याय भूतानां पतये नमः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006161067, "chapter_id": 26161, "verse_number": "१-२-२२-६८", "content_sanskrit": "संहर्त्रे कपिशांगाय अव्ययाय व्ययाय च ।\nगंगा सलिलधाराय चाधाराय गुणात्मने ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006161068, "chapter_id": 26161, "verse_number": "१-२-२२-६९", "content_sanskrit": "त्र्यंबकाय त्रिनेत्राय त्रिशूलवरधारिणे ।\nकंदर्पाय नमस्तुभ्यं नमोऽस्तु परमात्मने ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006161069, "chapter_id": 26161, "verse_number": "१-२-२२-७०", "content_sanskrit": "शकराय वृषांकाय गणानां पतये नमः ।\nदंडहस्ताय कालाय पाशहस्ताय वै नमः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006161070, "chapter_id": 26161, "verse_number": "१-२-२२-७१", "content_sanskrit": "वेदमन्त्रप्रधानाय शतजिह्वाय ते नमः ।\nभूतं भव्यं भविष्यच्च स्थावरं चंगमं च यत् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006161071, "chapter_id": 26161, "verse_number": "१-२-२२-७२", "content_sanskrit": "तव देहात्समुत्पन्नं देव सर्वमिदं जगत् ।\nशेभो पाहि च भद्रं ते प्रसीद भगवंस्ततः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006161072, "chapter_id": 26161, "verse_number": "१-२-२२-७३", "content_sanskrit": "अज्ञानाद्यदि वा ज्ञानाद्यत्किंचित्कुरुते नरः ।\nतत्सर्वं भगवानेव कुरुते योगमायया ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006161073, "chapter_id": 26161, "verse_number": "१-२-२२-७४", "content_sanskrit": "एवं स्तुत्वा तु मुनयः प्रहृष्टेनांतरात्मना ।\nयाचंते तपसा युक्ताः पश्यामस्त्त्वां यथा पुरा ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006161074, "chapter_id": 26161, "verse_number": "१-२-२२-७५", "content_sanskrit": "प्रकृतिस्थं च ते लिंगं तथैवास्तु यथा पुरा ।\nनमो दिग्वाससे नित्यं किंकिणीजालमालिने ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006161075, "chapter_id": 26161, "verse_number": "१-२-२२-७६", "content_sanskrit": "विकटाय करालाय करालवदनाय च ।\nअरूपाय सुरूपाय विश्वरूपाय ते नमः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006161076, "chapter_id": 26161, "verse_number": "१-२-२२-७७", "content_sanskrit": "कटंकटाय रूद्राय स्वाहाकाराय वै नमः ।\nसर्वप्राणात्मने तुभ्यं गुणदेहाय वै नमः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006161077, "chapter_id": 26161, "verse_number": "१-२-२२-७८", "content_sanskrit": "दुर्ग्गन्धाय सुगन्धाय शूलहस्ताय वै नमः ।\nस्वयं नीलशिखंडाय श्रीकण्ठाय नमो नमः ।\nनीलकण्ठाय देवाय चिताभस्मांगरागिणे ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006161078, "chapter_id": 26161, "verse_number": "१-२-२२-७९", "content_sanskrit": "गुणत्रयात्मने तुभ्यं नमो विश्वाय वेधसे ।\nश्मशानवासिने नित्यं प्रेतरूपाय वै नमः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006161079, "chapter_id": 26161, "verse_number": "१-२-२२-८०", "content_sanskrit": "त्वं ब्रह्मा सर्वदेवानां रुद्राणां नीललोहितः ।\nआत्मा च सर्वभूतानां सांख्यैः पुरुष उच्यते ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006161080, "chapter_id": 26161, "verse_number": "१-२-२२-८१", "content_sanskrit": "पर्वतानां महामेरुर्नक्षत्राणां च चंद्रमाः ।\nऋषीणां च वसिष्ठस्त्वं देवानां वासवस्तथा ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006161081, "chapter_id": 26161, "verse_number": "१-२-२२-८२", "content_sanskrit": "ओंकरः सर्ववेदानां ज्येष्ठसाम च सामसु ।\nआरण्यानां च सर्वेषां सिंहस्त्वं परमेश्वरः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006161082, "chapter_id": 26161, "verse_number": "१-२-२२-८३", "content_sanskrit": "ग्राम्याणामृषभश्चापि भगवाँल्लोकपूजितः ।\nसर्वथा वर्त्तमानोऽपि योयो भावो भविष्यति ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006161083, "chapter_id": 26161, "verse_number": "१-२-२२-८४", "content_sanskrit": "त्वामेव तत्र पश्यामो ब्रह्मणा कथितं यथा ।\nकामः क्रोधश्च लोभश्च विषादो मद एव च ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006161084, "chapter_id": 26161, "verse_number": "१-२-२२-८५", "content_sanskrit": "एतदिच्छाम वै रोद्धुं प्रसीद परमेश्वर ।\nमहासंहरणे प्राप्ते त्वया देव कृतात्मना ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006161085, "chapter_id": 26161, "verse_number": "१-२-२२-८६", "content_sanskrit": "करं ललाटे संपीड्य वह्निरुत्पादितस्त्वया ।\nतेनाग्निना तदा लोका अर्चिर्भिः सर्वतो वृताः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006161086, "chapter_id": 26161, "verse_number": "१-२-२२-८७", "content_sanskrit": "तस्मादग्निसमा ह्येते बहवो विकृताग्नयः ।\nयानि चान्यानिभूतानि स्थावराणि चराणि च ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006161087, "chapter_id": 26161, "verse_number": "१-२-२२-८८", "content_sanskrit": "दह्यंते प्राणिनस्ते तु त्वत्समुत्थेन वाह्निना ।\nअस्माकं दह्यमानानां त्राता भव सुरेश्वर ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006161088, "chapter_id": 26161, "verse_number": "१-२-२२-८९", "content_sanskrit": "त्वं च लोकहितार्थाय भूतानि परिषिंचसि ।\nमहेश्वर महाभाग प्रभो शुभनिरीक्षक ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006161089, "chapter_id": 26161, "verse_number": "१-२-२२-९०", "content_sanskrit": "आज्ञापय वयं नाथ कर्त्तारो वचनं तव ।\nरूपकोटिसहस्रेषु रूपकोटिशतेषु च ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006161090, "chapter_id": 26161, "verse_number": "१-२-२२-९१", "content_sanskrit": "अंतं गंतुं न शक्ताः स्म तव देव नमोऽस्तु ते ।\nततस्तु भगवानीश इदं वचनमब्रवीत् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7006161091, "chapter_id": 26161, "verse_number": "१-२-२२-९२", "content_sanskrit": "ये हि मे भस्मनिरता भस्मना दग्धकिल्बिषाः ।\nयथोक्तकारिणो दांता विप्रा ध्यानपरायणाः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7006161092, "chapter_id": 26161, "verse_number": "१-२-२२-९३", "content_sanskrit": "न तान्परिवदेद्विद्वान् न च तानतिलंघयेत् ।\nन चेमानप्रियं ब्रूयादमुत्रेह हितार्थवान् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7006161093, "chapter_id": 26161, "verse_number": "१-२-२२-९४", "content_sanskrit": "यस्तान्निन्दति मूढात्मा महादेवंस निंदति ।\nयस्त्वेतान्पूजयेन्नित्यं स पूजयति शङ्करम् ।\nएवं चरथ भद्रं वो मत्तः सिद्धिमवाप्स्यथ ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7006161094, "chapter_id": 26161, "verse_number": "१-२-२२-९५", "content_sanskrit": "अतुलमिह महातमः प्रणाशंशिवकथितं परमं विधिं विदित्वा ।\nअपगतभयलोभमोहचिंताः सह पतिताः महसा शिरोभिरूहुः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7006161095, "chapter_id": 26161, "verse_number": "१-२-२२-९६", "content_sanskrit": "ततस्ते मुदिता विप्राः प्रकृतिस्थे महेश्वरे ।\nगन्धोदकैः सुशुद्धैश्च कुशपुष्पविमिश्रितैः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7006161096, "chapter_id": 26161, "verse_number": "१-२-२२-९७", "content_sanskrit": "स्नापयंति महाकुम्भैरद्भिर्देवं महेश्वरम् ।\nगायंति विविधैर्गुह्यैर्हुंकारैश्चापि सुक्वरैः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7006161097, "chapter_id": 26161, "verse_number": "१-२-२२-९८", "content_sanskrit": "नमो दिग्वाससे देव किंकिणीध्राय वै नमः ।\nअर्द्ध नारीशरीराय सांख्ययोगप्रवर्त्तिने ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7006161098, "chapter_id": 26161, "verse_number": "१-२-२२-९९", "content_sanskrit": "घनवाहनकृष्णाय गजचर्मनिवासिने ।\nकृष्णाजिनोत्तरीयाय व्यालयज्ञोपवीतिने ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7006161099, "chapter_id": 26161, "verse_number": "१-२-२२-१००", "content_sanskrit": "सुरचितचित्रविचित्रकुण्डलाय सुरचितमाल्यविभूषणाय तुभ्यम् ।\nमृगपतिवरचर्मवाससे ते पृथुपरशो च नमोस्तु शंकराय ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7006161100, "chapter_id": 26161, "verse_number": "१-२-२२-१०१", "content_sanskrit": "भूयश्च स्थापिते लिंगे लोकानां हितकाम्यया ।\nवर्णधर्मपराश्चैव चेरुस्ते मुनिसत्तमाः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7006161101, "chapter_id": 26161, "verse_number": "१-२-२२-१०२", "content_sanskrit": "ततस्तान्स मुनीन्प्रीतः प्रत्युवाच महेश्वरः ।\nप्रीतोस्मि युष्मत्तपसा वरं वृणुत मुव्रताः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7006161102, "chapter_id": 26161, "verse_number": "१-२-२२-१०३", "content_sanskrit": "ततस्ते मुनयस्सर्वे प्रणिपत्य महेश्वरम् ।\nभृग्वंगिरा वसिष्ठश्च विश्वामित्रस्तथैव च ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7006161103, "chapter_id": 26161, "verse_number": "१-२-२२-१०४", "content_sanskrit": "गौतमोऽत्रिः सुकेशश्च पुलस्त्यः पुलहः क्रतुः ।\nमरीचिः कश्यपश्चापि संवर्तश्च महातपाः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7006161104, "chapter_id": 26161, "verse_number": "१-२-२२-१०५", "content_sanskrit": "ते प्रणम्य महादेवमिदं वचनमब्रुवन् ।\nभस्मस्नानं च नग्नत्वं वामत्वं प्रतिलोमता ।\nसेव्यासेव्यत्वं तु विभो एतदिच्छाम वेदितुम् ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7006161105, "chapter_id": 26161, "verse_number": "१-२-२२-१०६", "content_sanskrit": "भगवानुवाच ।\nएतद्वः संप्रवक्ष्यामि कथासर्वस्वमद्य वै ।\nअग्निर्ह्यहं सोमयुतः सोमश्चाग्निमुपश्रितः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7006161106, "chapter_id": 26161, "verse_number": "१-२-२२-१०७", "content_sanskrit": "कृताकृतं वदंत्यग्निं भूयो लोकाः समाश्रिताः ।\nअसकृच्चाग्निना दग्धं जगत्स्थावरजंगमम् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7006161107, "chapter_id": 26161, "verse_number": "१-२-२२-१०८", "content_sanskrit": "भस्मसाध्यं हि तत्सर्वं पवित्रमिद मुत्तमम् ।\nभस्मना वीर्यमास्थाय भूतानि परिषिंचति ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7006161108, "chapter_id": 26161, "verse_number": "१-२-२२-१०९", "content_sanskrit": "अग्निकार्यं च यत्कृत्वा करिष्यति च त्र्यायुषम् ।\nभस्मना मम वीर्येण मुच्यते सर्वकिल्बिषैः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7006161109, "chapter_id": 26161, "verse_number": "१-२-२२-११०", "content_sanskrit": "भासयत्येव यद्भस्म शुभं वासयते च यत् ।\nतत्क्षणात्सर्वपापानां भस्मेति परिकीर्त्यते ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7006161110, "chapter_id": 26161, "verse_number": "१-२-२२-१११", "content_sanskrit": "ऊष्मपाः पितरो ज्ञेया देवा वै सोमसंभवाः ।\nअग्नीषोमात्मकं सर्वं जगत्स्थावरजं गमम् ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7006161111, "chapter_id": 26161, "verse_number": "१-२-२२-११२", "content_sanskrit": "अहमग्निर्महातेजाः सोमश्चैषा ममांबिका ।\nअहमग्निश्च सोमश्च प्रकृत्या पुरुषः स्वयम् ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7006161112, "chapter_id": 26161, "verse_number": "१-२-२२-११३", "content_sanskrit": "तस्माद्भस्म महाभागा मद्वीर्यमिति चोच्यते ।\nस्ववीर्यं वपुषा चैव धारयामीति वै स्थितिः ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7006161113, "chapter_id": 26161, "verse_number": "१-२-२२-११४", "content_sanskrit": "तदा प्रभृति लोकेषु रक्षार्थमशुभेषु च ।\nभस्मना क्रियते रक्षा सूतिकानां गृहेषु च ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7006161114, "chapter_id": 26161, "verse_number": "१-२-२२-११५", "content_sanskrit": "भस्मस्नानविशुद्धात्मा जितक्रोधो जितेंद्रियः ।\nमत्समीपसुपागम्य न भूयो विनिवर्तते ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7006161115, "chapter_id": 26161, "verse_number": "१-२-२२-११६", "content_sanskrit": "व्रतं पाशुपतं योगं कापालं योगनिर्मितम् ।\nपूर्वं पाशुपतं ह्येतन्निर्मितं तदनुत्तमम् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7006161116, "chapter_id": 26161, "verse_number": "१-२-२२-११७", "content_sanskrit": "शेषाश्चाश्रमिणः सर्वे पश्चात्सृष्टाः स्वयंभुवा ।\nसृष्टिरेषा मया सृष्टा लज्जामोहभयात्मिका ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7006161117, "chapter_id": 26161, "verse_number": "१-२-२२-११८", "content_sanskrit": "नग्ना एव हि जायंते देवता मुनयस्तथा ।\nये चान्येमानवा लोके सर्वे जायंत्यवाससः ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7006161118, "chapter_id": 26161, "verse_number": "१-२-२२-११९", "content_sanskrit": "इंद्रियैरजितैर्नग्ना दुकूलेनापि संवृताः ।\nतैरेव संवृतो गुप्तोन वस्त्रं कारणं स्मृतम् ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7006161119, "chapter_id": 26161, "verse_number": "१-२-२२-१२०", "content_sanskrit": "क्षमा धृतिरहिंसा च वैराग्यं चैव सर्वशः ।\nतुल्यौ मानापमानौ च तत्प्रावरणमुत्तमम् ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7006161120, "chapter_id": 26161, "verse_number": "१-२-२२-१२१", "content_sanskrit": "भस्मपांडुरदिग्धांगो ध्यायते मनसा भवम् ।\nयद्यकार्यसहस्राणि कृत्वा स्नायति भस्मना ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7006161121, "chapter_id": 26161, "verse_number": "१-२-२२-१२२", "content_sanskrit": "तत्सर्वं दहते भस्म यथाग्निस्तेजसा वनम् ।\nतस्मा द्यत्नपरो भूत्वा त्रिकालमपि यः सदा ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7006161122, "chapter_id": 26161, "verse_number": "१-२-२२-१२३", "content_sanskrit": "भस्मना कुरुते स्नानं गाणपत्यं स गच्छति ।\nसंहृत्य च क्रतून्सर्वान्गृहीत्वामृतमुत्त मम् ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7006161123, "chapter_id": 26161, "verse_number": "१-२-२२-१२४", "content_sanskrit": "ध्यायंति ये महादेवं लीनास्तद्भावभाविताः ।\nउत्तरेणाथ पंथानं तेऽमृतत्वमवाप्नुयुः ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7006161124, "chapter_id": 26161, "verse_number": "१-२-२२-१२५", "content_sanskrit": "दक्षिणेनाथ पंथानं ये श्मशानानि भेजिरे ।\nअणिमा महिमा चैव लघिमा प्राप्तिरेव च ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7006161125, "chapter_id": 26161, "verse_number": "१-२-२२-१२६", "content_sanskrit": "गरिमा पंचमी चैव षष्ठं प्राकाम्यमेव च ।\nईशित्वं च वशित्वं च ह्यमरत्वं च ते गताः ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7006161126, "chapter_id": 26161, "verse_number": "१-२-२२-१२७", "content_sanskrit": "इंद्रादयस्तथा देवाः कामिकं व्रतमास्थिताः ।\nऐश्वर्यं परमं प्राप्य सर्वे प्रथिततेजसः ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7006161127, "chapter_id": 26161, "verse_number": "१-२-२२-१२८", "content_sanskrit": "व्यपगतमदमोहमुक्तरागास्तमेरहजदोषविवर्जितस्वभावाः ।\nपरिभवमिदमुत्तमं विदित्वा पशुपतिदयितमिदं व्रतं चरध्वम् ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7006161128, "chapter_id": 26161, "verse_number": "१-२-२२-१२९", "content_sanskrit": "यः पठेद्वै शुचिर्भूत्वा श्रद्दधानो जितेंद्रियः ।\nसर्वपापविशुद्धात्मा रुद्रलोकं स गच्छति ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}]