[{"id": 7005049000, "chapter_id": 25049, "verse_number": "७-१-२३२-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेन्महादेवि कूपं त्रैलोक्यपूजितम् ।\nपश्चिमे तस्य तीर्थस्य पांडवानां महात्मनाम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005049001, "chapter_id": 25049, "verse_number": "७-१-२३२-२", "content_sanskrit": "यदाऽरण्यमनुप्राप्ताः पांडवाः पृथिवीतले ।\nभ्रममाणा महादेवि प्रभासं क्षेत्रमागताः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005049002, "chapter_id": 25049, "verse_number": "७-१-२३२-३", "content_sanskrit": "ततस्ते न्यवसंस्तत्र किंचित्कालं समाहिताः ।\nगत्वा क्षेत्रं महापुण्यं ततः कृष्णाऽब्रवीदिदम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005049003, "chapter_id": 25049, "verse_number": "७-१-२३२-४", "content_sanskrit": "ब्राह्मणानां सहस्राणि भुंजते भवतां गृहे ।\nदूरे जलाश्रयश्चैव न तावंतश्च किंकराः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005049004, "chapter_id": 25049, "verse_number": "७-१-२३२-५", "content_sanskrit": "तस्माज्जलाश्रयः कार्यं आश्रमस्य समीपतः ।\nयत्र स्नानं करिष्यामि युष्माकं संप्रसादतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005049005, "chapter_id": 25049, "verse_number": "७-१-२३२-६", "content_sanskrit": "ततस्तु पांडवाः सर्वे सहितास्ते वरानने ।\nअखनंस्तत्र ते कूपं द्रौपदीवाक्यप्रेरिताः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005049006, "chapter_id": 25049, "verse_number": "७-१-२३२-७", "content_sanskrit": "अथाजगाम तत्रैव भगवान्देवकीसुतः ।\nश्रुत्वा समागतान्पार्थान्द्वारावत्याः सबांधवः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005049007, "chapter_id": 25049, "verse_number": "७-१-२३२-८", "content_sanskrit": "प्रद्युम्नेन च सांबेन गदेन निषधेन च ।\nयुयुधानेन रामेण चारुदेष्णेन धीमता ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005049008, "chapter_id": 25049, "verse_number": "७-१-२३२-९", "content_sanskrit": "अन्यैः परिवृतः शूरैर्यादवैर्युद्ध दुर्मदैः ।\nते समेत्य यथान्यायं समस्ता यदुपुंगवाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005049009, "chapter_id": 25049, "verse_number": "७-१-२३२-१०", "content_sanskrit": "ततः कथावसाने च कस्मिंश्चित्कारणांतरे ।\nवासुदेवः पांडुसुतमिदं वचनमब्रवीत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005049010, "chapter_id": 25049, "verse_number": "७-१-२३२-११", "content_sanskrit": "युधिष्ठिर महाबाहो किं ते कामकरोम्यहम् ।\nराज्यं धान्यं धनं चापि अथवा रिपुनाशनम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005049011, "chapter_id": 25049, "verse_number": "७-१-२३२-१२", "content_sanskrit": "युधिष्ठिर उवाच ।\nशक्तस्त्वं यादवश्रेष्ठ सर्वकर्मस्वसंशयः ।\nप्रतिज्ञातं त्वया पूर्वं वर्षैर्द्वादशभिः प्रियम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005049012, "chapter_id": 25049, "verse_number": "७-१-२३२-१३", "content_sanskrit": "तन्नास्ति त्रिषु लोकेषु यन्न सिद्ध्यति भूतले ।\nत्वयि तुष्टे जगन्नाथ सर्वदेवनमस्कृते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005049013, "chapter_id": 25049, "verse_number": "७-१-२३२-१४", "content_sanskrit": "अवश्यं यदि तुष्टोऽसि मम सर्वजगत्पते ।\nअत्र सांनिध्यमागच्छ कूपे नित्यं जनार्दन ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005049014, "chapter_id": 25049, "verse_number": "७-१-२३२-१५", "content_sanskrit": "अत्रागत्य नरो यस्तु भक्त्या स्नानं समाचरेत् ।\nस यातु वैष्णवं स्थानं प्रसादात्तव केशव ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005049015, "chapter_id": 25049, "verse_number": "७-१-२३२-१६", "content_sanskrit": "ईश्वर उवाच ।\nएवं भविष्यतीत्युक्त्वा तदाऽमन्त्र्य युधिष्ठिरम् ।\nप्रययौ द्वारकां कृष्णः सर्वलोकनमस्कृतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005049016, "chapter_id": 25049, "verse_number": "७-१-२३२-१७", "content_sanskrit": "तस्मिञ्छ्राद्धं नरः कृत्वा वाजिमेधफलं लभेत् ।\nप्रसादाद्देवदेवस्य विष्णोरमिततेजसः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005049017, "chapter_id": 25049, "verse_number": "७-१-२३२-१८", "content_sanskrit": "तदर्धं तर्पणेनैव स्नानात्पादमवाप्नुयात् ।\nतस्मात्सर्वप्रयत्नेन तत्र श्राद्धं समाचरेत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005049018, "chapter_id": 25049, "verse_number": "७-१-२३२-१९", "content_sanskrit": "ज्येष्ठस्य पौर्णमास्यां यः स्नानं श्राद्धं करिष्यति ।\nसावित्रीं चैव संपूज्य स यास्यति परमं पदम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005049019, "chapter_id": 25049, "verse_number": "७-१-२३२-२०", "content_sanskrit": "गोदानं तत्र देयं तु सम्यग्यात्राफलेप्सुभिः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]