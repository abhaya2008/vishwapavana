[{"id": 7000431000, "chapter_id": 20431, "verse_number": "२-१०३-१", "content_sanskrit": "कुंजल उवाच ।\nअशोकसुंदरी जाता सर्वयोषिद्वरा तदा ।\nरेमे सुनंदने पुण्ये सर्वकामगुणान्विते॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000431001, "chapter_id": 20431, "verse_number": "२-१०३-२", "content_sanskrit": "सुरूपाभिः सुकन्याभिर्देवानां चारुहासिनी ।\nसर्वान्भोगान्प्रभुंजाना गीतनृत्यविचक्षणा॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000431002, "chapter_id": 20431, "verse_number": "२-१०३-३", "content_sanskrit": "विप्रचित्तेः सुतो हुंडो रौद्रस्तीव्रश्च सर्वदा ।\nस्वेच्छाचारो महाकामी नंदनं प्रविवेश ह॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000431003, "chapter_id": 20431, "verse_number": "२-१०३-४", "content_sanskrit": "अशोकसुंदरीं दृष्ट्वा सर्वालंकारसंयुताम् ।\nतस्यास्तु दर्शनाद्दैत्यो विद्धः कामस्य मार्गणैः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000431004, "chapter_id": 20431, "verse_number": "२-१०३-५", "content_sanskrit": "तामुवाच महाकायः का त्वं कस्यासि वा शुभे ।\nकस्मात्त्वं कारणाच्चात्र आगतासि वनोत्तमम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000431005, "chapter_id": 20431, "verse_number": "२-१०३-६", "content_sanskrit": "अशोकसुंदर्युवाच ।\nशिवस्यापि सुपुण्यस्य सुताहं शृणु सांप्रतम् ।\nस्वसाहं कार्तिकेयस्य जननी गोत्रजापि मे॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000431006, "chapter_id": 20431, "verse_number": "२-१०३-७", "content_sanskrit": "बालभावेन संप्राप्ता लीलया नंदनं वनम् ।\nभवान्कोहि किमर्थं तु मामेवं परिपृच्छति॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000431007, "chapter_id": 20431, "verse_number": "२-१०३-८", "content_sanskrit": "हुंड उवाच ।\nविप्रचित्तेः सुतश्चाहं गुणलक्षणसंयुतः ।\nहुंडेति नाम्ना विख्यातो बलवीर्यमदोद्धतः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000431008, "chapter_id": 20431, "verse_number": "२-१०३-९", "content_sanskrit": "दैत्यानामप्यहं श्रेष्ठो मत्समो नास्ति राक्षसः ।\nदेवेषु मर्त्यलोकेषु तपसा यशसा कुले॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000431009, "chapter_id": 20431, "verse_number": "२-१०३-१०", "content_sanskrit": "अन्येषु नागलोकेषु धनभोगैर्वरानने ।\nदर्शनात्ते विशालाक्षि हतः कंदर्पमार्गणैः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000431010, "chapter_id": 20431, "verse_number": "२-१०३-११", "content_sanskrit": "शरणं ते ह्यहं प्राप्तः प्रसादसुमुखी भव ।\nभव स्ववल्लभा भार्या मम प्राणसमा प्रिया॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000431011, "chapter_id": 20431, "verse_number": "२-१०३-१२", "content_sanskrit": "अशोकसुंदर्युवाच ।\nश्रूयतामभिधास्यामि सर्वसंबंधकारणम् ।\nभवितव्या सुजातस्य लोके स्त्री पुरुषस्य हि॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000431012, "chapter_id": 20431, "verse_number": "२-१०३-१३", "content_sanskrit": "भवितव्यस्तथा भर्ता स्त्रिया यः सदृशो गुणैः ।\nसंसारे लोकमार्गोयं शृणु हुंड यथाविधि॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000431013, "chapter_id": 20431, "verse_number": "२-१०३-१४", "content_sanskrit": "अस्त्येव कारणं चात्र यथा तेन भवाम्यहम् ।\nसुभार्या दैत्यराजेंद्र शृणुष्व यतमानसः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000431014, "chapter_id": 20431, "verse_number": "२-१०३-१५", "content_sanskrit": "वृक्षराजादहं जाता यदा काले महामते ।\nशंभोर्भावं सुसंगृह्य पार्वत्या कल्पिता ह्यहम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000431015, "chapter_id": 20431, "verse_number": "२-१०३-१६", "content_sanskrit": "देवस्यानुमते देव्या सृष्टो भर्ता ममैव हि ।\nसोमवंशे महाप्राज्ञः स धर्मात्मा भविष्यति॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000431016, "chapter_id": 20431, "verse_number": "२-१०३-१७", "content_sanskrit": "जिष्णुर्जिष्णुसमो वीर्ये तेजसा पावकोपमः ।\nसर्वज्ञः सत्यसंधश्च त्यागे वैश्रवणोपमः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000431017, "chapter_id": 20431, "verse_number": "२-१०३-१८", "content_sanskrit": "यज्वा दानपतिः सोपि रूपेण मन्मथोपमः ।\nनहुषोनाम धर्मात्मा गुणशील महानिधिः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000431018, "chapter_id": 20431, "verse_number": "२-१०३-१९", "content_sanskrit": "देव्या देवेन मे दत्तःख्यातोभर्ताभविष्यति ।\nतस्मात्सर्वगुणोपेतं पुत्रमाप्स्यामि सुंदरम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000431019, "chapter_id": 20431, "verse_number": "२-१०३-२०", "content_sanskrit": "इंद्रोपेंद्र समं लोके ययातिं जनवल्लभम् ।\nलप्स्याम्यहं रणे धीरं तस्माच्छंभोः प्रसादतः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000431020, "chapter_id": 20431, "verse_number": "२-१०३-२१", "content_sanskrit": "अहं पतिव्रता वीर परभार्या विशेषतः ।\nअतस्त्वं सर्वथा हुंड त्यज भ्रांतिमितो व्रज॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000431021, "chapter_id": 20431, "verse_number": "२-१०३-२२", "content_sanskrit": "प्रहस्यैव वचो ब्रूते अशोकसुंदरीं प्रति ।\nहुंड उवाच ।\nनैव युक्तं त्वया प्रोक्तं देव्या देवेन चैव हि॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000431022, "chapter_id": 20431, "verse_number": "२-१०३-२३", "content_sanskrit": "नहुषोनाम धर्मात्मा सोमवंशे भविष्यति ।\nभवती वयसा श्रेष्ठा कनिष्ठो न स युज्यते॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000431023, "chapter_id": 20431, "verse_number": "२-१०३-२४", "content_sanskrit": "कनिष्ठा स्त्री प्रशस्ता तु पुरुषो न प्रशस्यते ।\nकदा स पुरुषो भद्रे तव भर्ता भविष्यति॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000431024, "chapter_id": 20431, "verse_number": "२-१०३-२५", "content_sanskrit": "तारुण्यं यौवनं चापि नाशमेवं प्रयास्यति ।\nयौवनस्य बलेनापि रूपवत्यः सदा स्त्रियः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000431025, "chapter_id": 20431, "verse_number": "२-१०३-२६", "content_sanskrit": "पुरुषाणां वल्लभत्वं प्रयांति वरवर्णिनि ।\nतारुण्यं हि महामूलं युवतीनां वरानने॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000431026, "chapter_id": 20431, "verse_number": "२-१०३-२७", "content_sanskrit": "तस्या धारेण भुंजंति भोगान्कामान्मनोनुगान् ।\nकदा सोभ्येष्यते भद्रे आयोः पुत्रः शृणुष्व मे॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000431027, "chapter_id": 20431, "verse_number": "२-१०३-२८", "content_sanskrit": "यौवनं वर्ततेऽद्यैव वृथा चैव भविष्यति ।\nगर्भत्वं च शिशुत्वं च कौमारं च निशामय॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000431028, "chapter_id": 20431, "verse_number": "२-१०३-२९", "content_sanskrit": "कदासौ यौवनोपेतस्तव योग्यो भविष्यति ।\nयौवनस्य प्रभावेन पिबस्व मधुमाधवीम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000431029, "chapter_id": 20431, "verse_number": "२-१०३-३०", "content_sanskrit": "मया सह विशालाक्षि रमस्व त्वं सुखेन वै ।\nहुंडस्य वचनं श्रुत्वा शिवस्य तनया पुनः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000431030, "chapter_id": 20431, "verse_number": "२-१०३-३१", "content_sanskrit": "उवाच दानवेंद्रं तं साध्वसेन समन्विता ।\nअष्टाविंशतिके प्राप्ते द्वापराख्ये युगे तदा॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000431031, "chapter_id": 20431, "verse_number": "२-१०३-३२", "content_sanskrit": "शेषावतारो धर्मात्मा वसुदेवसुतो बलः ।\nरेवतस्य सुतां दिव्यां भार्यां स च करिष्यति॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000431032, "chapter_id": 20431, "verse_number": "२-१०३-३३", "content_sanskrit": "सापि जाता महाभाग कृताख्ये हि युगोत्तमे ।\nयुगत्रयप्रमाणेन सा हि ज्येष्ठा बलादपि॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000431033, "chapter_id": 20431, "verse_number": "२-१०३-३४", "content_sanskrit": "बलस्य सा प्रिया जाता रेवती प्राणसंमिता ।\nभविष्यद्वापरे प्राप्त इह सा तु भविष्यति॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000431034, "chapter_id": 20431, "verse_number": "२-१०३-३५", "content_sanskrit": "मायावती पुरा जाता गंधर्वतनया वरा ।\nअपहृत्य नियम्यैव शंबरो दानवोत्तमः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000431035, "chapter_id": 20431, "verse_number": "२-१०३-३६", "content_sanskrit": "तस्या भर्ता समाख्यातो माधवस्य सुतो बली ।\nप्रद्युम्नो नाम वीरेशो यादवेश्वरनंदनः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000431036, "chapter_id": 20431, "verse_number": "२-१०३-३७", "content_sanskrit": "तस्मिन्युगे भविष्येत भाव्यं दृष्टं पुरातनैः ।\nव्यासादिभिर्महाभागैर्ज्ञानवद्भिर्महात्मभिः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000431037, "chapter_id": 20431, "verse_number": "२-१०३-३८", "content_sanskrit": "एवं हि दृश्यते दैत्य वाक्यं देव्या तदोदितम् ।\nमां प्रति हि जगद्धात्र्या पुत्र्या हिमवतस्तदा॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000431038, "chapter_id": 20431, "verse_number": "२-१०३-३९", "content_sanskrit": "त्वं तु लोभेन कामेन लुब्धो वदसि दुष्कृतम् ।\nकिल्बिषेण समाजुष्टं वेदशास्त्रविवर्जितम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000431039, "chapter_id": 20431, "verse_number": "२-१०३-४०", "content_sanskrit": "यद्यस्यदिष्टमेवास्ति शुभं वाप्यशुभं दृढम् ।\nपूर्वकर्मानुसारेण तत्तस्य परिजायते॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000431040, "chapter_id": 20431, "verse_number": "२-१०३-४१", "content_sanskrit": "देवानां ब्राह्मणानां च वदने यत्सुभाषितम् ।\nनिःसरेद्यदि सत्यं तदन्यथा नैव जायते॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000431041, "chapter_id": 20431, "verse_number": "२-१०३-४२", "content_sanskrit": "मद्भाग्यादेवमाज्ञातं नहुषस्यापि तस्य च ।\nसमायोगं विचार्यैवं देव्या प्रोक्तं शिवेन च॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000431042, "chapter_id": 20431, "verse_number": "२-१०३-४३", "content_sanskrit": "एवं ज्ञात्वा शमं गच्छ त्यज भ्रांतिं मनःस्थिताम् ।\nनैव शक्तो भवान्दैत्य मे मनश्चालितुं ध्रुवम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000431043, "chapter_id": 20431, "verse_number": "२-१०३-४४", "content_sanskrit": "पतिव्रता दृढा चित्ते स को मे चालितुं क्षमः ।\nमहाशापेन धक्ष्यामि इतो गच्छ महासुर॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000431044, "chapter_id": 20431, "verse_number": "२-१०३-४५", "content_sanskrit": "एवमाकर्ण्य तद्वाक्यं हुंडो वै दानवो बली ।\nमनसा चिंतयामास कथं भार्या भवेदियम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000431045, "chapter_id": 20431, "verse_number": "२-१०३-४६", "content_sanskrit": "विचिंत्य हुंडो मायावी अंतर्धानं समागतः ।\nततो निष्क्रम्य वेगेन तस्मात्स्थानाद्विहाय ताम् ।\nअन्यस्मिन्दिवसे प्राप्ते मायां कृत्वा तमोमयीम्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000431046, "chapter_id": 20431, "verse_number": "२-१०३-४७", "content_sanskrit": "दिव्यं मायामयं रूपं कृत्वा नार्यास्तु दानवः ।\nमायया कन्यका रूपो बभूव मम नंदन॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000431047, "chapter_id": 20431, "verse_number": "२-१०३-४८", "content_sanskrit": "सा कन्यापि वरारोहा मायारूपागमत्ततः ।\nहास्यलीला समायुक्ता यत्रास्ते भवनंदिनी॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000431048, "chapter_id": 20431, "verse_number": "२-१०३-४९", "content_sanskrit": "उवाच वाक्यं स्निग्धेव अशोकसुंदरीं प्रति ।\nकासि कस्यासि सुभगे तिष्ठसि त्वं तपोवने॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000431049, "chapter_id": 20431, "verse_number": "२-१०३-५०", "content_sanskrit": "किमर्थं क्रियते बाले कामशोषणकं तपः ।\nतन्ममाचक्ष्व सुभगे किंनिमित्तं सुदुष्करम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000431050, "chapter_id": 20431, "verse_number": "२-१०३-५१", "content_sanskrit": "तन्निशम्य शुभं वाक्यं दानवेनापि भाषितम् ।\nमायारूपेण छन्नेन साभिलाषेण सत्वरम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000431051, "chapter_id": 20431, "verse_number": "२-१०३-५२", "content_sanskrit": "आत्मसृष्टि सुवृत्तांतं प्रवृत्तं तु यथा पुरा ।\nतपसः कारणं सर्वं समाचष्ट सुदुःखिता॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000431052, "chapter_id": 20431, "verse_number": "२-१०३-५३", "content_sanskrit": "उपप्लवं तु तस्यापि दानवस्य दुरात्मनः ।\nमायारूपं न जानाति सौहृदात्कथितं तया॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000431053, "chapter_id": 20431, "verse_number": "२-१०३-५४", "content_sanskrit": "हुंड उवाच ।\nपतिव्रतासि हे देवि साधुव्रतपरायणा ।\nसाधुशीलसमाचारा साधुचारा महासती॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000431054, "chapter_id": 20431, "verse_number": "२-१०३-५५", "content_sanskrit": "अहं पतिव्रता भद्रे पतिव्रतपरायणा ।\nतपश्चरामि सुभगे भर्तुरर्थे महासती॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000431055, "chapter_id": 20431, "verse_number": "२-१०३-५६", "content_sanskrit": "मम भर्ता हतस्तेन हुंडेनापि दुरात्मना ।\nतस्य नाशाय वै घोरं तपस्यामि महत्तपः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000431056, "chapter_id": 20431, "verse_number": "२-१०३-५७", "content_sanskrit": "एहि मे स्वाश्रमे पुण्ये गंगातीरे वसाम्यहम् ।\nअन्यैर्मनोहरैर्वाक्यैरुक्ता प्रत्ययकारकैः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000431057, "chapter_id": 20431, "verse_number": "२-१०३-५८", "content_sanskrit": "हुंडेन सखिभावेन मोहिता शिवनंदिनी ।\nसमाकृष्टा सुवेगेन महामोहेन मोहिता॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000431058, "chapter_id": 20431, "verse_number": "२-१०३-५९", "content_sanskrit": "आनीतात्मगृहं दिव्यमनौपम्यं सुशोभनम् ।\nमेरोस्तु शिखरे पुत्र वैडूर्याख्यं पुरोत्तमम्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000431059, "chapter_id": 20431, "verse_number": "२-१०३-६०", "content_sanskrit": "अस्ति सर्वगुणोपेतं कांचनाख्यं महाशिवम् ।\nतुंगप्रासादसंबाधैः कलशैर्दंडचामरैः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000431060, "chapter_id": 20431, "verse_number": "२-१०३-६१", "content_sanskrit": "नानवृक्षसमोपेतैर्वनैर्नीलैर्घनोपमैः ।\nवापीकूपतडागैश्च नदीभिस्तु जलाशयैः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000431061, "chapter_id": 20431, "verse_number": "२-१०३-६२", "content_sanskrit": "शोभमानं महारत्नैः प्राकारैर्हेमसंयतैः ।\nसर्वकामसमृद्धार्थं संपूर्णं दानवस्य हि॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000431062, "chapter_id": 20431, "verse_number": "२-१०३-६३", "content_sanskrit": "ददृशे सा पुरं रम्यमशोकसुंदरी तदा ।\nकस्य देवस्य संस्थानं कथयस्व सखे मम॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000431063, "chapter_id": 20431, "verse_number": "२-१०३-६४", "content_sanskrit": "सोवाच दानवेंद्रस्य दृष्टपूर्वस्य वै त्वया ।\nतस्य स्थानं महाभागे सोऽहं दानवपुंगवः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000431064, "chapter_id": 20431, "verse_number": "२-१०३-६५", "content_sanskrit": "मया त्वं तु समानीता मायया वरवर्णिनि ।\nतामाभाष्य गृहं नीता शातकौंभं सुशोभनम्॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000431065, "chapter_id": 20431, "verse_number": "२-१०३-६६", "content_sanskrit": "नानावेश्मैः समाजुष्टं कैलासशिखरोपमम् ।\nनिवेश्य सुंदरीं तत्र दोलायां कामपीडितः॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000431066, "chapter_id": 20431, "verse_number": "२-१०३-६७", "content_sanskrit": "पुनः स्वरूपी दैत्येंद्रः कामबाणप्रपीडितः ।\nकरसंपुटमाबध्य उवाच वचनं तदा॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000431067, "chapter_id": 20431, "verse_number": "२-१०३-६८", "content_sanskrit": "यं यं त्वं वांछसे भद्रे तं तं दद्मि न संशयः ।\nभज मां त्वं विशालाक्षि भजंतं कामपीडितम्॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000431068, "chapter_id": 20431, "verse_number": "२-१०३-६९", "content_sanskrit": "श्रीदेव्युवाच ।\nनैव चालयितुं शक्तो भवान्मां दानवेश्वरः ।\nमनसापि न वै धार्यं मम मोहं समागतम्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000431069, "chapter_id": 20431, "verse_number": "२-१०३-७०", "content_sanskrit": "भवादृशैर्महापापैर्देवैर्वा दानवाधमैः ।\nदुष्प्राप्याहं न संदेहो मा वदस्व पुनः पुनः॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000431070, "chapter_id": 20431, "verse_number": "२-१०३-७१", "content_sanskrit": "स्कंदानुजा सा तपसाभियुक्ता जाज्वल्यमाना महता रुषा च ।\nसंहर्तुकामा परि दानवं तं कालस्य जिह्वेव यथा स्फुरंती॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000431071, "chapter_id": 20431, "verse_number": "२-१०३-७२", "content_sanskrit": "पुनरुवाच सा देवी तमेवं दानवाधमम् ।\nउग्रं कर्म कृतं पाप चात्मनाशनहेतवे॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000431072, "chapter_id": 20431, "verse_number": "२-१०३-७३", "content_sanskrit": "आत्मवंशस्य नाशाय स्वजनस्यास्य वै त्वया ।\nदीप्ता स्वगृहमानीता सुशिखा कृष्णवर्त्मनः॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000431073, "chapter_id": 20431, "verse_number": "२-१०३-७४", "content_sanskrit": "यथाऽशुभः कूटपक्षी सर्वशोकैः समुद्गतः ।\nगृहं तु विशते यस्य तस्य नाशं प्रयच्छति॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000431074, "chapter_id": 20431, "verse_number": "२-१०३-७५", "content_sanskrit": "स्वजनस्य च सर्वस्य सधनस्य कुलस्य च ।\nस द्विजो नाशमिच्छेत विशत्येव यदा गृहम्॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000431075, "chapter_id": 20431, "verse_number": "२-१०३-७६", "content_sanskrit": "तथा तेहं गृहं प्राप्ता तव नाशं समीहती ।\nपुत्राणां धनधान्यस्य तव वंशस्य सांप्रतम्॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000431076, "chapter_id": 20431, "verse_number": "२-१०३-७७", "content_sanskrit": "जीवं कुलं धनं धान्यं पुत्रपौत्रादिकं तव ।\nसर्वं ते नाशयित्वाहं यास्यामि च न संशयः॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000431077, "chapter_id": 20431, "verse_number": "२-१०३-७८", "content_sanskrit": "यथा त्वयाहमानीता चरंती परमं तपः ।\nपतिकामा प्रवांच्छंती नहुषं चायुनंदनम्॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000431078, "chapter_id": 20431, "verse_number": "२-१०३-७९", "content_sanskrit": "तथा त्वां मम भर्ता च नाशयिष्यति दानव ।\nमन्निमित्तौपायोऽयं दृष्टो देवेन वै पुरा॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000431079, "chapter_id": 20431, "verse_number": "२-१०३-८०", "content_sanskrit": "सत्येयं लौकिकी गाथा यां गायंति विदो जनाः ।\nप्रत्यक्षं दृश्यते लोके न विंदंति कुबुद्धयः॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000431080, "chapter_id": 20431, "verse_number": "२-१०३-८१", "content_sanskrit": "येन यत्र प्रभोक्तव्यं यस्माद्दुःखसुखादिकम् ।\nस एव भुंजते तत्र तस्मादेव न संशयः॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000431081, "chapter_id": 20431, "verse_number": "२-१०३-८२", "content_sanskrit": "कर्मणोस्य फलं भुंक्ष्व स्वकीयस्य महीतले ।\nयास्यसे निरयस्थानं परदाराभिमर्शनात्॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000431082, "chapter_id": 20431, "verse_number": "२-१०३-८३", "content_sanskrit": "सुतीक्ष्णं हि सुधारं तु सुखड्गं च विघट्टति ।\nअंगुल्यग्रेण कोपाय तथा मां विद्धि सांप्रतम्॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000431083, "chapter_id": 20431, "verse_number": "२-१०३-८४", "content_sanskrit": "सिंहस्य संमुखं गत्वा क्रुद्धस्य गर्जितस्य च ।\nको लुनाति मुखात्केशान्साहसाकारसंयुतः॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000431084, "chapter_id": 20431, "verse_number": "२-१०३-८५", "content_sanskrit": "सत्याचारां दमोपेतां नियतां तपसि स्थिताम् ।\nनिधनं चेच्छते यो वै स वै मां भोक्तुमिच्छति॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000431085, "chapter_id": 20431, "verse_number": "२-१०३-८६", "content_sanskrit": "समणिं कृष्णसर्पस्य जीवमानस्य सांप्रतम् ।\nगृहीतुमिच्छते सो हि यथा कालेन प्रेषितः॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000431086, "chapter_id": 20431, "verse_number": "२-१०३-८७", "content_sanskrit": "भवांस्तु प्रेषितो मूढ कालेन कालमोहितः ।\nतदा ते ईदृशी जाता कुमतिः किं नपश्यसि॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000431087, "chapter_id": 20431, "verse_number": "२-१०३-८८", "content_sanskrit": "ऋते तु आयुपुत्रेण समालोकयते हि कः ।\nअन्यो हि निधनं याति ममरूपावलोकनात्॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000431088, "chapter_id": 20431, "verse_number": "२-१०३-८९", "content_sanskrit": "एवमाभाषयित्वा तं गंगातीरं गता सती ।\nसशोका दुःखसंविग्ना नियतानि यमान्विता॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000431089, "chapter_id": 20431, "verse_number": "२-१०३-९०", "content_sanskrit": "पूर्वमाचरितं घोरं पतिकामनया तपः ।\nतव नाशार्थमिच्छंती चरिष्ये दारुणं पुनः॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000431090, "chapter_id": 20431, "verse_number": "२-१०३-९१", "content_sanskrit": "यदा त्वां निहतं दुष्टं नहुषेण महात्मना ।\nनिशितैर्वज्रसंकाशैर्बाणैराशीविषोपमैः॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000431091, "chapter_id": 20431, "verse_number": "२-१०३-९२", "content_sanskrit": "रणे निपतितं पाप मुक्तकेशं सलोहितम् ।\nगतासुं च प्रपश्यामि तदा यास्याम्यहं पतिम्॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000431092, "chapter_id": 20431, "verse_number": "२-१०३-९३", "content_sanskrit": "एवं सुनियमं कृत्वा गंगातीरमनुत्तमम् ।\nसंस्थिता हुंडनाशाय निश्चला शिवनंदिनी॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000431093, "chapter_id": 20431, "verse_number": "२-१०३-९४", "content_sanskrit": "वह्नेर्यथादीप्तिमती शिखोज्ज्वला तेजोभियुक्ता प्रदहेत्सुलोकान् ।\nक्रोधेन दीप्ता विबुधेशपुत्री गंगातटे दुश्चरमाचरत्तपः॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000431094, "chapter_id": 20431, "verse_number": "२-१०३-९५", "content_sanskrit": "कुंजल उवाच ।\nएवमुक्ता महाभाग शिवस्य तनया गता ।\nगंगांभसि ततः स्नात्वा स्वपुरे कांचनाह्वये॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000431095, "chapter_id": 20431, "verse_number": "२-१०३-९६", "content_sanskrit": "तपश्चचार तन्वंगी हुंडस्य वधहेतवे ।\nअशोकसुंदरी बाला सत्येन च समन्विता॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000431096, "chapter_id": 20431, "verse_number": "२-१०३-९७", "content_sanskrit": "हुंडोपि दुःखितोभूतः शापदग्धेन चेतसा ।\nचिंतयामास संतप्त अतीव वचनानलैः॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000431097, "chapter_id": 20431, "verse_number": "२-१०३-९८", "content_sanskrit": "समाहूय अमात्यं तं कंपनाख्यमथाब्रवीत् ।\nसमाचष्ट स वृत्तांतं तस्याः शापोद्भवं महत्॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000431098, "chapter_id": 20431, "verse_number": "२-१०३-९९", "content_sanskrit": "शप्तोस्म्यशोकसुंदर्या शिवस्यापि सुकन्यया ।\nनहुषस्यापि मे भर्त्तुस्त्वं तु हस्तान्मरिष्यसि॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000431099, "chapter_id": 20431, "verse_number": "२-१०३-१००", "content_sanskrit": "नैव जातस्त्वसौ गर्भ आयोर्भार्या च गुर्विणी ।\nयथा सत्याद्व्यलीकस्तु तस्याः शापस्तथा कुरु॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000431100, "chapter_id": 20431, "verse_number": "२-१०३-१०१", "content_sanskrit": "कंपन उवाच ।\nअपहृत्य प्रियां तस्य आयोश्चापि समानय ।\nअनेनापि प्रकारेण तव शत्रुर्न जायते॥ १०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000431101, "chapter_id": 20431, "verse_number": "२-१०३-१०२", "content_sanskrit": "नो वा प्रपातयस्व त्वं गर्भं तस्याः प्रभीषणैः ।\nअनेनापि प्रकारेण तव शत्रुर्न जायते॥ १०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000431102, "chapter_id": 20431, "verse_number": "२-१०३-१०३", "content_sanskrit": "जन्मकालं प्रतीक्षस्व नहुषस्य दुरात्मनः ।\nअपहृत्य समानीय जहि त्वं पापचेतनम्॥ १०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000431103, "chapter_id": 20431, "verse_number": "२-१०३-१०४", "content_sanskrit": "एवं संमंत्र्य तेनापि कंपनेन स दानवः ।\nअभूत्स उद्यमोपेतो नहुषस्य प्रणाशने॥ १०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000431104, "chapter_id": 20431, "verse_number": "२-१०३-१०५", "content_sanskrit": "विष्णुरुवाच ।\nएलपुत्रो महाभाग आयुर्नाम क्षितीश्वरः ।\nसार्वभौमः स धर्मात्मा सत्यव्रतपरायणः॥ १०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000431105, "chapter_id": 20431, "verse_number": "२-१०३-१०६", "content_sanskrit": "इंद्रोपेंद्रसमो राजा तपसा यशसा बलैः ।\nदानयज्ञैः सुपुण्यैश्च सत्येन नियमेन च॥ १०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000431106, "chapter_id": 20431, "verse_number": "२-१०३-१०७", "content_sanskrit": "एकच्छत्रेण वै राज्यं चक्रे भूपतिसत्तमः ।\nपृथिव्यां सर्वधर्मज्ञः सोमवंशस्य भूषणम्॥ १०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7000431107, "chapter_id": 20431, "verse_number": "२-१०३-१०८", "content_sanskrit": "पुत्रं न विंदते राजा तेन दुःखी व्यजायत ।\nचिंतयामास धर्मात्मा कथं मे जायते सुतः॥ १०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7000431108, "chapter_id": 20431, "verse_number": "२-१०३-१०९", "content_sanskrit": "इति चिंतां समापेदे आयुश्च पृथिवीपतिः ।\nपुत्रार्थं परमं यत्नमकरोत्सुसमाहितः॥ १०९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7000431109, "chapter_id": 20431, "verse_number": "२-१०३-११०", "content_sanskrit": "अत्रिपुत्रो महात्मा वै दत्तात्रेयो महामुनिः ।\nक्रीडमानः स्त्रिया सार्द्धं मदिरारुणलोचनः॥ ११० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7000431110, "chapter_id": 20431, "verse_number": "२-१०३-१११", "content_sanskrit": "वारुण्या मत्त धर्मात्मा स्त्रीवृंदैश्च समावृतः ।\nअंके युवतिमाधाय सर्वयोषिद्वरां शुभाम्॥ १११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7000431111, "chapter_id": 20431, "verse_number": "२-१०३-११२", "content_sanskrit": "गायते नृत्यते विप्रः सुरां च पिबते भृशम् ।\nविना यज्ञोपवीतेन महायोगीश्वरोत्तमः॥ ११२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7000431112, "chapter_id": 20431, "verse_number": "२-१०३-११३", "content_sanskrit": "पुष्पमालाभिर्दिव्याभिर्मुक्ताहारपरिच्छदैः ।\nचंदनागुरुदिग्धांगो राजमानो मुनीश्वरः॥ ११३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7000431113, "chapter_id": 20431, "verse_number": "२-१०३-११४", "content_sanskrit": "तस्याश्रमं नृपो गत्वा तं दृष्ट्वा द्विजसत्तमम् ।\nप्रणाममकरोन्मूर्ध्ना दण्डवत्सुसमाहितः॥ ११४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7000431114, "chapter_id": 20431, "verse_number": "२-१०३-११५", "content_sanskrit": "अत्रिपुत्रः स धर्मात्मा समालोक्य नृपोत्तमम् ।\nआगतं पुरतो भक्त्या अथ ध्यानं समास्थितः॥ ११५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7000431115, "chapter_id": 20431, "verse_number": "२-१०३-११६", "content_sanskrit": "एवं वर्षशतं प्राप्तं तस्य भूपस्य सत्तम ।\nनिश्चलं शांतिमापन्नं मानसं भक्तितत्परम्॥ ११६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7000431116, "chapter_id": 20431, "verse_number": "२-१०३-११७", "content_sanskrit": "समाहूय उवाचेदं किमर्थं क्लिश्यसे नृप ।\nब्रह्माचारेण हीनोस्मि ब्रह्मत्वं नास्ति मे कदा॥ ११७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7000431117, "chapter_id": 20431, "verse_number": "२-१०३-११८", "content_sanskrit": "सुरामांसप्रलुब्धोऽस्मि स्त्रियासक्तः सदैव हि ।\nवरदाने न मे शक्तिरन्यं शुश्रूष ब्राह्मणम्॥ ११८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7000431118, "chapter_id": 20431, "verse_number": "२-१०३-११९", "content_sanskrit": "आयुरुवाच ।\nभवादृशो महाभाग नास्ति ब्राह्मणसत्तमः ।\nसर्वकामप्रदाता वै त्रैलोक्ये परमेश्वरः॥ ११९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7000431119, "chapter_id": 20431, "verse_number": "२-१०३-१२०", "content_sanskrit": "अत्रिवंशे महाभाग गोविंदः परमेश्वरः ।\nब्राह्मणस्य स्वरूपेण भवान्वै गरुडध्वजः॥ १२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7000431120, "chapter_id": 20431, "verse_number": "२-१०३-१२१", "content_sanskrit": "नमोऽस्तु देवदेवेश नमोऽस्तु परमेश्वर ।\nत्वामहं शरणं प्राप्तः शरणागतवत्सल॥ १२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7000431121, "chapter_id": 20431, "verse_number": "२-१०३-१२२", "content_sanskrit": "उद्धरस्व हृषीकेश मायां कृत्वा प्रतिष्ठसि ।\nविश्वस्थानां प्रजानां तु विद्वांसं विश्वनायकम्॥ १२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7000431122, "chapter_id": 20431, "verse_number": "२-१०३-१२३", "content_sanskrit": "जानाम्यहं जगन्नाथं भवंतं मधुसूदनम् ।\nमामेव रक्ष गोविंद विश्वरूप नमोस्तु ते॥ १२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7000431123, "chapter_id": 20431, "verse_number": "२-१०३-१२४", "content_sanskrit": "कुंजल उवाच ।\nगते बहुतिथे काले दत्तात्रेयो नृपोत्तमम् ।\nउवाच मत्तरूपेण कुरुष्व वचनं मम॥ १२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7000431124, "chapter_id": 20431, "verse_number": "२-१०३-१२५", "content_sanskrit": "कपाले मे सुरां देहि पाचितं मांसभोजनम् ।\nएवमाकर्ण्य तद्वाक्यं स चायुः पृथिवीपतिः॥ १२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7000431125, "chapter_id": 20431, "verse_number": "२-१०३-१२६", "content_sanskrit": "उत्सुकस्तु कपालेन सुरामाहृत्य वेगवान् ।\nपलं सुपाचितं चैव च्छित्त्वा हस्तेन सत्वरम्॥ १२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7000431126, "chapter_id": 20431, "verse_number": "२-१०३-१२७", "content_sanskrit": "नृपेंद्रः प्रददौ चापि दत्तात्रेयाय सत्तम ।\nअथ प्रसन्नचेताः स संजातो मुनिपुंगवः॥ १२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7000431127, "chapter_id": 20431, "verse_number": "२-१०३-१२८", "content_sanskrit": "दृष्ट्वा भक्तिं प्रभावं च गुरुशुश्रूषणं परम् ।\nसमुवाच नृपेंद्रं तमायुं प्रणतमानसम्॥ १२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7000431128, "chapter_id": 20431, "verse_number": "२-१०३-१२९", "content_sanskrit": "वरं वरय भद्रं ते दुर्लभं भुवि भूपते ।\nसर्वमेव प्रदास्यामि यंयमिच्छसि सांप्रतम्॥ १२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7000431129, "chapter_id": 20431, "verse_number": "२-१०३-१३०", "content_sanskrit": "राजोवाच ।\nभवान्दाता वरं सत्यं कृपया मुनिसत्तम ।\nपुत्रं देहि गुणोपेतं सर्वज्ञं गुणसंयुतम्॥ १३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7000431130, "chapter_id": 20431, "verse_number": "२-१०३-१३१", "content_sanskrit": "देववीर्यं सुतेजं च अजेयं देवदानवैः ।\nक्षत्रियै राक्षसैर्घोरैर्दानवैः किन्नरैस्तथा॥ १३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7000431131, "chapter_id": 20431, "verse_number": "२-१०३-१३२", "content_sanskrit": "देवब्राह्मणसंभक्तः प्रजापालो विशेषतः ।\nयज्वा दानपतिः शूरः शरणागतवत्सलः॥ १३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7000431132, "chapter_id": 20431, "verse_number": "२-१०३-१३३", "content_sanskrit": "दाता भोक्ता महात्मा च वेदशास्त्रेषु पंडितः ।\nधनुर्वेदेषु निपुणः शास्त्रेषु च परायणः॥ १३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7000431133, "chapter_id": 20431, "verse_number": "२-१०३-१३४", "content_sanskrit": "अनाहतमतिर्धीरः संग्रामेष्वपराजितः ।\nएवं गुणः सुरूपश्च यस्माद्वंशः प्रसूयते॥ १३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7000431134, "chapter_id": 20431, "verse_number": "२-१०३-१३५", "content_sanskrit": "देहि पुत्रं महाभाग ममवंशप्रधारकम् ।\nयदि चापि वरो देयस्त्वया मे कृपया विभो॥ १३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7000431135, "chapter_id": 20431, "verse_number": "२-१०३-१३६", "content_sanskrit": "दत्तात्रेय उवाच ।\nएवमस्तु महाभाग तव पुत्रो भविष्यति ।\nगृहे वंशकरः पुण्यः सर्वजीवदयाकरः॥ १३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7000431136, "chapter_id": 20431, "verse_number": "२-१०३-१३७", "content_sanskrit": "एभिर्गुणैस्तु संयुक्तो वैष्णवांशेन संयुतः ।\nराजा च सार्वभौमश्च इंद्रतुल्यो नरेश्वरः॥ १३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7000431137, "chapter_id": 20431, "verse_number": "२-१०३-१३८", "content_sanskrit": "एवं खलु वरं दत्वा ददौ फलमनुत्तमम् ।\nभूपमाह महायोगी सुभार्यायै प्रदीयताम्॥ १३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7000431138, "chapter_id": 20431, "verse_number": "२-१०३-१३९", "content_sanskrit": "एवमुक्त्वा विसृज्यैव तमायुं प्रणतं पुरः ।\nआशीर्भिरभिनंद्यैव अंतर्द्धानमधीयत॥ १३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}]