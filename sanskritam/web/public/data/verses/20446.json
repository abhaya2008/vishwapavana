[{"id": 7000446000, "chapter_id": 20446, "verse_number": "२-११८-१", "content_sanskrit": "कपिंजल उवाच ।\nगंगामुखे पुरा तात रोदमाना वरांगना ।\nनेत्राभ्यामश्रुबिंदूनि पतंति च महाजले॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000446001, "chapter_id": 20446, "verse_number": "२-११८-२", "content_sanskrit": "गंगामध्ये निमज्जंति भवंति कमलानि च ।\nपुष्पाणि दिव्यरूपाणि सौगंधानि महांति च॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000446002, "chapter_id": 20446, "verse_number": "२-११८-३", "content_sanskrit": "तस्यास्तात सुनेत्राभ्यां किमर्थं प्रपतंति च ।\nगंगोदके महाभाग निर्मला अश्रुबिंदवः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000446003, "chapter_id": 20446, "verse_number": "२-११८-४", "content_sanskrit": "अस्थिचर्मावशेषस्तु जटाचीरधरः पुनः ।\nतानि सौगंधयुक्तानि पद्मानि विचिनोति सः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000446004, "chapter_id": 20446, "verse_number": "२-११८-५", "content_sanskrit": "हेमवर्णानि दिव्यानि नीत्वा शिवं समर्चयेत् ।\nसा का नारी समाचक्ष्व स वा को हि महामते॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000446005, "chapter_id": 20446, "verse_number": "२-११८-६", "content_sanskrit": "अर्चयित्वा शिवं सोथ कस्मात्पश्चात्प्रदेवति ।\nएतन्मे सर्वमाचक्ष्व यद्यहं वल्लभस्तव॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000446006, "chapter_id": 20446, "verse_number": "२-११८-७", "content_sanskrit": "कुंजल उवाच ।\nशृणु वत्स प्रवक्ष्यामि वृत्तांतं देवनिर्मितम् ।\nचरित्रं सर्वपापघ्नं विष्णोश्चैव महात्मनः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000446007, "chapter_id": 20446, "verse_number": "२-११८-८", "content_sanskrit": "योसौ हुंडो महावीर्यो नहुषेण हतो रणे ।\nतस्य पुत्रस्तु विख्यातो विहुंडस्तप आस्थितः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000446008, "chapter_id": 20446, "verse_number": "२-११८-९", "content_sanskrit": "निहतं पितरं श्रुत्वा सामात्यं सपरिच्छदम् ।\nआयुपुत्रेण वीरेण नहुषेण बलीयसा॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000446009, "chapter_id": 20446, "verse_number": "२-११८-१०", "content_sanskrit": "तपस्तपति सक्रोधाद्देवान्हंतुं समुद्यतः ।\nपौरुषं तस्य दुष्टस्य तपसा वर्द्धितस्य च॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000446010, "chapter_id": 20446, "verse_number": "२-११८-११", "content_sanskrit": "जानंति देवताः सर्वा दुःसहं समरांगणे ।\nहुंडात्मजो विहुंडस्तु त्रैलोक्यं हंतुमुद्यतः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000446011, "chapter_id": 20446, "verse_number": "२-११८-१२", "content_sanskrit": "पितुर्वैरं करिष्यामि हनिष्ये मानवान्सुरान् ।\nएवं समुद्यतः पापी देवब्राह्मणकंटकः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000446012, "chapter_id": 20446, "verse_number": "२-११८-१३", "content_sanskrit": "उपद्रवं समारेभे प्रजाः पीडयते च सः ।\nतस्यैव तेजसा दग्धा देवाश्चेंद्रपुरोगमाः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000446013, "chapter_id": 20446, "verse_number": "२-११८-१४", "content_sanskrit": "शरणं देवदेवस्य जग्मुर्विष्णोर्महात्मनः ।\nदेवदेवं जगन्नाथं शंखचक्रगदाधरम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000446014, "chapter_id": 20446, "verse_number": "२-११८-१५", "content_sanskrit": "ऊचुश्च पाहि नो नित्यं विहुंडस्य महाभयात् ।\nश्रीविष्णुरुवाच ।\nवर्द्धंतु देवताः सर्वाः सुसुखेन महेश्वराः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000446015, "chapter_id": 20446, "verse_number": "२-११८-१६", "content_sanskrit": "विहुंडं नाशयिष्यामि पापिष्ठं देवकंटकम् ।\nएवमाभाष्य तान्देवान्मायां कृत्वा जनार्दनः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000446016, "chapter_id": 20446, "verse_number": "२-११८-१७", "content_sanskrit": "स्वयमेवस्थितस्तत्र नंदने सुमहायशाः ।\nमायामयं चकाराथ स्त्रीरूपं च गुणान्वितम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000446017, "chapter_id": 20446, "verse_number": "२-११८-१८", "content_sanskrit": "विष्णुमाया महाभागा सर्वविश्वप्रमोहिनी ।\nचकार रूपमतुलं विष्णोर्मायाप्रमोहिनी॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000446018, "chapter_id": 20446, "verse_number": "२-११८-१९", "content_sanskrit": "विहुंडस्य वधार्थाय रूपलावण्यशालिनी ।\nकुंजल उवाच ।\nस देवानां वधार्थाय दिव्यमार्गं जगाम ह॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000446019, "chapter_id": 20446, "verse_number": "२-११८-२०", "content_sanskrit": "नंदनांते ततो मायामपश्यद्दितिजेश्वरः ।\nतया विमोहितो दैत्यः कामबाणकृतांतरः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000446020, "chapter_id": 20446, "verse_number": "२-११८-२१", "content_sanskrit": "आत्मनाशं न जानाति कालरूपां वरस्त्रियम् ।\nतां दृष्ट्वा नवहेमाभां रूपद्रविणशालिनीम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000446021, "chapter_id": 20446, "verse_number": "२-११८-२२", "content_sanskrit": "लुब्धो विहुंडः पापात्मा तामुवाच वरांगनाम् ।\nकासि कस्य वरारोहे ममचित्तप्रमाथिनि॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000446022, "chapter_id": 20446, "verse_number": "२-११८-२३", "content_sanskrit": "संगमं देहि मे भद्रे रक्षरक्ष वरानने ।\nसंगमात्तव देवेशि यद्यदिच्छसि सांप्रतम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000446023, "chapter_id": 20446, "verse_number": "२-११८-२४", "content_sanskrit": "तत्तद्दद्मि महाभागे दुर्लभं देवदानवैः ।\nमायोवाच ।\nमामेव भोक्तुमिच्छा चेद्दायं मे देहि दानव॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000446024, "chapter_id": 20446, "verse_number": "२-११८-२५", "content_sanskrit": "सप्तकोटिमितैश्चैव पुष्पैः पूजय शंकरम् ।\nकामोदसंभवैर्दिव्यैः सौगंधैर्देवदुर्लभैः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000446025, "chapter_id": 20446, "verse_number": "२-११८-२६", "content_sanskrit": "तेषां पुष्पकृतां मालां मम कंठे तु दानव ।\nआरोपय महाभाग एतद्दायं प्रदेहि मे॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000446026, "chapter_id": 20446, "verse_number": "२-११८-२७", "content_sanskrit": "तदाहं सुप्रिया भार्या भविष्यामि न संशयः ।\nविहुंड उवाच ।\nएवं देवि करिष्यामि वरं दद्मि प्रयाचितम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000446027, "chapter_id": 20446, "verse_number": "२-११८-२८", "content_sanskrit": "वनानि यानि पुण्यानि दिव्यानि दितिजेश्वरः ।\nबभ्राममन्मथाविष्टो न च पश्यति तं द्रुमम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000446028, "chapter_id": 20446, "verse_number": "२-११८-२९", "content_sanskrit": "कामोदकाख्यं पप्रच्छ यत्रतत्र गतः स्वयम् ।\nकामोदाख्यद्रुमो नास्ति वदंत्येवं महाजनाः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000446029, "chapter_id": 20446, "verse_number": "२-११८-३०", "content_sanskrit": "पृच्छमानः स दुष्टात्मा कामबाणैः प्रपीडितः ।\nपप्रच्छ भार्गवं गत्वा भक्त्या नमित कंधरः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000446030, "chapter_id": 20446, "verse_number": "२-११८-३१", "content_sanskrit": "कामोदकं द्रुमं ब्रूहि कांतं पुष्पसमन्वितम् ।\nशुक्र उवाच ।\nकामोदः पादपो नास्ति योषिदेवास्ति दानव॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000446031, "chapter_id": 20446, "verse_number": "२-११८-३२", "content_sanskrit": "यदा सा हसते चैव प्रसंगेन प्रहर्षिता ।\nतद्धासाज्जज्ञिरे दैत्य सुगंधीनि वराण्यपि॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000446032, "chapter_id": 20446, "verse_number": "२-११८-३३", "content_sanskrit": "सुमान्येतानि दिव्यानि कामोदाया न संशयः ।\nहृद्यानि पीतपुष्पाणि सौरभेण युतानि च॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000446033, "chapter_id": 20446, "verse_number": "२-११८-३४", "content_sanskrit": "तेनाप्येकेन पुष्पेण यः समर्चति शंकरम् ।\nतस्येप्सितं महाकामं संपूरयति शंकरः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000446034, "chapter_id": 20446, "verse_number": "२-११८-३५", "content_sanskrit": "अस्याश्च रोदनाद्दैत्य प्रभवंति न संशयः ।\nतादृशान्येव पुष्पाणि लोहितानि महांति च॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000446035, "chapter_id": 20446, "verse_number": "२-११८-३६", "content_sanskrit": "सौरभेण विना दैत्य तेषां स्पर्शं न कारयेत् ।\nएवमाकर्णितं तेन वाक्यं शुक्रस्य भाषितम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000446036, "chapter_id": 20446, "verse_number": "२-११८-३७", "content_sanskrit": "उवाच सा तु कुत्रास्ति कामोदा भृगुनंदन ।\nशुक्र उवाच ।\nगंगाद्वारे महापुण्ये महापातकनाशने॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000446037, "chapter_id": 20446, "verse_number": "२-११८-३८", "content_sanskrit": "कामोदाख्यं पुरं तत्र निर्मितं विश्वकर्मणा ।\nकामोदपत्तने नारी दिव्यभोगैरलंकृता॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000446038, "chapter_id": 20446, "verse_number": "२-११८-३९", "content_sanskrit": "तथा चाभरणैर्भाति सर्वदेवैः सुपूजिता ।\nत्वया तत्रैव गंतव्यं पूजितव्या वराप्सराः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000446039, "chapter_id": 20446, "verse_number": "२-११८-४०", "content_sanskrit": "उपायेनापि पुण्येन तां प्रहासय दानव ।\nएवमुक्त्वा तु योगींद्र सः शुक्रो दानवं प्रति॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000446040, "chapter_id": 20446, "verse_number": "२-११८-४१", "content_sanskrit": "विरराम महातेजाः स्वकार्यायोद्यतोऽभवत्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]