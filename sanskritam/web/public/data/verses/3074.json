[{"id": 2096724, "chapter_id": 3074, "verse_number": "१३-२०४-१", "content_sanskrit": "श्रीभगवानुवाच।\nभवतां दर्शनादेव प्रीतिरभ्यधिका मम।\nभवन्तस्तु तपःसिद्धा भवन्तो दिव्यदर्शनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2096725, "chapter_id": 3074, "verse_number": "१३-२०४-२", "content_sanskrit": "सर्वत्र गतिमन्तश्च ज्ञानविज्ञानभाविताः।\nगत्यागतिज्ञा लोकानां सर्वे निर्दूतकल्मषाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2096726, "chapter_id": 3074, "verse_number": "१३-२०४-३", "content_sanskrit": "तस्माद्भवद्भिर्यत्किंचिदृष्टं वाऽप्यथवा श्रुतम्।\nआश्चर्यभूतं लोकेषु तद्भवन्तो ब्रुवन्तु मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2096727, "chapter_id": 3074, "verse_number": "१३-२०४-४", "content_sanskrit": "युष्माभिः कथितं यत्स्यात्तपसा भावितात्मभिः\nतस्यादमृतसंकाशं वाङ्मधुश्रवणे स्पृहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2096728, "chapter_id": 3074, "verse_number": "१३-२०४-५", "content_sanskrit": "रागद्वेषवियुक्तानां सततं सत्यवादिनाम्।\nश्रद्धेयं श्रवणीयं च वचनं हि सतां भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2096729, "chapter_id": 3074, "verse_number": "१३-२०४-६", "content_sanskrit": "तत्संयोगं हितं मेऽस्तु न वृथा कर्तुमर्हथ।\nभवतां दर्शनं तस्मात्सफलं तु भवेन्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2096730, "chapter_id": 3074, "verse_number": "१३-२०४-७", "content_sanskrit": "तदहं सज्जनमुखान्निःसृतं जनसंसदि।\nकथयिष्याम्यहं बुद्ध्या बुद्धिदीपकरं नृणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2096731, "chapter_id": 3074, "verse_number": "१३-२०४-८", "content_sanskrit": "तदन्ये वर्धयिष्यन्ति पूजयिष्यन्ति चापरे।\nवात्सल्यविगताश्चान्ये प्रशंसन्ति पुरातनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2096732, "chapter_id": 3074, "verse_number": "१३-२०४-९", "content_sanskrit": "एवं ब्रुवति गोविन्दे श्रवणार्थं महर्षयः।\nवाग्भिः साञ्जलिमालाभिरिदमूचुर्जनार्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2096733, "chapter_id": 3074, "verse_number": "१३-२०४-१०", "content_sanskrit": "अयुक्तमस्मानेवं त्वं वाचा वरद भाषितुम्।\nत्वच्छासनमुखाः सर्वे त्वदधीनपरिश्रमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2096734, "chapter_id": 3074, "verse_number": "१३-२०४-११", "content_sanskrit": "एवं पूजयितुं चास्मान्न चैवार्हसि केशव।\nत्वत्तस्त्वन्यं न पश्यामो यल्लोके ते न विद्यते।\nदिवि वा भुवि वा किञ्चित्तत्सर्वं हि त्वया ततम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2096735, "chapter_id": 3074, "verse_number": "१३-२०४-१२", "content_sanskrit": "न विद्महे वयं देव कथ्यमानं तवान्तिके।\nएवमुक्तो हृषीकेशः सस्मितं चेदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2096736, "chapter_id": 3074, "verse_number": "१३-२०४-१३", "content_sanskrit": "अहं मानुषयोनिस्थः साम्प्रतं मुनिपुङ्गवाः।\nतस्मान्मानुषवद्वीर्यं मम जानीत सुव्रताः।\nभवद्भिः कथ्यमानं च अपूर्वमिव तद्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2096737, "chapter_id": 3074, "verse_number": "१३-२०४-१४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2096738, "chapter_id": 3074, "verse_number": "१३-२०४-१४", "content_sanskrit": "एवं संचोदिताः सर्वे केशवेन महात्मना।\nऋषयश्चानुवर्तन्ते वासुदेवस्य शासनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2096739, "chapter_id": 3074, "verse_number": "१३-२०४-१५", "content_sanskrit": "ततस्त्वृषिगणाः सर्वे नारदं देवदर्शनम्।\nअमन्यन्त बुधा बुद्ध्या समर्थं तन्निबोधने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2096740, "chapter_id": 3074, "verse_number": "१३-२०४-१६", "content_sanskrit": "ऋषिरुग्रतपाश्चायं केशवस्य प्रियोऽधिकम्।\nपुराणज्ञश्च वाग्मी च कारणैस्तं च मेनिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2096741, "chapter_id": 3074, "verse_number": "१३-२०४-१७", "content_sanskrit": "सर्वे तदर्हणं कृत्वा नारदं वाक्यमब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2096742, "chapter_id": 3074, "verse_number": "१३-२०४-१८", "content_sanskrit": "भवता तीर्थयात्रार्थं चरता हिमवद्गिरौ।\nदृष्टं वै यत्तदाश्चर्यं श्रोतॄणां परमं प्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2096743, "chapter_id": 3074, "verse_number": "१३-२०४-१९", "content_sanskrit": "अतस्त्वमविशेषेण हितार्थं सर्वमादितः।\nप्रियार्थं केशवस्यास्य स भवान्वक्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2096744, "chapter_id": 3074, "verse_number": "१३-२०४-२०", "content_sanskrit": "तदा संयोजितः सर्वैर्ऋषिभिर्नारदस्तदा।\nप्रणम्य शिरसा विष्णुं सर्वलोकहिते रतम्।\nसमुद्वीक्ष्य हृषीकेशं वक्तुमेवोपचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2096745, "chapter_id": 3074, "verse_number": "१३-२०४-२१", "content_sanskrit": "ततो नारायणसुहृन्नारदो वदतांवरः।\nशङ्करस्योमया सार्धं संवादमनुभाषत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2096746, "chapter_id": 3074, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि चतुरधिकद्विशततमोऽध्यायः॥ २०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]