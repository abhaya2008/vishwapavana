[{"id": 7003535000, "chapter_id": 23535, "verse_number": "१७५-१", "content_sanskrit": "श्रीवराह उवाच ।\nशृणु चान्यद्वरारोहे कृष्णगङ्गासमुद्भवम् ।\nयमुनास्रोतसि स्नात्वा कृष्णद्वैपायनो मुनिः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003535001, "chapter_id": 23535, "verse_number": "१७५-२", "content_sanskrit": "ध्यात्वा मनसि गङ्गां तां कालिन्दीं पापहारिणीम् ।\nनित्यं च कर्म कुरुते तत्र तीर्थजलाप्लुतिम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003535002, "chapter_id": 23535, "verse_number": "१७५-३", "content_sanskrit": "सोमवैकुण्ठयोर्मध्ये कृष्णङ्गेति कथ्यते ।\nयत्रातप्यत स व्यासो मथुरायां स्थितोऽमलः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003535003, "chapter_id": 23535, "verse_number": "१७५-४", "content_sanskrit": "तत्राश्रमपदं दिव्यं मुनिप्रवरसेवितम् ।\nआगच्छन्ति सदा तत्र चातुर्मास्यमुपासितुम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003535004, "chapter_id": 23535, "verse_number": "१७५-५", "content_sanskrit": "मुनयो वेदतत्त्वज्ञा ज्ञानिनः संशितव्रताः ।\nश्रौतस्मार्त्तपुराणेषु सन्देहो यस्य कस्यचित् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003535005, "chapter_id": 23535, "verse_number": "१७५-६", "content_sanskrit": "व्यासोऽपनोदयामास नानावाक्यैः सताङ्गतिः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003535006, "chapter_id": 23535, "verse_number": "१७५-७", "content_sanskrit": "कालञ्जरे महादेवं तत्र तीर्थपतिं शिवम् ।\nयस्य सन्दर्शनादेव कृष्णगंगाफलं भवेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003535007, "chapter_id": 23535, "verse_number": "१७५-८", "content_sanskrit": "तत्र स्थितो द्वादशाब्दव्रती संगविवर्जितः।\nपक्षाहारी च फलभुग्दर्शे वै पौर्णमासिके ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003535008, "chapter_id": 23535, "verse_number": "१७५-९", "content_sanskrit": "गत्वा हिमालयं चासौ बदरीमभितो गतः।\nव्यासश्चर्यापरस्तत्र ध्यानयोगपरायणः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003535009, "chapter_id": 23535, "verse_number": "१७५-१०", "content_sanskrit": "त्रिकालदर्शी शुद्धात्मा सिद्धत्वं प्राप्नुयात्प्रभुः ।\nतस्याश्रमपदस्थस्य यद्दृष्टं ज्ञानचक्षुषा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003535010, "chapter_id": 23535, "verse_number": "१७५-११", "content_sanskrit": "प्रत्यक्षं कृष्णतीर्थे तु पांचाल्यकुलतन्तुना।\nपांचाल्योऽथ द्विजः कश्चिन्नाम्ना वसुरिति श्रुतः॥ ११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003535011, "chapter_id": 23535, "verse_number": "१७५-१२", "content_sanskrit": "दुर्भिक्षपीडितोऽत्यन्तं सभार्यो दक्षिणां गतः।\nशिवनद्या दक्षिणे तु कूले स वरपत्तने ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003535012, "chapter_id": 23535, "verse_number": "१७५-१३", "content_sanskrit": "निवासमकरोत्तत्र ब्राह्मणीं वृत्तिमाश्रितः ।\nतत्रस्थस्य तदा पंच पुत्राः कन्याभवंस्तदा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003535013, "chapter_id": 23535, "verse_number": "१७५-१४", "content_sanskrit": "ब्राह्मणाय च दत्ता सा धनधान्यसमन्विता ।\nस द्विजः कालसम्पन्नः सभार्यस्तत्र संस्थितः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003535014, "chapter_id": 23535, "verse_number": "१७५-१५", "content_sanskrit": "कन्याऽस्थीनि तु संगृह्य मथुरामाजगाम ह ।\nश्रुत्वा पुराणे पतितमर्द्धचन्द्रेऽस्थिपातनम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003535015, "chapter_id": 23535, "verse_number": "१७५-१६", "content_sanskrit": "नित्यं स्वर्गे वसति स यस्यास्थि ह्यर्द्धचन्द्रके।\nतीर्थयात्राप्रसंगेन लोकैः प्रचलिता बहिः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003535016, "chapter_id": 23535, "verse_number": "१७५-१७", "content_sanskrit": "तेन सार्थेन सा कन्या मथुरायां जगाम च ।\nकनिष्ठा भगिनी तेषां बालरण्डा बभूव ह ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003535017, "chapter_id": 23535, "verse_number": "१७५-१८", "content_sanskrit": "सुरूपा सुकुमाराङ्गी नीलकुंचितमूर्द्धजा ।\nकदलीकाण्डसंकाशे तस्या ऊरू सुमांसले ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003535018, "chapter_id": 23535, "verse_number": "१७५-१९", "content_sanskrit": "सुश्लिष्टाङ्गुलिपादा तु नखास्ताम्रोज्ज्वलाः शुभाः ।\nगम्भीरा दक्षिणावर्त्ता नाभिस्त्रिवलि  .शोभिता ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003535019, "chapter_id": 23535, "verse_number": "१७५-२०", "content_sanskrit": "क्षामोदरी समकुक्षिः पीनोन्नतपयोधरा ।\nकम्बुग्रीवा संवृतास्या सुदती स्वधराहनुः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003535020, "chapter_id": 23535, "verse_number": "१७५-२१", "content_sanskrit": "सुनखी स्वक्षिणी सुभ्रूः सुप्रमाणा सुभाषिणी ।\nतेन तेनैव सम्पूर्णरूपेण च तिलोत्तमा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003535021, "chapter_id": 23535, "verse_number": "१७५-२२", "content_sanskrit": "यं यं पश्यति चार्वङ्गी यस्तां चैव प्रपश्यति ।\nस स चित्र इव न्यस्तो विचेता जायते नरः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003535022, "chapter_id": 23535, "verse_number": "१७५-२३", "content_sanskrit": "एवंविधा तत्र तत्र तीर्थस्नानपरायणा ।\nदृष्टा वेश्यासमूहेन प्रागल्भ्येन तदा क्वचित् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003535023, "chapter_id": 23535, "verse_number": "१७५-२४", "content_sanskrit": "कान्यकुब्जाधिपो राजा क्षत्रधर्मे व्यवस्थितः ।\nतस्य सत्रं सर्वकालं देवगर्त्तेश्वरे शिवे ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003535024, "chapter_id": 23535, "verse_number": "१७५-२५", "content_sanskrit": "प्रवर्त्तते सुवित्ताढ्य प्रेक्षणीयं मनोरमम् ।\nवादित्राणि च गीतानि शक्रस्य भवने यथा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003535025, "chapter_id": 23535, "verse_number": "१७५-२६", "content_sanskrit": "तस्य देवस्य या वेश्यास्ताभिः सा प्रतिलोभिता ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003535026, "chapter_id": 23535, "verse_number": "१७५-२७", "content_sanskrit": "गीतनृत्यादिषु रता तासां धर्ममुपागता ।\nअल्पैस्तु दिवसैः साध्वी असाध्वीभिः परीवृता ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003535027, "chapter_id": 23535, "verse_number": "१७५-२८", "content_sanskrit": "एवं वसति सा बाला देवस्यास्य परिग्रहा ।\nयथासुखं समेताभिर्विहरन्ती दिनेदिने ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]