[{"id": 2075024, "chapter_id": 2586, "verse_number": "१२-९१-०x", "content_sanskrit": "उचथ्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2075025, "chapter_id": 2586, "verse_number": "१२-९१-१", "content_sanskrit": "कालवर्षी च पर्जन्यो धर्मचारी च पार्थिवः।\nसंपद्यदेषा भवति सा बिभर्ति सुखं प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2075026, "chapter_id": 2586, "verse_number": "१२-९१-२", "content_sanskrit": "यो न जानाति निर्हर्तुं वस्त्राणां रजको मलम्।\nरत्नानि वा शोधयितुं यथा नास्ति तथैव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2075027, "chapter_id": 2586, "verse_number": "१२-९१-३", "content_sanskrit": "एवमेतद्द्विजेन्द्राणां क्षत्रियाणां विशां तथा।\nशूद्रश्चतुर्थो वर्णानां नानाकर्मस्ववस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2075028, "chapter_id": 2586, "verse_number": "१२-९१-४", "content_sanskrit": "कर्म शूद्रे कृषिर्वैश्ये दण्डनीतिश्च राजनि।\nब्रह्मचर्यं तपो मन्त्राः सत्यं चापि द्विजातिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2075029, "chapter_id": 2586, "verse_number": "१२-९१-५", "content_sanskrit": "तेषां यः क्षत्रियो वेद पात्राणामिव शोधनम्।\nशीलदोषान्विनिर्हर्तुं स पिता स प्रजापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2075030, "chapter_id": 2586, "verse_number": "१२-९१-६", "content_sanskrit": "कृतं त्रेता द्वापरश्च कलिश्च भरतर्षभ।\nराजवृत्तानि सर्वाणि राजैव युगमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2075031, "chapter_id": 2586, "verse_number": "१२-९१-७", "content_sanskrit": "चातुर्वर्ण्यं तथा वेदाश्चातुराश्रम्यमेव च।\nसर्वमेतत्प्रमुह्येत यदा राजा प्रमाद्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2075032, "chapter_id": 2586, "verse_number": "१२-९१-८", "content_sanskrit": "अग्नित्रेता त्रयी विद्या यज्ञाश्च सहदक्षिणाः।\nसर्व एव प्रमुह्यन्ते यदा राजा प्रमाद्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2075033, "chapter_id": 2586, "verse_number": "१२-९१-९", "content_sanskrit": "राजैव कर्ता भूतानां राजैव च विनाशकः।\nधर्मात्मा यः स कर्ता स्यादधर्मात्मा विनाशकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2075034, "chapter_id": 2586, "verse_number": "१२-९१-१०", "content_sanskrit": "राज्ञो भार्याश्च पुत्राश्च बान्धवाः सुहृदस्तथा।\nसमेत्य सर्वे शोचन्ति यदा राजा प्रमाद्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2075035, "chapter_id": 2586, "verse_number": "१२-९१-११", "content_sanskrit": "हस्तिनोऽश्वाश्च गावश्चाप्युष्ट्राश्वतरगर्दभाः।\nअधर्मवृत्ते नृपतौ सर्वे सीदन्ति जन्तवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2075036, "chapter_id": 2586, "verse_number": "१२-९१-१२", "content_sanskrit": "[दुर्बलार्थं बलं सृष्टं धात्रा मान्धातरुच्यते।\nअबलं तु महद्भूतं यस्मिन्सर्वं प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2075037, "chapter_id": 2586, "verse_number": "१२-९१-१३", "content_sanskrit": "यश्च भूतं संभजते ये च भूतास्तदन्वयाः।\nअधर्मस्थे हि नृपतौ सर्वे शोचन्ति पार्थिव॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2075038, "chapter_id": 2586, "verse_number": "१२-९१-१४", "content_sanskrit": "दुर्बलस्य च यच्चक्षुर्मुनेराशीविषस्य च।\nअविषह्यतमं मन्ये मा स्म दुर्बलमासदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2075039, "chapter_id": 2586, "verse_number": "१२-९१-१५", "content_sanskrit": "दुर्बलांस्तात मन्येथा नित्यमेवाविमानि तान्।\nमा त्वां दुर्बलचक्षूंषि प्रदहेयुः सबान्धवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2075040, "chapter_id": 2586, "verse_number": "१२-९१-१६", "content_sanskrit": "न हि दुर्बलदग्धस्य कुले किंचित्प्ररोहति।\nआमूलं निर्दहन्त्येव मा स्म दुर्बलमासद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2075041, "chapter_id": 2586, "verse_number": "१२-९१-१७", "content_sanskrit": "अबलं वै बलाच्छ्रेयो यच्चातिबलवद्बलम्।\nबलस्याबलदग्धस्य न किंचितवशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2075042, "chapter_id": 2586, "verse_number": "१२-९१-१८", "content_sanskrit": "विमानितो हतः क्लिष्टस्त्रातारं चेन्न विन्दन्ते।\nअमानुषकृतस्तत्र दण्डो हन्ति नराधिपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2075043, "chapter_id": 2586, "verse_number": "१२-९१-१९", "content_sanskrit": "मा स्म तात बलस्थस्त्वं भुञ्जीथा दुर्बलं जनम्।\nमा त्वां दुर्बलचक्षूंषि दहन्त्वग्निरिवाशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2075044, "chapter_id": 2586, "verse_number": "१२-९१-२०", "content_sanskrit": "यानि मिथ्याभिशस्तानां पतन्त्यश्रूणि रोदताम्।\nतानि पुत्रान्पशून्घ्नन्ति तेषां मिथ्याभिशंसिनां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2075045, "chapter_id": 2586, "verse_number": "१२-९१-२१", "content_sanskrit": "यदि नात्मनि पुत्रेषु न चेत्पौत्रेषु नप्नृषु।\nन हि पापं कृतं कर्म सद्यः फलति गौरिब॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2075046, "chapter_id": 2586, "verse_number": "१२-९१-२२", "content_sanskrit": "यत्राबलो वध्यमानस्त्रातारं नाधिगच्छति।\nमहान्दैवकृतस्तत्र दण्डः पतति दारुणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2075047, "chapter_id": 2586, "verse_number": "१२-९१-२३", "content_sanskrit": "युक्ता यदा जानपदा भिक्षन्ते ब्राह्मणा इव।\nअभीक्ष्णं भिक्षुरूपेण राजानं घ्नन्ति तादृशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2075048, "chapter_id": 2586, "verse_number": "१२-९१-२४", "content_sanskrit": "राज्ञो यदा जनपदे बहवो राजपूरुषाः।\nअनयेनोपवर्तन्ते तद्राज्ञः किल्बिषं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2075049, "chapter_id": 2586, "verse_number": "१२-९१-२५", "content_sanskrit": "यदा युक्त्या नयेदर्थान्कामादर्थवशेन वा।\nकृपणं याचमानानां तद्राज्ञो वैशसं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2075050, "chapter_id": 2586, "verse_number": "१२-९१-२६", "content_sanskrit": "महान्वृक्षो जायते वर्धते च\nतं चैव भूतानि समाश्रयन्ति।\nयदा वृक्षश्छिद्यते दह्यते च\nतदाश्रया अनिकेता भवन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2075051, "chapter_id": 2586, "verse_number": "१२-९१-२७", "content_sanskrit": "यदा राष्ट्रे धर्ममग्र्यं चरन्ति\nसंस्कारं का राजगुणं ब्रुवाणाः।\nतैश्चाधर्मश्चरितो धर्ममोहा\nत्तूप जह्यात्सुकृतं दुष्कृतं च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2075052, "chapter_id": 2586, "verse_number": "१२-९१-२८", "content_sanskrit": "यत्र पापा ज्ञायमानाश्चरन्ति\nसभां कलिर्विन्दते तत्र राज्ञः।\nयत्र राजा शास्ति नरान्न शक्त्या\nन तद्राज्यं वर्धते भूमिपस्य॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2075053, "chapter_id": 2586, "verse_number": "१२-९१-२९", "content_sanskrit": "यश्चामात्यान्मानयित्वा यथा हि\nमन्त्रे च युद्धे च नृपोऽनुयुञ्ज्यात्।\nबिबर्धते तस्य राष्ट्रं नृपस्य\nभुङ्क्ते महीं चाप्यखिलां चिराय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2075054, "chapter_id": 2586, "verse_number": "१२-९१-३०", "content_sanskrit": "अत्रापि सुकृतं कर्म वाचं चैव सुभाषिताम्।\nसमीक्ष्य पूजयन्राजा धर्मं प्राप्नोत्यनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2075055, "chapter_id": 2586, "verse_number": "१२-९१-३१", "content_sanskrit": "संविभज्य यदा भुङ्क्ते नचान्यानवमन्यते।\nनिहन्ति बलिनं दृप्तं स राज्ञो धर्म उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2075056, "chapter_id": 2586, "verse_number": "१२-९१-३२", "content_sanskrit": "त्रायते हि यदा सर्वं वाचा कायेन कर्मणा।\nपुत्रस्यापि न मृष्येच्च स राज्ञो धर्म उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2075057, "chapter_id": 2586, "verse_number": "१२-९१-३३", "content_sanskrit": "संविभज्य यदा भुङ्क्ते नृपतिर्दुर्बलान्नरान्।\nतदा भवन्ति बलिनः स राज्ञो धर्म उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2075058, "chapter_id": 2586, "verse_number": "१२-९१-३४", "content_sanskrit": "यदा रक्षति राष्ट्राणि यदा दस्यूनपोहति।\nयदा जयति संग्रामे स राज्ञो धर्म उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2075059, "chapter_id": 2586, "verse_number": "१२-९१-३५", "content_sanskrit": "पापमाचरतो यत्र कर्मणा व्याहृतेन वा।\nप्रियस्यापि न मृष्येत स राज्ञो धर्म उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2075060, "chapter_id": 2586, "verse_number": "१२-९१-३६", "content_sanskrit": "यदा सारणिकान्राजा पुत्रवत्परिरक्षति।\nभिनत्ति न च मर्यादां स राज्ञो धर्म उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2075061, "chapter_id": 2586, "verse_number": "१२-९१-३७", "content_sanskrit": "यदाप्तदक्षिणैर्यज्ञैर्यजते श्रद्धयाऽन्वितः।\nकामद्वेषावनादृत्य स राज्ञो धर्म उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2075062, "chapter_id": 2586, "verse_number": "१२-९१-३८", "content_sanskrit": "कृपणानाथवृद्धानां यदाऽश्रु परिमार्जति।\nहर्षं संजनयन्नॄणां स राज्ञो धर्म उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2075063, "chapter_id": 2586, "verse_number": "१२-९१-३९", "content_sanskrit": "विवर्धयति मित्राणि तथाऽरींश्चापि कर्षति।\nसंपूजयति साधूंश्च स राज्ञो धर्म उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2075064, "chapter_id": 2586, "verse_number": "१२-९१-४०", "content_sanskrit": "सत्यं पालयति प्रीत्या नित्यं भूमिं प्रयच्छति।\nपूजयेदतिथीन्भृत्यान्स राज्ञो धर्म उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2075065, "chapter_id": 2586, "verse_number": "१२-९१-४१", "content_sanskrit": "निग्रहानुग्रहौ चोभौ यत्र स्यातां प्रतिष्ठितौ।\nअस्मिँल्लोके परे चैव राजा स प्राप्नुते फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2075066, "chapter_id": 2586, "verse_number": "१२-९१-४२", "content_sanskrit": "यमो राजा धार्मिकाणां मान्धातः परमेश्वरः।\nसंयच्छन्यमवत्प्राणानसंयच्छंस्तु पावकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2075067, "chapter_id": 2586, "verse_number": "१२-९१-४३", "content_sanskrit": "ऋत्विक्पुरोहिताचार्यान्सत्कृत्यानवमत्य च।\nयदा सम्यक्प्रगृह्णाति स राज्ञो धर्म उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2075068, "chapter_id": 2586, "verse_number": "१२-९१-४४", "content_sanskrit": "यमो यच्छति भूतानि सर्वाण्येवाविशेषतः।\nतथा राज्ञाऽनुकर्तव्यं यन्तव्या विधिवत्प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2075069, "chapter_id": 2586, "verse_number": "१२-९१-४५", "content_sanskrit": "सहस्राक्षेण राजा हि सर्वथैवोपमीयते।\nस पश्यति च यं धर्म स धर्मः पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2075070, "chapter_id": 2586, "verse_number": "१२-९१-४६", "content_sanskrit": "अप्रमादेन शिक्षेथाः क्षमां बुद्धिं धृतिं मतिम्।\nभूतानां तत्त्वजिज्ञासा साध्वसाधु च सर्वदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2075071, "chapter_id": 2586, "verse_number": "१२-९१-४७", "content_sanskrit": "संग्रहः सर्वभूतानां दानं च मधुरा च वाक्।\nपौरजानपदाश्चैव गोप्तव्याः स्वप्रजा यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2075072, "chapter_id": 2586, "verse_number": "१२-९१-४८", "content_sanskrit": "न जात्वदक्षो नृपतिः प्रजाः शक्नोति रक्षितुम्।\nभारो हि सुमहांस्तात राज्यं नाम सुदुर्वहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2075073, "chapter_id": 2586, "verse_number": "१२-९१-४९", "content_sanskrit": "तद्दण्डविन्नृपः प्राज्ञः शूरः शक्नोति रक्षितुम्।\nन हि शक्यमदण्डेन क्लीबेनाबुद्धिनाऽपि वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2075074, "chapter_id": 2586, "verse_number": "१२-९१-५०", "content_sanskrit": "अभिरूपैः कुले जातैर्दक्षैर्भक्तैर्बहुश्रुतैः।\nसर्वं बुद्ध्या परीक्षेथास्तापसाश्रमिणामपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2075075, "chapter_id": 2586, "verse_number": "१२-९१-५१", "content_sanskrit": "अतस्त्वं सर्वभूतानां धर्मं वेत्स्यसि वै परम्।\nस्वदेशे परदेशे वा न ते धर्मो विनङ्क्ष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2075076, "chapter_id": 2586, "verse_number": "१२-९१-५२", "content_sanskrit": "धर्मेचार्थे च कामे च धर्म एवोत्तरो भवेत्।\nअस्मिंल्लोके परे चैव धर्मात्मा सुखमेधते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2075077, "chapter_id": 2586, "verse_number": "१२-९१-५३", "content_sanskrit": "त्यजन्ति दारान्पुत्रांश्च मनुष्याः परिपूजिताः।\nसंग्रहश्चैव भूतानां दानं च मधुरा च वाक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2075078, "chapter_id": 2586, "verse_number": "१२-९१-५४", "content_sanskrit": "अप्रमादश्च शौचं च राज्ञो भूतिकरं महत्।\nएतेभ्यश्चैव मान्धातः सततं मा प्रमादिथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2075079, "chapter_id": 2586, "verse_number": "१२-९१-५५", "content_sanskrit": "अप्रमत्तो भवेद्राजा छिद्रदर्शी परात्मनोः।\nनास्य च्छिद्रं परः पश्येच्छिद्रेषु परमन्वियात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2075080, "chapter_id": 2586, "verse_number": "१२-९१-५६", "content_sanskrit": "एतद्वॄत्तं वासवस्य यमस्य वरुणस्य च।\nराजर्षीणां च सर्वेषां तत्त्वमप्यनुपालय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2075081, "chapter_id": 2586, "verse_number": "१२-९१-५७", "content_sanskrit": "तत्कुरुष्व महाराज वृत्तं राजर्षिसेवितम्।\nआतिष्ठ दिव्यं पन्थानमह्नाय पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2075082, "chapter_id": 2586, "verse_number": "१२-९१-५८", "content_sanskrit": "धर्मवृत्तं हि राजानं प्रेत्य चेह च भारत।\nदेवर्षिपितृगन्धर्वाः कीर्तयन्ति महौजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2075083, "chapter_id": 2586, "verse_number": "१२-९१-५९x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2075084, "chapter_id": 2586, "verse_number": "१२-९१-५९", "content_sanskrit": "स एवमुक्तो मान्धाता तेनोचथ्येन भारत।\nकृतवानविशङ्कश्च एकः प्राप च मेदिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2075085, "chapter_id": 2586, "verse_number": "१२-९१-६०", "content_sanskrit": "भवानपि तथा सम्यङ्भान्धातेव महीपते।\nधर्मं कृत्वा महीं रक्ष स्वर्गे स्थानमवाप्स्यसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2075086, "chapter_id": 2586, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि एकनवतितमोऽध्यायः॥ ९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]