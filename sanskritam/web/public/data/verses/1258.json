[{"id": 2012559, "chapter_id": 1258, "verse_number": "१-२५९-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2012560, "chapter_id": 1258, "verse_number": "१-२५९-१", "content_sanskrit": "मन्दपालोऽञपि कौरव्यं चिन्तयामास पुत्रकान्।\nउक्त्वाऽपि च स तिग्मांशुं नैव शर्माधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2012561, "chapter_id": 1258, "verse_number": "१-२५९-२", "content_sanskrit": "स तप्यमानः पुत्रार्थे लपितामिदमब्रवीत्।\nकथं नु शक्ताः शरणे लपिते मम पुत्रकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2012562, "chapter_id": 1258, "verse_number": "१-२५९-३", "content_sanskrit": "वर्धमाने हुतवहे वाते चाशु प्रवायति।\nअसमर्था विमोक्षाय भविष्यन्ति ममात्मजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2012563, "chapter_id": 1258, "verse_number": "१-२५९-४", "content_sanskrit": "कथं त्वशक्ता त्राणाय माता तेषां तपस्विनी।\nभविष्यति हि शोकार्ता पुत्रत्राणमपश्यती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2012564, "chapter_id": 1258, "verse_number": "१-२५९-५", "content_sanskrit": "कथमुड्डीयनेऽशक्तान्पतने च ममात्मजान्।\nसन्तप्यमाना बहुधा वाशमाना प्रधावती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2012565, "chapter_id": 1258, "verse_number": "१-२५९-६", "content_sanskrit": "जरितारिः कथं पुत्रः सारिसृक्कः कथं च मे।\nस्तम्बमित्रः कथं द्रोणः कथं सा च तपस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2012566, "chapter_id": 1258, "verse_number": "१-२५९-७", "content_sanskrit": "लालप्यमानं तमृषइं मन्दपालं तथा वने।\nलपिता प्रत्युवाचेदं सासूयमिव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2012567, "chapter_id": 1258, "verse_number": "१-२५९-८", "content_sanskrit": "न ते पुत्रेष्ववेक्षाऽस्ति यानृषीनुक्तवानसि।\nतेजस्विनो वीर्यवन्तो न तेषां ज्वलनाद्भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2012568, "chapter_id": 1258, "verse_number": "१-२५९-९", "content_sanskrit": "त्वयाऽग्नौ ते परीताश्च स्वयं हि मम सन्निधौ।\nश्रुतं तथा चेति ज्वलनेन महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2012569, "chapter_id": 1258, "verse_number": "१-२५९-१०", "content_sanskrit": "पलो न तां वाचमुक्त्वा मिथ्या करिष्यति।\nन्धुकृत्ये न तेन ते स्वस्थ मानसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2012570, "chapter_id": 1258, "verse_number": "१-२५९-११", "content_sanskrit": "तामेव तु ममामित्रां चिन्तयन्परितप्यसे।\nध्रुवं मयि न ते स्नेहो यथा तपयं पुराऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2012571, "chapter_id": 1258, "verse_number": "१-२५९-१२", "content_sanskrit": "नहि पक्षवता न्याय्यं निः हेन सुहृज्जने।\nपीड्यमान उपद्रष्टुं शक्तेना मा कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2012572, "chapter_id": 1258, "verse_number": "१-२५९-१३", "content_sanskrit": "गच्छ त्वं जरितामेव यदर्थं परितप्यसे।\nचरिष्याम्यहमप्येका यथा पुरुषाश्रिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2012573, "chapter_id": 1258, "verse_number": "१-२५९-१४x", "content_sanskrit": "मन्दपाल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2012574, "chapter_id": 1258, "verse_number": "१-२५९-१४", "content_sanskrit": "नाहमेवं चरे लोके यथा त्वमभिमन्यसे।\nअपत्यहेतोर्विचरे तच्च कृच्छ्रगतं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2012575, "chapter_id": 1258, "verse_number": "१-२५९-१५", "content_sanskrit": "भूतं हित्वा च भाव्यर्थे योऽवलम्बेत्स मन्दधीः।\nअवमन्येत तं लोको यथेच्छसि तथा कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2012576, "chapter_id": 1258, "verse_number": "१-२५९-१६", "content_sanskrit": "एष हि प्रज्वलन्नग्निर्लेलिहानी महीरुहान्।\nआविग्ने हृदि सन्तापं जनयत्यशिवं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2012577, "chapter_id": 1258, "verse_number": "१-२५९-१७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2012578, "chapter_id": 1258, "verse_number": "१-२५९-१७", "content_sanskrit": "भर्तुर्हि वाक्यं सा श्रुत्वा लपिता दुःखिताऽभवत्।\nसान्त्वयामास च पुनः पति पतिपरायणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2012579, "chapter_id": 1258, "verse_number": "१-२५९-१८", "content_sanskrit": "तस्माद्देशादतिक्रान्ते ज्वलने जरिता पुनः।\nजगाम पुत्रकानेन जरिता पुत्रगृद्धिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2012580, "chapter_id": 1258, "verse_number": "१-२५९-१९", "content_sanskrit": "सा तान्कुशलिनः सर्वान्विमुक्ताञ्जातवेदसः।\nरोरूयमाणान्ददृशे वने पुत्रान्निरामयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2012581, "chapter_id": 1258, "verse_number": "१-२५९-२०", "content_sanskrit": "अश्रूणि मुमुचे तेषां दर्शनात्सा पुनःपुनः।\nन श्रद्धेयं ततस्तेषांर्शनं वै पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2012582, "chapter_id": 1258, "verse_number": "१-२५९-२१", "content_sanskrit": "इति मत्वाऽब्रवीद्वाकजरिता पुत्रगृद्धिनी।\nएकाकशश्च पुत्रांस्तन्त्र्शमानान्वपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2012583, "chapter_id": 1258, "verse_number": "१-२५९-२२", "content_sanskrit": "जरिता तु परिष्वज्युत्रस्नेहाच्चुचुम्ब ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2012584, "chapter_id": 1258, "verse_number": "१-२५९-२३", "content_sanskrit": "ततोऽभ्यगच्छत्सहसमन्दपालोऽपि भारत।\nअथ ते सर्व एवैनं भ्यनन्दंस्तदा सुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2012585, "chapter_id": 1258, "verse_number": "१-२५९-२४", "content_sanskrit": "गुरुत्वान्मन्दपालस्तपसश्च विशेषतः।\nअभिवादामहे सर्वे तपक्षाः प्रसादतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2012586, "chapter_id": 1258, "verse_number": "१-२५९-२५", "content_sanskrit": "एवमुक्तवतां तेषां तनन्द्य महातपाः।\nपरिष्वज्य ततो मू उपाघ्राय च बलकान्।\nपुत्रान्स्वयं समाहूयतः प्रोवाच गौतमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2012587, "chapter_id": 1258, "verse_number": "१-२५९-२६", "content_sanskrit": "लालप्यमानमेकैकंरितां च पुनःपुनः।\nन चैवोचुस्तदा किंतमृषिं साध्वसाधु वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2012588, "chapter_id": 1258, "verse_number": "१-२५९-२७x", "content_sanskrit": "मन्दपाल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2012589, "chapter_id": 1258, "verse_number": "१-२५९-२७", "content_sanskrit": "ज्येष्ठः सुतस्ते कत कतमस्तस्य चानुजः।\nमध्यमः कतमश्चैव यान्कतमश्च ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2012590, "chapter_id": 1258, "verse_number": "१-२५९-२८", "content_sanskrit": "एवं ब्रुवन्तं दुःखाकं मा न प्रतिभाषसे।\nकृतवानस्मि हव्यानैव शान्तिमितो लभे।\nएवमुक्त्वा तु तां मन्दपालस्तदाऽस्पृशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2012591, "chapter_id": 1258, "verse_number": "१-२५९-२९x", "content_sanskrit": "जरितोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2012592, "chapter_id": 1258, "verse_number": "१-२५९-२९", "content_sanskrit": "किं नु ज्येष्ठेन ते किमनन्तरजेन ते।\nकिं वा मध्यमजातेन किं कनिष्ठेन वा पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2012593, "chapter_id": 1258, "verse_number": "१-२५९-३०", "content_sanskrit": "यां त्वं मां सर्वतो हीनामुत्सृज्यासि गतः पुरा।\nतामेव लपितां गच्छ तरुणीं चारुहासिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2012594, "chapter_id": 1258, "verse_number": "१-२५९-३१x", "content_sanskrit": "मन्दपाल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2012595, "chapter_id": 1258, "verse_number": "१-२५९-३१", "content_sanskrit": "न स्त्रीणां विद्यते किंचिदमुत्र पुरुषान्तरात्।\nसापत्नकमृते लोके नान्यदर्थविनाशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2012596, "chapter_id": 1258, "verse_number": "१-२५९-३२", "content_sanskrit": "वैराग्निदीपनं चैव भृशुद्वेगकारि च।\nसुव्रता चापि कल्याणी सर्वभूतेषु विश्रुता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2012597, "chapter_id": 1258, "verse_number": "१-२५९-३३", "content_sanskrit": "अरुन्धती महात्मानं वसिष्ठं पर्यशङ्कत।\nविशुद्धभावमत्यन्तं सदा प्रियहिते रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2012598, "chapter_id": 1258, "verse_number": "१-२५९-३४", "content_sanskrit": "सप्तर्षिमध्यगं वीरमवमेने च तं मुनिम्।\nअपध्यानेन सा तेन धूमारुणसमप्रभा।\nलक्ष्याऽलक्ष्या नाभिरूपा निमित्तमिव पश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2012599, "chapter_id": 1258, "verse_number": "१-२५९-३५", "content_sanskrit": "अपत्यहेतोः संप्राप्तं तथा त्वमपि मामिह।\nइष्टमेवं गते हि त्वं सा तथैवाद्य वर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2012600, "chapter_id": 1258, "verse_number": "१-२५९-३६", "content_sanskrit": "न हि भार्येति विश्वासः कार्यः पुंसा कथंचन।\nन हि कार्यमनुध्याति नारी पुत्रवती सती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2012601, "chapter_id": 1258, "verse_number": "१-२५९-३७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2012602, "chapter_id": 1258, "verse_number": "१-२५९-३७", "content_sanskrit": "ततस्ते सर्व एवैनं पुत्राः सम्यगुपासते।\nस च तानात्मजान्सर्वानाश्वासयितुमुद्यतः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2012603, "chapter_id": 1258, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिप्रवणि मयदर्शनपर्वणि ऊनषष्ट्यधिकद्विशततमोऽध्यायः॥ २५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]