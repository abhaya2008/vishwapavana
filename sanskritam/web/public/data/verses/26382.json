[{"id": 7006382000, "chapter_id": 26382, "verse_number": "२-३९-१", "content_sanskrit": "वैशम्पायन उवाच\nविकद्रोस्तु वचः श्रुत्वा वसुदवो महायशाः ।\nपरितुष्टेन मनसा वचनं चेदमब्रवीत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006382001, "chapter_id": 26382, "verse_number": "२-३९-२", "content_sanskrit": "राजा षाड्गुण्यवक्ता वै राजा मन्त्रार्थतत्त्ववित् ।\nसतत्त्वं च हितं चैव कृष्णोक्तं किल धीमता ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006382002, "chapter_id": 26382, "verse_number": "२-३९-३", "content_sanskrit": "भाषिता राजधर्माश्च सत्याश्च जगतो हिताः ।\nविक्रद्रुणा यदुश्रेष्ठ यद्धितं तद् विधीयताम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006382003, "chapter_id": 26382, "verse_number": "२-३९-४", "content_sanskrit": "एतच्छ्रुत्वा पितुर्वाक्यं विक्रद्रोश्च महात्मनः ।\nवाक्यमुत्तममेकाग्रो बभाषे पुरुषोत्तमः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006382004, "chapter_id": 26382, "verse_number": "२-३९-५", "content_sanskrit": "ब्रुवतां वः श्रुतं वाक्यं हेतुतः क्रमतस्तथा ।\nन्यायतः शास्त्रतश्चैव दैवं चैवानुपश्यताम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006382005, "chapter_id": 26382, "verse_number": "२-३९-६", "content_sanskrit": "श्रूयतामुत्तरं वाक्यं श्रुत्वा च परिगृह्यताम् ।\nनयेन व्यवहर्तव्यं पार्थिवेन यथाक्रमम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006382006, "chapter_id": 26382, "verse_number": "२-३९-७", "content_sanskrit": "संधिं च विग्रहं चैव यानमासनमेव च ।\nद्वैधीभावं संश्रयं च षाड्गुण्यं चिन्तयेत् सदा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006382007, "chapter_id": 26382, "verse_number": "२-३९-८", "content_sanskrit": "बलिनः संनिकृष्टे तु न स्थेयं पण्डितेन वै ।\nअपक्रमेद्धि कालज्ञः समर्थो युद्धमुद्वहेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006382008, "chapter_id": 26382, "verse_number": "२-३९-९", "content_sanskrit": "अहं तावत् सहार्येण मुहूर्तेऽस्मिन् प्रकाशिते ।\nजीवितार्थे गमिष्यामि शक्तिमानप्यशक्तवत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006382009, "chapter_id": 26382, "verse_number": "२-३९-१०", "content_sanskrit": "ततः सह्याचलयुतं सहार्येणाहमक्षयम् ।\nआत्मद्वितीयः श्रीमन्तं प्रवेक्ष्ये दक्षिणापथम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006382010, "chapter_id": 26382, "verse_number": "२-३९-११", "content_sanskrit": "करवीरपुरं चैव रम्यं क्रौञ्चपुरं तथा ।\nद्रक्ष्यावस्तत्र सहितौ गोमन्तं च नगोत्तमम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006382011, "chapter_id": 26382, "verse_number": "२-३९-१२", "content_sanskrit": "आवयोर्गमनं श्रुत्वा जितकाशी स पार्थिवः ।\nअप्रविश्य पुरीं दर्पादनुसारं करिष्यति ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006382012, "chapter_id": 26382, "verse_number": "२-३९-१३", "content_sanskrit": "ततः सह्यवनेष्वेव राजा याति स सानुगः ।\nआवयोर्ग्रहणे चैव नृपतिः प्रयतिष्यति ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006382013, "chapter_id": 26382, "verse_number": "२-३९-१४", "content_sanskrit": "एषा नः श्रेयसी यात्रा भविष्यति कुलस्य वै ।\nपौराणामथ पुर्याश्च देशस्य च सुखावहा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006382014, "chapter_id": 26382, "verse_number": "२-३९-१५", "content_sanskrit": "न च शत्रोः परिभ्रष्टा राजानो विजिगीषवः ।\nपरराष्ट्रेषु मृष्यन्ति मृधे शत्रोः क्षयं विना ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006382015, "chapter_id": 26382, "verse_number": "२-३९-१६", "content_sanskrit": "एवमुक्त्वा तु तौ वीरौ कृष्णसंकर्षणावुभौ ।\nप्रपेदतुरसम्भ्रान्तौ दक्षिणौ दक्षिणापथम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006382016, "chapter_id": 26382, "verse_number": "२-३९-१७", "content_sanskrit": "तौ तु राष्ट्राणि शतशश्चरन्तौ कामरूपिणौ ।\nदक्षिणां दिशमास्थाय चेरतुर्मार्गगौ सुखम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006382017, "chapter_id": 26382, "verse_number": "२-३९-१८", "content_sanskrit": "सह्यपृष्ठेषु रम्येषु मोदमानावुभौ तथा ।\nदक्षिणापथगौ वीरावध्वानं सम्प्रपेदतुः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006382018, "chapter_id": 26382, "verse_number": "२-३९-१९", "content_sanskrit": "तौ च स्वल्पेन कालेन सह्याचलविभूषितम् ।\nकरवीरपुरं प्राप्तौ स्ववंशेन विभूषितम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006382019, "chapter_id": 26382, "verse_number": "२-३९-२०", "content_sanskrit": "तौ तत्र गत्वा वेणाया नद्यास्तीरान्तमाश्रितम् ।\nआसेदतुः प्ररोहाढ्यं न्यग्रोधं तरुपुङ्गवम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006382020, "chapter_id": 26382, "verse_number": "२-३९-२१", "content_sanskrit": "अधस्तात् तस्य वृक्षस्य मुनिं दीप्ततपोधनम् ।\nअंसावसक्तपरशुं जटावल्कलधारिणम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006382021, "chapter_id": 26382, "verse_number": "२-३९-२२", "content_sanskrit": "गौरमग्निशिखाकारं तेजसा भास्करोपमम् ।\nक्षत्रान्तकरमक्षोभ्यं वपुष्मन्तमिवार्णवम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006382022, "chapter_id": 26382, "verse_number": "२-३९-२३", "content_sanskrit": "न्यस्तसंकुचिताधानं काले हुतहुताशनम् ।\nक्लिन्नं त्रिषवणाम्भोभिराद्यं देवगुरुं यथा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006382023, "chapter_id": 26382, "verse_number": "२-३९-२४", "content_sanskrit": "सवत्सां धेनुकां श्वेतां होमधुक् कामदोहनाम् ।\nक्षीरारणिं कर्षमाणं महेन्द्रगिरिगोचरम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006382024, "chapter_id": 26382, "verse_number": "२-३९-२५", "content_sanskrit": "ददृशतुस्तौ सहितावपरिश्रान्तमव्ययम् ।\nभार्गवं राममासीनं मन्दरस्थं यथा रविम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006382025, "chapter_id": 26382, "verse_number": "२-३९-२६", "content_sanskrit": "न्यायतस्तौ तु तं दृष्ट्वा पादमूले कृताञ्जली ।\nवसुदेवसुतौ वीरौ सधिष्ण्याविव पावकौ ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006382026, "chapter_id": 26382, "verse_number": "२-३९-२७", "content_sanskrit": "कृष्णस्तमृषिशार्दूलमुवाच वदतां वरः ।\nश्लक्ष्णं मधुरया वाचा  लोकवृत्तान्तकोविदः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006382027, "chapter_id": 26382, "verse_number": "२-३९-२८", "content_sanskrit": "भगवन् जामदग्न्यं त्वामवगच्छामि भार्गवम् ।\nरामं मुनीनामृषभं क्षत्रियाणां कुलान्तकम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006382028, "chapter_id": 26382, "verse_number": "२-३९-२९", "content_sanskrit": "त्वया सायकवेगेन क्षिप्तो भार्गव सागरः ।\nइषुपातेन नगरं कृतं शूर्पारकं त्वया ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006382029, "chapter_id": 26382, "verse_number": "२-३९-३०", "content_sanskrit": "धनुःपञ्चशतायाममिषुपञ्चशतोच्छ्रयम् ।\nसह्यस्य च निकुञ्जेषु स्फीतो जनपदो महान् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006382030, "chapter_id": 26382, "verse_number": "२-३९-३१", "content_sanskrit": "अतिक्रम्योदधेर्वेलामपरान्ते निवेशितः ।\nत्वया तत् कार्तवीर्यस्य सहस्रभुजकाननम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006382031, "chapter_id": 26382, "verse_number": "२-३९-३२", "content_sanskrit": "छिन्नं परशुनैकेन स्मरता निधनं पितुः ।\nइयमद्यापि रुधिरैः क्षत्रियाणां हतद्विषाम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006382032, "chapter_id": 26382, "verse_number": "२-३९-३३", "content_sanskrit": "स्निग्धैस्त्वत्परशूत्सृष्टै रक्तपङ्का वसुंधरा ।\nरैणुकेयं विजाने त्वां क्षितौ क्षितिपरोषणम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006382033, "chapter_id": 26382, "verse_number": "२-३९-३४", "content_sanskrit": "परशुप्रग्रहे युक्तं यथैवेह रणे तथा ।\nतदिच्छावस्त्वया विप्र कंचिदर्थमुपश्रुतम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006382034, "chapter_id": 26382, "verse_number": "२-३९-३५", "content_sanskrit": "उत्तरं च श्रुतार्थेन प्रत्युक्तमविशङ्कया ।\nआवयोर्मथुरा राम यमुनातीरशोभिनी ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006382035, "chapter_id": 26382, "verse_number": "२-३९-३६", "content_sanskrit": "यादवौ स्वो मुनिश्रेष्ठ यदि ते श्रुतिमागतौ ।\nवसुदेवो यदुश्रेष्ठः पिता नौ हि धृतव्रतः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006382036, "chapter_id": 26382, "verse_number": "२-३९-३७", "content_sanskrit": "जन्मप्रभृति चैवावां व्रजेष्वेव नियोजितौ ।\nतौ स्वः कंसभयात् तत्र शङ्कितौ परिवर्द्धितौ ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006382037, "chapter_id": 26382, "verse_number": "२-३९-३८", "content_sanskrit": "वयञ्च प्रथमं प्राप्तौ मथुरायां प्रवेशितौ ।\nतावावां व्युत्थितं हत्वा समाजे कंसमोजसा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006382038, "chapter_id": 26382, "verse_number": "२-३९-३९", "content_sanskrit": "पितरं तस्य तत्रैव स्थापयित्वा जनेश्वरम् ।\nस्वमेव कर्म चारब्धौ गवां व्यापारकारकौ ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006382039, "chapter_id": 26382, "verse_number": "२-३९-४०", "content_sanskrit": "अथावयोः पुरं रोद्धुं जरासंधो व्यवस्थितः ।\nसंग्रामान्सुबहून्कृत्वा लब्धलक्षावपि स्वयम्॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006382040, "chapter_id": 26382, "verse_number": "२-३९-४१", "content_sanskrit": "ततः स्वपुररक्षार्थं प्रजानां च धृतव्रत ।\nअकृतार्थावनुद्योगौ कर्तव्यबलसाधनौ ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006382041, "chapter_id": 26382, "verse_number": "२-३९-४२", "content_sanskrit": "अरथौ पत्तिनौ युद्धे निस्तनुत्रौ निरायुधौ ।\nजरासंधोद्यमभयात् पुराद् द्वावेव निःसृतौ ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006382042, "chapter_id": 26382, "verse_number": "२-३९-४३", "content_sanskrit": "एवमावामनुप्राप्तौ मुनिश्रेष्ठ तवान्तिकम् ।\nआवयोर्मन्त्रमात्रेण कर्तुमर्हसि सत्क्रियाम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006382043, "chapter_id": 26382, "verse_number": "२-३९-४४", "content_sanskrit": "श्रुत्वैतद् भार्गवो रामस्तयोर्वाक्यमनिन्दितम् ।\nरेणुकेयः प्रतिवचो धर्मसंहितमब्रवीत् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006382044, "chapter_id": 26382, "verse_number": "२-३९-४५", "content_sanskrit": "अपरान्तादहं कृष्ण सम्प्रतीहागतः प्रभो ।\nएक एव विना शिष्यैर्युवयोर्मन्त्रकारणात् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006382045, "chapter_id": 26382, "verse_number": "२-३९-४६", "content_sanskrit": "विदितो मे व्रजे वासस्तव पद्मनिभेक्षण ।\nदानवानां वधश्चापि कंसस्यापि दुरात्मनः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006382046, "chapter_id": 26382, "verse_number": "२-३९-४७", "content_sanskrit": "विग्रहं च जरासंधे विदित्वा पुरुषोत्तम ।\nतव सभ्रातृकस्येह सम्प्राप्तोऽस्मि वरानन ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006382047, "chapter_id": 26382, "verse_number": "२-३९-४८", "content_sanskrit": "जाने त्वां कृष्ण गोप्तारं जगतः प्रभुमव्ययम् ।\nदेवकार्यार्थसिद्ध्यर्थमबालं बालतां गतम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006382048, "chapter_id": 26382, "verse_number": "२-३९-४९", "content_sanskrit": "न त्वयाविदितं किंचित् त्रिषु लोकेषु विद्यते ।\nतथापि भक्तिमात्रेण शृणु वक्ष्यामि ते वचः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006382049, "chapter_id": 26382, "verse_number": "२-३९-५०", "content_sanskrit": "पूर्वजैस्तव गोविन्द पूर्वं पुरमिदं कृतम् ।\nकरवीरपुरं नाम राष्ट्रं चैव निवेशितम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006382050, "chapter_id": 26382, "verse_number": "२-३९-५१", "content_sanskrit": "पुरेऽस्मिन् नृपतिः कृष्ण वासुदेवो महायशाः ।\nशृगाल इति विख्यातो नित्यं परमकोपनः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006382051, "chapter_id": 26382, "verse_number": "२-३९-५२", "content_sanskrit": "नृपेण तेन गोविन्द तव वंशभवा नृपाः ।\nदायादा निहताः सर्वे वीर द्वेषानुशायिना ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006382052, "chapter_id": 26382, "verse_number": "२-३९-५३", "content_sanskrit": "अहंकारपरो नित्यमजितात्मातिमत्सरी ।\nराज्यैश्वर्यमदाविष्टः पुत्रेष्वपि च दारुणः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006382053, "chapter_id": 26382, "verse_number": "२-३९-५४", "content_sanskrit": "तन्नेह भवतः स्थानं रोचते मे नरोत्तम ।\nकरवीरपुरे घोरे नित्यं पार्थिवदूषिते ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006382054, "chapter_id": 26382, "verse_number": "२-३९-५५", "content_sanskrit": "श्रूयतां कथयिष्यामि यत्रोभौ शत्रुबाधनौ ।\nजरासंधं बलोदग्रं भवन्तौ योधयिष्यतः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006382055, "chapter_id": 26382, "verse_number": "२-३९-५६", "content_sanskrit": "तीर्त्वा वेणामिमां पुण्यां नदीमद्यैव बाहुभिः ।\nविषयान्ते निवासाय गिरिं गच्छाम दुर्गमम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006382056, "chapter_id": 26382, "verse_number": "२-३९-५७", "content_sanskrit": "रम्यं यज्ञगिरिं नाम सह्यस्य प्ररुहं गिरिम् ।\nनिवासं मांसभक्षाणां चौराणां घोरकर्मणाम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006382057, "chapter_id": 26382, "verse_number": "२-३९-५८", "content_sanskrit": "नानाद्रुमलतायुक्तं चित्रं पुष्पितपादपम् ।\nप्रोष्ये तत्र निशामेकां खटवाङ्गां नाम निम्नगाम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006382058, "chapter_id": 26382, "verse_number": "२-३९-५९", "content_sanskrit": "भद्रं ते संतरिष्यामो निकषोपलभूषणाम् ।\nगङ्गाप्रपातप्रतिमां भ्रष्टां च महतो गिरेः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006382059, "chapter_id": 26382, "verse_number": "२-३९-६०", "content_sanskrit": "तस्याः प्रपातं द्रक्ष्यामस्तापसारण्यभूषणम् ।\nउपभुज्य त्विमान्कामान्गत्वा तान्धरणीधरान् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006382060, "chapter_id": 26382, "verse_number": "२-३९-६१", "content_sanskrit": "द्रक्ष्यामस्तत्र तान् विप्राञ्छाम्यतो वै तपोधनान् ।\nरम्यं क्रौञ्चपुरं नाम गमिष्यामः पुरोत्तमम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006382061, "chapter_id": 26382, "verse_number": "२-३९-६२", "content_sanskrit": "वंशजस्तत्र ते राजा कृष्ण धर्मरतः सदा ।\nमहाकपिरिति ख्यातो वनवास्यजनाधिपः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006382062, "chapter_id": 26382, "verse_number": "२-३९-६३", "content_sanskrit": "तमदृष्ट्वैव राजानं निवासाय गतेऽहनि ।\nतीर्थमानडुहं नाम तत्रस्थाः स्याम संगताः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006382063, "chapter_id": 26382, "verse_number": "२-३९-६४", "content_sanskrit": "ततश्च्युता गमिष्यामः सह्यस्य विवरे गिरिम् ।\nगोमन्तमिति विख्यातं नैकशृङ्गविभूषितम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006382064, "chapter_id": 26382, "verse_number": "२-३९-६५", "content_sanskrit": "स्वर्गतैकमहाशृङ्गं दुरारोहं खगैरपि ।\nविश्रामभूतं देवानां ज्योतिर्भिरभिसंवृतम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006382065, "chapter_id": 26382, "verse_number": "२-३९-६६", "content_sanskrit": "सोपानभूतं स्वर्गस्य गगनाद्रिमिवोच्छ्रितम् ।\nतं विमानावतरणं गिरिं मेरुरिवापरम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006382066, "chapter_id": 26382, "verse_number": "२-३९-६७", "content_sanskrit": "तस्योत्तमे महाशृङ्गे भास्वन्तौ देवरूपिणौ ।\nउदयास्तमये सूर्यं सोमं च ज्योतिषां पतिम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006382067, "chapter_id": 26382, "verse_number": "२-३९-६८", "content_sanskrit": "ऊर्मिमन्तं समुद्रं च अपारद्वीपभूषणम् ।\nप्रेक्षमाणौ सुखं तत्र नगाग्रे विचरिष्यथः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006382068, "chapter_id": 26382, "verse_number": "२-३९-६९", "content_sanskrit": "शृङ्गस्थौ तस्य शैलस्य गोमन्तस्य वनेचरौ ।\nदुर्गयुद्धेन धावन्तौ जरासंधं विजेष्यथ ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006382069, "chapter_id": 26382, "verse_number": "२-३९-७०", "content_sanskrit": "तत्र शैलगतौ दृष्ट्वा भवन्तौ युद्धदुर्मदौ ।\nआसक्तः शैलयुद्धे च जरासंधो भविष्यति ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006382070, "chapter_id": 26382, "verse_number": "२-३९-७१", "content_sanskrit": "भवतोरपि युद्धे तु प्रवृत्ते तत्र दारुणे ।\nआयुधैः सह संयोगं पश्यामि नचिरादिव ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006382071, "chapter_id": 26382, "verse_number": "२-३९-७२", "content_sanskrit": "संग्रामश्च महान् कृष्ण निर्दिष्टस्तत्र दैवतैः ।\nयदूनां पार्थिवानां च मांसशोणितकर्दमः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006382072, "chapter_id": 26382, "verse_number": "२-३९-७३", "content_sanskrit": "तत्र चक्रं हलं चैव गदां कौमोदकीं तथा ।\nसौनन्दं मुसलं चैव वैष्णवान्यायुधानि च ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006382073, "chapter_id": 26382, "verse_number": "२-३९-७४", "content_sanskrit": "दर्शयिष्यन्ति संग्रामे पास्यन्ति च महीक्षिताम् ।\nरुधिरं कालयुक्तानां वपुर्भिः कालसंनिभैः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006382074, "chapter_id": 26382, "verse_number": "२-३९-७५", "content_sanskrit": "स चक्रमुसलो नाम संग्रामः कृष्ण विश्रुतः ।\nदैवतैरिह निर्दिष्टः कालस्यादेशसंज्ञितः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006382075, "chapter_id": 26382, "verse_number": "२-३९-७६", "content_sanskrit": "तत्र ते कृष्ण संग्रामे सुव्यक्तं वैष्णवं वपुः ।\nद्रक्ष्यन्ति रिपवः सर्वे सुराश्च सुरभावन ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006382076, "chapter_id": 26382, "verse_number": "२-३९-७७", "content_sanskrit": "तां भजस्व गदां कृष्ण चक्रं च चिरविस्मृतम् ।\nभजस्व स्वेन रूपेण सुराणां विजयाय वै ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006382077, "chapter_id": 26382, "verse_number": "२-३९-७८", "content_sanskrit": "बलश्चायं हलं घोरं मुसलं चारिभेदनम् ।\nवधाय सुरशत्रूणां भजताल्लोकभावनः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006382078, "chapter_id": 26382, "verse_number": "२-३९-७९", "content_sanskrit": "एष ते प्रथमः कृष्ण संग्रामो भुवि पार्थिवैः ।\nपृथिव्यर्थे समाख्यातो भारावतरणे सुरैः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006382079, "chapter_id": 26382, "verse_number": "२-३९-८०", "content_sanskrit": "आयुधावाप्तिरत्रैव वपुषो वैष्णवस्य च ।\nलक्ष्म्याश्च तेजसश्चैव व्यूहानां च विदारणम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006382080, "chapter_id": 26382, "verse_number": "२-३९-८१", "content_sanskrit": "अतःप्रभृति संग्रामो धरण्यां शस्त्रमूर्च्छितः ।\nभविष्यति महान् कृष्ण भारतं नाम वैशसम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006382081, "chapter_id": 26382, "verse_number": "२-३९-८२", "content_sanskrit": "तद् गच्छ कृष्ण शैलेन्द्रं गोमन्तं च नगोत्तमम् ।\nजरासंधमृधे चापि विजयस्त्वामुपस्थितः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006382082, "chapter_id": 26382, "verse_number": "२-३९-८३", "content_sanskrit": "इदं चैवामृतप्रख्यं होमधेनोः पयोऽमृतम् ।\nपीत्वा गच्छत भद्रं वो मयाऽऽदिष्टेन वर्त्मना ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}]