[{"id": 2159291, "chapter_id": 4456, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2159292, "chapter_id": 4456, "verse_number": "१", "content_sanskrit": "नाभागमम्बरीषं च मृतं सृञ्जय शुश्रुम ।\nयं सहस्रं सहस्राणां राज्ञामयुतयोधिनाम्\nजिगीषमाणाः सङ्ग्रामे समन्ताद् वैरिणोऽभ्ययुः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2159293, "chapter_id": 4456, "verse_number": "२", "content_sanskrit": "शस्त्रमुच्चावचं घोरं सृजन्तश्चाशिवा गिरः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2159294, "chapter_id": 4456, "verse_number": "३", "content_sanskrit": "बललाघवशिक्षाभिः तेषां शस्त्रबलेन च ।\nछित्त्वाऽयुतगजान् जित्वा नाभागस्तु गतव्यथः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2159295, "chapter_id": 4456, "verse_number": "४", "content_sanskrit": "त एनं मुक्तसन्नाहा नाथन्ते जीवितैषिणः ।\nशरण्यमीयुः शरणं तव स्म इति वादिनः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2159296, "chapter_id": 4456, "verse_number": "५", "content_sanskrit": "स तु तान् वशगान् कृत्वा जित्वा चेमां वसुन्धराम् ।\nईजे यज्ञशतैरिष्टैर्यथा शक्रस्तथाऽनघ\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2159297, "chapter_id": 4456, "verse_number": "६", "content_sanskrit": "तस्य यज्ञेषु विप्रेन्द्राः प्रहृष्टाः परमार्चिताः ।\nबुभुजुः सर्वसम्पन्नमन्नमन्ये जनास्तथा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2159298, "chapter_id": 4456, "verse_number": "७", "content_sanskrit": "मोदकान् कारिकापूपान् धाना वटकशष्कुलीः ।\nकरम्भान् पृथुकामन्धानन्यानि सुकृतानि च\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2159299, "chapter_id": 4456, "verse_number": "८", "content_sanskrit": "सूपाढ्योरण्ड्रकान् यूषान् रागषाडबपानकान् ।\nनिभृतानि सुयुक्तानि स्वादूनि सुरभीणि च\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2159300, "chapter_id": 4456, "verse_number": "९", "content_sanskrit": "घृतं मधु पयस्तोयं दधीनि रसवन्ति च ।\nफलं मूलं च सुस्वादु द्विजास्तत्रोपभुञ्जते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2159301, "chapter_id": 4456, "verse_number": "१०", "content_sanskrit": "मदनीयानि पानानि विदंशानात्मनः प्रियान् ।\nपपुस्तत्र यथाकामं पानकाः शीतकाः परम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2159302, "chapter_id": 4456, "verse_number": "११", "content_sanskrit": "तत्र स्म गाथा गायन्ति क्षीबा हृष्टाः पठन्ति च ।\nनाभागस्तवसंयुक्ता ननृतुश्च सहस्रशः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2159303, "chapter_id": 4456, "verse_number": "१२", "content_sanskrit": "तेषु यज्ञेषु नाभागो दक्षिणा अत्यकालयत् ।\nराज्ञां शतसहस्राणि प्रयुतायुतवाजिनाम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2159304, "chapter_id": 4456, "verse_number": "१३", "content_sanskrit": "हिरण्यकवचान् सर्वान् सर्वांश्चोत्तमधन्विनः ।\nहिरण्यस्यन्दनारूढान् सानुयात्रपरिच्छदान्\nईजानो वितते यज्ञे दक्षिणा अत्यकालयत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2159305, "chapter_id": 4456, "verse_number": "१४", "content_sanskrit": "मूर्धावसिक्तांश्च नृपान् राजपुत्रशतानि च ।\nसदण्डकोशविषयान् ब्राह्मणेभ्यो ह्यमंसत\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2159306, "chapter_id": 4456, "verse_number": "१५", "content_sanskrit": "नेह पूर्वे तथा चक्रुः कर्तारो वा न चापरे ।\nयदम्बरीषो नृपतिः करोत्यमितदक्षिणः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2159307, "chapter_id": 4456, "verse_number": "१६", "content_sanskrit": "इत्येवमन्वमोदन्त प्रीताः सुरमहर्षयः ।\nस चेन्ममार सृञ्जय चतुर्भद्रतरस्त्वया\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2159308, "chapter_id": 4456, "verse_number": "१७", "content_sanskrit": "पुत्रात् पुण्यतमस्तुभ्यं मा पुत्रमनुतप्यथाः ।\nअयज्वानमदक्षिण्यमधिचैत्येत्युदाहरत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2159309, "chapter_id": 4456, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि एकषष्टितमोऽध्यायः ॥ ६१ ॥\nअभिमन्युवधपर्वणि त्रिंशोऽध्यायः ॥ ३० ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]