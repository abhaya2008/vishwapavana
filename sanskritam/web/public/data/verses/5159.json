[{"id": 2195535, "chapter_id": 5159, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2195536, "chapter_id": 5159, "verse_number": "१", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nचतुर्णामपि वेदानां संवादं पुत्र तच्छृणु\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2195537, "chapter_id": 5159, "verse_number": "", "content_sanskrit": "ऋग्वेदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2195538, "chapter_id": 5159, "verse_number": "२", "content_sanskrit": "गृहानाश्रयमाणस्य अग्निहोत्रं च जुह्वतः ।\nसर्वं सुकृतमादत्ते यः साये नुद्यतेऽतिथिः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2195539, "chapter_id": 5159, "verse_number": "", "content_sanskrit": "यजुर्वेदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2195540, "chapter_id": 5159, "verse_number": "३", "content_sanskrit": "न स्कन्दते न व्यथते नास्योर्ध्वं सर्पते रजः ।\nवरिष्ठमग्निहोत्राच्च ब्राह्मणस्य मुखे हुतम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2195541, "chapter_id": 5159, "verse_number": "", "content_sanskrit": "सामवेदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2195542, "chapter_id": 5159, "verse_number": "४", "content_sanskrit": "न चेद्धन्ति पितरं मातरं वा\nन ब्राह्मणं नोऽपवादं करोति ।\nयत् किञ्चिदन्यद् वृजिनं करोति\nप्रीतोऽतिथिस्तदुपहन्ति पापम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2195543, "chapter_id": 5159, "verse_number": "", "content_sanskrit": "अथर्ववेदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2195544, "chapter_id": 5159, "verse_number": "५", "content_sanskrit": "यत्क्रोधनो यजते यद् ददाति\nयद्वा तपस्तप्यति यज्जुहोति ।\nवैवस्वतो हरते सर्वमस्य\nमोघं चेष्टं भवति क्रोधनस्य\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2195545, "chapter_id": 5159, "verse_number": "१०", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे चतुर्वेदसंवादो नाम दशमोऽध्यायः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2195546, "chapter_id": 5159, "verse_number": "", "content_sanskrit": "* * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}]