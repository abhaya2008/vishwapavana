[{"id": 2078738, "chapter_id": 2672, "verse_number": "१२-१७७-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2078739, "chapter_id": 2672, "verse_number": "१२-१७७-१", "content_sanskrit": "केन वृत्तेन वृत्तज्ञ वीतशोकश्चरेन्महीम्।\nकिंच कुर्वन्नरो लोके प्राप्नोति गतिमुत्तमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2078740, "chapter_id": 2672, "verse_number": "१२-१७७-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2078741, "chapter_id": 2672, "verse_number": "१२-१७७-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nप्रह्लादस्य च संवादं मुनेराजगरस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2078742, "chapter_id": 2672, "verse_number": "१२-१७७-३", "content_sanskrit": "चरन्तं ब्राह्मणं कंचित्कल्यचित्तमनामयम्।\nपप्रच्छ राजा प्रह्लादो बुद्धिमान्प्राज्ञसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2078743, "chapter_id": 2672, "verse_number": "१२-१७७-४x", "content_sanskrit": "प्रह्लाद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2078744, "chapter_id": 2672, "verse_number": "१२-१७७-४", "content_sanskrit": "स्वस्थः शक्तो मृदुर्दान्तो निर्विधित्सोऽनसूयकः।\nसुवाग्बहुमतो लोके प्राज्ञश्चरसि बालवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2078745, "chapter_id": 2672, "verse_number": "१२-१७७-५", "content_sanskrit": "नैव प्रार्थयसे लाभं नालाभेष्वनुशोचसि।\nनित्यतृप्त इव ब्रह्मन्न किंचिदिव मन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2078746, "chapter_id": 2672, "verse_number": "१२-१७७-६", "content_sanskrit": "स्रोतसा ह्रियमाणासु प्रजासु विमना इव।\nधर्मकामार्थकार्येषु कूटस्थ इव लक्ष्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2078747, "chapter_id": 2672, "verse_number": "१२-१७७-७", "content_sanskrit": "नानुतिष्ठसि धर्मार्थौ न कामे चापि वर्तसे।\nइन्द्रियार्थाननादृत्य मुक्तश्चरसि साक्षिवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2078748, "chapter_id": 2672, "verse_number": "१२-१७७-८", "content_sanskrit": "का नु प्रज्ञा श्रुतं वा किं वृत्तिर्वा का नु ते मुने।\nक्षिप्रमाचक्ष्व मे ब्रह्मञ्श्रेयो यदिह मन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2078749, "chapter_id": 2672, "verse_number": "१२-१७७-९x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2078750, "chapter_id": 2672, "verse_number": "१२-१७७-९", "content_sanskrit": "अनुयुक्तः स मेधावी लोकधर्मविधानवित्।\nउवाच श्लक्ष्णया वाचा प्रह्लादमनपार्थया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2078751, "chapter_id": 2672, "verse_number": "१२-१७७-१०", "content_sanskrit": "पश्य प्रह्लाद भूतानामुत्पत्तिमनिमित्ततः।\nह्रासं वृद्धिं विनाशं च न प्रहृष्ये न च व्यथे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2078752, "chapter_id": 2672, "verse_number": "१२-१७७-११", "content_sanskrit": "स्वभावादेव संदृश्या वर्तमानाः प्रवृत्तयः।\nस्वभावनिरताः सर्वाः प्रतिपाद्या न केनचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2078753, "chapter_id": 2672, "verse_number": "१२-१७७-१२", "content_sanskrit": "पश्य प्रह्लाद संयोगान्विप्रयोगपरायणान्।\nसंचयांश्च विनाशान्तान्न क्वचिद्विदधे मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2078754, "chapter_id": 2672, "verse_number": "१२-१७७-१३", "content_sanskrit": "अन्तवन्ति च भूतानि गुणयुक्तानि पश्यतः।\nउत्पत्तिनिधनज्ञस्य किं पर्यायेणोपलक्षये।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2078755, "chapter_id": 2672, "verse_number": "१२-१७७-१४", "content_sanskrit": "जलजानामपि ह्यन्तं पर्यायेणोपलक्षये।\nमहतामपि कायानां सूक्ष्माणां च महोदधौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2078756, "chapter_id": 2672, "verse_number": "१२-१७७-१५", "content_sanskrit": "जङ्गमस्थावराणां च भूतानामसुराधिप।\nपार्थिवानामपि व्यक्तं मृत्युं पश्यामि सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2078757, "chapter_id": 2672, "verse_number": "१२-१७७-१६", "content_sanskrit": "अन्तरिक्षचराणां च दानवोत्तमपक्षिणाम्।\nउत्तिष्ठते यथाकालं मृत्युर्बलवतामपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2078758, "chapter_id": 2672, "verse_number": "१२-१७७-१७", "content_sanskrit": "दिवि संचरमाणानि ह्रस्वानि च महान्ति च।\nज्योतींष्यपि यथाकालं पतमानानि लक्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2078759, "chapter_id": 2672, "verse_number": "१२-१७७-१८", "content_sanskrit": "इति भूतानि संपश्यन्ननुषक्तानि मृत्युना।\nसर्वं सामान्यतो विद्वान्कृतकृत्यः सुखं स्वपे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2078760, "chapter_id": 2672, "verse_number": "१२-१७७-१९", "content_sanskrit": "सुमहान्तमपि ग्रासं ग्रसे लब्धं यदृच्छया।\nशये पुनरभुञ्जानो दिवसानि बहून्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2078761, "chapter_id": 2672, "verse_number": "१२-१७७-२०", "content_sanskrit": "आशयन्त्यपि मामन्नं पुनर्बहुगुणं बहु।\nपुनरल्पं पुनस्तोकं पुनर्नैवोपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2078762, "chapter_id": 2672, "verse_number": "१२-१७७-२१", "content_sanskrit": "कणं कदाचित्खादामि पिण्याकमपि च ग्रसे।\nभक्षये शालिमांसानि भक्षांश्चोच्चावचान्पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2078763, "chapter_id": 2672, "verse_number": "१२-१७७-२२", "content_sanskrit": "शये कदाचित्पर्यङ्के भूमावपि पुनः शये।\nप्रासादे चापि मे शय्या कदाचिदुपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2078764, "chapter_id": 2672, "verse_number": "१२-१७७-२३", "content_sanskrit": "धारयामि च चीराणि शाणक्षौमाजिनानि च।\nमहार्हाणि च वासांसि धारयाम्यहमेकदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2078765, "chapter_id": 2672, "verse_number": "१२-१७७-२४", "content_sanskrit": "न सन्निपतितं धर्म्यमुपभोगं यदृच्छया।\nप्रत्याचक्षे न चाप्येनमनुरुध्ये सुदुर्लभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2078766, "chapter_id": 2672, "verse_number": "१२-१७७-२५", "content_sanskrit": "अचलमनिधनं शिवं विशोकं\nशुचिमतुलं विदुषां मते प्रविष्टम्।\nअनभिमतमसेवितं विमूढै\nर्व्रतमिदमाजगरं शुचिश्चरामि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2078767, "chapter_id": 2672, "verse_number": "१२-१७७-२६", "content_sanskrit": "अचलितमतिरच्युतः स्वधर्मा\nत्परिमितसंसरणः परावरज्ञः।\nविगतभयकषायलोभमोहो\nव्रतमिदमाजगरं शुचिश्चरामि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2078768, "chapter_id": 2672, "verse_number": "१२-१७७-२७", "content_sanskrit": "अनियतफलभक्ष्यभोज्यपेयं\nविधिपरिणामविभक्तदेशकालम्।\nहृदयसुखमसेवितं कदर्यै\nर्व्रतमिदमाजगरं सुचिश्चरामि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2078769, "chapter_id": 2672, "verse_number": "१२-१७७-२८", "content_sanskrit": "इदमिदमिति तृष्णयाऽभिभूतं\nजनमनवाप्तधनं विषीदमानम्।\nनिपुणमनुनिशाम्य तत्त्वबुद्ध्या\nव्रतमिदमाजगरं शुचिश्चरामि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2078770, "chapter_id": 2672, "verse_number": "१२-१७७-२९", "content_sanskrit": "बहुविधमनुदृश्य चार्थहेतोः\nकृपणमिहार्यमनार्यमाश्रयं तम्।\nउपशमरुचिरात्मवान्प्रशान्तो\nव्रतमिदमाजगरं शुचिश्चरामि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2078771, "chapter_id": 2672, "verse_number": "१२-१७७-३०", "content_sanskrit": "सुखमसुखमलाभमर्थलाभं\nरतिमरतिं मरणं च जीवितं च।\nविधिनियतमवेक्ष्य तत्त्वतोऽहं\nव्रतमिदमाजगरं शुचिश्चरामि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2078772, "chapter_id": 2672, "verse_number": "१२-१७७-३१", "content_sanskrit": "अपगतभयरागमोहदर्पो\nधृतिमतिबुद्धिसमन्वितः प्रशान्तः।\nउपगतफलभोगिनो निशाम्य\nव्रतमिदमाजगरं शुचिश्चरामि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2078773, "chapter_id": 2672, "verse_number": "१२-१७७-३२", "content_sanskrit": "अनियतशयनासनः प्रकृत्या\nदमनियमव्रतसत्यशौचयुक्तः।\nअपगतफलसंचयः प्रहृष्टो\nव्रतमिदमाजगरं शुचिश्चरामि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2078774, "chapter_id": 2672, "verse_number": "१२-१७७-३३", "content_sanskrit": "अपगतमसुखार्थमीहनार्थै\nरुपगतबुद्धिरवेक्ष्य चात्मसंस्थम्।\nतृपितमनियतं मनो नियन्तुं\nव्रतमिदमाजगरं शुचिश्चरामि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2078775, "chapter_id": 2672, "verse_number": "१२-१७७-३४", "content_sanskrit": "न हृदयमनुरुध्यते मनो वा\nप्रियसुखदुर्लभतामनित्यतां च।\nतदुभयमुपलक्षयन्निवाहं\nव्रतमिदमाजगरं शुचिश्चरामि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2078776, "chapter_id": 2672, "verse_number": "१२-१७७-३५", "content_sanskrit": "बहु कथितमिदं हि बुद्धिमद्भिः\nकविभिरपि प्रथयद्भिरात्मकीर्तिम्।\nइदमिदमिति तत्रतत्र हन्त\nस्वपरमतैर्गहनं प्रतर्कयद्भिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2078777, "chapter_id": 2672, "verse_number": "१२-१७७-३६", "content_sanskrit": "तदिदमनुनिशाम्य विप्रपातं\nपृथगभिपन्नमिहाबुधैर्मनुष्यैः।\nअनवसितमनन्तदोषपारं\nनृपु विहरामि विनीतदोषतृष्णः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2078778, "chapter_id": 2672, "verse_number": "१२-१७७-३७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2078779, "chapter_id": 2672, "verse_number": "१२-१७७-३७", "content_sanskrit": "अजगरचरितं व्रतं महात्मा\nय इह नरोऽनुचरेद्विनीतरागः।\nअपगतभयलोभमोहमन्युः\nस खलु सुखी विचरेदिमं विहारम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2078780, "chapter_id": 2672, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि सप्तसप्तत्यधिकशततमोऽध्यायः॥ १७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]