[{"id": 2038267, "chapter_id": 1834, "verse_number": "५-७९-०x", "content_sanskrit": "नकुल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2038268, "chapter_id": 1834, "verse_number": "५-७९-१", "content_sanskrit": "उक्तं बहुविधं वाक्यं धर्मराजेन माधव।\nधर्मज्ञेन वदान्येन श्रुतं चैव हि तत्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2038269, "chapter_id": 1834, "verse_number": "५-७९-२", "content_sanskrit": "मतमाज्ञाय राज्ञश्च भीमसेनेन माधव ।\nसंशमो बाहुवीर्य च ख्यापितं माधवात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2038270, "chapter_id": 1834, "verse_number": "५-७९-३", "content_sanskrit": "तथैव फाल्गुनेनापि यदुक्तं तत्त्वया श्रुतम् ।\nआत्मनश्च मतं वीर कथितं भवताऽसकृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2038271, "chapter_id": 1834, "verse_number": "५-७९-४", "content_sanskrit": "सर्वमेतदतिक्रम्य श्रुत्वा परमतं भवान्।\nयत्प्राप्तकालं मन्येथास्तत्कुर्याः पुरुषोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2038272, "chapter_id": 1834, "verse_number": "५-७९-५", "content_sanskrit": "तस्मिंरतस्मिन्निमित्ते हि मतं भवति केशव ।\nप्राप्तकालं मनुष्येण क्षमं कार्यमरिन्दम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2038273, "chapter_id": 1834, "verse_number": "५-७९-६", "content_sanskrit": "अन्यथा चिन्तितो ह्यर्थः पुनर्भवति सोऽन्यथा ।\nअनित्यमतयो लोके नराः पुरुषसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2038274, "chapter_id": 1834, "verse_number": "५-७९-७", "content_sanskrit": "अन्यथाबुद्धयो ह्यासन्नस्मासु वनवासिषु।\nअदृश्येष्वन्यथा कृष्ण दृश्येषु पुनरन्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2038275, "chapter_id": 1834, "verse_number": "५-७९-८", "content_sanskrit": "अस्माकमपि वार्ष्णेय वने विचरतां तदा।\nन तथा प्रणयो राज्ये यथा संप्रति वर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2038276, "chapter_id": 1834, "verse_number": "५-७९-९", "content_sanskrit": "निवृत्तवनवासान्नः श्रुत्वा वीर समागताः ।\nअक्षौहिण्यो हि सप्ते मास्त्वत्प्रसादाज्जनार्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2038277, "chapter_id": 1834, "verse_number": "५-७९-१०", "content_sanskrit": "इमान्हि पुरुषव्याघ्रानचिन्त्यबलपौरुषात्।\nआत्तशस्त्रान्रणे दृष्ट्वा न व्यथेदिह कः पुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2038278, "chapter_id": 1834, "verse_number": "५-७९-११", "content_sanskrit": "स भवान्कुरुमध्ये तं सान्त्वपूर्वं भयोत्तरम्।\nब्रूयाद्वाक्यं यथा मन्दो न व्यथेत सुयोधनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2038279, "chapter_id": 1834, "verse_number": "५-७९-१२", "content_sanskrit": "युधिष्ठिरं भीमसेनं बीभत्सुं चापराचितम् ।\nसहदेवं च मां चैव त्वां च रामं च केशव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2038280, "chapter_id": 1834, "verse_number": "५-७९-१३", "content_sanskrit": "सात्यकिं च महावीर्यं विराटं च महात्मजम्।\nद्रुपदं च महामात्यं धृष्टद्युम्नं च माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2038281, "chapter_id": 1834, "verse_number": "५-७९-१४", "content_sanskrit": "काशिराजं च विक्रान्तं धृष्टकेतुं च चेदिपम् ।\nमांसशोणितभृन्मर्त्यः प्रतियुध्येत को युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2038282, "chapter_id": 1834, "verse_number": "५-७९-१५", "content_sanskrit": "स भवान्गमनादेव साधयिष्यत्यसंशयम्।\nइष्टमर्थं महाबाहो धर्मराजस्य केवलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2038283, "chapter_id": 1834, "verse_number": "५-७९-१६", "content_sanskrit": "विदुरश्चैव भीष्मश्च द्रोणश्च सहबाह्लिकः ।\nश्रेयः समर्था विज्ञातुमुच्यमानास्त्वयाऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2038284, "chapter_id": 1834, "verse_number": "५-७९-१७", "content_sanskrit": "ते चैनमनुनेष्यन्ति धृतराष्ट्रं जनाधिपम् ।\nतं च पापसमाचारं सहामात्यं सुयोधनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2038285, "chapter_id": 1834, "verse_number": "५-७९-१८", "content_sanskrit": "श्रोता चार्थस्य विदुरस्त्वं च वक्ता जनार्दन ।\nकमिवार्थं निवर्तन्तं स्थापयेतां न वर्त्मनि ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2038286, "chapter_id": 1834, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि एकोनाशीतितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]