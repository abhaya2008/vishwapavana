[{"id": 7002501000, "chapter_id": 22501, "verse_number": "१-१६३-१", "content_sanskrit": "सुमन्तुरुवाच ।\nभास्करस्य महाबाहो भानोरमिततेजसः ।\nस्नानकाले प्रकुर्वीत जयशब्दादिमंग लम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002501001, "chapter_id": 22501, "verse_number": "१-१६३-२", "content_sanskrit": "पद्मस्वस्तिकशंखं तु श्रीवत्सं द्विजसत्तम ।\nहेमरूपादिपात्रेषु कल्पितं गोमयादिभिः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002501002, "chapter_id": 22501, "verse_number": "१-१६३-३", "content_sanskrit": "नानावर्णकसंयुक्तैरक्षतैस्तिलतंदुलैः ।\nस्वच्छैश्च दधिसंमिश्रैर्यथाशोभं प्रपूरितैः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002501003, "chapter_id": 22501, "verse_number": "१-१६३-४", "content_sanskrit": "द्रव्यपीठप्रदीपाश्च भूताश्वत्थादिपल्लवैः ।\nऔषधीभिश्च मेध्याभिः सर्वबीजैर्यवादिभिः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002501004, "chapter_id": 22501, "verse_number": "१-१६३-५", "content_sanskrit": "सप्तम्यादिषु सर्वेषु षष्ठ्यादिषु विशेषतः ।\nशंखभेर्यादिभिः कुर्याद्वाद्यघोषं सुशोभनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002501005, "chapter_id": 22501, "verse_number": "१-१६३-६", "content_sanskrit": "त्रिसन्ध्यं वेदनिर्घोषं कुर्वीत फलमुत्तमम् ।\nकुर्यान्नीराजनं चैव शंखवादित्रमंगलैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002501006, "chapter_id": 22501, "verse_number": "१-१६३-७", "content_sanskrit": "यावन्नीराजनं कुर्यात्पर्वाणि विधिवद्रवौ ।\nतावद्युगसहस्राणि सूरलोके महीयते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002501007, "chapter_id": 22501, "verse_number": "१-१६३-८", "content_sanskrit": "कपिलापञ्चगव्येन कुशवारियुतेन वै ।\nस्नापयेन्मन्त्रपूतेन ब्रह्मस्नानं हि तत्स्मृतम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002501008, "chapter_id": 22501, "verse_number": "१-१६३-९", "content_sanskrit": "यस्त्वेकमपि सर्वेब्दे ब्रह्मस्नानं प्रयच्छति ।\nस मुक्तः सर्वपापैस्तु सूर्यलोके महीयते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002501009, "chapter_id": 22501, "verse_number": "१-१६३-१०", "content_sanskrit": "कपिलापञ्चगव्येन दधिक्षीरयुतेन च ।\nस्नानं दशगुणं ज्ञेयं महत्पुण्यं नराधिप ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002501010, "chapter_id": 22501, "verse_number": "१-१६३-११", "content_sanskrit": "ऋभवो वीरमुद्दिश्य देहशुद्धिं च शाश्वतीम् ।\nकपिलामाहरेन्नित्यं मुनिदेवाग्निनिर्मिताम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002501011, "chapter_id": 22501, "verse_number": "१-१६३-१२", "content_sanskrit": "कापिलं यः पिबेच्छूद्रो देवकार्यार्थनिर्मितम् ।\nस पच्यते महाघोरे सुचिरं नरकार्णवे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002501012, "chapter_id": 22501, "verse_number": "१-१६३-१३", "content_sanskrit": "वर्षकोटिसहस्रेण यत्पापं समुपार्जितम् ।\nघृताभ्यंगेन सूर्यस्य दहेत्सर्वं न संशयः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002501013, "chapter_id": 22501, "verse_number": "१-१६३-१४", "content_sanskrit": "कल्पकोटिसहस्रैस्तु यत्पापं समुपार्जितम् ।\nवज्रस्नानेन तत्सर्वं दहत्यग्निरिवेंधनम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002501014, "chapter_id": 22501, "verse_number": "१-१६३-१५", "content_sanskrit": "सप्तम्यां च कृतस्नानो यजेत्सूर्यं सकृन्नरः ।\nकुलान्युद्धृत्य सप्तेह सूर्यलोके महीयते ।\nवसुहेमादियुक्तं च क्षीरस्नानस्य तत्समम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002501015, "chapter_id": 22501, "verse_number": "१-१६३-१६", "content_sanskrit": "सकृदाढकेन पयसा यो भानुं स्नाप येन्नरः ।\nराजतेन विमानेन सोऽर्कलोके महीयते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002501016, "chapter_id": 22501, "verse_number": "१-१६३-१७", "content_sanskrit": "स्नाप्य दध्ना सकृद्भानुं स त्रिलोके महीयते ।\nमधुना स्नपयित्वा तं शुक्रलोके मही यते ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002501017, "chapter_id": 22501, "verse_number": "१-१६३-१८", "content_sanskrit": "उद्धृत्य शालिपिष्टेन वायुलोकेषु पूज्यते ।\nस्नानमिक्षुरसेनेह यः सूर्ये सकृदाचरेत् ।\nस गोपतिपुरं गच्छेत्सर्वकामसमन्वितः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002501018, "chapter_id": 22501, "verse_number": "१-१६३-१९", "content_sanskrit": "फलोदकेन यो भानुं सकृत्स्नापयते नरः ।\nउत्सृज्य पापकलिलं पितृलोके महीयते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002501019, "chapter_id": 22501, "verse_number": "१-१६३-२०", "content_sanskrit": "श्रीखंडवारिणा स्नाप्य सकृद्भानुं नरा धिप ।\nचंद्रांशुनिर्मलः श्रीमांश्चरेदात्रेयमंदिरे ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002501020, "chapter_id": 22501, "verse_number": "१-१६३-२१", "content_sanskrit": "वस्त्रपूतेन तोयेन यद्यर्कं स्नापयेत्सकृत् ।\nस सर्वकामतृप्तात्मा राकाधिपपुरं व्रजेत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002501021, "chapter_id": 22501, "verse_number": "१-१६३-२२", "content_sanskrit": "आपो हिष्ठेति जप्येन गंगातोयेन भारत ।\nगैरिकेण विमानेन ब्रह्मलोके महीयते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002501022, "chapter_id": 22501, "verse_number": "१-१६३-२३", "content_sanskrit": "कर्पूरागुरुतोयेन योऽर्कं स्नापयते सकृत् ।\nस्नाप्य भानुं सकृन्मन्त्रैः सप्तम्यां समुपोषितः ।\nस कुलानेकविंशतिमुत्तार्य रविमाव्रजेत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002501023, "chapter_id": 22501, "verse_number": "१-१६३-२४", "content_sanskrit": "पितृनुद्दिश्य यो भानुं स्नापयेच्छीतवारिणा ।\nतृप्ताः स्वर्ग व्रजंत्याशु पितरो नरकादपि ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002501024, "chapter_id": 22501, "verse_number": "१-१६३-२५", "content_sanskrit": "भानुं शीतांबुना स्नाप्य धारोष्णपयसा सह ।\nस्नाप्य पश्चाद्व्रतेनेशमग्निलोके महीयते ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002501025, "chapter_id": 22501, "verse_number": "१-१६३-२६", "content_sanskrit": "एतत्स्नानत्रयं कृत्वा पूजयित्वा तु भारत ।\nअश्वमेधसहस्रस्य फलं प्राप्नोति मानवः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002501026, "chapter_id": 22501, "verse_number": "१-१६३-२७", "content_sanskrit": "मृत्कुम्भात्ताम्रकुम्भैस्तु स्नानं शतगुणं मतम् ।\nरौप्यैः पादोत्तरं पुण्यं दर्शनात्स्पर्शनं परम् ।\nस्पर्शनादर्चनं श्रेष्ठं घृतस्नानमतः परम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002501027, "chapter_id": 22501, "verse_number": "१-१६३-२८", "content_sanskrit": "इहामुत्र कृतं पापं घृतस्नानेन नश्यति ।\nसप्तजन्म कृतं पापं पुराणश्रवणेन तु ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002501028, "chapter_id": 22501, "verse_number": "१-१६३-२९", "content_sanskrit": "दशापराधांस्तोयेन क्षीरेण तु शतं क्षमेत् ।\nसहस्रं क्षमते दध्ना घृतेनाप्ययुतं क्षमेत् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002501029, "chapter_id": 22501, "verse_number": "१-१६३-३०", "content_sanskrit": "नैरन्तर्येण यो मासं घृतस्नानं समाचरेत् ।\nदशैकादश कुलानीह नयेत्सूर्यस्य मंदिरम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002501030, "chapter_id": 22501, "verse_number": "१-१६३-३१", "content_sanskrit": "स्नानं पलशतं ज्ञेयमभ्यंगः पञ्चविंशतिः ।\nपलानां द्विसहस्रेण महास्नानमति श्रुतिः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002501031, "chapter_id": 22501, "verse_number": "१-१६३-३२", "content_sanskrit": "घृताभ्यंगं घृतस्नान भानोः कुर्य्याद्द्विजोत्तम ।\nयश्च गोधूमचूर्णैस्तु कषायैर्दर्भसंमितैः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002501032, "chapter_id": 22501, "verse_number": "१-१६३-३३", "content_sanskrit": "दशधेनुसहस्राणि यद्दत्त्वा लभते फलम् ।\nतत्फलं लभते सर्वमर्कस्योद्वर्तने कृते ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002501033, "chapter_id": 22501, "verse_number": "१-१६३-३४", "content_sanskrit": "अर्घ्यं पुष्पफलोपेतं यस्त्वर्काय निवेदयेत् ।\nस पूज्यः सर्वलोकेषु अर्कवन्मोदते दिवि ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002501034, "chapter_id": 22501, "verse_number": "१-१६३-३५", "content_sanskrit": "गंधतोयेन संमिश्रमुदकाद्द्वादशोत्तरम् ।\nपञ्चगव्यसमायुक्तमर्घ्यं शतगुणं नृप ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002501035, "chapter_id": 22501, "verse_number": "१-१६३-३६", "content_sanskrit": "योष्टांगगर्भमापूर्य भानोर्मूर्ध्नि निवेदयेत् ।\nदशवर्षसहस्राणि रमते चार्कमंदिरे ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002501036, "chapter_id": 22501, "verse_number": "१-१६३-३७", "content_sanskrit": "आपः क्षीरं कुशाग्राणि घृतं दधि तथा मधु ।\nरक्तानि करवीराणि तथा रक्तं च चन्द नम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002501037, "chapter_id": 22501, "verse_number": "१-१६३-३८", "content_sanskrit": "अष्टांग एष अर्घो वै ब्रह्मणा परिकीर्तितः ।\nसततं प्रीतिजननो भास्करस्य नराधिप ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002501038, "chapter_id": 22501, "verse_number": "१-१६३-३९", "content_sanskrit": "दातुर्वैणवपात्रेण दत्तेऽर्घ्ये यत्फलं भवेत् ।\nतस्माच्छतगुणं पुण्यं मृत्पात्रेण नराधिप ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002501039, "chapter_id": 22501, "verse_number": "१-१६३-४०", "content_sanskrit": "ताम्रार्घ्यपात्रदानेन पुण्यं शतगुणं मतम् ।\nपालाशपद्मपत्राभ्यां ताम्रपात्रे फलं लभेत् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002501040, "chapter_id": 22501, "verse_number": "१-१६३-४१", "content_sanskrit": "रौप्यपात्रेण विज्ञेयं लक्षार्घ्यं नात्र संशयः ।\nसुवर्णपात्रविन्यस्तमर्घ्यं कोटिगुणं भवेत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002501041, "chapter_id": 22501, "verse_number": "१-१६३-४२", "content_sanskrit": "एवं स्नानार्घ्यनैवेद्यबलिधूपादिषु क्रमात् ।\nपात्रांतरविशेषेण तत्फलं तूत्तरोत्तरम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002501042, "chapter_id": 22501, "verse_number": "१-१६३-४३", "content_sanskrit": "रौप्यपात्रप्रदानेन यत्पुण्यं वेदपारगे ।\nताम्रपात्रप्रदानेन तस्माच्छतगुणं रवौ ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002501043, "chapter_id": 22501, "verse_number": "१-१६३-४४", "content_sanskrit": "फलं कोटिसुवर्णस्य यो दद्याद्वेदपारगे ।\nसूर्याय रूप्यपात्रे तु भवेत्पुण्यं ततोऽधिकम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002501044, "chapter_id": 22501, "verse_number": "१-१६३-४५", "content_sanskrit": "सुवर्णपात्रं यो दद्याद्भास्कराय महीपते ।\nन शक्यं तस्य तद्वक्तुं पुण्यं पात्रविशेषतः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002501045, "chapter_id": 22501, "verse_number": "१-१६३-४६", "content_sanskrit": "तुल्यमेव फलं प्रोक्तं सर्वमाढ्यदरिद्रयोः ।\nतयोरभ्यधिकं तस्य यस्त्वर्के भावनाधिकः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002501046, "chapter_id": 22501, "verse_number": "१-१६३-४७", "content_sanskrit": "विभवे सति यो मोहान्न कुर्याद्विधिविस्तरम् ।\nनैव तत्फलमाप्नोति प्रलोभाक्रांतमानसः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002501047, "chapter_id": 22501, "verse_number": "१-१६३-४८", "content_sanskrit": "तस्मान्मन्त्रैः फलैस्तोयैश्चन्दनाद्यैश्च यत्नतः ।\nतदनंतफलं ज्ञेयं भक्तिरेवात्र कारणम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002501048, "chapter_id": 22501, "verse_number": "१-१६३-४९", "content_sanskrit": "वर्षकोटिशतं दिव्यं सूर्यलोके महीयते ।\nगंधानुलेपनं पुण्यं द्विगुणं चन्दनस्य तु ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002501049, "chapter_id": 22501, "verse_number": "१-१६३-५०", "content_sanskrit": "गंधाच्चतुर्गुणं ज्ञेयं पुष्पमष्टगुणं नृप ।\nकृष्णागुरु विशेषेण द्विगुणं फलमादिशेत ।\nतस्माच्छतगुणं पुण्यं कुंकुमस्य विधीयते ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002501050, "chapter_id": 22501, "verse_number": "१-१६३-५१", "content_sanskrit": "चंदनागुरुकर्पूरैः श्लक्ष्णपिष्टैः सकुंकुमैः ।\nभानुं पर्याप्तमालिप्य कल्पकोटिं वसेद्दिवि ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002501051, "chapter_id": 22501, "verse_number": "१-१६३-५२", "content_sanskrit": "स दीव्येत्सुरवृन्देन पुण्यगंधैः प्रलेपितः ।\nदशवर्षसहस्राणि वीर मित्रपुरे वसेत् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002501052, "chapter_id": 22501, "verse_number": "१-१६३-५३", "content_sanskrit": "भक्त्या निवेद्य अर्काय तालवृंतं नराधिप ।\nदशवर्षसहस्राणि वीरलोकं महीयते ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002501053, "chapter_id": 22501, "verse_number": "१-१६३-५४", "content_sanskrit": "मायूरं व्यजनं दत्त्वा सूर्यायातीव शोभनम् ।\nवर्षकोटिशतं पूर्णं प्रभंजनपुरे वसेत् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002501054, "chapter_id": 22501, "verse_number": "१-१६३-५५", "content_sanskrit": "पुष्पैररण्यसंभूतैः पत्रैर्वा गिरिसम्भवैः ।\nअपर्युषितनिश्छिद्रैः प्रोषितैर्जंतुवर्जितैः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002501055, "chapter_id": 22501, "verse_number": "१-१६३-५६", "content_sanskrit": "आत्मारामभवैश्चैव पुष्पैः संपूजयेद्रविम् ।\nपुष्पजातिविशेषेण भवेत्पुण्यं ततोऽधिकम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002501056, "chapter_id": 22501, "verse_number": "१-१६३-५७", "content_sanskrit": "तपःशीलगुणोपेत इति हासविदि द्विजे ।\nदत्त्वा दश सुवर्णस्य निष्कान्यल्लभते फलम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002501057, "chapter_id": 22501, "verse_number": "१-१६३-५८", "content_sanskrit": "करवीरस्य कुसुममर्काय विनिवेदयेत् ।\nलभते तत्फलं वीर यथाह भगवान्रविः ।\nएवं पुष्पविशेषेण फलं तदधिकं भवेत् ।\nज्ञेयं पुण्यं रसज्ञेन यथा स्यात्तन्निबोध मे ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002501058, "chapter_id": 22501, "verse_number": "१-१६३-५९", "content_sanskrit": "सदा पुष्पसहस्रेभ्यः करवीरं विशिष्यते ।\nबिल्वपत्रसहस्रेभ्यः पद्ममेकं नराधिप ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002501059, "chapter_id": 22501, "verse_number": "१-१६३-६०", "content_sanskrit": "पद्मपुष्पसहस्रेभ्यो बकपुष्पं विशिष्यते ।\nबकपुष्पसहस्रेभ्यो मुद्गरं परमुच्यते ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002501060, "chapter_id": 22501, "verse_number": "१-१६३-६१", "content_sanskrit": "कुशपुष्पसहस्रेभ्यः शमीपत्रं विशिष्यते ।\nशमीपुष्पसहस्रेभ्यो नृप नीलोत्पलं परम् ।\nसर्वासां पुष्पजातीनां प्रवरं नीलमुत्पलम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002501061, "chapter_id": 22501, "verse_number": "१-१६३-६२", "content_sanskrit": "रक्तोत्पलसहस्रेण नीलोत्पलशतेन च ।\nरक्तैश्च करवीरैश्च यस्तु पूजयते रविम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002501062, "chapter_id": 22501, "verse_number": "१-१६३-६३", "content_sanskrit": "कल्पकोटिसहस्राणि कल्पकोटिशतानि च ।\nवसेदर्कपुरे श्रीमान्सूर्यतुल्यपराक्रमः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002501063, "chapter_id": 22501, "verse_number": "१-१६३-६४", "content_sanskrit": "शेषाणां पुष्पजातीनां यत्फलं परिकीर्तितम् ।\nतत्फलस्यानुसारेण सूर्यलोके महीयते ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002501064, "chapter_id": 22501, "verse_number": "१-१६३-६५", "content_sanskrit": "शमीपुष्पं बृहत्याश्च कुसुमं तुल्यमुच्यते ।\nकरवीरसमा ज्ञेया जातीविजयपाटलाः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002501065, "chapter_id": 22501, "verse_number": "१-१६३-६६", "content_sanskrit": "श्वेतमंदारकुसुमं सितपुष्पं च तत्समम् ।\nनलचंपकपुन्नागमुद्गराणां समाः स्मृताः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002501066, "chapter_id": 22501, "verse_number": "१-१६३-६७", "content_sanskrit": "गंधवंत्यपवित्राणि कुसुमानि विवर्जयेत् ।\nगंधहीनमपि ग्राह्यं पवित्रं यत्कुशादिकम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002501067, "chapter_id": 22501, "verse_number": "१-१६३-६८", "content_sanskrit": "सात्त्विकं तद्धि कुसुममपवित्रं च तामसम् ।\nमुद्गराणि कदंबानि रात्रौ देयानि सूरये ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7002501068, "chapter_id": 22501, "verse_number": "१-१६३-६९", "content_sanskrit": "दिवाशेषाणि पुष्पाणि त्यजेदुपहतानि च ।\nमुकुलैर्मार्चयेद्भानुमपक्वं न निवेदयेत् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7002501069, "chapter_id": 22501, "verse_number": "१-१६३-७०", "content_sanskrit": "फलं क्वथितविद्धं च यत्नात्पक्वमपि त्यजेत् ।\nअलाभे बत पुष्पाणां पत्राण्यपि निवेदयेत् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7002501070, "chapter_id": 22501, "verse_number": "१-१६३-७१", "content_sanskrit": "पत्राणामप्यलाभे तु फलान्यपि निवेदयेत् ।\nफलानामप्यलाभेन तृणगुल्मौषधीरपि ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7002501071, "chapter_id": 22501, "verse_number": "१-१६३-७२", "content_sanskrit": "ओषधीनामभावे तु भक्त्या भवति पूजितः ।\nप्रत्येकं मुक्तपुष्पेण दशसौवर्णिकं फलम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7002501072, "chapter_id": 22501, "verse_number": "१-१६३-७३", "content_sanskrit": "यः सुगन्धैर्मुक्तपुष्पैः सम्यग्भानुं प्रपूजयेत् ।\nमाघासितेऽपि सुमनाः सोऽनंतफलमश्नुते ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7002501073, "chapter_id": 22501, "verse_number": "१-१६३-७४", "content_sanskrit": "करवीरैर्महाराज संयतो भानुमर्चयेत् ।\nसर्वपापविनिर्मुक्तः सूर्यलोके महीयते ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7002501074, "chapter_id": 22501, "verse_number": "१-१६३-७५", "content_sanskrit": "अगस्त्यकुसुमैर्भक्त्या यः सकृद्भानुमर्चयेत् ।\nगवां प्रयुतदानस्य फलं प्राप्य दिवं व्रजेत् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7002501075, "chapter_id": 22501, "verse_number": "१-१६३-७६", "content_sanskrit": "मल्लिकोत्पलपद्मैश्च जातीपुन्नागचंपकैः ।\nअशोकश्वेतमंदारकर्णिकारांधुकैस्तथा ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7002501076, "chapter_id": 22501, "verse_number": "१-१६३-७७", "content_sanskrit": "करवीरार्ककह्लारशमीतगरकेशरैः ।\nअगस्तिबकपुष्पैस्तु शतपत्रैर्नराधिप ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7002501077, "chapter_id": 22501, "verse_number": "१-१६३-७८", "content_sanskrit": "पुष्पैरेतैर्यथालाभं यो नरः पूजयेद्रविम् ।\nस तत्फलमवाप्नोति तदेकाग्रमनाः शृणु ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7002501078, "chapter_id": 22501, "verse_number": "१-१६३-७९", "content_sanskrit": "सूर्यकोटिप्रतीकाशैर्विमानैः सर्वकामिभिः ।\nपुष्पमालापरिक्षिप्तैर्गीतवादित्रनादितैः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7002501079, "chapter_id": 22501, "verse_number": "१-१६३-८०", "content_sanskrit": "तंत्रीमधुरवाद्यैश्च स्वच्छंदगमनैर्नृप ।\nसूर्यकन्यासमाकीर्णैर्देवानां च सुदुर्लभैः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7002501080, "chapter_id": 22501, "verse_number": "१-१६३-८१", "content_sanskrit": "दोधूयमानश्चमरैः स्तूयमानः सुरासुरैः ।\nगच्छेदर्कपुरीं दिव्यां तत्र संपूजितो भवेत् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7002501081, "chapter_id": 22501, "verse_number": "१-१६३-८२", "content_sanskrit": "यैस्तैश्च वापिकुसुमैर्जलजैः स्थलजैर्नृप ।\nसंपूज्य श्रद्धया भानुमर्कलोके महीयते ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7002501082, "chapter_id": 22501, "verse_number": "१-१६३-८३", "content_sanskrit": "सूर्यस्योपरि यः कुर्याच्छोभनं पुष्पमंडलम् ।\nशोभितं पुष्पस्रग्दामैरापीठांतं प्रलंबितैः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7002501083, "chapter_id": 22501, "verse_number": "१-१६३-८४", "content_sanskrit": "अत्याश्चर्यमहायानैर्दिव्यपुष्पोपशोभितः ।\nसर्वेषामुपरिष्टाच्च वसेदर्कपुरे सुखी ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7002501084, "chapter_id": 22501, "verse_number": "१-१६३-८५", "content_sanskrit": "अनेकरागविन्यस्तैः सुगन्धैः कुसुमैर्गृहम् ।\nयः कुर्यात्पर्वकाले तु विचित्रकुसुमोज्ज्वलम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7002501085, "chapter_id": 22501, "verse_number": "१-१६३-८६", "content_sanskrit": "स पुष्पकविमानेन पुष्पमालाकुलेन तु ।\nपुष्पेतरपुरं दिव्यं श्रयते नात्र संशयः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7002501086, "chapter_id": 22501, "verse_number": "१-१६३-८७", "content_sanskrit": "अक्षयं मोदते कालमतिरस्कृतशासनः ।\nसौरादिसर्वलोकेषु यत्रेष्टं तत्र याति सः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}]