[{"id": 7004210000, "chapter_id": 24210, "verse_number": "५-१-५९-१", "content_sanskrit": "सनत्कुमार उवाच ।\nततः सुरगणाः सर्वे धूतपापा समाहिताः ।\nपुनर्योगबलं प्राप्य स्वाधिकारं ययुः पुरा॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004210001, "chapter_id": 24210, "verse_number": "५-१-५९-२", "content_sanskrit": "एवं व्यास गयातीर्थं कुमुद्वत्यां सुनिश्चित म् ।\nगयायां यानि तीर्थानि पुण्यान्यायतनानि च॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004210002, "chapter_id": 24210, "verse_number": "५-१-५९-३", "content_sanskrit": "तत्तीर्थेषु नरः स्नात्वा तत्तत्तीर्थफलं भवेत् ।\nतथैव च गयाक्षेत्रं गयाश्राद्ध फलप्रदम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004210003, "chapter_id": 24210, "verse_number": "५-१-५९-४", "content_sanskrit": "फल्गुश्च सरितां श्रेष्ठा तथैव फलदायिनी ।\nआदिगया बुद्धगया तथा विष्णुपदी स्मृता॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004210004, "chapter_id": 24210, "verse_number": "५-१-५९-५", "content_sanskrit": "गयाकोष्ठस्तथा प्रोक्तो गदाधरपदानि च ।\nवेदिका षोडशी प्रोक्ता तथैव चाक्षयो वटः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004210005, "chapter_id": 24210, "verse_number": "५-१-५९-६", "content_sanskrit": "प्रेतमुक्तिकरी नित्यं शिला चोक्ता तथैव च ।\nअच्छोदा निम्नगा प्रोक्ता पितॄणां चाश्रमोत्तमः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004210006, "chapter_id": 24210, "verse_number": "५-१-५९-७", "content_sanskrit": "देवानां दानवानां च यक्षकिन्नररक्षसाम् ।\nपन्नगानां च सर्वेषां तथैवाश्रम उत्तमः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004210007, "chapter_id": 24210, "verse_number": "५-१-५९-८", "content_sanskrit": "एतत्स्थानेषु सर्वेषु स्नानदानादिकाः क्रियाः ।\nश्राद्धं च विधिवद्देयं तत्तत्तीर्थफलं लभेत्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004210008, "chapter_id": 24210, "verse_number": "५-१-५९-९", "content_sanskrit": "गयायां पितृरूपेण स्वयमेव जनार्दनः ।\nतं ध्यात्वा पुंडरीकाक्षं मुच्यते च ऋणत्रयात्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004210009, "chapter_id": 24210, "verse_number": "५-१-५९-१०", "content_sanskrit": "एवं व्यास गयातीर्थं पुरावन्त्यां प्रतिष्ठितम् ।\nपश्चात्तु कैकटे जातं यत्र संनिहितोऽसुरः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004210010, "chapter_id": 24210, "verse_number": "५-१-५९-११", "content_sanskrit": "तदारभ्य द्विजश्रेष्ठ गया तत्र प्रतिष्ठिता ।\nगदाधरपदाघातैर्महासुरो निपातितः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004210011, "chapter_id": 24210, "verse_number": "५-१-५९-१२", "content_sanskrit": "तत्पदे च महिमानं जनार्दनसमर्पितम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004210012, "chapter_id": 24210, "verse_number": "५-१-५९-१३", "content_sanskrit": "पंचक्रोशं गयाक्षेत्रं क्रोशमेकं गयाशिरः ।\nयत्र तत्र करिष्यामि पितॄणां दत्तमक्षयम् ।\nसर्वदा सर्वकालेषु गयाश्राद्धं विधीयते॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004210013, "chapter_id": 24210, "verse_number": "५-१-५९-१४", "content_sanskrit": "संवत्सरे परं व्यास दिनमेकं प्रतिष्ठितम् ।\nकन्यास्थे च दिवा नाथे हस्तनक्षत्रसंयुते ।\nमहालयेति तत्प्रोक्तं पितॄणां दत्तमक्षयम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004210014, "chapter_id": 24210, "verse_number": "५-१-५९-१५", "content_sanskrit": "सर्वदा सर्वकालेषु गयाश्राद्धं विधीयते॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004210015, "chapter_id": 24210, "verse_number": "५-१-५९-१६", "content_sanskrit": "संवत्सरे परं व्यास दिनमेकं प्रतिष्ठितम् ।\nअन्वष्टकायां कुर्वंति मातॄणां श्राद्धमुत्तमम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004210016, "chapter_id": 24210, "verse_number": "५-१-५९-१७", "content_sanskrit": "अक्षय्या जायते तृप्तिः पितॄणां कल्पसंख्यया ।\nएवं व्यास पुरी रम्या स्नानदा नादिकर्मसु॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004210017, "chapter_id": 24210, "verse_number": "५-१-५९-१८", "content_sanskrit": "भूयस्तु संप्रवक्ष्यामि माहात्म्यं परमाद्भुतम् ।\nतच्छृणुष्व मया ख्यातं पवित्रं पापनाशनम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004210018, "chapter_id": 24210, "verse_number": "५-१-५९-१९", "content_sanskrit": "सप्तर्षीणां च या भार्या ऋषिपत्न्यः पतिव्रताः ।\nस्वाहादोषपरिभ्रष्टा दूषिताः पावकेन च॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004210019, "chapter_id": 24210, "verse_number": "५-१-५९-२०", "content_sanskrit": "ऋषिभिश्च परित्यक्ता बभ्रमुश्च वनाद्वनम् ।\nएवं बहुतिथे काले नारदो देवदर्शनः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004210020, "chapter_id": 24210, "verse_number": "५-१-५९-२१", "content_sanskrit": "तासां च प्रियमन्विच्छन्समायातो वनांतरे ।\nताभिश्च सत्कृतो नित्यं समासीनो धृतव्रतः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004210021, "chapter_id": 24210, "verse_number": "५-१-५९-२२", "content_sanskrit": "उवाच श्लक्ष्णया वाचा देशकालोचितं वचः ।\nकिमिदं विकृतं जातं भवतीनां पराभवः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004210022, "chapter_id": 24210, "verse_number": "५-१-५९-२३", "content_sanskrit": "कस्माच्च ऋषिभिस्त्यक्ता लोकमातरः पतिव्रताः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004210023, "chapter_id": 24210, "verse_number": "५-१-५९-२४", "content_sanskrit": "ऋषिपत्न्य ऊचुः ।\nन जानीमो वयं तात येन दोषेण तापसैः ।\nविमुक्ताः साग्निकैः क्षिप्रं कार्तिकेयप्रसंगतः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004210024, "chapter_id": 24210, "verse_number": "५-१-५९-२५", "content_sanskrit": "लोकापवादजं किंचिज्जातं दिष्टवशादधम् ।\nकिं कुर्मो वा क्व गच्छामः किं तपः का च देवता॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004210025, "chapter_id": 24210, "verse_number": "५-१-५९-२६", "content_sanskrit": "यस्याराधनपुण्येन पतिसांनिध्यमाप्नुयुः ।\nएतन्निश्चित्य भो ब्रह्मन्ब्रूहि त्वं वेदतत्त्वतः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004210026, "chapter_id": 24210, "verse_number": "५-१-५९-२७", "content_sanskrit": "इति पृष्टस्तदा ताभिरृषिपत्नीभिर्नारदः ।\nउवाच सुचिरं ध्यात्वा तासां स शर्महेतवे॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004210027, "chapter_id": 24210, "verse_number": "५-१-५९-२८", "content_sanskrit": "नारद उवाच ।\nश्रूयतां भोस्तपःश्रेष्ठा भवतीनां च कारणम् ।\nमहाकालवने रम्ये गयातीर्थमनुत्तमम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004210028, "chapter_id": 24210, "verse_number": "५-१-५९-२९", "content_sanskrit": "तत्रैव चाक्षयो नाम न्यग्रोधः शाखिनां वरः ।\nतत्रागमनमात्रेण धूतदोषा भविष्यथ॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004210029, "chapter_id": 24210, "verse_number": "५-१-५९-३०", "content_sanskrit": "सर्वदोषहरं तीर्थं सर्वकामवरप्रदम् ।\nसर्वसौख्यकरं पुण्यं तत्र गच्छत मा चिरम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004210030, "chapter_id": 24210, "verse_number": "५-१-५९-३१", "content_sanskrit": "नारदस्य वचः श्रुत्वा ऋषिपन्त्यः सुचोदिताः ।\nमहाकालवने व्यास इच्छंत्यः प्रियमात्मनः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004210031, "chapter_id": 24210, "verse_number": "५-१-५९-३२", "content_sanskrit": "आजग्मुस्तद्वनं तत्र यत्र तीर्थं गयाभिधम् ।\nतत्र गत्वा शुचीभूय स्नानदानादिकाः क्रियाः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004210032, "chapter_id": 24210, "verse_number": "५-१-५९-३३", "content_sanskrit": "कृतास्ताभिश्च पुण्याभिर्नभस्यस्यासितेतरे ।\nपञ्चम्यामृषिसंज्ञायां ताभिः सुचरितं व्रतम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004210033, "chapter_id": 24210, "verse_number": "५-१-५९-३४", "content_sanskrit": "उपोष्य चैकरात्रं तु जागरं चैव योगतः ।\nकृतमात्रे व्रते व्यास धूतपापा बभुः क्षणात्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004210034, "chapter_id": 24210, "verse_number": "५-१-५९-३५", "content_sanskrit": "भर्तृकोपपरिभ्रष्टाः सद्यः प्राप्ता गृहाश्रमम् ।\nऋषिभिः साग्निकं दत्तं पूर्ववदृषिसत्तम॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004210035, "chapter_id": 24210, "verse_number": "५-१-५९-३६", "content_sanskrit": "तदाप्रभृति लोकेस्मिन्पंचमी ऋषिसंज्ञिता ।\nये नराश्चाथ नार्यो यास्तां कुर्वन्ति तु भक्तिः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004210036, "chapter_id": 24210, "verse_number": "५-१-५९-३७", "content_sanskrit": "नीवाराहारकं कृत्वा शुचीभूय समाहिताः ।\nन तेषां जायते किंचिदापद्दुःखं कदाचन ।\nदुर्भगत्वं च नारीणां न वियोगश्च मातृभिः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004210037, "chapter_id": 24210, "verse_number": "५-१-५९-३८", "content_sanskrit": "पुत्रतो धनतो वापि कदाचित्संभविष्यति ।\nएवं व्यास समाख्यातं यत्त्वया परिपृच्छितम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004210038, "chapter_id": 24210, "verse_number": "५-१-५९-३९", "content_sanskrit": "अवंत्यामीदृशं तीर्थं वर्तते भुवि सत्तम ।\nतादृशं पुण्यदं किंचिन्नास्ति ब्रह्मांडगोलके॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004210039, "chapter_id": 24210, "verse_number": "५-१-५९-४०", "content_sanskrit": "अस्मिंस्तीर्थे नरः कश्चिन्महा दानानि चेच्चरेत् ।\nअक्षयाणि भवंत्यस्य विष्णुलोके महीयते॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004210040, "chapter_id": 24210, "verse_number": "५-१-५९-४१", "content_sanskrit": "यो वै नियमवान्भूत्वा कथामेतां शृणोति वा ।\nपठेच्च सततं व्यास हय मेधफलं लभेत्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]