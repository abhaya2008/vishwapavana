[{"id": 2047697, "chapter_id": 2055, "verse_number": "६-१०४-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2047698, "chapter_id": 2055, "verse_number": "६-१०४-१", "content_sanskrit": "अर्जुनस्तान्नरव्याघ्रः सुशर्मानुचरान्नृपान् ।\nअनयत्प्रेतराजस्य सदनं सायकैः शितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2047699, "chapter_id": 2055, "verse_number": "६-१०४-२", "content_sanskrit": "सुशर्मापि ततो बाणैः पार्थं विव्याध संयुगे।\nवासुदेवं च सप्तत्या पार्थं च नवभिः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2047700, "chapter_id": 2055, "verse_number": "६-१०४-३", "content_sanskrit": "तं निवार्य शरौघेण सक्रुसूनुर्महारथः ।\nसुशर्मणो रणे योधान्प्राहिणोद्यमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2047701, "chapter_id": 2055, "verse_number": "६-१०४-४", "content_sanskrit": "ते वध्यमानाः पार्थेन कालेनेव युगक्षये।\nव्यद्रवन्त रणे राजन्भये जाते महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2047702, "chapter_id": 2055, "verse_number": "६-१०४-५", "content_sanskrit": "उत्सृज्य तुरगान्केचिद्रथान्केचिच्च मारिष।\nगजानन्ये समुत्सृज्य प्राद्रवन्त दिशो दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2047703, "chapter_id": 2055, "verse_number": "६-१०४-६", "content_sanskrit": "अपरे तु तदादाय वाजिनागरथान्रणे ।\nत्वरया परया युक्ताः प्राद्रवन्त विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2047704, "chapter_id": 2055, "verse_number": "६-१०४-७", "content_sanskrit": "पादाताश्चापि शस्त्राणि समुत्सृज्य महारणे ।\nनिरपेक्षा व्यधावन्त तेनतेन स्म भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2047705, "chapter_id": 2055, "verse_number": "६-१०४-८", "content_sanskrit": "वार्यमाणाः सुबहुशस्त्रैगर्तेन सुशर्मणा ।\nतथान्यैः पार्थिवश्रेष्ठैर्न व्यतिष्ठन्त संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2047706, "chapter_id": 2055, "verse_number": "६-१०४-९", "content_sanskrit": "तद्बलं प्रद्रुतं दृष्ट्वा पुत्रो दुर्योधनस्तव।\nपुरस्कृत्य रणे भीष्मं सर्वसैन्यपुरस्कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2047707, "chapter_id": 2055, "verse_number": "६-१०४-१०", "content_sanskrit": "सर्वोद्योगेन महता धनञ्जयमुपाद्रवत् ।\nत्रिगर्ताधिपतेरर्थे जीवितस्य विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2047708, "chapter_id": 2055, "verse_number": "६-१०४-११", "content_sanskrit": "स एकः समरे तस्थौ किरन्बहुविधाञ्शरान्।\nभ्रातृभिः सहितः सर्वैः शेषा हि प्रद्रुता नराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2047709, "chapter_id": 2055, "verse_number": "६-१०४-१२", "content_sanskrit": "तथैव पाण्डवा राजन्सर्वोद्योगेन दंशिताः।\nप्रययुः फल्गुनार्थाय यत्र भीष्मो व्यतिष्ठत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2047710, "chapter_id": 2055, "verse_number": "६-१०४-१३", "content_sanskrit": "ज्ञायमाना रणे वीर्यं घोरं गाण्डीवधन्वनः।\nहाहाकारकृतोत्साहा भीष्मं जग्मुः समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2047711, "chapter_id": 2055, "verse_number": "६-१०४-१४", "content_sanskrit": "ततस्तालध्वजः शूरः पाण्डवानां वरूथिनीम्।\nछादयामास समरे शरैः सन्नतपर्वभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2047712, "chapter_id": 2055, "verse_number": "६-१०४-१५", "content_sanskrit": "एकीभूतास्ततः सर्वे कुरवः सह पाण्डवैः ।\nअयुध्यन्त महाराज मध्यं प्राप्ते दिवाकरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2047713, "chapter_id": 2055, "verse_number": "६-१०४-१६", "content_sanskrit": "सात्यकिः कृतवर्माणं विद्ध्वा पञ्चभिराशुगैः ।\nअतिष्ठदाहवे शूरः किरन्बाणान्सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2047714, "chapter_id": 2055, "verse_number": "६-१०४-१७", "content_sanskrit": "तथैव द्रुपदो राजा द्रोणं विद्ध्वा शितैः शरैः ।\nपुनर्विव्याध सप्तत्या सारथिं चास्य पञ्चभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2047715, "chapter_id": 2055, "verse_number": "६-१०४-१८", "content_sanskrit": "भीमसेनस्तु राजानं बाह्लीकं प्रपितामहम् ।\nविद्ध्वा नदन्महानादं शार्दूल इव कानने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2047716, "chapter_id": 2055, "verse_number": "६-१०४-१९", "content_sanskrit": "आर्जुनिश्चित्रसेनेन विद्धो बहुभिरशुगैः ।\nअतिष्ठदाहवे शूरः किरन्बाणान्सहस्रशः।\nचित्रसेनं त्रिभिर्बाणैर्विव्याध समरे भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2047717, "chapter_id": 2055, "verse_number": "६-१०४-२०", "content_sanskrit": "समागतौ तौ तु रणे महामात्रौ व्यरोचताम्।\nयथा दिवि महाघोरौ राजन्बुधशनैश्चरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2047718, "chapter_id": 2055, "verse_number": "६-१०४-२१", "content_sanskrit": "तस्याश्वांश्चतुरो हत्वा सूतं च नवभिः शरैः।\nननाद बलवान्नादं सौभद्रः परवीरहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2047719, "chapter_id": 2055, "verse_number": "६-१०४-२२", "content_sanskrit": "हताश्वात्तु रथात्तूर्णं सोऽवप्लुत्य महारथः ।\nआरुरोह रथं तूर्णं दुर्मुखस्य विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2047720, "chapter_id": 2055, "verse_number": "६-१०४-२३", "content_sanskrit": "द्रोणश्च द्रुपदं भित्त्वा शरैः सन्नतपर्वभिः।\nसारथिं चास्य विव्याध त्वरमाणः पराक्रमी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2047721, "chapter_id": 2055, "verse_number": "६-१०४-२४", "content_sanskrit": "पीड्यमानस्ततो राजा द्रुपदो वाहिनीमुखे।\nअपायाज्जवनैरश्वैः पूर्ववैरमनुस्मरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2047722, "chapter_id": 2055, "verse_number": "६-१०४-२५", "content_sanskrit": "भीमसेनस्तु राजानं मुहूर्तादिव बाह्लिकम् ।\nव्यश्वसूतरथं चक्रे सर्वसैन्यस्य पश्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2047723, "chapter_id": 2055, "verse_number": "६-१०४-२६", "content_sanskrit": "ससंभ्रमो महाराज संशयं परमं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2047724, "chapter_id": 2055, "verse_number": "६-१०४-२७", "content_sanskrit": "अवप्लुत्य ततो वाहाद्बाह्लीकः पुरुषोत्तमः।\nआरुरह रथं तूर्णं लक्ष्मणस्य महारणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2047725, "chapter_id": 2055, "verse_number": "६-१०४-२८", "content_sanskrit": "सात्यकिः कृतवर्माणं वारयित्वा महारणे ।\nशरैर्बहुविधै राजन्नाससाद पितामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2047726, "chapter_id": 2055, "verse_number": "६-१०४-२९", "content_sanskrit": "स विद्ध्वा भारतं षष्ट्या निशितै रोमवाहिभिः।\nनृत्यन्निव रथोपस्थे विधुन्वानो महद्धनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2047727, "chapter_id": 2055, "verse_number": "६-१०४-३०", "content_sanskrit": "तस्यायसीं महाशक्तिं चिक्षेपाथ पितामहः ।\nहेमचित्रां महावेगां नागकन्योपमां शुभाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2047728, "chapter_id": 2055, "verse_number": "६-१०४-३१", "content_sanskrit": "तामापतन्तीं सहसा मृत्युकल्पां सुदुर्जयाम्।\nव्यंसयामास वार्ष्णेयो लाघवेन महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2047729, "chapter_id": 2055, "verse_number": "६-१०४-३२", "content_sanskrit": "अनासाद्य तु वार्ष्णेयं शक्तिः परमदारुणा ।\nन्यपतद्धरणीपृष्ठे महोल्केव महाप्रभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2047730, "chapter_id": 2055, "verse_number": "६-१०४-३३", "content_sanskrit": "वार्ष्णेयस्तु ततो राजन्स्वां शक्तिं कनकप्रभाम् ।\nवेगवद्गृह्य चिक्षेप पितामहरथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2047731, "chapter_id": 2055, "verse_number": "६-१०४-३४", "content_sanskrit": "वार्ष्णेयभुजवेगेन प्रणुन्ना सा महाहवे ।\nअभिदुद्राव वेगेन कालरात्रिर्यथा नरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2047732, "chapter_id": 2055, "verse_number": "६-१०४-३५", "content_sanskrit": "तामापतन्तीं सहसा द्विधा चिच्छेद भारतः ।\nक्षुरप्राभ्यां सुतीक्ष्णाभ्यांसा व्यशीर्यत मेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2047733, "chapter_id": 2055, "verse_number": "६-१०४-३६", "content_sanskrit": "छित्त्वा शक्तिं तु गाङ्गयः सात्यकिं नवभिः शरैः ।\nआजघानोरसि क्रुद्धः प्रहसञ्छत्रुकर्शनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2047734, "chapter_id": 2055, "verse_number": "६-१०४-३७", "content_sanskrit": "ततः सरथनागाश्वाः पाण्डवाः पाण्डुपूर्वज।\nपरिवब्रू रणे भीष्मं माधवत्राणकारणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2047735, "chapter_id": 2055, "verse_number": "६-१०४-३८", "content_sanskrit": "ततः प्रववृते युद्धं तुमुलं रोमहर्षणम् ।\nपाण्डवानां कुरूणां च समरे विजयैषिणाम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2047736, "chapter_id": 2055, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि नवमदिवसयुद्धे चतुरधिकशततमोऽध्यायः ॥\nMahabharata - Bhishma Parva - Chapter Footnotes\n६-१०४-७ तेनतेन पथा ॥ ६-१०४-२० महामात्रौ श्रेष्ठौ ॥ ६-१०४-२९ भारत भीष्मम् । रोमवाहिभिः रोमच्छेदकैः ॥ ६-१०४-३५ मेदिनीं प्राप्येति शेषः ॥ ६-१०४-३७ माधवः सात्यकिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]