_id": 9200, "verse_number": "22", "content_sanskrit": "मानुष्यान्नोभयंनास्तितथापितुविमृश्यताम् ॥ तदादेवासुरेयुद्धेयुष्माभिस्सहितोऽजयम् । तेमेभवन्तश्चतथासुग्रीवप्रमुखान्हरीन् ॥ परेपारेसमुद्रस्यपुरस्कृत्यनृपात्मजौ । सीतायाःपदवींप्राप्यसम्प्राप्तौवरुणालयाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40014533, "chapter_id": 9200, "verse_number": "23", "content_sanskrit": "मानुष्यान्नोभयंनास्तितथापितुविमृश्यताम् ॥ तदादेवासुरेयुद्धेयुष्माभिस्सहितोऽजयम् । तेमेभवन्तश्चतथासुग्रीवप्रमुखान्हरीन् ॥ परेपारेसमुद्रस्यपुरस्कृत्यनृपात्मजौ । सीतायाःपदवींप्राप्यसम्प्राप्तौवरुणालयाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40014534, "chapter_id": 9200, "verse_number": "24", "content_sanskrit": "मानुष्यान्नोभयंनास्तितथापितुविमृश्यताम् ॥ तदादेवासुरेयुद्धेयुष्माभिस्सहितोऽजयम् । तेमेभवन्तश्चतथासुग्रीवप्रमुखान्हरीन् ॥ परेपारेसमुद्रस्यपुरस्कृत्यनृपात्मजौ । सीतायाःपदवींप्राप्यसम्प्राप्तौवरुणालयाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40014535, "chapter_id": 9200, "verse_number": "25", "content_sanskrit": "अदेयाचयथासीतावध्यौदशरथात्मजौ । भवद्भिर्मन्त्र्यतांमन्त्रस्सुनीतंचाभिधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40014536, "chapter_id": 9200, "verse_number": "26", "content_sanskrit": "नहिशक्तिंप्रपश्यामिजगत्यन्यस्यकस्यचित् । सागरंवानरैस्तीर्वानिश्चयेनजयोमम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40014537, "chapter_id": 9200, "verse_number": "27", "content_sanskrit": "तस्यकामपरीतस्यनिशम्यपरिदेवितम् । कुम्भकर्णःप्रचुक्रोधवचनंचेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40014538, "chapter_id": 9200, "verse_number": "28", "content_sanskrit": "यदातुरामस्यसलक्ष्मणस्यप्रसह्यसीताखलुसाइहाऽहृता । सकृत्समीक्ष्यैवसुनिश्चितंतदाभजेतचित्तंयमुनेवयामुनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40014539, "chapter_id": 9200, "verse_number": "29", "content_sanskrit": "सर्वमेतन्महाराजकृतमप्रतिमंतव । विधीयेतसहास्माभिरादावेवास्यकर्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40014540, "chapter_id": 9200, "verse_number": "30", "content_sanskrit": "न्यायेनराजकार्याणियःकरोतिदशानन: । नससन्तप्यतेपश्चान्निश्चितार्थमतिर्नृपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40014541, "chapter_id": 9200, "verse_number": "31", "content_sanskrit": "अनुपायेनकर्माणिविपरीतानियानिच । क्रियमाणानिदुष्यन्तिहवींष्यप्रयतेष्विव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40014542, "chapter_id": 9200, "verse_number": "32", "content_sanskrit": "यःपश्चात्पूर्वकार्याणिकर्माण्यभिचिकीर्षति । पूर्वंचापरकार्याणिनसवेदनयानयौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40014543, "chapter_id": 9200, "verse_number": "33", "content_sanskrit": "चपलस्यतुकृत्येषुप्रसमीक्ष्याधिकंबलम् । क्षिप्रमन्येप्रपद्यन्तेक्रौञ्चस्यखमिवद्विजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40014544, "chapter_id": 9200, "verse_number": "34", "content_sanskrit": "त्वयेदंमहादारब्धंकार्यमप्रतिचिन्तितम् । दिष्ट्यात्वांनावधीद्रामोविषमिश्रमिवामिषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40014545, "chapter_id": 9200, "verse_number": "35", "content_sanskrit": "तस्मात्त्वयासमारब्धंकर्मह्यप्रतिमंपरैः । अहंसमीकरिष्यामिहत्वाशत्रूंस्तवानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40014546, "chapter_id": 9200, "verse_number": "36", "content_sanskrit": "अहमुत्सादयिष्यामिशत्रूंस्तवनिशाचर । यदिशक्रविवस्वन्तौयदिपावकमारुतौ ॥ तावहंयोधयिष्यामिकुबेरवरुणावपि ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40014547, "chapter_id": 9200, "verse_number": "37", "content_sanskrit": "गिरिमात्रशरीरस्यमहापरिघयोधिनः । नर्दतस्तीक्ष्णदंष्ट्रस्यबिभीयाद्वैपुरन्दरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40014548, "chapter_id": 9200, "verse_number": "38", "content_sanskrit": "पुनर्मांसद्वितीयेनशरेणनिहनिष्यति । ततोऽहंतस्यपास्यामिरुधिरंकाममाश्वस ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40014549, "chapter_id": 9200, "verse_number": "39", "content_sanskrit": "वधेनवैदाशरथेस्सुखावहंजयंतवाहर्तुमहंयतिष्ये । हत्वाचरामंसहलक्ष्मणेनखादामिसर्वान्हरियूथमुख्यान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40014550, "chapter_id": 9200, "verse_number": "40", "content_sanskrit": "रमस्वकामम् पिबचाग्य्रवारुणींकुरष्वकार्याणिहितानिविज्वरः । मयातुरामेगमितेयमक्षयंचिरायसीतावशगाभविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]