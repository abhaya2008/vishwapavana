[{"id": 40014511, "chapter_id": 9200, "verse_number": "1", "content_sanskrit": "सतांपरिषदंकृत्स्नांसमीक्ष्यसमितिञ्जयः । प्रचोदयामासतदाप्रहस्तंवाहिनीपतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40014512, "chapter_id": 9200, "verse_number": "2", "content_sanskrit": "सेनापतेयथातेस्युःकृतविद्याश्चतुर्विधाः । योधानगररक्षायांतथाव्यादेष्टुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40014513, "chapter_id": 9200, "verse_number": "3", "content_sanskrit": "सप्रहस्तःप्रणीतात्माचिकीर्षन् राजशासनम् । विनिक्षिपद्बलंसर्वंबहिरन्तश्चमन्दिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40014514, "chapter_id": 9200, "verse_number": "4", "content_sanskrit": "ततोविनिक्षिप्यबलंसर्वनगरगुप्तये । प्रहस्तःप्रमुखेराज्ञोनिषसादजगादच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40014515, "chapter_id": 9200, "verse_number": "5", "content_sanskrit": "विहितंबहिरन्तश्चबलंबलवतस्तव । कुरुष्याविमनाःक्षिप्रंयदभिप्रेतमस्तुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40014516, "chapter_id": 9200, "verse_number": "6", "content_sanskrit": "प्रहस्तस्यवचश्श्रुत्वाराजाराज्यहितैषिणः । सुखेप्सुस्सुहृदांमध्येव्याजहारसरावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40014517, "chapter_id": 9200, "verse_number": "7", "content_sanskrit": "प्रियाप्रियेसुखंदुःखंलाभालाभेहिताहिते । धर्मकामार्थकृच्छ्रेषुयूयमर्हथवेदितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40014518, "chapter_id": 9200, "verse_number": "8", "content_sanskrit": "सर्वकृत्यानियुष्माभिस्समारब्धानिसर्वथा । मन्त्रकर्मनियुक्तानिनजातुविफलानिमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40014519, "chapter_id": 9200, "verse_number": "9", "content_sanskrit": "ससोमग्रहनक्षत्रैर्मरुद्भिरिववासवः । भवद्भिरहमत्यर्थंवृतश्रियमवाप्नुयाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40014520, "chapter_id": 9200, "verse_number": "10", "content_sanskrit": "अहंतुखलुसर्वान्वस्समर्थयितुमुद्यतः । कुम्भकर्णस्यतुस्वप्नान्नेममर्थमचोदयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40014521, "chapter_id": 9200, "verse_number": "11", "content_sanskrit": "अयंहिसुप्तःषण्मासान्कुम्भकर्णोमहाबलः । सर्वशस्त्रभृतांमुख्यस्सइदानींसमुत्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40014522, "chapter_id": 9200, "verse_number": "12", "content_sanskrit": "इयंचदण्डकारण्याद्रामस्यमहिषीमया । रक्षोभिश्चरितोद्देशादानीताजनकात्मजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40014523, "chapter_id": 9200, "verse_number": "13", "content_sanskrit": "सामेवशय्यामारोढुमिच्छत्यलसगामिनी । त्रिषुलोकेषुचान्यामेनसीतासदृशीमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40014524, "chapter_id": 9200, "verse_number": "14", "content_sanskrit": "तनुमध्यापृथुश्रोणीशरदिन्दुनिभानना । हेमबिम्बनिभासौम्यामायेवमयनिर्मिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40014525, "chapter_id": 9200, "verse_number": "15", "content_sanskrit": "सुलोहिततलौश्लक्ष् णौचरणौसुप्रतिष्ठितौ । दृष्ट्वात