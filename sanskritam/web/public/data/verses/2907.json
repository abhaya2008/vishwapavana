[{"id": 2089126, "chapter_id": 2907, "verse_number": "१३-३७-१", "content_sanskrit": "`भीष्म उवाच।\nसदृशं राजशार्दूल वृत्तस्य च कुलस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2089127, "chapter_id": 2907, "verse_number": "१३-३७-२", "content_sanskrit": "को राज्यं विपुलं गृह्य स्फीताकारं पुनर्महत्।\nनिर्जितारातिसामन्तं देवराज्योपमं सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2089128, "chapter_id": 2907, "verse_number": "१३-३७-३", "content_sanskrit": "राज्ये राज्यगुणा ये च तान्व्युदस्य नराधिप।\nदोषं पश्यति राजेन्द्र देहेऽस्मिन्पाञ्चभौतिके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2089129, "chapter_id": 2907, "verse_number": "१३-३७-४", "content_sanskrit": "अतिक्रान्तास्त्वया राजन्वृत्तेन प्रपितामहाः।\nधर्मो विग्रहवान्धीरो विदुरश्च महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2089130, "chapter_id": 2907, "verse_number": "१३-३७-५", "content_sanskrit": "सञ्जयश्च महातेजा ये चान्ये दिव्यदर्शनाः।\nप्रवृत्तज्ञानसम्पन्नास्तत्वज्ञानविदो नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2089131, "chapter_id": 2907, "verse_number": "१३-३७-६", "content_sanskrit": "तेऽतिक्रान्ता महाराज ब्रह्माद्याः ससुरासुराः।\nअनित्यं दुःखसंतप्तं जगदेतन्न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2089132, "chapter_id": 2907, "verse_number": "१३-३७-७", "content_sanskrit": "एवमेतान्महाबाहो ब्रह्माद्यान्ससुरासुरान्।\nअनित्यान्सततं पश्य मनुष्यादिषु का कथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2089133, "chapter_id": 2907, "verse_number": "१३-३७-८", "content_sanskrit": "नित्यां तु प्रकृतीमाह याऽसौ प्रसवधर्मिणी।\nअरूपिणीमनिर्देश्यामकृतां पुरुषातिगाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2089134, "chapter_id": 2907, "verse_number": "१३-३७-९", "content_sanskrit": "तामत्यन्तसुखां सौम्यां निर्वाणमिति संज्ञिताम्।\nआहुर्ब्रह्मर्षयो ह्याद्यां भुवि चैव महर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2089135, "chapter_id": 2907, "verse_number": "१३-३७-१०", "content_sanskrit": "तया पुरुषरूपिण्या धर्मप्रकृतिकोऽनघ।\nस यात्येव हि निर्वाणं यत्तत्प्रकृतिसंज्ञितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2089136, "chapter_id": 2907, "verse_number": "१३-३७-११", "content_sanskrit": "स एष प्राकृतो धर्मो भ्राजत्यादियुगे नृप।\nविकारधर्माः शेषेषु युगेषु भरतर्षभ।\nभ्राजन्तेऽभ्यधिकं वीर संसारपथगोचराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2089137, "chapter_id": 2907, "verse_number": "१३-३७-१२", "content_sanskrit": "प्रकृतीनां च सर्वासामकृता प्रकृतिः स्मृता।\nएवं प्रकृतिधर्मा हि वरां प्रकृतिमाश्रिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2089138, "chapter_id": 2907, "verse_number": "१३-३७-१३", "content_sanskrit": "पश्यन्ति परमां लोके दृष्टादृष्टानुदर्शिनीम्।\nसत्वादियुगपर्यन्ते त्रेतायुगसमुद्भवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2089139, "chapter_id": 2907, "verse_number": "१३-३७-१४", "content_sanskrit": "कामं कामयमानेषु ब्राह्मणेषु तिरोहितः।\nकुपथेषु तु धर्मेषु प्रादुर्भूतेषु कौरव।\nजातो मन्दप्रचारो हि धर्मः कलियुगे नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2089140, "chapter_id": 2907, "verse_number": "१३-३७-१५", "content_sanskrit": "नित्यस्तु पुरुषो ज्ञेयो विश्वरूपो निरञ्जनः।\nब्रह्माद्या अपि देवाश्च यं सदा पर्युपासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2089141, "chapter_id": 2907, "verse_number": "१३-३७-१६", "content_sanskrit": "तं च नारायणं विद्धि परं ब्रह्मेति शाश्वतम्।\nतत्कर्म कुरु कायेन ध्यायस्व मनसा च तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2089142, "chapter_id": 2907, "verse_number": "१३-३७-१७", "content_sanskrit": "कीर्तयस्व च तन्नाम वाचा सर्वत्र भूपते।\nतत्पदं प्राप्नुहि प्राप्यं शाश्वतं चापुनर्भवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2089143, "chapter_id": 2907, "verse_number": "१३-३७-१८", "content_sanskrit": "इत्येतद्विष्णुमाश्रित्य संसारग्रहमोक्षणम्।\nकथितं ते महाबाहो किं भूयः श्रोतुमिच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2089144, "chapter_id": 2907, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि सप्तत्रिंशोऽध्यायः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]