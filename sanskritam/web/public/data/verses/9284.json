[{"id": 5000284000, "chapter_id": 9284, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे द्वादशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000284001, "chapter_id": 9284, "verse_number": "४-१२-१", "content_sanskrit": "एतच्च वचनं श्रुत्वा सुग्रीवस्य सुभाषितम्।\nप्रत्ययार्थं महातेजा रामो जग्राह कार्मुकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000284002, "chapter_id": 9284, "verse_number": "४-१२-२", "content_sanskrit": "स गृहीत्वा धनुर्घोरं शरमेकं च मानदः।\nसालमुद्दिश्य चिक्षेप पूरयन् स रवैर्दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000284003, "chapter_id": 9284, "verse_number": "४-१२-३", "content_sanskrit": "स विसृष्टो बलवता बाणः स्वर्णपरिष्कृतः।\nभित्त्वा सालान् गिरिप्रस्थं सप्तं भूमिं विवेश ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000284004, "chapter_id": 9284, "verse_number": "४-१२-४", "content_sanskrit": "सायकस्तु मुहूर्तेन सालान् भित्त्वा महाजवः।\nनिष्पत्य च पुनस्तूणं तमेव प्रविवेश ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000284005, "chapter_id": 9284, "verse_number": "४-१२-५", "content_sanskrit": "तान् दृष्ट्वा सप्त निर्भिन्नान् सालान् वानरपुङ्गवः।\nरामस्य शरवेगेन विस्मयं परमं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000284006, "chapter_id": 9284, "verse_number": "४-१२-६", "content_sanskrit": "स मूर्ध्ना न्यपतद् भूमौ प्रलम्बीकृतभूषणः।\nसुग्रीवः परमप्रीतो राघवाय कृताञ्जलिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000284007, "chapter_id": 9284, "verse_number": "४-१२-७", "content_sanskrit": "इदं चोवाच धर्मज्ञं कर्मणा तेन हर्षितः।\nरामं सर्वास्त्रविदुषां श्रेष्ठं शूरमवस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000284008, "chapter_id": 9284, "verse_number": "४-१२-८", "content_sanskrit": "सेन्द्रानपि सुरान् सर्वांस्त्वं बाणैः पुरुषर्षभ।\nसमर्थः समरे हन्तुं किं पुनर्वालिनं प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000284009, "chapter_id": 9284, "verse_number": "४-१२-९", "content_sanskrit": "येन सप्त महासाला गिरिर्भूमिश्च दारिताः।\nबाणेनैकेन काकुत्स्थ स्थाता ते को रणाग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000284010, "chapter_id": 9284, "verse_number": "४-१२-१०", "content_sanskrit": "अद्य मे विगतः शोकः प्रीतिरद्य परा मम।\nसुहृदं त्वां समासाद्य महेन्द्रवरुणोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000284011, "chapter_id": 9284, "verse_number": "४-१२-११", "content_sanskrit": "तमद्यैव प्रियार्थं मे वैरिणं भ्रातृरूपिणम्।\nवालिनं जहि काकुत्स्थ मया बद्धोऽयमञ्जलिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000284012, "chapter_id": 9284, "verse_number": "४-१२-१२", "content_sanskrit": "ततो रामः परिष्वज्य सुग्रीवं प्रियदर्शनम्।\nप्रत्युवाच महाप्राज्ञो लक्ष्मणानुगतं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000284013, "chapter_id": 9284, "verse_number": "४-१२-१३", "content_sanskrit": "अस्माद‍्गच्छाम किष्किन्धां क्षिप्रं गच्छ त्वमग्रतः।\nगत्वा चाह्वय सुग्रीव वालिनं भ्रातृगन्धिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000284014, "chapter_id": 9284, "verse_number": "४-१२-१४", "content_sanskrit": "सर्वे ते त्वरितं गत्वा किष्किन्धां वालिनः पुरीम्।\nवृक्षैरात्मानमावृत्य ह्यतिष्ठन् गहने वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000284015, "chapter_id": 9284, "verse_number": "४-१२-१५", "content_sanskrit": "सुग्रीवोऽप्यनदद् घोरं वालिनो ह्वानकारणात्।\nगाढं परिहितो वेगान्नादैर्भिन्दन्निवाम्बरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000284016, "chapter_id": 9284, "verse_number": "४-१२-१६", "content_sanskrit": "तं श्रुत्वा निनदं भ्रातुः क्रुद्धो वाली महाबलः।\nनिष्पपात सुसंरब्धो भास्करोऽस्ततटादिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000284017, "chapter_id": 9284, "verse_number": "४-१२-१७", "content_sanskrit": "ततः सुतुमुलं युद्धं वालिसुग्रीवयोरभूत्।\nगगने ग्रहयोर्घोरं बुधाङ्गारकयोरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000284018, "chapter_id": 9284, "verse_number": "४-१२-१८", "content_sanskrit": "तलैरशनिकल्पैश्च वज्रकल्पैश्च मुष्टिभिः।\nजघ्नतुः समरेऽन्योन्यं भ्रातरौ क्रोधमूर्च्छितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000284019, "chapter_id": 9284, "verse_number": "४-१२-१९", "content_sanskrit": "ततो रामो धनुष्पाणिस्तावुभौ समुदैक्षत।\nअन्योन्यसदृशौ वीरावुभौ देवाविवाश्विनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000284020, "chapter_id": 9284, "verse_number": "४-१२-२०", "content_sanskrit": "यन्नावगच्छत् सुग्रीवं वालिनं वापि राघवः।\nततो न कृतवान् बुद्धिं मोक्तुमन्तकरं शरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000284021, "chapter_id": 9284, "verse_number": "४-१२-२१", "content_sanskrit": "एतस्मिन्नन्तरे भग्नः सुग्रीवस्तेन वालिना।\nअपश्यन् राघवं नाथमृष्यमूकं प्रदुद्रुवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000284022, "chapter_id": 9284, "verse_number": "४-१२-२२", "content_sanskrit": "क्लान्तो रुधिरसिक्ताङ्गः प्रहारैर्जर्जरीकृतः।\nवालिनाभिद्रुतः क्रोधात् प्रविवेश महावनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000284023, "chapter_id": 9284, "verse_number": "४-१२-२३", "content_sanskrit": "तं प्रविष्टं वनं दृष्ट्वा वाली शापभयात् ततः।\nमुक्तो ह्यसि त्वमित्युक्त्वा स निवृत्तो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000284024, "chapter_id": 9284, "verse_number": "४-१२-२४", "content_sanskrit": "राघवोऽपि सह भ्रात्रा सह चैव हनूमता।\nतदेव वनमागच्छत् सुग्रीवो यत्र वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000284025, "chapter_id": 9284, "verse_number": "४-१२-२५", "content_sanskrit": "तं समीक्ष्यागतं रामं सुग्रीवः सहलक्ष्मणम्।\nह्रीमान् दीनमुवाचेदं वसुधामवलोकयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000284026, "chapter_id": 9284, "verse_number": "४-१२-२६", "content_sanskrit": "आह्वयस्वेति मामुक्त्वा दर्शयित्वा च विक्रमम्।\nवैरिणा घातयित्वा च किमिदानीं त्वया कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000284027, "chapter_id": 9284, "verse_number": "४-१२-२७", "content_sanskrit": "तामेव वेलां वक्तव्यं त्वया राघव तत्त्वतः।\nवालिनं न निहन्मीति ततो नाहमितो व्रजे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000284028, "chapter_id": 9284, "verse_number": "४-१२-२८", "content_sanskrit": "तस्य चैवं ब्रुवाणस्य सुग्रीवस्य महात्मनः।\nकरुणं दीनया वाचा राघवः पुनरब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000284029, "chapter_id": 9284, "verse_number": "४-१२-२९", "content_sanskrit": "सुग्रीव श्रूयतां तात क्रोधश्च व्यपनीयताम्।\nकारणं येन बाणोऽयं स मया न विसर्जितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000284030, "chapter_id": 9284, "verse_number": "४-१२-३०", "content_sanskrit": "अलंकारेण वेषेण प्रमाणेन गतेन च।\nत्वं च सुग्रीव वाली च सदृशौ स्थः परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000284031, "chapter_id": 9284, "verse_number": "४-१२-३१", "content_sanskrit": "स्वरेण वर्चसा चैव प्रेक्षितेन च वानर।\nविक्रमेण च वाक्यैश्च व्यक्तिं वां नोपलक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000284032, "chapter_id": 9284, "verse_number": "४-१२-३२", "content_sanskrit": "ततोऽहं रूपसादृश्यान्मोहितो वानरोत्तम।\nनोत्सृजामि महावेगं शरं शत्रुनिबर्हणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000284033, "chapter_id": 9284, "verse_number": "४-१२-३३", "content_sanskrit": "जीवितान्तकरं घोरं सादृश्यात् तु विशङ्कितः।\nमूलघातो न नौ स्याद्धि द्वयोरिति कृतो मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000284034, "chapter_id": 9284, "verse_number": "४-१२-३४", "content_sanskrit": "त्वयि वीर विपन्ने हि अज्ञानाल्लाघवान्मया।\nमौढ्यं च मम बाल्यं च ख्यापितं स्यात् कपीश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000284035, "chapter_id": 9284, "verse_number": "४-१२-३५", "content_sanskrit": "दत्ताभयवधो नाम पातकं महदद्भुतम्।\nअहं च लक्ष्मणश्चैव सीता च वरवर्णिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000284036, "chapter_id": 9284, "verse_number": "४-१२-३६", "content_sanskrit": "त्वदधीना वयं सर्वे वनेऽस्मिन् शरणं भवान्।\nतस्माद् युध्यस्व भूयस्त्वं मा माशङ्कीश्च वानर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000284037, "chapter_id": 9284, "verse_number": "४-१२-३७", "content_sanskrit": "एतन्मुहूर्ते तु मया पश्य वालिनमाहवे।\nनिरस्तमिषुणैकेन चेष्टमानं महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000284038, "chapter_id": 9284, "verse_number": "४-१२-३८", "content_sanskrit": "अभिज्ञानं कुरुष्व त्वमात्मनो वानरेश्वर।\nयेन त्वामभिजानीयां द्वन्द्वयुद्धमुपागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000284039, "chapter_id": 9284, "verse_number": "४-१२-३९", "content_sanskrit": "गजपुष्पीमिमां फुल्लामुत्पाट्य शुभलक्षणाम्।\nकुरु लक्ष्मण कण्ठेऽस्य सुग्रीवस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000284040, "chapter_id": 9284, "verse_number": "४-१२-४०", "content_sanskrit": "ततो गिरितटे जातामुत्पाट्य कुसुमायुताम्।\nलक्ष्मणो गजपुष्पीं तां तस्य कण्ठे व्यसर्जयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000284041, "chapter_id": 9284, "verse_number": "४-१२-४१", "content_sanskrit": "स तया शुशुभे श्रीमाँल्लतया कण्ठसक्तया।\nमालयेव बलाकानां ससंध्य इव तोयदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000284042, "chapter_id": 9284, "verse_number": "४-१२-४२", "content_sanskrit": "विभ्राजमानो वपुषा रामवाक्यसमाहितः।\nजगाम सह रामेण किष्किन्धां पुनराप सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000284043, "chapter_id": 9284, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे द्वादशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]