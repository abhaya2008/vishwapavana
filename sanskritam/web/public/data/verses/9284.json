[{"id": 40018379, "chapter_id": 9284, "verse_number": "1", "content_sanskrit": "आर्तानांराक्षसीनांतुलङ्कायांवैकुलेकुले । रावणःकरुणंशब्दंशुश्रावपरिदेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40018380, "chapter_id": 9284, "verse_number": "2", "content_sanskrit": "स तुदीर्घंविनिःश्वस्यमुहूर्तंध्यानमास्थितः । बभूवपरमक्रुद्धोरावणोभीमदर्शनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40018381, "chapter_id": 9284, "verse_number": "3", "content_sanskrit": "सन्दश्यदशनैरोष्ठंक्रोधसम्रक्तलोचनः । राक्षसैरपिदुर्दर्शःकालाग्निरिवमूर्छितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40018382, "chapter_id": 9284, "verse_number": "4", "content_sanskrit": "उवाच च समीपस्थान्राक्षसान्राक्षसेश्वरः । क्रोधाव्यक्तकथस्तत्रनिर्दहन्निवचक्षुषा ॥ महोदरंमहापार्श्वंविरूपाक्षं च राक्षसम् । शीघ्रंवदतसैन्यानिनिर्यातेतिममाज्ञया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40018383, "chapter_id": 9284, "verse_number": "5", "content_sanskrit": "उवाच च समीपस्थान्राक्षसान्राक्षसेश्वरः । क्रोधाव्यक्तकथस्तत्रनिर्दहन्निवचक्षुषा ॥ महोदरंमहापार्श्वंविरूपाक्षं च राक्षसम् । शीघ्रंवदतसैन्यानिनिर्यातेतिममाज्ञया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40018384, "chapter_id": 9284, "verse_number": "6", "content_sanskrit": "तस्यतद्वचनंश्रुत्वाराक्षसास्तेभयार्दिताः । चोदयामासुरव्यग्रान्राक्षसांस्तान्नृपाज्ञया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40018385, "chapter_id": 9284, "verse_number": "7", "content_sanskrit": "तेतुसर्वेतथेत्युक्त्वाराक्षसाभीमदर्शनाः । कृतस्वस्त्वयनाःसर्वेतेरणाभिमुखाययुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40018386, "chapter_id": 9284, "verse_number": "8", "content_sanskrit": "प्रतिपूज्ययथान्यायंरावणंतेमहारथाः । तस्थुःप्राञ्जलयःसर्वेभर्तुर्विजयकाङ्क्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40018387, "chapter_id": 9284, "verse_number": "9", "content_sanskrit": "अथोवाचप्रहस्यैतान्रावणःक्रोधमूर्छितः । महोदरमहापार्श्वौविरूपाक्षं च राक्षसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40018388, "chapter_id": 9284, "verse_number": "10", "content_sanskrit": "अद्यबाणैर्धनुर्मुक्स्सैर्युगान्तादित्यसन्निभैः । राघवंलक्ष्मणंचैवनेष्यामियमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40018389, "chapter_id": 9284, "verse_number": "11", "content_sanskrit": "खरस्यकुम्भकर्णस्यप्रहसेन्द्रजितोस्तथा । करिष्यामिप्रतीकारमद्यशत्रुवधादहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40018390, "chapter_id": 9284, "verse_number": "12", "content_sanskrit": "नैवान्तरिक्षं न दिशो न नद्यौर्नापिसागराः । प्रकाशत्वंगमिष्यन्तिमद्बाणजलदावृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40018391, "chapter_id": 9284, "verse_number": "13", "content_sanskrit": "अद्यवानरमुख्यानांतानियूथानिभागशः । धनुषाशरजालेनवधिष्यामिपतत्रिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40018392, "chapter_id": 9284, "verse_number": "14", "content_sanskrit": "अद्यवानरसैन्यानिरथेनपवनौजसा । धनुस्समुद्रादुद्भूतैर्मथिष्यामिशरोर्मिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40018393, "chapter_id": 9284, "verse_number": "15", "content_sanskrit": "व्याकोशपद्मवक्त्राणिपद्मकेसरवर्चसाम् । अद्ययूथतटाकानिगजवत्प्रमथाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40018394, "chapter_id": 9284, "verse_number": "16", "content_sanskrit": "सशरैरद्यवदनैस्सङ्ख्येवानरयूथपाः । मण्डयिष्यन्तिवसुधांसनालैरिवपङ्कजैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40018395, "chapter_id": 9284, "verse_number": "17", "content_sanskrit": "अद्ययूथप्रचण्डानांहरीणांद्रुमयोधिनाम् । मुक्तेनैकेषुणायुद्धेभेत्स्यामि च शतंशतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40018396, "chapter_id": 9284, "verse_number": "18", "content_sanskrit": "हतोभर्ताहतोभ्रातायासां च चतनयोहतः । वधेनाद्यरिपोस्तासांकरोम्यश्रुप्रमार्जनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40018397, "chapter_id": 9284, "verse_number": "19", "content_sanskrit": "अद्यमद्भाणनिर्भिन्नैःप्रकीर्णैर्गतचेतनैः । करोमिवानरैर्युद्धेयत्नावेक्ष्यतलांमहीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40018398, "chapter_id": 9284, "verse_number": "20", "content_sanskrit": "अद्यगोमयवोगृध्राश्चये च मांसाशिनोऽपरे । सर्वांस्तांस्तर्पयिष्यामिशत्रुमांसैश्शरार्दितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40018399, "chapter_id": 9284, "verse_number": "21", "content_sanskrit": "कल्प्यतांमेरथंशीघ्रंक्षिप्रमानीयतांधनुः । अनुप्रयान्तुमांयुद्धेयेऽत्रशिष्टानिशाचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40018400, "chapter_id": 9284, "verse_number": "22", "content_sanskrit": "तस्यतद्वचनंश्रुत्वामहापार्श्वोऽब्रवीद्वचः । बलाध्यक्षान् स्थिथांस्तत्रबलंसंत्वर्यतामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40018401, "chapter_id": 9284, "verse_number": "23", "content_sanskrit": "बलाध्यक्षास्तुसम्रब्दाराक्षसांस्तान् गृहेगृहे । चोदयन्तःपरिययुर्लङ्कांलघुपराक्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40018402, "chapter_id": 9284, "verse_number": "24", "content_sanskrit": "ततोमुहूर्तान्निष्पेतूराक्षसाभीमदर्शनाः । नदन्तोभीमवदनानानाप्रहरणैर्भुजैः ॥ असिभिःपट्टसै: शूलैर्गदाभिर्मुसलैर्हलैः । शक्तिभिस्तीक्ष्णधाराभिर्महद्भि: कूटमुद्गरैः ॥ यष्टिभिर्विमलैश्चक्रैर्निशितैश्चपरश्वथै: । भिन्दिपालैःशतघ्नीभिरन्यैश्चापिवरायुधैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40018403, "chapter_id": 9284, "verse_number": "25", "content_sanskrit": "ततोमुहूर्तान्निष्पेतूराक्षसाभीमदर्शनाः । नदन्तोभीमवदनानानाप्रहरणैर्भुजैः ॥ असिभिःपट्टसै: शूलैर्गदाभिर्मुसलैर्हलैः । शक्तिभिस्तीक्ष्णधाराभिर्महद्भि: कूटमुद्गरैः ॥ यष्टिभिर्विमलैश्चक्रैर्निशितैश्चपरश्वथै: । भिन्दिपालैःशतघ्नीभिरन्यैश्चापिवरायुधैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40018404, "chapter_id": 9284, "verse_number": "26", "content_sanskrit": "ततोमुहूर्तान्निष्पेतूराक्षसाभीमदर्शनाः । नदन्तोभीमवदनानानाप्रहरणैर्भुजैः ॥ असिभिःपट्टसै: शूलैर्गदाभिर्मुसलैर्हलैः । शक्तिभिस्तीक्ष्णधाराभिर्महद्भि: कूटमुद्गरैः ॥ यष्टिभिर्विमलैश्चक्रैर्निशितैश्चपरश्वथै: । भिन्दिपालैःशतघ्नीभिरन्यैश्चापिवरायुधैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40018405, "chapter_id": 9284, "verse_number": "27", "content_sanskrit": "अथानयद्बलाध्यक्षस्सत्वरोरावणाज्ञया । द्रुतंसूतसमायुक्तंयुक्ताष्टतुरगंरथम् । आरुरोहतदाभीमोदीप्यमानंस्वतेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40018406, "chapter_id": 9284, "verse_number": "28", "content_sanskrit": "ततःप्रयातस्सहसाराक्षसैर्भहुभिर्वृतः ॥ रावणःसत्त्वगाम्भीर्याद्दारयन्निवमेदिनीम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40018407, "chapter_id": 9284, "verse_number": "29", "content_sanskrit": "रावणेनाभ्यनुज्ञातौमहापार्श्वमहोदरौ । विरूपाक्षश्चदुर्धर्षोरथानारुरुहुस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40018408, "chapter_id": 9284, "verse_number": "30", "content_sanskrit": "तेतुहृष्टाविवर्धन्तोभिन्दन्तइवमेदिनीम् । नादंघोरंविमुञ्चन्तोनिर्ययुर्जयकाङ्क्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40018409, "chapter_id": 9284, "verse_number": "31", "content_sanskrit": "ततोयुद्धायतेजस्वीरक्षोगणबलैर्वृतः । निर्ययावुद्यतधनुःकालान्तकयमोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40018410, "chapter_id": 9284, "verse_number": "32", "content_sanskrit": "ततःप्रजविताश्वेनरथेन स महारथः । द्वारेणनिर्ययौतेनयत्रतौरामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40018411, "chapter_id": 9284, "verse_number": "33", "content_sanskrit": "ततोनष्टप्रभःसूर्योदिशश्चतिमिरावृताः । द्विजाश्चनेदुर्घोराश्चसञ्चचाल च मेदिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40018412, "chapter_id": 9284, "verse_number": "34", "content_sanskrit": "ववर्षरुधिरंदेवश्चस्खलुश्चतुरङ्गमाः । ध्वजाग्रेन्यपतद्गृध्रोविनेदुश्चाशिवाःशिवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40018413, "chapter_id": 9284, "verse_number": "35", "content_sanskrit": "नयनंचास्फुरद्वामंवामोबाहुरकम्पत । विवर्णवदनश्साकतिंचिदभ्रश्यतस्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40018414, "chapter_id": 9284, "verse_number": "36", "content_sanskrit": "ततोनिष्पततोयुद्धेदशग्रीवस्यरक्षसः । रणेनिधनशंसीनिरूपाण्येतानिजज्ञिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40018415, "chapter_id": 9284, "verse_number": "37", "content_sanskrit": "अन्तरिक्षात्पपातोल्कानिराघतसमनिर्घास्वना । विनेदुरशिवागृध्रावायसैरभिमिश्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40018416, "chapter_id": 9284, "verse_number": "38", "content_sanskrit": "एतानचिन्तयन्घोरानुत्पातान्समवस्थितान् । निर्ययौरावणोमोहाद्वधार्थंकालचोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40018417, "chapter_id": 9284, "verse_number": "39", "content_sanskrit": "तेषांतुरथघोषेणराक्षसानांमहात्मनाम् । वानराणामपिचमूर्युद्धायैवाभ्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40018418, "chapter_id": 9284, "verse_number": "40", "content_sanskrit": "तेषांतुतुमुलंयुद्धंबभूवकपिरक्षसाम् । अन्योन्यमाह्वयानानांक्रुद्धानांजयमिच्छताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40018419, "chapter_id": 9284, "verse_number": "41", "content_sanskrit": "ततःक्रुद्धो