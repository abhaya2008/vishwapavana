[{"id": 6000084000, "chapter_id": 10084, "verse_number": null, "content_sanskrit": "अथ विंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000084001, "chapter_id": 10084, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.001.m4a", "display_order": 2}, {"id": 6000084002, "chapter_id": 10084, "verse_number": "४-२०-१", "content_sanskrit": "भगवांश्चापि वैकुण्ठः साकं मघवता विभुः।\nयज्ञैर्यज्ञपतिः स्विष्टो यज्ञभुक् तमभाषत॥ ४/२०/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.002.m4a", "display_order": 3, "topics": [{"text": "साक्षाद्विष्णुना पृथुराजाय ज्ञानोपदेशः", "range": "१–१८"}]}, {"id": 6000084003, "chapter_id": 10084, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.003.m4a", "display_order": 4}, {"id": 6000084004, "chapter_id": 10084, "verse_number": "४-२०-२", "content_sanskrit": "एष तेऽकार्षीद् भङ्गं हयमेधशतस्य ह।\nक्षमापयत आत्मानममुष्य क्षन्तुमर्हसि॥ ४/२०/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.004.m4a", "display_order": 5}, {"id": 6000084005, "chapter_id": 10084, "verse_number": "४-२०-३", "content_sanskrit": "सुधियः साधवो लोके नरदेव नरोत्तम।\nनाभिद्रुह्यन्ति भूतेभ्यो यर्ह्यनात्मा कलेवरम्॥ ४/२०/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.005.m4a", "display_order": 6}, {"id": 6000084006, "chapter_id": 10084, "verse_number": "४-२०-४", "content_sanskrit": "पुरुषा यदि मुह्यन्ति त्वादृशा देवमायया।\nश्रम एव परं जातो दीर्घया वृद्धसेवया॥ ४/२०/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.006.m4a", "display_order": 7}, {"id": 6000084007, "chapter_id": 10084, "verse_number": "४-२०-५", "content_sanskrit": "अत एव इमं विद्वानविद्याकामकर्मभिः।\nआरब्धमिति नैवास्मिन् प्रतिबुद्धोऽनुषज्जते॥ ४/२०/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.007.m4a", "display_order": 8}, {"id": 6000084008, "chapter_id": 10084, "verse_number": "४-२०-६", "content_sanskrit": "असंसक्तः शरीरेऽस्मिन्नमुनोत्पादिते गृहे।\nअपत्ये द्रविणे दारे कः कुर्यान्ममतां बुधः॥ ४/२०/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.008.m4a", "display_order": 9}, {"id": 6000084009, "chapter_id": 10084, "verse_number": "४-२०-७", "content_sanskrit": "एकः शुद्धः स्वयंज्योतिर्निर्गुणोऽसौ गुणाश्रयः।\nसर्वगोऽनावृतः साक्षी निरात्माऽनात्मनः परः॥ ४/२०/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.009.m4a", "display_order": 10}, {"id": 6000084010, "chapter_id": 10084, "verse_number": "४-२०-८", "content_sanskrit": "देहाद्यपार्थास्तद्धर्मा न स्युस्तद्द्रष्टुरात्मनः।\nकैवल्यं तस्य वै धर्मः सुषुप्तं तन्निदर्शनम्॥ ४/२०/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.010.m4a", "display_order": 11}, {"id": 6000084011, "chapter_id": 10084, "verse_number": "४-२०-९", "content_sanskrit": "य एवं सन्तमात्मानमात्मस्थं वेद पूरुषः।\nनाज्यते प्रकृतिस्थोऽपि तद्गुणैः समवस्थितः॥ ४/२०/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.011.m4a", "display_order": 12}, {"id": 6000084012, "chapter_id": 10084, "verse_number": "४-२०-१०", "content_sanskrit": "यः स्वधर्मेण मां नित्यं निराशीः श्रद्धयाऽन्वितः।\nभजते शनकैस्तस्य मनो राजन् प्रसीदति॥ ४/२०/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.012.m4a", "display_order": 13}, {"id": 6000084013, "chapter_id": 10084, "verse_number": "४-२०-११", "content_sanskrit": "परित्यक्तगुणः सम्यग्दर्शनो विशदाशयः।\nशान्तिं मे समवस्थानं ब्रह्म कैवल्यमश्नुते॥ ४/२०/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.013.m4a", "display_order": 14}, {"id": 6000084014, "chapter_id": 10084, "verse_number": "४-२०-१२", "content_sanskrit": "उदासीनमिवाध्यक्षं द्रव्यज्ञानक्रियात्मनाम्।\nकूटस्थमिममात्मानं यो वेदाप्नोति शोभनम्॥ ४/२०/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.014.m4a", "display_order": 15}, {"id": 6000084015, "chapter_id": 10084, "verse_number": "४-२०-१३", "content_sanskrit": "भिन्नस्य लिङ्गस्य गुणप्रवाहं द्रव्यक्रियाकारकचेतनात्मनः।\nदृष्ट्वा सुसंपत्सु विपत्सु सूरयो न विक्रियन्ते मयि बद्धसौहृदाः॥ ४/२०/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.015.m4a", "display_order": 16}, {"id": 6000084016, "chapter_id": 10084, "verse_number": "४-२०-१४", "content_sanskrit": "समः समानोत्तममध्यमाधमः सुखे च दुःखे च जितेन्द्रियाशयः।\nमयोपक्लृप्ताखिलसत्त्वसंयुतो विधत्स्व धीराखिललोकरक्षणम्॥ ४/२०/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.016.m4a", "display_order": 17}, {"id": 6000084017, "chapter_id": 10084, "verse_number": "४-२०-१५", "content_sanskrit": "श्रेयः प्रजापालनमेव राज्ञो यत् सांपराये सुकृतं षष्ठमंशम्।\nअतोऽन्यथा हृतपुण्यः प्रजानामरक्षिता करहारोऽघमत्ति॥ ४/२०/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.017.m4a", "display_order": 18}, {"id": 6000084018, "chapter_id": 10084, "verse_number": "४-२०-१६", "content_sanskrit": "एवं द्विजाग्र्यानुमतानुवृत्तधर्मप्रधानान्यतमोऽविताऽस्याः।\nह्रस्वेन कालेन गृहोपयातान् द्रष्टासि सिद्धाननुरक्तलोकः॥ ४/२०/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.018.m4a", "display_order": 19}, {"id": 6000084019, "chapter_id": 10084, "verse_number": "४-२०-१७", "content_sanskrit": "वरं च मत् कञ्‍चन मानवेन्द्र वृणीष्व तेऽहं गुणशीलयन्त्रितः।\nनाहं मखैर्वै सुलभस्तपोभिर्योगेन वा यः समवृत्तवर्ती॥ ४/२०/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.019.m4a", "display_order": 20}, {"id": 6000084020, "chapter_id": 10084, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.020.m4a", "display_order": 21}, {"id": 6000084021, "chapter_id": 10084, "verse_number": "४-२०-१८", "content_sanskrit": "स इत्थं लोकगुरुणा विष्वक्सेनेन विश्वजित्।\nअनुशासित आदेशं शिरसा जगृहे हरेः॥ ४/२०/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.021.m4a", "display_order": 22}, {"id": 6000084022, "chapter_id": 10084, "verse_number": "४-२०-१९", "content_sanskrit": "स्पृशन्तं पादयोः शीर्ष्णा व्रीडन्तं स्वेन कर्मणा।\nशतक्रतुं परिष्वज्य विद्वेषं विससर्ज ह॥ ४/२०/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.022.m4a", "display_order": 23, "topics": [{"text": "स्वकृतापराधं क्षमापयता मघवता सह प्रीतिं प्राप्य तस्य विसर्जनम्", "range": "१९–२३"}]}, {"id": 6000084023, "chapter_id": 10084, "verse_number": "४-२०-२०", "content_sanskrit": "भगवानपि विश्वात्मा पृथुनोपहृतार्हणः।\nसमुज्जिहानया भक्त्या गृहीतचरणाम्बुजः॥ ४/२०/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.023.m4a", "display_order": 24}, {"id": 6000084024, "chapter_id": 10084, "verse_number": "४-२०-२१", "content_sanskrit": "प्रस्थानाभिमुखोऽप्येनमनुग्रहविलम्बितः।\nपश्यन् पद्मपलाशाक्षो न प्रतस्थे सुहृत् सताम्॥ ४/२०/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.024.m4a", "display_order": 25}, {"id": 6000084025, "chapter_id": 10084, "verse_number": "४-२०-२२", "content_sanskrit": "स आदिराजो रचिताञ्जलिर्हरिं विलोकितुं नाशकदश्रुलोचनः।\nन किञ्चनोवाच स बाष्पविक्लवो हृदोपगुह्यामुमथ व्यवस्थितः॥ ४/२०/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.025.m4a", "display_order": 26}, {"id": 6000084026, "chapter_id": 10084, "verse_number": "४-२०-२३", "content_sanskrit": "अथाभिमृज्याश्रुकणान् विलोकयन्नतृप्तदृग्गोचरमाह पूरुषम्।\nपदा स्पृशन्तं क्षितिमंस उन्नते विन्यस्तहस्ताग्रमुरङ्गविद्विषः॥ ४/२०/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.026.m4a", "display_order": 27}, {"id": 6000084027, "chapter_id": 10084, "verse_number": null, "content_sanskrit": "पृथुरुवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.027.m4a", "display_order": 28}, {"id": 6000084028, "chapter_id": 10084, "verse_number": "४-२०-२४", "content_sanskrit": "वरान् विभो त्वद् वरदेश्वराद् बुधः कथं वृणीते गुणविक्रियात्मनाम्।\nये नारकाणामपि सन्ति चैहिकास्तानीश कैवल्यपतेर्वृणीत कः॥ ४/२०/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.028.m4a", "display_order": 29, "topics": [{"text": "भगवत्स्तुतिः", "range": "२४–३२"}]}, {"id": 6000084029, "chapter_id": 10084, "verse_number": "४-२०-२५", "content_sanskrit": "न कामये नाथ तदप्यहं क्‍वचिन्न यत्र युष्मच्चरणाम्बुजासवम्।\nमहत्तमान्तर्हृदयान्मुखच्युतं विधत्स्व कर्णामृतमेष मे वरः॥ ४/२०/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.029.m4a", "display_order": 30}, {"id": 6000084030, "chapter_id": 10084, "verse_number": "४-२०-२६", "content_sanskrit": "स उत्तमश्लोकमहन्मुखच्युतो भवत्पदाम्भोजसुधाकणानिलः।\nस्मृतिं पुनर्विस्मृततत्त्ववर्त्मनां कुयोगिनां नो वितरत्यलं वरैः॥ ४/२०/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.030.m4a", "display_order": 31}, {"id": 6000084031, "chapter_id": 10084, "verse_number": "४-२०-२७", "content_sanskrit": "यशः शिवं सुश्रव आर्यसङ्गमे यदृच्छया चोपशृणोति ते सकृत्।\nकथं गुणज्ञो विरमेद् ऋते पशुं श्रीर्यत् प्रवव्रे गुणसंग्रहेच्छया॥ ४/२०/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.031.m4a", "display_order": 32}, {"id": 6000084032, "chapter_id": 10084, "verse_number": "४-२०-२८", "content_sanskrit": "अथाभजं त्वाऽखिलपूरुषोत्तमं गुणालयं पद्मकरेव लालसः।\nअप्यावयोरेकपतिस्पृधोः कलिर्न स्यात् कृतस्त्वच्चरणैकतानयोः॥ ४/२०/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.032.m4a", "display_order": 33}, {"id": 6000084033, "chapter_id": 10084, "verse_number": "४-२०-२९", "content_sanskrit": "जन्तोर्जगत्यां जगदीश वैशसं स्यादेव यत् कर्मणि नः समीहितम्।\nकरोषि फल्ग्वप्युरु दीनवत्सल स्व एव धिष्ण्येऽभिरतस्य किं तया॥ ४/२०/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.033.m4a", "display_order": 34}, {"id": 6000084034, "chapter_id": 10084, "verse_number": "४-२०-३०", "content_sanskrit": "भजन्त्यथ त्वामत एव साधवो व्युदस्तमायागुणविभ्रमोदयम्।\nभवत्पदानुस्मरणादृते सतां निमित्तमन्यद् भगवन् न विद्महे॥ ४/२०/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.034.m4a", "display_order": 35}, {"id": 6000084035, "chapter_id": 10084, "verse_number": "४-२०-३१", "content_sanskrit": "मन्ये गिरं ते जगतां विमोहिनीं वरं वृणीष्वेति भजन्तमात्थ यत्।\nवाचा नु तन्त्या यदि ते जनोऽसितः कथं पुनः कर्म करोति मोहितः॥ ४/२०/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.035.m4a", "display_order": 36}, {"id": 6000084036, "chapter_id": 10084, "verse_number": "४-२०-३२", "content_sanskrit": "त्वन्माययाऽद्धा जगदीश खण्डितो यदन्यदाशास्त ऋतात्मनोऽबुधः।\nयथा चरेद् बालहितं पिता स्वयं तथा त्वमेवार्हसि नः समीहितम्॥ ४/२०/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.036.m4a", "display_order": 37}, {"id": 6000084037, "chapter_id": 10084, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.037.m4a", "display_order": 38}, {"id": 6000084038, "chapter_id": 10084, "verse_number": "४-२०-३३", "content_sanskrit": "साधु तेऽवसितं राजन्नाशास्ते न यदाशिषः।\nस्वर्गापवर्गनरकान् समं पश्यति मत्परः॥ ४/२०/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.038.m4a", "display_order": 39, "topics": [{"text": "भगवतो वैकुण्ठगमनम्", "range": "३३–३९"}]}, {"id": 6000084039, "chapter_id": 10084, "verse_number": "४-२०-३४", "content_sanskrit": "प्रीतोऽहं ते महाराज रोषं दुस्त्यजमत्यजः।\nश्रद्धधानो मदादेशं तन्मह्यं परमार्हणम्॥ ४/२०/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.039.m4a", "display_order": 40}, {"id": 6000084040, "chapter_id": 10084, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.040.m4a", "display_order": 41}, {"id": 6000084041, "chapter_id": 10084, "verse_number": "४-२०-३५", "content_sanskrit": "इति वैन्यस्य राजर्षेः प्रतिनन्द्यार्थवद् वचः।\nपूजितोऽनुगृहीत्वैनं गन्तुं चक्रेऽच्युतो मतिम्॥ ४/२०/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.041.m4a", "display_order": 42}, {"id": 6000084042, "chapter_id": 10084, "verse_number": "४-२०-३६", "content_sanskrit": "देवर्षिपितृगन्धर्वसिद्धचारणपन्नगाः।\nकिन्नराप्सरसोऽमर्त्याः खगा भूतान्यनेकशः॥ ४/२०/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.042.m4a", "display_order": 43}, {"id": 6000084043, "chapter_id": 10084, "verse_number": "४-२०-३७", "content_sanskrit": "यज्ञेश्वरधिया राज्ञा वाग्वित्ताञ्जलिभक्तितः।\nसभाजिता ययुः सर्वे वैकुण्ठानुगतास्ततः॥ ४/२०/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.043.m4a", "display_order": 44}, {"id": 6000084044, "chapter_id": 10084, "verse_number": "४-२०-३८", "content_sanskrit": "भगवानपि राजर्षेः सोपाध्यायस्य पश्यतः।\nहरन्निव मनोऽमुष्य स्वधाम प्रत्यगात् प्रभुः॥ ४/२०/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.044.m4a", "display_order": 45}, {"id": 6000084045, "chapter_id": 10084, "verse_number": "४-२०-३९", "content_sanskrit": "अदृष्टाय नमस्कृत्य स्वस्य संदर्शितात्मने।\nवासुदेवाय देवानां देवाय स्वपुरं ययौ॥ ४/२०/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_020/BhP_04.020.045.m4a", "display_order": 46}, {"id": 6000084046, "chapter_id": 10084, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां चतुर्थस्कन्धे विंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]