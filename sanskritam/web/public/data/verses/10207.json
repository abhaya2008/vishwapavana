[{"id": 6000207000, "chapter_id": 10207, "verse_number": null, "content_sanskrit": "अथ एकादशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000207001, "chapter_id": 10207, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.001.m4a", "display_order": 2}, {"id": 6000207002, "chapter_id": 10207, "verse_number": "१०-११-१", "content_sanskrit": "कथ्यतां भगवन्नेतत्तयोः शापस्य कारणम्।\nयत् तद् विगर्हितं कर्म येन देवऋषेस्तमः॥ १०/११/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.002.m4a", "display_order": 3, "topics": [{"text": "नलकूबरयोः पूर्वेतिहासः, नारदेन नलकूबरमणिग्रीवयोः शापश्च", "range": "१–२२"}]}, {"id": 6000207003, "chapter_id": 10207, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.003.m4a", "display_order": 4}, {"id": 6000207004, "chapter_id": 10207, "verse_number": "१०-११-२", "content_sanskrit": "रुद्रस्यानुचरौ भूत्वा सुदृप्तौ धनदात्मजौ।\nकैलासोपवने रम्ये मन्दाकिन्यां मदोत्कटौ॥ १०/११/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.004.m4a", "display_order": 5}, {"id": 6000207005, "chapter_id": 10207, "verse_number": "१०-११-३", "content_sanskrit": "वारुणीं मदिरां पीत्वा मदाघूर्णितलोचनौ।\nस्‍त्रीजनैरनुगायद्भिश्चेरतुः पुष्पिते वने॥ १०/११/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.005.m4a", "display_order": 6}, {"id": 6000207006, "chapter_id": 10207, "verse_number": "१०-११-४", "content_sanskrit": "अन्तः प्रविश्य गङ्गायामम्भोजवनराजिनि।\nचिक्रीडतुर्युवतिभिर्गजाविव करेणुभिः॥ १०/११/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.006.m4a", "display_order": 7}, {"id": 6000207007, "chapter_id": 10207, "verse_number": "१०-११-५", "content_sanskrit": "यदृच्छया च देवर्षिर्भगवांस्तत्र कौरव।\nअपश्यन्नारदो देवौ क्षीबाणौ समबुद्ध्यत॥ १०/११/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.007.m4a", "display_order": 8}, {"id": 6000207008, "chapter_id": 10207, "verse_number": "१०-११-६", "content_sanskrit": "तं दृष्ट्वा व्रीडिता देव्यो विवस्‍त्राः शापशङ्किताः।\nवासांसि पर्यधुः शीघ्रं विवस्‍त्रौ नैव गुह्यकौ॥ १०/११/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.008.m4a", "display_order": 9}, {"id": 6000207009, "chapter_id": 10207, "verse_number": "१०-११-७", "content_sanskrit": "तौ दृष्ट्वा मदिरामत्तौ श्रीमदान्धौ सुरात्मजौ।\nतयोरनुग्रहार्थाय शापं दास्यन्निदं जगौ॥ १०/११/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.009.m4a", "display_order": 10}, {"id": 6000207010, "chapter_id": 10207, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.010.m4a", "display_order": 11}, {"id": 6000207011, "chapter_id": 10207, "verse_number": "१०-११-८", "content_sanskrit": "न ह्यन्यो जुषतो जोष्याद् बुद्धिभ्रंशो रजोगुणः।\nश्रीमदादभिजात्यादेर्यत्र स्‍त्रीद्यूतमासवम्॥ १०/११/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.011.m4a", "display_order": 12}, {"id": 6000207012, "chapter_id": 10207, "verse_number": "१०-११-९", "content_sanskrit": "हन्यन्ते पशवो यत्र निर्दयैरजितात्मभिः।\nमन्यमानैरिमं देहमजरामृत्यु नश्वरम्॥ १०/११/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.012.m4a", "display_order": 13}, {"id": 6000207013, "chapter_id": 10207, "verse_number": "१०-११-१०", "content_sanskrit": "देवसंज्ञितमप्यन्ते कृमिविड्भस्मसंज्ञितम्।\nभूतध्रुक् कुरुते स्वार्थं किं वेद निरयो यतः॥ १०/११/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.013.m4a", "display_order": 14}, {"id": 6000207014, "chapter_id": 10207, "verse_number": "१०-११-११", "content_sanskrit": "देहः किमन्नदातुः स्यान्निषेक्तुर्मातुरेव वा।\nमातुः पितुर्वा विक्रेतुर्बलिनोऽग्नेः शुनोऽपि वा॥ १०/११/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.014.m4a", "display_order": 15}, {"id": 6000207015, "chapter_id": 10207, "verse_number": "१०-११-१२", "content_sanskrit": "एवं साधारणं देहमव्यक्तप्रभवाप्ययम्।\nको विद्वानात्मसात् कृत्वा हन्ति जन्तून् ऋतेऽसतः॥ १०/११/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.015.m4a", "display_order": 16}, {"id": 6000207016, "chapter_id": 10207, "verse_number": "१०-११-१३", "content_sanskrit": "मन्यमानैरिमं देहमजरामृत्यु नश्वरम्।\nदेवसंज्ञितमप्यन्ते कृमिविड्‍भस्मसंज्ञितम्॥ १०/११/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.016.m4a", "display_order": 17}, {"id": 6000207017, "chapter_id": 10207, "verse_number": "१०-११-१४", "content_sanskrit": "असतः श्रीमदान्धस्य दारिद्र्यं परमाञ्जनम्।\nआत्मौपम्येन भूतानि दरिद्रः परमीक्षते॥ १०/११/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.017.m4a", "display_order": 18}, {"id": 6000207018, "chapter_id": 10207, "verse_number": "१०-११-१५", "content_sanskrit": "यथा कण्टकविद्धाङ्गो जन्तोर्नेच्छति तां व्यथाम्।\nजीवसाम्यं गतो लिङ्गैर्न तथाऽविद्धकण्टकः॥ १०/११/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.018.m4a", "display_order": 19}, {"id": 6000207019, "chapter_id": 10207, "verse_number": "१०-११-१६", "content_sanskrit": "दरिद्रो निरहंस्तम्भो मुक्तः सर्वमदैरिह।\nकृच्छ्रं यदृच्छयाऽप्नोति तद्धि तस्य परं तपः॥ १०/११/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.019.m4a", "display_order": 20}, {"id": 6000207020, "chapter_id": 10207, "verse_number": "१०-११-१७", "content_sanskrit": "नित्यं क्षुत्क्षामदेहस्य दरिद्रस्यान्नकाङ्क्षिणः।\nइन्द्रियाण्यनु शुष्यन्ति हिंसाऽपि विनिवर्तते॥ १०/११/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.020.m4a", "display_order": 21}, {"id": 6000207021, "chapter_id": 10207, "verse_number": "१०-११-१८", "content_sanskrit": "दरिद्रस्यैव युज्यन्ते साधवः समदर्शिनः।\nसद्भिः क्षिणोति तत्तर्षं तत आराद्धि सिद्ध्यति॥ १०/११/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.021.m4a", "display_order": 22}, {"id": 6000207022, "chapter_id": 10207, "verse_number": "१०-११-१९", "content_sanskrit": "साधूनां समचित्तानां मुकुन्दचरणैषिणाम्।\nउपेक्ष्यैः किं धनस्तम्भैरसद्भिरसदाश्रयैः॥ १०/११/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.022.m4a", "display_order": 23}, {"id": 6000207023, "chapter_id": 10207, "verse_number": "१०-११-२०", "content_sanskrit": "तदहं मत्तयोर्माध्व्या वारुण्या श्रीमदान्धयोः।\nतमोमदं हरिष्यामि स्‍त्रैणयोरजितात्मनोः॥ १०/११/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.023.m4a", "display_order": 24}, {"id": 6000207024, "chapter_id": 10207, "verse_number": "१०-११-२१", "content_sanskrit": "यदिमौ लोकपालस्य पुत्रौ भूत्वा तमःप्लुतौ।\nन विवाससमात्मानं विजानीतः सुदुर्मदौ॥ १०/११/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.024.m4a", "display_order": 25}, {"id": 6000207025, "chapter_id": 10207, "verse_number": "१०-११-२२", "content_sanskrit": "अतोऽर्हथः स्थावरतां स्यातां नैवं यथा पुनः।\nस्मृतिः स्यान्मत्प्रसादेन तत्रापि मदनुग्रहात्॥ १०/११/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.025.m4a", "display_order": 26}, {"id": 6000207026, "chapter_id": 10207, "verse_number": "१०-११-२३", "content_sanskrit": "वासुदेवस्य सान्निध्यं लब्ध्वा दिव्यशरच्छते।\nवृत्ते स्वर्लोकतां भूयो लब्ध्वा भक्तौ भविष्यतः॥ १०/११/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.026.m4a", "display_order": 27, "topics": [{"text": "नारदशापेन यमलार्जुनवृक्षतां प्राप्तयोस्तयोर्मध्ये बद्धोलूखलेन श्रीकृष्णेन प्रविश्य तयोरुन्मूलनम्", "range": "२३–२८"}]}, {"id": 6000207027, "chapter_id": 10207, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.027.m4a", "display_order": 28}, {"id": 6000207028, "chapter_id": 10207, "verse_number": "१०-११-२४", "content_sanskrit": "स एवमुक्त्वा देवर्षिर्गतो नारायणाश्रमम्।\nनलकूबरमणिग्रीवावासतुर्यमलार्जुनौ॥ १०/११/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.028.m4a", "display_order": 29}, {"id": 6000207029, "chapter_id": 10207, "verse_number": "१०-११-२५", "content_sanskrit": "ऋषेर्भागवतमुख्यस्य सत्यं कर्तुं वचो हरिः।\nजगाम शनकैस्तत्र यत्रास्तां यमलार्जुनौ॥ १०/११/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.029.m4a", "display_order": 30}, {"id": 6000207030, "chapter_id": 10207, "verse_number": "१०-११-२६", "content_sanskrit": "देवर्षिर्मे प्रियतमो यदिमौ धनदात्मजौ।\nतत् तथा साधयिष्यामि यद् गीतं तन्महात्मना॥ १०/११/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.030.m4a", "display_order": 31}, {"id": 6000207031, "chapter_id": 10207, "verse_number": "१०-११-२७", "content_sanskrit": "इत्यन्तरेणार्जुनयोः कृष्णस्तु यमयोर्ययौ।\nआत्मनिर्वेशमात्रेण तिर्यग्गतमुलूखलम्॥ १०/११/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.031.m4a", "display_order": 32}, {"id": 6000207032, "chapter_id": 10207, "verse_number": "१०-११-२८", "content_sanskrit": "बालेन निष्कृष्टमुलूखलं तद् दामोदरेण तरसोत्कलिताङ्घ्रिबन्धौ।\nनिष्पेततुः पवनविक्रमितातिवेलस्कन्धप्रवालविटपौ कृतचण्डशब्दौ॥ १०/११/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.032.m4a", "display_order": 33}, {"id": 6000207033, "chapter_id": 10207, "verse_number": "१०-११-२९", "content_sanskrit": "तत्र श्रिया परमया ककुभः स्फुरन्तौ सिद्धावुपेत्य कुजयोरिव जातवेदौ।\nकृष्णं प्रणम्य शिरसाऽखिललोकनाथं बद्धाञ्जली विरजसाविदमूचतुः स्म॥ १०/११/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.033.m4a", "display_order": 34, "topics": [{"text": "तयोर्वृक्षयोः स्थिताभ्यां नलकूबरमणिग्रीवाभ्यां कृष्णस्तुतिः", "range": "२९–४३"}]}, {"id": 6000207034, "chapter_id": 10207, "verse_number": null, "content_sanskrit": "यक्षावूचतुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.034.m4a", "display_order": 35}, {"id": 6000207035, "chapter_id": 10207, "verse_number": "१०-११-३०", "content_sanskrit": "कृष्ण कृष्ण महायोगिन् त्वमाद्यः पुरुषः परः।\nव्यक्ताव्यक्तमिदं विश्वं रूपं ते ब्राह्मणा विदुः॥ १०/११/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.035.m4a", "display_order": 36}, {"id": 6000207036, "chapter_id": 10207, "verse_number": "१०-११-३१", "content_sanskrit": "त्वमेकः सर्वभूतानां देह आत्मेन्द्रियेश्वरः।\nत्वमेव कालो भगवान् विष्णुरव्यय ईश्वरः॥ १०/११/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.036.m4a", "display_order": 37}, {"id": 6000207037, "chapter_id": 10207, "verse_number": "१०-११-३२", "content_sanskrit": "त्वं महान् प्रकृतिः सूक्ष्मा रजस्सत्त्वतमोमयी।\nत्वमेव पुरुषोऽध्यक्षः सर्वक्षेत्रविकारवित्॥ १०/११/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.037.m4a", "display_order": 38}, {"id": 6000207038, "chapter_id": 10207, "verse_number": "१०-११-३३", "content_sanskrit": "गृह्यमाणस्त्वमग्राह्यो विकारैः प्राकृतैर्गुणैः।\nको न्विहार्हति विज्ञातुं प्राक् सिद्धं गुणसंस्थितेः॥ १०/११/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.038.m4a", "display_order": 39}, {"id": 6000207039, "chapter_id": 10207, "verse_number": "१०-११-३४", "content_sanskrit": "तस्मै तुभ्यं भगवते वासुदेवाय वेधसे।\nआत्मद्योतैर्गुणैश्छन्नमहिम्ने ब्रह्मणे नमः॥ १०/११/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.039.m4a", "display_order": 40}, {"id": 6000207040, "chapter_id": 10207, "verse_number": "१०-११-३५", "content_sanskrit": "यस्यावतारा ज्ञायन्ते शरीरेष्वशरीरिणः।\nतैस्तैरतुल्यातिशयैस्तिर्यग्योनिष्वसङ्गतैः॥ १०/११/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.040.m4a", "display_order": 41}, {"id": 6000207041, "chapter_id": 10207, "verse_number": "१०-११-३६", "content_sanskrit": "स भवान् सर्वलोकस्य भवाय प्रभवाय च।\nअवतीर्णोंऽशभागेन साम्प्रतं पतिराशिषाम्॥ १०/११/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.041.m4a", "display_order": 42}, {"id": 6000207042, "chapter_id": 10207, "verse_number": "१०-११-३७", "content_sanskrit": "नमः परमकल्याण नमस्ते विश्वमङ्गल।\nवासुदेवाय शान्ताय यदूनां पतये नमः॥ १०/११/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.042.m4a", "display_order": 43}, {"id": 6000207043, "chapter_id": 10207, "verse_number": "१०-११-३८", "content_sanskrit": "अनुजानीहि नौ भूमन् सदाऽनुचरकिङ्करौ।\nदर्शनं नौ भगवत ऋषेरासीदनुग्रहात्॥ १०/११/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.043.m4a", "display_order": 44}, {"id": 6000207044, "chapter_id": 10207, "verse_number": "१०-११-३९", "content_sanskrit": "वाणी गुणानुकथने श्रवणौ कथायां हस्तौ च कर्मसु मनस्तव पादयोर्नौ।\nस्मृत्यां शिरस्तव सुरप्रवर प्रणामे दृष्टिः सतां दर्शनेऽस्तु भवत्तनूनाम्॥ १०/११/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.044.m4a", "display_order": 45}, {"id": 6000207045, "chapter_id": 10207, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.045.m4a", "display_order": 46}, {"id": 6000207046, "chapter_id": 10207, "verse_number": "१०-११-४०", "content_sanskrit": "इत्थं सङ्कीर्तितस्ताभ्यां भगवान् गोकुलेश्वरः।\nदाम्ना चोलूखले बद्धः प्रहसन्नाह गुह्यकौ॥ १०/११/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.046.m4a", "display_order": 47}, {"id": 6000207047, "chapter_id": 10207, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.047.m4a", "display_order": 48}, {"id": 6000207048, "chapter_id": 10207, "verse_number": "१०-११-४१", "content_sanskrit": "ज्ञातं मया पुरैवेतद् ऋषिणा करुणात्मना।\nयच्छ्रीमदान्धयोर्वाग्भिः शापः सानुग्रहः कृतः॥ १०/११/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.048.m4a", "display_order": 49}, {"id": 6000207049, "chapter_id": 10207, "verse_number": "१०-११-४२", "content_sanskrit": "साधूनां समचित्तानां सुतरां मत्कृतात्मनाम्।\nदर्शनान्नो भवेद् बन्धः पुंसोऽक्ष्णोः सवितुर्यथा॥ १०/११/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.049.m4a", "display_order": 50}, {"id": 6000207050, "chapter_id": 10207, "verse_number": "१०-११-४३", "content_sanskrit": "तद् गच्छतं मत्परमौ नरवाहनिकेतनम्।\nसञ्जातो मयि भावो वामीप्सितः परमोत्सवः॥ १०/११/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.050.m4a", "display_order": 51}, {"id": 6000207051, "chapter_id": 10207, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.051.m4a", "display_order": 52}, {"id": 6000207052, "chapter_id": 10207, "verse_number": "१०-११-४४", "content_sanskrit": "इत्युक्तौ तौ परिक्रम्य प्रणम्य च पुनः पुनः।\nबद्धोलूखलमामन्त्र्य जग्मतुर्दिशमुत्तराम्॥ १०/११/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_011/BhP_10.011.052.m4a", "display_order": 53}, {"id": 6000207053, "chapter_id": 10207, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे एकादशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]