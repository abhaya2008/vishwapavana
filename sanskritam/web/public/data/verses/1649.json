[{"id": 2029748, "chapter_id": 1649, "verse_number": "३-२८७-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2029749, "chapter_id": 1649, "verse_number": "३-२८७-१", "content_sanskrit": "ततः प्रहस्तः सहसा समभ्येत्य विभीषणम्।\nगदया ताडयामास विनद्य रणकर्कशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2029750, "chapter_id": 1649, "verse_number": "३-२८७-२", "content_sanskrit": "स तयाऽभिहतो धीमान्गदया भीमवेगया।\nनाकम्पत महाबाहुर्हिमवानिव सुस्थिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2029751, "chapter_id": 1649, "verse_number": "३-२८७-३", "content_sanskrit": "ततः प्रगृह्यविपुलां शतघण्टां विभीषणः।\nअनुमन्त्र्य महाशक्तिं चिक्षेपास् शिरः प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2029752, "chapter_id": 1649, "verse_number": "३-२८७-४", "content_sanskrit": "पतन्त्या स तया वेगाद्राक्षसोऽशनिवेगया।\nहृतोत्तामङ्गो ददृशे वातरुग्ण इव द्रुमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2029753, "chapter_id": 1649, "verse_number": "३-२८७-५", "content_sanskrit": "तं दृष्ट्वा निहतं सङ्ख्ये प्रहस्तं क्षणदाचरम्।\nअभिदुद्राव धूम्राक्षो वेगेन महता कपीन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2029754, "chapter_id": 1649, "verse_number": "३-२८७-६", "content_sanskrit": "तस् मेघोपमं सैन्यमापतद्भीमदर्शनम्।\nदृष्ट्वैव सहसा दीर्णा रणे वानरपुङ्गवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2029755, "chapter_id": 1649, "verse_number": "३-२८७-७", "content_sanskrit": "ततस्तान्सहसा दीर्णान्दृष्ट्वा वानरपुङ्गवान्।\nनिर्ययौ कपिशार्दूलो हनूमान्मारुतात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2029756, "chapter_id": 1649, "verse_number": "३-२८७-८", "content_sanskrit": "तं दृष्ट्वाऽवस्थितं सङ्ख्ये हरयः पवनात्मजम्।\nमहत्या त्वरया राजत्संन्यवर्तन्त सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2029757, "chapter_id": 1649, "verse_number": "३-२८७-९", "content_sanskrit": "ततः शब्दो महानासीत्तुमुलो रोमहर्षणः।\nरामरावणसैन्यानामन्योन्यमभिधावताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2029758, "chapter_id": 1649, "verse_number": "३-२८७-१०", "content_sanskrit": "तस्मिन्प्रवृत्ते संग्रामे घोरे रुधिरकर्दमे।\nक्षूम्राक्षः कपिसैन्यं तद्द्रावयामास पत्रिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2029759, "chapter_id": 1649, "verse_number": "३-२८७-११", "content_sanskrit": "तं स रक्षोमहामात्रमापतन्तं सपत्नजित्।\nप्रतिजग्राह हनुमांस्तरसा पवनात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2029760, "chapter_id": 1649, "verse_number": "३-२८७-१२", "content_sanskrit": "तयोर्युद्धमभूदधोरं हरिराक्षसवीरयोः।\nजीगीषतोर्युधाऽन्योन्यमिन्द्रप्रह्लादयोरिवं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2029761, "chapter_id": 1649, "verse_number": "३-२८७-१३", "content_sanskrit": "कगदाभिः परिघैश्चैव राक्षसो जघ्निवान्कपिम्।\nकपिश्च जघ्निवान्रः सस्कन्धविटपैर्द्रुमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2029762, "chapter_id": 1649, "verse_number": "३-२८७-१४", "content_sanskrit": "ततस्तमतिकोपेन साश्वं सरथसारथिम्।\nधूम्राक्षमवधीत्क्रुद्धो हनूमान्मारुतात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2029763, "chapter_id": 1649, "verse_number": "३-२८७-१५", "content_sanskrit": "ततस्तं निहतं दृष्ट्वा धूम्राक्षं राक्षसोत्तमम्।\nहरयो जातविश्रम्भा जघ्नुरन्ये च सैनिकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2029764, "chapter_id": 1649, "verse_number": "३-२८७-१६", "content_sanskrit": "ते वध्यमाना हरिभिर्बलिभिर्जितकाशिभिः।\nराक्षसा भग्नसंकल्पा लङ्कामभ्यपतन्भयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2029765, "chapter_id": 1649, "verse_number": "३-२८७-१७", "content_sanskrit": "तेऽभिपत्य पुरं भग्ना हतशेषा निशाचराः।\nसर्वं राज्ञे यथावृत्तं रावणाय न्यवेदयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2029766, "chapter_id": 1649, "verse_number": "३-२८७-१८", "content_sanskrit": "श्रुत्वा तु रावणस्तेभ्यः प्रहस्तं निहतं युधि।\nधूम्राक्षं च महेष्वासं ससैन्यं सहराक्षसैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2029767, "chapter_id": 1649, "verse_number": "३-२८७-१९", "content_sanskrit": "सुदीर्घमिव निःश्वस्य समुत्पत्य वरासनात्।\nउवाच कुम्भकर्णस्य कर्मकालोऽयमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2029768, "chapter_id": 1649, "verse_number": "३-२८७-२०", "content_sanskrit": "इत्येवमुक्त्वा विविधैर्वादित्रैः सुमहास्वनैः।\nशयानमतिनिद्रालुं कुम्भकर्णमबोधयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2029769, "chapter_id": 1649, "verse_number": "३-२८७-२१", "content_sanskrit": "प्रबोध्य महता चैनं यत्नेनाऽऽगतसाध्वसः।\nस्वस्थमासीनमव्यग्रं विनिद्रं राक्षसाधिपः।\nततोऽब्रवीद्दशग्रीवः कुम्भकर्णं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2029770, "chapter_id": 1649, "verse_number": "३-२८७-२२", "content_sanskrit": "धन्योसि यस्य ते निद्रा कुम्भकर्णेयमीदृशी।\nय इदं दारुणं कालं न जानीषे महाभयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2029771, "chapter_id": 1649, "verse_number": "३-२८७-२३", "content_sanskrit": "एष तीर्त्वाऽर्णवं रामः सेतुना हरिभिः सह।\nअवमत्येह नः सर्वान्करोति कदनं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2029772, "chapter_id": 1649, "verse_number": "३-२८७-२४", "content_sanskrit": "मया त्वपहृता भार्या सीता नामास्य जानकी।\nतां नेतुं स इहायातो बद्ध्वा सेतुं महार्णवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2029773, "chapter_id": 1649, "verse_number": "३-२८७-२५", "content_sanskrit": "तेन चैव प्रहस्तादिर्महान्नः स्वजनो हतः।\nतस्य नान्यो निहन्ताऽस्ति त्वामृतेशत्रुकर्शन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2029774, "chapter_id": 1649, "verse_number": "३-२८७-२६", "content_sanskrit": "सदंशितोऽभिनिर्याहि त्वमद्य बलिनांवर।\nरामादीन्समरे सर्वाञ्जहि शत्रूनरिंदम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2029775, "chapter_id": 1649, "verse_number": "३-२८७-२७", "content_sanskrit": "दूषणावरजौ चैव वज्रवेगप्रमाथिनौ।\nतौ त्वां बलेन महता सहितावनुयास्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2029776, "chapter_id": 1649, "verse_number": "३-२८७-२८", "content_sanskrit": "इत्युक्त्वा राक्षुसपतिः कुम्भकर्णं तरस्विनम्।\nसंदिदेशेतिकर्तव्ये वज्रवेगप्रमाथिनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2029777, "chapter_id": 1649, "verse_number": "३-२८७-२९", "content_sanskrit": "तथ्त्युक्त्वा युतौ वीरौ रावणं दूषाणानुजौ।\nकुम्भकर्णं पुरस्कृत्य तूर्णं निर्ययतुः पुरात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2029778, "chapter_id": 1649, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि रामोपाख्यानपर्वणि सप्ताशीत्यधिकद्विशततमोऽध्यायः ॥ २८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]