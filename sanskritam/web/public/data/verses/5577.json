[{"id": 2214165, "chapter_id": 5577, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2214166, "chapter_id": 5577, "verse_number": "१", "content_sanskrit": "एवं वृष्ण्यन्धककुले श्रुत्वा मौसलमाहवम् ।\nपाण्डवाः किमकुर्वन्त तथा कृष्णे दिवं गते\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2214167, "chapter_id": 5577, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2214168, "chapter_id": 5577, "verse_number": "२", "content_sanskrit": "श्रुत्वैवं कौरवो राजा वृष्णीनां कदनं महत् ।\nप्रस्थाने मतिमाधाय वाक्यमर्जुनमब्रवीत्\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2214169, "chapter_id": 5577, "verse_number": "३", "content_sanskrit": "कालः पचति भूतानि सर्वाण्येव महामते ।\nकालपाशमहं मन्ये त्वमपि द्रष्टुमर्हसि\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2214170, "chapter_id": 5577, "verse_number": "४", "content_sanskrit": "इत्युक्तः स तु कौन्तेयः कालः काल इति ब्रुवन् ।\nअन्वपद्यत तद्वाक्यं भ्रातुर्ज्येष्ठस्य धीमतः\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2214171, "chapter_id": 5577, "verse_number": "५", "content_sanskrit": "अर्जुनस्य मतं ज्ञात्वा भीमसेनो यमौ तथा ।\nअन्वपद्यन्त तद्वाक्यं यदुक्तं सव्यसाचिना\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2214172, "chapter_id": 5577, "verse_number": "६", "content_sanskrit": "ततो युयुत्सुमानाय्य प्रव्रजन् धर्मकाम्यया ।\nराज्यं परिददौ सर्वं वैश्यापुत्रे युधिष्ठिरः\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2214173, "chapter_id": 5577, "verse_number": "७", "content_sanskrit": "अभिषिच्य स्वराज्ये च राजानं च परिक्षितम् ।\nदुःखार्तश्चाब्रवीद् राजा सुभद्रां पाण्डवाग्रजः\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2214174, "chapter_id": 5577, "verse_number": "८", "content_sanskrit": "एष पुत्रस्य पुत्रस्ते कुरुराजो भविष्यति ।\nयदूनां परिशेषश्च वज्रो राजा कृतश्च ह\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2214175, "chapter_id": 5577, "verse_number": "९", "content_sanskrit": "अभिषिच्य हस्तिनपुरे शक्रप्रस्थे च यादवः ।\nवज्रो राजा त्वया रक्ष्यो मा चाधर्मे मनः कृथाः\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2214176, "chapter_id": 5577, "verse_number": "१०", "content_sanskrit": "इत्युक्त्वा धर्मराजः स वासुदेवस्य धीमतः ।\nमातुलस्य च वृद्धस्य रामादीनां तथैव च\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2214177, "chapter_id": 5577, "verse_number": "११", "content_sanskrit": "भ्रातृभिः सह धर्मात्मा कृत्वोदकमतन्द्रितः ।\nश्राद्धान्युद्दिश्य सर्वेषां चकार विधिवत् तदा\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2214178, "chapter_id": 5577, "verse_number": "१२", "content_sanskrit": "द्वैपायनं नारदं च मार्कण्डेयं तपोधनम् ।\nभारद्वाजं याज्ञवल्क्यं हरिमुद्दिश्य यत्नवान्\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2214179, "chapter_id": 5577, "verse_number": "१३", "content_sanskrit": "अभोजयत्स्वादु भोज्यं कीर्तयित्वा च शार्ङ्गिणम्\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2214180, "chapter_id": 5577, "verse_number": "१४", "content_sanskrit": "ददौ रत्नानि वासांसि ग्रामानश्वान् रथांस्तथा ।\nस्त्रियश्च द्विजमुख्येभ्यस्तदा शतसहस्रशः\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2214181, "chapter_id": 5577, "verse_number": "१५", "content_sanskrit": "कृपमभ्यर्च्य च गुरुमथ पौरपुरस्कृतम् ।\n(आहूय भरतश्रेष्ठ सन्निवेश्यासने तदा\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2214182, "chapter_id": 5577, "verse_number": "१६", "content_sanskrit": "शिष्यं परिक्षितं तस्मै ददौ भरतसत्तमः\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2214183, "chapter_id": 5577, "verse_number": "१७", "content_sanskrit": "ततस्तु प्रकृतीः सर्वाः समानाय्य युधिष्ठिरः ।\nसर्वमाचष्ट राजर्षिश्चिकीर्षितमथात्मनः\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2214184, "chapter_id": 5577, "verse_number": "१८", "content_sanskrit": "ते श्रुत्वैव वचस्तस्य पौरजानपदा जनाः ।\nभृशमुद्विग्नमनसो नाभ्यनन्दन्त तद्वचः\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2214185, "chapter_id": 5577, "verse_number": "१९", "content_sanskrit": "नैव कर्तव्यमिति ते तदोचुस्तं जनाधिपम् ।\nन च राजा तथाऽकार्षीत्कालपर्यायधर्मवित्\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2214186, "chapter_id": 5577, "verse_number": "२०", "content_sanskrit": "ततोऽनुमान्य धर्मात्मा पौरजानपदं जनम् ।\nगमनाय मतिं चक्रे कृष्णस्य गमनादपि\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2214187, "chapter_id": 5577, "verse_number": "२१", "content_sanskrit": "वर्तमाने विवादे तु वास्तुविक्रयिणं प्रति ।\nधनेच्छा युगपत्प्राप्ता क्षेत्रवत्स्वामिभूभृताम्\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2214188, "chapter_id": 5577, "verse_number": "२२", "content_sanskrit": "प्राप्तं कलियुगं ज्ञात्वा सहदेवो हसन्निव ।\nराज्ञस्तु कथयामास धर्मो नष्टस्तु सङ्करः\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2214189, "chapter_id": 5577, "verse_number": "२३", "content_sanskrit": "श्रुत्वा तु दुर्मना राजा पर्याप्तं जीवनं मम ।\nइति स्म राजा कौरव्यो धर्मपुत्रो युधिष्ठिरः\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2214190, "chapter_id": 5577, "verse_number": "२४", "content_sanskrit": "उत्सृज्याभरणान्यङ्गात् जगृहे वल्कलान्युत\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2214191, "chapter_id": 5577, "verse_number": "२५", "content_sanskrit": "भीमार्जुनयमाश्चैव द्रौपदी च यशस्विनी ।\nतथैव जगृहुः सर्वे वल्कलानि नराधिप\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2214192, "chapter_id": 5577, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां महाप्रस्थानिकपर्वणि प्रथमोऽध्यायः ॥१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]