[{"id": 2177676, "chapter_id": 4752, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2177677, "chapter_id": 4752, "verse_number": "१", "content_sanskrit": "दृष्ट्वैव मुनिशार्दूलौ तावग्निसमतेजसौ ।\nगाण्डीवधन्वा सञ्चिन्त्य प्राप्तकालं महारथः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2177678, "chapter_id": 4752, "verse_number": "२", "content_sanskrit": "सञ्जहार शरं दिव्यं त्वरमाणो धनञ्जयः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2177679, "chapter_id": 4752, "verse_number": "३", "content_sanskrit": "उवाच स नरश्रेष्ठः प्राञ्जलिस्तावुभावृषी\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2177680, "chapter_id": 4752, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2177681, "chapter_id": 4752, "verse_number": "४", "content_sanskrit": "प्रमुक्तमस्त्रमस्त्रेण शाम्यतामिति वै मया\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2177682, "chapter_id": 4752, "verse_number": "५", "content_sanskrit": "संहृते परमास्त्रेऽस्मिन् सर्वानस्मानशेषतः ।\nपापकर्मा ध्रुवं द्रौणिः प्रधक्ष्यत्यस्त्रतेजसा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2177683, "chapter_id": 4752, "verse_number": "६", "content_sanskrit": "यदत्र हितमस्माकं लोकानां चैव सर्वथा ।\nभवन्तौ देवसङ्काशौ तथा सम्मन्तुमर्हतः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2177684, "chapter_id": 4752, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2177685, "chapter_id": 4752, "verse_number": "७", "content_sanskrit": "इत्युक्त्वा सञ्जहारास्त्रं पुनरेव धनञ्जयः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2177686, "chapter_id": 4752, "verse_number": "८", "content_sanskrit": "संहारो दुष्करस्तस्य देवैरपि च संयुगे ।\nविसृष्टस्य रणे तस्य परमास्त्रस्य सङ्ग्रहे\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2177687, "chapter_id": 4752, "verse_number": "९", "content_sanskrit": "अशक्तः पाण्डवादन्यः साक्षादपि शतक्रतुः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2177688, "chapter_id": 4752, "verse_number": "१०", "content_sanskrit": "ब्रह्मतेजोद्भवं तद्धि विसृष्टमकृतात्मना ।\nन शक्यमावर्तयितुं ब्रह्मचारिव्रतादृते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2177689, "chapter_id": 4752, "verse_number": "११", "content_sanskrit": "अचीर्णब्रह्मचर्यो यः सृष्ट्वाऽऽवर्तयते पुनः ।\nतदस्त्रं सानुबन्धस्य मूर्धानं तस्य कृन्तति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2177690, "chapter_id": 4752, "verse_number": "१२", "content_sanskrit": "ब्रह्मचारी व्रती चापि दुरवापमवाप्य तत् ।\nपरमव्यसनार्तोऽपि नार्जुनोऽस्त्रं व्यमुञ्चत\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2177691, "chapter_id": 4752, "verse_number": "१३", "content_sanskrit": "सत्यव्रतधरः शूरो ब्रह्मचारी च पाण्डवः ।\nगुरुवर्ती च तेनास्त्रं सञ्जहारार्जुनः पुनः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2177692, "chapter_id": 4752, "verse_number": "१४", "content_sanskrit": "द्रौणिरप्यथ सम्प्रेक्ष्य सोऽन्तरा तावृषी स्थितौ ।\nन शशाक पुनर्घोरमस्त्रं संहर्तुमोजसा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2177693, "chapter_id": 4752, "verse_number": "१५", "content_sanskrit": "अशक्तः प्रतिसंहारे परमास्त्रस्य संयुगे ।\nद्रौणिर्दीनमना राजन् द्वैपायनमभाषत\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2177694, "chapter_id": 4752, "verse_number": "", "content_sanskrit": "द्रौणिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2177695, "chapter_id": 4752, "verse_number": "१६", "content_sanskrit": "उत्तमव्यसनार्तेन प्राणत्राणमभीप्सुना ।\nमयेदमस्त्रमुत्सृष्टं भीमसेनभयान्मुने\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2177696, "chapter_id": 4752, "verse_number": "१७", "content_sanskrit": "अधर्मश्च कृतोऽनेन धार्तराष्ट्रं जिघांसता ।\nमिथ्याचारेण भगवन् भीमसेनेन संयुगे\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2177697, "chapter_id": 4752, "verse_number": "१८", "content_sanskrit": "अतः सृष्टमिदं ब्रह्मन् मयाऽस्त्रमकृतात्मना ।\nतस्य भूयोऽपि संहारं कर्तुं नाहमिहोत्सहे\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2177698, "chapter_id": 4752, "verse_number": "१९", "content_sanskrit": "निसृष्टं हि मया दिव्यमेतदस्त्रं दुरासदम् ।\nअपाण्डवायेति मुने वह्नितेजोऽनुमन्त्र्य वै\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2177699, "chapter_id": 4752, "verse_number": "२०", "content_sanskrit": "तदिदं पाण्डुपुत्राणामन्तायैव सुसंहितम् ।\nअद्य पाण्डुसुतान् सर्वान् जीविताद् भ्रंशयिष्यति\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2177700, "chapter_id": 4752, "verse_number": "२१", "content_sanskrit": "कृतं पापमिदं ब्रह्मन् क्रोधेनाविष्टचेतसा ।\nवधमाशास्य पार्थानां मयाऽस्त्रं सृजता प्रभो\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2177701, "chapter_id": 4752, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2177702, "chapter_id": 4752, "verse_number": "२२", "content_sanskrit": "अस्त्रं ब्रह्मशिरस्तात विद्वान् पार्थो धनञ्जयः ।\nउत्सृष्टवानहिंसार्थं न रोषेण तवाहवे\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2177703, "chapter_id": 4752, "verse_number": "२३", "content_sanskrit": "अस्त्रमस्त्रेण तु रणे तव संशमयिष्यता ।\nविसृष्टमर्जुनेनेदं पुनश्च प्रतिसंहृतम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2177704, "chapter_id": 4752, "verse_number": "२४", "content_sanskrit": "ब्रह्मास्त्रमप्यवाप्यैतद् उपदेशात् पितुस्तव ।\nक्षत्रधर्मान्महाबुद्धिर्नाकम्पत धनञ्जयः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2177705, "chapter_id": 4752, "verse_number": "२५", "content_sanskrit": "एवं धृतिमतः साधोः सर्वास्त्रविदुषः सतः ।\nसभ्रातृबन्धोः कस्मात् त्वं वधमस्य चिकीर्षसि\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2177706, "chapter_id": 4752, "verse_number": "२६", "content_sanskrit": "अस्त्रं ब्रह्मशिरो यत्र परमास्त्रेण बाध्यते ।\nसमा द्वादश पर्जन्यस्तद्राष्ट्रे नाभिवर्षति\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2177707, "chapter_id": 4752, "verse_number": "२७", "content_sanskrit": "एतदर्थं महाबाहुः शक्तिमानपि पाण्डवः ।\nउपसंहृतवानस्त्रं प्रजाहितचिकीर्षया\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2177708, "chapter_id": 4752, "verse_number": "२८", "content_sanskrit": "पाण्डवास्त्वं च राष्ट्रं च सदा संरक्ष्यमेव नः ।\nतस्मात् संहर दिव्यं त्वमस्त्रमेतन्महाभुज\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2177709, "chapter_id": 4752, "verse_number": "२९", "content_sanskrit": "अरोषस्तव चैवास्तु पार्थाः सन्तु निरामयाः ।\nन ह्यधर्मेण राजर्षिः पाण्डवो जेतुमिच्छति\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2177710, "chapter_id": 4752, "verse_number": "३०", "content_sanskrit": "मणिं चैनं प्रयच्छैभ्यो यस्ते शिरसि तिष्ठति ।\nएतदादाय ते प्राणान् प्रतिदास्यन्ति पाण्डवाः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2177711, "chapter_id": 4752, "verse_number": "", "content_sanskrit": "द्रौणिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2177712, "chapter_id": 4752, "verse_number": "३१", "content_sanskrit": "पाण्डवैर्यानि रत्नानि यद्वाऽन्यत् कौरवैर्धनम् ।\nअवाप्तानीह तेभ्योऽयं मणिर्मम विशिष्यते\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2177713, "chapter_id": 4752, "verse_number": "३२", "content_sanskrit": "यमाबध्य भयं नास्ति शस्त्रव्याधिक्षुधाश्रयम् ।\nदेवेभ्यो दानवेभ्यो वा नागेभ्यो वा कदाचन\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2177714, "chapter_id": 4752, "verse_number": "३३", "content_sanskrit": "न च रक्षोगणभयं न तस्करभयं तथा ।\nएवं वीर्यो मणिरयं न मे त्याज्यः कथञ्चन\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2177715, "chapter_id": 4752, "verse_number": "३४", "content_sanskrit": "यत् तु मे भगवानाह तन्मे कार्यमनन्तरम् ।\nअयं मणिरयं चाहमिषीका तु पतिष्यति\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2177716, "chapter_id": 4752, "verse_number": "३५", "content_sanskrit": "गर्भेषु पाण्डवेयानाममोघं चैतदुत्तमम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2177717, "chapter_id": 4752, "verse_number": "३६", "content_sanskrit": "न च शक्नोमि भगवन् संहर्तुं पुनरुद्यतम् ।\nन च वाक्यं भगवतो न करिष्ये महामुने\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2177718, "chapter_id": 4752, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2177719, "chapter_id": 4752, "verse_number": "३७", "content_sanskrit": "प्राह द्रोणसुतं तत्र व्यासः परमदुर्मनाः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2177720, "chapter_id": 4752, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2177721, "chapter_id": 4752, "verse_number": "३८", "content_sanskrit": "एवं कुरु न चान्यत्र बुद्धिः कार्या कथञ्चन ।\nगर्भेषु पाण्डवेयानां विसृज्यैतदुपारम\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2177722, "chapter_id": 4752, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2177723, "chapter_id": 4752, "verse_number": "३९", "content_sanskrit": "तमुवाच हृषीकेशः पाण्डवानां हिते रतः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2177724, "chapter_id": 4752, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2177725, "chapter_id": 4752, "verse_number": "४०", "content_sanskrit": "भविष्यमेकमुत्सृज्य गर्भेष्वस्त्रं निपात्यताम् ।\nअहमेकं ददाम्येषां पिण्डदं कीर्तिवर्धनम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2177726, "chapter_id": 4752, "verse_number": "४१", "content_sanskrit": "राजर्षिं पुण्यकर्माणमनेकक्रतुयाजिनम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2177727, "chapter_id": 4752, "verse_number": "४२", "content_sanskrit": "एवं कुरु न चान्या ते बुद्धिः कार्या कथञ्चन ।\nआगर्भात् पाण्डवेयानां कृत्वा पातं विनङ्क्ष्यति\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2177728, "chapter_id": 4752, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2177729, "chapter_id": 4752, "verse_number": "४३", "content_sanskrit": "एवं ब्रुवाणं गोविन्दं वृषभं सर्वसात्वताम् ।\nद्रौणिः परमसङ्क्रुद्धः प्रत्युवाचेदमुत्तरम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2177730, "chapter_id": 4752, "verse_number": "", "content_sanskrit": "द्रौणिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2177731, "chapter_id": 4752, "verse_number": "४४", "content_sanskrit": "नैतदेवं यदात्थ त्वं पक्षपातेन केशव ।\nवचनात् पुण्डरीकाक्ष तव मद्वाक्यमन्यथा\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2177732, "chapter_id": 4752, "verse_number": "४५", "content_sanskrit": "पतिष्यत्येतदस्त्रं वै गर्भे तस्या मयोद्यतम् ।\nविराटदुहितुः कृष्ण यं त्वं रक्षितुमिच्छसि\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2177733, "chapter_id": 4752, "verse_number": "४६", "content_sanskrit": "अमोघः परमास्त्रस्य पातस्त्वद्य भविष्यति ।\nअभिमन्योः सृजैषीकां गर्भस्थः शाम्यतां शिशुः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2177734, "chapter_id": 4752, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2177735, "chapter_id": 4752, "verse_number": "४७", "content_sanskrit": "अहमेनं मृतं जातं जीवयिष्यामि बालकम् ।\nस तु गर्भो मृतो जातो दीर्घमायुरवाप्स्यति\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2177736, "chapter_id": 4752, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2177737, "chapter_id": 4752, "verse_number": "४८", "content_sanskrit": "इत्युक्तं प्रत्युवाचैनं द्रोणपुत्रः स्मयन्निव\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2177738, "chapter_id": 4752, "verse_number": "", "content_sanskrit": "द्रौणिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2177739, "chapter_id": 4752, "verse_number": "४९", "content_sanskrit": "यद्यस्त्रदग्धं गोविन्द जीवयस्येवमत्स्त्विति\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2177740, "chapter_id": 4752, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2177741, "chapter_id": 4752, "verse_number": "५०", "content_sanskrit": "ततः परममस्त्रं तु द्रौणिरुद्यतमाहवे ।\nद्वैपायनमनादृत्य गर्भेषु प्रमुमोच ह\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2177742, "chapter_id": 4752, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nऐषीकपर्वणि व्यासवाक्यं नाम षष्ठोऽध्यायः ॥६॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}]