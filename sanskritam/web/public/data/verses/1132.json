[{"id": 2006658, "chapter_id": 1132, "verse_number": "१-१३३-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2006659, "chapter_id": 1132, "verse_number": "१-१३३-१", "content_sanskrit": "कुन्तीपुत्रेषु जातेषु धृतराष्ट्रात्मजेषु च।\nमद्रराजसुता पाण्डुं रहो वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2006660, "chapter_id": 1132, "verse_number": "१-१३३-२", "content_sanskrit": "न मेऽस्ति त्वयि सन्तापो विगुणेऽपि परन्तप।\nनावरत्वे वरार्हायाः स्थित्वा चानघ नित्यदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2006661, "chapter_id": 1132, "verse_number": "१-१३३-३", "content_sanskrit": "गान्धार्याश्चैव नृपते जातं पुत्रशतं तथा।\nश्रुत्वा न मे तथा दुःखमभवत्कुरुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2006662, "chapter_id": 1132, "verse_number": "१-१३३-४", "content_sanskrit": "इदं तु मे महद्दुःखं तुल्यतायामपुत्रता।\nदिष्ट्या त्विदानीं भर्तुर्मे कुन्त्यामप्यस्ति सन्ततिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2006663, "chapter_id": 1132, "verse_number": "१-१३३-५", "content_sanskrit": "यदि त्वपत्यसन्तानं कुन्तिराजसुता मयि।\nकुर्यादनुग्रहो मे स्यात्तव चापि हितं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2006664, "chapter_id": 1132, "verse_number": "१-१३३-६", "content_sanskrit": "संरम्भो हि सपत्नीत्वाद्वक्तुं कुन्तिसुतां प्रति।\nयदि तु त्वं प्रसन्नो मे स्वयमेनां प्रचोदय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2006665, "chapter_id": 1132, "verse_number": "१-१३३-७x", "content_sanskrit": "पाण्डुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2006666, "chapter_id": 1132, "verse_number": "१-१३३-७", "content_sanskrit": "ममाप्येष सदा माद्रि हृद्यर्थः परिवर्तते।\nन तु त्वां प्रसहे वक्तुमिष्टानिष्टविवक्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2006667, "chapter_id": 1132, "verse_number": "१-१३३-८", "content_sanskrit": "तव त्विदं मतं मत्वा प्रयतिष्याम्यतः परम्।\nमन्ये ध्रुवं मयोक्ता सा वचनं प्रतिपत्स्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2006668, "chapter_id": 1132, "verse_number": "१-१३३-९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2006669, "chapter_id": 1132, "verse_number": "१-१३३-९", "content_sanskrit": "ततः कुन्तीं पुनः पाण्डुर्विविक्त इदमब्रवीत्।\nअनुगृह्णीष्व कल्याणि मद्रराजसुतामपि।\nकुलस्य मम सन्तानं लोकस्य च कुरु प्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2006670, "chapter_id": 1132, "verse_number": "१-१३३-१०", "content_sanskrit": "मम चापिण्डनाशाय पूर्वेषां च महात्मनाम्।\nमत्प्रियार्थं च कल्याणि कुरु कल्याणमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2006671, "chapter_id": 1132, "verse_number": "१-१३३-११", "content_sanskrit": "यशसोऽर्थाय चैव त्वं कुरु कर्म सुदुष्करम्।\nप्राप्याधिपत्यमिन्द्रेण यज्ञैरिष्टं यशोऽर्थिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2006672, "chapter_id": 1132, "verse_number": "१-१३३-१२", "content_sanskrit": "तथा मन्त्रविदो विप्रास्तपस्तप्त्वा सुदुष्करम्।\nगुरूनभ्युपगच्छन्ति यशसोऽर्थाय भामिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2006673, "chapter_id": 1132, "verse_number": "१-१३३-१३", "content_sanskrit": "तथा राजर्षयः सर्वे ब्राह्मणाश्च तपोधनाः।\nचक्रुरुच्चावचं कर्म यशसोऽर्थाय दुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2006674, "chapter_id": 1132, "verse_number": "१-१३३-१४", "content_sanskrit": "सा त्वं माद्रीं प्लवेनैव तारयैनामनिन्दिते।\nअपत्यसंविधानेन परां कीर्तिमवाप्नुहि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2006675, "chapter_id": 1132, "verse_number": "१-१३३-१५x", "content_sanskrit": "कुन्त्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2006676, "chapter_id": 1132, "verse_number": "१-१३३-१५", "content_sanskrit": "धर्मं वै धर्मशास्त्रोक्तं यथा वदसि तत्तथा।\nतस्मादनुग्रहं तस्याः करोमि कुरुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2006677, "chapter_id": 1132, "verse_number": "१-१३३-१६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2006678, "chapter_id": 1132, "verse_number": "१-१३३-१६", "content_sanskrit": "एवमुक्ताऽब्रवीन्मार्द्रीं सकृच्चिन्तय दैवतम्।\nतस्मात्ते भविताऽपत्यमनुरूपमसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2006679, "chapter_id": 1132, "verse_number": "१-१३३-१७", "content_sanskrit": "ततो मन्त्रे कृते तस्मिन्विधिदृष्टेन कर्मणा।\nततो राजसुता स्नाता शयने संविवेश ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2006680, "chapter_id": 1132, "verse_number": "१-१३३-१८", "content_sanskrit": "ततो माद्री विचार्यैका जगाम मनसाऽश्विनौ।\nतावागम्य सुतौ तस्यां जनयामासतुर्यमौ।\nनकुलं सहदेवं च रूपेणाप्रतिमौ भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2006681, "chapter_id": 1132, "verse_number": "१-१३३-१९", "content_sanskrit": "तथैव तावपि यमौ वागुवाचाशरीरिणी।\nधर्मतो भक्तितश्चैव शीलतो विनयैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2006682, "chapter_id": 1132, "verse_number": "१-१३३-२०", "content_sanskrit": "सत्वरूपगुणोपेतौ भवतोऽत्यश्विनाविति।\nमासते तेजसाऽत्यर्थं रूपद्रविणसंपदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2006683, "chapter_id": 1132, "verse_number": "१-१३३-२१", "content_sanskrit": "नामानि चक्रिरे तेषां शतशृङ्गनिवासिनः।\nभक्त्या च कर्मणा चैव तथाऽऽशीर्भिर्विशांपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2006684, "chapter_id": 1132, "verse_number": "१-१३३-२२", "content_sanskrit": "ज्येष्ठं युधिष्ठिरेत्येवं भीमसेनेति मध्यमम्।\nअर्जुनेति तृतीयं च कुन्तीपुत्रानकल्पयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2006685, "chapter_id": 1132, "verse_number": "१-१३३-२३", "content_sanskrit": "पूर्वजं नकुलेत्येवं सहदेवेति चापरम्।\nमाद्रीपुत्रावकथयंस्ते विप्राः प्रीतमानसाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2006686, "chapter_id": 1132, "verse_number": "१-१३३-२४", "content_sanskrit": "अनुसंवत्सरं जाता अपि ते कुरुसत्तमाः।\nपाण्डुपुत्रा व्यराजन्त पञ्चसंवत्सरा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2006687, "chapter_id": 1132, "verse_number": "१-१३३-२५", "content_sanskrit": "महासत्त्वा महावीर्या महाबलपराक्रमाः।\nपाण्डुर्दृष्ट्वा सुतांस्तांस्तु देवरूपान्महौजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2006688, "chapter_id": 1132, "verse_number": "१-१३३-२६", "content_sanskrit": "मुदं परमिकां लेभे ननन्द च नराधिपः।\nऋषीणामपि सर्वेषां शतशृङ्गनिवासिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2006689, "chapter_id": 1132, "verse_number": "१-१३३-२७", "content_sanskrit": "प्रिया बभूवुस्तासां च तथैव मुनियोषिताम्।\nकुन्तीमथ पुनः पाण्डुर्माद्र्यर्थे समचोदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2006690, "chapter_id": 1132, "verse_number": "१-१३३-२८", "content_sanskrit": "तमुवाच पृथा राजन् रहस्युक्ता तदा सती।\nउक्ता सक्वद्द्वन्द्वमेषा लेभे तेनास्मि वञ्चिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2006691, "chapter_id": 1132, "verse_number": "१-१३३-२९", "content_sanskrit": "बिभेम्यस्याः परिभवात्कुस्त्रीणां गतिरिदृशी।\nनाज्ञासिषमहं मूढा द्वन्द्वाह्वाने फलद्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2006692, "chapter_id": 1132, "verse_number": "१-१३३-३०", "content_sanskrit": "तस्मान्नाहं नियोक्तव्या त्वयैषोऽस्तु वरो मम।\nएवं पाण्डोः सुताः पञ्च देवदत्ता महाबलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2006693, "chapter_id": 1132, "verse_number": "१-१३३-३१", "content_sanskrit": "संभूताः कीर्तिमन्तश्च कुरुवंशविवर्धनाः।\nशुभलक्षणसंपन्नाः सोमवत्प्रियदर्शनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2006694, "chapter_id": 1132, "verse_number": "१-१३३-३२", "content_sanskrit": "सिंहदर्पा महेष्वासाः सिंहविक्रान्तगामिनः।\nसिंहग्रीवा मनुष्येन्द्रा ववृधुर्देवविक्रमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2006695, "chapter_id": 1132, "verse_number": "१-१३३-३३", "content_sanskrit": "विवर्धमानास्ते तत्र पुण्ये हैमवते गिरौ।\nविस्मयं जनयामासुर्महर्षीणां समेयुषाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2006696, "chapter_id": 1132, "verse_number": "१-१३३-३४", "content_sanskrit": "जातमात्रानुपादाय शतशृङ्गनिवासिनः।\nपाण्डोः पुत्रानमन्यन्त तापसाः स्वानिवात्मजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2006697, "chapter_id": 1132, "verse_number": "१-१३३-३५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2006698, "chapter_id": 1132, "verse_number": "१-१३३-३५", "content_sanskrit": "ततस्तु वृष्णयः सर्वे वसुदेवपुरोगमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2006699, "chapter_id": 1132, "verse_number": "१-१३३-३६", "content_sanskrit": "पाण्डुः शापभयाद्भीतः शतशृङ्गमुपेयिवान्।\nतत्रैव मुनिभिः सार्धं तापसोऽभूत्तपस्विभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2006700, "chapter_id": 1132, "verse_number": "१-१३३-३७", "content_sanskrit": "शाकमूलफलाहारस्तपस्वी नियतेन्द्रियः।\nयोगध्यानपरो राजा बभूवेति च वादकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2006701, "chapter_id": 1132, "verse_number": "१-१३३-३८", "content_sanskrit": "प्रबुवन्ति स्म बहवस्तच्छ्रुत्वा शोककर्शिताः।\nपाण्डोः प्रीतिसमायुक्ताः कदा श्रोष्याम संकथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2006702, "chapter_id": 1132, "verse_number": "१-१३३-३९", "content_sanskrit": "इत्येवं कथयन्तस्ते वृष्णयः सह बान्धवैः।\nपाण्डोः पुत्रागमं श्रुत्वा सर्वे हर्षसमन्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2006703, "chapter_id": 1132, "verse_number": "१-१३३-४०", "content_sanskrit": "सभाजयन्तस्तेऽन्योन्यं वसुदेवं वचोऽब्रुवन्।\nन भवेरन्क्रियाहीनाः पाण्डुपुत्रा महाबलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2006704, "chapter_id": 1132, "verse_number": "१-१३३-४१", "content_sanskrit": "पाण्डोः प्रियहितान्वेषी प्रेषय त्वं पुरोहितम्।\nवसुदेवस्तथेत्युक्त्वा विससर्ज पुरोहितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2006705, "chapter_id": 1132, "verse_number": "१-१३३-४२", "content_sanskrit": "युक्तानि च कुमाराणां पारबर्हाण्यनेकशः।\nकुन्तीं माद्रीं च संदिश्य दासीदासपरिच्छदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2006706, "chapter_id": 1132, "verse_number": "१-१३३-४३", "content_sanskrit": "गावो हिरण्यं रौप्यं च प्रेषयामास भारत।\nतानि सर्वाणि संगृह्य प्रययौ स पुरोहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2006707, "chapter_id": 1132, "verse_number": "१-१३३-४४", "content_sanskrit": "तमागतं द्विजश्रेष्ठं काश्यपं वै पुरोहितम्।\nपूजयामास विधिवत्पाण्डुः परपुरञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2006708, "chapter_id": 1132, "verse_number": "१-१३३-४५", "content_sanskrit": "पृथा माद्री च संहृष्टे वसुदेवं प्रशंसताम्।\nततः पाण्डुः क्रियाः सर्वाः पाण्डवानामकारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2006709, "chapter_id": 1132, "verse_number": "१-१३३-४६", "content_sanskrit": "गर्भाधानादिकृत्यानि चौलोपनयनानि च।\nकाश्यपः कृतवान्सर्वमुपाकर्म च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2006710, "chapter_id": 1132, "verse_number": "१-१३३-४७", "content_sanskrit": "चौलोपनयनादूर्ध्वमृषभाक्षा यशस्विनः।\nवैदिकाध्ययने सर्वे समपद्यन्त पारगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2006711, "chapter_id": 1132, "verse_number": "१-१३३-४८", "content_sanskrit": "शर्यातेः प्रथमः पुत्रः शुक्रो नाम परन्तपः।\nयेन सागरपर्यन्ता धुषा निर्जिता मही॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2006712, "chapter_id": 1132, "verse_number": "१-१३३-४९", "content_sanskrit": "अश्वमेधशतैरिष्ट्वा स महात्मा महामखैः।\nआराध्य देवताः सर्वाः पितॄनपि महामतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2006713, "chapter_id": 1132, "verse_number": "१-१३३-५०", "content_sanskrit": "शतशृह्गे तपस्तेपे शाकमूलफलाशनः।\nतेनोपकरणश्रेष्ठैः शिक्षया चोपबृंहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2006714, "chapter_id": 1132, "verse_number": "१-१३३-५१", "content_sanskrit": "तत्प्रसादाद्धनुर्वेदे समपद्यन्त पारगाः।\nगदायां पारगो भीमस्तोमरेषु युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2006715, "chapter_id": 1132, "verse_number": "१-१३३-५२", "content_sanskrit": "असिचर्मणि निष्णातौ यमौ सत्त्ववतां वरौ।\nधनुर्वेदे गतः पारं सव्यसाची परन्तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2006716, "chapter_id": 1132, "verse_number": "१-१३३-५३", "content_sanskrit": "शुक्रेण समनुज्ञातो मत्समोऽयमिति प्रभो।\nअनुज्ञाय ततो राजा शक्तिं खङ्गं ततः शरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2006717, "chapter_id": 1132, "verse_number": "१-१३३-५४", "content_sanskrit": "धनुश्च दमतां श्रेष्ठस्तालमात्रं महाप्रभम्।\nविपाठक्षुरनाराचान्गृध्रपक्षैरलङ्कृतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2006718, "chapter_id": 1132, "verse_number": "१-१३३-५५", "content_sanskrit": "ददौ पार्थाय संहृष्टो महोरगसमप्रभान्।\nअवाप्य सर्वशस्त्राणि मुदितो वासवात्मजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2006719, "chapter_id": 1132, "verse_number": "१-१३३-५६", "content_sanskrit": "मेने सर्वान्महीपालानपर्याप्तान्स्वतेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2006720, "chapter_id": 1132, "verse_number": "१-१३३-५७", "content_sanskrit": "एकवर्षान्तरास्त्वेवं परस्परमरिन्दमाः।\nअन्ववर्तन्त पार्थाश्च माद्रीपुत्रौ तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2006721, "chapter_id": 1132, "verse_number": "१-१३३-५८", "content_sanskrit": "ते च पञ्च शतं चैव कुरुवंशविवर्धनाः।\nसर्वे ववृधिरेऽल्पेन कालेनाप्स्विव पङ्कजाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2006722, "chapter_id": 1132, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि त्रयस्त्रिंशदधिकशततमोऽध्यायः॥ १३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]