[{"id": 5000063000, "chapter_id": 9063, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे त्रिषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000063001, "chapter_id": 9063, "verse_number": "१-६३-१", "content_sanskrit": "पूर्णे वर्षसहस्रे तु व्रतस्नातं महामुनिम्।\nअभ्यगच्छन् सुराः सर्वे तपः फलचिकीर्षवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000063002, "chapter_id": 9063, "verse_number": "१-६३-२", "content_sanskrit": "अब्रवीत् सुमहातेजा ब्रह्मा सुरुचिरं वचः।\nऋषिस्त्वमसि भद्रं ते स्वार्जितैः कर्मभिः शुभैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000063003, "chapter_id": 9063, "verse_number": "१-६३-३", "content_sanskrit": "तमेवमुक्त्वा देवेशस्त्रिदिवं पुनरभ्यगात्।\nविश्वामित्रो महातेजा भूयस्तेपे महत् तपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000063004, "chapter_id": 9063, "verse_number": "१-६३-४", "content_sanskrit": "ततः कालेन महता मेनका परमाप्सराः।\nपुष्करेषु नरश्रेष्ठ स्नातुं समुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000063005, "chapter_id": 9063, "verse_number": "१-६३-५", "content_sanskrit": "तां ददर्श महातेजा मेनकां कुशिकात्मजः।\nरूपेणाप्रतिमां तत्र विद्युतं जलदे यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000063006, "chapter_id": 9063, "verse_number": "१-६३-६", "content_sanskrit": "कन्दर्पदर्पवशगो मुनिस्तामिदमब्रवीत्।\nअप्सरः स्वागतं तेऽस्तु वस चेह ममाश्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000063007, "chapter_id": 9063, "verse_number": "१-६३-७", "content_sanskrit": "अनुगृह्णीष्व भद्रं ते मदनेन विमोहितम्।\nइत्युक्ता सा वरारोहा तत्र वासमथाकरोत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000063008, "chapter_id": 9063, "verse_number": "१-६३-८", "content_sanskrit": "तपसो हि महाविघ्नो विश्वामित्रमुपागमत्।\nतस्यां वसन्त्यां वर्षाणि पञ्च पञ्च च राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000063009, "chapter_id": 9063, "verse_number": "१-६३-९", "content_sanskrit": "विश्वामित्राश्रमे सौम्ये सुखेन व्यतिचक्रमुः।\nअथ काले गते तस्मिन् विश्वामित्रो महामुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000063010, "chapter_id": 9063, "verse_number": "१-६३-१०", "content_sanskrit": "सव्रीड इव संवृत्तश्चिन्ताशोकपरायणः।\nबुद्धिर्मुनेः समुत्पन्ना सामर्षा रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000063011, "chapter_id": 9063, "verse_number": "१-६३-११", "content_sanskrit": "सर्वं सुराणां कर्मैतत् तपोऽपहरणं महत्।\nअहोरात्रापदेशेन गताः संवत्सरा दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000063012, "chapter_id": 9063, "verse_number": "१-६३-१२", "content_sanskrit": "काममोहाभिभूतस्य विघ्नोऽयं प्रत्युपस्थितः।\nस निःश्वसन् मुनिवरः पश्चात्तापेन दुःखितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000063013, "chapter_id": 9063, "verse_number": "१-६३-१३", "content_sanskrit": "भीतामप्सरसं दृष्ट्वा वेपन्तीं प्राञ्जलिं स्थिताम्।\nमेनकां मधुरैर्वाक्यैर्विसृज्य कुशिकात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000063014, "chapter_id": 9063, "verse_number": "१-६३-१४", "content_sanskrit": "उत्तरं पर्वतं राम विश्वामित्रो जगाम ह।\nस कृत्वा नैष्ठिकीं बुद्धिं जेतुकामो महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000063015, "chapter_id": 9063, "verse_number": "१-६३-१५", "content_sanskrit": "कौशिकीतीरमासाद्य तपस्तेपे दुरासदम्।\nतस्य वर्षसहस्राणि घोरं तप उपासतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000063016, "chapter_id": 9063, "verse_number": "१-६३-१६", "content_sanskrit": "उत्तरे पर्वते राम देवतानामभूद् भयम्।\nआमन्त्रयन् समागम्य सर्वे सर्षिगणाः सुराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000063017, "chapter_id": 9063, "verse_number": "१-६३-१७", "content_sanskrit": "महर्षिशब्दं लभतां साध्वयं कुशिकात्मजः।\nदेवतानां वचः श्रुत्वा सर्वलोकपितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000063018, "chapter_id": 9063, "verse_number": "१-६३-१८", "content_sanskrit": "अब्रवीन्मधुरं वाक्यं विश्वामित्रं तपोधनम्।\nमहर्षे स्वागतं वत्स तपसोग्रेण तोषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000063019, "chapter_id": 9063, "verse_number": "१-६३-१९", "content_sanskrit": "महत्त्वमृषिमुख्यत्वं ददामि तव कौशिक।\nब्रह्मणस्तु वचः श्रुत्वा विश्वामित्रस्तपोधनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000063020, "chapter_id": 9063, "verse_number": "१-६३-२०", "content_sanskrit": "प्राञ्जलिः प्रणतो भूत्वा प्रत्युवाच पितामहम्।\nब्रह्मर्षिशब्दमतुलं स्वार्जितैः कर्मभिः शुभैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000063021, "chapter_id": 9063, "verse_number": "१-६३-२१", "content_sanskrit": "यदि मे भगवन्नाह ततोऽहं विजितेन्द्रियः।\nतमुवाच ततो ब्रह्मा न तावत् त्वं जितेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000063022, "chapter_id": 9063, "verse_number": "१-६३-२२", "content_sanskrit": "यतस्व मुनिशार्दूल इत्युक्त्वा त्रिदिवं गतः।\nविप्रस्थितेषु देवेषु विश्वामित्रो महामुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000063023, "chapter_id": 9063, "verse_number": "१-६३-२३", "content_sanskrit": "ऊर्ध्वबाहुर्निरालम्बो वायुभक्षस्तपश्चरन्।\nघर्मे पञ्चतपा भूत्वा वर्षास्वाकाशसंश्रयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000063024, "chapter_id": 9063, "verse_number": "१-६३-२४", "content_sanskrit": "शिशिरे सलिलेशायी रात्र्यहानि तपोधनः।\nएवं वर्षसहस्रं हि तपो घोरमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000063025, "chapter_id": 9063, "verse_number": "१-६३-२५", "content_sanskrit": "तस्मिन् संतप्यमाने तु विश्वामित्रे महामुनौ।\nसंतापः सुमहानासीत् सुराणां वासवस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000063026, "chapter_id": 9063, "verse_number": "१-६३-२६", "content_sanskrit": "रम्भामप्सरसं शक्रः सर्वैः सह मरुद्‍गणैः।\nउवाचात्महितं वाक्यमहितं कौशिकस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000063027, "chapter_id": 9063, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे त्रिषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]