[{"id": 6000076000, "chapter_id": 10076, "verse_number": null, "content_sanskrit": "अथ द्वादशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000076001, "chapter_id": 10076, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.001.m4a", "display_order": 2}, {"id": 6000076002, "chapter_id": 10076, "verse_number": "४-१२-१", "content_sanskrit": "ध्रुवं निवृत्तं प्रतिबुध्य वैशसादपेतमन्युर्भगवान् धनेश्वरः।\nतत्रागतश्चारणयक्षकिन्नरैः संस्तूयमानोऽभ्यवदत् कृताञ्जलिम्॥ ४/१२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.002.m4a", "display_order": 3, "topics": [{"text": "ध्रुवाय कुबेरेण वरदानम्", "range": "१–९"}]}, {"id": 6000076003, "chapter_id": 10076, "verse_number": null, "content_sanskrit": "धनद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.003.m4a", "display_order": 4}, {"id": 6000076004, "chapter_id": 10076, "verse_number": "४-१२-२", "content_sanskrit": "भो भो क्षत्रियदायाद परितुष्टोऽस्मि तेऽनघ।\nयस्त्वं पितामहादेशाद् वैरं दुस्त्यजमत्यजः॥ ४/१२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.004.m4a", "display_order": 5}, {"id": 6000076005, "chapter_id": 10076, "verse_number": "४-१२-३", "content_sanskrit": "न भवानवधीद् यक्षान् न यक्षा भ्रातरं तव।\nकाल एव हि भूतानां प्रभुरप्ययभावयोः॥ ४/१२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.005.m4a", "display_order": 6}, {"id": 6000076006, "chapter_id": 10076, "verse_number": "४-१२-४", "content_sanskrit": "अहं त्वमित्यपार्था धीरज्ञानात् पुरुषस्य हि।\nस्वाप्नीव भात्यनुध्यानाद् यथा बन्धविपर्ययः॥ ४/१२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.006.m4a", "display_order": 7}, {"id": 6000076007, "chapter_id": 10076, "verse_number": "४-१२-५", "content_sanskrit": "तद् गच्छ ध्रुव भद्रं ते भगवन्तमधोक्षजम्।\nसर्वभूतात्मभावेन सर्वभूतात्मविग्रहम्॥ ४/१२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.007.m4a", "display_order": 8}, {"id": 6000076008, "chapter_id": 10076, "verse_number": "४-१२-६", "content_sanskrit": "भजस्व भजनीयाङ्घ्रिमभवाय भवच्छिदम्।\nयुक्तं विरहितं शक्त्या गुणमय्याऽऽत्ममायया॥ ४/१२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.008.m4a", "display_order": 9}, {"id": 6000076009, "chapter_id": 10076, "verse_number": "४-१२-७", "content_sanskrit": "वृणीहि कामं नृप यन्मनोगतं मत्तस्त्वमौत्तानपदेऽविशङ्कितः।\nवरार्हणोऽस्यम्बुजनाभपादयोर्निरन्तरं त्वां वयमङ्ग शुश्रुम॥ ४/१२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.009.m4a", "display_order": 10}, {"id": 6000076010, "chapter_id": 10076, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.010.m4a", "display_order": 11}, {"id": 6000076011, "chapter_id": 10076, "verse_number": "४-१२-८", "content_sanskrit": "स राजराजेन वराय चोदितो ध्रुवो महाभागवतो महामतिः।\nहरौ स वव्रेऽचलितां स्मृतिं यया तरत्ययत्नेन दुरत्ययं तमः॥ ४/१२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.011.m4a", "display_order": 12}, {"id": 6000076012, "chapter_id": 10076, "verse_number": "४-१२-९", "content_sanskrit": "तस्य प्रीतेन मनसा तां दत्त्वैलिबिलस्ततः।\nपश्यतोऽन्तर्दधे सोऽपि स्वपुरं प्रत्यपद्यत॥ ४/१२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.012.m4a", "display_order": 13}, {"id": 6000076013, "chapter_id": 10076, "verse_number": "४-१२-१०", "content_sanskrit": "अथायजत यज्ञेशं क्रतुभिर्भूरिदक्षिणैः।\nद्रव्यक्रियादेवतानां कर्माकर्मफलप्रदम्॥ ४/१२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.013.m4a", "display_order": 14, "topics": [{"text": "ध्रुवस्य राज्यपालनम्", "range": "१०–१४"}]}, {"id": 6000076014, "chapter_id": 10076, "verse_number": "४-१२-११", "content_sanskrit": "सर्वात्मन्यच्युते सर्वे तीव्रौघां भक्तिमुद्वहन्।\nददर्शात्मनि भूतेषु तमेवावस्थितं विभुम्॥ ४/१२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.014.m4a", "display_order": 15}, {"id": 6000076015, "chapter_id": 10076, "verse_number": "४-१२-१२", "content_sanskrit": "तमेव शीलसम्पन्नं ब्रह्मण्यं दीनवत्सलम्।\nगोप्तारं धर्मसेतूनां मेनिरे पितरं प्रजाः॥ ४/१२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.015.m4a", "display_order": 16}, {"id": 6000076016, "chapter_id": 10076, "verse_number": "४-१२-१३", "content_sanskrit": "षट्त्रिंशद्वर्षसाहस्रं शशास क्षितिमण्डलम्।\nभोगैः पुण्यक्षयं कुर्वन् अभोगैरशुभक्षयम्॥ ४/१२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.016.m4a", "display_order": 17}, {"id": 6000076017, "chapter_id": 10076, "verse_number": "४-१२-१४", "content_sanskrit": "एवं बहुसवं कालं महात्माऽविकलेन्द्रियः।\nत्रिवर्गौपयिकं नीत्वा पुत्रायादान्नृपासनम्॥ ४/१२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.017.m4a", "display_order": 18}, {"id": 6000076018, "chapter_id": 10076, "verse_number": "४-१२-१५", "content_sanskrit": "मन्यमान इदं विश्वं मायारचितमात्मनि।\nअविद्यारचितस्वप्नगन्धर्वनगरोपमम्॥ ४/१२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.018.m4a", "display_order": 19, "topics": [{"text": "ध्रुवस्य बदरीप्रस्थानम्, देहत्यागः", "range": "१५–२२"}]}, {"id": 6000076019, "chapter_id": 10076, "verse_number": "४-१२-१६", "content_sanskrit": "आत्मस्‍त्र्यपत्यसुहृदो बलमृद्धकोशमन्तःपुरं परिविहारभुवश्च रम्याः।\nभूमण्डलं जलधिमेखलमाकलय्य कालोपसृष्टमिति स प्रययौ विशालाम्॥ ४/१२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.019.m4a", "display_order": 20}, {"id": 6000076020, "chapter_id": 10076, "verse_number": "४-१२-१७", "content_sanskrit": "तस्या विशुद्धकरणः शिववार्विगाह्य बद्धासनो जितमरुन्मनसाऽऽहृताक्षः।\nस्थूले दधार भगवत्प्रतिरूप एतद् ध्यायंस्तदव्यवहितो व्यसृजत् समाधौ॥ ४/१२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.020.m4a", "display_order": 21}, {"id": 6000076021, "chapter_id": 10076, "verse_number": "४-१२-१८", "content_sanskrit": "भक्तिं हरौ भगवति प्रवहन्नजस्रमानन्दबाष्पकलया मुहुरर्द्यमानः।\nविक्लिद्यमानहृदयः पुलकाचिताङ्गो नात्मानमस्मरदसाविति मुक्तलिङ्गः॥ ४/१२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.021.m4a", "display_order": 22}, {"id": 6000076022, "chapter_id": 10076, "verse_number": "४-१२-१९", "content_sanskrit": "स ददर्श विमानाग्र्यं नभसोऽवतरद् भुवः।\nविभ्राजयद् दश दिशो राकापतिमिवोदितम्॥ ४/१२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.022.m4a", "display_order": 23}, {"id": 6000076023, "chapter_id": 10076, "verse_number": "४-१२-२०", "content_sanskrit": "तत्रानु देवप्रवरौ चतुर्भुजौ श्यामौ किशोरावरुणाम्बुजेक्षणौ।\nस्थिताववष्टभ्य गदां सुवाससौ किरीटहाराङ्गदचारुकुण्डलौ॥ ४/१२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.023.m4a", "display_order": 24}, {"id": 6000076024, "chapter_id": 10076, "verse_number": "४-१२-२१", "content_sanskrit": "विज्ञाय तावुत्तमभावकिङ्करावभ्युत्थितः साध्वससन्नविक्रमः।\nननाम नामानि गृणन् मधुद्विषः पार्षत्प्रधानाविति संहताञ्जलिः॥ ४/१२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.024.m4a", "display_order": 25}, {"id": 6000076025, "chapter_id": 10076, "verse_number": "४-१२-२२", "content_sanskrit": "तं कृष्णपादाभिनिविष्टचेतसं बद्धाञ्जलिं प्रश्रयनम्रकन्धरम्।\nसुनन्दनन्दावुपलभ्य सम्मितं प्रीत्योचतुः पुष्करनाभसंमतौ॥ ४/१२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.025.m4a", "display_order": 26}, {"id": 6000076026, "chapter_id": 10076, "verse_number": null, "content_sanskrit": "सुनन्दनन्दावूचतुः —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.026.m4a", "display_order": 27}, {"id": 6000076027, "chapter_id": 10076, "verse_number": "४-१२-२३", "content_sanskrit": "भो भो भद्र सुभद्रं ते वचो नोऽवहितः शृणु।\nयः पञ्चवर्षस्तपसा भवान् देवमतीतृपत्॥ ४/१२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.027.m4a", "display_order": 28, "topics": [{"text": "ध्रुवस्य ध्रुवलोकगमनम्", "range": "२३–३९"}]}, {"id": 6000076028, "chapter_id": 10076, "verse_number": "४-१२-२४", "content_sanskrit": "तस्याखिलजगद्धातुर्विद्धि देवस्य शार्ङ्गिणः।\nपार्षदाविह सम्प्राप्तौ नेतुं त्वां भगवत्पदम्॥ ४/१२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.028.m4a", "display_order": 29}, {"id": 6000076029, "chapter_id": 10076, "verse_number": "४-१२-२५", "content_sanskrit": "सुदुर्जयं विष्णुपदं जितं त्वया यत् सूरयोऽप्राप्य विचक्षते परम्।\nआतिष्ठ तच्चन्द्रदिवाकरादयो ग्रहर्क्षताराः परियन्ति दक्षिणम्॥ ४/१२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.029.m4a", "display_order": 30}, {"id": 6000076030, "chapter_id": 10076, "verse_number": "४-१२-२६", "content_sanskrit": "अनास्थितं ते पितृभिरन्यैरप्यङ्ग कर्हिचित्।\nआतिष्ठ जगतां वन्द्यं तद् विष्णोः परमं पदम्॥ ४/१२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.030.m4a", "display_order": 31}, {"id": 6000076031, "chapter_id": 10076, "verse_number": "४-१२-२७", "content_sanskrit": "एतद् विमानप्रवरमुत्तमश्लोकमौलिना।\nउपस्थापितमायुष्मन्नधिरोढुं त्वमर्हसि॥ ४/१२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.031.m4a", "display_order": 32}, {"id": 6000076032, "chapter_id": 10076, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.032.m4a", "display_order": 33}, {"id": 6000076033, "chapter_id": 10076, "verse_number": "४-१२-२८", "content_sanskrit": "निशम्य वैकुण्ठनियोज्यमुख्ययोर्मधुच्युतां वाचमुरुक्रमप्रियः।\nकृताभिषेकः कृतनित्यमङ्गलो मुनीन् प्रणम्याशिषमभ्यवादयत्॥ ४/१२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.033.m4a", "display_order": 34}, {"id": 6000076034, "chapter_id": 10076, "verse_number": "४-१२-२९", "content_sanskrit": "परीत्याभ्यर्च्य धिष्ण्याग्र्यं पार्षदावभिवन्द्य च।\nइयेष तदधिष्ठातुं बिभ्रद् रूपं हिरण्मयम्॥ ४/१२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.034.m4a", "display_order": 35}, {"id": 6000076035, "chapter_id": 10076, "verse_number": "४-१२-३०", "content_sanskrit": "तदा दुन्दुभयो नेदुर्मृदङ्गपणवादयः।\nगन्धर्वमुख्याः प्रजगुः पेतुः कुसुमवृष्टयः॥ ४/१२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.035.m4a", "display_order": 36}, {"id": 6000076036, "chapter_id": 10076, "verse_number": "४-१२-३१", "content_sanskrit": "स च स्वर्लोकमारोक्ष्यन् सुनीतिं जननीं ध्रुवः।\nअन्वस्मरदहं हित्वा नैनां यास्ये त्रिविष्टपम्॥ ४/१२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.036.m4a", "display_order": 37}, {"id": 6000076037, "chapter_id": 10076, "verse_number": "४-१२-३२", "content_sanskrit": "इति व्यवसितं तस्य व्यवसीय सुरोत्तमौ।\nदर्शयामासतुर्देवीं देवयानेन चाग्रगाम्॥ ४/१२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.037.m4a", "display_order": 38}, {"id": 6000076038, "chapter_id": 10076, "verse_number": "४-१२-३३", "content_sanskrit": "तत्र तत्र प्रशंसद्भिः पथि वैमानिकैः सुरैः।\nअवकीर्यमाणो ददृशे कुसुमैः क्रमशो ग्रहान्॥ ४/१२/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.038.m4a", "display_order": 39}, {"id": 6000076039, "chapter_id": 10076, "verse_number": "४-१२-३४", "content_sanskrit": "त्रिलोकीं देवयानेन सोऽतिव्रज्य मुनीनपि।\nपुरस्ताद् यद् ध्रुवगतिं विष्णोः पदमथाभ्यगात्॥ ४/१२/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.039.m4a", "display_order": 40}, {"id": 6000076040, "chapter_id": 10076, "verse_number": "४-१२-३५", "content_sanskrit": "यद् भ्राजमानं स्वरुचैव सर्वतो लोकास्‍त्रयो ह्यनुविभ्राजन्त एते।\nन ते खला जन्तुषु ये त्वनुग्रहाद् व्रजन्ति भद्राणि चरन्ति येऽनिशम्॥ ४/१२/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.040.m4a", "display_order": 41}, {"id": 6000076041, "chapter_id": 10076, "verse_number": "४-१२-३६", "content_sanskrit": "शान्ताः समदृशः शुद्धाः सर्वभूतानुरञ्जनाः।\nयान्त्यञ्जसाऽच्युतपदमच्युतप्रियबान्धवाः॥ ४/१२/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.041.m4a", "display_order": 42}, {"id": 6000076042, "chapter_id": 10076, "verse_number": "४-१२-३७", "content_sanskrit": "इत्युत्तानपदः पुत्रो ध्रुवः कृष्णपरायणः।\nअभूत् त्रयाणां लोकानां चूडामणिरिवामलः॥ ४/१२/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.042.m4a", "display_order": 43}, {"id": 6000076043, "chapter_id": 10076, "verse_number": "४-१२-३८", "content_sanskrit": "गम्भीरवेगानिमिषां ज्योतिषां चक्रमर्पितम्।\nयस्मिन् भ्रमति कौरव्य मेढ्यामिव गवां गणः॥ ४/१२/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.043.m4a", "display_order": 44}, {"id": 6000076044, "chapter_id": 10076, "verse_number": "४-१२-३९", "content_sanskrit": "महिमानं विलोक्यास्य नारदो भगवान् ऋषिः।\nआतोद्यं वितुदन् श्लोकान् सत्रेऽगायत् प्रचेतसाम्॥ ४/१२/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.044.m4a", "display_order": 45}, {"id": 6000076045, "chapter_id": 10076, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.045.m4a", "display_order": 46}, {"id": 6000076046, "chapter_id": 10076, "verse_number": "४-१२-४०", "content_sanskrit": "नूनं सुनीतेः पतिदेवतायास्तपःप्रभावस्य सुतस्य तां गतिम्।\nदृष्ट्वाऽभ्युपायानपि वेदवादिनो नैवाधिगन्तुं प्रभवन्ति किं नृपाः॥ ४/१२/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.046.m4a", "display_order": 47, "topics": [{"text": "ध्रुवचरितगानम्, श्रवणफलं च", "range": "४०–५१"}]}, {"id": 6000076047, "chapter_id": 10076, "verse_number": "४-१२-४१", "content_sanskrit": "यः पञ्चवर्षो गुरुदारवाक्शरैर्भिन्नेन यातो हृदयेन दूयता।\nवनं ममादेशकरोऽजितं प्रभुं जिगाय तद्भक्तिगुणैः पराजितम्॥ ४/१२/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.047.m4a", "display_order": 48}, {"id": 6000076048, "chapter_id": 10076, "verse_number": "४-१२-४२", "content_sanskrit": "यः क्षत्रबन्धुर्भुवि तस्याधिरूढमन्वारुरुक्षेदपि वर्षपूगैः।\nयः पञ्चवर्षो यदहोभिरल्पैः प्रसाद्य वैकुण्ठमवाप तत्पदम्॥ ४/१२/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.048.m4a", "display_order": 49}, {"id": 6000076049, "chapter_id": 10076, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.049.m4a", "display_order": 50}, {"id": 6000076050, "chapter_id": 10076, "verse_number": "४-१२-४३", "content_sanskrit": "एतत् तेऽभिहितं सर्वं यत् पृष्टोऽहमिह त्वया।\nध्रुवस्योद्दामयशसश्चरितं संमतं सताम्॥ ४/१२/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.050.m4a", "display_order": 51}, {"id": 6000076051, "chapter_id": 10076, "verse_number": "४-१२-४४", "content_sanskrit": "धन्यं यशस्यमायुष्यं पुण्यं स्वस्त्ययनं महत्।\nस्वर्ग्यं ध्रौव्यं सौमनस्यं प्रशस्यमघमर्षणम्॥ ४/१२/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.051.m4a", "display_order": 52}, {"id": 6000076052, "chapter_id": 10076, "verse_number": "४-१२-४५", "content_sanskrit": "श्रुत्वैतच्छ्रद्धयाऽभीक्ष्णमच्युतप्रियचेष्टितम्।\nभवेद् भक्तिर्भगवति यया स्यात् क्लेशसंक्षयः॥ ४/१२/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.052.m4a", "display_order": 53}, {"id": 6000076053, "chapter_id": 10076, "verse_number": "४-१२-४६", "content_sanskrit": "महत्त्वमिच्छतां तीर्थं श्रोतुः शीलादयो गुणाः।\nयत्र तेजस्तदिच्छूनां मानो यत्र मनस्विनाम्॥ ४/१२/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.053.m4a", "display_order": 54}, {"id": 6000076054, "chapter_id": 10076, "verse_number": "४-१२-४७", "content_sanskrit": "प्रयतः कीर्तयेत् प्रातः समवाये द्विजन्मनाम्।\nसायं च पुण्यश्लोकस्य ध्रुवस्य चरितं महत्॥ ४/१२/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.054.m4a", "display_order": 55}, {"id": 6000076055, "chapter_id": 10076, "verse_number": "४-१२-४८", "content_sanskrit": "पौर्णमास्यां सिनीवाल्यां द्वादश्यां श्रवणेऽथ वा।\nदिनक्षये व्यतीपाते संक्रमेऽर्कदिनेऽपि वा॥ ४/१२/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.055.m4a", "display_order": 56}, {"id": 6000076056, "chapter_id": 10076, "verse_number": "४-१२-४९", "content_sanskrit": "श्रावयेच्छ्रद्दधानानां तीर्थपादपदाश्रयः।\nनेच्छंस्तत्राऽत्मनाऽऽत्मानं सन्तुष्ट इति सिध्यति॥ ४/१२/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.056.m4a", "display_order": 57}, {"id": 6000076057, "chapter_id": 10076, "verse_number": "४-१२-५०", "content_sanskrit": "ज्ञानमज्ञाततत्त्वाय यो दद्यात् सत्पथेऽमृतम्।\nकृपालोर्दीननाथस्य देवास्तस्यानुगृह्णते॥ ४/१२/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.057.m4a", "display_order": 58}, {"id": 6000076058, "chapter_id": 10076, "verse_number": "४-१२-५१", "content_sanskrit": "इदं मया तेऽभिहितं कुरूद्वह ध्रुवस्य विख्यातविशुद्धकर्मणः।\nहित्वाऽर्भकः क्रीडनकानि मातुर्गृहं च विष्णुं शरणं यो जगाम॥ ४/१२/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_012/BhP_04.012.058.m4a", "display_order": 59}, {"id": 6000076059, "chapter_id": 10076, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां चतुर्थस्कन्धे द्वादशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]