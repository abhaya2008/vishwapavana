[{"id": 2172271, "chapter_id": 4672, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2172272, "chapter_id": 4672, "verse_number": "१", "content_sanskrit": "हते वैकर्तने कर्णे कुरवो भयपीडिताः ।\nवीक्षमाणा दिशः सर्वाः पलायन्ते स्म सर्वतः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2172273, "chapter_id": 4672, "verse_number": "२", "content_sanskrit": "वीरं तु निहतं श्रुत्वा शत्रुभिः परमाहवे ।\nसर्वे दिशोऽन्वकीर्यन्त तावका भयमोहिताः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2172274, "chapter_id": 4672, "verse_number": "३", "content_sanskrit": "ततोऽवहारं चक्रुस्ते राजन् योधाः समन्ततः ।\nवार्यमाणा भयोद्विग्नास्तव पुत्रेण भारत\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2172275, "chapter_id": 4672, "verse_number": "४", "content_sanskrit": "तेषां तु मतमाज्ञाय पुत्रस्ते भरतर्षभ ।\nअवहारं ततश्चक्रे शल्यस्यानुमते नृप\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2172276, "chapter_id": 4672, "verse_number": "५", "content_sanskrit": "योधैर्महारथैः सार्धं वृतो भारत तावकैः ।\nहतावशेषैस्त्वरितः शिबिरायैव दुद्रुवे\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2172277, "chapter_id": 4672, "verse_number": "६", "content_sanskrit": "गान्धाराणां सहस्रेण शकुनिः परिवारितः ।\nहतमाधिरथिं दृष्ट्वा शिबिरायैव दुद्रुवे\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2172278, "chapter_id": 4672, "verse_number": "७", "content_sanskrit": "कृपः शारद्वतो राजन्नागानीकेन संवृतः ।\nमहता मेघकल्पेन शिबिरायैव दुद्रुवे\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2172279, "chapter_id": 4672, "verse_number": "८", "content_sanskrit": "अश्वत्थामा ततः शूरो विनिःश्वस्य मुहुर्मुहुः ।\nपाण्डवानां जयं दृष्ट्वा शिबिरायैव दुद्रुवे\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2172280, "chapter_id": 4672, "verse_number": "९", "content_sanskrit": "संशप्तकावशेषेण बलेन महता वृतः ।\nसुशर्मापि ययौ राजन् वीक्षमाणो भयातुरान्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2172281, "chapter_id": 4672, "verse_number": "१०", "content_sanskrit": "दुर्योधनोऽपि नृपतिर्हृतसर्वस्व आतुरः ।\nययौ शोकसमाविष्टश्चिन्तयन् विमना बहु\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2172282, "chapter_id": 4672, "verse_number": "११", "content_sanskrit": "छिन्नध्वजेन शल्यस्तु रथेन रथिनां वरः ।\nप्रययौ शिबिरायैव वीक्षमाणो दिशो दश\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2172283, "chapter_id": 4672, "verse_number": "१२", "content_sanskrit": "ततोऽपरे सुबहवो भारतानां महारथाः ।\nप्राद्रवन्त रणं हित्वा भयाविष्टा विचेतसः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2172284, "chapter_id": 4672, "verse_number": "१३", "content_sanskrit": "अश्रुकण्ठा भयोद्विग्ना वेपमानाः सुविह्वलाः ।\nकुरवः प्रद्रुताः सर्वे दृष्ट्वा कर्णं निपातितम् ।\nप्रशंसन्तोऽर्जुनं केचित् केचित् कर्णं महारथाः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2172285, "chapter_id": 4672, "verse_number": "१४", "content_sanskrit": "तेषां योधसहस्राणां तावकानां महामृधे ।\nनासीत्तत्र पुमान् कश्चिद् यो युद्धाय मनो दधे\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2172286, "chapter_id": 4672, "verse_number": "१५", "content_sanskrit": "हते कर्णे महाराज निराशाः कुरवोऽभवन् ।\nजीवितेष्वथ राज्येषु दारेषु च धनेषु च\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2172287, "chapter_id": 4672, "verse_number": "१६", "content_sanskrit": "तान् समानीय पुत्रस्ते यत्नेन महता विभो ।\nयुद्धायैव मनो दध्रे दुःखशोकसमन्वितः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2172288, "chapter_id": 4672, "verse_number": "१७", "content_sanskrit": "तस्याज्ञां शिरसा तेऽपि प्रतिगृह्य विशाम्पते ।\nविवर्णवदना दीना न्यविशन्त महारथाः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2172289, "chapter_id": 4672, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nसेनापहारो नाम द्विनवतितमोऽध्यायः ॥९२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]