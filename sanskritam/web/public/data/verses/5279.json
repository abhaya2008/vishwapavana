[{"id": 2200843, "chapter_id": 5279, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2200844, "chapter_id": 5279, "verse_number": "१", "content_sanskrit": "किंस्विद् दत्तं पितृभ्यो वै भवत्यक्षयमीश्वर ।\nकिं हविश्चिररात्राय किमानन्त्याय कल्पते\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2200845, "chapter_id": 5279, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2200846, "chapter_id": 5279, "verse_number": "२", "content_sanskrit": "हवींषि श्राद्धकल्पे तु यानि श्राद्धविदो विदुः ।\nतानि मे शृणु काम्यानि फलं चैषां युधिष्ठिर\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2200847, "chapter_id": 5279, "verse_number": "३", "content_sanskrit": "तिलैर्व्रीहियवैर्माषैरद्भिर्मूलफलैस्तथा ।\nदत्तेन मासं प्रीयन्ते श्राद्धेन पितरो नृप\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2200848, "chapter_id": 5279, "verse_number": "४", "content_sanskrit": "वर्धमानतिलं श्राद्धमक्षयं मनुरब्रवीत् ।\nसर्वेष्वेव तु भोज्येषु तिलाः प्राधान्यतः स्मृताः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2200849, "chapter_id": 5279, "verse_number": "५", "content_sanskrit": "द्वौ मासौ तु भवेत् तृप्तिर्मत्स्यैः पितृगणस्य ह ।\nत्रीन्मासानाविकेनाहुश्चातुर्मास्यं शशेन तु\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2200850, "chapter_id": 5279, "verse_number": "६", "content_sanskrit": "आजेन मासान् प्रीयन्ते पञ्चैव पितरो नृप ।\nवाराहेण तु षण्मासान् सप्त वै शाकुनेन तु\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2200851, "chapter_id": 5279, "verse_number": "७", "content_sanskrit": "मासानष्टौ पार्षतेन रौरवेण नवैव तु ।\nगवयस्य तु मांसेन तृप्तिः स्याद् दशमासिकी\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2200852, "chapter_id": 5279, "verse_number": "८", "content_sanskrit": "मासानेकादश प्रीतिः पितॄणां माहिषेण तु ।\nगव्येन दत्ते श्राद्धे तु संवत्सरमिहोच्यते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2200853, "chapter_id": 5279, "verse_number": "९", "content_sanskrit": "यथा गव्यं तथा युक्तं पायसं सर्पिषा सह ।\nवार्ध्राणसस्य मांसेन तृप्तिर्द्वादशवार्षिकी\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2200854, "chapter_id": 5279, "verse_number": "१०", "content_sanskrit": "आनन्त्याय भवेद् दत्तं खड्गमांसं पितृक्षये ।\nकालशाकं च लौहं चाप्यानन्त्यं छाग उच्यते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2200855, "chapter_id": 5279, "verse_number": "११", "content_sanskrit": "गाथाश्चाप्यत्र गायन्ति पितृगीता युधिष्ठिर ।\nसनत्कुमारो भगवान् पुरा मय्यभ्यभाषत\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2200856, "chapter_id": 5279, "verse_number": "१२", "content_sanskrit": "अपि नः स कुले जायाद् यो नो दद्यात् त्रयोदशीम् ।\nमघासु सर्पिषा युक्तं पायसं दक्षिणायने\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2200857, "chapter_id": 5279, "verse_number": "१३", "content_sanskrit": "आजेन वापि लौहेन मघास्वेव यतव्रतः ।\nहस्तिच्छायासु विधिवत्कर्णव्यजनवीजितम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2200858, "chapter_id": 5279, "verse_number": "१४", "content_sanskrit": "एष्टव्या बहवः पुत्रा यद्येकोऽपि गयां व्रजेत् ।\nयत्रासौ प्रथितो लोकेष्वक्षय्यकरणो वटः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2200859, "chapter_id": 5279, "verse_number": "१५", "content_sanskrit": "आपो मूलं फलं मांसमन्नं वापि पितृक्षये ।\nयत्किञ्चिन्मधुसम्मिश्रं तदानन्त्याय कल्पते\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2200860, "chapter_id": 5279, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे श्राद्धहविर्निरूपणं नाम सप्तविंशत्यधिकशततमोऽध्यायः ॥१३०॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]