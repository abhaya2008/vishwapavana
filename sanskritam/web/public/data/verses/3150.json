[{"id": 2100278, "chapter_id": 3150, "verse_number": "१४-६-१", "content_sanskrit": "व्यास उवाच।\nअत्राप्युदाहरन्तीमममितिहासं पुरातनम्।\nबृहस्पतेश्च संवादं मरुत्तस्य च धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2100279, "chapter_id": 3150, "verse_number": "१४-६-२", "content_sanskrit": "देवराजस्य समयं कृतमाङ्गिरसेन ह।\nश्रुत्वा मरुत्तो नृपतिर्मन्युमाहारयत्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2100280, "chapter_id": 3150, "verse_number": "१४-६-३", "content_sanskrit": "सङ्कल्प्य मनसा यज्ञं करंधमसुतात्मजः।\nबृहस्पतिमुपागम्य वाग्मी वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2100281, "chapter_id": 3150, "verse_number": "१४-६-४", "content_sanskrit": "भगवन्यन्मया पूर्वमभिगम्य तपोधन।\nकृतोऽभिसन्धिर्यज्ञस्य भवतो वचनाद्गुरो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2100282, "chapter_id": 3150, "verse_number": "१४-६-५", "content_sanskrit": "तमहं यष्टुमिच्छामि सम्भाराः सम्भृताश्च मे।\nयाज्योस्मि भवतः साधो तत्प्राप्नुहि विधत्स्व च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2100283, "chapter_id": 3150, "verse_number": "१४-६-६x", "content_sanskrit": "बृहस्पतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2100284, "chapter_id": 3150, "verse_number": "१४-६-६", "content_sanskrit": "न कामये याजयितुं त्वामहं पृथिवीपते।\nवृतोस्मि देवराजेन प्रतिज्ञातं च तस्य मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2100285, "chapter_id": 3150, "verse_number": "१४-६-७x", "content_sanskrit": "मरुत्त उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2100286, "chapter_id": 3150, "verse_number": "१४-६-७", "content_sanskrit": "पित्र्यमस्मि तव क्षेत्रं बहुमन्ये च ते भृशम्।\nतवास्मि याज्यातां प्राप्तो भजमानं भजस्व माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2100287, "chapter_id": 3150, "verse_number": "१४-६-८x", "content_sanskrit": "बृहस्पतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2100288, "chapter_id": 3150, "verse_number": "१४-६-८", "content_sanskrit": "अमर्त्यं याजयित्वाऽहं याजयिष्ये कथं नरम्।\nमरुत्त गच्छ वा मा वा निवृत्तोस्म्यद्य याजनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2100289, "chapter_id": 3150, "verse_number": "१४-६-९", "content_sanskrit": "न त्वां याजयितास्म्यद्य वृणु यं त्वमिहेच्छसि।\nउपाध्यायं महाबाहो यस्ते यज्ञं करिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2100290, "chapter_id": 3150, "verse_number": "१४-६-१०x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2100291, "chapter_id": 3150, "verse_number": "१४-६-१०", "content_sanskrit": "एवमुक्तस्तु नृपतिर्मरुत्तो व्रीडितोऽभवत्।\nप्रत्यागच्छन्सुसंविग्नो ददर्श पथि नारदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2100292, "chapter_id": 3150, "verse_number": "१४-६-११", "content_sanskrit": "देवर्षिणा समागम्य नारदेनि स पार्थिवः।\nविधिवत्प्राञ्जलिस्तस्थावथैनं नारदोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2100293, "chapter_id": 3150, "verse_number": "१४-६-१२", "content_sanskrit": "राजर्षे नातिहृष्टोसि कच्चित्क्षेमं तवानघ।\nक्व गतोसि कुतश्चेदमप्रीतिस्थानमागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2100294, "chapter_id": 3150, "verse_number": "१४-६-१३", "content_sanskrit": "श्रोतव्यं चेन्मया राजन्ब्रूहि मे पार्थिवर्षभ।\nव्यपनेष्यामि ते मन्युं सर्वयत्नैर्नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2100295, "chapter_id": 3150, "verse_number": "१४-६-१४", "content_sanskrit": "एवमुक्तो मरुत्तः स नारदेन महर्षिणा।\nविप्रलम्भमुपाध्यायात्सर्वज्ञे तं न्यवेदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2100296, "chapter_id": 3150, "verse_number": "१४-६-१५x", "content_sanskrit": "मरुत्त उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2100297, "chapter_id": 3150, "verse_number": "१४-६-१५", "content_sanskrit": "गतोस्म्यङ्गिरसः पुत्रं देवाचार्यं बृहस्पतिम्।\nयज्ञार्थमृत्विजं प्रष्टुं स च मां नाभ्यनन्दत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2100298, "chapter_id": 3150, "verse_number": "१४-६-१६", "content_sanskrit": "प्रत्याख्यातश्च तेनाहं जीवितुं नाद्य कामये।\nपरित्यक्तश्च गुरुणा दूषितश्चास्मि नारद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2100299, "chapter_id": 3150, "verse_number": "१४-६-१७x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2100300, "chapter_id": 3150, "verse_number": "१४-६-१७", "content_sanskrit": "एवमुक्तस्तु राज्ञा स नारदः प्रत्युवाच ह।\nआविक्षितं महाराज वाचा संजीवयन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2100301, "chapter_id": 3150, "verse_number": "१४-६-१८", "content_sanskrit": "राजन्नङ्गिरसः पुत्रः संवर्तो नाम धार्मिकः।\nचङ्कमीति दिशः सर्वा दिग्वासा मोहयन्प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2100302, "chapter_id": 3150, "verse_number": "१४-६-१९", "content_sanskrit": "तं गच्च यदि याज्यं त्वां न वाञ्छति बृहस्पतिः।\nप्रसन्नस्त्वां महातेजाः संवर्तो याजयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2100303, "chapter_id": 3150, "verse_number": "१४-६-२०x", "content_sanskrit": "मरुत्त उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2100304, "chapter_id": 3150, "verse_number": "१४-६-२०", "content_sanskrit": "संजीवितोऽहं भवता वाक्येनानेन नारद।\nपश्येयं क्व नु संवर्तं शंस मे वदतांवर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2100305, "chapter_id": 3150, "verse_number": "१४-६-२१", "content_sanskrit": "कथं च तस्मै वर्तेयं कथं मां न परित्यजेत्।\nप्रत्याख्यातश्च तेनापि नाहं जीवितुमुत्सहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2100306, "chapter_id": 3150, "verse_number": "१४-६-२२x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2100307, "chapter_id": 3150, "verse_number": "१४-६-२२", "content_sanskrit": "उन्मत्तवेषं बिभ्रत्स चङ्क्रमीति यथासुखम्।\nवाराणसीं तु नगरीमभीक्ष्णमुपसेवते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2100308, "chapter_id": 3150, "verse_number": "१४-६-२३", "content_sanskrit": "तस्या द्वारं समासाद्य न्यसेथाः कुणपं क्वचित्।\nतं दृष्ट्वा यो निवर्तेत संवर्तः स महीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2100309, "chapter_id": 3150, "verse_number": "१४-६-२४", "content_sanskrit": "तं पृष्ठतोऽनुगच्छेथा यत्र गच्छेत्स वीर्यवान्।\nतमेकान्ते समासाद्य प्राञ्जलिः शरणं व्रजेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2100310, "chapter_id": 3150, "verse_number": "१४-६-२५", "content_sanskrit": "पृच्छेत्त्वां यदि केनाहं तवाख्यात इति स्म ह।\nब्रूयास्त्वं नारदेनेति स कुत्र इति शत्रुहन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2100311, "chapter_id": 3150, "verse_number": "१४-६-२६", "content_sanskrit": "स चेत्त्वामनुयुञ्जीत ममानुगमनेप्सया।\nशंसेथा वह्निमारूढं मामपि त्वमशङ्कया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2100312, "chapter_id": 3150, "verse_number": "१४-६-२७x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2100313, "chapter_id": 3150, "verse_number": "१४-६-२७", "content_sanskrit": "स तथेति प्रतिश्रुत्य पूजयित्वा च नारदम्।\nअभ्यनुज्ञाय राजर्षिर्ययौ वाराणसीं पुरीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2100314, "chapter_id": 3150, "verse_number": "१४-६-२८", "content_sanskrit": "तत्र गत्वा यथोक्तं स पुर्या द्वारे महायशाः।\nकुणपं स्थापयामास नारदस्य वचः स्मरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2100315, "chapter_id": 3150, "verse_number": "१४-६-२९", "content_sanskrit": "यौगपद्येनि विप्रश्च पुरीद्वारमथाविशत्।\nततः स कुणपं दृष्ट्वा सहसा संन्यवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2100316, "chapter_id": 3150, "verse_number": "१४-६-३०", "content_sanskrit": "स तं निवृत्तमालक्ष्य प्राञ्जलिः पृष्ठतोऽन्वगात्।\nआविक्षितो महीपालः संवर्तमुपशिक्षितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2100317, "chapter_id": 3150, "verse_number": "१४-६-३१", "content_sanskrit": "स च तं विजने दृष्ट्वा पांसुभिः कदेमेन च।\nश्लेष्मणा चैव राजानं ष्ठीवनैश्च समाकिरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2100318, "chapter_id": 3150, "verse_number": "१४-६-३२", "content_sanskrit": "स तथा बाध्यमानो वै संवर्तेन महीपतिः।\nअन्वगादेव तमृषिं प्राञ्जलिः सम्प्रसादयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2100319, "chapter_id": 3150, "verse_number": "१४-६-३३", "content_sanskrit": "ततो निवर्त्य संवर्तः परिश्रान्त उपाविशत्।\nशीतलच्छायमासाद्य न्यग्रोधं बहुशाखिनम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2100320, "chapter_id": 3150, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अश्वमेधपर्वणि षष्ठोऽध्यायः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]