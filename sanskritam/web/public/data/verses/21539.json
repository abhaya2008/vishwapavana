[{"id": 7001539000, "chapter_id": 21539, "verse_number": "१-३६-१", "content_sanskrit": "॥सूत उवाच॥\nतेषां चतुर्णां वक्ष्यामि शैलेन्द्राणां यथाक्रमम् ।\nअनुबन्धानि रम्याणि सर्वकालर्त्तुकानि च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001539001, "chapter_id": 21539, "verse_number": "१-३६-२", "content_sanskrit": "सारिकाभिर्मयूरैश्च चकोरैश्च मदोत्कटैः ।\nशुकैश्च भृङ्गराजैश्च चित्रकैश्च समन्ततः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001539002, "chapter_id": 21539, "verse_number": "१-३६-३", "content_sanskrit": "जीवञ्जीवकनादैश्च हेमकानाञ्च नादितैः ।\nमत्तकोकिलनादैश्च वल्गूनाञ्च निनादितैः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001539003, "chapter_id": 21539, "verse_number": "१-३६-४", "content_sanskrit": "सुग्रीवकाञ्चनरवैः कलविङ्करुतैस्तथा ।\nकूजितान्तरशब्दैश्च सुरम्याणि च सर्वशः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001539004, "chapter_id": 21539, "verse_number": "१-३६-५", "content_sanskrit": "मदात्कटैर्मधुरैश्च भ्रमरैश्च महालसैः ।\nउपगीतवनान्तानि किन्नरैश्च व्कचित् व्कचित् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001539005, "chapter_id": 21539, "verse_number": "१-३६-६", "content_sanskrit": "पुष्पवृष्टिं विमुञ्चन्ति मन्दमारुतकम्पिताः ।\nतरवो यत्र दृश्यन्ते चारुपल्लवशोभिताः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001539006, "chapter_id": 21539, "verse_number": "१-३६-७", "content_sanskrit": "स्तबकैर्मञ्जरीभिश्च ताम्रैः किसलयैस्तथा ।\nमन्दवातवशाल्लोलैर्दोलयद्भिर्युतानि च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001539007, "chapter_id": 21539, "verse_number": "१-३६-८", "content_sanskrit": "नानाधातुविचित्रैश्च कान्तरूपैः शिलाशतैः ।\nशल्लैः व्कचिद्द्विजश्रेष्ठा विन्यस्तैः शोभितानि च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001539008, "chapter_id": 21539, "verse_number": "१-३६-९", "content_sanskrit": "देवदानवगन्धर्वैर्यक्षराक्षसपन्नगैः ।\nसिद्धाप्सरोगणैश्चैव सेवितानि ततस्ततः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001539009, "chapter_id": 21539, "verse_number": "१-३६-१०", "content_sanskrit": "मनोहराणि चत्वारि देवाक्रीडनकान्यथ ।\nचतुर्दिशमुदाराणि नाम्ना श्रृणुत तानि मे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001539010, "chapter_id": 21539, "verse_number": "१-३६-११", "content_sanskrit": "पूर्वञ्चैत्ररथं नाम दक्षिणं नन्दनं वनम् ।\nवैभ्राजं पश्चिमं विद्यादुत्तरं सवितुर्वनम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001539011, "chapter_id": 21539, "verse_number": "१-३६-१२", "content_sanskrit": "महावनेषु चैतेषु निविष्टानि यथाक्रमम् ।\nअनुबन्धानि रम्याणि विहङ्गैः कूजितानि च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001539012, "chapter_id": 21539, "verse_number": "१-३६-१३", "content_sanskrit": "वनैर्विस्तीर्णतीर्थानि महापुण्यावनानि च ।\nमहानागाधिवासानि सेवितानि महात्मभिः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001539013, "chapter_id": 21539, "verse_number": "१-३६-१४", "content_sanskrit": "सुरसामललोयानि शिवानि सुसुखानि च ।\nसिद्धदेवासुरवरैरुपस्पृष्टजलानि च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001539014, "chapter_id": 21539, "verse_number": "१-३६-१५", "content_sanskrit": "छत्रप्रमाणैर्विकचैर्महागन्धैर्मनोहरैः ।\nपुण्डरीकैर्महापत्रैरुत्पलैः शोभितानि च ।\nमहासरांसि चत्वारि तानि वक्ष्यामि नामतः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001539015, "chapter_id": 21539, "verse_number": "१-३६-१६", "content_sanskrit": "अरुणोदं सरः पूर्वं दक्षिणं मानसं स्मृतम् ।\nसितोदं पश्चिमसरो महाभद्रन्तथोत्तरम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001539016, "chapter_id": 21539, "verse_number": "१-३६-१७", "content_sanskrit": "अरुणोदञ्च पूर्वेण ये च शैलास्ततः स्मृताः ।\nतान् कीर्त्यमानांस्तत्त्वेन श्रृणुध्वं विस्तरान्मम ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001539017, "chapter_id": 21539, "verse_number": "१-३६-१८", "content_sanskrit": "शीतान्तश्च कुमुञ्जश्च सुवीरश्चाचलोत्तमः ।\nविकङ्को मणिशीलश्च वृषभश्चाचलोत्तमः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001539018, "chapter_id": 21539, "verse_number": "१-३६-१९", "content_sanskrit": "महानीलोऽथ रुचकः सबिन्दुर्मन्दरस्तथा ।\nवेणुमांश्च सुमेधश्च निषधो देवपर्वतः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001539019, "chapter_id": 21539, "verse_number": "१-३६-२०", "content_sanskrit": "इत्येते पर्वतवरा अन्ये च गिरयस्तथा ।\nपूर्वेण मन्दरस्यैते सिद्धवासा उदाहृताः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001539020, "chapter_id": 21539, "verse_number": "१-३६-२१", "content_sanskrit": "सरसो मानसस्येह दक्षिणा ये महाचलाः ।\nये कीर्तिता मया ते वै नामतस्तान्निबोधत ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001539021, "chapter_id": 21539, "verse_number": "१-३६-२२", "content_sanskrit": "शैलस्त्रिशिखरश्चापि शिशिरश्चाचलोत्तमः ।\nकलिङ्गश्च पतङ्गश्च रुचकश्चैव सानुमान् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001539022, "chapter_id": 21539, "verse_number": "१-३६-२३", "content_sanskrit": "ताम्राभश्च विशाखश्च तथा श्वेतोदरो गिरिः ।\nसमूलो विषधारश्च रत्नधारश्च पर्वतः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001539023, "chapter_id": 21539, "verse_number": "१-३६-२४", "content_sanskrit": "एकश्रृङ्गो महामूलो गजशैलः पिशाचकः ।\nपञ्चशैलोऽथ कैलासो हिमवंश्चाचलोत्तमः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001539024, "chapter_id": 21539, "verse_number": "१-३६-२५", "content_sanskrit": "इत्येते देवचरिता ह्युत्कृष्टाः पर्वतोत्तमाः ।\nदिग्भागो दक्षिणे प्रोक्ता मेरोरमरवर्च्चसः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001539025, "chapter_id": 21539, "verse_number": "१-३६-२६", "content_sanskrit": "अपरेण सितोदस्य सरसो द्विजसत्तमाः ।\nउत्तमा ये महाशैलास्तान् प्रवक्ष्ये यथाक्रमम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001539026, "chapter_id": 21539, "verse_number": "१-३६-२७", "content_sanskrit": "सुवक्षाः शिखिशैलश्च कालो वैढूर्यपर्वतः ।\nकपिलः पिङ्गलो रुद्रः सुरसश्च महाचलः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001539027, "chapter_id": 21539, "verse_number": "१-३६-२८", "content_sanskrit": "कुमुदो मधुमांश्चैव अञ्जनीमुकुटस्तथा ।\nकृष्णश्च पाण्डरश्चैव सहस्रशिखरश्चह ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001539028, "chapter_id": 21539, "verse_number": "१-३६-२९", "content_sanskrit": "पारियात्रश्च शैलेन्द्रस्त्रिश्रृङ्गश्चाचलोत्तमः ।\nइत्येते पर्वतवरा दिग्भागे पश्चिमे स्मृताः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001539029, "chapter_id": 21539, "verse_number": "१-३६-३०", "content_sanskrit": "महाभद्रस्य सरस उत्तरेणापि श्रीमतः ।\nये मया पूर्वतः प्रोक्तास्तान्वदिष्ये यथाक्रमम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001539030, "chapter_id": 21539, "verse_number": "१-३६-३१", "content_sanskrit": "शङ्कुकूटो महाशैलो वृषभो हंसपर्वतः ।\nनागश्च कपिलश्चैव इन्द्रशैलश्च सानुमान् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001539031, "chapter_id": 21539, "verse_number": "१-३६-३२", "content_sanskrit": "नीलः कनक श्रृङ्गश्च शतश्रृङ्गश्च पर्वतः ।\nपुष्पको मेघशैलश्च विराजश्चाचलोत्तमः ।\nजारुधिश्चैव शैलेन्द्र इत्येते उत्तराः स्मृताः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001539032, "chapter_id": 21539, "verse_number": "१-३६-३३", "content_sanskrit": "एतेषां शैलमुख्यानामन्तरेषु यथाक्रमम् ।\nस्थल्योऽह्यन्तरद्रोण्यश्च सरांसि च निबोधत ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001539033, "chapter_id": 21539, "verse_number": "१-३६-३४", "content_sanskrit": "इति श्रीमहापुराणे वायुप्रोक्ते भुवनविन्यासो नाम षट्‌त्रिंशोऽध्यायः॥ ३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]