[{"id": 7003651000, "chapter_id": 23651, "verse_number": "१-२-३८-१", "content_sanskrit": "नारद उवाच ।\nभूमेर्योजनलक्षे च कौरव्य रविमंडलम् ।\nयोजनानां सहस्राणि भास्करस्य रथो नव ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003651001, "chapter_id": 23651, "verse_number": "१-२-३८-२", "content_sanskrit": "ईषादंडस्ततैवास्य द्विगुणः परिकीर्तितः ।\nसार्धकोटिस्तथा सप्त नियुतानि विवस्वतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003651002, "chapter_id": 23651, "verse_number": "१-२-३८-३", "content_sanskrit": "योजनानां तु तस्याक्षस्तत्र चक्रं प्रतिष्ठितम् ।\nत्रिनाभि तच्च पंचारं षण्नेमि परिकीर्तितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003651003, "chapter_id": 23651, "verse_number": "१-२-३८-४", "content_sanskrit": "चत्वारिंशत्सहस्राणि द्वितीयोऽक्षोऽपि विस्तृतः ।\nपंच चान्यानि सार्द्धानि स्यन्दनस्य तु पांडव ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003651004, "chapter_id": 23651, "verse_number": "१-२-३८-५", "content_sanskrit": "अक्षप्रमाणमुभयोः प्रमाणं तद्युगार्द्धयोः ।\nह्रस्वोऽक्षस्तद्युगार्द्धं च ध्रुवाधारं रथस्य वै ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003651005, "chapter_id": 23651, "verse_number": "१-२-३८-६", "content_sanskrit": "द्वितीयोऽक्षस्तथा सव्ये चक्रं तन्मानसे स्थितम् ।\nहयाश्च सप्त च्छांदांसि तेषां नामानि मे श्रृणु ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003651006, "chapter_id": 23651, "verse_number": "१-२-३८-७", "content_sanskrit": "गायत्री च बृहत्युष्णिग्जगती त्रिष्टुवेव च ।\nअनुष्टुप्पंक्तिरित्युक्ताश्छंदांसि हरयो रवेः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003651007, "chapter_id": 23651, "verse_number": "१-२-३८-८", "content_sanskrit": "नैवास्तमनमर्कस्य नोदयः सर्वदा सतः ।\nउदयास्तमनाक्यं हि दर्शनादर्शनं रवेः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003651008, "chapter_id": 23651, "verse_number": "१-२-३८-९", "content_sanskrit": "शक्रदीनां पुरे तिष्ठन्स्पृशत्येष पुरत्रयम् ।\nविकीर्णोऽतो विकर्णस्थस्त्रिकोणार्धपुरे तथा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003651009, "chapter_id": 23651, "verse_number": "१-२-३८-१०", "content_sanskrit": "अयनस्योत्तरस्यादौ मकरं याति भास्करः ।\nततः कुम्भं च मीनं च राशे राश्यंतरं तथा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003651010, "chapter_id": 23651, "verse_number": "१-२-३८-११", "content_sanskrit": "त्रिष्वेतेष्वथ भुक्तेषु ततो वैषुवतीं गतिम् ।\nप्रयाति सविता कुर्वन्नहोरात्रं च तत्समम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003651011, "chapter_id": 23651, "verse_number": "१-२-३८-१२", "content_sanskrit": "ततो रात्रिः क्षयं याति वर्धते तु दिनं दिनम् ।\nततश्च मिथुनस्यांते परां काष्ठामुपागतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003651012, "chapter_id": 23651, "verse_number": "१-२-३८-१३", "content_sanskrit": "राशिं कर्कटकं प्राप्य कुरुते दक्षिणायांनम् ।\nकुलालचक्रपर्यंतो यथा शीघ्रं निवर्तते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003651013, "chapter_id": 23651, "verse_number": "१-२-३८-१४", "content_sanskrit": "दक्षिणायक्रमे सूर्यस्तथा शीघ्रं निवर्तते ।\nअतिवेगितया कालं वायुमार्गबलाच्चरन् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003651014, "chapter_id": 23651, "verse_number": "१-२-३८-१५", "content_sanskrit": "तस्मात्प्रकृष्टां भूमिं स कालेनाल्पेन गच्छति ।\nकुलालचक्रमध्यस्थो यता मंदं प्रसर्पति ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003651015, "chapter_id": 23651, "verse_number": "१-२-३८-१६", "content_sanskrit": "तथोदगयने सूर्यः सर्पते मंदविक्रमः ।\nतस्माद्दीर्घेण कालेन भूमिमल्पं निगच्छति ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003651016, "chapter_id": 23651, "verse_number": "१-२-३८-१७", "content_sanskrit": "संध्याकाले च मंदेहाः सूर्यमिच्छंति खादितुम् ।\nप्रजापतिकृतः शापस्तेषां फाल्गुन रक्षसाम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003651017, "chapter_id": 23651, "verse_number": "१-२-३८-१८", "content_sanskrit": "अक्षयत्वं शरीराणां मरणं च दिनेदिने ।\nततः सूर्यस्य तैर्युद्धं भवत्यत्यंतदारुणम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003651018, "chapter_id": 23651, "verse_number": "१-२-३८-१९", "content_sanskrit": "ततो गायत्रिपूतं यद्द्विजास्तोयं क्षिपंति च ।\nतेन दह्यंति ते पापाः संध्योपासनतः सदा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003651019, "chapter_id": 23651, "verse_number": "१-२-३८-२०", "content_sanskrit": "ये संध्यां नाप्युपासंते कृतघ्ना यांति रौरवम् ।\nप्रतिमासं पृथक्सूर्य ऋषिगन्धर्वराक्षसैः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003651020, "chapter_id": 23651, "verse_number": "१-२-३८-२१", "content_sanskrit": "अप्सरोग्रामणीसर्पैरथो याति च सप्तभिः ।\nधातार्यमा मित्रवरुणौ विवस्वानिन्द्र एव च ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003651021, "chapter_id": 23651, "verse_number": "१-२-३८-२२", "content_sanskrit": "पूषा च सविता सोऽथ भगस्त्वष्टा च कीर्तितः ।\nविष्णुश्चैत्रादिमासेषु आदित्या द्वादश स्मृताः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003651022, "chapter_id": 23651, "verse_number": "१-२-३८-२३", "content_sanskrit": "ततो दिवाकरस्थानान्मंडलं शशिनः स्तितम् ।\nलक्षमात्रेण तस्यापि त्रिचक्रोरथ उच्यते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003651023, "chapter_id": 23651, "verse_number": "१-२-३८-२४", "content_sanskrit": "कुंदाभा दश चैवाश्वा वामदक्षिणतो युताः ।\nपूर्णे शतसहस्रे च योजनानां निशाकरात् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003651024, "chapter_id": 23651, "verse_number": "१-२-३८-२५", "content_sanskrit": "नक्षत्रमण्डलं कृत्स्नमुपरिष्टात्प्रकाशते ।\nचतुर्दश चार्बुदान्यप्यशीतिः सरितांपतिः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003651025, "chapter_id": 23651, "verse_number": "१-२-३८-२६", "content_sanskrit": "विंशतिश्च तथा कोट्यो नक्षत्राणां प्रकीर्तिताः ।\nद्वे लक्षे चोत्तरे तस्माद्बुधो नक्षत्रमण्डलात् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003651026, "chapter_id": 23651, "verse_number": "१-२-३८-२७", "content_sanskrit": "वाय्वग्निद्रव्यसंभूतो रथश्चंद्रसुतस्य च ।\nपिशंगैस्तुरसोष्टाभिर्वायवेगिभिः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003651027, "chapter_id": 23651, "verse_number": "१-२-३८-२८", "content_sanskrit": "द्विलक्षश्चोत्तरे तस्माद्बुधाच्चाप्युशना स्मृतः ।\nशुक्रस्यापि रथोष्टाभिर्युक्तोऽभूत्संभवैर्हयैः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003651028, "chapter_id": 23651, "verse_number": "१-२-३८-२९", "content_sanskrit": "लक्षद्वयेन भौमस्य स्मृतो देवपुरोहितः ।\nअष्टाभिः पांडुरैरश्वैर्युक्तोऽस्य कांचनोरथः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003651029, "chapter_id": 23651, "verse_number": "१-२-३८-३०", "content_sanskrit": "सौरिर्बृहस्पतेश्चोर्ध्वं द्विलक्षे समुपस्थितः ।\nआकाशसंभवैरश्वैरष्टाभिः शबलै रथः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003651030, "chapter_id": 23651, "verse_number": "१-२-३८-३१", "content_sanskrit": "स्वर्भानोस्तुरगाश्चाष्टौ भृंगाभा धूसरारथम् ।\nवहंति च सकृद्युक्ता आदित्याधःस्थितास्तथा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003651031, "chapter_id": 23651, "verse_number": "१-२-३८-३२", "content_sanskrit": "सौरेर्लक्षं स्मृतं चोर्ध्वं ततः सप्तर्षिमण्डलम् ।\nऋषिभ्यश्चापि लक्षेण ध्रुवश्चोर्ध्वं व्यवस्थितः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003651032, "chapter_id": 23651, "verse_number": "१-२-३८-३३", "content_sanskrit": "मेढीभूतः समस्तस्य ज्योतिश्चक्रस्य वै ध्रुवः ।\nध्रुवोऽपि शिंशुमारस्य पुच्छाधारे व्यवस्थितः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003651033, "chapter_id": 23651, "verse_number": "१-२-३८-३४", "content_sanskrit": "यमाहुर्वासुदेवस्य रूपमात्मानमव्ययम् ।\nवायुपाशैर्ध्रुवे बद्धं सर्वमेतच्च फाल्गुन ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003651034, "chapter_id": 23651, "verse_number": "१-२-३८-३५", "content_sanskrit": "नवयोजनसाहस्रं मण्डलं सवितुः स्मृतम् ।\nद्विगुणं सूर्यविस्तारान्मण्डलं शशिनः स्मृतम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003651035, "chapter_id": 23651, "verse_number": "१-२-३८-३६", "content_sanskrit": "तुल्यस्तयोस्तु स्वर्भानुर्भूत्वाधस्तात्प्रसर्पति ।\nउद्धृत्य पृथिवीच्छायां निर्मलां मण्डलाकृतिः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003651036, "chapter_id": 23651, "verse_number": "१-२-३८-३७", "content_sanskrit": "चन्द्रस्य षोडशो भागो भार्गवश्च विधीयते ।\nभार्गवात्पादहीनस्तु विज्ञेयोऽथ बृहस्पतिः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003651037, "chapter_id": 23651, "verse_number": "१-२-३८-३८", "content_sanskrit": "बृहस्पतेः पादहीनौ वक्रसौरी बुधस्तथा ।\nशतानि पंच चत्वारित्रीणि द्वे चैकयोजनम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003651038, "chapter_id": 23651, "verse_number": "१-२-३८-३९", "content_sanskrit": "योजनार्धप्रमाणानि भानि ह्रस्वं न विद्यते ।\nभूमिलोकश्च भूर्लोकः पादगम्यः प्रकीर्तितः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003651039, "chapter_id": 23651, "verse_number": "१-२-३८-४०", "content_sanskrit": "भूमिसूर्यांतरं तच्च भुवर्लोकः प्रकीर्तितः ।\nध्रुवसूर्यांतरं तच्च नियुतानि चतुर्दश ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003651040, "chapter_id": 23651, "verse_number": "१-२-३८-४१", "content_sanskrit": "स्वर्लोकः सोऽपि गदितो लोकसंस्थानचिंतकैः ।\nध्रुवादूर्ध्वं तथा कोटचिर्महर्लोकः प्रकीर्तितः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003651041, "chapter_id": 23651, "verse_number": "१-२-३८-४२", "content_sanskrit": "द्वे कोट्यौ च जनो यत्र निवसंति चतुःसनाः ।\nचतुर्भिश्चापि कोटीभिस्तपोलोकस्ततः स्मॉतः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003651042, "chapter_id": 23651, "verse_number": "१-२-३८-४३", "content_sanskrit": "वैराजा यत्र ते देवाः स्थिता दाहविवर्जिताः ।\nषड्गुणेन तपोलोकात्सत्यलोको विराजते ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003651043, "chapter_id": 23651, "verse_number": "१-२-३८-४४", "content_sanskrit": "अपुनर्मरका यत्र ब्रह्मलोको हि स स्मृतः ।\nअष्टादस तथा कोट्यो लक्षाण्यशीतिपंच च ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003651044, "chapter_id": 23651, "verse_number": "१-२-३८-४५", "content_sanskrit": "शुभं निरुपमं स्थानं तदूर्ध्वं संप्रकाशते ।\nभूर्भूवःस्वरिति प्रोक्तं त्रैलोक्यं कृतकं त्विदम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003651045, "chapter_id": 23651, "verse_number": "१-२-३८-४६", "content_sanskrit": "जनस्तपस्तथा सत्यमिति चाकृतकं त्रयम् ।\nकृतकाकृतयोर्मध्ये मर्हर्लोक इति स्मृतः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003651046, "chapter_id": 23651, "verse_number": "१-२-३८-४७", "content_sanskrit": "शून्यो भवति कल्पांते योत्यंतं न विनश्यति ।\nएते सप्त समाख्याता लोकाः पुण्यैरुपार्जिताः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003651047, "chapter_id": 23651, "verse_number": "१-२-३८-४८", "content_sanskrit": "यज्ञैर्दानैर्जपैर्होमैस्तीर्थैर्व्रतसमुच्चयैः ।\nवेदादिप्रोक्तैरन्यैश्च साध्यांल्लोकानिमान्विदुः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003651048, "chapter_id": 23651, "verse_number": "१-२-३८-४९", "content_sanskrit": "ततश्चांडस्य शिरसो धारा नीरमयी शिवा ।\nसर्वलोकान्समाप्लाव्य गंगा मेरावुपागता ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003651049, "chapter_id": 23651, "verse_number": "१-२-३८-५०", "content_sanskrit": "ततो महीतलं सर्वं पातालं प्रविवेश सा ।\nअंडमूर्ध्नि स्थिता देवी सततं द्वारवासिनी ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003651050, "chapter_id": 23651, "verse_number": "१-२-३८-५१", "content_sanskrit": "देवीनां कोटिकोटीभिः संवृता पिंगलेन च ।\nतत्र स्थिता सदा रक्षां कुरुतेऽण्डस्य सा शुभा ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003651051, "chapter_id": 23651, "verse_number": "१-२-३८-५२", "content_sanskrit": "निहंति दुष्टसंघातान्महाबलपराक्रमा ।\nवायुस्कंधानि सप्तापिश्रृणुयद्वत्स्थितान्यपि ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003651052, "chapter_id": 23651, "verse_number": "१-२-३८-५३", "content_sanskrit": "पृथिवीं समभिक्रम्य संस्थितो मेघमंडले ।\nप्रवहोनाम यो मेघान्प्रवहत्यतिशक्तिमान् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003651053, "chapter_id": 23651, "verse_number": "१-२-३८-५४", "content_sanskrit": "धूमजाश्वोष्मजा मेघाः सामुद्रैयन पूरिताः ।\nतोयैर्भवंति नीलांगा वर्षिष्ठाश्चैव भारत ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003651054, "chapter_id": 23651, "verse_number": "१-२-३८-५५", "content_sanskrit": "द्वितीयश्चावहो नाम निबद्धः सूर्यमंडले ।\nतेन बद्धं ध्रुवेणेदं भ्राम्यते सूर्यमंडलम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003651055, "chapter_id": 23651, "verse_number": "१-२-३८-५६", "content_sanskrit": "तृतीयश्चोद्वहो नाम चंद्रस्कंधे प्रतिष्ठितः ।\nबद्धं ध्रुवेण येनेदं भ्राम्यते चंद्रमंडलम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003651056, "chapter_id": 23651, "verse_number": "१-२-३८-५७", "content_sanskrit": "चतुर्थः संवहो नाम स्थितो नक्षत्रमण्डले ।\nवातरश्मिभिराबद्धं ध्रुवेण सह भ्राम्यते ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003651057, "chapter_id": 23651, "verse_number": "१-२-३८-५८", "content_sanskrit": "ग्रहेषु पंचमः सोऽपि विवहो नाम मारुतः ।\nग्रहचक्रमिदं येन भ्राम्यते ध्रुवसंधितम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003651058, "chapter_id": 23651, "verse_number": "१-२-३८-५९", "content_sanskrit": "षष्ठः परिवहो नाम स्थितः सप्तर्षिमंडले ।\nभ्रमंति ध्रुवसंबद्धा येन सप्तर्षयो दिवि ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003651059, "chapter_id": 23651, "verse_number": "१-२-३८-६०", "content_sanskrit": "सप्तमश्च ध्रुवे बद्धो वायुर्नाम्ना परावहः ।\nयेन संस्थापितं ध्रौव्यं चक्रं चान्यानि भारत ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003651060, "chapter_id": 23651, "verse_number": "१-२-३८-६१", "content_sanskrit": "यं समासाद्य वेगेन दिशामंतं प्रपेदिरे ।\nदक्षस्य दश पुत्राणां सहस्राणि प्रजापतेः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003651061, "chapter_id": 23651, "verse_number": "१-२-३८-६२", "content_sanskrit": "एवमेते दितेः पुत्राः सप्तसप्त व्यवस्थिताः ।\nअनारमंतः संवांति सर्वगाः सर्वधारिणः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003651062, "chapter_id": 23651, "verse_number": "१-२-३८-६३", "content_sanskrit": "ध्रुवादूर्ध्वमसूर्यं चाप्यनक्षत्रमतारकम् ।\nस्वतेजसा स्वशक्त्या चाधिष्ठितास्ते हि नित्यदा ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003651063, "chapter_id": 23651, "verse_number": "१-२-३८-६४", "content_sanskrit": "इत्यूर्ध्वं ते समाख्यांतं पातालान्यथ मे श्रृणु ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]