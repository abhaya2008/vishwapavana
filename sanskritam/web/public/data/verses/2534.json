[{"id": 2072709, "chapter_id": 2534, "verse_number": "१२-३९-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2072710, "chapter_id": 2534, "verse_number": "१२-३९-१", "content_sanskrit": "ततः कुन्तीसुतो राजा गतमन्युर्गतज्वरः।\nकाञ्चने प्राड्भुखो हृष्टो न्यषीदत्परमासने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2072711, "chapter_id": 2534, "verse_number": "१२-३९-२", "content_sanskrit": "तमेवाभिमुखौ पीठे प्रदीप्ते काञ्चने शुभे।\nसात्यकिर्वासुदेवश्च निषीदतुररिंदमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2072712, "chapter_id": 2534, "verse_number": "१२-३९-३", "content_sanskrit": "मध्ये कृत्वा तु राजानं भीमसेनार्जुनावुभौ।\nनिषीदतुर्महात्मानौ श्लक्ष्णयोर्मणिपीठयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2072713, "chapter_id": 2534, "verse_number": "१२-३९-४", "content_sanskrit": "दान्ते शय्यासने शुभ्रे जाम्बूनदविभूषिते।\nपृथाऽपि सहदेवेन सहास्ते नकुलेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2072714, "chapter_id": 2534, "verse_number": "१२-३९-५", "content_sanskrit": "सुधर्मा विदुरो धौम्यो धृतराष्ट्रश्च कौरवः।\nनिषेदुर्ज्वलनाकारेष्वासनेषु पृथक्पृथक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2072715, "chapter_id": 2534, "verse_number": "१२-३९-६", "content_sanskrit": "युयुत्सुः सञ्जयश्चैव गान्धारी च यशस्विनी।\nधृतराष्ट्रो यतो राजा ततः सर्वे समाविशन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2072716, "chapter_id": 2534, "verse_number": "१२-३९-७", "content_sanskrit": "तत्रोपविष्टो धर्मात्मा श्वेताः सुमनसोऽस्पृशत्।\nस्वस्तिकानक्षतान्भूमिं सुवर्णं रजतं मणीन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2072717, "chapter_id": 2534, "verse_number": "१२-३९-८", "content_sanskrit": "ततः प्रकृतयः सर्वाः पुरस्कृत्य पुरोहितम्।\nददृशुर्धर्मराजानमादाय बहुमङ्गलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2072718, "chapter_id": 2534, "verse_number": "१२-३९-९", "content_sanskrit": "पृथिवीं च सुवर्णं च रत्नानि विविधानि च।\nआभिषेचनिकं भाण्डं सर्वसंभारसंभृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2072719, "chapter_id": 2534, "verse_number": "१२-३९-१०", "content_sanskrit": "काञ्चनौदुम्बरास्तत्र राजताः पृथिवीमयाः।\nपूर्णकुम्भाः सुमनसो लाजा बर्हीषि गोरसाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2072720, "chapter_id": 2534, "verse_number": "१२-३९-११", "content_sanskrit": "शमीपिप्पलपालाशसमिधो मधुसर्पिषी।\nस्रुव औदुम्बरः शङ्खस्तथा हेमविभूषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2072721, "chapter_id": 2534, "verse_number": "१२-३९-१२", "content_sanskrit": "दाशार्हेणाभ्यनुज्ञातस्तत्र धौम्यः पुरोहितः।\nप्रागुदक्प्रवणे वेदीं लक्षणेनोपलिख्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2072722, "chapter_id": 2534, "verse_number": "१२-३९-१३", "content_sanskrit": "व्याघ्रचर्मोत्तरे शुक्ले सर्वतोभद्र आसने।\nदृढपादप्रतिष्ठाने हुताशनसमत्विपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2072723, "chapter_id": 2534, "verse_number": "१२-३९-१४", "content_sanskrit": "उपवेश्य महात्मानं कृष्णां च द्रुपदात्मजाम्।\nजुहाव पावकं धीमान्विधिमन्त्रपुरस्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2072724, "chapter_id": 2534, "verse_number": "१२-३९-१५", "content_sanskrit": "तत उत्थाय दाशार्हः शङ्खमादाय पूरितम्।\nअभ्यषिञ्चत्पतिं पृथ्व्याः कुन्तीपुत्रं युधिष्ठिरम्।\nधृतराष्ट्रश्च राजर्षिः सर्वाः प्रकृतयस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2072725, "chapter_id": 2534, "verse_number": "१२-३९-१६", "content_sanskrit": "अनुज्ञातोऽथ कृष्णेन भ्रातृभिः सह पाण्डवः।\nपाञ्चजन्याभिषिक्तश्च राजाऽमृतमुखोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2072726, "chapter_id": 2534, "verse_number": "१२-३९-१७", "content_sanskrit": "ततोऽनुवादयामासुः पणवानकदुन्दुभीन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2072727, "chapter_id": 2534, "verse_number": "१२-३९-१८", "content_sanskrit": "धर्मराजोऽपि तत्सर्वं प्रतिजग्राह धर्मतः।\nपूजयामास तांश्चापि विधिवद्भूरिदक्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2072728, "chapter_id": 2534, "verse_number": "१२-३९-१९", "content_sanskrit": "ततो निष्कसहस्रेण ब्राह्मणान्स्वस्त्यवाचयन्।\nवेदाध्ययनसंपन्नान्धृतिशीलसमन्वितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2072729, "chapter_id": 2534, "verse_number": "१२-३९-२०", "content_sanskrit": "ते प्रीता ब्राह्मणा राजन्स्वस्त्यूचुर्जयमेव च।\nहंसा इव च नर्दन्तः प्रशशंसुर्युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2072730, "chapter_id": 2534, "verse_number": "१२-३९-२१", "content_sanskrit": "युधिष्ठिर महाबाहो दिष्ट्या जयसि पाण्डव।\nदिष्ट्या स्वधर्मं प्राप्तोऽसि विक्रमेण महाद्युते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2072731, "chapter_id": 2534, "verse_number": "१२-३९-२२", "content_sanskrit": "दिष्ट्या गाण्डीवधन्वा च भीमसेनश्च पाण्डवः।\nत्वं चापि कुशली राजन्माद्रीपुत्रौ च पाण्डवौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2072732, "chapter_id": 2534, "verse_number": "१२-३९-२३", "content_sanskrit": "मुक्ता वीरक्षयात्तस्मात्संग्रामाद्विजितद्विषः।\nक्षिप्रमुत्तरकार्याणि कुरु सर्वाणि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2072733, "chapter_id": 2534, "verse_number": "१२-३९-२४", "content_sanskrit": "ततः प्रीत्याऽर्चितः सद्भिर्धर्मराजो युधिष्ठिरः।\nप्रतिपेदे महद्राज्यं सुहृद्भिः सह भारत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2072734, "chapter_id": 2534, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि एकोनचत्वारिंशोऽध्यायः॥ ३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]