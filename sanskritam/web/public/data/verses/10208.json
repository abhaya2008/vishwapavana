[{"id": 6000208000, "chapter_id": 10208, "verse_number": null, "content_sanskrit": "अथ द्वादशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000208001, "chapter_id": 10208, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.001.m4a", "display_order": 2}, {"id": 6000208002, "chapter_id": 10208, "verse_number": "१०-१२-१", "content_sanskrit": "गोपा नन्दादयः श्रुत्वा द्रुमयोः पततो रवम्।\nतत्राजग्मुः कुरुश्रेष्ठ निर्घातरवशङ्किताः॥ १०/१२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.002.m4a", "display_order": 3, "topics": [{"text": "नन्दादीनां गोकुलाद्वृन्दावनगमनम्", "range": "१–१९"}]}, {"id": 6000208003, "chapter_id": 10208, "verse_number": "१०-१२-२", "content_sanskrit": "भूम्यां निपतितौ तत्र ददृशुर्यमलार्जुनौ।\nबभ्रमुस्तदविज्ञाय लक्ष्यं पतनकारणम्॥ १०/१२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.003.m4a", "display_order": 4}, {"id": 6000208004, "chapter_id": 10208, "verse_number": "१०-१२-३", "content_sanskrit": "उलूखलं विकर्षन्तं दाम्ना बद्धं च बालकम्।\nकस्येदं कुत आश्चर्यमुत्पातभयकातराः॥ १०/१२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.004.m4a", "display_order": 5}, {"id": 6000208005, "chapter_id": 10208, "verse_number": "१०-१२-४", "content_sanskrit": "बाला ऊचुरनेनेति तिरश्चीनमुलूखलम्।\nविकर्षता मध्यगेन पुरुषावप्यचक्ष्महि॥ १०/१२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.005.m4a", "display_order": 6}, {"id": 6000208006, "chapter_id": 10208, "verse_number": "१०-१२-५", "content_sanskrit": "न ते तदुक्तं जगृहुर्न घटेतेति तस्य तत्।\nबालस्योत्पाटनं तर्वोः केचित् सन्दिग्धचेतसः॥ १०/१२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.006.m4a", "display_order": 7}, {"id": 6000208007, "chapter_id": 10208, "verse_number": "१०-१२-६", "content_sanskrit": "उलूखलं विकर्षन्तं दाम्ना बद्धं स्वमात्मजम्।\nविलोक्य नन्दः प्रहसद्वदनो विमुमोच ह॥ १०/१२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.007.m4a", "display_order": 8}, {"id": 6000208008, "chapter_id": 10208, "verse_number": "१०-१२-७", "content_sanskrit": "गोपीभिः स्तोभितोऽनृत्यद् भगवान् बालवत्क्‍वचित्।\nउद्गायति क्‍वचिन्मुग्धस्तद्वशो दारुयन्त्रवत्॥ १०/१२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.008.m4a", "display_order": 9}, {"id": 6000208009, "chapter_id": 10208, "verse_number": "१०-१२-८", "content_sanskrit": "बिभर्ति क्‍वचिदाज्ञप्तः पीठकोन्मानपादुकम्।\nबाहुक्षेपं च कुरुते स्वानां च प्रीतिमावहन्॥ १०/१२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.009.m4a", "display_order": 10}, {"id": 6000208010, "chapter_id": 10208, "verse_number": "१०-१२-९", "content_sanskrit": "दर्शयंस्तद्विदां लोक आत्मनो भक्तवश्यताम्।\nव्रजस्योद्वाहयन् हर्षं भगवान् बालचेष्टितैः॥ १०/१२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.010.m4a", "display_order": 11}, {"id": 6000208011, "chapter_id": 10208, "verse_number": "१०-१२-१०", "content_sanskrit": "गोपवृद्धा महोत्पाताननुभूय बृहद्वने।\nनन्दादयः समागम्य व्रजकार्यमचिन्तयन्॥ १०/१२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.011.m4a", "display_order": 12}, {"id": 6000208012, "chapter_id": 10208, "verse_number": "१०-१२-११", "content_sanskrit": "तत्रोपानन्दनामाऽऽह गोपो ज्ञानवयोधिकः।\nदेशकालार्थतत्त्वज्ञः प्रियकृद् रामकृष्णयोः॥ १०/१२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.012.m4a", "display_order": 13}, {"id": 6000208013, "chapter_id": 10208, "verse_number": "१०-१२-१२", "content_sanskrit": "उत्थातव्यमितोऽस्माभिर्गोकुलस्य हितैषिभिः।\nआयान्त्यत्र महोत्पाताः प्रजानां नाशहेतवः॥ १०/१२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.013.m4a", "display_order": 14}, {"id": 6000208014, "chapter_id": 10208, "verse_number": "१०-१२-१३", "content_sanskrit": "मुक्तः कथञ्चिद् राक्षस्या बालघ्न्या बालकोऽप्यसौ।\nहरेरनुग्रहान्नूनमनश्चोपरि नापतत्॥ १०/१२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.014.m4a", "display_order": 15}, {"id": 6000208015, "chapter_id": 10208, "verse_number": "१०-१२-१४", "content_sanskrit": "चक्रवातेन नीतोऽयं दैत्येन वियदूह्यता।\nशिलायां पातितस्तत्र परित्रातः सुरेश्वरैः॥ १०/१२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.015.m4a", "display_order": 16}, {"id": 6000208016, "chapter_id": 10208, "verse_number": "१०-१२-१५", "content_sanskrit": "यन्न म्रियेत द्रुमयोरन्तरं प्राप्य बालकः।\nअसावन्यतमो वाऽपि तच्चाप्यच्युतरक्षणम्॥ १०/१२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.016.m4a", "display_order": 17}, {"id": 6000208017, "chapter_id": 10208, "verse_number": "१०-१२-१६", "content_sanskrit": "यावदौत्पातिकोऽरिष्टो व्रजं नाभिभवेदितः।\nतावद् बालानुपादाय यास्यामोऽद्यैव सानुगाः॥ १०/१२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.017.m4a", "display_order": 18}, {"id": 6000208018, "chapter_id": 10208, "verse_number": "१०-१२-१७", "content_sanskrit": "वनं वृन्दावनं नाम पशव्यं नवकाननम्।\nगोपगोपीगवां सेव्यं पुण्याद्रितृणवीरुधम्॥ १०/१२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.018.m4a", "display_order": 19}, {"id": 6000208019, "chapter_id": 10208, "verse_number": "१०-१२-१८", "content_sanskrit": "तत् तत्राद्यैव यास्यामः शकटान् युङ्ध्व माचिरम्।\nगोधनान्यग्रतो यान्तु भवतां यदि रोचते॥ १०/१२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.019.m4a", "display_order": 20}, {"id": 6000208020, "chapter_id": 10208, "verse_number": "१०-१२-१९", "content_sanskrit": "तच्छ्रुत्वैकधियो गोपास्सर्वे नन्दपुरोगमाः।\nउपनन्दवचो राजन् प्रतिनन्द्य गृहान् ययुः॥ १०/१२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.020.m4a", "display_order": 21}, {"id": 6000208021, "chapter_id": 10208, "verse_number": "१०-१२-२०", "content_sanskrit": "सरित्तीरगतं कृष्णं भग्नार्जुनमथाह्वयत्।\nरामं च रोहिणी देवी क्रीडन्तौ बालकैर्भृशम्॥ १०/१२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.021.m4a", "display_order": 22, "topics": [{"text": "श्रीकृष्णरामयोर्बालक्रीडाविशेषकथनम्", "range": "२०–३५"}]}, {"id": 6000208022, "chapter_id": 10208, "verse_number": "१०-१२-२१", "content_sanskrit": "नोपेयातां यदाहूतौ क्रीडासङ्गेन पुत्रकौ।\nयशोदां प्रेषयामास रोहिणी पुत्रवत्सला॥ १०/१२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.022.m4a", "display_order": 23}, {"id": 6000208023, "chapter_id": 10208, "verse_number": "१०-१२-२२", "content_sanskrit": "क्रीडन्तं स्वसुतं बालमतिवेलं सहाग्रजम्।\nयशोदाऽजोहवीद् वीक्ष्य पुत्रस्नेहस्नुतस्तनी॥ १०/१२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.023.m4a", "display_order": 24}, {"id": 6000208024, "chapter_id": 10208, "verse_number": "१०-१२-२३", "content_sanskrit": "कृष्ण कृष्णारविन्दाक्ष तात एहि स्तनं पिब।\nअलं विहारैः क्षुत्क्षान्तस्तद् भवान् भोक्तुमर्हति॥ १०/१२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.024.m4a", "display_order": 25}, {"id": 6000208025, "chapter_id": 10208, "verse_number": "१०-१२-२४", "content_sanskrit": "हे रामागच्छ ताताशु सानुजः कुलनन्दन।\nप्रातरेव कृताहारः क्रीडाश्रान्तोऽसि पुत्रक॥ १०/१२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.025.m4a", "display_order": 26}, {"id": 6000208026, "chapter_id": 10208, "verse_number": "१०-१२-२५", "content_sanskrit": "प्रतीक्षते त्वां दाशार्हो भोक्ष्यमाणो व्रजाधिपः।\nएह्यावयोः प्रियं धेहि स्वगृहान् यान्तु बालकाः॥ १०/१२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.026.m4a", "display_order": 27}, {"id": 6000208027, "chapter_id": 10208, "verse_number": "१०-१२-२६", "content_sanskrit": "जन्मर्क्षं तेऽद्य भविता विप्रेभ्यो देहि गाः शुचिः।\nधूलिधूसरिताङ्गस्त्वं तात मज्जनमावह॥ १०/१२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.027.m4a", "display_order": 28}, {"id": 6000208028, "chapter_id": 10208, "verse_number": "१०-१२-२७", "content_sanskrit": "पश्य पश्य वयस्यांस्ते मातृमृष्टान् स्वलङ्कृतान्।\nत्वं च स्नातः कृताहारो विहरस्व स्वलङ्कृतः॥ १०/१२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.028.m4a", "display_order": 29}, {"id": 6000208029, "chapter_id": 10208, "verse_number": "१०-१२-२८", "content_sanskrit": "इत्थं यशोदा तमशेषशेखरं मत्वा सुतं स्नेहनिबद्धधीर्नृप।\nहस्ते गृहीत्वा सहराममच्युतं नीत्वा स्ववाटं कृतवत्यथोदयम्॥ १०/१२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.029.m4a", "display_order": 30}, {"id": 6000208030, "chapter_id": 10208, "verse_number": "१०-१२-२९", "content_sanskrit": "अथ नन्दः समाहूय गोपानिदमभाषत।\nश्वोऽतो वृन्दावनं यामो यत्ता भवथ माचिरम्॥ १०/१२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.030.m4a", "display_order": 31}, {"id": 6000208031, "chapter_id": 10208, "verse_number": "१०-१२-३०", "content_sanskrit": "तच्छ्रुत्वैकधियो गोपाः साधु साध्विति वादिनः।\nरथान् स्वान् स्वान् समायुज्य ययू रूढपरिच्छदाः॥ १०/१२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.031.m4a", "display_order": 32}, {"id": 6000208032, "chapter_id": 10208, "verse_number": "१०-१२-३१", "content_sanskrit": "वृद्धान् बालान् स्‍त्रियो राजन् सर्वोपस्करणानि च।\nअनस्स्वारोप्य गोपाला यत्ता आत्तशरासनाः॥ १०/१२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.032.m4a", "display_order": 33}, {"id": 6000208033, "chapter_id": 10208, "verse_number": "१०-१२-३२", "content_sanskrit": "गोधनानि पुरस्कृत्य शृङ्गाण्यापूर्य सर्वतः।\nतूर्यघोषेण महता ययुः सहपुरोहिताः॥ १०/१२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.033.m4a", "display_order": 34}, {"id": 6000208034, "chapter_id": 10208, "verse_number": "१०-१२-३३", "content_sanskrit": "गोप्यो रूढरथा नृत्यत्कुचकुङ्कुमकान्तयः।\nकृष्णलीलां जगुः प्रीताः स्निग्धकण्ठ्यः सुवाससः॥ १०/१२/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.034.m4a", "display_order": 35}, {"id": 6000208035, "chapter_id": 10208, "verse_number": "१०-१२-३४", "content_sanskrit": "तथा यशोदारोहिण्यावेकं शकटमास्थिते।\nरेजतुः कृष्णरामाभ्यां तत्कथाश्रवणोत्सुके॥ १०/१२/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.035.m4a", "display_order": 36}, {"id": 6000208036, "chapter_id": 10208, "verse_number": "१०-१२-३५", "content_sanskrit": "वृन्दावनं सम्प्रविश्य सर्वकालसुखावहम्।\nतत्र चक्रुर्व्रजावासं शकटैरर्धचन्द्रवत्॥ १०/१२/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.036.m4a", "display_order": 37}, {"id": 6000208037, "chapter_id": 10208, "verse_number": "१०-१२-३६", "content_sanskrit": "वृन्दावनं गोवर्धनं यमुनापुलिनानि च।\nवीक्ष्यासीदुत्तमा प्रीती राममाधवयोर्नृप॥ १०/१२/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.037.m4a", "display_order": 38, "topics": [{"text": "श्रीकृष्णेन वत्सानां पालनम्", "range": "३६–३९"}]}, {"id": 6000208038, "chapter_id": 10208, "verse_number": "१०-१२-३७", "content_sanskrit": "एवं व्रजौकसां प्रीतिं यच्छन्तौ बालचेष्टितैः।\nकलवाक्यैश्च कालेन वत्सपालौ बभूवतुः॥ १०/१२/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.038.m4a", "display_order": 39}, {"id": 6000208039, "chapter_id": 10208, "verse_number": "१०-१२-३८", "content_sanskrit": "अविदूरे व्रजभुवः सह गोपालबालकैः।\nचारयामासतुर्वत्सान् नानाक्रीडापरिच्छदौ॥ १०/१२/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.039.m4a", "display_order": 40}, {"id": 6000208040, "chapter_id": 10208, "verse_number": "१०-१२-३९", "content_sanskrit": "क्‍वचिद् वादयतो वेणून् क्षेपणैः क्षिपतःक्‍वचित्।\nक्‍वचित् पदैः किङ्किणीभिः क्‍वचित् कृत्रिमगोवृषैः॥ १०/१२/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.040.m4a", "display_order": 41}, {"id": 6000208041, "chapter_id": 10208, "verse_number": "१०-१२-४०", "content_sanskrit": "वृषायमाणौ नर्दन्तौ युयुधाते परस्परम्।\nअनुकृत्य रुतैर्जन्तून् चेरतुः प्राकृतौ यथा॥ १०/१२/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.041.m4a", "display_order": 42, "topics": [{"text": "श्रीकृष्णेन वत्सासुरबकासुरयोर्हननम्", "range": "४०–६०"}]}, {"id": 6000208042, "chapter_id": 10208, "verse_number": "१०-१२-४१", "content_sanskrit": "कदाचिद् यमुनातीरे वत्सान् चारयतोः स्वकैः।\nवयस्यैः कृष्णबलयोर्जिघांसुर्दैत्य आगमत्॥ १०/१२/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.042.m4a", "display_order": 43}, {"id": 6000208043, "chapter_id": 10208, "verse_number": "१०-१२-४२", "content_sanskrit": "तं वत्सरूपिणं वीक्ष्य वत्सयूथगतं हरिः।\nदर्शयन् बलदेवाय शनैर्मुग्ध इवासदत्॥ १०/१२/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.043.m4a", "display_order": 44}, {"id": 6000208044, "chapter_id": 10208, "verse_number": "१०-१२-४३", "content_sanskrit": "गृहीत्वाऽपरपादाभ्यां सहलाङ्गूलमच्युतः।\nभ्रामयित्वा कपित्थाग्रे प्राहिणोद् गतजीवितम्॥ १०/१२/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.044.m4a", "display_order": 45}, {"id": 6000208045, "chapter_id": 10208, "verse_number": "१०-१२-४४", "content_sanskrit": "स कपित्थैर्महाकायः पात्यमानैः पपात ह।\nतं वीक्ष्य विस्मिता बालाः शशंसुः साधु साध्विति॥ १०/१२/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.045.m4a", "display_order": 46}, {"id": 6000208046, "chapter_id": 10208, "verse_number": "१०-१२-४५", "content_sanskrit": "देवाश्चोपरि सन्तुष्टा बभूवुः पुष्पवर्षिणः।\nतौ वत्सपालकौ भूत्वा सर्वलोकैकपालकौ॥ १०/१२/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.046.m4a", "display_order": 47}, {"id": 6000208047, "chapter_id": 10208, "verse_number": "१०-१२-४६", "content_sanskrit": "सप्रातराशौ गोवत्सान् चारयन्तौ विचेरतुः।\nस्वं स्वं वत्सकुलं सर्वे पाययिष्यन्त एकदा॥ १०/१२/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.047.m4a", "display_order": 48}, {"id": 6000208048, "chapter_id": 10208, "verse_number": "१०-१२-४७", "content_sanskrit": "गत्वा जलाशयाभ्याशं पाययित्वा पपुर्जलम्।\nते तत्र ददृशुर्बाला महासत्त्वमवस्थितम्॥ १०/१२/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.048.m4a", "display_order": 49}, {"id": 6000208049, "chapter_id": 10208, "verse_number": "१०-१२-४८", "content_sanskrit": "तत्रसुर्वज्रसंभिन्नगिरेः शृङ्गमिव च्युतम्।\nस वै बको नाम महानसुरो बकरूपधृक्॥ १०/१२/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.049.m4a", "display_order": 50}, {"id": 6000208050, "chapter_id": 10208, "verse_number": "१०-१२-४९", "content_sanskrit": "आगत्य तरसा कृष्णं तीक्ष्णतुण्डोऽग्रसद् बली॥ १०/१२/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.050.m4a", "display_order": 51}, {"id": 6000208051, "chapter_id": 10208, "verse_number": "१०-१२-५०", "content_sanskrit": "कृष्णं महासुरग्रस्तं दृष्ट्वा रामादयोऽर्भकाः।\nबभूवुरिन्द्रियाणीव विना प्राणैर्विचेतसः॥ १०/१२/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.051.m4a", "display_order": 52}, {"id": 6000208052, "chapter_id": 10208, "verse_number": "१०-१२-५१", "content_sanskrit": "तं तालुमूलं प्रदहन्तमग्निवद् गोपालसूनुं पितरं जगद्गुरोः।\nचच्छर्द सद्योऽतिरुषाऽक्षतं बकस्तुण्डेन हन्तुं पुनरभ्यपद्यत॥ १०/१२/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.052.m4a", "display_order": 53}, {"id": 6000208053, "chapter_id": 10208, "verse_number": "१०-१२-५२", "content_sanskrit": "तमापतन्तं स निगृह्य तुण्डयोर्दोर्भ्यां बकं कंससखं सतां पतिः।\nपश्यत्सु बालेषु ददार लीलया मुदावहो वीरणवद् दिवौकसाम्॥ १०/१२/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.053.m4a", "display_order": 54}, {"id": 6000208054, "chapter_id": 10208, "verse_number": "१०-१२-५३", "content_sanskrit": "तदा बकारिं सुरलोकवासिनः समाकिरन् नन्दनमल्लिकादिभिः।\nसमीडिरे चानकशङ्खसंस्तवैस्तद् वीक्ष्य गोपालसुता विसिस्मिरे॥ १०/१२/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.054.m4a", "display_order": 55}, {"id": 6000208055, "chapter_id": 10208, "verse_number": "१०-१२-५४", "content_sanskrit": "मुक्तं बकास्यादुपलभ्य बालका रामादयः प्राणमिवैन्द्रियो गणः।\nस्थानागतं तं परिरभ्य निर्वृताः प्रणीय वत्सान् व्रजमेत्य तज्जगुः॥ १०/१२/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.055.m4a", "display_order": 56}, {"id": 6000208056, "chapter_id": 10208, "verse_number": "१०-१२-५५", "content_sanskrit": "तच्छ्रुत्वा विस्मिता गोपा गोप्यश्चातिप्रियादृताः।\nप्रेत्यागतमिवौत्सुक्यादैक्षन्त तृषितेक्षणाः॥ १०/१२/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.056.m4a", "display_order": 57}, {"id": 6000208057, "chapter_id": 10208, "verse_number": "१०-१२-५६", "content_sanskrit": "अहो बतास्य बालस्य बहवो मृत्यवोऽभवन्।\nअप्यासीद् विप्रियं तेषां कृतं पूर्वं यतो भयम्॥ १०/१२/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.057.m4a", "display_order": 58}, {"id": 6000208058, "chapter_id": 10208, "verse_number": "१०-१२-५७", "content_sanskrit": "अथाप्यभिभवन्त्येनं न ह्येते घोरदर्शनाः।\nजिघांसयैनमासाद्य नश्यन्त्यग्नौ पतङ्गवत्॥ १०/१२/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.058.m4a", "display_order": 59}, {"id": 6000208059, "chapter_id": 10208, "verse_number": "१०-१२-५८", "content_sanskrit": "अहो ब्रह्मविदां वाचो नासत्याः सन्ति कर्हिचित्।\nगर्गो यदाह भगवानन्वभावि तथैव तत्॥ १०/१२/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.059.m4a", "display_order": 60}, {"id": 6000208060, "chapter_id": 10208, "verse_number": "१०-१२-५९", "content_sanskrit": "इति नन्दादयो गोपा रामकृष्णकथां मुदा।\nकुर्वन्तो रममाणाश्च नाविन्दन् भववेदनाम्॥ १०/१२/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.060.m4a", "display_order": 61}, {"id": 6000208061, "chapter_id": 10208, "verse_number": "१०-१२-६०", "content_sanskrit": "एवं विहारैः कौमारैः कौमारं जहतुर्व्रजे।\nनिलायनैः सेतुबन्धैर्मर्कटोत्प्लवनादिभिः॥ १०/१२/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_012/BhP_10.012.061.m4a", "display_order": 62}, {"id": 6000208062, "chapter_id": 10208, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धे द्वादशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]