[{"id": 2113911, "chapter_id": 3450, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2113912, "chapter_id": 3450, "verse_number": "१", "content_sanskrit": "ततो द्रुपदमागम्य भारद्वाजः प्रतापवान् ।\nअब्रवीत् पुरुषव्याघ्रं सखायं विद्धि मामिति\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2113913, "chapter_id": 3450, "verse_number": "२", "content_sanskrit": "इत्येवमुक्तः सख्या स प्रीतिपूर्वं जनेश्वरः ।\nभारद्वाजेन पाञ्चालो रोषात् संरक्तलोचनः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2113914, "chapter_id": 3450, "verse_number": "३", "content_sanskrit": "नामृष्यत वचः सख्युः प्रीतिपूर्वमुदाहृतम् ।\nस चैश्वर्यमदेनान्ध इति राजाऽब्रवीद् वचः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2113915, "chapter_id": 3450, "verse_number": "४", "content_sanskrit": "अकृतेयं तव प्रज्ञा ब्रह्मन् नातिसमञ्जसी ।\nयन्मां ब्रवीषि प्रसभं सखा तेऽहमिति द्विज \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2113916, "chapter_id": 3450, "verse_number": "५", "content_sanskrit": "न हि राज्ञामुदीर्णानामेवम्भूतैर्नरैः क्वचित् ।\nसख्यं भवति मन्दात्मन् ह्रिया हीनैर्धनच्युतैः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2113917, "chapter_id": 3450, "verse_number": "६", "content_sanskrit": "सौहृदान्यपि जीर्यन्ते कालेन परिजीर्यता ।\nसौहृदं मे त्वया ह्यासीत् पूर्वं सामर्थ्यबन्धनम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2113918, "chapter_id": 3450, "verse_number": "७", "content_sanskrit": "न सख्यमजरं लोके दृश्यते जातु कर्हिचित् ।\nकामश्चैनं नाशयति क्रोधश्चैनं प्रमर्दति\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2113919, "chapter_id": 3450, "verse_number": "८", "content_sanskrit": "न वै जीर्णमुपातिष्ठ सख्यं नवमुपाकुरु ।\nआदत्स्वैनं द्विजश्रेष्ठ सौहृदं ह्यर्थबन्धनम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2113920, "chapter_id": 3450, "verse_number": "९", "content_sanskrit": "न दरिद्रो वसुमतो नाविद्वान् विदुषः सखा ।\nन शूरस्य सखा क्लीबः सखिपूर्वं किमिष्यते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2113921, "chapter_id": 3450, "verse_number": "१०", "content_sanskrit": "ययोरेव समं वित्तं ययोः प्रज्ञा ययोश्श्रुतम् ।\nतयोः सम्बन्धकं तुल्यं नतु पुष्टविपुष्टयोः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2113922, "chapter_id": 3450, "verse_number": "११", "content_sanskrit": "नाश्रोत्रियः श्रोत्रियस्य नारथी रथिनः सखा ।\nनाराज्ञः सङ्गतं राज्ञः सखिपूर्वं किमिष्यते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2113923, "chapter_id": 3450, "verse_number": "१२", "content_sanskrit": "त्वद्विधैर्मद्विधानां हि प्रक्षीणार्थैर्न जातुचित् ।\nसख्यं भवति मन्दात्मन् सखिपूर्वं किमिष्यते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2113924, "chapter_id": 3450, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2113925, "chapter_id": 3450, "verse_number": "१३", "content_sanskrit": "द्रुपदेनैवमुक्तस्तु भारद्वाजः प्रतापवान् ।\nमूहूर्तं चिन्तयामास मन्युनाऽभिपरिप्लुतः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2113926, "chapter_id": 3450, "verse_number": "१४", "content_sanskrit": "स विनिश्चित्य मनसा पाञ्चालं प्रति बुद्धिमान् ।\nशिष्यैः परिवृतः श्रीमान् पुत्रेणानुगतस्तदा \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2113927, "chapter_id": 3450, "verse_number": "१५", "content_sanskrit": "जगाम कुरुमुख्यानां नगरं नागसाह्वयम् ।\nस्यालस्यैव गृहं द्रोणः सदारः पर्युपस्थितः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2113928, "chapter_id": 3450, "verse_number": "१६", "content_sanskrit": "अश्वत्थाम्ना च पुत्रेण महाबलवता सह ।\nअवसत् तत्र राजेन्द्र गौतमस्य निवेशने \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2113929, "chapter_id": 3450, "verse_number": "१७", "content_sanskrit": "स कृपस्यान्तरे पार्थान् भारद्वाजः प्रतापवान् ।\nअस्त्राणि शिक्षयामास बुबोध च स तं कृपः ।\nआवासे तत्र गूढात्मा कञ्चित्कालमुवास ह\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2113930, "chapter_id": 3450, "verse_number": "१२९", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nएकोनत्रिंशत्यधिकशततमोऽध्यायः ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2113931, "chapter_id": 3450, "verse_number": "७७", "content_sanskrit": "॥ इति सम्भवपर्वणि सप्तसप्ततितमोऽध्यायः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2113932, "chapter_id": 3450, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]