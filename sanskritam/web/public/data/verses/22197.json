[{"id": 7002197000, "chapter_id": 22197, "verse_number": "२४२-१", "content_sanskrit": "राम उवाच ।\nषड्विधन्तु बलं व्यूह्य देवान् प्रार्च्य रिपुं व्रजेत् ।\nमौलं भूतं श्रोणिसुहृद्द्विषदाटविकं बलं ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002197001, "chapter_id": 22197, "verse_number": "२४२-२", "content_sanskrit": "पूर्वं पूर्वं गरीयस्तु बलानां व्यसनं तथा ।\nषडङ्गं मन्त्रकोषाभ्यां पदात्यश्वरथद्विपैः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002197002, "chapter_id": 22197, "verse_number": "२४२-३", "content_sanskrit": "नद्यद्रवनदुर्गेषु यत्र यत्र भयं भवेत् ।\nसेनापतिस्तत्र तत्र गच्छेद्व्यूहीकृतैर्बलैः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002197003, "chapter_id": 22197, "verse_number": "२४२-४", "content_sanskrit": "नायकः पुरतो यायात्प्रवीरपुरुषावृतः ।\nमध्ये कलत्रं स्वामी च कोषः फल्गु च यद्बलं ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002197004, "chapter_id": 22197, "verse_number": "२४२-५", "content_sanskrit": "पार्श्वयोरुभयोरश्वा वाजिनां पार्श्वयो रथाः ।\nरथानां पार्श्वयोर्नागा नागानां चाटवीबलं ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002197005, "chapter_id": 22197, "verse_number": "२४२-६", "content_sanskrit": "पश्चात्सेनापतिः सर्वं पुरस्कृत्य कृती स्वयं ।\nयायात्सन्नद्धसैन्यौघः खिन्नानाश्वासयञ्च्छनैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002197006, "chapter_id": 22197, "verse_number": "२४२-७", "content_sanskrit": "यायाद्व्यूहेन महता मकरेण पुरोभये ।\nश्येनेनोद्धृतपक्षेण सूच्या वा वीरवक्त्रया ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002197007, "chapter_id": 22197, "verse_number": "२४२-८", "content_sanskrit": "पश्चाद्भये तु शकटं पार्श्वयोर्वज्रसञ्ज्ञितं ।\nसर्वतः सर्वतोभद्रं भये व्यूहं प्रकल्पयेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002197008, "chapter_id": 22197, "verse_number": "२४२-९", "content_sanskrit": "कन्दरे शैलगहने निम्नगावनसङ्कटे ।\nदीर्घाध्वनि परिश्रान्तं क्षुत्पिपासाहितक्लमं ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002197009, "chapter_id": 22197, "verse_number": "२४२-१०", "content_sanskrit": "व्याधिदुर्भिक्षमरकपीडितं दस्युविद्रुतं ।\nपङ्कांशुजलस्कन्धं व्यस्तं पुञ्जीकृतं पथि ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002197010, "chapter_id": 22197, "verse_number": "२४२-११", "content_sanskrit": "प्रसुप्तं भोजनव्यग्रमभूमिष्ठमसुस्थितं ।\nचौराग्निभयवित्रस्तं वृष्टिवातसमाहतं ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002197011, "chapter_id": 22197, "verse_number": "२४२-१२", "content_sanskrit": "इत्यादौ स्वचमूं रक्षेत्प्रसैन्यं च घतयेत् ।\nविशिष्टो देशकालाभ्यां भिन्नविप्रकृतिर्बली ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002197012, "chapter_id": 22197, "verse_number": "२४२-१३", "content_sanskrit": "कुर्यात्प्रकाशयुद्धं हि कूटयुद्धं विपर्यये ।\nतेष्ववस्कन्दकालेषु परं हन्यात्समाकुलं ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]