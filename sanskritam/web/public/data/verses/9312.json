[{"id": 5000312000, "chapter_id": 9312, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे चत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000312001, "chapter_id": 9312, "verse_number": "४-४०-१", "content_sanskrit": "अथ राजा समृद्धार्थः सुग्रीवः प्लवगेश्वरः।\nउवाच नरशार्दूलं रामं परबलार्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000312002, "chapter_id": 9312, "verse_number": "४-४०-२", "content_sanskrit": "आगता विनिविष्टाश्च बलिनः कामरूपिणः।\nवानरेन्द्रा महेन्द्राभा ये मद्विषयवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000312003, "chapter_id": 9312, "verse_number": "४-४०-३", "content_sanskrit": "त इमे बहुविक्रान्तैर्बलिभिर्भीमविक्रमैः।\nआगता वानरा घोरा दैत्यदानवसंनिभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000312004, "chapter_id": 9312, "verse_number": "४-४०-४", "content_sanskrit": "ख्यातकर्मापदानाश्च बलवन्तो जितक्लमाः।\nपराक्रमेषु विख्याता व्यवसायेषु चोत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000312005, "chapter_id": 9312, "verse_number": "४-४०-५", "content_sanskrit": "पृथिव्यम्बुचरा राम नानानगनिवासिनः।\nकोट्योघाश्च इमे प्राप्ता वानरास्तव किंकराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000312006, "chapter_id": 9312, "verse_number": "४-४०-६", "content_sanskrit": "निदेशवर्तिनः सर्वे सर्वे गुरुहिते स्थिताः।\nअभिप्रेतमनुष्ठातुं तव शक्ष्यन्त्यरिंदम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000312007, "chapter_id": 9312, "verse_number": "४-४०-७", "content_sanskrit": "त इमे बहुसाहस्रैरनीकैर्भीमविक्रमैः।\nआगता वानरा घोरा दैत्यदानवसंनिभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000312008, "chapter_id": 9312, "verse_number": "४-४०-८", "content_sanskrit": "यन्मन्यसे नरव्याघ्र प्राप्तकालं तदुच्यताम्।\nत्वत्सैन्यं त्वद्वशे युक्तमाज्ञापयितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000312009, "chapter_id": 9312, "verse_number": "४-४०-९", "content_sanskrit": "काममेषामिदं कार्यं विदितं मम तत्त्वतः।\nतथापि तु यथायुक्तमाज्ञापयितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000312010, "chapter_id": 9312, "verse_number": "४-४०-१०", "content_sanskrit": "तथा ब्रुवाणं सुग्रीवं रामो दशरथात्मजः।\nबाहुभ्यां सम्परिष्वज्य इदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000312011, "chapter_id": 9312, "verse_number": "४-४०-११", "content_sanskrit": "ज्ञायतां सौम्य वैदेही यदि जीवति वा न वा।\nस च देशो महाप्राज्ञ यस्मिन् वसति रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000312012, "chapter_id": 9312, "verse_number": "४-४०-१२", "content_sanskrit": "अधिगम्य तु वैदेहीं निलयं रावणस्य च।\nप्राप्तकालं विधास्यामि तस्मिन् काले सह त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000312013, "chapter_id": 9312, "verse_number": "४-४०-१३", "content_sanskrit": "नाहमस्मिन् प्रभुः कार्ये वानरेन्द्र न लक्ष्मणः।\nत्वमस्य हेतुः कार्यस्य प्रभुश्च प्लवगेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000312014, "chapter_id": 9312, "verse_number": "४-४०-१४", "content_sanskrit": "त्वमेवाज्ञापय विभो मम कार्यविनिश्चयम्।\nत्वं हि जानासि मे कार्यं मम वीर न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000312015, "chapter_id": 9312, "verse_number": "४-४०-१५", "content_sanskrit": "सुहृद‍‍्द्वितीयो विक्रान्तः प्राज्ञः कालविशेषवित्।\nभवानस्मद्धिते युक्तः सुहृदाप्तोऽर्थवित्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000312016, "chapter_id": 9312, "verse_number": "४-४०-१६", "content_sanskrit": "एवमुक्तस्तु सुग्रीवो विनतं नाम यूथपम्।\nअब्रवीद् रामसांनिध्ये लक्ष्मणस्य च धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000312017, "chapter_id": 9312, "verse_number": "४-४०-१७", "content_sanskrit": "शैलाभं मेघनिर्घोषमूर्जितं प्लवगेश्वरम्।\nसोमसूर्यनिभैः सार्धं वानरैर्वानरोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000312018, "chapter_id": 9312, "verse_number": "४-४०-१८", "content_sanskrit": "देशकालनयैर्युक्तो विज्ञः कार्यविनिश्चये।\nवृतः शतसहस्रेण वानराणां तरस्विनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000312019, "chapter_id": 9312, "verse_number": "४-४०-१९", "content_sanskrit": "अधिगच्छ दिशं पूर्वां सशैलवनकाननाम्।\nतत्र सीतां च वैदेहीं निलयं रावणस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000312020, "chapter_id": 9312, "verse_number": "४-४०-२०", "content_sanskrit": "मार्गध्वं गिरिदुर्गेषु वनेषु च नदीषु च।\nनदीं भागीरथीं रम्यां सरयूं कौशिकीं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000312021, "chapter_id": 9312, "verse_number": "४-४०-२१", "content_sanskrit": "कालिन्दीं यमुनां रम्यां यामुनं च महागिरिम्।\nसरस्वतीं च सिन्धुं च शोणं मणिनिभोदकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000312022, "chapter_id": 9312, "verse_number": "४-४०-२२", "content_sanskrit": "महीं कालमहीं चापि शैलकाननशोभिताम्।\nब्रह्ममालान् विदेहांश्च मालवान् काशिकोसलान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000312023, "chapter_id": 9312, "verse_number": "४-४०-२३", "content_sanskrit": "मागधांश्च महाग्रामान् पुण्ड्रांस्त्वङ्गांस्तथैव च।\nभूमिं च कोशकाराणां भूमिं च रजताकराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000312024, "chapter_id": 9312, "verse_number": "४-४०-२४", "content_sanskrit": "सर्वं च तद् विचेतव्यं मार्गयद्भिस्ततस्ततः।\nरामस्य दयितां भार्यां सीतां दशरथस्नुषाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000312025, "chapter_id": 9312, "verse_number": "४-४०-२५", "content_sanskrit": "समुद्रमवगाढांश्च पर्वतान् पत्तनानि च।\nमन्दरस्य च ये कोटिं संश्रिताः केचिदालयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000312026, "chapter_id": 9312, "verse_number": "४-४०-२६", "content_sanskrit": "कर्णप्रावरणाश्चैव तथा चाप्योष्ठकर्णकाः।\nघोरलोहमुखाश्चैव जवनाश्चैकपादकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000312027, "chapter_id": 9312, "verse_number": "४-४०-२७", "content_sanskrit": "अक्षया बलवन्तश्च तथैव पुरुषादकाः।\nकिरातास्तीक्ष्णचूडाश्च हेमाभाः प्रियदर्शनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000312028, "chapter_id": 9312, "verse_number": "४-४०-२८", "content_sanskrit": "आममीनाशनाश्चापि किराता द्वीपवासिनः।\nअन्तर्जलचरा घोरा नरव्याघ्रा इति स्मृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000312029, "chapter_id": 9312, "verse_number": "४-४०-२९", "content_sanskrit": "एतेषामाश्रयाः सर्वे विचेयाः काननौकसः।\nगिरिभिर्ये च गम्यन्ते प्लवनेन प्लवेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000312030, "chapter_id": 9312, "verse_number": "४-४०-३०", "content_sanskrit": "यत्नवन्तो यवद्वीपं सप्तराजोपशोभितम्।\nसुवर्णरूप्यकद्वीपं सुवर्णाकरमण्डितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000312031, "chapter_id": 9312, "verse_number": "४-४०-३१", "content_sanskrit": "यवद्वीपमतिक्रम्य शिशिरो नाम पर्वतः।\nदिवं स्पृशति शृङ्गेण देवदानवसेवितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000312032, "chapter_id": 9312, "verse_number": "४-४०-३२", "content_sanskrit": "एतेषां गिरिदुर्गेषु प्रपातेषु वनेषु च।\nमार्गध्वं सहिताः सर्वे रामपत्नीं यशस्विनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000312033, "chapter_id": 9312, "verse_number": "४-४०-३३", "content_sanskrit": "ततो रक्तजलं प्राप्य शोणाख्यं शीघ्रवाहिनम्।\nगत्वा पारं समुद्रस्य सिद्धचारणसेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000312034, "chapter_id": 9312, "verse_number": "४-४०-३४", "content_sanskrit": "तस्य तीर्थेषु रम्येषु विचित्रेषु वनेषु च।\nरावणः सह वैदेह्या मार्गितव्यस्ततस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000312035, "chapter_id": 9312, "verse_number": "४-४०-३५", "content_sanskrit": "पर्वतप्रभवा नद्यः सुभीमबहुनिष्कुटाः।\nमार्गितव्या दरीमन्तः पर्वताश्च वनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000312036, "chapter_id": 9312, "verse_number": "४-४०-३६", "content_sanskrit": "ततः समुद्रद्वीपांश्च सुभीमान् द्रष्टुमर्हथ।\nऊर्मिमन्तं महारौद्रं क्रोशन्तमनिलोद्धतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000312037, "chapter_id": 9312, "verse_number": "४-४०-३७", "content_sanskrit": "तत्रासुरा महाकायाश्छायां गृह्णन्ति नित्यशः।\nब्रह्मणा समनुज्ञाता दीर्घकालं बुभुक्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000312038, "chapter_id": 9312, "verse_number": "४-४०-३८", "content_sanskrit": "तं कालमेघप्रतिमं महोरगनिषेवितम्।\nअभिगम्य महानादं तीर्थेनैव महोदधिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000312039, "chapter_id": 9312, "verse_number": "४-४०-३९", "content_sanskrit": "ततो रक्तजलं भीमं लोहितं नाम सागरम्।\nगत्वा प्रेक्ष्यथ तां चैव बृहतीं कूटशाल्मलीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000312040, "chapter_id": 9312, "verse_number": "४-४०-४०", "content_sanskrit": "गृहं च वैनतेयस्य नानारत्नविभूषितम्।\nतत्र कैलाससंकाशं विहितं विश्वकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000312041, "chapter_id": 9312, "verse_number": "४-४०-४१", "content_sanskrit": "तत्र शैलनिभा भीमा मन्देहा नाम राक्षसाः।\nशैलशृङ्गेषु लम्बन्ते नानारूपा भयावहाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000312042, "chapter_id": 9312, "verse_number": "४-४०-४२", "content_sanskrit": "ते पतन्ति जले नित्यं सूर्यस्योदयनं प्रति।\nअभितप्ताः स्म सूर्येण लम्बन्ते स्म पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000312043, "chapter_id": 9312, "verse_number": "४-४०-४३", "content_sanskrit": "निहता ब्रह्मतेजोभिरहन्यहनि राक्षसाः।\nततः पाण्डुरमेघाभं क्षीरोदं नाम सागरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000312044, "chapter_id": 9312, "verse_number": "४-४०-४४", "content_sanskrit": "गत्वा द्रक्ष्यथ दुर्धर्षा मुक्ताहारमिवोर्मिभिः।\nतस्य मध्ये महान् श्वेतो ऋषभो नाम पर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000312045, "chapter_id": 9312, "verse_number": "४-४०-४५", "content_sanskrit": "दिव्यगन्धैः कुसुमितैराचितैश्च नगैर्वृतः।\nसरश्च राजतैः पद्मैर्ज्वलितैर्हेमकेसरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000312046, "chapter_id": 9312, "verse_number": "४-४०-४६", "content_sanskrit": "नाम्ना सुदर्शनं नाम राजहंसैः समाकुलम्।\nविबुधाश्चारणा यक्षाः किंनराश्चाप्सरोगणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000312047, "chapter_id": 9312, "verse_number": "४-४०-४७", "content_sanskrit": "हृष्टाः समधिगच्छन्ति नलिनीं तां रिरंसवः।\nक्षीरोदं समतिक्रम्य तदा द्रक्ष्यथ वानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000312048, "chapter_id": 9312, "verse_number": "४-४०-४८", "content_sanskrit": "जलोदं सागरं शीघ्रं सर्वभूतभयावहम्।\nतत्र तत्कोपजं तेजः कृतं हयमुखं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000312049, "chapter_id": 9312, "verse_number": "४-४०-४९", "content_sanskrit": "अस्याहुस्तन्महावेगमोदनं सचराचरम्।\nतत्र विक्रोशतां नादो भूतानां सागरौकसाम्।\nश्रूयते चासमर्थानां दृष्ट्वाभूद् वडवामुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000312050, "chapter_id": 9312, "verse_number": "४-४०-५०", "content_sanskrit": "स्वादूदस्योत्तरे तीरे योजनानि त्रयोदश।\nजातरूपशिलो नाम सुमहान् कनकप्रभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000312051, "chapter_id": 9312, "verse_number": "४-४०-५१", "content_sanskrit": "तत्र चन्द्रप्रतीकाशं पन्नगं धरणीधरम्।\nपद्मपत्रविशालाक्षं ततो द्रक्ष्यथ वानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000312052, "chapter_id": 9312, "verse_number": "४-४०-५२", "content_sanskrit": "आसीनं पर्वतस्याग्रे सर्वदेवनमस्कृतम्।\nसहस्रशिरसं देवमनन्तं नीलवाससम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000312053, "chapter_id": 9312, "verse_number": "४-४०-५३", "content_sanskrit": "त्रिशिराः काञ्चनः केतुस्तालस्तस्य महात्मनः।\nस्थापितः पर्वतस्याग्रे विराजति सवेदिकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000312054, "chapter_id": 9312, "verse_number": "४-४०-५४", "content_sanskrit": "पूर्वस्यां दिशि निर्माणं कृतं तत् त्रिदशेश्वरैः।\nततः परं हेममयः श्रीमानुदयपर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000312055, "chapter_id": 9312, "verse_number": "४-४०-५५", "content_sanskrit": "तस्य कोटिर्दिवं स्पृष्ट्वा शतयोजनमायता।\nजातरूपमयी दिव्या विराजति सवेदिका ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000312056, "chapter_id": 9312, "verse_number": "४-४०-५६", "content_sanskrit": "सालैस्तालैस्तमालैश्च कर्णिकारैश्च पुष्पितैः।\nजातरूपमयैर्दिव्यैः शोभते सूर्यसंनिभैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000312057, "chapter_id": 9312, "verse_number": "४-४०-५७", "content_sanskrit": "तत्र योजनविस्तारमुच्छ्रितं दशयोजनम्।\nशृङ्गं सौमनसं नाम जातरूपमयं ध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000312058, "chapter_id": 9312, "verse_number": "४-४०-५८", "content_sanskrit": "तत्र पूर्वं पदं कृत्वा पुरा विष्णुस्त्रिविक्रमे।\nद्वितीयं शिखरे मेरोश्चकार पुरुषोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000312059, "chapter_id": 9312, "verse_number": "४-४०-५९", "content_sanskrit": "उत्तरेण परिक्रम्य जम्बूद्वीपं दिवाकरः।\nदृश्यो भवति भूयिष्ठं शिखरं तन्महोच्छ्रयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000312060, "chapter_id": 9312, "verse_number": "४-४०-६०", "content_sanskrit": "तत्र वैखानसा नाम वालखिल्या महर्षयः।\nप्रकाशमाना दृश्यन्ते सूर्यवर्णास्तपस्विनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000312061, "chapter_id": 9312, "verse_number": "४-४०-६१", "content_sanskrit": "अयं सुदर्शनो द्वीपः पुरो यस्य प्रकाशते।\nतस्मिंस्तेजश्च चक्षुश्च सर्वप्राणभृतामपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000312062, "chapter_id": 9312, "verse_number": "४-४०-६२", "content_sanskrit": "शैलस्य तस्य पृष्ठेषु कन्दरेषु वनेषु च।\nरावणः सह वैदेह्या मार्गितव्यस्ततस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000312063, "chapter_id": 9312, "verse_number": "४-४०-६३", "content_sanskrit": "काञ्चनस्य च शैलस्य सूर्यस्य च महात्मनः।\nआविष्टा तेजसा संध्या पूर्वा रक्ता प्रकाशते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000312064, "chapter_id": 9312, "verse_number": "४-४०-६४", "content_sanskrit": "पूर्वमेतत् कृतं द्वारं पृथिव्या भुवनस्य च।\nसूर्यस्योदयनं चैव पूर्वा ह्येषा दिगुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000312065, "chapter_id": 9312, "verse_number": "४-४०-६५", "content_sanskrit": "तस्य शैलस्य पृष्ठेषु निर्झरेषु गुहासु च।\nरावणः सह वैदेह्या मार्गितव्यस्ततस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000312066, "chapter_id": 9312, "verse_number": "४-४०-६६", "content_sanskrit": "ततः परमगम्या स्याद् दिक्पूर्वा त्रिदशावृता।\nरहिता चन्द्रसूर्याभ्यामदृश्या तमसावृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000312067, "chapter_id": 9312, "verse_number": "४-४०-६७", "content_sanskrit": "शैलेषु तेषु सर्वेषु कन्दरेषु नदीषु च।\nये च नोक्ता मयोद्देशा विचेया तेषु जानकी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 5000312068, "chapter_id": 9312, "verse_number": "४-४०-६८", "content_sanskrit": "एतावद् वानरैः शक्यं गन्तुं वानरपुङ्गवाः।\nअभास्करममर्यादं न जानीमस्ततः परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 5000312069, "chapter_id": 9312, "verse_number": "४-४०-६९", "content_sanskrit": "अभिगम्य तु वैदेहीं निलयं रावणस्य च।\nमासे पूर्णे निवर्तध्वमुदयं प्राप्य पर्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 5000312070, "chapter_id": 9312, "verse_number": "४-४०-७०", "content_sanskrit": "ऊर्ध्वं मासान्न वस्तव्यं वसन् वध्यो भवेन्मम।\nसिद्धार्थाः संनिवर्तध्वमधिगम्य च मैथिलीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 5000312071, "chapter_id": 9312, "verse_number": "४-४०-७१", "content_sanskrit": "महेन्द्रकान्तां वनषण्डमण्डितां\nदिशं चरित्वा निपुणेन वानराः।\nअवाप्य सीतां रघुवंशजप्रियां\nततो निवृत्ताः सुखिनो भविष्यथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 5000312072, "chapter_id": 9312, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे चत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}]