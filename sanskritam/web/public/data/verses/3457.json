[{"id": 2114191, "chapter_id": 3457, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2114192, "chapter_id": 3457, "verse_number": "१", "content_sanskrit": "ततः स्रस्तोत्तरपटः सप्रस्वेदः सवेपथुः ।\nविवेशाधिरथो राजन् सयष्टिः प्रस्खलन्निव \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2114193, "chapter_id": 3457, "verse_number": "२", "content_sanskrit": "तमालोक्य धनुस्त्यक्त्वा पितृगौरवयन्त्रितः ।\nकर्णोऽभिषेकार्द्रशिराः शिरसा तमवन्दत\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2114194, "chapter_id": 3457, "verse_number": "३", "content_sanskrit": "ततः पादाववच्छाद्य पटान्तेन ससम्भ्रमम् ।\nपुत्रेति परिपूर्णार्थमब्रवीद् रथसारथिम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2114195, "chapter_id": 3457, "verse_number": "", "content_sanskrit": "परिष्वज्य च तस्याङ्गं मूर्धानममरद्युतेः ।\nअङ्गराज्याभिषेकार्द्रमश्रुभिः पर्यषिञ्चत \t॥४॥।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2114196, "chapter_id": 3457, "verse_number": "५", "content_sanskrit": "तं दृष्ट्वा सूतपुत्रोऽयमिति निश्चित्य पाण्डवः ।\nभीमसेनस्तदा वाक्यं प्रहसन्निदमब्रवीत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2114197, "chapter_id": 3457, "verse_number": "", "content_sanskrit": "भीमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2114198, "chapter_id": 3457, "verse_number": "६", "content_sanskrit": "न त्वमर्हसि पार्थेन सूतपुत्र रणे वधम् ।\nकुलस्य सदृशं कर्म प्रतोदोऽयं प्रगृह्यताम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2114199, "chapter_id": 3457, "verse_number": "७", "content_sanskrit": "अङ्गराज्यं च नार्हस्त्वमुपभोक्तुं नराधम ।\nश्वा हुताशसमीपस्थं पुरोडाशमिवाध्वरे\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2114200, "chapter_id": 3457, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2114201, "chapter_id": 3457, "verse_number": "८", "content_sanskrit": "एवमुक्तस्ततः कर्णः किञ्चित् प्रस्फुरिताधरः ।\nगगनस्थं विनिश्वस्य दिवाकरमुदैक्षत \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2114202, "chapter_id": 3457, "verse_number": "९", "content_sanskrit": "ततो दुर्योधनः कोपादुत्पपात महाबलः ।\nभ्रातृपद्मवनात् तस्मान्मदोत्कट इव द्विपः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2114203, "chapter_id": 3457, "verse_number": "१०", "content_sanskrit": "सोऽब्रवीद् भीमकर्माणं भीमसेनमिदं वचः ।\nभीमसेन न युक्तं ते वचनं वक्तुमीदृशम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2114204, "chapter_id": 3457, "verse_number": "११", "content_sanskrit": "क्षत्रियाणां बलं ज्येष्ठं योद्धव्यं क्षत्रबन्धुना ।\nशूराणां च नदीनां च प्रभवो दुर्विभावनः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2114205, "chapter_id": 3457, "verse_number": "१२", "content_sanskrit": "सलिलादुत्थितो वह्निर्येन दग्धं चराचरम् ।\nदधीचस्यास्थिभिर्वज्रं कृतं दानवसूदनम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2114206, "chapter_id": 3457, "verse_number": "१३", "content_sanskrit": "आग्नेयः कृत्तिकापुत्रो रौद्रो गाङ्गेय इत्यपि ।\nश्रूयते भगवान् देवः स वै गुह्यमयो गुहः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2114207, "chapter_id": 3457, "verse_number": "१४", "content_sanskrit": "क्षत्रियासु च ये जाता ब्राह्मणास्तव विश्रुताः ।\nविश्वामित्रप्रभृतयः प्राप्ता ब्रह्मत्वमव्ययम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2114208, "chapter_id": 3457, "verse_number": "१५", "content_sanskrit": "आचार्यः कलशाज्जातो शरस्तम्बाद् गुरुः कृपः ।\nभवतां च यथा जन्म तदप्यागमितं नरैः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2114209, "chapter_id": 3457, "verse_number": "१६", "content_sanskrit": "सकुण्डलं सकवचं दिव्यलक्षणलक्षितम् ।\nकथमादित्यसङ्काशं सूतोऽमुं जनयिष्यति\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2114210, "chapter_id": 3457, "verse_number": "१७", "content_sanskrit": "एवं क्षत्रगुणैर्युक्तं शूरं समितिशोभनम् ।\nकथमादित्यसङ्काशं मृगी व्याघ्रं प्रसूयते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2114211, "chapter_id": 3457, "verse_number": "१८", "content_sanskrit": "पृथिवीराज्यमर्होऽयं नाङ्गराज्यं नरेश्वरः ।\nस्वबाहुबलवीर्येण मया चाज्ञानुवर्तिना \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2114212, "chapter_id": 3457, "verse_number": "१९", "content_sanskrit": "यस्य वा मनुजस्येदं न क्षान्तं मद्विचेष्टितम् ।\nरथमारुह्य पद्भ्यां वा विनामयतु कार्मुकम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2114213, "chapter_id": 3457, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2114214, "chapter_id": 3457, "verse_number": "२०", "content_sanskrit": "ततः सर्वस्य रङ्गस्य हाहाकारो महानभूत् ।\nसाधुवादानुसम्बद्धः सूर्यश्चास्तमुपागमत् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2114215, "chapter_id": 3457, "verse_number": "२१", "content_sanskrit": "ततो दुर्योधनः कर्णमालम्व्याग्रकरे नृपः ।\nदीपिकाभिः कृतालोकः तस्माद् रङ्गाद् विनिर्ययौ\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2114216, "chapter_id": 3457, "verse_number": "२२", "content_sanskrit": "पाण्डवाश्च सहद्रोणाः सकृपा भरतर्षभाः ।\nभीष्मेण सहिताः सर्वे ययुः स्वंस्वं निवेशनम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2114217, "chapter_id": 3457, "verse_number": "२३", "content_sanskrit": "अर्जुनेति जनः कश्चित् कश्चित् कर्णेति भारत ।\nकश्चिद्दुर्योधनेत्येवं ब्रुवन्तः प्रस्थितास्ततः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2114218, "chapter_id": 3457, "verse_number": "२४", "content_sanskrit": "कुन्त्याश्च प्रत्यभिज्ञाय दिव्यलक्षणसूचितम् ।\nपुत्रमङ्गेश्वरं स्नेहाच्छन्ना प्रीतिरवर्धत \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2114219, "chapter_id": 3457, "verse_number": "२५", "content_sanskrit": "दुर्योधनस्यापि तथा कर्णमासाद्य पार्थिव ।\nभयमर्जुनसञ्जातं क्षिप्रमन्तरधीयत\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2114220, "chapter_id": 3457, "verse_number": "२६", "content_sanskrit": "स चापि धीरः कृतशस्त्रविश्रमः\nपरेण साम्नाऽभ्यवदत् सुयोधनम् ।\nयुधिष्ठिरस्याप्यभवत् सदा मति-\nर्न कर्णतुल्योऽस्ति धनुर्धरः क्षितौ\t ॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2114221, "chapter_id": 3457, "verse_number": "१३६", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nषट्त्रिंशत्यधिकशततमोऽध्यायः ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2114222, "chapter_id": 3457, "verse_number": "८४", "content_sanskrit": "॥ इति सम्भवपर्वणि चतुरशीतितमोऽध्यायः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2114223, "chapter_id": 3457, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]