[{"id": 2148251, "chapter_id": 4208, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2148252, "chapter_id": 4208, "verse_number": "१", "content_sanskrit": "राजपुत्रैः परिवृतः तथाऽमात्यैश्च सत्तमः ।\nउपारोप्य रथे कर्णं निर्ययौ मधुसूदनः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2148253, "chapter_id": 4208, "verse_number": "२", "content_sanskrit": "किमब्रवीद् रथोपस्थे राधेयं परवीरहा ।\nकानि सान्त्वानि गोविन्दः सूतपुत्रे प्रयुक्तवान्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2148254, "chapter_id": 4208, "verse_number": "३", "content_sanskrit": "ओघमेघस्वनः काले यत् कृष्णः कर्णमब्रवीत् ।\nमृदु वा यदि वा तीक्ष्णं तन्ममाचक्ष्व सर्वशः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2148255, "chapter_id": 4208, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2148256, "chapter_id": 4208, "verse_number": "४", "content_sanskrit": "आनुपूर्व्येण वाक्यानि तीक्ष्णानि च मृदूनि च ।\nप्रियाणि धर्मयुक्तानि सत्यानि च हितानि च\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2148257, "chapter_id": 4208, "verse_number": "५", "content_sanskrit": "हृदयग्रहणीयानि राधेयं मधुसूदनः ।\nयान्यब्रवीदमेयात्मा तानि मे शृणु भारत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2148258, "chapter_id": 4208, "verse_number": "", "content_sanskrit": "श्रीवासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2148259, "chapter_id": 4208, "verse_number": "६", "content_sanskrit": "उपासितास्ते राधेय ब्राह्मणा वेदपारगाः ।\nतत्त्वार्थं परिपृष्टाश्च नियतेनानसूयता\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2148260, "chapter_id": 4208, "verse_number": "७", "content_sanskrit": "त्वमेव कर्ण जानासि वेदं वेदाङ्गसंहितम् ।\nत्वमेव धर्मशास्त्रेषु सूक्ष्मेषु परिनिष्ठितः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2148261, "chapter_id": 4208, "verse_number": "८", "content_sanskrit": "कानीनश्च सहोढश्च कन्यायां यश्च जायते ।\nवोढारं पितरं तस्य प्राहुः शास्त्रविदो जनाः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2148262, "chapter_id": 4208, "verse_number": "९", "content_sanskrit": "सोऽसि कर्ण तथा जातः पाण्डोः पुत्रोऽसि धर्मतः ।\nनिश्चयाद् धर्मशास्त्राणामेहि राजा भविष्यसि\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2148263, "chapter_id": 4208, "verse_number": "१०", "content_sanskrit": "पितृपक्षे च ते पार्था मातृपक्षे च वृष्णयः ।\nद्वौ पक्षावभिजानीहि त्वमेतौ पुरुषर्षभ\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2148264, "chapter_id": 4208, "verse_number": "११", "content_sanskrit": "मया सार्धमितो यातमद्य त्वां तात पाण्डवाः ।\nअभिजानन्तु कौन्तेयं पूर्वजातं युधिष्ठिरात्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2148265, "chapter_id": 4208, "verse_number": "१२", "content_sanskrit": "पादौ तव ग्रहीष्यन्ति भ्रातरः पञ्च पाण्डवाः ।\nद्रौपदेयास्तथा पञ्च सौभद्रश्चापराजितः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2148266, "chapter_id": 4208, "verse_number": "१३", "content_sanskrit": "राजानो राजपुत्राश्च पाण्डवार्थे समागताः ।\nपादौ तव ग्रहीष्यन्ति सर्वे चान्धकवृष्णयः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2148267, "chapter_id": 4208, "verse_number": "१४", "content_sanskrit": "हिरण्मयांश्च ते कुम्भान् राजतात् पार्थिवांस्तथा ।\nओषध्यः सर्वरत्नानि सर्वबीजानि वीरुधः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2148268, "chapter_id": 4208, "verse_number": "१५", "content_sanskrit": "राजानो राजकन्याश्च ह्यानयन्त्वभिषेचनम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2148269, "chapter_id": 4208, "verse_number": "१६", "content_sanskrit": "षष्ठे त्वां च तथा काले द्रौपद्युपगमिष्यति\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2148270, "chapter_id": 4208, "verse_number": "१७", "content_sanskrit": "अग्नीन् जुहोतु वै धौम्यः संशितात्मा द्विजोत्तमः ।\nपुरोहितः पाण्डवानां ब्रह्मकर्मण्यवस्थितः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2148271, "chapter_id": 4208, "verse_number": "१८", "content_sanskrit": "अद्य त्वामभिषिञ्चन्तु विद्वांसश्च द्विजातयः ।\nतथैव भ्रातरः पञ्च पाण्डवाः पुरुषर्षभाः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2148272, "chapter_id": 4208, "verse_number": "१९", "content_sanskrit": "द्रौपदेयास्तथा पञ्च पाञ्चालाश्चेदयस्तथा ।\nअहं चाप्यभिषेक्ष्यामि राजानं पृथिवीपतिम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2148273, "chapter_id": 4208, "verse_number": "२०", "content_sanskrit": "युवराजोऽस्तु ते राजा धर्मपुत्रो युधिष्ठिरः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2148274, "chapter_id": 4208, "verse_number": "२१", "content_sanskrit": "गृहीत्वा व्यजनं श्वेतं धर्मात्मा संशितव्रतः ।\nउपान्वारोहतु रथं कुन्तीपुत्रो युधिष्ठिरः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2148275, "chapter_id": 4208, "verse_number": "२२", "content_sanskrit": "छत्रं च ते महाश्वेतं भीमसेनो महाबलः ।\nअभिषिक्तस्य कौन्तेयो धारयिष्यति मूर्धनि\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2148276, "chapter_id": 4208, "verse_number": "२३", "content_sanskrit": "किङ्किणीशतनिर्घोषं वैयाघ्रपरिवारणम् ।\nरथं श्वेतहयैर्युक्तमर्जुनो वाहयिष्यति\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2148277, "chapter_id": 4208, "verse_number": "२४", "content_sanskrit": "अभिमन्युश्च ते नित्यं प्रत्यासन्नो भविष्यति\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2148278, "chapter_id": 4208, "verse_number": "२५", "content_sanskrit": "नकुलः सहदेवश्च द्रौपदेयाश्च पञ्च ये ।\nपाञ्चालाश्चानुयास्यन्ति शिखण्डी च महारथः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2148279, "chapter_id": 4208, "verse_number": "२६", "content_sanskrit": "अहं च त्वाऽनुयास्यामि सर्वे चान्धकवृष्णयः ।\nदाशार्हाः परिवारास्ते दाशार्णाश्च विशाम्पते\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2148280, "chapter_id": 4208, "verse_number": "२७", "content_sanskrit": "भुङ्क्ष्व राज्यं महाबाहो भ्रातृभिः सह पाण्डवैः ।\nजपैर्होमैश्च संयुक्तो मङ्गलैश्च पृथग्विधैः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2148281, "chapter_id": 4208, "verse_number": "२८", "content_sanskrit": "पुरोगमाश्च ते सन्तु द्रमिडाः सह कुन्तलैः ।\nआन्ध्रास्तालवराश्चैव चुञ्चुपा वेणुपास्तथा\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2148282, "chapter_id": 4208, "verse_number": "२९", "content_sanskrit": "स्तुवन्तु त्वां च बहुभिः स्तुतिभिः सूतमागधाः ।\nविजयं वसुषेणस्य घोषयन्तु च पाण्डवाः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2148283, "chapter_id": 4208, "verse_number": "३०", "content_sanskrit": "स त्वं परिवृतः पार्थैः नक्षत्रैरिव चन्द्रमाः ।\nप्रशाधि राज्यं कौन्तेय कुन्तीं च प्रतिनन्दय\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2148284, "chapter_id": 4208, "verse_number": "३१", "content_sanskrit": "मित्राणि ते प्रहृष्यन्तु व्यथन्तु रिपवस्तथा ।\nसौभ्रात्रं चैव तेऽद्यास्तु भ्रातृभिः सह पाण्डवैः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2148285, "chapter_id": 4208, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि एकोनचत्वारिंशोत्तरशततमोऽध्यायः ॥१३९॥\nविवादपर्वणि प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]