[{"id": 7004796000, "chapter_id": 24796, "verse_number": "६-२५८-१", "content_sanskrit": "गालव उवाच ।\nप्रवृत्तायां शैलपुत्र्यां महत्तपसि दारुणे ।\nकन्दर्पेण पराभूतो विचचार महीं हरः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004796001, "chapter_id": 24796, "verse_number": "६-२५८-२", "content_sanskrit": "वृक्षच्छायासु तीर्थेषु नदीषु च नदेषु च ।\nजलेन सिंचत्स्ववपुः सर्वत्रापि महेश्वरः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004796002, "chapter_id": 24796, "verse_number": "६-२५८-३", "content_sanskrit": "तथापि कामाकुलितो न लेभे शर्म कर्हिचित् ।\nएकदा यमुनां दृष्ट्वा जलकल्लोलमालिनीम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004796003, "chapter_id": 24796, "verse_number": "६-२५८-४", "content_sanskrit": "विगाहितुं मनश्चक्रे तापार्तिं शमयन्निव ।\nकृष्णं बभूव तन्नीरं हरकायाग्निवह्निना ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004796004, "chapter_id": 24796, "verse_number": "६-२५८-५", "content_sanskrit": "दग्धं विगाहनेनाशु मषीप्रायं तदा बभौ ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004796005, "chapter_id": 24796, "verse_number": "६-२५८-६", "content_sanskrit": "साऽपि दिव्यवपुः पूर्वं श्यामा भूत्वा हराद्यतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004796006, "chapter_id": 24796, "verse_number": "६-२५८-७", "content_sanskrit": "स्तुत्वा नत्वा महेशानमुवाच पुनरेव सा ।\nप्रसादं कुरु देवेश वशगास्मि सदा तव ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004796007, "chapter_id": 24796, "verse_number": "६-२५८-८", "content_sanskrit": "ईश्वर उवाच ।\nअस्मिंस्तीर्थवरेपुण्ये यः स्नास्यति नरो भुवि ।\nतस्य पापसहस्राणि यास्यंति विलयं ध्रुवम् १ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004796008, "chapter_id": 24796, "verse_number": "६-२५८-९", "content_sanskrit": "हरतीर्थमिति ख्यातं पुण्यं लोके भविष्यति ।\nइत्युक्त्वा तां प्रणम्याथ तत्रैवांतरधीयत ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004796009, "chapter_id": 24796, "verse_number": "६-२५८-१०", "content_sanskrit": "तस्यास्तीरे महेशोऽपि कृत्वा रूपं मनोहरम् ।\nकामालयं वाद्यहस्तं कृतपुंड्रं जटाधरम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004796010, "chapter_id": 24796, "verse_number": "६-२५८-११", "content_sanskrit": "स्वेच्छया मुनिगेहेषु दर्शयत्यंगचापलम् ।\nक्वचिद्गायति गीतानि क्वचिन्नृत्यति छन्दतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004796011, "chapter_id": 24796, "verse_number": "६-२५८-१२", "content_sanskrit": "स च क्रुद्ध्यति हसति स्त्रीणां मध्यगतः क्वचित् ।\nएवं विचरतस्तस्य ऋषिपत्न्यः समंततः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004796012, "chapter_id": 24796, "verse_number": "६-२५८-१३", "content_sanskrit": "पत्युः शुश्रूषणं गेहे त्यक्त्वा कार्याण्यपि क्षणात् ।\nतमेव मनसा चक्रुः पतिरूपेण मोहिताः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004796013, "chapter_id": 24796, "verse_number": "६-२५८-१४", "content_sanskrit": "भ्रमंत्यश्चैव हास्यानि चक्रुस्ता अपि योषितः ।\nततस्तु मुनयो दृष्ट्वा तासां दुःशीलभावनाम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004796014, "chapter_id": 24796, "verse_number": "६-२५८-१५", "content_sanskrit": "चुक्रुधुर्मुनयः सर्वे रूपं तस्य मनोहरम् ।\nगृह्यतां हन्यतामेष कोऽयं दुष्ट उपागतः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004796015, "chapter_id": 24796, "verse_number": "६-२५८-१६", "content_sanskrit": "इति ते गृह्य काष्ठानि यदोपस्थे ययुस्तदा ।\nपलायितः स बहुधा भयात्तेषां महात्मनाम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004796016, "chapter_id": 24796, "verse_number": "६-२५८-१७", "content_sanskrit": "यो जीवकलया विश्वं व्याप्य तिष्ठति देहिनाम् ।\nन ज्ञायते न च ग्राह्यो न भेद्यश्चापि जायते ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004796017, "chapter_id": 24796, "verse_number": "६-२५८-१८", "content_sanskrit": "न शेकुस्ते यदा सर्वे ग्रहीतुं तं महेश्वरम् ।\nतदा शिवं प्रकुपिता शेपुरित्थं द्विजातयः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004796018, "chapter_id": 24796, "verse_number": "६-२५८-१९", "content_sanskrit": "यस्माल्लिंगार्थमागत्य ह्याश्रमांश्चोरवत्कृतम् ।\nपरदारापहरणं तल्लिङ्गं पततां भुवि ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004796019, "chapter_id": 24796, "verse_number": "६-२५८-२०", "content_sanskrit": "सद्य एव हि शापं त्वं दुष्टं प्राप्नुहि तापस ।\nएवमुक्ते स शापाग्निर्वज्ररूपधरो महान् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004796020, "chapter_id": 24796, "verse_number": "६-२५८-२१", "content_sanskrit": "तल्लिगं धूर्जटेश्छित्त्वा पातयामास भूतले ।\nरुधिरौघपरिव्याप्तो मुमोह भगवान्विभुः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004796021, "chapter_id": 24796, "verse_number": "६-२५८-२२", "content_sanskrit": "वेदनार्त्तोज्ज्वलवपुर्महाशापाभिभूतधीः ।\nतं तथा पतितं दृष्ट्वा त आजग्मुर्महर्षयः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004796022, "chapter_id": 24796, "verse_number": "६-२५८-२३", "content_sanskrit": "आकाशे सर्वभूतानि त्रेसुर्विश्वं चचाल ह ।\nदेवाश्च व्याकुला जाता महाभयमुपागताः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004796023, "chapter_id": 24796, "verse_number": "६-२५८-२४", "content_sanskrit": "ज्ञात्वा विप्रा महेशानं पीडिता हृदयेऽभवन् ।\nशुशुचुर्भृशदुःखार्ता दैवं हि बलवत्तरम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004796024, "chapter_id": 24796, "verse_number": "६-२५८-२५", "content_sanskrit": "किं कृतं भगवानेष देवैरपि स सेव्यते ।\nसाक्षी सर्वस्य जगतोऽस्माभिर्नैवोपलक्षितः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004796025, "chapter_id": 24796, "verse_number": "६-२५८-२६", "content_sanskrit": "वयं मूढधियः पापाः परमज्ञानदुर्बलाः ।\nकथमस्माभिर्यस्यात्मा श्रुतश्च न निवेदितः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004796026, "chapter_id": 24796, "verse_number": "६-२५८-२७", "content_sanskrit": "मयेदृशो गृहस्थाय ह्यात्माऽयं न निवेदितः ।\nनिर्विकारो निर्विषयो निरीहो निरुपद्रवः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004796027, "chapter_id": 24796, "verse_number": "६-२५८-२८", "content_sanskrit": "निर्ममो निरहंकारो यः शंभुर्नोपलक्षितः ।\nयस्य लोका इमे सर्वे देहे तिष्ठंति मध्यगाः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004796028, "chapter_id": 24796, "verse_number": "६-२५८-२९", "content_sanskrit": "स एष जगतां स्वामी हरोऽस्माभिर्न वीक्षितः ।\nइत्युक्त्वा ते ह्युपविष्टा यावत्तत्र समागताः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004796029, "chapter_id": 24796, "verse_number": "६-२५८-३०", "content_sanskrit": "तान्दृष्ट्वा सहसा त्रस्तः पुनरेव महेश्वरः ।\nविप्रशापभयान्नष्टस्त्रिपुरारिर्दिवं ययौ ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004796030, "chapter_id": 24796, "verse_number": "६-२५८-३१", "content_sanskrit": "सुरभिं गां च गोलोके तां तुष्टाव सुसंयतः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004796031, "chapter_id": 24796, "verse_number": "६-२५८-३२", "content_sanskrit": "सृष्टिस्थिति विनाशानां कर्त्र्यै मात्रे नमोनमः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004796032, "chapter_id": 24796, "verse_number": "६-२५८-३३", "content_sanskrit": "या त्वं रसमयैर्भावैराप्यायसि भूतलम् ।\nदेवानां च तथासंघान्पितॄणामपि वै गणान् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004796033, "chapter_id": 24796, "verse_number": "६-२५८-३४", "content_sanskrit": "सर्वै र्ज्ञाता रसाभिज्ञैर्मधुरास्वाददायिनी ।\nत्वया विश्वमिदं सर्वं बलस्नेहसमन्वितम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004796034, "chapter_id": 24796, "verse_number": "६-२५८-३५", "content_sanskrit": "त्वं माता सर्वरुद्राणां वसूनां दुहिता तथा ।\nआदित्यानां स्वसा चैव तुष्टा वांच्छितसिद्धिदा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004796035, "chapter_id": 24796, "verse_number": "६-२५८-३६", "content_sanskrit": "त्वं धृतिस्त्वं तथा पुष्टिस्त्वं स्वाहा त्वं स्वधा तथा ।\nऋद्धिः सिद्धिस्तथा लक्ष्मीर्धृतिः कीर्ति स्तथा मतिः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004796036, "chapter_id": 24796, "verse_number": "६-२५८-३७", "content_sanskrit": "कांतिर्लज्जा महामाया श्रद्धा सर्वार्थसाधिनी ।\nत्वया विरहितं किंचिन्नास्ति त्रिभुवनेष्वपि ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004796037, "chapter_id": 24796, "verse_number": "६-२५८-३८", "content_sanskrit": "वह्नेस्तृप्तिप्रदात्री च देवादीनाम् च तृप्तिदा ।\nत्वया सर्वमिदं व्याप्तं जगत्स्थावरजंगमम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004796038, "chapter_id": 24796, "verse_number": "६-२५८-३९", "content_sanskrit": "पादास्ते वेदाश्चत्वारः समुद्राः स्तनतां ययुः ।\nचंद्रार्कौ लोचने यस्या रोमाग्रेषु च देवताः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004796039, "chapter_id": 24796, "verse_number": "६-२५८-४०", "content_sanskrit": "शृङ्गयोः पर्वताः सर्वे कर्णयोर्वायवस्तथा ।\nनाभौ चैवामृतं देवि पातालानि खुरास्तथा ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004796040, "chapter_id": 24796, "verse_number": "६-२५८-४१", "content_sanskrit": "स्कन्धे च भगवान्ब्रह्मा मस्तकस्थः सदाशिवः ।\nहृद्देशे च स्थितो विष्णुः पुच्छाग्रे पन्नगास्तथा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004796041, "chapter_id": 24796, "verse_number": "६-२५८-४२", "content_sanskrit": "शकृत्स्था वसवः सर्वे साध्या मूत्रस्थितास्तव ।\nसर्वे यज्ञा ह्यस्थिदेशे किन्नरा गुह्यसंस्थिताः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004796042, "chapter_id": 24796, "verse_number": "६-२५८-४३", "content_sanskrit": "पितॄणां च गणाः सर्वे पुरःस्था भांति सर्वदा ।\nसर्वे यक्षा भालदेशे किन्नराश्च कपोलयोः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004796043, "chapter_id": 24796, "verse_number": "६-२५८-४४", "content_sanskrit": "सर्वदेवमयी त्वं हि सर्वभूतविवृद्धिदा ।\nसर्वलोकहिता नित्यं मम देहहिता भव ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004796044, "chapter_id": 24796, "verse_number": "६-२५८-४५", "content_sanskrit": "प्रणतस्तव देवेशि पूजये त्वां सदाऽनघे ।\nस्तौमि विश्वार्तिहन्त्रीं त्वां प्रसन्ना वरदा भव ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004796045, "chapter_id": 24796, "verse_number": "६-२५८-४६", "content_sanskrit": "विप्रशापाग्निना दग्धं शरीरं मम शोभने ।\nस्वतेजसा पुनः कर्त्तुमर्हस्यमृतसंभवे ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004796046, "chapter_id": 24796, "verse_number": "६-२५८-४७", "content_sanskrit": "इत्युक्त्वा ता परिक्रम्य तस्या देहे लयं गतः ।\nसाऽपि गर्भे दधाराथ सुरभिस्तदनन्तरम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004796047, "chapter_id": 24796, "verse_number": "६-२५८-४८", "content_sanskrit": "कालातिक्रमयोगेन सर्वव्याकुलतां ययौ ।\nयस्मिन्प्रनष्टे देवेशे विप्रशापभयावृते ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004796048, "chapter_id": 24796, "verse_number": "६-२५८-४९", "content_sanskrit": "देवा महार्तिं प्रययुश्चचाल पृथिवी तथा ।\nचंद्रार्कौ निष्प्रभौ चैव वायुरुच्चण्ड एव च ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004796049, "chapter_id": 24796, "verse_number": "६-२५८-५०", "content_sanskrit": "समुद्राः क्षोभमग मंस्तस्मिन्काले द्विजोत्तम ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004796050, "chapter_id": 24796, "verse_number": "६-२५८-५१", "content_sanskrit": "यस्मिञ्जगत्स्थावरजंगमादिकं काले लयं प्राप्य पुनः प्ररोहति ।\nतस्मिन्प्रनष्टे द्विजशापपीडिते जयद्धतप्राय मवर्तत क्षणात् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004796051, "chapter_id": 24796, "verse_number": "६-२५८-५२", "content_sanskrit": "इति श्रीस्कान्दे महापुराण एकाशीतिसाहस्र्यां संहितायां षष्ठे नागरखण्डे हाटकेश्वरक्षेत्रमाहात्म्ये शेषशाय्युपाख्याने ब्रह्मनारदसंवादे चातुर्मास्यमाहात्म्ये हरशापो नामाष्टपंचाशदुत्तरद्विशततमोऽध्यायः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]