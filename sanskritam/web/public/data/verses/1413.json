[{"id": 2019847, "chapter_id": 1413, "verse_number": "३-५१-०x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2019848, "chapter_id": 1413, "verse_number": "३-५१-१", "content_sanskrit": "दमयन्ती तु तच्छ्रुत्वा वचो हंसस्य भारत।\nतदा प्रभृति न स्वस्था नलं प्रति बभूव सा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2019849, "chapter_id": 1413, "verse_number": "३-५१-२", "content_sanskrit": "ततश्चिन्तापरा दीना विवर्णवदना कृशा।\nबभूवदमयन्ती तु निःश्वासपरमा तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2019850, "chapter_id": 1413, "verse_number": "३-५१-३", "content_sanskrit": "ऊर्ध्वदृष्टिर्ध्यानपरा बभूवोन्मत्तदर्शना।\nपाण्डुवर्णा क्षणेनाथ हृच्छयाविष्टचेतना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2019851, "chapter_id": 1413, "verse_number": "३-५१-४", "content_sanskrit": "न शय्यासनभोगेषु रतिं विन्दति कर्हिचित्।\nन नक्तं न दिवा शेते हाहेति रुदती मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2019852, "chapter_id": 1413, "verse_number": "३-५१-५", "content_sanskrit": "तामस्वस्थां तदाकारां सख्यस्ता जज्ञिरिङ्गितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2019853, "chapter_id": 1413, "verse_number": "३-५१-६", "content_sanskrit": "ततो विदर्भपतये दमयन्त्याः सखीजनः।\nन्यवेदयत्तामस्वस्थां दमयन्तीं नरेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2019854, "chapter_id": 1413, "verse_number": "३-५१-७", "content_sanskrit": "तच्छ्रुत्वा नृपतिर्भीमो दमयन्तीसखीगणात्।\nकिमर्थं दुहिता मेऽद्यनातिस्वस्थेव लक्ष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2019855, "chapter_id": 1413, "verse_number": "३-५१-८", "content_sanskrit": "स समीक्ष्य महीपालः स्वां सुतां प्राप्तयौवनाम्।\nअपश्यदात्मना कार्यं दमयन्त्याः स्वयंवरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2019856, "chapter_id": 1413, "verse_number": "३-५१-९", "content_sanskrit": "स सन्निपातयामास महीपालान्विशांपतिः।\nएषोऽनुभूयतां चीराः स्वयंवर इति प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2019857, "chapter_id": 1413, "verse_number": "३-५१-१०", "content_sanskrit": "श्रुत्वा तु पार्थिवाः सर्वे दमयन्त्याः स्वयंवरम्।\nअभिजग्मुस्ततो वीरा राजानो भीमशासनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2019858, "chapter_id": 1413, "verse_number": "३-५१-११", "content_sanskrit": "हस्त्यश्वरथघोषेण नादयन्तो वसुंधराम्।\nविचित्रमाल्याभरणैर्बलैर्दृश्यैः स्वलंकृतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2019859, "chapter_id": 1413, "verse_number": "३-५१-१२", "content_sanskrit": "तेषां भीमो महाबाहुः पार्थिवानां महात्मनाम्।\nयथार्हमकरोत्पूजां तेऽवसंस्तत्र पूजिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2019860, "chapter_id": 1413, "verse_number": "३-५१-१३", "content_sanskrit": "एतस्मिन्नेव काले तु सुराणामृषिसत्तमौ।\nअटमानौ महात्मानाविन्द्रलोकमितो गतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2019861, "chapter_id": 1413, "verse_number": "३-५१-१४", "content_sanskrit": "नारदः पर्वतश्चैव महाप्राज्ञौ महाव्रतौ।\nदेवराजस् भवनं विविशाते सुपूजितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2019862, "chapter_id": 1413, "verse_number": "३-५१-१५", "content_sanskrit": "तावर्चयित्वा मघवा ततः कुशलमव्ययम्।\nपप्रच्छानामयं चापि तयोः सर्वगतं विभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2019863, "chapter_id": 1413, "verse_number": "३-५१-१६x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2019864, "chapter_id": 1413, "verse_number": "३-५१-१६", "content_sanskrit": "आवयोः कशलं देव सर्वत्रगतमीश्वर।\nलोके च मघवन्कृत्स्ने नृपाः कुशलिनो विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2019865, "chapter_id": 1413, "verse_number": "३-५१-१७x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2019866, "chapter_id": 1413, "verse_number": "३-५१-१७", "content_sanskrit": "नारदस्य वचः श्रुत्वा पप्रच्छ बलवृत्रहा।\nधर्मज्ञाः पृथिवीपालास्त्यक्तजीवितयोधिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2019867, "chapter_id": 1413, "verse_number": "३-५१-१८", "content_sanskrit": "शस्त्रेण निधनं काले ये गच्छन्त्यपराड्युखाः।\nअयं लोकोऽक्षयस्तेषां यथैव मम कामधुक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2019868, "chapter_id": 1413, "verse_number": "३-५१-१९", "content_sanskrit": "क्वनु ते क्षत्रियाः शूरा नहि पश्यामि तानहम्।\nआगच्छतो महीपालान्दयितामनिथीन्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2019869, "chapter_id": 1413, "verse_number": "३-५१-२०", "content_sanskrit": "एवमुक्तस्तु शक्रेण नारदः प्रत्यभाषत।\nशृणु मे मघवन्येन न दृश्यन्ते महीक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2019870, "chapter_id": 1413, "verse_number": "३-५१-२१", "content_sanskrit": "विदर्भराज्ञो दुहिता दमयन्तीति विश्रुता।\nरूपेण समतिक्रान्ता पृथिव्यां सर्वयोषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2019871, "chapter_id": 1413, "verse_number": "३-५१-२२", "content_sanskrit": "तस्याः स्वयंवरः शक्र भविता नचिरादिव।\nतत्र गच्छन्ति राजानो राजपुत्राश्च सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2019872, "chapter_id": 1413, "verse_number": "३-५१-२३", "content_sanskrit": "तां रत्नभूतां लोकस्य प्रार्थयन्तो महीक्षितः।\nकाङ्क्षन्ति स्म विशेषेण बलवृत्रनिषूदन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2019873, "chapter_id": 1413, "verse_number": "३-५१-२४", "content_sanskrit": "एतस्मिन्कथ्यमाने तु लोकपालाश्च साग्निकाः।\nआजग्मुर्देवराजस्य समीपममरोत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2019874, "chapter_id": 1413, "verse_number": "३-५१-२५", "content_sanskrit": "ततस्ते शुश्रुवुः सर्वे नारदस्य वचो महत्।\nश्रुत्वैव चाब्रुवन्हृष्टा गच्छामो वयमप्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2019875, "chapter_id": 1413, "verse_number": "३-५१-२६", "content_sanskrit": "ततः सर्वे महाराज सगणाः सहवाहनाः।\nविदर्भानभिजग्मुस्ते यतः सर्वे महीक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2019876, "chapter_id": 1413, "verse_number": "३-५१-२७", "content_sanskrit": "नलोपि राजा कौन्तेय श्रुत्वा राज्ञां समागमम्।\nअभ्यगच्छददीनात्मा दमयन्तीमनुव्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2019877, "chapter_id": 1413, "verse_number": "३-५१-२८", "content_sanskrit": "अथ देवाः पथि नलं ददृशुर्भूतले स्तितम्।\nसाक्षादिव स्थितं मूर्त्या मन्मथं रूपसंपदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2019878, "chapter_id": 1413, "verse_number": "३-५१-२९", "content_sanskrit": "तं दृष्ट्वा लोकपालास्ते भ्राजमानं यथा रविम्।\nतस्थुर्विगतसंकल्पा विस्मिता रूपसंपदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2019879, "chapter_id": 1413, "verse_number": "३-५१-३०", "content_sanskrit": "ततोऽन्तरिक्षे विष्टभ्य विमानानि दिवौकसः।\nअब्रुवन्नैषधं राजन्नवतीर्य नभस्तलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2019880, "chapter_id": 1413, "verse_number": "३-५१-३१", "content_sanskrit": "भोभो निषधराजेन्द्र नल सत्यव्रतो भवात्।\nअस्माकं कुरु साहाय्यं दूतो भव नरोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2019881, "chapter_id": 1413, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि नलोपाख्यानपर्वणि एकपञ्चाशोऽध्यायः ॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]