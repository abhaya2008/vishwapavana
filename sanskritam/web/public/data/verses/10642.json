[{"id": 50002601, "chapter_id": 10642, "verse_number": "1", "content_sanskrit": "भोक्तारं यज्ञतपसां सर्वलोकमहेश्वरम्। सुहृदं सर्वभूतानां ज्ञात्वा मां शान्तिमृच्छति॥ ५/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50002602, "chapter_id": 10642, "verse_number": "2", "content_sanskrit": "॥ ओन्तत्सत्॥ इति श्रीमद्भगवद्गीतासूपनिषत्सु ब्रह्मविद्यायां योगशास्त्रे श्रीकृष्णार्जुनसंवादे कर्मसन्न्यासयोगो नाम पञ्चमोऽध्यायः॥ २९ श्लोकाः॥ आदितः २३३ श्लोकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50002603, "chapter_id": 10642, "verse_number": "3", "content_sanskrit": "॥ ध्यानयोगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50002604, "chapter_id": 10642, "verse_number": "4", "content_sanskrit": "श्रीभगवानुवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50002605, "chapter_id": 10642, "verse_number": "5", "content_sanskrit": "अनाश्रितः कर्मफलं कार्यं कर्म करोति यः। स सन्न्यासी च योगी च न निरग्निर्नचाक्रियः॥ ६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50002606, "chapter_id": 10642, "verse_number": "6", "content_sanskrit": "यं सन्न्यासमिति प्राहुर्योगं तं विद्धि पाण्डव। नह्यसन्न्यस्तसङ्कल्पो योगी भवति कश्चन॥ ६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50002607, "chapter_id": 10642, "verse_number": "7", "content_sanskrit": "आरुरुक्षोर्मुनेर्योगं कर्म कारणमुच्यते। योगारूढस्य तस्यैव शमः कारणमुच्यते॥ ६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50002608, "chapter_id": 10642, "verse_number": "8", "content_sanskrit": "यदा हि नेन्द्रियार्थेषु न कर्मस्वनुषज्जते। सर्वसङ्कल्पसन्न्यासी योगारूढस्तदोच्यते॥ ६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50002609, "chapter_id": 10642, "verse_number": "9", "content_sanskrit": "उद्धरेदात्मनाऽऽत्मानं नात्मानमवसादयेत्। आत्मैव ह्यात्मनो बन्धुरात्मैव रिपुरात्मनः॥ ६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50002610, "chapter_id": 10642, "verse_number": "10", "content_sanskrit": "बन्धुरात्माऽऽत्मनस्तस्य येनात्मैवात्मना जितः। अनात्मनस्तु शत्रुत्वे वर्तेतात्मैव शत्रुवत्॥ ६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50002611, "chapter_id": 10642, "verse_number": "11", "content_sanskrit": "जितात्मनः प्रशान्तस्य परमात्मा समाहितः। शीतोष्णसुखदुःखेषु तथा मानापमानयोः॥ ६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50002612, "chapter_id": 10642, "verse_number": "12", "content_sanskrit": "ज्ञानविज्ञानतृप्तात्मा कूटस्थो विजितेन्द्रियः। युक्त इत्युच्यते योगी समलोष्टाश्मकाञ्चनः॥ ६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50002613, "chapter_id": 10642, "verse_number": "13", "content_sanskrit": "सुहृन्मित्रार्युदासीनमध्यस्थद्वेष्यबन्धुषु। साधुष्वपि च पापेषु समबुद्धिर्विशिष्यते॥ ६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50002614, "chapter_id": 10642, "verse_number": "14", "content_sanskrit": "योगी युञ्जीत सततमात्मानं रहसि स्थितः। एकाकी यतचित्तात्मा निराशीरपरिग्रहः॥ ६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50002615, "chapter_id": 10642, "verse_number": "15", "content_sanskrit": "शुचौ देशे प्रतिष्ठाप्य स्थिरमासनमात्मनः। नात्युच्छ्रितं नातिनीचं चैलाजिनकुशोत्तरम्॥ ६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50002616, "chapter_id": 10642, "verse_number": "16", "content_sanskrit": "तत्रैकाग्रं मनः कृत्वा यतचित्तेन्द्रियक्रियः। उपविश्यासने युञ्ज्याद् योगमात्मविशुद्धये॥ ६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50002617, "chapter_id": 10642, "verse_number": "17", "content_sanskrit": "समं कायशिरोग्रीवं धारयन्नचलं स्थिरः। सम्प्रेक्ष्य नासिकाग्रं स्वं दिशश्चानवलोकयन्॥ ६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50002618, "chapter_id": 10642, "verse_number": "18", "content_sanskrit": "प्रशान्तात्मा विगतभीर्ब्रह्मचारिव्रते स्थितः। मनः संयम्य मच्चित्तो युक्त आसीत मत्परः॥ ६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50002619, "chapter_id": 10642, "verse_number": "19", "content_sanskrit": "युञ्जन्नेवं सदाऽऽत्मानं योगी नियतमानसः। शान्तिं निर्वाणपरमां मत्संस्थामधिगच्छति॥ ६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50002620, "chapter_id": 10642, "verse_number": "20", "content_sanskrit": "नात्यश्नतस्तु योगोऽस्ति नचैकान्तमनश्नतः। नचातिस्वप्नशीलस्य जाग्रतो नैव चार्जुन॥ ६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50002621, "chapter_id": 10642, "verse_number": "21", "content_sanskrit": "युक्ताहारविहारस्य युक्तचेष्टस्य कर्मसु। युक्तस्वप्नावबोधस्य योगो भवति दुःखहा॥ ६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50002622, "chapter_id": 10642, "verse_number": "22", "content_sanskrit": "॥ योगसम्पूर्तिस्वरूपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50002623, "chapter_id": 10642, "verse_number": "23", "content_sanskrit": "यदा विनियतं चित्तमात्मन्येवावतिष्ठते। निःस्पृहः सर्वकामेभ्यो युक्त इत्युच्यते तदा॥ ६/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50002624, "chapter_id": 10642, "verse_number": "24", "content_sanskrit": "यथा दीपो निवातस्थो नेङ्गते सोपमा स्मृता। योगिनो यतचित्तस्य युञ्जतो योगमात्मनः॥ ६/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50002625, "chapter_id": 10642, "verse_number": "25", "content_sanskrit": "यत्रोपरमते चित्तं निरुद्धं योगसेवया। यत्र चैवात्मनाऽऽत्मानं पश्यन्नात्मनि तुष्यति॥ ६/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50002626, "chapter_id": 10642, "verse_number": "26", "content_sanskrit": "सुखमात्यन्तिकं यत् तद् बुद्धिग्राह्यमतीन्द्रियम्। वेत्ति यत्र नचैवायं स्थितश्चलति तत्त्वतः॥ ६/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50002627, "chapter_id": 10642, "verse_number": "27", "content_sanskrit": "यं लब्ध्वा चापरं लाभं मन्यते नाधिकं ततः। यस्मिन् स्थितो न दुःखेन गुरुणाऽपि विचाल्यते॥ ६/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50002628, "chapter_id": 10642, "verse_number": "28", "content_sanskrit": "तं विद्याद् दुःखसंयोगवियोगं योगसञ्ज्ञितम्। स निश्चयेन योक्तव्यो योगो(ऽ)निर्विण्णचेतसा॥ ६/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50002629, "chapter_id": 10642, "verse_number": "29", "content_sanskrit": "सङ्कल्पप्रभवान् कामांस्त्यक्त्वा सर्वानशेषतः। मनसैवेन्द्रियग्रामं विनियम्य समन्ततः॥ ६/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50002630, "chapter_id": 10642, "verse_number": "30", "content_sanskrit": "शनैःशनैरुपरमेद् बुद्ध्या धृतिगृहीतया। आत्मसंस्थं मनः कृत्वा न किञ्चिदपि चिन्तयेत्॥ ६/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50002631, "chapter_id": 10642, "verse_number": "31", "content_sanskrit": "यतोयतो निश्चरति मनश्चञ्चलमस्थिरम्। ततस्ततो नियम्यैतदात्मन्येव वशं नयेत्॥ ६/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50002632, "chapter_id": 10642, "verse_number": "32", "content_sanskrit": "प्रशान्तमनसं ह्येनं योगिनं सुखमुत्तमम्। उपैति शान्तरजसं ब्रह्मभूतमकल्मषम्॥ ६/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50002633, "chapter_id": 10642, "verse_number": "33", "content_sanskrit": "एवं युञ्जन् सदाऽऽत्मानं योगी विगतकल्मषः। सुखेन ब्रह्मसंस्पर्शमत्यन्तं सुखमश्नुते॥ ६/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50002634, "chapter_id": 10642, "verse_number": "34", "content_sanskrit": "सर्वभूतस्थमात्मानं सर्वभूतानि चात्मनि। ईक्षते योगयुक्तात्मा सर्वत्र समदर्शनः॥ ६/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50002635, "chapter_id": 10642, "verse_number": "35", "content_sanskrit": "यो मां पश्यति सर्वत्र सर्वं च मयि पश्यति। तस्याहं न प्रणश्यामि स च मे न प्रणश्यति॥ ६/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50002636, "chapter_id": 10642, "verse_number": "36", "content_sanskrit": "सर्वभूतस्थितं यो मां भजत्येकत्वमास्थितः। सर्वथा वर्तमानोऽपि स योगी मयि वर्तते॥ ६/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50002637, "chapter_id": 10642, "verse_number": "37", "content_sanskrit": "आत्मौपम्येन सर्वत्र समं पश्यति योऽर्जुन। सुखं वा यदि वा दुःखं स योगी परमो मतः॥ ६/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50002638, "chapter_id": 10642, "verse_number": "38", "content_sanskrit": "अर्जुन उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50002639, "chapter_id": 10642, "verse_number": "39", "content_sanskrit": "योऽयं योगस्त्वया प्रोक्तः साम्येन मधुसूदन। एतस्याहं न पश्यामि चञ्चलत्वात् स्थितिं स्थिराम्॥ ६/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50002640, "chapter_id": 10642, "verse_number": "40", "content_sanskrit": "चञ्चलं हि मनः कृष्ण प्रमाथि बलवद् दृढम्। तस्याहं निग्रहं मन्ये वायोरिव सुदुष्करम्॥ ६/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50002641, "chapter_id": 10642, "verse_number": "41", "content_sanskrit": "श्रीभगवानुवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50002642, "chapter_id": 10642, "verse_number": "42", "content_sanskrit": "असंशयं महाबाहो मनो दुर्निग्रहं चलम्। अभ्यासेन तु कौन्तेय वैराग्येण च गृह्यते॥ ६/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50002643, "chapter_id": 10642, "verse_number": "43", "content_sanskrit": "असंयतात्मना योगो दुष्प्राप इति मे मतिः। वश्यात्मना तु यतता शक्योऽवाप्तुमुपायतः॥ ६/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50002644, "chapter_id": 10642, "verse_number": "44", "content_sanskrit": "अर्जुन उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50002645, "chapter_id": 10642, "verse_number": "45", "content_sanskrit": "अयतिः श्रद्धयोपेतो योगाच्चलितमानसः। अप्राप्य योगसंसिद्धिं कां गतिं कृष्ण गच्छति॥ ६/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 50002646, "chapter_id": 10642, "verse_number": "46", "content_sanskrit": "कच्चिन्नोभयविभ्रष्टश्छिन्नाभ्रमिव नश्यति। अप्रतिष्ठो महाबाहो विमूढो ब्रह्मणः पथि॥ ६/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 50002647, "chapter_id": 10642, "verse_number": "47", "content_sanskrit": "एतन्मे संशयं कृष्ण छेत्तुमर्हस्यशेषतः। त्वदन्यः संशयस्यास्य छेत्ता नह्युपपद्यते॥ ६/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 50002648, "chapter_id": 10642, "verse_number": "48", "content_sanskrit": "श्रीभगवानुवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 50002649, "chapter_id": 10642, "verse_number": "49", "content_sanskrit": "पार्थ नैवेह नामुत्र विनाशस्तस्य विद्यते। नहि कल्याणकृत् कश्चिद् दुर्गतिं तात गच्छति॥ ६/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 50002650, "chapter_id": 10642, "verse_number": "50", "content_sanskrit": "प्राप्य पुण्यकृतां लोकानुषित्वा शाश्वतीः समाः। शुचीनां श्रीमतां गेहे योगभ्रष्टोऽभिजायते॥ ६/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 50002651, "chapter_id": 10642, "verse_number": "51", "content_sanskrit": "अथवा योगिनामेव कुले भवति धीमताम्। एतद्धि दुर्लभतरं लोके जन्म यदीदृशम्॥ ६/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 50002652, "chapter_id": 10642, "verse_number": "52", "content_sanskrit": "तत्र तं बुद्धिसंयोगं लभते पौर्वदेहिकम्। यतते च ततो भूयः संसिद्धौ कुरुनन्दन॥ ६/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 50002653, "chapter_id": 10642, "verse_number": "53", "content_sanskrit": "पूर्वाभ्यासेन तेनैव ह्रियते ह्यवशोऽपि सः। जिज्ञासुरपि योगस्य शब्दब्रह्मातिवर्तते॥ ६/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 50002654, "chapter_id": 10642, "verse_number": "54", "content_sanskrit": "प्रयत्नाद् यतमानस्तु योगी संशुद्धकिल्बिषः। अनेकजन्मसंसिद्धस्ततो याति परां गतिम्॥ ६/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 50002655, "chapter_id": 10642, "verse_number": "55", "content_sanskrit": "तपस्विभ्योऽधिको योगी ज्ञानिभ्योऽपि मतोऽधिकः। कर्मिभ्यश्चाधिको योगी तस्माद् योगी भवार्जुन॥ ६/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 50002656, "chapter_id": 10642, "verse_number": "56", "content_sanskrit": "योगिनामपि सर्वेषां मद्गतेनान्तरात्मना। श्रद्धावान् भजते यो मां स मे युक्ततमो मतः॥ ६/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 50002657, "chapter_id": 10642, "verse_number": "57", "content_sanskrit": "॥ ओन्तत्सत्॥ इति श्रीमद्भगवद्गीतासूपनिषत्सु ब्रह्मविद्यायां योगशास्त्रे श्रीकृष्णार्जुनसंवादे ध्यानयोगो नाम षष्ठोऽध्यायः॥ ४७ श्लोकाः॥ आदितः २८० श्लोकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 50002658, "chapter_id": 10642, "verse_number": "58", "content_sanskrit": "॥ ज्ञानविज्ञानयोगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 50002659, "chapter_id": 10642, "verse_number": "59", "content_sanskrit": "॥ उपोद्घातः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]