[{"id": 2133395, "chapter_id": 3876, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2133396, "chapter_id": 3876, "verse_number": "१", "content_sanskrit": "एवमुक्तस्तु विप्रेण धर्मव्याधो युधिष्ठिर ।\nप्रत्युवाच यथा विप्रं तच्छृणुष्व नराधिप\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2133397, "chapter_id": 3876, "verse_number": "", "content_sanskrit": "व्याधः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2133398, "chapter_id": 3876, "verse_number": "२", "content_sanskrit": "विज्ञानार्थं मनुष्याणां मतिः पूर्वं प्रवर्तते।\nतां प्राप्य कामं भजते रोषं(क्रोधं) च द्विजसत्तम\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2133399, "chapter_id": 3876, "verse_number": "३", "content_sanskrit": "ततस्तदर्थं यतते कर्म चारभते महत् ।\nइष्टानां रूपगन्धानामभ्यासं च निषेवते \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2133400, "chapter_id": 3876, "verse_number": "४", "content_sanskrit": "ततो रागः प्रभवति द्वेषश्च तदनन्तरम् ।\nततो लोभः प्रभवति मोहश्च तदनन्तरम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2133401, "chapter_id": 3876, "verse_number": "५", "content_sanskrit": "ततो लोभाभिभूतस्य रागद्वेषहतस्य च ।\nन धर्मे जायते बुद्धिर्व्याजाद् धर्मं करोति च ।\nव्याजेन चरते धर्ममर्थं व्याजेन रोचते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2133402, "chapter_id": 3876, "verse_number": "६", "content_sanskrit": "व्याजेन सिध्यमानेषु धनेषु द्विजसत्तम ।\nतत्रैव रमते बुद्धिस्ततः पापं चिकीर्षति\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2133403, "chapter_id": 3876, "verse_number": "७", "content_sanskrit": "सुहृद्भिर्वार्यमाणश्च पण्डितैश्च द्विजोत्तम ।\nउत्तमश्रुतसम्बन्धो ब्रवीति श्रुतयो जितम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2133404, "chapter_id": 3876, "verse_number": "८", "content_sanskrit": "अधर्मस्त्रिविधस्तस्य वर्तते रागदोषजः ।\nपापं चिन्तयते चापि ब्रवीति च करोति च \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2133405, "chapter_id": 3876, "verse_number": "९", "content_sanskrit": "तस्याधर्मप्रवृत्तस्य गुणा नश्यन्ति साधवः ।\nएकशीलैश्च मित्रत्वं भजन्ते पापकर्मिणः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2133406, "chapter_id": 3876, "verse_number": "१०", "content_sanskrit": "स तेन दुःखमाप्नोति परत्र च विपद्यते ।\nपापात्मा भवति ह्येवं धर्मलाभं तु मे शृणु\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2133407, "chapter_id": 3876, "verse_number": "११", "content_sanskrit": "यस्त्वेतान् प्रज्ञया दोषान् पूर्वमेवानुपश्यति ।\nकुशलः सुखदुःखेषु साधूंश्चाप्युपसेवते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2133408, "chapter_id": 3876, "verse_number": "१२", "content_sanskrit": "तस्य साधुसमारम्भाद् बुद्धिर्धर्मेषु राजते \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2133409, "chapter_id": 3876, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2133410, "chapter_id": 3876, "verse_number": "१३", "content_sanskrit": "ब्रवीषि सूनृतं धर्म्यं यस्य वक्ता न विद्यते ।\nदिव्यप्रभावः सुमहानृषिरेव मतोऽसि मे\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2133411, "chapter_id": 3876, "verse_number": "", "content_sanskrit": "व्याधः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2133412, "chapter_id": 3876, "verse_number": "१४", "content_sanskrit": "ब्राह्मणा वै महाभागाः पितरोऽग्रभुजः सदा ।\nतेषां सर्वात्मना कार्यं प्रियं लोके मनीषिणा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2133413, "chapter_id": 3876, "verse_number": "१५", "content_sanskrit": "यत् तेषां च प्रियं तत् ते वक्ष्यामि द्विजसत्तम ।\nनमस्कृत्वा ब्राह्मणेभ्यो ब्राह्मीं विद्यां निबोध मे\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2133414, "chapter_id": 3876, "verse_number": "१६", "content_sanskrit": "इदं विश्वं जगत् सर्वमजय्यं चापि सर्वशः ।\nमहाभूतात्मकं ब्रह्म नातः परतरं भवेत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2133415, "chapter_id": 3876, "verse_number": "१७", "content_sanskrit": "महाभूतानि खं वायुरग्निरापस्तथा च भूः ।\nशब्दः स्पर्शश्च रूपं च रसो गन्धश्च तद्गुणाः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2133416, "chapter_id": 3876, "verse_number": "१८", "content_sanskrit": "तेषामपि गुणाः सर्वे गुणवृत्तिः परस्परम् ।\nपूर्वपूर्वगुणाः सर्वे क्रमशो गुणिषु त्रिषु\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2133417, "chapter_id": 3876, "verse_number": "१९", "content_sanskrit": "षष्ठस्तु चेतना नाम मन इत्यभिधीयते ।\nसप्तमी तु भवेद् बुद्धिरहङ्कारस्ततः परम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2133418, "chapter_id": 3876, "verse_number": "२०", "content_sanskrit": "इन्द्रियाणि च पञ्चात्मा रजः सत्त्वं तमस्तथा ।\nइत्येष सप्तदशको राशिरव्यक्तसञ्ज्ञितः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2133419, "chapter_id": 3876, "verse_number": "२१", "content_sanskrit": "सर्वैरिहेन्द्रियार्थैस्तु व्यक्ताव्यक्तैः सुसंवृतैः ।\nचतुर्विंशक इत्येष व्यक्ताव्यक्तमयो गणः ।\nएतत्ते सर्वमाख्यातं किं भूयः श्रोतुमिच्छसि\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2133420, "chapter_id": 3876, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि मार्कण्डेयसमास्यापर्वणि ब्राह्मणमाहात्म्ये सप्तनवत्यधिकशततमोऽध्यायः ॥१९७॥\n॥ मार्कण्डेयसमास्यापर्वणि द्वात्रिंशोऽध्यायः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]