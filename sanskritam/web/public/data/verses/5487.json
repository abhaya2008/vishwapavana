[{"id": 2209830, "chapter_id": 5487, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2209831, "chapter_id": 5487, "verse_number": "१", "content_sanskrit": "तथा विलप्योपरता भर्तुः पादौ प्रगृह्य सा ।\nउपविष्टाऽभवद् देवी सोच्छ्वासं पुत्रमीक्षती ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2209832, "chapter_id": 5487, "verse_number": "२", "content_sanskrit": "ततः सञ्ज्ञां पुनर्लब्ध्वा स राजा बभ्रुवाहनः ।\nमातरं तामथालोक्य रणभूमावथाब्रवीत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2209833, "chapter_id": 5487, "verse_number": "", "content_sanskrit": "बभ्रुवाहनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2209834, "chapter_id": 5487, "verse_number": "३", "content_sanskrit": "इतो दुःखतरं किं नु यन्मे माता सुखैधिता ।\nभूमौ निपतितं वीरमनुशेते पतिव्रता ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2209835, "chapter_id": 5487, "verse_number": "४", "content_sanskrit": "निहन्तारं रणेऽरीणां सर्वशस्त्रभृतां वरम् ।\nमया विनिहतं सङ्खे प्रेक्षते दुर्मरं पतिम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2209836, "chapter_id": 5487, "verse_number": "५", "content_sanskrit": "अहोऽस्या हृदयं देव्या दृढं यन्न विदीर्यते ।\nव्यूढोरस्कं महाबाहुं प्रेक्षन्त्याः पतितं पतिम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2209837, "chapter_id": 5487, "verse_number": "६", "content_sanskrit": "दुर्मरं पुरुषेणेह मन्ये काले ह्यनागते ।\nयत्र नाहं न मे माता विप्रयुक्तौ स्वजीवितात् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2209838, "chapter_id": 5487, "verse_number": "७", "content_sanskrit": "अहो धिक् कुरुवीरस्य किरीटं काञ्चनं भुवि ।\nअपविद्धं हतस्येह मया पुत्रेण पश्यता ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2209839, "chapter_id": 5487, "verse_number": "८", "content_sanskrit": "भो भो पश्यत मे वीरं पितरं ब्राह्मणा भुवि ।\nशयानं वीरशयने मया पुत्रेण पातितम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2209840, "chapter_id": 5487, "verse_number": "९", "content_sanskrit": "ब्राह्मणाः कुरुमुख्यस्य प्रयुक्ता हयसारिणः ।\nकुर्वन्तु शान्तिकं त्वद्य रणे योऽयं मया हतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2209841, "chapter_id": 5487, "verse_number": "१०", "content_sanskrit": "आदिशन्तु च किं विप्राः प्रायश्चित्तमिहाद्य मे ।\nसुनृशंसस्य पापस्य पितृहन्तू रणाजिरे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2209842, "chapter_id": 5487, "verse_number": "११", "content_sanskrit": "दुश्चरा द्वादश समा हत्वा पितरमद्य वै ।\nममेह सुनृशंसस्य संवीतस्यास्य कर्मणा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2209843, "chapter_id": 5487, "verse_number": "१२", "content_sanskrit": "शिरःकपाले चास्यैव भुञ्जतः पितुरद्य मे ।\nप्रायश्चित्तं हि नास्त्यन्यद्धत्वाऽद्य पितरं मम ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2209844, "chapter_id": 5487, "verse_number": "१३", "content_sanskrit": "पश्य नागोत्तमसुते भर्तारं निहतं मया ।\nकृतं प्रियं मया तेऽद्य निहत्य समरेऽर्जुनम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2209845, "chapter_id": 5487, "verse_number": "१४", "content_sanskrit": "सोऽहमप्यद्य यास्यामि गतिं पितृनिषेविताम् ।\nन शक्नोम्यात्मनाऽऽत्मानमहं धारयितुं शुभे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2209846, "chapter_id": 5487, "verse_number": "१५", "content_sanskrit": "सा त्वं मयि मृते मातस्तथा गाण्डीवधन्वनि ।\nभव प्रीतिमती देवि सत्येनात्मानमालभे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2209847, "chapter_id": 5487, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2209848, "chapter_id": 5487, "verse_number": "१६", "content_sanskrit": "इत्युक्त्वा स ततो राजा दुःखशोकसमाहतः ।\nउपस्पृश्य महाराज दुःखाद् वचनमब्रवीत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2209849, "chapter_id": 5487, "verse_number": "", "content_sanskrit": "बभ्रुवाहनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2209850, "chapter_id": 5487, "verse_number": "१७", "content_sanskrit": "शृण्वन्तु सर्वभूतानि स्थावराणि चराणि च ।\nत्वं च मातर्यथा सत्यं ब्रवीमि भुजगोत्तमे ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2209851, "chapter_id": 5487, "verse_number": "१८", "content_sanskrit": "यदि नोत्तिष्ठति जयः पिता मे भरतर्षभः ।\nअस्मिन्नेव रणोद्देशे शाययिष्ये कलेबरम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2209852, "chapter_id": 5487, "verse_number": "१९", "content_sanskrit": "न हि मे पितरं हत्वा निष्कृतिर्विद्यते क्वचित् ।\nनरकं प्रतिपत्स्यामि ध्रुवं गुरुवधार्दितः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2209853, "chapter_id": 5487, "verse_number": "२०", "content_sanskrit": "वीरं हि क्षत्रियं हत्वा गोसहस्रेण मुच्यते ।\nपितरं तु निहत्यैवं दुष्करा निष्कृतिर्मम ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2209854, "chapter_id": 5487, "verse_number": "२१", "content_sanskrit": "एवं ह्येष महातेजाः पाण्डपुत्रो धनञ्जयः ।\nपिता च मम धर्मात्मा तस्य मे निष्कृतिः कुतः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2209855, "chapter_id": 5487, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2209856, "chapter_id": 5487, "verse_number": "२२", "content_sanskrit": "इत्येवमुक्त्वा नृपते धनञ्जयसुतो नृपः ।\nउपस्पृश्याभवत् तूष्णीं प्रायोपेतो महामतिः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2209857, "chapter_id": 5487, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि अश्वसञ्चरणे बभ्रुवाहनप्रायोपवेशो नाम एकाशीतितमोऽध्यायः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]