[{"id": 2047040, "chapter_id": 2043, "verse_number": "६-९२-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2047041, "chapter_id": 2043, "verse_number": "६-९२-१", "content_sanskrit": "ततस्तद्बाणवर्षं तु दुःसहं दानवैरपि।\nदधार युधि राजेन्द्रो यथा वर्षं महाद्विपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2047042, "chapter_id": 2043, "verse_number": "६-९२-२", "content_sanskrit": "ततः क्रोधसमाविष्टो निःश्वसन्निव पन्नगः ।\nसंशयं परमं प्राप्तः पुत्रस्ते भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2047043, "chapter_id": 2043, "verse_number": "६-९२-३", "content_sanskrit": "मुमोच निशितांस्तीक्ष्णान्नाराचान्पञ्चविंशतिम्।\nतेऽपतन्सहसा राजंस्तस्मिन्राक्षसपुङ्गवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2047044, "chapter_id": 2043, "verse_number": "६-९२-४", "content_sanskrit": "आशीविषा इव क्रुद्धाः पर्वते गन्धमादने ।\nस तैर्विद्धः स्रवन्रक्तं प्रभिन्न इव कुञ्जरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2047045, "chapter_id": 2043, "verse_number": "६-९२-५", "content_sanskrit": "दध्रे मतिं विनाशाय राज्ञः स पिशिताशनः।\nजग्राह च महाशक्तिं गिरीणामपि दारिणीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2047046, "chapter_id": 2043, "verse_number": "६-९२-६", "content_sanskrit": "संप्रदीप्तां महोल्काभामशनिं ज्वलितामिव ।\nतमागच्छन्महाबाहुर्जिघांसुस्तनयं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2047047, "chapter_id": 2043, "verse_number": "६-९२-७", "content_sanskrit": "तामुद्यतामभिप्रेक्ष्य वङ्गानामधिपस्त्वरन् ।\nकुञ्जरं गिरिसंकाशं राक्षसं प्रत्यचोदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2047048, "chapter_id": 2043, "verse_number": "६-९२-८", "content_sanskrit": "स नागप्रवरेणाजौ बलिना शीघ्रगामिना ।\nयतो दुर्योधनरथस्तं मार्गं प्रत्यषेधयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2047049, "chapter_id": 2043, "verse_number": "६-९२-९", "content_sanskrit": "पन्थानं वारयामास कुञ्जरेण सुतस्य ते।\nमार्गमावारितं दृष्ट्वा राज्ञा वङ्गेन धीमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2047050, "chapter_id": 2043, "verse_number": "६-९२-१०", "content_sanskrit": "घटोत्कचो महाराज क्रोधसंरक्तलोचनः ।\nउद्यतां तां महाशक्तिकं तस्मिंश्चिक्षेप वारणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2047051, "chapter_id": 2043, "verse_number": "६-९२-११", "content_sanskrit": "स तयाऽभिहतो राजंस्तेन बाहुप्रमुक्तया।\nसंजातरुधिरोत्पीडः पपात च ममार च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2047052, "chapter_id": 2043, "verse_number": "६-९२-१२", "content_sanskrit": "पतत्यथ गजे चापि वङ्गानामीश्वरो बली।\nजवेन समभिद्रुत्य जगाम धरणीतलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2047053, "chapter_id": 2043, "verse_number": "६-९२-१३", "content_sanskrit": "दुर्योधोऽपि संप्रेक्ष्य पतितं वरवारणम् ।\nप्रभग्नं च बलं दृष्ट्वा जगाम परमां व्यथाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2047054, "chapter_id": 2043, "verse_number": "६-९२-१४", "content_sanskrit": "`अशक्तः प्रतियोद्धुं वै दृष्ट्वा तस्य पराक्रमम्।\nक्षत्रधर्मं पुरस्कृत्य आत्मनश्चातिमानिताम्।\nप्राप्तेऽपक्रनये राजा तस्थौ गिरिरिवाचलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2047055, "chapter_id": 2043, "verse_number": "६-९२-१५", "content_sanskrit": "राधान च शितं बाणं कालाग्निसमतेजसम्।\nसुयोच धरमक्रुद्धस्तस्मिन्घोरे निशाचरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2047056, "chapter_id": 2043, "verse_number": "६-९२-१६", "content_sanskrit": "तमापतन्तं संप्रेक्ष्य वणिमिन्द्राशनिप्रभम् ।\nलाघवान्मोचयामास महात्मा वै घटोत्कचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2047057, "chapter_id": 2043, "verse_number": "६-९२-१७", "content_sanskrit": "भूयश्च निननादोषं क्रोधसंरक्तलोचनः ।\nत्रासयामास रौन्यानि युगन्ते जलदो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2047058, "chapter_id": 2043, "verse_number": "६-९२-१८", "content_sanskrit": "तं श्रुत्वा निनिदं घोरं तस्व भीमस्य रक्षसः।\nआचार्यमुसंगम्य भीष्मः शान्तनवोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2047059, "chapter_id": 2043, "verse_number": "६-९२-१९", "content_sanskrit": "यथैव निनन्दो घोरः श्रूयते राक्षसेरितः ।\nहैडिम्बो युध्यते नूनं राज्ञा दुर्योधनेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2047060, "chapter_id": 2043, "verse_number": "६-९२-२०", "content_sanskrit": "नैष शक्यो हि संग्रामे जेतुं भूतेन केनचित् ।\nतत्र गच्छत भद्रं वो राजानं परिरक्षितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2047061, "chapter_id": 2043, "verse_number": "६-९२-२१", "content_sanskrit": "अभिद्रुत्य महाबाहुं राक्षसेन प्रपीडितम्।\nएतद्धि परमं कृत्यं सर्वेषां नः परंतपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2047062, "chapter_id": 2043, "verse_number": "६-९२-२२", "content_sanskrit": "पितामहवचः श्रुत्वा त्वरमाणा महारथाः ।\nउत्तमं जवमास्थाय प्रययुर्यत्र कौरवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2047063, "chapter_id": 2043, "verse_number": "६-९२-२३", "content_sanskrit": "द्रोणश्च सोमदत्तश्च बाह्लीकोऽथ जयद्रथः ।\nकृपो भिरिश्रवाः शल्य आवन्त्यः स बृहद्बलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2047064, "chapter_id": 2043, "verse_number": "६-९२-२४", "content_sanskrit": "अश्वत्थामा विकर्णश्च चित्रसेनो विविंशतिः।\nरथाश्चानेकसाहस्रा ये तेषामनुयायिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2047065, "chapter_id": 2043, "verse_number": "६-९२-२५", "content_sanskrit": "अभिद्रुतं परीप्सन्तः पुत्रं दुर्योधनं तव।\nतदनीकमनाधृष्यं पालितं तु महारथैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2047066, "chapter_id": 2043, "verse_number": "६-९२-२६", "content_sanskrit": "पाततायिनमायान्तं प्रेक्ष्य राक्षससत्तमः ।\n...कम्पत महाबाहुर्मैनाक इव पर्वतःक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2047067, "chapter_id": 2043, "verse_number": "६-९२-२७", "content_sanskrit": "प्रगृह्य विपुलं चापं ज्ञातिभिः परिवारितः ।\nशूलमुद्गरहस्तैश्च नानाप्रहरणैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2047068, "chapter_id": 2043, "verse_number": "६-९२-२८", "content_sanskrit": "ततः समभवद्युद्धं तुमुलं रोमहर्षणम् ।\nराक्षसानां च मुख्यस्य दुर्योधनबलस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2047069, "chapter_id": 2043, "verse_number": "६-९२-२९", "content_sanskrit": "धनुषां कूजतां शब्दः सर्वतस्तुमुलो रणे ।\nअश्रूयत महाराज वंशानां दह्यतामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2047070, "chapter_id": 2043, "verse_number": "६-९२-३०", "content_sanskrit": "शस्त्राणां पात्यमानानां कवचेषु शरीरिणाम्।\nशब्दः समभवद्राजन्गिरीणामिव भिद्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2047071, "chapter_id": 2043, "verse_number": "६-९२-३१", "content_sanskrit": "वीरबाहुविसृष्टानां तोमराणां विशांपते ।\nरूपमासीद्वियत्स्थानां सर्पाणामिव सर्पताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2047072, "chapter_id": 2043, "verse_number": "६-९२-३२", "content_sanskrit": "ततः परमसंक्रुद्धो विष्फार्य सुमहद्धनुः ।\nराक्षसन्द्रो महाबाहुर्विनदन्भैरव रवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2047073, "chapter_id": 2043, "verse_number": "६-९२-३३", "content_sanskrit": "आचार्यस्यार्धचन्द्रेण क्रुद्धश्चिच्छेद कार्मुकम् ।\nसोमदत्तस्य भल्लेन ध्वजं चोन्मथ्य चानदत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2047074, "chapter_id": 2043, "verse_number": "६-९२-३४", "content_sanskrit": "बाह्लीकं च त्रिभिर्बाणैः प्रत्यविध्यत्स्तनान्तरे।\nकृपमेकेन विव्याध चित्रसेनं त्रिभिः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2047075, "chapter_id": 2043, "verse_number": "६-९२-३५", "content_sanskrit": "पूर्णायतविसृष्टेन सम्यक्प्रणिहितेन च।\nजत्रुदेशे समासाद्य विकर्णं समताडयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2047076, "chapter_id": 2043, "verse_number": "६-९२-३६", "content_sanskrit": "न्यषीदत्स्वरथोपस्थे शोणितेन परिप्लुतः ।\nततः पुनरमेयात्मा नाराचान्दश पञ्च च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2047077, "chapter_id": 2043, "verse_number": "६-९२-३७", "content_sanskrit": "भूरिश्रवसि संक्रुद्धः प्राहिणोद्भरतर्षभ ।\nते वर्म भित्त्वा तस्याशु विविशुर्धरणीतलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2047078, "chapter_id": 2043, "verse_number": "६-९२-३८", "content_sanskrit": "विविंशतेश्च द्रौणेश्च यन्तारौ समताडयत्।\nतौ पेततू रथोपस्थे रश्मीनुत्सृज्य वाजिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2047079, "chapter_id": 2043, "verse_number": "६-९२-३९", "content_sanskrit": "सिन्धुराज्ञोऽर्धचन्द्रेण वाराहं स्वर्णभूषितम् ।\nउन्ममाथ महाराज द्वितीयेनाच्छिनद्धनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2047080, "chapter_id": 2043, "verse_number": "६-९२-४०", "content_sanskrit": "चतुर्भिरथ नाराचैरावन्त्यस्य महात्मनः ।\nजघान चतुरो वाहान्क्रोधसंरक्तलोचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2047081, "chapter_id": 2043, "verse_number": "६-९२-४१", "content_sanskrit": "पूर्णायतविसृष्टेन पीतेन निशितेन च ।\nनिर्बिभेद महाराज राजपुत्रं बृहद्बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2047082, "chapter_id": 2043, "verse_number": "६-९२-४२", "content_sanskrit": "स गाढविद्धो व्यथितो रथोपस्थ उपाविशत्।\nभृशं क्रोधेन चाविष्टो रथस्थो राक्षसाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2047083, "chapter_id": 2043, "verse_number": "६-९२-४३", "content_sanskrit": "चिक्षेप निशितांस्तीक्ष्णाञ्छरानाशीविषोपमान्।\nबिभिदुस्ते महाराज शल्यं युद्धविशारदम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2047084, "chapter_id": 2043, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि अष्टमदिवसयुद्धे द्विनवतितमोऽध्यायः ॥\nMahabharata - Bhishma Parva - Chapter Footnotes", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]